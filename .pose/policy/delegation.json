{
  "schema_version": 2,
  "agents": {
    "sol-medium": {
      "vendor": "openai",
      "model": "gpt-6.1-sol",
      "cli": "codex",
      "events": "codex-jsonl",
      "timeout": "60m",
      "commands": {
        "read": [
          "codex",
          "-a",
          "never",
          "-s",
          "read-only",
          "exec",
          "-m",
          "gpt-6.1-sol",
          "{effort}",
          "--skip-git-repo-check",
          "--json",
          "-o",
          "{output}",
          "-"
        ],
        "sandboxed": [
          "codex",
          "-a",
          "never",
          "-s",
          "workspace-write",
          "exec",
          "-m",
          "gpt-6.1-sol",
          "{effort}",
          "--skip-git-repo-check",
          "--json",
          "-o",
          "{output}",
          "-"
        ]
      },
      "effort": {
        "default": "medium",
        "levels": {
          "medium": [
            "-c",
            "model_reasoning_effort=\"medium\""
          ]
        }
      },
      "session": {
        "pattern": "\"thread_id\"\\s*:\\s*\"([^\"]+)\""
      },
      "resume": {
        "command": [
          "codex",
          "-a",
          "never",
          "-s",
          "read-only",
          "exec",
          "resume",
          "-m",
          "gpt-6.1-sol",
          "{effort}",
          "--skip-git-repo-check",
          "--json",
          "-o",
          "{output}",
          "{session}",
          "-"
        ],
        "commands": {
          "read": [
            "codex",
            "-a",
            "never",
            "-s",
            "read-only",
            "exec",
            "resume",
            "-m",
            "gpt-6.1-sol",
            "{effort}",
            "--skip-git-repo-check",
            "--json",
            "-o",
            "{output}",
            "{session}",
            "-"
          ],
          "sandboxed": [
            "codex",
            "-a",
            "never",
            "-s",
            "workspace-write",
            "exec",
            "resume",
            "-m",
            "gpt-6.1-sol",
            "{effort}",
            "--skip-git-repo-check",
            "--json",
            "-o",
            "{output}",
            "{session}",
            "-"
          ]
        },
        "max_resumes": 3,
        "max_wall_time": "60m"
      },
      "limit": {
        "output_patterns": [
          "(?i)you(?:'|\u2019|\\\\u2019)ve hit your usage limit"
        ]
      },
      "executor": "agent:openai/gpt-6.1-sol"
    },
    "claude-opus-5-5": {
      "vendor": "anthropic",
      "model": "claude-opus-5-5",
      "cli": "claude",
      "events": "claude-stream-json",
      "timeout": "60m",
      "executor": "agent:anthropic/claude-opus-5-5",
      "commands": {
        "read": [
          "claude",
          "--safe-mode",
          "--restricted",
          "-p",
          "--model",
          "claude-opus-5-5",
          "{effort}",
          "--permission-mode",
          "dontAsk",
          "--output-format",
          "stream-json",
          "--verbose",
          "--permission-prompts",
          "none",
          "--allowedTools",
          "Bash(git status:*),Bash(git ls-files:*),Bash(pose artifact-check:*),Bash(pose surface-check:*),Bash(pose review-check:*),Bash(pose closeout-check:*)",
          "--tools",
          "Read,Grep,Glob,Bash"
        ],
        "sandboxed": [
          "sh",
          "-c",
          "case \"$(uname)\" in Darwin) ;; *) for t in bwrap socat; do command -v \"$t\" >/dev/null 2>&1 || { echo \"pose: the sandboxed Claude profile needs bubblewrap and socat, and $t is missing; without them Claude Code would run its commands unsandboxed. Install them (Debian/Ubuntu: sudo apt install bubblewrap socat; Fedora: sudo dnf install bubblewrap socat; Arch: sudo pacman -S bubblewrap socat) and run again.\" >&2; exit 127; }; done;; esac; exec \"$@\"",
          "sh",
          "claude",
          "--safe-mode",
          "--restricted",
          "-p",
          "--model",
          "claude-opus-5-5",
          "{effort}",
          "--permission-mode",
          "acceptEdits",
          "--output-format",
          "stream-json",
          "--verbose",
          "--permission-prompts",
          "none",
          "--settings",
          "{\"sandbox\":{\"enabled\":true,\"autoAllowBashIfSandboxed\":true,\"allowUnsandboxedCommands\":false}}",
          "--tools",
          "Read,Grep,Glob,Bash,Edit,Write",
          "--allowedTools",
          "Bash"
        ]
      },
      "effort": {
        "default": "medium",
        "levels": {
          "medium": [
            "--effort",
            "medium"
          ]
        }
      },
      "session": {
        "pattern": "(?m)^\\{\"type\"\\s*:\\s*\"system\"\\s*,\\s*\"subtype\"\\s*:\\s*\"init\"[^\\n]*\"session_id\"\\s*:\\s*\"([^\"\\r\\n]+)\""
      },
      "resume": {
        "command": [
          "claude",
          "--safe-mode",
          "--restricted",
          "-p",
          "--model",
          "claude-opus-5-5",
          "{effort}",
          "--permission-mode",
          "dontAsk",
          "--output-format",
          "stream-json",
          "--verbose",
          "--resume",
          "{session}",
          "--permission-prompts",
          "none",
          "--allowedTools",
          "Bash(git status:*),Bash(git ls-files:*),Bash(pose artifact-check:*),Bash(pose surface-check:*),Bash(pose review-check:*),Bash(pose closeout-check:*)",
          "--tools",
          "Read,Grep,Glob,Bash"
        ],
        "commands": {
          "read": [
            "claude",
            "--safe-mode",
            "--restricted",
            "-p",
            "--model",
            "claude-opus-5-5",
            "{effort}",
            "--permission-mode",
            "dontAsk",
            "--output-format",
            "stream-json",
            "--verbose",
            "--resume",
            "{session}",
            "--permission-prompts",
            "none",
            "--allowedTools",
            "Bash(git status:*),Bash(git ls-files:*),Bash(pose artifact-check:*),Bash(pose surface-check:*),Bash(pose review-check:*),Bash(pose closeout-check:*)",
            "--tools",
            "Read,Grep,Glob,Bash"
          ],
          "sandboxed": [
            "sh",
            "-c",
            "case \"$(uname)\" in Darwin) ;; *) for t in bwrap socat; do command -v \"$t\" >/dev/null 2>&1 || { echo \"pose: the sandboxed Claude profile needs bubblewrap and socat, and $t is missing; without them Claude Code would run its commands unsandboxed. Install them (Debian/Ubuntu: sudo apt install bubblewrap socat; Fedora: sudo dnf install bubblewrap socat; Arch: sudo pacman -S bubblewrap socat) and run again.\" >&2; exit 127; }; done;; esac; exec \"$@\"",
            "sh",
            "claude",
            "--safe-mode",
            "--restricted",
            "-p",
            "--model",
            "claude-opus-5-5",
            "{effort}",
            "--permission-mode",
            "acceptEdits",
            "--output-format",
            "stream-json",
            "--verbose",
            "--resume",
            "{session}",
            "--permission-prompts",
            "none",
            "--settings",
            "{\"sandbox\":{\"enabled\":true,\"autoAllowBashIfSandboxed\":true,\"allowUnsandboxedCommands\":false}}",
            "--tools",
            "Read,Grep,Glob,Bash,Edit,Write",
            "--allowedTools",
            "Bash"
          ]
        },
        "max_resumes": 3,
        "max_wall_time": "60m"
      },
      "probe": {
        "command": [
          "claude",
          "--version"
        ],
        "timeout": "10s"
      }
    }
  },
  "routing": {
    "prefer": "opposite-vendor-of-implementation",
    "on_unavailable": [
      "same-vendor-other-model",
      "same-model"
    ],
    "rounds": "continue-thread"
  },
  "purposes": {
    "task": {
      "default_access": "read",
      "timeout": "60m"
    },
    "review": {
      "max_runs_per_bundle": 3
    },
    "adjudicate": {
      "max_runs_per_bundle": 1
    },
    "smoke": {
      "max_runs_per_bundle": 3
    }
  },
  "provenance": {
    "trust": "executor-attested"
  },
  "conclusions": {
    "issuer": "b34-local-executor"
  }
}
