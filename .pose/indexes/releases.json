        ],
        "categories": {
          "added": 5
        },
        "fragments": [
          {
            "spec": "pose-artifact-provenance-ledger",
            "category": "added",
            "breaking": false,
            "refs": "8",
            "body": "POSE now reconciles structured spec artifact claims against immutable Git\nchange sets, persists report evidence and a reverse delivery-integrity index,\nand exposes strict CLI and read-only MCP checks with safe staged backfill.",
            "path": "pose-artifact-provenance-ledger.md",
            "digest": "sha256:9987ead0dad947663625a1f8e41eb60a4260266faa51e834dbb64fe085644748"
          },
          {
            "spec": "pose-capability-mechanism",
            "category": "added",
            "breaking": false,
            "body": "Adds the capability assessment as a POSE-native mechanism: a structured, versioned artifact at `.pose/capabilities/assessment.md` (flat frontmatter + per-mechanism flat bullets) with typed, mechanically verified evidence references; an append-only `history.jsonl` snapshot log; and the `pose assess` command family (`init` scaffolds the 16 default mechanisms, bare `assess` validates structure/evidence/stable-ids/staleness, `snapshot` appends, `diff` compares). `pose check --strict` runs the same validation when the artifact exists (opt-in by presence). The repository's own assessment (2026-07-19) is migrated as dogfooding. Second increment: MCP projections `pose_capability_state` and `pose_capability_history` (paginated, project-scoped, golden-catalog gated — 32 tools) and `pose assess diff --against \u003cproject-id\u003e` comparing score matrices across roots through the portfolio-projection authorization allowlist.",
            "path": "pose-capability-mechanism.md",
            "digest": "sha256:1b281b98a759d188d7e01a8875f1d484421db5976503c3f4d1efb49d229ca00f"
          },
          {
            "spec": "pose-delivery-surface-assurance",
            "category": "added",
            "breaking": false,
            "refs": "7",
            "body": "POSE now proves typed product surfaces and composed capabilities through\nGit-observed artifacts, production entrypoints and current profile-driven\nvalidation evidence, with strict roadmap cut criteria and matching CLI/MCP\nprojections.",
            "path": "pose-delivery-surface-assurance.md",
            "digest": "sha256:624ae0d4ee76c415bf18f08ab35b41989f13c39cb834dd5f6ff9137aa58e6b46"
          },
