          "program": "go",
          "args": [
            "test",
            "./internal/pose",
            "./internal/cli",
            "-run",
            "TestFederatedAcceptanceNegative",
            "-count=1"
          ],
          "severity": "required",
          "evidenceClass": "integration"
        },
        {
          "name": "spec-authority-transfer-integration",
          "program": "go",
          "args": [
            "test",
            "./internal/pose",
            "./internal/cli",
            "-run",
            "TestSpecTransfer",
            "-count=1"
          ],
          "severity": "required",
