    {
      "id": "compatibility",
      "disposition": "passed",
      "evidence": "unit:pose-mcp/go/test",
      "rationale": "The exit code, the flags and --include-pass keep their meaning, and the JSON gains findings with code resolved and one field without removing any. What changes is that a task is no longer flagged for failures a later pass of the same stable_hash settled, so a gate that was red on those may turn green."
    },
    {
      "id": "correctness",
      "disposition": "passed",
      "evidence": "integration:pose-mcp/go/recurrence-cluster-integration"
    },
    {
      "id": "documentation",
      "disposition": "passed",
      "evidence": "unit:pose-mcp/go/test",
      "rationale": "The manual in POSE.md, its pt-BR copy and the scaffold copies describe the cluster rule, resolved findings and --include-pass, and the spec records the history it was measured on."
    },
    {
      "id": "operability",
      "disposition": "passed",
      "evidence": "unit:pose-mcp/go/test",
      "rationale": "Settled clusters stay visible as resolved findings with their failure count and the time of the pass, and recurrence.resolved_clusters counts them, so nothing is silenced. Against the harne8 history the strict hash is listed as resolved and only the 4 failures of the tolerant hash are still flagged."
    },
    {
      "id": "requirements",
      "disposition": "passed",
      "evidence": "integration:pose-mcp/go/recurrence-cluster-integration"
    },
    {
      "id": "scope",
      "disposition": "passed",
      "evidence": "unit:pose-mcp/go/test",
      "rationale": "Changes stay in cmdRecurrenceCheck, the stable_hash field of the history record, the new test file, the manual and the changelog fragment; flaky tasks that alternate fail and pass are a declared non-goal with a follow-up."
    },
    {
      "id": "security",
      "disposition": "passed",
      "evidence": "unit:pose-mcp/go/test",
      "rationale": "The checker reads the same history files as before and adds no input or write path. A pass of one stable_hash never settles another hash, so a failure cannot be hidden by an unrelated pass. Same-session review: the implementing session reviewed its own work; this is declared, not an independent review."
    }
