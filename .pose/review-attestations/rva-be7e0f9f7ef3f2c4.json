    {
      "id": "compatibility",
      "disposition": "passed",
      "evidence": "unit:pose-mcp/go/test",
      "rationale": "Only test binaries change: testgit is imported solely from TestMain in three _test files, so the shipped binary does not link it and the engine's git calls keep the user's configuration. Isolating GIT_CONFIG_GLOBAL removes the developer's ~/.gitconfig from tests, which CI runners never had; the full suite passed three consecutive runs that way, and GIT_CONFIG_COUNT stays free for the test that already uses it."
    },
    {
      "id": "correctness",
      "disposition": "passed",
      "evidence": "build:pose-mcp/go/build"
    },
    {
      "id": "documentation",
      "disposition": "passed",
      "evidence": "integration:pose-mcp/go/test-git-isolation-integration",
      "rationale": "The package comment states the mechanism (detached maintenance after every commit), the observed failure text and why GIT_CONFIG_GLOBAL rather than GIT_CONFIG_COUNT. The spec records that the flake did not reproduce alone in 40 runs and that the trace, not the flake, is the evidence. The changelog fragment says the engine's own git use is unchanged."
    },
    {
      "id": "operability",
      "disposition": "passed",
      "evidence": "integration:pose-mcp/go/test-git-isolation-integration",
      "rationale": "CI now gates releases, so a random cleanup failure could block one. The writer is removed rather than retried, and the probe fails if maintenance comes back, so a future git default change surfaces as a named test failure instead of intermittent red."
    },
    {
      "id": "requirements",
      "disposition": "passed",
      "evidence": "integration:pose-mcp/go/test-git-isolation-integration"
    },
    {
      "id": "scope",
      "disposition": "passed",
      "evidence": "structure:design-2e0471c573c7e716",
      "rationale": "One internal package with its test, three TestMain hooks and the registered producer. No fixture, assertion or production code changed; shell test scripts are named as residual risk rather than folded in."
    },
    {
      "id": "security",
      "disposition": "passed",
      "evidence": "integration:pose-mcp/go/test-git-isolation-integration",
      "rationale": "The config file is written to a fresh private temp directory and removed after the run. It disables maintenance only; it adds no credential helper, hook path or safe.directory, and it narrows the configuration tests inherit rather than widening it."
    }
  ],
