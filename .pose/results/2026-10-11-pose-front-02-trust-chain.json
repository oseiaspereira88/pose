  "items": [
    {
      "id": "T2-01",
      "priority": "P0",
      "evidence_level": "runtime_reproduced",
      "title": "Verificar a prova do evento persistido antes de derivar satisfaction e assurance",
      "sources": [
        "E07",
        "E08",
        "E09",
        "E14"
      ],
      "acceptance_criteria": [
        "show JSON, MCP, Attention e gates não aceitam label verified sem prova",
        "Answer, actor, digest ou reason adulterado não satisfaz o efeito",
        "Legado declared não recebe proof retrospectivo nem bloqueio universal"
      ],
      "owner_front": "front-02",
      "integration_fronts": [
        "front-04",
        "front-09"
      ],
      "status": "proposed"
    },
    {
      "id": "T2-02",
      "priority": "P1",
      "evidence_level": "runtime_reproduced",
      "title": "Unificar o preflight semântico no writer de domínio para approvals",
      "sources": [
        "E01",
        "E13",
        "E16",
        "E27"
      ],
      "acceptance_criteria": [
        "A mesma approval inválida escreve zero records em CLI, import, MCP e Store",
        "Negativas continuam registráveis",
        "Approval válida conserva o resultado"
      ],
      "owner_front": "front-02",
      "integration_fronts": [
        "front-03"
      ],
      "status": "proposed"
    },
    {
      "id": "T2-03",
      "priority": "P1",
      "evidence_level": "source_confirmed",
      "title": "Construir disclosure a partir do resultado efetivo da verificação de prova",
      "sources": [
        "E01",
        "E03",
        "E04"
      ],
      "acceptance_criteria": [
        "Assinatura inválida não emite identity/separation/confirmation verified",
        "Identity válida pode coexistir com critério semanticamente inválido",
        "Todas as superfícies consomem o mesmo resultado"
      ],
      "owner_front": "front-02",
      "integration_fronts": [
        "front-07"
      ],
      "status": "proposed"
    },
    {
      "id": "T2-04",
      "priority": "P1",
      "evidence_level": "runtime_reproduced",
      "title": "Dar semântica coerente a require_presence entre os emitters",
      "sources": [
        "E08",
        "E09",
        "E28"
      ],
      "acceptance_criteria": [
        "Policy declara se presence é universal ou restrita ao canal SSH",
        "Issuer sem a prova admitida não dispensa presence silenciosamente",
        "Matriz inclui SSH plain, SK touched/untouched e issuer"
      ],
      "owner_front": "front-02",
      "integration_fronts": [
        "front-07",
        "front-10"
      ],
      "status": "proposed"
    },
    {
      "id": "T2-05",
      "priority": "P1",
      "evidence_level": "source_confirmed",
      "title": "Explicitar perdas e integridade na ordem de reviews e ledgers",
      "sources": [
        "E01",
        "E02",
        "E06"
      ],
      "acceptance_criteria": [
        "Rejeição recente ilegível não desaparece de uma sequência complete",
        "Falha é localizada no escopo afetado",
        "Legado compatível é distinto de corrupção"
      ],
      "owner_front": "front-02",
      "integration_fronts": [
        "front-09"
      ],
      "status": "proposed"
    },
    {
      "id": "T2-06",
      "priority": "P1",
      "evidence_level": "source_confirmed",
      "title": "Definir e verificar a proveniência exigida da fonte de reuso",
      "sources": [
        "E01",
        "E02"
      ],
      "acceptance_criteria": [
        "Fonte com prova alterada recebe diagnóstico",
        "Reassunção atual é distinta de reuso histórico comprovado",
        "Implementação limita ciclos, profundidade e custo"
      ],
      "owner_front": "front-02",
      "integration_fronts": [
        "front-08",
        "front-09"
      ],
      "status": "proposed"
    },
    {
      "id": "T2-07",
      "priority": "P1",
      "evidence_level": "source_confirmed",
      "title": "Formalizar emissão, aceitação, expiração, revogação e clock skew",
      "sources": [
        "E01",
        "E08"
      ],
      "acceptance_criteria": [
        "Testa future-issued e expiry anterior à emissão",
        "Define validade histórica separada de autorização atual",
        "Clock é injetável; TTL universal não é imposto"
      ],
      "owner_front": "front-02",
      "integration_fronts": [
        "front-03",
        "front-09",
        "front-10"
      ],
      "status": "proposed"
    },
    {
      "id": "T2-08",
      "priority": "P1",
      "evidence_level": "runtime_reproduced",
      "title": "Validar scopes e não reportar capability efetiva para chave desconhecida",
      "sources": [
        "E01",
        "E02",
        "E11"
      ],
      "acceptance_criteria": [
        "Typo spce não é effective",
        "Scopes conhecidos preservam seleção",
        "Extensão futura é explicitamente versionada ou unsupported"
      ],
      "owner_front": "front-02",
      "integration_fronts": [
        "front-07",
        "front-10"
      ],
      "status": "proposed"
    }
  ],
