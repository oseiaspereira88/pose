\t}\n117\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n118\t\tdefer stop()\n119\t\tif delegateSupervised() {\n120\t\t\tplan.OnStart = supervisorHandback()\n121\t\t}\n122\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n123\t\thandBackExisting(run, err)\n124\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n125\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"handoff\")\n126\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"handoff\", run, err, delegateRunNextActions(store, run, err)...)\n127\t\tif err == nil && !f.jsonOut {\n128\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n129\t\t\t\treturn next\n130\t\t\t}\n131\t\t}\n132\t\treturn code\n133\t}\n134\t\n135\t// routeHandoff routes a handoff among the agents of the stopped run's purpose,\n136\t// the stopped agent excluded (R7).\n137\tfunc routeHandoff(store posemodel.Store, prior posemodel.ReviewRun) (string, *posemodel.DelegationRoutingRecord, error) {\n138\t\treaders, found, err := store.LoadReviewersPolicyFor(prior.Kind)\n139\t\tif err != nil {\n140\t\t\treturn \"\", nil, err\n141\t\t}\n142\t\tif !found {\n143\t\t\treturn \"\", nil, posemodel.ErrNoReviewerAdapter\n144\t\t}\n145\t\tpolicy, _, _, err := store.LoadDelegationPolicy()\n146\t\tif err != nil {\n147\t\t\treturn \"\", nil, err\n148\t\t}\n149\t\tbundle, err := store.LoadReviewBundle(prior.BundleID)\n150\t\tif err != nil {\n151\t\t\treturn \"\", nil, err\n152\t\t}\n153\t\timpl, from, err := store.RoutingImplementation(bundle, policy, prior.Lead)\n154\t\tif err != nil {\n155\t\t\treturn \"\", nil, err\n156\t\t}\n157\t\teligible := []string{}\n158\t\tfor name := range readers.Adapters {\n159\t\t\tif name != prior.Adapter {\n160\t\t\t\teligible = append(eligible, name)\n161\t\t\t}\n162\t\t}\n163\t\tavail := store.DelegationAvailabilityOf(policy, time.Now(), true)\n164\t\tagent, record, err := posemodel.RouteDelegation(policy, eligible, impl, from, avail, time.Now())\n165\t\tif err != nil {\n166\t\t\treturn \"\", &record, err\n167\t\t}\n168\t\tif record.Step == posemodel.DelegationStepWait {\n169\t\t\treturn \"\", &record, errors.New(tr(\"every other agent is limited until \"+record.WaitUntil+\"; hand off after the reset, or wait for this run's reset and resume it\",\n170\t\t\t\t\"todos os outros agentes estão limitados até \"+record.WaitUntil+\"; faça o handoff depois do reset, ou espere o reset deste run e o retome\"))\n171\t\t}\n172\t\treturn agent, &record, nil\n173\t}\n174\t\n175\t// delegateNextAction is one way forward for a stopped run (R9).\n176\ttype delegateNextAction struct {\n177\t\tAction    string `json:\"action\"`\n178\t\tCommand   string `json:\"command,omitempty\"`\n179\t\tAvailable bool   `json:\"available\"`\n180\t\tWhy       string `json:\"why,omitempty\"`\n181\t}\n182\t\n183\t// delegateCancelAction leaves the attempt stopped: it has no command because\n184\t// nothing runs to stop, nothing is spent, and a later command can still\n185\t// continue the run (R8, R9).\n186\tfunc delegateCancelAction() delegateNextAction {\n187\t\treturn delegateNextAction{Action: \"cancel\", Available: true, Why: tr(\"leave the run stopped; nothing runs and the attempt's budget is kept\", \"deixar o run parado; nada roda e o orçamento da tentativa é mantido\")}\n188\t}\n189\t\n190\t// delegateNextActions lists what a stopped attempt can do next, each judged by\n191\t// the same read-only planning its command runs, so an action offered as\n192\t// available is one its command would start (R9); nil for an attempt that runs\n193\t// or concluded.\n194\tfunc delegateNextActions(store posemodel.Store, a posemodel.DelegationAttempt) []delegateNextAction {\n195\t\tlatest := a.Latest()\n196\t\tif a.Active || latest == nil || latest.Status == posemodel.ReviewRunCompleted || latest.Status == posemodel.ReviewRunStale {\n197\t\t\treturn nil\n198\t\t}\n199\t\tif latest.Purpose == posemodel.DelegationPurposeTask {\n200\t\t\treturn delegateTaskNextActions(store, a, *latest)\n201\t\t}\n202\t\treason := func(err error) string { return strings.TrimPrefix(err.Error(), \"pose: \") }\n203\t\tvar actions []delegateNextAction\n204\t\tif i := latest.Interruption; latest.Status == posemodel.ReviewRunInterrupted && i != nil {\n205\t\t\tresume := delegateNextAction{Action: \"resume\", Command: \"pose delegate resume \" + a.AttemptID}\n206\t\t\tplan, err := store.PlanReviewResume(latest.RunID)\n207\t\t\tswitch {\n208\t\t\tcase !i.Resumable:\n209\t\t\t\tresume.Why = tr(\"the stop is not resumable\", \"a parada não é retomável\")\n210\t\t\tcase err != nil:\n211\t\t\t\tresume.Why = reason(err)\n212\t\t\tcase plan.PendingContinuation != nil || plan.Existing != nil:\n213\t\t\t\tresume.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n214\t\t\t}\n215\t\t\tif resume.Why == \"\" {\n216\t\t\t\treset, resetErr := time.Parse(time.RFC3339Nano, i.ResetAt)\n217\t\t\t\tif i.ResetAt != \"\" && resetErr == nil && reset.After(time.Now()) {\n218\t\t\t\t\twait := delegateNextAction{Action: \"wait\", Command: \"pose delegate resume \" + a.AttemptID + \" --wait-until-reset\"}\n219\t\t\t\t\tif _, err := posemodel.ReviewResumeDelay(*latest, time.Now(), 24*time.Hour, 0); err != nil {\n220\t\t\t\t\t\twait.Why = reason(err)\n221\t\t\t\t\t} else {\n222\t\t\t\t\t\twait.Available = true\n223\t\t\t\t\t}\n224\t\t\t\t\tactions = append(actions, wait)\n225\t\t\t\t\tresume.Why = tr(\"the agent is limited until \", \"o agente está limitado até \") + i.ResetAt\n226\t\t\t\t} else {\n227\t\t\t\t\tresume.Available = true\n228\t\t\t\t}\n229\t\t\t}\n230\t\t\tactions = append(actions, resume)\n231\t\t}\n232\t\thandoff := delegateNextAction{Action: \"handoff\", Command: \"pose delegate handoff \" + a.AttemptID + \" --to auto\"}\n233\t\tif agent, _, err := routeHandoff(store, *latest); err != nil {\n234\t\t\thandoff.Why = reason(err)\n235\t\t} else if plan, err := store.PlanReviewHandoff(latest.RunID, agent); err != nil {\n236\t\t\thandoff.Why = reason(err)\n237\t\t} else if plan.PendingContinuation != nil || plan.Existing != nil {\n238\t\t\thandoff.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n239\t\t} else {\n240\t\t\thandoff.Available = true\n241\t\t}\n242\t\treturn append(actions, handoff, delegateCancelAction())\n243\t}\n244\t\n245\t// delegateRunNextActions is the ways forward of the attempt run belongs to,\n246\t// for a run that just stopped (R9).\n247\tfunc delegateRunNextActions(store posemodel.Store, run posemodel.ReviewRun, err error) []delegateNextAction {\n248\t\tif err != nil || run.AttemptID == \"\" || run.Status == posemodel.ReviewRunCompleted {\n249\t\t\treturn nil\n250\t\t}\n251\t\tattempts, _, lerr := store.ListDelegationAttempts()\n252\t\tif lerr != nil {\n253\t\t\treturn nil\n254\t\t}\n255\t\tfor _, a := range attempts {\n256\t\t\tif a.AttemptID == run.AttemptID {\n257\t\t\t\treturn delegateNextActions(store, a)\n258\t\t\t}\n259\t\t}\n260\t\treturn nil\n261\t}\n262\t\n263\t// offerDelegateChoices asks, in a terminal, what to do with a run that just\n264\t// stopped interrupted: wait for its reset and resume it, hand it off to the\n265\t// first available agent, or stop here; it does nothing until answered (R8).\n266\tfunc offerDelegateChoices(root string, run posemodel.ReviewRun, stdout, stderr io.Writer) (int, bool) {\n267\t\tif run.Status != posemodel.ReviewRunInterrupted || run.AttemptID == \"\" || !delegateInteractive() {\n268\t\t\treturn 0, false\n269\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"ea317a80-ebc9-4cf8-862f-1439b2aa06a7","timestamp":"2026-11-26T09:10:48.415Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-d0de10e622b0e2942987a4b9c044b402/worktree/pose-mcp/internal/cli/delegate_handoff.go","content":"\t\t\tagent = r.Adapter\n\t\t}\n\t}\n\tif agent == \"auto\" {\n\t\tchosen, record, err := routeHandoff(store, *latest)\n\t\tif err !