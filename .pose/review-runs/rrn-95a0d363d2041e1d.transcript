{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013AHw67mLgZnyMm9NzstBUy","type":"tool_result","content":"20\t\n21\tconst reviewAttemptDir = \".pose/review-attempts\"\n22\tconst reviewRunLedgerDir = \".pose/review-run-ledger\"\n23\tconst reviewLedgerMaxRecords = 10000\n24\tconst reviewLedgerMaxBytes = 1 << 20\n25\t\n26\t// DelegatedReviewAttempt is an immutable reservation, published before any adapter starts.\n27\t// Its ordinal path coordinates contenders; its ID binds its complete content.\n28\ttype DelegatedReviewAttempt struct {\n29\t\tSchemaVersion int    `json:\"schema_version\"`\n30\t\tAttemptID     string `json:\"attempt_id\"`\n31\t\tBundleID      string `json:\"bundle_id\"`\n32\t\tBundleDigest  string `json:\"bundle_digest\"`\n33\t\tScope         string `json:\"scope\"`\n34\t\tAdapter       string `json:\"adapter\"`\n35\t\tReason        string `json:\"reason,omitempty\"`\n36\t\tOrdinal       int    `json:\"ordinal\"`\n37\t\tReservedAt    string `json:\"reserved_at\"`\n38\t\tNonce         string `json:\"nonce\"`\n39\t}\n40\ttype reviewAttemptReceipt struct {\n41\t\tSchemaVersion int    `json:\"schema_version\"`\n42\t\tAttemptID     string `json:\"attempt_id\"`\n43\t\tRunID         string `json:\"run_id\"`\n44\t\tRunDigest     string `json:\"run_digest\"`\n45\t}\n46\ttype reviewRunWitness struct {\n47\t\tSchemaVersion    int    `json:\"schema_version\"`\n48\t\tRunID            string `json:\"run_id\"`\n49\t\tBundleID         string `json:\"bundle_id\"`\n50\t\tScope            string `json:\"scope\"`\n51\t\tRecordDigest     string `json:\"record_digest\"`\n52\t\tTranscriptDigest string `json:\"transcript_digest\"`\n53\t}\n54\t\n55\tfunc reviewAttemptKey(bundle string) string {\n56\t\treturn strings.TrimPrefix(digestBytes([]byte(bundle)), \"sha256:\")[:24]\n57\t}\n58\tfunc reviewAttemptPath(root string, a DelegatedReviewAttempt) string {\n59\t\treturn filepath.Join(root, reviewAttemptDir, reviewAttemptKey(a.BundleID), fmt.Sprintf(\"%06d.json\", a.Ordinal))\n60\t}\n61\tfunc attemptReceiptPath(root string, a DelegatedReviewAttempt) string {\n62\t\treturn strings.TrimSuffix(reviewAttemptPath(root, a), \".json\") + \".result.json\"\n63\t}\n64\tfunc attemptIdentity(a DelegatedReviewAttempt) string {\n65\t\ta.AttemptID = \"\"\n66\t\traw, _ := json.Marshal(a)\n67\t\treturn \"rat-\" + strings.TrimPrefix(digestBytes(raw), \"sha256:\")\n68\t}\n69\t\n70\tfunc readLedgerRaw(path string) ([]byte, error) {\n71\t\treturn readBoundedRegular(path, reviewLedgerMaxBytes)\n72\t}\n73\t\n74\t// readBoundedRegular reads a regular file of at most limit bytes, refusing a\n75\t// link or a file replaced while it was opened.\n76\tfunc readBoundedRegular(path string, limit int64) ([]byte, error) {\n77\t\tinfo, err := os.Lstat(path)\n78\t\tif err != nil {\n79\t\t\treturn nil, err\n80\t\t}\n81\t\tif !info.Mode().IsRegular() || info.Size() > limit {\n82\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n83\t\t}\n84\t\tf, err := os.Open(path)\n85\t\tif err != nil {\n86\t\t\treturn nil, err\n87\t\t}\n88\t\topened, statErr := f.Stat()\n89\t\tif statErr != nil || !opened.Mode().IsRegular() || !os.SameFile(info, opened) {\n90\t\t\tf.Close()\n91\t\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n92\t\t}\n93\t\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n94\t\tcloseErr := f.Close()\n95\t\tif err != nil {\n96\t\t\treturn nil, err\n97\t\t}\n98\t\tif closeErr != nil {\n99\t\t\treturn nil, closeErr\n100\t\t}\n101\t\tif int64(len(raw)) > limit {\n102\t\t\treturn nil, fmt.Errorf(\"ledger record exceeds bound\")\n103\t\t}\n104\t\treturn raw, nil\n105\t}\n106\t\n107\t// readBoundedRegularIn is the operation-Files form of readBoundedRegular. It\n108\t// keeps the same regular-file and replacement checks while making the bytes\n109\t// part of an active governance read view.\n110\tfunc readBoundedRegularIn(files Files, path string, limit int64) ([]byte, error) {\n111\t\tfiles = FilesOrNative(files)\n112\t\tinfo, err := files.Lstat(path)\n113\t\tif err != nil {\n114\t\t\treturn nil, err\n115\t\t}\n116\t\tif !info.Mode().IsRegular() || limit < 0 || info.Size() < 0 || info.Size() > limit {\n117\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n118\t\t}\n119\t\tf, err := files.Open(path)\n120\t\tif err != nil {\n121\t\t\treturn nil, err\n122\t\t}\n123\t\topened, statErr := f.Stat()\n124\t\tif statErr != nil || !opened.Mode().IsRegular() || !sameObservedFile(info, opened) {\n125\t\t\t_ = f.Close()\n126\t\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n127\t\t}\n128\t\traw, readErr := readLimited(f, limit)\n129\t\tcloseErr := f.Close()\n130\t\tif readErr != nil {\n131\t\t\treturn nil, readErr\n132\t\t}\n133\t\tif closeErr != nil {\n134\t\t\treturn nil, closeErr\n135\t\t}\n136\t\treturn raw, nil\n137\t}\n138\t\n139\tvar errReviewLedgerBudget = errors.New(\"review ledger exceeds 32 MiB inventory read budget\")\n140\t\n141\tfunc readLedgerRawBudget(path string, remaining *int64) ([]byte, error) {\n142\t\tinfo, err := os.Lstat(path)\n143\t\tif err != nil {\n144\t\t\treturn nil, err\n145\t\t}\n146\t\tif info.Size() < 0 || info.Size() > *remaining {\n147\t\t\treturn nil, errReviewLedgerBudget\n148\t\t}\n149\t\t*remaining -= info.Size()\n150\t\traw, err := readLedgerRaw(path)\n151\t\tif err != nil {\n152\t\t\treturn nil, err\n153\t\t}\n154\t\tif extra := int64(len(raw)) - info.Size(); extra > 0 {\n155\t\t\t*remaining -= extra\n156\t\t\tif *remaining < 0 {\n157\t\t\t\treturn nil, errReviewLedgerBudget\n158\t\t\t}\n159\t\t}\n160\t\treturn raw, nil\n161\t}\n162\t\n163\tfunc readLedgerRawBudgetIn(files Files, path string, remaining *int64) ([]byte, error) {\n164\t\tfiles = FilesOrNative(files)\n165\t\tinfo, err := files.Lstat(path)\n166\t\tif err != nil {\n167\t\t\treturn nil, err\n168\t\t}\n169\t\tif info.Size() < 0 || info.Size() > *remaining {\n170\t\t\treturn nil, errReviewLedgerBudget\n171\t\t}\n172\t\t*remaining -= info.Size()\n173\t\traw, err := readBoundedRegularIn(files, path, reviewLedgerMaxBytes)\n174\t\tif err != nil {\n175\t\t\treturn nil, err\n176\t\t}\n177\t\tif extra := int64(len(raw)) - info.Size(); extra > 0 {\n178\t\t\t*remaining -= extra\n179\t\t\tif *remaining < 0 {\n180\t\t\t\treturn nil, errReviewLedgerBudget\n181\t\t\t}\n182\t\t}\n183\t\treturn raw, nil\n184\t}\n185\tfunc readLedgerJSONBudget(path string, v any, remaining *int64) error {\n186\t\traw, err := readLedgerRawBudget(path, remaining)\n187\t\tif err != nil {\n188\t\t\treturn err\n189\t\t}\n190\t\treturn strictJSONBytes(raw, v)\n191\t}\n192\t\n193\tfunc readLedgerJSONBudgetIn(files Files, path string, v any, remaining *int64) error {\n194\t\traw, err := readLedgerRawBudgetIn(files, path, remaining)\n195\t\tif err != nil {\n196\t\t\treturn err\n197\t\t}\n198\t\treturn strictJSONBytes(raw, v)\n199\t}\n200\tfunc reviewReadBudget(provided []*int64) *int64 {\n201\t\tif len(provided) > 0 {\n202\t\t\treturn provided[0]\n203\t\t}\n204\t\tbudget := int64(32 << 20)\n205\t\treturn &budget\n206\t}\n207\t\n208\tfunc readLedgerJSON(path string, v any) error {\n209\t\traw, err := readLedgerRaw(path)\n210\t\tif err != nil {\n211\t\t\treturn err\n212\t\t}\n213\t\tif err := strictJSONBytes(raw, v); err != nil {\n214\t\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n215\t\t}\n216\t\treturn nil\n217\t}\n218\t\n219\tfunc readLedgerJSONIn(files Files, path string, v any) error {\n220\t\traw, err := readBoundedRegularIn(files, path, reviewLedgerMaxBytes)\n221\t\tif err != nil {\n222\t\t\treturn err\n223\t\t}\n224\t\tif err := strictJSONBytes(raw, v); err != nil {\n225\t\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n226\t\t}\n227\t\treturn nil\n228\t}\n229\t\n230\tfunc ledgerEntries(root, rel string) ([]os.DirEntry, error) {\n231\t\tpath, err := ensureReviewArtifactDir(root, rel, false)\n232\t\tif os.IsNotExist(err) {\n233\t\t\treturn nil, nil\n234\t\t}\n235\t\tif err != nil {\n236\t\t\treturn nil, err\n237\t\t}\n238\t\tf, err := os.Open(path)\n239\t\tif err != nil {\n240\t\t\treturn nil, err\n241\t\t}\n242\t\tentries, err := f.ReadDir(reviewLedgerMaxRecords + 1)\n243\t\tcloseErr := f.Close()\n244\t\tif err != nil && !errors.Is(err, io.EOF) {\n245\t\t\treturn nil, err\n246\t\t}\n247\t\tif closeErr != nil {\n248\t\t\treturn nil, closeErr\n249\t\t}\n250\t\tif len(entries) > reviewLedgerMaxRecords {\n251\t\t\treturn nil, fmt.Errorf(\"ledger inventory exceeds %d records\", reviewLedgerMaxRecords)\n252\t\t}\n253\t\tsort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })\n254\t\treturn entries, nil\n255\t}\n256\t\n257\tfunc ledgerEntriesIn(files Files, root, rel string) ([]fs.DirEntry, error) {\n258\t\tfiles = FilesOrNative(files)\n259\t\tpath, err := ensureReviewArtifactDirIn(files, root, rel, false)\n260\t\tif os.IsNotExist(err) {\n261\t\t\treturn nil, nil\n262\t\t}\n263\t\tif err != nil {\n264\t\t\treturn nil, err\n265\t\t}\n266\t\tf, err := files.Open(path)\n267\t\tif err != nil {\n268\t\t\treturn nil, err\n269\t\t}\n270\t\treader, ok := f.(interface {\n271\t\t\tReadDir(int) ([]fs.DirEntry, error)\n272\t\t})\n273\t\tif !ok {\n274\t\t\t_ = f.Close()\n275\t\t\treturn nil, fmt.Errorf(\"ledger directory does not support bounded reads\")\n276\t\t}\n277\t\tentries, err := reader.ReadDir(reviewLedgerMaxRecords + 1)\n278\t\tcloseErr := f.Close()\n279\t\tif err != nil && !errors.Is(err, io.EOF) {\n280\t\t\treturn nil, err\n281\t\t}\n282\t\tif closeErr != nil {\n283\t\t\treturn nil, closeErr\n284\t\t}\n285\t\tif len(entries) > reviewLedgerMaxRecords {\n286\t\t\treturn nil, fmt.Errorf(\"ledger inventory exceeds %d records\", reviewLedgerMaxRecords)\n287\t\t}\n288\t\tsort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })\n289\t\treturn entries, nil\n290\t}\n291\tfunc publishLedgerJSON(root, rel string, v any) error {\n292\t\tdir, err := ensureReviewArtifactDir(root, filepath.ToSlash(filepath.Dir(rel)), true)\n293\t\tif err != nil {\n294\t\t\treturn err\n295\t\t}\n296\t\traw, err := json.MarshalIndent(v, \"\", \"  \")\n297\t\tif err != nil {\n298\t\t\treturn err\n299\t\t}\n300\t\tif len(raw) > reviewLedgerMaxBytes {\n301\t\t\treturn fmt.Errorf(\"ledger record exceeds bound\")\n302\t\t}\n303\t\treturn PublishFile(filepath.Join(dir, filepath.Base(rel)), append(raw, '\\n'), 0644, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n304\t}\n305\t\n306\tfunc (s Store) readDelegatedReviewAttempts(bundle string, budgets ...*int64) ([]DelegatedReviewAttempt, error) {\n307\t\tbudget := reviewReadBudget(budgets)\n308\t\trel := filepath.ToSlash(filepath.Join(reviewAttemptDir, reviewAttemptKey(bundle)))\n309\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, rel)\n310\t\tif err != nil {\n311\t\t\treturn nil, err\n312\t\t}\n313\t\tout := []DelegatedReviewAttempt{}\n314\t\tfor _, e := range entries {\n315\t\t\tif IsPublisherStaging(e.Name()) {\n316\t\t\t\tcontinue\n317\t\t\t}\n318\t\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n319\t\t\t\tcontinue\n320\t\t\t}\n321\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n322\t\t\t\treturn nil, fmt.Errorf(\"unknown attempt artifact %s\", e.Name())\n323\t\t\t}\n324\t\t\tvar a DelegatedReviewAttempt\n325\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, rel, e.Name()), &a, budget); err != nil {\n326\t\t\t\treturn nil, err\n327\t\t\t}\n328\t\t\tif a.SchemaVersion != 1 || a.BundleID != bundle || a.Ordinal != len(out)+1 || a.AttemptID != attemptIdentity(a) || e.Name() != fmt.Sprintf(\"%06d.json\", a.Ordinal) {\n329\t\t\t\treturn nil, fmt.Errorf(\"invalid attempt reservation %s\", e.Name())\n330\t\t\t}\n331\t\t\tif _, err := time.Parse(time.RFC3339Nano, a.ReservedAt); err != nil {\n332\t\t\t\treturn nil, err\n333\t\t\t}\n334\t\t\tout = append(out, a)\n335\t\t}\n336\t\t// Orphan receipts are an unknown history, never ignored.\n337\t\tfor _, e := range entries {\n338\t\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n339\t\t\t\tfound := false\n340\t\t\t\tfor _, a := range out {\n341\t\t\t\t\tif filepath.Base(attemptReceiptPath(s.Root, a)) == e.Name() {\n342\t\t\t\t\t\tfound = true\n343\t\t\t\t\t\tbreak\n344\t\t\t\t\t}\n345\t\t\t\t}\n346\t\t\t\tif !found {\n347\t\t\t\t\treturn nil, fmt.Errorf(\"attempt receipt has no reservation: %s\", e.Name())\n348\t\t\t\t}\n349\t\t\t}\n350\t\t}\n351\t\treturn out, nil\n352\t}\n353\tfunc (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (reviewAttemptReceipt, error) {\n354\t\tbudget := reviewReadBudget(budgets)\n355\t\tvar r reviewAttemptReceipt\n356\t\tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n357\t\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n358\t\t}\n359\t\tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n360\t\t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n361\t\t}\n362\t\tvar run ReviewRun\n363\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, r.RunID+\".json\"), &run, budget); err != nil {\n364\t\t\treturn r, err\n365\t\t}\n366\t\traw, _ := json.Marshal(run)\n367\t\tif run.AttemptID != a.AttemptID || run.BundleID != a.BundleID || run.BundleDigest != a.BundleDigest || run.Adapter != a.Adapter || digestBytes(raw) != r.RunDigest {\n368\t\t\treturn r, fmt.Errorf(\"attempt receipt does not bind its final run\")\n369\t\t}\n370\t\treturn r, nil\n371\t}\n372\tfunc (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttempt, int, error) {\n373\t\tif len(plan.Reason) > 2048 || strings.ContainsAny(plan.Reason, \"\\x00\\r\\n\") {\n374\t\t\treturn nil, 0, fmt.Errorf(\"rerun reason must be one line of at most 2048 bytes\")\n375\t\t}\n376\t\truns, lost, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n377\t\tif err != nil {\n378\t\t\treturn nil, 0, err\n379\t\t}\n380\t\tif len(lost) > 0 {\n381\t\t\treturn nil, 0, fmt.Errorf(\"review run coverage is unknown: %v\", lost)\n382\t\t}\n383\t\tattempts, err := s.readDelegatedReviewAttempts(plan.Bundle.BundleID)\n384\t\tif err != nil {\n385\t\t\treturn nil, 0, err\n386\t\t}\n387\t\tknownAttempts := map[string]bool{}\n388\t\tcount := 0\n389\t\treceiptBudget := int64(32 << 20)\n390\t\tfor _, a := range attempts {\n391\t\t\tknownAttempts[a.AttemptID] = true\n392\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n393\t\t\t\treturn nil, 0, err\n394\t\t\t}\n395\t\t\tif a.Adapter == plan.Adapter {\n396\t\t\t\tcount++\n397\t\t\t}\n398\t\t}\n399\t\tcompleted := false\n400\t\tfor _, run := range runs {\n401\t\t\tif run.AttemptID != \"\" && !knownAttempts[run.AttemptID] {\n402\t\t\t\treturn nil, 0, fmt.Errorf(\"missing attempt reservation %s\", run.AttemptID)\n403\t\t\t}\n404\t\t\tif run.Status == ReviewRunCompleted {\n405\t\t\t\tcompleted = true\n406\t\t\t}\n407\t\t\tif run.AttemptID == \"\" && run.Adapter == plan.Adapter {\n408\t\t\t\tcount++\n409\t\t\t}\n410\t\t}\n411\t\tif count >= effectiveReviewMaxRuns(plan.Config) {\n412\t\t\treturn nil, count, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"budget exhausted: %d attempt(s) of %s on this bundle, at most %d\", count, plan.Adapter, effectiveReviewMaxRuns(plan.Config)))\n413\t\t}\n414\t\tif completed && strings.TrimSpace(plan.Reason) == \"\" {\n415\t\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n416\t\t}\n417\t\treturn attempts, count, nil\n418\t}\n419\t\n420\t// prepareDelegatedReviewAttempt admits and builds the next reservation of\n421\t// the bundle without publishing it.\n422\tfunc (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n423\t\tattempts, _, err := s.reviewAttemptAdmission(plan)\n424\t\tif err != nil {\n425\t\t\treturn DelegatedReviewAttempt{}, err\n426\t\t}\n427\t\tnonce := make([]byte, 16)\n428\t\tif _, err := rand.Read(nonce); err != nil {\n429\t\t\treturn DelegatedReviewAttempt{}, err\n430\t\t}\n431\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n432\t\ta.AttemptID = attemptIdentity(a)\n433\t\treturn a, nil\n434\t}\n435\t\n436\t// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n437\t// marks the attempt active first, so a dispatch that ends after this point\n438\t// always leaves a marker that turns stalled and that `pose delegate cancel`\n439\t// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n440\t// review round 1, N1).\n441\tfunc (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n442\t\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n443\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n444\t\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n445\t\t}\n446\t\treturn nil\n447\t}\n448\tfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n449\t\traw, _ := json.Marshal(run)\n450\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n451\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n452\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n453\t}\n454\t\n455\t// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n456\t// exists for legacy records; their content identity remains independently checked.\n457\tfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n458\t\tbudget := int64(32 << 20)\n459\t\treturn s.reviewRunLedgerFindings(bundle, &budget)"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"814e81f2-7cce-413a-848f-44d4243fc456","timestamp":"2026-11-26T09:10:45.332Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-d0de10e622b0e2942987a4b9c044b402/worktree/pose-mcp/internal/pose/review_attempt_ledger.go","content":"\nconst reviewAttemptDir = \".pose/review-attempts\"\nconst reviewRunLedgerDir = \".pose/review-run-ledger\"\nconst reviewLedgerMaxRecords = 10000\nconst reviewLedgerMaxBytes = 1 << 20\n\n// DelegatedReviewAttempt is an immutable reservation, published before any adapter starts.\n// Its ordinal path coordinates contenders; its ID binds its complete content.\ntype DelegatedReviewAttempt struct {\n\tSchemaVersion int    `json:\"schema_version\"`\n\tAttemptID     string `json:\"attempt_id\"`\n\tBundleID      string `json:\"bundle_id\"`\n\tBundleDigest  string `json:\"bundle_digest\"`\n\tScope         string `json:\"scope\"`\n\tAdapter       string `json:\"adapter\"`\n\tReason        string `json:\"reason,omitempty\"`\n\tOrdinal       int    `json:\"ordinal\"`\n\tReservedAt    string `json:\"reserved_at\"`\n\tNonce         string `json:\"nonce\"`\n}\ntype reviewAttemptReceipt struct {\n\tSchemaVersion int    `json:\"schema_version\"`\n\tAttemptID     string `json:\"attempt_id\"`\n\tRunID         string `json:\"run_id\"`\n\tRunDigest     string `json:\"run_digest\"`\n}\ntype reviewRunWitness struct {\n\tSchemaVersion    int    `json:\"schema_version\"`\n\tRunID            string `json:\"run_id\"`\n\tBundleID         string `json:\"bundle_id\"`\n\tScope            string `json:\"scope\"`\n\tRecordDigest     string `json:\"record_digest\"`\n\tTranscriptDigest string `json:\"transcript_digest\"`\n}\n\nfunc reviewAttemptKey(bundle string) string {\n\treturn strings.TrimPrefix(digestBytes([]byte(bundle)), \"sha256:\")[:24]\n}\nfunc reviewAttemptPath(root string, a DelegatedReviewAttempt) string {\n\treturn filepath.Join(root, reviewAttemptDir, reviewAttemptKey(a.BundleID), fmt.Sprintf(\"%06d.json\", a.Ordinal))\n}\nfunc attemptReceiptPath(root string, a DelegatedReviewAttempt) string {\n\treturn strings.TrimSuffix(reviewAttemptPath(root, a), \".json\") + \".result.json\"\n}\nfunc attemptIdentity(a DelegatedReviewAttempt) string {\n\ta.AttemptID = \"\"\n\traw, _ := json.Marshal(a)\n\treturn \"rat-\" + strings.TrimPrefix(digestBytes(raw), \"sha256:\")\n}\n\nfunc readLedgerRaw(path string) ([]byte, error) {\n\treturn readBoundedRegular(path, reviewLedgerMaxBytes)\n}\n\n// readBoundedRegular reads a regular file of at most limit bytes, refusing a\n// link or a file replaced while it was opened.\nfunc readBoundedRegular(path string, limit int64) ([]byte, error) {\n\tinfo, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif !info.Mode().IsRegular() || info.Size() > limit {\n\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n\t}\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\topened, statErr := f.Stat()\n\tif statErr != nil || !opened.Mode().IsRegular() || !os.SameFile(info, opened) {\n\t\tf.Close()\n\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n\t}\n\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n\tcloseErr := f.Close()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif closeErr != nil {\n\t\treturn nil, closeErr\n\t}\n\tif int64(len(raw)) > limit {\n\t\treturn nil, fmt.Errorf(\"ledger record exceeds bound\")\n\t}\n\treturn raw, nil\n}\n\n// readBoundedRegularIn is the operation-Files form of readBoundedRegular. It\n// keeps the same regular-file and replacement checks while making the bytes\n// part of an active governance read view.\nfunc readBoundedRegularIn(files Files, path string, limit int64) ([]byte, error) {\n\tfiles = FilesOrNative(files)\n\tinfo, err := files.Lstat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif !info.Mode().IsRegular() || limit < 0 || info.Size() < 0 || info.Size() > limit {\n\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n\t}\n\tf, err := files.Open(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\topened, statErr := f.Stat()\n\tif statErr != nil || !opened.Mode().IsRegular() || !sameObservedFile(info, opened) {\n\t\t_ = f.Close()\n\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n\t}\n\traw, readErr := readLimited(f, limit)\n\tcloseErr := f.Close()\n\tif readErr != nil {\n\t\treturn nil, readErr\n\t}\n\tif closeErr != nil {\n\t\treturn nil, closeErr\n\t}\n\treturn raw, nil\n}\n\nvar errReviewLedgerBudget = errors.New(\"review ledger exceeds 32 MiB inventory read budget\")\n\nfunc readLedgerRawBudget(path string, remaining *int64) ([]byte, error) {\n\tinfo, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif info.Size() < 0 || info.Size() > *remaining {\n\t\treturn nil, errReviewLedgerBudget\n\t}\n\t*remaining -= info.Size()\n\traw, err := readLedgerRaw(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif extra := int64(len(raw)) - info.Size(); extra > 0 {\n\t\t*remaining -= extra\n\t\tif *remaining < 0 {\n\t\t\treturn nil, errReviewLedgerBudget\n\t\t}\n\t}\n\treturn raw, nil\n}\n\nfunc readLedgerRawBudgetIn(files Files, path string, remaining *int64) ([]byte, error) {\n\tfiles = FilesOrNative(files)\n\tinfo, err := files.Lstat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif info.Size() < 0 || info.Size() > *remaining {\n\t\treturn nil, errReviewLedgerBudget\n\t}\n\t*remaining -= info.Size()\n\traw, err := readBoundedRegularIn(files, path, reviewLedgerMaxBytes)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif extra := int64(len(raw)) - info.Size(); extra > 0 {\n\t\t*remaining -= extra\n\t\tif *remaining < 0 {\n\t\t\treturn nil, errReviewLedgerBudget\n\t\t}\n\t}\n\treturn raw, nil\n}\nfunc readLedgerJSONBudget(path string, v any, remaining *int64) error {\n\traw, err := readLedgerRawBudget(path, remaining)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn strictJSONBytes(raw, v)\n}\n\nfunc readLedgerJSONBudgetIn(files Files, path string, v any, remaining *int64) error {\n\traw, err := readLedgerRawBudgetIn(files, path, remaining)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn strictJSONBytes(raw, v)\n}\nfunc reviewReadBudget(provided []*int64) *int64 {\n\tif len(provided) > 0 {\n\t\treturn provided[0]\n\t}\n\tbudget := int64(32 << 20)\n\treturn &budget\n}\n\nfunc readLedgerJSON(path string, v any) error {\n\traw, err := readLedgerRaw(path)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := strictJSONBytes(raw, v); err != nil {\n\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n\t}\n\treturn nil\n}\n\nfunc readLedgerJSONIn(files Files, path string, v any) error {\n\traw, err := readBoundedRegularIn(files, path, reviewLedgerMaxBytes)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := strictJSONBytes(raw, v); err != nil {\n\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n\t}\n\treturn nil\n}\n\nfunc ledgerEntries(root, rel string) ([]os.DirEntry, error) {\n\tpath, err := ensureReviewArtifactDir(root, rel, false)\n\tif os.IsNotExist(err) {\n\t\treturn nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tentries, err := f.ReadDir(reviewLedgerMaxRecords + 1)\n\tcloseErr := f.Close()\n\tif err != nil && !errors.Is(err, io.EOF) {\n\t\treturn nil, err\n\t}\n\tif closeErr != nil {\n\t\treturn nil, closeErr\n\t}\n\tif len(entries) > reviewLedgerMaxRecords {\n\t\treturn nil, fmt.Errorf(\"ledger inventory exceeds %d records\", reviewLedgerMaxRecords)\n\t}\n\tsort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })\n\treturn entries, nil\n}\n\nfunc ledgerEntriesIn(files Files, root, rel string) ([]fs.DirEntry, error) {\n\tfiles = FilesOrNative(files)\n\tpath, err := ensureReviewArtifactDirIn(files, root, rel, false)\n\tif os.IsNotExist(err) {\n\t\treturn nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tf, err := files.Open(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treader, ok := f.(interface {\n\t\tReadDir(int) ([]fs.DirEntry, error)\n\t})\n\tif !ok {\n\t\t_ = f.Close()\n\t\treturn nil, fmt.Errorf(\"ledger directory does not support bounded reads\")\n\t}\n\tentries, err := reader.ReadDir(reviewLedgerMaxRecords + 1)\n\tcloseErr := f.Close()\n\tif err != nil && !errors.Is(err, io.EOF) {\n\t\treturn nil, err\n\t}\n\tif closeErr != nil {\n\t\treturn nil, closeErr\n\t}\n\tif len(entries) > reviewLedgerMaxRecords {\n\t\treturn nil, fmt.Errorf(\"ledger inventory exceeds %d records\", reviewLedgerMaxRecords)\n\t}\n\tsort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })\n\treturn entries, nil\n}\nfunc publishLedgerJSON(root, rel string, v any) error {\n\tdir, err := ensureReviewArtifactDir(root, filepath.ToSlash(filepath.Dir(rel)), true)\n\tif err != nil {\n\t\treturn err\n\t}\n\traw, err := json.MarshalIndent(v, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif len(raw) > reviewLedgerMaxBytes {\n\t\treturn fmt.Errorf(\"ledger record exceeds bound\")\n\t}\n\treturn PublishFile(filepath.Join(dir, filepath.Base(rel)), append(raw, '\\n'), 0644, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n}\n\nfunc (s Store) readDelegatedReviewAttempts(bundle string, budgets ...*int64) ([]DelegatedReviewAttempt, error) {\n\tbudget := reviewReadBudget(budgets)\n\trel := filepath.ToSlash(filepath.Join(reviewAttemptDir, reviewAttemptKey(bundle)))\n\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, rel)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tout := []DelegatedReviewAttempt{}\n\tfor _, e := range entries {\n\t\tif IsPublisherStaging(e.Name()) {\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n\t\t\tcontinue\n\t\t}\n\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n\t\t\treturn nil, fmt.Errorf(\"unknown attempt artifact %s\", e.Name())\n\t\t}\n\t\tvar a DelegatedReviewAttempt\n\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, rel, e.Name()), &a, budget); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif a.SchemaVersion != 1 || a.BundleID != bundle || a.Ordinal != len(out)+1 || a.AttemptID != attemptIdentity(a) || e.Name() != fmt.Sprintf(\"%06d.json\", a.Ordinal) {\n\t\t\treturn nil, fmt.Errorf(\"invalid attempt reservation %s\", e.Name())\n\t\t}\n\t\tif _, err := time.Parse(time.RFC3339Nano, a.ReservedAt); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tout = append(out, a)\n\t}\n\t// Orphan receipts are an unknown history, never ignored.\n\tfor _, e := range entries {\n\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n\t\t\tfound := false\n\t\t\tfor _, a := range out {\n\t\t\t\tif filepath.Base(attemptReceiptPath(s.Root, a)) == e.Name() {\n\t\t\t\t\tfound = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !found {\n\t\t\t\treturn nil, fmt.Errorf(\"attempt receipt has no reservation: %s\", e.Name())\n\t\t\t}\n\t\t}\n\t}\n\treturn out, nil\n}\nfunc (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (reviewAttemptReceipt, error) {\n\tbudget := reviewReadBudget(budgets)\n\tvar r reviewAttemptReceipt\n\tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n\t}\n\tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n\t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n\t}\n\tvar run ReviewRun\n\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, r.RunID+\".json\"), &run, budget); err != nil {\n\t\treturn r, err\n\t}\n\traw, _ := json.Marshal(run)\n\tif run.AttemptID != a.AttemptID || run.BundleID != a.BundleID || run.BundleDigest != a.BundleDigest || run.Adapter != a.Adapter || digestBytes(raw) != r.RunDigest {\n\t\treturn r, fmt.Errorf(\"attempt receipt does not bind its final run\")\n\t}\n\treturn r, nil\n}\nfunc (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttempt, int, error) {\n\tif len(plan.Reason) > 2048 || strings.ContainsAny(plan.Reason, \"\\x00\\r\\n\") {\n\t\treturn nil, 0, fmt.Errorf(\"rerun reason must be one line of at most 2048 bytes\")\n\t}\n\truns, lost, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n\tif err != nil {\n\t\treturn nil, 0, err\n\t}\n\tif len(lost) > 0 {\n\t\treturn nil, 0, fmt.Errorf(\"review run coverage is unknown: %v\", lost)\n\t}\n\tattempts, err := s.readDelegatedReviewAttempts(plan.Bundle.BundleID)\n\tif err != nil {\n\t\treturn nil, 0, err\n\t}\n\tknownAttempts := map[string]bool{}\n\tcount := 0\n\treceiptBudget := int64(32 << 20)\n\tfor _, a := range attempts {\n\t\tknownAttempts[a.AttemptID] = true\n\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n\t\t\treturn nil, 0, err\n\t\t}\n\t\tif a.Adapter == plan.Adapter {\n\t\t\tcount++\n\t\t}\n\t}\n\tcompleted := false\n\tfor _, run := range runs {\n\t\tif run.AttemptID != \"\" && !knownAttempts[run.AttemptID] {\n\t\t\treturn nil, 0, fmt.Errorf(\"missing attempt reservation %s\", run.AttemptID)\n\t\t}\n\t\tif run.Status == ReviewRunCompleted {\n\t\t\tcompleted = true\n\t\t}\n\t\tif run.AttemptID == \"\" && run.Adapter == plan.Adapter {\n\t\t\tcount++\n\t\t}\n\t}\n\tif count >= effectiveReviewMaxRuns(plan.Config) {\n\t\treturn nil, count, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"budget exhausted: %d attempt(s) of %s on this bundle, at most %d\", count, plan.Adapter, effectiveReviewMaxRuns(plan.Config)))\n\t}\n\tif completed && strings.TrimSpace(plan.Reason) == \"\" {\n\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n\t}\n\treturn attempts, count, nil\n}\n\n// prepareDelegatedReviewAttempt admits and builds the next reservation of\n// the bundle without publishing it.\nfunc (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n\tattempts, _, err := s.reviewAttemptAdmission(plan)\n\tif err != nil {\n\t\treturn DelegatedReviewAttempt{}, err\n\t}\n\tnonce := make([]byte, 16)\n\tif _, err := rand.Read(nonce); err != nil {\n\t\treturn DelegatedReviewAttempt{}, err\n\t}\n\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n\ta.AttemptID = attemptIdentity(a)\n\treturn a, nil\n}\n\n// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n// marks the attempt active first, so a dispatch that ends after this point\n// always leaves a marker that turns stalled and that `pose delegate cancel`\n// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n// review round 1, N1).\nfunc (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n\t}\n\treturn nil\n}\nfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n\traw, _ := json.Marshal(run)\n\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n}\n\n// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n// exists for legacy records; their content identity remains independently checked.\nfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n\tbudget := int64(32 << 20)\n\treturn s.reviewRunLedgerFindings(bundle, &budget)","numLines":440,"startLine":20,"totalLines":887}},"tool_result_meta":[{"id":"toolu_013AHw67mLgZnyMm9NzstBUy","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
