{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RDvgwh5apsyTvv3gfGu7Tm","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\t\"testing\"\n8\t)\n9\t\n10\t// Spec pose-review-resume-keeps-the-sealed-checkout R3: the attempt's\n11\t// directory is created exclusively; an existing path, a link included, fails\n12\t// the run instead of being shared or followed.\n13\tfunc TestRunContinuityAttemptRuntimeDirectoryIsCreatedExclusively(t *testing.T) {\n14\t\t// os.TempDir reads TMPDIR on Unix and TMP/TEMP on Windows (review round\n15\t\t// 2, N10).\n16\t\ttmp := t.TempDir()\n17\t\tfor _, name := range []string{\"TMPDIR\", \"TMP\", \"TEMP\"} {\n18\t\t\tt.Setenv(name, tmp)\n19\t\t}\n20\t\tid := \"rat-\" + strings.Repeat(\"ab\", 32)\n21\t\tdir, err := reviewRunRuntimeDir(id)\n22\t\tif err != nil {\n23\t\t\tt.Fatal(err)\n24\t\t}\n25\t\tif _, err := reviewRunRuntimeDir(id); err == nil || !strings.Contains(err.Error(), \"already exists\") {\n26\t\t\tt.Fatalf(\"an existing runtime directory was shared: %v\", err)\n27\t\t}\n28\t\tif err := os.Remove(dir); err != nil {\n29\t\t\tt.Fatal(err)\n30\t\t}\n31\t\ttarget := t.TempDir()\n32\t\tif err := os.Symlink(target, dir); err != nil {\n33\t\t\tt.Fatal(err)\n34\t\t}\n35\t\tif _, err := reviewRunRuntimeDir(id); err == nil {\n36\t\t\tt.Fatal(\"a link at the runtime directory was followed\")\n37\t\t}\n38\t\tif again, err := reviewRunRuntimeDir(\"\"); err != nil || filepath.Dir(again) != os.TempDir() {\n39\t\t\tt.Fatalf(\"a run without an attempt: %s %v\", again, err)\n40\t\t}\n41\t}\n42\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"b1a9cee9-baa5-44ad-ad05-b50ab52a6b77","timestamp":"2026-11-26T09:10:35.511Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-d0de10e622b0e2942987a4b9c044b402/worktree/pose-mcp/internal/pose/review_run_runtime_dir_test.go","content":"package pose\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// Spec pose-review-resume-keeps-the-sealed-checkout R3: the attempt's\n// directory is created exclusively; an existing path, a link included, fails\n// the run instead of being shared or followed.\nfunc TestRunContinuityAttemptRuntimeDirectoryIsCreatedExclusively(t *testing.T) {\n\t// os.TempDir reads TMPDIR on Unix and TMP/TEMP on Windows (review round\n\t// 2, N10).\n\ttmp := t.TempDir()\n\tfor _, name := range []string{\"TMPDIR\", \"TMP\", \"TEMP\"} {\n\t\tt.Setenv(name, tmp)\n\t}\n\tid := \"rat-\" + strings.Repeat(\"ab\", 32)\n\tdir, err := reviewRunRuntimeDir(id)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := reviewRunRuntimeDir(id); err == nil || !strings.Contains(err.Error(), \"already exists\") {\n\t\tt.Fatalf(\"an existing runtime directory was shared: %v\", err)\n\t}\n\tif err := os.Remove(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\ttarget := t.TempDir()\n\tif err := os.Symlink(target, dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := reviewRunRuntimeDir(id); err == nil {\n\t\tt.Fatal(\"a link at the runtime directory was followed\")\n\t}\n\tif again, err := reviewRunRuntimeDir(\"\"); err != nil || filepath.Dir(again) != os.TempDir() {\n\t\tt.Fatalf(\"a run without an attempt: %s %v\", again, err)\n\t}\n}\n","numLines":42,"startLine":1,"totalLines":42}},"tool_result_meta":[{"id":"toolu_01RDvgwh5apsyTvv3gfGu7Tm","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
