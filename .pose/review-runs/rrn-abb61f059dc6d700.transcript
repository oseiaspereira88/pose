{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '590,666p' pose-mcp/internal/cli/validate_carry_test.go; sed -n '937,1018p' pose-mcp/internal/cli/validate_carry_test.go; cat .pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md; sed -n '1,140p' pose-mcp/internal/cli/validate_results_publication.go; rg -n 'publishCanonicalValidationJSONIn' pose-mcp/internal/cli\"","aggregated_output":"\tif reason := aliasedModule(modules, identity, same); !strings.Contains(reason, \"shares its directory\") {\n\t\tt.Fatalf(\"reason = %q, want modules sharing a directory refused\", reason)\n\t}\n\tdistinct := func(p string) (os.FileInfo, error) { return os.Stat(map[string]string{\"/repo/a\": dir, \"/repo/A\": t.TempDir()}[p]) }\n\tif reason := aliasedModule(modules, identity, distinct); reason != \"\" {\n\t\tt.Fatalf(\"distinct directories refused: %q\", reason)\n\t}\n}\n\n// Selection uses the head pinned before planning, not whatever HEAD is later\n// (review round 5, N14).\nfunc TestCarryPlansAgainstThePinnedHead(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.baseline()\n\tpinned := f.git(\"rev-parse\", \"HEAD\")\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"a change after the pin\")\n\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\tmatrix, err := parseValidationMatrix(raw)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tmodules, err := discoverValidationModules(f.root)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdigest := sha256.Sum256(raw)\n\tplan := planCarry(f.root, carryResults, \"strict\", \"sha256:\"+hex.EncodeToString(digest[:]), pinned, matrix, modules)\n\tif plan.record.Used && len(plan.record.Selected) != 0 {\n\t\tt.Fatalf(\"selected = %v, want nothing changed up to the pinned head\", plan.record.Selected)\n\t}\n\tif !plan.record.Used && !strings.Contains(plan.record.Reason, \"engine\") {\n\t\tt.Fatalf(\"carry unused for an unexpected reason: %q\", plan.record.Reason)\n\t}\n}\n\n// A discovered dependency above the changed module selects its dependents\n// (review round 6, N15), and so does a discovered root dependency.\nfunc TestChangedScopeDiscoveredAncestorDependencySelectsItsDependents(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"a\"]}}}`)\n\tf.write(\"a/nested/go.mod\", \"module nested\\n\")\n\tf.commit(\"nested module\")\n\tf.write(\"a/nested/input.txt\", \"x\\n\")\n\tf.commit(\"change nested\")\n\t_, out := runValidate(t, f.root, \"--changed-from\", \"HEAD~1\", \"--changed-to\", \"HEAD\", \"--explain\")\n\tif !strings.Contains(out, \"+ b: declared dependency a changed: a/nested/input.txt\") {\n\t\tt.Fatalf(\"b must be selected through its discovered ancestor dependency: %s\", out)\n\t}\n\n\tg := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\".\"]}}}`)\n\tg.write(\"go.mod\", \"module root\\n\")\n\tg.commit(\"root module\")\n\tg.write(\"a/changed.go\", \"package a\\n\")\n\tg.commit(\"change a\")\n\t_, out = runValidate(t, g.root, \"--changed-from\", \"HEAD~1\", \"--changed-to\", \"HEAD\", \"--explain\")\n\tif !strings.Contains(out, \"+ b: declared dependency . changed: a/changed.go\") {\n\t\tt.Fatalf(\"b must be selected through its discovered root dependency: %s\", out)\n\t}\n}\n\n// A declared dependency reached through a symlink refuses the carry (review\n// round 6, N16).\nfunc TestCarryRefusesDependenciesReachedThroughASymlink(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"link\"]}}}`)\n\tif err := os.Symlink(\"a\", filepath.Join(f.root, \"link\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.commit(\"link\")\n\tf.baseline()\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"change a\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"symlink link\") {\n\t\tt.Fatalf(\"carry = %+v, want an aliased dependency refused\", run.Carry)\n\t}\n}\n\n\t\t\treturn nil, os.ErrNotExist\n\t\t}\n\t\tif strings.EqualFold(filepath.Base(p), \"input\") {\n\t\t\treturn info, nil\n\t\t}\n\t\treturn os.Lstat(p)\n\t}\n\tif !casefoldedDirectory(dir, os.ReadDir, folding) {\n\t\tt.Fatal(\"a folding directory must be detected past an unusable first entry\")\n\t}\n\tunreadable := func(string) ([]os.DirEntry, error) { return nil, os.ErrPermission }\n\tif !casefoldedDirectory(dir, unreadable, os.Lstat) {\n\t\tt.Fatal(\"an unreadable directory must not count as case-sensitive\")\n\t}\n}\n\n// A dependency outside the repository refuses the carry (review round 10,\n// N28).\nfunc TestCarryRefusesDependenciesOutsideTheRepository(t *testing.T) {\n\tfor _, dep := range []string{\"../shared/input\", \"/etc/shared\"} {\n\t\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"`+dep+`\"]}}}`)\n\t\tf.baseline()\n\t\tf.write(\"a/changed.go\", \"package a\\n\")\n\t\tf.commit(\"change a\")\n\t\t_, _, run := f.validate(\"--carry\")\n\t\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"outside the repository\") {\n\t\t\tt.Fatalf(\"dependsOn %s: carry = %+v, want an external dependency refused\", dep, run.Carry)\n\t\t}\n\t}\n}\n\n// A dependency that is not already clean refuses the carry (review round 11,\n// N30).\nfunc TestCarryRefusesUncleanDependencies(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"unowned/link/../input\"]}}}`)\n\tf.baseline()\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"change a\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"not a clean path\") {\n\t\tt.Fatalf(\"carry = %+v, want an unclean dependency refused\", run.Carry)\n\t}\n}\n\n// Non-ASCII module or dependency paths refuse the carry (review round 11,\n// N32).\nfunc TestCarryRefusesNonASCIIPaths(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"shared/café.txt\"]}}}`)\n\tf.baseline()\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"change a\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"not an ASCII path\") {\n\t\tt.Fatalf(\"carry = %+v, want a non-ASCII dependency refused\", run.Carry)\n\t}\n}\n\n// An index entry hiding edits from status means the run validated no known\n// tree, and refuses the carry (review round 11, N31).\nfunc TestCarryRefusesHiddenIndexEntries(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.write(\"b/input\", \"x\\n\")\n\tf.commit(\"b input\")\n\tf.git(\"update-index\", \"--skip-worktree\", \"b/input\")\n\tif _, out, run := f.validate(); run.MaterialClean {\n\t\tt.Fatalf(\"material_clean = true with a skip-worktree entry: %s\", out)\n\t}\n\tf.git(\"update-index\", \"--no-skip-worktree\", \"b/input\")\n\tf.baseline()\n\tf.git(\"update-index\", \"--assume-unchanged\", \"b/input\")\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.git(\"add\", \"a/changed.go\")\n\tf.git(\"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-qm\", \"change a\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"assume-unchanged or skip-worktree\") {\n\t\tt.Fatalf(\"carry = %+v, want a hidden index entry refused\", run.Carry)\n\t}\n}\n---\ntype: decision-log\nslug: module-metadata-discovery-invalidates-review-provenance\nowner: @pose-maintainers\nsensitivity: public-internal\ncreated_at: 2026-08-16\nlast_reviewed_at: 2026-08-16\nexpires_at: 2026-11-14\nsource_refs:\n  spec: \"pose-upgrade-path-audit-fixes\"\n  workflow: \"bugfix\"\n  commands: [\"pose update --force\", \"pose install\", \"pose index\", \"pose review bundle --seal\"]\n  external_sources: []\n---\n\n# decision-log: module-metadata-discovery-invalidates-review-provenance\n\n## Context\n\nAuditing `pose update`/`pose install` across 7 real repositories ahead of\nthe v1.4.0 release found that running either command on `pose-dist` itself\n(the product's own dogfooding instance) discovered\n`examples/brownfield-kits/direct-adoption/fixture/service/go.mod` — an\nillustrative fixture, not a real deliverable module — as a genuine module\nand added it to `.pose/indexes/module-metadata.json`. That single addition\nrecomputed the global provenance digest (`graph.ProvenanceDigest`, computed\nover the whole delivery-integrity graph, not per-spec — see the\n`pose-gate-closeout-procedure` session note this decision-log\ngeneralizes) and superseded the review attestation of every already-closed\nspec whose scope touches `module-metadata.json`: between 3 and 22 specs\nacross the audit's trial runs, depending on which other specs had most\nrecently closed.\n\n## Current state\n\nFixed the trigger only (spec `pose-upgrade-path-audit-fixes`, R7):\n`testdata`, `fixture` and `fixtures` directories are now excluded from\nmodule discovery in all three independent walkers\n(`discoverValidationModules` in validate.go, `scanModules` in index.go,\nand `internal/pose/discovery.go`'s capability scanner). A genuine,\nintentional module-metadata change — a real module added, removed or\nreclassified — still invalidates every closed spec's review attestation\nthat touches it, exactly as designed today. That broader behavior was\ndeliberately left unchanged (Decision 2 in the spec above): narrowing the\nprovenance digest so it only invalidates reviews whose scope actually\nincludes the changed module is a real design trade-off (what counts as\n\"unrelated,\" whether a narrower digest weakens the guarantee it exists to\nprovide) that deserves its own spec and explicit review, not a side effect\nof fixing a discovery false-positive.\n\n## Next checks\n\n- None deterministic yet. If a future spec pursues narrowing the\n  provenance digest, `pose-mcp/internal/pose/delivery_integrity.go`\n  (`ProvenanceDigest`) and `pose review bundle --seal`'s scope-provenance\n  matching are the two places to start reading.\n\n## Risks\n\n- Any *other* directory-discovery path added in the future (a fourth\n  scanner, or a stack detector that walks the tree independently) needs\n  the same `testdata`/`fixture`/`fixtures` exclusion applied by hand —\n  there is no single shared walker all three call today (each has its own\n  `ignored` map/condition; see the follow-up already on record about this\n  in `pose-review-bundle-roadmap-path-portability`/session knowledge about\n  \"enumerate by hand\" gaps recurring across this repository).\n- Every maintainer who runs `pose update --force`/`pose install` on\n  `pose-dist` itself after a *real* module-metadata change should expect\n  to reseal/reattest every closed spec whose review scope includes\n  `module-metadata.json`, per `pose-gate-closeout-procedure` — this is\n  expected, not a bug, and this decision-log's fix does not change it.\n\n## Next owner\n\n@pose-maintainers — no active handoff; revisit only if the digest-scoping\nfollow-up (spec `pose-upgrade-path-audit-fixes`, Follow-ups) is picked up.\n\n## References\n\n- spec:pose-upgrade-path-audit-fixes (Decision 2, R7, Non-goals)\n- knowledge: session note `pose-gate-closeout-procedure` (this repository's\n  own local agent memory, not a `.pose/knowledge/` artifact) — first\n  documented that the provenance digest is global-over-the-graph, not\n  per-spec, and that reseal/reattest is required after any reindex that\n  changes it.\nsed: can't read pose-mcp/internal/cli/validate_results_publication.go: No such file or directory\npose-mcp/internal/cli/validate.go:1500:\t\t\terr := publishCanonicalValidationJSONIn(store, writer.path, canonicalResultsPath, run)\npose-mcp/internal/cli/validate_results.go:236:\treturn publishCanonicalValidationJSONIn(cliGovernedStore(root), relative, expectedPolicyPath, run)\npose-mcp/internal/cli/validate_results.go:239:func publishCanonicalValidationJSONIn(store posemodel.Store, relative, expectedPolicyPath string, run validationRunResult) error {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '230,298p' pose-mcp/internal/cli/validate_results.go; rg -n 'func Test' pose-mcp/internal/pose/delivery_validation_run_test.go; git status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '230,298p' pose-mcp/internal/cli/validate_results.go; rg -n 'func Test' pose-mcp/internal/pose/delivery_validation_run_test.go; git status --short\"","aggregated_output":"}\n\n// publishCanonicalValidationJSON rechecks the delivery policy after acquiring\n// the root lease, then publishes the exact canonical result through B14. A\n// changed path is refused before creating or replacing the result.\nfunc publishCanonicalValidationJSON(root, relative, expectedPolicyPath string, run validationRunResult) error {\n\treturn publishCanonicalValidationJSONIn(cliGovernedStore(root), relative, expectedPolicyPath, run)\n}\n\nfunc publishCanonicalValidationJSONIn(store posemodel.Store, relative, expectedPolicyPath string, run validationRunResult) error {\n\treturn store.WithGovernanceWriteGuardForProjects(\"validate.publish-results\", nil, func(store posemodel.Store) error {\n\t\tpolicy, err := posemodel.LoadDeliveryPolicyIn(store.FS, store.Root)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tcurrentPath := normalizeValidationOutputPath(policy.ResultsPath)\n\t\tif currentPath == \"\" || currentPath != expectedPolicyPath || currentPath != normalizeValidationOutputPath(relative) {\n\t\t\treturn fmt.Errorf(\"configured delivery results path changed before publication; nothing was written\")\n\t\t}\n\t\tpayload, err := marshalValidationJSON(run)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\ttarget := filepath.Join(store.Root, filepath.FromSlash(currentPath))\n\t\tif err := store.FS.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn store.FS.Publish(target, payload, 0o644, posemodel.PublishAuthoritative, posemodel.PublishExpectation{Mode: posemodel.ExpectAny})\n\t})\n}\n\n// --- JUnit projection -------------------------------------------------------\n// Mapping: one <testsuite> per module, one <testcase> per check. POSE\n// \"error\" maps to <error> (infrastructure), \"fail\" to <failure>, \"skipped\"\n// to <skipped> with the deterministic reason. Optional-severity failures are\n// still <failure> — JUnit has no tolerated level, so the POSE severity is\n// preserved in the testcase classname suffix (documented lossy edge).\n\ntype junitTestCase struct {\n\tXMLName   xml.Name      `xml:\"testcase\"`\n\tName      string        `xml:\"name,attr\"`\n\tClassName string        `xml:\"classname,attr\"`\n\tTime      string        `xml:\"time,attr\"`\n\tFailure   *junitMessage `xml:\"failure,omitempty\"`\n\tError     *junitMessage `xml:\"error,omitempty\"`\n\tSkipped   *junitMessage `xml:\"skipped,omitempty\"`\n}\n\ntype junitMessage struct {\n\tMessage string `xml:\"message,attr\"`\n\tBody    string `xml:\",chardata\"`\n}\n\ntype junitSuite struct {\n\tXMLName  xml.Name        `xml:\"testsuite\"`\n\tName     string          `xml:\"name,attr\"`\n\tTests    int             `xml:\"tests,attr\"`\n\tFailures int             `xml:\"failures,attr\"`\n\tErrors   int             `xml:\"errors,attr\"`\n\tSkipped  int             `xml:\"skipped,attr\"`\n\tCases    []junitTestCase `xml:\"testcase\"`\n}\n\ntype junitSuites struct {\n\tXMLName xml.Name     `xml:\"testsuites\"`\n\tName    string       `xml:\"name,attr\"`\n\tSuites  []junitSuite `xml:\"testsuite\"`\n}\n\n7:func TestDeliveryValidationRunReadsTheCarriedHead(t *testing.T) {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"agent_message","text":"The targeted carry and selection tests passed. Source review points to two remaining gaps: dependency aliases are checked only in tracked symlinks, and the clean-head check compares only the start and end commits. I’m tracing both cases further. Scratch-directory creation failed under the read-only sandbox, so I have not run the assessments that persist files.\n"}}
