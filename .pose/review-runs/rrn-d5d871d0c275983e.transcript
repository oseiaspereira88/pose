TrimSuffix(filepath.Base(path), \".md\"))\n\t\t\t}\n\t\t}\n\t\tresults := make([][]string, len(refs))\n\t\t// Bound live scope closures even when the worker override or host CPU count\n\t\t// is large. Retain only evaluated findings after each scope's final audit.\n\t\tslots := min(16, len(refs))\n\t\tchecker.failOrWarnPerItem(slots, func(slot int) []string {\n\t\t\tfor i := slot; i < len(refs); i += slots {\n\t\t\t\tref := refs[i]\n\t\t\t\tvar state pose.CloseoutState\n\t\t\t\terr := store.WithReviewScopeOperationView(func(scoped pose.Store) error {\n\t\t\t\t\tvar err error\n\t\t\t\t\tstate, err = scoped.GetCloseoutState(ref)\n\t\t\t\t\treturn err\n\t\t\t\t})\n\t\t\t\tif err != nil {\n\t\t\t\t\tresults[i] = []string{\"review closeout: \" + ref + \": \" + err.Error()}\n\t\t\t\t} else if !state.Terminal {\n\t\t\t\t\tresults[i] = []string{\"review closeout: \" + ref + \": \" + state.NextAction}\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn nil\n\t\t})\n\t\tfor _, messages := range results {\n\t\t\tfindings = append(findings, messages...)\n\t\t}\n\t\treturn nil\n\t})\n\t// A failed coordinator audit prevents a green gate, but does not erase\n\t// independently audited scope failures already buffered above.\n\tfor _, finding := range findings {\n\t\tchecker.failOrWarn(finding)\n\t}\n\tif viewErr != nil {\n\t\tchecker.failOrWarn(\"review closeout: \" + viewErr.Error())\n\t}\n}\n\nfunc (checker *nativeChecker) checkRequiredStructure() {\n\trequired := []string{\"AGENTS.md\", \"POSE.md\", \".pose\", \".pose/workflows\", \".pose/templates\", \".pose/rules\", \".pose/workflows/feature.md\", \".pose/workflows/review.md\", \".pose/workflows/bugfix.md\", \".pose/templates/spec.md\"}\n\tfor _, rel := range required {\n\t\tif _, err := checker.fsys().Stat(filepath.Join(checker.root, filepath.FromSlash(rel))); err != nil {\n\t\t\tchecker.issue(cliout.StateError, checker.message(\"Required path missing: \", \"Path obrigatório ausente: \")+filepath.Join(checker.root, filepath.FromSlash(rel)))\n\t\t}\n\t}\n}\n\nfunc (checker *nativeChecker) checkSchemaVersion() {\n\tpath := filepath.Join(checker.root, \".pose\", \"schema-version\")\n\tcontent, err := checker.fsys().ReadFile(path)\n\tif err != nil {\n\t\tchecker.failOrWarn(checker.message(\"schema: instance has no .pose/schema-version — run 'pose update'\", \"schema: instância sem .pose/schema-version — rode 'pose update'\"))\n\t\treturn\n\t}\n\tversion, err := strconv.Atoi(strings.TrimSpace(string(content)))\n\tif err != nil {\n\t\tchecker.issue(cliout.StateError, fmt.Sprintf(checker.message(\"schema: invalid .pose/schema-version (%q)\", \"schema: .pose/schema-version inválido (%q)\"), strings.TrimSpace(string(content))))\n\t\treturn\n\t}\n\tif version > nativeSchemaVersion {\n\t\tchecker.issue(cliout.StateError, fmt.Sprintf(checker.message(\"schema: instance v%d is newer than engine v%d\", \"schema: instância v%d é mais nova que o motor v%d\"), version, nativeSchemaVersion))\n\t}\n\tif version < nativeSchemaVersion {\n\t\tchecker.failOrWarn(fmt.Sprintf(checker.message(\"schema: instance v%d is behind engine v%d — run 'pose update'\", \"schema: instância v%d atrás do motor v%d — rode 'pose update'\"), version, nativeSchemaVersion))\n\t}\n}\n\ninternal/pose/governance_read_view.go:2605:func (s Store) withGovernanceReadView(view *governanceReadView, producer string) Store {\ninternal/pose/governance_read_view_capture.go:53:\tstore := base.withGovernanceReadView(view, producer).PinIndexes()\ninternal/pose/obligation_projection.go:142:\ts = baseStore.withGovernanceReadView(view, \"projection\").PinIndexes()\ninternal/pose/obligation_projection.go:220:\t\tproducerStores[i] = s.withGovernanceReadView(view, producer.name).withSpecSnapshot()\ninternal/pose/review_closeout.go:488:\tstore := base.withGovernanceReadView(view, producer).PinIndexes()\ninternal/pose/review_operation_view.go:127:\tshared := base.withGovernanceReadView(readView, \"review-operation\")\ninternal/pose/review_operation_view.go:647:\tshared :=