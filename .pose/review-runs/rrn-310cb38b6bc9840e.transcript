{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/closeout_adr_associations.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// ADR associations of a roadmap, for the when-justified roadmap rule of the\n     4\t// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n     5\t//\n     6\t// An association is explicit, never inferred from prose:\n     7\t//   - forward: the roadmap's `adrs: [adr:<file>.md]` frontmatter, or a local\n     8\t//     Markdown link from its body to a file in .pose/adr/;\n     9\t//   - backward: an ADR's `roadmaps: [roadmap:<slug>]` (or the qualified\n    10\t//     `xref:<project>/roadmap:<slug>`) frontmatter, or a local Markdown link\n    11\t//     from the ADR to .pose/roadmaps/<slug>.md.\n    12\t//\n    13\t// Only the owning project's .pose/adr/ is inventoried; nothing searches other\n    14\t// projects. A malformed declaration, a link to a missing file or an\n    15\t// incomplete inventory is unknown, which can never prove absence.\n    16\t\n    17\timport (\n    18\t\t\"fmt\"\n    19\t\t\"os\"\n    20\t\t\"path/filepath\"\n    21\t\t\"regexp\"\n    22\t\t\"sort\"\n    23\t\t\"strings\"\n    24\t)\n    25\t\n    26\tconst (\n    27\t\tcloseoutADRInventoryLimit = 4096\n    28\t\tcloseoutADRSizeLimit      = 1 << 20\n    29\t)\n    30\t\n    31\tvar (\n    32\t\t// [text](dest \"title\") and [text](<dest>) inline links.\n    33\t\tmarkdownInlineLinkRE = regexp.MustCompile(`\\]\\(\\s*(<[^>\\n]*>|[^)\\s]+)(?:\\s+(?:\"[^\"]*\"|'[^']*'|\\([^)]*\\)))?\\s*\\)`)\n    34\t\t// [label]: dest \"title\" reference definitions.\n    35\t\tmarkdownReferenceLinkRE = regexp.MustCompile(`(?m)^\\s{0,3}\\[[^\\]\\n]+\\]:\\s*(<[^>\\n]*>|\\S+)`)\n    36\t)\n    37\t\n    38\tfunc (s Store) adrDir() string { return filepath.Join(s.Root, \".pose\", \"adr\") }\n    39\t\n    40\t// markdownLinkDestinations lists the link destinations of a Markdown body,\n    41\t// angle brackets and fragments removed. External URLs are kept out.\n    42\tfunc markdownLinkDestinations(body string) []string {\n    43\t\t// Fenced code, inline code and comments document links; they do not make\n    44\t\t// them (review round 12, N40).\n    45\t\tbody = markdownWithoutCode(body)\n    46\t\tout := []string{}\n    47\t\tadd := func(dest string) {\n    48\t\t\tdest = strings.TrimSpace(dest)\n    49\t\t\tdest = strings.TrimSuffix(strings.TrimPrefix(dest, \"<\"), \">\")\n    50\t\t\tif i := strings.IndexAny(dest, \"#?\"); i >= 0 {\n    51\t\t\t\tdest = dest[:i]\n    52\t\t\t}\n    53\t\t\tif dest == \"\" || strings.Contains(dest, \"://\") || strings.HasPrefix(dest, \"mailto:\") || strings.HasPrefix(dest, \"/\") {\n    54\t\t\t\treturn\n    55\t\t\t}\n    56\t\t\tout = append(out, dest)\n    57\t\t}\n    58\t\tfor _, m := range markdownInlineLinkRE.FindAllStringSubmatch(body, -1) {\n    59\t\t\tadd(m[1])\n    60\t\t}\n    61\t\tfor _, m := range markdownReferenceLinkRE.FindAllStringSubmatch(body, -1) {\n    62\t\t\tadd(m[1])\n    63\t\t}\n    64\t\treturn out\n    65\t}\n    66\t\n    67\tvar (\n    68\t\tmarkdownCommentRE    = regexp.MustCompile(`(?s)<!--.*?-->`)\n    69\t\tmarkdownInlineCodeRE = regexp.MustCompile(\"`+[^`\\n]*`+\")\n    70\t)\n    71\t\n    72\t// markdownWithoutCode blanks fenced code blocks, inline code spans and HTML\n    73\t// comments, so the links they show are not read as links.\n    74\tfunc markdownWithoutCode(body string) string {\n    75\t\tbody = markdownCommentRE.ReplaceAllString(body, \"\")\n    76\t\tvar out strings.Builder\n    77\t\tfence := \"\"\n    78\t\tfor _, line := range strings.SplitAfter(body, \"\\n\") {\n    79\t\t\ttrimmed := strings.TrimSpace(line)\n    80\t\t\tif fence != \"\" {\n    81\t\t\t\tif strings.HasPrefix(trimmed, fence) {\n    82\t\t\t\t\tfence = \"\"\n    83\t\t\t\t}\n    84\t\t\t\tout.WriteString(\"\\n\")\n    85\t\t\t\tcontinue\n    86\t\t\t}\n    87\t\t\tif strings.HasPrefix(trimmed, \"```\") || strings.HasPrefix(trimmed, \"~~~\") {\n    88\t\t\t\tfence = trimmed[:3]\n    89\t\t\t\tout.WriteString(\"\\n\")\n    90\t\t\t\tcontinue\n    91\t\t\t}\n    92\t\t\tout.WriteString(markdownInlineCodeRE.ReplaceAllString(line, \"\"))\n    93\t\t}\n    94\t\treturn out.String()\n    95\t}\n    96\t\n    97\t// associationList reads one association key (adrs: on a roadmap, roadmaps: on\n    98\t// an ADR) from the raw frontmatter of a governance file, strictly: a key\n    99\t// declared more than once, declared with no value, outside a [list], or with\n   100\t// an empty item is reported, never read as an absent or empty association. An\n   101\t// explicit [] declares none (review round 12, N39).\n   102\tfunc associationList(raw, key, owner string) ([]string, bool, string) {\n   103\t\tlines := strings.Split(strings.ReplaceAll(raw, \"\\r\\n\", \"\\n\"), \"\\n\")\n   104\t\tif len(lines) == 0 || strings.TrimSpace(lines[0]) != \"---\" {\n   105\t\t\treturn nil, false, \"\"\n   106\t\t}\n   107\t\tvalues := []string{}\n   108\t\tfor _, line := range lines[1:] {\n   109\t\t\tif strings.TrimSpace(line) == \"---\" {\n   110\t\t\t\tbreak\n   111\t\t\t}\n   112\t\t\tif value, ok := strings.CutPrefix(line, key+\":\"); ok {\n   113\t\t\t\tvalues = append(values, strings.TrimSpace(value))\n   114\t\t\t}\n   115\t\t}\n   116\t\tswitch {\n   117\t\tcase len(values) == 0:\n   118\t\t\treturn nil, false, \"\"\n   119\t\tcase len(values) > 1:\n   120\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: %d times; one declaration is required\", owner, key, len(values))\n   121\t\t}\n   122\t\tvalue := values[0]\n   123\t\tif value == \"\" {\n   124\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with no value; declare [] for none\", owner, key)\n   125\t\t}\n   126\t\tif !strings.HasPrefix(value, \"[\") || !strings.HasSuffix(value, \"]\") {\n   127\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: outside a [list]\", owner, key)\n   128\t\t}\n   129\t\tinner := strings.TrimSpace(value[1 : len(value)-1])\n   130\t\tif inner == \"\" {\n   131\t\t\treturn []string{}, true, \"\"\n   132\t\t}\n   133\t\titems := []string{}\n   134\t\tfor _, item := range strings.Split(inner, \",\") {\n   135\t\t\titem = strings.TrimSpace(item)\n   136\t\t\tif item == \"\" {\n   137\t\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with an empty item\", owner, key)\n   138\t\t\t}\n   139\t\t\titems = append(items, item)\n   140\t\t}\n   141\t\treturn items, true, \"\"\n   142\t}\n   143\t\n   144\t// validADRBasename accepts exactly a file name ending in .md directly inside\n   145\t// .pose/adr/: no directory, traversal, hidden file or URI.\n   146\tfunc validADRBasename(name string) bool {\n   147\t\treturn name != \"\" && filepath.Base(name) == name && !strings.ContainsAny(name, `/\\:`) &&\n   148\t\t\t!strings.HasPrefix(name, \".\") && strings.HasSuffix(name, \".md\") && name != \".md\"\n   149\t}\n   150\t\n   151\t// regularADR reports a regular, non-symlinked file of .pose/adr/ within the root.\n   152\tfunc (s Store) regularADR(name string) error {\n   153\t\tpath := filepath.Join(s.adrDir(), name)\n   154\t\tinfo, err := s.fsys().Lstat(path)\n   155\t\tif err != nil {\n   156\t\t\treturn err\n   157\t\t}\n   158\t\tif info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n   159\t\t\treturn fmt.Errorf(\"not a regular file inside .pose/adr\")\n   160\t\t}\n   161\t\treturn nil\n   162\t}\n   163\t\n   164\t// closeoutADRAssociations returns the sorted ADR basenames associated with a\n   165\t// roadmap, and the diagnostics that make the answer unknown.\n   166\tfunc (s Store) closeoutADRAssociations(rm *Roadmap, project string) ([]string, []string) {\n   167\t\tfound := map[string]bool{}\n   168\t\tdiagnostics := []string{}\n   169\t\trawRoadmap, readErr := s.fsys().ReadFile(rm.Path)\n   170\t\tif readErr != nil {\n   171\t\t\tdiagnostics = append(diagnostics, \"roadmap \"+rm.Slug+\" could not be read for its adrs: \"+readErr.Error())\n   172\t\t}\n   173\t\tdeclared, _, declarationProblem := associationList(string(rawRoadmap), \"adrs\", \"roadmap \"+rm.Slug)\n   174\t\tif declarationProblem != \"\" {\n   175\t\t\tdiagnostics = append(diagnostics, declarationProblem)\n   176\t\t}\n   177\t\tfor _, item := range declared {\n   178\t\t\tname, ok := strings.CutPrefix(item, \"adr:\")\n   179\t\t\tif !ok || !validADRBasename(name) {\n   180\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares %q, not adr:<file>.md\", rm.Slug, item))\n   181\t\t\t\tcontinue\n   182\t\t\t}\n   183\t\t\tif err := s.regularADR(name); err != nil {\n   184\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares adr:%s, which cannot be read: %v\", rm.Slug, name, err))\n   185\t\t\t\tcontinue\n   186\t\t\t}\n   187\t\t\tfound[name] = true\n   188\t\t}\n   189\t\tbody := rm.Body\n   190\t\tif body == \"\" {\n   191\t\t\tif full, err := s.GetRoadmap(rm.Slug); err == nil {\n   192\t\t\t\tbody = full.Body\n   193\t\t\t}\n   194\t\t}\n   195\t\troadmapDir := filepath.Dir(rm.Path)\n   196\t\tfor _, dest := range markdownLinkDestinations(body) {\n   197\t\t\ttarget := filepath.Clean(filepath.Join(roadmapDir, filepath.FromSlash(dest)))\n   198\t\t\tif filepath.Dir(target) != filepath.Clean(s.adrDir()) || !strings.HasSuffix(target, \".md\") {\n   199\t\t\t\tcontinue\n   200\t\t\t}\n   201\t\t\tname := filepath.Base(target)\n   202\t\t\tif err := s.regularADR(name); err != nil {\n   203\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, which cannot be read: %v\", rm.Slug, dest, err))\n   204\t\t\t\tcontinue\n   205\t\t\t}\n   206\t\t\tfound[name] = true\n   207\t\t}\n   208\t\tentries, err := s.fsys().ReadDir(s.adrDir())\n   209\t\tif err != nil && !os.IsNotExist(err) {\n   210\t\t\tdiagnostics = append(diagnostics, \"the ADR inventory could not be read: \"+err.Error())\n   211\t\t}\n   212\t\tif len(entries) > closeoutADRInventoryLimit {\n   213\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"the ADR inventory has %d entries, above the limit of %d\", len(entries), closeoutADRInventoryLimit))\n   214\t\t\tentries = nil\n   215\t\t}\n   216\t\troadmapPath := filepath.Clean(filepath.Join(s.roadmapsDir(), rm.Slug+\".md\"))\n   217\t\tfor _, entry := range entries {\n   218\t\t\tname := entry.Name()\n   219\t\t\t// Every candidate is read, the associated ones included: its size,\n   220\t\t\t// its readability and its own declaration are inputs. One that\n   221\t\t\t// cannot be read could hold a backlink, so it is unknown.\n   222\t\t\tif entry.IsDir() || !strings.HasSuffix(name, \".md\") {\n   223\t\t\t\tcontinue\n   224\t\t\t}\n   225\t\t\tif err := s.regularADR(name); err != nil {\n   226\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is not a regular file of .pose/adr: \"+err.Error())\n   227\t\t\t\tcontinue\n   228\t\t\t}\n   229\t\t\tpath := filepath.Join(s.adrDir(), name)\n   230\t\t\tif info, err := s.fsys().Lstat(path); err != nil || info.Size() > closeoutADRSizeLimit {\n   231\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is unreadable or above the size limit\")\n   232\t\t\t\tcontinue\n   233\t\t\t}\n   234\t\t\traw, err := s.fsys().ReadFile(path)\n   235\t\t\tif err != nil {\n   236\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" could not be read: \"+err.Error())\n   237\t\t\t\tcontinue\n   238\t\t\t}\n   239\t\t\t_, adrBody := SplitFrontmatter(string(raw))\n   240\t\t\tbackward, _, backwardProblem := associationList(string(raw), \"roadmaps\", \"ADR \"+name)\n   241\t\t\tif backwardProblem != \"\" {\n   242\t\t\t\tdiagnostics = append(diagnostics, backwardProblem)\n   243\t\t\t}\n   244\t\t\tfor _, item := range backward {\n   245\t\t\t\tref, err := ParseArtifactRef(item)\n   246\t\t\t\tif err != nil || ref.Kind != \"roadmap\" || ref.Milestone != \"\" {\n   247\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %q, not roadmap:<slug>\", name, item))\n   248\t\t\t\t\tcontinue\n   249\t\t\t\t}\n   250\t\t\t\tif ref.Project != \"\" && ref.Project != project {\n   251\t\t\t\t\tcontinue // a roadmap of another project: not this association\n   252\t\t\t\t}\n   253\t\t\t\tif _, err := s.GetRoadmap(ref.Slug); err != nil {\n   254\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %s, which names no roadmap of this project\", name, item))\n   255\t\t\t\t\tcontinue\n   256\t\t\t\t}\n   257\t\t\t\tif ref.Slug == rm.Slug {\n   258\t\t\t\t\tfound[name] = true\n   259\t\t\t\t}\n   260\t\t\t}\n   261\t\t\tfor _, dest := range markdownLinkDestinations(adrBody) {\n   262\t\t\t\ttarget := filepath.Clean(filepath.Join(s.adrDir(), filepath.FromSlash(dest)))\n   263\t\t\t\tif filepath.Dir(target) != filepath.Clean(s.roadmapsDir()) || !strings.HasSuffix(target, \".md\") {\n   264\t\t\t\t\tcontinue\n   265\t\t\t\t}\n   266\t\t\t\t// A link into the roadmaps namespace is an association input: one\n   267\t\t\t\t// that does not resolve to a roadmap leaves the answer unknown.\n   268\t\t\t\tif info, err := s.fsys().Lstat(target); err != nil || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, target) {\n   269\t\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which is not a roadmap of this project\")\n   270\t\t\t\t\tcontinue\n   271\t\t\t\t}\n   272\t\t\t\t// The target is read as the roadmap it names, as a roadmaps:\n   273\t\t\t\t// declaration is: a regular entry that cannot be read or parsed\n   274\t\t\t\t// leaves the answer unknown, never an absence. The roadmaps README\n   275\t\t\t\t// is no roadmap, as ListRoadmaps reads the namespace.\n   276\t\t\t\tif strings.EqualFold(filepath.Base(target), \"README.md\") {\n   277\t\t\t\t\tcontinue\n   278\t\t\t\t}\n   279\t\t\t\tif _, err := s.GetRoadmap(strings.TrimSuffix(filepath.Base(target), \".md\")); err != nil {\n   280\t\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which could not be read as a roadmap of this project\")\n   281\t\t\t\t\tcontinue\n   282\t\t\t\t}\n   283\t\t\t\tif target == roadmapPath {\n   284\t\t\t\t\tfound[name] = true\n   285\t\t\t\t}\n   286\t\t\t}\n   287\t\t}\n   288\t\tadrs := make([]string, 0, len(found))\n   289\t\tfor name := range found {\n   290\t\t\tadrs = append(adrs, name)\n   291\t\t}\n   292\t\tsort.Strings(adrs)\n   293\t\tsort.Strings(diagnostics)\n   294\t\treturn adrs, diagnostics\n   295\t}\n","exit_code":0,"status":"completed"}}
