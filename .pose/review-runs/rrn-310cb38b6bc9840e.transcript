{"type":"item.completed","item":{"id":"item_103","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '2156,2206p' pose-mcp/internal/cli/review_closeout.go\"","aggregated_output":"func nextCloses(store posemodel.Store, ref string) []string {\n\tscope, err := posemodel.ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn nil\n\t}\n\tnext := []string{}\n\tswitch scope.Kind {\n\tcase \"spec\":\n\t\treached, err := store.ReachedMilestones(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn []string{\"unavailable: \" + err.Error()}\n\t\t}\n\t\tfor _, milestone := range reached {\n\t\t\tnext = append(next, \"pose close \"+milestone)\n\t\t}\n\t\troadmaps, err := store.RoadmapsReachedBy(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn []string{\"unavailable: \" + err.Error()}\n\t\t}\n\t\tfor _, roadmap := range roadmaps {\n\t\t\tnext = append(next, \"pose close roadmap:\"+roadmap)\n\t\t}\n\tcase \"milestone\":\n\t\tif store.RoadmapReached(scope.Roadmap) {\n\t\t\tnext = append(next, \"pose close roadmap:\"+scope.Roadmap)\n\t\t}\n\t}\n\treturn next\n}\n\nfunc renderCloseNext(out *cliout.Renderer, next []string) {\n\tfor _, step := range next {\n\t\tout.Field(\"close.next\", step)\n\t}\n}\n\ntype continuousCloseoutSelection struct {\n\tSchemaVersion int    `json:\"schema_version\"`\n\tScope         string `json:\"scope\"`\n\tStartedAt     string `json:\"started_at\"`\n\tStatus        string `json:\"status\"`\n}\n\n// continuousStatusData is the payload of `continuous-closeout status`.\ntype continuousStatusData struct {\n\tActive   bool `json:\"active\"`\n\tTerminal bool `json:\"terminal\"`\n}\n\n// continuousCloseoutStatus reads the persisted selection and its closeout\n// state into one result for both renderers.\n","exit_code":0,"status":"completed"}}
