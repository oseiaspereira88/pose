{"type":"item.completed","item":{"id":"item_81","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '40,114p' pose-mcp/internal/pose/review_rounds.go\"","aggregated_output":"\treviewRoundPrefix = regexp.MustCompile(`^R[0-9]+-`)\n\treviewCarriedID   = regexp.MustCompile(`^R[0-9]{1,6}-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n\t// reviewDraftOpening is any fence line that names pose-draft.\n\treviewDraftOpening = regexp.MustCompile(\"^(`{3,}|~{3,})\\\\s*pose-draft\")\n)\n\n// ReviewDraftFinding is one finding a draft reports.\ntype ReviewDraftFinding struct {\n\tID          string `json:\"id\"`\n\tSeverity    string `json:\"severity\"`\n\tDisposition string `json:\"disposition\"`\n\tFile        string `json:\"file,omitempty\"`\n\tLine        int    `json:\"line,omitempty\"`\n\tSummary     string `json:\"summary\"`\n\t// Action, Owner and ReviewBy let a follow-up become an accepted risk in\n\t// the attestation the engine records (spec\n\t// pose-delegated-review-conclusions R1).\n\tAction   string `json:\"action,omitempty\"`\n\tOwner    string `json:\"owner,omitempty\"`\n\tReviewBy string `json:\"review_by,omitempty\"`\n}\n\n// ReviewDraftCriterion answers one criterion of the plan, as the reviewer of\n// a recorded attestation does (spec pose-delegated-review-conclusions R1).\ntype ReviewDraftCriterion struct {\n\tID          string `json:\"id\"`\n\tDisposition string `json:\"disposition\"`\n\tEvidence    string `json:\"evidence,omitempty\"`\n\tRationale   string `json:\"rationale,omitempty\"`\n\t// Mappings answer the structural facts the criterion is responsible for,\n\t// as `--criterion` mappings do; the writer's gate judges them (review\n\t// round 1, B4).\n\tMappings []ReviewCriterionMapping `json:\"mappings,omitempty\"`\n}\n\n// ReviewDraftTool is the disposition of one tool the plan requires.\ntype ReviewDraftTool struct {\n\tID          string `json:\"id\"`\n\tComponent   string `json:\"component,omitempty\"`\n\tDisposition string `json:\"disposition\"`\n\tEvidence    string `json:\"evidence,omitempty\"`\n\tRationale   string `json:\"rationale,omitempty\"`\n}\n\n// ReviewDraftPrior is a draft's account of one prior finding (R3, R4).\ntype ReviewDraftPrior struct {\n\tID       string `json:\"id\"`\n\tStatus   string `json:\"status\"`\n\tEvidence string `json:\"evidence\"`\n}\n\n// ReviewDraft is the pose-draft block of a reviewer's final message.\ntype ReviewDraft struct {\n\tSchema        string               `json:\"schema\"`\n\tDecision      string               `json:\"decision\"`\n\tFindings      []ReviewDraftFinding `json:\"findings\"`\n\tPriorFindings []ReviewDraftPrior   `json:\"prior_findings,omitempty\"`\n\tSweep         string               `json:\"sweep,omitempty\"`\n\t// Criteria and Tools are the typed conclusion the engine records as an\n\t// attestation (spec pose-delegated-review-conclusions R1).\n\tCriteria []ReviewDraftCriterion `json:\"criteria,omitempty\"`\n\tTools    []ReviewDraftTool      `json:\"tools,omitempty\"`\n\t// Questions and Surfaces are the typed verdict of an adjudication and of\n\t// a smoke run, recorded where their origin reads them (spec\n\t// pose-delegated-verdict-destinations R1, R2).\n\tQuestions []ReviewDraftQuestion `json:\"questions,omitempty\"`\n\tSurfaces  []ReviewDraftSurface  `json:\"surfaces,omitempty\"`\n\t// BusinessDecision is a question the reviewer cannot answer from the\n\t// code, for a person to decide (spec\n\t// pose-delegated-review-action-fulfillment R7).\n\tBusinessDecision *ReviewDraftBusinessDecision `json:\"business_decision,omitempty\"`\n}\n\n// ReviewDraftBusinessDecision is a business question and its options.\ntype ReviewDraftBusinessDecision struct {\n","exit_code":0,"status":"completed"}}
