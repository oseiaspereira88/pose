alog.go:809:\t\tdocs.Review[\"schema_version\"] = CloseoutReviewPolicySchemaVersion\npose-mcp/internal/pose/capability_catalog.go:810:\t\tchanges = append(changes, fmt.Sprintf(\"set schema_version=%d\", CloseoutReviewPolicySchemaVersion))\npose-mcp/internal/pose/capability_catalog.go:821:// CloseoutReviewPolicyEffective describes the rule a policy applies today: the\npose-mcp/internal/pose/capability_catalog.go:823:func CloseoutReviewPolicyEffective(docs PolicyDocs) (adopted bool, milestone, roadmap string) {\npose-mcp/internal/pose/capability_catalog.go:824:\tif !closeoutPairPresent(docs) {\npose-mcp/internal/pose/capability_catalog.go:832:func closeoutReviewPolicyCatalogEntry() CatalogEntry {\npose-mcp/internal/pose/capability_catalog.go:834:\t\tID: \"closeout-review-policy\", Summary: \"milestone and roadmap reviews by cost and benefit\", IntroducedIn: \"7.4.1\", DefaultForNew: true,\npose-mcp/internal/pose/capability_catalog.go:837:\t\t\tif closeoutPairPresent(docs) {\npose-mcp/internal/pose/capability_catalog.go:840:\t\t\tchanges, _ := SetCloseoutReviewPolicy(docs, CloseoutReviewNever, CloseoutReviewNever)\npose-mcp/internal/pose/capability_catalog.go:844:\t\tRetireRefusal: \"closeout-review-policy cannot be turned off: removing the pair would reinterpret closes already recorded under it; change the values with `pose adopt closeout-review-policy --milestone-review-required <v> --roadmap-review-required <v> --apply`\",\npose-mcp/internal/pose/capability_catalog.go:845:\t\tAdopted:       func(docs PolicyDocs) bool { return closeoutPairPresent(docs) },\n","exit_code":0,"status":"completed"}}
