{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_review_policy.go'","aggregated_output":"package pose\n\n// Closeout review policy by cost and benefit (spec\n// pose-closeout-review-policy-by-cost-benefit, ADR\n// closeout-review-policy-by-cost-and-benefit). An instance that adopts review\n// policy schema 5 decides, per aggregate scope kind, whether the close of a\n// milestone or a roadmap owes its own independent review. Closing stays\n// explicit in every mode; what changes is only the review of the aggregate.\n// One evaluator answers for every reader, so plan, verification, state,\n// doctor and close cannot disagree about the threshold.\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"sort\"\n\t\"strings\"\n)\n\nconst (\n\tCloseoutReviewNever         = \"never\"\n\tCloseoutReviewWhenJustified = \"when-justified\"\n\tCloseoutReviewAlways        = \"always\"\n\n\tCloseoutReviewEvaluatorVersion = \"closeout-review@1\"\n\n\tMilestoneReviewRequiredKey = \"milestone_review_required\"\n\tRoadmapReviewRequiredKey   = \"roadmap_review_required\"\n\n\t// The when-justified thresholds the maintainer chose: a milestone owes a\n\t// review with more than two distinct specs; a roadmap with more than one\n\t// distinct spec and at least one ADR association.\n\tcloseoutMilestoneMemberThreshold = 2\n\tcloseoutRoadmapMemberThreshold   = 1\n)\n\nfunc validCloseoutReviewValue(value string) bool {\n\tswitch value {\n\tcase CloseoutReviewNever, CloseoutReviewWhenJustified, CloseoutReviewAlways:\n\t\treturn true\n\t}\n\treturn false\n}\n\n// validateCloseoutReviewPolicyKeys refuses the pair outside schema 5, and\n// under schema 5 refuses a missing, null, mistyped, duplicated or unknown value\n// before anything plans or writes against it.\nfunc validateCloseoutReviewPolicyKeys(raw []byte, fields map[string]json.RawMessage, schema int) error {\n\t_, hasMilestone := fields[MilestoneReviewRequiredKey]\n\t_, hasRoadmap := fields[RoadmapReviewRequiredKey]\n\tif schema != CloseoutReviewPolicySchemaVersion {\n\t\tif hasMilestone || hasRoadmap {\n\t\t\treturn fmt.Errorf(\"pose: %s and %s require review policy schema %d\", MilestoneReviewRequiredKey, RoadmapReviewRequiredKey, CloseoutReviewPolicySchemaVersion)\n\t\t}\n\t\treturn nil\n\t}\n\tif err := rejectDuplicateJSONKeys(raw, false, true); err != nil {\n\t\treturn fmt.Errorf(\"pose: invalid schema-%d review policy: %w\", CloseoutReviewPolicySchemaVersion, err)\n\t}\n\tif !hasMilestone || !hasRoadmap {\n\t\treturn fmt.Errorf(\"pose: review policy schema %d requires both %s and %s\", CloseoutReviewPolicySchemaVersion, MilestoneReviewRequiredKey, RoadmapReviewRequiredKey)\n\t}\n\tfor _, key := range []string{MilestoneReviewRequiredKey, RoadmapReviewRequiredKey} {\n\t\tvar value string\n\t\tif string(fields[key]) == \"null\" || json.Unmarshal(fields[key], &value) != nil || !validCloseoutReviewValue(value) {\n\t\t\treturn fmt.Errorf(\"pose: %s must be one of never, when-justified, always (got %s)\", key, string(fields[key]))\n\t\t}\n\t}\n\treturn nil\n}\n\n// CloseoutReviewAdopted reports a policy that decides aggregate reviews by the\n// closeout pair. Every other policy keeps the legacy rule unchanged.\nfunc (p ReviewPolicy) CloseoutReviewAdopted() bool {\n\treturn p.SchemaVersion == CloseoutReviewPolicySchemaVersion\n}\n\n// CloseoutReviewSetting names the policy key and value that govern a scope kind.\nfunc (p ReviewPolicy) CloseoutReviewSetting(kind string) (string, string) {\n\tswitch kind {\n\tcase \"milestone\":\n\t\treturn MilestoneReviewRequiredKey, p.MilestoneReviewRequired\n\tcase \"roadmap\":\n\t\treturn RoadmapReviewRequiredKey, p.RoadmapReviewRequired\n\t}\n\treturn \"\", \"\"\n}\n\n// CloseoutReviewDecision is the evaluator's answer for one aggregate scope.\n// Projections render it; none of them recomputes a threshold.\ntype CloseoutReviewDecision struct {\n\tScope            string `json:\"scope\"`\n\tAdopted          bool   `json:\"adopted\"`\n\tEvaluatorVersion string `json:\"evaluator_version,omitempty\"`\n\tPolicyKey        string `json:\"policy_key,omitempty\"`\n\tPolicyValue      string `json:\"policy_value,omitempty\"`\n\t// Required is true when the scope owes its own independent review. An\n\t// unknown input never yields false.\n\tRequired bool `json:\"required\"`\n\t// Known is false when a member or an association could not be resolved:\n\t// the decision then requires the review and says what is missing.\n\tKnown       bool     `json:\"known\"`\n\tReason      string   `json:\"reason,omitempty\"`\n\tMembers     []string `json:\"members,omitempty\"`\n\tADRs        []string `json:\"adr_associations,omitempty\"`\n\tDiagnostics []string `json:\"diagnostics,omitempty\"`\n}\n\n// Review is the literal the closeout receipt records: required or not-required.\nfunc (d CloseoutReviewDecision) Review() string {\n\tif d.Required {\n\t\treturn \"required\"\n\t}\n\treturn \"not-required\"\n}\n\n// EvaluateCloseoutReview answers whether an aggregate scope owes its own\n// review under the adopted policy. A legacy policy returns Adopted=false and\n// the caller keeps the legacy rule.\nfunc (s Store) EvaluateCloseoutReview(ref string) (CloseoutReviewDecision, error) {\n\tpolicy, _, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn CloseoutReviewDecision{}, err\n\t}\n\treturn s.evaluateCloseoutReview(ref, policy)\n}\n\nfunc (s Store) evaluateCloseoutReview(ref string, policy ReviewPolicy) (CloseoutReviewDecision, error) {\n\tdecision := CloseoutReviewDecision{Scope: ref, Known: true}\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn decision, err\n\t}\n\tif !policy.CloseoutReviewAdopted() || (scope.Kind != \"milestone\" && scope.Kind != \"roadmap\") {\n\t\treturn decision, nil\n\t}\n\tdecision.Adopted = true\n\tdecision.EvaluatorVersion = CloseoutReviewEvaluatorVersion\n\tdecision.PolicyKey, decision.PolicyValue = policy.CloseoutReviewSetting(scope.Kind)\n\tslug := scope.Roadmap\n\tif scope.Kind == \"roadmap\" {\n\t\tslug = scope.Slug\n\t}\n\trm, err := s.GetRoadmap(slug)\n\tif err != nil {\n\t\treturn decision, err\n\t}\n\tproject, projectErr := s.WriteProjectID()\n\tvar raws []string\n\tif scope.Kind == \"milestone\" {\n\t\tfound := false\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tif milestone.ID == scope.Milestone {\n\t\t\t\traws, found = milestone.Specs, true\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\treturn decision, fmt.Errorf(\"pose: milestone %s not found in roadmap %s\", scope.Milestone, scope.Roadmap)\n\t\t}\n\t} else {\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\traws = append(raws, milestone.Specs...)\n\t\t}\n\t}\n\tif projectErr != nil {\n\t\tdecision.Diagnostics = append(decision.Diagnostics, \"the project identity that qualifies local members is unknown: \"+projectErr.Error())\n\t} else {\n\t\tdecision.Members, decision.Diagnostics = s.closeoutCanonicalMembers(raws, project)\n\t}\n\tif len(decision.Diagnostics) > 0 {\n\t\tdecision.Known = false\n\t}\n\tmembers := len(decision.Members)\n\tswitch decision.PolicyValue {\n\tcase CloseoutReviewNever:\n\t\tdecision.Required = false\n\t\tdecision.Reason = fmt.Sprintf(\"members=%d, never required\", members)\n\t\t// never decides without counting, but a member it cannot resolve is\n\t\t// still a scope it cannot close.\n\t\treturn decision, nil\n\tcase CloseoutReviewAlways:\n\t\tdecision.Required = true\n\t\tdecision.Reason = fmt.Sprintf(\"members=%d, always required\", members)\n\t\treturn decision, nil\n\t}\n\tif !decision.Known {\n\t\tdecision.Required = true\n\t\tdecision.Reason = \"members unknown; an exemption needs every member resolved\"\n\t\treturn decision, nil\n\t}\n\tif scope.Kind == \"milestone\" {\n\t\tdecision.Required = members > closeoutMilestoneMemberThreshold\n\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d\", members, closeoutMilestoneMemberThreshold)\n\t\treturn decision, nil\n\t}\n\t// The associations are resolved even below the member threshold: an\n\t// association input that cannot be read never proves an exemption.\n\tadrs, diagnostics := s.closeoutADRAssociations(rm, project)\n\tdecision.ADRs = adrs\n\tif len(diagnostics) > 0 {\n\t\tdecision.Diagnostics = append(decision.Diagnostics, diagnostics...)\n\t\tdecision.Known = false\n\t\tdecision.Required = true\n\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d, adr associations unknown\", members, closeoutRoadmapMemberThreshold)\n\t\treturn decision, nil\n\t}\n\tdecision.Required = members > closeoutRoadmapMemberThreshold && len(adrs) > 0\n\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d, adrs=%d\", members, closeoutRoadmapMemberThreshold, len(adrs))\n\treturn decision, nil\n}\n\n// closeoutCanonicalMembers resolves milestone members to their final\n// identities, xref:<project>/spec:<slug>, sorted and deduplicated. A local\n// member follows only a verified transfer redirect; an external one is\n// resolved by the federated resolver or stays unknown. Unknown members are\n// diagnostics, never a count of zero.\nfunc (s Store) closeoutCanonicalMembers(raws []string, project string) ([]string, []string) {\n\tseen := map[string]bool{}\n\tmembers, diagnostics := []string{}, []string{}\n\tfor _, raw := range raws {\n\t\tidentity, diagnostic := s.closeoutCanonicalMember(strings.TrimSpace(raw), project)\n\t\tif diagnostic != \"\" {\n\t\t\tdiagnostics = append(diagnostics, diagnostic)\n\t\t\tcontinue\n\t\t}\n\t\tif !seen[identity] {\n\t\t\tseen[identity] = true\n\t\t\tmembers = append(members, identity)\n\t\t}\n\t}\n\tsort.Strings(members)\n\treturn members, diagnostics\n}\n\nfunc (s Store) closeoutCanonicalMember(raw, project string) (string, string) {\n\tref, err := ParseArtifactRef(raw)\n\tif err != nil || ref.Kind != \"spec\" || ref.Milestone != \"\" {\n\t\treturn \"\", fmt.Sprintf(\"member %q is not a spec reference\", raw)\n\t}\n\tif ref.Project == \"\" {\n\t\tref.Project = project\n\t}\n\tresolve := func(why string) (string, string) {\n\t\tif s.FederatedResolver == nil {\n\t\t\treturn \"\", fmt.Sprintf(\"member %s %s and no federated resolver is bound to follow it\", ref.String(), why)\n\t\t}\n\t\tresolved := s.FederatedResolver.Resolve(project, ref.String())\n\t\tif !resolved.Resolved {\n\t\t\treturn \"\", fmt.Sprintf(\"member %s did not resolve: %s\", ref.String(), resolved.State)\n\t\t}\n\t\tif resolved.CanonicalIdentity != nil {\n\t\t\treturn resolved.CanonicalIdentity.String(), \"\"\n\t\t}\n\t\treturn resolved.Identity.String(), \"\"\n\t}\n\tif ref.Project != project {\n\t\treturn resolve(\"belongs to another project\")\n\t}\n\t_, found, err := readSpecTransferRedirect(s.fsys(), s, ref)\n\tif err != nil {\n\t\treturn \"\", fmt.Sprintf(\"member %s has an unverifiable redirect: %v\", ref.String(), err)\n\t}\n\tif found {\n\t\t// The resolver follows the whole chain, with its cycle and depth\n\t\t// limits and the destination's authorization: the immediate\n\t\t// destination may itself have moved.\n\t\treturn resolve(\"was transferred\")\n\t}\n\tif _, err := s.GetSpec(ref.Slug); err != nil {\n\t\treturn \"\", fmt.Sprintf(\"member %s names no spec of this project\", ref.String())\n\t}\n\treturn ref.String(), \"\"\n}\n\n// CloseoutMemberTarget resolves a milestone member to the spec whose closeout\n// stands for it, as the closeout review policy counts it: a local member a\n// verified transfer moved is followed to its canonical destination, which is\n// local (its slug) or external (its identity, judged by federated\n// acceptance). A redirect that cannot be followed is reported, never read as\n// the redirect stub the transfer left behind (review round 6, N24).\nfunc (s Store) CloseoutMemberTarget(raw string) (string, bool, string) {\n\tslug, external := s.milestoneMember(raw)\n\tif external {\n\t\treturn slug, true, \"\"\n\t}\n\t// The project the store is bound to, as milestoneMember reads a\n\t// qualified member, else the one the root declares.\n\tproject := s.FederatedProjectID\n\tif project == \"\" {\n\t\tid, err := s.WriteProjectID()\n\t\tif err != nil {\n\t\t\treturn \"\", false, \"member \" + raw + \" cannot be resolved: \" + err.Error()\n\t\t}\n\t\tproject = id\n\t}\n\t_, found, err := readSpecTransferRedirect(s.fsys(), s, ArtifactRef{Project: project, Kind: \"spec\", Slug: slug})\n\tif err != nil {\n\t\treturn \"\", false, \"member \" + raw + \" has an unverifiable redirect: \" + err.Error()\n\t}\n\tif !found {\n\t\treturn slug, false, \"\"\n\t}\n\tif s.FederatedResolver == nil || s.FederatedResolver.Roots == nil {\n\t\tresolver, _, err := EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n\t\tif err != nil {\n\t\t\treturn \"\", false, \"member \" + raw + \" was transferred and no resolver can follow it: \" + err.Error()\n\t\t}\n\t\ts.FederatedResolver = &resolver\n\t}\n\tcanonical, diagnostic := s.closeoutCanonicalMember(strings.TrimSpace(raw), project)\n\tif diagnostic != \"\" {\n\t\treturn \"\", false, diagnostic\n\t}\n\tref, err := ParseArtifactRef(canonical)\n\tif err != nil {\n\t\treturn \"\", false, \"member \" + raw + \" resolved to \" + canonical + \", which is not a spec reference\"\n\t}\n\tif ref.Project == \"\" || ref.Project == project {\n\t\treturn ref.Slug, false, \"\"\n\t}\n\treturn canonical, true, \"\"\n}\n\n// AggregateDependencyClosed reports whether a resolved dependency on a\n// milestone or roadmap is closed, beyond the status its members give it:\n// under the closeout review policy its owning project adopted, only the\n// terminal projection closes it (an explicit close with its receipt, or a\n// verified closure from before adoption). A spec, or an aggregate scope of a\n// project still on the legacy rule, keeps its status contract. A transferred\n// artifact is judged at its canonical destination; a project whose store or\n// policy cannot be read is not proven closed (review round 7, N27).\nfunc (s Store) AggregateDependencyClosed(resolver ArtifactResolver, localProject string, resolved ArtifactResolution) (bool, string) {\n\tidentity := resolved.Identity\n\tif resolved.CanonicalIdentity != nil {\n\t\tidentity = *resolved.CanonicalIdentity\n\t}\n\tif identity.Kind != \"milestone\" && identity.Kind != \"roadmap\" {\n\t\treturn true, \"\"\n\t}\n\tif identity.Project == \"\" {\n\t\tidentity.Project = localProject\n\t}\n\tscope := localFederatedScope(identity)\n\towner := s\n\tif identity.Project != localProject {\n\t\tif resolver.Roots == nil {\n\t\t\treturn false, scope + \" of \" + identity.Project + \" cannot be checked for its close: project roots are unavailable\"\n\t\t}\n\t\tsource, err := resolver.Roots.StoreFor(identity.Project)\n\t\tif err != nil {\n\t\t\treturn false, scope + \" of \" + identity.Project + \" cannot be checked for its close: \" + projectResolutionState(err)\n\t\t}\n\t\tsource = resolver.withSpecSnapshot(identity.Project, source)\n\t\tsource.closeoutChain = s.closeoutChain\n\t\towner = source\n\t}\n\tif owner.FederatedResolver == nil {\n\t\towner.FederatedProjectID, owner.FederatedResolver = identity.Project, &resolver\n\t}\n\tadopted, err := owner.closeoutReviewPolicyAdopted()\n\tif err != nil {\n\t\treturn false, scope + \" cannot be checked for its close: \" + err.Error()\n\t}\n\tif !adopted || owner.localScopeClosed(scope) {\n\t\treturn true, \"\"\n\t}\n\treturn false, scope + \" is reached but not closed: `pose close \" + scope + \"` publishes its closeout receipt\"\n}\n\n// canonicalMember is milestoneMember after transfer redirects: a local member\n// a transfer moved is its canonical destination, local or external. A\n// redirect that cannot be followed reads as external, so no local consumer\n// judges the redirect stub and federated proof fails closed on it (review\n// round 9, N33).\nfunc (s Store) canonicalMember(raw string) (string, bool) {\n\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n\tif unresolved != \"\" {\n\t\treturn raw, true\n\t}\n\treturn slug, external\n}\n\n// localScopeClosed reports a local milestone or roadmap a dependency edge\n// names as closed by the terminal projection, under an adopted closeout\n// review policy where status alone never closes it. A scope already asking\n// along the chain is a cycle and is not proven closed.\nfunc (s Store) localScopeClosed(scope string) bool {\n\tfor _, asking := range s.closeoutChain {\n\t\tif asking == scope {\n\t\t\treturn false\n\t\t}\n\t}\n\ts.closeoutChain = append(append([]string{}, s.closeoutChain...), scope)\n\tclosed, err := s.closedByReceipt(scope)\n\treturn err == nil && closed\n}\n\n// CurrentCloseoutDecision is the decision for an open aggregate scope now:\n// the evaluator, then every protection that can only make it stronger. It is\n// what close judges before publishing and again inside the protected region.\nfunc (s Store) CurrentCloseoutDecision(ref string) (CloseoutReviewDecision, error) {\n\tpolicy, _, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn CloseoutReviewDecision{}, err\n\t}\n\treturn s.currentCloseoutDecision(ref, policy)\n}\n\nfunc (s Store) currentCloseoutDecision(ref string, policy ReviewPolicy) (CloseoutReviewDecision, error) {\n\tdecision, err := s.evaluateCloseoutReview(ref, policy)\n\tif err != nil || !decision.Adopted || decision.Required {\n\t\treturn decision, err\n\t}\n\tscope, _ := ParseScopeRef(ref)\n\ts.protectCloseoutDecision(scope, &decision)\n\tif !decision.Required && s.mandatoryHumanReview(ref, scope.Kind, policy) {\n\t\tdecision.Required = true\n\t\tdecision.Reason += \"; a mandatory-human review is never dispensed\"\n\t}\n\treturn decision, nil\n}\n\n// mandatoryHumanReview reports a scope whose effective review plan asks for a\n// human reviewer: the base profile, the overlays the plan selects for it with\n// their cutoffs, and the protected baseline when the scope changes the review\n// contract, exactly as the plan composes them. No setting dispenses that\n// review. A plan that cannot be built is treated as asking for one, unless the\n// policy names no profile for the kind, where no review can be asked at all.\nfunc (s Store) mandatoryHumanReview(ref, kind string, policy ReviewPolicy) bool {\n\tif policy.ReviewerIndependence[kind] == \"mandatory-human\" {\n\t\treturn true\n\t}\n\tif policy.Profiles[kind] == \"\" {\n\t\t// No profile, no review to ask for, unless the scope itself removed\n\t\t// the profile: then the contract it changes cannot exempt it.\n\t\tscope, err := ParseScopeRef(ref)\n\t\treturn err != nil || len(s.resolveReviewGovernanceGuard(scope).Paths) > 0\n\t}\n\tplanner := s\n\tplanner.planWithoutCloseoutGate = true\n\tplan, err := planner.ReviewPlan(ref)\n\tif err != nil || plan.Independence == \"mandatory-human\" {\n\t\treturn true\n\t}\n\t// The plan composes the overlays' independence; the base profile's own is\n\t// read from the profile the plan named.\n\tbase, _, err := s.loadReviewProfile(plan.BaseProfile)\n\treturn err != nil || base.Independence == \"mandatory-human\"\n}\n\n// milestoneExitGateCriterionID names the criterion that carries a\n// milestone's exit gate into a member's review.\nfunc milestoneExitGateCriterionID(roadmap, milestone string) string {\n\treturn \"milestone-exit-gate-\" + roadmap + \"-\" + milestone\n}\n\nfunc milestoneExitGateCriterionDescription(roadmap, milestone, gate string) string {\n\treturn \"The exit gate of milestone:\" + roadmap + \"/\" + milestone + \" holds: \" + gate\n}\n\n// lastOpenMemberOf reports a spec that, under an adopted closeout review\n// policy, carries its multi-member milestone's exit gate into its own review:\n// it is a local member and every other member is terminal, so its review is\n// the last one of the milestone. A member of another project is never known\n// terminal here, so the gate is not carried and the milestone needs its own\n// review to judge it.\nfunc (s Store) lastOpenMemberOf(roadmap string, milestone Milestone, slug string) bool {\n\tif len(milestone.Specs) < 2 {\n\t\treturn false\n\t}\n\tmember := false\n\tfor _, raw := range milestone.Specs {\n\t\tother, external := s.canonicalMember(raw)\n\t\tif external {\n\t\t\treturn false\n\t\t}\n\t\tother = strings.TrimPrefix(other, \"spec:\")\n\t\tif other == slug {\n\t\t\tmember = true\n\t\t\tcontinue\n\t\t}\n\t\tsp, err := s.GetSpec(other)\n\t\tif err != nil || !terminalStatuses[sp.Status] {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn member\n}\n\n// exitGateJudgedByMember reports a multi-member milestone whose exit gate an\n// approved member review judged: the member's governing bundle carried the\n// gate's criterion with the gate as it reads now. A gate edited after that\n// review is judged by nobody yet.\nfunc (s Store) exitGateJudgedByMember(roadmap string, milestone Milestone, children []CloseoutState) bool {\n\tid := milestoneExitGateCriterionID(roadmap, milestone.ID)\n\tdescription := milestoneExitGateCriterionDescription(roadmap, milestone.ID, milestone.ExitGate)\n\tfor _, child := range children {\n\t\tif !child.Review.Approved || child.Review.BundleID == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tbundle, err := s.LoadReviewBundle(child.Review.BundleID)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, criterion := range bundle.Payload.Plan.Criteria {\n\t\t\tif criterion.ID == id && criterion.Description == description && criterion.Required {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t}\n\treturn false\n}\n\nfunc (s Store) milestoneExitGate(scope ScopeRef) string {\n\trm, err := s.GetRoadmap(scope.Roadmap)\n\tif err != nil {\n\t\treturn \"unknown\"\n\t}\n\tfor _, milestone := range rm.Milestones {\n\t\tif milestone.ID == scope.Milestone {\n\t\t\treturn strings.TrimSpace(milestone.ExitGate)\n\t\t}\n\t}\n\treturn \"unknown\"\n}\n\n// closeoutReviewGate is the one place the readers of an approval ask whether\n// an aggregate scope owes its own review under an adopted policy. It returns\n// the decision that governs the scope and whether its own review is dispensed.\n//\n// Order (spec pose-closeout-review-policy-by-cost-benefit, \"One evaluator and\n// precedence\"): a receipt already published decides by what it recorded, as\n// long as the scope it closed is still the scope; a roadmap closed before\n// adoption keeps its sealed contract (nil decision); an open scope is decided\n// now. A review recorded on the scope, required or not, is never bypassed: it\n// is verified as before and its veto stands. An unknown input never exempts.\nfunc (s Store) closeoutReviewGate(ref string, policy ReviewPolicy) (*CloseoutReviewDecision, bool, error) {\n\tif !policy.CloseoutReviewAdopted() {\n\t\treturn nil, false, nil\n\t}\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil || (scope.Kind != \"milestone\" && scope.Kind != \"roadmap\") {\n\t\treturn nil, false, err\n\t}\n\treceipt, err := s.ReadCloseoutReceipt(ref)\n\tif err != nil {\n\t\treturn nil, false, err\n\t}\n\tif receipt != nil {\n\t\tif err := s.closeoutReceiptStands(*receipt, policy); err != nil {\n\t\t\treturn nil, false, err\n\t\t}\n\t\tdecision := receipt.Decision\n\t\treturn &decision, !decision.Required && !s.scopeReviewRecorded(ref), nil\n\t}\n\tif s.closeoutScopeHistorical(scope) || s.milestoneClosedBeforeAdoption(scope) {\n\t\treturn nil, false, nil\n\t}\n\tdecision, err := s.currentCloseoutDecision(ref, policy)\n\tif err != nil {\n\t\treturn nil, false, err\n\t}\n\treturn &decision, !decision.Required && decision.Known && !s.scopeReviewRecorded(ref), nil\n}\n\n// closeoutReceiptStands checks a receipt against the scope it closed: the\n// same canonical members. A receipt is never re-decided under a later policy,\n// but it does not carry over to a scope whose composition changed.\nfunc (s Store) closeoutReceiptStands(receipt CloseoutReceipt, policy ReviewPolicy) error {\n\t// The closed contract, read without the current policy: a later policy\n\t// never re-decides a receipt, but a scope whose composition or exit gate\n\t// changed is no longer the scope it closed.\n\tmembers, gate, diagnostics, err := s.closeoutSubject(receipt.Scope)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"pose: closeout receipt of %s cannot be checked against its scope: %w\", receipt.Scope, err)\n\t}\n\tif len(diagnostics) > 0 {\n\t\treturn fmt.Errorf(\"pose: closeout receipt of %s cannot be checked against its scope: %s\", receipt.Scope, strings.Join(diagnostics, \"; \"))\n\t}\n\tdrift := func(what string) error {\n\t\treturn fmt.Errorf(\"pose: closeout receipt of %s no longer matches its scope: its %s changed since the close; a receipt is never rewritten, so restore it or record the change in a new scope\", receipt.Scope, what)\n\t}\n\tif strings.Join(members, \",\") != strings.Join(receipt.Decision.Members, \",\") {\n\t\treturn drift(fmt.Sprintf(\"members (closed with %v, now %v)\", receipt.Decision.Members, members))\n\t}\n\tif receipt.ExitGateDigest != gate {\n\t\treturn drift(\"exit gate\")\n\t}\n\treturn nil\n}\n\n// protectCloseoutDecision restores the review when the scope itself changes\n// the review contract: an exemption the diff introduced cannot exempt the diff.\n// The decision is made a second time under the policy at the change set's base\n// revision, and a stronger answer there wins. Protection that cannot be\n// established keeps the review required.\nfunc (s Store) protectCloseoutDecision(scope ScopeRef, decision *CloseoutReviewDecision) {\n\tguard := s.resolveReviewGovernanceGuard(scope)\n\tif len(guard.Paths) == 0 {\n\t\treturn\n\t}\n\trestore := func(reason string) {\n\t\tdecision.Required = true\n\t\tdecision.Reason += \"; \" + reason\n\t}\n\tif guard.Revision == \"\" {\n\t\trestore(\"the scope changes the review contract and no protected baseline resolves: \" + guard.Reason)\n\t\treturn\n\t}\n\tbase, err := s.parseReviewPolicyAt(guard.Revision)\n\tif err != nil {\n\t\trestore(\"the protected baseline policy cannot be read: \" + err.Error())\n\t\treturn\n\t}\n\tif !base.Enabled && !base.CloseoutReviewAdopted() {\n\t\treturn\n\t}\n\tif base.ReviewerIndependence[scope.Kind] == \"mandatory-human\" {\n\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires a mandatory-human review\")\n\t\treturn\n\t}\n\t// The baseline's base profile and every overlay it adopted for this kind,\n\t// selected or not: protection is the conservative reading.\n\trefs := append([]string{}, base.OverlayProfiles...)\n\tif ref := base.Profiles[scope.Kind]; ref != \"\" {\n\t\trefs = append(refs, ref)\n\t}\n\tfor _, ref := range refs {\n\t\tprofile, err := s.parseReviewProfileAt(guard.Revision, ref)\n\t\tif err != nil || (profile.Scope == scope.Kind || ref == base.Profiles[scope.Kind]) && profile.Independence == \"mandatory-human\" {\n\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires a mandatory-human review or a profile of it cannot be read\")\n\t\t\treturn\n\t\t}\n\t}\n\tif !base.CloseoutReviewAdopted() {\n\t\trestore(\"the protected baseline at \" + guard.Revision + \" keeps the legacy rule, under which this scope owes its review\")\n\t\treturn\n\t}\n\tprotected, err := s.evaluateCloseoutReview(decision.Scope, base)\n\tif err != nil || protected.Required {\n\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires the review (\" + protected.PolicyKey + \"=\" + protected.PolicyValue + \")\")\n\t}\n}\n\n// closeoutSubject is what a closeout receipt binds: the canonical members of\n// the scope and, for a milestone, the digest of its exit gate (a roadmap's is\n// the gates of its milestones, which their own receipts bind).\nfunc (s Store) closeoutSubject(ref string) ([]string, string, []string, error) {\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn nil, \"\", nil, err\n\t}\n\tslug := scope.Roadmap\n\tif scope.Kind == \"roadmap\" {\n\t\tslug = scope.Slug\n\t}\n\trm, err := s.GetRoadmap(slug)\n\tif err != nil {\n\t\treturn nil, \"\", nil, err\n\t}\n\tproject, err := s.WriteProjectID()\n\tif err != nil {\n\t\treturn nil, \"\", []string{\"the project identity is unknown: \" + err.Error()}, nil\n\t}\n\tvar raws []string\n\tgate := \"\"\n\tfor _, milestone := range rm.Milestones {\n\t\tif scope.Kind == \"milestone\" && milestone.ID != scope.Milestone {\n\t\t\tcontinue\n\t\t}\n\t\traws = append(raws, milestone.Specs...)\n\t\tif scope.Kind == \"milestone\" {\n\t\t\tgate = digestText(milestone.ExitGate)\n\t\t}\n\t}\n\tif scope.Kind == \"roadmap\" {\n\t\t// A roadmap's gate is its cut criteria; its milestones' gates are\n\t\t// bound by their own receipts.\n\t\tcriteria, problems := ParseRoadmapCriteria(*rm)\n\t\traw, _ := json.Marshal(struct {\n\t\t\tCriteria []RoadmapCriterion\n\t\t\tProblems []string\n\t\t}{criteria, problems})\n\t\tgate = \"sha256:\" + digestHex(raw)\n\t}\n\tmembers, diagnostics := s.closeoutCanonicalMembers(raws, project)\n\treturn members, gate, diagnostics, nil\n}\n\n// closeoutScopeHistorical reports a scope whose roadmap was closed before\n// adoption: done, with no receipt and no close of this engine in progress,\n// and with positive evidence of its legacy closure: an approval recorded on\n// the roadmap, or the legacy rule exempting it as done before review\n// adoption. Status alone proves nothing.\n// Its milestones and itself are verified by the contract they were sealed\n// under, never re-evaluated, and no receipt is backfilled for them. A close\n// interrupted between its status and its receipt left an intent, so it stays\n// incomplete instead of reading as history.\nfunc (s Store) closeoutScopeHistorical(scope ScopeRef) bool {\n\tslug := scope.Slug\n\tif scope.Kind == \"milestone\" {\n\t\tslug = scope.Roadmap\n\t}\n\trm, err := s.GetRoadmap(slug)\n\tif err != nil || rm.Status != \"done\" {\n\t\treturn false\n\t}\n\tref := \"roadmap:\" + slug\n\tif receipt, err := s.ReadCloseoutReceipt(ref); err != nil || receipt != nil {\n\t\treturn false\n\t}\n\tpending, err := s.closeoutIntentPending(ref)\n\tif err != nil || pending {\n\t\treturn false\n\t}\n\tpolicy, _, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn false\n\t}\n\tif required, err := s.reviewRequiredForScope(ScopeRef{Kind: \"roadmap\", Slug: slug}, policy); err == nil && !required {\n\t\treturn true\n\t}\n\trecorded, refused, err := s.milestonesWithRecordedApproval([]string{ref})\n\treturn err == nil && recorded[ref] && !refused[ref]\n}\n\n// milestoneClosedBeforeAdoption reports a milestone with positive terminal\n// evidence from before adoption: its own approved review, sealed under a\n// policy that had not adopted the closeout pair. A milestone merely reached\n// has no such record and owes its close.\nfunc (s Store) milestoneClosedBeforeAdoption(scope ScopeRef) bool {\n\tif scope.Kind != \"milestone\" {\n\t\treturn false\n\t}\n\tref := scope.String()\n\trecorded, refused, err := s.milestonesWithRecordedApproval([]string{ref})\n\tif err != nil || !recorded[ref] || refused[ref] {\n\t\treturn false\n\t}\n\tlatest, err := s.latestBundlesOf([]string{ref})\n\tif err != nil || len(latest[ref]) == 0 {\n\t\treturn false\n\t}\n\tfor _, id := range latest[ref] {\n\t\tbundle, err := s.LoadReviewBundle(id)\n\t\tif err != nil || bundle.Payload.Plan.CloseoutReview != nil {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// closedByReceipt reports an aggregate scope that reads closed: a receipt\n// that still stands for the scope as it is, or, with no receipt, a verified\n// closure from before adoption (a historical roadmap's scopes, or a milestone\n// approved under a plan without a closeout decision), never backfilled with a\n// receipt. Either way the scope must pass the whole terminal verifier closeout\n// applies: its review, a refusal recorded later, its children, its gates, and\n// the acceptance of its dependency edges (predecessors, consumed outcomes,\n// members), local and remote. It is the one terminal projection reached,\n// roadmap-reached, attention and doctor ask.\nfunc (s Store) closedByReceipt(ref string) (bool, error) {\n\tif len(s.closeoutChain) == 0 || s.closeoutChain[len(s.closeoutChain)-1] != ref {\n\t\ts.closeoutChain = append(append([]string{}, s.closeoutChain...), ref)\n\t}\n\treceipt, err := s.ReadCloseoutReceipt(ref)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif receipt != nil {\n\t\tpolicy, _, err := s.loadReviewPolicy()\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tif s.closeoutReceiptStands(*receipt, policy) != nil {\n\t\t\treturn false, nil\n\t\t}\n\t} else {\n\t\tscope, err := ParseScopeRef(ref)\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tif !s.closeoutScopeHistorical(scope) && !s.milestoneClosedBeforeAdoption(scope) {\n\t\t\treturn false, nil\n\t\t}\n\t}\n\treturn s.closeoutTerminalWithDependencies(ref), nil\n}\n\n// closeoutTerminalWithDependencies runs the terminal verifier with dependency\n// acceptance, through the store's bound resolver or, without one, the\n// resolver the environment binds to this root, as `pose close` does. A\n// resolver that cannot be built leaves the edges unjudged, so the scope does\n// not read closed. Same-project edges are judged by their lifecycle and\n// revision, without recursion into their closeout, and remote recursion stops\n// at a cycle, so the projection converges.\nfunc (s Store) closeoutTerminalWithDependencies(ref string) bool {\n\tif s.FederatedResolver == nil || s.FederatedResolver.Roots == nil {\n\t\tresolver, project, err := EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n\t\tif err != nil {\n\t\t\treturn false\n\t\t}\n\t\ts.FederatedProjectID, s.FederatedResolver = project, &resolver\n\t}\n\tstate, err := s.getCloseoutState(ref, true)\n\treturn err == nil && state.Terminal\n}\n\n// receiptStandsFor reports a closeout receipt on file that still stands for\n// the scope as it is. It reads no terminal state, so the review verification\n// can ask it without recursing into closeout.\nfunc (s Store) receiptStandsFor(ref string) bool {\n\treceipt, err := s.ReadCloseoutReceipt(ref)\n\tif err != nil || receipt == nil {\n\t\treturn false\n\t}\n\tpolicy, _, err := s.loadReviewPolicy()\n\treturn err == nil && s.closeoutReceiptStands(*receipt, policy) == nil\n}\n\n// scopeReviewRecorded reports a review of the scope on file: a bundle or a\n// legacy attempt. A record that cannot be read counts as recorded, so an\n// unreadable rejection never turns into an exemption.\nfunc (s Store) scopeReviewRecorded(ref string) bool {\n\tbundles, err := s.ReadReviewBundles(ref)\n\tif err != nil || len(bundles.Bundles) > 0 || !bundles.Coverage.CompleteFor(ref) {\n\t\treturn true\n\t}\n\tattempts, err := s.ReadReviewAttempts(ref)\n\treturn err != nil || len(attempts.Attempts) > 0 || !attempts.Coverage.CompleteFor(ref)\n}\n\n// closeoutApprovalOrigin is the origin an exempt scope's approval reports.\nfunc closeoutApprovalOrigin(decision CloseoutReviewDecision) string {\n\treturn \"not-required:\" + decision.PolicyKey + \"=\" + decision.PolicyValue\n}\n\nfunc closeoutExemptionWarning(ref string, decision CloseoutReviewDecision) string {\n\treturn \"review: not-required for \" + ref + \" (\" + decision.PolicyKey + \"=\" + decision.PolicyValue + \", \" + decision.Reason + \"); `pose close \" + ref + \"` is still required\"\n}\n\n// CloseoutReviewOwing is an open aggregate scope that owes its own review under\n// the adopted policy and holds no recorded approval yet, for `pose doctor`.\ntype CloseoutReviewOwing struct {\n\tScope    string                 `json:\"scope\"`\n\tDecision CloseoutReviewDecision `json:\"decision\"`\n\t// Previous is the rule that applied before, when a recorded input shows\n\t// it; with no snapshot it says the comparison is unknown.\n\tPrevious string `json:\"previous\"`\n\tAction   string `json:\"action\"`\n}\n\n// CloseoutReviewsOwed lists the open milestones and roadmaps that, under the\n// adopted closeout review policy, owe a review they do not have. A legacy\n// policy returns nothing. Close remains the authoritative gate.\nfunc (s Store) CloseoutReviewsOwed() ([]CloseoutReviewOwing, error) {\n\tpolicy, _, err := s.loadReviewPolicy()\n\tif err != nil || !policy.CloseoutReviewAdopted() {\n\t\treturn nil, err\n\t}\n\troadmaps, err := s.ListRoadmaps()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\trefs := []string{}\n\tfor _, rm := range roadmaps {\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\trefs = append(refs, \"milestone:\"+rm.Slug+\"/\"+milestone.ID)\n\t\t}\n\t\trefs = append(refs, \"roadmap:\"+rm.Slug)\n\t}\n\towing := []CloseoutReviewOwing{}\n\tfor _, ref := range refs {\n\t\tclosed, err := s.closedByReceipt(ref)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif closed {\n\t\t\tcontinue\n\t\t}\n\t\t// A scope closed before adoption is never re-decided under the\n\t\t// current policy, but its terminal evidence must still stand: one\n\t\t// that no longer verifies is listed with the check that says why\n\t\t// (review round 6, N23).\n\t\tif scope, err := ParseScopeRef(ref); err == nil && (s.closeoutScopeHistorical(scope) || s.milestoneClosedBeforeAdoption(scope)) {\n\t\t\towing = append(owing, CloseoutReviewOwing{\n\t\t\t\tScope:    ref,\n\t\t\t\tDecision: CloseoutReviewDecision{Scope: ref, Adopted: true, Known: true, Required: true, Reason: \"closed before adoption; its sealed closure no longer verifies\"},\n\t\t\t\tPrevious: \"closed before adoption under the legacy rule\",\n\t\t\t\tAction:   \"run `pose closeout-check \" + ref + \"` and remediate the review or child it names; the closure is verified by the contract it was sealed under\",\n\t\t\t})\n\t\t\tcontinue\n\t\t}\n\t\t// The applicable gate, not the current threshold alone: a receipt\n\t\t// keeps the decision it closed under, and a review recorded on the\n\t\t// scope anyway stands until it approves (review round 7, N26).\n\t\tgated, exempt, err := s.closeoutReviewGate(ref, policy)\n\t\tif err != nil {\n\t\t\towing = append(owing, CloseoutReviewOwing{Scope: ref, Decision: CloseoutReviewDecision{Scope: ref, Adopted: true, Required: true, Reason: err.Error()}, Previous: \"unknown: no snapshot of the earlier policy or composition is recorded\", Action: \"resolve \" + err.Error()})\n\t\t\tcontinue\n\t\t}\n\t\tif exempt || gated == nil {\n\t\t\tcontinue\n\t\t}\n\t\tdecision := *gated\n\t\t// A recorded approval counts only while it satisfies the current\n\t\t// obligation: fresh, for the scope as it is now.\n\t\tif eval, err := s.ReviewCheck(ref); err == nil && eval.Approved && eval.Fresh {\n\t\t\tcontinue\n\t\t}\n\t\taction := \"seal and review \" + ref + \" (`pose review bundle \" + ref + \" --seal`), then `pose close \" + ref + \"`\"\n\t\tif !decision.Known {\n\t\t\taction = \"resolve \" + strings.Join(decision.Diagnostics, \"; \")\n\t\t}\n\t\towing = append(owing, CloseoutReviewOwing{Scope: ref, Decision: decision, Previous: \"unknown: no snapshot of the earlier policy or composition is recorded\", Action: action})\n\t}\n\treturn owing, nil\n}\n\nfunc mustScope(ref string) ScopeRef {\n\tscope, _ := ParseScopeRef(ref)\n\treturn scope\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_adr_associations.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_adr_associations.go'","aggregated_output":"package pose\n\n// ADR associations of a roadmap, for the when-justified roadmap rule of the\n// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n//\n// An association is explicit, never inferred from prose:\n//   - forward: the roadmap's `adrs: [adr:<file>.md]` frontmatter, or a local\n//     Markdown link from its body to a file in .pose/adr/;\n//   - backward: an ADR's `roadmaps: [roadmap:<slug>]` (or the qualified\n//     `xref:<project>/roadmap:<slug>`) frontmatter, or a local Markdown link\n//     from the ADR to .pose/roadmaps/<slug>.md.\n//\n// Only the owning project's .pose/adr/ is inventoried; nothing searches other\n// projects. A malformed declaration, a link to a missing file or an\n// incomplete inventory is unknown, which can never prove absence.\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n)\n\nconst (\n\tcloseoutADRInventoryLimit = 4096\n\tcloseoutADRSizeLimit      = 1 << 20\n)\n\nvar (\n\t// [text](dest \"title\") and [text](<dest>) inline links.\n\tmarkdownInlineLinkRE = regexp.MustCompile(`\\]\\(\\s*(<[^>\\n]*>|[^)\\s]+)(?:\\s+(?:\"[^\"]*\"|'[^']*'|\\([^)]*\\)))?\\s*\\)`)\n\t// [label]: dest \"title\" reference definitions.\n\tmarkdownReferenceLinkRE = regexp.MustCompile(`(?m)^\\s{0,3}\\[[^\\]\\n]+\\]:\\s*(<[^>\\n]*>|\\S+)`)\n)\n\nfunc (s Store) adrDir() string { return filepath.Join(s.Root, \".pose\", \"adr\") }\n\n// markdownLinkDestinations lists the link destinations of a Markdown body,\n// angle brackets and fragments removed. External URLs are kept out.\nfunc markdownLinkDestinations(body string) []string {\n\t// Fenced code, inline code and comments document links; they do not make\n\t// them (review round 12, N40).\n\tbody = markdownWithoutCode(body)\n\tout := []string{}\n\tadd := func(dest string) {\n\t\tdest = strings.TrimSpace(dest)\n\t\tdest = strings.TrimSuffix(strings.TrimPrefix(dest, \"<\"), \">\")\n\t\tif i := strings.IndexAny(dest, \"#?\"); i >= 0 {\n\t\t\tdest = dest[:i]\n\t\t}\n\t\tif dest == \"\" || strings.Contains(dest, \"://\") || strings.HasPrefix(dest, \"mailto:\") || strings.HasPrefix(dest, \"/\") {\n\t\t\treturn\n\t\t}\n\t\tout = append(out, dest)\n\t}\n\tfor _, m := range markdownInlineLinkRE.FindAllStringSubmatch(body, -1) {\n\t\tadd(m[1])\n\t}\n\tfor _, m := range markdownReferenceLinkRE.FindAllStringSubmatch(body, -1) {\n\t\tadd(m[1])\n\t}\n\treturn out\n}\n\nvar (\n\tmarkdownCommentRE    = regexp.MustCompile(`(?s)<!--.*?-->`)\n\tmarkdownInlineCodeRE = regexp.MustCompile(\"`+[^`\\n]*`+\")\n)\n\n// markdownWithoutCode blanks fenced code blocks, inline code spans and HTML\n// comments, so the links they show are not read as links.\nfunc markdownWithoutCode(body string) string {\n\tbody = markdownCommentRE.ReplaceAllString(body, \"\")\n\tvar out strings.Builder\n\tfence := \"\"\n\tfor _, line := range strings.SplitAfter(body, \"\\n\") {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif fence != \"\" {\n\t\t\tif strings.HasPrefix(trimmed, fence) {\n\t\t\t\tfence = \"\"\n\t\t\t}\n\t\t\tout.WriteString(\"\\n\")\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(trimmed, \"```\") || strings.HasPrefix(trimmed, \"~~~\") {\n\t\t\tfence = trimmed[:3]\n\t\t\tout.WriteString(\"\\n\")\n\t\t\tcontinue\n\t\t}\n\t\tout.WriteString(markdownInlineCodeRE.ReplaceAllString(line, \"\"))\n\t}\n\treturn out.String()\n}\n\n// associationList reads one association key (adrs: on a roadmap, roadmaps: on\n// an ADR) from the raw frontmatter of a governance file, strictly: a key\n// declared more than once, declared with no value, outside a [list], or with\n// an empty item is reported, never read as an absent or empty association. An\n// explicit [] declares none (review round 12, N39).\nfunc associationList(raw, key, owner string) ([]string, bool, string) {\n\tlines := strings.Split(strings.ReplaceAll(raw, \"\\r\\n\", \"\\n\"), \"\\n\")\n\tif len(lines) == 0 || strings.TrimSpace(lines[0]) != \"---\" {\n\t\treturn nil, false, \"\"\n\t}\n\tvalues := []string{}\n\tfor _, line := range lines[1:] {\n\t\tif strings.TrimSpace(line) == \"---\" {\n\t\t\tbreak\n\t\t}\n\t\tif value, ok := strings.CutPrefix(line, key+\":\"); ok {\n\t\t\tvalues = append(values, strings.TrimSpace(value))\n\t\t}\n\t}\n\tswitch {\n\tcase len(values) == 0:\n\t\treturn nil, false, \"\"\n\tcase len(values) > 1:\n\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: %d times; one declaration is required\", owner, key, len(values))\n\t}\n\tvalue := values[0]\n\tif value == \"\" {\n\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with no value; declare [] for none\", owner, key)\n\t}\n\tif !strings.HasPrefix(value, \"[\") || !strings.HasSuffix(value, \"]\") {\n\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: outside a [list]\", owner, key)\n\t}\n\tinner := strings.TrimSpace(value[1 : len(value)-1])\n\tif inner == \"\" {\n\t\treturn []string{}, true, \"\"\n\t}\n\titems := []string{}\n\tfor _, item := range strings.Split(inner, \",\") {\n\t\titem = strings.TrimSpace(item)\n\t\tif item == \"\" {\n\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with an empty item\", owner, key)\n\t\t}\n\t\titems = append(items, item)\n\t}\n\treturn items, true, \"\"\n}\n\n// validADRBasename accepts exactly a file name ending in .md directly inside\n// .pose/adr/: no directory, traversal, hidden file or URI.\nfunc validADRBasename(name string) bool {\n\treturn name != \"\" && filepath.Base(name) == name && !strings.ContainsAny(name, `/\\:`) &&\n\t\t!strings.HasPrefix(name, \".\") && strings.HasSuffix(name, \".md\") && name != \".md\"\n}\n\n// regularADR reports a regular, non-symlinked file of .pose/adr/ within the root.\nfunc (s Store) regularADR(name string) error {\n\tpath := filepath.Join(s.adrDir(), name)\n\tinfo, err := s.fsys().Lstat(path)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\treturn fmt.Errorf(\"not a regular file inside .pose/adr\")\n\t}\n\treturn nil\n}\n\n// closeoutADRAssociations returns the sorted ADR basenames associated with a\n// roadmap, and the diagnostics that make the answer unknown.\nfunc (s Store) closeoutADRAssociations(rm *Roadmap, project string) ([]string, []string) {\n\tfound := map[string]bool{}\n\tdiagnostics := []string{}\n\trawRoadmap, readErr := s.fsys().ReadFile(rm.Path)\n\tif readErr != nil {\n\t\tdiagnostics = append(diagnostics, \"roadmap \"+rm.Slug+\" could not be read for its adrs: \"+readErr.Error())\n\t}\n\tdeclared, _, declarationProblem := associationList(string(rawRoadmap), \"adrs\", \"roadmap \"+rm.Slug)\n\tif declarationProblem != \"\" {\n\t\tdiagnostics = append(diagnostics, declarationProblem)\n\t}\n\tfor _, item := range declared {\n\t\tname, ok := strings.CutPrefix(item, \"adr:\")\n\t\tif !ok || !validADRBasename(name) {\n\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares %q, not adr:<file>.md\", rm.Slug, item))\n\t\t\tcontinue\n\t\t}\n\t\tif err := s.regularADR(name); err != nil {\n\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares adr:%s, which cannot be read: %v\", rm.Slug, name, err))\n\t\t\tcontinue\n\t\t}\n\t\tfound[name] = true\n\t}\n\tbody := rm.Body\n\tif body == \"\" {\n\t\tif full, err := s.GetRoadmap(rm.Slug); err == nil {\n\t\t\tbody = full.Body\n\t\t}\n\t}\n\troadmapDir := filepath.Dir(rm.Path)\n\tfor _, dest := range markdownLinkDestinations(body) {\n\t\ttarget := filepath.Clean(filepath.Join(roadmapDir, filepath.FromSlash(dest)))\n\t\tif filepath.Dir(target) != filepath.Clean(s.adrDir()) || !strings.HasSuffix(target, \".md\") {\n\t\t\tcontinue\n\t\t}\n\t\tname := filepath.Base(target)\n\t\tif err := s.regularADR(name); err != nil {\n\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, which cannot be read: %v\", rm.Slug, dest, err))\n\t\t\tcontinue\n\t\t}\n\t\tfound[name] = true\n\t}\n\tentries, err := s.fsys().ReadDir(s.adrDir())\n\tif err != nil && !os.IsNotExist(err) {\n\t\tdiagnostics = append(diagnostics, \"the ADR inventory could not be read: \"+err.Error())\n\t}\n\tif len(entries) > closeoutADRInventoryLimit {\n\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"the ADR inventory has %d entries, above the limit of %d\", len(entries), closeoutADRInventoryLimit))\n\t\tentries = nil\n\t}\n\troadmapPath := filepath.Clean(filepath.Join(s.roadmapsDir(), rm.Slug+\".md\"))\n\tfor _, entry := range entries {\n\t\tname := entry.Name()\n\t\t// Every candidate is read, the associated ones included: its size,\n\t\t// its readability and its own declaration are inputs. One that\n\t\t// cannot be read could hold a backlink, so it is unknown.\n\t\tif entry.IsDir() || !strings.HasSuffix(name, \".md\") {\n\t\t\tcontinue\n\t\t}\n\t\tif err := s.regularADR(name); err != nil {\n\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is not a regular file of .pose/adr: \"+err.Error())\n\t\t\tcontinue\n\t\t}\n\t\tpath := filepath.Join(s.adrDir(), name)\n\t\tif info, err := s.fsys().Lstat(path); err != nil || info.Size() > closeoutADRSizeLimit {\n\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is unreadable or above the size limit\")\n\t\t\tcontinue\n\t\t}\n\t\traw, err := s.fsys().ReadFile(path)\n\t\tif err != nil {\n\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" could not be read: \"+err.Error())\n\t\t\tcontinue\n\t\t}\n\t\t_, adrBody := SplitFrontmatter(string(raw))\n\t\tbackward, _, backwardProblem := associationList(string(raw), \"roadmaps\", \"ADR \"+name)\n\t\tif backwardProblem != \"\" {\n\t\t\tdiagnostics = append(diagnostics, backwardProblem)\n\t\t}\n\t\tfor _, item := range backward {\n\t\t\tref, err := ParseArtifactRef(item)\n\t\t\tif err != nil || ref.Kind != \"roadmap\" || ref.Milestone != \"\" {\n\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %q, not roadmap:<slug>\", name, item))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif ref.Project != \"\" && ref.Project != project {\n\t\t\t\tcontinue // a roadmap of another project: not this association\n\t\t\t}\n\t\t\tif _, err := s.GetRoadmap(ref.Slug); err != nil {\n\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %s, which names no roadmap of this project\", name, item))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif ref.Slug == rm.Slug {\n\t\t\t\tfound[name] = true\n\t\t\t}\n\t\t}\n\t\tfor _, dest := range markdownLinkDestinations(adrBody) {\n\t\t\ttarget := filepath.Clean(filepath.Join(s.adrDir(), filepath.FromSlash(dest)))\n\t\t\tif filepath.Dir(target) != filepath.Clean(s.roadmapsDir()) || !strings.HasSuffix(target, \".md\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// A link into the roadmaps namespace is an association input: one\n\t\t\t// that does not resolve to a roadmap leaves the answer unknown.\n\t\t\tif info, err := s.fsys().Lstat(target); err != nil || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, target) {\n\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which is not a roadmap of this project\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// The target is read as the roadmap it names, as a roadmaps:\n\t\t\t// declaration is: a regular entry that cannot be read or parsed\n\t\t\t// leaves the answer unknown, never an absence. The roadmaps README\n\t\t\t// is no roadmap, as ListRoadmaps reads the namespace.\n\t\t\tif strings.EqualFold(filepath.Base(target), \"README.md\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, err := s.GetRoadmap(strings.TrimSuffix(filepath.Base(target), \".md\")); err != nil {\n\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which could not be read as a roadmap of this project\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif target == roadmapPath {\n\t\t\t\tfound[name] = true\n\t\t\t}\n\t\t}\n\t}\n\tadrs := make([]string, 0, len(found))\n\tfor name := range found {\n\t\tadrs = append(adrs, name)\n\t}\n\tsort.Strings(adrs)\n\tsort.Strings(diagnostics)\n\treturn adrs, diagnostics\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"agent_message","text":"The spec requires one shared gate, explicit closeout receipts, and fail-closed handling of unresolved members and ADR associations. I’m tracing those paths through review verification, closeout state, and dependency projections. The artifact and surface checks are still running."}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_receipt.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_receipt.go'","aggregated_output":"package pose\n\n// Closeout receipts (spec pose-closeout-review-policy-by-cost-benefit R4, R7).\n// Under an adopted closeout review policy, the explicit `pose close` of a\n// milestone or a roadmap publishes a receipt: the terminal marker of that\n// close, with the evaluator's decision and the policy it was made under. A\n// receipt is written once and never reinterpreted: a later policy change does\n// not re-evaluate it, and a different or corrupt receipt is never overwritten.\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n)\n\nconst CloseoutReceiptSchemaVersion = 1\n\ntype CloseoutReceipt struct {\n\tSchemaVersion int    `json:\"schema_version\"`\n\tScope         string `json:\"scope\"`\n\tClosedAt      string `json:\"closed_at\"`\n\t// Review is the literal `required` or `not-required`.\n\tReview        string                 `json:\"review\"`\n\tDecision      CloseoutReviewDecision `json:\"decision\"`\n\tPolicyDigest  string                 `json:\"policy_digest\"`\n\tSubjectDigest string                 `json:\"subject_digest\"`\n\t// ExitGateDigest binds a milestone's exit gate as it was closed.\n\tExitGateDigest string `json:\"exit_gate_digest,omitempty\"`\n\t// ReviewBundle and ReviewAttestation name the verified review the close\n\t// stood on: required, or made by choice when not required.\n\tReviewBundle      string `json:\"review_bundle,omitempty\"`\n\tReviewAttestation string `json:\"review_attestation,omitempty\"`\n\tApprovalOrigin    string `json:\"approval_origin,omitempty\"`\n}\n\n// CloseoutReceiptPath is where the receipt of an aggregate scope lives.\nfunc (s Store) CloseoutReceiptPath(ref string) (string, error) {\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tbase := filepath.Join(s.Root, \".pose\", \"review-closeouts\")\n\tswitch scope.Kind {\n\tcase \"milestone\":\n\t\tif ValidateSlug(scope.Roadmap) != nil || !filepath.IsLocal(scope.Milestone) || filepath.Base(scope.Milestone) != scope.Milestone {\n\t\t\treturn \"\", fmt.Errorf(\"pose: invalid milestone scope %s\", ref)\n\t\t}\n\t\treturn filepath.Join(base, \"milestone\", scope.Roadmap, scope.Milestone+\".json\"), nil\n\tcase \"roadmap\":\n\t\tif ValidateSlug(scope.Slug) != nil {\n\t\t\treturn \"\", fmt.Errorf(\"pose: invalid roadmap scope %s\", ref)\n\t\t}\n\t\treturn filepath.Join(base, \"roadmap\", scope.Slug+\".json\"), nil\n\t}\n\treturn \"\", fmt.Errorf(\"pose: %s has no closeout receipt; only milestones and roadmaps do\", ref)\n}\n\n// ReadCloseoutReceipt returns the receipt of a scope, nil when there is none.\n// A receipt that cannot be read or does not validate is an error, never an\n// absence: it would otherwise reopen a closed scope or hide a corruption.\nfunc (s Store) ReadCloseoutReceipt(ref string) (*CloseoutReceipt, error) {\n\tpath, err := s.CloseoutReceiptPath(ref)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tinfo, err := s.fsys().Lstat(path)\n\tif os.IsNotExist(err) {\n\t\treturn nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\tif !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s is not a regular file of this project\", ref)\n\t}\n\traw, err := s.fsys().ReadFile(path)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\treceipt, err := parseCloseoutReceipt(raw)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\tif receipt.Scope != ref || receipt.Decision.Scope != ref {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt at %s names %s, not %s\", path, receipt.Scope, ref)\n\t}\n\treturn &receipt, nil\n}\n\nfunc parseCloseoutReceipt(raw []byte) (CloseoutReceipt, error) {\n\tvar receipt CloseoutReceipt\n\tif err := rejectDuplicateJSONKeysAndControls(raw); err != nil {\n\t\treturn receipt, err\n\t}\n\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n\tdecoder.DisallowUnknownFields()\n\tif err := decoder.Decode(&receipt); err != nil {\n\t\treturn receipt, err\n\t}\n\tif err := decoder.Decode(new(any)); err != io.EOF {\n\t\treturn receipt, errors.New(\"trailing content\")\n\t}\n\tif receipt.SchemaVersion != CloseoutReceiptSchemaVersion {\n\t\treturn receipt, fmt.Errorf(\"unsupported schema_version %d\", receipt.SchemaVersion)\n\t}\n\tif _, valid := reviewInstant(receipt.ClosedAt); !valid {\n\t\treturn receipt, fmt.Errorf(\"closed_at %q is not an instant\", receipt.ClosedAt)\n\t}\n\td := receipt.Decision\n\tif !d.Adopted || d.EvaluatorVersion != CloseoutReviewEvaluatorVersion || !validCloseoutReviewValue(d.PolicyValue) || d.Reason == \"\" {\n\t\treturn receipt, errors.New(\"decision is not one of \" + CloseoutReviewEvaluatorVersion)\n\t}\n\tif d.PolicyValue == CloseoutReviewNever && d.Required && d.Reason == \"\" || d.PolicyValue == CloseoutReviewAlways && !d.Required {\n\t\treturn receipt, fmt.Errorf(\"a %s decision cannot be required=%v\", d.PolicyValue, d.Required)\n\t}\n\tif receipt.Review != d.Review() {\n\t\treturn receipt, fmt.Errorf(\"review %q contradicts the recorded decision (%s)\", receipt.Review, d.Review())\n\t}\n\tif d.Required && receipt.ReviewBundle == \"\" && receipt.ApprovalOrigin == \"\" {\n\t\treturn receipt, errors.New(\"a required review names no verified review\")\n\t}\n\tif !d.Known {\n\t\treturn receipt, errors.New(\"a close cannot stand on unknown members or associations\")\n\t}\n\tif receipt.PolicyDigest == \"\" || receipt.SubjectDigest == \"\" {\n\t\treturn receipt, errors.New(\"policy_digest and subject_digest are required\")\n\t}\n\treturn receipt, nil\n}\n\n// NewCloseoutReceipt builds the receipt of a close from the evaluator's\n// decision and the verification it stood on. It writes nothing.\nfunc (s Store) NewCloseoutReceipt(ref string, decision CloseoutReviewDecision, verification ReviewEvaluation, subjectDigest string, now time.Time) (CloseoutReceipt, error) {\n\t_, raw, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn CloseoutReceipt{}, err\n\t}\n\t_, gate, _, err := s.closeoutSubject(ref)\n\tif err != nil {\n\t\treturn CloseoutReceipt{}, err\n\t}\n\treceipt := CloseoutReceipt{\n\t\tExitGateDigest: gate,\n\t\tSchemaVersion:  CloseoutReceiptSchemaVersion, Scope: ref, ClosedAt: now.UTC().Format(time.RFC3339),\n\t\tReview: decision.Review(), Decision: decision, PolicyDigest: \"sha256:\" + digestHex(raw), SubjectDigest: subjectDigest,\n\t\tReviewBundle: verification.BundleID, ReviewAttestation: verification.AttestationID,\n\t}\n\tif receipt.ReviewBundle == \"\" && verification.Current != nil {\n\t\treceipt.ApprovalOrigin = \"review:\" + verification.Current.ReviewID\n\t}\n\tif receipt.ReviewBundle == \"\" && receipt.ApprovalOrigin == \"\" {\n\t\treceipt.ApprovalOrigin = verification.ApprovalOrigin\n\t}\n\tif _, err := parseCloseoutReceipt(CanonicalJSON(receipt)); err != nil {\n\t\treturn CloseoutReceipt{}, fmt.Errorf(\"pose: the closeout receipt of %s would be refused: %w\", ref, err)\n\t}\n\treturn receipt, nil\n}\n\n// ErrCloseoutReceiptExists reports a receipt already published for the scope.\nvar ErrCloseoutReceiptExists = errors.New(\"pose: a closeout receipt already exists\")\n\n// PublishCloseoutReceipt publishes a receipt where none exists. It never\n// replaces one: an equal receipt is the caller's to verify, a different one\n// stays as it is.\nfunc (s Store) PublishCloseoutReceipt(receipt CloseoutReceipt) error {\n\tpath, err := s.CloseoutReceiptPath(receipt.Scope)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif existing, err := s.ReadCloseoutReceipt(receipt.Scope); err != nil {\n\t\treturn err\n\t} else if existing != nil {\n\t\treturn ErrCloseoutReceiptExists\n\t}\n\traw, err := json.MarshalIndent(receipt, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\terr = s.fsys().Publish(path, append(raw, '\\n'), 0o644, PublishDerived, PublishExpectation{Mode: ExpectAbsent})\n\tif errors.Is(err, ErrPublishConflict) {\n\t\treturn ErrCloseoutReceiptExists\n\t}\n\treturn err\n}\n\n// A roadmap's close publishes its status and then its receipt. Between the\n// two an intent stands, so a close interrupted there reads as incomplete,\n// never as a roadmap closed before adoption (spec\n// pose-closeout-review-policy-by-cost-benefit R4, R7).\nfunc (s Store) closeoutIntentPath(ref string) (string, error) {\n\tpath, err := s.CloseoutReceiptPath(ref)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn strings.TrimSuffix(path, \".json\") + \".intent.json\", nil\n}\n\n// closeoutIntentPending reports an intent on file. What cannot be read is an\n// error, which the caller treats as pending: it never proves history.\nfunc (s Store) closeoutIntentPending(ref string) (bool, error) {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif _, err := s.fsys().Lstat(path); err == nil {\n\t\treturn true, nil\n\t} else if os.IsNotExist(err) {\n\t\treturn false, nil\n\t} else {\n\t\treturn false, err\n\t}\n}\n\n// PublishCloseoutIntent records that this engine is closing ref under the\n// adopted policy, before the roadmap's status is published.\nfunc (s Store) PublishCloseoutIntent(ref string, decision CloseoutReviewDecision, now time.Time) error {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn err\n\t}\n\traw, err := json.MarshalIndent(map[string]any{\"schema_version\": 1, \"scope\": ref, \"started_at\": now.UTC().Format(time.RFC3339), \"review\": decision.Review()}, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\treturn s.fsys().Publish(path, append(raw, '\\n'), 0o644, PublishDerived, PublishExpectation{Mode: ExpectAny})\n}\n\n// ClearCloseoutIntent removes the intent once the receipt stands.\nfunc (s Store) ClearCloseoutIntent(ref string) error {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().Remove(path); err != nil && !os.IsNotExist(err) {\n\t\treturn err\n\t}\n\treturn nil\n}\n\n// roadmapCriteriaBlockers evaluates a roadmap's cut criteria from the indexed\n// delivery graph, as the roadmap gate does: a criterion that does not pass,\n// or a manual review that does not resolve inside the project. A graph that\n// cannot be read is a blocker, never a pass.\nfunc (s Store) roadmapCriteriaBlockers(slug string) []string {\n\tgraph, err := s.GetDeliveryIntegrity(\"\")\n\tif err != nil {\n\t\treturn []string{\"the cut criteria of roadmap \" + slug + \" cannot be evaluated: \" + err.Error()}\n\t}\n\tblockers := []string{}\n\tfor _, criterion := range graph.RoadmapCriteria {\n\t\tif criterion.Roadmap != slug {\n\t\t\tcontinue\n\t\t}\n\t\tif !criterion.Passed {\n\t\t\tblockers = append(blockers, criterion.ID+\": \"+strings.Join(criterion.Reasons, \"; \"))\n\t\t}\n\t\tfor _, ref := range criterion.Refs {\n\t\t\trelative, manual := strings.CutPrefix(ref, \"manual-review:\")\n\t\t\tif !manual {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tpath := filepath.Join(s.Root, filepath.FromSlash(relative))\n\t\t\tif !filepath.IsLocal(filepath.FromSlash(relative)) || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\t\t\tblockers = append(blockers, criterion.ID+\": manual review escapes project\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif info, err := s.fsys().Stat(path); err != nil || info.IsDir() {\n\t\t\t\tblockers = append(blockers, criterion.ID+\": manual review does not resolve: \"+relative)\n\t\t\t}\n\t\t}\n\t}\n\treturn blockers\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/cli/closeout_review_policy_test.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/cli/closeout_review_policy_test.go'","aggregated_output":"package cli\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\n// CLI tests of spec pose-closeout-review-policy-by-cost-benefit; the permanent\n// integration check runs every TestCloseoutReviewPolicy test.\n\nfunc adoptCloseoutPolicyFixture(t *testing.T, root, milestone, roadmap string) {\n\tt.Helper()\n\tpath := filepath.Join(root, \".pose/policy/review.json\")\n\traw, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar policy map[string]any\n\tif err := json.Unmarshal(raw, &policy); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpolicy[\"schema_version\"] = posemodel.CloseoutReviewPolicySchemaVersion\n\tpolicy[posemodel.MilestoneReviewRequiredKey], policy[posemodel.RoadmapReviewRequiredKey] = milestone, roadmap\n\tprofiles := policy[\"profiles\"].(map[string]any)\n\tprofiles[\"roadmap\"] = \"roadmap-outcome@1\"\n\tout, _ := json.Marshal(policy)\n\tmustWrite(t, path, string(out))\n\twriteCloseoutCLIFile(t, root, \".pose/review-profiles/roadmap-outcome.json\", `{\"schema_version\":2,\"id\":\"roadmap-outcome\",\"version\":1,\"scope\":\"roadmap\",\"criteria\":[{\"id\":\"outcome\",\"description\":\"reviewed\",\"evidence_classes\":[\"unit\"]}]}`)\n}\n\n// closeoutPolicyCLIFixture is the one-milestone program whose only member,\n// bundle, has an approved review, under the adopted pair.\nfunc closeoutPolicyCLIFixture(t *testing.T, milestone, roadmap string) string {\n\tt.Helper()\n\troot := reachedMilestoneFixture(t)\n\twriteCloseoutCLIFile(t, root, \".pose/roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\n---\\n\\n## Milestone: first\\n- specs: bundle\\n\")\n\twriteCloseoutCLIFile(t, root, \".pose/indexes/validation-matrix.json\", `{\"defaults\":{\"mode\":\"strict\"},\"deliveryProfiles\":{\"api-contract\":{\"kind\":\"contract\",\"requiredEvidenceClasses\":[\"integration\",\"unit\"]}}}`)\n\tadoptCloseoutPolicyFixture(t, root, milestone, roadmap)\n\tcommitCloseoutFixture(t, root, \"adopt closeout review policy\")\n\tif code, out := runPose(t, root, \"close\", \"spec:bundle\", \"--apply\", \"--reviewer\", \"agent:closeout-reviewer\"); code != 0 {\n\t\tt.Fatalf(\"close spec %d %s\", code, out)\n\t}\n\tcommitCloseoutFixture(t, root, \"closeout\")\n\treturn root\n}\n\nfunc commitCloseoutFixture(t *testing.T, root, message string) {\n\tt.Helper()\n\tartifactGit(t, root, \"add\", \"-A\")\n\tartifactGit(t, root, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-qm\", message)\n\tpublishReviewCLIIndexFixture(t, root)\n}\n\nfunc TestCloseoutReviewPolicyReceipt(t *testing.T) {\n\troot := closeoutPolicyCLIFixture(t, \"never\", \"never\")\n\treceiptPath := filepath.Join(root, \".pose/review-closeouts/milestone/program/first.json\")\n\tif _, err := os.Stat(receiptPath); !os.IsNotExist(err) {\n\t\tt.Fatalf(\"the member's close closed the milestone implicitly: %v\", err)\n\t}\n\tvar state posemodel.CloseoutState\n\tif code, out := runPoseJSON(t, root, &state, \"closeout-check\", \"milestone:program/first\", \"--json\"); state.Terminal || !state.CloseRequired {\n\t\tt.Fatalf(\"eligible milestone read as terminal: %d %s\", code, out)\n\t}\n\tcode, out := runPose(t, root, \"close\", \"milestone:program/first\")\n\tif code != 0 || !strings.Contains(out, \"close.receipt=review: not-required; milestone_review_required=never; members=1, never required\") {\n\t\tt.Fatalf(\"close milestone %d %s\", code, out)\n\t}\n\tif !strings.Contains(out, \"close.next=pose close roadmap:program\") {\n\t\tt.Fatalf(\"the close did not name the roadmap: %s\", out)\n\t}\n\traw, err := os.ReadFile(receiptPath)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, want := range []string{`\"review\": \"not-required\"`, `\"policy_key\": \"milestone_review_required\"`, `\"policy_value\": \"never\"`, `\"evaluator_version\": \"closeout-review@1\"`} {\n\t\tif !strings.Contains(string(raw), want) {\n\t\t\tt.Fatalf(\"receipt lacks %s: %s\", want, raw)\n\t\t}\n\t}\n\tif code, again := runPose(t, root, \"close\", \"milestone:program/first\"); code != 0 || !strings.Contains(again, \"close.already-satisfied\") {\n\t\tt.Fatalf(\"a repeated close was not a verification: %d %s\", code, again)\n\t}\n\tif after, _ := os.ReadFile(receiptPath); string(after) != string(raw) {\n\t\tt.Fatal(\"a repeated close rewrote the receipt\")\n\t}\n\tcommitCloseoutFixture(t, root, \"milestone closed\")\n\tcode, out = runPose(t, root, \"close\", \"roadmap:program\")\n\tif code != 0 || !strings.Contains(out, \"close.receipt=review: not-required; roadmap_review_required=never\") {\n\t\tt.Fatalf(\"close roadmap %d %s\", code, out)\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".pose/review-closeouts/roadmap/program.json\")); err != nil {\n\t\tt.Fatalf(\"no roadmap receipt: %v\", err)\n\t}\n\tif rm, _ := os.ReadFile(filepath.Join(root, \".pose/roadmaps/program.md\")); !strings.Contains(string(rm), \"status: done\") {\n\t\tt.Fatalf(\"roadmap status not published: %s\", rm)\n\t}\n}\n\nfunc TestCloseoutReviewPolicyAlwaysRefusesWithoutReview(t *testing.T) {\n\troot := closeoutPolicyCLIFixture(t, \"always\", \"always\")\n\tcode, out := runPose(t, root, \"close\", \"milestone:program/first\")\n\tif code == 0 || !strings.Contains(out, \"not eligible\") {\n\t\tt.Fatalf(\"always closed a one-member milestone without its own review: %d %s\", code, out)\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".pose/review-closeouts/milestone/program/first.json\")); !os.IsNotExist(err) {\n\t\tt.Fatal(\"a refused close published a receipt\")\n\t}\n\tvar plan posemodel.ReviewPlan\n\tif code, out := runPoseJSON(t, root, &plan, \"review-plan\", \"milestone:program/first\", \"--json\"); code != 0 || plan.CloseoutReview == nil || !plan.CloseoutReview.Required {\n\t\tt.Fatalf(\"plan does not carry the decision: %d %s\", code, out)\n\t}\n}\n\nfunc TestCloseoutReviewPolicyPublication(t *testing.T) {\n\troot := closeoutPolicyCLIFixture(t, \"never\", \"never\")\n\tpath := filepath.Join(root, \".pose/review-closeouts/milestone/program/first.json\")\n\t// A different receipt already there is never overwritten to close again.\n\twriteCloseoutCLIFile(t, root, \".pose/review-closeouts/milestone/program/first.json\", `{\"schema_version\":1,\"scope\":\"milestone:program/first\"}`)\n\tcode, out := runPose(t, root, \"close\", \"milestone:program/first\")\n\tif code == 0 {\n\t\tt.Fatalf(\"a corrupt receipt was closed over: %s\", out)\n\t}\n\tif raw, _ := os.ReadFile(path); !strings.Contains(string(raw), `\"scope\":\"milestone:program/first\"}`) {\n\t\tt.Fatalf(\"the corrupt receipt was rewritten: %s\", raw)\n\t}\n\tos.Remove(path)\n\t// A roadmap left done without its receipt is incomplete; close verifies and publishes.\n\tif code, out := runPose(t, root, \"close\", \"milestone:program/first\"); code != 0 {\n\t\tt.Fatalf(\"close milestone %d %s\", code, out)\n\t}\n\tcommitCloseoutFixture(t, root, \"milestone closed\")\n\trm := filepath.Join(root, \".pose/roadmaps/program.md\")\n\traw, _ := os.ReadFile(rm)\n\tmustWrite(t, rm, strings.Replace(string(raw), \"status: active\", \"status: done\", 1))\n\tcommitCloseoutFixture(t, root, \"status only\")\n\t// Done by hand, with no intent and no evidence of a legacy close, is not\n\t// history: the adopted rule decides it and the close publishes its receipt.\n\t// A close of this engine interrupted after the status leaves its intent,\n\t// read the same way.\n\tstore := posemodel.Store{Root: root}\n\tdecision, err := store.CurrentCloseoutDecision(\"roadmap:program\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := store.PublishCloseoutIntent(\"roadmap:program\", decision, time.Now()); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif code, out := runPose(t, root, \"close\", \"roadmap:program\"); code != 0 || !strings.Contains(out, \"close.receipt=\") {\n\t\tt.Fatalf(\"the incomplete roadmap close was not completed: %d %s\", code, out)\n\t}\n\tif code, out := runPose(t, root, \"close\", \"roadmap:program\"); code != 0 || !strings.Contains(out, \"close.already-satisfied\") {\n\t\tt.Fatalf(\"%d %s\", code, out)\n\t}\n}\n\nfunc TestCloseoutReviewPolicyAdoption(t *testing.T) {\n\troot := reachedMilestoneFixture(t)\n\tpolicyPath := filepath.Join(root, \".pose/policy/review.json\")\n\tbefore, _ := os.ReadFile(policyPath)\n\tcode, out := runPose(t, root, \"adopt\", \"closeout-review-policy\")\n\tif code != 0 || !strings.Contains(out, \"adopt.current=milestone_review_required=legacy\") || !strings.Contains(out, \"adopt.change=set milestone_review_required=never\") || !strings.Contains(out, \"adopt.apply=false\") {\n\t\tt.Fatalf(\"preview %d %s\", code, out)\n\t}\n\tif after, _ := os.ReadFile(policyPath); string(after) != string(before) {\n\t\tt.Fatal(\"a preview wrote the policy\")\n\t}\n\tfor _, args := range [][]string{\n\t\t{\"adopt\", \"closeout-review-policy\", \"--milestone-review-required\", \"always\"},\n\t\t{\"adopt\", \"closeout-review-policy\", \"--off\", \"--milestone-review-required\", \"always\", \"--roadmap-review-required\", \"never\"},\n\t\t{\"adopt\", \"criterion-reuse\", \"--milestone-review-required\", \"always\", \"--roadmap-review-required\", \"never\"},\n\t\t{\"adopt\", \"closeout-review-policy\", \"--milestone-review-required\", \"sometimes\", \"--roadmap-review-required\", \"never\", \"--apply\"},\n\t} {\n\t\tif code, out := runPose(t, root, args...); code == 0 {\n\t\t\tt.Fatalf(\"%v was accepted: %s\", args, out)\n\t\t}\n\t}\n\tif after, _ := os.ReadFile(policyPath); string(after) != string(before) {\n\t\tt.Fatal(\"a refused adoption wrote the policy\")\n\t}\n\tif code, out := runPose(t, root, \"adopt\", \"closeout-review-policy\", \"--apply\"); code != 0 {\n\t\tt.Fatalf(\"apply %d %s\", code, out)\n\t}\n\tpolicy, err := posemodel.Store{Root: root}.GetReviewPolicy()\n\tif err != nil || policy.SchemaVersion != 5 || policy.MilestoneReviewRequired != \"never\" || policy.RoadmapReviewRequired != \"never\" {\n\t\tt.Fatalf(\"%+v %v\", policy, err)\n\t}\n\tif code, out := runPose(t, root, \"adopt\", \"closeout-review-policy\", \"--milestone-review-required\", \"when-justified\", \"--roadmap-review-required\", \"always\", \"--apply\"); code != 0 {\n\t\tt.Fatalf(\"change %d %s\", code, out)\n\t}\n\tpolicy, _ = posemodel.Store{Root: root}.GetReviewPolicy()\n\tif policy.MilestoneReviewRequired != \"when-justified\" || policy.RoadmapReviewRequired != \"always\" {\n\t\tt.Fatalf(\"%+v\", policy)\n\t}\n\tif code, out := runPose(t, root, \"adopt\", \"closeout-review-policy\", \"--off\", \"--apply\"); code == 0 || !strings.Contains(out, \"cannot be turned off\") {\n\t\tt.Fatalf(\"the pair was removed: %d %s\", code, out)\n\t}\n\t// Adopting references afterwards keeps schema 5 and the pair.\n\tif code, out := runPose(t, root, \"adopt\", \"qualified-artifact-refs\", \"--apply\"); code != 0 {\n\t\tt.Fatalf(\"refs %d %s\", code, out)\n\t}\n\tif code, out := runPose(t, root, \"adopt\", \"qualified-artifact-refs\", \"--off\", \"--apply\"); code != 0 {\n\t\tt.Fatalf(\"refs off %d %s\", code, out)\n\t}\n\tpolicy, err = posemodel.Store{Root: root}.GetReviewPolicy()\n\tif err != nil || policy.SchemaVersion != 5 || policy.RoadmapReviewRequired != \"always\" {\n\t\tt.Fatalf(\"another capability lowered schema 5: %+v %v\", policy, err)\n\t}\n\tvar plan setupPlan\n\tif code, out := runPoseJSON(t, root, &plan, \"setup\", \"--json\"); code != 0 || !plan.CloseoutReview.Adopted || plan.CloseoutReview.Milestone != \"when-justified\" {\n\t\tt.Fatalf(\"setup %d %s\", code, out)\n\t}\n}\n\nfunc TestCloseoutReviewPolicySetupShowsTheLegacyRule(t *testing.T) {\n\troot := reachedMilestoneFixture(t)\n\tvar plan setupPlan\n\tif code, out := runPoseJSON(t, root, &plan, \"setup\", \"--json\"); code != 0 || plan.CloseoutReview.Adopted || !strings.HasPrefix(plan.CloseoutReview.Milestone, \"legacy\") || plan.CloseoutReview.ProposedMilestone != \"never\" {\n\t\tt.Fatalf(\"setup %d %s\", code, out)\n\t}\n\tcode, out := runPose(t, root, \"setup\")\n\tif code != 0 || !strings.Contains(out, \"setup.closeout_review=milestone_review_required=legacy\") || !strings.Contains(out, \"adopting proposes milestone_review_required=never\") {\n\t\tt.Fatalf(\"setup text %d %s\", code, out)\n\t}\n}\n\nfunc TestCloseoutReviewPolicyDoctor(t *testing.T) {\n\troot := closeoutPolicyCLIFixture(t, \"always\", \"never\")\n\tcode, out := runPose(t, root, \"doctor\")\n\t_ = code\n\tif !strings.Contains(out, \"milestone:program/first owes its own review\") || !strings.Contains(out, \"previous rule unknown\") {\n\t\tt.Fatalf(\"doctor did not report the owed review: %s\", out)\n\t}\n\tadoptCloseoutPolicyFixture(t, root, \"never\", \"never\")\n\tif _, out := runPose(t, root, \"doctor\"); strings.Contains(out, \"owes its own review\") {\n\t\tt.Fatalf(\"doctor reported a review never owes: %s\", out)\n\t}\n}\n\n// TestCloseoutReviewPolicySmoke drives the built binary from the production\n// entrypoint: adopt the pair, close the member, then the milestone and the\n// roadmap, each publishing its receipt.\nfunc TestCloseoutReviewPolicySmoke(t *testing.T) {\n\troot := reachedMilestoneFixture(t)\n\twriteCloseoutCLIFile(t, root, \".pose/roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\n---\\n\\n## Milestone: first\\n- specs: bundle\\n\")\n\twriteCloseoutCLIFile(t, root, \".pose/indexes/validation-matrix.json\", `{\"defaults\":{\"mode\":\"strict\"},\"deliveryProfiles\":{\"api-contract\":{\"kind\":\"contract\",\"requiredEvidenceClasses\":[\"integration\",\"unit\"]}}}`)\n\twriteCloseoutCLIFile(t, root, \".pose/review-profiles/roadmap-outcome.json\", `{\"schema_version\":2,\"id\":\"roadmap-outcome\",\"version\":1,\"scope\":\"roadmap\",\"criteria\":[{\"id\":\"outcome\",\"description\":\"reviewed\",\"evidence_classes\":[\"unit\"]}]}`)\n\tpolicyPath := filepath.Join(root, \".pose/policy/review.json\")\n\traw, _ := os.ReadFile(policyPath)\n\tmustWrite(t, policyPath, strings.Replace(string(raw), `\"milestone\":\"milestone-integration@1\"`, `\"milestone\":\"milestone-integration@1\",\"roadmap\":\"roadmap-outcome@1\"`, 1))\n\tcommitCloseoutFixture(t, root, \"one milestone\")\n\tif code, out := runBuilt(t, root, \"adopt\", \"closeout-review-policy\", \"--milestone-review-required\", \"when-justified\", \"--roadmap-review-required\", \"never\", \"--apply\"); code != 0 {\n\t\tt.Fatalf(\"adopt %d %s\", code, out)\n\t}\n\tcommitCloseoutFixture(t, root, \"adopt\")\n\tif code, out := runBuilt(t, root, \"close\", \"spec:bundle\", \"--apply\", \"--reviewer\", \"agent:closeout-reviewer\"); code != 0 || !strings.Contains(out, \"close.next=pose close milestone:program/first\") {\n\t\tt.Fatalf(\"close spec %d %s\", code, out)\n\t}\n\tcommitCloseoutFixture(t, root, \"closeout\")\n\tif code, out := runBuilt(t, root, \"close\", \"milestone:program/first\"); code != 0 || !strings.Contains(out, \"close.receipt=review: not-required; milestone_review_required=when-justified; members=1, threshold>2\") {\n\t\tt.Fatalf(\"close milestone %d %s\", code, out)\n\t}\n\tcommitCloseoutFixture(t, root, \"milestone\")\n\tif code, out := runBuilt(t, root, \"close\", \"roadmap:program\"); code != 0 || !strings.Contains(out, \"close.receipt=review: not-required; roadmap_review_required=never\") {\n\t\tt.Fatalf(\"close roadmap %d %s\", code, out)\n\t}\n\tvar state posemodel.CloseoutState\n\tcode, out := runBuilt(t, root, \"closeout-check\", \"roadmap:program\", \"--json\")\n\tif err := json.Unmarshal([]byte(out), &state); err != nil || state.CloseoutReceipt == nil || state.CloseoutReceipt.Review != \"not-required\" {\n\t\tt.Fatalf(\"closeout-check %d %s %v\", code, out, err)\n\t}\n}\n\nfunc TestCloseoutReviewPolicyRepeatedCloseVerifiesTheTerminalContract(t *testing.T) {\n\troot := closeoutPolicyCLIFixture(t, \"never\", \"never\")\n\tif code, out := runPose(t, root, \"close\", \"milestone:program/first\"); code != 0 {\n\t\tt.Fatalf(\"close milestone %d %s\", code, out)\n\t}\n\t// The member reopens: the receipt still names the same composition, but\n\t// the milestone is no longer terminal, so a repeated close fails.\n\tspec := filepath.Join(root, \".pose/specs/bundle/spec.md\")\n\traw, err := os.ReadFile(spec)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tmustWrite(t, spec, strings.Replace(string(raw), \"status: done\", \"status: in-progress\", 1))\n\tif code, out := runPose(t, root, \"close\", \"milestone:program/first\"); code == 0 || strings.Contains(out, \"close.already-satisfied\") {\n\t\tt.Fatalf(\"a receipt answered for a milestone that is no longer terminal: %d %s\", code, out)\n\t}\n}\n\nfunc TestCloseoutReviewPolicyTypedLocalMemberCloses(t *testing.T) {\n\troot := reachedMilestoneFixture(t)\n\twriteCloseoutCLIFile(t, root, \".pose/roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\n---\\n\\n## Milestone: first\\n- specs: spec:bundle\\n\")\n\twriteCloseoutCLIFile(t, root, \".pose/indexes/validation-matrix.json\", `{\"defaults\":{\"mode\":\"strict\"},\"deliveryProfiles\":{\"api-contract\":{\"kind\":\"contract\",\"requiredEvidenceClasses\":[\"integration\",\"unit\"]}}}`)\n\tadoptCloseoutPolicyFixture(t, root, \"never\", \"never\")\n\tcommitCloseoutFixture(t, root, \"typed member\")\n\tif code, out := runPose(t, root, \"close\", \"spec:bundle\", \"--apply\", \"--reviewer\", \"agent:closeout-reviewer\"); code != 0 {\n\t\tt.Fatalf(\"close spec %d %s\", code, out)\n\t}\n\tcommitCloseoutFixture(t, root, \"closeout\")\n\tif code, out := runPose(t, root, \"close\", \"milestone:program/first\"); code != 0 || !strings.Contains(out, \"close.receipt=\") {\n\t\tt.Fatalf(\"a spec:<slug> member did not close: %d %s\", code, out)\n\t}\n}\n\nfunc TestCloseoutReviewPolicyAdoptRequestRefusesThePair(t *testing.T) {\n\troot := reachedMilestoneFixture(t)\n\tif code, out := runPose(t, root, \"adopt\", \"--request\", \"act-x\", \"--milestone-review-required\", \"never\"); code != 2 {\n\t\tt.Fatalf(\"an answered request swallowed the pair flags: %d %s\", code, out)\n\t}\n}\n\nfunc TestCloseoutReviewPolicyHistoricalRoadmapCloseIsReadOnly(t *testing.T) {\n\troot := reachedMilestoneFixture(t)\n\twriteCloseoutCLIFile(t, root, \".pose/roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\n---\\n\\n## Milestone: first\\n- specs: bundle\\n\")\n\twriteCloseoutCLIFile(t, root, \".pose/indexes/validation-matrix.json\", `{\"defaults\":{\"mode\":\"strict\"},\"deliveryProfiles\":{\"api-contract\":{\"kind\":\"contract\",\"requiredEvidenceClasses\":[\"integration\",\"unit\"]}}}`)\n\tcommitCloseoutFixture(t, root, \"one milestone\")\n\tif code, out := runPose(t, root, \"close\", \"spec:bundle\", \"--apply\", \"--reviewer\", \"agent:closeout-reviewer\"); code != 0 {\n\t\tt.Fatalf(\"close spec %d %s\", code, out)\n\t}\n\t// Closed under the legacy rule: done before review adoption, so the\n\t// legacy cutoff exempts it.\n\twriteCloseoutCLIFile(t, root, \".pose/roadmaps/program.md\", \"---\\nslug: program\\nstatus: done\\ncreated_at: 2026-01-01\\n---\\n\\n## Milestone: first\\n- specs: bundle\\n\")\n\tpolicyPath := filepath.Join(root, \".pose/policy/review.json\")\n\traw, _ := os.ReadFile(policyPath)\n\tvar policy map[string]any\n\tjson.Unmarshal(raw, &policy)\n\tpolicy[\"adopted_at\"] = \"2026-08-01\"\n\tout, _ := json.Marshal(policy)\n\tmustWrite(t, policyPath, string(out))\n\tadoptCloseoutPolicyFixture(t, root, \"always\", \"always\")\n\tcommitCloseoutFixture(t, root, \"history then adoption\")\n\tcode, closeOut := runPose(t, root, \"close\", \"roadmap:program\")\n\tif code != 0 || !strings.Contains(closeOut, \"close.already-satisfied\") || strings.Contains(closeOut, \"close.receipt=\") {\n\t\tt.Fatalf(\"a historical roadmap was not verified read-only: %d %s\", code, closeOut)\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".pose/review-closeouts/roadmap/program.json\")); !os.IsNotExist(err) {\n\t\tt.Fatal(\"a receipt was backfilled for history\")\n\t}\n}\n","exit_code":0,"status":"completed"}}
