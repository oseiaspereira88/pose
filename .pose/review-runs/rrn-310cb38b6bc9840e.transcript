ty\": \"required\",\n          \"when\": {\n            \"fileExists\": \"build.gradle\",\n            \"fileNotExists\": \"gradlew\"\n          },\n          \"evidenceClass\": \"unit\"\n        },\n        {\n          \"name\": \"gradle-test-wrapper-kts\",\n          \"program\": \"gradle\",\n          \"args\": [\n            \"test\"\n          ],\n          \"severity\": \"required\",\n          \"when\": {\n            \"fileExists\": \"build.gradle.kts\",\n            \"fileNotExists\": \"gradlew\"\n          },\n          \"evidenceClass\": \"unit\"\n        }\n      ]\n    },\n    \"python\": {\n      \"checks\": [\n        {\n          \"name\": \"poetry-test\",\n          \"program\": \"poetry\",\n          \"args\": [\n            \"run\",\n            \"pytest\",\n            \"-q\"\n          ],\n          \"severity\": \"required\",\n          \"when\": {\n            \"fileExists\": \"poetry.lock\"\n          },\n          \"evidenceClass\": \"unit\"\n        },\n        {\n          \"name\": \"pipenv-test\",\n          \"program\": \"pipenv\",\n          \"args\": [\n            \"run\",\n            \"pytest\",\n            \"-q\"\n          ],\n          \"severity\": \"required\",\n          \"when\": {\n            \"fileExists\": \"Pipfile\",\n            \"fileNotExistsAny\": [\n              \"poetry.lock\"\n            ]\n          },\n          \"evidenceClass\": \"unit\"\n        },\n        {\n","exit_code":0,"status":"completed"}}
