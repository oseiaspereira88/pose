{"type":"item.completed","item":{"id":"item_77","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'type .*Draft|PriorFindings|prior_findings|ReviewDraft' pose-mcp/internal/pose --glob '*draft*' --glob '*delegat*'\"","aggregated_output":"pose-mcp/internal/pose/delegated_review_escalation.go:198:\tif draft, _ := ParseReviewDraft(run.Output); draft != nil && draft.BusinessDecision != nil {\npose-mcp/internal/pose/delegated_verdicts.go:134:\tQuestions     []ReviewDraftQuestion `json:\"questions\"`\npose-mcp/internal/pose/delegated_verdicts.go:146:\tSurfaces []ReviewDraftSurface `json:\"surfaces\"`\npose-mcp/internal/pose/delegated_verdicts.go:174:func (s Store) verdictCoverageReasons(run ReviewRun, bundle ReviewBundle, draft *ReviewDraft) []string {\npose-mcp/internal/pose/delegated_verdicts.go:237:func adjudicationRecordFor(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, proofID, issuer string, at time.Time) AdjudicationRecord {\npose-mcp/internal/pose/delegated_verdicts.go:238:\tquestions := append([]ReviewDraftQuestion(nil), draft.Questions...)\npose-mcp/internal/pose/delegated_verdicts.go:247:func smokeDocumentFor(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, targets []DeliveryTarget, proofID, issuer, scoped string, at time.Time) smokeResultDocument {\npose-mcp/internal/pose/delegated_verdicts.go:252:\tsurfaces := append([]ReviewDraftSurface(nil), draft.Surfaces...)\npose-mcp/internal/pose/delegated_verdicts.go:278:func (s Store) recordDelegatedVerdict(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, proofID, issuer string, now time.Time) (string, string, error) {\npose-mcp/internal/pose/delegated_verdicts.go:340:\tdraft, _ := ParseReviewDraft(run.Output)\npose-mcp/internal/pose/delegated_verdicts.go:427:func (s Store) verifiedVerdictRun(runID, proofID, issuer, kind string) (ReviewRun, ReviewBundle, ReviewDraft, error) {\npose-mcp/internal/pose/delegated_verdicts.go:430:\t\treturn ReviewRun{}, ReviewBundle{}, ReviewDraft{}, err\npose-mcp/internal/pose/delegated_verdicts.go:433:\t\treturn ReviewRun{}, ReviewBundle{}, ReviewDraft{}, fmt.Errorf(\"the run's proof does not establish a complete run\")\npose-mcp/internal/pose/delegated_verdicts.go:436:\t\treturn ReviewRun{}, ReviewBundle{}, ReviewDraft{}, fmt.Errorf(\"the record names issuer %s, the run's proof was signed by %s\", issuer, assurance.Issuer)\npose-mcp/internal/pose/delegated_verdicts.go:440:\t\treturn ReviewRun{}, ReviewBundle{}, ReviewDraft{}, err\npose-mcp/internal/pose/delegated_verdicts.go:443:\t\treturn ReviewRun{}, ReviewBundle{}, ReviewDraft{}, fmt.Errorf(\"the run is a %s run, not %s\", run.Kind, kind)\npose-mcp/internal/pose/delegated_verdicts.go:445:\tdraft, err := ParseReviewDraft(run.Output)\npose-mcp/internal/pose/delegated_verdicts.go:447:\t\treturn ReviewRun{}, ReviewBundle{}, ReviewDraft{}, fmt.Errorf(\"the run's draft cannot be read\")\npose-mcp/internal/pose/delegated_verdicts.go:451:\t\treturn ReviewRun{}, ReviewBundle{}, ReviewDraft{}, err\npose-mcp/internal/pose/delegated_verdicts.go:454:\t\treturn ReviewRun{}, ReviewBundle{}, ReviewDraft{}, errors.New(why)\npose-mcp/internal/pose/delegated_verdicts.go:457:\t\treturn ReviewRun{}, ReviewBundle{}, ReviewDraft{}, errors.New(strings.Join(reasons, \"; \"))\npose-mcp/internal/pose/delegated_verdicts_test.go:14:func verdictDraft(t *testing.T, draft ReviewDraft) string {\npose-mcp/internal/pose/delegated_verdicts_test.go:16:\tdraft.Schema = ReviewDraftSchema\npose-mcp/internal/pose/delegated_verdicts_test.go:18:\t\tdraft.Findings = []ReviewDraftFinding{}\npose-mcp/internal/pose/delegated_verdicts_test.go:54:\tif err := os.WriteFile(draftPath, []byte(verdictDraft(t, ReviewDraft{Decision: \"approved\"})), 0o600); err != nil {\npose-mcp/internal/pose/delegated_verdicts_test.go:65:\tverdict := ReviewDraft{Decision: \"changes-requested\", Questions: []ReviewDraftQuestion{{ID: \"R1\", Verdict: AdjudicationDoesNotHold, Evidence: \"file:api/server.go:3\", Rationale: \"the contract changed\"}}}\npose-mcp/internal/pose/delegated_verdicts_test.go:100:\tverdict := ReviewDraft{Decision: \"approved\", Surfaces: []ReviewDraftSurface{{Ref: \"contract:backend-api\", Outcome: SmokeObserved, Commands: []string{\"go run ./api\"}, Observed: \"the API answered as R1 says\"}}}\npose-mcp/internal/pose/delegated_verdicts_test.go:131:\tverdict := ReviewDraft{Decision: \"approved\", Surfaces: []ReviewDraftSurface{\npose-mcp/internal/pose/delegated_verdicts_test.go:163:\tverdict := ReviewDraft{Decision: \"approved\", Questions: []ReviewDraftQuestion{{ID: \"R1\", Verdict: AdjudicationHolds, Rationale: \"it does\"}}}\npose-mcp/internal/pose/delegated_verdicts_test.go:199:\tverdict := ReviewDraft{Decision: \"approved\", Questions: []ReviewDraftQuestion{{ID: \"R999\", Verdict: AdjudicationHolds, Rationale: \"unasked\"}}}\npose-mcp/internal/pose/delegated_verdicts_test.go:212:\tanswered := ReviewDraft{Decision: \"approved\", Questions: []ReviewDraftQuestion{{ID: \"R1\", Verdict: AdjudicationHolds, Rationale: \"it does\"}}}\npose-mcp/internal/pose/delegated_verdicts_test.go:235:\tverdict := ReviewDraft{Decision: \"approved\", Surfaces: []ReviewDraftSurface{{Ref: \"contract:backend-api\", Outcome: SmokeObserved, Commands: []string{\"go run ./api\"}, Observed: \"ok\"}}}\npose-mcp/internal/pose/delegated_verdicts_test.go:275:\tverdict := ReviewDraft{Decision: \"changes-requested\", Questions: []ReviewDraftQuestion{{ID: \"R1\", Verdict: AdjudicationDoesNotHold, Rationale: \"it does not\"}}}\npose-mcp/internal/pose/delegated_verdicts_test.go:300:\tverdict := ReviewDraft{Decision: \"approved\", Surfaces: []ReviewDraftSurface{{Ref: \"contract:backend-api\", Outcome: SmokeObserved, Commands: []string{\"go run ./api\"}, Observed: \"ok\"}}}\npose-mcp/internal/pose/delegated_verdicts_test.go:335:\tverdict := ReviewDraft{Decision: \"approved\", Questions: []ReviewDraftQuestion{{ID: \"R1\", Verdict: AdjudicationHolds, Rationale: \"it does\"}}}\npose-mcp/internal/pose/delegated_review_request_test.go:52:\tfindings := []ReviewDraftFinding{{ID: \"B1\", Severity: \"high\", Disposition: \"blocker\", File: \"x.go\", Line: 3, Summary: \"a defect\"}}\npose-mcp/internal/pose/delegated_review_request_test.go:214:\tfindings := []ReviewDraftFinding{{ID: \"B1\", Severity: \"high\", Disposition: \"blocker\", File: \"x.go\", Line: 3, Summary: \"a defect\"}}\npose-mcp/internal/pose/delegated_review_request_test.go:271:\t\tdraft         ReviewDraft\npose-mcp/internal/pose/delegated_review_request_test.go:274:\t\t{DelegationPurposeAdjudicate, ReviewBriefKindAdjudication, ReviewDraft{Decision: \"changes-requested\", Questions: []ReviewDraftQuestion{{ID: \"R1\", Verdict: AdjudicationDoesNotHold, Rationale: \"no\"}}}, AdjudicationsDir},\npose-mcp/internal/pose/delegated_review_request_test.go:275:\t\t{DelegationPurposeSmoke, ReviewBriefKindSmoke, ReviewDraft{Decision: \"approved\", Surfaces: []ReviewDraftSurface{{Ref: \"contract:backend-api\", Outcome: SmokeObserved, Commands: []string{\"go run ./api\"}, Observed: \"ok\"}}}, SmokeResultsDir},\npose-mcp/internal/pose/delegated_review_request_test.go:448:\tfindings := []ReviewDraftFinding{{ID: \"B1\", Severity: \"high\", Disposition: \"blocker\", File: \"x.go\", Line: 3, Summary: \"a defect\"}}\n","exit_code":0,"status":"completed"}}
