{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2c7305cd94500009875ddc1b7880d8331 38e6d16ae90f6e8266c56d2e12b2465269fdb4ac -- pose-mcp/internal/pose/spec.go pose-mcp/internal/cli/surface_check.go pose-mcp/internal/cli/doctor.go pose-mcp/internal/pose/artifact_ref.go pose-mcp/internal/pose/spec_transfer.go'","aggregated_output":"diff --git a/pose-mcp/internal/cli/doctor.go b/pose-mcp/internal/cli/doctor.go\nindex 8944a53d..d091206a 100644\n--- a/pose-mcp/internal/cli/doctor.go\n+++ b/pose-mcp/internal/cli/doctor.go\n@@ -262,6 +262,7 @@ func runDoctorDiagnostics(locale cliLocale) (root string, findings []doctorFindi\n \t}\n \tadd(\"instance.pose-dir\", \"ok\", text(\".pose/ present\", \".pose/ presente\"), \"\")\n \tdiagnoseProjectState(root, add, text)\n+\tdiagnoseCloseoutReviewPolicy(root, add, text)\n \tdiagnoseReviewContinuity(root, add)\n \n \t// 3. Native engine contract.\n@@ -1574,3 +1575,30 @@ func declaredMCPProjectID(raw []byte) string {\n \tid, _ := doc.MCPServers[\"pose\"].Env[\"POSE_DEFAULT_PROJECT_ID\"].(string)\n \treturn id\n }\n+\n+// diagnoseCloseoutReviewPolicy reports open milestones and roadmaps that owe\n+// their own review under the adopted closeout review policy, because of the\n+// policy or of their composition (spec pose-closeout-review-policy-by-cost-benefit\n+// R6). It only reports: `pose close` remains the gate.\n+func diagnoseCloseoutReviewPolicy(root string, add func(string, string, string, string), text func(string, string) string) {\n+\t// The store `pose close` uses, with the resolver the environment binds,\n+\t// so an external or transferred member resolves here as it does there\n+\t// (review round 11, N37).\n+\tstore := cliGovernedStore(root)\n+\tpolicy, err := store.GetReviewPolicy()\n+\tif err != nil || !policy.CloseoutReviewAdopted() {\n+\t\treturn\n+\t}\n+\towing, err := store.CloseoutReviewsOwed()\n+\tif err != nil {\n+\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"open scopes owing a closeout review could not be listed: %v\", \"escopos abertos que devem revisão de fechamento não puderam ser listados: %v\"), err), text(\"run `pose closeout-check <scope>` for each open milestone and roadmap\", \"rode `pose closeout-check <escopo>` para cada milestone e roadmap aberto\"))\n+\t\treturn\n+\t}\n+\tif len(owing) == 0 {\n+\t\tadd(\"closeout-review.owed\", \"ok\", fmt.Sprintf(text(\"no open scope owes a review it lacks (milestone_review_required=%s, roadmap_review_required=%s)\", \"nenhum escopo aberto deve uma revisão que não tem (milestone_review_required=%s, roadmap_review_required=%s)\"), policy.MilestoneReviewRequired, policy.RoadmapReviewRequired), \"\")\n+\t\treturn\n+\t}\n+\tfor _, item := range owing {\n+\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"%s owes its own review: %s=%s, %s; previous rule %s\", \"%s deve revisão própria: %s=%s, %s; regra anterior %s\"), item.Scope, item.Decision.PolicyKey, item.Decision.PolicyValue, item.Decision.Reason, item.Previous), item.Action)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/surface_check.go b/pose-mcp/internal/cli/surface_check.go\nindex 1c9cd9c2..179ff26f 100644\n--- a/pose-mcp/internal/cli/surface_check.go\n+++ b/pose-mcp/internal/cli/surface_check.go\n@@ -397,12 +397,16 @@ func roadmapGate(root, slug, milestone string) (roadmapGateResult, error) {\n \t\t}\n \t\tfound = true\n \t\tfor _, member := range candidate.Specs {\n-\t\t\tlocal := member\n-\t\t\tif ref, err := posemodel.ParseArtifactRef(member); err == nil && ref.Project != \"\" {\n-\t\t\t\tif ref.Project != project {\n-\t\t\t\t\tcontinue\n-\t\t\t\t}\n-\t\t\t\tlocal = ref.Slug\n+\t\t\t// The member as the closeout review policy counts it: a local\n+\t\t\t// member a transfer moved is judged at its destination, and an\n+\t\t\t// external one by federated acceptance (review round 6, N24).\n+\t\t\tlocal, external, unresolved := store.CloseoutMemberTarget(member)\n+\t\t\tif unresolved != \"\" {\n+\t\t\t\tblockers = append(blockers, \"member spec is not resolvable: \"+unresolved)\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tif external {\n+\t\t\t\tcontinue\n \t\t\t}\n \t\t\tstate, err := store.GetCloseoutState(\"spec:\" + local)\n \t\t\tif err != nil || !state.Terminal {\ndiff --git a/pose-mcp/internal/pose/artifact_ref.go b/pose-mcp/internal/pose/artifact_ref.go\nindex 22fc3d8a..f9f09763 100644\n--- a/pose-mcp/internal/pose/artifact_ref.go\n+++ b/pose-mcp/internal/pose/artifact_ref.go\n@@ -201,7 +201,13 @@ func (r ArtifactResolver) resolve(localProject, raw string, redirectPath map[str\n \t\trefsRequired := policy.SchemaVersion == QualifiedArtifactPolicySchemaVersion || policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion\n \t\ttransferValid := policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 1 || policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 0\n \t\trefsCompatible := policy.RefsVersion == 0 || policy.RefsVersion == 1 && refsRequired\n-\t\tif !refsCompatible || refsRequired && policy.RefsVersion != 1 || policy.SchemaVersion > SpecAuthorityTransferPolicySchemaVersion || !transferValid {\n+\t\tif policy.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n+\t\t\t// Schema 5 (closeout review pair) keeps references and transfer\n+\t\t\t// optional: 0, or 1 as schemas 3 and 4 define them.\n+\t\t\trefsCompatible = policy.RefsVersion == 0 || policy.RefsVersion == 1\n+\t\t\ttransferValid = policy.TransferVersion == 0 || policy.TransferVersion == 1 && policy.RefsVersion == 1\n+\t\t}\n+\t\tif !refsCompatible || refsRequired && policy.RefsVersion != 1 || policy.SchemaVersion > CloseoutReviewPolicySchemaVersion || !transferValid {\n \t\t\tout.State = \"unsupported-artifact-contract\"\n \t\t\treturn out\n \t\t}\ndiff --git a/pose-mcp/internal/pose/spec.go b/pose-mcp/internal/pose/spec.go\nindex bd17f7a4..aada4858 100644\n--- a/pose-mcp/internal/pose/spec.go\n+++ b/pose-mcp/internal/pose/spec.go\n@@ -56,6 +56,10 @@ type Store struct {\n \tRoot               string // project root containing .pose/\n \tFederatedProjectID string\n \tFederatedResolver  *ArtifactResolver\n+\t// closeoutChain is the chain of local aggregate scopes whose terminal\n+\t// verification is asking for this one, through their dependency edges:\n+\t// a scope already in it is a cycle and is not proven closed.\n+\tcloseoutChain []string\n \t// specs, when set, is the spec listing of one operation, read once\n \t// (spec pose-attention-within-a-second). Nil outside such an operation.\n \tspecs *specSnapshot\n@@ -67,6 +71,10 @@ type Store struct {\n \t// the disk, a preview reads its staged view. A store built from this one\n \t// carries it on.\n \tFS Files\n+\t// planWithoutCloseoutGate builds a review plan without asking the\n+\t// closeout review gate, for the gate's own question about the plan's\n+\t// effective independence (spec pose-closeout-review-policy-by-cost-benefit).\n+\tplanWithoutCloseoutGate bool\n }\n \n // fsys is the store's filesystem.\ndiff --git a/pose-mcp/internal/pose/spec_transfer.go b/pose-mcp/internal/pose/spec_transfer.go\nindex 09ae1fe4..1fd62349 100644\n--- a/pose-mcp/internal/pose/spec_transfer.go\n+++ b/pose-mcp/internal/pose/spec_transfer.go\n@@ -528,7 +528,7 @@ func requireSpecTransferCapability(files Files, store Store) error {\n \tif err != nil {\n \t\treturn specTransferError(\"unsupported-policy\")\n \t}\n-\tif policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion || policy.QualifiedArtifactRefsVersion != 1 || policy.SpecAuthorityTransferVersion != 1 {\n+\tif (policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && policy.SchemaVersion != CloseoutReviewPolicySchemaVersion) || policy.QualifiedArtifactRefsVersion != 1 || policy.SpecAuthorityTransferVersion != 1 {\n \t\treturn specTransferError(\"spec-authority-transfer-capability-not-adopted\")\n \t}\n \treturn nil\n","exit_code":0,"status":"completed"}}
