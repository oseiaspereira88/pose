pproved || verification.State != \"closed\" {\n+\t\treturn verification, err\n+\t}\n+\t// Under an adopted closeout review policy an aggregate scope is closed\n+\t// only by its explicit close: an approval, its own, inherited or an\n+\t// exemption, leaves it ready to close until its receipt stands. A scope\n+\t// closed before adoption keeps its sealed reading (review round 9, N31).\n+\tref, parseErr := ParseScopeRef(scope)\n+\tif parseErr != nil || ref.Kind != \"milestone\" && ref.Kind != \"roadmap\" {\n+\t\treturn verification, nil\n+\t}\n+\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || !adopted || s.closeoutScopeHistorical(ref) || s.milestoneClosedBeforeAdoption(ref) || s.receiptStandsFor(scope) {\n+\t\treturn verification, nil\n+\t}\n+\tverification.State = \"ready-to-close\"\n+\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope + \" (`pose close \" + scope + \"` publishes its closeout receipt)\"\n+\treturn verification, nil\n+}\n+\n+func (s Store) proportionalReviewVerificationOf(scope string) (ReviewBundleVerification, error) {\n \town, err := s.computeReviewVerification(scope)\n \tif err != nil || own.Approved {\n \t\treturn own, err\n \t}\n \tref, parseErr := ParseScopeRef(scope)\n-\tif parseErr != nil || ref.Kind != \"milestone\" {\n+\tif parseErr != nil || (ref.Kind != \"milestone\" && ref.Kind != \"roadmap\") {\n \t\treturn own, nil\n \t}\n-\t// A policy without bundles answers through its review attempts alone, and has no\n-\t// bundle of the spec to stand on.\n-\tif policy, err := s.GetReviewPolicy(); err != nil || !policy.ReviewBundles {\n+\tpolicy, err := s.GetReviewPolicy()\n+\tif err != nil {\n \t\treturn own, nil\n \t}\n \tif s.milestoneReviewRefused(scope) {\n \t\treturn own, nil\n \t}\n+\t// An adopted closeout review policy is the only rule for an open scope:\n+\t// legacy inheritance and declared exemptions cannot weaken `always`, and\n+\t// the policy's own exemption reads the same gate as reviewCheck. A roadmap\n+\t// closed before adoption keeps the legacy reading below.\n+\tadopted := policy.CloseoutReviewAdopted() && !s.closeoutScopeHistorical(ref)\n+\tif adopted {\n+\t\tdecision, exempt, gateErr := s.closeoutReviewGate(scope, policy)\n+\t\tif gateErr != nil || decision == nil || !exempt || !decision.Known {\n+\t\t\treturn own, nil\n+\t\t}\n+\t\tif s.FederatedResolver != nil {\n+\t\t\tvar acceptance FederatedRoadmapAcceptanceReport\n+\t\t\tvar err error\n+\t\t\tif ref.Kind == \"milestone\" {\n+\t\t\t\tacceptance, err = s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n+\t\t\t} else {\n+\t\t\t\tacceptance, err = s.FederatedRoadmapAcceptance(s.FederatedProjectID, ref.Slug, *s.FederatedResolver)\n+\t\t\t}\n+\t\t\tif err != nil || !acceptance.Ready {\n+\t\t\t\treturn own, nil\n+\t\t\t}\n+\t\t}\n+\t\t// The exemption satisfies the review, not the close: the scope is\n+\t\t// closed only by its explicit close, whose receipt must stand, and a\n+\t\t// roadmap only over closed milestones. The full terminal verifier\n+\t\t// is closeout's (review round 8, N30).\n+\t\tverification := ReviewBundleVerification{\n+\t\t\tScope: scope, State: \"ready-to-close\", Fresh: true, Approved: true,\n+\t\t\tNextAction:     \"apply the guarded lifecycle transition for \" + scope + \" (`pose close \" + scope + \"` publishes its closeout receipt)\",\n+\t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n+\t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n+\t\t}\n+\t\t// Each child must still stand, as an approved review requires of\n+\t\t// its children: a milestone's local members by their review, a\n+\t\t// roadmap's milestones by their own verification, which is closed\n+\t\t// only once their receipt stands. Neither recurses into this scope\n+\t\t// (review round 9, N32).\n+\t\tchildren, childErr := s.reviewBundleChildRefs(ref)\n+\t\tif childErr != nil {\n+\t\t\tverifica