{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/closeout_review_policy.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Closeout review policy by cost and benefit (spec\n     4\t// pose-closeout-review-policy-by-cost-benefit, ADR\n     5\t// closeout-review-policy-by-cost-and-benefit). An instance that adopts review\n     6\t// policy schema 5 decides, per aggregate scope kind, whether the close of a\n     7\t// milestone or a roadmap owes its own independent review. Closing stays\n     8\t// explicit in every mode; what changes is only the review of the aggregate.\n     9\t// One evaluator answers for every reader, so plan, verification, state,\n    10\t// doctor and close cannot disagree about the threshold.\n    11\t\n    12\timport (\n    13\t\t\"encoding/json\"\n    14\t\t\"fmt\"\n    15\t\t\"sort\"\n    16\t\t\"strings\"\n    17\t)\n    18\t\n    19\tconst (\n    20\t\tCloseoutReviewNever         = \"never\"\n    21\t\tCloseoutReviewWhenJustified = \"when-justified\"\n    22\t\tCloseoutReviewAlways        = \"always\"\n    23\t\n    24\t\tCloseoutReviewEvaluatorVersion = \"closeout-review@1\"\n    25\t\n    26\t\tMilestoneReviewRequiredKey = \"milestone_review_required\"\n    27\t\tRoadmapReviewRequiredKey   = \"roadmap_review_required\"\n    28\t\n    29\t\t// The when-justified thresholds the maintainer chose: a milestone owes a\n    30\t\t// review with more than two distinct specs; a roadmap with more than one\n    31\t\t// distinct spec and at least one ADR association.\n    32\t\tcloseoutMilestoneMemberThreshold = 2\n    33\t\tcloseoutRoadmapMemberThreshold   = 1\n    34\t)\n    35\t\n    36\tfunc validCloseoutReviewValue(value string) bool {\n    37\t\tswitch value {\n    38\t\tcase CloseoutReviewNever, CloseoutReviewWhenJustified, CloseoutReviewAlways:\n    39\t\t\treturn true\n    40\t\t}\n    41\t\treturn false\n    42\t}\n    43\t\n    44\t// validateCloseoutReviewPolicyKeys refuses the pair outside schema 5, and\n    45\t// under schema 5 refuses a missing, null, mistyped, duplicated or unknown value\n    46\t// before anything plans or writes against it.\n    47\tfunc validateCloseoutReviewPolicyKeys(raw []byte, fields map[string]json.RawMessage, schema int) error {\n    48\t\t_, hasMilestone := fields[MilestoneReviewRequiredKey]\n    49\t\t_, hasRoadmap := fields[RoadmapReviewRequiredKey]\n    50\t\tif schema != CloseoutReviewPolicySchemaVersion {\n    51\t\t\tif hasMilestone || hasRoadmap {\n    52\t\t\t\treturn fmt.Errorf(\"pose: %s and %s require review policy schema %d\", MilestoneReviewRequiredKey, RoadmapReviewRequiredKey, CloseoutReviewPolicySchemaVersion)\n    53\t\t\t}\n    54\t\t\treturn nil\n    55\t\t}\n    56\t\tif err := rejectDuplicateJSONKeys(raw, false, true); err != nil {\n    57\t\t\treturn fmt.Errorf(\"pose: invalid schema-%d review policy: %w\", CloseoutReviewPolicySchemaVersion, err)\n    58\t\t}\n    59\t\tif !hasMilestone || !hasRoadmap {\n    60\t\t\treturn fmt.Errorf(\"pose: review policy schema %d requires both %s and %s\", CloseoutReviewPolicySchemaVersion, MilestoneReviewRequiredKey, RoadmapReviewRequiredKey)\n    61\t\t}\n    62\t\tfor _, key := range []string{MilestoneReviewRequiredKey, RoadmapReviewRequiredKey} {\n    63\t\t\tvar value string\n    64\t\t\tif string(fields[key]) == \"null\" || json.Unmarshal(fields[key], &value) != nil || !validCloseoutReviewValue(value) {\n    65\t\t\t\treturn fmt.Errorf(\"pose: %s must be one of never, when-justified, always (got %s)\", key, string(fields[key]))\n    66\t\t\t}\n    67\t\t}\n    68\t\treturn nil\n    69\t}\n    70\t\n    71\t// CloseoutReviewAdopted reports a policy that decides aggregate reviews by the\n    72\t// closeout pair. Every other policy keeps the legacy rule unchanged.\n    73\tfunc (p ReviewPolicy) CloseoutReviewAdopted() bool {\n    74\t\treturn p.SchemaVersion == CloseoutReviewPolicySchemaVersion\n    75\t}\n    76\t\n    77\t// CloseoutReviewSetting names the policy key and value that govern a scope kind.\n    78\tfunc (p ReviewPolicy) CloseoutReviewSetting(kind string) (string, string) {\n    79\t\tswitch kind {\n    80\t\tcase \"milestone\":\n    81\t\t\treturn MilestoneReviewRequiredKey, p.MilestoneReviewRequired\n    82\t\tcase \"roadmap\":\n    83\t\t\treturn RoadmapReviewRequiredKey, p.RoadmapReviewRequired\n    84\t\t}\n    85\t\treturn \"\", \"\"\n    86\t}\n    87\t\n    88\t// CloseoutReviewDecision is the evaluator's answer for one aggregate scope.\n    89\t// Projections render it; none of them recomputes a threshold.\n    90\ttype CloseoutReviewDecision struct {\n    91\t\tScope            string `json:\"scope\"`\n    92\t\tAdopted          bool   `json:\"adopted\"`\n    93\t\tEvaluatorVersion string `json:\"evaluator_version,omitempty\"`\n    94\t\tPolicyKey        string `json:\"policy_key,omitempty\"`\n    95\t\tPolicyValue      string `json:\"policy_value,omitempty\"`\n    96\t\t// Required is true when the scope owes its own independent review. An\n    97\t\t// unknown input never yields false.\n    98\t\tRequired bool `json:\"required\"`\n    99\t\t// Known is false when a member or an association could not be resolved:\n   100\t\t// the decision then requires the review and says what is missing.\n   101\t\tKnown       bool     `json:\"known\"`\n   102\t\tReason      string   `json:\"reason,omitempty\"`\n   103\t\tMembers     []string `json:\"members,omitempty\"`\n   104\t\tADRs        []string `json:\"adr_associations,omitempty\"`\n   105\t\tDiagnostics []string `json:\"diagnostics,omitempty\"`\n   106\t}\n   107\t\n   108\t// Review is the literal the closeout receipt records: required or not-required.\n   109\tfunc (d CloseoutReviewDecision) Review() string {\n   110\t\tif d.Required {\n   111\t\t\treturn \"required\"\n   112\t\t}\n   113\t\treturn \"not-required\"\n   114\t}\n   115\t\n   116\t// EvaluateCloseoutReview answers whether an aggregate scope owes its own\n   117\t// review under the adopted policy. A legacy policy returns Adopted=false and\n   118\t// the caller keeps the legacy rule.\n   119\tfunc (s Store) EvaluateCloseoutReview(ref string) (CloseoutReviewDecision, error) {\n   120\t\tpolicy, _, err := s.loadReviewPolicy()\n   121\t\tif err != nil {\n   122\t\t\treturn CloseoutReviewDecision{}, err\n   123\t\t}\n   124\t\treturn s.evaluateCloseoutReview(ref, policy)\n   125\t}\n   126\t\n   127\tfunc (s Store) evaluateCloseoutReview(ref string, policy ReviewPolicy) (CloseoutReviewDecision, error) {\n   128\t\tdecision := CloseoutReviewDecision{Scope: ref, Known: true}\n   129\t\tscope, err := ParseScopeRef(ref)\n   130\t\tif err != nil {\n   131\t\t\treturn decision, err\n   132\t\t}\n   133\t\tif !policy.CloseoutReviewAdopted() || (scope.Kind != \"milestone\" && scope.Kind != \"roadmap\") {\n   134\t\t\treturn decision, nil\n   135\t\t}\n   136\t\tdecision.Adopted = true\n   137\t\tdecision.EvaluatorVersion = CloseoutReviewEvaluatorVersion\n   138\t\tdecision.PolicyKey, decision.PolicyValue = policy.CloseoutReviewSetting(scope.Kind)\n   139\t\tslug := scope.Roadmap\n   140\t\tif scope.Kind == \"roadmap\" {\n   141\t\t\tslug = scope.Slug\n   142\t\t}\n   143\t\trm, err := s.GetRoadmap(slug)\n   144\t\tif err != nil {\n   145\t\t\treturn decision, err\n   146\t\t}\n   147\t\tproject, projectErr := s.WriteProjectID()\n   148\t\tvar raws []string\n   149\t\tif scope.Kind == \"milestone\" {\n   150\t\t\tfound := false\n   151\t\t\tfor _, milestone := range rm.Milestones {\n   152\t\t\t\tif milestone.ID == scope.Milestone {\n   153\t\t\t\t\traws, found = milestone.Specs, true\n   154\t\t\t\t}\n   155\t\t\t}\n   156\t\t\tif !found {\n   157\t\t\t\treturn decision, fmt.Errorf(\"pose: milestone %s not found in roadmap %s\", scope.Milestone, scope.Roadmap)\n   158\t\t\t}\n   159\t\t} else {\n   160\t\t\tfor _, milestone := range rm.Milestones {\n   161\t\t\t\traws = append(raws, milestone.Specs...)\n   162\t\t\t}\n   163\t\t}\n   164\t\tif projectErr != nil {\n   165\t\t\tdecision.Diagnostics = append(decision.Diagnostics, \"the project identity that qualifies local members is unknown: \"+projectErr.Error())\n   166\t\t} else {\n   167\t\t\tdecision.Members, decision.Diagnostics = s.closeoutCanonicalMembers(raws, project)\n   168\t\t}\n   169\t\tif len(decision.Diagnostics) > 0 {\n   170\t\t\tdecision.Known = false\n   171\t\t}\n   172\t\tmembers := len(decision.Members)\n   173\t\tswitch decision.PolicyValue {\n   174\t\tcase CloseoutReviewNever:\n   175\t\t\tdecision.Required = false\n   176\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, never required\", members)\n   177\t\t\t// never decides without counting, but a member it cannot resolve is\n   178\t\t\t// still a scope it cannot close.\n   179\t\t\treturn decision, nil\n   180\t\tcase CloseoutReviewAlways:\n   181\t\t\tdecision.Required = true\n   182\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, always required\", members)\n   183\t\t\treturn decision, nil\n   184\t\t}\n   185\t\tif !decision.Known {\n   186\t\t\tdecision.Required = true\n   187\t\t\tdecision.Reason = \"members unknown; an exemption needs every member resolved\"\n   188\t\t\treturn decision, nil\n   189\t\t}\n   190\t\tif scope.Kind == \"milestone\" {\n   191\t\t\tdecision.Required = members > closeoutMilestoneMemberThreshold\n   192\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d\", members, closeoutMilestoneMemberThreshold)\n   193\t\t\treturn decision, nil\n   194\t\t}\n   195\t\t// The associations are resolved even below the member threshold: an\n   196\t\t// association input that cannot be read never proves an exemption.\n   197\t\tadrs, diagnostics := s.closeoutADRAssociations(rm, project)\n   198\t\tdecision.ADRs = adrs\n   199\t\tif len(diagnostics) > 0 {\n   200\t\t\tdecision.Diagnostics = append(decision.Diagnostics, diagnostics...)\n   201\t\t\tdecision.Known = false\n   202\t\t\tdecision.Required = true\n   203\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d, adr associations unknown\", members, closeoutRoadmapMemberThreshold)\n   204\t\t\treturn decision, nil\n   205\t\t}\n   206\t\tdecision.Required = members > closeoutRoadmapMemberThreshold && len(adrs) > 0\n   207\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d, adrs=%d\", members, closeoutRoadmapMemberThreshold, len(adrs))\n   208\t\treturn decision, nil\n   209\t}\n   210\t\n   211\t// closeoutCanonicalMembers resolves milestone members to their final\n   212\t// identities, xref:<project>/spec:<slug>, sorted and deduplicated. A local\n   213\t// member follows only a verified transfer redirect; an external one is\n   214\t// resolved by the federated resolver or stays unknown. Unknown members are\n   215\t// diagnostics, never a count of zero.\n   216\tfunc (s Store) closeoutCanonicalMembers(raws []string, project string) ([]string, []string) {\n   217\t\tseen := map[string]bool{}\n   218\t\tmembers, diagnostics := []string{}, []string{}\n   219\t\tfor _, raw := range raws {\n   220\t\t\tidentity, diagnostic := s.closeoutCanonicalMember(strings.TrimSpace(raw), project)\n   221\t\t\tif diagnostic != \"\" {\n   222\t\t\t\tdiagnostics = append(diagnostics, diagnostic)\n   223\t\t\t\tcontinue\n   224\t\t\t}\n   225\t\t\tif !seen[identity] {\n   226\t\t\t\tseen[identity] = true\n   227\t\t\t\tmembers = append(members, identity)\n   228\t\t\t}\n   229\t\t}\n   230\t\tsort.Strings(members)\n   231\t\treturn members, diagnostics\n   232\t}\n   233\t\n   234\tfunc (s Store) closeoutCanonicalMember(raw, project string) (string, string) {\n   235\t\tref, err := ParseArtifactRef(raw)\n   236\t\tif err != nil || ref.Kind != \"spec\" || ref.Milestone != \"\" {\n   237\t\t\treturn \"\", fmt.Sprintf(\"member %q is not a spec reference\", raw)\n   238\t\t}\n   239\t\tif ref.Project == \"\" {\n   240\t\t\tref.Project = project\n   241\t\t}\n   242\t\tresolve := func(why string) (string, string) {\n   243\t\t\tif s.FederatedResolver == nil {\n   244\t\t\t\treturn \"\", fmt.Sprintf(\"member %s %s and no federated resolver is bound to follow it\", ref.String(), why)\n   245\t\t\t}\n   246\t\t\tresolved := s.FederatedResolver.Resolve(project, ref.String())\n   247\t\t\tif !resolved.Resolved {\n   248\t\t\t\treturn \"\", fmt.Sprintf(\"member %s did not resolve: %s\", ref.String(), resolved.State)\n   249\t\t\t}\n   250\t\t\tif resolved.CanonicalIdentity != nil {\n   251\t\t\t\treturn resolved.CanonicalIdentity.String(), \"\"\n   252\t\t\t}\n   253\t\t\treturn resolved.Identity.String(), \"\"\n   254\t\t}\n   255\t\tif ref.Project != project {\n   256\t\t\treturn resolve(\"belongs to another project\")\n   257\t\t}\n   258\t\t_, found, err := readSpecTransferRedirect(s.fsys(), s, ref)\n   259\t\tif err != nil {\n   260\t\t\treturn \"\", fmt.Sprintf(\"member %s has an unverifiable redirect: %v\", ref.String(), err)\n   261\t\t}\n   262\t\tif found {\n   263\t\t\t// The resolver follows the whole chain, with its cycle and depth\n   264\t\t\t// limits and the destination's authorization: the immediate\n   265\t\t\t// destination may itself have moved.\n   266\t\t\treturn resolve(\"was transferred\")\n   267\t\t}\n   268\t\tif _, err := s.GetSpec(ref.Slug); err != nil {\n   269\t\t\treturn \"\", fmt.Sprintf(\"member %s names no spec of this project\", ref.String())\n   270\t\t}\n   271\t\treturn ref.String(), \"\"\n   272\t}\n   273\t\n   274\t// CloseoutMemberTarget resolves a milestone member to the spec whose closeout\n   275\t// stands for it, as the closeout review policy counts it: a local member a\n   276\t// verified transfer moved is followed to its canonical destination, which is\n   277\t// local (its slug) or external (its identity, judged by federated\n   278\t// acceptance). A redirect that cannot be followed is reported, never read as\n   279\t// the redirect stub the transfer left behind (review round 6, N24).\n   280\tfunc (s Store) CloseoutMemberTarget(raw string) (string, bool, string) {\n   281\t\tslug, external := s.milestoneMember(raw)\n   282\t\tif external {\n   283\t\t\treturn slug, true, \"\"\n   284\t\t}\n   285\t\t// The project the store is bound to, as milestoneMember reads a\n   286\t\t// qualified member, else the one the root declares.\n   287\t\tproject := s.FederatedProjectID\n   288\t\tif project == \"\" {\n   289\t\t\tid, err := s.WriteProjectID()\n   290\t\t\tif err != nil {\n   291\t\t\t\treturn \"\", false, \"member \" + raw + \" cannot be resolved: \" + err.Error()\n   292\t\t\t}\n   293\t\t\tproject = id\n   294\t\t}\n   295\t\t_, found, err := readSpecTransferRedirect(s.fsys(), s, ArtifactRef{Project: project, Kind: \"spec\", Slug: slug})\n   296\t\tif err != nil {\n   297\t\t\treturn \"\", false, \"member \" + raw + \" has an unverifiable redirect: \" + err.Error()\n   298\t\t}\n   299\t\tif !found {\n   300\t\t\treturn slug, false, \"\"\n   301\t\t}\n   302\t\tif s.FederatedResolver == nil || s.FederatedResolver.Roots == nil {\n   303\t\t\tresolver, _, err := EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n   304\t\t\tif err != nil {\n   305\t\t\t\treturn \"\", false, \"member \" + raw + \" was transferred and no resolver can follow it: \" + err.Error()\n   306\t\t\t}\n   307\t\t\ts.FederatedResolver = &resolver\n   308\t\t}\n   309\t\tcanonical, diagnostic := s.closeoutCanonicalMember(strings.TrimSpace(raw), project)\n   310\t\tif diagnostic != \"\" {\n   311\t\t\treturn \"\", false, diagnostic\n   312\t\t}\n   313\t\tref, err := ParseArtifactRef(canonical)\n   314\t\tif err != nil {\n   315\t\t\treturn \"\", false, \"member \" + raw + \" resolved to \" + canonical + \", which is not a spec reference\"\n   316\t\t}\n   317\t\tif ref.Project == \"\" || ref.Project == project {\n   318\t\t\treturn ref.Slug, false, \"\"\n   319\t\t}\n   320\t\treturn canonical, true, \"\"\n   321\t}\n   322\t\n   323\t// AggregateDependencyClosed reports whether a resolved dependency on a\n   324\t// milestone or roadmap is closed, beyond the status its members give it:\n   325\t// under the closeout review policy its owning project adopted, only the\n   326\t// terminal projection closes it (an explicit close with its receipt, or a\n   327\t// verified closure from before adoption). A spec, or an aggregate scope of a\n   328\t// project still on the legacy rule, keeps its status contract. A transferred\n   329\t// artifact is judged at its canonical destination; a project whose store or\n   330\t// policy cannot be read is not proven closed (review round 7, N27).\n   331\tfunc (s Store) AggregateDependencyClosed(resolver ArtifactResolver, localProject string, resolved ArtifactResolution) (bool, string) {\n   332\t\tidentity := resolved.Identity\n   333\t\tif resolved.CanonicalIdentity != nil {\n   334\t\t\tidentity = *resolved.CanonicalIdentity\n   335\t\t}\n   336\t\tif identity.Kind != \"milestone\" && identity.Kind != \"roadmap\" {\n   337\t\t\treturn true, \"\"\n   338\t\t}\n   339\t\tif identity.Project == \"\" {\n   340\t\t\tidentity.Project = localProject\n   341\t\t}\n   342\t\tscope := localFederatedScope(identity)\n   343\t\towner := s\n   344\t\tif identity.Project != localProject {\n   345\t\t\tif resolver.Roots == nil {\n   346\t\t\t\treturn false, scope + \" of \" + identity.Project + \" cannot be checked for its close: project roots are unavailable\"\n   347\t\t\t}\n   348\t\t\tsource, err := resolver.Roots.StoreFor(identity.Project)\n   349\t\t\tif err != nil {\n   350\t\t\t\treturn false, scope + \" of \" + identity.Project + \" cannot be checked for its close: \" + projectResolutionState(err)\n   351\t\t\t}\n   352\t\t\tsource = resolver.withSpecSnapshot(identity.Project, source)\n   353\t\t\tsource.closeoutChain = s.closeoutChain\n   354\t\t\towner = source\n   355\t\t}\n   356\t\tif owner.FederatedResolver == nil {\n   357\t\t\towner.FederatedProjectID, owner.FederatedResolver = identity.Project, &resolver\n   358\t\t}\n   359\t\tadopted, err := owner.closeoutReviewPolicyAdopted()\n   360\t\tif err != nil {\n   361\t\t\treturn false, scope + \" cannot be checked for its close: \" + err.Error()\n   362\t\t}\n   363\t\tif !adopted || owner.localScopeClosed(scope) {\n   364\t\t\treturn true, \"\"\n   365\t\t}\n   366\t\treturn false, scope + \" is reached but not closed: `pose close \" + scope + \"` publishes its closeout receipt\"\n   367\t}\n   368\t\n   369\t// canonicalMember is milestoneMember after transfer redirects: a local member\n   370\t// a transfer moved is its canonical destination, local or external. A\n   371\t// redirect that cannot be followed reads as external, so no local consumer\n   372\t// judges the redirect stub and federated proof fails closed on it (review\n   373\t// round 9, N33).\n   374\tfunc (s Store) canonicalMember(raw string) (string, bool) {\n   375\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n   376\t\tif unresolved != \"\" {\n   377\t\t\treturn raw, true\n   378\t\t}\n   379\t\treturn slug, external\n   380\t}\n   381\t\n   382\t// localScopeClosed reports a local milestone or roadmap a dependency edge\n   383\t// names as closed by the terminal projection, under an adopted closeout\n   384\t// review policy where status alone never closes it. A scope already asking\n   385\t// along the chain is a cycle and is not proven closed.\n   386\tfunc (s Store) localScopeClosed(scope string) bool {\n   387\t\tfor _, asking := range s.closeoutChain {\n   388\t\t\tif asking == scope {\n   389\t\t\t\treturn false\n   390\t\t\t}\n   391\t\t}\n   392\t\ts.closeoutChain = append(append([]string{}, s.closeoutChain...), scope)\n   393\t\tclosed, err := s.closedByReceipt(scope)\n   394\t\treturn err == nil && closed\n   395\t}\n   396\t\n   397\t// CurrentCloseoutDecision is the decision for an open aggregate scope now:\n   398\t// the evaluator, then every protection that can only make it stronger. It is\n   399\t// what close judges before publishing and again inside the protected region.\n   400\tfunc (s Store) CurrentCloseoutDecision(ref string) (CloseoutReviewDecision, error) {\n   401\t\tpolicy, _, err := s.loadReviewPolicy()\n   402\t\tif err != nil {\n   403\t\t\treturn CloseoutReviewDecision{}, err\n   404\t\t}\n   405\t\treturn s.currentCloseoutDecision(ref, policy)\n   406\t}\n   407\t\n   408\tfunc (s Store) currentCloseoutDecision(ref string, policy ReviewPolicy) (CloseoutReviewDecision, error) {\n   409\t\tdecision, err := s.evaluateCloseoutReview(ref, policy)\n   410\t\tif err != nil || !decision.Adopted || decision.Required {\n   411\t\t\treturn decision, err\n   412\t\t}\n   413\t\tscope, _ := ParseScopeRef(ref)\n   414\t\ts.protectCloseoutDecision(scope, &decision)\n   415\t\tif !decision.Required && s.mandatoryHumanReview(ref, scope.Kind, policy) {\n   416\t\t\tdecision.Required = true\n   417\t\t\tdecision.Reason += \"; a mandatory-human review is never dispensed\"\n   418\t\t}\n   419\t\treturn decision, nil\n   420\t}\n   421\t\n   422\t// mandatoryHumanReview reports a scope whose effective review plan asks for a\n   423\t// human reviewer: the base profile, the overlays the plan selects for it with\n   424\t// their cutoffs, and the protected baseline when the scope changes the review\n   425\t// contract, exactly as the plan composes them. No setting dispenses that\n   426\t// review. A plan that cannot be built is treated as asking for one, unless the\n   427\t// policy names no profile for the kind, where no review can be asked at all.\n   428\tfunc (s Store) mandatoryHumanReview(ref, kind string, policy ReviewPolicy) bool {\n   429\t\tif policy.ReviewerIndependence[kind] == \"mandatory-human\" {\n   430\t\t\treturn true\n   431\t\t}\n   432\t\tif policy.Profiles[kind] == \"\" {\n   433\t\t\t// No profile, no review to ask for, unless the scope itself removed\n   434\t\t\t// the profile: then the contract it changes cannot exempt it.\n   435\t\t\tscope, err := ParseScopeRef(ref)\n   436\t\t\treturn err != nil || len(s.resolveReviewGovernanceGuard(scope).Paths) > 0\n   437\t\t}\n   438\t\tplanner := s\n   439\t\tplanner.planWithoutCloseoutGate = true\n   440\t\tplan, err := planner.ReviewPlan(ref)\n   441\t\tif err != nil || plan.Independence == \"mandatory-human\" {\n   442\t\t\treturn true\n   443\t\t}\n   444\t\t// The plan composes the overlays' independence; the base profile's own is\n   445\t\t// read from the profile the plan named.\n   446\t\tbase, _, err := s.loadReviewProfile(plan.BaseProfile)\n   447\t\treturn err != nil || base.Independence == \"mandatory-human\"\n   448\t}\n   449\t\n   450\t// milestoneExitGateCriterionID names the criterion that carries a\n   451\t// milestone's exit gate into a member's review.\n   452\tfunc milestoneExitGateCriterionID(roadmap, milestone string) string {\n   453\t\treturn \"milestone-exit-gate-\" + roadmap + \"-\" + milestone\n   454\t}\n   455\t\n   456\tfunc milestoneExitGateCriterionDescription(roadmap, milestone, gate string) string {\n   457\t\treturn \"The exit gate of milestone:\" + roadmap + \"/\" + milestone + \" holds: \" + gate\n   458\t}\n   459\t\n   460\t// lastOpenMemberOf reports a spec that, under an adopted closeout review\n   461\t// policy, carries its multi-member milestone's exit gate into its own review:\n   462\t// it is a local member and every other member is terminal, so its review is\n   463\t// the last one of the milestone. A member of another project is never known\n   464\t// terminal here, so the gate is not carried and the milestone needs its own\n   465\t// review to judge it.\n   466\tfunc (s Store) lastOpenMemberOf(roadmap string, milestone Milestone, slug string) bool {\n   467\t\tif len(milestone.Specs) < 2 {\n   468\t\t\treturn false\n   469\t\t}\n   470\t\tmember := false\n   471\t\tfor _, raw := range milestone.Specs {\n   472\t\t\tother, external := s.canonicalMember(raw)\n   473\t\t\tif external {\n   474\t\t\t\treturn false\n   475\t\t\t}\n   476\t\t\tother = strings.TrimPrefix(other, \"spec:\")\n   477\t\t\tif other == slug {\n   478\t\t\t\tmember = true\n   479\t\t\t\tcontinue\n   480\t\t\t}\n   481\t\t\tsp, err := s.GetSpec(other)\n   482\t\t\tif err != nil || !terminalStatuses[sp.Status] {\n   483\t\t\t\treturn false\n   484\t\t\t}\n   485\t\t}\n   486\t\treturn member\n   487\t}\n   488\t\n   489\t// exitGateJudgedByMember reports a multi-member milestone whose exit gate an\n   490\t// approved member review judged: the member's governing bundle carried the\n   491\t// gate's criterion with the gate as it reads now. A gate edited after that\n   492\t// review is judged by nobody yet.\n   493\tfunc (s Store) exitGateJudgedByMember(roadmap string, milestone Milestone, children []CloseoutState) bool {\n   494\t\tid := milestoneExitGateCriterionID(roadmap, milestone.ID)\n   495\t\tdescription := milestoneExitGateCriterionDescription(roadmap, milestone.ID, milestone.ExitGate)\n   496\t\tfor _, child := range children {\n   497\t\t\tif !child.Review.Approved || child.Review.BundleID == \"\" {\n   498\t\t\t\tcontinue\n   499\t\t\t}\n   500\t\t\tbundle, err := s.LoadReviewBundle(child.Review.BundleID)\n   501\t\t\tif err != nil {\n   502\t\t\t\tcontinue\n   503\t\t\t}\n   504\t\t\tfor _, criterion := range bundle.Payload.Plan.Criteria {\n   505\t\t\t\tif criterion.ID == id && criterion.Description == description && criterion.Required {\n   506\t\t\t\t\treturn true\n   507\t\t\t\t}\n   508\t\t\t}\n   509\t\t}\n   510\t\treturn false\n   511\t}\n   512\t\n   513\tfunc (s Store) milestoneExitGate(scope ScopeRef) string {\n   514\t\trm, err := s.GetRoadmap(scope.Roadmap)\n   515\t\tif err != nil {\n   516\t\t\treturn \"unknown\"\n   517\t\t}\n   518\t\tfor _, milestone := range rm.Milestones {\n   519\t\t\tif milestone.ID == scope.Milestone {\n   520\t\t\t\treturn strings.TrimSpace(milestone.ExitGate)\n   521\t\t\t}\n   522\t\t}\n   523\t\treturn \"unknown\"\n   524\t}\n   525\t\n   526\t// closeoutReviewGate is the one place the readers of an approval ask whether\n   527\t// an aggregate scope owes its own review under an adopted policy. It returns\n   528\t// the decision that governs the scope and whether its own review is dispensed.\n   529\t//\n   530\t// Order (spec pose-closeout-review-policy-by-cost-benefit, \"One evaluator and\n   531\t// precedence\"): a receipt already published decides by what it recorded, as\n   532\t// long as the scope it closed is still the scope; a roadmap closed before\n   533\t// adoption keeps its sealed contract (nil decision); an open scope is decided\n   534\t// now. A review recorded on the scope, required or not, is never bypassed: it\n   535\t// is verified as before and its veto stands. An unknown input never exempts.\n   536\tfunc (s Store) closeoutReviewGate(ref string, policy ReviewPolicy) (*CloseoutReviewDecision, bool, error) {\n   537\t\tif !policy.CloseoutReviewAdopted() {\n   538\t\t\treturn nil, false, nil\n   539\t\t}\n   540\t\tscope, err := ParseScopeRef(ref)\n   541\t\tif err != nil || (scope.Kind != \"milestone\" && scope.Kind != \"roadmap\") {\n   542\t\t\treturn nil, false, err\n   543\t\t}\n   544\t\treceipt, err := s.ReadCloseoutReceipt(ref)\n   545\t\tif err != nil {\n   546\t\t\treturn nil, false, err\n   547\t\t}\n   548\t\tif receipt != nil {\n   549\t\t\tif err := s.closeoutReceiptStands(*receipt, policy); err != nil {\n   550\t\t\t\treturn nil, false, err\n   551\t\t\t}\n   552\t\t\tdecision := receipt.Decision\n   553\t\t\treturn &decision, !decision.Required && !s.scopeReviewRecorded(ref), nil\n   554\t\t}\n   555\t\tif s.closeoutScopeHistorical(scope) || s.milestoneClosedBeforeAdoption(scope) {\n   556\t\t\treturn nil, false, nil\n   557\t\t}\n   558\t\tdecision, err := s.currentCloseoutDecision(ref, policy)\n   559\t\tif err != nil {\n   560\t\t\treturn nil, false, err\n   561\t\t}\n   562\t\treturn &decision, !decision.Required && decision.Known && !s.scopeReviewRecorded(ref), nil\n   563\t}\n   564\t\n   565\t// closeoutReceiptStands checks a receipt against the scope it closed: the\n   566\t// same canonical members. A receipt is never re-decided under a later policy,\n   567\t// but it does not carry over to a scope whose composition changed.\n   568\tfunc (s Store) closeoutReceiptStands(receipt CloseoutReceipt, policy ReviewPolicy) error {\n   569\t\t// The closed contract, read without the current policy: a later policy\n   570\t\t// never re-decides a receipt, but a scope whose composition or exit gate\n   571\t\t// changed is no longer the scope it closed.\n   572\t\tmembers, gate, diagnostics, err := s.closeoutSubject(receipt.Scope)\n   573\t\tif err != nil {\n   574\t\t\treturn fmt.Errorf(\"pose: closeout receipt of %s cannot be checked against its scope: %w\", receipt.Scope, err)\n   575\t\t}\n   576\t\tif len(diagnostics) > 0 {\n   577\t\t\treturn fmt.Errorf(\"pose: closeout receipt of %s cannot be checked against its scope: %s\", receipt.Scope, strings.Join(diagnostics, \"; \"))\n   578\t\t}\n   579\t\tdrift := func(what string) error {\n   580\t\t\treturn fmt.Errorf(\"pose: closeout receipt of %s no longer matches its scope: its %s changed since the close; a receipt is never rewritten, so restore it or record the change in a new scope\", receipt.Scope, what)\n   581\t\t}\n   582\t\tif strings.Join(members, \",\") != strings.Join(receipt.Decision.Members, \",\") {\n   583\t\t\treturn drift(fmt.Sprintf(\"members (closed with %v, now %v)\", receipt.Decision.Members, members))\n   584\t\t}\n   585\t\tif receipt.ExitGateDigest != gate {\n   586\t\t\treturn drift(\"exit gate\")\n   587\t\t}\n   588\t\treturn nil\n   589\t}\n   590\t\n   591\t// protectCloseoutDecision restores the review when the scope itself changes\n   592\t// the review contract: an exemption the diff introduced cannot exempt the diff.\n   593\t// The decision is made a second time under the policy at the change set's base\n   594\t// revision, and a stronger answer there wins. Protection that cannot be\n   595\t// established keeps the review required.\n   596\tfunc (s Store) protectCloseoutDecision(scope ScopeRef, decision *CloseoutReviewDecision) {\n   597\t\tguard := s.resolveReviewGovernanceGuard(scope)\n   598\t\tif len(guard.Paths) == 0 {\n   599\t\t\treturn\n   600\t\t}\n   601\t\trestore := func(reason string) {\n   602\t\t\tdecision.Required = true\n   603\t\t\tdecision.Reason += \"; \" + reason\n   604\t\t}\n   605\t\tif guard.Revision == \"\" {\n   606\t\t\trestore(\"the scope changes the review contract and no protected baseline resolves: \" + guard.Reason)\n   607\t\t\treturn\n   608\t\t}\n   609\t\tbase, err := s.parseReviewPolicyAt(guard.Revision)\n   610\t\tif err != nil {\n   611\t\t\trestore(\"the protected baseline policy cannot be read: \" + err.Error())\n   612\t\t\treturn\n   613\t\t}\n   614\t\tif !base.Enabled && !base.CloseoutReviewAdopted() {\n   615\t\t\treturn\n   616\t\t}\n   617\t\tif base.ReviewerIndependence[scope.Kind] == \"mandatory-human\" {\n   618\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires a mandatory-human review\")\n   619\t\t\treturn\n   620\t\t}\n   621\t\t// The baseline's base profile and every overlay it adopted for this kind,\n   622\t\t// selected or not: protection is the conservative reading.\n   623\t\trefs := append([]string{}, base.OverlayProfiles...)\n   624\t\tif ref := base.Profiles[scope.Kind]; ref != \"\" {\n   625\t\t\trefs = append(refs, ref)\n   626\t\t}\n   627\t\tfor _, ref := range refs {\n   628\t\t\tprofile, err := s.parseReviewProfileAt(guard.Revision, ref)\n   629\t\t\tif err != nil || (profile.Scope == scope.Kind || ref == base.Profiles[scope.Kind]) && profile.Independence == \"mandatory-human\" {\n   630\t\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires a mandatory-human review or a profile of it cannot be read\")\n   631\t\t\t\treturn\n   632\t\t\t}\n   633\t\t}\n   634\t\tif !base.CloseoutReviewAdopted() {\n   635\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" keeps the legacy rule, under which this scope owes its review\")\n   636\t\t\treturn\n   637\t\t}\n   638\t\tprotected, err := s.evaluateCloseoutReview(decision.Scope, base)\n   639\t\tif err != nil || protected.Required {\n   640\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires the review (\" + protected.PolicyKey + \"=\" + protected.PolicyValue + \")\")\n   641\t\t}\n   642\t}\n   643\t\n   644\t// closeoutSubject is what a closeout receipt binds: the canonical members of\n   645\t// the scope and, for a milestone, the digest of its exit gate (a roadmap's is\n   646\t// the gates of its milestones, which their own receipts bind).\n   647\tfunc (s Store) closeoutSubject(ref string) ([]string, string, []string, error) {\n   648\t\tscope, err := ParseScopeRef(ref)\n   649\t\tif err != nil {\n   650\t\t\treturn nil, \"\", nil, err\n   651\t\t}\n   652\t\tslug := scope.Roadmap\n   653\t\tif scope.Kind == \"roadmap\" {\n   654\t\t\tslug = scope.Slug\n   655\t\t}\n   656\t\trm, err := s.GetRoadmap(slug)\n   657\t\tif err != nil {\n   658\t\t\treturn nil, \"\", nil, err\n   659\t\t}\n   660\t\tproject, err := s.WriteProjectID()\n   661\t\tif err != nil {\n   662\t\t\treturn nil, \"\", []string{\"the project identity is unknown: \" + err.Error()}, nil\n   663\t\t}\n   664\t\tvar raws []string\n   665\t\tgate := \"\"\n   666\t\tfor _, milestone := range rm.Milestones {\n   667\t\t\tif scope.Kind == \"milestone\" && milestone.ID != scope.Milestone {\n   668\t\t\t\tcontinue\n   669\t\t\t}\n   670\t\t\traws = append(raws, milestone.Specs...)\n   671\t\t\tif scope.Kind == \"milestone\" {\n   672\t\t\t\tgate = digestText(milestone.ExitGate)\n   673\t\t\t}\n   674\t\t}\n   675\t\tif scope.Kind == \"roadmap\" {\n   676\t\t\t// A roadmap's gate is its cut criteria; its milestones' gates are\n   677\t\t\t// bound by their own receipts.\n   678\t\t\tcriteria, problems := ParseRoadmapCriteria(*rm)\n   679\t\t\traw, _ := json.Marshal(struct {\n   680\t\t\t\tCriteria []RoadmapCriterion\n   681\t\t\t\tProblems []string\n   682\t\t\t}{criteria, problems})\n   683\t\t\tgate = \"sha256:\" + digestHex(raw)\n   684\t\t}\n   685\t\tmembers, diagnostics := s.closeoutCanonicalMembers(raws, project)\n   686\t\treturn members, gate, diagnostics, nil\n   687\t}\n   688\t\n   689\t// closeoutScopeHistorical reports a scope whose roadmap was closed before\n   690\t// adoption: done, with no receipt and no close of this engine in progress,\n   691\t// and with positive evidence of its legacy closure: an approval recorded on\n   692\t// the roadmap, or the legacy rule exempting it as done before review\n   693\t// adoption. Status alone proves nothing.\n   694\t// Its milestones and itself are verified by the contract they were sealed\n   695\t// under, never re-evaluated, and no receipt is backfilled for them. A close\n   696\t// interrupted between its status and its receipt left an intent, so it stays\n   697\t// incomplete instead of reading as history.\n   698\tfunc (s Store) closeoutScopeHistorical(scope ScopeRef) bool {\n   699\t\tslug := scope.Slug\n   700\t\tif scope.Kind == \"milestone\" {\n   701\t\t\tslug = scope.Roadmap\n   702\t\t}\n   703\t\trm, err := s.GetRoadmap(slug)\n   704\t\tif err != nil || rm.Status != \"done\" {\n   705\t\t\treturn false\n   706\t\t}\n   707\t\tref := \"roadmap:\" + slug\n   708\t\tif receipt, err := s.ReadCloseoutReceipt(ref); err != nil || receipt != nil {\n   709\t\t\treturn false\n   710\t\t}\n   711\t\tpending, err := s.closeoutIntentPending(ref)\n   712\t\tif err != nil || pending {\n   713\t\t\treturn false\n   714\t\t}\n   715\t\tpolicy, _, err := s.loadReviewPolicy()\n   716\t\tif err != nil {\n   717\t\t\treturn false\n   718\t\t}\n   719\t\tif required, err := s.reviewRequiredForScope(ScopeRef{Kind: \"roadmap\", Slug: slug}, policy); err == nil && !required {\n   720\t\t\treturn true\n   721\t\t}\n   722\t\trecorded, refused, err := s.milestonesWithRecordedApproval([]string{ref})\n   723\t\treturn err == nil && recorded[ref] && !refused[ref]\n   724\t}\n   725\t\n   726\t// milestoneClosedBeforeAdoption reports a milestone with positive terminal\n   727\t// evidence from before adoption: its own approved review, sealed under a\n   728\t// policy that had not adopted the closeout pair. A milestone merely reached\n   729\t// has no such record and owes its close.\n   730\tfunc (s Store) milestoneClosedBeforeAdoption(scope ScopeRef) bool {\n   731\t\tif scope.Kind != \"milestone\" {\n   732\t\t\treturn false\n   733\t\t}\n   734\t\tref := scope.String()\n   735\t\trecorded, refused, err := s.milestonesWithRecordedApproval([]string{ref})\n   736\t\tif err != nil || !recorded[ref] || refused[ref] {\n   737\t\t\treturn false\n   738\t\t}\n   739\t\tlatest, err := s.latestBundlesOf([]string{ref})\n   740\t\tif err != nil || len(latest[ref]) == 0 {\n   741\t\t\treturn false\n   742\t\t}\n   743\t\tfor _, id := range latest[ref] {\n   744\t\t\tbundle, err := s.LoadReviewBundle(id)\n   745\t\t\tif err != nil || bundle.Payload.Plan.CloseoutReview != nil {\n   746\t\t\t\treturn false\n   747\t\t\t}\n   748\t\t}\n   749\t\treturn true\n   750\t}\n   751\t\n   752\t// closedByReceipt reports an aggregate scope that reads closed: a receipt\n   753\t// that still stands for the scope as it is, or, with no receipt, a verified\n   754\t// closure from before adoption (a historical roadmap's scopes, or a milestone\n   755\t// approved under a plan without a closeout decision), never backfilled with a\n   756\t// receipt. Either way the scope must pass the whole terminal verifier closeout\n   757\t// applies: its review, a refusal recorded later, its children, its gates, and\n   758\t// the acceptance of its dependency edges (predecessors, consumed outcomes,\n   759\t// members), local and remote. It is the one terminal projection reached,\n   760\t// roadmap-reached, attention and doctor ask.\n   761\tfunc (s Store) closedByReceipt(ref string) (bool, error) {\n   762\t\tif len(s.closeoutChain) == 0 || s.closeoutChain[len(s.closeoutChain)-1] != ref {\n   763\t\t\ts.closeoutChain = append(append([]string{}, s.closeoutChain...), ref)\n   764\t\t}\n   765\t\treceipt, err := s.ReadCloseoutReceipt(ref)\n   766\t\tif err != nil {\n   767\t\t\treturn false, err\n   768\t\t}\n   769\t\tif receipt != nil {\n   770\t\t\tpolicy, _, err := s.loadReviewPolicy()\n   771\t\t\tif err != nil {\n   772\t\t\t\treturn false, err\n   773\t\t\t}\n   774\t\t\tif s.closeoutReceiptStands(*receipt, policy) != nil {\n   775\t\t\t\treturn false, nil\n   776\t\t\t}\n   777\t\t} else {\n   778\t\t\tscope, err := ParseScopeRef(ref)\n   779\t\t\tif err != nil {\n   780\t\t\t\treturn false, err\n   781\t\t\t}\n   782\t\t\tif !s.closeoutScopeHistorical(scope) && !s.milestoneClosedBeforeAdoption(scope) {\n   783\t\t\t\treturn false, nil\n   784\t\t\t}\n   785\t\t}\n   786\t\treturn s.closeoutTerminalWithDependencies(ref), nil\n   787\t}\n   788\t\n   789\t// closeoutTerminalWithDependencies runs the terminal verifier with dependency\n   790\t// acceptance, through the store's bound resolver or, without one, the\n   791\t// resolver the environment binds to this root, as `pose close` does. A\n   792\t// resolver that cannot be built leaves the edges unjudged, so the scope does\n   793\t// not read closed. Same-project edges are judged by their lifecycle and\n   794\t// revision, without recursion into their closeout, and remote recursion stops\n   795\t// at a cycle, so the projection converges.\n   796\tfunc (s Store) closeoutTerminalWithDependencies(ref string) bool {\n   797\t\tif s.FederatedResolver == nil || s.FederatedResolver.Roots == nil {\n   798\t\t\tresolver, project, err := EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n   799\t\t\tif err != nil {\n   800\t\t\t\treturn false\n   801\t\t\t}\n   802\t\t\ts.FederatedProjectID, s.FederatedResolver = project, &resolver\n   803\t\t}\n   804\t\tstate, err := s.getCloseoutState(ref, true)\n   805\t\treturn err == nil && state.Terminal\n   806\t}\n   807\t\n   808\t// receiptStandsFor reports a closeout receipt on file that still stands for\n   809\t// the scope as it is. It reads no terminal state, so the review verification\n   810\t// can ask it without recursing into closeout.\n   811\tfunc (s Store) receiptStandsFor(ref string) bool {\n   812\t\treceipt, err := s.ReadCloseoutReceipt(ref)\n   813\t\tif err != nil || receipt == nil {\n   814\t\t\treturn false\n   815\t\t}\n   816\t\tpolicy, _, err := s.loadReviewPolicy()\n   817\t\treturn err == nil && s.closeoutReceiptStands(*receipt, policy) == nil\n   818\t}\n   819\t\n   820\t// scopeReviewRecorded reports a review of the scope on file: a bundle or a\n   821\t// legacy attempt. A record that cannot be read counts as recorded, so an\n   822\t// unreadable rejection never turns into an exemption.\n   823\tfunc (s Store) scopeReviewRecorded(ref string) bool {\n   824\t\tbundles, err := s.ReadReviewBundles(ref)\n   825\t\tif err != nil || len(bundles.Bundles) > 0 || !bundles.Coverage.CompleteFor(ref) {\n   826\t\t\treturn true\n   827\t\t}\n   828\t\tattempts, err := s.ReadReviewAttempts(ref)\n   829\t\treturn err != nil || len(attempts.Attempts) > 0 || !attempts.Coverage.CompleteFor(ref)\n   830\t}\n   831\t\n   832\t// closeoutApprovalOrigin is the origin an exempt scope's approval reports.\n   833\tfunc closeoutApprovalOrigin(decision CloseoutReviewDecision) string {\n   834\t\treturn \"not-required:\" + decision.PolicyKey + \"=\" + decision.PolicyValue\n   835\t}\n   836\t\n   837\tfunc closeoutExemptionWarning(ref string, decision CloseoutReviewDecision) string {\n   838\t\treturn \"review: not-required for \" + ref + \" (\" + decision.PolicyKey + \"=\" + decision.PolicyValue + \", \" + decision.Reason + \"); `pose close \" + ref + \"` is still required\"\n   839\t}\n   840\t\n   841\t// CloseoutReviewOwing is an open aggregate scope that owes its own review under\n   842\t// the adopted policy and holds no recorded approval yet, for `pose doctor`.\n   843\ttype CloseoutReviewOwing struct {\n   844\t\tScope    string                 `json:\"scope\"`\n   845\t\tDecision CloseoutReviewDecision `json:\"decision\"`\n   846\t\t// Previous is the rule that applied before, when a recorded input shows\n   847\t\t// it; with no snapshot it says the comparison is unknown.\n   848\t\tPrevious string `json:\"previous\"`\n   849\t\tAction   string `json:\"action\"`\n   850\t}\n   851\t\n   852\t// CloseoutReviewsOwed lists the open milestones and roadmaps that, under the\n   853\t// adopted closeout review policy, owe a review they do not have. A legacy\n   854\t// policy returns nothing. Close remains the authoritative gate.\n   855\tfunc (s Store) CloseoutReviewsOwed() ([]CloseoutReviewOwing, error) {\n   856\t\tpolicy, _, err := s.loadReviewPolicy()\n   857\t\tif err != nil || !policy.CloseoutReviewAdopted() {\n   858\t\t\treturn nil, err\n   859\t\t}\n   860\t\troadmaps, err := s.ListRoadmaps()\n   861\t\tif err != nil {\n   862\t\t\treturn nil, err\n   863\t\t}\n   864\t\trefs := []string{}\n   865\t\tfor _, rm := range roadmaps {\n   866\t\t\tfor _, milestone := range rm.Milestones {\n   867\t\t\t\trefs = append(refs, \"milestone:\"+rm.Slug+\"/\"+milestone.ID)\n   868\t\t\t}\n   869\t\t\trefs = append(refs, \"roadmap:\"+rm.Slug)\n   870\t\t}\n   871\t\towing := []CloseoutReviewOwing{}\n   872\t\tfor _, ref := range refs {\n   873\t\t\tclosed, err := s.closedByReceipt(ref)\n   874\t\t\tif err != nil {\n   875\t\t\t\treturn nil, err\n   876\t\t\t}\n   877\t\t\tif closed {\n   878\t\t\t\tcontinue\n   879\t\t\t}\n   880\t\t\t// A scope closed before adoption is never re-decided under the\n   881\t\t\t// current policy, but its terminal evidence must still stand: one\n   882\t\t\t// that no longer verifies is listed with the check that says why\n   883\t\t\t// (review round 6, N23).\n   884\t\t\tif scope, err := ParseScopeRef(ref); err == nil && (s.closeoutScopeHistorical(scope) || s.milestoneClosedBeforeAdoption(scope)) {\n   885\t\t\t\towing = append(owing, CloseoutReviewOwing{\n   886\t\t\t\t\tScope:    ref,\n   887\t\t\t\t\tDecision: CloseoutReviewDecision{Scope: ref, Adopted: true, Known: true, Required: true, Reason: \"closed before adoption; its sealed closure no longer verifies\"},\n   888\t\t\t\t\tPrevious: \"closed before adoption under the legacy rule\",\n   889\t\t\t\t\tAction:   \"run `pose closeout-check \" + ref + \"` and remediate the review or child it names; the closure is verified by the contract it was sealed under\",\n   890\t\t\t\t})\n   891\t\t\t\tcontinue\n   892\t\t\t}\n   893\t\t\t// The applicable gate, not the current threshold alone: a receipt\n   894\t\t\t// keeps the decision it closed under, and a review recorded on the\n   895\t\t\t// scope anyway stands until it approves (review round 7, N26).\n   896\t\t\tgated, exempt, err := s.closeoutReviewGate(ref, policy)\n   897\t\t\tif err != nil {\n   898\t\t\t\towing = append(owing, CloseoutReviewOwing{Scope: ref, Decision: CloseoutReviewDecision{Scope: ref, Adopted: true, Required: true, Reason: err.Error()}, Previous: \"unknown: no snapshot of the earlier policy or composition is recorded\", Action: \"resolve \" + err.Error()})\n   899\t\t\t\tcontinue\n   900\t\t\t}\n   901\t\t\tif exempt || gated == nil {\n   902\t\t\t\tcontinue\n   903\t\t\t}\n   904\t\t\tdecision := *gated\n   905\t\t\t// A recorded approval counts only while it satisfies the current\n   906\t\t\t// obligation: fresh, for the scope as it is now.\n   907\t\t\tif eval, err := s.ReviewCheck(ref); err == nil && eval.Approved && eval.Fresh {\n   908\t\t\t\tcontinue\n   909\t\t\t}\n   910\t\t\taction := \"seal and review \" + ref + \" (`pose review bundle \" + ref + \" --seal`), then `pose close \" + ref + \"`\"\n   911\t\t\tif !decision.Known {\n   912\t\t\t\taction = \"resolve \" + strings.Join(decision.Diagnostics, \"; \")\n   913\t\t\t}\n   914\t\t\towing = append(owing, CloseoutReviewOwing{Scope: ref, Decision: decision, Previous: \"unknown: no snapshot of the earlier policy or composition is recorded\", Action: action})\n   915\t\t}\n   916\t\treturn owing, nil\n   917\t}\n   918\t\n   919\tfunc mustScope(ref string) ScopeRef {\n   920\t\tscope, _ := ParseScopeRef(ref)\n   921\t\treturn scope\n   922\t}\n","exit_code":0,"status":"completed"}}
