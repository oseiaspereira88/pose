nowledge/2026-09-12-note-cli-output-design-taxonomy.md\n.pose/knowledge/2026-10-13-decision-log-review-assurance-requires-cryptographic-proof.md\n.pose/knowledge/README.md\n.pose/knowledge/2026-08-13-decision-log-adr-component-aware-review-plans-review.md\n","exit_code":0,"status":"completed"}}
