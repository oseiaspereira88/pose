rB); code != 0 {\npose-mcp/internal/cli/cli_test.go:263:\t\t\tt.Fatalf(\"new-roadmap exit=%d err=%s\", code, errB.String())\npose-mcp/internal/cli/usage.go:182:\tcase \"init\", \"new-spec\", \"new-roadmap\", \"new-adr\", \"new-knowledge\", \"followups\", \"amend\", \"adopt\", \"assess\", \"state\",\npose-mcp/internal/cli/cli.go:88:\tcase \"new-roadmap\":\npose-mcp/internal/cli/cli.go:91:\t\t\tfmt.Fprintf(stderr, \"pose new-roadmap: %v\\n\", err)\npose-mcp/internal/cli/cli.go:94:\t\treturn cmdNewRoadmap(root, args, stdout, stderr)\npose-mcp/internal/cli/cli.go:497:  new-roadmap <slug>                  Create a governed roadmap\npose-mcp/internal/cli/cli.go:579:  new-roadmap <slug>                  Cria roadmap governado em .pose/roadmaps/\n","exit_code":0,"status":"completed"}}
