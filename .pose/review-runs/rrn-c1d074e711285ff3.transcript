change-set:cs-602946d7f44a\", \"to\": \"artifact:.pose/review-attempts/ecd57641ffc05db66644952c/000001.json\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:.pose/review-attempts/ecd57641ffc05db66644952c/000001.result.json\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:.pose/review-bundles/rvb-18aeaa6c0a46a548.json\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:.pose/review-bundles/rvb-f627d25d86340cec.json\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:.pose/review-conclusions/rrn-311777f99bcc4f70.json\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:.pose/review-run-ledger/rrn-311777f99bcc4f70.json\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:.pose/review-runs/rrn-311777f99bcc4f70.events.ndjson\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:.pose/review-runs/rrn-311777f99bcc4f70.json\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:.pose/review-runs/rrn-311777f99bcc4f70.transcript\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:.pose/specs/2026-11-17-pose-review-guard-reads-the-integrity-graph-in-place.md\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:.pose/starts/pose-review-guard-reads-the-integrity-graph-in-place.json\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:pose-mcp/internal/pose/delivery_integrity.go\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:pose-mcp/internal/pose/review_dispatch_unix.go\", \"type\": \"changes\"}, {\"from\": \"change-set:cs-602946d7f44a\", \"to\": \"artifact:pose-mcp/internal/pose/review_guard_in_place_test.go\", \"type\": \"changes\"}, {\"fr