{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C2PdUXeXf75P2Lzt4jAeiP","type":"tool_result","content":"595\t\treturn graph\n596\t}\n597\t\n598\t// ScopedDeliveryProvenanceDigest binds evidence only to the claims and change\n599\t// sets consumed by one spec. Adding an unrelated target or change set cannot\n600\t// invalidate historical evidence for this scope.\n601\tfunc ScopedDeliveryProvenanceDigest(graph DeliveryIntegrityGraph, spec string) string {\n602\t\tclaims := []ArtifactClaim{}\n603\t\tsets := []ChangeSet{}\n604\t\tfor _, claim := range graph.Claims {\n605\t\t\tif claim.Spec == spec {\n606\t\t\t\tclaims = append(claims, claim)\n607\t\t\t}\n608\t\t}\n609\t\tfor _, set := range graph.ChangeSets {\n610\t\t\tif set.Spec == spec {\n611\t\t\t\tsets = append(sets, set)\n612\t\t\t}\n613\t\t}\n614\t\tsort.Slice(claims, func(i, j int) bool { return claimKey(claims[i]) < claimKey(claims[j]) })\n615\t\tsort.Slice(sets, func(i, j int) bool { return sets[i].ID < sets[j].ID })\n616\t\traw, _ := json.Marshal(struct {\n617\t\t\tClaims []ArtifactClaim `json:\"claims\"`\n618\t\t\tSets   []ChangeSet     `json:\"change_sets\"`\n619\t\t}{claims, withoutMaterialDigest(sets)})\n620\t\tsum := sha256.Sum256(raw)\n621\t\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n622\t}\n623\t\n624\tfunc deliveryEvidenceCurrent(result DeliveryValidationResult, spec, status string, graph DeliveryIntegrityGraph, sets []ChangeSet) bool {\n625\t\tif bound := result.MaterialProvenance[spec]; bound != \"\" {\n626\t\t\t// A material binding governs: a mismatch is stale, never a fall-through\n627\t\t\t// to the commit-bound rules below. Only a closed spec keeps its exemption.\n628\t\t\tif bound == ScopedMaterialDigest(graph, spec) {\n629\t\t\t\treturn true\n630\t\t\t}\n631\t\t\treturn status == \"done\" && result.GeneratedAt != \"\"\n632\t\t}\n633\t\tif scoped := result.ScopeProvenance[spec]; scoped != \"\" {\n634\t\t\tif scoped == ScopedDeliveryProvenanceDigest(graph, spec) {\n635\t\t\t\treturn true\n636\t\t\t}\n637\t\t\tif status == \"done\" && result.GeneratedAt != \"\" {\n638\t\t\t\treturn true\n639\t\t\t}\n640\t\t\treturn false\n641\t\t}\n642\t\tif result.ProvenanceDigest != \"\" && result.ProvenanceDigest == graph.ProvenanceDigest {\n643\t\t\treturn true\n644\t\t}\n645\t\t// Results emitted before scope_provenance existed were module-wide. Preserve\n646\t\t// them only for already-closed historical specs: their immutable closeout\n647\t\t// cannot retroactively acquire the new field, and unrelated later targets\n648\t\t// must not invalidate them. Open/current scopes never receive this bridge.\n649\t\tif status == \"done\" && result.ProvenanceDigest != \"\" && result.GeneratedAt != \"\" {\n650\t\t\treturn true\n651\t\t}\n652\t\tif result.GitHead == \"\" {\n653\t\t\treturn false\n654\t\t}\n655\t\tfor _, set := range sets {\n656\t\t\tif result.GitHead == set.Head || result.GitHead == set.ResolvedHead {\n657\t\t\t\treturn true\n658\t\t\t}\n659\t\t\tfor _, commit := range set.Commits {\n660\t\t\t\tif result.GitHead == commit {\n661\t\t\t\t\treturn true\n662\t\t\t\t}\n663\t\t\t}\n664\t\t}\n665\t\treturn false\n666\t}\n667\t\n668\tfunc finalizeExtendedDeliveryGraph(graph *DeliveryIntegrityGraph) {\n669\t\tsort.Slice(graph.Nodes, func(i, j int) bool { return graph.Nodes[i].ID < graph.Nodes[j].ID })\n670\t\tsort.Slice(graph.Edges, func(i, j int) bool { return edgeLess(graph.Edges[i], graph.Edges[j]) })\n671\t\tgraph.Edges = dedupeSortedEdges(graph.Edges)\n672\t\tsort.Slice(graph.Findings, func(i, j int) bool { return graph.Findings[i].ID < graph.Findings[j].ID })\n673\t\tsort.Slice(graph.Deliveries, func(i, j int) bool { return graph.Deliveries[i].Ref < graph.Deliveries[j].Ref })\n674\t\tsort.Slice(graph.ValidationResults, func(i, j int) bool { return graph.ValidationResults[i].ID < graph.ValidationResults[j].ID })\n675\t\tsort.Slice(graph.RoadmapCriteria, func(i, j int) bool {\n676\t\t\treturn graph.RoadmapCriteria[i].Roadmap+\"\\x00\"+graph.RoadmapCriteria[i].ID < graph.RoadmapCriteria[j].Roadmap+\"\\x00\"+graph.RoadmapCriteria[j].ID\n677\t\t})\n678\t\tcopy := *graph\n679\t\tcopy.InputDigest = \"\"\n680\t\traw, _ := json.Marshal(copy)\n681\t\tsum := sha256.Sum256(raw)\n682\t\tgraph.InputDigest = \"sha256:\" + hex.EncodeToString(sum[:])\n683\t}\n684\t\n685\tfunc deliverySeverity(policy DeliveryPolicy, code string) string {\n686\t\tif value := policy.Severities[code]; value != \"\" {\n687\t\t\treturn value\n688\t\t}\n689\t\treturn \"warning\"\n690\t}\n691\t\n692\t// moduleMatchesTarget reports whether a result registered for `module` answers\n693\t// for `target`.\n694\t//\n695\t// It is directional, and it did not used to be. A result from a module that\n696\t// contains the target answers for it: a module-wide run — `go test ./...`, `npm\n697\t// test` — really does exercise the subtree, and running checks once at the\n698\t// module root is how nearly every project is laid out.\n699\t//\n700\t// The reverse does not follow. A result from `site/api` covers part of `site`\n701\t// and was accepted as if it covered all of it, so a criterion about a component\n702\t// could be satisfied by evidence from one directory inside it while the rest\n703\t// went unchecked. That is the same shape as evidence from a sibling component,\n704\t// which is already refused (spec pose-evidence-scoped-to-component): real"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"2384c1d7-bfe1-4e22-8750-7139e35d4abd","timestamp":"2026-11-28T13:48:52.521Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-6851f68889/worktree/pose-mcp/internal/pose/delivery_surface.go","content":"\treturn graph\n}\n\n// ScopedDeliveryProvenanceDigest binds evidence only to the claims and change\n// sets consumed by one spec. Adding an unrelated target or change set cannot\n// invalidate historical evidence for this scope.\nfunc ScopedDeliveryProvenanceDigest(graph DeliveryIntegrityGraph, spec string) string {\n\tclaims := []ArtifactClaim{}\n\tsets := []ChangeSet{}\n\tfor _, claim := range graph.Claims {\n\t\tif claim.Spec == spec {\n\t\t\tclaims = append(claims, claim)\n\t\t}\n\t}\n\tfor _, set := range graph.ChangeSets {\n\t\tif set.Spec == spec {\n\t\t\tsets = append(sets, set)\n\t\t}\n\t}\n\tsort.Slice(claims, func(i, j int) bool { return claimKey(claims[i]) < claimKey(claims[j]) })\n\tsort.Slice(sets, func(i, j int) bool { return sets[i].ID < sets[j].ID })\n\traw, _ := json.Marshal(struct {\n\t\tClaims []ArtifactClaim `json:\"claims\"`\n\t\tSets   []ChangeSet     `json:\"change_sets\"`\n\t}{claims, withoutMaterialDigest(sets)})\n\tsum := sha256.Sum256(raw)\n\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n}\n\nfunc deliveryEvidenceCurrent(result DeliveryValidationResult, spec, status string, graph DeliveryIntegrityGraph, sets []ChangeSet) bool {\n\tif bound := result.MaterialProvenance[spec]; bound != \"\" {\n\t\t// A material binding governs: a mismatch is stale, never a fall-through\n\t\t// to the commit-bound rules below. Only a closed spec keeps its exemption.\n\t\tif bound == ScopedMaterialDigest(graph, spec) {\n\t\t\treturn true\n\t\t}\n\t\treturn status == \"done\" && result.GeneratedAt != \"\"\n\t}\n\tif scoped := result.ScopeProvenance[spec]; scoped != \"\" {\n\t\tif scoped == ScopedDeliveryProvenanceDigest(graph, spec) {\n\t\t\treturn true\n\t\t}\n\t\tif status == \"done\" && result.GeneratedAt != \"\" {\n\t\t\treturn true\n\t\t}\n\t\treturn false\n\t}\n\tif result.ProvenanceDigest != \"\" && result.ProvenanceDigest == graph.ProvenanceDigest {\n\t\treturn true\n\t}\n\t// Results emitted before scope_provenance existed were module-wide. Preserve\n\t// them only for already-closed historical specs: their immutable closeout\n\t// cannot retroactively acquire the new field, and unrelated later targets\n\t// must not invalidate them. Open/current scopes never receive this bridge.\n\tif status == \"done\" && result.ProvenanceDigest 