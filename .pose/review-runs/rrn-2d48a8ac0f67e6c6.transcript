{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SQ1tKfgaoGGCgyguNhUjrH","type":"tool_result","content":"1736\tfunc cmdClose(root string, args []string, stdout, stderr io.Writer) int {\n1737\t\tfor _, arg := range args {\n1738\t\t\tif arg == \"--plan\" || arg == \"--apply\" || arg == \"--resume\" {\n1739\t\t\t\treturn cmdClosePlan(root, args, stdout, stderr)\n1740\t\t\t}\n1741\t\t}\n1742\t\texpectedContext := \"\"\n1743\t\tremaining := make([]string, 0, len(args))\n1744\t\tfor i := 0; i < len(args); i++ {\n1745\t\t\tif args[i] != \"--expect-context\" {\n1746\t\t\t\tremaining = append(remaining, args[i])\n1747\t\t\t\tcontinue\n1748\t\t\t}\n1749\t\t\tif expectedContext != \"\" || i+1 >= len(args) || strings.HasPrefix(args[i+1], \"--\") {\n1750\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: --expect-context requires one digest\")\n1751\t\t\t\treturn 2\n1752\t\t\t}\n1753\t\t\ti++\n1754\t\t\texpectedContext = args[i]\n1755\t\t}\n1756\t\tref, jsonFlag, ok := parseScopeCheckArgs(\"close\", remaining, stderr)\n1757\t\tif !ok {\n1758\t\t\treturn 2\n1759\t\t}\n1760\t\t// The guarded transition has no JSON result; the flag is refused before\n1761\t\t// anything is read instead of being dropped (spec\n1762\t\t// pose-cli-mcp-operation-results R3).\n1763\t\tif jsonFlag {\n1764\t\t\trender(io.Discard, stderr).Failure(\"pose close: --json is taken only by --plan, --apply and --resume; use `pose closeout-check \" + ref + \" --json` to read the state\")\n1765\t\t\treturn 2\n1766\t\t}\n1767\t\ttaskRef := ref\n1768\t\tvar requested posemodel.ArtifactRef\n1769\t\tif strings.HasPrefix(ref, \"xref:\") {\n1770\t\t\tparsed, err := posemodel.ParseArtifactRef(ref)\n1771\t\t\tif err != nil {\n1772\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: invalid qualified task reference\")\n1773\t\t\t\treturn 2\n1774\t\t\t}\n1775\t\t\trequested = parsed\n1776\t\t\ttaskRef = parsed.String()\n1777\t\t} else {\n1778\t\t\tparsed, err := posemodel.ParseArtifactRef(ref)\n1779\t\t\tif err != nil {\n1780\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: invalid task reference\")\n1781\t\t\t\treturn 2\n1782\t\t\t}\n1783\t\t\trequested = parsed\n1784\t\t}\n1785\t\tcontext, resolver, currentProject, err := cliAgentContext(root, taskRef)\n1786\t\tif err != nil {\n1787\t\t\trender(io.Discard, stderr).Failure(\"pose close: project context unavailable: \" + err.Error())\n1788\t\t\treturn 1\n1789\t\t}\n1790\t\tif context.TaskResolution == nil || !context.TaskResolution.Resolved {\n1791\t\t\tstate := \"unknown-artifact\"\n1792\t\t\tif context.TaskResolution != nil {\n1793\t\t\t\tstate = context.TaskResolution.State\n1794\t\t\t}\n1795\t\t\trender(io.Discard, stderr).Failure(\"pose close: task authority cannot close: \" + state)\n1796\t\t\treturn 1\n1797\t\t}\n1798\t\tif context.Authority == nil || context.Authority.Kind != requested.Kind {\n1799\t\t\trender(io.Discard, stderr).Failure(\"pose close: canonical authority changed\")\n1800\t\t\treturn 1\n1801\t\t}\n1802\t\tstore, crossProject, err := cliAuthorizedWriteStore(root, context.Authority.Project, resolver, currentProject)\n1803\t\tif err != nil {\n1804\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n1805\t\t\treturn 1\n1806\t\t}\n1807\t\tstore.FederatedProjectID = context.Authority.Project\n1808\t\tstore.FederatedResolver = &resolver\n1809\t\tif crossProject && expectedContext == \"\" {\n1810\t\t\trender(io.Discard, stderr).Failure(\"pose close: cross-project write requires --expect-context from pose context\")\n1811\t\t\treturn 1\n1812\t\t}\n1813\t\tif expectedContext != \"\" && context.ContextRevision != expectedContext {\n1814\t\t\trender(io.Discard, stderr).Failure(\"pose close: stale-context; rerun pose context and retry\")\n1815\t\t\treturn 1\n1816\t\t}\n1817\t\tlocalRef := scopeRefForArtifact(*context.Authority)\n1818\t\tvar guard func() error\n1819\t\tif expectedContext != \"\" {\n1820\t\t\tguard = func() error {\n1821\t\t\t\tlatest, err := posemodel.ResolveAgentProjectContext(resolver, currentProject, taskRef)\n1822\t\t\t\tif err != nil || latest.ContextRevision != expectedContext || latest.Authority == nil || latest.Authority.String() != context.Authority.String() {\n1823\t\t\t\t\treturn fmt.Errorf(\"stale-context\")\n1824\t\t\t\t}\n1825\t\t\t\treturn nil\n1826\t\t\t}\n1827\t\t}\n1828\t\treturn cmdCloseLocalWithStoreEffect(store, localRef, guard, stdout, stderr, nil)\n1829\t}\n1830\t\n1831\tfunc scopeRefForArtifact(ref posemodel.ArtifactRef) string {\n1832\t\tif ref.Kind == \"milestone\" {\n1833\t\t\treturn \"milestone:\" + ref.Slug + \"/\" + ref.Milestone\n1834\t\t}\n1835\t\treturn ref.Kind + \":\" + ref.Slug\n1836\t}\n1837\t\n1838\tfunc cmdCloseLocal(root, ref string, guard func() error, stdout, stderr io.Writer) int {\n1839\t\treturn cmdCloseLocalWithEffect(root, ref, guard, stdout, stderr, nil)\n1840\t}\n1841\t\n1842\t// The pipeline confirms a transition only from the write point, never exit 0\n1843\t// alone: another execution may have closed the scope since it planned.\n1844\tfunc cmdCloseLocalWithEffect(root, ref string, guard func() error, stdout, stderr io.Writer, transitioned func(unsynced error)) int {\n1845\t\treturn cmdCloseLocalWithStoreEffect(cliGovernedStore(root), ref, guard, stdout, stderr, transitioned)\n1846\t}\n1847\t\n1848\tfunc cmdCloseLocalWithStoreEffect(store posemodel.Store, ref string, guard func() error, stdout, stderr io.Writer, transitioned func(unsynced error)) int {\n1849\t\tif scope, parseErr := posemodel.ParseScopeRef(ref); parseErr == nil && scope.Kind == \"spec\" {\n1850\t\t\tstate, err := cliCloseoutStateForStore(store, ref)\n1851\t\t\tif err != nil {\n1852\t\t\t\tif refusal := cliCloseGovernedPreflightRefusal(store, ref); refusal != nil {\n1853\t\t\t\t\terr = refusal\n1854\t\t\t\t}\n1855\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n1856\t\t\t\treturn 1\n1857\t\t\t}\n1858\t\t\tif state.LifecycleDone {\n1859\t\t\t\tif !state.Terminal {\n1860\t\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n1861\t\t\t\t\treturn 1\n1862\t\t\t\t}\n1863\t\t\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; applicable terminal verifier passed; no transition executed\")\n1864\t\t\t\treturn 0\n1865\t\t\t}\n1866\t\t}\n1867\t\tvar result int\n1868\t\terr := store.WithCloseoutWriteGuard(\"close.transition\", ref, func(guarded posemodel.Store) error {\n1869\t\t\tresult = cmdCloseLocalWithGuardedStore(guarded.Root, guarded, ref, guard, stdout, stderr, transitioned)\n1870\t\t\treturn nil\n1871\t\t})\n1872\t\tif err != nil {\n1873\t\t\tif refusal := cliCloseGovernedPreflightRefusal(store, ref); refusal != nil {\n1874\t\t\t\terr = refusal\n1875\t\t\t}\n1876\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n1877\t\t\treturn 1\n1878\t\t}\n1879\t\treturn result\n1880\t}\n1881\t\n1882\t// A disabled review bundle policy must not hide an adopted action restriction\n1883\t// when closeout preflight fails. This local lease permits only a\n1884\t// refusal: it never substitutes for full root discovery, the guarded closeout\n1885\t// evaluation, lifecycle lock or CAS required for a successful transition.\n1886\tfunc cliCloseGovernedPreflightRefusal(store posemodel.Store, ref string) error {\n1887\t\tscope, err := posemodel.ParseScopeRef(ref)\n1888\t\tif err != nil || scope.Kind != \"spec\" {\n1889\t\t\treturn nil\n1890\t\t}\n1891\t\treturn store.WithGovernanceWriteGuardForProjects(\"close.restriction-refusal\", nil, func(guarded posemodel.Store) error {\n1892\t\t\tpolicy, err := guarded.GetReviewPolicy()\n1893\t\t\tif err != nil || policy.Enabled || policy.AgencyReadinessVersion != posemodel.AgencyReadinessPolicyVersion {\n1894\t\t\t\treturn err\n1895\t\t\t}\n1896\t\t\trestrictions, err := guarded.GovernedEffectRestrictions(posemodel.PhaseCloseout, []string{scope.Slug})\n1897\t\t\tif err != nil {\n1898\t\t\t\treturn err\n1899\t\t\t}\n1900\t\t\tmessages := make([]string, 0, len(restrictions))\n1901\t\t\tfor _, restriction := range restrictions {\n1902\t\t\t\tmessages = append(messages, fmt.Sprintf(\"%s restricts closeout: %s\", restriction.Source.Detail, restriction.Message))\n1903\t\t\t}\n1904\t\t\tif len(messages) > 0 {\n1905\t\t\t\treturn fmt.Errorf(\"action-request-pending: %s\", strings.Join(messages, \"; \"))\n1906\t\t\t}\n1907\t\t\treturn nil\n1908\t\t})\n1909\t}\n1910\t\n1911\tfunc cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref string, guard func() error, stdout, stderr io.Writer, transitioned func(unsynced error)) int {\n1912\t\t// The gates below judge the artifact as it is now; the transition is\n1913\t\t// published only over those same bytes (spec\n1914\t\t// pose-writer-coordination-and-atomic-publication R4).\n1915\t\tjudged := closeTargetDigest(root, store, ref)\n1916\t\tstate, err := cliCloseoutStateForStore(store, ref)\n1917\t\tif err != nil {\n1918\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n1919\t\t\treturn 1\n1920\t\t}\n1921\t\t// Repeating close on an already-done spec is a readonly terminal check,\n1922\t\t// bounded by the same historical contract as closeout-check and the plan.\n1923\t\tif scope, parseErr := posemodel.ParseScopeRef(ref); parseErr == nil && scope.Kind == \"spec\" && state.LifecycleDone {\n1924\t\t\tif !state.Terminal {\n1925\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n1926\t\t\t\treturn 1\n1927\t\t\t}\n1928\t\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; applicable terminal verifier passed; no transition executed\")\n1929\t\t\treturn 0\n1930\t\t}\n1931\t\t// Governed effects (spec pose-governed-effect-enforcement): this is the\n1932\t\t// write point of the closeout transition, so an adopted, unsatisfied\n1933\t\t// action request restricting closeout refuses here with its typed cause,\n1934\t\t// whatever else the scope's review says.\n1935\t\tgoverned := []string{}\n1936\t\tfor _, d := range state.Diagnostics {\n1937\t\t\tif d.Code == \"action-request-pending\" {\n1938\t\t\t\tgoverned = append(governed, d.Message)\n1939\t\t\t}\n1940\t\t}\n1941\t\t// A current adjudication that says a question does not hold refuses the\n1942\t\t// closeout (spec pose-delegated-verdict-destinations R1).\n1943\t\tadjudicated := []string{}\n1944\t\tfor _, d := range state.Diagnostics {\n1945\t\t\tif d.Code == posemodel.AdjudicationDoesNotHoldCode {\n1946\t\t\t\tadjudicated = append(adjudicated, d.Message)\n1947\t\t\t}\n1948\t\t}\n1949\t\tif len(adjudicated) > 0 {\n1950\t\t\tout := render(stdout, stderr)\n1951\t\t\tfor _, message := range adjudicated {\n1952\t\t\t\tout.Field(\"close.refused.adjudication\", message)\n1953\t\t\t}\n1954\t\t\tout.Failure(fmt.Sprintf(\"pose close: %d adjudicated question(s) of %s do not hold\", len(adjudicated), ref))\n1955\t\t\treturn 1\n1956\t\t}\n1957\t\tif len(governed) > 0 {\n1958\t\t\tout := render(stdout, stderr)\n1959\t\t\tfor _, message := range governed {\n1960\t\t\t\tout.Field(\"close.refused.action-request-pending\", message)\n1961\t\t\t}\n1962\t\t\tout.Failure(fmt.Sprintf(\"pose close: %d action request(s) restrict closeout of %s\", len(governed), ref))\n1963\t\t\treturn 1\n1964\t\t}\n1965\t\tscope, _ := posemodel.ParseScopeRef(ref)\n1966\t\t// Under an adopted closeout review policy (spec\n1967\t\t// pose-closeout-review-policy-by-cost-benefit) the close of a milestone or a\n1968\t\t// roadmap publishes a receipt. A receipt already there makes the close a\n1969\t\t// read-only verification; a scope the evaluator cannot decide is refused.\n1970\t\treceiptClose, code := closeoutReceiptPreflight(store, ref, scope, &state, stdout, stderr)\n1971\t\tif code >= 0 {\n1972\t\t\treturn code\n1973\t\t}\n1974\t\tif !closeReviewSatisfied(state) || len(state.Children) > 0 && hasOpenChild(state.Children) {\n1975\t\t\tfmt.Fprintf(stderr, \"pose close: scope is not eligible; next action: %s\\n\", state.NextAction)\n1976\t\t\treturn 1\n1977\t\t}\n1978\t\tif scope.Kind == \"milestone\" {\n1979\t\t\tgate, err := roadmapGate(root, scope.Roadmap, scope.Milestone)\n1980\t\t\tif err != nil {\n1981\t\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + err.Error())\n1982\t\t\t\treturn 1\n1983\t\t\t}\n1984\t\t\tif blockers := uniqueCLIStrings(gate.blockers); len(blockers) > 0 {\n1985\t\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + strings.Join(blockers, \"; \"))\n1986\t\t\t\treturn 1\n1987\t\t\t}\n1988\t\t\tlabel := \"Milestone closeout verified\"\n1989\t\t\tif receiptClose != nil {\n1990\t\t\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, guard, stderr)\n1991\t\t\t\tif code != 0 {\n1992\t\t\t\t\treturn code\n1993\t\t\t\t}\n1994\t\t\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, judgedState, stdout, stderr); code != 0 {\n1995\t\t\t\t\treturn code"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"59719f9e-b172-4048-83d0-f1785ca4d037","timestamp":"2026-11-28T13:42:08.445Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-6851f68889/worktree/pose-mcp/internal/cli/review_closeout.go","content":"func cmdClose(root string, args []string, stdout, stderr io.Writer) int {\n\tfor _, arg := range args {\n\t\tif arg == \"--plan\" || arg == \"--apply\" || arg == \"--resume\" {\n\t\t\treturn cmdClosePlan(root, args, stdout, stderr)\n\t\t}\n\t}\n\texpectedContext := \"\"\n\tremaining := make([]string, 0, len(args))\n\tfor i := 0; i < len(args); i++ {\n\t\tif args[i] != \"--expect-context\" {\n\t\t\tremaining = append(remaining, args[i])\n\t\t\tcontinue\n\t\t}\n\t\tif expectedContext != \"\" || i+1 >= len(args) || strings.HasPrefix(args[i+1], \"--\") {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: --expect-context requires one digest\")\n\t\t\treturn 2\n\t\t}\n\t\ti++\n\t\texpectedContext = args[i]\n\t}\n\tref, jsonFlag, ok := parseScopeCheckArgs(\"close\", remaining, stderr)\n\tif !ok {\n\t\treturn 2\n\t}\n\t// The guarded transition has no JSON result; the flag is refused before\n\t// anything is read instead of being dropped (spec\n\t// pose-cli-mcp-operation-results R3).\n\tif jsonFlag {\n\t\trender(io.Discard, stderr).Failure(\"pose close: --json is taken only by --plan, --apply and --resume; use `pose closeout-check \" + ref + \" --json` to read the state\")\n\t\treturn 2\n\t}\n\ttaskRef := ref\n\tvar requested posemodel.ArtifactRef\n\tif strings.HasPrefix(ref, \"xref:\") {\n\t\tparsed, err := posemodel.ParseArtifactRef(ref)\n\t\tif err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: invalid qualified task reference\")\n\t\t\treturn 2\n\t\t}\n\t\trequested = parsed\n\t\ttaskRef = parsed.String()\n\t} else {\n\t\tparsed, err := posemodel.ParseArtifactRef(ref)\n\t\tif err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: invalid task reference\")\n\t\t\treturn 2\n\t\t}\n\t\trequested = parsed\n\t}\n\tcontext, resolver, currentProject, err := cliAgentContext(root, taskRef)\n\tif err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose close: project context unavailable: \" + err.Error())\n\t\treturn 1\n\t}\n\tif context.TaskResolution == nil || !context.TaskResolution.Resolved {\n\t\tstate := \"unknown-artifact\"\n\t\tif context.TaskResolution != nil {\n\t\t\tstate = context.TaskResolution.State\n\t\t}\n\t\trender(io.Discard, stderr).Failure(\"pose close: task authority cannot close: \" + state)\n\t\treturn 1\n\t}\n\tif context.Authority == nil || context.Authority.Kind != requested.Kind {\n\t\trender(io.Discard, stderr).Failure(\"pose close: canonical authority changed\")\n\t\treturn 1\n\t}\n\tstore, crossProject, err := cliAuthorizedWriteStore(root, context.Authority.Project, resolver, currentProject)\n\tif err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\treturn 1\n\t}\n\tstore.FederatedProjectID = context.Authority.Project\n\tstore.FederatedResolver = &resolver\n\tif crossProject && expectedContext == \"\" {\n\t\trender(io.Discard, stderr).Failure(\"pose close: cross-project write requires --expect-context from pose context\")\n\t\treturn 1\n\t}\n\tif expectedContext != \"\" && context.ContextRevision != expectedContext {\n\t\trender(io.Discard, stderr).Failure(\"pose close: stale-context; rerun pose context and retry\")\n\t\treturn 1\n\t}\n\tlocalRef := scopeRefForArtifact(*context.Authority)\n\tvar guard func() error\n\tif expectedContext != \"\" {\n\t\tguard = func() error {\n\t\t\tlatest, err := posemodel.ResolveAgentProjectContext(resolver, currentProject, taskRef)\n\t\t\tif err != nil || latest.ContextRevision != expectedContext || latest.Authority == nil || latest.Authority.String() != context.Authority.String() {\n\t\t\t\treturn fmt.Errorf(\"stale-context\")\n\t\t\t}\n\t\t\treturn nil\n\t\t}\n\t}\n\treturn cmdCloseLocalWithStoreEffect(store, localRef, guard, stdout, stderr, nil)\n}\n\nfunc scopeRefForArtifact(ref posemodel.ArtifactRef) string {\n\tif ref.Kind == \"milestone\" {\n\t\treturn \"milestone:\" + ref.Slug + \"/\" + ref.Milestone\n\t}\n\treturn ref.Kind + \":\" + ref.Slug\n}\n\nfunc cmdCloseLocal(root, ref string, guard func() error, stdout, stderr io.Writer) int {\n\treturn cmdCloseLocalWithEffect(root, ref, guard, stdout, stderr, nil)\n}\n\n// The pipeline confirms a transition only from the write point, never exit 0\n// alone: another execution may have closed the scope since it planned.\nfunc cmdCloseLocalWithEffect(root, ref string, guard func() error, stdout, stderr io.Writer, transitioned func(unsynced error)) int {\n\treturn cmdCloseLocalWithStoreEffect(cliGovernedStore(root), ref, guard, stdout, stderr, transitioned)\n}\n\nfunc cmdCloseLocalWithStoreEffect(store posemodel.Store, ref string, guard func() error, stdout, stderr io.Writer, transitioned func(unsynced error)) int {\n\tif scope, parseErr := posemodel.ParseScopeRef(ref); parseErr == nil && scope.Kind == \"spec\" {\n\t\tstate, err := cliCloseoutStateForStore(store, ref)\n\t\tif err != nil {\n\t\t\tif refusal := cliCloseGovernedPreflightRefusal(store, ref); refusal != nil {\n\t\t\t\terr = refusal\n\t\t\t}\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tif state.LifecycleDone {\n\t\t\tif !state.Terminal {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; applicable terminal verifier passed; no transition executed\")\n\t\t\treturn 0\n\t\t}\n\t}\n\tvar result int\n\terr := store.WithCloseoutWriteGuard(\"close.transition\", ref, func(guarded posemodel.Store) error {\n\t\tresult = cmdCloseLocalWithGuardedStore(guarded.Root, guarded, ref, guard, stdout, stderr, transitioned)\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tif refusal := cliCloseGovernedPreflightRefusal(store, ref); refusal != nil {\n\t\t\terr = refusal\n\t\t}\n\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\treturn 1\n\t}\n\treturn result\n}\n\n// A disabled review bundle policy must not hide an adopted action restriction\n// when closeout preflight fails. This local lease permits only a\n// refusal: it never substitutes for full root discovery, the guarded closeout\n// evaluation, lifecycle lock or CAS required for a successful transition.\nfunc cliCloseGovernedPreflightRefusal(store posemodel.Store, ref string) error {\n\tscope, err := posemodel.ParseScopeRef(ref)\n\tif err != nil || scope.Kind != \"spec\" {\n\t\treturn nil\n\t}\n\treturn store.WithGovernanceWriteGuardForProjects(\"close.restriction-refusal\", nil, func(guarded posemodel.Store) error {\n\t\tpolicy, err := guarded.GetReviewPolicy()\n\t\tif err != nil || policy.Enabled || policy.AgencyReadinessVersion != posemodel.AgencyReadinessPolicyVersion {\n\t\t\treturn err\n\t\t}\n\t\trestrictions, err := guarded.GovernedEffectRestrictions(posemodel.PhaseCloseout, []string{scope.Slug})\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tmessages := make([]string, 0, len(restrictions))\n\t\tfor _, restriction := range restrictions {\n\t\t\tmessages = append(messages, fmt.Sprintf(\"%s restricts closeout: %s\", restriction.Source.Detail, restriction.Message))\n\t\t}\n\t\tif len(messages) > 0 {\n\t\t\treturn fmt.Errorf(\"action-request-pending: %s\", strings.Join(messages, \"; \"))\n\t\t}\n\t\treturn nil\n\t})\n}\n\nfunc cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref string, guard func() error, stdout, stderr io.Writer, transitioned func(unsynced error)) int {\n\t// The gates below judge the artifact as it is now; the transition is\n\t// published only over those same bytes (spec\n\t// pose-writer-coordination-and-atomic-publication R4).\n\tjudged := closeTargetDigest(root, store, ref)\n\tstate, err := cliCloseoutStateForStore(store, ref)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\treturn 1\n\t}\n\t// Repeating close on an already-done spec is a readonly terminal check,\n\t// bounded by the same historical contract as closeout-check and the plan.\n\tif scope, parseErr := posemodel.ParseScopeRef(ref); parseErr == nil && scope.Kind == \"spec\" && state.LifecycleDone {\n\t\tif !state.Terminal {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n\t\t\treturn 1\n\t\t}\n\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; applicable terminal verifier passed; no transition executed\")\n\t\treturn 0\n\t}\n\t// Governed effects (spec pose-governed-effect-enforcement): this is the\n\t// write point of the closeout transition, so an adopted, unsatisfied\n\t// action request restricting closeout refuses here with its typed cause,\n\t// whatever else the scope's review says.\n\tgoverned := []string{}\n\tfor _, d := range state.Diagnostics {\n\t\tif d.Code == \"action-request-pending\" {\n\t\t\tgoverned = append(governed, d.Message)\n\t\t}\n\t}\n\t// A current adjudication that says a question does not hold refuses the\n\t// closeout (spec pose-delegated-verdict-destinations R1).\n\tadjudicated := []string{}\n\tfor _, d := range state.Diagnostics {\n\t\tif d.Code == posemodel.AdjudicationDoesNotHoldCode {\n\t\t\tadjudicated = append(adjudicated, d.Message)\n\t\t}\n\t}\n\tif len(adjudicated) > 0 {\n\t\tout := render(stdout, stderr)\n\t\tfor _, message := range adjudicated {\n\t\t\tout.Field(\"close.refused.adjudication\", message)\n\t\t}\n\t\tout.Failure(fmt.Sprintf(\"pose close: %d adjudicated question(s) of %s do not hold\", len(adjudicated), ref))\n\t\treturn 1\n\t}\n\tif len(governed) > 0 {\n\t\tout := render(stdout, stderr)\n\t\tfor _, message := range governed {\n\t\t\tout.Field(\"close.refused.action-request-pending\", message)\n\t\t}\n\t\tout.Failure(fmt.Sprintf(\"pose close: %d action request(s) restrict closeout of %s\", len(governed), ref))\n\t\treturn 1\n\t}\n\tscope, _ := posemodel.ParseScopeRef(ref)\n\t// Under an adopted closeout review policy (spec\n\t// pose-closeout-review-policy-by-cost-benefit) the close of a milestone or a\n\t// roadmap publishes a receipt. A receipt already there makes the close a\n\t// read-only verification; a scope the evaluator cannot decide is refused.\n\treceiptClose, code := closeoutReceiptPreflight(store, ref, scope, &state, stdout, stderr)\n\tif code >= 0 {\n\t\treturn code\n\t}\n\tif !closeReviewSatisfied(state) || len(state.Children) > 0 && hasOpenChild(state.Children) {\n\t\tfmt.Fprintf(stderr, \"pose close: scope is not eligible; next action: %s\\n\", state.NextAction)\n\t\treturn 1\n\t}\n\tif scope.Kind == \"milestone\" {\n\t\tgate, err := roadmapGate(root, scope.Roadmap, scope.Milestone)\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tif blockers := uniqueCLIStrings(gate.blockers); len(blockers) > 0 {\n\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + strings.Join(blockers, \"; \"))\n\t\t\treturn 1\n\t\t}\n\t\tlabel := \"Milestone closeout verified\"\n\t\tif receiptClose != nil {\n\t\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, guard, stderr)\n\t\t\tif code != 0 {\n\t\t\t\treturn code\n\t\t\t}\n\t\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, judgedState, stdout, stderr); code != 0 {\n\t\t\t\treturn code","numLines":260,"startLine":1736,"totalLines":2620}},"tool_result_meta":[{"id":"toolu_01SQ1tKfgaoGGCgyguNhUjrH","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
