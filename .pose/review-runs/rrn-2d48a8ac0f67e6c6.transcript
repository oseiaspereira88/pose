target, plan); err != nil {\n1565\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: writing execution plan: %v\\n\", \"Erro: escrevendo plano de execução: %v\\n\"), err)\n1566\t\t\t\treturn 1\n1567\t\t\t}\n1568\t\t\tfmt.Fprintf(stdout, \"plan: %s (%d isolated check(s); approval required before Harness execution)\\n\", target, len(plan.Checks))\n1569\t\t}\n1570\t\tif autoReport {\n1571\t\t\tif reportTask == \"\" {\n1572\t\t\t\treportTask = \"validate-native\"\n1573\t\t\t}\n1574\t\t\treportArgs := []string{\"--task\", reportTask, \"--context\", \"auto-validate\", \"--validation-profile\", mode}\n1575\t\t\t// The outcome travels inside the summary, so it stays derived rather\n1576\t\t\t// than being recorded as a manual assertion.\n1577\t\t\t_ = runReportWith(root, reportArgs, nil, validationSummaryOf(run), io.Discard, stderr)\n1578\t\t}\n1579\t\tif failures > 0 {\n1580\t\t\treturn 1\n1581\t\t}\n1582\t\treturn 0\n1583\t}\n1584\t\n1585\t// validationSummaryOf projects a finished run for `pose report`: the commands\n1586\t// it executed and one line per check, with the outcome the run reached. It is\n1587\t// the structured replacement for parsing the printed output (spec\n1588\t// pose-cli-output-rendering-system R5).\n1589\t// moduleValidationChecks resolves the stack and checks one module runs after\n1590\t// overrides, and whether the stack/module filters select it at all. The counting\n1591\t// pass and the executing pass share it so a filter can never mean two things\n1592\t// (spec pose-cli-output-rendering-system R6).\n1593\tfunc moduleValidationChecks(module validationModule, matrix validationMatrix, stackFilter, moduleFilter string) (string, []validationCheck, bool) {\n1594\t\toverride := matrix.ModuleOverrides[module.Rel]\n1595\t\tstack := module.Stack\n1596\t\tif override.Stack != \"\" {\n1597\t\t\tstack = override.Stack\n1598\t\t}\n1599\t\tif stackFilter != \"\" && stack != stackFilter || moduleFilter != \"\" && module.Rel != moduleFilter {\n1600\t\t\treturn stack, nil, false\n1601\t\t}\n1602\t\tchecks := append([]validationCheck(nil), matrix.Stacks[stack].Checks...)\n1603\t\tif override.ReplaceDefaultChecks {\n1604\t\t\tchecks = nil\n1605\t\t}\n1606\t\treturn stack, append(checks, override.Checks...), true\n1607\t}\n1608\t\n1609\t// tailLines keeps the last n lines of a check's captured output: enough to see\n1610\t// why it failed, with the full output one path away.\n1611\tfunc tailLines(text string, n int) string {\n1612\t\tlines := strings.Split(strings.TrimRight(text, \"\\n\"), \"\\n\")\n1613\t\tif len(lines) <= n {\n1614\t\t\treturn strings.Join(lines, \"\\n\")\n1615\t\t}\n1616\t\treturn strings.Join(lines[len(lines)-n:], \"\\n\")\n1617\t}\n1618\t\n1619\tfunc validationSummaryOf(run validationRunResult) *validationSummary {\n1620\t\tsummary := &validationSummary{Outcome: run.Outcome}\n1621\t\tfor _, check := range run.Checks {\n1622\t\t\tif check.CarriedFrom != \"\" {\n1623\t\t\t\t// Carried, not executed: kept apart with where and when it ran\n1624\t\t\t\t// (spec pose-validate-carry-report-and-closeout-coverage R1, R2).\n1625\t\t\t\tsummary.Carried = append(summary.Carried, fmt.Sprintf(\"[%s] %s (carried from %s, generated at %s)\", check.Outcome, check.ID, check.CarriedFrom, check.CarriedGeneratedAt))\n1626\t\t\t\tcontinue\n1627\t\t\t}\n1628\t\t\tcommand := strings.TrimSpace(check.Program + \" \" + strings.Join(check.Args, \" \"))\n1629\t\t\tif check.Outcome != \"skipped\" && command != \"\" {\n1630\t\t\t\tsummary.Commands = append(summary.Commands, command)\n1631\t\t\t}\n1632\t\t\tline := \"- [\" + check.Outcome + \"] \" + check.ID\n1633\t\t\tswitch {\n1634\t\t\tcase check.SkipReason != \"\":\n1635\t\t\t\tline += \" (\" + check.SkipReason + \")\"\n1636\t\t\tcase check.DurationSeconds > 0:\n1637\t\t\t\tline += fmt.Sprintf(\" (%.1fs)\", check.DurationSeconds)\n1638\t\t\t}\n1639\t\t\tif check.ExitCode != nil {\n1640\t\t\t\tline += fmt.Sprintf(\" exit=%d\", *check.ExitCode)\n1641\t\t\t}\n1642\t\t\tsummary.Results = append(summary.Results, line)\n1643\t\t}\n1644\t\t// The report records the run's verdict too, built from the outcome rather\n1645\t\t// than copied from the printed line, so the recorded evidence keeps its\n1646\t\t// shape while the terminal is free to change.\n1647\t\tif run.Counts.OptionalFailed > 0 {\n1648\t\t\tsummary.Results = append(summary.Results, fmt.Sprintf(\"Warning: %d optional check(s) failed.\", run.Counts.OptionalFailed))\n1649\t\t}\n1650\t\tswitch run.Outcome {\n1651\t\tcase \"fail\":\n1652\t\t\tsummary.Results = append(summary.Results, \"Result: FAILURE (required check failed)\")\n1653\t\tdefault:\n1654\t\t\tsummary.Results = append(summary.Results, \"Result: SUCCESS\")\n1655\t\t}\n1656\t\treturn summary\n1657\t}\n1658\t\n1659\tfunc sanitizeGoCheckArgs(ctx context.Context, dir, program string, args []string) []string {\n1660\t\tif program != \"go\" || len(args) == 0 {\n1661\t\t\treturn args\n1662\t\t}\n1663\t\n1664\t\thasWildcard := false\n1665\t\tfor _, a := range args {\n1666\t\t\tif a == \"./...\" || strings.HasSuffix(a, \"/...\") {\n1667\t\t\t\thasWildcard = true\n1668\t\t\t\tbreak\n1669\t\t\t}\n1670\t\t}\n1671\t\tif !hasWildcard {\n1672\t\t\treturn args\n1673\t\t}\n1674\t\n1675\t\thasNodeModules := false\n1676\t\t_ = filepath.WalkDir(dir, func(p string, d os.DirEntry, err error) error {\n1677\t\t\tif err == nil && d.IsDir() && d.Name() == \"node_modules\" {\n1678\t\t\t\thasNodeModules = true\n1679\t\t\t\treturn filepath.SkipDir"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"793805b1-ef49-4346-b9db-92414f573c4a","timestamp":"2026-11-28T13:42:04.048Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-6851f68889/worktree/pose-mcp/internal/cli/validate.go","content":"\trun.MaterialClean = startedClean && endedClean && run.GitHead != \"\" && endHead == run.GitHead && validationMaterialClean(root, run.GitHead) && startReflog != \"\" && endReflog == startReflog\n\t// A run that did not validate its recorded head binds no material: its\n\t// bindings would let a later tree make a misattributed pass current again\n\t// (review round 5, N12).\n\tif len(run.MaterialProvenance) > 0 && !run.MaterialClean {\n\t\tfor spec := range run.MaterialProvenance {\n\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n\t\t}\n\t}\n\t// A cancelled run never reads as a success, whatever the severity of the\n\t// checks it stopped (review round 1, B5).\n\t// A signal cancels the run even when no executed check saw it, as in an\n\t// all-carried run (review round 15, N45).\n\tcancelled := runCtx.Err() != nil\n\tfor _, check := range run.Checks {\n\t\tcancelled = cancelled || check.LimitState == \"cancelled\"\n\t}\n\tif cancelled {\n\t\trun.Cancelled = finalizeCancellation(&run)\n\t}\n\tfor _, line := range validationTimingNotes(run) {\n\t\tsteps.Note(line)\n\t}\n\tsteps.Summary()\n\tif executed == 0 && run.Counts.Carried == 0 {\n\t\tfmt.Fprintln(stdout, \"No modules/checks matched the matrix and filters.\")\n\t}\n\tresult := \"pass\"\n\tif cancelled {\n\t\tfailures++\n\t\tresult = \"fail\"\n\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"validation cancelled\", \"validação cancelada\")})\n\t} else if failures > 0 {\n\t\tresult = \"fail\"\n\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"required check failed\", \"check obrigatório falhou\")})\n\t} else {\n\t\tif optionalFailures > 0 {\n\t\t\tresult = \"partial\"\n\t\t\tr.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"optional-check\",\n\t\t\t\tMessage: fmt.Sprintf(cliText(locale, \"%d optional check(s) failed\", \"%d check(s) opcional(is) falharam\"), optionalFailures)})\n\t\t}\n\t\tr.Verdict(cliout.Verdict{State: cliout.StatePass})\n\t}\n\trun.Outcome = result\n\tusageFindings := make([]usageFinding, 0, run.Counts.Failed+run.Counts.OptionalFailed+run.Counts.Errored)\n\tfor _, check := range run.Checks {\n\t\tif check.Outcome != \"fail\" && check.Outcome != \"error\" {\n\t\t\tcontinue\n\t\t}\n\t\tseverity := check.Severity\n\t\tif check.Outcome == \"error\" {\n\t\t\tseverity = \"error\"\n\t\t}\n\t\tusageFindings = append(usageFindings, usageFinding{ID: check.ID, Severity: severity})\n\t}\n\tnoteUsageFindings(stdout, result, usageFindings, true)\n\tfor name, writer := range map[string]struct {\n\t\tpath  string\n\t\twrite func(string, validationRunResult) error\n\t}{\n\t\t\"json\":  {jsonOut, writeValidationJSON},\n\t\t\"junit\": {junitOut, writeValidationJUnit},\n\t\t\"sarif\": {sarifOut, writeValidationSARIF},\n\t} {\n\t\tif writer.path == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\ttarget := filepath.Join(root, filepath.FromSlash(writer.path))\n\t\tif name == \"json\" && canonicalResultsPath != \"\" && normalizeValidationOutputPath(writer.path) == canonicalResultsPath {\n\t\t\terr := publishCanonicalValidationJSONIn(store, writer.path, canonicalResultsPath, run)\n\t\t\tif err != nil {\n\t\t\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n\t\t\t\t\tout := render(stdout, stderr)\n\t\t\t\t\tout.ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n\t\t\t\t\tout.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"validation-result-durability\",\n\t\t\t\t\t\tMessage: fmt.Sprintf(\"%s result was published but durability is unconfirmed: %v\", name, err)})\n\t\t\t\t\treturn 1\n\t\t\t\t}\n\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(cliText(locale, \"writing %s result: %v\", \"escrevendo resultado %s: %v\"), name, err))\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\trender(stdout, stderr).ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n\t\t\tcontinue\n\t\t}\n\t\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: creating %s result directory: %v\\n\", \"Erro: criando diretório do resultado %s: %v\\n\"), name, err)\n\t\t\treturn 1\n\t\t}\n\t\tif err := writer.write(target, run); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: writing %s result: %v\\n\", \"Erro: escrevendo resultado %s: %v\\n\"), name, err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"%s: %s\\n\", name, target)\n\t}\n\tif planOut != \"\" {\n\t\tdigest := sha256.Sum256(raw)\n\t\thead := \"\"\n\t\tif out, err := posemodel.RawHistoryGit(root, \"rev-parse\", \"HEAD\").Output(); err == nil {\n\t\t\thead = strings.TrimSpace(string(out))\n\t\t}\n\t\tplan := executionPlan{\n\t\t\tSchemaVersion: validationResultSchema,\n\t\t\tGeneratedAt:   run.GeneratedAt,\n\t\t\tProjectID:     posemodel.DefaultProjectID(root),\n\t\t\tSpec:          reportTask,\n\t\t\tGitHead:       head,\n\t\t\tMatrixSHA256:  hex.EncodeToString(digest[:]),\n\t\t\tChecks:        isolationChecks,\n\t\t\tApproval:      planApproval{Required: true},\n\t\t}\n\t\tif plan.Checks == nil {\n\t\t\tplan.Checks = []checkResult{}\n\t\t}\n\t\ttarget := filepath.Join(root, filepath.FromSlash(planOut))\n\t\tif err := writeExecutionPlan(target, plan); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: writing execution plan: %v\\n\", \"Erro: escrevendo plano de execução: %v\\n\"), err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"plan: %s (%d isolated check(s); approval required before Harness execution)\\n\", target, len(plan.Checks))\n\t}\n\tif autoReport {\n\t\tif reportTask == \"\" {\n\t\t\treportTask = \"validate-native\"\n\t\t}\n\t\treportArgs := []string{\"--task\", reportTask, \"--context\", \"auto-validate\", \"--validation-profile\", mode}\n\t\t// The outcome travels inside the summary, so it stays derived rather\n\t\t// than being recorded as a manual assertion.\n\t\t_ = runReportWith(root, reportArgs, nil, validationSummaryOf(run), io.Discard, stderr)\n\t}\n\tif failures > 0 {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\n// validationSummaryOf projects a finished run for `pose report`: the commands\n// it executed and one line per check, with the outcome the run reached. It is\n// the structured replacement for parsing the printed output (spec\n// pose-cli-output-rendering-system R5).\n// moduleValidationChecks resolves the stack and checks one module runs after\n// overrides, and whether the stack/module filters select it at all. The counting\n// pass and the executing pass share it so a filter can never mean two things\n// (spec pose-cli-output-rendering-system R6).\nfunc moduleValidationChecks(module validationModule, matrix validationMatrix, stackFilter, moduleFilter string) (string, []validationCheck, bool) {\n\toverride := matrix.ModuleOverrides[module.Rel]\n\tstack := module.Stack\n\tif override.Stack != \"\" {\n\t\tstack = override.Stack\n\t}\n\tif stackFilter != \"\" && stack != stackFilter || moduleFilter != \"\" && module.Rel != moduleFilter {\n\t\treturn stack, nil, false\n\t}\n\tchecks := append([]validationCheck(nil), matrix.Stacks[stack].Checks...)\n\tif override.ReplaceDefaultChecks {\n\t\tchecks = nil\n\t}\n\treturn stack, append(checks, override.Checks...), true\n}\n\n// tailLines keeps the last n lines of a check's captured output: enough to see\n// why it failed, with the full output one path away.\nfunc tailLines(text string, n int) string {\n\tlines := strings.Split(strings.TrimRight(text, \"\\n\"), \"\\n\")\n\tif len(lines) <= n {\n\t\treturn strings.Join(lines, \"\\n\")\n\t}\n\treturn strings.Join(lines[len(lines)-n:], \"\\n\")\n}\n\nfunc validationSummaryOf(run validationRunResult) *validationSummary {\n\tsummary := &validationSummary{Outcome: run.Outcome}\n\tfor _, check := range run.Checks {\n\t\tif check.CarriedFrom != \"\" {\n\t\t\t// Carried, not executed: kept apart with where and when it ran\n\t\t\t// (spec pose-validate-carry-report-and-closeout-coverage R1, R2).\n\t\t\tsummary.Carried = append(summary.Carried, fmt.Sprintf(\"[%s] %s (carried from %s, generated at %s)\", check.Outcome, check.ID, check.CarriedFrom, check.CarriedGeneratedAt))\n\t\t\tcontinue\n\t\t}\n\t\tcommand := strings.TrimSpace(check.Program + \" \" + strings.Join(check.Args, \" \"))\n\t\tif check.Outcome != \"skipped\" && command != \"\" {\n\t\t\tsummary.Commands = append(summary.Commands, command)\n\t\t}\n\t\tline := \"- [\" + check.Outcome + \"] \" + check.ID\n\t\tswitch {\n\t\tcase check.SkipReason != \"\":\n\t\t\tline += \" (\" + check.SkipReason + \")\"\n\t\tcase check.DurationSeconds > 0:\n\t\t\tline += fmt.Sprintf(\" (%.1fs)\", check.DurationSeconds)\n\t\t}\n\t\tif check.ExitCode != nil {\n\t\t\tline += fmt.Sprintf(\" exit=%d\", *check.ExitCode)\n\t\t}\n\t\tsummary.Results = append(summary.Results, line)\n\t}\n\t// The report records the run's verdict too, built from the outcome rather\n\t// than copied from the printed line, so the recorded evidence keeps its\n\t// shape while the terminal is free to change.\n\tif run.Counts.OptionalFailed > 0 {\n\t\tsummary.Results = append(summary.Results, fmt.Sprintf(\"Warning: %d optional check(s) failed.\", run.Counts.OptionalFailed))\n\t}\n\tswitch run.Outcome {\n\tcase \"fail\":\n\t\tsummary.Results = append(summary.Results, \"Result: FAILURE (required check failed)\")\n\tdefault:\n\t\tsummary.Results = append(summary.Results, \"Result: SUCCESS\")\n\t}\n\treturn summary\n}\n\nfunc sanitizeGoCheckArgs(ctx context.Context, dir, program string, args []string) []string {\n\tif program != \"go\" || len(args) == 0 {\n\t\treturn args\n\t}\n\n\thasWildcard := false\n\tfor _, a := range args {\n\t\tif a == \"./...\" || strings.HasSuffix(a, \"/...\") {\n\t\t\thasWildcard = true\n\t\t\tbreak\n\t\t}\n\t}\n\tif !hasWildcard {\n\t\treturn args\n\t}\n\n\thasNodeModules := false\n\t_ = filepath.WalkDir(dir, func(p string, d os.DirEntry, err error) error {\n\t\tif err == nil && d.IsDir() && d.Name() == \"node_modules\" {\n\t\t\thasNodeModules = true\n\t\t\treturn filepath.SkipDir","numLines":230,"startLine":1450,"totalLines":1821}},"tool_result_meta":[{"id":"toolu_01Wt9n51y6Bpxe2GhRqi1Xvx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
