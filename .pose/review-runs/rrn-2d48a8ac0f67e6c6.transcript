 string) {\n+\t\tp := filepath.Join(root, rel)\n+\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tspec := func(limits string) string {\n+\t\treturn \"---\\nslug: limited\\nstatus: draft\\ncreated_at: 2026-11-25\\n---\\n\\n# Spec: limited\\n\\n## 1. Intent\\n\\n### Goal\\nA goal worth stating.\\n\\n## 2. Requirements\\n\\n### Functional\\n- R1: It works.\\n\\n## 3. Technical Plan\\n\\n### Affected areas\\nThe engine.\\n\" + limits + \"\\n## 4. Tasks\\n- [ ] Do it.\\n\"\n+\t}\n+\tpath := filepath.Join(root, \".pose/specs/limited/spec.md\")\n+\trun := func() (int, string) {\n+\t\tvar out, errOut bytes.Buffer\n+\t\tcode := lintOneSpec(path, false, true, &out, &errOut)\n+\t\treturn code, out.String() + errOut.String()\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n\"))\n+\tif code, out := run(); code != 0 {\n+\t\tt.Fatalf(\"a justified limit failed the ready check: %d %s\", code, out)\n+\t}\n+\t// Spec pose-review-declared-limits-followups, review round 1, N1: the\n+\t// ready check reads the raw spec, as the plan does, so a comment in the\n+\t// section fails it instead of passing a section the plan refuses.\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because <!-- x --> it is rare.\\n\"))\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"comment marker\") {\n+\t\tt.Fatalf(\"a comment in the limits passed the ready check: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape with no reason.\\n\"))\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"does not say why it is accepted\") {\n+\t\tt.Fatalf(\"an unjustified limit passed: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n- L2: another escape. Accepted because it is rarer.\\n\"))\n+\t// Review round 1, N3: L10 does not name L1.\n+\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited`. L10 and L2 are accepted.\\n\")\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"accepted limit L1 is not named by the ADR\") {\n+\t\tt.Fatalf(\"L10 was taken as naming L1: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited`. L1 is accepted.\\n\")\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"accepted limit L2 is not named by the ADR\") {\n+\t\tt.Fatalf(\"a limit the ADR omits passed: %d %s\", code, out)\n+\t}\n+\t// Review round 5, N2: an ADR that cannot be read fails the check closed.\n+\tif os.Geteuid() != 0 {\n+\t\tadr := filepath.Join(root, \".pose/adr/2026-11-25-limited.md\")\n+\t\tif err := os.Chmod(adr, 0o000); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif code, out := run(); code == 0 || !strings.Contains(out, \"cannot be read to check the accepted limits\") {\n+\t\t\tt.Fatalf(\"an unreadable ADR was read as absent: %d %s\", code, out)\n+\t\t}\n+\t\tif err := os.Chmod(adr, 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\t// Review round 8, N4: an ADR about a longer slug does not cite this one.\n+\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited-other`. Nothing about this spec.\\n\")\n+\tif code, out := run(); code != 0 {\n+\t\tt.Fatalf(\"an ADR citing a longer slug was taken to cite this spec: %d %s\", code, out)\n+\t}\n+\t// Review round 9, N3: an ADR that links the spec's dated file cites it.\n+\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nSee [the spec](../specs/2026-11-25-limited.md).\\n\")\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"L1\") {\n+\t\tt.Fatalf(\"an ADR linking the spec file was not taken to cite it: %d %s\", code, out)\n+\t}\n+\t// Review round 7, N2: an ADR that is a link is not followed.\n+\tadr := filepath.Join(root, \".pose/adr/2026-11-25-limited.md\")\n+\t_ = os.Chmod(adr, 0o644)\n+\t_ = os.Remove(adr)\n+\tif err := os.Symlink(\"/dev/zero\", adr); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tdone := make(chan struct{})\n+\tvar code int\n+\tvar out string\n+\tgo func() { code, out = run(); close(done) }()\n+\tselect {\n+\tcase <-done:\n+\tcase <-time.After(10 * time.Second):\n+\t\tt.Fatal(\"the ready check followed an ADR link to an endless source\")\n+\t}\n+\tif code == 0 || !strings.Contains(out, \"cannot be read to check the accepted limits\") {\n+\t\tt.Fatalf(\"an ADR link was read: %d %s\", code, out)\n+\t}\n+}\n+\n+// Spec pose-review-declared-limits-followups R3, R6: a within-limit finding\n+// can be typed with its limit, and the checks' text output shows it.\n+func TestWithinLimitFindingsAreTypedAndShown(t *testing.T) {\n+\tfindings, err := parseCLIReviewFindings([]string{\"n1|low|within-limit|-|-||why it is inside||L1\"})\n+\tif err != nil || len(findings) != 1 || findings[0].Limit != \"L1\" || findings[0].Rationale != \"why it is inside\" {\n+\t\tt.Fatalf(\"a typed within-limit finding: %+v %v\", findings, err)\n+\t}\n+\tvar out bytes.Buffer\n+\trenderWithinLimitFindings(render(&out, &out), \"review\", &posemodel.ReviewAttempt{Findings: []posemodel.ReviewFinding{{ID: \"N1\", Severity: \"low\", Disposition: \"within-limit\", Limit: \"L1\", Rationale: \"inside\"}, {ID: \"N2\", Disposition: \"accepted-risk\"}}})\n+\tif !strings.Contains(out.String(), \"N1 limit:L1\") || strings.Contains(out.String(), \"N2\") {\n+\t\tt.Fatalf(\"the text output: %q\", out.String())\n+\t}\n+}\n+\n+// Spec pose-review-declared-limits-residuals R7: pose review-check and pose\n+// closeout-check print a recorded within-limit finding.\n+func TestTheChecksPrintWithinLimitFindings(t *testing.T) {\n+\troot := reviewBundleCLIFixture(t)\n+\tspec := filepath.Join(root, \".pose/specs/bundle/spec.md\")\n+\traw, err := os.ReadFile(spec)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.WriteFile(spec, []byte(strings.Replace(string(raw), \"### Risks\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\\n### Risks\", 1)), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor _, args := range [][]string{{\"add\", \"-A\"}, {\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-q\", \"-m\", \"limits\"}} {\n+\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...).CombinedOutput(); err != nil {\n+\t\t\tt.Fatal(args, err, string(out))\n+\t\t}\n+\t}\n+\tvar out, errOut bytes.Buffer\n+\tif code := cmdReview(root, []string{\"bundle\", \"spec:bundle\", \"--seal\", \"--json\"}, &out, &errOut); code != 0 {\n+\t\tt.Fatalf(\"seal code=%d err=%s\", code, errOut.String())\n+\t}\n+\tvar sealed posemodel.ReviewBundle\n+\tif err := json.Unmarshal(out.Bytes(), &sealed); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tevidence := sealed.Payload.Evidence[0].EvidenceClass + \":\" + sealed.Payload.Evidence[0].ID\n+\tout.Reset()\n+\terrOut.Reset()\n+\tattest := []string{\"attest\", sealed.BundleID, \"--reviewer\", \"agent:reviewer\", \"--decision\", \"approved\", \"--evidence\", evidence, \"--tool\", \"artifact-check|-|passed|check:artifact|\", \"--tool\", \"validate|pose-mcp|passed|validation:module|\", \"--finding\", \"n1|low|within-limit|note it|\" + evidence + \"||it is inside L1||L1\", \"--apply\"}\n+\tif code := cmdReview(root, attest, &out, &errOut); code != 0 {\n+\t\tt.Fatalf(\"attest code=%d out=%s err=%s\", code, out.String(), errOut.String())\n+\t}\n+\trun := func(args ...string) string {\n+\t\tvar o, e bytes.Buffer\n+\t\tinDir(t, root, func() { Main(args, &o, &e) })\n+\t\treturn o.String() + e.String()\n+\t}\n+\tfor _, tc := range []struct{ out, field string }{\n+\t\t{run(\"review-check\", \"spec:bundle\"), \"review.within_limit=\"},\n+\t\t{run(\"closeout-check\", \"spec:bundle\"), \"closeout.within_limit=\"},\n+\t} {\n+\t\tif !strings.Contains(tc.out, tc.field) || !strings.Contains(tc.out, \"n1 limit:L1\") {\n+\t\t\tt.Fatalf(\"%s missing:\\n%s\", tc.field, tc.out)\n+\t\t}\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/assess.go b/pose-mcp/internal/cli/assess.go\nindex c14c93bb..9d9ae734 100644\n--- a/pose-mcp/internal/cli/assess.go\n+++ b/pose-mcp/internal/cli/assess.go\n@@ -55,8 +55,30 @@ func loadCapabilityPolicy(root string) capabilityPolicy {\n \treturn loadCapabilityPolicyIn(pose.NativeFiles(), root)\n }\n \n+// assessPersists reports whether an assess command may write its records:\n+// not with --no-persist, and never in the sealed checkout of a delegated\n+// review (spec pose-assess-leaves-sealed-checkouts-alone R1, R2).\n+func assessPersists(root string, args []string) (bool, string) {\n+\tfor _, a := range args {\n+\t\tif a == \"--no-persist\" {\n+\t\t\treturn false, \"not persisted (--no-persist)\"\n+\t\t}\n+\t}\n+\tif pose.IsSealedCheckout(root) {\n+\t\treturn false, \"not persisted: this is the sealed checkout of a delegated review\"\n+\t}\n+\treturn true, \"\"\n+}\n+\n func cmdAssess(root string, args []string, stdout, stderr io.Writer) int {\n \tlocale := cliLocaleValue()\n+\tif len(args) > 0 && pose.IsSealedCheckout(root) {\n+\t\tswitch args[0] {\n+\t\tcase \"init\", \"snapshot\", \"request\":\n+\t\t\trender(stdout, stderr).Failure(\"pose assess \" + args[0] + \": writes the capability assessment, which a sealed review checkout does not take\")\n+\t\t\treturn 1\n+\t\t}\n+\t}\n \tif len(args) > 0 {\n \t\tswitch args[0] {\n \t\tcase \"init\":\n@@ -630,6 +652,7 @@ func assessDiscover(root string, args []string, stdout, stderr io.Writer, locale\n \t\t\tifStale = true\n \t\t}\n \t}\n+\tpersist, persistNote := assessPersists(root, args)\n \n \tstore := pose.Store{Root: root}\n \tvar targets []string\n@@ -662,9 +685,11 @@ func assessDiscover(root string, args []string, stdout, stderr io.Writer, locale\n \t\t\tfmt.Fprintf(stderr, \"pose assess discover %s: %v\\n\", t, err)\n \t\t\treturn 1\n \t\t}\n-\t\tif err := store.SaveComponentState(state); err != nil {\n-\t\t\tfmt.Fprintf(stderr, \"pose assess discover save %s: %v\\n\", t, err)\n-\t\t\treturn 1\n+\t\tif persist {\n+\t\t\tif err := store.SaveComponentState(state); err != nil {\n+\t\t\t\tfmt.Fprintf(stderr, \"pose assess discover save %s: %v\\n\", t, err)\n+\t\t\t\treturn 1\n+\t\t\t}\n \t\t}\n \t\tresults = append(results, state)\n \t}\n@@ -677,12 +702,14 @@ func assessDiscover(root string, args []string, stdout, stderr io.Writer, locale\n \tif targetComp != \"\" {\n \t\tconsolidated = mergeWithPersistedComponentStates(store, results)\n \t}\n-\tif err := store.GenerateConsolidatedAssessment(consolidated); err != nil {\n-\t\tfmt.Fprintf(stderr, \"pose assess discover consolidate: %v\\n\", err)\n-\t\treturn 1\n+\tif persist {\n+\t\tif err := store.GenerateConsolidatedAssessment(consolidated); err != nil {\n+\t\t\tfmt.Fprintf(stderr, \"pose assess discover consolidate: %v\\n\", err)\n+\t\t\treturn 1\n+\t\t}\n \t}\n \n-\tif updateState {\n+\tif updateState && persist {\n \t\t// The state is built from what this run observed: a persisted record of a component\n \t\t// that is no longer there is not part of it. What was recorded and cannot be read is\n \t\t// carried as a loss, so the state does not read as a certified total.\n@@ -700,6 +727,9 @@ func assessDiscover(root string, args []string, stdout, stderr io.Writer, locale\n \t\t}\n \t}\n \n+\tif !persist {\n+\t\trender(stdout, stderr).Hint(\"pose assess: \" + persistNote)\n+\t}\n \tif asJSON {\n \t\tenc, _ := json.MarshalIndent(results, \"\", \"  \")\n \t\tfmt.Fprintln(stdout, string(enc))\n@@ -855,12 +885,17 @@ func assessIntegrate(root string, args []string, stdout, stderr io.Writer, local\n \t\treturn 1\n \t}\n \n-\tif err := store.SaveIntegrationMatrix(matrix); err != nil {\n-\t\tfmt.Fprintf(stderr, \"pose assess integrate save: %v\\n\", err)\n-\t\treturn 1\n+\tpersist, persistNote := assessPersists(root, args)\n+\tif persist {\n+\t\tif err := store.SaveIntegrationMatrix(matrix); err != nil {\n+\t\t\tfmt.Fprintf(stderr, \"pose assess integrate save: %v\\n\", err)\n+\t\t\treturn 1\n+\t\t}\n+\t} else {\n+\t\trender(stdout, stderr).Hint(\"pose assess: \" + persistNote)\n \t}\n \n-\tif updateState {\n+\tif updateState && persist {\n \t\tif err := updateProjectStateArchitecture(root, nil); err != nil {\n \t\t\tfmt.Fprintf(stderr, \"pose assess integrate update-state: %v\\n\", err)\n \t\t\treturn 1\n@@ -883,7 +918,9 @@ func assessIntegrate(root string, args []string, stdout, stderr io.Writer, local\n \t\t\tg.GapID, g.Title, g.Severity, g.Provider, g.Consumer, g.Description)\n \t}\n \n-\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/integrations.md and .pose/state/integrations.json\\n\")\n+\tif persist {\n+\t\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/integrations.md and .pose/state/integrations.json\\n\")\n+\t}\n \treturn 0\n }\n \n@@ -907,12 +944,17 @@ func assessTechDebt(root string, args []string, stdout, stderr io.Writer, locale\n \t\treturn 1\n \t}\n \n-\tif err := store.SaveTechDebtReport(report); err != nil {\n-\t\tfmt.Fprintf(stderr, \"pose assess tech-debt save: %v\\n\", err)\n-\t\treturn 1\n+\tpersist, persistNote := assessPersists(root, args)\n+\tif persist {\n+\t\tif err := store.SaveTechDebtReport(report); err != nil {\n+\t\t\tfmt.Fprintf(stderr, \"pose assess tech-debt save: %v\\n\", err)\n+\t\t\treturn 1\n+\t\t}\n+\t} else {\n+\t\trender(stdout, stderr).Hint(\"pose assess: \" + persistNote)\n \t}\n \n-\tif updateState {\n+\tif updateState && persist {\n \t\tif err := updateProjectStateArchitecture(root, nil); err != nil {\n \t\t\tfmt.Fprintf(stderr, \"pose assess tech-debt update-state: %v\\n\", err)\n \t\t\treturn 1\n@@ -941,6 +983,8 @@ func assessTechDebt(root string, args []string, stdout, stderr io.Writer, locale\n \tfor _, exclusion := range report.Coverage.Exclusions {\n \t\tscope.Field(\"techdebt.excluded\", fmt.Sprintf(\"%s: %d file(s) — %s\", exclusion.Pattern, exclusion.Count, exclusion.Reason))\n \t}\n-\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/technical-debt.md and .pose/state/technical-debt.json\\n\")\n+\tif persist {\n+\t\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/technical-debt.md and .pose/state/technical-debt.json\\n\")\n+\t}\n \treturn 0\n }\ndiff --git a/pose-mcp/internal/cli/assess_sealed_test.go b/pose-mcp/internal/cli/assess_sealed_test.go\nnew file mode 100644\nindex 00000000..2d789a29\n--- /dev/null\n+++ b/pose-mcp/internal/cli/assess_sealed_test.go\n@@ -0,0 +1,107 @@\n+package cli\n+\n+import (\n+\t\"crypto/sha256\"\n+\t\"encoding/hex\"\n+\t\"io/fs\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"sort\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/harne8/pose-mcp/internal/pose\"\n+)\n+\n+// treeDigest names every file under root with its content, so any write,\n+// creation or removal changes it.\n+func treeDigest(t *testing.T, root string) string {\n+\tt.Helper()\n+\tvar lines []string\n+\terr := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {\n+\t\tif err != nil || d.IsDir() {\n+\t\t\treturn err\n+\t\t}\n+\t\traw, err := os.ReadFile(path)\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\tsum := sha256.Sum256(raw)\n+\t\trel, _ := filepath.Rel(root, path)\n+\t\tlines = append(lines, rel+\" \"+hex.EncodeToString(sum[:]))\n+\t\treturn nil\n+\t})\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tsort.Strings(lines)\n+\treturn strings.Join(lines, \"\\n\")\n+}\n+\n+func assessSealedRoot(t *testing.T) string {\n+\tt.Helper()\n+\troot := assessTestRoot(t)\n+\twriteCloseoutCLIFile(t, root, \"svc/main.go\", \"package main\\n\\n// TODO: a marker\\nfunc main() {}\\n\")\n+\twriteCloseoutCLIFile(t, root, \"svc/go.mod\", \"module example.com/svc\\n\\ngo 1.22\\n\")\n+\twriteCloseoutCLIFile(t, root, \".pose/state/project-state.md\", \"# Project state\\n\")\n+\treturn root\n+}\n+\n+// Spec pose-assess-leaves-sealed-checkouts-alone R2, R4: inside the sealed\n+// checkout of a delegated review every assessment command leaves the tree\n+// as it was, and the ones that only write refuse.\n+func TestAssessLeavesTheSealedCheckoutUnchanged(t *testing.T) {\n+\troot := assessSealedRoot(t)\n+\tt.Setenv(pose.SealedCheckoutEnv, root)\n+\tbefore := treeDigest(t, root)\n+\tfor _, args := range [][]string{\n+\t\t{\"discover\"}, {\"discover\", \"--update-state\"}, {\"discover\", \"--component\", \"svc\", \"--if-stale\"},\n+\t\t{\"integrate\"}, {\"integrate\", \"--update-state\", \"--json\"},\n+\t\t{\"tech-debt\"}, {\"tech-debt\", \"--update-state\"},\n+\t} {\n+\t\tcode, out, errOut := runAssess(t, root, args...)\n+\t\tif code != 0 || !strings.Contains(errOut, \"sealed checkout of a delegated review\") {\n+\t\t\tt.Fatalf(\"assess %v: %d %s %s\", args, code, out, errOut)\n+\t\t}\n+\t\tif strings.Contains(out, \"Artifacts written\") {\n+\t\t\tt.Fatalf(\"assess %v claims it wrote: %s\", args, out)\n+\t\t}\n+\t\tif after := treeDigest(t, root); after != before {\n+\t\t\tt.Fatalf(\"assess %v changed the sealed checkout:\\n%s\\n---\\n%s\", args, before, after)\n+\t\t}\n+\t}\n+\tfor _, sub := range []string{\"init\", \"snapshot\", \"request\"} {\n+\t\tif code, _, errOut := runAssess(t, root, sub); code == 0 || !strings.Contains(errOut, \"sealed review checkout\") {\n+\t\t\tt.Fatalf(\"assess %s ran in the sealed checkout: %d %s\", sub, code, errOut)\n+\t\t}\n+\t}\n+\tif after := treeDigest(t, root); after != before {\n+\t\tt.Fatal(\"a refused assess command changed the sealed checkout\")\n+\t}\n+\t// The writers refuse on their own, for any other caller.\n+\tif err := (pose.Store{Root: root}).SaveTechDebtReport(&pose.TechDebtReportState{}); err != pose.ErrSealedAssessmentWrite {\n+\t\tt.Fatalf(\"the tech-debt writer wrote into the sealed checkout: %v\", err)\n+\t}\n+}\n+\n+// R1: --no-persist prints the result and writes nothing anywhere; without it\n+// and outside a sealed checkout the records are written as before.\n+func TestAssessNoPersistWritesNothing(t *testing.T) {\n+\troot := assessSealedRoot(t)\n+\tbefore := treeDigest(t, root)\n+\tfor _, sub := range []string{\"discover\", \"integrate\", \"tech-debt\"} {\n+\t\tcode, out, errOut := runAssess(t, root, sub, \"--no-persist\", \"--update-state\")\n+\t\tif code != 0 || !strings.Contains(errOut, \"--no-persist\") || out == \"\" {\n+\t\t\tt.Fatalf(\"assess %s --no-persist: %d %s %s\", sub, code, out, errOut)\n+\t\t}\n+\t\tif after := treeDigest(t, root); after != before {\n+\t\t\tt.Fatalf(\"assess %s --no-persist wrote\", sub)\n+\t\t}\n+\t}\n+\tif code, _, errOut := runAssess(t, root, \"tech-debt\"); code != 0 {\n+\t\tt.Fatal(errOut)\n+\t}\n+\tif _, err := os.Stat(filepath.Join(root, \".pose/state/technical-debt.json\")); err != nil {\n+\t\tt.Fatalf(\"a persisting run outside a sealed checkout wrote nothing: %v\", err)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/check.go b/pose-mcp/internal/cli/check.go\nindex 991e096c..980ec58a 100644\n--- a/pose-mcp/internal/cli/check.go\n+++ b/pose-mcp/internal/cli/check.go\n@@ -1,6 +1,7 @@\n package cli\n \n import (\n+\t\"bytes\"\n \t\"context\"\n \t\"encoding/json\"\n \t\"fmt\"\n@@ -1128,11 +1129,34 @@ func (checker *nativeChecker) readyTransitionCandidates() []string {\n \t}\n \tchanged := map[string]bool{}\n \tfor _, command := range [][]string{\n-\t\t{\"diff\", \"--name-only\", \"HEAD\", \"--\", \".pose/specs\"},\n+\t\t// --relative: with the root below the repository top, Git names the\n+\t\t// paths top-relative otherwise and the filter below drops them (spec\n+\t\t// pose-validate-index-reads-residuals R1).\n+\t\t{\"diff\", \"--relative\", \"--name-only\", \"HEAD\", \"--\", \".pose/specs\"},\n \t\t{\"ls-files\", \"--others\", \"--exclude-standard\", \"--\", \".pose/specs\"},\n \t} {\n-\t\toutput, err := pose.RawHistoryGit(checker.root, command...).Output()\n+\t\t// The diff reads the index without writing it (spec\n+\t\t// pose-validate-reads-leave-the-index-alone R1).\n+\t\tcmd := pose.RawHistoryGit(checker.root, command...)\n+\t\tdone := func() {}\n+\t\tif command[0] == \"diff\" {\n+\t\t\tvar err error\n+\t\t\tif done, err = pose.ReadOnlyIndex(cmd, checker.root); err != nil {\n+\t\t\t\tdone()\n+\t\t\t\t// The specs this read would name go unchecked: say so\n+\t\t\t\t// (review round 5, N23).\n+\t\t\t\tchecker.failOrWarn(checker.message(fmt.Sprintf(\"ready transitions: the changed specs cannot be listed: %v\", err), fmt.Sprintf(\"transições de prontidão: as specs alteradas não podem ser listadas: %v\", err)))\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t}\n+\t\tvar stderr bytes.Buffer\n+\t\tcmd.Stderr = &stderr\n+\t\tpose.GitEnglish(cmd)\n+\t\toutput, err := cmd.Output()\n+\t\tdone()\n \t\tif err != nil {\n+\t\t\terr = pose.GitReadError(\"git \"+command[0], err, stderr.Bytes())\n+\t\t\tchecker.failOrWarn(checker.message(fmt.Sprintf(\"ready transitions: the changed specs cannot be listed: %v\", err), fmt.Sprintf(\"transições de prontidão: as specs alteradas não podem ser listadas: %v\", err)))\n \t\t\tcontinue\n \t\t}\n \t\tfor _, rel := range strings.Fields(string(output)) {\n@@ -1155,7 +1179,10 @@ func (checker *nativeChecker) checkReadyTransition(rel string) {\n \tif simpleFrontmatterIn(checker.fsys(), path)[\"status\"] != \"in-progress\" {\n \t\treturn\n \t}\n-\told, _ := pose.RawHistoryGit(checker.root, \"show\", \"HEAD:\"+rel).Output()\n+\t// HEAD:./ is relative to the root, as the candidates are; HEAD: alone\n+\t// resolves from the repository top (spec\n+\t// pose-validate-index-reads-residuals, review round 1, N1).\n+\told, _ := pose.RawHistoryGit(checker.root, \"show\", \"HEAD:./\"+rel).Output()\n \tif frontmatterFromText(string(old))[\"status\"] == \"in-progress\" {\n \t\treturn\n \t}\ndiff --git a/pose-mcp/internal/cli/cli.go b/pose-mcp/internal/cli/cli.go\nindex 5bb875d0..29930fe2 100644\n--- a/pose-mcp/internal/cli/cli.go\n+++ b/pose-mcp/internal/cli/cli.go\n@@ -25,6 +25,9 @@ func init() {\n \n // Main is the entrypoint used by cmd/pose. It returns the process exit code.\n func Main(args []string, stdout, stderr io.Writer) int {\n+\tif len(args) > 0 && args[0] == posemodel.ReviewShimArg {\n+\t\treturn posemodel.RunReviewShim(args[1:])\n+\t}\n \treturn mainWithUsage(args, stdout, stderr)\n }\n \ndiff --git a/pose-mcp/internal/cli/cli_test.go b/pose-mcp/internal/cli/cli_test.go\nindex 7d5d1239..bb39972b 100644\n--- a/pose-mcp/internal/cli/cli_test.go\n+++ b/pose-mcp/internal/cli/cli_test.go\n@@ -16,6 +16,11 @@ import (\n )\n \n func TestMain(m *testing.M) {\n+\t// A dispatch re-enters this binary as the review run shim.\n+\tif len(os.Args) > 1 && os.Args[1] == posemodel.ReviewShimArg {\n+\t\tos.Exit(posemodel.RunReviewShim(os.Args[2:]))\n+\t}\n+\tposemodel.ReviewShimAvailable = true\n \tif posemodel.EngineVersion == \"unknown\" {\n \t\tposemodel.EngineVersion = \"pose-test-engine\"\n \t}\ndiff --git a/pose-mcp/internal/cli/delegate.go b/pose-mcp/internal/cli/delegate.go\nindex 68bc3831..d4985971 100644\n--- a/pose-mcp/internal/cli/delegate.go\n+++ b/pose-mcp/internal/cli/delegate.go\n@@ -63,7 +63,7 @@ type delegateFlags struct {\n \trequest                                      string\n \tto, cd, effort, promptFile, session          string\n \taddDirs                                      []string\n-\tnoNetwork, record                            bool\n+\tnoNetwork, record, confirmAbandoned          bool\n \tdryRun, jsonOut, active, wait, detach        bool\n \tverbose, noFollow                            bool\n \tlines                                        int\n@@ -91,7 +91,7 @@ func parseDelegateFlags(args []string, extra ...string) (delegateFlags, string)\n \t\t\treturn f, tr(\"unknown or inapplicable flag \"+name, \"flag desconhecida ou inaplicável \"+name)\n \t\t}\n \t\tswitch name {\n-\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\":\n+\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\", \"--confirm-abandoned\":\n \t\t\tif hasInline {\n \t\t\t\treturn f, tr(name+\" takes no value\", name+\" não recebe valor\")\n \t\t\t}\n@@ -108,6 +108,8 @@ func parseDelegateFlags(args []string, extra ...string) (delegateFlags, string)\n \t\t\t\tf.noNetwork = true\n \t\t\tcase \"--record\":\n \t\t\t\tf.record = true\n+\t\t\tcase \"--confirm-abandoned\":\n+\t\t\t\tf.confirmAbandoned = true\n \t\t\tcase \"--no-follow\":\n \t\t\t\tf.noFollow = true\n \t\t\tdefault:\n@@ -454,6 +456,11 @@ func cmdDelegatePurpose(root, purpose string, args []string, stdout, stderr io.W\n \t}\n \tnotes := \"\"\n \tif f.noteFile != \"\" {\n+\t\t// R5 of spec pose-review-readiness-before-seal: an oversized note is\n+\t\t// named with its size and the limit, not as a generic adapter file.\n+\t\tif info, err := os.Lstat(f.noteFile); err == nil && info.Mode().IsRegular() && info.Size() > posemodel.ReviewNotesMaxBytes {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, fmt.Errorf(\"the note file %s has %d bytes; implementer notes must be at most %d bytes: shorten it\", f.noteFile, info.Size(), posemodel.ReviewNotesMaxBytes))\n+\t\t}\n \t\traw, err := posemodel.ReadReviewAdapterFile(f.noteFile, posemodel.ReviewNotesMaxBytes)\n \t\tif err != nil {\n \t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n@@ -924,6 +931,9 @@ func cmdDelegateLs(root string, args []string, stdout, stderr io.Writer) int {\n \t\t\tif a.StalledAt != \"\" {\n \t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n \t\t\t}\n+\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n+\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n+\t\t\t}\n \t\t\tif a.HookFailure != \"\" {\n \t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n \t\t\t}\n@@ -1100,9 +1110,9 @@ func cmdDelegateResume(root string, args []string, stdout, stderr io.Writer) int\n }\n \n func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n-\tf, problem := parseDelegateFlags(args)\n+\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n \tif problem != \"\" {\n-\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--dry-run] [--json]\")\n+\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n \t}\n \tstore := posemodel.Store{Root: root}\n \tattempts, lost, err := store.ListDelegationAttempts()\n@@ -1113,6 +1123,38 @@ func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int\n \tif err != nil {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n \t}\n+\tif !attempt.Active && !f.dryRun {\n+\t\t// An attempt whose dispatch, or whose earlier release, ended before\n+\t\t// its receipt is released with a failed run and its receipt, so it\n+\t\t// stops blocking the bundle; the release proves the abandonment\n+\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n+\t\t// review round 4, N1).\n+\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n+\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n+\t\t}\n+\t\tif err != nil {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n+\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n+\t\t}\n+\t\tif f.jsonOut {\n+\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n+\t\t\treturn 0\n+\t\t}\n+\t\tout := render(stdout, stderr)\n+\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n+\t\tswitch {\n+\t\tcase run.RunID == \"\":\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n+\t\tcase run.Status == posemodel.ReviewRunFailed && strings.HasPrefix(run.Failure, posemodel.DelegationAbandonedCause):\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n+\t\tdefault:\n+\t\t\t// The attempt had a run already: its receipt was completed with\n+\t\t\t// it (review round 11, N3).\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: completed with run \"+run.RunID+\", already recorded as \"+run.Status, \"true: concluída com o run \"+run.RunID+\", já registrado como \"+run.Status))\n+\t\t}\n+\t\treturn 0\n+\t}\n \tif !attempt.Active {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n \t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\ndiff --git a/pose-mcp/internal/cli/delegate_rounds_test.go b/pose-mcp/internal/cli/delegate_rounds_test.go\nindex a6b193df..354e03f3 100644\n--- a/pose-mcp/internal/cli/delegate_rounds_test.go\n+++ b/pose-mcp/internal/cli/delegate_rounds_test.go\n@@ -7,6 +7,7 @@ import (\n \t\"path/filepath\"\n \t\"strings\"\n \t\"testing\"\n+\t\"time\"\n \n \tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n )\n@@ -242,3 +243,49 @@ func TestReviewRoundsSurviveLossesAndResumes(t *testing.T) {\n \t\tt.Fatalf(\"a resumed continued round counted as cold: %s\", out)\n \t}\n }\n+\n+// Spec pose-review-resume-runtime-dir-followups R3: a round that continues\n+// its thread recreates the checkout under the previous round's runtime name;\n+// review round 1, N2: when that path is held, the round opens a new session\n+// in its own directory instead of failing after its attempt is reserved.\n+func TestReviewRoundsKeepTheCheckoutPathOfTheirThread(t *testing.T) {\n+\troot := dispatchInstance(t)\n+\twriteDelegation(t, root, delegationPolicy(roundsAgent(\"rounder\", \"other\", false)))\n+\tfirst := runRecord(t, root, roundRun(t, root, \"rounder\")[\"run\"].(string))\n+\tnextReviewRound(t, root, \"fix B1\")\n+\tsecond := runRecord(t, root, roundRun(t, root, \"rounder\")[\"run\"].(string))\n+\tif second.Thread == nil || second.Thread.Mode != posemodel.ReviewThreadContinued || second.Safety == nil || first.Safety == nil || second.Safety.RuntimeID != first.Safety.RuntimeID {\n+\t\tt.Fatalf(\"a continued round moved its checkout: thread=%+v first=%v second=%v\", second.Thread, first.Safety, second.Safety)\n+\t}\n+\tnextReviewRound(t, root, \"fix B2","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/home/go/.claude/projects/-var-tmp-pose-work-go-pose-review-run-6851f68889-worktree/[private-session]/tool-results/bjxms2qpp.txt","persistedOutputSize":530733},"tool_result_meta":[{"id":"toolu_01MsdqiVhcuZYsrcu3LuhQzu","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
