{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011z2RQZPa1C9RdEGh7qPRLt","type":"tool_result","content":"290\t\tsort.SliceStable(result, func(i, j int) bool {\n291\t\t\tif order[result[i].Phase] != order[result[j].Phase] {\n292\t\t\t\treturn order[result[i].Phase] < order[result[j].Phase]\n293\t\t\t}\n294\t\t\treturn result[i].Tool.ID < result[j].Tool.ID\n295\t\t})\n296\t\treturn result\n297\t}\n298\t\n299\tfunc cmdCloseoutCheck(root string, args []string, stdout, stderr io.Writer) int {\n300\t\tref, jsonOutput, ok := parseScopeCheckArgs(\"closeout-check\", args, stderr)\n301\t\tif !ok {\n302\t\t\treturn 2\n303\t\t}\n304\t\tstore, localRef, err := cliReviewStore(root, ref)\n305\t\tif err != nil {\n306\t\t\trender(io.Discard, stderr).Failure(\"pose closeout-check: \" + err.Error())\n307\t\t\treturn 1\n308\t\t}\n309\t\troot, ref = store.Root, localRef\n310\t\tstate, err := cliCloseoutStateForStore(store, ref)\n311\t\tif err != nil {\n312\t\t\tfmt.Fprintf(stderr, \"pose closeout-check: %v\\n\", err)\n313\t\t\treturn 1\n314\t\t}\n315\t\tif jsonOutput {\n316\t\t\tif code := writeJSON(stdout, state); code != 0 {\n317\t\t\t\treturn code\n318\t\t\t}\n319\t\t\tif !state.Terminal {\n320\t\t\t\treturn 1\n321\t\t\t}\n322\t\t\treturn 0\n323\t\t}\n324\t\tfmt.Fprintf(stdout, \"closeout.scope=%s\\ncloseout.digest=%s\\ncloseout.lifecycle_done=%t\\ncloseout.review_approved=%t\\ncloseout.terminal=%t\\ncloseout.next_action=%s\\n\", state.Scope, state.ScopeDigest, state.LifecycleDone, state.Review.Approved, state.Terminal, state.NextAction)\n325\t\tif state.Review.Assurance != nil {\n326\t\t\trender(stdout, stderr).Field(\"closeout.review_assurance\", posemodel.RenderReviewAssurance(*state.Review.Assurance))\n327\t\t}\n328\t\trenderWithinLimitFindings(render(stdout, stderr), \"closeout\", state.Review.Current)\n329\t\tfor _, blocker := range state.Blockers {\n330\t\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n331\t\t}\n332\t\tif !state.Terminal {\n333\t\t\treturn 1\n334\t\t}\n335\t\treturn 0\n336\t}\n337\t\n338\tfunc cliCloseoutState(root, ref string) (posemodel.CloseoutState, error) {\n339\t\treturn cliCloseoutStateIn(root, ref, posemodel.NativeFiles())\n340\t}\n341\t\n342\tfunc cliCloseoutStateIn(root, ref string, files posemodel.Files) (posemodel.CloseoutState, error) {\n343\t\tfiles = posemodel.FilesOrNative(files)\n344\t\tresolver, project, err := posemodel.EnvironmentArtifactResolverIn(files, root, \"\")\n345\t\tif err != nil {\n346\t\t\treturn posemodel.CloseoutState{}, fmt.Errorf(\"invalid project configuration\")\n347\t\t}\n348\t\tstore := posemodel.Store{Root: root, FS: files, FederatedProjectID: project, FederatedResolver: &resolver}\n349\t\treturn cliCloseoutStateForStore(store, ref)"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"fcd409b1-3468-4f92-8665-48a5640f0818","timestamp":"2026-11-28T13:42:07.719Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-6851f68889/worktree/pose-mcp/internal/cli/review_closeout.go","content":"\tsort.SliceStable(result, func(i, j int) bool {\n\t\tif order[result[i].Phase] != order[result[j].Phase] {\n\t\t\treturn order[result[i].Phase] < order[result[j].Phase]\n\t\t}\n\t\treturn result[i].Tool.ID < result[j].Tool.ID\n\t})\n\treturn result\n}\n\nfunc cmdCloseoutCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tref, jsonOutput, ok := parseScopeCheckArgs(\"closeout-check\", args, stderr)\n\tif !ok {\n\t\treturn 2\n\t}\n\tstore, localRef, err := cliReviewStore(root, ref)\n\tif err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose closeout-check: \" + err.Error())\n\t\treturn 1\n\t}\n\troot, ref = store.Root, localRef\n\tstate, err := cliCloseoutStateForStore(store, ref)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose closeout-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif jsonOutput {\n\t\tif code := writeJSON(stdout, state); code != 0 {\n\t\t\treturn code\n\t\t}\n\t\tif !state.Terminal {\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\t}\n\tfmt.Fprintf(stdout, \"closeout.scope=%s\\ncloseout.digest=%s\\ncloseout.lifecycle_done=%t\\ncloseout.review_approved=%t\\ncloseout.terminal=%t\\ncloseout.next_action=%s\\n\", state.Scope, state.ScopeDigest, state.LifecycleDone, state.Review.Approved, state.Terminal, state.NextAction)\n\tif state.Review.Assurance != nil {\n\t\trender(stdout, stderr).Field(\"closeout.review_assurance\", posemodel.RenderReviewAssurance(*state.Review.Assurance))\n\t}\n\trenderWithinLimitFindings(render(stdout, stderr), \"closeout\", state.Review.Current)\n\tfor _, blocker := range state.Blockers {\n\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n\t}\n\tif !state.Terminal {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc cliCloseoutState(root, ref string) (posemodel.CloseoutState, error) {\n\treturn cliCloseoutStateIn(root, ref, posemodel.NativeFiles())\n}\n\nfunc cliCloseoutStateIn(root, ref string, files posemodel.Files) (posemodel.CloseoutState, error) {\n\tfiles = posemodel.FilesOrNative(files)\n\tresolver, project, err := posemodel.EnvironmentArtifactResolverIn(files, root, \"\")\n\tif err != nil {\n\t\treturn posemodel.CloseoutState{}, fmt.Errorf(\"invalid project configuration\")\n\t}\n\tstore := posemodel.Store{Root: root, FS: files, FederatedProjectID: project, FederatedResolver: &resolver}\n\treturn cliCloseoutStateForStore(store, ref)","numLines":60,"startLine":290,"totalLines":2620}},"tool_result_meta":[{"id":"toolu_011z2RQZPa1C9RdEGh7qPRLt","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
