{"type":"system","subtype":"task_notification","task_id":"bsvehbd9u","run_id":"0mwxwhgkj-79a6a9c5","tool_use_id":"toolu_018Ds7E9ywcDsxDLXJYHJ9nz","status":"completed","output_file":"","summary":"cat > \"$TMPDIR/zz_probe_test.go\" <<'EOF'\npackage pose\n\nimport (\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sync\"\n\t\"syscall\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc zg(t *testing.T, r string, ok bool, a ...string) string {\n\tt.Helper()\n\tc := exec.Command(\"git\", append([]string{\"-C\", r, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"-c\", \"protocol.file.allow=always\", \"-c\", \"init.defaultBranch=main\"}, a...)...)\n\tout, err := c.CombinedOutput()\n\tif err != nil && ok {\n\t\tt.Fatalf(\"git %v: %v %s\", a, err, out)\n\t}\n\treturn string(out)\n}\nfunc zw(t *testing.T, r, f, b string) {\n\tt.Helper()\n\tp := filepath.Join(r, f)\n\tos.MkdirAll(filepath.Dir(p), 0o755)\n\tif err := os.WriteFile(p, []byte(b), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\nfunc zr(t *testing.T) string { r := t.TempDir(); zg(t, r, true, \"init\", \"-q\"); return r }\nfunc zc(t *testing.T, r string) {\n\tzg(t, r, true, \"add\", \"-A\")\n\tzg(t, r, true, \"commit\", \"-q\", \"-m\", \"c\")\n}\nfunc zcmp(t *testing.T, label, root string, a ...string) {\n\targs := append([]string{\"-C\", root}, a...)\n\tidx := filepath.Join(root, \".git\", \"index\")\n\tbefore, _ := os.ReadFile(idx)\n\tgot, err := RawGitDiffReadOnly(root, args...)\n\tafter, _ := os.ReadFile(idx)\n\twant, werr := RawGit(args...).Output()\n\tt.Logf(\"%s: same=%v indexUnchanged=%v readonly=%q err=%v | plain=%q err=%v\", label, string(got) == string(want), string(before) == string(after), got, err, want, werr)\n}\n\nfunc TestProbeRacyDefault(t *testing.T) {\n\tvar roots []string\n\tfor i := 0; i < 6; i++ {\n\t\tr := zr(t)\n\t\tzw(t, r, \"f\", \"aaaa\\n\")\n\t\tzc(t, r)\n\t\ttime.Sleep(time.Until(time.Now().Truncate(time.Second).Add(1020 * time.Millisecond)))\n\t\tzw(t, r, \"f\", \"bbbb\\n\")\n\t\tzg(t, r, true, \"add\", \"f\")\n\t\tzw(t, r, \"f\", \"cccc\\n\")\n\t\troots = append(roots, r)\n\t}\n\ttime.Sleep(1500 * time.Millisecond)\n\tfor _, r := range roots {\n\t\tzcmp(t, \"racy\", r, \"diff\", \"--name-only\")\n\t}\n}\n\nfunc TestProbeIndexStates(t *testing.T) {\n\tr := zr(t)\n\tzw(t, r, \"a\", \"1\\n\")\n\tzc(t, r)\n\tzw(t, r, \"a\", \"2\\n\")\n\tzc(t, r)\n\tidx := filepath.Join(r, \".git\", \"index\")\n\tos.Rename(idx, idx+\".real\")\n\tos.Symlink(\"index.real\", idx)\n\tzcmp(t, \"symlinked\", r, \"diff\", \"--name-only\", \"HEAD~1\")\n\tos.Remove(idx)\n\tzcmp(t, \"missing\", r, \"diff\", \"--name-status\", \"HEAD\")\n\t_, err := os.Lstat(idx)\n\tt.Logf(\"absent after: %v\", os.IsNotExist(err))\n\tos.Mkdir(idx, 0o755)\n\t_, err = RawGitDiffReadOnly(r, \"-C\", r, \"diff\", \"--name-only\")\n\tt.Logf(\"directory index: %v\", err)\n\tos.Remove(idx)\n\tf, _ := os.Create(idx)\n\tf.Truncate(diffIndexLimit + 1)\n\tf.Close()\n\t_, err = RawGitDiffReadOnly(r, \"-C\", r, \"diff\", \"--name-only\")\n\tt.Logf(\"oversized index: %v\", err)\n\tos.Remove(idx)\n\tif err := syscall.Mkfifo(idx, 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdone := make(chan error, 1)\n\tgo func() { _, err := RawGitDiffReadOnly(r, \"-C\", r, \"diff\", \"--name-only\"); done <- err }()\n\tselect {\n\tcase err := <-done:\n\t\tt.Logf(\"fifo index returned: %v\", err)\n\tcase <-time.After(3 * time.Second):\n\t\tt.Logf(\"fifo index: still blocked after 3s\")\n\t\tw, _ := os.OpenFile(idx, os.O_WRONLY, 0)\n\t\tw.Close()\n\t\tt.Logf(\"fifo released: %v\", <-done)\n\t}\n}\n\nfunc TestProbeConcurrentWriter(t *testing.T) {\n\tr := zr(t)\n\tfor _, f := range []string{\"a\", \"b\", \"c\"} {\n\t\tzw(t, r, f, \"1\\n\")\n\t}\n\tzc(t, r)\n\tstop := make(chan struct{})\n\tvar wg sync.WaitGroup\n\twg.Add(1)\n\tgo func() {\n\t\tdefer wg.Done()\n\t\tfor i := 0; ; i++ {\n\t\t\tselect {\n\t\t\tcase <-stop:\n\t\t\t\treturn\n\t\t\tdefault:\n\t\t\t}\n\t\t\tos.WriteFile(filepath.Join(r, \"b\"), []byte{byte('0' + i%10), '\\n'}, 0o644)\n\t\t\texec.Command(\"git\", \"-C\", r, \"add\", \"b\").Run()\n\t\t}\n\t}()\n\tzw(t, r, \"a\", \"2\\n\")\n\tbad := 0\n\tfor i := 0; i < 200; i++ {\n\t\tgot, err := RawGitDiffReadOnly(r, \"-C\", r, \"diff\", \"--name-only\", \"HEAD\", \"--\", \"a\", \"c\")\n\t\tif err != nil || string(got) != \"a\\n\" {\n\t\t\tbad++\n\t\t}\n\t}\n\tclose(stop)\n\twg.Wait()\n\tt.Logf(\"concurrent writer: unexpected=%d of 200\", bad)\n}\n\nfunc TestProbeStates(t *testing.T) {\n\ts := zr(t)\n\tzw(t, s, \"f\", \"1\\n\")\n\tzc(t, s)\n\tr := zr(t)\n\tzg(t, r, true, \"submodule\", \"add\", \"-q\", s, \"mod\")\n\tzw(t, r, \"proj/a\", \"1\\n\")\n\tzw(t, r, \"d/x\", \"1\\n\")\n\tzw(t, r, \"gone\", \"1\\n\")\n\tos.Symlink(\"one\", filepath.Join(r, \"l\"))\n\tzc(t, r)\n\tm := filepath.Join(r, \"mod\")\n\tzw(t, m, \"f\", \"2\\n\")\n\tzc(t, m)\n\tzw(t, r, \"proj/new\", \"1\\n\")\n\tzw(t, r, \"d/x\", \"2\\n\")\n\tzw(t, r, \"gone\", \"2\\n\")\n\tos.Remove(filepath.Join(r, \"l\"))\n\tos.Symlink(\"two\", filepath.Join(r, \"l\"))\n\tzc(t, r)\n\tzg(t, m, true, \"checkout\", \"-q\", \"HEAD~1\")\n\tzw(t, m, \"f\", \"dirty\\n\")\n\tzw(t, r, \"proj/new\", \"2\\n\")\n\tos.RemoveAll(filepath.Join(r, \"d\"))\n\tzw(t, r, \"d\", \"file\\n\")\n\tzw(t, r, \"gone\", \"1\\n\")\n\tzg(t, r, true, \"rm\", \"-q\", \"--cached\", \"gone\")\n\tos.Remove(filepath.Join(r, \"l\"))\n\tos.Symlink(\"one\", filepath.Join(r, \"l\"))\n\tzcmp(t, \"dirty submodule since base\", r, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"--no-renames\", \"HEAD~1\", \"--\")\n\tzcmp(t, \"range\", r, \"diff\", \"--name-only\", \"HEAD~1..HEAD\", \"--\")\n\tzcmp(t, \"subdir\", filepath.Join(r, \"proj\"), \"diff\", \"--name-only\", \"HEAD~1\", \"--\")\n}\n\nfunc TestProbeConflict(t *testing.T) {\n\tr := zr(t)\n\tzw(t, r, \"a\", \"1\\n\")\n\tzc(t, r)\n\tzg(t, r, true, \"checkout\", \"-q\", \"-b\", \"o\")\n\trec := \".pose/review-attempts/k/000001.json\"\n\tzw(t, r, rec, \"theirs\\n\")\n\tzc(t, r)\n\tzg(t, r, true, \"checkout\", \"-q\", \"main\")\n\tzw(t, r, rec, \"ours\\n\")\n\tzc(t, r)\n\tzg(t, r, false, \"merge\", \"o\")\n\tf, err := (Store{Root: r}).ReviewRunHistoryFindings()\n\tt.Logf(\"ledger conflict: %v %v\", f, err)\n\tzcmp(t, \"conflict\", r, \"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\")\n}\n\nfunc TestProbeSplit(t *testing.T) {\n\tr := zr(t)\n\tzg(t, r, true, \"config\", \"core.splitIndex\", \"true\")\n\tzw(t, r, \"f\", \"1\\n\")\n\tzc(t, r)\n\tzg(t, r, true, \"update-index\", \"--split-index\")\n\tm, _ := filepath.Glob(filepath.Join(r, \".git\", \"sharedindex.*\"))\n\ta, _ := os.Stat(m[0])\n\ttime.Sleep(1100 * time.Millisecond)\n\tzw(t, r, \"f\", \"2\\n\")\n\tgot, err := RawGitDiffReadOnly(r, \"-C\", r, \"diff\", \"--name-only\", \"HEAD\")\n\tb, _ := os.Stat(m[0])\n\tt.Logf(\"split: %q %v shared mtime moved=%v\", got, err, !a.ModTime().Equal(b.ModTime()))\n}\nEOF\ncat > \"$TMPDIR/zz_cli_probe_test.go\" <<'EOF'\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestProbeEndToEndIndex(t *testing.T) {\n\tr := t.TempDir()\n\tg := func(a ...string) {\n\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", r, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, a...)...).CombinedOutput(); err != nil {\n\t\t\tt.Fatal(a, string(out))\n\t\t}\n\t}\n\tg(\"init\", \"-q\")\n\tos.WriteFile(filepath.Join(r, \"a.txt\"), []byte(\"x\\n\"), 0o644)\n\tt.Chdir(r)\n\trun := func(a ...string) {\n\t\tvar o, e bytes.Buffer\n\t\tcode := Main(a, &o, &e)\n\t\tt.Logf(\"%v -> %d\", a, code)\n\t}\n\trun(\"install\", r)\n\tg(\"add\", \"-A\")\n\tg(\"commit\", \"-q\", \"-m\", \"i\")\n\tfor i, a := range [][]string{{\"check\", \"--strict\"}, {\"validate\", \"--strict\"}, {\"validate\", \"--changed-from\", \"HEAD\"}, {\"report\", \"--task\", \"p\", \"--since\", \"HEAD\"}} {\n\t\tlater := time.Now().Add(time.Duration(i+2) * time.Second)\n\t\tfilepath.Walk