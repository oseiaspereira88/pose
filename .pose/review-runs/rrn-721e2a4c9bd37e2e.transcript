{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/usr/bin/bash -lc \"git rev-parse HEAD && git status --short && nl -ba pose-mcp/internal/pose/accepted_limits.go | sed -n '20,82p' && nl -ba pose-mcp/internal/pose/accepted_limits_test.go | sed -n '90,135p' && test -x /var/tmp/pose-work-go/pose-ready && ls -l /var/tmp/pose-work-go/pose-ready\"","aggregated_output":"3c6f7b9c6bbb1c935bf3b8a1ad68f245693480f0\n    20\t\t// Spec names the spec that declared the limit when the scope holds more\n    21\t\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n    22\t\tSpec string `json:\"spec,omitempty\"`\n    23\t}\n    24\t\n    25\tvar acceptedLimitRE = regexp.MustCompile(`^-\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n    26\t\n    27\t// acceptedLimitReasonRE finds the reason that follows the marker, which\n    28\t// opens a sentence: \"<assumption>. Accepted because <reason>.\" A marker\n    29\t// inside a sentence, as in \"Not accepted because\", is not one (review round\n    30\t// 3, N1).\n    31\tvar acceptedLimitReasonRE = regexp.MustCompile(`(?:^|[.;:!?]\\s+)(?:Accepted because|Aceito porque)\\s+(.*)$`)\n    32\t\n    33\t// acceptedLimitReasonWordRE is a word with at least one letter.\n    34\tvar acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n    35\t\n    36\t// hasAcceptedLimitReason requires a reason after the marker of at least two\n    37\t// words with letters: neither the marker alone (review round 1, N2) nor\n    38\t// punctuation (round 2, N1) says why a limit is accepted.\n    39\tfunc hasAcceptedLimitReason(text string) bool {\n    40\t\tm := acceptedLimitReasonRE.FindStringSubmatch(text)\n    41\t\treturn m != nil && len(acceptedLimitReasonWordRE.FindAllString(m[1], -1)) >= 2\n    42\t}\n    43\t\n    44\t// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n    45\t// It returns the limits and the problems that keep the section from being\n    46\t// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n    47\t// limit that does not say why it is accepted (\"Accepted because ...\" or\n    48\t// \"Aceito porque ...\").\n    49\tfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n    50\t\tvar limits []ReviewAcceptedLimit\n    51\t\tvar problems []string\n    52\t\tin := false\n    53\t\tseen := map[string]bool{}\n    54\t\tfor _, line := range strings.Split(body, \"\\n\") {\n    55\t\t\ttrimmed := strings.TrimSpace(line)\n    56\t\t\tif strings.HasPrefix(trimmed, \"#\") {\n    57\t\t\t\tin = strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Accepted limits\") || strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Limites aceitos\")\n    58\t\t\t\tcontinue\n    59\t\t\t}\n    60\t\t\tif !in || !strings.HasPrefix(trimmed, \"- \") {\n    61\t\t\t\tcontinue\n    62\t\t\t}\n    63\t\t\tm := acceptedLimitRE.FindStringSubmatch(trimmed)\n    64\t\t\tif m == nil {\n    65\t\t\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(trimmed)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n    66\t\t\t\tcontinue\n    67\t\t\t}\n    68\t\t\tif seen[m[1]] {\n    69\t\t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" is declared twice\")\n    70\t\t\t\tcontinue\n    71\t\t\t}\n    72\t\t\tseen[m[1]] = true\n    73\t\t\tif !hasAcceptedLimitReason(m[2]) {\n    74\t\t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" does not say why it is accepted ('Accepted because ...')\")\n    75\t\t\t}\n    76\t\t\tlimits = append(limits, ReviewAcceptedLimit{ID: m[1], Text: strings.TrimSpace(m[2])})\n    77\t\t}\n    78\t\treturn limits, problems\n    79\t}\n    80\t\n    81\t// acceptedLimitsOf collects the limits the scope's specs declare.\n    82\tfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n    90\t\t}\n    91\t\tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n    92\t\tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n    93\t\t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n    94\t\t}\n    95\t}\n    96\t\n    97\t// Review round 2, N1: punctuation is not a reason, and a reason may start\n    98\t// with a one-letter word.\n    99\tfunc TestAnAcceptedLimitNeedsWordsAsItsReason(t *testing.T) {\n   100\t\tfor text, want := range map[string]bool{\n   101\t\t\t\"x. Accepted because ..\":                         false,\n   102\t\t\t\"x. Accepted because -- !\":                       false,\n   103\t\t\t\"x. Accepted because rare\":                       false,\n   104\t\t\t\"x. Accepted because a shim covers it.\":          true,\n   105\t\t\t\"x. Aceito porque o shim cobre o caso.\":          true,\n   106\t\t\t\"Not accepted because this would violate scope.\": false,\n   107\t\t\t\"x, accepted because it is rare.\":                false,\n   108\t\t} {\n   109\t\t\tif got := hasAcceptedLimitReason(text); got != want {\n   110\t\t\t\tt.Errorf(\"%q: reason=%t, want %t\", text, got, want)\n   111\t\t\t}\n   112\t\t}\n   113\t}\n-rwxr-xr-x 1 go go 49260541 Nov 25 16:17 /var/tmp/pose-work-go/pose-ready\n","exit_code":0,"status":"completed"}}
