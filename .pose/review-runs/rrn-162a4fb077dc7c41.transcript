{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '783,875p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '245,280p' pose-mcp/internal/cli/cli.go; rg -n 'DelegateRootEnv' pose-mcp/internal/pose; sed -n '4250,4295p' .pose/results/delivery-validation.json; sed -n '930,950p' .pose/results/delivery-validation.json\"","aggregated_output":"func cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar spec, from, to string\n\tstrict, jsonOutput := true, false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--spec\", \"--from\", \"--to\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t\t}\n\t\t\ti++\n\t\t\tswitch args[i-1] {\n\t\t\tcase \"--spec\":\n\t\t\t\tspec = args[i]\n\t\t\tcase \"--from\":\n\t\t\t\tfrom = args[i]\n\t\t\tcase \"--to\":\n\t\t\t\tto = args[i]\n\t\t\t}\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t}\n\t}\n\tstore := posemodel.Store{Root: root}\n\tfull, err := store.GetSpec(spec)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tpolicy, err := posemodel.LoadArtifactPolicy(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tclaims, found, err := posemodel.ParseArtifactClaims(*full, policy)\n\tif err != nil || !found || len(claims) == 0 {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: spec %s has no valid artifact declaration: %v\\n\", spec, err)\n\t\treturn 1\n\t}\n\tvar sets []posemodel.ChangeSet\n\tif from != \"\" || to != \"\" {\n\t\tset, err := resolveGitChangeSet(root, spec, from, to)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tsets = append(sets, set)\n\t} else {\n\t\tfor _, recorded := range loadRecordedChangeSets(root) {\n\t\t\tif recorded.Spec == spec {\n\t\t\t\tsets = append(sets, recorded)\n\t\t\t}\n\t\t}\n\t\tif set, err := resolveGitChangeSet(root, spec, \"\", \"\"); err == nil {\n\t\t\talreadyPresent := false\n\t\t\tfor _, existing := range sets {\n\t\t\t\tif existing.ID == set.ID {\n\t\t\t\t\talreadyPresent = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !alreadyPresent {\n\t\t\t\tsets = append(sets, set)\n\t\t\t}\n\t\t}\n\t\tif len(sets) == 0 {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: no commits carry POSE-Spec: %s\\n\", spec)\n\t\t\treturn 1\n\t\t}\n\t}\n\tset := sets[0]\n\ttracked, err := gitTrackedPaths(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\t// A later removal by another spec is read from every spec's claims and\n\t// change sets (spec pose-delivery-later-removal R4).\n\tvar removals []posemodel.ArtifactRemoval\n\tif _, allClaims, allSets, _, _, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root); err == nil {\n\t\tremovals = artifactRemovals(root, allClaims, allSets, tracked, gaps, sets...)\n\t}\n\tgraph := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), []posemodel.Spec{*full}, claims, sets, tracked, policy, posemodel.LoadArchivedFragments(root), removals)\n\tfor _, claim := range claims {\n\t\tif claim.Action == \"none\" {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{claim.Path}\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose identity: \" + err.Error())\n\t\t\treturn 2\n\t\t}\n\t\treturn cmdIdentity(root, args, stdout, stderr)\n\tcase \"adopt\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose adopt: \" + err.Error())\n\t\t\treturn 2\n\t\t}\n\t\treturn cmdAdopt(root, args, stdout, stderr)\n\tcase \"runtime\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose runtime: \" + err.Error())\n\t\t\treturn 2\n\t\t}\n\t\treturn cmdRuntime(root, args, stdout, stderr)\n\tcase \"delegate\":\n\t\troot, err := projectRoot()\n\t\t// The root a caller resolved and authorized wins over the one the\n\t\t// directory would yield (spec pose-delegation-mcp R6).\n\t\tif given := os.Getenv(posemodel.DelegateRootEnv); given != \"\" {\n\t\t\troot, err = delegateGivenRoot(given)\n\t\t}\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose delegate: \" + err.Error())\n\t\t\treturn 2\n\t\t}\n\t\treadDetachedCallerRoot()\n\t\treturn cmdDelegate(root, args, stdout, stderr)\n\tcase \"action\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\npose-mcp/internal/pose/delegation_refusal.go:22:// DelegateRootEnv names the project root a `pose delegate` process runs in\npose-mcp/internal/pose/delegation_refusal.go:26:const DelegateRootEnv = \"POSE_DELEGATE_ROOT\"\n        \"test\",\n        \"./internal/pose\",\n        \"./internal/cli\",\n        \"-run\",\n        \"TestDecodeStrictJSON|TestStrictJSONReadersRequireTheEnd|TestReviewRequestIsFulfilledOverTheCLI|TestF05RecordRefusesATagWhoseTreeIsNotIntact|TestAnInvalidHookRunnerIsRefused\",\n        \"-count=1\"\n      ],\n      \"severity\": \"required\",\n      \"evidence_class\": \"integration\",\n      \"outcome\": \"pass\",\n      \"duration_seconds\": 2.946407543,\n      \"output\": \"ok  \\tgithub.com/harne8/pose-mcp/internal/pose\\t0.146s\\nok  \\tgithub.com/harne8/pose-mcp/internal/cli\\t1.916s\\n\"\n    },\n    {\n      \"id\": \"pose-mcp/go/check-shares-the-federated-material-integration\",\n      \"module\": \"pose-mcp\",\n      \"stack\": \"go\",\n      \"name\": \"check-shares-the-federated-material-integration\",\n      \"program\": \"go\",\n      \"args\": [\n        \"test\",\n        \"./internal/pose\",\n        \"-run\",\n        \"TestScopeIndexInputsAreCheckedOncePerCoordinator|TestAScopeIndexInputChangedDuringTheCoordinatorFailsItsAudit|TestGovernanceReadViewScopeCoordinator|TestGovernanceReadViewD7Probe\",\n        \"-count=1\"\n      ],\n      \"severity\": \"required\",\n      \"evidence_class\": \"integration\",\n      \"outcome\": \"pass\",\n      \"duration_seconds\": 0.527524874,\n      \"output\": \"ok  \\tgithub.com/harne8/pose-mcp/internal/pose\\t0.187s\\n\"\n    },\n    {\n      \"id\": \"pose-mcp/go/federated-proof-reads-each-input-once-integration\",\n      \"module\": \"pose-mcp\",\n      \"stack\": \"go\",\n      \"name\": \"federated-proof-reads-each-input-once-integration\",\n      \"program\": \"go\",\n      \"args\": [\n        \"test\",\n        \"./internal/pose\",\n        \"-run\",\n        \"TestCurrentMaterialIsReadOncePerCommit|TestCurrentMaterialFollowsAMovedHead|TestCurrentMaterialWithoutAHeadIsNotKept|TestCurrentMaterialKeptDigestsAreBounded|TestEvidenceIsJudgedAgainstTheCurrentMaterial|TestAReleaseSnapshotIsReadOncePerCommit|TestAKeptReleaseSnapshotIsCopiedToEachReader|TestAMovedReleaseTagIsReadAtItsNewCommit|TestAFailedReleaseSnapshotReadIsNotKept|TestAReleaseTagPeelIsKeptPerObject|TestAListedReleaseTagResolvesAsAloneOne|TestABundleHeaderIsParsedOncePerContent|TestAKeptValueIsComputedOnceForConcurrentMisses|TestADeclinedKeptValueIsComputedAgain|TestAnUnreadableMaterialIsAskedAgain|TestASnapshotWithGapsIsReadAgain|TestAFailedReleaseTagPeelIsAskedAgain|TestARecoveredReadIsComputedOnceAndKept|TestABoundCrossingKeepsAPendingKey|TestAConcurrentBurstKeepsNoMoreThanTheBound\",\n        \"-count=1\"\n      ],\n      \"severity\": \"required\",\n    \"review-check-names-a-negative-verdict\": \"sha256:ec17102bdef299503e069af7ffd5f9ae2b8ea6c5790f4aba393466debbc971b6\",\n    \"review-policy-adoption-is-the-instances\": \"sha256:6597c5a2992ee7acc3319601c4d7c42155e384fa103ba3619a7e46dc75b2bf67\",\n    \"review-subject-classifies-capabilities\": \"sha256:ab3a611b2f08d2dfc3c129e76b17b6ac2ed88814a46f6e72e1edda253a957e1f\",\n    \"review-verify-retains-completed-scopes\": \"sha256:85b2efc6542716481a9182f3bb53ed1edd4a95173a7fc64a26d3303862e18ba5\",\n    \"test-git-repos-run-no-background-maintenance\": \"sha256:8d774f5b49c923542ec2074b239fcae7d7bced070ae3a92061b10b8bb3112a18\"\n  },\n  \"jobs\": 4,\n  \"wall_seconds\": 463.701948942,\n  \"outcome\": \"pass\",\n  \"counts\": {\n    \"executed\": 226,\n    \"passed\": 226,\n    \"failed\": 0,\n    \"optional_failed\": 0,\n    \"errored\": 0,\n    \"skipped\": 0\n  },\n  \"checks\": [\n    {\n      \"id\": \"mcp-enforce/go/build\",\n      \"module\": \"mcp-enforce\",\n","exit_code":0,"status":"completed"}}
