{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '429,465p' pose-mcp/internal/cli/cli.go; sed -n '260,320p' pose-mcp/internal/cli/artifact_integrity.go; cat pose-mcp/internal/pose/governance_read_view_index_test.go; rg -n 'Snapshot|Foreign|Federated|Root' pose-mcp/internal/pose/governance_read_view_test.go | head -30; rg -n 'not-used|deferred|evidence' pose-mcp/internal/pose/review_conclu*go | head -20\"","aggregated_output":"func projectRoot() (string, error) {\n\treturn projectRootAt(\".\")\n}\n\n// projectRootAt resolves the git top-level starting from dir, falling back\n// to dir's own absolute path when dir isn't inside a git work tree (spec\n// pose-instance-engine-version-tracking R2) — the same fallback shape\n// projectRoot() already had for \".\".\nfunc projectRootAt(dir string) (string, error) {\n\tout, err := posemodel.RawHistoryGit(dir, \"rev-parse\", \"--show-toplevel\").Output()\n\tif err == nil {\n\t\treturn strings.TrimSpace(string(out)), nil\n\t}\n\tabs, err := filepath.Abs(dir)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn abs, nil\n}\n\n// cmdVersion prints the binary version and, when an instance is resolvable\n// (target, or the current directory when target is \"\"), its schema and —\n// when recorded — the engine version that last delivered its machinery\n// (spec pose-instance-engine-version-tracking).\nfunc cmdVersion(w io.Writer, target string) int {\n\tfmt.Fprintf(w, \"pose %s\\n\", Version)\n\tdir := \".\"\n\tif target != \"\" {\n\t\tdir = target\n\t}\n\tif root, err := projectRootAt(dir); err == nil {\n\t\tsv := filepath.Join(root, \".pose\", \"schema-version\")\n\t\tif b, err := os.ReadFile(sv); err == nil {\n\t\t\tfmt.Fprintf(w, \"schema: %s\\n\", strings.TrimSpace(string(b)))\n\t\t} else if _, err := os.Stat(filepath.Join(root, \".pose\")); err == nil {\n\t\t\tfmt.Fprintf(w, \"schema: unversioned (run 'pose update')\\n\")\n\t\t}\n// resolveGitChangeSetWithPatchDigest resolves a change set; a non-nil\n// patchDigest is the digest trailerPatchDigests already streamed for the\n// trailer commits of captured, which this resolution then does not read again.\nfunc resolveGitChangeSetWithPatchDigest(files posemodel.Files, root, spec, base, head string, captured []string, patchDigest []byte) (posemodel.ChangeSet, error) {\n\tgitOutput := func(limit int, args ...string) ([]byte, error) {\n\t\tif files == nil {\n\t\t\treturn gitOutputBounded(root, limit, args...)\n\t\t}\n\t\treturn gitOutputBoundedIn(files, root, limit, args...)\n\t}\n\tgitStream := changeSetGitStream(files, root)\n\tresolveRevision := func(revision string) (string, error) {\n\t\treturn resolveGitRevisionWithFiles(files, root, revision)\n\t}\n\tif spec == \"\" || posemodel.ValidateSlug(spec) != nil {\n\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"a valid spec slug is required\")\n\t}\n\tselector := \"range:\" + base + \"..\" + head\n\tvar trailerCommits []string\n\tif base == \"\" && head == \"\" {\n\t\tcommits := append([]string(nil), captured...)\n\t\tif len(commits) == 0 {\n\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"no commits carry POSE-Spec: %s\", spec)\n\t\t}\n\t\ttrailerCommits = commits\n\t\thead = commits[len(commits)-1]\n\t\tbase = commits[0] + \"^\"\n\t\tselector = \"trailers:\" + spec\n\t} else if base == \"\" || head == \"\" {\n\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"--from and --to must be supplied together\")\n\t}\n\tresolvedBase := base\n\tif !posemodel.IsGitEmptyTree(base) {\n\t\tvar err error\n\t\tif resolvedBase, err = resolveRevision(base); err != nil && len(trailerCommits) > 0 {\n\t\t\tvar isRoot bool\n\t\t\tvar headerErr error\n\t\t\tif files == nil {\n\t\t\t\tisRoot, headerErr = commitHasNoParent(root, trailerCommits[0])\n\t\t\t} else {\n\t\t\t\tisRoot, headerErr = commitHasNoParentIn(files, root, trailerCommits[0])\n\t\t\t}\n\t\t\tif headerErr != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"%w; %v\", err, headerErr)\n\t\t\t}\n\t\t\tif isRoot {\n\t\t\t\tbase, resolvedBase, err = posemodel.GitEmptyTree(trailerCommits[0]), posemodel.GitEmptyTree(trailerCommits[0]), nil\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n\t}\n\tresolvedHead, err := resolveRevision(head)\n\tif err != nil {\n\t\treturn posemodel.ChangeSet{}, err\n\t}\n\tcommitsRaw, err := gitOutput(4*1024*1024, \"rev-list\", \"--reverse\", posemodel.ChangeSetRange(resolvedBase, resolvedHead), \"--\")\n\tif err != nil {\n\t\treturn posemodel.ChangeSet{}, err\n\t}\npackage pose\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc governanceReadViewIndexConsumer(t *testing.T, store Store, inputs map[string]string, publish bool, legacy bool) (Store, *governanceReadView, string) {\n\tt.Helper()\n\tproject := DefaultProjectID(store.Root)\n\troots := NewRootsIn(NativeFiles(), RootsConfig{DefaultRoot: store.Root, DefaultProjectID: project})\n\tresolver := ArtifactResolver{Roots: roots, FS: NativeFiles()}\n\tstore.FederatedProjectID = project\n\tstore.FederatedResolver = &resolver\n\tif publish {\n\t\tif _, err := store.PublishIndexGeneration(outputsFor(\"current\"), inputs); err != nil {\n\t\t\tt.Fatalf(\"publish fixture index generation: %v\", err)\n\t\t}\n\t}\n\tif legacy {\n\t\tpath := filepath.Join(indexDir(store.Root), \"repo-map.json\")\n\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(path, outputsFor(\"legacy\")[\"repo-map.json\"], 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tbase, view := store.beginGovernanceReadView()\n\treturn base.withGovernanceReadView(view, \"index-consumer\").PinIndexes(), view, project\n}\n\nfunc governanceReadViewIndexInputs(t *testing.T, store Store) map[string]string {\n\tt.Helper()\n\tinputs := IndexInputBindingsIn(NativeFiles(), store.Root)\n\tfor _, name := range IndexInputNames {\n\t\tif strings.TrimSpace(inputs[name]) == \"\" {\n\t\t\tt.Fatalf(\"fixture could not bind required index input %q\", name)\n\t\t}\n\t}\n\treturn inputs\n}\n\nfunc governanceReadViewIndexUnknown(t *testing.T, view *governanceReadView, producer string) []string {\n\tt.Helper()\n\tif view == nil || view.operation == nil {\n\t\tt.Fatal(\"read view has no operation\")\n\t}\n\treturn view.operation.audit().UnknownProducers[producer]\n}\n\nfunc TestGovernanceReadViewIndexConsumptionChecksBoundInputsOnlyWhenUsed(t *testing.T) {\n\tgovernanceReadViewProbeUseKnownEngineVersion(t)\n\n\tt.Run(\"current bindings remain current\", func(t *testing.T) {\n\t\tstore := obligationFixture(t)\n\t\tinputs := governanceReadViewIndexInputs(t, store)\n\t\treader, view, _ := governanceReadViewIndexConsumer(t, store, inputs, true, false)\n\t\traw, status, err := reader.ReadIndex(\"repo-map.json\")\n\t\tif err != nil || status != IndexGenerationCurrent || tagOf(t, raw) != \"current\" {\n\t\t\tt.Fatalf(\"ReadIndex = %q, %s, %v\", raw, status, err)\n\t\t}\n\t\tif reasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\"); len(reasons) != 0 {\n\t\t\tt.Fatalf(\"current bound index input set made the consumer unknown: %v\", reasons)\n\t\t}\n\t})\n\n\tt.Run(\"stale binding is localized to the consumer\", func(t *testing.T) {\n\t\tstore := obligationFixture(t)\n\t\tinputs := governanceReadViewIndexInputs(t, store)\n\t\tif _, err := store.PublishIndexGeneration(outputsFor(\"current\"), inputs); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\treader, view, _ := governanceReadViewIndexConsumer(t, store, nil, false, false)\n\t\tpath := filepath.Join(reader.Root, \".pose\", \"specs\", \"2026-10-02-consumer.md\")\n\t\tbody, err := os.ReadFile(path)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tbody = append(body, []byte(\"\\n<!-- changed after index publication -->\\n\")...)\n\t\tif err := os.WriteFile(path, body, 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\traw, status, err := reader.ReadIndex(\"repo-map.json\")\n\t\tif err != nil || status != IndexGenerationCurrent || tagOf(t, raw) != \"current\" {\n\t\t\tt.Fatalf(\"stale inputs made the pinned index unavailable: %q, %s, %v\", raw, status, err)\n\t\t}\n\t\treasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\")\n\t\tif len(reasons) == 0 {\n\t\t\tt.Fatal(\"a consumed index with stale source bindings left its consumer current\")\n\t\t}\n\t\tif !strings.Contains(strings.Join(reasons, \" \"), \"index input specs changed\") {\n\t\t\tt.Fatalf(\"stale specs input was not disclosed: %v\", reasons)\n\t\t}\n\t\tif len(governanceReadViewIndexUnknown(t, view, \"projection\")) != 0 {\n\t\t\tt.Fatalf(\"a stale consumed index blocked the whole projection: %v\", governanceReadViewIndexUnknown(t, view, \"projection\"))\n\t\t}\n\t})\n\n\tt.Run(\"missing required binding is unknown\", func(t *testing.T) {\n\t\tstore := obligationFixture(t)\n\t\tinputs := governanceReadViewIndexInputs(t, store)\n\t\tdelete(inputs, \"module-discovery\")\n\t\treader, view, _ := governanceReadViewIndexConsumer(t, store, inputs, true, false)\n\t\tif _, status, err := reader.ReadIndex(\"repo-map.json\"); err != nil || status != IndexGenerationCurrent {\n\t\t\tt.Fatalf(\"index bytes were not retained for diagnosis: status=%s err=%v\", status, err)\n\t\t}\n\t\treasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\")\n\t\tif !strings.Contains(strings.Join(reasons, \" \"), \"does not bind input module-discovery\") {\n\t\t\tt.Fatalf(\"missing module-discovery binding was not disclosed: %v\", reasons)\n\t\t}\n\t})\n\n\tt.Run(\"legacy index is unknown when consumed\", func(t *testing.T) {\n\t\treader, view, _ := governanceReadViewIndexConsumer(t, obligationFixture(t), nil, false, true)\n\t\tif _, status, err := reader.ReadIndex(\"repo-map.json\"); err != nil || status != IndexGenerationLegacy {\n\t\t\tt.Fatalf(\"legacy bytes were not retained for diagnosis: status=%s err=%v\", status, err)\n\t\t}\n\t\tif reasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\"); len(reasons) == 0 || !strings.Contains(strings.Join(reasons, \" \"), \"legacy index\") {\n\t\t\tt.Fatalf(\"legacy index use did not make its consumer unknown: %v\", reasons)\n\t\t}\n\t})\n\n\tt.Run(\"unused indexes do not poison coverage\", func(t *testing.T) {\n\t\tstore := obligationFixture(t)\n\t\tinputs := governanceReadViewIndexInputs(t, store)\n\t\tif _, err := store.PublishIndexGeneration(outputsFor(\"current\"), inputs); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\t_, view := store.beginGovernanceReadView()\n\t\tif reasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\"); len(reasons) != 0 {\n\t\t\tt.Fatalf(\"unused index inputs made the consumer unknown: %v\", reasons)\n\t\t}\n\t})\n\n\tt.Run(\"missing legacy output remains a not-exist result\", func(t *testing.T) {\n\t\treader, view, _ := governanceReadViewIndexConsumer(t, obligationFixture(t), nil, false, false)\n\t\t_, status, err := reader.ReadIndex(\"repo-map.json\")\n\t\tif status != IndexGenerationLegacy || !errors.Is(err, os.ErrNotExist) {\n\t\t\tt.Fatalf(\"missing legacy index = status %s, err %v\", status, err)\n\t\t}\n\t\tif reasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\"); len(reasons) != 0 {\n\t\t\tt.Fatalf(\"proven missing legacy index made its consumer unknown: %v\", reasons)\n\t\t}\n\t})\n}\n10:func TestGovernanceReadViewDirtyToDirtySnapshot(t *testing.T) {\n13:\tpath := filepath.Join(store.Root, \".pose/specs/2026-10-01-base.md\")\n35:\tif !first.Snapshot.WorktreeDirty {\n36:\t\tt.Fatalf(\"first operation did not observe a dirty worktree: %+v\", first.Snapshot)\n38:\tif changed := store.ObligationSnapshotChanges(first.Snapshot); len(changed) != 0 {\n41:\tif first.Snapshot.ReadView == nil || first.Snapshot.ReadView.Freshness != ReadViewFreshnessCurrent {\n42:\t\tt.Fatalf(\"stable projection did not retain a current read-view proof: %+v\", first.Snapshot.ReadView)\n65:\tif !second.Snapshot.WorktreeDirty {\n66:\t\tt.Fatalf(\"second operation did not observe a dirty worktree: %+v\", second.Snapshot)\n68:\tif first.Snapshot.Digest == second.Snapshot.Digest {\n69:\t\tt.Fatalf(\"same-size spec edit kept the operation identity: %s\", first.Snapshot.Digest)\n71:\tif first.Snapshot.ReadView == nil || second.Snapshot.ReadView == nil || first.Snapshot.ReadView.ID == second.Snapshot.ReadView.ID {\n72:\t\tt.Fatalf(\"same-size spec edit kept the read-view identity: first=%+v second=%+v\", first.Snapshot.ReadView, second.Snapshot.ReadView)\n74:\tif changed := store.ObligationSnapshotChanges(first.Snapshot); len(changed) == 0 {\npose-mcp/internal/pose/review_conclusions.go:137:// the run that wrote it. Evidence is the run itself and each evidence the\npose-mcp/internal/pose/review_conclusions.go:142:\tevidence := map[string]bool{\"delegated-run:\" + run.RunID: true}\npose-mcp/internal/pose/review_conclusions.go:146:\t\t\tevidence[c.Evidence] = true\npose-mcp/internal/pose/review_conclusions.go:168:\tfor ref := range evidence {\npose-mcp/internal/pose/review_conclusions.go:178:// deferred, a recommended tool not used. A required tool left out stays out,\npose-mcp/internal/pose/review_conclusions.go:192:\t\t\tout = append(out, ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"deferred\", Rationale: \"post-review gate\"})\npose-mcp/internal/pose/review_conclusions.go:194:\t\t\tout = append(out, ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"not-used\", Rationale: \"not used during review\"})\npose-mcp/internal/pose/review_conclusions.go:257:// a post-review gate deferred and a recommended tool not used state none,\npose-mcp/internal/pose/review_conclusions.go:268:\t\tif ok && t.Evidence == \"\" && (t.Disposition == \"deferred\" && containsString(tool.Preconditions, \"review-complete\") || t.Disposition == \"not-used\" && tool.Requiredness == \"recommended\") {\n","exit_code":0,"status":"completed"}}
