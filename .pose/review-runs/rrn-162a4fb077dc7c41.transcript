{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_operation_view.go | sed -n '631,680p'; nl -ba pose-mcp/internal/pose/governance_read_view.go | sed -n '636,719p'; nl -ba .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md | tail -30; git status --short\"","aggregated_output":"   631\t\t}\n   632\t\treturn v.scopeBase, v, nil\n   633\t}\n   634\t\n   635\t// WithReviewScopeOperationView evaluates one scope, including recursive children\n   636\t// and authorized roots, with an independent bounded capture and final audit.\n   637\tfunc (s Store) WithReviewScopeOperationView(run func(Store) error) error {\n   638\t\tvar catalog reviewScopeCatalogue = s.reviewView\n   639\t\tif s.reviewView == nil {\n   640\t\t\treturn fmt.Errorf(\"pose: review scope requires an active coordinator\")\n   641\t\t}\n   642\t\tbase, parent, err := catalog.scopeCatalogue(s)\n   643\t\tif err != nil {\n   644\t\t\treturn err\n   645\t\t}\n   646\t\tbase, readView := base.beginGovernanceReadView()\n   647\t\tshared := base.withGovernanceReadView(readView, \"review-operation\")\n   648\t\tif !sameStringMap(parent.scopeRoots, readView.operation.initialRoots) || !sameBoolMap(parent.scopeConflicts, readView.operation.initialConflicts) {\n   649\t\t\treadView.markUnknown(\"review-operation\", \"scope authorized root vector differs from coordinator\")\n   650\t\t\treturn errors.Join(errGovernanceReadViewOutsideRoot, reviewOperationGovernanceAuditError(readView.audit(), readView, nil))\n   651\t\t}\n   652\t\t// The consumed index's inputs, the federated material among them, are the\n   653\t\t// same for every scope of the coordinator: they are checked once, under\n   654\t\t// the coordinator's view, whose audit runs after every scope joins (ADR\n   655\t\t// governance-reads-use-bounded-operation-scoped-views D12).\n   656\t\tif coordinatorView, _ := governanceReadViewFromFiles(parent.coordinatorStore.fsys()); coordinatorView != nil && coordinatorView.operation != nil {\n   657\t\t\treadView.operation.indexInputsFrom = coordinatorView.operation\n   658\t\t\treadView.operation.indexInputsFiles = parent.coordinatorStore.fsys()\n   659\t\t}\n   660\t\tview := &reviewOperationView{root: filepath.Clean(shared.Root), files: shared.fsys(), project: shared.FederatedProjectID, resolver: shared.FederatedResolver,\n   661\t\t\tcoordinator: parent, specUsed: parent.specUsed, specErr: parent.specErr, specFallback: parent.specFallback, specEntries: parent.specEntries, specBySlug: parent.specBySlug,\n   662\t\t\tspecBodySeen: make([]bool, len(parent.specEntries)), specBodyDigests: make([][32]byte, len(parent.specEntries)),\n   663\t\t\tused: parent.used, directoryError: parent.directoryError, inventory: parent.inventory, headers: parent.headers, fallback: parent.fallback,\n   664\t\t\tmaxRecords: parent.maxRecords, maxInputBytes: parent.maxInputBytes, maxRetainedText: parent.maxRetainedText}\n   665\t\tview.specOnce.Do(func() {})\n   666\t\tview.once.Do(func() {})\n   667\t\tvar callbackErr error\n   668\t\toperationErr := shared.withReviewOperationView(view, func(scoped Store) { callbackErr = run(scoped) })\n   669\t\taudit := readView.audit()\n   670\t\treturn errors.Join(callbackErr, operationErr, reviewOperationGovernanceAuditError(audit, readView, view))\n   671\t}\n   636\t// actually consumes a derived index. Taking a pin for snapshot identity alone\n   637\t// does not make the projection depend on that index, so the projection producer\n   638\t// deliberately skips this check. The work is shared per root, generation and\n   639\t// producer; each producer still records its own observations and limitation.\n   640\tfunc (op *governanceReadViewOperation) checkIndexInputs(files Files, root, producer string, pin *IndexGenerationView) []string {\n   641\t\tif op == nil || pin == nil || pin.Status != IndexGenerationCurrent {\n   642\t\t\treturn nil\n   643\t\t}\n   644\t\tif from := op.indexInputsFrom; from != nil && from != op {\n   645\t\t\treturn from.checkIndexInputs(op.indexInputsFiles, root, producer, pin)\n   646\t\t}\n   647\t\tabs, err := filepath.Abs(root)\n   648\t\tif err != nil {\n   649\t\t\treturn []string{\"index input root could not be resolved\"}\n   650\t\t}\n   651\t\tkey := filepath.Clean(abs) + \"\\x00\" + pin.Descriptor.GenerationID + \"\\x00\" + producer\n   652\t\top.mu.Lock()\n   653\t\tif op.indexInputChecks == nil {\n   654\t\t\top.indexInputChecks = map[string]*governanceReadViewIndexInputCheck{}\n   655\t\t}\n   656\t\tif prior := op.indexInputChecks[key]; prior != nil {\n   657\t\t\tready := prior.ready\n   658\t\t\top.mu.Unlock()\n   659\t\t\t<-ready\n   660\t\t\treturn append([]string(nil), prior.reasons...)\n   661\t\t}\n   662\t\tcheck := &governanceReadViewIndexInputCheck{ready: make(chan struct{})}\n   663\t\top.indexInputChecks[key] = check\n   664\t\top.mu.Unlock()\n   665\t\n   666\t\treasons := []string{}\n   667\t\tfor _, name := range IndexInputNames {\n   668\t\t\tbound, exists := pin.Descriptor.Inputs[name]\n   669\t\t\tif !exists || strings.TrimSpace(bound) == \"\" {\n   670\t\t\t\treasons = append(reasons, \"index generation does not bind input \"+name)\n   671\t\t\t\tcontinue\n   672\t\t\t}\n   673\t\t\tcurrent, known := op.indexInputBinding(files, root, producer, name)\n   674\t\t\tif !known || current == \"\" {\n   675\t\t\t\treasons = append(reasons, \"current index input \"+name+\" could not be bounded\")\n   676\t\t\t\tcontinue\n   677\t\t\t}\n   678\t\t\tif current != bound {\n   679\t\t\t\treasons = append(reasons, \"index input \"+name+\" changed since generation \"+pin.Descriptor.GenerationID)\n   680\t\t\t}\n   681\t\t}\n   682\t\treasons = uniqueSorted(reasons)\n   683\t\top.mu.Lock()\n   684\t\tcheck.reasons = append([]string(nil), reasons...)\n   685\t\tclose(check.ready)\n   686\t\top.mu.Unlock()\n   687\t\treturn reasons\n   688\t}\n   689\t\n   690\t// governanceIndexInputBindingObserved sees each computation of an index\n   691\t// input's binding; tests count them.\n   692\tvar governanceIndexInputBindingObserved = func(root, name string) {}\n   693\t\n   694\t// Revalidation must use the same captured project/resolver context as the\n   695\t// generation consumer, including when that consumer is a foreign Store.\n   696\tfunc (op *governanceReadViewOperation) indexInputBinding(files Files, root, producer, name string) (string, bool) {\n   697\t\tgovernanceIndexInputBindingObserved(root, name)\n   698\t\tif name != \"federated-material\" {\n   699\t\t\treturn IndexInputBindingIn(files, root, name)\n   700\t\t}\n   701\t\top.mu.Lock()\n   702\t\tproject, selectedRoot := op.rootForPathLocked(governanceAbsoluteRoot(root), \"\")\n   703\t\tconflict := op.initialConflicts[project]\n   704\t\top.mu.Unlock()\n   705\t\tif project == \"\" || conflict || !sameLexicalRoot(root, selectedRoot) {\n   706\t\t\treturn \"\", false\n   707\t\t}\n   708\t\tresolver := op.resolver\n   709\t\tresolver.FS = files\n   710\t\tresolver.Roots = op.rootsForProducer(resolver.Roots, files, producer)\n   711\t\tresolver.snapshots = nil\n   712\t\tresolver.governanceDepthLimit = 8\n   713\t\treturn IndexInputBindingForStoreIn(Store{Root: root, FS: files, FederatedProjectID: project, FederatedResolver: &resolver}, name)\n   714\t}\n   715\t\n   716\tfunc (s Store) governanceIndexConsumed(status IndexGenerationStatus, err error, pin *IndexGenerationView) {\n   717\t\tif err != nil {\n   718\t\t\treturn\n   719\t\t}\n   271\tStreaming bounds memory, not I/O: the bytes read still grow with the\n   272\tattributed history.\n   273\t\n   274\t\n   275\t## A coordinator checks the consumed index's inputs for its scopes (D12) — 2026-11-15\n   276\t\n   277\tSpec `pose-check-shares-the-federated-material` refines D7. Under one\n   278\tcoordinator, every scope consumes the same pinned index generation, and its\n   279\tinputs (the federated material among them) are the same for every scope.\n   280\tD7 made each scope recompute them inside its own capture. With the\n   281\tpose-dist corpus as a federated dependency, the federated material of one\n   282\tharne8 check costs about 150 s and several hundred MiB of retained reads.\n   283\tEach of 16 workers recomputed and retained it: `pose check --tolerant`\n   284\tpassed 10 GB within a minute, and four workers took 37 minutes.\n   285\t\n   286\tA scope operation created by a coordinator delegates its check of the\n   287\tconsumed index's inputs to the coordinator operation. The bindings are\n   288\tcomputed once per (root, generation, producer), through the coordinator's\n   289\tFiles and charged to its budget. The coordinator's final audit, which D7\n   290\talready runs after every scope joins, covers those reads. A scope's own\n   291\tclosure keeps everything else it reads. An input that changes while the\n   292\tscopes run fails the coordinator's audit, so the gate fails: no scope is\n   293\tjudged against a freshness check its closure does not cover. Measured on\n   294\tharne8: 248 s at a 2.5 GB peak with 16 workers, against an abort past\n   295\t10 GB.\n   296\t\n   297\tThis shares one immutable answer (whether the consumed generation's inputs\n   298\tare current) in the binding-aware way D7 requires: scopes already prove the\n   299\tcoordinator's authorized root vector before a capture. It does not make the\n   300\tscopes one snapshot.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"pose artifact-check --spec pose-check-shares-the-federated-material --strict --from 729501a0b91a4ff6ca5c0aebc46eb0b82ba10128 --to 3ab01deb38df5edf8aa073c9c0302b9607ef91a0 --json | python3 -c 'import sys,json; d=json.load(sys.stdin); print(json.dumps({k:v for k,v in d.items() if k \"'!= \"findings\"})); print(json.dumps([f for f in d.get(\"findings\",[]) if f.get(\"severity\") != \"warning\"]))'\"' \"","aggregated_output":"{\"schema_version\": 1, \"input_digest\": \"sha256:38337e3d5d41c3ebfbd0bb3e08c56b1087281ab943a3a1ebbe17a76d00de6afe\", \"provenance_digest\": \"sha256:8cd5fa7d2b4d0b608397f283b43360529ccfd3bddbc05ee8ec2ad836e616cac4\", \"nodes\": [{\"id\": \"artifact:.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\"}}, {\"id\": \"artifact:.pose/indexes/delivery-integrity.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/indexes/delivery-integrity.json\"}}, {\"id\": \"artifact:.pose/indexes/generation.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/indexes/generation.json\"}}, {\"id\": \"artifact:.pose/indexes/spec-graph.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/indexes/spec-graph.json\"}}, {\"id\": \"artifact:.pose/indexes/validation-matrix.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/indexes/validation-matrix.json\"}}, {\"id\": \"artifact:.pose/results/delivery-validation.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/results/delivery-validation.json\"}}, {\"id\": \"artifact:.pose/specs/2026-11-15-pose-check-shares-the-federated-material.md\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/specs/2026-11-15-pose-check-shares-the-federated-material.md\"}}, {\"id\": \"artifact:.pose/starts/pos