{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'D7Probe|ScopeCoordinator' pose-mcp/internal/pose/*test.go; rg -n 'WithReviewCoordinator|WithReviewScopeOperationView' pose-mcp/internal/cli; rg -n 'check-shares-the-federated|D7|bounded.operation' .pose/knowledge; sed -n '240,360p' pose-mcp/internal/pose/review_operation_view.go; sed -n '100,325p' pose-mcp/internal/pose/governance_read_view.go\"","aggregated_output":"pose-mcp/internal/pose/review_scope_operation_view_test.go:31:func TestGovernanceReadViewScopeCoordinatorRetainsCallbackAndAuditFailure(t *testing.T) {\npose-mcp/internal/pose/review_scope_operation_view_test.go:52:func TestGovernanceReadViewScopeCoordinatorRefusesRetiredOrChangedBinding(t *testing.T) {\npose-mcp/internal/pose/review_scope_operation_view_test.go:91:func TestGovernanceReadViewScopeCoordinatorParallelClosuresStayIndependent(t *testing.T) {\npose-mcp/internal/pose/review_scope_operation_view_test.go:124:func TestGovernanceReadViewScopeCoordinatorHistoricalApprovalAndLaterRejection(t *testing.T) {\npose-mcp/internal/pose/review_scope_operation_view_test.go:165:func TestGovernanceReadViewScopeCoordinatorAuditsCatalogueAfterScopes(t *testing.T) {\npose-mcp/internal/pose/governance_read_view_d7_probe_test.go:79:func TestGovernanceReadViewD7ProbeContainmentPreservesUnavailableCause(t *testing.T) {\npose-mcp/internal/pose/governance_read_view_d7_probe_test.go:107:func TestGovernanceReadViewD7ProbeAuditExhaustionIsUnknownWithoutMutation(t *testing.T) {\npose-mcp/internal/pose/governance_read_view_d7_probe_test.go:141:func TestGovernanceReadViewD7ProbeSaturatedCoordinatorDoesNotConsumeScopeBudget(t *testing.T) {\npose-mcp/internal/pose/governance_read_view_d7_probe_test.go:177:func TestGovernanceReadViewD7ProbeScopeLossDoesNotPoisonHealthySibling(t *testing.T) {\npose-mcp/internal/cli/check.go:295:\tviewErr := store.WithReviewCoordinator(func(store pose.Store) error {\npose-mcp/internal/cli/check.go:344:\t\t\t\terr := store.WithReviewScopeOperationView(func(scoped pose.Store) error {\n.pose/knowledge/2026-10-26-handoff-delegation-observation-round4.md:27:- F01 (low, disclosed under D7): the live view redacts with what the stream has declared so far, and the record is derived again from the whole transcript; a capture the record later withholds can still have been shown live.\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:32:em cascata. D7 e a emenda aceita no ADR definem coordenador auditado e views\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:37:os checkpoints anteriores e não qualificam a correção D7.\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:119:- [ADR aceito](../adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md)\n\t\t\ts = s.withoutGovernanceReadView()\n\t\t\treadView, viewFiles = governanceReadViewFromFiles(s.fsys())\n\t\t}\n\t}\n\tif s.reviewView != nil && !s.reviewView.closed.Load() && !s.reviewView.boundTo(s) {\n\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t}\n\tif readView != nil && viewFiles != nil {\n\t\tif s.FederatedProjectID != \"\" && viewFiles.project != \"\" && s.FederatedProjectID != viewFiles.project {\n\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t}\n\t\tif readView.operation == nil {\n\t\t\tif filepath.Clean(s.Root) != filepath.Clean(readView.root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t\t// A same-root advisory view may be attached directly to a local Store\n\t\t\t// without an operation coordinator. Keep that local read path usable,\n\t\t\t// but do not infer a federated identity or borrow a resolver binding.\n\t\t\tif s.FederatedProjectID != viewFiles.project || s.FederatedResolver != nil || viewFiles.project != \"\" {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t} else {\n\t\t\t// StoreFor(project) deliberately returns an unscoped Store whose Files\n\t\t\t// wrapper still carries the primary read view. Route by the captured\n\t\t\t// project/root vector first, then verify the selected root itself;\n\t\t\t// comparing against readView.root here would reject every valid child.\n\t\t\trouteProject := viewFiles.project\n\t\t\tif routeProject == \"\" {\n\t\t\t\trouteProject = s.FederatedProjectID\n\t\t\t}\n\t\t\tif routeProject == \"\" {\n\t\t\t\trouteProject = readView.operation.mainProject\n\t\t\t}\n\t\t\tif !sameLexicalRoot(readView.operation.initialRoots[routeProject], s.Root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t\ttarget := readView.operation.route(s.Root, viewFiles.producer, routeProject)\n\t\t\tif target == nil || !sameLexicalRoot(target.root, s.Root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t}\n\t}\n\treturn s, nil\n}\n\nfunc (s Store) refuseReviewOperationContext(readView *governanceReadView, viewFiles *governanceReadViewFiles) error {\n\tif s.reviewView != nil && !s.reviewView.closed.Load() {\n\t\ts.reviewView.contextConflict.Store(true)\n\t}\n\tif readView != nil {\n\t\tproducer := \"review-operation\"\n\t\tif viewFiles != nil && viewFiles.producer != \"\" {\n\t\t\tproducer = viewFiles.producer\n\t\t}\n\t\treadView.markUnknown(producer, \"review Store context no longer matches the authorized operation binding\")\n\t}\n\treturn fmt.Errorf(\"pose: review Store context changed: %w\", errGovernanceReadViewOutsideRoot)\n}\n\nfunc (v *reviewOperationView) captureSpecs(s Store) {\n\tv.specOnce.Do(func() {\n\t\tv.specUsed = true\n\t\tentries, err := s.listSpecs(\"\", \"\")\n\t\tv.specErr = err\n\t\tif err != nil {\n\t\t\treturn\n\t\t}\n\t\tif len(entries) > v.maxRecords {\n\t\t\tv.specFallback = true\n\t\t\treturn\n\t\t}\n\t\tretained := 0\n\t\tfor _, sp := range entries {\n\t\t\traw, _ := json.Marshal(sp)\n\t\t\tretained += len(raw)\n\t\t\tif retained > v.maxRetainedText {\n\t\t\t\tv.specFallback = true\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\tv.specEntries = entries\n\t\tv.specBySlug = make(map[string]int, len(entries))\n\t\tfor i, sp := range entries {\n\t\t\tif _, exists := v.specBySlug[sp.Slug]; exists {\n\t\t\t\tv.specBySlug[sp.Slug] = -1\n\t\t\t} else {\n\t\t\t\tv.specBySlug[sp.Slug] = i\n\t\t\t}\n\t\t}\n\t\tv.specBodySeen = make([]bool, len(entries))\n\t\tv.specBodyDigests = make([][32]byte, len(entries))\n\t})\n}\n\nfunc (s Store) reviewViewSpec(slug string) (*Spec, bool, error) {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil, false, nil\n\t}\n\tv.captureSpecs(s)\n\tif v.specFallback {\n\t\treturn nil, false, nil\n\t}\n\tif v.specErr != nil {\n\t\treturn nil, true, v.specErr\n\t}\n\tindex, exists := v.specBySlug[slug]\n\tif !exists {\n\t\treturn nil, true, fmt.Errorf(\"pose: spec %q not found\", slug)\n\t}\n\tif index < 0 {\n\t\treturn nil, true, SpecIdentityConflictError{Slug: slug}\n\t}\n\tfull, err := s.readListedSpec(cloneSpec(v.specEntries[index]))\n\treturn full, true, err\n}\n\nfunc (s Store) reviewViewSpecs(status, components string) ([]Spec, bool, error) {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil, false, nil\n\tprimary                           *governanceReadView\n\troots                             []*governanceReadViewRoot\n\tinitialRoots                      map[string]string\n\tinitialConflicts                  map[string]bool\n\trootProjectByPath                 map[string]string\n\trootRegistryID                    string\n\tallowMissingPrimarySourceRevision bool\n\t// rebuildsIndex is set for the one operation that computes the index set from its sources:\n\t// it reads nothing from the published generation, so a generation that is unavailable\n\t// does not make its closure unknown (spec pose-index-recovery-and-close-scope-consistency).\n\trebuildsIndex    bool\n\tcurrentRoots     func() (map[string]string, map[string]bool, bool)\n\tresolver         ArtifactResolver\n\tbaseStore        Store\n\tmainProject      string\n\tindexPins        map[string]*IndexGenerationView\n\tindexInputChecks map[string]*governanceReadViewIndexInputCheck\n\tunknown          map[string]map[string]bool\n\trootOverflow     bool\n\tregistryOverflow bool\n\tfinalAudits      map[*governanceReadView]governanceReadViewAudit\n\tbudgetMu         sync.Mutex\n\tinputBytes       int64\n\tstreamedBytes    int64\n\tmetadataBytes    int64\n\trecords          int\n\tdirectoryEntries int\n\tgit              *governanceReadViewGitState\n\tmu               sync.Mutex\n}\n\ntype governanceReadViewIndexInputCheck struct {\n\tready   chan struct{}\n\treasons []string\n}\n\ntype governanceReadFileObservation struct {\n\tbytes     []byte\n\treadLimit int64\n\terr       error\n\terrText   string\n\tsource    string\n\tbaseName  string\n\tinfo      fs.FileInfo\n\twitness   fs.FileInfo\n\trootReal  string\n\tresolved  string\n\tproducers map[string]bool\n}\n\ntype governanceReadObservation struct {\n\tmethod     string\n\tpath       string\n\tbaseName   string\n\terr        error\n\terrText    string\n\tinfo       fs.FileInfo\n\twitness    fs.FileInfo\n\tentries    []string\n\tdirEntries []fs.DirEntry\n\tvalue      string\n\tproducers  map[string]bool\n}\n\ntype governanceReadViewAudit struct {\n\tChangedPaths     []string\n\tChangedProducers map[string]bool\n\tUnknownProducers map[string][]string\n}\n\ntype governanceReadViewAuditBudget struct {\n\tinputBytes int64\n\tmetadata   int64\n\trecords    int\n}\n\nfunc (b *governanceReadViewAuditBudget) reserve(metadata int64) bool {\n\tif b == nil || metadata < 0 || b.records+1 > governanceReadViewMaxRecords || metadata > governanceReadViewMaxMetadata-b.metadata {\n\t\treturn false\n\t}\n\tb.records++\n\tb.metadata += metadata\n\treturn true\n}\n\nfunc (b *governanceReadViewAuditBudget) reserveInput(bytes int64) bool {\n\tif b == nil || bytes < 0 || bytes > governanceReadViewMaxInputBytes-b.inputBytes {\n\t\treturn false\n\t}\n\tb.inputBytes += bytes\n\treturn true\n}\n\nfunc (b *governanceReadViewAuditBudget) reserveDirectory(entries []fs.DirEntry, maxEntries int, maxMetadata int64) bool {\n\tif b == nil || len(entries) > maxEntries || len(entries) > governanceReadViewMaxRecords-b.records {\n\t\treturn false\n\t}\n\tmetadata := readViewDirMetadataBytes(entries)\n\tif metadata > maxMetadata || metadata > governanceReadViewMaxMetadata-b.metadata {\n\t\treturn false\n\t}\n\tb.records += len(entries)\n\tb.metadata += metadata\n\treturn true\n}\n\ntype governanceReadViewProof struct {\n\troot        string\n\tinputBudget int64\n\tentries     []governanceReadProofEntry\n\tbase        Files\n\tchildren    []*governanceReadViewProof\n}\n\ntype governanceReadProofEntry struct {\n\tmethod     string\n\tpath       string\n\tbaseName   string\n\tdigest     string\n\terrText    string\n\tinfo       fs.FileInfo\n\twitness    fs.FileInfo\n\trootReal   string\n\tresolved   string\n\tinputBytes int64\n\treadLimit  int64\n\tentries    []string\n\tvalue      string\n\tproducers  []string\n}\n\ntype canonicalReadViewEntry struct {\n\tMethod         string   `json:\"method\"`\n\tPath           string   `json:\"path\"`\n\tDigest         string   `json:\"digest,omitempty\"`\n\tErrorDigest    string   `json:\"error_digest,omitempty\"`\n\tName           string   `json:\"name,omitempty\"`\n\tSize           int64    `json:\"size,omitempty\"`\n\tMode           uint32   `json:\"mode,omitempty\"`\n\tModTime        int64    `json:\"mod_time,omitempty\"`\n\tIdentityDigest string   `json:\"identity_digest,omitempty\"`\n\tEntries        []string `json:\"entries,omitempty\"`\n\tValueDigest    string   `json:\"value_digest,omitempty\"`\n\tResolvedDigest string   `json:\"resolved_digest,omitempty\"`\n}\n\nfunc newGovernanceReadView(root string, base Files) *governanceReadView {\n\tview := &governanceReadView{root: filepath.Clean(root), base: FilesOrNative(base), files: map[string]*governanceReadFileObservation{}, observed: map[string]*governanceReadObservation{}, unknown: map[string]map[string]bool{}}\n\tview.cond = sync.NewCond(&view.mu)\n\treturn view\n}\n\nfunc (op *governanceReadViewOperation) route(name, producer, project string) *governanceReadView {\n\tif op == nil {\n\t\treturn nil\n\t}\n\tpath, err := filepath.Abs(name)\n\tif err != nil {\n\t\treturn nil\n\t}\n\tpath = filepath.Clean(path)\n\top.mu.Lock()\n\trootID, rootPath := op.rootForPathLocked(path, project)\n\tif rootID == \"\" {\n\t\top.mu.Unlock()\n\t\treturn nil\n\t}\n\tfor _, candidate := range op.roots {\n\t\tif candidate.project == rootID && sameLexicalRoot(candidate.root, rootPath) {\n\t\t\tif producer != \"\" {\n\t\t\t\tcandidate.producers[producer] = true\n\t\t\t}\n\t\t\tview, ready := candidate.view, candidate.ready\n\t\t\top.mu.Unlock()\n\t\t\tif ready != nil {\n\t\t\t\t<-ready\n\t\t\t}\n\t\t\treturn view\n\t\t}\n\t}\n\tif len(op.roots) >= 16 {\n\t\top.rootOverflow = true\n\t\tprimary := op.primary\n\t\top.mu.Unlock()\n\t\tprimary.markUnknown(producer, \"operation exceeded the 16 authorized-root budget\")\n\t\treturn nil\n\t}\n\trootStore, storeErr := op.resolver.Roots.StoreFor(rootID)\n\tif storeErr != nil {\n\t\trootStore = Store{Root: rootPath, FS: op.resolver.fsys()}\n\t}\n\trootStore = rootStore.withoutGovernanceReadView()\n\trootStore.Root = rootPath\n\tview := newGovernanceReadView(rootPath, rootStore.fsys())\n\tready := make(chan struct{})\n\tentry := &governanceReadViewRoot{project: rootID, root: rootPath, revision: \"unknown\", indexGeneration: \"legacy\", store: rootStore, view: view, ready: ready, producers: map[string]bool{producer: true}}\n\top.roots = append(op.roots, entry)\n\tslot := op.indexPins[rootID]\n\tif slot == nil {\n\t\tslot = &IndexGenerationView{}\n\t\top.indexPins[rootID] = slot\n\t}\n\top.mu.Unlock()\n\n\tview.markUnknownIf(storeErr != nil, producer, \"authorized project root could not be opened\")\n\trevisionBytes, revisionErr := op.capture(rootPath, producer, \"rev-parse\", \"--verify\", \"HEAD\")\n\tentry.revision = strings.TrimSpace(string(revisionBytes))\n\tif revisionErr != nil || entry.revision == \"\" {\n\t\tentry.revision = \"unknown\"\n\t}\n\tif entry.revision == \"unknown\" {\n\t\tview.markUnknown(producer, \"source revision for an authorized root is unavailable\")\n\t}\n\tpinned := rootStore\n\tpinned.Root, pinned.FS = rootPath, view.filesFor(producer)\n\tpinned = pinned.PinIndexes()\n\tif pinned.indexPin != nil {\n\t\t*slot = *pinned.indexPin\n\t\tentry.indexPin = slot\n\t\tswitch slot.Status {\n\t\tcase IndexGenerationCurrent:\n\t\t\tentry.indexGeneration = slot.Descriptor.GenerationID\n\t\tcase IndexGenerationUnavailable:\n\t\t\tentry.indexGeneration = \"unknown\"\n\t\t\tif !op.rebuildsIndex {\n\t\t\t\tview.markUnknown(producer, \"index generation could not be pinned: \"+slot.Reason)\n","exit_code":0,"status":"completed"}}
