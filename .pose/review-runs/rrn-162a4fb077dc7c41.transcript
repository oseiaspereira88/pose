{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '260,430p' pose-mcp/internal/cli/check.go; cat pose-mcp/internal/pose/review_scope_operation_view_test.go; cat pose-mcp/internal/pose/governance_read_view_d7_probe_test.go; rg -n 'func .*boundTo|beginGovernanceReadView|func .*audit\\\\(' pose-mcp/internal/pose/{review_operation_view,governance_read_view}.go; rg -n 'InputBinding|federated-material' pose-mcp/internal/pose/index_generation*.go\"","aggregated_output":"\tpolicy, err := pose.LoadArtifactPolicyIn(checker.fsys(), checker.root)\n\tif err != nil {\n\t\tchecker.failOrWarn(\"artifact contract: \" + err.Error())\n\t\treturn\n\t}\n\tif !policy.Enabled {\n\t\treturn\n\t}\n\tstore := pose.Store{Root: checker.root, FS: checker.fsys()}\n\tpaths := findSpecFilesIn(checker.fsys(), checker.root)\n\tfor _, path := range paths {\n\t\tfm := simpleFrontmatterIn(checker.fsys(), path)\n\t\tif fm[\"status\"] != \"done\" || fm[\"completed_at\"] < policy.AdoptedAt {\n\t\t\tcontinue\n\t\t}\n\t\tslug := fm[\"slug\"]\n\t\tif slug == \"\" {\n\t\t\tslug = filepath.Base(filepath.Dir(path))\n\t\t}\n\t\tspec, err := store.GetSpec(slug)\n\t\tif err != nil {\n\t\t\tchecker.failOrWarn(\"artifact contract: spec:\" + slug + \": \" + err.Error())\n\t\t\tcontinue\n\t\t}\n\t\tclaims, found, err := pose.ParseArtifactClaims(*spec, policy)\n\t\tif err != nil || !found || len(claims) == 0 {\n\t\t\tchecker.failOrWarn(fmt.Sprintf(\"artifact contract: spec:%s requires one structured claim or none reason: %v\", slug, err))\n\t\t}\n\t}\n}\n\nfunc (checker *nativeChecker) checkReviewCloseout() {\n\tpolicyPath := filepath.Join(checker.root, \".pose\", \"policy\", \"review.json\")\n\tstore := pose.Store{Root: checker.root, FS: checker.fsys()}\n\tvar findings []string\n\tviewErr := store.WithReviewCoordinator(func(store pose.Store) error {\n\t\tfiles := pose.FilesOrNative(store.FS)\n\t\traw, err := files.ReadFile(policyPath)\n\t\tif os.IsNotExist(err) {\n\t\t\treturn nil\n\t\t}\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"cannot read policy: %w\", err)\n\t\t}\n\t\tvar policy struct {\n\t\t\tEnabled   bool   `json:\"enabled\"`\n\t\t\tAdoptedAt string `json:\"adopted_at\"`\n\t\t}\n\t\tif err := json.Unmarshal(raw, &policy); err != nil || policy.AdoptedAt == \"\" {\n\t\t\treturn fmt.Errorf(\"invalid review policy\")\n\t\t}\n\t\tif !policy.Enabled {\n\t\t\treturn nil\n\t\t}\n\t\trefs := []string{}\n\t\tfor _, path := range findSpecFilesIn(files, checker.root) {\n\t\t\tfm := simpleFrontmatterIn(files, path)\n\t\t\tif fm[\"status\"] != \"done\" || fm[\"completed_at\"] < policy.AdoptedAt {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tslug := fm[\"slug\"]\n\t\t\tif slug == \"\" {\n\t\t\t\tslug = filepath.Base(filepath.Dir(path))\n\t\t\t}\n\t\t\trefs = append(refs, \"spec:\"+slug)\n\t\t}\n\t\troadmapPaths, err := pose.GlobIn(files, filepath.Join(checker.root, \".pose\", \"roadmaps\", \"*.md\"))\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"cannot enumerate roadmaps: %w\", err)\n\t\t}\n\t\tfor _, path := range roadmapPaths {\n\t\t\tfm := simpleFrontmatterIn(files, path)\n\t\t\tif fm[\"status\"] == \"done\" && fm[\"created_at\"] >= policy.AdoptedAt {\n\t\t\t\trefs = append(refs, \"roadmap:\"+strings.TrimSuffix(filepath.Base(path), \".md\"))\n\t\t\t}\n\t\t}\n\t\tresults := make([][]string, len(refs))\n\t\t// Bound live scope closures even when the worker override or host CPU count\n\t\t// is large. Retain only evaluated findings after each scope's final audit.\n\t\tslots := min(16, len(refs))\n\t\tchecker.failOrWarnPerItem(slots, func(slot int) []string {\n\t\t\tfor i := slot; i < len(refs); i += slots {\n\t\t\t\tref := refs[i]\n\t\t\t\tvar state pose.CloseoutState\n\t\t\t\terr := store.WithReviewScopeOperationView(func(scoped pose.Store) error {\n\t\t\t\t\tvar err error\n\t\t\t\t\tstate, err = scoped.GetCloseoutState(ref)\n\t\t\t\t\treturn err\n\t\t\t\t})\n\t\t\t\tif err != nil {\n\t\t\t\t\tresults[i] = []string{\"review closeout: \" + ref + \": \" + err.Error()}\n\t\t\t\t} else if !state.Terminal {\n\t\t\t\t\tresults[i] = []string{\"review closeout: \" + ref + \": \" + state.NextAction}\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn nil\n\t\t})\n\t\tfor _, messages := range results {\n\t\t\tfindings = append(findings, messages...)\n\t\t}\n\t\treturn nil\n\t})\n\t// A failed coordinator audit prevents a green gate, but does not erase\n\t// independently audited scope failures already buffered above.\n\tfor _, finding := range findings {\n\t\tchecker.failOrWarn(finding)\n\t}\n\tif viewErr != nil {\n\t\tchecker.failOrWarn(\"review closeout: \" + viewErr.Error())\n\t}\n}\n\nfunc (checker *nativeChecker) checkRequiredStructure() {\n\trequired := []string{\"AGENTS.md\", \"POSE.md\", \".pose\", \".pose/workflows\", \".pose/templates\", \".pose/rules\", \".pose/workflows/feature.md\", \".pose/workflows/review.md\", \".pose/workflows/bugfix.md\", \".pose/templates/spec.md\"}\n\tfor _, rel := range required {\n\t\tif _, err := checker.fsys().Stat(filepath.Join(checker.root, filepath.FromSlash(rel))); err != nil {\n\t\t\tchecker.issue(cliout.StateError, checker.message(\"Required path missing: \", \"Path obrigatório ausente: \")+filepath.Join(checker.root, filepath.FromSlash(rel)))\n\t\t}\n\t}\n}\n\nfunc (checker *nativeChecker) checkSchemaVersion() {\n\tpath := filepath.Join(checker.root, \".pose\", \"schema-version\")\n\tcontent, err := checker.fsys().ReadFile(path)\n\tif err != nil {\n\t\tchecker.failOrWarn(checker.message(\"schema: instance has no .pose/schema-version — run 'pose update'\", \"schema: instância sem .pose/schema-version — rode 'pose update'\"))\n\t\treturn\n\t}\n\tversion, err := strconv.Atoi(strings.TrimSpace(string(content)))\n\tif err != nil {\n\t\tchecker.issue(cliout.StateError, fmt.Sprintf(checker.message(\"schema: invalid .pose/schema-version (%q)\", \"schema: .pose/schema-version inválido (%q)\"), strings.TrimSpace(string(content))))\n\t\treturn\n\t}\n\tif version > nativeSchemaVersion {\n\t\tchecker.issue(cliout.StateError, fmt.Sprintf(checker.message(\"schema: instance v%d is newer than engine v%d\", \"schema: instância v%d é mais nova que o motor v%d\"), version, nativeSchemaVersion))\n\t}\n\tif version < nativeSchemaVersion {\n\t\tchecker.failOrWarn(fmt.Sprintf(checker.message(\"schema: instance v%d is behind engine v%d — run 'pose update'\", \"schema: instância v%d atrás do motor v%d — rode 'pose update'\"), version, nativeSchemaVersion))\n\t}\n}\n\nfunc (checker *nativeChecker) checkReferences() {\n\tfor _, rel := range []string{\"AGENTS.md\", \"POSE.md\"} {\n\t\tpath := filepath.Join(checker.root, rel)\n\t\tcontent, err := checker.fsys().ReadFile(path)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tseen := map[string]bool{}\n\t\tfor _, match := range checkReference.FindAllStringSubmatch(string(content), -1) {\n\t\t\tref := strings.TrimRight(match[1], \"/\")\n\t\t\tif ref == \"\" || seen[ref] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseen[ref] = true\n\t\t\tif !confinedRelativePath(ref) {\n\t\t\t\tchecker.failOrWarn(fmt.Sprintf(checker.message(\"Reference escapes the project root: %q (source: %s)\", \"Referência escapa da raiz do projeto: %q (origem: %s)\"), ref, rel))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif isRuntimeReference(ref) {\n\t\t\t\tif _, err := checker.fsys().Stat(filepath.Join(checker.root, \".pose\")); err != nil {\n\t\t\t\t\tchecker.failOrWarn(fmt.Sprintf(checker.message(\"Broken reference: %q (source: %s)\", \"Referência quebrada: %q (origem: %s)\"), ref, rel))\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, err := checker.fsys().Stat(filepath.Join(checker.root, filepath.FromSlash(ref))); err != nil {\n\t\t\t\tchecker.failOrWarn(fmt.Sprintf(checker.message(\"Broken reference: %q (source: %s)\", \"Referência quebrada: %q (origem: %s)\"), ref, rel))\n\t\t\t}\n\t\t}\n\t\tif len(seen) == 0 {\n\t\t\tchecker.issue(cliout.StateError, checker.message(\"No POSE reference found to validate in \", \"Nenhuma referência POSE encontrada para validar em \")+rel)\npackage pose\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestGovernanceReadViewRoadmapChildrenKeepAuthorizedBinding(t *testing.T) {\n\tstore, _, _ := retentionFixture(t)\n\twriteReviewFixture(t, store.Root, \".pose/roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\n---\\n# Program\\n\\n## Milestone: core\\n- specs: backend\\n\")\n\tbindCurrentReviewFixture(t, store)\n\terr := store.WithReviewCoordinator(func(shared Store) error {\n\t\treturn shared.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\tstate, err := scope.GetCloseoutState(\"roadmap:program\")\n\t\t\tif err == nil && (len(state.Children) != 1 || len(state.Children[0].Children) != 1) {\n\t\t\t\tt.Fatalf(\"children were not evaluated: %+v\", state)\n\t\t\t}\n\t\t\treturn err\n\t\t})\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc TestGovernanceReadViewScopeCoordinatorRetainsCallbackAndAuditFailure(t *testing.T) {\n\troot, _ := d7ProbeCoordinatorRoot(t)\n\tpath := filepath.Join(root, \"policy.json\")\n\tif err := os.WriteFile(path, []byte(\"before\"), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcallbackFailure := errors.New(\"domain evaluation failed\")\n\terr := (Store{Root: root}).WithReviewCoordinator(func(shared Store) error {\n\t\tif _, err := shared.fsys().ReadFile(path); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := os.WriteFile(path, []byte(\"after!\"), 0600); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn callbackFailure\n\t})\n\tif !errors.Is(err, callbackFailure) || !errors.Is(err, ErrGovernanceReadViewChanged) {\n\t\tt.Fatalf(\"callback or audit cause was lost: %v\", err)\n\t}\n}\n\nfunc TestGovernanceReadViewScopeCoordinatorRefusesRetiredOrChangedBinding(t *testing.T) {\n\tfor _, kind := range []string{\"root\", \"project\", \"resolver\", \"files\", \"retired\"} {\n\t\tt.Run(kind, func(t *testing.T) {\n\t\t\troot, _ := d7ProbeCoordinatorRoot(t)\n\t\t\tvar retained Store\n\t\t\tvar scopeErr error\n\t\t\tcalled := false\n\t\t\touterErr := (Store{Root: root}).WithReviewCoordinator(func(shared Store) error {\n\t\t\t\tretained = shared\n\t\t\t\tif kind == \"retired\" {\n\t\t\t\t\treturn nil\n\t\t\t\t}\n\t\t\t\tbad := shared\n\t\t\t\tswitch kind {\n\t\t\t\tcase \"root\":\n\t\t\t\t\tbad.Root = t.TempDir()\n\t\t\t\tcase \"project\":\n\t\t\t\t\tbad.FederatedProjectID = \"proj.foreign\"\n\t\t\t\tcase \"resolver\":\n\t\t\t\t\tbad.FederatedResolver = &ArtifactResolver{}\n\t\t\t\tcase \"files\":\n\t\t\t\t\tbad.FS = NativeFiles()\n\t\t\t\t}\n\t\t\t\tscopeErr = bad.WithReviewScopeOperationView(func(Store) error { called = true; return nil })\n\t\t\t\treturn scopeErr\n\t\t\t})\n\t\t\tif kind == \"retired\" {\n\t\t\t\tif outerErr != nil {\n\t\t\t\t\tt.Fatal(outerErr)\n\t\t\t\t}\n\t\t\t\tscopeErr = retained.WithReviewScopeOperationView(func(Store) error { called = true; return nil })\n\t\t\t}\n\t\t\tif scopeErr == nil || called {\n\t\t\t\tt.Fatalf(\"scope borrowed an unauthorized binding: callback=%t err=%v\", called, scopeErr)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestGovernanceReadViewScopeCoordinatorParallelClosuresStayIndependent(t *testing.T) {\n\troot, path := d7ProbeCoordinatorRoot(t)\n\terr := (Store{Root: root}).WithReviewCoordinator(func(shared Store) error {\n\t\tconst count = 4\n\t\terrs := make(chan error, count)\n\t\tvar wg sync.WaitGroup\n\t\tfor i := 0; i < count; i++ {\n\t\t\twg.Add(1)\n\t\t\tgo func() {\n\t\t\t\tdefer wg.Done()\n\t\t\t\terrs <- shared.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\t\t\trv, _ := governanceReadViewFromFiles(scope.fsys())\n\t\t\t\t\trv.operation.budgetMu.Lock()\n\t\t\t\t\trv.operation.inputBytes = governanceReadViewMaxInputBytes - 40\n\t\t\t\t\trv.operation.budgetMu.Unlock()\n\t\t\t\t\t_, err := scope.fsys().ReadFile(path)\n\t\t\t\t\treturn err\n\t\t\t\t})\n\t\t\t}()\n\t\t}\n\t\twg.Wait()\n\t\tclose(errs)\n\t\tvar combined error\n\t\tfor err := range errs {\n\t\t\tcombined = errors.Join(combined, err)\n\t\t}\n\t\treturn combined\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"independently fitting parallel scopes shared consumption: %v\", err)\n\t}\n}\n\nfunc TestGovernanceReadViewScopeCoordinatorHistoricalApprovalAndLaterRejection(t *testing.T) {\n\tfor _, reject := range []bool{false, true} {\n\t\tlabel := \"retained\"\n\t\tif reject {\n\t\t\tlabel = \"later-rejection\"\n\t\t}\n\t\tt.Run(label, func(t *testing.T) {\n\t\t\tstore, _, now := retentionFixture(t)\n\t\t\tif reject {\n\t\t\t\taddMatrixCheck(t, store)\n\t\t\t\tnext, err := store.SealReviewBundle(\"spec:backend\", now.Add(2*time.Minute))\n\t\t\t\tif err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t\tatt := approvedBundleAttestation(next, \"agent:later\")\n\t\t\t\tatt.Decision = \"rejected\"\n\t\t\t\tif _, err := store.RecordReviewAttestation(att, now.Add(3*time.Minute)); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tcloseBackendSpec(t, store)\n\t\t\taddMatrixCheck(t, store)\n\t\t\tbindCurrentReviewFixture(t, store)\n\t\t\tvar state CloseoutState\n\t\t\terr := store.WithReviewCoordinator(func(shared Store) error {\n\t\t\t\treturn shared.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\t\t\tvar err error\n\t\t\t\t\tstate, err = scope.GetCloseoutState(\"spec:backend\")\n\t\t\t\t\treturn err\n\t\t\t\t})\n\t\t\t})\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif state.Terminal == reject || state.Review.Approved == reject {\n\t\t\t\tt.Fatalf(\"historical decision lost under scoped coordinator: reject=%t state=%+v\", reject, state)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestGovernanceReadViewScopeCoordinatorAuditsCatalogueAfterScopes(t *testing.T) {\n\troot, path := d7ProbeCoordinatorRoot(t)\n\tsp := filepath.Join(root, \".pose/specs/alpha.md\")\n\toriginal := \"---\\nslug: alpha\\nstatus: done\\ncreated_at: 2026-08-13\\ncompleted_at: 2026-08-13\\n---\\nbody\\n\"\n\tif err := os.WriteFile(sp, []byte(original), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\terr := (Store{Root: root}).WithReviewCoordinator(func(shared Store) error {\n\t\tif _, err := shared.ListSpecs(\"\", \"\"); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := shared.WithReviewScopeOperationView(func(scope Store) error { _, err := scope.fsys().ReadFile(path); return err }); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn os.WriteFile(sp, []byte(strings.Replace(original, \"status: done\", \"status: draft\", 1)), 0600)\n\t})\n\tif err == nil || !strings.Contains(err.Error(), \"changed\") {\n\t\tt.Fatalf(\"selection changed after successful scope and escaped coordinator audit: %v\", err)\n\t}\n}\n\nfunc TestGovernanceReadViewScopeAuditPreservesChangeAndIndependentUnknown(t *testing.T) {\n\taudit := governanceReadViewAudit{ChangedPaths: []string{\"changed.json\"}, ChangedProducers: map[string]bool{\"review-operation\": true}, UnknownProducers: map[string][]string{\"review-operation\": {\"a different input exceeded its final-audit budget\"}}}\n\terr := reviewOperationGovernanceAuditError(audit, nil, nil)\n\tif !errors.Is(err, ErrGovernanceReadViewChanged) || !errors.Is(err, ErrGovernanceReadViewUnknown) {\n\t\tt.Fatalf(\"independent changed/unknown causes were collapsed: %v\", err)\n\t}\n}\npackage pose\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\ntype d7DirectoryAuditFiles struct {\n\tFiles\n\tpath  string\n\topens int\n}\n\nfunc (f *d7DirectoryAuditFiles) Open(path string) (fs.File, error) {\n\tif path == f.path {\n\t\tf.opens++\n\t}\n\treturn f.Files.Open(path)\n}\n\nfunc TestGovernanceReadViewDirectoryInfoAuditIsLinearAndDetectsChange(t *testing.T) {\n\tfor _, mutate := range []bool{false, true} {\n\t\tt.Run(fmt.Sprint(mutate), func(t *testing.T) {\n\t\t\troot := t.TempDir()\n\t\t\tfor i := 0; i < 200; i++ {\n\t\t\t\tif err := os.WriteFile(filepath.Join(root, fmt.Sprintf(\"entry-%03d\", i)), []byte(\"before\"), 0600); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tfiles := &d7DirectoryAuditFiles{Files: NativeFiles(), path: root}\n\t\t\tview := newGovernanceReadView(root, files)\n\t\t\tentries, err := view.filesFor(\"probe\").ReadDir(root)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tfor _, entry := range entries {\n\t\t\t\tif _, err := entry.Info(); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif mutate {\n\t\t\t\tif err := os.WriteFile(filepath.Join(root, \"entry-050\"), []byte(\"changed size\"), 0600); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tfiles.opens = 0\n\t\t\taudit := view.auditSingle()\n\t\t\tif files.opens != 1 {\n\t\t\t\tt.Fatalf(\"audit listed one directory %d times\", files.opens)\n\t\t\t}\n\t\t\tif len(audit.UnknownProducers) != 0 {\n\t\t\t\tt.Fatalf(\"fitting audit lost coverage: %+v\", audit)\n\t\t\t}\n\t\t\tif audit.ChangedProducers[\"probe\"] != mutate {\n\t\t\t\tt.Fatalf(\"change=%t audit=%+v\", mutate, audit)\n\t\t\t}\n\t\t})\n\t}\n}\n\ntype d7ProbeContainmentFiles struct {\n\tFiles\n\tfailPath string\n\tcause    error\n}\n\nfunc (f d7ProbeContainmentFiles) EvalSymlinks(path string) (string, error) {\n\tif filepath.Clean(path) == filepath.Clean(f.failPath) {\n\t\treturn \"\", fmt.Errorf(\"injected containment read loss: %w\", f.cause)\n\t}\n\treturn f.Files.EvalSymlinks(path)\n}\n\nfunc TestGovernanceReadViewD7ProbeContainmentPreservesUnavailableCause(t *testing.T) {\n\troot := t.TempDir()\n\tpath := filepath.Join(root, \"fixture.md\")\n\tif err := os.WriteFile(path, []byte(\"---\\nslug: fixture\\nstatus: draft\\n---\\n\"), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, failPath := range []string{root, path} {\n\t\tt.Run(filepath.Base(failPath), func(t *testing.T) {\n\t\t\tstore := Store{Root: root, FS: d7ProbeContainmentFiles{Files: NativeFiles(), failPath: failPath, cause: errGovernanceReadViewBudget}}\n\t\t\t_, err := store.readListedSpec(Spec{Slug: \"fixture\", Path: path})\n\t\t\tif !errors.Is(err, errGovernanceReadViewBudget) || strings.Contains(err.Error(), \"escapes project\") {\n\t\t\t\tt.Fatalf(\"unavailable containment was misclassified or lost its cause: %v\", err)\n\t\t\t}\n\t\t})\n\t}\n\toutside := filepath.Join(t.TempDir(), \"outside.md\")\n\tif err := os.WriteFile(outside, []byte(\"outside\"), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlink := filepath.Join(root, \"escaping.md\")\n\tif err := os.Symlink(outside, link); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := (Store{Root: root}).readListedSpec(Spec{Slug: \"escape\", Path: link}); err == nil || !strings.Contains(err.Error(), \"escapes project\") {\n\t\tt.Fatalf(\"actual escaping link was not refused as an escape: %v\", err)\n\t}\n}\n\nfunc TestGovernanceReadViewD7ProbeAuditExhaustionIsUnknownWithoutMutation(t *testing.T) {\n\troot := t.TempDir()\n\tpath := filepath.Join(root, \"input.json\")\n\tif err := os.WriteFile(path, []byte(\"unchanged\"), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tview := newGovernanceReadView(root, NativeFiles())\n\tif _, err := view.filesFor(\"d7-probe\").ReadFile(path); err != nil {\n\t\tt.Fatal(err)\n\t}\n\taudit := view.auditSingleWithBudget(&governanceReadViewAuditBudget{records: governanceReadViewMaxRecords})\n\tif len(audit.UnknownProducers[\"d7-probe\"]) == 0 {\n\t\tt.Fatalf(\"audit exhaustion was certified: %+v\", audit)\n\t}\n\tif len(audit.ChangedPaths) != 0 || audit.ChangedProducers[\"d7-probe\"] {\n\t\tt.Fatalf(\"unchanged input was labelled as an observed mutation: %+v\", audit)\n\t}\n}\n\nfunc d7ProbeCoordinatorRoot(t *testing.T) (string, string) {\n\tt.Helper()\n\troot := t.TempDir()\n\tfor _, rel := range []string{\".pose/specs\", \".pose/review-bundles\"} {\n\t\tif err := os.MkdirAll(filepath.Join(root, rel), 0700); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tpath := filepath.Join(root, \"scope-input.json\")\n\tif err := os.WriteFile(path, []byte(strings.Repeat(\"x\", 32)), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn root, path\n}\n\nfunc TestGovernanceReadViewD7ProbeSaturatedCoordinatorDoesNotConsumeScopeBudget(t *testing.T) {\n\troot, path := d7ProbeCoordinatorRoot(t)\n\tcount := 0\n\terr := (Store{Root: root}).WithReviewCoordinator(func(coordinator Store) error {\n\t\t// Warm the bounded catalog before admitting independent scopes. Simulate\n\t\t// previous coordinator consumption with counters, not huge allocations.\n\t\tif err := coordinator.WithReviewScopeOperationView(func(Store) error { return nil }); err != nil {\n\t\t\treturn err\n\t\t}\n\t\trv, _ := governanceReadViewFromFiles(coordinator.fsys())\n\t\trv.operation.budgetMu.Lock()\n\t\trv.operation.inputBytes = governanceReadViewMaxInputBytes - 8\n\t\trv.operation.metadataBytes = governanceReadViewMaxMetadata - 8\n\t\trv.operation.records = governanceReadViewMaxRecords - 1\n\t\trv.operation.budgetMu.Unlock()\n\t\tfor i := 0; i < 2; i++ {\n\t\t\tif err := coordinator.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\t\traw, err := scope.fsys().ReadFile(path)\n\t\t\t\tif err == nil && len(raw) != 32 {\n\t\t\t\t\treturn fmt.Errorf(\"scope returned %d bytes\", len(raw))\n\t\t\t\t}\n\t\t\t\tif err == nil {\n\t\t\t\t\tcount++\n\t\t\t\t}\n\t\t\t\treturn err\n\t\t\t}); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil || count != 2 {\n\t\tt.Fatalf(\"fitting scope reads inherited coordinator exhaustion: count=%d err=%v\", count, err)\n\t}\n}\n\nfunc TestGovernanceReadViewD7ProbeScopeLossDoesNotPoisonHealthySibling(t *testing.T) {\n\troot, path := d7ProbeCoordinatorRoot(t)\n\tvar scopeLoss error\n\thealthy := false\n\terr := (Store{Root: root}).WithReviewCoordinator(func(coordinator Store) error {\n\t\tscopeLoss = coordinator.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\trv, _ := governanceReadViewFromFiles(scope.fsys())\n\t\t\trv.operation.budgetMu.Lock()\n\t\t\trv.operation.records = governanceReadViewMaxRecords\n\t\t\trv.operation.budgetMu.Unlock()\n\t\t\t_, err := scope.fsys().ReadFile(path)\n\t\t\treturn err\n\t\t})\n\t\tsiblingErr := coordinator.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\t_, err := scope.fsys().ReadFile(path)\n\t\t\thealthy = err == nil\n\t\t\treturn err\n\t\t})\n\t\treturn errors.Join(scopeLoss, siblingErr)\n\t})\n\tif scopeLoss == nil || !healthy || !errors.Is(err, ErrGovernanceReadViewUnknown) {\n\t\tt.Fatalf(\"loss was suppressed or poisoned sibling: scope=%v healthy=%t coordinator=%v\", scopeLoss, healthy, err)\n\t}\n}\n\n// The registry is an operation input, not a file in any one root. Inject its\n// final observation at the same boundary used by the production wrappers.\nfunc injectGovernanceRegistryAudit(store Store, mode string) {\n\tview, _ := governanceReadViewFromFiles(store.fsys())\n\top := view.operation\n\top.mu.Lock()\n\troots := map[string]string{}\n\tfor project, root := range op.initialRoots {\n\t\troots[project] = root\n\t}\n\tconflicts := cloneBoolMap(op.initialConflicts)\n\top.currentRoots = func() (map[string]string, map[string]bool, bool) {\n\t\tif mode == \"changed\" {\n\t\t\troots[\"proj.added\"] = filepath.Join(store.Root, \"added-root\")\n\t\t}\n\t\tif mode == \"conflict\" {\n\t\t\tconflicts[op.mainProject] = true\n\t\t}\n\t\treturn roots, conflicts, mode == \"budget\"\n\t}\n\top.mu.Unlock()\n}\n\nfunc TestGovernanceReadViewRegistryFinalAuditReachesReviewAndCloseout(t *testing.T) {\n\tfor _, gate := range []string{\"review\", \"closeout\"} {\n\t\tfor _, mode := range []string{\"stable\", \"once\", \"changed\", \"conflict\", \"budget\"} {\n\t\t\tt.Run(gate+\"/\"+mode, func(t *testing.T) {\n\t\t\t\tstore, _, _ := retentionFixture(t)\n\t\t\t\tcloseBackendSpec(t, store)\n\t\t\t\tbindCurrentReviewFixture(t, store)\n\t\t\t\tcalls := 0\n\t\t\t\tinject := func(s Store) {\n\t\t\t\t\tcalls++\n\t\t\t\t\tif mode == \"stable\" || mode == \"once\" && calls > 1 {\n\t\t\t\t\t\treturn\n\t\t\t\t\t}\n\t\t\t\t\tselected := mode\n\t\t\t\t\tif selected == \"once\" {\n\t\t\t\t\t\tselected = \"changed\"\n\t\t\t\t\t}\n\t\t\t\t\tinjectGovernanceRegistryAudit(s, selected)\n\t\t\t\t}\n\t\t\t\tvar metadata *ReadViewMetadata\n\t\t\t\tvar approved, fresh, terminal bool\n\t\t\t\tif gate == \"review\" {\n\t\t\t\t\tvalue, err := withGovernanceReviewReadView(store, \"review\", func(s Store) (ReviewEvaluation, error) {\n\t\t\t\t\t\tresult, err := s.ReviewCheck(\"spec:backend\")\n\t\t\t\t\t\tinject(s)\n\t\t\t\t\t\treturn result, err\n\t\t\t\t\t}, applyReviewReadView)\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\tt.Fatal(err)\n\t\t\t\t\t}\n\t\t\t\t\tmetadata, approved, fresh = value.ReadView, value.Approved, value.Fresh\n\t\t\t\t} else {\n\t\t\t\t\tvalue, err := withGovernanceReviewReadView(store, \"closeout\", func(s Store) (CloseoutState, error) {\n\t\t\t\t\t\tresult, err := s.getCloseoutState(\"spec:backend\", true)\n\t\t\t\t\t\tinject(s)\n\t\t\t\t\t\treturn result, err\n\t\t\t\t\t}, func(v *CloseoutState, m *ReadViewMetadata, a governanceReadViewAudit) {\n\t\t\t\t\t\tapplyCloseoutReadView(v, m, \"spec:backend\", a)\n\t\t\t\t\t})\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\tt.Fatal(err)\n\t\t\t\t\t}\n\t\t\t\t\tmetadata, approved, fresh, terminal = value.ReadView, value.Review.Approved, value.Review.Fresh, value.Terminal\n\t\t\t\t}\n\t\t\t\texpectedCalls := 1\n\t\t\t\tif mode == \"once\" || mode == \"changed\" || mode == \"conflict\" {\n\t\t\t\t\texpectedCalls = 2\n\t\t\t\t}\n\t\t\t\tif calls != expectedCalls {\n\t\t\t\t\tt.Fatalf(\"attempts=%d want=%d\", calls, expectedCalls)\n\t\t\t\t}\n\t\t\t\tif metadata == nil {\n\t\t\t\t\tt.Fatal(\"missing read-view metadata\")\n\t\t\t\t}\n\t\t\t\tstable := mode == \"stable\" || mode == \"once\"\n\t\t\t\tif stable {\n\t\t\t\t\tif !approved || !fresh || gate == \"closeout\" && !terminal || metadata.Freshness != ReadViewFreshnessCurrent {\n\t\t\t\t\t\tt.Fatalf(\"stable result lost: approved=%t fresh=%t terminal=%t metadata=%+v\", approved, fresh, terminal, metadata)\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\tif metadata.Freshness != ReadViewFreshnessUnknown