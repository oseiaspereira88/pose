{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_dispatch.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Delegated review dispatch (spec pose-delegated-review-dispatch, roadmap\n     4\t// delegated-review).\n     5\t//\n     6\t// A run hands the brief of a sealed bundle to a configured reviewer command —\n     7\t// another vendor's agent, typically — on a disposable worktree at the sealed\n     8\t// commit, and records what happened. It never records an attestation: turning\n     9\t// a run's conclusion into one is the engine's verified step (spec\n    10\t// pose-delegated-review-capability). A run that changed files, exceeded its\n    11\t// time or budget, or failed is recorded as failed, never as a review.\n    12\t\n    13\timport (\n    14\t\t\"bytes\"\n    15\t\t\"context\"\n    16\t\t\"crypto/sha256\"\n    17\t\t\"encoding/hex\"\n    18\t\t\"encoding/json\"\n    19\t\t\"errors\"\n    20\t\t\"fmt\"\n    21\t\t\"io\"\n    22\t\t\"os\"\n    23\t\t\"os/exec\"\n    24\t\t\"path/filepath\"\n    25\t\t\"reflect\"\n    26\t\t\"runtime\"\n    27\t\t\"sort\"\n    28\t\t\"strings\"\n    29\t\t\"sync/atomic\"\n    30\t\t\"time\"\n    31\t\t\"unicode/utf8\"\n    32\t)\n    33\t\n    34\t// beforeRunResultPublished is a test seam called with a run just before its\n    35\t// attempt result is published (spec pose-delegation-result-before-marker).\n    36\tvar beforeRunResultPublished = func(ReviewRun) {}\n    37\t\n    38\t// AdapterPipeGrace is how long a finished or killed adapter's children may\n    39\t// hold its pipes before they are released. Tests that exercise a lingering\n    40\t// child shorten it (spec pose-cli-test-wall-time R1).\n    41\tvar AdapterPipeGrace = 5 * time.Second\n    42\t\n    43\t// ReviewersPolicySchemaVersion versions .pose/policy/reviewers.json.\n    44\tconst ReviewersPolicySchemaVersion = 1\n    45\t\n    46\tconst reviewRunsDir = \".pose/review-runs\"\n    47\t\n    48\t// ReviewerAdapter is one configured reviewer command.\n    49\ttype ReviewerAdapter struct {\n    50\t\tContainment *ReviewerContainment `json:\"containment,omitempty\"`\n    51\t\t// Command is the argv; \"{output}\" is replaced by a file the reviewer may\n    52\t\t// write its final message to. The brief arrives on stdin and the working\n    53\t\t// directory is the disposable worktree.\n    54\t\tExecutor         string           `json:\"executor,omitempty\"`\n    55\t\tCommand          []string         `json:\"command\"`\n    56\t\tVendor           string           `json:\"vendor\"`\n    57\t\tModel            string           `json:\"model\"`\n    58\t\tTimeout          string           `json:\"timeout,omitempty\"`\n    59\t\tMaxRunsPerBundle int              `json:\"max_runs_per_bundle,omitempty\"`\n    60\t\tLimit            *ReviewerLimit   `json:\"limit,omitempty\"`\n    61\t\tSession          *ReviewerSession `json:\"session,omitempty\"`\n    62\t\tResume           *ReviewerResume  `json:\"resume,omitempty\"`\n    63\t\t// Events and Effort come from a delegation.json agent (schema 2); a\n    64\t\t// schema 1 adapter has neither, so its projection is unchanged.\n    65\t\tEvents string          `json:\"events,omitempty\"`\n    66\t\tEffort *ReviewerEffort `json:\"effort,omitempty\"`\n    67\t}\n    68\t\n    69\t// ReviewersPolicy is .pose/policy/reviewers.json.\n    70\ttype ReviewersPolicy struct {\n    71\t\tProvenance    *ReviewRunProvenancePolicy `json:\"provenance,omitempty\"`\n    72\t\tSchemaVersion int                        `json:\"schema_version\"`\n    73\t\tAdapters      map[string]ReviewerAdapter `json:\"adapters\"`\n    74\t}\n    75\t\n    76\t// ExampleReviewersPolicy is what POSE suggests and never enables by itself.\n    77\tfunc ExampleReviewersPolicy() ReviewersPolicy {\n    78\t\treturn ReviewersPolicy{SchemaVersion: ReviewersPolicySchemaVersion, Adapters: map[string]ReviewerAdapter{\n    79\t\t\t\"codex\": {Command: []string{\"codex\", \"exec\", \"-m\", \"gpt-6.1-sol\", \"-c\", `model_reasoning_effort=\"medium\"`, \"-s\", \"read-only\", \"--skip-git-repo-check\", \"-o\", \"{output}\", \"-\"},\n    80\t\t\t\tVendor: \"openai\", Model: \"gpt-6.1-sol\", Timeout: \"60m\", MaxRunsPerBundle: 3},\n    81\t\t\t\"claude\": {Command: []string{\"claude\", \"-p\", \"--model\", \"claude-opus-5-5\", \"--permission-mode\", \"plan\"},\n    82\t\t\t\tVendor: \"anthropic\", Model: \"claude-opus-5-5\", Timeout: \"60m\", MaxRunsPerBundle: 3},\n    83\t\t}}\n    84\t}\n    85\t\n    86\t// LoadReviewersPolicy reads the adapters of the review purpose; an absent\n    87\t// policy means none.\n    88\tfunc (s Store) LoadReviewersPolicy() (ReviewersPolicy, bool, error) {\n    89\t\treturn s.LoadReviewersPolicyFor(\"review\")\n    90\t}\n    91\t\n    92\t// LoadReviewersPolicyFor reads the adapters for the purpose that runs a brief\n    93\t// of kind: delegation.json (schema 2) projected for that purpose, or\n    94\t// reviewers.json (schema 1) through the same conversion.\n    95\tfunc (s Store) LoadReviewersPolicyFor(kind string) (ReviewersPolicy, bool, error) {\n    96\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n    97\t\tif err != nil || !found {\n    98\t\t\treturn ReviewersPolicy{}, false, err\n    99\t\t}\n   100\t\treturn policy.reviewersView(DelegationPurposeForKind(kind)), true, nil\n   101\t}\n   102\t\n   103\t// activeDelegationPolicyPath is the policy file the engine reads now.\n   104\tfunc (s Store) activeDelegationPolicyPath() string {\n   105\t\tif _, err := os.Lstat(filepath.Join(s.Root, filepath.FromSlash(delegationPolicyPath))); err == nil {\n   106\t\t\treturn delegationPolicyPath\n   107\t\t}\n   108\t\treturn reviewersPolicyPath\n   109\t}\n   110\t\n   111\tfunc parseReviewersPolicy(raw []byte) (ReviewersPolicy, error) {\n   112\t\tvar policy ReviewersPolicy\n   113\t\tif err := json.Unmarshal(raw, &policy); err != nil {\n   114\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: invalid .pose/policy/reviewers.json: %w\", err)\n   115\t\t}\n   116\t\tif policy.SchemaVersion != ReviewersPolicySchemaVersion {\n   117\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: .pose/policy/reviewers.json schema_version %d is not supported\", policy.SchemaVersion)\n   118\t\t}\n   119\t\tif err := validateExplicitReviewBudget(raw); err != nil {\n   120\t\t\treturn ReviewersPolicy{}, err\n   121\t\t}\n   122\t\tif err := validateRunProvenancePolicy(policy); err != nil {\n   123\t\t\treturn ReviewersPolicy{}, err\n   124\t\t}\n   125\t\tfor name, adapter := range policy.Adapters {\n   126\t\t\tif adapter.Events != \"\" || adapter.Effort != nil {\n   127\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s: events and effort are delegation.json fields\", name)\n   128\t\t\t}\n   129\t\t\tif _, err := ResolveReviewerContainment(adapter); err != nil {\n   130\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"adapter %s: %w\", name, err)\n   131\t\t\t}\n   132\t\t\tif err := validateContinuityAdapter(adapter); err != nil {\n   133\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s: %w\", name, err)\n   134\t\t\t}\n   135\t\t\tif len(adapter.Command) == 0 || adapter.Vendor == \"\" || adapter.Model == \"\" {\n   136\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s needs command, vendor and model\", name)\n   137\t\t\t}\n   138\t\t\tif adapter.Timeout != \"\" {\n   139\t\t\t\tif _, err := time.ParseDuration(adapter.Timeout); err != nil {\n   140\t\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s timeout: %w\", name, err)\n   141\t\t\t\t}\n   142\t\t\t}\n   143\t\t}\n   144\t\treturn policy, nil\n   145\t}\n   146\t\n   147\t// ReviewRun is one recorded dispatch.\n   148\ttype ReviewRun struct {\n   149\t\tSafety              *ReviewExecutionSafety `json:\"safety,omitempty\"`\n   150\t\tProvenance          *ReviewRunProvenance   `json:\"provenance,omitempty\"`\n   151\t\tsessionForRedaction string\n   152\t\teventsBytes         []byte\n   153\t\tResumes             string `json:\"resumes,omitempty\"`\n   154\t\t// ResumesSession marks a task that continued a session POSE never\n   155\t\t// recorded, named by its caller (spec pose-delegation-parity-gate SA-07).\n   156\t\tResumesSession bool `json:\"resumes_session,omitempty\"`\n   157\t\t// HandsOffFrom names the run this one continues with another agent, and\n   158\t\t// HandoffDigest the section its brief added (spec\n   159\t\t// pose-delegation-handoff R4, R5).\n   160\t\tHandsOffFrom  string `json:\"hands_off_from,omitempty\"`\n   161\t\tHandoffDigest string `json:\"handoff_digest,omitempty\"`\n   162\t\t// HandoffRenderer is the version of the renderer that listed the\n   163\t\t// predecessor's commands in the section; absent on runs recorded before it.\n   164\t\tHandoffRenderer  int                 `json:\"handoff_renderer,omitempty\"`\n   165\t\tInterruption     *ReviewInterruption `json:\"interruption,omitempty\"`\n   166\t\tSessionDigest    string              `json:\"session_digest,omitempty\"`\n   167\t\tTreeDigest       string              `json:\"tree_digest,omitempty\"`\n   168\t\tBriefNotes       string              `json:\"brief_notes,omitempty\"`\n   169\t\tPartialDigest    string              `json:\"partial_digest,omitempty\"`\n   170\t\tLimitOf          string              `json:\"limit_of,omitempty\"`\n   171\t\tLedgerVersion    int                 `json:\"ledger_version,omitempty\"`\n   172\t\tAttemptID        string              `json:\"attempt_id,omitempty\"`\n   173\t\tReason           string              `json:\"reason,omitempty\"`\n   174\t\tSchemaVersion    int                 `json:\"schema_version\"`\n   175\t\tRunID            string              `json:\"run_id\"`\n   176\t\tScope            string              `json:\"scope\"`\n   177\t\tBundleID         string              `json:\"bundle_id\"`\n   178\t\tBundleDigest     string              `json:\"bundle_digest\"`\n   179\t\tSealedCommit     string              `json:\"sealed_commit\"`\n   180\t\tKind             string              `json:\"kind\"`\n   181\t\tBriefDigest      string              `json:\"brief_digest\"`\n   182\t\tAdapter          string              `json:\"adapter\"`\n   183\t\tVendor           string              `json:\"vendor\"`\n   184\t\tModel            string              `json:\"model\"`\n   185\t\tStartedAt        string              `json:\"started_at\"`\n   186\t\tEndedAt          string              `json:\"ended_at\"`\n   187\t\tExitCode         int                 `json:\"exit_code\"`\n   188\t\tStatus           string              `json:\"status\"`\n   189\t\tFailure          string              `json:\"failure,omitempty\"`\n   190\t\tTranscriptDigest string              `json:\"transcript_digest\"`\n   191\t\tTranscriptPath   string              `json:\"transcript_path\"`\n   192\t\tOutput           string              `json:\"output\"`\n   193\t\tPolicyDigest     string              `json:\"policy_digest,omitempty\"`\n   194\t\tSupersedes       string              `json:\"supersedes,omitempty\"`\n   195\t\t// Label, Purpose and Lead are given by pose delegate; EnvRemoved names the\n   196\t\t// parent session variables the child did not receive (never their values);\n   197\t\t// Events and EventsDigest bind the normalized event stream kept beside\n   198\t\t// the transcript (spec pose-delegation-surface R8, R9, R11).\n   199\t\tLabel        string   `json:\"label,omitempty\"`\n   200\t\tPurpose      string   `json:\"purpose,omitempty\"`\n   201\t\tLead         string   `json:\"lead,omitempty\"`\n   202\t\tEnvRemoved   []string `json:\"env_removed,omitempty\"`\n   203\t\tEvents       string   `json:\"events,omitempty\"`\n   204\t\tEventsDigest string   `json:\"events_digest,omitempty\"`\n   205\t\tSupersededBy string   `json:\"superseded_by,omitempty\"`\n   206\t\t// Routing is how the run's agent was chosen and IndependenceAchieved what\n   207\t\t// it achieved against the implementation (spec pose-delegation-routing R8).\n   208\t\tRouting              *DelegationRoutingRecord `json:\"routing,omitempty\"`\n   209\t\tIndependenceAchieved string                   `json:\"independence_achieved,omitempty\"`\n   210\t\t// A task run (spec pose-delegation-task) records the access it ran with,\n   211\t\t// its directory and flags, the argv it ran, and the digests of the prompt\n   212\t\t// and the error stream kept beside its record; Recorded is --record.\n   213\t\tAccess       string   `json:\"access,omitempty\"`\n   214\t\tDir          string   `json:\"dir,omitempty\"`\n   215\t\tAddDirs      []string `json:\"add_dirs,omitempty\"`\n   216\t\tNoNetwork    bool     `json:\"no_network,omitempty\"`\n   217\t\tRecorded     bool     `json:\"recorded,omitempty\"`\n   218\t\tArgv         []string `json:\"argv,omitempty\"`\n   219\t\tPromptDigest string   `json:\"prompt_digest,omitempty\"`\n   220\t\tEffort       string   `json:\"effort,omitempty\"`\n   221\t\tStderrDigest string   `json:\"stderr_digest,omitempty\"`\n   222\t\t// Round is the round of the scope the run reviewed, DraftProblems what\n   223\t\t// keeps its draft from counting for that round, and Thread how its session\n   224\t\t// relates to the previous round's (spec\n   225\t\t// pose-delegated-review-round-protocol R1, R4, R6).\n   226\t\tRound         int           `json:\"round,omitempty\"`\n   227\t\tDraftProblems []string      `json:\"draft_problems,omitempty\"`\n   228\t\tThread        *ReviewThread `json:\"thread,omitempty\"`\n   229\t\tPath          string        `json:\"-\"`\n   230\t\t// eventsDir is where a task run's files are; a review run's are in\n   231\t\t// reviewRunsDir.\n   232\t\teventsDir string\n   233\t}\n   234\t\n   235\t// Review run states.\n   236\tconst (\n   237\t\tReviewRunCompleted   = \"completed\"\n   238\t\tReviewRunFailed      = \"failed\"\n   239\t\tReviewRunInterrupted = \"interrupted\"\n   240\t\tReviewRunStale       = \"stale\"\n   241\t)\n   242\t\n   243\t// ListReviewRuns returns the recorded runs for bundleID (\"\" for all).\n   244\tfunc (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n   245\t\truns, _, err := s.ReadReviewRuns(bundleID)\n   246\t\treturn runs, err\n   247\t}\n   248\t\n   249\tfunc (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n   250\t\t// Within a read-view operation the ledger is read and checked once per\n   251\t\t// root; every request of the operation is answered from that read,\n   252\t\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n   253\t\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n   254\t\t\truns, lost, err := s.readAllReviewRuns()\n   255\t\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n   256\t\t})\n   257\t\tif err != nil {\n   258\t\t\treturn nil, nil, err\n   259\t\t}\n   260\t\tout := copyReviewRuns(all.runs)\n   261\t\tif bundleID != \"\" {\n   262\t\t\tfiltered := []ReviewRun{}\n   263\t\t\tfor _, run := range out {\n   264\t\t\t\tif run.BundleID == bundleID {\n   265\t\t\t\t\tfiltered = append(filtered, run)\n   266\t\t\t\t}\n   267\t\t\t}\n   268\t\t\tout = filtered\n   269\t\t}\n   270\t\treturn out, deepCopyValue(all.lost), nil\n   271\t}\n   272\t\n   273\t// readAllReviewRuns reads, checks and orders every review run of the store.\n   274\tfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n   275\t\tfiles := s.fsys()\n   276\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n   277\t\t// The storage is read where the writer writes it: a link in its place is another place.\n   278\t\tif info, lerr := files.Lstat(dir); lerr == nil {\n   279\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n   280\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n   281\t\t\t}\n   282\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   283\t\t\treturn nil, nil, lerr\n   284\t\t}\n   285\t\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n   286\t\tif errors.Is(err, os.ErrNotExist) {\n   287\t\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n   288\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n   289\t\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   290\t\t\t\treturn nil, nil, lerr\n   291\t\t\t}\n   292\t\t\treturn []ReviewRun{}, nil, nil\n   293\t\t}\n   294\t\tif err != nil {\n   295\t\t\treturn nil, nil, err\n   296\t\t}\n   297\t\tout := []ReviewRun{}\n   298\t\tvar lost []string\n   299\t\treadBudget := int64(32 << 20)\n   300\t\tfor _, e := range entries {\n   301\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   302\t\t\t\tcontinue\n   303\t\t\t}\n   304\t\t\tfull := filepath.Join(dir, e.Name())\n   305\t\t\tinfo, infoErr := files.Lstat(full)\n   306\t\t\tif infoErr != nil || !info.Mode().IsRegular() {\n   307\t\t\t\tlost = append(lost, e.Name()+\" (not a regular file)\")\n   308\t\t\t\tcontinue\n   309\t\t\t}\n   310\t\t\tif info.Size() < 0 || info.Size() > reviewLedgerMaxBytes {\n   311\t\t\t\tlost = append(lost, e.Name()+\" (record exceeds bound or is unreadable)\")\n   312\t\t\t\tcontinue\n   313\t\t\t}\n   314\t\t\traw, err := readLedgerRawBudgetIn(files, full, &readBudget)\n   315\t\t\tif err != nil {\n   316\t\t\t\tlost = append(lost, e.Name()+\" (\"+err.Error()+\")\")\n   317\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   318\t\t\t\t\tbreak\n   319\t\t\t\t}\n   320\t\t\t\tcontinue\n   321\t\t\t}\n   322\t\t\tvar run ReviewRun\n   323\t\t\tif json.Unmarshal(raw, &run) != nil || run.RunID == \"\" {\n   324\t\t\t\tlost = append(lost, e.Name()+\" (not a review run)\")\n   325\t\t\t\tcontinue\n   326\t\t\t}\n   327\t\t\tif verr := validateReviewRunRecord(e.Name(), run); verr != nil {\n   328\t\t\t\tlost = append(lost, e.Name()+\" (\"+verr.Error()+\")\")\n   329\t\t\t\tcontinue\n   330\t\t\t}\n   331\t\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, e.Name()))\n   332\t\t\tout = append(out, run)\n   333\t\t}\n   334\t\tsort.Slice(out, func(i, j int) bool {\n   335\t\t\ta, _ := time.Parse(time.RFC3339Nano, out[i].StartedAt)\n   336\t\t\tb, _ := time.Parse(time.RFC3339Nano, out[j].StartedAt)\n   337\t\t\tif !a.Equal(b) {\n   338\t\t\t\treturn a.Before(b)\n   339\t\t\t}\n   340\t\t\treturn out[i].RunID < out[j].RunID\n   341\t\t})\n   342\t\tsuperseded := map[string]string{}\n   343\t\tfor _, run := range out {\n   344\t\t\tif run.Supersedes != \"\" {\n   345\t\t\t\tsuperseded[run.Supersedes] = run.RunID\n   346\t\t\t}\n   347\t\t}\n   348\t\tfor i := range out {\n   349\t\t\tout[i].SupersededBy = superseded[out[i].RunID]\n   350\t\t}\n   351\t\tchecked := map[string][]DelegatedReviewAttempt{}\n   352\t\tfor _, run := range out {\n   353\t\t\tif run.LedgerVersion == 1 {\n   354\t\t\t\tif _, err := files.Lstat(filepath.Join(s.Root, reviewRunLedgerDir, run.RunID+\".json\")); err != nil {\n   355\t\t\t\t\tlost = append(lost, \"missing run witness \"+run.RunID)\n   356\t\t\t\t}\n   357\t\t\t}\n   358\t\t\tif run.AttemptID != \"\" {\n   359\t\t\t\tattempts, ok := checked[run.BundleID]\n   360\t\t\t\tif !ok {\n   361\t\t\t\t\tvar aerr error\n   362\t\t\t\t\tattempts, aerr = s.readDelegatedReviewAttempts(run.BundleID, &readBudget)\n   363\t\t\t\t\tif aerr != nil {\n   364\t\t\t\t\t\tlost = append(lost, aerr.Error())\n   365\t\t\t\t\t}\n   366\t\t\t\t\tchecked[run.BundleID] = attempts\n   367\t\t\t\t}\n   368\t\t\t\t// The reservation names the attempt's first agent; a continuation's\n   369\t\t\t\t// agent is checked against its own predecessor by the continuation\n   370\t\t\t\t// chain (a resume keeps it, a handoff changes it).\n   371\t\t\t\tfound := false\n   372\t\t\t\tfor _, a := range attempts {\n   373\t\t\t\t\tif a.AttemptID == run.AttemptID && a.BundleDigest == run.BundleDigest && a.Scope == run.Scope && (a.Adapter == run.Adapter || run.continues() != \"\") && a.Reason == run.Reason {\n   374\t\t\t\t\t\tfound = true\n   375\t\t\t\t\t\tbreak\n   376\t\t\t\t\t}\n   377\t\t\t\t}\n   378\t\t\t\tif !found {\n   379\t\t\t\t\tlost = append(lost, \"missing or conflicting attempt reservation \"+run.AttemptID)\n   380\t\t\t\t}\n   381\t\t\t}\n   382\t\t}\n   383\t\tfindings, ledgerErr := s.reviewRunLedgerFindings(\"\", &readBudget)\n   384\t\tif ledgerErr != nil {\n   385\t\t\tlost = append(lost, ledgerErr.Error())\n   386\t\t}\n   387\t\tlost = append(lost, findings...)\n   388\t\tlost = append(lost, s.reviewContinuationFindings(out)...)\n   389\t\treturn out, uniqueSorted(lost), nil\n   390\t}\n   391\t\n   392\t// DispatchPlan is what a dispatch will do.\n   393\ttype DispatchPlan struct {\n   394\t\tprovenance          *ReviewRunProvenance\n   395\t\tPendingContinuation *PendingReviewContinuation\n   396\t\tprocessTimeout      time.Duration\n   397\t\tpredecessor         *ReviewRun\n   398\t\t// handoff makes the continuation another agent's, with handoffSection\n   399\t\t// appended to the brief (spec pose-delegation-handoff).\n   400\t\thandoff        bool\n   401\t\thandoffSection string\n   402\t\tsession        string\n   403\t\t// round is the round of the scope the run reviews, and thread how a\n   404\t\t// round after the first relates to the previous round's session.\n   405\t\tround  int\n   406\t\tthread *ReviewThread\n   407\t\t// extraChannels are outputs the interruption classifier reads beside the\n   408\t\t// transcript and the output, each on its own: a task's stderr.\n   409\t\textraChannels  []string\n   410\t\tnotes          string\n   411\t\tExisting       *ReviewRun\n   412\t\tLimitOf        string\n   413\t\tReason         string\n   414\t\tPolicyDigest   string\n   415\t\tOriginWorktree string\n   416\t\tAdapter        string\n   417\t\tConfig         ReviewerAdapter\n   418\t\tBrief          ReviewBrief\n   419\t\tBundle         ReviewBundle\n   420\t\tSealedCommit   string\n   421\t\tPriorRuns      int\n   422\t\t// Effort is the requested effort level; \"\" means the agent's default.\n   423\t\tEffort string\n   424\t\t// Label, Purpose and Lead are recorded on the run (pose delegate).\n   425\t\tLabel   string\n   426\t\tPurpose string\n   427\t\tLead    string\n   428\t\t// Routing is set by pose delegate; without it the run is compared with\n   429\t\t// the implementation the plan read (spec pose-delegation-routing R8).\n   430\t\tRouting        *DelegationRoutingRecord\n   431\t\timplementation *ReviewBundleImplementation\n   432\t\t// Warnings are printed before the run starts. SameVendorWarning is set\n   433\t\t// when the plan's agent shares the implementation's vendor; a caller that\n   434\t\t// named the agent prints it, routing does not (R9).\n   435\t\tWarnings          []string\n   436\t\tSameVendorWarning string\n   437\t\t// OnStart is called once the attempt is reserved and its marker written,\n   438\t\t// so a detached run can hand its reference back (spec\n   439\t\t// pose-delegated-review-completion-signal R1).\n   440\t\tOnStart func(attempt string) error\n   441\t}\n   442\t\n   443\t// Implementation is the identity the plan compares its agent with.\n   444\tfunc (p DispatchPlan) Implementation() ReviewBundleImplementation {\n   445\t\tswitch {\n   446\t\tcase p.Routing != nil:\n   447\t\t\treturn p.Routing.Implementation\n   448\t\tcase p.implementation != nil:\n   449\t\t\treturn *p.implementation\n   450\t\t}\n   451\t\treturn ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n   452\t}\n   453\t\n   454\t// replanContinuation plans a continuation again at execution, as a resume or\n   455\t// as a handoff to the same agent.\n   456\tfunc (s Store) replanContinuation(plan DispatchPlan) (DispatchPlan, error) {\n   457\t\tvar fresh DispatchPlan\n   458\t\tvar err error\n   459\t\tif plan.handoff {\n   460\t\t\tfresh, err = s.PlanReviewHandoff(plan.predecessor.RunID, plan.Adapter)\n   461\t\t} else {\n   462\t\t\tfresh, err = s.PlanReviewResume(plan.predecessor.RunID)\n   463\t\t}\n   464\t\tif err != nil {\n   465\t\t\treturn fresh, err\n   466\t\t}\n   467\t\t// What the caller set on the plan is kept: the hand-back of a detached run\n   468\t\t// and the routing that chose its agent (spec pose-delegation-mcp R4).\n   469\t\tfresh.OnStart, fresh.Purpose = plan.OnStart, plan.Purpose\n   470\t\tif fresh.Routing == nil {\n   471\t\t\tfresh.Routing = plan.Routing\n   472\t\t}\n   473\t\treturn fresh, nil\n   474\t}\n   475\t\n   476\t// PlanImplementationWithLead reads the plan's implementation again with the\n   477\t// --lead the caller declared, for a bundle that records none (R4), and records\n   478\t// the agent as named.\n   479\tfunc (s Store) PlanImplementationWithLead(plan *DispatchPlan, lead string) {\n   480\t\tplan.Routing, plan.Warnings, plan.SameVendorWarning = nil, nil, \"\"\n   481\t\ts.planImplementation(plan, lead)\n   482\t}\n   483\t\n   484\t// routingAgainstAnotherBundle refuses a routing decision made against an\n   485\t// implementation the plan's bundle does not record: the run would record an\n   486\t// identity and an independence it did not have (spec pose-delegation-routing\n   487\t// R8).\n   488\tfunc routingAgainstAnotherBundle(plan DispatchPlan) string {\n   489\t\tif plan.Routing == nil || plan.Routing.ImplementationFrom != ImplementationFromBundle {\n   490\t\t\treturn \"\"\n   491\t\t}\n   492\t\tsealed := plan.Bundle.Payload.Implementation\n   493\t\tif sealed == nil || !sameImplementation(*sealed, plan.Routing.Implementation) {\n   494\t\t\treturn \"the run was routed against another implementation than bundle \" + plan.Bundle.BundleID + \" records; route it again\"\n   495\t\t}\n   496\t\treturn \"\"\n   497\t}\n   498\t\n   499\t// planImplementation reads the identity a run of bundle is compared with,\n   500\t// records the agent as named unless routing chose it (R8, R9), and warns when\n   501\t// the policy still declares an identity the bundle overrides (R4).\n   502\tfunc (s Store) planImplementation(plan *DispatchPlan, lead string) {\n   503\t\timpl := ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n   504\t\tfrom := ImplementationFromNone\n   505\t\tif policy, _, found, err := s.LoadDelegationPolicy(); err == nil && found {\n   506\t\t\tif read, readFrom, err := s.RoutingImplementation(plan.Bundle, policy, lead); err == nil {\n   507\t\t\t\timpl, from = read, readFrom\n   508\t\t\t}\n   509\t\t\tif plan.Bundle.Payload.Implementation != nil && policy.Provenance != nil && policy.Provenance.Implementation != (ModelIdentity{}) {\n   510\t\t\t\tplan.Warnings = append(plan.Warnings, \"provenance.implementation in the delegation policy is ignored: bundle \"+plan.Bundle.BundleID+\" records the implementation it was sealed by; remove the policy entry\")\n   511\t\t\t}\n   512\t\t}\n   513\t\tplan.implementation = &impl\n   514\t\tif plan.Routing == nil {\n   515\t\t\trecord := ExplicitDelegationRoute(plan.Adapter, impl, from)\n   516\t\t\tplan.Routing = &record\n   517\t\t}\n   518\t\tif knownIdentityPart(impl.Vendor) && normalizeIdentityPart(plan.Config.Vendor) == impl.Vendor {\n   519\t\t\tplan.SameVendorWarning = \"agent \" + plan.Adapter + \" shares the implementation's vendor (\" + impl.Vendor + \"); the run cannot achieve vendor independence\"\n   520\t\t}\n   521\t}\n   522\t\n   523\t// PlanReviewDispatch resolves the bundle, brief and adapter without running.\n   524\tfunc (s Store) PlanReviewDispatch(target, kind, notes, adapter string, reason ...string) (DispatchPlan, error) {\n   525\t\tif err := validateReviewNotes(notes); err != nil {\n   526\t\t\treturn DispatchPlan{}, err\n   527\t\t}\n   528\t\tif len(reason) > 1 {\n   529\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: one rerun reason is accepted\")\n   530\t\t}\n   531\t\twhy := \"\"\n   532\t\tif len(reason) == 1 {\n   533\t\t\twhy = strings.TrimSpace(reason[0])\n   534\t\t}\n   535\t\tbrief, err := s.RenderReviewBrief(target, kind, notes)\n   536\t\tif err != nil {\n   537\t\t\treturn DispatchPlan{}, err\n   538\t\t}\n   539\t\tbundle, err := s.LoadReviewBundle(brief.BundleID)\n   540\t\tif err != nil {\n   541\t\t\treturn DispatchPlan{}, err\n   542\t\t}\n   543\t\tpolicy, found, err := s.LoadReviewersPolicyFor(brief.Kind)\n   544\t\tif err != nil {\n   545\t\t\treturn DispatchPlan{}, err\n   546\t\t}\n   547\t\tif !found || len(policy.Adapters) == 0 {\n   548\t\t\treturn DispatchPlan{Brief: brief, Bundle: bundle}, ErrNoReviewerAdapter\n   549\t\t}\n   550\t\tconfig, ok := policy.Adapters[adapter]\n   551\t\tif !ok {\n   552\t\t\tnames := make([]string, 0, len(policy.Adapters))\n   553\t\t\tfor name := range policy.Adapters {\n   554\t\t\t\tnames = append(names, name)\n   555\t\t\t}\n   556\t\t\tsort.Strings(names)\n   557\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: no reviewer adapter %q; configured: %s\", adapter, strings.Join(names, \", \"))\n   558\t\t}\n   559\t\tcommit := bundle.Payload.Subject.Head\n   560\t\tif commit == \"\" || RawHistoryGit(s.Root, \"cat-file\", \"-e\", commit+\"^{commit}\").Run() != nil {\n   561\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: the bundle's sealed commit %q is not in this repository\", commit)\n   562\t\t}\n   563\t\torigin, err := dispatchWorktreeIdentity(s.Root)\n   564\t\tif err != nil {\n   565\t\t\treturn DispatchPlan{}, err\n   566\t\t}\n   567\t\tplan := DispatchPlan{notes: notes, Reason: why, PolicyDigest: directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")), OriginWorktree: origin, Adapter: adapter, Config: config, Brief: brief, Bundle: bundle, SealedCommit: commit, PriorRuns: 0}\n   568\t\truns, losses, err := s.ReadReviewRuns(bundle.BundleID)\n   569\t\tif err != nil {\n   570\t\t\treturn DispatchPlan{}, err\n   571\t\t}\n   572\t\tif len(losses) > 0 {\n   573\t\t\treturn DispatchPlan{}, fmt.Errorf(\"review history incomplete: %v\", losses)\n   574\t\t}\n   575\t\tcontinued := map[string]bool{}\n   576\t\tfor _, r := range runs {\n   577\t\t\tif r.continues() != \"\" {\n   578\t\t\t\tcontinued[r.continues()] = true\n   579\t\t\t}\n   580\t\t}\n   581\t\tfor _, prior := range runs {\n   582\t\t\tif prior.Status == ReviewRunInterrupted && prior.SupersededBy == \"\" && !continued[prior.RunID] && prior.Interruption != nil && prior.Interruption.Cause == \"usage-limit\" && prior.Adapter != adapter {\n   583\t\t\t\tplan.LimitOf, plan.Reason = prior.RunID, \"limit-of:\"+prior.RunID\n   584\t\t\t}\n   585\t\t}\n   586\t\t_, currentCount, err := s.reviewAttemptAdmission(plan)\n   587\t\tif err != nil {\n   588\t\t\treturn DispatchPlan{}, err\n   589\t\t}\n   590\t\tif _, _, err := reviewAdapterEnvironment(config, \"\", brief.Text, notes); err != nil {\n   591\t\t\treturn DispatchPlan{}, err\n   592\t\t}\n   593\t\tplan.PriorRuns = currentCount\n   594\t\tif brief.Kind == ReviewBriefKindReview {\n   595\t\t\tif err := s.planReviewThread(&plan); err != nil {\n   596\t\t\t\treturn DispatchPlan{}, err\n   597\t\t\t}\n   598\t\t}\n   599\t\ts.planImplementation(&plan, \"\")\n   600\t\tplan.provenance, err = s.prepareRunProvenance(plan, policy)\n   601\t\tif err != nil {\n   602\t\t\treturn DispatchPlan{}, err\n   603\t\t}\n   604\t\treturn plan, nil\n   605\t}\n   606\t\n   607\t// ErrNoReviewerAdapter means the project configured no reviewer.\n   608\tvar ErrNoReviewerAdapter = errors.New(\"pose: no agent is configured in .pose/policy/delegation.json\")\n   609\t\n   610\t// RunReviewDispatch executes plan and records the run, failed or completed.\n   611\tfunc (s Store) RunReviewDispatch(plan DispatchPlan, now func() time.Time) (ReviewRun, error) {\n   612\t\treturn s.RunReviewDispatchContext(context.Background(), plan, now)\n   613\t}\n   614\t\n   615\t// RunReviewDispatchContext also propagates caller cancellation to the covered\n   616\t// process set. Cleanup has its own bounded context and never respawns the adapter.\n   617\tfunc (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPlan, now func() time.Time) (result ReviewRun, resultErr error) {\n   618\t\tif err := parent.Err(); err != nil {\n   619\t\t\treturn ReviewRun{}, err\n   620\t\t}\n   621\t\tif why := routingAgainstAnotherBundle(plan); why != \"\" {\n   622\t\t\treturn ReviewRun{}, errors.New(\"pose: \" + why)\n   623\t\t}\n   624\t\t// pose delegate cancel stops the run through this context (R13).\n   625\t\tparent, cancelRun := context.WithCancel(parent)\n   626\t\tdefer cancelRun()\n   627\t\tvar cancelled *atomic.Bool\n   628\t\tif plan.PendingContinuation != nil {\n   629\t\t\treturn ReviewRun{}, plan.PendingContinuation\n   630\t\t}\n   631\t\tif plan.Existing != nil {\n   632\t\t\tif plan.predecessor == nil {\n   633\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation lacks predecessor\")\n   634\t\t\t}\n   635\t\t\tfresh, err := s.replanContinuation(plan)\n   636\t\t\tif err != nil {\n   637\t\t\t\treturn ReviewRun{}, err\n   638\t\t\t}\n   639\t\t\tif fresh.Existing == nil {\n   640\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation disappeared\")\n   641\t\t\t}\n   642\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   643\t\t}\n   644\t\tif _, _, err := reviewAdapterEnvironment(plan.Config, \"\", plan.Brief.Text, plan.notes); err != nil {\n   645\t\t\treturn ReviewRun{}, err\n   646\t\t}\n   647\t\trun := ReviewRun{Provenance: plan.provenance, BriefNotes: plan.notes, LimitOf: plan.LimitOf, SchemaVersion: 1, Scope: plan.Brief.Scope, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest,\n   648\t\t\tSealedCommit: plan.SealedCommit, Kind: plan.Brief.Kind, BriefDigest: plan.Brief.Digest, Adapter: plan.Adapter,\n   649\t\t\tVendor: plan.Config.Vendor, Model: plan.Config.Model, Reason: plan.Reason, PolicyDigest: plan.PolicyDigest, StartedAt: now().UTC().Format(time.RFC3339Nano), ExitCode: -1,\n   650\t\t\tLabel: plan.Label, Purpose: plan.Purpose, Lead: plan.Lead, Events: plan.Config.Events, Routing: plan.Routing, Round: plan.round, Thread: plan.thread}\n   651\t\timpl := plan.Implementation()\n   652\t\trun.IndependenceAchieved = AchievedIndependence(impl.Vendor, impl.Model, plan.Config.Vendor, plan.Config.Model)\n   653\t\tsafety, err := ResolveReviewerContainment(plan.Config)\n   654\t\tif err != nil {\n   655\t\t\treturn ReviewRun{}, err\n   656\t\t}\n   657\t\tif err := validateReviewNotes(plan.notes); err != nil {\n   658\t\t\treturn ReviewRun{}, err\n   659\t\t}\n   660\t\trun.Safety = safety\n   661\t\tvar cleanup func() error\n   662\t\tvar cleanupErr error\n   663\t\tvar terminationFailed bool\n   664\t\tcleaned := false\n   665\t\tdoCleanup := func() {\n   666\t\t\tif cleaned {\n   667\t\t\t\treturn\n   668\t\t\t}\n   669\t\t\tcleaned = true\n   670\t\t\toutcome := NewOperationResult(\"review.dispatch.cleanup\", run.Scope)\n   671\t\t\toutcome.StepsRun = append(outcome.StepsRun, OperationStep{ID: \"cleanup\", Result: \"done\"})\n   672\t\t\tif terminationFailed {\n   673\t\t\t\tcleanupErr = fmt.Errorf(\"process termination incomplete; runtime resources retained\")\n   674\t\t\t} else if cleanup != nil {\n   675\t\t\t\tcleanupErr = cleanup()\n   676\t\t\t}\n   677\t\t\tif cleanupErr != nil {\n   678\t\t\t\toutcome.StepsRun[0].Result = \"failed\"\n   679\t\t\t\toutcome.Fail(OutcomeFailed, \"cleanup\", \"cleanup-incomplete\", cleanupErr.Error())\n   680\t\t\t\toutcome.Unconfirmed = []OperationUncertain{{Step: \"cleanup\", Reason: \"owned resources may remain; no automatic respawn\"}}\n   681\t\t\t} else {\n   682\t\t\t\toutcome.Outcome = OutcomeCompleted\n   683\t\t\t}\n   684\t\t\trun.Safety.Operation = outcome\n   685\t\t}\n   686\t\tdefer func() {\n   687\t\t\tdoCleanup()\n   688\t\t\tif cleanupErr != nil {\n   689\t\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n   690\t\t\t}\n   691\t\t}()\n   692\t\ttranscript := []byte{}\n   693\t\tfinish := func(status, failure string) (ReviewRun, error) {\n   694\t\t\tdoCleanup()\n   695\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n   696\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n   697\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n   698\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n   699\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n   700\t\t\t}\n   701\t\t\trun.sessionForRedaction = \"\"\n   702\t\t\trun.Status, run.Failure = status, failure\n   703\t\t\tif status != ReviewRunInterrupted {\n   704\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n   705\t\t\t}\n   706\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n   707\t\t\treturn s.recordReviewRun(run, transcript)\n   708\t\t}\n   709\t\t// Recompute semantic freshness at execution time, not just preview time.\n   710\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n   711\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   712\t\t}\n   713\t\tvar attempt DelegatedReviewAttempt\n   714\t\tif plan.predecessor == nil {\n   715\t\t\tvar err error\n   716\t\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n   717\t\t\tif err != nil {\n   718\t\t\t\treturn ReviewRun{}, err\n   719\t\t\t}\n   720\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n   721\t\t} else {\n   722\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n   723\t\t\tfresh, err := s.replanContinuation(plan)\n   724\t\t\tif err != nil {\n   725\t\t\t\treturn ReviewRun{}, err\n   726\t\t\t}\n   727\t\t\tif fresh.PendingContinuation != nil {\n   728\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n   729\t\t\t}\n   730\t\t\tif fresh.Existing != nil {\n   731\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   732\t\t\t}\n   733\t\t\tplan = fresh\n   734\t\t\trun.Provenance = fresh.provenance\n   735\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n   736\t\t\tif fresh.handoff {\n   737\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n   738\t\t\t} else {\n   739\t\t\t\trun.Resumes = fresh.predecessor.RunID\n   740\t\t\t}\n   741\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n   742\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n   743\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n   744\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n   745\t\t\t\treturn ReviewRun{}, err\n   746\t\t\t}\n   747\t\t}\n   748\t\t// The attempt result is published once: before the active marker goes\n   749\t\t// when the run was marked, at return otherwise (spec\n   750\t\t// pose-delegation-result-before-marker R1–R2).\n   751\t\tresultPublished := false\n   752\t\treserved := plan.predecessor != nil\n   753\t\tpublishResult := func() {\n   754\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n   755\t\t\t\treturn\n   756\t\t\t}\n   757\t\t\tresultPublished = true\n   758\t\t\tbeforeRunResultPublished(result)\n   759\t\t\tvar err error\n   760\t\t\tif plan.predecessor == nil {\n   761\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   762\t\t\t} else {\n   763\t\t\t\terr = s.finishReviewContinuation(result)\n   764\t\t\t}\n   765\t\t\tif err != nil {\n   766\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n   767\t\t\t}\n   768\t\t}\n   769\t\tdefer publishResult()\n   770\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n   771\t\tif err != nil {\n   772\t\t\tif plan.predecessor == nil {\n   773\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n   774\t\t\t\t// receipt are recorded against it, as before the marker moved\n   775\t\t\t\t// ahead of the reservation (spec\n   776\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n   777\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n   778\t\t\t\t\treturn ReviewRun{}, perr\n   779\t\t\t\t}\n   780\t\t\t\treserved = true\n   781\t\t\t}\n   782\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   783\t\t}\n   784\t\tif plan.predecessor == nil {\n   785\t\t\tbeforeAttemptPublished(s, attempt)\n   786\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n   787\t\t\t\tstopActive()\n   788\t\t\t\treturn ReviewRun{}, err\n   789\t\t\t}\n   790\t\t\treserved = true\n   791\t\t}\n   792\t\t// The marker goes only once the record and the attempt result are\n   793\t\t// published: without them it is the one trace of the reserved attempt,\n   794\t\t// and a waiter that sees it gone must find the receipt.\n   795\t\tdefer func() {\n   796\t\t\tpublishResult()\n   797\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n   798\t\t}()\n   799\t\tcancelled = cancelFlag\n   800\t\t// A detached run that cannot hand its attempt back stops here: nobody\n   801\t\t// would know which attempt runs (R1).\n   802\t\tif plan.OnStart != nil {\n   803\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n   804\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n   805\t\t\t}\n   806\t\t}\n   807\t\ttmp, err := os.MkdirTemp(\"\", \"pose-review-run-*\")\n   808\t\tif err != nil {\n   809\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n   810\t\t}\n   811\t\tsafety.RuntimeID = filepath.Base(tmp)\n   812\t\towned, err := os.Lstat(tmp)\n   813\t\tif err != nil {\n   814\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n   815\t\t}\n   816\t\truntimeRoot, err := os.OpenRoot(tmp)\n   817\t\tif err != nil {\n   818\t\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n   819\t\t}\n   820\t\tdefer runtimeRoot.Close()\n   821\t\tvar worktreeOwned os.FileInfo\n   822\t\tvar gitMarker []byte\n   823\t\tvar ownership *reviewCleanupOwnership\n   824\t\tworktree := filepath.Join(tmp, \"worktree\")\n   825\t\tcleanup = func() error {\n   826\t\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n   827\t\t}\n   828\t\thooks := filepath.Join(tmp, \"empty-hooks\")\n   829\t\tif err := os.Mkdir(hooks, 0700); err != nil {\n   830\t\t\treturn finish(ReviewRunFailed, \"private hook directory setup failed\")\n   831\t\t}\n   832\t\tsetupCtx, stopSetup := context.WithTimeout(parent, 2*time.Minute)\n   833\t\tdefer stopSetup()\n   834\t\tsetup := reviewSetupCommand(setupCtx, gitCommand(\"-C\", s.Root, \"-c\", \"core.hooksPath=\"+hooks, \"worktree\", \"add\", \"--detach\", worktree, plan.SealedCommit))\n   835\t\tsetupOutput := &reviewBoundedCapture{limit: 64 << 10, cancel: stopSetup}\n   836\t\tsetup.Stdout, setup.Stderr = setupOutput, setupOutput\n   837\t\tsetupErr := setup.Run()\n   838\t\t_, setupOverflow := setupOutput.result()\n   839\t\tterminationErr := killProcessGroup(setup)\n   840\t\tif terminationErr != nil {\n   841\t\t\tterminationFailed = true\n   842\t\t}\n   843\t\tsetupCause := executionCause(setupCtx)\n   844\t\tif setupErr != nil || terminationErr != nil || setupOverflow {\n   845\t\t\tsafety.ExecutionCause = setupCause\n   846\t\t\tif setupOverflow {\n   847\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   848\t\t\t}\n   849\t\t\treturn finish(ReviewRunFailed, \"review worktree setup failed or termination incomplete\")\n   850\t\t}\n   851\t\n   852\t\tworktreeOwned, err = os.Lstat(worktree)\n   853\t\tif err != nil {\n   854\t\t\treturn finish(ReviewRunFailed, \"worktree identity unavailable\")\n   855\t\t}\n   856\t\tgitMarker, err = ReadReviewAdapterFile(filepath.Join(worktree, \".git\"), 4096)\n   857\t\tif err != nil {\n   858\t\t\treturn finish(ReviewRunFailed, \"worktree marker unavailable\")\n   859\t\t}\n   860\t\townership, err = s.captureReviewCleanupOwnership(runtimeRoot, worktree, gitMarker)\n   861\t\tif err != nil {\n   862\t\t\treturn finish(ReviewRunFailed, \"worktree registration ownership unavailable\")\n   863\t\t}\n   864\t\tdefer ownership.registry.Close()\n   865\t\n   866\t\tsubmodules := map[string]bool{}\n   867\t\tfor _, entry := range plan.Bundle.Payload.Subject.Entries {\n   868\t\t\tif entry.Class == \"submodule\" {\n   869\t\t\t\tsubmodules[reviewBundleEntryPath(entry)] = true\n   870\t\t\t}\n   871\t\t}\n   872\t\tcommittedWorktreeBytes := ownership.inventoryBytes - gitSnapshotMarginBytes\n   873\t\tgitlinks := reviewGitlinkSetup{\n   874\t\t\tctx: setupCtx, cancel: stopSetup, hooks: hooks,\n   875\t\t\tmetadata:          filepath.Join(tmp, reviewGitlinkMetadataDir),\n   876\t\t\tmaxCommittedBytes: gitSnapshotCeilingBytes - committedWorktreeBytes,\n   877\t\t}\n   878\t\tgitlinkErr := gitlinks.materialize(s.Root, worktree, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries)\n   879\t\townership.inventoryBytes = gitSnapshotBudget(committedWorktreeBytes + gitlinks.committedBytes)\n   880\t\townership.gitlinkMetadata = gitlinks.metadataOwned\n   881\t\townership.gitlinkMetadataBytes = gitSnapshotBudget(gitlinks.committedBytes)\n   882\t\tif gitlinkErr != nil {\n   883\t\t\tterminationFailed = gitlinks.terminationFailure\n   884\t\t\tsafety.ExecutionCause = executionCause(setupCtx)\n   885\t\t\tif gitlinks.captureOverflow {\n   886\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   887\t\t\t}\n   888\t\t\treturn finish(ReviewRunFailed, \"sealed gitlink setup failed: \"+gitlinkErr.Error())\n   889\t\t}\n   890\t\tstopSetup()\n   891\t\tcheckout := s\n   892\t\tcheckout.Root, checkout.indexPin = worktree, nil\n   893\t\tif prepared, err := checkout.PrepareReviewBundle(plan.Brief.Scope); err != nil {\n   894\t\t\treturn finish(ReviewRunFailed, \"sealed checkout inputs unavailable: \"+err.Error())\n   895\t\t} else if blockers := checkoutBlockers(prepared.Blockers); len(blockers) > 0 {\n   896\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout blocked: %v\", blockers))\n   897\t\t} else if differing := sealedInputsThatDiffer(plan.Bundle, prepared, worktree); len(differing) > 0 {\n   898\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout inputs differ: %v\", differing))\n   899\t\t}\n   900\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n   901\t\t\treturn finish(ReviewRunFailed, err.Error())\n   902\t\t}\n   903\t\tif err := verifyBundleMaterialization(worktree, plan.Bundle); err != nil {\n   904\t\t\treturn finish(ReviewRunFailed, err.Error())\n   905\t\t}\n   906\t\tif plan.Purpose == DelegationPurposeReview && plan.Config.Events == DelegationEventsClaudeStreamJSON {\n   907\t\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n   908\t\t\tif err != nil {\n   909\t\t\t\treturn finish(ReviewRunFailed, \"review staging policy unavailable\")\n   910\t\t\t}\n   911\t\t\tif found && policy.Agents[plan.Adapter].ReviewProfile != nil {\n   912\t\t\t\tif err := prepareClaudeReviewStaging(runtimeRoot, plan.Bundle.Payload.Plan.Components); err != nil {\n   913\t\t\t\t\treturn finish(ReviewRunFailed, \"review staging directories unavailable\")\n   914\t\t\t\t}\n   915\t\t\t}\n   916\t\t}\n   917\t\tdiskBefore, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n   918\t\tif err != nil {\n   919\t\t\treturn finish(ReviewRunFailed, err.Error())\n   920\t\t}\n   921\t\n   922\t\trawTree, err := json.Marshal(diskBefore)\n   923\t\tif err != nil {\n   924\t\t\treturn finish(ReviewRunFailed, err.Error())\n   925\t\t}\n   926\t\tif plan.predecessor != nil && (!plan.handoff || plan.predecessor.TreeDigest != \"\") && digestBytes(rawTree) != plan.predecessor.TreeDigest {\n   927\t\t\treturn finish(ReviewRunFailed, \"recreated worktree tree digest differs\")\n   928\t\t}\n   929\t\trun.TreeDigest = digestBytes(rawTree)\n   930\t\toutputFile := filepath.Join(tmp, \"output.txt\")\n   931\t\tcommand := plan.Config.Command\n   932\t\tif plan.predecessor != nil && !plan.handoff || plan.thread.continued() {\n   933\t\t\tcommand = plan.Config.Resume.Command\n   934\t\t}\n   935\t\targv := ReviewerArgv(command, outputFile, plan.session, plan.Effort, plan.Config.Effort)\n   936\t\ttimeout := time.Duration(safety.TimeoutMS) * time.Millisecond\n   937\t\texecPath := argv[0]\n   938\t\tif run.Provenance != nil {\n   939\t\t\tcopy := *run.Provenance\n   940\t\t\trun.Provenance = &copy\n   941\t\t\tselected, resolved, err := provenanceExecutableSelection(argv[0], worktree)\n   942\t\t\tif err != nil {\n   943\t\t\t\treturn finish(ReviewRunFailed, \"provenance executable could not be resolved\")\n   944\t\t\t}\n   945\t\t\tdigest, err := reviewExecutableDigest(resolved)\n   946\t\t\tif err != nil {\n   947\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n   948\t\t\t}\n   949\t\t\trun.Provenance.ExecutableDigest = digest\n   950\t\t\texecPath = selected\n   951\t\t\traw, _ := json.Marshal(argv)\n   952\t\t\trun.Provenance.ArgvDigest = digestBytes(raw)\n   953\t\t}\n   954\t\tif plan.processTimeout > 0 {\n   955\t\t\tstarted, err := time.Parse(time.RFC3339Nano, run.StartedAt)\n   956\t\t\tif err != nil {\n   957\t\t\t\treturn finish(ReviewRunFailed, \"invalid execution start\")\n   958\t\t\t}\n   959\t\t\tsetup := now().Sub(started)\n   960\t\t\tremaining := plan.processTimeout - setup\n   961\t\t\tif setup < 0 || remaining <= 0 {\n   962\t\t\t\treturn finish(ReviewRunFailed, \"accumulated wall-clock budget spent before adapter launch\")\n   963\t\t\t}\n   964\t\t\tif remaining < timeout {\n   965\t\t\t\ttimeout = remaining\n   966\t\t\t}\n   967\t\t}\n   968\t\tctx, cancel := context.WithTimeout(parent, timeout)\n   969\t\tdefer cancel()\n   970\t\tcmd := exec.CommandContext(ctx, execPath, argv[1:]...)\n   971\t\tcmd.Args[0] = argv[0]\n   972\t\t// The adapter runs under the review run shim, which ends what the run\n   973\t\t// leaves in its subtree (review_shim.go).\n   974\t\tuseShim := false\n   975\t\tvar shimRead, shimWrite *os.File\n   976\t\tif ReviewShimAvailable && runtime.GOOS == \"linux\" && cmd.Err == nil {\n   977\t\t\t// The adapter's path as resolved here, in the dispatcher's PATH.\n   978\t\t\tif self, err := os.Executable(); err == nil {\n   979\t\t\t\tif r, w, err := os.Pipe(); err == nil {\n   980\t\t\t\t\tuseShim, shimRead, shimWrite = true, r, w\n   981\t\t\t\t\tcmd = exec.CommandContext(ctx, self, append([]string{ReviewShimArg, cmd.Path}, argv...)...)\n   982\t\t\t\t\tcmd.ExtraFiles = []*os.File{w}\n   983\t\t\t\t}\n   984\t\t\t}\n   985\t\t}\n   986\t\tcmd.Dir = worktree\n   987\t\tcmd.Stdin = strings.NewReader(plan.Brief.Text)\n   988\t\tenv, secrets, err := reviewAdapterEnvironment(plan.Config, tmp, plan.Brief.Text, plan.notes)\n   989\t\tif err != nil {\n   990\t\t\trun.BriefNotes = \"\"\n   991\t\t\treturn finish(ReviewRunFailed, err.Error())\n   992\t\t}\n   993\t\tunset := []string{}\n   994\t\tif policy, _, found, perr := s.LoadDelegationPolicy(); perr == nil && found {\n   995\t\t\tunset = policy.EnvUnset\n   996\t\t}\n   997\t\tenv, run.EnvRemoved = withoutParentSession(env, unset)\n   998\t\t// The reviewer works in a sealed checkout: diagnostics it runs must not\n   999\t\t// publish derived records into it (SealedCheckoutEnv).\n  1000\t\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n  1001\t\tif useShim {\n  1002\t\t\tenv = append(env, ReviewShimReportEnv+\"=\"+fmt.Sprint(os.Getpid()))\n  1003\t\t}\n  1004\t\t// The reviewer checks its draft against the sealed bundle and the round\n  1005\t\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n  1006\t\t// context that cannot be built leaves the check unavailable, never the\n  1007\t\t// review.\n  1008\t\tif plan.Purpose == DelegationPurposeReview {\n  1009\t\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n  1010\t\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n  1011\t\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n  1012\t\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n  1013\t\t\t\t\t// engine that dispatched the run is the one that checks it.\n  1014\t\t\t\t\tif self, err := os.Executable(); err == nil {\n  1015\t\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n  1016\t\t\t\t\t}\n  1017\t\t\t\t}\n  1018\t\t\t}\n  1019\t\t}\n  1020\t\tcmd.Env = env\n  1021\t\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n  1022\t\tcmd.Stdout, cmd.Stderr = combined, combined\n  1023\t\t// pose delegate watch follows the normalized, redacted events as they come\n  1024\t\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n  1025\t\t// the record is published.\n  1026\t\tsessionPattern := \"\"\n  1027\t\tif plan.Config.Session != nil {\n  1028\t\t\tsessionPattern = plan.Config.Session.Pattern\n  1029\t\t}\n  1030\t\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n  1031\t\t\ttee := io.MultiWriter(combined, live)\n  1032\t\t\tcmd.Stdout, cmd.Stderr = tee, tee\n  1033\t\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n  1034\t\t\tdefer live.Close()\n  1035\t\t}\n  1036\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n  1037\t\t// only the parent left a child holding stdout, so the timeout never fired\n  1038\t\t// (found in review). The run gets its own process group, the whole group\n  1039\t\t// is killed on timeout and after the run, and pipes are released at most\n  1040\t\t// a few seconds after the kill.\n  1041\t\topaqueBaseline := reviewOpaqueProcessBaseline()\n  1042\t\t// Orphans of the run are reparented to this process, so one that left\n  1043\t\t// the group and cleared its environment is still found (review round 6, N2).\n  1044\t\tisolateProcessGroup(cmd)\n  1045\t\tcmd.WaitDelay = AdapterPipeGrace\n  1046\t\tvar shimReport []byte\n  1047\t\tshimReportDone := make(chan struct{})\n  1048\t\tif useShim {\n  1049\t\t\t// A timeout asks the shim to end the run's subtree first; the group\n  1050\t\t\t// kill after Wait remains the backstop (review round 8, N3).\n  1051\t\t\tcmd.Cancel = stopReviewShim(cmd)\n  1052\t\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n  1053\t\t\tgo func() {\n  1054\t\t\t\tdefer close(shimReportDone)\n  1055\t\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n  1056\t\t\t\t// Whatever exceeds the bound is drained, so the shim never blocks.\n  1057\t\t\t\t_, _ = io.Copy(io.Discard, shimRead)\n  1058\t\t\t}()\n  1059\t\t} else {\n  1060\t\t\tclose(shimReportDone)\n  1061\t\t}\n  1062\t\tvar runErr error\n  1063\t\tif run.Provenance == nil {\n  1064\t\t\trunErr = cmd.Run()\n  1065\t\t} else {\n  1066\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1067\t\t\trunErr = err\n  1068\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1069\t\t\tif started {\n  1070\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1071\t\t\t}\n  1072\t\t}\n  1073\t\tif useShim && safety != nil {\n  1074\t\t\t// With the shim the run's leftovers are its subtree, not an\n  1075\t\t\t// environment match (review round 9, N1).\n  1076\t\t\tfor i, limit := range safety.Limitations {\n  1077\t\t\t\tif strings.HasPrefix(limit, \"no memory/CPU quota;\") {\n  1078\t\t\t\t\tsafety.Limitations[i] = \"no memory/CPU quota; the review run shim ends every process left in the run's subtree, including one in its own session\"\n  1079\t\t\t\t}\n  1080\t\t\t}\n  1081\t\t}\n  1082\t\tif useShim {\n  1083\t\t\t_ = shimWrite.Close()\n  1084\t\t\t<-shimReportDone\n  1085\t\t\t_ = shimRead.Close()\n  1086\t\t}\n  1087\t\tterminationErr = killProcessGroup(cmd)\n  1088\t\t// A command the reviewer left running in a session of its own escapes the\n  1089\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1090\t\t// directories it may still write (spec\n  1091\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1092\t\t// The environment entry is the reviewer's to set, so it is searched only\n  1093\t\t// without the shim, whose subtree is the run's by construction (review\n  1094\t\t// round 8, N1).\n  1095\t\tvar reaped []string\n  1096\t\tvar opaque int\n  1097\t\tvar reapErr error\n  1098\t\tif !useShim {\n  1099\t\t\treaped, opaque, reapErr = reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n  1100\t\t\tif reapErr != nil {\n  1101\t\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1102\t\t\t}\n  1103\t\t}\n  1104\t\tif useShim && cmd.ProcessState != nil {\n  1105\t\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n  1106\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1107\t\t\t} else {\n  1108\t\t\t\tfor _, pid := range report.Ended {\n  1109\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1110\t\t\t\t}\n  1111\t\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n  1112\t\t\t\t\treaped = append(reaped, fmt.Sprintf(\"and %d more (orphaned)\", more))\n  1113\t\t\t\t}\n  1114\t\t\t\tif report.Error != \"\" {\n  1115\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1116\t\t\t\t}\n  1117\t\t\t}\n  1118\t\t}\n  1119\t\tif len(reaped) > 0 && safety != nil {\n  1120\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n  1121\t\t}\n  1122\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1123\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1124\t\t}\n  1125\t\tterminationFailed = terminationErr != nil\n  1126\t\t// The adapter exited and a child it left still held the output when\n  1127\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1128\t\t// the exit status decides (found in review).\n  1129\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1130\t\t\trunErr = nil\n  1131\t\t}\n  1132\t\ttranscript, overflow := combined.result()\n  1133\t\tsafety.CaptureComplete = !overflow\n  1134\t\tif cmd.ProcessState != nil {\n  1135\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1136\t\t}\n  1137\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n  1138\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n  1139\t\t\tsafety.CaptureComplete = false\n  1140\t\t}\n  1141\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1142\t\t\trun.Output = string(raw)\n  1143\t\t\tif run.Provenance != nil {\n  1144\t\t\t\trun.Provenance.OutputComplete = true\n  1145\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1146\t\t\t}\n  1147\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1148\t\t\t// The agent writes no output file; its stream names its final message.\n  1149\t\t\trun.Output = final\n  1150\t\t\tif run.Provenance != nil {\n  1151\t\t\t\trun.Provenance.OutputComplete = true\n  1152\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1153\t\t\t}\n  1154\t\t} else {\n  1155\t\t\trun.Output = tail(string(transcript), 20000)\n  1156\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1157\t\t\t\tsafety.CaptureComplete = false\n  1158\t\t\t}\n  1159\t\t\tif run.Provenance != nil {\n  1160\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1161\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1162\t\t\t}\n  1163\t\t}\n  1164\t\tif run.Provenance != nil {\n  1165\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n  1166\t\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n  1167\t\t}\n  1168\t\tif runErr != nil && cmd.ProcessState == nil {\n  1169\t\t\trun.Output, transcript = \"\", nil\n  1170\t\t\tif run.Provenance != nil {\n  1171\t\t\t\trun.Provenance.OutputComplete = false\n  1172\t\t\t}\n  1173\t\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n  1174\t\t}\n  1175\t\t// Raw provenance hashes above precede redaction; only complete, bounded\n  1176\t\t// redacted channels can be retained. Partial boundaries can expose a secret.\n  1177\t\tsafety.ExecutionCause = executionCause(ctx)\n  1178\t\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n  1179\t\t\tsafety.CaptureComplete = false\n  1180\t\t}\n  1181\t\tif !safety.CaptureComplete {\n  1182\t\t\ttranscript = nil\n  1183\t\t\trun.Output = \"\"\n  1184\t\t\tif run.Provenance != nil {\n  1185\t\t\t\trun.Provenance.OutputComplete = false\n  1186\t\t\t}\n  1187\t\t\tif terminationErr != nil {\n  1188\t\t\t\treturn finish(ReviewRunFailed, \"process group termination failed; descendants may remain\")\n  1189\t\t\t}\n  1190\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1191\t\t\treturn finish(ReviewRunFailed, \"adapter capture incomplete: stream/output limit or unsafe output file\")\n  1192\t\t}\n  1193\t\tcaptureStage := \"session/interrupt recognition\"\n  1194\t\tstatus, failure, captureErr := s.classifyReviewInterruption(&run, plan, transcript, runErr, ctx.Err())\n  1195\t\tif captureErr == nil {\n  1196\t\t\tvar redactErr error\n  1197\t\t\traw := transcript\n  1198\t\t\tcaptureStage = \"stdout\"\n  1199\t\t\ttranscript, redactErr = redactReviewCapture(transcript, secrets, run.sessionForRedaction, safety.StreamBytes)\n  1200\t\t\tvar output []byte\n  1201\t\t\tif redactErr == nil {\n  1202\t\t\t\tcaptureStage = \"final output\"\n  1203\t\t\t\toutput, redactErr = redactReviewCapture([]byte(run.Output), secrets, run.sessionForRedaction, safety.OutputBytes)\n  1204\t\t\t}\n  1205\t\t\trun.Output = string(output)\n  1206\t\t\tif redactErr == nil && run.Events != \"\" {\n  1207\t\t\t\tcaptureStage = \"normalized events\"\n  1208\t\t\t\t// Events are parsed from the decoded stream, where a JSON escape no longer\n  1209\t\t\t\t// hides a value: each text is redacted again after decoding.\n  1210\t\t\t\trun.eventsBytes, redactErr = redactedDelegationEvents(run.Events, raw, run.Output, secrets, run.sessionForRedaction)\n  1211\t\t\t}\n  1212\t\t\tif redactErr != nil {\n  1213\t\t\t\tcaptureErr = redactErr\n  1214\t\t\t}\n  1215\t\t}\n  1216\t\tif captureErr != nil {\n  1217\t\t\trun.Output, transcript = \"\", nil\n  1218\t\t\tsafety.CaptureComplete = false\n  1219\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1220\t\t\tif run.Provenance != nil {\n  1221\t\t\t\trun.Provenance.OutputComplete = false\n  1222\t\t\t}\n  1223\t\t\treturn finish(ReviewRunFailed, \"adapter capture failed; unredacted output withheld; \"+delegationCaptureFailure(run.Adapter, run.Events, captureStage, captureErr))\n  1224\t\t}\n  1225\t\trun.sessionForRedaction = \"\"\n  1226\t\n  1227\t\tif status != \"\" {\n  1228\t\t\t// Partial drafts are evidence only after the same containment checks.\n  1229\t\t\tafter, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n  1230\t\t\tif err != nil || !reflect.DeepEqual(diskBefore, after) {\n  1231\t\t\t\treturn finish(ReviewRunFailed, \"interrupted adapter changed or obscured the sealed worktree\")\n  1232\t\t\t}\n  1233\t\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n  1234\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1235\t\t\t}\n  1236\t\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n  1237\t\t\t\treturn finish(ReviewRunFailed, \"origin changed during interruption: \"+err.Error())\n  1238\t\t\t}\n  1239\t\t\tif status == ReviewRunInterrupted {\n  1240\t\t\t\trun.PartialDigest = digestBytes([]byte(run.Output))\n  1241\t\t\t}\n  1242\t\t\treturn finish(status, failure)\n  1243\t\t}\n  1244\t\tdiskAfter, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n  1245\t\tif err != nil {\n  1246\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1247\t\t}\n  1248\t\tif !reflect.DeepEqual(diskBefore, diskAfter) {\n  1249\t\t\tchanged := []string{}\n  1250\t\t\tfor path, digest := range diskBefore {\n  1251\t\t\t\tif diskAfter[path] != digest {\n  1252\t\t\t\t\tchanged = append(changed, path)\n  1253\t\t\t\t}\n  1254\t\t\t}\n  1255\t\t\tfor path := range diskAfter {\n  1256\t\t\t\tif _, exists := diskBefore[path]; !exists {\n  1257\t\t\t\t\tchanged = append(changed, path)\n  1258\t\t\t\t}\n  1259\t\t\t}\n  1260\t\t\tsort.Strings(changed)\n  1261\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"the run changed files in the sealed worktree (including ignored materialization): %q\", changed))\n  1262\t\t}\n  1263\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n  1264\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1265\t\t}\n  1266\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n  1267\t\t\treturn finish(ReviewRunFailed, \"origin or policy changed: \"+err.Error())\n  1268\t\t}\n  1269\t\n  1270\t\tevents := run.eventsBytes\n  1271\t\tif run.Kind == ReviewBriefKindReview {\n  1272\t\t\t// The round and the draft's account of it are judged when the run\n  1273\t\t\t// completes, against the rounds before it (R1, R4).\n  1274\t\t\tround, err := s.ReviewRoundOf(plan.Bundle)\n  1275\t\t\tif err != nil {\n  1276\t\t\t\treturn finish(ReviewRunFailed, \"the round of the bundle cannot be derived: \"+err.Error())\n  1277\t\t\t}\n  1278\t\t\trun.Round, run.DraftProblems = round.Number, ValidateRoundDraft(round, run.Output)\n  1279\t\t}\n  1280\t\tpublished, err := finish(ReviewRunCompleted, \"\")\n  1281\t\tif err != nil {\n  1282\t\t\treturn published, err\n  1283\t\t}\n  1284\t\tif why := s.checkDispatchOrigin(plan); why != nil {\n  1285\t\t\tlate := published\n  1286\t\t\tlate.RunID, late.Path, late.TranscriptDigest, late.TranscriptPath = \"\", \"\", \"\", \"\"\n  1287\t\t\tlate.Status, late.Failure, late.Supersedes = ReviewRunFailed, why.Error(), published.RunID\n  1288\t\t\tlate.eventsBytes = events\n  1289\t\t\tlate.EndedAt = now().UTC().Format(time.RFC3339Nano)\n  1290\t\t\treturn s.recordReviewRun(late, transcript)\n  1291\t\t}\n  1292\t\treturn published, nil\n  1293\t}\n  1294\t\n  1295\t// Materialize only empty vendor staging directories in the disposable checkout,\n  1296\t// before its integrity snapshot. Files created there remain visible as mutations.\n  1297\t// The source repository and the legacy read profile are untouched.\n  1298\tfunc prepareClaudeReviewStaging(runtime *os.Root, components []ReviewPlanComponent) error {\n  1299\t\troot, err := runtime.OpenRoot(\"worktree\")\n  1300\t\tif err != nil {\n  1301\t\t\treturn err\n  1302\t\t}\n  1303\t\tdefer root.Close()\n  1304\t\tpaths := []string{\".\"}\n  1305\t\tfor _, component := range components {\n  1306\t\t\tif !filepath.IsLocal(component.Path) {\n  1307\t\t\t\treturn fmt.Errorf(\"review staging component is not confined\")\n  1308\t\t\t}\n  1309\t\t\tpaths = append(paths, component.Path)\n  1310\t\t}\n  1311\t\tfor _, path := range paths {\n  1312\t\t\tif err := root.MkdirAll(filepath.Join(path, \".claude\", \".cc-writes\"), 0o700); err != nil {\n  1313\t\t\t\treturn err\n  1314\t\t\t}\n  1315\t\t}\n  1316\t\treturn nil\n  1317\t}\n  1318\t\n  1319\t// The adapter has no authenticated producer/output declaration. Until such a\n  1320\t// declaration exists, a directory name cannot authorize regenerated evidence.\n  1321\tfunc verifyDispatchWorktree(root, commit string) error {\n  1322\t\treturn verifyDispatchWorktreeFor(root, commit, nil)\n  1323\t}\n  1324\tfunc verifyDispatchWorktreeFor(root, commit string, submodules map[string]bool) error {\n  1325\t\thead, err := snapshotGit(root, \"rev-parse\", \"--verify\", \"HEAD\")\n  1326\t\tif err != nil {\n  1327\t\t\treturn err\n  1328\t\t}\n  1329\t\tif strings.TrimSpace(string(head)) != commit {\n  1330\t\t\treturn fmt.Errorf(\"the run moved the worktree off the sealed commit\")\n  1331\t\t}\n  1332\t\tpaths, err := WorktreeDivergenceFor(root, commit, nil, func(p string) bool { return submodules == nil || submodules[p] })\n  1333\t\tif err != nil {\n  1334\t\t\treturn err\n  1335\t\t}\n  1336\t\n  1337\t\tif len(paths) > 0 {\n  1338\t\t\treturn fmt.Errorf(\"the run changed files in the sealed worktree: %q\", paths)\n  1339\t\t}\n  1340\t\treturn nil\n  1341\t}\n  1342\t\n  1343\tfunc (s Store) checkDispatchOrigin(plan DispatchPlan) error {\n  1344\t\torigin, err := dispatchWorktreeIdentity(s.Root)\n  1345\t\tif err != nil {\n  1346\t\t\treturn err\n  1347\t\t}\n  1348\t\tif plan.OriginWorktree == \"\" || origin != plan.OriginWorktree {\n  1349\t\t\treturn fmt.Errorf(\"dispatch origin conflict: worktree identity changed\")\n  1350\t\t}\n  1351\t\tif _, err := dispatchRegularInputPath(s.Root, s.activeDelegationPolicyPath()); err != nil {\n  1352\t\t\treturn err\n  1353\t\t}\n  1354\t\tpolicy, found, err := s.LoadReviewersPolicyFor(plan.Brief.Kind)\n  1355\t\tif err != nil {\n  1356\t\t\treturn fmt.Errorf(\"dispatch adapter policy unavailable: %w\", err)\n  1357\t\t}\n  1358\t\tif !found || !reflect.DeepEqual(policy.Adapters[plan.Adapter], plan.Config) {\n  1359\t\t\treturn fmt.Errorf(\"dispatch origin stale: reviewer adapter policy changed\")\n  1360\t\t}\n  1361\t\tif plan.SealedCommit != plan.Bundle.Payload.Subject.Head || plan.Brief.BundleID != plan.Bundle.BundleID || plan.Brief.BundleDigest != plan.Bundle.BundleDigest {\n  1362\t\t\treturn fmt.Errorf(\"dispatch input conflict: plan does not identify its sealed bundle\")\n  1363\t\t}\n  1364\t\t// A handoff brief is the generated brief followed by its section; the\n  1365\t\t// generated part keeps its own digest (spec pose-delegation-handoff R4).\n  1366\t\ttext := plan.Brief.Text\n  1367\t\tif plan.handoff {\n  1368\t\t\tgenerated, ok := strings.CutSuffix(text, plan.handoffSection)\n  1369\t\t\tif !ok || plan.handoffSection == \"\" {\n  1370\t\t\t\treturn fmt.Errorf(\"dispatch input conflict: handoff section changed\")\n  1371\t\t\t}\n  1372\t\t\ttext = generated\n  1373\t\t}\n  1374\t\tbody, ok := strings.CutSuffix(text, \"\\n<!-- brief-digest: \"+plan.Brief.Digest+\" -->\\n\")\n  1375\t\tif !ok || digestBytes([]byte(body)) != plan.Brief.Digest {\n  1376\t\t\treturn fmt.Errorf(\"dispatch input conflict: brief digest changed\")\n  1377\t\t}\n  1378\t\tif _, err := snapshotGit(s.Root, \"rev-parse\", \"--verify\", \"HEAD\"); err != nil {\n  1379\t\t\treturn err\n  1380\t\t}\n  1381\t\tif _, err := gitChangedPaths(s.Root); err != nil {\n  1382\t\t\treturn err\n  1383\t\t}\n  1384\t\tdigest, err := reviewBundlePayloadDigest(plan.Bundle.Payload)\n  1385\t\tif err != nil || digest != plan.Bundle.BundleDigest {\n  1386\t\t\treturn fmt.Errorf(\"dispatch input conflict: bundle payload no longer matches its sealed digest\")\n  1387\t\t}\n  1388\t\t// Inspect types and bytes before a freshness reader can follow an input.\n  1389\t\tif err := verifyBundleMaterialization(s.Root, plan.Bundle); err != nil {\n  1390\t\t\treturn err\n  1391\t\t}\n  1392\t\tif mismatch := sourceMaterializationDiffers(s.Root, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries); mismatch != \"\" {\n  1393\t\t\treturn fmt.Errorf(\"source materialization differs: %s\", mismatch)\n  1394\t\t}\n  1395\t\tif reason := s.dispatchNoLongerGoverns(plan); reason != \"\" {\n  1396\t\t\treturn fmt.Errorf(\"%s\", reason)\n  1397\t\t}\n  1398\t\n  1399\t\treturn nil\n  1400\t}\n  1401\t\n  1402\tfunc dispatchWorktreeIdentity(root string) (string, error) {\n  1403\t\ttop, err := snapshotGit(root, \"rev-parse\", \"--show-toplevel\")\n  1404\t\tif err != nil {\n  1405\t\t\treturn \"\", err\n  1406\t\t}\n  1407\t\tabs, err := filepath.Abs(root)\n  1408\t\tif err != nil {\n  1409\t\t\treturn \"\", err\n  1410\t\t}\n  1411\t\tabs, err = filepath.EvalSymlinks(abs)\n  1412\t\tif err != nil {\n  1413\t\t\treturn \"\", err\n  1414\t\t}\n  1415\t\ttopPath, err := filepath.EvalSymlinks(strings.TrimSpace(string(top)))\n  1416\t\tif err != nil || abs != topPath {\n  1417\t\t\treturn \"\", fmt.Errorf(\"dispatch origin conflict: Git selected a different worktree\")\n  1418\t\t}\n  1419\t\tdir, err := snapshotGit(root, \"rev-parse\", \"--absolute-git-dir\")\n  1420\t\tif err != nil {\n  1421\t\t\treturn \"\", err\n  1422\t\t}\n  1423\t\treturn string(top) + \"\\x00\" + string(dir), nil\n  1424\t}\n  1425\t\n  1426\tfunc verifyBundleMaterialization(root string, bundle ReviewBundle) error {\n  1427\t\tfor _, entry := range bundle.Payload.Subject.Entries {\n  1428\t\t\tpath := entry.Path\n  1429\t\t\tif entry.NewPath != \"\" {\n  1430\t\t\t\tpath = entry.NewPath\n  1431\t\t\t}\n  1432\t\t\tif entry.Class == \"submodule\" {\n  1433\t\t\t\tfull, err := dispatchInputPath(root, path)\n  1434\t\t\t\tif err != nil {\n  1435\t\t\t\t\treturn err\n  1436\t\t\t\t}\n  1437\t\t\t\tif _, err := dispatchWorktreeIdentity(full); err != nil {\n  1438\t\t\t\t\treturn err\n  1439\t\t\t\t}\n  1440\t\t\t\thead, err := snapshotGit(full, \"rev-parse\", \"--verify\", \"HEAD\")\n  1441\t\t\t\tif err != nil {\n  1442\t\t\t\t\treturn err\n  1443\t\t\t\t}\n  1444\t\t\t\tif digestBytes([]byte(strings.TrimSpace(string(head)))) != entry.Digest {\n  1445\t\t\t\t\treturn fmt.Errorf(\"dispatch input conflict: submodule %q moved\", path)\n  1446\t\t\t\t}\n  1447\t\t\t\tif err := verifyDispatchWorktree(full, strings.TrimSpace(string(head))); err != nil {\n  1448\t\t\t\t\treturn err\n  1449\t\t\t\t}\n  1450\t\t\t\tcontinue\n  1451\t\t\t}\n  1452\t\t\tif entry.Action == \"removed\" {\n  1453\t\t\t\tif _, err := os.Lstat(filepath.Join(root, filepath.FromSlash(path))); !errors.Is(err, os.ErrNotExist) {\n  1454\t\t\t\t\treturn fmt.Errorf(\"dispatch input conflict: removed path %q exists or is unreadable\", path)\n  1455\t\t\t\t}\n  1456\t\t\t\tcontinue\n  1457\t\t\t}\n  1458\t\t\tif err := verifyDispatchInput(root, path, entry.Digest, true); err != nil {\n  1459\t\t\t\treturn err\n  1460\t\t\t}\n  1461\t\t}\n  1462\t\tfor _, input := range bundle.Payload.ConsumedInputs {\n  1463\t\t\tswitch input.Kind {\n  1464\t\t\tcase \"governed-config\", \"review-profile\", \"rule\":\n  1465\t\t\t\tif err := verifyDispatchInput(root, input.Path, input.Digest, false); err != nil {\n  1466\t\t\t\t\treturn err\n  1467\t\t\t\t}\n  1468\t\t\t}\n  1469\t\t}\n  1470\t\treturn nil\n  1471\t}\n  1472\t\n  1473\tfunc dispatchInputPath(root, path string) (string, error) {\n  1474\t\tvar err error\n  1475\t\troot, err = filepath.Abs(root)\n  1476\t\tif err != nil {\n  1477\t\t\treturn \"\", &GitSnapshotError{\"root\", err}\n  1478\t\t}\n  1479\t\tif path == \"\" || filepath.IsAbs(path) || filepath.ToSlash(filepath.Clean(path)) != path || path == \"..\" || strings.HasPrefix(path, \"../\") {\n  1480\t\t\treturn \"\", fmt.Errorf(\"dispatch input conflict: unsafe path %q\", path)\n  1481\t\t}\n  1482\t\tfull := filepath.Join(root, filepath.FromSlash(path))\n  1483\t\tfor parent := full; parent != root; parent = filepath.Dir(parent) {\n  1484\t\t\tinfo, err := os.Lstat(parent)\n  1485\t\t\tif err != nil {\n  1486\t\t\t\treturn \"\", &GitSnapshotError{\"input \" + path, err}\n  1487\t\t\t}\n  1488\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n  1489\t\t\t\treturn \"\", fmt.Errorf(\"dispatch input conflict: symlink %q\", path)\n  1490\t\t\t}\n  1491\t\t}\n  1492\t\treturn full, nil\n  1493\t}\n  1494\t\n  1495\tfunc verifyDispatchInput(root, path, digest string, normalize bool) error {\n  1496\t\tfull, err := dispatchRegularInputPath(root, path)\n  1497\t\tif err != nil {\n  1498\t\t\treturn err\n  1499\t\t}\n  1500\t\tfile, err := os.Open(full)\n  1501\t\tif err != nil {\n  1502\t\t\treturn &GitSnapshotError{\"input \" + path, err}\n  1503\t\t}\n  1504\t\traw, readErr := io.ReadAll(io.LimitReader(file, (256<<20)+1))\n  1505\t\tcloseErr := file.Close()\n  1506\t\tif readErr != nil {\n  1507\t\t\treturn &GitSnapshotError{\"input \" + path, readErr}\n  1508\t\t}\n  1509\t\tif closeErr != nil {\n  1510\t\t\treturn &GitSnapshotError{\"input \" + path, closeErr}\n  1511\t\t}\n  1512\t\tif len(raw) > 256<<20 {\n  1513\t\t\treturn &GitSnapshotError{\"input \" + path, fmt.Errorf(\"input exceeds 256 MiB\")}\n  1514\t\t}\n  1515\t\tif normalize {\n  1516\t\t\traw = bytes.ReplaceAll(raw, []byte(\"\\r\\n\"), []byte(\"\\n\"))\n  1517\t\t}\n  1518\t\tif digest == \"\" || digestBytes(raw) != digest {\n  1519\t\t\treturn fmt.Errorf(\"dispatch input conflict: sealed bytes changed for %q\", path)\n  1520\t\t}\n  1521\t\treturn nil\n  1522\t}\n  1523\t\n  1524\tfunc dispatchRegularInputPath(root, path string) (string, error) {\n  1525\t\tfull, err := dispatchInputPath(root, path)\n  1526\t\tif err != nil {\n  1527\t\t\treturn \"\", err\n  1528\t\t}\n  1529\t\tinfo, err := os.Lstat(full)\n  1530\t\tif err != nil {\n  1531\t\t\treturn \"\", &GitSnapshotError{\"input \" + path, err}\n  1532\t\t}\n  1533\t\tif !info.Mode().IsRegular() {\n  1534\t\t\treturn \"\", fmt.Errorf(\"dispatch input conflict: %q is not a regular file\", path)\n  1535\t\t}\n  1536\t\treturn full, nil\n  1537\t}\n  1538\t\n  1539\t// ReviewerArgv expands a command template: \"{effort}\" becomes the argv\n  1540\t// fragment of the effort level (the agent's default when level is \"\"), and\n  1541\t// \"{output}\" and \"{session}\" become their values. Schema 2 templates hold\n  1542\t// placeholders only as whole elements; schema 1 templates keep their\n  1543\t// in-element replacement.\n  1544\tfunc ReviewerArgv(command []string, output, session, level string, effort *ReviewerEffort) []string {\n  1545\t\targv := make([]string, 0, len(command))\n  1546\t\tfor _, arg := range command {\n  1547\t\t\tif arg == \"{effort}\" {\n  1548\t\t\t\tif effort != nil {\n  1549\t\t\t\t\tif level == \"\" {\n  1550\t\t\t\t\t\tlevel = effort.Default\n  1551\t\t\t\t\t}\n  1552\t\t\t\t\targv = append(argv, effort.Levels[level]...)\n  1553\t\t\t\t}\n  1554\t\t\t\tcontinue\n  1555\t\t\t}\n  1556\t\t\targv = append(argv, strings.ReplaceAll(strings.ReplaceAll(arg, \"{output}\", output), \"{session}\", session))\n  1557\t\t}\n  1558\t\treturn argv\n  1559\t}\n  1560\t\n  1561\tfunc tail(s string, n int) string {\n  1562\t\tif len(s) <= n {\n  1563\t\t\treturn s\n  1564\t\t}\n  1565\t\treturn s[len(s)-n:]\n  1566\t}\n  1567\t\n  1568\t// beforeAttemptPublished runs between the active marker and the reservation;\n  1569\t// tests use it to stop a dispatch there.\n  1570\tvar beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {}\n  1571\t\n  1572\tfunc (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\n  1573\t\t// Identity covers only persisted content, never fields derived by a reader\n  1574\t\t// or a previous write of a copied record.\n  1575\t\trun.RunID, run.Path, run.TranscriptPath, run.SupersededBy = \"\", \"\", \"\", \"\"\n  1576\t\trun.LedgerVersion = 1\n  1577\t\tsum := sha256.Sum256(transcript)\n  1578\t\trun.TranscriptDigest = \"sha256:\" + hex.EncodeToString(sum[:])\n  1579\t\tvar events []byte\n  1580\t\trun.EventsDigest = \"\"\n  1581\t\tif run.Events != \"\" {\n  1582\t\t\tevents = run.eventsBytes\n  1583\t\t\trun.EventsDigest = digestBytes(events)\n  1584\t\t}\n  1585\t\trun.eventsBytes = nil // never part of the record or of a copy compared with it\n  1586\t\tidentity, _ := json.Marshal(run)\n  1587\t\tidSum := sha256.Sum256(identity)\n  1588\t\trun.RunID = \"rrn-\" + hex.EncodeToString(idSum[:])[:16]\n  1589\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, reviewRunsDir, true)\n  1590\t\tif err != nil {\n  1591\t\t\treturn ReviewRun{}, err\n  1592\t\t}\n  1593\t\trun.TranscriptPath = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\"))\n  1594\t\tpretty, err := json.MarshalIndent(run, \"\", \"  \")\n  1595\t\tif err != nil {\n  1596\t\t\treturn ReviewRun{}, err\n  1597\t\t}\n  1598\t\tpretty = append(pretty, '\\n')\n  1599\t\tif len(pretty) > reviewLedgerMaxBytes {\n  1600\t\t\treturn ReviewRun{}, fmt.Errorf(\"review run record exceeds %d-byte bound; nothing published\", reviewLedgerMaxBytes)\n  1601\t\t}\n  1602\t\tif len(transcript) > reviewTranscriptMaxBytes {\n  1603\t\t\treturn ReviewRun{}, fmt.Errorf(\"review transcript exceeds %d-byte bound; nothing published\", reviewTranscriptMaxBytes)\n  1604\t\t}\n  1605\t\n  1606\t\twitness := reviewRunWitness{SchemaVersion: 1, RunID: run.RunID, BundleID: run.BundleID, Scope: run.Scope, RecordDigest: digestBytes(pretty), TranscriptDigest: run.TranscriptDigest}\n  1607\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(filepath.Join(reviewRunLedgerDir, run.RunID+\".json\")), witness); err != nil {\n  1608\t\t\treturn ReviewRun{}, err\n  1609\t\t}\n  1610\t\tif run.Safety != nil && int64(len(pretty)+len(transcript)+len(events)) > run.Safety.RetainedBytes {\n  1611\t\t\treturn ReviewRun{}, fmt.Errorf(\"retained run exceeds containment byte budget; attempt remains incomplete\")\n  1612\t\t}\n  1613\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".transcript\"), transcript, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1614\t\t\treturn ReviewRun{}, err\n  1615\t\t}\n  1616\t\tif run.EventsDigest != \"\" {\n  1617\t\t\tif err := publishDelegationEvents(dir, run.RunID, events); err != nil {\n  1618\t\t\t\treturn ReviewRun{}, err\n  1619\t\t\t}\n  1620\t\t}\n  1621\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".json\"), pretty, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1622\t\t\treturn ReviewRun{}, err\n  1623\t\t}\n  1624\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".json\"))\n  1625\t\treturn run, nil\n  1626\t}\n  1627\t\n  1628\tfunc (s Store) dispatchNoLongerGoverns(plan DispatchPlan) string {\n  1629\t\tcurrent, err := s.LoadReviewBundle(plan.Bundle.BundleID)\n  1630\t\tif err != nil {\n  1631\t\t\treturn \"stale: the bundle the run reviewed can no longer be read: \" + err.Error()\n  1632\t\t}\n  1633\t\tif current.BundleDigest != plan.Bundle.BundleDigest {\n  1634\t\t\treturn \"stale: the bundle the run reviewed changed while it ran\"\n  1635\t\t}\n  1636\t\t// The baseline is a digest of a policy that was read whole, and the policy must still\n  1637\t\t// read whole and unchanged: a policy that cannot be read now is not an unchanged one.\n  1638\t\tif !directoryDigestKnown(plan.PolicyDigest) {\n  1639\t\t\treturn \"stale: the dispatch has no readable policy baseline (\" + plan.PolicyDigest + \")\"\n  1640\t\t}\n  1641\t\tif now := directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")); now != plan.PolicyDigest {\n  1642\t\t\t// A run recorded before pose update converted reviewers.json keeps its\n  1643\t\t\t// baseline while delegation.json is exactly that conversion (D7).\n  1644\t\t\tif before, ok := s.migratedPolicyBaseline(); !ok || before != plan.PolicyDigest {\n  1645\t\t\t\treturn \"stale: the policy changed or can no longer be read whole while the run was going (\" + now + \")\"\n  1646\t\t\t}\n  1647\t\t}\n  1648\t\t// Every sealed bundle of the scope must have been read: one that cannot be read may be\n  1649\t\t// the one that superseded this.\n  1650\t\tread, readErr := s.ReadReviewBundles(plan.Brief.Scope)\n  1651\t\tif readErr != nil {\n  1652\t\t\treturn \"stale: the bundles of the scope could not be read: \" + readErr.Error()\n  1653\t\t}\n  1654\t\tif !read.Coverage.CompleteFor(plan.Brief.Scope) {\n  1655\t\t\treturn \"stale: a sealed bundle of the scope could not be read, so the run cannot be tied to the one that governs it\"\n  1656\t\t}\n  1657\t\t// The bundle governs while the inputs it sealed are the ones the repository has now:\n  1658\t\t// the semantic digest of today's preparation, not the order of identifiers.\n  1659\t\tprepared, prepErr := s.PrepareReviewBundle(plan.Brief.Scope)\n  1660\t\tif prepErr != nil {\n  1661\t\t\treturn \"stale: the inputs of the scope could not be prepared again: \" + prepErr.Error()\n  1662\t\t}\n  1663\t\tif !sealedBundleMatches(plan.Bundle, prepared) {\n  1664\t\t\treturn \"stale: the bundle was superseded or its inputs changed while the run was going (the scope now prepares \" + prepared.BundleDigest + \")\"\n  1665\t\t}\n  1666\t\t// Equal content is not the governing bundle: a later seal may have replaced\n  1667\t\t// the implementation identity this run was compared with.\n  1668\t\tif governing := governingSealedBundle(read.Bundles, prepared); governing == nil || governing.BundleID != plan.Bundle.BundleID {\n  1669\t\t\treturn \"stale: another sealed bundle of the same content now governs the scope (its implementation identity was sealed again)\"\n  1670\t\t}\n  1671\t\t// An equal digest is not an eligible preparation: a preparation that carries blockers\n  1672\t\t// (an unreadable Git status among them) did not read what it says it read.\n  1673\t\tif len(prepared.Blockers) > 0 {\n  1674\t\t\treturn \"stale: the scope cannot be prepared for review without blockers: \" + strings.Join(prepared.Blockers, \"; \")\n  1675\t\t}\n  1676\t\t// The digest of a file is its bytes; the mode the commit recorded is part of what was\n  1677\t\t// sealed, and a status that is told to ignore modes cannot be the witness of it.\n  1678\t\t// The revision of the source must be readable: an unreadable HEAD is not a HEAD that did not move.\n  1679\t\tif hasGitMetadata(s.Root) {\n  1680\t\t\tif _, headErr := ReadGitHead(s.Root); headErr != nil && !errors.Is(headErr, ErrGitUnavailable) {\n  1681\t\t\t\treturn \"stale: the revision of the source could not be read: \" + headErr.Error()\n  1682\t\t\t}\n  1683\t\t}\n  1684\t\tif mismatch := sourceMaterializationDiffers(s.Root, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries); mismatch != \"\" {\n  1685\t\t\treturn \"stale: the source file \" + mismatch + \" differs from what the sealed commit records\"\n  1686\t\t}\n  1687\t\treturn \"\"\n  1688\t}\n  1689\t\n  1690\t// ReviewRunRecordStands says why the record of a completed run no longer stands, or \"\": the\n  1691\t// run completed with a safe record, no other run superseded it, the persisted record is the\n  1692\t// copy in hand, its transcript is intact and the bundle it names reads with the digest, scope\n  1693\t// and sealed commit it recorded. It asks nothing of the repository as it is now.\n  1694\tfunc (s Store) ReviewRunRecordStands(run ReviewRun) string {\n  1695\t\tif why := reviewSafetyConflict(run); why != \"\" {\n  1696\t\t\treturn why\n  1697\t\t}\n  1698\t\tif run.Status != ReviewRunCompleted {\n  1699\t\t\treturn \"the run is \" + run.Status + \", not completed\"\n  1700\t\t}\n  1701\t\truns, lost, err := s.ReadReviewRuns(\"\")\n  1702\t\tif err != nil {\n  1703\t\t\treturn \"the runs of the bundle could not be read: \" + err.Error()\n  1704\t\t}\n  1705\t\tif len(lost) > 0 {\n  1706\t\t\treturn \"a run record could not be read and may supersede this run: \" + strings.Join(lost, \", \")\n  1707\t\t}\n  1708\t\tvar persisted *ReviewRun\n  1709\t\tfor i, other := range runs {\n  1710\t\t\tif other.Supersedes == run.RunID {\n  1711\t\t\t\treturn \"the run was superseded by \" + other.RunID\n  1712\t\t\t}\n  1713\t\t\tif other.RunID == run.RunID {\n  1714\t\t\t\tpersisted = &runs[i]\n  1715\t\t\t}\n  1716\t\t}\n  1717\t\t// The copy in hand is not the run: the record is, and it must be there and say the same.\n  1718\t\tif persisted == nil {\n  1719\t\t\treturn \"the record of the run is not in the review runs\"\n  1720\t\t}\n  1721\t\ta, b := *persisted, run\n  1722\t\ta.Path, a.SupersededBy, b.Path, b.SupersededBy = \"\", \"\", \"\", \"\"\n  1723\t\tif !reflect.DeepEqual(a, b) {\n  1724\t\t\treturn \"the record of the run differs from the copy that is being consulted\"\n  1725\t\t}\n  1726\t\tif why := s.reviewRunTranscriptIntact(*persisted); why != \"\" {\n  1727\t\t\treturn why\n  1728\t\t}\n  1729\t\tbundle, err := s.LoadReviewBundle(run.BundleID)\n  1730\t\tif err != nil {\n  1731\t\t\treturn \"the bundle of the run can no longer be read: \" + err.Error()\n  1732\t\t}\n  1733\t\t// The record says what it reviewed; what it says must be what the bundle is.\n  1734\t\tif run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.SealedCommit != bundle.Payload.Subject.Head {\n  1735\t\t\treturn \"the run record does not describe the bundle it names (bundle digest, scope or sealed commit differ)\"\n  1736\t\t}\n  1737\t\treturn \"\"\n  1738\t}\n  1739\t\n  1740\t// ReviewRunStillGoverns says why a run no longer governs its scope as the repository is now,\n  1741\t// or \"\": its record stands, Git answers, the persisted review inputs still materialize and the\n  1742\t// bundle it reviewed is still what the scope prepares.\n  1743\tfunc (s Store) ReviewRunStillGoverns(run ReviewRun) string {\n  1744\t\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n  1745\t\t\treturn why\n  1746\t\t}\n  1747\t\tif _, err := dispatchWorktreeIdentity(s.Root); err != nil {\n  1748\t\t\treturn \"origin Git identity unknown: \" + err.Error()\n  1749\t\t}\n  1750\t\tif _, err := ReadGitHead(s.Root); err != nil {\n  1751\t\t\treturn \"origin HEAD unknown: \" + err.Error()\n  1752\t\t}\n  1753\t\tbundle, err := s.LoadReviewBundle(run.BundleID)\n  1754\t\tif err != nil {\n  1755\t\t\treturn \"the bundle of the run can no longer be read: \" + err.Error()\n  1756\t\t}\n  1757\t\tif err := verifyBundleMaterialization(s.Root, bundle); err != nil {\n  1758\t\t\treturn \"persisted review inputs no longer materialize: \" + err.Error()\n  1759\t\t}\n  1760\t\treturn s.dispatchNoLongerGoverns(DispatchPlan{Bundle: bundle, Brief: ReviewBrief{Scope: run.Scope}, SealedCommit: run.SealedCommit,\n  1761\t\t\tPolicyDigest: run.PolicyDigest})\n  1762\t}\n  1763\t\n  1764\tfunc validateReviewRunRecord(name string, run ReviewRun) error {\n  1765\t\tif name != run.RunID+\".json\" {\n  1766\t\t\treturn fmt.Errorf(\"the file is not named after the run it holds\")\n  1767\t\t}\n  1768\t\tif run.LedgerVersion != 0 && run.LedgerVersion != 1 {\n  1769\t\t\treturn fmt.Errorf(\"unknown ledger version %d\", run.LedgerVersion)\n  1770\t\t}\n  1771\t\tif run.SchemaVersion != 1 {\n  1772\t\t\treturn fmt.Errorf(\"schema_version %d is not read by this engine\", run.SchemaVersion)\n  1773\t\t}\n  1774\t\tswitch run.Status {\n  1775\t\tcase ReviewRunCompleted, ReviewRunFailed, ReviewRunStale, ReviewRunInterrupted:\n  1776\t\tdefault:\n  1777\t\t\treturn fmt.Errorf(\"status %q is not a state of a run\", run.Status)\n  1778\t\t}\n  1779\t\tif err := validateContinuityRun(run); err != nil {\n  1780\t\t\treturn err\n  1781\t\t}\n  1782\t\tif run.BundleID == \"\" || run.Scope == \"\" {\n  1783\t\t\treturn fmt.Errorf(\"the bundle or scope is missing\")\n  1784\t\t}\n  1785\t\tfor _, at := range []string{run.StartedAt, run.EndedAt} {\n  1786\t\t\tif _, err := time.Parse(time.RFC3339Nano, at); err != nil {\n  1787\t\t\t\treturn fmt.Errorf(\"an instant of the run is not RFC3339: %q\", at)\n  1788\t\t\t}\n  1789\t\t}\n  1790\t\tif run.TranscriptPath != filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\")) {\n  1791\t\t\treturn fmt.Errorf(\"the transcript path is not the one the run is written with\")\n  1792\t\t}\n  1793\t\tunsealed := run\n  1794\t\tunsealed.RunID, unsealed.TranscriptPath, unsealed.SupersededBy, unsealed.Path = \"\", \"\", \"\", \"\"\n  1795\t\tidentity, _ := json.Marshal(unsealed)\n  1796\t\tsum := sha256.Sum256(identity)\n  1797\t\tif run.RunID != \"rrn-\"+hex.EncodeToString(sum[:])[:16] {\n  1798\t\t\treturn fmt.Errorf(\"the identity of the run is not derived from its content\")\n  1799\t\t}\n  1800\t\treturn nil\n  1801\t}\n  1802\t\n  1803\tconst reviewTranscriptMaxBytes = 256 << 20\n  1804\t\n  1805\tfunc (s Store) reviewRunTranscriptIntact(run ReviewRun) string {\n  1806\t\tproblem, _, err := memoizedLedgerRead(s.fsys(), \"transcript\\x00\"+filepath.Clean(s.Root)+\"\\x00\"+run.TranscriptPath+\"\\x00\"+run.TranscriptDigest, func() (string, error) {\n  1807\t\t\treturn s.checkReviewRunTranscript(run), nil\n  1808\t\t})\n  1809\t\tif err != nil {\n  1810\t\t\t// A refused read is not an intact transcript (review N1).\n  1811\t\t\treturn \"the transcript of the run cannot be inspected: \" + err.Error()\n  1812\t\t}\n  1813\t\treturn problem\n  1814\t}\n  1815\t\n  1816\t// checkReviewRunTranscript reads a run's transcript and checks it against\n  1817\t// the digest the run names; it returns the problem, or \"\".\n  1818\tfunc (s Store) checkReviewRunTranscript(run ReviewRun) string {\n  1819\t\tfull := filepath.Join(s.Root, filepath.FromSlash(run.TranscriptPath))\n  1820\t\tfiles := s.fsys()\n  1821\t\tinfo, err := files.Lstat(full)\n  1822\t\tif err != nil {\n  1823\t\t\treturn \"the transcript of the run cannot be inspected: \" + err.Error()\n  1824\t\t}\n  1825\t\tif !info.Mode().IsRegular() {\n  1826\t\t\treturn \"the transcript of the run is not a regular file\"\n  1827\t\t}\n  1828\t\tif info.Size() > reviewTranscriptMaxBytes {\n  1829\t\t\treturn \"the transcript exceeds the 256 MiB verification bound\"\n  1830\t\t}\n  1831\t\tfile, err := files.Open(full)\n  1832\t\tif err != nil {\n  1833\t\t\treturn \"the transcript of the run cannot be read: \" + err.Error()\n  1834\t\t}\n  1835\t\topened, statErr := file.Stat()\n  1836\t\tif statErr != nil || !opened.Mode().IsRegular() || !sameObservedFile(info, opened) {\n  1837\t\t\tfile.Close()\n  1838\t\t\treturn \"the transcript changed while opening\"\n  1839\t\t}\n  1840\t\thash := sha256.New()\n  1841\t\tn, readErr := io.Copy(hash, io.LimitReader(file, reviewTranscriptMaxBytes+1))\n  1842\t\tcloseErr := file.Close()\n  1843\t\tif readErr != nil || closeErr != nil {\n  1844\t\t\treturn fmt.Sprintf(\"the transcript could not be verified: %v %v\", readErr, closeErr)\n  1845\t\t}\n  1846\t\tif n > reviewTranscriptMaxBytes {\n  1847\t\t\treturn \"the transcript exceeds the 256 MiB verification bound\"\n  1848\t\t}\n  1849\t\tif \"sha256:\"+hex.EncodeToString(hash.Sum(nil)) != run.TranscriptDigest {\n  1850\t\t\treturn \"the transcript of the run is not the one its digest names\"\n  1851\t\t}\n  1852\t\treturn \"\"\n  1853\t}\n  1854\t\n  1855\tfunc removedSides(entry ReviewBundleSubjectEntry) []string {\n  1856\t\tswitch entry.Action {\n  1857\t\tcase \"removed\":\n  1858\t\t\tif p := reviewBundleEntryPath(entry); p != \"\" {\n  1859\t\t\t\treturn []string{p}\n  1860\t\t\t}\n  1861\t\tcase \"renamed\":\n  1862\t\t\tif entry.OldPath != \"\" {\n  1863\t\t\t\treturn []string{entry.OldPath}\n  1864\t\t\t}\n  1865\t\t}\n  1866\t\treturn nil\n  1867\t}\n  1868\t\n  1869\tfunc sealedInputsThatDiffer(sealed, other ReviewBundle, checkout string) []string {\n  1870\t\tkey := func(kind, p string) string { return kind + \" \" + p }\n  1871\t\tcollect := func(b ReviewBundle) map[string]string {\n  1872\t\t\tout := map[string]string{}\n  1873\t\t\tfor _, in := range b.Payload.Scope.Sections {\n  1874\t\t\t\tout[key(in.Kind, in.Path)] = in.Digest\n  1875\t\t\t}\n  1876\t\t\tfor _, in := range b.Payload.ConsumedInputs {\n  1877\t\t\t\tswitch in.Kind {\n  1878\t\t\t\tcase \"governed-config\", \"review-profile\", \"rule\":\n  1879\t\t\t\t\tout[key(in.Kind, in.Path)] = in.Digest\n  1880\t\t\t\t}\n  1881\t\t\t}\n  1882\t\t\treturn out\n  1883\t\t}\n  1884\t\twant, got := collect(sealed), collect(other)\n  1885\t\tvar differing []string\n  1886\t\tfor k, digest := range want {\n  1887\t\t\tif got[k] != digest {\n  1888\t\t\t\tdiffering = append(differing, k)\n  1889\t\t\t}\n  1890\t\t}\n  1891\t\t// The implementation the bundle sealed: each file of its subject, as the checkout holds it.\n  1892\t\tfor _, entry := range sealed.Payload.Subject.Entries {\n  1893\t\t\tif entry.Digest == \"\" || entry.Action == \"removed\" || entry.Class == \"submodule\" {\n  1894\t\t\t\tcontinue\n  1895\t\t\t}\n  1896\t\t\trel := reviewBundleEntryPath(entry)\n  1897\t\t\tif strings.HasPrefix(filepath.ToSlash(rel), pendingFragmentDir) {\n  1898\t\t\t\tcontinue // archived since: the ledger, not the path, holds it\n  1899\t\t\t}\n  1900\t\t\traw, err := os.ReadFile(filepath.Join(checkout, filepath.FromSlash(rel)))\n  1901\t\t\tif err != nil || digestBytes(bytes.ReplaceAll(raw, []byte(\"\\r\\n\"), []byte(\"\\n\"))) != entry.Digest {\n  1902\t\t\t\tdiffering = append(differing, \"subject \"+rel)\n  1903\t\t\t}\n  1904\t\t}\n  1905\t\tsort.Strings(differing)\n  1906\t\treturn differing\n  1907\t}\n  1908\t\n  1909\t// checkoutBlockers are the blockers of the sealed checkout that hold there. Two kinds do not,\n  1910\t// because they concern evidence that is not part of the sealed subject and that a checkout of\n  1911\t// the sealed commit cannot hold: the delivery integrity index (derived, not checked out) and the\n  1912\t// sealed review bundles of the children of a roadmap or milestone. The children are reviewed and\n  1913\t// committed before the roadmap bundle is sealed, but the subject's head is the last commit that\n  1914\t// changed a subject path, which is older than their records; the bundle sealed at the real head\n  1915\t// already judged them, and closing the scope judges them again (spec\n  1916\t// pose-sealed-checkout-does-not-require-later-child-evidence).\n  1917\tfunc checkoutBlockers(blockers []string) []string {\n  1918\t\tvar out []string\n  1919\t\tfor _, blocker := range blockers {\n  1920\t\t\tif strings.Contains(blocker, \"delivery integrity is unavailable\") || isChildReviewEvidenceBlocker(blocker) {\n  1921\t\t\t\tcontinue\n  1922\t\t\t}\n  1923\t\t\tout = append(out, blocker)\n  1924\t\t}\n  1925\t\treturn out\n  1926\t}\n  1927\t\n  1928\t// isChildReviewEvidenceBlocker recognises \"child <scope> has no sealed review bundle[: why]\".\n  1929\tfunc isChildReviewEvidenceBlocker(blocker string) bool {\n  1930\t\treturn strings.HasPrefix(blocker, \"child \") && strings.Contains(blocker, \" has no sealed review bundle\")\n  1931\t}\n  1932\t\n  1933\tfunc sourceMaterializationDiffers(root, commit string, entries []ReviewBundleSubjectEntry) string {\n  1934\t\tif commit == \"\" || !hasGitMetadata(root) {\n  1935\t\t\t// No sealed commit, or no repository at all: nothing to compare with (a dispatch has both).\n  1936\t\t\treturn \"\"\n  1937\t\t}\n  1938\t\tcheckedDirs := map[string]bool{}\n  1939\t\tfor _, entry := range entries {\n  1940\t\t\tif entry.Class == \"submodule\" {\n  1941\t\t\t\tcontinue\n  1942\t\t\t}\n  1943\t\t\t// The absence the bundle sealed is part of what it reviewed: a removed path, and the old\n  1944\t\t\t// side of a rename, must still be absent, whatever Git was told to ignore.\n  1945\t\t\tfor _, gone := range removedSides(entry) {\n  1946\t\t\t\tif _, err := os.Lstat(filepath.Join(root, filepath.FromSlash(gone))); err == nil {\n  1947\t\t\t\t\treturn gone + \" (the bundle sealed it as removed, and it is there)\"\n  1948\t\t\t\t}\n  1949\t\t\t}\n  1950\t\t\tif entry.Action == \"removed\" {\n  1951\t\t\t\tcontinue\n  1952\t\t\t}\n  1953\t\t\trel := reviewBundleEntryPath(entry)\n  1954\t\t\tif linkAbove(root, rel, checkedDirs) {\n  1955\t\t\t\treturn rel + \" (a directory above it is a link, or not a directory)\"\n  1956\t\t\t}\n  1957\t\t\tout, err := gitCommand(\"-C\", root, \"ls-tree\", \"-z\", commit, \"--\", rel).Output()\n  1958\t\t\tif err != nil {\n  1959\t\t\t\treturn rel + \" (its record in the sealed commit could not be read: \" + err.Error() + \")\"\n  1960\t\t\t}\n  1961\t\t\tmeta, _, ok := strings.Cut(strings.TrimSuffix(string(out), \"\\x00\"), \"\\t\")\n  1962\t\t\tfields := strings.Fields(meta)\n  1963\t\t\tif !ok || len(fields) < 3 {\n  1964\t\t\t\tcontinue // not in the sealed commit\n  1965\t\t\t}\n  1966\t\t\tmode, object := fields[0], fields[2]\n  1967\t\t\tinfo, lerr := os.Lstat(filepath.Join(root, filepath.FromSlash(rel)))\n  1968\t\t\tif lerr != nil {\n  1969\t\t\t\treturn rel + \" (it cannot be inspected: \" + lerr.Error() + \")\"\n  1970\t\t\t}\n  1971\t\t\tswitch mode {\n  1972\t\t\tcase \"120000\":\n  1973\t\t\t\ttarget, rerr := os.Readlink(filepath.Join(root, filepath.FromSlash(rel)))\n  1974\t\t\t\tif info.Mode()&os.ModeSymlink == 0 || rerr != nil || gitBlobID(\"sha1\", []byte(target)) != object && gitBlobID(\"sha256\", []byte(target)) != object {\n  1975\t\t\t\t\treturn rel + \" (it is not the link the sealed commit records)\"\n  1976\t\t\t\t}\n  1977\t\t\tdefault:\n  1978\t\t\t\tif !info.Mode().IsRegular() {\n  1979\t\t\t\t\treturn rel + \" (it is not a regular file, and the sealed commit records one)\"\n  1980\t\t\t\t}\n  1981\t\t\t\tif runtime.GOOS != \"windows\" && (info.Mode().Perm()&0o111 != 0) != (mode == \"100755\") {\n  1982\t\t\t\t\treturn rel + \" (its executable bit differs)\"\n  1983\t\t\t\t}\n  1984\t\t\t}\n  1985\t\t}\n  1986\t\treturn \"\"\n  1987\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_shim_linux.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"os/signal\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"golang.org/x/sys/unix\"\n    18\t)\n    19\t\n    20\t// RunReviewShim runs args (the adapter's path, then its argv) as the shim's\n    21\t// only child, waits for it or for SIGTERM, ends every process left in the\n    22\t// shim's subtree and returns the adapter's exit status.\n    23\tfunc RunReviewShim(args []string) int {\n    24\t\treport := reviewShimReport{}\n    25\t\tvar reportFile *os.File\n    26\t\tparent := 0\n    27\t\tif value := os.Getenv(ReviewShimReportEnv); value != \"\" {\n    28\t\t\tparent, _ = strconv.Atoi(value)\n    29\t\t\t// The report pipe is the shim's alone: the adapter never inherits it.\n    30\t\t\tsyscall.CloseOnExec(3)\n    31\t\t\treportFile = os.NewFile(3, \"pose-review-shim-report\")\n    32\t\t}\n    33\t\t_ = os.Unsetenv(ReviewShimReportEnv)\n    34\t\twrite := func() {\n    35\t\t\tif reportFile == nil {\n    36\t\t\t\treturn\n    37\t\t\t}\n    38\t\t\traw := boundedReviewShimReport(report)\n    39\t\t\t_, _ = reportFile.Write(raw)\n    40\t\t\t_ = reportFile.Close()\n    41\t\t}\n    42\t\tif len(args) < 2 {\n    43\t\t\treport.Error = \"the review shim was given no adapter\"\n    44\t\t\twrite()\n    45\t\t\treturn 125\n    46\t\t}\n    47\t\tstop := make(chan os.Signal, 1)\n    48\t\tsignal.Notify(stop, syscall.SIGTERM)\n    49\t\t// The dispatcher's death stops the shim the same way as a timeout.\n    50\t\tif err := unix.Prctl(unix.PR_SET_PDEATHSIG, uintptr(syscall.SIGTERM), 0, 0, 0); err != nil {\n    51\t\t\treport.Error = \"the shim could not follow its dispatcher: \" + err.Error()\n    52\t\t\twrite()\n    53\t\t\treturn 125\n    54\t\t}\n    55\t\tif parent != 0 && os.Getppid() != parent {\n    56\t\t\treport.Error = \"the dispatcher ended before the shim started\"\n    57\t\t\twrite()\n    58\t\t\treturn 125\n    59\t\t}\n    60\t\tif err := unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0); err != nil {\n    61\t\t\treport.Error = \"the shim could not become the subreaper of the run: \" + err.Error()\n    62\t\t\twrite()\n    63\t\t\treturn 125\n    64\t\t}\n    65\t\tcmd := &exec.Cmd{Path: args[0], Args: args[1:], Stdin: os.Stdin, Stdout: os.Stdout, Stderr: os.Stderr, Env: os.Environ()}\n    66\t\tif err := cmd.Start(); err != nil {\n    67\t\t\treport.Error = \"the adapter could not run: \" + err.Error()\n    68\t\t\twrite()\n    69\t\t\treturn 127\n    70\t\t}\n    71\t\tdone := make(chan error, 1)\n    72\t\tgo func() { done <- cmd.Wait() }()\n    73\t\tcode, stopped := 0, false\n    74\t\tvar signaled syscall.Signal\n    75\t\tselect {\n    76\t\tcase err := <-done:\n    77\t\t\tvar exit *exec.ExitError\n    78\t\t\tif errors.As(err, &exit) {\n    79\t\t\t\tif status, ok := exit.Sys().(syscall.WaitStatus); ok && status.Signaled() {\n    80\t\t\t\t\tsignaled, code = status.Signal(), 128+int(status.Signal())\n    81\t\t\t\t} else {\n    82\t\t\t\t\tcode = exit.ExitCode()\n    83\t\t\t\t}\n    84\t\t\t} else if err != nil {\n    85\t\t\t\treport.Error = \"the adapter's end could not be read: \" + err.Error()\n    86\t\t\t}\n    87\t\tcase <-stop:\n    88\t\t\tstopped, code = true, 128+int(syscall.SIGTERM)\n    89\t\t}\n    90\t\tended, err := reapShimSubtree()\n    91\t\treport.Ended = ended\n    92\t\tif err != nil && report.Error == \"\" {\n    93\t\t\treport.Error = err.Error()\n    94\t\t}\n    95\t\twrite()\n    96\t\tif stopped {\n    97\t\t\treturn code\n    98\t\t}\n    99\t\t// An adapter ended by a signal is reported as ended by it: the shim ends\n   100\t\t// itself the same way, so the dispatcher reads what it would have read\n   101\t\t// without the shim.\n   102\t\tif signaled != 0 {\n   103\t\t\tsignal.Reset(signaled)\n   104\t\t\t_ = syscall.Kill(os.Getpid(), signaled)\n   105\t\t\ttime.Sleep(time.Second)\n   106\t\t}\n   107\t\treturn code\n   108\t}\n   109\t\n   110\t// stopReviewShim asks a running shim to end its subtree and exit.\n   111\tfunc stopReviewShim(cmd *exec.Cmd) func() error {\n   112\t\treturn func() error { return cmd.Process.Signal(syscall.SIGTERM) }\n   113\t}\n   114\t\n   115\t// reapShimSubtree ends and reaps every child of the shim, including the\n   116\t// orphans its subreaper status adopted, until none is left.\n   117\tfunc reapShimSubtree() ([]string, error) {\n   118\t\tself := os.Getpid()\n   119\t\tvar ended []string\n   120\t\tseen := map[int]bool{}\n   121\t\tdeadline := time.Now().Add(reviewReapWait)\n   122\t\t// A process that cannot be inspected or ended is not a reason to stop:\n   123\t\t// the others are still ended, and the problem is reported at the end\n   124\t\t// (review round 9, N3).\n   125\t\tvar problems []string\n   126\t\tnote := func(err error) {\n   127\t\t\tif len(problems) < 8 {\n   128\t\t\t\tproblems = append(problems, err.Error())\n   129\t\t\t}\n   130\t\t}\n   131\t\tfor {\n   132\t\t\tchildren := 0\n   133\t\t\tproblems = problems[:0]\n   134\t\t\tdirs, err := os.ReadDir(\"/proc\")\n   135\t\t\tif err != nil {\n   136\t\t\t\tnote(fmt.Errorf(\"the run's processes could not be listed: %w\", err))\n   137\t\t\t}\n   138\t\t\tfor _, d := range dirs {\n   139\t\t\t\tpid, err := strconv.Atoi(d.Name())\n   140\t\t\t\tif err != nil || pid == self {\n   141\t\t\t\t\tcontinue\n   142\t\t\t\t}\n   143\t\t\t\tst, err := readShimProcStat(pid)\n   144\t\t\t\tif reviewProcessGoneErr(err) {\n   145\t\t\t\t\tcontinue\n   146\t\t\t\t}\n   147\t\t\t\tif err != nil {\n   148\t\t\t\t\tchildren++\n   149\t\t\t\t\tnote(fmt.Errorf(\"process %d could not be inspected: %w\", pid, err))\n   150\t\t\t\t\tcontinue\n   151\t\t\t\t}\n   152\t\t\t\tif st.ppid != self {\n   153\t\t\t\t\tcontinue\n   154\t\t\t\t}\n   155\t\t\t\tchildren++\n   156\t\t\t\tif !st.zombie {\n   157\t\t\t\t\tif !seen[pid] {\n   158\t\t\t\t\t\tseen[pid] = true\n   159\t\t\t\t\t\tended = append(ended, strconv.Itoa(pid))\n   160\t\t\t\t\t}\n   161\t\t\t\t\tif err := killPinnedChild(pid, self); err != nil {\n   162\t\t\t\t\t\tnote(err)\n   163\t\t\t\t\t}\n   164\t\t\t\t}\n   165\t\t\t}\n   166\t\t\tfor {\n   167\t\t\t\tpid, err := unix.Wait4(-1, nil, unix.WNOHANG, nil)\n   168\t\t\t\tif pid <= 0 || err != nil {\n   169\t\t\t\t\tbreak\n   170\t\t\t\t}\n   171\t\t\t}\n   172\t\t\tif children == 0 && len(problems) == 0 {\n   173\t\t\t\treturn ended, nil\n   174\t\t\t}\n   175\t\t\tif time.Now().After(deadline) {\n   176\t\t\t\treturn ended, fmt.Errorf(\"%d process(es) of the run could not be ended: %s\", children, strings.Join(problems, \"; \"))\n   177\t\t\t}\n   178\t\t\ttime.Sleep(20 * time.Millisecond)\n   179\t\t}\n   180\t}\n   181\t\n   182\ttype shimProcStat struct {\n   183\t\tppid   int\n   184\t\tzombie bool\n   185\t}\n   186\t\n   187\tfunc readShimProcStat(pid int) (shimProcStat, error) {\n   188\t\traw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n   189\t\tif err != nil {\n   190\t\t\treturn shimProcStat{}, err\n   191\t\t}\n   192\t\ttext := string(raw)\n   193\t\tend := strings.LastIndexByte(text, ')')\n   194\t\tif end < 0 {\n   195\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   196\t\t}\n   197\t\tf := strings.Fields(text[end+1:])\n   198\t\tif len(f) < 2 {\n   199\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   200\t\t}\n   201\t\tppid, err := strconv.Atoi(f[1])\n   202\t\tif err != nil {\n   203\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   204\t\t}\n   205\t\treturn shimProcStat{ppid: ppid, zombie: f[0] == \"Z\"}, nil\n   206\t}\n   207\t\n   208\t// killPinnedChild signals pid through a pidfd while it is still a child of\n   209\t// parent: a pid reused by an unrelated process is never signalled.\n   210\tfunc killPinnedChild(pid, parent int) error {\n   211\t\tfd, err := unix.PidfdOpen(pid, 0)\n   212\t\tif errors.Is(err, unix.ESRCH) {\n   213\t\t\treturn nil\n   214\t\t}\n   215\t\tif err != nil {\n   216\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   217\t\t}\n   218\t\tdefer unix.Close(fd)\n   219\t\tst, err := readShimProcStat(pid)\n   220\t\tif reviewProcessGoneErr(err) || err == nil && st.ppid != parent {\n   221\t\t\treturn nil\n   222\t\t}\n   223\t\tif err != nil {\n   224\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   225\t\t}\n   226\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   227\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   228\t\t}\n   229\t\treturn nil\n   230\t}\n   231\t\n   232\t// parseReviewShimReport reads the report the shim wrote to its pipe.\n   233\tfunc parseReviewShimReport(raw []byte) (reviewShimReport, error) {\n   234\t\tvar r reviewShimReport\n   235\t\tif len(raw) == 0 {\n   236\t\t\treturn r, fmt.Errorf(\"the review shim left no report\")\n   237\t\t}\n   238\t\tif err := json.Unmarshal(raw, &r); err != nil {\n   239\t\t\treturn r, fmt.Errorf(\"the review shim report is unreadable: %w\", err)\n   240\t\t}\n   241\t\treturn r, nil\n   242\t}\n","exit_code":0,"status":"completed"}}
