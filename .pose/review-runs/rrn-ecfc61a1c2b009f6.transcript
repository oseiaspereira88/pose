{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'func cmdDelegateCancel|ReleaseAbandonedAttempt|confirmAbandoned|finishDelegatedReviewAttempt|prepareDelegatedReviewAttempt|publishDelegatedReviewAttempt' pose-mcp/internal/cli/delegate.go pose-mcp/internal/pose/review_dispatch.go pose-mcp/internal/pose/review_attempt_ledger.go; nl -ba pose-mcp/internal/cli/delegate.go | sed -n '620,780p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '1,240p'\"","aggregated_output":"pose-mcp/internal/pose/review_attempt_ledger.go:420:// prepareDelegatedReviewAttempt admits and builds the next reservation of\npose-mcp/internal/pose/review_attempt_ledger.go:422:func (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\npose-mcp/internal/pose/review_attempt_ledger.go:436:// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\npose-mcp/internal/pose/review_attempt_ledger.go:441:func (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\npose-mcp/internal/pose/review_attempt_ledger.go:448:func (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\npose-mcp/internal/pose/review_attempt_ledger.go:881:\ta, err := s.prepareDelegatedReviewAttempt(plan, at)\npose-mcp/internal/pose/review_attempt_ledger.go:885:\treturn a, s.publishDelegatedReviewAttempt(a)\npose-mcp/internal/pose/review_dispatch.go:716:\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\npose-mcp/internal/pose/review_dispatch.go:761:\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\npose-mcp/internal/pose/review_dispatch.go:777:\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\npose-mcp/internal/pose/review_dispatch.go:786:\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\npose-mcp/internal/cli/delegate.go:66:\tnoNetwork, record, confirmAbandoned          bool\npose-mcp/internal/cli/delegate.go:112:\t\t\t\tf.confirmAbandoned = true\npose-mcp/internal/cli/delegate.go:1112:func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\npose-mcp/internal/cli/delegate.go:1132:\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n   620\t// R6; review round 1, PG-R1-06).\n   621\tfunc delegateNoAgentWithBrief(store posemodel.Store, ref, kind, notes string, f delegateFlags, command string, stdout, stderr io.Writer) int {\n   622\t\tplan, _ := store.PlanReviewDispatch(ref, kind, notes, \"\", f.reason)\n   623\t\tbrief := plan.Brief.Text\n   624\t\tif brief == \"\" {\n   625\t\t\treturn delegateNoAgent(stdout, stderr, f.jsonOut, command)\n   626\t\t}\n   627\t\tif f.jsonOut {\n   628\t\t\tdoc := map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": strings.TrimPrefix(posemodel.ErrNoReviewerAdapter.Error(), \"pose: \"),\n   629\t\t\t\t\"brief\": brief, \"brief_digest\": plan.Brief.Digest}\n   630\t\t\tif code := posemodel.DelegationReasonCode(posemodel.ErrNoReviewerAdapter); code != \"\" {\n   631\t\t\t\tdoc[\"reason_code\"] = code\n   632\t\t\t}\n   633\t\t\thandBackRefusal(doc, 1)\n   634\t\t\twriteDelegateJSON(stdout, doc)\n   635\t\t\treturn 1\n   636\t\t}\n   637\t\tcode := delegateNoAgent(stdout, stderr, false, command)\n   638\t\tout := render(stdout, stderr)\n   639\t\tout.Hint(tr(\"The brief a reviewer would receive follows.\", \"O brief que um revisor receberia vem a seguir.\"))\n   640\t\tout.ContractLine(strings.TrimRight(brief, \"\\n\"))\n   641\t\treturn code\n   642\t}\n   643\t\n   644\tfunc delegateNoAgent(stdout, stderr io.Writer, jsonOut bool, command string) int {\n   645\t\t// The document keeps the typed refusal and no example: the example is\n   646\t\t// for a person reading the terminal (spec pose-delegation-mcp R5, R7).\n   647\t\tif jsonOut {\n   648\t\t\treturn delegateFail(stdout, stderr, true, command, 1, posemodel.ErrNoReviewerAdapter)\n   649\t\t}\n   650\t\texample, _ := posemodel.CanonicalDelegationPolicy(posemodel.ExampleDelegationPolicy())\n   651\t\terr := errors.New(tr(\"no agent is configured; add .pose/policy/delegation.json, for example:\\n\", \"nenhum agente configurado; adicione .pose/policy/delegation.json, por exemplo:\\n\") + string(example))\n   652\t\treturn delegateFail(stdout, stderr, jsonOut, command, 1, err)\n   653\t}\n   654\t\n   655\t// delegateGivenRoot checks the root a caller names: an absolute directory\n   656\t// holding a POSE instance.\n   657\tfunc delegateGivenRoot(root string) (string, error) {\n   658\t\tif !filepath.IsAbs(root) {\n   659\t\t\treturn \"\", errors.New(posemodel.DelegateRootEnv + \" must be an absolute path\")\n   660\t\t}\n   661\t\tif info, err := os.Stat(filepath.Join(root, \".pose\")); err != nil || !info.IsDir() {\n   662\t\t\treturn \"\", errors.New(posemodel.DelegateRootEnv + \" names no POSE instance\")\n   663\t\t}\n   664\t\treturn filepath.Clean(root), nil\n   665\t}\n   666\t\n   667\t// delegateTerminalHook runs the policy's on_terminal hook once the run is\n   668\t// recorded, and says so when it failed; the run's state does not change (R7).\n   669\tfunc delegateTerminalHook(store posemodel.Store, run posemodel.ReviewRun, err error, stdout, stderr io.Writer, command string) {\n   670\t\tif err != nil || run.RunID == \"\" {\n   671\t\t\treturn\n   672\t\t}\n   673\t\tif outcome := store.RunDelegationTerminalHook(run); outcome != nil && outcome.Failure != \"\" {\n   674\t\t\trender(stdout, stderr).Hint(\"pose delegate \" + command + \": on_terminal: \" + outcome.Failure)\n   675\t\t}\n   676\t}\n   677\t\n   678\t// routeSummary renders a routing decision for a person: the step chosen and\n   679\t// each agent skipped with its reason.\n   680\tfunc routeSummary(route *posemodel.DelegationRoutingRecord) string {\n   681\t\ttext := \"step=\" + route.Step\n   682\t\tif route.WaitUntil != \"\" {\n   683\t\t\ttext += \" wait_until=\" + route.WaitUntil\n   684\t\t}\n   685\t\tfor _, c := range route.Candidates {\n   686\t\t\tif c.Skipped != \"\" {\n   687\t\t\t\ttext += \"; \" + c.Agent + \" \" + tr(\"skipped\", \"ignorado\") + \": \" + c.Skipped\n   688\t\t\t}\n   689\t\t}\n   690\t\treturn text\n   691\t}\n   692\t\n   693\t// redactArgv hides the values of the credentials an agent is authorized to\n   694\t// receive, wherever a template carries them (security of R12).\n   695\tfunc redactArgv(argv []string, config posemodel.ReviewerAdapter) []string {\n   696\t\tout := append([]string(nil), argv...)\n   697\t\tif config.Containment == nil {\n   698\t\t\treturn out\n   699\t\t}\n   700\t\t// One pass, the longest value first: a credential that contains another\n   701\t\t// is replaced whole, whatever order the policy lists them in, and a\n   702\t\t// replacement is never scanned again (review round 3 of\n   703\t\t// pose-delegation-task, R3-B1).\n   704\t\tvar values []string\n   705\t\tfor _, name := range config.Containment.Credentials {\n   706\t\t\tif value := os.Getenv(name); len(value) >= 4 {\n   707\t\t\t\tvalues = append(values, value)\n   708\t\t\t}\n   709\t\t}\n   710\t\tsort.Slice(values, func(i, j int) bool { return len(values[i]) > len(values[j]) })\n   711\t\tpairs := make([]string, 0, 2*len(values))\n   712\t\tfor _, value := range values {\n   713\t\t\tpairs = append(pairs, value, \"[credential]\")\n   714\t\t}\n   715\t\tif len(pairs) == 0 {\n   716\t\t\treturn out\n   717\t\t}\n   718\t\treplacer := strings.NewReplacer(pairs...)\n   719\t\tfor i := range out {\n   720\t\t\tout[i] = replacer.Replace(out[i])\n   721\t\t}\n   722\t\treturn out\n   723\t}\n   724\t\n   725\t// delegatePrintPlan prints what a run would do (R12): agent, purpose, access,\n   726\t// working directory and argv, plus the fields of the command at hand.\n   727\tfunc delegatePrintPlan(stdout, stderr io.Writer, jsonOut bool, plan posemodel.DispatchPlan, argv []string, extra map[string]any) int {\n   728\t\tworkdir := tr(\"a disposable worktree at \", \"um worktree descartável em \") + plan.SealedCommit\n   729\t\tdoc := map[string]any{\"schema\": delegatePlanSchema, \"purpose\": plan.Purpose, \"agent\": plan.Adapter, \"vendor\": plan.Config.Vendor, \"model\": plan.Config.Model,\n   730\t\t\t\"access\": posemodel.DelegationAccessRead, \"workdir\": workdir, \"argv\": argv, \"reserves_attempt\": false}\n   731\t\tfor k, v := range extra {\n   732\t\t\tdoc[k] = v\n   733\t\t}\n   734\t\t// The containment a run would run under is disclosed before it runs, as\n   735\t\t// pose review dispatch did (spec pose-delegated-adapter-containment;\n   736\t\t// pose-delegation-parity-gate R6).\n   737\t\tsafety, _ := posemodel.ResolveReviewerContainment(plan.Config)\n   738\t\tif safety != nil {\n   739\t\t\tdoc[\"safety\"] = safety\n   740\t\t}\n   741\t\tif jsonOut {\n   742\t\t\twriteDelegateJSON(stdout, doc)\n   743\t\t\treturn 0\n   744\t\t}\n   745\t\tout := render(stdout, stderr)\n   746\t\tout.Field(\"delegate.purpose\", plan.Purpose)\n   747\t\tout.Field(\"delegate.agent\", fmt.Sprintf(\"%s (%s %s)\", plan.Adapter, plan.Config.Vendor, plan.Config.Model))\n   748\t\tout.Field(\"delegate.access\", posemodel.DelegationAccessRead)\n   749\t\tout.Field(\"delegate.workdir\", workdir)\n   750\t\traw, _ := json.Marshal(argv)\n   751\t\tout.Field(\"delegate.argv\", string(raw))\n   752\t\tif safety != nil {\n   753\t\t\traw, _ := json.Marshal(safety)\n   754\t\t\tout.Field(\"delegate.safety\", string(raw))\n   755\t\t}\n   756\t\tkeys := make([]string, 0, len(extra))\n   757\t\tfor k := range extra {\n   758\t\t\tkeys = append(keys, k)\n   759\t\t}\n   760\t\tsort.Strings(keys)\n   761\t\tfor _, k := range keys {\n   762\t\t\tif route, ok := extra[k].(*posemodel.DelegationRoutingRecord); ok {\n   763\t\t\t\tif route != nil {\n   764\t\t\t\t\tout.Field(\"delegate.routing\", routeSummary(route))\n   765\t\t\t\t}\n   766\t\t\t\tcontinue\n   767\t\t\t}\n   768\t\t\tif value := fmt.Sprint(extra[k]); value != \"\" {\n   769\t\t\t\tout.Field(\"delegate.\"+k, value)\n   770\t\t\t}\n   771\t\t}\n   772\t\tout.Field(\"delegate.dry_run\", tr(\"true (nothing reserved or claimed)\", \"true (nada reservado nem reivindicado)\"))\n   773\t\treturn 0\n   774\t}\n   775\t\n   776\tfunc delegatePrintRun(stdout, stderr io.Writer, jsonOut bool, command string, run posemodel.ReviewRun, err error, next ...delegateNextAction) int {\n   777\t\tcode := 0\n   778\t\tif err != nil || run.Status != posemodel.ReviewRunCompleted {\n   779\t\t\tcode = 1\n   780\t\t}\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"context\"\n     6\t\t\"crypto/rand\"\n     7\t\t\"encoding/hex\"\n     8\t\t\"encoding/json\"\n     9\t\t\"errors\"\n    10\t\t\"fmt\"\n    11\t\t\"io\"\n    12\t\t\"io/fs\"\n    13\t\t\"os\"\n    14\t\t\"os/exec\"\n    15\t\t\"path/filepath\"\n    16\t\t\"sort\"\n    17\t\t\"strings\"\n    18\t\t\"time\"\n    19\t)\n    20\t\n    21\tconst reviewAttemptDir = \".pose/review-attempts\"\n    22\tconst reviewRunLedgerDir = \".pose/review-run-ledger\"\n    23\tconst reviewLedgerMaxRecords = 10000\n    24\tconst reviewLedgerMaxBytes = 1 << 20\n    25\t\n    26\t// DelegatedReviewAttempt is an immutable reservation, published before any adapter starts.\n    27\t// Its ordinal path coordinates contenders; its ID binds its complete content.\n    28\ttype DelegatedReviewAttempt struct {\n    29\t\tSchemaVersion int    `json:\"schema_version\"`\n    30\t\tAttemptID     string `json:\"attempt_id\"`\n    31\t\tBundleID      string `json:\"bundle_id\"`\n    32\t\tBundleDigest  string `json:\"bundle_digest\"`\n    33\t\tScope         string `json:\"scope\"`\n    34\t\tAdapter       string `json:\"adapter\"`\n    35\t\tReason        string `json:\"reason,omitempty\"`\n    36\t\tOrdinal       int    `json:\"ordinal\"`\n    37\t\tReservedAt    string `json:\"reserved_at\"`\n    38\t\tNonce         string `json:\"nonce\"`\n    39\t}\n    40\ttype reviewAttemptReceipt struct {\n    41\t\tSchemaVersion int    `json:\"schema_version\"`\n    42\t\tAttemptID     string `json:\"attempt_id\"`\n    43\t\tRunID         string `json:\"run_id\"`\n    44\t\tRunDigest     string `json:\"run_digest\"`\n    45\t}\n    46\ttype reviewRunWitness struct {\n    47\t\tSchemaVersion    int    `json:\"schema_version\"`\n    48\t\tRunID            string `json:\"run_id\"`\n    49\t\tBundleID         string `json:\"bundle_id\"`\n    50\t\tScope            string `json:\"scope\"`\n    51\t\tRecordDigest     string `json:\"record_digest\"`\n    52\t\tTranscriptDigest string `json:\"transcript_digest\"`\n    53\t}\n    54\t\n    55\tfunc reviewAttemptKey(bundle string) string {\n    56\t\treturn strings.TrimPrefix(digestBytes([]byte(bundle)), \"sha256:\")[:24]\n    57\t}\n    58\tfunc reviewAttemptPath(root string, a DelegatedReviewAttempt) string {\n    59\t\treturn filepath.Join(root, reviewAttemptDir, reviewAttemptKey(a.BundleID), fmt.Sprintf(\"%06d.json\", a.Ordinal))\n    60\t}\n    61\tfunc attemptReceiptPath(root string, a DelegatedReviewAttempt) string {\n    62\t\treturn strings.TrimSuffix(reviewAttemptPath(root, a), \".json\") + \".result.json\"\n    63\t}\n    64\tfunc attemptIdentity(a DelegatedReviewAttempt) string {\n    65\t\ta.AttemptID = \"\"\n    66\t\traw, _ := json.Marshal(a)\n    67\t\treturn \"rat-\" + strings.TrimPrefix(digestBytes(raw), \"sha256:\")\n    68\t}\n    69\t\n    70\tfunc readLedgerRaw(path string) ([]byte, error) {\n    71\t\treturn readBoundedRegular(path, reviewLedgerMaxBytes)\n    72\t}\n    73\t\n    74\t// readBoundedRegular reads a regular file of at most limit bytes, refusing a\n    75\t// link or a file replaced while it was opened.\n    76\tfunc readBoundedRegular(path string, limit int64) ([]byte, error) {\n    77\t\tinfo, err := os.Lstat(path)\n    78\t\tif err != nil {\n    79\t\t\treturn nil, err\n    80\t\t}\n    81\t\tif !info.Mode().IsRegular() || info.Size() > limit {\n    82\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n    83\t\t}\n    84\t\tf, err := os.Open(path)\n    85\t\tif err != nil {\n    86\t\t\treturn nil, err\n    87\t\t}\n    88\t\topened, statErr := f.Stat()\n    89\t\tif statErr != nil || !opened.Mode().IsRegular() || !os.SameFile(info, opened) {\n    90\t\t\tf.Close()\n    91\t\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n    92\t\t}\n    93\t\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n    94\t\tcloseErr := f.Close()\n    95\t\tif err != nil {\n    96\t\t\treturn nil, err\n    97\t\t}\n    98\t\tif closeErr != nil {\n    99\t\t\treturn nil, closeErr\n   100\t\t}\n   101\t\tif int64(len(raw)) > limit {\n   102\t\t\treturn nil, fmt.Errorf(\"ledger record exceeds bound\")\n   103\t\t}\n   104\t\treturn raw, nil\n   105\t}\n   106\t\n   107\t// readBoundedRegularIn is the operation-Files form of readBoundedRegular. It\n   108\t// keeps the same regular-file and replacement checks while making the bytes\n   109\t// part of an active governance read view.\n   110\tfunc readBoundedRegularIn(files Files, path string, limit int64) ([]byte, error) {\n   111\t\tfiles = FilesOrNative(files)\n   112\t\tinfo, err := files.Lstat(path)\n   113\t\tif err != nil {\n   114\t\t\treturn nil, err\n   115\t\t}\n   116\t\tif !info.Mode().IsRegular() || limit < 0 || info.Size() < 0 || info.Size() > limit {\n   117\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n   118\t\t}\n   119\t\tf, err := files.Open(path)\n   120\t\tif err != nil {\n   121\t\t\treturn nil, err\n   122\t\t}\n   123\t\topened, statErr := f.Stat()\n   124\t\tif statErr != nil || !opened.Mode().IsRegular() || !sameObservedFile(info, opened) {\n   125\t\t\t_ = f.Close()\n   126\t\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n   127\t\t}\n   128\t\traw, readErr := readLimited(f, limit)\n   129\t\tcloseErr := f.Close()\n   130\t\tif readErr != nil {\n   131\t\t\treturn nil, readErr\n   132\t\t}\n   133\t\tif closeErr != nil {\n   134\t\t\treturn nil, closeErr\n   135\t\t}\n   136\t\treturn raw, nil\n   137\t}\n   138\t\n   139\tvar errReviewLedgerBudget = errors.New(\"review ledger exceeds 32 MiB inventory read budget\")\n   140\t\n   141\tfunc readLedgerRawBudget(path string, remaining *int64) ([]byte, error) {\n   142\t\tinfo, err := os.Lstat(path)\n   143\t\tif err != nil {\n   144\t\t\treturn nil, err\n   145\t\t}\n   146\t\tif info.Size() < 0 || info.Size() > *remaining {\n   147\t\t\treturn nil, errReviewLedgerBudget\n   148\t\t}\n   149\t\t*remaining -= info.Size()\n   150\t\traw, err := readLedgerRaw(path)\n   151\t\tif err != nil {\n   152\t\t\treturn nil, err\n   153\t\t}\n   154\t\tif extra := int64(len(raw)) - info.Size(); extra > 0 {\n   155\t\t\t*remaining -= extra\n   156\t\t\tif *remaining < 0 {\n   157\t\t\t\treturn nil, errReviewLedgerBudget\n   158\t\t\t}\n   159\t\t}\n   160\t\treturn raw, nil\n   161\t}\n   162\t\n   163\tfunc readLedgerRawBudgetIn(files Files, path string, remaining *int64) ([]byte, error) {\n   164\t\tfiles = FilesOrNative(files)\n   165\t\tinfo, err := files.Lstat(path)\n   166\t\tif err != nil {\n   167\t\t\treturn nil, err\n   168\t\t}\n   169\t\tif info.Size() < 0 || info.Size() > *remaining {\n   170\t\t\treturn nil, errReviewLedgerBudget\n   171\t\t}\n   172\t\t*remaining -= info.Size()\n   173\t\traw, err := readBoundedRegularIn(files, path, reviewLedgerMaxBytes)\n   174\t\tif err != nil {\n   175\t\t\treturn nil, err\n   176\t\t}\n   177\t\tif extra := int64(len(raw)) - info.Size(); extra > 0 {\n   178\t\t\t*remaining -= extra\n   179\t\t\tif *remaining < 0 {\n   180\t\t\t\treturn nil, errReviewLedgerBudget\n   181\t\t\t}\n   182\t\t}\n   183\t\treturn raw, nil\n   184\t}\n   185\tfunc readLedgerJSONBudget(path string, v any, remaining *int64) error {\n   186\t\traw, err := readLedgerRawBudget(path, remaining)\n   187\t\tif err != nil {\n   188\t\t\treturn err\n   189\t\t}\n   190\t\treturn strictJSONBytes(raw, v)\n   191\t}\n   192\t\n   193\tfunc readLedgerJSONBudgetIn(files Files, path string, v any, remaining *int64) error {\n   194\t\traw, err := readLedgerRawBudgetIn(files, path, remaining)\n   195\t\tif err != nil {\n   196\t\t\treturn err\n   197\t\t}\n   198\t\treturn strictJSONBytes(raw, v)\n   199\t}\n   200\tfunc reviewReadBudget(provided []*int64) *int64 {\n   201\t\tif len(provided) > 0 {\n   202\t\t\treturn provided[0]\n   203\t\t}\n   204\t\tbudget := int64(32 << 20)\n   205\t\treturn &budget\n   206\t}\n   207\t\n   208\tfunc readLedgerJSON(path string, v any) error {\n   209\t\traw, err := readLedgerRaw(path)\n   210\t\tif err != nil {\n   211\t\t\treturn err\n   212\t\t}\n   213\t\tif err := strictJSONBytes(raw, v); err != nil {\n   214\t\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n   215\t\t}\n   216\t\treturn nil\n   217\t}\n   218\t\n   219\tfunc readLedgerJSONIn(files Files, path string, v any) error {\n   220\t\traw, err := readBoundedRegularIn(files, path, reviewLedgerMaxBytes)\n   221\t\tif err != nil {\n   222\t\t\treturn err\n   223\t\t}\n   224\t\tif err := strictJSONBytes(raw, v); err != nil {\n   225\t\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n   226\t\t}\n   227\t\treturn nil\n   228\t}\n   229\t\n   230\tfunc ledgerEntries(root, rel string) ([]os.DirEntry, error) {\n   231\t\tpath, err := ensureReviewArtifactDir(root, rel, false)\n   232\t\tif os.IsNotExist(err) {\n   233\t\t\treturn nil, nil\n   234\t\t}\n   235\t\tif err != nil {\n   236\t\t\treturn nil, err\n   237\t\t}\n   238\t\tf, err := os.Open(path)\n   239\t\tif err != nil {\n   240\t\t\treturn nil, err\n","exit_code":0,"status":"completed"}}
