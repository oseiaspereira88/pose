{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_reap_linux.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Leftover reviewer processes (spec\n     6\t// pose-review-run-reaps-lingering-reviewer-processes R1): an adapter such as\n     7\t// `codex exec` runs each command in a session of its own, so killing the\n     8\t// adapter's process group misses a command the reviewer left running, and\n     9\t// that command keeps writing into the run's runtime directory while the\n    10\t// cleanup inventory reads it. Every process of the run inherits\n    11\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n    12\t// that entry, ends them and waits for them before the inventory.\n    13\t//\n    14\t// Each process is pinned by a pidfd before it is signalled, and its\n    15\t// environment is read again through the pinned process, so a pid reused by\n    16\t// an unrelated process between the scan and the signal is never killed\n    17\t// (review round 1, N3). A scan that cannot list or read the state of the\n    18\t// processes fails. A process of this user whose environment cannot be read\n    19\t// (one that made itself non-inspectable) cannot be matched: one that already\n    20\t// existed before the adapter started is not the run's and is skipped; any\n    21\t// other may be the run's, so the scan fails and the run stays unconcludable\n    22\t// (review round 2, N2).\n    23\t\n    24\timport (\n    25\t\t\"bytes\"\n    26\t\t\"errors\"\n    27\t\t\"fmt\"\n    28\t\t\"io/fs\"\n    29\t\t\"os\"\n    30\t\t\"path/filepath\"\n    31\t\t\"strconv\"\n    32\t\t\"strings\"\n    33\t\t\"syscall\"\n    34\t\t\"time\"\n    35\t\n    36\t\t\"golang.org/x/sys/unix\"\n    37\t)\n    38\t\n    39\t// reapSealedCheckoutProcesses ends every process whose environment names\n    40\t// worktree as its sealed checkout and returns a description of each. An\n    41\t// error means the run's processes could not be proven ended within the bound.\n    42\tfunc reapSealedCheckoutProcesses(worktree string, baseline map[int]string) ([]string, int, error) {\n    43\t\tif worktree == \"\" {\n    44\t\t\treturn nil, 0, nil\n    45\t\t}\n    46\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n    47\t\tvar reaped []string\n    48\t\tseen := map[int]bool{}\n    49\t\tdeadline := time.Now().Add(reviewReapWait)\n    50\t\tunreadable := 0\n    51\t\tfor {\n    52\t\t\talive, opaque, err := reviewMarkedProcesses(entry)\n    53\t\t\tif err != nil {\n    54\t\t\t\treturn reaped, unreadable, err\n    55\t\t\t}\n    56\t\t\tunreadable = 0\n    57\t\t\tfor pid, start := range opaque {\n    58\t\t\t\tif prior, ok := baseline[pid]; !ok || prior != start {\n    59\t\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"process %d of this user started during the run and cannot be inspected; it may be the run's and was not ended\", pid)\n    60\t\t\t\t}\n    61\t\t\t\tunreadable++\n    62\t\t\t}\n    63\t\t\tfor _, pid := range alive {\n    64\t\t\t\tif !seen[pid] {\n    65\t\t\t\t\tseen[pid] = true\n    66\t\t\t\t\t// Only the pid: the name is the reviewer's to choose and is not\n    67\t\t\t\t\t// recorded (review round 7, N4).\n    68\t\t\t\t\treaped = append(reaped, strconv.Itoa(pid))\n    69\t\t\t\t}\n    70\t\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n    71\t\t\t\t\treturn reaped, unreadable, err\n    72\t\t\t\t}\n    73\t\t\t}\n    74\t\t\tif len(alive) == 0 {\n    75\t\t\t\treturn reaped, unreadable, nil\n    76\t\t\t}\n    77\t\t\tif time.Now().After(deadline) {\n    78\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n    79\t\t\t}\n    80\t\t\ttime.Sleep(50 * time.Millisecond)\n    81\t\t}\n    82\t}\n    83\t\n    84\t// reviewMarkedProcesses lists the live processes whose environment holds\n    85\t// entry, and counts this user's processes whose environment could not be\n    86\t// read. A process that is gone is skipped.\n    87\tfunc reviewMarkedProcesses(entry []byte) ([]int, map[int]string, error) {\n    88\t\tdirs, err := os.ReadDir(\"/proc\")\n    89\t\tif err != nil {\n    90\t\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    91\t\t}\n    92\t\tunreadable := map[int]string{}\n    93\t\tself, uid := os.Getpid(), os.Getuid()\n    94\t\tvar out []int\n    95\t\tfor _, d := range dirs {\n    96\t\t\tpid, err := strconv.Atoi(d.Name())\n    97\t\t\tif err != nil || pid == self {\n    98\t\t\t\tcontinue\n    99\t\t\t}\n   100\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n   101\t\t\tswitch {\n   102\t\t\tcase reviewProcessGoneErr(err):\n   103\t\t\t\tcontinue\n   104\t\t\tcase err != nil:\n   105\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n   106\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n   107\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   108\t\t\t\t\tcontinue\n   109\t\t\t\t}\n   110\t\t\t\tstart, serr := processStartTime(pid)\n   111\t\t\t\tif reviewProcessGoneErr(serr) {\n   112\t\t\t\t\tcontinue\n   113\t\t\t\t}\n   114\t\t\t\tif serr != nil || start == \"\" {\n   115\t\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d start could not be read: %v\", pid, serr)\n   116\t\t\t\t}\n   117\t\t\t\tunreadable[pid] = start\n   118\t\t\t\tcontinue\n   119\t\t\tcase !marked:\n   120\t\t\t\tcontinue\n   121\t\t\t}\n   122\t\t\tzombie, err := reviewProcessZombie(pid)\n   123\t\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n   124\t\t\t\tcontinue\n   125\t\t\t}\n   126\t\t\tif err != nil {\n   127\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n   128\t\t\t}\n   129\t\t\tout = append(out, pid)\n   130\t\t}\n   131\t\treturn out, unreadable, nil\n   132\t}\n   133\t\n   134\t// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n   135\t// after the environment read through that same pinned process still holds\n   136\t// entry.\n   137\tfunc killPinnedMarkedProcess(pid int, entry []byte) error {\n   138\t\tfd, err := unix.PidfdOpen(pid, 0)\n   139\t\tif errors.Is(err, unix.ESRCH) {\n   140\t\t\treturn nil\n   141\t\t}\n   142\t\tif err != nil {\n   143\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   144\t\t}\n   145\t\tdefer unix.Close(fd)\n   146\t\t// The pidfd names one process for its lifetime; if pid was reused before\n   147\t\t// it was opened, the new process does not carry this run's entry.\n   148\t\tmarked, err := reviewProcessMarked(pid, entry)\n   149\t\tif reviewProcessGoneErr(err) || err == nil && !marked {\n   150\t\t\treturn nil\n   151\t\t}\n   152\t\tif err != nil {\n   153\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   154\t\t}\n   155\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   156\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   157\t\t}\n   158\t\treturn nil\n   159\t}\n   160\t\n   161\tfunc reviewProcessMarked(pid int, entry []byte) (bool, error) {\n   162\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   163\t\tif err != nil {\n   164\t\t\treturn false, err\n   165\t\t}\n   166\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n   167\t\t\tif bytes.Equal(kv, entry) {\n   168\t\t\t\treturn true, nil\n   169\t\t\t}\n   170\t\t}\n   171\t\treturn false, nil\n   172\t}\n   173\t\n   174\tfunc reviewProcessOwner(pid int) (int, error) {\n   175\t\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n   176\t\tif err != nil {\n   177\t\t\treturn 0, err\n   178\t\t}\n   179\t\tst, ok := info.Sys().(*syscall.Stat_t)\n   180\t\tif !ok {\n   181\t\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n   182\t\t}\n   183\t\treturn int(st.Uid), nil\n   184\t}\n   185\t\n   186\tfunc reviewProcessGoneErr(err error) bool {\n   187\t\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n   188\t}\n   189\t\n   190\tfunc reviewProcessName(pid int) string {\n   191\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n   192\t\tif err != nil {\n   193\t\t\treturn \"?\"\n   194\t\t}\n   195\t\treturn strings.TrimSpace(string(raw))\n   196\t}\n   197\t\n   198\tfunc reviewProcessZombie(pid int) (bool, error) {\n   199\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n   200\t\tif err != nil {\n   201\t\t\treturn false, err\n   202\t\t}\n   203\t\t// The state follows the parenthesised command name.\n   204\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   205\t\t\treturn raw[i+2] == 'Z', nil\n   206\t\t}\n   207\t\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n   208\t}\n   209\t\n   210\t// reviewOpaqueProcessBaseline records, before the adapter starts, the\n   211\t// processes of this user whose environment cannot be read, by pid and start\n   212\t// time: they cannot be the run's.\n   213\tfunc reviewOpaqueProcessBaseline() map[int]string {\n   214\t\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv + \"=\\x00\"))\n   215\t\treturn opaque\n   216\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_shim.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"encoding/json\"\n     5\t\t\"time\"\n     6\t)\n     7\t\n     8\t// The review run shim (spec pose-review-run-reaps-lingering-reviewer-processes,\n     9\t// review rounds 6 and 8): a descendant of the reviewer that leaves the\n    10\t// adapter's process group, starts its own session and clears its environment\n    11\t// matches neither the group kill nor the sealed-checkout entry. Making the\n    12\t// dispatcher a child subreaper caught it, but a subreaper is process-wide:\n    13\t// in the dispatching process it also adopted and ended children other code\n    14\t// started there (a detached delegation), and reaped processes another\n    15\t// goroutine was waiting for. The dispatcher therefore starts the adapter\n    16\t// through a shim, the same executable re-entered with ReviewShimArg, which\n    17\t// makes itself the subreaper, runs the adapter, and, once it exits, ends\n    18\t// every process left in its subtree. The shim has no other children, so\n    19\t// everything it adopts is the run's. A timeout asks the shim to stop with\n    20\t// SIGTERM, and the death of the dispatcher delivers it the same signal: in\n    21\t// both cases it ends the subtree before it exits (review round 8, N3, N4).\n    22\t\n    23\t// reviewReapWait bounds how long ending the run's leftover processes takes.\n    24\tconst reviewReapWait = 5 * time.Second\n    25\t\n    26\t// ReviewShimArg is the first argument that runs the executable as a review\n    27\t// run shim instead of the CLI.\n    28\tconst ReviewShimArg = \"__pose-review-run-shim\"\n    29\t\n    30\t// ReviewShimReportEnv tells the shim that the dispatcher passed it a report\n    31\t// pipe as file descriptor 3, and names the dispatcher's pid. The report never\n    32\t// goes to a path the reviewer can write (review round 8, N2).\n    33\tconst ReviewShimReportEnv = \"POSE_REVIEW_SHIM_REPORT\"\n    34\t\n    35\t// ReviewShimAvailable says the running executable handles ReviewShimArg. It\n    36\t// is set by the pose command and by the test binaries that dispatch; any\n    37\t// other embedder starts the adapter directly, without the shim.\n    38\tvar ReviewShimAvailable = false\n    39\t\n    40\t// reviewShimReport is what the shim found after the adapter exited.\n    41\ttype reviewShimReport struct {\n    42\t\tEnded      []string `json:\"ended\"`\n    43\t\tEndedTotal int      `json:\"ended_total\"`\n    44\t\tError      string   `json:\"error,omitempty\"`\n    45\t}\n    46\t\n    47\t// reviewShimReportMaxPids bounds the pids a report lists; EndedTotal counts\n    48\t// them all. A full report stays far below the dispatcher's read bound.\n    49\tconst reviewShimReportMaxPids = 1000\n    50\t\n    51\t// boundedReviewShimReport encodes r within the dispatcher's read bound, so\n    52\t// the dispatcher always reads it whole (review round 9, N2).\n    53\tfunc boundedReviewShimReport(r reviewShimReport) []byte {\n    54\t\tr.EndedTotal = len(r.Ended)\n    55\t\tif len(r.Ended) > reviewShimReportMaxPids {\n    56\t\t\tr.Ended = r.Ended[:reviewShimReportMaxPids]\n    57\t\t}\n    58\t\tif len(r.Error) > 4096 {\n    59\t\t\tr.Error = r.Error[:4096]\n    60\t\t}\n    61\t\traw, _ := json.Marshal(r)\n    62\t\treturn raw\n    63\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/delegation_list.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Listing and naming delegated runs (spec pose-delegation-surface R11, and the\n     4\t// listing pose-delegated-review-completion-signal extends).\n     5\t//\n     6\t// A person and an agent follow a task, not a process: an attempt and its\n     7\t// continuations are one row, shown by their latest run. A reference names a\n     8\t// row by attempt, by any of its runs, by label or by a prefix of its session.\n     9\t\n    10\timport (\n    11\t\t\"fmt\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t)\n    16\t\n    17\t// DelegationAttempt is one attempt and its continuations.\n    18\ttype DelegationAttempt struct {\n    19\t\tAttemptID    string              `json:\"attempt_id\"`\n    20\t\tRuns         []string            `json:\"runs\"`\n    21\t\tLatestRun    string              `json:\"latest_run,omitempty\"`\n    22\t\tState        string              `json:\"state\"`\n    23\t\tPurpose      string              `json:\"purpose\"`\n    24\t\tAgent        string              `json:\"agent\"`\n    25\t\tVendor       string              `json:\"vendor,omitempty\"`\n    26\t\tModel        string              `json:\"model,omitempty\"`\n    27\t\tLabel        string              `json:\"label,omitempty\"`\n    28\t\tLead         string              `json:\"lead,omitempty\"`\n    29\t\tAccess       string              `json:\"access\"`\n    30\t\tScope        string              `json:\"scope\"`\n    31\t\tBundleID     string              `json:\"bundle_id\"`\n    32\t\tStartedAt    string              `json:\"started_at\"`\n    33\t\tEndedAt      string              `json:\"ended_at,omitempty\"`\n    34\t\tTurns        int                 `json:\"turns\"`\n    35\t\tLastStep     string              `json:\"last_step,omitempty\"`\n    36\t\tFailure      string              `json:\"failure,omitempty\"`\n    37\t\tInterruption *ReviewInterruption `json:\"interruption,omitempty\"`\n    38\t\t// Partial says an interrupted run kept a partial draft; TimeLeft is the\n    39\t\t// wait until its recorded reset, when there is one.\n    40\t\tPartial         bool   `json:\"partial,omitempty\"`\n    41\t\tTimeLeft        string `json:\"time_left,omitempty\"`\n    42\t\tActive          bool   `json:\"active\"`\n    43\t\tLiveness        string `json:\"liveness,omitempty\"`\n    44\t\tCancelRequested bool   `json:\"cancel_requested,omitempty\"`\n    45\t\t// HeartbeatAge is how long ago the running process last beat; a stalled\n    46\t\t// run is not active (spec pose-delegated-review-completion-signal R4, R6).\n    47\t\tHeartbeatAge string `json:\"heartbeat_age,omitempty\"`\n    48\t\tStalledAt    string `json:\"stalled_at,omitempty\"`\n    49\t\t// HookFailure is why the latest run's on_terminal hook failed (R7).\n    50\t\tHookFailure string `json:\"hook_failure,omitempty\"`\n    51\t\t// Round is the review round of the scope the latest run reviewed (spec\n    52\t\t// pose-delegated-review-round-protocol R1).\n    53\t\tRound    int `json:\"round,omitempty\"`\n    54\t\tsessions []string\n    55\t\tlatest   *ReviewRun\n    56\t}\n    57\t\n    58\t// Latest is the latest recorded run of the attempt, if any.\n    59\tfunc (a DelegationAttempt) Latest() *ReviewRun { return a.latest }\n    60\t\n    61\t// DelegationRunning is the state of an attempt whose process is still there;\n    62\t// DelegationStalled, of one whose process is gone without a record.\n    63\tconst (\n    64\t\tDelegationRunning = \"running\"\n    65\t\tDelegationStalled = \"stalled\"\n    66\t\t// DelegationAbandonedCause is the failure of a stalled attempt whose\n    67\t\t// dispatch ended before recording its run.\n    68\t\tDelegationAbandonedCause = \"abandoned: the dispatching process ended before the run was recorded\"\n    69\t)\n    70\t\n    71\t// ListDelegationAttempts groups every recorded run by attempt, adds the runs\n    72\t// in progress, and returns the losses the run history reports.\n    73\tfunc (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n    74\t\t// The markers are read before the runs: a run publishes its record before\n    75\t\t// it removes its marker, so a reader that finds no marker for an attempt\n    76\t\t// it saw running finds its record (spec\n    77\t\t// pose-delegated-review-completion-signal R5).\n    78\t\tactive, activeLost, activeErr := s.ListDelegationActive()\n    79\t\truns, lost, err := s.ReadReviewRuns(\"\")\n    80\t\tif err != nil {\n    81\t\t\treturn nil, nil, err\n    82\t\t}\n    83\t\t// Task runs share the lifecycle, never the review history (spec\n    84\t\t// pose-delegation-task R7, R8).\n    85\t\ttasks, taskLost := s.ReadDelegationTaskRuns()\n    86\t\truns, lost = append(runs, tasks...), append(lost, taskLost...)\n    87\t\tbyAttempt := map[string]*DelegationAttempt{}\n    88\t\torder := []string{}\n    89\t\tfor i := range runs {\n    90\t\t\trun := runs[i]\n    91\t\t\tkey := run.AttemptID\n    92\t\t\tif key == \"\" {\n    93\t\t\t\tkey = run.RunID // a run recorded before attempts existed is its own attempt\n    94\t\t\t}\n    95\t\t\trow, ok := byAttempt[key]\n    96\t\t\tif !ok {\n    97\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    98\t\t\t\tbyAttempt[key] = row\n    99\t\t\t\torder = append(order, key)\n   100\t\t\t}\n   101\t\t\trow.Runs = append(row.Runs, run.RunID)\n   102\t\t\trow.latest = &runs[i]\n   103\t\t\tif run.SessionDigest != \"\" {\n   104\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   105\t\t\t\t\trow.sessions = append(row.sessions, value)\n   106\t\t\t\t}\n   107\t\t\t}\n   108\t\t\tevents, err := s.ReadDelegationEvents(run)\n   109\t\t\tif err != nil {\n   110\t\t\t\t// A turn count read from nothing would report a whole history.\n   111\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   112\t\t\t} else {\n   113\t\t\t\tfor _, e := range events {\n   114\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   115\t\t\t\t\t\trow.Turns++\n   116\t\t\t\t\t}\n   117\t\t\t\t}\n   118\t\t\t\tif len(events) > 0 {\n   119\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   120\t\t\t\t}\n   121\t\t\t}\n   122\t\t}\n   123\t\tfor _, key := range order {\n   124\t\t\trow := byAttempt[key]\n   125\t\t\tlatest := row.latest\n   126\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   127\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   128\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   129\t\t\tif latest.Access != \"\" {\n   130\t\t\t\trow.Access = latest.Access\n   131\t\t\t}\n   132\t\t\trow.Round = latest.Round\n   133\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   134\t\t\t\trow.HookFailure = hook.Failure\n   135\t\t\t}\n   136\t\t\tif row.Purpose == \"\" {\n   137\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   138\t\t\t}\n   139\t\t\tif latest.Status == ReviewRunInterrupted {\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n   206\t\tfor _, key := range order {\n   207\t\t\tout = append(out, *byAttempt[key])\n   208\t\t}\n   209\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   210\t\treturn out, lost, nil\n   211\t}\n   212\t\n   213\tfunc delegationStepText(e DelegationEvent) string {\n   214\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   215\t\tif len(text) > 80 {\n   216\t\t\tcut := 77\n   217\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   218\t\t\t\tcut--\n   219\t\t\t}\n   220\t\t\ttext = text[:cut] + \"...\"\n   221\t\t}\n   222\t\tswitch e.Kind {\n   223\t\tcase DelegationEventToolCall:\n   224\t\t\treturn \"▶ \" + text\n   225\t\tcase DelegationEventToolOutput:\n   226\t\t\tif e.ExitCode != nil && *e.ExitCode != 0 {\n   227\t\t\t\treturn fmt.Sprintf(\"✗ exit %d\", *e.ExitCode)\n   228\t\t\t}\n   229\t\t\treturn \"✓ exit 0\"\n   230\t\tcase DelegationEventTurn:\n   231\t\t\treturn \"turn\"\n   232\t\t}\n   233\t\tif text == \"\" {\n   234\t\t\treturn e.Kind\n   235\t\t}\n   236\t\treturn e.Kind + \": \" + text\n   237\t}\n   238\t\n   239\t// ErrDelegationRefAmbiguous carries the candidates of an ambiguous reference.\n   240\t// Neither reference error carries the reference: it may be a session, which\n   241\t// no output names.\n   242\ttype ErrDelegationRefAmbiguous struct {\n   243\t\tCandidates []string\n   244\t}\n   245\t\n   246\tfunc (e *ErrDelegationRefAmbiguous) Error() string {\n   247\t\treturn \"pose: the reference names more than one delegated run: \" + strings.Join(e.Candidates, \", \")\n   248\t}\n   249\t\n   250\t// ErrDelegationRefUnknown means no attempt matches.\n   251\ttype ErrDelegationRefUnknown struct{}\n   252\t\n   253\tfunc (e *ErrDelegationRefUnknown) Error() string {\n   254\t\treturn \"pose: no delegated run matches the reference (a run id, an attempt id, a label or a session prefix of six characters or more)\"\n   255\t}\n   256\t\n   257\t// ResolveDelegationRef finds the one attempt ref names (R11).\n   258\tfunc ResolveDelegationRef(attempts []DelegationAttempt, ref string) (DelegationAttempt, error) {\n   259\t\tref = strings.TrimSpace(ref)\n   260\t\tif ref == \"\" {\n   261\t\t\treturn DelegationAttempt{}, &ErrDelegationRefUnknown{}\n   262\t\t}\n   263\t\t// An identifier is exact and wins over a label or a session prefix.\n   264\t\tfor _, a := range attempts {\n   265\t\t\tif a.AttemptID == ref || containsString(a.Runs, ref) {\n   266\t\t\t\treturn a, nil\n   267\t\t\t}\n   268\t\t}\n   269\t\tvar matched []DelegationAttempt\n   270\t\tfor _, a := range attempts {\n   271\t\t\thit := a.Label == ref\n   272\t\t\tif !hit && len(ref) >= 6 {\n   273\t\t\t\tfor _, session := range a.sessions {\n   274\t\t\t\t\tif strings.HasPrefix(session, ref) {\n   275\t\t\t\t\t\thit = true\n   276\t\t\t\t\t}\n   277\t\t\t\t}\n   278\t\t\t}\n   279\t\t\tif hit {\n   280\t\t\t\tmatched = append(matched, a)\n   281\t\t\t}\n   282\t\t}\n   283\t\tswitch len(matched) {\n   284\t\tcase 0:\n   285\t\t\treturn DelegationAttempt{}, &ErrDelegationRefUnknown{}\n   286\t\tcase 1:\n   287\t\t\treturn matched[0], nil\n   288\t\t}\n   289\t\tcandidates := make([]string, 0, len(matched))\n   290\t\tfor _, a := range matched {\n   291\t\t\tname := a.AttemptID\n   292\t\t\tif a.Label != \"\" {\n   293\t\t\t\tname += \" (\" + a.Label + \", \" + a.State + \")\"\n   294\t\t\t}\n   295\t\t\tcandidates = append(candidates, name)\n   296\t\t}\n   297\t\treturn DelegationAttempt{}, &ErrDelegationRefAmbiguous{Candidates: candidates}\n   298\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/delegation_release.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"os\"\n    28\t\t\"path/filepath\"\n    29\t\t\"strings\"\n    30\t\t\"time\"\n    31\t)\n    32\t\n    33\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    34\t// proven abandoned.\n    35\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    36\t\n    37\t// reviewOrphanReservationAge is how old a reservation without any marker\n    38\t// must be to count as abandoned.\n    39\tconst reviewOrphanReservationAge = 10 * time.Minute\n    40\t\n    41\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    42\t// dispatch ended before recording it, and removes its stalled marker. A\n    43\t// stalled marker whose reservation was never published is only removed; the\n    44\t// returned run is then empty.\n    45\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    46\t\tif !validAttemptFileName(attemptID) {\n    47\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    48\t\t}\n    49\t\tmarkers, _, err := s.ListDelegationActive()\n    50\t\tif err != nil {\n    51\t\t\treturn ReviewRun{}, err\n    52\t\t}\n    53\t\tvar marker *DelegationActiveRun\n    54\t\tfor i := range markers {\n    55\t\t\tif markers[i].AttemptID == attemptID {\n    56\t\t\t\tmarker = &markers[i]\n    57\t\t\t}\n    58\t\t}\n    59\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    60\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    61\t\t}\n    62\t\tdir, err := s.delegationActiveDir(true)\n    63\t\tif err != nil {\n    64\t\t\treturn ReviewRun{}, err\n    65\t\t}\n    66\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    67\t\tif err != nil {\n    68\t\t\treturn ReviewRun{}, err\n    69\t\t}\n    70\t\tdefer lock.Close()\n    71\t\tunlock, err := lockSpecTransferFile(lock)\n    72\t\tif err != nil {\n    73\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    74\t\t}\n    75\t\tdefer unlock()\n    76\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    77\t}\n    78\t\n    79\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    80\t\tvar reserved *DelegatedReviewAttempt\n    81\t\tif marker != nil {\n    82\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    83\t\t\tif err != nil {\n    84\t\t\t\treturn ReviewRun{}, err\n    85\t\t\t}\n    86\t\t\tfor i := range attempts {\n    87\t\t\t\tif attempts[i].AttemptID == attemptID {\n    88\t\t\t\t\treserved = &attempts[i]\n    89\t\t\t\t}\n    90\t\t\t}\n    91\t\t\tif reserved == nil {\n    92\t\t\t\t// The dispatch ended between its marker and its reservation:\n    93\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    94\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    95\t\t\t}\n    96\t\t} else {\n    97\t\t\tif !operatorConfirmed {\n    98\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n    99\t\t\t}\n   100\t\t\torphans, _, err := s.orphanReservations(now)\n   101\t\t\tif err != nil {\n   102\t\t\t\treturn ReviewRun{}, err\n   103\t\t\t}\n   104\t\t\tfor i := range orphans {\n   105\t\t\t\tif orphans[i].AttemptID == attemptID {\n   106\t\t\t\t\treserved = &orphans[i]\n   107\t\t\t\t}\n   108\t\t\t}\n   109\t\t\tif reserved == nil {\n   110\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   111\t\t\t}\n   112\t\t}\n   113\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   114\t\t\t// A release that stopped after the receipt completes by removing\n   115\t\t\t// the stalled marker; with no marker there is nothing to release.\n   116\t\t\tif marker != nil {\n   117\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   118\t\t\t\tif err != nil {\n   119\t\t\t\t\treturn ReviewRun{}, err\n   120\t\t\t\t}\n   121\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   122\t\t\t\tif err != nil {\n   123\t\t\t\t\treturn ReviewRun{}, err\n   124\t\t\t\t}\n   125\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   126\t\t\t}\n   127\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   128\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   129\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   130\t\t}\n   131\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   132\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   133\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   134\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   135\t\tif marker != nil {\n   136\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   137\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   138\t\t} else {\n   139\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   140\t\t}\n   141\t\t// A run the attempt already recorded, by its dispatch or by a release\n   142\t\t// interrupted before the receipt, completes the attempt; no second run\n   143\t\t// is written for it.\n   144\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   145\t\tif err != nil {\n   146\t\t\treturn ReviewRun{}, err\n   147\t\t}\n   148\t\tif !found {\n   149\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   150\t\t\t\treturn ReviewRun{}, err\n   151\t\t\t}\n   152\t\t}\n   153\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   154\t\t\treturn recorded, err\n   155\t\t}\n   156\t\tif marker != nil {\n   157\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   158\t\t}\n   159\t\treturn recorded, nil\n   160\t}\n   161\t\n   162\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   163\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   164\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   165\t\tif err != nil {\n   166\t\t\treturn ReviewRun{}, false, err\n   167\t\t}\n   168\t\tif len(lost) > 0 {\n   169\t\t\t// An unreadable run may be this release's: the history is unknown,\n   170\t\t\t// and the release does not write another (review round 4, N3).\n   171\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   172\t\t}\n   173\t\tvar latest *ReviewRun\n   174\t\tfor i := range runs {\n   175\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   176\t\t\t\tlatest = &runs[i]\n   177\t\t\t}\n   178\t\t}\n   179\t\tif latest == nil {\n   180\t\t\treturn ReviewRun{}, false, nil\n   181\t\t}\n   182\t\treturn *latest, true, nil\n   183\t}\n   184\t\n   185\t// orphanReservations lists the reservations left without a receipt or a\n   186\t// marker, older than reviewOrphanReservationAge, and\n   187\t// says which reservations or receipts it could not read (review round 3, N3).\n   188\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   189\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   190\t\tdirs, err := os.ReadDir(base)\n   191\t\tif errors.Is(err, os.ErrNotExist) {\n   192\t\t\treturn nil, nil, nil\n   193\t\t}\n   194\t\tif err != nil {\n   195\t\t\treturn nil, nil, err\n   196\t\t}\n   197\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   198\t\tif err != nil {\n   199\t\t\treturn nil, nil, err\n   200\t\t}\n   201\t\tif len(markerLost) > 0 {\n   202\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   203\t\t\t// have no marker (review round 6, N1).\n   204\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   205\t\t}\n   206\t\tmarked := map[string]bool{}\n   207\t\tfor _, m := range markers {\n   208\t\t\tmarked[m.AttemptID] = true\n   209\t\t}\n   210\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   211\t\tif err != nil {\n   212\t\t\treturn nil, nil, err\n   213\t\t}\n   214\t\tif len(runLost) > 0 {\n   215\t\t\t// Without the whole run history nothing is known to have no run.\n   216\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   217\t\t}\n   218\t\t// A recorded run does not finish an attempt, its receipt does: a\n   219\t\t// reservation whose run was recorded without a receipt still blocks and\n   220\t\t// is released with that run (review round 5, N3).\n   221\t\t_ = runs\n   222\t\tvar out []DelegatedReviewAttempt\n   223\t\tvar lost []string\n   224\t\tbudget := reviewReadBudget(nil)\n   225\t\tfor _, d := range dirs {\n   226\t\t\tif !d.IsDir() {\n   227\t\t\t\tcontinue\n   228\t\t\t}\n   229\t\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n   230\t\t\tif err != nil {\n   231\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   232\t\t\t\tcontinue\n   233\t\t\t}\n   234\t\t\tfor _, e := range entries {\n   235\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   236\t\t\t\t\tcontinue\n   237\t\t\t\t}\n   238\t\t\t\tvar a DelegatedReviewAttempt\n   239\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   240\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   241\t\t\t\t\tcontinue\n   242\t\t\t\t}\n   243\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif marked[a.AttemptID] {\n   248\t\t\t\t\tcontinue\n   249\t\t\t\t}\n   250\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   251\t\t\t\t\tcontinue\n   252\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   253\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   254\t\t\t\t\tcontinue\n   255\t\t\t\t}\n   256\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   257\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   258\t\t\t\t\tcontinue\n   259\t\t\t\t}\n   260\t\t\t\tout = append(out, a)\n   261\t\t\t}\n   262\t\t}\n   263\t\treturn out, lost, nil\n   264\t}\n   265\t\n   266\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   267\t\tdir, err := s.delegationActiveDir(false)\n   268\t\tif err != nil {\n   269\t\t\treturn err\n   270\t\t}\n   271\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   272\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   273\t\t\t\treturn err\n   274\t\t\t}\n   275\t\t}\n   276\t\treturn nil\n   277\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_attempt_ledger.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"context\"\n     6\t\t\"crypto/rand\"\n     7\t\t\"encoding/hex\"\n     8\t\t\"encoding/json\"\n     9\t\t\"errors\"\n    10\t\t\"fmt\"\n    11\t\t\"io\"\n    12\t\t\"io/fs\"\n    13\t\t\"os\"\n    14\t\t\"os/exec\"\n    15\t\t\"path/filepath\"\n    16\t\t\"sort\"\n    17\t\t\"strings\"\n    18\t\t\"time\"\n    19\t)\n    20\t\n    21\tconst reviewAttemptDir = \".pose/review-attempts\"\n    22\tconst reviewRunLedgerDir = \".pose/review-run-ledger\"\n    23\tconst reviewLedgerMaxRecords = 10000\n    24\tconst reviewLedgerMaxBytes = 1 << 20\n    25\t\n    26\t// DelegatedReviewAttempt is an immutable reservation, published before any adapter starts.\n    27\t// Its ordinal path coordinates contenders; its ID binds its complete content.\n    28\ttype DelegatedReviewAttempt struct {\n    29\t\tSchemaVersion int    `json:\"schema_version\"`\n    30\t\tAttemptID     string `json:\"attempt_id\"`\n    31\t\tBundleID      string `json:\"bundle_id\"`\n    32\t\tBundleDigest  string `json:\"bundle_digest\"`\n    33\t\tScope         string `json:\"scope\"`\n    34\t\tAdapter       string `json:\"adapter\"`\n    35\t\tReason        string `json:\"reason,omitempty\"`\n    36\t\tOrdinal       int    `json:\"ordinal\"`\n    37\t\tReservedAt    string `json:\"reserved_at\"`\n    38\t\tNonce         string `json:\"nonce\"`\n    39\t}\n    40\ttype reviewAttemptReceipt struct {\n    41\t\tSchemaVersion int    `json:\"schema_version\"`\n    42\t\tAttemptID     string `json:\"attempt_id\"`\n    43\t\tRunID         string `json:\"run_id\"`\n    44\t\tRunDigest     string `json:\"run_digest\"`\n    45\t}\n    46\ttype reviewRunWitness struct {\n    47\t\tSchemaVersion    int    `json:\"schema_version\"`\n    48\t\tRunID            string `json:\"run_id\"`\n    49\t\tBundleID         string `json:\"bundle_id\"`\n    50\t\tScope            string `json:\"scope\"`\n    51\t\tRecordDigest     string `json:\"record_digest\"`\n    52\t\tTranscriptDigest string `json:\"transcript_digest\"`\n    53\t}\n    54\t\n    55\tfunc reviewAttemptKey(bundle string) string {\n    56\t\treturn strings.TrimPrefix(digestBytes([]byte(bundle)), \"sha256:\")[:24]\n    57\t}\n    58\tfunc reviewAttemptPath(root string, a DelegatedReviewAttempt) string {\n    59\t\treturn filepath.Join(root, reviewAttemptDir, reviewAttemptKey(a.BundleID), fmt.Sprintf(\"%06d.json\", a.Ordinal))\n    60\t}\n    61\tfunc attemptReceiptPath(root string, a DelegatedReviewAttempt) string {\n    62\t\treturn strings.TrimSuffix(reviewAttemptPath(root, a), \".json\") + \".result.json\"\n    63\t}\n    64\tfunc attemptIdentity(a DelegatedReviewAttempt) string {\n    65\t\ta.AttemptID = \"\"\n    66\t\traw, _ := json.Marshal(a)\n    67\t\treturn \"rat-\" + strings.TrimPrefix(digestBytes(raw), \"sha256:\")\n    68\t}\n    69\t\n    70\tfunc readLedgerRaw(path string) ([]byte, error) {\n    71\t\treturn readBoundedRegular(path, reviewLedgerMaxBytes)\n    72\t}\n    73\t\n    74\t// readBoundedRegular reads a regular file of at most limit bytes, refusing a\n    75\t// link or a file replaced while it was opened.\n    76\tfunc readBoundedRegular(path string, limit int64) ([]byte, error) {\n    77\t\tinfo, err := os.Lstat(path)\n    78\t\tif err != nil {\n    79\t\t\treturn nil, err\n    80\t\t}\n    81\t\tif !info.Mode().IsRegular() || info.Size() > limit {\n    82\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n    83\t\t}\n    84\t\tf, err := os.Open(path)\n    85\t\tif err != nil {\n    86\t\t\treturn nil, err\n    87\t\t}\n    88\t\topened, statErr := f.Stat()\n    89\t\tif statErr != nil || !opened.Mode().IsRegular() || !os.SameFile(info, opened) {\n    90\t\t\tf.Close()\n    91\t\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n    92\t\t}\n    93\t\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n    94\t\tcloseErr := f.Close()\n    95\t\tif err != nil {\n    96\t\t\treturn nil, err\n    97\t\t}\n    98\t\tif closeErr != nil {\n    99\t\t\treturn nil, closeErr\n   100\t\t}\n   101\t\tif int64(len(raw)) > limit {\n   102\t\t\treturn nil, fmt.Errorf(\"ledger record exceeds bound\")\n   103\t\t}\n   104\t\treturn raw, nil\n   105\t}\n   106\t\n   107\t// readBoundedRegularIn is the operation-Files form of readBoundedRegular. It\n   108\t// keeps the same regular-file and replacement checks while making the bytes\n   109\t// part of an active governance read view.\n   110\tfunc readBoundedRegularIn(files Files, path string, limit int64) ([]byte, error) {\n   111\t\tfiles = FilesOrNative(files)\n   112\t\tinfo, err := files.Lstat(path)\n   113\t\tif err != nil {\n   114\t\t\treturn nil, err\n   115\t\t}\n   116\t\tif !info.Mode().IsRegular() || limit < 0 || info.Size() < 0 || info.Size() > limit {\n   117\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n   118\t\t}\n   119\t\tf, err := files.Open(path)\n   120\t\tif err != nil {\n   121\t\t\treturn nil, err\n   122\t\t}\n   123\t\topened, statErr := f.Stat()\n   124\t\tif statErr != nil || !opened.Mode().IsRegular() || !sameObservedFile(info, opened) {\n   125\t\t\t_ = f.Close()\n   126\t\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n   127\t\t}\n   128\t\traw, readErr := readLimited(f, limit)\n   129\t\tcloseErr := f.Close()\n   130\t\tif readErr != nil {\n   131\t\t\treturn nil, readErr\n   132\t\t}\n   133\t\tif closeErr != nil {\n   134\t\t\treturn nil, closeErr\n   135\t\t}\n   136\t\treturn raw, nil\n   137\t}\n   138\t\n   139\tvar errReviewLedgerBudget = errors.New(\"review ledger exceeds 32 MiB inventory read budget\")\n   140\t\n   141\tfunc readLedgerRawBudget(path string, remaining *int64) ([]byte, error) {\n   142\t\tinfo, err := os.Lstat(path)\n   143\t\tif err != nil {\n   144\t\t\treturn nil, err\n   145\t\t}\n   146\t\tif info.Size() < 0 || info.Size() > *remaining {\n   147\t\t\treturn nil, errReviewLedgerBudget\n   148\t\t}\n   149\t\t*remaining -= info.Size()\n   150\t\traw, err := readLedgerRaw(path)\n   151\t\tif err != nil {\n   152\t\t\treturn nil, err\n   153\t\t}\n   154\t\tif extra := int64(len(raw)) - info.Size(); extra > 0 {\n   155\t\t\t*remaining -= extra\n   156\t\t\tif *remaining < 0 {\n   157\t\t\t\treturn nil, errReviewLedgerBudget\n   158\t\t\t}\n   159\t\t}\n   160\t\treturn raw, nil\n   161\t}\n   162\t\n   163\tfunc readLedgerRawBudgetIn(files Files, path string, remaining *int64) ([]byte, error) {\n   164\t\tfiles = FilesOrNative(files)\n   165\t\tinfo, err := files.Lstat(path)\n   166\t\tif err != nil {\n   167\t\t\treturn nil, err\n   168\t\t}\n   169\t\tif info.Size() < 0 || info.Size() > *remaining {\n   170\t\t\treturn nil, errReviewLedgerBudget\n   171\t\t}\n   172\t\t*remaining -= info.Size()\n   173\t\traw, err := readBoundedRegularIn(files, path, reviewLedgerMaxBytes)\n   174\t\tif err != nil {\n   175\t\t\treturn nil, err\n   176\t\t}\n   177\t\tif extra := int64(len(raw)) - info.Size(); extra > 0 {\n   178\t\t\t*remaining -= extra\n   179\t\t\tif *remaining < 0 {\n   180\t\t\t\treturn nil, errReviewLedgerBudget\n   181\t\t\t}\n   182\t\t}\n   183\t\treturn raw, nil\n   184\t}\n   185\tfunc readLedgerJSONBudget(path string, v any, remaining *int64) error {\n   186\t\traw, err := readLedgerRawBudget(path, remaining)\n   187\t\tif err != nil {\n   188\t\t\treturn err\n   189\t\t}\n   190\t\treturn strictJSONBytes(raw, v)\n   191\t}\n   192\t\n   193\tfunc readLedgerJSONBudgetIn(files Files, path string, v any, remaining *int64) error {\n   194\t\traw, err := readLedgerRawBudgetIn(files, path, remaining)\n   195\t\tif err != nil {\n   196\t\t\treturn err\n   197\t\t}\n   198\t\treturn strictJSONBytes(raw, v)\n   199\t}\n   200\tfunc reviewReadBudget(provided []*int64) *int64 {\n   201\t\tif len(provided) > 0 {\n   202\t\t\treturn provided[0]\n   203\t\t}\n   204\t\tbudget := int64(32 << 20)\n   205\t\treturn &budget\n   206\t}\n   207\t\n   208\tfunc readLedgerJSON(path string, v any) error {\n   209\t\traw, err := readLedgerRaw(path)\n   210\t\tif err != nil {\n   211\t\t\treturn err\n   212\t\t}\n   213\t\tif err := strictJSONBytes(raw, v); err != nil {\n   214\t\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n   215\t\t}\n   216\t\treturn nil\n   217\t}\n   218\t\n   219\tfunc readLedgerJSONIn(files Files, path string, v any) error {\n   220\t\traw, err := readBoundedRegularIn(files, path, reviewLedgerMaxBytes)\n   221\t\tif err != nil {\n   222\t\t\treturn err\n   223\t\t}\n   224\t\tif err := strictJSONBytes(raw, v); err != nil {\n   225\t\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n   226\t\t}\n   227\t\treturn nil\n   228\t}\n   229\t\n   230\tfunc ledgerEntries(root, rel string) ([]os.DirEntry, error) {\n   231\t\tpath, err := ensureReviewArtifactDir(root, rel, false)\n   232\t\tif os.IsNotExist(err) {\n   233\t\t\treturn nil, nil\n   234\t\t}\n   235\t\tif err != nil {\n   236\t\t\treturn nil, err\n   237\t\t}\n   238\t\tf, err := os.Open(path)\n   239\t\tif err != nil {\n   240\t\t\treturn nil, err\n   241\t\t}\n   242\t\tentries, err := f.ReadDir(reviewLedgerMaxRecords + 1)\n   243\t\tcloseErr := f.Close()\n   244\t\tif err != nil && !errors.Is(err, io.EOF) {\n   245\t\t\treturn nil, err\n   246\t\t}\n   247\t\tif closeErr != nil {\n   248\t\t\treturn nil, closeErr\n   249\t\t}\n   250\t\tif len(entries) > reviewLedgerMaxRecords {\n   251\t\t\treturn nil, fmt.Errorf(\"ledger inventory exceeds %d records\", reviewLedgerMaxRecords)\n   252\t\t}\n   253\t\tsort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })\n   254\t\treturn entries, nil\n   255\t}\n   256\t\n   257\tfunc ledgerEntriesIn(files Files, root, rel string) ([]fs.DirEntry, error) {\n   258\t\tfiles = FilesOrNative(files)\n   259\t\tpath, err := ensureReviewArtifactDirIn(files, root, rel, false)\n   260\t\tif os.IsNotExist(err) {\n   261\t\t\treturn nil, nil\n   262\t\t}\n   263\t\tif err != nil {\n   264\t\t\treturn nil, err\n   265\t\t}\n   266\t\tf, err := files.Open(path)\n   267\t\tif err != nil {\n   268\t\t\treturn nil, err\n   269\t\t}\n   270\t\treader, ok := f.(interface {\n   271\t\t\tReadDir(int) ([]fs.DirEntry, error)\n   272\t\t})\n   273\t\tif !ok {\n   274\t\t\t_ = f.Close()\n   275\t\t\treturn nil, fmt.Errorf(\"ledger directory does not support bounded reads\")\n   276\t\t}\n   277\t\tentries, err := reader.ReadDir(reviewLedgerMaxRecords + 1)\n   278\t\tcloseErr := f.Close()\n   279\t\tif err != nil && !errors.Is(err, io.EOF) {\n   280\t\t\treturn nil, err\n   281\t\t}\n   282\t\tif closeErr != nil {\n   283\t\t\treturn nil, closeErr\n   284\t\t}\n   285\t\tif len(entries) > reviewLedgerMaxRecords {\n   286\t\t\treturn nil, fmt.Errorf(\"ledger inventory exceeds %d records\", reviewLedgerMaxRecords)\n   287\t\t}\n   288\t\tsort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })\n   289\t\treturn entries, nil\n   290\t}\n   291\tfunc publishLedgerJSON(root, rel string, v any) error {\n   292\t\tdir, err := ensureReviewArtifactDir(root, filepath.ToSlash(filepath.Dir(rel)), true)\n   293\t\tif err != nil {\n   294\t\t\treturn err\n   295\t\t}\n   296\t\traw, err := json.MarshalIndent(v, \"\", \"  \")\n   297\t\tif err != nil {\n   298\t\t\treturn err\n   299\t\t}\n   300\t\tif len(raw) > reviewLedgerMaxBytes {\n   301\t\t\treturn fmt.Errorf(\"ledger record exceeds bound\")\n   302\t\t}\n   303\t\treturn PublishFile(filepath.Join(dir, filepath.Base(rel)), append(raw, '\\n'), 0644, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n   304\t}\n   305\t\n   306\tfunc (s Store) readDelegatedReviewAttempts(bundle string, budgets ...*int64) ([]DelegatedReviewAttempt, error) {\n   307\t\tbudget := reviewReadBudget(budgets)\n   308\t\trel := filepath.ToSlash(filepath.Join(reviewAttemptDir, reviewAttemptKey(bundle)))\n   309\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, rel)\n   310\t\tif err != nil {\n   311\t\t\treturn nil, err\n   312\t\t}\n   313\t\tout := []DelegatedReviewAttempt{}\n   314\t\tfor _, e := range entries {\n   315\t\t\tif IsPublisherStaging(e.Name()) {\n   316\t\t\t\tcontinue\n   317\t\t\t}\n   318\t\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n   319\t\t\t\tcontinue\n   320\t\t\t}\n   321\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   322\t\t\t\treturn nil, fmt.Errorf(\"unknown attempt artifact %s\", e.Name())\n   323\t\t\t}\n   324\t\t\tvar a DelegatedReviewAttempt\n   325\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, rel, e.Name()), &a, budget); err != nil {\n   326\t\t\t\treturn nil, err\n   327\t\t\t}\n   328\t\t\tif a.SchemaVersion != 1 || a.BundleID != bundle || a.Ordinal != len(out)+1 || a.AttemptID != attemptIdentity(a) || e.Name() != fmt.Sprintf(\"%06d.json\", a.Ordinal) {\n   329\t\t\t\treturn nil, fmt.Errorf(\"invalid attempt reservation %s\", e.Name())\n   330\t\t\t}\n   331\t\t\tif _, err := time.Parse(time.RFC3339Nano, a.ReservedAt); err != nil {\n   332\t\t\t\treturn nil, err\n   333\t\t\t}\n   334\t\t\tout = append(out, a)\n   335\t\t}\n   336\t\t// Orphan receipts are an unknown history, never ignored.\n   337\t\tfor _, e := range entries {\n   338\t\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n   339\t\t\t\tfound := false\n   340\t\t\t\tfor _, a := range out {\n   341\t\t\t\t\tif filepath.Base(attemptReceiptPath(s.Root, a)) == e.Name() {\n   342\t\t\t\t\t\tfound = true\n   343\t\t\t\t\t\tbreak\n   344\t\t\t\t\t}\n   345\t\t\t\t}\n   346\t\t\t\tif !found {\n   347\t\t\t\t\treturn nil, fmt.Errorf(\"attempt receipt has no reservation: %s\", e.Name())\n   348\t\t\t\t}\n   349\t\t\t}\n   350\t\t}\n   351\t\treturn out, nil\n   352\t}\n   353\tfunc (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (reviewAttemptReceipt, error) {\n   354\t\tbudget := reviewReadBudget(budgets)\n   355\t\tvar r reviewAttemptReceipt\n   356\t\tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n   357\t\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n   358\t\t}\n   359\t\tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n   360\t\t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n   361\t\t}\n   362\t\tvar run ReviewRun\n   363\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, r.RunID+\".json\"), &run, budget); err != nil {\n   364\t\t\treturn r, err\n   365\t\t}\n   366\t\traw, _ := json.Marshal(run)\n   367\t\tif run.AttemptID != a.AttemptID || run.BundleID != a.BundleID || run.BundleDigest != a.BundleDigest || run.Adapter != a.Adapter || digestBytes(raw) != r.RunDigest {\n   368\t\t\treturn r, fmt.Errorf(\"attempt receipt does not bind its final run\")\n   369\t\t}\n   370\t\treturn r, nil\n   371\t}\n   372\tfunc (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttempt, int, error) {\n   373\t\tif len(plan.Reason) > 2048 || strings.ContainsAny(plan.Reason, \"\\x00\\r\\n\") {\n   374\t\t\treturn nil, 0, fmt.Errorf(\"rerun reason must be one line of at most 2048 bytes\")\n   375\t\t}\n   376\t\truns, lost, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n   377\t\tif err != nil {\n   378\t\t\treturn nil, 0, err\n   379\t\t}\n   380\t\tif len(lost) > 0 {\n   381\t\t\treturn nil, 0, fmt.Errorf(\"review run coverage is unknown: %v\", lost)\n   382\t\t}\n   383\t\tattempts, err := s.readDelegatedReviewAttempts(plan.Bundle.BundleID)\n   384\t\tif err != nil {\n   385\t\t\treturn nil, 0, err\n   386\t\t}\n   387\t\tknownAttempts := map[string]bool{}\n   388\t\tcount := 0\n   389\t\treceiptBudget := int64(32 << 20)\n   390\t\tfor _, a := range attempts {\n   391\t\t\tknownAttempts[a.AttemptID] = true\n   392\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   393\t\t\t\treturn nil, 0, err\n   394\t\t\t}\n   395\t\t\tif a.Adapter == plan.Adapter {\n   396\t\t\t\tcount++\n   397\t\t\t}\n   398\t\t}\n   399\t\tcompleted := false\n   400\t\tfor _, run := range runs {\n   401\t\t\tif run.AttemptID != \"\" && !knownAttempts[run.AttemptID] {\n   402\t\t\t\treturn nil, 0, fmt.Errorf(\"missing attempt reservation %s\", run.AttemptID)\n   403\t\t\t}\n   404\t\t\tif run.Status == ReviewRunCompleted {\n   405\t\t\t\tcompleted = true\n   406\t\t\t}\n   407\t\t\tif run.AttemptID == \"\" && run.Adapter == plan.Adapter {\n   408\t\t\t\tcount++\n   409\t\t\t}\n   410\t\t}\n   411\t\tif count >= effectiveReviewMaxRuns(plan.Config) {\n   412\t\t\treturn nil, count, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"budget exhausted: %d attempt(s) of %s on this bundle, at most %d\", count, plan.Adapter, effectiveReviewMaxRuns(plan.Config)))\n   413\t\t}\n   414\t\tif completed && strings.TrimSpace(plan.Reason) == \"\" {\n   415\t\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n   416\t\t}\n   417\t\treturn attempts, count, nil\n   418\t}\n   419\t\n   420\t// prepareDelegatedReviewAttempt admits and builds the next reservation of\n   421\t// the bundle without publishing it.\n   422\tfunc (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n   423\t\tattempts, _, err := s.reviewAttemptAdmission(plan)\n   424\t\tif err != nil {\n   425\t\t\treturn DelegatedReviewAttempt{}, err\n   426\t\t}\n   427\t\tnonce := make([]byte, 16)\n   428\t\tif _, err := rand.Read(nonce); err != nil {\n   429\t\t\treturn DelegatedReviewAttempt{}, err\n   430\t\t}\n   431\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n   432\t\ta.AttemptID = attemptIdentity(a)\n   433\t\treturn a, nil\n   434\t}\n   435\t\n   436\t// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n   437\t// marks the attempt active first, so a dispatch that ends after this point\n   438\t// always leaves a marker that turns stalled and that `pose delegate cancel`\n   439\t// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n   440\t// review round 1, N1).\n   441\tfunc (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n   442\t\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n   443\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n   444\t\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n   445\t\t}\n   446\t\treturn nil\n   447\t}\n   448\tfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n   449\t\traw, _ := json.Marshal(run)\n   450\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n   451\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n   452\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n   453\t}\n   454\t\n   455\t// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n   456\t// exists for legacy records; their content identity remains independently checked.\n   457\tfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n   458\t\tbudget := int64(32 << 20)\n   459\t\treturn s.reviewRunLedgerFindings(bundle, &budget)\n   460\t}\n   461\tfunc (s Store) reviewRunLedgerFindings(bundle string, budget *int64) ([]string, error) {\n   462\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, reviewRunLedgerDir)\n   463\t\tif err != nil {\n   464\t\t\treturn nil, err\n   465\t\t}\n   466\t\tfindings := []string{}\n   467\t\tvar checkedBytes int64\n   468\t\tfor _, e := range entries {\n   469\t\t\tif IsPublisherStaging(e.Name()) {\n   470\t\t\t\tcontinue\n   471\t\t\t}\n   472\t\t\tvar w reviewRunWitness\n   473\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunLedgerDir, e.Name()), &w, budget); err != nil {\n   474\t\t\t\tfindings = append(findings, err.Error())\n   475\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   476\t\t\t\t\tbreak\n   477\t\t\t\t}\n   478\t\t\t\tcontinue\n   479\t\t\t}\n   480\t\t\tif w.SchemaVersion != 1 || e.Name() != w.RunID+\".json\" || strings.ContainsAny(w.RunID, \"/\\\\\") {\n   481\t\t\t\tfindings = append(findings, \"invalid run witness \"+e.Name())\n   482\t\t\t\tcontinue\n   483\t\t\t}\n   484\t\t\tvar run ReviewRun\n   485\t\t\traw, readErr := readLedgerRawBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, w.RunID+\".json\"), budget)\n   486\t\t\tif readErr != nil {\n   487\t\t\t\tfindings = append(findings, \"witnessed run \"+w.RunID+\": \"+readErr.Error())\n   488\t\t\t\tif errors.Is(readErr, errReviewLedgerBudget) {\n   489\t\t\t\t\tbreak\n   490\t\t\t\t}\n   491\t\t\t\tcontinue\n   492\t\t\t}\n   493\t\t\tif err := strictJSONBytes(raw, &run); err != nil {\n   494\t\t\t\tfindings = append(findings, \"unreadable witnessed run \"+w.RunID)\n   495\t\t\t\tcontinue\n   496\t\t\t}\n   497\t\t\tif validateReviewRunRecord(w.RunID+\".json\", run) != nil || digestBytes(raw) != w.RecordDigest || run.TranscriptDigest != w.TranscriptDigest || run.BundleID != w.BundleID || run.Scope != w.Scope {\n   498\t\t\t\tfindings = append(findings, \"rewritten witnessed run \"+w.RunID)\n   499\t\t\t\tcontinue\n   500\t\t\t}\n   501\t\t\tif bundle != \"\" && run.BundleID != bundle {\n   502\t\t\t\tcontinue\n   503\t\t\t}\n   504\t\t\tinfo, statErr := s.fsys().Lstat(filepath.Join(s.Root, run.TranscriptPath))\n   505\t\t\tif statErr == nil {\n   506\t\t\t\tcheckedBytes += info.Size()\n   507\t\t\t}\n   508\t\t\tif checkedBytes > 512<<20 {\n   509\t\t\t\tfindings = append(findings, \"run transcript verification exceeds 512 MiB operation budget\")\n   510\t\t\t\tbreak\n   511\t\t\t}\n   512\t\t\tif why := s.reviewRunTranscriptIntact(run); why != \"\" {\n   513\t\t\t\tfindings = append(findings, w.RunID+\": \"+why)\n   514\t\t\t}\n   515\t\t}\n   516\t\treturn findings, nil\n   517\t}\n   518\t\n   519\ttype reviewHistoryBuffer struct{ bytes.Buffer }\n   520\t\n   521\tfunc (b *reviewHistoryBuffer) Write(p []byte) (int, error) {\n   522\t\tif b.Len()+len(p) > 8<<20 {\n   523\t\t\treturn 0, fmt.Errorf(\"review history Git output exceeds 8 MiB\")\n   524\t\t}\n   525\t\treturn b.Buffer.Write(p)\n   526\t}\n   527\tfunc reviewHistoryGit(root string, args ...string) ([]byte, error) {\n   528\t\tctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)\n   529\t\tdefer cancel()\n   530\t\tbase := gitCommand(append([]string{\"-C\", root}, args...)...)\n   531\t\tcmd := exec.CommandContext(ctx, \"git\", base.Args[1:]...)\n   532\t\tcmd.Env = base.Env\n   533\t\tvar out reviewHistoryBuffer\n   534\t\tcmd.Stdout = &out\n   535\t\tif err := cmd.Run(); err != nil {\n   536\t\t\treturn nil, fmt.Errorf(\"review history Git observation unavailable: %w\", err)\n   537\t\t}\n   538\t\treturn out.Bytes(), nil\n   539\t}\n   540\t\n   541\t// ReviewRunHistoryFindings adds the Git anchor: edits and deletions of tracked\n   542\t// immutable evidence are violations even when staged or committed.\n   543\tfunc (s Store) ReviewRunHistoryFindings() ([]string, error) {\n   544\t\truns, losses, err := s.ReadReviewRuns(\"\")\n   545\t\tfindings := append(losses, s.reviewContinuationFindings(runs)...)\n   546\t\tif err != nil {\n   547\t\t\treturn nil, err\n   548\t\t}\n   549\t\troots := []string{reviewRunsDir, reviewRunLedgerDir, reviewAttemptDir, reviewContinuationsDir, reviewRunProofDir}\n   550\t\tif _, headErr := snapshotGit(s.Root, \"rev-parse\", \"--verify\", \"HEAD\"); headErr != nil {\n   551\t\t\t// An unborn repository without delegated data has no delegated history\n   552\t\t\t// contract to verify. Preserve the report-history gate's existing behavior.\n   553\t\t\tpresent := false\n   554\t\t\tfor _, root := range roots {\n   555\t\t\t\tif _, err := os.Lstat(filepath.Join(s.Root, root)); !os.IsNotExist(err) {\n   556\t\t\t\t\tpresent = true\n   557\t\t\t\t\tbreak\n   558\t\t\t\t}\n   559\t\t\t}\n   560\t\t\ttracked, trackedErr := reviewHistoryGit(s.Root, append([]string{\"ls-files\", \"--\"}, roots...)...)\n   561\t\t\tif !present && trackedErr == nil && len(bytes.TrimSpace(tracked)) == 0 {\n   562\t\t\t\treturn uniqueSorted(findings), nil\n   563\t\t\t}\n   564\t\t\treturn findings, fmt.Errorf(\"delegated history Git anchor unavailable: %w\", headErr)\n   565\t\t}\n   566\t\n   567\t\targs := append([]string{\"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\"}, roots...)\n   568\t\tpending, err := reviewHistoryGit(s.Root, args...)\n   569\t\tif err != nil {\n   570\t\t\treturn nil, err\n   571\t\t}\n   572\t\targs = append([]string{\"log\", \"--format=\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\"}, roots...)\n   573\t\tcommitted, err := reviewHistoryGit(s.Root, args...)\n   574\t\tif err != nil {\n   575\t\t\treturn nil, err\n   576\t\t}\n   577\t\tfor _, line := range strings.Split(string(append(pending, committed...)), \"\\n\") {\n   578\t\t\tif strings.TrimSpace(line) != \"\" {\n   579\t\t\t\tfindings = append(findings, \"immutable review evidence changed: \"+line)\n   580\t\t\t}\n   581\t\t}\n   582\t\truns, lost, err := s.ReadReviewRuns(\"\")\n   583\t\tif err != nil {\n   584\t\t\treturn nil, err\n   585\t\t}\n   586\t\t_ = runs\n   587\t\tfindings = append(findings, lost...)\n   588\t\tattempts, losses := s.allDelegatedReviewAttempts()\n   589\t\tfindings = append(findings, losses...)\n   590\t\treceiptBudget := int64(32 << 20)\n   591\t\tfor _, a := range attempts {\n   592\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   593\t\t\t\tfindings = append(findings, err.Error())\n   594\t\t\t}\n   595\t\t}\n   596\t\treturn uniqueSorted(findings), nil\n   597\t}\n   598\t\n   599\t// legacyReviewDecision reads the decision line of a final message; a\n   600\t// pose-draft block, when present, decides instead (draftReviewDecision).\n   601\t// DraftDecision is telemetry about an adapter's text, not verified authority.\n   602\tfunc legacyReviewDecision(output string) string {\n   603\t\tdecision := \"\"\n   604\t\tfor _, line := range strings.Split(output, \"\\n\") {\n   605\t\t\tkey, value, ok := strings.Cut(strings.TrimSpace(line), \":\")\n   606\t\t\tif !ok || key != \"decision\" {\n   607\t\t\t\tcontinue\n   608\t\t\t}\n   609\t\t\tvalue = strings.TrimSpace(value)\n   610\t\t\tif value != \"approved\" && value != \"changes-requested\" && value != \"rejected\" {\n   611\t\t\t\treturn \"unknown\"\n   612\t\t\t}\n   613\t\t\tif decision != \"\" {\n   614\t\t\t\treturn \"unknown\"\n   615\t\t\t}\n   616\t\t\tdecision = value\n   617\t\t}\n   618\t\tif decision == \"\" {\n   619\t\t\treturn \"unknown\"\n   620\t\t}\n   621\t\treturn decision\n   622\t}\n   623\t\n   624\ttype ReviewRunSummary struct {\n   625\t\tSafety        *ReviewExecutionSafety `json:\"safety,omitempty\"`\n   626\t\tResumedBy     string                 `json:\"resumed_by,omitempty\"`\n   627\t\tResumes       string                 `json:\"resumes,omitempty\"`\n   628\t\tLimitOf       string                 `json:\"limit_of,omitempty\"`\n   629\t\tPartial       bool                   `json:\"partial,omitempty\"`\n   630\t\tInterruption  *ReviewInterruption    `json:\"interruption,omitempty\"`\n   631\t\tSupersededBy  string                 `json:\"superseded_by,omitempty\"`\n   632\t\tRunID         string                 `json:\"run_id\"`\n   633\t\tAttemptID     string                 `json:\"attempt_id,omitempty\"`\n   634\t\tBundleID      string                 `json:\"bundle_id\"`\n   635\t\tAdapter       string                 `json:\"adapter\"`\n   636\t\tStatus        string                 `json:\"status\"`\n   637\t\tDraftDecision string                 `json:\"draft_decision\"`\n   638\t\tReason        string                 `json:\"reason,omitempty\"`\n   639\t\tAssurance     string                 `json:\"assurance\"`\n   640\t\t// Round, Thread and DraftProblems disclose the round protocol (spec\n   641\t\t// pose-delegated-review-round-protocol R1, R4, R6).\n   642\t\tRound         int           `json:\"round,omitempty\"`\n   643\t\tThread        *ReviewThread `json:\"thread,omitempty\"`\n   644\t\tDraftProblems []string      `json:\"draft_problems,omitempty\"`\n   645\t}\n   646\t\n   647\tfunc (s Store) reviewRunSummaries(scope string) ([]ReviewRunSummary, []string) {\n   648\t\truns, lost, err := s.ReadReviewRuns(\"\")\n   649\t\tif err != nil {\n   650\t\t\tlost = append(lost, err.Error())\n   651\t\t}\n   652\t\tout := []ReviewRunSummary{}\n   653\t\tfor _, run := range runs {\n   654\t\t\tif run.Scope == scope {\n   655\t\t\t\tdecision := \"unknown\"\n   656\t\t\t\tif run.Status == ReviewRunCompleted && reviewSafetyConflict(run) == \"\" {\n   657\t\t\t\t\tdecision = draftReviewDecision(run.Output)\n   658\t\t\t\t}\n   659\t\t\t\tif len(run.DraftProblems) > 0 && decision != \"unknown\" {\n   660\t\t\t\t\tdecision = \"invalid\"\n   661\t\t\t\t}\n   662\t\t\t\tout = append(out, ReviewRunSummary{Safety: run.Safety, Resumes: run.Resumes, LimitOf: run.LimitOf, Partial: run.Status == ReviewRunInterrupted, Interruption: run.Interruption, SupersededBy: run.SupersededBy, RunID: run.RunID, AttemptID: run.AttemptID, BundleID: run.BundleID, Adapter: run.Adapter, Status: run.Status, DraftDecision: decision, Reason: run.Reason, Assurance: \"declared-draft-not-attestation\", Round: run.Round, Thread: run.Thread, DraftProblems: run.DraftProblems})\n   663\t\t\t}\n   664\t\t}\n   665\t\tattempts, losses := s.allDelegatedReviewAttempts()\n   666\t\tlost = append(lost, losses...)\n   667\t\treceiptBudget := int64(32 << 20)\n   668\t\tfor _, a := range attempts {\n   669\t\t\tif a.Scope == scope {\n   670\t\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   671\t\t\t\t\tlost = append(lost, err.Error())\n   672\t\t\t\t}\n   673\t\t\t}\n   674\t\t}\n   675\t\treturn out, uniqueSorted(lost)\n   676\t}\n   677\t\n   678\ttype DelegatedReviewMetric struct {\n   679\t\tResumes         int    `json:\"resumes\"`\n   680\t\tKey             string `json:\"key\"`\n   681\t\tRuns            int    `json:\"runs\"`\n   682\t\tAttempts        int    `json:\"attempts\"`\n   683\t\tApprovedDrafts  int    `json:\"approved_drafts\"`\n   684\t\tRejectingDrafts int    `json:\"rejecting_drafts\"`\n   685\t\tUnknownDrafts   int    `json:\"unknown_drafts\"`\n   686\t\t// InvalidDrafts are drafts that do not account for their round (spec\n   687\t\t// pose-delegated-review-round-protocol R4): never approvals.\n   688\t\tInvalidDrafts       int      `json:\"invalid_drafts\"`\n   689\t\tReruns              int      `json:\"reruns_without_bundle_change\"`\n   690\t\tRerunsWithoutReason int      `json:\"reruns_without_reason\"`\n   691\t\tApprovalRate        *float64 `json:\"approval_rate\"`\n   692\t}\n   693\ttype DelegatedReviewInsights struct {\n   694\t\tByBundle         []DelegatedReviewMetric `json:\"by_bundle\"`\n   695\t\tByAdapter        []DelegatedReviewMetric `json:\"by_adapter\"`\n   696\t\tCoverageComplete bool                    `json:\"coverage_complete\"`\n   697\t\tLosses           []string                `json:\"losses,omitempty\"`\n   698\t\tAssurance        string                  `json:\"assurance\"`\n   699\t\t// Rounds measures convergence per scope (spec\n   700\t\t// pose-delegated-review-round-protocol R7, R10).\n   701\t\tRounds []ReviewRoundMetric `json:\"rounds,omitempty\"`\n   702\t}\n   703\t\n   704\t// allDelegatedReviewAttempts bounds the whole inventory, not just each bundle.\n   705\tfunc (s Store) allDelegatedReviewAttempts() ([]DelegatedReviewAttempt, []string) {\n   706\t\tdirs, err := ledgerEntries(s.Root, reviewAttemptDir)\n   707\t\tif err != nil {\n   708\t\t\treturn nil, []string{err.Error()}\n   709\t\t}\n   710\t\tout := []DelegatedReviewAttempt{}\n   711\t\tlosses := []string{}\n   712\t\tvisited := 0\n   713\t\tbudget := int64(32 << 20)\n   714\t\tfor _, dir := range dirs {\n   715\t\t\tif IsPublisherStaging(dir.Name()) {\n   716\t\t\t\tcontinue\n   717\t\t\t}\n   718\t\t\tif !dir.IsDir() || len(dir.Name()) != 24 {\n   719\t\t\t\tlosses = append(losses, \"invalid attempt directory \"+dir.Name())\n   720\t\t\t\tcontinue\n   721\t\t\t}\n   722\t\t\tentries, err := ledgerEntries(s.Root, filepath.ToSlash(filepath.Join(reviewAttemptDir, dir.Name())))\n   723\t\t\tif err != nil {\n   724\t\t\t\tlosses = append(losses, err.Error())\n   725\t\t\t\tcontinue\n   726\t\t\t}\n   727\t\t\tvisited += len(entries)\n   728\t\t\tif visited > reviewLedgerMaxRecords {\n   729\t\t\t\treturn out, append(losses, \"global attempt inventory exceeds bound\")\n   730\t\t\t}\n   731\t\t\tbundle := \"\"\n   732\t\t\tfor _, e := range entries {\n   733\t\t\t\tif IsPublisherStaging(e.Name()) || strings.HasSuffix(e.Name(), \".result.json\") {\n   734\t\t\t\t\tcontinue\n   735\t\t\t\t}\n   736\t\t\t\tvar a DelegatedReviewAttempt\n   737\t\t\t\tif err := readLedgerJSONBudget(filepath.Join(s.Root, reviewAttemptDir, dir.Name(), e.Name()), &a, &budget); err != nil {\n   738\t\t\t\t\tlosses = append(losses, err.Error())\n   739\t\t\t\t\tcontinue\n   740\t\t\t\t}\n   741\t\t\t\tbundle = a.BundleID\n   742\t\t\t\tbreak\n   743\t\t\t}\n   744\t\t\tif bundle == \"\" {\n   745\t\t\t\tif len(entries) > 0 {\n   746\t\t\t\t\tlosses = append(losses, \"attempt receipts without reservation in \"+dir.Name())\n   747\t\t\t\t}\n   748\t\t\t\tcontinue\n   749\t\t\t}\n   750\t\t\tif reviewAttemptKey(bundle) != dir.Name() {\n   751\t\t\t\tlosses = append(losses, \"attempt bundle directory identity mismatch\")\n   752\t\t\t\tcontinue\n   753\t\t\t}\n   754\t\t\tattempts, err := s.readDelegatedReviewAttempts(bundle, &budget)\n   755\t\t\tif err != nil {\n   756\t\t\t\tlosses = append(losses, err.Error())\n   757\t\t\t\tcontinue\n   758\t\t\t}\n   759\t\t\tout = append(out, attempts...)\n   760\t\t}\n   761\t\treturn out, losses\n   762\t}\n   763\t\n   764\tfunc (s Store) delegatedReviewInsights(sinceDays int) *DelegatedReviewInsights {\n   765\t\truns, lost, err := s.ReadReviewRuns(\"\")\n   766\t\tif err != nil {\n   767\t\t\tlost = append(lost, err.Error())\n   768\t\t}\n   769\t\tattempts, attemptLoss := s.allDelegatedReviewAttempts()\n   770\t\tlost = append(lost, attemptLoss...)\n   771\t\treceiptBudget := int64(32 << 20)\n   772\t\tfor _, a := range attempts {\n   773\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   774\t\t\t\tlost = append(lost, err.Error())\n   775\t\t\t}\n   776\t\t}\n   777\t\tif len(runs) == 0 && len(attempts) == 0 && len(lost) == 0 {\n   778\t\t\treturn nil\n   779\t\t}\n   780\t\tresult := &DelegatedReviewInsights{CoverageComplete: len(lost) == 0, Losses: uniqueSorted(lost), Assurance: \"declared-draft-outcomes-not-verified-approvals\", Rounds: reviewRoundMetrics(runs)}\n   781\t\tbundles, adapters := map[string]*DelegatedReviewMetric{}, map[string]*DelegatedReviewMetric{}\n   782\t\trow := func(group map[string]*DelegatedReviewMetric, key string) *DelegatedReviewMetric {\n   783\t\t\tr := group[key]\n   784\t\t\tif r == nil {\n   785\t\t\t\tr = &DelegatedReviewMetric{Key: key}\n   786\t\t\t\tgroup[key] = r\n   787\t\t\t}\n   788\t\t\treturn r\n   789\t\t}\n   790\t\tinWindow := func(at string) bool {\n   791\t\t\tt, _ := time.Parse(time.RFC3339Nano, at)\n   792\t\t\treturn sinceDays == 0 || !t.Before(time.Now().AddDate(0, 0, -sinceDays))\n   793\t\t}\n   794\t\ttype event struct{ id, bundle, adapter, reason, at string }\n   795\t\tevents := []event{}\n   796\t\tknown := map[string]bool{}\n   797\t\tfor _, a := range attempts {\n   798\t\t\tknown[a.AttemptID] = true\n   799\t\t\tevents = append(events, event{a.AttemptID, a.BundleID, a.Adapter, a.Reason, a.ReservedAt})\n   800\t\t}\n   801\t\tfor _, run := range runs {\n   802\t\t\tif run.AttemptID == \"\" {\n   803\t\t\t\tevents = append(events, event{run.RunID, run.BundleID, run.Adapter, run.Reason, run.StartedAt})\n   804\t\t\t} else if !known[run.AttemptID] {\n   805\t\t\t\tknown[run.AttemptID] = true\n   806\t\t\t\tevents = append(events, event{run.AttemptID, run.BundleID, run.Adapter, run.Reason, run.StartedAt})\n   807\t\t\t\tresult.CoverageComplete = false\n   808\t\t\t\tresult.Losses = append(result.Losses, \"missing attempt reservation \"+run.AttemptID)\n   809\t\t\t}\n   810\t\t\tif !inWindow(run.StartedAt) {\n   811\t\t\t\tcontinue\n   812\t\t\t}\n   813\t\t\tfor _, r := range []*DelegatedReviewMetric{row(bundles, run.BundleID), row(adapters, run.Adapter)} {\n   814\t\t\t\tr.Runs++\n   815\t\t\t\tif run.continues() != \"\" && run.SupersededBy == \"\" {\n   816\t\t\t\t\tr.Resumes++\n   817\t\t\t\t}\n   818\t\t\t\tdecision := \"unknown\"\n   819\t\t\t\tif run.Status == ReviewRunCompleted && run.SupersededBy == \"\" && reviewSafetyConflict(run) == \"\" {\n   820\t\t\t\t\tdecision = draftReviewDecision(run.Output)\n   821\t\t\t\t\tif len(run.DraftProblems) > 0 {\n   822\t\t\t\t\t\tdecision = \"invalid\"\n   823\t\t\t\t\t}\n   824\t\t\t\t}\n   825\t\t\t\tswitch decision {\n   826\t\t\t\tcase \"invalid\":\n   827\t\t\t\t\tr.InvalidDrafts++\n   828\t\t\t\tcase \"approved\":\n   829\t\t\t\t\tr.ApprovedDrafts++\n   830\t\t\t\tcase \"changes-requested\", \"rejected\":\n   831\t\t\t\t\tr.RejectingDrafts++\n   832\t\t\t\tdefault:\n   833\t\t\t\t\tr.UnknownDrafts++\n   834\t\t\t\t}\n   835\t\t\t}\n   836\t\t}\n   837\t\tsort.Slice(events, func(i, j int) bool {\n   838\t\t\ta, _ := time.Parse(time.RFC3339Nano, events[i].at)\n   839\t\t\tb, _ := time.Parse(time.RFC3339Nano, events[j].at)\n   840\t\t\tif !a.Equal(b) {\n   841\t\t\t\treturn a.Before(b)\n   842\t\t\t}\n   843\t\t\treturn events[i].id < events[j].id\n   844\t\t})\n   845\t\tseenBundle := map[string]bool{}\n   846\t\tfor _, e := range events {\n   847\t\t\tif inWindow(e.at) {\n   848\t\t\t\tfor _, r := range []*DelegatedReviewMetric{row(bundles, e.bundle), row(adapters, e.adapter)} {\n   849\t\t\t\t\tr.Attempts++\n   850\t\t\t\t\tif seenBundle[e.bundle] {\n   851\t\t\t\t\t\tr.Reruns++\n   852\t\t\t\t\t\tif e.reason == \"\" {\n   853\t\t\t\t\t\t\tr.RerunsWithoutReason++\n   854\t\t\t\t\t\t}\n   855\t\t\t\t\t}\n   856\t\t\t\t}\n   857\t\t\t}\n   858\t\t\tseenBundle[e.bundle] = true\n   859\t\t}\n   860\t\tfinish := func(group map[string]*DelegatedReviewMetric) []DelegatedReviewMetric {\n   861\t\t\tout := []DelegatedReviewMetric{}\n   862\t\t\tfor _, r := range group {\n   863\t\t\t\tn := r.ApprovedDrafts + r.RejectingDrafts\n   864\t\t\t\tif n > 0 {\n   865\t\t\t\t\trate := float64(r.ApprovedDrafts) / float64(n)\n   866\t\t\t\t\tr.ApprovalRate = &rate\n   867\t\t\t\t}\n   868\t\t\t\tout = append(out, *r)\n   869\t\t\t}\n   870\t\t\tsort.Slice(out, func(i, j int) bool { return out[i].Key < out[j].Key })\n   871\t\t\treturn out\n   872\t\t}\n   873\t\tresult.ByBundle = finish(bundles)\n   874\t\tresult.ByAdapter = finish(adapters)\n   875\t\treturn result\n   876\t}\n   877\t\n   878\t// reserveDelegatedReviewAttempt prepares and publishes a reservation at once,\n   879\t// for callers that hold no active marker.\n   880\tfunc (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n   881\t\ta, err := s.prepareDelegatedReviewAttempt(plan, at)\n   882\t\tif err != nil {\n   883\t\t\treturn DelegatedReviewAttempt{}, err\n   884\t\t}\n   885\t\treturn a, s.publishDelegatedReviewAttempt(a)\n   886\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/cli/delegate.go'","aggregated_output":"     1\tpackage cli\n     2\t\n     3\t// pose delegate: the one surface for delegated executions (spec\n     4\t// pose-delegation-surface; ADR 2026-10-26-delegation-is-a-first-class-execution-surface).\n     5\t//\n     6\t// pose review governs the subject (bundle, brief, attestation, verify);\n     7\t// pose delegate governs executions: who runs, with which access, and what\n     8\t// happened. review, adjudicate and smoke run through the delivered dispatch\n     9\t// path; the lifecycle commands read the same run records.\n    10\t//\n    11\t// Every subcommand takes the common flags with one meaning (R2): where a\n    12\t// command starts a run they set it (--agent, --access, --label, --lead);\n    13\t// where it names or lists runs they select them, and a run that does not\n    14\t// match is not the one named; --dry-run changes nothing anywhere.\n    15\t\n    16\timport (\n    17\t\t\"context\"\n    18\t\t\"crypto/rand\"\n    19\t\t\"encoding/json\"\n    20\t\t\"errors\"\n    21\t\t\"fmt\"\n    22\t\t\"io\"\n    23\t\t\"os\"\n    24\t\t\"os/signal\"\n    25\t\t\"path/filepath\"\n    26\t\t\"regexp\"\n    27\t\t\"sort\"\n    28\t\t\"strconv\"\n    29\t\t\"strings\"\n    30\t\t\"syscall\"\n    31\t\t\"time\"\n    32\t\n    33\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    34\t)\n    35\t\n    36\tconst delegateUsageText = \"pose delegate <review|adjudicate|smoke|task|ls|watch|wait|resume|handoff|cancel|agents> [args] [--agent auto|<name>] [--access read|sandboxed|write|full] [--label <name>] [--lead <vendor>] [--dry-run] [--json]\"\n    37\t\n    38\t// Versioned JSON documents of pose delegate (R10).\n    39\tconst (\n    40\t\tdelegateRunSchema    = \"pose.delegate.run/v1\"\n    41\t\tdelegatePlanSchema   = \"pose.delegate.plan/v1\"\n    42\t\tdelegateListSchema   = \"pose.delegate.ls/v1\"\n    43\t\tdelegateCancelSchema = \"pose.delegate.cancel/v1\"\n    44\t\tdelegateAgentsSchema = \"pose.delegate.agents/v1\"\n    45\t\tdelegateErrorSchema  = \"pose.delegate.error/v1\"\n    46\t)\n    47\t\n    48\t// Subcommands named by the ADR whose behaviour a later spec delivers.\n    49\tvar delegatePlanned = map[string]string{}\n    50\t\n    51\tvar (\n    52\t\tdelegateLabelRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n    53\t)\n    54\t\n    55\t// commonDelegateFlags are taken by every subcommand.\n    56\tvar commonDelegateFlags = []string{\"--agent\", \"--access\", \"--label\", \"--lead\", \"--dry-run\", \"--json\"}\n    57\t\n    58\t// tr picks the message for the session's locale.\n    59\tfunc tr(english, portuguese string) string { return cliText(cliLocaleValue(), english, portuguese) }\n    60\t\n    61\ttype delegateFlags struct {\n    62\t\tagent, access, label, lead, reason, noteFile string\n    63\t\trequest                                      string\n    64\t\tto, cd, effort, promptFile, session          string\n    65\t\taddDirs                                      []string\n    66\t\tnoNetwork, record, confirmAbandoned          bool\n    67\t\tdryRun, jsonOut, active, wait, detach        bool\n    68\t\tverbose, noFollow                            bool\n    69\t\tlines                                        int\n    70\t\twaitMax, timeout, refresh                    time.Duration\n    71\t\tpositional                                   []string\n    72\t}\n    73\t\n    74\t// parseDelegateFlags reads the common flags and the extra ones a subcommand\n    75\t// takes; problem is a message for the person, in their locale.\n    76\tfunc parseDelegateFlags(args []string, extra ...string) (delegateFlags, string) {\n    77\t\tf := delegateFlags{waitMax: 24 * time.Hour}\n    78\t\tpermit := map[string]bool{}\n    79\t\tfor _, name := range append(append([]string(nil), commonDelegateFlags...), extra...) {\n    80\t\t\tpermit[name] = true\n    81\t\t}\n    82\t\tfor i := 0; i < len(args); i++ {\n    83\t\t\targ := args[i]\n    84\t\t\tname, inline, hasInline := strings.Cut(arg, \"=\")\n    85\t\t\t// A lone - names stdin (spec pose-delegation-task R1).\n    86\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n    87\t\t\t\tf.positional = append(f.positional, arg)\n    88\t\t\t\tcontinue\n    89\t\t\t}\n    90\t\t\tif !permit[name] {\n    91\t\t\t\treturn f, tr(\"unknown or inapplicable flag \"+name, \"flag desconhecida ou inaplicável \"+name)\n    92\t\t\t}\n    93\t\t\tswitch name {\n    94\t\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\", \"--confirm-abandoned\":\n    95\t\t\t\tif hasInline {\n    96\t\t\t\t\treturn f, tr(name+\" takes no value\", name+\" não recebe valor\")\n    97\t\t\t\t}\n    98\t\t\t\tswitch name {\n    99\t\t\t\tcase \"--dry-run\":\n   100\t\t\t\t\tf.dryRun = true\n   101\t\t\t\tcase \"--json\":\n   102\t\t\t\t\tf.jsonOut = true\n   103\t\t\t\tcase \"--detach\":\n   104\t\t\t\t\tf.detach = true\n   105\t\t\t\tcase \"-v\":\n   106\t\t\t\t\tf.verbose = true\n   107\t\t\t\tcase \"--no-network\":\n   108\t\t\t\t\tf.noNetwork = true\n   109\t\t\t\tcase \"--record\":\n   110\t\t\t\t\tf.record = true\n   111\t\t\t\tcase \"--confirm-abandoned\":\n   112\t\t\t\t\tf.confirmAbandoned = true\n   113\t\t\t\tcase \"--no-follow\":\n   114\t\t\t\t\tf.noFollow = true\n   115\t\t\t\tdefault:\n   116\t\t\t\t\tf.active = true\n   117\t\t\t\t}\n   118\t\t\tcase \"--wait-until-reset\":\n   119\t\t\t\tf.wait = true\n   120\t\t\t\tif hasInline {\n   121\t\t\t\t\td, err := time.ParseDuration(inline)\n   122\t\t\t\t\tif err != nil || d <= 0 || d > 24*time.Hour {\n   123\t\t\t\t\t\treturn f, tr(\"--wait-until-reset takes a duration up to 24h\", \"--wait-until-reset recebe uma duração de até 24h\")\n   124\t\t\t\t\t}\n   125\t\t\t\t\tf.waitMax = d\n   126\t\t\t\t}\n   127\t\t\tdefault:\n   128\t\t\t\tvalue := inline\n   129\t\t\t\tif !hasInline {\n   130\t\t\t\t\t// --prompt - reads stdin (spec pose-delegation-task R8).\n   131\t\t\t\t\tif i+1 >= len(args) || strings.HasPrefix(args[i+1], \"-\") && !(name == \"--prompt\" && args[i+1] == \"-\") {\n   132\t\t\t\t\t\treturn f, tr(name+\" needs a value\", name+\" precisa de um valor\")\n   133\t\t\t\t\t}\n   134\t\t\t\t\tvalue = args[i+1]\n   135\t\t\t\t\ti++\n   136\t\t\t\t}\n   137\t\t\t\tswitch name {\n   138\t\t\t\tcase \"--agent\":\n   139\t\t\t\t\tf.agent = value\n   140\t\t\t\tcase \"--access\":\n   141\t\t\t\t\tif !containsString([]string{posemodel.DelegationAccessRead, posemodel.DelegationAccessSandboxed, posemodel.DelegationAccessWrite, posemodel.DelegationAccessFull}, value) {\n   142\t\t\t\t\t\treturn f, tr(\"--access takes read, sandboxed, write or full\", \"--access recebe read, sandboxed, write ou full\")\n   143\t\t\t\t\t}\n   144\t\t\t\t\tf.access = value\n   145\t\t\t\tcase \"--label\":\n   146\t\t\t\t\tif !delegateLabelRE.MatchString(value) {\n   147\t\t\t\t\t\treturn f, tr(\"--label takes letters, digits, '.', '_' and '-' (64 at most)\", \"--label aceita letras, dígitos, '.', '_' e '-' (no máximo 64)\")\n   148\t\t\t\t\t}\n   149\t\t\t\t\tf.label = value\n   150\t\t\t\tcase \"--lead\":\n   151\t\t\t\t\tvendor, model, err := posemodel.ParseLead(value)\n   152\t\t\t\t\tif err != nil {\n   153\t\t\t\t\t\treturn f, tr(\"--lead takes <vendor>[/<model>], such as openai or anthropic/claude-opus-5-5\", \"--lead recebe <vendor>[/<modelo>], como openai ou anthropic/claude-opus-5-5\")\n   154\t\t\t\t\t}\n   155\t\t\t\t\tf.lead = vendor\n   156\t\t\t\t\tif model != \"\" {\n   157\t\t\t\t\t\tf.lead += \"/\" + model\n   158\t\t\t\t\t}\n   159\t\t\t\tcase \"--reason\":\n   160\t\t\t\t\tf.reason = value\n   161\t\t\t\tcase \"--session\":\n   162\t\t\t\t\tf.session = value\n   163\t\t\t\tcase \"--request\":\n   164\t\t\t\t\tf.request = value\n   165\t\t\t\tcase \"--lines\":\n   166\t\t\t\t\tn, err := strconv.Atoi(value)\n   167\t\t\t\t\tif err != nil || n < 1 || n > 1000 {\n   168\t\t\t\t\t\treturn f, tr(\"--lines takes a number from 1 to 1000\", \"--lines recebe um número de 1 a 1000\")\n   169\t\t\t\t\t}\n   170\t\t\t\t\tf.lines = n\n   171\t\t\t\tcase \"--refresh\":\n   172\t\t\t\t\td, err := time.ParseDuration(value)\n   173\t\t\t\t\tif err != nil || d < 0 || d > time.Hour {\n   174\t\t\t\t\t\treturn f, tr(\"--refresh takes a duration from 0 to 1h (0 turns the preview's refresh off)\", \"--refresh recebe uma duração de 0 a 1h (0 desliga a atualização do preview)\")\n   175\t\t\t\t\t}\n   176\t\t\t\t\tf.refresh = d\n   177\t\t\t\tcase \"--timeout\":\n   178\t\t\t\t\td, err := time.ParseDuration(value)\n   179\t\t\t\t\tif err != nil || d <= 0 {\n   180\t\t\t\t\t\treturn f, tr(\"--timeout takes a positive duration\", \"--timeout recebe uma duração positiva\")\n   181\t\t\t\t\t}\n   182\t\t\t\t\tf.timeout = d\n   183\t\t\t\tcase \"--to\":\n   184\t\t\t\t\tf.to = value\n   185\t\t\t\tcase \"--cd\":\n   186\t\t\t\t\tf.cd = value\n   187\t\t\t\tcase \"--add-dir\":\n   188\t\t\t\t\tf.addDirs = append(f.addDirs, value)\n   189\t\t\t\tcase \"--effort\":\n   190\t\t\t\t\tf.effort = value\n   191\t\t\t\tcase \"--prompt\":\n   192\t\t\t\t\tf.promptFile = value\n   193\t\t\t\tcase \"--note-file\":\n   194\t\t\t\t\tf.noteFile = value\n   195\t\t\t\t}\n   196\t\t\t}\n   197\t\t}\n   198\t\treturn f, \"\"\n   199\t}\n   200\t\n   201\tfunc cmdDelegate(root string, args []string, stdout, stderr io.Writer) int {\n   202\t\tif len(args) == 0 {\n   203\t\t\tdispatchCommandHelp(\"delegate\", nil, stdout, cliLocaleValue())\n   204\t\t\treturn 0\n   205\t\t}\n   206\t\tsub, rest := args[0], args[1:]\n   207\t\tif spec, planned := delegatePlanned[sub]; planned {\n   208\t\t\treturn delegateUsage(stdout, stderr, rest, sub, tr(\"not available yet; it is delivered by spec \"+spec, \"ainda não está disponível; é entregue pela spec \"+spec))\n   209\t\t}\n   210\t\tswitch sub {\n   211\t\tcase posemodel.DelegationPurposeReview, posemodel.DelegationPurposeAdjudicate, posemodel.DelegationPurposeSmoke:\n   212\t\t\treturn cmdDelegatePurpose(root, sub, rest, stdout, stderr)\n   213\t\tcase posemodel.DelegationPurposeTask:\n   214\t\t\treturn cmdDelegateTask(root, rest, stdout, stderr)\n   215\t\tcase \"ls\":\n   216\t\t\treturn cmdDelegateLs(root, rest, stdout, stderr)\n   217\t\tcase \"resume\":\n   218\t\t\treturn cmdDelegateResume(root, rest, stdout, stderr)\n   219\t\tcase \"cancel\":\n   220\t\t\treturn cmdDelegateCancel(root, rest, stdout, stderr)\n   221\t\tcase \"agents\":\n   222\t\t\treturn cmdDelegateAgents(root, rest, stdout, stderr)\n   223\t\tcase \"wait\":\n   224\t\t\treturn cmdDelegateWait(root, rest, stdout, stderr)\n   225\t\tcase \"watch\":\n   226\t\t\treturn cmdDelegateWatch(root, rest, stdout, stderr)\n   227\t\tcase \"handoff\":\n   228\t\t\treturn cmdDelegateHandoff(root, rest, stdout, stderr)\n   229\t\t}\n   230\t\treturn delegateUsage(stdout, stderr, rest, sub, tr(\"unknown subcommand\", \"subcomando desconhecido\")+\"\\n\"+tr(\"Usage: \", \"Uso: \")+delegateUsageText)\n   231\t}\n   232\t\n   233\t// delegateUsage reports a usage error: exit 2, as text, or as the error\n   234\t// document when the caller asked for --json (R10).\n   235\tfunc delegateUsage(stdout, stderr io.Writer, args []string, command, msg string) int {\n   236\t\tfor _, arg := range args {\n   237\t\t\tif arg == \"--json\" {\n   238\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg, \"usage\": true})\n   239\t\t\t\treturn 2\n   240\t\t\t}\n   241\t\t}\n   242\t\thandBackRefusal(map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg, \"usage\": true}, 2)\n   243\t\treturn usageError(stderr, \"pose delegate \"+command+\": \"+msg)\n   244\t}\n   245\t\n   246\tfunc writeDelegateJSON(stdout io.Writer, doc any) {\n   247\t\t// Every error document a detached run writes is handed back (B03); a\n   248\t\t// caller that knows its exit code hands it back first.\n   249\t\tif m, ok := doc.(map[string]any); ok && m[\"schema\"] == delegateErrorSchema {\n   250\t\t\tcode := 1\n   251\t\t\tif m[\"usage\"] == true {\n   252\t\t\t\tcode = 2\n   253\t\t\t}\n   254\t\t\thandBackRefusal(m, code)\n   255\t\t}\n   256\t\tenc := json.NewEncoder(stdout)\n   257\t\tenc.SetIndent(\"\", \"  \")\n   258\t\t_ = enc.Encode(doc)\n   259\t}\n   260\t\n   261\t// delegateFail reports a failure as text or as the error document.\n   262\tfunc delegateFail(stdout, stderr io.Writer, jsonOut bool, command string, code int, err error) int {\n   263\t\tmsg := strings.TrimPrefix(err.Error(), \"pose: \")\n   264\t\tdoc := map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg}\n   265\t\t// The reason code of a refusal is the same over MCP (spec\n   266\t\t// pose-delegation-mcp R5).\n   267\t\tif code := posemodel.DelegationReasonCode(err); code != \"\" {\n   268\t\t\tdoc[\"reason_code\"] = code\n   269\t\t}\n   270\t\tvar ambiguous *posemodel.ErrDelegationRefAmbiguous\n   271\t\tif errors.As(err, &ambiguous) {\n   272\t\t\tdoc[\"candidates\"] = ambiguous.Candidates\n   273\t\t}\n   274\t\thandBackRefusal(doc, code)\n   275\t\tif jsonOut {\n   276\t\t\twriteDelegateJSON(stdout, doc)\n   277\t\t\treturn code\n   278\t\t}\n   279\t\tif code == 2 {\n   280\t\t\treturn usageError(stderr, \"pose delegate \"+command+\": \"+msg)\n   281\t\t}\n   282\t\trender(stdout, stderr).Failure(\"pose delegate \" + command + \": \" + msg)\n   283\t\treturn code\n   284\t}\n   285\t\n   286\t// refError renders a reference error in the person's locale.\n   287\tfunc refError(err error) error {\n   288\t\tvar ambiguous *posemodel.ErrDelegationRefAmbiguous\n   289\t\tif errors.As(err, &ambiguous) {\n   290\t\t\treturn localizedRefError{err: ambiguous, msg: tr(err.Error(), \"a referência nomeia mais de um run delegado: \"+strings.Join(ambiguous.Candidates, \", \"))}\n   291\t\t}\n   292\t\tvar unknown *posemodel.ErrDelegationRefUnknown\n   293\t\tif errors.As(err, &unknown) {\n   294\t\t\treturn errors.New(tr(err.Error(), \"nenhum run delegado corresponde à referência (um id de run, um id de tentativa, um label ou um prefixo de sessão de seis caracteres ou mais)\"))\n   295\t\t}\n   296\t\treturn err\n   297\t}\n   298\t\n   299\t// localizedRefError words a reference error in the person's locale and keeps\n   300\t// the engine's error, so the error document still carries its candidates.\n   301\ttype localizedRefError struct {\n   302\t\terr error\n   303\t\tmsg string\n   304\t}\n   305\t\n   306\tfunc (e localizedRefError) Error() string { return e.msg }\n   307\tfunc (e localizedRefError) Unwrap() error { return e.err }\n   308\t\n   309\t// mismatch names the first selecting flag an attempt does not match.\n   310\tfunc (f delegateFlags) mismatch(a posemodel.DelegationAttempt) string {\n   311\t\tswitch {\n   312\t\tcase f.agent != \"\" && f.agent != \"auto\" && f.agent != a.Agent:\n   313\t\t\treturn \"--agent \" + f.agent\n   314\t\tcase f.access != \"\" && f.access != a.Access:\n   315\t\t\treturn \"--access \" + f.access\n   316\t\tcase f.label != \"\" && f.label != a.Label:\n   317\t\t\treturn \"--label \" + f.label\n   318\t\tcase f.lead != \"\" && f.lead != a.Lead && leadVendor(f.lead) != a.Lead:\n   319\t\t\treturn \"--lead \" + f.lead\n   320\t\t}\n   321\t\treturn \"\"\n   322\t}\n   323\t\n   324\t// namedAttempt resolves the one reference a lifecycle command takes: the\n   325\t// positional reference, or --label when there is none; the other common\n   326\t// flags then select, and a run that does not match is refused.\n   327\tfunc namedAttempt(attempts []posemodel.DelegationAttempt, f delegateFlags) (posemodel.DelegationAttempt, int, error) {\n   328\t\tref := \"\"\n   329\t\tswitch len(f.positional) {\n   330\t\tcase 0:\n   331\t\t\tref = f.label\n   332\t\tcase 1:\n   333\t\t\tref = f.positional[0]\n   334\t\tdefault:\n   335\t\t\treturn posemodel.DelegationAttempt{}, 2, errors.New(tr(\"one run reference at most\", \"no máximo uma referência de run\"))\n   336\t\t}\n   337\t\tif ref == \"\" {\n   338\t\t\treturn posemodel.DelegationAttempt{}, 2, errors.New(tr(\"name a run (a run id, an attempt id, a label or a session prefix)\", \"nomeie um run (id de run, id de tentativa, label ou prefixo de sessão)\"))\n   339\t\t}\n   340\t\tattempt, err := posemodel.ResolveDelegationRef(attempts, ref)\n   341\t\tif err != nil {\n   342\t\t\treturn attempt, 2, refError(err)\n   343\t\t}\n   344\t\tif flag := f.mismatch(attempt); flag != \"\" {\n   345\t\t\treturn attempt, 2, errors.New(tr(\"attempt \"+attempt.AttemptID+\" does not match \"+flag, \"a tentativa \"+attempt.AttemptID+\" não corresponde a \"+flag))\n   346\t\t}\n   347\t\treturn attempt, 0, nil\n   348\t}\n   349\t\n   350\t// routeDelegateAgent applies --agent (spec pose-delegation-routing R5–R9): a\n   351\t// name is taken as given and the run still records the independence it\n   352\t// achieves; auto (or no flag) routes among the agents that can run the\n   353\t// purpose. The returned warnings go to stderr.\n   354\tfunc routeDelegateAgent(store posemodel.Store, kind, ref, notes string, f delegateFlags, now time.Time) (string, *posemodel.DelegationRoutingRecord, string, int, error) {\n   355\t\treaders, found, err := store.LoadReviewersPolicyFor(kind)\n   356\t\tif err != nil {\n   357\t\t\treturn \"\", nil, \"\", 1, err\n   358\t\t}\n   359\t\tif !found || len(readers.Adapters) == 0 {\n   360\t\t\treturn \"\", nil, \"\", 1, posemodel.ErrNoReviewerAdapter\n   361\t\t}\n   362\t\tpolicy, _, _, err := store.LoadDelegationPolicy()\n   363\t\tif err != nil {\n   364\t\t\treturn \"\", nil, \"\", 1, err\n   365\t\t}\n   366\t\tbrief, err := store.RenderReviewBrief(ref, kind, notes)\n   367\t\tif err != nil {\n   368\t\t\treturn \"\", nil, \"\", 1, err\n   369\t\t}\n   370\t\tbundle, err := store.LoadReviewBundle(brief.BundleID)\n   371\t\tif err != nil {\n   372\t\t\treturn \"\", nil, \"\", 1, err\n   373\t\t}\n   374\t\treviewPolicy, err := store.GetReviewPolicy()\n   375\t\tif err != nil {\n   376\t\t\treturn \"\", nil, bundle.BundleID, 1, err\n   377\t\t}\n   378\t\texecutionRequired := reviewPolicy.DelegatedReview || bundle.Payload.Plan.DelegatedRunProofRequired\n   379\t\tif executionRequired && bundle.Payload.Plan.Independence == \"mandatory-human\" {\n   380\t\t\treturn \"\", nil, bundle.BundleID, 1, &posemodel.ErrNoDelegationAgentAvailable{}\n   381\t\t}\n   382\t\tif f.agent != \"\" && f.agent != \"auto\" {\n   383\t\t\t// A named agent is recorded by the plan itself (R9).\n   384\t\t\treturn f.agent, nil, bundle.BundleID, 0, nil\n   385\t\t}\n   386\t\timpl, from, err := store.RoutingImplementation(bundle, policy, f.lead)\n   387\t\tif err != nil {\n   388\t\t\treturn \"\", nil, \"\", 2, err\n   389\t\t}\n   390\t\teligible := make([]string, 0, len(readers.Adapters))\n   391\t\tfor name := range readers.Adapters {\n   392\t\t\teligible = append(eligible, name)\n   393\t\t}\n   394\t\tavail := store.DelegationAvailabilityOf(policy, now, true)\n   395\t\tif executionRequired && bundle.Payload.Plan.Independence == \"different-actor\" {\n   396\t\t\tfor name, candidate := range policy.Agents {\n   397\t\t\t\tachieved := posemodel.AchievedIndependence(impl.Vendor, impl.Model, candidate.Vendor, candidate.Model)\n   398\t\t\t\tif achieved != \"different-vendor\" && achieved != \"different-model\" {\n   399\t\t\t\t\ta := avail[name]\n   400\t\t\t\t\ta.State, a.Detail = posemodel.DelegationAgentIneligible, \"cannot establish required vendor/model independence\"\n   401\t\t\t\t\tavail[name] = a\n   402\t\t\t\t}\n   403\t\t\t}\n   404\t\t}\n   405\t\tagent, record, err := posemodel.RouteDelegation(policy, eligible, impl, from, avail, now)\n   406\t\tif err != nil {\n   407\t\t\treturn \"\", &record, bundle.BundleID, 1, err\n   408\t\t}\n   409\t\treturn agent, &record, bundle.BundleID, 0, nil\n   410\t}\n   411\t\n   412\t// leadVendor is the vendor part of a --lead value.\n   413\tfunc leadVendor(lead string) string {\n   414\t\tvendor, _, _ := strings.Cut(lead, \"/\")\n   415\t\treturn vendor\n   416\t}\n   417\t\n   418\t// waitForRoute sleeps until the reset the wait step chose, without polling,\n   419\t// or until ctx ends (R7).\n   420\tfunc waitForRoute(ctx context.Context, stderr io.Writer, record *posemodel.DelegationRoutingRecord, agent string) error {\n   421\t\tif record == nil || record.Step != posemodel.DelegationStepWait {\n   422\t\t\treturn nil\n   423\t\t}\n   424\t\tuntil, err := time.Parse(time.RFC3339Nano, record.WaitUntil)\n   425\t\tif err != nil {\n   426\t\t\treturn err\n   427\t\t}\n   428\t\trender(io.Discard, stderr).Hint(tr(\"pose delegate: every earlier agent is limited; waiting until \"+record.WaitUntil+\" to start \"+agent,\n   429\t\t\t\"pose delegate: todos os agentes anteriores estão limitados; esperando até \"+record.WaitUntil+\" para iniciar \"+agent))\n   430\t\ttimer := time.NewTimer(time.Until(until))\n   431\t\tdefer timer.Stop()\n   432\t\tselect {\n   433\t\tcase <-ctx.Done():\n   434\t\t\treturn ctx.Err()\n   435\t\tcase <-timer.C:\n   436\t\t\treturn nil\n   437\t\t}\n   438\t}\n   439\t\n   440\tfunc cmdDelegatePurpose(root, purpose string, args []string, stdout, stderr io.Writer) int {\n   441\t\tf, problem := parseDelegateFlags(args, \"--reason\", \"--note-file\", \"--detach\", \"--request\")\n   442\t\tif problem != \"\" {\n   443\t\t\treturn delegateUsage(stdout, stderr, args, purpose, problem)\n   444\t\t}\n   445\t\tif len(f.positional) != 1 {\n   446\t\t\treturn delegateUsage(stdout, stderr, args, purpose, tr(\"Usage: \", \"Uso: \")+\"pose delegate \"+purpose+\" <scope|bundle-id> [--agent auto|<name>] [--label <name>] [--lead <vendor>] [--reason <text>] [--note-file <path>] [--dry-run] [--json]\")\n   447\t\t}\n   448\t\t// A detached run is this command run again in its own session (R1).\n   449\t\tif f.detach && !f.dryRun && !delegateSupervised() {\n   450\t\t\treturn detachDelegateRun(root, purpose, args, f, stdout, stderr)\n   451\t\t}\n   452\t\t// R3: the review-path purposes read only.\n   453\t\tif f.access != \"\" && f.access != posemodel.DelegationAccessRead {\n   454\t\t\treturn delegateUsage(stdout, stderr, args, purpose, tr(\"runs with read access only; --access \"+f.access+\" is for pose delegate task\",\n   455\t\t\t\t\"roda só com acesso de leitura; --access \"+f.access+\" é para pose delegate task\"))\n   456\t\t}\n   457\t\tnotes := \"\"\n   458\t\tif f.noteFile != \"\" {\n   459\t\t\t// R5 of spec pose-review-readiness-before-seal: an oversized note is\n   460\t\t\t// named with its size and the limit, not as a generic adapter file.\n   461\t\t\tif info, err := os.Lstat(f.noteFile); err == nil && info.Mode().IsRegular() && info.Size() > posemodel.ReviewNotesMaxBytes {\n   462\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, fmt.Errorf(\"the note file %s has %d bytes; implementer notes must be at most %d bytes: shorten it\", f.noteFile, info.Size(), posemodel.ReviewNotesMaxBytes))\n   463\t\t\t}\n   464\t\t\traw, err := posemodel.ReadReviewAdapterFile(f.noteFile, posemodel.ReviewNotesMaxBytes)\n   465\t\t\tif err != nil {\n   466\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n   467\t\t\t}\n   468\t\t\tnotes = string(raw)\n   469\t\t}\n   470\t\tstore := cliGovernedStore(root)\n   471\t\ttarget := f.positional[0]\n   472\t\tref := target\n   473\t\tif !strings.HasPrefix(target, \"rvb-\") {\n   474\t\t\tresolved, err := resolveReviewBundleScope(store, target)\n   475\t\t\tif err != nil {\n   476\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n   477\t\t\t}\n   478\t\t\tref = resolved\n   479\t\t}\n   480\t\t// A run asked for by a delegated-review request runs the request's brief\n   481\t\t// with an agent it accepts, and fulfils it (spec\n   482\t\t// pose-delegated-review-action-fulfillment R3).\n   483\t\tvar request *posemodel.ActionRequestView\n   484\t\tif f.request != \"\" {\n   485\t\t\tview, err := delegateRequestFor(store, &f, purpose, ref, notes)\n   486\t\t\tif err != nil {\n   487\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n   488\t\t\t}\n   489\t\t\trequest = &view\n   490\t\t}\n   491\t\tkind := posemodel.DelegationKindForPurpose(purpose)\n   492\t\tagent, route, routedBundle, code, err := routeDelegateAgent(store, kind, ref, notes, f, time.Now())\n   493\t\tvar unavailable *posemodel.ErrNoDelegationAgentAvailable\n   494\t\tif f.dryRun && f.jsonOut && (errors.Is(err, posemodel.ErrNoReviewerAdapter) || errors.As(err, &unavailable)) {\n   495\t\t\trequired, policyErr := store.DelegatedReviewExecutionRequired(ref)\n   496\t\t\tif policyErr != nil {\n   497\t\t\t\treturn delegateFail(stdout, stderr, true, purpose, 1, policyErr)\n   498\t\t\t}\n   499\t\t\tif required {\n   500\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": purpose, \"error\": err.Error(), \"routing\": route, \"reason_code\": posemodel.DelegationReasonAgentUnavailable, \"escalation_required\": true})\n   501\t\t\t\treturn 1\n   502\t\t\t}\n   503\t\t}\n   504\t\tif !f.dryRun && (errors.Is(err, posemodel.ErrNoReviewerAdapter) || errors.As(err, &unavailable)) {\n   505\t\t\tid, escalationErr := store.EscalateUnavailableDelegation(ref, purpose, err.Error(), time.Now())\n   506\t\t\tif escalationErr != nil {\n   507\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, fmt.Errorf(\"%w; escalation could not be recorded: %v\", err, escalationErr))\n   508\t\t\t}\n   509\t\t\tif id != \"\" {\n   510\t\t\t\tif f.jsonOut {\n   511\t\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": purpose, \"error\": err.Error(), \"escalation\": id, \"routing\": route})\n   512\t\t\t\t\treturn 1\n   513\t\t\t\t}\n   514\t\t\t\treturn delegateFail(stdout, stderr, false, purpose, 1, fmt.Errorf(\"%w; decision request %s asks the maintainer how to proceed\", err, id))\n   515\t\t\t}\n   516\t\t}\n   517\t\tif errors.Is(err, posemodel.ErrNoReviewerAdapter) {\n   518\t\t\treturn delegateNoAgentWithBrief(store, ref, kind, notes, f, purpose, stdout, stderr)\n   519\t\t}\n   520\t\tif err != nil {\n   521\t\t\tvar none *posemodel.ErrNoDelegationAgentAvailable\n   522\t\t\tif errors.As(err, &none) && f.jsonOut {\n   523\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": purpose, \"error\": strings.TrimPrefix(err.Error(), \"pose: \"), \"routing\": none.Record, \"reason_code\": posemodel.DelegationReasonCode(err)})\n   524\t\t\t\treturn code\n   525\t\t\t}\n   526\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, code, err)\n   527\t\t}\n   528\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n   529\t\tdefer stop()\n   530\t\tif !f.dryRun && route != nil && route.Step == posemodel.DelegationStepWait {\n   531\t\t\t// A detached run hands its attempt back when it starts; one that would\n   532\t\t\t// first wait hours for a reset has none to hand back (D3).\n   533\t\t\tif delegateSupervised() {\n   534\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, errors.New(tr(\"every agent is limited until \"+route.WaitUntil+\"; a detached run does not wait for a reset: run it without --detach, or after the reset\",\n   535\t\t\t\t\t\"todos os agentes estão limitados até \"+route.WaitUntil+\"; um run destacado não espera um reset: rode sem --detach, ou depois do reset\")))\n   536\t\t\t}\n   537\t\t\tif err := waitForRoute(ctx, stderr, route, agent); err != nil {\n   538\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n   539\t\t\t}\n   540\t\t\t// The bundle or the policy may have changed during the wait: route\n   541\t\t\t// again against what the run will read, and start only the same agent\n   542\t\t\t// (R7, R8).\n   543\t\t\tagain, rerouted, rebundle, code, err := routeDelegateAgent(store, kind, ref, notes, f, time.Now())\n   544\t\t\tif err != nil {\n   545\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, code, err)\n   546\t\t\t}\n   547\t\t\tif again != agent || rebundle != routedBundle || rerouted.Step == posemodel.DelegationStepWait {\n   548\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, errors.New(tr(\"the bundle, the policy or the agents changed while waiting; run pose delegate again\",\n   549\t\t\t\t\t\"o bundle, a policy ou os agentes mudaram durante a espera; rode pose delegate de novo\")))\n   550\t\t\t}\n   551\t\t\troute.Implementation, route.ImplementationFrom = rerouted.Implementation, rerouted.ImplementationFrom\n   552\t\t}\n   553\t\tplan, err := store.PlanReviewDispatch(ref, kind, notes, agent, f.reason)\n   554\t\tif errors.Is(err, posemodel.ErrNoReviewerAdapter) {\n   555\t\t\treturn delegateNoAgentWithBrief(store, ref, kind, notes, f, purpose, stdout, stderr)\n   556\t\t}\n   557\t\tif err != nil {\n   558\t\t\tdelegateEscalateRefusal(store, request, err, f.dryRun, stdout, stderr)\n   559\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n   560\t\t}\n   561\t\tif request != nil && plan.Brief.Digest != request.Request.Review.BriefDigest {\n   562\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, errors.New(tr(\"the brief changed since request \"+request.Request.ID+\" was asked; ask it again\",\n   563\t\t\t\t\"o brief mudou desde que o request \"+request.Request.ID+\" foi pedido; peça de novo\")))\n   564\t\t}\n   565\t\tif plan.Bundle.BundleID != routedBundle {\n   566\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, errors.New(tr(\"the bundle of the scope changed while the run was being routed; run pose delegate again\",\n   567\t\t\t\t\"o bundle do escopo mudou enquanto o run era roteado; rode pose delegate de novo\")))\n   568\t\t}\n   569\t\tplan.Label, plan.Purpose, plan.Lead = f.label, purpose, f.lead\n   570\t\twarnings := plan.Warnings\n   571\t\tif route == nil {\n   572\t\t\tstore.PlanImplementationWithLead(&plan, f.lead)\n   573\t\t\twarnings = plan.Warnings\n   574\t\t\tif plan.SameVendorWarning != \"\" {\n   575\t\t\t\twarnings = append(warnings, plan.SameVendorWarning)\n   576\t\t\t}\n   577\t\t} else {\n   578\t\t\tplan.Routing = route\n   579\t\t}\n   580\t\tfor _, warning := range warnings {\n   581\t\t\trender(stdout, stderr).Hint(\"pose delegate \" + purpose + \": \" + warning)\n   582\t\t}\n   583\t\timpl := plan.Implementation()\n   584\t\tindependence := posemodel.AchievedIndependence(impl.Vendor, impl.Model, plan.Config.Vendor, plan.Config.Model)\n   585\t\tif f.dryRun {\n   586\t\t\targv := redactArgv(posemodel.ReviewerArgv(plan.Config.Command, \"{output}\", \"\", plan.Effort, plan.Config.Effort), plan.Config)\n   587\t\t\treturn delegatePrintPlan(stdout, stderr, f.jsonOut, plan, argv, map[string]any{\"scope\": plan.Brief.Scope, \"bundle\": plan.Bundle.BundleID,\n   588\t\t\t\t\"brief_digest\": plan.Brief.Digest, \"prior_runs\": plan.PriorRuns, \"label\": plan.Label, \"lead\": plan.Lead,\n   589\t\t\t\t\"routing\": plan.Routing, \"independence\": independence, \"implementation\": posemodel.DescribeImplementation(impl)})\n   590\t\t}\n   591\t\tif delegateSupervised() {\n   592\t\t\tplan.OnStart = supervisorHandback()\n   593\t\t}\n   594\t\t// The containment the run will run under is disclosed before it runs, as\n   595\t\t// pose review dispatch disclosed it (spec pose-delegation-parity-gate R6;\n   596\t\t// review round 1, PG-R1-08); the JSON document carries it with the run.\n   597\t\tif safety, _ := posemodel.ResolveReviewerContainment(plan.Config); safety != nil && !f.jsonOut {\n   598\t\t\traw, _ := json.Marshal(safety)\n   599\t\t\trender(stdout, stderr).Field(\"delegate.safety\", string(raw))\n   600\t\t}\n   601\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n   602\t\thandBackExisting(run, err)\n   603\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n   604\t\tif request != nil {\n   605\t\t\tdelegateFulfilRequest(store, *request, run, err, stdout, stderr)\n   606\t\t}\n   607\t\tdelegateTerminalHook(store, run, err, stdout, stderr, purpose)\n   608\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, purpose, run, err, delegateRunNextActions(store, run, err)...)\n   609\t\tif err == nil && !f.jsonOut && !delegateSupervised() {\n   610\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n   611\t\t\t\treturn next\n   612\t\t\t}\n   613\t\t}\n   614\t\treturn code\n   615\t}\n   616\t\n   617\t// delegateNoAgentWithBrief refuses a review-path run no agent can take and\n   618\t// hands over the brief a reviewer would receive, so the review can still be\n   619\t// run by hand, as pose review dispatch did (spec pose-delegation-parity-gate\n   620\t// R6; review round 1, PG-R1-06).\n   621\tfunc delegateNoAgentWithBrief(store posemodel.Store, ref, kind, notes string, f delegateFlags, command string, stdout, stderr io.Writer) int {\n   622\t\tplan, _ := store.PlanReviewDispatch(ref, kind, notes, \"\", f.reason)\n   623\t\tbrief := plan.Brief.Text\n   624\t\tif brief == \"\" {\n   625\t\t\treturn delegateNoAgent(stdout, stderr, f.jsonOut, command)\n   626\t\t}\n   627\t\tif f.jsonOut {\n   628\t\t\tdoc := map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": strings.TrimPrefix(posemodel.ErrNoReviewerAdapter.Error(), \"pose: \"),\n   629\t\t\t\t\"brief\": brief, \"brief_digest\": plan.Brief.Digest}\n   630\t\t\tif code := posemodel.DelegationReasonCode(posemodel.ErrNoReviewerAdapter); code != \"\" {\n   631\t\t\t\tdoc[\"reason_code\"] = code\n   632\t\t\t}\n   633\t\t\thandBackRefusal(doc, 1)\n   634\t\t\twriteDelegateJSON(stdout, doc)\n   635\t\t\treturn 1\n   636\t\t}\n   637\t\tcode := delegateNoAgent(stdout, stderr, false, command)\n   638\t\tout := render(stdout, stderr)\n   639\t\tout.Hint(tr(\"The brief a reviewer would receive follows.\", \"O brief que um revisor receberia vem a seguir.\"))\n   640\t\tout.ContractLine(strings.TrimRight(brief, \"\\n\"))\n   641\t\treturn code\n   642\t}\n   643\t\n   644\tfunc delegateNoAgent(stdout, stderr io.Writer, jsonOut bool, command string) int {\n   645\t\t// The document keeps the typed refusal and no example: the example is\n   646\t\t// for a person reading the terminal (spec pose-delegation-mcp R5, R7).\n   647\t\tif jsonOut {\n   648\t\t\treturn delegateFail(stdout, stderr, true, command, 1, posemodel.ErrNoReviewerAdapter)\n   649\t\t}\n   650\t\texample, _ := posemodel.CanonicalDelegationPolicy(posemodel.ExampleDelegationPolicy())\n   651\t\terr := errors.New(tr(\"no agent is configured; add .pose/policy/delegation.json, for example:\\n\", \"nenhum agente configurado; adicione .pose/policy/delegation.json, por exemplo:\\n\") + string(example))\n   652\t\treturn delegateFail(stdout, stderr, jsonOut, command, 1, err)\n   653\t}\n   654\t\n   655\t// delegateGivenRoot checks the root a caller names: an absolute directory\n   656\t// holding a POSE instance.\n   657\tfunc delegateGivenRoot(root string) (string, error) {\n   658\t\tif !filepath.IsAbs(root) {\n   659\t\t\treturn \"\", errors.New(posemodel.DelegateRootEnv + \" must be an absolute path\")\n   660\t\t}\n   661\t\tif info, err := os.Stat(filepath.Join(root, \".pose\")); err != nil || !info.IsDir() {\n   662\t\t\treturn \"\", errors.New(posemodel.DelegateRootEnv + \" names no POSE instance\")\n   663\t\t}\n   664\t\treturn filepath.Clean(root), nil\n   665\t}\n   666\t\n   667\t// delegateTerminalHook runs the policy's on_terminal hook once the run is\n   668\t// recorded, and says so when it failed; the run's state does not change (R7).\n   669\tfunc delegateTerminalHook(store posemodel.Store, run posemodel.ReviewRun, err error, stdout, stderr io.Writer, command string) {\n   670\t\tif err != nil || run.RunID == \"\" {\n   671\t\t\treturn\n   672\t\t}\n   673\t\tif outcome := store.RunDelegationTerminalHook(run); outcome != nil && outcome.Failure != \"\" {\n   674\t\t\trender(stdout, stderr).Hint(\"pose delegate \" + command + \": on_terminal: \" + outcome.Failure)\n   675\t\t}\n   676\t}\n   677\t\n   678\t// routeSummary renders a routing decision for a person: the step chosen and\n   679\t// each agent skipped with its reason.\n   680\tfunc routeSummary(route *posemodel.DelegationRoutingRecord) string {\n   681\t\ttext := \"step=\" + route.Step\n   682\t\tif route.WaitUntil != \"\" {\n   683\t\t\ttext += \" wait_until=\" + route.WaitUntil\n   684\t\t}\n   685\t\tfor _, c := range route.Candidates {\n   686\t\t\tif c.Skipped != \"\" {\n   687\t\t\t\ttext += \"; \" + c.Agent + \" \" + tr(\"skipped\", \"ignorado\") + \": \" + c.Skipped\n   688\t\t\t}\n   689\t\t}\n   690\t\treturn text\n   691\t}\n   692\t\n   693\t// redactArgv hides the values of the credentials an agent is authorized to\n   694\t// receive, wherever a template carries them (security of R12).\n   695\tfunc redactArgv(argv []string, config posemodel.ReviewerAdapter) []string {\n   696\t\tout := append([]string(nil), argv...)\n   697\t\tif config.Containment == nil {\n   698\t\t\treturn out\n   699\t\t}\n   700\t\t// One pass, the longest value first: a credential that contains another\n   701\t\t// is replaced whole, whatever order the policy lists them in, and a\n   702\t\t// replacement is never scanned again (review round 3 of\n   703\t\t// pose-delegation-task, R3-B1).\n   704\t\tvar values []string\n   705\t\tfor _, name := range config.Containment.Credentials {\n   706\t\t\tif value := os.Getenv(name); len(value) >= 4 {\n   707\t\t\t\tvalues = append(values, value)\n   708\t\t\t}\n   709\t\t}\n   710\t\tsort.Slice(values, func(i, j int) bool { return len(values[i]) > len(values[j]) })\n   711\t\tpairs := make([]string, 0, 2*len(values))\n   712\t\tfor _, value := range values {\n   713\t\t\tpairs = append(pairs, value, \"[credential]\")\n   714\t\t}\n   715\t\tif len(pairs) == 0 {\n   716\t\t\treturn out\n   717\t\t}\n   718\t\treplacer := strings.NewReplacer(pairs...)\n   719\t\tfor i := range out {\n   720\t\t\tout[i] = replacer.Replace(out[i])\n   721\t\t}\n   722\t\treturn out\n   723\t}\n   724\t\n   725\t// delegatePrintPlan prints what a run would do (R12): agent, purpose, access,\n   726\t// working directory and argv, plus the fields of the command at hand.\n   727\tfunc delegatePrintPlan(stdout, stderr io.Writer, jsonOut bool, plan posemodel.DispatchPlan, argv []string, extra map[string]any) int {\n   728\t\tworkdir := tr(\"a disposable worktree at \", \"um worktree descartável em \") + plan.SealedCommit\n   729\t\tdoc := map[string]any{\"schema\": delegatePlanSchema, \"purpose\": plan.Purpose, \"agent\": plan.Adapter, \"vendor\": plan.Config.Vendor, \"model\": plan.Config.Model,\n   730\t\t\t\"access\": posemodel.DelegationAccessRead, \"workdir\": workdir, \"argv\": argv, \"reserves_attempt\": false}\n   731\t\tfor k, v := range extra {\n   732\t\t\tdoc[k] = v\n   733\t\t}\n   734\t\t// The containment a run would run under is disclosed before it runs, as\n   735\t\t// pose review dispatch did (spec pose-delegated-adapter-containment;\n   736\t\t// pose-delegation-parity-gate R6).\n   737\t\tsafety, _ := posemodel.ResolveReviewerContainment(plan.Config)\n   738\t\tif safety != nil {\n   739\t\t\tdoc[\"safety\"] = safety\n   740\t\t}\n   741\t\tif jsonOut {\n   742\t\t\twriteDelegateJSON(stdout, doc)\n   743\t\t\treturn 0\n   744\t\t}\n   745\t\tout := render(stdout, stderr)\n   746\t\tout.Field(\"delegate.purpose\", plan.Purpose)\n   747\t\tout.Field(\"delegate.agent\", fmt.Sprintf(\"%s (%s %s)\", plan.Adapter, plan.Config.Vendor, plan.Config.Model))\n   748\t\tout.Field(\"delegate.access\", posemodel.DelegationAccessRead)\n   749\t\tout.Field(\"delegate.workdir\", workdir)\n   750\t\traw, _ := json.Marshal(argv)\n   751\t\tout.Field(\"delegate.argv\", string(raw))\n   752\t\tif safety != nil {\n   753\t\t\traw, _ := json.Marshal(safety)\n   754\t\t\tout.Field(\"delegate.safety\", string(raw))\n   755\t\t}\n   756\t\tkeys := make([]string, 0, len(extra))\n   757\t\tfor k := range extra {\n   758\t\t\tkeys = append(keys, k)\n   759\t\t}\n   760\t\tsort.Strings(keys)\n   761\t\tfor _, k := range keys {\n   762\t\t\tif route, ok := extra[k].(*posemodel.DelegationRoutingRecord); ok {\n   763\t\t\t\tif route != nil {\n   764\t\t\t\t\tout.Field(\"delegate.routing\", routeSummary(route))\n   765\t\t\t\t}\n   766\t\t\t\tcontinue\n   767\t\t\t}\n   768\t\t\tif value := fmt.Sprint(extra[k]); value != \"\" {\n   769\t\t\t\tout.Field(\"delegate.\"+k, value)\n   770\t\t\t}\n   771\t\t}\n   772\t\tout.Field(\"delegate.dry_run\", tr(\"true (nothing reserved or claimed)\", \"true (nada reservado nem reivindicado)\"))\n   773\t\treturn 0\n   774\t}\n   775\t\n   776\tfunc delegatePrintRun(stdout, stderr io.Writer, jsonOut bool, command string, run posemodel.ReviewRun, err error, next ...delegateNextAction) int {\n   777\t\tcode := 0\n   778\t\tif err != nil || run.Status != posemodel.ReviewRunCompleted {\n   779\t\t\tcode = 1\n   780\t\t}\n   781\t\tattestation := tr(\"not recorded: a run's conclusion is recorded only by the engine's verified step\", \"não registrada: a conclusão de um run só é registrada pelo passo verificado do motor\")\n   782\t\tif jsonOut {\n   783\t\t\tdoc := map[string]any{\"schema\": delegateRunSchema, \"purpose\": run.Purpose, \"agent\": run.Adapter, \"vendor\": run.Vendor, \"model\": run.Model,\n   784\t\t\t\t\"label\": run.Label, \"lead\": run.Lead, \"scope\": run.Scope, \"bundle\": run.BundleID, \"attempt\": run.AttemptID, \"run\": run.RunID, \"resumes\": run.Resumes, \"hands_off_from\": run.HandsOffFrom,\n   785\t\t\t\t\"status\": run.Status, \"failure\": run.Failure, \"record\": run.Path, \"events\": run.EventsDigest != \"\", \"env_removed\": run.EnvRemoved, \"attestation\": attestation}\n   786\t\t\tif run.Interruption != nil {\n   787\t\t\t\tdoc[\"interruption\"] = run.Interruption\n   788\t\t\t}\n   789\t\t\tif run.Safety != nil {\n   790\t\t\t\tdoc[\"safety\"] = run.Safety\n   791\t\t\t}\n   792\t\t\tif len(next) > 0 {\n   793\t\t\t\tdoc[\"next_actions\"] = next\n   794\t\t\t}\n   795\t\t\tif err != nil {\n   796\t\t\t\tdoc[\"error\"] = strings.TrimPrefix(err.Error(), \"pose: \")\n   797\t\t\t}\n   798\t\t\twriteDelegateJSON(stdout, doc)\n   799\t\t\treturn code\n   800\t\t}\n   801\t\tout := render(stdout, stderr)\n   802\t\tif run.RunID != \"\" {\n   803\t\t\tout.Field(\"delegate.purpose\", run.Purpose)\n   804\t\t\tout.Field(\"delegate.agent\", fmt.Sprintf(\"%s (%s %s)\", run.Adapter, run.Vendor, run.Model))\n   805\t\t\tif run.Label != \"\" {\n   806\t\t\t\tout.Field(\"delegate.label\", run.Label)\n   807\t\t\t}\n   808\t\t\tout.Field(\"delegate.attempt\", run.AttemptID)\n   809\t\t\tif run.Resumes != \"\" {\n   810\t\t\t\tout.Field(\"delegate.resumes\", run.Resumes)\n   811\t\t\t}\n   812\t\t\tif run.HandsOffFrom != \"\" {\n   813\t\t\t\tout.Field(\"delegate.hands_off_from\", run.HandsOffFrom)\n   814\t\t\t}\n   815\t\t\tout.Field(\"delegate.run\", run.RunID)\n   816\t\t\t// R9 outside a terminal: the ways forward of a stopped run.\n   817\t\t\tfor _, action := range next {\n   818\t\t\t\tvalue := action.Command\n   819\t\t\t\tif !action.Available {\n   820\t\t\t\t\tvalue = tr(\"unavailable: \", \"indisponível: \") + action.Why\n   821\t\t\t\t} else if value == \"\" {\n   822\t\t\t\t\tvalue = action.Why\n   823\t\t\t\t}\n   824\t\t\t\tout.Field(\"delegate.next.\"+action.Action, value)\n   825\t\t\t}\n   826\t\t\tout.Field(\"delegate.status\", run.Status)\n   827\t\t\tif run.Failure != \"\" {\n   828\t\t\t\tout.Field(\"delegate.failure\", run.Failure)\n   829\t\t\t}\n   830\t\t\tif run.Interruption != nil {\n   831\t\t\t\tout.Field(\"delegate.interruption\", fmt.Sprintf(\"cause=%s resumable=%t reset_at=%s\", run.Interruption.Cause, run.Interruption.Resumable, run.Interruption.ResetAt))\n   832\t\t\t}\n   833\t\t\tif run.Safety != nil {\n   834\t\t\t\traw, _ := json.Marshal(run.Safety)\n   835\t\t\t\tout.Field(\"delegate.safety\", string(raw))\n   836\t\t\t}\n   837\t\t\tout.Field(\"delegate.record\", run.Path)\n   838\t\t\tout.Field(\"delegate.attestation\", attestation)\n   839\t\t}\n   840\t\tif err != nil {\n   841\t\t\tout.Failure(\"pose delegate \" + command + \": \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   842\t\t}\n   843\t\treturn code\n   844\t}\n   845\t\n   846\tfunc delegateAge(at string) string {\n   847\t\tt, err := time.Parse(time.RFC3339Nano, at)\n   848\t\tif err != nil {\n   849\t\t\treturn \"unknown\"\n   850\t\t}\n   851\t\td := time.Since(t)\n   852\t\tswitch {\n   853\t\tcase d < time.Minute:\n   854\t\t\treturn fmt.Sprintf(\"%ds\", int(d.Seconds()))\n   855\t\tcase d < time.Hour:\n   856\t\t\treturn fmt.Sprintf(\"%dm\", int(d.Minutes()))\n   857\t\tcase d < 48*time.Hour:\n   858\t\t\treturn fmt.Sprintf(\"%dh\", int(d.Hours()))\n   859\t\t}\n   860\t\treturn fmt.Sprintf(\"%dd\", int(d.Hours()/24))\n   861\t}\n   862\t\n   863\tfunc cmdDelegateLs(root string, args []string, stdout, stderr io.Writer) int {\n   864\t\tf, problem := parseDelegateFlags(args, \"--active\")\n   865\t\tif problem == \"\" && len(f.positional) > 1 {\n   866\t\t\tproblem = tr(\"one reference at most\", \"no máximo uma referência\")\n   867\t\t}\n   868\t\tif problem != \"\" {\n   869\t\t\treturn delegateUsage(stdout, stderr, args, \"ls\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate ls [<run>|<bundle-id>] [--active] [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>] [--json]\")\n   870\t\t}\n   871\t\tstore := posemodel.Store{Root: root}\n   872\t\tattempts, lost, err := store.ListDelegationAttempts()\n   873\t\tif err != nil {\n   874\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 1, err)\n   875\t\t}\n   876\t\tif len(f.positional) == 1 && !strings.HasPrefix(f.positional[0], \"rvb-\") {\n   877\t\t\tone, err := posemodel.ResolveDelegationRef(attempts, f.positional[0])\n   878\t\t\tif err != nil {\n   879\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, withDelegationLosses(refError(err), lost))\n   880\t\t\t}\n   881\t\t\t// A named run is refused when a selecting flag does not match it, as on\n   882\t\t\t// every other lifecycle command (D8); without a reference they filter.\n   883\t\t\tif flag := f.mismatch(one); flag != \"\" {\n   884\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, errors.New(tr(\"attempt \"+one.AttemptID+\" does not match \"+flag, \"a tentativa \"+one.AttemptID+\" não corresponde a \"+flag)))\n   885\t\t\t}\n   886\t\t\tattempts = []posemodel.DelegationAttempt{one}\n   887\t\t}\n   888\t\tselected := []posemodel.DelegationAttempt{}\n   889\t\tfor _, a := range attempts {\n   890\t\t\tif len(f.positional) == 1 && strings.HasPrefix(f.positional[0], \"rvb-\") && a.BundleID != f.positional[0] {\n   891\t\t\t\tcontinue\n   892\t\t\t}\n   893\t\t\tif f.active && !a.Active || f.mismatch(a) != \"\" {\n   894\t\t\t\tcontinue\n   895\t\t\t}\n   896\t\t\tselected = append(selected, a)\n   897\t\t}\n   898\t\tif lost == nil {\n   899\t\t\tlost = []string{}\n   900\t\t}\n   901\t\tif f.jsonOut {\n   902\t\t\t// R9: a stopped attempt carries the ways forward it has now.\n   903\t\t\ttype listed struct {\n   904\t\t\t\tposemodel.DelegationAttempt\n   905\t\t\t\tNextActions []delegateNextAction `json:\"next_actions,omitempty\"`\n   906\t\t\t}\n   907\t\t\trows := make([]listed, 0, len(selected))\n   908\t\t\tfor _, a := range selected {\n   909\t\t\t\trows = append(rows, listed{a, delegateNextActions(store, a)})\n   910\t\t\t}\n   911\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateListSchema, \"attempts\": rows, \"losses\": lost})\n   912\t\t} else {\n   913\t\t\tout := render(stdout, stderr)\n   914\t\t\tif len(selected) == 0 {\n   915\t\t\t\tout.Field(\"delegate.runs\", tr(\"none\", \"nenhum\"))\n   916\t\t\t}\n   917\t\t\tfor _, a := range selected {\n   918\t\t\t\tvalue := fmt.Sprintf(\"state=%s purpose=%s agent=%s turns=%d age=%s\", a.State, a.Purpose, a.Agent, a.Turns, delegateAge(a.StartedAt))\n   919\t\t\t\tif a.Round > 0 {\n   920\t\t\t\t\tvalue += fmt.Sprintf(\" round=%d\", a.Round)\n   921\t\t\t\t}\n   922\t\t\t\tif a.Label != \"\" {\n   923\t\t\t\t\tvalue += \" label=\" + a.Label\n   924\t\t\t\t}\n   925\t\t\t\tif a.Active && a.Liveness != \"\" {\n   926\t\t\t\t\tvalue += \" owner=\" + a.Liveness\n   927\t\t\t\t}\n   928\t\t\t\tif a.HeartbeatAge != \"\" {\n   929\t\t\t\t\tvalue += \" heartbeat=\" + a.HeartbeatAge\n   930\t\t\t\t}\n   931\t\t\t\tif a.StalledAt != \"\" {\n   932\t\t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n   933\t\t\t\t}\n   934\t\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n   935\t\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n   936\t\t\t\t}\n   937\t\t\t\tif a.HookFailure != \"\" {\n   938\t\t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n   939\t\t\t\t}\n   940\t\t\t\tif a.Interruption != nil {\n   941\t\t\t\t\tvalue += fmt.Sprintf(\" cause=%s resumable=%t partial=%t\", a.Interruption.Cause, a.Interruption.Resumable, a.Partial)\n   942\t\t\t\t\tif a.Interruption.ResetAt != \"\" {\n   943\t\t\t\t\t\tvalue += \" reset_at=\" + a.Interruption.ResetAt + \" time_left=\" + a.TimeLeft\n   944\t\t\t\t\t}\n   945\t\t\t\t}\n   946\t\t\t\tif a.LatestRun != \"\" {\n   947\t\t\t\t\tvalue += \" run=\" + a.LatestRun\n   948\t\t\t\t}\n   949\t\t\t\tif a.LastStep != \"\" {\n   950\t\t\t\t\tvalue += \" last=\" + a.LastStep\n   951\t\t\t\t}\n   952\t\t\t\tout.Field(\"delegate.\"+a.AttemptID, value)\n   953\t\t\t}\n   954\t\t\tfor _, loss := range lost {\n   955\t\t\t\tout.Failure(tr(\"delegated run history incomplete: \", \"histórico de runs delegados incompleto: \") + loss)\n   956\t\t\t}\n   957\t\t}\n   958\t\tif len(lost) > 0 {\n   959\t\t\treturn 1\n   960\t\t}\n   961\t\treturn 0\n   962\t}\n   963\t\n   964\t// resumeTarget is the run a resume continues (R11 with the delivered\n   965\t// continuity): the run named by its id, or the attempt's latest run when it\n   966\t// is interrupted, or the interrupted run the latest one continued, whose\n   967\t// recorded continuation is then returned instead of a new run.\n   968\tfunc resumeTarget(attempt posemodel.DelegationAttempt, ref string) (string, error) {\n   969\t\tif containsString(attempt.Runs, ref) {\n   970\t\t\treturn ref, nil\n   971\t\t}\n   972\t\tlatest := attempt.Latest()\n   973\t\tswitch {\n   974\t\tcase latest == nil:\n   975\t\t\treturn \"\", errors.New(tr(\"attempt \"+attempt.AttemptID+\" has no recorded run\", \"a tentativa \"+attempt.AttemptID+\" não tem run registrado\"))\n   976\t\tcase latest.Status == posemodel.ReviewRunInterrupted:\n   977\t\t\treturn latest.RunID, nil\n   978\t\tcase latest.Resumes != \"\":\n   979\t\t\treturn latest.Resumes, nil\n   980\t\t}\n   981\t\treturn \"\", errors.New(tr(\"the latest run of attempt \"+attempt.AttemptID+\" is \"+latest.Status+\", not interrupted\",\n   982\t\t\t\"o run mais recente da tentativa \"+attempt.AttemptID+\" está \"+latest.Status+\", não interrompido\"))\n   983\t}\n   984\t\n   985\tfunc cmdDelegateResume(root string, args []string, stdout, stderr io.Writer) int {\n   986\t\tf, problem := parseDelegateFlags(args, \"--wait-until-reset\", \"--prompt\", \"--detach\")\n   987\t\tif problem != \"\" {\n   988\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate resume <run> [--wait-until-reset[=<max>]] [--prompt <file|->] [--detach] [--dry-run] [--json]\")\n   989\t\t}\n   990\t\t// A detached resume is this command run again in its own session (spec\n   991\t\t// pose-delegation-mcp R4); it hands its attempt back once it starts.\n   992\t\tif f.detach && !f.dryRun && !delegateSupervised() {\n   993\t\t\tif f.wait {\n   994\t\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", tr(\"--detach does not wait for a reset: resume after it, or without --detach\", \"--detach não espera um reset: retome depois dele, ou sem --detach\"))\n   995\t\t\t}\n   996\t\t\treturn detachDelegateRun(root, \"resume\", args, f, stdout, stderr)\n   997\t\t}\n   998\t\tstore := cliGovernedStore(root)\n   999\t\tattempts, _, err := store.ListDelegationAttempts()\n  1000\t\tif err != nil {\n  1001\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1002\t\t}\n  1003\t\tattempt, code, err := namedAttempt(attempts, f)\n  1004\t\tif err != nil {\n  1005\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", code, err)\n  1006\t\t}\n  1007\t\tif attempt.Active {\n  1008\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, errors.New(tr(\"attempt \"+attempt.AttemptID+\" is still running\", \"a tentativa \"+attempt.AttemptID+\" ainda está rodando\")))\n  1009\t\t}\n  1010\t\tref := attempt.AttemptID\n  1011\t\tif len(f.positional) == 1 {\n  1012\t\t\tref = f.positional[0]\n  1013\t\t}\n  1014\t\ttarget, err := resumeTarget(attempt, ref)\n  1015\t\tif err != nil {\n  1016\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1017\t\t}\n  1018\t\tif attempt.Purpose == posemodel.DelegationPurposeTask {\n  1019\t\t\treturn cmdDelegateTaskResume(root, store, f, attempt, target, stdout, stderr)\n  1020\t\t}\n  1021\t\tif f.promptFile != \"\" {\n  1022\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", tr(\"--prompt is for a task; a review is resumed with its own brief\", \"--prompt é para uma task; uma review é retomada com o próprio brief\"))\n  1023\t\t}\n  1024\t\tplan, err := store.PlanReviewResume(target)\n  1025\t\tif err != nil {\n  1026\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1027\t\t}\n  1028\t\tif pending := plan.PendingContinuation; pending != nil {\n  1029\t\t\t// A continuation already reserved is answered, as pose review resume\n  1030\t\t\t// answered it: pending, with its ids, and no second process (spec\n  1031\t\t\t// pose-delegation-parity-gate R6; review round 1, PG-R1-07).\n  1032\t\t\thandBackAttempt(pending.AttemptID)\n  1033\t\t\tif f.jsonOut {\n  1034\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateRunSchema, \"purpose\": attempt.Purpose, \"attempt\": pending.AttemptID, \"resumes\": pending.Predecessor,\n  1035\t\t\t\t\t\"continuation\": pending.ID, \"status\": \"pending\"})\n  1036\t\t\t\treturn 0\n  1037\t\t\t}\n  1038\t\t\tout := render(stdout, stderr)\n  1039\t\t\tout.Field(\"delegate.resumes\", pending.Predecessor)\n  1040\t\t\tout.Field(\"delegate.continuation\", pending.ID)\n  1041\t\t\tout.Field(\"delegate.attempt\", pending.AttemptID)\n  1042\t\t\tout.Field(\"delegate.status\", \"pending\")\n  1043\t\t\treturn 0\n  1044\t\t}\n  1045\t\tvar delay time.Duration\n  1046\t\tif f.wait && plan.Existing == nil {\n  1047\t\t\tvar seed [1]byte\n  1048\t\t\tif _, err := rand.Read(seed[:]); err != nil {\n  1049\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1050\t\t\t}\n  1051\t\t\tvar prior posemodel.ReviewRun\n  1052\t\t\tif latest := attempt.Latest(); latest != nil && latest.RunID == target {\n  1053\t\t\t\tprior = *latest\n  1054\t\t\t} else if runs, rerr := store.ListReviewRuns(\"\"); rerr == nil {\n  1055\t\t\t\tfor _, r := range runs {\n  1056\t\t\t\t\tif r.RunID == target {\n  1057\t\t\t\t\t\tprior = r\n  1058\t\t\t\t\t}\n  1059\t\t\t\t}\n  1060\t\t\t}\n  1061\t\t\tdelay, err = posemodel.ReviewResumeDelay(prior, time.Now(), f.waitMax, time.Duration(seed[0])*time.Second/255)\n  1062\t\t\tif err != nil {\n  1063\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1064\t\t\t}\n  1065\t\t}\n  1066\t\tif f.dryRun {\n  1067\t\t\textra := map[string]any{\"resumes\": target, \"attempt\": attempt.AttemptID, \"label\": attempt.Label}\n  1068\t\t\tif plan.Existing != nil {\n  1069\t\t\t\textra[\"recorded_continuation\"] = plan.Existing.RunID\n  1070\t\t\t}\n  1071\t\t\tif f.wait {\n  1072\t\t\t\textra[\"wait\"] = delay.String()\n  1073\t\t\t}\n  1074\t\t\tplan.Purpose = attempt.Purpose\n  1075\t\t\targv := redactArgv(posemodel.ReviewerArgv(plan.Config.Resume.Command, \"{output}\", \"{session}\", plan.Effort, plan.Config.Effort), plan.Config)\n  1076\t\t\treturn delegatePrintPlan(stdout, stderr, f.jsonOut, plan, argv, extra)\n  1077\t\t}\n  1078\t\tif delay > 0 {\n  1079\t\t\tif !f.jsonOut {\n  1080\t\t\t\trender(stdout, stderr).Field(\"delegate.wait\", delay.String())\n  1081\t\t\t}\n  1082\t\t\ttime.Sleep(delay)\n  1083\t\t\tif plan, err = store.PlanReviewResume(target); err != nil {\n  1084\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1085\t\t\t}\n  1086\t\t}\n  1087\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n  1088\t\tdefer stop()\n  1089\t\tif delegateSupervised() {\n  1090\t\t\tplan.OnStart = supervisorHandback()\n  1091\t\t}\n  1092\t\t// The containment the run will run under is disclosed before it runs, as\n  1093\t\t// pose review dispatch disclosed it (spec pose-delegation-parity-gate R6;\n  1094\t\t// review round 1, PG-R1-08); the JSON document carries it with the run.\n  1095\t\tif safety, _ := posemodel.ResolveReviewerContainment(plan.Config); safety != nil && !f.jsonOut {\n  1096\t\t\traw, _ := json.Marshal(safety)\n  1097\t\t\trender(stdout, stderr).Field(\"delegate.safety\", string(raw))\n  1098\t\t}\n  1099\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n  1100\t\thandBackExisting(run, err)\n  1101\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n  1102\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"resume\")\n  1103\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"resume\", run, err, delegateRunNextActions(store, run, err)...)\n  1104\t\tif err == nil && !f.jsonOut {\n  1105\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n  1106\t\t\t\treturn next\n  1107\t\t\t}\n  1108\t\t}\n  1109\t\treturn code\n  1110\t}\n  1111\t\n  1112\tfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n  1113\t\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n  1114\t\tif problem != \"\" {\n  1115\t\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n  1116\t\t}\n  1117\t\tstore := posemodel.Store{Root: root}\n  1118\t\tattempts, lost, err := store.ListDelegationAttempts()\n  1119\t\tif err != nil {\n  1120\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1121\t\t}\n  1122\t\tattempt, code, err := namedAttempt(attempts, f)\n  1123\t\tif err != nil {\n  1124\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n  1125\t\t}\n  1126\t\tif !attempt.Active && !f.dryRun {\n  1127\t\t\t// An attempt whose dispatch, or whose earlier release, ended before\n  1128\t\t\t// its receipt is released with a failed run and its receipt, so it\n  1129\t\t\t// stops blocking the bundle; the release proves the abandonment\n  1130\t\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n  1131\t\t\t// review round 4, N1).\n  1132\t\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n  1133\t\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n  1134\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1135\t\t\t}\n  1136\t\t\tif err != nil {\n  1137\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1138\t\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1139\t\t\t}\n  1140\t\t\tif f.jsonOut {\n  1141\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n  1142\t\t\t\treturn 0\n  1143\t\t\t}\n  1144\t\t\tout := render(stdout, stderr)\n  1145\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1146\t\t\tif run.RunID == \"\" {\n  1147\t\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n  1148\t\t\t} else {\n  1149\t\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n  1150\t\t\t}\n  1151\t\t\treturn 0\n  1152\t\t}\n  1153\t\tif !attempt.Active {\n  1154\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1155\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1156\t\t}\n  1157\t\tif f.dryRun {\n  1158\t\t\tif f.jsonOut {\n  1159\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": false, \"dry_run\": true, \"owner\": attempt.Liveness})\n  1160\t\t\t\treturn 0\n  1161\t\t\t}\n  1162\t\t\tout := render(stdout, stderr)\n  1163\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1164\t\t\tout.Field(\"delegate.owner\", attempt.Liveness)\n  1165\t\t\tout.Field(\"delegate.dry_run\", tr(\"true (no cancellation requested)\", \"true (nenhum cancelamento pedido)\"))\n  1166\t\t\treturn 0\n  1167\t\t}\n  1168\t\tmarker, err := store.RequestDelegationCancel(attempt.AttemptID)\n  1169\t\tif err != nil {\n  1170\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1171\t\t}\n  1172\t\tdeadline := time.Now().Add(60 * time.Second)\n  1173\t\tfor store.DelegationRunActive(marker) && time.Now().Before(deadline) {\n  1174\t\t\ttime.Sleep(200 * time.Millisecond)\n  1175\t\t}\n  1176\t\tstopped := !store.DelegationRunActive(marker)\n  1177\t\tstatus, run := \"\", \"\"\n  1178\t\tif after, _, err := store.ListDelegationAttempts(); err == nil {\n  1179\t\t\tfor _, a := range after {\n  1180\t\t\t\tif a.AttemptID == attempt.AttemptID && a.Latest() != nil {\n  1181\t\t\t\t\tstatus, run = a.Latest().Status, a.Latest().RunID\n  1182\t\t\t\t}\n  1183\t\t\t}\n  1184\t\t}\n  1185\t\tif f.jsonOut {\n  1186\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": true, \"stopped\": stopped, \"run\": run, \"status\": status})\n  1187\t\t} else {\n  1188\t\t\tout := render(stdout, stderr)\n  1189\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1190\t\t\tout.Field(\"delegate.cancel\", tr(\"requested\", \"pedido\"))\n  1191\t\t\tout.Field(\"delegate.stopped\", fmt.Sprint(stopped))\n  1192\t\t\tif run != \"\" {\n  1193\t\t\t\tout.Field(\"delegate.run\", run)\n  1194\t\t\t\tout.Field(\"delegate.status\", status)\n  1195\t\t\t}\n  1196\t\t}\n  1197\t\tif !stopped {\n  1198\t\t\treturn 1\n  1199\t\t}\n  1200\t\treturn 0\n  1201\t}\n  1202\t\n  1203\t// withDelegationLosses names what the listing could not read beside a run it\n  1204\t// did not find running: the run may be the one an unreadable marker hides.\n  1205\tfunc withDelegationLosses(err error, lost []string) error {\n  1206\t\tif len(lost) == 0 {\n  1207\t\t\treturn err\n  1208\t\t}\n  1209\t\treturn fmt.Errorf(\"%w (%s %s)\", err, tr(\"unread:\", \"não lido:\"), strings.Join(lost, \"; \"))\n  1210\t}\n  1211\t\n  1212\t// delegateAgentRow is one line of pose delegate agents (R14).\n  1213\ttype delegateAgentRow struct {\n  1214\t\tName              string   `json:\"name\"`\n  1215\t\tVendor            string   `json:\"vendor\"`\n  1216\t\tModel             string   `json:\"model\"`\n  1217\t\tCLI               string   `json:\"cli\"`\n  1218\t\tOnPath            bool     `json:\"on_path\"`\n  1219\t\tAccess            []string `json:\"access\"`\n  1220\t\tEvents            string   `json:\"events\"`\n  1221\t\tLimitResetAt      string   `json:\"limit_reset_at,omitempty\"`\n  1222\t\tLimited           bool     `json:\"limited\"`\n  1223\t\tState             string   `json:\"state\"`\n  1224\t\tLimitedUntil      string   `json:\"limited_until,omitempty\"`\n  1225\t\tDetail            string   `json:\"detail,omitempty\"`\n  1226\t\tIndependentOfLead *bool    `json:\"independent_of_lead,omitempty\"`\n  1227\t\t// Unavailable names the access profiles whose dependencies are missing, with what is\n  1228\t\t// missing and how to install it.\n  1229\t\tUnavailable map[string]string `json:\"unavailable_access,omitempty\"`\n  1230\t}\n  1231\t\n  1232\tfunc cmdDelegateAgents(root string, args []string, stdout, stderr io.Writer) int {\n  1233\t\tf, problem := parseDelegateFlags(args)\n  1234\t\tif problem == \"\" && len(f.positional) > 0 {\n  1235\t\t\tproblem = tr(\"no arguments\", \"sem argumentos\")\n  1236\t\t}\n  1237\t\tif problem != \"\" {\n  1238\t\t\treturn delegateUsage(stdout, stderr, args, \"agents\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate agents [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>] [--json]\")\n  1239\t\t}\n  1240\t\tstore := posemodel.Store{Root: root}\n  1241\t\tpolicy, path, found, err := store.LoadDelegationPolicy()\n  1242\t\tif err != nil {\n  1243\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"agents\", 1, err)\n  1244\t\t}\n  1245\t\tlabelled := map[string]bool{}\n  1246\t\tif runs, _, err := store.ReadReviewRuns(\"\"); err == nil {\n  1247\t\t\tfor _, run := range runs {\n  1248\t\t\t\tif f.label != \"\" && run.Label == f.label {\n  1249\t\t\t\t\tlabelled[run.Adapter] = true\n  1250\t\t\t\t}\n  1251\t\t\t}\n  1252\t\t}\n  1253\t\t// Availability as routing reads it (spec pose-delegation-routing R6).\n  1254\t\tavail := store.DelegationAvailabilityOf(policy, time.Now(), true)\n  1255\t\trows := []delegateAgentRow{}\n  1256\t\tfor _, name := range policy.DeclaredAgentNames() {\n  1257\t\t\tagent := policy.Agents[name]\n  1258\t\t\taccess := make([]string, 0, len(agent.Commands))\n  1259\t\t\tfor level := range agent.Commands {\n  1260\t\t\t\taccess = append(access, level)\n  1261\t\t\t}\n  1262\t\t\tsort.Strings(access)\n  1263\t\t\tif f.agent != \"\" && f.agent != \"auto\" && f.agent != name || f.access != \"\" && !containsString(access, f.access) || f.label != \"\" && !labelled[name] {\n  1264\t\t\t\tcontinue\n  1265\t\t\t}\n  1266\t\t\tevents := agent.Events\n  1267\t\t\tif events == \"\" {\n  1268\t\t\t\tevents = posemodel.DelegationEventsPlain\n  1269\t\t\t}\n  1270\t\t\ta := avail[name]\n  1271\t\t\trow := delegateAgentRow{Name: name, Vendor: agent.Vendor, Model: agent.Model, CLI: a.CLI, OnPath: a.OnPath, Access: access, Events: events, LimitResetAt: a.LimitResetAt,\n  1272\t\t\t\tState: a.State, LimitedUntil: a.LimitedUntil, Detail: a.Detail}\n  1273\t\t\t// limited is the state routing reads now; limit_reset_at stays the\n  1274\t\t\t// reset of the last limit ever recorded.\n  1275\t\t\trow.Limited = a.State == posemodel.DelegationAgentLimited\n  1276\t\t\tfor access, missing := range agent.MissingRequirements() {\n  1277\t\t\t\tif row.Unavailable == nil {\n  1278\t\t\t\t\trow.Unavailable = map[string]string{}\n  1279\t\t\t\t}\n  1280\t\t\t\trow.Unavailable[access] = tr(\"missing \", \"falta \") + strings.Join(missing, \", \") + installHint(agent, access)\n  1281\t\t\t}\n  1282\t\t\tif f.lead != \"\" {\n  1283\t\t\t\tindependent := !strings.EqualFold(strings.TrimSpace(agent.Vendor), leadVendor(f.lead))\n  1284\t\t\t\trow.IndependentOfLead = &independent\n  1285\t\t\t}\n  1286\t\t\trows = append(rows, row)\n  1287\t\t}\n  1288\t\tif f.jsonOut {\n  1289\t\t\tdoc := map[string]any{\"schema\": delegateAgentsSchema, \"configured\": found, \"agents\": rows}\n  1290\t\t\tif found {\n  1291\t\t\t\tdoc[\"policy\"] = path\n  1292\t\t\t}\n  1293\t\t\twriteDelegateJSON(stdout, doc)\n  1294\t\t\treturn 0\n  1295\t\t}\n  1296\t\tout := render(stdout, stderr)\n  1297\t\tif !found {\n  1298\t\t\tout.Field(\"delegate.agents\", tr(\"none configured (.pose/policy/delegation.json)\", \"nenhum configurado (.pose/policy/delegation.json)\"))\n  1299\t\t\treturn 0\n  1300\t\t}\n  1301\t\tout.Field(\"delegate.policy\", path)\n  1302\t\tfor _, row := range rows {\n  1303\t\t\tstate := row.State\n  1304\t\t\tswitch {\n  1305\t\t\tcase row.State == posemodel.DelegationAgentLimited && row.LimitedUntil != \"\":\n  1306\t\t\t\tstate = tr(\"limited until \", \"limitado até \") + row.LimitedUntil\n  1307\t\t\tcase row.State == posemodel.DelegationAgentAvailable:\n  1308\t\t\t\tstate = tr(\"available\", \"disponível\")\n  1309\t\t\tcase row.State == posemodel.DelegationAgentMissing:\n  1310\t\t\t\tstate = tr(\"missing\", \"ausente\")\n  1311\t\t\tcase row.Detail != \"\":\n  1312\t\t\t\tstate += \" (\" + row.Detail + \")\"\n  1313\t\t\t}\n  1314\t\t\tvalue := fmt.Sprintf(\"%s · vendor=%s model=%s cli=%s on_path=%t access=%s events=%s\", state, row.Vendor, row.Model, row.CLI, row.OnPath, strings.Join(row.Access, \",\"), row.Events)\n  1315\t\t\tif row.LimitResetAt != \"\" {\n  1316\t\t\t\tvalue += \" last_limit_reset=\" + row.LimitResetAt\n  1317\t\t\t\tif row.Limited {\n  1318\t\t\t\t\tvalue += tr(\" (limited now)\", \" (limitado agora)\")\n  1319\t\t\t\t}\n  1320\t\t\t}\n  1321\t\t\tif row.IndependentOfLead != nil {\n  1322\t\t\t\tvalue += fmt.Sprintf(\" independent_of_lead=%t\", *row.IndependentOfLead)\n  1323\t\t\t}\n  1324\t\t\taccesses := make([]string, 0, len(row.Unavailable))\n  1325\t\t\tfor access := range row.Unavailable {\n  1326\t\t\t\taccesses = append(accesses, access)\n  1327\t\t\t}\n  1328\t\t\tsort.Strings(accesses)\n  1329\t\t\tfor _, access := range accesses {\n  1330\t\t\t\tvalue += \" unavailable_access=\" + access + \"(\" + row.Unavailable[access] + \")\"\n  1331\t\t\t}\n  1332\t\t\tout.Field(\"delegate.agent.\"+row.Name, value)\n  1333\t\t}\n  1334\t\treturn 0\n  1335\t}\n  1336\t\n  1337\t// installHint is how to install what an access profile needs, when the policy says.\n  1338\tfunc installHint(agent posemodel.DelegationAgent, access string) string {\n  1339\t\tif install := agent.Requires[access].Install; install != \"\" {\n  1340\t\t\treturn tr(\"; install: \", \"; instale: \") + install\n  1341\t\t}\n  1342\t\treturn \"\"\n  1343\t}\n  1344\t\n  1345\tfunc containsString(values []string, wanted string) bool {\n  1346\t\tfor _, value := range values {\n  1347\t\t\tif value == wanted {\n  1348\t\t\t\treturn true\n  1349\t\t\t}\n  1350\t\t}\n  1351\t\treturn false\n  1352\t}\n","exit_code":0,"status":"completed"}}
