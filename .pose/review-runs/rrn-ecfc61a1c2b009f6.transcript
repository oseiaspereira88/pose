{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '1140,1270p'\"","aggregated_output":"  1140\t\t}\n  1141\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1142\t\t\trun.Output = string(raw)\n  1143\t\t\tif run.Provenance != nil {\n  1144\t\t\t\trun.Provenance.OutputComplete = true\n  1145\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1146\t\t\t}\n  1147\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1148\t\t\t// The agent writes no output file; its stream names its final message.\n  1149\t\t\trun.Output = final\n  1150\t\t\tif run.Provenance != nil {\n  1151\t\t\t\trun.Provenance.OutputComplete = true\n  1152\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1153\t\t\t}\n  1154\t\t} else {\n  1155\t\t\trun.Output = tail(string(transcript), 20000)\n  1156\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1157\t\t\t\tsafety.CaptureComplete = false\n  1158\t\t\t}\n  1159\t\t\tif run.Provenance != nil {\n  1160\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1161\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1162\t\t\t}\n  1163\t\t}\n  1164\t\tif run.Provenance != nil {\n  1165\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n  1166\t\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n  1167\t\t}\n  1168\t\tif runErr != nil && cmd.ProcessState == nil {\n  1169\t\t\trun.Output, transcript = \"\", nil\n  1170\t\t\tif run.Provenance != nil {\n  1171\t\t\t\trun.Provenance.OutputComplete = false\n  1172\t\t\t}\n  1173\t\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n  1174\t\t}\n  1175\t\t// Raw provenance hashes above precede redaction; only complete, bounded\n  1176\t\t// redacted channels can be retained. Partial boundaries can expose a secret.\n  1177\t\tsafety.ExecutionCause = executionCause(ctx)\n  1178\t\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n  1179\t\t\tsafety.CaptureComplete = false\n  1180\t\t}\n  1181\t\tif !safety.CaptureComplete {\n  1182\t\t\ttranscript = nil\n  1183\t\t\trun.Output = \"\"\n  1184\t\t\tif run.Provenance != nil {\n  1185\t\t\t\trun.Provenance.OutputComplete = false\n  1186\t\t\t}\n  1187\t\t\tif terminationErr != nil {\n  1188\t\t\t\treturn finish(ReviewRunFailed, \"process group termination failed; descendants may remain\")\n  1189\t\t\t}\n  1190\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1191\t\t\treturn finish(ReviewRunFailed, \"adapter capture incomplete: stream/output limit or unsafe output file\")\n  1192\t\t}\n  1193\t\tcaptureStage := \"session/interrupt recognition\"\n  1194\t\tstatus, failure, captureErr := s.classifyReviewInterruption(&run, plan, transcript, runErr, ctx.Err())\n  1195\t\tif captureErr == nil {\n  1196\t\t\tvar redactErr error\n  1197\t\t\traw := transcript\n  1198\t\t\tcaptureStage = \"stdout\"\n  1199\t\t\ttranscript, redactErr = redactReviewCapture(transcript, secrets, run.sessionForRedaction, safety.StreamBytes)\n  1200\t\t\tvar output []byte\n  1201\t\t\tif redactErr == nil {\n  1202\t\t\t\tcaptureStage = \"final output\"\n  1203\t\t\t\toutput, redactErr = redactReviewCapture([]byte(run.Output), secrets, run.sessionForRedaction, safety.OutputBytes)\n  1204\t\t\t}\n  1205\t\t\trun.Output = string(output)\n  1206\t\t\tif redactErr == nil && run.Events != \"\" {\n  1207\t\t\t\tcaptureStage = \"normalized events\"\n  1208\t\t\t\t// Events are parsed from the decoded stream, where a JSON escape no longer\n  1209\t\t\t\t// hides a value: each text is redacted again after decoding.\n  1210\t\t\t\trun.eventsBytes, redactErr = redactedDelegationEvents(run.Events, raw, run.Output, secrets, run.sessionForRedaction)\n  1211\t\t\t}\n  1212\t\t\tif redactErr != nil {\n  1213\t\t\t\tcaptureErr = redactErr\n  1214\t\t\t}\n  1215\t\t}\n  1216\t\tif captureErr != nil {\n  1217\t\t\trun.Output, transcript = \"\", nil\n  1218\t\t\tsafety.CaptureComplete = false\n  1219\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1220\t\t\tif run.Provenance != nil {\n  1221\t\t\t\trun.Provenance.OutputComplete = false\n  1222\t\t\t}\n  1223\t\t\treturn finish(ReviewRunFailed, \"adapter capture failed; unredacted output withheld; \"+delegationCaptureFailure(run.Adapter, run.Events, captureStage, captureErr))\n  1224\t\t}\n  1225\t\trun.sessionForRedaction = \"\"\n  1226\t\n  1227\t\tif status != \"\" {\n  1228\t\t\t// Partial drafts are evidence only after the same containment checks.\n  1229\t\t\tafter, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n  1230\t\t\tif err != nil || !reflect.DeepEqual(diskBefore, after) {\n  1231\t\t\t\treturn finish(ReviewRunFailed, \"interrupted adapter changed or obscured the sealed worktree\")\n  1232\t\t\t}\n  1233\t\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n  1234\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1235\t\t\t}\n  1236\t\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n  1237\t\t\t\treturn finish(ReviewRunFailed, \"origin changed during interruption: \"+err.Error())\n  1238\t\t\t}\n  1239\t\t\tif status == ReviewRunInterrupted {\n  1240\t\t\t\trun.PartialDigest = digestBytes([]byte(run.Output))\n  1241\t\t\t}\n  1242\t\t\treturn finish(status, failure)\n  1243\t\t}\n  1244\t\tdiskAfter, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n  1245\t\tif err != nil {\n  1246\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1247\t\t}\n  1248\t\tif !reflect.DeepEqual(diskBefore, diskAfter) {\n  1249\t\t\tchanged := []string{}\n  1250\t\t\tfor path, digest := range diskBefore {\n  1251\t\t\t\tif diskAfter[path] != digest {\n  1252\t\t\t\t\tchanged = append(changed, path)\n  1253\t\t\t\t}\n  1254\t\t\t}\n  1255\t\t\tfor path := range diskAfter {\n  1256\t\t\t\tif _, exists := diskBefore[path]; !exists {\n  1257\t\t\t\t\tchanged = append(changed, path)\n  1258\t\t\t\t}\n  1259\t\t\t}\n  1260\t\t\tsort.Strings(changed)\n  1261\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"the run changed files in the sealed worktree (including ignored materialization): %q\", changed))\n  1262\t\t}\n  1263\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n  1264\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1265\t\t}\n  1266\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n  1267\t\t\treturn finish(ReviewRunFailed, \"origin or policy changed: \"+err.Error())\n  1268\t\t}\n  1269\t\n  1270\t\tevents := run.eventsBytes\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/delegate.go | sed -n '1,220p'\"","aggregated_output":"     1\tpackage cli\n     2\t\n     3\t// pose delegate: the one surface for delegated executions (spec\n     4\t// pose-delegation-surface; ADR 2026-10-26-delegation-is-a-first-class-execution-surface).\n     5\t//\n     6\t// pose review governs the subject (bundle, brief, attestation, verify);\n     7\t// pose delegate governs executions: who runs, with which access, and what\n     8\t// happened. review, adjudicate and smoke run through the delivered dispatch\n     9\t// path; the lifecycle commands read the same run records.\n    10\t//\n    11\t// Every subcommand takes the common flags with one meaning (R2): where a\n    12\t// command starts a run they set it (--agent, --access, --label, --lead);\n    13\t// where it names or lists runs they select them, and a run that does not\n    14\t// match is not the one named; --dry-run changes nothing anywhere.\n    15\t\n    16\timport (\n    17\t\t\"context\"\n    18\t\t\"crypto/rand\"\n    19\t\t\"encoding/json\"\n    20\t\t\"errors\"\n    21\t\t\"fmt\"\n    22\t\t\"io\"\n    23\t\t\"os\"\n    24\t\t\"os/signal\"\n    25\t\t\"path/filepath\"\n    26\t\t\"regexp\"\n    27\t\t\"sort\"\n    28\t\t\"strconv\"\n    29\t\t\"strings\"\n    30\t\t\"syscall\"\n    31\t\t\"time\"\n    32\t\n    33\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    34\t)\n    35\t\n    36\tconst delegateUsageText = \"pose delegate <review|adjudicate|smoke|task|ls|watch|wait|resume|handoff|cancel|agents> [args] [--agent auto|<name>] [--access read|sandboxed|write|full] [--label <name>] [--lead <vendor>] [--dry-run] [--json]\"\n    37\t\n    38\t// Versioned JSON documents of pose delegate (R10).\n    39\tconst (\n    40\t\tdelegateRunSchema    = \"pose.delegate.run/v1\"\n    41\t\tdelegatePlanSchema   = \"pose.delegate.plan/v1\"\n    42\t\tdelegateListSchema   = \"pose.delegate.ls/v1\"\n    43\t\tdelegateCancelSchema = \"pose.delegate.cancel/v1\"\n    44\t\tdelegateAgentsSchema = \"pose.delegate.agents/v1\"\n    45\t\tdelegateErrorSchema  = \"pose.delegate.error/v1\"\n    46\t)\n    47\t\n    48\t// Subcommands named by the ADR whose behaviour a later spec delivers.\n    49\tvar delegatePlanned = map[string]string{}\n    50\t\n    51\tvar (\n    52\t\tdelegateLabelRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n    53\t)\n    54\t\n    55\t// commonDelegateFlags are taken by every subcommand.\n    56\tvar commonDelegateFlags = []string{\"--agent\", \"--access\", \"--label\", \"--lead\", \"--dry-run\", \"--json\"}\n    57\t\n    58\t// tr picks the message for the session's locale.\n    59\tfunc tr(english, portuguese string) string { return cliText(cliLocaleValue(), english, portuguese) }\n    60\t\n    61\ttype delegateFlags struct {\n    62\t\tagent, access, label, lead, reason, noteFile string\n    63\t\trequest                                      string\n    64\t\tto, cd, effort, promptFile, session          string\n    65\t\taddDirs                                      []string\n    66\t\tnoNetwork, record, confirmAbandoned          bool\n    67\t\tdryRun, jsonOut, active, wait, detach        bool\n    68\t\tverbose, noFollow                            bool\n    69\t\tlines                                        int\n    70\t\twaitMax, timeout, refresh                    time.Duration\n    71\t\tpositional                                   []string\n    72\t}\n    73\t\n    74\t// parseDelegateFlags reads the common flags and the extra ones a subcommand\n    75\t// takes; problem is a message for the person, in their locale.\n    76\tfunc parseDelegateFlags(args []string, extra ...string) (delegateFlags, string) {\n    77\t\tf := delegateFlags{waitMax: 24 * time.Hour}\n    78\t\tpermit := map[string]bool{}\n    79\t\tfor _, name := range append(append([]string(nil), commonDelegateFlags...), extra...) {\n    80\t\t\tpermit[name] = true\n    81\t\t}\n    82\t\tfor i := 0; i < len(args); i++ {\n    83\t\t\targ := args[i]\n    84\t\t\tname, inline, hasInline := strings.Cut(arg, \"=\")\n    85\t\t\t// A lone - names stdin (spec pose-delegation-task R1).\n    86\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n    87\t\t\t\tf.positional = append(f.positional, arg)\n    88\t\t\t\tcontinue\n    89\t\t\t}\n    90\t\t\tif !permit[name] {\n    91\t\t\t\treturn f, tr(\"unknown or inapplicable flag \"+name, \"flag desconhecida ou inaplicável \"+name)\n    92\t\t\t}\n    93\t\t\tswitch name {\n    94\t\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\", \"--confirm-abandoned\":\n    95\t\t\t\tif hasInline {\n    96\t\t\t\t\treturn f, tr(name+\" takes no value\", name+\" não recebe valor\")\n    97\t\t\t\t}\n    98\t\t\t\tswitch name {\n    99\t\t\t\tcase \"--dry-run\":\n   100\t\t\t\t\tf.dryRun = true\n   101\t\t\t\tcase \"--json\":\n   102\t\t\t\t\tf.jsonOut = true\n   103\t\t\t\tcase \"--detach\":\n   104\t\t\t\t\tf.detach = true\n   105\t\t\t\tcase \"-v\":\n   106\t\t\t\t\tf.verbose = true\n   107\t\t\t\tcase \"--no-network\":\n   108\t\t\t\t\tf.noNetwork = true\n   109\t\t\t\tcase \"--record\":\n   110\t\t\t\t\tf.record = true\n   111\t\t\t\tcase \"--confirm-abandoned\":\n   112\t\t\t\t\tf.confirmAbandoned = true\n   113\t\t\t\tcase \"--no-follow\":\n   114\t\t\t\t\tf.noFollow = true\n   115\t\t\t\tdefault:\n   116\t\t\t\t\tf.active = true\n   117\t\t\t\t}\n   118\t\t\tcase \"--wait-until-reset\":\n   119\t\t\t\tf.wait = true\n   120\t\t\t\tif hasInline {\n   121\t\t\t\t\td, err := time.ParseDuration(inline)\n   122\t\t\t\t\tif err != nil || d <= 0 || d > 24*time.Hour {\n   123\t\t\t\t\t\treturn f, tr(\"--wait-until-reset takes a duration up to 24h\", \"--wait-until-reset recebe uma duração de até 24h\")\n   124\t\t\t\t\t}\n   125\t\t\t\t\tf.waitMax = d\n   126\t\t\t\t}\n   127\t\t\tdefault:\n   128\t\t\t\tvalue := inline\n   129\t\t\t\tif !hasInline {\n   130\t\t\t\t\t// --prompt - reads stdin (spec pose-delegation-task R8).\n   131\t\t\t\t\tif i+1 >= len(args) || strings.HasPrefix(args[i+1], \"-\") && !(name == \"--prompt\" && args[i+1] == \"-\") {\n   132\t\t\t\t\t\treturn f, tr(name+\" needs a value\", name+\" precisa de um valor\")\n   133\t\t\t\t\t}\n   134\t\t\t\t\tvalue = args[i+1]\n   135\t\t\t\t\ti++\n   136\t\t\t\t}\n   137\t\t\t\tswitch name {\n   138\t\t\t\tcase \"--agent\":\n   139\t\t\t\t\tf.agent = value\n   140\t\t\t\tcase \"--access\":\n   141\t\t\t\t\tif !containsString([]string{posemodel.DelegationAccessRead, posemodel.DelegationAccessSandboxed, posemodel.DelegationAccessWrite, posemodel.DelegationAccessFull}, value) {\n   142\t\t\t\t\t\treturn f, tr(\"--access takes read, sandboxed, write or full\", \"--access recebe read, sandboxed, write ou full\")\n   143\t\t\t\t\t}\n   144\t\t\t\t\tf.access = value\n   145\t\t\t\tcase \"--label\":\n   146\t\t\t\t\tif !delegateLabelRE.MatchString(value) {\n   147\t\t\t\t\t\treturn f, tr(\"--label takes letters, digits, '.', '_' and '-' (64 at most)\", \"--label aceita letras, dígitos, '.', '_' e '-' (no máximo 64)\")\n   148\t\t\t\t\t}\n   149\t\t\t\t\tf.label = value\n   150\t\t\t\tcase \"--lead\":\n   151\t\t\t\t\tvendor, model, err := posemodel.ParseLead(value)\n   152\t\t\t\t\tif err != nil {\n   153\t\t\t\t\t\treturn f, tr(\"--lead takes <vendor>[/<model>], such as openai or anthropic/claude-opus-5-5\", \"--lead recebe <vendor>[/<modelo>], como openai ou anthropic/claude-opus-5-5\")\n   154\t\t\t\t\t}\n   155\t\t\t\t\tf.lead = vendor\n   156\t\t\t\t\tif model != \"\" {\n   157\t\t\t\t\t\tf.lead += \"/\" + model\n   158\t\t\t\t\t}\n   159\t\t\t\tcase \"--reason\":\n   160\t\t\t\t\tf.reason = value\n   161\t\t\t\tcase \"--session\":\n   162\t\t\t\t\tf.session = value\n   163\t\t\t\tcase \"--request\":\n   164\t\t\t\t\tf.request = value\n   165\t\t\t\tcase \"--lines\":\n   166\t\t\t\t\tn, err := strconv.Atoi(value)\n   167\t\t\t\t\tif err != nil || n < 1 || n > 1000 {\n   168\t\t\t\t\t\treturn f, tr(\"--lines takes a number from 1 to 1000\", \"--lines recebe um número de 1 a 1000\")\n   169\t\t\t\t\t}\n   170\t\t\t\t\tf.lines = n\n   171\t\t\t\tcase \"--refresh\":\n   172\t\t\t\t\td, err := time.ParseDuration(value)\n   173\t\t\t\t\tif err != nil || d < 0 || d > time.Hour {\n   174\t\t\t\t\t\treturn f, tr(\"--refresh takes a duration from 0 to 1h (0 turns the preview's refresh off)\", \"--refresh recebe uma duração de 0 a 1h (0 desliga a atualização do preview)\")\n   175\t\t\t\t\t}\n   176\t\t\t\t\tf.refresh = d\n   177\t\t\t\tcase \"--timeout\":\n   178\t\t\t\t\td, err := time.ParseDuration(value)\n   179\t\t\t\t\tif err != nil || d <= 0 {\n   180\t\t\t\t\t\treturn f, tr(\"--timeout takes a positive duration\", \"--timeout recebe uma duração positiva\")\n   181\t\t\t\t\t}\n   182\t\t\t\t\tf.timeout = d\n   183\t\t\t\tcase \"--to\":\n   184\t\t\t\t\tf.to = value\n   185\t\t\t\tcase \"--cd\":\n   186\t\t\t\t\tf.cd = value\n   187\t\t\t\tcase \"--add-dir\":\n   188\t\t\t\t\tf.addDirs = append(f.addDirs, value)\n   189\t\t\t\tcase \"--effort\":\n   190\t\t\t\t\tf.effort = value\n   191\t\t\t\tcase \"--prompt\":\n   192\t\t\t\t\tf.promptFile = value\n   193\t\t\t\tcase \"--note-file\":\n   194\t\t\t\t\tf.noteFile = value\n   195\t\t\t\t}\n   196\t\t\t}\n   197\t\t}\n   198\t\treturn f, \"\"\n   199\t}\n   200\t\n   201\tfunc cmdDelegate(root string, args []string, stdout, stderr io.Writer) int {\n   202\t\tif len(args) == 0 {\n   203\t\t\tdispatchCommandHelp(\"delegate\", nil, stdout, cliLocaleValue())\n   204\t\t\treturn 0\n   205\t\t}\n   206\t\tsub, rest := args[0], args[1:]\n   207\t\tif spec, planned := delegatePlanned[sub]; planned {\n   208\t\t\treturn delegateUsage(stdout, stderr, rest, sub, tr(\"not available yet; it is delivered by spec \"+spec, \"ainda não está disponível; é entregue pela spec \"+spec))\n   209\t\t}\n   210\t\tswitch sub {\n   211\t\tcase posemodel.DelegationPurposeReview, posemodel.DelegationPurposeAdjudicate, posemodel.DelegationPurposeSmoke:\n   212\t\t\treturn cmdDelegatePurpose(root, sub, rest, stdout, stderr)\n   213\t\tcase posemodel.DelegationPurposeTask:\n   214\t\t\treturn cmdDelegateTask(root, rest, stdout, stderr)\n   215\t\tcase \"ls\":\n   216\t\t\treturn cmdDelegateLs(root, rest, stdout, stderr)\n   217\t\tcase \"resume\":\n   218\t\t\treturn cmdDelegateResume(root, rest, stdout, stderr)\n   219\t\tcase \"cancel\":\n   220\t\t\treturn cmdDelegateCancel(root, rest, stdout, stderr)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '1,330p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"os\"\n    28\t\t\"path/filepath\"\n    29\t\t\"strings\"\n    30\t\t\"time\"\n    31\t)\n    32\t\n    33\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    34\t// proven abandoned.\n    35\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    36\t\n    37\t// reviewOrphanReservationAge is how old a reservation without any marker\n    38\t// must be to count as abandoned.\n    39\tconst reviewOrphanReservationAge = 10 * time.Minute\n    40\t\n    41\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    42\t// dispatch ended before recording it, and removes its stalled marker. A\n    43\t// stalled marker whose reservation was never published is only removed; the\n    44\t// returned run is then empty.\n    45\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    46\t\tif !validAttemptFileName(attemptID) {\n    47\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    48\t\t}\n    49\t\tmarkers, _, err := s.ListDelegationActive()\n    50\t\tif err != nil {\n    51\t\t\treturn ReviewRun{}, err\n    52\t\t}\n    53\t\tvar marker *DelegationActiveRun\n    54\t\tfor i := range markers {\n    55\t\t\tif markers[i].AttemptID == attemptID {\n    56\t\t\t\tmarker = &markers[i]\n    57\t\t\t}\n    58\t\t}\n    59\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    60\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    61\t\t}\n    62\t\tdir, err := s.delegationActiveDir(true)\n    63\t\tif err != nil {\n    64\t\t\treturn ReviewRun{}, err\n    65\t\t}\n    66\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    67\t\tif err != nil {\n    68\t\t\treturn ReviewRun{}, err\n    69\t\t}\n    70\t\tdefer lock.Close()\n    71\t\tunlock, err := lockSpecTransferFile(lock)\n    72\t\tif err != nil {\n    73\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    74\t\t}\n    75\t\tdefer unlock()\n    76\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    77\t}\n    78\t\n    79\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    80\t\tvar reserved *DelegatedReviewAttempt\n    81\t\tif marker != nil {\n    82\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    83\t\t\tif err != nil {\n    84\t\t\t\treturn ReviewRun{}, err\n    85\t\t\t}\n    86\t\t\tfor i := range attempts {\n    87\t\t\t\tif attempts[i].AttemptID == attemptID {\n    88\t\t\t\t\treserved = &attempts[i]\n    89\t\t\t\t}\n    90\t\t\t}\n    91\t\t\tif reserved == nil {\n    92\t\t\t\t// The dispatch ended between its marker and its reservation:\n    93\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    94\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    95\t\t\t}\n    96\t\t} else {\n    97\t\t\tif !operatorConfirmed {\n    98\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n    99\t\t\t}\n   100\t\t\torphans, _, err := s.orphanReservations(now)\n   101\t\t\tif err != nil {\n   102\t\t\t\treturn ReviewRun{}, err\n   103\t\t\t}\n   104\t\t\tfor i := range orphans {\n   105\t\t\t\tif orphans[i].AttemptID == attemptID {\n   106\t\t\t\t\treserved = &orphans[i]\n   107\t\t\t\t}\n   108\t\t\t}\n   109\t\t\tif reserved == nil {\n   110\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   111\t\t\t}\n   112\t\t}\n   113\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   114\t\t\t// A release that stopped after the receipt completes by removing\n   115\t\t\t// the stalled marker; with no marker there is nothing to release.\n   116\t\t\tif marker != nil {\n   117\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   118\t\t\t\tif err != nil {\n   119\t\t\t\t\treturn ReviewRun{}, err\n   120\t\t\t\t}\n   121\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   122\t\t\t\tif err != nil {\n   123\t\t\t\t\treturn ReviewRun{}, err\n   124\t\t\t\t}\n   125\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   126\t\t\t}\n   127\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   128\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   129\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   130\t\t}\n   131\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   132\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   133\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   134\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   135\t\tif marker != nil {\n   136\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   137\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   138\t\t} else {\n   139\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   140\t\t}\n   141\t\t// A run the attempt already recorded, by its dispatch or by a release\n   142\t\t// interrupted before the receipt, completes the attempt; no second run\n   143\t\t// is written for it.\n   144\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   145\t\tif err != nil {\n   146\t\t\treturn ReviewRun{}, err\n   147\t\t}\n   148\t\tif !found {\n   149\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   150\t\t\t\treturn ReviewRun{}, err\n   151\t\t\t}\n   152\t\t}\n   153\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   154\t\t\treturn recorded, err\n   155\t\t}\n   156\t\tif marker != nil {\n   157\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   158\t\t}\n   159\t\treturn recorded, nil\n   160\t}\n   161\t\n   162\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   163\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   164\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   165\t\tif err != nil {\n   166\t\t\treturn ReviewRun{}, false, err\n   167\t\t}\n   168\t\tif len(lost) > 0 {\n   169\t\t\t// An unreadable run may be this release's: the history is unknown,\n   170\t\t\t// and the release does not write another (review round 4, N3).\n   171\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   172\t\t}\n   173\t\tvar latest *ReviewRun\n   174\t\tfor i := range runs {\n   175\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   176\t\t\t\tlatest = &runs[i]\n   177\t\t\t}\n   178\t\t}\n   179\t\tif latest == nil {\n   180\t\t\treturn ReviewRun{}, false, nil\n   181\t\t}\n   182\t\treturn *latest, true, nil\n   183\t}\n   184\t\n   185\t// orphanReservations lists the reservations left without a receipt or a\n   186\t// marker, older than reviewOrphanReservationAge, and\n   187\t// says which reservations or receipts it could not read (review round 3, N3).\n   188\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   189\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   190\t\tdirs, err := os.ReadDir(base)\n   191\t\tif errors.Is(err, os.ErrNotExist) {\n   192\t\t\treturn nil, nil, nil\n   193\t\t}\n   194\t\tif err != nil {\n   195\t\t\treturn nil, nil, err\n   196\t\t}\n   197\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   198\t\tif err != nil {\n   199\t\t\treturn nil, nil, err\n   200\t\t}\n   201\t\tif len(markerLost) > 0 {\n   202\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   203\t\t\t// have no marker (review round 6, N1).\n   204\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   205\t\t}\n   206\t\tmarked := map[string]bool{}\n   207\t\tfor _, m := range markers {\n   208\t\t\tmarked[m.AttemptID] = true\n   209\t\t}\n   210\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   211\t\tif err != nil {\n   212\t\t\treturn nil, nil, err\n   213\t\t}\n   214\t\tif len(runLost) > 0 {\n   215\t\t\t// Without the whole run history nothing is known to have no run.\n   216\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   217\t\t}\n   218\t\t// A recorded run does not finish an attempt, its receipt does: a\n   219\t\t// reservation whose run was recorded without a receipt still blocks and\n   220\t\t// is released with that run (review round 5, N3).\n   221\t\t_ = runs\n   222\t\tvar out []DelegatedReviewAttempt\n   223\t\tvar lost []string\n   224\t\tbudget := reviewReadBudget(nil)\n   225\t\tfor _, d := range dirs {\n   226\t\t\tif !d.IsDir() {\n   227\t\t\t\tcontinue\n   228\t\t\t}\n   229\t\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n   230\t\t\tif err != nil {\n   231\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   232\t\t\t\tcontinue\n   233\t\t\t}\n   234\t\t\tfor _, e := range entries {\n   235\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   236\t\t\t\t\tcontinue\n   237\t\t\t\t}\n   238\t\t\t\tvar a DelegatedReviewAttempt\n   239\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   240\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   241\t\t\t\t\tcontinue\n   242\t\t\t\t}\n   243\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif marked[a.AttemptID] {\n   248\t\t\t\t\tcontinue\n   249\t\t\t\t}\n   250\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   251\t\t\t\t\tcontinue\n   252\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   253\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   254\t\t\t\t\tcontinue\n   255\t\t\t\t}\n   256\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   257\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   258\t\t\t\t\tcontinue\n   259\t\t\t\t}\n   260\t\t\t\tout = append(out, a)\n   261\t\t\t}\n   262\t\t}\n   263\t\treturn out, lost, nil\n   264\t}\n   265\t\n   266\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   267\t\tdir, err := s.delegationActiveDir(false)\n   268\t\tif err != nil {\n   269\t\t\treturn err\n   270\t\t}\n   271\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   272\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   273\t\t\t\treturn err\n   274\t\t\t}\n   275\t\t}\n   276\t\treturn nil\n   277\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"agent_message","text":"The standard CLI takes the Linux shim path and no longer uses the reviewer-settable checkout environment value to choose kill targets. I’m checking two remaining boundaries now: whether the shim mistakes unrelated processes for run children, and whether abandoned-attempt release can race a still-live review process."}}
