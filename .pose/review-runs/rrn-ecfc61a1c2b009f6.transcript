{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux.go | sed -n '1,250p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Leftover reviewer processes (spec\n     6\t// pose-review-run-reaps-lingering-reviewer-processes R1): an adapter such as\n     7\t// `codex exec` runs each command in a session of its own, so killing the\n     8\t// adapter's process group misses a command the reviewer left running, and\n     9\t// that command keeps writing into the run's runtime directory while the\n    10\t// cleanup inventory reads it. Every process of the run inherits\n    11\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n    12\t// that entry, ends them and waits for them before the inventory.\n    13\t//\n    14\t// Each process is pinned by a pidfd before it is signalled, and its\n    15\t// environment is read again through the pinned process, so a pid reused by\n    16\t// an unrelated process between the scan and the signal is never killed\n    17\t// (review round 1, N3). A scan that cannot list or read the state of the\n    18\t// processes fails. A process of this user whose environment cannot be read\n    19\t// (one that made itself non-inspectable) cannot be matched: one that already\n    20\t// existed before the adapter started is not the run's and is skipped; any\n    21\t// other may be the run's, so the scan fails and the run stays unconcludable\n    22\t// (review round 2, N2).\n    23\t\n    24\timport (\n    25\t\t\"bytes\"\n    26\t\t\"errors\"\n    27\t\t\"fmt\"\n    28\t\t\"io/fs\"\n    29\t\t\"os\"\n    30\t\t\"path/filepath\"\n    31\t\t\"strconv\"\n    32\t\t\"strings\"\n    33\t\t\"syscall\"\n    34\t\t\"time\"\n    35\t\n    36\t\t\"golang.org/x/sys/unix\"\n    37\t)\n    38\t\n    39\t// reapSealedCheckoutProcesses ends every process whose environment names\n    40\t// worktree as its sealed checkout and returns a description of each. An\n    41\t// error means the run's processes could not be proven ended within the bound.\n    42\tfunc reapSealedCheckoutProcesses(worktree string, baseline map[int]string) ([]string, int, error) {\n    43\t\tif worktree == \"\" {\n    44\t\t\treturn nil, 0, nil\n    45\t\t}\n    46\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n    47\t\tvar reaped []string\n    48\t\tseen := map[int]bool{}\n    49\t\tdeadline := time.Now().Add(reviewReapWait)\n    50\t\tunreadable := 0\n    51\t\tfor {\n    52\t\t\talive, opaque, err := reviewMarkedProcesses(entry)\n    53\t\t\tif err != nil {\n    54\t\t\t\treturn reaped, unreadable, err\n    55\t\t\t}\n    56\t\t\tunreadable = 0\n    57\t\t\tfor pid, start := range opaque {\n    58\t\t\t\tif prior, ok := baseline[pid]; !ok || prior != start {\n    59\t\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"process %d of this user started during the run and cannot be inspected; it may be the run's and was not ended\", pid)\n    60\t\t\t\t}\n    61\t\t\t\tunreadable++\n    62\t\t\t}\n    63\t\t\tfor _, pid := range alive {\n    64\t\t\t\tif !seen[pid] {\n    65\t\t\t\t\tseen[pid] = true\n    66\t\t\t\t\t// Only the pid: the name is the reviewer's to choose and is not\n    67\t\t\t\t\t// recorded (review round 7, N4).\n    68\t\t\t\t\treaped = append(reaped, strconv.Itoa(pid))\n    69\t\t\t\t}\n    70\t\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n    71\t\t\t\t\treturn reaped, unreadable, err\n    72\t\t\t\t}\n    73\t\t\t}\n    74\t\t\tif len(alive) == 0 {\n    75\t\t\t\treturn reaped, unreadable, nil\n    76\t\t\t}\n    77\t\t\tif time.Now().After(deadline) {\n    78\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n    79\t\t\t}\n    80\t\t\ttime.Sleep(50 * time.Millisecond)\n    81\t\t}\n    82\t}\n    83\t\n    84\t// reviewMarkedProcesses lists the live processes whose environment holds\n    85\t// entry, and counts this user's processes whose environment could not be\n    86\t// read. A process that is gone is skipped.\n    87\tfunc reviewMarkedProcesses(entry []byte) ([]int, map[int]string, error) {\n    88\t\tdirs, err := os.ReadDir(\"/proc\")\n    89\t\tif err != nil {\n    90\t\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    91\t\t}\n    92\t\tunreadable := map[int]string{}\n    93\t\tself, uid := os.Getpid(), os.Getuid()\n    94\t\tvar out []int\n    95\t\tfor _, d := range dirs {\n    96\t\t\tpid, err := strconv.Atoi(d.Name())\n    97\t\t\tif err != nil || pid == self {\n    98\t\t\t\tcontinue\n    99\t\t\t}\n   100\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n   101\t\t\tswitch {\n   102\t\t\tcase reviewProcessGoneErr(err):\n   103\t\t\t\tcontinue\n   104\t\t\tcase err != nil:\n   105\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n   106\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n   107\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   108\t\t\t\t\tcontinue\n   109\t\t\t\t}\n   110\t\t\t\tstart, serr := processStartTime(pid)\n   111\t\t\t\tif reviewProcessGoneErr(serr) {\n   112\t\t\t\t\tcontinue\n   113\t\t\t\t}\n   114\t\t\t\tif serr != nil || start == \"\" {\n   115\t\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d start could not be read: %v\", pid, serr)\n   116\t\t\t\t}\n   117\t\t\t\tunreadable[pid] = start\n   118\t\t\t\tcontinue\n   119\t\t\tcase !marked:\n   120\t\t\t\tcontinue\n   121\t\t\t}\n   122\t\t\tzombie, err := reviewProcessZombie(pid)\n   123\t\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n   124\t\t\t\tcontinue\n   125\t\t\t}\n   126\t\t\tif err != nil {\n   127\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n   128\t\t\t}\n   129\t\t\tout = append(out, pid)\n   130\t\t}\n   131\t\treturn out, unreadable, nil\n   132\t}\n   133\t\n   134\t// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n   135\t// after the environment read through that same pinned process still holds\n   136\t// entry.\n   137\tfunc killPinnedMarkedProcess(pid int, entry []byte) error {\n   138\t\tfd, err := unix.PidfdOpen(pid, 0)\n   139\t\tif errors.Is(err, unix.ESRCH) {\n   140\t\t\treturn nil\n   141\t\t}\n   142\t\tif err != nil {\n   143\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   144\t\t}\n   145\t\tdefer unix.Close(fd)\n   146\t\t// The pidfd names one process for its lifetime; if pid was reused before\n   147\t\t// it was opened, the new process does not carry this run's entry.\n   148\t\tmarked, err := reviewProcessMarked(pid, entry)\n   149\t\tif reviewProcessGoneErr(err) || err == nil && !marked {\n   150\t\t\treturn nil\n   151\t\t}\n   152\t\tif err != nil {\n   153\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   154\t\t}\n   155\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   156\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   157\t\t}\n   158\t\treturn nil\n   159\t}\n   160\t\n   161\tfunc reviewProcessMarked(pid int, entry []byte) (bool, error) {\n   162\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   163\t\tif err != nil {\n   164\t\t\treturn false, err\n   165\t\t}\n   166\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n   167\t\t\tif bytes.Equal(kv, entry) {\n   168\t\t\t\treturn true, nil\n   169\t\t\t}\n   170\t\t}\n   171\t\treturn false, nil\n   172\t}\n   173\t\n   174\tfunc reviewProcessOwner(pid int) (int, error) {\n   175\t\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n   176\t\tif err != nil {\n   177\t\t\treturn 0, err\n   178\t\t}\n   179\t\tst, ok := info.Sys().(*syscall.Stat_t)\n   180\t\tif !ok {\n   181\t\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n   182\t\t}\n   183\t\treturn int(st.Uid), nil\n   184\t}\n   185\t\n   186\tfunc reviewProcessGoneErr(err error) bool {\n   187\t\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n   188\t}\n   189\t\n   190\tfunc reviewProcessName(pid int) string {\n   191\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n   192\t\tif err != nil {\n   193\t\t\treturn \"?\"\n   194\t\t}\n   195\t\treturn strings.TrimSpace(string(raw))\n   196\t}\n   197\t\n   198\tfunc reviewProcessZombie(pid int) (bool, error) {\n   199\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n   200\t\tif err != nil {\n   201\t\t\treturn false, err\n   202\t\t}\n   203\t\t// The state follows the parenthesised command name.\n   204\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   205\t\t\treturn raw[i+2] == 'Z', nil\n   206\t\t}\n   207\t\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n   208\t}\n   209\t\n   210\t// reviewOpaqueProcessBaseline records, before the adapter starts, the\n   211\t// processes of this user whose environment cannot be read, by pid and start\n   212\t// time: they cannot be the run's.\n   213\tfunc reviewOpaqueProcessBaseline() map[int]string {\n   214\t\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv + \"=\\x00\"))\n   215\t\treturn opaque\n   216\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_active.go | sed -n '1,240p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Active delegated runs and cancellation (spec pose-delegation-surface R13).\n     4\t//\n     5\t// A run's record is written when it ends, so a running run is known only by a\n     6\t// private marker its process writes when the attempt starts and removes when\n     7\t// the record is published. The marker names the process the way a start lock\n     8\t// does, so a reader can tell a running owner from a dead one. Cancelling\n     9\t// writes a request beside the marker; the running process watches for it,\n    10\t// stops the agent and records the run failed with the cause cancelled. The\n    11\t// attempt stays consumed: cancelling never returns budget.\n    12\t\n    13\timport (\n    14\t\t\"context\"\n    15\t\t\"crypto/rand\"\n    16\t\t\"encoding/hex\"\n    17\t\t\"encoding/json\"\n    18\t\t\"errors\"\n    19\t\t\"fmt\"\n    20\t\t\"os\"\n    21\t\t\"path/filepath\"\n    22\t\t\"sort\"\n    23\t\t\"strings\"\n    24\t\t\"sync\"\n    25\t\t\"sync/atomic\"\n    26\t\t\"time\"\n    27\t)\n    28\t\n    29\tconst delegationActiveDir = reviewPrivateDir + \"/active\"\n    30\t\n    31\t// DelegationActiveRun is the marker of a run in progress.\n    32\ttype DelegationActiveRun struct {\n    33\t\tSchemaVersion int    `json:\"schema_version\"`\n    34\t\tAttemptID     string `json:\"attempt_id\"`\n    35\t\t// RunToken names this run of the attempt: a cancellation request carries\n    36\t\t// it, so a request meant for one run never stops another.\n    37\t\tRunToken  string         `json:\"run_token\"`\n    38\t\tResumes   string         `json:\"resumes,omitempty\"`\n    39\t\tLabel     string         `json:\"label,omitempty\"`\n    40\t\tPurpose   string         `json:\"purpose\"`\n    41\t\tAgent     string         `json:\"agent\"`\n    42\t\tScope     string         `json:\"scope\"`\n    43\t\tBundleID  string         `json:\"bundle_id\"`\n    44\t\tStartedAt string         `json:\"started_at\"`\n    45\t\tOwner     StartLockOwner `json:\"owner\"`\n    46\t\t// HeartbeatAt is rewritten every HeartbeatEvery seconds by the process\n    47\t\t// that runs the attempt (spec pose-delegated-review-completion-signal R4,\n    48\t\t// D2).\n    49\t\tHeartbeatAt    string `json:\"heartbeat_at,omitempty\"`\n    50\t\tHeartbeatEvery int    `json:\"heartbeat_every,omitempty\"`\n    51\t\t// StalledAt is computed by the reader from the stall claim the first\n    52\t\t// reader that found the run stalled published.\n    53\t\tStalledAt string `json:\"stalled_at,omitempty\"`\n    54\t\t// Liveness is computed by the reader: owner-active, owner-dead or owner-unknown.\n    55\t\tLiveness string `json:\"liveness,omitempty\"`\n    56\t\tDetail   string `json:\"detail,omitempty\"`\n    57\t\t// CancelRequested is computed by the reader.\n    58\t\tCancelRequested bool `json:\"cancel_requested,omitempty\"`\n    59\t\t// Round is the review round the run reviews (spec\n    60\t\t// pose-delegated-review-round-protocol R1).\n    61\t\tRound int `json:\"round,omitempty\"`\n    62\t}\n    63\t\n    64\tfunc (s Store) delegationActiveDir(create bool) (string, error) {\n    65\t\tif create {\n    66\t\t\tif _, err := ensureReviewArtifactDir(s.Root, reviewPrivateDir, true); err != nil {\n    67\t\t\t\treturn \"\", err\n    68\t\t\t}\n    69\t\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewPrivateDir))\n    70\t\t\tignore := filepath.Join(dir, \".gitignore\")\n    71\t\t\tif _, err := os.Lstat(ignore); errors.Is(err, os.ErrNotExist) {\n    72\t\t\t\tif err := PublishFile(ignore, []byte(\"*\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil && !errors.Is(err, os.ErrExist) {\n    73\t\t\t\t\treturn \"\", err\n    74\t\t\t\t}\n    75\t\t\t}\n    76\t\t}\n    77\t\treturn ensureReviewArtifactDir(s.Root, delegationActiveDir, create)\n    78\t}\n    79\t\n    80\tfunc validAttemptFileName(attempt string) bool {\n    81\t\treturn attempt != \"\" && len(attempt) <= 128 && !strings.ContainsAny(attempt, `/\\.`+\"\\x00\")\n    82\t}\n    83\t\n    84\t// markDelegationActive writes the marker and starts the cancellation watcher.\n    85\t// The returned stop removes both; cancelled reports whether a cancellation\n    86\t// request stopped the run.\n    87\t//\n    88\t// stop(true) stops the watcher and the heartbeat but keeps the marker: a run\n    89\t// whose record was not published leaves it, and it turns stalled once its\n    90\t// process is gone (spec pose-delegated-review-completion-signal R4, R5).\n    91\tfunc (s Store) markDelegationActive(run ReviewRun, cancel context.CancelFunc) (stop func(keepMarker ...bool), cancelled *atomic.Bool, err error) {\n    92\t\tcancelled = &atomic.Bool{}\n    93\t\tif !validAttemptFileName(run.AttemptID) {\n    94\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: attempt %q cannot name an active marker\", run.AttemptID)\n    95\t\t}\n    96\t\tdir, err := s.delegationActiveDir(true)\n    97\t\tif err != nil {\n    98\t\t\treturn func(...bool) {}, cancelled, err\n    99\t\t}\n   100\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + run.AttemptID, Worktree: s.Root, Operation: \"pose delegate \" + run.Purpose, PID: os.Getpid(), AcquiredAt: run.StartedAt}\n   101\t\towner.Host, _ = os.Hostname()\n   102\t\tidentifyStartLockProcess(&owner)\n   103\t\ttoken := make([]byte, 16)\n   104\t\tif _, err := rand.Read(token); err != nil {\n   105\t\t\treturn func(...bool) {}, cancelled, err\n   106\t\t}\n   107\t\tevery := delegationHeartbeatEvery\n   108\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: run.AttemptID, RunToken: hex.EncodeToString(token), Resumes: run.Resumes, Label: run.Label, Purpose: run.Purpose, Agent: run.Adapter, Scope: run.Scope, BundleID: run.BundleID, StartedAt: run.StartedAt, Owner: owner, Round: run.Round,\n   109\t\t\tHeartbeatAt: time.Now().UTC().Format(time.RFC3339Nano), HeartbeatEvery: int(every / time.Second)}\n   110\t\traw, _ := json.MarshalIndent(marker, \"\", \"  \")\n   111\t\tpath := filepath.Join(dir, run.AttemptID+\".json\")\n   112\t\trequest := cancelRequestPath(dir, marker)\n   113\t\tif err := PublishFile(path, append(raw, '\\n'), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n   114\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: another run of attempt %s is active: %w\", run.AttemptID, err)\n   115\t\t}\n   116\t\tdone, exited := make(chan struct{}), make(chan struct{})\n   117\t\tgo func() {\n   118\t\t\tdefer close(exited)\n   119\t\t\tticker := time.NewTicker(250 * time.Millisecond)\n   120\t\t\tdefer ticker.Stop()\n   121\t\t\theartbeat := time.NewTicker(every)\n   122\t\t\tdefer heartbeat.Stop()\n   123\t\t\tfor {\n   124\t\t\t\tselect {\n   125\t\t\t\tcase <-done:\n   126\t\t\t\t\treturn\n   127\t\t\t\tcase <-heartbeat.C:\n   128\t\t\t\t\t// Select picks among ready cases at random: once stop has\n   129\t\t\t\t\t// asked, no further heartbeat starts, so it waits for at\n   130\t\t\t\t\t// most the one in flight (review round 1, HB01).\n   131\t\t\t\t\tselect {\n   132\t\t\t\t\tcase <-done:\n   133\t\t\t\t\t\treturn\n   134\t\t\t\t\tdefault:\n   135\t\t\t\t\t}\n   136\t\t\t\t\tbeatDelegationMarker(path, marker.RunToken)\n   137\t\t\t\tcase <-ticker.C:\n   138\t\t\t\t\tif _, err := os.Lstat(request); err == nil {\n   139\t\t\t\t\t\tcancelled.Store(true)\n   140\t\t\t\t\t\tcancel()\n   141\t\t\t\t\t\treturn\n   142\t\t\t\t\t}\n   143\t\t\t\t}\n   144\t\t\t}\n   145\t\t}()\n   146\t\tvar once sync.Once\n   147\t\tstop = func(keepMarker ...bool) {\n   148\t\t\tonce.Do(func() {\n   149\t\t\t\tclose(done)\n   150\t\t\t\tdelegationStopRequested()\n   151\t\t\t\t// A heartbeat in flight finishes before the marker goes, so it\n   152\t\t\t\t// cannot rename a new one into place after the removal (spec\n   153\t\t\t\t// pose-delegation-marker-stop-joins-heartbeat R1).\n   154\t\t\t\t<-exited\n   155\t\t\t\t_ = os.Remove(request)\n   156\t\t\t\tif len(keepMarker) == 0 || !keepMarker[0] {\n   157\t\t\t\t\t_ = os.Remove(path)\n   158\t\t\t\t}\n   159\t\t\t})\n   160\t\t}\n   161\t\treturn stop, cancelled, nil\n   162\t}\n   163\t\n   164\t// delegationStopRequested is a test seam called once stop has asked the\n   165\t// watcher to end, before it waits for it.\n   166\tvar delegationStopRequested = func() {}\n   167\t\n   168\t// delegationHeartbeatEvery is the interval a running attempt declares.\n   169\tvar delegationHeartbeatEvery = 10 * time.Second\n   170\t\n   171\t// beatDelegationMarker rewrites the heartbeat of the marker run token names,\n   172\t// by compare-and-swap: a marker already recorded stalled, or replaced by\n   173\t// another run, is left as it is.\n   174\tfunc beatDelegationMarker(path, token string) {\n   175\t\traw, err := readLedgerRaw(path)\n   176\t\tif err != nil {\n   177\t\t\treturn\n   178\t\t}\n   179\t\tvar marker DelegationActiveRun\n   180\t\tif json.Unmarshal(raw, &marker) != nil || marker.RunToken != token {\n   181\t\t\treturn\n   182\t\t}\n   183\t\tmarker.HeartbeatAt = time.Now().UTC().Format(time.RFC3339Nano)\n   184\t\tnext, _ := json.MarshalIndent(marker, \"\", \"  \")\n   185\t\t_ = PublishFile(path, append(next, '\\n'), 0600, PublishAuthoritative, ExpectBytes(raw, true))\n   186\t}\n   187\t\n   188\t// delegationMarkerSilent reports a heartbeat older than three intervals.\n   189\tfunc delegationMarkerSilent(marker DelegationActiveRun, now time.Time) bool {\n   190\t\tevery := time.Duration(marker.HeartbeatEvery) * time.Second\n   191\t\tif every <= 0 {\n   192\t\t\tevery = delegationHeartbeatEvery\n   193\t\t}\n   194\t\tlast := marker.HeartbeatAt\n   195\t\tif last == \"\" {\n   196\t\t\tlast = marker.StartedAt\n   197\t\t}\n   198\t\tat, err := time.Parse(time.RFC3339Nano, last)\n   199\t\treturn err == nil && now.Sub(at) > 3*every\n   200\t}\n   201\t\n   202\t// stallClaimPath names the claim that records a run stalled.\n   203\tfunc stallClaimPath(dir string, marker DelegationActiveRun) string {\n   204\t\treturn filepath.Join(dir, marker.AttemptID+\".\"+marker.RunToken+\".stalled\")\n   205\t}\n   206\t\n   207\tfunc readDelegationStall(dir string, marker DelegationActiveRun) string {\n   208\t\traw, err := readLedgerRaw(stallClaimPath(dir, marker))\n   209\t\tif err != nil {\n   210\t\t\treturn \"\"\n   211\t\t}\n   212\t\treturn strings.TrimSpace(string(raw))\n   213\t}\n   214\t\n   215\t// recordDelegationStall publishes the stall claim exclusively: the first\n   216\t// reader's instant is the one every reader returns, so concurrent readers\n   217\t// agree (R4).\n   218\tfunc recordDelegationStall(dir string, marker DelegationActiveRun) string {\n   219\t\tat := time.Now().UTC().Format(time.RFC3339Nano)\n   220\t\t_ = PublishFile(stallClaimPath(dir, marker), []byte(at+\"\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n   221\t\treturn readDelegationStall(dir, marker)\n   222\t}\n   223\t\n   224\tfunc cancelRequestPath(dir string, marker DelegationActiveRun) string {\n   225\t\treturn filepath.Join(dir, marker.AttemptID+\".\"+marker.RunToken+\".cancel\")\n   226\t}\n   227\t\n   228\tfunc validRunToken(token string) bool {\n   229\t\tif len(token) != 32 {\n   230\t\t\treturn false\n   231\t\t}\n   232\t\t_, err := hex.DecodeString(token)\n   233\t\treturn err == nil\n   234\t}\n   235\t\n   236\t// ListDelegationActive reads the markers with the liveness of their owners,\n   237\t// and returns as losses the markers it cannot read: a run it cannot observe is\n   238\t// reported, never listed as running nor left out in silence.\n   239\tfunc (s Store) ListDelegationActive() ([]DelegationActiveRun, []string, error) {\n   240\t\tdir, err := s.delegationActiveDir(false)\n","exit_code":0,"status":"completed"}}
