{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/cli.go | sed -n '1,52p'; nl -ba pose-mcp/internal/pose/main_test.go | sed -n '1,60p'; nl -ba pose-mcp/internal/cli/cli_test.go | sed -n '1,60p'\"","aggregated_output":"     1\t// Package cli implements the native-only unified `pose` binary.\n     2\tpackage cli\n     3\t\n     4\timport (\n     5\t\t\"fmt\"\n     6\t\t\"io\"\n     7\t\t\"os\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strings\"\n    10\t\n    11\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    12\t\t\"github.com/harne8/pose-mcp/internal/version\"\n    13\t)\n    14\t\n    15\t// Version mirrors the authoritative release version. The release pipeline\n    16\t// stamps internal/version via -ldflags (spec pose-version-contract).\n    17\tvar Version = version.Version\n    18\t\n    19\t// The engine package records the version in assessment bindings without\n    20\t// importing internal/version (spec pose-engine-package-stays-mirrorable).\n    21\tfunc init() {\n    22\t\tposemodel.EngineVersion = version.Version\n    23\t\tposemodel.EngineReleaseBase = version.ReleaseBase()\n    24\t}\n    25\t\n    26\t// Main is the entrypoint used by cmd/pose. It returns the process exit code.\n    27\tfunc Main(args []string, stdout, stderr io.Writer) int {\n    28\t\tif len(args) > 0 && args[0] == posemodel.ReviewShimArg {\n    29\t\t\treturn posemodel.RunReviewShim(args[1:])\n    30\t\t}\n    31\t\treturn mainWithUsage(args, stdout, stderr)\n    32\t}\n    33\t\n    34\tfunc mainCommand(args []string, stdout, stderr io.Writer) int {\n    35\t\tlocale := cliLocaleFor(stderr)\n    36\t\tcmd := \"help\"\n    37\t\tif len(args) > 0 {\n    38\t\t\tcmd = args[0]\n    39\t\t\targs = args[1:]\n    40\t\t}\n    41\t\n    42\t\tif cmd == \"help\" {\n    43\t\t\treturn cmdHelp(stdout, args)\n    44\t\t}\n    45\t\n    46\t\tif hasHelpFlag(args) || cmd == \"-h\" || cmd == \"--help\" {\n    47\t\t\tif cmd == \"-h\" || cmd == \"--help\" {\n    48\t\t\t\treturn cmdHelp(stdout, nil)\n    49\t\t\t}\n    50\t\t\tif dispatchCommandHelp(cmd, args, stdout, locale) {\n    51\t\t\t\treturn 0\n    52\t\t\t}\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"os\"\n     5\t\t\"testing\"\n     6\t\n     7\t\t\"github.com/harne8/pose-mcp/internal/testgit\"\n     8\t)\n     9\t\n    10\t// TestMain keeps git's detached automatic maintenance out of the repositories\n    11\t// these tests create (spec test-git-repos-run-no-background-maintenance).\n    12\t//\n    13\t// It also drops the session variables of the agent hosts: a bundle sealed by a\n    14\t// test would otherwise record whichever agent ran the suite as its\n    15\t// implementation (spec pose-delegation-routing R2).\n    16\tfunc TestMain(m *testing.M) {\n    17\t\t// A dispatch re-enters this binary as the review run shim.\n    18\t\tif len(os.Args) > 1 && os.Args[1] == ReviewShimArg {\n    19\t\t\tos.Exit(RunReviewShim(os.Args[2:]))\n    20\t\t}\n    21\t\tReviewShimAvailable = true\n    22\t\tif EngineVersion == \"unknown\" {\n    23\t\t\tEngineVersion = \"pose-test-engine\"\n    24\t\t}\n    25\t\tfor _, name := range DelegationSessionVariables() {\n    26\t\t\t_ = os.Unsetenv(name)\n    27\t\t}\n    28\t\tcleanup, err := testgit.Isolate()\n    29\t\tif err != nil {\n    30\t\t\tpanic(err)\n    31\t\t}\n    32\t\tcode := m.Run()\n    33\t\tcleanup()\n    34\t\tos.Exit(code)\n    35\t}\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"encoding/json\"\n     6\t\t\"fmt\"\n     7\t\t\"os\"\n     8\t\t\"os/exec\"\n     9\t\t\"path/filepath\"\n    10\t\t\"strings\"\n    11\t\t\"testing\"\n    12\t\t\"time\"\n    13\t\n    14\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    15\t\t\"github.com/harne8/pose-mcp/internal/testgit\"\n    16\t)\n    17\t\n    18\tfunc TestMain(m *testing.M) {\n    19\t\t// A dispatch re-enters this binary as the review run shim.\n    20\t\tif len(os.Args) > 1 && os.Args[1] == posemodel.ReviewShimArg {\n    21\t\t\tos.Exit(posemodel.RunReviewShim(os.Args[2:]))\n    22\t\t}\n    23\t\tposemodel.ReviewShimAvailable = true\n    24\t\tif posemodel.EngineVersion == \"unknown\" {\n    25\t\t\tposemodel.EngineVersion = \"pose-test-engine\"\n    26\t\t}\n    27\t\t_ = os.Setenv(\"POSE_USAGE_DISABLED\", \"1\")\n    28\t\t// A bundle sealed here must not record the agent running the suite as its\n    29\t\t// implementation (spec pose-delegation-routing R2).\n    30\t\tfor _, name := range posemodel.DelegationSessionVariables() {\n    31\t\t\t_ = os.Unsetenv(name)\n    32\t\t}\n    33\t\t// A detached run started in this process would run the test binary as\n    34\t\t// its supervisor; the detach tests run the built pose command instead.\n    35\t\tdelegateExecutable = func() (string, error) {\n    36\t\t\treturn \"\", fmt.Errorf(\"tests start detached runs through the built pose command (poseBinary)\")\n    37\t\t}\n    38\t\tcleanup, err := testgit.Isolate()\n    39\t\tif err != nil {\n    40\t\t\tpanic(err)\n    41\t\t}\n    42\t\tcode := m.Run()\n    43\t\t// The pose command the detach tests built is removed with the run.\n    44\t\tif builtPose != \"\" {\n    45\t\t\t_ = os.RemoveAll(filepath.Dir(builtPose))\n    46\t\t}\n    47\t\tcleanup()\n    48\t\tos.Exit(code)\n    49\t}\n    50\t\n    51\t// newGitRepo creates a temp dir initialized as a git repository and returns\n    52\t// its path. Tests chdir into it so projectRoot() resolves there.\n    53\tfunc newGitRepo(t *testing.T) string {\n    54\t\tt.Helper()\n    55\t\tdir := t.TempDir()\n    56\t\tif out, err := exec.Command(\"git\", \"-C\", dir, \"init\", \"-q\").CombinedOutput(); err != nil {\n    57\t\t\tt.Fatalf(\"git init: %v: %s\", err, out)\n    58\t\t}\n    59\t\treturn dir\n    60\t}\n","exit_code":0,"status":"completed"}}
