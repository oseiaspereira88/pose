)\n\targs := []string{\"-C\", r, \"diff\", \"--name-only\", \"HEAD\"}\n\tgot, err := RawGitDiffReadOnly(r, args...)\n\tb := snap()\n\tt.Logf(\"split readonly=%q err=%v unchanged=%v\\n%s---\\n%s\", got, err, a == b, a, b)\n}\n\nfunc TestProbeRound1(t *testing.T) {\n\ts := zr(t)\n\tzw(t, s, \"f\", \"1\\n\")\n\tzc(t, s)\n\tr := zr(t)\n\tzg(t, r, true, \"submodule\", \"add\", \"-q\", s, \"mod\")\n\tzw(t, r, \"proj/a\", \"1\\n\")\n\tzw(t, r, \"d/x\", \"1\\n\")\n\tzw(t, r, \"gone\", \"1\\n\")\n\tos.Symlink(\"one\", filepath.Join(r, \"l\"))\n\tzc(t, r)\n\tm := filepath.Join(r, \"mod\")\n\tzw(t, m, \"f\", \"2\\n\")\n\tzc(t, m)\n\tzw(t, r, \"proj/new\", \"1\\n\")\n\tzw(t, r, \"d/x\", \"2\\n\")\n\tzw(t, r, \"gone\", \"2\\n\")\n\tos.Remove(filepath.Join(r, \"l\"))\n\tos.Symlink(\"two\", filepath.Join(r, \"l\"))\n\tzc(t, r)\n\tzg(t, m, true, \"checkout\", \"-q\", \"HEAD~1\")\n\tzw(t, m, \"f\", \"dirty\\n\")\n\tzw(t, r, \"proj/new\", \"2\\n\")\n\tos.RemoveAll(filepath.Join(r, \"d\"))\n\tzw(t, r, \"d\", \"file\\n\")\n\tzw(t, r, \"gone\", \"1\\n\")\n\tzg(t, r, true, \"rm\", \"-q\", \"--cached\", \"gone\")\n\tos.Remove(filepath.Join(r, \"l\"))\n\tos.Symlink(\"one\", filepath.Join(r, \"l\"))\n\tzcmp(t, \"since base\", r, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"--no-renames\", \"HEAD~1\", \"--\")\n\tzcmp(t, \"range\", r, \"diff\", \"--name-only\", \"HEAD~1..HEAD\", \"--\")\n\tzcmp(t, \"three dot\", r, \"diff\", \"--name-only\", \"HEAD~1...\", \"--\")\n\tzcmp(t, \"subdir root\", filepath.Join(r, \"proj\"), \"diff\", \"--name-only\", \"HEAD~1\", \"--\")\n}\n\nfunc TestProbeConflict(t *testing.T) {\n\tr := zr(t)\n\tzw(t, r, \"a\", \"1\\n\")\n\tzc(t, r)\n\tzg(t, r, true, \"checkout\", \"-q\", \"-b\", \"o\")\n\trec := \".pose/review-attempts/k/000001.json\"\n\tzw(t, r, rec, \"theirs\\n\")\n\tzc(t, r)\n\tzg(t, r, true, \"checkout\", \"-q\", \"main\")\n\tzw(t, r, rec, \"ours\\n\")\n\tzc(t, r)\n\tzg(t, r, false, \"merge\", \"o\")\n\tzw(t, r, \".pose/review-attempts/k/000002.json\", \"n\\n\")\n\tzg(t, r, true, \"add\", \"-N\", \".pose/review-attempts/k/000002.json\")\n\tf, err := (Store{Root: r}).ReviewRunHistoryFindings()\n\tt.Logf(\"ledger conflict+ita: %v %v\", f, err)\n\tzcmp(t, \"conflict\", r, \"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\")\n}\nEOF\nprintf '{\"Replace\":{\"%s/pose-mcp/internal/pose/zz_probe_test.go\":\"%s/zz_probe_test.go\"}}' \"$PWD\" \"$TMPDIR\" > \"$TMPDIR/overlay.json\"\ngo -C pose-mcp test -overlay \"$TMPDIR/overlay.json\" ./internal/pose -run '^TestProbe(Racy|NoIndex|Split|Round1|Conflict)' -v -count=1","is_backgrounded":false,"task_type":"local_bash","uuid":"d29e7271-8490-454d-a454-ce97522f3936","session_id":"[private-session]"}
