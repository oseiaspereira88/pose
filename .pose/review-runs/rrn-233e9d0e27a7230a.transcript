TransitionCandidates())\n\tplain, _ := exec.Command(\"git\", \"-C\", r, \"diff\", \"--name-only\", \"HEAD\").Output()\n\tt.Logf(\"plain=%q\", plain)\n}\nEOF\nprintf '{\"Replace\":{\"%s/pose-mcp/internal/cli/zz_cli_probe_test.go\":\"%s/zz_cli_probe_test.go\"}}' \"$PWD\" \"$TMPDIR\" > \"$TMPDIR/overlay-cli.json\"\ngo -C pose-mcp test -overlay \"$TMPDIR/overlay-cli.json\" ./internal/cli -run '^TestProbeCLI' -v -count=1\ngo -C pose-mcp vet ./internal/cli ./internal/pose; echo \"vet $?\"\ngo -C pose-mcp test ./internal/cli ./internal/pose -run 'LeaveTheIndexAlone|NeverChangeTheIndex|AnswersAsThePlainDiff|ReadyTransition|ChangedScope|ChangedFiles|ReviewRunHistory|HistoryFindings|MaterialWorktree|RawHistory|UpdatePreviewHasNoPhysicalMutation' -count=1; echo \"test $?\"","is_backgrounded":false,"task_type":"local_bash","uuid":"87855d51-9625-44fb-a052-79aa73ce9b4f","session_id":"[private-session]"}
