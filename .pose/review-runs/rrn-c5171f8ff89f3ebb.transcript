\"--no-replace-objects\", \"-C\", root}, args...)...)\npose-mcp/internal/pose/governance_read_view_git.go:643:\t// Git writes it untranslated: a translated \"not a git repository\" left a\npose-mcp/internal/pose/governance_git_untranslated_test.go:16:\tif strings.Contains(strings.ToLower(string(out)), \"not a git repository\") {\npose-mcp/internal/pose/governance_git_untranslated_test.go:22:\tTestScopeIndexInputsAreCheckedOncePerCoordinator(t)\npose-mcp/internal/pose/release_lifecycle.go:692:\tif !errors.As(err, &failure) || !strings.Contains(failure.Stderr, \"not a git repository\") {\npose-mcp/internal/pose/git_batch.go:36:\tcmd := gitCommandContext(ctx, \"-C\", r.root, \"cat-file\", \"--batch\")\npose-mcp/internal/pose/review_scope_index_inputs_test.go:22:func TestScopeIndexInputsAreCheckedOncePerCoordinator(t *testing.T) {\npose-mcp/internal/pose/engine_reads_raw_history_test.go:35:\t\"internal/pose/git_snapshot_integrity.go#gitCommandContext\": \"the raw reader itself\",\npose-mcp/internal/pose/release_manifest_integrity.go:358:\t\t\treturn \"\", false, fmt.Errorf(\"%w: %s (not a git repository)\", ErrReleaseTagMissing, tag)\npose-mcp/internal/pose/review_path_attribution.go:135:\tcmd := gitCommandContext(ctx, \"-C\", root, \"-c\", \"core.quotePath=false\", \"log\", \"--no-walk\", \"--stdin\",\npose-mcp/internal/pose/spec_trailers.go:81:\treturn gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\npose-mcp/internal/pose/git_snapshot_integrity.go:358:var ErrGitUnavailable = errors.New(\"pose: not a git repository\")\npose-mcp/internal/pose/git_snapshot_integrity.go:566:\treturn gitCommandContext(context.Background(), args...)\npose-mcp/internal/pose/git_snapshot_integrity.go:569:// gitCommandContext is gitCommand under ctx. Both read raw object history: a\npose-mcp/internal/pose/git_snapshot_integrity.go:572:func gitCommandContext(ctx context.Context, args ...string) *exec.Cmd {\npose-mcp/internal/pose/module_discovery.go:402:\t\tif errors.As(gitErr, &exit) && strings.Contains(strings.ToLower(string(exit.Stderr)), \"not a git repository\") {\npose-mcp/internal/pose/git_locale_test.go:21:\t\t\"  echo 'fatal: not a git repository (or any of the parent directories): .git' >&2\\n\" +\n11:- make validation and reporting consistent\n27:4. **Deterministic validation**: prefer reproducible commands (`test`, `lint`, `typecheck`, `build`, contract/security checks).\n28:5. **Risk transparency**: always surface gaps and human-review points.\n44:  indexes/       # repo-map, services, packages, validation-matrix, module-metadata, task-map, spec-graph, roadmaps\n62:- [`.pose/workflows/*.md`](.pose/workflows/): procedure per work type (`feature`, `bugfix`, `review`, `refactor`, `documentation-update`, `recurrence-escalation`).\n73:- [`.pose/templates/doc-audit-report.md`](.pose/templates/doc-audit-report.md): template for editorial reviews and documentation audits.\n84:includes the relevant \"Execution — planner/implementer/reviewer mode\" sections.\n88:- Review: [`.pose/workflows/review.md`](.pose/workflows/review.md)\n142:  trailing `(owner:@alias crit:low|medium|high review:YYYY-MM-DD)` group —\n156:  module repository the validation matrix registers: a Go test function or\n196:pose spec-transfer preview --source <xref> --destination <xref> --map R1=equivalent:R1 [--json]\n234:# Governed closeout and review\n236:pose review-plan <scope|xref> [--json] [--explain]\n237:pose review bundle <scope|xref> [--json] [--explain] [--seal [--lead <vendor>[/<model>]]] [--expect-context <digest>]\n238:pose review attest <bundle-id> --reviewer <execution-id> --decision <decision> --evidence <ref>\n240:pose review attest --envelope <project-relative-path> [--apply]\n241:pose review auto-attest <bundle-id|scope-ref> [--reviewer <id>] [--apply]\n242:pose review verify <scope|xref|bundle-id|bundle-path> [--json]\n243:pose review-check <scope|xref> [--json]\n245:pose review record <scope|xref> --reviewer <execution-id> --decision <decision> --evidence <ref> [--apply] [--expect-context <digest>]\n251:pose delegate review|adjudicate|smoke <scope|bundle-id> [--agent auto|<name>] [--label <name>] [--lead <vendor>] [--reason <text>] [--note-file <path>] [--dry-run] [--json]\n261:pose runtime run [--envelope] [--timeout <d>] <review-check|closeout-check|artifact-check|surface-check|roadmap-check> [args...]  # runs the check in the runtime when there is one, else standalone\n268:pose docs-review <resolve <doc> [--no-change --reason <text>] [--commit <sha>]|request <doc>|--all-stale>\n300:                                   # native issuers that sign review attestations; keys live outside the project\n310:pose install <dir> [--locale tag]  # install the embedded POSE without cloning\n311:pose update [--dry-run] [--force] [--no-self] [--locale tag]\n342:- `init` — ensures the minimal required `.pose` directory structure, policy files and indexes. Supports `--wizard` to auto-detect repository stacks and seed the initial validation matrix.\n343:- `check` — validates POSE structural integrity (required paths and references in `AGENTS.md`/`POSE.md`), and that the published index set is whole (an error in strict mode, a warning in tolerant mode, naming `pose index`, when the generation descriptor does not describe its files; a stale index relative to the sources is not reported) **plus** the [`validation-matrix.json`](.pose/indexes/validation-matrix.json) schema, [`task-map.json`](.pose/indexes/task-map.json) sync, the native spec dependency graph and the schema-version gate. It fails in `--strict` and warns where permitted in `--tolerant`.\n346:- `spec-transfer` — explicit cross-project authority transfer. `preview` emits a deterministic digest-bound JSON plan without writing. Requirement mappings are explicit (`R1=equivalent:R1`, `R2=withdrawn`, `-=pending:R3`); apply requires the same digest plus one `--authorize-project` for every affected repository, and resume verifies the saved plan copies and receipts. Transfer is refused until both endpoints and every affected project adopt review-policy schema 4 (`qualified_artifact_refs_version: 1`, `spec_authority_transfer_version: 1`). Current dependency/membership links follow the verified redirect; the MCP tool `pose_spec_transfer_status` reads the journal only within its authorized project. `--mode reconcile-terminal` retires a coordinator spec onto an executor that is already `done` with a terminal closeout in its own project: the executor file is never written (apply only verifies its digest), the map is N:M over every source requirement and may target another spec with `destination_ref`, `withdrawn` needs a `rationale`, and `pending` needs a `rationale` plus an open target spec, recorded in the schema-2 redirect as `open_obligations`; `--map-file` reads the map as JSON. Engines without this mode refuse schema-2 plans and redirects. No automatic commits, pushes or policy adoption occur. Split-section specs without a single `spec.md` are reported as unsupported rather than rewritten.\n350:- `new-knowledge` — creates an artifact in [`.pose/knowledge/`](.pose/knowledge/) from [`.pose/templates/knowledge.md`](.pose/templates/knowledge.md) with mandatory frontmatter (`type`, `owner`, `sensitivity`, `created_at`, `last_reviewed_at`, `expires_at`). Computes `expires_at` from the TTL (default 30d, max 90d).\n351:- `validate` — runs the declarative matrix in [`validation-matrix.json`](.pose/indexes/validation-matrix.json): per-stack checks, per-module overrides, severity (`required`/`optional`) and mode (`strict`/`tolerant`). `--json-out`/`--junit`/`--sarif <path>` (`--json <path>` still works as a deprecated alias of `--json-out <path>`) emit the versioned structured result (schema 1) from one canonical model: stable check IDs (`<module>/<stack>/<name>`), command metadata, timing, severity, distinguishable outcomes (`pass|fail|error|skipped` — infra failures never masquerade as check failures), deterministic skip reasons, bounded captured output and secret redaction (configured env values only; inherited environment never enters the result). Text output stays authoritative; machine formats are additive. POSE-specific semantics survive the JUnit/SARIF projections via documented extensions (classname suffix / `pose/*` properties).\n353:  **Changed scope:** `--changed-from <rev> [--changed-to <rev>]` selects the minimum safe module set deterministically — modules containing changed files (tracked and untracked), transitive dependents via `dependsOn` edges in [`module-metadata.json`](.pose/indexes/module-metadata.json), and policy widening (criticality `high` always runs). A change outside every module runs everything (uncertainty prefers safe execution); unselected checks are recorded as skipped with the selection reason and `--explain` prints every decision. Revisions are confined to a safe grammar; without the flags, full validation is unchanged.\n358:  **Evidence classes:** every check declares the `evidenceClass` it produces from one closed vocabulary — `build`, `unit`, `integration`, `e2e`, `reachability`, `a11y`, `design-system`, `contrast`, `visual-regression`, `lint`, `typecheck`, `security-scan`, `contract`, `structure`, `smoke` — the same vocabulary review profiles may demand; a check outside it is refused, and a check with no class contributes nothing when a review collects evidence. `--report` writes a report listing the commands this run executed and its result, and derives the outcome from them.\n359:- `update` — single-command complete update: automatically checks and updates the `pose` binary executable to the latest GitHub release, refreshes scaffolds, rules, workflows and MCP config (`--force`), and migrates the repository instance schema (`.pose/schema-version`). A plain update merges `POSE.md`/`AGENTS.md` (instance-owned sections keep their content; an instance edit a merge cannot keep is saved to `<file>.pose-backup`, and a section that still matches what POSE last wrote is simply replaced), delivers machinery — backing up only files the instance edited since POSE delivered them, as recorded by digest in `.pose/state/machinery-manifest.json` — and seeds absent instance config; `--force` additionally reruns `install` over the instance, which resets the manuals wholesale. Use `--dry-run` to preview or `--no-self` to skip the binary self-update. A run that delivered its files but finds the instance's own state invalid reports that through the final gate and does not roll back. Downgrade is always refused.\n367:- `lint-spec` — verifies each `spec.md` section has real content, not placeholders. **`--ready-check`** applies the **Definition of Ready** (ENTRY gate): Intent/Requirements/Technical Plan filled, acceptance criteria with stable IDs (`- R<N>:`) and syntactically valid `depends_on` — without requiring Validation/Final Report. The Definition of Ready is opt-in: it applies to specs created on or after `adopted_at` in `.pose/policy/dor.json` (shipped empty), and `task_type` in the spec's frontmatter selects which sections it requires; once adopted, `check` applies it on the `→ in-progress` transition. Use `--all` to audit every spec; `--required-only` skips the optional `Decisions` section. **Lifecycle gate:** `status: done` requires `completed_at` and a valid disposition on every follow-up; for `spawned`/`covered`/`duplicate` the target must be an **existing** spec (and not itself). A target in another project is written qualified, `[covered: xref:<project>/spec:<slug>]`: when that project is bound (`POSE_PROJECT_ROOTS`) the spec must exist there, and when it is not bound the target is accepted, because the other repository being absent is not evidence the spec is missing. In any status it warns when an open follow-up's ownership is written outside the trailing `(owner:@alias crit:low|medium|high review:YYYY-MM-DD)` group, and it reads a wrapped follow-up bullet as one item, like `followups`.\n.pose/knowledge/archive/2026-09-24-handoff-multirepo-review-continuation.md:31:is deferred: the old gitlink binary ignores `new-spec --task xref:...` and\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:43:algum) ganhou cobertura completa contra instância populada (locale pt-BR,\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:66:byte-a-byte, avisos, readiness, rollback via git puro). `examples/`\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:68:`2026-07-19-brownfield-kits-checked-in-fixtures-git-native-rollback.md`.\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:72:locale (templates default en `knowledge.md`/`doc-audit-report.md` estavam\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:74:a convenção de path do overlay de locale (`install.go`: templates agora\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:75:seguem o mesmo padrão `locales/<locale>/.pose/templates/...` de\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:260:- `pose skills-check` ainda não cobre os espelhos `locales/*/.agents/skills`\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:290:  `.pose/adr/2026-07-19-brownfield-kits-checked-in-fixtures-git-native-rollback.md`,\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:13:  external_sources: [{url: \"https://github.com/oseiaspereira88/pose/issues/17\", accessed_at: \"2026-08-15\"}]\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:105:  conservative by design: a project with a genuinely-legitimate root that\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:124:- Issue: https://github.com/oseiaspereira88/pose/issues/17\n.pose/knowledge/archive/2026-08-13-handoff-pr15-component-aware-review-provenance.md:13:  external_sources: [{url: \"https://github.com/oseiaspereira88/pose/pull/15\", accessed_at: \"2026-08-13\"}]\n.pose/knowledge/archive/2026-08-13-handoff-pr15-component-aware-review-provenance.md:42:  zero findings. `govulncheck` and the repository's gitleaks command also pass.\n.pose/knowledge/archive/2026-08-13-handoff-pr15-component-aware-review-provenance.md:77:- https://github.com/oseiaspereira88/pose/pull/15 (accessed 2026-08-13)\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:3:slug: github-issue-closing-keyword-format\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:10:  spec: \"pose-instance-engine-version-tracking, pose-install-locale-autodetect\"\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:14:    - {url: \"https://github.com/oseiaspereira88/pose/issues/18\", accessed_at: \"2026-08-15\"}\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:15:    - {url: \"https://github.com/oseiaspereira88/pose/issues/20\", accessed_at: \"2026-08-15\"}\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:18:# decision-log: github-issue-closing-keyword-format\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:23:github.com/oseiaspereira88/pose#20.` and `Fixes\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:24:github.com/oseiaspereira88/pose#18.` in their trailers, expecting GitHub to\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:27:prefix (`github.com/owner/repo#N`) is not a recognized form, closing keyword\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:33:and `.pose/workflows/*.md` for `Closes`/`Fixes`/`github.com/.*#` returns\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:34:nothing, and `git log --all` over this repository's entire commit history\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:88:- `Closes github.com/oseiaspereira88/pose#20` — **not** recognized; GitHub's\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:100:- `.pose/specs/pose-install-locale-autodetect/spec.md`,\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:102:- https://docs.github.com/en/issues/tracking-your-work-with-issues/using-issues/linking-a-pull-request-to-an-issue#linking-a-pull-request-to-an-issue-using-a-keyword\n.pose/knowledge/2026-10-20-handoff-pose-b07-implementation.md:10:  spec: \"spec:pose-git-and-dispatch-snapshot-integrity\"\n.pose/knowledge/2026-10-20-handoff-pose-b07-implementation.md:20:B07 retomada e reconciliada com a história completa do PR #195. Implementação explicitamente autorizada pelo mantenedor; branch canônica de trabalho `impl/pose-b07-git-snapshot-integrity`.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"The spec has one requirement: governance Git commands must force the C locale. The changed runner does that locally to each command. I’m checking the separate streaming Git path and stderr classifiers to see whether any governance reads bypass it.\n\n"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '180,310p' pose-mcp/internal/pose/governance_read_view_stream.go; sed -n '560,610p' pose-mcp/internal/pose/git_snapshot_integrity.go; sed -n '330,420p' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '610,710p' pose-mcp/internal/pose/governance_read_view_git.go; cat pose-mcp/internal/pose/review_scope_index_inputs_test.go; sed -n '365,430p' pose-mcp/internal/pose/module_discovery.go; sed -n '660,710p' pose-mcp/internal/pose/release_lifecycle.go; rg -n 'gitOutputUntranslated|LC_ALL|LANGUAGE' pose-mcp/internal/pose/git*.go; rg -n 'runGovernanceGit|streamGovernance|governanceGit' pose-mcp/internal/pose/governance_read_view_stream.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '180,310p' pose-mcp/internal/pose/governance_read_view_stream.go; sed -n '560,610p' pose-mcp/internal/pose/git_snapshot_integrity.go; sed -n '330,420p' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '610,710p' pose-mcp/internal/pose/governance_read_view_git.go; cat pose-mcp/internal/pose/review_scope_index_inputs_test.go; sed -n '365,430p' pose-mcp/internal/pose/module_discovery.go; sed -n '660,710p' pose-mcp/internal/pose/release_lifecycle.go; rg -n 'gitOutputUntranslated|LC_ALL|LANGUAGE' pose-mcp/internal/pose/git*.go; rg -n 'runGovernanceGit|streamGovernance|governanceGit' pose-mcp/internal/pose/governance_read_view_stream.go\"","aggregated_output":"\t// read is proven unchanged without it (review round 1, F1 and F3).\n\tfor _, item := range streams {\n\t\tauditContext := item.ctx\n\t\tcancel := func() {}\n\t\tif item.hasDeadline {\n\t\t\tauditContext, cancel = context.WithDeadline(auditContext, item.deadline)\n\t\t}\n\t\tdigest, length, _, err := governanceAuditGitStream(auditContext, item.files, item.root, item.args, item.maxBytes, admit, io.Discard)\n\t\tcancel()\n\t\tif errors.Is(err, errGovernanceReadViewBudget) {\n\t\t\tfor producer := range item.producers {\n\t\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], \"Git streamed final audit exceeded its byte budget\")\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif digest != item.digest || length != item.length || streamErrorDigest(err) != item.errText {\n\t\t\tfor producer := range item.producers {\n\t\t\t\tresult.ChangedProducers[producer] = true\n\t\t\t}\n\t\t\trootDigest := digestBytes([]byte(filepath.Clean(item.root)))\n\t\t\targsDigest := digestBytes([]byte(strings.Join(item.args, \"\\x00\")))\n\t\t\tresult.ChangedPaths = append(result.ChangedPaths, \"git:\"+strings.TrimPrefix(rootDigest, \"sha256:\")+\":\"+strings.TrimPrefix(argsDigest, \"sha256:\"))\n\t\t}\n\t}\n}\n\n// governanceStreamRun and governanceAuditGitStream run streamed reads during\n// the operation and in its final audit.\nvar (\n\tgovernanceStreamRun      = runGovernanceGitStreamContext\n\tgovernanceAuditGitStream = runGovernanceGitStreamContext\n)\n\n// runGovernanceGitStreamContext runs Git like the captured reads do and\n// writes its stdout to sink as it arrives, admitting each chunk before it is\n// written and hashing it; stderr is kept bounded. It returns the stdout's\n// digest and length. A non-empty stderr is an error, as for captured reads.\nfunc runGovernanceGitStreamContext(ctx context.Context, files Files, root string, args []string, limit int64, admit func(int64) bool, sink io.Writer) (string, int64, []byte, error) {\n\tif limit <= 0 {\n\t\treturn \"\", 0, nil, errGovernanceReadViewBudget\n\t}\n\t_ = FilesOrNative(files)\n\tif ctx == nil {\n\t\tctx = context.Background()\n\t}\n\tif sink == nil {\n\t\tsink = io.Discard\n\t}\n\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n\tcmd.WaitDelay = 2 * time.Second\n\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n\tout := &governanceStreamWriter{limit: limit, admit: admit, sink: sink, hash: sha256.New()}\n\tvar stderr bytes.Buffer\n\tcmd.Stdout = out\n\tcmd.Stderr = &limitedStderr{buf: &stderr, limit: governanceStreamStderrLimit}\n\terr := cmd.Run()\n\tif out.exceeded {\n\t\treturn \"\", 0, nil, errGovernanceReadViewBudget\n\t}\n\tdigest := \"sha256:\" + hex.EncodeToString(out.hash.Sum(nil))\n\tif err != nil {\n\t\tif exit, ok := err.(*exec.ExitError); ok {\n\t\t\texit.Stderr = append([]byte(nil), stderr.Bytes()...)\n\t\t}\n\t\treturn digest, out.written, stderr.Bytes(), &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n\t}\n\tif stderr.Len() > 0 {\n\t\tdetail := strings.TrimSpace(stderr.String())\n\t\tif detail == \"\" {\n\t\t\tdetail = \"Git wrote unclassified stderr output\"\n\t\t}\n\t\treturn digest, out.written, stderr.Bytes(), &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: errors.New(detail)}\n\t}\n\treturn digest, out.written, nil, nil\n}\n\ntype governanceStreamWriter struct {\n\tmu       sync.Mutex\n\tlimit    int64\n\twritten  int64\n\tadmit    func(int64) bool\n\tsink     io.Writer\n\thash     hash.Hash\n\texceeded bool\n}\n\nfunc (w *governanceStreamWriter) Write(data []byte) (int, error) {\n\tw.mu.Lock()\n\tdefer w.mu.Unlock()\n\tif w.exceeded || int64(len(data)) > w.limit-w.written || w.admit != nil && !w.admit(int64(len(data))) {\n\t\tw.exceeded = true\n\t\treturn 0, errGovernanceReadViewBudget\n\t}\n\tif _, err := w.sink.Write(data); err != nil {\n\t\treturn 0, err\n\t}\n\tw.hash.Write(data)\n\tw.written += int64(len(data))\n\treturn len(data), nil\n}\n\ntype limitedStderr struct {\n\tbuf   *bytes.Buffer\n\tlimit int\n}\n\nfunc (w *limitedStderr) Write(data []byte) (int, error) {\n\tif room := w.limit - w.buf.Len(); room > 0 {\n\t\tif len(data) > room {\n\t\t\tw.buf.Write(data[:room])\n\t\t} else {\n\t\t\tw.buf.Write(data)\n\t\t}\n\t}\n\treturn len(data), nil\n}\n\n// streamErrorDigest is the fixed-size identity of a streamed read's error.\nfunc streamErrorDigest(err error) string {\n\tif err == nil {\n\t\treturn \"\"\n\t}\n\treturn digestBytes([]byte(errorText(err)))\n}\n\t}\n\tsort.Strings(result)\n\treturn result, nil\n}\n\nfunc gitCommand(args ...string) *exec.Cmd {\n\treturn gitCommandContext(context.Background(), args...)\n}\n\n// gitCommandContext is gitCommand under ctx. Both read raw object history: a\n// replace ref or a graft changes what a commit is, and every gate has to judge\n// the same commit (spec pose-history-readers-read-raw R1, D1).\nfunc gitCommandContext(ctx context.Context, args ...string) *exec.Cmd {\n\t// The graft file below is the null device, and Git hints at any graft file on\n\t// stderr, which a caller that reads stderr as uncertainty would take for a failure.\n\tcmd := exec.CommandContext(ctx, \"git\", append([]string{\"-c\", \"advice.graftFileDeprecated=false\"}, args...)...)\n\tenv := make([]string, 0, len(os.Environ())+2)\n\tfor _, kv := range os.Environ() {\n\t\tname, _, _ := strings.Cut(kv, \"=\")\n\t\tif !gitRedirectingEnv[name] {\n\t\t\tenv = append(env, kv)\n\t\t}\n\t}\n\tcmd.Env = append(env, \"GIT_NO_REPLACE_OBJECTS=1\", \"GIT_GRAFT_FILE=\"+os.DevNull)\n\treturn cmd\n}\n\nconst (\n\tgitEmptyTreeSHA1   = \"4b825dc642cb6eb9a060e54bf8d69288fbee4904\"\n\tgitEmptyTreeSHA256 = \"6ef19b41225c5369f1c104d45d8d85efa9b057b53b14b4b9b939dd74decc5321\"\n)\n\n// GitEmptyTree is the empty tree in commit's object format: the base of a change\n// set that starts at a repository's first commit (spec\n// pose-history-readers-read-raw R2, D2).\nfunc GitEmptyTree(commit string) string {\n\tif len(commit) == len(gitEmptyTreeSHA256) {\n\t\treturn gitEmptyTreeSHA256\n\t}\n\treturn gitEmptyTreeSHA1\n}\n\n// IsGitEmptyTree says that revision is the base of such a change set.\nfunc IsGitEmptyTree(revision string) bool {\n\treturn revision == gitEmptyTreeSHA1 || revision == gitEmptyTreeSHA256\n}\n\n// ChangeSetRange is the revision range of a change set for rev-list and log.\nfunc ChangeSetRange(base, head string) string {\n\tif IsGitEmptyTree(base) {\n\t\treturn head\nfunc (state *governanceReadViewGitState) capture(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif state == nil || state.op == nil {\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif ctx == nil {\n\t\tctx = context.Background()\n\t}\n\tdeadline, hasDeadline := ctx.Deadline()\n\tauditContext := context.WithoutCancel(ctx)\n\tkey := governanceGitObservationKey(root, args, maxOutputBytes)\n\tstate.mu.Lock()\n\tif prior := state.observations[key]; prior != nil {\n\t\tprior.producers[producer] = true\n\t\tstdout, err := append([]byte(nil), prior.stdout...), prior.err\n\t\tstate.mu.Unlock()\n\t\treturn stdout, err\n\t}\n\tmetadataCost := int64(len(root) + len(key) + len(producer) + 128)\n\tif !state.op.reserveRecord(metadataCost) {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its shared record or metadata budget while capturing Git\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tlimit := maxOutputBytes\n\tif state.op.remainingInput() < limit {\n\t\tlimit = state.op.remainingInput()\n\t}\n\tif limit <= 0 {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its Git input byte budget\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tbyObject, byHead := governancePureGitRead(args)\n\theadBefore := \"\"\n\tif byHead {\n\t\theadBefore = governanceHeadAt(ctx, files, root)\n\t}\n\t// A process that turned the resident memo on answers a pure read from it; the bytes are\n\t// admitted against the operation's budget as a fresh read's are.\n\tvar stdout, stderr []byte\n\tvar runErr error\n\tmemoKey, memoized := \"\", false\n\tmemo := residentGit.Load()\n\tif memo != nil && (byObject || byHead && headBefore != \"\") {\n\t\tif key, ok := residentGitKey(root, headBefore, state.effectiveGitConfig(ctx, files, root), args); ok {\n\t\t\tmemoKey = key\n\t\t\tif hit, found := memo.get(key); found {\n\t\t\t\tif int64(len(hit)) > limit || !state.op.reserveInput(int64(len(hit))) {\n\t\t\t\t\tstate.mu.Unlock()\n\t\t\t\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n\t\t\t\t\treturn nil, errGovernanceReadViewBudget\n\t\t\t\t}\n\t\t\t\tstdout, memoized = hit, true\n\t\t\t}\n\t\t}\n\t}\n\tif !memoized {\n\t\tstdout, stderr, runErr = runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, state.op.reserveInput)\n\t}\n\tif errors.Is(runErr, errGovernanceReadViewBudget) {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tobservation := &governanceReadViewGitObservation{\n\t\troot: root, args: append([]string(nil), args...), files: files, ctx: auditContext, deadline: deadline, hasDeadline: hasDeadline, maxOutputBytes: maxOutputBytes,\n\t\tstdout: append([]byte(nil), stdout...), stderr: append([]byte(nil), stderr...), err: runErr, errText: errorText(runErr),\n\t\tproducers: map[string]bool{producer: true},\n\t}\n\tif runErr == nil && len(stderr) == 0 {\n\t\tswitch {\n\t\tcase byObject:\n\t\t\tobservation.pure = true\n\t\tcase memoized && byHead:\n\t\t\t// The commit is the one the memo's key names; nothing ran, so there is no second read.\n\t\t\tobservation.pure, observation.headAt = true, headBefore\n\t\tcase byHead && headBefore != \"\" && governanceHeadAt(ctx, files, root) == headBefore:\n\t\t\tobservation.pure, observation.headAt = true, headBefore\n\t\t}\n\t\tif memoKey != \"\" && !memoized && observation.pure {\n\t\t\tmemo.put(memoKey, stdout)\n\t\t}\n\t}\n\tstate.observations[key] = observation\n\tstate.mu.Unlock()\n\tif isGovernanceGitHeadCommand(args) {\n\t\tif runErr != nil {\n\t\t\tif !state.op.mayOmitPrimaryRevision(root) {\n\t\t\t\tstate.markUnknownForRoot(root, producer, \"source revision could not be read from Git\")\n\t\t\t}\n\t\t} else {\nfunc runGovernanceGitCommandContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, error) {\n\tstdout, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, args, limit)\n\treturn stdout, err\n}\n\nfunc runGovernanceGitCommandOutput(files Files, root string, args []string, limit int64) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmitted(files, root, args, limit, nil)\n}\n\nfunc runGovernanceGitCommandOutputContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, nil)\n}\n\n// runGovernanceGitCommandOutputAdmitted admits each stream chunk before the\n// bounded output buffer retains it. The operation callback is shared with\n// Files reads, so concurrent producers cannot spend the same remaining bytes.\nfunc runGovernanceGitCommandOutputAdmitted(files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmittedContext(context.Background(), files, root, args, limit, admit)\n}\n\n// runGovernanceGitCommandOutputAdmittedContext admits each stream chunk before\n// the bounded output buffer retains it and executes Git under ctx.\nfunc runGovernanceGitCommandOutputAdmittedContext(ctx context.Context, files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n\tif limit < 0 {\n\t\treturn nil, nil, errGovernanceReadViewBudget\n\t}\n\tfiles = FilesOrNative(files)\n\tif ctx == nil {\n\t\tctx = context.Background()\n\t}\n\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n\tcmd.WaitDelay = 2 * time.Second\n\t// Governance classifies Git's failures by what Git writes to stderr, so\n\t// Git writes it untranslated: a translated \"not a git repository\" left a\n\t// directory outside any repository unknown under pt_BR (spec\n\t// pose-governance-git-reads-untranslated).\n\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\", \"LC_ALL=C\", \"LANGUAGE=C\")\n\toutput := &boundedGovernanceGitOutput{limit: limit, admit: admit}\n\tcmd.Stdout = governanceGitStream{output: output, stderr: false}\n\tcmd.Stderr = governanceGitStream{output: output, stderr: true}\n\terr := cmd.Run()\n\tstdout, stderr, exceeded := output.values()\n\tif exceeded {\n\t\treturn nil, nil, errGovernanceReadViewBudget\n\t}\n\tif err != nil {\n\t\tif exit, ok := err.(*exec.ExitError); ok {\n\t\t\texit.Stderr = append([]byte(nil), stderr...)\n\t\t}\n\t\treturn stdout, stderr, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n\t}\n\tif len(stderr) > 0 {\n\t\tdetail := strings.TrimSpace(string(stderr))\n\t\tif detail == \"\" {\n\t\t\tdetail = \"Git wrote unclassified stderr output\"\n\t\t}\n\t\treturn stdout, stderr, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: errors.New(detail)}\n\t}\n\treturn stdout, stderr, nil\n}\n\ntype boundedGovernanceGitOutput struct {\n\tmu       sync.Mutex\n\tlimit    int64\n\tused     int64\n\tadmit    func(int64) bool\n\tstdout   bytes.Buffer\n\tstderr   bytes.Buffer\n\texceeded bool\n}\n\ntype governanceGitStream struct {\n\toutput *boundedGovernanceGitOutput\n\tstderr bool\n}\n\nfunc (stream governanceGitStream) Write(data []byte) (int, error) {\n\toutput := stream.output\n\toutput.mu.Lock()\n\tdefer output.mu.Unlock()\n\tif output.exceeded || int64(len(data)) > output.limit-output.used {\n\t\toutput.exceeded = true\n\t\treturn 0, errGovernanceReadViewBudget\n\t}\n\tif output.admit != nil && !output.admit(int64(len(data))) {\n\t\toutput.exceeded = true\n\t\treturn 0, errGovernanceReadViewBudget\n\t}\n\tvar err error\n\tif stream.stderr {\n\t\t_, err = output.stderr.Write(data)\n\t} else {\n\t\t_, err = output.stdout.Write(data)\n\t}\n\tif err == nil {\n\t\toutput.used += int64(len(data))\n\t}\n\treturn len(data), err\n}\n\nfunc (output *boundedGovernanceGitOutput) values() ([]byte, []byte, bool) {\npackage pose\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sync\"\n\t\"testing\"\n)\n\nfunc currentPinFixture() *IndexGenerationView {\n\tinputs := map[string]string{}\n\tfor _, name := range IndexInputNames {\n\t\tinputs[name] = \"sha256:bound\"\n\t}\n\treturn &IndexGenerationView{Status: IndexGenerationCurrent, Descriptor: IndexGenerationDescriptor{GenerationID: \"gen-fixture\", Inputs: inputs}}\n}\n\n// ADR governance-reads-use-bounded-operation-scoped-views D12: under one\n// coordinator, the consumed index's inputs are checked once, through the\n// coordinator's operation, however many scopes consume the index.\nfunc TestScopeIndexInputsAreCheckedOncePerCoordinator(t *testing.T) {\n\troot, _ := d7ProbeCoordinatorRoot(t)\n\tvar mu sync.Mutex\n\tcomputed := map[string]int{}\n\toriginal := governanceIndexInputBindingObserved\n\tgovernanceIndexInputBindingObserved = func(_, name string) {\n\t\tmu.Lock()\n\t\tcomputed[name]++\n\t\tmu.Unlock()\n\t}\n\tdefer func() { governanceIndexInputBindingObserved = original }()\n\tpin := currentPinFixture()\n\terr := (Store{Root: root}).WithReviewCoordinator(func(shared Store) error {\n\t\tcoordinatorView, _ := governanceReadViewFromFiles(shared.fsys())\n\t\tvar wg sync.WaitGroup\n\t\terrs := make(chan error, 3)\n\t\tfor i := 0; i < 3; i++ {\n\t\t\twg.Add(1)\n\t\t\tgo func() {\n\t\t\t\tdefer wg.Done()\n\t\t\t\terrs <- shared.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\t\t\tview, _ := governanceReadViewFromFiles(scope.fsys())\n\t\t\t\t\tif view.operation.indexInputsFrom != coordinatorView.operation {\n\t\t\t\t\t\treturn errors.New(\"the scope does not check its index inputs through the coordinator\")\n\t\t\t\t\t}\n\t\t\t\t\tview.operation.checkIndexInputs(scope.fsys(), scope.Root, \"review-operation\", pin)\n\t\t\t\t\treturn nil\n\t\t\t\t})\n\t\t\t}()\n\t\t}\n\t\twg.Wait()\n\t\tclose(errs)\n\t\tvar combined error\n\t\tfor err := range errs {\n\t\t\tcombined = errors.Join(combined, err)\n\t\t}\n\t\treturn combined\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, name := range IndexInputNames {\n\t\tif computed[name] != 1 {\n\t\t\tt.Fatalf(\"input %s was computed %d times for three scopes of one coordinator\", name, computed[name])\n\t\t}\n\t}\n}\n\n// D12: the reads of the shared check belong to the coordinator's closure, so\n// an input changed while the scopes run fails the coordinator's audit.\nfunc TestAScopeIndexInputChangedDuringTheCoordinatorFailsItsAudit(t *testing.T) {\n\troot, _ := d7ProbeCoordinatorRoot(t)\n\tpolicy := filepath.Join(root, \".pose\", \"policy\", \"review.json\")\n\tif err := os.MkdirAll(filepath.Dir(policy), 0o700); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(policy, []byte(`{\"schema_version\":1}`), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpin := currentPinFixture()\n\terr := (Store{Root: root}).WithReviewCoordinator(func(shared Store) error {\n\t\tif err := shared.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\tview, _ := governanceReadViewFromFiles(scope.fsys())\n\t\t\tview.operation.checkIndexInputs(scope.fsys(), scope.Root, \"review-operation\", pin)\n\t\t\treturn nil\n\t\t}); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn os.WriteFile(policy, []byte(`{\"schema_version\":2}`), 0o600)\n\t})\n\tif !errors.Is(err, ErrGovernanceReadViewChanged) {\n\t\tt.Fatalf(\"an index input changed under the coordinator passed its audit: %v\", err)\n\t}\n}\n\tboundary, err := filepath.Abs(view.root)\n\tif err != nil {\n\t\tview.markUnknown(producer, \"project read-view root could not be resolved for Git metadata\")\n\t\treturn true\n\t}\n\tdir, boundary = filepath.Clean(dir), filepath.Clean(boundary)\n\tif !pathWithin(boundary, dir) {\n\t\tview.markUnknown(producer, \"Git metadata lookup is outside the project read-view root\")\n\t\treturn true\n\t}\n\tfor {\n\t\tfound, metadataErr := gitMetadataAtBoundedIn(files, dir)\n\t\tif metadataErr != nil {\n\t\t\tview.markUnknown(producer, \"Git metadata could not be read within the project read-view root\")\n\t\t\treturn true\n\t\t}\n\t\tif found {\n\t\t\treturn true\n\t\t}\n\t\tif dir == boundary {\n\t\t\tbreak\n\t\t}\n\t\tparent := filepath.Dir(dir)\n\t\tif parent == dir || !pathWithin(boundary, parent) {\n\t\t\tbreak\n\t\t}\n\t\tdir = parent\n\t}\n\n\t// No repository marker was found in the authorized project root. A\n\t// captured Git query distinguishes a repository rooted within the view\n\t// from a valid enclosing repository outside the view; the latter is\n\t// unknown because its worktree is outside the operation's authorized\n\t// input boundary.\n\ttop, gitErr := CaptureGovernanceGitIn(files, root, producer, 1024, \"rev-parse\", \"--show-toplevel\")\n\tif gitErr != nil {\n\t\tvar exit *exec.ExitError\n\t\tif errors.As(gitErr, &exit) && strings.Contains(strings.ToLower(string(exit.Stderr)), \"not a git repository\") {\n\t\t\treturn false\n\t\t}\n\t\tview.markUnknown(producer, \"Git context could not be proved at the project root\")\n\t\treturn true\n\t}\n\ttopPath := filepath.Clean(strings.TrimSpace(string(top)))\n\tif !pathWithin(boundary, topPath) {\n\t\tview.markUnknown(producer, \"Git repository root is outside the project read-view root\")\n\t}\n\treturn true\n}\n\nfunc gitMetadataAtBoundedIn(files Files, dir string) (bool, error) {\n\tgitPath := filepath.Join(dir, \".git\")\n\tif _, err := files.Lstat(gitPath); err == nil {\n\t\t// A directory or gitfile is enough to prove that this path intended to\n\t\t// carry Git metadata. Git commands will report corruption instead of\n\t\t// letting the index treat it as a non-Git checkout.\n\t\treturn true, nil\n\t} else if !errors.Is(err, os.ErrNotExist) {\n\t\treturn false, err\n\t}\n\n\thead, headErr := files.Lstat(filepath.Join(dir, \"HEAD\"))\n\tobjects, objectsErr := files.Stat(filepath.Join(dir, \"objects\"))\n\trefs, refsErr := files.Stat(filepath.Join(dir, \"refs\"))\n\tfor _, err := range []error{headErr, objectsErr, refsErr} {\n\t\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n\t}\n\tfor _, f := range fragments {\n\t\tspecs = append(specs, f.Spec)\n\t\tcategories[f.Category]++\n\t\tbreaking = breaking || f.Breaking\n\t}\n\tnotes := RenderReleaseNotes(version, fragments, changelog)\n\tinput := struct {\n\t\tVersion   string            `json:\"version\"`\n\t\tPrevious  string            `json:\"previous\"`\n\t\tFragments []ReleaseFragment `json:\"fragments\"`\n\t\tPolicy    string            `json:\"policy\"`\n\t\tEvidence  map[string]string `json:\"evidence\"`\n\t}{version, previous, fragments, ReleaseDigest(policy), versionEvidence}\n\treturn ReleaseManifest{SchemaVersion: 1, Version: version, PreviousVersion: previous, PreparedAt: preparedAt, Specs: specs, Categories: categories, Fragments: fragments, Breaking: breaking, NotesDigest: ReleaseDigest(notes), ReleaseInputDigest: ReleaseDigest(input), PolicyDigest: ReleaseDigest(policy), VersionEvidence: versionEvidence}\n}\n\nfunc CanonicalJSON(value any) []byte {\n\traw, _ := json.MarshalIndent(value, \"\", \"  \")\n\treturn append(raw, '\\n')\n}\n\nfunc NewReleaseEvent(version, state string, evidence ReleaseEvidence, now time.Time) ReleaseEvent {\n\treturn ReleaseEvent{SchemaVersion: 1, Version: version, State: state, RecordedAt: now.UTC().Format(time.RFC3339), Evidence: evidence, EvidenceDigest: ReleaseDigest(evidence)}\n}\n\n// GitNotARepository reports that root is not inside a Git repository at all, which is the only\n// reason a failing git command says nothing about the releases there are. A `.git` that is there,\n// whose gitdir was lost, is a repository that could not be read: Git words both the same way.\nfunc GitNotARepository(root string) bool {\n\t_, err := gitOutputUntranslated(root, \"rev-parse\", \"--git-dir\")\n\tvar failure *gitCommandError\n\tif !errors.As(err, &failure) || !strings.Contains(failure.Stderr, \"not a git repository\") {\n\t\treturn false\n\t}\n\treturn !hasGitMetadata(root)\n}\n\nfunc gitNotARepository(root string) bool { return GitNotARepository(root) }\n\n// TaggedReleaseWorktreeGaps binds the working tree's copy of a tagged release to the cut the tag\n// holds: the manifest, the notes and every archived fragment are byte for byte what the tag's\n// snapshot froze, and nothing is archived that the manifest does not freeze. The tag's commit\n// itself is not compared with HEAD.\nfunc TaggedReleaseWorktreeGaps(root, target string, manifest *ReleaseManifest, snap ReleaseSnapshot) []string {\n\treturn TaggedReleaseWorktreeGapsIn(NativeFiles(), root, target, manifest, snap)\n}\n\nfunc TaggedReleaseWorktreeGapsIn(files Files, root, target string, manifest *Release