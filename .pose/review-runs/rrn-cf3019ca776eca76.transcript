{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J9nodX9ELx7qwjYxHctEpz","type":"tool_result","content":"85\ttype ReviewDraftPrior struct {\n86\t\tID       string `json:\"id\"`\n87\t\tStatus   string `json:\"status\"`\n88\t\tEvidence string `json:\"evidence\"`\n89\t}\n90\t\n91\t// ReviewDraft is the pose-draft block of a reviewer's final message.\n92\ttype ReviewDraft struct {\n93\t\tSchema        string               `json:\"schema\"`\n94\t\tDecision      string               `json:\"decision\"`\n95\t\tFindings      []ReviewDraftFinding `json:\"findings\"`\n96\t\tPriorFindings []ReviewDraftPrior   `json:\"prior_findings,omitempty\"`\n97\t\tSweep         string               `json:\"sweep,omitempty\"`\n98\t\t// Criteria and Tools are the typed conclusion the engine records as an\n99\t\t// attestation (spec pose-delegated-review-conclusions R1).\n100\t\tCriteria []ReviewDraftCriterion `json:\"criteria,omitempty\"`\n101\t\tTools    []ReviewDraftTool      `json:\"tools,omitempty\"`\n102\t\t// Questions and Surfaces are the typed verdict of an adjudication and of\n103\t\t// a smoke run, recorded where their origin reads them (spec\n104\t\t// pose-delegated-verdict-destinations R1, R2).\n105\t\tQuestions []ReviewDraftQuestion `json:\"questions,omitempty\"`\n106\t\tSurfaces  []ReviewDraftSurface  `json:\"surfaces,omitempty\"`\n107\t\t// BusinessDecision is a question the reviewer cannot answer from the\n108\t\t// code, for a person to decide (spec\n109\t\t// pose-delegated-review-action-fulfillment R7).\n110\t\tBusinessDecision *ReviewDraftBusinessDecision `json:\"business_decision,omitempty\"`\n111\t}\n112\t\n113\t// ReviewDraftBusinessDecision is a business question and its options.\n114\ttype ReviewDraftBusinessDecision struct {\n115\t\tQuestion string         `json:\"question\"`\n116\t\tOptions  []ActionOption `json:\"options\"`\n117\t}\n118\t\n119\t// ReviewDraftQuestion is an adjudication's verdict on one question the\n120\t// scope records: a decision (D<n>) or a requirement (R<n>).\n121\ttype ReviewDraftQuestion struct {\n122\t\tID        string `json:\"id\"`\n123\t\tVerdict   string `json:\"verdict\"`\n124\t\tEvidence  string `json:\"evidence,omitempty\"`\n125\t\tRationale string `json:\"rationale\"`\n126\t}\n127\t\n128\t// ReviewDraftSurface is what a smoke run observed on one delivery target.\n129\ttype ReviewDraftSurface struct {\n130\t\tRef      string   `json:\"ref\"`\n131\t\tOutcome  string   `json:\"outcome\"`\n132\t\tCommands []string `json:\"commands\"`\n133\t\tObserved string   `json:\"observed\"`\n134\t}\n135\t\n136\t// Adjudication verdicts and smoke outcomes.\n137\tconst (\n138\t\tAdjudicationHolds           = \"holds\"\n139\t\tAdjudicationDoesNotHold     = \"does-not-hold\"\n140\t\tAdjudicationCannotDetermine = \"cannot-determine\"\n141\t\tSmokeObserved               = \"observed\"\n142\t\tSmokeNotObserved            = \"not-observed\"\n143\t\tSmokeNotReachable           = \"not-reachable\"\n144\t)\n145\t\n146\tvar adjudicationQuestionID = regexp.MustCompile(`^[DR][0-9]{1,4}$`)\n147\t\n148\t// Prior finding statuses (R3).\n149\tconst (\n150\t\tPriorFindingFixed      = \"fixed\"\n151\t\tPriorFindingPartial    = \"partial\"\n152\t\tPriorFindingNotFixed   = \"not-fixed\"\n153\t\tPriorFindingSuperseded = \"superseded\"\n154\t)\n155\t\n156\t// ParseReviewDraft reads the pose-draft block of output: nil when there is\n157\t// none, an error when the block is not one valid draft. Fences are whole\n158\t// lines, LF or CRLF: an opening line is exactly \"```pose-draft\", the block\n159\t// closes at the first line that is exactly \"```\", and any other line that\n160\t// starts a fence before it, or a second block, is an error, never a block\n161\t// read as absent (review round 2, R2-B2). Every decision line outside the\n162\t// block must agree with it (R2-B1).\n163\tfunc ParseReviewDraft(output string) (*ReviewDraft, error) {\n164\t\tlines := strings.Split(output, \"\\n\")"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"69fc329d-7097-498a-ae96-d86fa7c183df","timestamp":"2026-11-10T16:16:24.570Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-1270461768/worktree/pose-mcp/internal/pose/review_rounds.go","content":"type ReviewDraftPrior struct {\n\tID       string `json:\"id\"`\n\tStatus   string `json:\"status\"`\n\tEvidence string `json:\"evidence\"`\n}\n\n// ReviewDraft is the pose-draft block of a reviewer's final message.\ntype ReviewDraft struct {\n\tSchema        string               `json:\"schema\"`\n\tDecision      string               `json:\"decision\"`\n\tFindings      []ReviewDraftFinding `json:\"findings\"`\n\tPriorFindings []ReviewDraftPrior   `json:\"prior_findings,omitempty\"`\n\tSweep         string               `json:\"sweep,omitempty\"`\n\t// Criteria and Tools are the typed conclusion the engine records as an\n\t// attestation (spec pose-delegated-review-conclusions R1).\n\tCriteria []ReviewDraftCriterion `json:\"criteria,omitempty\"`\n\tTools    []ReviewDraftTool      `json:\"tools,omitempty\"`\n\t// Questions and Surfaces are the typed verdict of an adjudication and of\n\t// a smoke run, recorded where their origin reads them (spec\n\t// pose-delegated-verdict-destinations R1, R2).\n\tQuestions []ReviewDraftQuestion `json:\"questions,omitempty\"`\n\tSurfaces  []ReviewDraftSurface  `json:\"surfaces,omitempty\"`\n\t// BusinessDecision is a question the reviewer cannot answer from the\n\t// code, for a person to decide (spec\n\t// pose-delegated-review-action-fulfillment R7).\n\tBusinessDecision *ReviewDraftBusinessDecision `json:\"business_decision,omitempty\"`\n}\n\n// ReviewDraftBusinessDecision is a business question and its options.\ntype ReviewDraftBusinessDecision struct {\n\tQuestion string         `json:\"question\"`\n\tOptions  []ActionOption `json:\"options\"`\n}\n\n// ReviewDraftQuestion is an adjudication's verdict on one question the\n// scope records: a decision (D<n>) or a requirement (R<n>).\ntype ReviewDraftQuestion struct {\n\tID        string `json:\"id\"`\n\tVerdict   string `json:\"verdict\"`\n\tEvidence  string `json:\"evidence,omitempty\"`\n\tRationale string `json:\"rationale\"`\n}\n\n// ReviewDraftSurface is what a smoke run observed on one delivery target.\ntype ReviewDraftSurface struct {\n\tRef      string   `json:\"ref\"`\n\tOutcome  string   `json:\"outcome\"`\n\tCommands []string `json:\"commands\"`\n\tObserved string   `json:\"observed\"`\n}\n\n// Adjudication verdicts and smoke outcomes.\nconst (\n\tAdjudicationHolds           = \"holds\"\n\tAdjudicationDoesNotHold     = \"does-not-hold\"\n\tAdjudicationCannotDetermine = \"cannot-determine\"\n\tSmokeObserved               = \"observed\"\n\tSmokeNotObserved            = \"not-observed\"\n\tSmokeNotReachable           = \"not-reachable\"\n)\n\nvar adjudicationQuestionID = regexp.MustCompile(`^[DR][0-9]{1,4}$`)\n\n// Prior finding statuses (R3).\nconst (\n\tPriorFindingFixed      = \"fixed\"\n\tPriorFindingPartial    = \"partial\"\n\tPriorFindingNotFixed   = \"not-fixed\"\n\tPriorFindingSuperseded = \"superseded\"\n)\n\n// ParseReviewDraft reads the pose-draft block of output: nil when there is\n// none, an error when the block is not one valid draft. Fences are whole\n// lines, LF or CRLF: an opening line is exactly \"```pose-draft\", the block\n// closes at the first line that is exactly \"```\", and any other line that\n// starts a fence before it, or a second block, is an error, never a block\n// read as absent (review round 2, R2-B2). Every decision line outside the\n// block must agree with it (R2-B1).\nfunc ParseReviewDraft(output string) (*ReviewDraft, error) {\n\tlines := strings.Split(output, \"\\n\")","numLines":80,"startLine":85,"totalLines":892}},"tool_result_meta":[{"id":"toolu_01J9nodX9ELx7qwjYxHctEpz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
