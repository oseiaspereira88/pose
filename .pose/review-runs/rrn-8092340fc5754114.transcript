p ...*reviewCleanupOwnership) error {\npose-mcp/internal/pose/review_adapter_containment.go:576:\tif err := removeReviewGoBuildLeftovers(root); err != nil {\npose-mcp/internal/pose/review_adapter_containment.go:596:// creates under the TMPDIR the engine gives a review run.\npose-mcp/internal/pose/review_adapter_containment.go:609:// removeReviewGoBuildLeftovers removes the Go build directories a reviewer's\npose-mcp/internal/pose/review_adapter_containment.go:617:func removeReviewGoBuildLeftovers(root *os.Root) error {\npose-mcp/internal/pose/review_adapter_containment.go:638:\t\t\tif err := removeReviewGoBuildDir(root, name); err != nil {\n   175\t\t\tif err != nil {\n   176\t\t\t\treturn base, err\n   177\t\t\t}\n   178\t\t\troadmaps = append(roadmaps, *full)\n   179\t\t}\n   180\t\treturn posemodel.BuildDeliverySurface(base, fullSpecs, targets, results, roadmaps, profiles, policy), nil\n   181\t}\n   182\t\n   183\t// extendCurrentDeliveryGraph reads and writes the filesystem directly; extendCurrentDeliveryGraphIn takes the\n   184\t// operation's files.\n   185\tfunc extendCurrentDeliveryGraph(root string, base posemodel.DeliveryIntegrityGraph) (posemodel.DeliveryIntegrityGraph, error) {\n   186\t\treturn extendCurrentDeliveryGraphIn(posemodel.NativeFiles(), root, base)\n   187\t}\n   188\t\n   189\tfunc cmdSurfaceCheck(root string, args []string, stdout, stderr io.Writer) int {\n   190\t\tvar spec, resultsPath string\n   191\t\tstrict, jsonOutput := true, false\n   192\t\tfor i := 0; i < len(args); i++ {\n   193\t\t\tswitch args[i] {\n   194\t\t\tcase \"--spec\", \"--results\":\n   195\t\t\t\tif i+1 >= len(args) {\n   196\t\t\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\n   197\t\t\t\t}\n   198\t\t\t\ti++\n   199\t\t\t\tif args[i-1] == \"--spec\" {\n   200\t\t\t\t\tspec = args[i]\n   201\t\t\t\t} else {\n   202\t\t\t\t\tresultsPath = args[i]\n   203\t\t\t\t}\n   204\t\t\tcase \"--strict\":\n   205\t\t\t\tstrict = true\n   206\t\t\tcase \"--tolerant\":\n   207\t\t\t\tstrict = false\n   208\t\t\tcase \"--json\":\n   209\t\t\t\tjsonOutput = true\n   210\t\t\tdefault:\n   211\t\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\n   212\t\t\t}\n   213\t\t}\n   214\t\tif spec != \"\" && posemodel.ValidateSlug(spec) != nil {\n   215\t\t\tfmt.Fprintln(stderr, \"pose surface-check: invalid spec slug\")\n   216\t\t\treturn 2\n   217\t\t}\n   218\t\tpolicy, err := posemodel.LoadDeliveryPolicy(root)\n   219\t\tif err != nil {\n   220\t\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n   221\t\t\treturn 1\n   222\t\t}\n   223\t\tif resultsPath != \"\" {\n   224\t\t\tif !confinedRelativePath(resultsPath) {\n   225\t\t\t\tfmt.Fprintln(stderr, \"pose surface-check: results path escapes project\")\n   226\t\t\t\treturn 2\n   227\t\t\t}\n   228\t\t\tpolicy.ResultsPath = filepath.ToSlash(filepath.Clean(resultsPath))\n   229\t\t}\n   230\t\tbaseSpecs, claims, sets, tracked, artifactPolicy, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root)\n   231\t\tif err != nil {\n   232\t\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n   233\t\t\treturn 1\n   234\t\t}\n   235\t\tbase := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), baseSpecs, claims, sets, tracked, artifactPolicy, posemodel.LoadArchivedFragments(root), artifactRemovals(root, claims, sets, tracked, gaps))\n   236\t\tprofiles, err := loadDeliveryProfiles(root)\n   237\t\tif err != nil {\n   238\t\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n   239\t\t\treturn 1\n   240\t\t}\n   241\t\tfullSpecs, targets, err := collectDeliveryTargets(root, baseSpecs, profiles)\n   242\t\tif err != nil {\n   243\t\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n   244\t\t\treturn 1\n   245\t\t}\n   246\t\tresults, err := loadDeliveryValidationResults(root, policy.ResultsPath)\n   247\t\tresults = withSmokeResults(root, results)\n   248\t\tif err != nil {\n   249\t\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n   250\t\t\treturn 1\n   251\t\t}\n   252\t\tgraph := posemodel.BuildDeliverySurface(base, fullSpecs, targets, results, nil, profiles, policy)\n   253\t\tif spec != \"\" {\n   254\t\t\tgraph = focusSurfaceGraph(graph, spec)\n   255\t\t}\n   256\t\tif jsonOutput {\n   257\t\t\t_ = writeJSON(stdout, graph)\n   258\t\t} else {\n   259\t\t\tfmt.Fprintf(stdout, \"surface.spec=%s\\nsurface.targets=%d\\nsurface.results=%d\\nsurface.findings=%d\\nsurface.provenance_digest=%s\\n\", spec, len(graph.Deliveries), len(graph.ValidationResults), len(graph.Findings), graph.ProvenanceDigest)\n   260\t\t\tfor _, finding := range graph.Findings {\n   261\t\t\t\trender(stdout, stderr).Finding(cliout.Finding{\n   262\t\t\t\t\tState: cliout.StateFromKey(finding.Severity), Code: finding.Code, Path: finding.Path,\n   263\t\t\t\t\tMessage: finding.Message, Remediation: finding.Remediation,\n   264\t\t\t\t})\n   265\t\t\t}\n   266\t\t}\n   267\t\treturn deliveryFindingExit(graph.Findings, strict)\n   268\t}\n   269\t\n   270\tfunc cmdRoadmapCheck(root string, args []string, stdout, stderr io.Writer) int {\n   271\t\tif len(args) == 0 {\n   272\t\t\treturn usageError(stderr, \"Usage: pose roadmap-check <slug> [--strict|--tolerant] [--json]\")\n   273\t\t}\n   274\t\tslug := args[0]\n   275\t\tstrict, jsonOutput := true, false\n   276\t\tfor _, arg := range args[1:] {\n   277\t\t\tswitch arg {\n   278\t\t\tcase \"--strict\":\n   279\t\t\t\tstrict = true\n   280\t\t\tcase \"--tolerant\":\n   281\t\t\t\tstrict = false\n   282\t\t\tcase \"--json\":\n   283\t\t\t\tjsonOutput = true\n   284\t\t\tdefault:\n   285\t\t\t\treturn usageError(stderr, \"Usage: pose roadmap-check <slug> [--strict|--tolerant] [--json]\")\n{\n  \"schema_version\": 1,\n  \"spec\": \"pose-review-cleanup-removes-go-build-leftovers\",\n  \"plan_digest\": \"a8c06f834d8de09182bc1b35ab955215063a85b3483c70dc7fbe4f44f1bbf350\",\n  \"revision\": \"9f3807058cda76811a58b6a57af2b04204e1e214\",\n  \"spec_digest_before\": \"446889bc496863da20f48422c5b27ecbf0c577a4df5cbd1320ea52c44cae7d58\",\n  \"spec_digest_after\": \"633aa36b042be8418c11b6ca0405dea3d16c08ad5d7265ccc994c9d4b3e21ec1\",\n  \"baseline\": {\n    \"schema_version\": 1,\n    \"namespace\": \"spec:pose-review-cleanup-removes-go-build-leftovers\",\n    \"nodes\": [\n      {\n        \"id\": \"R1\",\n        \"kind\": \"requirement\",\n        \"namespace\": \"spec:pose-review-cleanup-removes-go-build-leftovers\",\n        \"hash\": \"68090225ddc1\",\n        \"state\": \"active\"\n      },\n      {\n        \"id\": \"R2\",\n        \"kind\": \"requirement\",\n        \"namespace\": \"spec:pose-review-cleanup-removes-go-build-leftovers\",\n        \"hash\": \"e65118405048\",\n        \"state\": \"active\"\n      },\n      {\n        \"id\": \"R3\",\n        \"kind\": \"requirement\",\n        \"namespace\": \"spec:pose-review-cleanup-removes-go-build-leftovers\",\n        \"hash\": \"216571dc259c\",\n        \"state\": \"active\"\n      }\n    ],\n    \"digest\": \"sha256:49e6ee511728397f468dcb5e13fbb00313ebbb36cb0611baa9473c77e5db1501\"\n  },\n  \"phase\": \"started\",\n  \"recorded_at\": \"2026-11-14T22:08:32Z\"\n}\n# Rule: Knowledge Governance\n\n## When to consult\n\nConsult this guide when creating, updating, reviewing, or removing artifacts under `.pose/knowledge/`.\n\n## TTL and retention\n\n- Set `expires_at` on every artifact when it is created.\n- Use a default TTL of 30 days for notes, decision logs, and handoffs.\n- Use a TTL of up to 90 days only with a justification recorded in the artifact body.\n- Treat an artifact without `expires_at` as non-compliant and block its creation or merge.\n\n## When this is not the right home\n\n- Use `.pose/knowledge/` only for time-bound operational memory: content\n  tied to a decision moment, a handoff between executions, or something\n  meant to be reviewed and eventually expire.\n- A durable fact or convention that will not become false and carries no\n  review trigger — a third-party tool's parsing quirk, a naming\n  convention, a recurring gotcha — is not a `decision-log` just because no\n  better type exists. Route it to `.pose/rules/` instead: add it to an\n  existing rule file or create one, then wire it into the relevant task\n  type's base `rules` array in `.pose/indexes/task-map.json` so\n  `pose suggest <task>` surfaces it automatically. No path scoping is\n  required — a task type's base `rules` list is returned regardless of\n  `--path`; only language/component-specific rules need the\n  `rules_by_domain` layer.\n- Rule of thumb: if nothing was decided or traded off, and nothing about\n  the fact will change on a predictable timeline, it is not a\n  `decision-log` and not an ADR — it is a rule. See ADR\n  `2026-08-15-durable-non-architectural-knowledge-belongs-in-rules-not-a-new-type`.\n\n## Reusable cross-execution format\n\n- Structure reusable context as a handoff with fixed sections: Context, Current state, Next checks, Risks, and Next owner.\n- Keep `source_refs` linked to the relevant spec, workflow, and executed check commands.\n- Record `last_reviewed_at` in the body to make effective cross-execution updates traceable.\n\n## Archiving and purging\n\n- Run biweekly triage to list expired artifacts.\n- Move expired artifacts to `.pose/knowledge/archive/` when they retain audit value.\n- Purge archived artifacts 180 days after expiration unless documented legal or compliance requirements apply.\n- Record every archive and purge action in the housekeeping log.\n\n## Sensitive content\n\n- Prohibit secrets, tokens, credentials, private keys, and equivalent material.\n- Prohibit personal data and non-anonymized customer data.\n- Do not copy restricted incidents or reports in full; keep only a controlled reference.\n- Classify frontmatter `sensitivity` as `public-internal` or `restricted`.\n- Remove identified sensitive content immediately and open a security follow-up.\n\n## Ownership and review\n\n- Keep `@pose-maintainers` as the primary governance owner.\n- Require an owner in every artifact frontmatter.\n- Review expiration biweekly and quality monthly.\n- Escalate a backlog overdue by more than two cycles to the primary owner.\n- Block backlog growth when `list-expired` exceeds the operational limit: zero in strict mode, two in tolerant mode.\n\n## Minimum operational checks\n\n- Run `pose knowledge-check --strict` biweekly to validate the expired backlog.\n- Run `pose knowledge-housekeeping list-expired` for detailed triage.\n- Run `pose knowledge-housekeeping archive-expired --dry-run` before applying changes.\n- Execute destructive actions only with an explicit `--apply` flag.\n","exit_code":0,"status":"completed"}}
