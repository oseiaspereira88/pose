kes a path, so it cannot safely\n   435\t// delete after a hostile rename. Workspace and exact registration are instead\n   436\t// removed independently through confined roots. No global prune is performed.\n   437\ttype reviewCleanupOwnership struct {\n   438\t\tremoved          bool\n   439\t\truntime          *os.Root\n   440\t\tregistry         *os.Root\n   441\t\tregistration     string\n   442\t\tregistrationInfo os.FileInfo\n   443\t\tbacklink         string\n   444\t}\n   445\t\n   446\tfunc (s Store) captureReviewCleanupOwnership(runtime *os.Root, worktree string, marker []byte) (*reviewCleanupOwnership, error) {\n   447\t\traw, err := snapshotGit(s.Root, \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\")\n   448\t\tif err != nil {\n   449\t\t\treturn nil, err\n   450\t\t}\n   451\t\tparent := filepath.Join(strings.TrimSpace(string(raw)), \"worktrees\")\n   452\t\tpath := strings.TrimSpace(strings.TrimPrefix(string(marker), \"gitdir: \"))\n   453\t\tif !strings.HasPrefix(string(marker), \"gitdir: \") || !filepath.IsAbs(path) || filepath.Dir(path) != parent {\n   454\t\t\treturn nil, fmt.Errorf(\"unexpected worktree registration\")\n   455\t\t}\n   456\t\tregistry, err := os.OpenRoot(parent)\n   457\t\tif err != nil {\n   458\t\t\treturn nil, err\n   459\t\t}\n   460\t\tname := filepath.Base(path)\n   461\t\tinfo, err := registry.Lstat(name)\n   462\t\tif err != nil || !info.IsDir() {\n   463\t\t\tregistry.Close()\n   464\t\t\treturn nil, fmt.Errorf(\"worktree registration unavailable\")\n   465\t\t}\n   466\t\to := &reviewCleanupOwnership{runtime: runtime, registry: registry, registration: name, registrationInfo: info, backlink: filepath.Join(worktree, \".git\")}\n   467\t\tchild, err := registry.OpenRoot(name)\n   468\t\tif err != nil {\n   469\t\t\tregistry.Close()\n   470\t\t\treturn nil, err\n   471\t\t}\n   472\t\tbacklink, err := readReviewRootFile(child, \"gitdir\", 4096)\n   473\t\tchild.Close()\n   474\t\tif err != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n   475\t\t\tregistry.Close()\n   476\t\t\treturn nil, fmt.Errorf(\"worktree registration backlink differs\")\n   477\t\t}\n   478\t\treturn o, nil\n   479\t}\n   480\t\n   481\tfunc (s Store) cleanupReviewResources(tmp string, owned os.FileInfo, worktree string, worktreeOwned os.FileInfo, gitMarker []byte, ownership ...*reviewCleanupOwnership) error {\n   482\t\tvar o *reviewCleanupOwnership\n   483\t\tif len(ownership) > 0 {\n   484\t\t\to = ownership[0]\n   485\t\t}\n   486\t\tcurrent, err := os.Lstat(tmp)\n   487\t\tif errors.Is(err, os.ErrNotExist) {\n   488\t\t\tif (o != nil && !o.removed) || (o == nil && worktreeOwned != nil) {\n   489\t\t\t\treturn fmt.Errorf(\"runtime path disappeared without confirmed cleanup; resources may remain\")\n   490\t\t\t}\n   491\t\t\treturn nil\n   492\t\t}\n   493\t\tif err != nil || !current.IsDir() || !os.SameFile(owned, current) {\n   494\t\t\treturn fmt.Errorf(\"cleanup refused: runtime directory identity changed\")\n   495\t\t}\n   496\t\n   497\t\tvar root *os.Root\n   498\t\tif o != nil {\n   499\t\t\troot = o.runtime\n   500\t\t} else {\n   501\t\t\troot, err = os.OpenRoot(tmp)\n   502\t\t\tif err != nil {\n   503\t\t\t\treturn fmt.Errorf(\"runtime cleanup root unavailable\")\n   504\t\t\t}\n   505\t\t\tdefer root.Close()\n   506\t\t}\n   507\t\tstat, err := root.Stat(\".\")\n   508\t\tif err != nil || !os.SameFile(owned, stat) {\n   509\t\t\treturn fmt.Errorf(\"runtime cleanup root identity changed\")\n   510\t\t}\n   511\t\tif worktreeOwned != nil {\n   512\t\t\tinfo, err := root.Lstat(\"worktree\")\n   513\t\t\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n   514\t\t\t\treturn fmt.Errorf(\"worktree cleanup unavailable\")\n   515\t\t\t}\n   516\t\t\tif err == nil {\n   517\t\t\t\tmarker, e := readReviewRootFile(root, \"worktree/.git\", 4096)\n   518\t\t\t\tif e != nil || !info.IsDir() || !os.SameFile(worktreeOwned, info) || !bytes.Equal(marker, gitMarker) {\n   519\t\t\t\