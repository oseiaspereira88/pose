rsion(root); ev != \"\" {\n\t\t\tfmt.Fprintf(w, \"instance last updated by: pose %s\\n\", ev)\n\t\t}\n\t}\n\treturn 0\nfunc snapshotGit(root string, args ...string) ([]byte, error) {\n\tcmd := gitCommand(append([]string{\"-C\", root}, args...)...)\n\t// Asking about the worktree writes nothing under .git: without this `git status` refreshes\n\t// and rewrites the index, which a governed read view that watches .git reads as an input that\n\t// changed during the operation (spec pose-git-status-leaves-the-git-directory-alone).\n\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\treturn nil, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n\t}\n\treturn out, nil\n}\n\n// gitChangedPaths uses the NUL protocol; porcelain's quoted display is not a path.\nfunc gitChangedPaths(root string) ([]string, error) {\n\tout, err := snapshotGit(root, \"status\", \"--porcelain=v1\", \"-z\", \"--untracked-files=all\", \"--ignore-submodules=none\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tentries, err := parseGitStatusEntries(out)\n\tif err != nil {\n\t\treturn nil, err\n\t}\nnode {'checks': [{'name': 'lint', 'program': 'npm', 'args': ['run', 'lint', '--if-present'], 'severity': 'optional', 'evidenceClass': 'lint'}, {'name': 'test', 'program': 'npm', 'args': ['test', '--if-present'], 'severity': 'required', 'evidenceClass': 'unit'}, {'name': 'build', 'program': 'npm', 'args': ['run', 'build', '--if-present'], 'severity': 'required', 'evidenceClass': 'build'}, {'name': 'typecheck', 'program': 'npm', 'args': ['run', 'typecheck', '--if-present'], 'severity': 'optional', 'evidenceClass': 'typecheck'}]}\ngo {'checks': [{'name': 'build', 'program': 'go', 'args': ['build', './...'], 'severity': 'required', 'evidenceClass': 'build'}, {'name': 'test', 'program': 'go', 'args': ['test', './...'], 'severity': 'required', 'evidenceClass': 'unit'}, {'name': 'vet', 'program': 'go', 'args': ['vet', './...'], 'severity': '