{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"pose help | head -55; rg -n 'POSE_PROJECT_ROOT|func.*[Rr]oot|--root|runtime.*disable|POSE_.*RUNTIME' pose-mcp/internal/cli/runtime_host.go pose-mcp/internal/cli/runtime_client.go pose-mcp/internal/cli/main.go pose-mcp/cmd/pose/main.go | head -100; sed -n '780,885p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '1,90p' pose-mcp/internal/cli/runtime_lanes.go\"","aggregated_output":"POSE - Project Operating Standard for Engineering\n\nUsage: pose <command> [options]\n\nNative binary:\n  version                             Binary and instance schema versions\n  init                                Ensure the minimum POSE repository structure\n  serve-mcp [--stdio]                 Start the POSE MCP server (POSE_* environment)\n  doctor [--json]                     Diagnose installation and instance health\n  report-limitation --title \"...\"     Report an engine limitation, bug or proposal\n                                      [--kind limitation|bug|suggestion] [--submit]\n  install <dir> [--locale tag] [...]  Install embedded POSE without cloning\n  import <spec-kit|openspec> <path>   Import external specs [--dry-run]\n  telemetry <enable|disable|status>   Anonymous opt-in telemetry\n  setup [--json] [--no-input]         See what is in force, what is new and what is missing\n  context [--project-id <id>] [--task <ref>]  Resolve the selected project and qualified task context\n  identity <add|list|remove> [...]    Register the SSH keys a principal proves its answers with\n  issuer <init|pin|list|...>          Create and pin native issuers that sign review attestations\n  adopt <capability> | --list         Turn a governed capability on or off in this instance\n  migrate v7 --dry-run [--json]       Dry-run the legacy inventory a future major would convert\n\nScaffolds:\n  new-spec <slug>                     Create a feature spec scaffold\n  new-spec-qualified <slug>           Create via a qualified authority and fresh context\n  new-roadmap <slug>                  Create a governed roadmap\n  new-adr \"<title>\"                   Create an ADR\n  new-knowledge <type> <slug>         Create a handoff, note, or decision log\n  spec-transfer <preview|apply|resume|status> Transfer specification authority across projects\n  specs [--recent N] [--status S]     List and discover specifications\n  spec-format <migrate|status>        Inspect and migrate specs to the chronological layout\n  start spec:<slug> [--apply]         Preview or apply the atomic start of a draft spec\n\nDeterministic gates:\n  check | validate | knowledge-check | recurrence-check | lint-spec |\n  followups | amend | history-check | skills-check | review-check | closeout-check |\n  artifact-check | surface-check | roadmap-check | public-claims | docs-check\n\nDocumentation governance:\n  docs-init | docs-review | docs-sync Seed, review and export the docs contract of a project\n\nGoverned closeout:\n  review-plan <scope> [--explain]     Resolve component-aware criteria and tools\n  review bundle <scope> [--seal]      Prepare or seal an immutable review subject\n  review attest <bundle-id> [...]     Record/import a separate attestation\n  review verify <scope|bundle-id>     Verify freshness and closeout readiness\n  review record <scope> [...]         Compatibility entrypoint\n  action <open|list|show|resolve|...> Open, read and resolve material requests to a person or system\n  delegate review <scope> [--agent]   Run a delegated review; also adjudicate, smoke, ls, resume, cancel, agents\n  runtime <serve|start|attach|status|stop|restart|run>   Optional per-worktree runtime (opt-in); run hosts the checks in it; commands run standalone without it\n  close <scope>                         Apply a review-gated lifecycle transition\n  continuous-closeout <action>          Persist and project a terminal scope\n  artifact-backfill --from-git          Propose explicit historical provenance\n\nRelease lifecycle:\n  release <plan|prepare|check|notes|record|status|open-next|backfill>\nrg: pose-mcp/internal/cli/runtime_client.go: No such file or directory (os error 2)\nrg: pose-mcp/internal/cli/main.go: No such file or directory (os error 2)\npose-mcp/internal/cli/runtime_host.go:44:\t\tfor _, p := range []string{\"POSE_\", \"HARNE8_\", \"GIT_\", \"CLAUDE\", \"CODEX\", \"XDG_STATE_HOME\", \"XDG_CONFIG_HOME\", \"XDG_RUNTIME_DIR\"} {\npose-mcp/internal/cli/runtime_host.go:173:func cmdRuntimeRun(root string, args []string, stdout, stderr io.Writer) int {\n\treturn buildCurrentDeliveryGraphIn(posemodel.NativeFiles(), root)\n}\n\nfunc cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar spec, from, to string\n\tstrict, jsonOutput := true, false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--spec\", \"--from\", \"--to\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t\t}\n\t\t\ti++\n\t\t\tswitch args[i-1] {\n\t\t\tcase \"--spec\":\n\t\t\t\tspec = args[i]\n\t\t\tcase \"--from\":\n\t\t\t\tfrom = args[i]\n\t\t\tcase \"--to\":\n\t\t\t\tto = args[i]\n\t\t\t}\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t}\n\t}\n\tstore := posemodel.Store{Root: root}\n\tfull, err := store.GetSpec(spec)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tpolicy, err := posemodel.LoadArtifactPolicy(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tclaims, found, err := posemodel.ParseArtifactClaims(*full, policy)\n\tif err != nil || !found || len(claims) == 0 {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: spec %s has no valid artifact declaration: %v\\n\", spec, err)\n\t\treturn 1\n\t}\n\tvar sets []posemodel.ChangeSet\n\tif from != \"\" || to != \"\" {\n\t\tset, err := resolveGitChangeSet(root, spec, from, to)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tsets = append(sets, set)\n\t} else {\n\t\tfor _, recorded := range loadRecordedChangeSets(root) {\n\t\t\tif recorded.Spec == spec {\n\t\t\t\tsets = append(sets, recorded)\n\t\t\t}\n\t\t}\n\t\tif set, err := resolveGitChangeSet(root, spec, \"\", \"\"); err == nil {\n\t\t\talreadyPresent := false\n\t\t\tfor _, existing := range sets {\n\t\t\t\tif existing.ID == set.ID {\n\t\t\t\t\talreadyPresent = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !alreadyPresent {\n\t\t\t\tsets = append(sets, set)\n\t\t\t}\n\t\t}\n\t\tif len(sets) == 0 {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: no commits carry POSE-Spec: %s\\n\", spec)\n\t\t\treturn 1\n\t\t}\n\t}\n\tset := sets[0]\n\ttracked, err := gitTrackedPaths(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\t// A later removal by another spec is read from every spec's claims and\n\t// change sets (spec pose-delivery-later-removal R4).\n\tvar removals []posemodel.ArtifactRemoval\n\tif _, allClaims, allSets, _, _, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root); err == nil {\n\t\tremovals = artifactRemovals(root, allClaims, allSets, tracked, gaps, sets...)\n\t}\n\tgraph := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), []posemodel.Spec{*full}, claims, sets, tracked, policy, posemodel.LoadArchivedFragments(root), removals)\n\tfor _, claim := range claims {\n\t\tif claim.Action == \"none\" {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{claim.Path}\n\t\tif claim.Action == \"renamed\" {\n\t\t\tpaths = []string{claim.OldPath, claim.NewPath}\n\t\t}\n\t\tfor _, path := range paths {\n\t\t\tif err := posemodel.ValidateArtifactPath(root, path, false); err != nil {\n\t\t\t\tseverity := policy.Severities[\"resolvability\"]\n\t\t\t\tif severity == \"\" {\n\t\t\t\t\tseverity = \"warning\"\n\t\t\t\t}\n\t\t\t\tgraph.Findings = append(graph.Findings, posemodel.NewDeliveryIntegrityFinding(\"resolvability\", severity, spec, path, set.ID, err.Error(), \"declare an exact confined tracked file path\"))\npackage cli\n\nimport (\n\t\"runtime\"\n\t\"sync/atomic\"\n\t\"time\"\n)\n\n// Spec pose-worktree-runtime-qos-and-measurement.\n\n// runtimeAdmission is the runtime's policy for hosted commands: two lanes, each with its own\n// slots and queue, so that a short query is never queued behind a heavy check, and a bound on\n// what waits. The defaults are the ones the measurements of the spec were made with.\ntype runtimeAdmission struct {\n\tHeavySlots, ShortSlots int\n\tHeavyQueue, ShortQueue int\n\tMemoMiB                int\n}\n\nfunc defaultRuntimeAdmission() runtimeAdmission {\n\theavy := 1\n\tshort := 2\n\tif runtime.GOMAXPROCS(0) < 2 {\n\t\tshort = 1\n\t}\n\treturn runtimeAdmission{HeavySlots: heavy, ShortSlots: short, HeavyQueue: 4, ShortQueue: 16, MemoMiB: 256}\n}\n\n// shortCommands are the hosted commands that answer in well under a second on a repository of\n// this size (measured in the spec: surface-check of one spec takes about 10 ms; roadmap-check\n// takes minutes here); every other hosted command is heavy.\nvar shortCommands = map[string]bool{\"surface-check\": true}\n\n// hostedLane is one lane of the admission policy and its counters.\ntype hostedLane struct {\n\tname     string\n\tslots    chan struct{}\n\tmaxQueue int64\n\tqueued   atomic.Int64\n\trunning  atomic.Int64\n\tadmitted atomic.Int64\n\trefused  atomic.Int64\n\twaitNS   atomic.Int64\n\tmaxWait  atomic.Int64\n}\n\nfunc newHostedLane(name string, slots, queue int) *hostedLane {\n\tif slots < 1 {\n\t\tslots = 1\n\t}\n\treturn &hostedLane{name: name, slots: make(chan struct{}, slots), maxQueue: int64(queue)}\n}\n\n// enter reserves a place in the queue; false means every slot is busy and the queue is full,\n// and the command is refused before it waits. Two arrivals that find the same last free slot\n// may both wait: the queue limit can be exceeded by the arrivals of one instant.\nfunc (l *hostedLane) enter() bool {\n\tif l.queued.Add(1) > l.maxQueue && len(l.slots) == cap(l.slots) {\n\t\tl.queued.Add(-1)\n\t\tl.refused.Add(1)\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc (l *hostedLane) admit(wait time.Duration) {\n\tl.queued.Add(-1)\n\tl.running.Add(1)\n\tl.admitted.Add(1)\n\tl.waitNS.Add(int64(wait))\n\tfor {\n\t\tcur := l.maxWait.Load()\n\t\tif int64(wait) <= cur || l.maxWait.CompareAndSwap(cur, int64(wait)) {\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc (l *hostedLane) withdrawn() { l.queued.Add(-1); l.refused.Add(1) }\n\nfunc (l *hostedLane) metrics(out map[string]int64) {\n\tout[l.name+\"_slots\"] = int64(cap(l.slots))\n\tout[l.name+\"_queue_limit\"] = l.maxQueue\n\tout[l.name+\"_queued\"] = l.queued.Load()\n\tout[l.name+\"_running\"] = l.running.Load()\n\tout[l.name+\"_admitted\"] = l.admitted.Load()\n\tout[l.name+\"_refused\"] = l.refused.Load()\n\tout[l.name+\"_wait_ms_total\"] = l.waitNS.Load() / int64(time.Millisecond)\n\tout[l.name+\"_wait_ms_max\"] = l.maxWait.Load() / int64(time.Millisecond)\n}\n","exit_code":0,"status":"completed"}}
