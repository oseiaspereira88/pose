{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba .pose/specs/2026-11-14-pose-review-cleanup-removes-go-build-leftovers.md | sed -n '34,47p;102,115p'; nl -ba pose-mcp/internal/pose/review_adapter_containment_regression_test.go | sed -n '156,181p;330,377p'; git status --short\"","aggregated_output":"    34\t\n    35\t## 2. Requirements\n    36\t\n    37\t### Functional\n    38\t- R1: When a review run is cleaned up, every real directory named `go-build<digits>` at the top of its runtime directory shall be removed under its own bounded inventory before the runtime directory's inventory, for every adapter.\n    39\t- R2: An entry named like one that is a link or not a directory shall be left to the runtime inventory, and its target shall never be touched.\n    40\t- R3: A go-build directory that exceeds its own bounded inventory, or that changes identity during cleanup, shall leave the cleanup incomplete, as any other unconfirmed cleanup.\n    41\t\n    42\t### Non-functional\n    43\t- Orçamento por diretório de build: 200.000 entradas e 8 GiB.\n    44\t\n    45\t### Security\n    46\t- A remoção usa a raiz do diretório de execução já capturada e confere a identidade do diretório aberto.\n    47\t\n   102\t### Execution log\n   103\t- Date: 2026-11-14\n   104\t- Environment: Linux, Go 1.26.\n   105\t- Notes: diretório retido da run `rrn-331ef7311adb902b`: 1.730 entradas, 175 MB, com `go-build4066122796` de 151 MB. Sem a mudança, o teste reprova com a mesma mensagem da recusa (\"runtime cleanup inventory incomplete; resources retained\"); com ela, passa.\n   106\t\n   107\t### Results summary\n   108\t- Successes: limpeza completa com o leftover; link não seguido.\n   109\t- Failures: nenhuma.\n   110\t- Warnings: nenhum.\n   111\t\n   112\t### Requirement trace\n   113\t- R1 [satisfied] test:TestAdapterCleanupRemovesGoBuildLeftovers check:review-cleanup-removes-go-build-leftovers-integration\n   114\t- R2 [satisfied] test:TestAdapterCleanupRemovesGoBuildLeftovers\n   115\t- R3 [satisfied] test:TestAdapterContainmentCleanupCapturedRootsRefuseReplacement\n   156\tfunc TestAdapterContainmentCleanupCapturedRootsRefuseReplacement(t *testing.T) {\n   157\t\tif runtime.GOOS != \"linux\" {\n   158\t\t\tt.Skip(\"Linux descriptor and symlink qualification\")\n   159\t\t}\n   160\t\tfor _, kind := range []string{\"runtime-symlink\", \"runtime-missing\", \"registration-symlink\"} {\n   161\t\t\tt.Run(kind, func(t *testing.T) {\n   162\t\t\t\tf := makeContainmentCleanupFixture(t)\n   163\t\t\t\tvictim := t.TempDir()\n   164\t\t\t\tsentinel := filepath.Join(victim, \"keep\")\n   165\t\t\t\tif err := os.WriteFile(sentinel, []byte(\"foreign data\"), 0600); err != nil {\n   166\t\t\t\t\tt.Fatal(err)\n   167\t\t\t\t}\n   168\t\t\t\tswitch kind {\n   169\t\t\t\tcase \"runtime-symlink\", \"runtime-missing\":\n   170\t\t\t\t\tif err := os.Rename(f.tmp, f.tmp+\"-owned\"); err != nil {\n   171\t\t\t\t\t\tt.Fatal(err)\n   172\t\t\t\t\t}\n   173\t\t\t\t\tif kind == \"runtime-symlink\" {\n   174\t\t\t\t\t\tif err := os.Symlink(victim, f.tmp); err != nil {\n   175\t\t\t\t\t\t\tt.Fatal(err)\n   176\t\t\t\t\t\t}\n   177\t\t\t\t\t}\n   178\t\t\t\tcase \"registration-symlink\":\n   179\t\t\t\t\tpath := filepath.Join(f.store.Root, \".git\", \"worktrees\", f.ownership.registration)\n   180\t\t\t\t\tif err := os.Rename(path, path+\"-owned\"); err != nil {\n   181\t\t\t\t\t\tt.Fatal(err)\n   330\t}\n   331\t\n   332\t// Spec pose-review-cleanup-removes-go-build-leftovers: the Go build directory\n   333\t// an interrupted reviewer test left in the runtime directory is removed even\n   334\t// when it alone exceeds the runtime inventory, and a link named like one is\n   335\t// never followed.\n   336\tfunc TestAdapterCleanupRemovesGoBuildLeftovers(t *testing.T) {\n   337\t\tif runtime.GOOS != \"linux\" {\n   338\t\t\tt.Skip(\"Linux descriptor and symlink qualification\")\n   339\t\t}\n   340\t\tf := makeContainmentCleanupFixture(t)\n   341\t\tbuild := filepath.Join(f.tmp, \"go-build4066122796\")\n   342\t\tif err := os.MkdirAll(filepath.Join(build, \"b001\"), 0o700); err != nil {\n   343\t\t\tt.Fatal(err)\n   344\t\t}\n   345\t\tbig := filepath.Join(build, \"b001\", \"cli.test\")\n   346\t\tif err := os.WriteFile(big, nil, 0o700); err != nil {\n   347\t\t\tt.Fatal(err)\n   348\t\t}\n   349\t\tif err := os.Truncate(big, 200<<20); err != nil {\n   350\t\t\tt.Fatal(err)\n   351\t\t}\n   352\t\tfor i := 0; i < 4200; i++ {\n   353\t\t\tif err := os.WriteFile(filepath.Join(build, fmt.Sprintf(\"obj%04d.a\", i)), []byte(\"x\"), 0o600); err != nil {\n   354\t\t\t\tt.Fatal(err)\n   355\t\t\t}\n   356\t\t}\n   357\t\toutside := t.TempDir()\n   358\t\tkeep := filepath.Join(outside, \"keep\")\n   359\t\tif err := os.WriteFile(keep, []byte(\"outside\"), 0o600); err != nil {\n   360\t\t\tt.Fatal(err)\n   361\t\t}\n   362\t\tif err := os.Symlink(outside, filepath.Join(f.tmp, \"go-build1\")); err != nil {\n   363\t\t\tt.Fatal(err)\n   364\t\t}\n   365\t\tif err := f.cleanup(); err != nil {\n   366\t\t\tt.Fatalf(\"a go-build leftover kept the run from cleaning up: %v\", err)\n   367\t\t}\n   368\t\tif _, err := os.Lstat(f.tmp); !errors.Is(err, os.ErrNotExist) {\n   369\t\t\tt.Fatalf(\"the runtime directory remains: %v\", err)\n   370\t\t}\n   371\t\tif raw, err := os.ReadFile(keep); err != nil || string(raw) != \"outside\" {\n   372\t\t\tt.Fatalf(\"a go-build link was followed out of the runtime: %v %q\", err, raw)\n   373\t\t}\n   374\t}\n","exit_code":0,"status":"completed"}}
