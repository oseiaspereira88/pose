{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"git status --short; sed -n '1630,1755p' pose-mcp/internal/cli/validate.go; cat pose-mcp/internal/pose/material_binding.go | head -155; sed -n '600,665p' pose-mcp/internal/pose/delivery_surface.go; sed -n '174,204p' pose-mcp/internal/pose/review_bundle.go; sed -n '1080,1200p' pose-mcp/internal/cli/validate.go\"","aggregated_output":" M .pose/assessments/integrations.md\n M .pose/assessments/technical-debt.md\n M .pose/state/integrations.json\n M .pose/state/technical-debt.json\n\n\thasNodeModules := false\n\t_ = filepath.WalkDir(dir, func(p string, d os.DirEntry, err error) error {\n\t\tif err == nil && d.IsDir() && d.Name() == \"node_modules\" {\n\t\t\thasNodeModules = true\n\t\t\treturn filepath.SkipDir\n\t\t}\n\t\treturn nil\n\t})\n\tif !hasNodeModules {\n\t\treturn args\n\t}\n\n\t// Cancelling the run stops this too (review round 1, B4).\n\tcmd := exec.CommandContext(ctx, \"go\", \"list\", \"./...\")\n\tcmd.Dir = dir\n\tsetProcessGroup(cmd)\n\tcmd.Cancel = func() error { return killProcessGroup(cmd) }\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\treturn args\n\t}\n\n\tvar filteredPkgs []string\n\tlines := strings.Split(string(out), \"\\n\")\n\tfor _, line := range lines {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif trimmed != \"\" && !strings.Contains(trimmed, \"/node_modules/\") {\n\t\t\tfilteredPkgs = append(filteredPkgs, trimmed)\n\t\t}\n\t}\n\n\tif len(filteredPkgs) == 0 {\n\t\treturn args\n\t}\n\n\tvar newArgs []string\n\tfor _, a := range args {\n\t\tif a == \"./...\" || strings.HasSuffix(a, \"/...\") {\n\t\t\tnewArgs = append(newArgs, filteredPkgs...)\n\t\t} else {\n\t\t\tnewArgs = append(newArgs, a)\n\t\t}\n\t}\n\treturn newArgs\n}\n\n// materialWorktreeClean reports whether the working copy equals HEAD in every\n// path outside the administrative classes, untracked files included. A status\n// that cannot be read is not clean.\nfunc materialWorktreeClean(root string) bool {\n\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n\tif err != nil {\n\t\treturn false\n\t}\n\trecords := strings.Split(string(out), \"\\x00\")\n\tvar administrative []string\n\tfor i := 0; i < len(records); i++ {\n\t\trecord := records[i]\n\t\tif len(record) < 4 {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{record[3:]}\n\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n\t\t\t// A rename or copy carries its source as the next record.\n\t\t\tif i+1 < len(records) {\n\t\t\t\ti++\n\t\t\t\tpaths = append(paths, records[i])\n\t\t\t}\n\t\t}\n\t\tfor _, p := range paths {\n\t\t\tif !posemodel.IsAdministrativePath(p) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tadministrative = append(administrative, p)\n\t\t}\n\t}\n\treturn administrativeRecordsAreRegular(root, administrative)\n}\n\n// materialTrackedUnchanged reports whether no tracked file differs from HEAD\n// outside the administrative records. Untracked files are not counted: checks\n// leave build products behind, and those are not the material they ran over.\nfunc materialTrackedUnchanged(root string) bool {\n\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=no\")\n\tif err != nil {\n\t\treturn false\n\t}\n\trecords := strings.Split(string(out), \"\\x00\")\n\tvar administrative []string\n\tfor i := 0; i < len(records); i++ {\n\t\trecord := records[i]\n\t\tif len(record) < 4 {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{record[3:]}\n\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n\t\t\tif i+1 < len(records) {\n\t\t\t\ti++\n\t\t\t\tpaths = append(paths, records[i])\n\t\t\t}\n\t\t}\n\t\tfor _, p := range paths {\n\t\t\tif !posemodel.IsAdministrativePath(p) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tadministrative = append(administrative, p)\n\t\t}\n\t}\n\treturn administrativeRecordsAreRegular(root, administrative)\n}\n\n// administrativeRecordsAreRegular reports whether every changed administrative\n// path is a regular file at HEAD (or new): editing a committed symlink or\n// submodule inside a class is a material change, as in MaterialSetDigest.\nfunc administrativeRecordsAreRegular(root string, paths []string) bool {\n\tif len(paths) == 0 {\n\t\treturn true\n\t}\n\targs := []string{\"ls-tree\", \"-z\", \"HEAD\", \"--\"}\n\tfor _, p := range paths {\n\t\tif strings.ContainsAny(p, \"\\n\\x00\") {\n\t\t\treturn false\n\t\t}\n\t\t// The working copy as well as HEAD: a regular record replaced by a link, or\n\t\t// a new link, is not a record.\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Validation evidence binds to the material it validated (spec\n// pose-validation-evidence-material-binding, ADR\n// validation-evidence-binds-to-validated-material). A commit whose every\n// changed path is a derived administrative record does not change what the\n// checks exercised, so it does not move the material digest.\n\n// engineVersion is the running engine, registered by the binaries (internal/pose\n// stays importable on its own). It is part of every material digest, so a new\n// engine never inherits evidence the previous one produced.\nvar engineVersion = \"unregistered\"\n\n// SetEngineVersion registers the running engine for material digests.\nfunc SetEngineVersion(v string) { engineVersion = v }\n\n// administrativeDirs is the closed list of derived-record directories. It is\n// owned by the engine; adding a class is a contract change that needs an ADR.\nvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n\n// materialIndexes are files inside an administrative directory that still\n// change what the checks demand.\nvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\n// IsAdministrativePath reports whether p is a derived administrative record.\nfunc IsAdministrativePath(p string) bool {\n\tif p == \"\" || p != path.Clean(p) || strings.HasPrefix(p, \"/\") || strings.HasPrefix(p, \"../\") {\n\t\treturn false\n\t}\n\tif materialIndexes[p] {\n\t\treturn false\n\t}\n\tif !recordExtensions[strings.ToLower(path.Ext(p))] {\n\t\treturn false\n\t}\n\tfor _, dir := range administrativeDirs {\n\t\tif strings.HasPrefix(p, dir) {\n\t\t\treturn true\n\t\t}\n\t}\n\tif rest, ok := strings.CutPrefix(p, \".pose/\"); ok {\n\t\tif i := strings.Index(rest, \"/\"); i > 0 && strings.HasPrefix(rest[:i], \"review-\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// recordExtensions are the data formats a derived record is written in. Code or\n// a script stored in a class is material: that keeps a source file moved or\n// copied into a class from hiding its later edits. A copied data file stays\n// indistinguishable from a record; a check that reads data out of a derived-record\n// directory is outside this contract (ADR validation-evidence-binds-to-validated-material).\nvar recordExtensions = map[string]bool{\".json\": true, \".jsonl\": true, \".ndjson\": true, \".md\": true, \".txt\": true, \".log\": true, \".transcript\": true}\n\n// TreeEntry is one entry of the validated head's tree.\ntype TreeEntry struct{ Mode, Blob string }\n\nfunc regularMode(mode string) bool { return mode == \"100644\" || mode == \"100755\" }\n\n// MaterialInputs are what a material digest is computed from: the paths a change\n// set names (both sides of a rename, and the validation matrix) and the\n// destinations of renames. They are stored with the set so the digest can be\n// recomputed against the current tree without the commits' own records.\ntype MaterialInputs struct {\n\tNames []string `json:\"names\"`\n\tMoved []string `json:\"moved,omitempty\"`\n}\n\n// MaterialInputsOf derives the inputs from per-commit path records. They must\n// be unmerged: folding a create and a later rename into one creation would hide\n// that the file moved into a class.\nfunc MaterialInputsOf(paths []ObservedPath) MaterialInputs {\n\tnames := map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\tmoved := map[string]bool{}\n\tfor _, p := range paths {\n\t\tfor _, name := range []string{p.Path, p.OldPath, p.NewPath} {\n\t\t\tif name != \"\" {\n\t\t\t\tnames[name] = true\n\t\t\t}\n\t\t}\n\t\t// A rename destination is material whatever directory it lands in:\n\t\t// otherwise moving a source file into a class would hide its later edits.\n\t\tif p.OldPath != \"\" && p.NewPath != \"\" {\n\t\t\tmoved[p.NewPath] = true\n\t\t}\n\t}\n\tin := MaterialInputs{}\n\tfor name := range names {\n\t\tin.Names = append(in.Names, name)\n\t}\n\tfor name := range moved {\n\t\tin.Moved = append(in.Moved, name)\n\t}\n\tsort.Strings(in.Names)\n\tsort.Strings(in.Moved)\n\treturn in\n}\n\n// MaterialSetDigest digests the head state of the material a change set\n// touched: every path it names (both sides of a rename) with its mode and blob\n// at the validated head, minus the paths that are administrative records and\n// still regular files there, plus the validation matrix. A symlink, submodule\n// or directory in an administrative class is material; so is a path that left\n// a class. tree maps each named path (and the matrix) to its entry; a path\n// absent from the head tree is \"absent\".\nfunc MaterialSetDigest(in MaterialInputs, tree map[string]TreeEntry) string {\n\tmoved := map[string]bool{}\n\tfor _, name := range in.Moved {\n\t\tmoved[name] = true\n\t}\n\tsorted := in.Names\n\th := sha256.New()\n\tfor _, name := range sorted {\n\t\tentry, present := tree[name]\n\t\tif IsAdministrativePath(name) && !moved[name] && (!present || regularMode(entry.Mode)) {\n\t\t\tcontinue\n\t\t}\n\t\tif !present {\n\t\t\th.Write([]byte(name + \"\\x00absent\\n\"))\n\t\t\tcontinue\n\t\t}\n\t\th.Write([]byte(name + \"\\x00\" + entry.Mode + \"\\x00\" + entry.Blob + \"\\n\"))\n\t}\n\treturn \"sha256:\" + hex.EncodeToString(h.Sum(nil))\n}\n\n// MaterialDigestUnreadable marks a change set whose head tree could not be read\n// or whose checkout is not complete. It never binds evidence and never lets\n// evidence recorded without it pass as current.\nconst MaterialDigestUnreadable = \"unreadable\"\n\n// MaterialBindingUnavailable is recorded for a scope whose material cannot be\n// established, so the result is stale for it instead of falling back to the\n// commit-bound rules.\nconst MaterialBindingUnavailable = \"unavailable\"\n\n// MaterialBinding returns what a validation run should record for a spec: the\n// scoped digest, the unavailable marker when a change set's material could not\n// be read, or nothing when the spec has no material-bound change set.\nfunc MaterialBinding(graph DeliveryIntegrityGraph, spec string) (string, bool) {\n\tsets := 0\n\tfor _, set := range graph.ChangeSets {\n\t\tif set.Spec != spec {\n\t\t\tcontinue\n// invalidate historical evidence for this scope.\nfunc ScopedDeliveryProvenanceDigest(graph DeliveryIntegrityGraph, spec string) string {\n\tclaims := []ArtifactClaim{}\n\tsets := []ChangeSet{}\n\tfor _, claim := range graph.Claims {\n\t\tif claim.Spec == spec {\n\t\t\tclaims = append(claims, claim)\n\t\t}\n\t}\n\tfor _, set := range graph.ChangeSets {\n\t\tif set.Spec == spec {\n\t\t\tsets = append(sets, set)\n\t\t}\n\t}\n\tsort.Slice(claims, func(i, j int) bool { return claimKey(claims[i]) < claimKey(claims[j]) })\n\tsort.Slice(sets, func(i, j int) bool { return sets[i].ID < sets[j].ID })\n\traw, _ := json.Marshal(struct {\n\t\tClaims []ArtifactClaim `json:\"claims\"`\n\t\tSets   []ChangeSet     `json:\"change_sets\"`\n\t}{claims, withoutMaterialDigest(sets)})\n\tsum := sha256.Sum256(raw)\n\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n}\n\nfunc deliveryEvidenceCurrent(result DeliveryValidationResult, spec, status string, graph DeliveryIntegrityGraph, sets []ChangeSet) bool {\n\tif bound := result.MaterialProvenance[spec]; bound != \"\" {\n\t\t// A material binding governs: a mismatch is stale, never a fall-through\n\t\t// to the commit-bound rules below. Only a closed spec keeps its exemption.\n\t\tif bound == ScopedMaterialDigest(graph, spec) {\n\t\t\treturn true\n\t\t}\n\t\treturn status == \"done\" && result.GeneratedAt != \"\"\n\t}\n\tif scoped := result.ScopeProvenance[spec]; scoped != \"\" {\n\t\tif scoped == ScopedDeliveryProvenanceDigest(graph, spec) {\n\t\t\treturn true\n\t\t}\n\t\tif status == \"done\" && result.GeneratedAt != \"\" {\n\t\t\treturn true\n\t\t}\n\t\treturn false\n\t}\n\tif result.ProvenanceDigest != \"\" && result.ProvenanceDigest == graph.ProvenanceDigest {\n\t\treturn true\n\t}\n\t// Results emitted before scope_provenance existed were module-wide. Preserve\n\t// them only for already-closed historical specs: their immutable closeout\n\t// cannot retroactively acquire the new field, and unrelated later targets\n\t// must not invalidate them. Open/current scopes never receive this bridge.\n\tif status == \"done\" && result.ProvenanceDigest != \"\" && result.GeneratedAt != \"\" {\n\t\treturn true\n\t}\n\tif result.GitHead == \"\" {\n\t\treturn false\n\t}\n\tfor _, set := range sets {\n\t\tif result.GitHead == set.Head || result.GitHead == set.ResolvedHead {\n\t\t\treturn true\n\t\t}\n\t\tfor _, commit := range set.Commits {\n\t\t\tif result.GitHead == commit {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t}\n\treturn false\n}\n\n// ReviewEvidenceObservation classifies one sealed result against the subject\n// head it is sealed beside.\nfunc ReviewEvidenceObservation(subjectHead string, evidence ReviewBundleEvidence) string {\n\tif evidence.GitHead == \"\" || subjectHead == \"\" {\n\t\treturn \"unknown\"\n\t}\n\tif evidence.GitHead == subjectHead {\n\t\treturn \"observed\"\n\t}\n\treturn \"carried-forward\"\n}\n\n// ReviewEvidenceObservationForSubject prefers the semantic subject identity\n// for derived evidence and retains the commit-based compatibility path for\n// ordinary validation results.\nfunc ReviewEvidenceObservationForSubject(subject ReviewBundleSubject, evidence ReviewBundleEvidence) string {\n\tif evidence.SubjectDigest != \"\" {\n\t\tif subject.ImplementationDigest == \"\" {\n\t\t\treturn \"unknown\"\n\t\t}\n\t\tif evidence.SubjectDigest == subject.ImplementationDigest {\n\t\t\treturn \"observed\"\n\t\t}\n\t\treturn \"carried-forward\"\n\t}\n\treturn ReviewEvidenceObservation(subject.Head, evidence)\n}\n\ntype ReviewBundleChild struct {\n\t}\n\tknownModules := map[string]bool{}\n\tfor _, module := range modules {\n\t\tknownModules[module.Rel] = true\n\t}\n\tfor rel, override := range matrix.ModuleOverrides {\n\t\tclean := filepath.ToSlash(filepath.Clean(rel))\n\t\tif clean == \"..\" || strings.HasPrefix(clean, \"../\") || filepath.IsAbs(rel) {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: moduleOverrides contains a path outside the project: %s\\n\", \"Erro: moduleOverrides contém path fora do projeto: %s\\n\"), rel)\n\t\t\treturn 2\n\t\t}\n\t\tif knownModules[clean] {\n\t\t\tif override.Stack != \"\" {\n\t\t\t\tfor idx := range modules {\n\t\t\t\t\tif modules[idx].Rel == clean {\n\t\t\t\t\t\tmodules[idx].Stack = override.Stack\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tabs := filepath.Join(root, filepath.FromSlash(clean))\n\t\tif info, err := os.Stat(abs); err == nil && info.IsDir() {\n\t\t\tstack := override.Stack\n\t\t\tif stack == \"\" {\n\t\t\t\tstack = \"contract\"\n\t\t\t}\n\t\t\tmodules = append(modules, validationModule{Rel: clean, Abs: abs, Stack: stack})\n\t\t\tknownModules[clean] = true\n\t\t}\n\t}\n\tsort.Slice(modules, func(i, j int) bool { return modules[i].Rel < modules[j].Rel })\n\tvar scope *scopeSelection\n\tif changedTo != \"\" && changedFrom == \"\" {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --changed-to requires --changed-from.\", \"Erro: --changed-to exige --changed-from.\"))\n\t\treturn 2\n\t}\n\tif changedFrom != \"\" {\n\t\tsel, err := computeChangedScope(root, changedFrom, changedTo, modules)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: changed-scope selection: %v\\n\", \"Erro: seleção por escopo alterado: %v\\n\"), err)\n\t\t\treturn 2\n\t\t}\n\t\tscope = &sel\n\t\tif explain {\n\t\t\tfmt.Fprintf(stdout, \"[changed-scope] %s: %d changed file(s), %d/%d module(s) selected\\n\", sel.rangeLabel(), len(sel.Changed), len(sel.Selected), len(modules))\n\t\t\tfor _, m := range modules {\n\t\t\t\tif reason, ok := sel.Selected[m.Rel]; ok {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  + %s: %s\\n\", m.Rel, reason)\n\t\t\t\t} else {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  - %s: not affected by %s\\n\", m.Rel, sel.rangeLabel())\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\trun := validationRunResult{\n\t\tSchemaVersion: validationResultSchema,\n\t\tGeneratedAt:   time.Now().UTC().Format(time.RFC3339),\n\t\tMode:          mode,\n\t\tStackFilter:   stackFilter,\n\t\tModuleFilter:  moduleFilter,\n\t\tChecks:        []checkResult{},\n\t}\n\tmatrixDigest := sha256.Sum256(raw)\n\trun.MatrixSHA256 = \"sha256:\" + hex.EncodeToString(matrixDigest[:])\n\trun.EngineVersion = validationEngineIdentity()\n\tvar carryState carryPlan\n\tif carry {\n\t\tcarryState = planCarry(root, canonicalResultsPath, mode, run.MatrixSHA256, matrix, modules)\n\t\trun.Carry = carryState.record\n\t\tout := render(stdout, stderr)\n\t\tif !carryState.record.Used {\n\t\t\tout.ContractLine(\"[carry] full run: \" + carryState.record.Reason)\n\t\t} else {\n\t\t\tout.ContractLine(fmt.Sprintf(\"[carry] base %s: %d changed file(s), %d/%d module(s) run\", carryState.record.BaseHead, carryState.record.Changed, len(carryState.record.Selected), len(modules)))\n\t\t\tif explain {\n\t\t\t\tfor _, m := range modules {\n\t\t\t\t\tif reason, ok := carryState.record.Selected[m.Rel]; ok {\n\t\t\t\t\t\tout.ContractLine(\"  + \" + m.Rel + \": \" + reason)\n\t\t\t\t\t} else {\n\t\t\t\t\t\tout.ContractLine(\"  = \" + m.Rel + \": carried from \" + carryState.record.BaseHead)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n\t\trun.GitHead = strings.TrimSpace(string(head))\n\t}\n\tif graph, err := buildCurrentDeliveryGraph(root); err == nil {\n\t\trun.ProvenanceDigest = graph.ProvenanceDigest\n\t\trun.ScopeProvenance = map[string]string{}\n\t\tseenSpecs := map[string]bool{}\n\t\tfor _, set := range graph.ChangeSets {\n\t\t\tif set.Spec != \"\" {\n\t\t\t\tseenSpecs[set.Spec] = true\n\t\t\t}\n\t\t}\n\t\t// The binding names the committed tree. Checks run on the working copy, so a\n\t\t// working copy that differs from it in any material path validated something\n\t\t// else: the run then records the binding as unavailable.\n\t\tclean := materialWorktreeClean(root)\n\t\tfor spec := range seenSpecs {\n\t\t\trun.ScopeProvenance[spec] = posemodel.ScopedDeliveryProvenanceDigest(graph, spec)\n\t\t\tif !clean {\n\t\t\t\tif run.MaterialProvenance == nil {\n\t\t\t\t\trun.MaterialProvenance = map[string]string{}\n\t\t\t\t}\n\t\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n\t\t\t} else if material, ok := posemodel.MaterialBinding(graph, spec); ok {\n\t\t\t\tif run.MaterialProvenance == nil {\n\t\t\t\t\trun.MaterialProvenance = map[string]string{}\n\t\t\t\t}\n\t\t\t\trun.MaterialProvenance[spec] = material\n\t\t\t}\n\t\t}\n\t}\n\tfailures := 0\n\toptionalFailures := 0\n\texecuted := 0\n\tr := render(stdout, stderr)\n","exit_code":0,"status":"completed"}}
