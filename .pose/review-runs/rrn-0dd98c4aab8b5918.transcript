{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/validate_carry.go | sed -n '58,165p'; git diff dec2e64c..883eb1ef -- POSE.md locales/pt-BR/POSE.md pose-mcp/internal/cli/help_catalog.go; rg -n 'carried|carry|dirty|rename' pose-mcp/internal/cli/testdata/adversarial/README.md; go env GOCACHE GOTMPDIR\"","aggregated_output":"    58\t// planCarry judges the canonical result at resultsPath as a base. A nil\n    59\t// selection means every check runs; the record says why.\n    60\tfunc planCarry(root, resultsPath, mode, matrixSHA string, matrix validationMatrix, modules []validationModule) carryPlan {\n    61\t\tplan := carryPlan{record: &carryRecord{}}\n    62\t\tunused := func(format string, args ...any) carryPlan {\n    63\t\t\tplan.record.Reason = fmt.Sprintf(format, args...)\n    64\t\t\treturn plan\n    65\t\t}\n    66\t\traw, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(resultsPath)))\n    67\t\tif err != nil {\n    68\t\t\treturn unused(\"no canonical result at %s\", resultsPath)\n    69\t\t}\n    70\t\tvar base validationRunResult\n    71\t\tif err := json.Unmarshal(raw, &base); err != nil || base.SchemaVersion != validationResultSchema {\n    72\t\t\treturn unused(\"the canonical result is unreadable or has another schema\")\n    73\t\t}\n    74\t\tswitch {\n    75\t\tcase base.ModuleFilter != \"\" || base.StackFilter != \"\":\n    76\t\t\treturn unused(\"the canonical result was filtered by module or stack, so it is not comparable\")\n    77\t\tcase base.Mode != mode:\n    78\t\t\treturn unused(\"the canonical result ran in mode %q, this run is %q\", base.Mode, mode)\n    79\t\tcase base.MatrixSHA256 != matrixSHA:\n    80\t\t\treturn unused(\"the validation matrix changed since the canonical result\")\n    81\t\tcase base.EngineVersion == \"\" || base.EngineVersion != validationEngineIdentity():\n    82\t\t\treturn unused(\"the engine version differs from the canonical result's or was not recorded\")\n    83\t\tcase base.GitHead == \"\" || !safeGitRevRE.MatchString(base.GitHead):\n    84\t\t\treturn unused(\"the canonical result records no usable head\")\n    85\t\t}\n    86\t\tfor _, check := range base.Checks {\n    87\t\t\tif check.LimitState == \"cancelled\" {\n    88\t\t\t\treturn unused(\"the canonical result was cancelled\")\n    89\t\t\t}\n    90\t\t}\n    91\t\tif !materialWorktreeClean(root) {\n    92\t\t\treturn unused(\"the working copy differs from HEAD in material paths\")\n    93\t\t}\n    94\t\tif err := posemodel.RawGit(\"-C\", root, \"merge-base\", \"--is-ancestor\", base.GitHead, \"HEAD\").Run(); err != nil {\n    95\t\t\treturn unused(\"the canonical result's head %s is not an ancestor of HEAD\", base.GitHead)\n    96\t\t}\n    97\t\tselection, err := computeChangedScope(root, base.GitHead, \"HEAD\", modules, carryExclusions(root, base.GitHead, resultsPath)...)\n    98\t\tif err != nil {\n    99\t\t\treturn unused(\"changed-scope selection failed: %v\", err)\n   100\t\t}\n   101\t\tplan.base = map[string]checkResult{}\n   102\t\tfor _, check := range base.Checks {\n   103\t\t\tplan.base[check.ID] = check\n   104\t\t}\n   105\t\t// A module whose checks are not all in the base runs (R3).\n   106\t\tfor _, module := range modules {\n   107\t\t\tif _, selected := selection.Selected[module.Rel]; selected {\n   108\t\t\t\tcontinue\n   109\t\t\t}\n   110\t\t\tstack, checks, _ := moduleValidationChecks(module, matrix, \"\", \"\")\n   111\t\t\tfor _, check := range checks {\n   112\t\t\t\tif check.Program == \"\" {\n   113\t\t\t\t\tcontinue\n   114\t\t\t\t}\n   115\t\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n   116\t\t\t\tif prior, ok := plan.base[id]; !ok || prior.Outcome == \"skipped\" || prior.Outcome == \"\" {\n   117\t\t\t\t\tselection.Selected[module.Rel] = \"carry: no prior result for \" + id\n   118\t\t\t\t\tbreak\n   119\t\t\t\t}\n   120\t\t\t}\n   121\t\t}\n   122\t\tplan.selection, plan.baseHead, plan.baseTime = &selection, base.GitHead, base.GeneratedAt\n   123\t\tplan.record.Used, plan.record.BaseHead, plan.record.Changed, plan.record.Selected = true, base.GitHead, len(selection.Changed), selection.Selected\n   124\t\treturn plan\n   125\t}\n   126\t\n   127\t// carryExclusions are the changed paths that are not changes for the carry\n   128\t// selection (R3): the canonical result itself and the derived administrative\n   129\t// records of the engine's closed list (the same classes material bindings\n   130\t// ignore) that are still regular files, or gone, at HEAD. A symlink,\n   131\t// submodule or directory in a class stays a change.\n   132\tfunc carryExclusions(root, base, resultsPath string) []string {\n   133\t\texclude := []string{resultsPath}\n   134\t\tout, err := posemodel.RawGit(\"-C\", root, \"diff\", \"--name-only\", \"-z\", base, \"HEAD\", \"--\").Output()\n   135\t\tif err != nil {\n   136\t\t\treturn exclude\n   137\t\t}\n   138\t\tfor _, file := range strings.Split(string(out), \"\\x00\") {\n   139\t\t\tfile = filepath.ToSlash(file)\n   140\t\t\tif file == \"\" || !posemodel.IsAdministrativePath(file) {\n   141\t\t\t\tcontinue\n   142\t\t\t}\n   143\t\t\tentry, err := posemodel.RawGit(\"-C\", root, \"ls-tree\", \"-z\", \"HEAD\", \"--\", file).Output()\n   144\t\t\tif err != nil {\n   145\t\t\t\tcontinue\n   146\t\t\t}\n   147\t\t\tfields := strings.Fields(string(entry))\n   148\t\t\tif len(fields) == 0 || fields[0] == \"100644\" || fields[0] == \"100755\" {\n   149\t\t\t\texclude = append(exclude, file)\n   150\t\t\t}\n   151\t\t}\n   152\t\treturn exclude\n   153\t}\n   154\t\n   155\t// validationEngineIdentity names the engine that ran a validation: its version\n   156\t// plus, when the binary records it, the VCS revision it was built from, marked\n   157\t// when the build tree was modified. Development builds share a version string,\n   158\t// so the revision is what tells two of them apart (R2).\n   159\tfunc validationEngineIdentity() string {\n   160\t\tidentity := version.Version\n   161\t\tinfo, ok := debug.ReadBuildInfo()\n   162\t\tif !ok {\n   163\t\t\treturn identity\n   164\t\t}\n   165\t\trevision, modified := \"\", false\ndiff --git a/POSE.md b/POSE.md\nindex 4621ed21..b30441f6 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -215,7 +215,7 @@ pose new-knowledge <type> <slug>   # create handoff/note/decision-log\n pose check [--strict|--tolerant]   # structural integrity + matrix schema +\n                                    # task-map sync + spec graph + schema version\n pose validate [--strict|--tolerant] [--stack s] [--module path] [--report] [--json-out f] [--junit f] [--sarif f]\n-              [--changed-from rev [--changed-to rev]] [--jobs n] [--explain] [--emit-plan f]\n+              [--changed-from rev [--changed-to rev] | --carry] [--jobs n] [--explain] [--emit-plan f]\n pose lint-spec <slug>|--all [--strict|--tolerant] [--required-only] [--ready-check] [--design-check]\n pose knowledge-check [--strict|--tolerant] [--max-overdue N]\n pose recurrence-check [--strict|--tolerant] [--window-days N] [--threshold T] [--flap-threshold N] [--include-pass]\n@@ -350,7 +350,9 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `new-knowledge` — creates an artifact in [`.pose/knowledge/`](.pose/knowledge/) from [`.pose/templates/knowledge.md`](.pose/templates/knowledge.md) with mandatory frontmatter (`type`, `owner`, `sensitivity`, `created_at`, `last_reviewed_at`, `expires_at`). Computes `expires_at` from the TTL (default 30d, max 90d).\n - `validate` — runs the declarative matrix in [`validation-matrix.json`](.pose/indexes/validation-matrix.json): per-stack checks, per-module overrides, severity (`required`/`optional`) and mode (`strict`/`tolerant`). `--json-out`/`--junit`/`--sarif <path>` (`--json <path>` still works as a deprecated alias of `--json-out <path>`) emit the versioned structured result (schema 1) from one canonical model: stable check IDs (`<module>/<stack>/<name>`), command metadata, timing, severity, distinguishable outcomes (`pass|fail|error|skipped` — infra failures never masquerade as check failures), deterministic skip reasons, bounded captured output and secret redaction (configured env values only; inherited environment never enters the result). Text output stays authoritative; machine formats are additive. POSE-specific semantics survive the JUnit/SARIF projections via documented extensions (classname suffix / `pose/*` properties).\n   **Runtime guardrails:** every check runs under a timeout (`timeoutSeconds` per check, `defaults.timeoutSeconds`, safe default 600s) and an output ceiling (`defaults.maxOutputBytes`, default 1 MiB); breaching either terminates the process group and records the explicit state (`limit_state: timeout|output-limit`). Checks marked `isolation: \"required\"` never run locally — they are skipped with a machine-readable reason and exported by `--emit-plan <file>`: an execution-plan envelope binding project, spec, check plan, matrix digest, git HEAD and an approval slot to be stamped with an expiring execution identity before the Harness may run it.\n-  **Changed scope:** `--changed-from <rev> [--changed-to <rev>]` selects the minimum safe module set deterministically — modules containing changed files (tracked and untracked), transitive dependents via `dependsOn` edges in [`module-metadata.json`](.pose/indexes/module-metadata.json), and policy widening (criticality `high` always runs). A change outside every module runs everything (uncertainty prefers safe execution); unselected checks are recorded as skipped with the selection reason and `--explain` prints every decision. Revisions are confined to a safe grammar; without the flags, full validation is unchanged.\n+  **Changed scope:** `--changed-from <rev> [--changed-to <rev>]` selects the minimum safe module set deterministically — modules containing changed files (tracked and untracked), transitive dependents via `dependsOn` edges in [`module-metadata.json`](.pose/indexes/module-metadata.json), and policy widening (criticality `high` always runs). A change outside every module runs every module that does not declare `\"selfContained\": true` in its metadata (uncertainty prefers safe execution; the declaration states that the module's checks read only its own directory and its `dependsOn` modules); unselected checks are recorded as skipped with the selection reason and `--explain` prints every decision. Revisions are confined to a safe grammar; without the flags, full validation is unchanged.\n+\n+  **Carried checks:** `--carry --json-out <results_path>` refreshes the canonical result instead of rerunning the whole matrix. It uses the current canonical result as its base when the base is comparable: same schema, mode, matrix digest and `engine_version` (the engine version plus the VCS revision the binary was built from), unfiltered, not cancelled, with its `git_head` an ancestor of `HEAD` and a clean material working copy. It runs the modules the changed-scope rules select between the base head and `HEAD`; the canonical result file and the derived administrative records that material bindings ignore (data files that are still regular files in the derived-record directories under `.pose/`: indexes, results, state, assessments and review records; the validation matrix stays material) are not changes. A module whose checks are not all in the base also runs. Every other check keeps the base result, its outcome included, and records `carried_from` (the head it ran at, kept through chained carries) and `carried_generated_at`; the delivery index reads that head for the result, so evidence freshness judges the commit a carried check really observed. A carried failure still fails the run. Any unmet condition runs everything, and `carry.reason` says why. `carry` records the base, the number of changed files and each selected module's reason, and `counts.carried` the reused checks. `--carry` does not combine with `--module`, `--stack`, `--workspace`, `--root-only`, `--changed-from` or `--changed-to`.\n \n   **Concurrency:** checks run up to `--jobs <n>` at a time (default: half the cores, bounded by available memory at about 1.5 GiB per check and by 8); results are reported and recorded in matrix order, whatever order they finish in, and the report records `jobs` and `wall_seconds`. `--jobs 1` and `--verbose` run one at a time. A check marked `exclusive: true` runs with nothing else running: earlier checks finish first, so its `when` can depend on them, which a concurrent check's cannot — a check's `when` is read as it starts. The run ends with its wall time beside the sum of its checks and the slowest checks. An interrupt or SIGTERM stops every running check's process group (on Windows, its process) and starts nothing more; those checks are recorded with `limit_state: cancelled`, the run is `fail` and exits 1, and a second signal acts at once. A default `--jobs` follows the cgroup's memory headroom and CPU quota where there is one.\n \ndiff --git a/locales/pt-BR/POSE.md b/locales/pt-BR/POSE.md\nindex df424ce4..ced171b9 100644\n--- a/locales/pt-BR/POSE.md\n+++ b/locales/pt-BR/POSE.md\n@@ -219,7 +219,7 @@ pose new-knowledge <type> <slug>   # cria handoff/note/decision-log em .pose/kno\n pose check [--strict|--tolerant]   # integridade estrutural + matrix schema +\n                                    # task-map sync + grafo de specs + schema version\n pose validate [--strict|--tolerant] [--stack s] [--module path] [--report] [--json-out f] [--junit f] [--sarif f]\n-              [--changed-from rev [--changed-to rev]] [--jobs n] [--explain] [--emit-plan f]\n+              [--changed-from rev [--changed-to rev] | --carry] [--jobs n] [--explain] [--emit-plan f]\n pose lint-spec <slug>|--all [--strict|--tolerant] [--required-only] [--ready-check] [--design-check]\n pose knowledge-check [--strict|--tolerant] [--max-overdue N]\n pose recurrence-check [--strict|--tolerant] [--window-days N] [--threshold T] [--flap-threshold N] [--include-pass]\n@@ -354,7 +354,9 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `new-knowledge` — cria artefato em [`.pose/knowledge/`](.pose/knowledge/) a partir de [`.pose/templates/knowledge.md`](.pose/templates/knowledge.md) com frontmatter obrigatório (`type`, `owner`, `sensitivity`, `created_at`, `last_reviewed_at`, `expires_at`). Calcula `expires_at` pelo TTL (default 30d, máximo 90d).\n - `validate` — executa a matriz declarativa em [`validation-matrix.json`](.pose/indexes/validation-matrix.json): checks por stack, overrides por módulo, severidade (`required`/`optional`) e modo (`strict`/`tolerant`). `--json-out`/`--junit`/`--sarif <path>` (`--json <path>` continua funcionando como alias depreciado de `--json-out <path>`) emitem o resultado estruturado versionado (schema 1) a partir de um único modelo canônico: IDs estáveis de check (`<module>/<stack>/<name>`), metadados de comando, tempo, severidade, outcomes distinguíveis (`pass|fail|error|skipped` — falha de infraestrutura nunca se disfarça de falha de check), motivos determinísticos de skip, saída capturada com limite e redação de segredos (apenas valores de env configurados; o ambiente herdado nunca entra no resultado). A saída em texto continua autoritativa; os formatos de máquina são aditivos. A semântica específica do POSE sobrevive às projeções JUnit/SARIF via extensões documentadas (sufixo de classname / propriedades `pose/*`).\n   **Guardrails de runtime:** todo check roda sob timeout (`timeoutSeconds` por check, `defaults.timeoutSeconds`, default seguro 600s) e teto de saída (`defaults.maxOutputBytes`, default 1 MiB); violar qualquer um encerra o process group e registra o estado explícito (`limit_state: timeout|output-limit`). Checks marcados `isolation: \"required\"` nunca rodam localmente — são pulados com motivo legível por máquina e exportados por `--emit-plan <file>`: um envelope de plano de execução vinculando projeto, spec, plano de checks, digest da matriz, git HEAD e um slot de aprovação a ser carimbado com identidade de execução expirável antes que o Harness possa executá-lo.\n-  **Escopo por mudança:** `--changed-from <rev> [--changed-to <rev>]` seleciona deterministicamente o conjunto mínimo seguro de módulos — módulos com arquivos alterados (rastreados e não rastreados), dependentes transitivos via arestas `dependsOn` em [`module-metadata.json`](.pose/indexes/module-metadata.json) e alargamento por política (criticidade `high` sempre roda). Uma mudança fora de todos os módulos roda tudo (na incerteza, prefere-se execução segura); checks não selecionados são registrados como skipped com o motivo da seleção e `--explain` imprime cada decisão. Revisões ficam confinadas a uma gramática segura; sem as flags, a validação completa é inalterada.\n+  **Escopo por mudança:** `--changed-from <rev> [--changed-to <rev>]` seleciona deterministicamente o conjunto mínimo seguro de módulos — módulos com arquivos alterados (rastreados e não rastreados), dependentes transitivos via arestas `dependsOn` em [`module-metadata.json`](.pose/indexes/module-metadata.json) e alargamento por política (criticidade `high` sempre roda). Uma mudança fora de todos os módulos roda todo módulo que não declara `\"selfContained\": true` nos seus metadados (na incerteza, prefere-se execução segura; a declaração afirma que os checks do módulo só leem o próprio diretório e os módulos de `dependsOn`); checks não selecionados são registrados como skipped com o motivo da seleção e `--explain` imprime cada decisão. Revisões ficam confinadas a uma gramática segura; sem as flags, a validação completa é inalterada.\n+\n+  **Checks carregados:** `--carry --json-out <results_path>` renova o resultado canônico em vez de rodar a matriz inteira de novo. Ele usa o resultado canônico atual como base quando a base é comparável: mesmo schema, modo, digest da matriz e `engine_version` (a versão do motor mais a revisão VCS da qual o binário foi compilado), sem filtro, não cancelada, com `git_head` ancestral de `HEAD` e cópia de trabalho limpa nos paths materiais. Roda os módulos que as regras de escopo por mudança selecionam entre o head da base e `HEAD`; o arquivo do resultado canônico e os registros administrativos derivados que o binding de material ignora (arquivos de dados ainda regulares nos diretórios de registros derivados sob `.pose/`: índices, resultados, estado, assessments e registros de revisão; a matriz de validação continua material) não contam como mudança. Um módulo cujos checks não estão todos na base também roda. Todo outro check mantém o resultado da base, inclusive o desfecho, e registra `carried_from` (o head em que rodou, mantido em carregamentos encadeados) e `carried_generated_at`; o índice de entrega lê esse head no resultado, então o frescor da evidência julga o commit que um check carregado realmente observou. Uma falha carregada continua reprovando o run. Qualquer condição não atendida roda tudo, e `carry.reason` diz por quê. `carry` registra a base, o número de arquivos alterados e o motivo de cada módulo selecionado, e `counts.carried` os checks reaproveitados. `--carry` não combina com `--module`, `--stack`, `--workspace`, `--root-only`, `--changed-from` ou `--changed-to`.\n \n   **Concorrência:** os checks rodam até `--jobs <n>` ao mesmo tempo (padrão: metade dos núcleos, limitada pela memória disponível, cerca de 1,5 GiB por check, e por 8); os resultados são mostrados e registrados na ordem da matriz, seja qual for a ordem em que terminem, e o relatório registra `jobs` e `wall_seconds`. `--jobs 1` e `--verbose` rodam um de cada vez. Um check marcado `exclusive: true` roda sem nenhum outro em execução: os checks anteriores terminam antes, então seu `when` pode depender deles, o que o de um check concorrente não pode — o `when` de um check é lido quando ele vai começar. A execução termina com seu tempo de parede ao lado da soma dos checks e os checks mais lentos. Uma interrupção ou SIGTERM encerra o grupo de processos de cada check em execução (no Windows, seu processo) e não inicia mais nada; esses checks são registrados com `limit_state: cancelled`, a execução fica `fail` e sai com 1, e um segundo sinal age na hora. O `--jobs` padrão segue a folga de memória e a cota de CPU do cgroup, quando há um.\n \ndiff --git a/pose-mcp/internal/cli/help_catalog.go b/pose-mcp/internal/cli/help_catalog.go\nindex f252f70a..c6381d05 100644\n--- a/pose-mcp/internal/cli/help_catalog.go\n+++ b/pose-mcp/internal/cli/help_catalog.go\n@@ -129,6 +129,7 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"--json-out <path>\", \"Write structured validation outcome to the specified JSON path\", \"Grava o resultado da validação no caminho JSON especificado\"},\n \t\t\t{\"--json <path>\", \"Deprecated alias of --json-out <path>\", \"Alias depreciado de --json-out <path>\"},\n \t\t\t{\"--changed-from <rev>\", \"Validate only modules affected between git revisions\", \"Valida apenas módulos afetados entre as revisões git\"},\n+\t\t\t{\"--carry\", \"Refresh the canonical result: run what changed since it and carry the other checks with the head they ran at\", \"Renova o resultado canônico: roda o que mudou desde ele e carrega os demais checks com o head em que rodaram\"},\n \t\t\t{\"--jobs <n>\", \"Run up to n checks at once (default: from cores and available memory)\", \"Roda até n checks ao mesmo tempo (padrão: conforme núcleos e memória disponível)\"},\n \t\t\t{\"--verbose\", \"Stream each check's output as it runs; by default it is captured and a failing check's tail is shown\", \"Transmite a saída de cada check durante a execução; por padrão ela é capturada e o final da saída de um check que falha é exibido\"},\n \t\t},\n43:| `rename-read-as-removal` | delegated | A rename, or a path spelled as a pathspec, is taken for the declared deletion (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`) | pose-delivery-later-removal |\n45:| `peer-removal-stands-for-a-member` | delegated | A review subject digests a removed path from a peer's accepted removal while another observing member — sorted later, sharing a commit, or reduced into the peer's set — has none, whatever action or rename it observed the path with (`pose/review_subject_later_removal_test.go:TestReviewSubjectReadsALaterRemovalFromItsWitness`, `pose/review_subject_later_removal_test.go:TestMilestoneSubjectRemovalHoldsForEveryMember`) | pose-review-subject-later-removal |\n/home/go/.cache/go-build\n\n","exit_code":0,"status":"completed"}}
