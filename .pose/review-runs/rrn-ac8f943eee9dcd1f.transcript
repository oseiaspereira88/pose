{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Gy7RjKybj9WKU7YcGy7xD","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\t\"testing\"\n8\t\n9\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n10\t)\n11\t\n12\t// Spec pose-done-spec-keeps-its-sealed-plan R4, R5.\n13\t\n14\tfunc unstablePlan(done bool, freshness string) posemodel.CloseoutPlan {\n15\t\tplan := posemodel.CloseoutPlan{Scope: \"spec:x\", LifecycleDone: done}\n16\t\tif freshness != \"\" {\n17\t\t\tplan.ReadView = &posemodel.ReadViewMetadata{Freshness: freshness}\n18\t\t}\n19\t\treturn plan\n20\t}\n21\t\n22\tfunc TestAStopOnAnUnknownViewOfADoneScopeLeavesNoCheckpoint(t *testing.T) {\n23\t\tverify := posemodel.CloseoutPlanStep{ID: posemodel.CloseoutStepVerify, State: posemodel.CloseoutStateBlocked}\n24\t\tif !closeoutStopLeavesNoCheckpoint(unstablePlan(true, posemodel.ReadViewFreshnessUnknown), verify) {\n25\t\t\tt.Fatal(\"the verification of a done scope stopped on an unknown read view must leave no checkpoint\")\n26\t\t}\n27\t}\n28\t\n29\tfunc TestEveryOtherStopStillRecordsItsCheckpoint(t *testing.T) {\n30\t\tblocked := func(id string) posemodel.CloseoutPlanStep {\n31\t\t\treturn posemodel.CloseoutPlanStep{ID: id, State: posemodel.CloseoutStateBlocked}\n32\t\t}\n33\t\tcases := map[string]struct {\n34\t\t\tplan posemodel.CloseoutPlan\n35\t\t\tstep posemodel.CloseoutPlanStep\n36\t\t}{\n37\t\t\t\"a lifecycle not done\":       {unstablePlan(false, posemodel.ReadViewFreshnessUnknown), blocked(posemodel.CloseoutStepVerify)},\n38\t\t\t\"a current read view\":        {unstablePlan(true, posemodel.ReadViewFreshnessCurrent), blocked(posemodel.CloseoutStepVerify)},\n39\t\t\t\"no read view\":               {unstablePlan(true, \"\"), blocked(posemodel.CloseoutStepVerify)},\n40\t\t\t\"another step\":               {unstablePlan(true, posemodel.ReadViewFreshnessUnknown), blocked(posemodel.CloseoutStepMechanical)},\n41\t\t\t\"a step that is not blocked\": {unstablePlan(true, posemodel.ReadViewFreshnessUnknown), posemodel.CloseoutPlanStep{ID: posemodel.CloseoutStepVerify, State: posemodel.CloseoutStatePending}},\n42\t\t}\n43\t\tfor name, c := range cases {\n44\t\t\tif closeoutStopLeavesNoCheckpoint(c.plan, c.step) {\n45\t\t\t\tt.Errorf(\"%s: a stop that is progress or a real blocker lost its checkpoint\", name)\n46\t\t\t}\n47\t\t}\n48\t}\n49\t\n50\t// R4, on the path both modes share: a call that ends at the stop clears a checkpoint an\n51\t// earlier stop left and says where the state is.\n52\tfunc TestTheStopOnUnstableInputsClearsAnOlderCheckpointAndSaysWhereTheStateIs(t *testing.T) {\n53\t\troot := reviewBundleCLIFixture(t)\n54\t\tstore := posemodel.Store{Root: root}\n55\t\tcheckpoint := filepath.Join(root, \".pose/closeout-plans/spec-bundle.json\")\n56\t\tfor _, resume := range []string{\"`pose close spec:bundle --resume`\"} {\n57\t\t\tmustWrite(t, checkpoint, `{\"schema_version\":1,\"scope\":\"spec:bundle\",\"started_at\":\"2026-11-08T00:00:00Z\",\"plan_digest\":\"sha256:old\",\"completed\":[\"context\"],\"last_error\":\"verify: unknown\"}`)\n58\t\t\tresult := posemodel.NewOperationResult(\"close.apply\", \"spec:bundle\")\n59\t\t\tout := stopOnUnstableInputs(store, \"spec:bundle\", resume, &result, posemodel.CloseoutStepVerify, \"governance read view is unknown\")\n60\t\t\tif out.Outcome != posemodel.OutcomeBlocked || out.Error == nil || out.Error.Cause != \"terminal-verification-unstable-inputs\" || !out.Resumable {\n61\t\t\t\tt.Fatalf(\"the stop was not reported as one on unstable inputs: %+v\", out)\n62\t\t\t}\n63\t\t\tif !strings.Contains(out.NextAction, \"no checkpoint is kept for this stop\") || !strings.Contains(out.NextAction, resume) {\n64\t\t\t\tt.Fatalf(\"the result does not say where the state is: %q\", out.NextAction)\n65\t\t\t}\n66\t\t\tif _, err := os.Stat(checkpoint); err == nil {\n67\t\t\t\tt.Fatal(\"a checkpoint of the stop was kept\")\n68\t\t\t}\n69\t\t}\n70\t}\n71\t\n72\tfunc TestAStopWhoseCheckpointCannotBeRemovedSaysSo(t *testing.T) {\n73\t\troot := reviewBundleCLIFixture(t)\n74\t\tstore := posemodel.Store{Root: root}\n75\t\t// A directory where the checkpoint file would be: it cannot be removed as a file.\n76\t\tdir := filepath.Join(root, \".pose/closeout-plans/spec-bundle.json\")\n77\t\tmustWrite(t, filepath.Join(dir, \"keep\"), \"x\")\n78\t\tresult := posemodel.NewOperationResult(\"close.apply\", \"spec:bundle\")\n79\t\tout := stopOnUnstableInputs(store, \"spec:bundle\", \"`pose close spec:bundle --resume`\", &result, posemodel.CloseoutStepVerify, \"governance read view is unknown\")\n80\t\tif strings.Contains(out.NextAction, \"no checkpoint is kept\") || !strings.Contains(out.NextAction, \"could not be removed\") || len(out.Unconfirmed) == 0 {\n81\t\t\tt.Fatalf(\"the result claims a state it is not in: %q %+v\", out.NextAction, out.Unconfirmed)\n82\t\t}\n83\t}\n84\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"ffaa048f-e7ea-44a7-bb16-2962c64a126f","timestamp":"2026-11-09T03:20:04.127Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3514312054/worktree/pose-mcp/internal/cli/closeout_unstable_inputs_test.go","content":"package cli\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\n// Spec pose-done-spec-keeps-its-sealed-plan R4, R5.\n\nfunc unstablePlan(done bool, freshness string) posemodel.CloseoutPlan {\n\tplan := posemodel.CloseoutPlan{Scope: \"spec:x\", LifecycleDone: done}\n\tif freshness != \"\" {\n\t\tplan.ReadView = &posemodel.ReadViewMetadata{Freshness: freshness}\n\t}\n\treturn plan\n}\n\nfunc TestAStopOnAnUnknownViewOfADoneScopeLeavesNoCheckpoint(t *testing.T) {\n\tverify := posemodel.CloseoutPlanStep{ID: posemodel.CloseoutStepVerify, State: posemodel.CloseoutStateBlocked}\n\tif !closeoutStopLeavesNoCheckpoint(unstablePlan(true, posemodel.ReadViewFreshnessUnknown), verify) {\n\t\tt.Fatal(\"the verification of a done scope stopped on an unknown read view must leave no checkpoint\")\n\t}\n}\n\nfunc TestEveryOtherStopStillRecordsItsCheckpoint(t *testing.T) {\n\tblocked := func(id string) posemodel.CloseoutPlanStep {\n\t\treturn posemodel.CloseoutPlanStep{ID: id, State: posemodel.CloseoutStateBlocked}\n\t}\n\tcases := map[string]struct {\n\t\tplan posemodel.CloseoutPlan\n\t\tstep posemodel.CloseoutPlanStep\n\t}{\n\t\t\"a lifecycle not done\":       {unstablePlan(false, posemodel.ReadViewFreshnessUnknown), blocked(posemodel.CloseoutStepVerify)},\n\t\t\"a current read view\":        {unstablePlan(true, posemodel.ReadViewFreshnessCurrent), blocked(posemodel.CloseoutStepVerify)},\n\t\t\"no read view\":               {unstablePlan(true, \"\"), blocked(posemodel.CloseoutStepVerify)},\n\t\t\"another step\":               {unstablePlan(true, posemodel.ReadViewFreshnessUnknown), blocked(posemodel.CloseoutStepMechanical)},\n\t\t\"a step that is not blocked\": {unstablePlan(true, posemodel.ReadViewFreshnessUnknown), posemodel.CloseoutPlanStep{ID: posemodel.CloseoutStepVerify, State: posemodel.CloseoutStatePending}},\n\t}\n\tfor name, c := range cases {\n\t\tif closeoutStopLeavesNoCheckpoint(c.plan, c.step) {\n\t\t\tt.Errorf(\"%s: a stop that is progress or a real blocker lost its checkpoint\", name)\n\t\t}\n\t}\n}\n\n// R4, on the path both modes share: a call that ends at the stop clears a checkpoint an\n// earlier stop left and says where the state is.\nfunc TestTheStopOnUnstableInputsClearsAnOlderCheckpointAndSaysWhereTheStateIs(t *testing.T) {\n\troot := reviewBundleCLIFixture(t)\n\tstore := posemodel.Store{Root: root}\n\tcheckpoint := filepath.Join(root, \".pose/closeout-plans/spec-bundle.json\")\n\tfor _, resume := range []string{\"`pose close spec:bundle --resume`\"} {\n\t\tmustWrite(t, checkpoint, `{\"schema_version\":1,\"scope\":\"spec:bundle\",\"started_at\":\"2026-11-08T00:00:00Z\",\"plan_digest\":\"sha256:old\",\"completed\":[\"context\"],\"last_error\":\"verify: unknown\"}`)\n\t\tresult := posemodel.NewOperationResult(\"close.apply\", \"spec:bundle\")\n\t\tout := stopOnUnstableInputs(store, \"spec:bundle\", resume, &result, posemodel.CloseoutStepVerify, \"governance read view is unknown\")\n\t\tif out.Outcome != posemodel.OutcomeBlocked || out.Error == nil || out.Error.Cause != \"terminal-verification-unstable-inputs\" || !out.Resumable {\n\t\t\tt.Fatalf(\"the stop was not reported as one on unstable inputs: %+v\", out)\n\t\t}\n\t\tif !strings.Contains(out.NextAction, \"no checkpoint is kept for this stop\") || !strings.Contains(out.NextAction, resume) {\n\t\t\tt.Fatalf(\"the result does not say where the state is: %q\", out.NextAction)\n\t\t}\n\t\tif _, err := os.Stat(checkpoint); err == nil {\n\t\t\tt.Fatal(\"a checkpoint of the stop was kept\")\n\t\t}\n\t}\n}\n\nfunc TestAStopWhoseCheckpointCannotBeRemovedSaysSo(t *testing.T) {\n\troot := reviewBundleCLIFixture(t)\n\tstore := posemodel.Store{Root: root}\n\t// A directory where the checkpoint file would be: it cannot be removed as a file.\n\tdir := filepath.Join(root, \".pose/closeout-plans/spec-bundle.json\")\n\tmustWrite(t, filepath.Join(dir, \"keep\"), \"x\")\n\tresult := posemodel.NewOperationResult(\"close.apply\", \"spec:bundle\")\n\tout := stopOnUnstableInputs(store, \"spec:bundle\", \"`pose close spec:bundle --resume`\", &result, posemodel.CloseoutStepVerify, \"governance read view is unknown\")\n\tif strings.Contains(out.NextAction, \"no checkpoint is kept\") || !strings.Contains(out.NextAction, \"could not be removed\") || len(out.Unconfirmed) == 0 {\n\t\tt.Fatalf(\"the result claims a state it is not in: %q %+v\", out.NextAction, out.Unconfirmed)\n\t}\n}\n","numLines":84,"startLine":1,"totalLines":84}},"tool_result_meta":[{"id":"toolu_012Gy7RjKybj9WKU7YcGy7xD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
