estone-of-one-member-is-that-member.md b/.pose/adr/2026-11-02-a-milestone-of-one-member-is-that-member.md\nindex ccdb9ee9..c06f0261 100644\n--- a/.pose/adr/2026-11-02-a-milestone-of-one-member-is-that-member.md\n+++ b/.pose/adr/2026-11-02-a-milestone-of-one-member-is-that-member.md\n@@ -12,6 +12,8 @@ Accepted (2026-11-02), spec `pose-milestone-review-proportional`.\n - A milestone with exactly one local member has no review of its own: its approval is the approval of that spec, once the spec is closed. It inherits a review and nothing else: the acceptance of its edges still has to hold.\n - A negative review recorded on the milestone stands, in a bundle or a legacy attempt, and an approval already recorded on it stays as it is.\n - While that spec is open, its review answers for the exit gate of the milestone, as a criterion of the plan, so the gate is judged once and not never.\n+- When that spec turns done it keeps the plan it was sealed with (spec `pose-done-spec-keeps-its-sealed-plan`): the criterion stays in its plan if the governing sealed bundle carries it, because the plan is an input of the bundle and a plan that lost the criterion at the transition made the bundle the approval was attested over read superseded, and, for an approval backed by a delegated run, no longer governing. A done spec sealed without the criterion gains none, so no approval falls; a done spec whose sealed history cannot be read whole gets a blocker in its plan instead of silently losing the gate. Measured on this repository: 17 done specs gain the criterion, and every one of them verifies the same before and after (closed, fresh, approved).\n+- A closeout whose terminal verification stops on an unknown governance read view, with the lifecycle already done, writes no checkpoint and clears the one it holds: the repository carries the state, `--resume` re-plans from it, and a checkpoint recording that stop was read as an open defect by the next reviewer.\n - A milestone of several members keeps its integration review, where the review of `community-launch` found what no spec could.\n - A roadmap may declare `unreviewed_milestones: <reason>`, and its reached milestones then stand without a review. The reason is sealed with the roadmap, whose own review stays required and is what an external consumer holds for such a milestone.\n \ndiff --git a/pose-mcp/internal/cli/closeout_plan.go b/pose-mcp/internal/cli/closeout_plan.go\nindex 50eb6093..fe76cc1e 100644\n--- a/pose-mcp/internal/cli/closeout_plan.go\n+++ b/pose-mcp/internal/cli/closeout_plan.go\n@@ -278,6 +278,31 @@ func applyClosePlan(root string, store posemodel.Store, ref, mode, digest, revie\n \treturn result\n }\n \n+// closeoutStopLeavesNoCheckpoint reports a stop that is not progress: the verification of\n+// a scope already done, blocked because the governance read view is not current.\n+func closeoutStopLeavesNoCheckpoint(plan posemodel.CloseoutPlan, step posemodel.CloseoutPlanStep) bool {\n+\treturn step.ID == posemodel.CloseoutStepVerify && step.State == posemodel.CloseoutStateBlocked && plan.StoppedOnUnstableInputs()\n+}\n+\n+// stopOnUnstableInputs ends a call at the terminal verification of a scope already done\n+// whose governance read view is not current. It clears the checkpoint instead of\n+// recording the stop, and says where the state is.\n+func stopOnUnstableInputs(store posemodel.Store, ref, resume string, result *posemodel.OperationResult, step, reason string) posemodel.OperationResult {\n+\tkept := \"\"\n+\tif err := store.ClearCloseoutCheckpoint(ref); err != nil {\n+\t\tkept = err.Error()\n+\t\tresult.Unconfirmed = append(result.Unconfirmed, posemodel.OperationUncertain{Step: \"checkpoint\", Reason: \"the checkpoint of the finished steps was not removed: \" + err.Error()})\n+\t}\n+\tresult.Fail(posemodel.OutcomeBlocked, step, \"terminal-verification-unstable-inputs\", reason)\n+\tresult.Resumable = true\n+\tif kept != \"\" {\n+\t\tresult.NextAction = \"the lifecycle is done and the repository carries the state; the checkpoint of this stop could not be removed (\" + kept + \"): remove .pose/closeout-plans/\" + strings.ReplaceAll(strings.ReplaceAll(ref, \":\", \"-\"), \"/\", \"-\") + \".json by hand, it is not progress. Then verify again with `pose closeout-check \" + ref + \"` or \" + resume\n+\t\treturn *result\n+\t}\n+\tresult.NextAction = \"the lifecycle is done and the repository carries the state; no checkpoint is kept for this stop. Verify again with `pose closeout-check \" + ref + \"` or \" + resume\n+\treturn *result\n+}\n+\n func applyClosePlanGuarded(root string, store posemodel.Store, ref, mode, digest, reviewer string, skipEvidence bool) posemodel.OperationResult {\n \tresult := posemodel.NewOperationResult(\"close.\"+mode, ref)\n \tresume := \"`pose close \" + ref + \" --resume`\"\n@@ -299,6 +324,11 @@ func applyClosePlanGuarded(root string, store posemodel.Store, ref, mode, digest\n \t// no operation step or effect ran (B12 already-satisfied contract).\n \tif plan.LifecycleDone {\n \t\tif !plan.Terminal {\n+\t\t\tif plan.StoppedOnUnstableInputs() {\n+\t\t\t\t// The same stop as inside the loop, reached by a call made after it: a\n+\t\t\t\t// checkpoint an earlier stop left is not progress either (R4).\n+\t\t\t\treturn stopOnUnstableInputs(store, ref, resume, &result, posemodel.CloseoutStepVerify, strings.Join(plan.Blockers, \"; \"))\n+\t\t\t}\n \t\t\tresult.Fail(posemodel.OutcomeBlocked, posemodel.CloseoutStepVerify, \"terminal-verification-blocked\", strings.Join(plan.Blockers, \"; \"))\n \t\t\tresult.NextAction = plan.NextAction\n \t\t\treturn result\n@@ -373,6 +403,13 @@ func applyClosePlanGuarded(root string, store posemodel.Store, ref, mode, digest\n \t\t\tbreak\n \t\t}\n \t\tif next.State == posemodel.CloseoutStateBlocked {\n+\t\t\tif closeoutStopLeavesNoCheckpoint(plan, next) {\n+\t\t\t\t// The transition is made and the repository carries the state; what is\n+\t\t\t\t// unknown is whether the inputs are stable. A checkpoint recording that\n+\t\t\t\t// would be read as an open defect and is not progress, so none is kept:\n+\t\t\t\t// --resume re-plans from the repository (R4).\n+\t\t\t\treturn stopOnUnstableInputs(store, ref, resume, &result, next.ID, next.Reason)\n+\t\t\t}\n \t\t\trecord(next.ID, fmt.Errorf(\"%s\", next.Reason))\n \t\t\tresult.Fail(posemodel.OutcomeBlocked, next.ID, \"step-blocked\", next.Reason)\n \t\t\tresult.Resumable = true\ndiff --git a/pose-mcp/internal/pose/closeout_plan.go b/pose-mcp/internal/pose/closeout_plan.go\nindex 74773994..c91c6aba 100644\n--- a/pose-mcp/internal/pose/closeout_plan.go\n+++ b/pose-mcp/internal/pose/closeout_plan.go\n@@ -114,6 +114,14 @@ func applyCloseoutPlanReadView(plan *CloseoutPlan, metadata *ReadViewMetadata, s\n \t}\n }\n \n+// StoppedOnUnstableInputs reports a completed scope whose terminal verification cannot\n+// proceed because the governance read view is not current: the lifecycle has been\n+// transitioned, the repository carries the state, and what is unknown is whether the\n+// inputs read are stable (spec pose-done-spec-keeps-its-sealed-plan R4).\n+func (p CloseoutPlan) StoppedOnUnstableInputs() bool {\n+\treturn p.LifecycleDone && p.ReadView != nil && p.ReadView.Freshness != ReadViewFreshnessCurrent\n+}\n+\n func (s Store) planCloseout(ref string) (CloseoutPlan, error) {\n \tscope, err := ParseScopeRef(ref)\n \tif err != nil {\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex fe65661c..0782e239 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -1043,16 +1043,44 @@ func composeReviewCriteria(profiles []ReviewProfile, blockers []string) ([]Revie\n }\n \n // addMilestoneGateCriterion carries the exit gate of a milestone into the review of the\n-// open spec it is made of: that milestone has no review of its own, so this is where the\n-// gate is judged. A done spec keeps the plan it was sealed with.\n+// spec it is made of: that milestone has no review of its own, so this is where the\n+// gate is judged. A done spec keeps the plan it was sealed with (spec\n+// pose-done-spec-keeps-its-sealed-plan): the criterion stays in its plan when a sealed\n+// bundle of the spec carries it, because the plan is an input of the bundle and a plan\n+// that loses the criterion at the transition to done makes the bundle the approval was\n+// attested over read superseded. A done spec sealed without it gains none.\n func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCriterion, blockers []string) ([]ReviewPlanCriterion, []string) {\n \tif scope.Kind != \"spec\" {\n \t\treturn criteria, blockers\n \t}\n \tsp, err := s.GetSpec(scope.Slug)\n-\tif err != nil || terminalStatuses[sp.Status] {\n+\tif err != nil {\n \t\treturn criteria, blockers\n \t}\n+\tdone := terminalStatuses[sp.Status]\n+\tvar sealedWith map[string]bool // criterion ids of the governing bundle of a done spec, read once\n+\tvar historyUnknown string      // why the history could not say, when it could not\n+\tsealedCarries := func(id string) bool {\n+\t\tif sealedWith == nil {\n+\t\t\tsealedWith = map[string]bool{}\n+\t\t\t// The governing bundle is the newest: a gate that only an older round of\n+\t\t\t// the review carried was dropped by a later seal and is not kept.\n+\t\t\tread, readErr := s.ReadReviewBundles(\"spec:\" + scope.Slug)\n+\t\t\tswitch {\n+\t\t\tcase readErr != nil:\n+\t\t\t\thistoryUnknown = readErr.Error()\n+\t\t\tcase !read.Coverage.CompleteFor(\"spec:\" + scope.Slug):\n+\t\t\t\thistoryUnknown = \"a sealed bundle of the scope could not be read\"\n+\t\t\tdefault:\n+\t\t\t\tif lineage := reviewBundleLineage(read.Bundles); len(lineage) > 0 {\n+\t\t\t\t\tfor _, criterion := range lineage[0].Payload.Plan.Criteria {\n+\t\t\t\t\t\tsealedWith[criterion.ID] = true\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\treturn sealedWith[id]\n+\t}\n \troadmaps, err := s.ListRoadmaps()\n \tif err != nil {\n \t\treturn criteria, blockers\n@@ -1069,6 +1097,14 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \t\t\tif member, ok := s.soleMemberOf(ref); !ok || member != scope.Slug {\n \t\t\t\tcontinue\n \t\t\t}\n+\t\t\tif done && !sealedCarries(\"milestone-exit-gate-\"+rm.Slug+\"-\"+milestone.ID) {\n+\t\t\t\tif historyUnknown != \"\" {\n+\t\t\t\t\t// Absent history is not unreadable history: the plan says it cannot\n+\t\t\t\t\t// tell whether the gate was sealed, instead of silently dropping it.\n+\t\t\t\t\tblockers = append(blockers, \"milestone exit gate of \"+rm.Slug+\"/\"+milestone.ID+\" cannot be carried into the plan of the done spec \"+scope.Slug+\": the sealed bundles could not establish whether it was sealed (\"+historyUnknown+\")\")\n+\t\t\t\t}\n+\t\t\t\tcontinue\n+\t\t\t}\n \t\t\tcriteria, blockers = addReviewCriterion(criteria, ReviewPlanCriterion{\n \t\t\t\tID:          \"milestone-exit-gate-\" + rm.Slug + \"-\" + milestone.ID,\n \t\t\t\tDescription: \"The exit gate of milestone:\" + rm.Slug + \"/\" + milestone.ID + \" holds: \" + milestone.ExitGate,","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"8215dbc1-aa1c-4010-86ea-ddeebb35314f","timestamp":"2026-11-09T03:15:06.897Z","tool_use_result":{"stdout":" ...-02-a-milestone-of-one-member-is-that-member.md |    2 +\n .../pose-done-spec-keeps-its-sealed-plan.md        |    6 +\n ...ose-review-brief-states-the-conclusion-rules.md |    6 +\n .pose/indexes/delivery-integrity.json              | 7146 +++++++++++---------\n .pose/indexes/generation.json                      |   30 +-\n .pose/indexes/releases.json                        |   24 +\n .pose/indexes/roadmaps.json                        |   24 +-\n .pose/indexes/spec-graph.json                      | 1215 ++--\n .pose/indexes/validation-matrix.json               |   29 +\n .pose/policy/delegation.json                       |    6 +\n .pose/results/delivery-validation.json        