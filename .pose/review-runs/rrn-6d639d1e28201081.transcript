{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc \"git diff 2bf2adf147bda0b7d8396e025d8f543d08ed2747 eb30001f0f8a66c1438919bd72ecefe286d9d256 -- pose-mcp/internal/cli/doctor.go pose-mcp/internal/cli/doctor_commit_graph.go .github/workflows/ci.yml .pose/indexes/validation-matrix.json; rg --files -g AGENTS.md -g '*doctor*commit*' -g '*doctor-recommends*'\"","aggregated_output":"diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\nindex 8512af6c..cdebba85 100644\n--- a/.github/workflows/ci.yml\n+++ b/.github/workflows/ci.yml\n@@ -18,6 +18,12 @@ jobs:\n       # runner where it matters (spec pose-release-boundary-rehearsal).\n       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n         with: { fetch-depth: 0 }\n+      # Governance reads ask Git for the last commit that touched each\n+      # artifact; on the full history each lookup walks it. The commit-graph\n+      # with changed-path filters answers from the filters (47 ms -> 2 ms a\n+      # lookup; spec pose-doctor-recommends-the-commit-graph).\n+      - name: Write the Git commit-graph with changed-path filters\n+        run: git commit-graph write --reachable --changed-paths\n       - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n         with: { go-version: \"1.26.10\", cache: true, cache-dependency-path: pose-mcp/go.mod }\n       - name: Go tests (engine drift guard included)\n@@ -117,6 +123,12 @@ jobs:\n       # exactly this reason, reporting a governance defect that did not exist.\n       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n         with: { fetch-depth: 0 }\n+      # Governance reads ask Git for the last commit that touched each\n+      # artifact; on the full history each lookup walks it. The commit-graph\n+      # with changed-path filters answers from the filters (47 ms -> 2 ms a\n+      # lookup; spec pose-doctor-recommends-the-commit-graph).\n+      - name: Write the Git commit-graph with changed-path filters\n+        run: git commit-graph write --reachable --changed-paths\n       - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n         with: { go-version: \"1.26.10\", cache: true, cache-dependency-path: pose-mcp/go.mod }\n       - name: Build development pose binary\ndiff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex 966572c1..9d463bb3 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2419,10 +2419,24 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"git-snapshot-budget-scales-with-the-tree-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestGitSnapshotBudget|TestReviewWorktreeCleanup\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n+        {\n+          \"name\": \"doctor-recommends-the-commit-graph-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/cli\", \"-run\", \"TestDoctorRecommendsTheCommitGraph|TestDoctorCommitGraphReportsAnUnreadableHistory|TestDoctorCommitGraphTellsUnbornFromBroken|TestDoctorCommitGraphProbesALiteralPath|TestDoctorCommitGraphNamesDisabledReads\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"review-ledger-is-read-once-per-operation-integration\",\n           \"program\": \"go\",\n-          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestReviewLedgerIsReadOncePerOperation|TestReviewLedgerWithoutAnOperationIsReadEveryTime|TestReviewLedgerMemoAnswersAsAFreshRead|TestReviewLedgerMemoComputesOnceForConcurrentMisses|TestReviewLedgerMemoGivesIsolatedCopies|TestCopyReviewRunsCoversEveryUnexportedField\", \"-count=1\"],\n+          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestReviewLedgerIsReadOncePerOperation|TestReviewLedgerWithoutAnOperationIsReadEveryTime|TestReviewLedgerMemoAnswersAsAFreshRead|TestReviewLedgerMemoComputesOnceForConcurrentMisses|TestReviewLedgerMemoGivesIsolatedCopies|TestCopyReviewRunsCoversEveryUnexportedField|TestReviewLedgerMemoIsNotServedAfterTheOperationEnds|TestReviewLedgerMemoRefusalsStayVisible|TestReviewLedgerMemoAttributesEveryConsumingProducer\", \"-count=1\"],\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\ndiff --git a/pose-mcp/internal/cli/doctor.go b/pose-mcp/internal/cli/doctor.go\nindex d091206a..e7d32771 100644\n--- a/pose-mcp/internal/cli/doctor.go\n+++ b/pose-mcp/internal/cli/doctor.go\n@@ -9,6 +9,7 @@ import (\n \t\"bytes\"\n \t\"context\"\n \t\"encoding/json\"\n+\t\"errors\"\n \t\"fmt\"\n \t\"io\"\n \t\"io/fs\"\n@@ -89,6 +90,10 @@ var doctorFixRegistry = map[string]doctorFix{\n \t\t\treturn err\n \t\t},\n \t},\n+\t\"git.commit-graph\": {\n+\t\tdescribe: \"write the Git commit-graph with changed-path filters (git commit-graph write --reachable --changed-paths)\",\n+\t\tapply:    writeCommitGraph,\n+\t},\n \t\"skills.symlinks\": {\n \t\tdescribe: \"recreate .claude/skills symlinks\",\n \t\tapply: func(root string) error {\n@@ -355,6 +360,25 @@ func runDoctorDiagnostics(locale cliLocale) (root string, findings []doctorFindi\n \t\tadd(\"hooks.pre-commit\", \"ok\", text(\"pre-commit hook installed\", \"pre-commit instalado\"), \"\")\n \t}\n \n+\t// 7b. Git commit-graph. Governance reads ask Git for the last commit that\n+\t// touched each artifact; on a long history each lookup walks it, and a\n+\t// commit-graph with changed-path filters answers it from the filters\n+\t// (spec pose-doctor-recommends-the-commit-graph).\n+\tgraph, graphErr := readCommitGraphState(root)\n+\tswitch {\n+\tcase errors.Is(graphErr, errCommitGraphNotApplicable):\n+\tcase graphErr != nil:\n+\t\tadd(\"git.commit-graph\", \"warn\", text(\"Git commit-graph state could not be read: \"+graphErr.Error(), \"estado do commit-graph do Git não pôde ser lido: \"+graphErr.Error()), text(\"check that the repository and its object directory are readable\", \"confira se o repositório e o diretório de objetos podem ser lidos\"))\n+\tcase graph.commits < commitGraphHistoryThreshold:\n+\t\tadd(\"git.commit-graph\", \"ok\", text(fmt.Sprintf(\"history of %d commits does not need a commit-graph\", graph.commits), fmt.Sprintf(\"histórico de %d commits não precisa de commit-graph\", graph.commits)), \"\")\n+\tcase graph.readsDisabledBy != \"\":\n+\t\tadd(\"git.commit-graph-reads\", \"warn\", text(fmt.Sprintf(\"Git configuration %s keeps last-commit lookups over a history of %d commits from reading changed-path filters\", graph.readsDisabledBy, graph.commits), fmt.Sprintf(\"a configuração %s do Git impede que a busca do último commit, num histórico de %d commits, leia os filtros de caminhos alterados\", graph.readsDisabledBy, graph.commits)), text(\"unset that setting (git config --unset), then run 'git commit-graph write --reachable --changed-paths'\", \"remova essa configuração (git config --unset) e rode 'git commit-graph write --reachable --changed-paths'\"))\n+\tcase graph.filtersUsed:\n+\t\tadd(\"git.commit-graph\", \"ok\", text(\"Git answers last-commit lookups from changed-path filters\", \"o Git responde a busca do último commit pelos filtros de caminhos alterados\"), \"\")\n+\tdefault:\n+\t\tadd(\"git.commit-graph\", \"next\", text(fmt.Sprintf(\"history of %d commits is walked whole by each last-commit lookup: Git has no commit-graph with changed-path filters\", graph.commits), fmt.Sprintf(\"histórico de %d commits percorrido inteiro a cada busca do último commit: o Git não tem commit-graph com filtros de caminhos alterados\", graph.commits)), text(\"run 'git commit-graph write --reachable --changed-paths' (or 'pose doctor --fix --yes')\", \"rode 'git commit-graph write --reachable --changed-paths' (ou 'pose doctor --fix --yes')\"))\n+\t}\n+\n \t// 8. Delivery-integrity / artifact-contract policy roots (issue #17): a\n \t// v1.2.0 `pose install`/`pose update --force` could seed\n \t// .pose/policy/{delivery,artifacts}.json with roots copied verbatim from\ndiff --git a/pose-mcp/internal/cli/doctor_commit_graph.go b/pose-mcp/internal/cli/doctor_commit_graph.go\nnew file mode 100644\nindex 00000000..2f97e818\n--- /dev/null\n+++ b/pose-mcp/internal/cli/doctor_commit_graph.go\n@@ -0,0 +1,192 @@\n+package cli\n+\n+import (\n+\t\"bufio\"\n+\t\"bytes\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"strconv\"\n+\t\"strings\"\n+\n+\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n+)\n+\n+// commitGraphHistoryThreshold is the history size from which a last-commit\n+// lookup by path is worth accelerating: below it a history walk costs a few\n+// milliseconds (spec pose-doctor-recommends-the-commit-graph).\n+var commitGraphHistoryThreshold = 500\n+\n+// errCommitGraphNotApplicable marks a root the check does not apply to: not\n+// a Git repository, or a repository without a commit on HEAD.\n+var errCommitGraphNotApplicable = errors.New(\"not a Git repository with a commit on HEAD\")\n+\n+// commitGraphState is what doctor knows about a repository's commit-graph.\n+type commitGraphState struct {\n+\tcommits int\n+\t// filtersUsed is Git's own answer: a last-commit lookup by path read\n+\t// changed-path Bloom filters from the commit-graph it loaded.\n+\tfiltersUsed bool\n+\t// readsDisabledBy names the configuration that keeps Git from reading\n+\t// the filters, when the lookup used none.\n+\treadsDisabledBy string\n+}\n+\n+// readCommitGraphState counts HEAD's history and asks Git whether a\n+// last-commit lookup by path uses changed-path Bloom filters. Git reports the\n+// filters it consulted in its trace2 \"bloom\" statistics, so whichever graph it\n+// loads (the object directory's or an alternate's, a single file or a chain,\n+// of any version it accepts) is judged as Git itself uses it. It only reads.\n+func readCommitGraphState(root string) (commitGraphState, error) {\n+\t// Not a repository and an unborn HEAD are the only roots the check does\n+\t// not apply to; any other failure is reported (review F6).\n+\tif _, err := commitGraphGit(root, nil, \"rev-parse\", \"--git-dir\"); err != nil {\n+\t\tif strings.Contains(err.Error(), \"not a git repository\") {\n+\t\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n+\t\t}\n+\t\treturn commitGraphState{}, fmt.Errorf(\"repository could not be opened: %w\", err)\n+\t}\n+\t// An unborn HEAD names a branch that does not resolve; a HEAD that\n+\t// resolves to a commit Git cannot read is a failure.\n+\tif _, err := commitGraphGit(root, nil, \"rev-parse\", \"--verify\", \"--quiet\", \"HEAD\"); err != nil {\n+\t\tvar exit *exec.ExitError\n+\t\tif errors.As(err, &exit) && exit.ExitCode() == 1 {\n+\t\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n+\t\t}\n+\t\treturn commitGraphState{}, fmt.Errorf(\"HEAD could not be read: %w\", err)\n+\t}\n+\tif _, err := commitGraphGit(root, nil, \"rev-parse\", \"--verify\", \"HEAD^{commit}\"); err != nil {\n+\t\treturn commitGraphState{}, fmt.Errorf(\"HEAD could not be read: %w\", err)\n+\t}\n+\tcount, err := commitGraphGit(root, nil, \"rev-list\", \"--count\", \"HEAD\")\n+\tif err != nil {\n+\t\treturn commitGraphState{}, fmt.Errorf(\"history of HEAD could not be counted: %w\", err)\n+\t}\n+\tcommits, err := strconv.Atoi(strings.TrimSpace(count))\n+\tif err != nil {\n+\t\treturn commitGraphState{}, fmt.Errorf(\"history of HEAD could not be counted: %w\", err)\n+\t}\n+\tstate := commitGraphState{commits: commits}\n+\tif commits < commitGraphHistoryThreshold {\n+\t\treturn state, nil\n+\t}\n+\tlisting, err := commitGraphGit(root, nil, \"ls-tree\", \"-r\", \"--name-only\", \"-z\", \"HEAD\")\n+\tif err != nil {\n+\t\treturn state, fmt.Errorf(\"files of HEAD could not be listed: %w\", err)\n+\t}\n+\tpath, _, _ := strings.Cut(listing, \"\\x00\")\n+\tif path == \"\" {\n+\t\treturn state, nil\n+\t}\n+\ttrace, err := os.CreateTemp(\"\", \"pose-doctor-trace2-*.json\")\n+\tif err != nil {\n+\t\treturn state, fmt.Errorf(\"Git trace could not be created: %w\", err)\n+\t}\n+\ttracePath := trace.Name()\n+\ttrace.Close()\n+\tdefer os.Remove(tracePath)\n+\t// The path is literal: a name with pathspec magic must not change what\n+\t// Git looks up (review F7).\n+\tif _, err := commitGraphGit(root, []string{\"GIT_TRACE2_EVENT=\" + tracePath, \"GIT_LITERAL_PATHSPECS=1\"}, \"log\", \"-1\", \"--format=%H\", \"--\", path); err != nil {\n+\t\treturn state, fmt.Errorf(\"last commit of a file could not be read: %w\", err)\n+\t}\n+\traw, err := os.ReadFile(tracePath)\n+\tif err != nil {\n+\t\treturn state, fmt.Errorf(\"Git trace could not be read: %w\", err)\n+\t}\n+\tstate.filtersUsed = traceUsedBloomFilters(raw)\n+\tif !state.filtersUsed {\n+\t\tstate.readsDisabledBy = commitGraphReadsDisabledBy(root)\n+\t}\n+\treturn state, nil\n+}\n+\n+// commitGraphReadsDisabledBy names the configuration that keeps Git from\n+// reading a commit-graph or its changed-path filters, or \"\" when none does:\n+// with it set, writing the graph cannot change the answer (review F8).\n+func commitGraphReadsDisabledBy(root string) string {\n+\tget := func(kind, key string) (string, bool) {\n+\t\tout, err := commitGraphGit(root, nil, \"config\", \"--type=\"+kind, \"--get\", key)\n+\t\tvalue := strings.TrimSpace(out)\n+\t\treturn value, err == nil && value != \"\"\n+\t}\n+\tif value, ok := get(\"bool\", \"core.commitGraph\"); ok && value == \"false\" {\n+\t\treturn \"core.commitGraph=false\"\n+\t}\n+\tif value, ok := get(\"bool\", \"commitGraph.readChangedPaths\"); ok && value == \"false\" {\n+\t\treturn \"commitGraph.readChangedPaths=false\"\n+\t}\n+\tif value, ok := get(\"int\", \"commitGraph.changedPathsVersion\"); ok && value == \"0\" {\n+\t\treturn \"commitGraph.changedPathsVersion=0\"\n+\t}\n+\treturn \"\"\n+}\n+\n+// traceUsedBloomFilters reports whether a trace2 event stream carries a\n+// \"bloom\" statistics event in which some filter answered a lookup.\n+func traceUsedBloomFilters(raw []byte) bool {\n+\tscanner := bufio.NewScanner(bytes.NewReader(raw))\n+\tscanner.Buffer(make([]byte, 0, 64<<10), 1<<20)\n+\tfor scanner.Scan() {\n+\t\tvar event struct {\n+\t\t\tCategory string `json:\"category\"`\n+\t\t\tKey      string `json:\"key\"`\n+\t\t\tValue    struct {\n+\t\t\t\tMaybe         int `json:\"maybe\"`\n+\t\t\t\tDefinitelyNot int `json:\"definitely_not\"`\n+\t\t\t} `json:\"value\"`\n+\t\t}\n+\t\tif json.Unmarshal(scanner.Bytes(), &event) != nil {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif event.Category == \"bloom\" && event.Key == \"statistics\" && event.Value.Maybe+event.Value.DefinitelyNot > 0 {\n+\t\t\treturn true\n+\t\t}\n+\t}\n+\treturn false\n+}\n+\n+// writeCommitGraph writes the repository's commit-graph with changed-path\n+// Bloom filters; it only writes under the Git object directory.\n+func writeCommitGraph(root string) error {\n+\t_, err := commitGraphGit(root, nil, \"commit-graph\", \"write\", \"--reachable\", \"--changed-paths\")\n+\treturn err\n+}\n+\n+// commitGraphGit runs Git in root with extra environment and returns its\n+// output; a failure carries Git's stderr, bounded.\n+func commitGraphGit(root string, env []string, args ...string) (string, error) {\n+\tcmd := posemodel.RawHistoryGit(root, args...)\n+\t// Git's messages are read below; they are read in the C locale.\n+\tcmd.Env = append(append(cmd.Env, \"LC_ALL=C\", \"LANGUAGE=C\"), env...)\n+\tvar stderr bytes.Buffer\n+\tcmd.Stderr = &stderr\n+\tout, err := cmd.Output()\n+\tif err != nil {\n+\t\tdetail := strings.TrimSpace(stderr.String())\n+\t\tif len(detail) > 200 {\n+\t\t\tdetail = detail[:200] + \"…\"\n+\t\t}\n+\t\treturn string(out), &commitGraphGitError{args: args[0], err: err, detail: detail}\n+\t}\n+\treturn string(out), nil\n+}\n+\n+// commitGraphGitError is a failed Git command with its stderr, bounded; it\n+// unwraps to the command's error, an *exec.ExitError when Git ran.\n+type commitGraphGitError struct {\n+\targs   string\n+\terr    error\n+\tdetail string\n+}\n+\n+func (e *commitGraphGitError) Error() string {\n+\tif e.detail == \"\" {\n+\t\treturn \"git \" + e.args + \" \" + e.err.Error()\n+\t}\n+\treturn \"git \" + e.args + \": \" + e.err.Error() + \" \" + e.detail\n+}\n+\n+func (e *commitGraphGitError) Unwrap() error { return e.err }\nAGENTS.md\nlocales/pt-BR/AGENTS.md\npose-mcp/internal/scaffold/dist/AGENTS.md\npose-mcp/internal/scaffold/dist/locales/pt-BR/AGENTS.md\npose-mcp/internal/cli/doctor_commit_graph.go\npose-mcp/internal/cli/doctor_commit_graph_test.go\n","exit_code":0,"status":"completed"}}
