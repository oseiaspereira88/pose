{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc \"rg --files .pose/specs | rg 'doctor-recommends'; rg --files -g AGENTS.md; nl -ba pose-mcp/internal/cli/doctor_commit_graph.go; sed -n '355,405p' pose-mcp/internal/cli/doctor.go; rg -n '\"'^func Test'\"' pose-mcp/internal/cli/doctor_commit_graph_test.go\"","aggregated_output":".pose/specs/2026-11-16-pose-doctor-recommends-the-commit-graph.md\nlocales/pt-BR/AGENTS.md\nAGENTS.md\npose-mcp/internal/scaffold/dist/AGENTS.md\npose-mcp/internal/scaffold/dist/locales/pt-BR/AGENTS.md\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bufio\"\n     5\t\t\"bytes\"\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"strconv\"\n    12\t\t\"strings\"\n    13\t\n    14\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    15\t)\n    16\t\n    17\t// commitGraphHistoryThreshold is the history size from which a last-commit\n    18\t// lookup by path is worth accelerating: below it a history walk costs a few\n    19\t// milliseconds (spec pose-doctor-recommends-the-commit-graph).\n    20\tvar commitGraphHistoryThreshold = 500\n    21\t\n    22\t// errCommitGraphNotApplicable marks a root the check does not apply to: not\n    23\t// a Git repository, or a repository without a commit on HEAD.\n    24\tvar errCommitGraphNotApplicable = errors.New(\"not a Git repository with a commit on HEAD\")\n    25\t\n    26\t// commitGraphState is what doctor knows about a repository's commit-graph.\n    27\ttype commitGraphState struct {\n    28\t\tcommits int\n    29\t\t// filtersUsed is Git's own answer: a last-commit lookup by path read\n    30\t\t// changed-path Bloom filters from the commit-graph it loaded.\n    31\t\tfiltersUsed bool\n    32\t\t// readsDisabledBy names the configuration that keeps Git from reading\n    33\t\t// the filters, when the lookup used none.\n    34\t\treadsDisabledBy string\n    35\t}\n    36\t\n    37\t// readCommitGraphState counts HEAD's history and asks Git whether a\n    38\t// last-commit lookup by path uses changed-path Bloom filters. Git reports the\n    39\t// filters it consulted in its trace2 \"bloom\" statistics, so whichever graph it\n    40\t// loads (the object directory's or an alternate's, a single file or a chain,\n    41\t// of any version it accepts) is judged as Git itself uses it. It only reads.\n    42\tfunc readCommitGraphState(root string) (commitGraphState, error) {\n    43\t\t// Not a repository and an unborn HEAD are the only roots the check does\n    44\t\t// not apply to; any other failure is reported (review F6).\n    45\t\tif _, err := commitGraphGit(root, nil, \"rev-parse\", \"--git-dir\"); err != nil {\n    46\t\t\tif strings.Contains(err.Error(), \"not a git repository\") {\n    47\t\t\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n    48\t\t\t}\n    49\t\t\treturn commitGraphState{}, fmt.Errorf(\"repository could not be opened: %w\", err)\n    50\t\t}\n    51\t\t// An unborn HEAD names a branch that does not resolve; a HEAD that\n    52\t\t// resolves to a commit Git cannot read is a failure.\n    53\t\tif _, err := commitGraphGit(root, nil, \"rev-parse\", \"--verify\", \"--quiet\", \"HEAD\"); err != nil {\n    54\t\t\tvar exit *exec.ExitError\n    55\t\t\tif errors.As(err, &exit) && exit.ExitCode() == 1 {\n    56\t\t\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n    57\t\t\t}\n    58\t\t\treturn commitGraphState{}, fmt.Errorf(\"HEAD could not be read: %w\", err)\n    59\t\t}\n    60\t\tif _, err := commitGraphGit(root, nil, \"rev-parse\", \"--verify\", \"HEAD^{commit}\"); err != nil {\n    61\t\t\treturn commitGraphState{}, fmt.Errorf(\"HEAD could not be read: %w\", err)\n    62\t\t}\n    63\t\tcount, err := commitGraphGit(root, nil, \"rev-list\", \"--count\", \"HEAD\")\n    64\t\tif err != nil {\n    65\t\t\treturn commitGraphState{}, fmt.Errorf(\"history of HEAD could not be counted: %w\", err)\n    66\t\t}\n    67\t\tcommits, err := strconv.Atoi(strings.TrimSpace(count))\n    68\t\tif err != nil {\n    69\t\t\treturn commitGraphState{}, fmt.Errorf(\"history of HEAD could not be counted: %w\", err)\n    70\t\t}\n    71\t\tstate := commitGraphState{commits: commits}\n    72\t\tif commits < commitGraphHistoryThreshold {\n    73\t\t\treturn state, nil\n    74\t\t}\n    75\t\tlisting, err := commitGraphGit(root, nil, \"ls-tree\", \"-r\", \"--name-only\", \"-z\", \"HEAD\")\n    76\t\tif err != nil {\n    77\t\t\treturn state, fmt.Errorf(\"files of HEAD could not be listed: %w\", err)\n    78\t\t}\n    79\t\tpath, _, _ := strings.Cut(listing, \"\\x00\")\n    80\t\tif path == \"\" {\n    81\t\t\treturn state, nil\n    82\t\t}\n    83\t\ttrace, err := os.CreateTemp(\"\", \"pose-doctor-trace2-*.json\")\n    84\t\tif err != nil {\n    85\t\t\treturn state, fmt.Errorf(\"Git trace could not be created: %w\", err)\n    86\t\t}\n    87\t\ttracePath := trace.Name()\n    88\t\ttrace.Close()\n    89\t\tdefer os.Remove(tracePath)\n    90\t\t// The path is literal: a name with pathspec magic must not change what\n    91\t\t// Git looks up (review F7).\n    92\t\tif _, err := commitGraphGit(root, []string{\"GIT_TRACE2_EVENT=\" + tracePath, \"GIT_LITERAL_PATHSPECS=1\"}, \"log\", \"-1\", \"--format=%H\", \"--\", path); err != nil {\n    93\t\t\treturn state, fmt.Errorf(\"last commit of a file could not be read: %w\", err)\n    94\t\t}\n    95\t\traw, err := os.ReadFile(tracePath)\n    96\t\tif err != nil {\n    97\t\t\treturn state, fmt.Errorf(\"Git trace could not be read: %w\", err)\n    98\t\t}\n    99\t\tstate.filtersUsed = traceUsedBloomFilters(raw)\n   100\t\tif !state.filtersUsed {\n   101\t\t\tstate.readsDisabledBy = commitGraphReadsDisabledBy(root)\n   102\t\t}\n   103\t\treturn state, nil\n   104\t}\n   105\t\n   106\t// commitGraphReadsDisabledBy names the configuration that keeps Git from\n   107\t// reading a commit-graph or its changed-path filters, or \"\" when none does:\n   108\t// with it set, writing the graph cannot change the answer (review F8).\n   109\tfunc commitGraphReadsDisabledBy(root string) string {\n   110\t\tget := func(kind, key string) (string, bool) {\n   111\t\t\tout, err := commitGraphGit(root, nil, \"config\", \"--type=\"+kind, \"--get\", key)\n   112\t\t\tvalue := strings.TrimSpace(out)\n   113\t\t\treturn value, err == nil && value != \"\"\n   114\t\t}\n   115\t\tif value, ok := get(\"bool\", \"core.commitGraph\"); ok && value == \"false\" {\n   116\t\t\treturn \"core.commitGraph=false\"\n   117\t\t}\n   118\t\tif value, ok := get(\"bool\", \"commitGraph.readChangedPaths\"); ok && value == \"false\" {\n   119\t\t\treturn \"commitGraph.readChangedPaths=false\"\n   120\t\t}\n   121\t\tif value, ok := get(\"int\", \"commitGraph.changedPathsVersion\"); ok && value == \"0\" {\n   122\t\t\treturn \"commitGraph.changedPathsVersion=0\"\n   123\t\t}\n   124\t\treturn \"\"\n   125\t}\n   126\t\n   127\t// traceUsedBloomFilters reports whether a trace2 event stream carries a\n   128\t// \"bloom\" statistics event in which some filter answered a lookup.\n   129\tfunc traceUsedBloomFilters(raw []byte) bool {\n   130\t\tscanner := bufio.NewScanner(bytes.NewReader(raw))\n   131\t\tscanner.Buffer(make([]byte, 0, 64<<10), 1<<20)\n   132\t\tfor scanner.Scan() {\n   133\t\t\tvar event struct {\n   134\t\t\t\tCategory string `json:\"category\"`\n   135\t\t\t\tKey      string `json:\"key\"`\n   136\t\t\t\tValue    struct {\n   137\t\t\t\t\tMaybe         int `json:\"maybe\"`\n   138\t\t\t\t\tDefinitelyNot int `json:\"definitely_not\"`\n   139\t\t\t\t} `json:\"value\"`\n   140\t\t\t}\n   141\t\t\tif json.Unmarshal(scanner.Bytes(), &event) != nil {\n   142\t\t\t\tcontinue\n   143\t\t\t}\n   144\t\t\tif event.Category == \"bloom\" && event.Key == \"statistics\" && event.Value.Maybe+event.Value.DefinitelyNot > 0 {\n   145\t\t\t\treturn true\n   146\t\t\t}\n   147\t\t}\n   148\t\treturn false\n   149\t}\n   150\t\n   151\t// writeCommitGraph writes the repository's commit-graph with changed-path\n   152\t// Bloom filters; it only writes under the Git object directory.\n   153\tfunc writeCommitGraph(root string) error {\n   154\t\t_, err := commitGraphGit(root, nil, \"commit-graph\", \"write\", \"--reachable\", \"--changed-paths\")\n   155\t\treturn err\n   156\t}\n   157\t\n   158\t// commitGraphGit runs Git in root with extra environment and returns its\n   159\t// output; a failure carries Git's stderr, bounded.\n   160\tfunc commitGraphGit(root string, env []string, args ...string) (string, error) {\n   161\t\tcmd := posemodel.RawHistoryGit(root, args...)\n   162\t\t// Git's messages are read below; they are read in the C locale.\n   163\t\tcmd.Env = append(append(cmd.Env, \"LC_ALL=C\", \"LANGUAGE=C\"), env...)\n   164\t\tvar stderr bytes.Buffer\n   165\t\tcmd.Stderr = &stderr\n   166\t\tout, err := cmd.Output()\n   167\t\tif err != nil {\n   168\t\t\tdetail := strings.TrimSpace(stderr.String())\n   169\t\t\tif len(detail) > 200 {\n   170\t\t\t\tdetail = detail[:200] + \"…\"\n   171\t\t\t}\n   172\t\t\treturn string(out), &commitGraphGitError{args: args[0], err: err, detail: detail}\n   173\t\t}\n   174\t\treturn string(out), nil\n   175\t}\n   176\t\n   177\t// commitGraphGitError is a failed Git command with its stderr, bounded; it\n   178\t// unwraps to the command's error, an *exec.ExitError when Git ran.\n   179\ttype commitGraphGitError struct {\n   180\t\targs   string\n   181\t\terr    error\n   182\t\tdetail string\n   183\t}\n   184\t\n   185\tfunc (e *commitGraphGitError) Error() string {\n   186\t\tif e.detail == \"\" {\n   187\t\t\treturn \"git \" + e.args + \" \" + e.err.Error()\n   188\t\t}\n   189\t\treturn \"git \" + e.args + \": \" + e.err.Error() + \" \" + e.detail\n   190\t}\n   191\t\n   192\tfunc (e *commitGraphGitError) Unwrap() error { return e.err }\n\tif _, err := os.Lstat(hook); err != nil {\n\t\t// A recommended step, not a problem: a fresh install reports it as next\n\t\t// (spec pose-fresh-install-doctor-is-clean).\n\t\tadd(\"hooks.pre-commit\", \"next\", text(\"pre-commit hook not installed\", \"pre-commit não instalado\"), text(\"run 'pose hooks install' (or 'pose doctor --fix --yes') for an automatic commit gate\", \"rode 'pose hooks install' (ou 'pose doctor --fix --yes') para gate automático no commit\"))\n\t} else {\n\t\tadd(\"hooks.pre-commit\", \"ok\", text(\"pre-commit hook installed\", \"pre-commit instalado\"), \"\")\n\t}\n\n\t// 7b. Git commit-graph. Governance reads ask Git for the last commit that\n\t// touched each artifact; on a long history each lookup walks it, and a\n\t// commit-graph with changed-path filters answers it from the filters\n\t// (spec pose-doctor-recommends-the-commit-graph).\n\tgraph, graphErr := readCommitGraphState(root)\n\tswitch {\n\tcase errors.Is(graphErr, errCommitGraphNotApplicable):\n\tcase graphErr != nil:\n\t\tadd(\"git.commit-graph\", \"warn\", text(\"Git commit-graph state could not be read: \"+graphErr.Error(), \"estado do commit-graph do Git não pôde ser lido: \"+graphErr.Error()), text(\"check that the repository and its object directory are readable\", \"confira se o repositório e o diretório de objetos podem ser lidos\"))\n\tcase graph.commits < commitGraphHistoryThreshold:\n\t\tadd(\"git.commit-graph\", \"ok\", text(fmt.Sprintf(\"history of %d commits does not need a commit-graph\", graph.commits), fmt.Sprintf(\"histórico de %d commits não precisa de commit-graph\", graph.commits)), \"\")\n\tcase graph.readsDisabledBy != \"\":\n\t\tadd(\"git.commit-graph-reads\", \"warn\", text(fmt.Sprintf(\"Git configuration %s keeps last-commit lookups over a history of %d commits from reading changed-path filters\", graph.readsDisabledBy, graph.commits), fmt.Sprintf(\"a configuração %s do Git impede que a busca do último commit, num histórico de %d commits, leia os filtros de caminhos alterados\", graph.readsDisabledBy, graph.commits)), text(\"unset that setting (git config --unset), then run 'git commit-graph write --reachable --changed-paths'\", \"remova essa configuração (git config --unset) e rode 'git commit-graph write --reachable --changed-paths'\"))\n\tcase graph.filtersUsed:\n\t\tadd(\"git.commit-graph\", \"ok\", text(\"Git answers last-commit lookups from changed-path filters\", \"o Git responde a busca do último commit pelos filtros de caminhos alterados\"), \"\")\n\tdefault:\n\t\tadd(\"git.commit-graph\", \"next\", text(fmt.Sprintf(\"history of %d commits is walked whole by each last-commit lookup: Git has no commit-graph with changed-path filters\", graph.commits), fmt.Sprintf(\"histórico de %d commits percorrido inteiro a cada busca do último commit: o Git não tem commit-graph com filtros de caminhos alterados\", graph.commits)), text(\"run 'git commit-graph write --reachable --changed-paths' (or 'pose doctor --fix --yes')\", \"rode 'git commit-graph write --reachable --changed-paths' (ou 'pose doctor --fix --yes')\"))\n\t}\n\n\t// 8. Delivery-integrity / artifact-contract policy roots (issue #17): a\n\t// v1.2.0 `pose install`/`pose update --force` could seed\n\t// .pose/policy/{delivery,artifacts}.json with roots copied verbatim from\n\t// pose-mcp's own source tree (fixed at the source in\n\t// internal/scaffold/distpolicy — see NeutralPolicyTemplates). An instance\n\t// that already seeded those files before the fix keeps the contaminated\n\t// content — `pose install`/`update` never overwrite an existing policy\n\t// file — so detect it here instead of relying on a fresh\n\t// install/update to self-heal.\n\tif dp, err := posemodel.LoadDeliveryPolicy(root); err == nil && dp.Enabled && len(dp.Roots) > 0 {\n\t\tvar missing []string\n\t\tfor _, r := range dp.Roots {\n\t\t\tif _, err := os.Stat(filepath.Join(root, filepath.FromSlash(r.Path))); err != nil {\n\t\t\t\tmissing = append(missing, r.Path)\n\t\t\t}\n\t\t}\n\t\tif len(missing) == len(dp.Roots) {\n\t\t\tadd(\"policy.delivery-roots\", \"warn\",\n\t\t\t\tfmt.Sprintf(text(\"delivery policy roots do not exist in this project: %s\", \"raízes da política de entrega não existem neste projeto: %s\"), strings.Join(missing, \", \")),\n\t\t\t\ttext(\"check .pose/policy/delivery.json — roots may have been inherited from a contaminated pose-mcp v1.2.0 template (github.com/oseiaspereira88/pose issue #17); replace with this project's own module paths\",\n\t\t\t\t\t\".pose/policy/delivery.json — as roots podem ter vindo de um template pose-mcp v1.2.0 contaminado (issue #17); substitua pelos caminhos reais deste projeto\"))\n\t\t} else {\n\t\t\tadd(\"policy.delivery-roots\", \"ok\", text(\"delivery policy roots resolve in this project\", \"raízes da política de entrega resolvem neste projeto\"), \"\")\n\t\t}\n57:func TestDoctorRecommendsTheCommitGraph(t *testing.T) {\n125:func TestDoctorCommitGraphReportsAnUnreadableHistory(t *testing.T) {\n177:func TestDoctorCommitGraphTellsUnbornFromBroken(t *testing.T) {\n205:func TestDoctorCommitGraphProbesALiteralPath(t *testing.T) {\n225:func TestDoctorCommitGraphNamesDisabledReads(t *testing.T) {\n","exit_code":0,"status":"completed"}}
