n ...1-16-pose-doctor-recommends-the-commit-graph.md |  161 +\n ...ose-git-snapshot-budget-scales-with-the-tree.md |  157 +\n ...ose-review-ledger-is-read-once-per-operation.md |   14 +-\n .../pose-doctor-recommends-the-commit-graph.json   |   57 +\n ...e-git-snapshot-budget-scales-with-the-tree.json |   50 +\n .pose/state/components/docs-site.json              |    6 +-\n .pose/state/components/mcp-enforce.json            |    6 +-\n .pose/state/components/pose-mcp.json               |   14 +-\n .pose/state/project-state.md                       |    4 +-\n pose-mcp/internal/cli/doctor.go                    |   24 +\n pose-mcp/internal/cli/doctor_commit_graph.go       |  192 +\n pose-mcp/internal/cli/doctor_commit_graph_test.go  |  248 +\n pose-mcp/internal/pose/git_snapshot_budget_test.go |  157 +\n pose-mcp/internal/pose/git_snapshot_integrity.go   |   65 +-\n .../internal/pose/review_adapter_containment.go    |   20 +-\n pose-mcp/internal/pose/review_dispatch.go          |    6 +-\n pose-mcp/internal/pose/review_ledger_memo.go       |   17 +-\n pose-mcp/internal/pose/review_ledger_memo_test.go  |   82 +\n pose-mcp/internal/pose/review_operation_view.go    |    8 +-\n 113 files changed, 41493 insertions(+), 3961 deletions(-)\n.pose/review-runs/rrn-f0d738ef7de4226e.transcript:21:{\"type\":\"item.started\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/usr/bin/bash -lc \\\"rg -n 'func RawHistoryGit' pose-mcp; nl -ba pose-mcp/internal/cli/doctor_commit_graph.go | sed -n '40,195p'; sed -n '140,220p' pose-mcp/internal/cli/doctor.go; git --version; git ls-tree -r --name-only HEAD | head -3; rg -n 'SD-9fc0fe4e|SD-d29398e6' .pose/review-bundles/rvb-* | tail -8\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n.pose/review-runs/rrn-f0d738ef7de4226e.transcript:22:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/usr/bin/bash -lc \\\"rg -n 'func RawHistoryGit' pose-mcp; nl -ba pose-mcp/internal/cli/doctor_commit_graph.go | sed -n '40,195p'; sed -n '140,220p' pose-mcp/internal/cli/doctor.go; git --version; git ls-tree -r --name-only HEAD | head -3; rg -n 'SD-9fc0fe4e|SD-d29398e6' .pose/review-bundles/rvb-* | tail -8\\\"\",\"aggregated_output\":\"pose-mcp/internal/pose/spec_trailers.go:75:func RawHistoryGit(root string, args ...string) *exec.Cmd {\\npose-mcp/internal/pose/spec_trailers.go:80:func RawHistoryGitContext(ctx context.Context, root string, args ...string) *exec.Cmd {\\n    40\\t// loads (the object directory's or an alternate's, a single file or a chain,\\n    41\\t// of any version it accepts) is judged as Git itself uses it. It only reads.\\n    42\\tfunc readCommitGraphState(root string) (commitGraphState, error) {\\n    43\\t\\t// Not a repository and an unborn HEAD are the only roots the check does\\n    44\\t\\t// not apply to; any other failure is reported (review F6).\\n    45\\t\\tif _, err := commitGraphGit(root, nil, \\\"rev-parse\\\", \\\"--git-dir\\\"); err != nil {\\n    46\\t\\t\\tif strings.Contains(err.Error(), \\\"not a git repository\\\") {\\n    47\\t\\t\\t\\treturn commitGraphState{}, errCommitGraphNotApplicable\\n    48\\t\\t\\t}\\n    49\\t\\t\\treturn commitGraphState{}, fmt.Errorf(\\\"repository could not be opened: %w\\\", err)\\n    50\\t\\t}\\n    51\\t\\t// An unborn HEAD names a branch that does not resolve; a HEAD that\\n    52\\t\\t// resolves to a commit Git cannot read is a failure.\\n    53\\t\\tif _, err := commitGraphGit(root, nil, \\\"rev-parse\\\", \\\"--verify\\\", \\\"--quiet\\\", \\\"HEAD\\\"); err != nil {\\n    54\\t\\t\\tvar exit *exec.ExitError\\n    55\\t\\t\\tif errors.As(err, &exit) && exit.ExitCode() == 1 {\\n    56\\t\\t\\t\\treturn commitGraphState{}, errCommitGraphNotApplicable\\n    57\\t\\t\\t}\\n    58\\t\\t\\treturn commitGraphState{}, fmt.Errorf(\\\"HEAD could not be read: %w\\\", err)\\n    59\\t\\t}\\n    60\\t\\tif _, err := commitGraphGit(root, nil, \\\"rev-parse\\\", \\\"--verify\\\", \\\"HEAD^{commit}\\\"); err != nil {\\n    61\\t\\t\\treturn commitGraphState{}, fmt.Errorf(\\\"HEAD could not be read: %w\\\", err)\\n    62\\t\\t}\\n    63\\t\\tcount, err := commitGraphGit(root, nil, \\\"rev-list\\\", \\\"--count\\\", \\\"HEAD\\\")\\n    64\\t\\tif err != nil {\\n    65\\t\\t\\treturn commitGraphState{}, fmt.Errorf(\\\"history of HEAD could not be counted: %w\\\", err)\\n    66\\t\\t}\\n    67\\t\\tcommits, err := strconv.Atoi(strings.TrimSpace(count))\\n    68\\t\\tif err != nil {\\n    69\\t\\t\\treturn commitGraphState{}, fmt.Errorf(\\\"history of HEAD could not be counted: %w\\\", err)\\n    70\\t\\t}\\n    71\\t\\tstate := commitGraphState{commits: commits}\\n    72\\t\\tif commits < commitGraphHistoryThreshold {\\n    73\\t\\t\\treturn state, nil\\n    74\\t\\t}\\n    75\\t\\tlisting, err := commitGraphGit(root, nil, \\\"ls-tree\\\", \\\"-r\\\", \\\"--name-only\\\", \\\"-z\\\", \\\"HEAD\\\")\\n    76\\t\\tif err != nil {\\n    77\\t\\t\\treturn state, fmt.Errorf(\\\"files of HEAD could not be listed: %w\\\", err)\\n    78\\t\\t}\\n    79\\t\\tpath, _, _ := strings.Cut(listing, \\\"\\\\x00\\\")\\n    80\\t\\tif path == \\\"\\\" {\\n    81\\t\\t\\treturn state, nil\\n    82\\t\\t}\\n    83\\t\\ttrace, err := os.CreateTemp(\\\"\\\", \\\"pose-doctor-trace2-*.json\\\")\\n    84\\t\\tif err != nil {\\n    85\\t\\t\\treturn state, fmt.Errorf(\\\"Git trace could not be created: %w\\\", err)\\n    86\\t\\t}\\n    87\\t\\ttracePath := trace.Name()\\n    88\\t\\ttrace.Close()\\n    89\\t\\tdefer os.Remove(tracePath)\\n    90\\t\\t// The path is literal: a name with pathspec magic must not change what\\n    91\\t\\t// Git looks up (review F7).\\n    92\\t\\tif _, err := commitGraphGit(root, []string{\\\"GIT_TRACE2_EVENT=\\\" + tracePath, \\\"GIT_LITERAL_PATHSPECS=1\\\"}, \\\"log\\\", \\\"-1\\\", \\\"--format=%H\\\", \\\"--\\\", path); err != nil {\\n    93\\t\\t\\treturn state, fmt.Errorf(\\\"last commit of a file could not be read: %w\\\", err)\\n    94\\t\\t}\\n    95\\t\\traw, err := os.ReadFile(tracePath)\\n    96\\t\\tif err != nil {\\n    97\\t\\t\\treturn state, fmt.Errorf(\\\"Git trace could not be read: %w\\\", err)\\n    98\\t\\t}\\n    99\\t\\tstate.filtersUsed = traceUsedBloomFilters(raw)\\n   100\\t\\tif !state.filtersUsed {\\n   101\\t\\t\\tstate.readsDisabledBy = commitGraphReadsDisabledBy(root)\\n   102\\t\\t}\\n   103\\t\\treturn state, nil\\n   104\\t}\\n   105\\t\\n   106\\t// commitGraphReadsDisabledBy names the configuration that keeps Git from\\n   107\\t// reading a commit-graph or its changed-path filters, or \\\"\\\" when none does:\\n   108\\t// with it set, writing the graph cannot change the answer (review F8).\\n   109\\tfunc commitGraphReadsDisabledBy(root string) string {\\n   110\\t\\tget := func(kind, key string) (string, bool) {\\n   111\\t\\t\\tout, err := commitGraphGit(root, nil, \\\"config\\\", \\\"--type=\\\"+kind, \\\"--get\\\", key)\\n   112\\t\\t\\tvalue := strings.TrimSpace(out)\\n   113\\t\\t\\treturn value, err == nil && value != \\\"\\\"\\n   114\\t\\t}\\n   115\\t\\tif value, ok := get(\\\"bool\\\", \\\"core.commitGraph\\\"); ok && value == \\\"false\\\" {\\n   116\\t\\t\\treturn \\\"core.commitGraph=false\\\"\\n   117\\t\\t}\\n   118\\t\\tif value, ok := get(\\\"bool\\\", \\\"commitGraph.readChangedPaths\\\"); ok && value == \\\"false\\\" {\\n   119\\t\\t\\treturn \\\"commitGraph.readChangedPaths=false\\\"\\n   120\\t\\t}\\n   121\\t\\tif value, ok := get(\\\"int\\\", \\\"commitGraph.changedPathsVersion\\\"); ok && value == \\\"0\\\" {\\n   122\\t\\t\\treturn \\\"commitGraph.changedPathsVersion=0\\\"\\n   123\\t\\t}\\n   124\\t\\treturn \\\"\\\"\\n   125\\t}\\n   126\\t\\n   127\\t// traceUsedBloomFilters reports whether a trace2 event stream carries a\\n   128\\t// \\\"bloom\\\" statistics event in which some filter answered a lookup.\\n   129\\tfunc traceUsedBloomFilters(raw []byte) bool {\\n   130\\t\\tscanner := bufio.NewScanner(bytes.NewReader(raw))\\n   131\\t\\tscanner.Buffer(make([]byte, 0, 64<<10), 1<<20)\\n   132\\t\\tfor scanner.Scan() {\\n   133\\t\\t\\tvar event struct {\\n   134\\t\\t\\t\\tCategory string `json:\\\"category\\\"`\\n   135\\t\\t\\t\\tKey      string `json:\\\"key\\\"`\\n   136\\t\\t\\t\\tValue    struct {\\n   137\\t\\t\\t\\t\\tMaybe         int `json:\\\"maybe\\\"`\\n   138\\t\\t\\t\\t\\tDefinitelyNot int `json:\\\"definitely_not\\\"`\\n   139\\t\\t\\t\\t} `json:\\\"value\\\"`\\n   140\\t\\t\\t}\\n   141\\t\\t\\tif json.Unmarshal(scanner.Bytes(), &event) != nil {\\n   142\\t\\t\\t\\tcontinue\\n   143\\t\\t\\t}\\n   144\\t\\t\\tif event.Category == \\\"bloom\\\" && event.Key == \\\"statistics\\\" && event.Value.Maybe+event.Value.DefinitelyNot > 0 {\\n   145\\t\\t\\t\\treturn true\\n   146\\t\\t\\t}\\n   147\\t\\t}\\n   148\\t\\treturn false\\n   149\\t}\\n   150\\t\\n   151\\t// writeCommitGraph writes the repository's commit-graph with changed-path\\n   152\\t// Bloom filters; it only writes under the Git object directory.\\n   153\\tfunc writeCommitGraph(root string) error {\\n   154\\t\\t_, err := commitGraphGit(root, nil, \\\"commit-graph\\\", \\\"write\\\", \\\"--reachable\\\", \\\"--changed-paths\\\")\\n   155\\t\\treturn err\\n   156\\t}\\n   157\\t\\n   158\\t// commitGraphGit runs Git in root with extra environment and returns its\\n   159\\t// output; a failure carries Git's stderr, bounded.\\n   160\\tfunc commitGraphGit(root string, env []string, args ...string) (string, error) {\\n   161\\t\\tcmd := posemodel.RawHistoryGit(root, args...)\\n   162\\t\\t// Git's messages are read below; they are read in the C locale.\\n   163\\t\\tcmd.Env = append(append(cmd.Env, \\\"LC_ALL=C\\\", \\\"LANGUAGE=C\\\"), env...)\\n   164\\t\\tvar stderr bytes.Buffer\\n   165\\t\\tcmd.Stderr = &stderr\\n   166\\t\\tout, err := cmd.Output()\\n   167\\t\\tif err != nil {\\n   168\\t\\t\\tdetail := strings.TrimSpace(stderr.String())\\n   169\\t\\t\\tif len(detail) > 200 {\\n   170\\t\\t\\t\\tdetail = detail[:200] + \\\"…\\\"\\n   171\\t\\t\\t}\\n   172\\t\\t\\treturn string(out), &commitGraphGitError{args: args[0], err: err, detail: detail}\\n   173\\t\\t}\\n   174\\t\\treturn string(out), nil\\n   175\\t}\\n   176\\t\\n   177\\t// commitGraphGitError is a failed Git command with its stderr, bounded; it\\n   178\\t// unwraps to the command's error, an *exec.ExitError when Git ran.\\n   179\\ttype commitGraphGitError struct {\\n   180\\t\\targs   string\\n   181\\t\\terr    error\\n   182\\t\\tdetail string\\n   183\\t}\\n   184\\t\\n   185\\tfunc (e *commitGraphGitError) Error() string {\\n   186\\t\\tif e.detail == \\\"\\\" {\\n   187\\t\\t\\treturn \\\"git \\\" + e.args + \\\" \\\" + e.err.Error()\\n   188\\t\\t}\\n   189\\t\\treturn \\\"git \\\" + e.args + \\\": \\\" + e.err.Error() + \\\" \\\" + e.detail\\n   190\\t}\\n   191\\t\\n   192\\tfunc (e *commitGraphGitError) Unwrap() error { return e.err }\\n\\nfunc cmdDoctor(args []string, stdout, stderr io.Writer) int {\\n\\tlocale := cliLocaleValue()\\n\\ttext := func(english, portuguese string) string { return cliText(locale, english, portuguese) }\\n\\tjsonOut, fix, yes := false, false, false\\n\\tonly := \\\"\\\"\\n\\tfor i := 0; i < len(args); i++ {\\n\\t\\ta := args[i]\\n\\t\\tswitch a {\\n\\t\\tcase \\\"--json\\\":\\n\\t\\t\\tjsonOut = true\\n\\t\\tcase \\\"--fix\\\":\\n\\t\\t\\tfix = true\\n\\t\\tcase \\\"--dry-run\\\":\\n\\t\\t\\t// explicit alias for --fix's default (no-op if --yes not set)\\n\\t\\tcase \\\"--yes\\\":\\n\\t\\t\\tyes = true\\n\\t\\tcase \\\"--only\\\":\\n\\t\\t\\tif i+1 >= len(args) {\\n\\t\\t\\t\\tfmt.Fprintln(stderr, text(\\\"Error: --only requires a check code\\\", \\\"Erro: --only exige um código de check\\\"))\\n\\t\\t\\t\\treturn 2\\n\\t\\t\\t}\\n\\t\\t\\ti++\\n\\t\\t\\tonly = args[i]\\n\\t\\tcase \\\"-h\\\", \\\"--help\\\":\\n\\t\\t\\tfmt.Fprintln(stdout, text(\\n\\t\\t\\t\\t\\\"Usage: pose doctor [--json] [--fix [--yes] [--only <check>]] — read-only diagnostics, optional guided remediation\\\",\\n\\t\\t\\t\\t\\\"Uso: pose doctor [--json] [--fix [--yes] [--only <check>]] — diagnóstico read-only, remediação guiada opcional\\\"))\\n\\t\\t\\treturn 0\\n\\t\\tdefault:\\n\\t\\t\\tfmt.Fprintf(stderr, text(\\\"Error: invalid argument: %s\\\\n\\\", \\\"Erro: argumento inválido: %s\\\\n\\\"), a)\\n\\t\\t\\treturn 2\\n\\t\\t}\\n\\t}\\n\\tif yes && !fix {\\n\\t\\tfmt.Fprintln(stderr, text(\\\"Error: --yes requires --fix\\\", \\\"Erro: --yes exige --fix\\\"))\\n\\t\\treturn 2\\n\\t}\\n\\tif only != \\\"\\\" && !fix {\\n\\t\\tfmt.Fprintln(stderr, text(\\\"Error: --only requires --fix\\\", \\\"Erro: --only exige --fix\\\"))\\n\\t\\treturn 2\\n\\t}\\n\\tif only != \\\"\\\" {\\n\\t\\tif _, ok := doctorFixRegistry[only]; !ok {\\n\\t\\t\\tfmt.Fprintf(stderr, text(\\\"Error: %q is not a fixable check code (available: %s)\\\\n\\\", \\\"Erro: %q não é um código de check corrigível (disponíveis: %s)\\\\n\\\"), only, strings.Join(fixableCodes(), \\\", \\\"))\\n\\t\\t\\treturn 2\\n\\t\\t}\\n\\t}\\n\\n\\troot, findings := runDoctorDiagnostics(locale)\\n\\tif !fix {\\n\\t\\treturn doctorReport(root, findings, jsonOut, stdout, locale)\\n\\t}\\n\\n\\tvar candidates []string\\n\\tfor _, f := range findings {\\n\\t\\tif f.RemediationClass != remediationFixable {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif only != \\\"\\\" && f.FixCode != only {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tcandidates = append(candidates, f.FixCode)\\n\\t}\\n\\n\\tif !yes {\\n\\t\\treturn doctorFixPreview(findings, candidates, jsonOut, stdout, locale)\\n\\t}\\n\\treturn doctorFixApply(root, findings, candidates, jsonOut, stdout, stderr, locale)\\n}\\n\\nfunc fixableCodes() []string {\\n\\tcodes := make([]string, 0, len(doctorFixRegistry))\\n\\tfor c := range doctorFixRegistry {\\n\\t\\tcodes = append(codes, c)\\n\\t}\\n\\treturn codes\\n}\\n\\n// runDoctorDiagnostics is the read-only diagnostic pass, factored out so\\n// --fix --yes can call it again after applying fixes (recheck, R3).\\ngit version 2.56.0\\n.agents/skills/README.md\\n.agents/skills/pose-adr/SKILL.md\\n.agents/skills/pose-bugfix/SKILL.md\\n.pose/review-bundles/rvb-82a87889d85ce8dd.json:662:            \\\"id\\\": \\\"SD-9fc0fe4e\\\",\\n.pose/review-bundles/rvb-82a87889d85ce8dd.json:669:            \\\"id\\\": \\\"SD-d29398e6\\\",\\n.pose/review-bundles/rvb-b5149e7feaba9233.json:656:            \\\"id\\\": \\\"SD-9fc0fe4e\\\",\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n.pose/review-runs/rrn-f0d738ef7de4226e.transcript:24:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/usr/bin/bash -lc \\\"sed -n '55,130p' pose-mcp/internal/pose/spec_trailers.go; sed -n '640,690p' .pose/review-bundles/rvb-82a87889d85ce8dd.json; rg -n 'trace|commit.graph|doctor' .pose/knowledge --glob '*.md' | head -18; sed -n '1,175p' .github/workflows/ci.yml; rg -n 'commit-graph|doctor-recommends' .pose/results/delivery-validation.json; git rev-parse --git-path objects/info/commit-graph\\\"\",\"aggregated_output\":\"\\t\\tsha, body := strings.TrimSpace(string(parts[i])), string(parts[i+1])\\n\\t\\tfor _, line := range strings.Split(body, \\\"\\\\n\\\") {\\n\\t\\t\\tline = strings.TrimSpace(line)\\n\\t\\t\\tif strings.HasPrefix(line, \\\"POSE-Spec:\\\") {\\n\\t\\t\\t\\tspec := strings.TrimSpace(strings.TrimPrefix(line, \\\"POSE-Spec:\\\"))\\n\\t\\t\\t\\tif spec != \\\"\\\" {\\n\\t\\t\\t\\t\\tspecCommits[spec] = append(specCommits[spec], sha)\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\treturn specCommits\\n}\\n\\n// RawHistoryGit is a git command on root's raw object history: replace refs\\n// (--no-replace-objects) and grafts (GIT_GRAFT_FILE at the always-empty null\\n// device, which overrides both the repository's graft file and one the\\n// environment names) never change which commits carry a trailer, what a change\\n// set holds, or what a later removal is judged on (spec\\n// pose-delivery-later-removal R3, review round 4 LR-R4-01).\\nfunc RawHistoryGit(root string, args ...string) *exec.Cmd {\\n\\treturn gitCommand(append([]string{\\\"--no-replace-objects\\\", \\\"-C\\\", root}, args...)...)\\n}\\n\\n// RawHistoryGitContext is RawHistoryGit under ctx.\\nfunc RawHistoryGitContext(ctx context.Context, root string, args ...string) *exec.Cmd {\\n\\treturn gitCommandContext(ctx, append([]string{\\\"--no-replace-objects\\\", \\\"-C\\\", root}, args...)...)\\n}\\n\\n// GitHooksDir is the directory git runs the hooks of root from: a linked worktree shares the\\n// one of its common directory, and core.hooksPath moves it. Where git cannot answer it is\\n// `.git/hooks`, which is where a repository would keep them.\\nfunc GitHooksDir(root string) string {\\n\\tout, err := RawHistoryGit(root, \\\"rev-parse\\\", \\\"--git-path\\\", \\\"hooks\\\").Output()\\n\\tif err != nil {\\n\\t\\treturn filepath.Join(root, \\\".git\\\", \\\"hooks\\\")\\n\\t}\\n\\tdir := strings.TrimSuffix(string(out), \\\"\\\\n\\\")\\n\\tif filepath.IsAbs(dir) {\\n\\t\\treturn dir\\n\\t}\\n\\treturn filepath.Join(root, dir)\\n}\\n\\n// RawGit is RawHistoryGit for a caller whose arguments already say where to read.\\nfunc RawGit(args ...string) *exec.Cmd {\\n\\treturn gitCommand(append([]string{\\\"--no-replace-objects\\\"}, args...)...)\\n}\\n\\n// SpecTrailerCommits reads the history of root and returns the commits that carry the trailer of\\n// slug, the way the attribution of change sets does. An error is a history that could not be\\n// read, which is not a history without commits.\\nfunc SpecTrailerCommits(root, slug string) ([]string, error) {\\n\\tout, err := RawHistoryGit(root, SpecTrailerLogArgs...).Output()\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\treturn ParseSpecTrailerLog(out)[slug], nil\\n}\\n        },\\n        {\\n          \\\"ref\\\": \\\"structural-materiality@1\\\",\\n          \\\"category\\\": \\\"structure\\\",\\n          \\\"order\\\": 5,\\n          \\\"source\\\": \\\".pose/review-profiles/structural-materiality.json\\\",\\n          \\\"components\\\": [\\n            \\\"pose-mcp\\\"\\n          ],\\n          \\\"rationale\\\": \\\"matched typed structure selector\\\"\\n        }\\n      ],\\n      \\\"structure\\\": {\\n        \\\"observed\\\": true,\\n        \\\"status\\\": \\\"observed\\\",\\n        \\\"input_digest\\\": \\\"sha256:5a89cc95a90eaa85e1ea85e7453749d2d3b948b1214d81beb1541272b8d381de\\\",\\n        \\\"subject_digest\\\": \\\"sha256:7bdf508caa366da5cc1fd022e95e1624ba00e647a6bfed21a19782790b80fb45\\\",\\n        \\\"kinds\\\": [\\n          \\\"delivery-metadata\\\"\\n        ],\\n        \\\"material\\\": [\\n          {\\n            \\\"id\\\": \\\"SD-9fc0fe4e\\\",\\n            \\\"kind\\\": \\\"delivery-metadata\\\",\\n            \\\"action\\\": \\\"changed\\\",\\n            \\\"subject\\\": \\\".pose/indexes/validation-matrix.json\\\",\\n            \\\"path\\\": \\\".pose/indexes/validation-matrix.json\\\"\\n          },\\n          {\\n            \\\"id\\\": \\\"SD-d29398e6\\\",\\n            \\\"kind\\\": \\\"delivery-metadata\\\",\\n            \\\"action\\\": \\\"changed\\\",\\n            \\\"subject\\\": \\\".pose/indexes/validation-matrix.json\\\",\\n            \\\"path\\\": \\\".pose/indexes/validation-matrix.json\\\"\\n          }\\n        ]\\n      },\\n      \\\"band\\\": \\\"critical\\\"\\n    },\\n    \\\"evidence\\\": [\\n      {\\n        \\\"id\\\": \\\"design-5a89cc95a90eaa85\\\",\\n        \\\"check\\\": \\\"assess-design\\\",\\n        \\\"evidence_class\\\": \\\"structure\\\",\\n        \\\"outcome\\\": \\\"pass\\\",\\n        \\\"subject_digest\\\": \\\"sha256:7bdf508caa366da5cc1fd022e95e1624ba00e647a6bfed21a19782790b80fb45\\\",\\n        \\\"subject_observation\\\": \\\"observed\\\",\\n        \\\"provenance_digest\\\": \\\"sha256:5a89cc95a90eaa85e1ea85e7453749d2d3b948b1214d81beb1541272b8d381de\\\",\\n        \\\"report\\\": \\\"derived:design-delta/5a89cc95a90eaa85e1ea85e7453749d2d3b948b1214d81beb1541272b8d381de\\\"\\n      },\\n      {\\n.pose/knowledge/archive/2026-09-24-handoff-multirepo-review-continuation.md:40:2. Preserve the reconciled commit attribution: the late trace trailer widens\\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:81:Same owner. If a `pose-doctor`-style check or a spec-frontmatter\\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:53:`pose-doctor-guided-remediation` — findings de `pose doctor` ganharam\\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:55:blocked), versionado aditivamente via `doctor_schema_version` (JSON prévio\\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:56:intacto); `pose doctor --fix` prevê reparos confinados e reversíveis\\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:60:`2026-07-19-doctor-guided-remediation-confined-fix-registry.md`. (2)\\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:100:trace_id/span_id com redação de paths e segredos (decisão deliberada de\\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:101:NÃO adotar o OTel Logs SDK/`otlploghttp`, ainda alpha v0.x — trace/metric\\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:179:Requirement trace + Final Report + disposição de follow-ups.\\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:211:  Windows zip, placeholders removidos, E2E clean-host com doctor+check\\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:282:  `.pose/specs/pose-doctor-guided-remediation/`, `.pose/specs/pose-brownfield-reference-kits/`,\\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:289:  `.pose/adr/2026-07-19-doctor-guided-remediation-confined-fix-registry.md`,\\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:67:- `pose doctor` gained two detectable (not auto-fixable — the correct roots\\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:74:  has to hand-edit the JSON, but doctor now tells them why and where.\\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:87:`doctor_remediation_test.go` (contaminated-roots detection and a\\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:104:- The `pose doctor` heuristic (all configured roots missing → warn) is\\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:132:  `pose-mcp/internal/cli/doctor.go`, `pose-mcp/internal/cli/doctor_remediation_test.go`,\\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:12:  commands: [\\\"pose check --strict\\\", \\\"pose knowledge-check --strict\\\", \\\"pose specs --json\\\", \\\"pose followups --json\\\", \\\"pose usage --json\\\", \\\"pose doctor --json\\\", \\\"pose review-plan spec:<slug> --json\\\", \\\"pose artifact-check --spec <slug> --json\\\", \\\"pose check --json\\\", \\\"pose lint-spec <slug> --json\\\", \\\"pose history-check --json\\\", \\\"pose knowledge-check --json\\\", \\\"pose skills-check --json\\\", \\\"pose recurrence-check --json\\\", \\\"pose index --json\\\", \\\"pose state --json\\\"]\\nname: CI\\non:\\n  pull_request:\\n  workflow_dispatch:\\n  push:\\n    branches: [main]\\n  # The release job runs this whole workflow at the tagged commit and needs it\\n  # green (spec release-runs-the-ci-gates).\\n  workflow_call:\\npermissions: { contents: read }\\njobs:\\n  test:\\n    runs-on: ubuntu-latest\\n    steps:\\n      # fetch-depth: 0 is load-bearing here too. The cross-version test builds\\n      # the previous release from its own tag with `git archive`, and a shallow\\n      # checkout has no tag objects — the test would skip, silently, on the one\\n      # runner where it matters (spec pose-release-boundary-rehearsal).\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with: { fetch-depth: 0 }\\n      # Governance reads ask Git for the last commit that touched each\\n      # artifact; on the full history each lookup walks it. The commit-graph\\n      # with changed-path filters answers from the filters (47 ms -> 2 ms a\\n      # lookup; spec pose-doctor-recommends-the-commit-graph).\\n      - name: Write the Git commit-graph with changed-path filters\\n        run: git commit-graph write --reachable --changed-paths\\n      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\\n        with: { go-version: \\\"1.26.10\\\", cache: true, cache-dependency-path: pose-mcp/go.mod }\\n      - name: Go tests (engine drift guard included)\\n        # The variable says this checkout carries the release history the\\n        # cross-version test needs — the promise the fetch-depth above keeps.\\n        # Declared rather than inferred from the provider, so a provider that\\n        # sets fewer variables cannot turn that test's failure into a silent\\n        # skip (spec pose-the-guard-signal-is-declared-not-inherited).\\n        env: { POSE_RELEASE_HISTORY_AVAILABLE: \\\"true\\\" }\\n        run: go -C pose-mcp test ./... -count=1\\n      - name: Shellcheck\\n        # Covers every shipped or executed script, not just the installer.\\n        # tests/release/ was outside this list until v0.20.2, and three\\n        # consecutive releases failed on defects there — two of them SC2154,\\n        # a variable referenced but never assigned, which aborts under set -u\\n        # after the expensive gates have already run\\n        # (spec pose-shellcheck-ci-gate).\\n        run: |\\n          sudo apt-get update -qq && sudo apt-get install -y -qq shellcheck\\n          shellcheck --severity=warning \\\\\\n            install.sh \\\\\\n            scripts/*.sh \\\\\\n            tests/*.sh \\\\\\n            tests/*/*.sh \\\\\\n            examples/demo/*.sh\\n      # The scripts below build binaries and fixtures under TMPDIR; this keeps\\n      # each of them removing what it creates (spec\\n      # pose-test-scripts-remove-their-temp-files).\\n      - name: Test scripts remove their temporary files (spec pose-test-scripts-remove-their-temp-files)\\n        run: bash tests/hygiene/temp-cleanup.sh\\n      - name: Installer E2E\\n        run: bash tests/install/run.sh\\n      - name: Artifact-identity gate rejects what it must (spec pose-release-signing R3)\\n        run: bash tests/release/verify-negative.sh\\n      # The migration guides make specific claims about what transfers and what\\n      # does not, and those claims are what users act on. A guide that drifts\\n      # from the importer is worse than none — it produces confident wrong\\n      # expectations (spec pose-sdd-migration-acquisition).\\n      - name: Documented migration paths still hold (spec pose-sdd-migration-acquisition)\\n        run: bash tests/import/migration-guides.sh\\n      # The quickstart shows the output of each step so a reader can tell\\n      # whether their run diverged. That only holds while the shown output is\\n      # the real one, and two of the steps depend on a gate *failing*\\n      # (spec pose-first-governed-loop-quickstart).\\n      - name: Quickstart loop behaves as documented (specs pose-first-governed-loop-quickstart, pose-quickstart-real-lifecycle)\\n        run: bash tests/quickstart/first-governed-loop.sh\\n      # A fresh install and an instance installed by the latest published\\n      # release, then updated, are the two ways a project meets this engine;\\n      # each must read clean and ask before adopting anything\\n      # (spec pose-install-and-upgrade-journeys).\\n      - name: Install and upgrade journeys hold (spec pose-install-and-upgrade-journeys)\\n        env:\\n          # Authenticated release listing: anonymous API calls share the\\n          # runner's per-IP limit (spec pose-ci-avoids-anonymous-rate-limits).\\n          GITHUB_TOKEN: ${{ github.token }}\\n        run: bash tests/journeys/install-and-upgrade.sh\\n      # The launch demo's whole argument is that every conventional check is\\n      # green and the delivery still cannot close. If the scenario ever goes\\n      # all-green, the recording made from it argues the opposite of the\\n      # product (spec pose-launch-proof-demo).\\n      - name: Launch demo scenario still blocks then closes (spec pose-launch-proof-demo)\\n        run: bash examples/demo/record.sh --verify\\n      - name: Pull Docker Hub images through a mirror\\n        # Anonymous Docker Hub pulls hit a per-IP limit on hosted runners (429).\\n        # Every base image is pinned by digest, so the mirror serves the same\\n        # bytes (spec pose-ci-avoids-anonymous-rate-limits).\\n        run: |\\n          echo '{\\\"registry-mirrors\\\":[\\\"https://mirror.gcr.io\\\"]}' | sudo tee /etc/docker/daemon.json >/dev/null\\n          sudo systemctl restart docker\\n          docker info --format '{{json .RegistryConfig.Mirrors}}'\\n      - name: Delivery images build and start\\n        # pose-mcp/Dockerfile and mcp-enforce/Dockerfile are composed in\\n        # production by the harne8 monorepo and were built by nothing here, so a\\n        # broken Dockerfile surfaced when that stack came up. The contexts match\\n        # docker-compose.prod.yaml (spec pose-container-build-gate).\\n        run: bash tests/release/container-build.sh\\n      - name: Recorded action runtimes match the actions themselves\\n        # The offline check reads the runtime record; this resolves each action\\n        # at its pinned ref, so the record cannot quietly disagree with reality\\n        # (spec pose-action-runtime-currency-gate).\\n        env:\\n          GH_TOKEN: ${{ github.token }}\\n        run: bash tests/release/action-runtime-verify.sh\\n  governance:\\n    # Dogfood gate (spec pose-standalone-dogfood): the standalone instance\\n    # must pass its own structural/validation gates with an explicitly\\n    # identified development build, and CI retains the evidence.\\n    runs-on: ubuntu-latest\\n    steps:\\n      # fetch-depth: 0 is load-bearing, not hygiene. The delivery contract\\n      # attributes a spec's declared artifacts to Git change sets found by the\\n      # `POSE-Spec:` commit trailer, and those commits are wherever the work\\n      # happened — the trailer for pose-cli-ergonomics-and-stack-expansion sits\\n      # 62 commits below main. Under the default shallow clone the gate sees\\n      # one commit, finds no attribution, and fails every spec with declared\\n      # artifacts. CI had been red on main since at least 2026-08-22 for\\n      # exactly this reason, reporting a governance defect that did not exist.\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with: { fetch-depth: 0 }\\n      # Governance reads ask Git for the last commit that touched each\\n      # artifact; on the full history each lookup walks it. The commit-graph\\n      # with changed-path filters answers from the filters (47 ms -> 2 ms a\\n      # lookup; spec pose-doctor-recommends-the-commit-graph).\\n      - name: Write the Git commit-graph with changed-path filters\\n        run: git commit-graph write --reachable --changed-paths\\n      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\\n        with: { go-version: \\\"1.26.10\\\", cache: true, cache-dependency-path: pose-mcp/go.mod }\\n      - name: Build development pose binary\\n        run: |\\n          go -C pose-mcp build -o \\\"$RUNNER_TEMP/pose\\\" ./cmd/pose\\n          \\\"$RUNNER_TEMP/pose\\\" version\\n      - name: Structural gate (pose check --strict)\\n        run: '\\\"$RUNNER_TEMP/pose\\\" check --strict'\\n      - name: Agent Skills conformance (spec pose-agent-skills-conformance)\\n        run: '\\\"$RUNNER_TEMP/pose\\\" skills-check --strict'\\n      # check --strict does not lint each spec against the template, so a\\n      # malformed spec merged unseen until someone ran this by hand\\n      # (spec pose-lint-spec-all-is-a-gate).\\n      - name: Spec structure gate (pose lint-spec --all)\\n        run: '\\\"$RUNNER_TEMP/pose\\\" lint-spec --all'\\n      - name: History gate (pose history-check)\\n        run: '\\\"$RUNNER_TEMP/pose\\\" history-check'\\n      # The landing page, the homepage, the structured metadata and thirteen\\n      # docs pages described 1.4.x while the product shipped 1.7.10, and nobody\\n      # noticed for weeks. Nothing tied a public claim to a released fact\\n      # (spec pose-public-claims-contract).\\n      - name: Public claims gate (spec pose-public-claims-contract)\\n        run: '\\\"$RUNNER_TEMP/pose\\\" public-claims --strict'\\n      - name: Retain governance evidence\\n        if: always()\\n        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1\\n        with:\\n          name: pose-governance-evidence\\n          path: |\\n            .pose/reports/\\n            .pose/indexes/spec-graph.json\\n            .pose/indexes/roadmaps.json\\n          if-no-files-found: warn\\n          retention-days: 90\\n184:    \\\"pose-doctor-recommends-the-commit-graph\\\": \\\"sha256:0007274878d1928e68869d181d5759ad22b0336c3c3f0a8e5e1d270dcab36d67\\\",\\n654:    \\\"pose-doctor-recommends-the-commit-graph\\\": \\\"sha256:7fc20ae863ef4151828051a3438a9f049278808d9534f237855087af3c33c3cc\\\",\\n4352:      \\\"id\\\": \\\"pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n4355:      \\\"name\\\": \\\"doctor-recommends-the-commit-graph-integration\\\",\\n/var/tmp/closeout/pose-dist/.git/objects/info/commit-graph\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n.pose/review-runs/rrn-f0d738ef7de4226e.transcript:53:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_27\",\"type\":\"agent_message\",\"text\":\"decision: changes-requested\\n\\nFound six defects, including a remaining part of R1-F5. The repository is unchanged; no attestation was recorded.\\n\\nRules applied: POSE review workflow, backend Go, security, documentation style and delivery evidence. I inspected the scoped implementation, CI steps, validation registration, spec and regression tests. Package tests and validation rely on the sealed pipeline evidence because this sandbox prohibits writes.\\n\\nGit’s documented behavior supports the shallow-history, filter-generation and configuration-precedence findings. [Git commit-graph documentation](https://git-scm.com/docs/git-commit-graph), [Git 2.56 implementation](https://github.com/git/git/blob/v2.56.0/commit-graph.c). The partial-clone finding follows Git’s automatic fetching of missing objects. [Partial-clone documentation](https://git-scm.com/docs/partial-clone).\\n\\n```pose-draft\\n{\\n  \\\"schema\\\": \\\"pose.review.draft/v1\\\",\\n  \\\"decision\\\": \\\"changes-requested\\\",\\n  \\\"findings\\\": [\\n    {\\n      \\\"id\\\": \\\"F9\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 100,\\n      \\\"summary\\\": \\\"A shallow repository with at least 500 reachable commits receives a fixable rewrite recommendation, but Git refuses both reading and writing commit-graphs while shallow boundaries exist. writeCommitGraph therefore returns success without resolving the finding, violating R2. A read-only probe using --shallow-file with HEAD~499 confirmed a count of 500, is-shallow-repository=true and no Bloom statistics. Git 2.56 commit-graph.c checks commit_graph_compatible for both reads and writes and returns success without writing for shallow history. Detect this condition and provide actionable remediation or explicitly reconcile the requirements; add a shallow-history regression.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"F10\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 154,\\n      \\\"summary\\\": \\\"The fix inherits commitGraph.maxNewFilters. With maxNewFilters=0 and no existing filters, --changed-paths computes no new filters, so the command succeeds while the recheck remains next indefinitely. Git documents this setting as the default filter-generation limit; Git 2.56 compute_bloom_filters permits computation only below that limit. R2's promised post-fix ok is therefore not guaranteed. Diagnose the effective generation limit or deliberately override it for this explicit repair, and cover zero and restrictive limits.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"F11\\\",\\n      \\\"severity\\\": \\\"low\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 80,\\n      \\\"summary\\\": \\\"An empty HEAD tree above the history threshold returns a successful state with filtersUsed=false before probing or checking disabled reads. doctor.go consequently recommends a rewrite forever, including immediately after a successful fix; disabled-read settings are also omitted. This is possible with an installed, untracked .pose directory and a committed empty tree. R2 has no nonempty-tree exclusion. Handle the absence of a probeable path explicitly and add a regression.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"F12\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 118,\\n      \\\"summary\\\": \\\"The disabled-read diagnosis ignores Git configuration precedence. commitGraph.changedPathsVersion overrides the deprecated commitGraph.readChangedPaths setting. With readChangedPaths=false, changedPathsVersion=1 and a missing graph, this function incorrectly reports reads disabled, removes the automatic repair and asks the user to unset a setting that is ineffective. A read-only trace with both settings confirmed Git actually consulting filters (maybe=1, definitely_not=1141). Resolve the effective version before interpreting the deprecated boolean and test conflicting settings against R3.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"F13\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 75,\\n      \\\"summary\\\": \\\"The diagnostic is not guaranteed read-only in a partial clone. Recursive ls-tree, and subsequently the path-history lookup, can encounter promised trees absent locally and cause Git to fetch and store them under the object directory. commitGraphGit uses RawHistoryGit without disabling lazy fetch; gitCommandContext likewise provides no GIT_NO_LAZY_FETCH protection. A tree-filtered or sparse partial clone with sufficient history can therefore mutate .git during plain doctor or a fix preview, contrary to the spec's read-only constraint. Disable lazy fetching for diagnostic commands and report unavailable local state; cover missing promised trees without contacting the remote.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"F14\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 166,\\n      \\\"summary\\\": \\\"Operational graph-read diagnostics are discarded whenever Git exits successfully. Git can reject a truncated or malformed graph, print an error or warning to stderr, fall back to ordinary object traversal and still complete rev-list/log with exit status zero. This helper then returns no error, and doctor reports next (or ok below the threshold) rather than R3's bounded warn explaining the read failure. Git 2.56 load_commit_graph_one_fd_st rejects undersized files, while prepare_commit_graph permits fallback. Preserve and classify graph-read failures even on successful commands, with a corrupt-graph regression. This leaves R1-F5 partially unresolved.\\\"\\n    }\\n  ],\\n  \\\"prior_findings\\\": [\\n    {\\n      \\\"id\\\": \\\"R1-F2\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"doctor_commit_graph.go:92 delegates graph selection and Bloom lookup to Git instead of constructing graph paths. TestDoctorRecommendsTheCommitGraph covers an alternate-only graph through clone --shared; sealed integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration passes. Git itself resolves alternate base layers.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F3\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"doctor_commit_graph.go:92 uses Git's active graph. TestDoctorRecommendsTheCommitGraph covers an unfiltered monolithic graph beside a filtered split chain and expects next; sealed integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration passes.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F4\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"The custom graph-header/chunk parser is removed. doctor_commit_graph.go:92 and :129 now recognize actual filter use reported by Git, so unsupported or truncated graph headers cannot independently produce a false positive from chunk identifiers. Sealed integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration passes. Failure reporting is separately addressed by F14.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F5\\\",\\n      \\\"status\\\": \\\"partial\\\",\\n      \\\"evidence\\\": \\\"doctor.go:371 now warns for returned state errors, and TestDoctorCommitGraphReportsAnUnreadableHistory plus TestDoctorCommitGraphTellsUnbornFromBroken cover missing commits and invalid repository configuration. However, doctor_commit_graph.go:166-174 drops stderr when Git successfully falls back after a graph-read failure; see F14.\\\"\\n    }\\n  ],\\n  \\\"sweep\\\": \\\"Reviewed every scoped implementation/governance file, R1-R4 and D1, doctor fix registration/classification/recheck, Git environment construction, applicability and error paths, trace parsing and temporary-file lifecycle, alternate and split graph behavior, configuration precedence, shallow and partial clones, empty trees, filter-generation limits, both full-history CI jobs, validation-matrix registration, and all new regression tests. Read sealed validation results and artifact/surface outputs; ran context resolution, suggest-review, artifact-check, surface-check, recurrence-check and read-only Git probes. No builds, fixture creation, assessments, fixes, repository changes or attestations were performed.\\\",\\n  \\\"criteria\\\": [\\n    {\\n      \\\"id\\\": \\\"assumption-integrity\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F9\\\",\\n      \\\"rationale\\\": \\\"The design assumes lack of filter use implies a graph rewrite can repair the repository. Shallow history disproves that assumption; generation limits and empty trees expose additional unresolved cases. The documented trace-event compatibility risk is explicit.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-concurrency\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"No new concurrent production state or goroutines were introduced. Commands are synchronous, trace files are unique and removal is deferred; the mutable threshold is used by serial tests.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-contracts\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"The existing doctor report and remediation registry contracts remain additive; no MCP, REST or event schema is changed.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-input-errors\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F14\\\",\\n      \\\"rationale\\\": \\\"Fatal Git errors carry bounded context, but successful fallback after graph corruption loses the required diagnostic.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-integration-impact\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F9\\\",\\n      \\\"rationale\\\": \\\"The Git integration does not account for shallow repositories in which the proposed repair is a successful no-op.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-observability\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F14\\\",\\n      \\\"rationale\\\": \\\"Graph-read diagnostics on successful Git commands are discarded.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"compatibility\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Examined doctor JSON construction, finding classification and fix dispatch. New check codes and the registry entry preserve existing report fields and explicit fix authorization.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"correctness\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F10\\\",\\n      \\\"rationale\\\": \\\"The repair does not guarantee filter generation under supported Git configuration.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"design-causality\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-9f56d2c784426404\\\",\\n      \\\"rationale\\\": \\\"D1 places repository maintenance in explicit doctor remediation rather than governance reads. Asking Git for observed filter use removes the independent parser that caused alternate, precedence and header defects. Permanent integration registration supplies executable evidence for this capability; the implementation still needs the negative cases listed in findings.\\\",\\n      \\\"mappings\\\": [\\n        {\\n          \\\"delta\\\": \\\"SD-9fc0fe4e\\\",\\n          \\\"basis\\\": \\\"R2\\\",\\n          \\\"disposition\\\": \\\"mapped\\\",\\n          \\\"rationale\\\": \\\"The validation-matrix integration check exercises production doctor fix dispatch and the subsequent diagnostic recheck.\\\"\\n        },\\n        {\\n          \\\"delta\\\": \\\"SD-d29398e6\\\",\\n          \\\"basis\\\": \\\"R3\\\",\\n          \\\"disposition\\\": \\\"mapped\\\",\\n          \\\"rationale\\\": \\\"The same capability's permanent check registers applicability, literal-path, unreadable-history and disabled-read regressions. Both structural facts identify the shared validation-matrix path.\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"id\\\": \\\"documentation\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Examined the spec, inline operational explanations, displayed commands and CI comments. They describe the intended explicit repair flow and trace dependency; no public schema migration or scaffold change is required. Runtime exceptions to the promised behavior are reported as findings.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"operability\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F12\\\",\\n      \\\"rationale\\\": \\\"The configuration diagnosis can suppress the useful repair and direct users to change an ineffective setting.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"requirements\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F11\\\",\\n      \\\"rationale\\\": \\\"R1 and R4 have relevant positive evidence, but R2's unconditional post-fix ok and R3's configuration/error behavior are not satisfied across the identified negative cases.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"scope\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-9f56d2c784426404\\\",\\n      \\\"rationale\\\": \\\"The attributed implementation matches the approved doctor capability, CI preparation and permanent validation registration. Shared-file changes belonging to other specs were distinguished from this capability's additions.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"security\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F13\\\",\\n      \\\"rationale\\\": \\\"Arguments are passed without shell interpolation, but diagnostic Git reads can cross the promised mutation boundary through lazy fetching.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"solution-proportionality\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-9f56d2c784426404\\\",\\n      \\\"rationale\\\": \\\"Examined D1 and the removed parser alternative. A small doctor check, fixed repair command and two CI steps fit the measured problem without background maintenance or new storage abstractions. Delegating graph semantics to Git is smaller than maintaining a graph parser. The choice requires reconsideration if trace statistics cease to be available or cannot distinguish actionable states.\\\"\\n    }\\n  ],\\n  \\\"tools\\\": [\\n    {\\n      \\\"id\\\": \\\"artifact-check\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"command:pose artifact-check --spec pose-doctor-recommends-the-commit-graph --strict\\\",\\n      \\\"rationale\\\": \\\"Executed successfully. Also inspected /var/tmp/closeout/ac-dc.out, which binds the requested sealed range and change set; it contains pre-existing orphan warnings. The live rerun resolved a later range, so the supplied sealed output was used for subject attribution.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-design\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"structure:design-9f56d2c784426404\\\",\\n      \\\"rationale\\\": \\\"Used the sealed structural result and independently inspected D1 and the matrix changes. Did not rerun assessment commands that may write repository artifacts.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-discover\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/assessment-freshness-integration\\\",\\n      \\\"rationale\\\": \\\"Recommended assessment was not rerun under the read-only boundary. Component scope and current validation were inspected directly; this evidence ref does not claim a fresh discovery execution.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-integrate\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"No MCP, REST, Protobuf or event contract changed. Examined the production CLI/Git boundary and sealed integration evidence without running a writing assessment.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-tech-debt\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Did not run a writing assessment. Manually inspected the scoped code for unfinished implementations and markers and read the spec's owned performance follow-up.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"closeout-check\\\",\\n      \\\"disposition\\\": \\\"deferred\\\",\\n      \\\"rationale\\\": \\\"Completion tool requires the recorded review conclusion; no attestation was authorized or recorded by this reviewer.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"review-check\\\",\\n      \\\"disposition\\\": \\\"deferred\\\",\\n      \\\"rationale\\\": \\\"Requires POSE to record this verified run's conclusion before the completed review can be checked.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"suggest-review\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"command:pose suggest review --path pose-mcp\\\",\\n      \\\"rationale\\\": \\\"Executed and applied the selected backend-go, security and documentation-style rules.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"surface-check\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Ran pose surface-check --spec pose-doctor-recommends-the-commit-graph --strict successfully: one target, 232 results, zero findings. Also inspected /var/tmp/closeout/sc-dc.out for the supplied sealed subject. This establishes composition, not correctness of every negative case.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"validate\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Disposed from the sealed pipeline's pose validate --strict run and .pose/results/delivery-validation.json. Inspected its exact registered test selection and passing output. No writing validation rerun was attempted in this sandbox.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"validate\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\",\\n      \\\"rationale\\\": \\\"The sealed validation includes the pose-mcp package tests, build and integration checks covering this module. Tests were read independently; build/test reruns requiring temporary files were prohibited.\\\"\\n    }\\n  ]\\n}\\n```\"}}\n.pose/review-runs/rrn-c7c3feb56ea14783.json:106:  \"output\": \"decision: changes-requested\\n\\nThree medium-severity blockers remain:\\n\\n- **R2-F6:** HEAD-resolution failures still silently suppress the check.\\n- **R2-F7:** The probe interprets filenames as Git pathspecs, producing false recommendations.\\n- **R2-F8:** The remediation cannot satisfy the check when Git configuration disables filter reads.\\n\\nR1-F2, R1-F3 and R1-F4 are fixed. R1-F5 is partially fixed.\\n\\nApplied the review workflow and Go, security, documentation and delivery-evidence rules. Reviewed the sealed scope, implementation, tests, CI and validation registration. Read-only Git probes confirmed the configuration and pathspec behavior; [Git’s implementation](https://github.com/git/git/blob/v2.56.0/revision.c) and [configuration documentation](https://github.com/git/git/blob/v2.56.0/Documentation/config/commitgraph.adoc) support those conclusions. Package tests and validation use the supplied sealed evidence. Artifact and surface checks returned successfully. The repository remains unchanged.\\n\\n```pose-draft\\n{\\n  \\\"schema\\\": \\\"pose.review.draft/v1\\\",\\n  \\\"decision\\\": \\\"changes-requested\\\",\\n  \\\"findings\\\": [\\n    {\\n      \\\"id\\\": \\\"R2-F6\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 39,\\n      \\\"summary\\\": \\\"Every failure of rev-parse HEAD^{commit} is still classified as not applicable. A corrupt or inaccessible HEAD object, malformed repository configuration, or Git execution failure therefore removes the check instead of producing the warning required by R3. A read-only probe with core.bare=invalid returned exit 128; the wrapper preserves this configuration and this branch discards its diagnostic. The deleted-parent test exercises only the later rev-list failure. Distinguish a non-repository or unborn HEAD from operational failures and cover failures at this first command. This is the remaining portion of R1-F5.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R2-F7\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 69,\\n      \\\"summary\\\": \\\"The filename selected by ls-tree is passed as a pathspec without literal-pathspec handling. '--' prevents option parsing but does not disable wildcard or colon magic. A valid first filename such as '[a]' or '*' can disable Bloom filtering or select different paths, leaving a fully filtered repository at next even after the R2 fix. Read-only probes of the same existing file using '.agents/skills/README.md' and '[.]agents/skills/README.md' returned the same commit, but only the literal spelling emitted Bloom statistics. Use literal path semantics and add a real-repository regression with a first filename containing pathspec syntax.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R2-F8\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 107,\\n      \\\"summary\\\": \\\"The check recommends rewriting the graph whenever the probe consults no filters, including when repository or global configuration disables their use. With commitGraph.changedPathsVersion=0 or commitGraph.readChangedPaths=false, the write command can succeed but Git still refuses to read the filters, so doctor remains next and repeated fixes cannot meet R2. A read-only probe against the existing filtered graph emitted Bloom statistics normally and none with changedPathsVersion=0; Git documents that this setting still permits writing filters. Detect disabled reads and provide an actionable configuration explanation instead of presenting graph rewriting alone as a sufficient fix; cover the disabled configuration.\\\"\\n    }\\n  ],\\n  \\\"prior_findings\\\": [\\n    {\\n      \\\"id\\\": \\\"R1-F2\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"doctor_commit_graph.go:54-76 delegates graph loading to Git rather than locating graph files. doctor_commit_graph_test.go:111-119 covers an alternate-only graph; sealed integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration passed.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F3\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"doctor_commit_graph.go:69 uses Git's active graph selection. doctor_commit_graph_test.go:103-106 covers an unfiltered monolithic graph beside a filtered chain; sealed integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration passed.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F4\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"doctor_commit_graph.go:38-77 no longer parses graph headers or chunk tables. It requires Git to consult filters, so unsupported or truncated graph files cannot be accepted merely from chunk identifiers.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F5\\\",\\n      \\\"status\\\": \\\"partial\\\",\\n      \\\"evidence\\\": \\\"doctor.go:368-371 now emits warn for propagated operational errors; doctor_commit_graph_test.go:125-147 covers missing parent history. However, doctor_commit_graph.go:39-40 still suppresses every initial rev-parse failure. Remaining defect: R2-F6.\\\"\\n    }\\n  ],\\n  \\\"sweep\\\": \\\"Swept R1-R4 and D1 against all six declared change paths, including the fix registry, report compatibility, threshold handling, Git wrapper/environment, alternate and monolithic/split graph behavior, path selection, Trace2 parsing and temporary-file lifecycle, disabled filter configuration, partial graph coverage, error propagation, CI ordering, validation registration and test assertions. Checked all four prior findings. Read-only probes confirmed normal versus wildcard pathspec behavior, disabled filter reads, malformed configuration, and Trace2 brief/nesting compatibility. Consulted the sealed validation evidence and supplied artifact/surface outputs; reran artifact-check, surface-check, context, suggest-review and recurrence-check. No edits, builds, fixes or attestations were performed.\\\",\\n  \\\"criteria\\\": [\\n    {\\n      \\\"id\\\": \\\"assumption-integrity\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F7\\\",\\n      \\\"rationale\\\": \\\"Verified ordinary Trace2 events, brief/nesting settings and Git-selected graph loading. The assumption that an arbitrary tracked filename is a suitable literal probe is false. Disabled filter reads are another unhandled assumption, recorded in R2-F8. Future Trace2 event changes are explicitly documented as a technical risk in the spec.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-concurrency\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\",\\n      \\\"rationale\\\": \\\"No new concurrent execution or shared production cache is introduced. Each probe owns a CreateTemp file and defers its removal; subprocesses finish synchronously before reading the trace. The mutable threshold is changed only by serial tests.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-contracts\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"The new check and fixed-argument remediation use the existing doctor registry and report structure. No MCP, REST, event or persisted governance schema changes are introduced.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-input-errors\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F6\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-integration-impact\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F8\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-observability\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F6\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"compatibility\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Inspected doctor.go's additive check and registry entry. Existing JSON fields, CLI options and remediation dispatch remain compatible; no public file or MCP contract requires migration.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"correctness\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F7\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"design-causality\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-634d1db037114fae\\\",\\n      \\\"rationale\\\": \\\"D1 places explicit repository maintenance in doctor --fix rather than governance reads. Asking Git which filters it actually consults removes the alternate, precedence and parser duplication that caused the prior defects. CI writes the graph immediately after both full-history checkouts. The validation-matrix addition registers the spec's permanent integration gate.\\\",\\n      \\\"mappings\\\": [\\n        {\\n          \\\"delta\\\": \\\"SD-9fc0fe4e\\\",\\n          \\\"basis\\\": \\\"R1\\\",\\n          \\\"disposition\\\": \\\"mapped\\\",\\n          \\\"rationale\\\": \\\"The validation-matrix change adds the required doctor-recommends-the-commit-graph integration command declared in the spec's delivery target, exercising R1-R3. The neighboring review-ledger test-list extension belongs to its existing separate scope and does not implement this capability.\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"id\\\": \\\"documentation\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Inspected the spec, runtime remediation text and CI comments. They identify the 500-commit threshold, exact write command, explicit maintenance boundary and Trace2 dependency. No scaffold or public command syntax changes are required. Behavioral exceptions are recorded as blockers.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"operability\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F8\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"requirements\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F6\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"scope\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-634d1db037114fae\\\",\\n      \\\"rationale\\\": \\\"Compared the six declared subject paths with the spec's artifacts, affected areas and delivery target. The implementation adds the doctor check/fix, CI preparation and permanent integration registration. Generated governance records and separately attributed neighboring review-ledger changes do not expand this capability's implementation.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"security\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Inspected fixed Git arguments, RawHistoryGit's repository-redirection filtering, CreateTemp permissions and deferred cleanup, and bounded returned stderr. No shell interpolation, credentials or new authority surface is introduced. The pathspec defect changes query semantics rather than executing commands.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"solution-proportionality\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-634d1db037114fae\\\",\\n      \\\"rationale\\\": \\\"Compared the implementation with documentation alone, automatic maintenance during governance reads, and parsing commit-graph files. The existing doctor registry plus Git-owned graph selection is a small sufficient structure without speculative abstractions. Its suitability depends on a reliable literal probe and supported Trace2 statistics; the probe defect is blocked in R2-F7, and an incompatible Trace2 change would require revisiting the detection method.\\\"\\n    }\\n  ],\\n  \\\"tools\\\": [\\n    {\\n      \\\"id\\\": \\\"artifact-check\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"command:pose artifact-check --spec pose-doctor-recommends-the-commit-graph --strict\\\",\\n      \\\"rationale\\\": \\\"Executed successfully. Also inspected /var/tmp/closeout/ac-dc.out for the exact sealed change set cs-44a19acf2fe0. Existing orphan warnings were reported; they were not treated as new capability defects.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-design\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Did not run assessment writers in the read-only checkout. Inspected the design directly and consumed sealed structure:design-634d1db037114fae.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-discover\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Assessment mutation is outside the read-only review boundary. Component scope was verified through the spec, context resolution, code and sealed component evidence.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-integrate\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Did not run assessment writers. Reviewed Git, CLI registry and CI integration directly and consumed the sealed integration evidence; no REST, Protobuf, Kafka or MCP tool contract changes occur.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-tech-debt\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Did not run assessment writers. Inspected changed implementation and tests for unfinished markers and reviewed the spec's existing doctor-performance follow-up.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"closeout-check\\\",\\n      \\\"disposition\\\": \\\"deferred\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Requires completion and recording of the review. No attestation was recorded, as instructed.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"review-check\\\",\\n      \\\"disposition\\\": \\\"deferred\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Requires POSE to record and verify the review conclusion after this draft.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"suggest-review\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"command:pose suggest review --path pose-mcp\\\",\\n      \\\"rationale\\\": \\\"Executed and read the selected workflow and applicable Go, security and documentation rules.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"surface-check\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Executed pose surface-check --spec pose-doctor-recommends-the-commit-graph --strict successfully: one target, 231 results, zero findings. Also read /var/tmp/closeout/sc-dc.out. The registered integration test reaches doctor reporting and --fix dispatch.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"validate\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"build:pose-mcp/go/build\\\",\\n      \\\"rationale\\\": \\\"Consumed the supplied sealed strict-validation run, including build, unit, integration and e2e results. Did not rerun build or validation writers in the read-only sandbox. Passing registered checks do not cover the three reported negative cases.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"validate\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Consumed the sealed pose-mcp validation results and read the capability's real-repository tests. The pipeline is the validation producer; no package tests or build outputs were written during this independent review.\\\"\\n    }\\n  ]\\n}\\n```\",\n.pose/review-runs/rrn-c7c3feb56ea14783.transcript:51:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_26\",\"type\":\"agent_message\",\"text\":\"decision: changes-requested\\n\\nThree medium-severity blockers remain:\\n\\n- **R2-F6:** HEAD-resolution failures still silently suppress the check.\\n- **R2-F7:** The probe interprets filenames as Git pathspecs, producing false recommendations.\\n- **R2-F8:** The remediation cannot satisfy the check when Git configuration disables filter reads.\\n\\nR1-F2, R1-F3 and R1-F4 are fixed. R1-F5 is partially fixed.\\n\\nApplied the review workflow and Go, security, documentation and delivery-evidence rules. Reviewed the sealed scope, implementation, tests, CI and validation registration. Read-only Git probes confirmed the configuration and pathspec behavior; [Git’s implementation](https://github.com/git/git/blob/v2.56.0/revision.c) and [configuration documentation](https://github.com/git/git/blob/v2.56.0/Documentation/config/commitgraph.adoc) support those conclusions. Package tests and validation use the supplied sealed evidence. Artifact and surface checks returned successfully. The repository remains unchanged.\\n\\n```pose-draft\\n{\\n  \\\"schema\\\": \\\"pose.review.draft/v1\\\",\\n  \\\"decision\\\": \\\"changes-requested\\\",\\n  \\\"findings\\\": [\\n    {\\n      \\\"id\\\": \\\"R2-F6\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 39,\\n      \\\"summary\\\": \\\"Every failure of rev-parse HEAD^{commit} is still classified as not applicable. A corrupt or inaccessible HEAD object, malformed repository configuration, or Git execution failure therefore removes the check instead of producing the warning required by R3. A read-only probe with core.bare=invalid returned exit 128; the wrapper preserves this configuration and this branch discards its diagnostic. The deleted-parent test exercises only the later rev-list failure. Distinguish a non-repository or unborn HEAD from operational failures and cover failures at this first command. This is the remaining portion of R1-F5.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R2-F7\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 69,\\n      \\\"summary\\\": \\\"The filename selected by ls-tree is passed as a pathspec without literal-pathspec handling. '--' prevents option parsing but does not disable wildcard or colon magic. A valid first filename such as '[a]' or '*' can disable Bloom filtering or select different paths, leaving a fully filtered repository at next even after the R2 fix. Read-only probes of the same existing file using '.agents/skills/README.md' and '[.]agents/skills/README.md' returned the same commit, but only the literal spelling emitted Bloom statistics. Use literal path semantics and add a real-repository regression with a first filename containing pathspec syntax.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R2-F8\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 107,\\n      \\\"summary\\\": \\\"The check recommends rewriting the graph whenever the probe consults no filters, including when repository or global configuration disables their use. With commitGraph.changedPathsVersion=0 or commitGraph.readChangedPaths=false, the write command can succeed but Git still refuses to read the filters, so doctor remains next and repeated fixes cannot meet R2. A read-only probe against the existing filtered graph emitted Bloom statistics normally and none with changedPathsVersion=0; Git documents that this setting still permits writing filters. Detect disabled reads and provide an actionable configuration explanation instead of presenting graph rewriting alone as a sufficient fix; cover the disabled configuration.\\\"\\n    }\\n  ],\\n  \\\"prior_findings\\\": [\\n    {\\n      \\\"id\\\": \\\"R1-F2\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"doctor_commit_graph.go:54-76 delegates graph loading to Git rather than locating graph files. doctor_commit_graph_test.go:111-119 covers an alternate-only graph; sealed integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration passed.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F3\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"doctor_commit_graph.go:69 uses Git's active graph selection. doctor_commit_graph_test.go:103-106 covers an unfiltered monolithic graph beside a filtered chain; sealed integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration passed.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F4\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"doctor_commit_graph.go:38-77 no longer parses graph headers or chunk tables. It requires Git to consult filters, so unsupported or truncated graph files cannot be accepted merely from chunk identifiers.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F5\\\",\\n      \\\"status\\\": \\\"partial\\\",\\n      \\\"evidence\\\": \\\"doctor.go:368-371 now emits warn for propagated operational errors; doctor_commit_graph_test.go:125-147 covers missing parent history. However, doctor_commit_graph.go:39-40 still suppresses every initial rev-parse failure. Remaining defect: R2-F6.\\\"\\n    }\\n  ],\\n  \\\"sweep\\\": \\\"Swept R1-R4 and D1 against all six declared change paths, including the fix registry, report compatibility, threshold handling, Git wrapper/environment, alternate and monolithic/split graph behavior, path selection, Trace2 parsing and temporary-file lifecycle, disabled filter configuration, partial graph coverage, error propagation, CI ordering, validation registration and test assertions. Checked all four prior findings. Read-only probes confirmed normal versus wildcard pathspec behavior, disabled filter reads, malformed configuration, and Trace2 brief/nesting compatibility. Consulted the sealed validation evidence and supplied artifact/surface outputs; reran artifact-check, surface-check, context, suggest-review and recurrence-check. No edits, builds, fixes or attestations were performed.\\\",\\n  \\\"criteria\\\": [\\n    {\\n      \\\"id\\\": \\\"assumption-integrity\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F7\\\",\\n      \\\"rationale\\\": \\\"Verified ordinary Trace2 events, brief/nesting settings and Git-selected graph loading. The assumption that an arbitrary tracked filename is a suitable literal probe is false. Disabled filter reads are another unhandled assumption, recorded in R2-F8. Future Trace2 event changes are explicitly documented as a technical risk in the spec.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-concurrency\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\",\\n      \\\"rationale\\\": \\\"No new concurrent execution or shared production cache is introduced. Each probe owns a CreateTemp file and defers its removal; subprocesses finish synchronously before reading the trace. The mutable threshold is changed only by serial tests.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-contracts\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"The new check and fixed-argument remediation use the existing doctor registry and report structure. No MCP, REST, event or persisted governance schema changes are introduced.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-input-errors\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F6\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-integration-impact\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F8\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-observability\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F6\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"compatibility\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Inspected doctor.go's additive check and registry entry. Existing JSON fields, CLI options and remediation dispatch remain compatible; no public file or MCP contract requires migration.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"correctness\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F7\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"design-causality\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-634d1db037114fae\\\",\\n      \\\"rationale\\\": \\\"D1 places explicit repository maintenance in doctor --fix rather than governance reads. Asking Git which filters it actually consults removes the alternate, precedence and parser duplication that caused the prior defects. CI writes the graph immediately after both full-history checkouts. The validation-matrix addition registers the spec's permanent integration gate.\\\",\\n      \\\"mappings\\\": [\\n        {\\n          \\\"delta\\\": \\\"SD-9fc0fe4e\\\",\\n          \\\"basis\\\": \\\"R1\\\",\\n          \\\"disposition\\\": \\\"mapped\\\",\\n          \\\"rationale\\\": \\\"The validation-matrix change adds the required doctor-recommends-the-commit-graph integration command declared in the spec's delivery target, exercising R1-R3. The neighboring review-ledger test-list extension belongs to its existing separate scope and does not implement this capability.\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"id\\\": \\\"documentation\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Inspected the spec, runtime remediation text and CI comments. They identify the 500-commit threshold, exact write command, explicit maintenance boundary and Trace2 dependency. No scaffold or public command syntax changes are required. Behavioral exceptions are recorded as blockers.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"operability\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F8\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"requirements\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"R2-F6\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"scope\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-634d1db037114fae\\\",\\n      \\\"rationale\\\": \\\"Compared the six declared subject paths with the spec's artifacts, affected areas and delivery target. The implementation adds the doctor check/fix, CI preparation and permanent integration registration. Generated governance records and separately attributed neighboring review-ledger changes do not expand this capability's implementation.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"security\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Inspected fixed Git arguments, RawHistoryGit's repository-redirection filtering, CreateTemp permissions and deferred cleanup, and bounded returned stderr. No shell interpolation, credentials or new authority surface is introduced. The pathspec defect changes query semantics rather than executing commands.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"solution-proportionality\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-634d1db037114fae\\\",\\n      \\\"rationale\\\": \\\"Compared the implementation with documentation alone, automatic maintenance during governance reads, and parsing commit-graph files. The existing doctor registry plus Git-owned graph selection is a small sufficient structure without speculative abstractions. Its suitability depends on a reliable literal probe and supported Trace2 statistics; the probe defect is blocked in R2-F7, and an incompatible Trace2 change would require revisiting the detection method.\\\"\\n    }\\n  ],\\n  \\\"tools\\\": [\\n    {\\n      \\\"id\\\": \\\"artifact-check\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"command:pose artifact-check --spec pose-doctor-recommends-the-commit-graph --strict\\\",\\n      \\\"rationale\\\": \\\"Executed successfully. Also inspected /var/tmp/closeout/ac-dc.out for the exact sealed change set cs-44a19acf2fe0. Existing orphan warnings were reported; they were not treated as new capability defects.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-design\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Did not run assessment writers in the read-only checkout. Inspected the design directly and consumed sealed structure:design-634d1db037114fae.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-discover\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Assessment mutation is outside the read-only review boundary. Component scope was verified through the spec, context resolution, code and sealed component evidence.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-integrate\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Did not run assessment writers. Reviewed Git, CLI registry and CI integration directly and consumed the sealed integration evidence; no REST, Protobuf, Kafka or MCP tool contract changes occur.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-tech-debt\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Did not run assessment writers. Inspected changed implementation and tests for unfinished markers and reviewed the spec's existing doctor-performance follow-up.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"closeout-check\\\",\\n      \\\"disposition\\\": \\\"deferred\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Requires completion and recording of the review. No attestation was recorded, as instructed.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"review-check\\\",\\n      \\\"disposition\\\": \\\"deferred\\\",\\n      \\\"evidence\\\": \\\"\\\",\\n      \\\"rationale\\\": \\\"Requires POSE to record and verify the review conclusion after this draft.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"suggest-review\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"command:pose suggest review --path pose-mcp\\\",\\n      \\\"rationale\\\": \\\"Executed and read the selected workflow and applicable Go, security and documentation rules.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"surface-check\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Executed pose surface-check --spec pose-doctor-recommends-the-commit-graph --strict successfully: one target, 231 results, zero findings. Also read /var/tmp/closeout/sc-dc.out. The registered integration test reaches doctor reporting and --fix dispatch.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"validate\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"build:pose-mcp/go/build\\\",\\n      \\\"rationale\\\": \\\"Consumed the supplied sealed strict-validation run, including build, unit, integration and e2e results. Did not rerun build or validation writers in the read-only sandbox. Passing registered checks do not cover the three reported negative cases.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"validate\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Consumed the sealed pose-mcp validation results and read the capability's real-repository tests. The pipeline is the validation producer; no package tests or build outputs were written during this independent review.\\\"\\n    }\\n  ]\\n}\\n```\"}}\n.pose/review-runs/rrn-756eaba8977c78a6.events.ndjson:47:{\"v\":1,\"seq\":47,\"kind\":\"tool_output\",\"tool\":\"shell\",\"text\":\"SD-d29398e6 2e30bb53\\nSD-7d460311 604a6363\\nSD-9fc0fe4e 5c1c5658\\nSD-16da51ec 1995df71\\nSD-c828715b 34dd49f6\\nSD-300f6872 2bf2adf1\\nSD-f236a08f 2fd7c35f\",\"exit_code\":0,\"call\":\"call-22\"}\n.pose/review-runs/rrn-f0d738ef7de4226e.json:117:  \"output\": \"decision: changes-requested\\n\\nFound six defects, including a remaining part of R1-F5. The repository is unchanged; no attestation was recorded.\\n\\nRules applied: POSE review workflow, backend Go, security, documentation style and delivery evidence. I inspected the scoped implementation, CI steps, validation registration, spec and regression tests. Package tests and validation rely on the sealed pipeline evidence because this sandbox prohibits writes.\\n\\nGit’s documented behavior supports the shallow-history, filter-generation and configuration-precedence findings. [Git commit-graph documentation](https://git-scm.com/docs/git-commit-graph), [Git 2.56 implementation](https://github.com/git/git/blob/v2.56.0/commit-graph.c). The partial-clone finding follows Git’s automatic fetching of missing objects. [Partial-clone documentation](https://git-scm.com/docs/partial-clone).\\n\\n```pose-draft\\n{\\n  \\\"schema\\\": \\\"pose.review.draft/v1\\\",\\n  \\\"decision\\\": \\\"changes-requested\\\",\\n  \\\"findings\\\": [\\n    {\\n      \\\"id\\\": \\\"F9\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 100,\\n      \\\"summary\\\": \\\"A shallow repository with at least 500 reachable commits receives a fixable rewrite recommendation, but Git refuses both reading and writing commit-graphs while shallow boundaries exist. writeCommitGraph therefore returns success without resolving the finding, violating R2. A read-only probe using --shallow-file with HEAD~499 confirmed a count of 500, is-shallow-repository=true and no Bloom statistics. Git 2.56 commit-graph.c checks commit_graph_compatible for both reads and writes and returns success without writing for shallow history. Detect this condition and provide actionable remediation or explicitly reconcile the requirements; add a shallow-history regression.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"F10\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 154,\\n      \\\"summary\\\": \\\"The fix inherits commitGraph.maxNewFilters. With maxNewFilters=0 and no existing filters, --changed-paths computes no new filters, so the command succeeds while the recheck remains next indefinitely. Git documents this setting as the default filter-generation limit; Git 2.56 compute_bloom_filters permits computation only below that limit. R2's promised post-fix ok is therefore not guaranteed. Diagnose the effective generation limit or deliberately override it for this explicit repair, and cover zero and restrictive limits.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"F11\\\",\\n      \\\"severity\\\": \\\"low\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 80,\\n      \\\"summary\\\": \\\"An empty HEAD tree above the history threshold returns a successful state with filtersUsed=false before probing or checking disabled reads. doctor.go consequently recommends a rewrite forever, including immediately after a successful fix; disabled-read settings are also omitted. This is possible with an installed, untracked .pose directory and a committed empty tree. R2 has no nonempty-tree exclusion. Handle the absence of a probeable path explicitly and add a regression.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"F12\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 118,\\n      \\\"summary\\\": \\\"The disabled-read diagnosis ignores Git configuration precedence. commitGraph.changedPathsVersion overrides the deprecated commitGraph.readChangedPaths setting. With readChangedPaths=false, changedPathsVersion=1 and a missing graph, this function incorrectly reports reads disabled, removes the automatic repair and asks the user to unset a setting that is ineffective. A read-only trace with both settings confirmed Git actually consulting filters (maybe=1, definitely_not=1141). Resolve the effective version before interpreting the deprecated boolean and test conflicting settings against R3.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"F13\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 75,\\n      \\\"summary\\\": \\\"The diagnostic is not guaranteed read-only in a partial clone. Recursive ls-tree, and subsequently the path-history lookup, can encounter promised trees absent locally and cause Git to fetch and store them under the object directory. commitGraphGit uses RawHistoryGit without disabling lazy fetch; gitCommandContext likewise provides no GIT_NO_LAZY_FETCH protection. A tree-filtered or sparse partial clone with sufficient history can therefore mutate .git during plain doctor or a fix preview, contrary to the spec's read-only constraint. Disable lazy fetching for diagnostic commands and report unavailable local state; cover missing promised trees without contacting the remote.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"F14\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/doctor_commit_graph.go\\\",\\n      \\\"line\\\": 166,\\n      \\\"summary\\\": \\\"Operational graph-read diagnostics are discarded whenever Git exits successfully. Git can reject a truncated or malformed graph, print an error or warning to stderr, fall back to ordinary object traversal and still complete rev-list/log with exit status zero. This helper then returns no error, and doctor reports next (or ok below the threshold) rather than R3's bounded warn explaining the read failure. Git 2.56 load_commit_graph_one_fd_st rejects undersized files, while prepare_commit_graph permits fallback. Preserve and classify graph-read failures even on successful commands, with a corrupt-graph regression. This leaves R1-F5 partially unresolved.\\\"\\n    }\\n  ],\\n  \\\"prior_findings\\\": [\\n    {\\n      \\\"id\\\": \\\"R1-F2\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"doctor_commit_graph.go:92 delegates graph selection and Bloom lookup to Git instead of constructing graph paths. TestDoctorRecommendsTheCommitGraph covers an alternate-only graph through clone --shared; sealed integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration passes. Git itself resolves alternate base layers.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F3\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"doctor_commit_graph.go:92 uses Git's active graph. TestDoctorRecommendsTheCommitGraph covers an unfiltered monolithic graph beside a filtered split chain and expects next; sealed integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration passes.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F4\\\",\\n      \\\"status\\\": \\\"fixed\\\",\\n      \\\"evidence\\\": \\\"The custom graph-header/chunk parser is removed. doctor_commit_graph.go:92 and :129 now recognize actual filter use reported by Git, so unsupported or truncated graph headers cannot independently produce a false positive from chunk identifiers. Sealed integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration passes. Failure reporting is separately addressed by F14.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"R1-F5\\\",\\n      \\\"status\\\": \\\"partial\\\",\\n      \\\"evidence\\\": \\\"doctor.go:371 now warns for returned state errors, and TestDoctorCommitGraphReportsAnUnreadableHistory plus TestDoctorCommitGraphTellsUnbornFromBroken cover missing commits and invalid repository configuration. However, doctor_commit_graph.go:166-174 drops stderr when Git successfully falls back after a graph-read failure; see F14.\\\"\\n    }\\n  ],\\n  \\\"sweep\\\": \\\"Reviewed every scoped implementation/governance file, R1-R4 and D1, doctor fix registration/classification/recheck, Git environment construction, applicability and error paths, trace parsing and temporary-file lifecycle, alternate and split graph behavior, configuration precedence, shallow and partial clones, empty trees, filter-generation limits, both full-history CI jobs, validation-matrix registration, and all new regression tests. Read sealed validation results and artifact/surface outputs; ran context resolution, suggest-review, artifact-check, surface-check, recurrence-check and read-only Git probes. No builds, fixture creation, assessments, fixes, repository changes or attestations were performed.\\\",\\n  \\\"criteria\\\": [\\n    {\\n      \\\"id\\\": \\\"assumption-integrity\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F9\\\",\\n      \\\"rationale\\\": \\\"The design assumes lack of filter use implies a graph rewrite can repair the repository. Shallow history disproves that assumption; generation limits and empty trees expose additional unresolved cases. The documented trace-event compatibility risk is explicit.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-concurrency\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"No new concurrent production state or goroutines were introduced. Commands are synchronous, trace files are unique and removal is deferred; the mutable threshold is used by serial tests.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-contracts\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"The existing doctor report and remediation registry contracts remain additive; no MCP, REST or event schema is changed.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-input-errors\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F14\\\",\\n      \\\"rationale\\\": \\\"Fatal Git errors carry bounded context, but successful fallback after graph corruption loses the required diagnostic.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-integration-impact\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F9\\\",\\n      \\\"rationale\\\": \\\"The Git integration does not account for shallow repositories in which the proposed repair is a successful no-op.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-observability\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F14\\\",\\n      \\\"rationale\\\": \\\"Graph-read diagnostics on successful Git commands are discarded.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"compatibility\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Examined doctor JSON construction, finding classification and fix dispatch. New check codes and the registry entry preserve existing report fields and explicit fix authorization.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"correctness\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F10\\\",\\n      \\\"rationale\\\": \\\"The repair does not guarantee filter generation under supported Git configuration.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"design-causality\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-9f56d2c784426404\\\",\\n      \\\"rationale\\\": \\\"D1 places repository maintenance in explicit doctor remediation rather than governance reads. Asking Git for observed filter use removes the independent parser that caused alternate, precedence and header defects. Permanent integration registration supplies executable evidence for this capability; the implementation still needs the negative cases listed in findings.\\\",\\n      \\\"mappings\\\": [\\n        {\\n          \\\"delta\\\": \\\"SD-9fc0fe4e\\\",\\n          \\\"basis\\\": \\\"R2\\\",\\n          \\\"disposition\\\": \\\"mapped\\\",\\n          \\\"rationale\\\": \\\"The validation-matrix integration check exercises production doctor fix dispatch and the subsequent diagnostic recheck.\\\"\\n        },\\n        {\\n          \\\"delta\\\": \\\"SD-d29398e6\\\",\\n          \\\"basis\\\": \\\"R3\\\",\\n          \\\"disposition\\\": \\\"mapped\\\",\\n          \\\"rationale\\\": \\\"The same capability's permanent check registers applicability, literal-path, unreadable-history and disabled-read regressions. Both structural facts identify the shared validation-matrix path.\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"id\\\": \\\"documentation\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Examined the spec, inline operational explanations, displayed commands and CI comments. They describe the intended explicit repair flow and trace dependency; no public schema migration or scaffold change is required. Runtime exceptions to the promised behavior are reported as findings.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"operability\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F12\\\",\\n      \\\"rationale\\\": \\\"The configuration diagnosis can suppress the useful repair and direct users to change an ineffective setting.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"requirements\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F11\\\",\\n      \\\"rationale\\\": \\\"R1 and R4 have relevant positive evidence, but R2's unconditional post-fix ok and R3's configuration/error behavior are not satisfied across the identified negative cases.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"scope\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-9f56d2c784426404\\\",\\n      \\\"rationale\\\": \\\"The attributed implementation matches the approved doctor capability, CI preparation and permanent validation registration. Shared-file changes belonging to other specs were distinguished from this capability's additions.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"security\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"F13\\\",\\n      \\\"rationale\\\": \\\"Arguments are passed without shell interpolation, but diagnostic Git reads can cross the promised mutation boundary through lazy fetching.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"solution-proportionality\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-9f56d2c784426404\\\",\\n      \\\"rationale\\\": \\\"Examined D1 and the removed parser alternative. A small doctor check, fixed repair command and two CI steps fit the measured problem without background maintenance or new storage abstractions. Delegating graph semantics to Git is smaller than maintaining a graph parser. The choice requires reconsideration if trace statistics cease to be available or cannot distinguish actionable states.\\\"\\n    }\\n  ],\\n  \\\"tools\\\": [\\n    {\\n      \\\"id\\\": \\\"artifact-check\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"command:pose artifact-check --spec pose-doctor-recommends-the-commit-graph --strict\\\",\\n      \\\"rationale\\\": \\\"Executed successfully. Also inspected /var/tmp/closeout/ac-dc.out, which binds the requested sealed range and change set; it contains pre-existing orphan warnings. The live rerun resolved a later range, so the supplied sealed output was used for subject attribution.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-design\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"structure:design-9f56d2c784426404\\\",\\n      \\\"rationale\\\": \\\"Used the sealed structural result and independently inspected D1 and the matrix changes. Did not rerun assessment commands that may write repository artifacts.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-discover\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/assessment-freshness-integration\\\",\\n      \\\"rationale\\\": \\\"Recommended assessment was not rerun under the read-only boundary. Component scope and current validation were inspected directly; this evidence ref does not claim a fresh discovery execution.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-integrate\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"No MCP, REST, Protobuf or event contract changed. Examined the production CLI/Git boundary and sealed integration evidence without running a writing assessment.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-tech-debt\\\",\\n      \\\"disposition\\\": \\\"not-used\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Did not run a writing assessment. Manually inspected the scoped code for unfinished implementations and markers and read the spec's owned performance follow-up.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"closeout-check\\\",\\n      \\\"disposition\\\": \\\"deferred\\\",\\n      \\\"rationale\\\": \\\"Completion tool requires the recorded review conclusion; no attestation was authorized or recorded by this reviewer.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"review-check\\\",\\n      \\\"disposition\\\": \\\"deferred\\\",\\n      \\\"rationale\\\": \\\"Requires POSE to record this verified run's conclusion before the completed review can be checked.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"suggest-review\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"command:pose suggest review --path pose-mcp\\\",\\n      \\\"rationale\\\": \\\"Executed and applied the selected backend-go, security and documentation-style rules.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"surface-check\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Ran pose surface-check --spec pose-doctor-recommends-the-commit-graph --strict successfully: one target, 232 results, zero findings. Also inspected /var/tmp/closeout/sc-dc.out for the supplied sealed subject. This establishes composition, not correctness of every negative case.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"validate\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/doctor-recommends-the-commit-graph-integration\\\",\\n      \\\"rationale\\\": \\\"Disposed from the sealed pipeline's pose validate --strict run and .pose/results/delivery-validation.json. Inspected its exact registered test selection and passing output. No writing validation rerun was attempted in this sandbox.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"validate\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\",\\n      \\\"rationale\\\": \\\"The sealed validation includes the pose-mcp package tests, build and integration checks covering this module. Tests were read independently; build/test reruns requiring temporary files were prohibited.\\\"\\n    }\\n  ]\\n}\\n```\",\n.pose/review-runs/rrn-f0d738ef7de4226e.events.ndjson:18:{\"v\":1,\"seq\":18,\"kind\":\"tool_call\",\"tool\":\"shell\",\"text\":\"rg -n 'func RawHistoryGit' pose-mcp; nl -ba pose-mcp/internal/cli/doctor_commit_graph.go | sed -n '40,195p'; sed -n '140,220p' pose-mcp/internal/cli/doctor.go; git --version; git ls-tree -r --name-only HEAD | head -3; rg -n 'SD-9fc0fe4e|SD-d29398e6' .pose/review-bundles/rvb-* | tail -8\",\"call\":\"call-9\"}\n.pose/review-runs/rrn-f0d738ef7de4226e.events.ndjson:19:{\"v\":1,\"seq\":19,\"kind\":\"tool_output\",\"tool\":\"shell\",\"text\":\"… ng, env []string, args ...string) (string, error) {\\n   161\\t\\tcmd := posemodel.RawHistoryGit(root, args...)\\n   162\\t\\t// Git's messages are read below; they are read in the C locale.\\n   163\\t\\tcmd.Env = append(append(cmd.Env, \\\"LC_ALL=C\\\", \\\"LANGUAGE=C\\\"), env...)\\n   164\\t\\tvar stderr bytes.Buffer\\n   165\\t\\tcmd.Stderr = \\u0026stderr\\n   166\\t\\tout, err := cmd.Output()\\n   167\\t\\tif err != nil {\\n   168\\t\\t\\tdetail := strings.TrimSpace(stderr.String())\\n   169\\t\\t\\tif len(detail) \\u003e 200 {\\n   170\\t\\t\\t\\tdetail = detail[:200] + \\\"…\\\"\\n   171\\t\\t\\t}\\n   172\\t\\t\\treturn string(out), \\u0026commitGraphGitError{args: args[0], err: err, detail: detail}\\n   173\\t\\t}\\n   174\\t\\treturn string(out), nil\\n   175\\t}\\n   176\\t\\n   177\\t// commitGraphGitError is a failed Git command with its stderr, bounded; it\\n   178\\t// unwraps to the command's error, an *exec.ExitError when Git ran.\\n   179\\ttype commitGraphGitError struct {\\n   180\\t\\targs   string\\n   181\\t\\terr    error\\n   182\\t\\tdetail string\\n   183\\t}\\n   184\\t\\n   185\\tfunc (e *commitGraphGitError) Error() string {\\n   186\\t\\tif e.detail == \\\"\\\" {\\n   187\\t\\t\\treturn \\\"git \\\" + e.args + \\\" \\\" + e.err.Error()\\n   188\\t\\t}\\n   189\\t\\treturn \\\"git \\\" + e.args + \\\": \\\" + e.err.Error() + \\\" \\\" + e.detail\\n   190\\t}\\n   191\\t\\n   192\\tfunc (e *commitGraphGitError) Unwrap() error { return e.err }\\n\\nfunc cmdDoctor(args []string, stdout, stderr io.Writer) int {\\n\\tlocale := cliLocaleValue()\\n\\ttext := func(english, portuguese string) string { return cliText(locale, english, portuguese) }\\n\\tjsonOut, fix, yes := false, false, false\\n\\tonly := \\\"\\\"\\n\\tfor i := 0; i \\u003c len(args); i++ {\\n\\t\\ta := args[i]\\n\\t\\tswitch a {\\n\\t\\tcase \\\"--json\\\":\\n\\t\\t\\tjsonOut = true\\n\\t\\tcase \\\"--fix\\\":\\n\\t\\t\\tfix = true\\n\\t\\tcase \\\"--dry-run\\\":\\n\\t\\t\\t// explicit alias for --fix's default (no-op if --yes not set)\\n\\t\\tcase \\\"--yes\\\":\\n\\t\\t\\tyes = true\\n\\t\\tcase \\\"--only\\\":\\n\\t\\t\\tif i+1 \\u003e= len(args) {\\n\\t\\t\\t\\tfmt.Fprintln(stderr, text(\\\"Error: --only requires a check code\\\", \\\"Erro: --only exige um código de check\\\"))\\n\\t\\t\\t\\treturn 2\\n\\t\\t\\t}\\n\\t\\t\\ti++\\n\\t\\t\\tonly = args[i]\\n\\t\\tcase \\\"-h\\\", \\\"--help\\\":\\n\\t\\t\\tfmt.Fprintln(stdout, text(\\n\\t\\t\\t\\t\\\"Usage: pose doctor [--json] [--fix [--yes] [--only \\u003ccheck\\u003e]] — read-only diagnostics, optional guided remediation\\\",\\n\\t\\t\\t\\t\\\"Uso: pose doctor [--json] [--fix [--yes] [--only \\u003ccheck\\u003e]] — diagnóstico read-only, remediação guiada opcional\\\"))\\n\\t\\t\\treturn 0\\n\\t\\tdefault:\\n\\t\\t\\tfmt.Fprintf(stderr, text(\\\"Error: invalid argument: %s\\\\n\\\", \\\"Erro: argumento inválido: %s\\\\n\\\"), a)\\n\\t\\t\\treturn 2\\n\\t\\t}\\n\\t}\\n\\tif yes \\u0026\\u0026 !fix {\\n\\t\\tfmt.Fprintln(stderr, text(\\\"Error: --yes requires --fix\\\", \\\"Erro: --yes exige --fix\\\"))\\n\\t\\treturn 2\\n\\t}\\n\\tif only != \\\"\\\" \\u0026\\u0026 !fix {\\n\\t\\tfmt.Fprintln(stderr, text(\\\"Error: --only requires --fix\\\", \\\"Erro: --only exige --fix\\\"))\\n\\t\\treturn 2\\n\\t}\\n\\tif only != \\\"\\\" {\\n\\t\\tif _, ok := doctorFixRegistry[only]; !ok {\\n\\t\\t\\tfmt.Fprintf(stderr, text(\\\"Error: %q is not a fixable check code (available: %s)\\\\n\\\", \\\"Erro: %q não é um código de check corrigível (disponíveis: %s)\\\\n\\\"), only, strings.Join(fixableCodes(), \\\", \\\"))\\n\\t\\t\\treturn 2\\n\\t\\t}\\n\\t}\\n\\n\\troot, findings := runDoctorDiagnostics(locale)\\n\\tif !fix {\\n\\t\\treturn doctorReport(root, findings, jsonOut, stdout, locale)\\n\\t}\\n\\n\\tvar candidates []string\\n\\tfor _, f := range findings {\\n\\t\\tif f.RemediationClass != remediationFixable {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif only != \\\"\\\" \\u0026\\u0026 f.FixCode != only {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tcandidates = append(candidates, f.FixCode)\\n\\t}\\n\\n\\tif !yes {\\n\\t\\treturn doctorFixPreview(findings, candidates, jsonOut, stdout, locale)\\n\\t}\\n\\treturn doctorFixApply(root, findings, candidates, jsonOut, stdout, stderr, locale)\\n}\\n\\nfunc fixableCodes() []string {\\n\\tcodes := make([]string, 0, len(doctorFixRegistry))\\n\\tfor c := range doctorFixRegistry {\\n\\t\\tcodes = append(codes, c)\\n\\t}\\n\\treturn codes\\n}\\n\\n// runDoctorDiagnostics is the read-only diagnostic pass, factored out so\\n// --fix --yes can call it again after applying fixes (recheck, R3).\\ngit version 2.56.0\\n.agents/skills/README.md\\n.agents/skills/pose-adr/SKILL.md\\n.agents/skills/pose-bugfix/SKILL.md\\n.pose/review-bundles/rvb-82a87889d85ce8dd.json:662:            \\\"id\\\": \\\"SD-9fc0fe4e\\\",\\n.pose/review-bundles/rvb-82a87889d85ce8dd.json:669:            \\\"id\\\": \\\"SD-d29398e6\\\",\\n.pose/review-bundles/rvb-b5149e7feaba9233.json:656:            \\\"id\\\": \\\"SD-9fc0fe4e\\\",\",\"exit_code\":0,\"call\":\"call-9\"}\n.pose/review-runs/rrn-756eaba8977c78a6.transcript:48:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_24\",\"type\":\"command_execution\",\"command\":\"/usr/bin/bash -lc \\\"python3 - <<'PY'\\nimport subprocess,json,hashlib\\np='.pose/indexes/validation-matrix.json'\\ncommits=subprocess.check_output(['git','log','--format=%H','319bfd9c..7e2b4a3e','--',p],text=True).split()\\nfor c in commits:\\n def blob(rev):\\n  return subprocess.check_output(['git','show',rev+':'+p])\\n before,after=blob(c+'\\\"'^'\\\"'),blob(c)\\n d=dict(zip(['Kind','Action','State','Subject','Path','OldPath','NewPath','Runtime','BeforeDigest','AfterDigest'],['delivery-metadata','changed','observed',p,p,'','','','sha256:'+hashlib.sha256(before).hexdigest(),'sha256:'+hashlib.sha256(after).hexdigest()]))\\n key=json.dumps(d,separators=(',',':')).encode()\\n print('SD-'+hashlib.sha256(key).hexdigest()[:8],c[:8])\\nPY\\\"\",\"aggregated_output\":\"SD-d29398e6 2e30bb53\\nSD-7d460311 604a6363\\nSD-9fc0fe4e 5c1c5658\\nSD-16da51ec 1995df71\\nSD-c828715b 34dd49f6\\nSD-300f6872 2bf2adf1\\nSD-f236a08f 2fd7c35f\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n.pose/review-bundles/rvb-dab8d0ff3a0a8d27.json:662:            \"id\": \"SD-9fc0fe4e\",\n.pose/review-bundles/rvb-dab8d0ff3a0a8d27.json:669:            \"id\": \"SD-d29398e6\",\n.pose/review-bundles/rvb-b5149e7feaba9233.json:656:            \"id\": \"SD-9fc0fe4e\",\n.pose/review-bundles/rvb-82a87889d85ce8dd.json:662:            \"id\": \"SD-9fc0fe4e\",\n.pose/review-bundles/rvb-82a87889d85ce8dd.json:669:            \"id\": \"SD-d29398e6\",\n","exit_code":0,"status":"completed"}}
