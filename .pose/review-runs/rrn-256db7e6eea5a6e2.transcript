ility:pose-mcp/go/typed-diagnostics-reachability, reachability:pose-mcp/go/usage-adjudication-reachability, reachability:pose-mcp/go/validate-jobs-reachability, unit:pose-mcp/go/test\\n[WARN] unmapped review component path:.pose/specs/2026-11-23-pose-review-declared-threat-model.md\\n[WARN] unmapped review component path:POSE.md\\n[WARN] unmapped review component path:locales/pt-BR/POSE.md\",\"exit_code\":0,\"call\":\"call-5\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:21:{\"v\":1,\"seq\":21,\"kind\":\"tool_call\",\"tool\":\"shell\",\"text\":\"cat .pose/workflows/review.md \\u0026\\u0026 cat .pose/rules/security.md \\u0026\\u0026 cat .pose/rules/documentation-style.md \\u0026\\u0026 cat .pose/rules/backend-go.md \\u0026\\u0026 cat .pose/specs/2026-11-23-pose-review-declared-threat-model.md\",\"call\":\"call-10\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:24:{\"v\":1,\"seq\":24,\"kind\":\"tool_output\",\"tool\":\"shell\",\"text\":\"… wDraftMaxText          = 4000\\n \\tReviewRoundThresholdDefault = 5\\n )\\n \\n // A finding's own identifier never carries a round prefix, which the engine\\n // reserves; the identity it is carried under is that prefix and the\\n // identifier, so the mapping is injective (review round 1, B2, B12).\\n var (\\n \\treviewFindingID   = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\\n \\treviewRoundPrefix = regexp.MustCompile(`^R[0-9]+-`)\\n \\treviewCarriedID   = regexp.MustCompile(`^R[0-9]{1,6}-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\\n \\t// reviewDraftOpening is any fence line that names pose-draft.\\n \\treviewDraftOpening = regexp.MustCompile(\\\"^(`{3,}|~{3,})\\\\\\\\s*pose-draft\\\")\\n )\\n \\n // ReviewDraftFinding is one finding a draft reports.\\n type ReviewDraftFinding struct {\\n \\tID          string `json:\\\"id\\\"`\\n \\tSeverity    string `json:\\\"severity\\\"`\\n \\tDisposition string `json:\\\"disposition\\\"`\\n \\tFile        string `json:\\\"file,omitempty\\\"`\\n \\tLine        int    `json:\\\"line,omitempty\\\"`\\n \\tSummary     string `json:\\\"summary\\\"`\\n \\t// Action, Owner and ReviewBy let a follow-up become an accepted risk in\\n \\t// the attestation the engine records (spec\\n \\t// pose-delegated-review-conclusions R1).\\n \\tAction   string `json:\\\"action,omitempty\\\"`\\n \\tOwner    string `json:\\\"owner,omitempty\\\"`\\n \\tReviewBy string `json:\\\"review_by,omitempty\\\"`\\n+\\t// Limit names the declared accepted limit the finding falls inside\\n+\\t// (spec pose-review-declared-threat-model R2).\\n+\\tLimit string `json:\\\"limit,omitempty\\\"`\\n }\\n \\n // ReviewDraftCriterion answers one criterion of the plan, as the reviewer of\\n // a recorded attestation does (spec pose-delegated-review-conclusions R1).\\n type ReviewDraftCriterion struct {\\n \\tID          string `json:\\\"id\\\"`\\n \\tDisposition string `json:\\\"disposition\\\"`\\n \\tEvidence    string `json:\\\"evidence,omitempty\\\"`\\n \\tRationale   string `json:\\\"rationale,omitempty\\\"`\\n \\t// Mappings answer the structural facts the criterion is responsible for,\\n \\t// as `--criterion` mappings do; the writer's gate judges them (review\\n \\t// round 1, B4).\\n \\tMappings []ReviewCriterionMapping `json:\\\"mappings,omitempty\\\"`\\n }\\n \\n // ReviewDraftTool is the disposition of one tool the plan requires.\\n type ReviewDraftTool struct {\\n \\tID          string `json:\\\"id\\\"`\\n \\tComponent   string `json:\\\"component,omitempty\\\"`\\n \\tDisposition string `json:\\\"disposition\\\"`\\n \\tEvidence    string `json:\\\"evidence,omitempty\\\"`\\n \\tRationale   string `json:\\\"rationale,omitempty\\\"`\\n }\\n \\n // ReviewDraftPrior is a draft's account of one prior finding (R3, R4).\\n type ReviewDraftPrior struct {\\n \\tID       string `json:\\\"id\\\"`\\n \\tStatus   string `json:\\\"status\\\"`\\n \\tEvidence string `json:\\\"evidence\\\"`\\n }\\n \\n // ReviewDraft is the pose-draft block of a reviewer's final message.\\n type ReviewDraft struct {\\n \\tSchema        string               `json:\\\"schema\\\"`\\n \\tDecision      string               `json:\\\"decision\\\"`\\n \\tFindings      []ReviewDraftFinding `json:\\\"findings\\\"`\\n \\tPriorFindings []ReviewDraftPrior   `json:\\\"prior_findings,omitempty\\\"`\\n \\tSweep         string               `json:\\\"sweep,omitempty\\\"`\\n \\t// Criteria and Tools are the typed conclusion the engine records as an\\n \\t// attestation (spec pose-delegated-review-conclusions R1).\\n \\tCriteria []ReviewDraftCriterion `json:\\\"criteria,omitempty\\\"`\\n \\tTools    []ReviewDraftTool      `json:\\\"tools,omitempty\\\"`\\n \\t// Questions and Surfaces are the typed verdict of an adjudication and of\\n \\t// a smoke run, recorded where their origin reads them (spec\\n \\t// pose-delegated-verdict-destinations R1, R2).\\n \\tQuestions []ReviewDraftQuestion `json:\\\"questions,omitempty\\\"`\\n \\tSurfaces  []ReviewDraftSurface  `json:\\\"surfaces,omitempty\\\"`\\n \\t// BusinessDecision is a question the reviewer cannot answer from the\\n \\t// code, for a person to decide (spec\\n \\t// pose-delegated-review-action-fulfillment R7).\\n \\tBusinessDecision *ReviewDraftBusinessDecision `json:\\\"business_decision,omitempty\\\"`\\n }\\n \\n // ReviewDraftBusinessDecision is a business question and its options.\\n type ReviewDraftBusinessDecision struct {\\n \\tQuestion string         `json:\\\"question\\\"`\\n \\tOptions  []ActionOption `json:\\\"options\\\"`\\n }\\n \\n // ReviewDraftQuestion is an adjudication's verdict on one question the\",\"exit_code\":0,\"call\":\"call-11\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:32:{\"v\":1,\"seq\":32,\"kind\":\"tool_output\",\"tool\":\"shell\",\"text\":\"… corded within-limit, naming it, and does not block an approval whatever\\n    58\\t// its severity; a limit the bundle did not seal accepts nothing.\\n    59\\tfunc TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\\n    60\\t\\tvar bundle ReviewBundle\\n    61\\t\\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \\\"L1\\\", Text: \\\"x. Accepted because y.\\\"}}\\n    62\\t\\tdraft := ReviewDraft{Decision: \\\"approved\\\", Findings: []ReviewDraftFinding{\\n    63\\t\\t\\t{ID: \\\"N1\\\", Severity: \\\"high\\\", Disposition: \\\"follow-up\\\", Summary: \\\"an orphan that clears its environment escapes; that is L1\\\", Limit: \\\"L1\\\"},\\n    64\\t\\t}}\\n    65\\t\\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \\\"rrn-0000000000000001\\\"}, bundle, draft, \\\"agent:reviewer\\\")\\n    66\\t\\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \\\"within-limit\\\" || att.Findings[0].Limit != \\\"L1\\\" {\\n    67\\t\\t\\tt.Fatalf(\\\"the finding was not recorded within its limit: %+v\\\", att.Findings)\\n    68\\t\\t}\\n    69\\t\\tatt.Decision = \\\"approved\\\"\\n    70\\t\\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\\n    71\\t\\t\\tt.Fatalf(\\\"a finding within a sealed limit blocked the approval: %v\\\", blockers)\\n    72\\t\\t}\\n    73\\t\\tatt.Findings[0].Limit = \\\"L9\\\"\\n    74\\t\\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \\\"\\\\n\\\"); !strings.Contains(blockers, \\\"L9, which this bundle did not seal\\\") {\\n    75\\t\\t\\tt.Fatalf(\\\"an unsealed limit was accepted: %s\\\", blockers)\\n    76\\t\\t}\\n    77\\t\\tatt.Findings[0].Limit, att.Findings[0].Rationale = \\\"L1\\\", \\\"\\\"\\n    78\\t\\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \\\"\\\\n\\\"); !strings.Contains(blockers, \\\"without saying why\\\") {\\n    79\\t\\t\\tt.Fatalf(\\\"a finding within a limit without a reason was accepted: %s\\\", blockers)\\n    80\\t\\t}\\n    81\\t}\\n     1\\tpackage cli\\n     2\\t\\n     3\\timport (\\n     4\\t\\t\\\"bytes\\\"\\n     5\\t\\t\\\"os\\\"\\n     6\\t\\t\\\"path/filepath\\\"\\n     7\\t\\t\\\"strings\\\"\\n     8\\t\\t\\\"testing\\\"\\n     9\\t)\\n    10\\t\\n    11\\t// Spec pose-review-declared-threat-model R4: the ready check refuses an\\n    12\\t// accepted limit without its reason, and one an ADR citing the spec omits.\\n    13\\tfunc TestReadyCheckJudgesAcceptedLimits(t *testing.T) {\\n    14\\t\\troot := t.TempDir()\\n    15\\t\\twrite := func(rel, body string) {\\n    16\\t\\t\\tp := filepath.Join(root, rel)\\n    17\\t\\t\\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\\n    18\\t\\t\\t\\tt.Fatal(err)\\n    19\\t\\t\\t}\\n    20\\t\\t\\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\\n    21\\t\\t\\t\\tt.Fatal(err)\\n    22\\t\\t\\t}\\n    23\\t\\t}\\n    24\\t\\tspec := func(limits string) string {\\n    25\\t\\t\\treturn \\\"---\\\\nslug: limited\\\\nstatus: draft\\\\ncreated_at: 2026-11-25\\\\n---\\\\n\\\\n# Spec: limited\\\\n\\\\n## 1. Intent\\\\n\\\\n### Goal\\\\nA goal worth stating.\\\\n\\\\n## 2. Requirements\\\\n\\\\n### Functional\\\\n- R1: It works.\\\\n\\\\n## 3. Technical Plan\\\\n\\\\n### Affected areas\\\\nThe engine.\\\\n\\\" + limits + \\\"\\\\n## 4. Tasks\\\\n- [ ] Do it.\\\\n\\\"\\n    26\\t\\t}\\n    27\\t\\tpath := filepath.Join(root, \\\".pose/specs/limited/spec.md\\\")\\n    28\\t\\trun := func() (int, string) {\\n    29\\t\\t\\tvar out, errOut bytes.Buffer\\n    30\\t\\t\\tcode := lintOneSpec(path, false, true, \\u0026out, \\u0026errOut)\\n    31\\t\\t\\treturn code, out.String() + errOut.String()\\n    32\\t\\t}\\n    33\\t\\twrite(\\\".pose/specs/limited/spec.md\\\", spec(\\\"\\\\n### Accepted limits\\\\n- L1: an escape. Accepted because it is rare.\\\\n\\\"))\\n    34\\t\\tif code, out := run(); code != 0 {\\n    35\\t\\t\\tt.Fatalf(\\\"a justified limit failed the ready check: %d %s\\\", code, out)\\n    36\\t\\t}\\n    37\\t\\twrite(\\\".pose/specs/limited/spec.md\\\", spec(\\\"\\\\n### Accepted limits\\\\n- L1: an escape with no reason.\\\\n\\\"))\\n    38\\t\\tif code, out := run(); code == 0 || !strings.Contains(out, \\\"does not say why it is accepted\\\") {\\n    39\\t\\t\\tt.Fatalf(\\\"an unjustified limit passed: %d %s\\\", code, out)\\n    40\\t\\t}\\n    41\\t\\twrite(\\\".pose/specs/limited/spec.md\\\", spec(\\\"\\\\n### Accepted limits\\\\n- L1: an escape. Accepted because it is rare.\\\\n- L2: another. Accepted because it is rarer.\\\\n\\\"))\\n    42\\t\\twrite(\\\".pose/adr/2026-11-25-limited.md\\\", \\\"# ADR\\\\n\\\\nFor `limited`. L1 is accepted.\\\\n\\\")\\n    43\\t\\tif code, out := run(); code == 0 || !strings.Contains(out, \\\"accepted limit L2 is not named by the ADR\\\") {\\n    44\\t\\t\\tt.Fatalf(\\\"a limit the ADR omits passed: %d %s\\\", code, out)\\n    45\\t\\t}\\n    46\\t}\",\"exit_code\":0,\"call\":\"call-15\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:37:{\"v\":1,\"seq\":37,\"kind\":\"tool_call\",\"tool\":\"shell\",\"text\":\"rg -n 'accepted.limit|threat.model|pose-review-declared-threat-model' .pose/knowledge .pose/adr 2\\u003e/dev/null | head -80\",\"call\":\"call-18\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:39:{\"v\":1,\"seq\":39,\"kind\":\"tool_call\",\"tool\":\"shell\",\"text\":\"nl -ba .pose/specs/2026-11-23-pose-review-declared-threat-model.md | sed -n '1,115p'; rg --files --hidden --no-ignore .pose/review-bundles | rg '8c5b48|9ef35f' || true\",\"call\":\"call-19\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:40:{\"v\":1,\"seq\":40,\"kind\":\"tool_output\",\"tool\":\"shell\",\"text\":\"…     40\\t### Non-functional\\n    41\\tExisting behaviour outside the stated requirements is unchanged.\\n    42\\t\\n    43\\t### Security\\n    44\\tNo new input crosses a trust boundary without the existing confinement.\\n    45\\t\\n    46\\t### Compatibility\\n    47\\tRecords and indexes written by earlier engines keep their meaning.\\n    48\\t\\n    49\\t## 3. Technical Plan\\n    50\\t\\n    51\\t### Affected areas\\n    52\\t`pose-mcp` (CLI and engine), the manual and its embedded copy.\\n    53\\t\\n    54\\t### Artifacts\\n    55\\t- created: .pose/specs/2026-11-23-pose-review-declared-threat-model.md\\n    56\\t- created: pose-mcp/internal/pose/accepted_limits.go\\n    57\\t- created: pose-mcp/internal/pose/accepted_limits_test.go\\n    58\\t- modified: pose-mcp/internal/pose/review_plan.go\\n    59\\t- modified: pose-mcp/internal/pose/review_bundle.go\\n    60\\t- modified: pose-mcp/internal/pose/review_rounds.go\\n    61\\t- modified: pose-mcp/internal/pose/review_closeout.go\\n    62\\t- modified: pose-mcp/internal/pose/review_conclusions.go\\n    63\\t- modified: pose-mcp/internal/pose/review_brief.go\\n    64\\t- modified: pose-mcp/internal/pose/review_brief_test.go\\n    65\\t- modified: pose-mcp/internal/pose/review_brief_versions_test.go\\n    66\\t- modified: pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\\n    67\\t- modified: pose-mcp/internal/pose/testdata/review_brief_template_digests.json\\n    68\\t- modified: pose-mcp/internal/cli/lintspec.go\\n    69\\t- created: pose-mcp/internal/cli/accepted_limits_lint_test.go\\n    70\\t- modified: POSE.md\\n    71\\t- modified: locales/pt-BR/POSE.md\\n    72\\t- modified: pose-mcp/internal/scaffold/dist/POSE.md\\n    73\\t- modified: pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\\n    74\\t\\n    75\\t\\n    76\\t### Delivery targets\\n    77\\t\\n    78\\t- capability:review-declared-threat-model module:pose-mcp profile:composed-capability entrypoint:pose-mcp/internal/cli/lintspec.go\\n    79\\t\\n    80\\t\\n    81\\t### Accepted limits\\n    82\\t- L1: The limits are written by the implementer, so a limit can be broader than it should be. Accepted because the brief presents them as data to verify and a disputed limit is a blocking finding of its own.\\n    83\\t- L2: A spec edited after sealing changes its limits only through a new bundle. Accepted because the limits enter the plan digest, so an edit stales the review as any other change does.\\n    84\\t\\n    85\\t### API/contract changes\\n    86\\tA spec section `### Accepted limits` with `- L\\u003cN\\u003e: \\u003cassumption\\u003e. Accepted because \\u003creason\\u003e.` entries. The review plan and the bundle seal them as `accepted_limits` (omitted when none, so every other plan and bundle keeps its digest). A draft finding may carry `limit`; the attestation records it with disposition `within-limit`. Brief template `review-brief/11`. `lint-spec --ready-check` checks the section.\\n    87\\t\\n    88\\t\\n    89\\t### Data/storage changes\\n    90\\t`accepted_limits` in review plans and bundles and `limit` in draft and attestation findings, all omitted when empty.\\n    91\\t\\n    92\\t\\n    93\\t### Technical risks\\n    94\\tA limit could be used to wave a real defect through. It is the spec's own declaration, sealed into the plan digest and visible in the brief and the attestation; the reviewer may dispute it with a finding of its own, which then blocks as any finding does.\\n    95\\t\\n    96\\t\\n    97\\t## 4. Tasks\\n    98\\t\\n    99\\t### Planning\\n   100\\t- [ ] Confirm the requirements against the current engine before starting.\\n   101\\t\\n   102\\t### Implementation\\n   103\\t- [ ] Implement each requirement with a test that fails before it.\\n   104\\t\\n   105\\t### Validation\\n   106\\t- [ ] `pose validate --carry` and `pose check --strict`.\\n   107\\t\\n   108\\t## 5. Decisions\\n   109\\t\\n   110\\t### Decision D1\\n   111\\t- Basis: R1, R2, R3\\n   112\\tA finding inside a declared limit is neither an open finding nor an accepted risk: it gets its own disposition, `within-limit`, which does not block an approval whatever its severity, requires a sealed limit and a reason, and records the limit's id. Accepted risks keep their severity bound; a limit is the spec's statement of scope, decided before the review.\\n   113\\t\\n   114\\t### Decision D2\\n   115\\t- Basis: R1, R4\",\"exit_code\":0,\"call\":\"call-19\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:47:{\"v\":1,\"seq\":47,\"kind\":\"tool_call\",\"tool\":\"shell\",\"text\":\"\\\"$POSE_REVIEW_CLI\\\" surface-check --spec pose-review-declared-threat-model --strict\",\"call\":\"call-23\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:56:{\"v\":1,\"seq\":56,\"kind\":\"tool_output\",\"tool\":\"shell\",\"text\":\"surface.spec=pose-review-declared-threat-model\\nsurface.targets=1\\nsurface.results=236\\nsurface.findings=0\\nsurface.provenance_digest=sha256:bf3a0a8b6428587e904c1885e93ca7a8694444479a50859ab524b48655243019\",\"exit_code\":0,\"call\":\"call-23\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:62:{\"v\":1,\"seq\":62,\"kind\":\"tool_output\",\"tool\":\"shell\",\"text\":\"… ch_digest\\\"`\\n   108\\t\\tTreeDigest           string                     `json:\\\"tree_digest\\\"`\\n   109\\t\\tEntries              []ReviewBundleSubjectEntry `json:\\\"entries\\\"`\\n   110\\t\\t// Attribution narrows each path to what this scope's own commits changed\\n   111\\t\\t// (see ReviewBundlePathAttribution). It is not implementation identity, so\\n   112\\t\\t// the implementation, patch and tree digests leave it out; it is sealed with\\n   113\\t\\t// the rest of the payload. Absent on bundles sealed before it existed, and\\n   114\\t\\t// whenever Git could not answer: the structural assessment then compares\\n   115\\t\\t// Base and Head.\\n   116\\t\\tAttribution []ReviewBundlePathAttribution `json:\\\"attribution,omitempty\\\"`\\n   117\\t}\\n   118\\t\\n   119\\ttype ReviewBundlePlan struct {\\n   120\\t\\tDelegatedRunProofRequired bool     `json:\\\"delegated_run_proof_required,omitempty\\\"`\\n   121\\t\\tLimitations               []string `json:\\\"limitations,omitempty\\\"`\\n   122\\t\\t// AcceptedLimits seals the residual limits the scope's spec declares, so\\n   123\\t\\t// the brief and the conclusion read them from the bundle (spec\\n   124\\t\\t// pose-review-declared-threat-model). Omitted when none, so every other\\n   125\\t\\t// bundle keeps its digest.\\n   126\\t\\tAcceptedLimits []ReviewAcceptedLimit `json:\\\"accepted_limits,omitempty\\\"`\\n   127\\t\\tPlanDigest     string                `json:\\\"plan_digest\\\"`\\n   128\\t\\tIndependence   string                `json:\\\"independence\\\"`\\n   129\\t\\tComponents     []ReviewPlanComponent `json:\\\"components\\\"`\\n   130\\t\\tCriteria       []ReviewPlanCriterion `json:\\\"criteria\\\"`\\n   131\\t\\tTools          []ReviewPlanTool      `json:\\\"tools\\\"`\\n   132\\t\\t// SelectedProfiles records which components each profile was selected for.\\n   133\\t\\t// A criterion names the profiles it came from, and without this mapping the\\n   134\\t\\t// sealed subject cannot say which components that criterion answers for —\\n   135\\t\\t// so evidence could only be matched by reference and class, never by where\\n   505\\tfunc (s Store) prepareReviewBundle(ref string, legacyMilestoneManifest bool) (ReviewBundle, error) {\\n   506\\t\\t// One index generation for the plan and for the evidence read after it.\\n   507\\t\\tif s.indexPin == nil {\\n   508\\t\\t\\ts = s.PinIndexes()\\n   509\\t\\t}\\n   510\\t\\tscope, err := ParseScopeRef(ref)\\n   511\\t\\tif err != nil {\\n   512\\t\\t\\treturn ReviewBundle{}, err\\n   513\\t\\t}\\n   514\\t\\tplan, err := s.ReviewPlan(ref)\\n   515\\t\\tif err != nil {\\n   516\\t\\t\\treturn ReviewBundle{}, err\\n   517\\t\\t}\\n   518\\t\\tbundle := ReviewBundle{SchemaVersion: ReviewBundleSchemaVersion, State: \\\"prepared\\\", Warnings: uniqueSorted(append([]string{}, plan.Warnings...)), Blockers: uniqueSorted(append([]string{}, plan.Blockers...))}\\n   519\\t\\tbundlePlanDigest, err := reviewBundlePlanDigest(plan)\\n   520\\t\\tif err != nil {\\n   521\\t\\t\\treturn ReviewBundle{}, err\\n   522\\t\\t}\\n   523\\t\\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview, AcceptedLimits: append([]ReviewAcceptedLimit(nil), plan.AcceptedLimits...)}\\n   524\\t\\n   525\\t\\tscopeProjection, excluded, err := s.reviewBundleScopeProjection(scope)\\n   526\\t\\tif err != nil {\\n   527\\t\\t\\treturn ReviewBundle{}, err\\n   528\\t\\t}\\n   529\\t\\tbundle.Payload.Scope = scopeProjection\\n   530\\t\\tbundle.ExcludedInputs = excluded\\n   531\\t\\n   532\\t\\tgraph, graphErr := s.GetDeliveryIntegrity(\\\"\\\")\\n   533\\t\\tif graphErr != nil {\\n   534\\t\\t\\tbundle.Blockers = append(bundle.Blockers, \\\"delivery integrity is unavailable: run pose index\\\")\\n   535\\t\\t} else {\\n   536\\t\\t\\tvar subjectExcluded []ReviewBundleInput\\n   537\\t\\t\\tbundle.Payload.Subject, subjectExcluded, bundle.Blockers, err = s.reviewBundleSubject(scope, bundle.Payload.Plan.Components, graph, bundle.Blockers)\\n   538\\t\\t\\tif err != nil {\\n   539\\t\\t\\t\\treturn ReviewBundle{}, err\\n   540\\t\\t\\t}\",\"exit_code\":1,\"call\":\"call-29\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:71:{\"v\":1,\"seq\":71,\"kind\":\"tool_call\",\"tool\":\"shell\",\"text\":\"'set -o pipefail; \\\"$POSE_REVIEW_CLI\\\" artifact-check --spec pose-review-declared-threat-model --strict 2\\u003e\\u00261 | rg '\\\"'artifact\\\\\\\\.(change_set|claims|observed|findings)|orphan .*accepted_limits|orphan .*review_(plan|bundle|closeout|conclusions|rounds|brief)|orphan .*lintspec|orphan .*POSE\\\\\\\\.md|orphan .*locales/pt-BR/POSE\\\\\\\\.md|accepted limit|lintspec.go|review_brief.go|review_plan.go|review_bundle.go|review_conclusions.go|review_rounds.go|review_closeout.go' || true\\\"\",\"call\":\"call-33\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:77:{\"v\":1,\"seq\":77,\"kind\":\"tool_call\",\"tool\":\"shell\",\"text\":\"'\\\"$POSE_REVIEW_CLI\\\" review bundle spec:pose-review-declared-threat-model --explain | rg '\\\"'\\\"'^(review_bundle'\\\"\\\\\\\\.|review_plan\\\\\\\\.|structure\\\\\\\\.|structural|delta|include\\\\\\\\.semantic-section=|include\\\\\\\\.subject=)'\\\"\",\"call\":\"call-35\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:90:{\"v\":1,\"seq\":90,\"kind\":\"tool_call\",\"tool\":\"shell\",\"text\":\"'\\\"$POSE_REVIEW_CLI\\\" review-plan spec:pose-review-declared-threat-model --json | rg '\\\"'plan_digest|accepted_limits|scope_digest'\\\"\",\"call\":\"call-41\"}\n.pose/review-runs/rrn-d1680df442b23d12.events.ndjson:91:{\"v\":1,\"seq\":91,\"kind\":\"tool_output\",\"tool\":\"shell\",\"text\":\"  \\\"scope_digest\\\": \\\"sha256:630addfc59bef1f1e89555cac72de734050cb626ba76eeb7ea7b91348b192c0d\\\",\\n  \\\"plan_digest\\\": \\\"sha256:55a60ed8cd30be693ef9e1323b788b3e0c96d59aaff06b402bb5b1de282baaf7\\\",\\n        \\\"artifact:pose-review-declared-threat-model:pose-mcp/internal/cli/accepted_limits_lint_test.go\\\",\\n        \\\"artifact:pose-review-declared-threat-model:pose-mcp/internal/pose/accepted_limits.go\\\",\\n        \\\"artifact:pose-review-declared-threat-model:pose-mcp/internal/pose/accepted_limits_test.go\\\",\\n        \\\"observed:pose-review-declared-threat-model:pose-mcp/internal/cli/accepted_limits_lint_test.go\\\",\\n        \\\"observed:pose-review-declared-threat-model:pose-mcp/internal/pose/accepted_limits.go\\\",\\n        \\\"observed:pose-review-declared-threat-model:pose-mcp/internal/pose/accepted_limits_test.go\\\",\\n  \\\"accepted_limits\\\": [\",\"exit_code\":0,\"call\":\"call-41\"}\n.pose/review-runs/rrn-d1680df442b23d12.json:39:      \"scope\": \"spec:pose-review-declared-threat-model\",\n.pose/review-runs/rrn-d1680df442b23d12.json:86:  \"brief_notes\": \"Implementer notes (Claude Opus 5.5, the lead). Use them as context only; the judgment is yours.\\n\\nScope: spec `pose-review-declared-threat-model` (R1–R4, decisions D1–D2). A recent spec took 15 review rounds; each round found a rarer adversarial case of a guarantee the spec never said it did not make, and no round could converge because there was no place to declare the environment a guarantee assumes. This spec adds that place.\\n- R1: `### Accepted limits` with `- L\\u003cN\\u003e: \\u003cassumption\\u003e. Accepted because \\u003creason\\u003e.` (`ParseAcceptedLimits`); the review plan and the bundle seal them as `accepted_limits`, in the plan digest, omitted when empty so no earlier plan or bundle changes digest.\\n- R2: `review-brief/11` lists the sealed limits and tells the reviewer to set `limit` on a follow-up that falls inside one, or to dispute the limit with a finding of its own.\\n- R3: a draft follow-up with `limit` becomes an attestation finding with disposition `within-limit` and `limit`; it does not block an approval whatever its severity, but an unsealed limit or a missing reason is refused (`reviewFindingDecisionBlockers`).\\n- R4: `lint-spec --ready-check` refuses a limit without its reason, and one an ADR citing the spec does not name.\\nEach has a test that failed with it mutated out; the full `go test ./...` of `pose-mcp` passes.\\n\\nThis spec declares its own accepted limits (L1, L2); this brief lists them, sealed. That is also a live test of R1 and R2. Please judge whether they are justified, and check in particular that `within-limit` cannot be used to approve a finding outside a sealed limit, and that bundles and plans without limits keep their digests.\\n\\nRun every planned `pose` command as `\\\"$POSE_REVIEW_CLI\\\"` with the same arguments. Before you finish, pipe your final message to `\\\"$POSE_REVIEW_CLI\\\" review draft-check --draft -` and fix every reason it reports. Let every command you start finish before you end.\\n\\nDraft format rules, enforced by the conclusion preflight:\\n- New findings use short unprefixed IDs (N1, N2, …). Round-prefixed IDs go only in `prior_findings`, and only for the findings the brief lists under \\\"Findings to account for\\\", with exactly id, status and evidence.\\n- Structural-delta mappings go inside the criterion that answers them, with `basis` set to a requirement or a decision of this spec (R1–R4, D1, D2).\\n- A criterion scoped to a component cites evidence from that component only.\\n\\nSandbox limits: the checkout is sealed and read-only. Never `cd`; keep the checkout root as the working directory. Keep test runs focused (`go -C pose-mcp test ./internal/pose ./internal/cli -run 'AcceptedLimit|WithinASealedLimit|ReadyCheckJudges|Brief|Conclud'`). A tool you cannot rerun in the sandbox is a limit of the run, not a defect of the subject: cite the sealed evidence that covers it, then decide on the code itself.\\n\",\n.pose/review-runs/rrn-d1680df442b23d12.json:91:  \"scope\": \"spec:pose-review-declared-threat-model\",\n.pose/review-runs/rrn-d1680df442b23d12.json:106:  \"output\": \"decision: changes-requested\\n\\n## Review\\n\\nReviewed sealed bundle `rvb-8c5b48b85bb59245` (`sha256:8c5b48b85bb5924542b10d6612fd8200890d9d7c346be8acf9aca5d22872a784`). The dispatcher review-plan view returned `sha256:55a60ed8cd30be693ef9e1323b788b3e0c96d59aaff06b402bb5b1de282baaf7`. The independent review found three defects in accepted-limit identity and validation.\\n\\n## Criterion results\\n\\n| Criterion | Result | Evidence |\\n|---|---|---|\\n| assumption-integrity | passed | `unit:pose-mcp/go/test` |\\n| backend-concurrency | passed | `integration:pose-mcp/go/writer-coordination-and-atomic-publication-integration` |\\n| backend-contracts | failed (N1) | [accepted_limits.go:71](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/pose/accepted_limits.go:71) |\\n| backend-input-errors | failed (N2) | [accepted_limits.go:54](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/pose/accepted_limits.go:54) |\\n| backend-integration-impact | passed | `integration:pose-mcp/go/lint-spec-all-gate-contract` |\\n| backend-observability | passed | `unit:pose-mcp/go/test` |\\n| compatibility | failed (N1) | [accepted_limits.go:71](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/pose/accepted_limits.go:71) |\\n| correctness | failed (N2) | [accepted_limits.go:54](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/pose/accepted_limits.go:54) |\\n| design-causality | passed | `structure:design-79400ddcaa553202` |\\n| documentation | passed | `structure:design-79400ddcaa553202` |\\n| operability | failed (N2) | [accepted_limits.go:54](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/pose/accepted_limits.go:54) |\\n| requirements | failed (N1, N2, N3) | [accepted_limits.go:71](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/pose/accepted_limits.go:71), [accepted_limits.go:54](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/pose/accepted_limits.go:54), [lintspec.go:1212](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/cli/lintspec.go:1212) |\\n| scope | passed | `structure:design-79400ddcaa553202` |\\n| security | failed (N1) | [accepted_limits.go:71](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/pose/accepted_limits.go:71) |\\n| solution-proportionality | passed | `structure:design-79400ddcaa553202` |\\n\\n## Findings\\n\\n- **N1 — medium, blocker:** [accepted_limits.go:71](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/pose/accepted_limits.go:71) appends limits from every spec in a roadmap or milestone without preserving the source spec or rejecting duplicate IDs. Since each spec can independently use `L1` and findings store only that ID, the brief and attestation cannot unambiguously identify which sealed limit was used.\\n\\n- **N2 — medium, blocker:** [accepted_limits.go:54](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/pose/accepted_limits.go:54) accepts the phrase `Accepted because` with no explanation after it. A spec can therefore pass `lint-spec --ready-check` and seal an unjustified limit, contrary to R4.\\n\\n- **N3 — low, blocker:** [lintspec.go:1212](/var/tmp/pose-work-go/pose-review-run-4264271495/worktree/pose-mcp/internal/cli/lintspec.go:1212) uses substring matching for ADR IDs, so an ADR containing `L10` satisfies a required reference to `L1`.\\n\\n## Limit judgment\\n\\nL1 is justified as a disclosed human-review risk for a single-spec bundle: the brief presents limit text as data, asks for a reason why a finding falls within it, and requires a dispute to be a blocking finding. L2 is justified by the plan digest and `omitempty` fields, which preserve empty-limit plan and bundle digests and make later edits require a new bundle.\\n\\nFor one-spec reviews, the gate rejects unsealed IDs and empty finding rationales. It cannot prove that a natural-language finding actually matches the limit; D1 assigns that judgment to the reviewer, so an honest independent review is part of L1’s assumption. N1 is a concrete attribution flaw for composite scopes.\\n\\n## Validation and tool results\\n\\nThe focused command `go -C pose-mcp test ./internal/pose ./internal/cli -run 'AcceptedLimit|WithinASealedLimit|ReadyCheckJudges|Brief|Conclud'` passed. `surface-check` passed with one target and zero findings. Both strict `validate` invocations finished but failed because the read-only sandbox prevented Go from creating work directories and cache files; the sealed bundle contains passing `build:pose-mcp/go/build` and `unit:pose-mcp/go/test` evidence.\\n\\nThe artifact-check command exited 0 but resolved change set `cs-6010196c7421` (head `573858...`) instead of this brief’s `cs-2f8efba58158`; its 19-claim/30-observation repository warnings are not treated as defects in the sealed subject. The tech-debt scan was incomplete due two invalid specs and one uncovered repository marker. The recurrence check found no flagged keys.\\n\\nRules applied: `.pose/workflows/review.md`, `.pose/rules/security.md`, `.pose/rules/backend-go.md` and `.pose/rules/documentation-style.md`. No relevant prior handoff was found. `review-check` and `closeout-check` remain deferred until an attestation exists; no attestation or repository edits were made.\\n\\n```pose-draft\\n{\\n  \\\"schema\\\": \\\"pose.review.draft/v1\\\",\\n  \\\"decision\\\": \\\"changes-requested\\\",\\n  \\\"findings\\\": [\\n    {\\n      \\\"id\\\": \\\"N1\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/pose/accepted_limits.go\\\",\\n      \\\"line\\\": 71,\\n      \\\"summary\\\": \\\"Composite roadmap or milestone plans append limits from multiple specs without preserving the source spec or checking ID collisions. Since IDs are spec-local L\\u003cN\\u003e values and findings record only limit, the brief and attestation cannot unambiguously identify which sealed limit was used; the gate accepts either one, so R3 attribution is ambiguous.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"N2\\\",\\n      \\\"severity\\\": \\\"medium\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/pose/accepted_limits.go\\\",\\n      \\\"line\\\": 54,\\n      \\\"summary\\\": \\\"The ready-check treats the substring 'Accepted because' as a reason even when it ends the entry (for example, '- L1: assumption. Accepted because'). That unjustified limit is parsed and sealed, so R4's justification gate has a false pass.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"N3\\\",\\n      \\\"severity\\\": \\\"low\\\",\\n      \\\"disposition\\\": \\\"blocker\\\",\\n      \\\"file\\\": \\\"pose-mcp/internal/cli/lintspec.go\\\",\\n      \\\"line\\\": 1212,\\n      \\\"summary\\\": \\\"ADR coverage uses substring matching for limit IDs. An ADR mentioning L10 therefore satisfies the required reference to L1, allowing an ADR that omits L1 to pass ready-check.\\\"\\n    }\\n  ],\\n  \\\"criteria\\\": [\\n    {\\n      \\\"id\\\": \\\"assumption-integrity\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\",\\n      \\\"rationale\\\": \\\"I examined the two sealed limits and their consumers. L1's dependence on an independent reviewer inspecting the displayed text is explicit and accepted for a single-spec review; L2 is supported by the limit's inclusion in the plan digest and optional bundle field. Semantic fit remains reviewer judgment, and N1 identifies the composite-scope ambiguity.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-concurrency\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/writer-coordination-and-atomic-publication-integration\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-contracts\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"N1\\\",\\n      \\\"rationale\\\": \\\"Composite review findings cannot unambiguously name one of two same-ID limits.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-input-errors\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"N2\\\",\\n      \\\"rationale\\\": \\\"A limit with no text after the acceptance phrase passes validation.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-integration-impact\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/lint-spec-all-gate-contract\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"backend-observability\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"compatibility\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"N1\\\",\\n      \\\"rationale\\\": \\\"The new limit identity contract is ambiguous when a plan contains multiple specs.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"correctness\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"N2\\\",\\n      \\\"rationale\\\": \\\"The ready-check accepts an unjustified limit; N1 also affects composite reviews.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"design-causality\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-79400ddcaa553202\\\",\\n      \\\"rationale\\\": \\\"D1 addresses non-convergence by recording an explicit reviewer classification; D2 binds the limits into the plan and bundle digests. The inspected implementation follows that design, with the specific defects reported separately. The structural assessment observed no deltas.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"documentation\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-79400ddcaa553202\\\",\\n      \\\"rationale\\\": \\\"I compared the English and Portuguese manuals and their scaffold copies with runtime behavior: they describe the new section, sealed plan/bundle, review-brief/11 classification, and ready-check.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"operability\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"N2\\\",\\n      \\\"rationale\\\": \\\"The ready-check reports unjustified limits in normal cases but gives a false pass when the reason phrase has no explanation.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"requirements\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"N1\\\",\\n      \\\"rationale\\\": \\\"R3 is ambiguous for composite scopes (N1); R4 also has false passes for empty reasons and partial ADR ID matches (N2, N3).\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"scope\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-79400ddcaa553202\\\",\\n      \\\"rationale\\\": \\\"The inspected prepared subject contained the 18 implementation/documentation paths named by the spec artifacts, and the design assessment observed no structural delta.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"security\\\",\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"evidence\\\": \\\"N1\\\",\\n      \\\"rationale\\\": \\\"A composite-scope finding can be accepted against an ambiguous same-ID limit, weakening the integrity of the approval classification.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"solution-proportionality\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-79400ddcaa553202\\\",\\n      \\\"rationale\\\": \\\"The optional sealed field, versioned brief and typed finding field are a small sufficient design for preserving review-time assumptions; the digest omission preserves existing records. The reported defects are validation gaps, not speculative architecture.\\\"\\n    }\\n  ],\\n  \\\"tools\\\": [\\n    {\\n      \\\"id\\\": \\\"artifact-check\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"command:\\\\\\\"$POSE_REVIEW_CLI\\\\\\\" artifact-check --spec pose-review-declared-threat-model --strict\\\",\\n      \\\"rationale\\\": \\\"The command exited 0. It selected cs-6010196c7421, not the brief's cs-2f8efba58158, and reported 19 claims versus 30 observations with repository-wide orphan warnings; those warnings are not treated as scoped findings.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-design\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"structure:design-79400ddcaa553202\\\",\\n      \\\"rationale\\\": \\\"Ran the recommended assessment; it observed the subject and reported no structural deltas.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-discover\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"command:\\\\\\\"$POSE_REVIEW_CLI\\\\\\\" assess discover --no-persist --component pose-mcp\\\",\\n      \\\"rationale\\\": \\\"Ran without persistence and confirmed the pose-mcp component.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-integrate\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/review-bundle-convergence\\\",\\n      \\\"rationale\\\": \\\"Ran the assessment. It reported three unobserved HTTP consumers (/admin/refresh, /healthz, /mcp), outside the changed CLI/review-limit boundary.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"assess-tech-debt\\\",\\n      \\\"disposition\\\": \\\"failed\\\",\\n      \\\"evidence\\\": \\\"command:\\\\\\\"$POSE_REVIEW_CLI\\\\\\\" assess tech-debt --no-persist\\\",\\n      \\\"rationale\\\": \\\"The scan was incomplete: two invalid specs were unread and one debt item was uncovered. No marker was found in the changed accepted-limit implementation.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"closeout-check\\\",\\n      \\\"disposition\\\": \\\"deferred\\\",\\n      \\\"rationale\\\": \\\"The brief says closeout-check requires completion of the review; no attestation is recorded in this run.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"review-check\\\",\\n      \\\"disposition\\\": \\\"deferred\\\",\\n      \\\"rationale\\\": \\\"The brief says review-check requires completion of the review; no attestation is recorded in this run.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"surface-check\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/lint-spec-all-gate-contract\\\",\\n      \\\"rationale\\\": \\\"The required surface check completed with one target, 236 results and zero findings.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"validate\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"build:pose-mcp/go/build\\\",\\n      \\\"rationale\\\": \\\"The required rerun could not create Go work/cache files in the read-only sandbox; the sealed bundle's pose-mcp build evidence is pass.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"validate\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\",\\n      \\\"rationale\\\": \\\"The required module rerun was blocked by the read-only Go work/cache paths; the sealed full pose-mcp unit result is pass, and the focused review tests also passed.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"suggest-review\\\",\\n      \\\"component\\\": \\\"pose-mcp\\\",\\n      \\\"disposition\\\": \\\"passed\\\",\\n      \\\"evidence\\\": \\\"command:\\\\\\\"$POSE_REVIEW_CLI\\\\\\\" suggest review --path pose-mcp\\\",\\n      \\\"rationale\\\": \\\"Ran and selected backend-go, security and documentation-style rules.\\\"\\n    }\\n  ]\\n}\\n```\",\n.pose/review-runs/rrn-d1680df442b23d12.transcript:4:{\"type\":\"item.started\",\"item\":{\"id\":\"item_1\",\"type\":\"command_execution\",\"command\":\"/usr/bin/bash -lc \\\"cat /var/tmp/pose-work-go/pose-review-run-4264271495/worktree/.agents/skills/pose-review/SKILL.md && printf '\\\\\\\\nPOSE_REVIEW_CLI=%s\\\\\\\\n' \\\\\\\"\\\"'$POSE_REVIEW_CLI\\\" && git status --short && git rev-parse --show-toplevel && git diff --stat 3f63a1bb432801957ddb35354961f1825658531a..d0cb51f208996e83957851595baf6105c3a01b50 && rg --files .pose/specs | rg '\\\"'pose-review-declared-threat-model'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n.pose/review-runs/rrn-d1680df442b23d12.transcript:5:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_1\",\"type\":\"command_execution\",\"command\":\"/usr/bin/bash -lc \\\"cat /var/tmp/pose-work-go/pose-review-run-4264271495/worktree/.agents/skills/pose-review/SKILL.md && printf '\\\\\\\\nPOSE_REVIEW_CLI=%s\\\\\\\\n' \\\\\\\"\\\"'$POSE_REVIEW_CLI\\\" && git status --short && git rev-parse --show-toplevel && git diff --stat 3f63a1bb432801957ddb35354961f1825658531a..d0cb51f208996e83957851595baf6105c3a01b50 && rg --files .pose/specs | rg '\\\"'pose-review-declared-threat-model'\\\"\",\"aggregated_output\":\"---\\nname: pose-review\\ndescription: Use for POSE pull-request or code review to verify controlled scope, preserved contracts, security and observability impact, risk-proportional validation, and escalation where applicable. Trigger keywords - review, code review, PR review, review opinion, ultrareview.\\nwhen_to_use: Evaluating your own or another author's diff or PR under POSE. Use before commenting or approving to select rules, inspect validation evidence and prior decisions, and issue an actionable decision.\\npose_schema_range: \\\"1-1\\\"\\nclients: agents-skills, mcp, claude-code\\ncapabilities: read\\n---\\n\\n# Skill: pose-review\\n\\n## Required reading\\n\\n1. [AGENTS.md](../../../AGENTS.md).\\n2. [`.pose/workflows/review.md`](../../../.pose/workflows/review.md).\\n3. Applicable domain rules; security takes precedence in conflicts.\\n\\nResolve the selected task with `pose context --task <typed-or-qualified-artifact-ref> --json` before reviewing. Follow its canonical authority and stop on ambiguity, stale binding, unsupported metadata or `transfer-in-progress`. Use the qualified `xref:` scope for cross-project review; every cross-project write requires an explicit `POSE_PROJECT_ROOTS` binding and the current `context_revision` as `--expect-context`. Keep review evidence and its `POSE-Spec:` trailer in the authority repository.\\n\\n## Steps\\n\\n1. Classify the change as feature, bugfix, refactor, documentation, or mixed.\\n2. Run `pose assess tech-debt` during code review to ensure markers (`TODO`, `FIXME`, `stub`, `panic`) are covered by follow-ups or specs. Run `pose assess integrate` when touching inter-module contracts (Protobuf, Kafka, REST, MCP).\\n3. Resolve `pose review bundle <scope> --explain` to inspect effective criteria, components and tool requirements.\\n4. Run active required tools first, record why each recommended tool was used or skipped, and keep completion tools deferred until attestation.\\n5. Select rules with `pose suggest review --path <affected-dir>` for every mapped component.\\n6. Search `.pose/knowledge/` for prior module decisions, accepted risks, and pending follow-ups.\\n7. Require deterministic `pose validate --strict` evidence matching delivery targets.\\n8. Evaluate every required plan criterion, including cross-component boundaries. When the change adds or alters a governance gate, also answer: what is the cheapest way to satisfy this gate in form without producing its value, and what stops that? Point to the adversarial corpus case that proves it (`pose-mcp/internal/cli/testdata/adversarial/README.md`), or record the gap.\\n9. Classify findings as critical, high, medium, or low with evidence and expected action.\\n10. Run `pose recurrence-check --tolerant --window-days 14`; use recurrence escalation for a matching systemic signal.\\n11. Create a handoff with `pose new-knowledge handoff <slug>` for accepted residual risk, monitoring, or deferred action.\\n12. Seal the review subject with `pose review bundle <scope> --seal`.\\n13. Prepare the mechanical half with `pose review auto-attest <bundle-id> --reviewer agent:<id>` — without `--apply` — and read `review_attestation.pending`: those are the criteria no registered check answers, and they are yours to answer. Then record the attestation with `pose review attest`, giving every judgment criterion a conclusion. `--apply` on auto-attest records only when nothing is pending; it refuses otherwise, and never answers a judgment criterion for you. An explicit attestation records `--criterion ID|passed|evidence` (or `not-applicable` with a rationale, or `finding` naming a recorded finding) and `--finding ID|severity|disposition|action|evidence[|owner|rationale|review-by]`; every finding needs a severity and an action, and an `accepted-risk` or `wont-fix` finding also needs an owner, a rationale and a review date. A `passed` criterion may cite only evidence the sealed bundle contains, of a class the criterion accepts. For a cross-project attestation, use the qualified `xref:` as the target argument to `pose review attest`, include `--expect-context <digest>` with `--apply`, and keep the explicit project binding; a bundle ID alone does not select an authority project.\\n14. Run `pose review verify <scope>` and `pose review-check <scope>`; close only when both confirm a valid, approved attestation.\\n15. Decide: approved, approved with reservations, changes requested, or rejected.\\n16. When Contributor Mode is active, if review uncovers POSE linter false-positives, diagnostic frictions, or rule gaps, stage an improvement proposal with `pose contribute stage --type enhancement --title \\\"<summary>\\\"`.\\n\\n## Output requirements\\n\\n- Completed Rules applied during review section.\\n- Bundle/plan digests and dispositions for required, recommended and deferred completion tools.\\n- Severity-classified findings with expected actions.\\n- Clear and actionable final decision.\\n- Handoff when residual risk is accepted.\\n\\nPOSE_REVIEW_CLI=/var/tmp/pose-work-go/pose-ready\\n/var/tmp/pose-work-go/pose-review-run-4264271495/worktree\\n .../adr/2026-11-23-review-readiness-before-seal.md |   31 +\\n .pose/indexes/delivery-integrity.json              | 6427 ++++++++++++++++----\\n .pose/indexes/generation.json                      |   18 +-\\n .pose/indexes/spec-graph.json                      | 1352 ++--\\n .pose/policy/delegation.json                       |   22 +-\\n .pose/results/assess-sealed-binding.md             |    2 +\\n .pose/results/concl-binding.md                     |    1 +\\n .pose/results/delivery-validation.json             | 1460 ++---\\n .pose/results/reap-binding.md                      |   16 +\\n .pose/results/review-readiness-binding.md          |    3 +\\