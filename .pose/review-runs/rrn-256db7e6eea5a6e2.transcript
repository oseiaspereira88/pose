{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_conclusions.go | sed -n '1,210p' && nl -ba pose-mcp/internal/pose/accepted_limits_test.go | sed -n '1,130p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_conclusions.go | sed -n '1,210p' && nl -ba pose-mcp/internal/pose/accepted_limits_test.go | sed -n '1,130p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Conclusions of delegated runs (spec pose-delegated-review-conclusions).\n     4\t//\n     5\t// A review run whose record is intact and signed, whose draft is complete\n     6\t// and valid for its round, and whose bundle still governs its scope is\n     7\t// turned by the engine into the attestation its draft concludes: the run's\n     8\t// proof is signed, the attestation is built from the draft's typed fields and\n     9\t// signed by the issuer the delegation policy names, and the domain writer\n    10\t// records it under the same preflight as every attestation (R1). Anything\n    11\t// short of that records no governed effect; the conclusion record of the run\n    12\t// says why (R3). One run concludes once: replaying it returns its record (R4).\n    13\t\n    14\timport (\n    15\t\t\"encoding/json\"\n    16\t\t\"errors\"\n    17\t\t\"fmt\"\n    18\t\t\"os\"\n    19\t\t\"path/filepath\"\n    20\t\t\"sort\"\n    21\t\t\"strings\"\n    22\t\t\"time\"\n    23\t)\n    24\t\n    25\t// ReviewConclusionsDir holds one conclusion record per run.\n    26\tconst ReviewConclusionsDir = \".pose/review-conclusions\"\n    27\t\n    28\t// Conclusion states.\n    29\tconst (\n    30\t\tReviewConclusionRecorded = \"recorded\"\n    31\t\tReviewConclusionRefused  = \"refused\"\n    32\t\t// ReviewConclusionPending reserves a run while its conclusion is signed\n    33\t\t// and recorded.\n    34\t\tReviewConclusionPending = \"concluding\"\n    35\t)\n    36\t\n    37\t// ReviewConclusion is what the engine did with a run's conclusion.\n    38\ttype ReviewConclusion struct {\n    39\t\tSchemaVersion int    `json:\"schema_version\"`\n    40\t\tRunID         string `json:\"run_id\"`\n    41\t\tBundleID      string `json:\"bundle_id\"`\n    42\t\tScope         string `json:\"scope\"`\n    43\t\tState         string `json:\"state\"`\n    44\t\tDecision      string `json:\"decision,omitempty\"`\n    45\t\tAttestation   string `json:\"attestation,omitempty\"`\n    46\t\t// Kind is the run's kind and Destination where an adjudication or a smoke\n    47\t\t// verdict was recorded (spec pose-delegated-verdict-destinations).\n    48\t\tKind        string   `json:\"kind,omitempty\"`\n    49\t\tDestination string   `json:\"destination,omitempty\"`\n    50\t\tProofID     string   `json:\"proof_id,omitempty\"`\n    51\t\tIssuer      string   `json:\"issuer,omitempty\"`\n    52\t\tReasons     []string `json:\"reasons,omitempty\"`\n    53\t\tConcludedAt string   `json:\"concluded_at\"`\n    54\t\t// Replayed is set on a result that returns an earlier record (R4).\n    55\t\tReplayed bool `json:\"replayed,omitempty\"`\n    56\t}\n    57\t\n    58\tfunc reviewConclusionPath(root, runID string) string {\n    59\t\treturn filepath.Join(root, filepath.FromSlash(ReviewConclusionsDir), runID+\".json\")\n    60\t}\n    61\t\n    62\t// ReadReviewConclusion is the conclusion record of run, if any.\n    63\tfunc (s Store) ReadReviewConclusion(runID string) (*ReviewConclusion, error) {\n    64\t\tif !validAttemptFileName(runID) {\n    65\t\t\treturn nil, fmt.Errorf(\"pose: %q is not a run id\", runID)\n    66\t\t}\n    67\t\tc, _, err := s.readReviewConclusionRaw(runID)\n    68\t\treturn c, err\n    69\t}\n    70\t\n    71\t// readReviewConclusionRaw is the conclusion record of run and the bytes it\n    72\t// was parsed from: one read, so what is judged is what a write expects\n    73\t// (review round 2, B4).\n    74\tfunc (s Store) readReviewConclusionRaw(runID string) (*ReviewConclusion, []byte, error) {\n    75\t\traw, err := readBoundedRegular(reviewConclusionPath(s.Root, runID), 1<<20)\n    76\t\tif errors.Is(err, os.ErrNotExist) {\n    77\t\t\treturn nil, nil, nil\n    78\t\t}\n    79\t\tif err != nil {\n    80\t\t\treturn nil, nil, err\n    81\t\t}\n    82\t\tvar c ReviewConclusion\n    83\t\tif err := json.Unmarshal(raw, &c); err != nil || c.RunID != runID {\n    84\t\t\treturn nil, nil, fmt.Errorf(\"pose: the conclusion record of %s cannot be read\", runID)\n    85\t\t}\n    86\t\treturn &c, raw, nil\n    87\t}\n    88\t\n    89\t// reviewConclusionChecks are the conditions a run must meet before its\n    90\t// conclusion is recorded, each a reason when it does not (R1, R3, R4).\n    91\tfunc (s Store) reviewConclusionChecks(run ReviewRun) ([]string, *ReviewBundle, *ReviewDraft) {\n    92\t\tvar reasons []string\n    93\t\tif run.Kind != ReviewBriefKindReview && run.Kind != ReviewBriefKindAdjudication && run.Kind != ReviewBriefKindSmoke || run.Purpose != \"\" && run.Purpose != DelegationPurposeForKind(run.Kind) {\n    94\t\t\treasons = append(reasons, \"the run is not a review, an adjudication or a smoke run\")\n    95\t\t}\n    96\t\tif run.Status != ReviewRunCompleted {\n    97\t\t\treasons = append(reasons, \"the run did not complete: it is \"+run.Status)\n    98\t\t}\n    99\t\tif run.SupersededBy != \"\" {\n   100\t\t\treasons = append(reasons, \"the run is superseded by \"+run.SupersededBy)\n   101\t\t}\n   102\t\tif run.Provenance == nil {\n   103\t\t\treasons = append(reasons, \"the run captured no provenance, so it cannot be signed\")\n   104\t\t}\n   105\t\tif run.Safety == nil || run.Safety.Operation.Outcome != OutcomeCompleted {\n   106\t\t\treasons = append(reasons, \"the run's cleanup is not confirmed complete\")\n   107\t\t}\n   108\t\tif why := s.reviewRunTranscriptIntact(run); why != \"\" {\n   109\t\t\treasons = append(reasons, \"the run's record is not intact: \"+why)\n   110\t\t}\n   111\t\tdraft, err := ParseReviewDraft(run.Output)\n   112\t\tswitch {\n   113\t\tcase err != nil:\n   114\t\t\treasons = append(reasons, \"the conclusion cannot be read: \"+err.Error())\n   115\t\tcase draft == nil:\n   116\t\t\treasons = append(reasons, \"the run's final message carries no pose-draft block\")\n   117\t\t}\n   118\t\tif len(run.DraftProblems) > 0 {\n   119\t\t\treasons = append(reasons, \"the draft does not account for its round: \"+strings.Join(run.DraftProblems, \"; \"))\n   120\t\t}\n   121\t\tbundle, err := s.LoadReviewBundle(run.BundleID)\n   122\t\tif err != nil {\n   123\t\t\treturn append(reasons, \"the run's bundle cannot be read: \"+err.Error()), nil, draft\n   124\t\t}\n   125\t\t// The run's own record must stand whatever it concludes. Whether its\n   126\t\t// bundle is still the current subject matters only to an approval: a\n   127\t\t// verdict that requests changes or rejects is a fact about the bundle it\n   128\t\t// reviewed, and the working tree the implementer is already fixing does\n   129\t\t// not change it (spec pose-review-conclude-ignores-unrelated-local-edits R1).\n   130\t\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n   131\t\t\treasons = append(reasons, \"the run no longer governs: \"+why)\n   132\t\t}\n   133\t\treasons = append(reasons, s.verdictCoverageReasons(run, bundle, draft)...)\n   134\t\treturn reasons, &bundle, draft\n   135\t}\n   136\t\n   137\t// reviewConclusionCurrency is why an approval of run's bundle would no longer\n   138\t// approve the current subject.\n   139\tfunc (s Store) reviewConclusionCurrency(run ReviewRun, bundle ReviewBundle) []string {\n   140\t\tvar reasons []string\n   141\t\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n   142\t\tif err != nil || current == nil || current.BundleID != bundle.BundleID {\n   143\t\t\treasons = append(reasons, \"the run's bundle no longer governs \"+bundle.Payload.Scope.Ref+\": the subject, the plan or the policy changed since it was sealed\")\n   144\t\t}\n   145\t\tif why := s.ReviewRunStillGoverns(run); why != \"\" {\n   146\t\t\treasons = append(reasons, \"the run no longer governs: \"+why)\n   147\t\t}\n   148\t\treturn reasons\n   149\t}\n   150\t\n   151\t// reviewAttestationFromDraft builds the attestation a draft concludes, for\n   152\t// the run that wrote it. Evidence is the run itself and each evidence the\n   153\t// draft names; a criterion or a tool the draft does not answer is left for\n   154\t// the preflight to refuse, never answered for it.\n   155\tfunc reviewAttestationFromDraft(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, reviewer string) ReviewAttestation {\n   156\t\tatt := ReviewAttestation{BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest, Reviewer: reviewer, Decision: draft.Decision}\n   157\t\tevidence := map[string]bool{\"delegated-run:\" + run.RunID: true}\n   158\t\tfor _, c := range draft.Criteria {\n   159\t\t\tatt.Criteria = append(att.Criteria, ReviewCriterion{ID: c.ID, Disposition: c.Disposition, Evidence: c.Evidence, Rationale: c.Rationale, Mappings: c.Mappings})\n   160\t\t\tif c.Evidence != \"\" {\n   161\t\t\t\tevidence[c.Evidence] = true\n   162\t\t\t}\n   163\t\t}\n   164\t\tvar tools []ReviewToolDisposition\n   165\t\tfor _, t := range draft.Tools {\n   166\t\t\ttools = append(tools, ReviewToolDisposition{ID: t.ID, Component: t.Component, Disposition: t.Disposition, Evidence: t.Evidence, Rationale: t.Rationale})\n   167\t\t}\n   168\t\tatt.Tools = ReviewToolDefaults(bundle.Payload.Plan.Tools, tools)\n   169\t\tfor _, f := range draft.Findings {\n   170\t\t\tfinding := ReviewFinding{ID: f.ID, Severity: f.Severity, Evidence: findingEvidence(f), Action: f.Action, Disposition: \"open\"}\n   171\t\t\tif f.Action == \"\" {\n   172\t\t\t\tfinding.Action = f.Summary\n   173\t\t\t}\n   174\t\t\t// A follow-up the reviewer gave an action, an owner and a review date\n   175\t\t\t// is a risk the reviewer accepted; anything else stays open and blocks\n   176\t\t\t// an approval. The engine never writes the action for the reviewer\n   177\t\t\t// (review round 1, B3).\n   178\t\t\tif f.Disposition == \"follow-up\" && f.Action != \"\" && f.Owner != \"\" && f.ReviewBy != \"\" {\n   179\t\t\t\tfinding.Disposition, finding.Owner, finding.ReviewBy, finding.Rationale = \"accepted-risk\", f.Owner, f.ReviewBy, f.Summary\n   180\t\t\t}\n   181\t\t\t// A follow-up the reviewer classified inside a declared accepted\n   182\t\t\t// limit is recorded as such, naming the limit (spec\n   183\t\t\t// pose-review-declared-threat-model R3).\n   184\t\t\tif f.Disposition == \"follow-up\" && f.Limit != \"\" {\n   185\t\t\t\tfinding.Disposition, finding.Limit, finding.Rationale, finding.Owner, finding.ReviewBy = \"within-limit\", f.Limit, f.Summary, f.Owner, f.ReviewBy\n   186\t\t\t}\n   187\t\t\tatt.Findings = append(att.Findings, finding)\n   188\t\t}\n   189\t\tfor ref := range evidence {\n   190\t\t\tatt.EvidenceRefs = append(att.EvidenceRefs, ref)\n   191\t\t}\n   192\t\tsort.Strings(att.EvidenceRefs)\n   193\t\tatt.Run = &ReviewRunReference{RunID: run.RunID}\n   194\t\treturn att\n   195\t}\n   196\t\n   197\t// ReviewToolDefaults is given followed by the dispositions that state no\n   198\t// conclusion, for the plan's tools given leaves out: a post-review gate\n   199\t// deferred, a recommended tool not used. A required tool left out stays out,\n   200\t// for the domain writer to name. `review attest` and a run's conclusion fill\n   201\t// the same defaults, so a run's conclusion and its attestation agree on them.\n   202\tfunc ReviewToolDefaults(plan []ReviewPlanTool, given []ReviewToolDisposition) []ReviewToolDisposition {\n   203\t\tout := append([]ReviewToolDisposition{}, given...)\n   204\t\tprovided := map[string]bool{}\n   205\t\tfor _, t := range given {\n   206\t\t\tprovided[t.ID+\"\\x00\"+t.Component] = true\n   207\t\t}\n   208\t\tfor _, tool := range plan {\n   209\t\t\tif provided[tool.ID+\"\\x00\"+tool.Component] {\n   210\t\t\t\tcontinue\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"os\"\n     5\t\t\"path/filepath\"\n     6\t\t\"strings\"\n     7\t\t\"testing\"\n     8\t)\n     9\t\n    10\tconst limitsSection = `\n    11\t### Accepted limits\n    12\t- L1: A process that clears its environment escapes. Accepted because the shim covers it.\n    13\t- L2: Windows is untested here. Accepted because the host is Linux.\n    14\t`\n    15\t\n    16\t// Spec pose-review-declared-threat-model R1: the section is read as\n    17\t// written, and what does not say why it is accepted is reported.\n    18\tfunc TestAcceptedLimitsAreParsed(t *testing.T) {\n    19\t\tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n    20\t\tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n    21\t\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n    22\t\t}\n    23\t\t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n- L3: a marker with nothing after it. Accepted because\\n\")\n    24\t\tjoined := strings.Join(problems, \"\\n\")\n    25\t\tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\", \"L3 does not say why it is accepted\"} {\n    26\t\t\tif !strings.Contains(joined, want) {\n    27\t\t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n    28\t\t\t}\n    29\t\t}\n    30\t}\n    31\t\n    32\t// R1: the review plan seals the limits the spec declares, and they enter the\n    33\t// plan digest; a spec without limits keeps its digest.\n    34\tfunc TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n    35\t\troot, store := reviewBundleFixture(t)\n    36\t\tbefore, err := store.ReviewPlan(\"spec:backend\")\n    37\t\tif err != nil || len(before.AcceptedLimits) != 0 {\n    38\t\t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n    39\t\t}\n    40\t\tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n    41\t\traw, _ := os.ReadFile(path)\n    42\t\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n    43\t\t\tt.Fatal(err)\n    44\t\t}\n    45\t\tafter, err := store.ReviewPlan(\"spec:backend\")\n    46\t\tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n    47\t\t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n    48\t\t}\n    49\t\twithout := after\n    50\t\twithout.AcceptedLimits = nil\n    51\t\tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n    52\t\t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n    53\t\t}\n    54\t}\n    55\t\n    56\t// R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n    57\t// recorded within-limit, naming it, and does not block an approval whatever\n    58\t// its severity; a limit the bundle did not seal accepts nothing.\n    59\tfunc TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n    60\t\tvar bundle ReviewBundle\n    61\t\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n    62\t\tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n    63\t\t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n    64\t\t}}\n    65\t\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n    66\t\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n    67\t\t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n    68\t\t}\n    69\t\tatt.Decision = \"approved\"\n    70\t\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n    71\t\t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n    72\t\t}\n    73\t\tatt.Findings[0].Limit = \"L9\"\n    74\t\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n    75\t\t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n    76\t\t}\n    77\t\tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"\"\n    78\t\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n    79\t\t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n    80\t\t}\n    81\t}\n    82\t\n    83\t// Review round 1, N1: across the specs of a composite scope each limit is\n    84\t// qualified by its spec, so a finding names exactly one.\n    85\tfunc TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n    86\t\tbody := \"### Accepted limits\\n- L1: one. Accepted because it is rare.\\n\"\n    87\t\tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n    88\t\tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n    89\t\t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n    90\t\t}\n    91\t\tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n    92\t\tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n    93\t\t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n    94\t\t}\n    95\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/usr/bin/bash -lc \"rg --files -g '*pose-review-declared-threat-model*' -g 'spec.md' | rg 'review-declared|\\\\.pose/specs/.*/spec\\\\.md\"'$'\"' | head -30 && nl -ba pose-mcp/internal/pose/review_bundle.go | sed -n '4060,4100p' && nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '35,72p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/usr/bin/bash -lc \"rg --files -g '*pose-review-declared-threat-model*' -g 'spec.md' | rg 'review-declared|\\\\.pose/specs/.*/spec\\\\.md\"'$'\"' | head -30 && nl -ba pose-mcp/internal/pose/review_bundle.go | sed -n '4060,4100p' && nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '35,72p'\"","aggregated_output":"  4060\t\t\tallowedRisk[severity] = true\n  4061\t\t}\n  4062\t\tseenFindings := map[string]bool{}\n  4063\t\tfor _, finding := range att.Findings {\n  4064\t\t\tif seenFindings[finding.ID] {\n  4065\t\t\t\tblockers = append(blockers, \"duplicate finding \"+finding.ID)\n  4066\t\t\t}\n  4067\t\t\tseenFindings[finding.ID] = true\n  4068\t\t\tif finding.Severity == \"\" || finding.Action == \"\" {\n  4069\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" lacks severity or action\")\n  4070\t\t\t}\n  4071\t\t\tswitch finding.Disposition {\n  4072\t\t\tcase \"resolved\":\n  4073\t\t\tcase \"accepted-risk\", \"wont-fix\":\n  4074\t\t\t\t// Leaving a finding unresolved accepts its risk regardless of the\n  4075\t\t\t\t// disposition's spelling. Use the policy frozen into this bundle.\n  4076\t\t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n  4077\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n  4078\t\t\t\t}\n  4079\t\t\tcase \"within-limit\":\n  4080\t\t\t\t// Inside a limit the spec declared and the bundle sealed, whatever\n  4081\t\t\t\t// its severity; a limit the bundle did not seal accepts nothing\n  4082\t\t\t\t// (spec pose-review-declared-threat-model R3).\n  4083\t\t\t\tif !sealedAcceptedLimit(bundle, finding.Limit) {\n  4084\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" names accepted limit \"+firstNonempty(finding.Limit, \"(none)\")+\", which this bundle did not seal\")\n  4085\t\t\t\t} else if finding.Rationale == \"\" {\n  4086\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is within limit \"+finding.Limit+\" without saying why\")\n  4087\t\t\t\t}\n  4088\t\t\tcase \"open\", \"changes-requested\":\n  4089\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n  4090\t\t\tdefault:\n  4091\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has invalid disposition\")\n  4092\t\t\t}\n  4093\t\t}\n  4094\t\tif att.Decision != \"approved\" && !(att.Decision == \"approved-with-reservations\" && bundle.Payload.SealedGates().AllowApprovedWithReservations) {\n  4095\t\t\tblockers = append(blockers, \"review decision does not permit closeout: \"+att.Decision)\n  4096\t\t}\n  4097\t\treturn blockers\n  4098\t}\n  4099\t\n  4100\tfunc (s Store) verifyStoredReviewAttestationSignature(att ReviewAttestation) error {\n    35\t// A finding's own identifier never carries a round prefix, which the engine\n    36\t// reserves; the identity it is carried under is that prefix and the\n    37\t// identifier, so the mapping is injective (review round 1, B2, B12).\n    38\tvar (\n    39\t\treviewFindingID   = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n    40\t\treviewRoundPrefix = regexp.MustCompile(`^R[0-9]+-`)\n    41\t\treviewCarriedID   = regexp.MustCompile(`^R[0-9]{1,6}-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n    42\t\t// reviewDraftOpening is any fence line that names pose-draft.\n    43\t\treviewDraftOpening = regexp.MustCompile(\"^(`{3,}|~{3,})\\\\s*pose-draft\")\n    44\t)\n    45\t\n    46\t// ReviewDraftFinding is one finding a draft reports.\n    47\ttype ReviewDraftFinding struct {\n    48\t\tID          string `json:\"id\"`\n    49\t\tSeverity    string `json:\"severity\"`\n    50\t\tDisposition string `json:\"disposition\"`\n    51\t\tFile        string `json:\"file,omitempty\"`\n    52\t\tLine        int    `json:\"line,omitempty\"`\n    53\t\tSummary     string `json:\"summary\"`\n    54\t\t// Action, Owner and ReviewBy let a follow-up become an accepted risk in\n    55\t\t// the attestation the engine records (spec\n    56\t\t// pose-delegated-review-conclusions R1).\n    57\t\tAction   string `json:\"action,omitempty\"`\n    58\t\tOwner    string `json:\"owner,omitempty\"`\n    59\t\tReviewBy string `json:\"review_by,omitempty\"`\n    60\t\t// Limit names the declared accepted limit the finding falls inside\n    61\t\t// (spec pose-review-declared-threat-model R2).\n    62\t\tLimit string `json:\"limit,omitempty\"`\n    63\t}\n    64\t\n    65\t// ReviewDraftCriterion answers one criterion of the plan, as the reviewer of\n    66\t// a recorded attestation does (spec pose-delegated-review-conclusions R1).\n    67\ttype ReviewDraftCriterion struct {\n    68\t\tID          string `json:\"id\"`\n    69\t\tDisposition string `json:\"disposition\"`\n    70\t\tEvidence    string `json:\"evidence,omitempty\"`\n    71\t\tRationale   string `json:\"rationale,omitempty\"`\n    72\t\t// Mappings answer the structural facts the criterion is responsible for,\n","exit_code":0,"status":"completed"}}
