$(H�\\$0�c\u0000\u0000\u0000H�T$0H9�t\u0017\u000fW�H�\u0005�E\u0011\u0002H�\u001d�f(\u0001H��\u0018]�H��H��H��\u0018]�H�D$\bH�\\$\u0010H�L$\u0018�!\b\u0000H�D$\bH�\\$\u0010H�L$\u0018������������������I;f\u0010v-UH��H��\u0010H�D$ H�� u\u000f�����\u000fZ�H��\u0010]������H��\u0010]�H�D$\bH�\\$\u0010H�L$\u0018�\u0019!\b\u0000H�D$\bH�\\$\u0010H�L$\u0018���������H�H�H��\u0003w\u0015H��\u0004H�\u0015��)\u0001H�\u0004\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Validation evidence binds to the material it validated (spec\n// pose-validation-evidence-material-binding, ADR\n// validation-evidence-binds-to-validated-material). A commit whose every\n// changed path is a derived administrative record does not change what the\n// checks exercised, so it does not move the material digest.\n\n// engineVersion is the running engine, registered by the binaries (internal/pose\n// stays importable on its own). It is part of every material digest, so a new\n// engine never inherits evidence the previous one produced.\nvar engineVersion = \"unregistered\"\n\n// SetEngineVersion registers the running engine for material digests.\nfunc SetEngineVersion(v string) { engineVersion = v }\n\n// administrativeDirs is the closed list of derived-record directories. It is\n// owned by the engine; adding a class is a contract change that needs an ADR.\nvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n\n// materialIndexes are files inside an administrative directory that still\n// change what the checks demand.\nvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\n// IsAdministrativePath reports whether p is a derived administrative record.\nfunc IsAdministrativePath(p string) bool {\n\tif p == \"\" || p != path.Clean(p) || strings.HasPrefix(p, \"/\") || strings.HasPrefix(p, \"../\") {\n\t\treturn false\n\t}\n\tif materialIndexes[p] {\n\t\treturn false\n\t}\n\tif !recordExtensions[strings.ToLower(path.Ext(p))] {\n\t\treturn false\n\t}\n\tfor _, dir := range administrativeDirs {\n\t\tif strings.HasPrefix(p, dir) {\n\t\t\treturn true\n\t\t}\n\t}\n\tif rest, ok := strings.CutPrefix(p, \".pose/\"); ok {\n\t\tif i := strings.Index(rest, \"/\"); i > 0 && strings.HasPrefix(rest[:i], \"review-\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// recordExtensions are the data formats a derived record is written in. Code or\n// a script stored in a class is material: that keeps a source file moved or\n// copied into a class from hiding its later edits. A copied data file stays\n// indistinguishable from a record; a check that reads data out of a derived-record\n// directory is outside this contract (ADR validation-evidence-binds-to-validated-material).\nvar recordExtensions = map[string]bool{\".json\": true, \".jsonl\": true, \".ndjson\": true, \".md\": true, \".txt\": true, \".log\": true, \".transcript\": true}\n\n// TreeEntry is one entry of the validated head's tree.\ntype TreeEntry struct{ Mode, Blob string }\n\nfunc regularMode(mode string) bool { return mode == \"100644\" || mode == \"100755\" }\n\n// MaterialInputs are what a material digest is computed from: the paths a change\n// set names (both sides of a rename, and the validation matrix) and the\n// destinations of renames. They are stored with the set so the digest can be\n// recomputed against the current tree without the commits' own records.\ntype MaterialInputs struct {\n\tNames []string `json:\"names\"`\n\tMoved []string `json:\"moved,omitempty\"`\n}\n\n// MaterialInputsOf derives the inputs from per-commit path records. They must\n// be unmerged: folding a create and a later rename into one creation would hide\n// that the file moved into a class.\nfunc MaterialInputsOf(paths []ObservedPath) MaterialInputs {\n\tnames := map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\tmoved := map[string]bool{}\n\tfor _, p := range paths {\n\t\tfor _, name := range []string{p.Path, p.OldPath, p.NewPath} {\n\t\t\tif name != \"\" {\n\t\t\t\tnames[name] = true\n\t\t\t}\n\t\t}\n\t\t// A rename destination is material whatever directory it lands in:\n\t\t// otherwise moving a source file into a class would hide its later edits.\n\t\tif p.OldPath != \"\" && p.NewPath != \"\" {\n\t\t\tmoved[p.NewPath] = true\npose-mcp/internal/cli/validate_results.go:87:\tMaterialClean bool `json:\"material_clean,omitempty\"`\npose-mcp/internal/cli/validate_results.go:234:// publishCanonicalValidationJSON rechecks the delivery policy after acquiring\npose-mcp/internal/cli/validate_results.go:237:func publishCanonicalValidationJSON(root, relative, expectedPolicyPath string, run validationRunResult) error {\npose-mcp/internal/cli/validate_results.go:238:\treturn publishCanonicalValidationJSONIn(cliGovernedStore(root), relative, expectedPolicyPath, run)\npose-mcp/internal/cli/validate_results.go:241:func publishCanonicalValidationJSONIn(store posemodel.Store, relative, expectedPolicyPath string, run validationRunResult) error {\npose-mcp/internal/cli/validate_carry_test.go:534:\t\tt.Fatalf(\"material_clean = true although HEAD moved during the run: %s\", out)\npose-mcp/internal/cli/validate_carry_test.go:570:\t\tt.Fatal(\"material_clean must be false\")\npose-mcp/internal/cli/validate_carry_test.go:779:\t\tt.Fatalf(\"material_clean = true although the run created untracked material: %s\", out)\npose-mcp/internal/cli/validate_carry_test.go:1002:\t\tt.Fatalf(\"material_clean = true with a skip-worktree entry: %s\", out)\npose-mcp/internal/cli/validate_carry_test.go:1044:\t\tt.Fatalf(\"material_clean = true although HEAD moved and came back: %s\", out)\npose-mcp/internal/cli/validate_carry_test.go:1088:\t\tt.Fatalf(\"material_clean = true although b/check.sh differs in mode from the commit: %s\", out)\npose-mcp/internal/cli/validate_carry_test.go:1109:\t\tt.Fatalf(\"material_clean = true with an uninitialized submodule: %s\", out)\npose-mcp/internal/cli/validate_carry_test.go:1129:\t\tt.Fatalf(\"material_clean = true although the run started with a hidden index entry: %s\", out)\npose-mcp/internal/cli/validate_carry_test.go:1160:\t\tt.Fatalf(\"material_clean = true although the submodule moved and came back: %s\", out)\npose-mcp/internal/cli/validate.go:1323:\trunCtx, stopSignals := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\npose-mcp/internal/cli/validate.go:1519:\t\t\terr := publishCanonicalValidationJSONIn(store, writer.path, canonicalResultsPath, run)\npose-mcp/internal/cli/validate.go:1577:\t\t_ = runReportWith(root, reportArgs, nil, validationSummaryOf(run), io.Discard, stderr)\npose-mcp/internal/cli/validate.go:1585:// validationSummaryOf projects a finished run for `pose report`: the commands\npose-mcp/internal/cli/validate.go:1619:func validationSummaryOf(run validationRunResult) *validationSummary {\n### Validation executed\nSee the execution log: the package tests with mutation checks, the full `go test ./...` and the strict matrix with 236 of 236 checks.\n\n### Residual risks\nAn instance that declares a module self-contained while its checks read files outside it would carry a stale result. The declaration is explicit and documented, and the default stays the full fallback.\n\n### Follow-ups\n- [open] F1: cover with an end-to-end test that a review bundle sealed over a carried record judges the carried head (seal, verify and closeout-check on a fixture). (owner:@pose-maintainers crit:low review:2026-12-15)\n- [open] F2: `--carry --report` lists carried checks as executed commands without their `carried_from` head and time; exclude them from the executed summary and label reused results (review round 13, N39). (owner:@pose-maintainers crit:low review:2026-12-15)\n.pose/rules/backend-go.md\ndiff --git a/POSE.md b/POSE.md\nindex 4621ed21..cc67d3a7 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -215,7 +215,7 @@ pose new-knowledge <type> <slug>   # create handoff/note/decision-log\n pose check [--strict|--tolerant]   # structural integrity + matrix schema +\n                                    # task-map sync + spec graph + schema version\n pose validate [--strict|--tolerant] [--stack s] [--module path] [--report] [--json-out f] [--junit f] [--sarif f]\n-              [--changed-from rev [--changed-to rev]] [--jobs n] [--explain] [--emit-plan f]\n+              [--changed-from rev [--changed-to rev] | --carry] [--jobs n] [--explain] [--emit-plan f]\n pose lint-spec <slug>|--all [--strict|--tolerant] [--required-only] [--ready-check] [--design-check]\n pose knowledge-check [--strict|--tolerant] [--max-overdue N]\n pose recurrence-check [--strict|--tolerant] [--window-days N] [--threshold T] [--flap-threshold N] [--include-pass]\n@@ -350,7 +350,9 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `new-knowledge` — creates an artifact in [`.pose/knowledge/`](.pose/knowledge/) from [`.pose/templates/knowledge.md`](.pose/templates/knowledge.md) with mandatory frontmatter (`type`, `owner`, `sensitivity`, `created_at`, `last_reviewed_at`, `expires_at`). Computes `expires_at` from the TTL (default 30d, max 90d).\n - `validate` — runs the declarative matrix in [`validation-matrix.json`](.pose/indexes/validation-matrix.json): per-stack checks, per-module overrides, severity (`required`/`optional`) and mode (`strict`/`tolerant`). `--json-out`/`--junit`/`--sarif <path>` (`--json <path>` still works as a deprecated alias of `--json-out <path>`) emit the versioned structured result (schema 1) from one canonical model: stable check IDs (`<module>/<stack>/<name>`), command metadata, timing, severity, distinguishable outcomes (`pass|fail|error|skipped` — infra failures never masquerade as check failures), deterministic skip reasons, bounded captured output and secret redaction (configured env values only; inherited environment never enters the result). Text output stays authoritative; machine formats are additive. POSE-specific semantics survive the JUnit/SARIF projections via documented extensions (classname suffix / `pose/*` properties).\n   **Runtime guardrails:** every check runs under a timeout (`timeoutSeconds` per check, `defaults.timeoutSeconds`, safe default 600s) and an output ceiling (`defaults.maxOutputBytes`, default 1 MiB); breaching either terminates the process group and records the explicit state (`limit_state: timeout|output-limit`). Checks marked `isolation: \"required\"` never run locally — they are skipped with a machine-readable reason and exported by `--emit-plan <file>`: an execution-plan envelope binding project, spec, check plan, matrix digest, git HEAD and an approval slot to be stamped with an expiring execution identity before the Harness may run it.\n-  **Changed scope:** `--changed-from <rev> [--changed-to <rev>]` selects the minimum safe module set deterministically — modules containing changed files (tracked and untracked), transitive dependents via `dependsOn` edges in [`module-metadata.json`](.pose/indexes/module-metadata.json), and policy widening (criticality `high` always runs). A change outside every module runs everything (uncertainty prefers safe execution); unselected checks are recorded as skipped with the selection reason and `--explain` prints every decision. Revisions are confined to a safe grammar; without the flags, full validation is unchanged.\n+  **Changed scope:** `--changed-from <rev> [--changed-to <rev>]` selects the minimum safe module set deterministically — modules containing changed files (tracked and untracked), transitive dependents via `dependsOn` edges in [`module-metadata.json`](.pose/indexes/module-metadata.json), and policy widening (criticality `high` always runs). Changed names are read NUL-delimited and a rename names both its source and its destination. Each changed file selects its most specific owning module, every module enclosing that owner (the root module encloses them all), every module beneath it (a gitlink or replaced directory changes what lies under it), and every module whose declared `dependsOn` contains it, lies beneath it or is the root `.`, even after that dependency is deleted. A file no module owns selects the root module. Module metadata that does not decode stops the selection (a full run under `--carry`, an error under `--changed-from`). A change outside every module runs every module that does not declare `\"selfContained\": true` in its metadata (uncertainty prefers safe execution; the declaration states that the module's checks read only its own directory and its `dependsOn` modules); unselected checks are recorded as skipped with the selection reason and `--explain` prints every decision. Revisions are confined to a safe grammar; without the flags, full validation is unchanged.\n+\n+  **Carried checks:** `--carry --json-out <results_path>` refreshes the canonical result instead of rerunning the whole matrix. It uses the current canonical result as its base when the base is comparable: same schema, mode, matrix digest and `engine_version` (the engine version plus the VCS revision the binary was built from; a build of a modified tree never carries), unfiltered, not cancelled (a signal cancels the whole run, even an all-carried one), recorded `material_clean` (it validated an unchanged working copy of its own head: no tracked or untracked unignored material changed and HEAD did not move while it ran, as its reflog and every submodule's reflog show; mode changes count whatever `core.fileMode` says, and every submodule must hold its recorded commit, checked both before the plan is read and when the run ends) with no unavailable material binding, with its `git_head` an ancestor of `HEAD`, a clean material working copy now, a case-sensitive filesystem with no case-folded directory on the path to a module or a dependency, no module reached through a symlink or sharing its directory with another module, no tracked symlink whose path or target lies in a module other than the root or in a declared `dependsOn` (or whose target leaves the repository), every submodule's tree included (a submodule that is not checked out or has nested submodules refuses), no declared dependency outside the repository or written as an unclean path or resolving through a symlink (tracked or ignored), only ASCII module and dependency paths, no index entry marked assume-unchanged or skip-worktree, and no check id defined twice. Changed names are read with every gitlink shown, whatever the Git configuration. The head is pinned before planning, and a run whose HEAD moved records its material bindings as unavailable. It runs the modules the changed-scope rules select between the base head and `HEAD`; the canonical result file and the derived administrative records that material bindings ignore (data files that are still regular files in the derived-record directories under `.pose/`: indexes, results, state, assessments and review records; the validation matrix stays material) are not changes. A module whose checks are not all in the base also runs. Every other check keeps the base result, its outcome included, and records `carried_from` (the head it ran at, kept through chained carries) and `carried_generated_at`; the delivery index reads that head for the result, so evidence freshness judges the commit a carried check really observed. A carried failure still fails the run. Any unmet condition runs everything, and `carry.reason` says why. `carry` records the base, the number of changed files and each selected module's reason, and `counts.carried` the reused checks. `--carry` does not combine with `--module`, `--stack`, `--workspace`, `--root-only`, `--changed-from` or `--changed-to`.\n \n   **Concurrency:** checks run up to `--jobs <n>` at a time (default: half the cores, bounded by available memory at about 1.5 GiB per check and by 8); results are reported and recorded in matrix order, whatever order they finish in, and the report records `jobs` and `wall_seconds`. `--jobs 1` and `--verbose` run one at a time. A check marked `exclusive: true` runs with nothing else running: earlier checks finish first, so its `when` can depend on them, which a concurrent check's cannot — a check's `when` is read as it starts. The run ends with its wall time beside the sum of its checks and the slowest checks. An interrupt or SIGTERM stops every running check's process group (on Windows, its process) and starts nothing more; those checks are recorded with `limit_state: cancelled`, the run is `fail` and exits 1, and a second signal acts at once. A default `--jobs` follows the cgroup's memory headroom and CPU quota where there is one.\n \ndiff --git a/locales/pt-BR/POSE.md b/locales/pt-BR/POSE.md\nindex df424ce4..8a3a01c2 100644\n--- a/locales/pt-BR/POSE.md\n+++ b/locales/pt-BR/POSE.md\n@@ -219,7 +219,7 @@ pose new-knowledge <type> <slug>   # cria handoff/note/decision-log em .pose/kno\n pose check [--strict|--tolerant]   # integridade estrutural + matrix schema +\n                                    # task-map sync + grafo de specs + schema version\n pose validate [--strict|--tolerant] [--stack s] [--module path] [--report] [--json-out f] [--junit f] [--sarif f]\n-              [--changed-from rev [--changed-to rev]] [--jobs n] [--explain] [--emit-plan f]\n+              [--changed-from rev [--changed-to rev] | --carry] [--jobs n] [--explain] [--emit-plan f]\n pose lint-spec <slug>|--all [--strict|--tolerant] [--required-only] [--ready-check] [--design-check]\n pose knowledge-check [--strict|--tolerant] [--max-overdue N]\n pose recurrence-check [--strict|--tolerant] [--window-days N] [--threshold T] [--flap-threshold N] [--include-pass]\n@@ -354,7 +354,9 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `new-knowledge` — cria artefato em [`.pose/knowledge/`](.pose/knowledge/) a partir de [`.pose/templates/knowledge.md`](.pose/templates/knowledge.md) com frontmatter obrigatório (`type`, `owner`, `sensitivity`, `created_at`, `last_reviewed_at`, `expires_at`). Calcula `expires_at` pelo TTL (default 30d, máximo 90d).\n - `validate` — executa a matriz declarativa em [`validation-matrix.json`](.pose/indexes/validation-matrix.json): checks por stack, overrides por módulo, severidade (`required`/`optional`) e modo (`strict`/`tolerant`). `--json-out`/`--junit`/`--sarif <path>` (`--json <path>` continua funcionando como alias depreciado de `--json-out <path>`) emitem o resultado estruturado versionado (schema 1) a partir de um único modelo canônico: IDs estáveis de check (`<module>/<stack>/<name>`), metadados de comando, tempo, severidade, outcomes distinguíveis (`pass|fail|error|skipped` — falha de infraestrutura nunca se disfarça de falha de check), motivos determinísticos de skip, saída capturada com limite e redação de segredos (apenas valores de env configurados; o ambiente herdado nunca entra no resultado). A saída em texto continua autoritativa; os formatos de máquina são aditivos. A semântica específica do POSE sobrevive às projeções JUnit/SARIF via extensões documentadas (sufixo de classname / propriedades `pose/*`).\n   **Guardrails de runtime:** todo check roda sob timeout (`timeoutSeconds` por check, `defaults.timeoutSeconds`, default seguro 600s) e teto de saída (`defaults.maxOutputBytes`, default 1 MiB); violar qualquer um encerra o process group e registra o estado explícito (`limit_state: timeout|output-limit`). Checks marcados `isolation: \"required\"` nunca rodam localmente — são pulados com motivo legível por máquina e exportados por `--emit-plan <file>`: um envelope de plano de execução vinculando projeto, spec, plano de checks, digest da matriz, git HEAD e um slot de aprovação a ser carimbado com identidade de execução expirável antes que o Harness possa executá-lo.\n-  **Escopo por mudança:** `--changed-from <rev> [--changed-to <rev>]` seleciona deterministicamente o conjunto mínimo seguro de módulos — módulos com arquivos alterados (rastreados e não rastreados), dependentes transitivos via arestas `dependsOn` em [`module-metadata.json`](.pose/indexes/module-metadata.json) e alargamento por política (criticidade `high` sempre roda). Uma mudança fora de todos os módulos roda tudo (na incerteza, prefere-se execução segura); checks não selecionados são registrados como skipped com o motivo da seleção e `--explain` imprime cada decisão. Revisões ficam confinadas a uma gramática segura; sem as flags, a validação completa é inalterada.\n+  **Escopo por mudança:** `--changed-from <rev> [--changed-to <rev>]` seleciona deterministicamente o conjunto mínimo seguro de módulos — módulos com arquivos alterados (rastreados e não rastreados), dependentes transitivos via arestas `dependsOn` em [`module-metadata.json`](.pose/indexes/module-metadata.json) e alargamento por política (criticidade `high` sempre roda). Os nomes alterados são lidos delimitados por NUL, e um rename nomeia a origem e o destino. Cada arquivo alterado seleciona o módulo dono mais específico, todo módulo que envolve esse dono (o módulo raiz envolve todos), todo módulo abaixo dele (um gitlink ou diretório substituído altera o que está abaixo) e todo módulo cujo `dependsOn` declarado o contém, está abaixo dele ou é a raiz `.`, mesmo depois que essa dependência é apagada. Um arquivo que nenhum módulo possui seleciona o módulo raiz. Metadados de módulo que não decodificam interrompem a seleção (execução completa com `--carry`, erro com `--changed-from`). Uma mudança fora de todos os módulos roda todo módulo que não declara `\"selfContained\": true` nos seus metadados (na incerteza, prefere-se execução segura; a declaração afirma que os checks do módulo só leem o próprio diretório e os módulos de `dependsOn`); checks não selecionados são registrados como skipped com o motivo da seleção e `--explain` imprime cada decisão. Revisões ficam confinadas a uma gramática segura; sem as flags, a validação completa é inalterada.\n+\n+  **Checks carregados:** `--carry --json-out <results_path>` renova o resultado canônico em vez de rodar a matriz inteira de novo. Ele usa o resultado canônico atual como base quando a base é comparável: mesmo schema, modo, digest da matriz e `engine_version` (a versão do motor mais a revisão VCS da qual o binário foi compilado; um build de árvore modificada nunca carrega), sem filtro, não cancelada (um sinal cancela o run inteiro, mesmo um só com checks carregados), com `material_clean` registrado (validou uma cópia de trabalho inalterada do próprio head: nenhum material rastreado ou não rastreado e não ignorado mudou, e o HEAD não se moveu durante o run, segundo o reflog dele e de todo submódulo; mudanças de modo contam qualquer que seja `core.fileMode`, e todo submódulo precisa estar no commit registrado, verificado antes da leitura do plano e no fim do run) e sem binding de material indisponível, com `git_head` ancestral de `HEAD` cópia de trabalho limpa agora nos paths materiais sistema de arquivos que diferencia maiúsculas, sem diretório com casefold no caminho até um módulo ou uma dependência, nenhum módulo alcançado por symlink ou compartilhando diretório com outro módulo, nenhum symlink rastreado cujo path ou alvo esteja num módulo que não seja a raiz ou num `dependsOn` declarado (ou cujo alvo saia do repositório), inclusive na árvore de todo submódulo (um submódulo sem checkout ou com submódulos aninhados recusa), nenhuma dependência declarada fora do repositório ou escrita como path não limpo ou que resolve por symlink (rastreado ou ignorado), apenas paths ASCII de módulo e dependência, nenhuma entrada de índice marcada assume-unchanged ou skip-worktree, e nenhum id de check definido duas vezes. Os nomes alterados são lidos com todo gitlink visível, qualquer que seja a configuração do Git. O head é fixado antes do planejamento, e um run cujo HEAD se moveu registra seus bindings de material como indisponíveis. Roda os módulos que as regras de escopo por mudança selecionam entre o head da base e `HEAD`; o arquivo do resultado canônico e os registros administrativos derivados que o binding de material ignora (arquivos de dados ainda regulares nos diretórios de registros derivados sob `.pose/`: índices, resultados, estado, assessments e registros de revisão; a matriz de validação continua material) não contam como mudança. Um módulo cujos checks não estão todos na base também roda. Todo outro check mantém o resultado da base, inclusive o desfecho, e registra `carried_from` (o head em que rodou, mantido em carregamentos encadeados) e `carried_generated_at`; o índice de entrega lê esse head no resultado, então o frescor da evidência julga o commit que um check carregado realmente observou. Uma falha carregada continua reprovando o run. Qualquer condição não atendida roda tudo, e `carry.reason` diz por quê. `carry` registra a base, o número de arquivos alterados e o motivo de cada módulo selecionado, e `counts.carried` os checks reaproveitados. `--carry` não combina com `--module`, `--stack`, `--workspace`, `--root-only`, `--changed-from` ou `--changed-to`.\n \n   **Concorrência:** os checks rodam até `--jobs <n>` ao mesmo tempo (padrão: metade dos núcleos, limitada pela memória disponível, cerca de 1,5 GiB por check, e por 8); os resultados são mostrados e registrados na ordem da matriz, seja qual for a ordem em que terminem, e o relatório registra `jobs` e `wall_seconds`. `--jobs 1` e `--verbose` rodam um de cada vez. Um check marcado `exclusive: true` roda sem nenhum outro em execução: os checks anteriores terminam antes, então seu `when` pode depender deles, o que o de um check concorrente não pode — o `when` de um check é lido quando ele vai começar. A execução termina com seu tempo de parede ao lado da soma dos checks e os checks mais lentos. Uma interrupção ou SIGTERM encerra o grupo de processos de cada check em execução (no Windows, seu processo) e não inicia mais nada; esses checks são registrados com `limit_state: cancelled`, a execução fica `fail` e sai com 1, e um segundo sinal age na hora. O `--jobs` padrão segue a folga de memória e a cota de CPU do cgroup, quando há um.\n \ndiff --git a/pose-mcp/internal/cli/help_catalog.go b/pose-mcp/internal/cli/help_catalog.go\nindex f252f70a..c6381d05 100644\n--- a/pose-mcp/internal/cli/help_catalog.go\n+++ b/pose-mcp/internal/cli/help_catalog.go\n@@ -129,6 +129,7 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"--json-out <path>\", \"Write structured validation outcome to the specified JSON path\", \"Grava o resultado da validação no caminho JSON especificado\"},\n \t\t\t{\"--json <path>\", \"Deprecated alias of --json-out <path>\", \"Alias depreciado de --json-out <path>\"},\n \t\t\t{\"--changed-from <rev>\", \"Validate only modules affected between git revisions\", \"Valida apenas módulos afetados entre as revisões git\"},\n+\t\t\t{\"--carry\", \"Refresh the canonical result: run what changed since it and carry the other checks with the head they ran at\", \"Renova o resultado canônico: roda o que mudou desde ele e carrega os demais checks com o head em que rodaram\"},\n \t\t\t{\"--jobs <n>\", \"Run up to n checks at once (default: from cores and available memory)\", \"Roda até n checks ao mesmo tempo (padrão: conforme núcleos e memória disponível)\"},\n \t\t\t{\"--verbose\", \"Stream each check's output as it runs; by default it is captured and a failing check's tail is shown\", \"Transmite a saída de cada check durante a execução; por padrão ela é capturada e o final da saída de um check que falha é exibido\"},\n \t\t},\ncat: pose-mcp/internal/cli/validate_canonical.go: No such file or directory\n","exit_code":1,"status":"failed"}}
