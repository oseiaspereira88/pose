{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'validate-carries|carry' pose-mcp/internal/cli/testdata/adversarial/README.md; git diff --quiet; nl -ba pose-mcp/internal/pose/delivery_validation_run.go | head -70; nl -ba pose-mcp/internal/cli/validate_carry.go | sed -n '415,455p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"encoding/json\"\n     5\t\t\"fmt\"\n     6\t\t\"sort\"\n     7\t)\n     8\t\n     9\t// DeliveryValidationResultSchema is the schema of the structured result of `pose validate`.\n    10\tconst DeliveryValidationResultSchema = 1\n    11\t\n    12\t// ParseDeliveryValidationRun reads the structured result of a validation run into the results\n    13\t// the delivery index holds: one per check that declares an evidence class, with the run's head,\n    14\t// time, provenance and scope provenance. relative is the path the results were read from. It is\n    15\t// the one reading of that file: the index is built with it and checked against it.\n    16\tfunc ParseDeliveryValidationRun(raw []byte, relative string) ([]DeliveryValidationResult, error) {\n    17\t\tvar run struct {\n    18\t\t\tSchemaVersion      int               `json:\"schema_version\"`\n    19\t\t\tGeneratedAt        string            `json:\"generated_at\"`\n    20\t\t\tGitHead            string            `json:\"git_head,omitempty\"`\n    21\t\t\tProvenanceDigest   string            `json:\"provenance_digest,omitempty\"`\n    22\t\t\tScopeProvenance    map[string]string `json:\"scope_provenance,omitempty\"`\n    23\t\t\tMaterialProvenance map[string]string `json:\"material_provenance,omitempty\"`\n    24\t\t\tChecks             []struct {\n    25\t\t\t\tID            string `json:\"id\"`\n    26\t\t\t\tModule        string `json:\"module\"`\n    27\t\t\t\tName          string `json:\"name\"`\n    28\t\t\t\tSeverity      string `json:\"severity\"`\n    29\t\t\t\tEvidenceClass string `json:\"evidence_class,omitempty\"`\n    30\t\t\t\tOutcome       string `json:\"outcome\"`\n    31\t\t\t\t// A carried check ran at its own head (spec\n    32\t\t\t\t// pose-validate-carries-unchanged-checks R7).\n    33\t\t\t\tCarriedFrom        string `json:\"carried_from,omitempty\"`\n    34\t\t\t\tCarriedGeneratedAt string `json:\"carried_generated_at,omitempty\"`\n    35\t\t\t} `json:\"checks\"`\n    36\t\t}\n    37\t\tif err := json.Unmarshal(raw, &run); err != nil || run.SchemaVersion != DeliveryValidationResultSchema {\n    38\t\t\treturn nil, fmt.Errorf(\"invalid structured validation result\")\n    39\t\t}\n    40\t\tresults := make([]DeliveryValidationResult, 0, len(run.Checks))\n    41\t\tfor _, check := range run.Checks {\n    42\t\t\tif check.EvidenceClass == \"\" {\n    43\t\t\t\tcontinue\n    44\t\t\t}\n    45\t\t\thead, generated := run.GitHead, run.GeneratedAt\n    46\t\t\tif check.CarriedFrom != \"\" {\n    47\t\t\t\thead, generated = check.CarriedFrom, check.CarriedGeneratedAt\n    48\t\t\t}\n    49\t\t\tresults = append(results, DeliveryValidationResult{ID: check.ID, Module: check.Module, Check: check.Name, EvidenceClass: check.EvidenceClass, Severity: check.Severity, Outcome: check.Outcome, GitHead: head, GeneratedAt: generated, ProvenanceDigest: run.ProvenanceDigest, ScopeProvenance: run.ScopeProvenance, MaterialProvenance: run.MaterialProvenance, Report: relative})\n    50\t\t}\n    51\t\tsort.Slice(results, func(i, j int) bool { return results[i].ID < results[j].ID })\n    52\t\treturn results, nil\n    53\t}\n   415\t}\n   416\t\n   417\t// gitlinks lists the gitlinks of a tree: path and recorded commit.\n   418\tfunc gitlinks(repo, commit string) (map[string]string, error) {\n   419\t\tout, err := posemodel.RawGit(\"-C\", repo, \"ls-tree\", \"-r\", \"-z\", commit).Output()\n   420\t\tif err != nil {\n   421\t\t\treturn nil, err\n   422\t\t}\n   423\t\tlinks := map[string]string{}\n   424\t\tfor _, entry := range strings.Split(string(out), \"\\x00\") {\n   425\t\t\tif !strings.HasPrefix(entry, \"160000 \") {\n   426\t\t\t\tcontinue\n   427\t\t\t}\n   428\t\t\ttab := strings.IndexByte(entry, '\\t')\n   429\t\t\tfields := strings.Fields(entry[:max(tab, 0)])\n   430\t\t\tif tab < 0 || len(fields) != 3 {\n   431\t\t\t\treturn nil, fmt.Errorf(\"unexpected tree entry %q\", entry)\n   432\t\t\t}\n   433\t\t\tlinks[entry[tab+1:]] = fields[2]\n   434\t\t}\n   435\t\treturn links, nil\n   436\t}\n   437\t\n   438\t// submoduleAliases names a submodule that could hide an alias: one that is\n   439\t// not checked out at its recorded commit, or that itself has gitlinks, or\n   440\t// whose tree tracks an aliasing symlink.\n   441\tfunc submoduleAliases(root, head string, modules []validationModule, meta scopeMetadata) (string, error) {\n   442\t\tlinks, err := gitlinks(root, head)\n   443\t\tif err != nil {\n   444\t\t\treturn \"\", err\n   445\t\t}\n   446\t\t// Every gitlink is scanned, not only those holding a module or a\n   447\t\t// dependency: one inside a module aliases its paths too (review round 9,\n   448\t\t// N24).\n   449\t\tfor sub, commit := range links {\n   450\t\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n   451\t\t\tif err := posemodel.RawGit(\"-C\", repo, \"cat-file\", \"-e\", commit+\"^{commit}\").Run(); err != nil {\n   452\t\t\t\treturn fmt.Sprintf(\"submodule %s is not checked out at its recorded commit, so aliases in it cannot be ruled out\", sub), nil\n   453\t\t\t}\n   454\t\t\tnested, err := gitlinks(repo, commit)\n   455\t\t\tif err != nil {\n","exit_code":0,"status":"completed"}}
