ir)\n                                       ~~~~~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^\n  File \"/usr/lib/python3.14/tempfile.py\", line 128, in _sanitize_params\n    dir = gettempdir()\n  File \"/usr/lib/python3.14/tempfile.py\", line 366, in gettempdir\n    return _os.fsdecode(_gettempdir())\n                        ~~~~~~~~~~~^^\n  File \"/usr/lib/python3.14/tempfile.py\", line 359, in _gettempdir\n    tempdir = _get_default_tempdir()\n  File \"/usr/lib/python3.14/tempfile.py\", line 223, in _get_default_tempdir\n    raise FileNotFoundError(_errno.ENOENT,\n                            \"No usable temporary directory found in %s\" %\n                            dirlist)\nFileNotFoundError: [Errno 2] No usable temporary directory found in ['/var/tmp/pose-work-go/pose-review-run-654557087', '/var/tmp/pose-work-go/pose-review-run-654557087', '/var/tmp/pose-work-go/pose-review-run-654557087', '/tmp', '/var/tmp', '/usr/tmp', '/var/tmp/pose-work-go/pose-review-run-654557087/worktree']\n","exit_code":1,"status":"failed"}}
{"type":"item.completed","item":{"id":"item_16","type":"agent_message","text":"The focused CLI and delivery/material tests passed, as did `go vet` and the build. Scratch creation is denied here, so I can’t reproduce new cases in a separate fixture.\n\nI found a concern in the source: carry selection reads module policy from the working copy, but the cleanliness check exempts that policy file as administrative data. I’m tracing whether this can bypass a declared dependency or high-criticality rule."}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/validate_carry.go | sed -n '115,140p'; nl -ba pose-mcp/internal/cli/validate_scope.go | sed -n '36,59p;195,222p'; nl -ba pose-mcp/internal/cli/validate.go | sed -n '1437,1478p;1716,1748p'; nl -ba pose-mcp/internal/cli/validate_carry.go | tail -75; sed -n '195,270p' pose-mcp/internal/cli/validate_carry_test.go; git status --porcelain\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/validate_carry.go | sed -n '115,140p'; nl -ba pose-mcp/internal/cli/validate_scope.go | sed -n '36,59p;195,222p'; nl -ba pose-mcp/internal/cli/validate.go | sed -n '1437,1478p;1716,1748p'; nl -ba pose-mcp/internal/cli/validate_carry.go | tail -75; sed -n '195,270p' pose-mcp/internal/cli/validate_carry_test.go; git status --porcelain\"","aggregated_output":"   115\t\t// Selection is lexical: a module reached through a symlink aliases another\n   116\t\t// path, so its inputs cannot be told apart (review round 4, N9).\n   117\t\t// Two modules sharing one physical directory (a case alias on a\n   118\t\t// case-insensitive filesystem) alias each other too (review round 5, N13).\n   119\t\tif reason := aliasedModule(modules, filepath.EvalSymlinks, os.Stat); reason != \"\" {\n   120\t\t\treturn unused(\"%s\", reason)\n   121\t\t}\n   122\t\t// Lexical selection cannot see through aliases. Rather than chase every\n   123\t\t// alias form (review rounds 4–7, N9, N13, N16–N18), a carry needs a\n   124\t\t// case-sensitive filesystem and no tracked symlink that links a module\n   125\t\t// (other than the root) or a declared dependency with any other path.\n   126\t\tmeta, err := loadScopeMetadata(root)\n   127\t\tif err != nil {\n   128\t\t\treturn unused(\"changed-scope selection failed: %v\", err)\n   129\t\t}\n   130\t\t// Symlinks inside a submodule hide behind its gitlink (review round 8,\n   131\t\t// N20): scan each checked-out submodule at its recorded commit, and refuse\n   132\t\t// when a module or a dependency lies in one that cannot be scanned.\n   133\t\tif reason, err := submoduleAliases(root, head, modules, meta); err != nil {\n   134\t\t\treturn unused(\"submodules cannot be read: %v\", err)\n   135\t\t} else if reason != \"\" {\n   136\t\t\treturn unused(\"%s\", reason)\n   137\t\t}\n   138\t\tif link, err := aliasingSymlink(root, head, modules, meta); err != nil {\n   139\t\t\treturn unused(\"tracked symlinks cannot be read: %v\", err)\n   140\t\t} else if link != \"\" {\n    36\t\tModules map[string]scopeModuleMeta `json:\"modules\"`\n    37\t}\n    38\t\n    39\t// loadScopeMetadata reads the module metadata. An absent file is empty\n    40\t// metadata; a file that does not decode is an error, never a partial\n    41\t// reading that could keep an exemption and drop a dependency (review round\n    42\t// 3, N6).\n    43\tfunc loadScopeMetadata(root string) (scopeMetadata, error) {\n    44\t\tvar meta scopeMetadata\n    45\t\traw, err := os.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"module-metadata.json\"))\n    46\t\tif errors.Is(err, os.ErrNotExist) {\n    47\t\t\treturn meta, nil\n    48\t\t}\n    49\t\tif err != nil {\n    50\t\t\treturn meta, fmt.Errorf(\"module metadata is unreadable: %v\", err)\n    51\t\t}\n    52\t\tif err := json.Unmarshal(raw, &meta); err != nil {\n    53\t\t\treturn scopeMetadata{}, fmt.Errorf(\"module metadata does not decode: %v\", err)\n    54\t\t}\n    55\t\treturn meta, nil\n    56\t}\n    57\t\n    58\t// scopeSelection maps selected module → deterministic selection reason.\n    59\ttype scopeSelection struct {\n   195\t\t\t\t\tsel.Selected[m.Rel] = \"policy: criticality high always runs\"\n   196\t\t\t\t}\n   197\t\t\t}\n   198\t\t}\n   199\t\t// Transitive dependents of selected modules (declared edges only).\n   200\t\tfor changed := true; changed; {\n   201\t\t\tchanged = false\n   202\t\t\tfor _, m := range modules {\n   203\t\t\t\tif _, ok := sel.Selected[m.Rel]; ok {\n   204\t\t\t\t\tcontinue\n   205\t\t\t\t}\n   206\t\t\t\tfor _, dep := range meta.Modules[m.Rel].DependsOn {\n   207\t\t\t\t\tif reason, ok := sel.Selected[filepath.ToSlash(filepath.Clean(dep))]; ok {\n   208\t\t\t\t\t\tsel.Selected[m.Rel] = \"depends on selected module \" + dep + \" (\" + firstScopeReason(reason) + \")\"\n   209\t\t\t\t\t\tchanged = true\n   210\t\t\t\t\t\tbreak\n   211\t\t\t\t\t}\n   212\t\t\t\t}\n   213\t\t\t}\n   214\t\t}\n   215\t\treturn sel, nil\n   216\t}\n   217\t\n   218\t// firstScopeReason keeps chained dependency reasons short and readable.\n   219\tfunc firstScopeReason(reason string) string {\n   220\t\tif i := strings.Index(reason, \" (\"); i > 0 {\n   221\t\t\treturn reason[:i]\n   222\t\t}\n  1437\t\t// name (review round 4, N10).\n  1438\t\tendHead := \"\"\n  1439\t\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n  1440\t\t\tendHead = strings.TrimSpace(string(head))\n  1441\t\t}\n  1442\t\t// Untracked material created while checks ran counts too (review round 8,\n  1443\t\t// N21): only ignored files may differ from the recorded head.\n  1444\t\n  1445\t\t// Equal endpoints do not show HEAD never moved: H -> H' -> H leaves them\n  1446\t\t// equal. The reflog must not have grown (review round 12, N34).\n  1447\t\t// The witness covers HEAD and every submodule's HEAD: a submodule moved\n  1448\t\t// away and back while checks ran is movement too (review round 15, N43).\n  1449\t\tendReflog := movementWitness(root, run.GitHead)\n  1450\t\trun.MaterialClean = startedClean && endedClean && run.GitHead != \"\" && endHead == run.GitHead && validationMaterialClean(root, run.GitHead) && startReflog != \"\" && endReflog == startReflog\n  1451\t\t// A run that did not validate its recorded head binds no material: its\n  1452\t\t// bindings would let a later tree make a misattributed pass current again\n  1453\t\t// (review round 5, N12).\n  1454\t\tif len(run.MaterialProvenance) > 0 && !run.MaterialClean {\n  1455\t\t\tfor spec := range run.MaterialProvenance {\n  1456\t\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n  1457\t\t\t}\n  1458\t\t}\n  1459\t\t// A cancelled run never reads as a success, whatever the severity of the\n  1460\t\t// checks it stopped (review round 1, B5).\n  1461\t\t// A signal cancels the run even when no executed check saw it, as in an\n  1462\t\t// all-carried run (review round 15, N45).\n  1463\t\tcancelled := runCtx.Err() != nil\n  1464\t\tfor _, check := range run.Checks {\n  1465\t\t\tcancelled = cancelled || check.LimitState == \"cancelled\"\n  1466\t\t}\n  1467\t\tif cancelled {\n  1468\t\t\trun.Cancelled, run.MaterialClean = true, false\n  1469\t\t}\n  1470\t\tfor _, line := range validationTimingNotes(run) {\n  1471\t\t\tsteps.Note(line)\n  1472\t\t}\n  1473\t\tsteps.Summary()\n  1474\t\tif executed == 0 && run.Counts.Carried == 0 {\n  1475\t\t\tfmt.Fprintln(stdout, \"No modules/checks matched the matrix and filters.\")\n  1476\t\t}\n  1477\t\tresult := \"pass\"\n  1478\t\tif cancelled {\n  1716\t// path outside the administrative classes, untracked files included. A status\n  1717\t// that cannot be read is not clean.\n  1718\tfunc materialWorktreeClean(root string) bool {\n  1719\t\t// Mode changes count whatever core.fileMode says (review round 13, N36).\n  1720\t\tout, err := gitOutputBounded(root, 16*1024*1024, \"-c\", \"core.fileMode=true\", \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n  1721\t\tif err != nil {\n  1722\t\t\treturn false\n  1723\t\t}\n  1724\t\trecords := strings.Split(string(out), \"\\x00\")\n  1725\t\tvar administrative []string\n  1726\t\tfor i := 0; i < len(records); i++ {\n  1727\t\t\trecord := records[i]\n  1728\t\t\tif len(record) < 4 {\n  1729\t\t\t\tcontinue\n  1730\t\t\t}\n  1731\t\t\tpaths := []string{record[3:]}\n  1732\t\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n  1733\t\t\t\t// A rename or copy carries its source as the next record.\n  1734\t\t\t\tif i+1 < len(records) {\n  1735\t\t\t\t\ti++\n  1736\t\t\t\t\tpaths = append(paths, records[i])\n  1737\t\t\t\t}\n  1738\t\t\t}\n  1739\t\t\tfor _, p := range paths {\n  1740\t\t\t\tif !posemodel.IsAdministrativePath(p) {\n  1741\t\t\t\t\treturn false\n  1742\t\t\t\t}\n  1743\t\t\t\tadministrative = append(administrative, p)\n  1744\t\t\t}\n  1745\t\t}\n  1746\t\treturn administrativeRecordsAreRegular(root, administrative)\n  1747\t}\n  1748\t\n   629\t\t}\n   630\t\tlines := strings.Count(string(out), \"\\n\")\n   631\t\tif lines == 0 {\n   632\t\t\treturn -1\n   633\t\t}\n   634\t\treturn lines\n   635\t}\n   636\t\n   637\t// submodulesCheckedOut returns a gitlink of head whose working repository is\n   638\t// missing or not at the recorded commit; \"\" when every one is.\n   639\tfunc submodulesCheckedOut(root, head string) string {\n   640\t\tlinks, err := gitlinks(root, head)\n   641\t\tif err != nil {\n   642\t\t\treturn \"(gitlinks unreadable)\"\n   643\t\t}\n   644\t\tfor sub, commit := range links {\n   645\t\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n   646\t\t\tif _, err := os.Stat(filepath.Join(repo, \".git\")); err != nil {\n   647\t\t\t\treturn sub\n   648\t\t\t}\n   649\t\t\tout, err := posemodel.RawGit(\"-C\", repo, \"rev-parse\", \"HEAD\").Output()\n   650\t\t\tif err != nil || strings.TrimSpace(string(out)) != commit {\n   651\t\t\t\treturn sub\n   652\t\t\t}\n   653\t\t}\n   654\t\treturn \"\"\n   655\t}\n   656\t\n   657\t// validationMaterialClean is the full predicate a run must satisfy at its\n   658\t// start and at its end to validate head (review rounds 8–14): no tracked or\n   659\t// untracked unignored difference in status (mode changes included), no index\n   660\t// entry hiding edits, and every submodule checked out at its recorded commit\n   661\t// (an uninitialized one reads as clean to status).\n   662\tfunc validationMaterialClean(root, head string) bool {\n   663\t\tif !materialWorktreeClean(root) {\n   664\t\t\treturn false\n   665\t\t}\n   666\t\tif hidden, err := hiddenIndexEntries(root, head); err != nil || hidden != \"\" {\n   667\t\t\treturn false\n   668\t\t}\n   669\t\treturn submodulesCheckedOut(root, head) == \"\"\n   670\t}\n   671\t\n   672\t// movementWitness summarizes the reflog lengths of HEAD and of every\n   673\t// checked-out submodule's HEAD; \"\" when any cannot be read, so the witness\n   674\t// never passes by default.\n   675\tfunc movementWitness(root, head string) string {\n   676\t\tparent := headReflogLength(root)\n   677\t\tif parent < 0 || head == \"\" {\n   678\t\t\treturn \"\"\n   679\t\t}\n   680\t\tparts := []string{fmt.Sprintf(\".=%d\", parent)}\n   681\t\tlinks, err := gitlinks(root, head)\n   682\t\tif err != nil {\n   683\t\t\treturn \"\"\n   684\t\t}\n   685\t\tsubs := make([]string, 0, len(links))\n   686\t\tfor sub := range links {\n   687\t\t\tsubs = append(subs, sub)\n   688\t\t}\n   689\t\tsort.Strings(subs)\n   690\t\tfor _, sub := range subs {\n   691\t\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n   692\t\t\tif _, err := os.Stat(filepath.Join(repo, \".git\")); err != nil {\n   693\t\t\t\tparts = append(parts, sub+\"=absent\")\n   694\t\t\t\tcontinue\n   695\t\t\t}\n   696\t\t\tn := headReflogLength(repo)\n   697\t\t\tif n < 0 {\n   698\t\t\t\treturn \"\"\n   699\t\t\t}\n   700\t\t\tparts = append(parts, fmt.Sprintf(\"%s=%d\", sub, n))\n   701\t\t}\n   702\t\treturn strings.Join(parts, \",\")\n   703\t}\n\t\t{\"no base\", func(f *carryFixture) {}, \"no canonical result\"},\n\t\t{\"matrix changed\", func(f *carryFixture) {\n\t\t\tf.baseline()\n\t\t\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\t\t\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"strict\"`, `\"strict\" `, 1))\n\t\t\tf.commit(\"matrix\")\n\t\t}, \"matrix\"},\n\t\t{\"dirty worktree\", func(f *carryFixture) {\n\t\t\tf.baseline()\n\t\t\tf.write(\"a/dirty.go\", \"package a\\n\")\n\t\t}, \"working copy\"},\n\t\t{\"base not an ancestor\", func(f *carryFixture) {\n\t\t\tf.baseline()\n\t\t\traw, _ := os.ReadFile(filepath.Join(f.root, carryResults))\n\t\t\tvar run map[string]any\n\t\t\t_ = json.Unmarshal(raw, &run)\n\t\t\trun[\"git_head\"] = strings.Repeat(\"0\", 40)\n\t\t\tout, _ := json.Marshal(run)\n\t\t\tf.write(carryResults, string(out))\n\t\t\tf.commit(\"forged base\")\n\t\t}, \"ancestor\"},\n\t\t{\"base without engine version\", func(f *carryFixture) {\n\t\t\tf.baseline()\n\t\t\traw, _ := os.ReadFile(filepath.Join(f.root, carryResults))\n\t\t\tvar run map[string]any\n\t\t\t_ = json.Unmarshal(raw, &run)\n\t\t\tdelete(run, \"engine_version\")\n\t\t\tout, _ := json.Marshal(run)\n\t\t\tf.write(carryResults, string(out))\n\t\t\tf.commit(\"old base\")\n\t\t}, \"engine\"},\n\t}\n\tfor _, tc := range cases {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tf := newCarryFixture(t, \"\")\n\t\t\ttc.mutate(f)\n\t\t\t_, out, run := f.validate(\"--carry\")\n\t\t\tif got := strings.Join(f.ran(), \",\"); got != \"a,b\" {\n\t\t\t\tt.Fatalf(\"executed = %q, want a full run; out=%s\", got, out)\n\t\t\t}\n\t\t\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, tc.reason) {\n\t\t\t\tt.Fatalf(\"carry = %+v, want unused with a reason naming %q\", run.Carry, tc.reason)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestCarryRootChangeRunsEverythingUnlessSelfContained(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.baseline()\n\tf.write(\"root.txt\", \"edited\\n\")\n\tf.commit(\"root\")\n\tf.validate(\"--carry\")\n\tif got := strings.Join(f.ran(), \",\"); got != \"a,b\" {\n\t\tt.Fatalf(\"root change executed %q, want everything\", got)\n\t}\n\n\tg := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true}}}`)\n\tg.baseline()\n\tg.write(\"root.txt\", \"edited\\n\")\n\tg.commit(\"root\")\n\t_, _, run := g.validate(\"--carry\")\n\tif got := strings.Join(g.ran(), \",\"); got != \"a\" {\n\t\tt.Fatalf(\"root change executed %q, want only the module that is not self-contained\", got)\n\t}\n\tif checkOf(run, \"b\").CarriedFrom == \"\" {\n\t\tt.Fatal(\"the self-contained module must be carried\")\n\t}\n}\n\nfunc TestChangedScopeHonoursSelfContainedModules(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true}}}`)\n\tf.write(\"root.txt\", \"edited\\n\")\n\t_, out := runValidate(t, f.root, \"--changed-from\", \"HEAD\", \"--explain\")\n\tif !strings.Contains(out, \"+ a: root-level change outside any module: root.txt\") || !strings.Contains(out, \"- b: not affected\") {\n\t\tt.Fatalf(\"self-contained module must not be widened by a root change: %s\", out)\n","exit_code":0,"status":"completed"}}
