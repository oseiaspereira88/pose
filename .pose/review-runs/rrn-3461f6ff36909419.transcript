orts strictly isolate POSE engine mechanics and never leak proprietary code.\n ## Opt-in progressive review profiles (ABM)\n \n Add `engineering-judgment@1` and/or `high-criticality-review@1` explicitly to\n\npose-mcp/internal/cli/managed_docs_test.go:129:\tif err := os.WriteFile(filepath.Join(root, \"POSE.md\"), []byte(stale), 0o644); err != nil {\npose-mcp/internal/cli/managed_docs_test.go:136:\tgot, err := os.ReadFile(filepath.Join(root, \"POSE.md\"))\npose-mcp/internal/cli/managed_docs_test.go:164:\tbefore, err := os.ReadFile(filepath.Join(repo, \"POSE.md\"))\npose-mcp/internal/cli/managed_docs_test.go:177:\tafter, err := os.ReadFile(filepath.Join(repo, \"POSE.md\"))\npose-mcp/internal/cli/managed_docs_test.go:198:\tif _, err := os.Stat(filepath.Join(root, \"POSE.md\")); !os.IsNotExist(err) {\npose-mcp/internal/cli/managed_docs_test.go:212:\tptBRExisting, err := fs.ReadFile(dist, \"locales/pt-BR/POSE.md\")\npose-mcp/internal/cli/managed_docs_test.go:214:\t\tt.Fatalf(\"reading shipped pt-BR POSE.md: %v\", err)\npose-mcp/internal/cli/managed_docs_test.go:216:\tif got := resolveDocLocale(dist, \"POSE.md\", string(ptBRExisting), \"en\", true); got != \"\" {\npose-mcp/internal/cli/managed_docs_test.go:224:\tif got := resolveDocLocale(dist, \"POSE.md\", string(ptBRExisting), \"en\", false); got != \"pt-BR\" {\npose-mcp/internal/cli/managed_docs_test.go:247:\tafter, err := os.ReadFile(filepath.Join(repo, \"POSE.md\"))\npose-mcp/internal/cli/managed_docs_test.go:332:// of POSE.md with other text, as if an older release had delivered it.\npose-mcp/internal/cli/managed_docs_test.go:340:\tpath = filepath.Join(repo, \"POSE.md\")\npose-mcp/internal/cli/managed_docs_test.go:355:\t\tt.Fatal(\"fixture POSE.md has no engine-owned section\")\npose-mcp/internal/cli/managed_docs_test.go:375:\tif err := recordDeliveredManual(repo, \"POSE.md\", older); err != nil {\npose-mcp/internal/cli/managed_docs_test.go:414:\tif deliveredManual(repo, \"POSE.md\") == nil {\npose-mcp/internal/cli/