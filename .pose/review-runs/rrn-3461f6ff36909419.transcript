te == \"cancelled\" {\n    91\t\t\t\treturn unused(\"the canonical result was cancelled\")\n    92\t\t\t}\n    93\t\t}\n    94\t\t// The base must have validated the commit it records: a run over a working\n    95\t\t// copy that differed from its head proves nothing about that head.\n    96\t\tif !base.MaterialClean {\n    97\t\t\treturn unused(\"the canonical result did not validate a clean working copy of its head\")\n    98\t\t}\n    99\t\tfor _, binding := range base.MaterialProvenance {\n   100\t\t\tif binding == posemodel.MaterialBindingUnavailable {\n   101\t\t\t\treturn unused(\"the canonical result records an unavailable material binding\")\n   102\t\t\t}\n   103\t\t}\n   104\t\tif !materialWorktreeClean(root) {\n   105\t\t\treturn unused(\"the working copy differs from HEAD in material paths\")\n   106\t\t}\n   107\t\tif err := posemodel.RawGit(\"-C\", root, \"merge-base\", \"--is-ancestor\", base.GitHead, \"HEAD\").Run(); err != nil {\n   108\t\t\treturn unused(\"the canonical result's head %s is not an ancestor of HEAD\", base.GitHead)\n   109\t\t}\n   110\t\tselection, err := computeChangedScope(root, base.GitHead, \"HEAD\", modules, carryExclusions(root, base.GitHead, resultsPath)...)\n   111\t\tif err != nil {\n   112\t\t\treturn unused(\"changed-scope selection failed: %v\", err)\n   113\t\t}\n   114\t\tplan.base = map[string]checkResult{}\n   115\t\tfor _, check := range base.Checks {\n   116\t\t\tplan.base[check.ID] = check\n   117\t\t}\n   118\t\t// A module whose checks are not all in the base runs (R3).\n   119\t\tfor _, module := range modules {\n   120\t\t\tif _, selected := selection.Selected[module.Rel]; selected {\n   121\t\t\t\tcontinue\n   122\t\t\t}\n   123\t\t\tstack, checks, _ := moduleValidationChecks(module, matrix, \"\", \"\")\n   124\t\t\tfor _, check := range checks {\n   125\t\t\t\tif check.Program == \"\" {\n   126\t\t\t\t\tcontinue\n   127\t\t\t\t}\n   128\t\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n   129\t\