{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/validate_scope.go | sed -n '40,190p'; sed -n '1,155p' pose-mcp/internal/cli/validate_scope_test.go; sed -n '1,155p' pose-mcp/internal/cli/validate_carry_test.go; sed -n '1675,1795p' pose-mcp/internal/cli/validate.go; sed -n '1,100p' .pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md\"","aggregated_output":"    40\t\traw, err := os.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"module-metadata.json\"))\n    41\t\tif err == nil {\n    42\t\t\t_ = json.Unmarshal(raw, &meta)\n    43\t\t}\n    44\t\treturn meta\n    45\t}\n    46\t\n    47\t// scopeSelection maps selected module → deterministic selection reason.\n    48\ttype scopeSelection struct {\n    49\t\tBase, Head string\n    50\t\tChanged    []string\n    51\t\tSelected   map[string]string\n    52\t}\n    53\t\n    54\tfunc (s scopeSelection) rangeLabel() string {\n    55\t\tif s.Head == \"\" {\n    56\t\t\treturn s.Base + \"..worktree\"\n    57\t\t}\n    58\t\treturn s.Base + \"..\" + s.Head\n    59\t}\n    60\t\n    61\t// computeChangedScope resolves the selection. Modules are selected when they\n    62\t// contain changed files, depend (transitively) on a changed module, or policy\n    63\t// widens them (criticality high). A change outside every module selects\n    64\t// every module that does not declare itself self-contained — uncertainty\n    65\t// prefers safe execution. Excluded paths (the run's own canonical result) are\n    66\t// not changes.\n    67\tfunc computeChangedScope(root, base, head string, modules []validationModule, exclude ...string) (scopeSelection, error) {\n    68\t\tsel := scopeSelection{Base: base, Head: head, Selected: map[string]string{}}\n    69\t\tfor _, rev := range []string{base, head} {\n    70\t\t\tif rev != \"\" && !safeGitRevRE.MatchString(rev) {\n    71\t\t\t\treturn sel, fmt.Errorf(\"unsafe git revision: %q\", rev)\n    72\t\t\t}\n    73\t\t}\n    74\t\t// NUL-delimited and without rename pairing: a quoted or multi-line name\n    75\t\t// keeps its owner, and a rename names both its source and its destination\n    76\t\t// (review round 2, N1 and N3).\n    77\t\tgitArgs := []string{\"-C\", root, \"diff\", \"--name-only\", \"-z\", \"--no-renames\", base}\n    78\t\tif head != \"\" {\n    79\t\t\tgitArgs = append(gitArgs, head)\n    80\t\t}\n    81\t\tgitArgs = append(gitArgs, \"--\")\n    82\t\tout, err := posemodel.RawGit(gitArgs...).Output()\n    83\t\tif err != nil {\n    84\t\t\treturn sel, fmt.Errorf(\"git diff %s failed (revision unknown?)\", sel.rangeLabel())\n    85\t\t}\n    86\t\tfor _, name := range strings.Split(string(out), \"\\x00\") {\n    87\t\t\tif name != \"\" {\n    88\t\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n    89\t\t\t}\n    90\t\t}\n    91\t\tif head == \"\" {\n    92\t\t\t// Worktree comparisons must also see untracked files — invisible new\n    93\t\t\t// code must never silently narrow validation (safe execution wins).\n    94\t\t\tif untracked, err := posemodel.RawHistoryGit(root, \"ls-files\", \"-z\", \"--others\", \"--exclude-standard\").Output(); err == nil {\n    95\t\t\t\tfor _, name := range strings.Split(string(untracked), \"\\x00\") {\n    96\t\t\t\t\tif name != \"\" {\n    97\t\t\t\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n    98\t\t\t\t\t}\n    99\t\t\t\t}\n   100\t\t\t}\n   101\t\t}\n   102\t\tif len(exclude) > 0 {\n   103\t\t\texcluded := map[string]bool{}\n   104\t\t\tfor _, path := range exclude {\n   105\t\t\t\texcluded[filepath.ToSlash(filepath.Clean(path))] = true\n   106\t\t\t}\n   107\t\t\tkept := sel.Changed[:0]\n   108\t\t\tfor _, file := range sel.Changed {\n   109\t\t\t\tif !excluded[file] {\n   110\t\t\t\t\tkept = append(kept, file)\n   111\t\t\t\t}\n   112\t\t\t}\n   113\t\t\tsel.Changed = kept\n   114\t\t}\n   115\t\tsort.Strings(sel.Changed)\n   116\t\n   117\t\tmeta := loadScopeMetadata(root)\n   118\t\tmoduleOf := func(file string) string {\n   119\t\t\tmatch := \"\"\n   120\t\t\tfor _, m := range modules {\n   121\t\t\t\tif file == m.Rel || strings.HasPrefix(file, m.Rel+\"/\") {\n   122\t\t\t\t\tif len(m.Rel) > len(match) {\n   123\t\t\t\t\t\tmatch = m.Rel\n   124\t\t\t\t\t}\n   125\t\t\t\t}\n   126\t\t\t}\n   127\t\t\treturn match\n   128\t\t}\n   129\t\tfor _, file := range sel.Changed {\n   130\t\t\tif m := moduleOf(file); m != \"\" {\n   131\t\t\t\tif _, ok := sel.Selected[m]; !ok {\n   132\t\t\t\t\tsel.Selected[m] = \"contains changed file: \" + file\n   133\t\t\t\t}\n   134\t\t\t} else {\n   135\t\t\t\t// Root-level or unmapped change: safe execution wins, except for\n   136\t\t\t\t// modules that declare their checks read nothing outside them. A\n   137\t\t\t\t// root module owns the files no other module owns, so its\n   138\t\t\t\t// declaration never exempts it from them (review round 2, N2).\n   139\t\t\t\tfor _, m := range modules {\n   140\t\t\t\t\tif meta.Modules[m.Rel].SelfContained && m.Rel != \".\" {\n   141\t\t\t\t\t\tcontinue\n   142\t\t\t\t\t}\n   143\t\t\t\t\tif _, ok := sel.Selected[m.Rel]; !ok {\n   144\t\t\t\t\t\tsel.Selected[m.Rel] = \"root-level change outside any module: \" + file\n   145\t\t\t\t\t}\n   146\t\t\t\t}\n   147\t\t\t}\n   148\t\t}\n   149\t\t// Policy widening: high-criticality modules always run.\n   150\t\tfor _, m := range modules {\n   151\t\t\tif meta.Modules[m.Rel].Criticality == \"high\" {\n   152\t\t\t\tif _, ok := sel.Selected[m.Rel]; !ok {\n   153\t\t\t\t\tsel.Selected[m.Rel] = \"policy: criticality high always runs\"\n   154\t\t\t\t}\n   155\t\t\t}\n   156\t\t}\n   157\t\t// Transitive dependents of selected modules (declared edges only).\n   158\t\tfor changed := true; changed; {\n   159\t\t\tchanged = false\n   160\t\t\tfor _, m := range modules {\n   161\t\t\t\tif _, ok := sel.Selected[m.Rel]; ok {\n   162\t\t\t\t\tcontinue\n   163\t\t\t\t}\n   164\t\t\t\tfor _, dep := range meta.Modules[m.Rel].DependsOn {\n   165\t\t\t\t\tif reason, ok := sel.Selected[filepath.ToSlash(filepath.Clean(dep))]; ok {\n   166\t\t\t\t\t\tsel.Selected[m.Rel] = \"depends on selected module \" + dep + \" (\" + firstScopeReason(reason) + \")\"\n   167\t\t\t\t\t\tchanged = true\n   168\t\t\t\t\t\tbreak\n   169\t\t\t\t\t}\n   170\t\t\t\t}\n   171\t\t\t}\n   172\t\t}\n   173\t\treturn sel, nil\n   174\t}\n   175\t\n   176\t// firstScopeReason keeps chained dependency reasons short and readable.\n   177\tfunc firstScopeReason(reason string) string {\n   178\t\tif i := strings.Index(reason, \" (\"); i > 0 {\n   179\t\t\treturn reason[:i]\n   180\t\t}\n   181\t\treturn reason\n   182\t}\npackage cli\n\n// Changed-scope behavior (spec pose-changed-scope-validation): deterministic\n// selection with reasons, dependency widening, safe-execution fallback,\n// machine-readable skip reasons and revision confinement.\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// scopeFixture builds a git repo with modules a and b (b depends on a) and\n// one commit; returns root. Checks are trivial `true` programs.\nfunc scopeFixture(t *testing.T, withDeps bool) string {\n\tt.Helper()\n\troot := t.TempDir()\n\twrite := func(rel, content string) {\n\t\tpath := filepath.Join(root, rel)\n\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\twrite(\"a/go.mod\", \"module a\\n\")\n\twrite(\"b/go.mod\", \"module b\\n\")\n\twrite(\"root.txt\", \"root\\n\")\n\tmatrix := `{\"defaults\":{\"mode\":\"strict\"},\"stacks\":{\"go\":{\"checks\":[{\"name\":\"ok\",\"program\":\"true\",\"severity\":\"required\"}]}}}`\n\twrite(\".pose/indexes/validation-matrix.json\", matrix)\n\tif withDeps {\n\t\twrite(\".pose/indexes/module-metadata.json\", `{\"schemaVersion\":1,\"modules\":{\"b\":{\"dependsOn\":[\"a\"]}}}`)\n\t}\n\tgit := func(args ...string) {\n\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...)\n\t\tcmd.Env = append(os.Environ(), \"GIT_AUTHOR_NAME=t\", \"GIT_AUTHOR_EMAIL=t@t\", \"GIT_COMMITTER_NAME=t\", \"GIT_COMMITTER_EMAIL=t@t\")\n\t\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t}\n\tgit(\"init\", \"-q\")\n\tgit(\"add\", \"-A\")\n\tgit(\"commit\", \"-qm\", \"base\")\n\treturn root\n}\n\nfunc TestChangedScopeSelectsAffectedModule(t *testing.T) {\n\troot := scopeFixture(t, false)\n\tif err := os.WriteFile(filepath.Join(root, \"a\", \"changed.go\"), []byte(\"package a\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcode, out := runValidate(t, root, \"--changed-from\", \"HEAD\", \"--explain\", \"--json\", \"result.json\")\n\tif code != 0 {\n\t\tt.Fatalf(\"exit=%d out=%s\", code, out)\n\t}\n\tif !strings.Contains(out, \"+ a: contains changed file: a/changed.go\") || !strings.Contains(out, \"- b: not affected\") {\n\t\tt.Errorf(\"explain output missing decisions: %s\", out)\n\t}\n\trun := loadRun(t, root)\n\tvar aOutcome, bReason string\n\tfor _, c := range run.Checks {\n\t\tif c.Module == \"a\" {\n\t\t\taOutcome = c.Outcome\n\t\t}\n\t\tif c.Module == \"b\" {\n\t\t\tbReason = c.SkipReason\n\t\t}\n\t}\n\tif aOutcome != \"pass\" {\n\t\tt.Errorf(\"module a should run, outcome=%s\", aOutcome)\n\t}\n\tif !strings.Contains(bReason, \"changed-scope: module not affected by HEAD..worktree\") {\n\t\tt.Errorf(\"module b skip reason = %q\", bReason)\n\t}\n}\n\nfunc TestChangedScopeDependencyWidening(t *testing.T) {\n\troot := scopeFixture(t, true)\n\tif err := os.WriteFile(filepath.Join(root, \"a\", \"changed.go\"), []byte(\"package a\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, out := runValidate(t, root, \"--changed-from\", \"HEAD\", \"--explain\")\n\tif !strings.Contains(out, \"+ b: depends on selected module a\") {\n\t\tt.Errorf(\"dependent module must be widened with a reason: %s\", out)\n\t}\n}\n\nfunc TestChangedScopeRootChangeRunsEverything(t *testing.T) {\n\troot := scopeFixture(t, false)\n\tif err := os.WriteFile(filepath.Join(root, \"root.txt\"), []byte(\"edited\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, out := runValidate(t, root, \"--changed-from\", \"HEAD\", \"--explain\")\n\tfor _, want := range []string{\"+ a: root-level change outside any module: root.txt\", \"+ b: root-level change outside any module: root.txt\"} {\n\t\tif !strings.Contains(out, want) {\n\t\t\tt.Errorf(\"safe-execution fallback missing %q in: %s\", want, out)\n\t\t}\n\t}\n}\n\nfunc TestChangedScopeNoChangesSkipsAllWithReasons(t *testing.T) {\n\troot := scopeFixture(t, false)\n\tcode, _ := runValidate(t, root, \"--changed-from\", \"HEAD\", \"--json\", \"result.json\")\n\tif code != 0 {\n\t\tt.Fatalf(\"exit=%d\", code)\n\t}\n\trun := loadRun(t, root)\n\tif run.Counts.Executed != 0 || run.Counts.Skipped != 2 {\n\t\tt.Errorf(\"counts = %+v, want everything skipped with reasons\", run.Counts)\n\t}\n\traw, _ := json.Marshal(run.Checks)\n\tif !strings.Contains(string(raw), \"changed-scope: module not affected\") {\n\t\tt.Errorf(\"skip reasons must be machine-readable: %s\", raw)\n\t}\n}\n\nfunc TestChangedScopeRejectsUnsafeRevision(t *testing.T) {\n\troot := scopeFixture(t, false)\n\tcode, out := runValidate(t, root, \"--changed-from\", \"-rev^{}\")\n\tif code != 2 || !strings.Contains(out, \"unsafe git revision\") {\n\t\tt.Fatalf(\"unsafe revision must be rejected before git runs: code=%d out=%s\", code, out)\n\t}\n\tcode, out = runValidate(t, root, \"--changed-to\", \"HEAD\")\n\tif code != 2 || !strings.Contains(out, \"--changed-from\") {\n\t\tt.Fatalf(\"--changed-to alone must be rejected: code=%d out=%s\", code, out)\n\t}\n}\npackage cli\n\n// Carried checks (spec pose-validate-carries-unchanged-checks): validate\n// --carry refreshes the canonical result by running only what a change can\n// affect and carrying the rest with the head it really ran at.\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"testing\"\n)\n\nconst carryResults = \".pose/results/delivery-validation.json\"\n\ntype carryFixture struct {\n\tt       *testing.T\n\troot    string\n\tcounter string\n}\n\n// newCarryFixture builds a committed repository with Go modules a and b and\n// a root file. Every check appends its module to a counter file outside the\n// tree, so a test can tell an executed check from a carried one.\nfunc newCarryFixture(t *testing.T, metadata string) *carryFixture {\n\tt.Helper()\n\tf := &carryFixture{t: t, root: t.TempDir(), counter: filepath.Join(t.TempDir(), \"runs\")}\n\tf.write(\"a/go.mod\", \"module a\\n\")\n\tf.write(\"b/go.mod\", \"module b\\n\")\n\tf.write(\"root.txt\", \"root\\n\")\n\tf.write(\".gitignore\", \".pose/transfers/.authority-transfer.lock\\n\")\n\tf.write(\".pose/policy/delivery.json\", `{\"schema_version\":1,\"enabled\":true,\"results_path\":\"`+carryResults+`\"}`)\n\tmatrix := `{\"defaults\":{\"mode\":\"strict\"},\"stacks\":{\"go\":{\"checks\":[` +\n\t\t`{\"name\":\"ok\",\"program\":\"sh\",\"args\":[\"-c\",\"basename \\\"$PWD\\\" >> ` + f.counter + `; test ! -f fail\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}}}`\n\tf.write(\".pose/indexes/validation-matrix.json\", matrix)\n\tif metadata != \"\" {\n\t\tf.write(\".pose/indexes/module-metadata.json\", metadata)\n\t}\n\tf.git(\"init\", \"-q\")\n\tf.commit(\"base\")\n\treturn f\n}\n\nfunc (f *carryFixture) write(rel, content string) {\n\tf.t.Helper()\n\tpath := filepath.Join(f.root, rel)\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\tf.t.Fatal(err)\n\t}\n}\n\nfunc (f *carryFixture) git(args ...string) string {\n\tf.t.Helper()\n\tcmd := exec.Command(\"git\", append([]string{\"-C\", f.root}, args...)...)\n\tcmd.Env = append(os.Environ(), \"GIT_AUTHOR_NAME=t\", \"GIT_AUTHOR_EMAIL=t@t\", \"GIT_COMMITTER_NAME=t\", \"GIT_COMMITTER_EMAIL=t@t\", \"GIT_CONFIG_GLOBAL=/dev/null\")\n\tout, err := cmd.CombinedOutput()\n\tif err != nil {\n\t\tf.t.Fatalf(\"git %v: %v %s\", args, err, out)\n\t}\n\treturn strings.TrimSpace(string(out))\n}\n\nfunc (f *carryFixture) commit(message string) string {\n\tf.t.Helper()\n\tf.git(\"add\", \"-A\")\n\tf.git(\"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-qm\", message, \"--allow-empty\")\n\treturn f.git(\"rev-parse\", \"HEAD\")\n}\n\n// validate runs pose validate and returns its exit code, output and the\n// canonical record it wrote. The counter is reset first.\nfunc (f *carryFixture) validate(args ...string) (int, string, validationRunResult) {\n\tf.t.Helper()\n\t_ = os.Remove(f.counter)\n\tcode, out := runValidate(f.t, f.root, append(args, \"--json-out\", carryResults)...)\n\tvar run validationRunResult\n\tif raw, err := os.ReadFile(filepath.Join(f.root, carryResults)); err == nil {\n\t\tif err := json.Unmarshal(raw, &run); err != nil {\n\t\t\tf.t.Fatal(err)\n\t\t}\n\t}\n\treturn code, out, run\n}\n\nfunc (f *carryFixture) ran() []string {\n\traw, err := os.ReadFile(f.counter)\n\tif err != nil {\n\t\treturn nil\n\t}\n\truns := strings.Fields(string(raw))\n\tsort.Strings(runs)\n\treturn runs\n}\n\nfunc checkOf(run validationRunResult, module string) checkResult {\n\tfor _, c := range run.Checks {\n\t\tif c.Module == module {\n\t\t\treturn c\n\t\t}\n\t}\n\treturn checkResult{}\n}\n\n// baseline runs the full matrix, commits the canonical record and returns the\n// head the record validated.\nfunc (f *carryFixture) baseline() string {\n\tf.t.Helper()\n\tvalidated := f.git(\"rev-parse\", \"HEAD\")\n\tcode, out, _ := f.validate()\n\tif code != 0 {\n\t\tf.t.Fatalf(\"baseline exit=%d %s\", code, out)\n\t}\n\tf.commit(\"record\")\n\treturn validated\n}\n\nfunc TestCarryRunsOnlyTheChangedModule(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tbase := f.baseline()\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\thead := f.commit(\"change a\")\n\tcode, out, run := f.validate(\"--carry\")\n\tif code != 0 {\n\t\tt.Fatalf(\"exit=%d %s\", code, out)\n\t}\n\tif got := strings.Join(f.ran(), \",\"); got != \"a\" {\n\t\tt.Fatalf(\"executed modules = %q, want only a\", got)\n\t}\n\tif run.Carry == nil || !run.Carry.Used || run.Carry.BaseHead != base {\n\t\tt.Fatalf(\"carry = %+v, want used from %s\", run.Carry, base)\n\t}\n\tif b := checkOf(run, \"b\"); b.Outcome != \"pass\" || b.CarriedFrom != base || b.CarriedGeneratedAt == \"\" {\n\t\tt.Fatalf(\"b = %+v, want a pass carried from %s\", b, base)\n\t}\n\tif a := checkOf(run, \"a\"); a.CarriedFrom != \"\" || a.Outcome != \"pass\" {\n\t\tt.Fatalf(\"a = %+v, want executed\", a)\n\t}\n\tif run.GitHead != head || run.Counts.Carried != 1 || run.Counts.Executed != 1 || run.Counts.Passed != 2 {\n\t\tt.Fatalf(\"head=%s counts=%+v\", run.GitHead, run.Counts)\n\t}\n\tif run.EngineVersion == \"\" {\n\t\tt.Fatal(\"engine_version must be recorded\")\n\t}\n}\n\nfunc TestCarryKeepsTheOriginalHeadAcrossChainedCarries(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tbase := f.baseline()\n\tf.write(\"a/one.go\", \"package a\\n\")\n\t\t}\n\t}\n\treturn newArgs\n}\n\n// materialWorktreeClean reports whether the working copy equals HEAD in every\n// path outside the administrative classes, untracked files included. A status\n// that cannot be read is not clean.\nfunc materialWorktreeClean(root string) bool {\n\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n\tif err != nil {\n\t\treturn false\n\t}\n\trecords := strings.Split(string(out), \"\\x00\")\n\tvar administrative []string\n\tfor i := 0; i < len(records); i++ {\n\t\trecord := records[i]\n\t\tif len(record) < 4 {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{record[3:]}\n\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n\t\t\t// A rename or copy carries its source as the next record.\n\t\t\tif i+1 < len(records) {\n\t\t\t\ti++\n\t\t\t\tpaths = append(paths, records[i])\n\t\t\t}\n\t\t}\n\t\tfor _, p := range paths {\n\t\t\tif !posemodel.IsAdministrativePath(p) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tadministrative = append(administrative, p)\n\t\t}\n\t}\n\treturn administrativeRecordsAreRegular(root, administrative)\n}\n\n// materialTrackedUnchanged reports whether no tracked file differs from HEAD\n// outside the administrative records. Untracked files are not counted: checks\n// leave build products behind, and those are not the material they ran over.\nfunc materialTrackedUnchanged(root string) bool {\n\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=no\")\n\tif err != nil {\n\t\treturn false\n\t}\n\trecords := strings.Split(string(out), \"\\x00\")\n\tvar administrative []string\n\tfor i := 0; i < len(records); i++ {\n\t\trecord := records[i]\n\t\tif len(record) < 4 {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{record[3:]}\n\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n\t\t\tif i+1 < len(records) {\n\t\t\t\ti++\n\t\t\t\tpaths = append(paths, records[i])\n\t\t\t}\n\t\t}\n\t\tfor _, p := range paths {\n\t\t\tif !posemodel.IsAdministrativePath(p) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tadministrative = append(administrative, p)\n\t\t}\n\t}\n\treturn administrativeRecordsAreRegular(root, administrative)\n}\n\n// administrativeRecordsAreRegular reports whether every changed administrative\n// path is a regular file at HEAD (or new): editing a committed symlink or\n// submodule inside a class is a material change, as in MaterialSetDigest.\nfunc administrativeRecordsAreRegular(root string, paths []string) bool {\n\tif len(paths) == 0 {\n\t\treturn true\n\t}\n\targs := []string{\"ls-tree\", \"-z\", \"HEAD\", \"--\"}\n\tfor _, p := range paths {\n\t\tif strings.ContainsAny(p, \"\\n\\x00\") {\n\t\t\treturn false\n\t\t}\n\t\t// The working copy as well as HEAD: a regular record replaced by a link, or\n\t\t// a new link, is not a record.\n\t\tif info, err := os.Lstat(filepath.Join(root, filepath.FromSlash(p))); err == nil && !info.Mode().IsRegular() {\n\t\t\treturn false\n\t\t}\n\t\targs = append(args, \":(literal)\"+p)\n\t}\n\tout, err := gitOutputBounded(root, 8*1024*1024, args...)\n\tif err != nil {\n\t\treturn false\n\t}\n\tfor _, record := range strings.Split(string(out), \"\\x00\") {\n\t\tmeta, _, ok := strings.Cut(record, \"\\t\")\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif fields := strings.Fields(meta); len(fields) == 3 && fields[0] != \"100644\" && fields[0] != \"100755\" {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n---\ntype: decision-log\nslug: module-metadata-discovery-invalidates-review-provenance\nowner: @pose-maintainers\nsensitivity: public-internal\ncreated_at: 2026-08-16\nlast_reviewed_at: 2026-08-16\nexpires_at: 2026-11-14\nsource_refs:\n  spec: \"pose-upgrade-path-audit-fixes\"\n  workflow: \"bugfix\"\n  commands: [\"pose update --force\", \"pose install\", \"pose index\", \"pose review bundle --seal\"]\n  external_sources: []\n---\n\n# decision-log: module-metadata-discovery-invalidates-review-provenance\n\n## Context\n\nAuditing `pose update`/`pose install` across 7 real repositories ahead of\nthe v1.4.0 release found that running either command on `pose-dist` itself\n(the product's own dogfooding instance) discovered\n`examples/brownfield-kits/direct-adoption/fixture/service/go.mod` — an\nillustrative fixture, not a real deliverable module — as a genuine module\nand added it to `.pose/indexes/module-metadata.json`. That single addition\nrecomputed the global provenance digest (`graph.ProvenanceDigest`, computed\nover the whole delivery-integrity graph, not per-spec — see the\n`pose-gate-closeout-procedure` session note this decision-log\ngeneralizes) and superseded the review attestation of every already-closed\nspec whose scope touches `module-metadata.json`: between 3 and 22 specs\nacross the audit's trial runs, depending on which other specs had most\nrecently closed.\n\n## Current state\n\nFixed the trigger only (spec `pose-upgrade-path-audit-fixes`, R7):\n`testdata`, `fixture` and `fixtures` directories are now excluded from\nmodule discovery in all three independent walkers\n(`discoverValidationModules` in validate.go, `scanModules` in index.go,\nand `internal/pose/discovery.go`'s capability scanner). A genuine,\nintentional module-metadata change — a real module added, removed or\nreclassified — still invalidates every closed spec's review attestation\nthat touches it, exactly as designed today. That broader behavior was\ndeliberately left unchanged (Decision 2 in the spec above): narrowing the\nprovenance digest so it only invalidates reviews whose scope actually\nincludes the changed module is a real design trade-off (what counts as\n\"unrelated,\" whether a narrower digest weakens the guarantee it exists to\nprovide) that deserves its own spec and explicit review, not a side effect\nof fixing a discovery false-positive.\n\n## Next checks\n\n- None deterministic yet. If a future spec pursues narrowing the\n  provenance digest, `pose-mcp/internal/pose/delivery_integrity.go`\n  (`ProvenanceDigest`) and `pose review bundle --seal`'s scope-provenance\n  matching are the two places to start reading.\n\n## Risks\n\n- Any *other* directory-discovery path added in the future (a fourth\n  scanner, or a stack detector that walks the tree independently) needs\n  the same `testdata`/`fixture`/`fixtures` exclusion applied by hand —\n  there is no single shared walker all three call today (each has its own\n  `ignored` map/condition; see the follow-up already on record about this\n  in `pose-review-bundle-roadmap-path-portability`/session knowledge about\n  \"enumerate by hand\" gaps recurring across this repository).\n- Every maintainer who runs `pose update --force`/`pose install` on\n  `pose-dist` itself after a *real* module-metadata change should expect\n  to reseal/reattest every closed spec whose review scope includes\n  `module-metadata.json`, per `pose-gate-closeout-procedure` — this is\n  expected, not a bug, and this decision-log's fix does not change it.\n\n## Next owner\n\n@pose-maintainers — no active handoff; revisit only if the digest-scoping\nfollow-up (spec `pose-upgrade-path-audit-fixes`, Follow-ups) is picked up.\n\n## References\n\n- spec:pose-upgrade-path-audit-fixes (Decision 2, R7, Non-goals)\n- knowledge: session note `pose-gate-closeout-procedure` (this repository's\n  own local agent memory, not a `.pose/knowledge/` artifact) — first\n  documented that the provenance digest is global-over-the-graph, not\n  per-spec, and that reseal/reattest is required after any reindex that\n  changes it.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"All four prior regression tests pass, and the corresponding fixes are present. The full sweep found another dependency-selection gap: if a dependency’s directory or manifest is removed, it drops out of current module discovery. Its deleted files can then be treated as out-of-module changes, allowing a self-contained dependent to carry its old result despite an explicit `dependsOn` edge.\n"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"git diff dec2e64c..43764959 -- POSE.md locales/pt-BR/POSE.md pose-mcp/internal/cli/help_catalog.go; cat pose-mcp/internal/pose/delivery_validation_run_test.go; sed -n '310,390p' pose-mcp/internal/cli/validate.go; sed -n '615,675p' pose-mcp/internal/pose/delivery_surface.go; sed -n '1,120p' pose-mcp/internal/pose/material_binding.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"git diff dec2e64c..43764959 -- POSE.md locales/pt-BR/POSE.md pose-mcp/internal/cli/help_catalog.go; cat pose-mcp/internal/pose/delivery_validation_run_test.go; sed -n '310,390p' pose-mcp/internal/cli/validate.go; sed -n '615,675p' pose-mcp/internal/pose/delivery_surface.go; sed -n '1,120p' pose-mcp/internal/pose/material_binding.go\"","aggregated_output":"diff --git a/POSE.md b/POSE.md\nindex 4621ed21..61281528 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -215,7 +215,7 @@ pose new-knowledge <type> <slug>   # create handoff/note/decision-log\n pose check [--strict|--tolerant]   # structural integrity + matrix schema +\n                                    # task-map sync + spec graph + schema version\n pose validate [--strict|--tolerant] [--stack s] [--module path] [--report] [--json-out f] [--junit f] [--sarif f]\n-              [--changed-from rev [--changed-to rev]] [--jobs n] [--explain] [--emit-plan f]\n+              [--changed-from rev [--changed-to rev] | --carry] [--jobs n] [--explain] [--emit-plan f]\n pose lint-spec <slug>|--all [--strict|--tolerant] [--required-only] [--ready-check] [--design-check]\n pose knowledge-check [--strict|--tolerant] [--max-overdue N]\n pose recurrence-check [--strict|--tolerant] [--window-days N] [--threshold T] [--flap-threshold N] [--include-pass]\n@@ -350,7 +350,9 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `new-knowledge` — creates an artifact in [`.pose/knowledge/`](.pose/knowledge/) from [`.pose/templates/knowledge.md`](.pose/templates/knowledge.md) with mandatory frontmatter (`type`, `owner`, `sensitivity`, `created_at`, `last_reviewed_at`, `expires_at`). Computes `expires_at` from the TTL (default 30d, max 90d).\n - `validate` — runs the declarative matrix in [`validation-matrix.json`](.pose/indexes/validation-matrix.json): per-stack checks, per-module overrides, severity (`required`/`optional`) and mode (`strict`/`tolerant`). `--json-out`/`--junit`/`--sarif <path>` (`--json <path>` still works as a deprecated alias of `--json-out <path>`) emit the versioned structured result (schema 1) from one canonical model: stable check IDs (`<module>/<stack>/<name>`), command metadata, timing, severity, distinguishable outcomes (`pass|fail|error|skipped` — infra failures never masquerade as check failures), deterministic skip reasons, bounded captured output and secret redaction (configured env values only; inherited environment never enters the result). Text output stays authoritative; machine formats are additive. POSE-specific semantics survive the JUnit/SARIF projections via documented extensions (classname suffix / `pose/*` properties).\n   **Runtime guardrails:** every check runs under a timeout (`timeoutSeconds` per check, `defaults.timeoutSeconds`, safe default 600s) and an output ceiling (`defaults.maxOutputBytes`, default 1 MiB); breaching either terminates the process group and records the explicit state (`limit_state: timeout|output-limit`). Checks marked `isolation: \"required\"` never run locally — they are skipped with a machine-readable reason and exported by `--emit-plan <file>`: an execution-plan envelope binding project, spec, check plan, matrix digest, git HEAD and an approval slot to be stamped with an expiring execution identity before the Harness may run it.\n-  **Changed scope:** `--changed-from <rev> [--changed-to <rev>]` selects the minimum safe module set deterministically — modules containing changed files (tracked and untracked), transitive dependents via `dependsOn` edges in [`module-metadata.json`](.pose/indexes/module-metadata.json), and policy widening (criticality `high` always runs). A change outside every module runs everything (uncertainty prefers safe execution); unselected checks are recorded as skipped with the selection reason and `--explain` prints every decision. Revisions are confined to a safe grammar; without the flags, full validation is unchanged.\n+  **Changed scope:** `--changed-from <rev> [--changed-to <rev>]` selects the minimum safe module set deterministically — modules containing changed files (tracked and untracked), transitive dependents via `dependsOn` edges in [`module-metadata.json`](.pose/indexes/module-metadata.json), and policy widening (criticality `high` always runs). Changed names are read NUL-delimited and a rename names both its source and its destination. A root module owns the files no other module owns. A change outside every module runs every module that does not declare `\"selfContained\": true` in its metadata (uncertainty prefers safe execution; the declaration states that the module's checks read only its own directory and its `dependsOn` modules); unselected checks are recorded as skipped with the selection reason and `--explain` prints every decision. Revisions are confined to a safe grammar; without the flags, full validation is unchanged.\n+\n+  **Carried checks:** `--carry --json-out <results_path>` refreshes the canonical result instead of rerunning the whole matrix. It uses the current canonical result as its base when the base is comparable: same schema, mode, matrix digest and `engine_version` (the engine version plus the VCS revision the binary was built from; a build of a modified tree never carries), unfiltered, not cancelled, recorded `material_clean` (it validated an unchanged working copy of its own head) with no unavailable material binding, with its `git_head` an ancestor of `HEAD`, and a clean material working copy now. It runs the modules the changed-scope rules select between the base head and `HEAD`; the canonical result file and the derived administrative records that material bindings ignore (data files that are still regular files in the derived-record directories under `.pose/`: indexes, results, state, assessments and review records; the validation matrix stays material) are not changes. A module whose checks are not all in the base also runs. Every other check keeps the base result, its outcome included, and records `carried_from` (the head it ran at, kept through chained carries) and `carried_generated_at`; the delivery index reads that head for the result, so evidence freshness judges the commit a carried check really observed. A carried failure still fails the run. Any unmet condition runs everything, and `carry.reason` says why. `carry` records the base, the number of changed files and each selected module's reason, and `counts.carried` the reused checks. `--carry` does not combine with `--module`, `--stack`, `--workspace`, `--root-only`, `--changed-from` or `--changed-to`.\n \n   **Concurrency:** checks run up to `--jobs <n>` at a time (default: half the cores, bounded by available memory at about 1.5 GiB per check and by 8); results are reported and recorded in matrix order, whatever order they finish in, and the report records `jobs` and `wall_seconds`. `--jobs 1` and `--verbose` run one at a time. A check marked `exclusive: true` runs with nothing else running: earlier checks finish first, so its `when` can depend on them, which a concurrent check's cannot — a check's `when` is read as it starts. The run ends with its wall time beside the sum of its checks and the slowest checks. An interrupt or SIGTERM stops every running check's process group (on Windows, its process) and starts nothing more; those checks are recorded with `limit_state: cancelled`, the run is `fail` and exits 1, and a second signal acts at once. A default `--jobs` follows the cgroup's memory headroom and CPU quota where there is one.\n \ndiff --git a/locales/pt-BR/POSE.md b/locales/pt-BR/POSE.md\nindex df424ce4..840a3964 100644\n--- a/locales/pt-BR/POSE.md\n+++ b/locales/pt-BR/POSE.md\n@@ -219,7 +219,7 @@ pose new-knowledge <type> <slug>   # cria handoff/note/decision-log em .pose/kno\n pose check [--strict|--tolerant]   # integridade estrutural + matrix schema +\n                                    # task-map sync + grafo de specs + schema version\n pose validate [--strict|--tolerant] [--stack s] [--module path] [--report] [--json-out f] [--junit f] [--sarif f]\n-              [--changed-from rev [--changed-to rev]] [--jobs n] [--explain] [--emit-plan f]\n+              [--changed-from rev [--changed-to rev] | --carry] [--jobs n] [--explain] [--emit-plan f]\n pose lint-spec <slug>|--all [--strict|--tolerant] [--required-only] [--ready-check] [--design-check]\n pose knowledge-check [--strict|--tolerant] [--max-overdue N]\n pose recurrence-check [--strict|--tolerant] [--window-days N] [--threshold T] [--flap-threshold N] [--include-pass]\n@@ -354,7 +354,9 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `new-knowledge` — cria artefato em [`.pose/knowledge/`](.pose/knowledge/) a partir de [`.pose/templates/knowledge.md`](.pose/templates/knowledge.md) com frontmatter obrigatório (`type`, `owner`, `sensitivity`, `created_at`, `last_reviewed_at`, `expires_at`). Calcula `expires_at` pelo TTL (default 30d, máximo 90d).\n - `validate` — executa a matriz declarativa em [`validation-matrix.json`](.pose/indexes/validation-matrix.json): checks por stack, overrides por módulo, severidade (`required`/`optional`) e modo (`strict`/`tolerant`). `--json-out`/`--junit`/`--sarif <path>` (`--json <path>` continua funcionando como alias depreciado de `--json-out <path>`) emitem o resultado estruturado versionado (schema 1) a partir de um único modelo canônico: IDs estáveis de check (`<module>/<stack>/<name>`), metadados de comando, tempo, severidade, outcomes distinguíveis (`pass|fail|error|skipped` — falha de infraestrutura nunca se disfarça de falha de check), motivos determinísticos de skip, saída capturada com limite e redação de segredos (apenas valores de env configurados; o ambiente herdado nunca entra no resultado). A saída em texto continua autoritativa; os formatos de máquina são aditivos. A semântica específica do POSE sobrevive às projeções JUnit/SARIF via extensões documentadas (sufixo de classname / propriedades `pose/*`).\n   **Guardrails de runtime:** todo check roda sob timeout (`timeoutSeconds` por check, `defaults.timeoutSeconds`, default seguro 600s) e teto de saída (`defaults.maxOutputBytes`, default 1 MiB); violar qualquer um encerra o process group e registra o estado explícito (`limit_state: timeout|output-limit`). Checks marcados `isolation: \"required\"` nunca rodam localmente — são pulados com motivo legível por máquina e exportados por `--emit-plan <file>`: um envelope de plano de execução vinculando projeto, spec, plano de checks, digest da matriz, git HEAD e um slot de aprovação a ser carimbado com identidade de execução expirável antes que o Harness possa executá-lo.\n-  **Escopo por mudança:** `--changed-from <rev> [--changed-to <rev>]` seleciona deterministicamente o conjunto mínimo seguro de módulos — módulos com arquivos alterados (rastreados e não rastreados), dependentes transitivos via arestas `dependsOn` em [`module-metadata.json`](.pose/indexes/module-metadata.json) e alargamento por política (criticidade `high` sempre roda). Uma mudança fora de todos os módulos roda tudo (na incerteza, prefere-se execução segura); checks não selecionados são registrados como skipped com o motivo da seleção e `--explain` imprime cada decisão. Revisões ficam confinadas a uma gramática segura; sem as flags, a validação completa é inalterada.\n+  **Escopo por mudança:** `--changed-from <rev> [--changed-to <rev>]` seleciona deterministicamente o conjunto mínimo seguro de módulos — módulos com arquivos alterados (rastreados e não rastreados), dependentes transitivos via arestas `dependsOn` em [`module-metadata.json`](.pose/indexes/module-metadata.json) e alargamento por política (criticidade `high` sempre roda). Os nomes alterados são lidos delimitados por NUL, e um rename nomeia a origem e o destino. Um módulo raiz é dono dos arquivos que nenhum outro módulo possui. Uma mudança fora de todos os módulos roda todo módulo que não declara `\"selfContained\": true` nos seus metadados (na incerteza, prefere-se execução segura; a declaração afirma que os checks do módulo só leem o próprio diretório e os módulos de `dependsOn`); checks não selecionados são registrados como skipped com o motivo da seleção e `--explain` imprime cada decisão. Revisões ficam confinadas a uma gramática segura; sem as flags, a validação completa é inalterada.\n+\n+  **Checks carregados:** `--carry --json-out <results_path>` renova o resultado canônico em vez de rodar a matriz inteira de novo. Ele usa o resultado canônico atual como base quando a base é comparável: mesmo schema, modo, digest da matriz e `engine_version` (a versão do motor mais a revisão VCS da qual o binário foi compilado; um build de árvore modificada nunca carrega), sem filtro, não cancelada, com `material_clean` registrado (validou uma cópia de trabalho inalterada do próprio head) e sem binding de material indisponível, com `git_head` ancestral de `HEAD` e cópia de trabalho limpa agora nos paths materiais. Roda os módulos que as regras de escopo por mudança selecionam entre o head da base e `HEAD`; o arquivo do resultado canônico e os registros administrativos derivados que o binding de material ignora (arquivos de dados ainda regulares nos diretórios de registros derivados sob `.pose/`: índices, resultados, estado, assessments e registros de revisão; a matriz de validação continua material) não contam como mudança. Um módulo cujos checks não estão todos na base também roda. Todo outro check mantém o resultado da base, inclusive o desfecho, e registra `carried_from` (o head em que rodou, mantido em carregamentos encadeados) e `carried_generated_at`; o índice de entrega lê esse head no resultado, então o frescor da evidência julga o commit que um check carregado realmente observou. Uma falha carregada continua reprovando o run. Qualquer condição não atendida roda tudo, e `carry.reason` diz por quê. `carry` registra a base, o número de arquivos alterados e o motivo de cada módulo selecionado, e `counts.carried` os checks reaproveitados. `--carry` não combina com `--module`, `--stack`, `--workspace`, `--root-only`, `--changed-from` ou `--changed-to`.\n \n   **Concorrência:** os checks rodam até `--jobs <n>` ao mesmo tempo (padrão: metade dos núcleos, limitada pela memória disponível, cerca de 1,5 GiB por check, e por 8); os resultados são mostrados e registrados na ordem da matriz, seja qual for a ordem em que terminem, e o relatório registra `jobs` e `wall_seconds`. `--jobs 1` e `--verbose` rodam um de cada vez. Um check marcado `exclusive: true` roda sem nenhum outro em execução: os checks anteriores terminam antes, então seu `when` pode depender deles, o que o de um check concorrente não pode — o `when` de um check é lido quando ele vai começar. A execução termina com seu tempo de parede ao lado da soma dos checks e os checks mais lentos. Uma interrupção ou SIGTERM encerra o grupo de processos de cada check em execução (no Windows, seu processo) e não inicia mais nada; esses checks são registrados com `limit_state: cancelled`, a execução fica `fail` e sai com 1, e um segundo sinal age na hora. O `--jobs` padrão segue a folga de memória e a cota de CPU do cgroup, quando há um.\n \ndiff --git a/pose-mcp/internal/cli/help_catalog.go b/pose-mcp/internal/cli/help_catalog.go\nindex f252f70a..c6381d05 100644\n--- a/pose-mcp/internal/cli/help_catalog.go\n+++ b/pose-mcp/internal/cli/help_catalog.go\n@@ -129,6 +129,7 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"--json-out <path>\", \"Write structured validation outcome to the specified JSON path\", \"Grava o resultado da validação no caminho JSON especificado\"},\n \t\t\t{\"--json <path>\", \"Deprecated alias of --json-out <path>\", \"Alias depreciado de --json-out <path>\"},\n \t\t\t{\"--changed-from <rev>\", \"Validate only modules affected between git revisions\", \"Valida apenas módulos afetados entre as revisões git\"},\n+\t\t\t{\"--carry\", \"Refresh the canonical result: run what changed since it and carry the other checks with the head they ran at\", \"Renova o resultado canônico: roda o que mudou desde ele e carrega os demais checks com o head em que rodaram\"},\n \t\t\t{\"--jobs <n>\", \"Run up to n checks at once (default: from cores and available memory)\", \"Roda até n checks ao mesmo tempo (padrão: conforme núcleos e memória disponível)\"},\n \t\t\t{\"--verbose\", \"Stream each check's output as it runs; by default it is captured and a failing check's tail is shown\", \"Transmite a saída de cada check durante a execução; por padrão ela é capturada e o final da saída de um check que falha é exibido\"},\n \t\t},\npackage pose\n\nimport \"testing\"\n\n// A carried check is read as an observation of the head it ran at (spec\n// pose-validate-carries-unchanged-checks R7); an executed one keeps the run's.\nfunc TestDeliveryValidationRunReadsTheCarriedHead(t *testing.T) {\n\traw := []byte(`{\"schema_version\":1,\"generated_at\":\"2026-11-22T10:00:00Z\",\"git_head\":\"bbbb\",\"checks\":[` +\n\t\t`{\"id\":\"a/go/ok\",\"module\":\"a\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\"},` +\n\t\t`{\"id\":\"b/go/ok\",\"module\":\"b\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\",\"carried_from\":\"aaaa\",\"carried_generated_at\":\"2026-11-21T09:00:00Z\"}]}`)\n\tresults, err := ParseDeliveryValidationRun(raw, \".pose/results/delivery-validation.json\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(results) != 2 {\n\t\tt.Fatalf(\"results = %+v\", results)\n\t}\n\tfor _, r := range results {\n\t\tswitch r.ID {\n\t\tcase \"a/go/ok\":\n\t\t\tif r.GitHead != \"bbbb\" || r.GeneratedAt != \"2026-11-22T10:00:00Z\" {\n\t\t\t\tt.Fatalf(\"executed check read as %s at %s\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\tcase \"b/go/ok\":\n\t\t\tif r.GitHead != \"aaaa\" || r.GeneratedAt != \"2026-11-21T09:00:00Z\" {\n\t\t\t\tt.Fatalf(\"carried check read as %s at %s, want the head it ran at\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\t}\n\t}\n}\n// ranNone reports that Go named packages and said of each that it ran no test.\nfunc (p *goTestPackages) ranNone() bool {\n\treturn p.empty > 0 && p.withTests == 0\n}\n\n// markCancelled records a check the run's cancellation stopped or kept from\n// starting.\nfunc (e *validationEntry) markCancelled() {\n\te.result.Outcome, e.result.LimitState = \"error\", \"cancelled\"\n\te.result.Output = \"validation cancelled — process group terminated\"\n}\n\n// dispatchValidationEntries starts the entries in matrix order, up to jobs at\n// a time; an exclusive check waits for the running ones and runs alone (spec\n// pose-validate-concurrent-steps R1–R2). A cancelled run starts nothing more.\nfunc dispatchValidationEntries(ctx context.Context, entries []*validationEntry, jobs int, matrix validationMatrix) {\n\tslots := make(chan struct{}, jobs)\n\tvar running sync.WaitGroup\n\tcancelled := func(entry *validationEntry) bool {\n\t\tif ctx.Err() == nil {\n\t\t\treturn false\n\t\t}\n\t\tentry.markCancelled()\n\t\tclose(entry.done)\n\t\treturn true\n\t}\n\tfor _, entry := range entries {\n\t\tif entry.note != \"\" || entry.silent || entry.isolated {\n\t\t\tcontinue\n\t\t}\n\t\tif entry.check.Exclusive {\n\t\t\trunning.Wait()\n\t\t\tif cancelled(entry) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif entry.resolveWhen(); entry.skip == \"\" {\n\t\t\t\tentry.execute(ctx, matrix, false, nil, nil, nil)\n\t\t\t}\n\t\t\tclose(entry.done)\n\t\t\tcontinue\n\t\t}\n\t\tselect {\n\t\tcase slots <- struct{}{}:\n\t\tcase <-ctx.Done():\n\t\t\tcancelled(entry)\n\t\t\tcontinue\n\t\t}\n\t\tif cancelled(entry) {\n\t\t\t<-slots\n\t\t\tcontinue\n\t\t}\n\t\trunning.Add(1)\n\t\tgo func(entry *validationEntry) {\n\t\t\tdefer running.Done()\n\t\t\tdefer func() { <-slots }()\n\t\t\tif entry.resolveWhen(); entry.skip == \"\" {\n\t\t\t\tentry.execute(ctx, matrix, false, nil, nil, nil)\n\t\t\t}\n\t\t\tclose(entry.done)\n\t\t}(entry)\n\t}\n}\n\n// validationResources is what a run may use. memoryKnown separates an empty\n// reading from none; unresolved says a cgroup applies whose limits could not\n// be located.\ntype validationResources struct {\n\tcpus        float64\n\tmemory      uint64\n\tmemoryKnown bool\n\tunresolved  bool\n}\n\nfunc (r *validationResources) limitMemory(available uint64) {\n\tif !r.memoryKnown || available < r.memory {\n\t\tr.memory, r.memoryKnown = available, true\n\t}\n}\n\nfunc (r *validationResources) limitCPU(quota, period float64) {\n\tif quota > 0 && period > 0 && quota/period < r.cpus {\n\tsort.Slice(sets, func(i, j int) bool { return sets[i].ID < sets[j].ID })\n\traw, _ := json.Marshal(struct {\n\t\tClaims []ArtifactClaim `json:\"claims\"`\n\t\tSets   []ChangeSet     `json:\"change_sets\"`\n\t}{claims, withoutMaterialDigest(sets)})\n\tsum := sha256.Sum256(raw)\n\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n}\n\nfunc deliveryEvidenceCurrent(result DeliveryValidationResult, spec, status string, graph DeliveryIntegrityGraph, sets []ChangeSet) bool {\n\tif bound := result.MaterialProvenance[spec]; bound != \"\" {\n\t\t// A material binding governs: a mismatch is stale, never a fall-through\n\t\t// to the commit-bound rules below. Only a closed spec keeps its exemption.\n\t\tif bound == ScopedMaterialDigest(graph, spec) {\n\t\t\treturn true\n\t\t}\n\t\treturn status == \"done\" && result.GeneratedAt != \"\"\n\t}\n\tif scoped := result.ScopeProvenance[spec]; scoped != \"\" {\n\t\tif scoped == ScopedDeliveryProvenanceDigest(graph, spec) {\n\t\t\treturn true\n\t\t}\n\t\tif status == \"done\" && result.GeneratedAt != \"\" {\n\t\t\treturn true\n\t\t}\n\t\treturn false\n\t}\n\tif result.ProvenanceDigest != \"\" && result.ProvenanceDigest == graph.ProvenanceDigest {\n\t\treturn true\n\t}\n\t// Results emitted before scope_provenance existed were module-wide. Preserve\n\t// them only for already-closed historical specs: their immutable closeout\n\t// cannot retroactively acquire the new field, and unrelated later targets\n\t// must not invalidate them. Open/current scopes never receive this bridge.\n\tif status == \"done\" && result.ProvenanceDigest != \"\" && result.GeneratedAt != \"\" {\n\t\treturn true\n\t}\n\tif result.GitHead == \"\" {\n\t\treturn false\n\t}\n\tfor _, set := range sets {\n\t\tif result.GitHead == set.Head || result.GitHead == set.ResolvedHead {\n\t\t\treturn true\n\t\t}\n\t\tfor _, commit := range set.Commits {\n\t\t\tif result.GitHead == commit {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t}\n\treturn false\n}\n\nfunc finalizeExtendedDeliveryGraph(graph *DeliveryIntegrityGraph) {\n\tsort.Slice(graph.Nodes, func(i, j int) bool { return graph.Nodes[i].ID < graph.Nodes[j].ID })\n\tsort.Slice(graph.Edges, func(i, j int) bool { return edgeLess(graph.Edges[i], graph.Edges[j]) })\n\tgraph.Edges = dedupeSortedEdges(graph.Edges)\n\tsort.Slice(graph.Findings, func(i, j int) bool { return graph.Findings[i].ID < graph.Findings[j].ID })\n\tsort.Slice(graph.Deliveries, func(i, j int) bool { return graph.Deliveries[i].Ref < graph.Deliveries[j].Ref })\n\tsort.Slice(graph.ValidationResults, func(i, j int) bool { return graph.ValidationResults[i].ID < graph.ValidationResults[j].ID })\n\tsort.Slice(graph.RoadmapCriteria, func(i, j int) bool {\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Validation evidence binds to the material it validated (spec\n// pose-validation-evidence-material-binding, ADR\n// validation-evidence-binds-to-validated-material). A commit whose every\n// changed path is a derived administrative record does not change what the\n// checks exercised, so it does not move the material digest.\n\n// engineVersion is the running engine, registered by the binaries (internal/pose\n// stays importable on its own). It is part of every material digest, so a new\n// engine never inherits evidence the previous one produced.\nvar engineVersion = \"unregistered\"\n\n// SetEngineVersion registers the running engine for material digests.\nfunc SetEngineVersion(v string) { engineVersion = v }\n\n// administrativeDirs is the closed list of derived-record directories. It is\n// owned by the engine; adding a class is a contract change that needs an ADR.\nvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n\n// materialIndexes are files inside an administrative directory that still\n// change what the checks demand.\nvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\n// IsAdministrativePath reports whether p is a derived administrative record.\nfunc IsAdministrativePath(p string) bool {\n\tif p == \"\" || p != path.Clean(p) || strings.HasPrefix(p, \"/\") || strings.HasPrefix(p, \"../\") {\n\t\treturn false\n\t}\n\tif materialIndexes[p] {\n\t\treturn false\n\t}\n\tif !recordExtensions[strings.ToLower(path.Ext(p))] {\n\t\treturn false\n\t}\n\tfor _, dir := range administrativeDirs {\n\t\tif strings.HasPrefix(p, dir) {\n\t\t\treturn true\n\t\t}\n\t}\n\tif rest, ok := strings.CutPrefix(p, \".pose/\"); ok {\n\t\tif i := strings.Index(rest, \"/\"); i > 0 && strings.HasPrefix(rest[:i], \"review-\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// recordExtensions are the data formats a derived record is written in. Code or\n// a script stored in a class is material: that keeps a source file moved or\n// copied into a class from hiding its later edits. A copied data file stays\n// indistinguishable from a record; a check that reads data out of a derived-record\n// directory is outside this contract (ADR validation-evidence-binds-to-validated-material).\nvar recordExtensions = map[string]bool{\".json\": true, \".jsonl\": true, \".ndjson\": true, \".md\": true, \".txt\": true, \".log\": true, \".transcript\": true}\n\n// TreeEntry is one entry of the validated head's tree.\ntype TreeEntry struct{ Mode, Blob string }\n\nfunc regularMode(mode string) bool { return mode == \"100644\" || mode == \"100755\" }\n\n// MaterialInputs are what a material digest is computed from: the paths a change\n// set names (both sides of a rename, and the validation matrix) and the\n// destinations of renames. They are stored with the set so the digest can be\n// recomputed against the current tree without the commits' own records.\ntype MaterialInputs struct {\n\tNames []string `json:\"names\"`\n\tMoved []string `json:\"moved,omitempty\"`\n}\n\n// MaterialInputsOf derives the inputs from per-commit path records. They must\n// be unmerged: folding a create and a later rename into one creation would hide\n// that the file moved into a class.\nfunc MaterialInputsOf(paths []ObservedPath) MaterialInputs {\n\tnames := map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\tmoved := map[string]bool{}\n\tfor _, p := range paths {\n\t\tfor _, name := range []string{p.Path, p.OldPath, p.NewPath} {\n\t\t\tif name != \"\" {\n\t\t\t\tnames[name] = true\n\t\t\t}\n\t\t}\n\t\t// A rename destination is material whatever directory it lands in:\n\t\t// otherwise moving a source file into a class would hide its later edits.\n\t\tif p.OldPath != \"\" && p.NewPath != \"\" {\n\t\t\tmoved[p.NewPath] = true\n\t\t}\n\t}\n\tin := MaterialInputs{}\n\tfor name := range names {\n\t\tin.Names = append(in.Names, name)\n\t}\n\tfor name := range moved {\n\t\tin.Moved = append(in.Moved, name)\n\t}\n\tsort.Strings(in.Names)\n\tsort.Strings(in.Moved)\n\treturn in\n}\n\n// MaterialSetDigest digests the head state of the material a change set\n// touched: every path it names (both sides of a rename) with its mode and blob\n// at the validated head, minus the paths that are administrative records and\n// still regular files there, plus the validation matrix. A symlink, submodule\n// or directory in an administrative class is material; so is a path that left\n// a class. tree maps each named path (and the matrix) to its entry; a path\n// absent from the head tree is \"absent\".\nfunc MaterialSetDigest(in MaterialInputs, tree map[string]TreeEntry) string {\n\tmoved := map[string]bool{}\n\tfor _, name := range in.Moved {\n\t\tmoved[name] = true\n","exit_code":0,"status":"completed"}}
