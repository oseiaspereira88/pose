{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NnE22kytus4opKK9mHgn5b","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"os\"\n6\t\t\"os/exec\"\n7\t\t\"path/filepath\"\n8\t\t\"reflect\"\n9\t\t\"strings\"\n10\t\t\"testing\"\n11\t)\n12\t\n13\t// Spec pose-claude-reviewer-runs-tests-in-sandbox.\n14\tfunc sandboxedReviewFixture(t *testing.T, profile string) []byte {\n15\t\tt.Helper()\n16\t\tlegacy, err := parseReviewersPolicy([]byte(legacyReviewersFixture))\n17\t\tif err != nil {\n18\t\t\tt.Fatal(err)\n19\t\t}\n20\t\tp, err := MigrateReviewersPolicy(legacy)\n21\t\tif err != nil {\n22\t\t\tt.Fatal(err)\n23\t\t}\n24\t\traw, err := json.Marshal(p)\n25\t\tif err != nil {\n26\t\t\tt.Fatal(err)\n27\t\t}\n28\t\tvar doc map[string]any\n29\t\tif err := json.Unmarshal(raw, &doc); err != nil {\n30\t\t\tt.Fatal(err)\n31\t\t}\n32\t\tif profile != \"\" {\n33\t\t\tvar value any\n34\t\t\tif err := json.Unmarshal([]byte(profile), &value); err != nil {\n35\t\t\t\tt.Fatal(err)\n36\t\t\t}\n37\t\t\tdoc[\"agents\"].(map[string]any)[\"codex\"].(map[string]any)[\"review_profile\"] = value\n38\t\t}\n39\t\traw, err = json.Marshal(doc)\n40\t\tif err != nil {\n41\t\t\tt.Fatal(err)\n42\t\t}\n43\t\treturn raw\n44\t}\n45\t\n46\tfunc TestSandboxedReviewSelectsOnlyReviewAndKeepsResumeConfiguration(t *testing.T) {\n47\t\tp, err := ParseDelegationPolicy(sandboxedReviewFixture(t, `{\"command\":[\"sandbox\",\"fresh\",\"{output}\"],\"resume_command\":[\"sandbox\",\"resume\",\"{session}\",\"{output}\"]}`))\n48\t\tif err != nil {\n49\t\t\tt.Fatal(err)\n50\t\t}\n51\t\tbefore, _ := json.Marshal(p.Agents[\"codex\"])\n52\t\tfor _, purpose := range []string{DelegationPurposeReview, DelegationPurposeAdjudicate, DelegationPurposeSmoke, DelegationPurposeTask} {\n53\t\t\ta, ok := p.agentAdapter(\"codex\", purpose)\n54\t\t\tif !ok {\n55\t\t\t\tt.Fatal(\"missing agent\")\n56\t\t\t}\n57\t\t\twant := \"codex\"\n58\t\t\tif purpose == DelegationPurposeReview {\n59\t\t\t\twant = \"sandbox\"\n60\t\t\t}\n61\t\t\tif a.Command[0] != want || a.Resume.Command[0] != want {\n62\t\t\t\tt.Fatalf(\"%s: wrong command/resume: %+v\", purpose, a)\n63\t\t\t}\n64\t\t\tif a.Resume.MaxResumes != 2 || a.Session.Pattern == \"\" {\n65\t\t\t\tt.Fatalf(\"continuity lost: %+v\", a)\n66\t\t\t}\n67\t\t}\n68\t\ta, _ := p.agentAdapter(\"codex\", DelegationPurposeReview)\n69\t\ta.Resume.Command[0] = \"changed\"\n70\t\ta.Command[0] = \"changed\"\n71\t\tafter, _ := json.Marshal(p.Agents[\"codex\"])\n72\t\tif string(before) != string(after) {\n73\t\t\tt.Fatal(\"projecting/mutating review modified shared task/read configuration\")\n74\t\t}\n75\t}\n76\t\n77\tfunc TestSandboxedReviewOmissionPreservesLegacyAdapter(t *testing.T) {\n78\t\tlegacy, err := parseReviewersPolicy([]byte(legacyReviewersFixture))\n79\t\tif err != nil {\n80\t\t\tt.Fatal(err)\n81\t\t}\n82\t\tp, err := ParseDelegationPolicy(sandboxedReviewFixture(t, \"\"))\n83\t\tif err != nil {\n84\t\t\tt.Fatal(err)\n85\t\t}\n86\t\tfor name, want := range legacy.Adapters {\n87\t\t\tgot, _ := p.agentAdapter(name, DelegationPurposeReview)\n88\t\t\tif !reflect.DeepEqual(got, want) {\n89\t\t\t\tt.Fatalf(\"%s adapter changed: %+v != %+v\", name, got, want)\n90\t\t\t}\n91\t\t}\n92\t}\n93\t\n94\tfunc TestSandboxedReviewRefusesIncompleteOrUnsafeCommands(t *testing.T) {\n95\t\tfor _, profile := range []string{\n96\t\t\t`{}`, `{\"command\":[]}`, `{\"command\":[\"sandbox\"]}`,\n97\t\t\t`{\"command\":[\"sandbox\"],\"resume_command\":[\"sandbox\",\"resume\"]}`,\n98\t\t\t`{\"command\":[\"{output}\"],\"resume_command\":[\"sandbox\",\"{session}\"]}`,\n99\t\t\t`{\"command\":[\"sandbox\",\"--output={output}\"],\"resume_command\":[\"sandbox\",\"{session}\"]}`,\n100\t\t\t`{\"command\":[\"sandbox\",\"{outside_git}\"],\"resume_command\":[\"sandbox\",\"{session}\"]}`,\n101\t\t\t`{\"command\":[\"sandbox\"],\"resume_command\":[\"sh\",\"-c\",\"{session}\"]}`,\n102\t\t} {\n103\t\t\tif _, err := ParseDelegationPolicy(sandboxedReviewFixture(t, profile)); err == nil {\n104\t\t\t\tt.Errorf(\"accepted %s\", profile)\n105\t\t\t}\n106\t\t}\n107\t}\n108\t\n109\tfunc sandboxedClaudeReviewCommands(t *testing.T) [][]string {\n110\t\tt.Helper()\n111\t\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"..\", delegationPolicyPath))\n112\t\tif err != nil {\n113\t\t\tt.Fatal(err)\n114\t\t}\n115\t\tp, err := ParseDelegationPolicy(raw)\n116\t\tif err != nil {\n117\t\t\tt.Fatal(err)\n118\t\t}\n119\t\ta, _ := p.agentAdapter(\"claude-opus-5-5\", DelegationPurposeReview)\n120\t\treturn [][]string{a.Command, a.Resume.Command}\n121\t}\n122\t\n123\tfunc TestSandboxedReviewClaudeEnforcesFreshAndResumedShellBoundaries(t *testing.T) {\n124\t\tfor i, argv := range sandboxedClaudeReviewCommands(t) {\n125\t\t\tjoined := strings.Join(argv, \"\\x00\")\n126\t\t\tfor _, want := range []string{`\"enabled\":true`, `\"failIfUnavailable\":true`, `\"allowUnsandboxedCommands\":false`, `\"denyWrite\":[\".\"]`, \"--safe-mode\", \"--restricted\", \"--strict-mcp-config\", \"Read,Grep,Glob,Bash\", \"GOCACHE\", \"GOTMPDIR\", \"CLAUDE_CODE_TMPDIR\", \"{output}\", \"--append-system-prompt\", \"go clean -cache\", \"inside the mandatory sandbox\"} {\n127\t\t\t\tif !strings.Contains(joined, want) {\n128\t\t\t\t\tt.Errorf(\"command %d lacks %s\", i, want)\n129\t\t\t\t}\n130\t\t\t}\n131\t\t\tif strings.Contains(joined, \"Edit,Write\") || strings.Contains(joined, \"bypassPermissions\") {\n132\t\t\t\tt.Fatalf(\"writing tools/permission bypass in %v\", argv)\n133\t\t\t}\n134\t\t\tif i == 1 && !containsString(argv, \"{session}\") {\n135\t\t\t\tt.Fatal(\"resume lacks session\")\n136\t\t\t}\n137\t\t}\n138\t}\n139\t\n140\tfunc TestSandboxedReviewDependencyFailuresNeverLaunchClaude(t *testing.T) {\n141\t\tsh, err := exec.LookPath(\"sh\")\n142\t\tif err != nil {\n143\t\t\tt.Fatal(err)\n144\t\t}\n145\t\tfor _, argv := range sandboxedClaudeReviewCommands(t) {\n146\t\t\tif len(argv) < 5 || argv[0] != \"sh\" || argv[1] != \"-c\" {\n147\t\t\t\tt.Fatalf(\"no dependency wrapper: %v\", argv)\n148\t\t\t}\n149\t\t\tfor _, missing := range []string{\"bwrap\", \"socat\", \"jq\", \"both\"} {\n150\t\t\t\tdir := t.TempDir()\n151\t\t\t\tfor _, name := range []string{\"uname\", \"bwrap\", \"socat\", \"jq\"} {\n152\t\t\t\t\tif name == missing || missing == \"both\" && name != \"uname\" {\n153\t\t\t\t\t\tcontinue\n154\t\t\t\t\t}\n155\t\t\t\t\tbody := \"#!/bin/sh\\nexit 0\\n\"\n156\t\t\t\t\tif name == \"uname\" {\n157\t\t\t\t\t\tbody = \"#!/bin/sh\\necho Linux\\n\"\n158\t\t\t\t\t}\n159\t\t\t\t\tif err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o700); err != nil {\n160\t\t\t\t\t\tt.Fatal(err)\n161\t\t\t\t\t}\n162\t\t\t\t}\n163\t\t\t\tmarker := filepath.Join(dir, \"launched\")\n164\t\t\t\tcmd := exec.Command(sh, \"-c\", argv[2], \"sh\", filepath.Join(dir, \"output\"), sh, \"-c\", \"echo yes > \\\"$1\\\"\", \"sh\", marker)\n165\t\t\t\tcmd.Env = []string{\"PATH=\" + dir}\n166\t\t\t\tout, err := cmd.CombinedOutput()\n167\t\t\t\tif ee, ok := err.(*exec.ExitError); !ok || ee.ExitCode() != 127 {\n168\t\t\t\t\tt.Fatalf(\"missing %s: %v %s\", missing, err, out)\n169\t\t\t\t}\n170\t\t\t\tfor _, want := range []string{\"bubblewrap\", \"socat\", \"Install\", \"apt\", \"dnf\", \"pacman\"} {\n171\t\t\t\t\tif !strings.Contains(string(out), want) {\n172\t\t\t\t\t\tt.Errorf(\"missing %s diagnostic: %s\", want, out)\n173\t\t\t\t\t}\n174\t\t\t\t}\n175\t\t\t\tif _, err := os.Stat(marker); !os.IsNotExist(err) {\n176\t\t\t\t\tt.Fatal(\"Claude started without dependencies\")\n177\t\t\t\t}\n178\t\t\t}\n179\t\t}\n180\t}\n181\t\n182\tfunc TestSandboxedReviewWrapperKeepsScratchPrivateAndPropagatesStartupFailure(t *testing.T) {\n183\t\tsh, err := exec.LookPath(\"sh\")\n184\t\tif err != nil {\n185\t\t\tt.Skip(\"no sh\")\n186\t\t}\n187\t\tif _, err := exec.LookPath(\"jq\"); err != nil {\n188\t\t\tt.Skip(\"no jq for the qualified Claude profile\")\n189\t\t}\n190\t\tfor _, argv := range sandboxedClaudeReviewCommands(t) {\n191\t\t\tdir := t.TempDir()\n192\t\t\tbin := filepath.Join(dir, \"bin\")\n193\t\t\tif err := os.Mkdir(bin, 0o700); err != nil {\n194\t\t\t\tt.Fatal(err)\n195\t\t\t}\n196\t\t\tfor _, name := range []string{\"uname\", \"bwrap\", \"socat\"} {\n197\t\t\t\tbody := \"#!/bin/sh\\nexit 0\\n\"\n198\t\t\t\tif name == \"uname\" {\n199\t\t\t\t\tbody = \"#!/bin/sh\\necho Linux\\n\"\n200\t\t\t\t}\n201\t\t\t\tif err := os.WriteFile(filepath.Join(bin, name), []byte(body), 0o700); err != nil {\n202\t\t\t\t\tt.Fatal(err)\n203\t\t\t\t}\n204\t\t\t}\n205\t\t\tfake := filepath.Join(bin, \"claude\")\n206\t\t\tbody := `#!/bin/sh\n207\ttest -d \"$GOCACHE\" && test -d \"$GOTMPDIR\" && test \"$TMPDIR\" = \"$GOTMPDIR\" || exit 90\n208\ttest \"$1\" = --settings || exit 91\n209\tprintf '%s' \"$2\" | jq -e --arg scratch \"$CLAUDE_CODE_TMPDIR\" --arg cwd \"$PWD\" '.sandbox.failIfUnavailable == true and .sandbox.allowUnsandboxedCommands == false and .sandbox.filesystem.allowWrite == [$scratch] and .sandbox.filesystem.denyWrite == [$cwd] and .sandbox.filesystem.disabled == false and .sandbox.allowNestedUserNamespaces == false' >/dev/null || exit 92\n210\techo sandbox-initialization-refused >&2\n211\texit 78\n212\t`\n213\t\t\tif err := os.WriteFile(fake, []byte(body), 0o700); err != nil {\n214\t\t\t\tt.Fatal(err)\n215\t\t\t}\n216\t\t\tcmd := exec.Command(sh, \"-c\", argv[2], \"sh\", filepath.Join(dir, \"output\"), argv[5], fake)\n217\t\t\tcmd.Env = append(os.Environ(), \"PATH=\"+bin+string(os.PathListSeparator)+os.Getenv(\"PATH\"))\n218\t\t\tout, err := cmd.CombinedOutput()\n219\t\t\tif ee, ok := err.(*exec.ExitError); !ok || ee.ExitCode() != 78 || !strings.Contains(string(out), \"sandbox-initialization-refused\") {\n220\t\t\t\tt.Fatalf(\"startup failure not propagated: %v %s\", err, out)\n221\t\t\t}\n222\t\t\tinfo, err := os.Stat(filepath.Join(dir, \"claude-review\"))\n223\t\t\tif err != nil || info.Mode().Perm() != 0o700 {\n224\t\t\t\tt.Fatalf(\"scratch not private: %v %v\", info, err)\n225\t\t\t}\n226\t\t}\n227\t}\n228\t\n229\tfunc TestSandboxedReviewCaptureFailureNamesTheSafeStageAndKeepsOutputWithheld(t *testing.T) {\n230\t\tf := provenanceRunFixture(t, \"anthropic\", \"review-model\", func(a *ReviewerAdapter) {\n231\t\t\ta.Command = []string{\"sh\", \"-c\", \"cat >/dev/null; printf 'session: synthetic-a\\\\nsession: synthetic-b\\\\n'\"}\n232\t\t\ta.Session = &ReviewerSession{Pattern: `session: (\\S+)`}\n233\t\t})\n234\t\tif f.run.Status != ReviewRunFailed || f.run.Output != \"\" || f.run.Safety.CaptureComplete {\n235\t\t\tt.Fatalf(\"unsafe capture was not refused: %+v\", f.run)\n236\t\t}\n237\t\tfor _, want := range []string{\"adapter capture failed\", \"session/interrupt recognition\", \"ambiguous adapter capture\"} {\n238\t\t\tif !strings.Contains(f.run.Failure, want) {\n239\t\t\t\tt.Errorf(\"missing safe diagnostic %q: %s\", want, f.run.Failure)\n240\t\t\t}\n241\t\t}\n242\t\tif strings.Contains(f.run.Failure, \"synthetic-a\") || strings.Contains(f.run.Failure, \"synthetic-b\") {\n243\t\t\tt.Fatal(\"raw capture leaked\")\n244\t\t}\n245\t}\n246\t\n247\tfunc TestSandboxedReviewSessionPatternCapturesAnActualInitEvent(t *testing.T) {\n248\t\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"..\", delegationPolicyPath))\n249\t\tif err != nil {\n250\t\t\tt.Fatal(err)\n251\t\t}\n252\t\tp, err := ParseDelegationPolicy(raw)\n253\t\tif err != nil {\n254\t\t\tt.Fatal(err)\n255\t\t}\n256\t\tvalue, err := captureReviewValue(p.Agents[\"claude-opus-5-5\"].Session.Pattern, `{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"synthetic-session\"}`)\n257\t\tif err != nil || value != \"synthetic-session\" {\n258\t\t\tt.Fatalf(\"init capture: %q %v\", value, err)\n259\t\t}\n260\t}\n261\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"8a8dff3d-76b7-46da-be44-86a6a90baac2","timestamp":"2026-11-13T03:09:21.950Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/pose-review-run-2104483385/worktree/pose-mcp/internal/pose/claude_sandboxed_review_test.go","content":"package pose\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// Spec pose-claude-reviewer-runs-tests-in-sandbox.\nfunc sandboxedReviewFixture(t *testing.T, profile string) []byte {\n\tt.Helper()\n\tlegacy, err := parseReviewersPolicy([]byte(legacyReviewersFixture))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tp, err := MigrateReviewersPolicy(legacy)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\traw, err := json.Marshal(p)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar doc map[string]any\n\tif err := json.Unmarshal(raw, &doc); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif profile != \"\" {\n\t\tvar value any\n\t\tif err := json.Unmarshal([]byte(profile), &value); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tdoc[\"agents\"].(map[string]any)[\"codex\"].(map[string]any)[\"review_profile\"] = value\n\t}\n\traw, err = json.Marshal(doc)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn raw\n}\n\nfunc TestSandboxedReviewSelectsOnlyReviewAndKeepsResumeConfiguration(t *testing.T) {\n\tp, err := ParseDelegationPolicy(sandboxedReviewFixture(t, `{\"command\":[\"sandbox\",\"fresh\",\"{output}\"],\"resume_command\":[\"sandbox\",\"resume\",\"{session}\",\"{output}\"]}`))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbefore, _ := json.Marshal(p.Agents[\"codex\"])\n\tfor _, purpose := range []string{DelegationPurposeReview, DelegationPurposeAdjudicate, DelegationPurposeSmoke, DelegationPurposeTask} {\n\t\ta, ok := p.agentAdapter(\"codex\", purpose)\n\t\tif !ok {\n\t\t\tt.Fatal(\"missing agent\")\n\t\t}\n\t\twant := \"codex\"\n\t\tif purpose == DelegationPurposeReview {\n\t\t\twant = \"sandbox\"\n\t\t}\n\t\tif a.Command[0] != want || a.Resume.Command[0] != want {\n\t\t\tt.Fatalf(\"%s: wrong command/resume: %+v\", purpose, a)\n\t\t}\n\t\tif a.Resume.MaxResumes != 2 || a.Session.Pattern == \"\" {\n\t\t\tt.Fatalf(\"continuity lost: %+v\", a)\n\t\t}\n\t}\n\ta, _ := p.agentAdapter(\"codex\", DelegationPurposeReview)\n\ta.Resume.Command[0] = \"changed\"\n\ta.Command[0] = \"changed\"\n\tafter, _ := json.Marshal(p.Agents[\"codex\"])\n\tif string(before) != string(after) {\n\t\tt.Fatal(\"projecting/mutating review modified shared task/read configuration\")\n\t}\n}\n\nfunc TestSandboxedReviewOmissionPreservesLegacyAdapter(t *testing.T) {\n\tlegacy, err := parseReviewersPolicy([]byte(legacyReviewersFixture))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tp, err := ParseDelegationPolicy(sandboxedReviewFixture(t, \"\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor name, want := range legacy.Adapters {\n\t\tgot, _ := p.agentAdapter(name, DelegationPurposeReview)\n\t\tif !reflect.DeepEqual(got, want) {\n\t\t\tt.Fatalf(\"%s adapter changed: %+v != %+v\", name, got, want)\n\t\t}\n\t}\n}\n\nfunc TestSandboxedReviewRefusesIncompleteOrUnsafeCommands(t *testing.T) {\n\tfor _, profile := range []string{\n\t\t`{}`, `{\"command\":[]}`, `{\"command\":[\"sandbox\"]}`,\n\t\t`{\"command\":[\"sandbox\"],\"resume_command\":[\"sandbox\",\"resume\"]}`,\n\t\t`{\"command\":[\"{output}\"],\"resume_command\":[\"sandbox\",\"{session}\"]}`,\n\t\t`{\"command\":[\"sandbox\",\"--output={output}\"],\"resume_command\":[\"sandbox\",\"{session}\"]}`,\n\t\t`{\"command\":[\"sandbox\",\"{outside_git}\"],\"resume_command\":[\"sandbox\",\"{session}\"]}`,\n\t\t`{\"command\":[\"sandbox\"],\"resume_command\":[\"sh\",\"-c\",\"{session}\"]}`,\n\t} {\n\t\tif _, err := ParseDelegationPolicy(sandboxedReviewFixture(t, profile)); err == nil {\n\t\t\tt.Errorf(\"accepted %s\", profile)\n\t\t}\n\t}\n}\n\nfunc sandboxedClaudeReviewCommands(t *testing.T) [][]string {\n\tt.Helper()\n\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"..\", delegationPolicyPath))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tp, err := ParseDelegationPolicy(raw)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\ta, _ := p.agentAdapter(\"claude-opus-5-5\", DelegationPurposeReview)\n\treturn [][]string{a.Command, a.Resume.Command}\n}\n\nfunc TestSandboxedReviewClaudeEnforcesFreshAndResumedShellBoundaries(t *testing.T) {\n\tfor i, argv := range sandboxedClaudeReviewCommands(t) {\n\t\tjoined := strings.Join(argv, \"\\x00\")\n\t\tfor _, want := range []string{`\"enabled\":true`, `\"failIfUnavailable\":true`, `\"allowUnsandboxedCommands\":false`, `\"denyWrite\":[\".\"]`, \"--safe-mode\", \"--restricted\", \"--strict-mcp-config\", \"Read,Grep,Glob,Bash\", \"GOCACHE\", \"GOTMPDIR\", \"CLAUDE_CODE_TMPDIR\", \"{output}\", \"--append-system-prompt\", \"go clean -cache\", \"inside the mandatory sandbox\"} {\n\t\t\tif !strings.Contains(joined, want) {\n\t\t\t\tt.Errorf(\"command %d lacks %s\", i, want)\n\t\t\t}\n\t\t}\n\t\tif strings.Contains(joined, \"Edit,Write\") || strings.Contains(joined, \"bypassPermissions\") {\n\t\t\tt.Fatalf(\"writing tools/permission bypass in %v\", argv)\n\t\t}\n\t\tif i == 1 && !containsString(argv, \"{session}\") {\n\t\t\tt.Fatal(\"resume lacks session\")\n\t\t}\n\t}\n}\n\nfunc TestSandboxedReviewDependencyFailuresNeverLaunchClaude(t *testing.T) {\n\tsh, err := exec.LookPath(\"sh\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, argv := range sandboxedClaudeReviewCommands(t) {\n\t\tif len(argv) < 5 || argv[0] != \"sh\" || argv[1] != \"-c\" {\n\t\t\tt.Fatalf(\"no dependency wrapper: %v\", argv)\n\t\t}\n\t\tfor _, missing := range []string{\"bwrap\", \"socat\", \"jq\", \"both\"} {\n\t\t\tdir := t.TempDir()\n\t\t\tfor _, name := range []string{\"uname\", \"bwrap\", \"socat\", \"jq\"} {\n\t\t\t\tif name == missing || missing == \"both\" && name != \"uname\" {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tbody := \"#!/bin/sh\\nexit 0\\n\"\n\t\t\t\tif name == \"uname\" {\n\t\t\t\t\tbody = \"#!/bin/sh\\necho Linux\\n\"\n\t\t\t\t}\n\t\t\t\tif err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o700); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tmarker := filepath.Join(dir, \"launched\")\n\t\t\tcmd := exec.Command(sh, \"-c\", argv[2], \"sh\", filepath.Join(dir, \"output\"), sh, \"-c\", \"echo yes > \\\"$1\\\"\", \"sh\", marker)\n\t\t\tcmd.Env = []string{\"PATH=\" + dir}\n\t\t\tout, err := cmd.CombinedOutput()\n\t\t\tif ee, ok := err.(*exec.ExitError); !ok || ee.ExitCode() != 127 {\n\t\t\t\tt.Fatalf(\"missing %s: %v %s\", missing, err, out)\n\t\t\t}\n\t\t\tfor _, want := range []string{\"bubblewrap\", \"socat\", \"Install\", \"apt\", \"dnf\", \"pacman\"} {\n\t\t\t\tif !strings.Contains(string(out), want) {\n\t\t\t\t\tt.Errorf(\"missing %s diagnostic: %s\", want, out)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif _, err := os.Stat(marker); !os.IsNotExist(err) {\n\t\t\t\tt.Fatal(\"Claude started without dependencies\")\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc TestSandboxedReviewWrapperKeepsScratchPrivateAndPropagatesStartupFailure(t *testing.T) {\n\tsh, err := exec.LookPath(\"sh\")\n\tif err != nil {\n\t\tt.Skip(\"no sh\")\n\t}\n\tif _, err := exec.LookPath(\"jq\"); err != nil {\n\t\tt.Skip(\"no jq for the qualified Claude profile\")\n\t}\n\tfor _, argv := range sandboxedClaudeReviewCommands(t) {\n\t\tdir := t.TempDir()\n\t\tbin := filepath.Join(dir, \"bin\")\n\t\tif err := os.Mkdir(bin, 0o700); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tfor _, name := range []string{\"uname\", \"bwrap\", \"socat\"} {\n\t\t\tbody := \"#!/bin/sh\\nexit 0\\n\"\n\t\t\tif name == \"uname\" {\n\t\t\t\tbody = \"#!/bin/sh\\necho Linux\\n\"\n\t\t\t}\n\t\t\tif err := os.WriteFile(filepath.Join(bin, name), []byte(body), 0o700); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t}\n\t\tfake := filepath.Join(bin, \"claude\")\n\t\tbody := `#!/bin/sh\ntest -d \"$GOCACHE\" && test -d \"$GOTMPDIR\" && test \"$TMPDIR\" = \"$GOTMPDIR\" || exit 90\ntest \"$1\" = --settings || exit 91\nprintf '%s' \"$2\" | jq -e --arg scratch \"$CLAUDE_CODE_TMPDIR\" --arg cwd \"$PWD\" '.sandbox.failIfUnavailable == true and .sandbox.allowUnsandboxedCommands == false and .sandbox.filesystem.allowWrite == [$scratch] and .sandbox.filesystem.denyWrite == [$cwd] and .sandbox.filesystem.disabled == false and .sandbox.allowNestedUserNamespaces == false' >/dev/null || exit 92\necho sandbox-initialization-refused >&2\nexit 78\n`\n\t\tif err := os.WriteFile(fake, []byte(body), 0o700); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tcmd := exec.Command(sh, \"-c\", argv[2], \"sh\", filepath.Join(dir, \"output\"), argv[5], fake)\n\t\tcmd.Env = append(os.Environ(), \"PATH=\"+bin+string(os.PathListSeparator)+os.Getenv(\"PATH\"))\n\t\tout, err := cmd.CombinedOutput()\n\t\tif ee, ok := err.(*exec.ExitError); !ok || ee.ExitCode() != 78 || !strings.Contains(string(out), \"sandbox-initialization-refused\") {\n\t\t\tt.Fatalf(\"startup failure not propagated: %v %s\", err, out)\n\t\t}\n\t\tinfo, err := os.Stat(filepath.Join(dir, \"claude-review\"))\n\t\tif err != nil || info.Mode().Perm() != 0o700 {\n\t\t\tt.Fatalf(\"scratch not private: %v %v\", info, err)\n\t\t}\n\t}\n}\n\nfunc TestSandboxedReviewCaptureFailureNamesTheSafeStageAndKeepsOutputWithheld(t *testing.T) {\n\tf := provenanceRunFixture(t, \"anthropic\", \"review-model\", func(a *ReviewerAdapter) {\n\t\ta.Command = []string{\"sh\", \"-c\", \"cat >/dev/null; printf 'session: synthetic-a\\\\nsession: synthetic-b\\\\n'\"}\n\t\ta.Session = &ReviewerSession{Pattern: `session: (\\S+)`}\n\t})\n\tif f.run.Status != ReviewRunFailed || f.run.Output != \"\" || f.run.Safety.CaptureComplete {\n\t\tt.Fatalf(\"unsafe capture was not refused: %+v\", f.run)\n\t}\n\tfor _, want := range []string{\"adapter capture failed\", \"session/interrupt recognition\", \"ambiguous adapter capture\"} {\n\t\tif !strings.Contains(f.run.Failure, want) {\n\t\t\tt.Errorf(\"missing safe diagnostic %q: %s\", want, f.run.Failure)\n\t\t}\n\t}\n\tif strings.Contains(f.run.Failure, \"synthetic-a\") || strings.Contains(f.run.Failure, \"synthetic-b\") {\n\t\tt.Fatal(\"raw capture leaked\")\n\t}\n}\n\nfunc TestSandboxedReviewSessionPatternCapturesAnActualInitEvent(t *testing.T) {\n\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"..\", delegationPolicyPath))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tp, err := ParseDelegationPolicy(raw)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvalue, err := captureReviewValue(p.Agents[\"claude-opus-5-5\"].Session.Pattern, `{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"synthetic-session\"}`)\n\tif err != nil || value != \"synthetic-session\" {\n\t\tt.Fatalf(\"init capture: %q %v\", value, err)\n\t}\n}\n","numLines":261,"startLine":1,"totalLines":261}},"tool_result_meta":[{"id":"toolu_01NnE22kytus4opKK9mHgn5b","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
