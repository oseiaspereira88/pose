{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Hc98zXenrDikL8Tock2orX","type":"tool_result","content":"1125\t}\n1126\t\n1127\t// The adapter has no authenticated producer/output declaration. Until such a\n1128\t// declaration exists, a directory name cannot authorize regenerated evidence.\n1129\tfunc verifyDispatchWorktree(root, commit string) error {\n1130\t\treturn verifyDispatchWorktreeFor(root, commit, nil)\n1131\t}\n1132\tfunc verifyDispatchWorktreeFor(root, commit string, submodules map[string]bool) error {\n1133\t\thead, err := snapshotGit(root, \"rev-parse\", \"--verify\", \"HEAD\")\n1134\t\tif err != nil {\n1135\t\t\treturn err\n1136\t\t}\n1137\t\tif strings.TrimSpace(string(head)) != commit {\n1138\t\t\treturn fmt.Errorf(\"the run moved the worktree off the sealed commit\")\n1139\t\t}\n1140\t\tpaths, err := WorktreeDivergenceFor(root, commit, nil, func(p string) bool { return submodules == nil || submodules[p] })\n1141\t\tif err != nil {\n1142\t\t\treturn err\n1143\t\t}\n1144\t\n1145\t\tif len(paths) > 0 {\n1146\t\t\treturn fmt.Errorf(\"the run changed files in the sealed worktree: %q\", paths)\n1147\t\t}\n1148\t\treturn nil\n1149\t}\n1150\t\n1151\tfunc (s Store) checkDispatchOrigin(plan DispatchPlan) error {\n1152\t\torigin, err := dispatchWorktreeIdentity(s.Root)\n1153\t\tif err != nil {\n1154\t\t\treturn err\n1155\t\t}\n1156\t\tif plan.OriginWorktree == \"\" || origin != plan.OriginWorktree {\n1157\t\t\treturn fmt.Errorf(\"dispatch origin conflict: worktree identity changed\")\n1158\t\t}\n1159\t\tif _, err := dispatchRegularInputPath(s.Root, s.activeDelegationPolicyPath()); err != nil {\n1160\t\t\treturn err\n1161\t\t}\n1162\t\tpolicy, found, err := s.LoadReviewersPolicyFor(plan.Brief.Kind)\n1163\t\tif err != nil {\n1164\t\t\treturn fmt.Errorf(\"dispatch adapter policy unavailable: %w\", err)\n1165\t\t}\n1166\t\tif !found || !reflect.DeepEqual(policy.Adapters[plan.Adapter], plan.Config) {\n1167\t\t\treturn fmt.Errorf(\"dispat