0-pose-claude-reviewer-runs-tests-in-sandbox.md\n2026-11-10-pose-setup-offers-runtime-and-sandbox-dependencies.md\n.pose/starts/pose-claude-reviewer-runs-tests-in-sandbox.json\n.pose/specs/2026-11-10-pose-claude-reviewer-runs-tests-in-sandbox.md\n.pose/changelogs/unreleased/pose-claude-reviewer-runs-tests-in-sandbox.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0121RdL7JLRSnDWypp3vXnth","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
