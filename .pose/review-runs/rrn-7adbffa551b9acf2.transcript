{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bp9mDm1twQho9EjAegdhWb","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\t\"testing\"\n8\t)\n9\t\n10\t// Spec pose-review-resume-keeps-the-sealed-checkout R3: the attempt's\n11\t// directory is created exclusively; an existing path, a link included, fails\n12\t// the run instead of being shared or followed.\n13\tfunc TestTheAttemptRuntimeDirectoryIsCreatedExclusively(t *testing.T) {\n14\t\tt.Setenv(\"TMPDIR\", t.TempDir())\n15\t\tid := \"rat-\" + strings.Repeat(\"ab\", 32)\n16\t\tdir, err := reviewRunRuntimeDir(id)\n17\t\tif err != nil {\n18\t\t\tt.Fatal(err)\n19\t\t}\n20\t\tif _, err := reviewRunRuntimeDir(id); err == nil || !strings.Contains(err.Error(), \"already exists\") {\n21\t\t\tt.Fatalf(\"an existing runtime directory was shared: %v\", err)\n22\t\t}\n23\t\tif err := os.Remove(dir); err != nil {\n24\t\t\tt.Fatal(err)\n25\t\t}\n26\t\ttarget := t.TempDir()\n27\t\tif err := os.Symlink(target, dir); err != nil {\n28\t\t\tt.Fatal(err)\n29\t\t}\n30\t\tif _, err := reviewRunRuntimeDir(id); err == nil {\n31\t\t\tt.Fatal(\"a link at the runtime directory was followed\")\n32\t\t}\n33\t\tif again, err := reviewRunRuntimeDir(\"\"); err != nil || filepath.Dir(again) != os.TempDir() {\n34\t\t\tt.Fatalf(\"a run without an attempt: %s %v\", again, err)\n35\t\t}\n36\t}\n37\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"67208241-57c9-486d-b57f-c7d5fbc186b3","timestamp":"2026-11-26T07:20:13.049Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-93b9b9511d1567d3fc5c2c9979b76703/worktree/pose-mcp/internal/pose/review_run_runtime_dir_test.go","content":"package pose\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// Spec pose-review-resume-keeps-the-sealed-checkout R3: the attempt's\n// directory is created exclusively; an existing path, a link included, fails\n// the run instead of being shared or followed.\nfunc TestTheAttemptRuntimeDirectoryIsCreatedExclusively(t *testing.T) {\n\tt.Setenv(\"TMPDIR\", t.TempDir())\n\tid := \"rat-\" + strings.Repeat(\"ab\", 32)\n\tdir, err := reviewRunRuntimeDir(id)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := reviewRunRuntimeDir(id); err == nil || !strings.Contains(err.Error(), \"already exists\") {\n\t\tt.Fatalf(\"an existing runtime directory was shared: %v\", err)\n\t}\n\tif err := os.Remove(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\ttarget := t.TempDir()\n\tif err := os.Symlink(target, dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := reviewRunRuntimeDir(id); err == nil {\n\t\tt.Fatal(\"a link at the runtime directory was followed\")\n\t}\n\tif again, err := reviewRunRuntimeDir(\"\"); err != nil || filepath.Dir(again) != os.TempDir() {\n\t\tt.Fatalf(\"a run without an attempt: %s %v\", again, err)\n\t}\n}\n","numLines":37,"startLine":1,"totalLines":37}},"tool_result_meta":[{"id":"toolu_01Bp9mDm1twQho9EjAegdhWb","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
