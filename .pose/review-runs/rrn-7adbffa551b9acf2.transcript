{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015v2Z6mGHEXf7ea8ZxWNDb1","type":"tool_result","content":"150\t\tif len(matches) != 1 || len(matches[0]) != 2 {\n151\t\t\treturn \"\", fmt.Errorf(\"ambiguous adapter capture\")\n152\t\t}\n153\t\tvalue := matches[0][1]\n154\t\tif len(value) == 0 || len(value) > 2048 || strings.ContainsAny(value, \"\\x00\\r\\n\") {\n155\t\t\treturn \"\", fmt.Errorf(\"adapter capture is not a bounded reference\")\n156\t\t}\n157\t\treturn value, nil\n158\t}\n159\tfunc (s Store) saveReviewSession(value string) (string, error) {\n160\t\tdigest := digestBytes([]byte(value))\n161\t\tdir, e := ensureReviewArtifactDir(s.Root, reviewPrivateDir, true)\n162\t\tif e != nil {\n163\t\t\treturn \"\", e\n164\t\t}\n165\t\tif e = os.Chmod(dir, 0700); e != nil {\n166\t\t\treturn \"\", e\n167\t\t}\n168\t\t// Private session files are runtime state, never published evidence.\n169\t\tignore := filepath.Join(dir, \".gitignore\")\n170\t\tif e = PublishFile(ignore, []byte(\"*\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); e != nil {\n171\t\t\treturn \"\", e\n172\t\t}\n173\t\te = PublishFile(filepath.Join(dir, strings.TrimPrefix(digest, \"sha256:\")+\".session\"), []byte(value), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n174\t\treturn digest, e\n175\t}\n176\tfunc (s Store) readReviewSession(digest string) (string, error) {\n177\t\tif len(digest) != 71 || !strings.HasPrefix(digest, \"sha256:\") || strings.ContainsAny(digest, \"/\\\\\") {\n178\t\t\treturn \"\", fmt.Errorf(\"invalid session digest\")\n179\t\t}\n180\t\tdir, e := ensureReviewArtifactDir(s.Root, reviewPrivateDir, false)\n181\t\tif e != nil {\n182\t\t\treturn \"\", e\n183\t\t}\n184\t\traw, e := readLedgerRaw(filepath.Join(dir, strings.TrimPrefix(digest, \"sha256:\")+\".session\"))\n185\t\tif e != nil {\n186\t\t\treturn \"\", e\n187\t\t}\n188\t\tif digestBytes(raw) != digest || len(raw) == 0 || len(raw) > 2048 {\n189\t\t\treturn \"\", fmt.Errorf(\"private session digest differs\")\n190\t\t}\n191\t\treturn string(raw), nil\n192\t}\n193\tfunc (s Store) classifyReviewInterruption(run *ReviewRun, plan DispatchPlan, transcript []byte, runErr, ctxErr error) (string, string, error) {\n194\t\t// Inspect both supported output channels before any public publication.\n195\t\tchannels := append([]string{string(transcript), run.Output}, plan.extraChannels...)\n196\t\tsessionChannels := make([]string, 0, len(channels))\n197\t\tfor _, channel := range channels {\n198\t\t\tcanonical, err := canonicalDelegationSessionChannel(plan.Config.Events, sessionPattern(plan.Config), channel)\n199\t\t\tif err != nil {\n200\t\t\t\treturn \"\", \"\", err\n201\t\t\t}\n202\t\t\tsessionChannels = append(sessionChannels, canonical)\n203\t\t}\n204\t\tvalue, e := captureReviewChannels(sessionPattern(plan.Config), sessionChannels...)\n205\t\tif e != nil {\n206\t\t\treturn \"\", \"\", e\n207\t\t}\n208\t\tif value != \"\" && plan.session != \"\" && value != plan.session {\n209\t\t\treturn \"\", \"\", fmt.Errorf(\"adapter changed the captured session\")\n210\t\t}\n211\t\tif value == \"\" {\n212\t\t\tvalue = plan.session\n213\t\t}\n214\t\tif value != \"\" {\n215\t\t\trun.sessionForRedaction = value\n216\t\t\trun.SessionDigest, e = s.saveReviewSession(value)\n217\t\t\tif e != nil {\n218\t\t\t\treturn \"\", \"\", e\n219\t\t\t}\n220\t\t}\n221\t\tcause := \"\"\n222\t\tif ctxErr != nil {\n223\t\t\tcause = \"timeout\"\n224\t\t\tif errors.Is(ctxErr, context.Canceled) {\n225\t\t\t\tcause = \"cancelled\"\n226\t\t\t}\n227\t\t} else if runErr != nil && run.ExitCode < 0 {\n228\t\t\tcause = \"process-lost\"\n229\t\t}\n230\t\tlimit := false\n231\t\tif p := plan.Config.Limit; p != nil {\n232\t\t\tfor _, code := range p.ExitCodes {\n233\t\t\t\tif code == run.ExitCode {\n234\t\t\t\t\tlimit = true\n235\t\t\t\t}\n236\t\t\t}\n237\t\t\tfor _, pattern := range p.OutputPatterns {\n238\t\t\t\tfor _, channel := range channels {\n239\t\t\t\t\tif regexp.MustCompile(pattern).MatchString(channel) {\n240\t\t\t\t\t\tlimit = true\n241\t\t\t\t\t}\n242\t\t\t\t}\n243\t\t\t}\n244\t\t}\n245\t\tif limit {\n246\t\t\tcause = \"usage-limit\"\n247\t\t}\n248\t\tsupervisorCause := cause\n249\t\tif cause == \"\" {\n250\t\t\tif runErr != nil {\n251\t\t\t\treturn ReviewRunFailed, \"the reviewer command failed: \" + runErr.Error(), nil\n252\t\t\t}\n253\t\t\treturn \"\", \"\", nil\n254\t\t}\n255\t\t// Without any continuity declaration, interruption classification is unknown.\n256\t\tif plan.Config.Limit == nil && plan.Config.Session == nil && plan.Config.Resume == nil {\n257\t\t\tcause = \"unknown\"\n258\t\t}\n259\t\tinterruption := &ReviewInterruption{Cause: cause, Resumable: run.SessionDigest != \"\" && plan.Config.Resume != nil && len(plan.Config.Resume.Command) > 0}\n260\t\tif cause == \"usage-limit\" {\n261\t\t\treset, e := captureReviewChannels(resetPattern(plan.Config), channels...)\n262\t\t\tif e != nil {\n263\t\t\t\treturn \"\", \"\", e\n264\t\t\t}\n265\t\t\tif reset != \"\" {\n266\t\t\t\tt, e := time.Parse(time.RFC3339Nano, reset)\n267\t\t\t\tif e != nil {\n268\t\t\t\t\treturn \"\", \"\", fmt.Errorf(\"adapter reset instant is not RFC3339\")\n269\t\t\t\t}\n270\t\t\t\tinterruption.ResetAt = t.UTC().Format(time.RFC3339Nano)\n271\t\t\t}\n272\t\t}\n273\t\trun.Interruption = interruption\n274\t\treturn ReviewRunInterrupted, \"review interrupted: \" + cause + \" (supervisor: \" + supervisorCause + \")\", nil\n275\t}\n276\tfunc validateContinuityRun(r ReviewRun) error {\n277\t\tif r.Status == ReviewRunInterrupted {\n278\t\t\tif r.Interruption == nil {\n279\t\t\t\treturn fmt.Errorf(\"interrupted run has no cause\")\n280\t\t\t}\n281\t\t\tswitch r.Interruption.Cause {\n282\t\t\tcase \"usage-limit\", \"timeout\", \"process-lost\", \"cancelled\", \"unknown\":\n283\t\t\tdefault:\n284\t\t\t\treturn fmt.Errorf(\"invalid interruption cause\")\n285\t\t\t}\n286\t\t\tif r.Interruption.ResetAt != \"\" {\n287\t\t\t\tif _, e := time.Parse(time.RFC3339Nano, r.Interruption.ResetAt); e != nil {\n288\t\t\t\t\treturn e\n289\t\t\t\t}\n290\t\t\t}\n291\t\t\tif r.Interruption.Resumable && (r.SessionDigest == \"\" || r.TreeDigest == \"\" || r.AttemptID == \"\") {\n292\t\t\t\treturn fmt.Errorf(\"resumable run lacks bound evidence\")\n293\t\t\t}\n294\t\t\tif r.PartialDigest != digestBytes([]byte(r.Output)) {\n295\t\t\t\treturn fmt.Errorf(\"partial draft digest differs\")\n296\t\t\t}\n297\t\t} else if r.Interruption != nil {\n298\t\t\treturn fmt.Errorf(\"terminal run contains interruption metadata\")\n299\t\t}\n300\t\treturn nil\n301\t}\n302\tfunc continuationPath(run string, result bool) string {\n303\t\tsuffix := \".json\"\n304\t\tif result {\n305\t\t\tsuffix = \".result.json\"\n306\t\t}\n307\t\treturn filepath.ToSlash(filepath.Join(reviewContinuationsDir, run+suffix))\n308\t}\n309\tfunc (s Store) claimReviewContinuation(r ReviewRun, at time.Time) error {\n310\t\traw, _ := json.Marshal(r)\n311\t\t// Clear reader-only fields before deriving the predecessor digest.\n312\t\tr.Path, r.SupersededBy = \"\", \"\"\n313\t\traw, _ = json.Marshal(r)\n314\t\tnonce := make([]byte, 16)\n315\t\tif _, err := rand.Read(nonce); err != nil {\n316\t\t\treturn err\n317\t\t}\n318\t\treturn publishLedgerJSON(s.Root, continuationPath(r.RunID, false), reviewContinuation{1, r.RunID, r.AttemptID, digestBytes(raw), at.UTC().Format(time.RFC3339Nano), hex.EncodeToString(nonce)})\n319\t}\n320\tfunc (s Store) finishReviewContinuation(r ReviewRun) error {\n321\t\traw, _ := json.Marshal(r)\n322\t\treceipt := reviewAttemptReceipt{1, r.AttemptID, r.RunID, digestBytes(raw)}\n323\t\treturn publishLedgerJSON(s.Root, continuationPath(r.continues(), true), receipt)\n324\t}\n325\tfunc (s Store) existingReviewContinuation(r ReviewRun, runs []ReviewRun) (*ReviewRun, error) {\n326\t\tvar claim reviewContinuation\n327\t\te := readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, false)), &claim)\n328\t\tif errors.Is(e, os.ErrNotExist) {\n329\t\t\treturn nil, nil\n330\t\t}\n331\t\tif e != nil {\n332\t\t\treturn nil, e\n333\t\t}\n334\t\tcopy := r\n335\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n336\t\traw, _ := json.Marshal(copy)\n337\t\tif claim.SchemaVersion != 1 || claim.Predecessor != r.RunID || claim.AttemptID != r.AttemptID || claim.PredecessorDigest != digestBytes(raw) {\n338\t\t\treturn nil, fmt.Errorf(\"continuation predecessor changed\")\n339\t\t}\n340\t\tvar receipt reviewAttemptReceipt\n341\t\tif e = readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, true)), &receipt); e != nil {\n342\t\t\treturn nil, &PendingReviewContinuation{ID: \"resume-of:\" + r.RunID, Predecessor: r.RunID, AttemptID: r.AttemptID}\n343\t\t}\n344\t\tfor _, next := range runs {\n345\t\t\tif next.RunID == receipt.RunID {\n346\t\t\t\tcopy := next\n347\t\t\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n348\t\t\t\traw, _ := json.Marshal(copy)\n349\t\t\t\tif receipt.SchemaVersion != 1 || receipt.AttemptID != r.AttemptID || next.AttemptID != r.AttemptID || next.continues() != r.RunID || receipt.RunDigest != digestBytes(raw) {\n350\t\t\t\t\treturn nil, fmt.Errorf(\"invalid continuation receipt\")\n351\t\t\t\t}\n352\t\t\t\treturn &next, nil\n353\t\t\t}\n354\t\t}\n355\t\treturn nil, fmt.Errorf(\"continuation result is missing\")\n356\t}\n357\t\n358\t// PlanReviewResume validates original evidence, policy and all accumulated budgets.\n359\tfunc (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n360\t\truns, lost, e := s.ReadReviewRuns(\"\")\n361\t\tif e != nil {\n362\t\t\treturn DispatchPlan{}, e\n363\t\t}\n364\t\tif len(lost) > 0 {\n365\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume history incomplete: %v\", lost)\n366\t\t}\n367\t\tvar prior *ReviewRun\n368\t\tfor i := range runs {\n369\t\t\tif runs[i].RunID == id {\n370\t\t\t\tprior = &runs[i]\n371\t\t\t}\n372\t\t}\n373\t\tif prior == nil {\n374\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume predecessor not found\")\n375\t\t}\n376\t\tif prior.Status != ReviewRunInterrupted || prior.Interruption == nil || !prior.Interruption.Resumable {\n377\t\t\treturn DispatchPlan{}, fmt.Errorf(\"run is %s or not resumable\", prior.Status)\n378\t\t}\n379\t\tif why := s.reviewRunTranscriptIntact(*prior); why != \"\" {\n380\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume: %s\", why)\n381\t\t}\n382\t\tpolicy, _, e := s.LoadReviewersPolicyFor(prior.Kind)\n383\t\tif e != nil {\n384\t\t\treturn DispatchPlan{}, e\n385\t\t}\n386\t\tconfig, ok := policy.Adapters[prior.Adapter]\n387\t\tif !ok || config.Resume == nil || len(config.Resume.Command) == 0 {\n388\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume adapter declaration missing\")\n389\t\t}\n390\t\tbrief, e := s.RenderReviewBriefMatching(prior.BundleID, prior.Kind, prior.BriefNotes, prior.BriefDigest)\n391\t\tif e != nil {\n392\t\t\treturn DispatchPlan{}, e\n393\t\t}\n394\t\tbundle, e := s.LoadReviewBundle(prior.BundleID)\n395\t\tif e != nil {\n396\t\t\treturn DispatchPlan{}, e\n397\t\t}\n398\t\tif brief.Digest != prior.BriefDigest || bundle.BundleDigest != prior.BundleDigest || bundle.Payload.Subject.Head != prior.SealedCommit {\n399\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume bundle or brief digest changed\")\n400\t\t}\n401\t\torigin, e := dispatchWorktreeIdentity(s.Root)\n402\t\tif e != nil {\n403\t\t\treturn DispatchPlan{}, e\n404\t\t}\n405\t\tif prior.Safety != nil && prior.Safety.Operation.Outcome != OutcomeCompleted {\n406\t\t\treturn DispatchPlan{}, fmt.Errorf(\"predecessor cleanup incomplete; refusing continuation beside possible orphan\")\n407\t\t}\n408\t\tplan := DispatchPlan{predecessor: prior, notes: prior.BriefNotes, Reason: prior.Reason, PolicyDigest: prior.PolicyDigest, OriginWorktree: origin, Adapter: prior.Adapter, Config: config, Brief: brief, Bundle: bundle, SealedCommit: prior.SealedCommit}\n409\t\tcontinuationRound(&plan, *prior, false)\n410\t\tif e = s.checkDispatchOrigin(plan); e != nil {\n411\t\t\treturn DispatchPlan{}, e\n412\t\t}\n413\t\texisting, e := s.existingReviewContinuation(*prior, runs)\n414\t\tif e != nil {\n415\t\t\tvar pending *PendingReviewContinuation\n416\t\t\tif errors.As(e, &pending) {\n417\t\t\t\tplan.PendingContinuation = pending\n418\t\t\t\treturn plan, nil\n419\t\t\t}\n420\t\t\treturn DispatchPlan{}, e\n421\t\t}\n422\t\tif existing != nil {\n423\t\t\tif existing.HandsOffFrom == prior.RunID {\n424\t\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was handed off to run %s; it is not resumed\", prior.RunID, existing.RunID)\n425\t\t\t}\n426\t\t\tplan.Existing = existing\n427\t\t\treturn plan, nil\n428\t\t}\n429\t\t// The attempt's budget, not this agent's: after a handoff the resumed\n430\t\t// agent may declare another (spec pose-delegation-handoff R2).\n431\t\tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\n432\t\tif e != nil {\n433\t\t\treturn DispatchPlan{}, e\n434\t\t}\n435\t\tif count >= limit || spent >= total {\n436\t\t\treturn DispatchPlan{}, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"resume budget exhausted: %d resumes, %s wall-clock\", count, spent))\n437\t\t}\n438\t\ttimeout := 60 * time.Minute\n439\t\tif config.Timeout != \"\" {\n440\t\t\ttimeout, _ = time.ParseDuration(config.Timeout)\n441\t\t}\n442\t\tif total-spent < timeout {\n443\t\t\ttimeout = total - spent\n444\t\t}\n445\t\tplan.processTimeout = timeout\n446\t\t// A continuation runs the same agent the attempt was routed to.\n447\t\tplan.Routing = prior.Routing\n448\t\ts.planImplementation(&plan, prior.Lead)\n449\t\tplan.provenance, e = s.prepareRunProvenance(plan, policy)\n450\t\tif e != nil {\n451\t\t\treturn DispatchPlan{}, e\n452\t\t}\n453\t\tplan.session, e = s.readReviewSession(prior.SessionDigest)\n454\t\tif e != nil {\n455\t\t\treturn DispatchPlan{}, e\n456\t\t}\n457\t\treturn plan, nil\n458\t}\n459\t\n460\t// ReviewResumeDelay computes a bounded, non-polling wait; callers revalidate afterwards.\n461\tfunc ReviewResumeDelay(r ReviewRun, now time.Time, max time.Duration, jitter time.Duration) (time.Duration, error) {\n462\t\tif r.Interruption == nil || r.Interruption.ResetAt == \"\" {\n463\t\t\treturn 0, fmt.Errorf(\"no recorded reset instant\")\n464\t\t}\n465\t\tif max <= 0 || max > 24*time.Hour || jitter < 0 || jitter > time.Second {\n466\t\t\treturn 0, fmt.Errorf(\"wait bound must be positive and at most 24h; jitter at most 1s\")\n467\t\t}\n468\t\treset, e := time.Parse(time.RFC3339Nano, r.Interruption.ResetAt)\n469\t\tif e != nil {\n470\t\t\treturn 0, e\n471\t\t}\n472\t\tdelay := reset.Sub(now)\n473\t\tif delay < 0 {\n474\t\t\tdelay = 0\n475\t\t}\n476\t\tdelay += jitter\n477\t\tif delay > max {\n478\t\t\treturn 0, fmt.Errorf(\"recorded reset exceeds maximum wait\")\n479\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"257f6bac-acc8-4fed-b52c-8697677d002e","timestamp":"2026-11-26T07:20:28.574Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-93b9b9511d1567d3fc5c2c9979b76703/worktree/pose-mcp/internal/pose/review_run_continuity.go","content":"\tif len(matches) != 1 || len(matches[0]) != 2 {\n\t\treturn \"\", fmt.Errorf(\"ambiguous adapter capture\")\n\t}\n\tvalue := matches[0][1]\n\tif len(value) == 0 || len(value) > 2048 || strings.ContainsAny(value, \"\\x00\\r\\n\") {\n\t\treturn \"\", fmt.Errorf(\"adapter capture is not a bounded reference\")\n\t}\n\treturn value, nil\n}\nfunc (s Store) saveReviewSession(value string) (string, error) {\n\tdigest := digestBytes([]byte(value))\n\tdir, e := ensureReviewArtifactDir(s.Root, reviewPrivateDir, true)\n\tif e != nil {\n\t\treturn \"\", e\n\t}\n\tif e = os.Chmod(dir, 0700); e != nil {\n\t\treturn \"\", e\n\t}\n\t// Private session files are runtime state, never published evidence.\n\tignore := filepath.Join(dir, \".gitignore\")\n\tif e = PublishFile(ignore, []byte(\"*\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); e != nil {\n\t\treturn \"\", e\n\t}\n\te = PublishFile(filepath.Join(dir, strings.TrimPrefix(digest, \"sha256:\")+\".session\"), []byte(value), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n\treturn digest, e\n}\nfunc (s Store) readReviewSession(digest string) (string, error) {\n\tif len(digest) != 71 || !strings.HasPrefix(digest, \"sha256:\") || strings.ContainsAny(digest, \"/\\\\\") {\n\t\treturn \"\", fmt.Errorf(\"invalid session digest\")\n\t}\n\tdir, e := ensureReviewArtifactDir(s.Root, reviewPrivateDir, false)\n\tif e != nil {\n\t\treturn \"\", e\n\t}\n\traw, e := readLedgerRaw(filepath.Join(dir, strings.TrimPrefix(digest, \"sha256:\")+\".session\"))\n\tif e != nil {\n\t\treturn \"\", e\n\t}\n\tif digestBytes(raw) != digest || len(raw) == 0 || len(raw) > 2048 {\n\t\treturn \"\", fmt.Errorf(\"private session digest differs\")\n\t}\n\treturn string(raw), nil\n}\nfunc (s Store) classifyReviewInterruption(run *ReviewRun, plan DispatchPlan, transcript []byte, runErr, ctxErr error) (string, string, error) {\n\t// Inspect both supported output channels before any public publication.\n\tchannels := append([]string{string(transcript), run.Output}, plan.extraChannels...)\n\tsessionChannels := make([]string, 0, len(channels))\n\tfor _, channel := range channels {\n\t\tcanonical, err := canonicalDelegationSessionChannel(plan.Config.Events, sessionPattern(plan.Config), channel)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", err\n\t\t}\n\t\tsessionChannels = append(sessionChannels, canonical)\n\t}\n\tvalue, e := captureReviewChannels(sessionPattern(plan.Config), sessionChannels...)\n\tif e != nil {\n\t\treturn \"\", \"\", e\n\t}\n\tif value != \"\" && plan.session != \"\" && value != plan.session {\n\t\treturn \"\", \"\", fmt.Errorf(\"adapter changed the captured session\")\n\t}\n\tif value == \"\" {\n\t\tvalue = plan.session\n\t}\n\tif value != \"\" {\n\t\trun.sessionForRedaction = value\n\t\trun.SessionDigest, e = s.saveReviewSession(value)\n\t\tif e != nil {\n\t\t\treturn \"\", \"\", e\n\t\t}\n\t}\n\tcause := \"\"\n\tif ctxErr != nil {\n\t\tcause = \"timeout\"\n\t\tif errors.Is(ctxErr, context.Canceled) {\n\t\t\tcause = \"cancelled\"\n\t\t}\n\t} else if runErr != nil && run.ExitCode < 0 {\n\t\tcause = \"process-lost\"\n\t}\n\tlimit := false\n\tif p := plan.Config.Limit; p != nil {\n\t\tfor _, code := range p.ExitCodes {\n\t\t\tif code == run.ExitCode {\n\t\t\t\tlimit = true\n\t\t\t}\n\t\t}\n\t\tfor _, pattern := range p.OutputPatterns {\n\t\t\tfor _, channel := range channels {\n\t\t\t\tif regexp.MustCompile(pattern).MatchString(channel) {\n\t\t\t\t\tlimit = true\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif limit {\n\t\tcause = \"usage-limit\"\n\t}\n\tsupervisorCause := cause\n\tif cause == \"\" {\n\t\tif runErr != nil {\n\t\t\treturn ReviewRunFailed, \"the reviewer command failed: \" + runErr.Error(), nil\n\t\t}\n\t\treturn \"\", \"\", nil\n\t}\n\t// Without any continuity declaration, interruption classification is unknown.\n\tif plan.Config.Limit == nil && plan.Config.Session == nil && plan.Config.Resume == nil {\n\t\tcause = \"unknown\"\n\t}\n\tinterruption := &ReviewInterruption{Cause: cause, Resumable: run.SessionDigest != \"\" && plan.Config.Resume != nil && len(plan.Config.Resume.Command) > 0}\n\tif cause == \"usage-limit\" {\n\t\treset, e := captureReviewChannels(resetPattern(plan.Config), channels...)\n\t\tif e != nil {\n\t\t\treturn \"\", \"\", e\n\t\t}\n\t\tif reset != \"\" {\n\t\t\tt, e := time.Parse(time.RFC3339Nano, reset)\n\t\t\tif e != nil {\n\t\t\t\treturn \"\", \"\", fmt.Errorf(\"adapter reset instant is not RFC3339\")\n\t\t\t}\n\t\t\tinterruption.ResetAt = t.UTC().Format(time.RFC3339Nano)\n\t\t}\n\t}\n\trun.Interruption = interruption\n\treturn ReviewRunInterrupted, \"review interrupted: \" + cause + \" (supervisor: \" + supervisorCause + \")\", nil\n}\nfunc validateContinuityRun(r ReviewRun) error {\n\tif r.Status == ReviewRunInterrupted {\n\t\tif r.Interruption == nil {\n\t\t\treturn fmt.Errorf(\"interrupted run has no cause\")\n\t\t}\n\t\tswitch r.Interruption.Cause {\n\t\tcase \"usage-limit\", \"timeout\", \"process-lost\", \"cancelled\", \"unknown\":\n\t\tdefault:\n\t\t\treturn fmt.Errorf(\"invalid interruption cause\")\n\t\t}\n\t\tif r.Interruption.ResetAt != \"\" {\n\t\t\tif _, e := time.Parse(time.RFC3339Nano, r.Interruption.ResetAt); e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t}\n\t\tif r.Interruption.Resumable && (r.SessionDigest == \"\" || r.TreeDigest == \"\" || r.AttemptID == \"\") {\n\t\t\treturn fmt.Errorf(\"resumable run lacks bound evidence\")\n\t\t}\n\t\tif r.PartialDigest != digestBytes([]byte(r.Output)) {\n\t\t\treturn fmt.Errorf(\"partial draft digest differs\")\n\t\t}\n\t} else if r.Interruption != nil {\n\t\treturn fmt.Errorf(\"terminal run contains interruption metadata\")\n\t}\n\treturn nil\n}\nfunc continuationPath(run string, result bool) string {\n\tsuffix := \".json\"\n\tif result {\n\t\tsuffix = \".result.json\"\n\t}\n\treturn filepath.ToSlash(filepath.Join(reviewContinuationsDir, run+suffix))\n}\nfunc (s Store) claimReviewContinuation(r ReviewRun, at time.Time) error {\n\traw, _ := json.Marshal(r)\n\t// Clear reader-only fields before deriving the predecessor digest.\n\tr.Path, r.SupersededBy = \"\", \"\"\n\traw, _ = json.Marshal(r)\n\tnonce := make([]byte, 16)\n\tif _, err := rand.Read(nonce); err != nil {\n\t\treturn err\n\t}\n\treturn publishLedgerJSON(s.Root, continuationPath(r.RunID, false), reviewContinuation{1, r.RunID, r.AttemptID, digestBytes(raw), at.UTC().Format(time.RFC3339Nano), hex.EncodeToString(nonce)})\n}\nfunc (s Store) finishReviewContinuation(r ReviewRun) error {\n\traw, _ := json.Marshal(r)\n\treceipt := reviewAttemptReceipt{1, r.AttemptID, r.RunID, digestBytes(raw)}\n\treturn publishLedgerJSON(s.Root, continuationPath(r.continues(), true), receipt)\n}\nfunc (s Store) existingReviewContinuation(r ReviewRun, runs []ReviewRun) (*ReviewRun, error) {\n\tvar claim reviewContinuation\n\te := readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, false)), &claim)\n\tif errors.Is(e, os.ErrNotExist) {\n\t\treturn nil, nil\n\t}\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\tcopy := r\n\tcopy.Path, copy.SupersededBy = \"\", \"\"\n\traw, _ := json.Marshal(copy)\n\tif claim.SchemaVersion != 1 || claim.Predecessor != r.RunID || claim.AttemptID != r.AttemptID || claim.PredecessorDigest != digestBytes(raw) {\n\t\treturn nil, fmt.Errorf(\"continuation predecessor changed\")\n\t}\n\tvar receipt reviewAttemptReceipt\n\tif e = readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, true)), &receipt); e != nil {\n\t\treturn nil, &PendingReviewContinuation{ID: \"resume-of:\" + r.RunID, Predecessor: r.RunID, AttemptID: r.AttemptID}\n\t}\n\tfor _, next := range runs {\n\t\tif next.RunID == receipt.RunID {\n\t\t\tcopy := next\n\t\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n\t\t\traw, _ := json.Marshal(copy)\n\t\t\tif receipt.SchemaVersion != 1 || receipt.AttemptID != r.AttemptID || next.AttemptID != r.AttemptID || next.continues() != r.RunID || receipt.RunDigest != digestBytes(raw) {\n\t\t\t\treturn nil, fmt.Errorf(\"invalid continuation receipt\")\n\t\t\t}\n\t\t\treturn &next, nil\n\t\t}\n\t}\n\treturn nil, fmt.Errorf(\"continuation result is missing\")\n}\n\n// PlanReviewResume validates original evidence, policy and all accumulated budgets.\nfunc (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n\truns, lost, e := s.ReadReviewRuns(\"\")\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif len(lost) > 0 {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"resume history incomplete: %v\", lost)\n\t}\n\tvar prior *ReviewRun\n\tfor i := range runs {\n\t\tif runs[i].RunID == id {\n\t\t\tprior = &runs[i]\n\t\t}\n\t}\n\tif prior == nil {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"resume predecessor not found\")\n\t}\n\tif prior.Status != ReviewRunInterrupted || prior.Interruption == nil || !prior.Interruption.Resumable {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"run is %s or not resumable\", prior.Status)\n\t}\n\tif why := s.reviewRunTranscriptIntact(*prior); why != \"\" {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"resume: %s\", why)\n\t}\n\tpolicy, _, e := s.LoadReviewersPolicyFor(prior.Kind)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tconfig, ok := policy.Adapters[prior.Adapter]\n\tif !ok || config.Resume == nil || len(config.Resume.Command) == 0 {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"resume adapter declaration missing\")\n\t}\n\tbrief, e := s.RenderReviewBriefMatching(prior.BundleID, prior.Kind, prior.BriefNotes, prior.BriefDigest)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tbundle, e := s.LoadReviewBundle(prior.BundleID)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif brief.Digest != prior.BriefDigest || bundle.BundleDigest != prior.BundleDigest || bundle.Payload.Subject.Head != prior.SealedCommit {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"resume bundle or brief digest changed\")\n\t}\n\torigin, e := dispatchWorktreeIdentity(s.Root)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif prior.Safety != nil && prior.Safety.Operation.Outcome != OutcomeCompleted {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"predecessor cleanup incomplete; refusing continuation beside possible orphan\")\n\t}\n\tplan := DispatchPlan{predecessor: prior, notes: prior.BriefNotes, Reason: prior.Reason, PolicyDigest: prior.PolicyDigest, OriginWorktree: origin, Adapter: prior.Adapter, Config: config, Brief: brief, Bundle: bundle, SealedCommit: prior.SealedCommit}\n\tcontinuationRound(&plan, *prior, false)\n\tif e = s.checkDispatchOrigin(plan); e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\texisting, e := s.existingReviewContinuation(*prior, runs)\n\tif e != nil {\n\t\tvar pending *PendingReviewContinuation\n\t\tif errors.As(e, &pending) {\n\t\t\tplan.PendingContinuation = pending\n\t\t\treturn plan, nil\n\t\t}\n\t\treturn DispatchPlan{}, e\n\t}\n\tif existing != nil {\n\t\tif existing.HandsOffFrom == prior.RunID {\n\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was handed off to run %s; it is not resumed\", prior.RunID, existing.RunID)\n\t\t}\n\t\tplan.Existing = existing\n\t\treturn plan, nil\n\t}\n\t// The attempt's budget, not this agent's: after a handoff the resumed\n\t// agent may declare another (spec pose-delegation-handoff R2).\n\tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif count >= limit || spent >= total {\n\t\treturn DispatchPlan{}, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"resume budget exhausted: %d resumes, %s wall-clock\", count, spent))\n\t}\n\ttimeout := 60 * time.Minute\n\tif config.Timeout != \"\" {\n\t\ttimeout, _ = time.ParseDuration(config.Timeout)\n\t}\n\tif total-spent < timeout {\n\t\ttimeout = total - spent\n\t}\n\tplan.processTimeout = timeout\n\t// A continuation runs the same agent the attempt was routed to.\n\tplan.Routing = prior.Routing\n\ts.planImplementation(&plan, prior.Lead)\n\tplan.provenance, e = s.prepareRunProvenance(plan, policy)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tplan.session, e = s.readReviewSession(prior.SessionDigest)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\treturn plan, nil\n}\n\n// ReviewResumeDelay computes a bounded, non-polling wait; callers revalidate afterwards.\nfunc ReviewResumeDelay(r ReviewRun, now time.Time, max time.Duration, jitter time.Duration) (time.Duration, error) {\n\tif r.Interruption == nil || r.Interruption.ResetAt == \"\" {\n\t\treturn 0, fmt.Errorf(\"no recorded reset instant\")\n\t}\n\tif max <= 0 || max > 24*time.Hour || jitter < 0 || jitter > time.Second {\n\t\treturn 0, fmt.Errorf(\"wait bound must be positive and at most 24h; jitter at most 1s\")\n\t}\n\treset, e := time.Parse(time.RFC3339Nano, r.Interruption.ResetAt)\n\tif e != nil {\n\t\treturn 0, e\n\t}\n\tdelay := reset.Sub(now)\n\tif delay < 0 {\n\t\tdelay = 0\n\t}\n\tdelay += jitter\n\tif delay > max {\n\t\treturn 0, fmt.Errorf(\"recorded reset exceeds maximum wait\")\n\t}","numLines":330,"startLine":15