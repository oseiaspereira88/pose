orktree); len(differing) > 0 {\n\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout inputs differ: %v\", differing))\n\t}\n\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n\t\treturn finish(ReviewRunFailed, err.Error())\n\t}\n\tif err := verifyBundleMaterialization(worktree, plan.Bundle); err != nil {\n\t\treturn finish(ReviewRunFailed, err.Error())\n\t}\n\tif plan.Purpose == DelegationPurposeReview && plan.Config.Events == DelegationEventsClaudeStreamJSON {\n\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n\t\tif err != nil {\n\t\t\treturn finish(ReviewRunFailed, \"review staging policy unavailable\")\n\t\t}\n\t\tif found && policy.Agents[plan.Adapter].ReviewProfile != nil {\n\t\t\tif err := prepareClaudeReviewStaging(runtimeRoot, plan.Bundle.Payload.Plan.Components); err != nil {\n\t\t\t\treturn finish(ReviewRunFailed, \"review staging directories unavailable\")\n\t\t\t}\n\t\t}\n\t}\n\tdiskBefore, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n\tif err != nil {\n\t\treturn finish(ReviewRunFailed, err.Error())\n\t}\n\n\trawTree, err := json.Marshal(diskBefore)\n\tif err != nil {\n\t\treturn finish(ReviewRunFailed, err.Error())\n\t}\n\tif plan.predecessor != nil && (!plan.handoff || plan.predecessor.TreeDigest != \"\") && digestBytes(rawTree) != plan.predecessor.TreeDigest {\n\t\treturn finish(ReviewRunFailed, \"recreated worktree tree digest differs\")\n\t}\n\trun.TreeDigest = digestBytes(rawTree)\n\toutputFile := filepath.Join(tmp, \"output.txt\")\n\tcommand := plan.Config.Command\n\tif plan.predecessor != nil && !plan.handoff || plan.thread.continued() {\n\t\tcommand = plan.Config.Resume.Command\n\t}\n\targv := ReviewerArgv(command, outputFile, plan.session, plan.Effort, plan.Config.Effort)\n\ttimeout := time.Duration(safety.TimeoutMS) * time.Millisecond\n\texecPath := argv[0]\n\tif run.Provenance != nil {\n\t\tcopy := *run.Provenance\n\t\trun.Provenance = &copy\n\t\tselected, resolved, err := provenanceExecutableSelection(argv[0], worktree)\n\t\tif err != nil {\n\t\t\treturn finish(ReviewRunFailed, \"provenance executable could not be resolved\")\n\t\t}\n\t\tdigest, err := reviewExecutableDigest(resolved)\n\t\tif err != nil {\n\t\t\treturn finish(ReviewRunFailed, err.Error())\n\t\t}\n\t\trun.Provenance.ExecutableDigest = digest\n\t\texecPath = selected\n\t\traw, _ := json.Marshal(argv)\n\t\trun.Provenance.ArgvDigest = digestBytes(raw)\n\t}\n\tif plan.processTimeout > 0 {\n\t\tstarted, err := time.Parse(time.RFC3339Nano, run.StartedAt)\n\t\tif err != nil {\n\t\t\treturn finish(ReviewRunFailed, \"invalid execution start\")\n\t\t}\n\t\tsetup := now().Sub(started)\n\t\tremaining := plan.processTimeout - setup\n\t\tif setup < 0 || remaining <= 0 {\n\t\t\treturn finish(ReviewRunFailed, \"accumulated wall-clock budget spent before adapter launch\")\n\t\t}\n\t\tif remaining < timeout {\n\t\t\ttimeout = remaining\n\t\t}\n\t}\n\tctx, cancel := context.WithTimeout(parent, timeout)\n\tdefer cancel()\n\tcmd := exec.CommandContext(ctx, execPath, argv[1:]...)\n\tcmd.Args[0] = argv[0]\n\t// The adapter runs under the review run shim, which ends what the run\n\t// leaves in its subtree (review_shim.go).\n\tuseShim := false\n\tvar shimRead, shimWrite *os.File\n\tif ReviewShimAvailable && runtime.GOOS == \"linux\" && cmd.Err == nil {\n\t\t// The adapter's path as resolved here, in the dispatcher's PATH. A\n\t\t// shim that cannot be set up fails the run: it never falls back to\n\t\t// the weaker environment search (review round 11, N1).\n\t\tself, err := os.Executable()\n\t\tif err != nil {\n\t\t\treturn finish(ReviewRunFailed, \"the review run shim could not be set up: \"+err.Error())\n\t\t}\n\t\tr, w, err := os.Pipe()\n\t\tif err != nil {\n\t\t\treturn finish(ReviewRunFailed, \"the review run shim could not be set up: \"+err.Error())\n\t\t}\n\t\tuseShim, shimRead, shimWrite = true, r, w\n\t\tcmd = exec.CommandContext(ctx, self, append([]string{ReviewShimArg, cmd.Path}, argv...)...)\n\t\tcmd.ExtraFiles = []*os.File{w}\n\t}\n\tcmd.Dir = worktree\n\tcmd.Stdin = strings.NewReader(plan.Brief.Text)\n\tenv, secrets, err := reviewAdapterEnvironment(plan.Config, tmp, plan.Brief.Text, plan.notes)\n\tif err != nil {\n\t\trun.BriefNotes = \"\"\n\t\treturn finish(ReviewRunFailed, err.Error())\n\t}\n\tunset := []string{}\n\tif policy, _, found, perr := s.LoadDelegationPolicy(); perr == nil && found {\n\t\tunset = policy.EnvUnset\n\t}\n\tenv, run.EnvRemoved = withoutParentSession(env, unset)\n\t// The reviewer works in a sealed checkout: diagnostics it runs must not\n\t// publish derived records into it (SealedCheckoutEnv).\n\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n\tif useShim {\n\t\tenv = append(env, ReviewShimReportEnv+\"=\"+fmt.Sprint(os.Getpid()))\n\t}\n\t// The reviewer checks its draft against the sealed bundle and the round\n\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n\t// context that cannot be built leaves the check unavailable, never the\n\t// review.\n\tif plan.Purpose == DelegationPurposeReview {\n\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n\t\t\t\t// engine that dispatched the run is the one that checks it.\n\t\t\t\tif self, err := os.Executable(); err == nil {\n\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tcmd.Env = env\n\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n\tcmd.Stdout, cmd.Stderr = combined, combined\n\t// pose delegate watch follows the normalized, redacted events as they come\n\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n\t// the record is published.\n\tsessionPattern := \"\"\n\tif plan.Config.Session != nil {\n\t\tsessionPattern = plan.Config.Session.Pattern\n\t}\n\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n\t\ttee := io.MultiWriter(combined, live)\n\t\tcmd.Stdout, cmd.Stderr = tee, tee\n\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n\t\tdefer live.Close()\n\t}\n\t// Adapters such as `codex exec` and `claude -p` start children; killing\n\t// only the parent left a child holding stdout, so the timeout never fired\n\t// (found in review). The run gets its own process group, the whole group\n\t// is killed on timeout and after the run, and pipes are released at most\n\t// a few seconds after the kill.\n\topaqueBaseline := reviewOpaqueProcessBaseline()\n\t// Orphans of the run are reparented to this process, so one that left\n\t// the group and cleared its environment is still found (review round 6, N2).\n\tisolateProcessGroup(cmd)\n\tcmd.WaitDelay = AdapterPipeGrace\n\tvar shimReport []byte\n\tshimReportDone := make(chan struct{})\n\tif useShim {\n\t\t// A timeout asks the shim to end the run's subtree first; the group\n\t\t// kill after Wait remains the backstop (review round 8, N3).\n\t\tcmd.Cancel = stopReviewShim(cmd)\n\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n\t\tgo func() {\n\t\t\tdefer close(shimReportDone)\n\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n\t\t\t// Whatever exceeds the bound is drained, so the shim never blocks.\n\t\t\t_, _ = io.Copy(io.Discard, shimRead)\n\t\t}()\n\t} else {\n\t\tclose(shimReportDone)\n\t}\n\tvar runErr error\n\tprepareReviewProcessTree(cmd)\n\tif run.Provenance == nil {\n\t\tif runErr = cmd.Start(); runErr == nil {\n\t\t\tif runErr = attachReviewProcessTree(cmd); runErr == nil {\n\t\t\t\trunErr = cmd.Wait()\n\t\t\t} else {\n\t\t\t\t_ = cmd.Wait()\n\t\t\t}\n\t\t}\n\t} else {\n\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n\t\trunErr = err\n\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n\t\tif started {\n\t\t\trun.Provenance.ExecutionState = \"started\"\n\t\t}\n\t}\n\tif useShim && safety != nil {\n\t\t// With the shim the run's leftovers are its subtree, not an\n\t\t// environment match (review round 9, N1).\n\t\tfor i, limit := range safety.Limitations {\n\t\t\tif strings.HasPrefix(limit, \"no memory/CPU quota;\") {\n\t\t\t\tsafety.Limitations[i] = \"no memory/CPU quota; the review run shim ends every process left in the run's subtree, including one in its own session\"\n\t\t\t}\n\t\t}\n\t}\n\tif useShim {\n\t\t_ = shimWrite.Close()\n\t\t<-shimReportDone\n\t\t_ = shimRead.Close()\n\t}\n\tterminationErr = errors.Join(killProcessGroup(cmd), releaseReviewProcessTree(cmd))\n\t// A command the reviewer left running in a session of its own escapes the\n\t// group kill; it is ended here, before the cleanup inventory reads the\n\t// directories it may still write (spec\n\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n\t// The environment entry is the reviewer's to set, so it is searched only\n\t// without the shim, whose subtree is the run's by construction (review\n\t// round 8, N1).\n\tvar reaped []string\n\tshimMore := 0\n\tvar opaque int\n\tvar reapErr error\n\tif !useShim {\n\t\treaped, opaque, reapErr = reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n\t\tif reapErr != nil {\n\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n\t\t}\n\t}\n\tif useShim && cmd.ProcessState != nil {\n\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n\t\t\tterminationErr = errors.Join(terminationErr, err)\n\t\t} else {\n\t\t\tfor _, pid := range report.Ended {\n\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n\t\t\t}\n\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n\t\t\t\t// Counted from the total, not from the listed pids (review\n\t\t\t\t// round 12, N3).\n\t\t\t\tshimMore = more\n\t\t\t}\n\t\t\tif report.Error != \"\" {\n\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n\t\t\t\t// The shim's own words go into the record, not only the\n\t\t\t\t// generic failure (review round 10, N3).\n\t\t\t\tif safety != nil {\n\t\t\t\t\tsafety.Limitations = append(safety.Limitations, \"the review run shim could not end the whole subtree: \"+report.Error)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif endedCount := len(reaped) + shimMore; endedCount > 0 && safety != nil {\n\t\tlisted := strings.Join(reaped, \", \")\n\t\tif shimMore > 0 {\n\t\t\tlisted += fmt.Sprintf(\" and %d more (orphaned)\", shimMore)\n\t\t}\n\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(endedCount)+\" process(es) the run left running: \"+listed)\n\t}\n\tif opaque > 0 && reapErr == nil && safety != nil {\n\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n\t}\n\tterminationFailed = terminationErr != nil\n\t// The adapter exited and a child it left still held the output when\n\t// WaitDelay expired: the run finished, its leftover is killed above, and\n\t// the exit status decides (found in review).\n\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n\t\trunErr = nil\n\t}\n\ttranscript, overflow := combined.result()\n\tsafety.CaptureComplete = !overflow\n\tif cmd.ProcessState != nil {\n\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n\t}\n\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n\t\tsafety.CaptureComplete = false\n\t}\n\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n\t\trun.Output = string(raw)\n\t\tif run.Provenance != nil {\n\t\t\trun.Provenance.OutputComplete = true\n\t\t\trun.Provenance.OutputSource = \"file\"\n\t\t}\n\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n\t\t// The agent writes no output file; its stream names its final message.\n\t\trun.Output = final\n\t\tif run.Provenance != nil {\n\t\t\trun.Provenance.OutputComplete = true\n\t\t\trun.Provenance.OutputSource = \"stream-final\"\n\t\t}\n\t} else {\n\t\trun.Output = tail(string(transcript), 20000)\n\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n\t\t\tsafety.CaptureComplete = false\n\t\t}\n\t\tif run.Provenance != nil {\n\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n\t\t}\n\t}\n\tif run.Provenance != nil {\n\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n\t}\n\tif runErr != nil && cmd.ProcessState == nil {\n\t\trun.Output, transcript = \"\", nil\n\t\tif run.Provenance != nil {\n\t\t\trun.Provenance.OutputComplete = false\n\t\t}\n\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n\t}\n\t// Raw provenance hashes above precede redaction; only complete, bounded\n\t// redacted channels can be retained. Partial boundaries can expose a secret.\n\tsafety.ExecutionCause = executionCause(ctx)\n\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n\t\tsafety.CaptureComplete = false\n\t}\n\tif !safety.CaptureComplete {\n\t\ttranscript = nil\n\t\trun.Output = \"\"\n\t\tif run.Provenance != nil {\n\t\t\trun.Provenance.OutputComplete = false\n\t\t}\n\t\tif terminationErr != nil {\n\t\t\treturn finish(ReviewRunFailed, \"process group termination failed; descendants may remain\")\n\t\t}\n\t\tsafety.ExecutionCause = \"capture-incomplete\"\n\t\treturn finish(ReviewRunFailed, \"adapter capture incomplete: stream/output limit or unsafe output file\")\n\t}\n\tcaptureStage := \"session/interrupt recognition\"\n\tstatus, failure, captureErr := s.classifyReviewInterruption(&run, plan, transcript, runErr, ctx.Err())\n\tif captureErr == nil {\n\t\tvar redactErr error\n\t\traw := transcript\n\t\tcaptureStage = \"stdout\"\n\t\ttranscript, redactErr = redactReviewCapture(transcript, secrets, run.sessionForRedaction, safety.StreamBytes)\n\t\tvar output []byte\n\t\tif redactErr == nil {\n\t\t\tcaptureStage = \"final output\"\n\t\t\toutput, redactErr = redactReviewCapture([]byte(run.Output), secrets, run.sessionForRedaction, safety.OutputBytes)\n\t\t}\n\t\trun.Output = string(output)\n\t\tif redactErr == nil && run.Events != \"\" {\n\t\t\tcaptureStage = \"normalized events\"\n\t\t\t// Events are parsed from the decoded stream, where a JSON escape no longer\n\t\t\t// hides a value: each text is redacted again after decoding.\n\t\t\trun.eventsBytes, redactErr = redactedDelegationEvents(run.Events, raw, run.Output, secrets, run.sessionForRedaction)\n\t\t}\n\t\tif redactErr != nil {\n\t\t\tcaptureErr = redactErr\n\t\t}\n\t}\n\tif captureErr != nil {\n\t\trun.Output, transcript = \"\", nil\n\t\tsafety.CaptureComplete = false\n\t\tsafety.ExecutionCause = \"capture-incomplete\"\n\t\tif run.Provenance != nil {\n\t\t\trun.Provenance.OutputComplete = false\n\t\t}\n\t\treturn finish(ReviewRunFailed, \"adapter capture failed; unredacted output withheld; \"+delegationCaptureFailure(run.Adapter, run.Events, captureStage, captureErr))\n\t}\n\trun.sessionForRedaction = \"\"\n\n\tif status != \"\" {\n\t\t// Partial drafts are evidence only after the same containment checks.\n\t\tafter, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n\t\tif err != nil || !reflect.DeepEqual(diskBefore, after) {\n\t\t\treturn finish(ReviewRunFailed, \"interrupted adapter changed or obscured the sealed worktree\")\n\t\t}\n\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n\t\t\treturn finish(ReviewRunFailed, err.Error())\n\t\t}\n\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n\t\t\treturn finish(ReviewRunFailed, \"origin changed during interruption: \"+err.Error())\n\t\t}\n\t\tif status == ReviewRunInterrupted {\n\t\t\trun.PartialDigest = digestBytes([]byte(run.Output))\n\t\t}\n\t\treturn finish(status, failure)\n\t}\n\tdiskAfter, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n\tif err != nil {\n\t\treturn finish(ReviewRunFailed, err.Error())\n\t}\n\tif !reflect.DeepEqual(diskBefore, diskAfter) {\n\t\tchanged := []string{}\n\t\tfor path, digest := range diskBefore {\n\t\t\tif diskAfter[path] != digest {\n\t\t\t\tchanged = append(changed, path)\n\t\t\t}\n\t\t}\n\t\tfor path := range diskAfter {\n\t\t\tif _, exists := diskBefore[path]; !exists {\n\t\t\t\tchanged = append(changed, path)\n\t\t\t}\n\t\t}\n\t\tsort.Strings(changed)\n\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"the run changed files in the sealed worktree (including ignored materialization): %q\", changed))\n\t}\n\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n\t\treturn finish(ReviewRunFailed, err.Error())\n\t}\n\tif err := s.checkDispatchOrigin(plan); err != nil {\n\t\treturn finish(ReviewRunFailed, \"origin or policy changed: \"+err.Error())\n\t}\n\n\tevents := run.eventsBytes\n\tif run.Kind == ReviewBriefKindReview {\n\t\t// The round and the draft's account of it are judged when the run\n\t\t// completes, against the rounds before it (R1, R4).\n\t\tround, err := s.ReviewRoundOf(plan.Bundle)\n\t\tif err != nil {\n\t\t\treturn finish(ReviewRunFailed, \"the round of the bundle cannot be derived: \"+err.Error())\n\t\t}\n\t\trun.Round, run.DraftProblems = round.Number, ValidateRoundDraft(round, run.Output)\n\t}\n\tpublished, err := finish(ReviewRunCompleted, \"\")\n\tif err != nil {\n\t\treturn published, err\n\t}\n\tif why := s.checkDispatchOrigin(plan); why != nil {\n\t\tlate := published\n\t\tlate.RunID, late.Path, late.TranscriptDigest, late.TranscriptPath = \"\", \"\", \"\", \"\"\n\t\tlate.Status, late.Failure, late.Supersedes = ReviewRunFailed, why.Error(), published.RunID\n\t\tlate.eventsBytes = events\n\t\tlate.EndedAt = now().UTC().Format(time.RFC3339Nano)\n\t\treturn s.recordReviewRun(late, transcript)\n\t}\n\treturn published, nil","numLines":760,"startLine":560,"totalLines":2058}},"tool_result_meta":[{"id":"toolu_01XsDwjT8CfWtveXk9Qf9VQr","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
