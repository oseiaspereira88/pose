ree tree digest differs\")\n930\t\t}\n931\t\trun.TreeDigest = digestBytes(rawTree)\n932\t\toutputFile := filepath.Join(tmp, \"output.txt\")\n933\t\tcommand := plan.Config.Command\n934\t\tif plan.predecessor != nil && !plan.handoff || plan.thread.continued() {\n935\t\t\tcommand = plan.Config.Resume.Command\n936\t\t}\n937\t\targv := ReviewerArgv(command, outputFile, plan.session, plan.Effort, plan.Config.Effort)\n938\t\ttimeout := time.Duration(safety.TimeoutMS) * time.Millisecond\n939\t\texecPath := argv[0]\n940\t\tif run.Provenance != nil {\n941\t\t\tcopy := *run.Provenance\n942\t\t\trun.Provenance = &copy\n943\t\t\tselected, resolved, err := provenanceExecutableSelection(argv[0], worktree)\n944\t\t\tif err != nil {\n945\t\t\t\treturn finish(ReviewRunFailed, \"provenance executable could not be resolved\")\n946\t\t\t}\n947\t\t\tdigest, err := reviewExecutableDigest(resolved)\n948\t\t\tif err != nil {\n949\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n950\t\t\t}\n951\t\t\trun.Provenance.ExecutableDigest = digest\n952\t\t\texecPath = selected\n953\t\t\traw, _ := json.Marshal(argv)\n954\t\t\trun.Provenance.ArgvDigest = digestBytes(raw)\n955\t\t}\n956\t\tif plan.processTimeout > 0 {\n957\t\t\tstarted, err := time.Parse(time.RFC3339Nano, run.StartedAt)\n958\t\t\tif err != nil {\n959\t\t\t\treturn finish(ReviewRunFailed, \"invalid execution start\")\n960\t\t\t}\n961\t\t\tsetup := now().Sub(started)\n962\t\t\tremaining := plan.processTimeout - setup\n963\t\t\tif setup < 0 || remaining <= 0 {\n964\t\t\t\treturn finish(ReviewRunFailed, \"accumulated wall-clock budget spent before adapter launch\")\n965\t\t\t}\n966\t\t\tif remaining < timeout {\n967\t\t\t\ttimeout = remaining\n968\t\t\t}\n969\t\t}\n970\t\tctx, cancel := context.WithTimeout(parent, timeout)\n971\t\tdefer cancel()\n972\t\tcmd := exec.CommandContext(ctx, execPath, argv[1:]...)\n973\t\tcmd.Args[0] = argv[0]\n974\t\t// The adapter runs under the review run shim, which ends what the run\n975\t\t// leaves in its subtree (review_shim.go).\n976\t\tuseShim := false\n977\t\tvar shimRead, shimWrite *os.File\n978\t\tif ReviewShimAvailable && runtime.GOOS == \"linux\" && cmd.Err == nil {\n979\t\t\t// The adapter's path as resolved here, in the dispatcher's PATH. A\n980\t\t\t// shim that cannot be set up fails the run: it never falls back to\n981\t\t\t// the weaker environment search (review round 11, N1).\n982\t\t\tself, err := os.Executable()\n983\t\t\tif err != nil {\n984\t\t\t\treturn finish(ReviewRunFailed, \"the review run shim could not be set up: \"+err.Error())\n985\t\t\t}\n986\t\t\tr, w, err := os.Pipe()\n987\t\t\tif err != nil {\n988\t\t\t\treturn finish(ReviewRunFailed, \"the review run shim could not be set up: \"+err.Error())\n989\t\t\t}\n990\t\t\tuseShim, shimRead, shimWrite = true, r, w\n991\t\t\tcmd = exec.CommandContext(ctx, self, append([]string{ReviewShimArg, cmd.Path}, argv...)...)\n992\t\t\tcmd.ExtraFiles = []*os.File{w}\n993\t\t}\n994\t\tcmd.Dir = worktree\n995\t\tcmd.Stdin = strings.NewReader(plan.Brief.Text)\n996\t\tenv, secrets, err := reviewAdapterEnvironment(plan.Config, tmp, plan.Brief.Text, plan.notes)\n997\t\tif err != nil {\n998\t\t\trun.BriefNotes = \"\"\n999\t\t\treturn finish(ReviewRunFailed, err.Error())\n1000\t\t}\n1001\t\tunset := []string{}\n1002\t\tif policy, _, found, perr := s.LoadDelegationPolicy(); perr == nil && found {\n1003\t\t\tunset = policy.EnvUnset\n1004\t\t}\n1005\t\tenv, run.EnvRemoved = withoutParentSession(env, unset)\n1006\t\t// The reviewer works in a sealed checkout: diagnostics it runs must not\n1007\t\t// publish derived records into it (SealedCheckoutEnv).\n1008\t\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n1009\t\tif useShim {\n1010\t\t\tenv = append(env, ReviewShimReportEnv+\"=\"+fmt.Sprint(os.Getpid()))\n1011\t\t}\n1012\t\t// The reviewer checks its draft against the sealed bundle and the round\n1013\t\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n1014\t\t// context that cannot be built leaves the check unavailable, never the\n1015\t\t// review.\n1016\t\tif plan.Purpose == DelegationPurposeReview {\n1017\t\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n1018\t\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n1019\t\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n1020\t\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n1021\t\t\t\t\t// engine that dispatched the run is the one that checks it.\n1022\t\t\t\t\tif self, err := os.Executable(); err == nil {\n1023\t\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n1024\t\t\t\t\t}\n1025\t\t\t\t}\n1026\t\t\t}\n1027\t\t}\n1028\t\tcmd.Env = env\n1029\t\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n1030\t\tcmd.Stdout, cmd.Stderr = combined, combined\n1031\t\t// pose delegate watch follows the normalized, redacted events as they come\n1032\t\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n1033\t\t// the record is published.\n1034\t\tsessionPattern := \"\"\n1035\t\tif plan.Config.Session != nil {\n1036\t\t\tsessionPattern = plan.Config.Session.Pattern\n1037\t\t}\n1038\t\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n1039\t\t\ttee := io.MultiWriter(combined, live)\n1040\t\t\tcmd.Stdout, cmd.Stderr = tee, tee\n1041\t\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n1042\t\t\tdefer live.Close()\n1043\t\t}\n1044\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n1045\t\t// only the parent left a child holding stdout, so the timeout never fired\n1046\t\t// (found in review). The run gets its own process group, the whole group\n1047\t\t// is killed on timeout and after the run, and pipes are released at most\n1048\t\t// a few seconds after the kill.\n1049\t\topaqueBaseline := reviewOpaqueProcessBaseline()\n1050\t\t// Orphans of the run are reparented to this process, so one that left\n1051\t\t// the group and cleared its environment is still found (review round 6, N2).\n1052\t\tisolateProcessGroup(cmd)\n1053\t\tcmd.WaitDelay = AdapterPipeGrace\n1054\t\tvar shimReport []byte\n1055\t\tshimReportDone := make(chan struct{})\n1056\t\tif useShim {\n1057\t\t\t// A timeout asks the shim to end the run's subtree first; the group\n1058\t\t\t// kill after Wait remains the backstop (review round 8, N3).\n1059\t\t\tcmd.Cancel = stopReviewShim(cmd)\n1060\t\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n1061\t\t\tgo func() {\n1062\t\t\t\tdefer close(shimReportDone)\n1063\t\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n1064\t\t\t\t// Whatever exceeds the bound is drained, so the shim never blocks.\n1065\t\t\t\t_, _ = io.Copy(io.Discard, shimRead)\n1066\t\t\t}()\n1067\t\t} else {\n1068\t\t\tclose(shimReportDone)\n1069\t\t}\n1070\t\tvar runErr error\n1071\t\tprepareReviewProcessTree(cmd)\n1072\t\tif run.Provenance == nil {\n1073\t\t\tif runErr = cmd.Start(); runErr == nil {\n1074\t\t\t\tif runErr = attachReviewProcessTree(cmd); runErr == nil {\n1075\t\t\t\t\trunErr = cmd.Wait()\n1076\t\t\t\t} else {\n1077\t\t\t\t\t_ = cmd.Wait()\n1078\t\t\t\t}\n1079\t\t\t}\n1080\t\t} else {\n1081\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n1082\t\t\trunErr = err\n1083\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n1084\t\t\tif started {\n1085\t\t\t\trun.Provenance.ExecutionState = \"started\"\n1086\t\t\t}\n1087\t\t}\n1088\t\tif useShim && safety != nil {\n1089\t\t\t// With the shim the run's leftovers are its subtree, not an\n1090\t\t\t// environment match (review round 9, N1).\n1091\t\t\tfor i, limit := range safety.Limitations {\n1092\t\t\t\tif strings.HasPrefix(limit, \"no memory/CPU quota;\") {\n1093\t\t\t\t\tsafety.Limitations[i] = \"no memory/CPU quota; the review run shim ends every process left in the run's subtree, including one in its own session\"\n1094\t\t\t\t}\n1095\t\t\t}\n1096\t\t}\n1097\t\tif useShim {\n1098\t\t\t_ = shimWrite.Close()\n1099\t\t\t<-shimReportDone\n1100\t\t\t_ = shimRead.Close()\n1101\t\t}\n1102\t\tterminationErr = errors.Join(killProcessGroup(cmd), releaseReviewProcessTree(cmd))\n1103\t\t// A command the reviewer left running in a session of its own escapes the\n1104\t\t// group kill; it is ended here, before the cleanup inventory reads the\n1105\t\t// directories it may still write (spec\n1106\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n1107\t\t// The environment entry is the reviewer's to set, so it is searched only\n1108\t\t// without the shim, whose subtree is the run's by construction (review\n1109\t\t// round 8, N1).\n1110\t\tvar reaped []string\n1111\t\tshimMore := 0\n1112\t\tvar opaque int\n1113\t\tvar reapErr error\n1114\t\tif !useShim {\n1115\t\t\treaped, opaque, reapErr = reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n1116\t\t\tif reapErr != nil {\n1117\t\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n1118\t\t\t}\n1119\t\t}\n1120\t\tif useShim && cmd.ProcessState != nil {\n1121\t\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n1122\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n1123\t\t\t} else {\n1124\t\t\t\tfor _, pid := range report.Ended {\n1125\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n1126\t\t\t\t}\n1127\t\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n1128\t\t\t\t\t// Counted from the total, not from the listed pids (review\n1129\t\t\t\t\t// round 12, N3).\n1130\t\t\t\t\tshimMore = more\n1131\t\t\t\t}\n1132\t\t\t\tif report.Error != \"\" {\n1133\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n1134\t\t\t\t\t// The shim's own words go into the record, not only the\n1135\t\t\t\t\t// generic failure (review round 10, N3).\n1136\t\t\t\t\tif safety != nil {\n1137\t\t\t\t\t\tsafety.Limitations = append(safety.Limitations, \"the review run shim could not end the whole subtree: \"+report.Error)\n1138\t\t\t\t\t}\n1139\t\t\t\t}\n1140\t\t\t}\n1141\t\t}\n1142\t\tif endedCount := len(reaped) + shimMore; endedCount > 0 && safety != nil {\n1143\t\t\tlisted := strings.Join(reaped, \", \")\n1144\t\t\tif shimMore > 0 {\n1145\t\t\t\tlisted += fmt.Sprintf(\" and %d more (orphaned)\", shimMore)\n1146\t\t\t}\n1147\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(endedCount)+\" process(es) the run left running: \"+listed)\n1148\t\t}\n1149\t\tif opaque > 0 && reapErr == nil && safety != nil {\n1150\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n1151\t\t}\n1152\t\tterminationFailed = terminationErr != nil\n1153\t\t// The adapter exited and a child it left still held the output when\n1154\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n1155\t\t// the exit status decides (found in review).\n1156\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n1157\t\t\trunErr = nil\n1158\t\t}\n1159\t\ttranscript, overflow := combined.result()\n1160\t\tsafety.CaptureComplete = !overflow\n1161\t\tif cmd.ProcessState != nil {\n1162\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n1163\t\t}\n1164\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n1165\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n1166\t\t\tsafety.CaptureComplete = false\n1167\t\t}\n1168\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n1169\t\t\trun.Output = string(raw)\n1170\t\t\tif run.Provenance != nil {\n1171\t\t\t\trun.Provenance.OutputComplete = true\n1172\t\t\t\trun.Provenance.OutputSource = \"file\"\n1173\t\t\t}\n1174\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n1175\t\t\t// The agent writes no output file; its stream names its final message.\n1176\t\t\trun.Output = final\n1177\t\t\tif run.Provenance != nil {\n1178\t\t\t\trun.Provenance.OutputComplete = true\n1179\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n1180\t\t\t}\n1181\t\t} else {\n1182\t\t\trun.Output = tail(string(transcript), 20000)\n1183\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n1184\t\t\t\tsafety.CaptureComplete = false\n1185\t\t\t}\n1186\t\t\tif run.Provenance != nil {\n1187\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n1188\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n1189\t\t\t}\n1190\t\t}\n1191\t\tif run.Provenance != nil {\n1192\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n1193\t\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n1194\t\t}\n1195\t\tif runErr != nil && cmd.ProcessState == nil {\n1196\t\t\trun.Output, transcript = \"\", nil\n1197\t\t\tif run.Provenance != nil {\n1198\t\t\t\trun.Provenance.OutputComplete = false\n1199\t\t\t}\n1200\t\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n1201\t\t}\n1202\t\t// Raw provenance hashes above precede redaction; only complete, bounded\n1203\t\t// redacted channels can be retained. Partial boundaries can expose a secret.\n1204\t\tsafety.ExecutionCause = executionCause(ctx)\n1205\t\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n1206\t\t\tsafety.CaptureComplete = false\n1207\t\t}\n1208\t\tif !safety.CaptureComplete {\n1209\t\t\ttranscript = nil\n1210\t\t\trun.Output = \"\"\n1211\t\t\tif run.Provenance != nil {\n1212\t\t\t\trun.Provenance.OutputComplete = false\n1213\t\t\t}\n1214\t\t\tif terminationErr != nil {\n1215\t\t\t\treturn finish(ReviewRunFailed, \"process group termination failed; descendants may remain\")\n1216\t\t\t}\n1217\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n1218\t\t\treturn finish(ReviewRunFailed, \"adapter capture incomplete: stream/output limit or unsafe output file\")\n1219\t\t}\n1220\t\tcaptureStage := \"session/interrupt recognition\"\n1221\t\tstatus, failure, captureErr := s.classifyReviewInterruption(&run, plan, transcript, runErr, ctx.Err())\n1222\t\tif captureErr == nil {\n1223\t\t\tvar redactErr error\n1224\t\t\traw := transcript\n1225\t\t\tcaptureStage = \"stdout\"\n1226\t\t\ttranscript, redactErr = redactReviewCapture(transcript, secrets, run.sessionForRedaction, safety.StreamBytes)\n1227\t\t\tvar output []byte\n1228\t\t\tif redactErr == nil {\n1229\t\t\t\tcaptureStage = \"final output\"\n1230\t\t\t\toutput, redactErr = redactReviewCapture([]byte(run.Output), secrets, run.sessionForRedaction, safety.OutputBytes)\n1231\t\t\t}\n1232\t\t\trun.Output = string(output)\n1233\t\t\tif redactErr == nil && run.Events != \"\" {\n1234\t\t\t\tcaptureStage = \"normalized events\"\n1235\t\t\t\t// Events are parsed from the decoded stream, where a JSON escape no longer\n1236\t\t\t\t// hides a value: each text is redacted again after decoding.\n1237\t\t\t\trun.eventsBytes, redactErr = redactedDelegationEvents(run.Events, raw, run.Output, secrets, run.sessionForRedaction)\n1238\t\t\t}\n1239\t\t\tif redactErr != nil {\n1240\t\t\t\tcaptureErr = redactErr\n1241\t\t\t}\n1242\t\t}\n1243\t\tif captureErr != nil {\n1244\t\t\trun.Output, transcript = \"\", nil\n1245\t\t\tsafety.CaptureComplete = false\n1246\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n1247\t\t\tif run.Provenance != nil {\n1248\t\t\t\trun.Provenance.OutputComplete = false\n1249\t\t\t}\n1250\t\t\treturn finish(ReviewRunFailed, \"adapter capture failed; unredacted output withheld; \"+delegationCaptureFailure(run.Adapter, run.Events, captureStage, captureErr))\n1251\t\t}\n1252\t\trun.sessionForRedaction = \"\"\n1253\t\n1254\t\tif status != \"\" {\n1255\t\t\t// Partial drafts are evidence only after the same containment checks.\n1256\t\t\tafter, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n1257\t\t\tif err != nil || !reflect.DeepEqual(diskBefore, after) {\n1258\t\t\t\treturn finish(ReviewRunFailed, \"interrupted adapter changed or obscured the sealed worktree\")\n1259\t\t\t}\n1260\t\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n1261\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n1262\t\t\t}\n1263\t\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n1264\t\t\t\treturn finish(ReviewRunFailed, \"origin changed during interruption: \"+err.Error())\n1265\t\t\t}\n1266\t\t\tif status == ReviewRunInterrupted {\n1267\t\t\t\trun.PartialDigest = digestBytes([]byte(run.Output))\n1268\t\t\t}\n1269\t\t\treturn finish(status, failure)\n1270\t\t}\n1271\t\tdiskAfter, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n1272\t\tif err != nil {\n1273\t\t\treturn finish(ReviewRunFailed, err.Error())\n1274\t\t}\n1275\t\tif !reflect.DeepEqual(diskBefore, diskAfter) {\n1276\t\t\tchanged := []string{}\n1277\t\t\tfor path, digest := range diskBefore {\n1278\t\t\t\tif diskAfter[path] != digest {\n1279\t\t\t\t\tchanged = append(changed, path)\n1280\t\t\t\t}\n1281\t\t\t}\n1282\t\t\tfor path := range diskAfter {\n1283\t\t\t\tif _, exists := diskBefore[path]; !exists {\n1284\t\t\t\t\tchanged = append(changed, path)\n1285\t\t\t\t}\n1286\t\t\t}\n1287\t\t\tsort.Strings(changed)\n1288\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"the run changed files in the sealed worktree (including ignored materialization): %q\", changed))\n1289\t\t}\n1290\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n1291\t\t\treturn finish(ReviewRunFailed, err.Error())\n1292\t\t}\n1293\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n1294\t\t\treturn finish(ReviewRunFailed, \"origin or policy changed: \"+err.Error())\n1295\t\t}\n1296\t\n1297\t\tevents := run.eventsBytes\n1298\t\tif run.Kind == ReviewBriefKi