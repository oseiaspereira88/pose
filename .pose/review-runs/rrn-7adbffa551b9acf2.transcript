{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017Yr95Nna5no9ULjsUgz6av","type":"tool_result","content":"1960\t// already judged them, and closing the scope judges them again (spec\n1961\t// pose-sealed-checkout-does-not-require-later-child-evidence).\n1962\tfunc checkoutBlockers(blockers []string) []string {\n1963\t\tvar out []string\n1964\t\tfor _, blocker := range blockers {\n1965\t\t\tif strings.Contains(blocker, \"delivery integrity is unavailable\") || isChildReviewEvidenceBlocker(blocker) {\n1966\t\t\t\tcontinue\n1967\t\t\t}\n1968\t\t\tout = append(out, blocker)\n1969\t\t}\n1970\t\treturn out\n1971\t}\n1972\t\n1973\t// isChildReviewEvidenceBlocker recognises \"child <scope> has no sealed review bundle[: why]\".\n1974\tfunc isChildReviewEvidenceBlocker(blocker string) bool {\n1975\t\treturn strings.HasPrefix(blocker, \"child \") && strings.Contains(blocker, \" has no sealed review bundle\")\n1976\t}\n1977\t\n1978\tfunc sourceMaterializationDiffers(root, commit string, entries []ReviewBundleSubjectEntry) string {\n1979\t\tif commit == \"\" || !hasGitMetadata(root) {\n1980\t\t\t// No sealed commit, or no repository at all: nothing to compare with (a dispatch has both).\n1981\t\t\treturn \"\"\n1982\t\t}\n1983\t\tcheckedDirs := map[string]bool{}\n1984\t\tfor _, entry := range entries {\n1985\t\t\tif entry.Class == \"submodule\" {\n1986\t\t\t\tcontinue\n1987\t\t\t}\n1988\t\t\t// The absence the bundle sealed is part of what it reviewed: a removed path, and the old\n1989\t\t\t// side of a rename, must still be absent, whatever Git was told to ignore.\n1990\t\t\tfor _, gone := range removedSides(entry) {\n1991\t\t\t\tif _, err := os.Lstat(filepath.Join(root, filepath.FromSlash(gone))); err == nil {\n1992\t\t\t\t\treturn gone + \" (the bundle sealed it as removed, and it is there)\"\n1993\t\t\t\t}\n1994\t\t\t}\n1995\t\t\tif entry.Action == \"removed\" {\n1996\t\t\t\tcontinue\n1997\t\t\t}\n1998\t\t\trel := reviewBundleEntryPath(entry)\n1999\t\t\tif linkAbove(root, rel, checkedDirs) {\n2000\t\t\t\treturn rel + \" (a directory above it is a link, or not a directory)\"\n2001\t\t\t}\n2002\t\t\tout, err := gitCommand(\"-C\", root, \"ls-tree\", \"-z\", commit, \"--\", rel).Output()\n2003\t\t\tif err != nil {\n2004\t\t\t\treturn rel + \" (its record in the sealed commit could not be read: \" + err.Error() + \")\"\n2005\t\t\t}\n2006\t\t\tmeta, _, ok := strings.Cut(strings.TrimSuffix(string(out), \"\\x00\"), \"\\t\")\n2007\t\t\tfields := strings.Fields(meta)\n2008\t\t\tif !ok || len(fields) < 3 {\n2009\t\t\t\tcontinue // not in the sealed commit\n2010\t\t\t}\n2011\t\t\tmode, object := fields[0], fields[2]\n2012\t\t\tinfo, lerr := os.Lstat(filepath.Join(root, filepath.FromSlash(rel)))\n2013\t\t\tif lerr != nil {\n2014\t\t\t\treturn rel + \" (it cannot be inspected: \" + lerr.Error() + \")\"\n2015\t\t\t}\n2016\t\t\tswitch mode {\n2017\t\t\tcase \"120000\":\n2018\t\t\t\ttarget, rerr := os.Readlink(filepath.Join(root, filepath.FromSlash(rel)))\n2019\t\t\t\tif info.Mode()&os.ModeSymlink == 0 || rerr != nil || gitBlobID(\"sha1\", []byte(target)) != object && gitBlobID(\"sha256\", []byte(target)) != object {\n2020\t\t\t\t\treturn rel + \" (it is not the link the sealed commit records)\"\n2021\t\t\t\t}\n2022\t\t\tdefault:\n2023\t\t\t\tif !info.Mode().IsRegular() {\n2024\t\t\t\t\treturn rel + \" (it is not a regular file, and the sealed commit records one)\"\n2025\t\t\t\t}\n2026\t\t\t\tif runtime.GOOS != \"windows\" && (info.Mode().Perm()&0o111 != 0) != (mode == \"100755\") {\n2027\t\t\t\t\treturn rel + \" (its executable bit differs)\"\n2028\t\t\t\t}\n2029\t\t\t}\n2030\t\t}\n2031\t\treturn \"\"\n2032\t}\n2033\t\n2034\t// reviewAttemptIDRE is the form of a delegated review attempt's id.\n2035\tvar reviewAttemptIDRE = regexp.MustCompile(`^rat-[0-9a-f]{64}$`)\n2036\t\n2037\t// reviewRunRuntimeDir creates the private directory of one run. Every run of\n2038\t// an attempt uses the same path, so a resumed reviewer session, which still\n2039\t// refers to the sealed checkout it worked in, finds the checkout recreated\n2040\t// there after the interrupted run removed it (spec\n2041\t// pose-review-resume-keeps-the-sealed-checkout R1). The directory is created\n2042\t// exclusively and never followed: when the path already exists, from an\n2043\t// unfinished cleanup or from someone else, the run fails instead of sharing\n2044\t// it. A run without an attempt keeps a random name.\n2045\tfunc reviewRunRuntimeDir(attemptID string) (string, error) {\n2046\t\tif !reviewAttemptIDRE.MatchString(attemptID) {\n2047\t\t\treturn os.MkdirTemp(\"\", \"pose-review-run-*\")\n2048\t\t}\n2049\t\tdir := filepath.Join(os.TempDir(), \"pose-review-run-\"+attemptID[len(\"rat-\"):len(\"rat-\")+32])\n2050\t\tif err := os.Mkdir(dir, 0o700); err != nil {\n2051\t\t\tif errors.Is(err, fs.ErrExist) {\n2052\t\t\t\treturn \"\", fmt.Errorf(\"the attempt's runtime directory %s already exists; an earlier run of the attempt did not clean up, or another process holds the path\", dir)\n2053\t\t\t}\n2054\t\t\treturn \"\", err\n2055\t\t}\n2056\t\treturn dir, nil\n2057\t}\n2058\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"bc668d1d-299b-4a94-b499-a134f6fc1536","timestamp":"2026-11-26T07:20:12.449Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-93b9b9511d1567d3fc5c2c9979b76703/worktree/pose-mcp/internal/pose/review_dispatch.go","content":"// already judged them, and closing the scope judges them again (spec\n// pose-sealed-checkout-does-not-require-later-child-evidence).\nfunc checkoutBlockers(blockers []string) []string {\n\tvar out []string\n\tfor _, blocker := range blockers {\n\t\tif strings.Contains(blocker, \"delivery integrity is unavailable\") || isChildReviewEvidenceBlocker(blocker) {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, blocker)\n\t}\n\treturn out\n}\n\n// isChildReviewEvidenceBlocker recognises \"child <scope> has no sealed review bundle[: why]\".\nfunc isChildReviewEvidenceBlocker(blocker string) bool {\n\treturn strings.HasPrefix(blocker, \"child \") && strings.Contains(blocker, \" has no sealed review bundle\")\n}\n\nfunc sourceMaterializationDiffers(root, commit string, entries []ReviewBundleSubjectEntry) string {\n\tif commit == \"\" || !hasGitMetadata(root) {\n\t\t// No sealed commit, or no repository at all: nothing to compare with (a dispatch has both).\n\t\treturn \"\"\n\t}\n\tcheckedDirs := map[string]bool{}\n\tfor _, entry := range entries {\n\t\tif entry.Class == \"submodule\" {\n\t\t\tcontinue\n\t\t}\n\t\t// The absence the bundle sealed is part of what it reviewed: a removed path, and the old\n\t\t// side of a rename, must still be absent, whatever Git was told to ignore.\n\t\tfor _, gone := range removedSides(entry) {\n\t\t\tif _, err := os.Lstat(filepath.Join(root, filepath.FromSlash(gone))); err == nil {\n\t\t\t\treturn gone + \" (the bundle sealed it as removed, and it is there)\"\n\t\t\t}\n\t\t}\n\t\tif entry.Action == \"removed\" {\n\t\t\tcontinue\n\t\t}\n\t\trel := reviewBundleEntryPath(entry)\n\t\tif linkAbove(root, rel, checkedDirs) {\n\t\t\treturn rel + \" (a directory above it is a link, or not a directory)\"\n\t\t}\n\t\tout, err := gitCommand(\"-C\", root, \"ls-tree\", \"-z\", commit, \"--\", rel).Output()\n\t\tif err != nil {\n\t\t\treturn rel + \" (its record in the sealed commit could not be read: \" + err.Error() + \")\"\n\t\t}\n\t\tmeta, _, ok := strings.Cut(strings.TrimSuffix(string(out), \"\\x00\"), \"\\t\")\n\t\tfields := strings.Fields(meta)\n\t\tif !ok || len(fields) < 3 {\n\t\t\tcontinue // not in the sealed commit\n\t\t}\n\t\tmode, object := fields[0], fields[2]\n\t\tinfo, lerr := os.Lstat(filepath.Join(root, filepath.FromSlash(rel)))\n\t\tif lerr != nil {\n\t\t\treturn rel + \" (it cannot be inspected: \" + lerr.Error() + \")\"\n\t\t}\n\t\tswitch mode {\n\t\tcase \"120000\":\n\t\t\ttarget, rerr := os.Readlink(filepath.Join(root, filepath.FromSlash(rel)))\n\t\t\tif info.Mode()&os.ModeSymlink == 0 || rerr != nil || gitBlobID(\"sha1\", []byte(target)) != object && gitBlobID(\"sha256\", []byte(target)) != object {\n\t\t\t\treturn rel + \" (it is not the link the sealed commit records)\"\n\t\t\t}\n\t\tdefault:\n\t\t\tif !info.Mode().IsRegular() {\n\t\t\t\treturn rel + \" (it is not a regular file, and the sealed commit records one)\"\n\t\t\t}\n\t\t\tif runtime.GOOS != \"windows\" && (info.Mode().Perm()&0o111 != 0) != (mode == \"100755\") {\n\t\t\t\treturn rel + \" (its executable bit differs)\"\n\t\t\t}\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// reviewAttemptIDRE is the form of a delegated review attempt's id.\nvar reviewAttemptIDRE = regexp.MustCompile(`^rat-[0-9a-f]{64}$`)\n\n// reviewRunRuntimeDir creates the private directory of one run. Every run of\n// an attempt uses the same path, so a resumed reviewer session, which still\n// refers to the sealed checkout it worked in, finds the checkout recreated\n// there after the interrupted run removed it (spec\n// pose-review-resume-keeps-the-sealed-checkout R1). The directory is created\n// exclusively and never followed: when the path already exists, from an\n// unfinished cleanup or from someone else, the run fails instead of sharing\n// it. A run without an attempt keeps a random name.\nfunc reviewRunRuntimeDir(attemptID string) (string, error) {\n\tif !reviewAttemptIDRE.MatchString(attemptID) {\n\t\treturn os.MkdirTemp(\"\", \"pose-review-run-*\")\n\t}\n\tdir := filepath.Join(os.TempDir(), \"pose-review-run-\"+attemptID[len(\"rat-\"):len(\"rat-\")+32])\n\tif err := os.Mkdir(dir, 0o700); err != nil {\n\t\tif errors.Is(err, fs.ErrExist) {\n\t\t\treturn \"\", fmt.Errorf(\"the attempt's runtime directory %s already exists; an earlier run of the attempt did not clean up, or another process holds the path\", dir)\n\t\t}\n\t\treturn \"\", err\n\t}\n\treturn dir, nil\n}\n","numLines":99,"startLine":1960,"totalLines":2058}},"tool_result_meta":[{"id":"toolu_017Yr95Nna5no9ULjsUgz6av","permis