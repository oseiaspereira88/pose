{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017nML14GEpnCreAQB2vfJaa","type":"tool_result","content":"200\t\t// the transcript (spec pose-delegation-surface R8, R9, R11).\n201\t\tLabel        string   `json:\"label,omitempty\"`\n202\t\tPurpose      string   `json:\"purpose,omitempty\"`\n203\t\tLead         string   `json:\"lead,omitempty\"`\n204\t\tEnvRemoved   []string `json:\"env_removed,omitempty\"`\n205\t\tEvents       string   `json:\"events,omitempty\"`\n206\t\tEventsDigest string   `json:\"events_digest,omitempty\"`\n207\t\tSupersededBy string   `json:\"superseded_by,omitempty\"`\n208\t\t// Routing is how the run's agent was chosen and IndependenceAchieved what\n209\t\t// it achieved against the implementation (spec pose-delegation-routing R8).\n210\t\tRouting              *DelegationRoutingRecord `json:\"routing,omitempty\"`\n211\t\tIndependenceAchieved string                   `json:\"independence_achieved,omitempty\"`\n212\t\t// A task run (spec pose-delegation-task) records the access it ran with,\n213\t\t// its directory and flags, the argv it ran, and the digests of the prompt\n214\t\t// and the error stream kept beside its record; Recorded is --record.\n215\t\tAccess       string   `json:\"access,omitempty\"`\n216\t\tDir          string   `json:\"dir,omitempty\"`\n217\t\tAddDirs      []string `json:\"add_dirs,omitempty\"`\n218\t\tNoNetwork    bool     `json:\"no_network,omitempty\"`\n219\t\tRecorded     bool     `json:\"recorded,omitempty\"`\n220\t\tArgv         []string `json:\"argv,omitempty\"`\n221\t\tPromptDigest string   `json:\"prompt_digest,omitempty\"`\n222\t\tEffort       string   `json:\"effort,omitempty\"`\n223\t\tStderrDigest string   `json:\"stderr_digest,omitempty\"`\n224\t\t// Round is the round of the scope the run reviewed, DraftProblems what\n225\t\t// keeps its draft from counting for that round, and Thread how its session\n226\t\t// relates to the previous round's (spec\n227\t\t// pose-delegated-review-round-protocol R1, R4, R6).\n228\t\tRound         int           `json:\"round,omitempty\"`\n229\t\tDraftProblems []string      `json:\"draft_problems,omitempty\"`\n230\t\tThread        *ReviewThread `json:\"thread,omitempty\"`\n231\t\tPath          string        `json:\"-\"`\n232\t\t// eventsDir is where a task run's files are; a review run's are in\n233\t\t// reviewRunsDir.\n234\t\teventsDir string\n235\t}\n236\t\n237\t// Review run states.\n238\tconst (\n239\t\tReviewRunCompleted   = \"completed\"\n240\t\tReviewRunFailed      = \"failed\"\n241\t\tReviewRunInterrupted = \"interrupted\"\n242\t\tReviewRunStale       = \"stale\"\n243\t)\n244\t\n245\t// ListReviewRuns returns the recorded runs for bundleID (\"\" for all).\n246\tfunc (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n247\t\truns, _, err := s.ReadReviewRuns(bundleID)\n248\t\treturn runs, err\n249\t}\n250\t\n251\tfunc (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n252\t\t// Within a read-view operation the ledger is read and checked once per\n253\t\t// root; every request of the operation is answered from that read,\n254\t\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n255\t\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n256\t\t\truns, lost, err := s.readAllReviewRuns()\n257\t\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n258\t\t})\n259\t\tif err != nil {\n260\t\t\treturn nil, nil, err\n261\t\t}\n262\t\tout := copyReviewRuns(all.runs)\n263\t\tif bundleID != \"\" {\n264\t\t\tfiltered := []ReviewRun{}\n265\t\t\tfor _, run := range out {\n266\t\t\t\tif run.BundleID == bundleID {\n267\t\t\t\t\tfiltered = append(filtered, run)\n268\t\t\t\t}\n269\t\t\t}\n270\t\t\tout = filtered\n271\t\t}\n272\t\treturn out, deepCopyValue(all.lost), nil\n273\t}\n274\t\n275\t// readAllReviewRuns reads, checks and orders every review run of the store.\n276\tfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n277\t\tfiles := s.fsys()\n278\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n279\t\t// The storage is read where the writer writes it: a link in its place is another place.\n280\t\tif info, lerr := files.Lstat(dir); lerr == nil {\n281\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n282\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n283\t\t\t}\n284\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n285\t\t\treturn nil, nil, lerr\n286\t\t}\n287\t\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n288\t\tif errors.Is(err, os.ErrNotExist) {\n289\t\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n290\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n291\t\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n292\t\t\t\treturn nil, nil, lerr\n293\t\t\t}\n294\t\t\treturn []ReviewRun{}, nil, nil\n295\t\t}\n296\t\tif err != nil {\n297\t\t\treturn nil, nil, err\n298\t\t}\n299\t\tout := []ReviewRun{}\n300\t\tvar lost []string\n301\t\treadBudget := int64(32 << 20)\n302\t\tfor _, e := range entries {\n303\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n304\t\t\t\tcontinue\n305\t\t\t}\n306\t\t\tfull := filepath.Join(dir, e.Name())\n307\t\t\tinfo, infoErr := files.Lstat(full)\n308\t\t\tif infoErr != nil || !info.Mode().IsRegular() {\n309\t\t\t\tlost = append(lost, e.Name()+\" (not a regular file)\")\n310\t\t\t\tcontinue\n311\t\t\t}\n312\t\t\tif info.Size() < 0 || info.Size() > reviewLedgerMaxBytes {\n313\t\t\t\tlost = append(lost, e.Name()+\" (record exceeds bound or is unreadable)\")\n314\t\t\t\tcontinue\n315\t\t\t}\n316\t\t\traw, err := readLedgerRawBudgetIn(files, full, &readBudget)\n317\t\t\tif err != nil {\n318\t\t\t\tlost = append(lost, e.Name()+\" (\"+err.Error()+\")\")\n319\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n320\t\t\t\t\tbreak\n321\t\t\t\t}\n322\t\t\t\tcontinue\n323\t\t\t}\n324\t\t\tvar run ReviewRun\n325\t\t\tif json.Unmarshal(raw, &run) != nil || run.RunID == \"\" {\n326\t\t\t\tlost = append(lost, e.Name()+\" (not a review run)\")\n327\t\t\t\tcontinue\n328\t\t\t}\n329\t\t\tif verr := validateReviewRunRecord(e.Name(), run); verr != nil {\n330\t\t\t\tlost = append(lost, e.Name()+\" (\"+verr.Error()+\")\")\n331\t\t\t\tcontinue\n332\t\t\t}\n333\t\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, e.Name()))\n334\t\t\tout = append(out, run)\n335\t\t}\n336\t\tsort.Slice(out, func(i, j int) bool {\n337\t\t\ta, _ := time.Parse(time.RFC3339Nano, out[i].StartedAt)\n338\t\t\tb, _ := time.Parse(time.RFC3339Nano, out[j].StartedAt)\n339\t\t\tif !a.Equal(b) {\n340\t\t\t\treturn a.Before(b)\n341\t\t\t}\n342\t\t\treturn out[i].RunID < out[j].RunID\n343\t\t})\n344\t\tsuperseded := map[string]string{}\n345\t\tfor _, run := range out {\n346\t\t\tif run.Supersedes != \"\" {\n347\t\t\t\tsuperseded[run.Supersedes] = run.RunID\n348\t\t\t}\n349\t\t}\n350\t\tfor i := range out {\n351\t\t\tout[i].SupersededBy = superseded[out[i].RunID]\n352\t\t}\n353\t\tchecked := map[string][]DelegatedReviewAttempt{}\n354\t\tfor _, run := range out {\n355\t\t\tif run.LedgerVersion == 1 {\n356\t\t\t\tif _, err := files.Lstat(filepath.Join(s.Root, reviewRunLedgerDir, run.RunID+\".json\")); err != nil {\n357\t\t\t\t\tlost = append(lost, \"missing run witness \"+run.RunID)\n358\t\t\t\t}\n359\t\t\t}\n360\t\t\tif run.AttemptID != \"\" {\n361\t\t\t\tattempts, ok := checked[run.BundleID]\n362\t\t\t\tif !ok {\n363\t\t\t\t\tvar aerr error\n364\t\t\t\t\tattempts, aerr = s.readDelegatedReviewAttempts(run.BundleID, &readBudget)\n365\t\t\t\t\tif aerr != nil {\n366\t\t\t\t\t\tlost = append(lost, aerr.Error())\n367\t\t\t\t\t}\n368\t\t\t\t\tchecked[run.BundleID] = attempts\n369\t\t\t\t}\n370\t\t\t\t// The reservation names the attempt's first agent; a continuation's\n371\t\t\t\t// agent is checked against its own predecessor by the continuation\n372\t\t\t\t// chain (a resume keeps it, a handoff changes it).\n373\t\t\t\tfound := false\n374\t\t\t\tfor _, a := range attempts {\n375\t\t\t\t\tif a.AttemptID == run.AttemptID && a.BundleDigest == run.BundleDigest && a.Scope == run.Scope && (a.Adapter == run.Adapter || run.continues() != \"\") && a.Reason == run.Reason {\n376\t\t\t\t\t\tfound = true\n377\t\t\t\t\t\tbreak\n378\t\t\t\t\t}\n379\t\t\t\t}\n380\t\t\t\tif !found {\n381\t\t\t\t\tlost = append(lost, \"missing or conflicting attempt reservation \"+run.AttemptID)\n382\t\t\t\t}\n383\t\t\t}\n384\t\t}\n385\t\tfindings, ledgerErr := s.reviewRunLedgerFindings(\"\", &readBudget)\n386\t\tif ledgerErr != nil {\n387\t\t\tlost = append(lost, ledgerErr.Error())\n388\t\t}\n389\t\tlost = append(lost, findings...)\n390\t\tlost = append(lost, s.reviewContinuationFindings(out)...)\n391\t\treturn out, uniqueSorted(lost), nil\n392\t}\n393\t\n394\t// DispatchPlan is what a dispatch will do.\n395\ttype DispatchPlan struct {\n396\t\tprovenance          *ReviewRunProvenance\n397\t\tPendingContinuation *PendingReviewContinuation\n398\t\tprocessTimeout      time.Duration\n399\t\tpredecessor         *ReviewRun\n400\t\t// handoff makes the continuation another agent's, with handoffSection\n401\t\t// appended to the brief (spec pose-delegation-handoff).\n402\t\thandoff        bool\n403\t\thandoffSection string\n404\t\tsession        string\n405\t\t// round is the round of the scope the run reviews, and thread how a\n406\t\t// round after the first relates to the previous round's session.\n407\t\tround  int\n408\t\tthread *ReviewThread\n409\t\t// extraChannels are outputs the interruption classifier reads beside the\n410\t\t// transcript and the output, each on its own: a task's stderr.\n411\t\textraChannels  []string\n412\t\tnotes          string\n413\t\tExisting       *ReviewRun\n414\t\tLimitOf        string\n415\t\tReason         string\n416\t\tPolicyDigest   string\n417\t\tOriginWorktree string\n418\t\tAdapter        string\n419\t\tConfig         ReviewerAdapter\n420\t\tBrief          ReviewBrief\n421\t\tBundle         ReviewBundle\n422\t\tSealedCommit   string\n423\t\tPriorRuns      int\n424\t\t// Effort is the requested effort level; \"\" means the agent's default.\n425\t\tEffort string\n426\t\t// Label, Purpose and Lead are recorded on the run (pose delegate).\n427\t\tLabel   string\n428\t\tPurpose string\n429\t\tLead    string\n430\t\t// Routing is set by pose delegate; without it the run is compared with\n431\t\t// the implementation the plan read (spec pose-delegation-routing R8).\n432\t\tRouting        *DelegationRoutingRecord\n433\t\timplementation *ReviewBundleImplementation\n434\t\t// Warnings are printed before the run starts. SameVendorWarning is set\n435\t\t// when the plan's agent shares the implementation's vendor; a caller that\n436\t\t// named the agent prints it, routing does not (R9).\n437\t\tWarnings          []string\n438\t\tSameVendorWarning string\n439\t\t// OnStart is called once the attempt is reserved and its marker written,\n440\t\t// so a detached run can hand its reference back (spec\n441\t\t// pose-delegated-review-completion-signal R1).\n442\t\tOnStart func(attempt string) error\n443\t}\n444\t\n445\t// Implementation is the identity the plan compares its agent with.\n446\tfunc (p DispatchPlan) Implementation() ReviewBundleImplementation {\n447\t\tswitch {\n448\t\tcase p.Routing != nil:\n449\t\t\treturn p.Routing.Implementation\n450\t\tcase p.implementation != nil:\n451\t\t\treturn *p.implementation\n452\t\t}\n453\t\treturn ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n454\t}\n455\t\n456\t// replanContinuation plans a continuation again at execution, as a resume or\n457\t// as a handoff to the same agent.\n458\tfunc (s Store) replanContinuation(plan DispatchPlan) (DispatchPlan, error) {\n459\t\tvar fresh DispatchPlan\n460\t\tvar err error\n461\t\tif plan.handoff {\n462\t\t\tfresh, err = s.PlanReviewHandoff(plan.predecessor.RunID, plan.Adapter)\n463\t\t} else {\n464\t\t\tfresh, err = s.PlanReviewResume(plan.predecessor.RunID)\n465\t\t}\n466\t\tif err != nil {\n467\t\t\treturn fresh, err\n468\t\t}\n469\t\t// What the caller set on the plan is kept: the hand-back of a detached run\n470\t\t// and the routing that chose its agent (spec pose-delegation-mcp R4).\n471\t\tfresh.OnStart, fresh.Purpose = plan.OnStart, plan.Purpose\n472\t\tif fresh.Routing == nil {\n473\t\t\tfresh.Routing = plan.Routing\n474\t\t}\n475\t\treturn fresh, nil\n476\t}\n477\t\n478\t// PlanImplementationWithLead reads the plan's implementation again with the\n479\t// --lead the caller declared, for a bundle that records none (R4), and records\n480\t// the agent as named.\n481\tfunc (s Store) PlanImplementationWithLead(plan *DispatchPlan, lead string) {\n482\t\tplan.Routing, plan.Warnings, plan.SameVendorWarning = nil, nil, \"\"\n483\t\ts.planImplementation(plan, lead)\n484\t}\n485\t\n486\t// routingAgainstAnotherBundle refuses a routing decision made against an\n487\t// implementation the plan's bundle does not record: the run would record an\n488\t// identity and an independence it did not have (spec pose-delegation-routing\n489\t// R8).\n490\tfunc routingAgainstAnotherBundle(plan DispatchPlan) string {\n491\t\tif plan.Routing == nil || plan.Routing.ImplementationFrom != ImplementationFromBundle {\n492\t\t\treturn \"\"\n493\t\t}\n494\t\tsealed := plan.Bundle.Payload.Implementation\n495\t\tif sealed == nil || !sameImplementation(*sealed, plan.Routing.Implementation) {\n496\t\t\treturn \"the run was routed against another implementation than bundle \" + plan.Bundle.BundleID + \" records; route it again\"\n497\t\t}\n498\t\treturn \"\"\n499\t}\n500\t\n501\t// planImplementation reads the identity a run of bundle is compared with,\n502\t// records the agent as named unless routing chose it (R8, R9), and warns when\n503\t// the policy still declares an identity the bundle overrides (R4).\n504\tfunc (s Store) planImplementation(plan *DispatchPlan, lead string) {\n505\t\timpl := ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n506\t\tfrom := ImplementationFromNone\n507\t\tif policy, _, found, err := s.LoadDelegationPolicy(); err == nil && found {\n508\t\t\tif read, readFrom, err := s.RoutingImplementation(plan.Bundle, policy, lead); err == nil {\n509\t\t\t\timpl, from = read, readFrom\n510\t\t\t}\n511\t\t\tif plan.Bundle.Payload.Implementation != nil && policy.Provenance != nil && policy.Provenance.Implementation != (ModelIdentity{}) {\n512\t\t\t\tplan.Warnings = append(plan.Warnings, \"provenance.implementation in the delegation policy is ignored: bundle \"+plan.Bundle.BundleID+\" records the implementation it was sealed by; remove the policy entry\")\n513\t\t\t}\n514\t\t}\n515\t\tplan.implementation = &impl\n516\t\tif plan.Routing == nil {\n517\t\t\trecord := ExplicitDelegationRoute(plan.Adapter, impl, from)\n518\t\t\tplan.Routing = &record\n519\t\t}\n520\t\tif knownIdentityPart(impl.Vendor) && normalizeIdentityPart(plan.Config.Vendor) == impl.Vendor {\n521\t\t\tplan.SameVendorWarning = \"agent \" + plan.Adapter + \" shares the implementation's vendor (\" + impl.Vendor + \"); the run cannot achieve vendor independence\"\n522\t\t}\n523\t}\n524\t\n525\t// PlanReviewDispatch resolves the bundle, brief and adapter without running.\n526\tfunc (s Store) PlanReviewDispatch(target, kind, notes, adapter string, reason ...string) (DispatchPlan, error) {\n527\t\tif err := validateReviewNotes(notes); err != nil {\n528\t\t\treturn DispatchPlan{}, err\n529\t\t}\n530\t\tif len(reason) > 1 {\n531\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: one rerun reason is accepted\")\n532\t\t}\n533\t\twhy := \"\"\n534\t\tif len(reason) == 1 {\n535\t\t\twhy = strings.TrimSpace(reason[0])\n536\t\t}\n537\t\tbrief, err := s.RenderReviewBrief(target, kind, notes)\n538\t\tif err != nil {\n539\t\t\treturn DispatchPlan{}, err\n540\t\t}\n541\t\tbundle, err := s.LoadReviewBundle(brief.BundleID)\n542\t\tif err != nil {\n543\t\t\treturn DispatchPlan{}, err\n544\t\t}\n545\t\tpolicy, found, err := s.LoadReviewersPolicyFor(brief.Kind)\n546\t\tif err != nil {\n547\t\t\treturn DispatchPlan{}, err\n548\t\t}\n549\t\tif !found || len(policy.Adapters) == 0 {\n550\t\t\treturn DispatchPlan{Brief: brief, Bundle: bundle}, ErrNoReviewerAdapter\n551\t\t}\n552\t\tconfig, ok := policy.Adapters[adapter]\n553\t\tif !ok {\n554\t\t\tnames := make([]string, 0, len(policy.Adapters))\n555\t\t\tfor name := range policy.Adapters {\n556\t\t\t\tnames = append(names, name)\n557\t\t\t}\n558\t\t\tsort.Strings(names)\n559\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: no reviewer adapter %q; configured: %s\", adapter, strings.Join(names, \", \"))"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"3d132240-10ac-437b-b9b2-e875c9e08ed5","timestamp":"2026-11-26T07:20:29.340Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-93b9b9511d1567d3fc5c2c9979b76703/worktree/pose-mcp/internal/pose/review_dispatch.go","content":"\t// the transcript (spec pose-delegation-surface R8, R9, R11).\n\tLabel        string   `json:\"label,omitempty\"`\n\tPurpose      string   `json:\"purpose,omitempty\"`\n\tLead         string   `json:\"lead,omitempty\"`\n\tEnvRemoved   []string `json:\"env_removed,omitempty\"`\n\tEvents       string   `json:\"events,omitempty\"`\n\tEventsDigest string   `json:\"events_digest,omitempty\"`\n\tSupersededBy string   `json:\"superseded_by,omitempty\"`\n\t// Routing is how the run's agent was chosen and IndependenceAchieved what\n\t// it achieved against the implementation (spec pose-delegation-routing R8).\n\tRouting              *DelegationRoutingRecord `json:\"routing,omitempty\"`\n\tIndependenceAchieved string                   `json:\"independence_achieved,omitempty\"`\n\t// A task run (spec pose-delegation-task) records the access it ran with,\n\t// its directory and flags, the argv it ran, and the digests of the prompt\n\t// and the error stream kept beside its record; Recorded is --record.\n\tAccess       string   `json:\"access,omitempty\"`\n\tDir          string   `json:\"dir,omitempty\"`\n\tAddDirs      []string `json:\"add_dirs,omitempty\"`\n\tNoNetwork    bool     `json:\"no_network,omitempty\"`\n\tRecorded     bool     `json:\"recorded,omitempty\"`\n\tArgv         []string `json:\"argv,omitempty\"`\n\tPromptDigest string   `json:\"prompt_digest,omitempty\"`\n\tEffort       string   `json:\"effort,omitempty\"`\n\tStderrDigest string   `json:\"stderr_digest,omitempty\"`\n\t// Round is the round of the scope the run reviewed, DraftProblems what\n\t// keeps its draft from counting for that round, and Thread how its session\n\t// relates to the previous round's (spec\n\t// pose-delegated-review-round-protocol R1, R4, R6).\n\tRound         int           `json:\"round,omitempty\"`\n\tDraftProblems []string      `json:\"draft_problems,omitempty\"`\n\tThread        *ReviewThread `json:\"thread,omitempty\"`\n\tPath          string        `json:\"-\"`\n\t// eventsDir is where a task run's files are; a review run's are in\n\t// reviewRunsDir.\n\teventsDir string\n}\n\n// Review run states.\nconst (\n\tReviewRunCompleted   = \"completed\"\n\tReviewRunFailed      = \"failed\"\n\tReviewRunInterrupted = \"interrupted\"\n\tReviewRunStale       = \"stale\"\n)\n\n// ListReviewRuns returns the recorded runs for bundleID (\"\" for all).\nfunc (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n\truns, _, err := s.ReadReviewRuns(bundleID)\n\treturn runs, err\n}\n\nfunc (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n\t// Within a read-view operation the ledger is read and checked once per\n\t// root; every request of the operation is answered from that read,\n\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n\t\truns, lost, err := s.readAllReviewRuns()\n\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n\t})\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tout := copyReviewRuns(all.runs)\n\tif bundleID != \"\" {\n\t\tfiltered := []ReviewRun{}\n\t\tfor _, run := range out {\n\t\t\tif run.BundleID == bundleID {\n\t\t\t\tfiltered = append(filtered, run)\n\t\t\t}\n\t\t}\n\t\tout = filtered\n\t}\n\treturn out, deepCopyValue(all.lost), nil\n}\n\n// readAllReviewRuns reads, checks and orders every review run of the store.\nfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n\tfiles := s.fsys()\n\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n\t// The storage is read where the writer writes it: a link in its place is another place.\n\tif info, lerr := files.Lstat(dir); lerr == nil {\n\t\tif info.Mode()&os.ModeSymlink != 0 {\n\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n\t\t}\n\t} else if !errors.Is(lerr, os.ErrNotExist) {\n\t\treturn nil, nil, lerr\n\t}\n\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n\t\t\treturn nil, nil, lerr\n\t\t}\n\t\treturn []ReviewRun{}, nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tout := []ReviewRun{}\n\tvar lost []string\n\treadBudget := int64(32 << 20)\n\tfor _, e := range entries {\n\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(dir, e.Name())\n\t\tinfo, infoErr := files.Lstat(full)\n\t\tif infoErr != nil || !info.Mode().IsRegular() {\n\t\t\tlost = append(lost, e.Name()+\" (not a regular file)\")\n\t\t\tcontinue\n\t\t}\n\t\tif info.Size() < 0 || info.Size() > reviewLedgerMaxBytes {\n\t\t\tlost = append(lost, e.Name()+\" (record exceeds bound or is unreadable)\")\n\t\t\tcontinue\n\t\t}\n\t\traw, err := readLedgerRawBudgetIn(files, full, &readBudget)\n\t\tif err != nil {\n\t\t\tlost = append(lost, e.Name()+\" (\"+err.Error()+\")\")\n\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tvar run ReviewRun\n\t\tif json.Unmarshal(raw, &run) != nil || run.RunID == \"\" {\n\t\t\tlost = append(lost, e.Name()+\" (not a review run)\")\n\t\t\tcontinue\n\t\t}\n\t\tif verr := validateReviewRunRecord(e.Name(), run); verr != nil {\n\t\t\tlost = append(lost, e.Name()+\" (\"+verr.Error()+\")\")\n\t\t\tcontinue\n\t\t}\n\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, e.Name()))\n\t\tout = append(out, run)\n\t}\n\tsort.Slice(out, func(i, j int) bool {\n\t\ta, _ := time.Parse(time.RFC3339Nano, out[i].StartedAt)\n\t\tb, _ := time.Parse(time.RFC3339Nano, out[j].StartedAt)\n\t\tif !a.Equal(b) {\n\t\t\treturn a.Before(b)\n\t\t}\n\t\treturn out[i].RunID < out[j].RunID\n\t})\n\tsuperseded := map[string]string{}\n\tfor _, run := range out {\n\t\tif run.Supersedes != \"\" {\n\t\t\tsuperseded[run.Supersedes] = run.RunID\n\t\t}\n\t}\n\tfor i := range out {\n\t\tout[i].SupersededBy = superseded[out[i].RunID]\n\t}\n\tchecked := map[string][]DelegatedReviewAttempt{}\n\tfor _, run := range out {\n\t\tif run.LedgerVersion == 1 {\n\t\t\tif _, err := files.Lstat(filepath.Join(s.Root, reviewRunLedgerDir, run.RunID+\".json\")); err != nil {\n\t\t\t\tlost = append(lost, \"missing run witness \"+run.RunID)\n\t\t\t}\n\t\t}\n\t\tif run.AttemptID != \"\" {\n\t\t\tattempts, ok := checked[run.BundleID]\n\t\t\tif !ok {\n\t\t\t\tvar aerr error\n\t\t\t\tattempts, aerr = s.readDelegatedReviewAttempts(run.BundleID, &readBudget)\n\t\t\t\tif aerr != nil {\n\t\t\t\t\tlost = append(lost, aerr.Error())\n\t\t\t\t}\n\t\t\t\tchecked[run.BundleID] = attempts\n\t\t\t}\n\t\t\t// The reservation names the attempt's first agent; a continuation's\n\t\t\t// agent is checked against its own predecessor by the continuation\n\t\t\t// chain (a resume keeps it, a handoff changes it).\n\t\t\tfound := false\n\t\t\tfor _, a := range attempts {\n\t\t\t\tif a.AttemptID == run.AttemptID && a.BundleDigest == run.BundleDigest && a.Scope == run.Scope && (a.Adapter == run.Adapter || run.continues() != \"\") && a.Reason == run.Reason {\n\t\t\t\t\tfound = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !found {\n\t\t\t\tlost = append(lost, \"missing or conflicting attempt reservation \"+run.AttemptID)\n\t\t\t}\n\t\t}\n\t}\n\tfindings, ledgerErr := s.reviewRunLedgerFindings(\"\", &readBudget)\n\tif ledgerErr != nil {\n\t\tlost = append(lost, ledgerErr.Error())\n\t}\n\tlost = append(lost, findings...)\n\tlost = append(lost, s.reviewContinuationFindings(out)...)\n\treturn out, uniqueSorted(lost), nil\n}\n\n// DispatchPlan is what a dispatch will do.\ntype DispatchPlan struct {\n\tprovenance          *ReviewRunProvenance\n\tPendingContinuation *PendingReviewContinuation\n\tprocessTimeout      time.Duration\n\tpredecessor         *ReviewRun\n\t// handoff makes the continuation another agent's, with handoffSection\n\t// appended to the brief (spec pose-delegation-handoff).\n\thandoff        bool\n\thandoffSection string\n\tsession        string\n\t// round is the round of the scope the run reviews, and thread how a\n\t// round after the first relates to the previous round's session.\n\tround  int\n\tthread *ReviewThread\n\t// extraChannels are outputs the interruption classifier reads beside the\n\t// transcript and the output, each on its own: a task's stderr.\n\textraChannels  []string\n\tnotes          string\n\tExisting       *ReviewRun\n\tLimitOf        string\n\tReason         string\n\tPolicyDigest   string\n\tOriginWorktree string\n\tAdapter        string\n\tConfig         ReviewerAdapter\n\tBrief          ReviewBrief\n\tBundle         ReviewBundle\n\tSealedCommit   string\n\tPriorRuns      int\n\t// Effort is the requested effort level; \"\" means the agent's default.\n\tEffort string\n\t// Label, Purpose and Lead are recorded on the run (pose delegate).\n\tLabel   string\n\tPurpose string\n\tLead    string\n\t// Routing is set by pose delegate; without it the run is compared with\n\t// the implementation the plan read (spec pose-delegation-routing R8).\n\tRouting        *DelegationRoutingRecord\n\timplementation *ReviewBundleImplementation\n\t// Warnings are printed before the run starts. SameVendorWarning is set\n\t// when the plan's agent shares the implementation's vendor; a caller that\n\t// named the agent prints it, routing does not (R9).\n\tWarnings          []string\n\tSameVendorWarning string\n\t// OnStart is called once the attempt is reserved and its marker written,\n\t// so a detached run can hand its reference back (spec\n\t// pose-delegated-review-completion-signal R1).\n\tOnStart func(attempt string) error\n}\n\n// Implementation is the identity the plan compares its agent with.\nfunc (p DispatchPlan) Implementation() ReviewBundleImplementation {\n\tswitch {\n\tcase p.Routing != nil:\n\t\treturn p.Routing.Implementation\n\tcase p.implementation != nil:\n\t\treturn *p.implementation\n\t}\n\treturn ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n}\n\n// replanContinuation plans a continuation again at execution, as a resume or\n// as a handoff to the same agent.\nfunc (s Store) replanContinuation(plan DispatchPlan) (DispatchPlan, error) {\n\tvar fresh DispatchPlan\n\tvar err error\n\tif plan.handoff {\n\t\tfresh, err = s.PlanReviewHandoff(plan.predecessor.RunID, plan.Adapter)\n\t} else {\n\t\tfresh, err = s.PlanReviewResume(plan.predecessor.RunID)\n\t}\n\tif err != nil {\n\t\treturn fresh, err\n\t}\n\t// What the caller set on the plan is kept: the hand-back of a detached run\n\t// and the routing that chose its agent (spec pose-delegation-mcp R4).\n\tfresh.OnStart, fresh.Purpose = plan.OnStart, plan.Purpose\n\tif fresh.Routing == nil {\n\t\tfresh.Routing = plan.Routing\n\t}\n\treturn fresh, nil\n}\n\n// PlanImplementationWithLead reads the plan's implementation again with the\n// --lead the caller declared, for a bundle that records none (R4), and records\n// the agent as named.\nfunc (s Store) PlanImplementationWithLead(plan *DispatchPlan, lead string) {\n\tplan.Routing, plan.Warnings, plan.SameVendorWarning = nil, nil, \"\"\n\ts.planImplementation(plan, lead)\n}\n\n// routingAgainstAnotherBundle refuses a routing decision made against an\n// implementation the plan's bundle does not record: the run would record an\n// identity and an independence it did not have (spec pose-delegation-routing\n// R8).\nfunc routingAgainstAnotherBundle(plan DispatchPlan) string {\n\tif plan.Routing == nil || plan.Routing.ImplementationFrom != ImplementationFromBundle {\n\t\treturn \"\"\n\t}\n\tsealed := plan.Bundle.Payload.Implementation\n\tif sealed == nil || !sameImplementation(*sealed, plan.Routing.Implementation) {\n\t\treturn \"the run was routed against another implementation than bundle \" + plan.Bundle.BundleID + \" records; route it again\"\n\t}\n\treturn \"\"\n}\n\n// planImplementation reads the identity a run of bundle is compared with,\n// records the agent as named unless routing chose it (R8, R9), and warns when\n// the policy still declares an identity the bundle overrides (R4).\nfunc (s Store) planImplementation(plan *DispatchPlan, lead string) {\n\timpl := ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n\tfrom := ImplementationFromNone\n\tif policy, _, found, err := s.LoadDelegationPolicy(); err == nil && found {\n\t\tif read, readFrom, err := s.RoutingImplementation(plan.Bundle, policy, lead); err == nil {\n\t\t\timpl, from = read, readFrom\n\t\t}\n\t\tif plan.Bundle.Payload.Implementation != nil && policy.Provenance != nil && policy.Provenance.Implementation != (ModelIdentity{}) {\n\t\t\tplan.Warnings = append(plan.Warnings, \"provenance.implementation in the delegation policy is ignored: bundle \"+plan.Bundle.BundleID+\" records the implementation it was sealed by; remove the policy entry\")\n\t\t}\n\t}\n\tplan.implementation = &impl\n\tif plan.Routing == nil {\n\t\trecord := ExplicitDelegationRoute(plan.Adapter, impl, from)\n\t\tplan.Routing = &record\n\t}\n\tif knownIdentityPart(impl.Vendor) && normalizeIdentityPart(plan.Config.Vendor) == impl.Vendor {\n\t\tplan.SameVendorWarning = \"agent \" + plan.Adapter + \" shares the implementation's vendor (\" + impl.Vendor + \"); the run cannot achieve vendor independence\"\n\t}\n}\n\n// PlanReviewDispatch resolves the bundle, brief and adapter without running.\nfunc (s Store) PlanReviewDispatch(target, kind, notes, adapter string, reason ...string) (DispatchPlan, error) {\n\tif err := validateReviewNotes(notes); err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tif len(reason) > 1 {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: one rerun reason is accepted\")\n\t}\n\twhy := \"\"\n\tif len(reason) == 1 {\n\t\twhy = strings.TrimSpace(reason[0])\n\t}\n\tbrief, err := s.RenderReviewBrief(target, kind, notes)\n\tif err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tbundle, err := s.LoadReviewBundle(brief.BundleID)\n\tif err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tpolicy, found, err := s.LoadReviewersPolicyFor(brief.Kind)\n\tif err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tif !found || len(policy.Adapters) == 0 {\n\t\treturn DispatchPlan{Brief: brief, Bundle: bundle}, ErrNoReviewerAdapter\n\t}\n\tconfig, ok := policy.Adapters[adapter]\n\tif !ok {\n\t\tnames := make([]string, 0, len(policy.Adapters))\n\t\tfor name := range policy.Adapters {\n\t\t\tnames = append(names, name)\n\t\t}\n\t\tsort.Strings(names)\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: no reviewer adapter %q; configured: %s\", adapter, strings.Join(names, \", \"))","numLines":360,"startLine":200,"totalLines":2058}},"tool_result_meta":[{"id":"toolu_017nML14GEpnCreAQB2vfJaa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
