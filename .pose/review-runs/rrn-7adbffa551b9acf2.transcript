{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChR8m7tST2wNdZiPL1x7Q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MKLiZ6aVtmEZqoKaVaetQJ","name":"Read","input":{"file_path":"/var/tmp/pose-work-go/pose-review-run-93b9b9511d1567d3fc5c2c9979b76703/worktree/pose-mcp/internal/pose/review_adapter_containment.go","offset":230,"limit":530},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9660,"cache_read_input_tokens":47177,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9660},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"165ae3ba-2a9a-4089-a122-30647d26434b","timestamp":"2026-11-26T07:20:27.724Z","request_id":"req_011ChR8m7iGuvScSQi5MjwFE","wire_tool_inputs":{"toolu_01MKLiZ6aVtmEZqoKaVaetQJ":{"file_path":"/var/tmp/pose-work-go/pose-review-run-93b9b9511d1567d3fc5c2c9979b76703/worktree/pose-mcp/internal/pose/review_adapter_containment.go","offset":230,"limit":530}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MKLiZ6aVtmEZqoKaVaetQJ","type":"tool_result","content":"230\t\t\t\t\treturn fmt.Errorf(\"adapter %s: explicit max_runs_per_bundle must be 1..100; omit for default 3\", name)\n231\t\t\t\t}\n232\t\t\t}\n233\t\t}\n234\t\treturn nil\n235\t}\n236\t\n237\tfunc reviewAdapterEnvironment(a ReviewerAdapter, tmp, brief, notes string) ([]string, []string, error) {\n238\t\tnames := []string{\"PATH\", \"LANG\", \"LC_ALL\", \"LC_CTYPE\", \"SYSTEMROOT\", \"WINDIR\"}\n239\t\tif a.Containment == nil {\n240\t\t\tnames = append(names, \"HOME\", \"USERPROFILE\")\n241\t\t} else {\n242\t\t\tnames = append(names, a.Containment.Environment...)\n243\t\t}\n244\t\tvalues := map[string]string{}\n245\t\tput := func(name, value string) {\n246\t\t\tif runtime.GOOS == \"windows\" {\n247\t\t\t\tname = strings.ToUpper(name)\n248\t\t\t}\n249\t\t\tvalues[name] = value\n250\t\t}\n251\t\tfor _, name := range names {\n252\t\t\tif value, ok := os.LookupEnv(name); ok {\n253\t\t\t\tput(name, value)\n254\t\t\t}\n255\t\t}\n256\t\tsecrets := []string{}\n257\t\tif a.Containment != nil {\n258\t\t\tfor _, name := range a.Containment.Credentials {\n259\t\t\t\tif value, ok := os.LookupEnv(name); ok && value != \"\" {\n260\t\t\t\t\tif len(value) < 8 || len(value) > 64<<10 {\n261\t\t\t\t\t\treturn nil, nil, fmt.Errorf(\"authorized credential value has unsupported length\")\n262\t\t\t\t\t}\n263\t\t\t\t\tif strings.Contains(brief, value) || strings.Contains(notes, value) {\n264\t\t\t\t\t\treturn nil, nil, fmt.Errorf(\"brief/notes contain an authorized credential; refusing execution\")\n265\t\t\t\t\t}\n266\t\t\t\t\tput(name, value)\n267\t\t\t\t\tsecrets = append(secrets, value)\n268\t\t\t\t}\n269\t\t\t}\n270\t\t\tvalues[\"HOME\"] = tmp\n271\t\t\tvalues[\"USERPROFILE\"] = tmp\n272\t\t}\n273\t\tvalues[\"TMPDIR\"] = tmp\n274\t\tvalues[\"TMP\"] = tmp\n275\t\tvalues[\"TEMP\"] = tmp\n276\t\tkeys := make([]string, 0, len(values))\n277\t\tfor k := range values {\n278\t\t\tkeys = append(keys, k)\n279\t\t}\n280\t\tsort.Strings(keys)\n281\t\tenv := make([]string, 0, len(keys))\n282\t\tfor _, k := range keys {\n283\t\t\tenv = append(env, k+\"=\"+values[k])\n284\t\t}\n285\t\t// Replace overlapping credentials longest first so no residual suffix leaks.\n286\t\tsort.Slice(secrets, func(i, j int) bool { return len(secrets[i]) > len(secrets[j]) })\n287\t\treturn env, secrets, nil\n288\t}\n289\t\n290\t// A single longest-first replacement pass handles overlapping session and\n291\t// credential values without rescanning placeholders. The writer refuses growth\n292\t// beyond the byte budget even for a one-byte session repeated across a stream.\n293\tfunc redactReviewCapture(raw []byte, secrets []string, session string, limit int64) ([]byte, error) {\n294\t\treplacements := map[string]string{}\n295\t\tfor _, secret := range secrets {\n296\t\t\treplacements[secret] = \"[credential]\"\n297\t\t}\n298\t\tif session != \"\" {\n299\t\t\tif _, exists := replacements[session]; !exists {\n300\t\t\t\treplacements[session] = \"[private-session]\"\n301\t\t\t}\n302\t\t}\n303\t\tkeys := make([]string, 0, len(replacements))\n304\t\tfor key := range replacements {\n305\t\t\tkeys = append(keys, key)\n306\t\t}\n307\t\tsort.Slice(keys, func(i, j int) bool {\n308\t\t\tif len(keys[i]) == len(keys[j]) {\n309\t\t\t\treturn keys[i] < keys[j]\n310\t\t\t}\n311\t\t\treturn len(keys[i]) > len(keys[j])\n312\t\t})\n313\t\tpairs := make([]string, 0, len(keys)*2)\n314\t\tfor _, key := range keys {\n315\t\t\tpairs = append(pairs, key, replacements[key])\n316\t\t}\n317\t\tw := &reviewRedactionWriter{limit: limit}\n318\t\tif _, err := strings.NewReplacer(pairs...).WriteString(w, string(raw)); err != nil {\n319\t\t\treturn nil, err\n320\t\t}\n321\t\treturn w.buf.Bytes(), nil\n322\t}\n323\t\n324\ttype reviewRedactionWriter struct {\n325\t\tbuf   bytes.Buffer\n326\t\tlimit int64\n327\t}\n328\t\n329\tfunc (w *reviewRedactionWriter) Write(p []byte) (int, error) {\n330\t\tif int64(w.buf.Len())+int64(len(p)) > w.limit {\n331\t\t\treturn 0, fmt.Errorf(\"redacted capture exceeds byte budget\")\n332\t\t}\n333\t\treturn w.buf.Write(p)\n334\t}\n335\t\n336\t// Shared writer bounds concurrent stdout/stderr as one budget. Cancellation is\n337\t// triggered on the first excess byte; subsequent writes do not grow storage.\n338\ttype reviewBoundedCapture struct {\n339\t\tmu       sync.Mutex\n340\t\tbuf      bytes.Buffer\n341\t\tlimit    int64\n342\t\toverflow bool\n343\t\tcancel   context.CancelFunc\n344\t}\n345\t\n346\tfunc (w *reviewBoundedCapture) Write(p []byte) (int, error) {\n347\t\tw.mu.Lock()\n348\t\tdefer w.mu.Unlock()\n349\t\tn := len(p)\n350\t\tremaining := w.limit - int64(w.buf.Len())\n351\t\tif int64(n) > remaining {\n352\t\t\tw.buf.Write(p[:int(remaining)])\n353\t\t\tw.overflow = true\n354\t\t\tif w.cancel != nil {\n355\t\t\t\tw.cancel()\n356\t\t\t}\n357\t\t} else {\n358\t\t\tw.buf.Write(p)\n359\t\t}\n360\t\treturn n, nil\n361\t}\n362\tfunc (w *reviewBoundedCapture) result() ([]byte, bool) {\n363\t\tw.mu.Lock()\n364\t\tdefer w.mu.Unlock()\n365\t\treturn append([]byte(nil), w.buf.Bytes()...), w.overflow\n366\t}\n367\t\n368\t// ReadReviewAdapterFile refuses links/special files before opening; the platform\n369\t// opener also uses nonblocking/no-follow semantics where available.\n370\tfunc ReadReviewAdapterFile(path string, limit int64) ([]byte, error) {\n371\t\tbefore, err := os.Lstat(path)\n372\t\tif err != nil {\n373\t\t\treturn nil, err\n374\t\t}\n375\t\tif !before.Mode().IsRegular() || before.Size() > limit {\n376\t\t\treturn nil, fmt.Errorf(\"adapter file must be regular, non-symlink and at most %d bytes\", limit)\n377\t\t}\n378\t\tf, err := openReviewAdapterFile(path)\n379\t\tif err != nil {\n380\t\t\treturn nil, err\n381\t\t}\n382\t\tdefer f.Close()\n383\t\tafter, err := f.Stat()\n384\t\tif err != nil {\n385\t\t\treturn nil, err\n386\t\t}\n387\t\tif !after.Mode().IsRegular() || !os.SameFile(before, after) {\n388\t\t\treturn nil, fmt.Errorf(\"adapter file changed identity\")\n389\t\t}\n390\t\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n391\t\tif err != nil {\n392\t\t\treturn nil, err\n393\t\t}\n394\t\tif int64(len(raw)) > limit {\n395\t\t\treturn nil, fmt.Errorf(\"adapter file exceeds %d bytes\", limit)\n396\t\t}\n397\t\tlast, err := os.Lstat(path)\n398\t\tif err != nil || !os.SameFile(after, last) || last.Size() != int64(len(raw)) {\n399\t\t\treturn nil, fmt.Errorf(\"adapter file changed while reading\")\n400\t\t}\n401\t\treturn raw, nil\n402\t}\n403\t\n404\tfunc readReviewAdapterOutput(root *os.Root, limit int64) ([]byte, error) {\n405\t\treturn readReviewRootFile(root, \"output.txt\", limit)\n406\t}\n407\tfunc readReviewRootFile(root *os.Root, path string, limit int64) ([]byte, error) {\n408\t\tbefore, err := root.Lstat(path)\n409\t\tif err != nil {\n410\t\t\treturn nil, err\n411\t\t}\n412\t\tif !before.Mode().IsRegular() || before.Size() > limit {\n413\t\t\treturn nil, fmt.Errorf(\"unsafe or oversized output file\")\n414\t\t}\n415\t\tf, err := openReviewRootFile(root, path)\n416\t\tif err != nil {\n417\t\t\treturn nil, err\n418\t\t}\n419\t\tdefer f.Close()\n420\t\tafter, err := f.Stat()\n421\t\tif err != nil {\n422\t\t\treturn nil, err\n423\t\t}\n424\t\tif !after.Mode().IsRegular() || !os.SameFile(before, after) {\n425\t\t\treturn nil, fmt.Errorf(\"output identity changed\")\n426\t\t}\n427\t\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n428\t\tif err != nil {\n429\t\t\treturn nil, err\n430\t\t}\n431\t\tif int64(len(raw)) > limit {\n432\t\t\treturn nil, fmt.Errorf(\"output exceeds byte budget\")\n433\t\t}\n434\t\tlast, err := root.Lstat(path)\n435\t\tif err != nil || !os.SameFile(last, after) || last.Size() != int64(len(raw)) {\n436\t\t\treturn nil, fmt.Errorf(\"output changed while reading\")\n437\t\t}\n438\t\treturn raw, nil\n439\t}\n440\t\n441\tfunc validateReviewNotes(notes string) error {\n442\t\tif len(notes) > ReviewNotesMaxBytes || !utf8.ValidString(notes) || strings.ContainsRune(notes, 0) {\n443\t\t\treturn fmt.Errorf(\"review notes must be valid UTF-8, without NUL, at most %d bytes\", ReviewNotesMaxBytes)\n444\t\t}\n445\t\treturn nil\n446\t}\n447\t\n448\t// reviewCleanupOwnership holds descriptors opened before the adapter starts.\n449\t// Git's recursive worktree-remove command takes a path, so it cannot safely\n450\t// delete after a hostile rename. Workspace and exact registration are instead\n451\t// removed independently through confined roots. No global prune is performed.\n452\ttype reviewCleanupOwnership struct {\n453\t\tremoved          bool\n454\t\truntime          *os.Root\n455\t\tregistry         *os.Root\n456\t\tregistration     string\n457\t\tregistrationInfo os.FileInfo\n458\t\tbacklink         string\n459\t\t// inventoryBytes bounds the bytes the worktree's cleanup may remove: the\n460\t\t// checked-out commit's tree plus the snapshot margin, read from the\n461\t\t// coordinator repository when the worktree is registered (spec\n462\t\t// pose-git-snapshot-budget-scales-with-the-tree).\n463\t\tinventoryBytes       int64\n464\t\tgitlinkMetadata      os.FileInfo\n465\t\tgitlinkMetadataBytes int64\n466\t}\n467\t\n468\tfunc (s Store) captureReviewCleanupOwnership(runtime *os.Root, worktree string, marker []byte) (*reviewCleanupOwnership, error) {\n469\t\traw, err := snapshotGit(s.Root, \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\")\n470\t\tif err != nil {\n471\t\t\treturn nil, err\n472\t\t}\n473\t\tparent := filepath.Join(strings.TrimSpace(string(raw)), \"worktrees\")\n474\t\tpath := strings.TrimSpace(strings.TrimPrefix(string(marker), \"gitdir: \"))\n475\t\tif !strings.HasPrefix(string(marker), \"gitdir: \") || !filepath.IsAbs(path) || filepath.Dir(path) != parent {\n476\t\t\treturn nil, fmt.Errorf(\"unexpected worktree registration\")\n477\t\t}\n478\t\tregistry, err := os.OpenRoot(parent)\n479\t\tif err != nil {\n480\t\t\treturn nil, err\n481\t\t}\n482\t\tname := filepath.Base(path)\n483\t\tinfo, err := registry.Lstat(name)\n484\t\tif err != nil || !info.IsDir() {\n485\t\t\tregistry.Close()\n486\t\t\treturn nil, fmt.Errorf(\"worktree registration unavailable\")\n487\t\t}\n488\t\to := &reviewCleanupOwnership{runtime: runtime, registry: registry, registration: name, registrationInfo: info, backlink: filepath.Join(worktree, \".git\"), inventoryBytes: gitSnapshotMarginBytes}\n489\t\tif head, err := registry.ReadFile(filepath.Join(name, \"HEAD\")); err == nil {\n490\t\t\tif commit := strings.TrimSpace(string(head)); !strings.HasPrefix(commit, \"ref:\") && commit != \"\" {\n491\t\t\t\tif listing, err := listCommittedTree(s.Root, commit); err == nil {\n492\t\t\t\t\to.inventoryBytes = gitSnapshotBudget(gitCommittedTreeBytes(listing))\n493\t\t\t\t}\n494\t\t\t}\n495\t\t}\n496\t\tchild, err := registry.OpenRoot(name)\n497\t\tif err != nil {\n498\t\t\tregistry.Close()\n499\t\t\treturn nil, err\n500\t\t}\n501\t\tbacklink, err := readReviewRootFile(child, \"gitdir\", 4096)\n502\t\tchild.Close()\n503\t\tif err != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n504\t\t\tregistry.Close()\n505\t\t\treturn nil, fmt.Errorf(\"worktree registration backlink differs\")\n506\t\t}\n507\t\treturn o, nil\n508\t}\n509\t\n510\tfunc (s Store) cleanupReviewResources(tmp string, owned os.FileInfo, worktree string, worktreeOwned os.FileInfo, gitMarker []byte, ownership ...*reviewCleanupOwnership) error {\n511\t\tvar o *reviewCleanupOwnership\n512\t\tif len(ownership) > 0 {\n513\t\t\to = ownership[0]\n514\t\t}\n515\t\tcurrent, err := os.Lstat(tmp)\n516\t\tif errors.Is(err, os.ErrNotExist) {\n517\t\t\tif (o != nil && !o.removed) || (o == nil && worktreeOwned != nil) {\n518\t\t\t\treturn fmt.Errorf(\"runtime path disappeared without confirmed cleanup; resources may remain\")\n519\t\t\t}\n520\t\t\treturn nil\n521\t\t}\n522\t\tif err != nil || !current.IsDir() || !os.SameFile(owned, current) {\n523\t\t\treturn fmt.Errorf(\"cleanup refused: runtime directory identity changed\")\n524\t\t}\n525\t\n526\t\tvar root *os.Root\n527\t\tif o != nil {\n528\t\t\troot = o.runtime\n529\t\t} else {\n530\t\t\troot, err = os.OpenRoot(tmp)\n531\t\t\tif err != nil {\n532\t\t\t\treturn fmt.Errorf(\"runtime cleanup root unavailable\")\n533\t\t\t}\n534\t\t\tdefer root.Close()\n535\t\t}\n536\t\tstat, err := root.Stat(\".\")\n537\t\tif err != nil || !os.SameFile(owned, stat) {\n538\t\t\treturn fmt.Errorf(\"runtime cleanup root identity changed\")\n539\t\t}\n540\t\tif worktreeOwned != nil {\n541\t\t\tinfo, err := root.Lstat(\"worktree\")\n542\t\t\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n543\t\t\t\treturn fmt.Errorf(\"worktree cleanup unavailable\")\n544\t\t\t}\n545\t\t\tif err == nil {\n546\t\t\t\tmarker, e := readReviewRootFile(root, \"worktree/.git\", 4096)\n547\t\t\t\tif e != nil || !info.IsDir() || !os.SameFile(worktreeOwned, info) || !bytes.Equal(marker, gitMarker) {\n548\t\t\t\t\treturn fmt.Errorf(\"cleanup refused: worktree identity changed\")\n549\t\t\t\t}\n550\t\t\t}\n551\t\t\tif o == nil || o.registry == nil {\n552\t\t\t\treturn fmt.Errorf(\"cleanup registration ownership unavailable; resources retained\")\n553\t\t\t}\n554\t\t\tinfo, e := o.registry.Lstat(o.registration)\n555\t\t\tif e != nil || !info.IsDir() || !os.SameFile(info, o.registrationInfo) {\n556\t\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n557\t\t\t}\n558\t\t\tregistration, e := o.registry.OpenRoot(o.registration)\n559\t\t\tif e != nil {\n560\t\t\t\treturn fmt.Errorf(\"cleanup registration unavailable\")\n561\t\t\t}\n562\t\t\tdefer registration.Close()\n563\t\t\tinfo, e = registration.Stat(\".\")\n564\t\t\tif e != nil || !os.SameFile(info, o.registrationInfo) {\n565\t\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n566\t\t\t}\n567\t\t\tbacklink, e := readReviewRootFile(registration, \"gitdir\", 4096)\n568\t\t\tif e != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n569\t\t\t\treturn fmt.Errorf(\"cleanup registration backlink changed\")\n570\t\t\t}\n571\t\t\tfor _, lock := range []string{\"locked\", \"index.lock\", \"HEAD.lock\"} {\n572\t\t\t\tif _, e := registration.Lstat(lock); !errors.Is(e, os.ErrNotExist) {\n573\t\t\t\t\treturn fmt.Errorf(\"worktree registration has a live or unknown lock; resources retained\")\n574\t\t\t\t}\n575\t\t\t}\n576\t\t\tif err == nil {\n577\t\t\t\ttree, e := root.OpenRoot(\"worktree\")\n578\t\t\t\tif e != nil {\n579\t\t\t\t\treturn fmt.Errorf(\"worktree cleanup root unavailable\")\n580\t\t\t\t}\n581\t\t\t\tinfo, e := tree.Stat(\".\")\n582\t\t\t\tif e != nil || !os.SameFile(info, worktreeOwned) {\n583\t\t\t\t\ttree.Close()\n584\t\t\t\t\treturn fmt.Errorf(\"worktree cleanup identity changed\")\n585\t\t\t\t}\n586\t\t\t\tlimit := gitSnapshotMarginBytes\n587\t\t\t\tif o.inventoryBytes > limit {\n588\t\t\t\t\tlimit = o.inventoryBytes\n589\t\t\t\t}\n590\t\t\t\te = removeReviewOwnedContents(tree, 100000, limit)\n591\t\t\t\ttree.Close()\n592\t\t\t\tif e != nil {\n593\t\t\t\t\treturn e\n594\t\t\t\t}\n595\t\t\t\tif e := root.Remove(\"worktree\"); e != nil && !errors.Is(e, os.ErrNotExist) {\n596\t\t\t\t\treturn fmt.Errorf(\"worktree cleanup incomplete\")\n597\t\t\t\t}\n598\t\t\t}\n599\t\t\tif e := removeReviewOwnedContents(registration, 1024, 256<<20); e != nil {\n600\t\t\t\treturn e\n601\t\t\t}\n602\t\t\tregistration.Close()\n603\t\t\tif e := o.registry.Remove(o.registration); e != nil && !errors.Is(e, os.ErrNotExist) {\n604\t\t\t\treturn fmt.Errorf(\"worktree registration cleanup incomplete\")\n605\t\t\t}\n606\t\t} else if _, e := root.Lstat(\"worktree\"); !errors.Is(e, os.ErrNotExist) {\n607\t\t\treturn fmt.Errorf(\"partial worktree setup has no verified ownership; resources retained\")\n608\t\t}\n609\t\tif o != nil && o.gitlinkMetadata != nil {\n610\t\t\tif err := removeReviewGitlinkMetadata(root, o.gitlinkMetadata, o.gitlinkMetadataBytes); err != nil {\n611\t\t\t\treturn err\n612\t\t\t}\n613\t\t}\n614\t\tif err := removeReviewGoBuildLeftovers(root); err != nil {\n615\t\t\treturn err\n616\t\t}\n617\t\tif err := removeReviewOwnedContents(root, reviewRuntimeMaxEntries, 128<<20); err != nil {\n618\t\t\treturn err\n619\t\t}\n620\t\tcurrent, err = os.Lstat(tmp)\n621\t\tif err != nil || !os.SameFile(owned, current) {\n622\t\t\treturn fmt.Errorf(\"runtime path changed during cleanup; replacement retained\")\n623\t\t}\n624\t\tif err := os.Remove(tmp); err != nil && !errors.Is(err, os.ErrNotExist) {\n625\t\t\treturn fmt.Errorf(\"runtime directory cleanup incomplete\")\n626\t\t}\n627\t\tif o != nil {\n628\t\t\to.removed = true\n629\t\t}\n630\t\treturn nil\n631\t}\n632\t\n633\t// Private gitlink stores are charged separately from the adapter's runtime\n634\t// output. Both the opened directory and the removal target must be the\n635\t// directory setup created inside the operation root.\n636\tfunc removeReviewGitlinkMetadata(root *os.Root, owned os.FileInfo, limit int64) error {\n637\t\tdir, err := root.OpenRoot(reviewGitlinkMetadataDir)\n638\t\tif err != nil {\n639\t\t\treturn fmt.Errorf(\"private gitlink metadata cleanup unavailable\")\n640\t\t}\n641\t\tdefer dir.Close()\n642\t\tinfo, err := dir.Stat(\".\")\n643\t\tif err != nil || !os.SameFile(owned, info) {\n644\t\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n645\t\t}\n646\t\tif err := removeReviewOwnedContents(dir, 100000, limit); err != nil {\n647\t\t\treturn err\n648\t\t}\n649\t\tinfo, err = root.Lstat(reviewGitlinkMetadataDir)\n650\t\tif err != nil || !os.SameFile(owned, info) {\n651\t\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n652\t\t}\n653\t\tdir.Close()\n654\t\tif err := root.Remove(reviewGitlinkMetadataDir); err != nil {\n655\t\t\treturn fmt.Errorf(\"private gitlink metadata cleanup incomplete\")\n656\t\t}\n657\t\treturn nil\n658\t}\n659\t\n660\t// reviewGoBuildDir names the temporary build directory the Go toolchain\n661\t// creates under the TMPDIR the engine gives a review run.\n662\tvar reviewGoBuildDir = regexp.MustCompile(`^go-build[0-9]+$`)\n663\t\n664\t// reviewGoBuildBeforeOpen runs after a go-build name is listed and before it\n665\t// is opened, reviewGoBuildAfterContents after the directory is emptied and\n666\t// before its name is checked again, and reviewGoBuildBeforeRemove between that\n667\t// check and the removal; tests use them to change the name there.\n668\tvar (\n669\t\treviewGoBuildBeforeOpen    = func(string) {}\n670\t\treviewGoBuildAfterContents = func(string) {}\n671\t\treviewGoBuildBeforeRemove  = func(string) {}\n672\t)\n673\t\n674\t// removeReviewGoBuildLeftovers removes the Go build directories a reviewer's\n675\t// interrupted `go test` or `go build` left at the top of the run's runtime\n676\t// directory, each under its own bounded inventory, before the runtime's own\n677\t// inventory, which a single test binary can exceed (spec\n678\t// pose-review-cleanup-removes-go-build-leftovers). Only a real directory is\n679\t// removed; the platform implementation opens it without blocking and only as\n680\t// a directory, so a link, a FIFO or any other entry stays for the runtime\n681\t// inventory to judge.\n682\tfunc removeReviewGoBuildLeftovers(root *os.Root) error {\n683\t\t// The top level is read in bounded batches and each go-build directory\n684\t\t// is removed as it is read, so nothing accumulates; only the other\n685\t\t// entries, which the runtime inventory will judge, count against its\n686\t\t// bound (review rounds 5 and 6, N6 and N10).\n687\t\tdir, err := root.Open(\".\")\n688\t\tif err != nil {\n689\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n690\t\t}\n691\t\tdefer dir.Close()\n692\t\tothers := 0\n693\t\tfor {\n694\t\t\tbatch, err := dir.Readdirnames(256)\n695\t\t\tfor _, name := range batch {\n696\t\t\t\tif !reviewGoBuildDir.MatchString(name) {\n697\t\t\t\t\tothers++\n698\t\t\t\t\tif others > reviewRuntimeMaxEntries {\n699\t\t\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n700\t\t\t\t\t}\n701\t\t\t\t\tcontinue\n702\t\t\t\t}\n703\t\t\t\tif err := removeReviewGoBuildDir(root, name); err != nil {\n704\t\t\t\t\treturn err\n705\t\t\t\t}\n706\t\t\t}\n707\t\t\tif len(batch) == 0 {\n708\t\t\t\tif err == nil || errors.Is(err, io.EOF) {\n709\t\t\t\t\treturn nil\n710\t\t\t\t}\n711\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n712\t\t\t}\n713\t\t}\n714\t}\n715\t\n716\t// reviewRuntimeMaxEntries is the runtime inventory's own entry bound.\n717\tconst reviewRuntimeMaxEntries = 4096\n718\t\n719\tfunc removeReviewOwnedContents(root *os.Root, maxFiles int, maxBytes int64) error {\n720\t\tpaths := []string{}\n721\t\tvar total int64\n722\t\terr := fs.WalkDir(root.FS(), \".\", func(path string, d fs.DirEntry, err error) error {\n723\t\t\tif err != nil {\n724\t\t\t\treturn err\n725\t\t\t}\n726\t\t\tif path == \".\" {\n727\t\t\t\treturn nil\n728\t\t\t}\n729\t\t\tif len(paths) >= maxFiles || strings.Count(path, \"/\") > 128 {\n730\t\t\t\treturn fmt.Errorf(\"cleanup inventory exceeds coverage\")\n731\t\t\t}\n732\t\t\tinfo, err := d.Info()\n733\t\t\tif err != nil {\n734\t\t\t\treturn err\n735\t\t\t}\n736\t\t\tif info.Mode().IsRegular() {\n737\t\t\t\ttotal += info.Size()\n738\t\t\t\tif total > maxBytes {\n739\t\t\t\t\treturn fmt.Errorf(\"cleanup inventory exceeds bytes\")\n740\t\t\t\t}\n741\t\t\t}\n742\t\t\tpaths = append(paths, path)\n743\t\t\treturn nil\n744\t\t})\n745\t\tif err != nil {\n746\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n747\t\t}\n748\t\tfor i := len(paths) - 1; i >= 0; i-- {\n749\t\t\tif err := root.Remove(paths[i]); err != nil && !errors.Is(err, os.ErrNotExist) {\n750\t\t\t\treturn fmt.Errorf(\"runtime cleanup incomplete; resources retained\")\n751\t\t\t}\n752\t\t}\n753\t\treturn nil\n754\t}\n755\t\n756\tfunc reviewSafetyConflict(run ReviewRun) string {\n757\t\tif run.Safety == nil {\n758\t\t\treturn \"\"\n759\t\t} // Historical runs have no invented observations."}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"c98e7752-6a90-4812-9599-886d7c5c5dfc","timestamp":"2026-11-26T07:20:27.731Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-93b9b9511d1567d3fc5c2c9979b76703/worktree/pose-mcp/internal/pose/review_adapter_containment.go","content":"\t\t\t\treturn fmt.Errorf(\"adapter %s: explicit max_runs_per_bundle must be 1..100; omit for default 3\", name)\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc reviewAdapterEnvironment(a ReviewerAdapter, tmp, brief, notes string) ([]string, []string, error) {\n\tnames := []string{\"PATH\", \"LANG\", \"LC_ALL\", \"LC_CTYPE\", \"SYSTEMROOT\", \"WINDIR\"}\n\tif a.Containment == nil {\n\t\tnames = append(names, \"HOME\", \"USERPROFILE\")\n\t} else {\n\t\tnames = append(names, a.Containment.Environment...)\n\t}\n\tvalues := map[string]string{}\n\tput := func(name, value string) {\n\t\tif runtime.GOOS == \"windows\" {\n\t\t\tname = strings.ToUpper(name)\n\t\t}\n\t\tvalues[name] = value\n\t}\n\tfor _, name := range names {\n\t\tif value, ok := os.LookupEnv(name); ok {\n\t\t\tput(name, value)\n\t\t}\n\t}\n\tsecrets := []string{}\n\tif a.Containment != nil {\n\t\tfor _, name := range a.Containment.Credentials {\n\t\t\tif value, ok := os.LookupEnv(name); ok && value != \"\" {\n\t\t\t\tif len(value) < 8 || len(value) > 64<<10 {\n\t\t\t\t\treturn nil, nil, fmt.Errorf(\"authorized credential value has unsupported length\")\n\t\t\t\t}\n\t\t\t\tif strings.Contains(brief, value) || strings.Contains(notes, value) {\n\t\t\t\t\treturn nil, nil, fmt.Errorf(\"brief/notes contain an authorized credential; refusing execution\")\n\t\t\t\t}\n\t\t\t\tput(name, value)\n\t\t\t\tsecrets = append(secrets, value)\n\t\t\t}\n\t\t}\n\t\tvalues[\"HOME\"] = tmp\n\t\tvalues[\"USERPROFILE\"] = tmp\n\t}\n\tvalues[\"TMPDIR\"] = tmp\n\tvalues[\"TMP\"] = tmp\n\tvalues[\"TEMP\"] = tmp\n\tkeys := make([]string, 0, len(values))\n\tfor k := range values {\n\t\tkeys = append(keys, k)\n\t}\n\tsort.Strings(keys)\n\tenv := make([]string, 0, len(keys))\n\tfor _, k := range keys {\n\t\tenv = append(env, k+\"=\"+values[k])\n\t}\n\t// Replace overlapping credentials longest first so no residual suffix leaks.\n\tsort.Slice(secrets, func(i, j int) bool { return len(secrets[i]) > len(secrets[j]) })\n\treturn env, secrets, nil\n}\n\n// A single longest-first replacement pass handles overlapping session and\n// credential values without rescanning placeholders. The writer refuses growth\n// beyond the byte budget even for a one-byte session repeated across a stream.\nfunc redactReviewCapture(raw []byte, secrets []string, session string, limit int64) ([]byte, error) {\n\treplacements := map[string]string{}\n\tfor _, secret := range secrets {\n\t\treplacements[secret] = \"[credential]\"\n\t}\n\tif session != \"\" {\n\t\tif _, exists := replacements[session]; !exists {\n\t\t\treplacements[session] = \"[private-session]\"\n\t\t}\n\t}\n\tkeys := make([]string, 0, len(replacements))\n\tfor key := range replacements {\n\t\tkeys = append(keys, key)\n\t}\n\tsort.Slice(keys, func(i, j int) bool {\n\t\tif len(keys[i]) == len(keys[j]) {\n\t\t\treturn keys[i] < keys[j]\n\t\t}\n\t\treturn len(keys[i]) > len(keys[j])\n\t})\n\tpairs := make([]string, 0, len(keys)*2)\n\tfor _, key := range keys {\n\t\tpairs = append(pairs, key, replacements[key])\n\t}\n\tw := &reviewRedactionWriter{limit: limit}\n\tif _, err := strings.NewReplacer(pairs...).WriteString(w, string(raw)); err != nil {\n\t\treturn nil, err\n\t}\n\treturn w.buf.Bytes(), nil\n}\n\ntype reviewRedactionWriter struct {\n\tbuf   bytes.Buffer\n\tlimit int64\n}\n\nfunc (w *reviewRedactionWriter) Write(p []byte) (int, error) {\n\tif int64(w.buf.Len())+int64(len(p)) > w.limit {\n\t\treturn 0, fmt.Errorf(\"redacted capture exceeds byte budget\")\n\t}\n\treturn w.buf.Write(p)\n}\n\n// Shared writer bounds concurrent stdout/stderr as one budget. Cancellation is\n// triggered on the first excess byte; subsequent writes do not grow storage.\ntype reviewBoundedCapture struct {\n\tmu       sync.Mutex\n\tbuf      bytes.Buffer\n\tlimit    int64\n\toverflow bool\n\tcancel   context.CancelFunc\n}\n\nfunc (w *reviewBoundedCapture) Write(p []byte) (int, error) {\n\tw.mu.Lock()\n\tdefer w.mu.Unlock()\n\tn := len(p)\n\tremaining := w.limit - int64(w.buf.Len())\n\tif int64(n) > remaining {\n\t\tw.buf.Write(p[:int(remaining)])\n\t\tw.overflow = true\n\t\tif w.cancel != nil {\n\t\t\tw.cancel()\n\t\t}\n\t} else {\n\t\tw.buf.Write(p)\n\t}\n\treturn n, nil\n}\nfunc (w *reviewBoundedCapture) result() ([]byte, bool) {\n\tw.mu.Lock()\n\tdefer w.mu.Unlock()\n\treturn append([]byte(nil), w.buf.Bytes()...), w.overflow\n}\n\n// ReadReviewAdapterFile refuses links/special files before opening; the platform\n// opener also uses nonblocking/no-follow semantics where available.\nfunc ReadReviewAdapterFile(path string, limit int64) ([]byte, error) {\n\tbefore, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif !before.Mode().IsRegular() || before.Size() > limit {\n\t\treturn nil, fmt.Errorf(\"adapter file must be regular, non-symlink and at most %d bytes\", limit)\n\t}\n\tf, err := openReviewAdapterFile(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer f.Close()\n\tafter, err := f.Stat()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif !after.Mode().IsRegular() || !os.SameFile(before, after) {\n\t\treturn nil, fmt.Errorf(\"adapter file changed identity\")\n\t}\n\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif int64(len(raw)) > limit {\n\t\treturn nil, fmt.Errorf(\"adapter file exceeds %d bytes\", limit)\n\t}\n\tlast, err := os.Lstat(path)\n\tif err != nil || !os.SameFile(after, last) || last.Size() != int64(len(raw)) {\n\t\treturn nil, fmt.Errorf(\"adapter file changed while reading\")\n\t}\n\treturn raw, nil\n}\n\nfunc readReviewAdapterOutput(root *os.Root, limit int64) ([]byte, error) {\n\treturn readReviewRootFile(root, \"output.txt\", limit)\n}\nfunc readReviewRootFile(root *os.Root, path string, limit int64) ([]byte, error) {\n\tbefore, err := root.Lstat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif !before.Mode().IsRegular() || before.Size() > limit {\n\t\treturn nil, fmt.Errorf(\"unsafe or oversized output file\")\n\t}\n\tf, err := openReviewRootFile(root, path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer f.Close()\n\tafter, err := f.Stat()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif !after.Mode().IsRegular() || !os.SameFile(before, after) {\n\t\treturn nil, fmt.Errorf(\"output identity changed\")\n\t}\n\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif int64(len(raw)) > limit {\n\t\treturn nil, fmt.Errorf(\"output exceeds byte budget\")\n\t}\n\tlast, err := root.Lstat(path)\n\tif err != nil || !os.SameFile(last, after) || last.Size() != int64(len(raw)) {\n\t\treturn nil, fmt.Errorf(\"output changed while reading\")\n\t}\n\treturn raw, nil\n}\n\nfunc validateReviewNotes(notes string) error {\n\tif len(notes) > ReviewNotesMaxBytes || !utf8.ValidString(notes) || strings.ContainsRune(notes, 0) {\n\t\treturn fmt.Errorf(\"review notes must be valid UTF-8, without NUL, at most %d bytes\", ReviewNotesMaxBytes)\n\t}\n\treturn nil\n}\n\n// reviewCleanupOwnership holds descriptors opened before the adapter starts.\n// Git's recursive worktree-remove command takes a path, so it cannot safely\n// delete after a hostile rename. Workspace and exact registration are instead\n// removed independently through confined roots. No global prune is performed.\ntype reviewCleanupOwnership struct {\n\tremoved          bool\n\truntime          *os.Root\n\tregistry         *os.Root\n\tregistration     string\n\tregistrationInfo os.FileInfo\n\tbacklink         string\n\t// inventoryBytes bounds the bytes the worktree's cleanup may remove: the\n\t// checked-out commit's tree plus the snapshot margin, read from the\n\t// coordinator repository when the worktree is registered (spec\n\t// pose-git-snapshot-budget-scales-with-the-tree).\n\tinventoryBytes       int64\n\tgitlinkMetadata      os.FileInfo\n\tgitlinkMetadataBytes int64\n}\n\nfunc (s Store) captureReviewCleanupOwnership(runtime *os.Root, worktree string, marker []byte) (*reviewCleanupOwnership, error) {\n\traw, err := snapshotGit(s.Root, \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tparent := filepath.Join(strings.TrimSpace(string(raw)), \"worktrees\")\n\tpath := strings.TrimSpace(strings.TrimPrefix(string(marker), \"gitdir: \"))\n\tif !strings.HasPrefix(string(marker), \"gitdir: \") || !filepath.IsAbs(path) || filepath.Dir(path) != parent {\n\t\treturn nil, fmt.Errorf(\"unexpected worktree registration\")\n\t}\n\tregistry, err := os.OpenRoot(parent)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tname := filepath.Base(path)\n\tinfo, err := registry.Lstat(name)\n\tif err != nil || !info.IsDir() {\n\t\tregistry.Close()\n\t\treturn nil, fmt.Errorf(\"worktree registration unavailable\")\n\t}\n\to := &reviewCleanupOwnership{runtime: runtime, registry: registry, registration: name, registrationInfo: info, backlink: filepath.Join(worktree, \".git\"), inventoryBytes: gitSnapshotMarginBytes}\n\tif head, err := registry.ReadFile(filepath.Join(name, \"HEAD\")); err == nil {\n\t\tif commit := strings.TrimSpace(string(head)); !strings.HasPrefix(commit, \"ref:\") && commit != \"\" {\n\t\t\tif listing, err := listCommittedTree(s.Root, commit); err == nil {\n\t\t\t\to.inventoryBytes = gitSnapshotBudget(gitCommittedTreeBytes(listing))\n\t\t\t}\n\t\t}\n\t}\n\tchild, err := registry.OpenRoot(name)\n\tif err != nil {\n\t\tregistry.Close()\n\t\treturn nil, err\n\t}\n\tbacklink, err := readReviewRootFile(child, \"gitdir\", 4096)\n\tchild.Close()\n\tif err != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n\t\tregistry.Close()\n\t\treturn nil, fmt.Errorf(\"worktree registration backlink differs\")\n\t}\n\treturn o, nil\n}\n\nfunc (s Store) cleanupReviewResources(tmp string, owned os.FileInfo, worktree string, worktreeOwned os.FileInfo, gitMarker []byte, ownership ...*reviewCleanupOwnership) error {\n\tvar o *reviewCleanupOwnership\n\tif len(ownership) > 0 {\n\t\to = ownership[0]\n\t}\n\tcurrent, err := os.Lstat(tmp)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\tif (o != nil && !o.removed) || (o == nil && worktreeOwned != nil) {\n\t\t\treturn fmt.Errorf(\"runtime path disappeared without confirmed cleanup; resources may remain\")\n\t\t}\n\t\treturn nil\n\t}\n\tif err != nil || !current.IsDir() || !os.SameFile(owned, current) {\n\t\treturn fmt.Errorf(\"cleanup refused: runtime directory identity changed\")\n\t}\n\n\tvar root *os.Root\n\tif o != nil {\n\t\troot = o.runtime\n\t} else {\n\t\troot, err = os.OpenRoot(tmp)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"runtime cleanup root unavailable\")\n\t\t}\n\t\tdefer root.Close()\n\t}\n\tstat, err := root.Stat(\".\")\n\tif err != nil || !os.SameFile(owned, stat) {\n\t\treturn fmt.Errorf(\"runtime cleanup root identity changed\")\n\t}\n\tif worktreeOwned != nil {\n\t\tinfo, err := root.Lstat(\"worktree\")\n\t\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\t\treturn fmt.Errorf(\"worktree cleanup unavailable\")\n\t\t}\n\t\tif err == nil {\n\t\t\tmarker, e := readReviewRootFile(root, \"worktree/.git\", 4096)\n\t\t\tif e != nil || !info.IsDir() || !os.SameFile(worktreeOwned, info) || !bytes.Equal(marker, gitMarker) {\n\t\t\t\treturn fmt.Errorf(\"cleanup refused: worktree identity changed\")\n\t\t\t}\n\t\t}\n\t\tif o == nil || o.registry == nil {\n\t\t\treturn fmt.Errorf(\"cleanup registration ownership unavailable; resources retained\")\n\t\t}\n\t\tinfo, e := o.registry.Lstat(o.registration)\n\t\tif e != nil || !info.IsDir() || !os.SameFile(info, o.registrationInfo) {\n\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n\t\t}\n\t\tregistration, e := o.registry.OpenRoot(o.registration)\n\t\tif e != nil {\n\t\t\treturn fmt.Errorf(\"cleanup registration unavailable\")\n\t\t}\n\t\tdefer registration.Close()\n\t\tinfo, e = registration.Stat(\".\")\n\t\tif e != nil || !os.SameFile(info, o.registrationInfo) {\n\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n\t\t}\n\t\tbacklink, e := readReviewRootFile(registration, \"gitdir\", 4096)\n\t\tif e != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n\t\t\treturn fmt.Errorf(\"cleanup registration backlink changed\")\n\t\t}\n\t\tfor _, lock := range []string{\"locked\", \"index.lock\", \"HEAD.lock\"} {\n\t\t\tif _, e := registration.Lstat(lock); !errors.Is(e, os.ErrNotExist) {\n\t\t\t\treturn fmt.Errorf(\"worktree registration has a live or unknown lock; resources retained\")\n\t\t\t}\n\t\t}\n\t\tif err == nil {\n\t\t\ttree, e := root.OpenRoot(\"worktree\")\n\t\t\tif e != nil {\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup root unavailable\")\n\t\t\t}\n\t\t\tinfo, e := tree.Stat(\".\")\n\t\t\tif e != nil || !os.SameFile(info, worktreeOwned) {\n\t\t\t\ttree.Close()\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup identity changed\")\n\t\t\t}\n\t\t\tlimit := gitSnapshotMarginBytes\n\t\t\tif o.inventoryBytes > limit {\n\t\t\t\tlimit = o.inventoryBytes\n\t\t\t}\n\t\t\te = removeReviewOwnedContents(tree, 100000, limit)\n\t\t\ttree.Close()\n\t\t\tif e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tif e := root.Remove(\"worktree\"); e != nil && !errors.Is(e, os.ErrNotExist) {\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup incomplete\")\n\t\t\t}\n\t\t}\n\t\tif e := removeReviewOwnedContents(registration, 1024, 256<<20); e != nil {\n\t\t\treturn e\n\t\t}\n\t\tregistration.Close()\n\t\tif e := o.registry.Remove(o.registration); e != nil && !errors.Is(e, os.ErrNotExist) {\n\t\t\treturn fmt.Errorf(\"worktree registration cleanup incomplete\")\n\t\t}\n\t} else if _, e := root.Lstat(\"worktree\"); !errors.Is(e, os.ErrNotExist) {\n\t\treturn fmt.Errorf(\"partial worktree setup has no verified ownership; resources retained\")\n\t}\n\tif o != nil && o.gitlinkMetadata != nil {\n\t\tif err := removeReviewGitlinkMetadata(root, o.gitlinkMetadata, o.gitlinkMetadataBytes); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := removeReviewGoBuildLeftovers(root); err != nil {\n\t\treturn err\n\t}\n\tif err := removeReviewOwnedContents(root, reviewRuntimeMaxEntries, 128<<20); err != nil {\n\t\treturn err\n\t}\n\tcurrent, err = os.Lstat(tmp)\n\tif err != nil || !os.SameFile(owned, current) {\n\t\treturn fmt.Errorf(\"runtime path changed during cleanup; replacement retained\")\n\t}\n\tif err := os.Remove(tmp); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\treturn fmt.Errorf(\"runtime directory cleanup incomplete\")\n\t}\n\tif o != nil {\n\t\to.removed = true\n\t}\n\treturn nil\n}\n\n// Private gitlink stores are charged separately from the adapter's runtime\n// output. Both the opened directory and the removal target must be the\n// directory setup created inside the operation root.\nfunc removeReviewGitlinkMetadata(root *os.Root, owned os.FileInfo, limit int64) error {\n\tdir, err := root.OpenRoot(reviewGitlinkMetadataDir)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"private gitlink metadata cleanup unavailable\")\n\t}\n\tdefer dir.Close()\n\tinfo, err := dir.Stat(\".\")\n\tif err != nil || !os.SameFile(owned, info) {\n\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n\t}\n\tif err := removeReviewOwnedContents(dir, 100000, limit); err != nil {\n\t\treturn err\n\t}\n\tinfo, err = root.Lstat(reviewGitlinkMetadataDir)\n\tif err != nil || !os.SameFile(owned, info) {\n\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n\t}\n\tdir.Close()\n\tif err := root.Remove(reviewGitlinkMetadataDir); err != nil {\n\t\treturn fmt.Errorf(\"private gitlink metadata cleanup incomplete\")\n\t}\n\treturn nil\n}\n\n// reviewGoBuildDir names the temporary build directory the Go toolchain\n// creates under the TMPDIR the engine gives a review run.\nvar reviewGoBuildDir = regexp.MustCompile(`^go-build[0-9]+$`)\n\n// reviewGoBuildBeforeOpen runs after a go-build name is listed and before it\n// is opened, reviewGoBuildAfterContents after the directory is emptied and\n// before its name is checked again, and reviewGoBuildBeforeRemove between that\n// check and the removal; tests use them to change the name there.\nvar (\n\treviewGoBuildBeforeOpen    = func(string) {}\n\treviewGoBuildAfterContents = func(string) {}\n\treviewGoBuildBeforeRemove  = func(string) {}\n)\n\n// removeReviewGoBuildLeftovers removes the Go build directories a reviewer's\n// interrupted `go test` or `go build` left at the top of the run's runtime\n// directory, each under its own bounded inventory, before the runtime's own\n// inventory, which a single test binary can exceed (spec\n// pose-review-cleanup-removes-go-build-leftovers). Only a real directory is\n// removed; the platform implementation opens it without blocking and only as\n// a directory, so a link, a FIFO or any other entry stays for the runtime\n// inventory to judge.\nfunc removeReviewGoBuildLeftovers(root *os.Root) error {\n\t// The top level is read in bounded batches and each go-build directory\n\t// is removed as it is read, so nothing accumulates; only the other\n\t// entries, which the runtime inventory will judge, count against its\n\t// bound (review rounds 5 and 6, N6 and N10).\n\tdir, err := root.Open(\".\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n\t}\n\tdefer dir.Close()\n\tothers := 0\n\tfor {\n\t\tbatch, err := dir.Readdirnames(256)\n\t\tfor _, name := range batch {\n\t\t\tif !reviewGoBuildDir.MatchString(name) {\n\t\t\t\tothers++\n\t\t\t\tif others > reviewRuntimeMaxEntries {\n\t\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif err := removeReviewGoBuildDir(root, name); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\tif len(batch) == 0 {\n\t\t\tif err == nil || errors.Is(err, io.EOF) {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n\t\t}\n\t}\n}\n\n// reviewRuntimeMaxEntries is the runtime inventory's own entry bound.\nconst reviewRuntimeMaxEntries = 4096\n\nfunc removeReviewOwnedContents(root *os.Root, maxFiles int, maxBytes int64) error {\n\tpaths := []string{}\n\tvar total int64\n\terr := fs.WalkDir(root.FS(), \".\", func(path string, d fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif path == \".\" {\n\t\t\treturn nil\n\t\t}\n\t\tif len(paths) >= maxFiles || strings.Count(path, \"/\") > 128 {\n\t\t\treturn fmt.Errorf(\"cleanup inventory exceeds coverage\")\n\t\t}\n\t\tinfo, err := d.Info()\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif info.Mode().IsRegular() {\n\t\t\ttotal += info.Size()\n\t\t\tif total > maxBytes {\n\t\t\t\treturn fmt.Errorf(\"cleanup inventory exceeds bytes\")\n\t\t\t}\n\t\t}\n\t\tpaths = append(paths, path)\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n\t}\n\tfor i := len(paths) - 1; i >= 0; i-- {\n\t\tif err := root.Remove(paths[i]); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\t\treturn fmt.Errorf(\"runtime cleanup incomplete; resources retained\")\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc reviewSafetyConflict(run ReviewRun) string {\n\tif run.Safety == nil {\n\t\treturn \"\"\n\t} // Historical runs have no invented observations.","numLines":530,"startLine":230,"totalLines":775}},"tool_result_meta":[{"id":"toolu_01MKLiZ6aVtmEZqoKaVaetQJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
