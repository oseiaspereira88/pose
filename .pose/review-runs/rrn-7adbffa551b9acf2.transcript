{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0162aTGSYEAiSaQTVsXa8C1G","type":"tool_result","content":"30\t\t}\n31\t\tif len(raw) > int(f.run.Safety.StreamBytes) || len(f.run.Output) > int(f.run.Safety.OutputBytes) {\n32\t\t\tt.Fatal(\"redacted retention exceeded configured stream/output bounds\")\n33\t\t}\n34\t\tproof, err := f.store.SignReviewRunProof(f.run.RunID, f.key, time.Hour, time.Now(), true)\n35\t\tif err != nil {\n36\t\t\tt.Fatal(err)\n37\t\t}\n38\t\taudit, err := f.store.VerifyReviewRunProof(f.run.RunID, proof.ProofID)\n39\t\tif err != nil || audit.CompleteReview || audit.State != ReviewRunFailed {\n40\t\t\tt.Fatal(\"failed capture authorized review\", audit, err)\n41\t\t}\n42\t}\n43\t\n44\tfunc TestAdapterContainmentCredentialSessionResumesWithPrivateOriginal(t *testing.T) {\n45\t\tconst secret = \"synthetic-session-credential-123\"\n46\t\tt.Setenv(\"FIXTURE_TOKEN\", secret)\n47\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n48\t\t\ta.Containment = containmentPolicy()\n49\t\t\ta.Containment.Credentials = []string{\"FIXTURE_TOKEN\"}\n50\t\t\ta.Session = &ReviewerSession{Pattern: `session: (\\S+)`}\n51\t\t\ta.Limit = &ReviewerLimit{ExitCodes: []int{75}}\n52\t\t\ta.Resume = &ReviewerResume{Command: []string{\"sh\", \"-c\", `cat >/dev/null; test \"$1\" = \"$FIXTURE_TOKEN\" || exit 1; printf 'decision: approved\\n'`, \"sh\", \"{session}\"}}\n53\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; printf 'session: %s\\n' \"$FIXTURE_TOKEN\"; exit 75`}\n54\t\t})\n55\t\tstored, err := f.store.readReviewSession(f.run.SessionDigest)\n56\t\tif err != nil || stored != secret {\n57\t\t\tt.Fatal(\"redaction changed private continuation reference\", err)\n58\t\t}\n59\t\tfor _, path := range []string{f.run.Path, f.run.TranscriptPath} {\n60\t\t\traw, err := os.ReadFile(filepath.Join(f.store.Root, filepath.FromSlash(path)))\n61\t\t\tif err != nil || bytes.Contains(raw, []byte(secret)) {\n62\t\t\t\tt.Fatal(\"private credential/session leaked to public retention\", path, err)\n63\t\t\t}\n64\t\t}\n65\t\tplan, err := f.store.PlanReviewResume(f.run.RunID)\n66\t\tif err != nil {\n67\t\t\tt.Fatal(err)\n68\t\t}\n69\t\tresumed, err := f.store.RunReviewDispatch(plan, time.Now)\n70\t\tif err != nil || resumed.Status != ReviewRunCompleted || resumed.AttemptID != f.run.AttemptID || resumed.Resumes != f.run.RunID {\n71\t\t\tt.Fatal(\"continuation did not receive its original private session\", resumed.Failure, err)\n72\t\t}\n73\t\tif strings.Contains(resumed.Output, secret) {\n74\t\t\tt.Fatal(\"resumed public output leaked credential/session\")\n75\t\t}\n76\t}\n77\t\n78\tfunc TestAdapterContainmentOverlappingSessionDoesNotExposeCredentialSuffix(t *testing.T) {\n79\t\tsession := \"fixture-session-ref\"\n80\t\tsecret := session + \"-secret-suffix-123456\"\n81\t\traw := []byte(session + \" \" + secret)\n82\t\tretained, err := redactReviewCapture(raw, []string{secret}, session, 1024)\n83\t\tif err != nil {\n84\t\t\tt.Fatal(err)\n85\t\t}\n86\t\tif string(retained) != \"[private-session] [credential]\" {\n87\t\t\tt.Fatal(\"overlapping session prevented complete credential redaction\", string(retained))\n88\t\t}\n89\t}\n90\t\n91\ttype containmentCleanupFixture struct {\n92\t\tstore                Store\n93\t\ttmp, worktree        string\n94\t\towned, worktreeOwned os.FileInfo\n95\t\tmarker               []byte\n96\t\truntimeRoot          *os.Root\n97\t\townership            *reviewCleanupOwnership\n98\t}\n99\t\n100\tfunc makeContainmentCleanupFixture(t *testing.T) containmentCleanupFixture {\n101\t\tt.Helper()\n102\t\trepo := t.TempDir()\n103\t\tgitbin, err := exec.LookPath(\"git\")\n104\t\tif err != nil {\n105\t\t\tt.Fatal(err)\n106\t\t}\n107\t\tgit := func(args ...string) {\n108\t\t\tt.Helper()\n109\t\t\tcmd := exec.Command(gitbin, append([]string{\"-C\", repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\"}, args...)...)\n110\t\t\tout, err := cmd.CombinedOutput()\n111\t\t\tif err != nil {\n112\t\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n113\t\t\t}\n114\t\t}\n115\t\tgit(\"init\", \"-q\")\n116\t\tif err := os.WriteFile(filepath.Join(repo, \"tracked\"), []byte(\"operation data\"), 0600); err != nil {\n117\t\t\tt.Fatal(err)\n118\t\t}\n119\t\tgit(\"add\", \"-A\")\n120\t\tgit(\"commit\", \"-qm\", \"fixture\")\n121\t\ttmp := filepath.Join(t.TempDir(), \"operation\")\n122\t\tif err := os.Mkdir(tmp, 0700); err != nil {\n123\t\t\tt.Fatal(err)\n124\t\t}\n125\t\towned, err := os.Lstat(tmp)\n126\t\tif err != nil {\n127\t\t\tt.Fatal(err)\n128\t\t}\n129\t\troot, err := os.OpenRoot(tmp)\n130\t\tif err != nil {\n131\t\t\tt.Fatal(err)\n132\t\t}\n133\t\tt.Cleanup(func() { root.Close() })\n134\t\tworktree := filepath.Join(tmp, \"worktree\")\n135\t\tgit(\"worktree\", \"add\", \"--detach\", worktree, \"HEAD\")\n136\t\tworktreeOwned, err := os.Lstat(worktree)\n137\t\tif err != nil {\n138\t\t\tt.Fatal(err)\n139\t\t}\n140\t\tmarker, err := os.ReadFile(filepath.Join(worktree, \".git\"))\n141\t\tif err != nil {\n142\t\t\tt.Fatal(err)\n143\t\t}\n144\t\tstore := Store{Root: repo}\n145\t\townership, err := store.captureReviewCleanupOwnership(root, worktree, marker)\n146\t\tif err != nil {\n147\t\t\tt.Fatal(err)\n148\t\t}\n149\t\tt.Cleanup(func() { ownership.registry.Close() })\n150\t\treturn containmentCleanupFixture{store: store, tmp: tmp, worktree: worktree, owned: owned, worktreeOwned: worktreeOwned, marker: marker, runtimeRoot: root, ownership: ownership}\n151\t}\n152\tfunc (f containmentCleanupFixture) cleanup() error {\n153\t\treturn f.store.cleanupReviewResources(f.tmp, f.owned, f.worktree, f.worktreeOwned, f.marker, f.ownership)\n154\t}\n155\t\n156\tfunc TestAdapterContainmentCleanupCapturedRootsRefuseReplacement(t *testing.T) {\n157\t\tif runtime.GOOS != \"linux\" {\n158\t\t\tt.Skip(\"Linux descriptor and symlink qualification\")\n159\t\t}\n160\t\tfor _, kind := range []string{\"runtime-symlink\", \"runtime-missing\", \"registration-symlink\"} {\n161\t\t\tt.Run(kind, func(t *testing.T) {\n162\t\t\t\tf := makeContainmentCleanupFixture(t)\n163\t\t\t\tvictim := t.TempDir()\n164\t\t\t\tsentinel := filepath.Join(victim, \"keep\")\n165\t\t\t\tif err := os.WriteFile(sentinel, []byte(\"foreign data\"), 0600); err != nil {\n166\t\t\t\t\tt.Fatal(err)\n167\t\t\t\t}\n168\t\t\t\tswitch kind {\n169\t\t\t\tcase \"runtime-symlink\", \"runtime-missing\":\n170\t\t\t\t\tif err := os.Rename(f.tmp, f.tmp+\"-owned\"); err != nil {\n171\t\t\t\t\t\tt.Fatal(err)\n172\t\t\t\t\t}\n173\t\t\t\t\tif kind == \"runtime-symlink\" {\n174\t\t\t\t\t\tif err := os.Symlink(victim, f.tmp); err != nil {\n175\t\t\t\t\t\t\tt.Fatal(err)\n176\t\t\t\t\t\t}\n177\t\t\t\t\t}\n178\t\t\t\tcase \"registration-symlink\":\n179\t\t\t\t\tpath := filepath.Join(f.store.Root, \".git\", \"worktrees\", f.ownership.registration)\n180\t\t\t\t\tif err := os.Rename(path, path+\"-owned\"); err != nil {\n181\t\t\t\t\t\tt.Fatal(err)\n182\t\t\t\t\t}\n183\t\t\t\t\tif err := os.Symlink(victim, path); err != nil {\n184\t\t\t\t\t\tt.Fatal(err)\n185\t\t\t\t\t}\n186\t\t\t\t}\n187\t\t\t\tif err := f.cleanup(); err == nil {\n188\t\t\t\t\tt.Fatal(\"replaced/missing owned resource reported successful cleanup\")\n189\t\t\t\t}\n190\t\t\t\tif raw, err := os.ReadFile(sentinel); err != nil || string(raw) != \"foreign data\" {\n191\t\t\t\t\tt.Fatal(\"foreign resource changed\", err)\n192\t\t\t\t}\n193\t\t\t})\n194\t\t}\n195\t\t// The actual recursive primitive uses the descriptor even after its path is\n196\t\t// redirected. This tests the former post-validation window without a Git\n197\t\t// wrapper: there is now no path-based recursive Git command to intercept.\n198\t\tf := makeContainmentCleanupFixture(t)\n199\t\tvictim := t.TempDir()\n200\t\tsentinel := filepath.Join(victim, \"keep\")\n201\t\tif err := os.WriteFile(sentinel, []byte(\"foreign data\"), 0600); err != nil {\n202\t\t\tt.Fatal(err)\n203\t\t}\n204\t\tif err := os.Rename(f.tmp, f.tmp+\"-owned\"); err != nil {\n205\t\t\tt.Fatal(err)\n206\t\t}\n207\t\tif err := os.Symlink(victim, f.tmp); err != nil {\n208\t\t\tt.Fatal(err)\n209\t\t}\n210\t\tif err := removeReviewOwnedContents(f.runtimeRoot, 100000, 256<<20); err != nil {\n211\t\t\tt.Fatal(err)\n212\t\t}\n213\t\tif _, err := os.Stat(sentinel); err != nil {\n214\t\t\tt.Fatal(\"descriptor-confined removal escaped its root\", err)\n215\t\t}\n216\t\tif _, err := os.Stat(filepath.Join(f.tmp+\"-owned\", \"worktree\")); !os.IsNotExist(err) {\n217\t\t\tt.Fatal(\"owned descriptor was not exercised\", err)\n218\t\t}\n219\t}\n220\t\n221\tfunc TestAdapterContainmentCleanupOnlyOwnRegistrationAndIdempotence(t *testing.T) {\n222\t\tif runtime.GOOS != \"linux\" {\n223\t\t\tt.Skip(\"Linux descriptor qualification\")\n224\t\t}\n225\t\tf := makeContainmentCleanupFixture(t)\n226\t\tunrelated := filepath.Join(f.store.Root, \".git\", \"worktrees\", \"unrelated-registration\")\n227\t\tif err := os.Mkdir(unrelated, 0700); err != nil {\n228\t\t\tt.Fatal(err)\n229\t\t}\n230\t\tsentinel := filepath.Join(unrelated, \"keep\")\n231\t\tif err := os.WriteFile(sentinel, []byte(\"unrelated registry data\"), 0600); err != nil {\n232\t\t\tt.Fatal(err)\n233\t\t}\n234\t\tif err := f.cleanup(); err != nil {\n235\t\t\tt.Fatal(err)\n236\t\t}\n237\t\tif err := f.cleanup(); err != nil {\n238\t\t\tt.Fatal(\"completed cleanup was not idempotent\", err)\n239\t\t}\n240\t\tif _, err := os.Stat(sentinel); err != nil {\n241\t\t\tt.Fatal(\"cleanup pruned unrelated registration\", err)\n242\t\t}\n243\t\tif _, err := os.Stat(filepath.Join(f.store.Root, \".git\", \"worktrees\", f.ownership.registration)); !os.IsNotExist(err) {\n244\t\t\tt.Fatal(\"own registration was not removed\", err)\n245\t\t}\n246\t}\n247\t\n248\tfunc TestAdapterContainmentFailedCleanupContinuationRemainsFailed(t *testing.T) {\n249\t\tif runtime.GOOS != \"linux\" {\n250\t\t\tt.Skip(\"Unix fixture command and registration qualification\")\n251\t\t}\n252\t\tfor _, interrupted := range []bool{false, true} {\n253\t\t\tt.Run(map[bool]string{false: \"completed-domain\", true: \"interrupted-domain\"}[interrupted], func(t *testing.T) {\n254\t\t\t\texit := \"0\"\n255\t\t\t\tif interrupted {\n256\t\t\t\t\texit = \"75\"\n257\t\t\t\t}\n258\t\t\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n259\t\t\t\t\ta.Containment = containmentPolicy()\n260\t\t\t\t\ta.Session = &ReviewerSession{Pattern: `session: (\\S+)`}\n261\t\t\t\t\ta.Limit = &ReviewerLimit{ExitCodes: []int{75}}\n262\t\t\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; printf 'session: fixture-private-reference\\n'; exit 75`}\n263\t\t\t\t\ta.Resume = &ReviewerResume{Command: []string{\"sh\", \"-c\", `cat >/dev/null; registration=$(git rev-parse --absolute-git-dir) || exit 2; printf 'fixture owned lock\\n' > \"$registration/locked\"; printf 'decision: approved\\n'; exit ` + exit, \"sh\", \"{session}\"}}\n264\t\t\t\t})\n265\t\t\t\tplan, err := f.store.PlanReviewResume(f.run.RunID)\n266\t\t\t\tif err != nil {\n267\t\t\t\t\tt.Fatal(err)\n268\t\t\t\t}\n269\t\t\t\tnext, err := f.store.RunReviewDispatch(plan, time.Now)\n270\t\t\t\tif err == nil || next.RunID == \"\" || next.Safety.Operation.Outcome != OutcomeFailed {\n271\t\t\t\t\tt.Fatal(\"cleanup failure was not retained\", next, err)\n272\t\t\t\t}\n273\t\t\t\tif why := f.store.ReviewRunStillGoverns(next); why == \"\" {\n274\t\t\t\t\tt.Fatal(\"cleanup failure governed review\")\n275\t\t\t\t}\n276\t\t\t\tretry, err := f.store.PlanReviewResume(f.run.RunID)\n277\t\t\t\tif err != nil || retry.Existing == nil {\n278\t\t\t\t\tt.Fatal(\"retry lost its immutable result\", err)\n279\t\t\t\t}\n280\t\t\t\trepeated, err := f.store.RunReviewDispatch(retry, time.Now)\n281\t\t\t\tif err == nil || repeated.RunID != next.RunID {\n282\t\t\t\t\tt.Fatal(\"idempotent retry hid cleanup failure or respawned\", repeated.RunID, err)\n283\t\t\t\t}\n284\t\t\t\tif interrupted {\n285\t\t\t\t\tif _, err := f.store.PlanReviewResume(next.RunID); err == nil {\n286\t\t\t\t\t\tt.Fatal(\"new continuation admitted beside possible orphan\")\n287\t\t\t\t\t}\n288\t\t\t\t}\n289\t\t\t\truns, losses, err := f.store.ReadReviewRuns(\"\")\n290\t\t\t\tif err != nil || len(losses) > 0 || len(runs) != 2 {\n291\t\t\t\t\tt.Fatal(\"cleanup retry altered run ledger\", len(runs), losses, err)\n292\t\t\t\t}\n293\t\t\t})\n294\t\t}\n295\t}\n296\t\n297\t// A child that escaped the process group but keeps the run's environment is\n298\t// ended with the run, and the guarantee is disclosed as environment-marked,\n299\t// never as available (spec pose-review-run-reaps-lingering-reviewer-processes).\n300\tfunc TestAdapterContainmentEscapedChildIsEndedWhileEnvironmentMarked(t *testing.T) {\n301\t\tif runtime.GOOS != \"linux\" {\n302\t\t\tt.Skip(\"Linux setsid limitation fixture\")\n303\t\t}\n304\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n305\t\t\tt.Skip(\"setsid unavailable for explicit escape fixture\")\n306\t\t}\n307\t\toutside := t.TempDir()\n308\t\ttrigger := filepath.Join(outside, \"trigger\")\n309\t\tescaped := filepath.Join(outside, \"escaped\")\n310\t\tready := filepath.Join(outside, \"ready\")\n311\t\tt.Cleanup(func() { _ = os.WriteFile(trigger, []byte(\"release finite child\"), 0600) })\n312\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n313\t\t\ta.Containment = containmentPolicy()\n314\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid sh -c 'printf ready > \"$3\"; n=0; while test \"$n\" -lt 200; do if test -e \"$1\"; then printf escaped > \"$2\"; exit 0; fi; n=$((n+1)); sleep 0.01; done' sh \"$1\" \"$2\" \"$3\" >/dev/null 2>&1 & n=0; while ! test -e \"$3\"; do n=$((n+1)); test \"$n\" -lt 100 || exit 2; sleep 0.01; done; printf 'decision: approved\\n'`, \"sh\", trigger, escaped, ready}\n315\t\t})\n316\t\tif f.run.Status != ReviewRunCompleted || f.run.Safety.Capabilities[\"escaped-descendant-termination\"] != \"environment-marked\" {\n317\t\t\tt.Fatal(\"escaped-process termination was not disclosed as environment-marked\", f.run.Failure, f.run.Safety)\n318\t\t}\n319\t\tif _, err := os.Stat(escaped); !os.IsNotExist(err) {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"6884d632-961a-4cc7-9819-55cc302d5462","timestamp":"2026-11-26T07:20:40.082Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-93b9b9511d1567d3fc5c2c9979b76703/worktree/pose-mcp/internal/pose/review_adapter_containment_regression_test.go","content":"\t}\n\tif len(raw) > int(f.run.Safety.StreamBytes) || len(f.run.Output) > int(f.run.Safety.OutputBytes) {\n\t\tt.Fatal(\"redacted retention exceeded configured stream/output bounds\")\n\t}\n\tproof, err := f.store.SignReviewRunProof(f.run.RunID, f.key, time.Hour, time.Now(), true)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\taudit, err := f.store.VerifyReviewRunProof(f.run.RunID, proof.ProofID)\n\tif err != nil || audit.CompleteReview || audit.State != ReviewRunFailed {\n\t\tt.Fatal(\"failed capture authorized review\", audit, err)\n\t}\n}\n\nfunc TestAdapterContainmentCredentialSessionResumesWithPrivateOriginal(t *testing.T) {\n\tconst secret = \"synthetic-session-credential-123\"\n\tt.Setenv(\"FIXTURE_TOKEN\", secret)\n\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n\t\ta.Containment = containmentPolicy()\n\t\ta.Containment.Credentials = []string{\"FIXTURE_TOKEN\"}\n\t\ta.Session = &ReviewerSession{Pattern: `session: (\\S+)`}\n\t\ta.Limit = &ReviewerLimit{ExitCodes: []int{75}}\n\t\ta.Resume = &ReviewerResume{Command: []string{\"sh\", \"-c\", `cat >/dev/null; test \"$1\" = \"$FIXTURE_TOKEN\" || exit 1; printf 'decision: approved\\n'`, \"sh\", \"{session}\"}}\n\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; printf 'session: %s\\n' \"$FIXTURE_TOKEN\"; exit 75`}\n\t})\n\tstored, err := f.store.readReviewSession(f.run.SessionDigest)\n\tif err != nil || stored != secret {\n\t\tt.Fatal(\"redaction changed private continuation reference\", err)\n\t}\n\tfor _, path := range []string{f.run.Path, f.run.TranscriptPath} {\n\t\traw, err := os.ReadFile(filepath.Join(f.store.Root, filepath.FromSlash(path)))\n\t\tif err != nil || bytes.Contains(raw, []byte(secret)) {\n\t\t\tt.Fatal(\"private credential/session leaked to public retention\", path, err)\n\t\t}\n\t}\n\tplan, err := f.store.PlanReviewResume(f.run.RunID)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresumed, err := f.store.RunReviewDispatch(plan, time.Now)\n\tif err != nil || resumed.Status != ReviewRunCompleted || resumed.AttemptID != f.run.AttemptID || resumed.Resumes != f.run.RunID {\n\t\tt.Fatal(\"continuation did not receive its original private session\", resumed.Failure, err)\n\t}\n\tif strings.Contains(resumed.Output, secret) {\n\t\tt.Fatal(\"resumed public output leaked credential/session\")\n\t}\n}\n\nfunc TestAdapterContainmentOverlappingSessionDoesNotExposeCredentialSuffix(t *testing.T) {\n\tsession := \"fixture-session-ref\"\n\tsecret := session + \"-secret-suffix-123456\"\n\traw := []byte(session + \" \" + secret)\n\tretained, err := redactReviewCapture(raw, []string{secret}, session, 1024)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif string(retained) != \"[private-session] [credential]\" {\n\t\tt.Fatal(\"overlapping session prevented complete credential redaction\", string(retained))\n\t}\n}\n\ntype containmentCleanupFixture struct {\n\tstore                Store\n\ttmp, worktree        string\n\towned, worktreeOwned os.FileInfo\n\tmarker               []byte\n\truntimeRoot          *os.Root\n\townership            *reviewCleanupOwnership\n}\n\nfunc makeContainmentCleanupFixture(t *testing.T) containmentCleanupFixture {\n\tt.Helper()\n\trepo := t.TempDir()\n\tgitbin, err := exec.LookPath(\"git\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit := func(args ...string) {\n\t\tt.Helper()\n\t\tcmd := exec.Command(gitbin, append([]string{\"-C\", repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\"}, args...)...)\n\t\tout, err := cmd.CombinedOutput()\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t}\n\tgit(\"init\", \"-q\")\n\tif err := os.WriteFile(filepath.Join(repo, \"tracked\"), []byte(\"operation data\"), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit(\"add\", \"-A\")\n\tgit(\"commit\", \"-qm\", \"fixture\")\n\ttmp := filepath.Join(t.TempDir(), \"operation\")\n\tif err := os.Mkdir(tmp, 0700); err != nil {\n\t\tt.Fatal(err)\n\t}\n\towned, err := os.Lstat(tmp)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\troot, err := os.OpenRoot(tmp)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Cleanup(func() { root.Close() })\n\tworktree := filepath.Join(tmp, \"worktree\")\n\tgit(\"worktree\", \"add\", \"--detach\", worktree, \"HEAD\")\n\tworktreeOwned, err := os.Lstat(worktree)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tmarker, err := os.ReadFile(filepath.Join(worktree, \".git\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstore := Store{Root: repo}\n\townership, err := store.captureReviewCleanupOwnership(root, worktree, marker)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Cleanup(func() { ownership.registry.Close() })\n\treturn containmentCleanupFixture{store: store, tmp: tmp, worktree: worktree, owned: owned, worktreeOwned: worktreeOwned, marker: marker, runtimeRoot: root, ownership: ownership}\n}\nfunc (f containmentCleanupFixture) cleanup() error {\n\treturn f.store.cleanupReviewResources(f.tmp, f.owned, f.worktree, f.worktreeOwned, f.marker, f.ownership)\n}\n\nfunc TestAdapterContainmentCleanupCapturedRootsRefuseReplacement(t *testing.T) {\n\tif runtime.GOOS != \"linux\" {\n\t\tt.Skip(\"Linux descriptor and symlink qualification\")\n\t}\n\tfor _, kind := range []string{\"runtime-symlink\", \"runtime-missing\", \"registration-symlink\"} {\n\t\tt.Run(kind, func(t *testing.T) {\n\t\t\tf := ma