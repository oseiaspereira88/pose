-85704a129332a685.json  |    8 +\n .pose/review-run-ledger/rrn-88e0428bda9bc9c7.json  |    8 +\n .pose/review-run-ledger/rrn-b07ee93779a65e40.json  |    8 +\n .../review-runs/rrn-0375009e985e6a3d.events.ndjson |   99 +\n .pose/review-runs/rrn-0375009e985e6a3d.json        |  158 +\n .pose/review-runs/rrn-0375009e985e6a3d.transcript  |  108 +\n .../review-runs/rrn-0dd98c4aab8b5918.events.ndjson |   60 +\n .pose/review-runs/rrn-0dd98c4aab8b5918.json        |  151 +\n .pose/review-runs/rrn-0dd98c4aab8b5918.transcript  |   61 +\n .../review-runs/rrn-1c033e4c349d7794.events.ndjson |   76 +\n .pose/review-runs/rrn-1c033e4c349d7794.json        |  152 +\n .pose/review-runs/rrn-1c033e4c349d7794.transcript  |   77 +\n .../review-runs/rrn-3461f6ff36909419.events.ndjson |   51 +\n .pose/review-runs/rrn-3461f6ff36909419.json        |  154 +\n .pose/review-runs/rrn-3461f6ff36909419.transcript  |   52 +\n .../review-runs/rrn-360343d3dc95895e.events.ndjson |    0\n .pose/review-runs/rrn-360343d3dc95895e.json        |  135 +\n .pose/review-runs/rrn-360343d3dc95895e.transcript  |    0\n .../review-runs/rrn-4b28f2ff95acf9c4.events.ndjson |   44 +\n .pose/review-runs/rrn-4b28f2ff95acf9c4.json        |  154 +\n .pose/review-runs/rrn-4b28f2ff95acf9c4.transcript  |   45 +\n .../review-runs/rrn-85704a129332a685.events.ndjson |   80 +\n .pose/review-runs/rrn-85704a129332a685.json        |  166 +\n .pose/review-runs/rrn-85704a129332a685.transcript  |   81 +\n .../review-runs/rrn-88e0428bda9bc9c7.events.ndjson |   40 +\n .pose/review-runs/rrn-88e0428bda9bc9c7.json        |  155 +\n .pose/review-runs/rrn-88e0428bda9bc9c7.transcript  |   41 +\n .../review-runs/rrn-b07ee93779a65e40.events.ndjson |   34 +\n .pose/review-runs/rrn-b07ee93779a65e40.json        |  154 +\n .pose/review-runs/rrn-b07ee93779a65e40.transcript  |   35 +\n ...11-22-pose-validate-carries-unchanged-checks.md |  221 ++\n POSE.md                                            |    6 +-\n locales/pt-BR/POSE.md                              |    6 +-\n pose-mcp/internal/cli/help_catalog.go              |    1 +\n pose-mcp/internal/cli/validate.go                  |  109 +-\n pose-mcp/internal/cli/validate_carry.go            |  506 +++\n pose-mcp/internal/cli/validate_carry_test.go       |  840 +++++\n .../internal/cli/validate_engine_identity_test.go  |   30 +\n pose-mcp/internal/cli/validate_results.go          |   13 +\n pose-mcp/internal/cli/validate_scope.go            |  123 +-\n pose-mcp/internal/pose/delivery_validation_run.go  |   10 +-\n .../internal/pose/delivery_validation_run_test.go  |   30 +\n pose-mcp/internal/scaffold/dist/POSE.md            |    6 +-\n .../internal/scaffold/dist/locales/pt-BR/POSE.md   |    6 +-\n 82 files changed, 35801 insertions(+), 2536 deletions(-)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '232,265p' pose-mcp/internal/cli/validate_results.go; cat .pose/indexes/validation-matrix.json | head -70; nl -ba pose-mcp/internal/cli/validate_carry.go | sed -n '385,495p'; cat .pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '232,265p' pose-mcp/internal/cli/validate_results.go; cat .pose/indexes/validation-matrix.json | head -70; nl -ba pose-mcp/internal/cli/validate_carry.go | sed -n '385,495p'; cat .pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md\"","aggregated_output":"// publishCanonicalValidationJSON rechecks the delivery policy after acquiring\n// the root lease, then publishes the exact canonical result through B14. A\n// changed path is refused before creating or replacing the result.\nfunc publishCanonicalValidationJSON(root, relative, expectedPolicyPath string, run validationRunResult) error {\n\treturn publishCanonicalValidationJSONIn(cliGovernedStore(root), relative, expectedPolicyPath, run)\n}\n\nfunc publishCanonicalValidationJSONIn(store posemodel.Store, relative, expectedPolicyPath string, run validationRunResult) error {\n\treturn store.WithGovernanceWriteGuardForProjects(\"validate.publish-results\", nil, func(store posemodel.Store) error {\n\t\tpolicy, err := posemodel.LoadDeliveryPolicyIn(store.FS, store.Root)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tcurrentPath := normalizeValidationOutputPath(policy.ResultsPath)\n\t\tif currentPath == \"\" || currentPath != expectedPolicyPath || currentPath != normalizeValidationOutputPath(relative) {\n\t\t\treturn fmt.Errorf(\"configured delivery results path changed before publication; nothing was written\")\n\t\t}\n\t\tpayload, err := marshalValidationJSON(run)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\ttarget := filepath.Join(store.Root, filepath.FromSlash(currentPath))\n\t\tif err := store.FS.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn store.FS.Publish(target, payload, 0o644, posemodel.PublishAuthoritative, posemodel.PublishExpectation{Mode: posemodel.ExpectAny})\n\t})\n}\n\n// --- JUnit projection -------------------------------------------------------\n// Mapping: one <testsuite> per module, one <testcase> per check. POSE\n// \"error\" maps to <error> (infrastructure), \"fail\" to <failure>, \"skipped\"\n// to <skipped> with the deterministic reason. Optional-severity failures are\n// still <failure> — JUnit has no tolerated level, so the POSE severity is\n{\n  \"defaults\": {\n    \"mode\": \"strict\"\n  },\n  \"deliveryProfiles\": {\n    \"cli-surface\": {\n      \"kind\": \"surface\",\n      \"requiredEvidenceClasses\": [\n        \"reachability\"\n      ],\n      \"anyEvidenceClasses\": [\n        \"integration\",\n        \"e2e\"\n      ]\n    },\n    \"composed-capability\": {\n      \"kind\": \"capability\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"api-contract\": {\n      \"kind\": \"contract\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"release-governance\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"backend-go\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"structural-delta\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    }\n  },\n  \"stacks\": {\n    \"node\": {\n      \"checks\": [\n        {\n          \"name\": \"lint\",\n          \"program\": \"npm\",\n          \"args\": [\n            \"run\",\n            \"lint\",\n            \"--if-present\"\n          ],\n          \"severity\": \"optional\",\n          \"evidenceClass\": \"lint\"\n        },\n        {\n          \"name\": \"test\",\n          \"program\": \"npm\",\n          \"args\": [\n            \"test\",\n            \"--if-present\"\n          ],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"unit\"\n        },\n   385\t\t\ttab := strings.IndexByte(entry, '\\t')\n   386\t\t\tfields := strings.Fields(entry[:max(tab, 0)])\n   387\t\t\tif tab < 0 || len(fields) != 3 {\n   388\t\t\t\treturn nil, fmt.Errorf(\"unexpected tree entry %q\", entry)\n   389\t\t\t}\n   390\t\t\tlinks[entry[tab+1:]] = fields[2]\n   391\t\t}\n   392\t\treturn links, nil\n   393\t}\n   394\t\n   395\t// submoduleAliases names a submodule that could hide an alias: one holding a\n   396\t// module or a declared dependency that is not checked out at its recorded\n   397\t// commit, or that itself has gitlinks, or whose tree tracks an aliasing\n   398\t// symlink.\n   399\tfunc submoduleAliases(root, head string, modules []validationModule, meta scopeMetadata) (string, error) {\n   400\t\tlinks, err := gitlinks(root, head)\n   401\t\tif err != nil {\n   402\t\t\treturn \"\", err\n   403\t\t}\n   404\t\tholds := func(sub string) bool {\n   405\t\t\tfor _, m := range modules {\n   406\t\t\t\tif m.Rel == sub || strings.HasPrefix(m.Rel, sub+\"/\") {\n   407\t\t\t\t\treturn true\n   408\t\t\t\t}\n   409\t\t\t}\n   410\t\t\tfor _, module := range meta.Modules {\n   411\t\t\t\tfor _, dep := range module.DependsOn {\n   412\t\t\t\t\tdep = filepath.ToSlash(filepath.Clean(dep))\n   413\t\t\t\t\tif dep == \".\" || dep == sub || strings.HasPrefix(dep, sub+\"/\") || strings.HasPrefix(sub, dep+\"/\") {\n   414\t\t\t\t\t\treturn true\n   415\t\t\t\t\t}\n   416\t\t\t\t}\n   417\t\t\t}\n   418\t\t\treturn false\n   419\t\t}\n   420\t\tfor sub, commit := range links {\n   421\t\t\tif !holds(sub) {\n   422\t\t\t\tcontinue\n   423\t\t\t}\n   424\t\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n   425\t\t\tif err := posemodel.RawGit(\"-C\", repo, \"cat-file\", \"-e\", commit+\"^{commit}\").Run(); err != nil {\n   426\t\t\t\treturn fmt.Sprintf(\"submodule %s is not checked out at its recorded commit, so aliases in it cannot be ruled out\", sub), nil\n   427\t\t\t}\n   428\t\t\tnested, err := gitlinks(repo, commit)\n   429\t\t\tif err != nil {\n   430\t\t\t\treturn \"\", err\n   431\t\t\t}\n   432\t\t\tif len(nested) > 0 {\n   433\t\t\t\treturn fmt.Sprintf(\"submodule %s has nested submodules, so aliases in it cannot be ruled out\", sub), nil\n   434\t\t\t}\n   435\t\t\tlink, err := aliasingSymlinkIn(root, repo, commit, sub, modules, meta)\n   436\t\t\tif err != nil {\n   437\t\t\t\treturn \"\", err\n   438\t\t\t}\n   439\t\t\tif link != \"\" {\n   440\t\t\t\treturn fmt.Sprintf(\"the tree tracks symlink %s into or out of a module or a declared dependency, so changes cannot be attributed\", link), nil\n   441\t\t\t}\n   442\t\t}\n   443\t\treturn \"\", nil\n   444\t}\n   445\t\n   446\t// carryRelevantDirs are the directories whose case behaviour decides whether\n   447\t// lexical selection is sound: every module directory and the nearest existing\n   448\t// directory of every declared dependency.\n   449\tfunc carryRelevantDirs(root string, modules []validationModule, meta scopeMetadata) []string {\n   450\t\tdirs := []string{}\n   451\t\tfor _, m := range modules {\n   452\t\t\tdirs = append(dirs, m.Abs)\n   453\t\t}\n   454\t\tfor _, module := range meta.Modules {\n   455\t\t\tfor _, dep := range module.DependsOn {\n   456\t\t\t\tp := filepath.Join(root, filepath.FromSlash(filepath.ToSlash(filepath.Clean(dep))))\n   457\t\t\t\tfor {\n   458\t\t\t\t\tif info, err := os.Stat(p); err == nil && info.IsDir() {\n   459\t\t\t\t\t\tdirs = append(dirs, p)\n   460\t\t\t\t\t\tbreak\n   461\t\t\t\t\t}\n   462\t\t\t\t\tparent := filepath.Dir(p)\n   463\t\t\t\t\tif parent == p || len(parent) < len(root) {\n   464\t\t\t\t\t\tbreak\n   465\t\t\t\t\t}\n   466\t\t\t\t\tp = parent\n   467\t\t\t\t}\n   468\t\t\t}\n   469\t\t}\n   470\t\treturn dirs\n   471\t}\n   472\t\n   473\t// casefoldedDirectory reports whether dir looks names up without case: an\n   474\t// entry spelled with its letters' case swapped names the same file.\n   475\tfunc casefoldedDirectory(dir string, readDir func(string) ([]os.DirEntry, error), stat func(string) (os.FileInfo, error)) bool {\n   476\t\tentries, err := readDir(dir)\n   477\t\tif err != nil {\n   478\t\t\treturn false\n   479\t\t}\n   480\t\tfor _, entry := range entries {\n   481\t\t\tname := entry.Name()\n   482\t\t\tswapped := swapCase(name)\n   483\t\t\tif swapped == name {\n   484\t\t\t\tcontinue\n   485\t\t\t}\n   486\t\t\toriginal, err := stat(filepath.Join(dir, name))\n   487\t\t\tif err != nil {\n   488\t\t\t\treturn false\n   489\t\t\t}\n   490\t\t\tother, err := stat(filepath.Join(dir, swapped))\n   491\t\t\treturn err == nil && os.SameFile(original, other)\n   492\t\t}\n   493\t\treturn false\n   494\t}\n   495\t\n---\ntype: decision-log\nslug: module-metadata-discovery-invalidates-review-provenance\nowner: @pose-maintainers\nsensitivity: public-internal\ncreated_at: 2026-08-16\nlast_reviewed_at: 2026-08-16\nexpires_at: 2026-11-14\nsource_refs:\n  spec: \"pose-upgrade-path-audit-fixes\"\n  workflow: \"bugfix\"\n  commands: [\"pose update --force\", \"pose install\", \"pose index\", \"pose review bundle --seal\"]\n  external_sources: []\n---\n\n# decision-log: module-metadata-discovery-invalidates-review-provenance\n\n## Context\n\nAuditing `pose update`/`pose install` across 7 real repositories ahead of\nthe v1.4.0 release found that running either command on `pose-dist` itself\n(the product's own dogfooding instance) discovered\n`examples/brownfield-kits/direct-adoption/fixture/service/go.mod` — an\nillustrative fixture, not a real deliverable module — as a genuine module\nand added it to `.pose/indexes/module-metadata.json`. That single addition\nrecomputed the global provenance digest (`graph.ProvenanceDigest`, computed\nover the whole delivery-integrity graph, not per-spec — see the\n`pose-gate-closeout-procedure` session note this decision-log\ngeneralizes) and superseded the review attestation of every already-closed\nspec whose scope touches `module-metadata.json`: between 3 and 22 specs\nacross the audit's trial runs, depending on which other specs had most\nrecently closed.\n\n## Current state\n\nFixed the trigger only (spec `pose-upgrade-path-audit-fixes`, R7):\n`testdata`, `fixture` and `fixtures` directories are now excluded from\nmodule discovery in all three independent walkers\n(`discoverValidationModules` in validate.go, `scanModules` in index.go,\nand `internal/pose/discovery.go`'s capability scanner). A genuine,\nintentional module-metadata change — a real module added, removed or\nreclassified — still invalidates every closed spec's review attestation\nthat touches it, exactly as designed today. That broader behavior was\ndeliberately left unchanged (Decision 2 in the spec above): narrowing the\nprovenance digest so it only invalidates reviews whose scope actually\nincludes the changed module is a real design trade-off (what counts as\n\"unrelated,\" whether a narrower digest weakens the guarantee it exists to\nprovide) that deserves its own spec and explicit review, not a side effect\nof fixing a discovery false-positive.\n\n## Next checks\n\n- None deterministic yet. If a future spec pursues narrowing the\n  provenance digest, `pose-mcp/internal/pose/delivery_integrity.go`\n  (`ProvenanceDigest`) and `pose review bundle --seal`'s scope-provenance\n  matching are the two places to start reading.\n\n## Risks\n\n- Any *other* directory-discovery path added in the future (a fourth\n  scanner, or a stack detector that walks the tree independently) needs\n  the same `testdata`/`fixture`/`fixtures` exclusion applied by hand —\n  there is no single shared walker all three call today (each has its own\n  `ignored` map/condition; see the follow-up already on record about this\n  in `pose-review-bundle-roadmap-path-portability`/session knowledge about\n  \"enumerate by hand\" gaps recurring across this repository).\n- Every maintainer who runs `pose update --force`/`pose install` on\n  `pose-dist` itself after a *real* module-metadata change should expect\n  to reseal/reattest every closed spec whose review scope includes\n  `module-metadata.json`, per `pose-gate-closeout-procedure` — this is\n  expected, not a bug, and this decision-log's fix does not change it.\n\n## Next owner\n\n@pose-maintainers — no active handoff; revisit only if the digest-scoping\nfollow-up (spec `pose-upgrade-path-audit-fixes`, Follow-ups) is picked up.\n\n## References\n\n- spec:pose-upgrade-path-audit-fixes (Decision 2, R7, Non-goals)\n- knowledge: session note `pose-gate-closeout-procedure` (this repository's\n  own local agent memory, not a `.pose/knowledge/` artifact) — first\n  documented that the provenance digest is global-over-the-graph, not\n  per-spec, and that reseal/reattest is required after any reindex that\n  changes it.\n","exit_code":0,"status":"completed"}}
