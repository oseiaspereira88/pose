\",\"`+commit+`\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\":{\"go\":{\"checks\":[`, 1))\npose-mcp/internal/cli/validate_carry_test.go:539:func TestChangedScopeEvaluatesEveryDeclaredDependency(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:554:func TestValidateHeadMovingDuringTheRunBindsNoMaterial(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:566:\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\":{\"go\":{\"checks\":[`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"moves\",\"program\":\"sh\",\"args\":[\"-c\",\"`+commit+`\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\":{\"go\":{\"checks\":[`, 1))\npose-mcp/internal/cli/validate_carry_test.go:581:func TestCarryRefusesModulesSharingADirectory(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:601:func TestCarryPlansAgainstThePinnedHead(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:628:func TestChangedScopeDiscoveredAncestorDependencySelectsItsDependents(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:652:func TestCarryRefusesDependenciesReachedThroughASymlink(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:669:func TestCarryRefusesASymlinkInsideAModule(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:686:func TestCarryAllowsSymlinksBetweenUnownedPaths(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:707:func TestCarryDetectsACaseInsensitiveFilesystem(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:729:func TestCarryRefusesDuplicateCheckIDs(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:732:\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\"`, `\"moduleOverrides\":{\"b\":{\"checks\":[{\"name\":\"ok\",\"program\":\"true\",\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\"`, 1))\npose-mcp/internal/cli/validate_carry_test.go:746:fu