{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UBrm8gBZQ9RfjzkgJbMr7E","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"fmt\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t)\n9\t\n10\tconst (\n11\t\tReviewReuseVerifiedSource       = \"verified-source\"\n12\t\tReviewReuseCurrentReaffirmation = \"current-reaffirmation\"\n13\t\treviewReuseMaxDepth             = 16\n14\t\treviewReuseMaxNodes             = 32\n15\t\treviewReuseMaxEdges             = 128\n16\t\treviewReuseMaxBytes             = 16 << 20\n17\t)\n18\t\n19\ttype ReviewReuseDisclosure struct {\n20\t\tCriterion       string   `json:\"criterion\"`\n21\t\tFromAttestation string   `json:\"from_attestation\"`\n22\t\tMode            string   `json:\"mode\"`\n23\t\tState           string   `json:\"state\"`\n24\t\tBlockers        []string `json:\"blockers,omitempty\"`\n25\t}\n26\t\n27\ttype reviewReuseEvaluation struct {\n28\t\tblockers   []string\n29\t\tdisclosure []ReviewReuseDisclosure\n30\t}\n31\t\n32\ttype childVerificationResult struct {\n33\t\tverification ReviewBundleVerification\n34\t\terr          error\n35\t}\n36\t\n37\ttype reviewReuseTraversal struct {\n38\t\tevaluations         map[string]reviewReuseEvaluation\n39\t\tactive              map[string]bool\n40\t\tmemo                map[string][]string\n41\t\tattestations        map[string]ReviewAttestation\n42\t\tbundles             map[string]ReviewBundle\n43\t\tchildren            map[string]childVerificationResult\n44\t\tverifying           map[string]bool\n45\t\tdepth, nodes, edges int\n46\t\tbytes               int64\n47\t}\n48\t\n49\tfunc newReviewReuseTraversal() *reviewReuseTraversal {\n50\t\treturn &reviewReuseTraversal{children: map[string]childVerificationResult{}, verifying: map[string]bool{}, evaluations: map[string]reviewReuseEvaluation{}, active: map[string]bool{}, memo: map[string][]string{}, attestations: map[string]ReviewAttestation{}, bundles: map[string]ReviewBundle{}}\n51\t}\n52\t\n53\tfunc (s Store) reserveReuseArtifact(dir, id string) error {\n54\t\tif !filepath.IsLocal(id) || (dir != \"review-attestations\" && dir != \"review-bundles\") {\n55\t\t\treturn fmt.Errorf(\"invalid reuse artifact path\")\n56\t\t}\n57\t\tif _, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.Join(\".pose\", dir), false); err != nil {\n58\t\t\treturn err\n59\t\t}\n60\t\tpath := filepath.Join(s.Root, \".pose\", dir, id+\".json\")\n61\t\tinfo, err := s.fsys().Lstat(path)\n62\t\tif err != nil {\n63\t\t\treturn fmt.Errorf(\"reuse source unavailable: %w\", err)\n64\t\t}\n65\t\tif !info.Mode().IsRegular() || info.Size() > maxReviewBundleBytes {\n66\t\t\treturn fmt.Errorf(\"reuse source is not a bounded regular artifact\")\n67\t\t}\n68\t\tif s.reviewReuse.bytes+info.Size() > reviewReuseMaxBytes {\n69\t\t\treturn fmt.Errorf(\"reuse traversal byte budget exceeded (inconclusive)\")\n70\t\t}\n71\t\ts.reviewReuse.bytes += info.Size()\n72\t\treturn nil\n73\t}\n74\t\n75\tfunc (s Store) loadReuseAttestation(id string) (ReviewAttestation, error) {\n76\t\tstate := s.reviewReuse\n77\t\tstate.edges++\n78\t\tif state.edges > reviewReuseMaxEdges {\n79\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"reuse traversal edge budget exceeded (inconclusive)\")\n80\t\t}\n81\t\tif att, ok := state.attestations[id]; ok {\n82\t\t\treturn att, nil\n83\t\t}\n84\t\tif state.nodes >= reviewReuseMaxNodes {\n85\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"reuse traversal node budget exceeded (inconclusive)\")\n86\t\t}\n87\t\t// Validate ids before constructing a path or inspecting source metadata.\n88\t\tif len(id) != 20 || id[:4] != \"rva-\" {\n89\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"invalid reuse attestation id\")\n90\t\t}\n91\t\tfor _, c := range id[4:] {\n92\t\t\tif !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {\n93\t\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"invalid reuse attestation id\")\n94\t\t\t}\n95\t\t}\n96\t\tif err := s.reserveReuseArtifact(\"review-attestations\", id); err != nil {\n97\t\t\treturn ReviewAttestation{}, err\n98\t\t}\n99\t\tatt, err := s.LoadReviewAttestation(id)\n100\t\tif err != nil {\n101\t\t\treturn att, err\n102\t\t}\n103\t\tstate.nodes++\n104\t\tstate.attestations[id] = att\n105\t\treturn att, nil\n106\t}\n107\t\n108\tfunc (s Store) loadReuseBundle(id string) (ReviewBundle, error) {\n109\t\tif b, ok := s.reviewReuse.bundles[id]; ok {\n110\t\t\treturn b, nil\n111\t\t}\n112\t\tif len(id) != 20 || id[:4] != \"rvb-\" {\n113\t\t\treturn ReviewBundle{}, fmt.Errorf(\"invalid reuse bundle id\")\n114\t\t}\n115\t\tfor _, c := range id[4:] {\n116\t\t\tif !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {\n117\t\t\t\treturn ReviewBundle{}, fmt.Errorf(\"invalid reuse bundle id\")\n118\t\t\t}\n119\t\t}\n120\t\tif err := s.reserveReuseArtifact(\"review-bundles\", id); err != nil {\n121\t\t\treturn ReviewBundle{}, err\n122\t\t}\n123\t\tb, err := s.LoadReviewBundle(id)\n124\t\tif err == nil {\n125\t\t\ts.reviewReuse.bundles[id] = b\n126\t\t}\n127\t\treturn b, err\n128\t}\n129\t\n130\tfunc (s Store) verifyReuseSource(bundle ReviewBundle, att ReviewAttestation) []string {\n131\t\ts = s.reviewOperation()\n132\t\tstate := s.reviewReuse\n133\t\t// The state belongs to one clock and trust context only. Content, including\n134\t\t// proof, is in the memo key; a name alone never memoizes a verification.\n135\t\traw, _ := json.Marshal(att)\n136\t\tkey := att.AttestationID + \":\" + bundle.BundleDigest + \":\" + digestBytes(raw) + \":\" + s.reviewTrustContextDigest()\n137\t\tif state.active[att.AttestationID] {\n138\t\t\treturn []string{\"reuse provenance cycle (inconclusive)\"}\n139\t\t}\n140\t\tif state.depth >= reviewReuseMaxDepth {\n141\t\t\treturn []string{\"reuse traversal depth budget exceeded (inconclusive)\"}\n142\t\t}\n143\t\tif prior, ok := state.memo[key]; ok {\n144\t\t\treturn append([]string{}, prior...)\n145\t\t}\n146\t\tstate.active[att.AttestationID] = true\n147\t\tstate.depth++\n148\t\tdefer func() { delete(state.active, att.AttestationID); state.depth-- }()\n149\t\tblockers := []string{}\n150\t\tif att.Envelope == nil {\n151\t\t\tblockers = append(blockers, \"verified-source requires a signed source; legacy reference is not a verified historical pass\")\n152\t\t} else if err := s.verifyStoredReviewAttestationSignature(att); err != nil {\n153\t\t\tblockers = append(blockers, \"reuse source proof: \"+err.Error())\n154\t\t}\n155\t\tblockers = append(blockers, s.reviewAuthorityTime(att).HistoricalBlockers...)\n156\t\tblockers = append(blockers, s.validateBundleAttestationWith(bundle, att, false)...)\n157\t\tstate.memo[key] = append([]string{}, blockers...)\n158\t\treturn blockers\n159\t}\n160\t\n161\tfunc reviewReaffirmedCriterion(att ReviewAttestation, id string) bool {\n162\t\tfor _, c := range att.Criteria {\n163\t\t\tif c.ID == id && c.Disposition == \"passed\" && strings.TrimSpace(c.Rationale) != \"\" {\n164\t\t\t\treturn true\n165\t\t\t}\n166\t\t}\n167\t\treturn false\n168\t}\n169\t\n170\tfunc (s Store) describeReviewReuse(bundle ReviewBundle, att ReviewAttestation) []ReviewReuseDisclosure {\n171\t\t_, disclosure := s.evaluateReviewReuse(bundle, att, bundle.Payload.SealedGates().AllowCriterionReuse)\n172\t\treturn disclosure\n173\t}\n174\t\n175\tfunc (s Store) evaluateReviewReuse(bundle ReviewBundle, att ReviewAttestation, allowed bool) ([]string, []ReviewReuseDisclosure) {\n176\t\tif len(att.ReusedFrom) == 0 {\n177\t\t\treturn nil, nil\n178\t\t}\n179\t\ts = s.reviewOperation()\n180\t\traw, _ := json.Marshal(att)\n181\t\tkey := bundle.BundleDigest + \":\" + digestBytes(raw) + \":\" + s.reviewTrustContextDigest() + fmt.Sprint(allowed)\n182\t\tif result, ok := s.reviewReuse.evaluations[key]; ok {\n183\t\t\treturn result.blockers, result.disclosure\n184\t\t}\n185\t\tblockers := []string{}\n186\t\tout := []ReviewReuseDisclosure{}\n187\t\tseen := map[string]bool{}\n188\t\trequired := map[string]ReviewPlanCriterion{}\n189\t\tfor _, c := range bundle.Payload.Plan.Criteria {\n190\t\t\tif c.Required {\n191\t\t\t\trequired[c.ID] = c\n192\t\t\t}\n193\t\t}\n194\t\tfor _, reuse := range att.ReusedFrom {\n195\t\t\td := ReviewReuseDisclosure{Criterion: reuse.Criterion, FromAttestation: reuse.FromAttestation, Mode: reuse.Mode, State: \"inconclusive\"}\n196\t\t\tadd := func(message string) { d.Blockers = append(d.Blockers, message) }\n197\t\t\tif seen[reuse.Criterion] {\n198\t\t\t\tadd(\"duplicate reused criterion \" + reuse.Criterion)\n199\t\t\t}\n200\t\t\tseen[reuse.Criterion] = true\n201\t\t\tif !allowed {\n202\t\t\t\tadd(\"criterion reuse is not permitted by the bundle's sealed gates\")\n203\t\t\t}\n204\t\t\tcurrent, ok := required[reuse.Criterion]\n205\t\t\tif !ok {\n206\t\t\t\tadd(\"reused criterion \" + reuse.Criterion + \" is not required by the current bundle\")\n207\t\t\t} else if reviewCriterionInputDigest(bundle, current) != reuse.InputDigest {\n208\t\t\t\tadd(\"reused criterion \" + reuse.Criterion + \" input digest changed\")\n209\t\t\t}\n210\t\t\tif len(d.Blockers) == 0 {\n211\t\t\t\tprior, err := s.loadReuseAttestation(reuse.FromAttestation)\n212\t\t\t\tif err != nil {\n213\t\t\t\t\tadd(\"references an unavailable attestation: \" + err.Error())\n214\t\t\t\t} else if b, err := s.loadReuseBundle(prior.BundleID); err != nil {\n215\t\t\t\t\tadd(\"references an unavailable bundle: \" + err.Error())\n216\t\t\t\t} else {\n217\t\t\t\t\tfor _, blocker := range reviewFindingDecisionBlockers(b, prior) {\n218\t\t\t\t\t\tadd(\"references a non-approving attestation: \" + blocker)\n219\t\t\t\t\t}\n220\t\t\t\t\tcontract := \"\"\n221\t\t\t\t\tfor _, c := range b.Payload.Plan.Criteria {\n222\t\t\t\t\t\tif c.ID == reuse.Criterion && c.Required {\n223\t\t\t\t\t\t\tcontract = reviewCriterionInputDigest(b, c)\n224\t\t\t\t\t\t}\n225\t\t\t\t\t}\n226\t\t\t\t\tpassed := false\n227\t\t\t\t\tfor _, c := range prior.Criteria {\n228\t\t\t\t\t\tif c.ID == reuse.Criterion && c.Disposition == \"passed\" {\n229\t\t\t\t\t\t\tpassed = true\n230\t\t\t\t\t\t}\n231\t\t\t\t\t}\n232\t\t\t\t\tif contract != reuse.InputDigest || !passed {\n233\t\t\t\t\t\tadd(\"source criterion is not unchanged and passed\")\n234\t\t\t\t\t}\n235\t\t\t\t\tswitch reuse.Mode {\n236\t\t\t\t\tcase ReviewReuseVerifiedSource:\n237\t\t\t\t\t\td.Blockers = append(d.Blockers, s.verifyReuseSource(b, prior)...)\n238\t\t\t\t\t\tif len(d.Blockers) == 0 {\n239\t\t\t\t\t\t\td.State = \"source-verified-under-current-trust\"\n240\t\t\t\t\t\t}\n241\t\t\t\t\tcase ReviewReuseCurrentReaffirmation:\n242\t\t\t\t\t\tif !reviewReaffirmedCriterion(att, reuse.Criterion) {\n243\t\t\t\t\t\t\tadd(\"current-reaffirmation requires a current passed judgment with a conclusion\")\n244\t\t\t\t\t\t}\n245\t\t\t\t\t\tif len(d.Blockers) == 0 {\n246\t\t\t\t\t\t\td.State = \"current-judgment-recorded\"\n247\t\t\t\t\t\t}\n248\t\t\t\t\tcase \"\":\n249\t\t\t\t\t\td.Mode = \"legacy-reaffirmation\"\n250\t\t\t\t\t\tif len(d.Blockers) == 0 {\n251\t\t\t\t\t\t\td.State = \"historical-pass-not-verified\"\n252\t\t\t\t\t\t}\n253\t\t\t\t\tdefault:\n254\t\t\t\t\t\tadd(\"unsupported reuse mode\")\n255\t\t\t\t\t}\n256\t\t\t\t}\n257\t\t\t}\n258\t\t\tfor _, b := range d.Blockers {\n259\t\t\t\tblockers = append(blockers, \"reused criterion \"+reuse.Criterion+\": \"+b)\n260\t\t\t}\n261\t\t\tout = append(out, d)\n262\t\t}\n263\t\ts.reviewReuse.evaluations[key] = reviewReuseEvaluation{blockers, out}\n264\t\treturn blockers, out\n265\t}\n266\t\n267\tfunc (s Store) reviewTrustContextDigest() string {\n268\t\tpolicy, _, err := s.loadReviewPolicy()\n269\t\tif err != nil {\n270\t\t\treturn \"invalid-policy:\" + err.Error()\n271\t\t}\n272\t\traw, _ := json.Marshal(policy)\n273\t\treturn digestBytes(raw)\n274\t}\n275\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"f3d36491-1b44-4ec6-8ddf-ddf029b8ce22","timestamp":"2026-11-26T00:38:00.328Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3050911272/worktree/pose-mcp/internal/pose/review_reuse_provenance.go","content":"package pose\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"path/filepath\"\n\t\"strings\"\n)\n\nconst (\n\tReviewReuseVerifiedSource       = \"verified-source\"\n\tReviewReuseCurrentReaffirmation = \"current-reaffirmation\"\n\treviewReuseMaxDepth             = 16\n\treviewReuseMaxNodes             = 32\n\treviewReuseMaxEdges             = 128\n\treviewReuseMaxBytes             = 16 << 20\n)\n\ntype ReviewReuseDisclosure struct {\n\tCriterion       string   `json:\"criterion\"`\n\tFromAttestation string   `json:\"from_attestation\"`\n\tMode            string   `json:\"mode\"`\n\tState           string   `json:\"state\"`\n\tBlockers        []string `json:\"blockers,omitempty\"`\n}\n\ntype reviewReuseEvaluation struct {\n\tblockers   []string\n\tdisclosure []ReviewReuseDisclosure\n}\n\ntype childVerificationResult struct {\n\tverification ReviewBundleVerification\n\terr          error\n}\n\ntype reviewReuseTraversal struct {\n\tevaluations         map[string]reviewReuseEvaluation\n\tactive              map[string]bool\n\tmemo                map[string][]string\n\tattestations        map[string]ReviewAttestation\n\tbundles             map[string]ReviewBundle\n\tchildren            map[string]childVerificationResult\n\tverifying           map[string]bool\n\tdepth, nodes, edges int\n\tbytes               int64\n}\n\nfunc newReviewReuseTraversal() *reviewReuseTraversal {\n\treturn &reviewReuseTraversal{children: map[string]childVerificationResult{}, verifying: map[string]bool{}, evaluations: map[string]reviewReuseEvaluation{}, active: map[string]bool{}, memo: map[string][]string{}, attestations: map[string]ReviewAttestation{}, bundles: map[string]ReviewBundle{}}\n}\n\nfunc (s Store) reserveReuseArtifact(dir, id string) error {\n\tif !filepath.IsLocal(id) || (dir != \"review-attestations\" && dir != \"review-bundles\") {\n\t\treturn fmt.Errorf(\"invalid reuse artifact path\")\n\t}\n\tif _, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.Join(\".pose\", dir), false); err != nil {\n\t\treturn err\n\t}\n\tpath := filepath.Join(s.Root, \".pose\", dir, id+\".json\")\n\tinfo, err := s.fsys().Lstat(path)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"reuse source unavailable: %w\", err)\n\t}\n\tif !info.Mode().IsRegular() || info.Size() > maxReviewBundleBytes {\n\t\treturn fmt.Errorf(\"reuse source is not a bounded regular artifact\")\n\t}\n\tif s.reviewReuse.bytes+info.Size() > reviewReuseMaxBytes {\n\t\treturn fmt.Errorf(\"reuse traversal byte budget exceeded (inconclusive)\")\n\t}\n\ts.reviewReuse.bytes += info.Size()\n\treturn nil\n}\n\nfunc (s Store) loadReuseAttestation(id string) (ReviewAttestation, error) {\n\tstate := s.reviewReuse\n\tstate.edges++\n\tif state.edges > reviewReuseMaxEdges {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"reuse traversal edge budget exceeded (inconclusive)\")\n\t}\n\tif att, ok := state.attestations[id]; ok {\n\t\treturn att, nil\n\t}\n\tif state.nodes >= reviewReuseMaxNodes {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"reuse traversal node budget exceeded (inconclusive)\")\n\t}\n\t// Validate ids before constructing a path or inspecting source metadata.\n\tif len(id) != 20 || id[:4] != \"rva-\" {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"invalid reuse attestation id\")\n\t}\n\tfor _, c := range id[4:] {\n\t\tif !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {\n\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"invalid reuse attestation id\")\n\t\t}\n\t}\n\tif err := s.reserveReuseArtifact(\"review-attestations\", id); err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tatt, err := s.LoadReviewAttestation(id)\n\tif err != nil {\n\t\treturn att, err\n\t}\n\tstate.nodes++\n\tstate.attestations[id] = att\n\treturn att, nil\n}\n\nfunc (s Store) loadReuseBundle(id string) (ReviewBundle, error) {\n\tif b, ok := s.reviewReuse.bundles[id]; ok {\n\t\treturn b, nil\n\t}\n\tif len(id) != 20 || id[:4] != \"rvb-\" {\n\t\treturn ReviewBundle{}, fmt.Errorf(\"invalid