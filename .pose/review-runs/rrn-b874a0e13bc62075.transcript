t least one, the one\n366\t\t\t\t// that does not is abandoned exactly once.\n367\t\t\t\tif reply.Drained < tc.wantDrained || reply.Abandoned != tc.wantAb {\n368\t\t\t\t\tt.Fatalf(\"drained %d abandoned %d, want at least %d and exactly %d\", reply.Drained, reply.Abandoned, tc.wantDrained, tc.wantAb)\n369\t\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"a3f5e250-3bb0-4bc4-b8af-f9687e5dfbaa","timestamp":"2026-11-26T00:39:46.466Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3050911272/worktree/pose-mcp/internal/worktreeruntime/runtime_test.go","content":"\t\thold, drain         time.Duration\n\t\twantDrained, wantAb int64\n\t}{\n\t\t{\"drained\", 150 * time.Millisecond, 3 * time.Second, 1, 0},\n\t\t{\"abandoned\", 2 * time.Second, 100 * time.Millisecond, 0, 1},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tid := identity(t, repo(t), \"7.4.1\")\n\t\t\tdir := shortDir(t)\n\t\t\tentered := make(chan struct{}, 1)\n\t\t\tctx, cancel := context.WithCancel(context.Background())\n\t\t\tdefer cancel()\n\t\t\tdone := make(chan error, 1)\n\t\t\tgo func() {\n\t\t\t\tdone <- Serve(ctx, Options{Identity: id, Dir: dir, Handler: func(_ context.Context, req Request) (Reply, bool) {\n\t\t\t\t\tif req.Op != \"hold\" {\n\t\t\t\t\t\treturn Reply{}, false\n\t\t\t\t\t}\n\t\t\t\t\tentered <- struct{}{}\n\t\t\t\t\ttime.Sleep(tc.hold)\n\t\t\t\t\treturn Reply{OK: true}, true\n\t\t\t\t}})\n\t\t\t}()\n\t\t\tc := Client{Identity: id, Dir: dir}\n\t\t\tfor i := 0; i < 200; i++ {\n\t\t\t\tif _, err := c.Status(context.Background()); err == nil {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\ttime.Sleep(10 * time.Millisecond)\n\t\t\t}\n\t\t\tgo c.Do(context.Background(), \"hold\")\n\t\t\t<-entered\n\t\t\tstopped := make(chan Reply, 1)\n\t\t\tgo func() { r, _ := c.Stop(context.Background(), tc.drain); stopped <- r }()\n\t\t\ttime.Sleep(50 * time.Millisecond)\n\t\t\tif _, err := c.Status(context.Background()); !errors.Is(err, Er