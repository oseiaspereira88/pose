{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NSRBEGgav8EJ1vTHLnkZRD","type":"tool_result","content":"200\t\tvar draft ReviewDraft\n201\t\tdec := json.NewDecoder(bytes.NewReader(raw))\n202\t\tdec.DisallowUnknownFields()\n203\t\tif err := dec.Decode(&draft); err != nil {\n204\t\t\treturn nil, fmt.Errorf(\"the pose-draft block is not a draft: %v\", err)\n205\t\t}\n206\t\tif _, err := dec.Token(); err != io.EOF {\n207\t\t\treturn nil, fmt.Errorf(\"the pose-draft block carries data after the draft\")\n208\t\t}\n209\t\tif err := exactJSONKeys(json.NewDecoder(bytes.NewReader(raw)), reflect.TypeOf(draft)); err != nil {\n210\t\t\treturn nil, fmt.Errorf(\"the pose-draft block is ambiguous: %v\", err)\n211\t\t}\n212\t\tif err := validateReviewDraft(draft); err != nil {\n213\t\t\treturn nil, err\n214\t\t}\n215\t\tfor i, line := range lines {\n216\t\t\tif i > open && i <= close {\n217\t\t\t\tcontinue\n218\t\t\t}\n219\t\t\tkey, value, ok := strings.Cut(strings.TrimSpace(line), \":\")\n220\t\t\tif ok && key == \"decision\" && strings.TrimSpace(value) != draft.Decision {\n221\t\t\t\treturn nil, fmt.Errorf(\"the draft's decision %s differs from the decision line %q\", draft.Decision, strings.TrimSpace(value))\n222\t\t\t}\n223\t\t}\n224\t\treturn &draft, nil\n225\t}\n226\t\n227\t// draftReviewDecision is the decision a run's final message declares: the\n228\t// pose-draft block's when there is one, which a contradicting decision line\n229\t// makes unknown, or else the legacy decision line (review round 1, B13).\n230\tfunc draftReviewDecision(output string) string {\n231\t\tdraft, err := ParseReviewDraft(output)\n232\t\tswitch {\n233\t\tcase err != nil:\n234\t\t\treturn \"unknown\"\n235\t\tcase draft != nil:\n236\t\t\treturn draft.Decision\n237\t\t}\n238\t\treturn legacyReviewDecision(output)\n239\t}\n240\t\n241\tfunc validateReviewDraft(d ReviewDraft) error {\n242\t\tif d.Schema != ReviewDraftSchema {\n243\t\t\treturn fmt.Errorf(\"the draft's schema is %q, not %s\", d.Schema, ReviewDraftSchema)\n244\t\t}\n245\t\tswitch d.Decision {\n246\t\tcase \"approved\", \"changes-requested\", \"rejected\":\n247\t\tdefault:\n248\t\t\treturn fmt.Errorf(\"the draft's decision %q is not approved, changes-requested or rejected\", d.Decision)\n249\t\t}\n250\t\tif len(d.Findings) > reviewDraftMaxFindings || len(d.PriorFindings) > reviewDraftMaxFindings || len(d.Sweep) > reviewDraftMaxText {\n251\t\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n252\t\t}\n253\t\tseen := map[string]bool{}\n254\t\tfor _, f := range d.Findings {\n255\t\t\tswitch {\n256\t\t\tcase !reviewFindingID.MatchString(f.ID) || reviewRoundPrefix.MatchString(f.ID) || seen[f.ID]:\n257\t\t\t\treturn fmt.Errorf(\"finding id %q is not a unique identifier without a round prefix\", f.ID)\n258\t\t\tcase f.Severity != \"high\" && f.Severity != \"medium\" && f.Severity != \"low\":\n259\t\t\t\treturn fmt.Errorf(\"finding %s: severity %q is not high, medium or low\", f.ID, f.Severity)\n260\t\t\tcase f.Disposition != \"blocker\" && f.Disposition != \"follow-up\":\n261\t\t\t\treturn fmt.Errorf(\"finding %s: disposition %q is not blocker or follow-up\", f.ID, f.Disposition)\n262\t\t\tcase strings.TrimSpace(f.Summary) == \"\" || len(f.Summary) > reviewDraftMaxText || len(f.File) > 1024 || f.Line < 0:\n263\t\t\t\treturn fmt.Errorf(\"finding %s needs a bounded summary and location\", f.ID)\n264\t\t\t}\n265\t\t\tseen[f.ID] = true\n266\t\t}\n267\t\tanswered := map[string]bool{}\n268\t\tfor _, c := range d.Criteria {\n269\t\t\tswitch {\n270\t\t\tcase ValidateSlug(c.ID) != nil || answered[c.ID]:\n271\t\t\t\treturn fmt.Errorf(\"criterion %q is not a unique criterion id\", c.ID)\n272\t\t\tcase c.Disposition != \"passed\" && c.Disposition != \"finding\" && c.Disposition != \"not-applicable\":\n273\t\t\t\treturn fmt.Errorf(\"criterion %s: disposition %q is not passed, finding or not-applicable\", c.ID, c.Disposition)\n274\t\t\tcase len(c.Evidence) > reviewDraftMaxText || len(c.Rationale) > reviewDraftMaxText || len(c.Mappings) > reviewDraftMaxFindings:\n275\t\t\t\treturn fmt.Errorf(\"criterion %s exceeds its bounds\", c.ID)\n276\t\t\t}\n277\t\t\tfor _, m := range c.Mappings {\n278\t\t\t\tif strings.TrimSpace(m.Delta) == \"\" || len(m.Delta) > 256 || len(m.Basis) > 256 || len(m.Disposition) > 64 || len(m.Rationale) > reviewDraftMaxText || len(m.Owner) > 256 || len(m.ReviewBy) > 64 {\n279\t\t\t\t\treturn fmt.Errorf(\"criterion %s: a mapping needs a delta and bounded text\", c.ID)\n280\t\t\t\t}\n281\t\t\t}\n282\t\t\tanswered[c.ID] = true\n283\t\t}\n284\t\tfor _, t := range d.Tools {\n285\t\t\tif ValidateSlug(t.ID) != nil || strings.TrimSpace(t.Disposition) == \"\" || len(t.Evidence) > reviewDraftMaxText || len(t.Rationale) > reviewDraftMaxText || len(t.Component) > 256 {\n286\t\t\t\treturn fmt.Errorf(\"tool %q needs an id, a disposition and bounded text\", t.ID)\n287\t\t\t}\n288\t\t}\n289\t\tfor _, f := range d.Findings {\n290\t\t\tif len(f.Action) > reviewDraftMaxText || len(f.Owner) > 256 || len(f.ReviewBy) > 64 {\n291\t\t\t\treturn fmt.Errorf(\"finding %s exceeds its bounds\", f.ID)\n292\t\t\t}\n293\t\t}\n294\t\tif len(d.Criteria) > reviewDraftMaxFindings || len(d.Tools) > reviewDraftMaxFindings || len(d.Questions) > reviewDraftMaxFindings || len(d.Surfaces) > reviewDraftMaxFindings {\n295\t\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n296\t\t}\n297\t\tif b := d.BusinessDecision; b != nil {\n298\t\t\tif strings.TrimSpace(b.Question) == \"\" || len(b.Question) > reviewDraftMaxText || len(b.Options) < 2 || len(b.Options) > 8 {\n299\t\t\t\treturn fmt.Errorf(\"a business decision needs a bounded question and two to eight options\")\n300\t\t\t}\n301\t\t\tseen := map[string]bool{}\n302\t\t\tfor _, o := range b.Options {\n303\t\t\t\tif ValidateSlug(o.ID) != nil || seen[o.ID] || strings.TrimSpace(o.Consequence) == \"\" || len(o.Consequence) > reviewDraftMaxText {\n304\t\t\t\t\treturn fmt.Errorf(\"business decision option %q needs a unique slug and its consequence\", o.ID)\n305\t\t\t\t}\n306\t\t\t\tseen[o.ID] = true\n307\t\t\t}\n308\t\t}\n309\t\tasked := map[string]bool{}\n310\t\tfor _, q := range d.Questions {\n311\t\t\tswitch {\n312\t\t\tcase !adjudicationQuestionID.MatchString(q.ID) || asked[q.ID]:\n313\t\t\t\treturn fmt.Errorf(\"question %q is not a unique decision or requirement id\", q.ID)\n314\t\t\tcase q.Verdict != AdjudicationHolds && q.Verdict != AdjudicationDoesNotHold && q.Verdict != AdjudicationCannotDetermine:\n315\t\t\t\treturn fmt.Errorf(\"question %s: verdict %q is not holds, does-not-hold or cannot-determine\", q.ID, q.Verdict)\n316\t\t\tcase strings.TrimSpace(q.Rationale) == \"\" || len(q.Rationale) > reviewDraftMaxText || len(q.Evidence) > reviewDraftMaxText:\n317\t\t\t\treturn fmt.Errorf(\"question %s needs a bounded rationale\", q.ID)\n318\t\t\t}\n319\t\t\tasked[q.ID] = true\n320\t\t}\n321\t\tobserved := map[string]bool{}\n322\t\tfor _, sf := range d.Surfaces {\n323\t\t\tswitch {\n324\t\t\tcase !deliveryRefRE.MatchString(sf.Ref) || observed[sf.Ref]:\n325\t\t\t\treturn fmt.Errorf(\"surface %q is not a unique delivery target\", sf.Ref)\n326\t\t\tcase sf.Outcome != SmokeObserved && sf.Outcome != SmokeNotObserved && sf.Outcome != SmokeNotReachable:\n327\t\t\t\treturn fmt.Errorf(\"surface %s: outcome %q is not observed, not-observed or not-reachable\", sf.Ref, sf.Outcome)\n328\t\t\tcase len(sf.Commands) == 0 || len(sf.Commands) > 64 || strings.TrimSpace(sf.Observed) == \"\" || len(sf.Observed) > reviewDraftMaxText:\n329\t\t\t\treturn fmt.Errorf(\"surface %s needs the commands run and what was observed\", sf.Ref)\n330\t\t\t}\n331\t\t\tfor _, c := range sf.Commands {\n332\t\t\t\tif strings.TrimSpace(c) == \"\" || len(c) > 1024 {\n333\t\t\t\t\treturn fmt.Errorf(\"surface %s: a command must be non-empty and bounded\", sf.Ref)\n334\t\t\t\t}\n335\t\t\t}\n336\t\t\tobserved[sf.Ref] = true\n337\t\t}\n338\t\taccounted := map[string]bool{}\n339\t\tfor _, p := range d.PriorFindings {\n340\t\t\tswitch {\n341\t\t\tcase !reviewCarriedID.MatchString(p.ID) || accounted[p.ID]:\n342\t\t\t\treturn fmt.Errorf(\"prior finding id %q is not a unique carried identifier\", p.ID)\n343\t\t\tcase p.Status != PriorFindingFixed && p.Status != PriorFindingPartial && p.Status != PriorFindingNotFixed && p.Status != PriorFindingSuperseded:\n344\t\t\t\treturn fmt.Errorf(\"prior finding %s: status %q is not fixed, partial, not-fixed or superseded\", p.ID, p.Status)\n345\t\t\tcase len(p.Evidence) > reviewDraftMaxText:\n346\t\t\t\treturn fmt.Errorf(\"prior finding %s: evidence exceeds its bound\", p.ID)\n347\t\t\t}\n348\t\t\taccounted[p.ID] = true\n349\t\t}\n350\t\treturn nil\n351\t}\n352\t\n353\t// ReviewOpenFinding is a finding a round must account for: its identity\n354\t// across rounds, the round it was first reported in, its details and, when it\n355\t// was carried, the account the last round gave it (R2, R5).\n356\ttype ReviewOpenFinding struct {\n357\t\tID          string\n358\t\tRound       int\n359\t\tSeverity    string\n360\t\tDisposition string\n361\t\tFile        string\n362\t\tLine        int\n363\t\tSummary     string\n364\t\tCarried     string\n365\t}\n366\t\n367\t// ReviewRound is the round a bundle is in and what it must account for.\n368\ttype ReviewRound struct {\n369\t\tNumber int\n370\t\t// Prior is the run that concluded the round before, nil in round 1.\n371\t\tPrior       *ReviewRun\n372\t\tPriorBundle *ReviewBundle\n373\t\t// Open are the findings this round must account for.\n374\t\tOpen []ReviewOpenFinding\n375\t\t// Broken names the drafts of the chain that could not be read: a round\n376\t\t// after one opens a new session; its open findings stay open.\n377\t\tBroken string\n378\t}\n379\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"af22c314-77d4-4494-bcb1-09deb719cdcc","timestamp":"2026-11-26T00:19:55.949Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3050911272/worktree/pose-mcp/internal/pose/review_rounds.go","content":"\tvar draft ReviewDraft\n\tdec := json.NewDecoder(bytes.NewReader(raw))\n\tdec.DisallowUnknownFields()\n\tif err := dec.Decode(&draft); err != nil {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block is not a draft: %v\", err)\n\t}\n\tif _, err := dec.Token(); err != io.EOF {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block carries data after the draft\")\n\t}\n\tif err := exactJSONKeys(json.NewDecoder(bytes.NewReader(raw)), reflect.TypeOf(draft)); err != nil {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block is ambiguous: %v\", err)\n\t}\n\tif err := validateReviewDraft(draft); err != nil {\n\t\treturn nil, err\n\t}\n\tfor i, line := range lines {\n\t\tif i > open && i <= close {\n\t\t\tcontinue\n\t\t}\n\t\tkey, value, ok := strings.Cut(strings.TrimSpace(line), \":\")\n\t\tif ok && key == \"decision\" && strings.TrimSpace(value) != draft.Decision {\n\t\t\treturn nil, fmt.Errorf(\"the draft's decision %s differs from the decision line %q\", draft.Decision, strings.TrimSpace(value))\n\t\t}\n\t}\n\treturn &draft, nil\n}\n\n// draftReviewDecision is the decision a run's final message declares: the\n// pose-draft block's when there is one, which a contradicting decision line\n// makes unknown, or else the legacy decision line (review round 1, B13).\nfunc draftReviewDecision(output string) string {\n\tdraft, err := ParseReviewDraft(output)\n\tswitch {\n\tcase err != nil:\n\t\treturn \"unknown\"\n\tcase draft != nil:\n\t\treturn draft.Decision\n\t}\n\treturn legacyReviewDecision(output)\n}\n\nfunc validateReviewDraft(d ReviewDraft) error {\n\tif d.Schema != ReviewDraftSchema {\n\t\treturn fmt.Errorf(\"the draft's schema is %q, not %s\", d.Schema, ReviewDraftSchema)\n\t}\n\tswitch d.Decision {\n\tcase \"approved\", \"changes-requested\", \"rejected\":\n\tdefault:\n\t\treturn fmt.Errorf(\"the draft's decision %q is not approved, changes-requested or rejected\", d.Decision)\n\t}\n\tif len(d.Findings) > reviewDraftMaxFindings || len(d.PriorFindings) > reviewDraftMaxFindings || len(d.Sweep) > reviewDraftMaxText {\n\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n\t}\n\tseen := map[string]bool{}\n\tfor _, f := range d.Findings {\n\t\tswitch {\n\t\tcase !reviewFindingID.MatchString(f.ID) || reviewRoundPrefix.MatchString(f.ID) || seen[f.ID]:\n\t\t\treturn fmt.Errorf(\"finding id %q is not a unique identifier without a round prefix\", f.ID)\n\t\tcase f.Severity != \"high\" && f.Severity != \"medium\" && f.Severity != \"low\":\n\t\t\treturn fmt.Errorf(\"finding %s: severity %q is not high, medium or low\", f.ID, f.Severity)\n\t\tcase f.Disposition != \"blocker\" && f.Disposition != \"follow-up\":\n\t\t\treturn fmt.Errorf(\"finding %s: disposition %q is not blocker or follow-up\", f.ID, f.Disposition)\n\t\tcase strings.TrimSpace(f.Summary) == \"\" || len(f.Summary) > reviewDraftMaxText || len(f.File) > 1024 || f.Line < 0:\n\t\t\treturn fmt.Errorf(\"finding %s needs a bounded summary and location\", f.ID)\n\t\t}\n\t\tseen[f.ID] = true\n\t}\n\tanswered := map[string]bool{}\n\tfor _, c := range d.Criteria {\n\t\tswitch {\n\t\tcase ValidateSlug(c.ID) != nil || answered[c.ID]:\n\t\t\treturn fmt.Errorf(\"criterion %q is not a unique criterion id\", c.ID)\n\t\tcase c.Disposition != \"passed\" && c.Disposition != \"finding\" && c.Disposition != \"not-applicable\":\n\t\t\treturn fmt.Errorf(\"criterion %s: disposition %q is not passed, finding or not-applicable\", c.ID, c.Disposition)\n\t\tcase len(c.Evidence) > reviewDraftMaxText || len(c.Rationale) > reviewDraftMaxText || len(c.Mappings) > reviewDraftMaxFindings:\n\t\t\treturn fmt.Errorf(\"criterion %s exceeds its bounds\", c.ID)\n\t\t}\n\t\tfor _, m := range c.Mappings {\n\t\t\tif strings.TrimSpace(m.Delta) == \"\" || len(m.Delta) > 256 || len(m.Basis) > 256 || len(m.Disposition) > 64 || len(m.Rationale) > reviewDraftMaxText || len(m.Owner) > 256 || len(m.ReviewBy) > 64 {\n\t\t\t\treturn fmt.Errorf(\"criterion %s: a mapping needs a delta and bounded text\", c.ID)\n\t\t\t}\n\t\t}\n\t\tanswered[c.ID] = true\n\t}\n\tfor _, t := range d.Tools {\n\t\tif ValidateSlug(t.ID) != nil || strings.TrimSpace(t.Disposition) == \"\" || len(t.Evidence) > reviewDraftMaxText || len(t.Rationale) > reviewDraftMaxText || len(t.Component) > 256 {\n\t\t\treturn fmt.Errorf(\"tool %q needs an id, a disposition and bounded text\", t.ID)\n\t\t}\n\t}\n\tfor _, f := range d.Findings {\n\t\tif len(f.Action) > reviewDraftMaxText || len(f.Owner) > 256 || len(f.ReviewBy) > 64 {\n\t\t\treturn fmt.Errorf(\"finding %s exceeds its bounds\", f.ID)\n\t\t}\n\t}\n\tif len(d.Criteria) > reviewDraftMaxFindings || len(d.Tools) > reviewDraftMaxFindings || len(d.Questions) > reviewDraftMaxFindings || len(d.Surfaces) > reviewDraftMaxFindings {\n\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n\t}\n\tif b := d.BusinessDecision; b != nil {\n\t\tif strings.TrimSpace(b.Question) == \"\" || len(b.Question) > reviewDraftMaxText || len(b.Options) < 2 || len(b.Options) > 8 {\n\t\t\treturn fmt.Errorf(\"a business decision needs a bounded question and two to eight options\")\n\t\t}\n\t\tseen := map[string]bool{}\n\t\tfor _, o := range b.Options {\n\t\t\tif ValidateSlug(o.ID) != nil || seen[o.ID] || strings.TrimSpace(o.Consequence) == \"\" || len(o.Consequence) > reviewDraftMaxText {\n\t\t\t\treturn fmt.Errorf(\"business decision option %q needs a unique slug and its consequence\", o.ID)\n\t\t\t}\n\t\t\tseen[o.ID] = true\n\t\t}\n\t}\n\tasked := map[string]bool{}\n\tfor _, q := range d.Questions {\n\t\tswitch {\n\t\tcase !adjudicationQuestionID.MatchString(q.ID) || asked[q.ID]:\n\t\t\treturn fmt.Errorf(\"question %q is not a unique decision or requirement id\", q.ID)\n\t\tcase q.Verdict != AdjudicationHolds && q.Verdict != AdjudicationDoesNotHold && q.Verdict != AdjudicationCannotDetermine:\n\t\t\treturn fmt.Errorf(\"question %s: verdict %q is not holds, does-not-hold or cannot-determine\", q.ID, q.Verdict)\n\t\tcase strings.TrimSpace(q.Rationale) == \"\" || len(q.Rationale) > reviewDraftMaxText || len(q.Evidence) > reviewDraftMaxText:\n\t\t\treturn fmt.Errorf(\"question %s needs a bounded rationale\", q.ID)\n\t\t}\n\t\tasked[q.ID] = true\n\t}\n\tobserved := map[string]bool{}\n\tfor _, sf := range d.Surfaces {\n\t\tswitch {\n\t\tcase !deliveryRefRE.MatchString(sf.Ref) || observed[sf.Ref]:\n\t\t\treturn fmt.Errorf(\"surface %q is not a unique delivery target\", sf.Ref)\n\t\tcase sf.Outcome != SmokeObserved && sf.Outcome != SmokeNotObserved && sf.Outcome != SmokeNotReachable:\n\t\t\treturn fmt.Errorf(\"surface %s: outcome %q is not observed, not-observed or not-reachable\", sf.Ref, sf.Outcome)\n\t\tcase len(sf.Commands) == 0 || len(sf.Commands) > 64 || strings.TrimSpace(sf.Observed) == \"\" || len(sf.Observed) > reviewDraftMaxText:\n\t\t\treturn fmt.Errorf(\"surface %s needs the commands run and what was observed\", sf.Ref)\n\t\t}\n\t\tfor _, c := range sf.Commands {\n\t\t\tif strings.TrimSpace(c) == \"\" || len(c) > 1024 {\n\t\t\t\treturn fmt.Errorf(\"surface %s: a command must be non-empty and bounded\", sf.Ref)\n\t\t\t}\n\t\t}\n\t\tobserved[sf.Ref] = true\n\t}\n\taccounted := map[string]bool{}\n\tfor _, p := range d.PriorFindings {\n\t\tswitch {\n\t\tcase !reviewCarriedID.MatchString(p.ID) || accounted[p.ID]:\n\t\t\treturn fmt.Errorf(\"prior finding id %q is not a unique carried identifier\", p.ID)\n\t\tcase p.Status != PriorFindingFixed && p.Status != PriorFindingPartial && p.Status != PriorFindingNotFixed && p.Status != PriorFindingSuperseded:\n\t\t\treturn fmt.Errorf(\"prior finding %s: status %q is not fixed, partial, not-fixed or superseded\", p.ID, p.Status)\n\t\tcase len(p.Evidence) > reviewDraftMaxText:\n\t\t\treturn fmt.Errorf(\"prior finding %s: evidence exceeds its bound\", p.ID)\n\t\t}\n\t\taccounted[p.ID] = true\n\t}\n\treturn nil\n}\n\n// ReviewOpenFinding is a finding a round must account for: its identity\n// across rounds, the round it was first reported in, its details and, when it\n// was carried, the account the last round gave it (R2, R5).\ntype ReviewOpenFinding struct {\n\tID          string\n\tRound       int\n\tSeverity    string\n\tDisposition string\n\tFile        string\n\tLine        int\n\tSummary     string\n\tCarried     string\n}\n\n// ReviewRound is the round a bundle is in and what it must account for.\ntype ReviewRound struct {\n\tNumber int\n\t// Prior is the run that concluded the round before, nil in round 1.\n\tPrior       *ReviewRun\n\tPriorBundle *ReviewBundle\n\t// Open are the findings this round must account for.\n\tOpen []ReviewOpenFinding\n\t// Broken names the drafts of the chain that could not be read: a round\n\t// after one opens a new session; its open findings stay open.\n\tBroken string\n}\n","numLines":180,"startLine":200,"totalLines":895}},"tool_result_meta":[{"id":"toolu_01NSRBEGgav8EJ1vTHLnkZRD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
