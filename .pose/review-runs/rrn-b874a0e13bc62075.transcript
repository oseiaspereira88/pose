{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Hc8ZLWkVZyGjfS9FV2CyTT","type":"tool_result","content":"150\t\n151\t// reviewAttestationFromDraft builds the attestation a draft concludes, for\n152\t// the run that wrote it. Evidence is the run itself and each evidence the\n153\t// draft names; a criterion or a tool the draft does not answer is left for\n154\t// the preflight to refuse, never answered for it.\n155\tfunc reviewAttestationFromDraft(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, reviewer string) ReviewAttestation {\n156\t\tatt := ReviewAttestation{BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest, Reviewer: reviewer, Decision: draft.Decision}\n157\t\tevidence := map[string]bool{\"delegated-run:\" + run.RunID: true}\n158\t\tfor _, c := range draft.Criteria {\n159\t\t\tatt.Criteria = append(att.Criteria, ReviewCriterion{ID: c.ID, Disposition: c.Disposition, Evidence: c.Evidence, Rationale: c.Rationale, Mappings: c.Mappings})\n160\t\t\tif c.Evidence != \"\" {\n161\t\t\t\tevidence[c.Evidence] = true\n162\t\t\t}\n163\t\t}\n164\t\tvar tools []ReviewToolDisposition\n165\t\tfor _, t := range draft.Tools {\n166\t\t\ttools = append(tools, ReviewToolDisposition{ID: t.ID, Component: t.Component, Disposition: t.Disposition, Evidence: t.Evidence, Rationale: t.Rationale})\n167\t\t}\n168\t\tatt.Tools = ReviewToolDefaults(bundle.Payload.Plan.Tools, tools)\n169\t\tfor _, f := range draft.Findings {\n170\t\t\tfinding := ReviewFinding{ID: f.ID, Severity: f.Severity, Evidence: findingEvidence(f), Action: f.Action, Disposition: \"open\"}\n171\t\t\tif f.Action == \"\" {\n172\t\t\t\tfinding.Action = f.Summary\n173\t\t\t}\n174\t\t\t// A follow-up the reviewer gave an action, an owner and a review date\n175\t\t\t// is a risk the reviewer accepted; anything else stays open and blocks\n176\t\t\t// an approval. The engine never writes the action for the reviewer\n177\t\t\t// (review round 1, B3).\n178\t\t\tif f.Disposition == \"follow-up\" && f.Action != \"\" && f.Owner != \"\" && f.ReviewBy != \"\" {\n179\t\t\t\tfinding.Disposition, finding.Owner, finding.ReviewBy, finding.Rationale = \"accepted-risk\", f.Owner, f.ReviewBy, f.Summary\n180\t\t\t}\n181\t\t\t// A follow-up the reviewer classified inside a declared accepted\n182\t\t\t// limit is recorded as such, naming the limit (spec\n183\t\t\t// pose-review-declared-threat-model R3).\n184\t\t\tif f.Disposition == \"follow-up\" && f.Limit != \"\" {\n185\t\t\t\tfinding.Disposition, finding.Limit, finding.Rationale, finding.Owner, finding.ReviewBy = \"within-limit\", f.Limit, f.Summary, f.Owner, f.ReviewBy\n186\t\t\t}\n187\t\t\tatt.Findings = append(att.Findings, finding)\n188\t\t}\n189\t\tfor ref := range evidence {\n190\t\t\tatt.EvidenceRefs = append(att.EvidenceRefs, ref)\n191\t\t}\n192\t\tsort.Strings(att.EvidenceRefs)\n193\t\tatt.Run = &ReviewRunReference{RunID: run.RunID}\n194\t\treturn att\n195\t}\n196\t\n197\t// ReviewToolDefaults is given followed by the dispositions that state no\n198\t// conclusion, for the plan's tools given leaves out: a post-review gate\n199\t// deferred, a recommended tool not used. A required tool left out stays out,\n200\t// for the domain writer to name. `review attest` and a run's conclusion fill\n201\t// the same defaults, so a run's conclusion and its attestation agree on them.\n202\tfunc ReviewToolDefaults(plan []ReviewPlanTool, given []ReviewToolDisposition) []ReviewToolDisposition {\n203\t\tout := append([]ReviewToolDisposition{}, given...)\n204\t\tprovided := map[string]bool{}\n205\t\tfor _, t := range given {\n206\t\t\tprovided[t.ID+\"\\x00\"+t.Component] = true\n207\t\t}\n208\t\tfor _, tool := range plan {\n209\t\t\tif provided[tool.ID+\"\\x00\"+tool.Component] {\n210\t\t\t\tcontinue\n211\t\t\t}\n212\t\t\tif containsString(tool.Preconditions, \"review-complete\") {\n213\t\t\t\tout = append(out, ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"deferred\", Rationale: \"post-review gate\"})\n214\t\t\t} else if tool.Requiredness == \"recommended\" {\n215\t\t\t\tout = append(out, ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"not-used\", Rationale: \"not used during review\"})\n216\t\t\t}\n217\t\t}\n218\t\treturn out\n219\t}\n220\t\n221\tfunc findingEvidence(f ReviewDraftFinding) string {\n222\t\tif f.File == \"\" {\n223\t\t\treturn \"\"\n224\t\t}\n225\t\tif f.Line > 0 {\n226\t\t\treturn fmt.Sprintf(\"file:%s:%d\", f.File, f.Line)\n227\t\t}\n228\t\treturn \"file:\" + f.File\n229\t}\n230\t\n231\t// runConclusionDiffers is why att does not state the typed conclusion of a\n232\t// run briefed to write one (template review-brief/3), or \"\": its criteria,\n233\t// tools and findings are the ones the run's draft concludes, whoever signs\n234\t// it. A run briefed with an earlier template carried no typed conclusion and\n235\t// binds only its decision, as before (review round 1, B1; decision D1).\n236\tfunc runConclusionDiffers(run ReviewRun, bundle ReviewBundle, att ReviewAttestation) string {\n237\t\tif run.Provenance == nil || !reviewBriefAsksConclusion(run.Provenance.TemplateVersion) {\n238\t\t\treturn \"\"\n239\t\t}\n240\t\tdraft, err := ParseReviewDraft(run.Output)\n241\t\tif err != nil {\n242\t\t\treturn \"the run's draft cannot be read: \" + err.Error()\n243\t\t}\n244\t\tif draft == nil {\n245\t\t\tdraft = &ReviewDraft{Decision: att.Decision}\n246\t\t}\n247\t\twant := reviewAttestationFromDraft(run, bundle, *draft, att.Reviewer)\n248\t\tvar differ []string\n249\t\tdiffer = append(differ, differingItems(\"criterion\", mappingsByDelta(att.Criteria), mappingsByDelta(want.Criteria))...)\n250\t\tdiffer = append(differ, differingItems(\"tool\", concludingTools(bundle.Payload.Plan.Tools, att.Tools), concludingTools(bundle.Payload.Plan.Tools, want.Tools))...)\n251\t\tdiffer = append(differ, differingItems(\"finding\", att.Findings, want.Findings)...)\n252\t\tif len(differ) > 0 {\n253\t\t\treturn strings.Join(differ, \"; \")\n254\t\t}\n255\t\treturn \"\"\n256\t}\n257\t\n258\t// mappingsByDelta is criteria with each one's mappings ordered by delta: the\n259\t// order a writer lists them in states nothing (review round 2, F1).\n260\tfunc mappingsByDelta(criteria []ReviewCriterion) []ReviewCriterion {\n261\t\tout := make([]ReviewCriterion, 0, len(criteria))\n262\t\tfor _, c := range criteria {\n263\t\t\tc.Mappings = append([]ReviewCriterionMapping(nil), c.Mappings...)\n264\t\t\tsort.SliceStable(c.Mappings, func(i, j int) bool {\n265\t\t\t\ta, _ := json.Marshal(c.Mappings[i])\n266\t\t\t\tb, _ := json.Marshal(c.Mappings[j])\n267\t\t\t\treturn c.Mappings[i].Delta < c.Mappings[j].Delta || c.Mappings[i].Delta == c.Mappings[j].Delta && string(a) < string(b)\n268\t\t\t})\n269\t\t\tif len(c.Mappings) == 0 {\n270\t\t\t\tc.Mappings = nil\n271\t\t\t}\n272\t\t\tout = append(out, c)\n273\t\t}\n274\t\treturn out\n275\t}\n276\t\n277\t// concludingTools are the dispositions of tools that state a conclusion:\n278\t// a post-review gate deferred and a recommended tool not used state none,\n279\t// whatever their rationale says, so a writer that fills them is not\n280\t// answering for the reviewer.\n281\tfunc concludingTools(plan []ReviewPlanTool, tools []ReviewToolDisposition) []ReviewToolDisposition {\n282\t\tplanned := map[string]ReviewPlanTool{}\n283\t\tfor _, tool := range plan {\n284\t\t\tplanned[tool.ID+\"\\x00\"+tool.Component] = tool\n285\t\t}\n286\t\tout := []ReviewToolDisposition{}\n287\t\tfor _, t := range tools {\n288\t\t\ttool, ok := planned[t.ID+\"\\x00\"+t.Component]\n289\t\t\tif ok && t.Evidence == \"\" && (t.Disposition == \"deferred\" && containsString(tool.Preconditions, \"review-complete\") || t.Disposition == \"not-used\" && tool.Requiredness == \"recommended\") {\n290\t\t\t\tcontinue\n291\t\t\t}\n292\t\t\tout = append(out, t)\n293\t\t}\n294\t\treturn out\n295\t}\n296\t\n297\t// differingItems names the items of got and want, keyed by id and\n298\t// component, that one has and the other lacks or states differently.\n299\tfunc differingItems[T any](kind string, got, want []T) []string {\n300\t\tindex := func(items []T) (map[string]string, []string) {\n301\t\t\tout, keys := map[string]string{}, []string{}\n302\t\t\tfor _, v := range items {\n303\t\t\t\traw, _ := json.Marshal(v)\n304\t\t\t\tvar m struct {\n305\t\t\t\t\tID        string `json:\"id\"`\n306\t\t\t\t\tComponent string `json:\"component\"`\n307\t\t\t\t}\n308\t\t\t\t_ = json.Unmarshal(raw, &m)\n309\t\t\t\tkey := m.ID\n310\t\t\t\tif m.Component != \"\" {\n311\t\t\t\t\tkey += \" (component \" + m.Component + \")\"\n312\t\t\t\t}\n313\t\t\t\tif _, seen := out[key]; !seen {\n314\t\t\t\t\tkeys = append(keys, key)\n315\t\t\t\t}\n316\t\t\t\tout[key] += string(raw)\n317\t\t\t}\n318\t\t\treturn out, keys\n319\t\t}\n320\t\tg, gk := index(got)\n321\t\tw, wk := index(want)\n322\t\tvar differ []string\n323\t\tfor _, k := range gk {\n324\t\t\tswitch wv, ok := w[k]; {\n325\t\t\tcase !ok:\n326\t\t\t\tdiffer = append(differ, kind+\" \"+k+\" is not in the draft\")\n327\t\t\tcase wv != g[k]:\n328\t\t\t\tdiffer = append(differ, kind+\" \"+k+\" differs from the draft's\")\n329\t\t\t}\n330\t\t}\n331\t\tfor _, k := range wk {\n332\t\t\tif _, ok := g[k]; !ok {\n333\t\t\t\tdiffer = append(differ, kind+\" \"+k+\" of the draft is missing\")\n334\t\t\t}\n335\t\t}\n336\t\treturn differ\n337\t}\n338\t\n339\t// reviewConclusionLockWait bounds how long a conclusion waits for another\n340\t// conclusion of the same run to finish.\n341\tconst reviewConclusionLockWait = 2 * time.Minute\n342\t\n343\t// lockPrivateName holds an exclusive lock on name in a private directory,\n344\t// waiting while another process holds it.\n345\tfunc (s Store) lockPrivateName(dir, name string) (func(), error) {\n346\t\tbase, err := s.DelegationPrivateDir(dir)\n347\t\tif err != nil {\n348\t\t\treturn nil, err\n349\t\t}\n350\t\tpath := filepath.Join(base, strings.TrimPrefix(name, \"sha256:\")+\".lock\")\n351\t\tif info, err := os.Lstat(path); err == nil && !info.Mode().IsRegular() {\n352\t\t\treturn nil, fmt.Errorf(\"pose: the lock %s is not a regular file\", name)\n353\t\t}\n354\t\tfile, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o600)\n355\t\tif err != nil {\n356\t\t\treturn nil, err\n357\t\t}\n358\t\tdeadline := time.Now().Add(reviewConclusionLockWait)\n359\t\tfor {\n360\t\t\tunlock, err := lockSpecTransferFile(file)\n361\t\t\tif err == nil {\n362\t\t\t\treturn func() { unlock(); file.Close() }, nil\n363\t\t\t}\n364\t\t\tif errors.Is(err, errFileLockUnsupported) || time.Now().After(deadline) {\n365\t\t\t\tfile.Close()\n366\t\t\t\treturn nil, fmt.Errorf(\"pose: the lock %s cannot be taken: %w\", name, err)\n367\t\t\t}\n368\t\t\ttime.Sleep(50 * time.Millisecond)\n369\t\t}\n370\t}\n371\t\n372\t// lockReviewConclusion holds run's conclusion lock: an exclusive lock on a\n373\t// private file that the system releases when the process ends, so a\n374\t// reservation nobody holds was interrupted, and two conclusions of one run\n375\t// never decide at once (review round 2, B1).\n376\tfunc (s Store) lockReviewConclusion(runID string) (func(), error) {\n377\t\tdir, err := s.DelegationPrivateDir(\"conclusion-locks\")\n378\t\tif err != nil {\n379\t\t\treturn nil, err\n380\t\t}\n381\t\tpath := filepath.Join(dir, runID+\".lock\")\n382\t\t// The lock is this regular file and no other: a link planted in its\n383\t\t// place would lock what it points at (review round 3, F1).\n384\t\tif info, err := os.Lstat(path); err == nil && !info.Mode().IsRegular() {\n385\t\t\treturn nil, fmt.Errorf(\"pose: the conclusion lock of %s is not a regular file\", runID)\n386\t\t}\n387\t\tfile, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o600)\n388\t\tif err != nil {\n389\t\t\treturn nil, err\n390\t\t}\n391\t\topened, err := file.Stat()\n392\t\tnamed, lerr := os.Lstat(path)\n393\t\tif err != nil || lerr != nil || !named.Mode().IsRegular() || !os.SameFile(opened, named) {\n394\t\t\tfile.Close()\n395\t\t\treturn nil, fmt.Errorf(\"pose: the conclusion lock of %s changed while it was opened\", runID)\n396\t\t}\n397\t\tdeadline := time.Now().Add(reviewConclusionLockWait)\n398\t\tfor {\n399\t\t\tunlock, err := lockSpecTransferFile(file)\n400\t\t\tif err == nil {\n401\t\t\t\treturn func() { unlock(); file.Close() }, nil\n402\t\t\t}\n403\t\t\t// A platform without locks fails at once with that cause (review\n404\t\t\t// round 3, F2).\n405\t\t\tif errors.Is(err, errFileLockUnsupported) {\n406\t\t\t\tfile.Close()\n407\t\t\t\treturn nil, fmt.Errorf(\"pose: a conclusion needs a file lock: %w\", err)\n408\t\t\t}\n409\t\t\tif time.Now().After(deadline) {\n410\t\t\t\tfile.Close()\n411\t\t\t\treturn nil, fmt.Errorf(\"pose: another conclusion of %s holds its lock\", runID)\n412\t\t\t}\n413\t\t\ttime.Sleep(50 * time.Millisecond)\n414\t\t}\n415\t}\n416\t\n417\t// ConcludeReviewRun records the conclusion of run id signed by issuer (R1),\n418\t// or the reasons it records none (R3); a run that concluded before returns\n419\t// its record (R4). The run's conclusion lock is held from the first read to\n420\t// the last write, so two conclusions of one run never both sign and record\n421\t// (review rounds 1 and 2, B2/B1). Without apply nothing is written: the\n422\t// result says what the checks found, and that the attestation preflight runs\n423\t// only on apply.\n424\tfunc (s Store) ConcludeReviewRun(id, issuer string, apply bool, now time.Time) (ReviewConclusion, error) {\n425\t\tif !validAttemptFileName(id) {\n426\t\t\treturn ReviewConclusion{}, fmt.Errorf(\"pose: %q is not a run id\", id)\n427\t\t}\n428\t\tif !apply {\n429\t\t\treturn s.concludeReviewRunOperation(id, issuer, false, now)\n430\t\t}\n431\t\tvar result ReviewConclusion\n432\t\terr := s.withReviewRunWriteGuardRetry(\"review.conclude\", id, func(guarded Store) error {\n433\t\t\tvar err error\n434\t\t\tresult, err = guarded.concludeReviewRunOperation(id, issuer, true, now)\n435\t\t\treturn err\n436\t\t})\n437\t\treturn result, err\n438\t}\n439\t\n440\tfunc (s Store) concludeReviewRunOperation(id, issuer string, apply bool, now time.Time) (ReviewConclusion, error) {\n441\t\tif apply {\n442\t\t\tunlock, err := s.lockReviewConclusion(id)\n443\t\t\tif err != nil {\n444\t\t\t\treturn ReviewConclusion{}, err\n445\t\t\t}\n446\t\t\tdefer unlock()\n447\t\t}\n448\t\texisting, existingRaw, err := s.readReviewConclusionRaw(id)\n449\t\tif err != nil {\n450\t\t\treturn ReviewConclusion{}, err\n451\t\t}\n452\t\tvar over []byte\n453\t\tif existing != nil {\n454\t\t\tif existing.State != ReviewConclusionPending {\n455\t\t\t\texisting.Replayed = true\n456\t\t\t\treturn *existing, nil\n457\t\t\t}\n458\t\t\t// Nobody holds the lock, so this reservation was interrupted: an\n459\t\t\t// attestation it recorded that verifies as this run's conclusion\n460\t\t\t// completes it; otherwise the run is concluded again in its place.\n461\t\t\trecovered, err := s.recoveredReviewConclusion(*existing)\n462\t\t\tif err != nil {\n463\t\t\t\treturn ReviewConclusion{}, err\n464\t\t\t}\n465\t\t\tif recovered != nil {\n466\t\t\t\tif !apply {\n467\t\t\t\t\trecovered.Reasons = append(recovered.Reasons, \"preview: on apply the interrupted conclusion is completed with this attestation\")\n468\t\t\t\t\treturn *recovered, nil\n469\t\t\t\t}\n470\t\t\t\tout, err := s.publishReviewConclusion(*recovered, true, existingRaw)\n471\t\t\t\tout.Replayed = true\n472\t\t\t\treturn out, err\n473\t\t\t}\n474\t\t\tover = existingRaw\n475\t\t}\n476\t\treturn s.concludeReviewRun(id, issuer, apply, now, over)\n477\t}\n478\t\n479\t// recoveredReviewConclusion is pending completed with the attestation an\n480\t// interrupted conclusion recorded, when one verifies as this run's\n481\t// conclusion: signed, run-backed by a proof that verifies, for the run's\n482\t// bundle, stating its draft (review round 2, B3). A record that cannot be\n483\t// read is an error, not an absence.\n484\tfunc (s Store) recoveredReviewConclusion(pending ReviewConclusion) (*ReviewConclusion, error) {\n485\t\tif pending.BundleID == \"\" {\n486\t\t\treturn nil, nil\n487\t\t}\n488\t\tif pending.Kind == ReviewBriefKindAdjudication || pending.Kind == ReviewBriefKindSmoke {\n489\t\t\t// The verdict an interrupted conclusion wrote completes it only when\n490\t\t\t// it verifies as this run's.\n491\t\t\t// What the record states comes from the verified record and its\n492\t\t\t// run, never from the reservation (review round 1, F01).\n493\t\t\tverdict, _ := s.verifiedVerdictOf(pending.Kind, pending.RunID)\n494\t\t\tif verdict == nil {\n495\t\t\t\treturn nil, nil\n496\t\t\t}\n497\t\t\tdone := pending\n498\t\t\tdone.State, done.ProofID, done.Issuer, done.BundleID, done.Scope, done.Decision, done.Attestation = ReviewConclusionRecorded, verdict.ProofID, verdict.Issuer, verdict.BundleID, verdict.Scope, verdict.Decision, \"\"\n499\t\t\tdone.Destination = AdjudicationsDir + \"/\" + pending.RunID + \".json\"\n500\t\t\tif pending.Kind == ReviewBriefKindSmoke {\n501\t\t\t\tdone.Destination = SmokeResultsDir + \"/\" + pending.RunID + \".json\"\n502\t\t\t}\n503\t\t\tdone.Reasons = []string{\"completed from the verdict an interrupted conclusion recorded\"}\n504\t\t\treturn &done, nil\n505\t\t}\n506\t\tbundle, err := s.LoadReviewBundle(pending.BundleID)\n507\t\tif err != nil {\n508\t\t\treturn nil, err\n509\t\t}\n510\t\tread, err := s.ReadReviewAttestations(pending.BundleID)\n511\t\tif err != nil {\n512\t\t\treturn nil, err\n513\t\t}\n514\t\t// A history read with losses may hide the attestation that is current:\n515\t\t// nothing is recovered from it, and the reservation stays (review round\n516\t\t// 3, B1).\n517\t\tif !read.Coverage.Complete() {\n518\t\t\treturn nil, fmt.Errorf(\"pose: the attestation history of %s is incomplete, so the interrupted conclusion of %s cannot be recovered: %v\", pending.BundleID, pending.RunID, read.Coverage.Losses)\n519\t\t}\n520\t\tfor _, att := range read.Attestations {\n521\t\t\tif att.Run == nil || att.Run.RunID != pending.RunID || att.Decision != pending.Decision {\n522\t\t\t\tcontinue\n523\t\t\t}\n524\t\t\tif blockers := s.runBackedReviewBlockers(bundle, att); len(blockers) > 0 {\n525\t\t\t\tcontinue\n526\t\t\t}\n527\t\t\tdone := pending\n528\t\t\tdone.State, done.Attestation, done.ProofID, done.BundleID, done.Scope, done.Decision, done.Destination = ReviewConclusionRecorded, att.AttestationID, att.Run.ProofID, att.BundleID, bundle.Payload.Scope.Ref, att.Decision, \"\"\n529\t\t\t// The issuer is the one that signed the run's proof, never the"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"8e1adf52-90c9-4241-b210-6aa1747ac6d0","timestamp":"2026-11-26T00:19:55.227Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3050911272/worktree/pose-mcp/internal/pose/review_conclusions.go","content":"\n// reviewAttestationFromDraft builds the attestation a draft concludes, for\n// the run that wrote it. Evidence is the run itself and each evidence the\n// draft names; a criterion or a tool the draft does not answer is left for\n// the preflight to refuse, never answered for it.\nfunc reviewAttestationFromDraft(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, reviewer string) ReviewAttestation {\n\tatt := ReviewAttestation{BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest, Reviewer: reviewer, Decision: draft.Decision}\n\tevidence := map[string]bool{\"delegated-run:\" + run.RunID: true}\n\tfor _, c := range draft.Criteria {\n\t\tatt.Criteria = append(att.Criteria, ReviewCriterion{ID: c.ID, Disposition: c.Disposition, Evidence: c.Evidence, Rationale: c.Rationale, Mappings: c.Mappings})\n\t\tif c.Evidence != \"\" {\n\t\t\tevidence[c.Evidence] = true\n\t\t}\n\t}\n\tvar tools []ReviewToolDisposition\n\tfor _, t := range draft.Tools {\n\t\ttools = append(tools, ReviewToolDisposition{ID: t.ID, Component: t.Component, Disposition: t.Disposition, Evidence: t.Evidence, Rationale: t.Rationale})\n\t}\n\tatt.Tools = ReviewToolDefaults(bundle.Payload.Plan.Tools, tools)\n\tfor _, f := range draft.Findings {\n\t\tfinding := ReviewFinding{ID: f.ID, Severity: f.Severity, Evidence: findingEvidence(f), Action: f.Action, Disposition: \"open\"}\n\t\tif f.Action == \"\" {\n\t\t\tfinding.Action = f.Summary\n\t\t}\n\t\t// A follow-up the reviewer gave an action, an owner and a review date\n\t\t// is a risk the reviewer accepted; anything else stays open and blocks\n\t\t// an approval. The engine never writes the action for the reviewer\n\t\t// (review round 1, B3).\n\t\tif f.Disposition == \"follow-up\" && f.Action != \"\" && f.Owner != \"\" && f.ReviewBy != \"\" {\n\t\t\tfinding.Disposition, finding.Owner, finding.ReviewBy, finding.Rationale = \"accepted-risk\", f.Owner, f.ReviewBy, f.Summary\n\t\t}\n\t\t// A follow-up the reviewer classified inside a declared accepted\n\t\t// limit is recorded as such, naming the limit (spec\n\t\t// pose-review-declared-threat-model R3).\n\t\tif f.Disposition == \"follow-up\" && f.Limit != \"\" {\n\t\t\tfinding.Disposition, finding.Limit, finding.Rationale, finding.Owner, finding.ReviewBy = \"within-limit\", f.Limit, f.Summary, f.Owner, f.ReviewBy\n\t\t}\n\t\tatt.Findings = append(att.Findings, finding)\n\t}\n\tfor ref := range evidence {\n\t\tatt.EvidenceRefs = append(att.EvidenceRefs, ref)\n\t}\n\tsort.Strings(att.EvidenceRefs)\n\tatt.Run = &ReviewRunReference{RunID: run.RunID}\n\treturn att\n}\n\n// ReviewToolDefaults is given followed by the dispositions that state no\n// conclusion, for the plan's tools given leaves out: a post-review gate\n// deferred, a recommended tool not used. A required tool left out stays out,\n// for the domain writer to name. `review attest` and a run's conclusion fill\n// the same defaults, so a run's conclusion and its attestation agree on them.\nfunc ReviewToolDefaults(plan []ReviewPlanTool, given []ReviewToolDisposition) []ReviewToolDisposition {\n\tout := append([]ReviewToolDisposition{}, given...)\n\tprovided := map[string]bool{}\n\tfor _, t := range given {\n\t\tprovided[t.ID+\"\\x00\"+t.Component] = true\n\t}\n\tfor _, tool := range plan {\n\t\tif provided[tool.ID+\"\\x00\"+tool.Component] {\n\t\t\tcontinue\n\t\t}\n\t\tif containsString(tool.Preconditions, \"review-complete\") {\n\t\t\tout = append(out, ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"deferred\", Rationale: \"post-review gate\"})\n\t\t} else if tool.Requiredness == \"recommended\" {\n\t\t\tout = append(out, ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"not-used\", Rationale: \"not used during review\"})\n\t\t}\n\t}\n\treturn out\n}\n\nfunc findingEvidence(f ReviewDraftFinding) string {\n\tif f.File == \"\" {\n\t\treturn \"\"\n\t}\n\tif f.Line > 0 {\n\t\treturn fmt.Sprintf(\"file:%s:%d\", f.File, f.Line)\n\t}\n\treturn \"file:\" + f.File\n}\n\n// runConclusionDiffers is why att does not state the typed conclusion of a\n// run briefed to write one (template review-brief/3), or \"\": its criteria,\n// tools and findings are the ones the run's draft concludes, whoever signs\n// it. A run briefed with an earlier template carried no typed conclusion and\n// binds only its decision, as before (review round 1, B1; decision D1).\nfunc runConclusionDiffers(run ReviewRun, bundle ReviewBundle, att ReviewAttestation) string {\n\tif run.Provenance == nil || !reviewBriefAsksConclusion(run.Provenance.TemplateVersion) {\n\t\treturn \"\"\n\t}\n\tdraft, err := ParseReviewDraft(run.Output)\n\tif err != nil {\n\t\treturn \"the run's draft cannot be read: \" + err.Error()\n\t}\n\tif draft == nil {\n\t\tdraft = &ReviewDraft{Decision: att.Decision}\n\t}\n\twant := reviewAttestationFromDraft(run, bundle, *draft, att.Reviewer)\n\tvar differ []string\n\tdiffer = append(differ, differingItems(\"criterion\", mappingsByDelta(att.Criteria), mappingsByDelta(want.Criteria))...)\n\tdiffer = append(differ, differingItems(\"tool\", concludingTools(bundle.Payload.Plan.Tools, att.Tools), concludingTools(bundle.Payload.Plan.Tools, want.Tools))...)\n\tdiffer = append(differ, differingItems(\"finding\", att.Findings, want.Findings)...)\n\tif len(differ) > 0 {\n\t\treturn strings.Join(differ, \"; \")\n\t}\n\treturn \"\"\n}\n\n// mappingsByDelta is criteria with each one's mappings ordered by delta: the\n// order a writer lists them in states nothing (review round 2, F1).\nfunc mappingsByDelta(criteria []ReviewCriterion) []ReviewCriterion {\n\tout := make([]ReviewCriterion, 0, len(criteria))\n\tfor _, c := range criteria {\n\t\tc.Mappings = append([]ReviewCriterionMapping(nil), c.Mappings...)\n\t\tsort.SliceStable(c.Mappings, func(i, j int) bool {\n\t\t\ta, _ := json.Marshal(c.Mappings[i])\n\t\t\tb, _ := json.Marshal(c.Mappings[j])\n\t\t\treturn c.Mappings[i].Delta < c.Mappings[j].Delta || c.Mappings[i].Delta == c.Mappings[j].Delta && string(a) < string(b)\n\t\t})\n\t\tif len(c.Mappings) == 0 {\n\t\t\tc.Mappings = nil\n\t\t}\n\t\tout = append(out, c)\n\t}\n\treturn out\n}\n\n// concludingTools are the dispositions of tools that state a conclusion:\n// a post-review gate deferred and a recommended tool not used state none,\n// whatever their rationale says, so a writer that fills them is not\n// answering for the reviewer.\nfunc concludingTools(plan []ReviewPlanTool, tools []ReviewToolDisposition) []ReviewToolDisposition {\n\tplanned := map[string]ReviewPlanTool{}\n\tfor _, tool := range plan {\n\t\tplanned[tool.ID+\"\\x00\"+tool.Component] = tool\n\t}\n\tout := []ReviewToolDisposition{}\n\tfor _, t := range tools {\n\t\ttool, ok := planned[t.ID+\"\\x00\"+t.Component]\n\t\tif ok && t.Evidence == \"\" && (t.Disposition == \"deferred\" && containsString(tool.Preconditions, \"review-complete\") || t.Disposition == \"not-used\" && tool.Requiredness == \"recommended\") {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, t)\n\t}\n\treturn out\n}\n\n// differingItems names the items of got and want, keyed by id and\n// component, that one has and the other lacks or states differently.\nfunc differingItems[T any](kind string, got, want []T) []string {\n\tindex := func(items []T) (map[string]string, []string) {\n\t\tout, keys := map[string]string{}, []string{}\n\t\tfor _, v := range items {\n\t\t\traw, _ := json.Marshal(v)\n\t\t\tvar m struct {\n\t\t\t\tID        string `json:\"id\"`\n\t\t\t\tComponent string `json:\"component\"`\n\t\t\t}\n\t\t\t_ = json.Unmarshal(raw, &m)\n\t\t\tkey := m.ID\n\t\t\tif m.Component != \"\" {\n\t\t\t\tkey += \" (component \" + m.Component + \")\"\n\t\t\t}\n\t\t\tif _, seen := out[key]; !seen {\n\t\t\t\tkeys = append(keys, key)\n\t\t\t}\n\t\t\tout[key] += string(raw)\n\t\t}\n\t\treturn out, keys\n\t}\n\tg, gk := index(got)\n\tw, wk := index(want)\n\tvar differ []string\n\tfor _, k := range gk {\n\t\tswitch wv, ok := w[k]; {\n\t\tcase !ok:\n\t\t\tdiffer = append(differ, kind+\" \"+k+\" is not in the draft\")\n\t\tcase wv != g[k]:\n\t\t\tdiffer = append(differ, kind+\" \"+k+\" differs from the draft's\")\n\t\t}\n\t}\n\tfor _, k := range wk {\n\t\tif _, ok := g[k]; !ok {\n\t\t\tdiffer = append(differ, kind+\" \"+k+\" of the draft is missing\")\n\t\t}\n\t}\n\treturn differ\n}\n\n// reviewConclusionLockWait bounds how long a conclusion waits for another\n// conclusion of the same run to finish.\nconst reviewConclusionLockWait = 2 * time.Minute\n\n// lockPrivateName holds an exclusive lock on name in a private directory,\n// waiting while another process holds it.\nfunc (s Store) lockPrivateName(dir, name string) (func(), error) {\n\tbase, err := s.DelegationPrivateDir(dir)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tpath := filepath.Join(base, strings.TrimPrefix(name, \"sha256:\")+\".lock\")\n\tif info, err := os.Lstat(path); err == nil && !info.Mode().IsRegular() {\n\t\treturn nil, fmt.Errorf(\"pose: the lock %s is not a regular file\", name)\n\t}\n\tfile, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o600)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdeadline := time.Now().Add(reviewConclusionLockWait)\n\tfor {\n\t\tunlock, err := lockSpecTransferFile(file)\n\t\tif err == nil {\n\t\t\treturn func() { unlock(); file.Close() }, nil\n\t\t}\n\t\tif errors.Is(err, errFileLockUnsupported) || time.Now().After(deadline) {\n\t\t\tfile.Close()\n\t\t\treturn nil, fmt.Errorf(\"pose: the lock %s cannot be taken: %w\", name, err)\n\t\t}\n\t\ttime.Sleep(50 * time.Millisecond)\n\t}\n}\n\n// lockReviewConclusion holds run's conclusion lock: an exclusive lock on a\n// private file that the system releases when the process ends, so a\n// reservation nobody holds was interrupted, and two conclusions of one run\n// never decide at once (review round 2, B1).\nfunc (s Store) lockReviewConclusion(runID string) (func(), error) {\n\tdir, err := s.DelegationPrivateDir(\"conclusion-locks\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tpath := filepath.Join(dir, runID+\".lock\")\n\t// The lock is this regular file and no other: a link planted in its\n\t// place would lock what it points at (review round 3, F1).\n\tif info, err := os.Lstat(path); err == nil && !info.Mode().IsRegular() {\n\t\treturn nil, fmt.Errorf(\"pose: the conclusion lock of %s is not a regular file\", runID)\n\t}\n\tfile, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o600)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\topened, err := file.Stat()\n\tnamed, lerr := os.Lstat(path)\n\tif err != nil || lerr != nil || !named.Mode().IsRegular() || !os.SameFile(opened, named) {\n\t\tfile.Close()\n\t\treturn nil, fmt.Errorf(\"pose: the conclusion lock of %s changed while it was opened\", runID)\n\t}\n\tdeadline := time.Now().Add(reviewConclusionLockWait)\n\tfor {\n\t\tunlock, err := lockSpecTransferFile(file)\n\t\tif err == nil {\n\t\t\treturn func() { unlock(); file.Close() }, nil\n\t\t}\n\t\t// A platform without locks fails at once with that cause (review\n\t\t// round 3, F2).\n\t\tif errors.Is(err, errFileLockUnsupported) {\n\t\t\tfile.Close()\n\t\t\treturn nil, fmt.Errorf(\"pose: a conclusion needs a file lock: %w\", err)\n\t\t}\n\t\tif time.Now().After(deadline) {\n\t\t\tfile.Close()\n\t\t\treturn nil, fmt.Errorf(\"pose: another conclusion of %s holds its lock\", runID)\n\t\t}\n\t\ttime.Sleep(50 * time.Millisecond)\n\t}\n}\n\n// ConcludeReviewRun records the conclusion of run id signed by issuer (R1),\n// or the reasons it records none (R3); a run that concluded before returns\n// its record (R4). The run's conclusion lock is held from the first read to\n// the last write, so two conclusions of one run never both sign and record\n// (review rounds 1 and 2, B2/B1). Without apply nothing is written: the\n// result says what the checks found, and that the attestation preflight runs\n// only on apply.\nfunc (s Store) ConcludeReviewRun(id, issuer string, apply bool, now time.Time) (ReviewConclusion, error) {\n\tif !validAttemptFileName(id) {\n\t\treturn ReviewConclusion{}, fmt.Errorf(\"pose: %q is not a run id\", id)\n\t}\n\tif !apply {\n\t\treturn s.concludeReviewRunOperation(id, issuer, false, now)\n\t}\n\tvar result ReviewConclusion\n\terr := s.withReviewRunWriteGuardRetry(\"review.conclude\", id, func(guarded Store) error {\n\t\tvar err error\n\t\tresult, err = guarded.concludeReviewRunOperation(id, issuer, true, now)\n\t\treturn err\n\t})\n\treturn result, err\n}\n\nfunc (s Store) concludeReviewRunOperation(id, issuer string, apply bool, now time.Time) (ReviewConclusion, error) {\n\tif apply {\n\t\tunlock, err := s.lockReviewConclusion(id)\n\t\tif err != nil {\n\t\t\treturn ReviewConclusion{}, err\n\t\t}\n\t\tdefer unlock()\n\t}\n\texisting, existingRaw, err := s.readReviewConclusionRaw(id)\n\tif err != nil {\n\t\treturn ReviewConclusion{}, err\n\t}\n\tvar over []byte\n\tif existing != nil {\n\t\tif existing.State != ReviewConclusionPending {\n\t\t\texisting.Replayed = true\n\t\t\treturn *existing, nil\n\t\t}\n\t\t// Nobody holds the lock, so this reservation was interrupted: an\n\t\t// attestation it recorded that verifies as this run's conclusion\n\t\t// completes it; otherwise the run is concluded again in its place.\n\t\trecovered, err := s.recoveredReviewConclusion(*existing)\n\t\tif err != nil {\n\t\t\treturn ReviewConclusion{}, err\n\t\t}\n\t\tif recovered != nil {\n\t\t\tif !apply {\n\t\t\t\trecovered.Reasons = append(recovered.Reasons, \"preview: on apply the interrupted conclusion is completed with this attestation\")\n\t\t\t\treturn *recovered, nil\n\t\t\t}\n\t\t\tout, err := s.publishReviewConclusion(*recovered, true, existingRaw)\n\t\t\tout.Replayed = true\n\t\t\treturn out, err\n\t\t}\n\t\tover = existingRaw\n\t}\n\treturn s.concludeReviewRun(id, issuer, apply, now, over)\n}\n\n// recoveredReviewConclusion is pending completed with the attestation an\n// interrupted conclusion recorded, when one verifies as this run's\n// conclusion: signed, run-backed by a proof that verifies, for the run's\n// bundle, stating its draft (review round 2, B3). A record that cannot be\n// read is an error, not an absence.\nfunc (s Store) recoveredReviewConclusion(pending ReviewConclusion) (*ReviewConclusion, error) {\n\tif pending.BundleID == \"\" {\n\t\treturn nil, nil\n\t}\n\tif pending.Kind == ReviewBriefKindAdjudication || pending.Kind == ReviewBriefKindSmoke {\n\t\t// The verdict an interrupted conclusion wrote completes it only when\n\t\t// it verifies as this run's.\n\t\t// What the record states comes from the verified record and its\n\t\t// run, never from the reservation (review round 1, F01).\n\t\tverdict, _ := s.verifiedVerdictOf(pending.Kind, pending.RunID)\n\t\tif verdict == nil {\n\t\t\treturn nil, nil\n\t\t}\n\t\tdone := pending\n\t\tdone.State, done.ProofID, done.Issuer, done.BundleID, done.Scope, done.Decision, done.Attestation = ReviewConclusionRecorded, verdict.ProofID, verdict.Issuer, verdict.BundleID, verdict.Scope, verdict.Decision, \"\"\n\t\tdone.Destination = AdjudicationsDir + \"/\" + pending.RunID + \".json\"\n\t\tif pending.Kind == ReviewBriefKindSmoke {\n\t\t\tdone.Destination = SmokeResultsDir + \"/\" + pending.RunID + \".json\"\n\t\t}\n\t\tdone.Reasons = []string{\"completed from the verdict an interrupted conclusion recorded\"}\n\t\treturn &done, nil\n\t}\n\tbundle, err := s.LoadReviewBundle(pending.BundleID)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tread, err := s.ReadReviewAttestations(pending.BundleID)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\t// A history read with losses may hide the attestation that is current:\n\t// nothing is recovered from it, and the reservation stays (review round\n\t// 3, B1).\n\tif !read.Coverage.Complete() {\n\t\treturn nil, fmt.Errorf(\"pose: the attestation history of %s is incomplete, so the interrupted conclusion of %s cannot be recovered: %v\", pending.BundleID, pending.RunID, read.Coverage.Losses)\n\t}\n\tfor _, att := range read.Attestations {\n\t\tif att.Run == nil || att.Run.RunID != pending.RunID || att.Decision != pending.Decision {\n\t\t\tcontinue\n\t\t}\n\t\tif blockers := s.runBackedReviewBlockers(bundle, att); len(blockers) > 0 {\n\t\t\tcontinue\n\t\t}\n\t\tdone := pending\n\t\tdone.State, done.Attestation, done.ProofID, done.BundleID, done.Scope, done.Decision, done.Destination = ReviewConclusionRecorded, att.AttestationID, att.Run.ProofID, att.BundleID, bundle.Payload.Scope.Ref, att.Decision, \"\"\n\t\t// The issuer is the one that signed the run's proof, never the","numLines":380,"startLine":150,"totalLines":733}},"tool_result_meta":[{"id":"toolu_01Hc8ZLWkVZyGjfS9FV2CyTT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
