etainedCompletedReviewWithHistory(scopeRef, scope, policy)\n3745\t\t\t\t\tif len(retainLost) > 0 {\n3746\t\t\t\t\t\tverification.Blockers = append(verification.Blockers, \"the approval cannot be retained: the attestation history of its bundle is incomplete, so the latest readable attestation is not known to be the current one: \"+(SourceCoverage{Losses: retainLost}).Describe(\"\")+\"; restore or remove the unreadable record\")\n3747\t\t\t\t\t}\n3748\t\t\t\t\tif len(childBlockers) > 0 {\n3749\t\t\t\t\t\tverification.State = \"superseded\"\n3750\t\t\t\t\t\tverification.Blockers = uniqueSorted(append(verification.Blockers, childBlockers...))\n3751\t\t\t\t\t\tverification.NextAction = \"restore the review of the children of \" + scope\n3752\t\t\t\t\t\treturn verification, nil\n3753\t\t\t\t\t}\n3754\t\t\t\t\tif bundle != nil && !s.retainedApprovalStands(bundle, prepared.Payload.FederatedManifest) {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"82f8c841-fab6-4ae9-9ea1-eb400460393c","timestamp":"2026-11-26T00:20:34.826Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3050911272/worktree/pose-mcp/internal/pose/review_bundle.go","content":"\t\t// A sealed bundle that could not be read may belong to this scope: the history\n\t\t// below is the readable part of it.\n\t\tverification.Warnings = append(verification.Warnings, \"sealed bundle history is incomplete: \"+(SourceCoverage{Losses: bundleLosses}).Describe(\"\")+\"; a record that could not be read may belong to this scope\")\n\t}\n\tif len(prepared.Blockers) == 0 {\n\t\tverification.State = \"ready-to-seal\"\n\t}\n\tcurrent, err := s.matchSealedReviewBundle(scope, prepared, bundles)\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n\tif current == nil {\n\t\tif len(bundles) > 0 {\n\t\t\tprevious := reviewBundleLineage(bundles)[0]\n\t\t\tdelta := ReviewBundleDiff(previous, prepared)\n\t\t\t// The per-criterion explanation is computed on