{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ke84ANJg6hJnyyU6Xa3UN8","type":"tool_result","content":"1600\t\t\t\t}\n1601\t\t\t\teval.Blockers = append(eval.Blockers, childBlockers...)\n1602\t\t\t\trefused := bundle != nil && (!s.sealedDeclarationHolds(bundle) || s.FederatedResolver != nil && (verifyErr != nil || !s.retainedApprovalStands(bundle, verification.currentManifest)))\n1603\t\t\t\tif bundle != nil && !refused {\n1604\t\t\t\t\teval.Fresh = true\n1605\t\t\t\t\teval.Approved = true\n1606\t\t\t\t\teval.BundleState = \"closed\"\n1607\t\t\t\t\teval.ScopeDigest = bundle.BundleDigest\n1608\t\t\t\t\teval.BundleID = bundle.BundleID\n1609\t\t\t\t\teval.settledBundle = bundle\n1610\t\t\t\t\teval.BundleDigest = bundle.BundleDigest\n1611\t\t\t\t\teval.PlanDigest = bundle.Payload.Plan.PlanDigest\n1612\t\t\t\t\teval.AttestationID = att.AttestationID\n1613\t\t\t\t\teval.settledAttestation = att\n1614\t\t\t\t\teval.Current = &ReviewAttempt{SchemaVersion: ReviewBundleSchemaVersion, ReviewID: att.AttestationID, Scope: ref, ScopeDigest: att.BundleDigest, PlanDigest: eval.PlanDigest, Profile: profileRef, Reviewer: att.Reviewer, Decision: att.Decision, ReviewedAt: att.AttestedAt, Supersedes: att.Supersedes, EvidenceRefs: att.EvidenceRefs, Criteria: att.Criteria, Tools: att.Tools, Findings: att.Findings, Path: att.Path}\n1615\t\t\t\t\teval.Warnings = append(eval.Warnings, retainedCompletedReviewWarning)\n1616\t\t\t\t\treturn eval, nil\n1617\t\t\t\t}\n1618\t\t\t\t// A closed scope whose newest review rejected it or requested changes\n1619\t\t\t\t// has a review; saying none exists sent operators looking for a\n1620\t\t\t\t// missing record instead of the findings (spec\n1621\t\t\t\t// review-check-names-a-negative-verdict).\n1622\t\t\t\tif bundle, att := s.latestNegativeReview(ref); bundle != nil {\n1623\t\t\t\t\teval.BundleState = att.Decision\n1624\t\t\t\t\teval.ScopeDigest = bundle.BundleDigest\n1625\t\t\t\t\teval.BundleID = bundle.BundleID\n1626\t\t\t\t\teval.settledBundle = bundle\n1627\t\t\t\t\teval.BundleDigest = bundle.BundleDigest\n1628\t\t\t\t\teval.PlanDigest = bundle.Payload.Plan.PlanDigest\n1629\t\t\t\t\teval.AttestationID = att.AttestationID\n1630\t\t\t\t\teval.settledAttestation = att\n1631\t\t\t\t\teval.Current = &ReviewAttempt{SchemaVersion: ReviewBundleSchemaVersion, ReviewID: att.AttestationID, Scope: ref, ScopeDigest: att.BundleDigest, PlanDigest: eval.PlanDigest, Profile: profileRef, Reviewer: att.Reviewer, Decision: att.Decision, ReviewedAt: att.AttestedAt, Supersedes: att.Supersedes, EvidenceRefs: att.EvidenceRefs, Criteria: att.Criteria, Tools: att.Tools, Findings: att.Findings, Path: att.Path}\n1632\t\t\t\t\teval.Blockers = append(eval.Blockers, \"latest review \"+att.AttestationID+\" of \"+ref+\" decided \"+att.Decision+\"; remediate its findings and seal a superseding bundle\")\n1633\t\t\t\t\tfor _, finding := range att.Findings {\n1634\t\t\t\t\t\tif finding.Disposition == \"open\" || finding.Disposition == \"changes-requested\" {\n1635\t\t\t\t\t\t\teval.Blockers = append(eval.Blockers, \"finding \"+finding.ID+\" (\"+finding.Severity+\") is \"+finding.Disposition+\": \"+finding.Action)\n1636\t\t\t\t\t\t}\n1637\t\t\t\t\t}\n1638\t\t\t\t\teval.Blockers = uniqueSorted(eval.Blockers)\n1639\t\t\t\t\treturn eval, nil\n1640\t\t\t\t}\n1641\t\t\t\tif verifyErr != nil && (refused || !s.reviewBundlesLegacyAttemptExempt(scope, policy)) {\n1642\t\t\t\t\treturn eval, verifyErr\n1643\t\t\t\t}\n1644\t\t\t\tif refused {\n1645\t\t\t\t\teval.BundleState = verification.State\n1646\t\t\t\t\teval.Blockers = uniqueSorted(append(append(eval.Blockers, verification.Blockers...), retainedManifestChanged(bundle, ref)))\n1647\t\t\t\t\teval.Warnings = uniqueSorted(append(eval.Warnings, verification.Warnings...))\n1648\t\t\t\t\treturn eval, nil\n1649\t\t\t\t}\n1650\t\t\t\t// Fall through to legacy check\n1651\t\t\t} else if verifyErr != nil {\n1652\t\t\t\treturn eval, verifyErr\n1653\t\t\t} else {\n1654\t\t\t\teval.Fresh = verification.Fresh\n1655\t\t\t\teval.Approved = verification.Approved\n1656\t\t\t\teval.Blockers = append(eval.Blockers, verification.Blockers...)\n1657\t\t\t\teval.Warnings = append(eval.Warnings, verification.Warnings...)\n1658\t\t\t\teval.BundleState = verification.State\n1659\t\t\t\tif verification.Bundle != nil {\n1660\t\t\t\t\teval.ScopeDigest = verification.Bundle.BundleDigest\n1661\t\t\t\t\teval.BundleID = verification.Bundle.BundleID\n1662\t\t\t\t\teval.settledBundle = verification.Bundle\n1663\t\t\t\t\teval.BundleDigest = verification.Bundle.BundleDigest\n1664\t\t\t\t\teval.PlanDigest = verification.Bundle.Payload.Plan.PlanDigest\n1665\t\t\t\t}\n1666\t\t\t\tif verification.Attestation != nil {\n1667\t\t\t\t\teval.AttestationID = verification.Attestation.AttestationID\n1668\t\t\t\t\teval.settledAttestation = verification.Attestation\n1669\t\t\t\t\tatt := verification.Attestation\n1670\t\t\t\t\teval.Current = &ReviewAttempt{SchemaVersion: ReviewBundleSchemaVersion, ReviewID: att.AttestationID, Scope: ref, ScopeDigest: att.BundleDigest, PlanDigest: eval.PlanDigest, Profile: profileRef, Reviewer: att.Reviewer, Decision: att.Decision, ReviewedAt: att.AttestedAt, Supersedes: att.Supersedes, EvidenceRefs: att.EvidenceRefs, Criteria: att.Criteria, Tools: att.Tools, Findings: att.Findings, Path: att.Path}\n1671\t\t\t\t}\n1672\t\t\t\teval.Blockers = uniqueSorted(eval.Blockers)\n1673\t\t\t\teval.Warnings = uniqueSorted(eval.Warnings)\n1674\t\t\t\treturn eval, nil\n1675\t\t\t}\n1676\t\t}\n1677\t\tprofile, _, err := s.loadReviewProfile(profileRef)\n1678\t\tif err != nil {\n1679\t\t\treturn eval, err\n1680\t\t}\n1681\t\tbaseRequiredCriteria := append([]ReviewCriterionProfile{}, profile.Criteria...)\n1682\t\trequiredCriteria := append([]ReviewCriterionProfile{}, baseRequiredCriteria...)\n1683\t\teffectiveTools := []ReviewPlanTool{}\n1684\t\tbaseIndependence := policy.ReviewerIndependence[scope.Kind]\n1685\t\tindependence := baseIndependence\n1686\t\tif policy.SchemaVersion >= ReviewPolicySchemaVersion && policy.ComponentAware {\n1687\t\t\tplan, planErr := s.ReviewPlan(ref)\n1688\t\t\tif planErr != nil {\n1689\t\t\t\treturn eval, planErr\n1690\t\t\t}\n1691\t\t\teval.PlanDigest = plan.PlanDigest\n1692\t\t\teval.Warnings = append(eval.Warnings, plan.Warnings...)\n1693\t\t\teval.Blockers = append(eval.Blockers, plan.Blockers...)\n1694\t\t\trequiredCriteria = requiredCriteria[:0]\n1695\t\t\tfor _, criterion := range plan.Criteria {\n1696\t\t\t\tif !criterion.Required {\n1697\t\t\t\t\tcontinue\n1698\t\t\t\t}\n1699\t\t\t\trequired := true\n1700\t\t\t\trequiredCriteria = append(requiredCriteria, ReviewCriterionProfile{ID: criterion.ID, Description: criterion.Description, Rules: criterion.Rules, EvidenceClasses: criterion.EvidenceClasses, Required: &required})\n1701\t\t\t}\n1702\t\t\teffectiveTools = append(effectiveTools, plan.Tools...)\n1703\t\t\tindependence = plan.Independence\n1704\t\t}\n1705\t\tattemptsRead, err := s.ReadReviewAttempts(ref)\n1706\t\tif err != nil {\n1707\t\t\treturn eval, err\n1708\t\t}\n1709\t\tattempts := attemptsRead.Attempts\n1710\t\tif len(attempts) == 0 {\n1711\t\t\tif lost := attemptsRead.HistoryUncertainAfter(ref, \"\", \"\"); len(lost) > 0 {\n1712\t\t\t\t// Records that could not be read may be attempts: absence is not proven.\n1713\t\t\t\teval.Blockers = append(eval.Blockers, \"no readable review attempt exists for \"+ref+\", and the review history is incomplete: \"+(SourceCoverage{Losses: lost}).Describe(\"\"))\n1714\t\t\t\treturn eval, nil\n1715\t\t\t}\n1716\t\t\teval.Blockers = append(eval.Blockers, \"no review attempt exists for \"+ref)\n1717\t\t\treturn eval, nil\n1718\t\t}\n1719\t\tcurrent := attempts[len(attempts)-1]\n1720\t\teval.Current = &current\n1721\t\t// An attempt that could not be read may be a later one, a rejection among them:\n1722\t\t// the latest readable attempt is not taken as the current one until the history is\n1723\t\t// readable. A record whose name shows it is older than the current attempt cannot\n1724\t\t// have superseded it and is only disclosed.\n1725\t\tif lost := attemptsRead.HistoryUncertainAfter(ref, current.ReviewedAt, current.ReviewID); len(lost) > 0 {\n1726\t\t\teval.Blockers = append(eval.Blockers, \"review history for \"+ref+\" is incomplete, so the latest readable attempt is not known to be the current one: \"+(SourceCoverage{Losses: lost}).Describe(\"\")+\"; restore or remove the unreadable record\")\n1727\t\t}\n1728\t\tif older := len(attemptsRead.Coverage.LossesFor(ref)) - len(attemptsRead.HistoryUncertainAfter(ref, current.ReviewedAt, current.ReviewID)); older > 0 {\n1729\t\t\teval.Warnings = append(eval.Warnings, fmt.Sprintf(\"%d unreadable review record(s) predate the current attempt and cannot have superseded it\", older))\n1730\t\t}\n1731\t\tlegacyPlanExempt := s.componentAwareLegacyAttemptExempt(scope, policy, current)\n1732\t\t// Reconciling a profile's evidence classes changes the effective plan, and a\n1733\t\t// completed scope's attempt is compared against the plan as it is today. So\n1734\t\t// renaming `test` to the three classes that can actually be produced makes\n1735\t\t// every past closeout stale, without any of them having become less\n1736\t\t// reviewed. This exemption is narrower than legacyPlanExempt: the criteria\n1737\t\t// and tools still stand, only the digest comparison and the class match are\n1738\t\t// waived, and only for a scope already done whose review predates the date.\n1739\t\tvocabularyExempt := s.evidenceVocabularyLegacyExempt(scope, policy, current)\n1740\t\tif vocabularyExempt {\n1741\t\t\teval.Warnings = append(eval.Warnings, \"completed scope retains its approved review recorded before the evidence vocabulary was reconciled\")\n1742\t\t}\n1743\t\t// The same shape again, one contract later. Resolving a criterion's kind put\n1744\t\t// a field into the sealed plan, so every plan digest moved — including those\n1745\t\t// of scopes closed years of commits ago, whose reviews became `superseded`\n1746\t\t// without anything about them having become less reviewed.\n1747\t\t//\n1748\t\t// The spec that introduced the field predicted this and claimed the existing\n1749\t\t// exemption covered completed scopes. It did not: the two above are keyed to\n1750\t\t// their own contracts, and `pose check --strict` failed on the first\n1751\t\t// unrelated done spec it reached. Naming the third one is the fix the\n1752\t\t// pattern already prescribes.\n1753\t\tjudgmentExempt := s.explicitJudgmentLegacyExempt(scope, policy, current)\n1754\t\tif judgmentExempt {\n1755\t\t\teval.Warnings = append(eval.Warnings, \"completed scope retains its approved review recorded before criterion kinds entered the plan\")\n1756\t\t}\n1757\t\tif legacyPlanExempt {\n1758\t\t\trequiredCriteria = append([]ReviewCriterionProfile{}, baseRequiredCriteria...)\n1759\t\t\teffectiveTools = nil\n1760\t\t\tindependence = baseIndependence\n1761\t\t\teval.Warnings = append(eval.Warnings, \"completed scope retains its approved pre-component-aware review attempt\")\n1762\t\t}\n1763\t\tif len(attempts) > 1 && current.Supersedes != attempts[len(attempts)-2].ReviewID {\n1764\t\t\teval.Blockers = append(eval.Blockers, \"latest review does not supersede the previous attempt\")\n1765\t\t}\n1766\t\tif current.ScopeDigest != digest && !legacyPlanExempt {\n1767\t\t\teval.Blockers = append(eval.Blockers, \"review is stale: scope digest changed\")\n1768\t\t} else {\n1769\t\t\teval.Fresh = true\n1770\t\t}\n1771\t\tif eval.PlanDigest != \"\" && current.PlanDigest != eval.PlanDigest && !legacyPlanExempt && !vocabularyExempt && !judgmentExempt {\n1772\t\t\teval.Fresh = false\n1773\t\t\tif current.PlanDigest == \"\" {\n1774\t\t\t\teval.Blockers = append(eval.Blockers, \"review is stale: effective plan digest is missing\")\n1775\t\t\t} else {\n1776\t\t\t\teval.Blockers = append(eval.Blockers, \"review is stale: effective plan digest changed\")\n1777\t\t\t}\n1778\t\t}\n1779\t\tif current.Profile != profile.Ref() {\n1780\t\t\teval.Blockers = append(eval.Blockers, \"review profile does not match current policy\")\n1781\t\t}\n1782\t\tfor _, ref := range current.EvidenceRefs {\n1783\t\t\tif err := validateReviewEvidenceRef(s.fsys(), s.Root, ref); err != nil {\n1784\t\t\t\teval.Blockers = append(eval.Blockers, err.Error())\n1785\t\t\t}\n1786\t\t}\n1787\t\tif len(effectiveTools) > 0 {\n1788\t\t\ttoolWarnings, toolBlockers := // The legacy attempt path has no sealed bundle to check against.\n1789\t\t\t\tevaluateReviewToolCoverageIn(s.fsys(), s.Root, effectiveTools, current.Tools, nil, true)\n1790\t\t\teval.Warnings = append(eval.Warnings, toolWarnings...)\n1791\t\t\teval.Blockers = append(eval.Blockers, toolBlockers...)\n1792\t\t}\n1793\t\tif current.Reviewer == \"\" || strings.ContainsAny(current.Reviewer, \"\\r\\n\") {\n1794\t\t\teval.Blockers = append(eval.Blockers, \"reviewer execution identity is missing or malformed\")\n1795\t\t}\n1796\t\tswitch independence {\n1797\t\tcase \"\", \"same-actor-separate-execution\":\n1798\t\t\tif !strings.HasPrefix(current.Reviewer, \"agent:\") && !strings.HasPrefix(current.Reviewer, \"human:\") {\n1799\t\t\t\teval.Blockers = append(eval.Blockers, \"reviewer must use an agent: or human: execution identity\")\n1800\t\t\t}\n1801\t\tcase \"different-actor\":\n1802\t\t\tif !strings.HasPrefix(current.Reviewer, \"agent:independent-\") && !strings.HasPrefix(current.Reviewer, \"human:\") {\n1803\t\t\t\teval.Blockers = append(eval.Blockers, \"review policy requires a different-actor reviewer identity; under declared assurance that is read from the reviewer prefix, not authenticated\")\n1804\t\t\t}\n1805\t\tcase \"mandatory-human\":\n1806\t\t\tif !strings.HasPrefix(current.Reviewer, \"human:\") {\n1807\t\t\t\teval.Blockers = append(eval.Blockers, \"review policy requires human approval\")\n1808\t\t\t}\n1809\t\tdefault:\n1810\t\t\teval.Blockers = append(eval.Blockers, \"review policy has invalid independence mode \"+independence)\n1811\t\t}\n1812\t\tif _, err := time.Parse(time.RFC3339, current.ReviewedAt); err != nil {\n1813\t\t\teval.Blockers = append(eval.Blockers, \"reviewed_at must be RFC3339\")\n1814\t\t}\n1815\t\tcriteria := map[string]ReviewCriterion{}\n1816\t\tprofileCriteria := map[string]bool{}\n1817\t\tfor _, required := range requiredCriteria {\n1818\t\t\tprofileCriteria[required.ID] = true\n1819\t\t}\n1820\t\tfor _, criterion := range current.Criteria {\n1821\t\t\tif _, duplicate := criteria[criterion.ID]; duplicate {\n1822\t\t\t\teval.Blockers = append(eval.Blockers, \"duplicate criterion \"+criterion.ID)\n1823\t\t\t}\n1824\t\t\tcriteria[criterion.ID] = criterion\n1825\t\t\tif !profileCriteria[criterion.ID] {\n1826\t\t\t\teval.Blockers = append(eval.Blockers, \"unknown criterion \"+criterion.ID)\n1827\t\t\t}\n1828\t\t\tif criterion.Evidence != \"\" {\n1829\t\t\t\tif err := validateReviewEvidenceRef(s.fsys(), s.Root, criterion.Evidence); err != nil {\n1830\t\t\t\t\teval.Blockers = append(eval.Blockers, err.Error())\n1831\t\t\t\t}\n1832\t\t\t}\n1833\t\t}\n1834\t\tfor _, required := range requiredCriteria {\n1835\t\t\tcriterion, ok := criteria[required.ID]\n1836\t\t\tif !ok {\n1837\t\t\t\teval.Blockers = append(eval.Blockers, \"missing criterion \"+required.ID)\n1838\t\t\t\tcontinue\n1839\t\t\t}\n1840\t\t\tswitch criterion.Disposition {\n1841\t\t\tcase \"passed\":\n1842\t\t\t\tif criterion.Evidence == \"\" && len(current.EvidenceRefs) == 0 {\n1843\t\t\t\t\teval.Blockers = append(eval.Blockers, \"criterion \"+required.ID+\" has no evidence\")\n1844\t\t\t\t}\n1845\t\t\tcase \"finding\":\n1846\t\t\t\tif len(current.Findings) == 0 {\n1847\t\t\t\t\teval.Blockers = append(eval.Blockers, \"criterion \"+required.ID+\" references a missing finding\")\n1848\t\t\t\t}\n1849\t\t\tcase \"not-applicable\":\n1850\t\t\t\tif criterion.Rationale == \"\" {\n1851\t\t\t\t\teval.Blockers = append(eval.Blockers, \"criterion \"+required.ID+\" lacks not-applicable rationale\")\n1852\t\t\t\t}\n1853\t\t\tdefault:\n1854\t\t\t\teval.Blockers = append(eval.Blockers, \"criterion \"+required.ID+\" has invalid disposition\")\n1855\t\t\t}\n1856\t\t\tif len(required.EvidenceClasses) > 0 && criterion.Disposition == \"passed\" && !vocabularyExempt {\n1857\t\t\t\tmatched := false\n1858\t\t\t\trefs := append([]string{criterion.Evidence}, current.EvidenceRefs...)\n1859\t\t\t\tfor _, ref := range refs {\n1860\t\t\t\t\tclass := strings.SplitN(ref, \":\", 2)[0]\n1861\t\t\t\t\tfor _, requiredClass := range required.EvidenceClasses {\n1862\t\t\t\t\t\tif class == requiredClass {\n1863\t\t\t\t\t\t\tmatched = true\n1864\t\t\t\t\t\t}\n1865\t\t\t\t\t}\n1866\t\t\t\t}\n1867\t\t\t\tif !matched {\n1868\t\t\t\t\teval.Blockers = append(eval.Blockers, \"criterion \"+required.ID+\" lacks a required evidence class\")\n1869\t\t\t\t}\n1870\t\t\t}\n1871\t\t}\n1872\t\tallowedRisk := map[string]bool{}\n1873\t\tfor _, severity := range policy.AcceptedRiskSeverities {\n1874\t\t\tallowedRisk[severity] = true\n1875\t\t}\n1876\t\tseenFindings := map[string]bool{}\n1877\t\tfor _, finding := range current.Findings {\n1878\t\t\tif seenFindings[finding.ID] {\n1879\t\t\t\teval.Blockers = append(eval.Blockers, \"duplicate finding \"+finding.ID)\n1880\t\t\t}\n1881\t\t\tseenFindings[finding.ID] = true\n1882\t\t\tif finding.Severity == \"\" || finding.Action == \"\" {\n1883\t\t\t\teval.Blockers = append(eval.Blockers, \"finding \"+finding.ID+\" lacks severity or action\")\n1884\t\t\t}\n1885\t\t\tswitch finding.Disposition {\n1886\t\t\tcase \"resolved\", \"wont-fix\":\n1887\t\t\tcase \"accepted-risk\":\n1888\t\t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n1889\t\t\t\t\teval.Blockers = append(eval.Blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n1890\t\t\t\t}\n1891\t\t\tcase \"open\", \"changes-requested\":\n1892\t\t\t\teval.Blockers = append(eval.Blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n1893\t\t\tdefault:\n1894\t\t\t\teval.Blockers = append(eval.Blockers, \"finding \"+finding.ID+\" has invalid disposition\")\n1895\t\t\t}\n1896\t\t}\n1897\t\tdecisionAllowed := current.Decision == \"approved\" || (current.Decision == \"approved-with-reservations\" && policy.AllowApprovedWithReservations)\n1898\t\tif !decisionAllowed {\n1899\t\t\teval.Blockers = append(eval.Blockers, \"review decision does not permit closeout: \"+current.Decision)\n1900\t\t}\n1901\t\tsort.Strings(eval.Blockers)\n1902\t\teval.Approved = len(eval.Blockers) == 0\n1903\t\treturn eval, nil\n1904\t}\n1905\t\n1906\t// evaluateReviewToolCoverage reports why a set of tool dispositions does not\n1907\t// cover the plan.\n1908\t//\n1909\t// scopeHasDeliveryTarget says whether the scope collects validation evidence at\n1910\t// all. A tool gated on `delivery-target-declared` cannot run in a scope that has\n1911\t// none, and requiring it to have passed there is requiring a fabricated\n1912\t// disposition — which is what auto-attest used to produce. Such a tool is\n1913\t// treated the way `review-complete` already is: deferrable, with a reason.\n1914\tfunc evaluateReviewToolCoverageIn(files Files, root string, planTools []ReviewPlanTool, dispositions []ReviewToolDisposition, sealed map[string]ReviewBundleEvidence, scopeHasDeliveryTarget bool) ([]string, []string) {\n1915\t\twarnings, blockers := []string{}, []string{}\n1916\t\tplanned := map[string]ReviewPlanTool{}\n1917\t\tfor _, tool := range planTools {\n1918\t\t\tplanned[reviewToolKey(tool.ID, tool.Component)] = tool\n1919\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"bfadcd3e-a8c4-4626-9aac-6a87a2ad34df","timestamp":"2026-11-26T00:19:56.629Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3050911272/worktree/pose-mcp/internal/pose/review_closeout.go","content":"\t\t\t}\n\t\t\teval.Blockers = append(eval.Blockers, childBlockers...)\n\t\t\trefused := bundle != nil && (!s.sealedDeclarationHolds(bundle) || s.FederatedResolver != nil && (verifyErr != nil || !s.retainedApprovalStands(bundle, verification.currentManifest)))\n\t\t\tif bundle != nil && !refused {\n\t\t\t\teval.Fresh = true\n\t\t\t\teval.Approved = true\n\t\t\t\teval.BundleState = \"closed\"\n\t\t\t\teval.ScopeDigest = bundle.BundleDigest\n\t\t\t\teval.BundleID = bundle.BundleID\n\t\t\t\teval.settledBundle = bundle\n\t\t\t\teval.BundleDigest = bundle.BundleDigest\n\t\t\t\teval.PlanDigest = bundle.Payload.Plan.PlanDigest\n\t\t\t\teval.AttestationID = att.AttestationID\n\t\t\t\teval.settledAttestation = att\n\t\t\t\teval.Current = &ReviewAttempt{SchemaVersion: ReviewBundleSchemaVersion, ReviewID: att.AttestationID, Scope: ref, ScopeDigest: att.BundleDigest, PlanDigest: eval.PlanDigest, Profile: profileRef, Reviewer: att.Reviewer, Decision: att.Decision, ReviewedAt: att.AttestedAt, Supersedes: att.Supersedes, EvidenceRefs: att.EvidenceRefs, Criteria: att.Criteria, Tools: att.Tools, Findings: att.Findings, Path: att.Path}\n\t\t\t\teval.Warnings = append(eval.Warnings, retainedCompletedReviewWarning)\n\t\t\t\treturn eval, nil\n\t\t\t}\n\t\t\t// A closed scope whose newest review rejected it or requested changes\n\t\t\t// has a review; saying none exists sent operators looking for a\n\t\t\t// missing record instead of the findings (spec\n\t\t\t// review-check-names-a-negative-verdict).\n\t\t\tif bundle, att := s.latestNegativeReview(ref); bundle != nil {\n\t\t\t\teval.BundleState = att.Decision\n\t\t\t\teval.ScopeDigest = bundle.BundleDigest\n\t\t\t\teval.BundleID = bundle.BundleID\n\t\t\t\teval.settledBundle = bundle\n\t\t\t\teval.BundleDigest = bundle.BundleDigest\n\t\t\t\teval.PlanDigest = bundle.Payload.Plan.PlanDigest\n\t\t\t\teval.AttestationID = att.AttestationID\n\t\t\t\teval.settledAttestation = att\n\t\t\t\teval.Current = &ReviewAttempt{SchemaVersion: ReviewBundleSchemaVersion, ReviewID: att.AttestationID, Scope: ref, ScopeDigest: att.BundleDigest, PlanDigest: eval.PlanDigest, Profile: profileRef, Reviewer: att.Reviewer, Decision: att.Decision, ReviewedAt: att.AttestedAt, Supersedes: att.Supersedes, EvidenceRefs: att.EvidenceRefs, Criteria: att.Criteria, Tools: att.Tools, Findings: att.Findings, Path: att.Path}\n\t\t\t\teval.Blockers = append(eval.Blockers, \"latest review \"+att.AttestationID+\" of \"+ref+\" decided \"+att.Decision+\"; remediate its findings and seal a superseding bundle\")\n\t\t\t\tfor _, finding := range att.Findings {\n\t\t\t\t\tif finding.Disposition == \"open\" || finding.Disposition == \"changes-requested\" {\n\t\t\t\t\t\teval.Blockers = append(eval.Blockers, \"finding \"+finding.ID+\" (\"+finding.Severity+\") is \"+finding.Disposition+\": \"+finding.Action)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\teval.Blockers = uniqueSorted(eval.Blockers)\n\t\t\t\treturn eval, nil\n\t\t\t}\n\t\t\tif verifyErr != nil && (refused || !s.reviewBundlesLegacyAttemptExempt(scope, policy)) {\n\t\t\t\treturn eval, verifyErr\n\t\t\t}\n\t\t\tif refused {\n\t\t\t\teval.BundleState = verification.State\n\t\t\t\teval.Blockers = uniqueSorted(append(append(eval.Blockers, verification.Blockers...), retainedManifestChanged(bundle, ref)))\n\t\t\t\teval.Warnings = uniqueSorted(append(eval.Warnings, verification.Warnings...))\n\t\t\t\treturn eval, nil\n\t\t\t}\n\t\t\t// Fall through to legacy check\n\t\t} else if verifyErr != nil {\n\t\t\treturn eval, verifyErr\n\t\t} else {\n\t\t\teval.Fresh = verification.Fresh\n\t\t\teval.Approved = verification.Approved\n\t\t\teval.Blockers = append(eval.Blockers, verification.Blockers...)\n\t\t\teval.Warnings = append(eval.Warnings, verification.Warnings...)\n\t\t\teval.BundleState = verification.State\n\t\t\tif verification.Bundle != nil {\n\t\t\t\teval.ScopeDigest = verification.Bundle.BundleDigest\n\t\t\t\teval.BundleID = verification.Bundle.BundleID\n\t\t\t\teval.settledBundle = verification.Bundle\n\t\t\t\teval.BundleDigest = verification.Bundle.BundleDigest\n\t\t\t\teval.PlanDigest = verification.Bundle.Payload.Plan.PlanDigest\n\t\t\t}\n\t\t\tif verification.Attestation != nil {\n\t\t\t\teval.AttestationID = verification.Attestation.AttestationID\n\t\t\t\teval.settledAttestation = verification.Attestation\n\t\t\t\tatt := verification.Attestation\n\t\t\t\teval.Current = &ReviewAttempt{SchemaVersion: ReviewBundleSchemaVersion, ReviewID: att.AttestationID, Scope: ref, ScopeDigest: att.BundleDigest, PlanDigest: eval.PlanDigest, Profile: profileRef, Reviewer: att.Reviewer, Decision: att.Decision, ReviewedAt: att.AttestedAt, Supersedes: att.Supersedes, EvidenceRefs: att.EvidenceRefs, Criteria: att.Criteria, Tools: att.Tools, Findings: att.Findings, Path: att.Path}\n\t\t\t}\n\t\t\teval.Blockers = uniqueSorted(eval.Blockers)\n\t\t\teval.Warnings = uniqueSorted(eval.Warnings)\n\t\t\treturn eval, nil\n\t\t}\n\t}\n\tprofile, _, err := s.loadReviewProfile(profileRef)\n\tif err != nil {\n\t\treturn eval, err\n\t}\n\tbaseRequiredCriteria := append([]ReviewCriterionProfile{}, profile.Criteria...)\n\trequiredCriteria := append([]ReviewCriterionProfile{}, baseRequiredCriteria...)\n\teffectiveTools := []ReviewPlanTool{}\n\tbaseIndependence := policy.ReviewerIndependence[scope.Kind]\n\tindependence := baseIndependence\n\tif policy.SchemaVersion >= ReviewPolicySchemaVersion && policy.ComponentAware {\n\t\tplan, planErr := s.ReviewPlan(ref)\n\t\tif planErr != nil {\n\t\t\treturn eval, planErr\n\t\t}\n\t\teval.PlanDigest = plan.PlanDigest\n\t\teval.Warnings = append(eval.Warnings, plan.Warnings...)\n\t\teval.Blockers = append(eval.Blockers, plan.Blockers...)\n\t\trequiredCriteria = requiredCriteria[:0]\n\t\tfor _, criterion := range plan.Criteria {\n\t\t\tif !criterion.Required {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\trequired := true\n\t\t\trequiredCriteria = append(requiredCriteria, ReviewCriterionProfile{ID: criterion.ID, Description: criterion.Description, Rules: criterion.Rules, EvidenceClasses: criterion.EvidenceClasses, Required: &required})\n\t\t}\n\t\teffectiveTools = append(effectiveTools, plan.Tools...)\n\t\tindependence = plan.Independence\n\t}\n\tattemptsRead, err := s.ReadReviewAttempts(ref)\n\tif err != nil {\n\t\treturn eval, err\n\t}\n\tattempts := attemptsRead.Attempts\n\tif len(attempts) == 0 {\n\t\tif lost := attemptsRead.HistoryUncertainAfter(ref, \"\", \"\"); len(lost) > 0 {\n\t\t\t// Records that could not be read may be attempts: absence is not proven.\n\t\t\teval.Blockers = append(eval.Blockers, \"no readable review attempt exists for \"+ref+\", and the review history is incomplete: \"+(SourceCoverage{Losses: lost}).Describe(\"\"))\n\t\t\treturn eval, nil\n\t\t}\n\t\teval.Blockers = append(eval.Blockers, \"no review attempt exists for \"+ref)\n\t\treturn eval, nil\n\t}\n\tcurrent := attempts[len(attempts)-1]\n\teval.Current = &current\n\t// An attempt that could not be read may be a later one, a rejection among them:\n\t// the latest readable attempt is not taken as the current one until the history is\n\t// readable. A record whose name shows it is older than the current attempt cannot\n\t// have superseded it and is only disclosed.\n\tif lost := attemptsRead.HistoryUncertainAfter(ref, current.ReviewedAt, current.ReviewID); len(lost) > 0 {\n\t\teval.Blockers = append(eval.Blockers, \"review history for \"+ref+\" is incomplete, so the latest readable attempt is not known to be the current one: \"+(SourceCoverage{Losses: lost}).Describe(\"\")+\"; restore or remove the unreadable record\")\n\t}\n\tif older := len(attemptsRead.Coverage.LossesFor(ref)) - len(attemptsRead.HistoryUncertainAfter(ref, current.ReviewedAt, current.ReviewID)); older > 0 {\n\t\teval.Warnings = append(eval.Warnings, fmt.Sprintf(\"%d unreadable review record(s) predate the current attempt and cannot have superseded it\", older))\n\t}\n\tlegacyPlanExempt := s.componentAwareLegacyAttemptExempt(scope, policy, current)\n\t// Reconciling a profile's evidence classes changes the effective plan, and a\n\t// completed scope's attempt is compared against the plan as it is today. So\n\t// renaming `test` to the three classes that can actually be produced makes\n\t// every past closeout stale, without any of them having become less\n\t// reviewed. This exemption is narrower than legacyPlanExempt: the criteria\n\t// and tools still stand, only the digest comparison and the class match are\n\t// waived, and only for a scope already done whose review predates the date.\n\tvocabularyExempt := s.evidenceVocabularyLegacyExempt(scope, policy, current)\n\tif vocabularyExempt {\n\t\teval.Warnings = append(eval.Warnings, \"completed scope retains its approved review recorded before the evidence vocabulary was reconciled\")\n\t}\n\t// The same shape again, one contract later. Resolving a criterion's kind put\n\t// a field into the sealed plan, so every plan digest moved — including those\n\t// of scopes closed years of commits ago, whose reviews became `superseded`\n\t// without anything about them having become less reviewed.\n\t//\n\t// The spec that introduced the field predicted this and claimed the existing\n\t// exemption covered completed scopes. It did not: the two above are keyed to\n\t// their own contracts, and `pose check --strict` failed on the first\n\t// unrelated done spec it reached. Naming the third one is the fix the\n\t// pattern already prescribes.\n\tjudgmentExempt := s.explicitJudgmentLegacyExempt(scope, policy, current)\n\tif judgmentExempt {\n\t\teval.Warnings = append(eval.Warnings, \"completed scope retains its approved review recorded before criterion kinds entered the plan\")\n\t}\n\tif legacyPlanExempt {\n\t\trequiredCriteria = append([]ReviewCriterionProfile{}, baseRequiredCriteria...)\n\t\teffectiveTools = nil\n\t\tindependence = baseIndependence\n\t\teval.Warnings = append(eval.Warnings, \"completed scope retains its approved pre-component-aware review attempt\")\n\t}\n\tif len(attempts) > 1 && current.Supersedes != attempts[len(attempts)-2].ReviewID {\n\t\teval.Blockers = append(eval.Blockers, \"latest review does not supersede the previous attempt\")\n\t}\n\tif current.ScopeDigest != digest && !legacyPlanExempt {\n\t\teval.Blockers = append(eval.Blockers, \"review is stale: scope digest changed\")\n\t} else {\n\t\teval.Fresh = true\n\t}\n\tif eval.PlanDigest != \"\" && current.PlanDigest != eval.PlanDigest && !legacyPlanExempt && !vocabularyExempt && !judgmentExempt {\n\t\teval.Fresh = false\n\t\tif current.PlanDigest == \"\" {\n\t\t\teval.Blockers = append(eval.Blockers, \"review is stale: effective plan digest is missing\")\n\t\t} else {\n\t\t\teval.Blockers = append(eval.Blockers, \"review is stale: effective plan digest changed\")\n\t\t}\n\t}\n\tif current.Profile != profile.Ref() {\n\t\teval.Blockers = append(eval.Blockers, \"review profile does not match current policy\")\n\t}\n\tfor _, ref := range current.EvidenceRefs {\n\t\tif err := validateReviewEvidenceRef(s.fsys(), s.Root, ref); err != nil {\n\t\t\teval.Blockers = append(eval.Blockers, err.Error())\n\t\t}\n\t}\n\tif len(effectiveTools) > 0 {\n\t\ttoolWarnings, toolBlockers := // The legacy attempt path has no sealed bundle to check against.\n\t\t\tevaluateReviewToolCoverageIn(s.fsys(), s.Root, effectiveTools, current.Tools, nil, true)\n\t\teval.Warnings = append(eval.Warnings, toolWarnings...)\n\t\teval.Blockers = append(eval.Blockers, toolBlockers...)\n\t}\n\tif current.Reviewer == \"\" || strings.ContainsAny(current.Reviewer, \"\\r\\n\") {\n\t\teval.Blockers = append(eval.Blockers, \"reviewer execution identity is missing or malformed\")\n\t}\n\tswitch independence {\n\tcase \"\", \"same-actor-separate-execution\":\n\t\tif !strings.HasPrefix(current.Reviewer, \"agent:\") && !strings.HasPrefix(current.Reviewer, \"human:\") {\n\t\t\teval.Blockers = append(eval.Blockers, \"reviewer must use an agent: or human: execution identity\")\n\t\t}\n\tcase \"different-actor\":\n\t\tif !strings.HasPrefix(current.Reviewer, \"agent:independent-\") && !strings.HasPrefix(current.Reviewer, \"human:\") {\n\t\t\teval.Blockers = append(eval.Blockers, \"review policy requires a different-actor reviewer identity; under declared assurance that is read from the reviewer prefix, not authenticated\")\n\t\t}\n\tcase \"mandatory-human\":\n\t\tif !strings.HasPrefix(current.Reviewer, \"human:\") {\n\t\t\teval.Blockers = append(eval.Blockers, \"review policy requires human approval\")\n\t\t}\n\tdefault:\n\t\teval.Blockers = append(eval.Blockers, \"review policy has invalid independence mode \"+independence)\n\t}\n\tif _, err := time.Parse(time.RFC3339, current.ReviewedAt); err != nil {\n\t\teval.Blockers = append(eval.Blockers, \"reviewed_at must be RFC3339\")\n\t}\n\tcriteria := map[string]ReviewCriterion{}\n\tprofileCriteria := map[string]bool{}\n\tfor _, required := range requiredCriteria {\n\t\tprofileCriteria[required.ID] = true\n\t}\n\tfor _, criterion := range current.Criteria {\n\t\tif _, duplicate := criteria[criterion.ID]; duplicate {\n\t\t\teval.Blockers = append(eval.Blockers, \"duplicate criterion \"+criterion.ID)\n\t\t}\n\t\tcriteria[criterion.ID] = criterion\n\t\tif !profileCriteria[criterion.ID] {\n\t\t\teval.Blockers = append(eval.Blockers, \"unknown criterion \"+criterion.ID)\n\t\t}\n\t\tif criterion.Evidence != \"\" {\n\t\t\tif err := validateReviewEvidenceRef(s.fsys(), s.Root, criterion.Evidence); err != nil {\n\t\t\t\teval.Blockers = append(eval.Blockers, err.Error())\n\t\t\t}\n\t\t}\n\t}\n\tfor _, required := range requiredCriteria {\n\t\tcriterion, ok := criteria[required.ID]\n\t\tif !ok {\n\t\t\teval.Blockers = append(eval.Blockers, \"missing criterion \"+required.ID)\n\t\t\tcontinue\n\t\t}\n\t\tswitch criterion.Disposition {\n\t\tcase \"passed\":\n\t\t\tif criterion.Evidence == \"\" && len(current.EvidenceRefs) == 0 {\n\t\t\t\teval.Blockers = append(eval.Blockers, \"criterion \"+required.ID+\" has no evidence\")\n\t\t\t}\n\t\tcase \"finding\":\n\t\t\tif len(current.Findings) == 0 {\n\t\t\t\teval.Blockers = append(eval.Blockers, \"criterion \"+required.ID+\" references a missing finding\")\n\t\t\t}\n\t\tcase \"not-applicable\":\n\t\t\tif criterion.Rationale == \"\" {\n\t\t\t\teval.Blockers = append(eval.Blockers, \"criterion \"+required.ID+\" lacks not-applicable rationale\")\n\t\t\t}\n\t\tdefault:\n\t\t\teval.Blockers = append(eval.Blockers, \"criterion \"+required.ID+\" has invalid disposition\")\n\t\t}\n\t\tif len(required.EvidenceClasses) > 0 && criterion.Disposition == \"passed\" && !vocabularyExempt {\n\t\t\tmatched := false\n\t\t\trefs := append([]string{criterion.Evidence}, current.EvidenceRefs...)\n\t\t\tfor _, ref := range refs {\n\t\t\t\tclass := strings.SplitN(ref, \":\", 2)[0]\n\t\t\t\tfor _, requiredClass := range required.EvidenceClasses {\n\t\t\t\t\tif class == requiredClass {\n\t\t\t\t\t\tmatched = true\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !matched {\n\t\t\t\teval.Blockers = append(eval.Blockers, \"criterion \"+required.ID+\" lacks a required evidence class\")\n\t\t\t}\n\t\t}\n\t}\n\tallowedRisk := map[string]bool{}\n\tfor _, severity := range policy.AcceptedRiskSeverities {\n\t\tallowedRisk[severity] = true\n\t}\n\tseenFindings := map[string]bool{}\n\tfor _, finding := range current.Findings {\n\t\tif seenFindings[finding.ID] {\n\t\t\teval.Blockers = append(eval.Blockers, \"duplicate finding \"+finding.ID)\n\t\t}\n\t\tseenFindings[finding.ID] = true\n\t\tif finding.Severity == \"\" || finding.Action == \"\" {\n\t\t\teval.Blockers = append(eval.Blockers, \"finding \"+finding.ID+\" lacks severity or action\")\n\t\t}\n\t\tswitch finding.Disposition {\n\t\tcase \"resolved\", \"wont-fix\":\n\t\tcase \"accepted-risk\":\n\t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n\t\t\t\teval.Blockers = append(eval.Blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n\t\t\t}\n\t\tcase \"open\", \"changes-requested\":\n\t\t\teval.Blockers = append(eval.Blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n\t\tdefault:\n\t\t\teval.Blockers = append(eval.Blockers, \"finding \"+finding.ID+\" has invalid disposition\")\n\t\t}\n\t}\n\tdecisionAllowed := current.Decision == \"approved\" || (current.Decision == \"approved-with-reservations\" && policy.AllowApprovedWithReservations)\n\tif !decisionAllowed {\n\t\teval.Blockers = append(eval.Blockers, \"review decision does not permit closeout: \"+current.Decision)\n\t}\n\tsort.Strings(eval.Blockers)\n\teval.Approved = len(eval.Blockers) == 0\n\treturn eval, nil\n}\n\n// evaluateReviewToolCoverage reports why a set of tool dispositions does not\n// cover the plan.\n//\n// scopeHasDeliveryTarget says whether the scope collects validation evidence at\n// all. A tool gated on `delivery-target-declared` cannot run in a scope that has\n// none, and requiring it to have passed there is requiring a fabricated\n// disposition — which is what auto-attest used to produce. Such a tool is\n// treated the way `review-complete` already is: deferrable, with a reason.\nfunc evaluateReviewToolCoverageIn(files Files, root string, planTools []ReviewPlanTool, dispositions []ReviewToolDisposition, sealed map[string]ReviewBundleEvidence, scopeHasDeliveryTarget bool) ([]string, []string) {\n\twarnings, blockers := []string{}, []string{}\n\tplanned := map[string]ReviewPlanTool{}\n\tfor _, tool := range planTools {\n\t\tplanned[reviewToolKey(tool.ID, tool.Component)] = tool\n\t}","numLines":320,"startLine":1600,"totalLines":3019}},"tool_result_meta":[{"id":"toolu_01Ke84ANJg6hJnyyU6Xa3UN8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
