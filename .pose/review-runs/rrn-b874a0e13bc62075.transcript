change it approves.\n4021\t\t//\n4022\t\t// Bounded to a scope that carries a delivery target, because the other case\n4023\t\t// is already modelled and already honest: a documentation-only spec collects\n4024\t\t// no validation evidence by design, and recording every criterion\n4025\t\t// not-applicable — naming what is missing — is the answer the engine itself\n4026\t\t// prepares for it. Refusing that would break the distinction this contract\n4027\t\t// depends on rather than reinforce it.\n4028\t\tif judgmentGoverned && hasDeliveryTarget && len(required) > 0 && notApplicable == len(required) && len(att.Criteria) == len(required) {\n4029\t\t\tblockers = append(blockers, \"every required criterion is not-applicable; a scope where the whole plan is inapplicable is not reviewed by it\")\n4030\t\t}\n4031\t\treuseBlockers, _ := s.evaluateReviewReuse(bundle, att, bundle.Payload.SealedGates().AllowCriterionReuse)\n4032\t\tblockers = append(blockers, reuseBlockers...)\n4033\t\tsealedEvidence := map[string]ReviewBundleEvidence{}\n4034\t\tfor _, ev := range bundle.Payload.Evidence {\n4035\t\t\tsealedEvidence[ev.EvidenceClass+\":\"+ev.ID] = ev\n4036\t\t}\n4037\t\tif skipEvidenceSupport {\n4038\t\t\tsealedEvidence = nil\n4039\t\t}\n4040\t\ttoolWarnings, toolBlockers := evaluateReviewToolCoverageIn(s.fsys(), s.Root, bundle.Payload.Plan.Tools, att.Tools, sealedEvidence, hasDeliveryTarget)\n4041\t\t_ = toolWarnings\n4042\t\tblockers = append(blockers, toolBlockers...)\n4043\t\tblockers = append(blockers, reviewFindingDecisionBlockers(bundle, att)...)\n4044\t\treturn blockers\n4045\t}\n4046\t\n4047\t// The same finding and decision gate protects fresh and reused approvals.\n4048\tfunc reviewFindingDecisionBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n4049\t\tblockers := []string{}\n4050\t\t// The finding contract, which this path did not have. It accepted a\n4051\t\t// `critical` risk with no owner, no rationale and no review date; a\n4052\t\t// disposition the engine does not know; and a finding with neither severity\n4053\t\t// nor action — all three with no blocker at all, while the legacy attempt\n4054\t\t// path refused every one of them. A project that adopted review bundles\n4055\t\t// silently lost the gate (spec\n4056\t\t// pose-bundle-findings-take-the-contract-the-legacy-path-had).\n4057\t\t//\n4058\t\t// Only the accepted-risk severities and the reservations flag come from the\n4059\t\t// sealed gates. The rest is not configuration: a finding without a severity\n4060\t\t// is incomplete under any policy.\n4061\t\tallowedRisk := map[string]bool{}\n4062\t\tfor _, severity := range bundle.Payload.SealedGates().AcceptedRiskSeverities {\n4063\t\t\tallowedRisk[severity] = true\n4064\t\t}\n4065\t\tseenFindings := map[string]bool{}\n4066\t\tfor _, finding := range att.Findings {\n4067\t\t\tif seenFindings[finding.ID] {\n4068\t\t\t\tblockers = append(blockers, \"duplicate finding \"+finding.ID)\n4069\t\t\t}\n4070\t\t\tseenFindings[finding.ID] = true\n4071\t\t\tif finding.Severity == \"\" || finding.Action == \"\" {\n4072\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" lacks severity or action\")\n4073\t\t\t}\n4074\t\t\tswitch finding.Disposition {\n4075\t\t\tcase \"resolved\":\n4076\t\t\tcase \"accepted-risk\", \"wont-fix\":\n4077\t\t\t\t// Leaving a finding unresolved accepts its risk regardless of the\n4078\t\t\t\t// disposition's spelling. Use the policy frozen into this bundle.\n4079\t\t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n4080\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n4081\t\t\t\t}\n4082\t\t\tcase \"within-limit\":\n4083\t\t\t\t// Inside a limit the spec declared and the bundle sealed, whatever\n4084\t\t\t\t// its severity; a limit the bundle did not seal accepts nothing\n4085\t\t\t\t// (spec pose-review-declared-threat-model R3).\n4086\t\t\t\tif !sealedAcceptedLimit(bundle, finding.Limit) {\n4087\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" names accepted limit \"+firstNonempty(finding.Limit, \"(none)\")+\", which this bundle did not seal\")\n4088\t\t\t\t} else if strings.TrimSpace(finding.Rationale) == \"\" {\n4089\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is within limit \"+finding.Limit+\" without saying why\")\n4090\t\t\t\t}\n4091\t\t\tcase \"open\", \"changes-requested\":\n4092\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n4093\t\t\tdefault:\n4094\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has invalid disposition\")\n4095\t\t\t}\n4096\t\t}\n4097\t\tif att.Decision != \"approved\" && !(att.Decision == \"approved-with-reservations\" && bundle.Payload.SealedGates().AllowApprovedWithReservations) {\n4098\t\t\tblockers = append(blockers, \"review decision does not permit closeout: \"+att.Decision)\n4099\t\t}\n4100\t\treturn blockers\n4101\t}\n4102\t\n4103\tfunc (s Store) verifyStoredReviewAttestationSignature(att ReviewAttestation) error {\n4104\t\tif att.Envelope == nil {\n4105\t\t\t// Recorded before signing was required, and sealed unchanged into a\n4106\t\t\t// trusted legacy ledger (spec pose-signed-legacy-attestation-ledger).\n4107\t\t\tif s.legacyLedgerCovers(att) {\n4108\t\t\t\treturn nil\n4109\t\t\t}\n4110\t\t\tif coverage := s.LegacyLedgerCoverage(); !coverage.Complete() {\n4111\t\t\t\t// Not trusted, and not for want of a ledger: one could not be used.\n4112\t\t\t\treturn fmt.Errorf(\"signed attestation proof is required by review policy; a legacy ledger that may cover it could not be used: %s\", coverage.Describe(\"\"))\n4113\t\t\t}\n4114\t\t\treturn fmt.Errorf(\"signed attestation proof is required by review policy\")\n4115\t\t}\n4116\t\tproof := *att.Envelope\n4117\t\tunsigned := att\n4118\t\tunsigned.Path = \"\"\n4119\t\tunsigned.Envelope = nil\n4120\t\t_, err := s.VerifyReviewAttestationEnvelope(ReviewAttestationEnvelope{SchemaVersion: ReviewBundleSchemaVersion, Issuer: proof.Issuer, Subject: proof.Subject, Algorithm: proof.Algorithm, PublicKey: proof.PublicKey, Signature: proof.Signature, Attestation: unsigned})\n4121\t\treturn err\n4122\t}\n4123\t\n4124\t// reviewCriterionEvidenceBlockers checks that a criterion recorded as passed is\n4125\t// supported by evidence the sealed bundle actually contains, of a class the\n4126\t// criterion asks for.\n4127\t//\n4128\t// Nothing checked this before. A `passed` disposition could cite evidence\n4129\t// absent from the bundle, evidence of the wrong class, or nothing at all, and\n4130\t// the attestation verified — which is how three closeouts in an adopting\n4131\t// repository were approved against a bundle carrying zero evidence, and how a\n4132\t// criterion requiring `integration` passed on a `go vet` result. An attestation\n4133\t// that cannot be checked against its own subject is a signature on an empty\n4134\t// page.\n4135\t//\n4136\t// Only `passed` is constrained. `not-applicable` already requires a rationale,\n4137\t// which is the reviewer's judgement standing in for evidence, and `finding`\n4138\t// records a problem rather than a clearance.\n4139\tfunc reviewCriterionEvidenceBlockers(bundle ReviewBundle, planned ReviewPlanCriterion, attested ReviewCriterion) []string {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"700288dc-881f-4fed-a745-65984194da99","timestamp":"2026-11-26T00:19:46.688Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3050911272/worktree/pose-mcp/internal/pose/review_bundle.go","content":"\t\t}\n\t\tif criterion.Disposition == \"finding\" {\n\t\t\tif criterion.Evidence == \"\" {\n\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" is disposed as a finding and names none\")\n\t\t\t} else if !recordedFindings[criterion.Evidence] {\n\t\t\t\tblockers = append(blockers, \"criterion \"+criterio