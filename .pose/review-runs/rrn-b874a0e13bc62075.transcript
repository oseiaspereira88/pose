{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017pHkoeiHnAxzcNZrYwf7Zq","type":"tool_result","content":"1\tpackage pose\n2\t\n3\t// Seal readiness (spec pose-review-readiness-before-seal R1, R2): a new seal\n4\t// refuses what `pose close` and the conclusion preflight would refuse only\n5\t// after a full review round, using the same rules. A bundle already sealed\n6\t// is returned as it was and never re-judged here.\n7\t\n8\timport \"sort\"\n9\t\n10\t// sealReadinessFindingCodes are the declaration findings a seal refuses:\n11\t// what the spec must declare about its own change, known before any review.\n12\t// Evidence findings stay at close, where their inputs are final.\n13\tvar sealReadinessFindingCodes = map[string]bool{\"undeclared-delivery\": true, \"undeclared\": true}\n14\t\n15\tfunc (s Store) sealReadinessBlockers(bundle ReviewBundle) []string {\n16\t\tscope, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n17\t\tif err != nil || scope.Kind != \"spec\" {\n18\t\t\treturn nil\n19\t\t}\n20\t\tvar blockers []string\n21\t\t// R1: the declarations `pose close` requires, read from the same index\n22\t\t// findings its delivery assurance gate reports.\n23\t\t{\n24\t\t\tif graph, err := s.GetDeliveryIntegrity(\"\"); err == nil {\n25\t\t\t\tfor _, finding := range graph.Findings {\n26\t\t\t\t\tif !sealReadinessFindingCodes[finding.Code] || finding.Spec != scope.Slug || finding.Severity != \"error\" && finding.Severity != \"critical\" {\n27\t\t\t\t\t\tcontinue\n28\t\t\t\t\t}\n29\t\t\t\t\tmsg := finding.Code + \" [\" + finding.Path + \"]: \" + finding.Message\n30\t\t\t\t\tif finding.Remediation != \"\" {\n31\t\t\t\t\t\tmsg += \" (\" + finding.Remediation + \")\"\n32\t\t\t\t\t}\n33\t\t\t\t\tblockers = append(blockers, msg+\"; pose close refuses it after the review\")\n34\t\t\t\t}\n35\t\t\t}\n36\t\t}\n37\t\t// R2: a structural fact is mapped to a decision basis, and the preflight\n38\t\t// refuses a basis that reaches no requirement or constraint. When the plan\n39\t\t// asks for mappings, every declared decision must be usable as one.\n40\t\tasksMapping := false\n41\t\tfor _, criterion := range bundle.Payload.Plan.Criteria {\n42\t\t\tasksMapping = asksMapping || criterion.Required && criterion.RequiresStructuralMapping\n43\t\t}\n44\t\tif structure := bundle.Payload.Plan.Structure; asksMapping && structure != nil && len(structure.Material) > 0 {\n45\t\t\tns := s.reviewDesignBasisNamespace(scope)\n46\t\t\tvar unreached []string\n47\t\t\tfor id := range ns.Known {\n48\t\t\t\tif !ns.Reaches[id] {\n49\t\t\t\t\tunreached = append(unreached, id)\n50\t\t\t\t}\n51\t\t\t}\n52\t\t\tsort.Strings(unreached)\n53\t\t\tfor _, id := range unreached {\n54\t\t\t\tblockers = append(blockers, \"decision basis \"+id+\" reaches no requirement or constraint: give it a `- Basis:` line naming one, or the conclusion preflight refuses a mapping to it\")\n55\t\t\t}\n56\t\t}\n57\t\treturn uniqueSorted(blockers)\n58\t}\n59\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"754b4023-33c7-49e5-af61-b206d9827222","timestamp":"2026-11-26T00:20:50.557Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3050911272/worktree/pose-mcp/internal/pose/review_seal_readiness.go","content":"package pose\n\n// Seal readiness (spec pose-review-readiness-before-seal R1, R2): a new seal\n// refuses what `pose close` and the conclusion preflight would refuse only\n// after a full review round, using the same rules. A bundle already sealed\n// is returned as it was and never re-judged here.\n\nimport \"sort\"\n\n// sealReadinessFindingCodes are the declaration findings a seal refuses:\n// what the spec must declare about its own change, known before any review.\n// Evidence findings stay at close, where their inputs are final.\nvar sealReadinessFindingCodes = map[string]bool{\"undeclared-delivery\": true, \"undeclared\": true}\n\nfunc (s Store) sealReadinessBlockers(bundle ReviewBundle) []string {\n\tscope, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n\tif err != nil || scope.Kind != \"spec\" {\n\t\treturn nil\n\t}\n\tvar blockers []string\n\t// R1: the declarations `pose close` requires, read from the same index\n\t// findings its delivery assurance gate reports.\n\t{\n\t\tif graph, err := s.GetDeliveryIntegrity(\"\"); err == nil {\n\t\t\tfor _, finding := range graph.Findings {\n\t\t\t\tif !sealReadinessFindingCodes[finding.Code] || finding.Spec != scope.Slug || finding.Severity != \"error\" && finding.Severity != \"critical\" {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tmsg := finding.Code + \" [\" + finding.Path + \"]: \" + finding.Message\n\t\t\t\tif finding.Remediation != \"\" {\n\t\t\t\t\tmsg += \" (\" + finding.Remediation + \")\"\n\t\t\t\t}\n\t\t\t\tblockers = append(blockers, msg+\"; pose close refuses it after the review\")\n\t\t\t}\n\t\t}\n\t}\n\t// R2: a structural fact is mapped to a decision basis, and the preflight\n\t// refuses a basis that reaches no requirement or constraint. When the plan\n\t// asks for mappings, every declared decision must be usable as one.\n\tasksMapping := false\n\tfor _, criterion := range bundle.Payload.Plan.Criteria {\n\t\tasksMapping = asksMapping || criterion.Required && criterion.RequiresStructuralMapping\n\t}\n\tif structure := bundle.Payload.Plan.Structure; asksMapping && structure != nil && len(structure.Material) > 0 {\n\t\tns := s.reviewDesignBasisNamespace(scope)\n\t\tvar unreached []string\n\t\tfor id := range ns.Known {\n\t\t\tif !ns.Reaches[id] {\n\t\t\t\tunreached = append(unreached, id)\n\t\t\t}\n\t\t}\n\t\tsort.Strings(unreached)\n\t\tfor _, id := range unreached {\n\t\t\tblockers = append(blockers, \"decision basis \"+id+\" reaches no requirement or constraint: give it a `- Basis:` line naming one, or the conclusion preflight refuses a mapping to it\")\n\t\t}\n\t}\n\treturn uniqueSorted(blockers)\n}\n","numLines":59,"startLine":1,"totalLines":59}},"tool_result_meta":[{"id":"toolu_017pHkoeiHnAxzcNZrYwf7Zq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
