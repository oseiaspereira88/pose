{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S4gqp57qXyMYLLVSjJCxKT","type":"tool_result","content":"71\tfunc cmdReviewCheck(root string, args []string, stdout, stderr io.Writer) int {\n72\t\tref, jsonOutput, ok := parseScopeCheckArgs(\"review-check\", args, stderr)\n73\t\tif !ok {\n74\t\t\treturn 2\n75\t\t}\n76\t\tstore, localRef, err := cliReviewStore(root, ref)\n77\t\tif err != nil {\n78\t\t\trender(io.Discard, stderr).Failure(\"pose review-check: \" + err.Error())\n79\t\t\treturn 1\n80\t\t}\n81\t\troot, ref = store.Root, localRef\n82\t\teval, err := store.ReviewCheck(ref)\n83\t\tif err != nil {\n84\t\t\tfmt.Fprintf(stderr, \"pose review-check: %v\\n\", err)\n85\t\t\treturn 1\n86\t\t}\n87\t\tif jsonOutput {\n88\t\t\tif code := writeJSON(stdout, eval); code != 0 {\n89\t\t\t\treturn code\n90\t\t\t}\n91\t\t\tif eval.Required && !eval.Approved {\n92\t\t\t\treturn 1\n93\t\t\t}\n94\t\t\treturn 0\n95\t\t}\n96\t\tfmt.Fprintf(stdout, \"review.scope=%s\\nreview.required=%t\\nreview.profile=%s\\nreview.digest=%s\\nreview.fresh=%t\\nreview.approved=%t\\n\", eval.Scope, eval.Required, eval.Profile, eval.ScopeDigest, eval.Fresh, eval.Approved)\n97\t\tif eval.ReadView != nil {\n98\t\t\trender(stdout, stderr).Field(\"review.read_view\", fmt.Sprintf(\"id:%s freshness:%s roots:%d inputs:%d bytes:%d\",\n99\t\t\t\teval.ReadView.ID, eval.ReadView.Freshness, len(eval.ReadView.Bindings), eval.ReadView.ObservedInputs, eval.ReadView.InputBytes))\n100\t\t}\n101\t\tif eval.Assurance != nil {\n102\t\t\trender(stdout, stderr).Field(\"review.assurance\", posemodel.RenderReviewAssurance(*eval.Assurance))\n103\t\t}\n104\t\tfor _, warning := range eval.Warnings {\n105\t\t\tfmt.Fprintf(stdout, \"[WARN] %s\\n\", warning)\n106\t\t}\n107\t\tfor _, blocker := range eval.Blockers {\n108\t\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n109\t\t}\n110\t\tif eval.Required && !eval.Approved {\n111\t\t\treturn 1\n112\t\t}\n113\t\treturn 0\n114\t}\n115\t\n116\tfunc cmdReviewPlan(root string, args []string, stdout, stderr io.Writer) int {\n117\t\tref, jsonOutput, explain := \"\", false, false\n118\t\tfor _, arg := range args {\n119\t\t\tswitch arg {\n120\t\t\tcase \"--json\":\n121\t\t\t\tjsonOutput = true\n122\t\t\tcase \"--explain\":\n123\t\t\t\texplain = true\n124\t\t\tdefault:\n125\t\t\t\tif strings.HasPrefix(arg, \"-\") || ref != \"\" {\n126\t\t\t\t\tfmt.Fprintln(stderr, \"Usage: pose review-plan <spec:slug|milestone:roadmap/id|roadmap:slug> [--json] [--explain]\")\n127\t\t\t\t\treturn 2\n128\t\t\t\t}\n129\t\t\t\tref = arg\n130\t\t\t}\n131\t\t}\n132\t\tif ref == \"\" {\n133\t\t\tfmt.Fprintln(stderr, \"Usage: pose review-plan <spec:slug|milestone:roadmap/id|roadmap:slug> [--json] [--explain]\")\n134\t\t\treturn 2\n135\t\t}\n136\t\tstore, localRef, err := cliReviewStore(root, ref)\n137\t\tif err != nil {\n138\t\t\trender(io.Discard, stderr).Failure(\"pose review-plan: \" + err.Error())\n139\t\t\treturn 1\n140\t\t}\n141\t\troot, ref = store.Root, localRef\n142\t\tplan, err := store.ReviewPlan(ref)\n143\t\tif err != nil {\n144\t\t\tfmt.Fprintf(stderr, \"pose review-plan: %v\\n\", err)\n145\t\t\treturn 1\n146\t\t}\n147\t\tif jsonOutput {\n148\t\t\tif code := writeJSON(stdout, plan); code != 0 {\n149\t\t\t\treturn code\n150\t\t\t}\n151\t\t\tif len(plan.Blockers) > 0 {\n152\t\t\t\treturn 1\n153\t\t\t}\n154\t\t\treturn 0\n155\t\t}\n156\t\tfmt.Fprintf(stdout, \"review_plan.scope=%s\\nreview_plan.scope_digest=%s\\nreview_plan.plan_digest=%s\\nreview_plan.base_profile=%s\\nreview_plan.independence=%s\\nreview_plan.band=%s\\nreview_plan.components=%d\\nreview_plan.criteria=%d\\nreview_plan.tools=%d\\n\", plan.Scope, plan.ScopeDigest, plan.PlanDigest, plan.BaseProfile, plan.Independence, plan.Band, len(plan.Components), len(plan.Criteria), len(plan.Tools))\n157\t\t// The plan states the separation it requires; whether that separation can\n158\t\t// be authenticated depends on the identity assurance in force, which the\n159\t\t// plan digest deliberately does not include (spec\n160\t\t// pose-review-assurance-disclosure).\n161\t\tif scope, scopeErr := posemodel.ParseScopeRef(plan.Scope); scopeErr == nil {\n162\t\t\tif policy, policyErr := (posemodel.Store{Root: root}).GetReviewPolicy(); policyErr == nil {\n163\t\t\t\tassurance := policy.ReviewIdentityAssurance(scope.Kind)\n164\t\t\t\tmeaning := \"the reviewer identity is the string the reviewer writes; the required separation will be declared, not authenticated\"\n165\t\t\t\tif assurance == posemodel.ReviewIdentityAssuranceVerified {\n166\t\t\t\t\tmeaning = \"the reviewer identity and separation must be established by a signed authority claim bound to the bundle\"\n167\t\t\t\t}\n168\t\t\t\trender(stdout, stderr).Field(\"review_plan.identity_assurance\", assurance+\" (\"+meaning+\")\")\n169\t\t\t}\n170\t\t}\n171\t\t// The forecast and the observed expansion print without --explain: a\n172\t\t// reviewer who never asks for the long form still has to see that the\n173\t\t// obligations in front of them came from scope nobody declared. These lines\n174\t\t// go through the renderer, which is also what the output ratchet requires.\n175\t\tout := render(stdout, stderr)\n176\t\tout.Field(\"projection.basis\", fmt.Sprintf(\"%s band=%s independence=%s scope_expanded=%t\", plan.Projection.Basis, plan.Projection.Band, plan.Projection.Independence, plan.Projection.ScopeExpanded))\n177\t\tif plan.Projection.ScopeExpanded || plan.Projection.RaisedIndependence != \"\" || plan.Projection.RaisedBand != \"\" {\n178\t\t\tout.Field(\"projection.expansion\", fmt.Sprintf(\"observed_components:%s added_profiles:%s added_criteria:%s added_tools:%s raised_independence:%s raised_band:%s\",\n179\t\t\t\tstrings.Join(plan.Projection.ObservedComponents, \",\"), strings.Join(plan.Projection.AddedProfiles, \",\"),\n180\t\t\t\tstrings.Join(plan.Projection.AddedCriteria, \",\"), strings.Join(plan.Projection.AddedTools, \",\"),\n181\t\t\t\tplan.Projection.RaisedIndependence, plan.Projection.RaisedBand))\n182\t\t}\n183\t\tfor _, band := range plan.Bands {\n184\t\t\tif band.Band == posemodel.ReviewBandUnknown {\n185\t\t\t\tout.Field(\"projection.undecided\", fmt.Sprintf(\"trigger:%s source:%s policy:%s\", band.Trigger, band.Source, band.Policy))\n186\t\t\t}\n187\t\t}\n188\t\t// The material facts are what a criterion answering for observed structure\n189\t\t// owes an answer for, so their ids are printed, not just counted: they are\n190\t\t// the values the reviewer passes back to `review attest --mapping`.\n191\t\tif plan.Structure != nil {\n192\t\t\tout.Field(\"structure\", fmt.Sprintf(\"observed:%t status:%s kinds:%s material:%d unknown:%d reason:%s\",\n193\t\t\t\tplan.Structure.Observed, plan.Structure.Status, strings.Join(plan.Structure.Kinds, \",\"),\n194\t\t\t\tlen(plan.Structure.Material), len(plan.Structure.Unknown), plan.Structure.Reason))\n195\t\t\tfor _, fact := range plan.Structure.Material {\n196\t\t\t\tout.Field(\"structure.\"+fact.ID, fmt.Sprintf(\"kind:%s action:%s subject:%s path:%s runtime:%s\", fact.Kind, fact.Action, fact.Subject, fact.Path, fact.Runtime))\n197\t\t\t}\n198\t\t\tfor _, unknown := range plan.Structure.Unknown {\n199\t\t\t\tout.Field(\"structure.unknown\", unknown)\n200\t\t\t}\n201\t\t}\n202\t\t// A contract change governed by its own weakened contract is the one thing a\n203\t\t// reviewer must not have to ask for.\n204\t\tif len(plan.PolicyBaseline.Paths) > 0 {\n205\t\t\tout.Field(\"policy_baseline\", fmt.Sprintf(\"protected:%t revision:%s paths:%s reason:%s\", plan.PolicyBaseline.Protected, plan.PolicyBaseline.Revision, strings.Join(plan.PolicyBaseline.Paths, \",\"), plan.PolicyBaseline.Reason))\n206\t\t\tif len(plan.PolicyBaseline.Weakened) > 0 || len(plan.PolicyBaseline.Restored) > 0 {\n207\t\t\t\tout.Field(\"policy_baseline.contract\", fmt.Sprintf(\"weakened:%s restored:%s\", strings.Join(plan.PolicyBaseline.Weakened, \",\"), strings.Join(plan.PolicyBaseline.Restored, \",\")))\n208\t\t\t}\n209\t\t}\n210\t\tfor _, warning := range groupedReviewPlanWarnings(plan.Warnings) {\n211\t\t\tfmt.Fprintf(stdout, \"[WARN] %s\\n\", warning)\n212\t\t}\n213\t\tfor _, blocker := range plan.Blockers {\n214\t\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n215\t\t}\n216\t\tif explain {\n217\t\t\tfor _, event := range plan.Explain {\n218\t\t\t\tfmt.Fprintf(stdout, \"explain=%s\\n\", event)\n219\t\t\t}\n220\t\t\tfor _, band := range plan.Bands {\n221\t\t\t\tout.Field(\"band.\"+band.Band, fmt.Sprintf(\"trigger:%s basis:%s source:%s policy:%s obligations:%s\", band.Trigger, band.Basis, band.Source, band.Policy, strings.Join(band.Obligations, \",\")))\n222\t\t\t}\n223\t\t\tfor _, component := range plan.Components {\n224\t\t\t\tout.Field(\"component.\"+component.Path, fmt.Sprintf(\"origin:%s criticality:%s metadata:%s sources:%s\", component.Origin, component.Criticality, component.MetadataStatus, strings.Join(component.Sources, \",\")))\n225\t\t\t}\n226\t\t\tfor _, profile := range plan.SelectedProfiles {\n227\t\t\t\tfmt.Fprintf(stdout, \"profile.%s=order:%d category:%s source:%s components:%s rationale:%s\\n\", profile.Ref, profile.Order, profile.Category, profile.Source, strings.Join(profile.Components, \",\"), profile.Rationale)\n228\t\t\t}\n229\t\t\tfor _, criterion := range plan.Criteria {\n230\t\t\t\tfmt.Fprintf(stdout, \"criterion.%s=required:%t structural_mapping:%t profiles:%s rules:%s evidence:%s\\n\", criterion.ID, criterion.Required, criterion.RequiresStructuralMapping, strings.Join(criterion.Profiles, \",\"), strings.Join(criterion.Rules, \",\"), strings.Join(criterion.EvidenceClasses, \",\"))\n231\t\t\t}\n232\t\t\tfor _, item := range actionableReviewPlanTools(plan.Tools) {\n233\t\t\t\ttool := item.Tool\n234\t\t\t\tfmt.Fprintf(stdout, \"tool.%s.%s=requiredness:%s args:%s preconditions:%s criteria:%s evidence:%s rationale:%s\\n\", item.Phase, tool.ID, tool.Requiredness, strings.Join(tool.Args, \" \"), strings.Join(tool.Preconditions, \",\"), strings.Join(tool.Criteria, \",\"), strings.Join(tool.EvidenceClasses, \",\"), tool.Rationale)\n235\t\t\t}\n236\t\t}\n237\t\tif len(plan.Blockers) > 0 {\n238\t\t\treturn 1\n239\t\t}\n240\t\treturn 0\n241\t}\n242\t\n243\tfunc groupedReviewPlanWarnings(warnings []string) []string {\n244\t\tgroups := map[string][]string{}\n245\t\tplain := []string{}\n246\t\tfor _, warning := range warnings {\n247\t\t\tif strings.HasPrefix(warning, \"unmapped review component \") {\n248\t\t\t\tgroups[\"unmapped-review-component\"] = append(groups[\"unmapped-review-component\"], strings.TrimPrefix(warning, \"unmapped review component \"))\n249\t\t\t} else {\n250\t\t\t\tplain = append(plain, warning)\n251\t\t\t}\n252\t\t}\n253\t\tresult := append([]string{}, plain...)\n254\t\tfor code, values := range groups {\n255\t\t\tsort.Strings(values)\n256\t\t\trepresentative := values\n257\t\t\tif len(representative) > 3 {\n258\t\t\t\trepresentative = representative[:3]\n259\t\t\t}\n260\t\t\tresult = append(result, fmt.Sprintf(\"%s count=%d examples=%s\", code, len(values), strings.Join(representative, \",\")))\n261\t\t}\n262\t\tsort.Strings(result)\n263\t\treturn result\n264\t}\n265\t\n266\ttype actionableReviewTool struct {\n267\t\tPhase string\n268\t\tTool  posemodel.ReviewPlanTool\n269\t}\n270\t\n271\tfunc actionableReviewPlanTools(tools []posemodel.ReviewPlanTool) []actionableReviewTool {\n272\t\tresult := []actionableReviewTool{}\n273\t\tseen := map[string]bool{}\n274\t\tfor _, tool := range tools {\n275\t\t\tphase := \"recommended\"\n276\t\t\tif containsCLIReviewValue(tool.Preconditions, \"review-complete\") {\n277\t\t\t\tphase = \"completion-deferred\"\n278\t\t\t} else if tool.Requiredness == \"required\" {\n279\t\t\t\tphase = \"required\"\n280\t\t\t}\n281\t\t\tkey := phase + \"\\x00\" + strings.Join(tool.Args, \"\\x00\")\n282\t\t\tif seen[key] {\n283\t\t\t\tcontinue\n284\t\t\t}\n285\t\t\tseen[key] = true\n286\t\t\tresult = append(result, actionableReviewTool{Phase: phase, Tool: tool})\n287\t\t}\n288\t\torder := map[string]int{\"required\": 0, \"recommended\": 1, \"completion-deferred\": 2}\n289\t\tsort.SliceStable(result, func(i, j int) bool {\n290\t\t\tif order[result[i].Phase] != order[result[j].Phase] {\n291\t\t\t\treturn order[result[i].Phase] < order[result[j].Phase]\n292\t\t\t}\n293\t\t\treturn result[i].Tool.ID < result[j].Tool.ID\n294\t\t})\n295\t\treturn result\n296\t}\n297\t\n298\tfunc cmdCloseoutCheck(root string, args []string, stdout, stderr io.Writer) int {\n299\t\tref, jsonOutput, ok := parseScopeCheckArgs(\"closeout-check\", args, stderr)\n300\t\tif !ok {\n301\t\t\treturn 2\n302\t\t}\n303\t\tstore, localRef, err := cliReviewStore(root, ref)\n304\t\tif err != nil {\n305\t\t\trender(io.Discard, stderr).Failure(\"pose closeout-check: \" + err.Error())\n306\t\t\treturn 1\n307\t\t}\n308\t\troot, ref = store.Root, localRef\n309\t\tstate, err := cliCloseoutStateForStore(store, ref)\n310\t\tif err != nil {\n311\t\t\tfmt.Fprintf(stderr, \"pose closeout-check: %v\\n\", err)\n312\t\t\treturn 1\n313\t\t}\n314\t\tif jsonOutput {\n315\t\t\tif code := writeJSON(stdout, state); code != 0 {\n316\t\t\t\treturn code\n317\t\t\t}\n318\t\t\tif !state.Terminal {\n319\t\t\t\treturn 1\n320\t\t\t}\n321\t\t\treturn 0\n322\t\t}\n323\t\tfmt.Fprintf(stdout, \"closeout.scope=%s\\ncloseout.digest=%s\\ncloseout.lifecycle_done=%t\\ncloseout.review_approved=%t\\ncloseout.terminal=%t\\ncloseout.next_action=%s\\n\", state.Scope, state.ScopeDigest, state.LifecycleDone, state.Review.Approved, state.Terminal, state.NextAction)\n324\t\tif state.Review.Assurance != nil {\n325\t\t\trender(stdout, stderr).Field(\"closeout.review_assurance\", posemodel.RenderReviewAssurance(*state.Review.Assurance))\n326\t\t}\n327\t\tfor _, blocker := range state.Blockers {\n328\t\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n329\t\t}\n330\t\tif !state.Terminal {\n331\t\t\treturn 1\n332\t\t}\n333\t\treturn 0\n334\t}\n335\t\n336\tfunc cliCloseoutState(root, ref string) (posemodel.CloseoutState, error) {\n337\t\treturn cliCloseoutStateIn(root, ref, posemodel.NativeFiles())\n338\t}\n339\t\n340\tfunc cliCloseoutStateIn(root, ref string, files posemodel.Files) (posemodel.CloseoutState, error) {\n341\t\tfiles = posemodel.FilesOrNative(files)\n342\t\tresolver, project, err := posemodel.EnvironmentArtifactResolverIn(files, root, \"\")\n343\t\tif err != nil {\n344\t\t\treturn posemodel.CloseoutState{}, fmt.Errorf(\"invalid project configuration\")\n345\t\t}\n346\t\tstore := posemodel.Store{Root: root, FS: files, FederatedProjectID: project, FederatedResolver: &resolver}\n347\t\treturn cliCloseoutStateForStore(store, ref)\n348\t}\n349\t\n350\t// cliCloseoutStateForStore evaluates through the selected Store binding. A\n351\t// guarded close must keep its project resolver and guarded root overlay; only\n352\t// the root-only compatibility helper above reconstructs a CLI resolver.\n353\tfunc cliCloseoutStateForStore(store posemodel.Store, ref string) (posemodel.CloseoutState, error) {\n354\t\tscope, err := posemodel.ParseScopeRef(ref)\n355\t\tif err != nil {\n356\t\t\treturn posemodel.CloseoutState{}, err\n357\t\t}\n358\t\tif scope.Kind != \"roadmap\" && scope.Kind != \"milestone\" {\n359\t\t\treturn store.GetCloseoutState(ref)\n360\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"b026c255-4a53-4326-bc83-b511587f6b40","timestamp":"2026-11-26T00:37:51.846Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3050911272/worktree/pose-mcp/internal/cli/review_closeout.go","content":"func cmdReviewCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tref, jsonOutput, ok := parseScopeCheckArgs(\"review-check\", args, stderr)\n\tif !ok {\n\t\treturn 2\n\t}\n\tstore, localRef, err := cliReviewStore(root, ref)\n\tif err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose review-check: \" + err.Error())\n\t\treturn 1\n\t}\n\troot, ref = store.Root, localRef\n\teval, err := store.ReviewCheck(ref)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif jsonOutput {\n\t\tif code := writeJSON(stdout, eval); code != 0 {\n\t\t\treturn code\n\t\t}\n\t\tif eval.Required && !eval.Approved {\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\t}\n\tfmt.Fprintf(stdout, \"review.scope=%s\\nreview.required=%t\\nreview.profile=%s\\nreview.digest=%s\\nreview.fresh=%t\\nreview.approved=%t\\n\", eval.Scope, eval.Required, eval.Profile, eval.ScopeDigest, eval.Fresh, eval.Approved)\n\tif eval.ReadView != nil {\n\t\trender(stdout, stderr).Field(\"review.read_view\", fmt.Sprintf(\"id:%s freshness:%s roots:%d inputs:%d bytes:%d\",\n\t\t\teval.ReadView.ID, eval.ReadView.Freshness, len(eval.ReadView.Bindings), eval.ReadView.ObservedInputs, eval.ReadView.InputBytes))\n\t}\n\tif eval.Assurance != nil {\n\t\trender(stdout, stderr).Field(\"review.assurance\", posemodel.RenderReviewAssurance(*eval.Assurance))\n\t}\n\tfor _, warning := range eval.Warnings {\n\t\tfmt.Fprintf(stdout, \"[WARN] %s\\n\", warning)\n\t}\n\tfor _, blocker := range eval.Blockers {\n\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n\t}\n\tif eval.Required && !eval.Approved {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc cmdReviewPlan(root string, args []string, stdout, stderr io.Writer) int {\n\tref, jsonOutput, explain := \"\", false, false\n\tfor _, arg := range args {\n\t\tswitch arg {\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tcase \"--explain\":\n\t\t\texplain = true\n\t\tdefault:\n\t\t\tif strings.HasPrefix(arg, \"-\") || ref != \"\" {\n\t\t\t\tfmt.Fprintln(stderr, \"Usage: pose review-plan <spec:slug|milestone:roadmap/id|roadmap:slug> [--json] [--explain]\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\tref = arg\n\t\t}\n\t}\n\tif ref == \"\" {\n\t\tfmt.Fprintln(stderr, \"Usage: pose review-plan <spec:slug|milestone:roadmap/id|roadmap:slug> [--json] [--explain]\")\n\t\treturn 2\n\t}\n\tstore, localRef, err := cliReviewStore(root, ref)\n\tif err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose review-plan: \" + err.Error())\n\t\treturn 1\n\t}\n\troot, ref = store.Root, localRef\n\tplan, err := store.ReviewPlan(ref)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review-plan: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif jsonOutput {\n\t\tif code := writeJSON(stdout, plan); code != 0 {\n\t\t\treturn code\n\t\t}\n\t\tif len(plan.Blockers) > 0 {\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\t}\n\tfmt.Fprintf(stdout, \"review_plan.scope=%s\\nreview_plan.scope_digest=%s\\nreview_plan.plan_digest=%s\\nreview_plan.base_profile=%s\\nreview_plan.independence=%s\\nreview_plan.band=%s\\nreview_plan.components=%d\\nreview_plan.criteria=%d\\nreview_plan.tools=%d\\n\", plan.Scope, plan.ScopeDigest, plan.PlanDigest, plan.BaseProfile, plan.Independence, plan.Band, len(plan.Components), len(plan.Criteria), len(plan.Tools))\n\t// The plan states the separation it requires; whether that separation can\n\t// be authenticated depends on the identity assurance in force, which the\n\t// plan digest deliberately does not include (spec\n\t// pose-review-assurance-disclosure).\n\tif scope, scopeErr := posemodel.ParseScopeRef(plan.Scope); scopeErr == nil {\n\t\tif policy, policyErr := (posemodel.Store{Root: root}).GetReviewPolicy(); policyErr == nil {\n\t\t\tassurance := policy.ReviewIdentityAssurance(scope.Kind)\n\t\t\tmeaning := \"the reviewer identity is the string the reviewer writes; the required separation will be declared, not authenticated\"\n\t\t\tif assurance == posemodel.ReviewIdentityAssuranceVerified {\n\t\t\t\tmeaning = \"the reviewer identity and separation must be established by a signed authority claim bound to the bundle\"\n\t\t\t}\n\t\t\trender(stdout, stderr).Field(\"review_plan.identity_assurance\", assurance+\" (\"+meaning+\")\")\n\t\t}\n\t}\n\t// The forecast and the observed expansion print without --explain: a\n\t// reviewer who never asks for the long form still has to see that the\n\t// obligations in front of them came from scope nobody declared. These lines\n\t// go through the renderer, which is also what the output ratchet requires.\n\tout := render(stdout, stderr)\n\tout.Field(\"projection.basis\", fmt.Sprintf(\"%s band=%s independence=%s scope_expanded=%t\", plan.Projection.Basis, plan.Projection.Band, plan.Projection.Independence, plan.Projection.ScopeExpanded))\n\tif plan.Projection.ScopeExpanded || plan.Projection.RaisedIndependence != \"\" || plan.Projection.RaisedBand != \"\" {\n\t\tout.Field(\"projection.expansion\", fmt.Sprintf(\"observed_components:%s added_profiles:%s added_criteria:%s added_tools:%s raised_independence:%s raised_band:%s\",\n\t\t\tstrings.Join(plan.Projection.ObservedComponents, \",\"), strings.Join(plan.Projection.AddedProfiles, \",\"),\n\t\t\tstrings.Join(plan.Projection.AddedCriteria, \",\"), strings.Join(plan.Projection.AddedTools, \",\"),\n\t\t\tplan.Projection.RaisedIndependence, plan.Projection.RaisedBand))\n\t}\n\tfor _, band := range plan.Bands {\n\t\tif band.Band == posemodel.ReviewBandUnknown {\n\t\t\tout.Field(\"projection.undecided\", fmt.Sprintf(\"trigger:%s source:%s policy:%s\", band.Trigger, band.Source, band.Policy))\n\t\t}\n\t}\n\t// The material facts are what a criterion answering for observed structure\n\t// owes an answer for, so their ids are printed, not just counted: they are\n\t// the values the reviewer passes back to `review attest --mapping`.\n\tif plan.Structure != nil {\n\t\tout.Field(\"structure\", fmt.Sprintf(\"observed:%t status:%s kinds:%s material:%d unknown:%d reason:%s\",\n\t\t\tplan.Structure.Observed, plan.Structure.Status, strings.Join(plan.Structure.Kinds, \",\"),\n\t\t\tlen(plan.Structure.Material), len(plan.Structure.Unknown), plan.Structure.Reason))\n\t\tfor _, fact := range plan.Structure.Material {\n\t\t\tout.Field(\"structure.\"+fact.ID, fmt.Sprintf(\"kind:%s action:%s subject:%s path:%s runtime:%s\", fact.Kind, fact.Action, fact.Subject, fact.Path, fact.Runtime))\n\t\t}\n\t\tfor _, unknown := range plan.Structure.Unknown {\n\t\t\tout.Field(\"structure.unknown\", unknown)\n\t\t}\n\t}\n\t// A contract change governed by its own weakened contract is the one thing a\n\t// reviewer must not have to ask for.\n\tif len(plan.PolicyBaseline.Paths) > 0 {\n\t\tout.Field(\"policy_baseline\", fmt.Sprintf(\"protected:%t revision:%s paths:%s reason:%s\", plan.PolicyBaseline.Protected, plan.PolicyBaseline.Revision, strings.Join(plan.PolicyBaseline.Paths, \",\"), plan.PolicyBaseline.Reason))\n\t\tif len(plan.PolicyBaseline.Weakened) > 0 || len(plan.PolicyBaseline.Restored) > 0 {\n\t\t\tout.Field(\"policy_baseline.contract\", fmt.Sprintf(\"weakened:%s restored:%s\", strings.Join(plan.PolicyBaseline.Weakened, \",\"), strings.Join(plan.PolicyBaseline.Restored, \",\")))\n\t\t}\n\t}\n\tfor _, warning := range groupedReviewPlanWarnings(plan.Warnings) {\n\t\tfmt.Fprintf(stdout, \"[WARN] %s\\n\", warning)\n\t}\n\tfor _, blocker := range plan.Blockers {\n\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n\t}\n\tif explain {\n\t\tfor _, event := range plan.Explain {\n\t\t\tfmt.Fprintf(stdout, \"explain=%s\\n\", event)\n\t\t}\n\t\tfor _, band := range plan.Bands {\n\t\t\tout.Field(\"band.\"+band.Band, fmt.Sprintf(\"trigger:%s basis:%s source:%s policy:%s obligations:%s\", band.Trigger, band.Basis, band.Source, band.Policy, strings.Join(band.Obligations, \",\")))\n\t\t}\n\t\tfor _, component := range plan.Components {\n\t\t\tout.Field(\"component.\"+component.Path, fmt.Sprintf(\"origin:%s criticality:%s metadata:%s sources:%s\", component.Origin, component.Criticality, component.MetadataStatus, strings.Join(component.Sources, \",\")))\n\t\t}\n\t\tfor _, profile := range plan.SelectedProfiles {\n\t\t\tfmt.Fprintf(stdout, \"profile.%s=order:%d category:%s source:%s components:%s rationale:%s\\n\", profile.Ref, profile.Order, profile.Category, profile.Source, strings.Join(profile.Components, \",\"), profile.Rationale)\n\t\t}\n\t\tfor _, criterion := range plan.Criteria {\n\t\t\tfmt.Fprintf(stdout, \"criterion.%s=required:%t structural_mapping:%t profiles:%s rules:%s evidence:%s\\n\", criterion.ID, criterion.Required, criterion.RequiresStructuralMapping, strings.Join(criterion.Profiles, \",\"), strings.Join(criterion.Rules, \",\"), strings.Join(criterion.EvidenceClasses, \",\"))\n\t\t}\n\t\tfor _, item := range actionableReviewPlanTools(plan.Tools) {\n\t\t\ttool := item.Tool\n\t\t\tfmt.Fprintf(stdout, \"tool.%s.%s=requiredness:%s args:%s preconditions:%s criteria:%s evidence:%s rationale:%s\\n\", item.Phase, tool.ID, tool.Requiredness, strings.Join(tool.Args, \" \"), strings.Join(tool.Preconditions, \",\"), strings.Join(tool.Criteria, \",\"), strings.Join(tool.EvidenceClasses, \",\"), tool.Rationale)\n\t\t}\n\t}\n\tif len(plan.Blockers) > 0 {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc groupedReviewPlanWarnings(warnings []string) []string {\n\tgroups := map[string][]string{}\n\tplain := []string{}\n\tfor _, warning := range warnings {\n\t\tif strings.HasPrefix(warning, \"unmapped review component \") {\n\t\t\tgroups[\"unmapped-review-component\"] = append(groups[\"unmapped-review-component\"], strings.TrimPrefix(warning, \"unmapped review component \"))\n\t\t} else {\n\t\t\tplain = append(plain, warning)\n\t\t}\n\t}\n\tresult := append([]string{}, plain...)\n\tfor code, values := range groups {\n\t\tsort.Strings(values)\n\t\trepresentative := values\n\t\tif len(representative) > 3 {\n\t\t\trepresentative = representative[:3]\n\t\t}\n\t\tresult = append(result, fmt.Sprintf(\"%s count=%d examples=%s\", code, len(values), strings.Join(representative, \",\")))\n\t}\n\tsort.Strings(result)\n\treturn result\n}\n\ntype actionableReviewTool struct {\n\tPhase string\n\tTool  posemodel.ReviewPlanTool\n}\n\nfunc actionableReviewPlanTools(tools []posemodel.ReviewPlanTool) []actionableReviewTool {\n\tresult := []actionableReviewTool{}\n\tseen := map[string]bool{}\n\tfor _, tool := range tools {\n\t\tphase := \"recommended\"\n\t\tif containsCLIReviewValue(tool.Preconditions, \"review-complete\") {\n\t\t\tphase = \"completion-deferred\"\n\t\t} else if tool.Requiredness == \"required\" {\n\t\t\tphase = \"required\"\n\t\t}\n\t\tkey := phase + \"\\x00\" + strings.Join(tool.Args, \"\\x00\")\n\t\tif seen[key] {\n\t\t\tcontinue\n\t\t}\n\t\tseen[key] = true\n\t\tresult = append(result, actionableReviewTool{Phase: phase, Tool: tool})\n\t}\n\torder := map[string]int{\"required\": 0, \"recommended\": 1, \"completion-deferred\": 2}\n\tsort.SliceStable(result, func(i, j int) bool {\n\t\tif order[result[i].Phase] != order[result[j].Phase] {\n\t\t\treturn order[result[i].Phase] < order[result[j].Phase]\n\t\t}\n\t\treturn result[i].Tool.ID < result[j].Tool.ID\n\t})\n\treturn result\n}\n\nfunc cmdCloseoutCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tref, jsonOutput, ok := parseScopeCheckArgs(\"closeout-check\", args, stderr)\n\tif !ok {\n\t\treturn 2\n\t}\n\tstore, localRef, err := cliReviewStore(root, ref)\n\tif err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose closeout-check: \" + err.Error())\n\t\treturn 1\n\t}\n\troot, ref = store.Root, localRef\n\tstate, err := cliCloseoutStateForStore(store, ref)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose closeout-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif jsonOutput {\n\t\tif code := writeJSON(stdout, state); code != 0 {\n\t\t\treturn code\n\t\t}\n\t\tif !state.Terminal {\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\t}\n\tfmt.Fprintf(stdout, \"closeout.scope=%s\\ncloseout.digest=%s\\ncloseout.lifecycle_done=%t\\ncloseout.review_approved=%t\\ncloseout.terminal=%t\\ncloseout.next_action=%s\\n\", state.Scope, state.ScopeDigest, state.LifecycleDone, state.Review.Approved, state.Terminal, state.NextAction)\n\tif state.Review.Assurance != nil {\n\t\trender(stdout, stderr).Field(\"closeout.review_assurance\", posemodel.RenderReviewAssurance(*state.Review.Assurance))\n\t}\n\tfor _, blocker := range state.Blockers {\n\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n\t}\n\tif !state.Terminal {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc cliCloseoutState(root, ref string) (posemodel.CloseoutState, error) {\n\treturn cliCloseoutStateIn(root, ref, posemodel.NativeFiles())\n}\n\nfunc cliCloseoutStateIn(root, ref string, files posemodel.Files) (posemodel.CloseoutState, error) {\n\tfiles = posemodel.FilesOrNative(files)\n\tresolver, project, err := posemodel.EnvironmentArtifactResolverIn(files, root, \"\")\n\tif err != nil {\n\t\treturn posemodel.CloseoutState{}, fmt.Errorf(\"invalid project configuration\")\n\t}\n\tstore := posemodel.Store{Root: root, FS: files, FederatedProjectID: project, FederatedResolver: &resolver}\n\treturn cliCloseoutStateForStore(store, ref)\n}\n\n// cliCloseoutStateForStore evaluates through the selected Store binding. A\n// guarded close must keep its project resolver and guarded root overlay; only\n// the root-only compatibility helper above reconstructs a CLI resolver.\nfunc cliCloseoutStateForStore(store posemodel.Store, ref string) (posemodel.CloseoutState, error) {\n\tscope, err := posemodel.ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn posemodel.CloseoutState{}, err\n\t}\n\tif scope.Kind != \"roadmap\" && scope.Kind != \"milestone\" {\n\t\treturn store.GetCloseoutState(ref)\n\t}","numLines":290,"startLine":71,"totalLines":2599}},"tool_result_meta":[{"id":"toolu_01S4gqp57qXyMYLLVSjJCxKT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
