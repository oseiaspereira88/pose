{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DCDn7JwmAok5mt9mKDTzsX","type":"tool_result","content":"diff --git a/pose-mcp/internal/cli/accepted_limits_lint_test.go b/pose-mcp/internal/cli/accepted_limits_lint_test.go\nnew file mode 100644\nindex 00000000..cacb146e\n--- /dev/null\n+++ b/pose-mcp/internal/cli/accepted_limits_lint_test.go\n@@ -0,0 +1,82 @@\n+package cli\n+\n+import (\n+\t\"bytes\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+// Spec pose-review-declared-threat-model R4: the ready check refuses an\n+// accepted limit without its reason, and one an ADR citing the spec omits.\n+func TestReadyCheckJudgesAcceptedLimits(t *testing.T) {\n+\troot := t.TempDir()\n+\twrite := func(rel, body string) {\n+\t\tp := filepath.Join(root, rel)\n+\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tspec := func(limits string) string {\n+\t\treturn \"---\\nslug: limited\\nstatus: draft\\ncreated_at: 2026-11-25\\n---\\n\\n# Spec: limited\\n\\n## 1. Intent\\n\\n### Goal\\nA goal worth stating.\\n\\n## 2. Requirements\\n\\n### Functional\\n- R1: It works.\\n\\n## 3. Technical Plan\\n\\n### Affected areas\\nThe engine.\\n\" + limits + \"\\n## 4. Tasks\\n- [ ] Do it.\\n\"\n+\t}\n+\tpath := filepath.Join(root, \".pose/specs/limited/spec.md\")\n+\trun := func() (int, string) {\n+\t\tvar out, errOut bytes.Buffer\n+\t\tcode := lintOneSpec(path, false, true, &out, &errOut)\n+\t\treturn code, out.String() + errOut.String()\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n\"))\n+\tif code, out := run(); code != 0 {\n+\t\tt.Fatalf(\"a justified limit failed the ready check: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape with no reason.\\n\"))\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"does not say why it is accepted\") {\n+\t\tt.Fatalf(\"an unjustified limit passed: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n- L2: another. Accepted because it is rarer.\\n\"))\n+\t// Review round 1, N3: L10 does not name L1.\n+\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited`. L10 and L2 are accepted.\\n\")\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"accepted limit L1 is not named by the ADR\") {\n+\t\tt.Fatalf(\"L10 was taken as naming L1: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited`. L1 is accepted.\\n\")\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"accepted limit L2 is not named by the ADR\") {\n+\t\tt.Fatalf(\"a limit the ADR omits passed: %d %s\", code, out)\n+\t}\n+\t// Review round 5, N2: an ADR that cannot be read fails the check closed.\n+\tif os.Geteuid() != 0 {\n+\t\tadr := filepath.Join(root, \".pose/adr/2026-11-25-limited.md\")\n+\t\tif err := os.Chmod(adr, 0o000); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tdefer os.Chmod(adr, 0o644)\n+\t\tif code, out := run(); code == 0 || !strings.Contains(out, \"cannot be read to check the accepted limits\") {\n+\t\t\tt.Fatalf(\"an unreadable ADR was read as absent: %d %s\", code, out)\n+\t\t}\n+\t}\n+\t// Review round 7, N2: an ADR that is a link is not followed.\n+\tadr := filepath.Join(root, \".pose/adr/2026-11-25-limited.md\")\n+\t_ = os.Chmod(adr, 0o644)\n+\t_ = os.Remove(adr)\n+\tif err := os.Symlink(\"/dev/zero\", adr); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tdone := make(chan struct{})\n+\tvar code int\n+\tvar out string\n+\tgo func() { code, out = run(); close(done) }()\n+\tselect {\n+\tcase <-done:\n+\tcase <-time.After(10 * time.Second):\n+\t\tt.Fatal(\"the ready check followed an ADR link to an endless source\")\n+\t}\n+\tif code == 0 || !strings.Contains(out, \"cannot be read to check the accepted limits\") {\n+\t\tt.Fatalf(\"an ADR link was read: %d %s\", code, out)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/accepted_limits_test.go b/pose-mcp/internal/pose/accepted_limits_test.go\nnew file mode 100644\nindex 00000000..f0219e94\n--- /dev/null\n+++ b/pose-mcp/internal/pose/accepted_limits_test.go\n@@ -0,0 +1,151 @@\n+package pose\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+const limitsSection = `\n+### Accepted limits\n+- L1: A process that clears its environment escapes. Accepted because the shim covers it.\n+- L2: Windows is untested here. Accepted because the host is Linux.\n+`\n+\n+// Spec pose-review-declared-threat-model R1: the section is read as\n+// written, and what does not say why it is accepted is reported.\n+func TestAcceptedLimitsAreParsed(t *testing.T) {\n+\tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n+\tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n+\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n+\t}\n+\t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n- L3: a marker with nothing after it. Accepted because\\n\")\n+\tjoined := strings.Join(problems, \"\\n\")\n+\tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\", \"L3 does not say why it is accepted\"} {\n+\t\tif !strings.Contains(joined, want) {\n+\t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n+\t\t}\n+\t}\n+}\n+\n+// R1: the review plan seals the limits the spec declares, and they enter the\n+// plan digest; a spec without limits keeps its digest.\n+func TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n+\troot, store := reviewBundleFixture(t)\n+\tbefore, err := store.ReviewPlan(\"spec:backend\")\n+\tif err != nil || len(before.AcceptedLimits) != 0 {\n+\t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n+\t}\n+\tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n+\traw, _ := os.ReadFile(path)\n+\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tafter, err := store.ReviewPlan(\"spec:backend\")\n+\tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n+\t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n+\t}\n+\twithout := after\n+\twithout.AcceptedLimits = nil\n+\tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n+\t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n+\t}\n+}\n+\n+// R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n+// recorded within-limit, naming it, and does not block an approval whatever\n+// its severity; a limit the bundle did not seal accepts nothing.\n+func TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n+\tvar bundle ReviewBundle\n+\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n+\tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n+\t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n+\t}}\n+\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n+\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n+\t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n+\t}\n+\tatt.Decision = \"approved\"\n+\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n+\t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n+\t}\n+\tatt.Findings[0].Limit = \"L9\"\n+\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n+\t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n+\t}\n+\tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"  \\t \"\n+\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n+\t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n+\t}\n+}\n+\n+// Review round 1, N1: across the specs of a composite scope each limit is\n+// qualified by its spec, so a finding names exactly one.\n+func TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n+\tbody := \"### Accepted limits\\n- L1: one. Accepted because it is rare.\\n\"\n+\tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n+\tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n+\t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n+\t}\n+\tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n+\tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n+\t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n+\t}\n+}\n+\n+// Review round 2, N1: punctuation is not a reason, and a reason may start\n+// with a one-letter word.\n+func TestAnAcceptedLimitNeedsWordsAsItsReason(t *testing.T) {\n+\tfor text, want := range map[string]bool{\n+\t\t\"x. Accepted because ..\":                                          false,\n+\t\t\"x. Accepted because -- !\":                                        false,\n+\t\t\"x. Accepted because rare\":                                        false,\n+\t\t\"An escape. Accepted because a shim covers it.\":                   true,\n+\t\t\"Uma fuga. Aceito porque o shim cobre o caso.\":                    true,\n+\t\t\"Not accepted because this would violate scope.\":                  false,\n+\t\t\"Accepted because it is rare.\":                                    false,\n+\t\t\"An escape. Accepted because. Then unrelated prose follows here.\": false,\n+\t\t\"An escape. Accepted because a shim covers it. More context.\":     true,\n+\t\t\"An escape. Accepted because ; later prose has words.\":            false,\n+\t\t\"X. Accepted because a shim covers it.\":                           false,\n+\t\t\"x, accepted because it is rare.\":                                 false,\n+\t} {\n+\t\tif got := hasAcceptedLimitReason(text); got != want {\n+\t\t\tt.Errorf(\"%q: reason=%t, want %t\", text, got, want)\n+\t\t}\n+\t}\n+}\n+\n+// Review round 6, N1: the bundle's plan digest covers the sealed limits, and\n+// a plan without limits keeps the digest it had before them.\n+func TestTheBundlePlanDigestCoversTheAcceptedLimits(t *testing.T) {\n+\tvar plan ReviewPlan\n+\tplan.SchemaVersion, plan.Independence = 1, \"different-actor\"\n+\tempty, err := reviewBundlePlanDigest(plan)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tlegacy, _ := digestJSON(struct {\n+\t\tSchemaVersion             int                   `json:\"schema_version\"`\n+\t\tPolicySchemaVersion       int                   `json:\"policy_schema_version\"`\n+\t\tBaseProfile               string                `json:\"base_profile\"`\n+\t\tIndependence              string                `json:\"independence\"`\n+\t\tComponents                []ReviewPlanComponent `json:\"components\"`\n+\t\tSelectedProfiles          []ReviewPlanProfile   `json:\"selected_profiles\"`\n+\t\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n+\t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n+\t\tLimitations               []string              `json:\"limitations,omitempty\"`\n+\t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n+\t}{1, 0, \"\", \"different-actor\", []ReviewPlanComponent{}, []ReviewPlanProfile{}, []ReviewPlanCriterion{}, []ReviewPlanTool{}, nil, false})\n+\tif empty != legacy {\n+\t\tt.Fatal(\"a plan without limits changed its bundle plan digest\")\n+\t}\n+\tplan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"An escape. Accepted because a shim covers it.\"}}\n+\tone, _ := reviewBundlePlanDigest(plan)\n+\tplan.AcceptedLimits[0].Text = \"An escape. Accepted because nothing else covers it.\"\n+\tother, _ := reviewBundlePlanDigest(plan)\n+\tif one == empty || one == other {\n+\t\tt.Fatalf(\"the bundle plan digest does not cover the accepted limits: %s %s %s\", empty, one, other)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go b/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\nindex 364b8181..0041304e 100644\n--- a/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\n+++ b/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\n@@ -58,7 +58,7 @@ func TestAnEarlierConclusionBriefStillRendersWithoutTheRules(t *testing.T) {\n \tif err != nil {\n \t\tt.Fatal(err)\n \t}\n-\tif current.TemplateVersion != \"review-brief/7\" || earlier.TemplateVersion != \"review-brief/3\" {\n+\tif current.TemplateVersion != \"review-brief/11\" || earlier.TemplateVersion != \"review-brief/3\" {\n \t\tt.Fatalf(\"templates: %s %s\", current.TemplateVersion, earlier.TemplateVersion)\n \t}\n \tif strings.Contains(earlier.Text, \"POSE checks the conclusion before it records it\") {\n@@ -67,8 +67,8 @@ func TestAnEarlierConclusionBriefStillRendersWithoutTheRules(t *testing.T) {\n \tif !strings.Contains(earlier.Text, \"the conclusion POSE records as the attestation\") || earlier.Digest == current.Digest {\n \t\tt.Fatal(\"review-brief/3 no longer asks for the conclusion, or has the digest of /4\")\n \t}\n-\tif !reviewBriefAsksConclusion(\"review-brief/3\") || !reviewBriefAsksConclusion(\"review-brief/4\") || !reviewBriefAsksConclusion(\"review-brief/5\") || !reviewBriefAsksConclusion(\"review-brief/6\") || !reviewBriefAsksConclusion(\"review-brief/7\") || reviewBriefAsksConclusion(\"review-brief/2\") {\n-\t\tt.Fatal(\"the templates that ask for a conclusion are /3 to /7\")\n+\tif !reviewBriefAsksConclusion(\"review-brief/3\") || !reviewBriefAsksConclusion(\"review-brief/4\") || !reviewBriefAsksConclusion(\"review-brief/5\") || !reviewBriefAsksConclusion(\"review-brief/6\") || !reviewBriefAsksConclusion(\"review-brief/7\") || !reviewBriefAsksConclusion(\"review-brief/8\") || !reviewBriefAsksConclusion(\"review-brief/9\") || !reviewBriefAsksConclusion(\"review-brief/10\") || !reviewBriefAsksConclusion(\"review-brief/11\") || reviewBriefAsksConclusion(\"review-brief/2\") {\n+\t\tt.Fatal(\"the templates that ask for a conclusion are /3 to /11\")\n \t}\n }\n \n@@ -138,3 +138,59 @@ func TestTheBriefOfALaterRoundStatesTheIdentifiersOfPriorFindings(t *testing.T)\n \t\tt.Error(\"review-brief/4 changed under its version: the rule belongs to review-brief/5 and later\")\n \t}\n }\n+\n+// Spec pose-review-readiness-before-seal R4: the current brief asks the\n+// reviewer to check its draft before finishing; /7 never did.\n+func TestTheCurrentBriefAsksForTheDraftCheck(t *testing.T) {\n+\tconst step = \"pipe it to `\\\"$POSE_REVIEW_CLI\\\" review draft-check --draft -`\"\n+\tcurrent := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, step) {\n+\t\tt.Fatal(\"the current review brief does not ask for the draft check\")\n+\t}\n+\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateAllNotApplicable, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, step) {\n+\t\tt.Fatal(\"review-brief/7 changed under the runs briefed with it\")\n+\t}\n+}\n+\n+// Spec pose-assess-leaves-sealed-checkouts-alone R5: the current brief has\n+// the planned `pose` commands run by the dispatching engine; /8 never did.\n+func TestTheCurrentBriefRunsPlannedToolsWithTheDispatchingEngine(t *testing.T) {\n+\tconst step = \"Run each `pose` command below as `\\\"$POSE_REVIEW_CLI\\\"`\"\n+\tcurrent := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, step) || !strings.Contains(current, \"pipe it to `\\\"$POSE_REVIEW_CLI\\\" review draft-check --draft -`\") {\n+\t\tt.Fatal(\"the current review brief does not run planned tools and the draft check with the dispatching engine\")\n+\t}\n+\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateDraftCheck, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, step) {\n+\t\tt.Fatal(\"review-brief/8 changed under the runs briefed with it\")\n+\t}\n+}\n+\n+// Spec pose-review-run-reaps-lingering-reviewer-processes R3: the current\n+// brief asks the reviewer to let its commands finish; /9 never did.\n+func TestTheCurrentBriefAsksCommandsToFinish(t *testing.T) {\n+\tconst boundary = \"Let every command you start finish before you end\"\n+\tcurrent := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, boundary) || !strings.Contains(current, \"Run each `pose` command below as\") {\n+\t\tt.Fatal(\"the current review brief does not keep /9 and ask commands to finish\")\n+\t}\n+\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateEngineTools, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, boundary) {\n+\t\tt.Fatal(\"review-brief/9 changed under the runs briefed with it\")\n+\t}\n+}\n+\n+// Spec pose-review-declared-threat-model R2: the current brief lists the\n+// sealed accepted limits and says how a finding inside one is classified;\n+// /10 never did.\n+func TestTheCurrentBriefListsTheAcceptedLimits(t *testing.T) {\n+\tcurrent := renderReviewBriefBody(richBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, \"## Accepted limits\") || !strings.Contains(current, \"- L1: A process that clears its environment escapes.\") || !strings.Contains(current, \"with `limit` set to its id\") {\n+\t\tt.Fatalf(\"the current brief does not list the accepted limits:\\n%s\", current)\n+\t}\n+\tearlier := renderReviewBriefBody(richBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateFinishCommands, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, \"## Accepted limits\") {\n+\t\tt.Fatal(\"review-brief/10 changed under the runs briefed with it\")\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_brief_versions_test.go b/pose-mcp/internal/pose/review_brief_versions_test.go\nindex 303d62cc..88b16a10 100644\n--- a/pose-mcp/internal/pose/review_brief_versions_test.go\n+++ b/pose-mcp/internal/pose/review_brief_versions_test.go\n@@ -54,6 +54,7 @@ func richBriefBundle() ReviewBundle {\n \tbundle.Payload.Plan.Tools = append(bundle.Payload.Plan.Tools, ReviewPlanTool{ID: \"assess-discover\", Component: \"core\", Requiredness: \"recommended\", Args: []string{\"pose\", \"assess\", \"discover\"}})\n \tbundle.Payload.Subject.Entries = append(bundle.Payload.Subject.Entries, ReviewBundleSubjectEntry{Action: \"renamed\", OldPath: \"core/old.go\", NewPath: \"core/new.go\", Class: \"source\", Reason: \"moved\"})\n \tbundle.Payload.Plan.Criteria = append(bundle.Payload.Plan.Criteria, ReviewPlanCriterion{ID: \"documentation\", Description: \"The docs say it.\", Required: false, Kind: ReviewCriterionKindMechanical})\n+\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"A process that clears its environment escapes. Accepted because the shim covers it.\"}}\n \treturn bundle\n }","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"826f0b92-aec4-45bd-9bcb-6fc922b1409c","timestamp":"2026-11-26T00:20:38.673Z","tool_use_result":{"stdout":"diff --git a/pose-mcp/internal/cli/accepted_limits_lint_test.go b/pose-mcp/internal/cli/accepted_limits_lint_test.go\nnew file mode 100644\nindex 00000000..cacb146e\n--- /dev/null\n+++ b/pose-mcp/internal/cli/accepted_limits_lint_test.go\n@@ -0,0 +1,82 @@\n+package cli\n+\n+import (\n+\t\"bytes\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+// Spec pose-review-declared-threat-model R4: the ready check refuses an\n+// accepted limit without its reason, and one an ADR citing the spec omits.\n+func TestReadyCheckJudgesAcceptedLimits(t *testing.T) {\n+\troot := t.TempDir()\n+\twrite := func(rel, body string) {\n+\t\tp := filepath.Join(root, rel)\n+\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tspec := func(limits string) string {\n+\t\treturn \"---\\nslug: limited\\nstatus: draft\\ncreated_at: 2026-11-25\\n---\\n\\n# Spec: limited\\n\\n## 1. Intent\\n\\n### Goal\\nA goal worth stating.\\n\\n## 2. Requirements\\n\\n### Functional\\n- R1: It works.\\n\\n## 3. Technical Plan\\n\\n### Affected areas\\nThe engine.\\n\" + limits + \"\\n## 4. Tasks\\n- [ ] Do it.\\n\"\n+\t}\n+\tpath := filepath.Join(root, \".pose/specs/limited/spec.md\")\n+\trun := func() (int, string) {\n+\t\tvar out, errOut bytes.Buffer\n+\t\tcode := lintOneSpec(path, false, true, &out, &errOut)\n+\t\treturn code, out.String() + errOut.String()\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n\"))\n+\tif code, out := run(); code != 0 {\n+\t\tt.Fatalf(\"a justified limit failed the ready check: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape with no reason.\\n\"))\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"does not say why it is accepted\") {\n+\t\tt.Fatalf(\"an unjustified limit passed: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n- L2: another. Accepted because it is rarer.\\n\"))\n+\t// Review round 1, N3: L10 does not name L1.\n+\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited`. L10 and L2 are accepted.\\n\")\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"accepted limit L1 is not named by the ADR\") {\n+\t\tt.Fatalf(\"L10 was taken as naming L1: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited`. L1 is accepted.\\n\")\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"accepted limit L2 is not named by the ADR\") {\n+\t\tt.Fatalf(\"a limit the ADR omits passed: %d %s\", code, out)\n+\t}\n+\t// Review round 5, N2: an ADR that cannot be read fails the check closed.\n+\tif os.Geteuid() != 0 {\n+\t\tadr := filepath.Join(root, \".pose/adr/2026-11-25-limited.md\")\n+\t\tif err := os.Chmod(adr, 0o000); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tdefer os.Chmod(adr, 0o644)\n+\t\tif code, out := run(); code == 0 || !strings.Contains(out, \"cannot be read to check the accepted limits\") {\n+\t\t\tt.Fatalf(\"an unreadable ADR was read as absent: %d %s\", code, out)\n+\t\t}\n+\t}\n+\t// Review round 7, N2: an ADR that is a link is not followed.\n+\tadr := filepath.Join(root, \".pose/adr/2026-11-25-limited.md\")\n+\t_ = os.Chmod(adr, 0o644)\n+\t_ = os.Remove(adr)\n+\tif err := os.Symlink(\"/dev/zero\", adr); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tdone := make(chan struct{})\n+\tvar code int\n+\tvar out string\n+\tgo func() { code, out = run(); close(done) }()\n+\tselect {\n+\tcase <-done:\n+\tcase <-time.After(10 * time.Second):\n+\t\tt.Fatal(\"the ready check followed an ADR link to an endless source\")\n+\t}\n+\tif code == 0 || !strings.Contains(out, \"cannot be read to check the accepted limits\") {\n+\t\tt.Fatalf(\"an ADR link was read: %d %s\", code, out)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/accepted_limits_test.go b/pose-mcp/internal/pose/accepted_limits_test.go\nnew file mode 100644\nindex 00000000..f0219e94\n--- /dev/null\n+++ b/pose-mcp/internal/pose/accepted_limits_test.go\n@@ -0,0 +1,151 @@\n+package pose\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+const limitsSection = `\n+### Accepted limits\n+- L1: A process that clears its environment escapes. Accepted because the shim covers it.\n+- L2: Windows is untested here. Accepted because the host is Linux.\n+`\n+\n+// Spec pose-review-declared-threat-model R1: the section is read as\n+// written, and what does not say why it is accepted is reported.\n+func TestAcceptedLimitsAreParsed(t *testing.T) {\n+\tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n+\tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n+\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n+\t}\n+\t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n- L3: a marker with nothing after it. Accepted because\\n\")\n+\tjoined := strings.Join(problems, \"\\n\")\n+\tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\", \"L3 does not say why it is accepted\"} {\n+\t\tif !strings.Contains(joined, want) {\n+\t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n+\t\t}\n+\t}\n+}\n+\n+// R1: the review plan seals the limits the spec declares, and they enter the\n+// plan digest; a spec without limits keeps its digest.\n+func TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n+\troot, store := reviewBundleFixture(t)\n+\tbefore, err := store.ReviewPlan(\"spec:backend\")\n+\tif err != nil || len(before.AcceptedLimits) != 0 {\n+\t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n+\t}\n+\tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n+\traw, _ := os.ReadFile(path)\n+\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tafter, err := store.ReviewPlan(\"spec:backend\")\n+\tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n+\t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n+\t}\n+\twithout := after\n+\twithout.AcceptedLimits = nil\n+\tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n+\t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n+\t}\n+}\n+\n+// R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n+// recorded within-limit, naming it, and does not block an approval whatever\n+// its severity; a limit the bundle did not seal accepts nothing.\n+func TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n+\tvar bundle ReviewBundle\n+\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n+\tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n+\t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n+\t}}\n+\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n+\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n+\t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n+\t}\n+\tatt.Decision = \"approved\"\n+\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n+\t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n+\t}\n+\tatt.Findings[0].Limit = \"L9\"\n+\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n+\t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n+\t}\n+\tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"  \\t \"\n+\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n+\t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n+\t}\n+}\n+\n+// Review round 1, N1: across the specs of a composite scope each limit is\n+// qualified by its spec, so a finding names exactly one.\n+func TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n+\tbody := \"### Accepted limits\\n- L1: one. Accepted because it is rare.\\n\"\n+\tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n+\tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n+\t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n+\t}\n+\tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n+\tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n+\t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n+\t}\n+}\n+\n+// Review round 2, N1: punctuation is not a reason, and a reason may start\n+// with a one-letter word.\n+func TestAnAcceptedLimitNeedsWordsAsItsReason(t *testing.T) {\n+\tfor text, want := range map[string]bool{\n+\t\t\"x. Accepted because ..\":                                          false,\n+\t\t\"x. Accepted because -- !\":                                        false,\n+\t\t\"x. Accepted because rare\":                                        false,\n+\t\t\"An escape. Accepted because a shim covers it.\":                   true,\n+\t\t\"Uma fuga. Aceito porque o shim cobre o caso.\":                    true,\n+\t\t\"Not accepted because this would violate scope.\":                  false,\n+\t\t\"Accepted because it is rare.\":                                    false,\n+\t\t\"An escape. Accepted because. Then unrelated prose follows here.\": false,\n+\t\t\"An escape. Accepted because a shim covers it. More context.\":     true,\n+\t\t\"An escape. Accepted because ; later prose has words.\":            false,\n+\t\t\"X. Accepted because a shim covers it.\":                           false,\n+\t\t\"x, accepted because it is rare.\":                                 false,\n+\t} {\n+\t\tif got := hasAcceptedLimitReason(text); got != want {\n+\t\t\tt.Errorf(\"%q: reason=%t, want %t\", text, got, want)\n+\t\t}\n+\t}\n+}\n+\n+// Review round 6, N1: the bundle's plan digest covers the sealed limits, and\n+// a plan without limits keeps the digest it had before them.\n+func TestTheBundlePlanDigestCoversTheAcceptedLimits(t *testing.T) {\n+\tvar plan ReviewPlan\n+\tplan.SchemaVersion, plan.Independence = 1, \"different-actor\"\n+\tempty, err := reviewBundlePlanDigest(plan)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tlegacy, _ := digestJSON(struct {\n+\t\tSchemaVersion             int                   `json:\"schema_version\"`\n+\t\tPolicySchemaVersion       int                   `json:\"policy_schema_version\"`\n+\t\tBaseProfile               string                `json:\"base_profile\"`\n+\t\tIndependence              string                `json:\"independence\"`\n+\t\tComponents                []ReviewPlanComponent `json:\"components\"`\n+\t\tSelectedProfiles          []ReviewPlanProfile   `json:\"selected_profiles\"`\n+\t\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n+\t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n+\t\tLimitations               []string              `json:\"limitations,omitempty\"`\n+\t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n+\t}{1, 0, \"\", \"different-actor\", []ReviewPlanComponent{}, []ReviewPlanProfile{}, []ReviewPlanCriterion{}, []ReviewPlanTool{}, nil, false})\n+\tif empty != legacy {\n+\t\tt.Fatal(\"a plan without limits changed its bundle plan digest\")\n+\t}\n+\tplan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"An escape. Accepted because a shim covers it.\"}}\n+\tone, _ := reviewBundlePlanDigest(plan)\n+\tplan.AcceptedLimits[0].Text = \"An escape. Accepted because nothing else covers it.\"\n+\tother, _ := reviewBundlePlanDigest(plan)\n+\tif one == empty || one == other {\n+\t\tt.Fatalf(\"the bundle plan digest does not cover the accepted limits: %s %s %s\", empty, one, other)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go b/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\nindex 364b8181..0041304e 100644\n--- a/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\n+++ b/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\n@@ -58,7 +58,7 @@ func TestAnEarlierConclusionBriefStillRendersWithoutTheRules(t *testing.T) {\n \tif err != nil {\n \t\tt.Fatal(err)\n \t}\n-\tif current.TemplateVersion != \"review-brief/7\" || earlier.TemplateVersion != \"review-brief/3\" {\n+\tif current.TemplateVersion != \"review-brief/11\" || earlier.TemplateVersion != \"review-brief/3\" {\n \t\tt.Fatalf(\"templates: %s %s\", current.TemplateVersion, earlier.TemplateVersion)\n \t}\n \tif strings.Contains(earlier.Text, \"POSE checks the conclusion before it records it\") {\n@@ -67,8 +67,8 @@ func TestAnEarlierConclusionBriefStillRendersWithoutTheRules(t *testing.T) {\n \tif !strings.Contains(earlier.Text, \"the conclusion POSE records as the attestation\") || earlier.Digest == current.Digest {\n \t\tt.Fatal(\"review-brief/3 no longer asks for the conclusion, or has the digest of /4\")\n \t}\n-\tif !reviewBriefAsksConclusion(\"review-brief/3\") || !reviewBriefAsksConclusion(\"review-brief/4\") || !reviewBriefAsksConclusion(\"review-brief/5\") || !reviewBriefAsksConclusion(\"review-brief/6\") || !reviewBriefAsksConclusion(\"review-brief/7\") || reviewBriefAsksConclusion(\"review-brief/2\") {\n-\t\tt.Fatal(\"the templates that ask for a conclusion are /3 to /7\")\n+\tif !reviewBriefAsksConclusion(\"review-brief/3\") || !reviewBriefAsksConclusion(\"review-brief/4\") || !reviewBriefAsksConclusion(\"review-brief/5\") || !reviewBriefAsksConclusion(\"review-brief/6\") || !reviewBriefAsksConclusion(\"review-brief/7\") || !reviewBriefAsksConclusion(\"review-brief/8\") || !reviewBriefAsksConclusion(\"review-brief/9\") || !reviewBriefAsksConclusion(\"review-brief/10\") || !reviewBriefAsksConclusion(\"review-brief/11\") || reviewBriefAsksConclusion(\"review-brief/2\") {\n+\t\tt.Fatal(\"the templates that ask for a conclusion are /3 to /11\")\n \t}\n }\n \n@@ -138,3 +138,59 @@ func TestTheBriefOfALaterRoundStatesTheIdentifiersOfPriorFindings(t *testing.T)\n \t\tt.Error(\"review-brief/4 changed under its version: the rule belongs to review-brief/5 and later\")\n \t}\n }\n+\n+// Spec pose-review-readiness-before-seal R4: the current brief asks the\n+// reviewer to check its draft before finishing; /7 never did.\n+func TestTheCurrentBriefAsksForTheDraftCheck(t *testing.T) {\n+\tconst step = \"pipe it to `\\\"$POSE_REVIEW_CLI\\\" review draft-check --draft -`\"\n+\tcurrent := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, step) {\n+\t\tt.Fatal(\"the current review brief does not ask for the draft check\")\n+\t}\n+\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateAllNotApplicable, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, step) {\n+\t\tt.Fatal(\"review-brief/7 changed under the runs briefed with it\")\n+\t}\n+}\n+\n+// Spec pose-assess-leaves-sealed-checkouts-alone R5: the current brief has\n+// the planned `pose` commands run by the dispatching engine; /8 never did.\n+func TestTheCurrentBriefRunsPlannedToolsWithTheDispatchingEngine(t *testing.T) {\n+\tconst step = \"Run each `pose` command below as `\\\"$POSE_REVIEW_CLI\\\"`\"\n+\tcurrent := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, step) || !strings.Contains(current, \"pipe it to `\\\"$POSE_REVIEW_CLI\\\" review draft-check --draft -`\") {\n+\t\tt.Fatal(\"the current review brief does not run planned tools and the draft check with the dispatching engine\")\n+\t}\n+\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateDraftCheck, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, step) {\n+\t\tt.Fatal(\"review-brief/8 changed under the runs briefed with it\")\n+\t}\n+}\n+\n+// Spec pose-review-run-reaps-lingering-reviewer-processes R3: the current\n+// brief asks the reviewer to let its commands finish; /9 never did.\n+func TestTheCurrentBriefAsksCommandsToFinish(t *testing.T) {\n+\tconst boundary = \"Let every command you start finish before you end\"\n+\tcurrent := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, boundary) || !strings.Contains(current, \"Run each `pose` command below as\") {\n+\t\tt.Fatal(\"the current review brief does not keep /9 and ask commands to finish\")\n+\t}\n+\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateEngineTools, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, boundary) {\n+\t\tt.Fatal(\"review-brief/9 changed under the runs briefed with it\")\n+\t}\n+}\n+\n+// Spec pose-review-declared-threat-model R2: the current brief lists the\n+// sealed accepted limits and says how a finding inside one is classified;\n+// /10 never did.\n+func TestTheCurrentBriefListsTheAcceptedLimits(t *testing.T) {\n+\tcurrent := renderReviewBriefBody(richBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, \"## Accepted limits\") || !strings.Contains(current, \"- L1: A process that clears its environment escapes.\") || !strings.Contains(current, \"with `limit` set to its id\") {\n+\t\tt.Fatalf(\"the current brief does not list the accepted limits:\\n%s\", current)\n+\t}\n+\tearlier := renderReviewBriefBody(richBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateFinishCommands, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, \"## Accepted limits\") {\n+\t\tt.Fatal(\"review-brief/10 changed under the runs briefed with it\")\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_brief_versions_test.go b/pose-mcp/internal/pose/review_brief_versions_test.go\nindex 303d62cc..88b16a10 100644\n--- a/pose-mcp/internal/pose/review_brief_versions_test.go\n+++ b/pose-mcp/internal/pose/review_brief_versions_test.go\n@@ -54,6 +54,7 @@ func richBriefBundle() ReviewBundle {\n \tbundle.Payload.Plan.Tools = append(bundle.Payload.Plan.Tools, ReviewPlanTool{ID: \"assess-discover\", Component: \"core\", Requiredness: \"recommended\", Args: []string{\"pose\", \"assess\", \"discover\"}})\n \tbundle.Payload.Subject.Entries = append(bundle.Payload.Subject.Entries, ReviewBundleSubjectEntry{Action: \"renamed\", OldPath: \"core/old.go\", NewPath: \"core/new.go\", Class: \"source\", Reason: \"moved\"})\n \tbundle.Payload.Plan.Criteria = append(bundle.Payload.Plan.Criteria, ReviewPlanCriterion{ID: \"documentation\", Description: \"The docs say it.\", Required: false, Kind: ReviewCriterionKindMechanical})\n+\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"A process that clears its environment escapes. Accepted because the shim covers it.\"}}\n \treturn bundle\n }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DCDn7JwmAok5mt9mKDTzsX","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
