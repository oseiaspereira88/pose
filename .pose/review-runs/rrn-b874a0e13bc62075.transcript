Severity: \"low\", Disposition: \"follow-up\", Summary: \"s\", Owner: \"@o\", ReviewBy: \"2026-12-01\"},\npose-mcp/internal/pose/review_conclusions_test.go:289:\t\t\t{ID: \"F2\", Severity: \"low\", Disposition: \"follow-up\", Summary: \"s\", Action: \"a\", Owner: \"@o\", ReviewBy: \"2026-12-01\"},\npose-mcp/internal/pose/review_rounds.go:260:\t\tcase f.Disposition != \"blocker\" && f.Disposition != \"follow-up\":\npose-mcp/internal/pose/review_rounds_test.go:25:\t\t\"duplicate\": draftOutput(\"changes-requested\", `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"changes-requested\",\"findings\":[{\"id\":\"B1\",\"severity\":\"low\",\"disposition\":\"follow-up\",\"summary\":\"x\"},{\"id\":\"B1\",\"severity\":\"low\",\"disposition\":\"follow-up\",\"summary\":\"y\"}]}`),\npose-mcp/internal/pose/review_rounds_test.go:51:\t\t{\"id\":\"F1\",\"severity\":\"low\",\"disposition\":\"follow-up\",\"summary\":\"third\"}]}`))\npose-mcp/internal/pose/review_rounds_test.go:139:\tif _, err := ParseReviewDraft(draftOutput(\"changes-requested\", `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"changes-requested\",\"findings\":[{\"id\":\"R1-B1\",\"severity\":\"low\",\"disposition\":\"follow-up\",\"summary\":\"x\"}]}`)); err == nil {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"c7778769-af64-4067-b40f-6fea556e1c7c","timestamp":"2026-11-26T00:19:53.923Z","tool_use_result":{"mode":"content","numFiles":0,"filenames":[],"content":"pose-mcp/internal/cli/lintspec.go:141:\t\t\tin = strings.HasPrefix(strings.ToLower(strings.TrimSpace(m[1])), \"follow-up\")\npose-mcp/internal/cli/lintspec.go:699:\t\t\tstrings.HasPrefix(strings.ToLower(strings.TrimSpace(m[1])), \"follow-up\") {\npose-mcp/internal/cli/lintspec.go:880:\t\t\t\tlint.finding(cliout.StateError, \"follow-up\", fmt.Sprintf(cliText(locale, \"follow-up lacks a valid disposition: %s → \\\"%s\\\"\", \"follow-up sem disposição válida: %s → \\\"%s\\\"\"), errMsg, snippet))\npose-mcp/internal/cli/lintspec.go:890