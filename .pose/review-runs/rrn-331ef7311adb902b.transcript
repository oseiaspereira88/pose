{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/usr/bin/bash -lc \"rg --files .pose/assessments | head -20; rg -n 'design-444c1b1b0cc8d340|pose-adopt-request-shows-what-it-sets' .pose/assessments --glob '*.json' -l; sed -n '1,80p' pose-mcp/internal/pose/spec_trailers.go; cat .pose/review-profiles/engineering-judgment.json\"","aggregated_output":".pose/assessments/pose-mcp.md\n.pose/assessments/mcp-enforce.md\n.pose/assessments/README.md\n.pose/assessments/consolidated.md\n.pose/assessments/integrations.md\n.pose/assessments/technical-debt.md\n.pose/assessments/docs-site.md\n.pose/assessments/scripts.md\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n)\n\n// Spec pose-spec-facts-evidence-binding: the facts and the attribution of change sets read the\n// trailers of the history in one way.\n\n// SpecTrailerLogArgs are the arguments of the `git log` whose output ParseSpecTrailerLog reads:\n// every ref, oldest first, the commits that mention a POSE-Spec trailer, hash and full body.\nvar SpecTrailerLogArgs = []string{\"log\", \"--all\", \"--reverse\", \"--grep=POSE-Spec:\", \"--format=%H%x00%B%x00\"}\n\n// ParseSpecTrailerLog maps each spec slug to the commits that carry its trailer. A trailer is a\n// line of the body that starts with `POSE-Spec:` after trimming; the slug is the rest of the\n// line, trimmed. It does not use Git's trailer parser.\n// SpecTrailerLogEntry is one commit of the trailer log, in log order, with\n// the slug of each POSE-Spec line it carries (repeated if the line repeats).\ntype SpecTrailerLogEntry struct {\n\tSHA   string\n\tSpecs []string\n}\n\n// ParseSpecTrailerLogOrdered is ParseSpecTrailerLog keeping the log order:\n// every spec's commit list is the subsequence of these entries that names it\n// (spec pose-index-streams-each-commit-once).\nfunc ParseSpecTrailerLogOrdered(out []byte) []SpecTrailerLogEntry {\n\tparts := bytes.Split(out, []byte{0})\n\tentries := []SpecTrailerLogEntry{}\n\tfor i := 0; i+1 < len(parts); i += 2 {\n\t\tentry := SpecTrailerLogEntry{SHA: strings.TrimSpace(string(parts[i]))}\n\t\tfor _, line := range strings.Split(string(parts[i+1]), \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif strings.HasPrefix(line, \"POSE-Spec:\") {\n\t\t\t\tif spec := strings.TrimSpace(strings.TrimPrefix(line, \"POSE-Spec:\")); spec != \"\" {\n\t\t\t\t\tentry.Specs = append(entry.Specs, spec)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif len(entry.Specs) > 0 {\n\t\t\tentries = append(entries, entry)\n\t\t}\n\t}\n\treturn entries\n}\n\nfunc ParseSpecTrailerLog(out []byte) map[string][]string {\n\tparts := bytes.Split(out, []byte{0})\n\tspecCommits := map[string][]string{}\n\tfor i := 0; i+1 < len(parts); i += 2 {\n\t\tsha, body := strings.TrimSpace(string(parts[i])), string(parts[i+1])\n\t\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif strings.HasPrefix(line, \"POSE-Spec:\") {\n\t\t\t\tspec := strings.TrimSpace(strings.TrimPrefix(line, \"POSE-Spec:\"))\n\t\t\t\tif spec != \"\" {\n\t\t\t\t\tspecCommits[spec] = append(specCommits[spec], sha)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn specCommits\n}\n\n// RawHistoryGit is a git command on root's raw object history: replace refs\n// (--no-replace-objects) and grafts (GIT_GRAFT_FILE at the always-empty null\n// device, which overrides both the repository's graft file and one the\n// environment names) never change which commits carry a trailer, what a change\n// set holds, or what a later removal is judged on (spec\n// pose-delivery-later-removal R3, review round 4 LR-R4-01).\nfunc RawHistoryGit(root string, args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// RawHistoryGitContext is RawHistoryGit under ctx.\nfunc RawHistoryGitContext(ctx context.Context, root string, args ...string) *exec.Cmd {\n{\n  \"schema_version\": 2,\n  \"id\": \"engineering-judgment\",\n  \"version\": 1,\n  \"scope\": \"spec\",\n  \"selectors\": {\"delivery_kinds\": [\"surface\", \"capability\", \"contract\", \"infrastructure\", \"governance\"]},\n  \"criteria\": [\n    {\"id\": \"assumption-integrity\", \"kind\": \"judgment\", \"description\": \"Identify material assumptions and their applicable evidence; distinguish verified facts, unresolved assumptions and accepted risks.\"},\n    {\"id\": \"design-causality\", \"kind\": \"judgment\", \"description\": \"Explain how the selected design addresses the stated requirement and material cause, citing the relevant decision basis and structural observations where available.\"},\n    {\"id\": \"solution-proportionality\", \"kind\": \"judgment\", \"description\": \"Compare the solution with the smallest sufficient alternative, including negative space, speculative extensibility and the condition that would invalidate the choice.\"}\n  ]\n}\n","exit_code":0,"status":"completed"}}
