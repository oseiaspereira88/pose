001�1��!��-u\u001aH��H��H��H��?��\u0001H\u0001к\u0001\u0000\u0000\u0000�\u00021�H�|$h�T$'����H��tYH�\u0015e�\u000e\u0002H9�t\u0007�\u0001\u0000\u0000\u0000�9H�L$8H�\\$0H�D$(H��H�\u001dh\u0012'\u0001�s�\u0000\u0000��\u0001H�L$8H�\u0015,�\u000e\u0002H�\\$0��H�D$(@��t\u000f1�H��@]�H�\u0015\f�\u000e\u0002H�L$hH�ɾ@\u0000\u0000\u0000H\u000fD�H�ɾ\u0001\u0000\u0000\u0000H��H��@H\u0019�H!�\u000f�|$'@��u\n/var/tmp/pose-work-go/pose-review-run-1602047804/worktree\nPOSE - Project Operating Standard for Engineering\n\nUsage: pose <command> [options]\n\nNative binary:\n  version                             Binary and instance schema versions\n  init                                Ensure the minimum POSE repository structure\n  serve-mcp [--stdio]                 Start the POSE MCP server (POSE_* environment)\n  doctor [--json]                     Diagnose installation and instance health\n  report-limitation --title \"...\"     Report an engine limitation, bug or proposal\n                                      [--kind limitation|bug|suggestion] [--submit]\n  install <dir> [--locale tag] [...]  Install embedded POSE without cloning\n  import <spec-kit|openspec> <path>   Import external specs [--dry-run]\n  telemetry <enable|disable|status>   Anonymous opt-in telemetry\n  setup [--json] [--no-input]         See what is in force, what is new and what is missing\n  context [--project-id <id>] [--task <ref>]  Resolve the selected project and qualified task context\n  identity <add|list|remove> [...]    Register the SSH keys a principal proves its answers with\n  issuer <init|pin|list|...>          Create and pin native issuers that sign review attestations\n  adopt <capability> | --list         Turn a governed capability on or off in this instance\n  migrate v7 --dry-run [--json]       Dry-run the legacy inventory a future major would convert\n\nScaffolds:\n  new-spec <slug>                     Create a feature spec scaffold\n  new-spec-qualified <slug>           Create via a qualified authority and fresh context\n  new-roadmap <slug>                  Create a governed roadmap\n  new-adr \"<title>\"                   Create an ADR\n  new-knowledge <type> <slug>         Create a handoff, note, or decision log\n  spec-transfer <preview|apply|resume|status> Transfer specification authority across projects\n  specs [--recent N] [--status S]     List and discover specifications\n  spec-format <migrate|status>        Inspect and migrate specs to the chronological layout\n  start spec:<slug> [--apply]         Preview or apply the atomic start of a draft spec\n\nDeterministic gates:\n  check | validate | knowledge-check | recurrence-check | lint-spec |\n  followups | amend | history-check | skills-check | review-check | closeout-check |\n// olderInstance makes a fresh install look like one installed before the\n// configuration review existed, with three capabilities off.\nfunc olderInstance(t *testing.T) string {\n\tt.Helper()\n\tisolateHome(t)\n\trepo := freshInstall(t)\n\t_ = os.Remove(filepath.Join(repo, \".pose\", \"policy\", \"adoption-decisions.json\"))\n\tfor _, id := range []string{\"contract-nodes\", \"criterion-reuse\"} {\n\t\tif code, out := runPose(t, repo, \"adopt\", id, \"--off\", \"--apply\"); code != 0 {\n\t\t\tt.Fatalf(\"adopt %s --off: %s\", id, out)\n\t\t}\n\t}\n\t_ = os.Remove(filepath.Join(repo, \".pose\", \"policy\", \"adoption-decisions.json\"))\n\treturn repo\n}\n\n// isolateHome keeps the machine's ~/.ssh keys out of the suggestions.\nfunc isolateHome(t *testing.T) {\n\tt.Helper()\n\tt.Setenv(\"HOME\", t.TempDir())\n}\n\nfunc TestSetupOnAFreshInstallNamesTheNextStep(t *testing.T) {\n\tisolateHome(t)\n\trepo := freshInstall(t)\n\tplan := setupJSON(t, repo)\n","exit_code":0,"status":"completed"}}
