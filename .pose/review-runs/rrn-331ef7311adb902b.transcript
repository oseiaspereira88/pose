{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '429,485p' pose-mcp/internal/cli/cli.go; sed -n '70,125p' pose-mcp/internal/pose/spec_trailers.go; ps -eo pid,etime,comm | rg '(pose|go|git)' | tail -20\"","aggregated_output":"func projectRoot() (string, error) {\n\treturn projectRootAt(\".\")\n}\n\n// projectRootAt resolves the git top-level starting from dir, falling back\n// to dir's own absolute path when dir isn't inside a git work tree (spec\n// pose-instance-engine-version-tracking R2) — the same fallback shape\n// projectRoot() already had for \".\".\nfunc projectRootAt(dir string) (string, error) {\n\tout, err := posemodel.RawHistoryGit(dir, \"rev-parse\", \"--show-toplevel\").Output()\n\tif err == nil {\n\t\treturn strings.TrimSpace(string(out)), nil\n\t}\n\tabs, err := filepath.Abs(dir)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn abs, nil\n}\n\n// cmdVersion prints the binary version and, when an instance is resolvable\n// (target, or the current directory when target is \"\"), its schema and —\n// when recorded — the engine version that last delivered its machinery\n// (spec pose-instance-engine-version-tracking).\nfunc cmdVersion(w io.Writer, target string) int {\n\tfmt.Fprintf(w, \"pose %s\\n\", Version)\n\tdir := \".\"\n\tif target != \"\" {\n\t\tdir = target\n\t}\n\tif root, err := projectRootAt(dir); err == nil {\n\t\tsv := filepath.Join(root, \".pose\", \"schema-version\")\n\t\tif b, err := os.ReadFile(sv); err == nil {\n\t\t\tfmt.Fprintf(w, \"schema: %s\\n\", strings.TrimSpace(string(b)))\n\t\t} else if _, err := os.Stat(filepath.Join(root, \".pose\")); err == nil {\n\t\t\tfmt.Fprintf(w, \"schema: unversioned (run 'pose update')\\n\")\n\t\t}\n\t\tif ev := instanceEngineVersion(root); ev != \"\" {\n\t\t\tfmt.Fprintf(w, \"instance last updated by: pose %s\\n\", ev)\n\t\t}\n\t}\n\treturn 0\n}\n\nconst helpTextEN = `POSE - Project Operating Standard for Engineering\n\nUsage: pose <command> [options]\n\nNative binary:\n  version                             Binary and instance schema versions\n  init                                Ensure the minimum POSE repository structure\n  serve-mcp [--stdio]                 Start the POSE MCP server (POSE_* environment)\n  doctor [--json]                     Diagnose installation and instance health\n  report-limitation --title \"...\"     Report an engine limitation, bug or proposal\n                                      [--kind limitation|bug|suggestion] [--submit]\n  install <dir> [--locale tag] [...]  Install embedded POSE without cloning\n  import <spec-kit|openspec> <path>   Import external specs [--dry-run]\n// (--no-replace-objects) and grafts (GIT_GRAFT_FILE at the always-empty null\n// device, which overrides both the repository's graft file and one the\n// environment names) never change which commits carry a trailer, what a change\n// set holds, or what a later removal is judged on (spec\n// pose-delivery-later-removal R3, review round 4 LR-R4-01).\nfunc RawHistoryGit(root string, args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// RawHistoryGitContext is RawHistoryGit under ctx.\nfunc RawHistoryGitContext(ctx context.Context, root string, args ...string) *exec.Cmd {\n\treturn gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// GitHooksDir is the directory git runs the hooks of root from: a linked worktree shares the\n// one of its common directory, and core.hooksPath moves it. Where git cannot answer it is\n// `.git/hooks`, which is where a repository would keep them.\nfunc GitHooksDir(root string) string {\n\tout, err := RawHistoryGit(root, \"rev-parse\", \"--git-path\", \"hooks\").Output()\n\tif err != nil {\n\t\treturn filepath.Join(root, \".git\", \"hooks\")\n\t}\n\tdir := strings.TrimSuffix(string(out), \"\\n\")\n\tif filepath.IsAbs(dir) {\n\t\treturn dir\n\t}\n\treturn filepath.Join(root, dir)\n}\n\n// RawGit is RawHistoryGit for a caller whose arguments already say where to read.\nfunc RawGit(args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\"}, args...)...)\n}\n\n// SpecTrailerCommits reads the history of root and returns the commits that carry the trailer of\n// slug, the way the attribution of change sets does. An error is a history that could not be\n// read, which is not a history without commits.\nfunc SpecTrailerCommits(root, slug string) ([]string, error) {\n\tout, err := RawHistoryGit(root, SpecTrailerLogArgs...).Output()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn ParseSpecTrailerLog(out)[slug], nil\n}\n","exit_code":0,"status":"completed"}}
