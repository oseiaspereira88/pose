{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,100p' pose-mcp/internal/pose/capability_catalog.go; sed -n '375,465p' pose-mcp/internal/pose/legacy_ledger.go; sed -n '300,345p' pose-mcp/internal/cli/closeout_review_policy_test.go; rg -n 'Write|Mkdir|report|json-out|delivery-validation' pose-mcp/internal/cli/validate.go; python3 - <<'PY'\nimport json\np=json.load(open('.pose/results/delivery-validation.json'))\nprint(type(p), list(p) if isinstance(p,dict) else len(p))\nprint(str(p)[:1400])\nPY\"","aggregated_output":"package pose\n\n// The capability catalog describes everything a project can adopt — what it\n// changes day to day, since which version, whether a new instance gets it,\n// what it requires — and how to turn it on and off (spec\n// pose-capability-catalog). `pose adopt`, `pose setup`, install and the update\n// review all read it, so a capability is described once and toggled the same\n// way everywhere. A decision not to adopt is recorded too, in\n// .pose/policy/adoption-decisions.json, so nothing decided is asked again.\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n)\n\n// PolicyDocs are the raw policy documents a capability writes. Raw maps keep\n// every key the engine does not model; the reader validates them on Write.\ntype PolicyDocs struct {\n\tReview map[string]any\n\tDoR    map[string]any\n\t// Root is the instance the documents were loaded from, for an adoption\n\t// that copies a declared value (the project id) into policy.\n\tRoot string\n\n\treviewOriginal, dorOriginal []byte\n\t// reviewRead and dorRead are the bytes each document was loaded from:\n\t// Write publishes only over them (spec\n\t// pose-writer-coordination-and-atomic-publication R2).\n\treviewRead, dorRead PublishExpectation\n\t// FS is the filesystem the documents were loaded from; a prerequisite\n\t// that checks an installed file reads it there.\n\tFS Files\n}\n\nfunc LoadPolicyDocsIn(files Files, root string) (PolicyDocs, error) {\n\tdocs := PolicyDocs{Root: root, FS: files}\n\treads := map[string]PublishExpectation{}\n\tload := func(rel string) (map[string]any, []byte, error) {\n\t\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"policy\", rel))\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\treads[rel] = PublishExpectation{Mode: ExpectAbsent}\n\t\t\treturn map[string]any{}, nil, nil\n\t\t}\n\t\treads[rel] = ExpectBytes(raw, true)\n\t\tif err != nil {\n\t\t\treturn nil, nil, err\n\t\t}\n\t\tdoc := map[string]any{}\n\t\tif err := json.Unmarshal(raw, &doc); err != nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"pose: invalid .pose/policy/%s: %w\", rel, err)\n\t\t}\n\t\tcanonical, _ := json.Marshal(doc)\n\t\treturn doc, canonical, nil\n\t}\n\tvar err error\n\tif docs.Review, docs.reviewOriginal, err = load(\"review.json\"); err != nil {\n\t\treturn docs, err\n\t}\n\tif docs.DoR, docs.dorOriginal, err = load(\"dor.json\"); err != nil {\n\t\treturn docs, err\n\t}\n\tdocs.reviewRead, docs.dorRead = reads[\"review.json\"], reads[\"dor.json\"]\n\treturn docs, nil\n}\n\n// LoadPolicyDocs reads and writes the filesystem directly; LoadPolicyDocsIn takes the\n// operation's files.\nfunc LoadPolicyDocs(root string) (PolicyDocs, error) {\n\treturn LoadPolicyDocsIn(NativeFiles(), root)\n}\n\n// Rendered returns the documents as they would be written, validated by the\n// readers, and which of them changed.\nfunc (d PolicyDocs) Rendered(store Store) (review, dor []byte, reviewChanged, dorChanged bool, err error) {\n\treviewCanonical, _ := json.Marshal(d.Review)\n\tdorCanonical, _ := json.Marshal(d.DoR)\n\treviewChanged = !bytes.Equal(reviewCanonical, d.reviewOriginal)\n\tdorChanged = !bytes.Equal(dorCanonical, d.dorOriginal)\n\tif review, err = json.MarshalIndent(d.Review, \"\", \"  \"); err != nil {\n\t\treturn\n\t}\n\treview = append(review, '\\n')\n\tif dor, err = json.MarshalIndent(d.DoR, \"\", \"  \"); err != nil {\n\t\treturn\n\t}\n\tdor = append(dor, '\\n')\n\tif reviewChanged {\n\t\tif _, err = store.ParseReviewPolicyDocument(review); err != nil {\n\t\t\treturn\n\t\t}\n\t}\n\tif dorChanged {\n\t\tvar policy DoRPolicy\n}\n\n// PlanAdoptionEffects returns the work adopting capability performs besides\n// its policy keys. For signed-attestations in a project with history, that is\n// sealing every unsigned attestation into a legacy ledger signed by the chosen\n// (or only) local issuer pinned for attestations (spec\n// pose-signed-legacy-attestation-ledger).\nfunc PlanAdoptionEffects(root, capability, issuer string, now time.Time) ([]AdoptionEffect, error) {\n\tif capability != \"signed-attestations\" {\n\t\treturn nil, nil\n\t}\n\tdocs, err := LoadPolicyDocs(root)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif blocker := signedHistoryBlocker(NativeFiles(), root, docs, issuer, true); blocker != \"\" {\n\t\treturn nil, fmt.Errorf(\"pose: %s\", blocker)\n\t}\n\tstore := Store{Root: root}\n\tuncovered, err := store.UncoveredUnsignedAttestations()\n\tif err != nil || uncovered == 0 {\n\t\treturn nil, err\n\t}\n\tname := issuer\n\tif name == \"\" {\n\t\tname = localAttestationIssuers(NativeFiles(), root, docs)[0].Issuer\n\t}\n\tkey, err := LoadIssuerKey(root, name)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tpinned := false\n\tfor _, pin := range governedStringList(docs.Review[\"trusted_attestation_issuers\"]) {\n\t\tpinned = pinned || pin == key.Pin()\n\t}\n\tif !pinned {\n\t\treturn nil, fmt.Errorf(\"pose: issuer %s is not pinned for attestations; pin it with pose issuer pin %s --apply\", name, name)\n\t}\n\tledger, err := store.PlanLegacyLedger(key, now)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn []AdoptionEffect{{\n\t\tDescription: fmt.Sprintf(\"seal %d attestation(s) recorded without a signature into a legacy ledger signed by %s; only those, unchanged, keep counting\", len(ledger.Entries), key.Pin()),\n\t\tapply: func() error {\n\t\t\t_, err := store.SealLegacyLedger(ledger, key)\n\t\t\treturn err\n\t\t},\n\t}}, nil\n}\n\twriteCloseoutCLIFile(t, root, \".pose/indexes/validation-matrix.json\", `{\"defaults\":{\"mode\":\"strict\"},\"deliveryProfiles\":{\"api-contract\":{\"kind\":\"contract\",\"requiredEvidenceClasses\":[\"integration\",\"unit\"]}}}`)\n\tadoptCloseoutPolicyFixture(t, root, \"never\", \"never\")\n\tcommitCloseoutFixture(t, root, \"typed member\")\n\tif code, out := runPose(t, root, \"close\", \"spec:bundle\", \"--apply\", \"--reviewer\", \"agent:closeout-reviewer\"); code != 0 {\n\t\tt.Fatalf(\"close spec %d %s\", code, out)\n\t}\n\tcommitCloseoutFixture(t, root, \"closeout\")\n\tif code, out := runPose(t, root, \"close\", \"milestone:program/first\"); code != 0 || !strings.Contains(out, \"close.receipt=\") {\n\t\tt.Fatalf(\"a spec:<slug> member did not close: %d %s\", code, out)\n\t}\n}\n\nfunc TestCloseoutReviewPolicyAdoptRequestRefusesThePair(t *testing.T) {\n\troot := reachedMilestoneFixture(t)\n\tif code, out := runPose(t, root, \"adopt\", \"--request\", \"act-x\", \"--milestone-review-required\", \"never\"); code != 2 {\n\t\tt.Fatalf(\"an answered request swallowed the pair flags: %d %s\", code, out)\n\t}\n}\n\nfunc TestCloseoutReviewPolicyHistoricalRoadmapCloseIsReadOnly(t *testing.T) {\n\troot := reachedMilestoneFixture(t)\n\twriteCloseoutCLIFile(t, root, \".pose/roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\n---\\n\\n## Milestone: first\\n- specs: bundle\\n\")\n\twriteCloseoutCLIFile(t, root, \".pose/indexes/validation-matrix.json\", `{\"defaults\":{\"mode\":\"strict\"},\"deliveryProfiles\":{\"api-contract\":{\"kind\":\"contract\",\"requiredEvidenceClasses\":[\"integration\",\"unit\"]}}}`)\n\tcommitCloseoutFixture(t, root, \"one milestone\")\n\tif code, out := runPose(t, root, \"close\", \"spec:bundle\", \"--apply\", \"--reviewer\", \"agent:closeout-reviewer\"); code != 0 {\n\t\tt.Fatalf(\"close spec %d %s\", code, out)\n\t}\n\t// Closed under the legacy rule: done before review adoption, so the\n\t// legacy cutoff exempts it.\n\twriteCloseoutCLIFile(t, root, \".pose/roadmaps/program.md\", \"---\\nslug: program\\nstatus: done\\ncreated_at: 2026-01-01\\n---\\n\\n## Milestone: first\\n- specs: bundle\\n\")\n\tpolicyPath := filepath.Join(root, \".pose/policy/review.json\")\n\traw, _ := os.ReadFile(policyPath)\n\tvar policy map[string]any\n\tjson.Unmarshal(raw, &policy)\n\tpolicy[\"adopted_at\"] = \"2026-08-01\"\n\tout, _ := json.Marshal(policy)\n\tmustWrite(t, policyPath, string(out))\n\tadoptCloseoutPolicyFixture(t, root, \"always\", \"always\")\n\tcommitCloseoutFixture(t, root, \"history then adoption\")\n\tcode, closeOut := runPose(t, root, \"close\", \"roadmap:program\")\n\tif code != 0 || !strings.Contains(closeOut, \"close.already-satisfied\") || strings.Contains(closeOut, \"close.receipt=\") {\n\t\tt.Fatalf(\"a historical roadmap was not verified read-only: %d %s\", code, closeOut)\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".pose/review-closeouts/roadmap/program.json\")); !os.IsNotExist(err) {\n\t\tt.Fatal(\"a receipt was backfilled for history\")\n\t}\n82:func (e *validationEntry) execute(parent context.Context, matrix validationMatrix, verbose bool, stdout, stderr io.Writer, beforeStream func()) {\n116:\t\tcmd.Stdout = io.MultiWriter(stdout, capture, limiter, packages)\n117:\t\tcmd.Stderr = io.MultiWriter(stderr, capture, limiter)\n119:\t\tcmd.Stdout = io.MultiWriter(capture, limiter, packages)\n120:\t\tcmd.Stderr = io.MultiWriter(capture, limiter)\n275:func (p *goTestPackages) Write(data []byte) (int, error) {\n307:// ranNone reports that Go named packages and said of each that it ran no test.\n735:// isAndroidModule reports whether a Gradle module directory is an Android\n892:func cmdValidate(root string, args []string, stdout, stderr io.Writer) int {\n898:func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr io.Writer) int {\n901:\tmode, stackFilter, moduleFilter, reportTask := \"\", \"\", \"\", \"\"\n917:\t\tcase \"--report\":\n930:\t\tcase \"--stack\", \"--module\", \"--workspace\", \"--report-task\", \"--json\", \"--json-out\", \"--junit\", \"--sarif\", \"--emit-plan\", \"--changed-from\", \"--changed-to\", \"--jobs\":\n954:\t\t\tcase \"--report-task\":\n955:\t\t\t\treportTask = args[i]\n956:\t\t\tcase \"--json-out\":\n963:\t\t\t\trender(stdout, stderr).Hint(cliText(locale, \"validate --json <path> is deprecated; use --json-out <path>.\", \"validate --json <path> está depreciado; use --json-out <path>.\"))\n1001:\t// The report --report writes records this run, so it reads this run's own\n1003:\t// validation never writes, and every report said \"Fill manually\" and \"No\n1005:\t// pose-validate-report-carries-its-run).\n1006:\t// The report records this run from the run's own structured result, not\n1413:\t\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n1433:\t\t\tSpec:          reportTask,\n1450:\t\tif reportTask == \"\" {\n1451:\t\t\treportTask = \"validate-native\"\n1453:\t\treportArgs := []string{\"--task\", reportTask, \"--context\", \"auto-validate\", \"--validation-profile\", mode}\n1456:\t\t_ = runReportWith(root, reportArgs, nil, validationSummaryOf(run), io.Discard, stderr)\n1464:// validationSummaryOf projects a finished run for `pose report`: the commands\n1517:\t// The report records the run's verdict too, built from the outcome rather\n1594:// materialWorktreeClean reports whether the working copy equals HEAD in every\n1627:// materialTrackedUnchanged reports whether no tracked file differs from HEAD\n1659:// administrativeRecordsAreRegular reports whether every changed administrative\n<class 'dict'> ['schema_version', 'generated_at', 'mode', 'git_head', 'matrix_sha256', 'provenance_digest', 'scope_provenance', 'material_provenance', 'jobs', 'wall_seconds', 'outcome', 'counts', 'checks']\n{'schema_version': 1, 'generated_at': '2026-11-14T21:28:13Z', 'mode': 'strict', 'git_head': '1485f1a82121858fbbe6a2ee7fb0b7c823309d8f', 'matrix_sha256': 'sha256:f69e5255776b3a154c9ac6f7dcad569f70afa913e6efdb5da06dc5c914eace51', 'provenance_digest': 'sha256:18823186e23a09416568bb157f9339e469515083dbeb5a78f4290f7f5613f186', 'scope_provenance': {'artifact-claims-stop-at-the-section-end': 'sha256:c0083ea34012c3ec78814d53d3bdb83918132e90f23fee8ff51903aee8672622', 'calendar-dates-tolerate-utc-stamping': 'sha256:36f9125ec27177733affb1bfac1d5dddc2a61a6e2bddbabca5207aad9946e5d6', 'check-builds-the-delivery-graph-once': 'sha256:3174d521faa7402018e6ae4d4997e54e202161c3ecce5b4b201fe562d4f9aa62', 'check-strict-verdict-names-its-mode': 'sha256:1d9cc42d870578aa5ff51c90731ae7223b3eb557274ea068c64cb0a52474dc56', 'check-worker-count-is-the-machines': 'sha256:04c5a4dff210561c33a4962d03260fbe182590395502b6934e4c6706aa761737', 'parse-the-delivery-index-once-per-content': 'sha256:ae5d8b0932f1af046d6e11de948b778462600aa90e4145c9d7ed1fdcffea1534', 'pose-abm-atomic-start': 'sha256:e36e11646857b79bce10a0a54b0af05d244ff4df24180718e67459e5f0c10436', 'pose-abm-authority-fixture-clock': 'sha256:793fc700f81bcdac8f31e00d63a0cf98e5dcebe6d72559a27fedf1cd260ce6c0', 'pose-abm-capability-adoption': 'sha256:04e3cb5db413fc18b0baef48b3630f3c1257a8a903a2e36d57356070e60be103', 'pose-abm-causality-attestation': 'sha256:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 43099880..250f472e -- pose-mcp/internal/scaffold/dist/POSE.md pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md locales/pt-BR/POSE.md; cat .pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md; cat .pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 43099880..250f472e -- pose-mcp/internal/scaffold/dist/POSE.md pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md locales/pt-BR/POSE.md; cat .pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md; cat .pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md'","aggregated_output":"diff --git a/locales/pt-BR/POSE.md b/locales/pt-BR/POSE.md\nindex 3e598dad..ddfe3e45 100644\n--- a/locales/pt-BR/POSE.md\n+++ b/locales/pt-BR/POSE.md\n@@ -897,7 +897,7 @@ ou task e seguir próximas ações nativas.\n \n Um agente schema 2 pode optar por `review_profile.command` e `review_profile.resume_command` somente para review governado. A ausência preserva o adaptador read existente; tasks, adjudicação e smoke mantêm seus comandos. Um agente retomável deve declarar o comando retomado do perfil com `{session}`. Falha do perfil selecionado nunca volta ao perfil read ou de task. Policy e proveniência continuam vinculando os comandos selecionados. Parsers antigos estritos recusam o campo novo. O codec Claude configurado canonicaliza init tipado repetido somente quando identifica a mesma sessão, antes da captura. Identidades diferentes e ambiguidade de regex genérica continuam recusadas; proveniência bruta, redação e canais de limite/reset usam os bytes originais.\n \n-O perfil de revisão Claude deste repositório usa safe/restricted, somente Read/Grep/Glob/Bash, sandbox obrigatório dos comandos (`failIfUnavailable:true`, `allowUnsandboxedCommands:false`) e source selado sem escrita. Os wrappers fresh e resume exigem bubblewrap, socat e jq no Linux (jq também no macOS), com dica de instalação na recusa. Cache/temp do Go ficam em scratch privado da operação fora do checkout; o cache de módulos existente é lido, e downloads indisponíveis ou testes que escrevem no source podem falhar. O perfil instrui o revisor a rodar `go clean -cache` como último comando Bash dentro do sandbox; o motor confere a limpeza independentemente, com os limites inalterados, e mantém limpeza incompleta como falha. Nunca limpar o cache controlado pelo adaptador fora do sandbox: um teste pode substituir seu caminho por um symlink. A qualificação cobre a fronteira dos subprocessos shell do Claude, não isolamento do executável confiável nem sigilo de credenciais arbitrárias. Checks de integridade do checkout continuam obrigatórios. Instalar o motor não adota o perfil em outra instância; copie e qualifique o bloco explícito da policy antes de usá-lo. O wrapper também nega o Git comum físico resolvido, pois o Claude o permite automaticamente em worktrees. Para esse perfil opt-in, o POSE prepara somente diretórios vazios `.claude/.cc-writes` na raiz descartável e nos componentes declarados antes do snapshot; arquivos novos e alterações posteriores continuam recusados. A limpeza final dentro do sandbox também remove somente diretórios `go-build*` diretamente em GOTMPDIR, depois de todos os jobs terminarem.\n+O perfil de revisão Claude sandboxed que o pose-dist qualificou para as próprias revisões usa safe/restricted, somente Read/Grep/Glob/Bash, sandbox obrigatório dos comandos (`failIfUnavailable:true`, `allowUnsandboxedCommands:false`) e source selado sem escrita. Os wrappers fresh e resume exigem bubblewrap, socat e jq no Linux (jq também no macOS), com dica de instalação na recusa. Cache/temp do Go ficam em scratch privado da operação fora do checkout; o cache de módulos existente é lido, e downloads indisponíveis ou testes que escrevem no source podem falhar. O perfil instrui o revisor a rodar `go clean -cache` como último comando Bash dentro do sandbox; o motor confere a limpeza independentemente, com os limites inalterados, e mantém limpeza incompleta como falha. Nunca limpar o cache controlado pelo adaptador fora do sandbox: um teste pode substituir seu caminho por um symlink. A qualificação cobre a fronteira dos subprocessos shell do Claude, não isolamento do executável confiável nem sigilo de credenciais arbitrárias. Checks de integridade do checkout continuam obrigatórios. Instalar o motor não adota o perfil em outra instância; copie e qualifique o bloco explícito da policy antes de usá-lo. O wrapper também nega o Git comum físico resolvido, pois o Claude o permite automaticamente em worktrees. Para esse perfil opt-in, o POSE prepara somente diretórios vazios `.claude/.cc-writes` na raiz descartável e nos componentes declarados antes do snapshot; arquivos novos e alterações posteriores continuam recusados. A limpeza final dentro do sandbox também remove somente diretórios `go-build*` diretamente em GOTMPDIR, depois de todos os jobs terminarem.\n \n `pose delegate ls` lista as tentativas pelo run mais recente com estado, propósito, agente, label, turnos, idade e último passo — para um run interrompido também a causa, se há draft parcial, o instante de reset e o tempo restante — e os runs em andamento com a vivacidade do processo. `pose delegate cancel <run>` para um run em andamento; ele é registrado `failed` com a causa `cancelled`, e a tentativa continua consumida. `pose delegate agents` lista cada agente com vendor, modelo, se a CLI está no path, o instante de reset do último limite de uso registrado e o estado que o roteamento lê: `available`, `limited until <instante>` (o último run atingiu um limite de uso cujo reset ainda não chegou), `missing` (a CLI não está no path), `unknown` (o histórico de runs não pôde ser lido inteiro) ou `probe-failed` (o `probe` opcional falhou dentro do seu limite). A disponibilidade é lida do path e dos runs registrados; só um probe configurado executa algo. `pose delegate review|adjudicate|smoke --detach` inicia o run como um processo próprio, numa sessão própria que sobrevive ao terminal de quem chamou, e retorna na hora com a tentativa (uma referência de run) e o caminho do seu log; um run cuja rota precisa antes esperar o reset de um limite de uso não é destacado. `pose delegate wait <run> [--timeout <d>] [--json]` é um processo comum em primeiro plano que termina quando o run termina e imprime uma linha — run, estado, decisão, se é retomável, instante de reset — com o código de saída `0` aprovado, `10` mudanças pedidas ou rejeitado, `20` falhou (também um run concluído sem decisão), `30` interrompido, `40` travado (`stalled`), `50` a espera esgotou o tempo, e `2` para erro de uso; todos os que esperam são liberados, um run já encerrado retorna na hora, e matar um wait deixa o run rodando. O processo que roda uma tentativa reescreve um heartbeat no seu marcador a cada 10 segundos; um run cujo heartbeat tem mais de três intervalos e cujo processo comprovadamente não existe mais é registrado `stalled` pelo primeiro leitor, por uma reivindicação exclusiva com que todos os leitores concordam, e `ls` mostra a idade do heartbeat de cada run em andamento. `pose delegate watch [<run>|<label>]` mostra uma tentativa como uma tarefa só: os runs registrados são reproduzidos com um marcador onde um run retomou outro e o run interrompido nomeando o run que o continuou, e uma tentativa em andamento é então acompanhada pelos eventos normalizados e redigidos que o seu processo grava à medida que chegam, até o registro ser publicado; `--no-follow` imprime o que existe e sai, `-v` acrescenta o fim da saída de cada ferramenta (`--lines <n>`, padrão 12) e `--json` imprime NDJSON. Sem referência ele acompanha o único run em andamento; num terminal, caso contrário, abre o fzf com um preview do run sob o cursor atualizado a cada `--refresh <d>` (padrão 2s, 0 desliga), ou um menu numerado sem fzf; fora de um terminal uma referência ausente sai com 2 e lista os candidatos. Cores só aparecem num terminal e seguem `NO_COLOR`. Um evento ao vivo é redigido com as credenciais e as referências de sessão que o stream declarou até ali; os eventos vinculados ao registro são derivados de novo do transcript inteiro. `on_terminal` num agente (ou, senão, num propósito) é um comando executado uma vez depois que um run termina, só com `POSE_DELEGATE_RUN` e `POSE_DELEGATE_STATE` no ambiente, o diretório de runs como diretório de trabalho, um grupo de processos próprio e um limite (`timeout`, padrão 30s, no máximo 5m); a falha dele é registrada ao lado do run, mostrada pelo `ls`, e nunca muda o estado do run. `pose delegate handoff <run> --to <agente|auto>` continua um run que parou interrompido ou falho, sem conclusão, com outro agente na mesma tentativa e no seu orçamento de continuação, que é o `resume.max_resumes` e o `max_wall_time` do agente que abriu a tentativa (3 e 60 minutos por padrão), qualquer que seja o agente que a continua, de modo que trocar de agente nunca o amplia; um run concluído, o mesmo agente e um run já continuado são recusados, e um run repassado não é mais retomado. O brief é o brief gerado do predecessor seguido de uma seção rotulada: a mensagem final parcial do predecessor e os comandos que ele rodou com o status de saída, pareados pelo identificador de chamada que o stream do agente registra e, sem ele, deixados como desconhecidos em vez de adivinhados, cada um com seu digest, citados para que nenhuma linha vire uma decisão, limitada a 16 KiB com o corte declarado, e uma instrução de reverificar. Só o run de handoff conclui. O registro vincula o digest do brief base e o da seção em `handoff_digest`, nomeia o predecessor em `hands_off_from`, e uma prova assinada verifica a seção contra o registro do predecessor. `--to auto` roteia como o propósito, excluindo o agente parado e pulando os indisponíveis. Um run ou handoff em primeiro plano que para interrompido num terminal oferece esperar o reset e retomar, fazer o handoff ou cancelar, oferecido mesmo sozinho, e não faz nada até a resposta; o resultado do comando que parou, `ls --json` e `wait --json` trazem os mesmos caminhos em `next_actions`, cada um com o comando, se está disponível agora — avaliado pelo planejamento que o comando roda, orçamento e limite de espera incluídos — e por que não, e um `cancel` que deixa o run parado. `watch` marca um handoff com `⇄`, ao lado do `↻` de uma retomada. `pose delegate task <prompt-file|->` entrega qualquer tarefa a outro agente: o prompt vai pelo stdin em `--cd` (padrão: o diretório atual) com o comando do agente para `--access read|sandboxed|write|full`; o padrão é `purposes.task.default_access` (read quando ausente), `full` nunca é padrão e imprime um aviso dizendo o que ele desliga. O template de uma task posiciona `{add_dirs}`, `{no_network}` e `{outside_git}`, preenchidos a partir de `add_dir_args` (com `{dir}`), `no_network_args` e `outside_git_args` do agente; `--add-dir`, `--no-network` e `--effort` que o template do agente não comporta são recusados com saída 2, assim como `--no-network` com `write` ou `full`. A mensagem final vai para o stdout e o código de saída do agente é devolvido; `--json` troca os dois por um documento. Uma task roda no diretório real: a contenção limita seu tempo e sua saída, não seu sistema de arquivos. O registro (prompt, stream, stream de erro, eventos normalizados, argv, nomes das variáveis removidas, código de saída, label) fica só para o dono no diretório de estado do usuário (`$XDG_STATE_HOME/pose/delegate/`, em que `XDG_STATE_HOME` só vale como caminho absoluto e o padrão é `~/.local/state`), ou, com `--record`, no diretório `delegate-runs` de `.pose`. O diretório de estado pode ser alcançado por um link do próprio usuário; resolvido, ele e todo diretório acima dele devem pertencer ao usuário ou ao root e não ser graváveis por grupo nem por outros usuários, salvo com sticky, e `pose`, `pose/delegate` e o diretório do projeto abaixo dele devem ser diretórios reais do usuário que nenhum grupo ou outro usuário possa gravar; uma task se recusa a registrar ou ler em qualquer outro lugar e nomeia o diretório (no Windows só links são recusados). `--detach` inicia uma task como os propósitos de review iniciam um run destacado e devolve a tentativa, o log e o lugar do registro; um prompt enviado por pipe a `task -` ou `resume --prompt -` é lido antes de destacar e escrito no run destacado por um pipe, nunca por um arquivo, e uma recusa antes de a tentativa ser reservada devolve o documento e o código de saída do primeiro plano. Uma chamada destacada guarda o log e a devolução em `.pose/review-private/supervisors`, que, com todo diretório até a raiz do projeto, deve ser do usuário e não gravável por grupo nem por outros usuários, e cujos ancestrais da raiz devem pertencer ao usuário ou ao root e não ser graváveis por mais ninguém, salvo com sticky; a raiz é resolvida uma vez e só essa raiz resolvida é usada, quem chama a partir de um diretório que não existe mais é recusado, e o histórico privado de tasks de um projeto é indexado pela raiz resolvida (registros que um motor anterior guardou sob uma grafia com link continuam sendo lidos). Uma chamada destacada só acredita numa devolução depois que o prompt enviado por pipe passou e um run reservou a tentativa que ela nomeia. Um checkout que não atende a isso ainda roda em primeiro plano; no Windows só links e não diretórios são recusados, e ACLs não são verificadas. Uma task nunca é evidência: nenhum leitor de review a lê, `pose review attest --run` a recusa pelo nome, e `wait` devolve 0 quando o agente teve sucesso, sem decisão. `ls`, `watch`, `wait`, `cancel`, `resume` e `handoff` funcionam com tasks; `resume` sem `--prompt` envia uma mensagem padrão de continuação, com os `resume.commands` do agente para o acesso da task, e `--agent auto` roteia contra a sessão que a lançou. Uma task também pode continuar uma sessão que o POSE nunca registrou, como uma que um launcher pessoal abriu, com `--session <id> --agent <nome>`: o comando de resume do agente para o acesso roda com essa sessão, o prompt é opcional, e o registro diz que continuou uma sessão sem guardá-la. `pose review dispatch`, `resume` e `status`, os aliases que esta superfície depreciou, foram removidos: cada um sai com 2 e nomeia o substituto em `pose delegate`.\n \ndiff --git a/pose-mcp/internal/scaffold/dist/POSE.md b/pose-mcp/internal/scaffold/dist/POSE.md\nindex 1c0bae47..bf52ea83 100644\n--- a/pose-mcp/internal/scaffold/dist/POSE.md\n+++ b/pose-mcp/internal/scaffold/dist/POSE.md\n@@ -889,7 +889,7 @@ versus task and follow native next actions.\n \n A schema-2 agent may opt in to `review_profile.command` and `review_profile.resume_command` for governed review only. Omission preserves its existing read adapter; tasks, adjudication and smoke keep their commands. A resumable agent must declare the profile's resumed command with `{session}`. Once selected, failure never falls back to the read or task profile. The selected commands remain bound by policy/provenance verification. Older strict parsers reject the new field. The configured Claude event codec canonicalizes repeated typed init records only for the same parsed session identity before session recognition. Different identities and generic regex ambiguity are still refused; raw provenance/redaction and limit/reset channels retain the original bytes.\n \n-This repository's Claude review profile uses safe/restricted mode, Read/Grep/Glob/Bash only, mandatory shell sandboxing (`failIfUnavailable:true`, `allowUnsandboxedCommands:false`), and a read-only sealed source tree. Both fresh and resumed wrappers require bubblewrap, socat and jq on Linux (jq remains required on macOS), with installation advice on refusal. Go cache/temp writes go to private operation-owned scratch outside the checkout; the existing module cache is read, and unavailable downloads/tests that write into source can fail. The profile instructs the reviewer to run `go clean -cache` as its final Bash command inside the sandbox; the engine independently retains incomplete cleanup as a failed run under its unchanged limits. Never clean an adapter-controlled cache outside the sandbox: a test can replace its path with a symlink. This qualifies Claude's shell subprocess boundary, not isolation of the trusted Claude executable or arbitrary credential reads. Checkout integrity checks still apply. Installing engine code does not adopt the profile in another instance; copy and qualify its explicit policy block before use. The wrapper also denies the resolved physical Git common directory, because Claude auto-allows it for worktrees. For this opt-in profile, POSE prepares only empty `.claude/.cc-writes` directories at the disposable checkout root and declared components before taking its integrity snapshot; added files and all later mutations still fail. Final sandboxed cleanup includes leftover `go-build*` directories directly under GOTMPDIR after all jobs finish.\n+The sandboxed Claude review profile that pose-dist qualified for its own reviews uses safe/restricted mode, Read/Grep/Glob/Bash only, mandatory shell sandboxing (`failIfUnavailable:true`, `allowUnsandboxedCommands:false`), and a read-only sealed source tree. Both fresh and resumed wrappers require bubblewrap, socat and jq on Linux (jq remains required on macOS), with installation advice on refusal. Go cache/temp writes go to private operation-owned scratch outside the checkout; the existing module cache is read, and unavailable downloads/tests that write into source can fail. The profile instructs the reviewer to run `go clean -cache` as its final Bash command inside the sandbox; the engine independently retains incomplete cleanup as a failed run under its unchanged limits. Never clean an adapter-controlled cache outside the sandbox: a test can replace its path with a symlink. This qualifies Claude's shell subprocess boundary, not isolation of the trusted Claude executable or arbitrary credential reads. Checkout integrity checks still apply. Installing engine code does not adopt the profile in another instance; copy and qualify its explicit policy block before use. The wrapper also denies the resolved physical Git common directory, because Claude auto-allows it for worktrees. For this opt-in profile, POSE prepares only empty `.claude/.cc-writes` directories at the disposable checkout root and declared components before taking its integrity snapshot; added files and all later mutations still fail. Final sandboxed cleanup includes leftover `go-build*` directories directly under GOTMPDIR after all jobs finish.\n \n `pose delegate ls` lists attempts by their latest run with state, purpose, agent, label, turns, age and last step — for an interrupted run also its cause, whether a partial draft exists, the reset instant and the time left — and the runs in progress with the liveness of their process. `pose delegate cancel <run>` stops a run in progress; it is recorded `failed` with the cause `cancelled`, and its attempt stays consumed. `pose delegate agents` lists each agent with vendor, model, whether its CLI is on the path, the reset instant of its last recorded usage limit and the state routing reads: `available`, `limited until <instant>` (its last run hit a usage limit whose reset is ahead), `missing` (its CLI is not on the path), `unknown` (the run history could not be read whole) or `probe-failed` (its optional `probe` failed within its bound). Availability is read from the path and the recorded runs; only a configured probe runs anything. `pose delegate review|adjudicate|smoke --detach` starts the run as a process of its own, in a session of its own that survives the caller's terminal, and returns at once with the attempt (a run reference) and the path of its log; a run whose route must first wait for a usage-limit reset is not detached. `pose delegate wait <run> [--timeout <d>] [--json]` is a plain foreground process that ends when the run does and prints one line — run, state, decision, resumable flag, reset instant — with the exit code `0` approved, `10` changes requested or rejected, `20` failed (a completed run with no decision too), `30` interrupted, `40` stalled, `50` the wait timed out, and `2` for a usage error; every waiter is released, a run already ended returns at once, and killing a wait leaves the run running. The process running an attempt rewrites a heartbeat in its marker every 10 seconds; a run whose heartbeat is older than three intervals and whose process is provably gone is recorded `stalled` by the first reader, through an exclusive claim every reader then agrees on, and `ls` shows each running run's heartbeat age. `pose delegate watch [<run>|<label>]` shows an attempt as one task: the runs it recorded are replayed with a marker where a run resumed another and the interrupted run naming the run that continued it, then a running attempt is followed through the normalized, redacted events its process writes as they come, until the record is published; `--no-follow` prints what exists and exits, `-v` adds the tail of each tool's output (`--lines <n>`, default 12) and `--json` prints NDJSON. With no reference it follows the only running run; at a terminal it otherwise opens fzf with a preview of the run under the cursor refreshed every `--refresh <d>` (default 2s, 0 turns it off), or a numbered menu without fzf; outside a terminal an absent reference exits 2 and lists the candidates. Colours appear only on a terminal and follow `NO_COLOR`. A live event is redacted with the credentials and the session references the stream has declared so far; the events bound to the record are derived again from the whole transcript. `on_terminal` on an agent (or else on a purpose) is a command run once after a run ends, with only `POSE_DELEGATE_RUN` and `POSE_DELEGATE_STATE` in its environment, the run directory as working directory, its own process group and a bound (`timeout`, default 30s, at most 5m); its failure is recorded beside the run, shown by `ls`, and never changes the run's state. `pose delegate handoff <run> --to <agent|auto>` continues a run that stopped interrupted or failed, short of a conclusion, with another agent under the same attempt and its continuation budget, which is the `resume.max_resumes` and `max_wall_time` of the agent that opened the attempt (3 and 60 minutes by default) whichever agent continues it, so changing agents never widens it; a completed run, the same agent and a run already continued are refused, and a run handed off is no longer resumed. Its brief is the predecessor's generated brief followed by a labelled section: the predecessor's partial final message and the commands it ran with their exit status, paired by the call identifier the agent's stream records and otherwise left unknown rather than guessed, each with its digest, quoted so no line of it reads as a decision, bounded at 16 KiB with the cut disclosed, and an instruction to re-verify. Only the handoff run concludes. The record binds the base brief digest and the section digest in `handoff_digest`, names its predecessor in `hands_off_from`, and a signed proof verifies the section against the predecessor's record. `--to auto` routes as the purpose does, the stopped agent excluded and unavailable ones skipped. A foreground run or handoff that stops interrupted in a terminal offers waiting for its reset and resuming, handing off, or cancelling, which is offered even alone, and does nothing until answered; the stopping command's result, `ls --json` and `wait --json` carry the same ways forward as `next_actions`, each with its command, whether it is available now — judged by the planning its command runs, budget and wait bound included — and why not, and a `cancel` that leaves the run stopped. `watch` marks a handoff with `⇄` beside the `↻` of a resume. `pose delegate task <prompt-file|->` hands any task to another agent: the prompt goes on stdin in `--cd` (default: the current directory) with the agent's command for `--access read|sandboxed|write|full`; the default is `purposes.task.default_access` (read when unset), `full` is never a default and prints a warning naming what it disables. A task's template places `{add_dirs}`, `{no_network}` and `{outside_git}`, filled from the agent's `add_dir_args` (with `{dir}`), `no_network_args` and `outside_git_args`; `--add-dir`, `--no-network` and `--effort` that the agent's template cannot carry are refused with exit 2, and `--no-network` with `write` or `full` too. The final message goes to stdout and the agent's exit code is returned; `--json` replaces both with one document. A task runs in the real directory: containment bounds its time and output, not its filesystem. Its record (prompt, stream, error stream, normalized events, argv, removed variable names, exit code, label) is owner-only under the user's state directory (`$XDG_STATE_HOME/pose/delegate/`, where `XDG_STATE_HOME` counts only as an absolute path and `~/.local/state` is the default), or, with `--record`, in the `delegate-runs` directory of `.pose`. The state directory may be reached through a link of the user's own; resolved, it and every directory above it must belong to the user or to root and be writable by no group or other user unless sticky, and `pose`, `pose/delegate` and the project's directory below it must be real directories of the user's that no group or other user can write; a task refuses to record or read anywhere else and names the directory (on Windows only links are refused). `--detach` starts a task as the review purposes start a detached run and returns its attempt, its log and the place of its record; a prompt piped to `task -` or `resume --prompt -` is read before detaching and written to the detached run through a pipe, never a file, and a refusal before the attempt is reserved returns the foreground's document and exit code. A detached call keeps its log and hand-back in `.pose/review-private/supervisors`, which, with every directory up to the project root, must be the user's and writable by no group or other user, and whose root's ancestors must belong to the user or root and be writable by no one else unless sticky; the root is resolved once and only that resolved root is used, a caller whose current directory is gone is refused, and a project's private task history is keyed by its resolved root (records an earlier engine kept under a linked spelling are still read). A detached call believes a hand-back only once a piped prompt is through and a run reserved the attempt it names. A checkout that fails this can still run in the foreground; on Windows only links and non-directories are refused, and ACLs are not checked. A task is never evidence: no review reader reads it, `pose review attest --run` refuses it by name, and `wait` returns 0 when the agent succeeded, with no decision. `ls`, `watch`, `wait`, `cancel`, `resume` and `handoff` work on tasks; `resume` without `--prompt` sends a default continuation message, with the agent's `resume.commands` for the task's access, and `--agent auto` routes against the launching session. A task can also continue a session POSE never recorded, such as one a personal launcher opened, with `--session <id> --agent <name>`: the agent's resume command for the access runs with that session, the prompt optional, and the record says it continued a session without keeping it. `pose review dispatch`, `resume` and `status`, the aliases this surface deprecated, were removed: each exits 2 and names its `pose delegate` replacement.\n \ndiff --git a/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md b/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\nindex 3e598dad..ddfe3e45 100644\n--- a/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n+++ b/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n@@ -897,7 +897,7 @@ ou task e seguir próximas ações nativas.\n \n Um agente schema 2 pode optar por `review_profile.command` e `review_profile.resume_command` somente para review governado. A ausência preserva o adaptador read existente; tasks, adjudicação e smoke mantêm seus comandos. Um agente retomável deve declarar o comando retomado do perfil com `{session}`. Falha do perfil selecionado nunca volta ao perfil read ou de task. Policy e proveniência continuam vinculando os comandos selecionados. Parsers antigos estritos recusam o campo novo. O codec Claude configurado canonicaliza init tipado repetido somente quando identifica a mesma sessão, antes da captura. Identidades diferentes e ambiguidade de regex genérica continuam recusadas; proveniência bruta, redação e canais de limite/reset usam os bytes originais.\n \n-O perfil de revisão Claude deste repositório usa safe/restricted, somente Read/Grep/Glob/Bash, sandbox obrigatório dos comandos (`failIfUnavailable:true`, `allowUnsandboxedCommands:false`) e source selado sem escrita. Os wrappers fresh e resume exigem bubblewrap, socat e jq no Linux (jq também no macOS), com dica de instalação na recusa. Cache/temp do Go ficam em scratch privado da operação fora do checkout; o cache de módulos existente é lido, e downloads indisponíveis ou testes que escrevem no source podem falhar. O perfil instrui o revisor a rodar `go clean -cache` como último comando Bash dentro do sandbox; o motor confere a limpeza independentemente, com os limites inalterados, e mantém limpeza incompleta como falha. Nunca limpar o cache controlado pelo adaptador fora do sandbox: um teste pode substituir seu caminho por um symlink. A qualificação cobre a fronteira dos subprocessos shell do Claude, não isolamento do executável confiável nem sigilo de credenciais arbitrárias. Checks de integridade do checkout continuam obrigatórios. Instalar o motor não adota o perfil em outra instância; copie e qualifique o bloco explícito da policy antes de usá-lo. O wrapper também nega o Git comum físico resolvido, pois o Claude o permite automaticamente em worktrees. Para esse perfil opt-in, o POSE prepara somente diretórios vazios `.claude/.cc-writes` na raiz descartável e nos componentes declarados antes do snapshot; arquivos novos e alterações posteriores continuam recusados. A limpeza final dentro do sandbox também remove somente diretórios `go-build*` diretamente em GOTMPDIR, depois de todos os jobs terminarem.\n+O perfil de revisão Claude sandboxed que o pose-dist qualificou para as próprias revisões usa safe/restricted, somente Read/Grep/Glob/Bash, sandbox obrigatório dos comandos (`failIfUnavailable:true`, `allowUnsandboxedCommands:false`) e source selado sem escrita. Os wrappers fresh e resume exigem bubblewrap, socat e jq no Linux (jq também no macOS), com dica de instalação na recusa. Cache/temp do Go ficam em scratch privado da operação fora do checkout; o cache de módulos existente é lido, e downloads indisponíveis ou testes que escrevem no source podem falhar. O perfil instrui o revisor a rodar `go clean -cache` como último comando Bash dentro do sandbox; o motor confere a limpeza independentemente, com os limites inalterados, e mantém limpeza incompleta como falha. Nunca limpar o cache controlado pelo adaptador fora do sandbox: um teste pode substituir seu caminho por um symlink. A qualificação cobre a fronteira dos subprocessos shell do Claude, não isolamento do executável confiável nem sigilo de credenciais arbitrárias. Checks de integridade do checkout continuam obrigatórios. Instalar o motor não adota o perfil em outra instância; copie e qualifique o bloco explícito da policy antes de usá-lo. O wrapper também nega o Git comum físico resolvido, pois o Claude o permite automaticamente em worktrees. Para esse perfil opt-in, o POSE prepara somente diretórios vazios `.claude/.cc-writes` na raiz descartável e nos componentes declarados antes do snapshot; arquivos novos e alterações posteriores continuam recusados. A limpeza final dentro do sandbox também remove somente diretórios `go-build*` diretamente em GOTMPDIR, depois de todos os jobs terminarem.\n \n `pose delegate ls` lista as tentativas pelo run mais recente com estado, propósito, agente, label, turnos, idade e último passo — para um run interrompido também a causa, se há draft parcial, o instante de reset e o tempo restante — e os runs em andamento com a vivacidade do processo. `pose delegate cancel <run>` para um run em andamento; ele é registrado `failed` com a causa `cancelled`, e a tentativa continua consumida. `pose delegate agents` lista cada agente com vendor, modelo, se a CLI está no path, o instante de reset do último limite de uso registrado e o estado que o roteamento lê: `available`, `limited until <instante>` (o último run atingiu um limite de uso cujo reset ainda não chegou), `missing` (a CLI não está no path), `unknown` (o histórico de runs não pôde ser lido inteiro) ou `probe-failed` (o `probe` opcional falhou dentro do seu limite). A disponibilidade é lida do path e dos runs registrados; só um probe configurado executa algo. `pose delegate review|adjudicate|smoke --detach` inicia o run como um processo próprio, numa sessão própria que sobrevive ao terminal de quem chamou, e retorna na hora com a tentativa (uma referência de run) e o caminho do seu log; um run cuja rota precisa antes esperar o reset de um limite de uso não é destacado. `pose delegate wait <run> [--timeout <d>] [--json]` é um processo comum em primeiro plano que termina quando o run termina e imprime uma linha — run, estado, decisão, se é retomável, instante de reset — com o código de saída `0` aprovado, `10` mudanças pedidas ou rejeitado, `20` falhou (também um run concluído sem decisão), `30` interrompido, `40` travado (`stalled`), `50` a espera esgotou o tempo, e `2` para erro de uso; todos os que esperam são liberados, um run já encerrado retorna na hora, e matar um wait deixa o run rodando. O processo que roda uma tentativa reescreve um heartbeat no seu marcador a cada 10 segundos; um run cujo heartbeat tem mais de três intervalos e cujo processo comprovadamente não existe mais é registrado `stalled` pelo primeiro leitor, por uma reivindicação exclusiva com que todos os leitores concordam, e `ls` mostra a idade do heartbeat de cada run em andamento. `pose delegate watch [<run>|<label>]` mostra uma tentativa como uma tarefa só: os runs registrados são reproduzidos com um marcador onde um run retomou outro e o run interrompido nomeando o run que o continuou, e uma tentativa em andamento é então acompanhada pelos eventos normalizados e redigidos que o seu processo grava à medida que chegam, até o registro ser publicado; `--no-follow` imprime o que existe e sai, `-v` acrescenta o fim da saída de cada ferramenta (`--lines <n>`, padrão 12) e `--json` imprime NDJSON. Sem referência ele acompanha o único run em andamento; num terminal, caso contrário, abre o fzf com um preview do run sob o cursor atualizado a cada `--refresh <d>` (padrão 2s, 0 desliga), ou um menu numerado sem fzf; fora de um terminal uma referência ausente sai com 2 e lista os candidatos. Cores só aparecem num terminal e seguem `NO_COLOR`. Um evento ao vivo é redigido com as credenciais e as referências de sessão que o stream declarou até ali; os eventos vinculados ao registro são derivados de novo do transcript inteiro. `on_terminal` num agente (ou, senão, num propósito) é um comando executado uma vez depois que um run termina, só com `POSE_DELEGATE_RUN` e `POSE_DELEGATE_STATE` no ambiente, o diretório de runs como diretório de trabalho, um grupo de processos próprio e um limite (`timeout`, padrão 30s, no máximo 5m); a falha dele é registrada ao lado do run, mostrada pelo `ls`, e nunca muda o estado do run. `pose delegate handoff <run> --to <agente|auto>` continua um run que parou interrompido ou falho, sem conclusão, com outro agente na mesma tentativa e no seu orçamento de continuação, que é o `resume.max_resumes` e o `max_wall_time` do agente que abriu a tentativa (3 e 60 minutos por padrão), qualquer que seja o agente que a continua, de modo que trocar de agente nunca o amplia; um run concluído, o mesmo agente e um run já continuado são recusados, e um run repassado não é mais retomado. O brief é o brief gerado do predecessor seguido de uma seção rotulada: a mensagem final parcial do predecessor e os comandos que ele rodou com o status de saída, pareados pelo identificador de chamada que o stream do agente registra e, sem ele, deixados como desconhecidos em vez de adivinhados, cada um com seu digest, citados para que nenhuma linha vire uma decisão, limitada a 16 KiB com o corte declarado, e uma instrução de reverificar. Só o run de handoff conclui. O registro vincula o digest do brief base e o da seção em `handoff_digest`, nomeia o predecessor em `hands_off_from`, e uma prova assinada verifica a seção contra o registro do predecessor. `--to auto` roteia como o propósito, excluindo o agente parado e pulando os indisponíveis. Um run ou handoff em primeiro plano que para interrompido num terminal oferece esperar o reset e retomar, fazer o handoff ou cancelar, oferecido mesmo sozinho, e não faz nada até a resposta; o resultado do comando que parou, `ls --json` e `wait --json` trazem os mesmos caminhos em `next_actions`, cada um com o comando, se está disponível agora — avaliado pelo planejamento que o comando roda, orçamento e limite de espera incluídos — e por que não, e um `cancel` que deixa o run parado. `watch` marca um handoff com `⇄`, ao lado do `↻` de uma retomada. `pose delegate task <prompt-file|->` entrega qualquer tarefa a outro agente: o prompt vai pelo stdin em `--cd` (padrão: o diretório atual) com o comando do agente para `--access read|sandboxed|write|full`; o padrão é `purposes.task.default_access` (read quando ausente), `full` nunca é padrão e imprime um aviso dizendo o que ele desliga. O template de uma task posiciona `{add_dirs}`, `{no_network}` e `{outside_git}`, preenchidos a partir de `add_dir_args` (com `{dir}`), `no_network_args` e `outside_git_args` do agente; `--add-dir`, `--no-network` e `--effort` que o template do agente não comporta são recusados com saída 2, assim como `--no-network` com `write` ou `full`. A mensagem final vai para o stdout e o código de saída do agente é devolvido; `--json` troca os dois por um documento. Uma task roda no diretório real: a contenção limita seu tempo e sua saída, não seu sistema de arquivos. O registro (prompt, stream, stream de erro, eventos normalizados, argv, nomes das variáveis removidas, código de saída, label) fica só para o dono no diretório de estado do usuário (`$XDG_STATE_HOME/pose/delegate/`, em que `XDG_STATE_HOME` só vale como caminho absoluto e o padrão é `~/.local/state`), ou, com `--record`, no diretório `delegate-runs` de `.pose`. O diretório de estado pode ser alcançado por um link do próprio usuário; resolvido, ele e todo diretório acima dele devem pertencer ao usuário ou ao root e não ser graváveis por grupo nem por outros usuários, salvo com sticky, e `pose`, `pose/delegate` e o diretório do projeto abaixo dele devem ser diretórios reais do usuário que nenhum grupo ou outro usuário possa gravar; uma task se recusa a registrar ou ler em qualquer outro lugar e nomeia o diretório (no Windows só links são recusados). `--detach` inicia uma task como os propósitos de review iniciam um run destacado e devolve a tentativa, o log e o lugar do registro; um prompt enviado por pipe a `task -` ou `resume --prompt -` é lido antes de destacar e escrito no run destacado por um pipe, nunca por um arquivo, e uma recusa antes de a tentativa ser reservada devolve o documento e o código de saída do primeiro plano. Uma chamada destacada guarda o log e a devolução em `.pose/review-private/supervisors`, que, com todo diretório até a raiz do projeto, deve ser do usuário e não gravável por grupo nem por outros usuários, e cujos ancestrais da raiz devem pertencer ao usuário ou ao root e não ser graváveis por mais ninguém, salvo com sticky; a raiz é resolvida uma vez e só essa raiz resolvida é usada, quem chama a partir de um diretório que não existe mais é recusado, e o histórico privado de tasks de um projeto é indexado pela raiz resolvida (registros que um motor anterior guardou sob uma grafia com link continuam sendo lidos). Uma chamada destacada só acredita numa devolução depois que o prompt enviado por pipe passou e um run reservou a tentativa que ela nomeia. Um checkout que não atende a isso ainda roda em primeiro plano; no Windows só links e não diretórios são recusados, e ACLs não são verificadas. Uma task nunca é evidência: nenhum leitor de review a lê, `pose review attest --run` a recusa pelo nome, e `wait` devolve 0 quando o agente teve sucesso, sem decisão. `ls`, `watch`, `wait`, `cancel`, `resume` e `handoff` funcionam com tasks; `resume` sem `--prompt` envia uma mensagem padrão de continuação, com os `resume.commands` do agente para o acesso da task, e `--agent auto` roteia contra a sessão que a lançou. Uma task também pode continuar uma sessão que o POSE nunca registrou, como uma que um launcher pessoal abriu, com `--session <id> --agent <nome>`: o comando de resume do agente para o acesso roda com essa sessão, o prompt é opcional, e o registro diz que continuou uma sessão sem guardá-la. `pose review dispatch`, `resume` e `status`, os aliases que esta superfície depreciou, foram removidos: cada um sai com 2 e nomeia o substituto em `pose delegate`.\n \n---\ntype: note\nslug: cli-output-design-taxonomy\nowner: @pose-maintainers\nsensitivity: public-internal\ncreated_at: 2026-09-12\nlast_reviewed_at: 2026-09-12\nexpires_at: 2026-12-11\nsource_refs:\n  spec: \"\"\n  workflow: documentation-update\n  commands: [\"pose check --strict\", \"pose knowledge-check --strict\", \"pose specs --json\", \"pose followups --json\", \"pose usage --json\", \"pose doctor --json\", \"pose review-plan spec:<slug> --json\", \"pose artifact-check --spec <slug> --json\", \"pose check --json\", \"pose lint-spec <slug> --json\", \"pose history-check --json\", \"pose knowledge-check --json\", \"pose skills-check --json\", \"pose recurrence-check --json\", \"pose index --json\", \"pose state --json\"]\n  external_sources: []\n---\n\n# note: cli-output-design-taxonomy\n\n## Context\n\nWe want to raise the quality of what POSE's CLI prints, and to standardise it\nacross every command. This note groups the work into the categories the\ndiscipline actually has, records what this engine does today — measured, not\nassumed — and lists what each category would contain if we pursued it. It takes\nno decisions: it exists so the spec and the ADRs that follow are written against\nfacts, and so the parts that need the maintainer's call are visible before code\nis written.\n\n**Why the 90-day TTL** (the knowledge rule allows it only with a recorded\nreason): this note is the input to a spec and to a rendering-layer ADR, and it\nstays the reference for the phases while they are implemented across releases. A\n30-day expiry would retire it in the middle of that work. It should be reviewed\nwhen the spec closes, and retired when the ADR and `docs-site/docs/cli.md` carry\nthe decisions.\n\nThe commands in `source_refs` are of two kinds, and are not interchangeable:\n`pose check --strict` and `pose knowledge-check --strict` are the validation this\nnote ran; everything else was executed only to observe the surface it describes\n(which commands accept `--json`, and what they print).\n\nTwo audiences read this output, and they are not the same reader:\n\n- **humans**, who watch a gate run and need to know what is happening, what\n  failed, and what to do next;\n- **machines** — CI, scripts, and the agents POSE is built for — which need\n  stable, parseable output.\n\nA mature CLI treats those as separate channels. POSE currently has one and a\nhalf: a human channel that machines already parse, and a `--json` channel that\ncovers some commands.\n\n## Current state\n\nMeasured on `main` at 2ff75f1 (POSE 5.0.6), in `pose-mcp/internal/cli`\n(70 non-test files, 35 top-level commands, 40 help-catalog entries).\n\n**There is no presentation layer.**\n\n- `fmt.Fprint*` is called from **1138 sites**; there is no intermediate writer,\n  no severity type, no formatter.\n- **0 ANSI escape sequences.** No colour, no bold, no dim.\n- No TTY detection, no terminal-width or wrapping logic, no `--quiet`, no\n  progress indicator of any kind.\n- Symbols appear by accident: one `✓`, two `⚠`, two `💡` in the whole tree.\n- `text/tabwriter` (stdlib) is used **twice**; every other aligned output is\n  hand-spaced.\n\n**Vocabularies coexist.** Three severity dialects are in use at once:\n\n| Shape | Sites | Where it goes |\n|---|---|---|\n| `[ERROR]` / `[WARN]` / `[INFO]` | 37 / 14 / 26 | stdout **and** stderr (27 / 43 sites) — these are *findings*, the command's result |\n| `Error: …` | 116 | stderr — the command itself failed |\n| `[pose-install] …` | 6 | stderr — one command's private prefix |\n| `Usage: …` | 134 | stderr |\n| `Result: …` / `Resultado: …` | 54 / 22 | stdout — the verdict line |\n| `name.field=value` | 50 | stdout — machine-oriented diagnostics |\n\n**And the channel split is mixed, not merely undocumented.** Counting call\nsites: 27 `[ERROR]`/`[WARN]`/`[INFO]` lines go to **stdout**, and 43 go to\n**stderr** — including findings that are the command's result, such as\n`lint-spec`'s DoR errors (`lintspec.go`) and `knowledge-usage`'s unresolved\nreferences. So the same class of output lands on either channel depending on the\ncommand, and `pose x 2>/dev/null` silently drops real findings in some commands\nand not others. A rule is needed, and so is a migration: this is not a matter of\nwriting down what already holds.\n\n**Localisation is 28% covered.** 315 of the 1138 print sites pass through\n`cliText`; the rest print English regardless of `POSE_LOCALE`. `POSE_LOCALE`\nitself is documented in no user-facing document — only inside a spec.\n\n**Unknown-flag errors are inconsistent**, though the exit code (2) is not:\n\n```\npose check --json          → Error: invalid argument: --json\npose lint-spec X --json    → Error: unknown option: --json\npose knowledge-check --json→ Usage: pose knowledge-check [--strict|--tolerant] …\npose specs --json          → (valid JSON on stdout)\npose <garbage> --flag      → Unknown command: <the whole argv, joined>\n```\n\n**`--json` means two different things.** 55 parse sites. In most commands it is\na boolean that prints JSON to stdout (`specs`, `followups`, `usage`, `doctor`,\n`artifact-check`, `review-plan`). In `pose validate` it takes a **path** and\nwrites a file (as do `--junit` and `--sarif`). Several gates have no machine\nchannel at all: `check`, `history-check`, `knowledge-check`, `skills-check`,\n`recurrence-check`, `lint-spec`, `index`, `state`.\n\n**The human output is already an API.** `pose report` parses `pose validate`'s\nprinted lines (`parseValidationLines`) to derive the recorded outcome. So text we\nrestyle can break an internal consumer. **144 assertions across 37 test files**\nmatch literal output text — both the safety net and the migration bill.\n\nThree persistence paths exist, and they carry different things — worth keeping\napart, because they size the evidence risk differently:\n\n| Path | What it stores | Exposed to a restyle? |\n|---|---|---|\n| `.pose/results/*.json` (validation result) | each check's own captured `Output` (tail, secrets redacted), outcome, duration, exit code | only if we change what we capture from the child, not how we print |\n| `.pose/reports/*.md` (Markdown report) | the subset `parseValidationLines` extracts from the printed run — commands and result lines | yes: directly coupled to the printed shape |\n| `.pose/reports/history/*.jsonl` | report metadata only (`reportRecord`: task, outcome, hash, change set…) — **no captured output** | no |\n\n**`pose validate` is the sharpest human gap.** It pipes every check's raw\nstdout/stderr straight to the terminal (`io.MultiWriter`), and prints **no\nper-check outcome line at all**: the outcome, duration and exit code exist only\nin the JSON and the report. A human watching it sees raw `go test` noise, then\n`Result: SUCCESS`. Nothing says which check is running, how many remain, or how\nlong any of them took — and these runs are minutes long.\n\n**Constraints that already apply.** `pose-cli-universal-help-and-subcommand-introspection`\nsettled: stdlib only, no CLI framework, bilingual parity, `-h`/`--help` exit 0.\nIts `help_catalog.go` is the precedent worth copying — one structured, bilingual\nsource of truth, with parity enforced by tests. Releases ship **linux, darwin\nand windows** (amd64 + arm64), so Windows console capability is in scope.\n\n## Categories\n\n### A. CLI Output Formatting — the mechanics\n\nColour, bold/dim, indentation, alignment, wrapping, tables.\n\n*Today:* none of it. Plain `Fprintf`, hand-spaced columns, no wrapping.\n\n*What it would contain:*\n\n- one indentation scale (findings indented under their subject, two spaces per\n  level) and one bullet/label shape;\n- alignment through `text/tabwriter` for every list command (`specs`,\n  `followups`, `usage`, `reports`, `release status`);\n- wrapping of prose to `min(terminal width, 100)`, and **never** of contract\n  lines (`Result:`, `name.field=value`, paths) — a wrapped path is a broken\n  path;\n- terminal width from `COLUMNS`, falling back to 80. Real width needs an ioctl\n  (`golang.org/x/sys` is already an indirect dependency; promoting it is a\n  decision, not a given);\n- colour applied by the writer at the edge, never baked into a message string.\n\n### B. CLI Output Styling — the identity\n\nA semantic palette, symbols, visual hierarchy.\n\n*Today:* accidental (five symbols in total), and no palette.\n\n*What it would contain:*\n\n- a closed semantic palette mapped to POSE's own vocabulary, not to ad-hoc\n  colours: `pass`, `fail`, `error`, `warning`, `skipped`, `info`, `hint`,\n  `path`, `identifier`, `muted`. POSE already has closed vocabularies for\n  severities and evidence classes; the palette should be a projection of them,\n  so a new finding severity cannot appear without a defined look;\n- a symbol set with an ASCII fallback profile (`✔/✖/!/-/→` → `[ok]/[x]/[!]/[-]/->`),\n  chosen by capability detection, not by guessing;\n- **colour is never the only carrier**: every state also says its word, so\n  `NO_COLOR`, pipes, screen readers and colour-blind readers lose nothing;\n- 4-bit ANSI as the baseline (dumb terminals, CI log viewers), 256-colour only\n  as an enhancement.\n\n### C. Terminal UX — the experience (the emphasis)\n\nMessages, progress, prompts, actionable errors, consistency.\n\n*Today:* the gates run silently for minutes behind raw child output; there is no\nelapsed time, no counter, no phase, no `--quiet`, no `--verbose`.\n\n*What it would contain:*\n\n**Progress for work that takes time** (`validate`, `release check`, the compat\ngate, `update`, `doctor`, `index` on large trees):\n\n- a **step model**: each unit of work is started, then resolved\n  (`pass|fail|skip|error`) with its duration. The renderer decides how that\n  looks;\n- in a TTY: a single repainting status line — spinner frame, current check,\n  counter, elapsed seconds — replaced in place by the resolved line;\n- outside a TTY: exactly one line per event, no repaint, no escapes. Same\n  information, greppable;\n- **no animation without a TTY**, and none when `--quiet`, `NO_COLOR`,\n  `TERM=dumb`, or when output is redirected.\n\nA sketch of what `pose validate` could look like in a TTY, with the child's\noutput captured rather than streamed:\n\n```\n  pose-mcp (go, mode=standard)\n  ⠹ test  go test -count=1 ./...            12s\n```\n\nresolving to:\n\n```\n  pose-mcp (go, mode=standard)\n  ✔ test        go test -count=1 ./...      18.4s\n  ✔ lint        gofmt -l .                   0.3s\n  ✖ typecheck   go vet ./...                 2.1s   exit 1\n      internal/cli/x.go:42: unreachable code\n      … 3 more lines — full output in .pose/results/validate.json\n\n  3 checks · 2 passed · 1 failed · 20.8s\n  Result: FAILURE (required check failed)\n```\n\nand, with no TTY, to the same facts one line at a time:\n\n```\n[module] pose-mcp (go, mode=standard)\n  -> test go test -count=1 ./...\n  <- test pass 18.4s\n  -> typecheck go vet ./...\n  <- typecheck fail 2.1s exit=1\nResult: FAILURE (required check failed)\n```\n\n**Failure output that is quiet on success.** The modern default for a runner is\nto capture a check's output and show it only when the check fails (with a tail,\nand a pointer to the full result file), leaving `--verbose` to stream\neverything. This is the single biggest change to how POSE *feels*, and also the\none with a real consequence: what the report captures as evidence changes shape.\n\n**Actionable errors.** POSE is already ahead here and does not exploit it: every\ndelivery-integrity finding carries `code`, `severity`, `path`, `message` and\n`remediation`, and the human channel flattens that into one line built by hand\nat each site. A rendered finding should read:\n\n```\n  ✖ action-mismatch  .pose/changelogs/unreleased/x.md\n      declared artifact action is absent from the attributed Git change sets\n      fix: correct the action or record the exact attributed revisions\n      docs: https://docs.harne8.com/POSE/cli/#artifact-check\n```\n\nThe same rule for the command's own failures: what happened, what POSE expected,\nand the exact next command. And one shape for every \"unknown flag\" and \"unknown\ncommand\" error, with a suggestion when the input is close to a real name.\n\n**Consistency across commands.** One verdict line, one summary block, one\ndiagnostics section, in the same order, for all 35 commands — so a reader who\nlearns `check` already knows how to read `surface-check`.\n\n### D. CLI Output Rendering — the architecture\n\nThe layer that turns structured data into terminal bytes.\n\n*Today:* there is none; every command formats its own strings.\n\n*What it would contain:*\n\n- a `cliout` package: a renderer holding the **capability profile** (is a TTY,\n  colour allowed, unicode allowed, width, locale) plus semantic emitters —\n  `Verdict`, `Finding`, `Step`, `Field`, `Table`, `Hint`, `Section`;\n- the rule that **data stays plain and decoration happens at the edge**: nothing\n  written to a file, a JSON document, a report or an evidence record ever\n  carries an escape sequence;\n- a **message catalog with IDs**, the way `help_catalog.go` already does it for\n  help: bilingual parity becomes a test rather than a promise, and each message\n  gains a stable identifier a machine can key on;\n- channel discipline as code: results and findings to stdout, progress and the\n  command's own failures to stderr, so `pose x --json | jq` is always safe;\n- a guard test that scans command sources for direct `fmt.Fprint*` calls with an\n  explicit allowlist — the mechanism POSE already uses to keep contracts from\n  eroding.\n\nThis is the part that needs an ADR, because it changes where every command's\noutput comes from, and because output is a consumed contract.\n\n### E. Rich Terminal Output — the optional depth\n\nTables, trees, panels, bars, syntax highlighting.\n\n*Today:* absent; plausible places already exist.\n\n*What it would contain:*\n\n- **trees** for the spec graph (`depends_on`), roadmaps and milestones, and for\n  the delivery-integrity graph's reverse lookups;\n- **tables** for `specs`, `followups`, `usage`, `release status`,\n  `adoption-metrics`;\n- **panels/summary blocks** for a release cut and for `doctor`;\n- **bars or sparklines** for DORA and adoption metrics;\n- **diff-style** rendering for drift (machinery manifest, vendored sources,\n  managed-manual merges), which is where a human currently reads a wall of\n  paths.\n\nEverything here is an enhancement, gated behind the capability profile, and none\nof it may appear in a line a machine parses.\n\n### F. Machine-readable vs human-readable — two channels\n\n*Today:* mixed. `--json` is boolean in most commands and a path in `validate`;\nseven gates have no machine channel; the human channel is parsed internally.\n\n*What it would contain:*\n\n- `--json` means **JSON on stdout**, everywhere, for every command that has a\n  result; `--json-out <path>` (plus the existing `--junit`, `--sarif`) writes a\n  file. `validate`'s current `--json <path>` stays as a deprecated alias,\n  because scripts and CI use it;\n- the machine document carries everything the human channel shows — including\n  each finding's `code`, `severity`, `remediation`, and each step's duration and\n  exit code — so nobody has to parse prose;\n- `--quiet`: the verdict and the exit code, nothing else;\n- a documented **exit-code contract** (0 success, 1 gate failure, 2 usage error)\n  — today's behaviour, written down and tested;\n- the internal consumers move first: `pose report` should read `validate`'s\n  structured result, not its prose, before the prose is allowed to change;\n- `NO_COLOR`, `POSE_COLOR=auto|always|never` (and `--color`), `POSE_LOCALE` —\n  all documented in the CLI reference and the manuals, which today mention none\n  of them.\n\n## Cross-cutting constraints\n\n1. **Output is a contract.** Internal parsers, CI greps, 144 test assertions and\n   agents read it. Sequence: identify the contract lines, give the consumers a\n   structured source, then restyle.\n2. **Evidence must stay clean.** No escape sequences in JSON, JUnit, SARIF or\n   reports. The exposure is uneven (see the table above): the Markdown report is\n   built from the printed run, so it moves with any restyle, while the validation\n   JSON only moves if we change what we capture from a child process, and the\n   history JSONL stores no output at all.\n3. **Determinism.** Same inputs, same bytes, with timings the only variable —\n   otherwise golden tests and reproducible reports suffer. Spinner frames never\n   reach a non-TTY.\n4. **No new dependencies**, per the help spec. Everything here is reachable with\n   stdlib (`text/tabwriter`, `os.Stdout.Stat()` for TTY detection); only real\n   terminal-size and Windows virtual-terminal enabling would want\n   `golang.org/x/sys`, already present as an indirect dependency.\n5. **Bilingual parity is a gate**, so every string doubles. A catalog makes that\n   testable; raising coverage from 28% to 100% (~820 sites) is a decision of its\n   own.\n6. **Windows is shipped.** Legacy consoles need virtual-terminal enabling and\n   may not render box drawing or emoji; the ASCII profile is not optional.\n7. **Accessibility.** Never colour alone; no meaning that exists only in a\n   repainted line; UTF-8 assumed only when detected.\n8. **Agents are first-class readers.** For them the plain profile plus `--json`\n   *is* the UX: a spinner is noise, an unstable line is a bug.\n\n## Candidate work, in dependency order\n\n| Phase | Work | Why it is where it is |\n|---|---|---|\n| 0 | Inventory the parsed contract: every line a consumer (internal, CI, tests) depends on, listed and pinned by golden tests | Nothing can be restyled safely before this exists |\n| 1 | `cliout` rendering layer: capability profile, semantic emitters, single severity vocabulary, channel rules, message catalog, guard test | Everything else is a consumer of this |\n| 2 | Human polish: one vocabulary, symbols with ASCII fallback, palette, tabwriter alignment, wrapping, summary blocks | Mechanical once the layer exists |\n| 3 | Long-running UX: step model, spinner + elapsed + counter in a TTY, per-check outcome lines everywhere, quiet-on-success with `--verbose` | Depends on the decision about who owns a check's output |\n| 4 | Machine channel: `--json` on stdout everywhere, `--json-out` for files, `--quiet`, exit-code contract, gates that have no JSON get it, internal parsers move to structured input | Must land before or with the restyle of the lines they parse |\n| 5 | Rich output: trees, panels, metric bars, drift diffs | Pure enhancement; last |\n\n## Decisions that need the maintainer\n\n1. **Quiet-on-success for `validate`?** Capturing a check's output instead of\n   streaming it is the biggest visible change, and it changes what reports\n   capture as evidence. Keep streaming, capture-and-summarise, or make it a\n   flag with a default to choose?\n2. **`--json` semantics.** Standardise on stdout and demote `validate --json <path>`\n   to a deprecated alias, or keep two spellings permanently?\n3. **Localisation scope.** Raise parity to 100% as part of this work, or hold\n   parity only for lines the work touches?\n4. **Blast radius.** All 35 commands, or the lifecycle core first (`check`,\n   `validate`, `artifact-check`, `surface-check`, `release`, `doctor`)?\n5. **Terminal size and Windows.** Promote `golang.org/x/sys` to a direct\n   dependency for real width and virtual-terminal enabling, or stay on\n   `COLUMNS` + 80 columns + an ASCII profile?\n\n## Next checks\n\n- None yet: this note is the input to a spec. Once the spec exists, its own\n  gates apply (`go test -count=1 ./...`, `pose check --strict`,\n  `pose validate --report`).\n\n## Risks\n\n- **Contract erosion**: restyling a line an internal parser reads\n  (`parseValidationLines`) or CI greps would break a gate silently. Mitigation:\n  phase 0 and phase 4 before phase 2.\n- **Test churn**: 144 literal-output assertions will move. They are also the\n  regression net, so they should be migrated deliberately, not regenerated\n  wholesale.\n- **Evidence noise**: the Markdown report is assembled from the printed run, so\n  restyling moves it; the validation JSON moves only if capture changes. Expected\n  either way, but it should land in one release, announced.\n- **Interleaving**: a spinner and a child process writing to the same terminal\n  corrupt each other. Whoever owns the child's output owns the spinner.\n- **Scope creep into a framework**: the goal is a thin renderer, not a TUI.\n  Panels and trees are last for that reason.\n\n## Next owner\n\n@pose-maintainers — the five decisions above, then the spec and the ADR for the\nrendering layer.\n\n## References\n\n- `pose-mcp/internal/cli/help_catalog.go` — the precedent: one structured,\n  bilingual source of truth with parity enforced by tests.\n- `.pose/specs/2026-08-21-pose-cli-universal-help-and-subcommand-introspection.md`\n  — stdlib only, no CLI framework, bilingual parity.\n- `pose-mcp/internal/cli/validate.go` — the streaming loop and the missing\n  per-check outcome line.\n- `pose-mcp/internal/cli/report.go` (`parseValidationLines`) — the internal\n  consumer of human output.\n- `pose-mcp/internal/pose/delivery_integrity.go` — findings already carry\n  `code`/`severity`/`message`/`remediation`; the human channel flattens them.\n- `docs-site/docs/cli.md` — the reference that would document `--json`,\n  `--quiet`, `POSE_COLOR`, `NO_COLOR` and `POSE_LOCALE`.\n---\ntype: decision-log\nslug: self-referential-policy-template-contamination\nowner: @pose-maintainers\nsensitivity: public-internal\ncreated_at: 2026-08-15\nlast_reviewed_at: 2026-08-15\nexpires_at: 2026-09-14\nsource_refs:\n  spec: \"\"\n  workflow: \"bugfix\"\n  commands: [\"go -C pose-mcp generate ./internal/scaffold\", \"go -C pose-mcp build ./...\", \"go -C pose-mcp vet ./...\", \"go -C pose-mcp test ./...\", \"gofmt -l pose-mcp\", \"cd mcp-enforce && go build ./... && go test ./...\"]\n  external_sources: [{url: \"https://github.com/oseiaspereira88/pose/issues/17\", accessed_at: \"2026-08-15\"}]\n---\n\n# decision-log: self-referential-policy-template-contamination\n\n## Context\n\nIssue #17 (reported against pose-mcp/pose CLI 1.2.0): `.pose/policy/delivery.json`\nand `.pose/policy/artifacts.json` on a target project seeded by `pose install`/\n`pose update --force` carried `roots`/`governed_roots` that were literal paths\ninto **pose-mcp's own source tree** (`pose-mcp/internal/cli`,\n`pose-mcp/internal/mcpserver`, `pose-mcp/internal/pose`, entrypoint\n`pose-mcp/cmd/pose/main.go`), not the target project's. Every delivery-integrity\nand artifact-contract finding for that project's own specs went silent — a\nfinished spec's `review bundle --seal` failed with \"no immutable attributed\nchange set exists\" because the graph never resolved a `DeliveryTarget` for\nthat project's own module paths.\n\nRoot cause: `pose-mcp/internal/scaffold/gen/main.go` syncs `.pose/policy/`\nwholesale into the embedded scaffold via `distpolicy.IncludedPoseSubtrees`,\nwhich listed `\"policy\"` with no per-file exception. `delivery.json`/\n`artifacts.json` are pose-dist's own dogfooding config (adopted 2026-08-03/04,\nclose to the 1.2.0 cut), not a generic template — the wholesale sync copied\nthis repository's live self-referential values into every downstream install.\n\nThis is the same disease as [[project-agnostic-assessment-evidence]] (2026-08-03,\n`pose-project-agnostic-assessment-engines`): pose-mcp's own identity leaking\ninto what an installed instance evaluates about a *different* project. That\nearlier fix scoped the assessment **engines** (discovery/integration/tech-debt\nscanners) to observed evidence under the authorized project root, with no\nhardcoded pose-dist/Harne8 names. It did not touch the scaffold **template**\npipeline (`internal/scaffold/gen`, `internal/scaffold/distpolicy`), which is a\nseparate mechanism carrying separate self-referential data (JSON policy\ncontent, not scanner logic) — the earlier fix's invariant (\"no hardcoded\nidentity from the producing repository\") was never extended there.\n\n## Current state\n\nFixed at the source, not just the symptom:\n\n- `distpolicy.SelfReferentialPolicyFiles` (`internal/scaffold/distpolicy/\n  distpolicy.go`) excludes `delivery.json`/`artifacts.json` from the wholesale\n  `.pose/policy` allowlist match in `IsIncluded`.\n- `distpolicy.NeutralPolicyTemplates()` is the single source of truth for what\n  ships instead: schema-valid, `enabled: false`, empty `roots`/\n  `governed_roots` — an explicit, obvious placeholder (issue #17's suggestion\n  (a)), not a silently-broken default. Both `gen/main.go` (writes it into the\n  embedded scaffold) and `scaffold_test.go` (asserts the embedded copy still\n  matches it) call the same function, so generator and drift guard cannot\n  diverge from each other the way the pre-existing `IncludedTopLevel`/\n  `IncludedPoseSubtrees` split was explicitly designed to prevent for\n  everything else.\n- `pose-mcp/internal/scaffold/dist/.pose/policy/{delivery,artifacts}.json`\n  regenerated via `go generate ./internal/scaffold`; drift test green.\n- `pose doctor` gained two detectable (not auto-fixable — the correct roots\n  are project-specific) findings, `policy.delivery-roots`/\n  `policy.artifact-roots`: warn when every configured root fails to resolve\n  on disk, naming issue #17 in the hint. This is the mitigation for instances\n  **already** contaminated by 1.2.0 before this fix — `pose install`/`update`\n  never overwrite an existing policy file, so the template fix alone cannot\n  self-heal a project that already seeded the bad content; the operator still\n  has to hand-edit the JSON, but doctor now tells them why and where.\n- Achado 2 of the same issue (pose_validate_approve unusable over stdio) was\n  already correctly documented in\n  `.pose/adr/2026-07-19-mcp-conductor-harness-trust-boundary-for-safe-validation-orchestration.md`\n  and `docs-site/docs/mcp.md`; the actual gap was a missing cross-reference\n  from the runtime error message and `mcp-enforce/README.md` to the already-\n  existing local alternative (`pose review attest`/`auto-attest`). Both now\n  name it explicitly.\n\nRegression coverage: `distpolicy_test.go` (new package, exclusion +\nschema-validity of the placeholder against the real `pose.LoadDeliveryPolicy`/\n`LoadArtifactPolicy` loaders), `scaffold_test.go` (drift guard special-cases\nthe two placeholder files instead of false-flagging them as \"extra\"),\n`doctor_remediation_test.go` (contaminated-roots detection and a\nno-false-positive case with genuinely-existing roots),\n`validate_orchestration_test.go` (stdio-specific approval diagnostic names\nboth the cause and the alternative).\n\n## Next checks\n\n- `pose validate --tolerant --module pose-mcp/internal/scaffold` and\n  `--module pose-mcp/internal/mcpserver` before closeout.\n- `pose check --strict` at release-closeout time, once this change is\n  committed and reported per the repo's provenance sequence (see\n  `[[pose-gate-closeout-procedure]]`-equivalent local convention: one commit,\n  `artifact-check`, `pose report`, `pose validate --json`, in that order).\n- Version bump to 1.2.1 and changelog entry referencing issue #17.\n\n## Risks\n\n- The `pose doctor` heuristic (all configured roots missing → warn) is\n  conservative by design: a project with a genuinely-legitimate root that\n  happens not to exist yet (e.g. a module not yet created) would only trigger\n  if *every* root in the file is currently missing. A partially-contaminated\n  file (some real, some inherited) will not be flagged — acceptable, since a\n  false negative there still leaves the existing delivery-integrity checks as\n  the backstop, and a false positive would train operators to ignore the hint.\n- Instances that ran `pose install`/`pose update --force` on 1.2.0 and already\n  have the contaminated files on disk are not auto-repaired by upgrading to\n  1.2.1 — only diagnosed. This is a deliberate scope boundary (`pose install`/\n  `update` never overwrite existing policy — a stronger invariant than this\n  bug), not an oversight; document it in the 1.2.1 changelog so operators\n  don't expect a silent fix.\n\n## Next owner\n\n`@pose-maintainers` — no open follow-up beyond the next checks above.\n\n## References\n\n- Issue: https://github.com/oseiaspereira88/pose/issues/17\n- Precedent: [[project-agnostic-assessment-evidence]]\n- ADR (achado 2 stdio boundary):\n  `.pose/adr/2026-07-19-mcp-conductor-harness-trust-boundary-for-safe-validation-orchestration.md`\n- Changed files: `pose-mcp/internal/scaffold/distpolicy/{distpolicy.go,distpolicy_test.go}`,\n  `pose-mcp/internal/scaffold/gen/main.go`,\n  `pose-mcp/internal/scaffold/scaffold_test.go`,\n  `pose-mcp/internal/scaffold/dist/.pose/policy/{delivery,artifacts}.json`,\n  `pose-mcp/internal/cli/doctor.go`, `pose-mcp/internal/cli/doctor_remediation_test.go`,\n  `pose-mcp/internal/mcpserver/server.go`,\n  `pose-mcp/internal/mcpserver/validate_orchestration_test.go`,\n  `mcp-enforce/README.md`.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/review-conclusions/rrn-a5f810837f976a64.json; sed -n '990,1020p' pose-mcp/internal/cli/validate.go; sed -n '1380,1458p' pose-mcp/internal/cli/validate.go; rg -n 'func.*Catalog|Adopted:|Adopt:' pose-mcp/internal/pose/capability_catalog.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/review-conclusions/rrn-a5f810837f976a64.json; sed -n '990,1020p' pose-mcp/internal/cli/validate.go; sed -n '1380,1458p' pose-mcp/internal/cli/validate.go; rg -n 'func.*Catalog|Adopted:|Adopt:' pose-mcp/internal/pose/capability_catalog.go\"","aggregated_output":"{\n  \"schema_version\": 1,\n  \"run_id\": \"rrn-a5f810837f976a64\",\n  \"bundle_id\": \"rvb-be78a77eab773e4e\",\n  \"scope\": \"spec:pose-adopt-request-shows-what-it-sets\",\n  \"state\": \"refused\",\n  \"decision\": \"approved\",\n  \"kind\": \"review\",\n  \"issuer\": \"b34-local-executor\",\n  \"reasons\": [\n    \"the run's cleanup is not confirmed complete\",\n    \"the run no longer governs: adapter cleanup incomplete\"\n  ],\n  \"concluded_at\": \"2026-11-14T21:24:23.401925466Z\"\n}\n\t}\n\tfor _, out := range []string{jsonOut, junitOut, sarifOut, planOut} {\n\t\tif out != \"\" && !confinedRelativePath(out) {\n\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: result output paths must remain inside the project.\", \"Erro: paths de saída de resultado devem permanecer dentro do projeto.\"))\n\t\t\treturn 2\n\t\t}\n\t}\n\tcanonicalResultsPath := \"\"\n\tif jsonOut != \"\" {\n\t\tcanonicalResultsPath = configuredDeliveryResultsPath(root)\n\t}\n\t// The report --report writes records this run, so it reads this run's own\n\t// output. It used to look for a pose-validate.latest.log that native\n\t// validation never writes, and every report said \"Fill manually\" and \"No\n\t// validation output detected\" under an outcome it could not support (spec\n\t// pose-validate-report-carries-its-run).\n\t// The report records this run from the run's own structured result, not\n\t// from its printed output (spec pose-cli-output-rendering-system R5).\n\t// Capturing stdout to re-parse it is what made every printed line a\n\t// contract.\n\tif stackFilter != \"\" && !map[string]bool{\"node\": true, \"go\": true, \"rust\": true, \"java\": true, \"python\": true, \"dotnet\": true, \"contract\": true}[stackFilter] {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid --stack: %s\\n\", \"Erro: --stack inválido: %s\\n\"), stackFilter)\n\t\treturn 2\n\t}\n\tif moduleFilter == \"..\" || strings.HasPrefix(moduleFilter, \"../\") || filepath.IsAbs(moduleFilter) {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --module must remain inside the project.\", \"Erro: --module deve permanecer dentro do projeto.\"))\n\t\treturn 2\n\t}\n\tmatrixPath := filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\")\n\traw, err := os.ReadFile(matrixPath)\n\tif err != nil {\n\t\t\tseverity = \"error\"\n\t\t}\n\t\tusageFindings = append(usageFindings, usageFinding{ID: check.ID, Severity: severity})\n\t}\n\tnoteUsageFindings(stdout, result, usageFindings, true)\n\tfor name, writer := range map[string]struct {\n\t\tpath  string\n\t\twrite func(string, validationRunResult) error\n\t}{\n\t\t\"json\":  {jsonOut, writeValidationJSON},\n\t\t\"junit\": {junitOut, writeValidationJUnit},\n\t\t\"sarif\": {sarifOut, writeValidationSARIF},\n\t} {\n\t\tif writer.path == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\ttarget := filepath.Join(root, filepath.FromSlash(writer.path))\n\t\tif name == \"json\" && canonicalResultsPath != \"\" && normalizeValidationOutputPath(writer.path) == canonicalResultsPath {\n\t\t\terr := publishCanonicalValidationJSONIn(store, writer.path, canonicalResultsPath, run)\n\t\t\tif err != nil {\n\t\t\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n\t\t\t\t\tout := render(stdout, stderr)\n\t\t\t\t\tout.ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n\t\t\t\t\tout.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"validation-result-durability\",\n\t\t\t\t\t\tMessage: fmt.Sprintf(\"%s result was published but durability is unconfirmed: %v\", name, err)})\n\t\t\t\t\treturn 1\n\t\t\t\t}\n\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(cliText(locale, \"writing %s result: %v\", \"escrevendo resultado %s: %v\"), name, err))\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\trender(stdout, stderr).ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n\t\t\tcontinue\n\t\t}\n\t\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: creating %s result directory: %v\\n\", \"Erro: criando diretório do resultado %s: %v\\n\"), name, err)\n\t\t\treturn 1\n\t\t}\n\t\tif err := writer.write(target, run); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: writing %s result: %v\\n\", \"Erro: escrevendo resultado %s: %v\\n\"), name, err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"%s: %s\\n\", name, target)\n\t}\n\tif planOut != \"\" {\n\t\tdigest := sha256.Sum256(raw)\n\t\thead := \"\"\n\t\tif out, err := posemodel.RawHistoryGit(root, \"rev-parse\", \"HEAD\").Output(); err == nil {\n\t\t\thead = strings.TrimSpace(string(out))\n\t\t}\n\t\tplan := executionPlan{\n\t\t\tSchemaVersion: validationResultSchema,\n\t\t\tGeneratedAt:   run.GeneratedAt,\n\t\t\tProjectID:     posemodel.DefaultProjectID(root),\n\t\t\tSpec:          reportTask,\n\t\t\tGitHead:       head,\n\t\t\tMatrixSHA256:  hex.EncodeToString(digest[:]),\n\t\t\tChecks:        isolationChecks,\n\t\t\tApproval:      planApproval{Required: true},\n\t\t}\n\t\tif plan.Checks == nil {\n\t\t\tplan.Checks = []checkResult{}\n\t\t}\n\t\ttarget := filepath.Join(root, filepath.FromSlash(planOut))\n\t\tif err := writeExecutionPlan(target, plan); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: writing execution plan: %v\\n\", \"Erro: escrevendo plano de execução: %v\\n\"), err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"plan: %s (%d isolated check(s); approval required before Harness execution)\\n\", target, len(plan.Checks))\n\t}\n\tif autoReport {\n\t\tif reportTask == \"\" {\n\t\t\treportTask = \"validate-native\"\n\t\t}\n\t\treportArgs := []string{\"--task\", reportTask, \"--context\", \"auto-validate\", \"--validation-profile\", mode}\n\t\t// The outcome travels inside the summary, so it stays derived rather\n\t\t// than being recorded as a manual assertion.\n\t\t_ = runReportWith(root, reportArgs, nil, validationSummaryOf(run), io.Discard, stderr)\n\t}\n\tif failures > 0 {\n202:func governedEntry(c GovernedCapability, introduced, effect string, implies ...string) CatalogEntry {\n205:\t\tAdopt:   func(docs PolicyDocs, date string) []string { return AdoptGovernedCapability(docs.Review, c, date) },\n207:\t\tAdopted: func(docs PolicyDocs) bool { return GovernedCapabilityAdopted(docs.Review, c) },\n211:func overlayEntry(name, introduced, effect string) CatalogEntry {\n221:\t\tAdopt: func(docs PolicyDocs, date string) []string {\n238:\t\tAdopted: func(docs PolicyDocs) bool {\n264:func catalogEntries() []CatalogEntry {\n284:\t\t\tAdopt:   func(docs PolicyDocs, _ string) []string { return setBool(docs.Review, \"allow_criterion_reuse\", true) },\n286:\t\t\tAdopted: func(docs PolicyDocs) bool { v, _ := docs.Review[\"allow_criterion_reuse\"].(bool); return v },\n291:\t\t\tAdopt: func(docs PolicyDocs, date string) []string {\n308:\t\t\tAdopted: func(docs PolicyDocs) bool { v, _ := docs.DoR[\"adopted_at\"].(string); return v != \"\" },\n319:\t\t\tAdopt: func(docs PolicyDocs, _ string) []string {\n343:\t\t\tAdopted: func(docs PolicyDocs) bool { return intKeyIs(docs, \"qualified_artifact_refs_version\", 1) },\n348:\t\t\tAdopt: func(docs PolicyDocs, _ string) []string {\n370:\t\t\tAdopted: func(docs PolicyDocs) bool { return intKeyIs(docs, \"spec_authority_transfer_version\", 1) },\n387:\t\t\tAdopt: func(docs PolicyDocs, _ string) []string {\n391:\t\t\tAdopted: func(docs PolicyDocs) bool { v, _ := docs.Review[\"require_signed_attestations\"].(bool); return v },\n410:\t\t\tAdopt: func(docs PolicyDocs, _ string) []string {\n440:\t\t\tAdopted: func(docs PolicyDocs) bool {\n467:func CapabilityCatalog() []CatalogEntry { return catalogEntries() }\n470:func LookupCatalogEntry(id string) (CatalogEntry, bool) {\n480:func CatalogIDs() []string {\n489:func CatalogAdoptBlockerIn(files Files, root string, docs PolicyDocs, entry CatalogEntry) string {\n503:func CatalogAdoptBlocker(root string, docs PolicyDocs, entry CatalogEntry) string {\n508:func CatalogRetireBlocker(docs PolicyDocs, entry CatalogEntry) string {\n832:func closeoutReviewPolicyCatalogEntry() CatalogEntry {\n836:\t\tAdopt: func(docs PolicyDocs, _ string) []string {\n845:\t\tAdopted:       func(docs PolicyDocs) bool { return closeoutPairPresent(docs) },\n","exit_code":0,"status":"completed"}}
