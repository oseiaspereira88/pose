, count, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"budget exhausted: %d attempt(s) of %s on this bundle, at most %d\", count, plan.Adapter, effectiveReviewMaxRuns(plan.Config)))\n   413\t\t}\n   414\t\tif completed && strings.TrimSpace(plan.Reason) == \"\" {\n   415\t\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n   416\t\t}\n   417\t\treturn attempts, count, nil\n   418\t}\n   419\t\n   420\t// prepareDelegatedReviewAttempt admits and builds the next reservation of\n   421\t// the bundle without publishing it.\n   422\tfunc (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n   423\t\tattempts, _, err := s.reviewAttemptAdmission(plan)\n   424\t\tif err != nil {\n   425\t\t\treturn DelegatedReviewAttempt{}, err\n   426\t\t}\n   427\t\tnonce := make([]byte, 16)\n   428\t\tif _, err := rand.Read(nonce); err != nil {\n   429\t\t\treturn DelegatedReviewAttempt{}, err\n   430\t\t}\n   431\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n   432\t\ta.AttemptID = attemptIdentity(a)\n   433\t\treturn a, nil\n   434\t}\n   435\t\n   436\t// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n   437\t// marks the attempt active first, so a dispatch that ends after this point\n   438\t// always leaves a marker that turns stalled and that `pose delegate cancel`\n   439\t// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n   440\t// review round 1, N1).\n11-\t\"fmt\"\n12-\t\"sort\"\n13-\t\"strings\"\n14-\t\"time\"\n15-)\n16-\n17-// DelegationAttempt is one attempt and its continuations.\n18-type DelegationAttempt struct {\n19-\tAttemptID    string              `json:\"attempt_id\"`\n20-\tRuns         []string            `json:\"runs\"`\n21:\tLatestRun    string              `json:\"latest_run,omitempty\"`\n22-\tState        string              `json:\"state\"`\n23-\tPurpose      string              `json:\"purpose\"`\n24-\tAgent        string              `json:\"agent\"`\n25-\tVendor       string              `json:\"vendor,omitempty\"`\n26-\tModel        string              `json:\"model,omitempty\"`\n27-\tLabel        string              `json:\"label,omitempty\"`\n28-\tLead         string              `json:\"lead,omitempty\"`\n29-\tAccess       string              `json:\"access\"`\n30-\tScope        string              `json:\"scope\"`\n31-\tBundleID     string              `json:\"bundle_id\"`\n--\n116-\t\t\t\t}\n117-\t\t\t}\n118-\t\t\tif len(events) > 0 {\n119-\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n120-\t\t\t}\n121-\t\t}\n122-\t}\n123-\tfor _, key := range order {\n124-\t\trow := byAttempt[key]\n125-\t\tlatest := row.latest\n126:\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n127-\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n128-\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n129-\t\tif latest.Access != \"\" {\n130-\t\t\trow.Access = latest.Access\n131-\t\t}\n132-\t\trow.Round = latest.Round\n133-\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n134-\t\t\trow.HookFailure = hook.Failure\n135-\t\t}\n136-\t\tif row.Purpose == \"\" {\n--\n163-\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n164-\t\tif marker.Round > 0 {\n165-\t\t\trow.Round = marker.Round\n166-