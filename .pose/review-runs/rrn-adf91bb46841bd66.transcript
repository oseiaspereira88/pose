{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_active.go | sed -n '236,286p'\"","aggregated_output":"   236\t// ListDelegationActive reads the markers with the liveness of their owners,\n   237\t// and returns as losses the markers it cannot read: a run it cannot observe is\n   238\t// reported, never listed as running nor left out in silence.\n   239\tfunc (s Store) ListDelegationActive() ([]DelegationActiveRun, []string, error) {\n   240\t\tdir, err := s.delegationActiveDir(false)\n   241\t\tif errors.Is(err, os.ErrNotExist) {\n   242\t\t\treturn []DelegationActiveRun{}, nil, nil\n   243\t\t}\n   244\t\tif err != nil {\n   245\t\t\treturn nil, nil, err\n   246\t\t}\n   247\t\tentries, err := os.ReadDir(dir)\n   248\t\tif err != nil {\n   249\t\t\treturn nil, nil, err\n   250\t\t}\n   251\t\tout := []DelegationActiveRun{}\n   252\t\tvar lost []string\n   253\t\tfor _, e := range entries {\n   254\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   255\t\t\t\tcontinue\n   256\t\t\t}\n   257\t\t\traw, err := readLedgerRaw(filepath.Join(dir, e.Name()))\n   258\t\t\tif errors.Is(err, os.ErrNotExist) {\n   259\t\t\t\tcontinue // the run ended between the listing and the read\n   260\t\t\t}\n   261\t\t\tif err != nil {\n   262\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" could not be read: \"+err.Error())\n   263\t\t\t\tcontinue\n   264\t\t\t}\n   265\t\t\tvar marker DelegationActiveRun\n   266\t\t\tif json.Unmarshal(raw, &marker) != nil || marker.SchemaVersion != 1 || marker.AttemptID+\".json\" != e.Name() || !validRunToken(marker.RunToken) {\n   267\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" is not one this engine reads\")\n   268\t\t\t\tcontinue\n   269\t\t\t}\n   270\t\t\tmarker.Liveness, marker.Detail = probeStartLockOwner(marker.Owner)\n   271\t\t\tmarker.StalledAt = readDelegationStall(dir, marker)\n   272\t\t\tif marker.StalledAt == \"\" && delegationMarkerSilent(marker, time.Now()) && marker.Liveness == LockOwnerDead {\n   273\t\t\t\tmarker.StalledAt = recordDelegationStall(dir, marker)\n   274\t\t\t}\n   275\t\t\tif _, err := os.Lstat(cancelRequestPath(dir, marker)); err == nil {\n   276\t\t\t\tmarker.CancelRequested = true\n   277\t\t\t}\n   278\t\t\tout = append(out, marker)\n   279\t\t}\n   280\t\tsort.Slice(out, func(i, j int) bool {\n   281\t\t\treturn out[i].StartedAt < out[j].StartedAt || out[i].StartedAt == out[j].StartedAt && out[i].AttemptID < out[j].AttemptID\n   282\t\t})\n   283\t\treturn out, lost, nil\n   284\t}\n   285\t\n   286\t// ErrDelegationNotActive means no running run matches.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/delegate.go | sed -n '590,720p'\"","aggregated_output":"   590\t\t}\n   591\t\tif delegateSupervised() {\n   592\t\t\tplan.OnStart = supervisorHandback()\n   593\t\t}\n   594\t\t// The containment the run will run under is disclosed before it runs, as\n   595\t\t// pose review dispatch disclosed it (spec pose-delegation-parity-gate R6;\n   596\t\t// review round 1, PG-R1-08); the JSON document carries it with the run.\n   597\t\tif safety, _ := posemodel.ResolveReviewerContainment(plan.Config); safety != nil && !f.jsonOut {\n   598\t\t\traw, _ := json.Marshal(safety)\n   599\t\t\trender(stdout, stderr).Field(\"delegate.safety\", string(raw))\n   600\t\t}\n   601\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n   602\t\thandBackExisting(run, err)\n   603\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n   604\t\tif request != nil {\n   605\t\t\tdelegateFulfilRequest(store, *request, run, err, stdout, stderr)\n   606\t\t}\n   607\t\tdelegateTerminalHook(store, run, err, stdout, stderr, purpose)\n   608\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, purpose, run, err, delegateRunNextActions(store, run, err)...)\n   609\t\tif err == nil && !f.jsonOut && !delegateSupervised() {\n   610\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n   611\t\t\t\treturn next\n   612\t\t\t}\n   613\t\t}\n   614\t\treturn code\n   615\t}\n   616\t\n   617\t// delegateNoAgentWithBrief refuses a review-path run no agent can take and\n   618\t// hands over the brief a reviewer would receive, so the review can still be\n   619\t// run by hand, as pose review dispatch did (spec pose-delegation-parity-gate\n   620\t// R6; review round 1, PG-R1-06).\n   621\tfunc delegateNoAgentWithBrief(store posemodel.Store, ref, kind, notes string, f delegateFlags, command string, stdout, stderr io.Writer) int {\n   622\t\tplan, _ := store.PlanReviewDispatch(ref, kind, notes, \"\", f.reason)\n   623\t\tbrief := plan.Brief.Text\n   624\t\tif brief == \"\" {\n   625\t\t\treturn delegateNoAgent(stdout, stderr, f.jsonOut, command)\n   626\t\t}\n   627\t\tif f.jsonOut {\n   628\t\t\tdoc := map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": strings.TrimPrefix(posemodel.ErrNoReviewerAdapter.Error(), \"pose: \"),\n   629\t\t\t\t\"brief\": brief, \"brief_digest\": plan.Brief.Digest}\n   630\t\t\tif code := posemodel.DelegationReasonCode(posemodel.ErrNoReviewerAdapter); code != \"\" {\n   631\t\t\t\tdoc[\"reason_code\"] = code\n   632\t\t\t}\n   633\t\t\thandBackRefusal(doc, 1)\n   634\t\t\twriteDelegateJSON(stdout, doc)\n   635\t\t\treturn 1\n   636\t\t}\n   637\t\tcode := delegateNoAgent(stdout, stderr, false, command)\n   638\t\tout := render(stdout, stderr)\n   639\t\tout.Hint(tr(\"The brief a reviewer would receive follows.\", \"O brief que um revisor receberia vem a seguir.\"))\n   640\t\tout.ContractLine(strings.TrimRight(brief, \"\\n\"))\n   641\t\treturn code\n   642\t}\n   643\t\n   644\tfunc delegateNoAgent(stdout, stderr io.Writer, jsonOut bool, command string) int {\n   645\t\t// The document keeps the typed refusal and no example: the example is\n   646\t\t// for a person reading the terminal (spec pose-delegation-mcp R5, R7).\n   647\t\tif jsonOut {\n   648\t\t\treturn delegateFail(stdout, stderr, true, command, 1, posemodel.ErrNoReviewerAdapter)\n   649\t\t}\n   650\t\texample, _ := posemodel.CanonicalDelegationPolicy(posemodel.ExampleDelegationPolicy())\n   651\t\terr := errors.New(tr(\"no agent is configured; add .pose/policy/delegation.json, for example:\\n\", \"nenhum agente configurado; adicione .pose/policy/delegation.json, por exemplo:\\n\") + string(example))\n   652\t\treturn delegateFail(stdout, stderr, jsonOut, command, 1, err)\n   653\t}\n   654\t\n   655\t// delegateGivenRoot checks the root a caller names: an absolute directory\n   656\t// holding a POSE instance.\n   657\tfunc delegateGivenRoot(root string) (string, error) {\n   658\t\tif !filepath.IsAbs(root) {\n   659\t\t\treturn \"\", errors.New(posemodel.DelegateRootEnv + \" must be an absolute path\")\n   660\t\t}\n   661\t\tif info, err := os.Stat(filepath.Join(root, \".pose\")); err != nil || !info.IsDir() {\n   662\t\t\treturn \"\", errors.New(posemodel.DelegateRootEnv + \" names no POSE instance\")\n   663\t\t}\n   664\t\treturn filepath.Clean(root), nil\n   665\t}\n   666\t\n   667\t// delegateTerminalHook runs the policy's on_terminal hook once the run is\n   668\t// recorded, and says so when it failed; the run's state does not change (R7).\n   669\tfunc delegateTerminalHook(store posemodel.Store, run posemodel.ReviewRun, err error, stdout, stderr io.Writer, command string) {\n   670\t\tif err != nil || run.RunID == \"\" {\n   671\t\t\treturn\n   672\t\t}\n   673\t\tif outcome := store.RunDelegationTerminalHook(run); outcome != nil && outcome.Failure != \"\" {\n   674\t\t\trender(stdout, stderr).Hint(\"pose delegate \" + command + \": on_terminal: \" + outcome.Failure)\n   675\t\t}\n   676\t}\n   677\t\n   678\t// routeSummary renders a routing decision for a person: the step chosen and\n   679\t// each agent skipped with its reason.\n   680\tfunc routeSummary(route *posemodel.DelegationRoutingRecord) string {\n   681\t\ttext := \"step=\" + route.Step\n   682\t\tif route.WaitUntil != \"\" {\n   683\t\t\ttext += \" wait_until=\" + route.WaitUntil\n   684\t\t}\n   685\t\tfor _, c := range route.Candidates {\n   686\t\t\tif c.Skipped != \"\" {\n   687\t\t\t\ttext += \"; \" + c.Agent + \" \" + tr(\"skipped\", \"ignorado\") + \": \" + c.Skipped\n   688\t\t\t}\n   689\t\t}\n   690\t\treturn text\n   691\t}\n   692\t\n   693\t// redactArgv hides the values of the credentials an agent is authorized to\n   694\t// receive, wherever a template carries them (security of R12).\n   695\tfunc redactArgv(argv []string, config posemodel.ReviewerAdapter) []string {\n   696\t\tout := append([]string(nil), argv...)\n   697\t\tif config.Containment == nil {\n   698\t\t\treturn out\n   699\t\t}\n   700\t\t// One pass, the longest value first: a credential that contains another\n   701\t\t// is replaced whole, whatever order the policy lists them in, and a\n   702\t\t// replacement is never scanned again (review round 3 of\n   703\t\t// pose-delegation-task, R3-B1).\n   704\t\tvar values []string\n   705\t\tfor _, name := range config.Containment.Credentials {\n   706\t\t\tif value := os.Getenv(name); len(value) >= 4 {\n   707\t\t\t\tvalues = append(values, value)\n   708\t\t\t}\n   709\t\t}\n   710\t\tsort.Slice(values, func(i, j int) bool { return len(values[i]) > len(values[j]) })\n   711\t\tpairs := make([]string, 0, 2*len(values))\n   712\t\tfor _, value := range values {\n   713\t\t\tpairs = append(pairs, value, \"[credential]\")\n   714\t\t}\n   715\t\tif len(pairs) == 0 {\n   716\t\t\treturn out\n   717\t\t}\n   718\t\treplacer := strings.NewReplacer(pairs...)\n   719\t\tfor i := range out {\n   720\t\t\tout[i] = replacer.Replace(out[i])\n","exit_code":0,"status":"completed"}}
