{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '161,310p'\"","aggregated_output":"   161\t\n   162\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   163\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   164\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   165\t\tif err != nil {\n   166\t\t\treturn ReviewRun{}, false, err\n   167\t\t}\n   168\t\tif len(lost) > 0 {\n   169\t\t\t// An unreadable run may be this release's: the history is unknown,\n   170\t\t\t// and the release does not write another (review round 4, N3).\n   171\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   172\t\t}\n   173\t\tvar latest *ReviewRun\n   174\t\tfor i := range runs {\n   175\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   176\t\t\t\tlatest = &runs[i]\n   177\t\t\t}\n   178\t\t}\n   179\t\tif latest == nil {\n   180\t\t\treturn ReviewRun{}, false, nil\n   181\t\t}\n   182\t\treturn *latest, true, nil\n   183\t}\n   184\t\n   185\t// orphanReservations lists the reservations left without a receipt or a\n   186\t// marker, older than reviewOrphanReservationAge, and\n   187\t// says which reservations or receipts it could not read (review round 3, N3).\n   188\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   189\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   190\t\tdirs, err := os.ReadDir(base)\n   191\t\tif errors.Is(err, os.ErrNotExist) {\n   192\t\t\treturn nil, nil, nil\n   193\t\t}\n   194\t\tif err != nil {\n   195\t\t\treturn nil, nil, err\n   196\t\t}\n   197\t\tmarkers, _, err := s.ListDelegationActive()\n   198\t\tif err != nil {\n   199\t\t\treturn nil, nil, err\n   200\t\t}\n   201\t\tmarked := map[string]bool{}\n   202\t\tfor _, m := range markers {\n   203\t\t\tmarked[m.AttemptID] = true\n   204\t\t}\n   205\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   206\t\tif err != nil {\n   207\t\t\treturn nil, nil, err\n   208\t\t}\n   209\t\tif len(runLost) > 0 {\n   210\t\t\t// Without the whole run history nothing is known to have no run.\n   211\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   212\t\t}\n   213\t\t// A recorded run does not finish an attempt, its receipt does: a\n   214\t\t// reservation whose run was recorded without a receipt still blocks and\n   215\t\t// is released with that run (review round 5, N3).\n   216\t\t_ = runs\n   217\t\tvar out []DelegatedReviewAttempt\n   218\t\tvar lost []string\n   219\t\tbudget := reviewReadBudget(nil)\n   220\t\tfor _, d := range dirs {\n   221\t\t\tif !d.IsDir() {\n   222\t\t\t\tcontinue\n   223\t\t\t}\n   224\t\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n   225\t\t\tif err != nil {\n   226\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   227\t\t\t\tcontinue\n   228\t\t\t}\n   229\t\t\tfor _, e := range entries {\n   230\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   231\t\t\t\t\tcontinue\n   232\t\t\t\t}\n   233\t\t\t\tvar a DelegatedReviewAttempt\n   234\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   235\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   236\t\t\t\t\tcontinue\n   237\t\t\t\t}\n   238\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   239\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   240\t\t\t\t\tcontinue\n   241\t\t\t\t}\n   242\t\t\t\tif marked[a.AttemptID] {\n   243\t\t\t\t\tcontinue\n   244\t\t\t\t}\n   245\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   246\t\t\t\t\tcontinue\n   247\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   248\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   249\t\t\t\t\tcontinue\n   250\t\t\t\t}\n   251\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   252\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   253\t\t\t\t\tcontinue\n   254\t\t\t\t}\n   255\t\t\t\tout = append(out, a)\n   256\t\t\t}\n   257\t\t}\n   258\t\treturn out, lost, nil\n   259\t}\n   260\t\n   261\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   262\t\tdir, err := s.delegationActiveDir(false)\n   263\t\tif err != nil {\n   264\t\t\treturn err\n   265\t\t}\n   266\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   267\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   268\t\t\t\treturn err\n   269\t\t\t}\n   270\t\t}\n   271\t\treturn nil\n   272\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '1,160p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"os\"\n    28\t\t\"path/filepath\"\n    29\t\t\"strings\"\n    30\t\t\"time\"\n    31\t)\n    32\t\n    33\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    34\t// proven abandoned.\n    35\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    36\t\n    37\t// reviewOrphanReservationAge is how old a reservation without any marker\n    38\t// must be to count as abandoned.\n    39\tconst reviewOrphanReservationAge = 10 * time.Minute\n    40\t\n    41\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    42\t// dispatch ended before recording it, and removes its stalled marker. A\n    43\t// stalled marker whose reservation was never published is only removed; the\n    44\t// returned run is then empty.\n    45\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    46\t\tif !validAttemptFileName(attemptID) {\n    47\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    48\t\t}\n    49\t\tmarkers, _, err := s.ListDelegationActive()\n    50\t\tif err != nil {\n    51\t\t\treturn ReviewRun{}, err\n    52\t\t}\n    53\t\tvar marker *DelegationActiveRun\n    54\t\tfor i := range markers {\n    55\t\t\tif markers[i].AttemptID == attemptID {\n    56\t\t\t\tmarker = &markers[i]\n    57\t\t\t}\n    58\t\t}\n    59\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    60\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    61\t\t}\n    62\t\tdir, err := s.delegationActiveDir(true)\n    63\t\tif err != nil {\n    64\t\t\treturn ReviewRun{}, err\n    65\t\t}\n    66\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    67\t\tif err != nil {\n    68\t\t\treturn ReviewRun{}, err\n    69\t\t}\n    70\t\tdefer lock.Close()\n    71\t\tunlock, err := lockSpecTransferFile(lock)\n    72\t\tif err != nil {\n    73\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    74\t\t}\n    75\t\tdefer unlock()\n    76\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    77\t}\n    78\t\n    79\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    80\t\tvar reserved *DelegatedReviewAttempt\n    81\t\tif marker != nil {\n    82\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    83\t\t\tif err != nil {\n    84\t\t\t\treturn ReviewRun{}, err\n    85\t\t\t}\n    86\t\t\tfor i := range attempts {\n    87\t\t\t\tif attempts[i].AttemptID == attemptID {\n    88\t\t\t\t\treserved = &attempts[i]\n    89\t\t\t\t}\n    90\t\t\t}\n    91\t\t\tif reserved == nil {\n    92\t\t\t\t// The dispatch ended between its marker and its reservation:\n    93\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    94\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    95\t\t\t}\n    96\t\t} else {\n    97\t\t\tif !operatorConfirmed {\n    98\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n    99\t\t\t}\n   100\t\t\torphans, _, err := s.orphanReservations(now)\n   101\t\t\tif err != nil {\n   102\t\t\t\treturn ReviewRun{}, err\n   103\t\t\t}\n   104\t\t\tfor i := range orphans {\n   105\t\t\t\tif orphans[i].AttemptID == attemptID {\n   106\t\t\t\t\treserved = &orphans[i]\n   107\t\t\t\t}\n   108\t\t\t}\n   109\t\t\tif reserved == nil {\n   110\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   111\t\t\t}\n   112\t\t}\n   113\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   114\t\t\t// A release that stopped after the receipt completes by removing\n   115\t\t\t// the stalled marker; with no marker there is nothing to release.\n   116\t\t\tif marker != nil {\n   117\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   118\t\t\t\tif err != nil {\n   119\t\t\t\t\treturn ReviewRun{}, err\n   120\t\t\t\t}\n   121\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   122\t\t\t\tif err != nil {\n   123\t\t\t\t\treturn ReviewRun{}, err\n   124\t\t\t\t}\n   125\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   126\t\t\t}\n   127\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   128\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   129\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   130\t\t}\n   131\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   132\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   133\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   134\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   135\t\tif marker != nil {\n   136\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   137\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   138\t\t} else {\n   139\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   140\t\t}\n   141\t\t// A run the attempt already recorded, by its dispatch or by a release\n   142\t\t// interrupted before the receipt, completes the attempt; no second run\n   143\t\t// is written for it.\n   144\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   145\t\tif err != nil {\n   146\t\t\treturn ReviewRun{}, err\n   147\t\t}\n   148\t\tif !found {\n   149\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   150\t\t\t\treturn ReviewRun{}, err\n   151\t\t\t}\n   152\t\t}\n   153\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   154\t\t\treturn recorded, err\n   155\t\t}\n   156\t\tif marker != nil {\n   157\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   158\t\t}\n   159\t\treturn recorded, nil\n   160\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc '\"$POSE_REVIEW_CLI\" surface-check --spec pose-review-run-reaps-lingering-reviewer-processes --strict'","aggregated_output":"surface.spec=pose-review-run-reaps-lingering-reviewer-processes\nsurface.targets=1\nsurface.results=236\nsurface.findings=0\nsurface.provenance_digest=sha256:4c601ce37ba81c9939185a87e8cc58bb5090fb3faeabef29ee2c1fd161fbffa7\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"agent_message","text":"The design assessment found no structural deltas. The integration scan reports three unobserved HTTP consumers, which appear unrelated to this scoped CLI/process change; tech-debt scanning also reports incomplete reads for two unrelated specs. The required artifact check is still running, so I’m waiting for its final status before interpreting its output."}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/usr/bin/bash -lc 'git diff --unified=12 ddb770352f35f2f55c740e9a8479686de3a251e..3e5b35f910b509d27c6591f286fed7ead46b827c -- pose-mcp/internal/pose/review_brief.go POSE.md locales/pt-BR/POSE.md pose-mcp/internal/cli/help_catalog.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/usr/bin/bash -lc 'git diff --unified=12 ddb770352f35f2f55c740e9a8479686de3a251e..3e5b35f910b509d27c6591f286fed7ead46b827c -- pose-mcp/internal/pose/review_brief.go POSE.md locales/pt-BR/POSE.md pose-mcp/internal/cli/help_catalog.go'","aggregated_output":"diff --git a/POSE.md b/POSE.md\nindex 061d04fb..4c231215 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -411,25 +411,25 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `history-check` — verifies every `.jsonl` under `reports/history/` is git-tracked. Without that, `recurrence-check` and `stats` diverge between machines. Strict blocks; tolerant warns.\n - `suggest` — reads [`task-map.json`](.pose/indexes/task-map.json) and prints the canonical trail (workflow + skill + rules + spec/ADR + knowledge) for a task type. With no arguments it lists every type. `--domain <d>` adds domain rules (frontend, backend-go, k8s); `--path <p>` infers the domain heuristically and via [`repo-map.json`](.pose/indexes/repo-map.json) (`language` → frontend/backend-go); `--json` for agents. Domains (spec `pose-distributed-instructions-parity`): `--domain` and the domain inferred from `--path` go through one taxonomy (`go`/`golang`/`backend-go` → `backend-go`; `react`/`frontend-react`/`frontend` → `frontend`; `kubernetes`/`helm`/`k8s` → `k8s`), the JSON discloses `domain_input` and `domain_source: alias`, and a domain the task map has no rules for is reported (`domain_status`) instead of borrowing another's; a `backend` module is the Go domain only when its language is Go. `rules_status` (and the human output) says for each rule whether it is `installed` (with its path), `extension-needed` (with `pose extension install <id>`) or `unavailable`; suggest announces no rule file that is not on disk and installs nothing.\n - `stats` — aggregates history JSONL outcomes by workflow, task or context. Enables objective decisions (promoting a check from optional to required, spotting unstable workflows, comparing ci against manual). `--since-days N` filters the window; `--json` for machine consumption.\n - `stats governance` — schema 2 read-only projection over report history, sealed review bundles, attestations and explicit remediation declarations. It keeps preparation, judgment, intervention, freshness, telemetry, provenance and coverage independent, never emits a quality score, and reports missing/invalid data explicitly. `--report-type` filters validation attempts; `--band` filters reviews and finding links. Replay identity is `(report_type, task_slug, sequence)`; identity-less rows remain visible in coverage. MCP `pose_governance_stats` accepts the same selectors and requires `project_id` when choosing a federated root. Explicit finding links contain only opaque IDs, spec slugs, category and source band, with at most 100 rows and truncation reported.\n - `stats governance --waits --rework` (spec `pose-governance-wait-rework-observability`) — two more dimensions beside the outcomes, never folded into a score. With `--waits` or `--rework` only the requested dimensions are computed; `--outcomes` adds the outcomes, which read the whole history. `--waits` times action requests and keeps three measures apart: the age of each request, the interval attributed to waiting on an actor or an external system, and `known_blocking_seconds`, the union per spec of intervals in which a request restricted the whole spec's execution (simultaneous requests count once). None of them is inactivity; missing timestamps are counted as unknown. `--rework` classifies superseded sealed bundles by what changed (subject, intent or plan, review plan, evidence, or unknown) and extra attestations on one bundle by review disagreement or an earlier attestation invalid against today's policy, leaving other causes unknown. `scripts/bench-governance.sh [runs] [pose-binary]` times `state --attention`, `check --strict` and `index` on the same revision and reports time and the index size separately, with the corpus revision and engine version.\n - Premise validity (spec `pose-assumption-validity-scope`) — a material `Assumption A<N>` may declare `Valid scope:` (the context it holds in) and `Stale trigger:` entries `<kind>:<value>@<pin>`, where kind is `doc`, `report`, `knowledge`, `adr` or `snapshot` and the pin is a prefix (8+ hex) of the sha256 of the content the premise was judged against. `lint-spec --design-check` reports an unpinned trigger with the pin to append, an unreadable one as unknown, and a calendar trigger (`date:`, `ttl:`, …) as not evaluated: validity is by context, not expiry, and trivial premises need neither field. When pinned content changes, the obligation projection (producer `premises`) emits a `premise-stale` judgment obligation for draft and in-progress specs, advisory on review and scoped to the assumption and the decisions based on it. The recorded evidence stays; it is described as judged against the pinned content and not valid for the current one, and nothing is invalidated automatically. Provider or remote contracts are not monitored by the core. Trigger state is projection only and never changes the design digest.\n - Falsifier observation (spec `pose-falsifier-reconsideration`) — a material `Decision D<N>` may add `Expected effect:` and `Falsifier check: check:<module>/<check>`, naming the indexed validation check whose failure contradicts it. When the delivery index holds a `fail` result for that check, the obligation projection (producer `falsifiers`) emits a `falsifier-observed` judgment obligation, advisory on review and scoped to the decision, for any spec that is not superseded or abandoned (decisions stay in force after done). The engine infers no cause and judges no architecture: the failure is an observation, the decision and its rationale are never edited, and a person either records why it still holds or opens a superseding decision. A passing or absent result raises nothing. `lint-spec --design-check` warns on a malformed reference and on a falsifier check without a stated falsifier.\n - `migrate v7 --dry-run [--json]` (spec `pose-v7-legacy-cleanup-plan`) — read-only inventory of what a future major would convert, keep or refuse: spec layouts, `blocked` specs, legacy and unknown review policy keys, sealed bundles, attestations by identity mode and attribution, and incomplete transfers on this project's side, each with its action and removal criterion. It writes nothing. Sealed bundles, attestations and signatures are never rewritten. `--apply` is refused with the current fact: no apply is available in this engine, the only mode is `--dry-run`, which writes nothing; no future apply is promised.\n - `assess design --spec <slug>` — read-only bounded projection over the canonical sealed review subject. It observes dependency, component, delivery-metadata, governance-contract and public-contract deltas, keeps unknown/unsupported coverage explicit, and never computes a complexity or architecture score. The MCP equivalent is `pose_design_delta`.\n - `usage` — aggregates automatic, project-scoped CLI and MCP usage events: calls, execution/semantic outcomes, latency, findings observed and stable finding lifecycle (`unique`, `new`, `resolved`, `reopened`). Agents never maintain counters. Events are best-effort, local-only and stored outside the tracked worktree; raw arguments, output, paths, project/user identity and finding IDs are never persisted. `--since-days 0` includes all history; filter with `--tool` or `--surface`; MCP equivalent: `pose_usage`. This is product-usage evidence, not a DORA delivery outcome or an individual productivity score.\n - `record-deployment` / `record-incident` / `dora-metrics` / `adoption-metrics` — ingest identity-free schema-v2 delivery events and calculate metrics for explicit production environments (`--environment`, default `production`). Deployments require `--deployment-kind planned|rework`; incidents require an environment; recovery includes only resolved `--caused-by-deployment` incidents. `adoption-metrics` aggregates specifications, roadmaps, and validation lifecycle rates.\n - `stacks [--path dir] [--json]` — read-only, offline catalog inspection (spec pose-stack-catalog-expansion). Matches directory entries against the maintained profile catalog (Node.js, Go, Rust, Java, **Python** — poetry/pipenv/pip/setuptools/pep517 — and **.NET**), reporting per profile: manager, marker, `winner`/`shadowed` (multiple managers present resolve by declared priority), `confidence` (`medium` under conflict), and whether the prerequisite native tool is on `PATH` — via `exec.LookPath`, never by executing a project file. Detected markers feed `discoverValidationModules`/`pose init --wizard` the same way Node/Go/Rust/Java already do; the actual checks run through [`validation-matrix.json`](.pose/indexes/validation-matrix.json) `python`/`dotnet` stacks. Python manager priority is expressed with `when.fileNotExistsAny` (skip when any higher-priority lockfile/marker exists) alongside the existing `fileExists`/`fileNotExists` predicates.\n-- `assess discover|integrate|tech-debt|stale|request|snapshot` — native assessment engines for LOC, technical debt markers, component structures, inter-module contract integrity checks, and capability mechanism reassessment lifecycle.\n+- `assess discover|integrate|tech-debt|stale|request|snapshot` — native assessment engines for LOC, technical debt markers, component structures, inter-module contract integrity checks, and capability mechanism reassessment lifecycle. `discover`, `integrate` and `tech-debt` take `--no-persist` to print their result without writing `.pose/assessments/` or `.pose/state/`; in the sealed checkout of a delegated review (`POSE_SEALED_CHECKOUT`) they never persist, `init`, `snapshot` and `request` refuse, and the review plan runs them with `--no-persist`, so a reviewer running a planned assessment does not fail its own run.\n - `doctor [--fix]` — environment, dependency, native runtime, and POSE instance health diagnostics, plus governance that would otherwise fail only downstream: `review.evidence-vocabulary` (a selected profile demands a class no check may emit), `validate.class-producers` (a criterion accepts only classes no registered check produces), `validate.evidence-class-coverage` (checks with no `evidenceClass`), `review.profile-schema`, `review.contract-adoption`, `review.scope-change-set`, and `<policy>.policy-keys` for nine policies (keys the engine does not read, i.e. a misspelled setting that silently does nothing).\n - `knowledge-housekeeping` / `reports-housekeeping` / `events-housekeeping` — idempotent maintenance (list/archive/purge). Mutations require `--apply`. Reports housekeeping **never touches `history/`**: the JSONL is the source of truth for `recurrence-check` and `report`'s temporal comparisons. Defaults: stale = 120d, archive purge = 365d.\n - `amend` — append-only spec amendment history (`amendments.jsonl` beside a folder spec's `spec.md`, or `YYYY-MM-DD-<slug>.amendments.jsonl` beside a flat dated spec; the spec is resolved through the store, so both layouts amend alike). `--baseline` snapshots every R-ID hash; `--ids R2 --change added|withdrawn|semantic|editorial --rationale <text> --author @alias [--reviewer @alias]` acknowledges a material change; `--list` renders history and pending acknowledgments. On `done` specs with a history, `lint-spec` rejects any requirement whose current text is not acknowledged by an event — specs cannot be silently rewritten after evidence. `--nodes [--json]` prints the versioned contract-node projection: requirements, assumptions and decisions with namespace, content hash, state and relations. With `contract_nodes_version: 1` adopted in the review policy, `--baseline` writes a schema-2 R/A/D snapshot, `--ids` accepts A/D, `--change transition` acknowledges an allowed state change, `editorial` is refused when a node changed state or relations, and the gate also rejects an active decision resting on an invalidated or withdrawn assumption. Without the capability the gate stays requirement-only and a schema-2 event is refused; schema-1 logs keep their meaning.\n - `start` — atomic start of a draft spec, journaled in a per-spec start record. Without flags it is a read-only, digest-bound preview: readiness and dependencies, the declared review obligations (no future structural delta needed) and the R/A/D baseline. `--apply --digest <sha256>` records that baseline and moves the spec from `draft` to `in-progress` under a per-spec lock with compare-and-swap; it needs `atomic_start_version: 1` in the review policy, repeats idempotently, resumes an interrupted run and refuses another plan for a started spec. `--cancel` undoes a start that never moved the spec. The per-spec lock records its owner (host, digests of the machine and boot IDs, PID namespace, PID and process start); a lock another call holds is reported, never broken by age, as `owner-active`, `owner-unknown` or `owner-dead` (spec `pose-journal-checkpoint-and-lock-recovery`). Dead is proven only on the same Linux machine — another boot, or a PID that is not running or now belongs to another process — and `--recover-lock <owner digest>`, with the digest `--status` shows, removes that lock only if its bytes and its dead owner are unchanged, leaving the start record to resume; an unknown owner (another host, an older engine's empty lock, another platform) is checked and removed by a person. The same lock is the spec's lifecycle lock: close and transfer take it too, so no two of them interleave on one spec (spec `pose-writer-coordination-and-atomic-publication`). `--status` classifies each node as `recorded-before-managed-execution`, `introduced-during-execution` or `legacy-unbaselined`, recomputes obligations and, under the capability, asks for reconciliation when status or the recorded baseline was edited by hand. `atomic_start_adopted_at: YYYY-MM-DD` (spec `pose-atomic-start-adoption-cutoff`) limits the capability to specs created on or after that date: an older spec in progress without a start is reported as `legacy-unbaselined` with a note and blocks nothing; without the date every such spec needs reconciliation. A start records observable precedence, not when anything was decided; MCP exposes the read-only view as `pose_start_status`.\n - `knowledge-usage` — projects `knowledge:<slug>` citations from specs per artifact (owner, expiry, citing specs). Usage signals inform the owner's review; TTL is never extended automatically. Dangling `knowledge:` refs fail `knowledge-check`.\n - `knowledge-suggest <query>` / `semantic-suggest <query>` / `suggest-feedback` / `portfolio-projection` / `reconcile-evidence` — deterministic lexical ranking and advisory projections for knowledge, feedback clustering, multi-roadmap portfolio milestones, and delivery validation evidence reconciliation. Suggestions never gate or auto-apply without confirmation.\n - `hooks` — links the native binary into `.git/hooks/`; invocation name selects `check --tolerant` for `pre-commit` and `index` for `post-merge`. `install --force` keeps a backup of pre-existing hooks. An instance that runs POSE through its own revision-bound CLI declares a runner in a `hooks.json` file of `.pose/policy/` (`{\"schema_version\":1,\"runner\":\"<project-relative executable>\"}`): the hook then runs the runner with the hook's name and returns its exit code, and `hooks status` names it; a runner outside the project, not executable or under another schema is refused and nothing runs.\n - `version` — displays compiled Go binary version, commit SHA, and compares the repository schema version with engine requirements.\n - `context` — resolves a selected logical project and optional local or `xref:`-qualified task through the shared artifact resolver. The JSON result includes canonical authority, project/artifact revisions, resolution state, supported contracts and a `context_revision`; it never includes filesystem roots. Use this token to detect a changed checkout or revision before a cross-project write.\n - Cross-project CLI writes require the target in `POSE_PROJECT_ROOTS` and the `context_revision` from a fresh `pose context` call. Use `new-spec-qualified` for qualified creation so older engines reject the command itself. A project found only by `HARNE8_PROJECTS_DIR` scan can be read but does not grant write access. Existing canonical specs are reused; redirects and incomplete transfers block shadow creation.\n - `install <dir> [--locale tag] [--skip-mcp] [--force] [--no-backup] [--allow-non-git]` — installs the embedded POSE runtime, rules, workflows, templates, and documentation into a target project directory without cloning, stamps `adopted_at` in the changelog policy with the day the instance received it, and runs the strict gate.\n - `import <spec-kit|openspec> <path> [--dry-run]` — imports foreign specification trees into canonical POSE specifications with standard frontmatter and section structure.\n@@ -1062,21 +1062,23 @@ Declare the executor and implementation baseline before dispatch. A bundle that\n   \"adapters\": {\n     \"reviewer\": {\"executor\": \"agent:reviewer\", \"command\": [\"reviewer\", \"--output\", \"{output}\"], \"vendor\": \"vendor-b\", \"model\": \"model-b\"}\n   }\n }\n ```\n \n Use the existing native issuer and its attestation pin. Set protected `authority_project` and `authority_audience` in review policy; a declared project identity must agree. Keep keys outside the project. Dispatch captures origin/worktree, bundle/commit/scope/kind, configuration/argv/executable, identities, brief template/body/notes, planned stdin and actual pipe-write digests, raw and retained redacted output/transcript digests and completeness. A pipe write does not prove the vendor consumed the prompt. Session references and private keys stay outside the public proof.\n \n Preview `pose review run-sign <run-id> --issuer <name> [--ttl <duration>]`, then add `--apply` to publish an immutable proof under `.pose/review-run-proofs/`. TTL is optional (no expiry when absent), positive when supplied and at most 365 days. Verify it with `pose review run-proof <run-id> <proof-id> [--json]`. The proof signs the captured executor declaration; it is not an independent vendor receipt or human confirmation. Failed or interrupted audit records disclose their state and `complete_review=false`. Unknown or ambiguous draft decisions also keep that flag false. A true flag describes completed delivery with one draft decision, not approval or complete typed-conclusion validation. A completed run with incomplete stdin or truncated output cannot establish a completed review. Legacy runs have no captured provenance and cannot be upgraded by signing today's configuration. `pose review run-proof` and the issuer lookups of the verdict readers ask the question the closeout asks: for a run whose scope is done, the proof as it was given (the record stands, the issuer still holds its pin; routine drift of the repository and the proof's expiry are not asked, because the expiry bounds when a proof may back a new attestation, not whether an attestation already given to a done scope stands); for an open scope, as the repository is now.\n \n Attach `--run <run-id> --run-proof <proof-id> --sign <issuer>` to a complete `pose review attest` request. The native issuer derives authority principal/execution bindings from the run and signs the exact reference. Criteria, tools, evidence and all ordinary preflight checks still apply. A rejecting or ambiguous draft cannot support an approval; a run-backed attestation cannot predate its completed run or signed proof. Adjudication/smoke run proofs bind their kinds but cannot be used as review attestations. Automatic validation/application of complete typed conclusions belongs to the capability, not to run signing.\n \n-**Conclusions of delegated reviews.** `pose review conclude <run> [--issuer <name>] [--apply] [--json]` records the conclusion of a completed review run: the run's final message carries its typed conclusion in the pose-draft block — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>`, `rationale`, and `mappings` where the plan asks for structural mappings) and `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), the brief of template `review-brief/8` (the text a template version renders is frozen by a golden digest, so a change to it takes a new version) asks for them and states the rules the engine checks before it records one (a judgment criterion passed carries a rationale, its evidence is a ref the bundle sealed, a finding criterion names a finding of the draft, structural facts are answered as `mappings`; a draft that breaks one is refused whole; a round after the first also names the findings it accounts for by the identifiers the brief lists, with their round, never a bare F1) — and the engine signs the run's proof and the attestation with the native issuer, `--issuer` or `conclusions.issuer` in `.pose/policy/delegation.json` (the key stays outside the project), and records it through the same domain writer and preflight as `pose review attest --run --run-proof --sign`. A follow-up finding with `action`, `owner` and `review_by` becomes an accepted risk when its severity is one the sealed review policy accepts (low by default); any other finding stays open. A rejecting conclusion is recorded too and blocks the scope until the bundle changes. A run that is not a completed review, is superseded, captured no provenance, has an incomplete cleanup or record, carries no valid draft for its round, or whose bundle no longer governs, records no attestation: its conclusion record, in the `review-conclusions` directory of `.pose`, keeps the reasons. A run concludes once: a lock the system releases when the process ends is held from the first read to the last write, concluding it again returns its record, and a reservation an interrupted conclusion left is completed from the attestation it recorded only if that attestation verifies as the run's conclusion, otherwise the run is concluded in its place. Whoever signs it, an attestation of a run briefed with `review-brief/3` to `/8` states that run's conclusion: criteria, tools or findings its draft did not declare are refused. With review policy `delegated_review: true` and `conclusions.issuer` set, `pose delegate review` records the conclusion the moment the run completes; otherwise nothing is automatic. An adjudication or a smoke run concludes the same way, under the same checks, lock and refusals, and never as an approval. The brief of template `adjudication-brief/2` lists the questions the scope's spec records — each decision `D<n>` and requirement `R<n>` — and the pose-draft block answers each in `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); the verdict is recorded as an adjudication record of the spec in the `adjudications` directory of `.pose`, and `lint-spec` fails, and `close` refuses, on a question the current bundle's adjudication says does not hold and warns on one it cannot determine or on a record that does not verify. The brief of template `smoke-brief/2` asks for `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), one per delivery target; the observations are recorded as validation results of evidence class `smoke`, one required check per target that passes when it was observed and is evidence of that target of that spec only, its head, time and provenance taken from the run and the current index, in the `results/smoke` directory of `.pose`, which `surface-check` reads beside the results path, so a delivery profile may demand `smoke`. A verdict that does not answer exactly what its brief asked records nothing; every record is verified on read — its run's proof verifies and it is what the run's draft concludes — and one that does not yields nothing. Runs briefed with `adjudication-brief/1` and `smoke-brief/1` keep verifying with their template.\n+**Conclusions of delegated reviews.** `pose review conclude <run> [--issuer <name>] [--apply] [--json]` records the conclusion of a completed review run: the run's final message carries its typed conclusion in the pose-draft block — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>`, `rationale`, and `mappings` where the plan asks for structural mappings) and `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), the brief of template `review-brief/10` (the text a template version renders is frozen by a golden digest, so a change to it takes a new version) asks for them and states the rules the engine checks before it records one (a judgment criterion passed carries a rationale, its evidence is a ref the bundle sealed, a finding criterion names a finding of the draft, structural facts are answered as `mappings`; a draft that breaks one is refused whole; a round after the first also names the findings it accounts for by the identifiers the brief lists, with their round, never a bare F1) — and the engine signs the run's proof and the attestation with the native issuer, `--issuer` or `conclusions.issuer` in `.pose/policy/delegation.json` (the key stays outside the project), and records it through the same domain writer and preflight as `pose review attest --run --run-proof --sign`. A follow-up finding with `action`, `owner` and `review_by` becomes an accepted risk when its severity is one the sealed review policy accepts (low by default); any other finding stays open. A rejecting conclusion is recorded too and blocks the scope until the bundle changes. A run that is not a completed review, is superseded, captured no provenance, has an incomplete cleanup or record, carries no valid draft for its round, or whose bundle no longer governs, records no attestation: its conclusion record, in the `review-conclusions` directory of `.pose`, keeps the reasons. A run concludes once: a lock the system releases when the process ends is held from the first read to the last write, concluding it again returns its record, and a reservation an interrupted conclusion left is completed from the attestation it recorded only if that attestation verifies as the run's conclusion, otherwise the run is concluded in its place. Whoever signs it, an attestation of a run briefed with `review-brief/3` to `/10` states that run's conclusion: criteria, tools or findings its draft did not declare are refused. With review policy `delegated_review: true` and `conclusions.issuer` set, `pose delegate review` records the conclusion the moment the run completes; otherwise nothing is automatic. An adjudication or a smoke run concludes the same way, under the same checks, lock and refusals, and never as an approval. The brief of template `adjudication-brief/2` lists the questions the scope's spec records — each decision `D<n>` and requirement `R<n>` — and the pose-draft block answers each in `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); the verdict is recorded as an adjudication record of the spec in the `adjudications` directory of `.pose`, and `lint-spec` fails, and `close` refuses, on a question the current bundle's adjudication says does not hold and warns on one it cannot determine or on a record that does not verify. The brief of template `smoke-brief/2` asks for `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), one per delivery target; the observations are recorded as validation results of evidence class `smoke`, one required check per target that passes when it was observed and is evidence of that target of that spec only, its head, time and provenance taken from the run and the current index, in the `results/smoke` directory of `.pose`, which `surface-check` reads beside the results path, so a delivery profile may demand `smoke`. A verdict that does not answer exactly what its brief asked records nothing; every record is verified on read — its run's proof verifies and it is what the run's draft concludes — and one that does not yields nothing. Runs briefed with `adjudication-brief/1` and `smoke-brief/1` keep verifying with their template.\n \n-**Review readiness before the seal.** A new seal of a spec scope refuses what `pose close` and the conclusion preflight would otherwise refuse only after a full review round: a change to a delivery root with no delivery declaration (`undeclared-delivery`) or to a governed path the artifacts do not declare (`undeclared`), read from the same index `pose close` reads, and, when a required criterion asks for structural mappings, a decision or assumption that reaches no requirement or constraint (give it a `- Basis:` line). A bundle already sealed is returned as it was. `pose review draft-check [<bundle-id|run-id>] --draft <file|-> [--json]` reports every reason the conclusion step would refuse a draft (an unreadable block, a round it does not account for, a criterion, mapping, finding, evidence or tool the attestation preflight refuses) and writes nothing; inside a delegated review the run provides the bundle and the round through `POSE_REVIEW_DRAFT_CONTEXT` and names its own engine in `POSE_REVIEW_CLI`, and `-` reads the draft from standard input, so it works in a read-only sandbox. The brief of template `review-brief/8` asks the reviewer to run it before finishing. `pose delegate` names an oversized note file with its size and the limit, and a completed run that nothing concluded automatically prints the `pose review conclude <run>` command that records it.\n+**Review readiness before the seal.** A new seal of a spec scope refuses what `pose close` and the conclusion preflight would otherwise refuse only after a full review round: a change to a delivery root with no delivery declaration (`undeclared-delivery`) or to a governed path the artifacts do not declare (`undeclared`), read from the same index `pose close` reads, and, when a required criterion asks for structural mappings, a decision or assumption that reaches no requirement or constraint (give it a `- Basis:` line). A bundle already sealed is returned as it was. `pose review draft-check [<bundle-id|run-id>] --draft <file|-> [--json]` reports every reason the conclusion step would refuse a draft (an unreadable block, a round it does not account for, a criterion, mapping, finding, evidence or tool the attestation preflight refuses) and writes nothing; inside a delegated review the run provides the bundle and the round through `POSE_REVIEW_DRAFT_CONTEXT` and names its own engine in `POSE_REVIEW_CLI`, and `-` reads the draft from standard input, so it works in a read-only sandbox. The brief of template `review-brief/8` asks the reviewer to run it before finishing; `review-brief/9` also has every planned `pose` command run as `\"$POSE_REVIEW_CLI\"`, because the `pose` the reviewer's shell resolves may be an older engine. `pose delegate` names an oversized note file with its size and the limit, and a completed run that nothing concluded automatically prints the `pose review conclude <run>` command that records it.\n+\n+**Runs that leave work behind.** On Linux, after the adapter exits, the dispatch also ends every process whose environment names the run's sealed checkout (`POSE_SEALED_CHECKOUT`), which catches commands a reviewer started in a session of its own; each is pinned by a pidfd and checked again before it is signalled. It waits for them and lists them in the run's `safety.limitations` before the cleanup inventory, and discloses there the processes of the same user that predate the run and whose environment could not be read (one started during the run that cannot be read fails the cleanup); on other platforms only the process group is ended; the brief of template `review-brief/10` asks the reviewer to let its commands finish. The dispatch marks an attempt active before it publishes its reservation, so a dispatch that ends before recording its run always leaves a stalled attempt, which `pose delegate ls` lists with its cause, and `pose delegate cancel <attempt>` releases it once its owner is proven gone, recording a failed run and its receipt; one release runs at a time, under a lock the system releases with its holder, and a release completes with any run the attempt already recorded instead of writing another. A reservation an earlier engine left without a marker records no owner: `pose delegate ls` lists it once it is ten minutes old, and `pose delegate cancel <attempt> --confirm-abandoned` releases it on the operator's confirmation that no dispatch of it runs.\n \n **Delegated-review requests.** `pose review request <scope|bundle> --kind delegated-review [--purpose review|adjudicate|smoke] [--agents <name,...>] [--note-file <path>] [--apply]` opens an action request of kind `delegated-review` that binds the project, the worktree, the scope, the sealed bundle, the brief, the notes, the policies, the accepted agents and the destination of the conclusion (an attestation, an adjudication record or smoke evidence). No actor answers it: `pose action fulfil <act-id> --run <run-id> --runner agent:<id> --idempotency-key <key> --expected-revision <n> [--channel cli|ci|conductor] [--envelope <file>] [--apply]`, or the MCP tool `pose_action_fulfil`, submits a completed run, and the engine records the fulfilment only when the run is of the request's brief and bundle, of an accepted agent, completed with its containment, its signed proof verifies, its attempt ledger is intact and the engine recorded its conclusion at the request's destination; the fulfilment is verified again on every read. `pose delegate review <scope> --request <act-id>` runs the request's brief locally and submits the run once concluded. A rejecting run fulfils the request without approving anything; a superseded bundle or changed policy invalidates it, even once fulfilled, and it is asked again with `--supersedes <act-id>`, which retires it under the supersession authority rules (`--authority <json>`, `--role <role>`, `--requested-at` from the preview), or, when the plan now reserves the review for a person, makes the person's escalation its successor; a retry with the same key and run is a no-op. A person is asked by exception, as a decision request to the maintainer role: a plan that reserves the review for a person, a spent attempt budget, reviewers in conflict, and a `business_decision` a reviewer raised in its draft. A run's proof verifies in any checkout of the project: the worktree it ran in is recorded, not required of the reader, so a CI job or the Conductor fulfils the request with the same envelope.\n \n Opt in to the verification bar with `delegated_review: true` in review policy only when preparing adoption. This live bar requires a signed run reference for agent different-actor review and refuses a prefix-only identity; it does not enable or add the future catalog capability. Non-adopting instances keep declared behavior. Under explicit executor-attested trust, normalized vendor OR model difference satisfies different-actor (vendor difference preferred); unknown baselines and the same vendor/model refuse. A machine run never satisfies mandatory-human. Catalog adoption, cutoffs/rollback and automatic conclusion application remain separate capability work.\n \n Read the same current assurance through verify, review-check, MCP and `pose state --attention`: `machine-attested` names the signed executor declaration, its source, run/proof and vendor/model comparisons. Current issuer pins, project/audience/time, sealed inputs, retained artifacts and original/continuation receipts are reverified. Revocation, missing receipts, rewritten data or stale inputs remove machine assurance. Signing does not reset quotas or erase earlier rejecting runs. The origin worktree is recorded with the run, not required of the reader: a proof verifies in any checkout of the project, so a run a CI job or the Conductor performed is verified like a local one; no universal containment is claimed.\ndiff --git a/locales/pt-BR/POSE.md b/locales/pt-BR/POSE.md\nindex 1f7e93c1..a6154714 100644\n--- a/locales/pt-BR/POSE.md\n+++ b/locales/pt-BR/POSE.md\n@@ -415,25 +415,25 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `history-check` — verifica que todo `.jsonl` em `reports/history/` está sob versionamento git. Sem isso, `recurrence-check` e `stats` divergem entre máquinas. Strict bloqueia; tolerant avisa.\n - `suggest` — lê [`task-map.json`](.pose/indexes/task-map.json) e imprime a trilha canônica (workflow + skill + rules + spec/ADR + knowledge) para um tipo de tarefa. Sem argumentos, lista todos os tipos. `--domain <d>` aplica rules adicionais por domínio (frontend, backend-go, k8s); `--path <p>` infere o domínio por heurísticas e via [`repo-map.json`](.pose/indexes/repo-map.json) (`language` → frontend/backend-go); `--json` para consumo por agentes. Domínios (spec `pose-distributed-instructions-parity`): `--domain` e o domínio inferido de `--path` passam por uma taxonomia (`go`/`golang`/`backend-go` → `backend-go`; `react`/`frontend-react`/`frontend` → `frontend`; `kubernetes`/`helm`/`k8s` → `k8s`), o JSON expõe `domain_input` e `domain_source: alias`, e um domínio sem regras no task-map é reportado (`domain_status`) em vez de tomar emprestado o de outro; um módulo `backend` só é o domínio Go quando sua linguagem é Go. `rules_status` (e a saída humana) diz de cada regra se está `installed` (com o path), `extension-needed` (com `pose extension install <id>`) ou `unavailable`; suggest não anuncia arquivo de regra que não está no disco e não instala nada.\n - `stats` — agrega outcomes do history JSONL por workflow, task ou context. Habilita decisões objetivas (promover check de optional → required, identificar workflows instáveis, comparar ci vs manual). `--since-days N` filtra a janela; `--json` para consumo por máquina.\n - `stats governance` — projeção read-only schema 2 sobre histórico de reports, bundles de review selados, atestações e declarações explícitas de remediação. Mantém preparação, julgamento, intervenção, frescor, telemetria, proveniência e cobertura independentes, nunca emite score de qualidade e explicita dados ausentes ou inválidos. `--report-type` filtra tentativas de validação; `--band` filtra reviews e vínculos de findings. A identidade de replay é `(report_type, task_slug, sequence)`; linhas sem identidade permanecem visíveis na cobertura. MCP `pose_governance_stats` aceita os mesmos seletores e exige `project_id` para escolher uma raiz federada. Vínculos explícitos incluem apenas IDs opacos, slugs, categoria e banda de origem, limitados a 100 linhas com truncamento indicado.\n - `stats governance --waits --rework` (spec `pose-governance-wait-rework-observability`) — duas dimensões a mais ao lado dos resultados, nunca somadas num score. Com `--waits` ou `--rework`, só as dimensões pedidas são calculadas; `--outcomes` acrescenta os resultados, que leem todo o histórico. `--waits` cronometra as action requests e mantém três medidas separadas: a idade de cada solicitação, o intervalo atribuído à espera por um ator ou sistema externo, e `known_blocking_seconds`, a união por spec dos intervalos em que uma solicitação restringiu a execução da spec inteira (solicitações simultâneas contam uma vez). Nenhuma delas é inatividade; timestamps ausentes contam como desconhecidos. `--rework` classifica bundles selados substituídos pelo que mudou (sujeito, intenção ou plano, plano de review, evidência, ou desconhecido) e atestações extras num bundle por divergência de review ou atestação anterior inválida contra a política atual, deixando outras causas como desconhecidas. `scripts/bench-governance.sh [runs] [pose-binary]` cronometra `state --attention`, `check --strict` e `index` na mesma revisão e reporta tempo e tamanho do índice separadamente, com a revisão do corpus e a versão do motor.\n - Validade de premissas (spec `pose-assumption-validity-scope`) — uma `Premissa A<N>` material pode declarar `Escopo de validade:` (o contexto em que vale) e entradas `Gatilho de obsolescência:` `<kind>:<value>@<pin>`, onde kind é `doc`, `report`, `knowledge`, `adr` ou `snapshot` e o pin é um prefixo (8+ hex) do sha256 do conteúdo contra o qual a premissa foi julgada. `lint-spec --design-check` reporta um gatilho sem pin com o pin a acrescentar, um ilegível como desconhecido, e um gatilho de calendário (`date:`, `ttl:`, …) como não avaliado: validade é por contexto, não por expiração, e premissas triviais não precisam de nenhum campo. Quando o conteúdo fixado muda, a projeção de obrigações (produtor `premises`) emite uma obrigação de julgamento `premise-stale` para specs draft e in-progress, advisory no review e com escopo na premissa e nas decisões baseadas nela. A evidência registrada permanece; é descrita como julgada contra o conteúdo fixado e não válida para o atual, e nada é invalidado automaticamente. Contratos de provedores ou remotos não são monitorados pelo core. O estado do gatilho é só projeção e nunca muda o digest do design.\n - Observação de falsificador (spec `pose-falsifier-reconsideration`) — uma `Decisão D<N>` material pode acrescentar `Efeito esperado:` e `Verificação do falsificador: check:<module>/<check>`, nomeando o check de validação indexado cuja falha a contradiz. Quando o índice de entrega contém um resultado `fail` desse check, a projeção de obrigações (produtor `falsifiers`) emite uma obrigação de julgamento `falsifier-observed`, advisory no review e com escopo na decisão, para qualquer spec que não esteja superseded ou abandoned (decisões continuam valendo depois de done). O motor não infere causa nem julga arquitetura: a falha é uma observação, a decisão e seu rationale nunca são editados, e uma pessoa registra por que ela ainda vale ou abre uma decisão substituta. Um resultado aprovado ou ausente não gera nada. `lint-spec --design-check` avisa sobre referência malformada e sobre verificação de falsificador sem falsificador declarado.\n - `migrate v7 --dry-run [--json]` (spec `pose-v7-legacy-cleanup-plan`) — inventário somente leitura do que uma futura major converteria, manteria ou recusaria: layouts de spec, specs `blocked`, chaves legadas e desconhecidas da política de review, bundles selados, atestações por modo de identidade e atribuição, e transferências incompletas do lado deste projeto, cada um com sua ação e critério de remoção. Não escreve nada. Bundles selados, atestações e assinaturas nunca são reescritos. `--apply` é recusado com o fato atual: não há apply neste motor, o único modo é `--dry-run`, que não escreve nada; nenhum apply futuro é prometido.\n - `assess design --spec <slug>` — projeção read-only e bounded sobre o subject canônico selado de review. Observa deltas de dependência, componente, metadata de delivery, contratos de governança e contratos públicos, mantém coverage unknown/unsupported explícita e nunca calcula score de complexidade ou arquitetura. O equivalente MCP é `pose_design_delta`.\n - `usage` — agrega automaticamente eventos locais e por projeto de uso da CLI e do MCP: chamadas, outcomes de execução/semântica, latência, findings observados e ciclo de vida estável (`unique`, `new`, `resolved`, `reopened`). Agentes nunca mantêm contadores. Os eventos são best-effort, somente locais e ficam fora da árvore versionada; argumentos, saída, paths, identidade de projeto/usuário e IDs crus de findings nunca são persistidos. `--since-days 0` inclui todo o histórico; filtre com `--tool` ou `--surface`; equivalente MCP: `pose_usage`. É evidência de uso do produto, não outcome DORA nem score individual de produtividade.\n - `record-deployment` / `record-incident` / `dora-metrics` / `adoption-metrics` — ingerem eventos de entrega schema v2 sem identidade individual e calculam métricas para um ambiente de produção explícito (`--environment`, padrão `production`). Deployments exigem `--deployment-kind planned|rework`; incidentes exigem ambiente; recovery inclui apenas incidentes resolvidos com `--caused-by-deployment`. `adoption-metrics` agrega taxas de especificações, roadmaps e validação de ciclo de vida.\n - `stacks [--path dir] [--json]` — inspeção de catálogo read-only e offline (spec pose-stack-catalog-expansion). Casa entradas de diretório contra o catálogo mantido de perfis (Node.js, Go, Rust, Java, **Python** — poetry/pipenv/pip/setuptools/pep517 — e **.NET**), reportando por perfil: manager, marker, `winner`/`shadowed` (múltiplos managers presentes resolvem por prioridade declarada), `confidence` (`medium` sob conflito) e se a ferramenta nativa pré-requisito está no `PATH` — via `exec.LookPath`, nunca executando um arquivo do projeto. Markers detectados alimentam `discoverValidationModules`/`pose init --wizard` do mesmo jeito que Node/Go/Rust/Java já fazem; os checks propriamente ditos rodam pelas stacks `python`/`dotnet` da [`validation-matrix.json`](.pose/indexes/validation-matrix.json). A prioridade de manager Python é expressa com `when.fileNotExistsAny` (pular quando existir qualquer lockfile/marker de prioridade maior) ao lado dos predicados `fileExists`/`fileNotExists` já existentes.\n-- `assess discover|integrate|tech-debt|stale|request|snapshot` — motores nativos de assessment para LOC, marcadores de débito técnico, estruturas de componentes, checagens de integridade de contrato entre módulos e ciclo de vida de reavaliação de capabilities.\n+- `assess discover|integrate|tech-debt|stale|request|snapshot` — motores nativos de assessment para LOC, marcadores de débito técnico, estruturas de componentes, checagens de integridade de contrato entre módulos e ciclo de vida de reavaliação de capabilities. `discover`, `integrate` e `tech-debt` aceitam `--no-persist` para imprimir o resultado sem gravar `.pose/assessments/` nem `.pose/state/`; no checkout selado de uma review delegada (`POSE_SEALED_CHECKOUT`) eles nunca gravam, `init`, `snapshot` e `request` recusam, e o plano de review os roda com `--no-persist`, para que um revisor que roda um assessment planejado não derrube o próprio run.\n - `doctor [--fix]` — diagnósticos de ambiente, dependências, runtime nativo e saúde da instância POSE, além de governança que só falharia mais adiante: `review.evidence-vocabulary` (um profile selecionado exige uma classe que nenhum check pode emitir), `validate.class-producers` (um critério aceita apenas classes que nenhum check registrado produz), `validate.evidence-class-coverage` (checks sem `evidenceClass`), `review.profile-schema`, `review.contract-adoption`, `review.scope-change-set` e `<policy>.policy-keys` para nove políticas (chaves que o motor não lê, ou seja, uma configuração com erro de digitação que silenciosamente não faz nada).\n - `knowledge-housekeeping` / `reports-housekeeping` / `events-housekeeping` — manutenção idempotente (listar/arquivar/expurgar). Mutações exigem `--apply`. O housekeeping de reports **nunca toca em `history/`**: o JSONL é a fonte de verdade para `recurrence-check` e comparações temporais de `report`. Defaults: stale = 120d, purga de arquivo = 365d.\n - `amend` — histórico append-only de emendas da spec (`amendments.jsonl` ao lado do `spec.md` de uma spec em pasta, ou `YYYY-MM-DD-<slug>.amendments.jsonl` ao lado de uma spec flat datada; a spec é resolvida pelo store, então os dois layouts recebem emendas do mesmo modo). `--baseline` fotografa o hash de cada R-ID; `--ids R2 --change added|withdrawn|semantic|editorial --rationale <text> --author @alias [--reviewer @alias]` reconhece uma mudança material; `--list` renderiza o histórico e os reconhecimentos pendentes. Em specs `done` com histórico, o `lint-spec` rejeita todo requisito cujo texto atual não esteja reconhecido por um evento — specs não podem ser reescritas em silêncio depois da evidência. `--nodes [--json]` mostra a projeção versionada de contract nodes: requisitos, premissas e decisões com namespace, hash de conteúdo, estado e relações. Com `contract_nodes_version: 1` adotado na policy de review, `--baseline` grava um snapshot R/A/D schema 2, `--ids` aceita A/D, `--change transition` reconhece uma mudança de estado permitida, `editorial` é recusado quando o nó mudou estado ou relações, e o gate também rejeita decisão ativa apoiada em premissa invalidada ou retirada. Sem a capability o gate segue só com requisitos e um evento schema 2 é recusado; logs schema 1 mantêm o significado.\n - `start` — início atômico de uma spec draft, registrado num start record por spec. Sem flags é um preview somente leitura vinculado a digest: readiness e dependências, as obrigações de review declaradas (sem exigir structural delta futuro) e a baseline R/A/D. `--apply --digest <sha256>` grava essa baseline e move a spec de `draft` para `in-progress` com lock por spec e compare-and-swap; exige `atomic_start_version: 1` na policy de review, repete de forma idempotente, retoma uma execução interrompida e recusa outro plano para spec já iniciada. `--cancel` desfaz um start que não moveu a spec. A trava por spec registra seu dono (host, digests dos IDs de máquina e de boot, namespace de PID, PID e início do processo); uma trava de outra chamada é informada, nunca quebrada pela idade, como `owner-active`, `owner-unknown` ou `owner-dead` (spec `pose-journal-checkpoint-and-lock-recovery`). Morte só é provada na mesma máquina Linux — outro boot, ou um PID que não roda ou agora é de outro processo — e `--recover-lock <digest do dono>`, com o digest que `--status` mostra, remove essa trava só se os bytes e o dono morto não mudaram, deixando o start record para retomar; um dono desconhecido (outro host, a trava vazia de um motor anterior, outra plataforma) é verificado e removido por uma pessoa. A mesma trava é a trava de ciclo de vida da spec: close e transfer também a tomam, então dois deles nunca se intercalam numa spec (spec `pose-writer-coordination-and-atomic-publication`). `--status` classifica cada nó como `recorded-before-managed-execution`, `introduced-during-execution` ou `legacy-unbaselined`, recalcula as obrigações e, com a capability, pede reconciliação quando status ou baseline registrada foram editados à mão. `atomic_start_adopted_at: YYYY-MM-DD` (spec `pose-atomic-start-adoption-cutoff`) limita a capability às specs criadas a partir dessa data: uma spec mais antiga em andamento sem start aparece como `legacy-unbaselined` com uma nota e não bloqueia nada; sem a data, toda spec assim exige reconciliação. Um start registra precedência observável, não quando algo foi decidido; o MCP expõe a visão somente leitura como `pose_start_status`.\n - `knowledge-usage` — projeta as citações `knowledge:<slug>` das specs por artefato (dono, expiração, specs citantes). Sinais de uso informam a review do dono; o TTL nunca é estendido automaticamente. Refs `knowledge:` órfãs falham no `knowledge-check`.\n - `knowledge-suggest <query>` / `semantic-suggest <query>` / `suggest-feedback` / `portfolio-projection` / `reconcile-evidence` — ranqueamento léxico determinístico e projeções consultivas para conhecimento, agrupamento de feedback, marcos de portfólio multi-roadmap e reconciliação de evidências de validação. Sugestões nunca bloqueiam nem se autoaplicam sem confirmação.\n - `hooks` — gerencia symlinks do binário nativo em `.git/hooks/`. O nome de invocação seleciona `check --tolerant` para `pre-commit` e `index` para `post-merge`; `install --force` preserva backup de hooks preexistentes. Uma instância que roda o POSE pelo próprio CLI vinculado a uma revisão declara um executor num arquivo `hooks.json` de `.pose/policy/` (`{\"schema_version\":1,\"runner\":\"<executável relativo ao projeto>\"}`): o hook passa a rodar o executor com o nome do hook e devolve o código de saída dele, e `hooks status` o nomeia; um executor fora do projeto, não executável ou com outro schema é recusado e nada roda.\n - `version` — exibe versão compilada do binário Go, SHA do commit e compara a versão do schema do repositório com os requisitos do motor.\n - `context` — resolve um projeto lógico selecionado e uma tarefa opcional, local ou qualificada por `xref:`, pelo resolvedor compartilhado de artefatos. O resultado JSON traz a autoridade canônica, as revisões do projeto e do artefato, o estado de resolução, os contratos suportados e um `context_revision`; nunca inclui roots do filesystem. Use esse token para detectar checkout ou revisão alterados antes de uma escrita entre projetos.\n - Escritas CLI entre projetos exigem o destino em `POSE_PROJECT_ROOTS` e o `context_revision` de uma chamada recente de `pose context`. Use `new-spec-qualified` para criação qualificada, de modo que motores antigos recusem o próprio comando. Um projeto encontrado apenas por varredura de `HARNE8_PROJECTS_DIR` pode ser lido, mas não concede acesso de escrita. Specs canônicas existentes são reutilizadas; redirecionamentos e transferências incompletas bloqueiam a criação de uma cópia.\n - `install <dir> [--locale tag] [--skip-mcp] [--force] [--no-backup] [--allow-non-git]` — instala o runtime, regras, workflows, templates e documentação embutidos do POSE em um diretório de destino sem clonar, grava no `adopted_at` da política de changelog o dia em que a instância a recebeu e roda o gate estrito.\n - `import <spec-kit|openspec> <path> [--dry-run]` — importa especificações externas para o formato canônico do POSE com frontmatter e 7 seções padronizadas.\n@@ -1059,21 +1059,23 @@ Declare executor e baseline de implementação antes do dispatch. Um bundle que\n   \"adapters\": {\n     \"reviewer\": {\"executor\": \"agent:reviewer\", \"command\": [\"reviewer\", \"--output\", \"{output}\"], \"vendor\": \"vendor-b\", \"model\": \"model-b\"}\n   }\n }\n ```\n \n Reutilize o issuer nativo e seu pin de atestações. Configure `authority_project` e `authority_audience` protegidos na policy de review; a identidade declarada do projeto deve concordar. Mantenha chaves fora do projeto. O dispatch captura origem/worktree, bundle/commit/scope/kind, configuração/argv/executável, identidades, template/body/notas do brief, stdin planejado e bytes escritos no pipe, digests de saída/transcript brutos e retidos com redação, além de completude. Escrever no pipe não prova que o fornecedor consumiu o prompt. Sessões e chaves privadas ficam fora da prova pública.\n \n Visualize `pose review run-sign <run-id> --issuer <nome> [--ttl <duração>]` e acrescente `--apply` para publicar uma prova imutável em `.pose/review-run-proofs/`. TTL é opcional (sem expiração quando ausente), positivo quando informado e limitado a 365 dias. Verifique com `pose review run-proof <run-id> <proof-id> [--json]`. A prova assina a declaração capturada do executor; não é recibo independente do fornecedor nem confirmação humana. Auditorias failed/interrupted mostram seu estado e `complete_review=false`. Decisão desconhecida ou ambígua também mantém a flag falsa. A flag verdadeira descreve entrega concluída com uma decisão de draft, não aprovação nem validação completa da conclusão tipada. Run completed com stdin incompleto ou saída truncada não estabelece review concluído. Runs legados sem proveniência capturada não são promovidos assinando a configuração atual. `pose review run-proof` e as buscas do emissor dos leitores de veredito fazem a pergunta que o fechamento faz: para uma run cujo escopo está done, a prova como foi dada (o registro se sustenta, o emissor mantém o pin; a deriva rotineira do repositório e a expiração da prova não são perguntadas, porque a expiração limita quando uma prova pode amparar uma nova atestação, não se uma atestação já dada a um escopo done se mantém); para um escopo aberto, como o repositório está agora.\n \n Acrescente `--run <run-id> --run-proof <proof-id> --sign <issuer>` a uma solicitação completa de `pose review attest`. O issuer deriva do run os vínculos de principal/execução e assina a referência exata. Critérios, tools, evidências e preflight continuam obrigatórios. Draft negativo ou ambíguo não apoia aprovação; a atestação não pode anteceder o término do run ou sua prova assinada. Provas de adjudication/smoke vinculam seus kinds e não servem como atestações de review. Validar/aplicar automaticamente conclusões completas e tipadas pertence à capability, não à assinatura do run.\n \n-**Conclusões de reviews delegadas.** `pose review conclude <run> [--issuer <nome>] [--apply] [--json]` registra a conclusão de um run de review concluído: a mensagem final do run traz a conclusão tipada no bloco pose-draft — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` como `<classe>:<ref>`, `rationale` e, quando o plano pede mapeamentos estruturais, `mappings`) e `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), que o brief do template `review-brief/8` (o texto que uma versão de template renderiza é congelado por um digest de referência, então mudá-lo exige uma nova versão) pede e para o qual declara as regras que o motor confere antes de registrar (um critério de julgamento aprovado traz uma justificativa, sua evidência é uma ref que o bundle selou, um critério com finding nomeia um finding do draft, fatos estruturais são respondidos como `mappings`; um draft que quebra uma delas é recusado inteiro; uma rodada depois da primeira também nomeia os findings pelos quais responde com os identificadores que o brief lista, com a rodada, nunca um F1 solto) — e o motor assina a prova do run e a atestação com o issuer nativo, `--issuer` ou `conclusions.issuer` em `.pose/policy/delegation.json` (a chave fica fora do projeto), e a registra pelo mesmo writer de domínio e preflight de `pose review attest --run --run-proof --sign`. Um finding de follow-up com `action`, `owner` e `review_by` vira um risco aceito quando sua severidade é uma que a política de review selada aceita (low por padrão); qualquer outro finding fica aberto. Uma conclusão que rejeita também é registrada e bloqueia o escopo até o bundle mudar. Um run que não é uma review concluída, foi substituído, não capturou proveniência, tem limpeza ou registro incompletos, não traz draft válido para sua rodada, ou cujo bundle não governa mais, não registra atestação: seu registro de conclusão, no diretório `review-conclusions` de `.pose`, guarda os motivos. Um run conclui uma vez: um lock que o sistema libera quando o processo termina é mantido da primeira leitura à última escrita, concluí-lo de novo devolve seu registro, e uma reserva deixada por uma conclusão interrompida só é completada pela atestação que ela registrou se essa atestação verificar como a conclusão do run; caso contrário o run é concluído no lugar dela. Quem quer que a assine, uma atestação de um run com brief `review-brief/3` a `/8` declara a conclusão daquele run: critérios, ferramentas ou findings que o draft não declarou são recusados. Com `delegated_review: true` na policy de review e `conclusions.issuer` definido, `pose delegate review` registra a conclusão no momento em que o run termina; caso contrário nada é automático. Um run de adjudicação ou de smoke conclui do mesmo jeito, sob os mesmos checks, lock e recusas, e nunca como aprovação. O brief do template `adjudication-brief/2` lista as questões que a spec do escopo registra — cada decisão `D<n>` e requisito `R<n>` — e o bloco pose-draft responde cada uma em `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); o veredito é registrado como registro de adjudicação da spec no diretório `adjudications` de `.pose`, e o `lint-spec` reprova, e o `close` recusa, uma questão que a adjudicação do bundle atual diz não se sustentar e avisa sobre uma que ela não pôde determinar ou sobre um registro que não verifica. O brief do template `smoke-brief/2` pede `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), uma por delivery target; as observações são registradas como resultados de validação da classe de evidência `smoke`, um check obrigatório por alvo que passa quando foi observado e é evidência só daquele alvo daquela spec, com head, data e proveniência tirados do run e do índice atual, no diretório `results/smoke` de `.pose`, que o `surface-check` lê ao lado do results path, de modo que um delivery profile pode exigir `smoke`. Um veredito que não responde exatamente o que seu brief pediu não registra nada; todo registro é verificado na leitura — a prova do run verifica e ele é o que o draft do run conclui — e um que não verifica não produz nada. Runs com brief `adjudication-brief/1` e `smoke-brief/1` continuam verificando com o próprio template.\n+**Conclusões de reviews delegadas.** `pose review conclude <run> [--issuer <nome>] [--apply] [--json]` registra a conclusão de um run de review concluído: a mensagem final do run traz a conclusão tipada no bloco pose-draft — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` como `<classe>:<ref>`, `rationale` e, quando o plano pede mapeamentos estruturais, `mappings`) e `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), que o brief do template `review-brief/10` (o texto que uma versão de template renderiza é congelado por um digest de referência, então mudá-lo exige uma nova versão) pede e para o qual declara as regras que o motor confere antes de registrar (um critério de julgamento aprovado traz uma justificativa, sua evidência é uma ref que o bundle selou, um critério com finding nomeia um finding do draft, fatos estruturais são respondidos como `mappings`; um draft que quebra uma delas é recusado inteiro; uma rodada depois da primeira também nomeia os findings pelos quais responde com os identificadores que o brief lista, com a rodada, nunca um F1 solto) — e o motor assina a prova do run e a atestação com o issuer nativo, `--issuer` ou `conclusions.issuer` em `.pose/policy/delegation.json` (a chave fica fora do projeto), e a registra pelo mesmo writer de domínio e preflight de `pose review attest --run --run-proof --sign`. Um finding de follow-up com `action`, `owner` e `review_by` vira um risco aceito quando sua severidade é uma que a política de review selada aceita (low por padrão); qualquer outro finding fica aberto. Uma conclusão que rejeita também é registrada e bloqueia o escopo até o bundle mudar. Um run que não é uma review concluída, foi substituído, não capturou proveniência, tem limpeza ou registro incompletos, não traz draft válido para sua rodada, ou cujo bundle não governa mais, não registra atestação: seu registro de conclusão, no diretório `review-conclusions` de `.pose`, guarda os motivos. Um run conclui uma vez: um lock que o sistema libera quando o processo termina é mantido da primeira leitura à última escrita, concluí-lo de novo devolve seu registro, e uma reserva deixada por uma conclusão interrompida só é completada pela atestação que ela registrou se essa atestação verificar como a conclusão do run; caso contrário o run é concluído no lugar dela. Quem quer que a assine, uma atestação de um run com brief `review-brief/3` a `/10` declara a conclusão daquele run: critérios, ferramentas ou findings que o draft não declarou são recusados. Com `delegated_review: true` na policy de review e `conclusions.issuer` definido, `pose delegate review` registra a conclusão no momento em que o run termina; caso contrário nada é automático. Um run de adjudicação ou de smoke conclui do mesmo jeito, sob os mesmos checks, lock e recusas, e nunca como aprovação. O brief do template `adjudication-brief/2` lista as questões que a spec do escopo registra — cada decisão `D<n>` e requisito `R<n>` — e o bloco pose-draft responde cada uma em `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); o veredito é registrado como registro de adjudicação da spec no diretório `adjudications` de `.pose`, e o `lint-spec` reprova, e o `close` recusa, uma questão que a adjudicação do bundle atual diz não se sustentar e avisa sobre uma que ela não pôde determinar ou sobre um registro que não verifica. O brief do template `smoke-brief/2` pede `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), uma por delivery target; as observações são registradas como resultados de validação da classe de evidência `smoke`, um check obrigatório por alvo que passa quando foi observado e é evidência só daquele alvo daquela spec, com head, data e proveniência tirados do run e do índice atual, no diretório `results/smoke` de `.pose`, que o `surface-check` lê ao lado do results path, de modo que um delivery profile pode exigir `smoke`. Um veredito que não responde exatamente o que seu brief pediu não registra nada; todo registro é verificado na leitura — a prova do run verifica e ele é o que o draft do run conclui — e um que não verifica não produz nada. Runs com brief `adjudication-brief/1` e `smoke-brief/1` continuam verificando com o próprio template.\n \n-**Prontidão da review antes da selagem.** Uma nova selagem de escopo de spec recusa o que `pose close` e a preflight da conclusão só recusariam depois de uma rodada completa de review: uma mudança em raiz de entrega sem declaração de entrega (`undeclared-delivery`) ou em caminho governado que os artefatos não declaram (`undeclared`), lidas do mesmo índice que `pose close` lê, e, quando um critério obrigatório pede mapeamentos estruturais, uma decisão ou premissa que não alcança requisito nem restrição (dê a ela uma linha `- Basis:`). Um bundle já selado é devolvido como estava. `pose review draft-check [<bundle-id|run-id>] --draft <arquivo|-> [--json]` relata todo motivo pelo qual a conclusão recusaria um rascunho (bloco ilegível, rodada não contabilizada, critério, mapeamento, achado, evidência ou ferramenta que a preflight da atestação recusa) e não grava nada; dentro de uma review delegada o run fornece o bundle e a rodada por `POSE_REVIEW_DRAFT_CONTEXT` e nomeia o próprio motor em `POSE_REVIEW_CLI`, e `-` lê o rascunho da entrada padrão, então funciona num sandbox somente leitura. O brief do template `review-brief/8` pede ao revisor que o rode antes de terminar. `pose delegate` nomeia um arquivo de nota grande demais com seu tamanho e o limite, e um run concluído que nada concluiu automaticamente imprime o comando `pose review conclude <run>` que o registra.\n+**Prontidão da review antes da selagem.** Uma nova selagem de escopo de spec recusa o que `pose close` e a preflight da conclusão só recusariam depois de uma rodada completa de review: uma mudança em raiz de entrega sem declaração de entrega (`undeclared-delivery`) ou em caminho governado que os artefatos não declaram (`undeclared`), lidas do mesmo índice que `pose close` lê, e, quando um critério obrigatório pede mapeamentos estruturais, uma decisão ou premissa que não alcança requisito nem restrição (dê a ela uma linha `- Basis:`). Um bundle já selado é devolvido como estava. `pose review draft-check [<bundle-id|run-id>] --draft <arquivo|-> [--json]` relata todo motivo pelo qual a conclusão recusaria um rascunho (bloco ilegível, rodada não contabilizada, critério, mapeamento, achado, evidência ou ferramenta que a preflight da atestação recusa) e não grava nada; dentro de uma review delegada o run fornece o bundle e a rodada por `POSE_REVIEW_DRAFT_CONTEXT` e nomeia o próprio motor em `POSE_REVIEW_CLI`, e `-` lê o rascunho da entrada padrão, então funciona num sandbox somente leitura. O brief do template `review-brief/8` pede ao revisor que o rode antes de terminar; o `review-brief/9` também manda rodar cada comando `pose` do plano como `\"$POSE_REVIEW_CLI\"`, porque o `pose` que o shell do revisor resolve pode ser um motor mais antigo. `pose delegate` nomeia um arquivo de nota grande demais com seu tamanho e o limite, e um run concluído que nada concluiu automaticamente imprime o comando `pose review conclude <run>` que o registra.\n+\n+**Runs que deixam trabalho para trás.** No Linux, depois que o adaptador termina, o envio também encerra todo processo cujo ambiente nomeia o checkout selado do run (`POSE_SEALED_CHECKOUT`), o que pega comandos que o revisor iniciou em sessão própria; cada um é fixado por um pidfd e conferido de novo antes do sinal. Ele espera que terminem e os lista em `safety.limitations` do run antes do inventário de limpeza, declarando ali os processos do mesmo usuário anteriores ao run cujo ambiente não pôde ser lido (um iniciado durante o run que não pode ser lido derruba a limpeza); nas outras plataformas só o grupo de processos é encerrado; o brief do template `review-brief/10` pede ao revisor que deixe seus comandos terminarem. O envio marca a tentativa como ativa antes de publicar a reserva, então um envio que termina antes de registrar o run sempre deixa uma tentativa parada, que `pose delegate ls` lista com a causa, e `pose delegate cancel <tentativa>` a libera quando o dono está comprovadamente encerrado, registrando um run com falha e o seu recibo; uma liberação roda por vez, sob um lock que o sistema libera junto com quem o detém, e uma liberação conclui com qualquer run que a tentativa já registrou em vez de gravar outro. Uma reserva que um motor anterior deixou sem marcador não registra dono: `pose delegate ls` a lista depois de dez minutos, e `pose delegate cancel <tentativa> --confirm-abandoned` a libera com a confirmação do operador de que nenhum envio dela está rodando.\n \n **Requests de review delegada.** `pose review request <escopo|bundle> --kind delegated-review [--purpose review|adjudicate|smoke] [--agents <nome,...>] [--note-file <caminho>] [--apply]` abre uma action request de kind `delegated-review` que vincula o projeto, o worktree, o escopo, o bundle selado, o brief, as notas, as policies, os agentes aceitos e o destino da conclusão (uma atestação, um registro de adjudicação ou evidência de smoke). Nenhum ator a responde: `pose action fulfil <act-id> --run <run-id> --runner agent:<id> --idempotency-key <chave> --expected-revision <n> [--channel cli|ci|conductor] [--envelope <arquivo>] [--apply]`, ou a tool MCP `pose_action_fulfil`, submete um run concluído, e o motor registra o fulfillment só quando o run é do brief e do bundle do request, de um agente aceito, concluído com sua contenção, sua prova assinada verifica, seu ledger de tentativas está íntegro e o motor registrou sua conclusão no destino do request; o fulfillment é verificado de novo a cada leitura. `pose delegate review <escopo> --request <act-id>` roda o brief do request localmente e submete o run depois de concluído. Um run que rejeita cumpre o request sem aprovar nada; um bundle superado ou uma policy alterada o invalida, mesmo já cumprido, e ele é pedido de novo com `--supersedes <act-id>`, que o aposenta sob as regras de autoridade de supersession (`--authority <json>`, `--role <papel>`, `--requested-at` do preview) ou, quando o plano passa a reservar a review a uma pessoa, faz da escalação para a pessoa o seu sucessor; um retry com a mesma chave e o mesmo run não faz nada. Uma pessoa é chamada por exceção, como decision request ao papel maintainer: um plano que reserva a review a uma pessoa, um orçamento de tentativas esgotado, revisores em conflito e uma `business_decision` que um revisor levantou no draft. A prova de um run verifica em qualquer checkout do projeto: o worktree onde rodou fica registrado, não é exigido de quem lê, então um job de CI ou o Conductor cumpre o request com o mesmo envelope.\n \n Ative a barreira de verificação com `delegated_review: true` na policy de review somente ao preparar adoção. Essa barreira viva exige prova de run para review de agente different-actor e recusa prefixo isolado; ela não adiciona nem habilita a capability futura no catálogo. Instâncias não adotantes mantêm o comportamento declared. Com confiança executor-attested explícita, vendor OU modelo normalizado diferente satisfaz different-actor (vendor distinto preferido); baseline desconhecida e mesmo vendor/modelo recusam. Run de máquina nunca satisfaz mandatory-human. Adoção no catálogo, cutoffs/rollback e aplicação automática de conclusões continuam no escopo separado da capability.\n \n Leia a mesma assurance atual por verify, review-check, MCP e `pose state --attention`: `machine-attested` identifica a declaração assinada, sua fonte, run/proof e comparação de vendor/modelo. Pins atuais, projeto/audience/tempo, inputs selados, artefatos retidos e receipts originais/de continuação são revalidados. Revogação, receipt ausente, dados reescritos ou inputs stale retiram a assurance de máquina. Assinar não restaura quota nem apaga runs negativos anteriores. O worktree de origem fica registrado com o run, não é exigido de quem lê: uma prova verifica em qualquer checkout do projeto, então um run feito por um job de CI ou pelo Conductor é verificado como um local; não há alegação de contenção universal.\ndiff --git a/pose-mcp/internal/cli/help_catalog.go b/pose-mcp/internal/cli/help_catalog.go\nindex 6df8f572..2055220f 100644\n--- a/pose-mcp/internal/cli/help_catalog.go\n+++ b/pose-mcp/internal/cli/help_catalog.go\n@@ -353,25 +353,25 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"--json\", \"One versioned JSON document\", \"Um documento JSON versionado\"},\n \t\t},\n \t\tSubcommands: []SubcommandHelp{\n \t\t\t{\"review\", \"pose delegate review <scope|bundle-id> [--agent auto|<name>] [--label <name>] [--lead <vendor>[/<model>]] [--reason <text>] [--note-file <path>] [--detach] [--dry-run] [--json]\", \"Run a delegated review of a sealed bundle and record the run\", \"Roda um review delegado de um bundle selado e registra o run\"},\n \t\t\t{\"adjudicate\", \"pose delegate adjudicate <scope|bundle-id> [--agent auto|<name>] [--label <name>] [--dry-run] [--json]\", \"Run a delegated adjudication of a sealed bundle\", \"Roda uma adjudicação delegada de um bundle selado\"},\n \t\t\t{\"smoke\", \"pose delegate smoke <scope|bundle-id> [--agent auto|<name>] [--label <name>] [--dry-run] [--json]\", \"Run a delegated smoke run of a sealed bundle\", \"Roda um smoke run delegado de um bundle selado\"},\n \t\t\t{\"task\", \"pose delegate task <prompt-file|-> [--agent auto|<name>] [--access read|sandboxed|write|full] [--cd <dir>] [--add-dir <dir>]... [--no-network] [--effort <level>] [--record] [--session <id>] [--label <name>] [--lead <vendor>[/<model>]] [--detach] [--dry-run] [--json]\", \"Hand a general task to another agent in a real directory; its final message goes to stdout and its exit code is returned, or --detach returns its attempt at once; never evidence\", \"Entrega uma tarefa geral a outro agente num diretório real; a mensagem final vai para o stdout e o código de saída é devolvido, ou --detach devolve a tentativa na hora; nunca é evidência\"},\n \t\t\t{\"ls\", \"pose delegate ls [<run>|<bundle-id>] [--active] [--agent <name>] [--label <name>] [--lead <vendor>[/<model>]] [--json]\", \"List attempts by their latest run, with state, purpose, agent, label, turns, age, last step and, when interrupted, cause, partial draft, reset and time left\", \"Lista tentativas pelo run mais recente, com estado, propósito, agente, label, turnos, idade, último passo e, se interrompido, causa, draft parcial, reset e tempo restante\"},\n \t\t\t{\"watch\", \"pose delegate watch [<run>|<label>] [-v] [--lines <n>] [--no-follow] [--refresh <d>] [--json]\", \"Follow a run live until it ends, replaying the runs its attempt recorded; with no run, the only running one or a picker\", \"Acompanha um run ao vivo até terminar, reproduzindo os runs que a tentativa registrou; sem run, o único em andamento ou um seletor\"},\n \t\t\t{\"wait\", \"pose delegate wait <run> [--timeout <d>] [--json]\", \"Block until a run ends; exit 0 approved, 10 changes requested or rejected, 20 failed, 30 interrupted, 40 stalled, 50 timed out\", \"Bloqueia até um run terminar; sai com 0 aprovado, 10 mudanças pedidas ou rejeitado, 20 falhou, 30 interrompido, 40 travado, 50 tempo esgotado\"},\n \t\t\t{\"resume\", \"pose delegate resume <run> [--wait-until-reset[=<max>]] [--prompt <file|->] [--detach] [--dry-run] [--json]\", \"Continue an interrupted run with the same agent and session, under its original attempt; repeating it returns the recorded continuation\", \"Retoma um run interrompido com o mesmo agente e sessão, sob a tentativa original; repetir devolve a continuação registrada\"},\n \t\t\t{\"handoff\", \"pose delegate handoff <run> --to <agent|auto> [--detach] [--dry-run] [--json]\", \"Continue a stopped run with another agent under the same attempt and budget, its brief carrying the stopped run's quoted partial and commands\", \"Continua um run parado com outro agente na mesma tentativa e orçamento, com o brief levando o parcial citado e os comandos do run parado\"},\n-\t\t\t{\"cancel\", \"pose delegate cancel <run> [--dry-run] [--json]\", \"Stop a running run; it is recorded failed with the cause cancelled and its attempt stays consumed\", \"Para um run em andamento; ele é registrado como failed com a causa cancelled e a tentativa continua consumida\"},\n+\t\t\t{\"cancel\", \"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\", \"Stop a running run; it is recorded failed with the cause cancelled and its attempt stays consumed. A stalled attempt whose dispatch ended before recording its run is released with a failed run and its receipt; one an earlier engine left without a marker needs --confirm-abandoned\", \"Para um run em andamento; ele é registrado como failed com a causa cancelled e a tentativa continua consumida. Uma tentativa parada cujo envio terminou antes de registrar o run é liberada com um run com falha e o recibo; uma que um motor anterior deixou sem marcador exige --confirm-abandoned\"},\n \t\t\t{\"agents\", \"pose delegate agents [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>[/<model>]] [--json]\", \"List configured agents with vendor, model, whether their CLI is on the path, their last usage-limit reset and their state: available, limited until <instant>, missing or probe-failed\", \"Lista os agentes configurados com vendor, modelo, se a CLI está no path, o último reset de limite de uso e o estado: available, limited until <instante>, missing ou probe-failed\"},\n \t\t},\n \t\tExamples: []string{\n \t\t\t\"pose delegate review spec:my-feature --label my-feature-r1\",\n \t\t\t\"pose delegate ls --active\",\n \t\t\t\"pose delegate resume my-feature-r1 --wait-until-reset\",\n \t\t\t\"pose delegate agents --json\",\n \t\t},\n \t},\n \t\"review\": {\n \t\tName:            \"review\",\n \t\tSummaryEN:       \"Governed review planning, bundle sealing, and attestation workflow\",\n@@ -711,27 +711,27 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t\"pose suggest feature --path pose-mcp\",\n \t\t\t\"pose suggest bugfix\",\n \t\t},\n \t},\n \t\"assess\": {\n \t\tName:            \"assess\",\n \t\tSummaryEN:       \"Discover module metrics, integration contracts, and technical debt\",\n \t\tSummaryPtBR:     \"Descobre métricas de módulos, contratos de integração e débito técnico\",\n \t\tUsage:           \"pose assess <discover|integrate|tech-debt|design> [options]\",\n \t\tDescriptionEN:   \"Runs bounded local assessments for component LOC, dependencies, technical debt markers, public contracts, and structural deltas on a canonical review subject.\",\n \t\tDescriptionPtBR: \"Executa assessments locais e bounded de LOC, dependências, débito técnico, contratos públicos e deltas estruturais sobre um subject canônico de review.\",\n \t\tSubcommands: []SubcommandHelp{\n-\t\t\t{\"discover\", \"pose assess discover [--component <dir>] [--update-state]\", \"Discover LOC metrics, debts, and module structure\", \"Descobre métricas de LOC, débitos e estrutura de módulos\"},\n-\t\t\t{\"integrate\", \"pose assess integrate\", \"Check inter-module contracts (REST, Protobuf, Kafka, MCP)\", \"Verifica contratos inter-módulos (REST, Protobuf, Kafka, MCP)\"},\n-\t\t\t{\"tech-debt\", \"pose assess tech-debt\", \"Scan codebase for technical debt markers and uncovered stubs\", \"Escaneia a base de código por marcadores de débito e stubs\"},\n+\t\t\t{\"discover\", \"pose assess discover [--component <dir>] [--update-state] [--no-persist]\", \"Discover LOC metrics, debts, and module structure\", \"Descobre métricas de LOC, débitos e estrutura de módulos\"},\n+\t\t\t{\"integrate\", \"pose assess integrate [--update-state] [--no-persist]\", \"Check inter-module contracts (REST, Protobuf, Kafka, MCP)\", \"Verifica contratos inter-módulos (REST, Protobuf, Kafka, MCP)\"},\n+\t\t\t{\"tech-debt\", \"pose assess tech-debt [--update-state] [--no-persist]\", \"Scan codebase for technical debt markers and uncovered stubs\", \"Escaneia a base de código por marcadores de débito e stubs\"},\n \t\t\t{\"design\", \"pose assess design --spec <slug> [--json] [--max-files N] [--max-bytes N]\", \"Observe bounded structural deltas from the sealed review subject\", \"Observa deltas estruturais bounded a partir do subject selado de review\"},\n \t\t},\n \t\tExamples: []string{\n \t\t\t\"pose assess discover --update-state\",\n \t\t\t\"pose assess tech-debt\",\n \t\t\t\"pose assess design --spec customer-cache --json\",\n \t\t},\n \t},\n \t\"serve-mcp\": {\n \t\tName:            \"serve-mcp\",\n \t\tSummaryEN:       \"Start the POSE Model Context Protocol (MCP) server\",\n \t\tSummaryPtBR:     \"Inicia o servidor MCP (Model Context Protocol) do POSE\",\ndiff --git a/pose-mcp/internal/pose/review_brief.go b/pose-mcp/internal/pose/review_brief.go\nindex a4f69b9b..1a037471 100644\n--- a/pose-mcp/internal/pose/review_brief.go\n+++ b/pose-mcp/internal/pose/review_brief.go\n@@ -18,25 +18,25 @@ import (\n \t\"sort\"\n \t\"strings\"\n )\n \n // Review brief kinds and their template versions.\n const (\n \tReviewBriefKindReview       = \"review\"\n \tReviewBriefKindAdjudication = \"adjudication\"\n \tReviewBriefKindSmoke        = \"smoke\"\n )\n \n var reviewBriefTemplates = map[string]string{\n-\tReviewBriefKindReview:       reviewBriefTemplateDraftCheck,\n+\tReviewBriefKindReview:       reviewBriefTemplateFinishCommands,\n \tReviewBriefKindAdjudication: adjudicationBriefTemplateTyped,\n \tReviewBriefKindSmoke:        smokeBriefTemplateTyped,\n }\n \n // The adjudication and smoke templates that ask for a typed verdict (spec\n // pose-delegated-verdict-destinations), and the ones before them.\n const (\n \tadjudicationBriefTemplateTyped = \"adjudication-brief/2\"\n \tadjudicationBriefTemplateFirst = \"adjudication-brief/1\"\n \tsmokeBriefTemplateTyped        = \"smoke-brief/2\"\n \tsmokeBriefTemplateFirst        = \"smoke-brief/1\"\n )\n@@ -60,40 +60,60 @@ const (\n \t// pose-review-brief-templates-are-immutable). /5 stated how a round after the first\n \t// names the findings it accounts for.\n \treviewBriefTemplateRoundIDs = \"review-brief/5\"\n \t// reviewBriefTemplateRiskRules stated the accepted-risk severities and more, see briefRulesText.\n \treviewBriefTemplateRiskRules = \"review-brief/6\"\n \t// reviewBriefTemplateAllNotApplicable is the current template: it also says that a draft\n \t// cannot dispense with every required criterion as not-applicable.\n \treviewBriefTemplateAllNotApplicable = \"review-brief/7\"\n \t// reviewBriefTemplateDraftCheck is the current template: /7 plus the step\n \t// that checks the draft with `pose review draft-check` before the run ends\n \t// (spec pose-review-readiness-before-seal R4).\n \treviewBriefTemplateDraftCheck = \"review-brief/8\"\n+\t// reviewBriefTemplateEngineTools was the current template: /8 plus the\n+\t// instruction to run the planned `pose` commands with the engine that\n+\t// dispatched the run, since the reviewer's shell may resolve an older\n+\t// installed `pose` that ignores flags such as --no-persist (spec\n+\t// pose-assess-leaves-sealed-checkouts-alone R5).\n+\treviewBriefTemplateEngineTools = \"review-brief/9\"\n+\t// reviewBriefTemplateFinishCommands is the current template: /9 plus the\n+\t// boundary that every command the reviewer starts ends before it does\n+\t// (spec pose-review-run-reaps-lingering-reviewer-processes R3).\n+\treviewBriefTemplateFinishCommands = \"review-brief/10\"\n \t// reviewBriefTemplateConclusions asked for the typed conclusion and stated its rules,\n \t// without the identifiers of the findings of earlier rounds.\n \t// reviewBriefTemplateConclusions (/4) asked for the typed conclusion and stated the rules\n \t// the engine checks before it records one (spec pose-review-brief-states-the-conclusion-rules).\n \treviewBriefTemplateConclusions = \"review-brief/4\"\n \t// reviewBriefTemplateTypedConclusion asked for the conclusion without stating\n \t// those rules; kept so a run briefed with it still verifies and concludes.\n \treviewBriefTemplateTypedConclusion = \"review-brief/3\"\n \treviewBriefTemplateRounds          = \"review-brief/2\"\n \treviewBriefTemplateFirst           = \"review-brief/1\"\n )\n \n // reviewBriefFromAllNotApplicable reports /7 and the templates that keep its\n // text and add to it.\n func reviewBriefFromAllNotApplicable(template string) bool {\n-\treturn template == reviewBriefTemplateAllNotApplicable || template == reviewBriefTemplateDraftCheck\n+\treturn template == reviewBriefTemplateAllNotApplicable || reviewBriefFromDraftCheck(template)\n+}\n+\n+// reviewBriefFromDraftCheck reports /8 and the templates that keep its text.\n+func reviewBriefFromDraftCheck(template string) bool {\n+\treturn template == reviewBriefTemplateDraftCheck || reviewBriefFromEngineTools(template)\n+}\n+\n+// reviewBriefFromEngineTools reports /9 and the templates that keep its text.\n+func reviewBriefFromEngineTools(template string) bool {\n+\treturn template == reviewBriefTemplateEngineTools || template == reviewBriefTemplateFinishCommands\n }\n \n // reviewBriefAsksConclusion reports a template that asks for the typed conclusion.\n func reviewBriefAsksConclusion(template string) bool {\n \treturn reviewBriefFromAllNotApplicable(template) || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions || template == reviewBriefTemplateTypedConclusion\n }\n \n // briefRulesTextV5 is the statement of the rules the conclusion is checked against that\n // review-brief/4 and /5 carry, byte for byte; a version never changes its text.\n const briefRulesTextV5 = \"POSE checks the conclusion before it records it, and refuses the whole draft when one rule breaks: (a) a `passed` criterion of kind judgment carries a `rationale` saying what you examined and what you concluded; (b) the `evidence` of a `passed` criterion is exactly one of the refs listed under Sealed evidence (`<class>:<id>`, of a class the criterion asks for when it names one), never a file and line, a command or a structural fact id: those go in a finding or in the `rationale`; (c) a criterion disposed `finding` carries as its `evidence` the `id` of a finding listed in `findings`, and that finding is open until you give it `action`, `owner` and `review_by`; (d) each structural fact listed above is answered by the criterion that asks for structural mapping, as its `mappings`: `[{\\\"delta\\\": <fact id>, \\\"basis\\\": <requirement or decision ref>, \\\"disposition\\\": \\\"mapped\\\", \\\"rationale\\\": <why>}]`, or `not-applicable` with the reason; (e) a `not-applicable` carries a `rationale` and is refused when the bundle seals evidence of a class the criterion asks for; (f) every required criterion and every tool above is answered; (g) the `disposition` of a tool is `passed`, `failed`, `not-used` or `deferred`, never anything else (`not-run` is refused); a tool listed as required must be run and `passed`, with the ref of the sealed evidence it produced as `evidence` when it names classes, and `not-used` is accepted for a required tool only when the plan says no producer exists; a recommended tool you did not run is `not-used` with a `rationale`; (h) the `evidence` of a tool is `<class>:<ref>`: when the tool lists evidence classes, a ref of one of them that the bundle sealed (listed under Sealed evidence), otherwise `command:` followed by the command you ran; a bare command line is refused; (i) a draft that approves leaves no finding open: each finding is either a follow-up with `action`, `owner` and `review_by`, which is recorded as an accepted risk, or the draft requests changes; a finding without them is open and the approval is refused.\"\n \n // briefRulesText is the statement of those rules in the brief of template. review-brief/6 also\n@@ -118,25 +138,25 @@ func briefRulesText(template string, bundle ReviewBundle) string {\n }\n \n // reviewBriefStatesRules reports a template that states the rules the conclusion is\n // checked against.\n func reviewBriefStatesRules(template string) bool {\n \treturn reviewBriefFromAllNotApplicable(template) || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions\n }\n \n // reviewBriefEarlierTemplates are the review templates a run may have been\n // briefed with before the current one, newest first; a run briefed with one\n // is re-rendered with it to verify and to continue (the brief a run was sent\n // never changes under it).\n-var reviewBriefEarlierTemplates = []string{reviewBriefTemplateAllNotApplicable, reviewBriefTemplateRiskRules, reviewBriefTemplateRoundIDs, reviewBriefTemplateConclusions, reviewBriefTemplateTypedConclusion, reviewBriefTemplateRounds, reviewBriefTemplateFirst}\n+var reviewBriefEarlierTemplates = []string{reviewBriefTemplateEngineTools, reviewBriefTemplateDraftCheck, reviewBriefTemplateAllNotApplicable, reviewBriefTemplateRiskRules, reviewBriefTemplateRoundIDs, reviewBriefTemplateConclusions, reviewBriefTemplateTypedConclusion, reviewBriefTemplateRounds, reviewBriefTemplateFirst}\n \n // briefEarlierTemplates are, per kind, the templates a run may have been\n // briefed with before the current one, newest first.\n var briefEarlierTemplates = map[string][]string{\n \tReviewBriefKindReview:       reviewBriefEarlierTemplates,\n \tReviewBriefKindAdjudication: {adjudicationBriefTemplateFirst},\n \tReviewBriefKindSmoke:        {smokeBriefTemplateFirst},\n }\n \n // ReviewBriefKinds lists the accepted kinds.\n func ReviewBriefKinds() []string {\n \treturn []string{ReviewBriefKindReview, ReviewBriefKindAdjudication, ReviewBriefKindSmoke}\n@@ -310,24 +330,27 @@ func renderReviewBriefBody(bundle ReviewBundle, kind, template, notes string, sm\n \tcase ReviewBriefKindSmoke:\n \t\tline(\"Exercise each delivered surface of the scope from its entrypoint, as a user of it would, and report what you observe against what the spec says should happen. Do not review the code beyond what you need to run it.\")\n \t}\n \tline(\"\")\n \n \tline(\"## Boundaries\")\n \tline(\"\")\n \tline(\"- Report every defect with file, line and severity (high, medium, low). Do not fix it.\")\n \tline(\"- Do not change the repository: no edits, commits, pushes, tags or releases.\")\n \tline(\"- Do not record an attestation: POSE records the conclusion of a verified run.\")\n \tline(\"- Do not reveal secrets or key material you come across.\")\n \tline(\"- If something you need is missing, say what and stop, rather than assuming it.\")\n+\tif template == reviewBriefTemplateFinishCommands {\n+\t\tline(\"- Let every command you start finish before you end, and do not leave anything running in the background: POSE ends what is left and records it, and a long run left behind costs time you could have used.\")\n+\t}\n \tline(\"\")\n \n \tline(\"## Change\")\n \tline(\"\")\n \tline(\"- range: %s..%s\", orNone(subject.Base), orNone(subject.Head))\n \tline(\"- change sets: %s\", orNone(strings.Join(subject.ChangeSets, \", \")))\n \tentries := append([]ReviewBundleSubjectEntry(nil), subject.Entries...)\n \tsort.Slice(entries, func(i, j int) bool { return entryPath(entries[i]) < entryPath(entries[j]) })\n \tfor _, e := range entries {\n \t\tline(\"- %s %s (%s)\", e.Action, entryPath(e), e.Class)\n \t}\n \tline(\"\")\n@@ -366,24 +389,28 @@ func renderReviewBriefBody(bundle ReviewBundle, kind, template, notes string, sm\n \t\t}\n \t\tevidence := \"\"\n \t\tif len(c.EvidenceClasses) > 0 {\n \t\t\tevidence = \"; evidence: \" + strings.Join(c.EvidenceClasses, \", \")\n \t\t}\n \t\tline(\"- %s (%s, %s%s): %s\", c.ID, ReviewCriterionKind(c), required, evidence, c.Description)\n \t}\n \tline(\"\")\n \n \tif len(plan.Tools) > 0 {\n \t\tline(\"## Tools the plan requires\")\n \t\tline(\"\")\n+\t\tif reviewBriefFromEngineTools(template) {\n+\t\t\tline(\"Run each `pose` command below as `\\\"$POSE_REVIEW_CLI\\\"` followed by the same arguments: it is the engine that sealed and dispatched this run. The `pose` your shell resolves may be an older installed engine that ignores flags such as `--no-persist` and writes into this sealed checkout, which fails the run.\")\n+\t\t\tline(\"\")\n+\t\t}\n \t\ttools := append([]ReviewPlanTool(nil), plan.Tools...)\n \t\tsort.SliceStable(tools, func(i, j int) bool { return tools[i].ID+tools[i].Component < tools[j].ID+tools[j].Component })\n \t\tfor _, t := range tools {\n \t\t\tcomponent := \"\"\n \t\t\tif t.Component != \"\" {\n \t\t\t\tcomponent = \" [\" + t.Component + \"]\"\n \t\t\t}\n \t\t\tclasses := \"\"\n \t\t\tif reviewBriefStatesRules(template) && len(t.EvidenceClasses) > 0 {\n \t\t\t\tclasses = \"; evidence classes: \" + strings.Join(t.EvidenceClasses, \", \")\n \t\t\t}\n \t\t\tline(\"- %s%s (%s%s): `%s`\", t.ID, component, t.Requiredness, classes, strings.Join(t.Args, \" \"))\n@@ -476,25 +503,25 @@ func renderReviewBriefBody(bundle ReviewBundle, kind, template, notes string, sm\n \t\tnext = 5\n \t} else {\n \t\tline(\"3. Every defect, with file, line and severity.\")\n \t\tnext = 4\n \t}\n \tif round != nil {\n \t\tline(\"%d. At the end, the draft POSE reads: one fenced block opened with ```pose-draft holding a JSON object with `schema` %q, `decision` (the decision above), `findings` (each with `id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line` and `summary`)%s. Everything outside the block is yours and is not read.\", next, ReviewDraftSchema, roundFields(*round, template))\n \t\tif conclusion {\n \t\t\tline(\"%d. In the same block, the conclusion POSE records as the attestation: `criteria` (one entry per criterion above, each with `id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>` — a class the criterion asks for when it names one — and `rationale` for not-applicable), and `tools` (one entry per tool above, each with `id`, `component` when it has one, `disposition`, `evidence` and `rationale`). A follow-up finding that should be accepted as a risk carries `action`, `owner` and `review_by`; any other finding stays open. A criterion or tool you do not answer is not answered for you.\", next+1)\n \t\t\tif reviewBriefStatesRules(template) {\n \t\t\t\tline(\"%d. %s\", next+2, briefRulesText(template, bundle))\n \t\t\t}\n-\t\t\tif template == reviewBriefTemplateDraftCheck {\n+\t\t\tif reviewBriefFromDraftCheck(template) {\n \t\t\t\tline(\"%d. Before you finish, check your final message: pipe it to `\\\"$POSE_REVIEW_CLI\\\" review draft-check --draft -`, the engine that dispatched this run (it reads this run's bundle and round, writes nothing and works in a read-only sandbox) and fix every reason it reports. A draft it refuses is refused at conclusion, and the round is spent.\", next+3)\n \t\t\t}\n \t\t}\n \t}\n \tif template == reviewBriefTemplateRiskRules || reviewBriefFromAllNotApplicable(template) {\n \t\t// ParseReviewDraft refuses a draft whose `decision:` line outside the block disagrees\n \t\t// with the block, so the brief cannot say the outside is not read at all.\n \t\t// The last occurrence is the instruction of the step; an earlier one may be in the notes.\n \t\tout := b.String()\n \t\tconst sentence = \"Everything outside the block is yours and is not read.\"\n \t\tif at := strings.LastIndex(out, sentence); at >= 0 {\n \t\t\tout = out[:at] + \"Everything outside the block is yours and is not read, except a `decision:` line, which must agree with the decision of the block.\" + out[at+len(sentence):]\n","exit_code":0,"status":"completed"}}
