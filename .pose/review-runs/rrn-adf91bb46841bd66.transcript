tout.Field(\"delegate.dry_run\", tr(\"true (no cancellation requested)\", \"true (nenhum cancelamento pedido)\"))\n  1166\t\t\treturn 0\n  1167\t\t}\n  1168\t\tmarker, err := store.RequestDelegationCancel(attempt.AttemptID)\n  1169\t\tif err != nil {\n  1170\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1171\t\t}\n  1172\t\tdeadline := time.Now().Add(60 * time.Second)\n  1173\t\tfor store.DelegationRunActive(marker) && time.Now().Before(deadline) {\n  1174\t\t\ttime.Sleep(200 * time.Millisecond)\n  1175\t\t}\n  1176\t\tstopped := !store.DelegationRunActive(marker)\n  1177\t\tstatus, run := \"\", \"\"\n  1178\t\tif after, _, err := store.ListDelegationAttempts(); err == nil {\n  1179\t\t\tfor _, a := range after {\n  1180\t\t\t\tif a.AttemptID == attempt.AttemptID && a.Latest() != nil {\n  1181\t\t\t\t\tstatus, run = a.Latest().Status, a.Latest().RunID\n  1182\t\t\t\t}\n  1183\t\t\t}\n  1184\t\t}\n  1185\t\tif f.jsonOut {\n  1186\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": true, \"stopped\": stopped, \"run\": run, \"status\": status})\n  1187\t\t} else {\n  1188\t\t\tout := render(stdout, stderr)\n  1189\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1190\t\t\tout.Field(\"delegate.cancel\", tr(\"requested\", \"pedido\"))\n  1191\t\t\tout.Field(\"delegate.stopped\", fmt.Sprint(stopped))\n  1192\t\t\tif run != \"\" {\n  1193\t\t\t\tout.Field(\"delegate.run\", run)\n  1194\t\t\t\tout.Field(\"delegate.status\", status)\n  1195\t\t\t}\n  1196\t\t}\n  1197\t\tif !stopped {\n  1198\t\t\treturn 1\n  1199\t\t}\n  1200\t\treturn 0\n  1201\t}\n  1202\t\n  1203\t// withDelegationLosses names what the listing could not read beside a run it\n  1204\t// did not find running: the run may be the one an unreadable marker hides.\n  1205\tfunc withDelegationLosses(err error, lost []string) error {\n","exit_code":0,"status":"completed"}}
