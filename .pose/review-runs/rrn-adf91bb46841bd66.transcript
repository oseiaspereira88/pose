{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_reap_linux_test.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os/exec\"\n     7\t\t\"strings\"\n     8\t\t\"testing\"\n     9\t\t\"time\"\n    10\t)\n    11\t\n    12\t// Review round 1, N3: a pid that no longer names a process of the run, as\n    13\t// after reuse by an unrelated process, is never signalled.\n    14\tfunc TestAPidThatLostTheRunsEntryIsNotKilled(t *testing.T) {\n    15\t\tother := exec.Command(\"sleep\", \"30\")\n    16\t\tif err := other.Start(); err != nil {\n    17\t\t\tt.Fatal(err)\n    18\t\t}\n    19\t\tfor i := 0; i < 200 && reviewProcessName(other.Process.Pid) != \"sleep\"; i++ {\n    20\t\t\ttime.Sleep(10 * time.Millisecond)\n    21\t\t}\n    22\t\tt.Cleanup(func() { _ = other.Process.Kill(); _ = other.Wait() })\n    23\t\tentry := []byte(SealedCheckoutEnv + \"=/nonexistent/run-checkout\")\n    24\t\tif err := killPinnedMarkedProcess(other.Process.Pid, entry); err != nil {\n    25\t\t\tt.Fatal(err)\n    26\t\t}\n    27\t\ttime.Sleep(100 * time.Millisecond)\n    28\t\tif zombie, err := reviewProcessZombie(other.Process.Pid); err != nil || zombie {\n    29\t\t\tt.Fatalf(\"a process without the run's entry was killed: zombie=%t %v\", zombie, err)\n    30\t\t}\n    31\t\t// The same process carrying the entry is ended.\n    32\t\tmarked := exec.Command(\"sleep\", \"30\")\n    33\t\tmarked.Env = append(marked.Environ(), string(entry))\n    34\t\tif err := marked.Start(); err != nil {\n    35\t\t\tt.Fatal(err)\n    36\t\t}\n    37\t\t// Until exec, /proc shows the parent's environment.\n    38\t\tfor i := 0; i < 200; i++ {\n    39\t\t\tif ok, _ := reviewProcessMarked(marked.Process.Pid, entry); ok {\n    40\t\t\t\tbreak\n    41\t\t\t}\n    42\t\t\ttime.Sleep(10 * time.Millisecond)\n    43\t\t}\n    44\t\tif err := killPinnedMarkedProcess(marked.Process.Pid, entry); err != nil {\n    45\t\t\tt.Fatal(err)\n    46\t\t}\n    47\t\tif err := marked.Wait(); err == nil {\n    48\t\t\tt.Fatal(\"the marked process was not ended\")\n    49\t\t}\n    50\t}\n    51\t\n    52\t// opaqueProcess starts a process of this user whose environment cannot be\n    53\t// read (it makes itself non-dumpable), or skips without python3.\n    54\tfunc opaqueProcess(t *testing.T) *exec.Cmd {\n    55\t\tt.Helper()\n    56\t\tif _, err := exec.LookPath(\"python3\"); err != nil {\n    57\t\t\tt.Skip(\"python3 is not available\")\n    58\t\t}\n    59\t\tcmd := exec.Command(\"python3\", \"-c\", \"import ctypes,time; ctypes.CDLL(None).prctl(4,0,0,0,0); time.sleep(30)\")\n    60\t\tif err := cmd.Start(); err != nil {\n    61\t\t\tt.Fatal(err)\n    62\t\t}\n    63\t\tt.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })\n    64\t\tfor i := 0; i < 300; i++ {\n    65\t\t\tif _, err := reviewProcessMarked(cmd.Process.Pid, []byte(\"x\")); err != nil && !reviewProcessGoneErr(err) {\n    66\t\t\t\treturn cmd\n    67\t\t\t}\n    68\t\t\ttime.Sleep(10 * time.Millisecond)\n    69\t\t}\n    70\t\tt.Skip(\"the process never became non-inspectable\")\n    71\t\treturn nil\n    72\t}\n    73\t\n    74\t// Review round 2, N2: a non-inspectable process that existed before the run\n    75\t// is not the run's; one that started during it may be, and the scan fails\n    76\t// instead of reporting the run's processes ended.\n    77\tfunc TestANonInspectableProcessStartedDuringTheRunFailsTheScan(t *testing.T) {\n    78\t\tbefore := opaqueProcess(t)\n    79\t\tbaseline := reviewOpaqueProcessBaseline()\n    80\t\tif _, ok := baseline[before.Process.Pid]; !ok {\n    81\t\t\tt.Fatalf(\"the baseline misses process %d\", before.Process.Pid)\n    82\t\t}\n    83\t\tif _, opaque, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err != nil || opaque == 0 {\n    84\t\t\tt.Fatalf(\"a process that predates the run failed the scan or was not counted: %d %v\", opaque, err)\n    85\t\t}\n    86\t\tduring := opaqueProcess(t)\n    87\t\tif _, _, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err == nil || !strings.Contains(err.Error(), \"started during the run\") {\n    88\t\t\tt.Fatalf(\"process %d, started during the run, did not fail the scan: %v\", during.Process.Pid, err)\n    89\t\t}\n    90\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '220,470p'\"","aggregated_output":"   220\t\tif err != nil {\n   221\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n   222\t\t}\n   223\t\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n   224\t\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n   225\t\t}\n   226\t}\n   227\t\n   228\t// Review rounds 2 and 5 (N3, N1): one release runs at a time, under a lock\n   229\t// the operating system releases when its holder ends.\n   230\tfunc TestOneReleaseRunsAtATime(t *testing.T) {\n   231\t\troot := t.TempDir()\n   232\t\ts := Store{Root: root}\n   233\t\tattempt := \"rat-\" + strings.Repeat(\"9\", 64)\n   234\t\tdir, _ := s.delegationActiveDir(true)\n   235\t\tlockPath := filepath.Join(dir, attempt+\".release.lock\")\n   236\t\theld, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0o600)\n   237\t\tif err != nil {\n   238\t\t\tt.Fatal(err)\n   239\t\t}\n   240\t\tunlock, err := lockSpecTransferFile(held)\n   241\t\tif err != nil {\n   242\t\t\tt.Fatal(err)\n   243\t\t}\n   244\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\n   245\t\t\tt.Fatalf(\"a release ran while another held the lock: %v\", err)\n   246\t\t}\n   247\t\tunlock()\n   248\t\theld.Close()\n   249\t\t// A holder that ends releases the lock with it: nothing is left to take over.\n   250\t\tif _, err := exec.LookPath(\"flock\"); err == nil {\n   251\t\t\tholder := exec.Command(\"flock\", lockPath, \"sleep\", \"30\")\n   252\t\t\tholder.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n   253\t\t\tif err := holder.Start(); err != nil {\n   254\t\t\t\tt.Fatal(err)\n   255\t\t\t}\n   256\t\t\ttime.Sleep(200 * time.Millisecond)\n   257\t\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err == nil || !strings.Contains(err.Error(), \"in progress\") {\n   258\t\t\t\tt.Fatalf(\"the other process's lock was not seen: %v\", err)\n   259\t\t\t}\n   260\t\t\t_ = syscall.Kill(-holder.Process.Pid, syscall.SIGKILL)\n   261\t\t\t_ = holder.Wait()\n   262\t\t}\n   263\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil && strings.Contains(err.Error(), \"in progress\") {\n   264\t\t\tt.Fatalf(\"an ended holder's lock still blocks the release: %v\", err)\n   265\t\t}\n   266\t}\n   267\t\n   268\t// Review round 3, N1: a release interrupted after it recorded the run, and\n   269\t// before the receipt, completes with that run instead of recording another.\n   270\tfunc TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n   271\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   272\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   273\t\tif err != nil {\n   274\t\t\tt.Fatal(err)\n   275\t\t}\n   276\t\tattempt := \"\"\n   277\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   278\t\tfunc() {\n   279\t\t\tdefer func() { _ = recover() }()\n   280\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   281\t\t}()\n   282\t\twriteDeadMarker(t, f.store, attempt)\n   283\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   284\t\tmarkerPath := filepath.Join(activeDir, attempt+\".json\")\n   285\t\tmarkerBytes, err := os.ReadFile(markerPath)\n   286\t\tif err != nil {\n   287\t\t\tt.Fatal(err)\n   288\t\t}\n   289\t\tfirst, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   290\t\tif err != nil {\n   291\t\t\tt.Fatal(err)\n   292\t\t}\n   293\t\t// Undo the receipt and keep the marker, as a release stopped between\n   294\t\t// the run and the receipt leaves them.\n   295\t\tattempts, _ := f.store.readDelegatedReviewAttempts(f.bundle.BundleID)\n   296\t\tfor _, a := range attempts {\n   297\t\t\tif a.AttemptID == attempt {\n   298\t\t\t\tif err := os.Remove(attemptReceiptPath(f.store.Root, a)); err != nil {\n   299\t\t\t\t\tt.Fatal(err)\n   300\t\t\t\t}\n   301\t\t\t}\n   302\t\t}\n   303\t\tif err := os.WriteFile(markerPath, markerBytes, 0o600); err != nil {\n   304\t\t\tt.Fatal(err)\n   305\t\t}\n   306\t\tsecond, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   307\t\tif err != nil || second.RunID != first.RunID {\n   308\t\t\tt.Fatalf(\"the interrupted release recorded another run: %s then %s (%v)\", first.RunID, second.RunID, err)\n   309\t\t}\n   310\t}\n   311\t\n   312\t// Review round 2, N1: a reservation an earlier engine left with no marker is\n   313\t// listed and released once it is old enough, never while it is young.\n   314\tfunc TestAMarkerlessReservationOfAnEarlierEngineIsReleased(t *testing.T) {\n   315\t\troot := t.TempDir()\n   316\t\ts := Store{Root: root}\n   317\t\treserve := func(age time.Duration, nonce string) DelegatedReviewAttempt {\n   318\t\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000b\" + nonce[:1], BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   319\t\t\t\tReservedAt: time.Now().Add(-age).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(nonce[:1], 32)}\n   320\t\t\ta.AttemptID = attemptIdentity(a)\n   321\t\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   322\t\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   323\t\t\t\tt.Fatal(err)\n   324\t\t\t}\n   325\t\t\treturn a\n   326\t\t}\n   327\t\told, young := reserve(time.Hour, \"1\"), reserve(time.Minute, \"2\")\n   328\t\tattempts, _, err := s.ListDelegationAttempts()\n   329\t\tif err != nil {\n   330\t\t\tt.Fatal(err)\n   331\t\t}\n   332\t\tlisted := map[string]DelegationAttempt{}\n   333\t\tfor _, a := range attempts {\n   334\t\t\tlisted[a.AttemptID] = a\n   335\t\t}\n   336\t\tif a, ok := listed[old.AttemptID]; !ok || a.State != DelegationStalled || !strings.Contains(a.Failure, \"pose delegate cancel \"+old.AttemptID+\" --confirm-abandoned\") {\n   337\t\t\tt.Fatalf(\"the old markerless reservation is not listed with its release: %+v\", attempts)\n   338\t\t}\n   339\t\tif _, ok := listed[young.AttemptID]; ok {\n   340\t\t\tt.Fatal(\"a young reservation was listed as abandoned\")\n   341\t\t}\n   342\t\tif _, err := s.ReleaseAbandonedAttempt(young.AttemptID, time.Now(), true); !errors.Is(err, ErrAttemptNotAbandoned) {\n   343\t\t\tt.Fatalf(\"a young reservation was released: %v\", err)\n   344\t\t}\n   345\t\t// Review round 3, N2: nothing proves a markerless reservation abandoned,\n   346\t\t// so it is released only on the operator's confirmation.\n   347\t\tif _, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"--confirm-abandoned\") {\n   348\t\t\tt.Fatalf(\"a markerless reservation was released without confirmation: %v\", err)\n   349\t\t}\n   350\t\trun, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n   351\t\tif err != nil || run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"operator's confirmation\") {\n   352\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   353\t\t}\n   354\t\tif _, err := s.readAttemptReceipt(old); err != nil {\n   355\t\t\tt.Fatalf(\"the released reservation still blocks its bundle: %v\", err)\n   356\t\t}\n   357\t\t// Review round 4, N1: a release stopped between its run and its receipt\n   358\t\t// leaves the attempt with a run; it is still released, with that run.\n   359\t\tif err := os.Remove(attemptReceiptPath(root, old)); err != nil {\n   360\t\t\tt.Fatal(err)\n   361\t\t}\n   362\t\tagain, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n   363\t\tif err != nil || again.RunID != run.RunID {\n   364\t\t\tt.Fatalf(\"the interrupted release did not complete with its run: %s then %s (%v)\", run.RunID, again.RunID, err)\n   365\t\t}\n   366\t}\n   367\t\n   368\t// Review round 3, N3: an unreadable reservation is reported, not skipped.\n   369\tfunc TestAnUnreadableReservationIsReportedAsALoss(t *testing.T) {\n   370\t\troot := t.TempDir()\n   371\t\ts := Store{Root: root}\n   372\t\tdir := filepath.Join(root, reviewAttemptDir, \"broken\")\n   373\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n   374\t\t\tt.Fatal(err)\n   375\t\t}\n   376\t\tif err := os.WriteFile(filepath.Join(dir, \"000001.json\"), []byte(\"{not json\"), 0o644); err != nil {\n   377\t\t\tt.Fatal(err)\n   378\t\t}\n   379\t\t_, lost, err := s.ListDelegationAttempts()\n   380\t\tif err != nil || !strings.Contains(strings.Join(lost, \"\\n\"), \"broken/000001.json could not be read\") {\n   381\t\t\tt.Fatalf(\"an unreadable reservation was skipped silently: %v %v\", lost, err)\n   382\t\t}\n   383\t}\n   384\t\n   385\t// Review round 4, N3: with the run history incomplete, no reservation is\n   386\t// taken as runless, and the loss is reported.\n   387\tfunc TestAnIncompleteRunHistoryRulesNothingOut(t *testing.T) {\n   388\t\troot := t.TempDir()\n   389\t\ts := Store{Root: root}\n   390\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000c1\", BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   391\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"3\", 32)}\n   392\t\ta.AttemptID = attemptIdentity(a)\n   393\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   394\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   395\t\t\tt.Fatal(err)\n   396\t\t}\n   397\t\tif err := os.MkdirAll(filepath.Join(root, reviewRunsDir), 0o755); err != nil {\n   398\t\t\tt.Fatal(err)\n   399\t\t}\n   400\t\tif err := os.WriteFile(filepath.Join(root, reviewRunsDir, \"rrn-0000000000000bad.json\"), []byte(\"{broken\"), 0o644); err != nil {\n   401\t\t\tt.Fatal(err)\n   402\t\t}\n   403\t\tif _, runLost, err := s.ReadReviewRuns(\"\"); err != nil || len(runLost) == 0 {\n   404\t\t\tt.Skipf(\"the fixture does not make the run history incomplete: %v %v\", runLost, err)\n   405\t\t}\n   406\t\torphans, lost, err := s.orphanReservations(time.Now())\n   407\t\tif err != nil || len(orphans) != 0 || !strings.Contains(strings.Join(lost, \"\\n\"), \"run history is incomplete\") {\n   408\t\t\tt.Fatalf(\"an incomplete history ruled a run out: %v %v %v\", orphans, lost, err)\n   409\t\t}\n   410\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n   411\t\t\tt.Fatal(\"a reservation was released over an incomplete run history\")\n   412\t\t}\n   413\t}\n   414\t\n   415\t// Review round 5, N3: a dispatch that recorded its run and stopped before\n   416\t// the receipt is completed with that run, not with a second one; N2: a\n   417\t// release that stopped after the receipt only removes the marker.\n   418\tfunc TestARecordedRunCompletesItsAttempt(t *testing.T) {\n   419\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   420\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"receipt lost\")\n   421\t\tif err != nil {\n   422\t\t\tt.Fatal(err)\n   423\t\t}\n   424\t\tsaved := beforeRunResultPublished\n   425\t\tt.Cleanup(func() { beforeRunResultPublished = saved })\n   426\t\trecorded := \"\"\n   427\t\tbeforeRunResultPublished = func(r ReviewRun) { recorded = r.RunID; panic(\"the dispatching process ends before the receipt\") }\n   428\t\tfunc() {\n   429\t\t\tdefer func() { _ = recover() }()\n   430\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   431\t\t}()\n   432\t\tbeforeRunResultPublished = saved\n   433\t\truns, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID)\n   434\t\tif recorded == \"\" || len(runs) == 0 {\n   435\t\t\tt.Fatalf(\"the dispatch recorded no run: %q %d\", recorded, len(runs))\n   436\t\t}\n   437\t\tattempt := runs[len(runs)-1].AttemptID\n   438\t\twriteDeadMarker(t, f.store, attempt)\n   439\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   440\t\tmarkerBytes, _ := os.ReadFile(filepath.Join(activeDir, attempt+\".json\"))\n   441\t\treleased, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   442\t\tif err != nil || released.RunID != recorded {\n   443\t\t\tt.Fatalf(\"the release did not complete with the recorded run %s: %s %v\", recorded, released.RunID, err)\n   444\t\t}\n   445\t\tif after, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID); len(after) != len(runs) {\n   446\t\t\tt.Fatalf(\"the release recorded another run: %d then %d\", len(runs), len(after))\n   447\t\t}\n   448\t\t// The marker comes back, as a release stopped after the receipt leaves it.\n   449\t\tif err := os.WriteFile(filepath.Join(activeDir, attempt+\".json\"), markerBytes, 0o600); err != nil {\n   450\t\t\tt.Fatal(err)\n   451\t\t}\n   452\t\tagain, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   453\t\tif err != nil || again.RunID != recorded {\n   454\t\t\tt.Fatalf(\"a release after the receipt did not complete: %s %v\", again.RunID, err)\n   455\t\t}\n   456\t\tif left, _ := filepath.Glob(filepath.Join(activeDir, attempt+\".json\")); len(left) != 0 {\n   457\t\t\tt.Fatal(\"the stalled marker stayed after the receipt\")\n   458\t\t}\n   459\t}\n","exit_code":0,"status":"completed"}}
