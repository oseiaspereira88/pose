ately from the adapter's runtime\n   629\t// output. Both the opened directory and the removal target must be the\n   630\t// directory setup created inside the operation root.\n   631\tfunc removeReviewGitlinkMetadata(root *os.Root, owned os.FileInfo, limit int64) error {\n   632\t\tdir, err := root.OpenRoot(reviewGitlinkMetadataDir)\n   633\t\tif err != nil {\n   634\t\t\treturn fmt.Errorf(\"private gitlink metadata cleanup unavailable\")\n   635\t\t}\n   636\t\tdefer dir.Close()\n   637\t\tinfo, err := dir.Stat(\".\")\n   638\t\tif err != nil || !os.SameFile(owned, info) {\n   639\t\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n   640\t\t}\n   641\t\tif err := removeReviewOwnedContents(dir, 100000, limit); err != nil {\n   642\t\t\treturn err\n   643\t\t}\n   644\t\tinfo, err = root.Lstat(reviewGitlinkMetadataDir)\n   645\t\tif err != nil || !os.SameFile(owned, info) {\n   646\t\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n   647\t\t}\n   648\t\tdir.Close()\n   649\t\tif err := root.Remove(reviewGitlinkMetadataDir); err != nil {\n   650\t\t\treturn fmt.Errorf(\"private gitlink metadata cleanup incomplete\")\n   651\t\t}\n   652\t\treturn nil\n   653\t}\n   654\t\n   655\t// reviewGoBuildDir names the temporary build directory the Go toolchain\n   656\t// creates under the TMPDIR the engine gives a review run.\n   657\tvar reviewGoBuildDir = regexp.MustCompile(`^go-build[0-9]+$`)\n   658\t\n   659\t// reviewGoBuildBeforeOpen runs after a go-build name is listed and before it\n   660\t// is opened, reviewGoBuildAfterContents after the directory is emptied and\n","exit_code":0,"status":"completed"}}
