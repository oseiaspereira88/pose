{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '1,220p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"context\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"path/filepath\"\n    12\t\t\"strings\"\n    13\t\t\"syscall\"\n    14\t\t\"testing\"\n    15\t\t\"time\"\n    16\t)\n    17\t\n    18\t// Spec pose-review-run-reaps-lingering-reviewer-processes R5, R6: a dispatch\n    19\t// that ended between its reservation and its run record leaves an attempt\n    20\t// that blocks the bundle; once its owner is proven gone, cancel releases it\n    21\t// with a failed run and its receipt, and the ledger reads again.\n    22\tfunc TestAnAbandonedAttemptIsReleasedWithARecord(t *testing.T) {\n    23\t\troot := t.TempDir()\n    24\t\ts := Store{Root: root}\n    25\t\tbundle := \"rvb-00000000000000a1\"\n    26\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n    27\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"0\", 32)}\n    28\t\ta.AttemptID = attemptIdentity(a)\n    29\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    30\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    31\t\t\tt.Fatal(err)\n    32\t\t}\n    33\t\t// The ledger refuses the bundle while the reservation has no receipt.\n    34\t\tif _, err := s.readAttemptReceipt(a); err == nil || !strings.Contains(err.Error(), \"incomplete or unreadable\") {\n    35\t\t\tt.Fatalf(\"an unfinished reservation read as finished: %v\", err)\n    36\t\t}\n    37\t\n    38\t\t// The marker the interrupted dispatch left: its owner is a process that\n    39\t\t// has exited.\n    40\t\tdead := exec.Command(\"true\")\n    41\t\tif err := dead.Run(); err != nil {\n    42\t\t\tt.Fatal(err)\n    43\t\t}\n    44\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    45\t\towner.Host, _ = os.Hostname()\n    46\t\tidentifyStartLockProcess(&owner)\n    47\t\towner.PID = dead.Process.Pid\n    48\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"b\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: a.Scope, BundleID: bundle,\n    49\t\t\tStartedAt: a.ReservedAt, Owner: owner, HeartbeatAt: a.ReservedAt, HeartbeatEvery: 10}\n    50\t\tdir, err := s.delegationActiveDir(true)\n    51\t\tif err != nil {\n    52\t\t\tt.Fatal(err)\n    53\t\t}\n    54\t\traw, _ := json.Marshal(marker)\n    55\t\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), raw, 0o600); err != nil {\n    56\t\t\tt.Fatal(err)\n    57\t\t}\n    58\t\n    59\t\trun, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false)\n    60\t\tif err != nil {\n    61\t\t\tt.Fatal(err)\n    62\t\t}\n    63\t\tif run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"abandoned\") {\n    64\t\t\tt.Fatalf(\"the release recorded %s: %s\", run.Status, run.Failure)\n    65\t\t}\n    66\t\tif _, err := s.readAttemptReceipt(a); err != nil {\n    67\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n    68\t\t}\n    69\t\tif left, _ := filepath.Glob(filepath.Join(dir, a.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n    70\t\t\tt.Fatalf(\"the marker or its stall claim stayed: %v\", left)\n    71\t\t}\n    72\t\t// Released once: a second release finds nothing abandoned.\n    73\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n    74\t\t\tt.Fatalf(\"a released attempt was released again: %v\", err)\n    75\t\t}\n    76\t}\n    77\t\n    78\t// An attempt whose owner is alive is never released.\n    79\tfunc TestARunningAttemptIsNotReleased(t *testing.T) {\n    80\t\troot := t.TempDir()\n    81\t\ts := Store{Root: root}\n    82\t\tbundle := \"rvb-00000000000000a2\"\n    83\t\t// Silent for an hour, so only the owner's liveness keeps it running.\n    84\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n    85\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1, ReservedAt: old, Nonce: strings.Repeat(\"0\", 32)}\n    86\t\ta.AttemptID = attemptIdentity(a)\n    87\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    88\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    89\t\t\tt.Fatal(err)\n    90\t\t}\n    91\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    92\t\towner.Host, _ = os.Hostname()\n    93\t\tidentifyStartLockProcess(&owner)\n    94\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"d\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: bundle, StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n    95\t\tdir, _ := s.delegationActiveDir(true)\n    96\t\traw, _ := json.Marshal(marker)\n    97\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n    98\t\t\tt.Fatal(err)\n    99\t\t}\n   100\t\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n   101\t\t\tt.Fatalf(\"a running attempt was released: %v\", err)\n   102\t\t}\n   103\t}\n   104\t\n   105\t// Review round 1, N1: the dispatch marks the attempt active before it\n   106\t// publishes the reservation, so no instant leaves a reservation without a\n   107\t// marker that turns stalled.\n   108\tfunc TestTheAttemptIsMarkedActiveBeforeItIsReserved(t *testing.T) {\n   109\t\tvar checked bool\n   110\t\tbeforeAttemptPublished = func(store Store, a DelegatedReviewAttempt) {\n   111\t\t\tchecked = true\n   112\t\t\tmarkers, _, err := store.ListDelegationActive()\n   113\t\t\tfound := false\n   114\t\t\tfor _, m := range markers {\n   115\t\t\t\tfound = found || m.AttemptID == a.AttemptID\n   116\t\t\t}\n   117\t\t\tif err != nil || !found {\n   118\t\t\t\tt.Errorf(\"the reservation of %s is published with no active marker: %v\", a.AttemptID, err)\n   119\t\t\t}\n   120\t\t\tif _, err := os.Lstat(reviewAttemptPath(store.Root, a)); !errors.Is(err, os.ErrNotExist) {\n   121\t\t\t\tt.Errorf(\"the reservation was published before the marker: %v\", err)\n   122\t\t\t}\n   123\t\t}\n   124\t\tt.Cleanup(func() { beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {} })\n   125\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\")\n   126\t\tif !checked {\n   127\t\t\tt.Fatal(\"the dispatch never reached the reservation\")\n   128\t\t}\n   129\t}\n   130\t\n   131\t// A marker whose dispatch ended before publishing the reservation is removed\n   132\t// by the release; ls names the cause and the release command (N2).\n   133\tfunc TestAStalledMarkerWithoutReservationIsListedAndRemoved(t *testing.T) {\n   134\t\troot := t.TempDir()\n   135\t\ts := Store{Root: root}\n   136\t\tdead := exec.Command(\"true\")\n   137\t\tif err := dead.Run(); err != nil {\n   138\t\t\tt.Fatal(err)\n   139\t\t}\n   140\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:x\", Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n   141\t\towner.Host, _ = os.Hostname()\n   142\t\tidentifyStartLockProcess(&owner)\n   143\t\towner.PID = dead.Process.Pid\n   144\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   145\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: \"rat-\" + strings.Repeat(\"e\", 64), RunToken: strings.Repeat(\"f\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: \"rvb-00000000000000a3\", StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n   146\t\tdir, _ := s.delegationActiveDir(true)\n   147\t\traw, _ := json.Marshal(marker)\n   148\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n   149\t\t\tt.Fatal(err)\n   150\t\t}\n   151\t\tattempts, _, err := s.ListDelegationAttempts()\n   152\t\tif err != nil || len(attempts) != 1 || attempts[0].State != DelegationStalled || !strings.Contains(attempts[0].Failure, DelegationAbandonedCause) || !strings.Contains(attempts[0].Failure, \"pose delegate cancel \"+marker.AttemptID) {\n   153\t\t\tt.Fatalf(\"the abandoned attempt is not listed with its cause: %+v %v\", attempts, err)\n   154\t\t}\n   155\t\trun, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false)\n   156\t\tif err != nil || run.RunID != \"\" {\n   157\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   158\t\t}\n   159\t\tif left, _ := filepath.Glob(filepath.Join(dir, marker.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n   160\t\t\tt.Fatalf(\"the marker stayed: %v\", left)\n   161\t\t}\n   162\t}\n   163\t\n   164\t// writeDeadMarker rewrites the marker of attempt so its owner is a process\n   165\t// that has exited and its heartbeat is an hour old, as a dispatch killed\n   166\t// mid-run leaves it.\n   167\tfunc writeDeadMarker(t *testing.T, s Store, attempt string) {\n   168\t\tt.Helper()\n   169\t\tdir, err := s.delegationActiveDir(false)\n   170\t\tif err != nil {\n   171\t\t\tt.Fatal(err)\n   172\t\t}\n   173\t\tpath := filepath.Join(dir, attempt+\".json\")\n   174\t\traw, err := os.ReadFile(path)\n   175\t\tif err != nil {\n   176\t\t\tt.Fatal(err)\n   177\t\t}\n   178\t\tvar marker DelegationActiveRun\n   179\t\tif err := json.Unmarshal(raw, &marker); err != nil {\n   180\t\t\tt.Fatal(err)\n   181\t\t}\n   182\t\tdead := exec.Command(\"true\")\n   183\t\tif err := dead.Run(); err != nil {\n   184\t\t\tt.Fatal(err)\n   185\t\t}\n   186\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   187\t\tmarker.Owner.PID, marker.HeartbeatAt, marker.StartedAt = dead.Process.Pid, old, old\n   188\t\traw, _ = json.Marshal(marker)\n   189\t\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n   190\t\t\tt.Fatal(err)\n   191\t\t}\n   192\t}\n   193\t\n   194\t// Review round 2, N4 (R6): a real dispatch interrupted after its reservation\n   195\t// and before its run record blocks the next dispatch; once released, the\n   196\t// next dispatch runs.\n   197\tfunc TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns(t *testing.T) {\n   198\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   199\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   200\t\tif err != nil {\n   201\t\t\tt.Fatal(err)\n   202\t\t}\n   203\t\tattempt := \"\"\n   204\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   205\t\tfunc() {\n   206\t\t\tdefer func() { _ = recover() }()\n   207\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   208\t\t}()\n   209\t\tif attempt == \"\" {\n   210\t\t\tt.Fatal(\"the dispatch never reached its start\")\n   211\t\t}\n   212\t\twriteDeadMarker(t, f.store, attempt)\n   213\t\tif _, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after interruption\"); err == nil || !strings.Contains(err.Error(), \"pose delegate cancel \"+attempt) {\n   214\t\t\tt.Fatalf(\"the interrupted attempt did not block the bundle with its release command: %v\", err)\n   215\t\t}\n   216\t\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil {\n   217\t\t\tt.Fatal(err)\n   218\t\t}\n   219\t\tnext, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\")\n   220\t\tif err != nil {\n","exit_code":0,"status":"completed"}}
