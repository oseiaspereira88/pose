{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '66,96p' pose-mcp/internal/pose/governed_capabilities.go; rg -n 'POSE_PROJECT|POSE_ROOT|PROJECT_ROOT|root =' pose-mcp/cmd/pose/main.go pose-mcp/internal/cli/run.go | head -40; git status --short; git log -8 --oneline\"","aggregated_output":"// AdoptGovernedCapability sets the capability's keys in a raw review-policy\n// document, dated date, and returns what it changed. An adopted capability\n// keeps the date it was adopted on: adopting it again changes nothing, so a\n// rerun can never move a cutoff and re-judge work.\nfunc AdoptGovernedCapability(doc map[string]any, capability GovernedCapability, date string) []string {\n\tchanges := []string{}\n\tif !governedVersionSet(doc, capability) {\n\t\tdoc[capability.VersionKey] = capability.Version\n\t\tchanges = append(changes, \"set \"+capability.VersionKey+\"=\"+strconv.Itoa(capability.Version))\n\t\tif capability.DateKey != \"\" {\n\t\t\tdoc[capability.DateKey] = date\n\t\t\tchanges = append(changes, \"set \"+capability.DateKey+\"=\"+date)\n\t\t}\n\t}\n\tif capability.Overlay != \"\" {\n\t\toverlays := governedStringList(doc[\"overlay_profiles\"])\n\t\tif !containsString(overlays, capability.Overlay) {\n\t\t\tdoc[\"overlay_profiles\"] = toAnyList(append(overlays, capability.Overlay))\n\t\t\tdates, _ := doc[\"overlay_adopted_at\"].(map[string]any)\n\t\t\tif dates == nil {\n\t\t\t\tdates = map[string]any{}\n\t\t\t}\n\t\t\tdates[capability.Overlay] = date\n\t\t\tdoc[\"overlay_adopted_at\"] = dates\n\t\t\tchanges = append(changes, \"add overlay_profiles \"+capability.Overlay, \"set overlay_adopted_at.\"+capability.Overlay+\"=\"+date)\n\t\t}\n\t}\n\treturn changes\n}\n\n// RetireGovernedCapability removes the keys AdoptGovernedCapability sets and\nrg: pose-mcp/internal/cli/run.go: No such file or directory (os error 2)\n5c3c8045 chore: regenerate indexes after the validation record\nd7dafb20 chore: record strict validation after final closeout pass\n53d3a2cd chore: regenerate indexes for the adopt request preview\n0a1ec447 chore: regenerate indexes for the adopt request preview\naf8a3ded chore: start the adopt request preview spec\n0f55a24e fix: name the policy an answered adoption request writes in its preview\n43099880 chore: refresh assessments after closing the index material bugfix\n8c0407e5 chore: regenerate indexes after closing the index material bugfix\n","exit_code":0,"status":"completed"}}
