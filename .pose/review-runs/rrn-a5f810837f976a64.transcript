d\", \"when-justified\", \"--roadmap-review-required\", \"always\", \"--apply\"); code != 0 {\npose-mcp/internal/cli/closeout_review_policy_test.go:200:\tif code, out := runPose(t, root, \"adopt\", \"closeout-review-policy\", \"--off\", \"--apply\"); code == 0 || !strings.Contains(out, \"cannot be turned off\") {\npose-mcp/internal/cli/closeout_review_policy_test.go:257:\tif code, out := runBuilt(t, root, \"adopt\", \"closeout-review-policy\", \"--milestone-review-required\", \"when-justified\", \"--roadmap-review-required\", \"never\", \"--apply\"); code != 0 {\npose-mcp/internal/cli/closeout_review_policy_test.go:312:func TestCloseoutReviewPolicyAdoptRequestRefusesThePair(t *testing.T) {\npose-mcp/internal/cli/review_closeout.go:1958:\t// pose-closeout-review-policy-by-cost-benefit) the close of a milestone or a\n2026-10-11-pose-front-01-reconciliation.json\n2026-10-11-pose-front-02-trust-chain.json\n2026-10-11-pose-front-03-delegated-review.json\n2026-10-11-pose-front-03-dispatch-probes.py\n2026-10-12-pose-front-04-action-probes.py\n2026-10-12-pose-front-04-actions-obligations.json\n2026-10-12-pose-front-05-residual-probes.py\n2026-10-12-pose-front-05-residual-work.json\n2026-10-12-pose-front-06-release-probes.py\n2026-10-12-pose-front-06-release-sufficiency.json\n2026-10-12-pose-front-07-operational-ux.json\n2026-10-12-pose-front-07-ux-probes.py\n2026-10-12-pose-front-08-benchmarks.py\n2026-10-12-pose-front-08-check-benchmark.py\n2026-10-12-pose-front-08-performance.json\n2026-10-12-pose-front-09-consistency.json\n2026-10-12-pose-front-09-probes.py\n2026-10-12-pose-front-10-build-backlog.py\n2026-10-12-pose-front-10-consolidated-backlog.json\nabm-dependency-review.json\nabm-progressive-review-validation.json\nb01-action-acceptance.json\nb01-action-artifact-check.log\nb01-action-closeout-admission.json\nb01-action-closeout-apply.log\nb01-action-closeout-check.json\nb01-action-closeout-context-retry.log\nb01-action-closeout-plan.json\nb01-action-closeout-resume.lo