tup\") {\n   278\t\t\tt.Fatalf(\"resolve does not name the empty role: %d %s\", code, out)\n   279\t\t}\n   280\t}\n   281\t\n   282\t// Spec pose-adopt-request-shows-what-it-sets: the preview of an answered\n   283\t// adoption names every policy change its apply writes, and the apply writes\n   284\t// them.\n   285\tfunc TestAnAnsweredAdoptionPreviewNamesThePolicyItWrites(t *testing.T) {\n   286\t\trepo, requests := reviewedInstance(t)\n   287\t\treq := requestFor(t, requests, \"contract-nodes\")\n   288\t\tanswerReview(t, repo, req, \"adopt\", \"\")\n   289\t\tdocs, err := posemodel.LoadPolicyDocs(repo)\n   290\t\tif err != nil {\n   291\t\t\tt.Fatal(err)\n   292\t\t}\n   293\t\tentry, ok := posemodel.LookupCatalogEntry(\"contract-nodes\")\n   294\t\tif !ok {\n   295\t\t\tt.Fatal(\"contract-nodes is not in the catalog\")\n   296\t\t}\n   297\t\twant := entry.Adopt(docs, \"2026-11-14\")\n   298\t\tif len(want) == 0 {\n   299\t\t\tt.Fatal(\"the fixture's adoption changes nothing\")\n   300\t\t}\n   301\t\tcode, out := runPose(t, repo, \"adopt\", \"--request\", req.View.Request.ID)\n   302\t\tif code != 0 {\n   303\t\t\tt.Fatalf(\"preview: %s\", out)\n   304\t\t}\n   305\t\tfor _, change := range want {\n   306\t\t\tif !strings.Contains(out, \"adopt.change=\"+change) {\n   307\t\t\t\tt.Fatalf(\"the preview does not name %q, which the apply writes:\\n%s\", change, out)\n   308\t\t\t}\n   309\t\t}\n   310\t\tif code, out := runPose(t, repo, \"adopt\", \"--request\", req.View.Request.ID, \"--apply\"); code != 0 {\n   311\t\t\tt.Fatalf(\"apply: %s\", out)\n   312\t\t}\n   313\t\tif states, _ := posemodel.CapabilityStates(repo); stateOf(states, \"contract-nodes\") == posemodel.CapabilityOff {\n   314\t\t\tt.Fatal(\"the apply did not adopt what its preview named\")\n   315\t\t}\n   316\t}\npose-mcp/internal/pose/governed_capabilities.go:66:// AdoptGovernedCapability sets the capability's keys in a raw review-policy\npose-mcp/internal/pose/governed_capabilities.go:70:func