Files(files Files) *governanceReadView {\n\tfor depth := 0; depth < maxGovernanceFilesWrappers; depth++ {\n\t\tfiles = FilesOrNative(files)\n\t\tif provider, ok := files.(interface{ GovernanceReadView() *governanceReadView }); ok {\n\t\t\tif view := provider.GovernanceReadView(); view != nil {\n\t\t\t\tview.mu.Lock()\n\t\t\t\tactive := !view.closed\n\t\t\t\tview.mu.Unlock()\n\t\t\t\tif active {\n\t\t\t\t\treturn view\n\t\t\t\t}\n\t\t\t\t// A Store escaped its read-only callback. Its finalized bytes cannot\n\t\t\t\t// serve as this operation's current input; let the caller unwrap it\n\t\t\t\t// and start a fresh operation over the original Files binding.\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t\tunderlying, ok := files.(interface{ UnderlyingFiles() Files })\n\t\tif !ok {\n\t\t\treturn nil\n\t\t}\n\t\tfiles = underlying.UnderlyingFiles()\nfunc (op *governanceReadViewOperation) rootsForProducer(roots *Roots, files Files, producer string) *Roots {\n\tif roots == nil || op == nil {\n\t\treturn nil\n\t}\n\troots.mu.RLock()\n\tcfg := roots.cfg\n\troots.mu.RUnlock()\n\top.mu.Lock()\n\trootMap, conflicts := op.initialRoots, op.initialConflicts\n\top.mu.Unlock()\n\treturn &Roots{\n\t\tcfg: cfg, byProject: rootMap, conflicts: conflicts, governanceStores: map[string]Store{},\n\t\tlastScan: time.Now(), rescanWindow: time.Duration(1 << 62), fs: files,\n\t}\n}\n\ntype readViewFile struct {\n\treader  *bytes.Reader\n\tinfo    fs.FileInfo\n\treadErr error\n}\n\nfunc newGovernanceReadFile(data []byte, info fs.FileInfo, readErrors ...error) *readViewFile {\n\tvar readErr error\n\tif len(readErrors) > 0 {\n\t\treadErr = readErrors[0]\n\t}\n\treturn &readViewFile{reader: bytes.NewReader(data), info: frozenInfo(info), readErr: readErr}\n}\nfunc (f *readViewFile) Stat() (fs.FileInfo, error) {\n\tif f.info == nil {\n\t\treturn nil, fs.ErrInvalid\n\t}\n\treturn f.info, nil\n}\nfunc (f *readViewFile) Read(p []byte) (int, error) {\n\tif f.reader.Len() == 0 && f.readErr != nil {\n\t\treturn 0, f.readErr\n\t}\n\tn, err := f.reader.Read(p)\n\tif err == nil && n > 0 && f.readErr != nil {\n\t\treturn n, f.readErr\n\t}\n\treturn n, err\n}\nfunc (*readViewFile) Close() error { return nil }\n\ntype readViewDirectoryFile struct {\n\tname     string\n\tproducer string\n\tentries  []fs.DirEntry\n\tinfo     fs.FileInfo\n\tcursor   int\n\t\teval.Warnings = append(eval.Warnings, \"review is not required for a legacy done scope created before policy adoption\")\n\t\treturn eval, nil\n\t}\n\tif profileRef == \"\" {\n\t\teval.Blockers = append(eval.Blockers, \"review policy has no profile for \"+scope.Kind)\n\t\treturn eval, nil\n\t}\n\tif policy.SchemaVersion >= ReviewPolicySchemaVersion && policy.ReviewBundles {\n\t\tdone, _ := s.scopeLifecycleDone(scope)\n\t\tverification, verifyErr := s.VerifyReviewBundle(ref)\n\t\tif verifyErr == nil && verification.Approved {\n\t\t\teval.Fresh = verification.Fresh\n\t\t\teval.Approved = verification.Approved\n\t\t\teval.Blockers = append(eval.Blockers, verification.Blockers...)\n\t\t\teval.Warnings = append(eval.Warnings, verification.Warnings...)\n\t\t\teval.BundleState = verification.State\n\t\t\tif verification.Bundle != nil {\n\t\t\t\teval.ScopeDigest = verification.Bundle.BundleDigest\n\t\t\t\teval.BundleID = verification.Bundle.BundleID\n\t\t\t\teval.settledBundle = verification.Bundle\n\t\t\t\teval.BundleDigest = verification.Bundle.BundleDigest\n\t\t\t\teval.PlanDigest = verification.Bundle.Payload.Plan.PlanDigest\n\t\t\t}\n\t\t\tif verification.Attestation != nil {\n\t\t\t\teval.AttestationID = verification.Attestation.AttestationID\n\t\t\t\teval.settledAttestation = verification.Attestation\n\t\t\t\tatt := verification.Attestation\n\t\t\t\teval.Current = &ReviewAttempt{SchemaVersion: ReviewBundleSchemaVersion, ReviewID: att.AttestationID, Scope: ref, ScopeDigest: att.BundleDigest, PlanDigest: eval.PlanDigest, Profile: profileRef, Reviewer: att.Reviewer, Decision: att.Decision, ReviewedAt: att.AttestedAt, Supersedes: att.Supersedes, EvidenceRefs: att.EvidenceRefs, Criteria: att.Criteria, Tools: att.Tools, Findings: att.Findings, Path: att.Path}\n\t\t\t}\n\t\t\teval.Blockers = uniqueSorted(eval.Blockers)\n\t\t\teval.Warnings = uniqueSorted(eval.Warnings)\n\t\t\treturn eval, nil\n\t\t}\n\t\tif done {\n\t\t\tbundle, att, retainLost, childBlockers := s.retainedCompletedReviewWithHistory(scope, ref, policy)\n\t\t\tif len(retainLost) > 0 {\n\t\t\t\teval.Blockers = append(eval.Blockers, \"the approval of \"+ref+\" cannot be retained: the attestation history of its bundle is incomplete, so the latest readable attestation is not known to be the current one: \"+(SourceCoverage{Losses: retainLost}).Describe(\"\")+\"; restore or remove the unreadable record\")\n\t\t\t}\n\t\t\teval.Blockers = append(eval.Blockers, childBlockers...)\n\t\t\trefused := bundle != nil && (!s.sealedDeclarationHolds(bundle) || s.FederatedResolver != nil && (verifyErr != nil || !s.retainedApprovalStands(bundle, verification.currentManifest)))\n\t\t\tif bundle != nil && !refused {\n\t\t\t\teval.Fresh = true\n\t\t\t\teval.Approved = true\n\t\t\t\teval.BundleState = \"closed\"\n\t\t\t\teval.ScopeDigest = bundle.BundleDigest\n\t\t\t\teval.BundleID = bundle.BundleID\n","exit_code":0,"status":"completed"}}
