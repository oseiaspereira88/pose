{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'func IsSealedCheckout|func .*SealedCheckout|POSE_SEALED' pose-mcp/internal/pose/*.go; sed -n '1,90p' pose-mcp/internal/cli/sealed_checkout_refresh_test.go; rg -n '\\\"(delta|facts|structural_facts|decisions|decision_basis|requirement)' .pose/results/b01-action-independent-design.json | head -15; git diff 5e14337100be40d52508587fbc42a070c0b79c6e..ee960dffb9ba49a8ad255a31076cf3ca146fef92 -- .pose/starts/pose-index-material-does-not-ask-closeout.json; sed -n '1,65p' .pose/assessments/technical-debt.md; sed -n '1,55p' .pose/assessments/integrations.md\"","aggregated_output":"pose-mcp/internal/pose/checkout_blockers_child_evidence_test.go:9:func TestTheSealedCheckoutIsNotBlockedByChildEvidenceItCannotHold(t *testing.T) {\npose-mcp/internal/pose/delegation_refusal.go:32:const SealedCheckoutEnv = \"POSE_SEALED_CHECKOUT\"\npose-mcp/internal/pose/delegation_refusal.go:37:func IsSealedCheckout(root string) bool {\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n\n\tposepkg \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\n// A diagnostic run inside a sealed review checkout leaves the delivery index as\n// sealed; outside one it publishes as before (spec\n// pose-validation-evidence-material-binding R7).\nfunc TestRefreshDeliveryIndexLeavesASealedCheckoutAlone(t *testing.T) {\n\troot := t.TempDir()\n\tother := t.TempDir()\n\ttarget := filepath.Join(root, \".pose\", \"indexes\", \"delivery-integrity.json\")\n\tt.Setenv(posepkg.SealedCheckoutEnv, root)\n\tvar stderr bytes.Buffer\n\trefreshDeliveryIndex(root, []byte(\"{}\\n\"), &stderr)\n\tif _, err := os.Stat(target); err == nil {\n\t\tt.Fatal(\"a sealed checkout was written\")\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".pose\", \"indexes\")); err == nil {\n\t\tt.Fatal(\"a sealed checkout gained a directory\")\n\t}\n\t// Another project the same process works in is not the sealed checkout.\n\trefreshDeliveryIndex(other, []byte(\"{}\\n\"), &stderr)\n\tif _, err := os.Stat(filepath.Join(other, \".pose\", \"indexes\", \"delivery-integrity.json\")); err != nil {\n\t\tt.Fatalf(\"a fixture was mistaken for the sealed checkout: %v\", err)\n\t}\n\tt.Setenv(posepkg.SealedCheckoutEnv, \"\")\n\trefreshDeliveryIndex(root, []byte(\"{}\\n\"), &stderr)\n\tif _, err := os.Stat(target); err != nil {\n\t\tt.Fatalf(\"outside a sealed checkout the index is published as before: %v\", err)\n\t}\n}\n1:{\"schema_version\":1,\"parser_version\":\"pose-design-delta/v2\",\"scope\":\"spec:pose-action-answers-reverify-on-read\",\"status\":\"observed\",\"input_digest\":\"sha256:5dcb886308c16621ec1ab6918c015d631a40164ea1d3fd63b77dd35484c86b19\",\"cache_key\":\"sha256:5dcb886308c16621ec1ab6918c015d631a40164ea1d3fd63b77dd35484c86b19\",\"subject\":{\"base\":\"aa03b84a24c8a64f9da33fc867ac30670611ac7c\",\"head\":\"9d89a2a02b99b51e8955d9abbdda9c6be18b2317\",\"patch_digest\":\"sha256:b521a4546ebd02c35268ff49d115aea29febbc2d05db3fcd19348404258702d2\",\"tree_digest\":\"sha256:1ca4b918c57086b2aa9f1b279344655427f9dbe98c5bc46f30b41092b86ecc83\",\"implementation_digest\":\"sha256:99825a84bf239d48762eb193a890c9283097c41129e17a33b597fc0d7cf63c5a\",\"entries\":12},\"coverage\":{\"files_in_subject\":12,\"files_observed\":12,\"bytes_read\":185419,\"max_files\":4096,\"max_bytes\":16777216,\"detectors\":[{\"id\":\"dependency-go\",\"state\":\"not-applicable\"},{\"id\":\"dependency-npm\",\"state\":\"not-applicable\"},{\"id\":\"component\",\"state\":\"not-applicable\"},{\"id\":\"delivery-metadata\",\"state\":\"not-applicable\"},{\"id\":\"governance-contract\",\"state\":\"not-applicable\"},{\"id\":\"public-contract\",\"state\":\"not-applicable\"},{\"id\":\"git-actions\",\"state\":\"observed\",\"observed\":12}]},\"deltas\":[]}\ndiff --git a/.pose/starts/pose-index-material-does-not-ask-closeout.json b/.pose/starts/pose-index-material-does-not-ask-closeout.json\nnew file mode 100644\nindex 0