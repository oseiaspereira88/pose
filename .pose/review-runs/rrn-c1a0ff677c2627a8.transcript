{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc \"git diff 5e14337100be40d52508587fbc42a070c0b79c6e..ee960dffb9ba49a8ad255a31076cf3ca146fef92 -- pose-mcp .pose/indexes/validation-matrix.json; rg --files .pose | rg 'index-material|delivery-validation'\"","aggregated_output":"diff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex 1ad0d9f0..5246e24d 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2384,6 +2384,13 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"index-material-does-not-ask-closeout-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestIndexMaterialDoesNotAskTheCloseoutOfALocalEdge|TestCloseoutReviewPolicyRoundSix$\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"milestone-closes-when-reached-integration\",\n           \"program\": \"go\",\ndiff --git a/pose-mcp/internal/pose/closeout_review_policy.go b/pose-mcp/internal/pose/closeout_review_policy.go\nindex 7fe458ff..9a887c0c 100644\n--- a/pose-mcp/internal/pose/closeout_review_policy.go\n+++ b/pose-mcp/internal/pose/closeout_review_policy.go\n@@ -333,7 +333,7 @@ func (s Store) AggregateDependencyClosed(resolver ArtifactResolver, localProject\n \tif resolved.CanonicalIdentity != nil {\n \t\tidentity = *resolved.CanonicalIdentity\n \t}\n-\tif identity.Kind != \"milestone\" && identity.Kind != \"roadmap\" {\n+\tif identity.Kind != \"milestone\" && identity.Kind != \"roadmap\" || s.indexMaterial {\n \t\treturn true, \"\"\n \t}\n \tif identity.Project == \"\" {\ndiff --git a/pose-mcp/internal/pose/closeout_review_policy_test.go b/pose-mcp/internal/pose/closeout_review_policy_test.go\nindex 410ad59f..46f7c46e 100644\n--- a/pose-mcp/internal/pose/closeout_review_policy_test.go\n+++ b/pose-mcp/internal/pose/closeout_review_policy_test.go\n@@ -1720,3 +1720,47 @@ func TestCloseoutReviewPolicyRoundSixteen(t *testing.T) {\n \t\t}\n \t})\n }\n+\n+// Spec pose-index-material-does-not-ask-closeout: the federated material of an\n+// index judges a local aggregate edge by its source status only; asking the\n+// terminal projection there read the index whose inputs were being checked,\n+// and the operation waited on itself. Outside the material the edge still\n+// requires the close.\n+func TestIndexMaterialDoesNotAskTheCloseoutOfALocalEdge(t *testing.T) {\n+\t_, s := closeoutReviewedFixture(t, \"never\", \"never\")\n+\tacceptance := func(store Store) []string {\n+\t\tt.Helper()\n+\t\treport, err := store.FederatedMilestoneAcceptance(\"coordinator\", \"program\", \"later\", *store.FederatedResolver)\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\treturn report.Blockers\n+\t}\n+\tif !strings.Contains(strings.Join(acceptance(s), \"\\n\"), \"milestone:program/core:closeout-not-terminal\") {\n+\t\tt.Fatal(\"outside the index material an unclosed local predecessor was accepted\")\n+\t}\n+\tmaterial := s\n+\tmaterial.indexMaterial = true\n+\tmaterial.closeoutChain = nil\n+\tasked := false\n+\tmaterial.FS = closeoutAskingFiles{Files: FilesOrNative(s.FS), asked: &asked}\n+\tif blockers := acceptance(material); strings.Contains(strings.Join(blockers, \"\\n\"), \"closeout-not-terminal\") {\n+\t\tt.Fatalf(\"the index material asked the closeout of a local edge: %v\", blockers)\n+\t}\n+\tif asked {\n+\t\tt.Fatal(\"the index material read a closeout receipt\")\n+\t}\n+}\n+\n+// closeoutAskingFiles records a read of a closeout receipt.\n+type closeoutAskingFiles struct {\n+\tFiles\n+\tasked *bool\n+}\n+\n+func (f closeoutAskingFiles) ReadFile(path string) ([]byte, error) {\n+\tif strings.Contains(filepath.ToSlash(path), \"/review-closeouts/\") {\n+\t\t*f.asked = true\n+\t}\n+\treturn f.Files.ReadFile(path)\n+}\ndiff --git a/pose-mcp/internal/pose/federated_acceptance.go b/pose-mcp/internal/pose/federated_acceptance.go\nindex 48f2cd22..c4171cfc 100644\n--- a/pose-mcp/internal/pose/federated_acceptance.go\n+++ b/pose-mcp/internal/pose/federated_acceptance.go\n@@ -465,7 +465,7 @@ func (s Store) federatedAcceptance(projectID string, coordinator ArtifactRef, ed\n \t\t\t// roadmap is closed by its explicit close, never by the status\n \t\t\t// its members give it: the edge asks the terminal projection,\n \t\t\t// along a chain that stops at a cycle (review round 6, N22).\n-\t\t\tif statusDone && graphValid && (proven.Kind == \"milestone\" || proven.Kind == \"roadmap\") {\n+\t\t\tif statusDone && graphValid && !s.indexMaterial && (proven.Kind == \"milestone\" || proven.Kind == \"roadmap\") {\n \t\t\t\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || adopted && !s.localScopeClosed(localFederatedScope(proven)) {\n \t\t\t\t\treport.Blockers = append(report.Blockers, key+\":closeout-not-terminal\")\n \t\t\t\t}\ndiff --git a/pose-mcp/internal/pose/index_federated_material.go b/pose-mcp/internal/pose/index_federated_material.go\nindex f8529c27..e47c7e49 100644\n--- a/pose-mcp/internal/pose/index_federated_material.go\n+++ b/pose-mcp/internal/pose/index_federated_material.go\n@@ -56,6 +56,7 @@ type IndexFederatedMaterial struct {\n // been established; it is reused unchanged except for the captured Files the\n // operation view supplies.\n func BuildIndexFederatedMaterialIn(store Store) (IndexFederatedMaterial, error) {\n+\tstore.indexMaterial = true\n \tresolver := ArtifactResolver{}\n \tproject := store.FederatedProjectID\n \tif store.FederatedResolver != nil {\ndiff --git a/pose-mcp/internal/pose/spec.go b/pose-mcp/internal/pose/spec.go\nindex aada4858..2c4c336b 100644\n--- a/pose-mcp/internal/pose/spec.go\n+++ b/pose-mcp/internal/pose/spec.go\n@@ -60,6 +60,11 @@ type Store struct {\n \t// verification is asking for this one, through their dependency edges:\n \t// a scope already in it is a cycle and is not proven closed.\n \tcloseoutChain []string\n+\t// indexMaterial marks the store computing an index's federated input\n+\t// material: an input of the index cannot depend on closeout state, which\n+\t// is derived from the index it binds (spec\n+\t// pose-index-material-does-not-ask-closeout).\n+\tindexMaterial bool\n \t// specs, when set, is the spec listing of one operation, read once\n \t// (spec pose-attention-within-a-second). Nil outside such an operation.\n \tspecs *specSnapshot\n.pose/starts/pose-index-material-does-not-ask-closeout.json\n.pose/results/git-locale-independent-review/delivery-validation.log\n.pose/results/delivery-validation.json\n.pose/specs/2026-11-14-pose-index-material-does-not-ask-closeout.md\n","exit_code":0,"status":"completed"}}
