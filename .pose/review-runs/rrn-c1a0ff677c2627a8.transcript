{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '250,355p' pose-mcp/internal/pose/federated_acceptance.go; sed -n '700,860p' pose-mcp/internal/pose/federated_acceptance.go; sed -n '290,355p' pose-mcp/internal/pose/closeout_review_policy_test.go; sed -n '1000,1070p' pose-mcp/internal/pose/closeout_review_policy_test.go; sed -n '130,220p' pose-mcp/internal/pose/readiness.go; sed -n '175,285p' pose-mcp/internal/cli/surface_check.go; file /home/go/.local/bin/pose; rg -n 'func .*Context|func .*ArtifactCheck|func .*SurfaceCheck|with.*View|ReadOnly' pose-mcp/internal/cli/{artifact_check.go,surface_check.go,context.go}\"","aggregated_output":"\t\t}\n\t\thead, err := captureFederatedGit(files, root, \"show\", object)\n\t\tif err != nil || !bytes.Equal(working, head) {\n\t\t\treturn nil, fmt.Errorf(\"pose: federated-governance-input-not-committed\")\n\t\t}\n\t\tinputs[rel] = digestBytes(working)\n\t}\n\treturn inputs, nil\n}\n\nfunc canonicalFederatedDigest(value any) string {\n\traw, _ := json.Marshal(value)\n\tsum := sha256.Sum256(raw)\n\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n}\n\nfunc (s Store) FederatedRoadmapAcceptance(projectID, slug string, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, error) {\n\trm, err := s.GetRoadmap(slug)\n\tif err != nil {\n\t\treturn FederatedRoadmapAcceptanceReport{}, err\n\t}\n\tif resolver.Roots == nil {\n\t\treturn FederatedRoadmapAcceptanceReport{}, fmt.Errorf(\"pose: project roots are unavailable\")\n\t}\n\treturn s.federatedAcceptance(projectID, ArtifactRef{Project: projectID, Kind: \"roadmap\", Slug: slug}, collectFederatedRoadmapEdges(projectID, rm), resolver)\n}\n\n// FederatedMilestoneAcceptance restricts roadmap acceptance to one milestone:\n// the roadmap's consumed outcomes, plus that milestone's predecessors, member\n// specs and consumed outcomes. Members of a later milestone do not gate an\n// earlier one, matching local milestone closeout, and the depends_on of the\n// roadmap binds the close of the roadmap alone (ADR\n// a-milestone-answers-to-its-own-edges).\nfunc (s Store) FederatedMilestoneAcceptance(projectID, slug, milestone string, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, error) {\n\treturn s.milestoneAcceptance(projectID, slug, milestone, resolver, false)\n}\n\n// milestoneAcceptance builds the acceptance of one milestone. roadmapDependencies\n// keeps the depends_on of the roadmap, which is how a bundle sealed before that\n// edge moved to the roadmap reads.\nfunc (s Store) milestoneAcceptance(projectID, slug, milestone string, resolver ArtifactResolver, roadmapDependencies bool) (FederatedRoadmapAcceptanceReport, error) {\n\trm, err := s.GetRoadmap(slug)\n\tif err != nil {\n\t\treturn FederatedRoadmapAcceptanceReport{}, err\n\t}\n\tif resolver.Roots == nil {\n\t\treturn FederatedRoadmapAcceptanceReport{}, fmt.Errorf(\"pose: project roots are unavailable\")\n\t}\n\tselected := *rm\n\tselected.Milestones = nil\n\tif !roadmapDependencies {\n\t\tselected.DependsOn = nil\n\t}\n\tfor _, candidate := range rm.Milestones {\n\t\tif candidate.ID == milestone {\n\t\t\tselected.Milestones = append(selected.Milestones, candidate)\n\t\t}\n\t}\n\tif len(selected.Milestones) == 0 {\n\t\treturn FederatedRoadmapAcceptanceReport{}, fmt.Errorf(\"pose: milestone %s not found in roadmap %s\", milestone, slug)\n\t}\n\tcoordinator := ArtifactRef{Project: projectID, Kind: \"milestone\", Slug: slug, Milestone: milestone}\n\treturn s.federatedAcceptance(projectID, coordinator, collectFederatedRoadmapEdges(projectID, &selected), resolver)\n}\n\n// FederatedSpecAcceptance applies roadmap acceptance to the external\n// dependencies of one spec. It reports applies=false for a spec whose\n// depends_on names no other project, so its review and closeout keep their\n// previous contract. Local dependencies stay governed by lifecycle checks.\nfunc (s Store) FederatedSpecAcceptance(projectID, slug string, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, bool, error) {\n\tsp, err := s.GetSpec(slug)\n\tif err != nil {\n\t\treturn FederatedRoadmapAcceptanceReport{}, false, err\n\t}\n\tedges := []federatedRoadmapEdge{}\n\tfor _, raw := range sp.DependsOn {\n\t\tref, err := ParseArtifactRef(raw)\n\t\tif err != nil || ref.Project == \"\" || ref.Project == projectID {\n\t\t\tcontinue\n\t\t}\n\t\tedges = append(edges, federatedRoadmapEdge{project: projectID, raw: raw, relationship: \"prerequisite\"})\n\t}\n\tif len(edges) == 0 {\n\t\treturn FederatedRoadmapAcceptanceReport{}, false, nil\n\t}\n\tcoordinator := ArtifactRef{Project: projectID, Kind: \"spec\", Slug: slug}\n\tif resolver.Roots == nil {\n\t\t// Fail closed without failing the command: a checkout with no roots\n\t\t// can still read the spec but can never close it.\n\t\treturn federatedBlockedReport(s.fsys(), s, coordinator, \"project-roots-unavailable\"), true, nil\n\t}\n\treport, err := s.federatedAcceptance(projectID, coordinator, edges, resolver)\n\treturn report, true, err\n}\n\nfunc federatedBlockedReport(files Files, s Store, coordinator ArtifactRef, blocker string) FederatedRoadmapAcceptanceReport {\n\tmanifest := FederatedRoadmapManifest{SchemaVersion: 1, Coordinator: coordinator, CoordinatorRevision: federatedArtifactLastChange(files, s, coordinator), Dependencies: []FederatedDependency{}, Blockers: []string{blocker}}\n\tmanifest.Digest = canonicalFederatedDigest(manifest)\n\treturn FederatedRoadmapAcceptanceReport{Manifest: manifest, Blockers: []string{blocker}}\n}\n\nfunc (s Store) federatedAcceptance(projectID string, coordinator ArtifactRef, edges []federatedRoadmapEdge, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, error) {\n\tpolicy, policyDigest, err := LoadFederatedRoadmapPolicyIn(s.fsys(), s.Root)\n\tif err != nil {\n\t\treturn FederatedRoadmapAcceptanceReport{}, err\n\t}\n\n// federatedGitlinkMatches reads the filesystem directly; federatedGitlinkMatchesIn reads the operation's files.\nfunc federatedGitlinkMatches(parent, child Store, revision string) bool {\n\treturn federatedGitlinkMatchesIn(NativeFiles(), parent, child, revision)\n}\n\nfunc federatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\n\tscope := localFederatedScope(identity)\n\tstate, err := source.GetCloseoutState(scope)\n\tif err != nil || !state.Terminal {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-not-terminal\"}\n\t}\n\t// A milestone or roadmap the source closed without its own review, under\n\t// its adopted closeout review policy, is proven by the receipt of that\n\t// close: the source's policy decides, never the consumer's. Its members\n\t// are federated with their own reviews (spec\n\t// pose-closeout-review-policy-by-cost-benefit).\n\tif receipt := state.CloseoutReceipt; receipt != nil && !receipt.Decision.Required && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n\t\traw, err := json.Marshal(receipt)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-receipt-unreadable\"}\n\t\t}\n\t\treturn \"closeout-receipt:\" + scope, \"sha256:\" + digestHex(raw), receipt.SubjectDigest, receipt.PolicyDigest, nil, nil, nil\n\t}\n\tverification, err := source.VerifyReviewBundle(scope)\n\t// A milestone its roadmap declares has no review of its own: what a consumer can\n\t// hold is the review of that roadmap, which sealed the declaration.\n\tif err == nil && identity.Kind == \"milestone\" && strings.HasPrefix(verification.ApprovalOrigin, \"declared:\") {\n\t\tverification, err = source.VerifyReviewBundle(\"roadmap:\" + identity.Slug)\n\t}\n\tif err != nil || !verification.Fresh || !verification.Approved || verification.Bundle == nil || verification.Attestation == nil || !source.sealedDeclarationHolds(verification.Bundle) {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-review-not-approved\"}\n\t}\n\tbundle := verification.Bundle\n\teligible := federatedSourceEvidenceEligibilityIn(files, source.Root, pinnedRevision, bundle.Payload.Subject.Head)\n\tif identity.Kind == \"spec\" {\n\t\tspec, err := source.GetSpec(identity.Slug)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":unavailable-artifact\"}\n\t\t}\n\t\ttargets, _, err := ParseDeliveryTargets(*spec)\n\t\tif err != nil || len(targets) == 0 {\n\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-target-missing\"}\n\t\t}\n\t\tprofiles, err := loadFederatedDeliveryProfiles(files, source.Root)\n\t\tif err != nil {\n\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-profile-unavailable\"}\n\t\t}\n\t\tblockers := []string{}\n\t\tfor _, target := range targets {\n\t\t\tprofile, ok := profiles[target.Profile]\n\t\t\tif !ok || profile.Kind != target.Kind {\n\t\t\t\tblockers = append(blockers, scope+\":source-delivery-profile-unsupported\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseen := map[string]bool{}\n\t\t\tfor _, evidence := range bundle.Payload.Evidence {\n\t\t\t\tif eligible(evidence) && moduleMatchesTarget(evidence.Module, target.Module) {\n\t\t\t\t\tseen[evidence.EvidenceClass] = true\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor _, required := range profile.RequiredEvidenceClasses {\n\t\t\t\tif !seen[required] {\n\t\t\t\t\tblockers = append(blockers, scope+\":source-delivery-evidence-missing:\"+target.Ref+\":\"+required)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif len(profile.AnyEvidenceClasses) > 0 {\n\t\t\t\tfound := false\n\t\t\t\tfor _, class := range profile.AnyEvidenceClasses {\n\t\t\t\t\tfound = found || seen[class]\n\t\t\t\t}\n\t\t\t\tif !found {\n\t\t\t\t\tblockers = append(blockers, scope+\":source-delivery-evidence-missing:\"+target.Ref+\":one-of\")\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tproof := federatedBundleEvidence(files, bundle, eligible)\n\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, proof, uniqueSorted(blockers)\n\t}\n\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, federatedBundleEvidence(files, bundle, eligible), nil\n}\n\n// A fresh approved source bundle already checked provenance. A carried result\n// can additionally prove delivery only if it ran after the reviewed subject\n// and belongs to the pinned source history. An earlier or unknown result never\n// observed the implementation being federated.\nfunc federatedSourceEvidenceEligibility(root, pinnedHead, subjectHead string) func(ReviewBundleEvidence) bool {\n\treturn federatedSourceEvidenceEligibilityIn(NativeFiles(), root, pinnedHead, subjectHead)\n}\n\nfunc federatedSourceEvidenceEligibilityIn(files Files, root, pinnedHead, subjectHead string) func(ReviewBundleEvidence) bool {\n\tancestry := map[string]bool{}\n\treturn func(evidence ReviewBundleEvidence) bool {\n\t\tif evidence.Outcome != \"pass\" {\n\t\t\treturn false\n\t\t}\n\t\tif evidence.SubjectObservation == \"observed\" {\n\t\t\treturn true\n\t\t}\n\t\tif evidence.SubjectObservation != \"carried-forward\" || evidence.SubjectDigest != \"\" || evidence.ProvenanceDigest == \"\" ||\n\t\t\t!isGitRevision(subjectHead) || !isGitRevision(evidence.GitHead) || !isGitRevision(pinnedHead) {\n\t\t\treturn false\n\t\t}\n\t\tif allowed, ok := ancestry[evidence.GitHead]; ok {\n\t\t\treturn allowed\n\t\t}\n\t\tallowed := federatedGitAncestorIn(files, root, subjectHead, evidence.GitHead) &&\n\t\t\tfederatedGitAncestorIn(files, root, evidence.GitHead, pinnedHead)\n\t\tancestry[evidence.GitHead] = allowed\n\t\treturn allowed\n\t}\n}\n\nfunc localFederatedScope(identity ArtifactRef) string {\n\tif identity.Kind == \"milestone\" {\n\t\treturn \"milestone:\" + identity.Slug + \"/\" + identity.Milestone\n\t}\n\treturn identity.Kind + \":\" + identity.Slug\n}\n\nfunc federatedBundleEvidence(files Files, bundle *ReviewBundle, eligible func(ReviewBundleEvidence) bool) []FederatedDependencyEvidence {\n\tevidence := []FederatedDependencyEvidence{}\n\tfor _, item := range bundle.Payload.Evidence {\n\t\tif eligible(item) {\n\t\t\tevidence = append(evidence, FederatedDependencyEvidence{ID: item.ID, Check: item.Check, EvidenceClass: item.EvidenceClass, SubjectObservation: item.SubjectObservation})\n\t\t}\n\t}\n\tsort.Slice(evidence, func(i, j int) bool {\n\t\tif evidence[i].EvidenceClass != evidence[j].EvidenceClass {\n\t\t\treturn evidence[i].EvidenceClass < evidence[j].EvidenceClass\n\t\t}\n\t\treturn evidence[i].ID < evidence[j].ID\n\t})\n\treturn evidence\n}\n\nfunc loadFederatedDeliveryProfiles(files Files, root string) (map[string]DeliveryProfile, error) {\n\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\"))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar matrix struct {\n\t\tDeliveryProfiles map[string]DeliveryProfile `json:\"deliveryProfiles\"`\n\t}\n\tif err := json.Unmarshal(raw, &matrix); err != nil || len(matrix.DeliveryProfiles) == 0 {\n\t\treturn nil, fmt.Errorf(\"unsupported delivery profile contract\")\n\t}\n\treturn matrix.DeliveryProfiles, nil\n}\n\nfunc federatedOwnershipConflicts(files Files, projectRoots map[string]Store, resolver ArtifactResolver) []string {\n\towners := map[string]string{}\n\tblockers := []string{}\n\tfor project, store := range projectRoots {\n\t\troadmaps, err := store.ListRoadmaps()\n\t\tif err != nil {\n\t\t\tblockers = append(blockers, \"federated-ownership-unavailable:\"+project)\n\t\t\tcontinue\n\t\t}\n\t\tfor _, roadmap := range roadmaps {\n\t\t\tif roadmap.Status != \"active\" {\n// the one done, approved member backend.\nfunc closeoutReviewedFixture(t *testing.T, milestone, roadmap string) (string, Store) {\n\tt.Helper()\n\troot, s := inheritedFixture(t)\n\tsetCloseoutPolicy(t, root, milestone, roadmap)\n\treturn root, s\n}\n\nfunc TestCloseoutReviewPolicyProtection(t *testing.T) {\n\tt.Run(\"always does not inherit the sole member\", func(t *testing.T) {\n\t\t_, s := closeoutReviewedFixture(t, \"always\", \"always\")\n\t\tverification, err := s.VerifyReviewBundle(\"milestone:program/core\")\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif verification.Approved {\n\t\t\tt.Fatalf(\"always inherited a member approval: %+v\", verification)\n\t\t}\n\t\teval, err := s.ReviewCheck(\"milestone:program/core\")\n\t\tif err != nil || !eval.Required || eval.Approved || eval.CloseoutReview == nil || !eval.CloseoutReview.Required {\n\t\t\tt.Fatalf(\"%+v %v\", eval, err)\n\t\t}\n\t})\n\tt.Run(\"always ignores unreviewed_milestones\", func(t *testing.T) {\n\t\troot, s := closeoutReviewedFixture(t, \"always\", \"always\")\n\t\teditRoadmapFixture(t, root, \"status: active\\n\", \"status: active\\nunreviewed_milestones: the team accepts it\\n\")\n\t\tif verification, err := s.VerifyReviewBundle(\"milestone:program/core\"); err != nil || verification.Approved {\n\t\t\tt.Fatalf(\"a declaration weakened always: %+v %v\", verification, err)\n\t\t}\n\t})\n\tt.Run(\"never dispenses only the aggregate\", func(t *testing.T) {\n\t\t_, s := closeoutReviewedFixture(t, \"never\", \"never\")\n\t\tverification, err := s.VerifyReviewBundle(\"milestone:program/core\")\n\t\tif err != nil || !verification.Approved || verification.ApprovalOrigin != \"not-required:milestone_review_required=never\" {\n\t\t\tt.Fatalf(\"%+v %v\", verification, err)\n\t\t}\n\t\tmember, err := s.ReviewCheck(\"spec:backend\")\n\t\tif err != nil || !member.Required {\n\t\t\tt.Fatalf(\"the member review was dispensed too: %+v %v\", member, err)\n\t\t}\n\t})\n\tt.Run(\"enabled=false does not weaken always\", func(t *testing.T) {\n\t\troot, s := closeoutReviewedFixture(t, \"always\", \"always\")\n\t\tpath := filepath.Join(root, \".pose\", \"policy\", \"review.json\")\n\t\traw, _ := os.ReadFile(path)\n\t\tos.WriteFile(path, []byte(strings.Replace(string(raw), `\"enabled\":true`, `\"enabled\":false`, 1)), 0o644)\n\t\teval, err := s.ReviewCheck(\"milestone:program/core\")\n\t\tif !eval.Required || eval.Approved || eval.CloseoutReview == nil {\n\t\t\tt.Fatalf(\"a disabled policy dispensed an always review: %+v %v\", eval, err)\n\t\t}\n\t\tif state, err := s.GetCloseoutState(\"milestone:program/core\"); err == nil && state.Terminal {\n\t\t\tt.Fatalf(\"%+v\", state)\n\t\t}\n\t\towed, err := s.CloseoutReviewsOwed()\n\t\tif err != nil || len(owed) == 0 {\n\t\t\tt.Fatalf(\"doctor lost the owed review under enabled=false: %+v %v\", owed, err)\n\t\t}\n\t})\n\tt.Run(\"mandatory-human is never dispensed\", func(t *testing.T) {\n\t\troot, s := closeoutMembersFixture(t, \"never\", \"never\")\n\t\tpath := filepath.Join(root, \".pose\", \"policy\", \"review.json\")\n\t\traw, _ := os.ReadFile(path)\n\t\tvar policy map[string]any\n\t\tjson.Unmarshal(raw, &policy)\n\t\tpolicy[\"reviewer_independence\"] = map[string]any{\"milestone\": \"mandatory-human\"}\n\t\tos.MkdirAll(filepath.Join(root, \".pose\", \"review-profiles\"), 0o755)\n\t})\n}\n\nfunc TestCloseoutReviewPolicyRoundSix(t *testing.T) {\n\tt.Run(\"an exempt one-member milestone with an unjudged exit gate does not close\", func(t *testing.T) {\n\t\troot, s := closeoutMembersFixture(t, \"never\", \"never\")\n\t\twithDistProfiles(t, root)\n\t\teditFile(t, filepath.Join(root, \".pose/roadmaps/program.md\"), \"- specs: a\\n\\n## Milestone: two\", \"- specs: a\\n\\n**Exit gate:** the part works alone\\n\\n## Milestone: two\")\n\t\tstate, err := s.GetCloseoutState(\"milestone:program/one\")\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif state.Review.Required || !strings.Contains(strings.Join(state.Blockers, \"\\n\"), \"is judged by no approved review\") {\n\t\t\tt.Fatalf(\"a singleton exit gate closed with no judge: required=%v blockers=%v\", state.Review.Required, state.Blockers)\n\t\t}\n\t})\n\tt.Run(\"a reached but unclosed local predecessor does not satisfy after\", func(t *testing.T) {\n\t\t_, s := closeoutReviewedFixture(t, \"never\", \"never\")\n\t\tblocked := func() bool {\n\t\t\tt.Helper()\n\t\t\treport, err := s.FederatedMilestoneAcceptance(\"coordinator\", \"program\", \"later\", *s.FederatedResolver)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\treturn strings.Contains(strings.Join(report.Blockers, \"\\n\"), \"milestone:program/core:closeout-not-terminal\")\n\t\t}\n\t\tif !blocked() {\n\t\t\tt.Fatal(\"a predecessor with no closeout receipt was accepted from its members' status\")\n\t\t}\n\t\tref := \"milestone:program/core\"\n\t\tstate, err := s.GetCloseoutState(ref)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif blocked() {\n\t\t\tt.Fatal(\"a closed predecessor is still refused\")\n\t\t}\n\t})\n\tt.Run(\"doctor lists a historical scope whose closure no longer verifies\", func(t *testing.T) {\n\t\troot, s, child, _, now := approvedParentFixture(t, true)\n\t\t// A done roadmap whose milestones all closed: the fixture's later\n\t\t// milestone has a draft member, which doctor rightly lists.\n\t\teditRoadmapFixture(t, root, \"\\n## Milestone: later\\n- after: core\\n- specs: pending\\n\", \"\")\n\t\t// The fixture leaves no resolver bound, so the external outcome the\n\t\t// roadmap consumes cannot be judged and rightly keeps it open.\n\t\teditRoadmapFixture(t, root, \"consumes: xref:source/roadmap:component\\n\", \"\")\n\t\t// The root declares the identity the fixture's bundles carry, as an\n\t\t// installed project does: the projection, with no resolver bound,\n\t\t// binds the one the environment gives this root.\n\t\tos.WriteFile(filepath.Join(root, \".pose\", \"project.json\"), []byte(`{\"schema_version\":1,\"project_id\":\"coordinator\",\"name\":\"coordinator\"}`), 0o644)\n\t\tfederatedTestGit(t, root, \"add\", \"--all\")\n\t\tfederatedTestGit(t, root, \"commit\", \"-q\", \"-m\", \"declare the project\")\n\t\tresolver, project, err := EnvironmentArtifactResolverIn(s.fsys(), root, \"\")\n\t\tif err != nil || project != \"coordinator\" {\n\t\t\tt.Fatal(project, err)\n\t\t}\n\t\ts.FederatedProjectID, s.FederatedResolver = project, &resolver\n\t\t// Historical by its own recorded approval, not by the legacy\n\t\t// exemption (under which a rejected child does not reopen it).\n\t\teditRoadmapFixture(t, root, \"status: active\\n\", \"status: done\\n\")\n\t\troadmap, err := s.SealReviewBundle(\"roadmap:program\", now.Add(6*time.Minute))\n\t\tif err != nil {\n\t\t\tt.Fatal(err, roadmap.Blockers)\n\t\t}\n\t\tattestChildReview(t, s, roadmap, now.Add(7*time.Minute), \"approved\")\n\t\tif state, err := s.GetCloseoutState(\"roadmap:program\"); err != nil || !state.Terminal {\n\t\t\tt.Fatalf(\"the fixture's legacy roadmap is not closed: %v %v\", state.Blockers, err)\nfunc (s Store) SpecReadiness(slug string) (*Readiness, error) {\n\tresolver, project, err := EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn s.SpecReadinessWithResolver(slug, project, resolver)\n}\n\n// SpecReadinessWithResolver lets transports enforce their caller's project policy.\nfunc (s Store) SpecReadinessWithResolver(slug, project string, resolver ArtifactResolver) (*Readiness, error) {\n\tif view, _ := governanceReadViewFromFiles(s.fsys()); view != nil && view.operation != nil {\n\t\t// Producer-created resolvers retain their caller's roots and authority,\n\t\t// while sharing the captured operation's dependency traversal budget.\n\t\tresolver.governanceDepthLimit = view.operation.resolver.governanceDepthLimit\n\t}\n\tsp, err := s.GetSpec(slug)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tr := &Readiness{Slug: sp.Slug, Status: sp.Status, WaitingOn: []WaitingRef{}}\n\n\tif terminalStatuses[sp.Status] {\n\t\tr.Terminal = true\n\t\tr.Reason = fmt.Sprintf(\"spec is in terminal status %q\", sp.Status)\n\t\treturn r, nil\n\t}\n\t// A blocked spec stays not ready, as it always was, but it is no longer a\n\t// bare bit: its declared prerequisites are still resolved so the waiting\n\t// set explains the block when it can, and an unexplained block says so.\n\tblocked := sp.Status == \"blocked\"\n\n\t// Definition of Ready (pose-definition-of-ready): specs criadas a partir do\n\t// cutoff de adoção precisam de acceptance criteria com IDs estáveis antes de\n\t// serem elegíveis. Specs anteriores são legadas (isentas) — o gate de\n\t// transição do pose check cobre o funil novo.\n\tif s.dorApplies(sp.CreatedAt) && !hasAcceptanceCriteriaIDs(sp.Body) {\n\t\tr.WaitingOn = append(r.WaitingOn, WaitingRef{\n\t\t\tRef:    \"dor:acceptance-criteria\",\n\t\t\tReason: \"Definition of Ready: no acceptance criteria with stable IDs (- R<N>: ...) in Requirements\",\n\t\t\tCode:   \"dor-acceptance-criteria-missing\",\n\t\t})\n\t}\n\n\tfor _, raw := range sp.DependsOn {\n\t\tref, parseErr := ParseArtifactRef(raw)\n\t\treason, state, graph, notDone := \"\", \"\", \"\", false\n\t\tif parseErr != nil {\n\t\t\treason, state = \"invalid-artifact-reference\", \"invalid-artifact-reference\"\n\t\t} else {\n\t\t\tresolved := resolver.Resolve(project, raw)\n\t\t\tif !resolved.Resolved {\n\t\t\t\treason, state = resolved.State, resolved.State\n\t\t\t} else if graphReason := resolver.ValidateGraph(project, raw); graphReason != \"\" {\n\t\t\t\treason, graph = graphReason, graphReason\n\t\t\t} else if resolved.Status != \"done\" {\n\t\t\t\tnotDone = true\n\t\t\t\treason = fmt.Sprintf(\"%s status is %q (needs done)\", ref.Kind, resolved.Status)\n\t\t\t\tif ref.Kind == \"milestone\" && ref.Project == \"\" {\n\t\t\t\t\treason = s.milestoneWaitingReason(ref.Slug + \"/\" + ref.Milestone)\n\t\t\t\t}\n\t\t\t} else if closed, why := s.AggregateDependencyClosed(resolver, project, resolved); !closed {\n\t\t\t\tnotDone, reason = true, why\n\t\t\t}\n\t\t}\n\t\tif reason != \"\" {\n\t\t\tr.WaitingOn = append(r.WaitingOn, WaitingRef{Ref: raw, Reason: reason, Code: dependencyWaitingCode(state, graph, notDone), Detail: firstNonempty(state, graph)})\n\t\t}\n\t}\n\n\tif blocked {\n\t\tdependencies := 0\n\t\tfor _, waiting := range r.WaitingOn {\n\t\t\tif !strings.HasPrefix(waiting.Ref, \"dor:\") {\n\t\t\t\tdependencies++\n\t\t\t}\n\t\t}\n\t\tif dependencies > 0 {\n\t\t\tr.Cause = ReadinessCauseDependency\n\t\t\tr.Reason = fmt.Sprintf(\"spec is blocked (an operational condition, not a terminal status) and waits on %d unsatisfied dependency(ies)\", dependencies)\n\t\t} else {\n\t\t\tr.Cause = ReadinessCauseUnknown\n\t\t\tr.Reason = \"spec is blocked (an operational condition, not a terminal status) and no recorded cause explains it\"\n\t\t}\n\t\treturn r, nil\n\t}\n\tr.Ready = len(r.WaitingOn) == 0\n\tif !r.Ready && r.Reason == \"\" {\n\t\tr.Reason = fmt.Sprintf(\"%d unsatisfied dependency(ies)\", len(r.WaitingOn))\n\t}\n\treturn r, nil\n}\n\t\tif err != nil {\n\t\t\treturn base, err\n\t\t}\n\t\troadmaps = append(roadmaps, *full)\n\t}\n\treturn posemodel.BuildDeliverySurface(base, fullSpecs, targets, results, roadmaps, profiles, policy), nil\n}\n\n// extendCurrentDeliveryGraph reads and writes the filesystem directly; extendCurrentDeliveryGraphIn takes the\n// operation's files.\nfunc extendCurrentDeliveryGraph(root string, base posemodel.DeliveryIntegrityGraph) (posemodel.DeliveryIntegrityGraph, error) {\n\treturn extendCurrentDeliveryGraphIn(posemodel.NativeFiles(), root, base)\n}\n\nfunc cmdSurfaceCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar spec, resultsPath string\n\tstrict, jsonOutput := true, false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--spec\", \"--results\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\n\t\t\t}\n\t\t\ti++\n\t\t\tif args[i-1] == \"--spec\" {\n\t\t\t\tspec = args[i]\n\t\t\t} else {\n\t\t\t\tresultsPath = args[i]\n\t\t\t}\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\n\t\t}\n\t}\n\tif spec != \"\" && posemodel.ValidateSlug(spec) != nil {\n\t\tfmt.Fprintln(stderr, \"pose surface-check: invalid spec slug\")\n\t\treturn 2\n\t}\n\tpolicy, err := posemodel.LoadDeliveryPolicy(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif resultsPath != \"\" {\n\t\tif !confinedRelativePath(resultsPath) {\n\t\t\tfmt.Fprintln(stderr, \"pose surface-check: results path escapes project\")\n\t\t\treturn 2\n\t\t}\n\t\tpolicy.ResultsPath = filepath.ToSlash(filepath.Clean(resultsPath))\n\t}\n\tbaseSpecs, claims, sets, tracked, artifactPolicy, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tbase := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), baseSpecs, claims, sets, tracked, artifactPolicy, posemodel.LoadArchivedFragments(root), artifactRemovals(root, claims, sets, tracked, gaps))\n\tprofiles, err := loadDeliveryProfiles(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tfullSpecs, targets, err := collectDeliveryTargets(root, baseSpecs, profiles)\n\tif err !