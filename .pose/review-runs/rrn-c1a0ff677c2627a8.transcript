{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '132,360p' pose-mcp/internal/pose/artifact_ref.go; sed -n '2661,2815p' pose-mcp/internal/pose/review_closeout.go; sed -n '380,410p' pose-mcp/internal/pose/closeout_review_policy.go; sed -n '424,480p' pose-mcp/internal/pose/roadmaps.go; rg -n 'pin|index|SpecReadiness' pose-mcp/internal/pose/roadmaps.go; rg -n 'index-material-does-not-ask-closeout' .pose/results/delivery-validation.json; sed -n '1,140p' pose-mcp/internal/pose/index_federated_material_test.go\"","aggregated_output":"func (r ArtifactResolver) Resolve(localProject, raw string) ArtifactResolution {\n\treturn r.resolve(localProject, raw, map[string]bool{}, 0)\n}\n\nfunc (r ArtifactResolver) resolve(localProject, raw string, redirectPath map[string]bool, redirectDepth int) ArtifactResolution {\n\tout := ArtifactResolution{SchemaVersion: 1}\n\tref, err := ParseArtifactRef(raw)\n\tif err != nil || !filepath.IsLocal(ref.Slug) {\n\t\tout.State = \"invalid-artifact-reference\"\n\t\treturn out\n\t}\n\tif ref.Project == \"\" {\n\t\tref.Project = localProject\n\t}\n\tout.Identity = ref\n\tif r.Authorize != nil && !r.Authorize(ref.Project) {\n\t\tout.State = \"unauthorized-project\"\n\t\treturn out\n\t}\n\tif r.Roots == nil {\n\t\tout.State = \"unknown-project\"\n\t\treturn out\n\t}\n\ts, err := r.Roots.StoreFor(ref.Project)\n\tif err == nil {\n\t\ts = r.withSpecSnapshot(ref.Project, s)\n\t}\n\tif err != nil {\n\t\tout.State = \"unknown-project\"\n\t\tvar conflict ProjectBindingConflictError\n\t\tvar ambiguous ProjectAmbiguousError\n\t\tif errors.As(err, &conflict) || errors.As(err, &ambiguous) {\n\t\t\tout.State = \"conflicting-project-binding\"\n\t\t}\n\t\treturn out\n\t}\n\tif info, err := r.fsys().Stat(filepath.Join(s.Root, \".pose\")); err != nil || !info.IsDir() {\n\t\tout.State = \"unavailable-project\"\n\t\treturn out\n\t}\n\tvar pending bool\n\tvar operationID string\n\tif s.specs != nil {\n\t\t// One read of the project's transfer plans for the whole operation.\n\t\ts.specs.transfersOnce.Do(func() { s.specs.transfers = listTransfers(r.fsys(), s.Root) })\n\t\toperationID, pending = incompleteTransferIn(r.fsys(), s.Root, ref, s.specs.transfers)\n\t} else {\n\t\toperationID, pending = incompleteTransferFor(r.fsys(), s.Root, ref)\n\t}\n\tif pending {\n\t\tout.State = \"transfer-in-progress\"\n\t\tout.OperationID = operationID\n\t\treturn out\n\t}\n\tpolicyPath := filepath.Join(s.Root, \".pose\", \"policy\", \"review.json\")\n\tif _, err := r.fsys().Lstat(policyPath); err == nil && !artifactPathWithin(r.fsys(), s.Root, policyPath) {\n\t\tout.State = \"unsupported-artifact-contract\"\n\t\treturn out\n\t}\n\tif raw, err := r.fsys().ReadFile(policyPath); err == nil {\n\t\tvar policy struct {\n\t\t\tSchemaVersion   int `json:\"schema_version\"`\n\t\t\tRefsVersion     int `json:\"qualified_artifact_refs_version\"`\n\t\t\tTransferVersion int `json:\"spec_authority_transfer_version\"`\n\t\t}\n\t\tif json.Unmarshal(raw, &policy) != nil {\n\t\t\tout.State = \"unsupported-artifact-contract\"\n\t\t\treturn out\n\t\t}\n\t\trefsRequired := policy.SchemaVersion == QualifiedArtifactPolicySchemaVersion || policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion\n\t\ttransferValid := policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 1 || policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 0\n\t\trefsCompatible := policy.RefsVersion == 0 || policy.RefsVersion == 1 && refsRequired\n\t\tif policy.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n\t\t\t// Schema 5 (closeout review pair) keeps references and transfer\n\t\t\t// optional: 0, or 1 as schemas 3 and 4 define them.\n\t\t\trefsCompatible = policy.RefsVersion == 0 || policy.RefsVersion == 1\n\t\t\ttransferValid = policy.TransferVersion == 0 || policy.TransferVersion == 1 && policy.RefsVersion == 1\n\t\t}\n\t\tif !refsCompatible || refsRequired && policy.RefsVersion != 1 || policy.SchemaVersion > CloseoutReviewPolicySchemaVersion || !transferValid {\n\t\t\tout.State = \"unsupported-artifact-contract\"\n\t\t\treturn out\n\t\t}\n\t} else if !os.IsNotExist(err) {\n\t\tout.State = \"unavailable-project\"\n\t\treturn out\n\t}\n\tvar body string\n\tvar deps []string\n\tswitch ref.Kind {\n\tcase \"spec\":\n\t\tredirect, found, err := readSpecTransferRedirect(r.fsys(), s, ref)\n\t\tif err != nil {\n\t\t\tout.State = \"invalid-spec-redirect\"\n\t\t\treturn out\n\t\t}\n\t\tif found {\n\t\t\tkey := ref.String()\n\t\t\tmaxDepth := 16\n\t\t\tif r.governanceDepthLimit > 0 {\n\t\t\t\tmaxDepth = r.governanceDepthLimit\n\t\t\t}\n\t\t\tif redirectPath[key] {\n\t\t\t\tout.State = \"redirect-cycle\"\n\t\t\t\treturn out\n\t\t\t}\n\t\t\tif redirectDepth >= maxDepth {\n\t\t\t\tr.markResolutionBudgetUnknown(ref.Project, \"artifact redirect chain exceeded its depth budget\")\n\t\t\t\tout.State = \"resolution-limit\"\n\t\t\t\treturn out\n\t\t\t}\n\t\t\tredirectPath[key] = true\n\t\t\ttarget := r.resolve(redirect.Destination.Project, redirect.Destination.String(), redirectPath, redirectDepth+1)\n\t\t\tdelete(redirectPath, key)\n\t\t\tif !target.Resolved {\n\t\t\t\tout.State = \"redirect-target-\" + target.State\n\t\t\t\treturn out\n\t\t\t}\n\t\t\tcanonical := target.Identity\n\t\t\tif target.CanonicalIdentity != nil {\n\t\t\t\tcanonical = *target.CanonicalIdentity\n\t\t\t}\n\t\t\tout.Resolved, out.State, out.Redirected = true, \"redirected\", true\n\t\t\tout.CanonicalIdentity = &canonical\n\t\t\tout.Status, out.Revision, out.Digest = target.Status, target.Revision, target.Digest\n\t\t\tout.Dependencies = append([]ArtifactRef{}, target.Dependencies...)\n\t\t\tout.redirectCrossings = 1 + target.redirectCrossings\n\t\t\treturn out\n\t\t}\n\t\tsp, err := s.GetSpec(ref.Slug)\n\t\tif err != nil {\n\t\t\tout.State = \"unknown-spec\"\n\t\t\tvar duplicate SpecIdentityConflictError\n\t\t\tif errors.As(err, &duplicate) {\n\t\t\t\tout.State = \"conflicting-artifact-identity\"\n\t\t\t}\n\t\t\treturn out\n\t\t}\n\t\tout.Status, body, deps = sp.Status, sp.Body, sp.DependsOn\n\t\tif info, err := r.fsys().Stat(sp.Path); err == nil && !info.IsDir() {\n\t\t\traw, err := r.fsys().ReadFile(sp.Path)\n\t\t\tif err != nil {\n\t\t\t\tout.State = \"unavailable-artifact\"\n\t\t\t\treturn out\n\t\t\t}\n\t\t\tbody = string(raw)\n\t\t}\n\tcase \"roadmap\", \"milestone\":\n\t\tif err := validateProjectPathIn(r.fsys(), s.Root, filepath.Join(\".pose\", \"roadmaps\", ref.Slug+\".md\")); err != nil {\n\t\t\tout.State = \"unavailable-artifact\"\n\t\t\treturn out\n\t\t}\n\t\tpath := filepath.Join(s.roadmapsDir(), ref.Slug+\".md\")\n\t\tif _, err := r.fsys().Lstat(path); os.IsNotExist(err) {\n\t\t\tout.State = \"unknown-roadmap\"\n\t\t\treturn out\n\t\t}\n\t\tif !artifactPathWithin(r.fsys(), s.Root, path) {\n\t\t\tout.State = \"unavailable-artifact\"\n\t\t\treturn out\n\t\t}\n\t\trm, err := s.GetRoadmap(ref.Slug)\n\t\tif err != nil {\n\t\t\tout.State = \"unknown-roadmap\"\n\t\t\treturn out\n\t\t}\n\t\tout.Status, body = rm.Status, rm.Body\n\t\tif raw, err := r.fsys().ReadFile(path); err == nil {\n\t\t\tbody = string(raw)\n\t\t} else {\n\t\t\tout.State = \"unavailable-artifact\"\n\t\t\treturn out\n\t\t}\n\t\tfor _, dep := range rm.DependsOn {\n\t\t\tif !strings.Contains(dep, \":\") {\n\t\t\t\tdep = \"roadmap:\" + dep\n\t\t\t}\n\t\t\tdeps = append(deps, dep)\n\t\t}\n\t\tfor _, consumed := range rm.Consumes {\n\t\t\tif !strings.Contains(consumed, \":\") {\n\t\t\t\tconsumed = \"roadmap:\" + consumed\n\t\t\t}\n\t\t\tdeps = append(deps, consumed)\n\t\t}\n\t\tif ref.Kind == \"roadmap\" {\n\t\t\tfor _, ms := range rm.Milestones {\n\t\t\t\tdeps = append(deps, \"milestone:\"+rm.Slug+\"/\"+ms.ID)\n\t\t\t}\n\t\t}\n\t\tif ref.Kind == \"milestone\" {\n\t\t\tfound := false\n\t\t\tfor _, ms := range rm.Milestones {\n\t\t\t\tif ms.ID != ref.Milestone {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif found {\n\t\t\t\t\tout.State = \"conflicting-artifact-identity\"\n\t\t\t\t\treturn out\n\t\t\t\t}\n\t\t\t\tfound = true\n\t\t\t\tdeps = append([]string{}, ms.Specs...)\n\t\t\t\tfor _, consumed := range ms.Consumes {\n\t\t\t\t\tif !strings.Contains(consumed, \":\") {\n\t\t\t\t\t\tconsumed = \"roadmap:\" + consumed\n\t\t\t\t\t}\n\t\t\t\t\tdeps = append(deps, consumed)\n\t\t\t\t}\n\t\t\t\tfor _, after := range ms.After {\n\t\t\t\t\tif !strings.Contains(after, \":\") {\n\t\t\t\t\t\tafter = \"milestone:\" + rm.Slug + \"/\" + after\n\t\t\t\t\t}\n\t\t\t\t\tdeps = append(deps, after)\n\t\t\t\t}\n\t\t\t\tout.Status = \"done\"\n\t\t\t\tfor _, rawSpec := range ms.Specs {\n\t\t\t\t\tif !strings.Contains(rawSpec, \":\") {\n\t\t\t\t\t\trawSpec = \"spec:\" + rawSpec\n\t\t\t\t\t}\n\t\t\t\t\tsp := r.resolve(ref.Project, rawSpec, redirectPath, redirectDepth)\n\t\t\t\t\tif !sp.Resolved || sp.Status != \"done\" {\n\t\t\t\t\t\tout.Status = \"pending\"\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !found {\n\t\t\t\tout.State = \"unknown-milestone\"\n\t\t\t\treturn out\n\t\t\t}\n\t\t}\nfunc (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutState, error) {\n\ts = s.reviewOperation()\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn CloseoutState{}, err\n\t}\n\treview, err := s.ReviewCheck(ref)\n\tif err != nil {\n\t\treturn CloseoutState{}, err\n\t}\n\tstate := CloseoutState{SchemaVersion: ReviewSchemaVersion, Scope: ref, ScopeDigest: review.ScopeDigest, Review: review, LifecycleDone: true, Blockers: append([]string{}, review.Blockers...)}\n\tstate.VerificationBasis = \"applicable-review-contract\"\n\tif review.BundleID != \"\" {\n\t\tstate.VerificationBasis = \"sealed-review-contract\"\n\t}\n\tif !review.Required {\n\t\tstate.VerificationBasis = \"review-not-required-under-applicable-policy\"\n\t\tstate.Limitations = []string{\"Review is not required under the applicable policy/cutoff; this does not establish a historical execution receipt.\"}\n\t}\n\tvar diagnostics []Diagnostic\n\tfor _, blocker := range review.Blockers {\n\t\tdiagnostics = append(diagnostics, OpaqueDiagnostic(\"review-blocker\", DiagnosticCloseout, blocker))\n\t}\n\tblock := func(d Diagnostic) {\n\t\tdiagnostics = append(diagnostics, d)\n\t\tstate.Blockers = append(state.Blockers, d.Message)\n\t}\n\tchildStore := s\n\t// includeFederated=false already suppresses recursive acceptance. Keep the\n\t// authorized binding: clearing it makes a child borrow its parent's active\n\t// read view under a different Store context.\n\tswitch scope.Kind {\n\tcase \"spec\":\n\t\tsp, err := s.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tstate.LifecycleDone = sp.Status == \"done\"\n\t\t// A question the current bundle's adjudication says does not hold\n\t\t// blocks the closeout as it fails the lint (spec\n\t\t// pose-delegated-verdict-destinations R1; review round 1, B05).\n\t\tfor _, message := range s.adjudicationBlockers(scope.Slug) {\n\t\t\tblock(OpaqueDiagnostic(AdjudicationDoesNotHoldCode, DiagnosticCloseout, message))\n\t\t}\n\t\tif _, findings, historyErr := s.InspectAmendmentHistory(*sp); historyErr != nil {\n\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+historyErr.Error()))\n\t\t\tstate.Limitations = append(state.Limitations, \"Amendment history could not be verified; inspect and repair it explicitly.\")\n\t\t} else {\n\t\t\tfor _, finding := range findings {\n\t\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+finding))\n\t\t\t}\n\t\t}\n\tcase \"milestone\":\n\t\trm, err := s.GetRoadmap(scope.Roadmap)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tcloseoutAdopted, adoptErr := s.closeoutReviewPolicyAdopted()\n\t\tcloseoutAdopted = closeoutAdopted || adoptErr != nil\n\t\tvar found bool\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tif milestone.ID != scope.Milestone {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfound = true\n\t\t\tfor _, raw := range milestone.Specs {\n\t\t\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n\t\t\t\tif unresolved != \"\" {\n\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", unresolved, raw))\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif external {\n\t\t\t\t\tif s.FederatedResolver == nil {\n\t\t\t\t\t\tblock(NewDiagnostic(\"external-member-unaccepted\", \"external member \"+raw+\" needs federated acceptance\", raw))\n\t\t\t\t\t}\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tchild, err := childStore.getCloseoutState(\"spec:\"+slug, false)\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn state, err\n\t\t\t\t}\n\t\t\t\tstate.Children = append(state.Children, child)\n\t\t\t\t// A roadmap may declare why a terminal member owes this milestone\n\t\t\t\t// nothing, under the legacy rule only: under an adopted closeout\n\t\t\t\t// review policy a child that is not terminal always blocks\n\t\t\t\t// (review round 12, N38).\n\t\t\t\tif !child.Terminal && !(review.Approved && !closeoutAdopted && s.declaredUnreviewed(scope) != \"\") {\n\t\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\n\t\t\t\t}\n\t\t\t}\n\t\t\t// An exempt milestone has no review of its own to judge its exit\n\t\t\t// gate: an approved member review must have judged it as it reads\n\t\t\t// now, or the close is blocked; the review stays dispensed. This\n\t\t\t// holds for one member too: a done spec sealed before the gate\n\t\t\t// existed never gains it (review round 6, N21).\n\t\t\tif decision := review.CloseoutReview; decision != nil && !decision.Required && strings.TrimSpace(milestone.ExitGate) != \"\" && !review.Approved && !s.exitGateJudgedByMember(rm.Slug, milestone, state.Children) {\n\t\t\t\tblock(NewDiagnostic(\"milestone-exit-gate-unjudged\", \"the exit gate of \"+ref+\" is judged by no approved review: seal and review the member that carries it (the only member, or the last one once every other member is closed), or review the milestone itself (`pose review bundle \"+ref+\" --seal`)\", ref))\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t\tif !found {\n\t\t\treturn state, fmt.Errorf(\"pose: milestone %s/%s not found\", scope.Roadmap, scope.Milestone)\n\t\t}\n\tcase \"roadmap\":\n\t\trm, err := s.GetRoadmap(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tstate.LifecycleDone = rm.Status == \"done\"\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tchild, err := childStore.getCloseoutState(\"milestone:\"+rm.Slug+\"/\"+milestone.ID, false)\n\t\t\tif err != nil {\n\t\t\t\treturn state, err\n\t\t\t}\n\t\t\tstate.Children = append(state.Children, child)\n\t\t\tif !child.Terminal {\n\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\n\t\t\t}\n\t\t}\n\t}\n\tif includeFederated && s.FederatedResolver != nil && (scope.Kind == \"roadmap\" || scope.Kind == \"milestone\") {\n\t\tvar acceptance FederatedRoadmapAcceptanceReport\n\t\tvar err error\n\t\tif scope.Kind == \"milestone\" {\n\t\t\tacceptance, err = s.FederatedMilestoneAcceptance(s.FederatedProjectID, scope.Roadmap, scope.Milestone, *s.FederatedResolver)\n\t\t} else {\n\t\t\tacceptance, err = s.FederatedRoadmapAcceptance(s.FederatedProjectID, scope.Slug, *s.FederatedResolver)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tstate.FederatedAcceptance = &acceptance\n\t\tif !acceptance.Ready {\n\t\t\tfor _, blocker := range acceptance.Blockers {\n\t\t\t\tblock(OpaqueDiagnostic(\"federated-acceptance-blocker\", DiagnosticCloseout, blocker))\n\t\t\t}\n\t\t}\n\t}\n\tif includeFederated && s.FederatedResolver != nil && scope.Kind == \"spec\" {\n\t\tacceptance, applies, err := s.FederatedSpecAcceptance(s.FederatedProjectID, scope.Slug, *s.FederatedResolver)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tif applies {\n\t\t\tstate.FederatedAcceptance = &acceptance\n\t\t\tif !acceptance.Ready {\n\t\t\t\tfor _, blocker := range acceptance.Blockers {\n\t\t\t\t\tblock(OpaqueDiagnostic(\"federated-acceptance-blocker\", DiagnosticCloseout, blocker))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tcloseOwed := false\n\tif scope.Kind == \"milestone\" || scope.Kind == \"roadmap\" {\n\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil && policy.CloseoutReviewAdopted() {\n}\n\n// localScopeClosed reports a local milestone or roadmap a dependency edge\n// names as closed by the terminal projection, under an adopted closeout\n// review policy where status alone never closes it. A scope already asking\n// along the chain is a cycle and is not proven closed.\nfunc (s Store) localScopeClosed(scope string) bool {\n\tfor _, asking := range s.closeoutChain {\n\t\tif asking == scope {\n\t\t\treturn false\n\t\t}\n\t}\n\ts.closeoutChain = append(append([]string{}, s.closeoutChain...), scope)\n\tclosed, err := s.closedByReceipt(scope)\n\treturn err == nil && closed\n}\n\n// CurrentCloseoutDecision is the decision for an open aggregate scope now:\n// the evaluator, then every protection that can only make it stronger. It is\n// what close judges before publishing and again inside the protected region.\nfunc (s Store) CurrentCloseoutDecision(ref string) (CloseoutReviewDecision, error) {\n\tpolicy, _, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn CloseoutReviewDecision{}, err\n\t}\n\treturn s.currentCloseoutDecision(ref, policy)\n}\n\nfunc (s Store) currentCloseoutDecision(ref string, policy ReviewPolicy) (CloseoutReviewDecision, error) {\n\tdecision, err := s.evaluateCloseoutReview(ref, policy)\n\tif err != nil || !decision.Adopted || decision.Required {\nfunc (s Store) GetRoadmap(slug string) (*Roadmap, error) {\n\tif err := ValidateSlug(slug); err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: invalid roadmap slug %q\", slug)\n\t}\n\tpath := filepath.Join(s.roadmapsDir(), slug+\".md\")\n\trm, err := parseRoadmapFile(s.fsys(), path, slug, true)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: roadmap %q not found\", slug)\n\t}\n\treturn rm, nil\n}\n\n// ListRoadmaps returns every roadmap (no body), sorted by slug.\nfunc (s Store) ListRoadmaps() ([]Roadmap, error) {\n\tentries, err := s.fsys().ReadDir(s.roadmapsDir())\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn []Roadmap{}, nil\n\t\t}\n\t\treturn nil, fmt.Errorf(\"pose: reading roadmaps dir: %w\", err)\n\t}\n\troadmaps := []Roadmap{}\n\tfor _, e := range entries {\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".md\") || strings.EqualFold(e.Name(), \"README.md\") {\n\t\t\tcontinue\n\t\t}\n\t\tslug := strings.TrimSuffix(e.Name(), \".md\")\n\t\trm, err := parseRoadmapFile(s.fsys(), filepath.Join(s.roadmapsDir(), e.Name()), slug, false)\n\t\tif err != nil {\n\t\t\tcontinue // um artefato quebrado não derruba a listagem\n\t\t}\n\t\troadmaps = append(roadmaps, *rm)\n\t}\n\tsort.Slice(roadmaps, func(i, j int) bool { return roadmaps[i].Slug < roadmaps[j].Slug })\n\treturn roadmaps, nil\n}\n\nfunc parseRoadmapFile(files Files, path, slug string, includeBody bool) (*Roadmap, error) {\n\traw, err := files.ReadFile(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tfm, body := SplitFrontmatter(string(raw))\n\trm := &Roadmap{Slug: slug, Path: path, Milestones: []Milestone{}}\n\tfor key, value := range fm {\n\t\tswitch key {\n\t\tcase \"slug\":\n\t\t\tif value != \"\" {\n\t\t\t\trm.Slug = value\n\t\t\t}\n\t\tcase \"status\":\n\t\t\trm.Status = value\n\t\tcase \"created_at\":\n\t\t\trm.CreatedAt = value\n\t\tcase \"depends_on\":\n\t\t\trm.DependsOn = parseInlineList(value)\n\t\tcase \"consumes\":\n16:// the native CLI indexer.\n235:    \"pose-index-material-does-not-ask-closeout\": \"sha256:99bf208de6663149de7e8740546e3ad640b153a450c94636c4d10dff0bce0342\",\n693:    \"pose-index-material-does-not-ask-closeout\": \"sha256:eb5bf9f533bd9f9f4b274a9c54617bd2d90db8e4de1b7f772b7beb489d444b83\",\n4213:      \"id\": \"pose-mcp/go/index-material-does-not-ask-closeout-integration\",\n4216:      \"name\": \"index-material-does-not-ask-closeout-integration\",\npackage pose\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"testing\"\n)\n\nfunc TestIndexFederatedMaterialBindsReferencedSemanticsOnly(t *testing.T) {\n\tlocal, foreign, unrelated := t.TempDir(), t.TempDir(), t.TempDir()\n\tfor root, project := range map[string]string{local: \"proj.local\", foreign: \"proj.foreign\", unrelated: \"proj.unrelated\"} {\n\t\tif err := os.MkdirAll(filepath.Join(root, \".pose\", \"specs\"), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.MkdirAll(filepath.Join(root, \".pose\", \"roadmaps\"), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tqualifiedFile(t, root, \"project.json\", `{\"schema_version\":1,\"project_id\":\"`+project+`\"}`)\n\t}\n\tqualifiedFile(t, local, \"specs/consumer.md\", \"---\\nslug: consumer\\nstatus: in-progress\\ndepends_on: xref:proj.foreign/spec:engine\\n---\\n# Consumer\\n\")\n\tqualifiedFile(t, local, \"roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\nconsumes: xref:proj.foreign/spec:engine\\n---\\n\")\n\tqualifiedFile(t, foreign, \"specs/engine.md\", \"---\\nslug: engine\\nstatus: done\\n---\\n# Engine v1\\n\")\n\tqualifiedFile(t, unrelated, \"specs/other.md\", \"---\\nslug: other\\nstatus: done\\n---\\n# Other v1\\n\")\n\n\tbindings, err := json.Marshal(map[string]string{\n\t\t\"proj.local\": local, \"proj.foreign\": foreign, \"proj.unrelated\": unrelated,\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"POSE_DEFAULT_PROJECT_ID\", \"\")\n\tt.Setenv(\"POSE_PROJECT_ROOTS\", string(bindings))\n\tresolver, project, err := EnvironmentArtifactResolverIn(NativeFiles(), local, \"\")\n\tif err != nil || project != \"proj.local\" {\n\t\tt.Fatalf(\"resolver = %q, %v\", project, err)\n\t}\n\tstore := Store{Root: local, FS: NativeFiles(), FederatedProjectID: project, FederatedResolver: &resolver}\n\tbefore, err := BuildIndexFederatedMaterialIn(store)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !reflect.DeepEqual(before.Projects, []string{\"proj.foreign\"}) {\n\t\tt.Fatalf(\"material roots = %v, want only the referenced foreign project\", before.Projects)\n\t}\n\tif len(before.Projection.Specs) != 1 || len(before.Projection.Roadmaps) != 1 {\n\t\tt.Fatalf(\"federated projection omitted an output input: specs=%d roadmaps=%d\", len(before.Projection.Specs), len(before.Projection.Roadmaps))\n\t}\n\tbeforeDigest, known := IndexFederatedMaterialDigest(before.Projection)\n\tif !known || beforeDigest == \"\" {\n\t\tt.Fatal(\"semantic material digest was unknown\")\n\t}\n\tbound, known := IndexInputBindingIn(NativeFiles(), local, \"federated-material\")\n\tif !known || bound != beforeDigest {\n\t\tt.Fatalf(\"input binding did not use the shared projection: binding=%q projection=%q known=%v\", bound, beforeDigest, known)\n\t}\n\n\tqualifiedFile(t, unrelated, \"specs/other.md\", \"---\\nslug: other\\nstatus: draft\\n---\\n# Other unrelated edit\\n\")\n\tafterUnrelated, err := BuildIndexFederatedMaterialIn(store)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tunrelatedDigest, known := IndexFederatedMaterialDigest(afterUnrelated.Projection)\n\tif !known || unrelatedDigest != beforeDigest {\n\t\tt.Fatalf(\"unrelated root edit changed federated material digest: %q -> %q\", beforeDigest, unrelatedDigest)\n\t}\n\n\tqualifiedFile(t, foreign, \"specs/engine.md\", \"---\\nslug: engine\\nstatus: done\\n---\\n# Engine v2\\n\")\n\tafterForeign, err := BuildIndexFederatedMaterialIn(store)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tforeignDigest, known := IndexFederatedMaterialDigest(afterForeign.Projection)\n\tif !known || foreignDigest == beforeDigest {\n\t\tt.Fatalf(\"referenced foreign edit did not stale federated material: %q -> %q\", beforeDigest, foreignDigest)\n\t}\n\tbound, known = IndexInputBindingIn(NativeFiles(), local, \"federated-material\")\n\tif !known || bound != foreignDigest {\n\t\tt.Fatalf(\"foreign edit binding disagrees with builder projection: binding=%q projection=%q known=%v\", bound, foreignDigest, known)\n\t}\n\tif before.SpecDependencyResolutions[\"consumer\"][0].Digest == afterForeign.SpecDependencyResolutions[\"consumer\"][0].Digest {\n\t\tt.Fatal(\"foreign spec dependency digest did not track the changed content\")\n\t}\n\tif before.RoadmapAcceptances[\"program\"].Manifest.Digest == afterForeign.RoadmapAcceptances[\"program\"].Manifest.Digest {\n\t\tt.Fatal(\"federated roadmap acceptance digest did not track the changed dependency\")\n\t}\n}\n\nfunc TestIndexFederatedMaterialIgnoresUnrelatedCoordinatorCommit(t *testing.T) {\n\troot := t.TempDir()\n\tfor _, relative := range []string{\".pose/specs\", \".pose/roadmaps\", \".pose/policy\"} {\n\t\tif err := os.MkdirAll(filepath.Join(root, relative), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tqualifiedFile(t, root, \"project.json\", `{\"schema_version\":1,\"project_id\":\"proj.coordinator\"}`)\n\tqualifiedFile(t, root, \"specs/consumer.md\", \"---\\nslug: consumer\\nstatus: in-progress\\ndepends_on: xref:proj.coordinator/spec:dependency\\n---\\n# Consumer\\n\")\n\tqualifiedFile(t, root, \"specs/dependency.md\", \"---\\nslug: dependency\\nstatus: done\\n---\\n# Dependency\\n\")\n\tqualifiedFile(t, root, \"roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\nconsumes: xref:proj.coordinator/spec:dependency\\n---\\n\")\n\tif out, err := exec.Command(\"git\", \"-C\", root, \"init\", \"-q\").CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git init: %s: %v\", out, err)\n\t}\n\tfor _, args := range [][]string{\n\t\t{\"config\", \"user.name\", \"POSE fixture\"},\n\t\t{\"config\", \"user.email\", \"pose@example.invalid\"},\n\t\t{\"add\", \"--all\"},\n\t\t{\"commit\", \"-q\", \"-m\", \"coordinator baseline\"},\n\t} {\n\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...).CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %s: %v\", args, out, err)\n\t\t}\n\t}\n\tresolver := ArtifactResolver{Roots: NewRoots(RootsConfig{DefaultRoot: root, DefaultProjectID: \"proj.coordinator\"}), FS: NativeFiles()}\n\tstore := Store{Root: root, FS: NativeFiles(), FederatedProjectID: \"proj.coordinator\", FederatedResolver: &resolver}\n\tbefore, err := BuildIndexFederatedMaterialIn(store)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbeforeDigest, known := IndexFederatedMaterialDigest(before.Projection)\n\tif !known {\n\t\tt.Fatal(\"initial coordinator material digest is unknown\")\n\t}\n\n\tif err := os.WriteFile(filepath.Join(root, \"unrelated.txt\"), []byte(\"routine evidence\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, args := range [][]string{{\"add\", \"unrelated.txt\"}, {\"commit\", \"-q\", \"-m\", \"unrelated coordinator evidence\"}} {\n\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...).CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %s: %v\", args, out, err)\n\t\t}\n\t}\n\tafter, err := BuildIndexFederatedMaterialIn(store)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tafterDigest, known := IndexFederatedMaterialDigest(after.Projection)\n\tif !known || afterDigest != beforeDigest {\n\t\tt.Fatalf(\"unrelated coordinator commit changed federated material digest: %q -> %q\", beforeDigest, afterDigest)\n","exit_code":0,"status":"completed"}}
