{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '250,295p' pose-mcp/internal/cli/index.go; rg -n 'func refresh.*|func buildCurrentDeliveryGraph' pose-mcp/internal/cli/{index.go,surface_check.go}; rg -n 'POSE_.*(READ|WRITE|REFRESH)|refreshDeliveryIndex' pose-mcp/internal/cli/*.go; git diff --check 5e14337100be40d52508587fbc42a070c0b79c6e..ee960dffb9ba49a8ad255a31076cf3ca146fef92\"","aggregated_output":"\t}\n\tgate.Verdict(cliout.StatePass, \"index generation \"+view.Descriptor.GenerationID+\" is current\", \"index generation current\")\n\treturn 0\n}\n\n// refreshDeliveryIndex publishes a recomputed delivery graph. When the indexes were\n// published as a generation it replaces that file in a new generation, so the\n// descriptor keeps describing the set; before the first `pose index` there is no\n// generation and the file is written as it always was. A set that cannot be\n// verified is not written over: the failure is said, not hidden.\nfunc refreshDeliveryIndex(root string, data []byte, stderr io.Writer) {\n\tif posepkg.IsSealedCheckout(root) {\n\t\treturn\n\t}\n\t_ = os.MkdirAll(filepath.Join(root, \".pose\", \"indexes\"), 0o755)\n\treceipt, _, err := posepkg.Store{Root: root}.ReplaceIndexOrLegacy(\"delivery-integrity.json\", data)\n\tswitch {\n\tcase err == nil:\n\t\tif receipt.CleanupError != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose: retention of old index generations failed: \" + receipt.CleanupError.Error())\n\t\t}\n\tcase receipt.Committed:\n\t\trender(io.Discard, stderr).Failure(\"pose: the delivery index was published as generation \" + receipt.GenerationID + \", but its durability could not be confirmed: \" + err.Error() + \"; run `pose index --verify`\")\n\tdefault:\n\t\trender(io.Discard, stderr).Failure(\"pose: the delivery index was not refreshed: \" + err.Error() + \"; run `pose index`\")\n\t}\n}\npose-mcp/internal/cli/index.go:260:func refreshDeliveryIndex(root string, data []byte, stderr io.Writer) {\npose-mcp/internal/cli/sealed_checkout_refresh_test.go:21:\trefreshDeliveryIndex(root, []byte(\"{}\\n\"), &stderr)\npose-mcp/internal/cli/sealed_checkout_refresh_test.go:29:\trefreshDeliveryIndex(other, []byte(\"{}\\n\"), &stderr)\npose-mcp/internal/cli/sealed_checkout_refresh_test.go:34:\trefreshDeliveryIndex(root, []byte(\"{}\\n\"), &stderr)\npose-mcp/internal/cli/review_closeout.go:584:\t\t\t\trefreshDeliveryIndex(root, append(raw, '\\n'), stderr)\npose-mcp/internal/cli/index_generation_test.go:153:\trefreshDeliveryIndex(root, []byte(\"{\\\"schema_version\\\":1}\\n\"), &errOut)\npose-mcp/internal/cli/index_generation_test.go:166:\trefreshDeliveryIndex(root, []byte(\"{\\\"schema_version\\\":1,\\\"x\\\":1}\\n\"), &errOut)\npose-mcp/internal/cli/index_generation_test.go:174:\trefreshDeliveryIndex(legacy, []byte(\"{\\\"schema_version\\\":1,\\\"legacy\\\":true}\\n\"), &errOut)\npose-mcp/internal/cli/index_generation_test.go:291:\trefreshDeliveryIndex(root, []byte(\"{\\\"schema_version\\\":1,\\\"x\\\":2}\\n\"), &errOut)\npose-mcp/internal/cli/index_generation_test.go:315:\trefreshDeliveryIndex(root, []byte(\"{\\\"schema_version\\\":1,\\\"y\\\":3}\\n\"), &errOut)\npose-mcp/internal/cli/artifact_integrity.go:925:\t\t\trefreshDeliveryIndex(root, append(raw, '\\n'), stderr)\npose-mcp/internal/cli/index.go:255:// refreshDeliveryIndex publishes a recomputed delivery graph. When the indexes were\npose-mcp/internal/cli/index.go:260:func refreshDeliveryIndex(root string, data []byte, stderr io.Writer) {\n","exit_code":0,"status":"completed"}}
