 = &assurance\n\t\t\treturn\n\t\t}\n\t}\n\tif !eval.Required && eval.Current == nil {\n\t\treturn\n\t}\n\tindependence, required := \"\", \"\"\n\tif scope, err := ParseScopeRef(eval.Scope); err == nil {\n\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil {\n\t\t\tindependence = policy.ReviewerIndependence[scope.Kind]\n\t\t\trequired = policy.ReviewIdentityAssurance(scope.Kind)\n\t\t}\n\t}\n\tassurance := describeAttemptAssurance(required, independence, eval.Current)\n\teval.Assurance = &assurance\n}\n\nfunc (s Store) reviewCheck(ref string) (ReviewEvaluation, error) {\n\tif s.indexPin == nil {\n\t\ts = s.PinIndexes()\n\t}\n\ts = s.reviewOperation()\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn ReviewEvaluation{}, err\n\t}\n\tdigest, err := s.ScopeDigest(ref)\n\tif err != nil {\n\t\treturn ReviewEvaluation{}, err\n\t}\n\tpolicy, _, err := s.loadReviewPolicy()\n\t\t\tcomponent.Domain = \"\"\n\t\tcase \"criticality\":\n\t\t\tcomponent.Criticality = \"\"\n\t\tcase \"validationprofile\", \"validation_profile\":\n\t\t\tcomponent.ValidationProfile = \"\"\n\t\t}\n\t}\n}\n\nfunc (s Store) reviewScopeSpecs(scope ScopeRef) ([]Spec, error) {\n\tslugs := []string{}\n\tswitch scope.Kind {\n\tcase \"spec\":\n\t\tslugs = append(slugs, scope.Slug)\n\tcase \"milestone\":\n\t\trm, err := s.GetRoadmap(scope.Roadmap)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfound := false\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tif milestone.ID == scope.Milestone {\n\t\t\t\tslugs, found = append(slugs, milestone.Specs...), true\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\treturn nil, fmt.Errorf(\"pose: milestone %s/%s not found\", scope.Roadmap, scope.Milestone)\n\t\t}\n\tcase \"roadmap\":\n\t\trm, err := s.GetRoadmap(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tslugs = append(slugs, milestone.Specs...)\n\t\t}\n\t}\n\tspecs := []Spec{}\n\tfor _, raw := range uniqueSorted(slugs) {\n\t\t// Another project's member contributes no local components; its\n\t\t// review lives in its own project and reaches this scope through the\n\t\t// federated manifest.\n\t\tslug, external := s.canonicalMember(raw)\n\t\tif external {\n\t\t\tcontinue\n\t\t}\n\t\tsp, err := s.GetSpec(slug)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tspecs = append(specs, *sp)\n\t}\n\treturn specs, nil\n}\n\nfunc (s Store) loadReviewRepoEntries() ([]reviewRepoEntry, error) {\n\tentries := []reviewRepoEntry{}\n\tseen := map[string]bool{}\n\n\t// 1. Try .pose/indexes/repo-map.json if present\n\traw, _, mapErr := s.ReadIndex(\"repo-map.json\")\n\tif errors.Is(mapErr, ErrIndexGenerationUnavailable) {\n\t\treturn nil, fmt.Errorf(\"review component map is unavailable: %w\", mapErr)\n\t}\n\tif mapErr == nil {\n\t\tvar repo struct {\n\t\t\tApps     []reviewRepoEntry `json:\"apps\"`\n\t\t\tServices []reviewRepoEntry `json:\"services\"`\n\t\t\tPackages []reviewRepoEntry `json:\"packages\"`\n\t\t}\n\t\tif err := json.Unmarshal(raw, &repo); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"review component map is invalid: %w\", err)\n\t\t}\n\t\tfor kind, values := range map[string][]reviewRepoEntry{\"app\": repo.Apps, \"service\": repo.Services, \"package\": repo.Packages} {\n\t\t\tfor _, entry := range values {\n\t\t\t\tentry.Kind = kind\n\t\t\treturn false\n\t\t}\n\t\tdelete(covered, name)\n\t\tmatched++\n\t}\n\treturn matched > 0 && len(covered) == 0\n}\n\nfunc (s Store) withReviewOperationView(view *reviewOperationView, run func(Store)) error {\n\ts.reviewView = view\n\ts.specs = nil       // an earlier advisory listing is not this operation's capture\n\ts.reviewReuse = nil // copied worker stores each start their own traversal\n\tdefer view.closed.Store(true)\n\trun(s)\n\t// Join lazy initialization, if any; finalization must follow joined workers.\n\tview.once.Do(func() {})\n\tview.specOnce.Do(func() {})\n\treturn errors.Join(view.validateSpecs(), view.validate())\n}\n\n// prepareReviewOperationRead preserves Store's live-read behavior after an\n// operation view retires, while refusing to borrow an active view under a\n// different root, project, resolver, or Files binding.\nfunc (s Store) prepareReviewOperationRead() (Store, error) {\n\tif s.reviewView != nil && s.reviewView.closed.Load() {\n\t\ts = s.withoutGovernanceReadView()\n\t}\n\treadView, viewFiles := governanceReadViewFromFiles(s.fsys())\n\tif readView != nil {\n\t\treadView.mu.Lock()\n\t\tfinalized := readView.closed\n\t\treadView.mu.Unlock()\n\t\tif finalized {\n\t\t\ts = s.withoutGovernanceReadView()\n\t\t\treadView, viewFiles = governanceReadViewFromFiles(s.fsys())\n\t\t}\n   518\t\t\t\t\tbundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, proofBlockers := federatedSourceProof(s.fsys(), source, proven, resolved.Revision)\n   519\t\t\t\t\tentry.ReviewBundleID, entry.ReviewBundleDigest = bundleID, bundleDigest\n   520\t\t\t\t\tentry.ImplementationDigest, entry.PlanDigest = subjectDigest, planDigest\n   521\t\t\t\t\tentry.GoverningContracts, entry.Evidence = contracts, evidence\n   522\t\t\t\t\treport.Blockers = append(report.Blockers, proofBlockers...)\n   523\t\t\t\t\tif len(proofBlockers) > 0 {\n   524\t\t\t\t\t\tentry.ResolutionState = \"source-evidence-incomplete\"\n   525\t\t\t\t\t}\n   526\t\t\t\t}\n   527\t\t\t}\n   528\t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n   529\t\t\tfor _, dep := range resolved.Dependencies {\n   530\t\t\t\tqueue = append(queue, federatedQueuedRef{project: dep.Project, parent: proven.Project, raw: dep.String(), relationship: \"prerequisite\"})\n   531\t\t\t}\n   532\t\t}\n   533\t\tfor project, selected := range snapshotRevisions {\n   534\t\t\tif selected == \"\" {\n   535\t\t\t\tcontinue\n    55\t// Store must carry the operation's authorized resolver when one has already\n    56\t// been established; it is reused unchanged except for the captured Files the\n    57\t// operation view supplies.\n    58\tfunc BuildIndexFederatedMaterialIn(store Store) (IndexFederatedMaterial, error) {\n    59\t\tstore.indexMaterial = true\n    60\t\tresolver := ArtifactResolver{}\n    61\t\tproject := store.FederatedProjectID\n    62\t\tif store.FederatedResolver != nil {\n    63\t\t\tresolver = *store.FederatedResolver\n","exit_code":0,"status":"completed"}}
