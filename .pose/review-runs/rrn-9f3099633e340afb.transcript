{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc 'git diff --stat d724738b53a8fe94ec9b2eb749a5242958f06d4a..95ee4223d77030f8c9bbd62ccd5fc6663732472b; rg --files -g AGENTS.md -g POSE.md pose-mcp; git diff d724738b..95ee4223 -- pose-mcp/internal/pose/governance_read_view_stream.go pose-mcp/internal/pose/governance_read_view.go pose-mcp/internal/pose/governance_read_view_git.go pose-mcp/internal/cli/artifact_integrity.go'","aggregated_output":" ...nce-reads-use-bounded-operation-scoped-views.md |   17 +\n .pose/indexes/delivery-integrity.json              | 7869 +++++++++++---------\n .pose/indexes/generation.json                      |   18 +-\n .pose/indexes/spec-graph.json                      | 1162 +--\n .pose/indexes/validation-matrix.json               |    7 +\n .pose/results/delivery-validation.json             | 1616 ++--\n ...11-14-pose-read-view-streamed-object-digests.md |  187 +\n .../pose-read-view-streamed-object-digests.json    |   75 +\n POSE.md                                            |    2 +-\n locales/pt-BR/POSE.md                              |    2 +-\n pose-mcp/internal/cli/artifact_integrity.go        |   50 +-\n .../cli/change_set_streamed_digest_test.go         |   35 +\n pose-mcp/internal/pose/governance_read_view.go     |    3 +-\n pose-mcp/internal/pose/governance_read_view_git.go |   35 +-\n .../internal/pose/governance_read_view_stream.go   |  338 +\n .../pose/governance_read_view_stream_test.go       |  183 +\n pose-mcp/internal/scaffold/dist/POSE.md            |    2 +-\n .../internal/scaffold/dist/locales/pt-BR/POSE.md   |    2 +-\n 18 files changed, 6511 insertions(+), 5092 deletions(-)\npose-mcp/internal/scaffold/dist/POSE.md\npose-mcp/internal/scaffold/dist/AGENTS.md\npose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\npose-mcp/internal/scaffold/dist/locales/pt-BR/AGENTS.md\ndiff --git a/pose-mcp/internal/cli/artifact_integrity.go b/pose-mcp/internal/cli/artifact_integrity.go\nindex b0f36ad0..1db473da 100644\n--- a/pose-mcp/internal/cli/artifact_integrity.go\n+++ b/pose-mcp/internal/cli/artifact_integrity.go\n@@ -57,6 +57,41 @@ func gitOutputBoundedContext(ctx context.Context, root string, limit int, args .\n \treturn stdout.Bytes(), nil\n }\n \n+// gitStreamBounded streams a raw-history read into sink, bounded like\n+// gitOutputBounded, without retaining the output.\n+func gitStreamBounded(root string, limit int, sink io.Writer, args ...string) error {\n+\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n+\tdefer cancel()\n+\tcmd := posemodel.RawHistoryGitContext(ctx, root, args...)\n+\tcmd.WaitDelay = 2 * time.Second\n+\tvar stderr bytes.Buffer\n+\tcmd.Stdout = &streamThrough{limit: limit, sink: sink}\n+\tcmd.Stderr = &limitedBuffer{buf: &stderr, limit: 64 * 1024}\n+\tif err := cmd.Run(); err != nil {\n+\t\tif ctx.Err() != nil {\n+\t\t\treturn fmt.Errorf(\"git %s failed: %w\", args[0], ctx.Err())\n+\t\t}\n+\t\treturn fmt.Errorf(\"git %s failed: %w: %s\", args[0], err, strings.TrimSpace(stderr.String()))\n+\t}\n+\treturn nil\n+}\n+\n+// streamThrough counts the bytes against the limit, keeping none, and\n+// forwards them to sink.\n+type streamThrough struct {\n+\tlimit   int\n+\tsink    io.Writer\n+\twritten int\n+}\n+\n+func (w *streamThrough) Write(data []byte) (int, error) {\n+\tif w.written+len(data) > w.limit {\n+\t\treturn 0, fmt.Errorf(\"bounded Git output exceeded %d bytes\", w.limit)\n+\t}\n+\tw.written += len(data)\n+\treturn w.sink.Write(data)\n+}\n+\n // gitOutputBoundedIn preserves the raw-history command policy while routing\n // the exact output through an operation read view when Files carries one.\n func gitOutputBoundedIn(files posemodel.Files, root string, limit int, args ...string) ([]byte, error) {\n@@ -202,6 +237,14 @@ func resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec,\n \t\t}\n \t\treturn gitOutputBoundedIn(files, root, limit, args...)\n \t}\n+\tgitStream := func(limit int, sink io.Writer, args ...string) error {\n+\t\tif files == nil {\n+\t\t\treturn gitStreamBounded(root, limit, sink, args...)\n+\t\t}\n+\t\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n+\t\tdefer cancel()\n+\t\treturn posemodel.StreamGovernanceRawHistoryGitIn(files, ctx, root, \"index.delivery-integrity\", int64(limit), sink, args...)\n+\t}\n \tresolveRevision := func(revision string) (string, error) {\n \t\treturn resolveGitRevisionWithFiles(files, root, revision)\n \t}\n@@ -274,11 +317,12 @@ func resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec,\n \t\t\t}\n \t\t\tcommitPathLists = append(commitPathLists, parsed)\n \t\t\tobserved = append(observed, parsed...)\n-\t\t\tcommitDiff, err := gitOutput(16*1024*1024, \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", sha, \"--\")\n-\t\t\tif err != nil {\n+\t\t\t// The commit's patch only feeds the digest: it is streamed into\n+\t\t\t// it, the same bytes in the same order, and the read view keeps\n+\t\t\t// its digest, not its bytes (spec pose-read-view-streamed-object-digests).\n+\t\t\tif err := gitStream(16*1024*1024, diffHash, \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", sha, \"--\"); err != nil {\n \t\t\t\treturn posemodel.ChangeSet{}, err\n \t\t\t}\n-\t\t\t_, _ = diffHash.Write(commitDiff)\n \t\t}\n \t\tpaths = mergeObservedPaths(commitPathLists)\n \t} else {\ndiff --git a/pose-mcp/internal/pose/governance_read_view.go b/pose-mcp/internal/pose/governance_read_view.go\nindex 1072fd11..41246405 100644\n--- a/pose-mcp/internal/pose/governance_read_view.go\n+++ b/pose-mcp/internal/pose/governance_read_view.go\n@@ -22,7 +22,7 @@ const (\n \tGovernanceReadViewSchemaVersion = 1\n \tgovernanceReadViewParserVersion = \"pose-governance-inputs-v1\"\n \tgovernanceReadViewMaxRecords    = 40000\n-\tgovernanceReadViewMaxInputBytes = 1024 * 1024 * 1024\n+\tgovernanceReadViewMaxInputBytes = 512 * 1024 * 1024\n \tgovernanceReadViewMaxMetadata   = 