ng\n+}\n+\n+// governanceStreamPureObjectRead reports a patch read of one commit named by\n+// its full object id: `show --binary --no-ext-diff --format= <id> --`.\n+func governanceStreamPureObjectRead(args []string) bool {\n+\treturn len(args) == 6 && args[0] == \"show\" && args[1] == \"--binary\" && args[2] == \"--no-ext-diff\" &&\n+\t\targs[3] == \"--format=\" && governanceFullObjectID.MatchString(args[4]) && args[5] == \"--\"\n+}\n+\n+// StreamGovernanceRawHistoryGitIn runs a raw-history Git read of an immutable\n+// object and streams its output into sink. Inside a governance read view the\n+// view records the output's digest and length as the observation and keeps\n+// no bytes; reading the same command again in the operation streams it again\n+// and leaves the producer unknown if it differs. Outside a view it is a\n+// bounded streaming run.\n+func StreamGovernanceRawHistoryGitIn(files Files, ctx context.Context, root, producer string, maxBytes int64, sink io.Writer, args ...string) error {\n+\tif maxBytes <= 0 || maxBytes > governanceReadViewMaxStreamedRead {\n+\t\treturn fmt.Errorf(\"pose: streamed Git output limit must be between 1 and %d bytes\", governanceReadViewMaxStreamedRead)\n+\t}\n+\tif ctx == nil {\n+\t\tctx = context.Background()\n+\t}\n+\tfiles = FilesOrNative(files)\n+\tview, viewFiles := governanceReadViewFromFiles(files)\n+\tif view == nil {\n+\t\t_, _, _, err := runGovernanceGitStreamContext(ctx, files, root, args, maxBytes, nil, sink)\n+\t\treturn err\n+\t}\n+\tif view.operation == nil {\n+\t\tview.markUnknown(producer, \"Git input has no operation-scoped generation vector\")\n+\t\t_, _, _, err := runGovernanceGitStreamContext(ctx, files, root, args, maxBytes, nil, sink)\n+\t\treturn err\n+\t}\n+\tif viewFiles != nil {\n+\t\tif target := view.route(root, producer, viewFiles.project); target == nil {\n+\t\t\tview.markUnknown(producer, \"Git input is outside the authorized root generation vector\")\n+\t\t\treturn errGovernanceReadViewOutsideRoot\n+\t\t} else {\n+\t\t\tview = target\n+\t\t}\n+\t}\n+\top := view.operation\n+\tabsolute, target, state, err := op.gitRoot(root, producer)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif err := target.begin(); err != nil {\n+\t\treturn err\n+\t}\n+\tdefer target.end()\n+\treturn state.stream(files, ctx, absolute, producer, maxBytes, sink, args...)\n+}\n+\n+func (op *governanceReadViewOperation) reserveStreamed(size int64) bool {\n+\tif op == nil {\n+\t\treturn size >= 0 && size <= governanceReadViewMaxStreamedBytes\n+\t}\n+\tif size < 0 {\n+\t\treturn false\n+\t}\n+\top.budgetMu.Lock()\n+\tdefer op.budgetMu.Unlock()\n+\tif size > governanceReadViewMaxStreamedBytes-op.streamedBytes {\n+\t\treturn false\n+\t}\n+\top.streamedBytes += size\n+\treturn true\n+}\n+\n+func (state *governanceReadViewGitState) stream(files Files, ctx context.Context, root, producer string, maxBytes int64, sink io.Writer, args ...string) error {\n+\tdeadline, hasDeadline := ctx.Deadline()\n+\tkey := governanceGitObservationKey(root, args, maxBytes)\n+\tstate.mu.Lock()\n+\tif state.streams == nil {\n+\t\tstate.streams = map[string]*governanceReadViewStreamObservation{}\n+\t}\n+\tprior := state.streams[key]\n+\tif prior == nil {\n+\t\tmetadataCost := int64(len(root) + len(key) + len(producer) + 128)\n+\t\tif !state.op.reserveRecord(metadataCost) {\n+\t\t\tstate.mu.Unlock()\n+\t\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its shared record or metadata budget while streaming Git\")\n+\t\t\treturn errGovernanceReadViewBudget\n+\t\t}\n+\t}\n+\tstate.mu.Unlock()\n+\tdigest, length, stderr, runErr := governanceStreamRun(ctx, files, root, args, maxBytes, state.op.reserveStreamed, sink)\n+\tif errors.Is(runErr, errGovernanceReadViewBudget) {\n+\t\tstate.markUnknownForRoot(root, producer, \"Git streamed output exceeded the read-view streamed byte budget\")\n+\t\treturn errGovernanceReadViewBudget\n+\t}\n+\t_ = stderr\n+\tstate.mu.Lock()\n+\tif prior = state.streams[key]; prior != nil {\n+\t\tprior.producers[producer] = true\n+\t\tsame := prior.digest == digest && prior.length == length && prior.errText == errorText(runErr)\n+\t\tstate.mu.Unlock()\n+\t\tif !same {\n+\t\t\tstate.markUnknownForRoot(root, producer, \"a streamed Git object read differed within the operation\")\n+\t\t\treturn errGovernanceReadViewBudget\n+\t\t}\n+\t\treturn runErr\n+\t}\n+\tstate.mu.Unlock()\n+\tconfig := \"\"\n+\tif runErr == nil && governanceStreamPureObjectRead(args) {\n+\t\tconfig = state.effectiveGitConfig(ctx, files, root)\n+\t}\n+\tstate.mu.Lock()\n+\tif state.streams[key] == nil {\n+\t\tstate.streams[key] = &governanceReadViewStreamObservation{\n+\t\t\troot: root, args: append([]string(nil), args...), files: files, ctx: context.WithoutCancel(ctx), deadline: deadline, hasDeadline: hasDeadline,\n+\t\t\tmaxBytes: maxBytes, digest: digest, length: length, errText: errorText(runErr), producers: map[string]bool{producer: true}, config: config,\n+\t\t}\n+\t} else {\n+\t\tstate.streams[key].producers[producer] = true\n+\t}\n+\tstate.mu.Unlock()\n+\treturn runErr\n+}\n+\n+// auditStreams streams every observation again, under its own audit budget,\n+// and reports a producer changed when the digest, length or error differs.\n+func (state *governanceReadViewGitState) auditStreams(result *governanceReadViewAudit) {\n+\tstate.mu.Lock()\n+\tstreams := make([]governanceReadViewStreamObservation, 0, len(state.streams))\n+\tfor _, item := range state.streams {\n+\t\tcopy := *item\n+\t\tcopy.args = append([]string(nil), item.args...)\n+\t\tcopy.producers = cloneBoolMap(item.producers)\n+\t\tstreams = append(streams, copy)\n+\t}\n+\tstate.mu.Unlock()\n+\tsort.Slice(streams, func(i, j int) bool {\n+\t\treturn governanceGitObservationKey(streams[i].root, streams[i].args, streams[i].maxBytes) < governanceGitObservationKey(streams[j].root, streams[j].args, streams[j].maxBytes)\n+\t})\n+\tvar budgetMu sync.Mutex\n+\tremaining := int64(governanceReadViewMaxStreamedBytes)\n+\tadmit := func(size int64) bool {\n+\t\tbudgetMu.Lock()\n+\t\tdefer budgetMu.Unlock()\n+\t\tif size < 0 || size > remaining {\n+\t\t\treturn false\n+\t\t}\n+\t\tremaining -= size\n+\t\treturn true\n+\t}\n+\tconfigs := map[string]string{}\n+\tfor _, item := range streams {\n+\t\t// A pure object read stands while the configuration it was read under\n+\t\t// does: the object cannot change, only how Git renders it.\n+\t\tif item.config != \"\" {\n+\t\t\tnow, read := configs[item.root]\n+\t\t\tif !read {\n+\t\t\t\tnow = freshGovernanceGitConfig(item.ctx, item.files, item.root)\n+\t\t\t\tconfigs[item.root] = now\n+\t\t\t}\n+\t\t\tif now == item.config {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t}\n+\t\tauditContext := item.ctx\n+\t\tcancel := func() {}\n+\t\tif item.hasDeadline {\n+\t\t\tauditContext, cancel = context.WithDeadline(auditContext, item.deadline)\n+\t\t}\n+\t\tdigest, length, _, err := governanceAuditGitStream(auditContext, item.files, item.root, item.args, item.maxBytes, admit, io.Discard)\n+\t\tcancel()\n+\t\tif errors.Is(err, errGovernanceReadViewBudget) {\n+\t\t\tfor producer := range item.producers {\n+\t\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], \"Git streamed final audit exceeded its byte budget\")\n+\t\t\t}\n+\t\t\tcontinue\n+\t\t}\n+\t\tif digest != item.digest || length != item.length || errorText(err) != item.errText {\n+\t\t\tfor producer := range item.producers {\n+\t\t\t\tresult.ChangedProducers[producer] = true\n+\t\t\t}\n+\t\t\trootDigest := digestBytes([]byte(filepath.Clean(item.root)))\n+\t\t\targsDigest := digestBytes([]byte(strings.Join(item.args, \"\\x00\")))\n+\t\t\tresult.ChangedPaths = append(result.ChangedPaths, \"git:\"+strings.TrimPrefix(rootDigest, \"sha256:\")+\":\"+strings.TrimPrefix(argsDigest, \"sha256:\"))\n+\t\t}\n+\t}\n+}\n+\n+// governanceStreamRun and governanceAuditGitStream run streamed reads during\n+// the operation and in its final audit.\n+var (\n+\tgovernanceStreamRun      = runGovernanceGitStreamContext\n+\tgovernanceAuditGitStream = runGovernanceGitStreamContext\n+)\n+\n+// runGovernanceGitStreamContext runs Git like the captured reads do and\n+// writes its stdout to sink as it arrives, admitting each chunk before it is\n+// written and hashing it; stderr is kept bounded. It returns the stdout's\n+// digest and length. A non-empty stderr is an error, as for captured reads.\n+func runGovernanceGitStreamContext(ctx context.Context, files Files, root string, args []string, limit int64, admit func(int64) bool, sink io.Writer) (string, int64, []byte, error) {\n+\tif limit <= 0 {\n+\t\treturn \"\", 0, nil, errGovernanceReadViewBudget\n+\t}\n+\t_ = FilesOrNative(files)\n+\tif ctx == nil {\n+\t\tctx = context.Background()\n+\t}\n+\tif sink == nil {\n+\t\tsink = io.Discard\n+\t}\n+\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n+\tcmd.WaitDelay = 2 * time.Second\n+\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n+\tout := &governanceStreamWriter{limit: limit, admit: admit, sink: sink, hash: sha256.New()}\n+\tvar stderr bytes.Buffer\n+\tcmd.Stdout = out\n+\tcmd.Stderr = &limitedStderr{buf: &stderr, limit: governanceStreamStderrLimit}\n+\terr := cmd.Run()\n+\tif out.exceeded {\n+\t\treturn \"\", 0, nil, errGovernanceReadViewBudget\n+\t}\n+\tdigest := \"sha256:\" + hex.EncodeToString(out.hash.Sum(nil))\n+\tif err != nil {\n+\t\tif exit, ok := err.(*exec.ExitError); ok {\n+\t\t\texit.Stderr = append([]byte(nil), stderr.Bytes()...)\n+\t\t}\n+\t\treturn digest, out.written, stderr.Bytes(), &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n+\t}\n+\tif stderr.Len() > 0 {\n+\t\tdetail := strings.TrimSpace(stderr.String())\n+\t\tif detail == \"\" {\n+\t\t\tdetail = \"Git wrote unclassified stderr output\"\n+\t\t}\n+\t\treturn digest, out.written, stderr.Bytes(), &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: errors.New(detail)}\n+\t}\n+\treturn digest, out.written, nil, nil\n+}\n+\n+type governanceStreamWriter struct {\n+\tmu       sync.Mutex\n+\tlimit    int64\n+\twritten  int64\n+\tadmit    func(int64) bool\n+\tsink     io.Writer\n+\thash     hash.Hash\n+\texceeded bool\n+}\n+\n+func (w *governanceStreamWriter) Write(data []byte) (int, error) {\n+\tw.mu.Lock()\n+\tdefer w.mu.Unlock()\n+\tif w.exceeded || int64(len(data)) > w.limit-w.written || w.admit != nil && !w.admit(int64(len(data))) {\n+\t\tw.exceeded = true\n+\t\treturn 0, errGovernanceReadViewBudget\n+\t}\n+\tif _, err := w.sink.Write(data); err != nil {\n+\t\treturn 0, err\n+\t}\n+\tw.hash.Write(data)\n+\tw.written += int64(len(data))\n+\treturn len(data), nil\n+}\n+\n+type limitedStderr struct {\n+\tbuf   *bytes.Buffer\n+\tlimit int\n+}\n+\n+func (w *limitedStderr) Write(data []byte) (int, error) {\n+\tif room := w.limit - w.buf.Len(); room > 0 {\n+\t\tif len(data) > room {\n+\t\t\tw.buf.Write(data[:room])\n+\t\t} else {\n+\t\t\tw.buf.Write(data)\n+\t\t}\n+\t}\n+\treturn len(data), nil\n+}\n+\n+// freshGovernanceGitConfig reads the digest of a root's effective Git\n+// configuration again, outside the operation's cached reading.\n+func freshGovernanceGitConfig(ctx context.Context, files Files, root string) string {\n+\tif ctx == nil {\n+\t\tctx = context.Background()\n+\t}\n+\tout, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, []string{\"config\", \"--list\", \"-z\", \"--includes\"}, 1<<20)\n+\tif err != nil {\n+\t\treturn \"\"\n+\t}\n+\tsum := sha256.Sum256(out)\n+\treturn hex.EncodeToString(sum[:8])\n+}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/specs/2026-11-14-pose-read-view-streamed-object-digests.md; cat .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/specs/2026-11-14-pose-read-view-streamed-object-digests.md; cat .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md'","aggregated_output":"---\nslug: pose-read-view-streamed-object-digests\nstatus: in-progress\ncreated_at: 2026-11-14\ncompleted_at:        # stamped on the transition to status: done\nsupersedes:          # slug of the superseded spec (when applicable)\ndepends_on:          # prerequisites, inline list: other-spec, milestone:<roadmap>/<id>, roadmap:<slug>\nremediates:          # optional explicit links: spec:slug@defect-fix, finding:rva-<16hex>/F1@revert (never inferred from depends_on)\npriority:            # integer >= 0 (lower = higher priority); ordering preference, not a blocker\ncomponents: pose-mcp\ntask_type: feature\nsurface:             # optional: minimal | standard | full (default) — minimal drops Tasks and derivable report sections; `pose specs facts <slug>` derives them\ndelivers: capability:read-view-streamed-object-digests\n---\n\n# Spec: pose-read-view-streamed-object-digests\n\n## 1. Intent\n\n### Goal\nFazer o read view de governança capturar em streaming, retendo só digest e tamanho, as leituras puras de objetos Git imutáveis cujos bytes o produtor apenas hasheia, para que o custo retido de `pose index` deixe de crescer com cada commit atribuído a uma spec.\n\n### Business value\nEm 2026-11-13, fechando `pose-closeout-review-policy-by-cost-benefit`, todo `pose index` do pose-dist passou a ser recusado: os change sets de todas as specs leem `git show --binary` de 2.451 commits (492 MB), e com os arquivos da geração a operação passou do orçamento de 512 MiB de entrada capturada. A emenda D10 da ADR de leituras de governança elevou o orçamento para 1 GiB, o que só comprou folga: o corpus cresce a cada commit atribuído, e o próximo estouro bloqueia de novo toda geração de índice, fechamento e revisão do repositório. É uma lacuna de consistência do motor: um limite de segurança que o uso normal do próprio POSE derruba.\n\n### Constraints\n- Os digests de diff e os IDs de change set devem ser idênticos byte a byte aos de hoje: os mesmos bytes, na mesma ordem, entram no mesmo hash. Recibos, change sets gravados e vínculos de entrega não podem mudar.\n- O read view continua sem cache entre operações (ADR governance-reads-use-bounded-operation-scoped-views): o ganho vem de não reter os bytes, não de reaproveitá-los entre execuções.\n- Estouro de orçamento continua produzindo `unknown`, nunca truncamento.\n\n### Non-goals\n- Não trocar a fórmula do digest de change set (versioná-la seria outra spec).\n- Não introduzir cache persistente de digests por commit.\n- Não mudar leituras de Git cujos bytes o produtor interpreta (nomes, logs, trailers): essas continuam retidas como hoje.\n\n---\n\n## 2. Requirements\n\n### Functional\n- R1: When a producer reads a Git object by immutable id only to hash its bytes, the governance read view shall stream the output into the producer's hash and retain only the observation's digest and length, never the bytes.\n- R2: The streamed reads of one operation shall be bounded by their own byte budget and by a per-read bound, separate from the retained captured-input budget; an overflow shall leave the producer unknown and shall never truncate.\n- R3: The change set of a spec shall have the same `diff_digest` and the same id as before this spec for every commit range, verified on the real pose-dist corpus before and after.\n- R4: A streamed observation requested again in the same operation shall be read again into the new consumer and shall make the producer changed when its digest or length differs from the first read.\n- R5: With streaming in place, the captured-input budget shall return to 512 MiB, by an ADR amendment that supersedes D10 with the measured retention of `pose index` on the pose-dist corpus.\n- R6: `pose index` of the pose-dist corpus shall publish within the restored budget, with the measured captured and streamed bytes recorded in the spec.\n\n### Non-functional\n- A memória retida por uma leitura em streaming é constante, independente do tamanho do diff.\n\n### Security\n- O streaming mantém a política de histórico bruto (sem replace refs, sem grafts) e o mesmo ambiente de Git das leituras capturadas.\n\n### Compatibility\n- Nenhum formato persistido muda; leitores antigos dos índices continuam válidos.\n\n---\n\n## 3. Technical Plan\n\n### Affected areas\n- Read view de governança: um modo de captura em streaming para leituras puras por objeto, com orçamento próprio e observação só de digest.\n- Change sets (`cli/artifact_integrity.go`): o `git show --binary` de cada commit passa a alimentar o hash por streaming.\n- ADR governance-reads-use-bounded-operation-scoped-views: emenda D11 que restaura 512 MiB e supersede D10.\n\n### Artifacts\n- modified: pose-mcp/internal/pose/governance_read_view.go\n- modified: pose-mcp/internal/pose/governance_read_view_git.go\n- modified: pose-mcp/internal/cli/artifact_integrity.go\n- modified: .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n- modified: POSE.md\n- modified: locales/pt-BR/POSE.md\n- modified: pose-mcp/internal/scaffold/dist/POSE.md\n- modified: pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n- created: pose-mcp/internal/pose/governance_read_view_stream.go\n- created: pose-mcp/internal/pose/governance_read_view_stream_test.go\n- created: pose-mcp/internal/cli/change_set_streamed_digest_test.go\n- modified: .pose/indexes/validation-matrix.json\n\n### Delivery targets\n\n- capability:read-view-streamed-object-digests module:pose-mcp profile:composed-capability entrypoint:pose-mcp/cmd/pose/main.go\n\nO alvo é composto em produção por `pose index`, que lê os change sets de todas as specs através do read view de governança. Check permanente `read-view-streamed-object-digests-integration`, evidenceClass `integration`, required, em moduleOverrides.pose-mcp: `go test ./internal/pose ./internal/cli -run Streamed -count=1`.\n\n### API/contract changes\n- Nova função de captura em streaming no pacote `pose`, usada só por produtores que hasheiam bytes de objetos imutáveis.\n\n### Data/storage changes\n- Nenhuma.\n\n### Technical risks\n- Uma segunda leitura do mesmo objeto na mesma operação relê o stream: custa I/O, não memória (R4).\n- O I/O de `pose index` continua proporcional ao histórico atribuído; este spec limita a memória retida, não o tempo. A duplicação entre a prova de fechamento das entradas e a construção do índice, medida no shim (cada commit lido duas vezes por `pose index`), é medida aqui e, se confirmada, vira follow-up.\n\n---\n\n## 4. Tasks\n\n### Planning\n- [x] Medir o estouro no corpus real (shim de Git: 4.903 `git show --binary`, 985 MB em duas operações).\n- [x] Confirmar quais leituras são puras por objeto e só hasheadas: o `git show --binary` de cada commit de um change set, que só alimenta o digest de diff.\n\n### Implementation\n- [x] Captura em streaming com orçamento próprio e observação só de digest (R1, R2, R4).\n- [x] Change sets por streaming, com digests idênticos (R3).\n- [x] Restaurar 512 MiB e emenda D11 (R5).\n\n### Validation\n- [x] Testes de fronteira de orçamento, troca de conteúdo e reutilização na mesma operação.\n- [x] Comparar `delivery-integrity.json` do pose-dist antes e depois (R3) e medir `pose index` (R6).\n\n---\n\n## 5. Decisions\n\n### Decision D2\n- Date: 2026-11-14\n- Context: a auditoria final refazia o stream de cada commit, o que triplicou o I/O medido (3,08 GB contra 985 MB).\n- Options considered: (a) refazer sempre o stream na auditoria; (b) tratar a leitura de patch de commit por id completo como pura e pulá-la na auditoria; (c) pular só enquanto a configuração efetiva do Git for a da captura.\n- Decision: (c).\n- Rationale: o objeto é imutável, mas a renderização do patch depende da configuração de diff do Git; (b) aceitaria uma mudança de configuração durante a operação sem vê-la, e (a) dobra o I/O sem ganho.\n- Consequences: a auditoria lê `git config --list` uma vez por raiz e refaz o stream só quando a configuração mudou.\n\n### Decision D1\n- Date: 2026-11-14\n- Context: o orçamento de entrada capturada é ultrapassado por leituras cujos bytes só alimentam um hash.\n- Options considered: (a) elevar o orçamento a cada estouro; (b) trocar o digest de change set por uma função dos ids de árvore; (c) cache persistente de digest por commit; (d) captura em streaming que retém só o digest.\n- Decision: (d).\n- Rationale: (a) é o paliativo D10 e não escala; (b) muda todos os IDs gravados e exige versionar o conteúdo derivado; (c) é o cache entre operações que a ADR exclui. (d) mantém os mesmos bytes no mesmo hash e torna a memória constante por leitura.\n- Consequences: o I/O continua proporcional ao histórico; a memória deixa de ser.\n\n---\n\n## 6. Validation\n\n### Strategy\nTestes de unidade do modo de streaming (fronteira exata do orçamento, estouro, troca de conteúdo, segunda leitura na mesma operação), e medição no corpus real: `pose index` do pose-dist com o orçamento restaurado e comparação de `delivery-integrity.json` antes e depois.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./internal/pose ./internal/cli ./internal/mcpserver -count=1`\n- Scope: pose-mcp\n- Expected: verde\n\n### Execution log\n- Date: 2026-11-14\n- Environment: Linux, Go 1.26, corpus do pose-dist em `main` (567 change sets, 2.451 commits atribuídos).\n- Notes: com um shim de Git no PATH, o motor anterior lia 4.903 `git show --binary` (985 MB) por `pose index` e estourava 512 MiB. Com streaming, `pose index` do pose-dist publica sob 512 MiB em 128 s (o motor anterior levou 132 s com 1 GiB). O `delivery-integrity.json` gerado pelo motor anterior e pelo novo é idêntico byte a byte (567 change sets, mesmos IDs e digests). O shim altera o ambiente do Git que o read view observa e por isso faz a geração acusar entradas alteradas; a medição de sucesso foi feita sem ele.\n\n### Results summary\n- Successes: os testes do modo de streaming e o de equivalência do digest; `pose index` sob 512 MiB; índices idênticos.\n- Failures: nenhuma.\n- Warnings: o I/O de `pose index` continua proporcional ao histórico atribuído (follow-up).\n\n### Requirement trace\n- R1 [satisfied] test:TestAStreamedObjectReadRetainsOnlyItsDigest check:read-view-streamed-object-digests-integration\n- R2 [satisfied] test:TestTheStreamedBudgetIsExactAndOverflowIsUnknown check:read-view-streamed-object-digests-integration\n- R3 [satisfied] test:TestAStreamedChangeSetKeepsItsDiffDigest check:read-view-streamed-object-digests-integration\n- R4 [satisfied] test:TestASecondStreamedReadIsReadAgainAndCompared test:TestTheStreamedAuditSkipsPureReadsOnlyWhileTheConfigurationStands\n- R5 [satisfied] test:TestGovernanceReadViewProbeAuditAndReplayShareInputByteCapacity check:read-view-streamed-object-digests-integration\n- R6 [satisfied] check:read-view-streamed-object-digests-integration\n\n### Known gaps\n- O tempo de `pose index` continua crescendo com o histórico atribuído; este spec limita a memória retida, não o I/O.\n\n---\n\n## 7. Final Report\n\n### Delivered scope\nLeituras puras de objetos Git cujos bytes só são hasheados passam pelo read view em streaming, retendo digest e tamanho, com orçamento próprio (8 GiB por operação e de novo na auditoria, 256 MiB por leitura). Os change sets usam esse modo, com digests e IDs idênticos. A auditoria pula a leitura pura enquanto a configuração do Git é a da captura. O orçamento de entrada retida voltou a 512 MiB (emenda D11, que supersede D10).\n\n### Files and modules changed\n- Read view de governança (`governance_read_view_stream.go`, `governance_read_view_git.go`, `governance_read_view.go`), change sets (`cli/artifact_integrity.go`), ADR de leituras de governança (D11), POSE.md e cópias, matriz de validação.\n\n### Validation executed\n- Command: `go test ./internal/pose ./internal/cli ./internal/mcpserver ./internal/scaffold -count=1`; `pose index` do pose-dist sob 512 MiB; comparação de `delivery-integrity.json`.\n- Result: verde; índice publicado; índices idênticos.\n\n### Residual risks\n- O I/O de `pose index` cresce com o histórico atribuído, e cada `pose index` lê o histórico duas vezes (a prova de fechamento das entradas e a construção).\n\n### Follow-ups\n\n- [open] F1: evitar que `pose index` leia o patch de cada commit atribuído duas vezes, uma na prova de fechamento das entradas e outra na construção, e medir se o I/O restante pede um registro imutável de digest por commit, versionado, em vez da releitura. (owner:@pose-maintainers crit:medium review:2026-12-13)\n# ADR: Governance reads use bounded operation-scoped views\n\n## Status\nAccepted\n\n## Context\n\nSpec `pose-governance-read-view-generation` (B34) finds a concrete gap in the\ncurrent obligation projection: `CurrentObligationSnapshot` runs before its\nproducers, and its digest binds revision, dirty boolean, policy, contract,\nauthority context and one index digest, but not the action journals, subjects,\nreview records and other bytes actually consumed by those producers. A tree\nthat is already dirty can change without changing the dirty bit. The projection\ndoes not validate those inputs after the producers finish.\n\nFour accepted contracts already cover parts of this problem:\n\n- B06 (`2026-10-17-a-source-that-lost-something-is-incomplete-for-what-depends-on-it`)\n  requires localized, per-source coverage when a read loses an input.\n- B07 (`2026-10-18-git-state-that-cannot-be-read-is-unknown-and-a-worktree-is-judged-by-its-content`)\n  requires unknown Git/worktree state to stay unknown and judges a worktree by\n  observed content, not only status flags.\n- B14 (`2026-10-16-writers-publish-through-one-exclusive-cas-publisher`)\n  provides per-artifact CAS and lifecycle locks, while explicitly excluding\n  transactions across files and the final check-to-rename race with a writer\n  that ignores POSE locks.\n- B15 (`2026-10-17-index-sets-are-published-as-verified-generations`) pins and\n  verifies one immutable index set per root, not a global snapshot across\n  independent roots.\n\n`reviewOperationView` already captures bounded spec metadata and review bundle\nheaders for one operation, serves reusable observations, and audits their\ninputs before a green result. It is intentionally not an atomic filesystem\nsnapshot, does not cover all producers, and is not a write authorization. The\nnew contract should extend that seam and the existing `Files` abstraction;\nanother parser, global hash, daemon, watcher-based proof or unbounded cache\nwould duplicate or overstate the existing guarantees.\n\n## Decision\n\nAdd an operation-scoped, read-only view over the\nexisting `Files` abstraction. Capture only the paths, directory listings,\nerrors and absences actually observed. `ReadFile` and `Open` must share the\ncaptured bytes; metadata and link resolution participate in the read set.\nServe immutable captured bytes to all producer clones and record attribution\nby an explicit producer/scope carried with each clone. Audit the observed\nclosure against the original `Files` at operation end. Use a bounded retry for\nread-only operations; discard the attempt before retrying. If the closure,\nbudget, producer attribution, parser/schema version or authorized root binding\ncannot be proved, preserve readable data where useful but return\n`incomplete`/`unknown`; never certify a truncated or mixed result.\n\nStart with `ProjectObligations`, which is the shared domain projection for CLI\n`state attention` and MCP `pose_obligations`. Pin indexes once per root and\npass that store/view through all producers. Then share the capture/audit\nprimitive with `WithReviewOperationView` and integrate review/closeout. Producers\nthat read through native `os` or accept only an uninstrumented `root` path must\nbe moved to `Files` or explicitly remain uncertified. Do not change the\nmeaning of existing sources or discard history to fit the budget.\n\nExpose an additive `read_view` object on the obligation report, with its own\n`schema_version: 1`, a digest of observed inputs and a vector of\nroot/project/worktree/ref/index bindings plus known engine/parser/schema\nversions. Keep `ObligationReport.schema_version` at 1, keep `Obligation` and\nhistorical bundles at their existing versions, and document the field in\n`POSE.md` and the MCP catalog. Do not expose absolute host paths. A legacy\nreport or historical record without a binding remains readable with a\nlimitation, but is `unknown` when a current gate requires proof. Existing\n`coherent`, `complete` and producer coverage remain distinct; freshness is\nevaluated at final validation, not promised beyond it.\n\nFor effectful operations, do not accept a read-view ID as authorization.\nAcquire an explicit cooperative write guard for each authorized root before\nrecomputing the complete evaluation and retain it through publication and the\nreceipt. Acquire roots in canonical order, then resource locks. Reuse the\nexisting per-root transfer lock and cross-platform advisory-lock primitives;\ncarry the lease explicitly through the operation's `Store`/`Files`, never a\nprocess-wide or goroutine-local reentrancy flag. Each participating publisher\nmust use the same guard protocol. A CAS on output B does not fence input A.\nMigrate and test direct journal and immutable-record writes as well as B14\npublishers before claiming that an effect is protected. The index guard must\ncover construction of outputs and capture of their input bindings, not only\nthe final descriptor publication. Independent roots keep separate guards and\ngenerations. Unavailable coordination is an explicit refusal, not permission\nto reuse an earlier authorization.\n\nRevalidate closure and authority at the actual effect point under the existing\nresource/lifecycle locks and B14 CAS or B15 descriptor commit where applicable.\nCover start/action-request/review seal, attestation and closeout paths. A\nconflict does not produce an effect. A `publish-unsynced` result continues to\nmean the write committed but durability is unconfirmed; do not report it as a\nplain failure without effect. Publish an index generation only after its B15\ndescriptor commit. Because B34 adds no cross-operation cache or persistent\nglobal generation, a write retires the prior operation view rather than\npublishing a new global generation.\n\nUse these recalibrated hard budgets: 25,000 observed records including retained\ndirectory entries, 512 MiB captured input bytes, 8 MiB retained metadata,\none retry of a complete read-only operation,\nat most 16 authorized federated roots and depth 8 with cycle detection. A\nbudget overflow produces `unknown`/`incomplete`, never truncation. Reconcile\nobserved paths even when no watcher is present or its events were lost; a\nwatcher is only a hint. Do not add a watcher, daemon/IPC, global cache, B31\nretention policy, B33 graph cache or B35 worktree runtime in this ADR.\n\nClarification recorded on 2026-11-05: the depth-8 budget bounds project\ncrossings along a dependency path, including authority-transfer redirects;\nit does not replace the existing total dependency-path limit of 64 edges.\nRetain the existing limits of 256 distinct graph identities and 256 input\ndependency entries per artifact. A shared DAG suffix is visited once, but its\nmaximum remaining path cost must be checked at each incoming prefix. Entries\nalready visited do not consume another distinct-node slot. Redirect chains\nalso retain their independent limit; they cannot conceal project crossings\nwhen composed with dependency edges. The operation still authorizes at most\n16 roots and retains the same byte, metadata, observation and retry budgets.\n\nThis corrects the scope of the existing bound rather than raising it. The\nnative spec catalog at implementation checkpoint `f54e9285` has 482 specs and\n553 local dependency edges, no cycles or foreign spec edges, a longest local\npath of 27 edges and at most 111 reachable spec identities. The index preflight\nrefused this legitimate corpus when depth 8 was applied to local edges. The\nmeasurement and its exclusions are recorded in the B34 budget report; actual\nindex publication and composed-bound fixtures still require current validation.\n\nCapacity recalibration D6, recorded on 2026-11-05, supersedes the initial\n10,000-record / 128-MiB values prospectively. A complete read-only compiler\ncalibration of the real builder and its final audit retained 18,905 combined\nrecords, 370,690,278 input bytes and 4,479,003 metadata bytes for seven outputs.\nThe capacity report records the production refusals, diagnostic overlays,\ncounter measurements and limits of that evidence. The chosen caps provide\nbounded headroom without changing input coverage, truncating history or\naltering other limits. Keep budget/unknown causes when a callback fails;\na missing closure must not be classified solely as an invalid policy path.\nCalibration does not qualify the normal build or authorize index publication.\n\nAn external writer that changes and restores bytes between audits without\nparticipating in a fencing protocol leaves no proof for hashes or `lstat` to\nobserve. A view may claim content equivalence at final validation, but cannot\nclaim that no transition occurred. Where a gate depends on that transition,\nrequire a participating writer proof/lock; otherwise return `unknown` and do\nnot execute the effect. This is not a transaction across the filesystem.\n\n## Alternatives rejected\n\n- **Hash the whole repository or `.pose` on every call:** hashes are not the\n  actual read closure, read unrelated history, and can miss an ABA transition.\n- **Reuse a report or cache as authorization:** a read-only observation does\n  not reserve inputs or authority for a later effect.\n- **Add a process-wide generation registry or watcher proof:** it cannot cover\n  restarts or external writers and belongs to separately governed runtime\n  work.\n- **Copy all source files into a snapshot:** unbounded eager history and new\n  filesystem semantics duplicate the operation view rather than extending it.\n\n## Consequences\n\nCLI and MCP can expose the same operation identity through their shared\nprojection. Consumers see an additive report schema version; old reports stay\nreadable but lack proof for current authorization. Operation memory and final\naudit work are bounded; overflow or uninstrumented reads can make a producer\nunknown. Validating observed files twice adds I/O, and one retry can rerun the\nread-only producers. Existing B14/B15 writers remain the source of truth for\neffects and index commits.\n\nThe engine does not promise an atomic filesystem snapshot, detect an external\nABA that leaves identical final bytes, or defend against writers that bypass\nPOSE fencing. Such inputs cannot authorize an effect whose contract requires\ntransition evidence. More producers become current only when their read paths,\ncoverage and writer boundaries are explicitly brought under the view.\n\n\n## Accepted amendment — 2026-11-06: bounded multi-scope coordination (D7)\n\nThe real global strict check exhausted the shared governance record/metadata\nbudget across independent historical closeout evaluations. Separate the global\ncoordinator from scope operations: capture policy, candidate enumeration and the\nbounded immutable catalogue under an explicitly bound coordinator; audit those\nselection inputs after all workers join, including disabled-policy and empty\ncandidate paths. Each scope, recursive children and exactly authorized federated\nroots use their own bounded capture and final audit. Bound worker concurrency\nand retain evaluated results, not every scope's captured closure.\n\nCatalogue reuse must expose an explicit binding-aware interface; do not bypass\nroot, project, resolver or Files identity checks by unwrapping a live view. Buffer\nfindings until the relevant scope and coordinator audits complete. A localized\nloss must remain unknown and make the global gate fail without exhausting an\nunrelated sibling. Preserve complete historical review and attestation reads,\nlater negative decisions, replacements, child validity and current trust checks.\n\nThis composes coherent global selection and individually audited scope results.\nIt does not certify one simultaneous filesystem snapshot across every scope.\nThe existing per-operation caps remain unchanged. Keep real domain errors with\nclosure audit errors; unavailable metadata and exhausted budgets are not proof\nof an escaping path or observed content mutation. Regression tests must exercise\nthe real global orchestration under injected small budgets and serial/parallel\nworkers, selection interleavings, localized exhaustion, retention negatives and\nexact binding checks. Native whole-corpus verification is still required.\n\n\n## Instance execution configuration boundary (D8) — 2026-11-06\n\nThe user-authorized native review uses a local delegation policy with concrete\nvendors, executables, access and executor issuer. Keep that live policy out of the\nembedded scaffold through the existing instance-policy exclusion mechanism.\nThe target instance uses its native delegation setup and its own configuration;\nno engine-local agent profile or issuer becomes a target default. This preserves\nthe same authority boundary as neutral review policy and changes no capability\nadoption, historical record or review verdict.\n\n\n## Bounded executable identity for the selected review agent (D9) — 2026-11-06\n\nThe installed native Claude Code 2.1.318 executable is 337,814,032 bytes. Its\nprovenance setup failed before the vendor ran because executable hashing reused\nthe 256 MiB transcript-retention bound. Hash executables as a stream bounded to\n512 MiB, separately from evidence retention. Keep regular-file and identity\nchecks, bounded reads and rejection above that limit. Keep transcript and B34\nread-view budgets unchanged. Do not substitute a launcher to evade the selected\nexecutable's identity proof. This accepts the measured distribution with bounded\nheadroom; larger future distributions still require an explicit reassessment.\n\n\n### Provider framing for the instance-owned review profile\n\nClaude's stream repeats session_id in init and result events. The instance\nprofile selects the unique system/init event so the existing ambiguity guard\nand private-session redaction remain intact. A restricted, noninteractive review\nuses Read/Grep/Glob/Bash without Edit/Write/Agent tools or plan approval mode.\nThis changes neither independence nor stream/output/run limits; the actual\nworking tree remains checked for mutation. No vendor profile becomes a scaffold\ndefault.\n\n\n## Capacity recalibration of captured input bytes (D10) — 2026-11-13\n\nClosing spec `pose-closeout-review-policy-by-cost-benefit`, `pose index` in a\nfresh clone and then in the maintainer checkout refused the pose-dist corpus:\n`index.delivery-integrity` exceeded the captured-input budget and\n`index.generate` was left without a complete observation. Measured with a Git\nshim on the real builder: the change sets of every spec read `git show\n--binary` for 2,451 distinct trailer commits, 492 MB of Git output in the\ncapture (the final audit reads it again under its own budget), plus the file\ninputs of the generation, so the operation needed more than 512 MiB. Nothing\nwas truncated; the refusal was correct. Raise the captured-input budget to\n1 GiB, for capture and audit alike, and keep every other limit, including the\n512 MiB executable-hash bound of D9. Observations retain their bytes, so the\noperation may now hold up to 1 GiB of captured input in memory. This\nrecalibration buys headroom, not a scaling property: the corpus grows with\nevery attributed commit. The structural fix, retaining only a digest for pure\nreads of immutable Git objects whose bytes a producer only hashes, is a\nfollow-up of that spec, and a further raise again requires a measured\nreassessment.\n\n## Streamed object reads restore the captured-input budget (D11) — 2026-11-14\n\nSpec `pose-read-view-streamed-object-digests` supersedes D10. A Git object\nread whose bytes a producer only hashes (the `git show --binary` of each\ncommit that feeds a change set's diff digest) is streamed into the producer:\nthe read view retains its digest and length, never its bytes, and charges a\nseparate streamed budget of 8 GiB per operation, and 8 GiB again for the\nfinal audit, with at most 256 MiB per read. The final audit does not stream a\npatch read of a commit named by its full id again while the root's effective\nGit configuration is the one it was read under. The same bytes enter the\nsame hash, so every diff digest and change-set id is unchanged: on the\npose-dist corpus the 567 change sets and the whole `delivery-integrity.json`\nwere identical before and after. The captured-input budget returns to\n512 MiB. Streaming bounds memory, not I/O: the bytes read still grow with\nthe attributed history.\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/internal/pose/governance_read_view_stream_test.go; cat pose-mcp/internal/cli/change_set_streamed_digest_test.go; sed -n '1,280p' pose-mcp/internal/pose/governance_read_view_git.go; cat .pose/rules/knowledge-governance.md; rg --files .pose/rules; rg -n 'stream|digest|read.view' .pose/knowledge | head -60\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/internal/pose/governance_read_view_stream_test.go; cat pose-mcp/internal/cli/change_set_streamed_digest_test.go; sed -n '1,280p' pose-mcp/internal/pose/governance_read_view_git.go; cat .pose/rules/knowledge-governance.md; rg --files .pose/rules; rg -n 'stream|digest|read.view' .pose/knowledge | head -60\"","aggregated_output":"package pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"testing\"\n)\n\n// Spec pose-read-view-streamed-object-digests.\n\nfunc streamTestRepo(t *testing.T) (string, string) {\n\tt.Helper()\n\troot := snapshotRepo(t, map[string]string{\".pose/project.json\": `{\"schema_version\":1,\"project_id\":\"proj.001\",\"name\":\"stream fixture\"}`, \"a.md\": \"one\\n\"})\n\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"one\\ntwo\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-am\", \"second\")\n\tout, err := exec.Command(\"git\", \"-C\", root, \"rev-parse\", \"HEAD\").Output()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn root, strings.TrimSpace(string(out))\n}\n\nfunc streamArgs(id string) []string {\n\treturn []string{\"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", id, \"--\"}\n}\n\n// R1: the sink gets the exact bytes, the view keeps only digest and length,\n// and the retained captured-input budget is untouched.\nfunc TestAStreamedObjectReadRetainsOnlyItsDigest(t *testing.T) {\n\troot, id := streamTestRepo(t)\n\twant, err := exec.Command(\"git\", append([]string{\"-C\", root}, streamArgs(id)...)...).Output()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\tstore := base.withGovernanceReadView(view, \"stream-test\")\n\tvar sink bytes.Buffer\n\tif err := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-test\", 1<<20, &sink, streamArgs(id)...); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !bytes.Equal(sink.Bytes(), want) {\n\t\tt.Fatalf(\"the sink did not get the exact output:\\n%q\\nwant\\n%q\", sink.Bytes(), want)\n\t}\n\tstate := view.operation.git\n\tfor key := range state.observations {\n\t\tif strings.Contains(key, `\"show\"`) {\n\t\t\tt.Fatalf(\"the streamed read was also retained as a captured observation: %q\", key)\n\t\t}\n\t}\n\tif len(state.streams) != 1 {\n\t\tt.Fatalf(\"streams=%d\", len(state.streams))\n\t}\n\tfor _, item := range state.streams {\n\t\tif item.length != int64(len(want)) || item.digest != digestBytes(want) || item.config == \"\" {\n\t\t\tt.Fatalf(\"streamed observation %+v\", item)\n\t\t}\n\t}\n\tview.operation.budgetMu.Lock()\n\tinput, streamed := view.operation.inputBytes, view.operation.streamedBytes\n\tview.operation.budgetMu.Unlock()\n\tif streamed != int64(len(want)) || input >= int64(len(want)) {\n\t\tt.Fatalf(\"streamed=%d input=%d for %d bytes\", streamed, input, len(want))\n\t}\n\tif audit := view.audit(); audit.ChangedProducers[\"stream-test\"] || len(audit.UnknownProducers[\"stream-test\"]) != 0 {\n\t\tt.Fatalf(\"an unchanged streamed read did not pass the audit: %+v\", audit)\n\t}\n}\n\n// R2: the streamed budget is exact at its boundary and an overflow is\n// unknown, never truncated.\nfunc TestTheStreamedBudgetIsExactAndOverflowIsUnknown(t *testing.T) {\n\troot, id := streamTestRepo(t)\n\twant, _ := exec.Command(\"git\", append([]string{\"-C\", root}, streamArgs(id)...)...).Output()\n\tfor _, overflow := range []bool{false, true} {\n\t\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\t\tstore := base.withGovernanceReadView(view, \"stream-budget\")\n\t\tprior := int64(governanceReadViewMaxStreamedBytes - len(want))\n\t\tif overflow {\n\t\t\tprior++\n\t\t}\n\t\tview.operation.budgetMu.Lock()\n\t\tview.operation.streamedBytes = prior\n\t\tview.operation.budgetMu.Unlock()\n\t\tvar sink bytes.Buffer\n\t\terr := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-budget\", 1<<20, &sink, streamArgs(id)...)\n\t\tif overflow != errors.Is(err, errGovernanceReadViewBudget) {\n\t\t\tt.Fatalf(\"overflow=%v err=%v\", overflow, err)\n\t\t}\n\t\tmetadata, _ := view.metadata(store.FederatedProjectID, \"\", \"\", view.audit())\n\t\tif overflow != strings.Contains(strings.Join(metadata.Limitations, \"\\n\"), \"streamed byte budget\") {\n\t\t\tt.Fatalf(\"overflow=%v limitations=%v\", overflow, metadata.Limitations)\n\t\t}\n\t}\n\tif err := StreamGovernanceRawHistoryGitIn(nil, context.Background(), root, \"p\", governanceReadViewMaxStreamedRead+1, io.Discard, streamArgs(id)...); err == nil {\n\t\tt.Fatal(\"a per-read limit above the bound was accepted\")\n\t}\n}\n\n// R4: the same read again in the operation is streamed again to its new\n// consumer, and a different result leaves the producer unknown.\nfunc TestASecondStreamedReadIsReadAgainAndCompared(t *testing.T) {\n\troot, id := streamTestRepo(t)\n\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\tstore := base.withGovernanceReadView(view, \"stream-again\")\n\tvar first, second bytes.Buffer\n\tif err := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-again\", 1<<20, &first, streamArgs(id)...); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-again\", 1<<20, &second, streamArgs(id)...); err != nil || !bytes.Equal(first.Bytes(), second.Bytes()) {\n\t\tt.Fatalf(\"the second consumer did not get the bytes: %v\", err)\n\t}\n\toriginal := governanceStreamRun\n\tgovernanceStreamRun = func(ctx context.Context, files Files, r string, args []string, limit int64, admit func(int64) bool, sink io.Writer) (string, int64, []byte, error) {\n\t\treturn original(ctx, files, r, args, limit, admit, &prefixed{sink: sink})\n\t}\n\tdefer func() { governanceStreamRun = original }()\n\tchanged := &bytes.Buffer{}\n\ttampered := func(ctx context.Context, files Files, r string, args []string, limit int64, admit func(int64) bool, sink io.Writer) (string, int64, []byte, error) {\n\t\t_, _ = sink.Write([]byte(\"other\"))\n\t\treturn digestBytes([]byte(\"other\")), 5, nil, nil\n\t}\n\tgovernanceStreamRun = tampered\n\tif err := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-again\", 1<<20, changed, streamArgs(id)...); err == nil {\n\t\tt.Fatal(\"a streamed read that differed within the operation was accepted\")\n\t}\n\tmetadata, _ := view.metadata(store.FederatedProjectID, \"\", \"\", view.audit())\n\tif !strings.Contains(strings.Join(metadata.Limitations, \"\\n\"), \"differed within the operation\") {\n\t\tt.Fatalf(\"limitations=%v\", metadata.Limitations)\n\t}\n}\n\ntype prefixed struct{ sink io.Writer }\n\nfunc (p *prefixed) Write(data []byte) (int, error) { return p.sink.Write(data) }\n\n// The final audit does not stream a pure object read again while the Git\n// configuration stands, streams it when the configuration changed, and\n// streams every other read and reports a change.\nfunc TestTheStreamedAuditSkipsPureReadsOnlyWhileTheConfigurationStands(t *testing.T) {\n\troot, id := streamTestRepo(t)\n\tvar reruns atomic.Int64\n\toriginal := governanceAuditGitStream\n\tgovernanceAuditGitStream = func(ctx context.Context, files Files, r string, args []string, limit int64, admit func(int64) bool, sink io.Writer) (string, int64, []byte, error) {\n\t\treruns.Add(1)\n\t\treturn original(ctx, files, r, args, limit, admit, sink)\n\t}\n\tdefer func() { governanceAuditGitStream = original }()\n\tread := func(args ...string) *governanceReadView {\n\t\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\t\tstore := base.withGovernanceReadView(view, \"stream-audit\")\n\t\tif err := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-audit\", 1<<20, io.Discard, args...); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\treturn view\n\t}\n\tview := read(streamArgs(id)...)\n\tif audit := view.audit(); reruns.Load() != 0 || audit.ChangedProducers[\"stream-audit\"] {\n\t\tt.Fatalf(\"a pure read was streamed again under the same configuration: reruns=%d %+v\", reruns.Load(), audit)\n\t}\n\tview = read(streamArgs(id)...)\n\tsnapshotTestGit(t, root, \"config\", \"diff.noprefix\", \"true\")\n\tif audit := view.audit(); reruns.Load() != 1 || !audit.ChangedProducers[\"stream-audit\"] {\n\t\tt.Fatalf(\"a configuration change did not stream the read again and find the change: reruns=%d %+v\", reruns.Load(), audit)\n\t}\n\tsnapshotTestGit(t, root, \"config\", \"--unset\", \"diff.noprefix\")\n\tview = read(\"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", \"HEAD\", \"--\")\n\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"three\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-am\", \"third\")\n\tif audit := view.audit(); reruns.Load() != 2 || !audit.ChangedProducers[\"stream-audit\"] {\n\t\tt.Fatalf(\"a head-relative streamed read was not audited: reruns=%d %+v\", reruns.Load(), audit)\n\t}\n}\npackage cli\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"os/exec\"\n\t\"testing\"\n)\n\n// Spec pose-read-view-streamed-object-digests R3: streaming each commit's\n// patch into the digest keeps the digest the retained capture computed, the\n// SHA-256 of the concatenated `git show --binary` of the commits in order.\nfunc TestAStreamedChangeSetKeepsItsDiffDigest(t *testing.T) {\n\trepo := newRemovalRepo(t)\n\trepo.write(\"a.txt\", \"one\\n\")\n\tfirst := repo.commit(\"first\\n\\nPOSE-Spec: alpha\")\n\trepo.write(\"a.txt\", \"two\\n\")\n\trepo.write(\"b.bin\", \"\\x00\\x01\\x02binary\\xff\\n\")\n\tsecond := repo.commit(\"second\\n\\nPOSE-Spec: alpha\")\n\tset, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdigest := sha256.New()\n\tfor _, sha := range []string{first, second} {\n\t\tout, err := exec.Command(\"git\", \"--no-replace-objects\", \"-C\", repo.root, \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", sha, \"--\").Output()\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tdigest.Write(out)\n\t}\n\tif want := \"sha256:\" + hex.EncodeToString(digest.Sum(nil)); set.DiffDigest != want {\n\t\tt.Fatalf(\"streamed diff digest %s, the retained capture's %s\", set.DiffDigest, want)\n\t}\n}\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n)\n\nconst governanceReadViewGitParserVersion = \"pose-governance-git-inputs-v1\"\n\ntype governanceReadViewGitObservation struct {\n\troot           string\n\targs           []string\n\tfiles          Files\n\tctx            context.Context\n\tdeadline       time.Time\n\thasDeadline    bool\n\tmaxOutputBytes int64\n\tstdout         []byte\n\tstderr         []byte\n\terr            error\n\terrText        string\n\tproducers      map[string]bool\n\t// pure is set when the output cannot change while the commit it was read at stands: it is a\n\t// function of object ids, or of headAt, the commit HEAD named before and after the command.\n\t// The final audit then reruns it only if HEAD moved.\n\tpure   bool\n\theadAt string\n}\n\n// governanceReadViewGitState captures exact, bounded Git command results for\n// one read-view operation. Repeated commands replay the first result; audit\n// reruns each exact command and reports any changed or unprovable result.\ntype governanceReadViewGitState struct {\n\top            *governanceReadViewOperation\n\tmu            sync.Mutex\n\tobservations  map[string]*governanceReadViewGitObservation\n\tstreams       map[string]*governanceReadViewStreamObservation\n\tconfigMu      sync.Mutex\n\tconfigDigests map[string]string\n}\n\n// effectiveGitConfig is the digest of `git config --list` of a root (every scope, includes\n// followed), read once per operation and kept apart from the command observations: it is a key\n// of the resident memo, not an input the audit replays. Empty when it could not be read.\nfunc (state *governanceReadViewGitState) effectiveGitConfig(ctx context.Context, files Files, root string) string {\n\tstate.configMu.Lock()\n\tdefer state.configMu.Unlock()\n\tif digest, ok := state.configDigests[root]; ok {\n\t\treturn digest\n\t}\n\tdigest := \"\"\n\tif out, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, []string{\"config\", \"--list\", \"-z\", \"--includes\"}, 1<<20); err == nil {\n\t\tsum := sha256.Sum256(out)\n\t\tdigest = hex.EncodeToString(sum[:8])\n\t}\n\tstate.configDigests[root] = digest\n\treturn digest\n}\n\nfunc newGovernanceReadViewGitState(op *governanceReadViewOperation) *governanceReadViewGitState {\n\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}, configDigests: map[string]string{}}\n}\n\n// captureGovernanceGit runs a Git command through the read-view generation\n// when Files belongs to one. Native and preview operations retain their\n// existing behavior when there is no governance view.\nfunc captureGovernanceGit(files Files, root, producer string, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n}\n\n// CaptureGovernanceGitIn executes one bounded raw-history Git command through\n// the operation's captured read view when Files carries one. maxOutputBytes\n// bounds combined stdout and stderr before bytes are retained. Git commands\n// use gitCommand, which disables replacement refs and grafts.\nfunc CaptureGovernanceGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBounded(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitIn names the history semantics explicitly for\n// callers whose result depends on raw commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitIn(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceGitContextIn is CaptureGovernanceGitIn under ctx. The same\n// context is retained for the final audit rerun.\nfunc CaptureGovernanceGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitContextIn names raw history semantics for\n// context-bound callers that inspect commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitContextIn(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceGitBounded(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBoundedContext(files, context.Background(), root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceGitBoundedContext(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tfiles = FilesOrNative(files)\n\tview, viewFiles := governanceReadViewFromFiles(files)\n\tif view == nil {\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif view.operation == nil {\n\t\tview.markUnknown(producer, \"Git input has no operation-scoped generation vector\")\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif viewFiles != nil {\n\t\tproject := viewFiles.project\n\t\tif target := view.route(root, producer, project); target == nil {\n\t\t\tview.markUnknown(producer, \"Git input is outside the authorized root generation vector\")\n\t\t\treturn nil, errGovernanceReadViewOutsideRoot\n\t\t} else {\n\t\t\tview = target\n\t\t}\n\t}\n\treturn view.operation.captureFilesBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceSourceRevision(files Files, root, producer string) (string, error) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\traw, err := captureGovernanceGit(files, root, producer, \"rev-parse\", \"--verify\", \"HEAD\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\trevision := strings.TrimSpace(string(raw))\n\tif revision == \"\" {\n\t\tif view, _ := governanceReadViewFromFiles(files); view != nil {\n\t\t\tview.markUnknown(producer, \"source revision binding is unavailable\")\n\t\t}\n\t\treturn \"\", fmt.Errorf(\"pose: Git returned no source revision\")\n\t}\n\treturn revision, nil\n}\n\nfunc readGitStatusGovernedIn(files Files, root, producer string, pathspecs ...string) ([]GitStatusEntry, error) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\targs := []string{\"status\", \"--porcelain=v1\", \"-z\", \"--untracked-files=all\", \"--ignore-submodules=none\"}\n\tif len(pathspecs) > 0 {\n\t\targs = append(args, \"--\")\n\t\targs = append(args, pathspecs...)\n\t}\n\tout, err := captureGovernanceGit(files, root, producer, args...)\n\tif err != nil {\n\t\tif hasGitMetadataIn(FilesOrNative(files), root) {\n\t\t\tmarkGovernanceReadUnknownForProject(files, root, \"\", producer, \"Git status could not be read in this repository\")\n\t\t} else {\n\t\t\treturn nil, fmt.Errorf(\"%w: %v\", ErrGitUnavailable, err)\n\t\t}\n\t\treturn nil, err\n\t}\n\tentries, err := parseGitStatusEntries(out)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif preview := FilesOrNative(files).Preview(); preview != nil {\n\t\treturn projectGitStatus(preview, root, entries, pathspecs)\n\t}\n\treturn entries, nil\n}\n\nfunc gitChangedPathsGovernedIn(files Files, root, producer string) ([]string, error) {\n\tentries, err := readGitStatusGovernedIn(files, root, producer)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tpaths := make([]string, 0, len(entries)*2)\n\tfor _, entry := range entries {\n\t\tif untrackedAuthorityTransferLock(entry) {\n\t\t\tcontinue\n\t\t}\n\t\tpaths = append(paths, entry.Path)\n\t\tif entry.OrigPath != \"\" {\n\t\t\tpaths = append(paths, entry.OrigPath)\n\t\t}\n\t}\n\tsort.Strings(paths)\n\treturn paths, nil\n}\n\nfunc commitChangedPathsGovernedIn(files Files, root, producer, commit string) (map[string]bool, bool) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\t// Each governed read is captured and audited, so it is not served from a cache:\n\t// the read is bounded instead, in output bytes and in paths (spec\n\t// pose-bounded-isolated-graph-caches R4).\n\traw, err := captureGovernanceGitBounded(files, root, producer, commitPathsMaxOutput, \"diff-tree\", \"--root\", \"--no-commit-id\", \"--name-only\", \"--no-renames\", \"-r\", \"-z\", commit)\n\tvar paths map[string]bool\n\tif err == nil {\n\t\tpaths, err = parseCommitPaths(raw)\n\t}\n\tif err != nil {\n\t\tif hasGitMetadataIn(FilesOrNative(files), root) {\n\t\t\tmarkGovernanceReadUnknownForProject(files, root, \"\", producer, \"commit path inventory could not be read from Git\")\n\t\t}\n\t\treturn nil, false\n\t}\n\treturn paths, true\n}\n\nfunc dispatchWorktreeIdentityGoverned(files Files, root, producer string) (string, error) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\ttop, err := captureGovernanceGit(files, root, producer, \"rev-parse\", \"--show-toplevel\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tabs, err := filepath.Abs(root)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tabs, err = FilesOrNative(files).EvalSymlinks(abs)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\ttopPath, err := FilesOrNative(files).EvalSymlinks(strings.TrimSpace(string(top)))\n\tif err != nil || filepath.Clean(abs) != filepath.Clean(topPath) {\n\t\treturn \"\", fmt.Errorf(\"dispatch origin conflict: Git selected a different worktree\")\n\t}\n\tgitDir, err := captureGovernanceGit(files, root, producer, \"rev-parse\", \"--absolute-git-dir\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn string(top) + \"\\x00\" + string(gitDir), nil\n}\n\nfunc governanceReadViewFromFiles(files Files) (*governanceReadView, *governanceReadViewFiles) {\n\tfor depth := 0; depth < maxGovernanceFilesWrappers; depth++ {\n\t\tfiles = FilesOrNative(files)\n\t\tif viewFiles, ok := files.(*governanceReadViewFiles); ok {\n\t\t\treturn viewFiles.view, viewFiles\n\t\t}\n\t\tif provider, ok := files.(interface{ GovernanceReadView() *governanceReadView }); ok {\n\t\t\tif view := provider.GovernanceReadView(); view != nil {\n\t\t\t\treturn view, nil\n\t\t\t}\n\t\t}\n\t\tunderlying, ok := files.(interface{ UnderlyingFiles() Files })\n\t\tif !ok {\n\t\t\treturn nil, nil\n\t\t}\n\t\tfiles = underlying.UnderlyingFiles()\n\t}\n\treturn nil, nil\n}\n\n// capture is also used while an authorized child root is being opened, before\n// a producer Files wrapper for that root exists. Root membership is checked\n// against the operation's already-bound roots.\nfunc (op *governanceReadViewOperation) capture(root, producer string, args ...string) ([]byte, error) {\n\treturn op.captureFiles(NativeFiles(), root, producer, args...)\n}\n\nfunc (op *governanceReadViewOperation) captureFiles(files Files, root, producer string, args ...string) ([]byte, error) {\n\treturn op.captureFilesBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n}\n\nfunc (op *governanceReadViewOperation) captureFilesBounded(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn op.captureFilesBoundedContext(files, context.Background(), root, producer, maxOutputBytes, args...)\n}\n\nfunc (op *governanceReadViewOperation) captureFilesBoundedContext(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n# Rule: Knowledge Governance\n\n## When to consult\n\nConsult this guide when creating, updating, reviewing, or removing artifacts under `.pose/knowledge/`.\n\n## TTL and retention\n\n- Set `expires_at` on every artifact when it is created.\n- Use a default TTL of 30 days for notes, decision logs, and handoffs.\n- Use a TTL of up to 90 days only with a justification recorded in the artifact body.\n- Treat an artifact without `expires_at` as non-compliant and block its creation or merge.\n\n## When this is not the right home\n\n- Use `.pose/knowledge/` only for time-bound operational memory: content\n  tied to a decision moment, a handoff between executions, or something\n  meant to be reviewed and eventually expire.\n- A durable fact or convention that will not become false and carries no\n  review trigger — a third-party tool's parsing quirk, a naming\n  convention, a recurring gotcha — is not a `decision-log` just because no\n  better type exists. Route it to `.pose/rules/` instead: add it to an\n  existing rule file or create one, then wire it into the relevant task\n  type's base `rules` array in `.pose/indexes/task-map.json` so\n  `pose suggest <task>` surfaces it automatically. No path scoping is\n  required — a task type's base `rules` list is returned regardless of\n  `--path`; only language/component-specific rules need the\n  `rules_by_domain` layer.\n- Rule of thumb: if nothing was decided or traded off, and nothing about\n  the fact will change on a predictable timeline, it is not a\n  `decision-log` and not an ADR — it is a rule. See ADR\n  `2026-08-15-durable-non-architectural-knowledge-belongs-in-rules-not-a-new-type`.\n\n## Reusable cross-execution format\n\n- Structure reusable context as a handoff with fixed sections: Context, Current state, Next checks, Risks, and Next owner.\n- Keep `source_refs` linked to the relevant spec, workflow, and executed check commands.\n- Record `last_reviewed_at` in the body to make effective cross-execution updates traceable.\n\n## Archiving and purging\n\n- Run biweekly triage to list expired artifacts.\n- Move expired artifacts to `.pose/knowledge/archive/` when they retain audit value.\n- Purge archived artifacts 180 days after expiration unless documented legal or compliance requirements apply.\n- Record every archive and purge action in the housekeeping log.\n\n## Sensitive content\n\n- Prohibit secrets, tokens, credentials, private keys, and equivalent material.\n- Prohibit personal data and non-anonymized customer data.\n- Do not copy restricted incidents or reports in full; keep only a controlled reference.\n- Classify frontmatter `sensitivity` as `public-internal` or `restricted`.\n- Remove identified sensitive content immediately and open a security follow-up.\n\n## Ownership and review\n\n- Keep `@pose-maintainers` as the primary governance owner.\n- Require an owner in every artifact frontmatter.\n- Review expiration biweekly and quality monthly.\n- Escalate a backlog overdue by more than two cycles to the primary owner.\n- Block backlog growth when `list-expired` exceeds the operational limit: zero in strict mode, two in tolerant mode.\n\n## Minimum operational checks\n\n- Run `pose knowledge-check --strict` biweekly to validate the expired backlog.\n- Run `pose knowledge-housekeeping list-expired` for detailed triage.\n- Run `pose knowledge-housekeeping archive-expired --dry-run` before applying changes.\n- Execute destructive actions only with an explicit `--apply` flag.\n.pose/rules/knowledge-governance.md\n.pose/rules/frontend-react.md\n.pose/rules/delivery-surface.md\n.pose/rules/release-integrity.md\n.pose/rules/documentation-style.md\n.pose/rules/backend-go.md\n.pose/rules/delivery-evidence.md\n.pose/rules/security.md\n.pose/rules/_base-recurrence.md\n.pose/knowledge/2026-10-27-handoff-delegation-mcp-round5.md:41:@oseiaspereira88 owns F02 and F03, both low; review 2026-11-26. The institutional handoff owner is @pose-maintainers. No upstream contribution draft, issue or PR was created.\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:25:imutável digest-pinned, aprovação exige Execution Identity, `HarnessExecutor`\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:152:(orquestração idempotente digest-pinned de `pose-safe-validate-orchestration`,\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:36:this repository's live self-referential values into every downstream install.\n.pose/knowledge/2026-10-14-decision-log-adr-release-temporal-evidence-review.md:44:Stored digests and declared verified can conceal changed assets. Current policy\n.pose/knowledge/archive/2026-08-13-handoff-pr15-component-aware-review-provenance.md:38:  is recorded. Delivery evidence is bound to provenance digest\n.pose/knowledge/2026-10-18-handoff-pose-b06-source-coverage-closeout.md:43:B13 e read views B34 permanecem nos respectivos escopos.\n.pose/knowledge/2026-10-26-handoff-delegation-routing-round3.md:39:@oseiaspereira88 owns F08 and F09, both low, review 2026-11-25. Keep them as open follow-ups in the spec and link their dispositions to the native review judgments. No upstream contribution draft or issue was created.\n.pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md:26:recomputed the global provenance digest (`graph.ProvenanceDigest`, computed\n.pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md:45:provenance digest so it only invalidates reviews whose scope actually\n.pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md:47:\"unrelated,\" whether a narrower digest weakens the guarantee it exists to\n.pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md:54:  provenance digest, `pose-mcp/internal/pose/delivery_integrity.go`\n.pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md:75:@pose-maintainers — no active handoff; revisit only if the digest-scoping\n.pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md:83:  documented that the provenance digest is global-over-the-graph, not\n.pose/knowledge/2026-08-13-decision-log-adr-sealed-review-bundles-review.md:20:The current full-body review scope digest lets closeout bookkeeping alter the\n.pose/knowledge/2026-08-13-decision-log-adr-sealed-review-bundles-review.md:41:- Verify synthetic merge/squash subjects by patch and tree/content digests.\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:10:  spec: \"spec:pose-governance-read-view-generation\"\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:14:    - \"pose lint-spec pose-governance-read-view-generation --strict\"\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:41:`work/governance-read-view-recovery`, base publicada `7079eb86`.\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:118:- [Spec B34](../specs/2026-10-13-pose-governance-read-view-generation.md)\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:120:- [Start atual](../starts/pose-governance-read-view-generation.json)\n.pose/knowledge/2026-10-28-handoff-delegated-conclusions-round4.md:44:Spec: .pose/specs/2026-10-27-pose-delegated-review-conclusions.md. Review report and independent probes: .review-work/round4/report.md. The spec Final Report records the sealed bundle and attestation after closeout. No upstream contribution draft, issue or PR was created.\n.pose/knowledge/2026-10-26-handoff-delegation-observation-round4.md:27:- F01 (low, disclosed under D7): the live view redacts with what the stream has declared so far, and the record is derived again from the whole transcript; a capture the record later withholds can still have been shown live.\n.pose/knowledge/2026-10-26-handoff-delegation-observation-round4.md:48:@oseiaspereira88, review 2026-11-25. No upstream contribution draft or issue was created.\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:200:output captured rather than streamed:\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:234:and a pointer to the full result file), leaving `--verbose` to stream\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:369:   streaming it is the biggest visible change, and it changes what reports\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:370:   capture as evidence. Keep streaming, capture-and-summarise, or make it a\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:415:- `pose-mcp/internal/cli/validate.go` — the streaming loop and the missing\n.pose/knowledge/2026-11-02-handoff-roadmap-v7-independent-outcomes-20261102.md:38:@pose-maintainers. Retain f1/f2 until the next review; do not stage upstream contribution feedback without user consent.\n.pose/knowledge/2026-08-13-decision-log-adr-component-aware-review-plans-review.md:23:new plan digest, so the design needs an explicit future-review trigger.\n.pose/knowledge/2026-08-13-decision-log-adr-component-aware-review-plans-review.md:43:inputs in the digest and reject conflicts instead of selecting heuristically.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/governance_read_view_stream_test.go; cat pose-mcp/internal/cli/change_set_streamed_digest_test.go; cat .pose/rules/backend-go.md; git diff d724738b..95ee4223 -- POSE.md .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md .pose/indexes/validation-matrix.json'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/governance_read_view_stream_test.go; cat pose-mcp/internal/cli/change_set_streamed_digest_test.go; cat .pose/rules/backend-go.md; git diff d724738b..95ee4223 -- POSE.md .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md .pose/indexes/validation-matrix.json'","aggregated_output":"package pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"testing\"\n)\n\n// Spec pose-read-view-streamed-object-digests.\n\nfunc streamTestRepo(t *testing.T) (string, string) {\n\tt.Helper()\n\troot := snapshotRepo(t, map[string]string{\".pose/project.json\": `{\"schema_version\":1,\"project_id\":\"proj.001\",\"name\":\"stream fixture\"}`, \"a.md\": \"one\\n\"})\n\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"one\\ntwo\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-am\", \"second\")\n\tout, err := exec.Command(\"git\", \"-C\", root, \"rev-parse\", \"HEAD\").Output()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn root, strings.TrimSpace(string(out))\n}\n\nfunc streamArgs(id string) []string {\n\treturn []string{\"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", id, \"--\"}\n}\n\n// R1: the sink gets the exact bytes, the view keeps only digest and length,\n// and the retained captured-input budget is untouched.\nfunc TestAStreamedObjectReadRetainsOnlyItsDigest(t *testing.T) {\n\troot, id := streamTestRepo(t)\n\twant, err := exec.Command(\"git\", append([]string{\"-C\", root}, streamArgs(id)...)...).Output()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\tstore := base.withGovernanceReadView(view, \"stream-test\")\n\tvar sink bytes.Buffer\n\tif err := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-test\", 1<<20, &sink, streamArgs(id)...); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !bytes.Equal(sink.Bytes(), want) {\n\t\tt.Fatalf(\"the sink did not get the exact output:\\n%q\\nwant\\n%q\", sink.Bytes(), want)\n\t}\n\tstate := view.operation.git\n\tfor key := range state.observations {\n\t\tif strings.Contains(key, `\"show\"`) {\n\t\t\tt.Fatalf(\"the streamed read was also retained as a captured observation: %q\", key)\n\t\t}\n\t}\n\tif len(state.streams) != 1 {\n\t\tt.Fatalf(\"streams=%d\", len(state.streams))\n\t}\n\tfor _, item := range state.streams {\n\t\tif item.length != int64(len(want)) || item.digest != digestBytes(want) || item.config == \"\" {\n\t\t\tt.Fatalf(\"streamed observation %+v\", item)\n\t\t}\n\t}\n\tview.operation.budgetMu.Lock()\n\tinput, streamed := view.operation.inputBytes, view.operation.streamedBytes\n\tview.operation.budgetMu.Unlock()\n\tif streamed != int64(len(want)) || input >= int64(len(want)) {\n\t\tt.Fatalf(\"streamed=%d input=%d for %d bytes\", streamed, input, len(want))\n\t}\n\tif audit := view.audit(); audit.ChangedProducers[\"stream-test\"] || len(audit.UnknownProducers[\"stream-test\"]) != 0 {\n\t\tt.Fatalf(\"an unchanged streamed read did not pass the audit: %+v\", audit)\n\t}\n}\n\n// R2: the streamed budget is exact at its boundary and an overflow is\n// unknown, never truncated.\nfunc TestTheStreamedBudgetIsExactAndOverflowIsUnknown(t *testing.T) {\n\troot, id := streamTestRepo(t)\n\twant, _ := exec.Command(\"git\", append([]string{\"-C\", root}, streamArgs(id)...)...).Output()\n\tfor _, overflow := range []bool{false, true} {\n\t\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\t\tstore := base.withGovernanceReadView(view, \"stream-budget\")\n\t\tprior := int64(governanceReadViewMaxStreamedBytes - len(want))\n\t\tif overflow {\n\t\t\tprior++\n\t\t}\n\t\tview.operation.budgetMu.Lock()\n\t\tview.operation.streamedBytes = prior\n\t\tview.operation.budgetMu.Unlock()\n\t\tvar sink bytes.Buffer\n\t\terr := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-budget\", 1<<20, &sink, streamArgs(id)...)\n\t\tif overflow != errors.Is(err, errGovernanceReadViewBudget) {\n\t\t\tt.Fatalf(\"overflow=%v err=%v\", overflow, err)\n\t\t}\n\t\tmetadata, _ := view.metadata(store.FederatedProjectID, \"\", \"\", view.audit())\n\t\tif overflow != strings.Contains(strings.Join(metadata.Limitations, \"\\n\"), \"streamed byte budget\") {\n\t\t\tt.Fatalf(\"overflow=%v limitations=%v\", overflow, metadata.Limitations)\n\t\t}\n\t}\n\tif err := StreamGovernanceRawHistoryGitIn(nil, context.Background(), root, \"p\", governanceReadViewMaxStreamedRead+1, io.Discard, streamArgs(id)...); err == nil {\n\t\tt.Fatal(\"a per-read limit above the bound was accepted\")\n\t}\n}\n\n// R4: the same read again in the operation is streamed again to its new\n// consumer, and a different result leaves the producer unknown.\nfunc TestASecondStreamedReadIsReadAgainAndCompared(t *testing.T) {\n\troot, id := streamTestRepo(t)\n\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\tstore := base.withGovernanceReadView(view, \"stream-again\")\n\tvar first, second bytes.Buffer\n\tif err := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-again\", 1<<20, &first, streamArgs(id)...); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-again\", 1<<20, &second, streamArgs(id)...); err != nil || !bytes.Equal(first.Bytes(), second.Bytes()) {\n\t\tt.Fatalf(\"the second consumer did not get the bytes: %v\", err)\n\t}\n\toriginal := governanceStreamRun\n\tgovernanceStreamRun = func(ctx context.Context, files Files, r string, args []string, limit int64, admit func(int64) bool, sink io.Writer) (string, int64, []byte, error) {\n\t\treturn original(ctx, files, r, args, limit, admit, &prefixed{sink: sink})\n\t}\n\tdefer func() { governanceStreamRun = original }()\n\tchanged := &bytes.Buffer{}\n\ttampered := func(ctx context.Context, files Files, r string, args []string, limit int64, admit func(int64) bool, sink io.Writer) (string, int64, []byte, error) {\n\t\t_, _ = sink.Write([]byte(\"other\"))\n\t\treturn digestBytes([]byte(\"other\")), 5, nil, nil\n\t}\n\tgovernanceStreamRun = tampered\n\tif err := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-again\", 1<<20, changed, streamArgs(id)...); err == nil {\n\t\tt.Fatal(\"a streamed read that differed within the operation was accepted\")\n\t}\n\tmetadata, _ := view.metadata(store.FederatedProjectID, \"\", \"\", view.audit())\n\tif !strings.Contains(strings.Join(metadata.Limitations, \"\\n\"), \"differed within the operation\") {\n\t\tt.Fatalf(\"limitations=%v\", metadata.Limitations)\n\t}\n}\n\ntype prefixed struct{ sink io.Writer }\n\nfunc (p *prefixed) Write(data []byte) (int, error) { return p.sink.Write(data) }\n\n// The final audit does not stream a pure object read again while the Git\n// configuration stands, streams it when the configuration changed, and\n// streams every other read and reports a change.\nfunc TestTheStreamedAuditSkipsPureReadsOnlyWhileTheConfigurationStands(t *testing.T) {\n\troot, id := streamTestRepo(t)\n\tvar reruns atomic.Int64\n\toriginal := governanceAuditGitStream\n\tgovernanceAuditGitStream = func(ctx context.Context, files Files, r string, args []string, limit int64, admit func(int64) bool, sink io.Writer) (string, int64, []byte, error) {\n\t\treruns.Add(1)\n\t\treturn original(ctx, files, r, args, limit, admit, sink)\n\t}\n\tdefer func() { governanceAuditGitStream = original }()\n\tread := func(args ...string) *governanceReadView {\n\t\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\t\tstore := base.withGovernanceReadView(view, \"stream-audit\")\n\t\tif err := StreamGovernanceRawHistoryGitIn(store.fsys(), context.Background(), root, \"stream-audit\", 1<<20, io.Discard, args...); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\treturn view\n\t}\n\tview := read(streamArgs(id)...)\n\tif audit := view.audit(); reruns.Load() != 0 || audit.ChangedProducers[\"stream-audit\"] {\n\t\tt.Fatalf(\"a pure read was streamed again under the same configuration: reruns=%d %+v\", reruns.Load(), audit)\n\t}\n\tview = read(streamArgs(id)...)\n\tsnapshotTestGit(t, root, \"config\", \"diff.noprefix\", \"true\")\n\tif audit := view.audit(); reruns.Load() != 1 || !audit.ChangedProducers[\"stream-audit\"] {\n\t\tt.Fatalf(\"a configuration change did not stream the read again and find the change: reruns=%d %+v\", reruns.Load(), audit)\n\t}\n\tsnapshotTestGit(t, root, \"config\", \"--unset\", \"diff.noprefix\")\n\tview = read(\"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", \"HEAD\", \"--\")\n\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"three\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-am\", \"third\")\n\tif audit := view.audit(); reruns.Load() != 2 || !audit.ChangedProducers[\"stream-audit\"] {\n\t\tt.Fatalf(\"a head-relative streamed read was not audited: reruns=%d %+v\", reruns.Load(), audit)\n\t}\n}\npackage cli\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"os/exec\"\n\t\"testing\"\n)\n\n// Spec pose-read-view-streamed-object-digests R3: streaming each commit's\n// patch into the digest keeps the digest the retained capture computed, the\n// SHA-256 of the concatenated `git show --binary` of the commits in order.\nfunc TestAStreamedChangeSetKeepsItsDiffDigest(t *testing.T) {\n\trepo := newRemovalRepo(t)\n\trepo.write(\"a.txt\", \"one\\n\")\n\tfirst := repo.commit(\"first\\n\\nPOSE-Spec: alpha\")\n\trepo.write(\"a.txt\", \"two\\n\")\n\trepo.write(\"b.bin\", \"\\x00\\x01\\x02binary\\xff\\n\")\n\tsecond := repo.commit(\"second\\n\\nPOSE-Spec: alpha\")\n\tset, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdigest := sha256.New()\n\tfor _, sha := range []string{first, second} {\n\t\tout, err := exec.Command(\"git\", \"--no-replace-objects\", \"-C\", repo.root, \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", sha, \"--\").Output()\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tdigest.Write(out)\n\t}\n\tif want := \"sha256:\" + hex.EncodeToString(digest.Sum(nil)); set.DiffDigest != want {\n\t\tt.Fatalf(\"streamed diff digest %s, the retained capture's %s\", set.DiffDigest, want)\n\t}\n}\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\ndiff --git a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\nindex 570b9503..82852c31 100644\n--- a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n+++ b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n@@ -250,3 +250,20 @@ every attributed commit. The structural fix, retaining only a digest for pure\n reads of immutable Git objects whose bytes a producer only hashes, is a\n follow-up of that spec, and a further raise again requires a measured\n reassessment.\n+\n+## Streamed object reads restore the captured-input budget (D11) — 2026-11-14\n+\n+Spec `pose-read-view-streamed-object-digests` supersedes D10. A Git object\n+read whose bytes a producer only hashes (the `git show --binary` of each\n+commit that feeds a change set's diff digest) is streamed into the producer:\n+the read view retains its digest and length, never its bytes, and charges a\n+separate streamed budget of 8 GiB per operation, and 8 GiB again for the\n+final audit, with at most 256 MiB per read. The final audit does not stream a\n+patch read of a commit named by its full id again while the root's effective\n+Git configuration is the one it was read under. The same bytes enter the\n+same hash, so every diff digest and change-set id is unchanged: on the\n+pose-dist corpus the 567 change sets and the whole `delivery-integrity.json`\n+were identical before and after. The captured-input budget returns to\n+512 MiB. Streaming bounds memory, not I/O: the bytes read still grow with\n+the attributed history.\n+\ndiff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex c76f670b..4c323b91 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2370,6 +2370,13 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"read-view-streamed-object-digests-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"./internal/cli\", \"-run\", \"Streamed\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"milestone-closes-when-reached-integration\",\n           \"program\": \"go\",\ndiff --git a/POSE.md b/POSE.md\nindex 91dba8fb..b4c0cd2b 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -382,7 +382,7 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `state --governance [--scope <ref>] [--json]` (spec `pose-effective-governance-projection`) — live, read-only projection of what governance is in force here: for each registry contract, optional capability (atomic start, contract nodes, causality closeout, qualified references, spec transfer, criterion reuse, signed attestations, verified identity) and gate (Definition of Ready, delivery integrity), whether it is `supported`, `configured`, `applicable` and `effective`, with reason codes such as `not-adopted`, `no-readiness-cutoff`, `legacy-cutoff:<date>` or `identity-assurance-declared`. `--scope` compares the scope's newest sealed bundle — the contracts it stamped — with what the policy seals today. It reads the same functions the gates call and writes nothing. `pose_project_state` carries the same projection as `effective_governance` (optional `governance_scope`).\n - `state --attention` (specs `pose-obligation-projection`, `pose-state-attention`) — live, read-only answer to \"what is still owed, by whom, restricting which phase?\". Obligations are projected from the subsystems that own them — readiness (unmet `depends_on`, Definition of Ready, unexplained `blocked`), closeout and review of in-progress specs (an unapproved review, each judgment criterion a sealed bundle still owes, text blockers carried as `legacy-opaque`), start reconciliation when atomic start is adopted, and open follow-ups as advisory residual debt — never stored a second time. Project-level sources are projected too (spec `pose-attention-projects-every-source`), originating on `xref:<project>/project:<project>`: an open docs review mark (owed by the doc's owner until `pose docs-review resolve`), a capability mechanism with a stale trigger, a release newer than the newest verified one that is not yet verified, and an accepted-risk or follow-up finding past its review date in the latest legacy review record. Free-form investigation notes carry no state and are not a source. The render shows coverage first: a producer that failed, or action requests until adopted, makes the answer `INCOMPLETE`, so an empty group never reads as nothing owed, and a fresh install, once committed, reads `complete`. Then what needs `--actor` (or any person or role), then what restricts each phase (`start`, `execution`, `review`, `closeout`, `release`), then residual debt. `--json` returns the report — stable `obl-` ids, qualified refs, reason codes, conditions, recipients, effects, satisfaction, knowledge, waiting, a snapshot of revision/dirty tree/policy/contract/index digests, per-producer coverage — plus the `attention` grouping. MCP: `pose_obligations` returns the same ids from the same function. Attention is not a gate.\n - Governance read views (spec `pose-governance-read-view-generation`) — inspect `snapshot.read_view` in `state --attention --json` and `pose_obligations`: its own `schema_version: 1`, observed-input ID, engine/parser versions and root bindings describe one operation. The enclosing report stays at schema version 1. Review and closeout JSON expose the same contract in `read_view`. The ID binds consumed bytes, directory observations, errors and absences; revision, dirty state, size and mtime alone do not prove equivalence. `current` describes the final audit instant only. Coherence, producer coverage and freshness are separate: `unknown` or incomplete coverage must never be read as nothing owed or as write authorization. A historical report without this binding remains readable and proves no current authorization.\n-  Reads retain at most 40,000 observations including retained directory entries, 1 GiB of input bytes and 16 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n+  Reads retain at most 40,000 observations including retained directory entries, 512 MiB of retained input bytes, 8 GiB of streamed bytes (a Git object read whose bytes are only hashed is streamed, keeping its digest) and 16 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n   The global review-closeout check composes an audited selection/catalogue coordinator with independently bounded scope operations. A scope and its recursive children use one closure; workers share only the explicitly bound immutable catalogue. At most 16 scope closures are live, further limited by `POSE_CHECK_WORKERS` or the core count. Scope findings are buffered until their audits and the coordinator audit finish. This proves coherent selection and individually audited results, not a simultaneous snapshot across every completed scope; one exhausted scope cannot consume its sibling's capture budget, and any unresolved loss still fails the global gate.\n - `action <open|list|show|resolve|cancel|waive|invalidate>` (specs `pose-action-requests`, `pose-action-request-resolution`) — material requests to a person or an external system that no other source records: a decision, an approval, an input, an external operation or an acceptance, with its question, options and consequences, recommendation, recipient (principal, role or `unassigned`), qualified targets (`requirement:R4` inside the origin spec, or `xref:…`), per-phase effects (`--effect closeout:block` lets implementation continue) and an optional subject (`--subject requirement:R4` or `path:<file>`) whose change invalidates an answer recorded for the old content. Open one only when a different answer would materially change execution, scope, authority, risk acceptance, closeout or publication and no authorization already given covers it. Each request is an append-only journal under `.pose/actions/`, read whole: a line with a second value, a duplicate field (keys differing only in case included), an unknown event type, another schema, a sequence gap, an empty line or no terminator is never part of a view; `action show|list` and MCP locate it (line, byte offset, length, SHA-256) as an `interrupted-tail`, with a truncation proposal for a person to review, or as `corrupt`, to restore from version control — the engine repairs nothing (spec `pose-journal-checkpoint-and-lock-recovery`); `open` is a preview until `--apply`. Targets are qualified with the current project id; when it is derived from the directory name (no `.pose/project.json`, `POSE_DEFAULT_PROJECT_ID` or `POSE_PROJECT_ROOTS` binding), `open --apply` says so (on stderr with `--json`), because a checkout under another name would record another project, and the obligation snapshot lists the same limitation. A resolution names the `--request-digest` it answers and the `--expected-revision` it read, carries an `--idempotency-key` (a retry is a no-op, the same key with other content is refused, a second answer against the same revision is refused) and comes from an actor holding the recipient role in `.pose/policy/actions.json` (`{\"schema_version\":1,\"roles\":{\"maintainer\":[\"human:<name>\"]},\"identity_assurance\":\"declared|verified\"}`); under `verified` it needs `--claim <file>` with an Ed25519 claim from an issuer pinned in the review policy, bound to project, audience, request digest, principal and answer (a human principal also needs `human_authority_issuers`). Answered is not satisfied: a declined approval, a rejected acceptance or a failed external operation leaves the condition unmet. The requester may cancel its own question; a waiver needs the recipient authority and a reason. Open requests are projected as `actor-action` obligations in `state --attention` and `pose_obligations`; MCP opens requests with `pose_action_open` (risk class `governance-write`, a preview unless `apply` is true) and reads them with `pose_action_requests`; `pose_action_resolve` (spec `pose-mcp-action-resolve-signed-only`, `governance-write`) records an answer only with the principal's proof — a signature by a key registered to it, or a trusted issuer's claim — and refuses a declared answer under any assurance; its preview returns the statement to sign and the `ssh-keygen` command.\n - Action destination scoping (spec `pose-action-target-and-node-scoping`) — origin is provenance, targets select relevance, and effects select restrictions. An empty effect scope still means the whole source artifact; a roadmap or milestone expands its current members. Explicit scopes replace that default, so a request from alpha can restrict beta without blocking alpha. A named whole artifact is a whole restriction, not partial merely because it is qualified. Pending requests remain visible when their origin becomes terminal. Unknown membership or unreadable material is reported as limited coverage and never expands into every spec. CLI accepts `--effect-json '{\"phase\":\"start\",\"mode\":\"block\",\"scope\":[\"xref:project/spec:beta\"]}'`; MCP `effects` accepts the same object alongside legacy `\"start:block\"` strings. Targets and subjects resolve by project/artifact/kind/ID, and a subject is re-read in its recorded artifact. Under adopted agency readiness, new approvals and acceptances require an explicit `--subject` / `subject`; legacy unbound requests retain their journal and report that answers have no content-change detection. Policy-off creation and transition defaults remain unchanged. This compatibility tightening requires release review; no policy adoption happens here.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '330,580p' pose-mcp/internal/pose/governance_read_view_git.go; rg -n 'func gitCommand|RawHistoryGit|governanceFullObject|func .*audit|finalAudits' pose-mcp/internal/pose/{git*.go,governance_read_view*.go}; rg -n 'artifact-check|surface-check|func .*Context' pose-mcp/internal/cli/{artifact_integrity.go,surface_check.go,context.go}\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '330,580p' pose-mcp/internal/pose/governance_read_view_git.go; rg -n 'func gitCommand|RawHistoryGit|governanceFullObject|func .*audit|finalAudits' pose-mcp/internal/pose/{git*.go,governance_read_view*.go}; rg -n 'artifact-check|surface-check|func .*Context' pose-mcp/internal/cli/{artifact_integrity.go,surface_check.go,context.go}\"","aggregated_output":"func (state *governanceReadViewGitState) capture(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif state == nil || state.op == nil {\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif ctx == nil {\n\t\tctx = context.Background()\n\t}\n\tdeadline, hasDeadline := ctx.Deadline()\n\tauditContext := context.WithoutCancel(ctx)\n\tkey := governanceGitObservationKey(root, args, maxOutputBytes)\n\tstate.mu.Lock()\n\tif prior := state.observations[key]; prior != nil {\n\t\tprior.producers[producer] = true\n\t\tstdout, err := append([]byte(nil), prior.stdout...), prior.err\n\t\tstate.mu.Unlock()\n\t\treturn stdout, err\n\t}\n\tmetadataCost := int64(len(root) + len(key) + len(producer) + 128)\n\tif !state.op.reserveRecord(metadataCost) {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its shared record or metadata budget while capturing Git\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tlimit := maxOutputBytes\n\tif state.op.remainingInput() < limit {\n\t\tlimit = state.op.remainingInput()\n\t}\n\tif limit <= 0 {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its Git input byte budget\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tbyObject, byHead := governancePureGitRead(args)\n\theadBefore := \"\"\n\tif byHead {\n\t\theadBefore = governanceHeadAt(ctx, files, root)\n\t}\n\t// A process that turned the resident memo on answers a pure read from it; the bytes are\n\t// admitted against the operation's budget as a fresh read's are.\n\tvar stdout, stderr []byte\n\tvar runErr error\n\tmemoKey, memoized := \"\", false\n\tmemo := residentGit.Load()\n\tif memo != nil && (byObject || byHead && headBefore != \"\") {\n\t\tif key, ok := residentGitKey(root, headBefore, state.effectiveGitConfig(ctx, files, root), args); ok {\n\t\t\tmemoKey = key\n\t\t\tif hit, found := memo.get(key); found {\n\t\t\t\tif int64(len(hit)) > limit || !state.op.reserveInput(int64(len(hit))) {\n\t\t\t\t\tstate.mu.Unlock()\n\t\t\t\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n\t\t\t\t\treturn nil, errGovernanceReadViewBudget\n\t\t\t\t}\n\t\t\t\tstdout, memoized = hit, true\n\t\t\t}\n\t\t}\n\t}\n\tif !memoized {\n\t\tstdout, stderr, runErr = runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, state.op.reserveInput)\n\t}\n\tif errors.Is(runErr, errGovernanceReadViewBudget) {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tobservation := &governanceReadViewGitObservation{\n\t\troot: root, args: append([]string(nil), args...), files: files, ctx: auditContext, deadline: deadline, hasDeadline: hasDeadline, maxOutputBytes: maxOutputBytes,\n\t\tstdout: append([]byte(nil), stdout...), stderr: append([]byte(nil), stderr...), err: runErr, errText: errorText(runErr),\n\t\tproducers: map[string]bool{producer: true},\n\t}\n\tif runErr == nil && len(stderr) == 0 {\n\t\tswitch {\n\t\tcase byObject:\n\t\t\tobservation.pure = true\n\t\tcase memoized && byHead:\n\t\t\t// The commit is the one the memo's key names; nothing ran, so there is no second read.\n\t\t\tobservation.pure, observation.headAt = true, headBefore\n\t\tcase byHead && headBefore != \"\" && governanceHeadAt(ctx, files, root) == headBefore:\n\t\t\tobservation.pure, observation.headAt = true, headBefore\n\t\t}\n\t\tif memoKey != \"\" && !memoized && observation.pure {\n\t\t\tmemo.put(memoKey, stdout)\n\t\t}\n\t}\n\tstate.observations[key] = observation\n\tstate.mu.Unlock()\n\tif isGovernanceGitHeadCommand(args) {\n\t\tif runErr != nil {\n\t\t\tif !state.op.mayOmitPrimaryRevision(root) {\n\t\t\t\tstate.markUnknownForRoot(root, producer, \"source revision could not be read from Git\")\n\t\t\t}\n\t\t} else {\n\t\t\trevision := strings.TrimSpace(string(stdout))\n\t\t\tif revision == \"\" && state.op.mayOmitPrimaryRevision(root) {\n\t\t\t\treturn append([]byte(nil), stdout...), runErr\n\t\t\t}\n\t\t\tstate.bindRevision(root, revision)\n\t\t}\n\t}\n\treturn append([]byte(nil), stdout...), runErr\n}\n\nfunc isGovernanceGitHeadCommand(args []string) bool {\n\treturn len(args) == 3 && args[0] == \"rev-parse\" && args[1] == \"--verify\" && args[2] == \"HEAD\"\n}\n\nfunc governanceGitObservationKey(root string, args []string, maxOutputBytes int64) string {\n\tencoded, _ := json.Marshal(args)\n\treturn filepath.Clean(root) + \"\\x00\" + string(encoded) + \"\\x00\" + fmt.Sprint(maxOutputBytes)\n}\n\nfunc (state *governanceReadViewGitState) bindRevision(root, revision string) {\n\tif revision == \"\" || state == nil || state.op == nil {\n\t\tstate.markUnknownForRoot(root, \"projection\", \"source revision binding is unavailable\")\n\t\treturn\n\t}\n\tstate.op.mu.Lock()\n\tfor _, entry := range state.op.roots {\n\t\tif sameLexicalRoot(entry.root, root) {\n\t\t\tentry.revision = revision\n\t\t\tstate.op.mu.Unlock()\n\t\t\treturn\n\t\t}\n\t}\n\tstate.op.mu.Unlock()\n\tstate.markUnknownForRoot(root, \"projection\", \"source revision root is outside the authorized vector\")\n}\n\nfunc (state *governanceReadViewGitState) markUnknownForRoot(root, producer, reason string) {\n\tif state == nil || state.op == nil {\n\t\treturn\n\t}\n\tstate.op.mu.Lock()\n\tvar view *governanceReadView\n\tfor _, entry := range state.op.ro