{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'func IsAdministrativePath|module-metadata' pose-mcp/internal/pose/material*; sed -n '1,170p' pose-mcp/internal/pose/material_binding.go; sed -n '30,110p' pose-mcp/internal/cli/validate.go; rg -n 'func dispatchValidationEntries' pose-mcp/internal/cli/validate.go; sed -n '745,825p' pose-mcp/internal/cli/validate.go; sed -n '1,160p' pose-mcp/internal/cli/validate_material_worktree_test.go\"","aggregated_output":"pose-mcp/internal/pose/material_binding.go:36:func IsAdministrativePath(p string) bool {\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Validation evidence binds to the material it validated (spec\n// pose-validation-evidence-material-binding, ADR\n// validation-evidence-binds-to-validated-material). A commit whose every\n// changed path is a derived administrative record does not change what the\n// checks exercised, so it does not move the material digest.\n\n// engineVersion is the running engine, registered by the binaries (internal/pose\n// stays importable on its own). It is part of every material digest, so a new\n// engine never inherits evidence the previous one produced.\nvar engineVersion = \"unregistered\"\n\n// SetEngineVersion registers the running engine for material digests.\nfunc SetEngineVersion(v string) { engineVersion = v }\n\n// administrativeDirs is the closed list of derived-record directories. It is\n// owned by the engine; adding a class is a contract change that needs an ADR.\nvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n\n// materialIndexes are files inside an administrative directory that still\n// change what the checks demand.\nvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\n// IsAdministrativePath reports whether p is a derived administrative record.\nfunc IsAdministrativePath(p string) bool {\n\tif p == \"\" || p != path.Clean(p) || strings.HasPrefix(p, \"/\") || strings.HasPrefix(p, \"../\") {\n\t\treturn false\n\t}\n\tif materialIndexes[p] {\n\t\treturn false\n\t}\n\tif !recordExtensions[strings.ToLower(path.Ext(p))] {\n\t\treturn false\n\t}\n\tfor _, dir := range administrativeDirs {\n\t\tif strings.HasPrefix(p, dir) {\n\t\t\treturn true\n\t\t}\n\t}\n\tif rest, ok := strings.CutPrefix(p, \".pose/\"); ok {\n\t\tif i := strings.Index(rest, \"/\"); i > 0 && strings.HasPrefix(rest[:i], \"review-\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// recordExtensions are the data formats a derived record is written in. Code or\n// a script stored in a class is material: that keeps a source file moved or\n// copied into a class from hiding its later edits. A copied data file stays\n// indistinguishable from a record; a check that reads data out of a derived-record\n// directory is outside this contract (ADR validation-evidence-binds-to-validated-material).\nvar recordExtensions = map[string]bool{\".json\": true, \".jsonl\": true, \".ndjson\": true, \".md\": true, \".txt\": true, \".log\": true, \".transcript\": true}\n\n// TreeEntry is one entry of the validated head's tree.\ntype TreeEntry struct{ Mode, Blob string }\n\nfunc regularMode(mode string) bool { return mode == \"100644\" || mode == \"100755\" }\n\n// MaterialInputs are what a material digest is computed from: the paths a change\n// set names (both sides of a rename, and the validation matrix) and the\n// destinations of renames. They are stored with the set so the digest can be\n// recomputed against the current tree without the commits' own records.\ntype MaterialInputs struct {\n\tNames []string `json:\"names\"`\n\tMoved []string `json:\"moved,omitempty\"`\n}\n\n// MaterialInputsOf derives the inputs from per-commit path records. They must\n// be unmerged: folding a create and a later rename into one creation would hide\n// that the file moved into a class.\nfunc MaterialInputsOf(paths []ObservedPath) MaterialInputs {\n\tnames := map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\tmoved := map[string]bool{}\n\tfor _, p := range paths {\n\t\tfor _, name := range []string{p.Path, p.OldPath, p.NewPath} {\n\t\t\tif name != \"\" {\n\t\t\t\tnames[name] = true\n\t\t\t}\n\t\t}\n\t\t// A rename destination is material whatever directory it lands in:\n\t\t// otherwise moving a source file into a class would hide its later edits.\n\t\tif p.OldPath != \"\" && p.NewPath != \"\" {\n\t\t\tmoved[p.NewPath] = true\n\t\t}\n\t}\n\tin := MaterialInputs{}\n\tfor name := range names {\n\t\tin.Names = append(in.Names, name)\n\t}\n\tfor name := range moved {\n\t\tin.Moved = append(in.Moved, name)\n\t}\n\tsort.Strings(in.Names)\n\tsort.Strings(in.Moved)\n\treturn in\n}\n\n// MaterialSetDigest digests the head state of the material a change set\n// touched: every path it names (both sides of a rename) with its mode and blob\n// at the validated head, minus the paths that are administrative records and\n// still regular files there, plus the validation matrix. A symlink, submodule\n// or directory in an administrative class is material; so is a path that left\n// a class. tree maps each named path (and the matrix) to its entry; a path\n// absent from the head tree is \"absent\".\nfunc MaterialSetDigest(in MaterialInputs, tree map[string]TreeEntry) string {\n\tmoved := map[string]bool{}\n\tfor _, name := range in.Moved {\n\t\tmoved[name] = true\n\t}\n\tsorted := in.Names\n\th := sha256.New()\n\tfor _, name := range sorted {\n\t\tentry, present := tree[name]\n\t\tif IsAdministrativePath(name) && !moved[name] && (!present || regularMode(entry.Mode)) {\n\t\t\tcontinue\n\t\t}\n\t\tif !present {\n\t\t\th.Write([]byte(name + \"\\x00absent\\n\"))\n\t\t\tcontinue\n\t\t}\n\t\th.Write([]byte(name + \"\\x00\" + entry.Mode + \"\\x00\" + entry.Blob + \"\\n\"))\n\t}\n\treturn \"sha256:\" + hex.EncodeToString(h.Sum(nil))\n}\n\n// MaterialDigestUnreadable marks a change set whose head tree could not be read\n// or whose checkout is not complete. It never binds evidence and never lets\n// evidence recorded without it pass as current.\nconst MaterialDigestUnreadable = \"unreadable\"\n\n// MaterialBindingUnavailable is recorded for a scope whose material cannot be\n// established, so the result is stale for it instead of falling back to the\n// commit-bound rules.\nconst MaterialBindingUnavailable = \"unavailable\"\n\n// MaterialBinding returns what a validation run should record for a spec: the\n// scoped digest, the unavailable marker when a change set's material could not\n// be read, or nothing when the spec has no material-bound change set.\nfunc MaterialBinding(graph DeliveryIntegrityGraph, spec string) (string, bool) {\n\tsets := 0\n\tfor _, set := range graph.ChangeSets {\n\t\tif set.Spec != spec {\n\t\t\tcontinue\n\t\t}\n\t\tsets++\n\t\t// A set read back from the report history carries no material digest, and\n\t\t// one that could not be read has the unreadable marker: either way the\n\t\t// scope's material cannot be established, so the run records the binding as\n\t\t// unavailable instead of silently falling back to the commit-bound rules.\n\t\tif set.MaterialDigest == \"\" || set.MaterialDigest == MaterialDigestUnreadable {\n\t\t\treturn MaterialBindingUnavailable, true\n\t\t}\n\t}\n\tif sets == 0 {\n\t\treturn \"\", false\n\t}\n\tif digest := ScopedMaterialDigest(graph, spec); digest != \"\" {\n\t\treturn digest, true\n\tFileExists    string `json:\"fileExists\"`\n\tFileNotExists string `json:\"fileNotExists\"`\n\t// FileNotExistsAny (spec pose-stack-catalog-expansion): skip when ANY of\n\t// these files exist — expresses manager-priority exclusion (e.g. a pip\n\t// check yields to poetry/pipenv when their lockfiles are present)\n\t// without needing repeated single-field checks.\n\tFileNotExistsAny []string `json:\"fileNotExistsAny\"`\n}\n\ntype validationCheck struct {\n\tName          string            `json:\"name\"`\n\tCommand       string            `json:\"command\"`\n\tProgram       string            `json:\"program\"`\n\tArgs          []string          `json:\"args\"`\n\tEnv           map[string]string `json:\"env\"`\n\tSeverity      string            `json:\"severity\"`\n\tEvidenceClass string            `json:\"evidenceClass,omitempty\"`\n\tWhen          validationWhen    `json:\"when\"`\n\t// Runtime guardrails (spec pose-validation-runtime-guardrails).\n\tTimeoutSeconds int    `json:\"timeoutSeconds\"` // 0 = defaults.timeoutSeconds (600)\n\tIsolation      string `json:\"isolation\"`      // \"\" | \"required\" — required never runs locally\n\t// Exclusive runs the check with no other check running (spec\n\t// pose-validate-concurrent-steps R2).\n\tExclusive bool `json:\"exclusive,omitempty\"`\n}\n\n// validationEntry is one line of a validation run, in matrix order: a module\n// note, a skipped check or a check to execute.\ntype validationEntry struct {\n\tnote      string\n\tcheck     validationCheck\n\tmoduleDir string\n\tseverity  string\n\t// skip is why the check does not run. silent marks a changed-scope skip,\n\t// recorded in order without a step line.\n\tskip     string\n\tsilent   bool\n\tisolated bool\n\t// carried marks a check whose result comes from the canonical base (spec\n\t// pose-validate-carries-unchanged-checks R4); it is silent and never runs.\n\tcarried bool\n\tresult  checkResult\n\tdone     chan struct{}\n}\n\n// resolveWhen evaluates the check's condition at the moment it would start,\n// so an earlier check, finished by then, can decide it (review round 1, B1).\nfunc (e *validationEntry) resolveWhen() {\n\tif e.skip == \"\" {\n\t\te.skip = validationSkipReason(e.moduleDir, e.check.When)\n\t}\n}\n\n// execute runs the check and records its outcome in the entry's result. It\n// touches nothing else, so entries can run concurrently; the caller counts.\nfunc (e *validationEntry) execute(parent context.Context, matrix validationMatrix, verbose bool, stdout, stderr io.Writer, beforeStream func()) {\n\tcheck, result := e.check, &e.result\n\ttimeout := check.TimeoutSeconds\n\tif timeout <= 0 {\n\t\ttimeout = matrix.Defaults.TimeoutSeconds\n\t}\n\tif timeout <= 0 {\n\t\ttimeout = 600 // documented safe default\n\t}\n\tmaxOutput := matrix.Defaults.MaxOutputBytes\n\tif maxOutput <= 0 {\n\t\tmaxOutput = 1 << 20 // 1 MiB documented safe default\n\t}\n\tctx, cancel := context.WithTimeout(parent, time.Duration(timeout)*time.Second)\n\tcapture := &tailBuffer{capacity: 4096}\n\tlimiter := &outputLimiter{limit: maxOutput, cancel: cancel}\n\tpackages := &goTestPackages{}\n\texecArgs := sanitizeGoCheckArgs(ctx, e.moduleDir, check.Program, check.Args)\n\tif parent.Err() != nil {\n\t\tcancel()\n\t\te.markCancelled()\n\t\treturn\n\t}\n\tcmd := exec.CommandContext(ctx, check.Program, execArgs...)\n\tsetProcessGroup(cmd)\n\tcmd.Cancel = func() error { return killProcessGroup(cmd) }\n325:func dispatchValidationEntries(ctx context.Context, entries []*validationEntry, jobs int, matrix validationMatrix) {\n\t\tfilepath.Join(moduleDir, \"src\", \"main\", \"AndroidManifest.xml\"),\n\t\tfilepath.Join(moduleDir, \"AndroidManifest.xml\"),\n\t} {\n\t\tif _, err := files.Stat(candidate); err == nil {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// isAndroidModule reads and writes the filesystem directly; isAndroidModuleIn takes the\n// operation's files.\nfunc isAndroidModule(moduleDir string) bool {\n\treturn isAndroidModuleIn(posemodel.NativeFiles(), moduleDir)\n}\n\n// validationSkipReason returns the deterministic selection reason when a\n// check must be skipped (\"\" = run it). Every skip is recorded with its\n// reason in the structured result (spec pose-structured-validation-results).\nfunc validationSkipReason(module string, when validationWhen) string {\n\tif when.FileExists != \"\" {\n\t\tif !confinedRelativePath(when.FileExists) {\n\t\t\treturn \"when.fileExists escapes the module: \" + when.FileExists\n\t\t}\n\t\tif _, err := os.Stat(filepath.Join(module, filepath.FromSlash(when.FileExists))); err != nil {\n\t\t\treturn \"when.fileExists not met: \" + when.FileExists\n\t\t}\n\t}\n\tif when.FileNotExists != \"\" {\n\t\tif !confinedRelativePath(when.FileNotExists) {\n\t\t\treturn \"when.fileNotExists escapes the module: \" + when.FileNotExists\n\t\t}\n\t\tif _, err := os.Stat(filepath.Join(module, filepath.FromSlash(when.FileNotExists))); err == nil {\n\t\t\treturn \"when.fileNotExists violated: \" + when.FileNotExists + \" exists\"\n\t\t}\n\t}\n\tfor _, excl := range when.FileNotExistsAny {\n\t\tif !confinedRelativePath(excl) {\n\t\t\treturn \"when.fileNotExistsAny escapes the module: \" + excl\n\t\t}\n\t\tif _, err := os.Stat(filepath.Join(module, filepath.FromSlash(excl))); err == nil {\n\t\t\treturn \"when.fileNotExistsAny violated: higher-priority manager marker present: \" + excl\n\t\t}\n\t}\n\treturn \"\"\n}\n\nfunc validateStructuredMatrixPaths(matrix validationMatrix) error {\n\tvalidate := func(scope string, checks []validationCheck) error {\n\t\tfor index, check := range checks {\n\t\t\tfor field, path := range map[string]string{\"fileExists\": check.When.FileExists, \"fileNotExists\": check.When.FileNotExists} {\n\t\t\t\tif !confinedRelativePath(path) {\n\t\t\t\t\treturn fmt.Errorf(\"%s.checks[%d].when.%s must remain inside its module\", scope, index, field)\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor i, path := range check.When.FileNotExistsAny {\n\t\t\t\tif !confinedRelativePath(path) {\n\t\t\t\t\treturn fmt.Errorf(\"%s.checks[%d].when.fileNotExistsAny[%d] must remain inside its module\", scope, index, i)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t}\n\tfor name, stack := range matrix.Stacks {\n\t\tif err := validate(\"stacks.\"+name, stack.Checks); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tfor name, override := range matrix.ModuleOverrides {\n\t\tif err := validate(\"moduleOverrides.\"+name, override.Checks); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc validateDeliveryMatrixContract(matrix validationMatrix) error {\n\tfor scope, checks := range matrix.Stacks {\n\t\tfor _, check := range checks.Checks {\n\t\t\tif check.EvidenceClass != \"\" && !posemodel.ValidEvidenceClasses[check.EvidenceClass] {\n\t\t\t\treturn fmt.Errorf(\"stacks.%s check %s has unknown evidenceClass %q\", scope, check.Name, check.EvidenceClass)\npackage cli\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\n// Validation records a material binding only when the working copy equals the\n// committed material (spec pose-validation-evidence-material-binding R1, R3).\nfunc TestMaterialWorktreeCleanSeesUncommittedMaterial(t *testing.T) {\n\trepo := newRemovalRepo(t)\n\trepo.write(\"a.go\", \"package a\\n\")\n\trepo.write(\".pose/indexes/validation-matrix.json\", \"{}\\n\")\n\trepo.write(\".pose/results/delivery-validation.json\", \"{}\\n\")\n\trepo.commit(\"base\")\n\tif !materialWorktreeClean(repo.root) {\n\t\tt.Fatal(\"a clean checkout is not clean\")\n\t}\n\trepo.write(\".pose/results/delivery-validation.json\", \"{\\\"changed\\\":1}\\n\")\n\tif !materialWorktreeClean(repo.root) {\n\t\tt.Fatal(\"an administrative record in progress made the checkout unclean\")\n\t}\n\trepo.write(\"a.go\", \"package a\\n\\nvar fixed = true\\n\")\n\tif materialWorktreeClean(repo.root) {\n\t\tt.Fatal(\"an uncommitted source change was ignored\")\n\t}\n\tartifactGit(t, repo.root, \"checkout\", \"--\", \"a.go\")\n\trepo.write(\".pose/indexes/validation-matrix.json\", \"{\\\"weakened\\\":true}\\n\")\n\tif materialWorktreeClean(repo.root) {\n\t\tt.Fatal(\"an uncommitted matrix change was ignored\")\n\t}\n\tartifactGit(t, repo.root, \"checkout\", \"--\", \".pose/indexes/validation-matrix.json\")\n\trepo.write(\"extra.go\", \"package a\\n\")\n\tif materialWorktreeClean(repo.root) {\n\t\tt.Fatal(\"an untracked source file was ignored\")\n\t}\n}\n\nfunc TestMaterialWorktreeCleanSeesAnEditedAdministrativeSymlink(t *testing.T) {\n\trepo := newRemovalRepo(t)\n\trepo.write(\"a.go\", \"package a\\n\")\n\tif err := os.MkdirAll(filepath.Join(repo.root, \".pose\", \"results\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Symlink(\"../../a.go\", filepath.Join(repo.root, \".pose\", \"results\", \"x.json\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trepo.commit(\"a symlink inside a class\")\n\tif !materialWorktreeClean(repo.root) {\n\t\tt.Fatal(\"a clean checkout is not clean\")\n\t}\n\tlink := filepath.Join(repo.root, \".pose\", \"results\", \"x.json\")\n\t_ = os.Remove(link)\n\tif err := os.Symlink(\"../../b.go\", link); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif materialWorktreeClean(repo.root) || materialTrackedUnchanged(repo.root) {\n\t\tt.Fatal(\"retargeting a committed symlink inside a class was ignored\")\n\t}\n}\n\nfunc TestMaterialTrackedUnchangedIgnoresUntrackedBuildProducts(t *testing.T) {\n\trepo := newRemovalRepo(t)\n\trepo.write(\"a.go\", \"package a\\n\")\n\trepo.commit(\"base\")\n\trepo.write(\"build/output.bin\", \"x\")\n\tif !materialTrackedUnchanged(repo.root) {\n\t\tt.Fatal(\"an untracked build product counted as a material change\")\n\t}\n\trepo.write(\"a.go\", \"package a\\n\\nvar changedByACheck = 1\\n\")\n\tif materialTrackedUnchanged(repo.root) {\n\t\tt.Fatal(\"a tracked file changed during the run went unseen\")\n\t}\n}\n\nfunc TestMaterialWorktreeCleanSeesALinkReplacingAnAdministrativeRecord(t *testing.T) {\n\trepo := newRemovalRepo(t)\n\trepo.write(\"a.go\", \"package a\\n\")\n\trepo.write(\".pose/results/x.json\", \"{}\\n\")\n\trepo.commit(\"a record\")\n\trecord := filepath.Join(repo.root, \".pose\", \"results\", \"x.json\")\n\tif err := os.Remove(record); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Symlink(\"../../a.go\", record); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif materialWorktreeClean(repo.root) || materialTrackedUnchanged(repo.root) {\n\t\tt.Fatal(\"a record replaced by a link was ignored\")\n\t}\n\tartifactGit(t, repo.root, \"checkout\", \"--\", \".pose/results/x.json\")\n\tif err := os.Symlink(\"../../a.go\", filepath.Join(repo.root, \".pose\", \"results\", \"new.json\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif materialWorktreeClean(repo.root) {\n\t\tt.Fatal(\"a new administrative link was ignored\")\n\t}\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"agent_message","text":"The focused regression tests passed. I found a remaining dependency-alias gap: the symlink check skips a dependency when its final path is missing, even if an ancestor is a symlink. A deletion through that alias can therefore leave the consumer’s old pass carried.\n\nThe read-only sandbox also prevented creating scratch space for assessments. I’ll report those as unrun and distinguish local results from sealed evidence."}}
