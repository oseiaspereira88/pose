ceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"release-governance\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"backend-go\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"structural-delta\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    }\n  },\n  \"stacks\": {\n    \"node\": {\n      \"checks\": [\n        {\n          \"name\": \"lint\",\n          \"program\": \"npm\",\n          \"args\": [\n            \"run\",\n            \"lint\",\n            \"--if-present\"\n          ],\n          \"severity\": \"optional\",\n          \"evidenceClass\": \"lint\"\n        },\n        {\n          \"name\": \"test\",\n          \"program\": \"npm\",\n          \"args\": [\n            \"test\",\n            \"--if-present\"\n          ],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"unit\"\n        },\n        {\n          \"name\": \"build\",\n          \"program\": \"npm\",\n          \"args\": [\n            \"run\",\n            \"build\",\n            \"--if-present\"\n          ],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"build\"\n        },\n        {\n          \"name\": \"typecheck\",\n          \"program\": \"npm\",\n          \"args\": [\n            \"run\",\n            \"typecheck\",\n            \"--if-present\"\n          ],\n          \"severity\": \"optional\",\n          \"evidenceClass\": \"typecheck\"\n        }\n      ]\n    },\n    \"go\": {\n      \"checks\": [\n        {\n          \"name\": \"build\",\n          \"program\": \"go\",\n          \"args\": [\n            \"build\",\n            \"./...\"\n          ],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"build\"\n        },\n        {\n          \"name\": \"test\",\n          \"program\": \"go\",\n          \"args\": [\n            \"test\",\n            \"./...\"\n          ],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"unit\"\n        },\n        {\n          \"name\": \"vet\",\n          \"program\": \"go\",\n          \"args\": [\n","exit_code":0,"status":"completed"}}
