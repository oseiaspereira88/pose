{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/rules/backend-go.md; sed -n '631,670p' pose-mcp/internal/pose/git_snapshot_integrity.go; rg -n 'RawHistoryGit' pose-mcp/internal/pose/git_raw*; sed -n '1,100p' .github/workflows/ci.yml; rg -n 'SD-28db7861|SD-9fc0fe4e|SD-d29398e6' .pose/review-bundles/rvb-629ea8d310ca6c99.json; rg -n 'error|fatal|claim|undeclared|unclaimed|mismatch' /var/tmp/closeout/ac-dc.out | tail -15; pose recurrence-check --tolerant --window-days 14\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/rules/backend-go.md; sed -n '631,670p' pose-mcp/internal/pose/git_snapshot_integrity.go; rg -n 'RawHistoryGit' pose-mcp/internal/pose/git_raw*; sed -n '1,100p' .github/workflows/ci.yml; rg -n 'SD-28db7861|SD-9fc0fe4e|SD-d29398e6' .pose/review-bundles/rvb-629ea8d310ca6c99.json; rg -n 'error|fatal|claim|undeclared|unclaimed|mismatch' /var/tmp/closeout/ac-dc.out | tail -15; pose recurrence-check --tolerant --window-days 14\"","aggregated_output":"# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\nfunc gitCommand(args ...string) *exec.Cmd {\n\treturn gitCommandContext(context.Background(), args...)\n}\n\n// gitCommandContext is gitCommand under ctx. Both read raw object history: a\n// replace ref or a graft changes what a commit is, and every gate has to judge\n// the same commit (spec pose-history-readers-read-raw R1, D1).\nfunc gitCommandContext(ctx context.Context, args ...string) *exec.Cmd {\n\t// The graft file below is the null device, and Git hints at any graft file on\n\t// stderr, which a caller that reads stderr as uncertainty would take for a failure.\n\tcmd := exec.CommandContext(ctx, \"git\", append([]string{\"-c\", \"advice.graftFileDeprecated=false\"}, args...)...)\n\tenv := make([]string, 0, len(os.Environ())+2)\n\tfor _, kv := range os.Environ() {\n\t\tname, _, _ := strings.Cut(kv, \"=\")\n\t\tif !gitRedirectingEnv[name] {\n\t\t\tenv = append(env, kv)\n\t\t}\n\t}\n\tcmd.Env = append(env, \"GIT_NO_REPLACE_OBJECTS=1\", \"GIT_GRAFT_FILE=\"+os.DevNull)\n\treturn cmd\n}\n\nconst (\n\tgitEmptyTreeSHA1   = \"4b825dc642cb6eb9a060e54bf8d69288fbee4904\"\n\tgitEmptyTreeSHA256 = \"6ef19b41225c5369f1c104d45d8d85efa9b057b53b14b4b9b939dd74decc5321\"\n)\n\n// GitEmptyTree is the empty tree in commit's object format: the base of a change\n// set that starts at a repository's first commit (spec\n// pose-history-readers-read-raw R2, D2).\nfunc GitEmptyTree(commit string) string {\n\tif len(commit) == len(gitEmptyTreeSHA256) {\n\t\treturn gitEmptyTreeSHA256\n\t}\n\treturn gitEmptyTreeSHA1\n}\n\n// IsGitEmptyTree says that revision is the base of such a change set.\nfunc IsGitEmptyTree(revision string) bool {\n\treturn revision == gitEmptyTreeSHA1 || revision == gitEmptyTreeSHA256\nrg: pose-mcp/internal/pose/git_raw*: IO error for operation on pose-mcp/internal/pose/git_raw*: No such file or directory (os error 2)\nname: CI\non:\n  pull_request:\n  workflow_dispatch:\n  push:\n    branches: [main]\n  # The release job runs this whole workflow at the tagged commit and needs it\n  # green (spec release-runs-the-ci-gates).\n  workflow_call:\npermissions: { contents: read }\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      # fetch-depth: 0 is load-bearing here too. The cross-version test builds\n      # the previous release from its own tag with `git archive`, and a shallow\n      # checkout has no tag objects — the test would skip, silently, on the one\n      # runner where it matters (spec pose-release-boundary-rehearsal).\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with: { fetch-depth: 0 }\n      # Governance reads ask Git for the last commit that touched each\n      # artifact; on the full history each lookup walks it. The commit-graph\n      # with changed-path filters answers from the filters (47 ms -> 2 ms a\n      # lookup; spec pose-doctor-recommends-the-commit-graph).\n      - name: Write the Git commit-graph with changed-path filters\n        run: git commit-graph write --reachable --changed-paths\n      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n        with: { go-version: \"1.26.10\", cache: true, cache-dependency-path: pose-mcp/go.mod }\n      - name: Go tests (engine drift guard included)\n        # The variable says this checkout carries the release history the\n        # cross-version test needs — the promise the fetch-depth above keeps.\n        # Declared rather than inferred from the provider, so a provider that\n        # sets fewer variables cannot turn that test's failure into a silent\n        # skip (spec pose-the-guard-signal-is-declared-not-inherited).\n        env: { POSE_RELEASE_HISTORY_AVAILABLE: \"true\" }\n        run: go -C pose-mcp test ./... -count=1\n      - name: Shellcheck\n        # Covers every shipped or executed script, not just the installer.\n        # tests/release/ was outside this list until v0.20.2, and three\n        # consecutive releases failed on defects there — two of them SC2154,\n        # a variable referenced but never assigned, which aborts under set -u\n        # after the expensive gates have already run\n        # (spec pose-shellcheck-ci-gate).\n        run: |\n          sudo apt-get update -qq && sudo apt-get install -y -qq shellcheck\n          shellcheck --severity=warning \\\n            install.sh \\\n            scripts/*.sh \\\n            tests/*.sh \\\n            tests/*/*.sh \\\n            examples/demo/*.sh\n      # The scripts below build binaries and fixtures under TMPDIR; this keeps\n      # each of them removing what it creates (spec\n      # pose-test-scripts-remove-their-temp-files).\n      - name: Test scripts remove their temporary files (spec pose-test-scripts-remove-their-temp-files)\n        run: bash tests/hygiene/temp-cleanup.sh\n      - name: Installer E2E\n        run: bash tests/install/run.sh\n      - name: Artifact-identity gate rejects what it must (spec pose-release-signing R3)\n        run: bash tests/release/verify-negative.sh\n      # The migration guides make specific claims about what transfers and what\n      # does not, and those claims are what users act on. A guide that drifts\n      # from the importer is worse than none — it produces confident wrong\n      # expectations (spec pose-sdd-migration-acquisition).\n      - name: Documented migration paths still hold (spec pose-sdd-migration-acquisition)\n        run: bash tests/import/migration-guides.sh\n      # The quickstart shows the output of each step so a reader can tell\n      # whether their run diverged. That only holds while the shown output is\n      # the real one, and two of the steps depend on a gate *failing*\n      # (spec pose-first-governed-loop-quickstart).\n      - name: Quickstart loop behaves as documented (specs pose-first-governed-loop-quickstart, pose-quickstart-real-lifecycle)\n        run: bash tests/quickstart/first-governed-loop.sh\n      # A fresh install and an instance installed by the latest published\n      # release, then updated, are the two ways a project meets this engine;\n      # each must read clean and ask before adopting anything\n      # (spec pose-install-and-upgrade-journeys).\n      - name: Install and upgrade journeys hold (spec pose-install-and-upgrade-journeys)\n        env:\n          # Authenticated release listing: anonymous API calls share the\n          # runner's per-IP limit (spec pose-ci-avoids-anonymous-rate-limits).\n          GITHUB_TOKEN: ${{ github.token }}\n        run: bash tests/journeys/install-and-upgrade.sh\n      # The launch demo's whole argument is that every conventional check is\n      # green and the delivery still cannot close. If the scenario ever goes\n      # all-green, the recording made from it argues the opposite of the\n      # product (spec pose-launch-proof-demo).\n      - name: Launch demo scenario still blocks then closes (spec pose-launch-proof-demo)\n        run: bash examples/demo/record.sh --verify\n      - name: Pull Docker Hub images through a mirror\n        # Anonymous Docker Hub pulls hit a per-IP limit on hosted runners (429).\n        # Every base image is pinned by digest, so the mirror serves the same\n        # bytes (spec pose-ci-avoids-anonymous-rate-limits).\n        run: |\n          echo '{\"registry-mirrors\":[\"https://mirror.gcr.io\"]}' | sudo tee /etc/docker/daemon.json >/dev/null\n          sudo systemctl restart docker\n          docker info --format '{{json .RegistryConfig.Mirrors}}'\n      - name: Delivery images build and start\n        # pose-mcp/Dockerfile and mcp-enforce/Dockerfile are composed in\n        # production by the harne8 monorepo and were built by nothing here, so a\n        # broken Dockerfile surfaced when that stack came up. The contexts match\nrg: .pose/review-bundles/rvb-629ea8d310ca6c99.json: IO error for operation on .pose/review-bundles/rvb-629ea8d310ca6c99.json: No such file or directory (os error 2)\n2910:    fix: backfill an explicit claim or add an exact reviewed exclusion\n2912:    governed tracked path has no spec provenance claim\n2913:    fix: backfill an explicit claim or add an exact reviewed exclusion\n2915:    governed tracked path has no spec provenance claim\n2916:    fix: backfill an explicit claim or add an exact reviewed exclusion\n2918:    governed tracked path has no spec provenance claim\n2919:    fix: backfill an explicit claim or add an exact reviewed exclusion\n2921:    governed tracked path has no spec provenance claim\n2922:    fix: backfill an explicit claim or add an exact reviewed exclusion\n2924:    governed tracked path has no spec provenance claim\n2925:    fix: backfill an explicit claim or add an exact reviewed exclusion\n2927:    governed tracked path has no spec provenance claim\n2928:    fix: backfill an explicit claim or add an exact reviewed exclusion\n2930:    governed tracked path has no spec provenance claim\n2931:    fix: backfill an explicit claim or add an exact reviewed exclusion\nrecurrence.flapping_keys=0\nrecurrence.resolved_clusters=0\nrecurrence.window_days=14\nrecurrence.threshold=3\nrecurrence.records_scanned=432\nrecurrence.flagged_keys=0\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\nimport subprocess,os,json\nE=dict(os.environ,GIT_NO_LAZY_FETCH='1',GIT_TRACE2_EVENT='1',GIT_LITERAL_PATHSPECS='1',LC_ALL='C')\np=subprocess.run(['git','log','-1','--format=%H','--name-only'],capture_output=True,text=True,env=E)\nprint('HEAD files:',p.stdout[:2000])\npaths=[s for s in p.stdout.splitlines()[1:] if s]\npaths+=['AGENTS.md']\nfor path in paths[:8]:\n p=subprocess.run(['git','log','-1','--format=%H','--',path],capture_output=True,text=True,env=E)\n print(path,'bloom:',[l for l in p.stderr.splitlines() if '\\\"bloom\\\"' in l], 'exit:',p.returncode)\nprint(subprocess.run(['git','--version'],capture_output=True,text=True).stdout)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
