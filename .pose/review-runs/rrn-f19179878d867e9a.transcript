rsededBy = \"\", \"\", \"\", \"\"\n  1681\t\tif !reflect.DeepEqual(a, b) {\n  1682\t\t\treturn \"the record of the run differs from the copy that is being consulted\"\n  1683\t\t}\n  1684\t\tif why := s.reviewRunTranscriptIntact(*persisted); why != \"\" {\n  1685\t\t\treturn why\n  1686\t\t}\n  1687\t\tbundle, err := s.LoadReviewBundle(run.BundleID)\n  1688\t\tif err != nil {\n  1689\t\t\treturn \"the bundle of the run can no longer be read: \" + err.Error()\n  1690\t\t}\n  1691\t\t// The record says what it reviewed; what it says must be what the bundle is.\n  1692\t\tif run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.SealedCommit != bundle.Payload.Subject.Head {\n  1693\t\t\treturn \"the run record does not describe the bundle it names (bundle digest, scope or sealed commit differ)\"\n  1694\t\t}\n  1695\t\treturn \"\"\n  1696\t}\n  1697\t\npose-mcp/internal/pose/review_rounds.go-355-\tRound       int\npose-mcp/internal/pose/review_rounds.go-356-\tSeverity    string\npose-mcp/internal/pose/review_rounds.go-357-\tDisposition string\npose-mcp/internal/pose/review_rounds.go-358-\tFile        string\npose-mcp/internal/pose/review_rounds.go-359-\tLine        int\npose-mcp/internal/pose/review_rounds.go-360-\tSummary     string\npose-mcp/internal/pose/review_rounds.go-361-\tCarried     string\npose-mcp/internal/pose/review_rounds.go-362-}\npose-mcp/internal/pose/review_rounds.go-363-\npose-mcp/internal/pose/review_rounds.go-364-// ReviewRound is the round a bundle is in and what it must account for.\npose-mcp/internal/pose/review_rounds.go:365:type ReviewRound struct {\npose-mcp/internal/pose/review_rounds.go-366-\tNumber int\npose-mcp/internal/pose/review_rounds.go-367-\t// Prior is the run that concluded the round before, nil in round 1.\npose-mcp/internal/pose/review_rounds.go-368-\tPrior       *ReviewRun\npose-mcp/internal/pose/review_rounds.go-369-\tPriorBundle *ReviewBundle\npose-mcp/internal/pose/review_rounds.go-370-\t// O