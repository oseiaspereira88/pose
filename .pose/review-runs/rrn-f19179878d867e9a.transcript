tore.\n   274\tfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n   275\t\tfiles := s.fsys()\n   276\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n   277\t\t// The storage is read where the writer writes it: a link in its place is another place.\n   278\t\tif info, lerr := files.Lstat(dir); lerr == nil {\n   279\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n   280\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n   281\t\t\t}\n   282\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   283\t\t\treturn nil, nil, lerr\n   284\t\t}\n   285\t\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n   286\t\tif errors.Is(err, os.ErrNotExist) {\n   287\t\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n   288\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n   289\t\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   290\t\t\t\treturn nil, nil, lerr\n   291\t\t\t}\n   292\t\t\treturn []ReviewRun{}, nil, nil\n   293\t\t}\n   294\t\tif err != nil {\n   295\t\t\treturn nil, nil, err\n   296\t\t}\n   297\t\tout := []ReviewRun{}\n   298\t\tvar lost []string\n   299\t\treadBudget := int64(32 << 20)\n   300\t\tfor _, e := range entries {\n  1526\t// beforeAttemptPublished runs between the active marker and the reservation;\n  1527\t// tests use it to stop a dispatch there.\n  1528\tvar beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {}\n  1529\t\n  1530\tfunc (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\n  1531\t\t// Identity covers only persisted content, never fields derived by a reader\n  1532\t\t// or a previous write of a copied record.\n  1533\t\trun.RunID, run.Path, run.TranscriptPath, run.SupersededBy = \"\", \"\", \"\", \"\"\n  1534\t\trun.LedgerVersion = 1\n  1535\t\tsum := sha256.Sum256(transcript)\n  1536\t\trun.TranscriptDigest = \"sha256:\" + hex.EncodeToString(sum[:])\n  1537\t\tvar events []byte\n  1538\t\trun.EventsDigest = \"\"\n  1539\t\tif run.Events != \"\" {\n  1540\t\t\tevents = run.eventsBytes\n  1541\t\t\trun.EventsDigest = digestBytes(events)\n  1542\t\t}\n  1543\t\trun.eventsBytes = nil // never part of the record or of a copy compared with it\n  1544\t\tidentity, _ := json.Marshal(run)\n  1545\t\tidSum := sha256.Sum256(identity)\n  1546\t\trun.RunID = \"rrn-\" + hex.EncodeToString(idSum[:])[:16]\n  1547\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, reviewRunsDir, true)\n  1548\t\tif err != nil {\n  1549\t\t\treturn ReviewRun{}, err\n  1550\t\t}\n  1551\t\trun.TranscriptPath = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\"))\n  1552\t\tpretty, err := json.MarshalIndent(run, \"\", \"  \")\n  1553\t\tif err != nil {\n  1554\t\t\treturn ReviewRun{}, err\n  1555\t\t}\n  1556\t\tpretty = append(pretty, '\\n')\n  1557\t\tif len(pretty) > reviewLedgerMaxBytes {\n  1558\t\t\treturn ReviewRun{}, fmt.Errorf(\"review run record exceeds %d-byte bound; nothing published\", reviewLedgerMaxBytes)\n  1559\t\t}\n  1560\t\tif len(transcript) > reviewTranscriptMaxBytes {\n  1561\t\t\treturn ReviewRun{}, fmt.Errorf(\"review transcript exceeds %d-byte bound; nothing published\", reviewTranscriptMaxBytes)\n  1562\t\t}\n  1563\t\n  1564\t\twitness := reviewRunWitness{SchemaVersion: 1, RunID: run.RunID, BundleID: run.BundleID, Scope: run.Scope, RecordDigest: digestBytes(pretty), TranscriptDigest: run.TranscriptDigest}\n  1565\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(filepath.Join(reviewRunLedgerDir, run.RunID+\".json\")), witness); err != nil {\n  1566\t\t\treturn ReviewRun{}, err\n  1567\t\t}\n  1568\t\tif run.Safety != nil && int64(len(pretty)+len(transcript)+len(events)) > run.Safety.RetainedBytes {\n  1569\t\t\treturn ReviewRun{}, fmt.Errorf(\"retained run exceeds containment byte budget; attempt remains incomplete\")\n  1570\t\t}\n  1571\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".transcript\"), transcript, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1572\t\t\treturn ReviewRun{}, err\n  1573\t\t}\n  1574\t\tif run.EventsDigest != \"\" {\n  1575\t\t\tif err := publishDelegationEvents(dir, run.RunID, events); err != nil {\n  1576\t\t\t\treturn ReviewRun{}, err\n  1577\t\t\t}\n  1578\t\t}\n  1579\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".json\"), pretty, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1580\t\t\treturn ReviewRun{}, err\n  1581\t\t}\n  1582\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".json\"))\n  1583\t\treturn run, nil\n  1584\t}\n  1585\t\n  1586\tfunc (s Store) dispatchNoLongerGoverns(plan DispatchPlan) string {\n  1587\t\tcurrent, err := s.LoadReviewBundle(plan.Bundle.BundleID)\n  1690\t\t}\n  1691\t\t// The record says what it reviewed; what it says must be what the bundle is.\n  1692\t\tif run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.SealedCommit != bundle.Payload.Subject.Head {\n  1693\t\t\treturn \"the run record does not describe the bundle it names (bundle digest, scope or sealed commit differ)\"\n  1694\t\t}\n  1695\t\treturn \"\"\n  1696\t}\n  1697\t\n  1698\t// ReviewRunStillGoverns says why a run no longer governs its scope as the repository is now,\n  1699\t// or \"\": its record stands, Git answers, the persisted review inputs still materialize and the\n  1700\t// bundle it reviewed is still what the scope prepares.\n  1701\tfunc (s Store) ReviewRunStillGoverns(run ReviewRun) string {\n  1702\t\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n  1703\t\t\treturn why\n  1704\t\t}\n  1705\t\tif _, err := dispatchWorktreeIdentity(s.Root); err != nil {\n  1706\t\t\treturn \"origin Git identity unknown: \" + err.Error()\n  1707\t\t}\n  1708\t\tif _, err := ReadGitHead(s.Root); err != nil {\n  1709\t\t\treturn \"origin HEAD unknown: \" + err.Error()\n  1710\t\t}\n  1711\t\tbundle, err := s.LoadReviewBundle(run.BundleID)\n  1712\t\tif err != nil {\n  1713\t\t\treturn \"the bundle of the run can no longer be read: \" + err.Error()\n  1714\t\t}\n  1715\t\tif err := verifyBundleMaterialization(s.Root, bundle); err != nil {\n  1716\t\t\treturn \"persisted review inputs no longer materialize: \" + err.Error()\n  1717\t\t}\n  1718\t\treturn s.dispatchNoLongerGoverns(DispatchPlan{Bundle: bundle, Brief: ReviewBrief{Scope: run.Scope}, SealedCommit: run.SealedCommit,\n  1719\t\t\tPolicyDigest: run.PolicyDigest})\n  1720\t}\n  1721\t\n  1722\tfunc validateReviewRunRecord(name string, run ReviewRun) error {\n  1723\t\tif name != run.RunID+\".json\" {\n  1724\t\t\treturn fmt.Errorf(\"the file is not named after the run it holds\")\n  1725\t\t}\n  1726\t\tif run.LedgerVersion != 0 && run.LedgerVersion != 1 {\n  1727\t\t\treturn fmt.Errorf(\"unknown ledger version %d\", run.LedgerVersion)\n  1728\t\t}\n  1729\t\tif run.SchemaVersion != 1 {\n  1730\t\t\treturn fmt.Errorf(\"schema_version %d is not read by this engine\", run.SchemaVersion)\n  1731\t\t}\n  1732\t\tswitch run.Status {\n  1733\t\tcase ReviewRunCompleted, ReviewRunFailed, ReviewRunStale, ReviewRunInterrupted:\n  1734\t\tdefault:\n  1735\t\t\treturn fmt.Errorf(\"status %q is not a state of a run\", run.Status)\n  1736\t\t}\n  1737\t\tif err := validateContinuityRun(run); err != nil {\n  1738\t\t\treturn err\n  1739\t\t}\n  1740\t\tif run.BundleID == \"\" || run.Scope == \"\" {\n  1741\t\t\treturn fmt.Errorf(\"the bundle or scope is missing\")\n  1742\t\t}\n  1743\t\tfor _, at := range []string{run.StartedAt, run.EndedAt} {\n  1744\t\t\tif _, err := time.Parse(time.RFC3339Nano, at); err != nil {\n  1745\t\t\t\treturn fmt.Errorf(\"an instant of the run is not RFC3339: %q\", at)\n  1746\t\t\t}\n  1747\t\t}\n  1748\t\tif run.TranscriptPath != filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\")) {\n  1749\t\t\treturn fmt.Errorf(\"the transcript path is not the one the run is written with\")\n  1750\t\t}\n  1751\t\tunsealed := run\n  1752\t\tunsealed.RunID, unsealed.TranscriptPath, unsealed.SupersededBy, unsealed.Path = \"\", \"\", \"\", \"\"\n  1753\t\tidentity, _ := json.Marshal(unsealed)\n  1754\t\tsum := sha256.Sum256(identity)\n  1755\t\tif run.RunID != \"rrn-\"+hex.EncodeToString(sum[:])[:16] {\n  1756\t\t\treturn fmt.Errorf(\"the identity of the run is not derived from its content\")\n  1757\t\t}\n  1758\t\treturn nil\n  1759\t}\n  1760\t\n  1761\tconst reviewTranscriptMaxBytes = 256 << 20\n  1762\t\n  1763\tfunc (s Store) reviewRunTranscriptIntact(run ReviewRun) string {\n  1764\t\tproblem, _, err := memoizedLedgerRead(s.fsys(), \"transcript\\x00\"+filepath.Clean(s.Root)+\"\\x00\"+run.TranscriptPath+\"\\x00\"+run.TranscriptDigest, func() (string, error) {\n  1765\t\t\treturn s.checkReviewRunTranscript(run), nil\n   625\t\tSafety        *ReviewExecutionSafety `json:\"safety,omitempty\"`\n   626\t\tResumedBy     string                 `json:\"resumed_by,omitempty\"`\n   627\t\tResumes       string                 `json:\"resumes,omitempty\"`\n   628\t\tLimitOf       string                 `json:\"limit_of,omitempty\"`\n   629\t\tPartial       bool                   `json:\"partial,omitempty\"`\n   630\t\tInterruption  *ReviewInterruption    `json:\"interruption,omitempty\"`\n   631\t\tSupersededBy  string                 `json:\"superseded_by,omitempty\"`\n   632\t\tRunID         string                 `json:\"run_id\"`\n   633\t\tAttemptID     string                 `json:\"attempt_id,omitempty\"`\n   634\t\tBundleID      string                 `json:\"bundle_id\"`\n   635\t\tAdapter       string                 `json:\"adapter\"`\n   636\t\tStatus        string                 `json:\"status\"`\n   637\t\tDraftDecision string                 `json:\"draft_decision\"`\n   638\t\tReason        string                 `json:\"reason,omitempty\"`\n   639\t\tAssurance     string                 `json:\"assurance\"`\n   640\t\t// Round, Thread and DraftProblems disclose the round protocol (spec\n   641\t\t// pose-delegated-review-round-protocol R1, R4, R6).\n   642\t\tRound         int           `json:\"round,omitempty\"`\n   643\t\tThread        *ReviewThread `json:\"thread,omitempty\"`\n   644\t\tDraftProblems []string      `json:\"draft_problems,omitempty\"`\n   645\t}\n   646\t\n   647\tfunc (s Store) reviewRunSummaries(scope string) ([]ReviewRunSummary, []string) {\n   648\t\truns, lost, err := s.ReadReviewRuns(\"\")\n   649\t\tif err != nil {\n   650\t\t\tlost = append(lost, err.Error())\n   651\t\t}\n   652\t\tout := []ReviewRunSummary{}\n   653\t\tfor _, run := range runs {\n   654\t\t\tif run.Scope == scope {\n   655\t\t\t\tdecision := \"unknown\"\n   656\t\t\t\tif run.Status == ReviewRunCompleted && reviewSafetyConflict(run) == \"\" {\n   657\t\t\t\t\tdecision = draftReviewDecision(run.Output)\n   658\t\t\t\t}\n   659\t\t\t\tif len(run.DraftProblems) > 0 && decision != \"unknown\" {\n   660\t\t\t\t\tdecision = \"invalid\"\n   661\t\t\t\t}\n   662\t\t\t\tout = append(out, ReviewRunSummary{Safety: run.Safety, Resumes: run.Resumes, LimitOf: run.LimitOf, Partial: run.Status == ReviewRunInterrupted, Interruption: run.Interruption, SupersededBy: run.SupersededBy, RunID: run.RunID, AttemptID: run.AttemptID, BundleID: run.BundleID, Adapter: run.Adapter, Status: run.Status, DraftDecision: decision, Reason: run.Reason, Assurance: \"declared-draft-not-attestation\", Round: run.Round, Thread: run.Thread, DraftProblems: run.DraftProblems})\n   663\t\t\t}\n   664\t\t}\n   665\t\tattempts, losses := s.allDelegatedReviewAttempts()\n   666\t\tlost = append(lost, losses...)\n   667\t\treceiptBudget := int64(32 << 20)\n   668\t\tfor _, a := range attempts {\n   669\t\t\tif a.Scope == scope {\n   670\t\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   671\t\t\t\t\tlost = append(lost, err.Error())\n   672\t\t\t\t}\n   673\t\t\t}\n   674\t\t}\n   675\t\treturn out, uniqueSorted(lost)\n   676\t}\n   677\t\n   678\ttype DelegatedReviewMetric struct {\n   679\t\tResumes         int    `json:\"resumes\"`\n   680\t\tKey             string `json:\"key\"`\n   681\t\tRuns            int    `json:\"runs\"`\n   682\t\tAttempts        int    `json:\"attempts\"`\n   683\t\tApprovedDrafts  int    `json:\"approved_drafts\"`\n   684\t\tRejectingDrafts int    `json:\"rejecting_drafts\"`\n   685\t\tUnknownDrafts   int    `json:\"unknown_drafts\"`\npose-mcp/internal/pose/review_attempt_ledger.go:701:\tRounds []ReviewRoundMetric `json:\"rounds,omitempty\"`\npose-mcp/internal/pose/review_brief.go:235:\tvar round *ReviewRound\npose-mcp/internal/pose/review_brief.go:237:\t\tderived, err := s.ReviewRoundOf(bundle)\npose-mcp/internal/pose/review_brief.go:296:func renderReviewBriefBody(bundle ReviewBundle, kind, template, notes string, smoke *smokeScript, round *ReviewRound, conclusion bool, questions []AdjudicationQuestion) string {\npose-mcp/internal/pose/review_brief.go:534:func roundFields(round ReviewRound, template string) string {\n","exit_code":0,"status":"completed"}}
