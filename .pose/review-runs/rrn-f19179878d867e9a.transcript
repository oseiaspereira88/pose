iption\":\"Identify material assumptions and their applicable evidence; distinguish verified facts, unresolved assumptions and accepted risks.\",\"required\":true,\"kind\":\"judgment\",\"profiles\":[\"engineering-judgment@1\",\"high-criticality-review@1\"]},{\"id\":\"backend-concurrency\",\"description\":\"Concurrent access, cancellation and lifecycle behavior are safe where applicable.\",\"required\":true,\"kind\":\"mechanical\",\"rules\":[\"backend-go\"],\"evidence_classes\":[\"e2e\",\"integration\",\"unit\"],\"profiles\":[\"backend-review@1\"]},{\"id\":\"backend-contracts\",\"description\":\"Public API, event, file and tool contracts remain compatible or explicitly migrated.\",\"required\":true,\"kind\":\"mechanical\",\"rules\":[\"backend-go\"],\"evidence_classes\":[\"e2e\",\"integration\"],\"profiles\":[\"backend-review@1\"]},{\"id\":\"backend-input-errors\",\"description\":\"Inputs, validation failures and error paths are bounded, typed and actionable.\",\"required\":true,\"kind\":\"mechanical\",\"rules\":[\"backend-go\",\"security\"],\"evidence_classes\":[\"e2e\",\"integration\",\"unit\"],\"profiles\":[\"backend-review@1\"]},{\"id\":\"backend-integration-impact\",\"description\":\"Providers, consumers and inter-component boundaries remain integrated.\",\"required\":true,\"kind\":\"mechanical\",\"evidence_classes\":[\"integration\"],\"profiles\":[\"backend-review@1\"]},{\"id\":\"backend-observability\",\"description\":\"Failures are diagnosable through bounded, non-sensitive logs, metrics or returned context.\",\"required\":true,\"kind\":\"mechanical\",\"rules\":[\"backend-go\",\"security\"],\"evidence_classes\":[\"integration\",\"unit\"],\"profiles\":[\"backend-review@1\"]},{\"id\":\"compatibility\",\"description\":\"Public CLI, file and MCP contracts are compatible or explicitly migrated.\",\"required\":true,\"kind\":\"judgment\",\"profiles\":[\"spec-closeout@1\"]},{\"id\":\"correctness\",\"description\":\"Functional and negative behavior is correct.\",\"required\":true,\"kind\":\"mechanical\",\"evidence_classes\":[\"build\",\"e2e\",\"integration\",\"unit\"],\"profiles\":[\"spec-closeout@1\"]},{\"id\":\"design-causality\",\"description\":\"Explain how the selected design addresses the stated requirement and material cause, citing the relevant decision basis and structural observations where available.\",\"required\":true,\"kind\":\"judgment\",\"profiles\":[\"engineering-judgment@1\",\"high-criticality-review@1\"]},{\"id\":\"documentation\",\"description\":\"Operational docs, templates and scaffold match runtime behavior.\",\"required\":true,\"kind\":\"judgment\",\"rules\":[\"documentation-style\"],\"profiles\":[\"spec-closeout@1\"]},{\"id\":\"operability\",\"description\":\"Errors, explanations and remediation are actionable.\",\"required\":true,\"kind\":\"judgment\",\"profiles\":[\"spec-closeout@1\"]},{\"id\":\"requirements\",\"description\":\"Every requirement has current, relevant evidence.\",\"required\":true,\"kind\":\"mechanical\",\"evidence_classes\":[\"e2e\",\"integration\",\"unit\"],\"profiles\":[\"spec-closeout@1\"]},{\"id\":\"scope\",\"description\":\"The implementation matches the approved spec scope.\",\"required\":true,\"kind\":\"judgment\",\"rules\":[\"documentation-style\"],\"profiles\":[\"spec-closeout@1\"]},{\"id\":\"security\",\"description\":\"Inputs, paths, evidence and authority boundaries are safe.\",\"required\":true,\"kind\":\"judgment\",\"rules\":[\"security\"],\"profiles\":[\"spec-closeout@1\"]},{\"id\":\"solution-proportionality\",\"description\":\"Compare the solution with the smallest sufficient alternative, including negative space, speculative extensibility and the condition that would invalidate the choice.\",\"required\":true,\"kind\":\"judgment\",\"profiles\":[\"engineering-judgment@1\",\"high-criticality-review@1\"]}],\"tools\":[{\"id\":\"artifact-check\",\"requiredness\":\"required\",\"args\":[\"pose\",\"artifact-check\",\"--spec\",\"pose-review-run-reaps-lingering-reviewer-processes\",\"--strict\"],\"rationale\":\"reconcile declared artifacts with Git-observed provenance\",\"criteria\":[\"requirements\",\"scope\"],\"preconditions\":[\"artifacts-attributed\"]},{\"id\":\"assess-design\",\"requiredness\":\"recommended\",\"args\":[\"pose\",\"assess\",\"design\",\"--spec\",\"pose-review-run-reaps-lingering-reviewer-processes\",\"--json\"],\"rationale\":\"observe bounded structural deltas on the canonical review subject\",\"evidence_classes\":[\"structure\"],\"preconditions\":[\"scope-authorized\"]},{\"id\":\"assess-discover\",\"requiredness\":\"recommended\",\"args\":[\"pose\",\"assess\",\"discover\",\"--no-persist\",\"--component\",\"pose-mcp\"],\"rationale\":\"inspect component structure, language, size and visible debt\",\"component\":\"pose-mcp\",\"preconditions\":[\"scope-authorized\"]},{\"id\":\"assess-integrate\",\"requiredness\":\"recommended\",\"args\":[\"pose\",\"assess\",\"integrate\",\"--no-persist\"],\"rationale\":\"inspect providers, consumers and inter-component contract gaps\",\"evidence_classes\":[\"integration\"],\"criteria\":[\"backend-contracts\",\"backend-integration-impact\"],\"preconditions\":[\"scope-authorized\"]},{\"id\":\"assess-tech-debt\",\"requiredness\":\"recommended\",\"args\":[\"pose\",\"assess\",\"tech-debt\",\"--no-persist\"],\"rationale\":\"inspect unresolved TODO, FIXME, panic and stub findings\",\"criteria\":[\"correctness\"],\"preconditions\":[\"scope-authorized\"]},{\"id\":\"closeout-check\",\"requiredness\":\"required\",\"args\":[\"pose\",\"closeout-check\",\"spec:pose-review-run-reaps-lingering-reviewer-processes\"],\"rationale\":\"verify remaining hierarchical closeout blockers\",\"preconditions\":[\"review-complete\"]},{\"id\":\"review-check\",\"requiredness\":\"required\",\"args\":[\"pose\",\"review-check\",\"spec:pose-review-run-reaps-lingering-reviewer-processes\"],\"rationale\":\"verify exact review-plan coverage and freshness\",\"preconditions\":[\"review-complete\"]},{\"id\":\"suggest-review\",\"req