{"type":"item.completed","item":{"id":"item_76","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '1,250p'; nl -ba pose-mcp/internal/pose/delegation_active.go | sed -n '60,130p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"os\"\n    28\t\t\"path/filepath\"\n    29\t\t\"strings\"\n    30\t\t\"time\"\n    31\t)\n    32\t\n    33\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    34\t// proven abandoned.\n    35\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    36\t\n    37\t// reviewOrphanReservationAge is how old a reservation without any marker\n    38\t// must be to count as abandoned.\n    39\tconst reviewOrphanReservationAge = 10 * time.Minute\n    40\t\n    41\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    42\t// dispatch ended before recording it, and removes its stalled marker. A\n    43\t// stalled marker whose reservation was never published is only removed; the\n    44\t// returned run is then empty.\n    45\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    46\t\tif !validAttemptFileName(attemptID) {\n    47\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    48\t\t}\n    49\t\tmarkers, _, err := s.ListDelegationActive()\n    50\t\tif err != nil {\n    51\t\t\treturn ReviewRun{}, err\n    52\t\t}\n    53\t\tvar marker *DelegationActiveRun\n    54\t\tfor i := range markers {\n    55\t\t\tif markers[i].AttemptID == attemptID {\n    56\t\t\t\tmarker = &markers[i]\n    57\t\t\t}\n    58\t\t}\n    59\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    60\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    61\t\t}\n    62\t\tdir, err := s.delegationActiveDir(true)\n    63\t\tif err != nil {\n    64\t\t\treturn ReviewRun{}, err\n    65\t\t}\n    66\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    67\t\tif err != nil {\n    68\t\t\treturn ReviewRun{}, err\n    69\t\t}\n    70\t\tdefer lock.Close()\n    71\t\tunlock, err := lockSpecTransferFile(lock)\n    72\t\tif err != nil {\n    73\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    74\t\t}\n    75\t\tdefer unlock()\n    76\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    77\t}\n    78\t\n    79\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    80\t\tvar reserved *DelegatedReviewAttempt\n    81\t\tif marker != nil {\n    82\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    83\t\t\tif err != nil {\n    84\t\t\t\treturn ReviewRun{}, err\n    85\t\t\t}\n    86\t\t\tfor i := range attempts {\n    87\t\t\t\tif attempts[i].AttemptID == attemptID {\n    88\t\t\t\t\treserved = &attempts[i]\n    89\t\t\t\t}\n    90\t\t\t}\n    91\t\t\tif reserved == nil {\n    92\t\t\t\t// The dispatch ended between its marker and its reservation:\n    93\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    94\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    95\t\t\t}\n    96\t\t} else {\n    97\t\t\tif !operatorConfirmed {\n    98\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n    99\t\t\t}\n   100\t\t\torphans, _, err := s.orphanReservations(now)\n   101\t\t\tif err != nil {\n   102\t\t\t\treturn ReviewRun{}, err\n   103\t\t\t}\n   104\t\t\tfor i := range orphans {\n   105\t\t\t\tif orphans[i].AttemptID == attemptID {\n   106\t\t\t\t\treserved = &orphans[i]\n   107\t\t\t\t}\n   108\t\t\t}\n   109\t\t\tif reserved == nil {\n   110\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   111\t\t\t}\n   112\t\t}\n   113\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   114\t\t\t// A release that stopped after the receipt completes by removing\n   115\t\t\t// the stalled marker; with no marker there is nothing to release.\n   116\t\t\tif marker != nil {\n   117\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   118\t\t\t\tif err != nil {\n   119\t\t\t\t\treturn ReviewRun{}, err\n   120\t\t\t\t}\n   121\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   122\t\t\t\tif err != nil {\n   123\t\t\t\t\treturn ReviewRun{}, err\n   124\t\t\t\t}\n   125\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   126\t\t\t}\n   127\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   128\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   129\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   130\t\t}\n   131\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   132\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   133\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   134\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   135\t\tif marker != nil {\n   136\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   137\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   138\t\t} else {\n   139\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   140\t\t}\n   141\t\t// A run the attempt already recorded, by its dispatch or by a release\n   142\t\t// interrupted before the receipt, completes the attempt; no second run\n   143\t\t// is written for it.\n   144\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   145\t\tif err != nil {\n   146\t\t\treturn ReviewRun{}, err\n   147\t\t}\n   148\t\tif !found {\n   149\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   150\t\t\t\treturn ReviewRun{}, err\n   151\t\t\t}\n   152\t\t}\n   153\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   154\t\t\treturn recorded, err\n   155\t\t}\n   156\t\tif marker != nil {\n   157\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   158\t\t}\n   159\t\treturn recorded, nil\n   160\t}\n   161\t\n   162\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   163\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   164\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   165\t\tif err != nil {\n   166\t\t\treturn ReviewRun{}, false, err\n   167\t\t}\n   168\t\tif len(lost) > 0 {\n   169\t\t\t// An unreadable run may be this release's: the history is unknown,\n   170\t\t\t// and the release does not write another (review round 4, N3).\n   171\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   172\t\t}\n   173\t\tvar latest *ReviewRun\n   174\t\tfor i := range runs {\n   175\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   176\t\t\t\tlatest = &runs[i]\n   177\t\t\t}\n   178\t\t}\n   179\t\tif latest == nil {\n   180\t\t\treturn ReviewRun{}, false, nil\n   181\t\t}\n   182\t\treturn *latest, true, nil\n   183\t}\n   184\t\n   185\t// orphanReservations lists the reservations left without a receipt or a\n   186\t// marker, older than reviewOrphanReservationAge, and\n   187\t// says which reservations or receipts it could not read (review round 3, N3).\n   188\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   189\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   190\t\tdirs, err := os.ReadDir(base)\n   191\t\tif errors.Is(err, os.ErrNotExist) {\n   192\t\t\treturn nil, nil, nil\n   193\t\t}\n   194\t\tif err != nil {\n   195\t\t\treturn nil, nil, err\n   196\t\t}\n   197\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   198\t\tif err != nil {\n   199\t\t\treturn nil, nil, err\n   200\t\t}\n   201\t\tif len(markerLost) > 0 {\n   202\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   203\t\t\t// have no marker (review round 6, N1).\n   204\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   205\t\t}\n   206\t\tmarked := map[string]bool{}\n   207\t\tfor _, m := range markers {\n   208\t\t\tmarked[m.AttemptID] = true\n   209\t\t}\n   210\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   211\t\tif err != nil {\n   212\t\t\treturn nil, nil, err\n   213\t\t}\n   214\t\tif len(runLost) > 0 {\n   215\t\t\t// Without the whole run history nothing is known to have no run.\n   216\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   217\t\t}\n   218\t\t// A recorded run does not finish an attempt, its receipt does: a\n   219\t\t// reservation whose run was recorded without a receipt still blocks and\n   220\t\t// is released with that run (review round 5, N3).\n   221\t\t_ = runs\n   222\t\tvar out []DelegatedReviewAttempt\n   223\t\tvar lost []string\n   224\t\tbudget := reviewReadBudget(nil)\n   225\t\tfor _, d := range dirs {\n   226\t\t\tif !d.IsDir() {\n   227\t\t\t\tcontinue\n   228\t\t\t}\n   229\t\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n   230\t\t\tif err != nil {\n   231\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   232\t\t\t\tcontinue\n   233\t\t\t}\n   234\t\t\tfor _, e := range entries {\n   235\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   236\t\t\t\t\tcontinue\n   237\t\t\t\t}\n   238\t\t\t\tvar a DelegatedReviewAttempt\n   239\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   240\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   241\t\t\t\t\tcontinue\n   242\t\t\t\t}\n   243\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif marked[a.AttemptID] {\n   248\t\t\t\t\tcontinue\n   249\t\t\t\t}\n   250\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n    60\t\t// pose-delegated-review-round-protocol R1).\n    61\t\tRound int `json:\"round,omitempty\"`\n    62\t}\n    63\t\n    64\tfunc (s Store) delegationActiveDir(create bool) (string, error) {\n    65\t\tif create {\n    66\t\t\tif _, err := ensureReviewArtifactDir(s.Root, reviewPrivateDir, true); err != nil {\n    67\t\t\t\treturn \"\", err\n    68\t\t\t}\n    69\t\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewPrivateDir))\n    70\t\t\tignore := filepath.Join(dir, \".gitignore\")\n    71\t\t\tif _, err := os.Lstat(ignore); errors.Is(err, os.ErrNotExist) {\n    72\t\t\t\tif err := PublishFile(ignore, []byte(\"*\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil && !errors.Is(err, os.ErrExist) {\n    73\t\t\t\t\treturn \"\", err\n    74\t\t\t\t}\n    75\t\t\t}\n    76\t\t}\n    77\t\treturn ensureReviewArtifactDir(s.Root, delegationActiveDir, create)\n    78\t}\n    79\t\n    80\tfunc validAttemptFileName(attempt string) bool {\n    81\t\treturn attempt != \"\" && len(attempt) <= 128 && !strings.ContainsAny(attempt, `/\\.`+\"\\x00\")\n    82\t}\n    83\t\n    84\t// markDelegationActive writes the marker and starts the cancellation watcher.\n    85\t// The returned stop removes both; cancelled reports whether a cancellation\n    86\t// request stopped the run.\n    87\t//\n    88\t// stop(true) stops the watcher and the heartbeat but keeps the marker: a run\n    89\t// whose record was not published leaves it, and it turns stalled once its\n    90\t// process is gone (spec pose-delegated-review-completion-signal R4, R5).\n    91\tfunc (s Store) markDelegationActive(run ReviewRun, cancel context.CancelFunc) (stop func(keepMarker ...bool), cancelled *atomic.Bool, err error) {\n    92\t\tcancelled = &atomic.Bool{}\n    93\t\tif !validAttemptFileName(run.AttemptID) {\n    94\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: attempt %q cannot name an active marker\", run.AttemptID)\n    95\t\t}\n    96\t\tdir, err := s.delegationActiveDir(true)\n    97\t\tif err != nil {\n    98\t\t\treturn func(...bool) {}, cancelled, err\n    99\t\t}\n   100\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + run.AttemptID, Worktree: s.Root, Operation: \"pose delegate \" + run.Purpose, PID: os.Getpid(), AcquiredAt: run.StartedAt}\n   101\t\towner.Host, _ = os.Hostname()\n   102\t\tidentifyStartLockProcess(&owner)\n   103\t\ttoken := make([]byte, 16)\n   104\t\tif _, err := rand.Read(token); err != nil {\n   105\t\t\treturn func(...bool) {}, cancelled, err\n   106\t\t}\n   107\t\tevery := delegationHeartbeatEvery\n   108\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: run.AttemptID, RunToken: hex.EncodeToString(token), Resumes: run.Resumes, Label: run.Label, Purpose: run.Purpose, Agent: run.Adapter, Scope: run.Scope, BundleID: run.BundleID, StartedAt: run.StartedAt, Owner: owner, Round: run.Round,\n   109\t\t\tHeartbeatAt: time.Now().UTC().Format(time.RFC3339Nano), HeartbeatEvery: int(every / time.Second)}\n   110\t\traw, _ := json.MarshalIndent(marker, \"\", \"  \")\n   111\t\tpath := filepath.Join(dir, run.AttemptID+\".json\")\n   112\t\trequest := cancelRequestPath(dir, marker)\n   113\t\tif err := PublishFile(path, append(raw, '\\n'), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n   114\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: another run of attempt %s is active: %w\", run.AttemptID, err)\n   115\t\t}\n   116\t\tdone, exited := make(chan struct{}), make(chan struct{})\n   117\t\tgo func() {\n   118\t\t\tdefer close(exited)\n   119\t\t\tticker := time.NewTicker(250 * time.Millisecond)\n   120\t\t\tdefer ticker.Stop()\n   121\t\t\theartbeat := time.NewTicker(every)\n   122\t\t\tdefer heartbeat.Stop()\n   123\t\t\tfor {\n   124\t\t\t\tselect {\n   125\t\t\t\tcase <-done:\n   126\t\t\t\t\treturn\n   127\t\t\t\tcase <-heartbeat.C:\n   128\t\t\t\t\t// Select picks among ready cases at random: once stop has\n   129\t\t\t\t\t// asked, no further heartbeat starts, so it waits for at\n   130\t\t\t\t\t// most the one in flight (review round 1, HB01).\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_77","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '930,1100p'; nl -ba pose-mcp/internal/pose/review_dispatch_unix.go | sed -n '1,80p'\"","aggregated_output":"   930\t\toutputFile := filepath.Join(tmp, \"output.txt\")\n   931\t\tcommand := plan.Config.Command\n   932\t\tif plan.predecessor != nil && !plan.handoff || plan.thread.continued() {\n   933\t\t\tcommand = plan.Config.Resume.Command\n   934\t\t}\n   935\t\targv := ReviewerArgv(command, outputFile, plan.session, plan.Effort, plan.Config.Effort)\n   936\t\ttimeout := time.Duration(safety.TimeoutMS) * time.Millisecond\n   937\t\texecPath := argv[0]\n   938\t\tif run.Provenance != nil {\n   939\t\t\tcopy := *run.Provenance\n   940\t\t\trun.Provenance = &copy\n   941\t\t\tselected, resolved, err := provenanceExecutableSelection(argv[0], worktree)\n   942\t\t\tif err != nil {\n   943\t\t\t\treturn finish(ReviewRunFailed, \"provenance executable could not be resolved\")\n   944\t\t\t}\n   945\t\t\tdigest, err := reviewExecutableDigest(resolved)\n   946\t\t\tif err != nil {\n   947\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n   948\t\t\t}\n   949\t\t\trun.Provenance.ExecutableDigest = digest\n   950\t\t\texecPath = selected\n   951\t\t\traw, _ := json.Marshal(argv)\n   952\t\t\trun.Provenance.ArgvDigest = digestBytes(raw)\n   953\t\t}\n   954\t\tif plan.processTimeout > 0 {\n   955\t\t\tstarted, err := time.Parse(time.RFC3339Nano, run.StartedAt)\n   956\t\t\tif err != nil {\n   957\t\t\t\treturn finish(ReviewRunFailed, \"invalid execution start\")\n   958\t\t\t}\n   959\t\t\tsetup := now().Sub(started)\n   960\t\t\tremaining := plan.processTimeout - setup\n   961\t\t\tif setup < 0 || remaining <= 0 {\n   962\t\t\t\treturn finish(ReviewRunFailed, \"accumulated wall-clock budget spent before adapter launch\")\n   963\t\t\t}\n   964\t\t\tif remaining < timeout {\n   965\t\t\t\ttimeout = remaining\n   966\t\t\t}\n   967\t\t}\n   968\t\tctx, cancel := context.WithTimeout(parent, timeout)\n   969\t\tdefer cancel()\n   970\t\tcmd := exec.CommandContext(ctx, execPath, argv[1:]...)\n   971\t\tcmd.Args[0] = argv[0]\n   972\t\t// The adapter runs under the review run shim, which ends what the run\n   973\t\t// leaves in its subtree (review_shim.go).\n   974\t\tshimReport := \"\"\n   975\t\tif ReviewShimAvailable && runtime.GOOS == \"linux\" && cmd.Err == nil {\n   976\t\t\t// The adapter's path as resolved here, in the dispatcher's PATH.\n   977\t\t\tif self, err := os.Executable(); err == nil {\n   978\t\t\t\tshimReport = filepath.Join(tmp, \"pose-review-shim-report.json\")\n   979\t\t\t\tcmd = exec.CommandContext(ctx, self, append([]string{ReviewShimArg, cmd.Path}, argv...)...)\n   980\t\t\t}\n   981\t\t}\n   982\t\tcmd.Dir = worktree\n   983\t\tcmd.Stdin = strings.NewReader(plan.Brief.Text)\n   984\t\tenv, secrets, err := reviewAdapterEnvironment(plan.Config, tmp, plan.Brief.Text, plan.notes)\n   985\t\tif err != nil {\n   986\t\t\trun.BriefNotes = \"\"\n   987\t\t\treturn finish(ReviewRunFailed, err.Error())\n   988\t\t}\n   989\t\tunset := []string{}\n   990\t\tif policy, _, found, perr := s.LoadDelegationPolicy(); perr == nil && found {\n   991\t\t\tunset = policy.EnvUnset\n   992\t\t}\n   993\t\tenv, run.EnvRemoved = withoutParentSession(env, unset)\n   994\t\t// The reviewer works in a sealed checkout: diagnostics it runs must not\n   995\t\t// publish derived records into it (SealedCheckoutEnv).\n   996\t\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n   997\t\tif shimReport != \"\" {\n   998\t\t\tenv = append(env, ReviewShimReportEnv+\"=\"+shimReport)\n   999\t\t}\n  1000\t\t// The reviewer checks its draft against the sealed bundle and the round\n  1001\t\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n  1002\t\t// context that cannot be built leaves the check unavailable, never the\n  1003\t\t// review.\n  1004\t\tif plan.Purpo