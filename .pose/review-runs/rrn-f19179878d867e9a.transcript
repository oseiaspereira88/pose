{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_shim.go pose-mcp/internal/pose/review_shim_linux.go pose-mcp/internal/pose/review_reap_linux.go pose-mcp/internal/pose/review_reap_other.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// The review run shim (spec pose-review-run-reaps-lingering-reviewer-processes,\n     4\t// review rounds 6 and 8): a descendant of the reviewer that leaves the\n     5\t// adapter's process group, starts its own session and clears its environment\n     6\t// matches neither the group kill nor the sealed-checkout entry. Making the\n     7\t// dispatcher a child subreaper caught it, but a subreaper is process-wide:\n     8\t// in the dispatching process it also adopted and ended children other code\n     9\t// started there (a detached delegation), and reaped processes another\n    10\t// goroutine was waiting for. The dispatcher therefore starts the adapter\n    11\t// through a shim, the same executable re-entered with ReviewShimArg, which\n    12\t// makes itself the subreaper, runs the adapter, and, once it exits, ends\n    13\t// every process left in its subtree. The shim has no other children, so\n    14\t// everything it adopts is the run's.\n    15\t\n    16\t// ReviewShimArg is the first argument that runs the executable as a review\n    17\t// run shim instead of the CLI.\n    18\tconst ReviewShimArg = \"__pose-review-run-shim\"\n    19\t\n    20\t// ReviewShimReportEnv names the file the shim writes its report to.\n    21\tconst ReviewShimReportEnv = \"POSE_REVIEW_SHIM_REPORT\"\n    22\t\n    23\t// ReviewShimAvailable says the running executable handles ReviewShimArg. It\n    24\t// is set by the pose command and by the test binaries that dispatch; any\n    25\t// other embedder starts the adapter directly, without the shim.\n    26\tvar ReviewShimAvailable = false\n    27\t\n    28\t// reviewShimReport is what the shim found after the adapter exited.\n    29\ttype reviewShimReport struct {\n    30\t\tEnded []string `json:\"ended\"`\n    31\t\tError string   `json:\"error,omitempty\"`\n    32\t}\n    33\t//go:build linux\n    34\t\n    35\tpackage pose\n    36\t\n    37\timport (\n    38\t\t\"encoding/json\"\n    39\t\t\"errors\"\n    40\t\t\"fmt\"\n    41\t\t\"os\"\n    42\t\t\"os/exec\"\n    43\t\t\"os/signal\"\n    44\t\t\"strconv\"\n    45\t\t\"strings\"\n    46\t\t\"syscall\"\n    47\t\t\"time\"\n    48\t\n    49\t\t\"golang.org/x/sys/unix\"\n    50\t)\n    51\t\n    52\t// RunReviewShim runs args (the adapter's path, then its argv) as the shim's\n    53\t// only child, waits for it, ends every process left in the shim's subtree\n    54\t// and returns the adapter's exit status.\n    55\tfunc RunReviewShim(args []string) int {\n    56\t\tif len(args) < 2 {\n    57\t\t\tfmt.Fprintln(os.Stderr, \"pose review shim: no adapter\")\n    58\t\t\treturn 125\n    59\t\t}\n    60\t\treport := reviewShimReport{}\n    61\t\treportPath := os.Getenv(ReviewShimReportEnv)\n    62\t\t_ = os.Unsetenv(ReviewShimReportEnv)\n    63\t\twrite := func() {\n    64\t\t\tif reportPath == \"\" {\n    65\t\t\t\treturn\n    66\t\t\t}\n    67\t\t\traw, _ := json.Marshal(report)\n    68\t\t\t_ = os.WriteFile(reportPath, raw, 0o600)\n    69\t\t}\n    70\t\tif err := unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0); err != nil {\n    71\t\t\treport.Error = \"the shim could not become the subreaper of the run: \" + err.Error()\n    72\t\t\twrite()\n    73\t\t\treturn 125\n    74\t\t}\n    75\t\tcmd := &exec.Cmd{Path: args[0], Args: args[1:], Stdin: os.Stdin, Stdout: os.Stdout, Stderr: os.Stderr, Env: os.Environ()}\n    76\t\tcode := 0\n    77\t\tvar signaled syscall.Signal\n    78\t\tif err := cmd.Run(); err != nil {\n    79\t\t\tvar exit *exec.ExitError\n    80\t\t\tif !errors.As(err, &exit) {\n    81\t\t\t\treport.Error = \"the adapter could not run: \" + err.Error()\n    82\t\t\t\twrite()\n    83\t\t\t\treturn 127\n    84\t\t\t}\n    85\t\t\tif status, ok := exit.Sys().(syscall.WaitStatus); ok && status.Signaled() {\n    86\t\t\t\tsignaled, code = status.Signal(), 128+int(status.Signal())\n    87\t\t\t} else {\n    88\t\t\t\tcode = exit.ExitCode()\n    89\t\t\t}\n    90\t\t}\n    91\t\tended, err := reapShimSubtree()\n    92\t\treport.Ended = ended\n    93\t\tif err != nil {\n    94\t\t\treport.Error = err.Error()\n    95\t\t}\n    96\t\twrite()\n    97\t\t// An adapter ended by a signal is reported as ended by it: the shim ends\n    98\t\t// itself the same way, so the dispatcher reads what it would have read\n    99\t\t// without the shim.\n   100\t\tif signaled != 0 {\n   101\t\t\tsignal.Reset(signaled)\n   102\t\t\t_ = syscall.Kill(os.Getpid(), signaled)\n   103\t\t\ttime.Sleep(time.Second)\n   104\t\t}\n   105\t\treturn code\n   106\t}\n   107\t\n   108\t// reapShimSubtree ends and reaps every child of the shim, including the\n   109\t// orphans its subreaper status adopted, until none is left.\n   110\tfunc reapShimSubtree() ([]string, error) {\n   111\t\tself := os.Getpid()\n   112\t\tvar ended []string\n   113\t\tseen := map[int]bool{}\n   114\t\tdeadline := time.Now().Add(reviewReapWait)\n   115\t\tfor {\n   116\t\t\tdirs, err := os.ReadDir(\"/proc\")\n   117\t\t\tif err != nil {\n   118\t\t\t\treturn ended, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n   119\t\t\t}\n   120\t\t\tchildren := 0\n   121\t\t\tfor _, d := range dirs {\n   122\t\t\t\tpid, err := strconv.Atoi(d.Name())\n   123\t\t\t\tif err != nil || pid == self {\n   124\t\t\t\t\tcontinue\n   125\t\t\t\t}\n   126\t\t\t\tst, err := readShimProcStat(pid)\n   127\t\t\t\tif reviewProcessGoneErr(err) {\n   128\t\t\t\t\tcontinue\n   129\t\t\t\t}\n   130\t\t\t\tif err != nil {\n   131\t\t\t\t\treturn ended, fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   132\t\t\t\t}\n   133\t\t\t\tif st.ppid != self {\n   134\t\t\t\t\tcontinue\n   135\t\t\t\t}\n   136\t\t\t\tchildren++\n   137\t\t\t\tif !st.zombie {\n   138\t\t\t\t\tif !seen[pid] {\n   139\t\t\t\t\t\tseen[pid] = true\n   140\t\t\t\t\t\tended = append(ended, strconv.Itoa(pid))\n   141\t\t\t\t\t}\n   142\t\t\t\t\tif err := killPinnedChild(pid, self); err != nil {\n   143\t\t\t\t\t\treturn ended, err\n   144\t\t\t\t\t}\n   145\t\t\t\t}\n   146\t\t\t}\n   147\t\t\tfor {\n   148\t\t\t\tpid, err := unix.Wait4(-1, nil, unix.WNOHANG, nil)\n   149\t\t\t\tif pid <= 0 || err != nil {\n   150\t\t\t\t\tbreak\n   151\t\t\t\t}\n   152\t\t\t}\n   153\t\t\tif children == 0 {\n   154\t\t\t\treturn ended, nil\n   155\t\t\t}\n   156\t\t\tif time.Now().After(deadline) {\n   157\t\t\t\treturn ended, fmt.Errorf(\"%d process(es) of the run could not be ended\", children)\n   158\t\t\t}\n   159\t\t\ttime.Sleep(20 * time.Millisecond)\n   160\t\t}\n   161\t}\n   162\t\n   163\ttype shimProcStat struct {\n   164\t\tppid   int\n   165\t\tzombie bool\n   166\t}\n   167\t\n   168\tfunc readShimProcStat(pid int) (shimProcStat, error) {\n   169\t\traw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n   170\t\tif err != nil {\n   171\t\t\treturn shimProcStat{}, err\n   172\t\t}\n   173\t\ttext := string(raw)\n   174\t\tend := strings.LastIndexByte(text, ')')\n   175\t\tif end < 0 {\n   176\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   177\t\t}\n   178\t\tf := strings.Fields(text[end+1:])\n   179\t\tif len(f) < 2 {\n   180\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   181\t\t}\n   182\t\tppid, err := strconv.Atoi(f[1])\n   183\t\tif err != nil {\n   184\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   185\t\t}\n   186\t\treturn shimProcStat{ppid: ppid, zombie: f[0] == \"Z\"}, nil\n   187\t}\n   188\t\n   189\t// killPinnedChild signals pid through a pidfd while it is still a child of\n   190\t// parent: a pid reused by an unrelated process is never signalled.\n   191\tfunc killPinnedChild(pid, parent int) error {\n   192\t\tfd, err := unix.PidfdOpen(pid, 0)\n   193\t\tif errors.Is(err, unix.ESRCH) {\n   194\t\t\treturn nil\n   195\t\t}\n   196\t\tif err != nil {\n   197\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   198\t\t}\n   199\t\tdefer unix.Close(fd)\n   200\t\tst, err := readShimProcStat(pid)\n   201\t\tif reviewProcessGoneErr(err) || err == nil && st.ppid != parent {\n   202\t\t\treturn nil\n   203\t\t}\n   204\t\tif err != nil {\n   205\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   206\t\t}\n   207\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   208\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   209\t\t}\n   210\t\treturn nil\n   211\t}\n   212\t\n   213\t// readReviewShimReport reads the report the shim wrote.\n   214\tfunc readReviewShimReport(path string) (reviewShimReport, error) {\n   215\t\tvar r reviewShimReport\n   216\t\traw, err := os.ReadFile(path)\n   217\t\tif err != nil {\n   218\t\t\treturn r, fmt.Errorf(\"the review shim left no report: %w\", err)\n   219\t\t}\n   220\t\tif err := json.Unmarshal(raw, &r); err != nil {\n   221\t\t\treturn r, fmt.Errorf(\"the review shim report is unreadable: %w\", err)\n   222\t\t}\n   223\t\treturn r, nil\n   224\t}\n   225\t//go:build linux\n   226\t\n   227\tpackage pose\n   228\t\n   229\t// Leftover reviewer processes (spec\n   230\t// pose-review-run-reaps-lingering-reviewer-processes R1): an adapter such as\n   231\t// `codex exec` runs each command in a session of its own, so killing the\n   232\t// adapter's process group misses a command the reviewer left running, and\n   233\t// that command keeps writing into the run's runtime directory while the\n   234\t// cleanup inventory reads it. Every process of the run inherits\n   235\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n   236\t// that entry, ends them and waits for them before the inventory.\n   237\t//\n   238\t// Each process is pinned by a pidfd before it is signalled, and its\n   239\t// environment is read again through the pinned process, so a pid reused by\n   240\t// an unrelated process between the scan and the signal is never killed\n   241\t// (review round 1, N3). A scan that cannot list or read the state of the\n   242\t// processes fails. A process of this user whose environment cannot be read\n   243\t// (one that made itself non-inspectable) cannot be matched: one that already\n   244\t// existed before the adapter started is not the run's and is skipped; any\n   245\t// other may be the run's, so the scan fails and the run stays unconcludable\n   246\t// (review round 2, N2).\n   247\t\n   248\timport (\n   249\t\t\"bytes\"\n   250\t\t\"errors\"\n   251\t\t\"fmt\"\n   252\t\t\"io/fs\"\n   253\t\t\"os\"\n   254\t\t\"path/filepath\"\n   255\t\t\"strconv\"\n   256\t\t\"strings\"\n   257\t\t\"syscall\"\n   258\t\t\"time\"\n   259\t\n   260\t\t\"golang.org/x/sys/unix\"\n   261\t)\n   262\t\n   263\tconst reviewReapWait = 5 * time.Second\n   264\t\n   265\t// reapSealedCheckoutProcesses ends every process whose environment names\n   266\t// worktree as its sealed checkout and returns a description of each. An\n   267\t// error means the run's processes could not be proven ended within the bound.\n   268\tfunc reapSealedCheckoutProcesses(worktree string, baseline map[int]string) ([]string, int, error) {\n   269\t\tif worktree == \"\" {\n   270\t\t\treturn nil, 0, nil\n   271\t\t}\n   272\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n   273\t\tvar reaped []string\n   274\t\tseen := map[int]bool{}\n   275\t\tdeadline := time.Now().Add(reviewReapWait)\n   276\t\tunreadable := 0\n   277\t\tfor {\n   278\t\t\talive, opaque, err := reviewMarkedProcesses(entry)\n   279\t\t\tif err != nil {\n   280\t\t\t\treturn reaped, unreadable, err\n   281\t\t\t}\n   282\t\t\tunreadable = 0\n   283\t\t\tfor pid, start := range opaque {\n   284\t\t\t\tif prior, ok := baseline[pid]; !ok || prior != start {\n   285\t\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"process %d of this user started during the run and cannot be inspected; it may be the run's and was not ended\", pid)\n   286\t\t\t\t}\n   287\t\t\t\tunreadable++\n   288\t\t\t}\n   289\t\t\tfor _, pid := range alive {\n   290\t\t\t\tif !seen[pid] {\n   291\t\t\t\t\tseen[pid] = true\n   292\t\t\t\t\t// Only the pid: the name is the reviewer's to choose and is not\n   293\t\t\t\t\t// recorded (review round 7, N4).\n   294\t\t\t\t\treaped = append(reaped, strconv.Itoa(pid))\n   295\t\t\t\t}\n   296\t\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n   297\t\t\t\t\treturn reaped, unreadable, err\n   298\t\t\t\t}\n   299\t\t\t}\n   300\t\t\tif len(alive) == 0 {\n   301\t\t\t\treturn reaped, unreadable, nil\n   302\t\t\t}\n   303\t\t\tif time.Now().After(deadline) {\n   304\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n   305\t\t\t}\n   306\t\t\ttime.Sleep(50 * time.Millisecond)\n   307\t\t}\n   308\t}\n   309\t\n   310\t// reviewMarkedProcesses lists the live processes whose environment holds\n   311\t// entry, and counts this user's processes whose environment could not be\n   312\t// read. A process that is gone is skipped.\n   313\tfunc reviewMarkedProcesses(entry []byte) ([]int, map[int]string, error) {\n   314\t\tdirs, err := os.ReadDir(\"/proc\")\n   315\t\tif err != nil {\n   316\t\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n   317\t\t}\n   318\t\tunreadable := map[int]string{}\n   319\t\tself, uid := os.Getpid(), os.Getuid()\n   320\t\tvar out []int\n   321\t\tfor _, d := range dirs {\n   322\t\t\tpid, err := strconv.Atoi(d.Name())\n   323\t\t\tif err != nil || pid == self {\n   324\t\t\t\tcontinue\n   325\t\t\t}\n   326\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n   327\t\t\tswitch {\n   328\t\t\tcase reviewProcessGoneErr(err):\n   329\t\t\t\tcontinue\n   330\t\t\tcase err != nil:\n   331\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n   332\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n   333\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   334\t\t\t\t\tcontinue\n   335\t\t\t\t}\n   336\t\t\t\tstart, serr := processStartTime(pid)\n   337\t\t\t\tif reviewProcessGoneErr(serr) {\n   338\t\t\t\t\tcontinue\n   339\t\t\t\t}\n   340\t\t\t\tif serr != nil || start == \"\" {\n   341\t\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d start could not be read: %v\", pid, serr)\n   342\t\t\t\t}\n   343\t\t\t\tunreadable[pid] = start\n   344\t\t\t\tcontinue\n   345\t\t\tcase !marked:\n   346\t\t\t\tcontinue\n   347\t\t\t}\n   348\t\t\tzombie, err := reviewProcessZombie(pid)\n   349\t\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n   350\t\t\t\tcontinue\n   351\t\t\t}\n   352\t\t\tif err != nil {\n   353\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n   354\t\t\t}\n   355\t\t\tout = append(out, pid)\n   356\t\t}\n   357\t\treturn out, unreadable, nil\n   358\t}\n   359\t\n   360\t// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n   361\t// after the environment read through that same pinned process still holds\n   362\t// entry.\n   363\tfunc killPinnedMarkedProcess(pid int, entry []byte) error {\n   364\t\tfd, err := unix.PidfdOpen(pid, 0)\n   365\t\tif errors.Is(err, unix.ESRCH) {\n   366\t\t\treturn nil\n   367\t\t}\n   368\t\tif err != nil {\n   369\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   370\t\t}\n   371\t\tdefer unix.Close(fd)\n   372\t\t// The pidfd names one process for its lifetime; if pid was reused before\n   373\t\t// it was opened, the new process does not carry this run's entry.\n   374\t\tmarked, err := reviewProcessMarked(pid, entry)\n   375\t\tif reviewProcessGoneErr(err) || err == nil && !marked {\n   376\t\t\treturn nil\n   377\t\t}\n   378\t\tif err != nil {\n   379\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   380\t\t}\n   381\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   382\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   383\t\t}\n   384\t\treturn nil\n   385\t}\n   386\t\n   387\tfunc reviewProcessMarked(pid int, entry []byte) (bool, error) {\n   388\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   389\t\tif err != nil {\n   390\t\t\treturn false, err\n   391\t\t}\n   392\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n   393\t\t\tif bytes.Equal(kv, entry) {\n   394\t\t\t\treturn true, nil\n   395\t\t\t}\n   396\t\t}\n   397\t\treturn false, nil\n   398\t}\n   399\t\n   400\tfunc reviewProcessOwner(pid int) (int, error) {\n   401\t\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n   402\t\tif err != nil {\n   403\t\t\treturn 0, err\n   404\t\t}\n   405\t\tst, ok := info.Sys().(*syscall.Stat_t)\n   406\t\tif !ok {\n   407\t\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n   408\t\t}\n   409\t\treturn int(st.Uid), nil\n   410\t}\n   411\t\n   412\tfunc reviewProcessGoneErr(err error) bool {\n   413\t\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n   414\t}\n   415\t\n   416\tfunc reviewProcessName(pid int) string {\n   417\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n   418\t\tif err != nil {\n   419\t\t\treturn \"?\"\n   420\t\t}\n   421\t\treturn strings.TrimSpace(string(raw))\n   422\t}\n   423\t\n   424\tfunc reviewProcessZombie(pid int) (bool, error) {\n   425\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n   426\t\tif err != nil {\n   427\t\t\treturn false, err\n   428\t\t}\n   429\t\t// The state follows the parenthesised command name.\n   430\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   431\t\t\treturn raw[i+2] == 'Z', nil\n   432\t\t}\n   433\t\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n   434\t}\n   435\t\n   436\t// reviewOpaqueProcessBaseline records, before the adapter starts, the\n   437\t// processes of this user whose environment cannot be read, by pid and start\n   438\t// time: they cannot be the run's.\n   439\tfunc reviewOpaqueProcessBaseline() map[int]string {\n   440\t\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv + \"=\\x00\"))\n   441\t\treturn opaque\n   442\t}\n   443\t//go:build !linux\n   444\t\n   445\tpackage pose\n   446\t\n   447\t// reapSealedCheckoutProcesses has no portable way to read another process's\n   448\t// environment; outside Linux the process-group kill is the only termination.\n   449\tfunc reapSealedCheckoutProcesses(string, map[int]string) ([]string, int, error) { return nil, 0, nil }\n   450\t\n   451\tfunc reviewOpaqueProcessBaseline() map[int]string { return nil }\n   452\t\n   453\t// RunReviewShim is the Linux review run shim; elsewhere it is not used.\n   454\tfunc RunReviewShim(args []string) int { return 125 }\n   455\t\n   456\tfunc readReviewShimReport(string) (reviewShimReport, error) { return reviewShimReport{}, nil }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/delegation_release.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"os\"\n    28\t\t\"path/filepath\"\n    29\t\t\"strings\"\n    30\t\t\"time\"\n    31\t)\n    32\t\n    33\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    34\t// proven abandoned.\n    35\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    36\t\n    37\t// reviewOrphanReservationAge is how old a reservation without any marker\n    38\t// must be to count as abandoned.\n    39\tconst reviewOrphanReservationAge = 10 * time.Minute\n    40\t\n    41\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    42\t// dispatch ended before recording it, and removes its stalled marker. A\n    43\t// stalled marker whose reservation was never published is only removed; the\n    44\t// returned run is then empty.\n    45\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    46\t\tif !validAttemptFileName(attemptID) {\n    47\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    48\t\t}\n    49\t\tmarkers, _, err := s.ListDelegationActive()\n    50\t\tif err != nil {\n    51\t\t\treturn ReviewRun{}, err\n    52\t\t}\n    53\t\tvar marker *DelegationActiveRun\n    54\t\tfor i := range markers {\n    55\t\t\tif markers[i].AttemptID == attemptID {\n    56\t\t\t\tmarker = &markers[i]\n    57\t\t\t}\n    58\t\t}\n    59\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    60\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    61\t\t}\n    62\t\tdir, err := s.delegationActiveDir(true)\n    63\t\tif err != nil {\n    64\t\t\treturn ReviewRun{}, err\n    65\t\t}\n    66\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    67\t\tif err != nil {\n    68\t\t\treturn ReviewRun{}, err\n    69\t\t}\n    70\t\tdefer lock.Close()\n    71\t\tunlock, err := lockSpecTransferFile(lock)\n    72\t\tif err != nil {\n    73\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    74\t\t}\n    75\t\tdefer unlock()\n    76\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    77\t}\n    78\t\n    79\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    80\t\tvar reserved *DelegatedReviewAttempt\n    81\t\tif marker != nil {\n    82\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    83\t\t\tif err != nil {\n    84\t\t\t\treturn ReviewRun{}, err\n    85\t\t\t}\n    86\t\t\tfor i := range attempts {\n    87\t\t\t\tif attempts[i].AttemptID == attemptID {\n    88\t\t\t\t\treserved = &attempts[i]\n    89\t\t\t\t}\n    90\t\t\t}\n    91\t\t\tif reserved == nil {\n    92\t\t\t\t// The dispatch ended between its marker and its reservation:\n    93\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    94\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    95\t\t\t}\n    96\t\t} else {\n    97\t\t\tif !operatorConfirmed {\n    98\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n    99\t\t\t}\n   100\t\t\torphans, _, err := s.orphanReservations(now)\n   101\t\t\tif err != nil {\n   102\t\t\t\treturn ReviewRun{}, err\n   103\t\t\t}\n   104\t\t\tfor i := range orphans {\n   105\t\t\t\tif orphans[i].AttemptID == attemptID {\n   106\t\t\t\t\treserved = &orphans[i]\n   107\t\t\t\t}\n   108\t\t\t}\n   109\t\t\tif reserved == nil {\n   110\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   111\t\t\t}\n   112\t\t}\n   113\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   114\t\t\t// A release that stopped after the receipt completes by removing\n   115\t\t\t// the stalled marker; with no marker there is nothing to release.\n   116\t\t\tif marker != nil {\n   117\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   118\t\t\t\tif err != nil {\n   119\t\t\t\t\treturn ReviewRun{}, err\n   120\t\t\t\t}\n   121\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   122\t\t\t\tif err != nil {\n   123\t\t\t\t\treturn ReviewRun{}, err\n   124\t\t\t\t}\n   125\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   126\t\t\t}\n   127\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   128\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   129\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   130\t\t}\n   131\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   132\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   133\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   134\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   135\t\tif marker != nil {\n   136\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   137\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   138\t\t} else {\n   139\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   140\t\t}\n   141\t\t// A run the attempt already recorded, by its dispatch or by a release\n   142\t\t// interrupted before the receipt, completes the attempt; no second run\n   143\t\t// is written for it.\n   144\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   145\t\tif err != nil {\n   146\t\t\treturn ReviewRun{}, err\n   147\t\t}\n   148\t\tif !found {\n   149\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   150\t\t\t\treturn ReviewRun{}, err\n   151\t\t\t}\n   152\t\t}\n   153\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   154\t\t\treturn recorded, err\n   155\t\t}\n   156\t\tif marker != nil {\n   157\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   158\t\t}\n   159\t\treturn recorded, nil\n   160\t}\n   161\t\n   162\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   163\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   164\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   165\t\tif err != nil {\n   166\t\t\treturn ReviewRun{}, false, err\n   167\t\t}\n   168\t\tif len(lost) > 0 {\n   169\t\t\t// An unreadable run may be this release's: the history is unknown,\n   170\t\t\t// and the release does not write another (review round 4, N3).\n   171\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   172\t\t}\n   173\t\tvar latest *ReviewRun\n   174\t\tfor i := range runs {\n   175\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   176\t\t\t\tlatest = &runs[i]\n   177\t\t\t}\n   178\t\t}\n   179\t\tif latest == nil {\n   180\t\t\treturn ReviewRun{}, false, nil\n   181\t\t}\n   182\t\treturn *latest, true, nil\n   183\t}\n   184\t\n   185\t// orphanReservations lists the reservations left without a receipt or a\n   186\t// marker, older than reviewOrphanReservationAge, and\n   187\t// says which reservations or receipts it could not read (review round 3, N3).\n   188\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   189\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   190\t\tdirs, err := os.ReadDir(base)\n   191\t\tif errors.Is(err, os.ErrNotExist) {\n   192\t\t\treturn nil, nil, nil\n   193\t\t}\n   194\t\tif err != nil {\n   195\t\t\treturn nil, nil, err\n   196\t\t}\n   197\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   198\t\tif err != nil {\n   199\t\t\treturn nil, nil, err\n   200\t\t}\n   201\t\tif len(markerLost) > 0 {\n   202\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   203\t\t\t// have no marker (review round 6, N1).\n   204\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   205\t\t}\n   206\t\tmarked := map[string]bool{}\n   207\t\tfor _, m := range markers {\n   208\t\t\tmarked[m.AttemptID] = true\n   209\t\t}\n   210\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   211\t\tif err != nil {\n   212\t\t\treturn nil, nil, err\n   213\t\t}\n   214\t\tif len(runLost) > 0 {\n   215\t\t\t// Without the whole run history nothing is known to have no run.\n   216\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   217\t\t}\n   218\t\t// A recorded run does not finish an attempt, its receipt does: a\n   219\t\t// reservation whose run was recorded without a receipt still blocks and\n   220\t\t// is released with that run (review round 5, N3).\n   221\t\t_ = runs\n   222\t\tvar out []DelegatedReviewAttempt\n   223\t\tvar lost []string\n   224\t\tbudget := reviewReadBudget(nil)\n   225\t\tfor _, d := range dirs {\n   226\t\t\tif !d.IsDir() {\n   227\t\t\t\tcontinue\n   228\t\t\t}\n   229\t\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n   230\t\t\tif err != nil {\n   231\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   232\t\t\t\tcontinue\n   233\t\t\t}\n   234\t\t\tfor _, e := range entries {\n   235\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   236\t\t\t\t\tcontinue\n   237\t\t\t\t}\n   238\t\t\t\tvar a DelegatedReviewAttempt\n   239\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   240\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   241\t\t\t\t\tcontinue\n   242\t\t\t\t}\n   243\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif marked[a.AttemptID] {\n   248\t\t\t\t\tcontinue\n   249\t\t\t\t}\n   250\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   251\t\t\t\t\tcontinue\n   252\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   253\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   254\t\t\t\t\tcontinue\n   255\t\t\t\t}\n   256\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   257\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   258\t\t\t\t\tcontinue\n   259\t\t\t\t}\n   260\t\t\t\tout = append(out, a)\n   261\t\t\t}\n   262\t\t}\n   263\t\treturn out, lost, nil\n   264\t}\n   265\t\n   266\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   267\t\tdir, err := s.delegationActiveDir(false)\n   268\t\tif err != nil {\n   269\t\t\treturn err\n   270\t\t}\n   271\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   272\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   273\t\t\t\treturn err\n   274\t\t\t}\n   275\t\t}\n   276\t\treturn nil\n   277\t}\n","exit_code":0,"status":"completed"}}
