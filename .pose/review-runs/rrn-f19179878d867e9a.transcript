|  156 +\n .pose/review-runs/rrn-9abc2fe5dedc7478.transcript  |  166 +\n .../review-runs/rrn-adf91bb46841bd66.events.ndjson |  132 +\n .pose/review-runs/rrn-adf91bb46841bd66.json        |  156 +\n .pose/review-runs/rrn-adf91bb46841bd66.transcript  |  133 +\n .../review-runs/rrn-c5c082703d83c834.events.ndjson |   92 +\n .pose/review-runs/rrn-c5c082703d83c834.json        |  149 +\n .pose/review-runs/rrn-c5c082703d83c834.transcript  |   93 +\n .../review-runs/rrn-cd0ac9394ca5892b.events.ndjson |   90 +\n .pose/review-runs/rrn-cd0ac9394ca5892b.json        |  151 +\n .pose/review-runs/rrn-cd0ac9394ca5892b.transcript  |   91 +\n ...23-pose-assess-leaves-sealed-checkouts-alone.md |   72 +-\n ...eview-conclude-ignores-unrelated-local-edits.md |  109 +\n ...eview-run-reaps-lingering-reviewer-processes.md |  187 +\n POSE.md                                            |    8 +-\n locales/pt-BR/POSE.md                              |    8 +-\n pose-mcp/cmd/pose/main.go                          |    2 +\n pose-mcp/internal/cli/assess.go                    |   78 +-\n pose-mcp/internal/cli/assess_sealed_test.go        |  107 +\n pose-mcp/internal/cli/cli.go                       |    3 +\n pose-mcp/internal/cli/cli_test.go                  |    5 +\n pose-mcp/internal/cli/delegate.go                  |   40 +-\n pose-mcp/internal/cli/help_catalog.go              |    8 +-\n pose-mcp/internal/cli/review_reap_test.go          |   59 +\n pose-mcp/internal/pose/assessment_sealed.go        |   20 +\n pose-mcp/internal/pose/assessment_sealed_test.go   |   62 +\n pose-mcp/internal/pose/delegation_list.go          |   24 +\n pose-mcp/internal/pose/delegation_release.go       |  277 ++\n pose-mcp/internal/pose/delegation_release_test.go  |  484 +++\n pose-mcp/internal/pose/discovery.go                |   12 +\n .../internal/pose/engine_reads_raw_history_test.go |    1 +\n pose-mcp/internal/pose/integration.go              |    3 +\n pose-mcp/internal/pose/main_test.go                |    5 +\n .../internal/pose/review_adapter_containment.go    |   10 +\n .../review_adapter_containment_regression_test.go  |   19 +-\n pose-mcp/internal/pose/review_attempt_ledger.go    |   30 +-\n pose-mcp/internal/pose/review_brief.go             |   35 +-\n .../pose/review_brief_conclusion_rules_test.go     |   34 +-\n pose-mcp/internal/pose/review_brief_test.go        |    2 +-\n pose-mcp/internal/pose/review_dispatch.go          |   72 +-\n pose-mcp/internal/pose/review_plan.go              |    6 +-\n pose-mcp/internal/pose/review_reap_linux.go        |  218 ++\n pose-mcp/internal/pose/review_reap_linux_test.go   |  130 +\n pose-mcp/internal/pose/review_reap_other.go        |   14 +\n pose-mcp/internal/pose/review_shim.go              |   32 +\n pose-mcp/internal/pose/review_shim_linux.go        |  192 +\n pose-mcp/internal/pose/techdebt.go                 |    3 +\n .../testdata/review_brief_template_digests.json    |    4 +-\n pose-mcp/internal/scaffold/dist/POSE.md            |    8 +-\n .../internal/scaffold/dist/locales/pt-BR/POSE.md   |    8 +-\n 139 files changed, 44940 insertions(+), 2381 deletions(-)\n","exit_code":0,"status":"completed"}}
