d\n    54\t\treturn cmd\n    55\t}\n    56\t\n    57\t// Verify the covered Linux group after SIGKILL. Zombies have terminated and\n    58\t// cannot hold pipes; reaping is their parent's duty. Other Unix ports currently\n    59\t// report signal delivery only and cannot require verified group termination.\n    60\tfunc verifyReviewProcessGroup(pid int) error {\n    61\t\tif runtime.GOOS != \"linux\" {\n    62\t\t\treturn nil\n    63\t\t}\n    64\t\tdeadline := time.Now().Add(time.Second)\n    65\t\tfor {\n    66\t\t\tentries, err := os.ReadDir(\"/proc\")\n    67\t\t\tif err != nil {\n    68\t\t\t\treturn fmt.Errorf(\"process-group termination could not be observed\")\n    69\t\t\t}\n    70\t\t\tif len(entries) > 100000 {\n    71\t\t\t\treturn fmt.Errorf(\"process inventory exceeds coverage\")\n    72\t\t\t}\n    73\t\t\talive := false\n    74\t\t\tfor _, entry := range entries {\n    75\t\t\t\tif _, err := strconv.Atoi(entry.Name()); err != nil {\n    76\t\t\t\t\tcontinue\n    77\t\t\t\t}\n    78\t\t\t\traw, err := os.ReadFile(\"/proc/\" + entry.Name() + \"/stat\")\n    79\t\t\t\tif processGone(err) {\n    80\t\t\t\t\tcontinue\n    81\t\t\t\t}\n    82\t\t\t\tif err != nil {\n    83\t\t\t\t\treturn fmt.Errorf(\"process inventory incomplete\")\n    84\t\t\t\t}\n    85\t\t\t\tend := strings.LastIndex(string(raw), \")\")\n    86\t\t\t\tif end < 0 {\n    87\t\t\t\t\treturn fmt.Errorf(\"process inventory malformed\")\n    88\t\t\t\t}\n    89\t\t\t\tfields := strings.Fields(string(raw[end+1:]))\n    90\t\t\t\tif len(fields) < 3 {\n    91\t\t\t\t\treturn fmt.Errorf(\"process inventory malformed\")\n    92\t\t\t\t}\n    93\t\t\t\tgroup, err := strconv.Atoi(fields[2])\n    94\t\t\t\tif err != nil {\n    95\t\t\t\t\treturn fmt.Errorf(\"process group malformed\")\n    96\t\t\t\t}\n    97\t\t\t\tif group == pid && fields[0] != \"Z\" && fields[0] != \"X\" {\n    98\t\t\t\t\talive = true\n    99\t\t\t\t\tbreak\n   100\t\t\t\t}\n   101\t\t\t}\n   102\t\t\tif !alive {\n   103\t\t\t\treturn nil\n   104\t\t\t}\n   105\t\t\tif time.Now().After(deadline) {\n   106\t\t\t\treturn fmt.Errorf(\"process group remained alive after termination\")\n   107\t\t\t}\n   108\t\t\ttime.Sleep(10 * time.Millisecond)\n   109\t\t}\n   110\t}\n   111\t\n   112\t// processGone reports the two ways a process exiting during the walk answers:\n   113\t// the open finds no entry, or the read of an open entry finds no process.\n   114\tfunc processGone(err error) bool {\n   115\t\treturn errors.Is(err, os.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n","exit_code":0,"status":"completed"}}
