{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/cli/review_reap_test.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage cli\n     4\t\n     5\timport (\n     6\t\t\"os\"\n     7\t\t\"os/exec\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strconv\"\n    10\t\t\"strings\"\n    11\t\t\"syscall\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t\n    15\t\t\"github.com/harne8/pose-mcp/internal/pose\"\n    16\t)\n    17\t\n    18\t// Spec pose-review-run-reaps-lingering-reviewer-processes R1, R2, R4: a\n    19\t// reviewer that ends while a command it started in a session of its own is\n    20\t// still running leaves a run that completes, with that command ended before\n    21\t// the cleanup and named in the run record.\n    22\tfunc TestDispatchEndsWhatTheReviewerLeftRunning(t *testing.T) {\n    23\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n    24\t\t\tt.Skip(\"setsid is not available\")\n    25\t\t}\n    26\t\troot := dispatchInstance(t)\n    27\t\tpidFile := filepath.Join(t.TempDir(), \"leftover.pid\")\n    28\t\tscript := `cat >/dev/null; setsid sh -c 'echo $$ > \"` + pidFile + `\"; while :; do touch \"$TMPDIR/leftover\" 2>/dev/null; sleep 0.05; done' </dev/null >/dev/null 2>&1 & ` +\n    29\t\t\t`i=0; while [ ! -s \"` + pidFile + `\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`\n    30\t\twriteReviewers(t, root, map[string]pose.ReviewerAdapter{\"fake\": {Command: []string{\"sh\", \"-c\", script}, Vendor: \"fixture\", Model: \"fixture\", Containment: &pose.ReviewerContainment{SchemaVersion: 1, Profile: \"trusted-process\"}}})\n    31\t\tcode, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\")\n    32\t\traw, err := os.ReadFile(pidFile)\n    33\t\tif err != nil {\n    34\t\t\tt.Fatalf(\"the leftover never started: %v (%d %s)\", err, code, out)\n    35\t\t}\n    36\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n    37\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n    38\t\tdeadline := time.Now().Add(2 * time.Second)\n    39\t\tfor syscall.Kill(pid, 0) == nil && time.Now().Before(deadline) {\n    40\t\t\tif stat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\"); err == nil && strings.Contains(string(stat), \") Z \") {\n    41\t\t\t\tbreak\n    42\t\t\t}\n    43\t\t\ttime.Sleep(50 * time.Millisecond)\n    44\t\t}\n    45\t\tif stat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\"); err == nil && !strings.Contains(string(stat), \") Z \") {\n    46\t\t\tt.Fatalf(\"the process the reviewer left running survived the run: %s\", stat)\n    47\t\t}\n    48\t\truns, _, _ := (pose.Store{Root: root}).ReadReviewRuns(\"\")\n    49\t\tif len(runs) != 1 {\n    50\t\t\tt.Fatalf(\"runs: %d (%d %s)\", len(runs), code, out)\n    51\t\t}\n    52\t\trun := runs[0]\n    53\t\tif run.Status != pose.ReviewRunCompleted || run.Safety == nil || run.Safety.Operation.Outcome != pose.OutcomeCompleted {\n    54\t\t\tt.Fatalf(\"the run did not complete with its cleanup: status=%s failure=%s safety=%+v\", run.Status, run.Failure, run.Safety)\n    55\t\t}\n    56\t\tif !strings.Contains(strings.Join(run.Safety.Limitations, \"\\n\"), \"process(es) the run left running\") {\n    57\t\t\tt.Fatalf(\"the run record does not name the ended process: %v\", run.Safety.Limitations)\n    58\t\t}\n    59\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_reap_linux_test.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os\"\n     7\t\t\"os/exec\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strconv\"\n    10\t\t\"strings\"\n    11\t\t\"syscall\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\t// Review round 1, N3: a pid that no longer names a process of the run, as\n    17\t// after reuse by an unrelated process, is never signalled.\n    18\tfunc TestAPidThatLostTheRunsEntryIsNotKilled(t *testing.T) {\n    19\t\tother := exec.Command(\"sleep\", \"30\")\n    20\t\tif err := other.Start(); err != nil {\n    21\t\t\tt.Fatal(err)\n    22\t\t}\n    23\t\tfor i := 0; i < 200 && reviewProcessName(other.Process.Pid) != \"sleep\"; i++ {\n    24\t\t\ttime.Sleep(10 * time.Millisecond)\n    25\t\t}\n    26\t\tt.Cleanup(func() { _ = other.Process.Kill(); _ = other.Wait() })\n    27\t\tentry := []byte(SealedCheckoutEnv + \"=/nonexistent/run-checkout\")\n    28\t\tif err := killPinnedMarkedProcess(other.Process.Pid, entry); err != nil {\n    29\t\t\tt.Fatal(err)\n    30\t\t}\n    31\t\ttime.Sleep(100 * time.Millisecond)\n    32\t\tif zombie, err := reviewProcessZombie(other.Process.Pid); err != nil || zombie {\n    33\t\t\tt.Fatalf(\"a process without the run's entry was killed: zombie=%t %v\", zombie, err)\n    34\t\t}\n    35\t\t// The same process carrying the entry is ended.\n    36\t\tmarked := exec.Command(\"sleep\", \"30\")\n    37\t\tmarked.Env = append(marked.Environ(), string(entry))\n    38\t\tif err := marked.Start(); err != nil {\n    39\t\t\tt.Fatal(err)\n    40\t\t}\n    41\t\t// Until exec, /proc shows the parent's environment.\n    42\t\tfor i := 0; i < 200; i++ {\n    43\t\t\tif ok, _ := reviewProcessMarked(marked.Process.Pid, entry); ok {\n    44\t\t\t\tbreak\n    45\t\t\t}\n    46\t\t\ttime.Sleep(10 * time.Millisecond)\n    47\t\t}\n    48\t\tif err := killPinnedMarkedProcess(marked.Process.Pid, entry); err != nil {\n    49\t\t\tt.Fatal(err)\n    50\t\t}\n    51\t\tif err := marked.Wait(); err == nil {\n    52\t\t\tt.Fatal(\"the marked process was not ended\")\n    53\t\t}\n    54\t}\n    55\t\n    56\t// opaqueProcess starts a process of this user whose environment cannot be\n    57\t// read (it makes itself non-dumpable), or skips without python3.\n    58\tfunc opaqueProcess(t *testing.T) *exec.Cmd {\n    59\t\tt.Helper()\n    60\t\tif _, err := exec.LookPath(\"python3\"); err != nil {\n    61\t\t\tt.Skip(\"python3 is not available\")\n    62\t\t}\n    63\t\tcmd := exec.Command(\"python3\", \"-c\", \"import ctypes,time; ctypes.CDLL(None).prctl(4,0,0,0,0); time.sleep(30)\")\n    64\t\tif err := cmd.Start(); err != nil {\n    65\t\t\tt.Fatal(err)\n    66\t\t}\n    67\t\tt.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })\n    68\t\tfor i := 0; i < 300; i++ {\n    69\t\t\tif _, err := reviewProcessMarked(cmd.Process.Pid, []byte(\"x\")); err != nil && !reviewProcessGoneErr(err) {\n    70\t\t\t\treturn cmd\n    71\t\t\t}\n    72\t\t\ttime.Sleep(10 * time.Millisecond)\n    73\t\t}\n    74\t\tt.Skip(\"the process never became non-inspectable\")\n    75\t\treturn nil\n    76\t}\n    77\t\n    78\t// Review round 2, N2: a non-inspectable process that existed before the run\n    79\t// is not the run's; one that started during it may be, and the scan fails\n    80\t// instead of reporting the run's processes ended.\n    81\tfunc TestANonInspectableProcessStartedDuringTheRunFailsTheScan(t *testing.T) {\n    82\t\tbefore := opaqueProcess(t)\n    83\t\tbaseline := reviewOpaqueProcessBaseline()\n    84\t\tif _, ok := baseline[before.Process.Pid]; !ok {\n    85\t\t\tt.Fatalf(\"the baseline misses process %d\", before.Process.Pid)\n    86\t\t}\n    87\t\tif _, opaque, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err != nil || opaque == 0 {\n    88\t\t\tt.Fatalf(\"a process that predates the run failed the scan or was not counted: %d %v\", opaque, err)\n    89\t\t}\n    90\t\tduring := opaqueProcess(t)\n    91\t\tif _, _, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err == nil || !strings.Contains(err.Error(), \"started during the run\") {\n    92\t\t\tt.Fatalf(\"process %d, started during the run, did not fail the scan: %v\", during.Process.Pid, err)\n    93\t\t}\n    94\t}\n    95\t\n    96\t// Review round 6, N2: a descendant that leaves the group, starts its own\n    97\t// session and clears its environment is still ended with the run.\n    98\tfunc TestAnOrphanThatClearedItsEnvironmentIsEnded(t *testing.T) {\n    99\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   100\t\t\tt.Skip(\"setsid is not available\")\n   101\t\t}\n   102\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   103\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   104\t\t\ta.Containment = containmentPolicy()\n   105\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & ` +\n   106\t\t\t\t`i=0; while [ ! -s \"$1\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`, \"sh\", pidFile}\n   107\t\t})\n   108\t\traw, err := os.ReadFile(pidFile)\n   109\t\tif err != nil {\n   110\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   111\t\t}\n   112\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   113\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   114\t\tif zombie, err := reviewProcessZombie(pid); err == nil && !zombie {\n   115\t\t\tt.Fatalf(\"the orphan that cleared its environment survived the run (status %s: %s)\", f.run.Status, f.run.Failure)\n   116\t\t}\n   117\t\tif f.run.Status != ReviewRunCompleted || !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), \"(orphaned)\") {\n   118\t\t\tt.Fatalf(\"the run did not complete naming the orphan: %s %s %v\", f.run.Status, f.run.Failure, f.run.Safety.Limitations)\n   119\t\t}\n   120\t\t// Review round 7, N4: the record names the pid, never the process name\n   121\t\t// the reviewer chose.\n   122\t\tfor _, limit := range f.run.Safety.Limitations {\n   123\t\t\tif strings.Contains(limit, \"(orphaned)\") && strings.Contains(limit, \" sh \") {\n   124\t\t\t\tt.Fatalf(\"the recorded limitation carries a process name: %q\", limit)\n   125\t\t\t}\n   126\t\t}\n   127\t\tif !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), strconv.Itoa(pid)+\" (orphaned)\") {\n   128\t\t\tt.Fatalf(\"the recorded limitation does not name the pid: %v\", f.run.Safety.Limitations)\n   129\t\t}\n   130\t}\n","exit_code":0,"status":"completed"}}
