{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n -C 22 'TestAnInterruptedDispatch|Test.*RunningAttempt|TestAnAbandonedAttempt|Test.*OneReleaseRunsAtATime|TestARecordedRun|TestAnInterruptedRelease|TestAStaleClaim|TestAnUnreadable' pose-mcp/internal/pose/delegation_release_test.go\"","aggregated_output":"1-//go:build linux\n2-\n3-package pose\n4-\n5-import (\n6-\t\"context\"\n7-\t\"encoding/json\"\n8-\t\"errors\"\n9-\t\"os\"\n10-\t\"os/exec\"\n11-\t\"path/filepath\"\n12-\t\"strings\"\n13-\t\"syscall\"\n14-\t\"testing\"\n15-\t\"time\"\n16-)\n17-\n18-// Spec pose-review-run-reaps-lingering-reviewer-processes R5, R6: a dispatch\n19-// that ended between its reservation and its run record leaves an attempt\n20-// that blocks the bundle; once its owner is proven gone, cancel releases it\n21-// with a failed run and its receipt, and the ledger reads again.\n22:func TestAnAbandonedAttemptIsReleasedWithARecord(t *testing.T) {\n23-\troot := t.TempDir()\n24-\ts := Store{Root: root}\n25-\tbundle := \"rvb-00000000000000a1\"\n26-\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n27-\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"0\", 32)}\n28-\ta.AttemptID = attemptIdentity(a)\n29-\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n30-\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n31-\t\tt.Fatal(err)\n32-\t}\n33-\t// The ledger refuses the bundle while the reservation has no receipt.\n34-\tif _, err := s.readAttemptReceipt(a); err == nil || !strings.Contains(err.Error(), \"incomplete or unreadable\") {\n35-\t\tt.Fatalf(\"an unfinished reservation read as finished: %v\", err)\n36-\t}\n37-\n38-\t// The marker the interrupted dispatch left: its owner is a process that\n39-\t// has exited.\n40-\tdead := exec.Command(\"true\")\n41-\tif err := dead.Run(); err != nil {\n42-\t\tt.Fatal(err)\n43-\t}\n44-\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n--\n57-\t}\n58-\n59-\trun, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false)\n60-\tif err != nil {\n61-\t\tt.Fatal(err)\n62-\t}\n63-\tif run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"abandoned\") {\n64-\t\tt.Fatalf(\"the release recorded %s: %s\", run.Status, run.Failure)\n65-\t}\n66-\tif _, err := s.readAttemptReceipt(a); err != nil {\n67-\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n68-\t}\n69-\tif left, _ := filepath.Glob(filepath.Join(dir, a.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n70-\t\tt.Fatalf(\"the marker or its stall claim stayed: %v\", left)\n71-\t}\n72-\t// Released once: a second release finds nothing abandoned.\n73-\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n74-\t\tt.Fatalf(\"a released attempt was released again: %v\", err)\n75-\t}\n76-}\n77-\n78-// An attempt whose owner is alive is never released.\n79:func TestARunningAttemptIsNotReleased(t *testing.T) {\n80-\troot := t.TempDir()\n81-\ts := Store{Root: root}\n82-\tbundle := \"rvb-00000000000000a2\"\n83-\t// Silent for an hour, so only the owner's liveness keeps it running.\n84-\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n85-\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1, ReservedAt: old, Nonce: strings.Repeat(\"0\", 32)}\n86-\ta.AttemptID = attemptIdentity(a)\n87-\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n88-\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n89-\t\tt.Fatal(err)\n90-\t}\n91-\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n92-\towner.Host, _ = os.Hostname()\n93-\tidentifyStartLockProcess(&owner)\n94-\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"d\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: bundle, StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n95-\tdir, _ := s.delegationActiveDir(true)\n96-\traw, _ := json.Marshal(marker)\n97-\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n98-\t\tt.Fatal(err)\n99-\t}\n100-\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n101-\t\tt.Fatalf(\"a running attempt was released: %v\", err)\n--\n175-\tif err != nil {\n176-\t\tt.Fatal(err)\n177-\t}\n178-\tvar marker DelegationActiveRun\n179-\tif err := json.Unmarshal(raw, &marker); err != nil {\n180-\t\tt.Fatal(err)\n181-\t}\n182-\tdead := exec.Command(\"true\")\n183-\tif err := dead.Run(); err != nil {\n184-\t\tt.Fatal(err)\n185-\t}\n186-\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n187-\tmarker.Owner.PID, marker.HeartbeatAt, marker.StartedAt = dead.Process.Pid, old, old\n188-\traw, _ = json.Marshal(marker)\n189-\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n190-\t\tt.Fatal(err)\n191-\t}\n192-}\n193-\n194-// Review round 2, N4 (R6): a real dispatch interrupted after its reservation\n195-// and before its run record blocks the next dispatch; once released, the\n196-// next dispatch runs.\n197:func TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns(t *testing.T) {\n198-\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n199-\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n200-\tif err != nil {\n201-\t\tt.Fatal(err)\n202-\t}\n203-\tattempt := \"\"\n204-\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n205-\tfunc() {\n206-\t\tdefer func() { _ = recover() }()\n207-\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n208-\t}()\n209-\tif attempt == \"\" {\n210-\t\tt.Fatal(\"the dispatch never reached its start\")\n211-\t}\n212-\twriteDeadMarker(t, f.store, attempt)\n213-\tif _, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after interruption\"); err == nil || !strings.Contains(err.Error(), \"pose delegate cancel \"+attempt) {\n214-\t\tt.Fatalf(\"the interrupted attempt did not block the bundle with its release command: %v\", err)\n215-\t}\n216-\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil {\n217-\t\tt.Fatal(err)\n218-\t}\n219-\tnext, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\")\n220-\tif err != nil {\n221-\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n222-\t}\n223-\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n224-\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n225-\t}\n226-}\n227-\n228-// Review rounds 2 and 5 (N3, N1): one release runs at a time, under a lock\n229-// the operating system releases when its holder ends.\n230:func TestOneReleaseRunsAtATime(t *testing.T) {\n231-\troot := t.TempDir()\n232-\ts := Store{Root: root}\n233-\tattempt := \"rat-\" + strings.Repeat(\"9\", 64)\n234-\tdir, _ := s.delegationActiveDir(true)\n235-\tlockPath := filepath.Join(dir, attempt+\".release.lock\")\n236-\theld, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0o600)\n237-\tif err != nil {\n238-\t\tt.Fatal(err)\n239-\t}\n240-\tunlock, err := lockSpecTransferFile(held)\n241-\tif err != nil {\n242-\t\tt.Fatal(err)\n243-\t}\n244-\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\n245-\t\tt.Fatalf(\"a release ran while another held the lock: %v\", err)\n246-\t}\n247-\tunlock()\n248-\theld.Close()\n249-\t// A holder that ends releases the lock with it: nothing is left to take over.\n250-\tif _, err := exec.LookPath(\"flock\"); err == nil {\n251-\t\tholder := exec.Command(\"flock\", lockPath, \"sleep\", \"30\")\n252-\t\tholder.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n253-\t\tif err := holder.Start(); err != nil {\n254-\t\t\tt.Fatal(err)\n255-\t\t}\n256-\t\ttime.Sleep(200 * time.Millisecond)\n257-\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err == nil || !strings.Contains(err.Error(), \"in progress\") {\n258-\t\t\tt.Fatalf(\"the other process's lock was not seen: %v\", err)\n259-\t\t}\n260-\t\t_ = syscall.Kill(-holder.Process.Pid, syscall.SIGKILL)\n261-\t\t_ = holder.Wait()\n262-\t}\n263-\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil && strings.Contains(err.Error(), \"in progress\") {\n264-\t\tt.Fatalf(\"an ended holder's lock still blocks the release: %v\", err)\n265-\t}\n266-}\n267-\n268-// Review round 3, N1: a release interrupted after it recorded the run, and\n269-// before the receipt, completes with that run instead of recording another.\n270:func TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n271-\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n272-\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n273-\tif err != nil {\n274-\t\tt.Fatal(err)\n275-\t}\n276-\tattempt := \"\"\n277-\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n278-\tfunc() {\n279-\t\tdefer func() { _ = recover() }()\n280-\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n281-\t}()\n282-\twriteDeadMarker(t, f.store, attempt)\n283-\tactiveDir, _ := f.store.delegationActiveDir(false)\n284-\tmarkerPath := filepath.Join(activeDir, attempt+\".json\")\n285-\tmarkerBytes, err := os.ReadFile(markerPath)\n286-\tif err != nil {\n287-\t\tt.Fatal(err)\n288-\t}\n289-\tfirst, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n290-\tif err != nil {\n291-\t\tt.Fatal(err)\n292-\t}\n--\n347-\tif _, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"--confirm-abandoned\") {\n348-\t\tt.Fatalf(\"a markerless reservation was released without confirmation: %v\", err)\n349-\t}\n350-\trun, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n351-\tif err != nil || run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"operator's confirmation\") {\n352-\t\tt.Fatalf(\"release: %+v %v\", run, err)\n353-\t}\n354-\tif _, err := s.readAttemptReceipt(old); err != nil {\n355-\t\tt.Fatalf(\"the released reservation still blocks its bundle: %v\", err)\n356-\t}\n357-\t// Review round 4, N1: a release stopped between its run and its receipt\n358-\t// leaves the attempt with a run; it is still released, with that run.\n359-\tif err := os.Remove(attemptReceiptPath(root, old)); err != nil {\n360-\t\tt.Fatal(err)\n361-\t}\n362-\tagain, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n363-\tif err != nil || again.RunID != run.RunID {\n364-\t\tt.Fatalf(\"the interrupted release did not complete with its run: %s then %s (%v)\", run.RunID, again.RunID, err)\n365-\t}\n366-}\n367-\n368-// Review round 3, N3: an unreadable reservation is reported, not skipped.\n369:func TestAnUnreadableReservationIsReportedAsALoss(t *testing.T) {\n370-\troot := t.TempDir()\n371-\ts := Store{Root: root}\n372-\tdir := filepath.Join(root, reviewAttemptDir, \"broken\")\n373-\tif err := os.MkdirAll(dir, 0o755); err != nil {\n374-\t\tt.Fatal(err)\n375-\t}\n376-\tif err := os.WriteFile(filepath.Join(dir, \"000001.json\"), []byte(\"{not json\"), 0o644); err != nil {\n377-\t\tt.Fatal(err)\n378-\t}\n379-\t_, lost, err := s.ListDelegationAttempts()\n380-\tif err != nil || !strings.Contains(strings.Join(lost, \"\\n\"), \"broken/000001.json could not be read\") {\n381-\t\tt.Fatalf(\"an unreadable reservation was skipped silently: %v %v\", lost, err)\n382-\t}\n383-}\n384-\n385-// Review round 4, N3: with the run history incomplete, no reservation is\n386-// taken as runless, and the loss is reported.\n387-func TestAnIncompleteRunHistoryRulesNothingOut(t *testing.T) {\n388-\troot := t.TempDir()\n389-\ts := Store{Root: root}\n390-\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000c1\", BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n391-\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"3\", 32)}\n--\n396-\t}\n397-\tif err := os.MkdirAll(filepath.Join(root, reviewRunsDir), 0o755); err != nil {\n398-\t\tt.Fatal(err)\n399-\t}\n400-\tif err := os.WriteFile(filepath.Join(root, reviewRunsDir, \"rrn-0000000000000bad.json\"), []byte(\"{broken\"), 0o644); err != nil {\n401-\t\tt.Fatal(err)\n402-\t}\n403-\tif _, runLost, err := s.ReadReviewRuns(\"\"); err != nil || len(runLost) == 0 {\n404-\t\tt.Skipf(\"the fixture does not make the run history incomplete: %v %v\", runLost, err)\n405-\t}\n406-\torphans, lost, err := s.orphanReservations(time.Now())\n407-\tif err != nil || len(orphans) != 0 || !strings.Contains(strings.Join(lost, \"\\n\"), \"run history is incomplete\") {\n408-\t\tt.Fatalf(\"an incomplete history ruled a run out: %v %v %v\", orphans, lost, err)\n409-\t}\n410-\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n411-\t\tt.Fatal(\"a reservation was released over an incomplete run history\")\n412-\t}\n413-}\n414-\n415-// Review round 5, N3: a dispatch that recorded its run and stopped before\n416-// the receipt is completed with that run, not with a second one; N2: a\n417-// release that stopped after the receipt only removes the marker.\n418:func TestARecordedRunCompletesItsAttempt(t *testing.T) {\n419-\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n420-\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"receipt lost\")\n421-\tif err != nil {\n422-\t\tt.Fatal(err)\n423-\t}\n424-\tsaved := beforeRunResultPublished\n425-\tt.Cleanup(func() { beforeRunResultPublished = saved })\n426-\trecorded := \"\"\n427-\tbeforeRunResultPublished = func(r ReviewRun) { recorded = r.RunID; panic(\"the dispatching process ends before the receipt\") }\n428-\tfunc() {\n429-\t\tdefer func() { _ = recover() }()\n430-\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n431-\t}()\n432-\tbeforeRunResultPublished = saved\n433-\truns, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID)\n434-\tif recorded == \"\" || len(runs) == 0 {\n435-\t\tt.Fatalf(\"the dispatch recorded no run: %q %d\", recorded, len(runs))\n436-\t}\n437-\tattempt := runs[len(runs)-1].AttemptID\n438-\twriteDeadMarker(t, f.store, attempt)\n439-\tactiveDir, _ := f.store.delegationActiveDir(false)\n440-\tmarkerBytes, _ := os.ReadFile(filepath.Join(activeDir, attempt+\".json\"))\n441-\treleased, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n442-\tif err != nil || released.RunID != recorded {\n443-\t\tt.Fatalf(\"the release did not complete with the recorded run %s: %s %v\", recorded, released.RunID, err)\n444-\t}\n445-\tif after, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID); len(after) != len(runs) {\n446-\t\tt.Fatalf(\"the release recorded another run: %d then %d\", len(runs), len(after))\n447-\t}\n448-\t// The marker comes back, as a release stopped after the receipt leaves it.\n449-\tif err := os.WriteFile(filepath.Join(activeDir, attempt+\".json\"), markerBytes, 0o600); err != nil {\n450-\t\tt.Fatal(err)\n451-\t}\n452-\tagain, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n453-\tif err != nil || again.RunID != recorded {\n454-\t\tt.Fatalf(\"a release after the receipt did not complete: %s %v\", again.RunID, err)\n455-\t}\n456-\tif left, _ := filepath.Glob(filepath.Join(activeDir, attempt+\".json\")); len(left) != 0 {\n457-\t\tt.Fatal(\"the stalled marker stayed after the receipt\")\n458-\t}\n459-}\n460-\n461-// Review round 6, N1: an unreadable active marker may be a live attempt's,\n462-// so no reservation is taken as markerless.\n463:func TestAnUnreadableMarkerRulesNothingOut(t *testing.T) {\n464-\troot := t.TempDir()\n465-\ts := Store{Root: root}\n466-\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000d1\", BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n467-\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"4\", 32)}\n468-\ta.AttemptID = attemptIdentity(a)\n469-\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n470-\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n471-\t\tt.Fatal(err)\n472-\t}\n473-\tdir, _ := s.delegationActiveDir(true)\n474-\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), []byte(\"{damaged\"), 0o600); err != nil {\n475-\t\tt.Fatal(err)\n476-\t}\n477-\torphans, lost, err := s.orphanReservations(time.Now())\n478-\tif err != nil || len(orphans) != 0 || !strings.Contains(strings.Join(lost, \"\\n\"), \"active marker is unreadable\") {\n479-\t\tt.Fatalf(\"an unreadable marker let a reservation pass as markerless: %v %v %v\", orphans, lost, err)\n480-\t}\n481-\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n482-\t\tt.Fatal(\"a reservation with an unreadable marker was released\")\n483-\t}\n484-}\n","exit_code":0,"status":"completed"}}
