g, marker DelegationActiveRun) string {\n   204\t\treturn filepath.Join(dir, marker.AttemptID+\".\"+marker.RunToken+\".stalled\")\n   205\t}\n   206\t\n   207\tfunc readDelegationStall(dir string, marker DelegationActiveRun) string {\n   208\t\traw, err := readLedgerRaw(stallClaimPath(dir, marker))\n   209\t\tif err != nil {\n   210\t\t\treturn \"\"\n   211\t\t}\n   212\t\treturn strings.TrimSpace(string(raw))\n   213\t}\n   214\t\n   215\t// recordDelegationStall publishes the stall claim exclusively: the first\n   216\t// reader's instant is the one every reader returns, so concurrent readers\n   217\t// agree (R4).\n   218\tfunc recordDelegationStall(dir string, marker DelegationActiveRun) string {\n   219\t\tat := time.Now().UTC().Format(time.RFC3339Nano)\n   220\t\t_ = PublishFile(stallClaimPath(dir, marker), []byte(at+\"\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n    95\t\t\trow, ok := byAttempt[key]\n    96\t\t\tif !ok {\n    97\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    98\t\t\t\tbyAttempt[key] = row\n    99\t\t\t\torder = append(order, key)\n   100\t\t\t}\n   101\t\t\trow.Runs = append(row.Runs, run.RunID)\n   102\t\t\trow.latest = &runs[i]\n   103\t\t\tif run.SessionDigest != \"\" {\n   104\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   105\t\t\t\t\trow.sessions = append(row.sessions, value)\n   106\t\t\t\t}\n   107\t\t\t}\n   108\t\t\tevents, err := s.ReadDelegationEvents(run)\n   109\t\t\tif err != nil {\n   110\t\t\t\t// A turn count read from nothing would report a whole history.\n   111\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   112\t\t\t} else {\n   113\t\t\t\tfor _, e := range events {\n   114\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   115\t\t\t\t\t\trow.Turns++\n   116\t\t\t\t\t}\n   117\t\t\t\t}\n   118\t\t\t\tif len(events) > 0 {\n   119\t\t\t\t\trow.LastStep = delegationStepText(ev