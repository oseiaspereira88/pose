{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/cmd/pose/main.go | sed -n '1,100p'; nl -ba pose-mcp/internal/cli/cli.go | sed -n '1,100p'\"","aggregated_output":"     1\t// pose is the native-only unified POSE CLI and MCP server.\n     2\tpackage main\n     3\t\n     4\timport (\n     5\t\t\"os\"\n     6\t\t\"path/filepath\"\n     7\t\n     8\t\t\"github.com/harne8/pose-mcp/internal/cli\"\n     9\t\t\"github.com/harne8/pose-mcp/internal/pose\"\n    10\t)\n    11\t\n    12\tfunc main() {\n    13\t\tpose.ReviewShimAvailable = true\n    14\t\tif base := filepath.Base(os.Args[0]); base == \"pre-commit\" || base == \"post-merge\" {\n    15\t\t\tos.Exit(cli.HookMain(base, os.Stdout, os.Stderr))\n    16\t\t}\n    17\t\tos.Exit(cli.Main(os.Args[1:], os.Stdout, os.Stderr))\n    18\t}\n     1\t// Package cli implements the native-only unified `pose` binary.\n     2\tpackage cli\n     3\t\n     4\timport (\n     5\t\t\"fmt\"\n     6\t\t\"io\"\n     7\t\t\"os\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strings\"\n    10\t\n    11\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    12\t\t\"github.com/harne8/pose-mcp/internal/version\"\n    13\t)\n    14\t\n    15\t// Version mirrors the authoritative release version. The release pipeline\n    16\t// stamps internal/version via -ldflags (spec pose-version-contract).\n    17\tvar Version = version.Version\n    18\t\n    19\t// The engine package records the version in assessment bindings without\n    20\t// importing internal/version (spec pose-engine-package-stays-mirrorable).\n    21\tfunc init() {\n    22\t\tposemodel.EngineVersion = version.Version\n    23\t\tposemodel.EngineReleaseBase = version.ReleaseBase()\n    24\t}\n    25\t\n    26\t// Main is the entrypoint used by cmd/pose. It returns the process exit code.\n    27\tfunc Main(args []string, stdout, stderr io.Writer) int {\n    28\t\tif len(args) > 0 && args[0] == posemodel.ReviewShimArg {\n    29\t\t\treturn posemodel.RunReviewShim(args[1:])\n    30\t\t}\n    31\t\treturn mainWithUsage(args, stdout, stderr)\n    32\t}\n    33\t\n    34\tfunc mainCommand(args []string, stdout, stderr io.Writer) int {\n    35\t\tlocale := cliLocaleFor(stderr)\n    36\t\tcmd := \"help\"\n    37\t\tif len(args) > 0 {\n    38\t\t\tcmd = args[0]\n    39\t\t\targs = args[1:]\n    40\t\t}\n    41\t\n    42\t\tif cmd == \"help\" {\n    43\t\t\treturn cmdHelp(stdout, args)\n    44\t\t}\n    45\t\n    46\t\tif hasHelpFlag(args) || cmd == \"-h\" || cmd == \"--help\" {\n    47\t\t\tif cmd == \"-h\" || cmd == \"--help\" {\n    48\t\t\t\treturn cmdHelp(stdout, nil)\n    49\t\t\t}\n    50\t\t\tif dispatchCommandHelp(cmd, args, stdout, locale) {\n    51\t\t\t\treturn 0\n    52\t\t\t}\n    53\t\t\treturn cmdHelp(stdout, []string{cmd})\n    54\t\t}\n    55\t\n    56\t\tswitch cmd {\n    57\t\tcase \"version\", \"--version\", \"-v\":\n    58\t\t\ttarget := \"\"\n    59\t\t\tif len(args) > 0 {\n    60\t\t\t\ttarget = args[0]\n    61\t\t\t}\n    62\t\t\treturn cmdVersion(stdout, target)\n    63\t\tcase \"init\":\n    64\t\t\troot, err := projectRoot()\n    65\t\t\tif err != nil {\n    66\t\t\t\tfmt.Fprintf(stderr, \"pose init: %v\\n\", err)\n    67\t\t\t\treturn 1\n    68\t\t\t}\n    69\t\t\treturn cmdInitCommand(root, args, stdout, stderr)\n    70\t\tcase \"context\":\n    71\t\t\troot, err := projectRoot()\n    72\t\t\tif err != nil {\n    73\t\t\t\trender(io.Discard, stderr).Failure(\"pose context: \" + err.Error())\n    74\t\t\t\treturn 1\n    75\t\t\t}\n    76\t\t\treturn cmdProjectContext(root, args, stdout, stderr)\n    77\t\tcase \"new-spec\":\n    78\t\t\troot, err := projectRoot()\n    79\t\t\tif err != nil {\n    80\t\t\t\tfmt.Fprintf(stderr, \"pose new-spec: %v\\n\", err)\n    81\t\t\t\treturn 1\n    82\t\t\t}\n    83\t\t\treturn cmdNewSpec(root, args, stdout, stderr)\n    84\t\tcase \"new-spec-qualified\":\n    85\t\t\troot, err := projectRoot()\n    86\t\t\tif err != nil {\n    87\t\t\t\trender(io.Discard, stderr).Failure(\"pose new-spec-qualified: \" + err.Error())\n    88\t\t\t\treturn 1\n    89\t\t\t}\n    90\t\t\treturn cmdNewSpecQualified(root, args, stdout, stderr)\n    91\t\tcase \"new-roadmap\":\n    92\t\t\troot, err := projectRoot()\n    93\t\t\tif err != nil {\n    94\t\t\t\tfmt.Fprintf(stderr, \"pose new-roadmap: %v\\n\", err)\n    95\t\t\t\treturn 1\n    96\t\t\t}\n    97\t\t\treturn cmdNewRoadmap(root, args, stdout, stderr)\n    98\t\tcase \"new-adr\":\n    99\t\t\troot, err := projectRoot()\n   100\t\t\tif err != nil {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '181,320p'\"","aggregated_output":"   181\t\t}\n   182\t\treturn *latest, true, nil\n   183\t}\n   184\t\n   185\t// orphanReservations lists the reservations left without a receipt or a\n   186\t// marker, older than reviewOrphanReservationAge, and\n   187\t// says which reservations or receipts it could not read (review round 3, N3).\n   188\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   189\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   190\t\tdirs, err := os.ReadDir(base)\n   191\t\tif errors.Is(err, os.ErrNotExist) {\n   192\t\t\treturn nil, nil, nil\n   193\t\t}\n   194\t\tif err != nil {\n   195\t\t\treturn nil, nil, err\n   196\t\t}\n   197\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   198\t\tif err != nil {\n   199\t\t\treturn nil, nil, err\n   200\t\t}\n   201\t\tif len(markerLost) > 0 {\n   202\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   203\t\t\t// have no marker (review round 6, N1).\n   204\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   205\t\t}\n   206\t\tmarked := map[string]bool{}\n   207\t\tfor _, m := range markers {\n   208\t\t\tmarked[m.AttemptID] = true\n   209\t\t}\n   210\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   211\t\tif err != nil {\n   212\t\t\treturn nil, nil, err\n   213\t\t}\n   214\t\tif len(runLost) > 0 {\n   215\t\t\t// Without the whole run history nothing is known to have no run.\n   216\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   217\t\t}\n   218\t\t// A recorded run does not finish an attempt, its receipt does: a\n   219\t\t// reservation whose run was recorded without a receipt still blocks and\n   220\t\t// is released with that run (review round 5, N3).\n   221\t\t_ = runs\n   222\t\tvar out []DelegatedReviewAttempt\n   223\t\tvar lost []string\n   224\t\tbudget := reviewReadBudget(nil)\n   225\t\tfor _, d := range dirs {\n   226\t\t\tif !d.IsDir() {\n   227\t\t\t\tcontinue\n   228\t\t\t}\n   229\t\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n   230\t\t\tif err != nil {\n   231\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   232\t\t\t\tcontinue\n   233\t\t\t}\n   234\t\t\tfor _, e := range entries {\n   235\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   236\t\t\t\t\tcontinue\n   237\t\t\t\t}\n   238\t\t\t\tvar a DelegatedReviewAttempt\n   239\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   240\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   241\t\t\t\t\tcontinue\n   242\t\t\t\t}\n   243\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif marked[a.AttemptID] {\n   248\t\t\t\t\tcontinue\n   249\t\t\t\t}\n   250\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   251\t\t\t\t\tcontinue\n   252\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   253\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   254\t\t\t\t\tcontinue\n   255\t\t\t\t}\n   256\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   257\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   258\t\t\t\t\tcontinue\n   259\t\t\t\t}\n   260\t\t\t\tout = append(out, a)\n   261\t\t\t}\n   262\t\t}\n   263\t\treturn out, lost, nil\n   264\t}\n   265\t\n   266\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   267\t\tdir, err := s.delegationActiveDir(false)\n   268\t\tif err != nil {\n   269\t\t\treturn err\n   270\t\t}\n   271\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   272\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   273\t\t\t\treturn err\n   274\t\t\t}\n   275\t\t}\n   276\t\treturn nil\n   277\t}\n","exit_code":0,"status":"completed"}}
