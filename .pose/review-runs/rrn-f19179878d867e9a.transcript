the run's subtree once the adapter\n  1063\t\t// exited; a shim ended by the group kill (a timeout) leaves no report.\n  1064\t\t_, reportStatErr := os.Lstat(shimReport)\n  1065\t\tif shimReport != \"\" && reapErr == nil && (reportStatErr == nil || cmd.ProcessState != nil && cmd.ProcessState.Exited()) {\n  1066\t\t\tif report, err := readReviewShimReport(shimReport); err != nil {\n  1067\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1068\t\t\t} else {\n  1069\t\t\t\tfor _, pid := range report.Ended {\n  1070\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1071\t\t\t\t}\n  1072\t\t\t\tif report.Error != \"\" {\n  1073\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1074\t\t\t\t}\n  1075\t\t\t}\n  1076\t\t}\n  1077\t\tif len(reaped) > 0 && safety != nil {\n  1078\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n  1079\t\t}\n  1080\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1081\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1082\t\t}\n  1083\t\tterminationFailed = terminationErr != nil\n  1084\t\t// The adapter exited and a child it left still held the output when\n  1085\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1086\t\t// the exit status decides (found in review).\n  1087\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1088\t\t\trunErr = nil\n  1089\t\t}\n  1090\t\ttranscript, overflow := combined.result()\n  1091\t\tsafety.CaptureComplete = !overflow\n  1092\t\tif cmd.ProcessState != nil {\n  1093\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1094\t\t}\n  1095\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_82","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '1,145p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"os\"\n    28\t\t\"path/filepath\"\n    29\t\t\"strings\"\n    30\t\t\"time\"\n    31\t)\n    32\t\n    33\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    34\t// proven abandoned.\n    35\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    36\t\n    37\t// reviewOrphanReservationAge is how old a reservation without any marker\n    38\t// must be to count as abandoned.\n    39\tconst reviewOrphanReservationAge = 10 * time.Minute\n    40\t\n    41\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    42\t// dispatch ended before recording it, and removes its stalled marker. A\n    43\t// stalled marker whose reservation was never published is only removed; the\n    44\t// returned run is then empty.\n    45\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    46\t\tif !validAttemptFileName(attemptID) {\n    47\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    48\t\t}\n    49\t\tmarkers, _, err := s.ListDelegationActive()\n    50\t\tif err != nil {\n    51\t\t\treturn ReviewRun{}, err\n    52\t\t}\n    53\t\tvar marker *DelegationActiveRun\n    54\t\tfor i := range markers {\n    55\t\t\tif markers[i].AttemptID == attemptID {\n    56\t\t\t\tmarker = &markers[i]\n    57\t\t\t}\n    58\t\t}\n    59\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    60\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    61\t\t}\n    62\t\tdir, err := s.delegationActiveDir(true)\n    63\t\tif err != nil {\n    64\t\t\treturn ReviewRun{}, err\n    65\t\t}\n    66\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    67\t\tif err != nil {\n    68\t\t\treturn ReviewRun{}, err\n    69\t\t}\n    70\t\tdefer lock.Close()\n    71\t\tunlock, err := lockSpecTransferFile(lock)\n    72\t\tif err != nil {\n    73\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    74\t\t}\n    75\t\tdefer unlock()\n    76\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    77\t}\n    78\t\n    79\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    80\t\tvar reserved *DelegatedReviewAttempt\n    81\t\tif marker != nil {\n    82\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    83\t\t\tif err != nil {\n    84\t\t\t\treturn ReviewRun{}, err\n    85\t\t\t}\n    86\t\t\tfor i := range attempts {\n    87\t\t\t\tif attempts[i].AttemptID == attemptID {\n    88\t\t\t\t\treserved = &attempts[i]\n    89\t\t\t\t}\n    90\t\t\t}\n    91\t\t\tif reserved == nil {\n    92\t\t\t\t// The dispatch ended between its marker and its reservation:\n    93\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    94\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    95\t\t\t}\n    96\t\t} else {\n    97\t\t\tif !operatorConfirmed {\n    98\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n    99\t\t\t}\n   100\t\t\torphans, _, err := s.orphanReservations(now)\n   101\t\t\tif err != nil {\n   102\t\t\t\treturn ReviewRun{}, err\n   103\t\t\t}\n   104\t\t\tfor i := range orphans {\n   105\t\t\t\tif orphans[i].AttemptID == attemptID {\n   106\t\t\t\t\treserved = &orphans[i]\n   107\t\t\t\t}\n   108\t\t\t}\n   109\t\t\tif reserved == nil {\n   110\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   111\t\t\t}\n   112\t\t}\n   113\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   114\t\t\t// A release that stopped after the receipt completes by removing\n   115\t\t\t// the stalled marker; with no marker there is nothing to release.\n   116\t\t\tif marker != nil {\n   117\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   118\t\t\t\tif err != nil {\n   119\t\t\t\t\treturn ReviewRun{}, err\n   120\t\t\t\t}\n   121\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   122\t\t\t\tif err != nil {\n   123\t\t\t\t\treturn ReviewRun{}, err\n   124\t\t\t\t}\n   125\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   126\t\t\t}\n   127\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   128\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   129\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   130\t\t}\n   131\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   132\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   133\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   134\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   135\t\tif marker != nil {\n   136\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   137\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   138\t\t} else {\n   139\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   140\t\t}\n   141\t\t// A run the attempt already recorded, by its dispatch or by a release\n   142\t\t// interrupted before the receipt, completes the attempt; no second run\n   143\t\t// is written for it.\n   144\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   145\t\tif err != nil {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_83","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux_test.go | sed -n '1,145p'; nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '70,130p'; nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '185,280p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os\"\n     7\t\t\"os/exec\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strconv\"\n    10\t\t\"strings\"\n    11\t\t\"syscall\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\t// Review round 1, N3: a pid that no longer names a process of the run, as\n    17\t// after reuse by an unrelated process, is never signalled.\n    18\tfunc TestAPidThatLostTheRunsEntryIsNotKilled(t *testing.T) {\n    19\t\tother := exec.Command(\"sleep\", \"30\")\n    20\t\tif err := other.Start(); err != nil {\n    21\t\t\tt.Fatal(err)\n    22\t\t}\n    23\t\tfor i := 0; i < 200 && reviewProcessName(other.Process.Pid) != \"sleep\"; i++ {\n    24\t\t\ttime.Sleep(10 * time.Millisecond)\n    25\t\t}\n    26\t\tt.Cleanup(func() { _ = other.Process.Kill(); _ = other.Wait() })\n    27\t\tentry := []byte(SealedCheckoutEnv + \"=/nonexistent/run-checkout\")\n    28\t\tif err := killPinnedMarkedProcess(other.Process.Pid, entry); err != nil {\n    29\t\t\tt.Fatal(err)\n    30\t\t}\n    31\t\ttime.Sleep(100 * time.Millisecond)\n    32\t\tif zombie, err := reviewProcessZombie(other.Process.Pid); err != nil || zombie {\n    33\t\t\tt.Fatalf(\"a process without the run's entry was killed: zombie=%t %v\", zombie, err)\n    34\t\t}\n    35\t\t// The same process carrying the entry is ended.\n    36\t\tmarked := exec.Command(\"sleep\", \"30\")\n    37\t\tmarked.Env = append(marked.Environ(), string(entry))\n    38\t\tif err := marked.Start(); err != nil {\n    39\t\t\tt.Fatal(err)\n    40\t\t}\n    41\t\t// Until exec, /proc shows the parent's environment.\n    42\t\tfor i := 0; i < 200; i++ {\n    43\t\t\tif ok, _ := reviewProcessMarked(marked.Process.Pid, entry); ok {\n    44\t\t\t\tbreak\n    45\t\t\t}\n    46\t\t\ttime.Sleep(10 * time.Millisecond)\n    47\t\t}\n    48\t\tif err := killPinnedMarkedProcess(marked.Process.Pid, entry); err != nil {\n    49\t\t\tt.Fatal(err)\n    50\t\t}\n    51\t\tif err := marked.Wait(); err == nil {\n    52\t\t\tt.Fatal(\"the marked process was not ended\")\n    53\t\t}\n    54\t}\n    55\t\n    56\t// opaqueProcess starts a process of this user whose environment cannot be\n    57\t// read (it makes itself non-dumpable), or skips without python3.\n    58\tfunc opaqueProcess(t *testing.T) *exec.Cmd {\n    59\t\tt.Helper()\n    60\t\tif _, err := exec.LookPath(\"python3\"); err != nil {\n    61\t\t\tt.Skip(\"python3 is not available\")\n    62\t\t}\n    63\t\tcmd := exec.Command(\"python3\", \"-c\", \"import ctypes,time; ctypes.CDLL(None).prctl(4,0,0,0,0); time.sleep(30)\")\n    64\t\tif err := cmd.Start(); err != nil {\n    65\t\t\tt.Fatal(err)\n    66\t\t}\n    67\t\tt.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })\n    68\t\tfor i := 0; i < 300; i++ {\n    69\t\t\tif _, err := reviewProcessMarked(cmd.Process.Pid, []byte(\"x\")); err != nil && !reviewProcessGoneErr(err) {\n    70\t\t\t\treturn cmd\n    71\t\t\t}\n    72\t\t\ttime.Sleep(10 * time.Millisecond)\n    73\t\t}\n    74\t\tt.Skip(\"the process never became non-inspectable\")\n    75\t\treturn nil\n    76\t}\n    77\t\n    78\t// Review round 2, N2: a non-inspectable process that existed before the run\n    79\t// is not the run's; one that started during it may be, and the scan fails\n    80\t// instead of reporting the run's processes ended.\n    81\tfunc TestANonInspectableProcessStartedDuringTheRunFailsTheScan(t *testing.T) {\n    82\t\tbefore := opaqueProcess(t)\n    83\t\tbaseline := reviewOpaqueProcessBaseline()\n    84\t\tif _, ok := baseline[before.Process.Pid]; !ok {\n    85\t\t\tt.Fatalf(\"the baseline misses process %d\", before.Process.Pid)\n    86\t\t}\n    87\t\tif _, opaque, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err != nil || opaque == 0 {\n    88\t\t\tt.Fatalf(\"a process that predates the run failed the scan or was not counted: %d %v\", opaque, err)\n    89\t\t}\n    90\t\tduring := opaqueProcess(t)\n    91\t\tif _, _, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err == nil || !strings.Contains(err.Error(), \"started during the run\") {\n    92\t\t\tt.Fatalf(\"process %d, started during the run, did not fail the scan: %v\", during.Process.Pid, err)\n    93\t\t}\n    94\t}\n    95\t\n    96\t// Review round 6, N2: a descendant that leaves the group, starts its own\n    97\t// session and clears its environment is still ended with the run.\n    98\tfunc TestAnOrphanThatClearedItsEnvironmentIsEnded(t *testing.T) {\n    99\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   100\t\t\tt.Skip(\"setsid is not available\")\n   101\t\t}\n   102\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   103\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   104\t\t\ta.Containment = containmentPolicy()\n   105\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & ` +\n   106\t\t\t\t`i=0; while [ ! -s \"$1\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`, \"sh\", pidFile}\n   107\t\t})\n   108\t\traw, err := os.ReadFile(pidFile)\n   109\t\tif err != nil {\n   110\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   111\t\t}\n   112\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   113\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   114\t\tif zombie, err := reviewProcessZombie(pid); err == nil && !zombie {\n   115\t\t\tt.Fatalf(\"the orphan that cleared its environment survived the run (status %s: %s)\", f.run.Status, f.run.Failure)\n   116\t\t}\n   117\t\tif f.run.Status != ReviewRunCompleted || !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), \"(orphaned)\") {\n   118\t\t\tt.Fatalf(\"the run did not complete naming the orphan: %s %s %v\", f.run.Status, f.run.Failure, f.run.Safety.Limitations)\n   119\t\t}\n   120\t\t// Review round 7, N4: the record names the pid, never the process name\n   121\t\t// the reviewer chose.\n   122\t\tfor _, limit := range f.run.Safety.Limitations {\n   123\t\t\tif strings.Contains(limit, \"(orphaned)\") && strings.Contains(limit, \" sh \") {\n   124\t\t\t\tt.Fatalf(\"the recorded limitation carries a process name: %q\", limit)\n   125\t\t\t}\n   126\t\t}\n   127\t\tif !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), strconv.Itoa(pid)+\" (orphaned)\") {\n   128\t\t\tt.Fatalf(\"the recorded limitation does not name the pid: %v\", f.run.Safety.Limitations)\n   129\t\t}\n   130\t}\n    70\t\t\tt.Fatalf(\"the marker or its stall claim stayed: %v\", left)\n    71\t\t}\n    72\t\t// Released once: a second release finds nothing abandoned.\n    73\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n    74\t\t\tt.Fatalf(\"a released attempt was released again: %v\", err)\n    75\t\t}\n    76\t}\n    77\t\n    78\t// An attempt whose owner is alive is never released.\n    79\tfunc TestARunningAttemptIsNotReleased(t *testing.T) {\n    80\t\troot := t.TempDir()\n    81\t\ts := Store{Root: root}\n    82\t\tbundle := \"rvb-00000000000000a2\"\n    83\t\t// Silent for an hour, so only the owner's liveness keeps it running.\n    84\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n    85\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1, ReservedAt: old, Nonce: strings.Repeat(\"0\", 32)}\n    86\t\ta.AttemptID = attemptIdentity(a)\n    87\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    88\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    89\t\t\tt.Fatal(err)\n    90\t\t}\n    91\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    92\t\towner.Host, _ = os.Hostname()\n    93\t\tidentifyStartLockProcess(&owner)\n    94\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"d\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: bundle, StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n    95\t\tdir, _ := s.delegationActiveDir(true)\n    96\t\traw, _ := json.Marshal(marker)\n    97\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n    98\t\t\tt.Fatal(err)\n    99\t\t}\n   100\t\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n   101\t\t\tt.Fatalf(\"a running attempt was released: %v\", err)\n   102\t\t}\n   103\t}\n   104\t\n   105\t// Review round 1, N1: the dispatch marks the attempt active before it\n   106\t// publishes the reservation, so no instant leaves a reservation without a\n   107\t// marker that turns stalled.\n   108\tfunc TestTheAttemptIsMarkedActiveBeforeItIsReserved(t *testing.T) {\n   109\t\tvar checked bool\n   110\t\tbeforeAttemptPublished = func(store Store, a DelegatedReviewAttempt) {\n   111\t\t\tchecked = true\n   112\t\t\tmarkers, _, err := store.ListDelegationActive()\n   113\t\t\tfound := false\n   114\t\t\tfor _, m := range markers {\n   115\t\t\t\tfound = found || m.AttemptID == a.AttemptID\n   116\t\t\t}\n   117\t\t\tif err != nil || !found {\n   118\t\t\t\tt.Errorf(\"the reservation of %s is published with no active marker: %v\", a.AttemptID, err)\n   119\t\t\t}\n   120\t\t\tif _, err := os.Lstat(reviewAttemptPath(store.Root, a)); !errors.Is(err, os.ErrNotExist) {\n   121\t\t\t\tt.Errorf(\"the reservation was published before the marker: %v\", err)\n   122\t\t\t}\n   123\t\t}\n   124\t\tt.Cleanup(func() { beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {} })\n   125\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\")\n   126\t\tif !checked {\n   127\t\t\tt.Fatal(\"the dispatch never reached the reservation\")\n   128\t\t}\n   129\t}\n   130\t\n   185\t\t}\n   186\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   187\t\tmarker.Owner.PID, marker.HeartbeatAt, marker.StartedAt = dead.Process.Pid, old, old\n   188\t\traw, _ = json.Marshal(marker)\n   189\t\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n   190\t\t\tt.Fatal(err)\n   191\t\t}\n   192\t}\n   193\t\n   194\t// Review round 2, N4 (R6): a real dispatch interrupted after its reservation\n   195\t// and before its run record blocks the next dispatch; once released, the\n   196\t// next dispatch runs.\n   197\tfunc TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns(t *testing.T) {\n   198\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   199\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   200\t\tif err != nil {\n   201\t\t\tt.Fatal(err)\n   202\t\t}\n   203\t\tattempt := \"\"\n   204\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   205\t\tfunc() {\n   206\t\t\tdefer func() { _ = recover() }()\n   207\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   208\t\t}()\n   209\t\tif attempt == \"\" {\n   210\t\t\tt.Fatal(\"the dispatch never reached its start\")\n   211\t\t}\n   212\t\twriteDeadMarker(t, f.store, attempt)\n   213\t\tif _, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after interruption\"); err == nil || !strings.Contains(err.Error(), \"pose delegate cancel \"+attempt) {\n   214\t\t\tt.Fatalf(\"the interrupted attempt did not block the bundle with its release command: %v\", err)\n   215\t\t}\n   216\t\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil {\n   217\t\t\tt.Fatal(err)\n   218\t\t}\n   219\t\tnext, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\")\n   220\t\tif err != nil {\n   221\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n   222\t\t}\n   223\t\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n   224\t\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n   225\t\t}\n   226\t}\n   227\t\n   228\t// Review rounds 2 and 5 (N3, N1): one release runs at a time, under a lock\n   229\t// the operating system releases when its holder ends.\n   230\tfunc TestOneReleaseRunsAtATime(t *testing.T) {\n   231\t\troot := t.TempDir()\n   232\t\ts := Store{Root: root}\n   233\t\tattempt := \"rat-\" + strings.Repeat(\"9\", 64)\n   234\t\tdir, _ := s.delegationActiveDir(true)\n   235\t\tlockPath := filepath.Join(dir, attempt+\".release.lock\")\n   236\t\theld, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0o600)\n   237\t\tif err != nil {\n   238\t\t\tt.Fatal(err)\n   239\t\t}\n   240\t\tunlock, err := lockSpecTransferFile(held)\n   241\t\tif err != nil {\n   242\t\t\tt.Fatal(err)\n   243\t\t}\n   244\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\n   245\t\t\tt.Fatalf(\"a release ran while another held the lock: %v\", err)\n   246\t\t}\n   247\t\tunlock()\n   248\t\theld.Close()\n   249\t\t// A holder that ends releases the lock with it: nothing is left to take over.\n   250\t\tif _, err := exec.LookPath(\"flock\"); err == nil {\n   251\t\t\tholder := exec.Command(\"flock\", lockPath, \"sleep\", \"30\")\n   252\t\t\tholder.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n   253\t\t\tif err := holder.Start(); err != nil {\n   254\t\t\t\tt.Fatal(err)\n   255\t\t\t}\n   256\t\t\ttime.Sleep(200 * time.Millisecond)\n   257\t\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err == nil || !strings.Contains(err.Error(), \"in progress\") {\n   258\t\t\t\tt.Fatalf(\"the other process's lock was not seen: %v\", err)\n   259\t\t\t}\n   260\t\t\t_ = syscall.Kill(-holder.Process.Pid, syscall.SIGKILL)\n   261\t\t\t_ = holder.Wait()\n   262\t\t}\n   263\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil && strings.Contains(err.Error(), \"in progress\") {\n   264\t\t\tt.Fatalf(\"an ended holder's lock still blocks the release: %v\", err)\n   265\t\t}\n   266\t}\n   267\t\n   268\t// Review round 3, N1: a release interrupted after it recorded the run, and\n   269\t// before the receipt, completes with that run instead of recording another.\n   270\tfunc TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n   271\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   272\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   273\t\tif err != nil {\n   274\t\t\tt.Fatal(err)\n   275\t\t}\n   276\t\tattempt := \"\"\n   277\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   278\t\tfunc() {\n   279\t\t\tdefer func() { _ = recover() }()\n   280\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n","exit_code":0,"status":"completed"}}
