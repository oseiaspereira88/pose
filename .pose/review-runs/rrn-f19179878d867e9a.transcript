{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '401,505p'; nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '780,855p'; nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '115,215p'\"","aggregated_output":"   401\t// ReviewRoundOf derives the round of bundle from the sealed bundles of its\n   402\t// scope and the run history (R1). A history or a bundle inventory with a loss\n   403\t// that may concern the scope, a previous round whose record is not intact,\n   404\t// or a run of the scope whose bundle is missing make it fail: a round is\n   405\t// never silently lowered (security; review round 1, B9).\n   406\tfunc (s Store) ReviewRoundOf(bundle ReviewBundle) (ReviewRound, error) {\n   407\t\truns, lost, err := s.ReadReviewRuns(\"\")\n   408\t\tif err != nil {\n   409\t\t\treturn ReviewRound{}, err\n   410\t\t}\n   411\t\tif len(lost) > 0 {\n   412\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: the review run history is incomplete, so the round of %s cannot be derived: %v\", bundle.BundleID, lost)\n   413\t\t}\n   414\t\tscope := bundle.Payload.Scope.Ref\n   415\t\tread, err := s.ReadReviewBundles(scope)\n   416\t\tif err != nil {\n   417\t\t\treturn ReviewRound{}, err\n   418\t\t}\n   419\t\tfor _, loss := range read.Coverage.Losses {\n   420\t\t\tif loss.Scope == \"\" || loss.Scope == scope || loss.Scope == bundle.Payload.Scope.Slug {\n   421\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: a sealed bundle that may belong to %s could not be read (%s), so its round cannot be derived\", scope, loss.Artifact)\n   422\t\t\t}\n   423\t\t}\n   424\t\tpresent := map[string]bool{}\n   425\t\tfor _, b := range read.Bundles {\n   426\t\t\tpresent[b.BundleID] = true\n   427\t\t}\n   428\t\tfor _, r := range runs {\n   429\t\t\tif r.Scope == scope && r.Kind == ReviewBriefKindReview && r.Status == ReviewRunCompleted && !present[r.BundleID] && r.BundleID != bundle.BundleID {\n   430\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s reviewed bundle %s of %s, which is missing, so the round cannot be derived\", r.RunID, r.BundleID, scope)\n   431\t\t\t}\n   432\t\t}\n   433\t\treturn reviewRoundFrom(bundle, read.Bundles, runs, s.reviewRunTranscriptIntact)\n   434\t}\n   435\t\n   436\t// reviewRoundFrom derives the round of bundle from bundles and runs; intact\n   437\t// says why a run's record is not intact, or \"\".\n   438\tfunc reviewRoundFrom(bundle ReviewBundle, bundles []ReviewBundle, runs []ReviewRun, intact func(ReviewRun) string) (ReviewRound, error) {\n   439\t\ttype concluded struct {\n   440\t\t\tbundle ReviewBundle\n   441\t\t\trun    *ReviewRun\n   442\t\t\tended  time.Time\n   443\t\t}\n   444\t\t// A round precedes bundle when its concluding run ended no later than the\n   445\t\t// second bundle was sealed in: a bundle is sealed after the rejection it\n   446\t\t// answers. Seals have second precision, runs nanoseconds, so the runs, as\n   447\t\t// instants, order the chain (D4; review round 1, B3).\n   448\t\tsealed, sealErr := time.Parse(time.RFC3339, bundle.SealedAt)\n   449\t\tvar chain []concluded\n   450\t\tfor _, b := range bundles {\n   451\t\t\tif b.BundleID == bundle.BundleID || b.BundleDigest == bundle.BundleDigest {\n   452\t\t\t\tcontinue\n   453\t\t\t}\n   454\t\t\trun := concludingReviewRun(runs, b.BundleID)\n   455\t\t\tif run == nil {\n   456\t\t\t\tcontinue\n   457\t\t\t}\n   458\t\t\tended, err := time.Parse(time.RFC3339Nano, run.EndedAt)\n   459\t\t\tif err != nil {\n   460\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s records no valid end, so the order of the rounds cannot be derived\", run.RunID)\n   461\t\t\t}\n   462\t\t\tif bundle.SealedAt != \"\" && sealErr == nil && ended.Truncate(time.Second).After(sealed) {\n   463\t\t\t\tcontinue\n   464\t\t\t}\n   465\t\t\tchain = append(chain, concluded{b, run, ended})\n   466\t\t}\n   467\t\tsort.SliceStable(chain, func(i, j int) bool {\n   468\t\t\tif !chain[i].ended.Equal(chain[j].ended) {\n   469\t\t\t\treturn chain[i].ended.Before(chain[j].ended)\n   470\t\t\t}\n   471\t\t\treturn chain[i].run.RunID < chain[j].run.RunID\n   472\t\t})\n   473\t\tround := ReviewRound{Number: len(chain) + 1}\n   474\t\tvar open []ReviewOpenFinding\n   475\t\tvar broken []string\n   476\t\tfor i, c := range chain {\n   477\t\t\tnumber := i + 1\n   478\t\t\tif why := intact(*c.run); why != \"\" {\n   479\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: the run of round %d (%s) is not intact, so its findings cannot be carried: %s\", number, c.run.RunID, why)\n   480\t\t\t}\n   481\t\t\tdraft, err := ParseReviewDraft(c.run.Output)\n   482\t\t\tif draft == nil || err != nil {\n   483\t\t\t\twhy := \"it carries no pose-draft block\"\n   484\t\t\t\tif err != nil {\n   485\t\t\t\t\twhy = err.Error()\n   486\t\t\t\t}\n   487\t\t\t\t// What this round said cannot be read: nothing is added, and\n   488\t\t\t\t// nothing open is closed (review round 1, B1).\n   489\t\t\t\tbroken = append(broken, fmt.Sprintf(\"the draft of round %d (%s) cannot be read: %s\", number, c.run.RunID, why))\n   490\t\t\t\tcontinue\n   491\t\t\t}\n   492\t\t\taccounted := map[string]ReviewDraftPrior{}\n   493\t\t\tfor _, p := range draft.PriorFindings {\n   494\t\t\t\taccounted[p.ID] = p\n   495\t\t\t}\n   496\t\t\t// A finding leaves the open set only when this round reported it\n   497\t\t\t// fixed with evidence, or superseded; unaccounted or unevidenced, it\n   498\t\t\t// stays open, so an invalid account never closes it (B1).\n   499\t\t\tvar next []ReviewOpenFinding\n   500\t\t\tfor _, f := range open {\n   501\t\t\t\tp, ok := accounted[f.ID]\n   502\t\t\t\tswitch {\n   503\t\t\t\tcase !ok:\n   504\t\t\t\t\tf.Carried = \"unaccounted\"\n   505\t\t\t\tcase p.Status == PriorFindingFixed && strings.TrimSpace(p.Evidence) == \"\":\n   780\t// the highest any run of the scope recorded, whatever became of that run, so\n   781\t// a metric never lowers the rounds recorded (R8; review round 1, B5); a\n   782\t// round's figures come from the run that concluded it, and an invalid draft\n   783\t// counts as invalid, never as an approval or a convergence (B7).\n   784\tfunc reviewRoundMetrics(runs []ReviewRun) []ReviewRoundMetric {\n   785\t\thighest := map[string]int{}\n   786\t\tconcluding := map[string]map[int]ReviewRun{}\n   787\t\tfor _, r := range runs {\n   788\t\t\tif r.Round == 0 || r.Kind != ReviewBriefKindReview {\n   789\t\t\t\tcontinue\n   790\t\t\t}\n   791\t\t\tif r.Round > highest[r.Scope] {\n   792\t\t\t\thighest[r.Scope] = r.Round\n   793\t\t\t}\n   794\t\t\tif r.Status != ReviewRunCompleted || r.SupersededBy != \"\" {\n   795\t\t\t\tcontinue\n   796\t\t\t}\n   797\t\t\tif concluding[r.Scope] == nil {\n   798\t\t\t\tconcluding[r.Scope] = map[int]ReviewRun{}\n   799\t\t\t}\n   800\t\t\t// The run that ended last concludes the round, as concludingReviewRun\n   801\t\t\t// decides (review round 3, R3-F1).\n   802\t\t\tif prev, ok := concluding[r.Scope][r.Round]; ok {\n   803\t\t\t\tended, _ := time.Parse(time.RFC3339Nano, r.EndedAt)\n   804\t\t\t\tbefore, _ := time.Parse(time.RFC3339Nano, prev.EndedAt)\n   805\t\t\t\tif ended.Before(before) || ended.Equal(before) && r.RunID < prev.RunID {\n   806\t\t\t\t\tcontinue\n   807\t\t\t\t}\n   808\t\t\t}\n   809\t\t\tconcluding[r.Scope][r.Round] = r\n   810\t\t}\n   811\t\tscopes := make([]string, 0, len(highest))\n   812\t\tfor scope := range highest {\n   813\t\t\tscopes = append(scopes, scope)\n   814\t\t}\n   815\t\tsort.Strings(scopes)\n   816\t\tshare := func(n, total int) *float64 {\n   817\t\t\tif total == 0 {\n   818\t\t\t\treturn nil\n   819\t\t\t}\n   820\t\t\tv := float64(n) / float64(total)\n   821\t\t\treturn &v\n   822\t\t}\n   823\t\tvar out []ReviewRoundMetric\n   824\t\tfor _, scope := range scopes {\n   825\t\t\tm := ReviewRoundMetric{Scope: scope, Rounds: highest[scope], Continued: ReviewRoundConvergence{Trajectory: []ReviewRoundPoint{}}, Cold: ReviewRoundConvergence{Trajectory: []ReviewRoundPoint{}}}\n   826\t\t\tm.FindingsPerRound = make([]int, m.Rounds)\n   827\t\t\tfor n := 1; n <= m.Rounds; n++ {\n   828\t\t\t\tr, ok := concluding[scope][n]\n   829\t\t\t\tif !ok {\n   830\t\t\t\t\tcontinue\n   831\t\t\t\t}\n   832\t\t\t\tdraft, err := ParseReviewDraft(r.Output)\n   833\t\t\t\tinvalid := err != nil || len(r.DraftProblems) > 0\n   834\t\t\t\tif invalid {\n   835\t\t\t\t\tm.InvalidRounds++\n   836\t\t\t\t}\n   837\t\t\t\tif draft != nil {\n   838\t\t\t\t\tm.FindingsPerRound[n-1] = len(draft.Findings)\n   839\t\t\t\t}\n   840\t\t\t\tapproved := !invalid && draftReviewDecision(r.Output) == \"approved\"\n   841\t\t\t\tif m.RoundsToApproval == nil && approved {\n   842\t\t\t\t\tat := n\n   843\t\t\t\t\tm.RoundsToApproval = &at\n   844\t\t\t\t}\n   845\t\t\t\tif n < 2 {\n   846\t\t\t\t\tcontinue\n   847\t\t\t\t}\n   848\t\t\t\tkind := &m.Cold\n   849\t\t\t\tif r.Thread.continued() {\n   850\t\t\t\t\tkind = &m.Continued\n   851\t\t\t\t}\n   852\t\t\t\tkind.Rounds++\n   853\t\t\t\tpoint := ReviewRoundPoint{Round: n, Approved: approved, Invalid: invalid || draft == nil}\n   854\t\t\t\tif draft != nil {\n   855\t\t\t\t\tpoint.Findings = len(draft.Findings)\n   115\t\t\t\t\t\trow.Turns++\n   116\t\t\t\t\t}\n   117\t\t\t\t}\n   118\t\t\t\tif len(events) > 0 {\n   119\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   120\t\t\t\t}\n   121\t\t\t}\n   122\t\t}\n   123\t\tfor _, key := range order {\n   124\t\t\trow := byAttempt[key]\n   125\t\t\tlatest := row.latest\n   126\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   127\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   128\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   129\t\t\tif latest.Access != \"\" {\n   130\t\t\t\trow.Access = latest.Access\n   131\t\t\t}\n   132\t\t\trow.Round = latest.Round\n   133\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   134\t\t\t\trow.HookFailure = hook.Failure\n   135\t\t\t}\n   136\t\t\tif row.Purpose == \"\" {\n   137\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   138\t\t\t}\n   139\t\t\tif latest.Status == ReviewRunInterrupted {\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n   206\t\tfor _, key := range order {\n   207\t\t\tout = append(out, *byAttempt[key])\n   208\t\t}\n   209\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   210\t\treturn out, lost, nil\n   211\t}\n   212\t\n   213\tfunc delegationStepText(e DelegationEvent) string {\n   214\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   215\t\tif len(text) > 80 {\n","exit_code":0,"status":"completed"}}
