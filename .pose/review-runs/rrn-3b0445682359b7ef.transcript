r := gitOutput(4*1024*1024, \"diff-tree\", \"--root\", \"--no-commit-id\", \"--name-status\", \"-z\", \"-M\", \"-r\", sha, \"--\")\n+\t\t\tif err != nil {\n+\t\t\t\treturn posemodel.ChangeSet{}, err\n+\t\t\t}\n+\t\t\tparsed, err := parseGitNameStatusNUL(perCommit)\n+\t\t\tif err != nil {\n+\t\t\t\treturn posemodel.ChangeSet{}, err\n+\t\t\t}\n+\t\t\tobserved = append(observed, parsed...)\n+\t\t}\n \t}\n \tdigest := diffHash.Sum(nil)\n \tidSum := sha256.Sum256([]byte(spec + \"\\x00\" + resolvedBase + \"\\x00\" + resolvedHead + \"\\x00\" + hex.EncodeToString(digest[:])))\n-\treturn posemodel.ChangeSet{ID: \"cs-\" + hex.EncodeToString(idSum[:6]), Spec: spec, Selector: selector, Base: base, Head: head, ResolvedBase: resolvedBase, ResolvedHead: resolvedHead, Commits: commits, Paths: paths, DiffDigest: \"sha256:\" + hex.EncodeToString(digest[:])}, nil\n+\t// A trailer set is judged against the checkout's own tree: a later commit\n+\t// without the trailer that changes an observed path or the matrix must move\n+\t// the digest. An explicit range is a historical query and reads its end.\n+\tmaterialHead := resolvedHead\n+\tif len(trailerCommits) > 0 {\n+\t\tmaterialHead = \"HEAD\"\n+\t}\n+\tif len(observed) == 0 {\n+\t\tobserved = paths\n+\t}\n+\tmaterialInputs := posemodel.MaterialInputsOf(observed)\n+\tmaterialDigest := materialSetDigestAt(gitOutput, root, materialHead, materialInputs)\n+\treturn posemodel.ChangeSet{ID: \"cs-\" + hex.EncodeToString(idSum[:6]), Spec: spec, Selector: selector, Base: base, Head: head, ResolvedBase: resolvedBase, ResolvedHead: resolvedHead, Commits: commits, Paths: paths, DiffDigest: \"sha256:\" + hex.EncodeToString(digest[:]), MaterialDigest: materialDigest, MaterialInputs: &materialInputs}, nil\n }\n \n func allCommitsWithSpecTrailers(root string) (map[string][]string, error) {\n@@ -1294,3 +1325,91 @@ func precedingDeletion(h *removalHistory, commits []string, path string, deletio\n \t}\n \treturn \"\", \"this spec's change to it does not precede the removal\"\n }\n+\n+// materialSetDigestAt reads the head tree entries of every path a change set\n+// names, and the validation matrix, and digests them (ADR\n+// validation-evidence-binds-to-validated-material). Empty when the tree cannot\n+// be read or the checkout is shallow: the set then carries the unreadable\n+// marker and evidence is refused for it.\n+func materialSetDigestAt(gitOutput func(int, ...string) ([]byte, error), root, head string, in posemodel.MaterialInputs) string {\n+\tunreadable := posemodel.MaterialDigestUnreadable\n+\tif shallow, err := repositoryIsShallow(gitOutput, root); err != nil || shallow {\n+\t\treturn unreadable\n+\t}\n+\tnames := in.Names\n+\ttree := map[string]posemodel.TreeEntry{}\n+\tfor start := 0; start < len(names); start += 256 {\n+\t\tend := min(start+256, len(names))\n+\t\targs := []string{\"ls-tree\", \"-z\", head, \"--\"}\n+\t\tfor _, name := range names[start:end] {\n+\t\t\tif strings.ContainsAny(name, \"\\n\\x00\") {\n+\t\t\t\treturn unreadable\n+\t\t\t}\n+\t\t\targs = append(args, \":(literal)\"+name)\n+\t\t}\n+\t\tout, err := gitOutput(8*1024*1024, args...)\n+\t\tif err != nil {\n+\t\t\treturn unreadable\n+\t\t}\n+\t\tfor _, record := range strings.Split(string(out), \"\\x00\") {\n+\t\t\tif record == \"\" {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tmeta, name, ok := strings.Cut(record, \"\\t\")\n+\t\t\tfields := strings.Fields(meta)\n+\t\t\tif !ok || len(fields) != 3 {\n+\t\t\t\treturn unreadable\n+\t\t\t}\n+\t\t\ttree[name] = posemodel.TreeEntry{Mode: fields[0], Blob: fields[2]}\n+\t\t}\n+\t}\n+\treturn posemodel.MaterialSetDigest(in, tree)\n+}\n+\n+var (\n+\tshallowMu    sync.Mutex\n+\tshallowCache = map[string]shallowEntry{}\n+)\n+\n+type shallowEntry struct {\n+\tshallow bool\n+\tmarker  string\n+}\n+\n+// shallowMarker identifies the state of the shallow file of a plain checkout, so\n+// a cached answer is dropped when the checkout is unshallowed or becomes shallow.\n+// It is empty for a checkout whose .git is not a directory (a linked worktree):\n+// that one is asked every time.\n+func shallowMarker(root string) string {\n+\tdir := filepath.Join(root, \".git\")\n+\tif info, err := os.Stat(dir); err != nil || !info.IsDir() {\n+\t\treturn \"\"\n+\t}\n+\tinfo, err := os.Stat(filepath.Join(dir, \"shallow\"))\n+\tif err != nil {\n+\t\treturn \"none\"\n+\t}\n+\treturn fmt.Sprintf(\"%d:%d\", info.Size(), info.ModTime().UnixNano())\n+}\n+\n+// repositoryIsShallow reports whether the checkout lacks history. A shallow\n+// checkout cannot establish that the head tree and the attributed commits\n+// describe the same material, so it never binds evidence. The answer is reused\n+// per root only while the checkout's shallow file is unchanged.\n+func repositoryIsShallow(gitOutput func(int, ...string) ([]byte, error), root string) (bool, error) {\n+\tmarker := shallowMarker(root)\n+\tshallowMu.Lock()\n+\tdefer shallowMu.Unlock()\n+\tif entry, ok := shallowCache[root]; ok && marker != \"\" && entry.marker == marker {\n+\t\treturn entry.shallow, nil\n+\t}\n+\tout, err := gitOutput(64, \"rev-parse\", \"--is-shallow-repository\")\n+\tif err != nil {\n+\t\treturn false, err\n+\t}\n+\tvalue := strings.TrimSpace(string(out)) != \"false\"\n+\tif marker != \"\" {\n+\t\tshallowCache[root] = shallowEntry{shallow: value, marker: marker}\n+\t}\n+\treturn value, nil\n+}\ndiff --git a/pose-mcp/internal/cli/validate.go b/pose-mcp/internal/cli/validate.go\nindex 571d228f..1ed4d9a5 100644\n--- a/pose-mcp/internal/cli/validate.go\n+++ b/pose-mcp/internal/cli/validate.go\n@@ -1133,8 +1133,23 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\t\t\tseenSpecs[set.Spec] = true\n \t\t\t}\n \t\t}\n+\t\t// The binding names the committed tree. Checks run on the working copy, so a\n+\t\t// working copy that differs from it in any material path validated something\n+\t\t// else: the run then records the binding as unavailable.\n+\t\tclean := materialWorktreeClean(root)\n \t\tfor spec := range seenSpecs {\n \t\t\trun.ScopeProvenance[spec] = posemodel.ScopedDeliveryProvenanceDigest(graph, spec)\n+\t\t\tif !clean {\n+\t\t\t\tif run.MaterialProvenance == nil {\n+\t\t\t\t\trun.MaterialProvenance = map[string]string{}\n+\t\t\t\t}\n+\t\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n+\t\t\t} else if material, ok := posemodel.MaterialBinding(graph, spec); ok {\n+\t\t\t\tif run.MaterialProvenance == nil {\n+\t\t\t\t\trun.MaterialProvenance = map[string]string{}\n+\t\t\t\t}\n+\t\t\t\trun.MaterialProvenance[spec] = material\n+\t\t\t}\n \t\t}\n \t}\n \tfailures := 0\n@@ -1318,6 +1333,13 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\trun.Checks = append(run.Checks, *result)\n \t}\n \trun.WallSeconds = time.Since(wallStart).Seconds()\n+\t// A check that changed a tracked file changed the material it ran over: the\n+\t// committed tree no longer describes what was validated.\n+\tif len(run.MaterialProvenance) > 0 && !materialTrackedUnchanged(root) {\n+\t\tfor spec := range run.MaterialProvenance {\n+\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n+\t\t}\n+\t}\n \t// A cancelled run never reads as a success, whatever the severity of the\n \t// checks it stopped (review round 1, B5).\n \tcancelled := false\n@@ -1568,3 +1590,103 @@ func sanitizeGoCheckArgs(ctx context.Context, dir, program string, args []string\n \t}\n \treturn newArgs\n }\n+\n+// materialWorktreeClean reports whether the working copy equals HEAD in every\n+// path outside the administrative classes, untracked files included. A status\n+// that cannot be read is not clean.\n+func materialWorktreeClean(root string) bool {\n+\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n+\tif err != nil {\n+\t\treturn false\n+\t}\n+\trecords := strings.Split(string(out), \"\\x00\")\n+\tvar administrative []string\n+\tfor i := 0; i < len(records); i++ {\n+\t\trecord := records[i]\n+\t\tif len(record) < 4 {\n+\t\t\tcontinue\n+\t\t}\n+\t\tpaths := []string{record[3:]}\n+\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n+\t\t\t// A rename or copy carries its source as the next record.\n+\t\t\tif i+1 < len(records) {\n+\t\t\t\ti++\n+\t\t\t\tpaths = append(paths, records[i])\n+\t\t\t}\n+\t\t}\n+\t\tfor _, p := range paths {\n+\t\t\tif !posemodel.IsAdministrativePath(p) {\n+\t\t\t\treturn false\n+\t\t\t}\n+\t\t\tadministrative = append(administrative, p)\n+\t\t}\n+\t}\n+\treturn administrativeRecordsAreRegular(root, administrative)\n+}\n+\n+// materialTrackedUnchanged reports whether no tracked file differs from HEAD\n+// outside the administrative records. Untracked files are not counted: checks\n+// leave build products behind, and those are not the material they ran over.\n+func materialTrackedUnchanged(root string) bool {\n+\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=no\")\n+\tif err != nil {\n+\t\treturn false\n+\t}\n+\trecords := strings.Split(string(out), \"\\x00\")\n+\tvar administrative []string\n+\tfor i := 0; i < len(records); i++ {\n+\t\trecord := records[i]\n+\t\tif len(record) < 4 {\n+\t\t\tcontinue\n+\t\t}\n+\t\tpaths := []string{record[3:]}\n+\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n+\t\t\tif i+1 < len(records) {\n+\t\t\t\ti++\n+\t\t\t\tpaths = append(paths, records[i])\n+\t\t\t}\n+\t\t}\n+\t\tfor _, p := range paths {\n+\t\t\tif !posemodel.IsAdministrativePath(p) {\n+\t\t\t\treturn false\n+\t\t\t}\n+\t\t\tadministrative = append(administrative, p)\n+\t\t}\n+\t}\n+\treturn administrativeRecordsAreRegular(root, administrative)\n+}\n+\n+// administrativeRecordsAreRegular reports whether every changed administrative\n+// path is a regular file at HEAD (or new): editing a committed symlink or\n+// submodule inside a class is a material change, as in MaterialSetDigest.\n+func administrativeRecordsAreRegular(root string, paths []string) bool {\n+\tif len(paths) == 0 {\n+\t\treturn true\n+\t}\n+\targs := []string{\"ls-tree\", \"-z\", \"HEAD\", \"--\"}\n+\tfor _, p := range paths {\n+\t\tif strings.ContainsAny(p, \"\\n\\x00\") {\n+\t\t\treturn false\n+\t\t}\n+\t\t// The working copy as well as HEAD: a regular record replaced by a link, or\n+\t\t// a new link, is not a record.\n+\t\tif info, err := os.Lstat(filepath.Join(root, filepath.FromSlash(p))); err == nil && !info.Mode().IsRegular() {\n+\t\t\treturn false\n+\t\t}\n+\t\targs = append(args, \":(literal)\"+p)\n+\t}\n+\tout, err := gitOutputBounded(root, 8*1024*1024, args...)\n+\tif err != nil {\n+\t\treturn false\n+\t}\n+\tfor _, record := range strings.Split(string(out), \"\\x00\") {\n+\t\tmeta, _, ok := strings.Cut(record, \"\\t\")\n+\t\tif !ok {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif fields := strings.Fields(meta); len(fields) == 3 && fields[0] != \"100644\" && fields[0] != \"100755\" {\n+\t\t\treturn false\n+\t\t}\n+\t}\n+\treturn true\n+}\ndiff --git a/pose-mcp/internal/cli/validate_results.go b/pose-mcp/internal/cli/validate_results.go\nindex 661d2d0a..6af16e09 100644\n--- a/pose-mcp/internal/cli/validate_results.go\n+++ b/pose-mcp/internal/cli/validate_results.go\n@@ -63,15 +63,16 @@ func (l *outputLimiter) Write(p []byte) (int, error) {\n }\n \n type validationRunResult struct {\n-\tSchemaVersion    int               `json:\"schema_version\"`\n-\tGeneratedAt      string            `json:\"generated_at\"`\n-\tMode             string            `json:\"mode\"`\n-\tStackFilter      string            `json:\"stack_filter,omitempty\"`\n-\tModuleFilter     string            `json:\"module_filter,omitempty\"`\n-\tGitHead          string            `json:\"git_head,omitempty\"`\n-\tMatrixSHA256     string            `json:\"matrix_sha256,omitempty\"`\n-\tProvenanceDigest string            `json:\"provenance_digest,omitempty\"`\n-\tScopeProvenance  map[string]string `json:\"scope_provenance,omitempty\"`\n+\tSchemaVersion      int               `json:\"schema_version\"`\n+\tGeneratedAt        string            `json:\"generated_at\"`\n+\tMode               string            `json:\"mode\"`\n+\tStackFilter        string            `json:\"stack_filter,omitempty\"`\n+\tModuleFilter       string            `json:\"module_filter,omitempty\"`\n+\tGitHead            string            `json:\"git_head,omitempty\"`\n+\tMatrixSHA256       string            `json:\"matrix_sha256,omitempty\"`\n+\tProvenanceDigest   string            `json:\"provenance_digest,omitempty\"`\n+\tScopeProvenance    map[string]string `json:\"scope_provenance,omitempty\"`\n+\tMaterialProvenance map[string]string `json:\"material_provenance,omitempty\"`\n \t// Jobs is how many checks ran at once; WallSeconds the run's elapsed time\n \t// (spec pose-validate-concurrent-steps R3–R4).\n \tJobs        int     `json:\"jobs,omitempty\"`\n","exit_code":0,"status":"completed"}}
