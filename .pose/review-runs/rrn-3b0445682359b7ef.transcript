 \"passed\":\npose-mcp/internal/pose/review_closeout.go:339:type ReviewCriterionMapping struct {\npose-mcp/internal/pose/review_closeout.go:373:type ReviewToolDisposition struct {\npose-mcp/internal/pose/review_closeout.go:394:\tTools         []ReviewToolDisposition `json:\"tools,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:1058:\t\t\ta.Tools = append(a.Tools, ReviewToolDisposition{ID: id, Component: component, Disposition: disposition, Evidence: fieldValue(rest, \"evidence\"), Rationale: fieldValue(rest, \"rationale\")})\npose-mcp/internal/pose/review_closeout.go:1770:\t\tcase \"passed\":\npose-mcp/internal/pose/review_closeout.go:1843:func evaluateReviewToolCoverageIn(files Files, root string, planTools []ReviewPlanTool, dispositions []ReviewToolDisposition, sealed map[string]ReviewBundleEvidence, scopeHasDeliveryTarget bool) ([]string, []string) {\npose-mcp/internal/pose/review_closeout.go:1849:\tobserved := map[string]ReviewToolDisposition{}\npose-mcp/internal/pose/review_closeout.go:1871:\t\tcase \"passed\", \"failed\":\npose-mcp/internal/pose/review_closeout.go:1932:func evaluateReviewToolCoverage(root string, planTools []ReviewPlanTool, dispositions []ReviewToolDisposition, sealed map[string]ReviewBundleEvidence, scopeHasDeliveryTarget bool) ([]string, []string) {\npose-mcp/internal/pose/review_closeout.go:1946:func reviewToolEvidenceBlocker(tool ReviewPlanTool, disposition ReviewToolDisposition, sealed map[string]ReviewBundleEvidence) string {\npose-mcp/internal/pose/review_bundle_test.go:136:\ttools := []ReviewToolDisposition{}\npose-mcp/internal/pose/review_bundle_test.go:138:\t\tdisposition := ReviewToolDisposition{ID: tool.ID, Component: tool.Component}\npose-mcp/internal/pose/review_bundle_test.go:140:\t\t\tdisposition.Disposition, disposition.Rationale = \"deferred\", \"post-review gate\"\npose-mcp/internal/pose/review_bundle_test.go:956:\t\tTools: []ReviewToolDisposition{{ID: \"validate\", Disposition: \"deferred\", Rationale: \"no declared delivery target\"}},\npose-mcp/internal/pose/review_bundle_test.go:1765:func TestToolDispositionMustCiteEvidenceTheBundleSeals(t *testing.T) {\npose-mcp/internal/pose/review_bundle.go:386:\tTools         []ReviewToolDisposition `json:\"tools,omitempty\"`\npose-mcp/internal/pose/review_bundle.go:2847:\ttools := make([]ReviewToolDisposition, 0, len(bundle.Payload.Plan.Tools))\npose-mcp/internal/pose/review_bundle.go:2849:\t\tdisposition := ReviewToolDisposition{\npose-mcp/internal/pose/review_bundle.go:2854:\t\t\tdisposition.Disposition = \"deferred\"\npose-mcp/internal/pose/review_bundle.go:2899:\t\t\t\tdisposition.Disposition = \"deferred\"\n\t}\n\treturn fullSpecs, targets, nil\n}\n\n// collectDeliveryTargets reads and writes the filesystem directly; collectDeliveryTargetsIn takes the\n// operation's files.\nfunc collectDeliveryTargets(root string, specs []posemodel.Spec, profiles map[string]posemodel.DeliveryProfile) ([]posemodel.Spec, []posemodel.DeliveryTarget, error) {\n\treturn collectDeliveryTargetsIn(posemodel.NativeFiles(), root, specs, profiles)\n}\n\nfunc loadDeliveryValidationResultsIn(files posemodel.Files, root, relative string) ([]posemodel.DeliveryValidationResult, error) {\n\tif relative == \"\" {\n\t\treturn []posemodel.DeliveryValidationResult{}, nil\n\t}\n\tif !confinedRelativePath(relative) {\n\t\treturn nil, fmt.Errorf(\"validation result path must remain inside project\")\n\t}\n\traw, err := files.ReadFile(filepath.Join(root, filepath.FromSlash(relative)))\n\tif os.IsNotExist(err) {\n\t\treturn []posemodel.DeliveryValidationResult{}, nil\n\t}\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn posemodel.ParseDeliveryValidationRun(raw, relative)\n}\n\n// loadSmokeResults reads the verified smoke documents of root; tests replace\n// it to exercise the surface check over results they choose.\nvar loadSmokeResults = func(root string) ([]posemodel.SmokeResult, error) {\n\treturn posemodel.Store{Root: root}.SmokeResults()\n}\n\n// withSmokeResults adds the results of every verified smoke observation a\n// delegated smoke run recorded: evidence of class smoke for the delivery\n","exit_code":0,"status":"completed"}}
