integration\"\n        },\n        {\n          \"name\": \"delegation-result-before-marker-integration\",\n          \"program\": \"go\",\n          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestARunsResultIsPublishedBeforeItsMarkerGoes|TestARunsReturnPathsPublishOnceAndKeepTheirMarker|TestAContinuationsReturnPathsPublishOnceAndKeepTheirMarker\", \"-count=1\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"integration\"\n        },\n        {\n          \"name\": \"delegation-marker-stop-joins-heartbeat-integration\",\n          \"program\": \"go\",\n          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestAStoppedRunsHeartbeatCannotBringItsMarkerBack\", \"-count=1\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"integration\"\n        },\n        {\n          \"name\": \"validate-concurrent-steps-integration\",\n          \"program\": \"go\",\n          \"args\": [\"test\", \"./internal/cli\", \"-run\", \"TestValidateRunsChecksConcurrentlyWithinJobs|TestValidateKeepsMatrixOrderAndOutcomes|TestValidateExclusiveCheckRunsAlone|TestValidateCancelStopsRunningChecks|TestDefaultValidationJobsFollowsTheBudget|TestValidateJobsFlagRefusesBadValues|TestValidateWhenIsReadBeforeTheCheckStarts|TestChangedScopeSkipsKeepMatrixOrder|TestCheckAcceptsExclusiveAsABoolean|TestValidateCancelStopsThePreparatoryGoList|TestACancelledRunIsNeverASuccess\", \"-count=1\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"integration\"\n        },\n        {\n          \"name\": \"validate-jobs-reachability\",\n          \"program\": \"go\",\n          \"args\": [\"test\", \"./internal/cli\", \"-run\", \"TestValidateCancelStopsRunningChecks\", \"-count=1\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"reachability\"\n        },\n        {\n          \"name\": \"validate-refuses-empty-go-checks-integration\",\n          \"program\": \"go\",\n          \"args\": [\"test\", \"./internal/cli\", \"-run\", \"TestValidateRefusesAGoCheckThatRanNoTest|TestGoTestPackagesReadsLinesInBoundedMemory|TestGoTestSelection\", \"-count=1\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"integration\"\n        },\n        {\n          \"name\": \"launcher-parity\",\n          \"program\": \"go\",\n          \"args\": [\"test\", \"./internal/cli\", \"-run\", \"LauncherParity|ActiveDocument\", \"-count=1\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"integration\"\n        },\n        {\n          \"name\": \"delegated-review-capability-integration\",\n          \"program\": \"go\",\n          \"args\": [\"test\", \"-race\", \"./internal/pose\", \"./internal/cli\", \"./internal/mcpserver\", \"-run\", \"DelegatedReviewCapability|DelegationInit|ConcludeReviewRun|DelegatedReviewRequestPerKind|ActionFulfil|OnlyTheSigningGate|RunProvenanceLiveOptIn\", \"-count=1\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"integration\"\n        },\n        {\n          \"name\": \"delegated-run-provenance-integration\",\n          \"program\": \"go\",\n          \"args\": [\"test\", \"./internal/pose\", \"./internal/cli\", \"./internal/mcpserver\", \"-run\", \"RunProvenance\", \"-count=1\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"integration\"\n        },\n        {\n          \"name\": \"delegated-run-continuity-integration\",\n          \"program\": \"go\",\n          \"args\": [\"test\", \"./internal/pose\", \"./internal/cli\", \"./internal/mcpserver\", \"-run\", \"RunContinuity\", \"-count=1\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"integration\"\n        },\n        {\n          \"name\": \"delegated-attempt-ledger-integration\",\n          \"program\": \"go\",\n          \"args\": [\"test\", \"./internal/pose\", \"./internal/cli\", \"./internal/mcpserver\", \"-run\", \"AttemptLedger\", \"-count=1\"],\n          \"severity\":