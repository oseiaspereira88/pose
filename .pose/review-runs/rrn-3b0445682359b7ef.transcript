{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/main.go; sed -n '1,65p' pose-mcp/internal/cli/cli.go; cat pose-mcp/internal/pose/delivery_validation_run.go | head -125; rg -n 'ReviewBundle|CloseoutCheck|ReviewCheck' pose-mcp/internal/mcpserver/*go | grep -v _test | head -35; cat .pose/rules/backend-go.md\"","aggregated_output":"cat: pose-mcp/main.go: No such file or directory\n// Package cli implements the native-only unified `pose` binary.\npackage cli\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n)\n\n// Version mirrors the authoritative release version. The release pipeline\n// stamps internal/version via -ldflags (spec pose-version-contract).\nvar Version = version.Version\n\n// The engine package records the version in assessment bindings without\n// importing internal/version (spec pose-engine-package-stays-mirrorable).\nfunc init() {\n\tposemodel.EngineVersion = version.Version\n\tposemodel.EngineReleaseBase = version.ReleaseBase()\n}\n\n// Main is the entrypoint used by cmd/pose. It returns the process exit code.\nfunc Main(args []string, stdout, stderr io.Writer) int {\n\treturn mainWithUsage(args, stdout, stderr)\n}\n\nfunc mainCommand(args []string, stdout, stderr io.Writer) int {\n\tlocale := cliLocaleFor(stderr)\n\tcmd := \"help\"\n\tif len(args) > 0 {\n\t\tcmd = args[0]\n\t\targs = args[1:]\n\t}\n\n\tif cmd == \"help\" {\n\t\treturn cmdHelp(stdout, args)\n\t}\n\n\tif hasHelpFlag(args) || cmd == \"-h\" || cmd == \"--help\" {\n\t\tif cmd == \"-h\" || cmd == \"--help\" {\n\t\t\treturn cmdHelp(stdout, nil)\n\t\t}\n\t\tif dispatchCommandHelp(cmd, args, stdout, locale) {\n\t\t\treturn 0\n\t\t}\n\t\treturn cmdHelp(stdout, []string{cmd})\n\t}\n\n\tswitch cmd {\n\tcase \"version\", \"--version\", \"-v\":\n\t\ttarget := \"\"\n\t\tif len(args) > 0 {\n\t\t\ttarget = args[0]\n\t\t}\n\t\treturn cmdVersion(stdout, target)\n\tcase \"init\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose init: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\npackage pose\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"sort\"\n)\n\n// DeliveryValidationResultSchema is the schema of the structured result of `pose validate`.\nconst DeliveryValidationResultSchema = 1\n\n// ParseDeliveryValidationRun reads the structured result of a validation run into the results\n// the delivery index holds: one per check that declares an evidence class, with the run's head,\n// time, provenance and scope provenance. relative is the path the results were read from. It is\n// the one reading of that file: the index is built with it and checked against it.\nfunc ParseDeliveryValidationRun(raw []byte, relative string) ([]DeliveryValidationResult, error) {\n\tvar run struct {\n\t\tSchemaVersion      int               `json:\"schema_version\"`\n\t\tGeneratedAt        string            `json:\"generated_at\"`\n\t\tGitHead            string            `json:\"git_head,omitempty\"`\n\t\tProvenanceDigest   string            `json:\"provenance_digest,omitempty\"`\n\t\tScopeProvenance    map[string]string `json:\"scope_provenance,omitempty\"`\n\t\tMaterialProvenance map[string]string `json:\"material_provenance,omitempty\"`\n\t\tChecks             []struct {\n\t\t\tID            string `json:\"id\"`\n\t\t\tModule        string `json:\"module\"`\n\t\t\tName          string `json:\"name\"`\n\t\t\tSeverity      string `json:\"severity\"`\n\t\t\tEvidenceClass string `json:\"evidence_class,omitempty\"`\n\t\t\tOutcome       string `json:\"outcome\"`\n\t\t} `json:\"checks\"`\n\t}\n\tif err := json.Unmarshal(raw, &run); err != nil || run.SchemaVersion != DeliveryValidationResultSchema {\n\t\treturn nil, fmt.Errorf(\"invalid structured validation result\")\n\t}\n\tresults := make([]DeliveryValidationResult, 0, len(run.Checks))\n\tfor _, check := range run.Checks {\n\t\tif check.EvidenceClass == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tresults = append(results, DeliveryValidationResult{ID: check.ID, Module: check.Module, Check: check.Name, EvidenceClass: check.EvidenceClass, Severity: check.Severity, Outcome: check.Outcome, GitHead: run.GitHead, GeneratedAt: run.GeneratedAt, ProvenanceDigest: run.ProvenanceDigest, ScopeProvenance: run.ScopeProvenance, MaterialProvenance: run.MaterialProvenance, Report: relative})\n\t}\n\tsort.Slice(results, func(i, j int) bool { return results[i].ID < results[j].ID })\n\treturn results, nil\n}\npose-mcp/internal/mcpserver/server.go:1590:\t\treturn store.VerifyReviewBundle(a.Scope)\npose-mcp/internal/mcpserver/server.go:1747:\t\tbundle, err := store.PrepareReviewBundle(\"spec:\" + a.Slug)\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n","exit_code":0,"status":"completed"}}
