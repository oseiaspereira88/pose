{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/usr/bin/bash -lc \"git diff cf445404..53ac5146 -- pose-mcp/internal/pose/delivery_integrity.go pose-mcp/internal/pose/governance_read_view.go pose-mcp/internal/cli/governance_operation_performance_test.go pose-mcp/internal/cli/change_set_root_test.go; rg -n 'buildCurrentDeliveryGraph|deliveryGraph|surface' pose-mcp/internal/cli/review_closeout.go | head -40; rg -n 'material|material_binding' .pose/indexes/validation-matrix.json\"","aggregated_output":"diff --git a/pose-mcp/internal/cli/change_set_root_test.go b/pose-mcp/internal/cli/change_set_root_test.go\nindex fea7da1a..b1233514 100644\n--- a/pose-mcp/internal/cli/change_set_root_test.go\n+++ b/pose-mcp/internal/cli/change_set_root_test.go\n@@ -142,3 +142,226 @@ func TestUnreadableHeaderRefuses(t *testing.T) {\n \t\tt.Fatalf(\"%v %v\", isRoot, err)\n \t}\n }\n+\n+// An administrative-only commit moves the head but not the material digest; a\n+// source commit moves both (spec pose-validation-evidence-material-binding).\n+func TestChangeSetMaterialDigestIgnoresAdministrativeCommits(t *testing.T) {\n+\trepo := newRemovalRepo(t)\n+\trepo.write(\"a.go\", \"package a\\n\")\n+\trepo.commit(\"code\\n\\nPOSE-Spec: alpha\")\n+\tbefore, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil || before.MaterialDigest == \"\" {\n+\t\tt.Fatalf(\"%v %+v\", err, before)\n+\t}\n+\trepo.write(\".pose/indexes/spec-graph.json\", \"{}\\n\")\n+\trepo.write(\".pose/results/delivery-validation.json\", \"{}\\n\")\n+\trepo.commit(\"index\\n\\nPOSE-Spec: alpha\")\n+\tadmin, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif admin.ResolvedHead == before.ResolvedHead || admin.DiffDigest == before.DiffDigest {\n+\t\tt.Fatalf(\"head did not move: %+v\", admin)\n+\t}\n+\tif admin.MaterialDigest != before.MaterialDigest {\n+\t\tt.Fatalf(\"administrative commit changed the material digest\")\n+\t}\n+\trepo.write(\"a.go\", \"package a\\n\\nvar x = 1\\n\")\n+\trepo.commit(\"more code\\n\\nPOSE-Spec: alpha\")\n+\tmaterial, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif material.MaterialDigest == before.MaterialDigest {\n+\t\tt.Fatal(\"material commit kept the digest\")\n+\t}\n+}\n+\n+// A symlink replacing an administrative record is material, and an explicit\n+// range carries a digest too.\n+func TestChangeSetMaterialDigestSeesSymlinksAndRanges(t *testing.T) {\n+\trepo := newRemovalRepo(t)\n+\trepo.write(\"a.go\", \"package a\\n\")\n+\tbase := repo.commit(\"code\\n\\nPOSE-Spec: alpha\")\n+\trepo.write(\".pose/indexes/x.json\", \"{}\\n\")\n+\trepo.commit(\"index\\n\\nPOSE-Spec: alpha\")\n+\tbefore, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.Remove(filepath.Join(repo.root, \".pose/indexes/x.json\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.Symlink(\"../../a.go\", filepath.Join(repo.root, \".pose/indexes/x.json\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\trepo.commit(\"link\\n\\nPOSE-Spec: alpha\")\n+\tafter, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif before.MaterialDigest == \"\" || after.MaterialDigest == before.MaterialDigest {\n+\t\tt.Fatalf(\"symlink in an administrative class kept the digest: %q %q\", before.MaterialDigest, after.MaterialDigest)\n+\t}\n+\tranged, err := resolveGitChangeSet(repo.root, \"alpha\", base, \"HEAD\")\n+\tif err != nil || ranged.MaterialDigest == \"\" {\n+\t\tt.Fatalf(\"range set has no material digest: %v %+v\", err, ranged)\n+\t}\n+}\n+\n+// A later commit without the trailer that changes an observed path moves the\n+// digest: the tree read is the checkout's, not the set's last commit.\n+func TestChangeSetMaterialDigestReadsTheCheckoutTree(t *testing.T) {\n+\trepo := newRemovalRepo(t)\n+\trepo.write(\"a.go\", \"package a\\n\")\n+\trepo.commit(\"code\\n\\nPOSE-Spec: alpha\")\n+\tbefore, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\trepo.write(\"a.go\", \"package a\\n\\nvar sneaky = 1\\n\")\n+\trepo.commit(\"someone else touches an observed path\")\n+\tafter, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif after.MaterialDigest == before.MaterialDigest {\n+\t\tt.Fatal(\"an untrailered commit on an observed path kept the digest\")\n+\t}\n+\trepo.write(\".pose/indexes/validation-matrix.json\", \"{}\\n\")\n+\trepo.commit(\"matrix changes without the trailer\")\n+\tmatrix, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil || matrix.MaterialDigest == after.MaterialDigest {\n+\t\tt.Fatalf(\"a matrix change kept the digest: %v\", err)\n+\t}\n+}\n+\n+// A shallow checkout never binds evidence.\n+func TestChangeSetMaterialDigestIsUnreadableInAShallowCheckout(t *testing.T) {\n+\torigin := t.TempDir()\n+\tartifactGit(t, origin, \"init\", \"-q\", \"-b\", \"main\")\n+\tartifactGit(t, origin, \"config\", \"user.email\", \"pose@example.invalid\")\n+\tartifactGit(t, origin, \"config\", \"user.name\", \"POSE Tests\")\n+\twriteArtifactTestFile(t, origin, \"a.txt\", \"first\\n\")\n+\tartifactGit(t, origin, \"add\", \"-A\")\n+\tartifactGit(t, origin, \"commit\", \"-qm\", \"first\")\n+\twriteArtifactTestFile(t, origin, \"a.txt\", \"second\\n\")\n+\tartifactGit(t, origin, \"add\", \"-A\")\n+\tartifactGit(t, origin, \"commit\", \"-qm\", \"second\\n\\nPOSE-Spec: alpha\")\n+\tshallow := filepath.Join(t.TempDir(), \"shallow\")\n+\tartifactGit(t, origin, \"clone\", \"-q\", \"--depth=1\", \"file://\"+origin, shallow)\n+\tgit := func(limit int, args ...string) ([]byte, error) { return gitOutputBounded(shallow, limit, args...) }\n+\tpaths := []posemodel.ObservedPath{{Action: \"modified\", Path: \"a.txt\"}}\n+\tif got := materialSetDigestAt(git, shallow, \"HEAD\", posemodel.MaterialInputsOf(paths)); got != posemodel.MaterialDigestUnreadable {\n+\t\tt.Fatalf(\"shallow checkout: %q\", got)\n+\t}\n+\twhole := func(limit int, args ...string) ([]byte, error) { return gitOutputBounded(origin, limit, args...) }\n+\tif got := materialSetDigestAt(whole, origin, \"HEAD\", posemodel.MaterialInputsOf(paths)); got == \"\" || got == posemodel.MaterialDigestUnreadable {\n+\t\tt.Fatalf(\"complete checkout: %q\", got)\n+\t}\n+}\n+\n+// The shallow answer follows the checkout: unshallowing it drops the cache.\n+func TestShallowAnswerFollowsTheCheckout(t *testing.T) {\n+\torigin := t.TempDir()\n+\tartifactGit(t, origin, \"init\", \"-q\", \"-b\", \"main\")\n+\tartifactGit(t, origin, \"config\", \"user.email\", \"pose@example.invalid\")\n+\tartifactGit(t, origin, \"config\", \"user.name\", \"POSE Tests\")\n+\twriteArtifactTestFile(t, origin, \"a.txt\", \"first\\n\")\n+\tartifactGit(t, origin, \"add\", \"-A\")\n+\tartifactGit(t, origin, \"commit\", \"-qm\", \"first\")\n+\twriteArtifactTestFile(t, origin, \"a.txt\", \"second\\n\")\n+\tartifactGit(t, origin, \"add\", \"-A\")\n+\tartifactGit(t, origin, \"commit\", \"-qm\", \"second\")\n+\tclone := filepath.Join(t.TempDir(), \"clone\")\n+\tartifactGit(t, origin, \"clone\", \"-q\", \"--depth=1\", \"file://\"+origin, clone)\n+\tgit := func(limit int, args ...string) ([]byte, error) { return gitOutputBounded(clone, limit, args...) }\n+\tif shallow, err := repositoryIsShallow(git, clone); err != nil || !shallow {\n+\t\tt.Fatalf(\"shallow clone: %v %v\", shallow, err)\n+\t}\n+\tartifactGit(t, clone, \"fetch\", \"-q\", \"--unshallow\")\n+\tif shallow, err := repositoryIsShallow(git, clone); err != nil || shallow {\n+\t\tt.Fatalf(\"after unshallow: %v %v\", shallow, err)\n+\t}\n+}\n+\n+// Create, then move into an administrative class: the destination stays\n+// material through the merge of the commits' observations, so a later edit of it\n+// moves the digest.\n+func TestChangeSetMaterialDigestKeepsAMovedFileMaterial(t *testing.T) {\n+\trepo := newRemovalRepo(t)\n+\trepo.write(\"a.go\", \"package a\\n\")\n+\trepo.commit(\"create\\n\\nPOSE-Spec: alpha\")\n+\tif err := os.MkdirAll(filepath.Join(repo.root, \".pose\", \"results\"), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tartifactGit(t, repo.root, \"mv\", \"a.go\", \".pose/results/a.go\")\n+\trepo.commit(\"move into a class\\n\\nPOSE-Spec: alpha\")\n+\tmoved, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\trepo.write(\".pose/results/a.go\", \"package a\\n\\nvar edited = 1\\n\")\n+\trepo.commit(\"edit the destination\\n\\nPOSE-Spec: alpha\")\n+\tedited, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif moved.MaterialDigest == \"\" || moved.MaterialDigest == edited.MaterialDigest {\n+\t\tt.Fatalf(\"editing a file moved into an administrative class kept the digest: %q %q\", moved.MaterialDigest, edited.MaterialDigest)\n+\t}\n+}\n+\n+// A copy of a tracked file the change set never touched stays material, so a\n+// later edit of the copy moves the digest.\n+func TestChangeSetMaterialDigestSeesACopyOfAnUntouchedSource(t *testing.T) {\n+\trepo := newRemovalRepo(t)\n+\trepo.write(\"src/helper.go\", \"package src\\n\")\n+\trepo.commit(\"untouched source\")\n+\tif err := os.MkdirAll(filepath.Join(repo.root, \".pose\", \"results\"), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\trepo.write(\".pose/results/helper.go\", \"package src\\n\")\n+\trepo.commit(\"copy into a class\\n\\nPOSE-Spec: alpha\")\n+\tcopied, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\trepo.write(\".pose/results/helper.go\", \"package src\\n\\nvar edited = 1\\n\")\n+\trepo.commit(\"edit the copy\\n\\nPOSE-Spec: alpha\")\n+\tedited, err := resolveGitChangeSet(repo.root, \"alpha\", \"\", \"\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif copied.MaterialDigest == \"\" || copied.MaterialDigest == edited.MaterialDigest {\n+\t\tt.Fatalf(\"editing a copy of an untouched source kept the digest: %q %q\", copied.MaterialDigest, edited.MaterialDigest)\n+\t}\n+}\n+\n+// An explicit range carries the intermediate renames too: a data file created\n+// and then moved into an administrative class stays material.\n+func TestChangeSetMaterialDigestKeepsAMovedFileMaterialInARange(t *testing.T) {\n+\trepo := newRemovalRepo(t)\n+\trepo.write(\"base.txt\", \"base\\n\")\n+\tbase := repo.commit(\"base\")\n+\trepo.write(\"data.txt\", \"data\\n\")\n+\trepo.commit(\"create\")\n+\tif err := os.MkdirAll(filepath.Join(repo.root, \".pose\", \"results\"), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tartifactGit(t, repo.root, \"mv\", \"data.txt\", \".pose/results/data.txt\")\n+\trepo.commit(\"move into a class\")\n+\tmoved, err := resolveGitChangeSet(repo.root, \"alpha\", base, \"HEAD\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\trepo.write(\".pose/results/data.txt\", \"edited\\n\")\n+\trepo.commit(\"edit the destination\")\n+\tedited, err := resolveGitChangeSet(repo.root, \"alpha\", base, \"HEAD\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif moved.MaterialDigest == \"\" || moved.MaterialDigest == edited.MaterialDigest {\n+\t\tt.Fatalf(\"a range lost the rename into a class: %q %q\", moved.MaterialDigest, edited.MaterialDigest)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/governance_operation_performance_test.go b/pose-mcp/internal/cli/governance_operation_performance_test.go\nindex 17bc53d6..132b36be 100644\n--- a/pose-mcp/internal/cli/governance_operation_performance_test.go\n+++ b/pose-mcp/internal/cli/governance_operation_performance_test.go\n@@ -63,7 +63,10 @@ func TestGovernanceOperationPerformanceCapturesTrailersOnce(t *testing.T) {\n \t\t\t\tt.Fatalf(\"full trailer log read %d times for %d specs, want one bounded capture\", got, count)\n \t\t\t}\n \t\t\tcalls := bytes.Count(raw, []byte(\"call\\n\"))\n-\t\t\twantCalls := map[int]int{1: 11, 3: 23, 6: 41}[count]\n+\t\t\t// Each change set reads its head tree once for the material digest and the root\n+\t\t\t// checks once whether the checkout is shallow (one more\n+\t\t\t// launch per spec); the full trailer log is still captured exactly once.\n+\t\t\twantCalls := map[int]int{1: 13, 3: 27, 6: 48}[count]\n \t\t\tif calls != wantCalls {\n \t\t\t\tt.Fatalf(\"Git subprocesses=%d want%d\", calls, wantCalls)\n \t\t\t}\n@@ -320,6 +323,13 @@ func TestGovernanceOperationPerformanceChangeSetIndependentGolden(t *testing.T)\n \twant := posemodel.ChangeSet{ID: \"cs-\" + hex.EncodeToString(id[:6]), Spec: \"sample\", Selector: \"trailers:sample\", Base: first + \"^\", Head: last, ResolvedBase: base, ResolvedHead: last,\n \t\tCommits: []string{first, last}, Paths: []posemodel.ObservedPath{{Action: \"created\", Path: \"new.txt\"}, {Action: \"modified\", Path: \"base.txt\"}, {Action: \"removed\", Path: \"remove.txt\"}}, DiffDigest: \"sha256:\" + digest}\n \tgot, err := resolveGitChangeSet(root, \"sample\", \"\", \"\")\n+\t// The material digest is an additive field of a later contract; the\n+\t// attribution under test is everything else.\n+\tif err == nil && got.MaterialDigest == \"\" {\n+\t\tt.Fatal(\"trailer change set carries no material digest\")\n+\t}\n+\tgot.MaterialDigest = \"\"\n+\tgot.MaterialInputs = nil\n \tif err != nil || !reflect.DeepEqual(got, want) {\n \t\tt.Fatalf(\"historical attribution changed:\\n got=%+v\\nwant=%+v\\nerr=%v\", got, want, err)\n \t}\ndiff --git a/pose-mcp/internal/pose/delivery_integrity.go b/pose-mcp/internal/pose/delivery_integrity.go\nindex 9459fc18..e456dec0 100644\n--- a/pose-mcp/internal/pose/delivery_integrity.go\n+++ b/pose-mcp/internal/pose/delivery_integrity.go\n@@ -52,6 +52,11 @@ type ChangeSet struct {\n \tCommits      []string       `json:\"commits,omitempty\"`\n \tPaths        []ObservedPath `json:\"paths\"`\n \tDiffDigest   string         `json:\"diff_dige