   15 +-\n pose-mcp/internal/pose/governance_read_view.go     |     4 +-\n .../pose/governance_read_view_integration_test.go  |    16 +-\n .../pose/governance_read_view_probe_test.go        |    10 +-\n pose-mcp/internal/pose/material_binding.go         |   246 +\n pose-mcp/internal/pose/material_binding_test.go    |   242 +\n pose-mcp/internal/pose/review_bundle.go            |     6 +\n pose-mcp/internal/pose/review_dispatch.go          |     3 +\n pose-mcp/internal/pose/spec_facts.go               |    32 +-\n pose-mcp/internal/scaffold/dist/POSE.md            |     2 +-\n .../internal/scaffold/dist/locales/pt-BR/POSE.md   |     2 +-\n 36 files changed, 29198 insertions(+), 3281 deletions(-)\n/home/go/.local/bin/pose\npose-mcp/internal/cli/validate_material_worktree_test.go\npose-mcp/internal/cli/material_engine.go\n.pose/reports/2026-10-06-v7-validation-check-materiality-review.md\npose-mcp/internal/mcpserver/material_engine.go\n.pose/review-profiles/structural-materiality.json\npose-mcp/internal/pose/index_federated_material_test.go\npose-mcp/internal/pose/index_federated_material.go\npose-mcp/internal/pose/material_binding.go\npose-mcp/internal/pose/material_binding_test.go\npose-mcp/internal/scaffold/dist/AGENTS.md\npose-mcp/internal/scaffold/dist/locales/pt-BR/AGENTS.md\n.pose/specs/2026-10-13-pose-residual-material-coverage-and-identity.md\n.pose/specs/2026-10-04-pose-material-equivalence-reuse.md\n.pose/specs/2026-11-07-pose-validation-evidence-material-binding.md\n.pose/specs/2026-10-05-pose-validation-check-additions-are-not-material.md\n.pose/changelogs/v7.0.0/pose-material-equivalence-reuse.md\n.pose/changelogs/v7.0.0/pose-validation-check-additions-are-not-material.md\n.pose/adr/2026-09-19-material-design-basis-remains-an-advisory-projection.md\n.pose/adr/2026-11-07-validation-evidence-binds-to-validated-material.md\n.pose/adr/2026-10-21-action-effects-select-material-destinations-independently-of-origin.md\n.pose/starts/pose-validation-check-addition