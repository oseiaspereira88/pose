eSet) []ChangeSet {\npose-mcp/internal/pose/material_binding.go:235:\tif CurrentMaterialDigests == nil {\npose-mcp/internal/pose/material_binding.go:241:\t\t\tset.MaterialDigest = CurrentMaterialDigests(root, *set.MaterialInputs)\npose-mcp/internal/pose/release_manifest_integrity.go:715:\t} else if source != EngineVersionFile || kind != \"\" {\npose-mcp/internal/pose/governance_read_view_index_test.go:56:\tgovernanceReadViewProbeUseKnownEngineVersion(t)\npose-mcp/internal/pose/release_manifest_tag_integrity_test.go:293:\tr.manifest = NewReleaseManifest(\"v1.0.0\", \"\", \"2026-10-02T00:00:00Z\", r.manifest.Fragments, ReleasePolicy{SchemaVersion: 1}, ChangelogPolicy{}, map[string]string{\"source\": EngineVersionFile, \"value\": \"v1.0.0\"})\npose-mcp/internal/pose/release_manifest_tag_integrity_test.go:295:\trelWrite(t, r.root, EngineVersionFile, \"package version\\n\\nconst Version = \\\"1.0.0\\\"\\n\")\npose-mcp/internal/pose/delivery_surface.go:476:\t\t\t\tif result.Outcome == \"pass\" && result.Severity == \"required\" && deliveryEvidenceCurrent(result, target.Spec, specStatus[target.Spec], graph, setsBySpec[target.Spec]) {\npose-mcp/internal/pose/delivery_surface.go:512:\t\t\t\t\tif result.Outcome == \"pass\" && result.Severity == \"required\" && deliveryEvidenceCurrent(result, target.Spec, specStatus[target.Spec], graph, setsBySpec[target.Spec]) {\npose-mcp/internal/pose/delivery_surface.go:624:func deliveryEvidenceCurrent(result DeliveryValidationResult, spec, status string, graph DeliveryIntegrityGraph, sets []ChangeSet) bool {\npose-mcp/internal/pose/main_test.go:17:\tif EngineVersion == \"unknown\" {\npose-mcp/internal/pose/main_test.go:18:\t\tEngineVersion = \"pose-test-engine\"\npose-mcp/internal/pose/delivery_integrity_compact_test.go:276:\t\tif !deliveryEvidenceCurrent(result, \"spec-02\", \"done\", expanded, nil) {\npose-mcp/internal/pose/package_boundary_test.go:15:// reaches this package through EngineVersion instead\npose-mcp/internal/pose/governance_read_view_integration_test.go:29:\tgovernanceReadViewProbeUseKnownEngineVersion(t)\npose-mcp/internal/pose/governance_read_view_integration_test.go:253:\tgovernanceReadViewProbeUseKnownEngineVersion(t)\npose-mcp/internal/pose/governance_read_view_integration_test.go:334:\tgovernanceReadViewProbeUseKnownEngineVersion(t)\npose-mcp/internal/pose/governance_read_view_integration_test.go:396:\tgovernanceReadViewProbeUseKnownEngineVersion(t)\npose-mcp/internal/pose/governance_read_view_integration_test.go:470:\tgovernanceReadViewProbeUseKnownEngineVersion(t)\npose-mcp/internal/pose/governance_read_view_integration_test.go:650:\tgovernanceReadViewProbeUseKnownEngineVersion(t)\npose-mcp/internal/pose/release_version_source.go:22:\t// EngineVersionFile is where the engine repository keeps its version. Its\npose-mcp/internal/pose/release_version_source.go:25:\tEngineVersionFile = \"pose-mcp/internal/version/version.go\"\npose-mcp/internal/pose/release_version_source.go:176:// ProjectHasEngineVersionFile reports whether the project is the engine\npose-mcp/internal/pose/release_version_source.go:178:func ProjectHasEngineVersionFile(root string) bool {\npose-mcp/internal/pose/release_version_source.go:179:\treturn ProjectHasEngineVersionFileIn(NativeFiles(), root)\npose-mcp/internal/pose/release_version_source.go:182:func ProjectHasEngineVersionFileIn(files Files, root string) bool {\npose-mcp/internal/pose/release_version_source.go:183:\tinfo, err := files.Stat(filepath.Join(root, filepath.FromSlash(EngineVersionFile)))\npackage cli\n\nimport (\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n)\n\nfunc init() {\n\tposemodel.SetEngineVersion(version.Version)\n\tposemodel.SetCurrentMaterialDigests(func(root string, in posemodel.MaterialInputs) string {\n\t\tgit := func(limit int, args ...string) ([]byte, error) { return gitOutputBounded(root, limit, args...) }\n\t\treturn materialSetDigestAt(git, root, \"HEAD\", in)\n\t})\n}\npackage mcpserver\n\nimport (\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n)\n\nfunc init() { posemodel.SetEngineVersion(version.Version) }\npackage pose\n\nimport (\n\t\"encoding/json\"\n\t\"testing\"\n)\n\nfunc TestIsAdministrativePathIsClosedAndPathExact(t *testing.T) {\n\tfor p, want := range map[string]bool{\n\t\t\".pose/indexes/spec-graph.json\":          true,\n\t\t\".pose/results/delivery-validation.json\": true,\n\t\t\".pose/state/history.jsonl\":              true,\n\t\t\".pose/assessments/pose-mcp.md\":          true,\n\t\t\".pose/review-bundles/rvb-1.json\":        true,\n\t\t\".pose/indexes/validation-matrix.json\":   false,\n\t\t\".pose/policy/delivery.json\":             false,\n\t\t\".pose/rules/security.md\":                false,\n\t\t\".pose/specs/2026-01-01-x.md\":            false,\n\t\t\"pose-mcp/internal/pose/a.go\":            false,\n\t\t\".pose/indexes/../policy/delivery.json\":  false,\n\t\t\"../.pose/indexes/x.json\":                false,\n\t\t\".pose/review-x\":                         false,\n\t\t\".pose/indexesx/a.json\":                  false,\n\t\t\"\":                                       false,\n\t} {\n\t\tif got := IsAdministrativePath(p); got != want {\n\t\t\tt.Errorf(\"%q: got %v want %v\", p, got, want)\n\t\t}\n\t}\n}\n\nfunc obs(action, p string) ObservedPath { return ObservedPath{Action: action, Path: p} }\n\nfunc regularEntry(blob string) TreeEntry { return TreeEntry{Mode: \"100644\", Blob: blob} }\n\nfunc TestMaterialSetDigestIgnoresAdministrativeRecordsOnly(t *testing.T) {\n\tpaths := []ObservedPath{obs(\"M\", \"a.go\"), obs(\"M\", \".pose/indexes/spec-graph.json\")}\n\tbase := map[string]TreeEntry{\"a.go\": regularEntry(\"b1\"), \".pose/indexes/spec-graph.json\": regularEntry(\"i1\"), \".pose/indexes/validation-matrix.json\": regularEntry(\"m1\")}\n\twant := MaterialSetDigest(MaterialInputsOf(paths), base)\n\n\tadmin := map[string]TreeEntry{\"a.go\": regularEntry(\"b1\"), \".pose/indexes/spec-graph.json\": regularEntry(\"i2\"), \".pose/indexes/validation-matrix.json\": regularEntry(\"m1\")}\n\tif MaterialSetDigest(MaterialInputsOf(paths), admin) != want {\n\t\tt.Fatal(\"an administrative record changed the digest\")\n\t}\n\tfor name, mutate := range map[string]func(m map[string]TreeEntry){\n\t\t\"code\":    func(m map[string]TreeEntry) { m[\"a.go\"] = regularEntry(\"b2\") },\n\t\t\"matrix\":  func(m map[string]TreeEntry) { m[\".pose/indexes/validation-matrix.json\"] = regularEntry(\"m2\") },\n\t\t\"deleted\": func(m map[string]TreeEntry) { delete(m, \"a.go\") },\n\t\t\"symlink\": func(m map[string]TreeEntry) {\n\t\t\tm[\".pose/indexes/spec-graph.json\"] = TreeEntry{Mode: \"120000\", Blob: \"i1\"}\n\t\t},\n\t\t\"symlink target\": func(m map[string]TreeEntry) {\n\t\t\tm[\".pose/indexes/spec-graph.json\"] = TreeEntry{Mode: \"120000\", Blob: \"i9\"}\n\t\t},\n\t\t\"mode\": func(m map[string]TreeEntry) { m[\"a.go\"] = TreeEntry{Mode: \"100755\", Blob: \"b1\"} },\n\t} {\n\t\tm := map[string]TreeEntry{}\n\t\tfor k, v := range base {\n\t\t\tm[k] = v\n\t\t}\n\t\tmutate(m)\n\t\tif MaterialSetDigest(MaterialInputsOf(paths), m) == want {\n\t\t\tt.Errorf(\"%s: digest unchanged\", name)\n\t\t}\n\t}\n}\n\nfunc TestMaterialSetDigestTreatsRenamesOutOfAClassAsMaterial(t *testing.T) {\n\tpaths := []ObservedPath{{Action: \"R\", OldPath: \"a.go\", NewPath: \".pose/results/a.go\"}}\n\tmoved := map[string]TreeEntry{\".pose/results/a.go\": regularEntry(\"b1\")}\n\tkept := map[string]TreeEntry{\".pose/results/a.go\": regularEntry(\"b1\"), \"a.go\": regularEntry(\"b1\")}\n\tif MaterialSetDigest(MaterialInputsOf(paths), moved) == MaterialSetDigest(MaterialInputsOf(paths), kept) {\n\t\tt.Fatal(\"the vanished source path must count\")\n\t}\n}\n\nfunc materialGraph(head, digest string) DeliveryIntegrityGraph {\n\treturn DeliveryIntegrityGraph{\n\t\tClaims:     []ArtifactClaim{{Spec: \"s\", Path: \"a.go\", Action: \"modified\"}},\n\t\tChangeSets: []ChangeSet{{ID: \"cs-\" + head, Spec: \"s\", Head: head, ResolvedHead: head, Commits: []string{head}, MaterialDigest: digest}},\n\t}\n}\n\nfunc TestMaterialEvidenceSurvivesHeadMoveButNotMaterialChange(t *testing.T) {\n\tvalidated := materialGraph(\"h1\", \"sha256:material-1\")\n\tresult := DeliveryValidationResult{GitHead: \"h1\", MaterialProvenance: map[string]string{\"s\": ScopedMaterialDigest(validated, \"s\")}}\n\n\tmoved := materialGraph(\"h2\", \"sha256:material-1\")\n\tif !deliveryEvidenceCurrent(result, \"s\", \"in-progress\", moved, moved.ChangeSets) {\n\t\tt.Fatal(\"a head move with the same material invalidated evidence\")\n\t}\n\tchanged := materialGraph(\"h3\", \"sha256:material-2\")\n\tif deliveryEvidenceCurrent(result, \"s\", \"in-progress\", changed, changed.ChangeSets) {\n\t\tt.Fatal(\"material change kept stale evidence current\")\n\t}\n}\n\nfunc TestMaterialBindingGovernsAndNeverFallsThrough(t *testing.T) {\n\tg := materialGraph(\"h1\", \"sha256:material-1\")\n\t// The legacy rules would accept this result (same git head, same scoped digest);\n\t// its material binding is from another engine, so it is stale.\n\tresult := DeliveryValidationResult{GitHead: \"h1\", ScopeProvenance: map[string]string{\"s\": ScopedDeliveryProvenanceDigest(g, \"s\")},\n\t\tMaterialProvenance: map[string]string{\"s\": \"sha256:other-engine\"}}\n\tif deliveryEvidenceCurrent(result, \"s\", \"in-progress\", g, g.ChangeSets) {\n\t\tt.Fatal(\"a mismatched material binding fell through to the commit-bound rules\")\n\t}\n\tif !deliveryEvidenceCurrent(DeliveryValidationResult{GitHead: \"h1\"}, \"s\", \"in-progress\", g, g.ChangeSets) {\n\t\tt.Fatal(\"a result without a material binding keeps the existing rule\")\n\t}\n\tresult.GeneratedAt = \"2026-11-07T00:00:00Z\"\n\tif !deliveryEvidenceCurrent(result, \"s\", \"done\", g, g.ChangeSets) {\n\t\tt.Fatal(\"a closed spec keeps its exemption\")\n\t}\n}\n\nfunc TestMaterialDigestDoesNotChangeTheCommitBoundDigests(t *testing.T) {\n\twith := materialGraph(\"h1\", \"sha256:material-1\")\n\twithout := materialGraph(\"h1\", \"\")\n\tif ScopedDeliveryProvenanceDigest(with, \"s\") != ScopedDeliveryProvenanceDigest(without, \"s\") {\n\t\tt.Fatal(\"the scoped provenance digest moved with the material digest\")\n\t}\n\tif ScopedMaterialDigest(without, \"s\") != \"\" {\n\t\tt.Fatal(\"a set without a material digest must not bind\")\n\t}\n}\n\nfunc TestUnreadableMaterialNeverBindsAndIsRecordedAsUnavailable(t *testing.T) {\n\tg := materialGraph(\"h1\", MaterialDigestUnreadable)\n\tif ScopedMaterialDigest(g, \"s\") != \"\" {\n\t\tt.Fatal(\"an unreadable set produced a digest\")\n\t}\n\tbound, ok := MaterialBinding(g, \"s\")\n\tif !ok || bound != MaterialBindingUnavailable {\n\t\tt.Fatalf(\"got %q %v\", bound, ok)\n\t}\n\t// Recorded as unavailable, the result is stale although the legacy rules would accept it.\n\tresult := DeliveryValidationResult{GitHead: \"h1\", ScopeProvenance: map[string]string{\"s\": ScopedDeliveryProvenanceDigest(g, \"s\")},\n\t\tMaterialProvenance: map[string]string{\"s\": bound}}\n\tif deliveryEvidenceCurrent(result, \"s\", \"in-progress\", g, g.ChangeSets) {\n\t\tt.Fatal(\"unreadable material let the legacy rule accept the result\")\n\t}\n\tif got, ok := MaterialBinding(materialGraph(\"h1\", \"\"), \"s\"); !ok || got != MaterialBindingUnavailable {\n\t\tt.Fatalf(\"a set that never computed a digest must be unavailable: %q %v\", got, ok)\n\t}\n}\n\nfunc TestRenameIntoAnAdministrativeClassStaysMaterial(t *testing.T) {\n\tpaths := []ObservedPath{{Action: \"R\", OldPath: \"a.go\", NewPath: \".pose/results/a.go\"}}\n\tfirst := MaterialSetDigest(MaterialInputsOf(paths), map[string]TreeEntry{\".pose/results/a.go\": regularEntry(\"b1\")})\n\tedited := MaterialSetDigest(MaterialInputsOf(paths), map[string]TreeEntry{\".pose/results/a.go\": regularEntry(\"b2\")})\n\tif first == edited {\n\t\tt.Fatal(\"editing the moved file inside the class kept the digest\")\n\t}\n}\n\nfunc TestFactResultKeySeparatesMaterialBindings(t *testing.T) {\n\ta := DeliveryValidationResult{ID: \"x\", MaterialProvenance: map[string]string{\"s\": \"sha256:1\"}}\n\tb := DeliveryValidationResult{ID: \"x\", MaterialProvenance: map[string]string{\"s\": \"sha256:2\"}}\n\tif factResultKey(a) == factResultKey(b) {\n\t\tt.Fatal(\"two material bindings share one identity\")\n\t}\n}\n\nfunc TestARecordedSetWithoutAMaterialDigestMakesTheBindingUnavailable(t *testing.T) {\n\tg := DeliveryIntegrityGraph{ChangeSets: []ChangeSet{\n\t\t{ID: \"cs-1\", Spec: \"s\", MaterialDigest: \"sha256:m\"},\n\t\t{ID: \"cs-recorded\", Spec: \"s\"},\n\t}}\n\tif got, ok := MaterialBinding(g, \"s\"); !ok || got != MaterialBindingUnavailable {\n\t\tt.Fatalf(\"got %q %v\", got, ok)\n\t}\n\tif _, ok := MaterialBinding(g, \"other\"); ok {\n\t\tt.Fatal(\"a spec without change sets records no binding\")\n\t}\n}\n\nfunc TestCodeInsideAnAdministrativeClassIsMaterial(t *testing.T) {\n\tfor p, want := range map[string]bool{\n\t\t\".pose/results/report.json\":      true,\n\t\t\".pose/state/history.jsonl\":      true,\n\t\t\".pose/assessments/pose-mcp.md\":  true,\n\t\t\".pose/review-runs/x.transcript\": true,\n\t\t\".pose/results/helper.go\":        false,\n\t\t\".pose/results/build-backlog.py\": false,\n\t\t\".pose/indexes/refresh.sh\":       false,\n\t\t\".pose/results/noextension\":      false,\n\t} {\n\t\tif got := IsAdministrativePath(p); got != want {\n\t\t\tt.Errorf(\"%q: got %v want %v\", p, got, want)\n\t\t}\n\t}\n\t// Editing a source file placed in a class moves the digest.\n\tpaths := []ObservedPath{obs(\"A\", \".pose/results/helper.go\")}\n\tone := MaterialSetDigest(MaterialInputsOf(paths), map[string]TreeEntry{\".pose/results/helper.go\": regularEntry(\"b1\")})\n\ttwo := MaterialSetDigest(MaterialInputsOf(paths), map[string]TreeEntry{\".pose/results/helper.go\": regularEntry(\"b2\")})\n\tif one == two {\n\t\tt.Fatal(\"editing code inside a class kept the digest\")\n\t}\n}\n\nfunc TestEvidenceIsJudgedAgainstTheCurrentMaterial(t *testing.T) {\n\tin := MaterialInputsOf([]ObservedPath{obs(\"M\", \"a.go\")})\n\tg := materialGraph(\"h1\", \"sha256:indexed\")\n\tg.ChangeSets[0].MaterialInputs = &in\n\tresult := DeliveryValidationResult{GitHead: \"h1\", MaterialProvenance: map[string]string{\"s\": ScopedMaterialDigest(g, \"s\")}}\n\n\tdefer SetCurrentMaterialDigests(nil)\n\tSetCurrentMaterialDigests(func(string, MaterialInputs) string { return \"sha256:indexed\" })\n\tsame := materialGraph(\"h1\", \"sha256:indexed\")\n\tsame.ChangeSets = withCurrentMaterial(\"/x\", g.ChangeSets)\n\tif !deliveryEvidenceCurrent(result, \"s\", \"in-progress\", same, same.ChangeSets) {\n\t\tt.Fatal(\"an unchanged tree made current evidence stale\")\n\t}\n\t// An untrailered commit changed an observed path after the index was built.\n\tSetCurrentMaterialDigests(func(string, MaterialInputs) string { return \"sha256:after-the-index\" })\n\tmoved := materialGraph(\"h1\", \"sha256:indexed\")\n\tmoved.ChangeSets = withCurrentMaterial(\"/x\", g.ChangeSets)\n\tif deliveryEvidenceCurrent(result, \"s\", \"in-progress\", moved, moved.ChangeSets) {\n\t\tt.Fatal(\"the persisted index vouched for a tree that changed after it was built\")\n\t}\n}\n\nfunc TestLegacyDigestsIgnoreTheMaterialFields(t *testing.T) {\n\tplain := materialGraph(\"h1\", \"\")\n\trich := materialGraph(\"h1\", \"sha256:m\")\n\trich.ChangeSets[0].MaterialInputs = &MaterialInputs{Names: []string{\"a.go\"}, Moved: []string{\"b.go\"}}\n\tif ScopedDeliveryProvenanceDigest(plain, \"s\") != ScopedDeliveryProvenanceDigest(rich, \"s\") {\n\t\tt.Fatal(\"the scoped provenance digest moved with the material inputs\")\n\t}\n\tif string(mustJSON(t, withoutMaterialDigest(rich.ChangeSets))) != string(mustJSON(t, withoutMaterialDigest(plain.ChangeSets))) {\n\t\tt.Fatal(\"the commit-bound representation of a change set kept a material field\")\n\t}\n}\n\nfunc mustJSON(t *testing.T, v any) []byte {\n\tt.Helper()\n\traw, err := json.Marshal(v)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn raw\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/rules/documentation-style.md .pose/rules/knowledge-governance.md; rg --files .pose/knowledge | rg 'material|validation|evidence'; rg -n 'material|validation-evidence' pose-mcp/internal/cli/testdata/adversarial/README.md; rg -n 'internal/cli|cli\\\\.' pose-mcp/internal/mcpserver/server.go pose-mcp/cmd -g '*.go'; rg -n 'func cmd(Artifact|Surface|Closeout|ReviewCheck)|refreshDeliveryIndex|AssessDelivery' pose-mcp/internal/cli/{artifact_integrity.go,delivery*.go,close*.go,review*.go}\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/rules/documentation-style.md .pose/rules/knowledge-governance.md; rg --files .pose/knowledge | rg 'material|validation|evidence'; rg -n 'material|validation-evidence' pose-mcp/internal/cli/testdata/adversarial/README.md; rg -n 'internal/cli|cli\\\\.' pose-mcp/internal/mcpserver/server.go pose-mcp/cmd -g '*.go'; rg -n 'func cmd(Artifact|Surface|Closeout|ReviewCheck)|refreshDeliveryIndex|AssessDelivery' pose-mcp/internal/cli/{artifact_integrity.go,delivery*.go,close*.go,review*.go}\"","aggregated_output":"# Rule: Documentation Style\n\n## When to consult\n\nConsult this guide for process documentation, rules, specs, workflows, and operational instructions.\n\n## Required conventions\n\n- Write instructions in the imperative mood and begin them with action verbs.\n- Keep bullets short and limited to one idea.\n- Avoid duplicating sections with the same purpose across files.\n- Link to the single source of truth instead of copying its content.\n- Use `check`, `spec`, and `workflow` consistently.\n- State each instruction's scope explicitly to reduce ambiguity.\n\n## Examples: good and bad\n\n### Redundancy\n\n- **Good:** \"Update review criteria in `.pose/workflows/review.md` and reference that workflow from the root AGENTS file.\"\n- **Bad:** \"Repeat review criteria in AGENTS, the workflow, and every related spec.\"\n\n### Ambiguous reference\n\n- **Good:** \"Run the lint check described by the review workflow.\"\n- **Bad:** \"Run that standard validation before pushing.\"\n\n## Quick editorial checklist\n\n- Language is imperative and direct.\n- Bullets are short and non-overlapping.\n- Files do not duplicate sections.\n- `check`, `spec`, and `workflow` are used consistently.\n- References point to explicit files or paths.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Knowledge Governance\n\n## When to consult\n\nConsult this guide when creating, updating, reviewing, or removing artifacts under `.pose/knowledge/`.\n\n## TTL and retention\n\n- Set `expires_at` on every artifact when it is created.\n- Use a default TTL of 30 days for notes, decision logs, and handoffs.\n- Use a TTL of up to 90 days only with a justification recorded in the artifact body.\n- Treat an artifact without `expires_at` as non-compliant and block its creation or merge.\n\n## When this is not the right home\n\n- Use `.pose/knowledge/` only for time-bound operational memory: content\n  tied to a decision moment, a handoff between executions, or something\n  meant to be reviewed and eventually expire.\n- A durable fact or convention that will not become false and carries no\n  review trigger — a third-party tool's parsing quirk, a naming\n  convention, a recurring gotcha — is not a `decision-log` just because no\n  better type exists. Route it to `.pose/rules/` instead: add it to an\n  existing rule file or create one, then wire it into the relevant task\n  type's base `rules` array in `.pose/indexes/task-map.json` so\n  `pose suggest <task>` surfaces it automatically. No path scoping is\n  required — a task type's base `rules` list is returned regardless of\n  `--path`; only language/component-specific rules need the\n  `rules_by_domain` layer.\n- Rule of thumb: if nothing was decided or traded off, and nothing about\n  the fact will change on a predictable timeline, it is not a\n  `decision-log` and not an ADR — it is a rule. See ADR\n  `2026-08-15-durable-non-architectural-knowledge-belongs-in-rules-not-a-new-type`.\n\n## Reusable cross-execution format\n\n- Structure reusable context as a handoff with fixed sections: Context, Current state, Next checks, Risks, and Next owner.\n- Keep `source_refs` linked to the relevant spec, workflow, and executed check commands.\n- Record `last_reviewed_at` in the body to make effective cross-execution updates traceable.\n\n## Archiving and purging\n\n- Run biweekly triage to list expired artifacts.\n- Move expired artifacts to `.pose/knowledge/archive/` when they retain audit value.\n- Purge archived artifacts 180 days after expiration unless documented legal or compliance requirements apply.\n- Record every archive and purge action in the housekeeping log.\n\n## Sensitive content\n\n- Prohibit secrets, tokens, credentials, private keys, and equivalent material.\n- Prohibit personal data and non-anonymized customer data.\n- Do not copy restricted incidents or reports in full; keep only a controlled reference.\n- Classify frontmatter `sensitivity` as `public-internal` or `restricted`.\n- Remove identified sensitive content immediately and open a security follow-up.\n\n## Ownership and review\n\n- Keep `@pose-maintainers` as the primary governance owner.\n- Require an owner in every artifact frontmatter.\n- Review expiration biweekly and quality monthly.\n- Escalate a backlog overdue by more than two cycles to the primary owner.\n- Block backlog growth when `list-expired` exceeds the operational limit: zero in strict mode, two in tolerant mode.\n\n## Minimum operational checks\n\n- Run `pose knowledge-check --strict` biweekly to validate the expired backlog.\n- Run `pose knowledge-housekeeping list-expired` for detailed triage.\n- Run `pose knowledge-housekeeping archive-expired --dry-run` before applying changes.\n- Execute destructive actions only with an explicit `--apply` flag.\n.pose/knowledge/2026-10-14-decision-log-adr-release-temporal-evidence-review.md\n.pose/knowledge/archive/2026-08-03-decision-log-project-agnostic-assessment-evidence.md\n33:| `code-change-keeps-judgment` | enforced | The reviewed code changes and every criterion still reads as equivalent, so the old judgment is reused | pose-material-equivalence-reuse |\n37:| `calendar-ttl-as-premise-trigger` | enforced | An arbitrary expiry date is accepted as the material trigger of a premise | pose-assumption-validity-scope |\npose-mcp/cmd/pose/main.go:8:\t\"github.com/harne8/pose-mcp/internal/cli\"\npose-mcp/cmd/pose/main.go:13:\t\tos.Exit(cli.HookMain(base, os.Stdout, os.Stderr))\npose-mcp/cmd/pose/main.go:15:\tos.Exit(cli.Main(os.Args[1:], os.Stdout, os.Stderr))\npose-mcp/internal/cli/review_closeout.go:71:func cmdReviewCheck(root string, args []string, stdout, stderr io.Writer) int {\npose-mcp/internal/cli/review_closeout.go:298:func cmdCloseoutCheck(root string, args []string, stdout, stderr io.Writer) int {\npose-mcp/internal/cli/review_closeout.go:584:\t\t\t\trefreshDeliveryIndex(root, append(raw, '\\n'), stderr)\npose-mcp/internal/cli/artifact_integrity.go:642:func cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\npose-mcp/internal/cli/artifact_integrity.go:784:\t\t\trefreshDeliveryIndex(root, append(raw, '\\n'), stderr)\npose-mcp/internal/cli/artifact_integrity.go:798:func cmdArtifactBackfill(root string, args []string, stdout, stderr io.Writer) int {\n","exit_code":0,"status":"completed"}}
