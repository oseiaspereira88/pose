tring) (posemodel.ChangeSet, error) {\n\treturn resolveGitChangeSetWithTrailersAndFiles(nil, root, spec, base, head, captured)\n}\n\nfunc resolveGitChangeSetWithTrailersIn(files posemodel.Files, root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\n\treturn resolveGitChangeSetWithTrailersAndFiles(files, root, spec, base, head, captured)\n}\n\nfunc resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\n\tgitOutput := func(limit int, args ...string) ([]byte, error) {\n\t\tif files == nil {\n\t\t\treturn gitOutputBounded(root, limit, args...)\n\t\t}\n\t\treturn gitOutputBoundedIn(files, root, limit, args...)\n\t}\n\tresolveRevision := func(revision string) (string, error) {\n\t\treturn resolveGitRevisionWithFiles(files, root, revision)\n\t}\n\tif spec == \"\" || posemodel.ValidateSlug(spec) != nil {\n\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"a valid spec slug is required\")\n\t}\n\tselector := \"range:\" + base + \"..\" + head\n\tvar trailerCommits []string\n\tif base == \"\" && head == \"\" {\n\t\tcommits := append([]string(nil), captured...)\n\t\tif len(commits) == 0 {\n\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"no commits carry POSE-Spec: %s\", spec)\n\t\t}\n\t\ttrailerCommits = commits\n\t\thead = commits[len(commits)-1]\n\t\tbase = commits[0] + \"^\"\n\t\tselector = \"trailers:\" + spec\n\t} else if base == \"\" || head == \"\" {\n\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"--from and --to must be supplied together\")\n\t}\n\tresolvedBase := base\n\tif !posemodel.IsGitEmptyTree(base) {\n\t\tvar err error\n\t\tif resolvedBase, err = resolveRevision(base); err != nil && len(trailerCommits) > 0 {\n\t\t\tvar isRoot bool\n\t\t\tvar headerErr error\n\t\t\tif files == nil {\n\t\t\t\tisRoot, headerErr = commitHasNoParent(root, trailerCommits[0])\n\t\t\t} else {\n\t\t\t\tisRoot, headerErr = commitHasNoParentIn(files, root, trailerCommits[0])\n\t\t\t}\n\t\t\tif headerErr != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"%w; %v\", err, headerErr)\n\t\t\t}\n\t\t\tif isRoot {\n\t\t\t\tbase, resolvedBase, err = posemodel.GitEmptyTree(trailerCommits[0]), posemodel.GitEmptyTree(trailerCommits[0]), nil\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n\t}\n\tresolvedHead, err := resolveRevision(head)\n\tif err != nil {\n\t\treturn posemodel.ChangeSet{}, err\n\t}\n\tcommitsRaw, err := gitOutput(4*1024*1024, \"rev-list\", \"--reverse\", posemodel.ChangeSetRange(resolvedBase, resolvedHead), \"--\")\n\tif err != nil {\n\t\treturn posemodel.ChangeSet{}, err\n\t}\n\tcommits := splitNonEmpty(string(commitsRaw), \"\\n\")\npose-mcp/internal/cli/artifact_integrity.go:39:func gitOutputBounded(root string, limit int, args ...string) ([]byte, error) {\npose-mcp/internal/cli/artifact_integrity.go:45:func gitOutputBoundedContext(ctx context.Context, root string, limit int, args ...string) ([]byte, error) {\npose-mcp/internal/cli/artifact_integrity.go:62:func gitOutputBoundedIn(files posemodel.Files, root string, limit int, args ...string) ([]byte, error) {\npose-mcp/internal/cli/artifact_integrity.go:199:\tgitOutput := func(limit int, args ...string) ([]byte, error) {\npackage pose\n\nimport (\n\t\"encoding/json\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// The capability assessment is written by POSE itself (pose capability) and\n// its bullets are the authority on each mechanism's state; the history beside\n// it is the append-only record of snapshots taken from it. A change set that\n// touched either could not be sealed: both fell through every classification\n// rule and blocked as \"unclassified review subject path\".\nfunc TestReviewSubjectClassifiesTheCapabilityAssessment(t *testing.T) {\n\troot, store := reviewBundleFixture(t)\n\twriteReviewFixture(t, root, \".pose/capabilities/assessment.md\", \"---\\nschema_version: 1\\n---\\n\")\n\twriteReviewFixture(t, root, \".pose/capabilities/history.jsonl\", \"{}\\n\")\n\tgraph, err := store.GetDeliveryIntegrity(\"\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgraph.ChangeSets[0].Paths = append(graph.ChangeSets[0].Paths,\n\t\tObservedPath{Action: \"modified\", Path: \".pose/capabilities/assessment.md\"},\n\t\tObservedPath{Action: \"modified\", Path: \".pose/capabilities/history.jsonl\"},\n\t)\n\traw, _ := json.Marshal(graph)\n\twriteReviewFixture(t, root, \".pose/indexes/delivery-integrity.json\", string(raw))\n\tbundle, err := store.PrepareReviewBundle(\"spec:backend\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif blockers := strings.Join(bundle.Blockers, \" \"); strings.Contains(blockers, \".pose/capabilities/\") {\n\t\tt.Fatalf(\"capability paths blocked the bundle: %s\", blockers)\n\t}\n\tclasses := map[string]string{}\n\tfor _, entry := range bundle.Payload.Subject.Entries {\n\t\tclasses[entry.Path] = entry.Class\n\t}\n\t// The assessment is authored state a reviewer must see change, so it is\n\t// in the subject; the history is derived from it and is recorded as an\n\t// excluded input instead.\n\tif got := classes[\".pose/capabilities/assessment.md\"]; got != \"governance\" {\n\t\tt.Errorf(\"assessment class = %q, want governance\", got)\n\t}\n\tif _, ok := classes[\".pose/capabilities/history.jsonl\"]; ok {\n\t\tt.Error(\"capability history is in the review subject\")\n\t}\n\texcluded := false\n\tfor _, input := range bundle.ExcludedInputs {\n\t\tif input.Path == \".pose/capabilities/history.jsonl\" && input.Kind == \"derived-evidence\" {\n\t\t\texcluded = true\n\t\t}\n\t}\n\tif !excluded {\n\t\tt.Errorf(\"capability history is not an excluded derived-evidence input: %+v\", bundle.ExcludedInputs)\n\t}\n}\n\n// Spec pose-review-attribution-roles: supplements are review records, read\n// like attestations, never a review subject of their own.\nfunc TestAttributionSupplementsAreDerivedReviewEvidence(t *testing.T) {\n\tif class, include := reviewBundlePathClass(\".pose/review-attribution-supplements/ras-0000000000000000.json\", ScopeRef{Kind: \"spec\", Slug: \"x\"}, nil); class != \"derived-evidence\" || include {\n\t\tt.Fatalf(\"supplement classified as %q include=%v\", class, include)\n\t}\n}\n\n// Spec pose-action-requests: an action request journal is a governance record\n// a reviewer reads with the change.\nfunc TestActionRequestJournalsAreGovernanceSubjects(t *testing.T) {\n\tif class, include := reviewBundlePathClass(\".pose/actions/act-0000000000000000.jsonl\", ScopeRef{Kind: \"spec\", Slug: \"x\"}, nil); class != \"governance\" || !include {\n\t\tt.Fatalf(\"journal classified as %q include=%v\", class, include)\n\t}\n}\n\n// Spec pose-recoverable-closeout-plan: a closeout checkpoint is runtime\n// progress, not something to review.\nfunc TestCloseoutCheckpointsAreDerivedEvidence(t *testing.T) {\n\tif class, include := reviewBundlePathClass(\".pose/closeout-plans/spec-x.json\", ScopeRef{Kind: \"spec\", Slug: \"x\"}, nil); class != \"derived-evidence\" || include {\n\t\tt.Fatalf(\"checkpoint classified as %q include=%v\", class, include)\n\t}\n}\n\n// Spec pose-delegation-parity-gate R1 (review round 2, PG-R2-04): the parity\n// matrix is authored governance a reviewer must see change: it is in the\n// subject, with a digest that follows its content, and never blocks the\n// bundle as an unclassified path.\nfunc TestReviewSubjectClassifiesTheParityMatrix(t *testing.T) {\n\troot, store := reviewBundleFixture(t)\n\tconst matrix = \".pose/parity/delegation-launchers.json\"\n\twriteReviewFixture(t, root, matrix, `{\"schema_version\": 1, \"rows\": []}`+\"\\n\")\n\tgraph, err := store.GetDeliveryIntegrity(\"\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgraph.ChangeSets[0].Paths = append(graph.ChangeSets[0].Paths, ObservedPath{Action: \"created\", Path: matrix})\n\traw, _ := json.Marshal(graph)\n\twriteReviewFixture(t, root, \".pose/indexes/delivery-integrity.json\", string(raw))\n\tdigestOf := func() string {\n\t\tt.Helper()\n\t\tbundle, err := store.PrepareReviewBundle(\"spec:backend\")\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif blockers := strings.Join(bundle.Blockers, \" \"); strings.Contains(blockers, \".pose/parity/\") {\n\t\t\tt.Fatalf(\"the parity matrix blocked the bundle: %s\", blockers)\n\t\t}\n\t\tfor _, entry := range bundle.Payload.Subject.Entries {\n\t\t\tif entry.Path == matrix {\n\t\t\t\tif entry.Class != \"governance\" || entry.Digest == \"\" {\n\t\t\t\t\tt.Fatalf(\"the parity matrix in the subject: %+v\", entry)\n\tscope, _ := posemodel.ParseScopeRef(ref)\n\tif scope.Kind == \"milestone\" {\n\t\tgate, err := roadmapGate(root, scope.Roadmap, scope.Milestone)\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tif blockers := uniqueCLIStrings(gate.blockers); len(blockers) > 0 {\n\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + strings.Join(blockers, \"; \"))\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"Milestone closeout verified: %s\\n\", ref)\n\t\trenderCloseNext(render(stdout, stderr), nextCloses(store, ref))\n\t\treturn 0\n\t}\n\tvar path string\n\tif scope.Kind == \"spec\" {\n\t\tsp, err := store.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tif policy, err := posemodel.LoadArtifactPolicyIn(store.FS, root); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t} else if policy.Enabled && sp.CreatedAt >= policy.AdoptedAt {\n\t\t\tclaims, found, err := posemodel.ParseArtifactClaims(*sp, policy)\n\t\t\tif err != nil || !found || len(claims) == 0 {\n\t\t\t\tfmt.Fprintf(stderr, \"pose close: artifact declaration gate failed: %v\\n\", err)\n\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t\tif policy, err := posemodel.LoadDeliveryPolicyIn(store.FS, root); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t} else if policy.Enabled && sp.CreatedAt >= policy.AdoptedAt {\n\t\t\tif graph, graphErr := buildCurrentDeliveryGraphIn(store.FS, root); graphErr != nil {\n\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: delivery assurance gate failed: %s\", graphErr))\n\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\treturn 1\n\t\t\t} else if blockers := deliverySpecBlockersFromGraph(graph, sp.Slug); len(blockers) > 0 {\n\t\t\t\tfmt.Fprintf(stderr, \"pose close: delivery assurance gate failed: %s\\n\", strings.Join(blockers, \"; \"))\n\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t\tif _, findings, err := store.InspectAmendmentHistory(*sp); err != nil || len(findings) > 0 {\n\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: amendment history gate failed: %v %s\", err, strings.Join(findings, \"; \")))\n\t\t\treturn 1\n\t\t}\n\t\t// The exit gate of a spec is its requirement trace: closing marks it\n\t\t// done, and a done spec whose promises point at no evidence fails\n\t\t// lint. Refusing here keeps `pose close` from producing what the\n\t\t// next lint rejects (spec pose-quickstart-real-lifecycle).\n\t\tif raw, err := store.FS.ReadFile(sp.Path); err == nil {\n\t\t\tif blockers := posemodel.RequirementTraceCloseoutBlockers(string(raw)); len(blockers) > 0 {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate failed: \" + strings.Join(blockers, \"; \") + \" — declare each under `### Requirement trace`, e.g. `- R1 [satisfied] test:<TestName>`, or [waived: <reason>] / [withdrawn: <reason>]\")\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\t// A test: ref must name a test that exists, or the trace points a\n\t\t\t// promise at nothing (spec pose-trace-test-refs-resolve).\n\t\t\tif unresolved := posemodel.UnresolvedTestRefs(posemodel.ParseRequirementTrace(string(raw)), posemodel.LoadTestCatalog(root)); len(unresolved) > 0 {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate failed: \" + strings.Join(unresolved, \"; \") + \" names no test in this repository or its submodules — cite the test function, subtest, test title or test file\")\n\t\t\t\treturn 1\n\t\t\t}\n78:\t\tcase \"design\":\n106:\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n288:\t\tif err := os.WriteFile(store.CapabilityAssessmentPath(), []byte(content), 0o644); err != nil {\n","exit_code":0,"status":"completed"}}
