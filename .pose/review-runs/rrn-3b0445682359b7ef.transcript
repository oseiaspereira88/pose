{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '590,626p' pose-mcp/internal/pose/delivery_surface.go; sed -n '330,390p' pose-mcp/internal/pose/delivery_integrity.go; sed -n '1,105p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '1,120p' pose-mcp/internal/pose/material_binding.go | nl -ba | tail -15; rg -n 'graph := DeliveryIntegrityGraph|ChangeSets:' pose-mcp/internal/pose/delivery_integrity.go; rg -n 'func \\\\(s Store\\\\).*ReviewBundle|CurrentMaterial' pose-mcp/internal/pose/review_bundle.go | head\"","aggregated_output":"\t\t\t}\n\t\t}\n\t\tgraph.RoadmapCriteria = append(graph.RoadmapCriteria, criteria...)\n\t}\n\tfinalizeExtendedDeliveryGraph(&graph)\n\treturn graph\n}\n\n// ScopedDeliveryProvenanceDigest binds evidence only to the claims and change\n// sets consumed by one spec. Adding an unrelated target or change set cannot\n// invalidate historical evidence for this scope.\nfunc ScopedDeliveryProvenanceDigest(graph DeliveryIntegrityGraph, spec string) string {\n\tclaims := []ArtifactClaim{}\n\tsets := []ChangeSet{}\n\tfor _, claim := range graph.Claims {\n\t\tif claim.Spec == spec {\n\t\t\tclaims = append(claims, claim)\n\t\t}\n\t}\n\tfor _, set := range graph.ChangeSets {\n\t\tif set.Spec == spec {\n\t\t\tsets = append(sets, set)\n\t\t}\n\t}\n\tsort.Slice(claims, func(i, j int) bool { return claimKey(claims[i]) < claimKey(claims[j]) })\n\tsort.Slice(sets, func(i, j int) bool { return sets[i].ID < sets[j].ID })\n\traw, _ := json.Marshal(struct {\n\t\tClaims []ArtifactClaim `json:\"claims\"`\n\t\tSets   []ChangeSet     `json:\"change_sets\"`\n\t}{claims, withoutMaterialDigest(sets)})\n\tsum := sha256.Sum256(raw)\n\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n}\n\nfunc deliveryEvidenceCurrent(result DeliveryValidationResult, spec, status string, graph DeliveryIntegrityGraph, sets []ChangeSet) bool {\n\tif bound := result.MaterialProvenance[spec]; bound != \"\" {\n\t\t// A material binding governs: a mismatch is stale, never a fall-through\n// fragments a release archived.\nfunc BuildDeliveryIntegrityWithReleasesIn(files Files, specs []Spec, claims []ArtifactClaim, changeSets []ChangeSet, tracked []string, policy ArtifactPolicy, archived []ArchivedFragment) DeliveryIntegrityGraph {\n\treturn BuildDeliveryIntegrityWithHistoryIn(files, specs, claims, changeSets, tracked, policy, archived, nil)\n}\n\n// BuildDeliveryIntegrityWithHistoryIn builds the graph with the release\n// archivals and the later removals (spec pose-delivery-later-removal) that\n// can satisfy the existence of a declared artifact.\nfunc BuildDeliveryIntegrityWithHistoryIn(files Files, specs []Spec, claims []ArtifactClaim, changeSets []ChangeSet, tracked []string, policy ArtifactPolicy, archived []ArchivedFragment, removals []ArtifactRemoval) DeliveryIntegrityGraph {\n\tgraph := DeliveryIntegrityGraph{SchemaVersion: DeliveryIntegritySchemaVersion, Claims: append([]ArtifactClaim{}, claims...), ChangeSets: append([]ChangeSet{}, changeSets...), Reverse: map[string][]string{}, Nodes: []DeliveryIntegrityNode{}, Edges: []DeliveryIntegrityEdge{}, Findings: []DeliveryIntegrityFinding{}}\n\tsort.Slice(graph.Claims, func(i, j int) bool { return claimKey(graph.Claims[i]) < claimKey(graph.Claims[j]) })\n\tsort.Slice(graph.ChangeSets, func(i, j int) bool { return graph.ChangeSets[i].ID < graph.ChangeSets[j].ID })\n\tclaimBySpec := map[string][]ArtifactClaim{}\n\tclaimedPaths := map[string]bool{}\n\ttrackedSet := map[string]bool{}\n\tnormalizedTrackedSet := map[string]bool{}\n\tfor _, path := range tracked {\n\t\tp := filepath.ToSlash(path)\n\t\ttrackedSet[p] = true\n\t\tnormalizedTrackedSet[normalizeSpecPath(p)] = true\n\t}\n\tisTracked := func(path string) bool {\n\t\treturn len(tracked) == 0 || trackedSet[path] || normalizedTrackedSet[normalizeSpecPath(path)]\n\t}\n\tledger := newArchivalLedger(archived, isTracked)\n\t// recordArchival records a release archival that resolved a claim: the\n\t// declared artifact is archived-by the release, which archives the file at\n\t// its new path, and that path counts as claimed by the spec.\n\trecordArchival := func(a ArchivedFragment) {\n\t\tfor _, used := range graph.Archivals {\n\t\t\tif used == a {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\tgraph.Archivals = append(graph.Archivals, a)\n\t\tclaimedPaths[a.Archived] = true\n\t\tgraph.Reverse[a.Archived] = appendUnique(graph.Reverse[a.Archived], a.Spec)\n\t\tgraph.Nodes = appendNode(graph.Nodes, DeliveryIntegrityNode{ID: \"release:\" + a.Version, Type: \"release\", Attributes: map[string]string{\"version\": a.Version}})\n\t\tgraph.Nodes = appendNode(graph.Nodes, DeliveryIntegrityNode{ID: \"artifact:\" + a.Archived, Type: \"artifact\", Attributes: map[string]string{\"path\": a.Archived}})\n\t\tgraph.Edges = append(graph.Edges,\n\t\t\tDeliveryIntegrityEdge{From: \"artifact:\" + a.Pending, To: \"release:\" + a.Version, Type: \"archived-by\"},\n\t\t\tDeliveryIntegrityEdge{From: \"release:\" + a.Version, To: \"artifact:\" + a.Archived, Type: \"archives\"})\n\t}\n\t// recordRemoval records a later removal that satisfied a claim: the\n\t// artifact is removed-by the removing spec, at the deleting commit.\n\trecordRemoval := func(r ArtifactRemoval, claim ArtifactClaim) {\n\t\tused := false\n\t\tfor _, have := range graph.Removals {\n\t\t\tif have.Spec == r.Spec && have.Path == r.Path {\n\t\t\t\tused = true\n\t\t\t}\n\t\t}\n\t\tif !used {\n\t\t\tgraph.Removals = append(graph.Removals, r)\n\t\t}\n\t\tgraph.Nodes = appendNode(graph.Nodes, DeliveryIntegrityNode{ID: \"spec:\" + r.Spec, Type: \"spec\"})\n\t\tgraph.Edges = append(graph.Edges, DeliveryIntegrityEdge{From: \"artifact:\" + claim.Path, To: \"spec:\" + r.Spec, Type: \"removed-by\"})\n\t}\n\tfor _, claim := range graph.Claims {\n\t\tclaimBySpec[claim.Spec] = append(claimBySpec[claim.Spec], claim)\n\t\tif claim.Action == \"none\" {\npackage cli\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"fmt\"\n\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nvar safeGitRevision = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._/~^+-]{0,127}$`)\n\nfunc validateGitRevision(value string) error {\n\tif !safeGitRevision.MatchString(value) || strings.Contains(value, \"..\") || strings.Contains(value, \"@{\") || strings.HasPrefix(value, \"-\") {\n\t\treturn fmt.Errorf(\"unsafe Git revision %q\", value)\n\t}\n\treturn nil\n}\n\n// gitOutputBounded reads raw object history (posemodel.RawHistoryGit), so the\n// change sets a later removal is judged on are the ones it judges (review\n// round 3 of spec pose-delivery-later-removal, LR-R3-01).\nfunc gitOutputBounded(root string, limit int, args ...string) ([]byte, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n\tdefer cancel()\n\treturn gitOutputBoundedContext(ctx, root, limit, args...)\n}\n\nfunc gitOutputBoundedContext(ctx context.Context, root string, limit int, args ...string) ([]byte, error) {\n\tcmd := posemodel.RawHistoryGitContext(ctx, root, args...)\n\tcmd.WaitDelay = 2 * time.Second\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &limitedBuffer{buf: &stdout, limit: limit}\n\tcmd.Stderr = &limitedBuffer{buf: &stderr, limit: 64 * 1024}\n\tif err := cmd.Run(); err != nil {\n\t\tif ctx.Err() != nil {\n\t\t\treturn nil, fmt.Errorf(\"git %s failed: %w\", args[0], ctx.Err())\n\t\t}\n\t\treturn nil, fmt.Errorf(\"git %s failed: %w: %s\", args[0], err, strings.TrimSpace(stderr.String()))\n\t}\n\treturn stdout.Bytes(), nil\n}\n\n// gitOutputBoundedIn preserves the raw-history command policy while routing\n// the exact output through an operation read view when Files carries one.\nfunc gitOutputBoundedIn(files posemodel.Files, root string, limit int, args ...string) ([]byte, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n\tdefer cancel()\n\tout, err := posemodel.CaptureGovernanceRawHistoryGitContextIn(files, ctx, root, \"index.delivery-integrity\", int64(limit), args...)\n\t// The capture retains bounded stderr on ExitError. Keep that forensic cause\n\t// in collection gaps as well as the typed unknown error; never retry outside\n\t// the view or use partial stdout after a failed history read.\n\tvar exit *exec.ExitError\n\tif errors.As(err, &exit) {\n\t\tif detail := strings.TrimSpace(string(exit.Stderr)); detail != \"\" {\n\t\t\treturn nil, fmt.Errorf(\"%w: %s\", err, detail)\n\t\t}\n\t}\n\treturn out, err\n}\n\ntype limitedBuffer struct {\n\tbuf   *bytes.Buffer\n\tlimit int\n}\n\nfunc (w *limitedBuffer) Write(p []byte) (int, error) {\n\tif w.buf.Len()+len(p) > w.limit {\n\t\treturn 0, fmt.Errorf(\"bounded Git output exceeded %d bytes\", w.limit)\n\t}\n\treturn w.buf.Write(p)\n}\n\nfunc resolveGitRevision(root, revision string) (string, error) {\n\treturn resolveGitRevisionWithFiles(nil, root, revision)\n}\n\nfunc resolveGitRevisionWithFiles(files posemodel.Files, root, revision string) (string, error) {\n\tif err := validateGitRevision(revision); err != nil {\n\t\treturn \"\", err\n\t}\n\tvar out []byte\n\tvar err error\n\tif files == nil {\n\t\tout, err = gitOutputBounded(root, 1024, \"rev-parse\", \"--verify\", revision+\"^{commit}\")\n\t} else {\n\t\tout, err = gitOutputBoundedIn(files, root, 1024, \"rev-parse\", \"--verify\", revision+\"^{commit}\")\n\t}\n\tif err != nil {\n   106\t\treturn in\n   107\t}\n   108\t\n   109\t// MaterialSetDigest digests the head state of the material a change set\n   110\t// touched: every path it names (both sides of a rename) with its mode and blob\n   111\t// at the validated head, minus the paths that are administrative records and\n   112\t// still regular files there, plus the validation matrix. A symlink, submodule\n   113\t// or directory in an administrative class is material; so is a path that left\n   114\t// a class. tree maps each named path (and the matrix) to its entry; a path\n   115\t// absent from the head tree is \"absent\".\n   116\tfunc MaterialSetDigest(in MaterialInputs, tree map[string]TreeEntry) string {\n   117\t\tmoved := map[string]bool{}\n   118\t\tfor _, name := range in.Moved {\n   119\t\t\tmoved[name] = true\n   120\t\t}\n339:\tgraph := DeliveryIntegrityGraph{SchemaVersion: DeliveryIntegritySchemaVersion, Claims: append([]ArtifactClaim{}, claims...), ChangeSets: append([]ChangeSet{}, changeSets...), Reverse: map[string][]string{}, Nodes: []DeliveryIntegrityNode{}, Edges: []DeliveryIntegrityEdge{}, Findings: []DeliveryIntegrityFinding{}}\n482:func (s Store) PrepareReviewBundle(ref string) (ReviewBundle, error) {\n490:func (s Store) prepareReviewBundle(ref string, legacyMilestoneManifest bool) (ReviewBundle, error) {\n605:func (s Store) reviewBundleScopeProjection(scope ScopeRef) (ReviewBundleScope, []ReviewBundleInput, error) {\n704:func (s Store) reviewBundleSubject(scope ScopeRef, components []ReviewPlanComponent, graph DeliveryIntegrityGraph, blockers []string) (ReviewBundleSubject, []ReviewBundleInput, []string, error) {\n905:func (s Store) reviewBundleRangeObservations(ids []string, graph DeliveryIntegrityGraph) []ReviewBundleRangeObservation {\n1595:func (s Store) reviewBundleEvidence(scope ScopeRef, graph DeliveryIntegrityGraph, subject ReviewBundleSubject, plan ReviewBundlePlan) []ReviewBundleEvidence {\n1628:\t\tgraph.ChangeSets = withCurrentMaterial(s.Root, graph.ChangeSets)\n1629:\t\tsets = withCurrentMaterial(s.Root, sets)\n1690:func (s Store) evidenceFallsShort(scope ScopeRef, evidence []ReviewBundleEvidence) bool {\n1699:func (s Store) reviewScopeRequiresValidationEvidence(scope ScopeRef, plan ReviewBundlePlan, graph DeliveryIntegrityGraph) bool {\n","exit_code":0,"status":"completed"}}
