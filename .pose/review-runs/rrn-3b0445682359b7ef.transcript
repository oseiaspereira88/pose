{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/material_binding.go; cat .pose/adr/2026-11-07-validation-evidence-binds-to-validated-material.md; git diff cf445404..53ac5146 -- pose-mcp/internal/pose/delivery_surface.go pose-mcp/internal/pose/review_bundle.go pose-mcp/internal/pose/spec_facts.go pose-mcp/internal/pose/delivery_integrity_cache.go pose-mcp/internal/pose/delivery_integrity_compact.go pose-mcp/internal/pose/delegation_refusal.go pose-mcp/internal/pose/review_dispatch.go pose-mcp/internal/cli/index.go'","aggregated_output":"package pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"path\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Validation evidence binds to the material it validated (spec\n// pose-validation-evidence-material-binding, ADR\n// validation-evidence-binds-to-validated-material). A commit whose every\n// changed path is a derived administrative record does not change what the\n// checks exercised, so it does not move the material digest.\n\n// engineVersion is the running engine, registered by the binaries (internal/pose\n// stays importable on its own). It is part of every material digest, so a new\n// engine never inherits evidence the previous one produced.\nvar engineVersion = \"unregistered\"\n\n// SetEngineVersion registers the running engine for material digests.\nfunc SetEngineVersion(v string) { engineVersion = v }\n\n// administrativeDirs is the closed list of derived-record directories. It is\n// owned by the engine; adding a class is a contract change that needs an ADR.\nvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n\n// materialIndexes are files inside an administrative directory that still\n// change what the checks demand.\nvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\n// IsAdministrativePath reports whether p is a derived administrative record.\nfunc IsAdministrativePath(p string) bool {\n\tif p == \"\" || p != path.Clean(p) || strings.HasPrefix(p, \"/\") || strings.HasPrefix(p, \"../\") {\n\t\treturn false\n\t}\n\tif materialIndexes[p] {\n\t\treturn false\n\t}\n\tif !recordExtensions[strings.ToLower(path.Ext(p))] {\n\t\treturn false\n\t}\n\tfor _, dir := range administrativeDirs {\n\t\tif strings.HasPrefix(p, dir) {\n\t\t\treturn true\n\t\t}\n\t}\n\tif rest, ok := strings.CutPrefix(p, \".pose/\"); ok {\n\t\tif i := strings.Index(rest, \"/\"); i > 0 && strings.HasPrefix(rest[:i], \"review-\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// recordExtensions are the data formats a derived record is written in. Code or\n// a script stored in a class is material: that keeps a source file moved or\n// copied into a class from hiding its later edits. A copied data file stays\n// indistinguishable from a record; a check that reads data out of a derived-record\n// directory is outside this contract (ADR validation-evidence-binds-to-validated-material).\nvar recordExtensions = map[string]bool{\".json\": true, \".jsonl\": true, \".ndjson\": true, \".md\": true, \".txt\": true, \".log\": true, \".transcript\": true}\n\n// TreeEntry is one entry of the validated head's tree.\ntype TreeEntry struct{ Mode, Blob string }\n\nfunc regularMode(mode string) bool { return mode == \"100644\" || mode == \"100755\" }\n\n// MaterialInputs are what a material digest is computed from: the paths a change\n// set names (both sides of a rename, and the validation matrix) and the\n// destinations of renames. They are stored with the set so the digest can be\n// recomputed against the current tree without the commits' own records.\ntype MaterialInputs struct {\n\tNames []string `json:\"names\"`\n\tMoved []string `json:\"moved,omitempty\"`\n}\n\n// MaterialInputsOf derives the inputs from per-commit path records. They must\n// be unmerged: folding a create and a later rename into one creation would hide\n// that the file moved into a class.\nfunc MaterialInputsOf(paths []ObservedPath) MaterialInputs {\n\tnames := map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\tmoved := map[string]bool{}\n\tfor _, p := range paths {\n\t\tfor _, name := range []string{p.Path, p.OldPath, p.NewPath} {\n\t\t\tif name != \"\" {\n\t\t\t\tnames[name] = true\n\t\t\t}\n\t\t}\n\t\t// A rename destination is material whatever directory it lands in:\n\t\t// otherwise moving a source file into a class would hide its later edits.\n\t\tif p.OldPath != \"\" && p.NewPath != \"\" {\n\t\t\tmoved[p.NewPath] = true\n\t\t}\n\t}\n\tin := MaterialInputs{}\n\tfor name := range names {\n\t\tin.Names = append(in.Names, name)\n\t}\n\tfor name := range moved {\n\t\tin.Moved = append(in.Moved, name)\n\t}\n\tsort.Strings(in.Names)\n\tsort.Strings(in.Moved)\n\treturn in\n}\n\n// MaterialSetDigest digests the head state of the material a change set\n// touched: every path it names (both sides of a rename) with its mode and blob\n// at the validated head, minus the paths that are administrative records and\n// still regular files there, plus the validation matrix. A symlink, submodule\n// or directory in an administrative class is material; so is a path that left\n// a class. tree maps each named path (and the matrix) to its entry; a path\n// absent from the head tree is \"absent\".\nfunc MaterialSetDigest(in MaterialInputs, tree map[string]TreeEntry) string {\n\tmoved := map[string]bool{}\n\tfor _, name := range in.Moved {\n\t\tmoved[name] = true\n\t}\n\tsorted := in.Names\n\th := sha256.New()\n\tfor _, name := range sorted {\n\t\tentry, present := tree[name]\n\t\tif IsAdministrativePath(name) && !moved[name] && (!present || regularMode(entry.Mode)) {\n\t\t\tcontinue\n\t\t}\n\t\tif !present {\n\t\t\th.Write([]byte(name + \"\\x00absent\\n\"))\n\t\t\tcontinue\n\t\t}\n\t\th.Write([]byte(name + \"\\x00\" + entry.Mode + \"\\x00\" + entry.Blob + \"\\n\"))\n\t}\n\treturn \"sha256:\" + hex.EncodeToString(h.Sum(nil))\n}\n\n// MaterialDigestUnreadable marks a change set whose head tree could not be read\n// or whose checkout is not complete. It never binds evidence and never lets\n// evidence recorded without it pass as current.\nconst MaterialDigestUnreadable = \"unreadable\"\n\n// MaterialBindingUnavailable is recorded for a scope whose material cannot be\n// established, so the result is stale for it instead of falling back to the\n// commit-bound rules.\nconst MaterialBindingUnavailable = \"unavailable\"\n\n// MaterialBinding returns what a validation run should record for a spec: the\n// scoped digest, the unavailable marker when a change set's material could not\n// be read, or nothing when the spec has no material-bound change set.\nfunc MaterialBinding(graph DeliveryIntegrityGraph, spec string) (string, bool) {\n\tsets := 0\n\tfor _, set := range graph.ChangeSets {\n\t\tif set.Spec != spec {\n\t\t\tcontinue\n\t\t}\n\t\tsets++\n\t\t// A set read back from the report history carries no material digest, and\n\t\t// one that could not be read has the unreadable marker: either way the\n\t\t// scope's material cannot be established, so the run records the binding as\n\t\t// unavailable instead of silently falling back to the commit-bound rules.\n\t\tif set.MaterialDigest == \"\" || set.MaterialDigest == MaterialDigestUnreadable {\n\t\t\treturn MaterialBindingUnavailable, true\n\t\t}\n\t}\n\tif sets == 0 {\n\t\treturn \"\", false\n\t}\n\tif digest := ScopedMaterialDigest(graph, spec); digest != \"\" {\n\t\treturn digest, true\n\t}\n\treturn \"\", false\n}\n\n// ScopedMaterialDigest binds evidence to the claims and material of one spec's\n// change sets and to the engine. It is empty when any change set has no\n// material digest, so no binding can be recorded for it.\nfunc ScopedMaterialDigest(graph DeliveryIntegrityGraph, spec string) string {\n\tclaims := []ArtifactClaim{}\n\tdigests := []string{}\n\tfor _, claim := range graph.Claims {\n\t\tif claim.Spec == spec {\n\t\t\tclaims = append(claims, claim)\n\t\t}\n\t}\n\tfor _, set := range graph.ChangeSets {\n\t\tif set.Spec != spec {\n\t\t\tcontinue\n\t\t}\n\t\tif set.MaterialDigest == \"\" || set.MaterialDigest == MaterialDigestUnreadable {\n\t\t\treturn \"\"\n\t\t}\n\t\tdigests = append(digests, set.MaterialDigest)\n\t}\n\tif len(digests) == 0 {\n\t\treturn \"\"\n\t}\n\tsort.Slice(claims, func(i, j int) bool { return claimKey(claims[i]) < claimKey(claims[j]) })\n\tsort.Strings(digests)\n\traw, _ := json.Marshal(struct {\n\t\tEngine string          `json:\"engine\"`\n\t\tClaims []ArtifactClaim `json:\"claims\"`\n\t\tDigest []string        `json:\"material\"`\n\t}{engineVersion, claims, digests})\n\tsum := sha256.Sum256(raw)\n\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n}\n\n// withoutMaterialDigest copies change sets without the material digest, so the\n// commit-bound digests keep the representation results were recorded against.\nfunc withoutMaterialDigest(sets []ChangeSet) []ChangeSet {\n\tout := make([]ChangeSet, len(sets))\n\tfor i, set := range sets {\n\t\tset.MaterialDigest = \"\"\n\t\tset.MaterialInputs = nil\n\t\tout[i] = set\n\t}\n\treturn out\n}\n\n// CurrentMaterialDigests recomputes the material digest of each set from its\n// stored inputs against the current tree, through the hook the binary\n// registered. Evidence is judged against these, not against the digests the\n// persisted index recorded when it was built: an untrailered commit after the\n// index changes what the evidence describes (spec\n// pose-validation-evidence-material-binding R6). A set without inputs, or a\n// binary without a hook, keeps the recorded digest.\nvar CurrentMaterialDigests func(root string, inputs MaterialInputs) string\n\n// SetCurrentMaterialDigests registers the recomputation.\nfunc SetCurrentMaterialDigests(f func(root string, inputs MaterialInputs) string) {\n\tCurrentMaterialDigests = f\n}\n\nfunc withCurrentMaterial(root string, sets []ChangeSet) []ChangeSet {\n\tif CurrentMaterialDigests == nil {\n\t\treturn sets\n\t}\n\tout := make([]ChangeSet, len(sets))\n\tfor i, set := range sets {\n\t\tif set.MaterialInputs != nil && set.MaterialDigest != \"\" && set.MaterialDigest != MaterialDigestUnreadable {\n\t\t\tset.MaterialDigest = CurrentMaterialDigests(root, *set.MaterialInputs)\n\t\t}\n\t\tout[i] = set\n\t}\n\treturn out\n}\n# ADR: Validation evidence binds to validated material\n\n## Status\nAccepted (2026-11-07), by spec `pose-validation-evidence-material-binding`.\n\n## Context\n\nEvidence of a validation run is current for an open spec only while the run's\n`scope_provenance[<spec>]` equals `ScopedDeliveryProvenanceDigest`, which\nhashes the spec's claims and change sets, including each set's head and\ncommits. A commit that carries the spec trailer and changes only derived\nrecords (indexes, results, state, assessments, review records, a spec's status)\ntherefore moves the digest and invalidates evidence that still describes the\nsame code. Closing B34 reran the 354 s strict matrix a second time for that\nreason alone.\n\n## Decision\n\nA validation run records, per scope, a `material_digest`. Per change set it\nhashes the head state (path, mode and blob) of every path the set names, both\nsides of a rename included, plus the validation matrix. An administrative record\nthat is still a regular file at the head is left out; a deleted one too. The\nscoped digest adds the spec's claims and the engine version. Evidence stays\ncurrent while the recomputed digest equals the recorded one, and a present\nbinding governs: a mismatch is stale and never falls through to the\ncommit-bound rules.\n\nThe administrative classes are exactly: `.pose/indexes/`, `.pose/results/`,\n`.pose/state/`, `.pose/assessments/` and `.pose/review-*` directories. They are\nowned by the engine and are not configurable by an instance. Everything else,\nincluding every spec file (frontmatter status lines too), `.pose/policy/` and\n`.pose/rules/`, is material. The validation matrix file is inside\n`.pose/indexes/` but deliberately material. A symlink, submodule or directory\nin a class, a path that left a class, and the destination of a rename are\nmaterial. Inside a class only data formats count as records (`.json`, `.jsonl`,\n`.ndjson`, `.md`, `.txt`, `.log`, `.transcript`): code or a script stored there is\nmaterial, which keeps a source file copied or moved into a class from hiding its\nlater edits without tracking copy provenance. The readers follow renames, not\ncopies, so a copied data file stays indistinguishable from a record. That is an\naccepted residual risk: a check that reads data out of a derived-record\ndirectory is outside this contract. A change set read back from the report\nhistory has no material digest, so its\nscope records the binding as unavailable. A change set read from a\ntrailer is judged against the checkout's own tree (HEAD), so a later commit\nwithout the trailer that touches an observed path or the matrix moves the\ndigest; an explicit range reads its end. An unreadable tree or a shallow\ncheckout marks the set unreadable: the run records the binding as unavailable\nfor that scope, which is stale and never falls through to the commit-bound\nrules. A changed engine makes the evidence stale too. Spec facts, review\nbundles, closeout and validation consume the same verdict.\n\nResults without `material_digest` are judged by the existing rule. A scope that\nis already `done` keeps its current exemption. Naming the first differing path\nwould need a stored manifest and is left as a follow-up. The domain returns one verdict\nthat seal, verify, review-check, closeout-check, close, CLI and MCP all consume.\n\n## Limits\n\nThe binding names the committed tree, and validation runs on the working copy.\nA run therefore records it only when the tracked and untracked files outside\nthe administrative records equal HEAD at the start, and it records it as\nunavailable when a tracked file differs from HEAD after the checks. Editing a\ncommitted symlink or submodule inside a class counts as a material change. The\ncontract does not defend against ignored files the project's own ignore rules\nleave out of the tree, against uncommitted edits to a data file that an earlier\ncommit moved into a class, against a concurrent writer that changes and restores\nmaterial during the run, against sparse or skip-worktree checkouts, or against\na run whose delivery graph could not be collected (that run carries no scope\nprovenance either, so the commit-bound rules that always applied to it still do).\nThese are accepted residual risks of a checkout that its operator controls;\nan immutable execution snapshot would close them and is a follow-up.\n\n## Consequences\n\n- A closeout whose later commits are administrative reuses the passing run\n  instead of repeating it.\n- The result schema gains an additive field, a minor change.\n- Adding a class to the list is a contract change that needs its own ADR.\n\nRejected: caching per-check outputs (stale outputs would pass silently);\nconfigurable class lists per instance (an instance could exempt its own code);\nbypassing evidence for any commit that only touches `.pose/` (specs, policy and\nrules there change what the checks demand).\ndiff --git a/pose-mcp/internal/cli/index.go b/pose-mcp/internal/cli/index.go\nindex 8943e287..ea4ee69b 100644\n--- a/pose-mcp/internal/cli/index.go\n+++ b/pose-mcp/internal/cli/index.go\n@@ -258,6 +258,9 @@ func verifyIndexGeneration(files posepkg.Files, root string, gate *gateOutput, o\n // generation and the file is written as it always was. A set that cannot be\n // verified is not written over: the failure is said, not hidden.\n func refreshDeliveryIndex(root string, data []byte, stderr io.Writer) {\n+\tif posepkg.IsSealedCheckout(root) {\n+\t\treturn\n+\t}\n \t_ = os.MkdirAll(filepath.Join(root, \".pose\", \"indexes\"), 0o755)\n \treceipt, _, err := posepkg.Store{Root: root}.ReplaceIndexOrLegacy(\"delivery-integrity.json\", data)\n \tswitch {\ndiff --git a/pose-mcp/internal/pose/delegation_refusal.go b/pose-mcp/internal/pose/delegation_refusal.go\nindex a5f788e8..0fd266de 100644\n--- a/pose-mcp/internal/pose/delegation_refusal.go\n+++ b/pose-mcp/internal/pose/delegation_refusal.go\n@@ -4,7 +4,11 @@ package pose\n // over MCP (spec pose-delegation-mcp R5). The message stays the engine's; the\n // code names the class a caller acts on.\n \n-import \"errors\"\n+import (\n+\t\"errors\"\n+\t\"os\"\n+\t\"path/filepath\"\n+)\n \n // Reason codes of a refused delegated run.\n const (\n@@ -21,6 +25,32 @@ const (\n // directory it starts in (spec pose-delegation-mcp R6, review round 1, B01).\n const DelegateRootEnv = \"POSE_DELEGATE_ROOT\"\n \n+// SealedCheckoutEnv marks a process a delegated review launched in its sealed\n+// checkout, as the path of that checkout. Diagnostic commands that would\n+// republish a derived record there (the delivery index) read it and leave the checkout as sealed: a review that\n+// changes its subject is invalid (spec pose-validation-evidence-material-binding R7).\n+const SealedCheckoutEnv = \"POSE_SEALED_CHECKOUT\"\n+\n+// IsSealedCheckout reports whether root is the sealed checkout the environment\n+// names. The marker carries the checkout's path, so a fixture or another project\n+// a reviewer's process works in is not mistaken for the sealed one.\n+func IsSealedCheckout(root string) bool {\n+\tsealed := os.Getenv(SealedCheckoutEnv)\n+\tif sealed == \"\" || root == \"\" {\n+\t\treturn false\n+\t}\n+\tresolve := func(p string) string {\n+\t\tif abs, err := filepath.Abs(p); err == nil {\n+\t\t\tp = abs\n+\t\t}\n+\t\tif real, err := filepath.EvalSymlinks(p); err == nil {\n+\t\t\tp = real\n+\t\t}\n+\t\treturn filepath.Clean(p)\n+\t}\n+\treturn resolve(sealed) == resolve(root)\n+}\n+\n // DelegationRefusal is a refusal with its reason code.\n type DelegationRefusal struct {\n \tCode string\ndiff --git a/pose-mcp/internal/pose/delivery_integrity_cache.go b/pose-mcp/internal/pose/delivery_integrity_cache.go\nindex 502fe3d1..868e8a5e 100644\n--- a/pose-mcp/internal/pose/delivery_integrity_cache.go\n+++ b/pose-mcp/internal/pose/delivery_integrity_cache.go\n@@ -98,6 +98,17 @@ func bytesEqual(a, b []byte) bool {\n \treturn true\n }\n \n+func copyStringMap(in map[string]string) map[string]string {\n+\tif in == nil {\n+\t\treturn nil\n+\t}\n+\tout := make(map[string]string, len(in))\n+\tfor k, v := range in {\n+\t\tout[k] = v\n+\t}\n+\treturn out\n+}\n+\n // copyDeliveryIntegrityGraph copies every field that a caller could write through.\n // TestDeliveryGraphCopyCoversEveryField fails when a field is added to the struct\n // without being handled here, so an omission cannot become a silently shared slice.\n@@ -108,7 +119,12 @@ func copyDeliveryIntegrityGraph(in DeliveryIntegrityGraph) DeliveryIntegrityGrap\n \tout.Claims = append([]ArtifactClaim{}, in.Claims...)\n \tout.Findings = append([]DeliveryIntegrityFinding{}, in.Findings...)\n \tout.Deliveries = append([]DeliveryTarget{}, in.Deliveries...)\n-\tout.ValidationResults = append([]DeliveryValidationResult{}, in.ValidationResults...)\n+\tout.ValidationResults = make([]DeliveryValidationResult, len(in.ValidationResults))\n+\tfor i, result := range in.ValidationResults {\n+\t\tresult.ScopeProvenance = copyStringMap(result.ScopeProvenance)\n+\t\tresult.MaterialProvenance = copyStringMap(result.MaterialProvenance)\n+\t\tout.ValidationResults[i] = result\n+\t}\n \tout.RoadmapCriteria = append([]RoadmapCriterion{}, in.RoadmapCriteria...)\n \tout.Archivals = append([]ArchivedFragment{}, in.Archivals...)\n \tout.Removals = make([]ArtifactRemoval, len(in.Removals))\n@@ -138,6 +154,10 @@ func copyDeliveryIntegrityGraph(in DeliveryIntegrityGraph) DeliveryIntegrityGrap\n \tfor i, set := range in.ChangeSets {\n \t\tset.Commits = append([]string{}, set.Commits...)\n \t\tset.Paths = append([]ObservedPath{}, set.Paths...)\n+\t\tif set.MaterialInputs != n