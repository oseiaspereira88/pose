{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '189,285p' pose-mcp/internal/cli/surface_check.go; sed -n '1,60p' pose-mcp/internal/pose/review_structure.go; rg -n 'basis.*R|requirement:R|Basis:.*R' pose-mcp/internal/pose/review_structure_test.go | head -15; git diff cf445404..53ac5146 -- POSE.md locales/pt-BR/POSE.md\"","aggregated_output":"func cmdSurfaceCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar spec, resultsPath string\n\tstrict, jsonOutput := true, false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--spec\", \"--results\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\n\t\t\t}\n\t\t\ti++\n\t\t\tif args[i-1] == \"--spec\" {\n\t\t\t\tspec = args[i]\n\t\t\t} else {\n\t\t\t\tresultsPath = args[i]\n\t\t\t}\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\n\t\t}\n\t}\n\tif spec != \"\" && posemodel.ValidateSlug(spec) != nil {\n\t\tfmt.Fprintln(stderr, \"pose surface-check: invalid spec slug\")\n\t\treturn 2\n\t}\n\tpolicy, err := posemodel.LoadDeliveryPolicy(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif resultsPath != \"\" {\n\t\tif !confinedRelativePath(resultsPath) {\n\t\t\tfmt.Fprintln(stderr, \"pose surface-check: results path escapes project\")\n\t\t\treturn 2\n\t\t}\n\t\tpolicy.ResultsPath = filepath.ToSlash(filepath.Clean(resultsPath))\n\t}\n\tbaseSpecs, claims, sets, tracked, artifactPolicy, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tbase := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), baseSpecs, claims, sets, tracked, artifactPolicy, posemodel.LoadArchivedFragments(root), artifactRemovals(root, claims, sets, tracked, gaps))\n\tprofiles, err := loadDeliveryProfiles(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tfullSpecs, targets, err := collectDeliveryTargets(root, baseSpecs, profiles)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tresults, err := loadDeliveryValidationResults(root, policy.ResultsPath)\n\tresults = withSmokeResults(root, results)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tgraph := posemodel.BuildDeliverySurface(base, fullSpecs, targets, results, nil, profiles, policy)\n\tif spec != \"\" {\n\t\tgraph = focusSurfaceGraph(graph, spec)\n\t}\n\tif jsonOutput {\n\t\t_ = writeJSON(stdout, graph)\n\t} else {\n\t\tfmt.Fprintf(stdout, \"surface.spec=%s\\nsurface.targets=%d\\nsurface.results=%d\\nsurface.findings=%d\\nsurface.provenance_digest=%s\\n\", spec, len(graph.Deliveries), len(graph.ValidationResults), len(graph.Findings), graph.ProvenanceDigest)\n\t\tfor _, finding := range graph.Findings {\n\t\t\trender(stdout, stderr).Finding(cliout.Finding{\n\t\t\t\tState: cliout.StateFromKey(finding.Severity), Code: finding.Code, Path: finding.Path,\n\t\t\t\tMessage: finding.Message, Remediation: finding.Remediation,\n\t\t\t})\n\t\t}\n\t}\n\treturn deliveryFindingExit(graph.Findings, strict)\n}\n\nfunc cmdRoadmapCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tif len(args) == 0 {\n\t\treturn usageError(stderr, \"Usage: pose roadmap-check <slug> [--strict|--tolerant] [--json]\")\n\t}\n\tslug := args[0]\n\tstrict, jsonOutput := true, false\n\tfor _, arg := range args[1:] {\n\t\tswitch arg {\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose roadmap-check <slug> [--strict|--tolerant] [--json]\")\npackage pose\n\nimport (\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n)\n\n// What the subject was observed to do, as opposed to what the scope declared.\n//\n// Declared metadata is the author's account of a change. It is a good first\n// trigger and a poor last one: an undeclared dependency is still a dependency,\n// and a Markdown extension is not proof of low risk. This file adds the other\n// half — facts read from both sides of the sealed subject — and keeps it bounded\n// in two ways. Only a closed vocabulary counts as material, so nobody owes a\n// decision for every file, and the observation is resolved only when an adopted\n// profile actually selects on it, so a repository that did not opt in pays\n// nothing, not even the Git reads.\n//\n// MaterialStructuralKinds is that vocabulary. It is the set a detector can\n// observe *and* that carries a design cost worth a reviewer's sentence. A\n// rename, a lock file and an unreadable manifest are all observed and all\n// reported, and none of them is here: the first two are consequences rather than\n// decisions, and the third is uncertainty, which is shown and never charged.\nvar MaterialStructuralKinds = map[string]bool{\n\t\"dependency\":          true,\n\t\"component\":           true,\n\t\"delivery-metadata\":   true,\n\t\"governance-contract\": true,\n\t\"public-contract\":     true,\n\t\"submodule\":           true,\n}\n\n// runtimeTransitive is the one runtime excluded from materiality. A lock file\n// alone does not create dozens of mandatory decisions; the direct relationship\n// the author declared is what does.\nconst runtimeTransitive = \"runtime-transitive\"\n\nfunc sortedMaterialStructuralKinds() []string {\n\tkinds := []string{}\n\tfor kind := range MaterialStructuralKinds {\n\t\tkinds = append(kinds, kind)\n\t}\n\tsort.Strings(kinds)\n\treturn kinds\n}\n\n// StructuralDeltaIsMaterial reports whether one observed delta is a material\n// structural fact. A delta whose state is not `observed` never is: an unknown or\n// unsupported reading is a gap in coverage, and treating it as a fact would let\n// a detector limitation manufacture an obligation.\nfunc StructuralDeltaIsMaterial(delta StructuralDelta) bool {\n\tif delta.State != \"observed\" || !MaterialStructuralKinds[delta.Kind] {\n\t\treturn false\n\t}\n\tif delta.Kind == \"dependency\" && delta.Runtime == runtimeTransitive {\n\t\treturn false\n\t}\n\t// A `component` delta is emitted for every observed manifest, so `changed`\n\t// says only that a manifest in that component was edited — which the\n192:- Basis: R1, A1\n247:\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n259:\t\t{Delta: \"SD-aaaa1111\", Basis: \"D1\"}, {Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n260:\t\t{Delta: \"SD-cccc3333\", Basis: \"R1\"},\n263:\t\t{Delta: \"SD-aaaa1111\", Basis: \"D1\"}, {Delta: \"SD-aaaa1111\", Basis: \"R1\"},\n264:\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n294:\tfor _, basis := range []string{\"A1\", \"C1\", \"D1\", \"R1\"} {\n296:\t\t\t{Delta: \"SD-aaaa1111\", Basis: basis}, {Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n312:\t\t\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n318:\t\t\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n321:\t\t\t\t{Delta: \"SD-aaaa1111\", Disposition: state, Rationale: \"stated reason\", Basis: \"R1\"},\n322:\t\t\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n323:\t\t\t}, \"\"), \"and still names basis R1; state one or the other\")\n328:\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\ndiff --git a/POSE.md b/POSE.md\nindex 863f598c..bb7a2868 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -374,7 +374,7 @@ pose release-notes --version vX.Y.Z  # compatibility alias for the immutable not\n - `state --governance [--scope <ref>] [--json]` (spec `pose-effective-governance-projection`) — live, read-only projection of what governance is in force here: for each registry contract, optional capability (atomic start, contract nodes, causality closeout, qualified references, spec transfer, criterion reuse, signed attestations, verified identity) and gate (Definition of Ready, delivery integrity), whether it is `supported`, `configured`, `applicable` and `effective`, with reason codes such as `not-adopted`, `no-readiness-cutoff`, `legacy-cutoff:<date>` or `identity-assurance-declared`. `--scope` compares the scope's newest sealed bundle — the contracts it stamped — with what the policy seals today. It reads the same functions the gates call and writes nothing. `pose_project_state` carries the same projection as `effective_governance` (optional `governance_scope`).\n - `state --attention` (specs `pose-obligation-projection`, `pose-state-attention`) — live, read-only answer to \"what is still owed, by whom, restricting which phase?\". Obligations are projected from the subsystems that own them — readiness (unmet `depends_on`, Definition of Ready, unexplained `blocked`), closeout and review of in-progress specs (an unapproved review, each judgment criterion a sealed bundle still owes, text blockers carried as `legacy-opaque`), start reconciliation when atomic start is adopted, and open follow-ups as advisory residual debt — never stored a second time. Project-level sources are projected too (spec `pose-attention-projects-every-source`), originating on `xref:<project>/project:<project>`: an open docs review mark (owed by the doc's owner until `pose docs-review resolve`), a capability mechanism with a stale trigger, a release newer than the newest verified one that is not yet verified, and an accepted-risk or follow-up finding past its review date in the latest legacy review record. Free-form investigation notes carry no state and are not a source. The render shows coverage first: a producer that failed, or action requests until adopted, makes the answer `INCOMPLETE`, so an empty group never reads as nothing owed, and a fresh install, once committed, reads `complete`. Then what needs `--actor` (or any person or role), then what restricts each phase (`start`, `execution`, `review`, `closeout`, `release`), then residual debt. `--json` returns the report — stable `obl-` ids, qualified refs, reason codes, conditions, recipients, effects, satisfaction, knowledge, waiting, a snapshot of revision/dirty tree/policy/contract/index digests, per-producer coverage — plus the `attention` grouping. MCP: `pose_obligations` returns the same ids from the same function. Attention is not a gate.\n - Governance read views (spec `pose-governance-read-view-generation`) — inspect `snapshot.read_view` in `state --attention --json` and `pose_obligations`: its own `schema_version: 1`, observed-input ID, engine/parser versions and root bindings describe one operation. The enclosing report stays at schema version 1. Review and closeout JSON expose the same contract in `read_view`. The ID binds consumed bytes, directory observations, errors and absences; revision, dirty state, size and mtime alone do not prove equivalence. `current` describes the final audit instant only. Coherence, producer coverage and freshness are separate: `unknown` or incomplete coverage must never be read as nothing owed or as write authorization. A historical report without this binding remains readable and proves no current authorization.\n-  Reads retain at most 25,000 observations including retained directory entries, 512 MiB of input bytes and 8 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n+  Reads retain at most 40,000 observations including retained directory entries, 512 MiB of input bytes and 16 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n   The global review-closeout check composes an audited selection/catalogue coordinator with independently bounded scope operations. A scope and its recursive children use one closure; workers share only the explicitly bound immutable catalogue. At most 16 scope closures are live, further limited by `POSE_CHECK_WORKERS` or the core count. Scope findings are buffered until their audits and the coordinator audit finish. This proves coherent selection and individually audited results, not a simultaneous snapshot across every completed scope; one exhausted scope cannot consume its sibling's capture budget, and any unresolved loss still fails the global gate.\n - `action <open|list|show|resolve|cancel|waive|invalidate>` (specs `pose-action-requests`, `pose-action-request-resolution`) — material requests to a person or an external system that no other source records: a decision, an approval, an input, an external operation or an acceptance, with its question, options and consequences, recommendation, recipient (principal, role or `unassigned`), qualified targets (`requirement:R4` inside the origin spec, or `xref:…`), per-phase effects (`--effect closeout:block` lets implementation continue) and an optional subject (`--subject requirement:R4` or `path:<file>`) whose change invalidates an answer recorded for the old content. Open one only when a different answer would materially change execution, scope, authority, risk acceptance, closeout or publication and no authorization already given covers it. Each request is an append-only journal under `.pose/actions/`, read whole: a line with a second value, a duplicate field (keys differing only in case included), an unknown event type, another schema, a sequence gap, an empty line or no terminator is never part of a view; `action show|list` and MCP locate it (line, byte offset, length, SHA-256) as an `interrupted-tail`, with a truncation proposal for a person to review, or as `corrupt`, to restore from version control — the engine repairs nothing (spec `pose-journal-checkpoint-and-lock-recovery`); `open` is a preview until `--apply`. Targets are qualified with the current project id; when it is derived from the directory name (no `.pose/project.json`, `POSE_DEFAULT_PROJECT_ID` or `POSE_PROJECT_ROOTS` binding), `open --apply` says so (on stderr with `--json`), because a checkout under another name would record another project, and the obligation snapshot lists the same limitation. A resolution names the `--request-digest` it answers and the `--expected-revision` it read, carries an `--idempotency-key` (a retry is a no-op, the same key with other content is refused, a second answer against the same revision is refused) and comes from an actor holding the recipient role in `.pose/policy/actions.json` (`{\"schema_version\":1,\"roles\":{\"maintainer\":[\"human:<name>\"]},\"identity_assurance\":\"declared|verified\"}`); under `verified` it needs `--claim <file>` with an Ed25519 claim from an issuer pinned in the review policy, bound to project, audience, request digest, principal and answer (a human principal also needs `human_authority_issuers`). Answered is not satisfied: a declined approval, a rejected acceptance or a failed external operation leaves the condition unmet. The requester may cancel its own question; a waiver needs the recipient authority and a reason. Open requests are projected as `actor-action` obligations in `state --attention` and `pose_obligations`; MCP opens requests with `pose_action_open` (risk class `governance-write`, a preview unless `apply` is true) and reads them with `pose_action_requests`; `pose_action_resolve` (spec `pose-mcp-action-resolve-signed-only`, `governance-write`) records an answer only with the principal's proof — a signature by a key registered to it, or a trusted issuer's claim — and refuses a declared answer under any assurance; its preview returns the statement to sign and the `ssh-keygen` command.\n - Action destination scoping (spec `pose-action-target-and-node-scoping`) — origin is provenance, targets select relevance, and effects select restrictions. An empty effect scope still means the whole source artifact; a roadmap or milestone expands its current members. Explicit scopes replace that default, so a request from alpha can restrict beta without blocking alpha. A named whole artifact is a whole restriction, not partial merely because it is qualified. Pending requests remain visible when their origin becomes terminal. Unknown membership or unreadable material is reported as limited coverage and never expands into every spec. CLI accepts `--effect-json '{\"phase\":\"start\",\"mode\":\"block\",\"scope\":[\"xref:project/spec:beta\"]}'`; MCP `effects` accepts the same object alongside legacy `\"start:block\"` strings. Targets and subjects resolve by project/artifact/kind/ID, and a subject is re-read in its recorded artifact. Under adopted agency readiness, new approvals and acceptances require an explicit `--subject` / `subject`; legacy unbound requests retain their journal and report that answers have no content-change detection. Policy-off creation and transition defaults remain unchanged. This compatibility tightening requires release review; no policy adoption happens here.\ndiff --git a/locales/pt-BR/POSE.md b/locales/pt-BR/POSE.md\nindex 244d4d76..46aaafbf 100644\n--- a/locales/pt-BR/POSE.md\n+++ b/locales/pt-BR/POSE.md\n@@ -378,7 +378,7 @@ pose release-notes --version vX.Y.Z # alias de compatibilidade para as notes imu\n - `state --governance [--scope <ref>] [--json]` (spec `pose-effective-governance-projection`) — projeção ao vivo, somente leitura, da governança em vigor aqui: para cada contrato do registry, capability opcional (atomic start, contract nodes, causality closeout, referências qualificadas, transferência de spec, reuso de critério, attestations assinadas, identidade verificada) e gate (Definition of Ready, integridade de entrega), se está `supported`, `configured`, `applicable` e `effective`, com códigos de motivo como `not-adopted`, `no-readiness-cutoff`, `legacy-cutoff:<data>` ou `identity-assurance-declared`. `--scope` compara o bundle selado mais recente do escopo — os contratos que ele carimbou — com o que a policy sela hoje. Lê as mesmas funções que os gates chamam e não escreve nada. `pose_project_state` traz a mesma projeção em `effective_governance` (parâmetro opcional `governance_scope`).\n - `state --attention` (specs `pose-obligation-projection`, `pose-state-attention`) — resposta ao vivo, somente leitura, a \"o que ainda é devido, por quem, restringindo qual fase?\". As obrigações são projetadas dos subsistemas que as possuem — readiness (`depends_on` não satisfeito, Definition of Ready, `blocked` sem causa), closeout e review de specs em andamento (review não aprovada, cada critério de julgamento que um bundle selado ainda deve, bloqueios em texto como `legacy-opaque`), reconciliação de start quando o atomic start está adotado, e follow-ups abertos como dívida residual consultiva — nunca armazenadas uma segunda vez. Fontes do projeto também são projetadas (spec `pose-attention-projects-every-source`), com origem em `xref:<projeto>/project:<projeto>`: uma marca de revisão de doc aberta (devida pelo dono do doc até `pose docs-review resolve`), um mecanismo de capability com gatilho de obsolescência, uma release mais nova que a última verificada e ainda não verificada, e um finding accepted-risk ou follow-up com data de revisão vencida no registro de review legado mais recente. Notas de investigação em texto livre não têm estado e não são fonte. A renderização mostra a cobertura primeiro: um produtor que falhou, ou action requests até a adoção, torna a resposta `INCOMPLETE`, para que um grupo vazio nunca seja lido como nada devido, e uma instalação nova, depois de commitada, lê `complete`. Depois o que precisa de `--actor` (ou de qualquer pessoa ou papel), depois o que restringe cada fase (`start`, `execution`, `review`, `closeout`, `release`), depois a dívida residual. `--json` retorna o relatório — ids `obl-` estáveis, refs qualificadas, códigos de motivo, condições, destinatários, efeitos, satisfação, conhecimento, espera, um snapshot com digests de revisão/árvore suja/policy/contrato/índice, cobertura por produtor — mais o agrupamento `attention`. MCP: `pose_obligations` retorna os mesmos ids pela mesma função. Attention não é gate.\n - Read views de governança (spec `pose-governance-read-view-generation`) — consulte `snapshot.read_view` em `state --attention --json` e `pose_obligations`: seu próprio `schema_version: 1`, ID dos inputs observados, versões de engine/parser e bindings de roots descrevem uma operação. O relatório externo permanece em schema version 1. O JSON de review e closeout expõe o mesmo contrato em `read_view`. O ID vincula bytes consumidos, observações de diretório, erros e ausências; revisão, dirty, tamanho e mtime isolados não provam equivalência. `current` descreve somente o instante da auditoria final. Coerência, cobertura por produtor e frescor são dimensões distintas: `unknown` ou cobertura incompleta nunca significam nada devido nem autorização de escrita. Um relatório histórico sem esse binding continua legível e não prova autorização atual.\n-  A leitura retém no máximo 25.000 observações incluindo entradas de diretório retidas, 512 MiB de inputs e 8 MiB de metadados. Ao detectar interleaving, descarta a tentativa e repete a leitura inteira uma vez; outra mudança deixa a cobertura afetada incompleta e o frescor `unknown`. Leitores não suportados e inputs federados sem binding permanecem desconhecidos. Escritores participantes adquirem guards das roots autorizadas antes da reavaliação e os mantêm até a publicação; CAS do destino e verificações do descriptor de índices continuam válidos. Escritores fora desse protocolo, incluindo uma alteração externa restaurada antes da auditoria, ficam fora dessa garantia de exclusão. Nenhum watcher, daemon ou cache entre operações é introduzido.\n+  A leitura retém no máximo 40.000 observações incluindo entradas de diretório retidas, 512 MiB de inputs e 16 MiB de metadados. Ao detectar interleaving, descarta a tentativa e repete a leitura inteira uma vez; outra mudança deixa a cobertura afetada incompleta e o frescor `unknown`. Leitores não suportados e inputs federados sem binding permanecem desconhecidos. Escritores participantes adquirem guards das roots autorizadas antes da reavaliação e os mantêm até a publicação; CAS do destino e verificações do descriptor de índices continuam válidos. Escritores fora desse protocolo, incluindo uma alteração externa restaurada antes da auditoria, ficam fora dessa garantia de exclusão. Nenhum watcher, daemon ou cache entre operações é introduzido.\n   O check global de review/closeout compõe um coordenador auditado de seleção/catálogo com operações limitadas por escopo. Um escopo e seus filhos recursivos usam uma closure; os workers compartilham somente o catálogo imutável com binding explícito. Até 16 closures de escopo ficam ativas, ainda limitadas por `POSE_CHECK_WORKERS` ou pelos cores. Findings são retidos até terminarem as auditorias dos escopos e do coordenador. Isso prova seleção coerente e resultados auditados individualmente, sem alegar snapshot simultâneo de todos os escopos concluídos; um escopo esgotado não consome o orçamento de captura do irmão e qualquer perda não resolvida ainda reprova o gate global.\n - `action <open|list|show|resolve|cancel|waive|invalidate>` (specs `pose-action-requests`, `pose-action-request-resolution`) — solicitações materiais a uma pessoa ou a um sistema externo que nenhuma outra fonte registra: decisão, aprovação, informação, operação externa ou aceite, com pergunta, opções e consequências, recomendação, destinatário (principal, papel ou `unassigned`), alvos qualificados (`requirement:R4` dentro da spec de origem, ou `xref:…`), efeitos por fase (`--effect closeout:block` deixa a implementação seguir) e um assunto opcional (`--subject requirement:R4` ou `path:<arquivo>`) cuja mudança invalida a resposta registrada para o conteúdo antigo. Abra uma somente quando uma resposta diferente mudaria materialmente execução, escopo, autoridade, aceitação de risco, closeout ou publicação e nenhuma autorização já dada a cobre. Cada solicitação é um journal append-only em `.pose/actions/`, lido por inteiro: uma linha com um segundo valor, campo duplicado (inclusive chaves que diferem só na caixa), tipo de evento desconhecido, outro schema, salto de sequência, linha vazia ou sem terminador nunca entra numa view; `action show|list` e o MCP a localizam (linha, offset em bytes, tamanho, SHA-256) como `interrupted-tail`, com uma proposta de truncamento para uma pessoa revisar, ou como `corrupt`, a restaurar do controle de versão — o motor não repara nada (spec `pose-journal-checkpoint-and-lock-recovery`); `open` é preview até `--apply`. Os alvos são qualificados com o project id atual; quando ele é derivado do nome do diretório (sem `.pose/project.json`, `POSE_DEFAULT_PROJECT_ID` ou vínculo em `POSE_PROJECT_ROOTS`), `open --apply` avisa (no stderr com `--json`), porque um checkout com outro nome registraria outro projeto, e o snapshot das obrigações lista a mesma limitação. Uma resolução nomeia o `--request-digest` que responde e a `--expected-revision` que leu, traz uma `--idempotency-key` (retry não grava de novo, a mesma chave com outro conteúdo é recusada, uma segunda resposta contra a mesma revisão é recusada) e vem de um ator que detém o papel destinatário em `.pose/policy/actions.json` (`{\"schema_version\":1,\"roles\":{\"maintainer\":[\"human:<nome>\"]},\"identity_assurance\":\"declared|verified\"}`); em `verified` exige `--claim <arquivo>` com uma claim Ed25519 de um emissor fixado na policy de review, vinculada a projeto, audience, digest da solicitação, principal e resposta (um principal humano também exige `human_authority_issuers`). Respondida não é satisfeita: aprovação recusada, aceite rejeitado ou operação externa falha deixam a condição sem atendimento. O solicitante pode cancelar a própria pergunta; uma dispensa exige a autoridade destinatária e um motivo. Solicitações abertas são projetadas como obrigações `actor-action` em `state --attention` e `pose_obligations`; o MCP abre solicitações com `pose_action_open` (classe de risco `governance-write`, preview a menos que `apply` seja true) e as lê com `pose_action_requests`; `pose_action_resolve` (spec `pose-mcp-action-resolve-signed-only`, `governance-write`) registra uma resposta só com a prova do principal — assinatura de uma chave registrada para ele, ou a claim de um emissor confiável — e recusa resposta declarada sob qualquer garantia; o preview devolve a declaração a assinar e o comando `ssh-keygen`.\n - Escopo de destino de ações (spec `pose-action-target-and-node-scoping`) — origin registra proveniência, targets selecionam relevância e effects selecionam restrições. Scope vazio mantém o artifact de origem inteiro; roadmap ou milestone expande seus membros atuais. Scopes explícitos substituem esse padrão: uma request de alpha pode restringir beta sem bloquear alpha. Artifact inteiro nomeado é restrição inteira; qualificação não o torna parcial. Requests pendentes permanecem visíveis após a origem ficar terminal. Membership desconhecido ou material ilegível declara cobertura limitada e nunca expande para todas as specs. CLI aceita `--effect-json '{\"phase\":\"start\",\"mode\":\"block\",\"scope\":[\"xref:project/spec:beta\"]}'`; MCP `effects` aceita esse objeto junto de strings legadas `\"start:block\"`. Targets e subjects resolvem o tuple projeto/artifact/kind/ID; subject é relido no artifact registrado. Sob agency readiness adotado, novas aprovações e aceitações exigem `--subject` / `subject` explícito; journals legados sem binding permanecem intactos e declaram que a resposta não detecta mudança de conteúdo. Criação e transições com policy off preservam os padrões existentes. Revisar compatibilidade na release; esta implementação não adota policy.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'Basis:|\\\"basis\\\"' pose-mcp/internal/pose/review_structure_test.go | head -20; sed -n '255,322p' pose-mcp/internal/pose/review_structure.go; rg -n 'evidence_classes|\\\"id\\\"|preconditions' .pose/review-profiles/spec-closeout.json | head -70; git status --porcelain\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'Basis:|\\\"basis\\\"' pose-mcp/internal/pose/review_structure_test.go | head -20; sed -n '255,322p' pose-mcp/internal/pose/review_structure.go; rg -n 'evidence_classes|\\\"id\\\"|preconditions' .pose/review-profiles/spec-closeout.json | head -70; git status --porcelain\"","aggregated_output":"192:- Basis: R1, A1\n200:- Basis: A9\n243:\tblockers := causalityBlockers(t, store, []ReviewCriterionMapping{{Delta: \"SD-aaaa1111\", Basis: \"D1\"}}, \"\")\n246:\t\t{Delta: \"SD-aaaa1111\", Basis: \"D1\"},\n247:\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n259:\t\t{Delta: \"SD-aaaa1111\", Basis: \"D1\"}, {Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n260:\t\t{Delta: \"SD-cccc3333\", Basis: \"R1\"},\n263:\t\t{Delta: \"SD-aaaa1111\", Basis: \"D1\"}, {Delta: \"SD-aaaa1111\", Basis: \"R1\"},\n264:\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n284:\t\t\tmapping := ReviewCriterionMapping{Delta: \"SD-aaaa1111\", Basis: tc.basis}\n289:\t\t\t\tmapping, {Delta: \"SD-bbbb2222\", Basis: \"C1\"},\n296:\t\t\t{Delta: \"SD-aaaa1111\", Basis: basis}, {Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n312:\t\t\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n318:\t\t\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n321:\t\t\t\t{Delta: \"SD-aaaa1111\", Disposition: state, Rationale: \"stated reason\", Basis: \"R1\"},\n322:\t\t\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n328:\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n\tnamespace := s.reviewDesignBasisNamespace(scope)\n\tblockers := []string{}\n\tfor _, id := range owners {\n\t\tdisposition := ReviewCriterion{}\n\t\tfound := false\n\t\tfor _, candidate := range dispositions {\n\t\t\tif candidate.ID == id {\n\t\t\t\tdisposition, found = candidate, true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\tcontinue // the missing-criterion blocker is already raised upstream\n\t\t}\n\t\tswitch disposition.Disposition {\n\t\tcase \"not-applicable\":\n\t\t\t// The scope moved dependencies, contracts or governance, and the\n\t\t\t// criterion that answers for exactly that says nothing applies.\n\t\t\tblockers = append(blockers, \"criterion \"+id+\" is not-applicable while the bundle seals \"+\n\t\t\t\tpluralizeStructuralFacts(len(structure.Material))+\" (\"+strings.Join(structure.Kinds, \", \")+\n\t\t\t\t\"); an observed structural change is not inapplicable, it is unmapped\")\n\t\t\tcontinue\n\t\tcase \"passed\":\n\t\tdefault:\n\t\t\tcontinue // finding and invalid dispositions are handled upstream\n\t\t}\n\t\tcovered := map[string]bool{}\n\t\tfor _, mapping := range disposition.Mappings {\n\t\t\tfact, known := facts[mapping.Delta]\n\t\t\tif !known {\n\t\t\t\tblockers = append(blockers, \"criterion \"+id+\" maps \"+describeMappingDelta(mapping.Delta)+\", which this subject does not observe as material\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif covered[mapping.Delta] {\n\t\t\t\tblockers = append(blockers, \"criterion \"+id+\" maps \"+mapping.Delta+\" twice\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tcovered[mapping.Delta] = true\n\t\t\tstate := mapping.Disposition\n\t\t\tif state == \"\" && strings.TrimSpace(mapping.Basis) != \"\" {\n\t\t\t\tstate = ReviewMappingMapped\n\t\t\t}\n\t\t\tswitch state {\n\t\t\tcase ReviewMappingMapped:\n\t\t\t\tbasis := strings.TrimSpace(mapping.Basis)\n\t\t\t\tswitch {\n\t\t\t\tcase basis == \"\":\n\t\t\t\t\tblockers = append(blockers, \"criterion \"+id+\" maps \"+mapping.Delta+\" as mapped and names no basis\")\n\t\t\t\tcase !designIDRE.MatchString(basis):\n\t\t\t\t\tblockers = append(blockers, \"criterion \"+id+\" maps \"+mapping.Delta+\" to \"+basis+\", which is not a decision-basis ref\")\n\t\t\t\tcase !namespace.Known[basis]:\n\t\t\t\t\tblockers = append(blockers, \"criterion \"+id+\" maps \"+mapping.Delta+\" to \"+basis+\", which this scope's decision basis does not declare\")\n\t\t\t\tcase !namespace.Reaches[basis]:\n\t\t\t\t\tblockers = append(blockers, \"criterion \"+id+\" maps \"+mapping.Delta+\" to \"+basis+\", which reaches no requirement or constraint; a decision without the requirement that pays for it does not justify \"+fact.Kind+\" \"+fact.Subject)\n\t\t\t\t}\n\t\t\tcase ReviewMappingMissingEvidence, ReviewMappingNotApplicable, ReviewMappingAcceptedRisk:\n\t\t\t\tif strings.TrimSpace(mapping.Rationale) == \"\" {\n\t\t\t\t\tblockers = append(blockers, \"criterion \"+id+\" disposes \"+mapping.Delta+\" as \"+state+\" with no rationale\")\n\t\t\t\t}\n\t\t\t\tif strings.TrimSpace(mapping.Basis) != \"\" {\n\t\t\t\t\tblockers = append(blockers, \"criterion \"+id+\" disposes \"+mapping.Delta+\" as \"+state+\" and still names basis \"+mapping.Basis+\"; state one or the other\")\n\t\t\t\t}\n\t\t\tdefault:\n\t\t\t\tblockers = append(blockers, \"criterion \"+id+\" disposes \"+mapping.Delta+\" as \"+describeMappingDelta(state)+\", which is not mapped, missing-evidence, not-applicable or accepted-risk\")\n\t\t\t}\n\t\t}\n\t\tfor _, fact := range structure.Material {\n\t\t\tif !covered[fact.ID] {\n3:  \"id\": \"spec-closeout\",\n7:    {\"id\": \"scope\", \"description\": \"The implementation matches the approved spec scope.\", \"rules\": [\"documentation-style\"]},\n8:    {\"id\": \"requirements\", \"description\": \"Every requirement has current, relevant evidence.\", \"evidence_classes\": [\"unit\", \"integration\", \"e2e\"]},\n9:    {\"id\": \"correctness\", \"description\": \"Functional and negative behavior is correct.\", \"evidence_classes\": [\"build\", \"unit\", \"integration\", \"e2e\"]},\n10:    {\"id\": \"security\", \"description\": \"Inputs, paths, evidence and authority boundaries are safe.\", \"rules\": [\"security\"]},\n11:    {\"id\": \"compatibility\", \"description\": \"Public CLI, file and MCP contracts are compatible or explicitly migrated.\"},\n12:    {\"id\": \"operability\", \"description\": \"Errors, explanations and remediation are actionable.\"},\n13:    {\"id\": \"documentation\", \"description\": \"Operational docs, templates and scaffold match runtime behavior.\", \"rules\": [\"documentation-style\"]}\n16:    {\"id\": \"artifact-check\", \"requiredness\": \"required\", \"criteria\": [\"scope\", \"requirements\"], \"preconditions\": [\"artifacts-attributed\"]},\n17:    {\"id\": \"assess-tech-debt\", \"requiredness\": \"recommended\", \"criteria\": [\"correctness\"]},\n18:    {\"id\": \"validate\", \"requiredness\": \"required\", \"evidence_classes\": [\"build\", \"unit\", \"integration\", \"e2e\"], \"criteria\": [\"requirements\", \"correctness\"], \"preconditions\": [\"delivery-target-declared\"]}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"agent_message","text":"**Decision: approved.** No substantive defects found.\n\nReviewed the sealed range against R1–R10, the ADR, and the applicable Go, security, and documentation rules. The material digest addresses administrative commit churn while preserving legacy provenance and rejecting mismatched bindings. The ADR’s checkout limitations remain accepted risks; an immutable execution snapshot would be needed to remove them.\n\nThe surface check passed with 189 results and no findings. Artifact reconciliation reported orphan warnings. Review and closeout remain pending approval and lifecycle completion. Targeted Go tests could not start because the sandbox denied Go’s temporary build directory; execution judgments therefore use the sealed evidence. The repository remains unchanged.\n\nStructural fact **SD-2e801d1d** maps to **R1** and the compatibility requirement for an ADR documenting the additive evidence-binding contract.\n\n```pose-draft\n{\n  \"schema\": \"pose.review.draft/v1\",\n  \"decision\": \"approved\",\n  \"findings\": [],\n  \"criteria\": [\n    {\n      \"id\": \"assumption-integrity\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"structure:design-1ac47735cb490977\",\n      \"rationale\": \"The ADR states the material-boundary assumptions and accepted limits: ignored files, copied or uncommitted moved data records, concurrent restoration, sparse checkouts, and unavailable graph collection. Tests support the ordinary checkout contract; immutable-snapshot guarantees remain unresolved and explicitly deferred.\",\n      \"mappings\": [\n        {\n          \"delta\": \"SD-2e801d1d\",\n          \"basis\": \"R1\",\n          \"disposition\": \"mapped\",\n          \"rationale\": \"The ADR defines the new material-binding contract and its assumptions.\"\n        }\n      ]\n    },\n    {\n      \"id\": \"backend-concurrency\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/validate-concurrent-steps-integration\",\n      \"rationale\": \"Existing cancellation and check scheduling remain intact. The shallow-cache state is mutex protected, and cached graph copies isolate material inputs and provenance maps.\"\n    },\n    {\n      \"id\": \"backend-contracts\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/delivery-integrity-index-compaction-integration\",\n      \"rationale\": \"Material fields propagate through result parsing and compact indexes. Legacy commit-bound digests explicitly exclude the new fields.\"\n    },\n    {\n      \"id\": \"backend-input-errors\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"unit:pose-mcp/go/test\",\n      \"rationale\": \"Unreadable and shallow material becomes unavailable rather than falling through. Git output is bounded, paths use literal pathspecs, and working-copy read failures refuse binding.\"\n    },\n    {\n      \"id\": \"backend-integration-impact\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/cli-mcp-operation-results-integration\",\n      \"rationale\": \"CLI and MCP use the domain evidence model; the shipped CLI entrypoint registers current-tree recomputation before serving MCP.\"\n    },\n    {\n      \"id\": \"backend-observability\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/typed-diagnostics-integration\",\n      \"rationale\": \"Stale evidence identifies the scope and provides rerun remediation. Naming the first differing path is explicitly deferred because no manifest is stored.\"\n    },\n    {\n      \"id\": \"compatibility\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"unit:pose-mcp/go/test\",\n      \"rationale\": \"The result fields are additive. Results lacking material provenance retain the legacy verdict, and completed-spec exemptions remain unchanged.\"\n    },\n    {\n      \"id\": \"correctness\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"unit:pose-mcp/go/test\",\n      \"rationale\": \"Reviewed tests cover administrative head movement, changed material and matrix, symlinks, rename destinations, explicit ranges, shallow checkouts, working-copy guards, legacy digests, and cache isolation.\"\n    },\n    {\n      \"id\": \"design-causality\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"structure:design-1ac47735cb490977\",\n      \"rationale\": \"Hashing head-tree entries removes commit-identity churn from validation currency. Claims, matrix, and engine remain bound; current-tree recomputation prevents a persisted index from vouching for changed observed material.\",\n      \"mappings\": [\n        {\n          \"delta\": \"SD-2e801d1d\",\n          \"basis\": \"R1\",\n          \"disposition\": \"mapped\",\n          \"rationale\": \"The added ADR records the material digest design, compatibility behavior, alternatives, and accepted limitations.\"\n        }\n      ]\n    },\n    {\n      \"id\": \"documentation\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/distributed-instructions-parity-integration\",\n      \"rationale\": \"Runtime read-view limits match the English, Portuguese, and scaffold documentation. The spec and ADR describe the administrative classes and residual limits.\"\n    },\n    {\n      \"id\": \"operability\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/delivery-integration\",\n      \"rationale\": \"Unavailable material refuses reuse and existing stale-evidence diagnostics provide actionable scope-level remediation. Sealed checkout diagnostics suppress index publication only for the marked root.\"\n    },\n    {\n      \"id\": \"requirements\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"unit:pose-mcp/go/test\",\n      \"rationale\": \"R1-R10 have relevant implementation and test coverage in the sealed unit run; delivery composition is additionally supported by the successful surface check and sealed delivery integration evidence.\"\n    },\n    {\n      \"id\": \"scope\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"structure:design-1ac47735cb490977\",\n      \"rationale\": \"Changes implement the declared material binding, sealed-checkout refresh guard, and R10 capacity adjustment without introducing per-check caching or configurable exemptions.\"\n    },\n    {\n      \"id\": \"security\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"unit:pose-mcp/go/test\",\n      \"rationale\": \"Administrative classification is engine owned and restricted by path, extension, and file mode. Matrix changes, code in administrative directories, and recorded rename destinations remain material. The cheapest stale-index bypass is addressed by current-tree recomputation tests; these cases are not separately catalogued in the adversarial README.\"\n    },\n    {\n      \"id\": \"solution-proportionality\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"structure:design-1ac47735cb490977\",\n      \"rationale\": \"A scoped material digest is sufficient for administrative commit reuse and smaller than per-check caching or immutable execution snapshots. Stored recomputation inputs are necessary to reject stale indexes. The design must be revisited if guarantees extend to ignored files, sparse checkouts, or concurrent writers.\"\n    }\n  ],\n  \"tools\": [\n    {\n      \"id\": \"artifact-check\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/artifact-claim-boundary-integration\",\n      \"rationale\": \"Ran pose artifact-check --spec pose-validation-evidence-material-binding --strict. Reconciliation reported 30 claims, 37 observations, and orphan warnings; no changed-scope attribution defect was identified.\"\n    },\n    {\n      \"id\": \"assess-design\",\n      \"disposition\": \"not-used\",\n      \"evidence\": \"structure:design-1ac47735cb490977\",\n      \"rationale\": \"Reviewed the sealed structural evidence and independently inspected the ADR and implementation instead of regenerating the assessment.\"\n    },\n    {\n      \"id\": \"assess-discover\",\n      \"component\": \"pose-mcp\",\n      \"disposition\": \"not-used\",\n      \"rationale\": \"Discovery publishes repository assessment records and was excluded by the no-change boundary.\"\n    },\n    {\n      \"id\": \"assess-integrate\",\n      \"disposition\": \"not-used\",\n      \"rationale\": \"The command writes integration assessment records. Reviewed producer, parser, compaction, cache, CLI, and MCP boundaries directly and used sealed integration evidence.\"\n    },\n    {\n      \"id\": \"assess-tech-debt\",\n      \"disposition\": \"not-used\",\n      \"rationale\": \"The command writes assessment records. Inspected the changed implementation for debt markers and reviewed the spec's explicit follow-ups.\"\n    },\n    {\n      \"id\": \"closeout-check\",\n      \"disposition\": \"deferred\",\n      \"rationale\": \"Executed the diagnostic: lifecycle_done=false and review_approved=false. Final closeout verification follows recording this review and completing the lifecycle; no attestation was recorded during review.\"\n    },\n    {\n      \"id\": \"review-check\",\n      \"disposition\": \"deferred\",\n      \"rationale\": \"Executed the diagnostic: review.approved=false with no recorded approval. Final verification follows the engine's recording of this review.\"\n    },\n    {\n      \"id\": \"suggest-review\",\n      \"component\": \"pose-mcp\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/distributed-instructions-parity-integration\",\n      \"rationale\": \"Ran pose suggest review --path pose-mcp and applied its backend-go, security, and documentation-style rules.\"\n    },\n    {\n      \"id\": \"surface-check\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/delivery-integration\",\n      \"rationale\": \"Ran pose surface-check --spec pose-validation-evidence-material-binding --strict: exit 0, one target, 189 results, zero findings. Reachability evidence: reachability:pose-mcp/go/delivery-reachability.\"\n    },\n    {\n      \"id\": \"validate\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"unit:pose-mcp/go/test\",\n      \"rationale\": \"Used the sealed passing strict-matrix evidence, including build:pose-mcp/go/build, integration:pose-mcp/go/delivery-integration, and e2e:pose-mcp/go/multi-repo-agent-installed-journey. Did not rerun the repository-writing command; targeted Go execution was blocked by the read-only temporary build directory.\"\n    },\n    {\n      \"id\": \"validate\",\n      \"component\": \"pose-mcp\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"unit:pose-mcp/go/test\",\n      \"rationale\": \"Used sealed module evidence, including build:pose-mcp/go/build, integration:pose-mcp/go/delivery-integration, and e2e:pose-mcp/go/multi-repo-agent-installed-journey. Independently inspected the new material-binding tests; local execution could not start in the read-only sandbox.\"\n    }\n  ]\n}\n```"}}
