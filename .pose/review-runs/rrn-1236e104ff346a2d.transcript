{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '570,600p'; nl -ba pose-mcp/internal/pose/review_plan.go | sed -n '540,580p'\"","aggregated_output":"   570\t\t}\n   571\t\tif strings.TrimSpace(draft.Sweep) == \"\" {\n   572\t\t\tproblems = append(problems, \"the draft does not state what it swept\")\n   573\t\t}\n   574\t\treturn problems\n   575\t}\n   576\t\n   577\t// quoteLedgerText renders text an earlier reviewer wrote as one quoted line:\n   578\t// whitespace collapsed, backticks neutralized, so it can open no section and\n   579\t// carry no instruction of its own (review round 1, B4).\n   580\tfunc quoteLedgerText(text string) string {\n   581\t\treturn strings.ReplaceAll(strings.Join(strings.Fields(text), \" \"), \"`\", \"'\")\n   582\t}\n   583\t\n   584\t// renderPriorRound is the brief's section of round 2 and later, built only\n   585\t// from the ledger, byte-stable for the same ledger state (R2, R3).\n   586\tfunc renderPriorRound(round ReviewRound) string {\n   587\t\tvar b strings.Builder\n   588\t\tline := func(format string, a ...any) { fmt.Fprintf(&b, format+\"\\n\", a...) }\n   589\t\tline(\"## Previous round\")\n   590\t\tline(\"\")\n   591\t\tline(\"This is round %d of the scope.\", round.Number)\n   592\t\tif round.Prior != nil {\n   593\t\t\thead := \"\"\n   594\t\t\tif round.PriorBundle != nil {\n   595\t\t\t\thead = round.PriorBundle.Payload.Subject.Head\n   596\t\t\t}\n   597\t\t\tline(\"The previous round is run %s on bundle %s (commit %s); its draft digest is %s.\", round.Prior.RunID, round.Prior.BundleID, orNone(head), digestBytes([]byte(round.Prior.Output)))\n   598\t\t}\n   599\t\tif round.Broken != \"\" {\n   600\t\t\tline(\"Some drafts of earlier rounds could not be read; the findings open before them stay open: %s.\", quoteLedgerText(round.Broken))\n   540\t\t\tcase \"language\":\n   541\t\t\t\tcomponent.Language = \"\"\n   542\t\t\tcase \"owner\":\n   543\t\t\t\tcomponent.Owner = \"\"\n   544\t\t\tcase \"domain\":\n   545\t\t\t\tcomponent.Domain = \"\"\n   546\t\t\tcase \"criticality\":\n   547\t\t\t\tcomponent.Criticality = \"\"\n   548\t\t\tcase \"validationprofile\", \"validation_profile\":\n   549\t\t\t\tcomponent.ValidationProfile = \"\"\n   550\t\t\t}\n   551\t\t}\n   552\t}\n   553\t\n   554\tfunc (s Store) reviewScopeSpecs(scope ScopeRef) ([]Spec, error) {\n   555\t\tslugs := []string{}\n   556\t\tswitch scope.Kind {\n   557\t\tcase \"spec\":\n   558\t\t\tslugs = append(slugs, scope.Slug)\n   559\t\tcase \"milestone\":\n   560\t\t\trm, err := s.GetRoadmap(scope.Roadmap)\n   561\t\t\tif err != nil {\n   562\t\t\t\treturn nil, err\n   563\t\t\t}\n   564\t\t\tfound := false\n   565\t\t\tfor _, milestone := range rm.Milestones {\n   566\t\t\t\tif milestone.ID == scope.Milestone {\n   567\t\t\t\t\tslugs, found = append(slugs, milestone.Specs...), true\n   568\t\t\t\t}\n   569\t\t\t}\n   570\t\t\tif !found {\n   571\t\t\t\treturn nil, fmt.Errorf(\"pose: milestone %s/%s not found\", scope.Roadmap, scope.Milestone)\n   572\t\t\t}\n   573\t\tcase \"roadmap\":\n   574\t\t\trm, err := s.GetRoadmap(scope.Slug)\n   575\t\t\tif err != nil {\n   576\t\t\t\treturn nil, err\n   577\t\t\t}\n   578\t\t\tfor _, milestone := range rm.Milestones {\n   579\t\t\t\tslugs = append(slugs, milestone.Specs...)\n   580\t\t\t}\n","exit_code":0,"status":"completed"}}
