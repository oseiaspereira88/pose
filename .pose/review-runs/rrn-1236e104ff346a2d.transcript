{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc 'git diff --unified=12 3f63a1bb432801957ddb35354961f1825658531a..299cd81b460bac40093ba6ca4111598de0e2d039 -- pose-mcp/internal/pose/review_closeout.go pose-mcp/internal/pose/review_brief_conclusion_rules_test.go pose-mcp/internal/pose/review_brief_versions_test.go pose-mcp/internal/pose/review_brief_test.go pose-mcp/internal/pose/review_bundle.go pose-mcp/internal/pose/review_rounds.go'","aggregated_output":"diff --git a/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go b/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\nindex 364b8181..0041304e 100644\n--- a/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\n+++ b/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\n@@ -49,35 +49,35 @@ func TestTheBriefStatesEveryRuleThePreflightEnforces(t *testing.T) {\n // R3: a run briefed with review-brief/3 still renders as it did, without the rules, so its\n // digest still verifies; the current template is /6.\n func TestAnEarlierConclusionBriefStillRendersWithoutTheRules(t *testing.T) {\n \tstore, bundle := briefFixture(t)\n \tcurrent, err := store.RenderReviewBrief(bundle.BundleID, \"\", \"\")\n \tif err != nil {\n \t\tt.Fatal(err)\n \t}\n \tearlier, err := store.renderReviewBriefAs(bundle.BundleID, ReviewBriefKindReview, \"\", reviewBriefTemplateTypedConclusion)\n \tif err != nil {\n \t\tt.Fatal(err)\n \t}\n-\tif current.TemplateVersion != \"review-brief/7\" || earlier.TemplateVersion != \"review-brief/3\" {\n+\tif current.TemplateVersion != \"review-brief/11\" || earlier.TemplateVersion != \"review-brief/3\" {\n \t\tt.Fatalf(\"templates: %s %s\", current.TemplateVersion, earlier.TemplateVersion)\n \t}\n \tif strings.Contains(earlier.Text, \"POSE checks the conclusion before it records it\") {\n \t\tt.Fatal(\"review-brief/3 changed under the runs briefed with it\")\n \t}\n \tif !strings.Contains(earlier.Text, \"the conclusion POSE records as the attestation\") || earlier.Digest == current.Digest {\n \t\tt.Fatal(\"review-brief/3 no longer asks for the conclusion, or has the digest of /4\")\n \t}\n-\tif !reviewBriefAsksConclusion(\"review-brief/3\") || !reviewBriefAsksConclusion(\"review-brief/4\") || !reviewBriefAsksConclusion(\"review-brief/5\") || !reviewBriefAsksConclusion(\"review-brief/6\") || !reviewBriefAsksConclusion(\"review-brief/7\") || reviewBriefAsksConclusion(\"review-brief/2\") {\n-\t\tt.Fatal(\"the templates that ask for a conclusion are /3 to /7\")\n+\tif !reviewBriefAsksConclusion(\"review-brief/3\") || !reviewBriefAsksConclusion(\"review-brief/4\") || !reviewBriefAsksConclusion(\"review-brief/5\") || !reviewBriefAsksConclusion(\"review-brief/6\") || !reviewBriefAsksConclusion(\"review-brief/7\") || !reviewBriefAsksConclusion(\"review-brief/8\") || !reviewBriefAsksConclusion(\"review-brief/9\") || !reviewBriefAsksConclusion(\"review-brief/10\") || !reviewBriefAsksConclusion(\"review-brief/11\") || reviewBriefAsksConclusion(\"review-brief/2\") {\n+\t\tt.Fatal(\"the templates that ask for a conclusion are /3 to /11\")\n \t}\n }\n \n // R4: the Claude reviewer profile allows read-only commands in the three commands it is\n // launched with, and nothing that writes.\n func TestTheClaudeReviewerProfileAllowsOnlyReadOnlyCommands(t *testing.T) {\n \traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"..\", \".pose\", \"policy\", \"delegation.json\"))\n \tif err != nil {\n \t\tt.Skipf(\"no delegation policy at the repository root: %v\", err)\n \t}\n \tvar policy struct {\n \t\tAgents map[string]struct {\n@@ -129,12 +129,68 @@ func TestTheClaudeReviewerProfileAllowsOnlyReadOnlyCommands(t *testing.T) {\n func TestTheBriefOfALaterRoundStatesTheIdentifiersOfPriorFindings(t *testing.T) {\n \ttext := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 2}, true, nil)\n \tfor _, phrase := range []string{\"the identifier listed under Findings to account for, which carries its round, for example R2-F1, never a bare F1\", \"a finding you report now takes an `id` that no earlier round used\"} {\n \t\tif !strings.Contains(text, phrase) {\n \t\t\tt.Errorf(\"the brief of round 2 does not state the rule behind \\\"prior finding id is not a unique carried identifier\\\": %q\", phrase)\n \t\t}\n \t}\n \tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateConclusions, \"\", nil, &ReviewRound{Number: 2}, true, nil)\n \tif strings.Contains(earlier, \"never a bare F1\") {\n \t\tt.Error(\"review-brief/4 changed under its version: the rule belongs to review-brief/5 and later\")\n \t}\n }\n+\n+// Spec pose-review-readiness-before-seal R4: the current brief asks the\n+// reviewer to check its draft before finishing; /7 never did.\n+func TestTheCurrentBriefAsksForTheDraftCheck(t *testing.T) {\n+\tconst step = \"pipe it to `\\\"$POSE_REVIEW_CLI\\\" review draft-check --draft -`\"\n+\tcurrent := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, step) {\n+\t\tt.Fatal(\"the current review brief does not ask for the draft check\")\n+\t}\n+\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateAllNotApplicable, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, step) {\n+\t\tt.Fatal(\"review-brief/7 changed under the runs briefed with it\")\n+\t}\n+}\n+\n+// Spec pose-assess-leaves-sealed-checkouts-alone R5: the current brief has\n+// the planned `pose` commands run by the dispatching engine; /8 never did.\n+func TestTheCurrentBriefRunsPlannedToolsWithTheDispatchingEngine(t *testing.T) {\n+\tconst step = \"Run each `pose` command below as `\\\"$POSE_REVIEW_CLI\\\"`\"\n+\tcurrent := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, step) || !strings.Contains(current, \"pipe it to `\\\"$POSE_REVIEW_CLI\\\" review draft-check --draft -`\") {\n+\t\tt.Fatal(\"the current review brief does not run planned tools and the draft check with the dispatching engine\")\n+\t}\n+\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateDraftCheck, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, step) {\n+\t\tt.Fatal(\"review-brief/8 changed under the runs briefed with it\")\n+\t}\n+}\n+\n+// Spec pose-review-run-reaps-lingering-reviewer-processes R3: the current\n+// brief asks the reviewer to let its commands finish; /9 never did.\n+func TestTheCurrentBriefAsksCommandsToFinish(t *testing.T) {\n+\tconst boundary = \"Let every command you start finish before you end\"\n+\tcurrent := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, boundary) || !strings.Contains(current, \"Run each `pose` command below as\") {\n+\t\tt.Fatal(\"the current review brief does not keep /9 and ask commands to finish\")\n+\t}\n+\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateEngineTools, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, boundary) {\n+\t\tt.Fatal(\"review-brief/9 changed under the runs briefed with it\")\n+\t}\n+}\n+\n+// Spec pose-review-declared-threat-model R2: the current brief lists the\n+// sealed accepted limits and says how a finding inside one is classified;\n+// /10 never did.\n+func TestTheCurrentBriefListsTheAcceptedLimits(t *testing.T) {\n+\tcurrent := renderReviewBriefBody(richBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, \"## Accepted limits\") || !strings.Contains(current, \"- L1: A process that clears its environment escapes.\") || !strings.Contains(current, \"with `limit` set to its id\") {\n+\t\tt.Fatalf(\"the current brief does not list the accepted limits:\\n%s\", current)\n+\t}\n+\tearlier := renderReviewBriefBody(richBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateFinishCommands, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, \"## Accepted limits\") {\n+\t\tt.Fatal(\"review-brief/10 changed under the runs briefed with it\")\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_brief_test.go b/pose-mcp/internal/pose/review_brief_test.go\nindex fa231421..088b80b5 100644\n--- a/pose-mcp/internal/pose/review_brief_test.go\n+++ b/pose-mcp/internal/pose/review_brief_test.go\n@@ -24,25 +24,25 @@ func TestReviewBriefIsRenderedFromTheBundleDeterministically(t *testing.T) {\n \tstore, bundle := briefFixture(t)\n \tfirst, err := store.RenderReviewBrief(bundle.BundleID, \"\", \"\")\n \tif err != nil {\n \t\tt.Fatal(err)\n \t}\n \tsecond, err := store.RenderReviewBrief(\"spec:backend\", ReviewBriefKindReview, \"\")\n \tif err != nil {\n \t\tt.Fatal(err)\n \t}\n \tif first.Text != second.Text || first.Digest != second.Digest || !strings.HasPrefix(first.Digest, \"sha256:\") {\n \t\tt.Fatal(\"the same bundle rendered different briefs\")\n \t}\n-\tfor _, want := range []string{\"template: review-brief/7\", bundle.BundleID, bundle.BundleDigest, \"## Boundaries\", \"Do not change the repository\", \"Do not record an attestation\", \"## Criteria to answer\", \"## Sealed evidence\", \"brief-digest: \" + first.Digest} {\n+\tfor _, want := range []string{\"template: review-brief/11\", bundle.BundleID, bundle.BundleDigest, \"## Boundaries\", \"Do not change the repository\", \"Do not record an attestation\", \"## Criteria to answer\", \"## Sealed evidence\", \"brief-digest: \" + first.Digest} {\n \t\tif !strings.Contains(first.Text, want) {\n \t\t\tt.Fatalf(\"brief lacks %q:\\n%s\", want, first.Text)\n \t\t}\n \t}\n \tfor _, c := range bundle.Payload.Plan.Criteria {\n \t\tif !strings.Contains(first.Text, \"- \"+c.ID+\" (\") {\n \t\t\tt.Fatalf(\"criterion %s missing from the brief\", c.ID)\n \t\t}\n \t}\n \tfor _, e := range bundle.Payload.Subject.Entries {\n \t\tif !strings.Contains(first.Text, entryPath(e)) {\n \t\t\tt.Fatalf(\"changed path %s missing from the brief\", entryPath(e))\ndiff --git a/pose-mcp/internal/pose/review_brief_versions_test.go b/pose-mcp/internal/pose/review_brief_versions_test.go\nindex 303d62cc..88b16a10 100644\n--- a/pose-mcp/internal/pose/review_brief_versions_test.go\n+++ b/pose-mcp/internal/pose/review_brief_versions_test.go\n@@ -45,24 +45,25 @@ func fixedBriefBundle() ReviewBundle {\n \n // richBriefBundle adds what only some briefs carry: structural facts (one shared with another\n // spec) and a tool scoped to a component.\n func richBriefBundle() ReviewBundle {\n \tbundle := fixedBriefBundle()\n \tbundle.Payload.Plan.Structure = &ReviewPlanStructure{Material: []ReviewStructuralFact{\n \t\t{ID: \"SD-aaaa1111\", Kind: \"governance-contract\", Action: \"changed\", Subject: \"an ADR\"},\n \t\t{ID: \"SD-bbbb2222\", Kind: \"api-contract\", Action: \"added\", Subject: \"an endpoint\", SharedWith: []string{\"other-spec\"}},\n \t}}\n \tbundle.Payload.Plan.Tools = append(bundle.Payload.Plan.Tools, ReviewPlanTool{ID: \"assess-discover\", Component: \"core\", Requiredness: \"recommended\", Args: []string{\"pose\", \"assess\", \"discover\"}})\n \tbundle.Payload.Subject.Entries = append(bundle.Payload.Subject.Entries, ReviewBundleSubjectEntry{Action: \"renamed\", OldPath: \"core/old.go\", NewPath: \"core/new.go\", Class: \"source\", Reason: \"moved\"})\n \tbundle.Payload.Plan.Criteria = append(bundle.Payload.Plan.Criteria, ReviewPlanCriterion{ID: \"documentation\", Description: \"The docs say it.\", Required: false, Kind: ReviewCriterionKindMechanical})\n+\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"A process that clears its environment escapes. Accepted because the shim covers it.\"}}\n \treturn bundle\n }\n \n // renderFixedBriefs renders a template every way a brief can differ: bare, with implementer\n // notes and structural facts, and as the second round with an open finding of the first. A\n // sentence of any section, in any of them, changes the digest.\n func renderFixedBriefs(template string) string {\n \tconclusion := reviewBriefAsksConclusion(template)\n \tvar out []string\n \trounds := []*ReviewRound{nil}\n \tif template != reviewBriefTemplateFirst {\n \t\tprior := &ReviewRun{RunID: \"rrn-prior0000000001\", BundleID: \"rvb-prior0000000001\", Output: \"decision: changes-requested\"}\ndiff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex c77e594c..53b6aba6 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -108,31 +108,36 @@ type ReviewBundleSubject struct {\n \tTreeDigest           string                     `json:\"tree_digest\"`\n \tEntries              []ReviewBundleSubjectEntry `json:\"entries\"`\n \t// Attribution narrows each path to what this scope's own commits changed\n \t// (see ReviewBundlePathAttribution). It is not implementation identity, so\n \t// the implementation, patch and tree digests leave it out; it is sealed with\n \t// the rest of the payload. Absent on bundles sealed before it existed, and\n \t// whenever Git could not answer: the structural assessment then compares\n \t// Base and Head.\n \tAttribution []ReviewBundlePathAttribution `json:\"attribution,omitempty\"`\n }\n \n type ReviewBundlePlan struct {\n-\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n-\tLimitations               []string              `json:\"limitations,omitempty\"`\n-\tPlanDigest                string     