{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/accepted_limits.go | sed -n '1,140p'; nl -ba pose-mcp/internal/pose/review_bundle.go | sed -n '1955,1990p;4060,4102p'; nl -ba pose-mcp/internal/pose/review_conclusions.go | sed -n '150,205p'; nl -ba pose-mcp/internal/cli/lintspec.go | sed -n '560,590p;1180,1245p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/accepted_limits.go | sed -n '1,140p'; nl -ba pose-mcp/internal/pose/review_bundle.go | sed -n '1955,1990p;4060,4102p'; nl -ba pose-mcp/internal/pose/review_conclusions.go | sed -n '150,205p'; nl -ba pose-mcp/internal/cli/lintspec.go | sed -n '560,590p;1180,1245p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Accepted limits (spec pose-review-declared-threat-model): a spec declares\n     4\t// the residual limits of a guarantee it makes, each with a stable id and why\n     5\t// it is accepted. The review plan seals them; the brief lists them; a\n     6\t// reviewer classifies a finding that falls inside one as within that limit,\n     7\t// or disputes the limit as a finding of its own. A declared limit never\n     8\t// hides a defect inside the declared scope: it is visible in the bundle, the\n     9\t// brief and the attestation.\n    10\t\n    11\timport (\n    12\t\t\"regexp\"\n    13\t\t\"strings\"\n    14\t)\n    15\t\n    16\t// ReviewAcceptedLimit is one declared residual limit.\n    17\ttype ReviewAcceptedLimit struct {\n    18\t\tID   string `json:\"id\"`\n    19\t\tText string `json:\"text\"`\n    20\t\t// Spec names the spec that declared the limit when the scope holds more\n    21\t\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n    22\t\tSpec string `json:\"spec,omitempty\"`\n    23\t}\n    24\t\n    25\tvar acceptedLimitRE = regexp.MustCompile(`^-\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n    26\t\n    27\t// acceptedLimitMarkerRE finds the marker where a sentence opens, after the\n    28\t// assumption: \"<assumption>. Accepted because <reason>.\" A marker inside a\n    29\t// sentence (\"Not accepted because\") is not one (review round 3, N1).\n    30\tvar acceptedLimitMarkerRE = regexp.MustCompile(`[.;:!?]\\s+(?:Accepted because|Aceito porque)\\s+`)\n    31\t\n    32\t// acceptedLimitReasonWordRE is a word with at least one letter.\n    33\tvar acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n    34\t\n    35\t// hasAcceptedLimitReason reads an entry as written: an assumption of at\n    36\t// least two words, then the marker opening a sentence, then a reason of at\n    37\t// least two words in that same sentence. A marker alone, punctuation, a\n    38\t// missing assumption or a reason borrowed from a later sentence does not say\n    39\t// why a limit is accepted (review rounds 1–4).\n    40\tfunc hasAcceptedLimitReason(text string) bool {\n    41\t\tloc := acceptedLimitMarkerRE.FindStringIndex(text)\n    42\t\tif loc == nil {\n    43\t\t\treturn false\n    44\t\t}\n    45\t\tassumption, rest := text[:loc[0]], text[loc[1]:]\n    46\t\tif end := strings.IndexAny(rest, \".;!?\"); end >= 0 {\n    47\t\t\trest = rest[:end]\n    48\t\t}\n    49\t\treturn len(acceptedLimitReasonWordRE.FindAllString(assumption, -1)) >= 2 && len(acceptedLimitReasonWordRE.FindAllString(rest, -1)) >= 2\n    50\t}\n    51\t\n    52\t// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n    53\t// It returns the limits and the problems that keep the section from being\n    54\t// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n    55\t// limit that does not say why it is accepted (\"Accepted because ...\" or\n    56\t// \"Aceito porque ...\").\n    57\tfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n    58\t\tvar limits []ReviewAcceptedLimit\n    59\t\tvar problems []string\n    60\t\tin := false\n    61\t\tseen := map[string]bool{}\n    62\t\tfor _, line := range strings.Split(body, \"\\n\") {\n    63\t\t\ttrimmed := strings.TrimSpace(line)\n    64\t\t\tif strings.HasPrefix(trimmed, \"#\") {\n    65\t\t\t\tin = strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Accepted limits\") || strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Limites aceitos\")\n    66\t\t\t\tcontinue\n    67\t\t\t}\n    68\t\t\tif !in || !strings.HasPrefix(trimmed, \"- \") {\n    69\t\t\t\tcontinue\n    70\t\t\t}\n    71\t\t\tm := acceptedLimitRE.FindStringSubmatch(trimmed)\n    72\t\t\tif m == nil {\n    73\t\t\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(trimmed)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n    74\t\t\t\tcontinue\n    75\t\t\t}\n    76\t\t\tif seen[m[1]] {\n    77\t\t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" is declared twice\")\n    78\t\t\t\tcontinue\n    79\t\t\t}\n    80\t\t\tseen[m[1]] = true\n    81\t\t\tif !hasAcceptedLimitReason(m[2]) {\n    82\t\t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" does not say why it is accepted ('Accepted because ...')\")\n    83\t\t\t}\n    84\t\t\tlimits = append(limits, ReviewAcceptedLimit{ID: m[1], Text: strings.TrimSpace(m[2])})\n    85\t\t}\n    86\t\treturn limits, problems\n    87\t}\n    88\t\n    89\t// acceptedLimitsOf collects the limits the scope's specs declare.\n    90\tfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n    91\t\tspecs, err := s.reviewScopeSpecs(scope)\n    92\t\tif err != nil {\n    93\t\t\treturn nil\n    94\t\t}\n    95\t\treturn acceptedLimitsOfSpecs(specs)\n    96\t}\n    97\t\n    98\t// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n    99\t// by its spec when there is more than one spec.\n   100\tfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n   101\t\tvar out []ReviewAcceptedLimit\n   102\t\tfor _, spec := range specs {\n   103\t\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n   104\t\t\tfor _, l := range limits {\n   105\t\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n   106\t\t\t\t// so a finding names exactly one sealed limit.\n   107\t\t\t\tif len(specs) > 1 {\n   108\t\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n   109\t\t\t\t}\n   110\t\t\t\tout = append(out, l)\n   111\t\t\t}\n   112\t\t}\n   113\t\treturn out\n   114\t}\n   115\t\n   116\t// sealedAcceptedLimit reports whether the bundle sealed limit id.\n   117\tfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n   118\t\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n   119\t\t\tif l.ID == id {\n   120\t\t\t\treturn true\n   121\t\t\t}\n   122\t\t}\n   123\t\treturn false\n   124\t}\n  1955\t\t}\n  1956\t\tfor rule := range rules {\n  1957\t\t\trel := \".pose/rules/\" + rule + \".md\"\n  1958\t\t\tif raw, err := s.fsys().ReadFile(filepath.Join(s.Root, filepath.FromSlash(rel))); err == nil {\n  1959\t\t\t\tinputs = append(inputs, ReviewBundleInput{Kind: \"rule\", Path: rel, Digest: digestBytes(raw), Reason: \"selected by effective review criterion\"})\n  1960\t\t\t}\n  1961\t\t}\n  1962\t\treturn sortedBundleInputs(inputs)\n  1963\t}\n  1964\t\n  1965\tfunc reviewBundlePlanDigest(plan ReviewPlan) (string, error) {\n  1966\t\tcontract := struct {\n  1967\t\t\tSchemaVersion             int                   `json:\"schema_version\"`\n  1968\t\t\tPolicySchemaVersion       int                   `json:\"policy_schema_version\"`\n  1969\t\t\tBaseProfile               string                `json:\"base_profile\"`\n  1970\t\t\tIndependence              string                `json:\"independence\"`\n  1971\t\t\tComponents                []ReviewPlanComponent `json:\"components\"`\n  1972\t\t\tSelectedProfiles          []ReviewPlanProfile   `json:\"selected_profiles\"`\n  1973\t\t\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n  1974\t\t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n  1975\t\t\tLimitations               []string              `json:\"limitations,omitempty\"`\n  1976\t\t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n  1977\t\t\t// The sealed limits enter the bundle's plan digest too; omitted when\n  1978\t\t\t// none, so every other bundle keeps its digest (review round 6, N1).\n  1979\t\t\tAcceptedLimits []ReviewAcceptedLimit `json:\"accepted_limits,omitempty\"`\n  1980\t\t}{plan.SchemaVersion, plan.PolicySchemaVersion, plan.BaseProfile, plan.Independence, append([]ReviewPlanComponent{}, plan.Components...), append([]ReviewPlanProfile{}, plan.SelectedProfiles...), append([]ReviewPlanCriterion{}, plan.Criteria...), append([]ReviewPlanTool{}, plan.Tools...), plan.Limitations, plan.DelegatedRunProofRequired, plan.AcceptedLimits}\n  1981\t\treturn digestJSON(contract)\n  1982\t}\n  1983\t\n  1984\tfunc normalizeReviewBundlePayload(payload *ReviewBundlePayload) {\n  1985\t\tsort.Slice(payload.Scope.Sections, func(i, j int) bool { return payload.Scope.Sections[i].Path < payload.Scope.Sections[j].Path })\n  1986\t\tsort.Slice(payload.Plan.Components, func(i, j int) bool { return payload.Plan.Components[i].ID < payload.Plan.Components[j].ID })\n  1987\t\tsort.Slice(payload.Plan.Criteria, func(i, j int) bool { return payload.Plan.Criteria[i].ID < payload.Plan.Criteria[j].ID })\n  1988\t\tsort.Slice(payload.Plan.Tools, func(i, j int) bool {\n  1989\t\t\treturn reviewToolKey(payload.Plan.Tools[i].ID, payload.Plan.Tools[i].Component) < reviewToolKey(payload.Plan.Tools[j].ID, payload.Plan.Tools[j].Component)\n  1990\t\t})\n  4060\t\t// is incomplete under any policy.\n  4061\t\tallowedRisk := map[string]bool{}\n  4062\t\tfor _, severity := range bundle.Payload.SealedGates().AcceptedRiskSeverities {\n  4063\t\t\tallowedRisk[severity] = true\n  4064\t\t}\n  4065\t\tseenFindings := map[string]bool{}\n  4066\t\tfor _, finding := range att.Findings {\n  4067\t\t\tif seenFindings[finding.ID] {\n  4068\t\t\t\tblockers = append(blockers, \"duplicate finding \"+finding.ID)\n  4069\t\t\t}\n  4070\t\t\tseenFindings[finding.ID] = true\n  4071\t\t\tif finding.Severity == \"\" || finding.Action == \"\" {\n  4072\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" lacks severity or action\")\n  4073\t\t\t}\n  4074\t\t\tswitch finding.Disposition {\n  4075\t\t\tcase \"resolved\":\n  4076\t\t\tcase \"accepted-risk\", \"wont-fix\":\n  4077\t\t\t\t// Leaving a finding unresolved accepts its risk regardless of the\n  4078\t\t\t\t// disposition's spelling. Use the policy frozen into this bundle.\n  4079\t\t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n  4080\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n  4081\t\t\t\t}\n  4082\t\t\tcase \"within-limit\":\n  4083\t\t\t\t// Inside a limit the spec declared and the bundle sealed, whatever\n  4084\t\t\t\t// its severity; a limit the bundle did not seal accepts nothing\n  4085\t\t\t\t// (spec pose-review-declared-threat-model R3).\n  4086\t\t\t\tif !sealedAcceptedLimit(bundle, finding.Limit) {\n  4087\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" names accepted limit \"+firstNonempty(finding.Limit, \"(none)\")+\", which this bundle did not seal\")\n  4088\t\t\t\t} else if strings.TrimSpace(finding.Rationale) == \"\" {\n  4089\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is within limit \"+finding.Limit+\" without saying why\")\n  4090\t\t\t\t}\n  4091\t\t\tcase \"open\", \"changes-requested\":\n  4092\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n  4093\t\t\tdefault:\n  4094\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has invalid disposition\")\n  4095\t\t\t}\n  4096\t\t}\n  4097\t\tif att.Decision != \"approved\" && !(att.Decision == \"approved-with-reservations\" && bundle.Payload.SealedGates().AllowApprovedWithReservations) {\n  4098\t\t\tblockers = append(blockers, \"review decision does not permit closeout: \"+att.Decision)\n  4099\t\t}\n  4100\t\treturn blockers\n  4101\t}\n  4102\t\n   150\t\n   151\t// reviewAttestationFromDraft builds the attestation a draft concludes, for\n   152\t// the run that wrote it. Evidence is the run itself and each evidence the\n   153\t// draft names; a criterion or a tool the draft does not answer is left for\n   154\t// the preflight to refuse, never answered for it.\n   155\tfunc reviewAttestationFromDraft(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, reviewer string) ReviewAttestation {\n   156\t\tatt := ReviewAttestation{BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest, Reviewer: reviewer, Decision: draft.Decision}\n   157\t\tevidence := map[string]bool{\"delegated-run:\" + run.RunID: true}\n   158\t\tfor _, c := range draft.Criteria {\n   159\t\t\tatt.Criteria = append(att.Criteria, ReviewCriterion{ID: c.ID, Disposition: c.Disposition, Evidence: c.Evidence, Rationale: c.Rationale, Mappings: c.Mappings})\n   160\t\t\tif c.Evidence != \"\" {\n   161\t\t\t\tevidence[c.Evidence] = true\n   162\t\t\t}\n   163\t\t}\n   164\t\tvar tools []ReviewToolDisposition\n   165\t\tfor _, t := range draft.Tools {\n   166\t\t\ttools = append(tools, ReviewToolDisposition{ID: t.ID, Component: t.Component, Disposition: t.Disposition, Evidence: t.Evidence, Rationale: t.Rationale})\n   167\t\t}\n   168\t\tatt.Tools = ReviewToolDefaults(bundle.Payload.Plan.Tools, tools)\n   169\t\tfor _, f := range draft.Findings {\n   170\t\t\tfinding := ReviewFinding{ID: f.ID, Severity: f.Severity, Evidence: findingEvidence(f), Action: f.Action, Disposition: \"open\"}\n   171\t\t\tif f.Action == \"\" {\n   172\t\t\t\tfinding.Action = f.Summary\n   173\t\t\t}\n   174\t\t\t// A follow-up the reviewer gave an action, an owner and a review date\n   175\t\t\t// is a risk the reviewer accepted; anything else stays open and blocks\n   176\t\t\t// an approval. The engine never writes the action for the reviewer\n   177\t\t\t// (review round 1, B3).\n   178\t\t\tif f.Disposition == \"follow-up\" && f.Action != \"\" && f.Owner != \"\" && f.ReviewBy != \"\" {\n   179\t\t\t\tfinding.Disposition, finding.Owner, finding.ReviewBy, finding.Rationale = \"accepted-risk\", f.Owner, f.ReviewBy, f.Summary\n   180\t\t\t}\n   181\t\t\t// A follow-up the reviewer classified inside a declared accepted\n   182\t\t\t// limit is recorded as such, naming the limit (spec\n   183\t\t\t// pose-review-declared-threat-model R3).\n   184\t\t\tif f.Disposition == \"follow-up\" && f.Limit != \"\" {\n   185\t\t\t\tfinding.Disposition, finding.Limit, finding.Rationale, finding.Owner, finding.ReviewBy = \"within-limit\", f.Limit, f.Summary, f.Owner, f.ReviewBy\n   186\t\t\t}\n   187\t\t\tatt.Findings = append(att.Findings, finding)\n   188\t\t}\n   189\t\tfor ref := range evidence {\n   190\t\t\tatt.EvidenceRefs = append(att.EvidenceRefs, ref)\n   191\t\t}\n   192\t\tsort.Strings(att.EvidenceRefs)\n   193\t\tatt.Run = &ReviewRunReference{RunID: run.RunID}\n   194\t\treturn att\n   195\t}\n   196\t\n   197\t// ReviewToolDefaults is given followed by the dispositions that state no\n   198\t// conclusion, for the plan's tools given leaves out: a post-review gate\n   199\t// deferred, a recommended tool not used. A required tool left out stays out,\n   200\t// for the domain writer to name. `review attest` and a run's conclusion fill\n   201\t// the same defaults, so a run's conclusion and its attestation agree on them.\n   202\tfunc ReviewToolDefaults(plan []ReviewPlanTool, given []ReviewToolDisposition) []ReviewToolDisposition {\n   203\t\tout := append([]ReviewToolDisposition{}, given...)\n   204\t\tprovided := map[string]bool{}\n   205\t\tfor _, t := range given {\n   560\t\t\t\tlint.finding(cliout.StateError, \"dor\", cliText(locale, \"DoR: no acceptance criterion has a stable ID (use '- R<N>: ...' bullets in Requirements)\", \"DoR: nenhum acceptance criterion com ID estável (use bullets '- R<N>: ...' em Requirements)\"))\n   561\t\t\t\tfailures++\n   562\t\t\t}\n   563\t\t\tfor _, ref := range lintParseDependsOn(frontmatter[\"depends_on\"]) {\n   564\t\t\t\tif _, err := posepkg.ParseArtifactRef(ref); err == nil {\n   565\t\t\t\t\tcontinue\n   566\t\t\t\t}\n   567\t\t\t\tlint.finding(cliout.StateError, \"dor\", fmt.Sprintf(cliText(locale, \"DoR: invalid depends_on reference: '%s'\", \"DoR: ref inválida em depends_on: '%s'\"), ref))\n   568\t\t\t\tfailures++\n   569\t\t\t}\n   570\t\t\t// Accepted limits (spec pose-review-declared-threat-model R4): each\n   571\t\t\t// says why it is accepted, and an ADR that names the spec names each\n   572\t\t\t// limit, so the decision record carries what the review will treat as\n   573\t\t\t// out of scope.\n   574\t\t\tlimits, limitProblems := posepkg.ParseAcceptedLimits(text)\n   575\t\t\tfor _, problem := range limitProblems {\n   576\t\t\t\tlint.finding(cliout.StateError, \"dor\", \"DoR: \"+problem)\n   577\t\t\t\tfailures++\n   578\t\t\t}\n   579\t\t\tif len(limits) > 0 {\n   580\t\t\t\tfor _, missing := range acceptedLimitsMissingFromADRs(lintProjectRoot(specPath), slug, limits) {\n   581\t\t\t\t\tlint.finding(cliout.StateError, \"dor\", missing)\n   582\t\t\t\t\tfailures++\n   583\t\t\t\t}\n   584\t\t\t}\n   585\t\t\temitDesignBasis()\n   586\t\t\tfailures += designFailures + lineageFailures\n   587\t\t\tready := \"true\"\n   588\t\t\tif failures > 0 {\n   589\t\t\t\tready = \"false\"\n   590\t\t\t}\n  1180\t\tfor _, n := range names {\n  1181\t\t\tif n == name {\n  1182\t\t\t\treturn true\n  1183\t\t\t}\n  1184\t\t}\n  1185\t\treturn false\n  1186\t}\n  1187\t\n  1188\t// acceptedLimitsMissingFromADRs names each declared limit an ADR that cites\n  1189\t// the spec does not mention. With no ADR citing the spec nothing is required.\n  1190\tfunc acceptedLimitsMissingFromADRs(root, slug string, limits []posepkg.ReviewAcceptedLimit) []string {\n  1191\t\tentries, err := os.ReadDir(filepath.Join(root, \".pose\", \"adr\"))\n  1192\t\tif errors.Is(err, os.ErrNotExist) {\n  1193\t\t\treturn nil\n  1194\t\t}\n  1195\t\t// An ADR that cannot be read may be the one that cites the spec: the\n  1196\t\t// check fails closed instead of reading it as absent (review round 5, N2).\n  1197\t\tif err != nil {\n  1198\t\t\treturn []string{\"DoR: the ADRs cannot be read to check the accepted limits: \" + err.Error()}\n  1199\t\t}\n  1200\t\tvar citing []string\n  1201\t\tvar unreadable []string\n  1202\t\tfor _, e := range entries {\n  1203\t\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".md\") {\n  1204\t\t\t\tcontinue\n  1205\t\t\t}\n  1206\t\t\traw, err := os.ReadFile(filepath.Join(root, \".pose\", \"adr\", e.Name()))\n  1207\t\t\tif err != nil {\n  1208\t\t\t\tunreadable = append(unreadable, \"DoR: ADR \"+e.Name()+\" cannot be read to check the accepted limits: \"+err.Error())\n  1209\t\t\t\tcontinue\n  1210\t\t\t}\n  1211\t\t\tif !strings.Contains(string(raw), slug) {\n  1212\t\t\t\tcontinue\n  1213\t\t\t}\n  1214\t\t\tciting = append(citing, string(raw))\n  1215\t\t}\n  1216\t\tif len(unreadable) > 0 {\n  1217\t\t\treturn unreadable\n  1218\t\t}\n  1219\t\tif len(citing) == 0 {\n  1220\t\t\treturn nil\n  1221\t\t}\n  1222\t\tvar missing []string\n  1223\t\tfor _, l := range limits {\n  1224\t\t\tfound := false\n  1225\t\t\t// The id as a word: L10 does not name L1 (review round 1, N3).\n  1226\t\t\tnamed := regexp.MustCompile(`\\b` + regexp.QuoteMeta(l.ID) + `\\b`)\n  1227\t\t\tfor _, adr := range citing {\n  1228\t\t\t\tfound = found || named.MatchString(adr)\n  1229\t\t\t}\n  1230\t\t\tif !found {\n  1231\t\t\t\tmissing = append(missing, \"DoR: accepted limit \"+l.ID+\" is not named by the ADR that cites \"+slug)\n  1232\t\t\t}\n  1233\t\t}\n  1234\t\treturn missing\n  1235\t}\n","exit_code":0,"status":"completed"}}
