{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba \"$POSE_SEALED_CHECKOUT\"/pose-mcp/internal/pose/review_dispatch.go | sed -n '\"'235,320p'; nl -ba \\\"\"'$POSE_SEALED_CHECKOUT\"/pose-mcp/internal/pose/delegation_release.go | sed -n '\"'270,315p'; nl -ba \\\"\"'$POSE_SEALED_CHECKOUT\"/pose-mcp/internal/pose/delegation_list.go | sed -n '\"'140,205p'\"","aggregated_output":"   235\t// Review run states.\n   236\tconst (\n   237\t\tReviewRunCompleted   = \"completed\"\n   238\t\tReviewRunFailed      = \"failed\"\n   239\t\tReviewRunInterrupted = \"interrupted\"\n   240\t\tReviewRunStale       = \"stale\"\n   241\t)\n   242\t\n   243\t// ListReviewRuns returns the recorded runs for bundleID (\"\" for all).\n   244\tfunc (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n   245\t\truns, _, err := s.ReadReviewRuns(bundleID)\n   246\t\treturn runs, err\n   247\t}\n   248\t\n   249\tfunc (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n   250\t\t// Within a read-view operation the ledger is read and checked once per\n   251\t\t// root; every request of the operation is answered from that read,\n   252\t\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n   253\t\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n   254\t\t\truns, lost, err := s.readAllReviewRuns()\n   255\t\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n   256\t\t})\n   257\t\tif err != nil {\n   258\t\t\treturn nil, nil, err\n   259\t\t}\n   260\t\tout := copyReviewRuns(all.runs)\n   261\t\tif bundleID != \"\" {\n   262\t\t\tfiltered := []ReviewRun{}\n   263\t\t\tfor _, run := range out {\n   264\t\t\t\tif run.BundleID == bundleID {\n   265\t\t\t\t\tfiltered = append(filtered, run)\n   266\t\t\t\t}\n   267\t\t\t}\n   268\t\t\tout = filtered\n   269\t\t}\n   270\t\treturn out, deepCopyValue(all.lost), nil\n   271\t}\n   272\t\n   273\t// readAllReviewRuns reads, checks and orders every review run of the store.\n   274\tfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n   275\t\tfiles := s.fsys()\n   276\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n   277\t\t// The storage is read where the writer writes it: a link in its place is another place.\n   278\t\tif info, lerr := files.Lstat(dir); lerr == nil {\n   279\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n   280\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n   281\t\t\t}\n   282\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   283\t\t\treturn nil, nil, lerr\n   284\t\t}\n   285\t\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n   286\t\tif errors.Is(err, os.ErrNotExist) {\n   287\t\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n   288\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n   289\t\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   290\t\t\t\treturn nil, nil, lerr\n   291\t\t\t}\n   292\t\t\treturn []ReviewRun{}, nil, nil\n   293\t\t}\n   294\t\tif err != nil {\n   295\t\t\treturn nil, nil, err\n   296\t\t}\n   297\t\tout := []ReviewRun{}\n   298\t\tvar lost []string\n   299\t\treadBudget := int64(32 << 20)\n   300\t\tfor _, e := range entries {\n   301\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   302\t\t\t\tcontinue\n   303\t\t\t}\n   304\t\t\tfull := filepath.Join(dir, e.Name())\n   305\t\t\tinfo, infoErr := files.Lstat(full)\n   306\t\t\tif infoErr != nil || !info.Mode().IsRegular() {\n   307\t\t\t\tlost = append(lost, e.Name()+\" (not a regular file)\")\n   308\t\t\t\tcontinue\n   309\t\t\t}\n   310\t\t\tif info.Size() < 0 || info.Size() > reviewLedgerMaxBytes {\n   311\t\t\t\tlost = append(lost, e.Name()+\" (record exceeds bound or is unreadable)\")\n   312\t\t\t\tcontinue\n   313\t\t\t}\n   314\t\t\traw, err := readLedgerRawBudgetIn(files, full, &readBudget)\n   315\t\t\tif err != nil {\n   316\t\t\t\tlost = append(lost, e.Name()+\" (\"+err.Error()+\")\")\n   317\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   318\t\t\t\t\tbreak\n   319\t\t\t\t}\n   320\t\t\t\tcontinue\n   270\t\t}\n   271\t\treturn nil\n   272\t}\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n","exit_code":0,"status":"completed"}}
