{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba \"$POSE_SEALED_CHECKOUT\"/pose-mcp/internal/pose/writer_publication.go | sed -n '\"'34,70p'; rg -n 'takeover|claimAttemptRelease|release claim' \\\"\"'$POSE_SEALED_CHECKOUT\"/pose-mcp/internal/pose/delegation_release_test.go'","aggregated_output":"    34\t\tExpectAny = iota\n    35\t\t// ExpectDigest publishes only if the file still holds the bytes with\n    36\t\t// Digest (SHA-256, hex): the read-modify-write of a mutable artifact.\n    37\t\tExpectDigest\n    38\t\t// ExpectAbsent publishes only if no file exists: an immutable artifact.\n    39\t\t// A retry that finds the same bytes is idempotent; other bytes conflict.\n    40\t\tExpectAbsent\n    41\t)\n    42\t\n    43\t// PublishExpectation is what a writer read before it computed its bytes.\n    44\ttype PublishExpectation struct {\n    45\t\tMode   int\n    46\t\tDigest string\n    47\t}\n    48\t\n    49\t// ExpectBytes is the expectation for a file read as raw (nil: absent).\n    50\tfunc ExpectBytes(raw []byte, exists bool) PublishExpectation {\n    51\t\tif !exists {\n    52\t\t\treturn PublishExpectation{Mode: ExpectAbsent}\n    53\t\t}\n    54\t\treturn PublishExpectation{Mode: ExpectDigest, Digest: digestHex(raw)}\n    55\t}\n    56\t\n    57\t// ErrPublishConflict marks a publication refused because the file is no\n    58\t// longer what its writer read. Errors that carry it are *PublishConflictError.\n    59\tvar ErrPublishConflict = errors.New(\"publish-conflict\")\n    60\t\n    61\t// PublishConflictError says which file changed, what the writer expected and\n    62\t// what it found. Nothing was published.\n    63\ttype PublishConflictError struct {\n    64\t\tPath     string `json:\"path\"`\n    65\t\tExpected string `json:\"expected\"`\n    66\t\tFound    string `json:\"found\"`\n    67\t}\n    68\t\n    69\tfunc (e *PublishConflictError) Error() string {\n    70\t\treturn fmt.Sprintf(\"%s: %s changed since it was read (expected %s, found %s); nothing was published\", ErrPublishConflict, e.Path, e.Expected, e.Found)\n256:\tif err := claimAttemptRelease(claim, time.Now()); err != nil {\n","exit_code":0,"status":"completed"}}
