tExist(err) {\n   194\t\t\t\treturn err\n   195\t\t\t}\n   196\t\t\tif found != expect.Digest {\n   197\t\t\t\treturn &PublishConflictError{Path: path, Expected: expect.Digest, Found: found}\n   198\t\t\t}\n   199\t\t\tif PublishBeforeReplace != nil {\n   200\t\t\t\tPublishBeforeReplace(path)\n   201\t\t\t}\n   202\t\t\tfallthrough\n   203\t\tdefault:\n   204\t\t\tif err := os.Rename(name, path); err != nil {\n   205\t\t\t\treturn err\n   206\t\t\t}\n   207\t\t\tpublished = true\n   208\t\t}\n   209\t\tif class == PublishAuthoritative {\n   210\t\t\terr := error(nil)\n   211\t\t\tif PublishSyncHook != nil {\n   212\t\t\t\terr = PublishSyncHook(\"dir\", path)\n   213\t\t\t}\n   214\t\t\tif err == nil {\n   215\t\t\t\terr = syncDir(dir)\n   216\t\t\t}\n   217\t\t\tif err != nil {\n   218\t\t\t\treturn &PublishDurabilityError{Path: path, Err: err}\n   219\t\t\t}\n   220\t\t}\n   221\t\treturn nil\n   222\t}\n   223\t\n   224\t// publishExclusive creates path only if it does not exist and writes data in\n   225\t// place, for filesystems that cannot hard-link the staged file.\n   226\tfunc publishExclusive(path string, data []byte, perm os.FileMode, class string) error {\n   227\t\tf, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, perm)\n   228\t\tif err != nil {\n   229\t\t\tif errors.Is(err, os.ErrExist) {\n   230\t\t\t\tcurrent, readErr := os.ReadFile(path)\n   231\t\t\t\tif readErr == nil && digestHex(current) == digestHex(data) {\n   232\t\t\t\t\treturn nil\n   233\t\t\t\t}\n   234\t\t\t\treturn &PublishConflictError{Path: path, Expected: \"absent\", Found: digestHex(current)}\n   235\t\t\t}\n   236\t\t\treturn err\n   237\t\t}\n   238\t\tif _, err = f.Write(data); err != nil {\n   239\t\t\tf.Close()\n   240\t\t\treturn err\n   241\t\t}\n   242\t\t// The whole record is at its name: from here a failure is one of durability.\n   243\t\tif class == PublishAuthoritative {\n   244\t\t\tif PublishSyncHook != nil {\n   245\t\t\t\terr = PublishSyncHook(\"exclusive\", path)\n   246\t\t\t}\n   247\t\t\tif err == nil {\n   248\t\t\t\terr = f.Sync()\n   249\t\t\t}\n   250\t\t}\n   220\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n   221\t\t}\n   222\t\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n   223\t\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n   224\t\t}\n   225\t}\n   226\t\n   227\t// Review round 2, N3: a release already claimed is not run again.\n   228\tfunc TestAClaimedReleaseIsNotRunTwice(t *testing.T) {\n   229\t\troot := t.TempDir()\n   230\t\ts := Store{Root: root}\n   231\t\tattempt := \"rat-\" + strings.Repeat(\"9\", 64)\n   232\t\tdir, _ := s.delegationActiveDir(true)\n   233\t\tclaim := filepath.Join(dir, attempt+\".release\")\n   234\t\tlive := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"release:x\", Operation: \"pose delegate cancel\", PID: os.Getpid()}\n   235\t\tlive.Host, _ = os.Hostname()\n   236\t\tidentifyStartLockProcess(&live)\n   237\t\traw, _ := json.Marshal(live)\n   238\t\tif err := os.WriteFile(claim, raw, 0o600); err != nil {\n   239\t\t\tt.Fatal(err)\n   240\t\t}\n   241\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\n   242\t\t\tt.Fatalf(\"a claimed release ran again: %v\", err)\n   243\t\t}\n   244\t\t// Review round 3, N1: a claim whose owner is gone is an interrupted\n   245\t\t// release, taken over.\n   246\t\tdead := exec.Command(\"true\")\n   247\t\tif err := dead.Run(); err != nil {\n   248\t\t\tt.Fatal(err)\n   249\t\t}\n   250\t\tgone := live\n   251\t\tgone.PID = dead.Process.Pid\n   252\t\traw, _ = json.Marshal(gone)\n   253\t\tif err := os.WriteFile(claim, raw, 0o600); err != nil {\n   254\t\t\tt.Fatal(err)\n   255\t\t}\n   256\t\tif err := claimAttemptRelease(claim, time.Now()); err != nil {\n   257\t\t\tt.Fatalf(\"an interrupted release's claim was not taken over: %v\", err)\n   258\t\t}\n   259\t}\n   260\t\n   261\t// Review round 3, N1: a release interrupted after it recorded the run, and\n   262\t// before the receipt, completes with that run instead of recording another.\n   263\tfunc TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n   264\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   265\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   266\t\tif err != nil {\n   267\t\t\tt.Fatal(err)\n   268\t\t}\n   269\t\tattempt := \"\"\n   270\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   271\t\tfunc() {\n   272\t\t\tdefer func() { _ = recover() }()\n   273\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   274\t\t}()\n   275\t\twriteDeadMarker(t, f.store, attempt)\n   276\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   277\t\tmarkerPath := filepath.Join(activeDir, attempt+\".json\")\n   278\t\tmarkerBytes, err := os.ReadFile(markerPath)\n   279\t\tif err != nil {\n   280\t\t\tt.Fatal(err)\n   281\t\t}\n   282\t\tfirst, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   283\t\tif err != nil {\n   284\t\t\tt.Fatal(err)\n   285\t\t}\n   286\t\t// Undo the receipt and keep the marker, as a release stopped between\n   287\t\t// the run and the receipt leaves them.\n   288\t\tattempts, _ := f.store.readDelegatedReviewAttempts(f.bundle.BundleID)\n   289\t\tfor _, a := range attempts {\n   290\t\t\tif a.AttemptID == attempt {\n   291\t\t\t\tif err := os.Remove(attemptReceiptPath(f.store.Root, a)); err != nil {\n   292\t\t\t\t\tt.Fatal(err)\n   293\t\t\t\t}\n   294\t\t\t}\n   295\t\t}\n   296\t\tif err := os.WriteFile(markerPath, markerBytes, 0o600); err != nil {\n   297\t\t\tt.Fatal(err)\n   298\t\t}\n   299\t\tsecond, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   300\t\tif err != nil || second.RunID != first.RunID {\n   301\t\t\tt.Fatalf(\"the interrupted release recorded another run: %s then %s (%v)\", first.RunID, second.RunID, err)\n   302\t\t}\n   303\t}\n   304\t\n   305\t// Review round 2, N1: a reservation an earlier engine left with no marker is\n   306\t// listed and released once it is old enough, never while it is young.\n   307\tfunc TestAMarkerlessReservationOfAnEarlierEngineIsReleased(t *testing.T) {\n   308\t\troot := t.TempDir()\n   309\t\ts := Store{Root: root}\n   310\t\treserve := func(age time.Duration, nonce string) DelegatedReviewAttempt {\n   311\t\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000b\" + nonce[:1], BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   312\t\t\t\tReservedAt: time.Now().Add(-age).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(nonce[:1], 32)}\n   313\t\t\ta.AttemptID = attemptIdentity(a)\n   314\t\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   315\t\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   316\t\t\t\tt.Fatal(err)\n   317\t\t\t}\n   318\t\t\treturn a\n   319\t\t}\n   320\t\told, young := reserve(time.Hour, \"1\"), reserve(time.Minute, \"2\")\n   321\t\tattempts, _, err := s.ListDelegationAttempts()\n   322\t\tif err != nil {\n   323\t\t\tt.Fatal(err)\n   324\t\t}\n   325\t\tlisted := map[string]DelegationAttempt{}\n   326\t\tfor _, a := range attempts {\n   327\t\t\tlisted[a.AttemptID] = a\n   328\t\t}\n   329\t\tif a, ok := listed[old.AttemptID]; !ok || a.State != DelegationStalled || !strings.Contains(a.Failure, \"pose delegate cancel \"+old.AttemptID+\" --confirm-abandoned\") {\n   330\t\t\tt.Fatalf(\"the old markerless reservation is not listed with its release: %+v\", attempts)\n   331\t\t}\n   332\t\tif _, ok := listed[young.AttemptID]; ok {\n   333\t\t\tt.Fatal(\"a young reservation was listed as abandoned\")\n   334\t\t}\n   335\t\tif _, err := s.ReleaseAbandonedAttempt(young.AttemptID, time.Now(), true); !errors.Is(err, ErrAttemptNotAbandoned) {\n   336\t\t\tt.Fatalf(\"a young reservation was released: %v\", err)\n   337\t\t}\n   338\t\t// Review round 3, N2: nothing proves a markerless reservation abandoned,\n   339\t\t// so it is released only on the operator's confirmation.\n   340\t\tif _, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"--confirm-abandoned\") {\n   341\t\t\tt.Fatalf(\"a markerless reservation was released without confirmation: %v\", err)\n   342\t\t}\n   343\t\trun, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n   344\t\tif err != nil || run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"operator's confirmation\") {\n   345\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   346\t\t}\n   347\t\tif _, err := s.readAttemptReceipt(old); err != nil {\n   348\t\t\tt.Fatalf(\"the released reservation still blocks its bundle: %v\", err)\n   349\t\t}\n   350\t}\n   351\t\n   352\t// Review round 3, N3: an unreadable reservation is reported, not skipped.\n   353\tfunc TestAnUnreadableReservationIsReportedAsALoss(t *testing.T) {\n   354\t\troot := t.TempDir()\n   355\t\ts := Store{Root: root}\n   356\t\tdir := filepath.Join(root, reviewAttemptDir, \"broken\")\n   357\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n   358\t\t\tt.Fatal(err)\n   359\t\t}\n   360\t\tif err := os.WriteFile(filepath.Join(dir, \"000001.json\"), []byte(\"{not json\"), 0o644); err != nil {\n   361\t\t\tt.Fatal(err)\n   362\t\t}\n   363\t\t_, lost, err := s.ListDelegationAttempts()\n   364\t\tif err != nil || !strings.Contains(strings.Join(lost, \"\\n\"), \"broken/000001.json could not be read\") {\n   365\t\t\tt.Fatalf(\"an unreadable reservation was skipped silently: %v %v\", lost, err)\n   366\t\t}\n   367\t}\n  1100\t\thandBackExisting(run, err)\n  1101\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n  1102\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"resume\")\n  1103\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"resume\", run, err, delegateRunNextActions(store, run, err)...)\n  1104\t\tif err == nil && !f.jsonOut {\n  1105\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n  1106\t\t\t\treturn next\n  1107\t\t\t}\n  1108\t\t}\n  1109\t\treturn code\n  1110\t}\n  1111\t\n  1112\tfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n  1113\t\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n  1114\t\tif problem != \"\" {\n  1115\t\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n  1116\t\t}\n  1117\t\tstore := posemodel.Store{Root: root}\n  1118\t\tattempts, lost, err := store.ListDelegationAttempts()\n  1119\t\tif err != nil {\n  1120\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1121\t\t}\n  1122\t\tattempt, code, err := namedAttempt(attempts, f)\n  1123\t\tif err != nil {\n  1124\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n  1125\t\t}\n  1126\t\tif attempt.State == posemodel.DelegationStalled && attempt.LatestRun == \"\" && !f.dryRun {\n  1127\t\t\t// An attempt whose dispatch ended before recording its run is\n  1128\t\t\t// released with a failed run and its receipt, so it stops blocking\n  1129\t\t\t// the bundle (spec pose-review-run-reaps-lingering-reviewer-processes R5).\n  1130\t\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n  1131\t\t\tif err != nil {\n  1132\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1133\t\t\t}\n  1134\t\t\tif f.jsonOut {\n  1135\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n  1136\t\t\t\treturn 0\n  1137\t\t\t}\n  1138\t\t\tout := render(stdout, stderr)\n  1139\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1140\t\t\tif run.RunID == \"\" {\n  1141\t\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n  1142\t\t\t} else {\n  1143\t\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n  1144\t\t\t}\n  1145\t\t\treturn 0\n  1146\t\t}\n  1147\t\tif !attempt.Active {\n  1148\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1149\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1150\t\t}\n  1151\t\tif f.dryRun {\n  1152\t\t\tif f.jsonOut {\n  1153\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": false, \"dry_run\": true, \"owner\": attempt.Liveness})\n  1154\t\t\t\treturn 0\n  1155\t\t\t}\n  1156\t\t\tout := render(stdout, stderr)\n  1157\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1158\t\t\tout.Field(\"delegate.owner\", attempt.Liveness)\n  1159\t\t\tout.Field(\"delegate.dry_run\", tr(\"true (no cancellation requested)\", \"true (nenhum cancelamento pedido)\"))\n  1160\t\t\treturn 0\n  1161\t\t}\n  1162\t\tmarker, err := store.RequestDelegationCancel(attempt.AttemptID)\n  1163\t\tif err != nil {\n  1164\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1165\t\t}\n  1166\t\tdeadline := time.Now().Add(60 * time.Second)\n  1167\t\tfor store.DelegationRunActive(marker) && time.Now().Before(deadline) {\n  1168\t\t\ttime.Sleep(200 * time.Millisecond)\n  1169\t\t}\n  1170\t\tstopped := !store.DelegationRunActive(marker)\n  1171\t\tstatus, run := \"\", \"\"\n  1172\t\tif after, _, err := store.ListDelegationAttempts(); err == nil {\n  1173\t\t\tfor _, a := range after {\n  1174\t\t\t\tif a.AttemptID == attempt.AttemptID && a.Latest() != nil {\n  1175\t\t\t\t\tstatus, run = a.Latest().Status, a.Latest().RunID\n  1176\t\t\t\t}\n  1177\t\t\t}\n  1178\t\t}\n  1179\t\tif f.jsonOut {\n  1180\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": true, \"stopped\": stopped, \"run\": run, \"status\": status})\n  1181\t\t} else {\n  1182\t\t\tout := render(stdout, stderr)\n  1183\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1184\t\t\tout.Field(\"delegate.cancel\", tr(\"requested\", \"pedido\"))\n  1185\t\t\tout.Field(\"delegate.stopped\", fmt.Sprint(stopped))\n","exit_code":0,"status":"completed"}}
