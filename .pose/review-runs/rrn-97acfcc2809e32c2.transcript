n .pose/review-bundles/rvb-463c1d036776b14f.json     | 3553 +++++++++++++++++++\n .pose/review-bundles/rvb-75dfb88d581fcbc7.json     | 3660 ++++++++++++++++++++\n .pose/review-bundles/rvb-aa10a0acf3fc6576.json     | 3622 +++++++++++++++++++\n .pose/review-bundles/rvb-f71272a8111ac846.json     | 3633 +++++++++++++++++++\n .pose/review-conclusions/rrn-2c9fa8ac47c2fbab.json |   13 +\n .pose/review-conclusions/rrn-667b69e8c01c345c.json |   13 +\n .pose/review-conclusions/rrn-89507308d2c8324b.json |   13 +\n .pose/review-conclusions/rrn-c5c082703d83c834.json |   13 +\n .pose/review-run-ledger/rrn-2c9fa8ac47c2fbab.json  |    8 +\n .pose/review-run-ledger/rrn-549379b676b5f537.json  |    8 +\n .pose/review-run-ledger/rrn-667b69e8c01c345c.json  |    8 +\n .pose/review-run-ledger/rrn-89507308d2c8324b.json  |    8 +\n .pose/review-run-ledger/rrn-c5c082703d83c834.json  |    8 +\n .pose/review-run-ledger/rrn-cd0ac9394ca5892b.json  |    8 +\n ...3eefacf4e364892e3c35be84df8e72236811a0b9f0.json |   23 +\n ...5961b4915961d0d62005a017618900161e7332d491.json |   23 +\n ...d103f276d7109e21267db933730cc537467b600e6e.json |   23 +\n ...4c83097fbc8bfbdc3b4dd54c7408c09b6b2b71fc2d.json |   23 +\n .../review-runs/rrn-2c9fa8ac47c2fbab.events.ndjson |  135 +\n .pose/review-runs/rrn-2c9fa8ac47c2fbab.json        |  155 +\n .pose/review-runs/rrn-2c9fa8ac47c2fbab.transcript  |  139 +\n .../review-runs/rrn-549379b676b5f537.events.ndjson |    4 +\n .pose/review-runs/rrn-549379b676b5f537.json        |  150 +\n .pose/review-runs/rrn-549379b676b5f537.transcript  |    9 +\n .../review-runs/rrn-667b69e8c01c345c.events.ndjson |  109 +\n .pose/review-runs/rrn-667b69e8c01c345c.json        |  155 +\n .pose/review-runs/rrn-667b69e8c01c345c.transcript  |  114 +\n .../review-runs/rrn-89507308d2c8324b.events.ndjson |  122 +\n .pose/review-runs/rrn-89507308d2c8324b.json        |  149 +\n .pose/review-runs/rrn-89507308d2c8324b.transcript  |  123 +\n .../review-runs/rrn-c5c082703d83c834.events.ndjson |   92 +\n .pose/review-runs/rrn-c5c082703d83c834.json        |  149 +\n .pose/review-runs/rrn-c5c082703d83c834.transcript  |   93 +\n .../review-runs/rrn-cd0ac9394ca5892b.events.ndjson |   90 +\n .pose/review-runs/rrn-cd0ac9394ca5892b.json        |  151 +\n .pose/review-runs/rrn-cd0ac9394ca5892b.transcript  |   91 +\n ...23-pose-assess-leaves-sealed-checkouts-alone.md |   72 +-\n ...eview-conclude-ignores-unrelated-local-edits.md |  109 +\n ...eview-run-reaps-lingering-reviewer-processes.md |  175 +\n POSE.md                                            |    8 +-\n locales/pt-BR/POSE.md                              |    8 +-\n pose-mcp/internal/cli/assess.go                    |   78 +-\n pose-mcp/internal/cli/assess_sealed_test.go        |  107 +\n pose-mcp/internal/cli/delegate.go                  |   34 +-\n pose-mcp/internal/cli/help_catalog.go              |    8 +-\n pose-mcp/internal/cli/review_reap_test.go          |   59 +\n pose-mcp/internal/pose/assessment_sealed.go        |   20 +\n pose-mcp/internal/pose/assessment_sealed_test.go   |   62 +\n pose-mcp/internal/pose/delegation_list.go          |   24 +\n pose-mcp/internal/pose/delegation_release.go       |  272 ++\n pose-mcp/internal/pose/delegation_release_test.go  |  367 ++\n pose-mcp/internal/pose/discovery.go                |   12 +\n pose-mcp/internal/pose/integration.go              |    3 +\n .../internal/pose/review_adapter_containment.go    |   10 +\n .../review_adapter_containment_regression_test.go  |   19 +-\n pose-mcp/internal/pose/review_attempt_ledger.go    |   30 +-\n pose-mcp/internal/pose/review_brief.go             |   35 +-\n .../pose/review_brief_conclusion_rules_test.go     |   34 +-\n pose-mcp/internal/pose/review_brief_test.go        |    2 +-\n pose-mcp/internal/pose/review_dispatch.go          |   42 +-\n pose-mcp/internal/pose/review_plan.go              |    6 +-\n pose-mcp/internal/pose/review_reap_linux.go        |  213 ++\n pose-mcp/internal/pose/review_reap_linux_test.go   |   90 +\n pose-mcp/internal/pose/review_reap_other.go        |    9 +\n pose-mcp/internal/pose/techdebt.go                 |    3 +\n .../testdata/review_brief_template_digests.json    |    4 +-\n pose-mcp/internal/scaffold/dist/POSE.md            |    8 +-\n .../internal/scaffold/dist/locales/pt-BR/POSE.md   |    8 +-\n 92 files changed, 26815 insertions(+), 2372 deletions(-)\n   108\t\n   109\t## 5. Decisions\n   110\t\n   111\t### Decision D1\n   112\t- Basis: R1, R2\n   113\tLeftover processes are identified by the sealed-checkout entry the dispatch already sets in the run's environment, not by process group or session: adapters such as `codex exec` run each command in a session of its own, which the group kill misses, and the entry names this run's checkout only.\n   114\t\n   115\t### Decision D2\n   116\t- Basis: R5\n   117\tAn abandoned attempt is closed by the records a failed run writes (a run record and its receipt), released only when its marker is stalled and its owner proven dead. Nothing is deleted from the ledger, and older engines read the result as an ordinary failed run.\n   118\t\n   119\t## 6. Validation\n   120\t\n   121\t### Strategy\n   122\tEach requirement gets a regression test shown failing before its code.\n   123\t\n   124\t### Deterministic checks\n   125\t\n   126\t#### Test\n   127\t- Command: `go test ./...` (in `pose-mcp`), then `pose validate --carry`.\n   128\t\n   129\t### Execution log\n   130\t- 2026-11-24: implemented R1–R6. Each has a test that fails with its fix mutated out: the dispatch ends a process the adapter left in a session of its own (the test's leftover keeps writing into the runtime directory), the release records the failed run and receipt and removes the marker and its stall claim, a live owner is never released, and `review-brief/10` asks commands to finish while `/9` stays unchanged.\n   131\t- 2026-11-24: the containment record disclosed escaped-descendant termination as `unavailable`, and a regression test pinned that limitation. On Linux it is now `environment-marked` (ended while the descendant keeps the run's sealed-checkout entry, never `available`, so a profile that requires the full guarantee is still refused), the limitation text says so, and the test now proves the escaped child is ended with the run.\n   132\t- 2026-11-24: review round 1 (rrn-c5c082703d83c834) requested changes. N1: the reservation was published before the active marker, so a dispatch ended in between left an attempt nothing could release; the dispatch now marks the attempt active first and publishes the reservation after, and a stalled marker without a reservation is removed by the release. When marking itself fails, the dispatch still publishes the reservation and records the failed run and its receipt, keeping the contract of `pose-delegation-result-before-marker`. N2: `delegate ls` now names the abandonment cause and the release command, in text and JSON. N3: each process is pinned by a pidfd and its environment read again through it before SIGKILL, so a reused pid is never signalled. N4: a scan that cannot list `/proc` or read a process state fails; a process of this user whose environment cannot be read is counted and disclosed in the run record rather than skipped (L3). N5: the manual says the reaping is Linux-only. Each fix has a test that fails with it mutated out (N4's disclosure is not reproducible in a test: it needs a non-inspectable process).\n   133\t- 2026-11-24: review round 2 (rrn-2c9fa8ac47c2fbab) requested changes. N1: a reservation an earlier engine left without any marker is now listed by `delegate ls` and released by `cancel` once it has no marker, receipt or run and is older than ten minutes (an earlier engine marked within moments of reserving). N2: a non-inspectable process of this user that did not exist before the adapter started may be the run's, so the scan fails and the run stays unconcludable; ones that predate the run are skipped and disclosed. N3: a release claims the attempt exclusively, so two cancels never record two runs. N4: `TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns` interrupts a real dispatch after its reservation, sees the next dispatch refused with the release command, releases it and dispatches again. N5: a receipt that cannot be inspected is reported with its error. Each fix has a test that fails with it mutated out, except N5.\n   134\t- 2026-11-24: review round 3 (rrn-667b69e8c01c345c) requested changes. N1: the release claim records its owner; a claim whose owner is gone is taken over, and a release interrupted after recording its run completes with that run instead of recording another. N2: age proves nothing about a markerless reservation, so it is released only with `--confirm-abandoned`, the operator's assertion that no dispatch of it runs, which the recorded run states. N3: reservations and receipts that cannot be read are reported as losses by `delegate ls`. Each fix has a test that fails with it mutated out.\n   135\t\n   136\t\n   137\t### Results summary\n   138\tThe full `pose-mcp` suite passes; the canonical result is refreshed with `pose validate --carry`.\n   139\t\n   140\t\n   141\t### Requirement trace\n   142\t- R1 [satisfied] test:TestDispatchEndsWhatTheReviewerLeftRunning, test:TestAPidThatLostTheRunsEntryIsNotKilled, test:TestANonInspectableProcessStartedDuringTheRunFailsTheScan\n   143\t- R2 [satisfied] test:TestDispatchEndsWhatTheReviewerLeftRunning\n   144\t- R3 [satisfied] test:TestTheCurrentBriefAsksCommandsToFinish\n   145\t- R4 [satisfied] test:TestDispatchEndsWhatTheReviewerLeftRunning\n   146\t- R5 [satisfied] test:TestAnAbandonedAttemptIsReleasedWithARecord, test:TestTheAttemptIsMarkedActiveBeforeItIsReserved, test:TestAStalledMarkerWithoutReservationIsListedAndRemoved\n   147\t- R6 [satisfied] test:TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns, test:TestAMarkerlessReservationOfAnEarlierEngineIsReleased, test:TestAClaimedReleaseIsNotRunTwice, test:TestAnInterruptedReleaseCompletesWithItsRun, test:TestAnUnreadableReservationIsReportedAsALoss\n   148\t\n   149\t\n   150\t### Known gaps\n   151\tThe release is driven through the Store, including after a real interrupted dispatch; the thin `pose delegate cancel` branch that calls it is not driven through the CLI, because a stalled marker there needs a dispatch process killed and three silent heartbeat intervals. N5 (the receipt inspection error) has no test: making the receipt path uninspectable also makes the reservation unreadable first.\n   152\t\n   153\t\n   154\t## 7. Final Report\n   155\t\n   156\t### Delivered scope\n   157\tThe dispatch ends the processes a run left running before its cleanup and names them in the run record; `pose delegate cancel` releases an attempt abandoned before its run was recorded; `review-brief/10` asks the reviewer to let its commands finish.\n   158\t\n   159\t\n   160\t### Files and modules changed\n   161\t`pose-mcp` (review dispatch, attempt ledger, delegation CLI, brief), the manual in both locales and its embedded copies.\n   162\t\n   163\t\n   164\t### Validation executed\n   165\t`go test ./...` in `pose-mcp`; `pose check --strict`; `pose validate --carry --json-out .pose/results/delivery-validation.json`.\n   166\t\n   167\t\n   168\t### Residual risks\n   169\tL1: a process that clears its environment is not found; the cleanup inventory still fails that run. L2: outside Linux only the process-group kill applies. L4: a reservation an earlier engine left without a marker records no owner, so its release rests on the operator's confirmation, not on proof. L3: a process of this user that made itself non-inspectable cannot be matched: one that predates the run is skipped and counted in the run record, and one started during the run fails the cleanup, so such a run is not concludable.\n   170\t\n   171\t\n   172\t### Follow-ups\n   173\tNone.\n   174\t\n   175\t\n     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under an exclusive claim that records its owner; a claim\n    19\t// whose owner is gone is taken over, and a release interrupted after it\n    20\t// recorded the run completes it instead of recording another (N1).\n    21\t\n    22\timport (\n    23\t\t\"encoding/json\"\n    24\t\t\"errors\"\n    25\t\t\"fmt\"\n    26\t\t\"os\"\n    27\t\t\"path/filepath\"\n    28\t\t\"strings\"\n    29\t\t\"time\"\n    30\t)\n    31\t\n    32\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    33\t// proven abandoned.\n    34\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    35\t\n    36\t// reviewOrphanReservationAge is how old a reservation without any marker\n    37\t// must be to count as abandoned.\n    38\tconst reviewOrphanReservationAge = 10 * time.Minute\n    39\t\n    40\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    41\t// dispatch ended before recording it, and removes its stalled marker. A\n    42\t// stalled marker whose reservation was never published is only removed; the\n    43\t// returned run is then empty.\n    44\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    45\t\tif !validAttemptFileName(attemptID) {\n    46\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    47\t\t}\n    48\t\tmarkers, _, err := s.ListDelegationActive()\n    49\t\tif err != nil {\n    50\t\t\treturn ReviewRun{}, err\n    51\t\t}\n    52\t\tvar marker *DelegationActiveRun\n    53\t\tfor i := range markers {\n    54\t\t\tif markers[i].AttemptID == attemptID {\n    55\t\t\t\tmarker = &markers[i]\n    56\t\t\t}\n    57\t\t}\n    58\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    59\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    60\t\t}\n    61\t\tdir, err := s.delegationActiveDir(true)\n    62\t\tif err != nil {\n    63\t\t\treturn ReviewRun{}, err\n    64\t\t}\n    65\t\tclaim := filepath.Join(dir, attemptID+\".release\")\n    66\t\tif err := claimAttemptRelease(claim, now); err != nil {\n    67\t\t\treturn ReviewRun{}, err\n    68\t\t}\n    69\t\trun, err := s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    70\t\tif rerr := os.Remove(claim); rerr != nil && !errors.Is(rerr, os.ErrNotExist) && err == nil {\n    71\t\t\terr = rerr\n    72\t\t}\n    73\t\treturn run, err\n    74\t}\n    75\t\n    76\t// claimAttemptRelease publishes the release claim with its owner. A claim\n    77\t// whose owner is proven gone is an interrupted release and is taken over.\n    78\tfunc claimAttemptRelease(claim string, now time.Time) error {\n    79\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"release:\" + filepath.Base(claim), Operation: \"pose delegate cancel\", PID: os.Getpid(), AcquiredAt: now.UTC().Format(time.RFC3339Nano)}\n    80\t\towner.Host, _ = os.Hostname()\n    81\t\tidentifyStartLockProcess(&owner)\n    82\t\traw, _ := json.Marshal(owner)\n    83\t\tpublish := func() error {\n    84\t\t\treturn PublishFile(claim, append(raw, '\\n'), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n    85\t\t}\n    86\t\tif publish() == nil {\n    87\t\t\treturn nil\n    88\t\t}\n    89\t\theld, err := os.ReadFile(claim)\n    90\t\tif err != nil {\n    91\t\t\treturn fmt.Errorf(\"%w: the release claim %s cannot be read: %v\", ErrAttemptNotAbandoned, claim, err)\n    92\t\t}\n    93\t\tvar previous StartLockOwner\n    94\t\tif json.Unmarshal(held, &previous) != nil {\n    95\t\t\treturn fmt.Errorf(\"%w: the release claim %s is not one this engine reads\", ErrAttemptNotAbandoned, claim)\n    96\t\t}\n    97\t\tif liveness, detail := probeStartLockOwner(previous); liveness != LockOwnerDead {\n    98\t\t\treturn fmt.Errorf(\"%w: another release of it is in progress (%s)\", ErrAttemptNotAbandoned, detail)\n    99\t\t}\n   100\t\tif err := PublishFile(claim, append(raw, '\\n'), 0600, PublishAuthoritative, ExpectBytes(held, true)); err != nil {\n   101\t\t\treturn fmt.Errorf(\"%w: another release took over the claim %s\", ErrAttemptNotAbandoned, claim)\n   102\t\t}\n   103\t\treturn nil\n   104\t}\n   105\t\n   106\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n   107\t\tvar reserved *DelegatedReviewAttempt\n   108\t\tif marker != nil {\n   109\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n   110\t\t\tif err != nil {\n   111\t\t\t\treturn ReviewRun{}, err\n   112\t\t\t}\n   113\t\t\tfor i := range attempts {\n   114\t\t\t\tif attempts[i].AttemptID == attemptID {\n   115\t\t\t\t\treserved = &attempts[i]\n   116\t\t\t\t}\n   117\t\t\t}\n   118\t\t\tif reserved == nil {\n   119\t\t\t\t// The dispatch ended between its marker and its reservation:\n   120\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n   121\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n   122\t\t\t}\n   123\t\t} else {\n   124\t\t\tif !operatorConfirmed {\n   125\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n   126\t\t\t}\n   127\t\t\torphans, _, err := s.orphanReservations(now)\n   128\t\t\tif err != nil {\n   129\t\t\t\treturn ReviewRun{}, err\n   130\t\t\t}\n   131\t\t\tfor i := range orphans {\n   132\t\t\t\tif orphans[i].AttemptID == attemptID {\n   133\t\t\t\t\treserved = &orphans[i]\n   134\t\t\t\t}\n   135\t\t\t}\n   136\t\t\tif reserved == nil {\n   137\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   138\t\t\t}\n   139\t\t}\n   140\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   141\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   142\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   143\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   144\t\t}\n   145\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   146\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   147\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   148\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   149\t\tif marker != nil {\n   150\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   151\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   152\t\t} else {\n   153\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   154\t\t}\n   155\t\t// A release interrupted after recording the run completes with that run.\n   156\t\trecorded, found, err := s.recordedAbandonmentRun(*reserved)\n   157\t\tif err != nil {\n   158\t\t\treturn ReviewRun{}, err\n   159\t\t}\n   160\t\tif !found {\n   161\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   162\t\t\t\treturn ReviewRun{}, err\n   163\t\t\t}\n   164\t\t}\n   165\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   166\t\t\treturn recorded, err\n   167\t\t}\n   168\t\tif marker != nil {\n   169\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   170\t\t}\n   171\t\treturn recorded, nil\n   172\t}\n   173\t\n   174\t// recordedAbandonmentRun finds the failed run an interrupted release of a\n   175\t// recorded for it.\n   176\tfunc (s Store) recordedAbandonmentRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   177\t\truns, _, err := s.ReadReviewRuns(a.BundleID)\n   178\t\tif err != nil {\n   179\t\t\treturn ReviewRun{}, false, err\n   180\t\t}\n   181\t\tfor _, r := range runs {\n   182\t\t\tif r.AttemptID == a.AttemptID && r.Status == ReviewRunFailed && strings.HasPrefix(r.Failure, DelegationAbandonedCause) {\n   183\t\t\t\treturn r, true, nil\n   184\t\t\t}\n   185\t\t}\n   186\t\treturn ReviewRun{}, false, nil\n   187\t}\n   188\t\n   189\t// orphanReservations lists the reservations an earlier engine left without\n   190\t// a receipt, a marker or a run, older than reviewOrphanReservationAge, and\n   191\t// says which reservations or receipts it could not read (review round 3, N3).\n   192\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   193\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   194\t\tdirs, err := os.ReadDir(base)\n   195\t\tif errors.Is(err, os.ErrNotExist) {\n   196\t\t\treturn nil, nil, nil\n   197\t\t}\n   198\t\tif err != nil {\n   199\t\t\treturn nil, nil, err\n   200\t\t}\n   201\t\tmarkers, _, err := s.ListDelegationActive()\n   202\t\tif err != nil {\n   203\t\t\treturn nil, nil, err\n   204\t\t}\n   205\t\tmarked := map[string]bool{}\n   206\t\tfor _, m := range markers {\n   207\t\t\tmarked[m.AttemptID] = true\n   208\t\t}\n   209\t\truns, _, err := s.ReadReviewRuns(\"\")\n   210\t\tif err != nil {\n   211\t\t\treturn nil, nil, err\n   212\t\t}\n   213\t\tran := map[string]bool{}\n   214\t\tfor _, r := range runs {\n   215\t\t\tran[r.AttemptID] = true\n   216\t\t}\n   217\t\tvar out []DelegatedReviewAttempt\n   218\t\tvar lost []string\n   219\t\tbudget := reviewReadBudget(nil)\n   220\t\tfor _, d := range dirs {\n   221\t\t\tif !d.IsDir() {\n   222\t\t\t\tcontinue\n   223\t\t\t}\n   224\t\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n   225\t\t\tif err != nil {\n   226\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   227\t\t\t\tcontinue\n   228\t\t\t}\n   229\t\t\tfor _, e := range entries {\n   230\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   231\t\t\t\t\tcontinue\n   232\t\t\t\t}\n   233\t\t\t\tvar a DelegatedReviewAttempt\n   234\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   235\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   236\t\t\t\t\tcontinue\n   237\t\t\t\t}\n   238\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   239\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   240\t\t\t\t\tcontinue\n   241\t\t\t\t}\n   242\t\t\t\tif marked[a.AttemptID] || ran[a.AttemptID] {\n   243\t\t\t\t\tcontinue\n   244\t\t\t\t}\n   245\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   246\t\t\t\t\tcontinue\n   247\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   248\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   249\t\t\t\t\tcontinue\n   250\t\t\t\t}\n   251\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   252\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   253\t\t\t\t\tcontinue\n   254\t\t\t\t}\n   255\t\t\t\tout = append(out, a)\n   256\t\t\t}\n   257\t\t}\n   258\t\treturn out, lost, nil\n   259\t}\n   260\t\n","exit_code":0,"status":"completed"}}
