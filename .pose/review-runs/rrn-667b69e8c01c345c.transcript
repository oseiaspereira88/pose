{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_active.go | sed -n '230,315p'; nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '755,815p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '420,490p'\"","aggregated_output":"   230\t\t\treturn false\n   231\t\t}\n   232\t\t_, err := hex.DecodeString(token)\n   233\t\treturn err == nil\n   234\t}\n   235\t\n   236\t// ListDelegationActive reads the markers with the liveness of their owners,\n   237\t// and returns as losses the markers it cannot read: a run it cannot observe is\n   238\t// reported, never listed as running nor left out in silence.\n   239\tfunc (s Store) ListDelegationActive() ([]DelegationActiveRun, []string, error) {\n   240\t\tdir, err := s.delegationActiveDir(false)\n   241\t\tif errors.Is(err, os.ErrNotExist) {\n   242\t\t\treturn []DelegationActiveRun{}, nil, nil\n   243\t\t}\n   244\t\tif err != nil {\n   245\t\t\treturn nil, nil, err\n   246\t\t}\n   247\t\tentries, err := os.ReadDir(dir)\n   248\t\tif err != nil {\n   249\t\t\treturn nil, nil, err\n   250\t\t}\n   251\t\tout := []DelegationActiveRun{}\n   252\t\tvar lost []string\n   253\t\tfor _, e := range entries {\n   254\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   255\t\t\t\tcontinue\n   256\t\t\t}\n   257\t\t\traw, err := readLedgerRaw(filepath.Join(dir, e.Name()))\n   258\t\t\tif errors.Is(err, os.ErrNotExist) {\n   259\t\t\t\tcontinue // the run ended between the listing and the read\n   260\t\t\t}\n   261\t\t\tif err != nil {\n   262\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" could not be read: \"+err.Error())\n   263\t\t\t\tcontinue\n   264\t\t\t}\n   265\t\t\tvar marker DelegationActiveRun\n   266\t\t\tif json.Unmarshal(raw, &marker) != nil || marker.SchemaVersion != 1 || marker.AttemptID+\".json\" != e.Name() || !validRunToken(marker.RunToken) {\n   267\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" is not one this engine reads\")\n   268\t\t\t\tcontinue\n   269\t\t\t}\n   270\t\t\tmarker.Liveness, marker.Detail = probeStartLockOwner(marker.Owner)\n   271\t\t\tmarker.StalledAt = readDelegationStall(dir, marker)\n   272\t\t\tif marker.StalledAt == \"\" && delegationMarkerSilent(marker, time.Now()) && marker.Liveness == LockOwnerDead {\n   273\t\t\t\tmarker.StalledAt = recordDelegationStall(dir, marker)\n   274\t\t\t}\n   275\t\t\tif _, err := os.Lstat(cancelRequestPath(dir, marker)); err == nil {\n   276\t\t\t\tmarker.CancelRequested = true\n   277\t\t\t}\n   278\t\t\tout = append(out, marker)\n   279\t\t}\n   280\t\tsort.Slice(out, func(i, j int) bool {\n   281\t\t\treturn out[i].StartedAt < out[j].StartedAt || out[i].StartedAt == out[j].StartedAt && out[i].AttemptID < out[j].AttemptID\n   282\t\t})\n   283\t\treturn out, lost, nil\n   284\t}\n   285\t\n   286\t// ErrDelegationNotActive means no running run matches.\n   287\tvar ErrDelegationNotActive = errors.New(\"pose: the run is not running\")\n   288\t\n   289\t// RequestDelegationCancel asks the process running attempt to stop. A marker\n   290\t// whose owner is proven dead is not cancelled: nothing runs to stop.\n   291\tfunc (s Store) RequestDelegationCancel(attempt string) (DelegationActiveRun, error) {\n   292\t\tactive, _, err := s.ListDelegationActive()\n   293\t\tif err != nil {\n   294\t\t\treturn DelegationActiveRun{}, err\n   295\t\t}\n   296\t\tfor _, marker := range active {\n   297\t\t\tif marker.AttemptID != attempt {\n   298\t\t\t\tcontinue\n   299\t\t\t}\n   300\t\t\tif marker.Liveness == LockOwnerDead {\n   301\t\t\t\treturn marker, fmt.Errorf(\"pose: the process of attempt %s is gone (%s); nothing runs to cancel\", attempt, marker.Detail)\n   302\t\t\t}\n   303\t\t\tdir, err := s.delegationActiveDir(false)\n   304\t\t\tif err != nil {\n   305\t\t\t\treturn marker, err\n   306\t\t\t}\n   307\t\t\trequest := cancelRequestPath(dir, marker)\n   308\t\t\tif err := PublishFile(request, []byte(time.Now().UTC().Format(time.RFC3339Nano)+\"\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil && !errors.Is(err, os.ErrExist) {\n   309\t\t\t\tif _, statErr := os.Lstat(request); statErr != nil {\n   310\t\t\t\t\treturn marker, err\n   311\t\t\t\t}\n   312\t\t\t}\n   313\t\t\t// The run may have ended between the read and the request: a request\n   314\t\t\t// that names no running run is withdrawn, never left for a successor.\n   315\t\t\tif !s.DelegationRunActive(marker) {\n   755\t\t\t\treturn\n   756\t\t\t}\n   757\t\t\tresultPublished = true\n   758\t\t\tbeforeRunResultPublished(result)\n   759\t\t\tvar err error\n   760\t\t\tif plan.predecessor == nil {\n   761\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   762\t\t\t} else {\n   763\t\t\t\terr = s.finishReviewContinuation(result)\n   764\t\t\t}\n   765\t\t\tif err != nil {\n   766\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n   767\t\t\t}\n   768\t\t}\n   769\t\tdefer publishResult()\n   770\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n   771\t\tif err != nil {\n   772\t\t\tif plan.predecessor == nil {\n   773\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n   774\t\t\t\t// receipt are recorded against it, as before the marker moved\n   775\t\t\t\t// ahead of the reservation (spec\n   776\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n   777\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n   778\t\t\t\t\treturn ReviewRun{}, perr\n   779\t\t\t\t}\n   780\t\t\t\treserved = true\n   781\t\t\t}\n   782\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   783\t\t}\n   784\t\tif plan.predecessor == nil {\n   785\t\t\tbeforeAttemptPublished(s, attempt)\n   786\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n   787\t\t\t\tstopActive()\n   788\t\t\t\treturn ReviewRun{}, err\n   789\t\t\t}\n   790\t\t\treserved = true\n   791\t\t}\n   792\t\t// The marker goes only once the record and the attempt result are\n   793\t\t// published: without them it is the one trace of the reserved attempt,\n   794\t\t// and a waiter that sees it gone must find the receipt.\n   795\t\tdefer func() {\n   796\t\t\tpublishResult()\n   797\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n   798\t\t}()\n   799\t\tcancelled = cancelFlag\n   800\t\t// A detached run that cannot hand its attempt back stops here: nobody\n   801\t\t// would know which attempt runs (R1).\n   802\t\tif plan.OnStart != nil {\n   803\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n   804\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n   805\t\t\t}\n   806\t\t}\n   807\t\ttmp, err := os.MkdirTemp(\"\", \"pose-review-run-*\")\n   808\t\tif err != nil {\n   809\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n   810\t\t}\n   811\t\tsafety.RuntimeID = filepath.Base(tmp)\n   812\t\towned, err := os.Lstat(tmp)\n   813\t\tif err != nil {\n   814\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n   815\t\t}\n   420\t// prepareDelegatedReviewAttempt admits and builds the next reservation of\n   421\t// the bundle without publishing it.\n   422\tfunc (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n   423\t\tattempts, _, err := s.reviewAttemptAdmission(plan)\n   424\t\tif err != nil {\n   425\t\t\treturn DelegatedReviewAttempt{}, err\n   426\t\t}\n   427\t\tnonce := make([]byte, 16)\n   428\t\tif _, err := rand.Read(nonce); err != nil {\n   429\t\t\treturn DelegatedReviewAttempt{}, err\n   430\t\t}\n   431\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n   432\t\ta.AttemptID = attemptIdentity(a)\n   433\t\treturn a, nil\n   434\t}\n   435\t\n   436\t// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n   437\t// marks the attempt active first, so a dispatch that ends after this point\n   438\t// always leaves a marker that turns stalled and that `pose delegate cancel`\n   439\t// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n   440\t// review round 1, N1).\n   441\tfunc (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n   442\t\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n   443\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n   444\t\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n   445\t\t}\n   446\t\treturn nil\n   447\t}\n   448\tfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n   449\t\traw, _ := json.Marshal(run)\n   450\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n   451\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n   452\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n   453\t}\n   454\t\n   455\t// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n   456\t// exists for legacy records; their content identity remains independently checked.\n   457\tfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n   458\t\tbudget := int64(32 << 20)\n   459\t\treturn s.reviewRunLedgerFindings(bundle, &budget)\n   460\t}\n   461\tfunc (s Store) reviewRunLedgerFindings(bundle string, budget *int64) ([]string, error) {\n   462\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, reviewRunLedgerDir)\n   463\t\tif err != nil {\n   464\t\t\treturn nil, err\n   465\t\t}\n   466\t\tfindings := []string{}\n   467\t\tvar checkedBytes int64\n   468\t\tfor _, e := range entries {\n   469\t\t\tif IsPublisherStaging(e.Name()) {\n   470\t\t\t\tcontinue\n   471\t\t\t}\n   472\t\t\tvar w reviewRunWitness\n   473\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunLedgerDir, e.Name()), &w, budget); err != nil {\n   474\t\t\t\tfindings = append(findings, err.Error())\n   475\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   476\t\t\t\t\tbreak\n   477\t\t\t\t}\n   478\t\t\t\tcontinue\n   479\t\t\t}\n   480\t\t\tif w.SchemaVersion != 1 || e.Name() != w.RunID+\".json\" || strings.ContainsAny(w.RunID, \"/\\\\\") {\n   481\t\t\t\tfindings = append(findings, \"invalid run witness \"+e.Name())\n   482\t\t\t\tcontinue\n   483\t\t\t}\n   484\t\t\tvar run ReviewRun\n   485\t\t\traw, readErr := readLedgerRawBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, w.RunID+\".json\"), budget)\n   486\t\t\tif readErr != nil {\n   487\t\t\t\tfindings = append(findings, \"witnessed run \"+w.RunID+\": \"+readErr.Error())\n   488\t\t\t\tif errors.Is(readErr, errReviewLedgerBudget) {\n   489\t\t\t\t\tbreak\n   490\t\t\t\t}\n","exit_code":0,"status":"completed"}}
