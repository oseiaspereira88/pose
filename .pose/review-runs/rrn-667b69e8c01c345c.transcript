                    |   78 +-\n pose-mcp/internal/cli/assess_sealed_test.go        |  107 +\n pose-mcp/internal/cli/delegate.go                  |   24 +\n pose-mcp/internal/cli/help_catalog.go              |    6 +-\n pose-mcp/internal/cli/review_reap_test.go          |   59 +\n pose-mcp/internal/pose/assessment_sealed.go        |   20 +\n pose-mcp/internal/pose/assessment_sealed_test.go   |   62 +\n pose-mcp/internal/pose/delegation_list.go          |   23 +\n pose-mcp/internal/pose/delegation_release.go       |  204 ++\n pose-mcp/internal/pose/delegation_release_test.go  |  281 ++\n pose-mcp/internal/pose/discovery.go                |   12 +\n pose-mcp/internal/pose/integration.go              |    3 +\n .../internal/pose/review_adapter_containment.go    |   10 +\n .../review_adapter_containment_regression_test.go  |   19 +-\n pose-mcp/internal/pose/review_attempt_ledger.go    |   30 +-\n pose-mcp/internal/pose/review_brief.go             |   35 +-\n .../pose/review_brief_conclusion_rules_test.go     |   34 +-\n pose-mcp/internal/pose/review_brief_test.go        |    2 +-\n pose-mcp/internal/pose/review_dispatch.go          |   42 +-\n pose-mcp/internal/pose/review_plan.go              |    6 +-\n pose-mcp/internal/pose/review_reap_linux.go        |  213 ++\n pose-mcp/internal/pose/review_reap_linux_test.go   |   90 +\n pose-mcp/internal/pose/review_reap_other.go        |    9 +\n pose-mcp/internal/pose/techdebt.go                 |    3 +\n .../testdata/review_brief_template_digests.json    |    4 +-\n pose-mcp/internal/scaffold/dist/POSE.md            |    8 +-\n .../internal/scaffold/dist/locales/pt-BR/POSE.md   |    8 +-\n 82 files changed, 22273 insertions(+), 2362 deletions(-)\n","exit_code":0,"status":"completed"}}
