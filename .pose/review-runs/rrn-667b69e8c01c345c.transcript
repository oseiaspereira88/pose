{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux.go | sed -n '205,250p'; nl -ba pose-mcp/internal/pose/review_reap_linux_test.go | sed -n '1,160p'; nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '185,300p'; nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '132,205p'\"","aggregated_output":"   205\t}\n   206\t\n   207\t// reviewOpaqueProcessBaseline records, before the adapter starts, the\n   208\t// processes of this user whose environment cannot be read, by pid and start\n   209\t// time: they cannot be the run's.\n   210\tfunc reviewOpaqueProcessBaseline() map[int]string {\n   211\t\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv + \"=\\x00\"))\n   212\t\treturn opaque\n   213\t}\n     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os/exec\"\n     7\t\t\"strings\"\n     8\t\t\"testing\"\n     9\t\t\"time\"\n    10\t)\n    11\t\n    12\t// Review round 1, N3: a pid that no longer names a process of the run, as\n    13\t// after reuse by an unrelated process, is never signalled.\n    14\tfunc TestAPidThatLostTheRunsEntryIsNotKilled(t *testing.T) {\n    15\t\tother := exec.Command(\"sleep\", \"30\")\n    16\t\tif err := other.Start(); err != nil {\n    17\t\t\tt.Fatal(err)\n    18\t\t}\n    19\t\tfor i := 0; i < 200 && reviewProcessName(other.Process.Pid) != \"sleep\"; i++ {\n    20\t\t\ttime.Sleep(10 * time.Millisecond)\n    21\t\t}\n    22\t\tt.Cleanup(func() { _ = other.Process.Kill(); _ = other.Wait() })\n    23\t\tentry := []byte(SealedCheckoutEnv + \"=/nonexistent/run-checkout\")\n    24\t\tif err := killPinnedMarkedProcess(other.Process.Pid, entry); err != nil {\n    25\t\t\tt.Fatal(err)\n    26\t\t}\n    27\t\ttime.Sleep(100 * time.Millisecond)\n    28\t\tif zombie, err := reviewProcessZombie(other.Process.Pid); err != nil || zombie {\n    29\t\t\tt.Fatalf(\"a process without the run's entry was killed: zombie=%t %v\", zombie, err)\n    30\t\t}\n    31\t\t// The same process carrying the entry is ended.\n    32\t\tmarked := exec.Command(\"sleep\", \"30\")\n    33\t\tmarked.Env = append(marked.Environ(), string(entry))\n    34\t\tif err := marked.Start(); err != nil {\n    35\t\t\tt.Fatal(err)\n    36\t\t}\n    37\t\t// Until exec, /proc shows the parent's environment.\n    38\t\tfor i := 0; i < 200; i++ {\n    39\t\t\tif ok, _ := reviewProcessMarked(marked.Process.Pid, entry); ok {\n    40\t\t\t\tbreak\n    41\t\t\t}\n    42\t\t\ttime.Sleep(10 * time.Millisecond)\n    43\t\t}\n    44\t\tif err := killPinnedMarkedProcess(marked.Process.Pid, entry); err != nil {\n    45\t\t\tt.Fatal(err)\n    46\t\t}\n    47\t\tif err := marked.Wait(); err == nil {\n    48\t\t\tt.Fatal(\"the marked process was not ended\")\n    49\t\t}\n    50\t}\n    51\t\n    52\t// opaqueProcess starts a process of this user whose environment cannot be\n    53\t// read (it makes itself non-dumpable), or skips without python3.\n    54\tfunc opaqueProcess(t *testing.T) *exec.Cmd {\n    55\t\tt.Helper()\n    56\t\tif _, err := exec.LookPath(\"python3\"); err != nil {\n    57\t\t\tt.Skip(\"python3 is not available\")\n    58\t\t}\n    59\t\tcmd := exec.Command(\"python3\", \"-c\", \"import ctypes,time; ctypes.CDLL(None).prctl(4,0,0,0,0); time.sleep(30)\")\n    60\t\tif err := cmd.Start(); err != nil {\n    61\t\t\tt.Fatal(err)\n    62\t\t}\n    63\t\tt.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })\n    64\t\tfor i := 0; i < 300; i++ {\n    65\t\t\tif _, err := reviewProcessMarked(cmd.Process.Pid, []byte(\"x\")); err != nil && !reviewProcessGoneErr(err) {\n    66\t\t\t\treturn cmd\n    67\t\t\t}\n    68\t\t\ttime.Sleep(10 * time.Millisecond)\n    69\t\t}\n    70\t\tt.Skip(\"the process never became non-inspectable\")\n    71\t\treturn nil\n    72\t}\n    73\t\n    74\t// Review round 2, N2: a non-inspectable process that existed before the run\n    75\t// is not the run's; one that started during it may be, and the scan fails\n    76\t// instead of reporting the run's processes ended.\n    77\tfunc TestANonInspectableProcessStartedDuringTheRunFailsTheScan(t *testing.T) {\n    78\t\tbefore := opaqueProcess(t)\n    79\t\tbaseline := reviewOpaqueProcessBaseline()\n    80\t\tif _, ok := baseline[before.Process.Pid]; !ok {\n    81\t\t\tt.Fatalf(\"the baseline misses process %d\", before.Process.Pid)\n    82\t\t}\n    83\t\tif _, opaque, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err != nil || opaque == 0 {\n    84\t\t\tt.Fatalf(\"a process that predates the run failed the scan or was not counted: %d %v\", opaque, err)\n    85\t\t}\n    86\t\tduring := opaqueProcess(t)\n    87\t\tif _, _, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err == nil || !strings.Contains(err.Error(), \"started during the run\") {\n    88\t\t\tt.Fatalf(\"process %d, started during the run, did not fail the scan: %v\", during.Process.Pid, err)\n    89\t\t}\n    90\t}\n   185\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   186\t\tmarker.Owner.PID, marker.HeartbeatAt, marker.StartedAt = dead.Process.Pid, old, old\n   187\t\traw, _ = json.Marshal(marker)\n   188\t\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n   189\t\t\tt.Fatal(err)\n   190\t\t}\n   191\t}\n   192\t\n   193\t// Review round 2, N4 (R6): a real dispatch interrupted after its reservation\n   194\t// and before its run record blocks the next dispatch; once released, the\n   195\t// next dispatch runs.\n   196\tfunc TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns(t *testing.T) {\n   197\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   198\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   199\t\tif err != nil {\n   200\t\t\tt.Fatal(err)\n   201\t\t}\n   202\t\tattempt := \"\"\n   203\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   204\t\tfunc() {\n   205\t\t\tdefer func() { _ = recover() }()\n   206\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   207\t\t}()\n   208\t\tif attempt == \"\" {\n   209\t\t\tt.Fatal(\"the dispatch never reached its start\")\n   210\t\t}\n   211\t\twriteDeadMarker(t, f.store, attempt)\n   212\t\tif _, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after interruption\"); err == nil || !strings.Contains(err.Error(), \"pose delegate cancel \"+attempt) {\n   213\t\t\tt.Fatalf(\"the interrupted attempt did not block the bundle with its release command: %v\", err)\n   214\t\t}\n   215\t\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now()); err != nil {\n   216\t\t\tt.Fatal(err)\n   217\t\t}\n   218\t\tnext, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\")\n   219\t\tif err != nil {\n   220\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n   221\t\t}\n   222\t\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n   223\t\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n   224\t\t}\n   225\t}\n   226\t\n   227\t// Review round 2, N3: a release already claimed is not run again.\n   228\tfunc TestAClaimedReleaseIsNotRunTwice(t *testing.T) {\n   229\t\troot := t.TempDir()\n   230\t\ts := Store{Root: root}\n   231\t\tattempt := \"rat-\" + strings.Repeat(\"9\", 64)\n   232\t\tdir, _ := s.delegationActiveDir(true)\n   233\t\tif err := os.WriteFile(filepath.Join(dir, attempt+\".release\"), []byte(\"x\\n\"), 0o600); err != nil {\n   234\t\t\tt.Fatal(err)\n   235\t\t}\n   236\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now()); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\n   237\t\t\tt.Fatalf(\"a claimed release ran again: %v\", err)\n   238\t\t}\n   239\t}\n   240\t\n   241\t// Review round 2, N1: a reservation an earlier engine left with no marker is\n   242\t// listed and released once it is old enough, never while it is young.\n   243\tfunc TestAMarkerlessReservationOfAnEarlierEngineIsReleased(t *testing.T) {\n   244\t\troot := t.TempDir()\n   245\t\ts := Store{Root: root}\n   246\t\treserve := func(age time.Duration, nonce string) DelegatedReviewAttempt {\n   247\t\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000b\" + nonce[:1], BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   248\t\t\t\tReservedAt: time.Now().Add(-age).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(nonce[:1], 32)}\n   249\t\t\ta.AttemptID = attemptIdentity(a)\n   250\t\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   251\t\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   252\t\t\t\tt.Fatal(err)\n   253\t\t\t}\n   254\t\t\treturn a\n   255\t\t}\n   256\t\told, young := reserve(time.Hour, \"1\"), reserve(time.Minute, \"2\")\n   257\t\tattempts, _, err := s.ListDelegationAttempts()\n   258\t\tif err != nil {\n   259\t\t\tt.Fatal(err)\n   260\t\t}\n   261\t\tlisted := map[string]DelegationAttempt{}\n   262\t\tfor _, a := range attempts {\n   263\t\t\tlisted[a.AttemptID] = a\n   264\t\t}\n   265\t\tif a, ok := listed[old.AttemptID]; !ok || a.State != DelegationStalled || !strings.Contains(a.Failure, \"pose delegate cancel \"+old.AttemptID) {\n   266\t\t\tt.Fatalf(\"the old markerless reservation is not listed with its release: %+v\", attempts)\n   267\t\t}\n   268\t\tif _, ok := listed[young.AttemptID]; ok {\n   269\t\t\tt.Fatal(\"a young reservation was listed as abandoned\")\n   270\t\t}\n   271\t\tif _, err := s.ReleaseAbandonedAttempt(young.AttemptID, time.Now()); !errors.Is(err, ErrAttemptNotAbandoned) {\n   272\t\t\tt.Fatalf(\"a young reservation was released: %v\", err)\n   273\t\t}\n   274\t\trun, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now())\n   275\t\tif err != nil || run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"earlier engine\") {\n   276\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   277\t\t}\n   278\t\tif _, err := s.readAttemptReceipt(old); err != nil {\n   279\t\t\tt.Fatalf(\"the released reservation still blocks its bundle: %v\", err)\n   280\t\t}\n   281\t}\n   132\t// orphanReservations lists the reservations an earlier engine left without\n   133\t// a receipt, a marker or a run, older than reviewOrphanReservationAge.\n   134\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, error) {\n   135\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   136\t\tdirs, err := os.ReadDir(base)\n   137\t\tif errors.Is(err, os.ErrNotExist) {\n   138\t\t\treturn nil, nil\n   139\t\t}\n   140\t\tif err != nil {\n   141\t\t\treturn nil, err\n   142\t\t}\n   143\t\tmarkers, _, err := s.ListDelegationActive()\n   144\t\tif err != nil {\n   145\t\t\treturn nil, err\n   146\t\t}\n   147\t\tmarked := map[string]bool{}\n   148\t\tfor _, m := range markers {\n   149\t\t\tmarked[m.AttemptID] = true\n   150\t\t}\n   151\t\truns, _, err := s.ReadReviewRuns(\"\")\n   152\t\tif err != nil {\n   153\t\t\treturn nil, err\n   154\t\t}\n   155\t\tran := map[string]bool{}\n   156\t\tfor _, r := range runs {\n   157\t\t\tran[r.AttemptID] = true\n   158\t\t}\n   159\t\tvar out []DelegatedReviewAttempt\n   160\t\tbudget := reviewReadBudget(nil)\n   161\t\tfor _, d := range dirs {\n   162\t\t\tif !d.IsDir() {\n   163\t\t\t\tcontinue\n   164\t\t\t}\n   165\t\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n   166\t\t\tif err != nil {\n   167\t\t\t\treturn nil, err\n   168\t\t\t}\n   169\t\t\tfor _, e := range entries {\n   170\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   171\t\t\t\t\tcontinue\n   172\t\t\t\t}\n   173\t\t\t\tvar a DelegatedReviewAttempt\n   174\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil || a.AttemptID != attemptIdentity(a) {\n   175\t\t\t\t\tcontinue\n   176\t\t\t\t}\n   177\t\t\t\tif marked[a.AttemptID] || ran[a.AttemptID] {\n   178\t\t\t\t\tcontinue\n   179\t\t\t\t}\n   180\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); !errors.Is(err, os.ErrNotExist) {\n   181\t\t\t\t\tcontinue\n   182\t\t\t\t}\n   183\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   184\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   185\t\t\t\t\tcontinue\n   186\t\t\t\t}\n   187\t\t\t\tout = append(out, a)\n   188\t\t\t}\n   189\t\t}\n   190\t\treturn out, nil\n   191\t}\n   192\t\n   193\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   194\t\tdir, err := s.delegationActiveDir(false)\n   195\t\tif err != nil {\n   196\t\t\treturn err\n   197\t\t}\n   198\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   199\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   200\t\t\t\treturn err\n   201\t\t\t}\n   202\t\t}\n   203\t\treturn nil\n   204\t}\n","exit_code":0,"status":"completed"}}
