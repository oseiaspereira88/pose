dexes.\n    75\t\tindexPin *IndexGenerationView\n    76\t\t// FS is the filesystem of the operation this store serves (spec\n    77\t\t// pose-update-dry-run-reports-the-whole-update D2): nil reads and writes\n    78\t\t// the disk, a preview reads its staged view. A store built from this one\n    79\t\t// carries it on.\n    80\t\tFS Files\n    81\t\t// planWithoutCloseoutGate builds a review plan without asking the\n    82\t\t// closeout review gate, for the gate's own question about the plan's\n    83\t\t// effective independence (spec pose-closeout-review-policy-by-cost-benefit).\n    84\t\tplanWithoutCloseoutGate bool\n    85\t}\n    86\t\n    87\t// fsys is the store's filesystem.\n    88\tfunc (s Store) fsys() Files { return FilesOrNative(s.FS) }\n    89\t\n    90\t// specSnapshot holds one read of the specs directory. GetSpec lists every\n    91\t// spec to find one, and the obligation producers call it per spec, so a\n    92\t// projection read every spec file once per spec per producer.\n    93\ttype specSnapshot struct {\n    94\t\tonce  sync.Once\n    95\t\tspecs []Spec\n    96\t\terr   error\n    97\t\t// bundleScopes maps a review bundle file to the scope its payload names,\n    98\t\t// read once per operation; ListReviewBundles otherwise decodes every\n    99\t\t// bundle for every scoped call.\n   100\t\tbundleScopes sync.Map\n     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"context\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"path/filepath\"\n    12\t\t\"strings\"\n    13\t\t\"testing\"\n    14\t\t\"time\"\n    15\t)\n    16\t\n    17\t// Spec pose-review-run-reaps-lingering-reviewer-processes R5, R6: a dispatch\n    18\t// that ended between its reservation and its run record leaves an attempt\n    19\t// that blocks the bundle; once its owner is proven gone, cancel releases it\n    20\t// with a failed run and its receipt, and the ledger reads again.\n    21\tfunc TestAnAbandonedAttemptIsReleasedWithARecord(t *testing.T) {\n    22\t\troot := t.TempDir()\n    23\t\ts := Store{Root: root}\n    24\t\tbundle := \"rvb-00000000000000a1\"\n    25\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n    26\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"0\", 32)}\n    27\t\ta.AttemptID = attemptIdentity(a)\n    28\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    29\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    30\t\t\tt.Fatal(err)\n    31\t\t}\n    32\t\t// The ledger refuses the bundle while the reservation has no receipt.\n    33\t\tif _, err := s.readAttemptReceipt(a); err == nil || !strings.Contains(err.Error(), \"incomplete or unreadable\") {\n    34\t\t\tt.Fatalf(\"an unfinished reservation read as finished: %v\", err)\n    35\t\t}\n    36\t\n    37\t\t// The marker the interrupted dispatch left: its owner is a process that\n    38\t\t// has exited.\n    39\t\tdead := exec.Command(\"true\")\n    40\t\tif err := dead.Run(); err != nil {\n    41\t\t\tt.Fatal(err)\n    42\t\t}\n    43\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    44\t\towner.Host, _ = os.Hostname()\n    45\t\tidentifyStartLockProcess(&owner)\n    46\t\towner.PID = dead.Process.Pid\n    47\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"b\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: a.Scope, BundleID: bundle,\n    48\t\t\tStartedAt: a.ReservedAt, Owner: owner, HeartbeatAt: a.ReservedAt, HeartbeatEvery: 10}\n    49\t\tdir, err := s.delegationActiveDir(true)\n    50\t\tif err != nil {\n    51\t\t\tt.Fatal(err)\n    52\t\t}\n    53\t\traw, _ := json.Marshal(marker)\n    54\t\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), raw, 0o600); err != nil {\n    55\t\t\tt.Fatal(err)\n    56\t\t}\n    57\t\n    58\t\trun, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now())\n    59\t\tif err != nil {\n    60\t\t\tt.Fatal(err)\n    61\t\t}\n    62\t\tif run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"abandoned\") {\n    63\t\t\tt.Fatalf(\"the release recorded %s: %s\", run.Status, run.Failure)\n    64\t\t}\n    65\t\tif _, err := s.readAttemptReceipt(a); err != nil {\n    66\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n    67\t\t}\n    68\t\tif left, _ := filepath.Glob(filepath.Join(dir, a.AttemptID+\"*\")); len(left) != 0 {\n    69\t\t\tt.Fatalf(\"the marker or its stall claim stayed: %v\", left)\n    70\t\t}\n    71\t\t// Released once: a second release finds nothing abandoned.\n    72\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now()); !errors.Is(err, ErrAttemptNotAbandoned) {\n    73\t\t\tt.Fatalf(\"a released attempt was released again: %v\", err)\n    74\t\t}\n    75\t}\n    76\t\n    77\t// An attempt whose owner is alive is never released.\n    78\tfunc TestARunningAttemptIsNotReleased(t *testing.T) {\n    79\t\troot := t.TempDir()\n    80\t\ts := Store{Root: root}\n    81\t\tbundle := \"rvb-00000000000000a2\"\n    82\t\t// Silent for an hour, so only the owner's liveness keeps it running.\n    83\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n    84\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1, ReservedAt: old, Nonce: strings.Repeat(\"0\", 32)}\n    85\t\ta.AttemptID = attemptIdentity(a)\n    86\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    87\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    88\t\t\tt.Fatal(err)\n    89\t\t}\n    90\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    91\t\towner.Host, _ = os.Hostname()\n    92\t\tidentifyStartLockProcess(&owner)\n    93\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"d\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: bundle, StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n    94\t\tdir, _ := s.delegationActiveDir(true)\n    95\t\traw, _ := json.Marshal(marker)\n    96\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n    97\t\t\tt.Fatal(err)\n    98\t\t}\n    99\t\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now()); !errors.Is(err, ErrAttemptNotAbandoned) {\n   100\t\t\tt.Fatalf(\"a running attempt was released: %v\", err)\n   101\t\t}\n   102\t}\n   103\t\n   104\t// Review round 1, N1: the dispatch marks the attempt active before it\n   105\t// publishes the reservation, so no instant leaves a reservation without a\n   106\t// marker that turns stalled.\n   107\tfunc TestTheAttemptIsMarkedActiveBeforeItIsReserved(t *testing.T) {\n   108\t\tvar checked bool\n   109\t\tbeforeAttemptPublished = func(store Store, a DelegatedReviewAttempt) {\n   110\t\t\tchecked = true\n   111\t\t\tmarkers, _, err := store.ListDelegationActive()\n   112\t\t\tfound := false\n   113\t\t\tfor _, m := range markers {\n   114\t\t\t\tfound = found || m.AttemptID == a.AttemptID\n   115\t\t\t}\n   116\t\t\tif err != nil || !found {\n   117\t\t\t\tt.Errorf(\"the reservation of %s is published with no active marker: %v\", a.AttemptID, err)\n   118\t\t\t}\n   119\t\t\tif _, err := os.Lstat(reviewAttemptPath(store.Root, a)); !errors.Is(err, os.ErrNotExist) {\n   120\t\t\t\tt.Errorf(\"the reservation was published before the marker: %v\", err)\n   121\t\t\t}\n   122\t\t}\n   123\t\tt.Cleanup(func() { beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {} })\n   124\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\")\n   125\t\tif !checked {\n   126\t\t\tt.Fatal(\"the dispatch never reached the reservation\")\n   127\t\t}\n   128\t}\n   129\t\n   130\t// A marker whose dispatch ended before publishing the reservation is removed\n   131\t// by the release; ls names the cause and the release command (N2).\n   132\tfunc TestAStalledMarkerWithoutReservationIsListedAndRemoved(t *testing.T) {\n   133\t\troot := t.TempDir()\n   134\t\ts := Store{Root: root}\n   135\t\tdead := exec.Command(\"true\")\n   136\t\tif err := dead.Run(); err != nil {\n   137\t\t\tt.Fatal(err)\n   138\t\t}\n   139\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:x\", Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n   140\t\towner.Host, _ = os.Hostname()\n   141\t\tidentifyStartLockProcess(&owner)\n   142\t\towner.PID = dead.Process.Pid\n   143\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   144\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: \"rat-\" + strings.Repeat(\"e\", 64), RunToken: strings.Repeat(\"f\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: \"rvb-00000000000000a3\", StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n   145\t\tdir, _ := s.delegationActiveDir(true)\n   146\t\traw, _ := json.Marshal(marker)\n   147\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n   148\t\t\tt.Fatal(err)\n   149\t\t}\n   150\t\tattempts, _, err := s.ListDelegationAttempts()\n   151\t\tif err != nil || len(attempts) != 1 || attempts[0].State != DelegationStalled || !strings.Contains(attempts[0].Failure, DelegationAbandonedCause) || !strings.Contains(attempts[0].Failure, \"pose delegate cancel \"+marker.AttemptID) {\n   152\t\t\tt.Fatalf(\"the abandoned attempt is not listed with its cause: %+v %v\", attempts, err)\n   153\t\t}\n   154\t\trun, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now())\n   155\t\tif err != nil || run.RunID != \"\" {\n   156\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   157\t\t}\n   158\t\tif left, _ := filepath.Glob(filepath.Join(dir, marker.AttemptID+\"*\")); len(left) != 0 {\n   159\t\t\tt.Fatalf(\"the marker stayed: %v\", left)\n   160\t\t}\n   161\t}\n   162\t\n   163\t// writeDeadMarker rewrites the marker of attempt so its owner is a process\n   164\t// that has exited and its heartbeat is an hour old, as a dispatch killed\n   165\t// mid-run leaves it.\n   166\tfunc writeDeadMarker(t *testing.T, s Store, attempt string) {\n   167\t\tt.Helper()\n   168\t\tdir, err := s.delegationActiveDir(false)\n   169\t\tif err != nil {\n   170\t\t\tt.Fatal(err)\n   171\t\t}\n   172\t\tpath := filepath.Join(dir, attempt+\".json\")\n   173\t\traw, err := os.ReadFile(path)\n   174\t\tif err != nil {\n   175\t\t\tt.Fatal(err)\n   176\t\t}\n   177\t\tvar marker DelegationActiveRun\n   178\t\tif err := json.Unmarshal(raw, &marker); err != nil {\n   179\t\t\tt.Fatal(err)\n   180\t\t}\n   181\t\tdead := exec.Command(\"true\")\n   182\t\tif err := dead.Run(); err != nil {\n   183\t\t\tt.Fatal(err)\n   184\t\t}\n   185\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\npose-mcp/internal/pose/delegation_supervision_linux_test.go:73:\tattempts, _, err := s.ListDelegationAttempts()\npose-mcp/internal/pose/delegation_observation_review_test.go:36:\t\tgo func() { a, _, _ := s.ListDelegationAttempts(); read <- a }()\npose-mcp/internal/pose/delegation_list.go:71:// ListDelegationAttempts groups every recorded run by attempt, adds the runs\npose-mcp/internal/pose/delegation_list.go:73:func (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\npose-mcp/internal/pose/delegation_act