empt struct {\n    29\t\tSchemaVersion int    `json:\"schema_version\"`\n    30\t\tAttemptID     string `json:\"attempt_id\"`\n    31\t\tBundleID      string `json:\"bundle_id\"`\n    32\t\tBundleDigest  string `json:\"bundle_digest\"`\n    33\t\tScope         string `json:\"scope\"`\n    34\t\tAdapter       string `json:\"adapter\"`\n    35\t\tReason        string `json:\"reason,omitempty\"`\n    36\t\tOrdinal       int    `json:\"ordinal\"`\n    37\t\tReservedAt    string `json:\"reserved_at\"`\n    38\t\tNonce         string `json:\"nonce\"`\n    39\t}\n    40\ttype reviewAttemptReceipt struct {\n    41\t\tSchemaVersion int    `json:\"schema_version\"`\n    42\t\tAttemptID     string `json:\"attempt_id\"`\n    43\t\tRunID         string `json:\"run_id\"`\n    44\t\tRunDigest     string `json:\"run_digest\"`\n    45\t}\n    46\ttype reviewRunWitness struct {\n    47\t\tSchemaVersion    int    `json:\"schema_version\"`\n    48\t\tRunID            string `json:\"run_id\"`\n    49\t\tBundleID         string `json:\"bundle_id\"`\n    50\t\tScope            string `json:\"scope\"`\n    51\t\tRecordDigest     string `json:\"record_digest\"`\n    52\t\tTranscriptDigest string `json:\"transcript_digest\"`\n    53\t}\n    54\t\n    55\tfunc reviewAttemptKey(bundle string) string {\n    56\t\treturn strings.TrimPrefix(digestBytes([]byte(bundle)), \"sha256:\")[:24]\n    57\t}\n    58\tfunc reviewAttemptPath(root string, a DelegatedReviewAttempt) string {\n    59\t\treturn filepath.Join(root, reviewAttemptDir, reviewAttemptKey(a.BundleID), fmt.Sprintf(\"%06d.json\", a.Ordinal))\n    60\t}\n    61\tfunc attemptReceiptPath(root string, a DelegatedReviewAttempt) string {\n    62\t\treturn strings.TrimSuffix(reviewAttemptPath(root, a), \".json\") + \".result.json\"\n    63\t}\n    64\tfunc attemptIdentity(a DelegatedReviewAttempt) string {\n    65\t\ta.AttemptID = \"\"\n    66\t\traw, _ := json.Marshal(a)\n    67\t\treturn \"rat-\" + strings.TrimPrefix(digestBytes(raw), \"sha256:\")\n    68\t}\n    69\t\n    70\tfunc readLedgerRaw(path string) ([]byte, error) {\n    71\t\treturn readBoundedRegular(path, reviewLedgerMaxBytes)\n    72\t}\n    73\t\n    74\t// readBoundedRegular reads a regular file of at most limit bytes, refusing a\n    75\t// link or a file replaced while it was opened.\n    76\tfunc readBoundedRegular(path string, limit int64) ([]byte, error) {\n    77\t\tinfo, err := os.Lstat(path)\n    78\t\tif err != nil {\n    79\t\t\treturn nil, err\n    80\t\t}\n    81\t\tif !info.Mode().IsRegular() || info.Size() > limit {\n    82\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n    83\t\t}\n    84\t\tf, err := os.Open(path)\n    85\t\tif err != nil {\n    86\t\t\treturn nil, err\n    87\t\t}\n    88\t\topened, statErr := f.Stat()\n    89\t\tif statErr != nil || !opened.Mode().IsRegular() || !os.SameFile(info, opened) {\n    90\t\t\tf.Close()\n   322\t\t\t\treturn nil, fmt.Errorf(\"unknown attempt artifact %s\", e.Name())\n   323\t\t\t}\n   324\t\t\tvar a DelegatedReviewAttempt\n   325\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, rel, e.Name()), &a, budget); err != nil {\n   326\t\t\t\treturn nil, err\n   327\t\t\t}\n   328\t\t\tif a.SchemaVersion != 1 || a.BundleID != bundle || a.Ordinal != len(out)+1 || a.AttemptID != attemptIdentity(a) || e.Name() != fmt.Sprintf(\"%06d.json\", a.Ordinal) {\n   329\t\t\t\treturn nil, fmt.Errorf(\"invalid attempt reservation %s\", e.Name())\n   330\t\t\t}\n   331\t\t\tif _, err := time.Parse(time.RFC3339Nano, a.ReservedAt); err != nil {\n   332\t\t\t\treturn nil, err\n   333\t\t\t}\n   334\t\t\tout = append(out, a)\n   335\t\t}\n   336\t\t// Orphan receipts are an unknown history, never ignored.\n   337\t\tfor _, e := range entries {\n   338\t\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n   339\t\t\t\tfound := false\n   340\t\t\t\tfor _, a := range out {\n   341\t\t\t\t\tif filepath.Base(attemptReceiptPath(s.Root, a)) == e.Name() {\n   342\t\t\t\t\t\tfound = true\n   343\t\t\t\t\t\tbreak\n   344\t\t\t\t\t}\n   345\t\t\t\t}\n   346\t\t\t\tif !found {\n   347\t\t\t\t\treturn nil, fmt.Errorf(\"attempt receipt has no reservation: %s\", e.Name())\n   348\t\t\t\t}\n   349\t\t\t}\n   350\t\t}\n   351\t\treturn out, nil\n   352\t}\n   353\tfunc (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (reviewAttemptReceipt, error) {\n   354\t\tbudget := reviewReadBudget(budgets)\n   355\t\tvar r reviewAttemptReceipt\n   356\t\tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n   357\t\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n   358\t\t}\n   359\t\tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n   360\t\t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n   361\t\t}\n   362\t\tvar run ReviewRun\n   363\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, r.RunID+\".json\"), &run, budget); err != nil {\n   364\t\t\treturn r, err\n   365\t\t}\n   366\t\traw, _ := json.Marshal(run)\n   367\t\tif run.AttemptID != a.AttemptID || run.BundleID != a.BundleID || run.BundleDigest != a.BundleDigest || run.Adapter != a.Adapter || digestBytes(raw) != r.RunDigest {\n   368\t\t\treturn r, fmt.Errorf(\"attempt receipt does not bind its final run\")\n   369\t\t}\n   370\t\treturn r, nil\n   371\t}\n   372\tfunc (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttempt, int, error) {\n   373\t\tif len(plan.Reason) > 2048 || strings.ContainsAny(plan.Reason, \"\\x00\\r\\n\") {\n   374\t\t\treturn nil, 0, fmt.Errorf(\"rerun reason must be one line of at most 2048 bytes\")\n   375\t\t}\n   376\t\truns, lost, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n   377\t\tif err != nil {\n   378\t\t\treturn nil, 0, err\n   379\t\t}\n   380\t\tif len(lost) > 0 {\n   381\t\t\treturn nil, 0, fmt.Errorf(\"review run coverage is unknown: %v\", lost)\n   382\t\t}\n   383\t\tattempts, err := s.readDelegatedReviewAttempts(plan.Bundle.BundleID)\n   384\t\tif err != nil {\n   385\t\t\treturn nil, 0, err\n   386\t\t}\n   387\t\tknownAttempts := map[string]bool{}\n   388\t\tcount := 0\n   389\t\treceiptBudget := int64(32 << 20)\n   390\t\tfor _, a := range attempts {\n   391\t\t\tknownAttempts[a.AttemptID] = true\n   392\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   393\t\t\t\treturn nil, 0, err\n   394\t\t\t}\n   395\t\t\tif a.Adapter == plan.Adapter {\n   396\t\t\t\tcount++\n   397\t\t\t}\n   398\t\t}\n   399\t\tcompleted := false\n   400\t\tfor _, run := range runs {\n   401\t\t\tif run.AttemptID != \"\" && !knownAttempts[run.AttemptID] {\n   402\t\t\t\treturn nil, 0, fmt.Errorf(\"missing attempt reservation %s\", run.AttemptID)\n   403\t\t\t}\n   404\t\t\tif run.Status == ReviewRunCompleted {\n   405\t\t\t\tcompleted = true\n   406\t\t\t}\n   407\t\t\tif run.AttemptID == \"\" && run.Adapter == plan.Adapter {\n   408\t\t\t\tcount++\n   409\t\t\t}\n   410\t\t}\n   411\t\tif count >= effectiveReviewMaxRuns(plan.Config) {\n   412\t\t\treturn nil, count, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"budget exhausted: %d attempt(s) of %s on this bundle, at most %d\", count, plan.Adapter, effectiveReviewMaxRuns(plan.Config)))\n   413\t\t}\n   414\t\tif completed && strings.TrimSpace(plan.Reason) == \"\" {\n   415\t\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n   416\t\t}\n   417\t\treturn attempts, count, nil\n   418\t}\n   419\t\n   420\t// prepareDelegatedReviewAttempt admits and builds the next reservation of\n   421\t// the bundle without publishing it.\npose-mcp/internal/pose/review_attempt_ledger.go:372:func (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttempt, int, error) {\n","exit_code":0,"status":"completed"}}
