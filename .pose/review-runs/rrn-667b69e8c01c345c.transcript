30\t\t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n   931\t\t\t\t}\n   932\t\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n   933\t\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n   934\t\t\t\t}\n   935\t\t\t\tif a.HookFailure != \"\" {\n   936\t\t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n   937\t\t\t\t}\n   938\t\t\t\tif a.Interruption != nil {\n   939\t\t\t\t\tvalue += fmt.Sprintf(\" cause=%s resumable=%t partial=%t\", a.Interruption.Cause, a.Interruption.Resumable, a.Partial)\n   940\t\t\t\t\tif a.Interruption.ResetAt != \"\" {\n   941\t\t\t\t\t\tvalue += \" reset_at=\" + a.Interruption.ResetAt + \" time_left=\" + a.TimeLeft\n   942\t\t\t\t\t}\n   943\t\t\t\t}\n   944\t\t\t\tif a.LatestRun != \"\" {\n   945\t\t\t\t\tvalue += \" run=\" + a.LatestRun\n   946\t\t\t\t}\n   947\t\t\t\tif a.LastStep != \"\" {\n   948\t\t\t\t\tvalue += \" last=\" + a.LastStep\n   949\t\t\t\t}\n   950\t\t\t\tout.Field(\"delegate.\"+a.AttemptID, value)\n   951\t\t\t}\n   952\t\t\tfor _, loss := range lost {\n   953\t\t\t\tout.Failure(tr(\"delegated run history incomplete: \", \"histórico de runs delegados incompleto: \") + loss)\n   954\t\t\t}\n   955\t\t}\n   956\t\tif len(lost) > 0 {\n   957\t\t\treturn 1\n   958\t\t}\n   959\t\treturn 0\n   960\t}\n  1110\tfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n  1111\t\tf, problem := parseDelegateFlags(args)\n  1112\t\tif problem != \"\" {\n  1113\t\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--dry-run] [--json]\")\n  1114\t\t}\n  1115\t\tstore := posemodel.Store{Root: root}\n  1116\t\tattempts, lost, err := store.ListDelegationAttempts()\n  1117\t\tif err != nil {\n  1118\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1119\t\t}\n  1120\t\tattempt, code, err := namedAttempt(attempts, f)\n  1121\t\tif err != nil {\n  1122\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n  1123\t\t}\n  1124\t\tif attempt.State == posemodel.DelegationStalled && attempt.LatestRun == \"\" && !f.dryRun {\n  1125\t\t\t// An attempt whose dispatch ended before recording its run is\n  1126\t\t\t// released with a failed run and its receipt, so it stops blocking\n  1127\t\t\t// the bundle (spec pose-review-run-reaps-lingering-reviewer-processes R5).\n  1128\t\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now())\n  1129\t\t\tif err != nil {\n  1130\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1131\t\t\t}\n  1132\t\t\tif f.jsonOut {\n  1133\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n  1134\t\t\t\treturn 0\n  1135\t\t\t}\n  1136\t\t\tout := render(stdout, stderr)\n  1137\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1138\t\t\tif run.RunID == \"\" {\n  1139\t\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n  1140\t\t\t} else {\n  1141\t\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n  1142\t\t\t}\n  1143\t\t\treturn 0\n  1144\t\t}\n  1145\t\tif !attempt.Active {\n  1146\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1147\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1148\t\t}\n  1149\t\tif f.dryRun {\n  1150\t\t\tif f.jsonOut {\n  1151\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": false, \"dry_run\": true, \"owner\": attempt.Liveness})\n  1152\t\t\t\treturn 0\n  1153\t\t\t}\n  1154\t\t\tout := render(stdout, stderr)\n  1155\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1156\t\t\tout.Field(\"delegate.owner\", attempt.Liveness)\n  1157\t\t\tout.Field(\"delegate.dry_run\", tr(\"true (no cancellation requested)\", \"true (nenhum cancelamento pedido)\"))\n  1158\t\t\treturn 0\n  1159\t\t}\n  1160\t\tmarker, err := store.RequestDelegationCancel(attempt.AttemptID)\n  1161\t\tif err != nil {\n  1162\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1163\t\t}\n  1164\t\tdeadline := time.Now().Add(60 * time.Second)\n  1165\t\tfor store.DelegationRunActive(marker) && time.Now().Before(deadline) {\n  1166\t\t\ttime.Sleep(200 * time.Millisecond)\n  1167\t\t}\n  1168\t\tstopped := !store.DelegationRunActive(marker)\n  1169\t\tstatus, run := \"\", \"\"\n  1170\t\tif after, _, err := store.ListDelegationAttempts(); err == nil {\n  1171\t\t\tfor _, a := range after {\n  1172\t\t\t\tif a.AttemptID == attempt.AttemptID && a.Latest() != nil {\n  1173\t\t\t\t\tstatus, run = a.Latest().Status, a.Latest().RunID\n  1174\t\t\t\t}\n  1175\t\t\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '65,215p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '350,455p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '65,215p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '350,455p'\"","aggregated_output":"    65\t\tDelegationStalled = \"stalled\"\n    66\t\t// DelegationAbandonedCause is the failure of a stalled attempt whose\n    67\t\t// dispatch ended before recording its run.\n    68\t\tDelegationAbandonedCause = \"abandoned: the dispatching process ended before the run was recorded\"\n    69\t)\n    70\t\n    71\t// ListDelegationAttempts groups every recorded run by attempt, adds the runs\n    72\t// in progress, and returns the losses the run history reports.\n    73\tfunc (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n    74\t\t// The markers are read before the runs: a run publishes its record before\n    75\t\t// it removes its marker, so a reader that finds no marker for an attempt\n    76\t\t// it saw running finds its record (spec\n    77\t\t// pose-delegated-review-completion-signal R5).\n    78\t\tactive, activeLost, activeErr := s.ListDelegationActive()\n    79\t\truns, lost, err := s.ReadReviewRuns(\"\")\n    80\t\tif err != nil {\n    81\t\t\treturn nil, nil, err\n    82\t\t}\n    83\t\t// Task runs share the lifecycle, never the review history (spec\n    84\t\t// pose-delegation-task R7, R8).\n    85\t\ttasks, taskLost := s.ReadDelegationTaskRuns()\n    86\t\truns, lost = append(runs, tasks...), append(lost, taskLost...)\n    87\t\tbyAttempt := map[string]*DelegationAttempt{}\n    88\t\torder := []string{}\n    89\t\tfor i := range runs {\n    90\t\t\trun := runs[i]\n    91\t\t\tkey := run.AttemptID\n    92\t\t\tif key == \"\" {\n    93\t\t\t\tkey = run.RunID // a run recorded before attempts existed is its own attempt\n    94\t\t\t}\n    95\t\t\trow, ok := byAttempt[key]\n    96\t\t\tif !ok {\n    97\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    98\t\t\t\tbyAttempt[key] = row\n    99\t\t\t\torder = append(order, key)\n   100\t\t\t}\n   101\t\t\trow.Runs = append(row.Runs, run.RunID)\n   102\t\t\trow.latest = &runs[i]\n   103\t\t\tif run.SessionDigest != \"\" {\n   104\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   105\t\t\t\t\trow.sessions = append(row.sessions, value)\n   106\t\t\t\t}\n   107\t\t\t}\n   108\t\t\tevents, err := s.ReadDelegationEvents(run)\n   109\t\t\tif err != nil {\n   110\t\t\t\t// A turn count read from nothing would report a whole history.\n   111\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   112\t\t\t} else {\n   113\t\t\t\tfor _, e := range events {\n   114\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   115\t\t\t\t\t\trow.Turns++\n   116\t\t\t\t\t}\n   117\t\t\t\t}\n   118\t\t\t\tif len(events) > 0 {\n   119\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   120\t\t\t\t}\n   121\t\t\t}\n   122\t\t}\n   123\t\tfor _, key := range order {\n   124\t\t\trow := byAttempt[key]\n   125\t\t\tlatest := row.latest\n   126\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   127\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   128\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   129\t\t\tif latest.Access != \"\" {\n   130\t\t\t\trow.Access = latest.Access\n   131\t\t\t}\n   132\t\t\trow.Round = latest.Round\n   133\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   134\t\t\t\trow.HookFailure = hook.Failure\n   135\t\t\t}\n   136\t\t\tif row.Purpose == \"\" {\n   137\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   138\t\t\t}\n   139\t\t\tif latest.Status == ReviewRunInterrupted {\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tfor _, a := range orphans {\n   196\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   197\t\t\t\t\tcontinue\n   198\t\t\t\t}\n   199\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   200\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + a.AttemptID + \"`\"}\n   201\t\t\t\torder = append(order, a.AttemptID)\n   202\t\t\t}\n   203\t\t}\n   204\t\tout := make([]DelegationAttempt, 0, len(order))\n   205\t\tfor _, key := range order {\n   206\t\t\tout = append(out, *byAttempt[key])\n   207\t\t}\n   208\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   209\t\treturn out, lost, nil\n   210\t}\n   211\t\n   212\tfunc delegationStepText(e DelegationEvent) string {\n   213\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   214\t\tif len(text) > 80 {\n   215\t\t\tcut := 77\n   350\t\t}\n   351\t\treturn out, nil\n   352\t}\n   353\tfunc (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (reviewAttemptReceipt, error) {\n   354\t\tbudget := reviewReadBudget(budgets)\n   355\t\tvar r reviewAttemptReceipt\n   356\t\tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n   357\t\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n   358\t\t}\n   359\t\tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n   360\t\t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n   361\t\t}\n   362\t\tvar run ReviewRun\n   363\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, r.RunID+\".json\"), &run, budget); err != nil {\n   364\t\t\treturn r, err\n   365\t\t}\n   366\t\traw, _ := json.Marshal(run)\n   367\t\tif run.AttemptID != a.AttemptID || run.BundleID != a.BundleID || run.BundleDigest != a.BundleDigest || run.Adapter != a.Adapter || digestBytes(raw) != r.RunDigest {\n   368\t\t\treturn r, fmt.Errorf(\"attempt receipt does not bind its final run\")\n   369\t\t}\n   370\t\treturn r, nil\n   371\t}\n   372\tfunc (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttempt, int, error) {\n   373\t\tif len(plan.Reason) > 2048 || strings.ContainsAny(plan.Reason, \"\\x00\\r\\n\") {\n   374\t\t\treturn nil, 0, fmt.Errorf(\"rerun reason must be one line of at most 2048 bytes\")\n   375\t\t}\n   376\t\truns, lost, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n   377\t\tif err != nil {\n   378\t\t\treturn nil, 0, err\n   379\t\t}\n   380\t\tif len(lost) > 0 {\n   381\t\t\treturn nil, 0, fmt.Errorf(\"review run coverage is unknown: %v\", lost)\n   382\t\t}\n   383\t\tattempts, err := s.readDelegatedReviewAttempts(plan.Bundle.BundleID)\n   384\t\tif err != nil {\n   385\t\t\treturn nil, 0, err\n   386\t\t}\n   387\t\tknownAttempts := map[string]bool{}\n   388\t\tcount := 0\n   389\t\treceiptBudget := int64(32 << 20)\n   390\t\tfor _, a := range attempts {\n   391\t\t\tknownAttempts[a.AttemptID] = true\n   392\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   393\t\t\t\treturn nil, 0, err\n   394\t\t\t}\n   395\t\t\tif a.Adapter == plan.Adapter {\n   396\t\t\t\tcount++\n   397\t\t\t}\n   398\t\t}\n   399\t\tcompleted := false\n   400\t\tfor _, run := range runs {\n   401\t\t\tif run.AttemptID != \"\" && !knownAttempts[run.AttemptID] {\n   402\t\t\t\treturn nil, 0, fmt.Errorf(\"missing attempt reservation %s\", run.AttemptID)\n   403\t\t\t}\n   404\t\t\tif run.Status == ReviewRunCompleted {\n   405\t\t\t\tcompleted = true\n   406\t\t\t}\n   407\t\t\tif run.AttemptID == \"\" && run.Adapter == plan.Adapter {\n   408\t\t\t\tcount++\n   409\t\t\t}\n   410\t\t}\n   411\t\tif count >= effectiveReviewMaxRuns(plan.Config) {\n   412\t\t\treturn nil, count, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"budget exhausted: %d attempt(s) of %s on this bundle, at most %d\", count, plan.Adapter, effectiveReviewMaxRuns(plan.Config)))\n   413\t\t}\n   414\t\tif completed && strings.TrimSpace(plan.Reason) == \"\" {\n   415\t\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n   416\t\t}\n   417\t\treturn attempts, count, nil\n   418\t}\n   419\t\n   420\t// prepareDelegatedReviewAttempt admits and builds the next reservation of\n   421\t// the bundle without publishing it.\n   422\tfunc (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n   423\t\tattempts, _, err := s.reviewAttemptAdmission(plan)\n   424\t\tif err != nil {\n   425\t\t\treturn DelegatedReviewAttempt{}, err\n   426\t\t}\n   427\t\tnonce := make([]byte, 16)\n   428\t\tif _, err := rand.Read(nonce); err != nil {\n   429\t\t\treturn DelegatedReviewAttempt{}, err\n   430\t\t}\n   431\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n   432\t\ta.AttemptID = attemptIdentity(a)\n   433\t\treturn a, nil\n   434\t}\n   435\t\n   436\t// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n   437\t// marks the attempt active first, so a dispatch that ends after this point\n   438\t// always leaves a marker that turns stalled and that `pose delegate cancel`\n   439\t// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n   440\t// review round 1, N1).\n   441\tfunc (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n   442\t\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n   443\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n   444\t\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n   445\t\t}\n   446\t\treturn nil\n   447\t}\n   448\tfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n   449\t\traw, _ := json.Marshal(run)\n   450\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n   451\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n   452\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n   453\t}\n   454\t\n   455\t// 