{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'func dispatchValidationEntries' pose-mcp/internal/cli/validate.go; sed -n '74,142p' pose-mcp/internal/cli/validate.go; sed -n '354p' POSE.md; sed -n '1,75p' pose-mcp/internal/pose/delivery_validation_run_test.go; rg -n 'artifact\\\\.findings|undeclared|unclaimed|unexpected' pose-mcp/internal/cli/artifact*.go\"","aggregated_output":"325:func dispatchValidationEntries(ctx context.Context, entries []*validationEntry, jobs int, matrix validationMatrix) {\n\n// resolveWhen evaluates the check's condition at the moment it would start,\n// so an earlier check, finished by then, can decide it (review round 1, B1).\nfunc (e *validationEntry) resolveWhen() {\n\tif e.skip == \"\" {\n\t\te.skip = validationSkipReason(e.moduleDir, e.check.When)\n\t}\n}\n\n// execute runs the check and records its outcome in the entry's result. It\n// touches nothing else, so entries can run concurrently; the caller counts.\nfunc (e *validationEntry) execute(parent context.Context, matrix validationMatrix, verbose bool, stdout, stderr io.Writer, beforeStream func()) {\n\tcheck, result := e.check, &e.result\n\ttimeout := check.TimeoutSeconds\n\tif timeout <= 0 {\n\t\ttimeout = matrix.Defaults.TimeoutSeconds\n\t}\n\tif timeout <= 0 {\n\t\ttimeout = 600 // documented safe default\n\t}\n\tmaxOutput := matrix.Defaults.MaxOutputBytes\n\tif maxOutput <= 0 {\n\t\tmaxOutput = 1 << 20 // 1 MiB documented safe default\n\t}\n\tctx, cancel := context.WithTimeout(parent, time.Duration(timeout)*time.Second)\n\tcapture := &tailBuffer{capacity: 4096}\n\tlimiter := &outputLimiter{limit: maxOutput, cancel: cancel}\n\tpackages := &goTestPackages{}\n\texecArgs := sanitizeGoCheckArgs(ctx, e.moduleDir, check.Program, check.Args)\n\tif parent.Err() != nil {\n\t\tcancel()\n\t\te.markCancelled()\n\t\treturn\n\t}\n\tcmd := exec.CommandContext(ctx, check.Program, execArgs...)\n\tsetProcessGroup(cmd)\n\tcmd.Cancel = func() error { return killProcessGroup(cmd) }\n\tcmd.Dir = e.moduleDir\n\t// The renderer owns the terminal while a step is active: a child\n\t// writing to it would fight the status line, and streaming every\n\t// check's output is what buried the run's own verdict. The output is\n\t// captured and shown when the check fails; --verbose streams it\n\t// (spec pose-cli-output-rendering-system R7).\n\tif verbose {\n\t\tbeforeStream()\n\t\tcmd.Stdout = io.MultiWriter(stdout, capture, limiter, packages)\n\t\tcmd.Stderr = io.MultiWriter(stderr, capture, limiter)\n\t} else {\n\t\tcmd.Stdout = io.MultiWriter(capture, limiter, packages)\n\t\tcmd.Stderr = io.MultiWriter(capture, limiter)\n\t}\n\tcmd.Env = os.Environ()\n\tfor key, value := range check.Env {\n\t\tcmd.Env = append(cmd.Env, key+\"=\"+value)\n\t}\n\tstarted := time.Now()\n\terr := cmd.Run()\n\tdeadline := ctx.Err()\n\tcancel()\n\tresult.DurationSeconds = time.Since(started).Seconds()\n\tresult.Output = redactSecrets(capture.String(), check.Env)\n\tvar exitErr *exec.ExitError\n\tswitch {\n\tcase limiter.exceeded:\n\t\t// Explicit guardrail state: the check flooded output and was\n\t\t// cancelled (never conflated with a normal check failure).\n\t\tresult.Outcome, result.LimitState = \"error\", \"output-limit\"\n\t\tresult.Output = fmt.Sprintf(\"output limit exceeded (%d bytes) — process group terminated\", maxOutput)\n\tcase deadline == context.DeadlineExceeded:\n\npackage pose\n\nimport \"testing\"\n\n// A carried check is read as an observation of the head it ran at (spec\n// pose-validate-carries-unchanged-checks R7); an executed one keeps the run's.\nfunc TestDeliveryValidationRunReadsTheCarriedHead(t *testing.T) {\n\traw := []byte(`{\"schema_version\":1,\"generated_at\":\"2026-11-22T10:00:00Z\",\"git_head\":\"bbbb\",\"checks\":[` +\n\t\t`{\"id\":\"a/go/ok\",\"module\":\"a\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\"},` +\n\t\t`{\"id\":\"b/go/ok\",\"module\":\"b\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\",\"carried_from\":\"aaaa\",\"carried_generated_at\":\"2026-11-21T09:00:00Z\"}]}`)\n\tresults, err := ParseDeliveryValidationRun(raw, \".pose/results/delivery-validation.json\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(results) != 2 {\n\t\tt.Fatalf(\"results = %+v\", results)\n\t}\n\tfor _, r := range results {\n\t\tswitch r.ID {\n\t\tcase \"a/go/ok\":\n\t\t\tif r.GitHead != \"bbbb\" || r.GeneratedAt != \"2026-11-22T10:00:00Z\" {\n\t\t\t\tt.Fatalf(\"executed check read as %s at %s\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\tcase \"b/go/ok\":\n\t\t\tif r.GitHead != \"aaaa\" || r.GeneratedAt != \"2026-11-21T09:00:00Z\" {\n\t\t\t\tt.Fatalf(\"carried check read as %s at %s, want the head it ran at\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\t}\n\t}\n}\npose-mcp/internal/cli/artifact_integrity.go:908:\t\tfmt.Fprintf(stdout, \"artifact.spec=%s\\nartifact.change_set=%s\\nartifact.change_set.base=%s\\nartifact.change_set.head=%s\\nartifact.change_set.commits=%d\\nartifact.diff_digest=%s\\nartifact.claims=%d\\nartifact.observed=%d\\nartifact.findings=%d\\n\",\npose-mcp/internal/cli/artifact_integrity_test.go:42:\twriteArtifactTestFile(t, root, \".pose/policy/artifacts.json\", `{\"schema_version\":1,\"enabled\":true,\"adopted_at\":\"2026-08-03\",\"governed_roots\":[\"internal\"],\"severities\":{\"action-mismatch\":\"error\",\"undeclared\":\"error\",\"orphan\":\"warning\"}}`)\npose-mcp/internal/cli/artifact_integrity_test.go:81:\t\tt.Fatalf(\"unexpected graph: %+v\", graph)\npose-mcp/internal/cli/artifact_integrity_test.go:124:\tif !strings.Contains(out.String(), \"action-mismatch\") || !strings.Contains(out.String(), \"undeclared\") {\npose-mcp/internal/cli/artifact_integrity_test.go:134:\twriteArtifactTestFile(t, root, \".pose/policy/artifacts.json\", `{\"schema_version\":1,\"enabled\":true,\"adopted_at\":\"2026-08-03\",\"governed_roots\":[\"internal\"],\"severities\":{\"action-mismatch\":\"error\",\"undeclared\":\"error\"}}`)\npose-mcp/internal/cli/artifact_integrity_test.go:156:\t\tt.Fatalf(\"unexpected rename/remove observations: %+v\", got)\npose-mcp/internal/cli/artifact_integrity_test.go:168:\twriteArtifactTestFile(t, root, \".pose/policy/artifacts.json\", `{\"schema_version\":1,\"enabled\":true,\"adopted_at\":\"2026-08-03\",\"governed_roots\":[\"release\"],\"severities\":{\"action-mismatch\":\"error\",\"undeclared\":\"warning\"}}`)\npose-mcp/internal/cli/artifact_integrity_test.go:286:\t\t\tt.Fatalf(\"unexpected action-mismatch on live git commit: %+v\", finding)\npose-mcp/internal/cli/artifact_integrity_test.go:296:\twriteArtifactTestFile(t, root, \".pose/policy/artifacts.json\", `{\"schema_version\":1,\"enabled\":true,\"adopted_at\":\"2026-08-03\",\"governed_roots\":[\"internal\"],\"severities\":{\"action-mismatch\":\"error\",\"undeclared\":\"error\"}}`)\npose-mcp/internal/cli/artifact_integrity_test.go:379:\t\tt.Fatalf(\"unexpected resolvability finding on none-claim spec: %s\", stdout.String())\npose-mcp/internal/cli/artifact_integrity_test.go:392:\twriteArtifactTestFile(t, root, \".pose/policy/artifacts.json\", `{\"schema_version\":1,\"enabled\":true,\"adopted_at\":\"2026-08-03\",\"governed_roots\":[\"src\"],\"severities\":{\"action-mismatch\":\"error\",\"undeclared\":\"error\"}}`)\npose-mcp/internal/cli/artifact_attributions_test.go:30:\tconst path = \"internal/undeclared.go\"\npose-mcp/internal/cli/artifact_attributions_test.go:83:\t\tif f.Code == \"undeclared\" {\npose-mcp/internal/cli/artifact_attributions_test.go:101:\tif code := cmdArtifactCheck(root, []string{\"--spec\", \"alpha\", \"--strict\", \"--json\"}, &output, &errOut); code == 0 || !strings.Contains(output.String(), \"undeclared\") {\npose-mcp/internal/cli/artifact_attributions.go:94:\t\tif finding.Code != \"undeclared\" {\n","exit_code":0,"status":"completed"}}
