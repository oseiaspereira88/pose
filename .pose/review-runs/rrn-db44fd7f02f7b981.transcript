{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,205p' pose-mcp/internal/cli/validate_carry.go; cat pose-mcp/internal/cli/validate_scope.go\"","aggregated_output":"package cli\n\n// Carried checks (spec pose-validate-carries-unchanged-checks): with a\n// comparable canonical result as base, validate --carry runs the modules the\n// changed scope selects between the base head and HEAD and carries the base\n// results of every other module, each stating the head it ran at. Any doubt\n// about the base runs everything and records why (R2).\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"runtime/debug\"\n\t\"sort\"\n\t\"strings\"\n\t\"unicode\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n)\n\n// carryRecord is the run's account of its base (R5).\ntype carryRecord struct {\n\tUsed     bool              `json:\"used\"`\n\tReason   string            `json:\"reason,omitempty\"`\n\tBaseHead string            `json:\"base_head,omitempty\"`\n\tChanged  int               `json:\"changed\"`\n\tSelected map[string]string `json:\"selected,omitempty\"`\n}\n\n// carryPlan is what a usable base lets the run reuse.\ntype carryPlan struct {\n\trecord    *carryRecord\n\tselection *scopeSelection\n\tbase      map[string]checkResult\n\tbaseHead  string\n\tbaseTime  string\n}\n\n// carried reports whether module's checks come from the base.\nfunc (p carryPlan) carried(module string) bool {\n\tif p.selection == nil {\n\t\treturn false\n\t}\n\t_, selected := p.selection.Selected[module]\n\treturn !selected\n}\n\n// carriedResult is the base result of a check as this run records it (R4):\n// unchanged, plus where and when it really ran, kept through chained carries.\nfunc (p carryPlan) carriedResult(id string) checkResult {\n\tresult := p.base[id]\n\tif result.CarriedFrom == \"\" {\n\t\tresult.CarriedFrom, result.CarriedGeneratedAt = p.baseHead, p.baseTime\n\t}\n\treturn result\n}\n\n// planCarry judges the canonical result at resultsPath as a base. A nil\n// selection means every check runs; the record says why.\nfunc planCarry(root, resultsPath, mode, matrixSHA, head string, matrix validationMatrix, modules []validationModule) carryPlan {\n\tplan := carryPlan{record: &carryRecord{}}\n\tengine, engineVerifiable := engineIdentityFrom(debug.ReadBuildInfo())\n\tunused := func(format string, args ...any) carryPlan {\n\t\tplan.record.Reason = fmt.Sprintf(format, args...)\n\t\treturn plan\n\t}\n\traw, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(resultsPath)))\n\tif err != nil {\n\t\treturn unused(\"no canonical result at %s\", resultsPath)\n\t}\n\tvar base validationRunResult\n\tif err := json.Unmarshal(raw, &base); err != nil || base.SchemaVersion != validationResultSchema {\n\t\treturn unused(\"the canonical result is unreadable or has another schema\")\n\t}\n\tswitch {\n\tcase base.ModuleFilter != \"\" || base.StackFilter != \"\":\n\t\treturn unused(\"the canonical result was filtered by module or stack, so it is not comparable\")\n\tcase base.Mode != mode:\n\t\treturn unused(\"the canonical result ran in mode %q, this run is %q\", base.Mode, mode)\n\tcase base.MatrixSHA256 != matrixSHA:\n\t\treturn unused(\"the validation matrix changed since the canonical result\")\n\tcase !engineVerifiable:\n\t\treturn unused(\"this engine build was modified from its recorded revision, so its identity cannot be compared\")\n\tcase base.EngineVersion == \"\" || base.EngineVersion != engine || strings.HasSuffix(base.EngineVersion, \".dirty\"):\n\t\treturn unused(\"the engine version differs from the canonical result's or was not recorded\")\n\tcase base.GitHead == \"\" || !safeGitRevRE.MatchString(base.GitHead):\n\t\treturn unused(\"the canonical result records no usable head\")\n\tcase head == \"\" || !safeGitRevRE.MatchString(head):\n\t\treturn unused(\"the current head cannot be read\")\n\t}\n\tfor _, check := range base.Checks {\n\t\tif check.LimitState == \"cancelled\" {\n\t\t\treturn unused(\"the canonical result was cancelled\")\n\t\t}\n\t}\n\t// The base must have validated the commit it records: a run over a working\n\t// copy that differed from its head proves nothing about that head.\n\tif !base.MaterialClean {\n\t\treturn unused(\"the canonical result did not validate a clean working copy of its head\")\n\t}\n\tfor _, binding := range base.MaterialProvenance {\n\t\tif binding == posemodel.MaterialBindingUnavailable {\n\t\t\treturn unused(\"the canonical result records an unavailable material binding\")\n\t\t}\n\t}\n\tif !materialWorktreeClean(root) {\n\t\treturn unused(\"the working copy differs from HEAD in material paths\")\n\t}\n\t// Selection is lexical: a module reached through a symlink aliases another\n\t// path, so its inputs cannot be told apart (review round 4, N9).\n\t// Two modules sharing one physical directory (a case alias on a\n\t// case-insensitive filesystem) alias each other too (review round 5, N13).\n\tif reason := aliasedModule(modules, filepath.EvalSymlinks, os.Stat); reason != \"\" {\n\t\treturn unused(\"%s\", reason)\n\t}\n\t// Lexical selection cannot see through aliases. Rather than chase every\n\t// alias form (review rounds 4–7, N9, N13, N16–N18), a carry needs a\n\t// case-sensitive filesystem and no tracked symlink that links a module\n\t// (other than the root) or a declared dependency with any other path.\n\tmeta, err := loadScopeMetadata(root)\n\tif err != nil {\n\t\treturn unused(\"changed-scope selection failed: %v\", err)\n\t}\n\t// Symlinks inside a submodule hide behind its gitlink (review round 8,\n\t// N20): scan each checked-out submodule at its recorded commit, and refuse\n\t// when a module or a dependency lies in one that cannot be scanned.\n\tif reason, err := submoduleAliases(root, head, modules, meta); err != nil {\n\t\treturn unused(\"submodules cannot be read: %v\", err)\n\t} else if reason != \"\" {\n\t\treturn unused(\"%s\", reason)\n\t}\n\tif link, err := aliasingSymlink(root, head, modules, meta); err != nil {\n\t\treturn unused(\"tracked symlinks cannot be read: %v\", err)\n\t} else if link != \"\" {\n\t\treturn unused(\"the tree tracks symlink %s into or out of a module or a declared dependency, so changes cannot be attributed\", link)\n\t}\n\t// A declared dependency outside the repository changes without any change\n\t// the selection can see (review round 10, N28).\n\tfor rel, module := range meta.Modules {\n\t\tfor _, dep := range module.DependsOn {\n\t\t\tclean := filepath.ToSlash(filepath.Clean(dep))\n\t\t\tif filepath.IsAbs(dep) || path.IsAbs(clean) || clean == \"..\" || strings.HasPrefix(clean, \"../\") {\n\t\t\t\treturn unused(\"dependency %s of module %s lies outside the repository, so its changes cannot be seen\", dep, rel)\n\t\t\t}\n\t\t\t// A path that is not already clean can traverse a symlink before\n\t\t\t// its \"..\" is applied (review round 11, N30).\n\t\t\tif filepath.ToSlash(dep) != clean {\n\t\t\t\treturn unused(\"dependency %s of module %s is not a clean path, so its physical identity cannot be established\", dep, rel)\n\t\t\t}\n\t\t\t// Non-ASCII names can alias under Unicode normalization (review\n\t\t\t// round 11, N32).\n\t\t\tif !asciiPath(clean) {\n\t\t\t\treturn unused(\"dependency %s of module %s is not an ASCII path, so normalization aliases cannot be ruled out\", dep, rel)\n\t\t\t}\n\t\t\t// Its physical identity, through any symlink tracked or ignored,\n\t\t\t// must be its spelling (review round 12, N33).\n\t\t\tif !physicallyLexical(root, clean) {\n\t\t\t\treturn unused(\"dependency %s of module %s resolves through a symlink, so its changes cannot be attributed\", dep, rel)\n\t\t\t}\n\t\t}\n\t}\n\tfor _, m := range modules {\n\t\tif !asciiPath(m.Rel) {\n\t\t\treturn unused(\"module %s is not an ASCII path, so normalization aliases cannot be ruled out\", m.Rel)\n\t\t}\n\t}\n\tif sub := submodulesCheckedOut(root, head); sub != \"\" {\n\t\treturn unused(\"submodule %s is not checked out at its recorded commit\", sub)\n\t}\n\t// Index flags that hide tracked edits from status (review round 11, N31).\n\tif hidden, err := hiddenIndexEntries(root, head); err != nil {\n\t\treturn unused(\"the index cannot be read: %v\", err)\n\t} else if hidden != \"\" {\n\t\treturn unused(\"%s is marked assume-unchanged or skip-worktree, so the working copy cannot be compared\", hidden)\n\t}\n\tif caseInsensitiveFilesystem(root, os.Stat) {\n\t\treturn unused(\"the filesystem is case-insensitive, so changes cannot be attributed to modules\")\n\t}\n\t// A case-folded directory inside a case-sensitive filesystem is an alias\n\t// too (review round 8, N22).\n\tfor _, dir := range carryRelevantDirs(root, modules, meta) {\n\t\tif casefoldedDirectory(dir, os.ReadDir, os.Lstat) {\n\t\t\treturn unused(\"directory %s folds case, so changes cannot be attributed to modules\", dir)\n\t\t}\n\t}\n\t// Check ids must be unique: two checks sharing an id would share one base\n\t// result (review round 7, N19).\n\tif id := duplicateCheckID(matrix, modules); id != \"\" {\n\t\treturn unused(\"the matrix defines check %s more than once\", id)\n\t}\n\tbaseIDs := map[string]bool{}\n\tfor _, check := range base.Checks {\n\t\tif baseIDs[check.ID] {\n\t\t\treturn unused(\"the canonical result records check %s more than once\", check.ID)\n\t\t}\n\t\tbaseIDs[check.ID] = true\n\t}\n\tif err := posemodel.RawGit(\"-C\", root, \"merge-base\", \"--is-ancestor\", base.GitHead, head).Run(); err != nil {\n\t\treturn unused(\"the canonical result's head %s is not an ancestor of HEAD\", base.GitHead)\n\t}\n\tselection, err := computeChangedScope(root, base.GitHead, head, modules, carryExclusions(root, base.GitHead, head, resultsPath)...)\n\tif err != nil {\npackage cli\n\n// Explainable changed-scope validation (spec pose-changed-scope-validation):\n// select the minimum safe set of modules from explicit Git revisions,\n// declared dependency edges and policy. Selection is deterministic for the\n// same base/head/config; every decision carries a reason and every\n// unselected check is recorded as skipped with a machine-readable reason.\n// Uncertainty always widens toward safe execution.\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// safeGitRevRE rejects revisions that could be parsed as options or escape\n// expected forms (confinement: never pass untrusted flags to git).\nvar safeGitRevRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._/~^-]*$`)\n\ntype scopeModuleMeta struct {\n\tCriticality string   `json:\"criticality\"`\n\tDependsOn   []string `json:\"dependsOn\"`\n\t// SelfContained declares that the module's checks read only its own\n\t// directory and its declared dependencies, so a change outside every\n\t// module does not select it (spec pose-validate-carries-unchanged-checks R6).\n\tSelfContained bool `json:\"selfContained\"`\n}\n\ntype scopeMetadata struct {\n\tModules map[string]scopeModuleMeta `json:\"modules\"`\n}\n\n// loadScopeMetadata reads the module metadata. An absent file is empty\n// metadata; a file that does not decode is an error, never a partial\n// reading that could keep an exemption and drop a dependency (review round\n// 3, N6).\nfunc loadScopeMetadata(root string) (scopeMetadata, error) {\n\tvar meta scopeMetadata\n\traw, err := os.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"module-metadata.json\"))\n\tif errors.Is(err, os.ErrNotExist) {\n\t\treturn meta, nil\n\t}\n\tif err != nil {\n\t\treturn meta, fmt.Errorf(\"module metadata is unreadable: %v\", err)\n\t}\n\tif err := json.Unmarshal(raw, &meta); err != nil {\n\t\treturn scopeMetadata{}, fmt.Errorf(\"module metadata does not decode: %v\", err)\n\t}\n\treturn meta, nil\n}\n\n// scopeSelection maps selected module → deterministic selection reason.\ntype scopeSelection struct {\n\tBase, Head string\n\tChanged    []string\n\tSelected   map[string]string\n}\n\nfunc (s scopeSelection) rangeLabel() string {\n\tif s.Head == \"\" {\n\t\treturn s.Base + \"..worktree\"\n\t}\n\treturn s.Base + \"..\" + s.Head\n}\n\n// computeChangedScope resolves the selection. Modules are selected when they\n// contain changed files, depend (transitively) on a changed module, or policy\n// widens them (criticality high). A change outside every module selects\n// every module that does not declare itself self-contained — uncertainty\n// prefers safe execution. Excluded paths (the run's own canonical result) are\n// not changes.\nfunc computeChangedScope(root, base, head string, modules []validationModule, exclude ...string) (scopeSelection, error) {\n\tsel := scopeSelection{Base: base, Head: head, Selected: map[string]string{}}\n\tfor _, rev := range []string{base, head} {\n\t\tif rev != \"\" && !safeGitRevRE.MatchString(rev) {\n\t\t\treturn sel, fmt.Errorf(\"unsafe git revision: %q\", rev)\n\t\t}\n\t}\n\t// NUL-delimited and without rename pairing: a quoted or multi-line name\n\t// keeps its owner, and a rename names both its source and its destination\n\t// (review round 2, N1 and N3).\n\t// Configuration never hides a changed gitlink (review round 8, N23).\n\tgitArgs := []string{\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base}\n\tif head != \"\" {\n\t\tgitArgs = append(gitArgs, head)\n\t}\n\tgitArgs = append(gitArgs, \"--\")\n\tout, err := posemodel.RawGit(gitArgs...).Output()\n\tif err != nil {\n\t\treturn sel, fmt.Errorf(\"git diff %s failed (revision unknown?)\", sel.rangeLabel())\n\t}\n\tfor _, name := range strings.Split(string(out), \"\\x00\") {\n\t\tif name != \"\" {\n\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n\t\t}\n\t}\n\tif head == \"\" {\n\t\t// Worktree comparisons must also see untracked files — invisible new\n\t\t// code must never silently narrow validation (safe execution wins).\n\t\tif untracked, err := posemodel.RawHistoryGit(root, \"ls-files\", \"-z\", \"--others\", \"--exclude-standard\").Output(); err == nil {\n\t\t\tfor _, name := range strings.Split(string(untracked), \"\\x00\") {\n\t\t\t\tif name != \"\" {\n\t\t\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif len(exclude) > 0 {\n\t\texcluded := map[string]bool{}\n\t\tfor _, path := range exclude {\n\t\t\texcluded[filepath.ToSlash(filepath.Clean(path))] = true\n\t\t}\n\t\tkept := sel.Changed[:0]\n\t\tfor _, file := range sel.Changed {\n\t\t\tif !excluded[file] {\n\t\t\t\tkept = append(kept, file)\n\t\t\t}\n\t\t}\n\t\tsel.Changed = kept\n\t}\n\tsort.Strings(sel.Changed)\n\n\tmeta, err := loadScopeMetadata(root)\n\tif err != nil {\n\t\treturn sel, err\n\t}\n\tmoduleOf := func(file string) string {\n\t\tmatch := \"\"\n\t\tfor _, m := range modules {\n\t\t\tif file == m.Rel || strings.HasPrefix(file, m.Rel+\"/\") {\n\t\t\t\tif len(m.Rel) > len(match) {\n\t\t\t\t\tmatch = m.Rel\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn match\n\t}\n\t// Every changed file selects, independently of one another (review rounds\n\t// 2–4, N2, N5, N7, N8):\n\t//   - its most specific owning module;\n\t//   - every module under it (a gitlink or a replaced directory changes what\n\t//     lies beneath);\n\t//   - every module whose declared dependsOn contains it, lies under it, or\n\t//     is the project root \".\", whether or not the dependency is discovered;\n\t//   - when no module owns it: the root module and every module that does\n\t//     not declare itself self-contained (safe execution wins).\n\tselectModule := func(rel, reason string) {\n\t\tif _, ok := sel.Selected[rel]; !ok {\n\t\t\tsel.Selected[rel] = reason\n\t\t}\n\t}\n\tfor _, file := range sel.Changed {\n\t\towner := moduleOf(file)\n\t\tif owner != \"\" {\n\t\t\tselectModule(owner, \"contains changed file: \"+file)\n\t\t\t// An enclosing module's checks may read inside the modules nested\n\t\t\t// in its directory, and the root module encloses them all (review\n\t\t\t// round 9, N25).\n\t\t\tfor _, m := range modules {\n\t\t\t\tif m.Rel != owner && (m.Rel == \".\" || strings.HasPrefix(owner, m.Rel+\"/\")) {\n\t\t\t\t\tselectModule(m.Rel, \"changed file in nested module \"+owner+\": \"+file)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tfor _, m := range modules {\n\t\t\tif m.Rel != \".\" && strings.HasPrefix(m.Rel, file+\"/\") {\n\t\t\t\tselectModule(m.Rel, \"changed path above the module: \"+file)\n\t\t\t}\n\t\t\t// Every eligible dependency counts, whatever its order (review\n\t\t\t// round 5, N11).\n\t\t\t// A dependency that is the file's own owner reaches its dependents\n\t\t\t// through the transitive widening; any other one, discovered or not,\n\t\t\t// selects here (review round 6, N15).\n\t\t\tfor _, dep := range declaredDependencyHits(file, meta.Modules[m.Rel].DependsOn) {\n\t\t\t\tif dep != owner {\n\t\t\t\t\tselectModule(m.Rel, \"declared dependency \"+dep+\" changed: \"+file)\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif owner == \"\" && (m.Rel == \".\" || !meta.Modules[m.Rel].SelfContained) {\n\t\t\t\tselectModule(m.Rel, \"root-level change outside any module: \"+file)\n\t\t\t}\n\t\t}\n\t}\n\t// Policy widening: high-criticality modules always run.\n\tfor _, m := range modules {\n\t\tif meta.Modules[m.Rel].Criticality == \"high\" {\n\t\t\tif _, ok := sel.Selected[m.Rel]; !ok {\n\t\t\t\tsel.Selected[m.Rel] = \"policy: criticality high always runs\"\n\t\t\t}\n\t\t}\n\t}\n\t// Transitive dependents of selected modules (declared edges only).\n\tfor changed := true; changed; {\n\t\tchanged = false\n\t\tfor _, m := range modules {\n\t\t\tif _, ok := sel.Selected[m.Rel]; ok {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfor _, dep := range meta.Modules[m.Rel].DependsOn {\n\t\t\t\tif reason, ok := sel.Selected[filepath.ToSlash(filepath.Clean(dep))]; ok {\n\t\t\t\t\tsel.Selected[m.Rel] = \"depends on selected module \" + dep + \" (\" + firstScopeReason(reason) + \")\"\n\t\t\t\t\tchanged = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn sel, nil\n}\n\n// firstScopeReason keeps chained dependency reasons short and readable.\nfunc firstScopeReason(reason string) string {\n\tif i := strings.Index(reason, \" (\"); i > 0 {\n\t\treturn reason[:i]\n\t}\n\treturn reason\n}\n\n// declaredDependencyHits returns every declared dependency file changes: one\n// it lies in, one it lies above, or the project root \".\", which every file\n// changes.\nfunc declaredDependencyHits(file string, deps []string) []string {\n\tvar hits []string\n\tfor _, dep := range deps {\n\t\tdep = filepath.ToSlash(filepath.Clean(dep))\n\t\tif dep == \".\" || file == dep || strings.HasPrefix(file, dep+\"/\") || strings.HasPrefix(dep, file+\"/\") {\n\t\t\thits = append(hits, dep)\n\t\t}\n\t}\n\treturn hits\n}\n","exit_code":0,"status":"completed"}}
