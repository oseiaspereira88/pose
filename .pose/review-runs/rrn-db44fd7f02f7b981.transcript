{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/internal/pose/material_binding.go | head -110; sed -n '1230,1334p' pose-mcp/internal/cli/validate.go; git diff dec2e64 7dedfabe -- POSE.md locales/pt-BR/POSE.md; cat pose-mcp/internal/cli/validate_engine_identity_test.go\"","aggregated_output":"package pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Validation evidence binds to the material it validated (spec\n// pose-validation-evidence-material-binding, ADR\n// validation-evidence-binds-to-validated-material). A commit whose every\n// changed path is a derived administrative record does not change what the\n// checks exercised, so it does not move the material digest.\n\n// engineVersion is the running engine, registered by the binaries (internal/pose\n// stays importable on its own). It is part of every material digest, so a new\n// engine never inherits evidence the previous one produced.\nvar engineVersion = \"unregistered\"\n\n// SetEngineVersion registers the running engine for material digests.\nfunc SetEngineVersion(v string) { engineVersion = v }\n\n// administrativeDirs is the closed list of derived-record directories. It is\n// owned by the engine; adding a class is a contract change that needs an ADR.\nvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n\n// materialIndexes are files inside an administrative directory that still\n// change what the checks demand.\nvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\n// IsAdministrativePath reports whether p is a derived administrative record.\nfunc IsAdministrativePath(p string) bool {\n\tif p == \"\" || p != path.Clean(p) || strings.HasPrefix(p, \"/\") || strings.HasPrefix(p, \"../\") {\n\t\treturn false\n\t}\n\tif materialIndexes[p] {\n\t\treturn false\n\t}\n\tif !recordExtensions[strings.ToLower(path.Ext(p))] {\n\t\treturn false\n\t}\n\tfor _, dir := range administrativeDirs {\n\t\tif strings.HasPrefix(p, dir) {\n\t\t\treturn true\n\t\t}\n\t}\n\tif rest, ok := strings.CutPrefix(p, \".pose/\"); ok {\n\t\tif i := strings.Index(rest, \"/\"); i > 0 && strings.HasPrefix(rest[:i], \"review-\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// recordExtensions are the data formats a derived record is written in. Code or\n// a script stored in a class is material: that keeps a source file moved or\n// copied into a class from hiding its later edits. A copied data file stays\n// indistinguishable from a record; a check that reads data out of a derived-record\n// directory is outside this contract (ADR validation-evidence-binds-to-validated-material).\nvar recordExtensions = map[string]bool{\".json\": true, \".jsonl\": true, \".ndjson\": true, \".md\": true, \".txt\": true, \".log\": true, \".transcript\": true}\n\n// TreeEntry is one entry of the validated head's tree.\ntype TreeEntry struct{ Mode, Blob string }\n\nfunc regularMode(mode string) bool { return mode == \"100644\" || mode == \"100755\" }\n\n// MaterialInputs are what a material digest is computed from: the paths a change\n// set names (both sides of a rename, and the validation matrix) and the\n// destinations of renames. They are stored with the set so the digest can be\n// recomputed against the current tree without the commits' own records.\ntype MaterialInputs struct {\n\tNames []string `json:\"names\"`\n\tMoved []string `json:\"moved,omitempty\"`\n}\n\n// MaterialInputsOf derives the inputs from per-commit path records. They must\n// be unmerged: folding a create and a later rename into one creation would hide\n// that the file moved into a class.\nfunc MaterialInputsOf(paths []ObservedPath) MaterialInputs {\n\tnames := map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\tmoved := map[string]bool{}\n\tfor _, p := range paths {\n\t\tfor _, name := range []string{p.Path, p.OldPath, p.NewPath} {\n\t\t\tif name != \"\" {\n\t\t\t\tnames[name] = true\n\t\t\t}\n\t\t}\n\t\t// A rename destination is material whatever directory it lands in:\n\t\t// otherwise moving a source file into a class would hide its later edits.\n\t\tif p.OldPath != \"\" && p.NewPath != \"\" {\n\t\t\tmoved[p.NewPath] = true\n\t\t}\n\t}\n\tin := MaterialInputs{}\n\tfor name := range names {\n\t\tin.Names = append(in.Names, name)\n\t}\n\tfor name := range moved {\n\t\tin.Moved = append(in.Moved, name)\n\t}\n\tsort.Strings(in.Names)\n\tsort.Strings(in.Moved)\n\treturn in\n}\n\n// MaterialSetDigest digests the head state of the material a change set\n\t\t\tif check.Program != \"\" {\n\t\t\t\tplanned++\n\t\t\t}\n\t\t}\n\t}\n\tsteps := r.Steps(planned)\n\tvar entries []*validationEntry\n\tfor _, module := range modules {\n\t\toverride := matrix.ModuleOverrides[module.Rel]\n\t\tstack := module.Stack\n\t\tif override.Stack != \"\" {\n\t\t\tstack = override.Stack\n\t\t}\n\t\tif stackFilter != \"\" && stack != stackFilter || moduleFilter != \"\" && module.Rel != moduleFilter {\n\t\t\tcontinue\n\t\t}\n\t\tchecks := append([]validationCheck(nil), matrix.Stacks[stack].Checks...)\n\t\tif override.ReplaceDefaultChecks {\n\t\t\tchecks = nil\n\t\t}\n\t\tchecks = append(checks, override.Checks...)\n\t\tif scope != nil {\n\t\t\tif _, selected := scope.Selected[module.Rel]; !selected {\n\t\t\t\t// R3: every unselected check keeps a machine-readable reason.\n\t\t\t\treason := \"changed-scope: module not affected by \" + scope.rangeLabel()\n\t\t\t\tfor _, check := range checks {\n\t\t\t\t\tif check.Program == \"\" {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tseverity := check.Severity\n\t\t\t\t\tif severity == \"\" {\n\t\t\t\t\t\tseverity = \"required\"\n\t\t\t\t\t}\n\t\t\t\t\tentries = append(entries, &validationEntry{check: check, severity: severity, skip: reason, silent: true, result: checkResult{\n\t\t\t\t\t\tID: module.Rel + \"/\" + stack + \"/\" + check.Name, Module: module.Rel,\n\t\t\t\t\t\tStack: stack, Name: check.Name, Program: check.Program,\n\t\t\t\t\t\tArgs: check.Args, Env: redactedEnv(check.Env), Severity: severity, EvidenceClass: check.EvidenceClass,\n\t\t\t\t\t}})\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif carryState.carried(module.Rel) {\n\t\t\tfor _, check := range checks {\n\t\t\t\tif check.Program == \"\" {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n\t\t\t\tentries = append(entries, &validationEntry{check: check, silent: true, carried: true, result: carryState.carriedResult(id)})\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tmoduleMode := mode\n\t\tif override.Mode != \"\" {\n\t\t\tmoduleMode = override.Mode\n\t\t}\n\t\tentries = append(entries, &validationEntry{note: fmt.Sprintf(\"[module] %s (%s, mode=%s)\", module.Rel, stack, moduleMode)})\n\t\tfor _, check := range checks {\n\t\t\tif check.Program == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseverity := check.Severity\n\t\t\tif severity == \"\" {\n\t\t\t\tseverity = \"required\"\n\t\t\t}\n\t\t\tentry := &validationEntry{check: check, moduleDir: module.Abs, severity: severity, done: make(chan struct{}), result: checkResult{\n\t\t\t\tID: module.Rel + \"/\" + stack + \"/\" + check.Name, Module: module.Rel,\n\t\t\t\tStack: stack, Name: check.Name, Program: check.Program,\n\t\t\t\tArgs: check.Args, Env: redactedEnv(check.Env), Severity: severity, EvidenceClass: check.EvidenceClass,\n\t\t\t}}\n\t\t\tif check.Isolation == \"required\" {\n\t\t\t\t// The local CLI never weakens its boundary: isolated\n\t\t\t\t// execution is delegated to the Harness via --emit-plan.\n\t\t\t\tentry.skip = \"requires isolated execution (harness) — include via --emit-plan\"\n\t\t\t\tentry.isolated = true\n\t\t\t}\n\t\t\tentries = append(entries, entry)\n\t\t}\n\t}\n\t// Checks run up to jobs at a time; results are shown and counted here,\n\t// in matrix order, whatever order they finish in (spec\n\t// pose-validate-concurrent-steps R1). --verbose streams a check's output,\n\t// so it runs them one at a time.\n\tif jobs == 0 {\n\t\tjobs = defaultValidationJobs(effectiveValidationResources(os.ReadFile, runtime.NumCPU()))\n\t}\n\tif verbose {\n\t\tjobs = 1\n\t}\n\trun.Jobs = jobs\n\trunCtx, stopSignals := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stopSignals()\n\t// The first signal cancels the run; a second one acts as it always did,\n\t// even while the run shuts down (review round 1, B4).\n\tgo func() {\n\t\t<-runCtx.Done()\n\t\tstopSignals()\n\t}()\n\twallStart := time.Now()\n\tif jobs > 1 {\n\t\tgo dispatchValidationEntries(runCtx, entries, jobs, matrix)\n\t}\n\tfor _, entry := range entries {\n\t\tif entry.note != \"\" {\n\t\t\tsteps.Note(entry.note)\ndiff --git a/POSE.md b/POSE.md\nindex 4621ed21..ac35d797 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -215,7 +215,7 @@ pose new-knowledge <type> <slug>   # create handoff/note/decision-log\n pose check [--strict|--tolerant]   # structural integrity + matrix schema +\n                                    # task-map sync + spec graph + schema version\n pose validate [--strict|--tolerant] [--stack s] [--module path] [--report] [--json-out f] [--junit f] [--sarif f]\n-              [--changed-from rev [--changed-to rev]] [--jobs n] [--explain] [--emit-plan f]\n+              [--changed-from rev [--changed-to rev] | --carry] [--jobs n] [--explain] [--emit-plan f]\n pose lint-spec <slug>|--all [--strict|--tolerant] [--required-only] [--ready-check] [--design-check]\n pose knowledge-check [--strict|--tolerant] [--max-overdue N]\n pose recurrence-check [--strict|--tolerant] [--window-days N] [--threshold T] [--flap-threshold N] [--include-pass]\n@@ -350,7 +350,9 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `new-knowledge` — creates an artifact in [`.pose/knowledge/`](.pose/knowledge/) from [`.pose/templates/knowledge.md`](.pose/templates/knowledge.md) with mandatory frontmatter (`type`, `owner`, `sensitivity`, `created_at`, `last_reviewed_at`, `expires_at`). Computes `expires_at` from the TTL (default 30d, max 90d).\n - `validate` — runs the declarative matrix in [`validation-matrix.json`](.pose/indexes/validation-matrix.json): per-stack checks, per-module overrides, severity (`required`/`optional`) and mode (`strict`/`tolerant`). `--json-out`/`--junit`/`--sarif <path>` (`--json <path>` still works as a deprecated alias of `--json-out <path>`) emit the versioned structured result (schema 1) from one canonical model: stable check IDs (`<module>/<stack>/<name>`), command metadata, timing, severity, distinguishable outcomes (`pass|fail|error|skipped` — infra failures never masquerade as check failures), deterministic skip reasons, bounded captured output and secret redaction (configured env values only; inherited environment never enters the result). Text output stays authoritative; machine formats are additive. POSE-specific semantics survive the JUnit/SARIF projections via documented extensions (classname suffix / `pose/*` properties).\n   **Runtime guardrails:** every check runs under a timeout (`timeoutSeconds` per check, `defaults.timeoutSeconds`, safe default 600s) and an output ceiling (`defaults.maxOutputBytes`, default 1 MiB); breaching either terminates the process group and records the explicit state (`limit_state: timeout|output-limit`). Checks marked `isolation: \"required\"` never run locally — they are skipped with a machine-readable reason and exported by `--emit-plan <file>`: an execution-plan envelope binding project, spec, check plan, matrix digest, git HEAD and an approval slot to be stamped with an expiring execution identity before the Harness may run it.\n-  **Changed scope:** `--changed-from <rev> [--changed-to <rev>]` selects the minimum safe module set deterministically — modules containing changed files (tracked and untracked), transitive dependents via `dependsOn` edges in [`module-metadata.json`](.pose/indexes/module-metadata.json), and policy widening (criticality `high` always runs). A change outside every module runs everything (uncertainty prefers safe execution); unselected checks are recorded as skipped with the selection reason and `--explain` prints every decision. Revisions are confined to a safe grammar; without the flags, full validation is unchanged.\n+  **Changed scope:** `--changed-from <rev> [--changed-to <rev>]` selects the minimum safe module set deterministically — modules containing changed files (tracked and untracked), transitive dependents via `dependsOn` edges in [`module-metadata.json`](.pose/indexes/module-metadata.json), and policy widening (criticality `high` always runs). Changed names are read NUL-delimited and a rename names both its source and its destination. Each changed file selects its most specific owning module, every module enclosing that owner (the root module encloses them all), every module beneath it (a gitlink or replaced directory changes what lies under it), and every module whose declared `dependsOn` contains it, lies beneath it or is the root `.`, even after that dependency is deleted. A file no module owns selects the root module. Module metadata that does not decode stops the selection (a full run under `--carry`, an error under `--changed-from`). A change outside every module runs every module that does not declare `\"selfContained\": true` in its metadata (uncertainty prefers safe execution; the declaration states that the module's checks read only its own directory and its `dependsOn` modules); unselected checks are recorded as skipped with the selection reason and `--explain` prints every decision. Revisions are confined to a safe grammar; without the flags, full validation is unchanged.\n+\n+  **Carried checks:** `--carry --json-out <results_path>` refreshes the canonical result instead of rerunning the whole matrix. It uses the current canonical result as its base when the base is comparable: same schema, mode, matrix digest and `engine_version` (the engine version plus the VCS revision the binary was built from; a build of a modified tree never carries), unfiltered, not cancelled, recorded `material_clean` (it validated an unchanged working copy of its own head: no tracked or untracked unignored material changed and HEAD did not move while it ran, as its reflog shows; mode changes count whatever `core.fileMode` says, and every submodule must hold its recorded commit) with no unavailable material binding, with its `git_head` an ancestor of `HEAD`, a clean material working copy now, a case-sensitive filesystem with no case-folded directory on the path to a module or a dependency, no module reached through a symlink or sharing its directory with another module, no tracked symlink whose path or target lies in a module other than the root or in a declared `dependsOn` (or whose target leaves the repository), every submodule's tree included (a submodule that is not checked out or has nested submodules refuses), no declared dependency outside the repository or written as an unclean path or resolving through a symlink (tracked or ignored), only ASCII module and dependency paths, no index entry marked assume-unchanged or skip-worktree, and no check id defined twice. Changed names are read with every gitlink shown, whatever the Git configuration. The head is pinned before planning, and a run whose HEAD moved records its material bindings as unavailable. It runs the modules the changed-scope rules select between the base head and `HEAD`; the canonical result file and the derived administrative records that material bindings ignore (data files that are still regular files in the derived-record directories under `.pose/`: indexes, results, state, assessments and review records; the validation matrix stays material) are not changes. A module whose checks are not all in the base also runs. Every other check keeps the base result, its outcome included, and records `carried_from` (the head it ran at, kept through chained carries) and `carried_generated_at`; the delivery index reads that head for the result, so evidence freshness judges the commit a carried check really observed. A carried failure still fails the run. Any unmet condition runs everything, and `carry.reason` says why. `carry` records the base, the number of changed files and each selected module's reason, and `counts.carried` the reused checks. `--carry` does not combine with `--module`, `--stack`, `--workspace`, `--root-only`, `--changed-from` or `--changed-to`.\n \n   **Concurrency:** checks run up to `--jobs <n>` at a time (default: half the cores, bounded by available memory at about 1.5 GiB per check and by 8); results are reported and recorded in matrix order, whatever order they finish in, and the report records `jobs` and `wall_seconds`. `--jobs 1` and `--verbose` run one at a time. A check marked `exclusive: true` runs with nothing else running: earlier checks finish first, so its `when` can depend on them, which a concurrent check's cannot — a check's `when` is read as it starts. The run ends with its wall time beside the sum of its checks and the slowest checks. An interrupt or SIGTERM stops every running check's process group (on Windows, its process) and starts nothing more; those checks are recorded with `limit_state: cancelled`, the run is `fail` and exits 1, and a second signal acts at once. A default `--jobs` follows the cgroup's memory headroom and CPU quota where there is one.\n \ndiff --git a/locales/pt-BR/POSE.md b/locales/pt-BR/POSE.md\nindex df424ce4..a05bf1cb 100644\n--- a/locales/pt-BR/POSE.md\n+++ b/locales/pt-BR/POSE.md\n@@ -219,7 +219,7 @@ pose new-knowledge <type> <slug>   # cria handoff/note/decision-log em .pose/kno\n pose check [--strict|--tolerant]   # integridade estrutural + matrix schema +\n                                    # task-map sync + grafo de specs + schema version\n pose validate [--strict|--tolerant] [--stack s] [--module path] [--report] [--json-out f] [--junit f] [--sarif f]\n-              [--changed-from rev [--changed-to rev]] [--jobs n] [--explain] [--emit-plan f]\n+              [--changed-from rev [--changed-to rev] | --carry] [--jobs n] [--explain] [--emit-plan f]\n pose lint-spec <slug>|--all [--strict|--tolerant] [--required-only] [--ready-check] [--design-check]\n pose knowledge-check [--strict|--tolerant] [--max-overdue N]\n pose recurrence-check [--strict|--tolerant] [--window-days N] [--threshold T] [--flap-threshold N] [--include-pass]\n@@ -354,7 +354,9 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `new-knowledge` — cria artefato em [`.pose/knowledge/`](.pose/knowledge/) a partir de [`.pose/templates/knowledge.md`](.pose/templates/knowledge.md) com frontmatter obrigatório (`type`, `owner`, `sensitivity`, `created_at`, `last_reviewed_at`, `expires_at`). Calcula `expires_at` pelo TTL (default 30d, máximo 90d).\n - `validate` — executa a matriz declarativa em [`validation-matrix.json`](.pose/indexes/validation-matrix.json): checks por stack, overrides por módulo, severidade (`required`/`optional`) e modo (`strict`/`tolerant`). `--json-out`/`--junit`/`--sarif <path>` (`--json <path>` continua funcionando como alias depreciado de `--json-out <path>`) emitem o resultado estruturado versionado (schema 1) a partir de um único modelo canônico: IDs estáveis de check (`<module>/<stack>/<name>`), metadados de comando, tempo, severidade, outcomes distinguíveis (`pass|fail|error|skipped` — falha de infraestrutura nunca se disfarça de falha de check), motivos determinísticos de skip, saída capturada com limite e redação de segredos (apenas valores de env configurados; o ambiente herdado nunca entra no resultado). A saída em texto continua autoritativa; os formatos de máquina são aditivos. A semântica específica do POSE sobrevive às projeções JUnit/SARIF via extensões documentadas (sufixo de classname / propriedades `pose/*`).\n   **Guardrails de runtime:** todo check roda sob timeout (`timeoutSeconds` por check, `defaults.timeoutSeconds`, default seguro 600s) e teto de saída (`defaults.maxOutputBytes`, default 1 MiB); violar qualquer um encerra o process group e registra o estado explícito (`limit_state: timeout|output-limit`). Checks marcados `isolation: \"required\"` nunca rodam localmente — são pulados com motivo legível por máquina e exportados por `--emit-plan <file>`: um envelope de plano de execução vinculando projeto, spec, plano de checks, digest da matriz, git HEAD e um slot de aprovação a ser carimbado com identidade de execução expirável antes que o Harness possa executá-lo.\n-  **Escopo por mudança:** `--changed-from <rev> [--changed-to <rev>]` seleciona deterministicamente o conjunto mínimo seguro de módulos — módulos com arquivos alterados (rastreados e não rastreados), dependentes transitivos via arestas `dependsOn` em [`module-metadata.json`](.pose/indexes/module-metadata.json) e alargamento por política (criticidade `high` sempre roda). Uma mudança fora de todos os módulos roda tudo (na incerteza, prefere-se execução segura); checks não selecionados são registrados como skipped com o motivo da seleção e `--explain` imprime cada decisão. Revisões ficam confinadas a uma gramática segura; sem as flags, a validação completa é inalterada.\n+  **Escopo por mudança:** `--changed-from <rev> [--changed-to <rev>]` seleciona deterministicamente o conjunto mínimo seguro de módulos — módulos com arquivos alterados (rastreados e não rastreados), dependentes transitivos via arestas `dependsOn` em [`module-metadata.json`](.pose/indexes/module-metadata.json) e alargamento por política (criticidade `high` sempre roda). Os nomes alterados são lidos delimitados por NUL, e um rename nomeia a origem e o destino. Cada arquivo alterado seleciona o módulo dono mais específico, todo módulo que envolve esse dono (o módulo raiz envolve todos), todo módulo abaixo dele (um gitlink ou diretório substituído altera o que está abaixo) e todo módulo cujo `dependsOn` declarado o contém, está abaixo dele ou é a raiz `.`, mesmo depois que essa dependência é apagada. Um arquivo que nenhum módulo possui seleciona o módulo raiz. Metadados de módulo que não decodificam interrompem a seleção (execução completa com `--carry`, erro com `--changed-from`). Uma mudança fora de todos os módulos roda todo módulo que não declara `\"selfContained\": true` nos seus metadados (na incerteza, prefere-se execução segura; a declaração afirma que os checks do módulo só leem o próprio diretório e os módulos de `dependsOn`); checks não selecionados são registrados como skipped com o motivo da seleção e `--explain` imprime cada decisão. Revisões ficam confinadas a uma gramática segura; sem as flags, a validação completa é inalterada.\n+\n+  **Checks carregados:** `--carry --json-out <results_path>` renova o resultado canônico em vez de rodar a matriz inteira de novo. Ele usa o resultado canônico atual como base quando a base é comparável: mesmo schema, modo, digest da matriz e `engine_version` (a versão do motor mais a revisão VCS da qual o binário foi compilado; um build de árvore modificada nunca carrega), sem filtro, não cancelada, com `material_clean` registrado (validou uma cópia de trabalho inalterada do próprio head: nenhum material rastreado ou não rastreado e não ignorado mudou, e o HEAD não se moveu durante o run, segundo o reflog; mudanças de modo contam qualquer que seja `core.fileMode`, e todo submódulo precisa estar no commit registrado) e sem binding de material indisponível, com `git_head` ancestral de `HEAD` cópia de trabalho limpa agora nos paths materiais sistema de arquivos que diferencia maiúsculas, sem diretório com casefold no caminho até um módulo ou uma dependência, nenhum módulo alcançado por symlink ou compartilhando diretório com outro módulo, nenhum symlink rastreado cujo path ou alvo esteja num módulo que não seja a raiz ou num `dependsOn` declarado (ou cujo alvo saia do repositório), inclusive na árvore de todo submódulo (um submódulo sem checkout ou com submódulos aninhados recusa), nenhuma dependência declarada fora do repositório ou escrita como path não limpo ou que resolve por symlink (rastreado ou ignorado), apenas paths ASCII de módulo e dependência, nenhuma entrada de índice marcada assume-unchanged ou skip-worktree, e nenhum id de check definido duas vezes. Os nomes alterados são lidos com todo gitlink visível, qualquer que seja a configuração do Git. O head é fixado antes do planejamento, e um run cujo HEAD se moveu registra seus bindings de material como indisponíveis. Roda os módulos que as regras de escopo por mudança selecionam entre o head da base e `HEAD`; o arquivo do resultado canônico e os registros administrativos derivados que o binding de material ignora (arquivos de dados ainda regulares nos diretórios de registros derivados sob `.pose/`: índices, resultados, estado, assessments e registros de revisão; a matriz de validação continua material) não contam como mudança. Um módulo cujos checks não estão todos na base também roda. Todo outro check mantém o resultado da base, inclusive o desfecho, e registra `carried_from` (o head em que rodou, mantido em carregamentos encadeados) e `carried_generated_at`; o índice de entrega lê esse head no resultado, então o frescor da evidência julga o commit que um check carregado realmente observou. Uma falha carregada continua reprovando o run. Qualquer condição não atendida roda tudo, e `carry.reason` diz por quê. `carry` registra a base, o número de arquivos alterados e o motivo de cada módulo selecionado, e `counts.carried` os checks reaproveitados. `--carry` não combina com `--module`, `--stack`, `--workspace`, `--root-only`, `--changed-from` ou `--changed-to`.\n \n   **Concorrência:** os checks rodam até `--jobs <n>` ao mesmo tempo (padrão: metade dos núcleos, limitada pela memória disponível, cerca de 1,5 GiB por check, e por 8); os resultados são mostrados e registrados na ordem da matriz, seja qual for a ordem em que terminem, e o relatório registra `jobs` e `wall_seconds`. `--jobs 1` e `--verbose` rodam um de cada vez. Um check marcado `exclusive: true` roda sem nenhum outro em execução: os checks anteriores terminam antes, então seu `when` pode depender deles, o que o de um check concorrente não pode — o `when` de um check é lido quando ele vai começar. A execução termina com seu tempo de parede ao lado da soma dos checks e os checks mais lentos. Uma interrupção ou SIGTERM encerra o grupo de processos de cada check em execução (no Windows, seu processo) e não inicia mais nada; esses checks são registrados com `limit_state: cancelled`, a execução fica `fail` e sai com 1, e um segundo sinal age na hora. O `--jobs` padrão segue a folga de memória e a cota de CPU do cgroup, quando há um.\n \npackage cli\n\nimport (\n\t\"runtime/debug\"\n\t\"testing\"\n\n\t\"github.com/harne8/pose-mcp/internal/version\"\n)\n\n// A modified build is not a comparable engine identity (spec\n// pose-validate-carries-unchanged-checks, review round 2, N4).\nfunc TestEngineIdentityRefusesModifiedBuilds(t *testing.T) {\n\tinfo := func(settings ...debug.BuildSetting) *debug.BuildInfo { return &debug.BuildInfo{Settings: settings} }\n\tcases := []struct {\n\t\tname       string\n\t\tinfo       *debug.BuildInfo\n\t\twant       string\n\t\tverifiable bool\n\t}{\n\t\t{\"clean\", info(debug.BuildSetting{Key: \"vcs.revision\", Value: \"abc\"}, debug.BuildSetting{Key: \"vcs.modified\", Value: \"false\"}), version.Version + \"+abc\", true},\n\t\t{\"modified\", info(debug.BuildSetting{Key: \"vcs.revision\", Value: \"abc\"}, debug.BuildSetting{Key: \"vcs.modified\", Value: \"true\"}), version.Version + \"+abc.dirty\", false},\n\t\t{\"unstamped\", info(), version.Version, true},\n\t}\n\tfor _, tc := range cases {\n\t\tgot, verifiable := engineIdentityFrom(tc.info, true)\n\t\tif got != tc.want || verifiable != tc.verifiable {\n\t\t\tt.Fatalf(\"%s: identity %q verifiable %v, want %q %v\", tc.name, got, verifiable, tc.want, tc.verifiable)\n\t\t}\n\t}\n}\n","exit_code":0,"status":"completed"}}
