rn 2\n  1057\t\t}\n  1058\t\tif err := validateStructuredMatrixPaths(matrix); err != nil {\n  1059\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid validation matrix path: %v\\n\", \"Erro: path inválido na matriz de validação: %v\\n\"), err)\n  1060\t\t\treturn 2\n  1061\t\t}\n  1062\t\tif err := validateDeliveryMatrixContract(matrix); err != nil {\n  1063\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid delivery validation contract: %v\\n\", \"Erro: contrato de validação de delivery inválido: %v\\n\"), err)\n  1064\t\t\treturn 2\n  1065\t\t}\n  1066\t\tif matrixHasLegacyChecks(matrix) {\n  1067\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: legacy shell 'command' checks are unsupported; migrate each check to program + args + env.\", \"Erro: checks shell legados em 'command' não são suportados; migre cada check para program + args + env.\"))\n  1068\t\t\treturn 2\n  1069\t\t}\n  1070\t\tif mode == \"\" {\n  1071\t\t\tmode = matrix.Defaults.Mode\n  1072\t\t\tif mode == \"\" {\n  1073\t\t\t\tmode = \"strict\"\n  1074\t\t\t}\n  1075\t\t}\n  1076\t\tmodules, err := discoverValidationModules(root)\n  1077\t\tif err != nil {\n  1078\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: discovering modules: %v\\n\", \"Erro: descobrir módulos: %v\\n\"), err)\n  1079\t\t\treturn 1\n  1080\t\t}\n  1081\t\tif workspaceFilter != \"\" {\n  1082\t\t\tresolved, ok := resolveWorkspaceModulePath(root, modules, workspaceFilter)\n  1083\t\t\tif !ok {\n  1084\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: no module's manifest name matches --workspace %q.\\n\", \"Erro: nenhum module tem name de manifesto igual a --workspace %q.\\n\"), workspaceFilter)\n  1085\t\t\t\treturn 2\n  1086\t\t\t}\n  1087\t\t\tmoduleFilter = resolved\n  1088\t\t}\n  1089\t\tknownModules := map[string]bool{}\n  1090\t\tfor _, module := range modules {\n  1140\t\t\t\t}\n  1141\t\t\t}\n  1142\t\t}\n  1143\t\trun := validationRunResult{\n  1144\t\t\tSchemaVersion: validationResultSchema,\n  1145\t\t\tGeneratedAt:   time.Now().UTC().Format(time.RFC3339),\n  1146\t\t\tMode:          mode,\n  1147\t\t\tStackFilter:   stackFilter,\n  1148\t\t\tModuleFilter:  moduleFilter,\n  1149\t\t\tChecks:        []checkResult{},\n  1150\t\t}\n  1151\t\tmatrixDigest := sha256.Sum256(raw)\n  1152\t\trun.MatrixSHA256 = \"sha256:\" + hex.EncodeToString(matrixDigest[:])\n  1153\t\trun.EngineVersion = validationEngineIdentity()\n  1154\t\t// The head is pinned before anything is planned: selection, carried\n  1155\t\t// results and the end-of-run comparison all name this one commit (review\n  1156\t\t// round 5, N14).\n  1157\t\trun.GitHead = pinnedHead\n  1158\t\tstartedClean := materialWorktreeClean(root)\n  1159\t\tvar carryState carryPlan\n  1160\t\tif carry {\n  1161\t\t\tcarryState = planCarry(root, canonicalResultsPath, mode, run.MatrixSHA256, run.GitHead, matrix, modules)\n  1162\t\t\trun.Carry = carryState.record\n  1163\t\t\tout := render(stdout, stderr)\n  1164\t\t\tif !carryState.record.Used {\n  1165\t\t\t\tout.ContractLine(\"[carry] full run: \" + carryState.record.Reason)\n  1166\t\t\t} else {\n  1167\t\t\t\tout.ContractLine(fmt.Sprintf(\"[carry] base %s: %d changed file(s), %d/%d module(s) run\", carryState.record.BaseHead, carryState.record.Changed, len(carryState.record.Selected), len(modules)))\n  1168\t\t\t\tif explain {\n  1169\t\t\t\t\tfor _, m := range modules {\n  1170\t\t\t\t\t\tif reason, ok := carryState.record.Selected[m.Rel]; ok {\n  1171\t\t\t\t\t\t\tout.ContractLine(\"  + \" + m.Rel + \": \" + reason)\n  1172\t\t\t\t\t\t} else {\n  1173\t\t\t\t\t\t\tout.ContractLine(\"  = \" + m.Rel + \": carried from \" + carryState.record.BaseHead)\n  1174\t\t\t\t\t\t}\n  1175\t\t\t\t\t}\n  1176\t\t\t\t}\n  1177\t\t\t}\n  1178\t\t}\n  1179\t\tif graph, err := buildCurrentDeliveryGraph(root); err == nil {\n  1180\t\t\trun.ProvenanceDigest = graph.ProvenanceDigest\n  1181\t\t\trun.ScopeProvenance = map[string]string{}\n  1182\t\t\tseenSpecs := map[string]bool{}\n  1183\t\t\tfor _, set := range graph.ChangeSets {\n  1184\t\t\t\tif set.Spec != \"\" {\n  1185\t\t\t\t\tseenSpecs[set.Spec] = true\n  1186\t\t\t\t}\n  1187\t\t\t}\n  1188\t\t\t// The binding names the committed tree. Checks run on the working copy, so a\n  1189\t\t\t// working copy that differs from it in any material path validated something\n  1190\t\t\t// else: the run then records the binding as unavailable.\n  1191\t\t\tclean := materialWorktreeClean(root)\n  1192\t\t\tfor spec := range seenSpecs {\n  1193\t\t\t\trun.ScopeProvenance[spec] = posemodel.ScopedDeliveryProvenanceDigest(graph, spec)\n  1194\t\t\t\tif !clean {\n  1195\t\t\t\t\tif run.MaterialProvenance == nil {\n  1425\t\t\t}\n  1426\t\t\trun.Checks = append(run.Checks, *result)\n  1427\t\t}\n  1428\t\trun.WallSeconds = time.Since(wallStart).Seconds()\n  1429\t\t// A check that changed a tracked file changed the material it ran over: the\n  1430\t\t// committed tree no longer describes what was validated.\n  1431\t\tendedClean := materialTrackedUnchanged(root)\n  1432\t\t// The run validated its recorded head only if HEAD never moved: a commit\n  1433\t\t// made while checks ran would let them observe code the record does not\n  1434\t\t// name (review round 4, N10).\n  1435\t\tendHead := \"\"\n  1436\t\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n  1437\t\t\tendHead = strings.TrimSpace(string(head))\n  1438\t\t}\n  1439\t\t// Untracked material created while checks ran counts too (review round 8,\n  1440\t\t// N21): only ignored files may differ from the recorded head.\n  1441\t\thidden, hiddenErr := hiddenIndexEntries(root, run.GitHead)\n  1442\t\t// Equal endpoints do not show HEAD never moved: H -> H' -> H leaves them\n  1443\t\t// equal. The reflog must not have grown (review round 12, N34).\n  1444\t\tendReflog := headReflogLength(root)\n  1445\t\t// Every submodule must hold its recorded commit: an uninitialized one\n  1446\t\t// reads as clean while its material is absent (review round 13, N38).\n  1447\t\tsubmodulesOK := run.GitHead != \"\" && submodulesCheckedOut(root, run.GitHead) == \"\"\n  1448\t\trun.MaterialClean = startedClean && endedClean && materialWorktreeClean(root) && run.GitHead != \"\" && endHead == run.GitHead && hiddenErr == nil && hidden == \"\" && startReflog >= 0 && endReflog == startReflog && submodulesOK\n  1449\t\t// A run that did not validate its recorded head binds no material: its\n  1450\t\t// bindings would let a later tree make a misattributed pass current again\n  1451\t\t// (review round 5, N12).\n  1452\t\tif len(run.MaterialProvenance) > 0 && !run.MaterialClean {\n  1453\t\t\tfor spec := range run.MaterialProvenance {\n  1454\t\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n  1455\t\t\t}\n  1456\t\t}\n  1457\t\t// A cancelled run never reads as a success, whatever the severity of the\n  1458\t\t// checks it stopped (review round 1, B5).\n  1459\t\tcancelled := false\n  1460\t\tfor _, check := range run.Checks {\n  1461\t\t\tcancelled = cancelled || check.LimitState == \"cancelled\"\n  1462\t\t}\n  1463\t\tfor _, line := range validationTimingNotes(run) {\n  1464\t\t\tsteps.Note(line)\n  1465\t\t}\n  1595\t\tchecks := append([]validationCheck(nil), matrix.Stacks[stack].Checks...)\n  1596\t\tif override.ReplaceDefaultChecks {\n  1597\t\t\tchecks = nil\n  1598\t\t}\n  1599\t\treturn stack, append(checks, override.Checks...), true\n  1600\t}\n  1601\t\n  1602\t// tailLines keeps the last n lines of a check's captured output: enough to see\n  1603\t// why it failed, with the full output one path away.\n  1604\tfunc tailLines(text string, n int) string {\n  1605\t\tlines := strings.Split(strings.TrimRight(text, \"\\n\"), \"\\n\")\n  1606\t\tif len(lines) <= n {\n  1607\t\t\treturn strings.Join(lines, \"\\n\")\n  1608\t\t}\n  1609\t\treturn strings.Join(lines[len(lines)-n:], \"\\n\")\n  1610\t}\n  1611\t\n  1612\tfunc validationSummaryOf(run validationRunResult) *validationSummary {\n  1613\t\tsummary := &validationSummary{Outcome: run.Outcome}\n  1614\t\tfor _, check := range run.Checks {\n  1615\t\t\tcommand := strings.TrimSpace(check.Program + \" \" + strings.Join(check.Args, \" \"))\n  1616\t\t\tif check.Outcome != \"skipped\" && command != \"\" {\n  1617\t\t\t\tsummary.Commands = append(summary.Commands, command)\n  1618\t\t\t}\n  1619\t\t\tline := \"- [\" + check.Outcome + \"] \" + check.ID\n  1620\t\t\tswitch {\n  1621\t\t\tcase check.SkipReason != \"\":\n  1622\t\t\t\tline += \" (\" + check.SkipReason + \")\"\n  1623\t\t\tcase check.DurationSeconds > 0:\n  1624\t\t\t\tline += fmt.Sprintf(\" (%.1fs)\", check.DurationSeconds)\n  1625\t\t\t}\n  1626\t\t\tif check.ExitCode != nil {\n  1627\t\t\t\tline += fmt.Sprintf(\" exit=%d\", *check.ExitCode)\n  1628\t\t\t}\n  1629\t\t\tsummary.Results = append(summary.Results, line)\n  1630\t\t}\n  1700\t\t\t\tnewArgs = append(newArgs, filteredPkgs...)\n  1701\t\t\t} else {\n  1702\t\t\t\tnewArgs = append(newArgs, a)\n  1703\t\t\t}\n  1704\t\t}\n  1705\t\treturn newArgs\n  1706\t}\n  1707\t\n  1708\t// materialWorktreeClean reports whether the working copy equals HEAD in every\n  1709\t// path outside the administrative classes, untracked files included. A status\n  1710\t// that cannot be read is not clean.\n  1711\tfunc materialWorktreeClean(root string) bool {\n  1712\t\t// Mode changes count whatever core.fileMode says (review round 13, N36).\n  1713\t\tout, err := gitOutputBounded(root, 16*1024*1024, \"-c\", \"core.fileMode=true\", \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n  1714\t\tif err != nil {\n  1715\t\t\treturn false\n  1716\t\t}\n  1717\t\trecords := strings.Split(string(out), \"\\x00\")\n  1718\t\tvar administrative []string\n  1719\t\tfor i := 0; i < len(records); i++ {\n  1720\t\t\trecord := records[i]\n  1721\t\t\tif len(record) < 4 {\n  1722\t\t\t\tcontinue\n  1723\t\t\t}\n  1724\t\t\tpaths := []string{record[3:]}\n  1725\t\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n  1726\t\t\t\t// A rename or copy carries its source as the next record.\n  1727\t\t\t\tif i+1 < len(records) {\n  1728\t\t\t\t\ti++\n  1729\t\t\t\t\tpaths = append(paths, records[i])\n  1730\t\t\t\t}\n  1731\t\t\t}\n  1732\t\t\tfor _, p := range paths {\n  1733\t\t\t\tif !posemodel.IsAdministrativePath(p) {\n  1734\t\t\t\t\treturn false\n  1735\t\t\t\t}\n  1736\t\t\t\tadministrative = append(administrative, p)\n  1737\t\t\t}\n  1738\t\t}\n  1739\t\treturn administrativeRecordsAreRegular(root, administrative)\n  1740\t}\n  1741\t\n  1742\t// materialTrackedUnchanged reports whether no tracked file differs from HEAD\n  1743\t// outside the administrative records. Untracked files are not counted: checks\n  1744\t// leave build products behind, and those are not the material they ran over.\n  1745\tfunc materialTrackedUnchanged(root string) bool {\n  1746\t\tout, err := gitOutputBounded(root, 16*1024*1024, \"-c\", \"core.fileMode=true\", \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=no\")\n  1747\t\tif err != nil {\n  1748\t\t\treturn false\n  1749\t\t}\n  1750\t\trecords := strings.Split(string(out), \"\\x00\")\n  1751\t\tvar administrative []string\n  1752\t\tfor i := 0; i < len(records); i++ {\n  1753\t\t\trecord := records[i]\n  1754\t\t\tif len(record) < 4 {\n  1755\t\t\t\tcontinue\n  1756\t\t\t}\n  1757\t\t\tpaths := []string{record[3:]}\n  1758\t\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n  1759\t\t\t\tif i+1 < len(records) {\n  1760\t\t\t\t\ti++\n  1761\t\t\t\t\tpaths = append(paths, records[i])\n  1762\t\t\t\t}\n  1763\t\t\t}\n  1764\t\t\tfor _, p := range paths {\n  1765\t\t\t\tif !posemodel.IsAdministrativePath(p) {\n  1766\t\t\t\t\treturn false\n  1767\t\t\t\t}\n  1768\t\t\t\tadministrative = append(administrative, p)\n  1769\t\t\t}\n  1770\t\t}\n  1771\t\treturn administrativeRecordsAreRegular(root, administrative)\n  1772\t}\n  1773\t\n  1774\t// administrativeRecordsAreRegular reports whether every changed administrative\n  1775\t// path is a regular file at HEAD (or new): editing a committed symlink or\n  1776\t// submodule inside a class is a material change, as in MaterialSetDigest.\n  1777\tfunc administrativeRecordsAreRegular(root string, paths []string) bool {\n  1778\t\tif len(paths) == 0 {\n  1779\t\t\treturn true\n  1780\t\t}\n  1781\t\targs := []string{\"ls-tree\", \"-z\", \"HEAD\", \"--\"}\n  1782\t\tfor _, p := range paths {\n  1783\t\t\tif strings.ContainsAny(p, \"\\n\\x00\") {\n  1784\t\t\t\treturn false\n  1785\t\t\t}\n127:func TestCarryRunsOnlyTheChangedModule(t *testing.T) {\n156:func TestCarryKeepsTheOriginalHeadAcrossChainedCarries(t *testing.T) {\n173:func TestCarryKeepsACarriedFailureAFailure(t *testing.T) {\n189:func TestCarryFallsBackToAFullRun(t *testing.T) {\n242:func TestCarryRootChangeRunsEverythingUnlessSelfContained(t *testing.T) {\n274:func TestCarryRecordFileIsNotAChange(t *testing.T) {\n283:func TestCarrySelectsAModuleWithoutAPriorResult(t *testing.T) {\n309:func TestCarryRefusesAFilteredBase(t *testing.T) {\n321:func TestCarryRefusesIncompatibleFlags(t *testing.T) {\n334:func TestCarryIgnoresDerivedAdministrativeRecords(t *testing.T) {\n355:func TestCarryRefusesABaseThatValidatedADirtyWorkingCopy(t *testing.T) {\n378:func TestCarrySelectsBothSidesOfARename(t *testing.T) {\n395:func TestCarryKeepsTheOwnerOfAQuotedName(t *testing.T) {\n411:func TestCarryRootModuleOwnsRootFiles(t *testing.T) {\n429:func TestCarryDeletedDependencySelectsItsDependents(t *testing.T) {\n445:func TestCarryRejectsUndecodableMetadata(t *testing.T) {\n477:func TestCarryDeletedNestedDependencySelectsItsDependents(t *testing.T) {\n492:func TestCarryRootDependencyIsChangedByRootFiles(t *testing.T) {\n507:func TestCarryRefusesModulesReachedThroughASymlink(t *testing.T) {\n534:\t\tt.Fatalf(\"material_clean = true although HEAD moved during the run: %s\", out)\n570:\t\tt.Fatal(\"material_clean must be false\")\n581:func TestCarryRefusesModulesSharingADirectory(t *testing.T) {\n601:func TestCarryPlansAgainstThePinnedHead(t *testing.T) {\n652:func TestCarryRefusesDependenciesReachedThroughASymlink(t *testing.T) {\n669:func TestCarryRefusesASymlinkInsideAModule(t *testing.T) {\n686:func TestCarryAllowsSymlinksBetweenUnownedPaths(t *testing.T) {\n707:func TestCarryDetectsACaseInsensitiveFilesystem(t *testing.T) {\n729:func TestCarryRefusesDuplicateCheckIDs(t *testing.T) {\n746:func TestCarryRefusesASymlinkFromAModuleToAnUnownedPath(t *testing.T) {\n779:\t\tt.Fatalf(\"material_clean = true although the run created untracked material: %s\", out)\n785:func TestCarryRefusesAnAliasingSymlinkInsideASubmodule(t *testing.T) {\n819:func TestCarryDetectsACaseFoldedDirectory(t *testing.T) {\n857:func TestCarryScansAGitlinkInsideAModule(t *testing.T) {\n888:func TestCarryRelevantDirsIncludeEveryAncestor(t *testing.T) {\n922:func TestCarryCaseProbeSkipsUnusableEntries(t *testing.T) {\n955:func TestCarryRefusesDependenciesOutsideTheRepository(t *testing.T) {\n970:func TestCarryRefusesUncleanDependencies(t *testing.T) {\n983:func TestCarryRefusesNonASCIIPaths(t *testing.T) {\n996:func TestCarryRefusesHiddenIndexEntries(t *testing.T) {\n1002:\t\tt.Fatalf(\"material_clean = true with a skip-worktree entry: %s\", out)\n1018:func TestCarryRefusesDependenciesThroughAnIgnoredSymlink(t *testing.T) {\n1044:\t\tt.Fatalf(\"material_clean = true although HEAD moved and came back: %s\", out)\n1050:func TestCarryCaseProbeUsesOnlyASCIILetters(t *testing.T) {\n1088:\t\tt.Fatalf(\"material_clean = true although b/check.sh differs in mode from the commit: %s\", out)\n1094:func TestValidateUninitializedSubmoduleIsNotClean(t *testing.T) {\n1109:\t\tt.Fatalf(\"material_clean = true with an uninitialized submodule: %s\", out)\npose-mcp/internal/cli/validate_progress_test.go:40:\t]}},\"moduleOverrides\":{}}`, shell, shell)\npose-mcp/internal/cli/validate_results.go:198:func writeValidationJSON(path string, run validationRunResult) error {\npose-mcp/internal/cli/validate_results.go:299:func writeValidationJUnit(path string, run validationRunResult) error {\npose-mcp/internal/cli/validate_results.go:346:func writeValidationSARIF(path string, run validationRunResult) error {\npose-mcp/internal/cli/validate_carry_test.go:513:\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\"`, `\"moduleOverrides\":{\"alias\":{\"stack\":\"go\"}},\"stacks\"`, 1))\npose-mcp/internal/cli/validate_carry_test.go:530:\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\":{\"go\":{\"checks\":[`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"moves\",\"program\":\"sh\",\"args\":[\"-c\",\"`+commit+`\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\":{\"go\":{\"checks\":[`, 1))\npose-mcp/internal/cli/validate_carry_test.go:566:\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\":{\"go\":{\"checks\":[`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"moves\",\"program\":\"sh\",\"args\":[\"-c\",\"`+commit+`\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\":{\"go\":{\"checks\":[`, 1))\npose-mcp/internal/cli/validate_carry_test.go:732:\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\"`, `\"moduleOverrides\":{\"b\":{\"checks\":[{\"name\":\"ok\",\"program\":\"true\",\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\"`, 1))\npose-mcp/internal/cli/validate_carry_test.go:775:\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\"`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"writes\",\"program\":\"sh\",\"args\":[\"-c\",\"echo x > created.go\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\"`, 1))\npose-mcp/internal/cli/validate_carry_test.go:1040:\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\"`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"moves\",\"program\":\"sh\",\"args\":[\"-c\",\"`+script+`\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\"`, 1))\npose-mcp/internal/cli/validate_root_and_nodemodules_test.go:37:  \"moduleOverrides\": {\npose-mcp/internal/cli/validate_root_and_nodemodules_test.go:52:\t\tt.Fatalf(\"cmdValidate with moduleOverrides[\\\".\\\"] exited with code %d, stderr: %s\", code, stderr.String())\npose-mcp/internal/cli/validate_root_and_nodemodules_test.go:56:\t\tt.Fatalf(\"moduleOverrides[\\\".\\\"] produced path outside project error: %s\", stderr.String())\npose-mcp/internal/cli/validate.go:629:\tModuleOverrides  map[string]validationOverride        `json:\"moduleOverrides\"`\npose-mcp/internal/cli/validate.go:667:func discoverValidationModulesIn(files posemodel.Files, root string) ([]validationModule, error) {\npose-mcp/internal/cli/validate.go:734:func discoverValidationModules(root string) ([]validationModule, error) {\npose-mcp/internal/cli/validate.go:814:\t\tif err := validate(\"moduleOverrides.\"+name, override.Checks); err != nil {\npose-mcp/internal/cli/validate.go:832:\t\t\t\treturn fmt.Errorf(\"moduleOverrides.%s check %s has unknown evidenceClass %q\", scope, check.Name, check.EvidenceClass)\npose-mcp/internal/cli/validate.go:1096:\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: moduleOverrides contains a path outside the project: %s\\n\", \"Erro: moduleOverrides contém path fora do projeto: %s\\n\"), rel)\npose-mcp/internal/cli/validate.go:1503:\t\t\"json\":  {jsonOut, writeValidationJSON},\npose-mcp/internal/cli/validate.go:1504:\t\t\"junit\": {junitOut, writeValidationJUnit},\npose-mcp/internal/cli/validate.go:1505:\t\t\"sarif\": {sarifOut, writeValidationSARIF},\npose-mcp/internal/cli/validate.go:1586:func moduleValidationChecks(module validationModule, matrix validationMatrix, stackFilter, moduleFilter string) (string, []validationCheck, bool) {\n# Rule: Documentation Style\n\n## When to consult\n\nConsult this guide for process documentation, rules, specs, workflows, and operational instructions.\n\n## Required conventions\n\n- Write instructions in the imperative mood and begin them with action verbs.\n- Keep bullets short and limited to one idea.\n- Avoid duplicating sections with the same purpose across files.\n- Link to the single source of truth instead of copying its content.\n- Use `check`, `spec`, and `workflow` consistently.\n- State each instruction's scope explicitly to reduce ambiguity.\n\n## Examples: good and bad\n\n### Redundancy\n\n- **Good:** \"Update review criteria in `.pose/workflows/review.md` and reference that workflow from the root AGENTS file.\"\n- **Bad:** \"Repeat review criteria in AGENTS, the workflow, and every related spec.\"\n\n### Ambiguous reference\n\n- **Good:** \"Run the lint check described by the review workflow.\"\n- **Bad:** \"Run that standard validation before pushing.\"\n\n## Quick editorial checklist\n\n- Language is imperative and direct.\n- Bullets are short and non-overlapping.\n- Files do not duplicate sections.\n- `check`, `spec`, and `workflow` are used consistently.\n- References point to explicit files or paths.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Knowledge Governance\n\n## When to consult\n\nConsult this guide when creating, updating, reviewing, or removing artifacts under `.pose/knowledge/`.\n\n## TTL and retention\n\n- Set `expires_at` on every artifact when it is created.\n- Use a default TTL of 30 days for notes, decision logs, and handoffs.\n- Use a TTL of up to 90 days only with a justification recorded in the artifact body.\n- Treat an artifact without `expires_at` as non-compliant and block its creation or merge.\n\n## When this is not the right home\n\n- Use `.pose/knowledge/` only for time-bound operational memory: content\n  tied to a decision moment, a handoff between executions, or something\n  meant to be reviewed and eventually expire.\n- A durable fact or convention that will not become false and carries no\n  review trigger — a third-party tool's parsing quirk, a naming\n  convention, a recurring gotcha — is not a `decision-log` just because no\n  better type exists. Route it to `.pose/rules/` instead: add it to an\n  existing rule file or create one, then wire it into the relevant task\n  type's base `rules` array in `.pose/indexes/task-map.json` so\n  `pose suggest <task>` surfaces it automatically. No path scoping is\n  required — a task type's base `rules` list is returned regardless of\n  `--path`; only language/component-specific rules need the\n  `rules_by_domain` layer.\n- Rule of thumb: if nothing was decided or traded off, and nothing about\n  the fact will change on a predictable timeline, it is not a\n  `decision-log` and not an ADR — it is a rule. See ADR\n  `2026-08-15-durable-non-architectural-knowledge-belongs-in-rules-not-a-new-type`.\n\n## Reusable cross-execution format\n\n- Structure reusable context as a handoff with fixed sections: Context, Current state, Next checks, Risks, and Next owner.\n- Keep `source_refs` linked to the relevant spec, workflow, and executed check commands.\n- Record `last_reviewed_at` in the body to make effective cross-execution updates traceable.\n\n## Archiving and purging\n\n- Run biweekly triage to list expired artifacts.\n- Move expired artifacts to `.pose/knowledge/archive/` when they retain audit value.\n- Purge archived artifacts 180 days after expiration unless documented legal or compliance requirements apply.\n- Record every archive and purge action in the housekeeping log.\n\n## Sensitive content\n\n- Prohibit secrets, tokens, credentials, private keys, and equivalent material.\n- Prohibit personal data and non-anonymized customer data.\n- Do not copy restricted incidents or reports in full; keep only a controlled reference.\n- Classify frontmatter `sensitivity` as `public-internal` or `restricted`.\n- Remove identified sensitive content immediately and open a security follow-up.\n\n## Ownership and review\n\n- Keep `@pose-maintainers` as the primary governance owner.\n- Require an owner in every artifact frontmatter.\n- Review expiration biweekly and quality monthly.\n- Escalate a backlog overdue by more than two cycles to the primary owner.\n- Block backlog growth when `list-expired` exceeds the operational limit: zero in strict mode, two in tolerant mode.\n\n## Minimum operational checks\n\n- Run `pose knowledge-check --strict` biweekly to validate the expired backlog.\n- Run `pose knowledge-housekeeping list-expired` for detailed triage.\n- Run `pose knowledge-housekeeping archive-expired --dry-run` before applying changes.\n- Execute destructive actions only with an explicit `--apply` flag.\n","exit_code":0,"status":"completed"}}
