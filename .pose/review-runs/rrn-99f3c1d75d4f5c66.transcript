{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc \"git diff d724738b53a8fe94ec9b2eb749a5242958f06d4a 2b2eaede613ef2f1eb778acd07f9fa58e7f33cf6 -- .pose/adr .pose/indexes/validation-matrix.json POSE.md locales/pt-BR/POSE.md pose-mcp/internal/scaffold/dist/POSE.md pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md .pose/starts; sed -n '1,220p' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '325,555p' pose-mcp/internal/pose/governance_read_view_git.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc \"git diff d724738b53a8fe94ec9b2eb749a5242958f06d4a 2b2eaede613ef2f1eb778acd07f9fa58e7f33cf6 -- .pose/adr .pose/indexes/validation-matrix.json POSE.md locales/pt-BR/POSE.md pose-mcp/internal/scaffold/dist/POSE.md pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md .pose/starts; sed -n '1,220p' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '325,555p' pose-mcp/internal/pose/governance_read_view_git.go\"","aggregated_output":"diff --git a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\nindex 570b9503..9e615e1c 100644\n--- a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n+++ b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n@@ -250,3 +250,24 @@ every attributed commit. The structural fix, retaining only a digest for pure\n reads of immutable Git objects whose bytes a producer only hashes, is a\n follow-up of that spec, and a further raise again requires a measured\n reassessment.\n+\n+## Streamed object reads restore the captured-input budget (D11) — 2026-11-14\n+\n+Spec `pose-read-view-streamed-object-digests` supersedes D10. A Git object\n+read whose bytes a producer only hashes (the `git show --binary` of each\n+commit that feeds a change set's diff digest) is streamed into the producer:\n+the read view retains its digest and length, never its bytes, and charges a\n+separate streamed budget of 8 GiB per operation, and 8 GiB again for the\n+final audit, with at most 256 MiB per read. The final audit streams every\n+streamed read again: a patch's rendering depends on Git configuration and\n+attributes the operation does not capture, so no read is skipped on the\n+strength of its object id. The same bytes enter the\n+same hash, so every diff digest and change-set id is unchanged: on the\n+pose-dist corpus the 567 change sets and the whole `delivery-integrity.json`\n+were identical before and after. The captured-input budget returns to\n+512 MiB. Measured on the pose-dist corpus, `pose index` runs two operations:\n+the first retained 21.8 MB and streamed nothing, the second retained 32.2 MB\n+and streamed 1.26 GB in 2,511 reads, then 523 MB again in its audit.\n+Streaming bounds memory, not I/O: the bytes read still grow with the\n+attributed history.\n+\ndiff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex c76f670b..4c323b91 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2370,6 +2370,13 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"read-view-streamed-object-digests-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"./internal/cli\", \"-run\", \"Streamed\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"milestone-closes-when-reached-integration\",\n           \"program\": \"go\",\ndiff --git a/.pose/starts/pose-read-view-streamed-object-digests.json b/.pose/starts/pose-read-view-streamed-object-digests.json\nnew file mode 100644\nindex 00000000..9a41ab39\n--- /dev/null\n+++ b/.pose/starts/pose-read-view-streamed-object-digests.json\n@@ -0,0 +1,75 @@\n+{\n+  \"schema_version\": 1,\n+  \"spec\": \"pose-read-view-streamed-object-digests\",\n+  \"plan_digest\": \"6b2e4abc1383da5335befe92d15d45f8633938883aea6824d84618069651005c\",\n+  \"revision\": \"c1a6c9b7ee610865c6726973a51848c8fef61f6a\",\n+  \"spec_digest_before\": \"5fe97b2b907b4ae67582a62ed61acb98d71acfa0d6e4bc157b26964a429e384c\",\n+  \"spec_digest_after\": \"9759d8eb89852175b7c920261315f0e54c43e42e30c94e15670259ea8d78c98e\",\n+  \"baseline\": {\n+    \"schema_version\": 1,\n+    \"namespace\": \"spec:pose-read-view-streamed-object-digests\",\n+    \"nodes\": [\n+      {\n+        \"id\": \"R1\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-read-view-streamed-object-digests\",\n+        \"hash\": \"03237241792d\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R2\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-read-view-streamed-object-digests\",\n+        \"hash\": \"4c29a26607e4\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R3\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-read-view-streamed-object-digests\",\n+        \"hash\": \"9e87c2ce45fd\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R4\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-read-view-streamed-object-digests\",\n+        \"hash\": \"771c3ed7e514\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R5\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-read-view-streamed-object-digests\",\n+        \"hash\": \"dd62f6ae9e29\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R6\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-read-view-streamed-object-digests\",\n+        \"hash\": \"aa23c785e866\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"D1\",\n+        \"kind\": \"decision\",\n+        \"namespace\": \"spec:pose-read-view-streamed-object-digests\",\n+        \"hash\": \"310259768d07\",\n+        \"state\": \"active\"\n+      }\n+    ],\n+    \"diagnostics\": [\n+      {\n+        \"severity\": \"error\",\n+        \"code\": \"missing-basis\",\n+        \"id\": \"D1\",\n+        \"line\": 97,\n+        \"message\": \"decision requires Basis refs\"\n+      }\n+    ],\n+    \"digest\": \"sha256:d6e2b4c11e1f9c785519b440da9597b9804c24121833868e34ca5be88a26696c\"\n+  },\n+  \"phase\": \"started\",\n+  \"recorded_at\": \"2026-11-14T07:50:49Z\"\n+}\ndiff --git a/POSE.md b/POSE.md\nindex 91dba8fb..b4c0cd2b 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -382,7 +382,7 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `state --governance [--scope <ref>] [--json]` (spec `pose-effective-governance-projection`) — live, read-only projection of what governance is in force here: for each registry contract, optional capability (atomic start, contract nodes, causality closeout, qualified references, spec transfer, criterion reuse, signed attestations, verified identity) and gate (Definition of Ready, delivery integrity), whether it is `supported`, `configured`, `applicable` and `effective`, with reason codes such as `not-adopted`, `no-readiness-cutoff`, `legacy-cutoff:<date>` or `identity-assurance-declared`. `--scope` compares the scope's newest sealed bundle — the contracts it stamped — with what the policy seals today. It reads the same functions the gates call and writes nothing. `pose_project_state` carries the same projection as `effective_governance` (optional `governance_scope`).\n - `state --attention` (specs `pose-obligation-projection`, `pose-state-attention`) — live, read-only answer to \"what is still owed, by whom, restricting which phase?\". Obligations are projected from the subsystems that own them — readiness (unmet `depends_on`, Definition of Ready, unexplained `blocked`), closeout and review of in-progress specs (an unapproved review, each judgment criterion a sealed bundle still owes, text blockers carried as `legacy-opaque`), start reconciliation when atomic start is adopted, and open follow-ups as advisory residual debt — never stored a second time. Project-level sources are projected too (spec `pose-attention-projects-every-source`), originating on `xref:<project>/project:<project>`: an open docs review mark (owed by the doc's owner until `pose docs-review resolve`), a capability mechanism with a stale trigger, a release newer than the newest verified one that is not yet verified, and an accepted-risk or follow-up finding past its review date in the latest legacy review record. Free-form investigation notes carry no state and are not a source. The render shows coverage first: a producer that failed, or action requests until adopted, makes the answer `INCOMPLETE`, so an empty group never reads as nothing owed, and a fresh install, once committed, reads `complete`. Then what needs `--actor` (or any person or role), then what restricts each phase (`start`, `execution`, `review`, `closeout`, `release`), then residual debt. `--json` returns the report — stable `obl-` ids, qualified refs, reason codes, conditions, recipients, effects, satisfaction, knowledge, waiting, a snapshot of revision/dirty tree/policy/contract/index digests, per-producer coverage — plus the `attention` grouping. MCP: `pose_obligations` returns the same ids from the same function. Attention is not a gate.\n - Governance read views (spec `pose-governance-read-view-generation`) — inspect `snapshot.read_view` in `state --attention --json` and `pose_obligations`: its own `schema_version: 1`, observed-input ID, engine/parser versions and root bindings describe one operation. The enclosing report stays at schema version 1. Review and closeout JSON expose the same contract in `read_view`. The ID binds consumed bytes, directory observations, errors and absences; revision, dirty state, size and mtime alone do not prove equivalence. `current` describes the final audit instant only. Coherence, producer coverage and freshness are separate: `unknown` or incomplete coverage must never be read as nothing owed or as write authorization. A historical report without this binding remains readable and proves no current authorization.\n-  Reads retain at most 40,000 observations including retained directory entries, 1 GiB of input bytes and 16 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n+  Reads retain at most 40,000 observations including retained directory entries, 512 MiB of retained input bytes, 8 GiB of streamed bytes (a Git object read whose bytes are only hashed is streamed, keeping its digest) and 16 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n   The global review-closeout check composes an audited selection/catalogue coordinator with independently bounded scope operations. A scope and its recursive children use one closure; workers share only the explicitly bound immutable catalogue. At most 16 scope closures are live, further limited by `POSE_CHECK_WORKERS` or the core count. Scope findings are buffered until their audits and the coordinator audit finish. This proves coherent selection and individually audited results, not a simultaneous snapshot across every completed scope; one exhausted scope cannot consume its sibling's capture budget, and any unresolved loss still fails the global gate.\n - `action <open|list|show|resolve|cancel|waive|invalidate>` (specs `pose-action-requests`, `pose-action-request-resolution`) — material requests to a person or an external system that no other source records: a decision, an approval, an input, an external operation or an acceptance, with its question, options and consequences, recommendation, recipient (principal, role or `unassigned`), qualified targets (`requirement:R4` inside the origin spec, or `xref:…`), per-phase effects (`--effect closeout:block` lets implementation continue) and an optional subject (`--subject requirement:R4` or `path:<file>`) whose change invalidates an answer recorded for the old content. Open one only when a different answer would materially change execution, scope, authority, risk acceptance, closeout or publication and no authorization already given covers it. Each request is an append-only journal under `.pose/actions/`, read whole: a line with a second value, a duplicate field (keys differing only in case included), an unknown event type, another schema, a sequence gap, an empty line or no terminator is never part of a view; `action show|list` and MCP locate it (line, byte offset, length, SHA-256) as an `interrupted-tail`, with a truncation proposal for a person to review, or as `corrupt`, to restore from version control — the engine repairs nothing (spec `pose-journal-checkpoint-and-lock-recovery`); `open` is a preview until `--apply`. Targets are qualified with the current project id; when it is derived from the directory name (no `.pose/project.json`, `POSE_DEFAULT_PROJECT_ID` or `POSE_PROJECT_ROOTS` binding), `open --apply` says so (on stderr with `--json`), because a checkout under another name would record another project, and the obligation snapshot lists the same limitation. A resolution names the `--request-digest` it answers and the `--expected-revision` it read, carries an `--idempotency-key` (a retry is a no-op, the same key with other content is refused, a second answer against the same revision is refused) and comes from an actor holding the recipient role in `.pose/policy/actions.json` (`{\"schema_version\":1,\"roles\":{\"maintainer\":[\"human:<name>\"]},\"identity_assurance\":\"declared|verified\"}`); under `verified` it needs `--claim <file>` with an Ed25519 claim from an issuer pinned in the review policy, bound to project, audience, request digest, principal and answer (a human principal also needs `human_authority_issuers`). Answered is not satisfied: a declined approval, a rejected acceptance or a failed external operation leaves the condition unmet. The requester may cancel its own question; a waiver needs the recipient authority and a reason. Open requests are projected as `actor-action` obligations in `state --attention` and `pose_obligations`; MCP opens requests with `pose_action_open` (risk class `governance-write`, a preview unless `apply` is true) and reads them with `pose_action_requests`; `pose_action_resolve` (spec `pose-mcp-action-resolve-signed-only`, `governance-write`) records an answer only with the principal's proof — a signature by a key registered to it, or a trusted issuer's claim — and refuses a declared answer under any assurance; its preview returns the statement to sign and the `ssh-keygen` command.\n - Action destination scoping (spec `pose-action-target-and-node-scoping`) — origin is provenance, targets select relevance, and effects select restrictions. An empty effect scope still means the whole source artifact; a roadmap or milestone expands its current members. Explicit scopes replace that default, so a request from alpha can restrict beta without blocking alpha. A named whole artifact is a whole restriction, not partial merely because it is qualified. Pending requests remain visible when their origin becomes terminal. Unknown membership or unreadable material is reported as limited coverage and never expands into every spec. CLI accepts `--effect-json '{\"phase\":\"start\",\"mode\":\"block\",\"scope\":[\"xref:project/spec:beta\"]}'`; MCP `effects` accepts the same object alongside legacy `\"start:block\"` strings. Targets and subjects resolve by project/artifact/kind/ID, and a subject is re-read in its recorded artifact. Under adopted agency readiness, new approvals and acceptances require an explicit `--subject` / `subject`; legacy unbound requests retain their journal and report that answers have no content-change detection. Policy-off creation and transition defaults remain unchanged. This compatibility tightening requires release review; no policy adoption happens here.\ndiff --git a/locales/pt-BR/POSE.md b/locales/pt-BR/POSE.md\nindex 64eae2d9..3e598dad 100644\n--- a/locales/pt-BR/POSE.md\n+++ b/locales/pt-BR/POSE.md\n@@ -386,7 +386,7 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `state --governance [--scope <ref>] [--json]` (spec `pose-effective-governance-projection`) — projeção ao vivo, somente leitura, da governança em vigor aqui: para cada contrato do registry, capability opcional (atomic start, contract nodes, causality closeout, referências qualificadas, transferência de spec, reuso de critério, attestations assinadas, identidade verificada) e gate (Definition of Ready, integridade de entrega), se está `supported`, `configured`, `applicable` e `effective`, com códigos de motivo como `not-adopted`, `no-readiness-cutoff`, `legacy-cutoff:<data>` ou `identity-assurance-declared`. `--scope` compara o bundle selado mais recente do escopo — os contratos que ele carimbou — com o que a policy sela hoje. Lê as mesmas funções que os gates chamam e não escreve nada. `pose_project_state` traz a mesma projeção em `effective_governance` (parâmetro opcional `governance_scope`).\n - `state --attention` (specs `pose-obligation-projection`, `pose-state-attention`) — resposta ao vivo, somente leitura, a \"o que ainda é devido, por quem, restringindo qual fase?\". As obrigações são projetadas dos subsistemas que as possuem — readiness (`depends_on` não satisfeito, Definition of Ready, `blocked` sem causa), closeout e review de specs em andamento (review não aprovada, cada critério de julgamento que um bundle selado ainda deve, bloqueios em texto como `legacy-opaque`), reconciliação de start quando o atomic start está adotado, e follow-ups abertos como dívida residual consultiva — nunca armazenadas uma segunda vez. Fontes do projeto também são projetadas (spec `pose-attention-projects-every-source`), com origem em `xref:<projeto>/project:<projeto>`: uma marca de revisão de doc aberta (devida pelo dono do doc até `pose docs-review resolve`), um mecanismo de capability com gatilho de obsolescência, uma release mais nova que a última verificada e ainda não verificada, e um finding accepted-risk ou follow-up com data de revisão vencida no registro de review legado mais recente. Notas de investigação em texto livre não têm estado e não são fonte. A renderização mostra a cobertura primeiro: um produtor que falhou, ou action requests até a adoção, torna a resposta `INCOMPLETE`, para que um grupo vazio nunca seja lido como nada devido, e uma instalação nova, depois de commitada, lê `complete`. Depois o que precisa de `--actor` (ou de qualquer pessoa ou papel), depois o que restringe cada fase (`start`, `execution`, `review`, `closeout`, `release`), depois a dívida residual. `--json` retorna o relatório — ids `obl-` estáveis, refs qualificadas, códigos de motivo, condições, destinatários, efeitos, satisfação, conhecimento, espera, um snapshot com digests de revisão/árvore suja/policy/contrato/índice, cobertura por produtor — mais o agrupamento `attention`. MCP: `pose_obligations` retorna os mesmos ids pela mesma função. Attention não é gate.\n - Read views de governança (spec `pose-governance-read-view-generation`) — consulte `snapshot.read_view` em `state --attention --json` e `pose_obligations`: seu próprio `schema_version: 1`, ID dos inputs observados, versões de engine/parser e bindings de roots descrevem uma operação. O relatório externo permanece em schema version 1. O JSON de review e closeout expõe o mesmo contrato em `read_view`. O ID vincula bytes consumidos, observações de diretório, erros e ausências; revisão, dirty, tamanho e mtime isolados não provam equivalência. `current` descreve somente o instante da auditoria final. Coerência, cobertura por produtor e frescor são dimensões distintas: `unknown` ou cobertura incompleta nunca significam nada devido nem autorização de escrita. Um relatório histórico sem esse binding continua legível e não prova autorização atual.\n-  A leitura retém no máximo 40.000 observações incluindo entradas de diretório retidas, 1 GiB de inputs e 16 MiB de metadados. Ao detectar interleaving, descarta a tentativa e repete a leitura inteira uma vez; outra mudança deixa a cobertura afetada incompleta e o frescor `unknown`. Leitores não suportados e inputs federados sem binding permanecem desconhecidos. Escritores participantes adquirem guards das roots autorizadas antes da reavaliação e os mantêm até a publicação; CAS do destino e verificações do descriptor de índices continuam válidos. Escritores fora desse protocolo, incluindo uma alteração externa restaurada antes da auditoria, ficam fora dessa garantia de exclusão. Nenhum watcher, daemon ou cache entre operações é introduzido.\n+  A leitura retém no máximo 40.000 observações incluindo entradas de diretório retidas, 512 MiB de inputs retidos, 8 GiB de bytes em streaming (uma leitura de objeto Git cujos bytes só são hasheados passa em streaming e guarda o digest) e 16 MiB de metadados. Ao detectar interleaving, descarta a tentativa e repete a leitura inteira uma vez; outra mudança deixa a cobertura afetada incompleta e o frescor `unknown`. Leitores não suportados e inputs federados sem binding permanecem desconhecidos. Escritores participantes adquirem guards das roots autorizadas antes da reavaliação e os mantêm até a publicação; CAS do destino e verificações do descriptor de índices continuam válidos. Escritores fora desse protocolo, incluindo uma alteração externa restaurada antes da auditoria, ficam fora dessa garantia de exclusão. Nenhum watcher, daemon ou cache entre operações é introduzido.\n   O check global de review/closeout compõe um coordenador auditado de seleção/catálogo com operações limitadas por escopo. Um escopo e seus filhos recursivos usam uma closure; os workers compartilham somente o catálogo imutável com binding explícito. Até 16 closures de escopo ficam ativas, ainda limitadas por `POSE_CHECK_WORKERS` ou pelos cores. Findings são retidos até terminarem as auditorias dos escopos e do coordenador. Isso prova seleção coerente e resultados auditados individualmente, sem alegar snapshot simultâneo de todos os escopos concluídos; um escopo esgotado não consome o orçamento de captura do irmão e qualquer perda não resolvida ainda reprova o gate global.\n - `action <open|list|show|resolve|cancel|waive|invalidate>` (specs `pose-action-requests`, `pose-action-request-resolution`) — solicitações materiais a uma pessoa ou a um sistema externo que nenhuma outra fonte registra: decisão, aprovação, informação, operação externa ou aceite, com pergunta, opções e consequências, recomendação, destinatário (principal, papel ou `unassigned`), alvos qualificados (`requirement:R4` dentro da spec de origem, ou `xref:…`), efeitos por fase (`--effect closeout:block` deixa a implementação seguir) e um assunto opcional (`--subject requirement:R4` ou `path:<arquivo>`) cuja mudança invalida a resposta registrada para o conteúdo antigo. Abra uma somente quando uma resposta diferente mudaria materialmente execução, escopo, autoridade, aceitação de risco, closeout ou publicação e nenhuma autorização já dada a cobre. Cada solicitação é um journal append-only em `.pose/actions/`, lido por inteiro: uma linha com um segundo valor, campo duplicado (inclusive chaves que diferem só na caixa), tipo de evento desconhecido, outro schema, salto de sequência, linha vazia ou sem terminador nunca entra numa view; `action show|list` e o MCP a localizam (linha, offset em bytes, tamanho, SHA-256) como `interrupted-tail`, com uma proposta de truncamento para uma pessoa revisar, ou como `corrupt`, a restaurar do controle de versão — o motor não repara nada (spec `pose-journal-checkpoint-and-lock-recovery`); `open` é preview até `--apply`. Os alvos são qualificados com o project id atual; quando ele é derivado do nome do diretório (sem `.pose/project.json`, `POSE_DEFAULT_PROJECT_ID` ou vínculo em `POSE_PROJECT_ROOTS`), `open --apply` avisa (no stderr com `--json`), porque um checkout com outro nome registraria outro projeto, e o snapshot das obrigações lista a mesma limitação. Uma resolução nomeia o `--request-digest` que responde e a `--expected-revision` que leu, traz uma `--idempotency-key` (retry não grava de novo, a mesma chave com outro conteúdo é recusada, uma segunda resposta contra a mesma revisão é recusada) e vem de um ator que detém o papel destinatário em `.pose/policy/actions.json` (`{\"schema_version\":1,\"roles\":{\"maintainer\":[\"human:<nome>\"]},\"identity_assurance\":\"declared|verified\"}`); em `verified` exige `--claim <arquivo>` com uma claim Ed25519 de um emissor fixado na policy de review, vinculada a projeto, audience, digest da solicitação, principal e resposta (um principal humano também exige `human_authority_issuers`). Respondida não é satisfeita: aprovação recusada, aceite rejeitado ou operação externa falha deixam a condição sem atendimento. O solicitante pode cancelar a própria pergunta; uma dispensa exige a autoridade destinatária e um motivo. Solicitações abertas são projetadas como obrigações `actor-action` em `state --attention` e `pose_obligations`; o MCP abre solicitações com `pose_action_open` (classe de risco `governance-write`, preview a menos que `apply` seja true) e as lê com `pose_action_requests`; `pose_action_resolve` (spec `pose-mcp-action-resolve-signed-only`, `governance-write`) registra uma resposta só com a prova do principal — assinatura de uma chave registrada para ele, ou a claim de um emissor confiável — e recusa resposta declarada sob qualquer garantia; o preview devolve a declaração a assinar e o comando `ssh-keygen`.\n - Escopo de destino de ações (spec `pose-action-target-and-node-scoping`) — origin registra proveniência, targets selecionam relevância e effects selecionam restrições. Scope vazio mantém o artifact de origem inteiro; roadmap ou milestone expande seus membros atuais. Scopes explícitos substituem esse padrão: uma request de alpha pode restringir beta sem bloquear alpha. Artifact inteiro nomeado é restrição inteira; qualificação não o torna parcial. Requests pendentes permanecem visíveis após a origem ficar terminal. Membership desconhecido ou material ilegível declara cobertura limitada e nunca expande para todas as specs. CLI aceita `--effect-json '{\"phase\":\"start\",\"mode\":\"block\",\"scope\":[\"xref:project/spec:beta\"]}'`; MCP `effects` aceita esse objeto junto de strings legadas `\"start:block\"`. Targets e subjects resolvem o tuple projeto/artifact/kind/ID; subject é relido no artifact registrado. Sob agency readiness adotado, novas aprovações e aceitações exigem `--subject` / `subject` explícito; journals legados sem binding permanecem intactos e declaram que a resposta não detecta mudança de conteúdo. Criação e transições com policy off preservam os padrões existentes. Revisar compatibilidade na release; esta implementação não adota policy.\ndiff --git a/pose-mcp/internal/scaffold/dist/POSE.md b/pose-mcp/internal/scaffold/dist/POSE.md\nindex 1ba9443a..1c0bae47 100644\n--- a/pose-mcp/internal/scaffold/dist/POSE.md\n+++ b/pose-mcp/internal/scaffold/dist/POSE.md\n@@ -382,7 +382,7 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `state --governance [--scope <ref>] [--json]` (spec `pose-effective-governance-projection`) — live, read-only projection of what governance is in force here: for each registry contract, optional capability (atomic start, contract nodes, causality closeout, qualified references, spec transfer, criterion reuse, signed attestations, verified identity) and gate (Definition of Ready, delivery integrity), whether it is `supported`, `configured`, `applicable` and `effective`, with reason codes such as `not-adopted`, `no-readiness-cutoff`, `legacy-cutoff:<date>` or `identity-assurance-declared`. `--scope` compares the scope's newest sealed bundle — the contracts it stamped — with what the policy seals today. It reads the same functions the gates call and writes nothing. `pose_project_state` carries the same projection as `effective_governance` (optional `governance_scope`).\n - `state --attention` (specs `pose-obligation-projection`, `pose-state-attention`) — live, read-only answer to \"what is still owed, by whom, restricting which phase?\". Obligations are projected from the subsystems that own them — readiness (unmet `depends_on`, Definition of Ready, unexplained `blocked`), closeout and review of in-progress specs (an unapproved review, each judgment criterion a sealed bundle still owes, text blockers carried as `legacy-opaque`), start reconciliation when atomic start is adopted, and open follow-ups as advisory residual debt — never stored a second time. Project-level sources are projected too (spec `pose-attention-projects-every-source`), originating on `xref:<project>/project:<project>`: an open docs review mark (owed by the doc's owner until `pose docs-review resolve`), a capability mechanism with a stale trigger, a release newer than the newest verified one that is not yet verified, and an accepted-risk or follow-up finding past its review date in the latest legacy review record. Free-form investigation notes carry no state and are not a source. The render shows coverage first: a producer that failed, or action requests until adopted, makes the answer `INCOMPLETE`, so an empty group never reads as nothing owed, and a fresh install, once committed, reads `complete`. Then what needs `--actor` (or any person or role), then what restricts each phase (`start`, `execution`, `review`, `closeout`, `release`), then residual debt. `--json` returns the report — stable `obl-` ids, qualified refs, reason codes, conditions, recipients, effects, satisfaction, knowledge, waiting, a snapshot of revision/dirty tree/policy/contract/index digests, per-producer coverage — plus the `attention` grouping. MCP: `pose_obligations` returns the same ids from the same function. Attention is not a gate.\n - Governance read views (spec `pose-governance-read-view-generation`) — inspect `snapshot.read_view` in `state --attention --json` and `pose_obligations`: its own `schema_version: 1`, observed-input ID, engine/parser versions and root bindings describe one operation. The enclosing report stays at schema version 1. Review and closeout JSON expose the same contract in `read_view`. The ID binds consumed bytes, directory observations, errors and absences; revision, dirty state, size and mtime alone do not prove equivalence. `current` describes the final audit instant only. Coherence, producer coverage and freshness are separate: `unknown` or incomplete coverage must never be read as nothing owed or as write authorization. A historical report without this binding remains readable and proves no current authorization.\n-  Reads retain at most 40,000 observations including retained directory entries, 1 GiB of input bytes and 16 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n+  Reads retain at most 40,000 observations including retained directory entries, 512 MiB of retained input bytes, 8 GiB of streamed bytes (a Git object read whose bytes are only hashed is streamed, keeping its digest) and 16 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n   The global review-closeout check composes an audited selection/catalogue coordinator with independently bounded scope operations. A scope and its recursive children use one closure; workers share only the explicitly bound immutable catalogue. At most 16 scope closures are live, further limited by `POSE_CHECK_WORKERS` or the core count. Scope findings are buffered until their audits and the coordinator audit finish. This proves coherent selection and individually audited results, not a simultaneous snapshot across every completed scope; one exhausted scope cannot consume its sibling's capture budget, and any unresolved loss still fails the global gate.\n - `action <open|list|show|resolve|cancel|waive|invalidate>` (specs `pose-action-requests`, `pose-action-request-resolution`) — material requests to a person or an external system that no other source records: a decision, an approval, an input, an external operation or an acceptance, with its question, options and consequences, recommendation, recipient (principal, role or `unassigned`), qualified targets (`requirement:R4` inside the origin spec, or `xref:…`), per-phase effects (`--effect closeout:block` lets implementation continue) and an optional subject (`--subject requirement:R4` or `path:<file>`) whose change invalidates an answer recorded for the old content. Open one only when a different answer would materially change execution, scope, authority, risk acceptance, closeout or publication and no authorization already given covers it. Each request is an append-only journal under `.pose/actions/`, read whole: a line with a second value, a duplicate field (keys differing only in case included), an unknown event type, another schema, a sequence gap, an empty line or no terminator is never part of a view; `action show|list` and MCP locate it (line, byte offset, length, SHA-256) as an `interrupted-tail`, with a truncation proposal for a person to review, or as `corrupt`, to restore from version control — the engine repairs nothing (spec `pose-journal-checkpoint-and-lock-recovery`); `open` is a preview until `--apply`. Targets are qualified with the current project id; when it is derived from the directory name (no `.pose/project.json`, `POSE_DEFAULT_PROJECT_ID` or `POSE_PROJECT_ROOTS` binding), `open --apply` says so (on stderr with `--json`), because a checkout under another name would record another project, and the obligation snapshot lists the same limitation. A resolution names the `--request-digest` it answers and the `--expected-revision` it read, carries an `--idempotency-key` (a retry is a no-op, the same key with other content is refused, a second answer against the same revision is refused) and comes from an actor holding the recipient role in `.pose/policy/actions.json` (`{\"schema_version\":1,\"roles\":{\"maintainer\":[\"human:<name>\"]},\"identity_assurance\":\"declared|verified\"}`); under `verified` it needs `--claim <file>` with an Ed25519 claim from an issuer pinned in the review policy, bound to project, audience, request digest, principal and answer (a human principal also needs `human_authority_issuers`). Answered is not satisfied: a declined approval, a rejected acceptance or a failed external operation leaves the condition unmet. The requester may cancel its own question; a waiver needs the recipient authority and a reason. Open requests are projected as `actor-action` obligations in `state --attention` and `pose_obligations`; MCP opens requests with `pose_action_open` (risk class `governance-write`, a preview unless `apply` is true) and reads them with `pose_action_requests`; `pose_action_resolve` (spec `pose-mcp-action-resolve-signed-only`, `governance-write`) records an answer only with the principal's proof — a signature by a key registered to it, or a trusted issuer's claim — and refuses a declared answer under any assurance; its preview returns the statement to sign and the `ssh-keygen` command.\n - Action destination scoping (spec `pose-action-target-and-node-scoping`) — origin is provenance, targets select relevance, and effects select restrictions. An empty effect scope still means the whole source artifact; a roadmap or milestone expands its current members. Explicit scopes replace that default, so a request from alpha can restrict beta without blocking alpha. A named whole artifact is a whole restriction, not partial merely because it is qualified. Pending requests remain visible when their origin becomes terminal. Unknown membership or unreadable material is reported as limited coverage and never expands into every spec. CLI accepts `--effect-json '{\"phase\":\"start\",\"mode\":\"block\",\"scope\":[\"xref:project/spec:beta\"]}'`; MCP `effects` accepts the same object alongside legacy `\"start:block\"` strings. Targets and subjects resolve by project/artifact/kind/ID, and a subject is re-read in its recorded artifact. Under adopted agency readiness, new approvals and acceptances require an explicit `--subject` / `subject`; legacy unbound requests retain their journal and report that answers have no content-change detection. Policy-off creation and transition defaults remain unchanged. This compatibility tightening requires release review; no policy adoption happens here.\ndiff --git a/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md b/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\nindex 64eae2d9..3e598dad 100644\n--- a/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n+++ b/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n@@ -386,7 +386,7 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `state --governance [--scope <ref>] [--json]` (spec `pose-effective-governance-projection`) — projeção ao vivo, somente leitura, da governança em vigor aqui: para cada contrato do registry, capability opcional (atomic start, contract nodes, causality closeout, referências qualificadas, transferência de spec, reuso de critério, attestations assinadas, identidade verificada) e gate (Definition of Ready, integridade de entrega), se está `supported`, `configured`, `applicable` e `effective`, com códigos de motivo como `not-adopted`, `no-readiness-cutoff`, `legacy-cutoff:<data>` ou `identity-assurance-declared`. `--scope` compara o bundle selado mais recente do escopo — os contratos que ele carimbou — com o que a policy sela hoje. Lê as mesmas funções que os gates chamam e não escreve nada. `pose_project_state` traz a mesma projeção em `effective_governance` (parâmetro opcional `governance_scope`).\n - `state --attention` (specs `pose-obligation-projection`, `pose-state-attention`) — resposta ao vivo, somente leitura, a \"o que ainda é devido, por quem, restringindo qual fase?\". As obrigações são projetadas dos subsistemas que as possuem — readiness (`depends_on` não satisfeito, Definition of Ready, `blocked` sem causa), closeout e review de specs em andamento (review não aprovada, cada critério de julgamento que um bundle selado ainda deve, bloqueios em texto como `legacy-opaque`), reconciliação de start quando o atomic start está adotado, e follow-ups abertos como dívida residual consultiva — nunca armazenadas uma segunda vez. Fontes do projeto também são projetadas (spec `pose-attention-projects-every-source`), com origem em `xref:<projeto>/project:<projeto>`: uma marca de revisão de doc aberta (devida pelo dono do doc até `pose docs-review resolve`), um mecanismo de capability com gatilho de obsolescência, uma release mais nova que a última verificada e ainda não verificada, e um finding accepted-risk ou follow-up com data de revisão vencida no registro de review legado mais recente. Notas de investigação em texto livre não têm estado e não são fonte. A renderização mostra a cobertura primeiro: um produtor que falhou, ou action requests até a adoção, torna a resposta `INCOMPLETE`, para que um grupo vazio nunca seja lido como nada devido, e uma instalação nova, depois de commitada, lê `complete`. Depois o que precisa de `--actor` (ou de qualquer pessoa ou papel), depois o que restringe cada fase (`start`, `execution`, `review`, `closeout`, `release`), depois a dívida residual. `--json` retorna o relatório — ids `obl-` estáveis, refs qualificadas, códigos de motivo, condições, destinatários, efeitos, satisfação, conhecimento, espera, um snapshot com digests de revisão/árvore suja/policy/contrato/índice, cobertura por produtor — mais o agrupamento `attention`. MCP: `pose_obligations` retorna os mesmos ids pela mesma função. Attention não é gate.\n - Read views de governança (spec `pose-governance-read-view-generation`) — consulte `snapshot.read_view` em `state --attention --json` e `pose_obligations`: seu próprio `schema_version: 1`, ID dos inputs observados, versões de engine/parser e bindings de roots descrevem uma operação. O relatório externo permanece em schema version 1. O JSON de review e closeout expõe o mesmo contrato em `read_view`. O ID vincula bytes consumidos, observações de diretório, erros e ausências; revisão, dirty, tamanho e mtime isolados não provam equivalência. `current` descreve somente o instante da auditoria final. Coerência, cobertura por produtor e frescor são dimensões distintas: `unknown` ou cobertura incompleta nunca significam nada devido nem autorização de escrita. Um relatório histórico sem esse binding continua legível e não prova autorização atual.\n-  A leitura retém no máximo 40.000 observações incluindo entradas de diretório retidas, 1 GiB de inputs e 16 MiB de metadados. Ao detectar interleaving, descarta a tentativa e repete a leitura inteira uma vez; outra mudança deixa a cobertura afetada incompleta e o frescor `unknown`. Leitores não suportados e inputs federados sem binding permanecem desconhecidos. Escritores participantes adquirem guards das roots autorizadas antes da reavaliação e os mantêm até a publicação; CAS do destino e verificações do descriptor de índices continuam válidos. Escritores fora desse protocolo, incluindo uma alteração externa restaurada antes da auditoria, ficam fora dessa garantia de exclusão. Nenhum watcher, daemon ou cache entre operações é introduzido.\n+  A leitura retém no máximo 40.000 observações incluindo entradas de diretório retidas, 512 MiB de inputs retidos, 8 GiB de bytes em streaming (uma leitura de objeto Git cujos bytes só são hasheados passa em streaming e guarda o digest) e 16 MiB de metadados. Ao detectar interleaving, descarta a tentativa e repete a leitura inteira uma vez; outra mudança deixa a cobertura afetada incompleta e o frescor `unknown`. Leitores não suportados e inputs federados sem binding permanecem desconhecidos. Escritores participantes adquirem guards das roots autorizadas antes da reavaliação e os mantêm até a publicação; CAS do destino e verificações do descriptor de índices continuam válidos. Escritores fora desse protocolo, incluindo uma alteração externa restaurada antes da auditoria, ficam fora dessa garantia de exclusão. Nenhum watcher, daemon ou cache entre operações é introduzido.\n   O check global de review/closeout compõe um coordenador auditado de seleção/catálogo com operações limitadas por escopo. Um escopo e seus filhos recursivos usam uma closure; os workers compartilham somente o catálogo imutável com binding explícito. Até 16 closures de escopo ficam ativas, ainda limitadas por `POSE_CHECK_WORKERS` ou pelos cores. Findings são retidos até terminarem as auditorias dos escopos e do coordenador. Isso prova seleção coerente e resultados auditados individualmente, sem alegar snapshot simultâneo de todos os escopos concluídos; um escopo esgotado não consome o orçamento de captura do irmão e qualquer perda não resolvida ainda reprova o gate global.\n - `action <open|list|show|resolve|cancel|waive|invalidate>` (specs `pose-action-requests`, `pose-action-request-resolution`) — solicitações materiais a uma pessoa ou a um sistema externo que nenhuma outra fonte registra: decisão, aprovação, informação, operação externa ou aceite, com pergunta, opções e consequências, recomendação, destinatário (principal, papel ou `unassigned`), alvos qualificados (`requirement:R4` dentro da spec de origem, ou `xref:…`), efeitos por fase (`--effect closeout:block` deixa a implementação seguir) e um assunto opcional (`--subject requirement:R4` ou `path:<arquivo>`) cuja mudança invalida a resposta registrada para o conteúdo antigo. Abra uma somente quando uma resposta diferente mudaria materialmente execução, escopo, autoridade, aceitação de risco, closeout ou publicação e nenhuma autorização já dada a cobre. Cada solicitação é um journal append-only em `.pose/actions/`, lido por inteiro: uma linha com um segundo valor, campo duplicado (inclusive chaves que diferem só na caixa), tipo de evento desconhecido, outro schema, salto de sequência, linha vazia ou sem terminador nunca entra numa view; `action show|list` e o MCP a localizam (linha, offset em bytes, tamanho, SHA-256) como `interrupted-tail`, com uma proposta de truncamento para uma pessoa revisar, ou como `corrupt`, a restaurar do controle de versão — o motor não repara nada (spec `pose-journal-checkpoint-and-lock-recovery`); `open` é preview até `--apply`. Os alvos são qualificados com o project id atual; quando ele é derivado do nome do diretório (sem `.pose/project.json`, `POSE_DEFAULT_PROJECT_ID` ou vínculo em `POSE_PROJECT_ROOTS`), `open --apply` avisa (no stderr com `--json`), porque um checkout com outro nome registraria outro projeto, e o snapshot das obrigações lista a mesma limitação. Uma resolução nomeia o `--request-digest` que responde e a `--expected-revision` que leu, traz uma `--idempotency-key` (retry não grava de novo, a mesma chave com outro conteúdo é recusada, uma segunda resposta contra a mesma revisão é recusada) e vem de um ator que detém o papel destinatário em `.pose/policy/actions.json` (`{\"schema_version\":1,\"roles\":{\"maintainer\":[\"human:<nome>\"]},\"identity_assurance\":\"declared|verified\"}`); em `verified` exige `--claim <arquivo>` com uma claim Ed25519 de um emissor fixado na policy de review, vinculada a projeto, audience, digest da solicitação, principal e resposta (um principal humano também exige `human_authority_issuers`). Respondida não é satisfeita: aprovação recusada, aceite rejeitado ou operação externa falha deixam a condição sem atendimento. O solicitante pode cancelar a própria pergunta; uma dispensa exige a autoridade destinatária e um motivo. Solicitações abertas são projetadas como obrigações `actor-action` em `state --attention` e `pose_obligations`; o MCP abre solicitações com `pose_action_open` (classe de risco `governance-write`, preview a menos que `apply` seja true) e as lê com `pose_action_requests`; `pose_action_resolve` (spec `pose-mcp-action-resolve-signed-only`, `governance-write`) registra uma resposta só com a prova do principal — assinatura de uma chave registrada para ele, ou a claim de um emissor confiável — e recusa resposta declarada sob qualquer garantia; o preview devolve a declaração a assinar e o comando `ssh-keygen`.\n - Escopo de destino de ações (spec `pose-action-target-and-node-scoping`) — origin registra proveniência, targets selecionam relevância e effects selecionam restrições. Scope vazio mantém o artifact de origem inteiro; roadmap ou milestone expande seus membros atuais. Scopes explícitos substituem esse padrão: uma request de alpha pode restringir beta sem bloquear alpha. Artifact inteiro nomeado é restrição inteira; qualificação não o torna parcial. Requests pendentes permanecem visíveis após a origem ficar terminal. Membership desconhecido ou material ilegível declara cobertura limitada e nunca expande para todas as specs. CLI aceita `--effect-json '{\"phase\":\"start\",\"mode\":\"block\",\"scope\":[\"xref:project/spec:beta\"]}'`; MCP `effects` aceita esse objeto junto de strings legadas `\"start:block\"`. Targets e subjects resolvem o tuple projeto/artifact/kind/ID; subject é relido no artifact registrado. Sob agency readiness adotado, novas aprovações e aceitações exigem `--subject` / `subject` explícito; journals legados sem binding permanecem intactos e declaram que a resposta não detecta mudança de conteúdo. Criação e transições com policy off preservam os padrões existentes. Revisar compatibilidade na release; esta implementação não adota policy.\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n)\n\nconst governanceReadViewGitParserVersion = \"pose-governance-git-inputs-v1\"\n\ntype governanceReadViewGitObservation struct {\n\troot           string\n\targs           []string\n\tfiles          Files\n\tctx            context.Context\n\tdeadline       time.Time\n\thasDeadline    bool\n\tmaxOutputBytes int64\n\tstdout         []byte\n\tstderr         []byte\n\terr            error\n\terrText        string\n\tproducers      map[string]bool\n\t// pure is set when the output cannot change while the commit it was read at stands: it is a\n\t// function of object ids, or of headAt, the commit HEAD named before and after the command.\n\t// The final audit then reruns it only if HEAD moved.\n\tpure   bool\n\theadAt string\n}\n\n// governanceReadViewGitState captures exact, bounded Git command results for\n// one read-view operation. Repeated commands replay the first result; audit\n// reruns each exact command and reports any changed or unprovable result.\ntype governanceReadViewGitState struct {\n\top            *governanceReadViewOperation\n\tmu            sync.Mutex\n\tobservations  map[string]*governanceReadViewGitObservation\n\tstreams       map[string]*governanceReadViewStreamObservation\n\tconfigMu      sync.Mutex\n\tconfigDigests map[string]string\n}\n\n// effectiveGitConfig is the digest of `git config --list` of a root (every scope, includes\n// followed), read once per operation and kept apart from the command observations: it is a key\n// of the resident memo, not an input the audit replays. Empty when it could not be read.\nfunc (state *governanceReadViewGitState) effectiveGitConfig(ctx context.Context, files Files, root string) string {\n\tstate.configMu.Lock()\n\tdefer state.configMu.Unlock()\n\tif digest, ok := state.configDigests[root]; ok {\n\t\treturn digest\n\t}\n\tdigest := \"\"\n\tif out, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, []string{\"config\", \"--list\", \"-z\", \"--includes\"}, 1<<20); err == nil {\n\t\tsum := sha256.Sum256(out)\n\t\tdigest = hex.EncodeToString(sum[:8])\n\t}\n\tstate.configDigests[root] = digest\n\treturn digest\n}\n\nfunc newGovernanceReadViewGitState(op *governanceReadViewOperation) *governanceReadViewGitState {\n\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}, configDigests: map[string]string{}}\n}\n\n// captureGovernanceGit runs a Git command through the read-view generation\n// when Files belongs to one. Native and preview operations retain their\n// existing behavior when there is no governance view.\nfunc captureGovernanceGit(files Files, root, producer string, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n}\n\n// CaptureGovernanceGitIn executes one bounded raw-history Git command through\n// the operation's captured read view when Files carries one. maxOutputBytes\n// bounds combined stdout and stderr before bytes are retained. Git commands\n// use gitCommand, which disables replacement refs and grafts.\nfunc CaptureGovernanceGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBounded(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitIn names the history semantics explicitly for\n// callers whose result depends on raw commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitIn(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceGitContextIn is CaptureGovernanceGitIn under ctx. The same\n// context is retained for the final audit rerun.\nfunc CaptureGovernanceGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitContextIn names raw history semantics for\n// context-bound callers that inspect commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitContextIn(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceGitBounded(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBoundedContext(files, context.Background(), root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceGitBoundedContext(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tfiles = FilesOrNative(files)\n\tview, viewFiles := governanceReadViewFromFiles(files)\n\tif view == nil {\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif view.operation == nil {\n\t\tview.markUnknown(producer, \"Git input has no operation-scoped generation vector\")\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif viewFiles != nil {\n\t\tproject := viewFiles.project\n\t\tif target := view.route(root, producer, project); target == nil {\n\t\t\tview.markUnknown(producer, \"Git input is outside the authorized root generation vector\")\n\t\t\treturn nil, errGovernanceReadViewOutsideRoot\n\t\t} else {\n\t\t\tview = target\n\t\t}\n\t}\n\treturn view.operation.captureFilesBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceSourceRevision(files Files, root, producer string) (string, error) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\traw, err := captureGovernanceGit(files, root, producer, \"rev-parse\", \"--verify\", \"HEAD\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\trevision := strings.TrimSpace(string(raw))\n\tif revision == \"\" {\n\t\tif view, _ := governanceReadViewFromFiles(files); view != nil {\n\t\t\tview.markUnknown(producer, \"source revision binding is unavailable\")\n\t\t}\n\t\treturn \"\", fmt.Errorf(\"pose: Git returned no source revision\")\n\t}\n\treturn revision, nil\n}\n\nfunc readGitStatusGovernedIn(files Files, root, producer string, pathspecs ...string) ([]GitStatusEntry, error) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\targs := []string{\"status\", \"--porcelain=v1\", \"-z\", \"--untracked-files=all\", \"--ignore-submodules=none\"}\n\tif len(pathspecs) > 0 {\n\t\targs = append(args, \"--\")\n\t\targs = append(args, pathspecs...)\n\t}\n\tout, err := captureGovernanceGit(files, root, producer, args...)\n\tif err != nil {\n\t\tif hasGitMetadataIn(FilesOrNative(files), root) {\n\t\t\tmarkGovernanceReadUnknownForProject(files, root, \"\", producer, \"Git status could not be read in this repository\")\n\t\t} else {\n\t\t\treturn nil, fmt.Errorf(\"%w: %v\", ErrGitUnavailable, err)\n\t\t}\n\t\treturn nil, err\n\t}\n\tentries, err := parseGitStatusEntries(out)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif preview := FilesOrNative(files).Preview(); preview != nil {\n\t\treturn projectGitStatus(preview, root, entries, pathspecs)\n\t}\n\treturn entries, nil\n}\n\nfunc gitChangedPathsGovernedIn(files Files, root, producer string) ([]string, error) {\n\tentries, err := readGitStatusGovernedIn(files, root, producer)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tpaths := make([]string, 0, len(entries)*2)\n\tfor _, entry := range entries {\n\t\tif untrackedAuthorityTransferLock(entry) {\n\t\t\tcontinue\n\t\t}\n\t\tpaths = append(paths, entry.Path)\n\t\tif entry.OrigPath != \"\" {\n\t\t\tpaths = append(paths, entry.OrigPath)\n\t\t}\n\t}\n\tsort.Strings(paths)\n\treturn paths, nil\n}\n\nfunc commitChangedPathsGovernedIn(files Files, root, producer, commit string) (map[string]bool, bool) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\t// Each governed read is captured and audited, so it is not served from a cache:\n\t// the read is bounded instead, in output bytes and in paths (spec\n\t// pose-bounded-isolated-graph-caches R4).\n\traw, err := captureGovernanceGitBounded(files, root, producer, commitPathsMaxOutput, \"diff-tree\", \"--root\", \"--no-commit-id\", \"--name-only\", \"--no-renames\", \"-r\", \"-z\", commit)\n\tvar paths map[string]bool\n\tif err == nil {\n\t\tpaths, err = parseCommitPaths(raw)\n\t}\n\tif err != nil {\n\t\tif hasGitMetadataIn(FilesOrNative(files), root) {\n\t\t\tmarkGovernanceReadUnknownForProject(files, root, \"\", producer, \"commit path inventory could not be read from Git\")\n\t\t}\n\t\treturn nil, false\n\t}\n\treturn paths, true\n}\n\nfunc dispatchWorktreeIdentityGoverned(files Files, root, producer string) (string, error) {\n\t\ttarget = op.primary\n\t}\n\treturn absolute, target, state, nil\n}\n\nfunc (state *governanceReadViewGitState) capture(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif state == nil || state.op == nil {\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif ctx == nil {\n\t\tctx = context.Background()\n\t}\n\tdeadline, hasDeadline := ctx.Deadline()\n\tauditContext := context.WithoutCancel(ctx)\n\tkey := governanceGitObservationKey(root, args, maxOutputBytes)\n\tstate.mu.Lock()\n\tif prior := state.observations[key]; prior != nil {\n\t\tprior.producers[producer] = true\n\t\tstdout, err := append([]byte(nil), prior.stdout...), prior.err\n\t\tstate.mu.Unlock()\n\t\treturn stdout, err\n\t}\n\tmetadataCost := int64(len(root) + len(key) + len(producer) + 128)\n\tif !state.op.reserveRecord(metadataCost) {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its shared record or metadata budget while capturing Git\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tlimit := maxOutputBytes\n\tif state.op.remainingInput() < limit {\n\t\tlimit = state.op.remainingInput()\n\t}\n\tif limit <= 0 {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its Git input byte budget\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tbyObject, byHead := governancePureGitRead(args)\n\theadBefore := \"\"\n\tif byHead {\n\t\theadBefore = governanceHeadAt(ctx, files, root)\n\t}\n\t// A process that turned the resident memo on answers a pure read from it; the bytes are\n\t// admitted against the operation's budget as a fresh read's are.\n\tvar stdout, stderr []byte\n\tvar runErr error\n\tmemoKey, memoized := \"\", false\n\tmemo := residentGit.Load()\n\tif memo != nil && (byObject || byHead && headBefore != \"\") {\n\t\tif key, ok := residentGitKey(root, headBefore, state.effectiveGitConfig(ctx, files, root), args); ok {\n\t\t\tmemoKey = key\n\t\t\tif hit, found := memo.get(key); found {\n\t\t\t\tif int64(len(hit)) > limit || !state.op.reserveInput(int64(len(hit))) {\n\t\t\t\t\tstate.mu.Unlock()\n\t\t\t\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n\t\t\t\t\treturn nil, errGovernanceReadViewBudget\n\t\t\t\t}\n\t\t\t\tstdout, memoized = hit, true\n\t\t\t}\n\t\t}\n\t}\n\tif !memoized {\n\t\tstdout, stderr, runErr = runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, state.op.reserveInput)\n\t}\n\tif errors.Is(runErr, errGovernanceReadViewBudget) {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tobservation := &governanceReadViewGitObservation{\n\t\troot: root, args: append([]string(nil), args...), files: files, ctx: auditContext, deadline: deadline, hasDeadline: hasDeadline, maxOutputBytes: maxOutputBytes,\n\t\tstdout: append([]byte(nil), stdout...), stderr: append([]byte(nil), stderr...), err: runErr, errText: errorText(runErr),\n\t\tproducers: map[string]bool{producer: true},\n\t}\n\tif runErr == nil && len(stderr) == 0 {\n\t\tswitch {\n\t\tcase byObject:\n\t\t\tobservation.pure = true\n\t\tcase memoized && byHead:\n\t\t\t// The commit is the one the memo's key names; nothing ran, so there is no second read.\n\t\t\tobservation.pure, observation.headAt = true, headBefore\n\t\tcase byHead && headBefore != \"\" && governanceHeadAt(ctx, files, root) == headBefore:\n\t\t\tobservation.pure, observation.headAt = true, headBefore\n\t\t}\n\t\tif memoKey != \"\" && !memoized && observation.pure {\n\t\t\tmemo.put(memoKey, stdout)\n\t\t}\n\t}\n\tstate.observations[key] = observation\n\tstate.mu.Unlock()\n\tif isGovernanceGitHeadCommand(args) {\n\t\tif runErr != nil {\n\t\t\tif !state.op.mayOmitPrimaryRevision(root) {\n\t\t\t\tstate.markUnknownForRoot(root, producer, \"source revision could not be read from Git\")\n\t\t\t}\n\t\t} else {\n\t\t\trevision := strings.TrimSpace(string(stdout))\n\t\t\tif revision == \"\" && state.op.mayOmitPrimaryRevision(root) {\n\t\t\t\treturn append([]byte(nil), stdout...), runErr\n\t\t\t}\n\t\t\tstate.bindRevision(root, revision)\n\t\t}\n\t}\n\treturn append([]byte(nil), stdout...), runErr\n}\n\nfunc isGovernanceGitHeadCommand(args []string) bool {\n\treturn len(args) == 3 && args[0] == \"rev-parse\" && args[1] == \"--verify\" && args[2] == \"HEAD\"\n}\n\nfunc governanceGitObservationKey(root string, args []string, maxOutputBytes int64) string {\n\tencoded, _ := json.Marshal(args)\n\treturn filepath.Clean(root) + \"\\x00\" + string(encoded) + \"\\x00\" + fmt.Sprint(maxOutputBytes)\n}\n\nfunc (state *governanceReadViewGitState) bindRevision(root, revision string) {\n\tif revision == \"\" || state == nil || state.op == nil {\n\t\tstate.markUnknownForRoot(root, \"projection\", \"source revision binding is unavailable\")\n\t\treturn\n\t}\n\tstate.op.mu.Lock()\n\tfor _, entry := range state.op.roots {\n\t\tif sameLexicalRoot(entry.root, root) {\n\t\t\tentry.revision = revision\n\t\t\tstate.op.mu.Unlock()\n\t\t\treturn\n\t\t}\n\t}\n\tstate.op.mu.Unlock()\n\tstate.markUnknownForRoot(root, \"projection\", \"source revision root is outside the authorized vector\")\n}\n\nfunc (state *governanceReadViewGitState) markUnknownForRoot(root, producer, reason string) {\n\tif state == nil || state.op == nil {\n\t\treturn\n\t}\n\tstate.op.mu.Lock()\n\tvar view *governanceReadView\n\tfor _, entry := range state.op.roots {\n\t\tif sameLexicalRoot(entry.root, root) {\n\t\t\tview = entry.view\n\t\t\tbreak\n\t\t}\n\t}\n\tstate.op.mu.Unlock()\n\tif view == nil {\n\t\tview = state.op.primary\n\t}\n\tview.markUnknown(producer, reason)\n}\n\nfunc (state *governanceReadViewGitState) audit() governanceReadViewAudit {\n\tresult := governanceReadViewAudit{ChangedProducers: map[string]bool{}, UnknownProducers: map[string][]string{}}\n\tif state == nil {\n\t\treturn result\n\t}\n\tstate.mu.Lock()\n\tobservations := make([]governanceReadViewGitObservation, 0, len(state.observations))\n\tfor _, item := range state.observations {\n\t\tcopy := *item\n\t\tcopy.args = append([]string(nil), item.args...)\n\t\tcopy.stdout = append([]byte(nil), item.stdout...)\n\t\tcopy.stderr = append([]byte(nil), item.stderr...)\n\t\tcopy.producers = cloneBoolMap(item.producers)\n\t\tobservations = append(observations, copy)\n\t}\n\tstate.mu.Unlock()\n\tsort.Slice(observations, func(i, j int) bool {\n\t\tleft := governanceGitObservationKey(observations[i].root, observations[i].args, observations[i].maxOutputBytes)\n\t\tright := governanceGitObservationKey(observations[j].root, observations[j].args, observations[j].maxOutputBytes)\n\t\treturn left < right\n\t})\n\tremaining := int64(governanceReadViewMaxInputBytes)\n\theads := map[string]string{}\n\tfor _, item := range observations {\n\t\tif item.pure {\n\t\t\tif item.headAt == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tnow, read := heads[item.root]\n\t\t\tif !read {\n\t\t\t\tnow = governanceHeadAt(item.ctx, item.files, item.root)\n\t\t\t\theads[item.root] = now\n\t\t\t}\n\t\t\tif now == item.headAt {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif remaining <= 0 {\n\t\t\tfor producer := range item.producers {\n\t\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], \"Git final audit exceeded its shared byte budget\")\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tlimit := item.maxOutputBytes\n\t\tif remaining < limit {\n\t\t\tlimit = remaining\n\t\t}\n\t\tauditContext := item.ctx\n\t\tcancelAuditContext := func() {}\n\t\tif item.hasDeadline {\n\t\t\tauditContext, cancelAuditContext = context.WithDeadline(auditContext, item.deadline)\n\t\t}\n\t\tstdout, stderr, err := governanceAuditGit(auditContext, item.files, item.root, item.args, limit)\n\t\tcancelAuditContext()\n\t\tif errors.Is(err, errGovernanceReadViewBudget) {\n\t\t\tcommand := \"unknown\"\n\t\t\tif len(item.args) > 0 {\n\t\t\t\tcommand = item.args[0]\n\t\t\t}\n\t\t\tfor producer := range item.producers {\n\t\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], \"Git command \"+command+\" exceeded its bounded final-audit budget\")\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tremaining -= int64(len(stdout) + len(stderr) + 1)\n\t\tif errorText(err) != item.errText || !bytes.Equal(stdout, item.stdout) || !bytes.Equal(stderr, item.stderr) {\n\t\t\tfor producer := range item.producers {\n\t\t\t\tresult.ChangedProducers[producer] = true\n\t\t\t}\n\t\t\trootDigest := digestBytes([]byte(filepath.Clean(item.root)))\n\t\t\targsDigest := digestBytes([]byte(strings.Join(item.args, \"\\x00\")))\n\t\t\tresult.ChangedPaths = append(result.ChangedPaths, \"git:\"+strings.TrimPrefix(rootDigest, \"sha256:\")+\":\"+strings.TrimPrefix(argsDigest, \"sha256:\"))\n\t\t}\n\t}\n\tstate.auditStreams(&result)\n\tresult.ChangedPaths = uniqueSorted(result.ChangedPaths)\n\tfor producer := range result.UnknownProducers {\n\t\tresult.UnknownProducers[producer] = uniqueSorted(result.UnknownProducers[producer])\n\t}\n\treturn result\n","exit_code":0,"status":"completed"}}
