{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/internal/pose/governance_read_view_git_test.go | head -95; sed -n '1,110p' pose-mcp/internal/cli/artifact_integrity.go; rg -n 'gitStreamBounded|StreamGovernanceRawHistoryGitIn' pose-mcp --glob '*.go'\"","aggregated_output":"package pose\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestGovernanceReadViewGitCapturesAndAuditsExactCommand(t *testing.T) {\n\troot := snapshotRepo(t, map[string]string{\".pose/project.json\": `{\"schema_version\":1,\"project_id\":\"proj.001\",\"name\":\"git view fixture\"}`, \"source.go\": \"package source\\n\"})\n\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\tstore := base.withGovernanceReadView(view, \"git-test\")\n\tfirst, err := captureGovernanceGit(store.fsys(), root, \"git-test\", \"rev-parse\", \"--verify\", \"HEAD\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif strings.TrimSpace(string(first)) == \"\" || view.operation.roots[0].revision != strings.TrimSpace(string(first)) {\n\t\tt.Fatalf(\"source revision was not captured: output=%q binding=%q\", first, view.operation.roots[0].revision)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \"source.go\"), []byte(\"package source\\nfunc Changed() {}\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsnapshotTestGit(t, root, \"add\", \"source.go\")\n\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-m\", \"advance head\")\n\treplayed, err := captureGovernanceGit(store.fsys(), root, \"git-test\", \"rev-parse\", \"--verify\", \"HEAD\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif string(replayed) != string(first) {\n\t\tt.Fatalf(\"repeated Git input escaped its captured generation: first=%q replayed=%q\", first, replayed)\n\t}\n\taudit := view.audit()\n\tif !audit.ChangedProducers[\"git-test\"] || len(audit.ChangedPaths) == 0 {\n\t\tt.Fatalf(\"Git mutation was not exposed by final audit: %+v\", audit)\n\t}\n}\n\nfunc TestGovernanceReadViewRawGitAuditSurvivesCallerCancel(t *testing.T) {\n\troot := snapshotRepo(t, map[string]string{\"source.go\": \"package source\\n\"})\n\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\tstore := base.withGovernanceReadView(view, \"raw-git-context\")\n\tctx, cancel := context.WithCancel(context.Background())\n\tif _, err := CaptureGovernanceRawHistoryGitContextIn(store.fsys(), ctx, root, \"raw-git-context\", 1024, \"rev-parse\", \"--verify\", \"HEAD\"); err != nil {\n\t\tcancel()\n\t\tt.Fatal(err)\n\t}\n\tcancel()\n\taudit := view.audit()\n\tif audit.ChangedProducers[\"raw-git-context\"] || len(audit.UnknownProducers[\"raw-git-context\"]) != 0 {\n\t\tt.Fatalf(\"caller cancellation prevented the bounded raw-history audit rerun: %+v\", audit)\n\t}\n}\n\nfunc TestGovernanceReadViewGitBrokenTagWarningIsUnknown(t *testing.T) {\n\troot := snapshotRepo(t, map[string]string{\"source.go\": \"package source\\n\"})\n\tbrokenRef := filepath.Join(root, \".git\", \"refs\", \"tags\", \"broken\")\n\tif err := os.MkdirAll(filepath.Dir(brokenRef), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(brokenRef, []byte(\"not-an-object-id\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\tstore := base.withGovernanceReadView(view, \"release-status\")\n\tif _, err := captureReleaseTagBindings(store.fsys(), root, \"release-status\"); err == nil {\n\t\tt.Fatal(\"a successful tag listing with a broken-ref warning was treated as complete\")\n\t}\n\tmetadata, _ := view.metadata(store.FederatedProjectID, \"\", \"\", view.audit())\n\tif metadata.Freshness != ReadViewFreshnessUnknown || len(metadata.Limitations) == 0 {\n\t\tt.Fatalf(\"broken release ref did not make the read view unknown: %+v\", metadata)\n\t}\n}\n\nfunc TestGovernanceReadViewGitReservesSharedBudgetBeforeRetainingOutput(t *testing.T) {\n\troot := snapshotRepo(t, map[string]string{\"source.go\": \"package source\\n\"})\n\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\tstore := base.withGovernanceReadView(view, \"git-budget\")\n\n\tshim := t.TempDir()\n\tstarted := filepath.Join(t.TempDir(), \"started\")\n\trelease := filepath.Join(t.TempDir(), \"release\")\n\tgitShim := filepath.Join(shim, \"git\")\n\tscript := \"#!/bin/sh\\n: > \\\"$GOVERNANCE_GIT_STARTED\\\"\\nwhile [ ! -e \\\"$GOVERNANCE_GIT_RELEASE\\\" ]; do sleep 0.01; done\\nprintf '%064d' 0\\n\"\n\tif err := os.WriteFile(gitShim, []byte(script), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"GOVERNANCE_GIT_STARTED\", started)\n\tt.Setenv(\"GOVERNANCE_GIT_RELEASE\", release)\n\tt.Setenv(\"PATH\", shim+string(os.PathListSeparator)+os.Getenv(\"PATH\"))\n\n\tconst competingInput = int64(64)\npackage cli\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"fmt\"\n\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nvar safeGitRevision = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._/~^+-]{0,127}$`)\n\nfunc validateGitRevision(value string) error {\n\tif !safeGitRevision.MatchString(value) || strings.Contains(value, \"..\") || strings.Contains(value, \"@{\") || strings.HasPrefix(value, \"-\") {\n\t\treturn fmt.Errorf(\"unsafe Git revision %q\", value)\n\t}\n\treturn nil\n}\n\n// gitOutputBounded reads raw object history (posemodel.RawHistoryGit), so the\n// change sets a later removal is judged on are the ones it judges (review\n// round 3 of spec pose-delivery-later-removal, LR-R3-01).\nfunc gitOutputBounded(root string, limit int, args ...string) ([]byte, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n\tdefer cancel()\n\treturn gitOutputBoundedContext(ctx, root, limit, args...)\n}\n\nfunc gitOutputBoundedContext(ctx context.Context, root string, limit int, args ...string) ([]byte, error) {\n\tcmd := posemodel.RawHistoryGitContext(ctx, root, args...)\n\tcmd.WaitDelay = 2 * time.Second\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &limitedBuffer{buf: &stdout, limit: limit}\n\tcmd.Stderr = &limitedBuffer{buf: &stderr, limit: 64 * 1024}\n\tif err := cmd.Run(); err != nil {\n\t\tif ctx.Err() != nil {\n\t\t\treturn nil, fmt.Errorf(\"git %s failed: %w\", args[0], ctx.Err())\n\t\t}\n\t\treturn nil, fmt.Errorf(\"git %s failed: %w: %s\", args[0], err, strings.TrimSpace(stderr.String()))\n\t}\n\treturn stdout.Bytes(), nil\n}\n\n// gitStreamBounded streams a raw-history read into sink, bounded like\n// gitOutputBounded, without retaining the output.\nfunc gitStreamBounded(root string, limit int, sink io.Writer, args ...string) error {\n\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n\tdefer cancel()\n\tcmd := posemodel.RawHistoryGitContext(ctx, root, args...)\n\tcmd.WaitDelay = 2 * time.Second\n\tvar stderr bytes.Buffer\n\tcmd.Stdout = &streamThrough{limit: limit, sink: sink}\n\tcmd.Stderr = &limitedBuffer{buf: &stderr, limit: 64 * 1024}\n\tif err := cmd.Run(); err != nil {\n\t\tif ctx.Err() != nil {\n\t\t\treturn fmt.Errorf(\"git %s failed: %w\", args[0], ctx.Err())\n\t\t}\n\t\treturn fmt.Errorf(\"git %s failed: %w: %s\", args[0], err, strings.TrimSpace(stderr.String()))\n\t}\n\treturn nil\n}\n\n// streamThrough counts the bytes against the limit, keeping none, and\n// forwards them to sink.\ntype streamThrough struct {\n\tlimit   int\n\tsink    io.Writer\n\twritten int\n}\n\nfunc (w *streamThrough) Write(data []byte) (int, error) {\n\tif w.written+len(data) > w.limit {\n\t\treturn 0, fmt.Errorf(\"bounded Git output exceeded %d bytes\", w.limit)\n\t}\n\tw.written += len(data)\n\treturn w.sink.Write(data)\n}\n\n// gitOutputBoundedIn preserves the raw-history command policy while routing\n// the exact output through an operation read view when Files carries one.\nfunc gitOutputBoundedIn(files posemodel.Files, root string, limit int, args ...string) ([]byte, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n\tdefer cancel()\n\tout, err := posemodel.CaptureGovernanceRawHistoryGitContextIn(files, ctx, root, \"index.delivery-integrity\", int64(limit), args...)\n\t// The capture retains bounded stderr on ExitError. Keep that forensic cause\n\t// in collection gaps as well as the typed unknown error; never retry outside\n\t// the view or use partial stdout after a failed history read.\n\tvar exit *exec.ExitError\n\tif errors.As(err, &exit) {\n\t\tif detail := strings.TrimSpace(string(exit.Stderr)); detail != \"\" {\n\t\t\treturn nil, fmt.Errorf(\"%w: %s\", err, detail)\n\t\t}\n\t}\n\treturn out, err\npose-mcp/internal/cli/change_set_streamed_digest_test.go:58:\tif err := posemodel.StreamGovernanceRawHistoryGitIn(posemodel.NativeFiles(), context.Background(), root, \"index.delivery-integrity\", 1<<20, io.Discard, \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", gamma, \"--\"); !errors.Is(err, posemodel.ErrGitUnknown) {\npose-mcp/internal/cli/artifact_integrity.go:60:// gitStreamBounded streams a raw-history read into sink, bounded like\npose-mcp/internal/cli/artifact_integrity.go:62:func gitStreamBounded(root string, limit int, sink io.Writer, args ...string) error {\npose-mcp/internal/cli/artifact_integrity.go:242:\t\t\treturn gitStreamBounded(root, limit, sink, args...)\npose-mcp/internal/cli/artifact_integrity.go:246:\t\terr := posemodel.StreamGovernanceRawHistoryGitIn(files, ctx, root, \"index.delivery-integrity\", int64(limit), sink, args...)\npose-mcp/internal/pose/governance_read_view_stream.go:50:// StreamGovernanceRawHistoryGitIn runs a raw-history Git read of an immutable\npose-mcp/internal/pose/governance_read_view_stream.go:56:func StreamGovernanceRawHistoryGitIn(files Files, ctx context.Con