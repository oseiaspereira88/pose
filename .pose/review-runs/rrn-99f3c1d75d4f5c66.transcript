{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc 'git diff d724738b53a8fe94ec9b2eb749a5242958f06d4a 2b2eaede613ef2f1eb778acd07f9fa58e7f33cf6 -- pose-mcp/internal/pose/governance_read_view_stream.go pose-mcp/internal/pose/governance_read_view.go pose-mcp/internal/pose/governance_read_view_git.go pose-mcp/internal/cli/artifact_integrity.go'","aggregated_output":"diff --git a/pose-mcp/internal/cli/artifact_integrity.go b/pose-mcp/internal/cli/artifact_integrity.go\nindex b0f36ad0..e6e6d7cd 100644\n--- a/pose-mcp/internal/cli/artifact_integrity.go\n+++ b/pose-mcp/internal/cli/artifact_integrity.go\n@@ -57,6 +57,41 @@ func gitOutputBoundedContext(ctx context.Context, root string, limit int, args .\n \treturn stdout.Bytes(), nil\n }\n \n+// gitStreamBounded streams a raw-history read into sink, bounded like\n+// gitOutputBounded, without retaining the output.\n+func gitStreamBounded(root string, limit int, sink io.Writer, args ...string) error {\n+\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n+\tdefer cancel()\n+\tcmd := posemodel.RawHistoryGitContext(ctx, root, args...)\n+\tcmd.WaitDelay = 2 * time.Second\n+\tvar stderr bytes.Buffer\n+\tcmd.Stdout = &streamThrough{limit: limit, sink: sink}\n+\tcmd.Stderr = &limitedBuffer{buf: &stderr, limit: 64 * 1024}\n+\tif err := cmd.Run(); err != nil {\n+\t\tif ctx.Err() != nil {\n+\t\t\treturn fmt.Errorf(\"git %s failed: %w\", args[0], ctx.Err())\n+\t\t}\n+\t\treturn fmt.Errorf(\"git %s failed: %w: %s\", args[0], err, strings.TrimSpace(stderr.String()))\n+\t}\n+\treturn nil\n+}\n+\n+// streamThrough counts the bytes against the limit, keeping none, and\n+// forwards them to sink.\n+type streamThrough struct {\n+\tlimit   int\n+\tsink    io.Writer\n+\twritten int\n+}\n+\n+func (w *streamThrough) Write(data []byte) (int, error) {\n+\tif w.written+len(data) > w.limit {\n+\t\treturn 0, fmt.Errorf(\"bounded Git output exceeded %d bytes\", w.limit)\n+\t}\n+\tw.written += len(data)\n+\treturn w.sink.Write(data)\n+}\n+\n // gitOutputBoundedIn preserves the raw-history command policy while routing\n // the exact output through an operation read view when Files carries one.\n func gitOutputBoundedIn(files posemodel.Files, root string, limit int, args ...string) ([]byte, error) {\n@@ -202,6 +237,23 @@ func resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec,\n \t\t}\n \t\treturn gitOutputBoundedIn(files, root, limit, args...)\n \t}\n+\tgitStream := func(limit int, sink io.Writer, args ...string) error {\n+\t\tif files == nil {\n+\t\t\treturn gitStreamBounded(root, limit, sink, args...)\n+\t\t}\n+\t\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n+\t\tdefer cancel()\n+\t\terr := posemodel.StreamGovernanceRawHistoryGitIn(files, ctx, root, \"index.delivery-integrity\", int64(limit), sink, args...)\n+\t\t// As gitOutputBoundedIn does: keep the bounded stderr as the\n+\t\t// forensic cause of a failed history read (review round 2, N1).\n+\t\tvar exit *exec.ExitError\n+\t\tif errors.As(err, &exit) {\n+\t\t\tif detail := strings.TrimSpace(string(exit.Stderr)); detail != \"\" {\n+\t\t\t\treturn fmt.Errorf(\"%w: %s\", err, detail)\n+\t\t\t}\n+\t\t}\n+\t\treturn err\n+\t}\n \tresolveRevision := func(revision string) (string, error) {\n \t\treturn resolveGitRevisionWithFiles(files, root, revision)\n \t}\n@@ -274,11 +326,12 @@ func resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec,\n \t\t\t}\n \t\t\tcommitPathLists = append(commitPathLists, parsed)\n \t\t\tobserved = append(observed, parsed...)\n-\t\t\tcommitDiff, err := gitOutput(16*1024*1024, \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", sha, \"--\")\n-\t\t\tif err != nil {\n+\t\t\t// The commit's patch only feeds the digest: it is streamed into\n+\t\t\t// it, the same bytes in the same order, and the read view keeps\n+\t\t\t// its digest, not its bytes (spec pose-read-view-streamed-object-digests).\n+\t\t\tif err := gitStream(16*1024*1024, diffHash, \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", sha, \"--\"); err != nil {\n \t\t\t\treturn posemodel.ChangeSet{}, err\n \t\t\t}\n-\t\t\t_, _ = diffHash.Write(commitDiff)\n \t\t}\n \t\tpaths = mergeObservedPaths(commitPathLists)\n \t} else {\ndiff --git a/pose-mcp/internal/pose/governance_read_view.go b/pose-mcp/internal/pose/governance_read_view.go\nindex 1072fd11..41246405 100644\n--- a/pose-mcp/internal/pose/governance_read_view.go\n+++ b/pose-mcp/internal/pose/governance_read_view.go\n@@ -22,7 +22,7 @@ const (\n \tGovernanceReadViewSchemaVersion = 1\n \tgovernanceReadViewParserVersion = \"pose-governance-inputs-v1\"\n \tgovernanceReadViewMaxRecords    = 40000\n-\tgovernanceReadViewMaxInputBytes = 1024 * 1024 * 1024\n+\tgovernanceReadViewMaxInputBytes = 512 * 1024 * 1024\n \tgovernanceReadViewMaxMetadata   = 16 * 1024 * 1024\n \tReadViewFreshnessCurrent        = \"current\"\n \tReadViewFreshnessUnknown        = \"unknown\"\n@@ -113,6 +113,7 @@ type governanceReadViewOperation struct {\n \tfinalAudits      map[*governanceReadView]governanceReadViewAudit\n \tbudgetMu         sync.Mutex\n \tinputBytes       int64\n+\tstreamedBytes    int64\n \tmetadataBytes    int64\n \trecords          int\n \tdirectoryEntries int\ndiff --git a/pose-mcp/internal/pose/governance_read_view_git.go b/pose-mcp/internal/pose/governance_read_view_git.go\nindex 2d097182..b0307d1b 100644\n--- a/pose-mcp/internal/pose/governance_read_view_git.go\n+++ b/pose-mcp/internal/pose/governance_read_view_git.go\n@@ -45,6 +45,7 @@ type governanceReadViewGitState struct {\n \top            *governanceReadViewOperation\n \tmu            sync.Mutex\n \tobservations  map[string]*governanceReadViewGitObservation\n+\tstreams       map[string]*governanceReadViewStreamObservation\n \tconfigMu      sync.Mutex\n \tconfigDigests map[string]string\n }\n@@ -280,10 +281,24 @@ func (op *governanceReadViewOperation) captureFilesBoundedContext(files Files, c\n \tif op == nil {\n \t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n \t}\n+\tabsolute, target, state, err := op.gitRoot(root, producer)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif err := target.begin(); err != nil {\n+\t\treturn nil, err\n+\t}\n+\tdefer target.end()\n+\treturn state.capture(files, ctx, absolute, producer, maxOutputBytes, args...)\n+}\n+\n+// gitRoot resolves a Git command's root against the operation's authorized\n+// roots and returns the view that owns it and the operation's Git state.\n+func (op *governanceReadViewOperation) gitRoot(root, producer string) (string, *governanceReadView, *governanceReadViewGitState, error) {\n \tabsolute, err := filepath.Abs(root)\n \tif err != nil {\n \t\top.primary.markUnknown(producer, \"Git root identity could not be resolved\")\n-\t\treturn nil, err\n+\t\treturn \"\", nil, nil, err\n \t}\n \tabsolute = filepath.Clean(absolute)\n \top.mu.Lock()\n@@ -304,16 +319,12 @@ func (op *governanceReadViewOperation) captureFilesBoundedContext(files Files, c\n \top.mu.Unlock()\n \tif !authorized {\n \t\top.primary.markUnknown(producer, \"Git command root is outside the authorized root generation vector\")\n-\t\treturn nil, errGovernanceReadViewOutsideRoot\n+\t\treturn \"\", nil, nil, errGovernanceReadViewOutsideRoot\n \t}\n \tif target == nil {\n \t\ttarget = op.primary\n \t}\n-\tif err := target.begin(); err != nil {\n-\t\treturn nil, err\n-\t}\n-\tdefer target.end()\n-\treturn state.capture(files, ctx, absolute, producer, maxOutputBytes, args...)\n+\treturn absolute, target, state, nil\n }\n \n func (state *governanceReadViewGitState) capture(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n@@ -536,6 +547,7 @@ func (state *governanceReadViewGitState) audit() governanceReadViewAudit {\n \t\t\tresult.ChangedPaths = append(result.ChangedPaths, \"git:\"+strings.TrimPrefix(rootDigest, \"sha256:\")+\":\"+strings.TrimPrefix(argsDigest, \"sha256:\"))\n \t\t}\n \t}\n+\tstate.auditStreams(&result)\n \tresult.ChangedPaths = uniqueSorted(result.ChangedPaths)\n \tfor producer := range result.UnknownProducers {\n \t\tresult.UnknownProducers[producer] = uniqueSorted(result.UnknownProducers[producer])\n@@ -566,6 +578,15 @@ func (state *governanceReadViewGitState) identityDigest() string {\n \t\t\tErrorDigest:  errorDigest(item.errText), Producers: sortedBoolKeys(item.producers),\n \t\t})\n \t}\n+\tfor _, item := range state.streams {\n+\t\targs, _ := json.Marshal(item.args)\n+\t\titems = append(items, identity{\n+\t\t\tRootDigest: digestBytes([]byte(filepath.Clean(item.root))), ArgsDigest: digestBytes(args),\n+\t\t\tOutputLimit:  item.maxBytes,\n+\t\t\tOutputDigest: \"streamed:\" + item.digest + \":\" + fmt.Sprint(item.length),\n+\t\t\tErrorDigest:  errorDigest(item.errText), Producers: sortedBoolKeys(item.producers),\n+\t\t})\n+\t}\n \tstate.mu.Unlock()\n \tsort.Slice(items, func(i, j int) bool {\n \t\tif items[i].RootDigest != items[j].RootDigest {\ndiff --git a/pose-mcp/internal/pose/governance_read_view_stream.go b/pose-mcp/internal/pose/governance_read_view_stream.go\nnew file mode 100644\nindex 00000000..55a072bb\n--- /dev/null\n+++ b/pose-mcp/internal/pose/governance_read_view_stream.go\n@@ -0,0 +1,303 @@\n+package pose\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"crypto/sha256\"\n+\t\"encoding/hex\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"hash\"\n+\t\"io\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"sort\"\n+\t\"strings\"\n+\t\"sync\"\n+\t\"time\"\n+)\n+\n+// Streamed reads (spec pose-read-view-streamed-object-digests): a Git object\n+// read whose bytes a producer only hashes is streamed into the producer and\n+// the read view retains its digest and length, never its bytes. Streamed\n+// bytes have their own budget, apart from the retained captured input.\n+const (\n+\t// governanceReadViewMaxStreamedBytes bounds the bytes one operation\n+\t// streams, and separately the bytes its final audit streams again.\n+\tgovernanceReadViewMaxStreamedBytes = 8 * 1024 * 1024 * 1024\n+\t// governanceReadViewMaxStreamedRead bounds one streamed read.\n+\tgovernanceReadViewMaxStreamedRead = 256 * 1024 * 1024\n+\tgovernanceStreamStderrLimit       = 64 * 1024\n+)\n+\n+type governanceReadViewStreamObservation struct {\n+\troot        string\n+\targs        []string\n+\tfiles       Files\n+\tctx         context.Context\n+\tdeadline    time.Time\n+\thasDeadline bool\n+\tmaxBytes    int64\n+\tdigest      string\n+\tlength      int64\n+\t// errText is the digest of the read's error text, never the text: a\n+\t// warning on stderr can be up to the stderr bound, and a retained copy\n+\t// per read would escape every budget (review round 2, N2).\n+\terrText   string\n+\tproducers map[string]bool\n+}\n+\n+// StreamGovernanceRawHistoryGitIn runs a raw-history Git read of an immutable\n+// object and streams its output into sink. Inside a governance read view the\n+// view records the output's digest and length as the observation and keeps\n+// no bytes; reading the same command again in the operation streams it again\n+// and leaves the producer unknown if it differs. Outside a view it is a\n+// bounded streaming run.\n+func StreamGovernanceRawHistoryGitIn(files Files, ctx context.Context, root, producer string, maxBytes int64, sink io.Writer, args ...string) error {\n+\tif maxBytes <= 0 || maxBytes > governanceReadViewMaxStreamedRead {\n+\t\treturn fmt.Errorf(\"pose: streamed Git output limit must be between 1 and %d bytes\", governanceReadViewMaxStreamedRead)\n+\t}\n+\tif ctx == nil {\n+\t\tctx = context.Background()\n+\t}\n+\tfiles = FilesOrNative(files)\n+\tview, viewFiles := governanceReadViewFromFiles(files)\n+\tif view == nil {\n+\t\t_, _, _, err := runGovernanceGitStreamContext(ctx, files, root, args, maxBytes, nil, sink)\n+\t\treturn err\n+\t}\n+\tif view.operation == nil {\n+\t\tview.markUnknown(producer, \"Git input has no operation-scoped generation vector\")\n+\t\t_, _, _, err := runGovernanceGitStreamContext(ctx, files, root, args, maxBytes, nil, sink)\n+\t\treturn err\n+\t}\n+\tif viewFiles != nil {\n+\t\tif target := view.route(root, producer, viewFiles.project); target == nil {\n+\t\t\tview.markUnknown(producer, \"Git input is outside the authorized root generation vector\")\n+\t\t\treturn errGovernanceReadViewOutsideRoot\n+\t\t} else {\n+\t\t\tview = target\n+\t\t}\n+\t}\n+\top := view.operation\n+\tabsolute, target, state, err := op.gitRoot(root, producer)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif err := target.begin(); err != nil {\n+\t\treturn err\n+\t}\n+\tdefer target.end()\n+\treturn state.stream(files, ctx, absolute, producer, maxBytes, sink, args...)\n+}\n+\n+func (op *governanceReadViewOperation) reserveStreamed(size int64) bool {\n+\tif op == nil {\n+\t\treturn size >= 0 && size <= governanceReadViewMaxStreamedBytes\n+\t}\n+\tif size < 0 {\n+\t\treturn false\n+\t}\n+\top.budgetMu.Lock()\n+\tdefer op.budgetMu.Unlock()\n+\tif size > governanceReadViewMaxStreamedBytes-op.streamedBytes {\n+\t\treturn false\n+\t}\n+\top.streamedBytes += size\n+\treturn true\n+}\n+\n+func (state *governanceReadViewGitState) stream(files Files, ctx context.Context, root, producer string, maxBytes int64, sink io.Writer, args ...string) error {\n+\tdeadline, hasDeadline := ctx.Deadline()\n+\tkey := governanceGitObservationKey(root, args, maxBytes)\n+\tstate.mu.Lock()\n+\tif state.streams == nil {\n+\t\tstate.streams = map[string]*governanceReadViewStreamObservation{}\n+\t}\n+\tprior := state.streams[key]\n+\tif prior == nil {\n+\t\tmetadataCost := int64(len(root) + len(key) + len(producer) + 128)\n+\t\tif !state.op.reserveRecord(metadataCost) {\n+\t\t\tstate.mu.Unlock()\n+\t\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its shared record or metadata budget while streaming Git\")\n+\t\t\treturn errGovernanceReadViewBudget\n+\t\t}\n+\t}\n+\tstate.mu.Unlock()\n+\tdigest, length, stderr, runErr := governanceStreamRun(ctx, files, root, args, maxBytes, state.op.reserveStreamed, sink)\n+\tif errors.Is(runErr, errGovernanceReadViewBudget) {\n+\t\tstate.markUnknownForRoot(root, producer, \"Git streamed output exceeded the read-view streamed byte budget\")\n+\t\treturn errGovernanceReadViewBudget\n+\t}\n+\t_ = stderr\n+\tstate.mu.Lock()\n+\tif prior = state.streams[key]; prior != nil {\n+\t\tprior.producers[producer] = true\n+\t\tsame := prior.digest == digest && prior.length == length && prior.errText == streamErrorDigest(runErr)\n+\t\tstate.mu.Unlock()\n+\t\tif !same {\n+\t\t\tstate.markUnknownForRoot(root, producer, \"a streamed Git object read differed within the operation\")\n+\t\t\treturn errGovernanceReadViewBudget\n+\t\t}\n+\t\treturn runErr\n+\t}\n+\tstate.streams[key] = &governanceReadViewStreamObservation{\n+\t\troot: root, args: append([]string(nil), args...), files: files, ctx: context.WithoutCancel(ctx), deadline: deadline, hasDeadline: hasDeadline,\n+\t\tmaxBytes: maxBytes, digest: digest, length: length, errText: streamErrorDigest(runErr), producers: map[string]bool{producer: true},\n+\t}\n+\tstate.mu.Unlock()\n+\treturn runErr\n+}\n+\n+// auditStreams streams every observation again, under its own audit budget,\n+// and reports a producer changed when the digest, length or error differs.\n+func (state *governanceReadViewGitState) auditStreams(result *governanceReadViewAudit) {\n+\tstate.mu.Lock()\n+\tstreams := make([]governanceReadViewStreamObservation, 0, len(state.streams))\n+\tfor _, item := range state.streams {\n+\t\tcopy := *item\n+\t\tcopy.args = append([]string(nil), item.args...)\n+\t\tcopy.producers = cloneBoolMap(item.producers)\n+\t\tstreams = append(streams, copy)\n+\t}\n+\tstate.mu.Unlock()\n+\tsort.Slice(streams, func(i, j int) bool {\n+\t\treturn governanceGitObservationKey(streams[i].root, streams[i].args, streams[i].maxBytes) < governanceGitObservationKey(streams[j].root, streams[j].args, streams[j].maxBytes)\n+\t})\n+\tvar budgetMu sync.Mutex\n+\tremaining := int64(governanceReadViewMaxStreamedBytes)\n+\tadmit := func(size int64) bool {\n+\t\tbudgetMu.Lock()\n+\t\tdefer budgetMu.Unlock()\n+\t\tif size < 0 || size > remaining {\n+\t\t\treturn false\n+\t\t}\n+\t\tremaining -= size\n+\t\treturn true\n+\t}\n+\t// Every streamed read is streamed again: its rendering depends on Git\n+\t// configuration and attributes the operation does not capture, so no\n+\t// read is proven unchanged without it (review round 1, F1 and F3).\n+\tfor _, item := range streams {\n+\t\tauditContext := item.ctx\n+\t\tcancel := func() {}\n+\t\tif item.hasDeadline {\n+\t\t\tauditContext, cancel = context.WithDeadline(auditContext, item.deadline)\n+\t\t}\n+\t\tdigest, length, _, err := governanceAuditGitStream(auditContext, item.files, item.root, item.args, item.maxBytes, admit, io.Discard)\n+\t\tcancel()\n+\t\tif errors.Is(err, errGovernanceReadViewBudget) {\n+\t\t\tfor producer := range item.producers {\n+\t\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], \"Git streamed final audit exceeded its byte budget\")\n+\t\t\t}\n+\t\t\tcontinue\n+\t\t}\n+\t\tif digest != item.digest || length != item.length || streamErrorDigest(err) != item.errText {\n+\t\t\tfor producer := range item.producers {\n+\t\t\t\tresult.ChangedProducers[producer] = true\n+\t\t\t}\n+\t\t\trootDigest := digestBytes([]byte(filepath.Clean(item.root)))\n+\t\t\targsDigest := digestBytes([]byte(strings.Join(item.args, \"\\x00\")))\n+\t\t\tresult.ChangedPaths = append(result.ChangedPaths, \"git:\"+strings.TrimPrefix(rootDigest, \"sha256:\")+\":\"+strings.TrimPrefix(argsDigest, \"sha256:\"))\n+\t\t}\n+\t}\n+}\n+\n+// governanceStreamRun and governanceAuditGitStream run streamed reads during\n+// the operation and in its final audit.\n+var (\n+\tgovernanceStreamRun      = runGovernanceGitStreamContext\n+\tgovernanceAuditGitStream = runGovernanceGitStreamContext\n+)\n+\n+// runGovernanceGitStreamContext runs Git like the captured reads do and\n+// writes its stdout to sink as it arrives, admitting each chunk before it is\n+// written and hashing it; stderr is kept bounded. It returns the stdout's\n+// digest and length. A non-empty stderr is an error, as for captured reads.\n+func runGovernanceGitStreamContext(ctx context.Context, files Files, root string, args []string, limit int64, admit func(int64) bool, sink io.Writer) (string, int64, []byte, error) {\n+\tif limit <= 0 {\n+\t\treturn \"\", 0, nil, errGovernanceReadViewBudget\n+\t}\n+\t_ = FilesOrNative(files)\n+\tif ctx == nil {\n+\t\tctx = context.Background()\n+\t}\n+\tif sink == nil {\n+\t\tsink = io.Discard\n+\t}\n+\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n+\tcmd.WaitDelay = 2 * time.Second\n+\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n+\tout := &governanceStreamWriter{limit: limit, admit: admit, sink: sink, hash: sha256.New()}\n+\tvar stderr bytes.Buffer\n+\tcmd.Stdout = out\n+\tcmd.Stderr = &limitedStderr{buf: &stderr, limit: governanceStreamStderrLimit}\n+\terr := cmd.Run()\n+\tif out.exceeded {\n+\t\treturn \"\", 0, nil, errGovernanceReadViewBudget\n+\t}\n+\tdigest := \"sha256:\" + hex.EncodeToString(out.hash.Sum(nil))\n+\tif err != nil {\n+\t\tif exit, ok := err.(*exec.ExitError); ok {\n+\t\t\texit.Stderr = append([]byte(nil), stderr.Bytes()...)\n+\t\t}\n+\t\treturn digest, out.written, stderr.Bytes(), &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n+\t}\n+\tif stderr.Len() > 0 {\n+\t\tdetail := strings.TrimSpace(stderr.String())\n+\t\tif detail == \"\" {\n+\t\t\tdetail = \"Git wrote unclassified stderr output\"\n+\t\t}\n+\t\treturn digest, out.written, stderr.Bytes(), &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: errors.New(detail)}\n+\t}\n+\treturn digest, out.written, nil, nil\n+}\n+\n+type governanceStreamWriter struct {\n+\tmu       sync.Mutex\n+\tlimit    int64\n+\twritten  int64\n+\tadmit    func(int64) bool\n+\tsink     io.Writer\n+\thash     hash.Hash\n+\texceeded bool\n+}\n+\n+func (w *governanceStreamWriter) Write(data []byte) (int, error) {\n+\tw.mu.Lock()\n+\tdefer w.mu.Unlock()\n+\tif w.exceeded || int64(len(data)) > w.limit-w.written || w.admit != nil && !w.admit(int64(len(data))) {\n+\t\tw.exceeded = true\n+\t\treturn 0, errGovernanceReadViewBudget\n+\t}\n+\tif _, err := w.sink.Write(data); err != nil {\n+\t\treturn 0, err\n+\t}\n+\tw.hash.Write(data)\n+\tw.written += int64(len(data))\n+\treturn len(data), nil\n+}\n+\n+type limitedStderr struct {\n+\tbuf   *bytes.Buffer\n+\tlimit int\n+}\n+\n+func (w *limitedStderr) Write(data []byte) (int, error) {\n+\tif room := w.limit - w.buf.Len(); room > 0 {\n+\t\tif len(data) > room {\n+\t\t\tw.buf.Write(data[:room])\n+\t\t} else {\n+\t\t\tw.buf.Write(data)\n+\t\t}\n+\t}\n+\treturn len(data), nil\n+}\n+\n+// streamErrorDigest is the fixed-size identity of a streamed read's error.\n+func streamErrorDigest(err error) string {\n+\tif err == nil {\n+\t\treturn \"\"\n+\t}\n+\treturn digestBytes([]byte(errorText(err)))\n+}\n","exit_code":0,"status":"completed"}}
