{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/AGENTS.md; nl -ba pose-mcp/internal/cli/doctor_commit_graph_test.go'","aggregated_output":"cat: pose-mcp/AGENTS.md: No such file or directory\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"encoding/json\"\n     6\t\t\"errors\"\n     7\t\t\"os\"\n     8\t\t\"os/exec\"\n     9\t\t\"path/filepath\"\n    10\t\t\"strings\"\n    11\t\t\"testing\"\n    12\t)\n    13\t\n    14\tfunc doctorCommitGraphFinding(t *testing.T, repo string) doctorFinding {\n    15\t\tt.Helper()\n    16\t\tvar finding doctorFinding\n    17\t\tinDir(t, repo, func() {\n    18\t\t\tvar out, errB bytes.Buffer\n    19\t\t\tMain([]string{\"doctor\", \"--json\"}, &out, &errB)\n    20\t\t\tvar report doctorJSON\n    21\t\t\tif err := json.Unmarshal(out.Bytes(), &report); err != nil {\n    22\t\t\t\tt.Fatalf(\"invalid JSON: %v\\n%s\", err, out.String())\n    23\t\t\t}\n    24\t\t\tfor _, f := range report.Findings {\n    25\t\t\t\tif f.Check == \"git.commit-graph\" {\n    26\t\t\t\t\tfinding = f\n    27\t\t\t\t}\n    28\t\t\t}\n    29\t\t})\n    30\t\tif finding.Check == \"\" {\n    31\t\t\tt.Fatal(\"doctor reported no git.commit-graph check\")\n    32\t\t}\n    33\t\treturn finding\n    34\t}\n    35\t\n    36\tfunc gitInRepo(t *testing.T, repo string, args ...string) {\n    37\t\tt.Helper()\n    38\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", repo}, args...)...).CombinedOutput(); err != nil {\n    39\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n    40\t\t}\n    41\t}\n    42\t\n    43\tfunc removeCommitGraph(t *testing.T, repo string) {\n    44\t\tt.Helper()\n    45\t\tinfo := filepath.Join(repo, \".git\", \"objects\", \"info\")\n    46\t\tfor _, name := range []string{\"commit-graph\", \"commit-graphs\"} {\n    47\t\t\tif err := os.RemoveAll(filepath.Join(info, name)); err != nil {\n    48\t\t\t\tt.Fatal(err)\n    49\t\t\t}\n    50\t\t}\n    51\t}\n    52\t\n    53\t// Spec pose-doctor-recommends-the-commit-graph: R1 a long history Git walks\n    54\t// whole is a next step with a fix; R2 the fix writes the filters and the\n    55\t// check turns ok; R3 a short history needs none. The answer is Git's own, so\n    56\t// it follows whichever graph Git loads.\n    57\tfunc TestDoctorRecommendsTheCommitGraph(t *testing.T) {\n    58\t\trepo := doctorFixture(t)\n    59\t\toriginal := commitGraphHistoryThreshold\n    60\t\tt.Cleanup(func() { commitGraphHistoryThreshold = original })\n    61\t\tfor i := 0; i < 4; i++ {\n    62\t\t\t// Each commit changes a file of its own, so a lookup of another path\n    63\t\t\t// has commits the filters can rule out.\n    64\t\t\tif err := os.WriteFile(filepath.Join(repo, \"zz-history.txt\"), []byte(strings.Repeat(\"x\", i+1)), 0o644); err != nil {\n    65\t\t\t\tt.Fatal(err)\n    66\t\t\t}\n    67\t\t\tgitInRepo(t, repo, \"add\", \"zz-history.txt\")\n    68\t\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"history\")\n    69\t\t}\n    70\t\tremoveCommitGraph(t, repo)\n    71\t\n    72\t\tcommitGraphHistoryThreshold = 1 << 30\n    73\t\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"ok\" {\n    74\t\t\tt.Fatalf(\"a short history is not ok: %+v\", f)\n    75\t\t}\n    76\t\n    77\t\tcommitGraphHistoryThreshold = 3\n    78\t\tmissing := doctorCommitGraphFinding(t, repo)\n    79\t\tif missing.Level != \"next\" || missing.FixCode != \"git.commit-graph\" || missing.RemediationClass != remediationFixable {\n    80\t\t\tt.Fatalf(\"a long history without a commit-graph: %+v\", missing)\n    81\t\t}\n    82\t\n    83\t\tinDir(t, repo, func() {\n    84\t\t\tvar out, errB bytes.Buffer\n    85\t\t\tMain([]string{\"doctor\", \"--fix\", \"--yes\", \"--only\", \"git.commit-graph\"}, &out, &errB)\n    86\t\t})\n    87\t\tif fixed := doctorCommitGraphFinding(t, repo); fixed.Level != \"ok\" {\n    88\t\t\tt.Fatalf(\"the fix did not satisfy the check: %+v\", fixed)\n    89\t\t}\n    90\t\n    91\t\tremoveCommitGraph(t, repo)\n    92\t\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--no-changed-paths\")\n    93\t\tif plain := doctorCommitGraphFinding(t, repo); plain.Level != \"next\" {\n    94\t\t\tt.Fatalf(\"a commit-graph without changed-path filters is not recommended again: %+v\", plain)\n    95\t\t}\n    96\t\n    97\t\tremoveCommitGraph(t, repo)\n    98\t\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--changed-paths\", \"--split\")\n    99\t\tif split := doctorCommitGraphFinding(t, repo); split.Level != \"ok\" {\n   100\t\t\tt.Fatalf(\"a split commit-graph with changed paths is not recognized: %+v\", split)\n   101\t\t}\n   102\t\n   103\t\t// Review F3: with a single graph and a chain, Git loads the single graph.\n   104\t\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--no-changed-paths\")\n   105\t\tif both := doctorCommitGraphFinding(t, repo); both.Level != \"next\" {\n   106\t\t\tt.Fatalf(\"an unfiltered single graph beside a filtered chain is judged by the chain: %+v\", both)\n   107\t\t}\n   108\t\tremoveCommitGraph(t, repo)\n   109\t\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--changed-paths\")\n   110\t\n   111\t\t// Review F2: a repository whose graph lives only in an alternate.\n   112\t\tshared := filepath.Join(t.TempDir(), \"shared\")\n   113\t\tif out, err := exec.Command(\"git\", \"clone\", \"-q\", \"--shared\", repo, shared).CombinedOutput(); err != nil {\n   114\t\t\tt.Fatalf(\"clone --shared: %v %s\", err, out)\n   115\t\t}\n   116\t\tremoveCommitGraph(t, shared)\n   117\t\tstate, err := readCommitGraphState(shared)\n   118\t\tif err != nil || !state.filtersUsed {\n   119\t\t\tt.Fatalf(\"a graph in an alternate is not seen: %+v %v\", state, err)\n   120\t\t}\n   121\t}\n   122\t\n   123\t// Review F5: a repository whose history cannot be read is a warning, not a\n   124\t// silent pass; a root that is not a repository gets no check.\n   125\tfunc TestDoctorCommitGraphReportsAnUnreadableHistory(t *testing.T) {\n   126\t\tif _, err := readCommitGraphState(t.TempDir()); !errors.Is(err, errCommitGraphNotApplicable) {\n   127\t\t\tt.Fatalf(\"a directory outside Git: %v, want not applicable\", err)\n   128\t\t}\n   129\t\trepo := doctorFixture(t)\n   130\t\toriginal := commitGraphHistoryThreshold\n   131\t\tt.Cleanup(func() { commitGraphHistoryThreshold = original })\n   132\t\tcommitGraphHistoryThreshold = 1\n   133\t\t// Each commit records a file, so HEAD has one to look up.\n   134\t\tfor i := 0; i < 2; i++ {\n   135\t\t\tif err := os.WriteFile(filepath.Join(repo, \"zz-history.txt\"), []byte(strings.Repeat(\"x\", i+1)), 0o644); err != nil {\n   136\t\t\t\tt.Fatal(err)\n   137\t\t\t}\n   138\t\t\tgitInRepo(t, repo, \"add\", \"zz-history.txt\")\n   139\t\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"history\")\n   140\t\t}\n   141\t\tout, err := exec.Command(\"git\", \"-C\", repo, \"rev-parse\", \"HEAD~1\").Output()\n   142\t\tif err != nil {\n   143\t\t\tt.Fatal(err)\n   144\t\t}\n   145\t\tparent := strings.TrimSpace(string(out))\n   146\t\tif err := os.Remove(filepath.Join(repo, \".git\", \"objects\", parent[:2], parent[2:])); err != nil {\n   147\t\t\tt.Fatalf(\"the parent commit is not a loose object: %v\", err)\n   148\t\t}\n   149\t\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"warn\" || !strings.Contains(f.Message, \"could not be read\") {\n   150\t\t\tt.Fatalf(\"an unreadable history: %+v\", f)\n   151\t\t}\n   152\t}\n   153\t\n   154\t// longHistoryRepo is an installed repository with commits that each change a\n   155\t// file of their own, the threshold lowered under them, and its commit-graph\n   156\t// written with changed-path filters.\n   157\tfunc longHistoryRepo(t *testing.T, extra func(repo string)) string {\n   158\t\tt.Helper()\n   159\t\trepo := doctorFixture(t)\n   160\t\toriginal := commitGraphHistoryThreshold\n   161\t\tt.Cleanup(func() { commitGraphHistoryThreshold = original })\n   162\t\tcommitGraphHistoryThreshold = 3\n   163\t\tif extra != nil {\n   164\t\t\textra(repo)\n   165\t\t}\n   166\t\tfor i := 0; i < 4; i++ {\n   167\t\t\tif err := os.WriteFile(filepath.Join(repo, \"zz-history.txt\"), []byte(strings.Repeat(\"x\", i+1)), 0o644); err != nil {\n   168\t\t\t\tt.Fatal(err)\n   169\t\t\t}\n   170\t\t\tgitInRepo(t, repo, \"add\", \"zz-history.txt\")\n   171\t\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"history\")\n   172\t\t}\n   173\t\tremoveCommitGraph(t, repo)\n   174\t\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--changed-paths\")\n   175\t\treturn repo\n   176\t}\n   177\t\n   178\t// Review F6: an unborn HEAD is not applicable, but a repository Git cannot\n   179\t// open is reported.\n   180\tfunc TestDoctorCommitGraphTellsUnbornFromBroken(t *testing.T) {\n   181\t\tunborn := t.TempDir()\n   182\t\tgitInRepo(t, unborn, \"init\", \"-q\")\n   183\t\tif _, err := readCommitGraphState(unborn); !errors.Is(err, errCommitGraphNotApplicable) {\n   184\t\t\tt.Fatalf(\"an unborn HEAD: %v, want not applicable\", err)\n   185\t\t}\n   186\t\tbroken := longHistoryRepo(t, nil)\n   187\t\tgitInRepo(t, broken, \"config\", \"core.bare\", \"invalid\")\n   188\t\tif _, err := readCommitGraphState(broken); err == nil || errors.Is(err, errCommitGraphNotApplicable) {\n   189\t\t\tt.Fatalf(\"a repository with an invalid configuration: %v, want a reported failure\", err)\n   190\t\t}\n   191\t\theadless := longHistoryRepo(t, nil)\n   192\t\tout, err := exec.Command(\"git\", \"-C\", headless, \"rev-parse\", \"HEAD\").Output()\n   193\t\tif err != nil {\n   194\t\t\tt.Fatal(err)\n   195\t\t}\n   196\t\thead := strings.TrimSpace(string(out))\n   197\t\tif err := os.Remove(filepath.Join(headless, \".git\", \"objects\", head[:2], head[2:])); err != nil {\n   198\t\t\tt.Fatalf(\"the HEAD commit is not a loose object: %v\", err)\n   199\t\t}\n   200\t\tremoveCommitGraph(t, headless)\n   201\t\tif _, err := readCommitGraphState(headless); err == nil || errors.Is(err, errCommitGraphNotApplicable) {\n   202\t\t\tt.Fatalf(\"a HEAD whose commit is missing: %v, want a reported failure\", err)\n   203\t\t}\n   204\t}\n   205\t\n   206\t// Review F7: a first file whose name is pathspec syntax is looked up as the\n   207\t// literal name, so the filters still answer.\n   208\tfunc TestDoctorCommitGraphProbesALiteralPath(t *testing.T) {\n   209\t\trepo := longHistoryRepo(t, func(repo string) {\n   210\t\t\tif err := os.WriteFile(filepath.Join(repo, \"*\"), []byte(\"star\\n\"), 0o644); err != nil {\n   211\t\t\t\tt.Fatal(err)\n   212\t\t\t}\n   213\t\t\tgitInRepo(t, repo, \"add\", \"--\", \"*\")\n   214\t\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"star\")\n   215\t\t})\n   216\t\tout, err := exec.Command(\"git\", \"-C\", repo, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\").Output()\n   217\t\tif err != nil || !strings.HasPrefix(string(out), \"*\\n\") {\n   218\t\t\tt.Fatalf(\"the fixture's first path is not '*': %q %v\", out, err)\n   219\t\t}\n   220\t\tstate, err := readCommitGraphState(repo)\n   221\t\tif err != nil || !state.filtersUsed {\n   222\t\t\tt.Fatalf(\"a filtered graph probed through a pathspec-like name: %+v %v\", state, err)\n   223\t\t}\n   224\t}\n   225\t\n   226\t// Review F8: configuration that keeps Git from reading the filters is a\n   227\t// warning that names it, not a graph rewrite that cannot help.\n   228\tfunc TestDoctorCommitGraphNamesDisabledReads(t *testing.T) {\n   229\t\trepo := longHistoryRepo(t, nil)\n   230\t\tgitInRepo(t, repo, \"config\", \"commitGraph.changedPathsVersion\", \"0\")\n   231\t\tvar reads doctorFinding\n   232\t\tinDir(t, repo, func() {\n   233\t\t\tvar out, errB bytes.Buffer\n   234\t\t\tMain([]string{\"doctor\", \"--json\"}, &out, &errB)\n   235\t\t\tvar report doctorJSON\n   236\t\t\tif err := json.Unmarshal(out.Bytes(), &report); err != nil {\n   237\t\t\t\tt.Fatalf(\"invalid JSON: %v\", err)\n   238\t\t\t}\n   239\t\t\tfor _, f := range report.Findings {\n   240\t\t\t\tif f.Check == \"git.commit-graph\" {\n   241\t\t\t\t\tt.Errorf(\"the graph rewrite is recommended although configuration disables reading it: %+v\", f)\n   242\t\t\t\t}\n   243\t\t\t\tif f.Check == \"git.commit-graph-reads\" {\n   244\t\t\t\t\treads = f\n   245\t\t\t\t}\n   246\t\t\t}\n   247\t\t})\n   248\t\tif reads.Level != \"warn\" || !strings.Contains(reads.Message, \"commitGraph.changedPathsVersion=0\") || reads.FixCode != \"\" {\n   249\t\t\tt.Fatalf(\"disabled filter reads: %+v\", reads)\n   250\t\t}\n   251\t}\n   252\t\n   253\t// Review F15: a shallow clone, whose history Git cannot put in a\n   254\t// commit-graph, gets no recommendation it cannot satisfy.\n   255\tfunc TestDoctorCommitGraphSkipsAShallowClone(t *testing.T) {\n   256\t\trepo := longHistoryRepo(t, nil)\n   257\t\tshallow := filepath.Join(t.TempDir(), \"shallow\")\n   258\t\tif out, err := exec.Command(\"git\", \"clone\", \"-q\", \"--depth\", \"4\", \"file://\"+repo, shallow).CombinedOutput(); err != nil {\n   259\t\t\tt.Fatalf(\"shallow clone: %v %s\", err, out)\n   260\t\t}\n   261\t\tif _, err := readCommitGraphState(shallow); !errors.Is(err, errCommitGraphNotApplicable) {\n   262\t\t\tt.Fatalf(\"a shallow clone: %v, want not applicable\", err)\n   263\t\t}\n   264\t}\n   265\t\n   266\t// Review F16: the fix writes filters for every commit even when\n   267\t// commitGraph.maxNewFilters would allow none.\n   268\tfunc TestDoctorCommitGraphFixIgnoresMaxNewFilters(t *testing.T) {\n   269\t\trepo := longHistoryRepo(t, nil)\n   270\t\tgitInRepo(t, repo, \"config\", \"commitGraph.maxNewFilters\", \"0\")\n   271\t\tremoveCommitGraph(t, repo)\n   272\t\tif err := writeCommitGraph(repo); err != nil {\n   273\t\t\tt.Fatal(err)\n   274\t\t}\n   275\t\tstate, err := readCommitGraphState(repo)\n   276\t\tif err != nil || !state.filtersUsed {\n   277\t\t\tt.Fatalf(\"the fix under maxNewFilters=0: %+v %v\", state, err)\n   278\t\t}\n   279\t}\n   280\t\n   281\t// Review F17: a HEAD with no file to look up is not applicable, not a\n   282\t// rewrite recommended forever.\n   283\tfunc TestDoctorCommitGraphSkipsAnEmptyTree(t *testing.T) {\n   284\t\trepo := longHistoryRepo(t, nil)\n   285\t\tgitInRepo(t, repo, \"rm\", \"-q\", \"-r\", \"--\", \".\")\n   286\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"empty\")\n   287\t\tif _, err := readCommitGraphState(repo); !errors.Is(err, errCommitGraphNotApplicable) {\n   288\t\t\tt.Fatalf(\"an empty HEAD tree: %v, want not applicable\", err)\n   289\t\t}\n   290\t}\n   291\t\n   292\t// Review F18: commitGraph.changedPathsVersion overrides the deprecated\n   293\t// readChangedPaths, so a missing graph is still a fixable recommendation.\n   294\tfunc TestDoctorCommitGraphFollowsConfigurationPrecedence(t *testing.T) {\n   295\t\trepo := longHistoryRepo(t, nil)\n   296\t\tgitInRepo(t, repo, \"config\", \"commitGraph.readChangedPaths\", \"false\")\n   297\t\tgitInRepo(t, repo, \"config\", \"commitGraph.changedPathsVersion\", \"1\")\n   298\t\tremoveCommitGraph(t, repo)\n   299\t\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"next\" || f.FixCode != \"git.commit-graph\" {\n   300\t\t\tt.Fatalf(\"a missing graph under changedPathsVersion=1 and readChangedPaths=false: %+v\", f)\n   301\t\t}\n   302\t}\n   303\t\n   304\t// Review F19: in a partial clone that lacks trees, the diagnosis fails\n   305\t// without fetching anything from the remote.\n   306\tfunc TestDoctorCommitGraphNeverFetches(t *testing.T) {\n   307\t\trepo := longHistoryRepo(t, nil)\n   308\t\tgitInRepo(t, repo, \"config\", \"uploadpack.allowFilter\", \"true\")\n   309\t\tpartial := filepath.Join(t.TempDir(), \"partial\")\n   310\t\tif out, err := exec.Command(\"git\", \"clone\", \"-q\", \"--no-checkout\", \"--filter=tree:0\", \"file://\"+repo, partial).CombinedOutput(); err != nil {\n   311\t\t\tt.Fatalf(\"partial clone: %v %s\", err, out)\n   312\t\t}\n   313\t\tobjects := func() string {\n   314\t\t\tout, err := exec.Command(\"git\", \"-C\", partial, \"count-objects\", \"-v\").Output()\n   315\t\t\tif err != nil {\n   316\t\t\t\tt.Fatal(err)\n   317\t\t\t}\n   318\t\t\treturn string(out)\n   319\t\t}\n   320\t\tbefore := objects()\n   321\t\toriginal := commitGraphHistoryThreshold\n   322\t\tcommitGraphHistoryThreshold = 1\n   323\t\tt.Cleanup(func() { commitGraphHistoryThreshold = original })\n   324\t\tif _, err := readCommitGraphState(partial); err == nil || errors.Is(err, errCommitGraphNotApplicable) {\n   325\t\t\tt.Fatalf(\"a partial clone without its trees: %v, want a reported failure\", err)\n   326\t\t}\n   327\t\tif after := objects(); after != before {\n   328\t\t\tt.Fatalf(\"the diagnosis fetched objects:\\nbefore %s\\nafter %s\", before, after)\n   329\t\t}\n   330\t}\n   331\t\n   332\t// Review F20: a commit-graph Git cannot read, which it reports on stderr\n   333\t// while falling back to a plain walk, is a warning, not a rewrite.\n   334\tfunc TestDoctorCommitGraphReportsAnUnreadableGraph(t *testing.T) {\n   335\t\trepo := longHistoryRepo(t, nil)\n   336\t\tgraph := filepath.Join(repo, \".git\", \"objects\", \"info\", \"commit-graph\")\n   337\t\tremoveCommitGraph(t, repo)\n   338\t\tif err := os.WriteFile(graph, []byte(\"CGPH\\x01\\x01\\x05\\x00garbage\"), 0o444); err != nil {\n   339\t\t\tt.Fatal(err)\n   340\t\t}\n   341\t\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"warn\" {\n   342\t\t\tt.Fatalf(\"an unreadable commit-graph: %+v\", f)\n   343\t\t}\n   344\t}\n   345\t\n   346\t// shortHistoryRepo is an installed repository with a few commits that each\n   347\t// change a file, under the default threshold.\n   348\tfunc shortHistoryRepo(t *testing.T) string {\n   349\t\tt.Helper()\n   350\t\trepo := doctorFixture(t)\n   351\t\tfor i := 0; i < 3; i++ {\n   352\t\t\tif err := os.WriteFile(filepath.Join(repo, \"zz-history.txt\"), []byte(strings.Repeat(\"x\", i+1)), 0o644); err != nil {\n   353\t\t\t\tt.Fatal(err)\n   354\t\t\t}\n   355\t\t\tgitInRepo(t, repo, \"add\", \"zz-history.txt\")\n   356\t\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"history\")\n   357\t\t}\n   358\t\treturn repo\n   359\t}\n   360\t\n   361\t// Review F21: below the threshold too, a commit-graph Git cannot read is a\n   362\t// warning.\n   363\tfunc TestDoctorCommitGraphWarnsBelowTheThreshold(t *testing.T) {\n   364\t\trepo := shortHistoryRepo(t)\n   365\t\tremoveCommitGraph(t, repo)\n   366\t\tgraph := filepath.Join(repo, \".git\", \"objects\", \"info\", \"commit-graph\")\n   367\t\tif err := os.WriteFile(graph, []byte(\"CGPH\\x01\\x01\\x05\\x00garbage\"), 0o444); err != nil {\n   368\t\t\tt.Fatal(err)\n   369\t\t}\n   370\t\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"warn\" {\n   371\t\t\tt.Fatalf(\"an unreadable commit-graph under a short history: %+v\", f)\n   372\t\t}\n   373\t}\n   374\t\n   375\t// Review F22: a HEAD without files is not applicable under a short history\n   376\t// too.\n   377\tfunc TestDoctorCommitGraphSkipsAShortEmptyTree(t *testing.T) {\n   378\t\trepo := shortHistoryRepo(t)\n   379\t\tgitInRepo(t, repo, \"rm\", \"-q\", \"-r\", \"--\", \".\")\n   380\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"empty\")\n   381\t\tif _, err := readCommitGraphState(repo); !errors.Is(err, errCommitGraphNotApplicable) {\n   382\t\t\tt.Fatalf(\"a short history with an empty HEAD tree: %v, want not applicable\", err)\n   383\t\t}\n   384\t}\n   385\t\n   386\t// Review F23: the command doctor shows is the one its fix runs, and\n   387\t// following it by hand writes the filters under commitGraph.maxNewFilters=0.\n   388\tfunc TestDoctorCommitGraphShowsTheEffectiveCommand(t *testing.T) {\n   389\t\trepo := longHistoryRepo(t, nil)\n   390\t\tgitInRepo(t, repo, \"config\", \"commitGraph.maxNewFilters\", \"0\")\n   391\t\tremoveCommitGraph(t, repo)\n   392\t\tf := doctorCommitGraphFinding(t, repo)\n   393\t\tif f.Level != \"next\" || !strings.Contains(f.Hint, \"'\"+commitGraphWriteCommand+\"'\") {\n   394\t\t\tt.Fatalf(\"the shown command is not the fix's: %+v\", f)\n   395\t\t}\n   396\t\targs := strings.Fields(strings.TrimPrefix(commitGraphWriteCommand, \"git \"))\n   397\t\tgitInRepo(t, repo, args...)\n   398\t\tstate, err := readCommitGraphState(repo)\n   399\t\tif err != nil || !state.filtersUsed {\n   400\t\t\tt.Fatalf(\"following the shown command under maxNewFilters=0: %+v %v\", state, err)\n   401\t\t}\n   402\t}\n","exit_code":0,"status":"completed"}}
