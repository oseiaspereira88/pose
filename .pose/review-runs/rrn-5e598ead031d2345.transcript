{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,135p' pose-mcp/internal/pose/spec_trailers.go; nl -ba pose-mcp/internal/cli/doctor_commit_graph.go; git log --format='%h %s' 2bf2adf1..02ee99b6 -- .pose/indexes/validation-matrix.json\"","aggregated_output":"package pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n)\n\n// Spec pose-spec-facts-evidence-binding: the facts and the attribution of change sets read the\n// trailers of the history in one way.\n\n// SpecTrailerLogArgs are the arguments of the `git log` whose output ParseSpecTrailerLog reads:\n// every ref, oldest first, the commits that mention a POSE-Spec trailer, hash and full body.\nvar SpecTrailerLogArgs = []string{\"log\", \"--all\", \"--reverse\", \"--grep=POSE-Spec:\", \"--format=%H%x00%B%x00\"}\n\n// ParseSpecTrailerLog maps each spec slug to the commits that carry its trailer. A trailer is a\n// line of the body that starts with `POSE-Spec:` after trimming; the slug is the rest of the\n// line, trimmed. It does not use Git's trailer parser.\n// SpecTrailerLogEntry is one commit of the trailer log, in log order, with\n// the slug of each POSE-Spec line it carries (repeated if the line repeats).\ntype SpecTrailerLogEntry struct {\n\tSHA   string\n\tSpecs []string\n}\n\n// ParseSpecTrailerLogOrdered is ParseSpecTrailerLog keeping the log order:\n// every spec's commit list is the subsequence of these entries that names it\n// (spec pose-index-streams-each-commit-once).\nfunc ParseSpecTrailerLogOrdered(out []byte) []SpecTrailerLogEntry {\n\tparts := bytes.Split(out, []byte{0})\n\tentries := []SpecTrailerLogEntry{}\n\tfor i := 0; i+1 < len(parts); i += 2 {\n\t\tentry := SpecTrailerLogEntry{SHA: strings.TrimSpace(string(parts[i]))}\n\t\tfor _, line := range strings.Split(string(parts[i+1]), \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif strings.HasPrefix(line, \"POSE-Spec:\") {\n\t\t\t\tif spec := strings.TrimSpace(strings.TrimPrefix(line, \"POSE-Spec:\")); spec != \"\" {\n\t\t\t\t\tentry.Specs = append(entry.Specs, spec)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif len(entry.Specs) > 0 {\n\t\t\tentries = append(entries, entry)\n\t\t}\n\t}\n\treturn entries\n}\n\nfunc ParseSpecTrailerLog(out []byte) map[string][]string {\n\tparts := bytes.Split(out, []byte{0})\n\tspecCommits := map[string][]string{}\n\tfor i := 0; i+1 < len(parts); i += 2 {\n\t\tsha, body := strings.TrimSpace(string(parts[i])), string(parts[i+1])\n\t\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif strings.HasPrefix(line, \"POSE-Spec:\") {\n\t\t\t\tspec := strings.TrimSpace(strings.TrimPrefix(line, \"POSE-Spec:\"))\n\t\t\t\tif spec != \"\" {\n\t\t\t\t\tspecCommits[spec] = append(specCommits[spec], sha)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn specCommits\n}\n\n// RawHistoryGit is a git command on root's raw object history: replace refs\n// (--no-replace-objects) and grafts (GIT_GRAFT_FILE at the always-empty null\n// device, which overrides both the repository's graft file and one the\n// environment names) never change which commits carry a trailer, what a change\n// set holds, or what a later removal is judged on (spec\n// pose-delivery-later-removal R3, review round 4 LR-R4-01).\nfunc RawHistoryGit(root string, args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// RawHistoryGitContext is RawHistoryGit under ctx.\nfunc RawHistoryGitContext(ctx context.Context, root string, args ...string) *exec.Cmd {\n\treturn gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// GitHooksDir is the directory git runs the hooks of root from: a linked worktree shares the\n// one of its common directory, and core.hooksPath moves it. Where git cannot answer it is\n// `.git/hooks`, which is where a repository would keep them.\nfunc GitHooksDir(root string) string {\n\tout, err := RawHistoryGit(root, \"rev-parse\", \"--git-path\", \"hooks\").Output()\n\tif err != nil {\n\t\treturn filepath.Join(root, \".git\", \"hooks\")\n\t}\n\tdir := strings.TrimSuffix(string(out), \"\\n\")\n\tif filepath.IsAbs(dir) {\n\t\treturn dir\n\t}\n\treturn filepath.Join(root, dir)\n}\n\n// RawGit is RawHistoryGit for a caller whose arguments already say where to read.\nfunc RawGit(args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\"}, args...)...)\n}\n\n// SpecTrailerCommits reads the history of root and returns the commits that carry the trailer of\n// slug, the way the attribution of change sets does. An error is a history that could not be\n// read, which is not a history without commits.\nfunc SpecTrailerCommits(root, slug string) ([]string, error) {\n\tout, err := RawHistoryGit(root, SpecTrailerLogArgs...).Output()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn ParseSpecTrailerLog(out)[slug], nil\n}\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bufio\"\n     5\t\t\"bytes\"\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"strconv\"\n    12\t\t\"strings\"\n    13\t\n    14\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    15\t)\n    16\t\n    17\t// commitGraphHistoryThreshold is the history size from which a last-commit\n    18\t// lookup by path is worth accelerating: below it a history walk costs a few\n    19\t// milliseconds (spec pose-doctor-recommends-the-commit-graph).\n    20\tvar commitGraphHistoryThreshold = 500\n    21\t\n    22\t// errCommitGraphNotApplicable marks a root the check does not apply to: not\n    23\t// a Git repository, an unborn HEAD, a shallow history (Git neither reads nor\n    24\t// writes a commit-graph across a shallow boundary), or a HEAD with no file to\n    25\t// look up.\n    26\tvar errCommitGraphNotApplicable = errors.New(\"not a repository whose last-commit lookups a commit-graph can answer\")\n    27\t\n    28\t// commitGraphState is what doctor knows about a repository's commit-graph.\n    29\ttype commitGraphState struct {\n    30\t\tcommits int\n    31\t\t// filtersUsed is Git's own answer: a last-commit lookup by path read\n    32\t\t// changed-path Bloom filters from the commit-graph it loaded.\n    33\t\tfiltersUsed bool\n    34\t\t// readsDisabledBy names the configuration that keeps Git from reading\n    35\t\t// the filters, when the lookup used none.\n    36\t\treadsDisabledBy string\n    37\t}\n    38\t\n    39\t// readCommitGraphState counts HEAD's history and asks Git whether a\n    40\t// last-commit lookup by path uses changed-path Bloom filters. Git reports the\n    41\t// filters it consulted in its trace2 \"bloom\" statistics, so whichever graph it\n    42\t// loads (the object directory's or an alternate's, a single file or a chain,\n    43\t// of any version it accepts) is judged as Git itself uses it. It only reads,\n    44\t// and never fetches: lazy fetching is off, so a partial clone reports the\n    45\t// objects it lacks instead of contacting its remote.\n    46\tfunc readCommitGraphState(root string) (commitGraphState, error) {\n    47\t\tif _, _, err := commitGraphGit(root, nil, \"rev-parse\", \"--git-dir\"); err != nil {\n    48\t\t\tif strings.Contains(err.Error(), \"not a git repository\") {\n    49\t\t\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n    50\t\t\t}\n    51\t\t\treturn commitGraphState{}, fmt.Errorf(\"repository could not be opened: %w\", err)\n    52\t\t}\n    53\t\t// An unborn HEAD names a branch that does not resolve; a HEAD that\n    54\t\t// resolves to a commit Git cannot read is a failure.\n    55\t\tif _, _, err := commitGraphGit(root, nil, \"rev-parse\", \"--verify\", \"--quiet\", \"HEAD\"); err != nil {\n    56\t\t\tvar exit *exec.ExitError\n    57\t\t\tif errors.As(err, &exit) && exit.ExitCode() == 1 {\n    58\t\t\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n    59\t\t\t}\n    60\t\t\treturn commitGraphState{}, fmt.Errorf(\"HEAD could not be read: %w\", err)\n    61\t\t}\n    62\t\tif _, _, err := commitGraphGit(root, nil, \"rev-parse\", \"--verify\", \"HEAD^{commit}\"); err != nil {\n    63\t\t\treturn commitGraphState{}, fmt.Errorf(\"HEAD could not be read: %w\", err)\n    64\t\t}\n    65\t\tshallow, _, err := commitGraphGit(root, nil, \"rev-parse\", \"--is-shallow-repository\")\n    66\t\tif err != nil {\n    67\t\t\treturn commitGraphState{}, fmt.Errorf(\"repository depth could not be read: %w\", err)\n    68\t\t}\n    69\t\tif strings.TrimSpace(shallow) == \"true\" {\n    70\t\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n    71\t\t}\n    72\t\t// A HEAD without files has nothing to look up, whatever its history\n    73\t\t// (review F22).\n    74\t\tlisting, _, err := commitGraphGit(root, nil, \"ls-tree\", \"-r\", \"--name-only\", \"-z\", \"HEAD\")\n    75\t\tif err != nil {\n    76\t\t\treturn commitGraphState{}, fmt.Errorf(\"files of HEAD could not be listed: %w\", err)\n    77\t\t}\n    78\t\tpath, _, _ := strings.Cut(listing, \"\\x00\")\n    79\t\tif path == \"\" {\n    80\t\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n    81\t\t}\n    82\t\tcount, countStderr, err := commitGraphGit(root, nil, \"rev-list\", \"--count\", \"HEAD\")\n    83\t\tif err != nil {\n    84\t\t\treturn commitGraphState{}, fmt.Errorf(\"history of HEAD could not be counted: %w\", err)\n    85\t\t}\n    86\t\t// Git falls back to a plain walk when its commit-graph cannot be read,\n    87\t\t// and says so on stderr while it succeeds, at any history size (review\n    88\t\t// F21).\n    89\t\tif countStderr != \"\" {\n    90\t\t\treturn commitGraphState{}, fmt.Errorf(\"Git reported a problem while reading history: %s\", countStderr)\n    91\t\t}\n    92\t\tcommits, err := strconv.Atoi(strings.TrimSpace(count))\n    93\t\tif err != nil {\n    94\t\t\treturn commitGraphState{}, fmt.Errorf(\"history of HEAD could not be counted: %w\", err)\n    95\t\t}\n    96\t\tstate := commitGraphState{commits: commits}\n    97\t\tif commits < commitGraphHistoryThreshold {\n    98\t\t\treturn state, nil\n    99\t\t}\n   100\t\ttrace, err := os.CreateTemp(\"\", \"pose-doctor-trace2-*.json\")\n   101\t\tif err != nil {\n   102\t\t\treturn state, fmt.Errorf(\"Git trace could not be created: %w\", err)\n   103\t\t}\n   104\t\ttracePath := trace.Name()\n   105\t\ttrace.Close()\n   106\t\tdefer os.Remove(tracePath)\n   107\t\t// The path is literal: a name with pathspec magic must not change what\n   108\t\t// Git looks up.\n   109\t\t_, stderr, err := commitGraphGit(root, []string{\"GIT_TRACE2_EVENT=\" + tracePath, \"GIT_LITERAL_PATHSPECS=1\"}, \"log\", \"-1\", \"--format=%H\", \"--\", path)\n   110\t\tif err != nil {\n   111\t\t\treturn state, fmt.Errorf(\"last commit of a file could not be read: %w\", err)\n   112\t\t}\n   113\t\t// Git falls back to a plain walk when its commit-graph cannot be read,\n   114\t\t// and says so on stderr while it succeeds.\n   115\t\tif stderr != \"\" {\n   116\t\t\treturn state, fmt.Errorf(\"Git reported a problem while reading history: %s\", stderr)\n   117\t\t}\n   118\t\traw, err := os.ReadFile(tracePath)\n   119\t\tif err != nil {\n   120\t\t\treturn state, fmt.Errorf(\"Git trace could not be read: %w\", err)\n   121\t\t}\n   122\t\tstate.filtersUsed = traceUsedBloomFilters(raw)\n   123\t\tif !state.filtersUsed {\n   124\t\t\tstate.readsDisabledBy = commitGraphReadsDisabledBy(root)\n   125\t\t}\n   126\t\treturn state, nil\n   127\t}\n   128\t\n   129\t// traceUsedBloomFilters reports whether a trace2 event stream carries a\n   130\t// \"bloom\" statistics event in which some filter answered a lookup.\n   131\tfunc traceUsedBloomFilters(raw []byte) bool {\n   132\t\tscanner := bufio.NewScanner(bytes.NewReader(raw))\n   133\t\tscanner.Buffer(make([]byte, 0, 64<<10), 1<<20)\n   134\t\tfor scanner.Scan() {\n   135\t\t\tvar event struct {\n   136\t\t\t\tCategory string `json:\"category\"`\n   137\t\t\t\tKey      string `json:\"key\"`\n   138\t\t\t\tValue    struct {\n   139\t\t\t\t\tMaybe         int `json:\"maybe\"`\n   140\t\t\t\t\tDefinitelyNot int `json:\"definitely_not\"`\n   141\t\t\t\t} `json:\"value\"`\n   142\t\t\t}\n   143\t\t\tif json.Unmarshal(scanner.Bytes(), &event) != nil {\n   144\t\t\t\tcontinue\n   145\t\t\t}\n   146\t\t\tif event.Category == \"bloom\" && event.Key == \"statistics\" && event.Value.Maybe+event.Value.DefinitelyNot > 0 {\n   147\t\t\t\treturn true\n   148\t\t\t}\n   149\t\t}\n   150\t\treturn false\n   151\t}\n   152\t\n   153\t// commitGraphReadsDisabledBy names the configuration that keeps Git from\n   154\t// reading a commit-graph or its changed-path filters, or \"\" when none does:\n   155\t// with it set, writing the graph cannot change the answer. Precedence follows\n   156\t// Git: commitGraph.changedPathsVersion, when set, overrides the deprecated\n   157\t// commitGraph.readChangedPaths.\n   158\tfunc commitGraphReadsDisabledBy(root string) string {\n   159\t\tget := func(kind, key string) (string, bool) {\n   160\t\t\tout, _, err := commitGraphGit(root, nil, \"config\", \"--type=\"+kind, \"--get\", key)\n   161\t\t\tvalue := strings.TrimSpace(out)\n   162\t\t\treturn value, err == nil && value != \"\"\n   163\t\t}\n   164\t\tif value, ok := get(\"bool\", \"core.commitGraph\"); ok && value == \"false\" {\n   165\t\t\treturn \"core.commitGraph=false\"\n   166\t\t}\n   167\t\tif value, ok := get(\"int\", \"commitGraph.changedPathsVersion\"); ok {\n   168\t\t\tif value == \"0\" {\n   169\t\t\t\treturn \"commitGraph.changedPathsVersion=0\"\n   170\t\t\t}\n   171\t\t\treturn \"\"\n   172\t\t}\n   173\t\tif value, ok := get(\"bool\", \"commitGraph.readChangedPaths\"); ok && value == \"false\" {\n   174\t\t\treturn \"commitGraph.readChangedPaths=false\"\n   175\t\t}\n   176\t\treturn \"\"\n   177\t}\n   178\t\n   179\t// commitGraphWriteCommand is the command doctor shows and runs: filters for\n   180\t// every commit, whatever commitGraph.maxNewFilters says.\n   181\tconst commitGraphWriteCommand = \"git commit-graph write --reachable --changed-paths --max-new-filters=-1\"\n   182\t\n   183\t// writeCommitGraph writes the repository's commit-graph with changed-path\n   184\t// Bloom filters for every commit, whatever commitGraph.maxNewFilters says;\n   185\t// it only writes under the Git object directory.\n   186\tfunc writeCommitGraph(root string) error {\n   187\t\t_, _, err := commitGraphGit(root, nil, strings.Fields(strings.TrimPrefix(commitGraphWriteCommand, \"git \"))...)\n   188\t\treturn err\n   189\t}\n   190\t\n   191\t// commitGraphGit runs Git in root, without lazy fetching and in the C\n   192\t// locale, with extra environment; it returns stdout and stderr, and a\n   193\t// failure carries the stderr, bounded.\n   194\tfunc commitGraphGit(root string, env []string, args ...string) (string, string, error) {\n   195\t\tcmd := posemodel.RawHistoryGit(root, args...)\n   196\t\t// Git's messages are read below; they are read in the C locale. A\n   197\t\t// diagnostic never contacts a remote.\n   198\t\tcmd.Env = append(append(cmd.Env, \"LC_ALL=C\", \"LANGUAGE=C\", \"GIT_NO_LAZY_FETCH=1\"), env...)\n   199\t\tvar stderr bytes.Buffer\n   200\t\tcmd.Stderr = &stderr\n   201\t\tout, err := cmd.Output()\n   202\t\tdetail := strings.TrimSpace(stderr.String())\n   203\t\tif len(detail) > 200 {\n   204\t\t\tdetail = detail[:200] + \"…\"\n   205\t\t}\n   206\t\tif err != nil {\n   207\t\t\treturn string(out), detail, &commitGraphGitError{args: args[0], err: err, detail: detail}\n   208\t\t}\n   209\t\treturn string(out), detail, nil\n   210\t}\n   211\t\n   212\t// commitGraphGitError is a failed Git command with its stderr, bounded; it\n   213\t// unwraps to the command's error, an *exec.ExitError when Git ran.\n   214\ttype commitGraphGitError struct {\n   215\t\targs   string\n   216\t\terr    error\n   217\t\tdetail string\n   218\t}\n   219\t\n   220\tfunc (e *commitGraphGitError) Error() string {\n   221\t\tif e.detail == \"\" {\n   222\t\t\treturn \"git \" + e.args + \" \" + e.err.Error()\n   223\t\t}\n   224\t\treturn \"git \" + e.args + \": \" + e.err.Error() + \" \" + e.detail\n   225\t}\n   226\t\n   227\tfunc (e *commitGraphGitError) Unwrap() error { return e.err }\n1a153f0d fix(pose): audit a deadline-bound read under the time it had\na92d28af fix(pose): bound the governed tree listing a closeout runs\nd8525045 fix(pose): bound committed tree listings and describe the scaled cleanup\nac7610d7 fix(doctor): skip shallow and empty trees, never fetch, surface Git warnings\nd1eae6be fix(pose): bound the review worktree cleanup by the committed tree\nc6d15284 fix(pose): scale the Git snapshot budget with the committed tree\n2e30bb53 fix(doctor): tell unborn from broken, probe literally, name disabled reads\n604a6363 fix(pose): keep ledger refusals visible and attribute every producer\n5c1c5658 fix(doctor): ask Git whether it uses the changed-path filters\n1995df71 fix(pose): serve a kept ledger value only while the view is open\n34dd49f6 feat(doctor): recommend and write the Git commit-graph with changed paths\n","exit_code":0,"status":"completed"}}
