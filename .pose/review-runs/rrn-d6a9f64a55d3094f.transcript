{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/internal/cli/hook_runner_test.go; sed -n '280,345p' pose-mcp/internal/cli/review_request.go; sed -n '570,640p' pose-mcp/internal/cli/release_lifecycle.go; sed -n '189,275p' pose-mcp/internal/cli/surface_check.go\"","aggregated_output":"package cli\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// Spec pose-hooks-delegate-to-the-instance-runner.\nfunc hookRunnerRepo(t *testing.T, policy string) (string, string) {\n\tt.Helper()\n\troot := t.TempDir()\n\tartifactGit(t, root, \"init\", \"-q\")\n\tmarker := filepath.Join(t.TempDir(), \"ran\")\n\twriteArtifactTestFile(t, root, \"scripts/hook.sh\", \"#!/bin/sh\\nprintf '%s' \\\"$1\\\" > '\"+marker+\"'\\n[ \\\"$1\\\" = post-merge ] && exit 3\\nexit 0\\n\")\n\tif err := os.Chmod(filepath.Join(root, \"scripts/hook.sh\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif policy != \"\" {\n\t\twriteArtifactTestFile(t, root, \".pose/policy/hooks.json\", policy)\n\t}\n\tt.Chdir(root)\n\treturn root, marker\n}\n\n// R1: a declared runner gets the hook's name and its exit code is the hook's.\nfunc TestAHookDelegatesToTheDeclaredRunner(t *testing.T) {\n\t_, marker := hookRunnerRepo(t, `{\"schema_version\":1,\"runner\":\"scripts/hook.sh\"}`)\n\tvar out, errOut bytes.Buffer\n\tif code := HookMain(\"pre-commit\", &out, &errOut); code != 0 {\n\t\tt.Fatalf(\"pre-commit through the runner: %d %s\", code, errOut.String())\n\t}\n\tif got, _ := os.ReadFile(marker); string(got) != \"pre-commit\" {\n\t\tt.Fatalf(\"the runner was called with %q\", got)\n\t}\n\tif code := HookMain(\"post-merge\", &out, &errOut); code != 3 {\n\t\tt.Fatalf(\"the runner's exit code was not the hook's: %d\", code)\n\t}\n}\n\n// R2: a runner outside the project, not executable or under an unknown\n// schema is refused, and nothing runs.\nfunc TestAnInvalidHookRunnerIsRefused(t *testing.T) {\n\tfor name, policy := range map[string]string{\n\t\t\"outside\":        `{\"schema_version\":1,\"runner\":\"../hook.sh\"}`,\n\t\t\"absolute\":       `{\"schema_version\":1,\"runner\":\"/bin/true\"}`,\n\t\t\"missing\":        `{\"schema_version\":1,\"runner\":\"scripts/absent.sh\"}`,\n\t\t\"unknown schema\": `{\"schema_version\":2,\"runner\":\"scripts/hook.sh\"}`,\n\t\t\"unknown field\":  `{\"schema_version\":1,\"runner\":\"scripts/hook.sh\",\"shell\":true}`,\n\t\t\"trailing bytes\": `{\"schema_version\":1,\"runner\":\"scripts/hook.sh\"} garbage`,\n\t\t\"two objects\":    `{\"schema_version\":1,\"runner\":\"scripts/hook.sh\"}{\"schema_version\":1,\"runner\":\"scripts/hook.sh\"}`,\n\t\t\"not an object\":  `[{\"schema_version\":1,\"runner\":\"scripts/hook.sh\"}]`,\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\t_, marker := hookRunnerRepo(t, policy)\n\t\t\tvar out, errOut bytes.Buffer\n\t\t\tif code := HookMain(\"pre-commit\", &out, &errOut); code != 1 || !strings.Contains(errOut.String(), \"hooks policy\") {\n\t\t\t\tt.Fatalf(\"an invalid runner was not refused: %d %s\", code, errOut.String())\n\t\t\t}\n\t\t\tif _, err := os.Stat(marker); err == nil {\n\t\t\t\tt.Fatal(\"an invalid runner ran\")\n\t\t\t}\n\t\t})\n\t}\n}\n\n// R3: status names the runner a managed hook delegates to.\nfunc TestHookStatusNamesTheRunner(t *testing.T) {\n\troot, _ := hookRunnerRepo(t, `{\"schema_version\":1,\"runner\":\"scripts/hook.sh\"}`)\n\texe, err := os.Executable()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Symlink(exe, filepath.Join(root, \".git\", \"hooks\", \"pre-commit\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar out, errOut bytes.Buffer\n\tif code := cmdHooks(root, []string{\"status\"}, &out, &errOut); code != 0 || !strings.Contains(out.String(), \"delegates to \"+filepath.Join(root, \"scripts/hook.sh\")) {\n\t\tt.Fatalf(\"status: %d %s %s\", code, out.String(), errOut.String())\n\t}\n}\n\t\tcase \"--runner\":\n\t\t\tenv.Runner = value\n\t\tcase \"--idempotency-key\":\n\t\t\tenv.IdempotencyKey = value\n\t\tcase \"--expected-revision\":\n\t\t\tn, err := strconv.Atoi(value)\n\t\t\tif err != nil {\n\t\t\t\treturn usageError(stderr, actionFulfilUsage)\n\t\t\t}\n\t\t\tenv.ExpectedRevision = n\n\t\tcase \"--request-digest\":\n\t\t\tenv.RequestDigest = value\n\t\tcase \"--channel\":\n\t\t\tenv.Channel = value\n\t\tcase \"--envelope\":\n\t\t\tenvelopeFile = value\n\t\tdefault:\n\t\t\treturn usageError(stderr, actionFulfilUsage)\n\t\t}\n\t}\n\tif envelopeFile != \"\" {\n\t\traw, err := os.ReadFile(envelopeFile)\n\t\tif err != nil || posemodel.DecodeStrictJSON(raw, &env) != nil {\n\t\t\treturn usageError(stderr, \"pose action fulfil: the envelope is not a fulfilment envelope\")\n\t\t}\n\t}\n\tstore := posemodel.Store{Root: root}\n\tout := render(stdout, stderr)\n\tif env.RequestID == \"\" || env.RunID == \"\" {\n\t\treturn usageError(stderr, actionFulfilUsage)\n\t}\n\tif env.RequestDigest == \"\" {\n\t\t// The digest the runner read; without it the current one is named,\n\t\t// which a revision check still binds.\n\t\tview, err := store.LoadActionRequest(env.RequestID)\n\t\tif err != nil {\n\t\t\tout.Failure(\"pose action fulfil: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tenv.RequestDigest = view.Request.RequestDigest\n\t}\n\tnow := time.Now()\n\tif !apply {\n\t\t_, event, err := store.PreflightFulfillment(env, now)\n\t\tif err != nil {\n\t\t\tout.Failure(\"pose action fulfil: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tif jsonOutput {\n\t\t\treturn writeJSON(stdout, event)\n\t\t}\n\t\tout.Field(\"action.fulfil.preview\", \"true\")\n\t\tout.Field(\"action.fulfil.run\", event.Fulfillment.RunID)\n\t\tout.Field(\"action.fulfil.decision\", event.Fulfillment.Decision)\n\t\tout.Field(\"action.fulfil.recorded\", event.Fulfillment.Recorded)\n\t\tout.Field(\"action.fulfil.apply\", \"false (rerun with --apply to record it)\")\n\t\treturn 0\n\t}\n\tview, err := store.FulfilActionRequest(env, now)\n\tif err != nil {\n\t\tout.Failure(\"pose action fulfil: \" + err.Error())\n\t\treturn 1\n\t}\n\tif jsonOutput {\n\t\treturn writeJSON(stdout, view)\n\t}\n\tif err := rejectReleaseArgs(args, map[string]bool{\"--version\": true, \"--event\": true, \"--evidence\": true}, nil); err != nil {\n\t\treturn usageError(stderr, err.Error())\n\t}\n\ttarget, ok, _ := releaseArg(args, \"--version\")\n\tif !ok {\n\t\treturn usageError(stderr, \"pose release record: --version required\")\n\t}\n\tstate, ok, _ := releaseArg(args, \"--event\")\n\tif !ok || !map[string]bool{\"tagged\": true, \"published\": true, \"verified\": true, \"failed\": true, \"yanked\": true}[state] {\n\t\treturn usageError(stderr, \"pose release record: legal --event required\")\n\t}\n\tevidencePath, ok, _ := releaseArg(args, \"--evidence\")\n\tif !ok {\n\t\treturn usageError(stderr, \"pose release record: --evidence required\")\n\t}\n\tfull, err := confinedProjectPath(root, evidencePath)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, \"pose release record: evidence path must remain inside project\")\n\t\treturn 2\n\t}\n\traw, err := os.ReadFile(full)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tvar evidence posemodel.ReleaseEvidence\n\tif err := posemodel.DecodeStrictJSON(raw, &evidence); err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tif err := validateReleaseEvidence(state, target, evidence); err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tif commit, tagged := resolveReleaseTag(root, target); (state == \"tagged\" || state == \"published\" || state == \"verified\") && (!tagged || commit != evidence.Commit) {\n\t\tfmt.Fprintln(stderr, \"evidence commit does not match the immutable Git tag\")\n\t\treturn 1\n\t}\n\tmanifest, err := posemodel.LoadReleaseManifest(root, target)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, \"prepared manifest required\")\n\t\treturn 1\n\t}\n\tif state == \"tagged\" || state == \"published\" || state == \"verified\" {\n\t\t// The event states that the tag is the release: the tag's own tree must hold an intact\n\t\t// snapshot, and the working tree's copy must be that same cut.\n\t\tif gaps, _ := releaseTagState(root, target); len(gaps) > 0 {\n\t\t\trender(io.Discard, stderr).Failure(\"the tag does not hold an intact release snapshot: \" + strings.Join(gaps, \"; \"))\n\t\t\treturn 1\n\t\t}\n\t\tif gaps := taggedReleaseWorktreeGaps(root, target, manifest); len(gaps) > 0 {\n\t\t\trender(io.Discard, stderr).Failure(\"the working tree is not the cut the tag holds: \" + strings.Join(gaps, \"; \"))\n\t\t\treturn 1\n\t\t}\n\t}\n\tevents, err := posemodel.LoadReleaseEvents(root, target)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tcandidate := posemodel.NewReleaseEvent(target, state, evidence, time.Now())\n\tfor _, event := range events {\n\t\tif event.State == state && event.EvidenceDigest == candidate.EvidenceDigest {\n\t\t\tfmt.Fprintln(stdout, \"Release event already recorded (idempotent).\")\n\t\t\treturn 0\n\t\t}\n\t\tif event.State == state && event.EvidenceDigest != candidate.EvidenceDigest {\n\t\t\tfmt.Fprintln(stderr, \"conflicting event evidence\")\n\t\t\treturn 1\n\t\t}\n\t}\nfunc cmdSurfaceCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar spec, resultsPath string\n\tstrict, jsonOutput := true, false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--spec\", \"--results\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\n\t\t\t}\n\t\t\ti++\n\t\t\tif args[i-1] == \"--spec\" {\n\t\t\t\tspec = args[i]\n\t\t\t} else {\n\t\t\t\tresultsPath = args[i]\n\t\t\t}\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\n\t\t}\n\t}\n\tif spec != \"\" && posemodel.ValidateSlug(spec) != nil {\n\t\tfmt.Fprintln(stderr, \"pose surface-check: invalid spec slug\")\n\t\treturn 2\n\t}\n\tpolicy, err := posemodel.LoadDeliveryPolicy(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif resultsPath != \"\" {\n\t\tif !confinedRelativePath(resultsPath) {\n\t\t\tfmt.Fprintln(stderr, \"pose surface-check: results path escapes project\")\n\t\t\treturn 2\n\t\t}\n\t\tpolicy.ResultsPath = filepath.ToSlash(filepath.Clean(resultsPath))\n\t}\n\tbaseSpecs, claims, sets, tracked, artifactPolicy, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tbase := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), baseSpecs, claims, sets, tracked, artifactPolicy, posemodel.LoadArchivedFragments(root), artifactRemovals(root, claims, sets, tracked, gaps))\n\tprofiles, err := loadDeliveryProfiles(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tfullSpecs, targets, err := collectDeliveryTargets(root, baseSpecs, profiles)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tresults, err := loadDeliveryValidationResults(root, policy.ResultsPath)\n\tresults = withSmokeResults(root, results)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tgraph := posemodel.BuildDeliverySurface(base, fullSpecs, targets, results, nil, profiles, policy)\n\tif spec != \"\" {\n\t\tgraph = focusSurfaceGraph(graph, spec)\n\t}\n\tif jsonOutput {\n\t\t_ = writeJSON(stdout, graph)\n\t} else {\n\t\tfmt.Fprintf(stdout, \"surface.spec=%s\\nsurface.targets=%d\\nsurface.results=%d\\nsurface.findings=%d\\nsurface.provenance_digest=%s\\n\", spec, len(graph.Deliveries), len(graph.ValidationResults), len(graph.Findings), graph.ProvenanceDigest)\n\t\tfor _, finding := range graph.Findings {\n\t\t\trender(stdout, stderr).Finding(cliout.Finding{\n\t\t\t\tState: cliout.StateFromKey(finding.Severity), Code: finding.Code, Path: finding.Path,\n\t\t\t\tMessage: finding.Message, Remediation: finding.Remediation,\n\t\t\t})\n\t\t}\n\t}\n\treturn deliveryFindingExit(graph.Findings, strict)\n}\n\nfunc cmdRoadmapCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tif len(args) == 0 {\n\t\treturn usageError(stderr, \"Usage: pose roadmap-check <slug> [--strict|--tolerant] [--json]\")\n\t}\n\tslug := args[0]\n\tstrict, jsonOutput := true, false\n","exit_code":0,"status":"completed"}}
