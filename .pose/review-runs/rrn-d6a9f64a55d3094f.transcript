eVersion(manifest.Version); err != nil {\n\t\tadd(\"version\", err.Error())\n\t} else if version != \"\" && manifest.Version != version {\n\t\tadd(\"version\", fmt.Sprintf(\"%q is not the release of this directory (%q)\", manifest.Version, version))\n\t}\n\tif manifest.PreviousVersion != \"\" {\n\t\tif err := ValidateReleaseVersion(manifest.PreviousVersion); err != nil {\n\t\t\tadd(\"previous_version\", err.Error())\n\t\t} else if manifest.PreviousVersion == manifest.Version {\n\t\t\tadd(\"previous_version\", \"equals the release itself\")\n\t\t} else if ValidateReleaseVersion(manifest.Version) == nil && CompareReleasePrecedence(manifest.PreviousVersion, manifest.Version) >= 0 {\n\t\tevents = append(events, event)\n\t\toffset += end + 1\n\t}\n\treturn events, nil\n}\n\n// decodeActionEvent decodes exactly one JSON object from a line.\nfunc decodeActionEvent(text []byte) (ActionEvent, error) {\n\tvar event ActionEvent\n\tif len(bytes.TrimSpace(text)) == 0 {\n\t\treturn event, fmt.Errorf(\"empty line\")\n\t}\n\t// Escaped control characters are valid text in an answer or a reason;\n\t// a duplicate field is not, because only one of its values would count.\n\tif err := rejectDuplicateJSONKeys(text, false, true); err != nil {\n\t\treturn event, err\n\t}\n\tdecoder := json.NewDecoder(bytes.NewReader(text))\n\tdecoder.DisallowUnknownFields()\n\tif err := decoder.Decode(&event); err != nil {\n\t\treturn event, err\n\t}\n\tvar extra any\n\tif err := decoder.Decode(&extra); err != io.EOF {\n\t\treturn event, fmt.Errorf(\"content after the event on the same line\")\n\t}\n\treturn event, nil\n}\n\n// ActionJournalNextAction is the supported next step for a journal that does\n// not read. Nothing is repaired by the engine: a person restores the journal\n// from version control or, for an interrupted tail, reviews the proposal.\nfunc ActionJournalNextAction(e *ActionJournalError) string {\n\twhere := \"the journal\"\n\tif e.Path != \"\" {\n\t\twhere = e.Path\n\tpath := sourceRedirectPath(store.Root, identity.Slug)\n\tredirectRel, _ := filepath.Rel(store.Root, path)\n\tif err := transferPathClean(files, store.Root, filepath.ToSlash(redirectRel)); err != nil {\n\t\treturn specTransferRedirect{}, false, specTransferError(\"invalid-spec-redirect\")\n\t}\n\tinfo, err := files.Lstat(path)\n\tif os.IsNotExist(err) {\n\t\treturn specTransferRedirect{}, false, nil\n\t}\n\tif err != nil || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(files, store.Root, path) {\n\t\treturn specTransferRedirect{}, false, specTransferError(\"invalid-spec-redirect\")\n\t}\n\tif info.Size() > 64<<10 {\n\t\treturn specTransferRedirect{}, false, specTransferError(\"redirect-too-large\")\n\t}\n\traw, err := files.ReadFile(path)\n\tif err != nil {\n\t\treturn specTransferRedirect{}, false, err\n\t}\n\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n\tdecoder.DisallowUnknownFields()\n\tvar redirect specTransferRedirect\n\tif err := decoder.Decode(&redirect); err != nil {\n\t\treturn redirect, false, err\n\t}\n\tif err := decoder.Decode(new(any)); err != io.EOF {\n\t\treturn redirect, false, specTransferError(\"invalid-spec-redirect\")\n\t}\n\texpectedRedirect := SpecTransferSchemaVersion\n\tif redirect.Mode == SpecTransferModeReconcileTerminal {\n\t\texpectedRedirect = SpecReconcileSchemaVersion\n\t} else if redirect.Mode != \"\" || len(redirect.OpenObligations) != 0 {\n\t\treturn redirect, false, specTransferError(\"invalid-spec-redirect\")\n\t}\n\tif redirect.SchemaVersion != expectedRedirect || !specTransferIDRE.MatchString(redirect.OperationID) || redirect.Source != identity || validateTransferIdentity(redirect.Destination) != nil || redirect.Destination.Project == identity.Project {\n\t\treturn redirect, false, specTransferError(\"invalid-spec-redirect\")\n\t}\n\tif err := requireSpecTransferCapability(files, store); err != nil {\n\t\treturn redirect, false, err\n\t}\n\tplanRel := filepath.ToSlash(filepath.Join(\".pose\", \"transfers\", redirect.OperationID, \"plan.json\"))\n\tif err := transferPathClean(files, store.Root, planRel); err != nil {\n\t\treturn redirect, false, specTransferError(\"invalid-spec-redirect\")\n\t}\n\tplan, err := readSpecTransferPlan(files, transferPlanFile(store.Root, redirect.OperationID))\n\tif err != nil || validateTransferPlan(plan) != nil || plan.Source != redirect.Source || plan.Destination != redirect.Destination || plan.Request.Mode != redirect.Mode || !bytes.Equal(planRedirectBytes(plan, redirect.OperationID), CanonicalJSON(redirect)) {\n\t\treturn redirect, false, specTransferError(\"invalid-spec-redirect\")\n\t}\n\tstatus, err := ReadSpecTransferStatusIn(files, store, redirect.OperationID, identity.Project)\n\tif err != nil || status.Phase != \"activated\" {\n\t\treturn redirect, false, specTransferError(\"invalid-spec-redirect\")\n\t}\n\treturn redirect, true, nil\n}\n\nfunc readSpecTransferPlan(files Files, path string) (SpecTransferPlan, error) {\n\tvar plan SpecTransferPlan\n\tinfo, err := files.Lstat(path)\n\tif err != nil || info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || info.Size() > 2<<20 {\n\t\treturn plan, specTransferError(\"invalid-plan\")\n\t}\n\traw, err := files.ReadFile(path)\n\tif err != nil {\n\t\treturn plan, err\n\t}\n\tif len(raw) > 2<<20 {\n\t\treturn plan, specTransferError(\"plan-too-large\")\n\t}\n\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n\tdecoder.DisallowUnknownFields()\n\tif err := decoder.Decode(&plan); err != nil {\n\t\treturn plan, specTransferError(\"invalid-plan\")\n\t}\n\tif err := decoder.Decode(new(any)); err != io.EOF {\n\t\treturn plan, specTransferError(\"invalid-plan\")\n\t}\n\tif plan.SchemaVersion != expectedTransferPlanSchema(plan) || !specTransferIDRE.MatchString(plan.OperationID) || plan.OperationID != transferOperationID(plan) || plan.Digest == \"\" || plan.Digest != specTransferPlanDigest(plan) {\n\t\treturn plan, specTransferError(\"plan-digest-mismatch\")\n\t}\n\treturn plan, nil\n}\n\nfunc writeTransferJSONExclusive(path string, value any) error {\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\tif info, err := os.Lstat(path); err == nil && info.Mode()&os.ModeSymlink != 0 {\n\t\treturn specTransferError(\"path-escape\")\n\t}\n\traw := CanonicalJSON(value)\n\tf, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o644)\n\tif err != nil {\n\t\tif os.IsExist(err) {\n\t\t\tprevious, readErr := os.ReadFile(path)\n\t\t\tif readErr == nil && bytes.Equal(previous, raw) {\n\t\t\t\treturn nil\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n)\n\n// ParseActionEffect accepts the legacy phase:mode spelling or an additive\n// structured effect. Both transports use this parser and PrepareActionRequest\n// qualifies and validates its material references.\nfunc ParseActionEffect(raw json.RawMessage) (ObligationEffect, error) {\n\tvar legacy string\n\tif json.Unmarshal(raw, &legacy) == nil {\n\t\tphase, mode, ok := strings.Cut(legacy, \":\")\n\t\tif !ok || !obligationPhases[phase] || !obligationModes[mode] {\n\t\t\treturn ObligationEffect{}, fmt.Errorf(\"effect must be <phase>:<block|advisory>\")\n\t\t}\n\t\treturn ObligationEffect{Phase: phase, Mode: mode}, nil\n\t}\n\tvar input struct {\n\t\tPhase string   `json:\"phase\"`\n\t\tMode  string   `json:\"mode\"`\n\t\tScope []string `json:\"scope\"`\n\t}\n\tdec := json.NewDecoder(bytes.NewReader(raw))\n\tdec.DisallowUnknownFields()\n\tif err := dec.Decode(&input); err != nil {\n\t\treturn ObligationEffect{}, fmt.Errorf(\"invalid structured effect: %w\", err)\n\t}\n\tif err := dec.Decode(new(any)); err != io.EOF {\n\t\treturn ObligationEffect{}, fmt.Errorf(\"structured effect must be one JSON object\")\n\t}\n\tif !obligationPhases[input.Phase] || !obligationModes[input.Mode] {\n\t\treturn ObligationEffect{}, fmt.Errorf(\"unknown effect phase or mode\")\n\t}\n\tout := ObligationEffect{Phase: input.Phase, Mode: input.Mode}\n\tfor _, raw := range input.Scope {\n\t\tn, err := ParseActionTarget(raw)\n\t\tif err != nil {\n\t\t\treturn ObligationEffect{}, err\n\t\t}\n\t\tout.Scope = append(out.Scope, n)\n\t}\n\treturn out, nil\n}\n\n// actionMaterial resolves exactly the named artifact/node. Foreign reads must\n// pass the caller's existing resolver authorization; no origin fallback exists.\nfunc (s Store) actionMaterial(project string, node NodeRef) (Store, ArtifactRef, string, error) {\n\tref, err := ParseArtifactRef(node.Artifact)\n\tif err != nil {\n\t\treturn Store{}, ref, \"\", err\n\t}\n\tsource := s\n\tif ref.Project != project {\n\t\tvar resolver ArtifactResolver\n\t\tif s.FederatedResolver != nil {\n\tprojected, err := json.Marshal(fields)\n\tif err != nil {\n\t\treturn err.Error()\n\t}\n\tif _, err := s.parseReviewProfile(profile.Ref(), projected); err != nil {\n\t\treturn err.Error()\n\t}\n\treturn \"\"\n}\n\n// parseReviewProfile validates profile bytes whatever their source. Rule and\n// evidence-class refs are still checked against the current tree, because a\n// baseline criterion whose rule no longer exists is a gap now, not then.\nfunc (s Store) parseReviewProfile(ref string, raw []byte) (ReviewProfile, error) {\n\tvar p ReviewProfile\n\tif err := json.Unmarshal(raw, &p); err != nil {\n\t\treturn ReviewProfile{}, fmt.Errorf(\"pose: invalid review profile %q: %w\", ref, err)\n\t}\n\tif p.SchemaVersion == ReviewPolicySchemaVersion {\n\t\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n\t\tdecoder.DisallowUnknownFields()\n\t\tif err := decoder.Decode(&p); err != nil {\n\t\t\treturn ReviewProfile{}, fmt.Errorf(\"pose: invalid schema-v2 review profile %q: %w\", ref, err)\n\t\t}\n\t}\n\tif (p.SchemaVersion != ReviewSchemaVersion && p.SchemaVersion != ReviewPolicySchemaVersion) || p.Ref() != ref || p.Scope == \"\" || len(p.Criteria) == 0 {\n\t\treturn ReviewProfile{}, fmt.Errorf(\"pose: malformed review profile %q\", ref)\n\t}\n\tseen := map[string]bool{}\n\tfor _, c := range p.Criteria {\n\t\tif !slugPattern.MatchString(c.ID) || seen[c.ID] {\n\t\t\treturn ReviewProfile{}, fmt.Errorf(\"pose: invalid or duplicate criterion %q in %s\", c.ID, ref)\n\t\t}\n\t\t// Closed rule/evidence catalogs are a schema-v2 contract. Schema-v1\n\t\t// profiles keep their historical namespaces so repositories that never\n\t\t// opted into component-aware planning remain readable (spec R29).\n\t\tif p.SchemaVersion == ReviewPolicySchemaVersion {\n\t\t\tif err := s.validateReviewContractRefs(ref, c.Rules, c.EvidenceClasses); err != nil {\n\t\t\t\treturn ReviewProfile{}, err\n\t\t\t}\n\t\t}\n\t\tswitch c.Kind {\n\t\tcase \"\", ReviewCriterionKindJudgment:\n\t\tcase ReviewCriterionKindMechanical:\n\t\t\t// A profile may declare a criterion judgment even though a producer\n\t\t\t// exists — asking a reviewer to look at something a check also\n\t\t\t// covers is always allowed. The reverse is not: declaring\n\t\t\t// `mechanical` with no evidence class would re-open the hole the\n\t\t\t// derivation closes, because nothing could ever answer it and the\n\t\t\t// engine would accept any sealed result as if something had.\n\t\t\tif len(c.EvidenceClasses) == 0 {\n\t\t}\n\t\tpending := pose.UnacknowledgedNodeChanges(spec.Slug, spec.Body, events, adopted)\n\t\tif events == nil {\n\t\t\tevents = []pose.Amendment{}\n\t\t}\n\t\tif pending == nil {\n\t\t\tpending = []string{}\n\t\t}\n\t\treturn map[string]any{\"slug\": spec.Slug, \"status\": spec.Status, \"events\": events, \"unacknowledged\": pending,\n\t\t\t\"contract_nodes\": pose.ProjectContractNodes(spec.Slug, spec.Body), \"capability_adopted\": adopted}, nil\n\tcase \"pose_list_specs\":\n\t\t// Arguments are decoded strictly and every value is validated before\n\t\t// the listing, as the CLI does: an unknown argument, an explicit zero\n\t\t// or an empty since would otherwise widen the result (spec\n\t\t// pose-cli-mcp-operation-results R3/R7).\n\t\tvar a struct {\n\t\t\tStatus     string  `json:\"status\"`\n\t\t\tComponents string  `json:\"components\"`\n\t\t\tCursor     string  `json:\"cursor\"`\n\t\t\tLimit      *int    `json:\"limit\"`\n\t\t\tRecent     *int    `json:\"recent\"`\n\t\t\tSort       string  `json:\"sort\"`\n\t\t\tSince      *string `json:\"since\"`\n\t\t\tProjectID  string  `json:\"project_id\"`\n\t\t}\n\t\tdecoder := json.NewDecoder(bytes.NewReader(args))\n\t\tdecoder.DisallowUnknownFields()\n\t\tif err := decoder.Decode(&a); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"pose_list_specs: invalid arguments: %v\", err)\n\t\t}\n\t\tif err := requirePositiveLimit(\"pose_list_specs\", args); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\t// An explicit null is a value, not an omission: decoding would turn\n\t\t// it into \"no filter\" and widen the listing.\n\t\tvar present map[string]json.RawMessage\n\t\t_ = json.Unmarshal(args, &present)\n\t\tfor key, raw := range present {\n\t\t\tif key != \"project_id\" && strings.TrimSpace(string(raw)) == \"null\" {\n\t\t\t\treturn nil, fmt.Errorf(\"pose_list_specs: %s must not be null; omit it instead\", key)\n\t\t\t}\n\t\t}\n\t\tif _, given := present[\"sort\"]; given && a.Sort != \"date\" && a.Sort != \"slug\" {\n\t\t\treturn nil, fmt.Errorf(\"pose_list_specs: sort must be \\\"date\\\" or \\\"slug\\\"\")\n\t\t}\n\t\tvar sinceDate time.Time\n","exit_code":0,"status":"completed"}}
