{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 6ea5394b3788f84b67a51fab99f5ed45719b77ed..36d3ab90c0dcb3ecba3507ecb5487d09d5eb5cb5 -- pose-mcp .pose/indexes/validation-matrix.json'","aggregated_output":"diff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex 620109dc..34c00ddd 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2391,6 +2391,13 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"strict-json-readers-require-the-end-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"./internal/cli\", \"-run\", \"TestDecodeStrictJSON|TestStrictJSONReadersRequireTheEnd|TestStrictJSONReaderEndsJudgesTheCheckNotItsShape|TestReviewRequestIsFulfilledOverTheCLI|TestF05RecordRefusesATagWhoseTreeIsNotIntact|TestAnInvalidHookRunnerIsRefused\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"adopt-request-shows-what-it-sets-integration\",\n           \"program\": \"go\",\ndiff --git a/pose-mcp/internal/cli/delegated_review_request_test.go b/pose-mcp/internal/cli/delegated_review_request_test.go\nindex a83d4feb..25155f07 100644\n--- a/pose-mcp/internal/cli/delegated_review_request_test.go\n+++ b/pose-mcp/internal/cli/delegated_review_request_test.go\n@@ -44,6 +44,17 @@ func TestReviewRequestIsFulfilledOverTheCLI(t *testing.T) {\n \tif err := os.WriteFile(path, raw, 0o600); err != nil {\n \t\tt.Fatal(err)\n \t}\n+\t// Spec pose-strict-json-readers-require-the-end: an envelope followed by\n+\t// anything is not an envelope.\n+\tfor name, tail := range map[string]string{\"garbage\": \" garbage\", \"second value\": string(raw)} {\n+\t\ttrailing := filepath.Join(t.TempDir(), \"envelope.json\")\n+\t\tif err := os.WriteFile(trailing, append(append([]byte{}, raw...), tail...), 0o600); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif code, out := runPose(t, root, \"action\", \"fulfil\", \"--envelope\", trailing); code == 0 || !strings.Contains(out, \"not a fulfilment envelope\") {\n+\t\t\tt.Fatalf(\"an envelope followed by %s was read: %d %s\", name, code, out)\n+\t\t}\n+\t}\n \tif code, out := runPose(t, root, \"action\", \"fulfil\", \"--envelope\", path); code != 0 || !strings.Contains(out, \"action.fulfil.decision=approved\") {\n \t\tt.Fatalf(\"preview: %d %s\", code, out)\n \t}\ndiff --git a/pose-mcp/internal/cli/maintenance.go b/pose-mcp/internal/cli/maintenance.go\nindex 44857885..ce043a1a 100644\n--- a/pose-mcp/internal/cli/maintenance.go\n+++ b/pose-mcp/internal/cli/maintenance.go\n@@ -3,7 +3,6 @@ package cli\n import (\n \t\"archive/tar\"\n \t\"archive/zip\"\n-\t\"bytes\"\n \t\"compress/gzip\"\n \t\"encoding/json\"\n \t\"fmt\"\n@@ -1097,16 +1096,9 @@ func hookRunner(root string) (string, bool, error) {\n \t\tSchemaVersion int    `json:\"schema_version\"`\n \t\tRunner        string `json:\"runner\"`\n \t}\n-\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n-\tdecoder.DisallowUnknownFields()\n-\tif err := decoder.Decode(&policy); err != nil {\n+\tif err := posemodel.DecodeStrictJSON(raw, &policy); err != nil {\n \t\treturn \"\", false, fmt.Errorf(\".pose/policy/hooks.json: %v\", err)\n \t}\n-\t// One object and nothing after it: trailing bytes or a second value\n-\t// make the policy malformed, not ignored (review round 1, F1).\n-\tif _, err := decoder.Token(); !errors.Is(err, io.EOF) {\n-\t\treturn \"\", false, fmt.Errorf(\".pose/policy/hooks.json: content after the policy object\")\n-\t}\n \tif policy.SchemaVersion != 1 {\n \t\treturn \"\", false, fmt.Errorf(\".pose/policy/hooks.json: schema_version %d, want 1\", policy.SchemaVersion)\n \t}\ndiff --git a/pose-mcp/internal/cli/release_lifecycle.go b/pose-mcp/internal/cli/release_lifecycle.go\nindex c2f4aca6..00fb396d 100644\n--- a/pose-mcp/internal/cli/release_lifecycle.go\n+++ b/pose-mcp/internal/cli/release_lifecycle.go\n@@ -1,7 +1,6 @@\n package cli\n \n import (\n-\t\"bytes\"\n \t\"encoding/json\"\n \t\"errors\"\n \t\"fmt\"\n@@ -594,9 +593,7 @@ func cmdReleaseRecord(root string, args []string, stdout, stderr io.Writer) int\n \t\treturn 1\n \t}\n \tvar evidence posemodel.ReleaseEvidence\n-\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n-\tdecoder.DisallowUnknownFields()\n-\tif err := decoder.Decode(&evidence); err != nil {\n+\tif err := posemodel.DecodeStrictJSON(raw, &evidence); err != nil {\n \t\tfmt.Fprintln(stderr, err)\n \t\treturn 1\n \t}\ndiff --git a/pose-mcp/internal/cli/release_review_regression_test.go b/pose-mcp/internal/cli/release_review_regression_test.go\nindex 57b29bfd..ed69865d 100644\n--- a/pose-mcp/internal/cli/release_review_regression_test.go\n+++ b/pose-mcp/internal/cli/release_review_regression_test.go\n@@ -79,7 +79,19 @@ func TestF05RecordRefusesATagWhoseTreeIsNotIntact(t *testing.T) {\n \tgood := cliReleaseRepo(t)\n \trelGitCLI(t, good, \"tag\", \"v1.0.0\")\n \tgoodHead := strings.TrimSpace(gitOut(t, good, \"rev-parse\", \"HEAD\"))\n-\twriteCloseoutCLIFile(t, good, \"evidence.json\", `{\"schema_version\":1,\"provider\":\"github\",\"repository\":\"o/r\",\"version\":\"v1.0.0\",\"tag\":\"v1.0.0\",\"commit\":\"`+goodHead+`\"}`)\n+\tgoodEvidence := `{\"schema_version\":1,\"provider\":\"github\",\"repository\":\"o/r\",\"version\":\"v1.0.0\",\"tag\":\"v1.0.0\",\"commit\":\"` + goodHead + `\"}`\n+\t// Spec pose-strict-json-readers-require-the-end: evidence followed by\n+\t// anything is refused, and nothing is recorded.\n+\tfor name, tail := range map[string]string{\"garbage\": \" garbage\", \"second value\": goodEvidence} {\n+\t\twriteCloseoutCLIFile(t, good, \"evidence.json\", goodEvidence+tail)\n+\t\tif code, out := runPose(t, good, \"release\", \"record\", \"--version\", \"v1.0.0\", \"--event\", \"tagged\", \"--evidence\", \"evidence.json\"); code == 0 {\n+\t\t\tt.Fatalf(\"evidence followed by %s was recorded: %s\", name, out)\n+\t\t}\n+\t\tif _, err := os.Stat(good + \"/.pose/releases/v1.0.0/events.jsonl\"); err == nil {\n+\t\t\tt.Fatalf(\"evidence followed by %s wrote an event\", name)\n+\t\t}\n+\t}\n+\twriteCloseoutCLIFile(t, good, \"evidence.json\", goodEvidence)\n \tif code, out := runPose(t, good, \"release\", \"record\", \"--version\", \"v1.0.0\", \"--event\", \"tagged\", \"--evidence\", \"evidence.json\"); code != 0 {\n \t\tt.Fatalf(\"the control record was refused: %s\", out)\n \t}\ndiff --git a/pose-mcp/internal/cli/review_request.go b/pose-mcp/internal/cli/review_request.go\nindex faf75d18..dee014ab 100644\n--- a/pose-mcp/internal/cli/review_request.go\n+++ b/pose-mcp/internal/cli/review_request.go\n@@ -1,7 +1,6 @@\n package cli\n \n import (\n-\t\"bytes\"\n \t\"encoding/json\"\n \t\"fmt\"\n \t\"io\"\n@@ -300,9 +299,7 @@ func cmdActionFulfil(root string, args []string, stdout, stderr io.Writer) int {\n \t}\n \tif envelopeFile != \"\" {\n \t\traw, err := os.ReadFile(envelopeFile)\n-\t\tdec := json.NewDecoder(bytes.NewReader(raw))\n-\t\tdec.DisallowUnknownFields()\n-\t\tif err != nil || dec.Decode(&env) != nil {\n+\t\tif err != nil || posemodel.DecodeStrictJSON(raw, &env) != nil {\n \t\t\treturn usageError(stderr, \"pose action fulfil: the envelope is not a fulfilment envelope\")\n \t\t}\n \t}\ndiff --git a/pose-mcp/internal/pose/strict_json.go b/pose-mcp/internal/pose/strict_json.go\nnew file mode 100644\nindex 00000000..d741fe90\n--- /dev/null\n+++ b/pose-mcp/internal/pose/strict_json.go\n@@ -0,0 +1,25 @@\n+package pose\n+\n+import (\n+\t\"bytes\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"io\"\n+)\n+\n+// DecodeStrictJSON decodes exactly one JSON value from raw into v: an\n+// unknown field is refused, and so is anything after the value but white\n+// space, so a valid object followed by garbage or by a second value is\n+// malformed, not read as its first part (spec\n+// pose-strict-json-readers-require-the-end).\n+func DecodeStrictJSON(raw []byte, v any) error {\n+\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n+\tdecoder.DisallowUnknownFields()\n+\tif err := decoder.Decode(v); err != nil {\n+\t\treturn err\n+\t}\n+\tif _, err := decoder.Token(); !errors.Is(err, io.EOF) {\n+\t\treturn errors.New(\"content after the JSON value\")\n+\t}\n+\treturn nil\n+}\ndiff --git a/pose-mcp/internal/pose/strict_json_test.go b/pose-mcp/internal/pose/strict_json_test.go\nnew file mode 100644\nindex 00000000..ca2678aa\n--- /dev/null\n+++ b/pose-mcp/internal/pose/strict_json_test.go\n@@ -0,0 +1,170 @@\n+package pose\n+\n+import (\n+\t\"go/ast\"\n+\t\"go/parser\"\n+\t\"go/token\"\n+\t\"io/fs\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-strict-json-readers-require-the-end, R1: one value and nothing\n+// after it.\n+func TestDecodeStrictJSONReadsOneValueAndNothingElse(t *testing.T) {\n+\ttype policy struct {\n+\t\tName string `json:\"name\"`\n+\t}\n+\tfor name, raw := range map[string]string{\n+\t\t\"object\":             `{\"name\":\"a\"}`,\n+\t\t\"surrounding spaces\": \" \\n{\\\"name\\\":\\\"a\\\"}\\n\\t \",\n+\t} {\n+\t\tvar p policy\n+\t\tif err := DecodeStrictJSON([]byte(raw), &p); err != nil || p.Name != \"a\" {\n+\t\t\tt.Fatalf(\"%s: %v %+v\", name, err, p)\n+\t\t}\n+\t}\n+\tfor name, raw := range map[string]string{\n+\t\t\"garbage after\":  `{\"name\":\"a\"} garbage`,\n+\t\t\"second object\":  `{\"name\":\"a\"}{\"name\":\"b\"}`,\n+\t\t\"second value\":   `{\"name\":\"a\"} 1`,\n+\t\t\"unknown field\":  `{\"name\":\"a\",\"shell\":true}`,\n+\t\t\"empty\":          ``,\n+\t\t\"truncated\":      `{\"name\":\"a\"`,\n+\t\t\"closing excess\": `{\"name\":\"a\"}}`,\n+\t} {\n+\t\tvar p policy\n+\t\tif err := DecodeStrictJSON([]byte(raw), &p); err == nil {\n+\t\t\tt.Fatalf(\"%s was read: %+v\", name, p)\n+\t\t}\n+\t}\n+}\n+\n+// strictJSONWithoutTheEnd names the functions that refuse unknown fields\n+// without requiring the end of the input, with the reason it holds there.\n+var strictJSONWithoutTheEnd = map[string]string{\n+\t\"internal/mcpserver/server.go#dispatch\": \"tool arguments are one value the JSON-RPC transport already parsed\",\n+}\n+\n+// Spec pose-strict-json-readers-require-the-end, R2: a function of the\n+// engine that refuses unknown fields also refuses content after the value,\n+// or names here why it need not.\n+func TestStrictJSONReadersRequireTheEnd(t *testing.T) {\n+\tbase := filepath.Join(\"..\", \"..\")\n+\tseen := map[string]bool{}\n+\terr := filepath.WalkDir(filepath.Join(base, \"internal\"), func(path string, d fs.DirEntry, err error) error {\n+\t\tif err != nil || d.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n+\t\t\treturn err\n+\t\t}\n+\t\tfset := token.NewFileSet()\n+\t\tfile, err := parser.ParseFile(fset, path, nil, 0)\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\trel, _ := filepath.Rel(base, path)\n+\t\trel = filepath.ToSlash(rel)\n+\t\tfor _, decl := range file.Decls {\n+\t\t\tfn, ok := decl.(*ast.FuncDecl)\n+\t\t\tif !ok || fn.Body == nil {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tstrict, ends := strictJSONReaderEnds(fn)\n+\t\t\tif !strict {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tsite := rel + \"#\" + fn.Name.Name\n+\t\t\tseen[site] = true\n+\t\t\tif !ends && strictJSONWithoutTheEnd[site] == \"\" {\n+\t\t\t\tt.Errorf(\"%s refuses unknown fields but reads past the value: use DecodeStrictJSON, or name here why the end need not be required\", site)\n+\t\t\t}\n+\t\t}\n+\t\treturn nil\n+\t})\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor site := range strictJSONWithoutTheEnd {\n+\t\tif !seen[site] {\n+\t\t\tt.Errorf(\"%s is listed but no longer refuses unknown fields\", site)\n+\t\t}\n+\t}\n+}\n+\n+// strictJSONReaderEnds reports whether fn refuses unknown JSON fields, and\n+// whether it checks the end of its input: a comparison with io.EOF (==, !=\n+// or errors.Is), a call of DecodeStrictJSON, or json.Unmarshal of the input,\n+// which refuses anything after the value. A decode or a More/Token call\n+// that is not compared with io.EOF is no such check (review round 1, F1).\n+func strictJSONReaderEnds(fn *ast.FuncDecl) (strict, ends bool) {\n+\tisEOF := func(e ast.Expr) bool {\n+\t\tsel, ok := e.(*ast.SelectorExpr)\n+\t\tif !ok {\n+\t\t\treturn false\n+\t\t}\n+\t\tpkg, ok := sel.X.(*ast.Ident)\n+\t\treturn ok && pkg.Name == \"io\" && sel.Sel.Name == \"EOF\"\n+\t}\n+\tast.Inspect(fn.Body, func(n ast.Node) bool {\n+\t\tswitch n := n.(type) {\n+\t\tcase *ast.BinaryExpr:\n+\t\t\tif (n.Op == token.EQL || n.Op == token.NEQ) && (isEOF(n.X) || isEOF(n.Y)) {\n+\t\t\t\tends = true\n+\t\t\t}\n+\t\tcase *ast.CallExpr:\n+\t\t\tswitch fun := n.Fun.(type) {\n+\t\t\tcase *ast.SelectorExpr:\n+\t\t\t\tpkg, _ := fun.X.(*ast.Ident)\n+\t\t\t\tswitch {\n+\t\t\t\tcase fun.Sel.Name == \"DisallowUnknownFields\":\n+\t\t\t\t\tstrict = true\n+\t\t\t\tcase fun.Sel.Name == \"DecodeStrictJSON\":\n+\t\t\t\t\tends = true\n+\t\t\t\tcase pkg != nil && pkg.Name == \"json\" && fun.Sel.Name == \"Unmarshal\":\n+\t\t\t\t\tends = true\n+\t\t\t\tcase pkg != nil && pkg.Name == \"errors\" && fun.Sel.Name == \"Is\" && len(n.Args) == 2 && isEOF(n.Args[1]):\n+\t\t\t\t\tends = true\n+\t\t\t\t}\n+\t\t\tcase *ast.Ident:\n+\t\t\t\tif fun.Name == \"DecodeStrictJSON\" {\n+\t\t\t\t\tends = true\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\treturn true\n+\t})\n+\treturn strict, ends\n+}\n+\n+// Review round 1 (F1): the guard's predicate rejects readers that decode\n+// without checking the end, and accepts each form that checks it.\n+func TestStrictJSONReaderEndsJudgesTheCheckNotItsShape(t *testing.T) {\n+\tconst header = \"package p\\nimport (\\\"encoding/json\\\"; \\\"errors\\\"; \\\"io\\\"; \\\"bytes\\\")\\nvar _ = errors.Is\\nvar _ = bytes.NewReader\\nvar _ = io.EOF\\nvar _ = json.Unmarshal\\n\"\n+\tfor name, c := range map[string]struct {\n+\t\tbody string\n+\t\tends bool\n+\t}{\n+\t\t\"decode of a new value only\": {\"dec := json.NewDecoder(bytes.NewReader(raw)); dec.DisallowUnknownFields(); return dec.Decode(new(map[string]any))\", false},\n+\t\t\"More as the end check\":      {\"dec := json.NewDecoder(bytes.NewReader(raw)); dec.DisallowUnknownFields(); var v any; if err := dec.Decode(&v); err != nil { return err }; if dec.More() { return errors.New(\\\"x\\\") }; return nil\", false},\n+\t\t\"Token not compared\":         {\"dec := json.NewDecoder(bytes.NewReader(raw)); dec.DisallowUnknownFields(); var v any; if err := dec.Decode(&v); err != nil { return err }; _, err := dec.Token(); return err\", false},\n+\t\t\"io.EOF mentioned only\":      {\"dec := json.NewDecoder(bytes.NewReader(raw)); dec.DisallowUnknownFields(); var v any; e := io.EOF; _ = e; return dec.Decode(&v)\", false},\n+\t\t\"second decode compared\":     {\"dec := json.NewDecoder(bytes.NewReader(raw)); dec.DisallowUnknownFields(); var v any; if err := dec.Decode(&v); err != nil { return err }; if err := dec.Decode(new(any)); err != io.EOF { return errors.New(\\\"x\\\") }; return nil\", true},\n+\t\t\"Token with errors.Is\":       {\"dec := json.NewDecoder(bytes.NewReader(raw)); dec.DisallowUnknownFields(); var v any; if err := dec.Decode(&v); err != nil { return err }; if _, err := dec.Token(); !errors.Is(err, io.EOF) { return errors.New(\\\"x\\\") }; return nil\", true},\n+\t\t\"Unmarshal first\":            {\"var v any; if err := json.Unmarshal(raw, &v); err != nil { return err }; dec := json.NewDecoder(bytes.NewReader(raw)); dec.DisallowUnknownFields(); return dec.Decode(&v)\", true},\n+\t} {\n+\t\tfile, err := parser.ParseFile(token.NewFileSet(), \"p.go\", header+\"func read(raw []byte) error { \"+c.body+\" }\\n\", 0)\n+\t\tif err != nil {\n+\t\t\tt.Fatalf(\"%s: %v\", name, err)\n+\t\t}\n+\t\tvar fn *ast.FuncDecl\n+\t\tfor _, d := range file.Decls {\n+\t\t\tif f, ok := d.(*ast.FuncDecl); ok {\n+\t\t\t\tfn = f\n+\t\t\t}\n+\t\t}\n+\t\tstrict, ends := strictJSONReaderEnds(fn)\n+\t\tif !strict || ends != c.ends {\n+\t\t\tt.Errorf(\"%s: strict=%v ends=%v, want ends=%v\", name, strict, ends, c.ends)\n+\t\t}\n+\t}\n+}\n","exit_code":0,"status":"completed"}}
