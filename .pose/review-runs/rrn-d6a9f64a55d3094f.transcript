th)\n\tif err != nil || !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 || info.Size() > 2<<20 {\n\t\treturn nil, fmt.Errorf(\"plan file unavailable or exceeds 2 MiB\")\n\t}\n\treturn os.ReadFile(path)\n}\n\nfunc decodeTransferPlan(raw []byte) (posemodel.SpecTransferPlan, error) {\n\tvar plan posemodel.SpecTransferPlan\n\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n\tdecoder.DisallowUnknownFields()\n\tif err := decoder.Decode(&plan); err != nil {\n\t\treturn plan, err\n\t}\n\tvar extra any\n\tif err := decoder.Decode(&extra); err != io.EOF {\n\t\tif err == nil {\n\t\t\treturn plan, fmt.Errorf(\"trailing JSON\")\n\t\t}\n\t\treturn plan, err\n\t}\n\treturn plan, nil\n}\n\nfunc writeTransferJSON(w, stderr io.Writer, value any) int {\n\tencoder := json.NewEncoder(w)\n\tencoder.SetIndent(\"\", \"  \")\n\tif err := encoder.Encode(value); err != nil {\n\t\ttransferFailure(stderr, \"pose spec-transfer: \"+err.Error())\n\t\treturn 1\n\t}\n\tif open < 0 {\n\t\treturn nil, nil\n\t}\n\tif close < 0 {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block is not closed\")\n\t}\n\traw := []byte(strings.Join(lines[open+1:close], \"\\n\"))\n\tvar draft ReviewDraft\n\tdec := json.NewDecoder(bytes.NewReader(raw))\n\tdec.DisallowUnknownFields()\n\tif err := dec.Decode(&draft); err != nil {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block is not a draft: %v\", err)\n\t}\n\tif _, err := dec.Token(); err != io.EOF {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block carries data after the draft\")\n\t}\n\tif err := exactJSONKeys(json.NewDecoder(bytes.NewReader(raw)), reflect.TypeOf(draft)); err != nil {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block is ambiguous: %v\", err)\n\t}\n\tif err := validateReviewDraft(draft); err != nil {\n\t\treturn nil, err\n\t}\n\tfor i, line := range lines {\n\t\tif i > open && i <= close {\n\t\t\tcontinue\n\t\t}\n\t\tkey, value, ok := strings.Cut(strings.TrimSpace(line), \":\")\n\t\tif ok && key == \"decision\" && strings.TrimSpace(value) != draft.Decision {\n\t\t\treturn nil, fmt.Errorf(\"the draft's decision %s differs from the decision line %q\", draft.Decision, strings.TrimSpace(value))\n\t\t}\n\t}\n\t\t}\n\t}\n\treturn policy, digestBytes(raw), nil\n}\n\n// LoadFederatedRoadmapPolicy reads and writes the filesystem directly; LoadFederatedRoadmapPolicyIn takes the\n// operation's files.\nfunc LoadFederatedRoadmapPolicy(root string) (FederatedRoadmapPolicy, string, error) {\n\treturn LoadFederatedRoadmapPolicyIn(NativeFiles(), root)\n}\n\nfunc strictJSONBytes(raw []byte, target any) error {\n\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n\tdecoder.DisallowUnknownFields()\n\tif err := decoder.Decode(target); err != nil {\n\t\treturn err\n\t}\n\tvar extra any\n\tif err := decoder.Decode(&extra); err != io.EOF {\n\t\tif err == nil {\n\t\t\treturn fmt.Errorf(\"trailing JSON content\")\n\t\t}\n\t\treturn err\n\t}\n\treturn nil\n}\n\nfunc isSHA256(value string) bool {\n\tif !strings.HasPrefix(value, \"sha256:\") || len(value) != len(\"sha256:\")+64 {\n\t\treturn false\n\t}\n\t_, err := hex.DecodeString(strings.TrimPrefix(value, \"sha256:\"))\n\treturn err == nil\n}\n\nfunc isGitRevision(value string) bool {\n\treturn m\n}\n\n// readDescriptor reads the commit record. exists is false when there is none.\nfunc readIndexDescriptor(files Files, root string) (desc IndexGenerationDescriptor, raw []byte, exists bool, err error) {\n\traw, readErr := files.ReadFile(filepath.Join(indexDir(root), indexDescriptorName))\n\tif errors.Is(readErr, os.ErrNotExist) {\n\t\treturn IndexGenerationDescriptor{}, nil, false, nil\n\t}\n\tif readErr != nil {\n\t\treturn IndexGenerationDescriptor{}, nil, true, fmt.Errorf(\"the generation descriptor cannot be read: %w\", readErr)\n\t}\n\tdec := json.NewDecoder(strings.NewReader(string(raw)))\n\tdec.DisallowUnknownFields()\n\tif err := dec.Decode(&desc); err != nil {\n\t\treturn IndexGenerationDescriptor{}, raw, true, fmt.Errorf(\"the generation descriptor is not valid JSON