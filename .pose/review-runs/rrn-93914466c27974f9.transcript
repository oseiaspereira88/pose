{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '2580,2718p' pose-mcp/internal/pose/review_closeout.go\"","aggregated_output":"\tdefault:\n\t\treturn false, nil\n\t}\n}\n\nfunc (s Store) reviewRequiredForScope(scope ScopeRef, policy ReviewPolicy) (bool, error) {\n\tif !policy.Enabled {\n\t\treturn false, nil\n\t}\n\tif policy.RequireReviewForLegacyDoneScopes || policy.AdoptedAt == \"\" {\n\t\treturn true, nil\n\t}\n\tadoptedAt, err := time.Parse(time.DateOnly, policy.AdoptedAt)\n\tif err != nil {\n\t\treturn true, nil\n\t}\n\n\tvar createdAt, status string\n\tswitch scope.Kind {\n\tcase \"spec\":\n\t\tsp, err := s.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tcreatedAt, status = sp.CreatedAt, sp.Status\n\tcase \"milestone\":\n\t\trm, err := s.GetRoadmap(scope.Roadmap)\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tcreatedAt, status = rm.CreatedAt, rm.Status\n\tcase \"roadmap\":\n\t\trm, err := s.GetRoadmap(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tcreatedAt, status = rm.CreatedAt, rm.Status\n\t}\n\tif status != \"done\" {\n\t\treturn true, nil\n\t}\n\tcreated, err := time.Parse(time.DateOnly, createdAt)\n\tif err != nil {\n\t\treturn true, nil\n\t}\n\treturn !created.Before(adoptedAt), nil\n}\n\nfunc validateReviewEvidenceRef(files Files, root, ref string) error {\n\tparts := strings.SplitN(strings.TrimSpace(ref), \":\", 2)\n\tif len(parts) != 2 || !slugPattern.MatchString(parts[0]) || strings.TrimSpace(parts[1]) == \"\" {\n\t\treturn fmt.Errorf(\"invalid review evidence ref %q\", ref)\n\t}\n\tif parts[0] != \"report\" {\n\t\treturn nil\n\t}\n\trel := filepath.Clean(filepath.FromSlash(parts[1]))\n\tif !filepath.IsLocal(rel) {\n\t\treturn fmt.Errorf(\"review evidence path escapes project root: %q\", ref)\n\t}\n\tif !strings.HasPrefix(filepath.ToSlash(rel), \".pose/reports/\") {\n\t\trel = filepath.Join(\".pose\", \"reports\", rel)\n\t}\n\tpath := filepath.Join(root, rel)\n\tif err := validateProjectPathIn(files, root, rel); err != nil {\n\t\treturn fmt.Errorf(\"review evidence path escapes project root: %q: %w\", ref, err)\n\t}\n\tif _, err := files.Stat(path); err != nil {\n\t\treturn fmt.Errorf(\"review evidence does not resolve: %q\", ref)\n\t}\n\treturn nil\n}\n\nfunc (s Store) GetCloseoutState(ref string) (CloseoutState, error) {\n\treturn withGovernanceReviewReadView(s, \"closeout\", func(store Store) (CloseoutState, error) {\n\t\treturn store.getCloseoutState(ref, true)\n\t}, func(state *CloseoutState, metadata *ReadViewMetadata, audit governanceReadViewAudit) {\n\t\tapplyCloseoutReadView(state, metadata, ref, audit)\n\t})\n}\n\nfunc (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutState, error) {\n\ts = s.reviewOperation()\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn CloseoutState{}, err\n\t}\n\treview, err := s.ReviewCheck(ref)\n\tif err != nil {\n\t\treturn CloseoutState{}, err\n\t}\n\tstate := CloseoutState{SchemaVersion: ReviewSchemaVersion, Scope: ref, ScopeDigest: review.ScopeDigest, Review: review, LifecycleDone: true, Blockers: append([]string{}, review.Blockers...)}\n\tstate.VerificationBasis = \"applicable-review-contract\"\n\tif review.BundleID != \"\" {\n\t\tstate.VerificationBasis = \"sealed-review-contract\"\n\t}\n\tif !review.Required {\n\t\tstate.VerificationBasis = \"review-not-required-under-applicable-policy\"\n\t\tstate.Limitations = []string{\"Review is not required under the applicable policy/cutoff; this does not establish a historical execution receipt.\"}\n\t}\n\tvar diagnostics []Diagnostic\n\tfor _, blocker := range review.Blockers {\n\t\tdiagnostics = append(diagnostics, OpaqueDiagnostic(\"review-blocker\", DiagnosticCloseout, blocker))\n\t}\n\tblock := func(d Diagnostic) {\n\t\tdiagnostics = append(diagnostics, d)\n\t\tstate.Blockers = append(state.Blockers, d.Message)\n\t}\n\tchildStore := s\n\t// includeFederated=false already suppresses recursive acceptance. Keep the\n\t// authorized binding: clearing it makes a child borrow its parent's active\n\t// read view under a different Store context.\n\tswitch scope.Kind {\n\tcase \"spec\":\n\t\tsp, err := s.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tstate.LifecycleDone = sp.Status == \"done\"\n\t\t// A question the current bundle's adjudication says does not hold\n\t\t// blocks the closeout as it fails the lint (spec\n\t\t// pose-delegated-verdict-destinations R1; review round 1, B05).\n\t\tfor _, message := range s.adjudicationBlockers(scope.Slug) {\n\t\t\tblock(OpaqueDiagnostic(AdjudicationDoesNotHoldCode, DiagnosticCloseout, message))\n\t\t}\n\t\tif _, findings, historyErr := s.InspectAmendmentHistory(*sp); historyErr != nil {\n\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+historyErr.Error()))\n\t\t\tstate.Limitations = append(state.Limitations, \"Amendment history could not be verified; inspect and repair it explicitly.\")\n\t\t} else {\n\t\t\tfor _, finding := range findings {\n\t\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+finding))\n\t\t\t}\n\t\t}\n\tcase \"milestone\":\n\t\trm, err := s.GetRoadmap(scope.Roadmap)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tcloseoutAdopted, adoptErr := s.closeoutReviewPolicyAdopted()\n","exit_code":0,"status":"completed"}}
