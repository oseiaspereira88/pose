.Blockers, childErr.Error())\n+\t\t}\n+\t\tfor _, child := range children {\n+\t\t\tstanding, err := s.verifyReviewBundle(child)\n+\t\t\tswitch {\n+\t\t\tcase err != nil:\n+\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child+\" cannot be verified: \"+err.Error())\n+\t\t\tcase standing.State != \"closed\" || !standing.Approved || !standing.Fresh:\n+\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child+\" does not stand: \"+standing.State)\n+\t\t\t}\n+\t\t}\n+\t\tif len(verification.Blockers) > 0 {\n+\t\t\tverification.State, verification.Approved = \"needs-review\", false\n+\t\t\tverification.NextAction = \"restore or close the children of \" + scope + \" first: \" + strings.Join(verification.Blockers, \"; \")\n+\t\t}\n+\t\tif len(verification.Blockers) == 0 && s.receiptStandsFor(scope) {\n+\t\t\tverification.State, verification.NextAction = \"closed\", \"scope is closed by its closeout receipt\"\n+\t\t}\n+\t\treturn verification, nil\n+\t}\n+\t// A policy without bundles answers through its review attempts alone, and has no\n+\t// bundle of the spec to stand on. An adopted exemption is projected above\n+\t// whether bundles are enabled or not (review round 10, N34).\n+\tif !policy.ReviewBundles {\n+\t\treturn own, nil\n+\t}\n+\tif ref.Kind != \"milestone\" {\n+\t\treturn own, nil\n+\t}\n \t// Edges still bind: a milestone inherits a review, not the acceptance of what it\n \t// depends on, and revoked trust or an open predecessor leaves it where it was.\n \tif s.FederatedResolver != nil {\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex 0782e239..7182af75 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -131,6 +131,10 @@ type ReviewPlan struct {\n \tWarnings                  []string `json:\"warnings,omitempty\"`\n \tBlockers                  []string `json:\"blockers,omitempty\"`\n \tExplain                   []str