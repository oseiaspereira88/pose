urn code\n \t\t\t\t}\n \t\t\t\tdecided = true\ndiff --git a/pose-mcp/internal/pose/artifact_ref.go b/pose-mcp/internal/pose/artifact_ref.go\nindex 22fc3d8a..f9f09763 100644\n--- a/pose-mcp/internal/pose/artifact_ref.go\n+++ b/pose-mcp/internal/pose/artifact_ref.go\n@@ -201,7 +201,13 @@ func (r ArtifactResolver) resolve(localProject, raw string, redirectPath map[str\n \t\trefsRequired := policy.SchemaVersion == QualifiedArtifactPolicySchemaVersion || policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion\n \t\ttransferValid := policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 1 || policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 0\n \t\trefsCompatible := policy.RefsVersion == 0 || policy.RefsVersion == 1 && refsRequired\n-\t\tif !refsCompatible || refsRequired && policy.RefsVersion != 1 || policy.SchemaVersion > SpecAuthorityTransferPolicySchemaVersion || !transferValid {\n+\t\tif policy.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n+\t\t\t// Schema 5 (closeout review pair) keeps references and transfer\n+\t\t\t// optional: 0, or 1 as schemas 3 and 4 define them.\n+\t\t\trefsCompatible = policy.RefsVersion == 0 || policy.RefsVersion == 1\n+\t\t\ttransferValid = policy.TransferVersion == 0 || policy.TransferVersion == 1 && policy.RefsVersion == 1\n+\t\t}\n+\t\tif !refsCompatible || refsRequired && policy.RefsVersion != 1 || policy.SchemaVersion > CloseoutReviewPolicySchemaVersion || !transferValid {\n \t\t\tout.State = \"unsupported-artifact-contract\"\n \t\t\treturn out\n \t\t}\ndiff --git a/pose-mcp/internal/pose/capability_catalog.go b/pose-mcp/internal/pose/capability_catalog.go\nindex 59f85700..db9e4d61 100644\n--- a/pose-mcp/internal/pose/capability_catalog.go\n+++ b/pose-mcp/internal/pose/capability_catalog.go\n@@ -195,6 +195,8 @@ type CatalogEntry struct {\n \tAdopt        func(docs PolicyDocs, date string) []string\n \tRetire       func(docs PolicyDocs) []string\n \tAdopted      func(docs PolicyDocs) bool\n+\t// RetireRefusal, when set, is why the capability cannot be turned off.\n+\tRetireRefusal string\n }\n \n func governedEntry(c GovernedCapability, introduced, effect string, implies ...string) CatalogEntry {\n@@ -305,6 +307,7 @@ func catalogEntries() []CatalogEntry {\n \t\t\t},\n \t\t\tAdopted: func(docs PolicyDocs) bool { v, _ := docs.DoR[\"adopted_at\"].(string); return v != \"\" },\n \t\t},\n+\t\tcloseoutReviewPolicyCatalogEntry(),\n \t\toverlayEntry(\"backend-review\", \"1.1.0\", \"a spec touching a backend component is also reviewed for contracts, input errors, concurrency, observability and integration impact\"),\n \t\toverlayEntry(\"engineering-judgment\", \"6.0.0\", \"a scope selected by its declared risk is also reviewed for engineering judgment\"),\n \t\toverlayEntry(\"frontend-review\", \"1.1.0\", \"a spec touching a frontend component is also reviewed for accessibility, state and rendering\"),\n@@ -319,7 +322,7 @@ func catalogEntries() []CatalogEntry {\n \t\t\t\t}\n \t\t\t\tchanges := []string{\"set qualified_artifact_refs_version=1\"}\n \t\t\t\tdocs.Review[\"qualified_artifact_refs_version\"] = 1\n-\t\t\t\tif schemaVersionOf(docs) < QualifiedArtifactPolicySchemaVersion {\n+\t\t\t\tif schemaVersionOf(docs) < QualifiedArtifactPolicySchemaVersion && !closeoutPairPresent(docs) {\n \t\t\t\t\tdocs.Review[\"schema_version\"] = QualifiedArtifactPolicySchemaVersion\n \t\t\t\t\tchanges = append(changes, fmt.Sprintf(\"set schema_version=%d\", QualifiedArtifactPolicySchemaVersion))\n \t\t\t\t}\n@@ -330,6 +333,10 @@ func catalogEntries() []CatalogEntry {\n \t\t\t\t\treturn nil\n \t\t\t\t}\n \t\t\t\tdelete(docs.Review, \"qualified_artifact_refs_version\")\n+\t\t\t\tif closeoutPairPresent(docs) {\n+\t\t\t\t\t// Schema 5 keeps the closeout pair; references are optional under it.\n+\t\t\t\t\treturn []string{\"remove qualified_artifact_refs_version\"}\n+\t\t\t\t}\n \t\t\t\tdocs.Review[\"schema_version\"] = ReviewPo