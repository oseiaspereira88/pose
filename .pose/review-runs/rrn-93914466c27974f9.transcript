{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/closeout_adr_associations.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// ADR associations of a roadmap, for the when-justified roadmap rule of the\n     4\t// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n     5\t//\n     6\t// An association is explicit, never inferred from prose:\n     7\t//   - forward: the roadmap's `adrs: [adr:<file>.md]` frontmatter, or a local\n     8\t//     Markdown link from its body to a file in .pose/adr/;\n     9\t//   - backward: an ADR's `roadmaps: [roadmap:<slug>]` (or the qualified\n    10\t//     `xref:<project>/roadmap:<slug>`) frontmatter, or a local Markdown link\n    11\t//     from the ADR to .pose/roadmaps/<slug>.md.\n    12\t//\n    13\t// Only the owning project's .pose/adr/ is inventoried; nothing searches other\n    14\t// projects. A malformed declaration, a link to a missing file or an\n    15\t// incomplete inventory is unknown, which can never prove absence.\n    16\t\n    17\timport (\n    18\t\t\"fmt\"\n    19\t\t\"github.com/yuin/goldmark\"\n    20\t\t\"github.com/yuin/goldmark/ast\"\n    21\t\t\"github.com/yuin/goldmark/text\"\n    22\t\t\"html\"\n    23\t\t\"net/url\"\n    24\t\t\"os\"\n    25\t\t\"path/filepath\"\n    26\t\t\"regexp\"\n    27\t\t\"sort\"\n    28\t\t\"strings\"\n    29\t)\n    30\t\n    31\tconst (\n    32\t\tcloseoutADRInventoryLimit = 4096\n    33\t\tcloseoutADRSizeLimit      = 1 << 20\n    34\t)\n    35\t\n    36\tfunc (s Store) adrDir() string { return filepath.Join(s.Root, \".pose\", \"adr\") }\n    37\t\n    38\t// markdownLinkDestinations lists the local link destinations of a Markdown\n    39\t// body as CommonMark reads them (ADR\n    40\t// governance-association-links-are-read-with-a-commonmark-parser): the links\n    41\t// and images of its syntax tree, reference definitions resolved, code and\n    42\t// comments excluded. Each destination is decoded in CommonMark precedence,\n    43\t// cut at its fragment and query, and percent-decoded. The second list holds\n    44\t// what the reader cannot speak for: a destination whose escapes do not\n    45\t// decode, and raw HTML carrying a link attribute.\n    46\tfunc markdownLinkDestinations(body string) ([]string, []string) {\n    47\t\tout, undecodable := []string{}, []string{}\n    48\t\tsource := []byte(body)\n    49\t\tdoc := goldmark.New().Parser().Parse(text.NewReader(source))\n    50\t\tadd := func(raw string) {\n    51\t\t\tdest := decodeMarkdownDestination(raw)\n    52\t\t\tif i := strings.IndexAny(dest, \"#?\"); i >= 0 {\n    53\t\t\t\tdest = dest[:i]\n    54\t\t\t}\n    55\t\t\tdecoded, err := url.PathUnescape(dest)\n    56\t\t\tif err != nil {\n    57\t\t\t\tundecodable = append(undecodable, raw)\n    58\t\t\t\treturn\n    59\t\t\t}\n    60\t\t\tdest = strings.TrimSpace(decoded)\n    61\t\t\tif dest == \"\" || strings.Contains(dest, \"://\") || strings.HasPrefix(dest, \"mailto:\") || strings.HasPrefix(dest, \"/\") {\n    62\t\t\t\treturn\n    63\t\t\t}\n    64\t\t\tout = append(out, dest)\n    65\t\t}\n    66\t\thtmlLink := func(raw string) {\n    67\t\t\tif markdownHTMLLinkAttributeRE.MatchString(raw) {\n    68\t\t\t\tundecodable = append(undecodable, \"raw HTML \"+strings.TrimSpace(raw))\n    69\t\t\t}\n    70\t\t}\n    71\t\t_ = ast.Walk(doc, func(node ast.Node, entering bool) (ast.WalkStatus, error) {\n    72\t\t\tif !entering {\n    73\t\t\t\treturn ast.WalkContinue, nil\n    74\t\t\t}\n    75\t\t\tswitch n := node.(type) {\n    76\t\t\tcase *ast.Link:\n    77\t\t\t\tadd(string(n.Destination))\n    78\t\t\tcase *ast.Image:\n    79\t\t\t\tadd(string(n.Destination))\n    80\t\t\tcase *ast.RawHTML:\n    81\t\t\t\tvar raw strings.Builder\n    82\t\t\t\tfor i := 0; i < n.Segments.Len(); i++ {\n    83\t\t\t\t\tsegment := n.Segments.At(i)\n    84\t\t\t\t\traw.Write(segment.Value(source))\n    85\t\t\t\t}\n    86\t\t\t\thtmlLink(raw.String())\n    87\t\t\tcase *ast.HTMLBlock:\n    88\t\t\t\tvar raw strings.Builder\n    89\t\t\t\tfor i := 0; i < n.Lines().Len(); i++ {\n    90\t\t\t\t\tline := n.Lines().At(i)\n    91\t\t\t\t\traw.Write(line.Value(source))\n    92\t\t\t\t}\n    93\t\t\t\tif n.HasClosure() {\n    94\t\t\t\t\traw.Write(n.ClosureLine.Value(source))\n    95\t\t\t\t}\n    96\t\t\t\thtmlLink(raw.String())\n    97\t\t\t}\n    98\t\t\treturn ast.WalkContinue, nil\n    99\t\t})\n   100\t\treturn out, undecodable\n   101\t}\n   102\t\n   103\tvar (\n   104\t\t// markdownEntityRE is a CommonMark character reference at the start of a\n   105\t\t// string: decimal, hexadecimal or named.\n   106\t\tmarkdownEntityRE = regexp.MustCompile(`^&(#[0-9]{1,7}|#[xX][0-9a-fA-F]{1,6}|[A-Za-z][A-Za-z0-9]{1,31});`)\n   107\t\t// markdownHTMLLinkAttributeRE finds an attribute through which raw HTML\n   108\t\t// makes a link.\n   109\t\tmarkdownHTMLLinkAttributeRE = regexp.MustCompile(`(?i)\\b(href|src)\\s*=`)\n   110\t)\n   111\t\n   112\t// decodeMarkdownDestination decodes a raw link destination in one\n   113\t// left-to-right pass, as CommonMark does: a backslash makes the next ASCII\n   114\t// punctuation literal, and only an unescaped & starts a character reference.\n   115\tfunc decodeMarkdownDestination(raw string) string {\n   116\t\tvar b strings.Builder\n   117\t\tfor i := 0; i < len(raw); {\n   118\t\t\tc := raw[i]\n   119\t\t\tif c == '\\\\' && i+1 < len(raw) && isASCIIPunctuation(raw[i+1]) {\n   120\t\t\t\tb.WriteByte(raw[i+1])\n   121\t\t\t\ti += 2\n   122\t\t\t\tcontinue\n   123\t\t\t}\n   124\t\t\tif c == '&' {\n   125\t\t\t\tif entity := markdownEntityRE.FindString(raw[i:]); entity != \"\" {\n   126\t\t\t\t\tif decoded := html.UnescapeString(entity); decoded != entity {\n   127\t\t\t\t\t\tb.WriteString(decoded)\n   128\t\t\t\t\t\ti += len(entity)\n   129\t\t\t\t\t\tcontinue\n   130\t\t\t\t\t}\n   131\t\t\t\t}\n   132\t\t\t}\n   133\t\t\tb.WriteByte(c)\n   134\t\t\ti++\n   135\t\t}\n   136\t\treturn b.String()\n   137\t}\n   138\t\n   139\tfunc isASCIIPunctuation(c byte) bool {\n   140\t\treturn c >= '!' && c <= '/' || c >= ':' && c <= '@' || c >= '[' && c <= '`' || c >= '{' && c <= '~'\n   141\t}\n   142\t\n   143\t// associationList reads one association key (adrs: on a roadmap, roadmaps: on\n   144\t// an ADR) from the raw frontmatter of a governance file, strictly: a key\n   145\t// declared more than once, declared with no value, outside a [list], or with\n   146\t// an empty item is reported, never read as an absent or empty association. An\n   147\t// explicit [] declares none (review round 12, N39).\n   148\tfunc associationList(raw, key, owner string) ([]string, bool, string) {\n   149\t\tlines := strings.Split(strings.ReplaceAll(raw, \"\\r\\n\", \"\\n\"), \"\\n\")\n   150\t\tif len(lines) == 0 || strings.TrimSpace(lines[0]) != \"---\" {\n   151\t\t\treturn nil, false, \"\"\n   152\t\t}\n   153\t\tvalues := []string{}\n   154\t\tfor _, line := range lines[1:] {\n   155\t\t\tif strings.TrimSpace(line) == \"---\" {\n   156\t\t\t\tbreak\n   157\t\t\t}\n   158\t\t\t// The key and value as SplitFrontmatter reads them: the key trimmed,\n   159\t\t\t// a template comment removed (review round 13, N45).\n   160\t\t\tif name, value, ok := strings.Cut(line, \":\"); ok && strings.TrimSpace(name) == key {\n   161\t\t\t\tvalues = append(values, cleanValue(value))\n   162\t\t\t}\n   163\t\t}\n   164\t\tswitch {\n   165\t\tcase len(values) == 0:\n   166\t\t\treturn nil, false, \"\"\n   167\t\tcase len(values) > 1:\n   168\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: %d times; one declaration is required\", owner, key, len(values))\n   169\t\t}\n   170\t\tvalue := values[0]\n   171\t\tif value == \"\" {\n   172\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with no value; declare [] for none\", owner, key)\n   173\t\t}\n   174\t\tif !strings.HasPrefix(value, \"[\") || !strings.HasSuffix(value, \"]\") {\n   175\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: outside a [list]\", owner, key)\n   176\t\t}\n   177\t\tinner := strings.TrimSpace(value[1 : len(value)-1])\n   178\t\tif inner == \"\" {\n   179\t\t\treturn []string{}, true, \"\"\n   180\t\t}\n   181\t\titems := []string{}\n   182\t\tfor _, item := range strings.Split(inner, \",\") {\n   183\t\t\titem = strings.TrimSpace(item)\n   184\t\t\tif item == \"\" {\n   185\t\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with an empty item\", owner, key)\n   186\t\t\t}\n   187\t\t\titems = append(items, item)\n   188\t\t}\n   189\t\treturn items, true, \"\"\n   190\t}\n   191\t\n   192\t// validADRBasename accepts exactly a file name ending in .md directly inside\n   193\t// .pose/adr/: no directory, traversal, hidden file or URI.\n   194\tfunc validADRBasename(name string) bool {\n   195\t\treturn name != \"\" && filepath.Base(name) == name && !strings.ContainsAny(name, `/\\:`) &&\n   196\t\t\t!strings.HasPrefix(name, \".\") && strings.HasSuffix(name, \".md\") && name != \".md\"\n   197\t}\n   198\t\n   199\t// regularADR reports a regular, non-symlinked file of .pose/adr/ within the root.\n   200\tfunc (s Store) regularADR(name string) error {\n   201\t\tpath := filepath.Join(s.adrDir(), name)\n   202\t\tinfo, err := s.fsys().Lstat(path)\n   203\t\tif err != nil {\n   204\t\t\treturn err\n   205\t\t}\n   206\t\tif info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n   207\t\t\treturn fmt.Errorf(\"not a regular file inside .pose/adr\")\n   208\t\t}\n   209\t\treturn nil\n   210\t}\n   211\t\n   212\t// closeoutADRAssociations returns the sorted ADR basenames associated with a\n   213\t// roadmap, and the diagnostics that make the answer unknown.\n   214\tfunc (s Store) closeoutADRAssociations(rm *Roadmap, project string) ([]string, []string) {\n   215\t\tfound := map[string]bool{}\n   216\t\tdiagnostics := []string{}\n   217\t\trawRoadmap, readErr := s.fsys().ReadFile(rm.Path)\n   218\t\tif readErr != nil {\n   219\t\t\tdiagnostics = append(diagnostics, \"roadmap \"+rm.Slug+\" could not be read for its adrs: \"+readErr.Error())\n   220\t\t}\n   221\t\tdeclared, _, declarationProblem := associationList(string(rawRoadmap), \"adrs\", \"roadmap \"+rm.Slug)\n   222\t\tif declarationProblem != \"\" {\n   223\t\t\tdiagnostics = append(diagnostics, declarationProblem)\n   224\t\t}\n   225\t\tfor _, item := range declared {\n   226\t\t\tname, ok := strings.CutPrefix(item, \"adr:\")\n   227\t\t\tif !ok || !validADRBasename(name) {\n   228\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares %q, not adr:<file>.md\", rm.Slug, item))\n   229\t\t\t\tcontinue\n   230\t\t\t}\n   231\t\t\tif err := s.regularADR(name); err != nil {\n   232\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares adr:%s, which cannot be read: %v\", rm.Slug, name, err))\n   233\t\t\t\tcontinue\n   234\t\t\t}\n   235\t\t\tfound[name] = true\n   236\t\t}\n   237\t\tbody := rm.Body\n   238\t\tif body == \"\" {\n   239\t\t\tif full, err := s.GetRoadmap(rm.Slug); err == nil {\n   240\t\t\t\tbody = full.Body\n   241\t\t\t}\n   242\t\t}\n   243\t\troadmapDir := filepath.Dir(rm.Path)\n   244\t\tlinks, undecodable := markdownLinkDestinations(body)\n   245\t\tfor _, dest := range undecodable {\n   246\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, which the association reader cannot resolve (an undecodable escape or raw HTML link)\", rm.Slug, dest))\n   247\t\t}\n   248\t\tfor _, dest := range links {\n   249\t\t\ttarget := filepath.Clean(filepath.Join(roadmapDir, filepath.FromSlash(dest)))\n   250\t\t\tif filepath.Dir(target) != filepath.Clean(s.adrDir()) || !strings.HasSuffix(target, \".md\") {\n   251\t\t\t\tcontinue\n   252\t\t\t}\n   253\t\t\tname := filepath.Base(target)\n   254\t\t\tif err := s.regularADR(name); err != nil {\n   255\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, which cannot be read: %v\", rm.Slug, dest, err))\n   256\t\t\t\tcontinue\n   257\t\t\t}\n   258\t\t\tfound[name] = true\n   259\t\t}\n   260\t\tentries, err := s.fsys().ReadDir(s.adrDir())\n   261\t\tif err != nil && !os.IsNotExist(err) {\n   262\t\t\tdiagnostics = append(diagnostics, \"the ADR inventory could not be read: \"+err.Error())\n   263\t\t}\n   264\t\tif len(entries) > closeoutADRInventoryLimit {\n   265\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"the ADR inventory has %d entries, above the limit of %d\", len(entries), closeoutADRInventoryLimit))\n   266\t\t\tentries = nil\n   267\t\t}\n   268\t\troadmapPath := filepath.Clean(filepath.Join(s.roadmapsDir(), rm.Slug+\".md\"))\n   269\t\tfor _, entry := range entries {\n   270\t\t\tname := entry.Name()\n   271\t\t\t// Every candidate is read, the associated ones included: its size,\n   272\t\t\t// its readability and its own declaration are inputs. One that\n   273\t\t\t// cannot be read could hold a backlink, so it is unknown.\n   274\t\t\tif entry.IsDir() || !strings.HasSuffix(name, \".md\") {\n   275\t\t\t\tcontinue\n   276\t\t\t}\n   277\t\t\tif err := s.regularADR(name); err != nil {\n   278\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is not a regular file of .pose/adr: \"+err.Error())\n   279\t\t\t\tcontinue\n   280\t\t\t}\n   281\t\t\tpath := filepath.Join(s.adrDir(), name)\n   282\t\t\tif info, err := s.fsys().Lstat(path); err != nil || info.Size() > closeoutADRSizeLimit {\n   283\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is unreadable or above the size limit\")\n   284\t\t\t\tcontinue\n   285\t\t\t}\n   286\t\t\traw, err := s.fsys().ReadFile(path)\n   287\t\t\tif err != nil {\n   288\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" could not be read: \"+err.Error())\n   289\t\t\t\tcontinue\n   290\t\t\t}\n   291\t\t\t_, adrBody := SplitFrontmatter(string(raw))\n   292\t\t\tbackward, _, backwardProblem := associationList(string(raw), \"roadmaps\", \"ADR \"+name)\n   293\t\t\tif backwardProblem != \"\" {\n   294\t\t\t\tdiagnostics = append(diagnostics, backwardProblem)\n   295\t\t\t}\n   296\t\t\tfor _, item := range backward {\n   297\t\t\t\tref, err := ParseArtifactRef(item)\n   298\t\t\t\tif err != nil || ref.Kind != \"roadmap\" || ref.Milestone != \"\" {\n   299\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %q, not roadmap:<slug>\", name, item))\n   300\t\t\t\t\tcontinue\n   301\t\t\t\t}\n   302\t\t\t\tif ref.Project != \"\" && ref.Project != project {\n   303\t\t\t\t\tcontinue // a roadmap of another project: not this association\n   304\t\t\t\t}\n   305\t\t\t\tif _, err := s.GetRoadmap(ref.Slug); err != nil {\n   306\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %s, which names no roadmap of this project\", name, item))\n   307\t\t\t\t\tcontinue\n   308\t\t\t\t}\n   309\t\t\t\tif ref.Slug == rm.Slug {\n   310\t\t\t\t\tfound[name] = true\n   311\t\t\t\t}\n   312\t\t\t}\n   313\t\t\tbacklinks, undecodableBacklinks := markdownLinkDestinations(adrBody)\n   314\t\t\tfor _, dest := range undecodableBacklinks {\n   315\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which the association reader cannot resolve (an undecodable escape or raw HTML link)\")\n   316\t\t\t}\n   317\t\t\tfor _, dest := range backlinks {\n   318\t\t\t\ttarget := filepath.Clean(filepath.Join(s.adrDir(), filepath.FromSlash(dest)))\n   319\t\t\t\tif filepath.Dir(target) != filepath.Clean(s.roadmapsDir()) || !strings.HasSuffix(target, \".md\") {\n   320\t\t\t\t\tcontinue\n   321\t\t\t\t}\n   322\t\t\t\t// A link into the roadmaps namespace is an association input: one\n   323\t\t\t\t// that does not resolve to a roadmap leaves the answer unknown.\n   324\t\t\t\tif info, err := s.fsys().Lstat(target); err != nil || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, target) {\n   325\t\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which is not a roadmap of this project\")\n   326\t\t\t\t\tcontinue\n   327\t\t\t\t}\n   328\t\t\t\t// The target is read as the roadmap it names, as a roadmaps:\n   329\t\t\t\t// declaration is: a regular entry that cannot be read or parsed\n   330\t\t\t\t// leaves the answer unknown, never an absence. The roadmaps README\n   331\t\t\t\t// is no roadmap, as ListRoadmaps reads the namespace.\n   332\t\t\t\tif strings.EqualFold(filepath.Base(target), \"README.md\") {\n   333\t\t\t\t\tcontinue\n   334\t\t\t\t}\n   335\t\t\t\tif _, err := s.GetRoadmap(strings.TrimSuffix(filepath.Base(target), \".md\")); err != nil {\n   336\t\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which could not be read as a roadmap of this project\")\n   337\t\t\t\t\tcontinue\n   338\t\t\t\t}\n   339\t\t\t\tif target == roadmapPath {\n   340\t\t\t\t\tfound[name] = true\n   341\t\t\t\t}\n   342\t\t\t}\n   343\t\t}\n   344\t\tadrs := make([]string, 0, len(found))\n   345\t\tfor name := range found {\n   346\t\t\tadrs = append(adrs, name)\n   347\t\t}\n   348\t\tsort.Strings(adrs)\n   349\t\tsort.Strings(diagnostics)\n   350\t\treturn adrs, diagnostics\n   351\t}\n","exit_code":0,"status":"completed"}}
