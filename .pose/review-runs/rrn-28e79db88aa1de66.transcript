{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/rules/backend-go.md .pose/rules/documentation-style.md; rg -n 'func TestAnInvalidHookRunnerIsRefused' pose-mcp/internal/cli -A 100\"","aggregated_output":"# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Documentation Style\n\n## When to consult\n\nConsult this guide for process documentation, rules, specs, workflows, and operational instructions.\n\n## Required conventions\n\n- Write instructions in the imperative mood and begin them with action verbs.\n- Keep bullets short and limited to one idea.\n- Avoid duplicating sections with the same purpose across files.\n- Link to the single source of truth instead of copying its content.\n- Use `check`, `spec`, and `workflow` consistently.\n- State each instruction's scope explicitly to reduce ambiguity.\n\n## Examples: good and bad\n\n### Redundancy\n\n- **Good:** \"Update review criteria in `.pose/workflows/review.md` and reference that workflow from the root AGENTS file.\"\n- **Bad:** \"Repeat review criteria in AGENTS, the workflow, and every related spec.\"\n\n### Ambiguous reference\n\n- **Good:** \"Run the lint check described by the review workflow.\"\n- **Bad:** \"Run that standard validation before pushing.\"\n\n## Quick editorial checklist\n\n- Language is imperative and direct.\n- Bullets are short and non-overlapping.\n- Files do not duplicate sections.\n- `check`, `spec`, and `workflow` are used consistently.\n- References point to explicit files or paths.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\npose-mcp/internal/cli/hook_runner_test.go:45:func TestAnInvalidHookRunnerIsRefused(t *testing.T) {\npose-mcp/internal/cli/hook_runner_test.go-46-\tfor name, policy := range map[string]string{\npose-mcp/internal/cli/hook_runner_test.go-47-\t\t\"outside\":        `{\"schema_version\":1,\"runner\":\"../hook.sh\"}`,\npose-mcp/internal/cli/hook_runner_test.go-48-\t\t\"absolute\":       `{\"schema_version\":1,\"runner\":\"/bin/true\"}`,\npose-mcp/internal/cli/hook_runner_test.go-49-\t\t\"missing\":        `{\"schema_version\":1,\"runner\":\"scripts/absent.sh\"}`,\npose-mcp/internal/cli/hook_runner_test.go-50-\t\t\"unknown schema\": `{\"schema_version\":2,\"runner\":\"scripts/hook.sh\"}`,\npose-mcp/internal/cli/hook_runner_test.go-51-\t\t\"unknown field\":  `{\"schema_version\":1,\"runner\":\"scripts/hook.sh\",\"shell\":true}`,\npose-mcp/internal/cli/hook_runner_test.go-52-\t\t\"trailing bytes\": `{\"schema_version\":1,\"runner\":\"scripts/hook.sh\"} garbage`,\npose-mcp/internal/cli/hook_runner_test.go-53-\t\t\"two objects\":    `{\"schema_version\":1,\"runner\":\"scripts/hook.sh\"}{\"schema_version\":1,\"runner\":\"scripts/hook.sh\"}`,\npose-mcp/internal/cli/hook_runner_test.go-54-\t\t\"not an object\":  `[{\"schema_version\":1,\"runner\":\"scripts/hook.sh\"}]`,\npose-mcp/internal/cli/hook_runner_test.go-55-\t} {\npose-mcp/internal/cli/hook_runner_test.go-56-\t\tt.Run(name, func(t *testing.T) {\npose-mcp/internal/cli/hook_runner_test.go-57-\t\t\t_, marker := hookRunnerRepo(t, policy)\npose-mcp/internal/cli/hook_runner_test.go-58-\t\t\tvar out, errOut bytes.Buffer\npose-mcp/internal/cli/hook_runner_test.go-59-\t\t\tif code := HookMain(\"pre-commit\", &out, &errOut); code != 1 || !strings.Contains(errOut.String(), \"hooks policy\") {\npose-mcp/internal/cli/hook_runner_test.go-60-\t\t\t\tt.Fatalf(\"an invalid runner was not refused: %d %s\", code, errOut.String())\npose-mcp/internal/cli/hook_runner_test.go-61-\t\t\t}\npose-mcp/internal/cli/hook_runner_test.go-62-\t\t\tif _, err := os.Stat(marker); err == nil {\npose-mcp/internal/cli/hook_runner_test.go-63-\t\t\t\tt.Fatal(\"an invalid runner ran\")\npose-mcp/internal/cli/hook_runner_test.go-64-\t\t\t}\npose-mcp/internal/cli/hook_runner_test.go-65-\t\t})\npose-mcp/internal/cli/hook_runner_test.go-66-\t}\npose-mcp/internal/cli/hook_runner_test.go-67-}\npose-mcp/internal/cli/hook_runner_test.go-68-\npose-mcp/internal/cli/hook_runner_test.go-69-// R3: status names the runner a managed hook delegates to.\npose-mcp/internal/cli/hook_runner_test.go-70-func TestHookStatusNamesTheRunner(t *testing.T) {\npose-mcp/internal/cli/hook_runner_test.go-71-\troot, _ := hookRunnerRepo(t, `{\"schema_version\":1,\"runner\":\"scripts/hook.sh\"}`)\npose-mcp/internal/cli/hook_runner_test.go-72-\texe, err := os.Executable()\npose-mcp/internal/cli/hook_runner_test.go-73-\tif err != nil {\npose-mcp/internal/cli/hook_runner_test.go-74-\t\tt.Fatal(err)\npose-mcp/internal/cli/hook_runner_test.go-75-\t}\npose-mcp/internal/cli/hook_runner_test.go-76-\tif err := os.Symlink(exe, filepath.Join(root, \".git\", \"hooks\", \"pre-commit\")); err != nil {\npose-mcp/internal/cli/hook_runner_test.go-77-\t\tt.Fatal(err)\npose-mcp/internal/cli/hook_runner_test.go-78-\t}\npose-mcp/internal/cli/hook_runner_test.go-79-\tvar out, errOut bytes.Buffer\npose-mcp/internal/cli/hook_runner_test.go-80-\tif code := cmdHooks(root, []string{\"status\"}, &out, &errOut); code != 0 || !strings.Contains(out.String(), \"delegates to \"+filepath.Join(root, \"scripts/hook.sh\")) {\npose-mcp/internal/cli/hook_runner_test.go-81-\t\tt.Fatalf(\"status: %d %s %s\", code, out.String(), errOut.String())\npose-mcp/internal/cli/hook_runner_test.go-82-\t}\npose-mcp/internal/cli/hook_runner_test.go-83-}\n","exit_code":0,"status":"completed"}}
