 npm_config_proxy=\"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_46}\"; else export npm_config_proxy; fi else builtin unset npm_config_proxy 2>/dev/null || command unset npm_config_proxy; fi builtin unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_46 __CODEX_SNAPSHOT_PROXY_OVERRIDE_46 2>/dev/null || command unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_46 __CODEX_SNAPSHOT_PROXY_OVERRIDE_46 if [ -n \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_47}\" ]; then   if [ -z \"${ws_proxy+x}\" ] || [ \"${ws_proxy-}\" != \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_47}\" ]; then export ws_proxy=\"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_47}\"; else export ws_proxy; fi else builtin unset ws_proxy 2>/dev/null || command unset ws_proxy; fi builtin unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_47 __CODEX_SNAPSHOT_PROXY_OVERRIDE_47 2>/dev/null || command unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_47 __CODEX_SNAPSHOT_PROXY_OVERRIDE_47 if [ -n \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_48}\" ]; then   if [ -z \"${wss_proxy+x}\" ] || [ \"${wss_proxy-}\" != \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_48}\" ]; then export wss_proxy=\"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_48}\"; else export wss_proxy; fi else builtin unset wss_proxy 2>/dev/null || command unset wss_proxy; fi builtin unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_48 __CODEX_SNAPSHOT_PROXY_OVERRIDE_48 2>/dev/null || command unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_48 __CODEX_SNAPSHOT_PROXY_OVERRIDE_48 fi if [ -n \"${PATH:-}\" ]; then export PATH='/usr/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/codex-path':\"$PATH\"; else export PATH='/usr/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/codex-path'; fi  exec '/usr/bin/bash' -c 'ps -eo pid,etime,args | rg '\"'\"'pose artifact-check|pose surface-check|git (log|diff|cat-file)'\"'\"' | head -20; sed -n '\"'\"'885,950p'\"'\"' pose-mcp/internal/cli/artifact_integrity.go; cat .pose/policy/artifacts.json'\n      2       00:00 /usr/bin/bash -c ps -eo pid,etime,args | rg 'pose artifact-check|pose surface-check|git (log|diff|cat-file)' | head -20; sed -n '885,950p' pose-mcp/internal/cli/artifact_integrity.go; cat .pose/policy/artifacts.json\n      4       00:00 rg pose artifact-check|pose surface-check|git (log|diff|cat-file)\n\t\t\t\tgraph.Findings = append(graph.Findings, posemodel.NewDeliveryIntegrityFinding(\"resolvability\", severity, spec, path, set.ID, err.Error(), \"declare an exact confined tracked file path\"))\n\t\t\t}\n\t\t}\n\t}\n\tsort.Slice(graph.Findings, func(i, j int) bool { return graph.Findings[i].ID < graph.Findings[j].ID })\n\tif jsonOutput {\n\t\t_ = writeJSON(stdout, graph)\n\t} else {\n\t\t// The change set's provenance is what an operator needs first when\n\t\t// `observed` exceeds `claims`: which revisions were attributed, and how\n\t\t// many commits they span. Hiding it behind --json leaves the default\n\t\t// output advising \"narrow the attributed change set\" without saying what\n\t\t// the change set is (spec pose-diagnose-invisible-governance-failures).\n\t\tfmt.Fprintf(stdout, \"artifact.spec=%s\\nartifact.change_set=%s\\nartifact.change_set.base=%s\\nartifact.change_set.head=%s\\nartifact.change_set.commits=%d\\nartifact.diff_digest=%s\\nartifact.claims=%d\\nartifact.observed=%d\\nartifact.findings=%d\\n\",\n\t\t\tspec, set.ID, set.ResolvedBase, set.ResolvedHead, len(set.Commits), set.DiffDigest, len(claims), len(set.Paths), len(graph.Findings))\n\t\t// A claim resolved through a release names a path that is no longer\n\t\t// there; say where it went, or the pass reads as magic (spec\n\t\t// pose-release-archival-attested-by-the-ledger).\n\t\tfor _, a := range graph.Archivals {\n\t\t\tfmt.Fprintf(stdout, \"artifact.archived=%s -> %s (release %s)\\n\", a.Pending, a.Archived, a.Version)\n\t\t}\n\t\tfor _, finding := range graph.Findings {\n\t\t\trender(stdout, stderr).Finding(cliout.Finding{\n\t\t\t\tState: cliout.StateFromKey(finding.Severity), Code: finding.Code, Path: finding.Path,\n\t\t\t\tMessage: finding.Message, Remediation: finding.Remediation,\n\t\t\t})\n\t\t}\n\t}\n\tif strict {\n\t\tfor _, finding := range graph.Findings {\n\t\t\tif finding.Severity == \"error\" || finding.Severity == \"critical\" {\n\t\t\t\tif !jsonOutput {\n\t\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\t}\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t}\n\tif deliveryGraph, err := buildCurrentDeliveryGraph(root); err == nil {\n\t\tif raw, err := deliveryGraph.IndexJSON(); err == nil {\n\t\t\trefreshDeliveryIndex(root, append(raw, '\\n'), stderr)\n\t\t}\n\t}\n\treturn 0\n}\n\ntype artifactBackfillProposal struct {\n\tSchemaVersion int                                 `json:\"schema_version\"`\n\tDryRun        bool                                `json:\"dry_run\"`\n\tSpecs         map[string][]posemodel.ObservedPath `json:\"specs\"`\n\tConfidence    map[string]string                   `json:\"confidence\"`\n\tConflicts     map[string][]string                 `json:\"conflicts\"`\n}\n\nfunc cmdArtifactBackfill(root string, args []string, stdout, stderr io.Writer) int {\n\tapply, confirm, fromGit := false, false, false\n\tfor _, arg := range args {\n\t\tswitch arg {\n\t\tcase \"--from-git\":\n\t\t\tfromGit = true\n\t\tcase \"--apply\":\n\t\t\tapply = true\n\t\tcase \"--confirm-spec-edits\":\n\t\t\tconfirm = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose artifact-backfill --from-git [--apply --confirm-spec-edits]\")\n{\n  \"schema_version\": 1,\n  \"enabled\": true,\n  \"adopted_at\": \"2026-08-03\",\n  \"governed_roots\": [\n    \".agents/skills\",\n    \".github/workflows\",\n    \".pose/templates\",\n    \".pose/workflows\",\n    \"docs-site/docs\",\n    \"pose-mcp/internal\",\n    \"scripts\"\n  ],\n  \"exclusions\": [\n    \"pose-mcp/internal/scaffold/dist\",\n    \"pose-mcp/internal/mcpserver/testdata\",\n    \"pose-mcp/internal/pose/testdata\"\n  ],\n  \"none_reasons\": [\"release\", \"migration\"],\n  \"severities\": {\n    \"resolvability\": \"error\",\n    \"existence\": \"error\",\n    \"action-mismatch\": \"error\",\n    \"undeclared\": \"error\",\n    \"orphan\": \"warning\",\n    \"legacy-narrative\": \"info\"\n  }\n}\n","exit_code":0,"status":"completed"}}
