{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P72gBYBxPTDNp7aRQwxz5b","type":"tool_result","content":"2215\t\treturn nil\n2216\t}\n2217\t\n2218\t// takeContinuationRuntimeDir creates the attempt's runtime directory for a\n2219\t// continuation before its claim. When the directory is there, a claim that\n2220\t// appears meanwhile means another resume holds it: the continuation is\n2221\t// pending. Otherwise the directory belongs to no run of the attempt, and the\n2222\t// resume is refused with nothing claimed.\n2223\tfunc (s Store) takeContinuationRuntimeDir(ctx context.Context, plan DispatchPlan) (string, error) {\n2224\t\tsource := runtimeSourceOf(*plan.predecessor)\n2225\t\tif _, ok := reviewRunRuntimeDirPath(source); !ok {\n2226\t\t\treturn \"\", nil\n2227\t\t}\n2228\t\tdir, err := reviewRunRuntimeDir(source)\n2229\t\tif err == nil {\n2230\t\t\treturn dir, nil\n2231\t\t}\n2232\t\tif !errors.Is(err, fs.ErrExist) {\n2233\t\t\treturn \"\", err\n2234\t\t}\n2235\t\t// The resume that took it claims right after; look for that claim.\n2236\t\texisting, pending := s.awaitContinuationClaim(ctx, *plan.predecessor)\n2237\t\tif pending != nil {\n2238\t\t\treturn \"\", pending\n2239\t\t}\n2240\t\tif existing != nil {\n2241\t\t\tif why := continuationKindMismatch(plan, *existing); why != nil {\n2242\t\t\t\treturn \"\", why\n2243\t\t\t}\n2244\t\t\treturn \"\", &continuationRecorded{run: *existing}\n2245\t\t}\n2246\t\tif ctx.Err() != nil {\n2247\t\t\treturn \"\", ctx.Err()\n2248\t\t}\n2249\t\treturn \"\", err\n2250\t}\n2251\t\n2252\t// continuationKindMismatch refuses a recorded continuation of another kind\n2253\t// than plan's, as the plans do: a resume that met a handoff, or a handoff\n2254\t// that met a resume or another agent's handoff (spec\n2255\t// pose-review-resume-residuals, review round 1, N1).\n2256\tfunc continuationKindMismatch(plan DispatchPlan, existing ReviewRun) error {\n2257\t\tprior := plan.predecessor.RunID\n2258\t\tif plan.handoff {\n2259\t\t\tif existing.HandsOffFrom != prior || existing.Adapter != plan.Adapter {\n2260\t\t\t\treturn fmt.Errorf(\"pose: run %s was already continued by run %s\", prior, existing.RunID)\n2261\t\t\t}\n2262\t\t\treturn nil\n2263\t\t}\n2264\t\tif existing.HandsOffFrom == prior {\n2265\t\t\treturn fmt.Errorf(\"pose: run %s was handed off to run %s; it is not resumed\", prior, existing.RunID)\n2266\t\t}\n2267\t\treturn nil\n2268\t}\n2269\t\n2270\t// beforeContinuationTake and beforeContinuationClaim let a test make another\n2271\t// continuation win between the replan and the take, or between the take and\n2272\t// the claim (review round 1, N2).\n2273\tvar (\n2274\t\tbeforeContinuationTake  = func() {}\n2275\t\tbeforeContinuationClaim = func() {}\n2276\t)\n2277\t\n2278\t// continuationRecorded carries a continuation another resume already ended,\n2279\t// so the dispatch returns it as the recorded result.\n2280\ttype continuationRecorded struct{ run ReviewRun }\n2281\t\n2282\tfunc (c *continuationRecorded) Error() string {\n2283\t\treturn \"the continuation was already recorded as run \" + c.run.RunID\n2284\t}\n2285\t\n2286\t// awaitContinuationClaim waits briefly for another resume's claim on prior's\n2287\t// continuation. It returns the recorded continuation when one has ended, the\n2288\t// pending one while it runs, or neither when no claim appears. It reads the\n2289\t// ledger only once a claim file is there, and stops when ctx ends (spec\n2290\t// pose-review-resume-residuals R1).\n2291\tfunc (s Store) awaitContinuationClaim(ctx context.Context, prior ReviewRun) (*ReviewRun, *PendingReviewContinuation) {\n2292\t\tclaim := filepath.Join(s.Root, continuationPath(prior.RunID, false))\n2293\t\tfor i := 0; i < 20; i++ {\n2294\t\t\tif _, err := os.Lstat(claim); err == nil {\n2295\t\t\t\tif runs, _, err := s.ReadReviewRuns(\"\"); err == nil {\n2296\t\t\t\t\texisting, e := s.existingReviewContinuation(prior, runs)\n2297\t\t\t\t\tvar pending *PendingReviewContinuation\n2298\t\t\t\t\tif errors.As(e, &pending) {\n2299\t\t\t\t\t\treturn nil, pending\n2300\t\t\t\t\t}\n2301\t\t\t\t\tif e == nil && existing != nil {\n2302\t\t\t\t\t\treturn existing, nil\n2303\t\t\t\t\t}\n2304\t\t\t\t}\n2305\t\t\t}\n2306\t\t\tselect {\n2307\t\t\tcase <-ctx.Done():\n2308\t\t\t\treturn nil, nil\n2309\t\t\tcase <-time.After(100 * time.Millisecond):\n2310\t\t\t}\n2311\t\t}\n2312\t\treturn nil, nil\n2313\t}\n2314\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"e2aaf791-479c-417d-ad46-3ebede457aa1","timestamp":"2026-11-28T00:20:37.097Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-668ca2f6e0/worktree/pose-mcp/internal/pose/review_dispatch.go","content":"\treturn nil\n}\n\n// takeContinuationRuntimeDir creates the attempt's runtime directory for a\n// continuation before its claim. When the directory is there, a claim that\n// appears meanwhile means another resume holds it: the continuation is\n// pending. Otherwise the directory belongs to no run of the attempt, and the\n// resume is refused with nothing claimed.\nfunc (s Store) takeContinuationRuntimeDir(ctx context.Context, plan DispatchPlan) (string, error) {\n\tsource := runtimeSourceOf(*plan.predecessor)\n\tif _, ok := reviewRunRuntimeDirPath(source); !ok {\n\t\treturn \"\", nil\n\t}\n\tdir, err := reviewRunRuntimeDir(source)\n\tif err == nil {\n\t\treturn dir, nil\n\t}\n\tif !errors.Is(err, fs.ErrExist) {\n\t\treturn \"\", err\n\t}\n\t// The resume that took it claims right after; look for that claim.\n\texisting, pending := s.awaitContinuationClaim(ctx, *plan.predecessor)\n\tif pending != nil {\n\t\treturn \"\", pending\n\t}\n\tif existing != nil {\n\t\tif why := continuationKindMismatch(plan, *existing); why != nil {\n\t\t\treturn \"\", why\n\t\t}\n\t\treturn \"\", &continuationRecorded{run: *existing}\n\t}\n\tif ctx.Err() != nil {\n\t\treturn \"\", ctx.Err()\n\t}\n\treturn \"\", err\n}\n\n// continuationKindMismatch refuses a recorded continuation of another kind\n// than plan's, as the plans do: a resume that met a handoff, or a handoff\n// that met a resume or another agent's handoff (spec\n// pose-review-resume-residuals, review round 1, N1).\nfunc continuationKindMismatch(plan DispatchPlan, existing ReviewRun) error {\n\tprior := plan.predecessor.RunID\n\tif plan.handoff {\n\t\tif existing.HandsOffFrom != prior || existing.Adapter != plan.Adapter {\n\t\t\treturn fmt.Errorf(\"pose: run %s was already continued by run %s\", prior, existing.RunID)\n\t\t}\n\t\treturn nil\n\t}\n\tif existing.HandsOffFrom == prior {\n\t\treturn fmt.Errorf(\"pose: run %s was handed off to run %s; it is not resumed\", prior, existing.RunID)\n\t}\n\treturn nil\n}\n\n// beforeContinuationTake and beforeContinuationClaim let a test make another\n// continuation win between the replan and the take, or between the take and\n// the claim (review round 1, N2).\nvar (\n\tbeforeContinuationTake  = func() {}\n\tbeforeContinuationClaim = func() {}\n)\n\n// continuationRecorded carries a continuation another resume already ended,\n// so the dispatch returns it as the recorded result.\ntype continuationRecorded struct{ run ReviewRun }\n\nfunc (c *continuationRecorded) Error() string {\n\treturn \"the continuation was already recorded as run \" + c.run.RunID\n}\n\n// awaitContinuationClaim waits briefly for another resume's claim on prior's\n// continuation. It returns the recorded continuation when one has ended, the\n// pending one while it runs, or neither when no claim appears. It reads the\n// ledger only once a claim file is there, and stops when ctx ends (spec\n// pose-review-resume-residuals R1).\nfunc (s Store) awaitContinuationClaim(ctx context.Context, prior ReviewRun) (*ReviewRun, *PendingReviewContinuation) {\n\tclaim := filepath.Join(s.Root, continuationPath(prior.RunID, false))\n\tfor i := 0; i < 20; i++ {\n\t\tif _, err := os.Lstat(claim); err == nil {\n\t\t\tif runs, _, err := s.ReadReviewRuns(\"\"); err == nil {\n\t\t\t\texisting, e := s.existingReviewContinuation(prior, runs)\n\t\t\t\tvar pending *PendingReviewContinuation\n\t\t\t\tif errors.As(e, &pending) {\n\t\t\t\t\treturn nil, pending\n\t\t\t\t}\n\t\t\t\tif e == nil && existing != nil {\n\t\t\t\t\treturn existing, nil\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn nil, nil\n\t\tcase <-time.After(100 * time.Millisecond):\n\t\t}\n\t}\n\treturn nil, nil\n}\n","numLines":100,"startLine":2215,"totalLines":2314}},"tool_result_meta":[{"id":"toolu_01P72gBYBxPTDNp7aRQwxz5b","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
