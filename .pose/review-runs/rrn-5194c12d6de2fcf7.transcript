{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015BzT1Njmioi34LXzVj82ZX","type":"tool_result","content":"679\t\n680\tfunc validProofDigest(value string) bool {\n681\t\treturn regexp.MustCompile(`^sha256:[0-9a-f]{64}$`).MatchString(value)\n682\t}\n683\t\n684\t// errReviewRunHistoryIncomplete is a run history that could not be read whole.\n685\tvar errReviewRunHistoryIncomplete = errors.New(\"run provenance history is incomplete\")\n686\t\n687\tfunc (s Store) verifyRunReviewReference(bundle ReviewBundle, att ReviewAttestation) (ReviewRunAssurance, error) {\n688\t\tif att.Run == nil {\n689\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"signed run reference is missing\")\n690\t\t}\n691\t\tvar assurance ReviewRunAssurance\n692\t\tvar e error\n693\t\tif s.runApprovalAsSealed(bundle) {\n694\t\t\tassurance, e = s.VerifyReviewRunProofAsSealed(att.Run.RunID, att.Run.ProofID)\n695\t\t} else {\n696\t\t\tassurance, e = s.VerifyReviewRunProof(att.Run.RunID, att.Run.ProofID)\n697\t\t}\n698\t\tif e != nil {\n699\t\t\treturn assurance, e\n700\t\t}\n701\t\trun, e := s.LoadProvenanceReviewRun(att.Run.RunID)\n702\t\tif e != nil {\n703\t\t\treturn assurance, e\n704\t\t}\n705\t\tif run.BundleID != bundle.BundleID || run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.Kind != ReviewBriefKindReview || run.Status != ReviewRunCompleted || !assurance.CompleteReview || att.Reviewer != assurance.Reviewer.Principal {\n706\t\t\treturn assurance, fmt.Errorf(\"attestation and referenced run context differ\")\n707\t\t}\n708\t\tattested, e1 := time.Parse(time.RFC3339Nano, att.AttestedAt)\n709\t\tended, e2 := time.Parse(time.RFC3339Nano, run.EndedAt)\n710\t\tissued, e3 := time.Parse(time.RFC3339Nano, assurance.ProofIssuedAt)\n711\t\tif e1 != nil || e2 != nil || e3 != nil || ended.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) || issued.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) {\n712\t\t\treturn assurance, fmt.Errorf(\"run-backed attestation predates its completed run or authenticated run proof\")\n713\t\t}\n714\t\tdraft := draftReviewDecision(run.Output)\n715\t\tapproval := att.Decision == \"approved\" || att.Decision == \"approved-with-reservations\"\n716\t\tif approval && draft != \"approved\" {\n717\t\t\treturn assurance, fmt.Errorf(\"run draft does not support an approval: decision is %s\", draft)\n718\t\t}\n719\t\tif approval {\n720\t\t\t// A draft that does not account for the previous round is never an\n721\t\t\t// approval, whatever its decision line says (spec\n722\t\t\t// pose-delegated-review-round-protocol R4, R9, D2).\n723\t\t\tround, err := s.ReviewRoundOf(bundle)\n724\t\t\tif err != nil {\n725\t\t\t\treturn assurance, err\n726\t\t\t}\n727\t\t\tif problems := ValidateRoundDraft(round, run.Output); len(problems) > 0 {\n728\t\t\t\treturn assurance, fmt.Errorf(\"the run's draft is invalid for round %d: %s\", round.Number, strings.Join(problems, \"; \"))\n729\t\t\t}\n730\t\t}\n731\t\tif !approval && (draft != \"rejected\" && draft != \"changes-requested\") {\n732\t\t\treturn assurance, fmt.Errorf(\"run draft does not support a rejecting attestation: decision is %s\", draft)\n733\t\t}\n734\t\tif why := runConclusionDiffers(run, bundle, att); why != \"\" {\n735\t\t\treturn assurance, fmt.Errorf(\"the attestation does not state the run's conclusion: %s\", why)\n736\t\t}\n737\t\tif att.Authority == nil || att.Authority.Role != \"agent\" || att.Authority.ReviewExecution != run.RunID || att.Authority.ImplementationPrincipal != assurance.Implementation.Principal || att.Authority.ImplementationExecution != assurance.Implementation.Execution {\n738\t\t\treturn assurance, fmt.Errorf(\"attestation authority differs from run provenance\")\n739\t\t}\n740\t\tif assurance.Implementation.Execution == run.RunID {\n741\t\t\treturn assurance, fmt.Errorf(\"implementation and review executions are the same\")\n742\t\t}\n743\t\tif bundle.Payload.Plan.Independence == \"different-actor\" && !assurance.VendorDifference && !assurance.ModelDifference {\n744\t\t\treturn assurance, fmt.Errorf(\"reviewer vendor and model both match the implementation\")\n745\t\t}\n746\t\tif bundle.Payload.Plan.Independence == \"mandatory-human\" {\n747\t\t\treturn assurance, fmt.Errorf(\"machine-attested run cannot satisfy mandatory-human\")\n748\t\t}\n749\t\treturn assurance, nil\n750\t}\n751\tfunc (s Store) runBackedReviewBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n752\t\tblockers := s.verifiedAuthorityBlockers(bundle, att)\n753\t\tif _, e := s.verifyRunReviewReference(bundle, att); e != nil {\n754\t\t\tblockers = append(blockers, e.Error())\n755\t\t}\n756\t\treturn uniqueSorted(blockers)\n757\t}\n758\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"3d847571-d93a-493a-ad7c-abf87b84bbce","timestamp":"2026-11-11T23:00:35.017Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3822717051/worktree/pose-mcp/internal/pose/review_run_provenance.go","content":"\nfunc validProofDigest(value string) bool {\n\treturn regexp.MustCompile(`^sha256:[0-9a-f]{64}$`).MatchString(value)\n}\n\n// errReviewRunHistoryIncomplete is a run history that could not be read whole.\nvar errReviewRunHistoryIncomplete = errors.New(\"run provenance history is incomplete\")\n\nfunc (s Store) verifyRunReviewReference(bundle ReviewBundle, att ReviewAttestation) (ReviewRunAssurance, error) {\n\tif att.Run == nil {\n\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"signed run reference is missing\")\n\t}\n\tvar assurance ReviewRunAssurance\n\tvar e error\n\tif s.runApprovalAsSealed(bundle) {\n\t\tassurance, e = s.VerifyReviewRunProofAsSealed(att.Run.RunID, att.Run.ProofID)\n\t} else {\n\t\tassurance, e = s.VerifyReviewRunProof(att.Run.RunID, att.Run.ProofID)\n\t}\n\tif e != nil {\n\t\treturn assurance, e\n\t}\n\trun, e := s.LoadProvenanceReviewRun(att.Run.RunID)\n\tif e != nil {\n\t\treturn assurance, e\n\t}\n\tif run.BundleID != bundle.BundleID || run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.Kind != ReviewBriefKindReview || run.Status != ReviewRunCompleted || !assurance.CompleteReview || att.Reviewer != assurance.Reviewer.Principal {\n\t\treturn assurance, fmt.Errorf(\"attestation and referenced run context differ\")\n\t}\n\tattested, e1 := time.Parse(time.RFC3339Nano, att.AttestedAt)\n\tended, e2 := time.Parse(time.RFC3339Nano, run.EndedAt)\n\tissued, e3 := time.Parse(time.RFC3339Nano, assurance.ProofIssuedAt)\n\tif e1 != nil || e2 != nil || e3 != nil || ended.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) || issued.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) {\n\t\treturn assurance, fmt.Errorf(\"run-backed attestation predates its completed run or authenticated run proof\")\n\t}\n\tdraft := draftReviewDecision(run.Output)\n\tapproval := att.Decision == \"approved\" || att.Decision == \"approved-with-reservations\"\n\tif approval && draft != \"approved\" {\n\t\treturn assurance, fmt.Errorf(\"run draft does not support an approval: decision is %s\", draft)\n\t}\n\tif approval {\n\t\t// A draft that does not account for the previous round is never an\n\t\t// approval, whatever its decision line says (spec\n\t\t// pose-delegated-review-round-protocol R4, R9, D2).\n\t\tround, err := s.ReviewRoundOf(bundle)\n\t\tif err != nil {\n\t\t\treturn assurance, err\n\t\t}\n\t\tif problems := ValidateRoundDraft(round, run.Output); len(problems) > 0 {\n\t\t\treturn assurance, fmt.Errorf(\"the run's draft is invalid for round %d: %s\", round.Number, strings.Join(problems, \"; \"))\n\t\t}\n\t}\n\tif !approval && (draft != \"rejected\" && draft != \"changes-requested\") {\n\t\treturn assurance, fmt.Errorf(\"run draft does not support a rejecting attestation: decision is %s\", draft)\n\t}\n\tif why := runConclusionDiffers(run, bundle, att); why != \"\" {\n\t\treturn assurance, fmt.Errorf(\"the attestation does not state the run's conclusion: %s\", why)\n\t}\n\tif att.Authority == nil || att.Authority.Role != \"agent\" || att.Authority.ReviewExecution != run.RunID || att.Authority.ImplementationPrincipal != assurance.Implementation.Principal || att.Authority.ImplementationExecution != assurance.Implementation.Execution {\n\t\treturn assurance, fmt.Errorf(\"attestation authority differs from run provenance\")\n\t}\n\tif assurance.Implementation.Execution == run.RunID {\n\t\treturn assurance, fmt.Errorf(\"implementation and review executions are the same\")\n\t}\n\tif bundle.Payload.Plan.Independence == \"different-actor\" && !assurance.VendorDifference && !assurance.ModelDifference {\n\t\treturn assurance, fmt.Errorf(\"reviewer vendor and model both match the implementation\")\n\t}\n\tif bundle.Payload.Plan.Independence == \"mandatory-human\" {\n\t\treturn assurance, fmt.Errorf(\"machine-attested run cannot satisfy mandatory-human\")\n\t}\n\treturn assurance, nil\n}\nfunc (s Store) runBackedReviewBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n\tblockers := s.verifiedAuthorityBlockers(bundle, att)\n\tif _, e := s.verifyRunReviewReference(bundle, att); e != nil {\n\t\tblockers = append(blockers, e.Error())\n\t}\n\treturn uniqueSorted(blockers)\n}\n","numLines":80,"startLine":679,"totalLines":934}},"tool_result_meta":[{"id":"toolu_015BzT1Njmioi34LXzVj82ZX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
