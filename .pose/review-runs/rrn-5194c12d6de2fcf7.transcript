{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JPj2yRmUx8E9xVHaRSY2YC","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\t\"testing\"\n8\t\t\"time\"\n9\t)\n10\t\n11\t// Spec pose-delegated-approval-survives-routine-drift.\n12\t\n13\t// approvedByARunThenDone approves the fixture's scope by a delegated run, concludes the\n14\t// run, and marks the spec done: the state of every spec closed by a delegated review.\n15\tfunc approvedByARunThenDone(t *testing.T) (runProvenanceFixture, ReviewRun) {\n16\t\tt.Helper()\n17\t\tf, draftPath := conclusionFixture(t)\n18\t\tatt := approvedBundleAttestation(f.bundle, \"agent:reviewer\")\n19\t\tif err := os.WriteFile(draftPath, []byte(draftFrom(t, att, nil)), 0o600); err != nil {\n20\t\t\tt.Fatal(err)\n21\t\t}\n22\t\trun := dispatchConclusion(t, f, \"a run-backed approval\")\n23\t\tif conclusion, err := f.store.ConcludeReviewRun(run.RunID, f.key.Name, true, time.Now()); err != nil || conclusion.State != ReviewConclusionRecorded || conclusion.Attestation == \"\" {\n24\t\t\tt.Fatalf(\"conclusion: %+v %v\", conclusion, err)\n25\t\t}\n26\t\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || !verification.Approved {\n27\t\t\tt.Fatalf(\"the run-backed approval does not verify before the scope is done: %+v %v\", verification.Blockers, err)\n28\t\t}\n29\t\tfor _, kv := range [][]string{{\"user.name\", \"fixture\"}, {\"user.email\", \"fixture@example.invalid\"}, {\"commit.gpgsign\", \"false\"}} {\n30\t\t\tfederatedTestGit(t, f.store.Root, \"config\", kv[0], kv[1])\n31\t\t}\n32\t\tspec := filepath.Join(f.store.Root, \".pose/specs/backend/spec.md\")\n33\t\traw, err := os.ReadFile(spec)\n34\t\tif err != nil {\n35\t\t\tt.Fatal(err)\n36\t\t}\n37\t\tif err := os.WriteFile(spec, []byte(strings.Replace(string(raw), \"status: in-progress\", \"status: done\", 1)), 0o644); err != nil {\n38\t\t\tt.Fatal(err)\n39\t\t}\n40\t\tfederatedTestGit(t, f.store.Root, \"add\", \"--all\")\n41\t\tfederatedTestGit(t, f.store.Root, \"commit\", \"-q\", \"-m\", \"done\")\n42\t\treturn f, run\n43\t}\n44\t\n45\t// R1: a done scope keeps the approval a delegated run backed, when a file of its subject\n46\t// changed afterwards: the same retention a person's attestation already had.\n47\tfunc TestADelegatedApprovalSurvivesRoutineDriftOfADoneScope(t *testing.T) {\n48\t\tf, _ := approvedByARunThenDone(t)\n49\t\tcommitReviewFixture(t, f.store.Root, \"false\") // a later change to a file the review sealed\n50\t\tverification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref)\n51\t\tif err != nil {\n52\t\t\tt.Fatal(err)\n53\t\t}\n54\t\tif !verification.Approved || verification.State != \"closed\" {\n55\t\t\tt.Fatalf(\"a done scope lost its delegated approval to routine drift: state=%s blockers=%v\", verification.State, verification.Blockers)\n56\t\t}\n57\t\tif !strings.Contains(strings.Join(verification.Warnings, \" \"), retainedCompletedReviewWarning) {\n58\t\t\tt.Fatalf(\"the retained approval is not disclosed as retained: %v\", verification.Warnings)\n59\t\t}\n60\t}\n61\t\n62\t// R3: an open scope keeps the live rule: the approval of a delegated run does not survive a\n63\t// change to what it sealed until the scope is done.\n64\tfunc TestADelegatedApprovalOfAnOpenScopeDoesNotSurviveDrift(t *testing.T) {\n65\t\tf, draftPath := conclusionFixture(t)\n66\t\tatt := approvedBundleAttestation(f.bundle, \"agent:reviewer\")\n67\t\tif err := os.WriteFile(draftPath, []byte(draftFrom(t, att, nil)), 0o600); err != nil {\n68\t\t\tt.Fatal(err)\n69\t\t}\n70\t\trun := dispatchConclusion(t, f, \"an open scope\")\n71\t\tif conclusion, err := f.store.ConcludeReviewRun(run.RunID, f.key.Name, true, time.Now()); err != nil || conclusion.Attestation == \"\" {\n72\t\t\tt.Fatalf(\"conclusion: %+v %v\", conclusion, err)\n73\t\t}\n74\t\tfor _, kv := range [][]string{{\"user.name\", \"fixture\"}, {\"user.email\", \"fixture@example.invalid\"}, {\"commit.gpgsign\", \"false\"}} {\n75\t\t\tfederatedTestGit(t, f.store.Root, \"config\", kv[0], kv[1])\n76\t\t}\n77\t\tcommitReviewFixture(t, f.store.Root, \"false\")\n78\t\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || verification.Approved {\n79\t\t\tt.Fatalf(\"an open scope kept a delegated approval over a change to its subject: %+v %v\", verification, err)\n80\t\t}\n81\t}\n82\t\n83\t// R4: what the record says still binds. A run whose transcript was altered, or whose issuer\n84\t// no longer holds its pin, does not keep its approval, drift or none.\n85\tfunc TestARetainedDelegatedApprovalRefusesATamperedTranscript(t *testing.T) {\n86\t\tf, run := approvedByARunThenDone(t)\n87\t\tcommitReviewFixture(t, f.store.Root, \"false\")\n88\t\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || !verification.Approved {\n89\t\t\tt.Fatalf(\"the approval must be retained before it is tampered with, or this test proves nothing: %+v %v\", verification.Blockers, err)\n90\t\t}\n91\t\tpath := filepath.Join(f.store.Root, filepath.FromSlash(run.TranscriptPath))\n92\t\traw, err := os.ReadFile(path)\n93\t\tif err != nil {\n94\t\t\tt.Fatal(err)\n95\t\t}\n96\t\tif err := os.WriteFile(path, append(raw, []byte(\"\\n{\\\"tampered\\\":true}\\n\")...), 0o600); err != nil {\n97\t\t\tt.Fatal(err)\n98\t\t}\n99\t\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || verification.Approved {\n100\t\t\tt.Fatalf(\"an approval was retained over an altered transcript: %+v %v\", verification.Blockers, err)\n101\t\t}\n102\t}\n103\t\n104\tfunc TestARetainedDelegatedApprovalRefusesARevokedIssuer(t *testing.T) {\n105\t\tf, _ := approvedByARunThenDone(t)\n106\t\tcommitReviewFixture(t, f.store.Root, \"false\")\n107\t\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || !verification.Approved {\n108\t\t\tt.Fatalf(\"the approval must be retained before it is tampered with, or this test proves nothing: %+v %v\", verification.Blockers, err)\n109\t\t}\n110\t\tpolicyPath := filepath.Join(f.store.Root, \".pose/policy/review.json\")\n111\t\traw, err := os.ReadFile(policyPath)\n112\t\tif err != nil {\n113\t\t\tt.Fatal(err)\n114\t\t}\n115\t\trevoked := strings.Replace(string(raw), f.key.Pin(), \"ed25519:revoked\", 1)\n116\t\tif revoked == string(raw) {\n117\t\t\tt.Fatal(\"the fixture policy does not pin the issuer\")\n118\t\t}\n119\t\tif err := os.WriteFile(policyPath, []byte(revoked), 0o644); err != nil {\n120\t\t\tt.Fatal(err)\n121\t\t}\n122\t\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || verification.Approved {\n123\t\t\tt.Fatalf(\"an approval was retained after its issuer lost its pin: %+v %v\", verification.Blockers, err)\n124\t\t}\n125\t}\n126\t\n127\t// R6: the assurance read for a retained approval is the one of the sealed run, verified.\n128\tfunc TestTheAssuranceOfARetainedDelegatedApprovalIsVerified(t *testing.T) {\n129\t\tf, _ := approvedByARunThenDone(t)\n130\t\tcommitReviewFixture(t, f.store.Root, \"false\")\n131\t\tverification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref)\n132\t\tif err != nil || !verification.Approved || verification.Bundle == nil || verification.Attestation == nil {\n133\t\t\tt.Fatalf(\"the approval is not retained: %+v %v\", verification.Blockers, err)\n134\t\t}\n135\t\tassurance := f.store.DescribeReviewAssurance(*verification.Bundle, verification.Attestation)\n136\t\tif assurance.ReviewerIdentity != ReviewRunMachineAttested || assurance.Run == nil {\n137\t\t\tt.Fatalf(\"the assurance of a retained delegated approval is not the sealed run's: %+v\", assurance)"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"7baf4952-ccdf-4322-b99e-59057646b5e3","timestamp":"2026-11-11T23:01:09.685Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3822717051/worktree/pose-mcp/internal/pose/retained_run_approval_test.go","content":"package pose\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// Spec pose-delegated-approval-survives-routine-drift.\n\n// approvedByARunThenDone approves the fixture's scope by a delegated run, concludes the\n// run, and marks the spec done: the state of every spec closed by a delegated review.\nfunc approvedByARunThenDone(t *testing.T) (runProvenanceFixture, ReviewRun) {\n\tt.Helper()\n\tf, draftPath := conclusionFixture(t)\n\tatt := approvedBundleAttestation(f.bundle, \"agent:reviewer\")\n\tif err := os.WriteFile(draftPath, []byte(draftFrom(t, att, nil)), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trun := dispatchConclusion(t, f, \"a run-backed approval\")\n\tif conclusion, err := f.store.ConcludeReviewRun(run.RunID, f.key.Name, true, time.Now()); err != nil || conclusion.State != ReviewConclusionRecorded || conclusion.Attestation == \"\" {\n\t\tt.Fatalf(\"conclusion: %+v %v\", conclusion, err)\n\t}\n\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || !verification.Approved {\n\t\tt.Fatalf(\"the run-backed approval does not verify before the scope is done: %+v %v\", verification.Blockers, err)\n\t}\n\tfor _, kv := range [][]string{{\"user.name\", \"fixture\"}, {\"user.email\", \"fixture@example.invalid\"}, {\"commit.gpgsign\", \"false\"}} {\n\t\tfederatedTestGit(t, f.store.Root, \"config\", kv[0], kv[1])\n\t}\n\tspec := filepath.Join(f.store.Root, \".pose/specs/backend/spec.md\")\n\traw, err := os.ReadFile(spec)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(spec, []byte(strings.Replace(string(raw), \"status: in-progress\", \"status: done\", 1)), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfederatedTestGit(t, f.store.Root, \"add\", \"--all\")\n\tfederatedTestGit(t, f.store.Root, \"commit\", \"-q\", \"-m\", \"done\")\n\treturn f, run\n}\n\n// R1: a done scope keeps the approval a delegated run backed, when a file of its subject\n// changed afterwards: the same retention a person's attestation already had.\nfunc TestADelegatedApprovalSurvivesRoutineDriftOfADoneScope(t *testing.T) {\n\tf, _ := approvedByARunThenDone(t)\n\tcommitReviewFixture(t, f.store.Root, \"false\") // a later change to a file the review sealed\n\tverification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !verification.Approved || verification.State != \"closed\" {\n\t\tt.Fatalf(\"a done scope lost its delegated approval to routine drift: state=%s blockers=%v\", verification.State, verification.Blockers)\n\t}\n\tif !strings.Contains(strings.Join(verification.Warnings, \" \"), retainedCompletedReviewWarning) {\n\t\tt.Fatalf(\"the retained approval is not disclosed as retained: %v\", verification.Warnings)\n\t}\n}\n\n// R3: an open scope keeps the live rule: the approval of a delegated run does not survive a\n// change to what it sealed until the scope is done.\nfunc TestADelegatedApprovalOfAnOpenScopeDoesNotSurviveDrift(t *testing.T) {\n\tf, draftPath := conclusionFixture(t)\n\tatt := approvedBundleAttestation(f.bundle, \"agent:reviewer\")\n\tif err := os.WriteFile(draftPath, []byte(draftFrom(t, att, nil)), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trun := dispatchConclusion(t, f, \"an open scope\")\n\tif conclusion, err := f.store.ConcludeReviewRun(run.RunID, f.key.Name, true, time.Now()); err != nil || conclusion.Attestation == \"\" {\n\t\tt.Fatalf(\"conclusion: %+v %v\", conclusion, err)\n\t}\n\tfor _, kv := range [][]string{{\"user.name\", \"fixture\"}, {\"user.email\", \"fixture@example.invalid\"}, {\"commit.gpgsign\", \"false\"}} {\n\t\tfederatedTestGit(t, f.store.Root, \"config\", kv[0], kv[1])\n\t}\n\tcommitReviewFixture(t, f.store.Root, \"false\")\n\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || verification.Approved {\n\t\tt.Fatalf(\"an open scope kept a delegated approval over a change to its subject: %+v %v\", verification, err)\n\t}\n}\n\n// R4: what the record says still binds. A run whose transcript was altered, or whose issuer\n// no longer holds its pin, does not keep its approval, drift or none.\nfunc TestARetainedDelegatedApprovalRefusesATamperedTranscript(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tcommitReviewFixture(t, f.store.Root, \"false\")\n\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || !verification.Approved {\n\t\tt.Fatalf(\"the approval must be retained before it is tampered with, or this test proves nothing: %+v %v\", verification.Blockers, err)\n\t}\n\tpath := filepath.Join(f.store.Root, filepath.FromSlash(run.TranscriptPath))\n\traw, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(path, append(raw, []byte(\"\\n{\\\"tampered\\\":true}\\n\")...), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || verification.Approved {\n\t\tt.Fatalf(\"an approval was retained over an altered transcript: %+v %v\", verification.Blockers, err)\n\t}\n}\n\nfunc TestARetainedDelegatedApprovalRefusesARevokedIssuer(t *testing.T) {\n\tf, _ := approvedByARunThenDone(t)\n\tcommitReviewFixture(t, f.store.Root, \"false\")\n\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || !verification.Approved {\n\t\tt.Fatalf(\"the approval must be retained before it is tampered with, or this test proves nothing: %+v %v\", verification.Blockers, err)\n\t}\n\tpolicyPath := filepath.Join(f.store.Root, \".pose/policy/review.json\")\n\traw, err := os.ReadFile(policyPath)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\trevoked := strings.Replace(string(raw), f.key.Pin(), \"ed25519:revoked\", 1)\n\tif revoked == string(raw) {\n\t\tt.Fatal(\"the fixture policy does not pin the issuer\")\n\t}\n\tif err := os.WriteFile(policyPath, []byte(revoked), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || verification.Approved {\n\t\tt.Fatalf(\"an approval was retained after its issuer lost its pin: %+v %v\", verification.Blockers, err)\n\t}\n}\n\n// R6: the assurance read for a retained approval is the one of the sealed run, verified.\nfunc TestTheAssuranceOfARetainedDelegatedApprovalIsVerified(t *testing.T) {\n\tf, _ := approvedByARunThenDone(t)\n\tcommitReviewFixture(t, f.store.Root, \"false\")\n\tverification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref)\n\tif err != nil || !verification.Approved || verification.Bundle == nil || verification.Attestation == nil {\n\t\tt.Fatalf(\"the approval is not retained: %+v %v\", verification.Blockers, err)\n\t}\n\tassurance := f.store.DescribeReviewAssurance(*verification.Bundle, verification.Attestation)\n\tif assurance.ReviewerIdentity != ReviewRunMachineAttested || assurance.Run == nil {\n\t\tt.Fatalf(\"the assurance of a retained delegated approval is not the sealed run's: %+v\", assurance)","numLines":137,"startLine":1,"totalLines":187}},"tool_result_meta":[{"id":"toolu_01JPj2yRmUx8E9xVHaRSY2YC","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
