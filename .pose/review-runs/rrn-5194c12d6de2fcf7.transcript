13\t\tvar conflict *PublishConflictError\n314\t\tif errors.As(err, &conflict) {\n315\t\t\texisting, why := s.verifiedVerdictProof(run.Kind, run.RunID)\n316\t\t\tif existing == \"\" {\n317\t\t\t\treturn \"\", \"\", fmt.Errorf(\"pose: %s holds a record that is not this run's verdict: %s\", rel, why)\n318\t\t\t}\n319\t\t\treturn rel, existing, nil\n320\t\t}\n321\t\treturn rel, proofID, err\n322\t}\n323\t\n324\t// verifiedVerdict is what a verified verdict record of a run says about\n325\t// itself, for a conclusion completed from it.\n326\ttype verifiedVerdict struct {\n327\t\tProofID, Issuer, BundleID, Scope, Decision string\n328\t}\n329\t\n330\t// verifiedVerdictOf is the verified verdict record of run, if any.\n331\tfunc (s Store) verifiedVerdictOf(kind, runID string) (*verifiedVerdict, string) {\n332\t\tproof, why := s.verifiedVerdictProof(kind, runID)\n333\t\tif proof == \"\" {\n334\t\t\treturn nil, why\n335\t\t}\n336\t\trun, err := s.LoadProvenanceReviewRun(runID)\n337\t\tif err != nil {\n338\t\t\treturn nil, err.Error()\n339\t\t}\n340\t\tdraft, _ := ParseReviewDraft(run.Output)\n341\t\tif draft == nil {\n342\t\t\treturn nil, \"the run's draft cannot be read\"\n343\t\t}\n344\t\tissuer := \"\"\n345\t\tif assurance, err := s.VerifyReviewRunProofForReading(runID, proof); err == nil {\n346\t\t\tissuer = assurance.Issuer\n347\t\t}\n348\t\treturn &verifiedVerdict{ProofID: proof, Issuer: issuer, BundleID: run.BundleID, Scope: run.Scope, Decision: draft.Decision}, \"\"\n349\t}\n350\t\n351\t// errVerdictDestinationBusy is a verdict that could not be published because\n352\t// the spec's lifecycle lock is held: the conclusion stays reserved, never\n353\t// refused, and a later conclusion of the run publishes it (review round 3,\n354\t// R3-B01).\n355\tvar errVerdictDestinationBusy = errors.New(\"the spec's lifecycle lock is held\")\n356\t\n357\t// lockSpecLifecycleWaiting holds slug's lifecycle lock, waiting while a\n358\t// running operation holds it. A lock whose owner is dead or unknown is not\n359\t// waited for: it names how to recover it.\n360\tfunc lockSpecLifecycleWaiting(root, slug, operation string) (func(), error) {\n361\t\tdeadline := time.Now().Add(reviewConclusionLockWait)\n362\t\tfor {\n363\t\t\tunlock, err := LockSpecLifecycle(root, slug, operation)\n364\t\t\tvar held *StartLockError\n365\t\t\tif err == nil || !errors.As(err, &held) {\n366\t\t\t\treturn unlock, err\n367\t\t\t}\n368\t\t\tif held.State != LockOwnerActive {\n369\t\t\t\treturn nil, fmt.Errorf(\"%w by an owner that is %s; recover it with pose start spec:%s --recover-lock %s, then conclude the run again\", errVerdictDestinationBusy, held.State, slug, held.OwnerDigest)\n370\t\t\t}\n371\t\t\tif time.Now().After(deadline) {\n372\t\t\t\treturn nil, fmt.Errorf(\"%w by a running operation; conclude the run again when it ends\", errVerdictDestinationBusy)\n373\t\t\t}\n374\t\t\ttime.Sleep(100 * time.Millisecond)\n375\t\t}\n376\t}\n377\t\n378\t// verifiedVerdictProof is the proof the verdict record of run names, when\n379\t// that record verifies as the run's verdict; otherwise \"\" and why.\n380\tfunc (s Store) verifiedVerdictProof(kind, runID string) (string, string) {\n381\t\tswitch kind {\n382\t\tcase ReviewBriefKindAdjudication:\n383\t\t\traw, err := readBoundedRegularIn(s.fsys(), filepath.Join(s.Root, filepath.FromSlash(AdjudicationsDir), runID+\".json\"), 1<<20)\n384\t\t\tvar rec AdjudicationRecord\n385\t\t\tif err != nil || json.Unmarshal(raw, &rec) != nil {\n386\t\t\t\treturn \"\", \"the record cannot be read\"\n387\t\t\t}\n388\t\t\tadjudications, err := s.SpecAdjudications(rec.Spec)\n389\t\t\tif err != nil {\n390\t\t\t\treturn \"\", err.Error()\n391\t\t\t}\n392\t\t\tfor _, a := range adjudications {\n393\t\t\t\tif a.Record.RunID == runID {\n394\t\t\t\t\tif a.Verified {\n395\t\t\t\t\t\treturn rec.ProofID, \"\"\n396\t\t\t\t\t}\n397\t\t\t\t\treturn \"\", a.Why\n398\t\t\t\t}\n399\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"51e