ined\", ReviewLimitationIssuerTruthfulness, ReviewLimitationCognitive}}\n573\t}\n574\t\n575\t// VerifyReviewRunProofAsSealed verifies a signed run proof as the approval it backed was\n576\t// given: what the proof and the run record say, and that the record still stands (the run\n577\t// completed and complete, not superseded, the persisted record and the transcript intact,\n578\t// the bundle it reviewed readable with the digest it recorded). It does not ask whether the\n579\t// run still governs the repository as it is now, nor re-render the brief, nor compare the\n580\t// current adapter policy: those are the questions of a live scope, and a scope that is done\n581\t// keeps the approval it was closed with, as a person's attestation always has (spec\n582\t// pose-delegated-approval-survives-routine-drift). The issuer must still hold its pin.\n583\tfunc (s Store) VerifyReviewRunProofAsSealed(id, proofID string) (ReviewRunAssurance, error) {\n584\t\ts = s.reviewOperation()\n585\t\trun, e := s.LoadProvenanceReviewRun(id)\n586\t\tif e != nil {\n587\t\t\treturn ReviewRunAssurance{}, e\n588\t\t}\n589\t\trel, e := runProofPath(id, proofID)\n590\t\tif e != nil {\n591\t\t\treturn ReviewRunAssurance{}, e\n592\t\t}\n593\t\tvar proof ReviewRunProof\n594\t\tif e = readLedgerJSONIn(s.fsys(), filepath.Join(s.Root, rel), &proof); e != nil {\n595\t\t\treturn ReviewRunAssurance{}, e\n596\t\t}\n597\t\tif proof.ProofID != proofID {\n598\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run proof filename identity differs\")\n599\t\t}\n600\t\treturn s.verifyRunProofAsSealed(proof, run)\n601\t}\n602\t\n603\tfunc (s Store) verifyRunProofAsSealed(proof ReviewRunProof, run ReviewRun) (ReviewRunAssurance, error) {\n604\t\tfail := func(message string) (ReviewRunAssurance, error) {\n605\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run provenance: %s\", message)\n606\t\t}\n607\t\tif _, e := s.verifyRunProofCore(proof, run); e != nil {\n608\t\t\treturn ReviewRunAssurance{}, e\n609\t\t}\n610\t\tc, p := proof.Claim, run.Provenance\n611\t\tend, e := time.Parse(time.RFC3339Nano, run.EndedAt)\n612\t\tissued, e2 := time.Parse(time.RFC3339Nano, c.IssuedAt)\n613\t\tif e != nil || e2 != nil || issued.Before(end) {\n614\t\t\treturn fail(\"proof predates the ended run\")\n615\t\t}\n616\t\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n617\t\t\treturn fail(why)\n618\t\t}\n619\t\tbundle, e := s.LoadReviewBundle(run.BundleID)\n620\t\tif e != nil {\n621\t\t\treturn fail(\"the reviewed bundle cannot be read\")\n622\t\t}\n623\t\trecorded, recordErr := normalizeModelIdentity(ModelIdentity{Principal: p.Reviewer.Principal, Vendor: run.Vendor, Model: run.Model})\n624\t\tif recordErr != nil || recorded != p.Reviewer {\n625\t\t\treturn fail(\"reviewer identity differs or is unknown\")\n626\t\t}\n627\t\tif !validProofDigest(p.WorktreeDigest) {\n628\t\t\treturn fail(\"the origin worktree of the run is not recorded\")\n629\t\t}\n630\t\tswitch p.ExecutionState {\n631\t\tcase \"started\":\n632\t\t\tif !validProofDigest(p.ArgvDigest) || !validProofDigest(p.ExecutableDigest) || !validProofDigest(p.RawTranscriptDigest) || !validProofDigest(p.RawOutputDigest) {\n633\t\t\t\treturn fail(\"execution or original-byte digests missing\")\n634\t\t\t}\n635\t\t\tif p.WireComplete && (p.WireBytes < 0 || p.WireDigest != p.PlannedWireDigest) {\n636\t\t\t\treturn fail(\"complete stdin claim is inconsistent\")\n637\t\t\t}\n638\t\tcase \"not-started\":\n639\t\t\tif p.WireBytes != 0 || p.WireComplete || p.WireDigest != \"\" || run.Status == ReviewRunCompleted || run.Status == ReviewRunInterrupted {\n640\t\t\t\treturn fail(\"unstarted audit claims an executed or transmitted review\")\n641\t\t\t}\n642\t\tdefault:\n643\t\t\treturn fail(\"unknown execution observation\")\n644\t\t}\n645\t\tif run.Status == ReviewRunCompleted && (!p.WireComplete || !p.OutputComplete || strings.TrimSpace(run.Output) == \"\") {\n646\t\t\treturn fail(\"truncated or incomplete draft cannot establish completed review\")\n647\t\t}\n648\t\treturn runAssuranceFrom(run, proof, bundle, p.Implementation, p.Reviewer), nil\n649\t}\n650\t\n651\t// runApprovalAsSealed reports whether a run-backed approval of this bundle is verified as it\n652\t// was given: the scope it approved is done.\n653\tfunc (s Store) runApprovalAsSealed(bundle ReviewBundle) bool {\n654\t\tref, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n655\t\tif err != nil {\n656\t\t\treturn false\n657\t\t}\n658\t\tdone, err := s.scopeLifecycleDone(ref)\n659\t\treturn err == nil && done\n660\t}\n661\t\n662\t// VerifyReviewRunProofForReading verifies a signed run proof for a reader that reports on a\n663\t// run: as it was given when the scope the run reviewed is done, as it is now otherwise. It is\n664\t// the question the closeout asks (verifyRunReviewReference), so a reader and the closeout\n665\t// cannot disagree about one run (spec pose-verdict-readers-ask-the-sealed-question). On the\n666\t// sealed path the expiry of the proof is not asked: it bounds the window in which a proof may\n667\t// back a new attestation, and an attestation already given to a done scope stands.\n668\tfunc (s Store) VerifyReviewRunProofForReading(id, proofID string) (ReviewRunAssurance, error) {\n669\t\ts = s.reviewOperation()\n670\t\trun, e := s.LoadProvenanceReviewRun(id)\n671\t\tif e != nil {\n672\t\t\treturn ReviewRunAssurance{}, e\n673\t\t}\n674\t\tif bundle, e := s.LoadReviewBundle(run.BundleID); e == nil && s.runApprovalAsSealed(bundle) {\n675\t\t\treturn s.VerifyReviewRunProofAsSealed(id, proofID)\n676\t\t}\n677\t\treturn s.VerifyReviewRunProof(id, proofID)\n678\t}\n679\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"539a346a-0cfb-4c64-a33b-a40736eda755","timestamp":"2026-11-11T23:00:31.344Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3822717051/worktree/pose-mcp/internal/pose/review_run_provenance.go","content":"\t\t}\n\t\tbrief.Text += section\n\t}\n\tif e != nil ||