{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019agw2Aq7Dgyth8WXLWtzAz","type":"tool_result","content":"340\t\tproof.Signature = base64.StdEncoding.EncodeToString(ed25519.Sign(key.private, runProofSigningBytes(proof)))\n341\t\tproof.ProofID = runProofIdentity(proof)\n342\t\tif _, e = s.verifyRunProof(proof, run, now); e != nil {\n343\t\t\treturn ReviewRunProof{}, e\n344\t\t}\n345\t\tif apply {\n346\t\t\trel, e := runProofPath(run.RunID, proof.ProofID)\n347\t\t\tif e != nil {\n348\t\t\t\treturn ReviewRunProof{}, e\n349\t\t\t}\n350\t\t\tif e = publishLedgerJSON(s.Root, rel, proof); e != nil {\n351\t\t\t\treturn ReviewRunProof{}, e\n352\t\t\t}\n353\t\t}\n354\t\treturn proof, nil\n355\t}\n356\t\n357\tfunc (s Store) VerifyReviewRunProof(id, proofID string) (ReviewRunAssurance, error) {\n358\t\ts = s.reviewOperation()\n359\t\trun, e := s.LoadProvenanceReviewRun(id)\n360\t\tif e != nil {\n361\t\t\treturn ReviewRunAssurance{}, e\n362\t\t}\n363\t\trel, e := runProofPath(id, proofID)\n364\t\tif e != nil {\n365\t\t\treturn ReviewRunAssurance{}, e\n366\t\t}\n367\t\tif _, e = ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Dir(rel)), false); e != nil {\n368\t\t\treturn ReviewRunAssurance{}, e\n369\t\t}\n370\t\tvar proof ReviewRunProof\n371\t\tif e = readLedgerJSONIn(s.fsys(), filepath.Join(s.Root, rel), &proof); e != nil {\n372\t\t\treturn ReviewRunAssurance{}, e\n373\t\t}\n374\t\tif proof.ProofID != proofID {\n375\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run proof filename identity differs\")\n376\t\t}\n377\t\treturn s.verifyRunProof(proof, run, s.reviewClock())\n378\t}\n379\t\n380\t// VerifyReviewRunProofRecord verifies what a proof of run says about it —\n381\t// its signature under a pinned issuer, the project and audience, and the\n382\t// exact run record, output, transcript and provenance it binds — without\n383\t// asking whether the run still governs its scope or whether its adapter and\n384\t// brief are the current ones: a reader of a record kept after its scope\n385\t// moved on (spec pose-delegated-review-action-fulfillment, review round 1).\n386\tfunc (s Store) VerifyReviewRunProofRecord(id, proofID string) (string, error) {\n387\t\ts = s.reviewOperation()\n388\t\trun, e := s.LoadProvenanceReviewRun(id)\n389\t\tif e != nil {\n390\t\t\treturn \"\", e\n391\t\t}\n392\t\trel, e := runProofPath(id, proofID)\n393\t\tif e != nil {\n394\t\t\treturn \"\", e\n395\t\t}\n396\t\tvar proof ReviewRunProof\n397\t\tif e = readLedgerJSONIn(s.fsys(), filepath.Join(s.Root, rel), &proof); e != nil {\n398\t\t\treturn \"\", e\n399\t\t}\n400\t\tif proof.ProofID != proofID {\n401\t\t\treturn \"\", fmt.Errorf(\"run proof filename identity differs\")\n402\t\t}\n403\t\tif _, e := s.verifyRunProofCore(proof, run); e != nil {\n404\t\t\treturn \"\", e\n405\t\t}\n406\t\treturn proof.Issuer, nil\n407\t}\n408\t\n409\t// verifyRunProofCore is the part of a proof's verification that is about\n410\t// the proof and the run record alone.\n411\tfunc (s Store) verifyRunProofCore(proof ReviewRunProof, run ReviewRun) (ReviewPolicy, error) {\n412\t\tfail := func(message string) (ReviewPolicy, error) {\n413\t\t\treturn ReviewPolicy{}, fmt.Errorf(\"run provenance: %s\", message)\n414\t\t}\n415\t\tif proof.SchemaVersion != 1 || proof.Claim.SchemaVersion != 1 || proof.Algorithm != \"ed25519\" || proof.ProofID != runProofIdentity(proof) {\n416\t\t\treturn fail(\"unsupported or rewritten proof\")\n417\t\t}\n418\t\tpolicy, _, e := s.loadReviewPolicy()\n419\t\tif e != nil {\n420\t\t\treturn ReviewPolicy{}, e\n421\t\t}\n422\t\tif !reviewIssuerHoldsGrant(policy.TrustedAttestationIssuers, proof.Issuer, proof.PublicKey) {\n423\t\t\treturn fail(\"issuer is not trusted under current pins\")\n424\t\t}\n425\t\tpublic, e := base64.StdEncoding.DecodeString(proof.PublicKey)\n426\t\tif e != nil || len(public) != ed25519.PublicKeySize {\n427\t\t\treturn fail(\"invalid issuer key\")\n428\t\t}\n429\t\tsignature, e := base64.StdEncoding.DecodeString(proof.Signature)\n430\t\tif e != nil || !ed25519.Verify(public, runProofSigningBytes(proof), signature) {\n431\t\t\treturn fail(\"signature verification failed\")\n432\t\t}\n433\t\tc, p := proof.Claim, run.Provenance\n434\t\tif p == nil || p.SchemaVersion != 1 || run.LedgerVersion != 1 || p.Trust != \"executor-attested\" {\n435\t\t\treturn fail(\"captured executor provenance is absent\")\n436\t\t}\n437\t\tif err := s.runProvenanceProjectBinding(policy.AuthorityProject); err != nil {\n438\t\t\treturn ReviewPolicy{}, err\n439\t\t}\n440\t\tif c.Project != policy.AuthorityProject || c.Project != p.Project || c.Audience == \"\" || c.Audience != policy.AuthorityAudience || c.Audience != p.Audience {\n441\t\t\treturn fail(\"project or audience differs from protected policy\")\n442\t\t}\n443\t\tif c.RunID != run.RunID || c.RecordDigest != reviewRunCanonicalDigest(run) || c.BundleDigest != run.BundleDigest || c.Scope != run.Scope || c.Kind != run.Kind || c.AttemptID == \"\" || c.AttemptID != run.AttemptID || c.Resumes != run.Resumes || c.TranscriptDigest != run.TranscriptDigest || c.OutputDigest != digestBytes([]byte(run.Output)) {\n444\t\t\treturn fail(\"proof does not bind the exact run and output\")\n445\t\t}\n446\t\tsnapshot, _ := json.Marshal(p)\n447\t\tif c.ProvenanceDigest != digestBytes(snapshot) {\n448\t\t\treturn fail(\"captured provenance digest differs\")\n449\t\t}\n450\t\treturn policy, nil\n451\t}\n452\t\n453\tfunc (s Store) verifyRunProof(proof ReviewRunProof, run ReviewRun, now time.Time) (ReviewRunAssurance, error) {\n454\t\tfail := func(message string) (ReviewRunAssurance, error) {\n455\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run provenance: %s\", message)\n456\t\t}\n457\t\t_, e := s.verifyRunProofCore(proof, run)\n458\t\tif e != nil {\n459\t\t\treturn ReviewRunAssurance{}, e\n460\t\t}\n461\t\tc, p := proof.Claim, run.Provenance\n462\t\ttimes := &ReviewAuthorityClaim{IssuedAt: c.IssuedAt, ExpiresAt: c.ExpiresAt}\n463\t\tif blocked := reviewClaimTimeBlockers(times, now, 0); len(blocked) > 0 {\n464\t\t\treturn fail(strings.Join(blocked, \"; \"))\n465\t\t}\n466\t\tend, e := time.Parse(time.RFC3339Nano, run.EndedAt)\n467\t\tissued, e2 := time.Parse(time.RFC3339Nano, c.IssuedAt)\n468\t\tif e != nil || e2 != nil || issued.Before(end) {\n469\t\t\treturn fail(\"proof predates the ended run\")\n470\t\t}\n471\t\tif why := s.runProofContextConflict(run); why != \"\" {\n472\t\t\treturn fail(why)\n473\t\t}\n474\t\tconfig, found, e := s.LoadReviewersPolicyFor(run.Kind)\n475\t\tif e != nil || !found || config.Provenance == nil {\n476\t\t\treturn fail(\"current execution policy is missing\")\n477\t\t}\n478\t\tadapter, ok := config.Adapters[run.Adapter]\n479\t\tif !ok {\n480\t\t\treturn fail(\"current adapter is missing\")\n481\t\t}\n482\t\traw, _ := json.Marshal(adapter)\n483\t\tif p.ConfigDigest != digestBytes(raw) {\n484\t\t\treturn fail(\"adapter configuration differs\")\n485\t\t}\n486\t\tbundle, e := s.LoadReviewBundle(run.BundleID)\n487\t\tif e != nil {\n488\t\t\treturn fail(\"the reviewed bundle cannot be read\")\n489\t\t}\n490\t\timplementation, e := runImplementationIdentity(bundle, config.Provenance)\n491\t\tif e != nil || implementation != p.Implementation || config.Provenance.Trust != p.Trust {\n492\t\t\treturn fail(\"implementation baseline differs or is unknown\")\n493\t\t}\n494\t\treviewer, e := normalizeModelIdentity(ModelIdentity{Principal: adapter.Executor, Vendor: adapter.Vendor, Model: adapter.Model})\n495\t\trecorded, recordErr := normalizeModelIdentity(ModelIdentity{Principal: p.Reviewer.Principal, Vendor: run.Vendor, Model: run.Model})\n496\t\tif e != nil || recordErr != nil || recorded != reviewer || reviewer != p.Reviewer {\n497\t\t\treturn fail(\"reviewer identity differs or is unknown\")\n498\t\t}\n499\t\t// The worktree a run was dispatched from is recorded, not required of\n500\t\t// the reader: a run a CI job or Harne8's Conductor performed in its own\n501\t\t// checkout of the project verifies in any other, since the project, the\n502\t\t// audience, the sealed bundle and the brief it binds are the same there\n503\t\t// (spec pose-delegated-review-action-fulfillment R3, R9; the amendment\n504\t\t// of 2026-10-28 to the delegation ADR).\n505\t\tif !validProofDigest(p.WorktreeDigest) {\n506\t\t\treturn fail(\"the origin worktree of the run is not recorded\")\n507\t\t}\n508\t\tbrief, e := s.RenderReviewBriefMatching(run.BundleID, run.Kind, run.BriefNotes, run.BriefDigest)\n509\t\t// A handoff run was sent the brief and the section its predecessor's\n510\t\t// record yields; the verifier derives the same bytes (spec\n511\t\t// pose-delegation-handoff R4).\n512\t\tif e == nil && run.HandsOffFrom != \"\" {\n513\t\t\tprior, priorErr := s.LoadProvenanceReviewRun(run.HandsOffFrom)\n514\t\t\tif priorErr != nil {\n515\t\t\t\treturn fail(\"the handoff predecessor cannot be read\")\n516\t\t\t}\n517\t\t\tsection := s.recordedHandoffSection(run, prior)\n518\t\t\tif section == \"\" {\n519\t\t\t\treturn fail(\"handoff section differs from the predecessor's record\")\n520\t\t\t}\n521\t\t\tbrief.Text += section\n522\t\t}\n523\t\tif e != nil || brief.Digest != run.BriefDigest || p.PlannedWireDigest != digestBytes([]byte(brief.Text)) || p.TemplateVersion != brief.TemplateVersion || p.NotesDigest != digestBytes([]byte(run.BriefNotes)) {\n524\t\t\treturn fail(\"brief/template/notes/transmitted bytes differ\")\n525\t\t}\n526\t\tcommand := adapter.Command\n527\t\tif run.Resumes != \"\" || run.Thread.continued() {\n528\t\t\tif adapter.Resume == nil {\n529\t\t\t\treturn fail(\"resume configuration missing\")\n530\t\t\t}\n531\t\t\tcommand = adapter.Resume.Command\n532\t\t}\n533\t\traw, _ = json.Marshal(command)\n534\t\tif p.CommandTemplateDigest != digestBytes(raw) {\n535\t\t\treturn fail(\"command template differs\")\n536\t\t}\n537\t\tif p.WireBytes < 0 || p.WireBytes > int64(len(brief.Text)) {\n538\t\t\treturn fail(\"stdin byte count is outside the configured brief\")\n539\t\t}\n540\t\tswitch p.ExecutionState {\n541\t\tcase \"started\":\n542\t\t\tif !validProofDigest(p.ArgvDigest) || !validProofDigest(p.ExecutableDigest) || !validProofDigest(p.RawTranscriptDigest) || !validProofDigest(p.RawOutputDigest) {\n543\t\t\t\treturn fail(\"execution or original-byte digests missing\")\n544\t\t\t}\n545\t\t\tif p.WireDigest != digestBytes([]byte(brief.Text)[:int(p.WireBytes)]) {\n546\t\t\t\treturn fail(\"actual stdin digest differs from transmitted brief prefix\")\n547\t\t\t}\n548\t\t\tif p.WireComplete && (p.WireBytes != int64(len(brief.Text)) || p.WireDigest != p.PlannedWireDigest) {\n549\t\t\t\treturn fail(\"complete stdin claim is inconsistent\")\n550\t\t\t}\n551\t\tcase \"not-started\":\n552\t\t\tif p.WireBytes != 0 || p.WireComplete || p.WireDigest != \"\" || run.Status == ReviewRunCompleted || run.Status == ReviewRunInterrupted {\n553\t\t\t\treturn fail(\"unstarted audit claims an executed or transmitted review\")\n554\t\t\t}\n555\t\tdefault:\n556\t\t\treturn fail(\"unknown execution observation\")\n557\t\t}\n558\t\tif run.Status == ReviewRunCompleted && (!p.WireComplete || !p.OutputComplete || strings.TrimSpace(run.Output) == \"\") {\n559\t\t\treturn fail(\"truncated or incomplete draft cannot establish completed review\")\n560\t\t}\n561\t\treturn runAssuranceFrom(run, proof, bundle, implementation, reviewer), nil\n562\t}\n563\t\n564\t// runAssuranceFrom is what a verified run says about who reviewed and how independently.\n565\tfunc runAssuranceFrom(run ReviewRun, proof ReviewRunProof, bundle ReviewBundle, implementation, reviewer ModelIdentity) ReviewRunAssurance {\n566\t\tc, p := proof.Claim, run.Provenance\n567\t\tdecision := draftReviewDecision(run.Output)\n568\t\tsource := \"policy\"\n569\t\tif impl := bundle.Payload.Implementation; impl != nil {\n570\t\t\tsource = impl.Source\n571\t\t}\n572\t\treturn ReviewRunAssurance{IndependenceAchieved: AchievedIndependence(implementation.Vendor, implementation.Model, reviewer.Vendor, reviewer.Model), ImplementationSource: source, DraftDecision: decision, ProofIssuedAt: c.IssuedAt, ProofExpiresAt: c.ExpiresAt, State: run.Status, CompleteReview: run.Status == ReviewRunCompleted && p.WireComplete && p.OutputComplete && decision != \"unknown\" && len(run.DraftProblems) == 0, Assurance: ReviewRunMachineAttested, RunID: run.RunID, ProofID: proof.ProofID, Issuer: proof.Issuer, Reviewer: reviewer, Implementation: implementation, IdentitySource: \"native-issuer-signed-executor-declaration\", VendorDifference: AchievedIndependence(implementation.Vendor, implementation.Model, reviewer.Vendor, reviewer.Model) == IndependenceDifferentVendor, ModelDifference: knownIdentityPart(implementation.Model) && knownIdentityPart(reviewer.Model) && reviewer.Model != implementation.Model, OutputComplete: p.OutputComplete, Limitations: []string{\"executor-declaration-not-independent-vendor-receipt\", \"raw-bytes-hashed-by-executor-redacted-artifacts-retained\", ReviewLimitationIssuerTruthfulness, ReviewLimitationCognitive}}\n573\t}\n574\t\n575\t// VerifyReviewRunProofAsSealed verifies a signed run proof as the approval it backed was\n576\t// given: what the proof and the run record say, and that the record still stands (the run\n577\t// completed and complete, not superseded, the persisted record and the transcript intact,\n578\t// the bundle it reviewed readable with the digest it recorded). It does not ask whether the\n579\t// run still governs the repository as it is now, nor re-render the brief, nor compare the\n580\t// current adapter policy: those are the questions of a live scope, and a scope that is done\n581\t// keeps the approval it was closed with, as a person's attestation always has (spec\n582\t// pose-delegated-approval-survives-routine-drift). The issuer must still hold its pin.\n583\tfunc (s Store) VerifyReviewRunProofAsSealed(id, proofID string) (ReviewRunAssurance, error) {\n584\t\ts = s.reviewOperation()\n585\t\trun, e := s.LoadProvenanceReviewRun(id)\n586\t\tif e != nil {\n587\t\t\treturn ReviewRunAssurance{}, e\n588\t\t}\n589\t\trel, e := runProofPath(id, proofID)\n590\t\tif e != nil {\n591\t\t\treturn ReviewRunAssurance{}, e\n592\t\t}\n593\t\tif _, e = ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Dir(rel)), false); e != nil {\n594\t\t\treturn ReviewRunAssurance{}, e\n595\t\t}\n596\t\tvar proof ReviewRunProof\n597\t\tif e = readLedgerJSONIn(s.fsys(), filepath.Join(s.Root, rel), &proof); e != nil {\n598\t\t\treturn ReviewRunAssurance{}, e\n599\t\t}\n600\t\tif proof.ProofID != proofID {\n601\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run proof filename identity differs\")\n602\t\t}\n603\t\treturn s.verifyRunProofAsSealed(proof, run)\n604\t}\n605\t\n606\tfunc (s Store) verifyRunProofAsSealed(proof ReviewRunProof, run ReviewRun) (ReviewRunAssurance, error) {\n607\t\tfail := func(message string) (ReviewRunAssurance, error) {\n608\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run provenance: %s\", message)\n609\t\t}\n610\t\tif _, e := s.verifyRunProofCore(proof, run); e != nil {\n611\t\t\treturn ReviewRunAssurance{}, e\n612\t\t}\n613\t\tc, p := proof.Claim, run.Provenance\n614\t\tend, e := time.Parse(time.RFC3339Nano, run.EndedAt)\n615\t\tissued, e2 := time.Parse(time.RFC3339Nano, c.IssuedAt)\n616\t\tif e != nil || e2 != nil || issued.Before(end) {\n617\t\t\treturn fail(\"proof predates the ended run\")\n618\t\t}\n619\t\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n620\t\t\treturn fail(why)\n621\t\t}\n622\t\tbundle, e := s.LoadReviewBundle(run.BundleID)\n623\t\tif e != nil {\n624\t\t\treturn fail(\"the reviewed bundle cannot be read\")\n625\t\t}\n626\t\trecorded, recordErr := normalizeModelIdentity(ModelIdentity{Principal: p.Reviewer.Principal, Vendor: run.Vendor, Model: run.Model})\n627\t\tif recordErr != nil || recorded != p.Reviewer {\n628\t\t\treturn fail(\"reviewer identity differs or is unknown\")\n629\t\t}\n630\t\tif !validProofDigest(p.WorktreeDigest) {\n631\t\t\treturn fail(\"the origin worktree of the run is not recorded\")\n632\t\t}\n633\t\tswitch p.ExecutionState {\n634\t\tcase \"started\":\n635\t\t\tif !validProofDigest(p.ArgvDigest) || !validProofDigest(p.ExecutableDigest) || !validProofDigest(p.RawTranscriptDigest) || !validProofDigest(p.RawOutputDigest) {\n636\t\t\t\treturn fail(\"execution or original-byte digests missing\")\n637\t\t\t}\n638\t\t\tif p.WireComplete && (p.WireBytes < 0 || p.WireDigest != p.PlannedWireDigest) {\n639\t\t\t\treturn fail(\"complete stdin claim is inconsistent\")\n640\t\t\t}\n641\t\tcase \"not-started\":\n642\t\t\tif p.WireBytes != 0 || p.WireComplete || p.WireDigest != \"\" || run.Status == ReviewRunCompleted || run.Status == ReviewRunInterrupted {\n643\t\t\t\treturn fail(\"unstarted audit claims an executed or transmitted review\")\n644\t\t\t}\n645\t\tdefault:\n646\t\t\treturn fail(\"unknown execution observation\")\n647\t\t}\n648\t\tif run.Status == ReviewRunCompleted && (!p.WireComplete || !p.OutputComplete || strings.TrimSpace(run.Output) == \"\") {\n649\t\t\treturn fail(\"truncated or incomplete draft cannot establish completed review\")\n650\t\t}\n651\t\treturn runAssuranceFrom(run, proof, bundle, p.Implementation, p.Reviewer), nil\n652\t}\n653\t\n654\t// runApprovalAsSealed reports whether a run-backed approval of this bundle is verified as it\n655\t// was given: the scope it approved is done.\n656\tfunc (s Store) runApprovalAsSealed(bundle ReviewBundle) bool {\n657\t\tref, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n658\t\tif err != nil {\n659\t\t\treturn false\n660\t\t}\n661\t\tdone, err := s.scopeLifecycleDone(ref)\n662\t\treturn err == nil && done\n663\t}\n664\t\n665\t// VerifyReviewRunProofForReading verifies a signed run proof for a reader that reports on a\n666\t// run: as it was given when the scope the run reviewed is done, as it is now otherwise. It is\n667\t// the question the closeout asks (verifyRunReviewReference), so a reader and the closeout\n668\t// cannot disagree about one run (spec pose-verdict-readers-ask-the-sealed-question). On the\n669\t// sealed path the expiry of the proof is not asked: it bounds the window in which a proof may\n670\t// back a new attestation, and an attestation already given to a done scope stands.\n671\tfunc (s Store) VerifyReviewRunProofForReading(id, proofID string) (ReviewRunAssurance, error) {\n672\t\ts = s.reviewOperation()\n673\t\trun, e := s.LoadProvenanceReviewRun(id)\n674\t\tif e != nil {\n675\t\t\treturn ReviewRunAssurance{}, e\n676\t\t}\n677\t\tif bundle, e := s.LoadReviewBundle(run.BundleID); e == nil && s.runApprovalAsSealed(bundle) {\n678\t\t\treturn s.VerifyReviewRunProofAsSealed(id, proofID)\n679\t\t}\n680\t\treturn s.VerifyReviewRunProof(id, proofID)\n681\t}\n682\t\n683\tfunc validProofDigest(value string) bool {\n684\t\treturn regexp.MustCompile(`^sha256:[0-9a-f]{64}$`).MatchString(value)"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"9a054322-8b7e-49fa-976b-67de0513c91f","timestamp":"2026-11-11T23:28:25.678Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-1898938466/worktree/pose-mcp/internal/pose/review_run_provenance.go","content":"\tproof.Signature = base64.StdEncoding.EncodeToString(ed25519.Sign(key.private, runProofSigningBytes(proof)))\n\tproof.ProofID = runProofIdentity(proof)\n\tif _, e = s.verifyRunProof(proof, run, now); e != nil {\n\t\treturn ReviewRunProof{}, e\n\t}\n\tif apply {\n\t\trel, e := runProofPath(run.RunID, proof.ProofID)\n\t\tif e != nil {\n\t\t\treturn ReviewRunProof{}, e\n\t\t}\n\t\tif e = publishLedgerJSON(s.Root, rel, proof); e != nil {\n\t\t\treturn ReviewRunProof{}, e\n\t\t}\n\t}\n\treturn proof, nil\n}\n\nfunc (s Store) VerifyReviewRunProof(id, proofID string) (ReviewRunAssurance, error) {\n\ts = s.reviewOperation()\n\trun, e := s.LoadProvenanceReviewRun(id)\n\tif e != nil {\n\t\treturn ReviewRunAssurance{}, e\n\t}\n\trel, e := runProofPath(id, proofID)\n\tif e != nil {\n\t\treturn ReviewRunAssurance{}, e\n\t}\n\tif _, e = ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Dir(rel)), false); e != nil {\n\t\treturn ReviewRunAssurance{}, e\n\t}\n\tvar proof ReviewRunProof\n\tif e = readLedgerJSONIn(s.fsys(), filepath.Join(s.Root, rel), &proof); e != nil {\n\t\treturn ReviewRunAssurance{}, e\n\t}\n\tif proof.ProofID != proofID {\n\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run proof filename identity differs\")\n\t}\n\treturn s.verifyRunProof(proof, run, s.reviewClock())\n}\n\n// VerifyReviewRunProofRecord verifies what a proof of run says about it —\n// its signature under a pinned issuer, the project and audience, and the\n// exact run record, output, transcript and provenance it binds — without\n// asking whether the run still governs its scope or whether its adapter and\n// brief are the current ones: a reader of a record kept after its scope\n// moved on (spec pose-delegated-review-action-fulfillment, review round 1).\nfunc (s Store) VerifyReviewRunProofRecord(id, proofID string) (string, error) {\n\ts = s.reviewOperation()\n\trun, e := s.LoadProvenanceReviewRun(id)\n\tif e != nil {\n\t\treturn \"\", e\n\t}\n\trel, e := runProofPath(id, proofID)\n\tif e != nil {\n\t\treturn \"\", e\n\t}\n\tvar proof ReviewRunProof\n\tif e = readLedgerJSONIn(s.fsys(), filepath.Join(s.Root, rel), &proof); e != nil {\n\t\treturn \"\", e\n\t}\n\tif proof.ProofID != proofID {\n\t\treturn \"\", fmt.Errorf(\"run proof filename identity differs\")\n\t}\n\tif _, e := s.verifyRunProofCore(proof, run); e != nil {\n\t\treturn \"\", e\n\t}\n\treturn proof.Issuer, nil\n}\n\n// verifyRunProofCore is the part of a proof's verification that is about\n// the proof and the run record alone.\nfunc (s Store) verifyRunProofCore(proof ReviewRunProof, run ReviewRun) (ReviewPolicy, error) {\n\tfail := func(message string) (ReviewPolicy, error) {\n\t\treturn ReviewPolicy{}, fmt.Errorf(\"run provenance: %s\", message)\n\t}\n\tif proof.SchemaVersion != 1 || proof.Claim.SchemaVersion != 1 || proof.Algorithm != \"ed25519\" || proof.ProofID != runProofIdentity(proof) {\n\t\treturn fail(\"unsupported or rewritten proof\")\n\t}\n\tpolicy, _, e := s.loadReviewPolicy()\n\tif e != nil {\n\t\treturn ReviewPolicy{}, e\n\t}\n\tif !reviewIssuerHoldsGrant(policy.TrustedAttestationIssuers, proof.Issuer, proof.PublicKey) {\n\t\treturn fail(\"issuer is not trusted under current pins\")\n\t}\n\tpublic, e := base64.StdEncoding.DecodeString(proof.PublicKey)\n\tif e != nil || len(public) != ed25519.PublicKeySize {\n\t\treturn fail(\"invalid issuer key\")\n\t}\n\tsignature, e := base64.StdEncoding.DecodeString(proof.Signature)\n\tif e != nil || !ed25519.Verify(public, runProofSigningBytes(proof), signature) {\n\t\treturn fail(\"signature verification failed\")\n\t}\n\tc, p := proof.Claim, run.Provenance\n\tif p == nil || p.SchemaVersion != 1 || run.LedgerVersion != 1 || p.Trust != \"executor-attested\" {\n\t\treturn fail(\"captured executor provenance is absent\")\n\t}\n\tif err := s.runProvenanceProjectBinding(policy.AuthorityProject); err != nil {\n\t\treturn ReviewPolicy{}, err\n\t}\n\tif c.Project != policy.AuthorityProject || c.Project != p.Project || c.Audience == \"\" || c.Audience != policy.AuthorityAudience || c.Audience != p.Audience {\n\t\treturn fail(\"project or audience differs from protected policy\")\n\t}\n\tif c.RunID != run.RunID || c.RecordDigest != reviewRunCanonicalDigest(run) || c.BundleDigest != run.BundleDigest || c.Scope != run.Scope || c.Kind != run.Kind || c.AttemptID == \"\" || c.AttemptID != run.AttemptID || c.Resumes != run.Resumes || c.TranscriptDigest != run.TranscriptDigest || c.OutputDigest != digestBytes([]byte(run.Output)) {\n\t\treturn fail(\"proof does not bind the exact run and output\")\n\t}\n\tsnapshot, _ := json.Marshal(p)\n\tif c.ProvenanceDigest != digestBytes(snapshot) {\n\t\treturn fail(\"captured provenance digest differs\")\n\t}\n\treturn policy, nil\n}\n\nfunc (s Store) verifyRunProof(proof ReviewRunProof, run ReviewRun, now time.Time) (ReviewRunAssurance, error) {\n\tfail := func(message string) (ReviewRunAssurance, error) {\n\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run provenance: %s\", message)\n\t}\n\t_, e := s.verifyRunProofCore(proof, run)\n\tif e != nil {\n\t\treturn ReviewRunAssurance{}, e\n\t}\n\tc, p := proof.Claim, run.Provenance\n\ttimes := &ReviewAuthorityClaim{IssuedAt: c.IssuedAt, ExpiresAt: c.ExpiresAt}\n\tif blocked := reviewClaimTimeBlockers(times, now, 0); len(blocked) > 0 {\n\t\treturn fail(strings.Join(blocked, \"; \"))\n\t}\n\tend, e := time.Parse(time.RFC3339Nano, run.EndedAt)\n\tissued, e2 := time.Parse(time.RFC3339Nano, c.IssuedAt)\n\tif e != nil || e2 != nil || issued.Before(end) {\n\t\treturn fail(\"proof predates the ended run\")\n\t}\n\tif why := s.runProofContextConflict(run); why != \"\" {\n\t\treturn fail(why)\n\t}\n\tconfig, found, e := s.LoadReviewersPolicyFor(run.Kind)\n\tif e != nil || !found || config.Provenance == nil {\n\t\treturn fail(\"current execution policy is missing\")\n\t}\n\tadapter, ok := config.Adapters[run.Adapter]\n\tif !ok {\n\t\treturn fail(\"current adapter is missing\")\n\t}\n\traw, _ := json.Marshal(adapter)\n\tif p.ConfigDigest != digestBytes(raw) {\n\t\treturn fail(\"adapter configuration differs\")\n\t}\n\tbundle, e := s.LoadReviewBundle(run.BundleID)\n\tif e != nil {\n\t\treturn fail(\"the reviewed bundle cannot be read\")\n\t}\n\timplementation, e := runImplementationIdentity(bundle, config.Provenance)\n\tif e != nil || implementation != p.Implementation || config.Provenance.Trust != p.Trust {\n\t\treturn fail(\"implementation baseline differs or is unknown\")\n\t}\n\treviewer, e := normalizeModelIdentity(ModelIdentity{Principal: adapter.Executor, Vendor: adapter.Vendor, Model: adapter.Model})\n\trecorded, recordErr := normalizeModelIdentity(ModelIdentity{Principal: p.Reviewer.Principal, Vendor: run.Vendor, Model: run.Model})\n\tif e != nil || recordErr != nil || recorded != reviewer || reviewer != p.Reviewer {\n\t\treturn fail(\"reviewer identity differs or is unknown\")\n\t}\n\t// The worktree a run was dispatched from is recorded, not required of\n\t// the reader: a run a CI job or Harne8's Conductor performed in its own\n\t// checkout of the project verifies in any other, since the project, the\n\t// audience, the sealed bundle and the brief it binds are the same there\n\t// (spec pose-delegated-review-action-fulfillment R3, R9; the amendment\n\t// of 2026-10-28 to the delegation ADR).\n\tif !validProofDigest(p.WorktreeDigest) {\n\t\treturn fail(\"the origin worktree of the run is not recorded\")\n\t}\n\tbrief, e := s.RenderReviewBriefMatching(run.BundleID, run.Kind, run.BriefNotes, run.BriefDigest)\n\t// A handoff run was sent the brief and the section its predecessor's\n\t// record yields; the verifier derives the same bytes (spec\n\t// pose-delegation-handoff R4).\n\tif e == nil && run.HandsOffFrom != \"\" {\n\t\tprior, priorErr := s.LoadProvenanceReviewRun(run.HandsOffFrom)\n\t\tif priorErr != nil {\n\t\t\treturn fail(\"the handoff predecessor cannot be read\")\n\t\t}\n\t\tsection := s.recordedHandoffSection(run, prior)\n\t\tif section == \"\" {\n\t\t\treturn fail(\"handoff section differs from the predecessor's record\")\n\t\t}\n\t\tbrief.Text += section\n\t}\n\tif e != nil || brief.Digest != run.BriefDigest || p.PlannedWireDigest != digestBytes([]byte(brief.Text)) || p.TemplateVersion != brief.TemplateVersion || p.NotesDigest != digestBytes([]byte(run.BriefNotes)) {\n\t\treturn fail(\"brief/template/notes/transmitted bytes differ\")\n\t}\n\tcommand := adapter.Command\n\tif run.Resumes != \"\" || run.Thread.continued() {\n\t\tif adapter.Resume == nil {\n\t\t\treturn fail(\"resume configuration missing\")\n\t\t}\n\t\tcommand = adapter.Resume.Command\n\t}\n\traw, _ = json.Marshal(command)\n\tif p.CommandTemplateDigest != digestBytes(raw) {\n\t\treturn fail(\"command template differs\")\n\t}\n\tif p.WireBytes < 0 || p.WireBytes > int64(len(brief.Text)) {\n\t\treturn fail(\"stdin byte count is outside the configured brief\")\n\t}\n\tswitch p.ExecutionState {\n\tcase \"started\":\n\t\tif !validProofDigest(p.ArgvDigest) || !validProofDigest(p.ExecutableDigest) || !validProofDigest(p.RawTranscriptDigest) || !validProofDigest(p.RawOutputDigest) {\n\t\t\treturn fail(\"execution or original-byte digests missing\")\n\t\t}\n\t\tif p.WireDigest != digestBytes([]byte(brief.Text)[:int(p.WireBytes)]) {\n\t\t\treturn fail(\"actual stdin digest differs from transmitted brief prefix\")\n\t\t}\n\t\tif p.WireComplete && (p.WireBytes != int64(len(brief.Text)) || p.WireDigest != p.PlannedWireDigest) {\n\t\t\treturn fail(\"complete stdin claim is inconsistent\")\n\t\t}\n\tcase \"not-started\":\n\t\tif p.WireBytes != 0 || p.WireComplete || p.WireDigest != \"\" || run.Status == ReviewRunCompleted || run.Status == ReviewRunInterrupted {\n\t\t\treturn fail(\"unstarted audit claims an executed or transmitted review\")\n\t\t}\n\tdefault:\n\t\treturn fail(\"unknown execution observation\")\n\t}\n\tif run.Status == ReviewRunCompleted && (!p.WireComplete || !p.OutputComplete || strings.TrimSpace(run.Output) == \"\") {\n\t\treturn fail(\"truncated or incomplete draft cannot establish completed review\")\n\t}\n\treturn runAssuranceFrom(run, proof, bundle, implementation, reviewer), nil\n}\n\n// runAssuranceFrom is what a verified run says about who reviewed and how independently.\nfunc runAssuranceFrom(run ReviewRun, proof ReviewRunProof, bundle ReviewBundle, implementation, reviewer ModelIdentity) ReviewRunAssurance {\n\tc, p := proof.Claim, run.Provenance\n\tdecision := draftReviewDecision(run.Output)\n\tsource := \"policy\"\n\tif impl := bundle.Payload.Implementation; impl != nil {\n\t\tsource = impl.Source\n\t}\n\treturn ReviewRunAssurance{IndependenceAchieved: AchievedIndependence(implementation.Vendor, implementation.Model, reviewer.Vendor, reviewer.Model), ImplementationSource: source, DraftDecision: decision, ProofIssuedAt: c.IssuedAt, ProofExpiresAt: c.ExpiresAt, State: run.Status, CompleteReview: run.Status == ReviewRunCompleted && p.WireComplete && p.OutputComplete && decision != \"unknown\" && len(run.DraftProblems) == 0, Assurance: ReviewRunMachineAttested, RunID: run.RunID, ProofID: proof.ProofID, Issuer: proof.Issuer, Reviewer: reviewer, Implementation: implementation, IdentitySource: \"native-issuer-signed-executor-declaration\", VendorDifference: AchievedIndependence(implementation.Vendor, implementation.Model, reviewer.Vendor, reviewer.Model) == IndependenceDifferentVendor, ModelDifference: knownIdentityPart(implementation.Model) && knownIdentityPart(reviewer.Model) && reviewer.Model != implementation.Model, OutputComplete: p.OutputComplete, Limitations: []string{\"executor-declaration-not-independent-vendor-receipt\", \"raw-bytes-hashed-by-executor-redacted-artifacts-retained\", ReviewLimitationIssuerTruthfulness, ReviewLimitationCognitive}}\n}\n\n// VerifyReviewRunProofAsSealed verifies a signed run proof as the approval it backed was\n// given: what the proof and the run record say, and that the record still stands (the run\n// completed and complete, not superseded, the persisted record and the transcript intact,\n// the bundle it reviewed readable with the digest it recorded). It does not ask whether the\n// run still governs the repository as it is now, nor re-render the brief, nor compare the\n// current adapter policy: those are the questions of a live scope, and a scope that is done\n// keeps the approval it was closed with, as a person's attestation always has (spec\n// pose-delegated-approval-survives-routine-drift). The issuer must still hold its pin.\nfunc (s Store) VerifyReviewRunProofAsSealed(id, proofID string) (ReviewRunAssurance, error) {\n\ts = s.reviewOperation()\n\trun, e := s.LoadProvenanceReviewRun(id)\n\tif e != nil {\n\t\treturn ReviewRunAssurance{}, e\n\t}\n\trel, e := runProofPath(id, proofID)\n\tif e != nil {\n\t\treturn ReviewRunAssurance{}, e\n\t}\n\tif _, e = ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Dir(rel)), false); e != nil {\n\t\treturn ReviewRunAssurance{}, e\n\t}\n\tvar proof ReviewRunProof\n\tif e = readLedgerJSONIn(s.fsys(), filepath.Join(s.Root, rel), &proof); e != nil {\n\t\treturn ReviewRunAssurance{}, e\n\t}\n\tif proof.ProofID != proofID {\n\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run proof filename identity differs\")\n\t}\n\treturn s.verifyRunProofAsSealed(proof, run)\n}\n\nfunc (s Store) verifyRunProofAsSealed(proof ReviewRunProof, run ReviewRun) (ReviewRunAssurance, error) {\n\tfail := func(message string) (ReviewRunAssurance, error) {\n\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run provenance: %s\", message)\n\t}\n\tif _, e := s.verifyRunProofCore(proof, run); e != nil {\n\t\treturn ReviewRunAssurance{}, e\n\t}\n\tc, p := proof.Claim, run.Provenance\n\tend, e := time.Parse(time.RFC3339Nano, run.EndedAt)\n\tissued, e2 := time.Parse(time.RFC3339Nano, c.IssuedAt)\n\tif e != nil || e2 != nil || issued.Before(end) {\n\t\treturn fail(\"proof predates the ended run\")\n\t}\n\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n\t\treturn fail(why)\n\t}\n\tbundle, e := s.LoadReviewBundle(run.BundleID)\n\tif e != nil {\n\t\treturn fail(\"the reviewed bundle cannot be read\")\n\t}\n\trecorded, recordErr := normalizeModelIdentity(ModelIdentity{Principal: p.Reviewer.Principal, Vendor: run.Vendor, Model: run.Model})\n\tif recordErr != nil || recorded != p.Reviewer {\n\t\treturn fail(\"reviewer identity differs or is unknown\")\n\t}\n\tif !validProofDigest(p.WorktreeDigest) {\n\t\treturn fail(\"the origin worktree of the run is not recorded\")\n\t}\n\tswitch p.ExecutionState {\n\tcase \"started\":\n\t\tif !validProofDigest(p.ArgvDigest) || !validProofDigest(p.ExecutableDigest) || !validProofDigest(p.RawTranscriptDigest) || !validProofDigest(p.RawOutputDigest) {\n\t\t\treturn fail(\"execution or original-byte digests missing\")\n\t\t}\n\t\tif p.WireComplete && (p.WireBytes < 0 || p.WireDigest != p.PlannedWireDigest) {\n\t\t\treturn fail(\"complete stdin claim is inconsistent\")\n\t\t}\n\tcase \"not-started\":\n\t\tif p.WireBytes != 0 || p.WireComplete || p.WireDigest != \"\" || run.Status == ReviewRunCompleted || run.Status == ReviewRunInterrupted {\n\t\t\treturn fail(\"unstarted audit claims an executed or transmitted review\")\n\t\t}\n\tdefault:\n\t\treturn fail(\"unknown execution observation\")\n\t}\n\tif run.Status == ReviewRunCompleted && (!p.WireComplete || !p.OutputComplete || strings.TrimSpace(run.Output) == \"\") {\n\t\treturn fail(\"truncated or incomplete draft cannot establish completed review\")\n\t}\n\treturn runAssuranceFrom(run, proof, bundle, p.Implementation, p.Reviewer), nil\n}\n\n// runApprovalAsSealed reports whether a run-backed approval of this bundle is verified as it\n// was given: the scope it approved is done.\nfunc (s Store) runApprovalAsSealed(bundle ReviewBundle) bool {\n\tref, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n\tif err != nil {\n\t\treturn false\n\t}\n\tdone, err := s.scopeLifecycleDone(ref)\n\treturn err == nil && done\n}\n\n// VerifyReviewRunProofForReading verifies a signed run proof for a reader that reports on a\n// run: as it was given when the scope the run reviewed is done, as it is now otherwise. It is\n// the question the closeout asks (verifyRunReviewReference), so a reader and the closeout\n// cannot disagree about one run (spec pose-verdict-readers-ask-the-sealed-question). On the\n// sealed path the expiry of the proof is not asked: it bounds the window in which a proof may\n// back a new attestation, and an attestation already given to a done scope stands.\nfunc (s Store) VerifyReviewRunProofForReading(id, proofID string) (ReviewRunAssurance, error) {\n\ts = s.reviewOperation()\n\trun, e := s.LoadProvenanceReviewRun(id)\n\tif e != nil {\n\t\treturn ReviewRunAssurance{}, e\n\t}\n\tif bundle, e := s.LoadReviewBundle(run.BundleID); e == nil && s.runApprovalAsSealed(bundle) {\n\t\treturn s.VerifyReviewRunProofAsSealed(id, proofID)\n\t}\n\treturn s.VerifyReviewRunProof(id, proofID)\n}\n\nfunc validProofDigest(value string) bool {\n\treturn regexp.MustCompile(`^sha256:[0-9a-f]{64}$`).MatchString(value)","numLines":345,"startLine":340,"totalLines":937}},"tool_result_meta":[{"id":"toolu_019agw2Aq7Dgyth8WXLWtzAz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
