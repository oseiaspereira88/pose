{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YW8QLQxRpXi66S7K4o7d2A","type":"tool_result","content":"685\t}\n686\t\n687\t// errReviewRunHistoryIncomplete is a run history that could not be read whole.\n688\tvar errReviewRunHistoryIncomplete = errors.New(\"run provenance history is incomplete\")\n689\t\n690\tfunc (s Store) verifyRunReviewReference(bundle ReviewBundle, att ReviewAttestation) (ReviewRunAssurance, error) {\n691\t\tif att.Run == nil {\n692\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"signed run reference is missing\")\n693\t\t}\n694\t\tvar assurance ReviewRunAssurance\n695\t\tvar e error\n696\t\tif s.runApprovalAsSealed(bundle) {\n697\t\t\tassurance, e = s.VerifyReviewRunProofAsSealed(att.Run.RunID, att.Run.ProofID)\n698\t\t} else {\n699\t\t\tassurance, e = s.VerifyReviewRunProof(att.Run.RunID, att.Run.ProofID)\n700\t\t}\n701\t\tif e != nil {\n702\t\t\treturn assurance, e\n703\t\t}\n704\t\trun, e := s.LoadProvenanceReviewRun(att.Run.RunID)\n705\t\tif e != nil {\n706\t\t\treturn assurance, e\n707\t\t}\n708\t\tif run.BundleID != bundle.BundleID || run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.Kind != ReviewBriefKindReview || run.Status != ReviewRunCompleted || !assurance.CompleteReview || att.Reviewer != assurance.Reviewer.Principal {\n709\t\t\treturn assurance, fmt.Errorf(\"attestation and referenced run context differ\")\n710\t\t}\n711\t\tattested, e1 := time.Parse(time.RFC3339Nano, att.AttestedAt)\n712\t\tended, e2 := time.Parse(time.RFC3339Nano, run.EndedAt)\n713\t\tissued, e3 := time.Parse(time.RFC3339Nano, assurance.ProofIssuedAt)\n714\t\tif e1 != nil || e2 != nil || e3 != nil || ended.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) || issued.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"8a484dd8-c8d9-4fc8-afd4-a7f19297a27b","timestamp":"2026-11-11T23:28:49.921Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-1898938466/worktree/pose-mcp/internal/pose/review_run_provenance.go","content":"}\n\n// errReviewRunHistoryIncomplete is a run history that could not be read whole.\nvar errReviewRunHistoryIncomplete = errors.New(\"run provenance history is incomplete\")\n\nfunc (s Store) verifyRunReviewReference(bundle ReviewBundle, att ReviewAttestation) (ReviewRunAssurance, error) {\n\tif att.Run == nil {\n\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"signed run reference is missing\")\n\t}\n\tvar assurance ReviewRunAssurance\n\tvar e error\n\tif s.runApprovalAsSealed(bundle) {\n\t\tassurance, e = s.VerifyReviewRunProofAsSealed(att.Run.RunID, att.Run.ProofID)\n\t} else {\n\t\tassurance, e = s.VerifyReviewRunProof(att.Run.RunID, att.Run.ProofID)\n\t}\n\tif e != nil {\n\t\treturn assurance, e\n\t}\n\trun, e := s.LoadProvenanceReviewRun(att.Run.RunID)\n\tif e != nil {\n\t\treturn assurance, e\n\t}\n\tif run.BundleID != bundle.BundleID || run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.Kind != ReviewBriefKindReview || run.Status != ReviewRunCompleted || !assurance.CompleteReview || att.Reviewer != assurance.Reviewer.Principal {\n\t\treturn assurance, fmt.Errorf(\"attestation and referenced run context differ\")\n\t}\n\tattested, e1 := time.Parse(time.RFC3339Nano, att.AttestedAt)\n\tended, e2 := time.Parse(time.RFC3339Nano, run.EndedAt)\n\tissued, e3 := time.Parse(time.RFC3339Nano, assurance.ProofIssuedAt)\n\tif e1 != nil || e2 != nil || e3 != nil || ended.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) || issued.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) {","numLines":30,"startLine":685,"totalLines":937}},"tool_result_meta":[{"id":"toolu_01YW8QLQxRpXi66S7K4o7d2A","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
