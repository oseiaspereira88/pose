rrn-237e7d9be5f0c4f5.events.ndjson |   35 +\n .pose/review-runs/rrn-237e7d9be5f0c4f5.json        |  137 +\n .pose/review-runs/rrn-237e7d9be5f0c4f5.transcript  |   42 +\n .../review-runs/rrn-8531130b0d7334cb.events.ndjson |   45 +\n .pose/review-runs/rrn-8531130b0d7334cb.json        |  142 +\n .pose/review-runs/rrn-8531130b0d7334cb.transcript  |   46 +\n .../review-runs/rrn-9b810c44750e6d93.events.ndjson |   52 +\n .pose/review-runs/rrn-9b810c44750e6d93.json        |  143 +\n .pose/review-runs/rrn-9b810c44750e6d93.transcript  |   53 +\n ...1-16-pose-doctor-recommends-the-commit-graph.md |  159 +\n ...ose-review-ledger-is-read-once-per-operation.md |    6 +-\n .../pose-doctor-recommends-the-commit-graph.json   |   57 +\n pose-mcp/internal/cli/doctor.go                    |   22 +\n pose-mcp/internal/cli/doctor_commit_graph.go       |  127 +\n pose-mcp/internal/cli/doctor_commit_graph_test.go  |  149 +\n pose-mcp/internal/pose/review_ledger_memo.go       |    7 +\n pose-mcp/internal/pose/review_ledger_memo_test.go  |   22 +\n 44 files changed, 16962 insertions(+), 3990 deletions(-)\n","exit_code":0,"status":"completed"}}
