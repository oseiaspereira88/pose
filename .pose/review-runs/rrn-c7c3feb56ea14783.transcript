{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/cli/doctor_commit_graph.go; nl -ba pose-mcp/internal/cli/doctor_commit_graph_test.go'","aggregated_output":"     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bufio\"\n     5\t\t\"bytes\"\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"strconv\"\n    11\t\t\"strings\"\n    12\t\n    13\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    14\t)\n    15\t\n    16\t// commitGraphHistoryThreshold is the history size from which a last-commit\n    17\t// lookup by path is worth accelerating: below it a history walk costs a few\n    18\t// milliseconds (spec pose-doctor-recommends-the-commit-graph).\n    19\tvar commitGraphHistoryThreshold = 500\n    20\t\n    21\t// errCommitGraphNotApplicable marks a root the check does not apply to: not\n    22\t// a Git repository, or a repository without a commit on HEAD.\n    23\tvar errCommitGraphNotApplicable = errors.New(\"not a Git repository with a commit on HEAD\")\n    24\t\n    25\t// commitGraphState is what doctor knows about a repository's commit-graph.\n    26\ttype commitGraphState struct {\n    27\t\tcommits int\n    28\t\t// filtersUsed is Git's own answer: a last-commit lookup by path read\n    29\t\t// changed-path Bloom filters from the commit-graph it loaded.\n    30\t\tfiltersUsed bool\n    31\t}\n    32\t\n    33\t// readCommitGraphState counts HEAD's history and asks Git whether a\n    34\t// last-commit lookup by path uses changed-path Bloom filters. Git reports the\n    35\t// filters it consulted in its trace2 \"bloom\" statistics, so whichever graph it\n    36\t// loads (the object directory's or an alternate's, a single file or a chain,\n    37\t// of any version it accepts) is judged as Git itself uses it. It only reads.\n    38\tfunc readCommitGraphState(root string) (commitGraphState, error) {\n    39\t\tif _, err := commitGraphGit(root, nil, \"rev-parse\", \"--verify\", \"--quiet\", \"HEAD^{commit}\"); err != nil {\n    40\t\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n    41\t\t}\n    42\t\tcount, err := commitGraphGit(root, nil, \"rev-list\", \"--count\", \"HEAD\")\n    43\t\tif err != nil {\n    44\t\t\treturn commitGraphState{}, fmt.Errorf(\"history of HEAD could not be counted: %w\", err)\n    45\t\t}\n    46\t\tcommits, err := strconv.Atoi(strings.TrimSpace(count))\n    47\t\tif err != nil {\n    48\t\t\treturn commitGraphState{}, fmt.Errorf(\"history of HEAD could not be counted: %w\", err)\n    49\t\t}\n    50\t\tstate := commitGraphState{commits: commits}\n    51\t\tif commits < commitGraphHistoryThreshold {\n    52\t\t\treturn state, nil\n    53\t\t}\n    54\t\tlisting, err := commitGraphGit(root, nil, \"ls-tree\", \"-r\", \"--name-only\", \"-z\", \"HEAD\")\n    55\t\tif err != nil {\n    56\t\t\treturn state, fmt.Errorf(\"files of HEAD could not be listed: %w\", err)\n    57\t\t}\n    58\t\tpath, _, _ := strings.Cut(listing, \"\\x00\")\n    59\t\tif path == \"\" {\n    60\t\t\treturn state, nil\n    61\t\t}\n    62\t\ttrace, err := os.CreateTemp(\"\", \"pose-doctor-trace2-*.json\")\n    63\t\tif err != nil {\n    64\t\t\treturn state, fmt.Errorf(\"Git trace could not be created: %w\", err)\n    65\t\t}\n    66\t\ttracePath := trace.Name()\n    67\t\ttrace.Close()\n    68\t\tdefer os.Remove(tracePath)\n    69\t\tif _, err := commitGraphGit(root, []string{\"GIT_TRACE2_EVENT=\" + tracePath}, \"log\", \"-1\", \"--format=%H\", \"--\", path); err != nil {\n    70\t\t\treturn state, fmt.Errorf(\"last commit of a file could not be read: %w\", err)\n    71\t\t}\n    72\t\traw, err := os.ReadFile(tracePath)\n    73\t\tif err != nil {\n    74\t\t\treturn state, fmt.Errorf(\"Git trace could not be read: %w\", err)\n    75\t\t}\n    76\t\tstate.filtersUsed = traceUsedBloomFilters(raw)\n    77\t\treturn state, nil\n    78\t}\n    79\t\n    80\t// traceUsedBloomFilters reports whether a trace2 event stream carries a\n    81\t// \"bloom\" statistics event in which some filter answered a lookup.\n    82\tfunc traceUsedBloomFilters(raw []byte) bool {\n    83\t\tscanner := bufio.NewScanner(bytes.NewReader(raw))\n    84\t\tscanner.Buffer(make([]byte, 0, 64<<10), 1<<20)\n    85\t\tfor scanner.Scan() {\n    86\t\t\tvar event struct {\n    87\t\t\t\tCategory string `json:\"category\"`\n    88\t\t\t\tKey      string `json:\"key\"`\n    89\t\t\t\tValue    struct {\n    90\t\t\t\t\tMaybe         int `json:\"maybe\"`\n    91\t\t\t\t\tDefinitelyNot int `json:\"definitely_not\"`\n    92\t\t\t\t} `json:\"value\"`\n    93\t\t\t}\n    94\t\t\tif json.Unmarshal(scanner.Bytes(), &event) != nil {\n    95\t\t\t\tcontinue\n    96\t\t\t}\n    97\t\t\tif event.Category == \"bloom\" && event.Key == \"statistics\" && event.Value.Maybe+event.Value.DefinitelyNot > 0 {\n    98\t\t\t\treturn true\n    99\t\t\t}\n   100\t\t}\n   101\t\treturn false\n   102\t}\n   103\t\n   104\t// writeCommitGraph writes the repository's commit-graph with changed-path\n   105\t// Bloom filters; it only writes under the Git object directory.\n   106\tfunc writeCommitGraph(root string) error {\n   107\t\t_, err := commitGraphGit(root, nil, \"commit-graph\", \"write\", \"--reachable\", \"--changed-paths\")\n   108\t\treturn err\n   109\t}\n   110\t\n   111\t// commitGraphGit runs Git in root with extra environment and returns its\n   112\t// output; a failure carries Git's stderr, bounded.\n   113\tfunc commitGraphGit(root string, env []string, args ...string) (string, error) {\n   114\t\tcmd := posemodel.RawHistoryGit(root, args...)\n   115\t\tcmd.Env = append(cmd.Env, env...)\n   116\t\tvar stderr bytes.Buffer\n   117\t\tcmd.Stderr = &stderr\n   118\t\tout, err := cmd.Output()\n   119\t\tif err != nil {\n   120\t\t\tdetail := strings.TrimSpace(stderr.String())\n   121\t\t\tif len(detail) > 200 {\n   122\t\t\t\tdetail = detail[:200] + \"…\"\n   123\t\t\t}\n   124\t\t\treturn string(out), fmt.Errorf(\"git %s: %v %s\", args[0], err, detail)\n   125\t\t}\n   126\t\treturn string(out), nil\n   127\t}\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"encoding/json\"\n     6\t\t\"errors\"\n     7\t\t\"os\"\n     8\t\t\"os/exec\"\n     9\t\t\"path/filepath\"\n    10\t\t\"strings\"\n    11\t\t\"testing\"\n    12\t)\n    13\t\n    14\tfunc doctorCommitGraphFinding(t *testing.T, repo string) doctorFinding {\n    15\t\tt.Helper()\n    16\t\tvar finding doctorFinding\n    17\t\tinDir(t, repo, func() {\n    18\t\t\tvar out, errB bytes.Buffer\n    19\t\t\tMain([]string{\"doctor\", \"--json\"}, &out, &errB)\n    20\t\t\tvar report doctorJSON\n    21\t\t\tif err := json.Unmarshal(out.Bytes(), &report); err != nil {\n    22\t\t\t\tt.Fatalf(\"invalid JSON: %v\\n%s\", err, out.String())\n    23\t\t\t}\n    24\t\t\tfor _, f := range report.Findings {\n    25\t\t\t\tif f.Check == \"git.commit-graph\" {\n    26\t\t\t\t\tfinding = f\n    27\t\t\t\t}\n    28\t\t\t}\n    29\t\t})\n    30\t\tif finding.Check == \"\" {\n    31\t\t\tt.Fatal(\"doctor reported no git.commit-graph check\")\n    32\t\t}\n    33\t\treturn finding\n    34\t}\n    35\t\n    36\tfunc gitInRepo(t *testing.T, repo string, args ...string) {\n    37\t\tt.Helper()\n    38\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", repo}, args...)...).CombinedOutput(); err != nil {\n    39\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n    40\t\t}\n    41\t}\n    42\t\n    43\tfunc removeCommitGraph(t *testing.T, repo string) {\n    44\t\tt.Helper()\n    45\t\tinfo := filepath.Join(repo, \".git\", \"objects\", \"info\")\n    46\t\tfor _, name := range []string{\"commit-graph\", \"commit-graphs\"} {\n    47\t\t\tif err := os.RemoveAll(filepath.Join(info, name)); err != nil {\n    48\t\t\t\tt.Fatal(err)\n    49\t\t\t}\n    50\t\t}\n    51\t}\n    52\t\n    53\t// Spec pose-doctor-recommends-the-commit-graph: R1 a long history Git walks\n    54\t// whole is a next step with a fix; R2 the fix writes the filters and the\n    55\t// check turns ok; R3 a short history needs none. The answer is Git's own, so\n    56\t// it follows whichever graph Git loads.\n    57\tfunc TestDoctorRecommendsTheCommitGraph(t *testing.T) {\n    58\t\trepo := doctorFixture(t)\n    59\t\toriginal := commitGraphHistoryThreshold\n    60\t\tt.Cleanup(func() { commitGraphHistoryThreshold = original })\n    61\t\tfor i := 0; i < 4; i++ {\n    62\t\t\t// Each commit changes a file of its own, so a lookup of another path\n    63\t\t\t// has commits the filters can rule out.\n    64\t\t\tif err := os.WriteFile(filepath.Join(repo, \"zz-history.txt\"), []byte(strings.Repeat(\"x\", i+1)), 0o644); err != nil {\n    65\t\t\t\tt.Fatal(err)\n    66\t\t\t}\n    67\t\t\tgitInRepo(t, repo, \"add\", \"zz-history.txt\")\n    68\t\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"history\")\n    69\t\t}\n    70\t\tremoveCommitGraph(t, repo)\n    71\t\n    72\t\tcommitGraphHistoryThreshold = 1 << 30\n    73\t\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"ok\" {\n    74\t\t\tt.Fatalf(\"a short history is not ok: %+v\", f)\n    75\t\t}\n    76\t\n    77\t\tcommitGraphHistoryThreshold = 3\n    78\t\tmissing := doctorCommitGraphFinding(t, repo)\n    79\t\tif missing.Level != \"next\" || missing.FixCode != \"git.commit-graph\" || missing.RemediationClass != remediationFixable {\n    80\t\t\tt.Fatalf(\"a long history without a commit-graph: %+v\", missing)\n    81\t\t}\n    82\t\n    83\t\tinDir(t, repo, func() {\n    84\t\t\tvar out, errB bytes.Buffer\n    85\t\t\tMain([]string{\"doctor\", \"--fix\", \"--yes\", \"--only\", \"git.commit-graph\"}, &out, &errB)\n    86\t\t})\n    87\t\tif fixed := doctorCommitGraphFinding(t, repo); fixed.Level != \"ok\" {\n    88\t\t\tt.Fatalf(\"the fix did not satisfy the check: %+v\", fixed)\n    89\t\t}\n    90\t\n    91\t\tremoveCommitGraph(t, repo)\n    92\t\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--no-changed-paths\")\n    93\t\tif plain := doctorCommitGraphFinding(t, repo); plain.Level != \"next\" {\n    94\t\t\tt.Fatalf(\"a commit-graph without changed-path filters is not recommended again: %+v\", plain)\n    95\t\t}\n    96\t\n    97\t\tremoveCommitGraph(t, repo)\n    98\t\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--changed-paths\", \"--split\")\n    99\t\tif split := doctorCommitGraphFinding(t, repo); split.Level != \"ok\" {\n   100\t\t\tt.Fatalf(\"a split commit-graph with changed paths is not recognized: %+v\", split)\n   101\t\t}\n   102\t\n   103\t\t// Review F3: with a single graph and a chain, Git loads the single graph.\n   104\t\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--no-changed-paths\")\n   105\t\tif both := doctorCommitGraphFinding(t, repo); both.Level != \"next\" {\n   106\t\t\tt.Fatalf(\"an unfiltered single graph beside a filtered chain is judged by the chain: %+v\", both)\n   107\t\t}\n   108\t\tremoveCommitGraph(t, repo)\n   109\t\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--changed-paths\")\n   110\t\n   111\t\t// Review F2: a repository whose graph lives only in an alternate.\n   112\t\tshared := filepath.Join(t.TempDir(), \"shared\")\n   113\t\tif out, err := exec.Command(\"git\", \"clone\", \"-q\", \"--shared\", repo, shared).CombinedOutput(); err != nil {\n   114\t\t\tt.Fatalf(\"clone --shared: %v %s\", err, out)\n   115\t\t}\n   116\t\tremoveCommitGraph(t, shared)\n   117\t\tstate, err := readCommitGraphState(shared)\n   118\t\tif err != nil || !state.filtersUsed {\n   119\t\t\tt.Fatalf(\"a graph in an alternate is not seen: %+v %v\", state, err)\n   120\t\t}\n   121\t}\n   122\t\n   123\t// Review F5: a repository whose history cannot be read is a warning, not a\n   124\t// silent pass; a root that is not a repository gets no check.\n   125\tfunc TestDoctorCommitGraphReportsAnUnreadableHistory(t *testing.T) {\n   126\t\tif _, err := readCommitGraphState(t.TempDir()); !errors.Is(err, errCommitGraphNotApplicable) {\n   127\t\t\tt.Fatalf(\"a directory outside Git: %v, want not applicable\", err)\n   128\t\t}\n   129\t\trepo := doctorFixture(t)\n   130\t\toriginal := commitGraphHistoryThreshold\n   131\t\tt.Cleanup(func() { commitGraphHistoryThreshold = original })\n   132\t\tcommitGraphHistoryThreshold = 1\n   133\t\tcommit := func() {\n   134\t\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"--allow-empty\", \"-m\", \"history\")\n   135\t\t}\n   136\t\tcommit()\n   137\t\tcommit()\n   138\t\tout, err := exec.Command(\"git\", \"-C\", repo, \"rev-parse\", \"HEAD~1\").Output()\n   139\t\tif err != nil {\n   140\t\t\tt.Fatal(err)\n   141\t\t}\n   142\t\tparent := strings.TrimSpace(string(out))\n   143\t\tif err := os.Remove(filepath.Join(repo, \".git\", \"objects\", parent[:2], parent[2:])); err != nil {\n   144\t\t\tt.Fatalf(\"the parent commit is not a loose object: %v\", err)\n   145\t\t}\n   146\t\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"warn\" || !strings.Contains(f.Message, \"could not be read\") {\n   147\t\t\tt.Fatalf(\"an unreadable history: %+v\", f)\n   148\t\t}\n   149\t}\n","exit_code":0,"status":"completed"}}
