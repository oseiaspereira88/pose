view-brief/1\"\npose-mcp/internal/pose/review_brief.go:71:func reviewBriefAsksConclusion(template string) bool {\npose-mcp/internal/pose/review_brief.go:79:var reviewBriefEarlierTemplates = []string{reviewBriefTemplateTypedConclusion, reviewBriefTemplateRounds, reviewBriefTemplateFirst}\npose-mcp/internal/pose/review_brief.go:225:func renderReviewBriefBody(bundle ReviewBundle, kind, template, notes string, smoke *smokeScript, round *ReviewRound, conclusion bool, questions []AdjudicationQuestion) string {","numLines":9,"totalLines":9},"tool_result_meta":[{"id":"toolu_01E5KEM99MQ1T8BdreamxqE7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
