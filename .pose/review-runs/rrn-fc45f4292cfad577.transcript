ng, string) {\n253\t\tcommands, results, outcome := []string{}, []string{}, \"\"\n254\t\tscanner := bufio.NewScanner(bytes.NewReader(raw))\n255\t\tfor scanner.Scan() {\n256\t\t\tline := scanner.Text()\n257\t\t\tif strings.HasPrefix(line, \"  -> \") {\n258\t\t\t\tcommands = append(commands, strings.TrimPrefix(line, \"  -> \"))\n259\t\t\t}\n260\t\t\tif strings.HasPrefix(line, \" - [\") || strings.HasPrefix(line, \"Result:\") || strings.HasPrefix(line, \"Resultado:\") {\n261\t\t\t\tresults = append(results, line)\n262\t\t\t}\n263\t\t\tupper := strings.ToUpper(line)\n264\t\t\tswitch {\n265\t\t\tcase strings.Contains(upper, \"FAILURE_TOLERATED\") || strings.Contains(upper, \"FALHA_TOLERADA\"):\n266\t\t\t\toutcome = \"partial\"\n267\t\t\tcase strings.Contains(upper, \"RESULT: SUCCESS\") || strings.Contains(upper, \"RESULTADO: SUCESSO\"):\n268\t\t\t\toutcome = \"pass\"\n269\t\t\tcase strings.Contains(upper, \"RESULT: FAILURE\") || strings.Contains(upper, \"RESULTADO: FALHA\"):\n270\t\t\t\toutcome = \"fail\"\n271\t\t\t}\n272\t\t}\n273\t\treturn commands, results, outcome\n274\t}\n275\t\n276\tfunc readLastReportRecord(path string) *reportRecord {\n277\t\tfile, err := os.Open(path)\n278\t\tif err != nil {\n279\t\t\treturn nil\n280\t\t}\n281\t\tdefer file.Close()\n282\t\tvar last *reportRecord\n283\t\tscanner := bufio.NewScanner(file)\n284\t\tfor scanner.Scan() {\n285\t\t\tvar record reportRecord\n286\t\t\tif json.Unmarshal(scanner.Bytes(), &record) == nil {\n287\t\t\t\tcopy := record\n288\t\t\t\tlast = &copy\n289\t\t\t}\n290\t\t}\n291\t\treturn last\n292\t}\n293\t\n294\tfunc reportChangedFiles(root, since string) []string {\n295\t\targs := []string{\"-C\", root}\n296\t\tif since != \"\" {\n297\t\t\targs = append(args, \"diff\", \"--name-only\", since)\n298\t\t} else {\n299\t\t\targs = append(args, \"status\", \"--porcelain=v1\")\n300\t\t}\n301\t\t// The diff reads the index without writing it (spec\n302\t\t// pose-validate-reads-leave-the-index-alone R1).\n303\t\tvar output [