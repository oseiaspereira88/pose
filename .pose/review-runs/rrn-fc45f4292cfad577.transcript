r != nil {\n712\t\t\treturn true, err\n713\t\t}\n714\t\tworking, werr := os.ReadFile(filepath.Join(root, filepath.FromSlash(rel)))\n715\t\tif !present {\n716\t\t\t// Absent from the commit: equal only when absent from the copy too.\n717\t\t\treturn !errors.Is(werr, os.ErrNotExist), nil\n718\t\t}\n719\t\tcommitted, cerr := posemodel.RawGit(\"-C\", root, \"show\", head+\":\"+rel).Output()\n720\t\tif cerr != nil {\n721\t\t\treturn true, fmt.Errorf(\"%s at %s is unreadable: %v\", rel, head, cerr)\n722\t\t}\n723\t\tif werr != nil {\n724\t\t\treturn true, nil\n725\t\t}\n726\t\treturn !bytes.Equal(working, committed), nil\n727\t}\n728\t\n729\t// movementWitness summarizes the reflog lengths of HEAD and of every\n730\t// checked-out submodule's HEAD; \"\" when any cannot be read, so the witness\n731\t// never passes by default.\n732\tfunc movementWitness(root, head string) string {\n733\t\tparent := headReflogLength(root)\n734\t\tif parent < 0 || head == \"\" {\n735\t\t\treturn \"\"\n736\t\t}\n737\t\tparts := []string{fmt.Sprintf(\".=%d\", parent)}\n738\t\tlinks, err := gitlinks(root, head)\n739\t\tif err != nil {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"2a8c79d9-371c-424f-9dae-d01f40b3e7df","timestamp":"2026-11-26T20:28:37.972Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-0207467d72/worktree/pose-mcp/internal/cli/validate_carry.go","content":"\tfor i := 0; i < len(p); i++ {\n\t\tif p[i] >= 0x80 {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// hiddenIndexEntries returns a tracked path, in the repository or in one of\n// its checked-out submodules, whose index entry is marked assume-unchanged or\n// skip-worktree: status cannot see edits to it.\nfunc hiddenIndexEntries(root, head string) (string, error) {\n\tcheck := func(repo, prefix string) (string, error) {\n\t\tout, err := posemodel.RawGit(\"-C\", repo, \"ls-files\", \"-v\", \"-z\").Output()\n\t\tif err != nil {\n\t\t\treturn \"\", err\