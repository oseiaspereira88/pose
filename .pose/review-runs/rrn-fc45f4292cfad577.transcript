{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vtq6PoE4aeJLiShXUephEV","type":"tool_result","content":"package pose\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// Spec pose-validate-reads-leave-the-index-alone R1, R2: a diff that reads the\n// index read-only answers exactly as the plain diff does, over the states\n// review round 1 found a status-based reading got wrong, and leaves the index\n// byte-identical where the plain diff rewrites it.\nfunc TestReadOnlyIndexDiffAnswersAsThePlainDiff(t *testing.T) {\n\troot := t.TempDir()\n\trun := func(dir string, args ...string) string {\n\t\tt.Helper()\n\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"-c\", \"protocol.file.allow=always\"}, args...)...)\n\t\tout, err := cmd.CombinedOutput()\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t\treturn string(out)\n\t}\n\twrite := func(rel, body string) {\n\t\tt.Helper()\n\t\tp := filepath.Join(root, rel)\n\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\t// A submodule whose .gitmodules says ignore=all.\n\tsub := t.TempDir()\n\trun(sub, \"init\", \"-q\")\n\tif err := os.WriteFile(filepath.Join(sub, \"s.txt\"), []byte(\"1\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trun(sub, \"add\", \"s.txt\")\n\trun(sub, \"commit\", \"-q\", \"-m\", \"s1\")\n\trun(root, \"init\", \"-q\")\n\tfor _, f := range []string{\"stat.txt\", \"mod.txt\", \"del.txt\", \"proj/back.txt\", \"dir/x.txt\", \"conflict.txt\"} {\n\t\twrite(f, \"x\\n\")\n\t}\n\tif err := os.Symlink(\"target-missing\", filepath.Join(root, \"link\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trun(root, \"add\", \"-A\")\n\trun(root, \"submodule\", \"add\", \"-q\", sub, \"mod\")\n\trun(root, \"config\", \"-f\", \".gitmodules\", \"submodule.mod.ignore\", \"all\")\n\trun(root, \"add\", \".gitmodules\")\n\trun(root, \"commit\", \"-q\", \"-m\", \"base\")\n\tbase := run(root, \"rev-parse\", \"HEAD\")[:40]\n\t// A commit since the base: the gitlink moves, and a file changes and is\n\t// changed back in the work tree.\n\tif err := os.WriteFile(filepath.Join(root, \"mod\", \"s.txt\"), []byte(\"2\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trun(filepath.Join(root, \"mod\"), \"commit\", \"-q\", \"-am\", \"s2\")\n\twrite(\"proj/back.txt\", \"y\\n\")\n\trun(root, \"add\", \"-A\")\n\trun(root, \"commit\", \"-q\", \"-m\", \"next\")\n\twrite(\"proj/back.txt\", \"x\\n\")\n\t// Work-tree states.\n\twrite(\"mod.txt\", \"changed\\n\")\n\tif err := os.Remove(filepath.Join(root, \"del.txt\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\twrite(\"staged.txt\", \"s\\n\")\n\trun(root, \"add\", \"staged.txt\")\n\twrite(\"ita.txt\", \"i\\n\")\n\trun(root, \"add\", \"-N\", \"ita.txt\")\n\twrite(\"conflict.txt\", \"staged then reverted\\n\")\n\trun(root, \"add\", \"conflict.txt\")\n\twrite(\"conflict.txt\", \"x\\n\")\n\tif err := os.RemoveAll(filepath.Join(root, \"dir\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\twrite(\"dir\", \"now a file\\n\")\n\tlater := time.Now().Add(2 * time.Second)\n\tif err := os.Chtimes(filepath.Join(root, \"stat.txt\"), later, later); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treads := [][]string{\n\t\t{\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base, \"--\"},\n\t\t{\"-C\", root, \"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\"},\n\t\t{\"-C\", filepath.Join(root, \"proj\"), \"diff\", \"--name-only\", base},\n\t}\n\tfor _, args := range reads {\n\t\tbefore, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tgot, err := RawGitDiffReadOnly(root, args...)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"%v: %v\", args, err)\n\t\t}\n\t\tafter, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif !bytes.Equal(before, after) {\n\t\t\tt.Fatalf(\"%v rewrote .git/index\", args)\n\t\t}\n\t\twant, err := RawGit(args...).Output()\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif !bytes.Equal(got, want) {\n\t\t\tt.Fatalf(\"%v answered %q, the plain diff %q\", args, got, want)\n\t\t}\n\t\t// Make the stat cache stale again for the next read.\n\t\tlater = later.Add(2 * time.Second)\n\t\tif err := os.Chtimes(filepath.Join(root, \"stat.txt\"), later, later); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\t// The review history ledger's own diff (review round 1, N9).\n\tbefore, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := reviewHistoryGit(root, \"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif after, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\")); !bytes.Equal(before, after) {\n\t\tt.Fatal(\"the review history diff rewrote .git/index\")\n\t}\n\tentries, err := os.ReadDir(filepath.Join(root, \".git\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, e := range entries {\n\t\tif filepath.Ext(e.Name()) == \".lock\" {\n\t\t\tt.Fatalf(\"a read left %s\", e.Name())\n\t\t}\n\t}\n}\n\n// Review round 2, N10: an entry racily clean against the index (its file as\n// new as the index) is still compared by content: the copy keeps the index's\n// time, so Git does not trust the stat a fresher copy would make old.\nfunc TestReadOnlyIndexDiffSeesARacilyCleanEntry(t *testing.T) {\n\troot := t.TempDir()\n\tgit := func(args ...string) {\n\t\tt.Helper()\n\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, args...)...).CombinedOutput(); err != nil {\n\t\t\tt.Fatal(args, err, string(out))\n\t\t}\n\t}\n\tgit(\"init\", \"-q\")\n\tfile := filepath.Join(root, \"a.txt\")\n\tif err := os.WriteFile(file, []byte(\"aaaa\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// An old file time, so the entry is written clean, not smudged as racy.\n\tstamp := time.Now().Add(-time.Hour).Truncate(time.Second)\n\tif err := os.Chtimes(file, stamp, stamp); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit(\"add\", \"a.txt\")\n\tgit(\"commit\", \"-q\", \"-m\", \"i\")\n\t// Same size, same time: only the content tells the change.\n\tif err := os.WriteFile(file, []byte(\"bbbb\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, p := range []string{file, filepath.Join(root, \".git\", \"index\")} {\n\t\tif err := os.Chtimes(p, stamp, stamp); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\targs := []string{\"-C\", root, \"-c\", \"core.trustctime=false\", \"diff\", \"--name-only\", \"--\"}\n\tgot, err := RawGitDiffReadOnly(root, args...)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif string(got) != \"a.txt\\n\" {\n\t\tt.Fatalf(\"a racily clean change was hidden: %q\", got)\n\t}\n}\n\n// Review round 4, N21: a FIFO at the index path is refused, not opened,\n// which would block.\nfunc TestReadOnlyIndexRefusesAFIFOIndex(t *testing.T) {\n\tif runtime.GOOS == \"windows\" {\n\t\tt.Skip(\"no FIFOs\")\n\t}\n\troot := t.TempDir()\n\tif out, err := exec.Command(\"git\", \"-C\", root, \"init\", \"-q\").CombinedOutput(); err != nil {\n\t\tt.Fatal(err, string(out))\n\t}\n\tindex := filepath.Join(root, \".git\", \"index\")\n\t_ = os.Remove(index)\n\tif out, err := exec.Command(\"mkfifo\", index).CombinedOutput(); err != nil {\n\t\tt.Skip(\"mkfifo unavailable:\", err, string(out))\n\t}\n\tdone := make(chan error, 1)\n\tgo func() {\n\t\t_, err := RawGitDiffReadOnly(root, \"-C\", root, \"diff\", \"--name-only\", \"--\")\n\t\tdone <- err\n\t}()\n\tselect {\n\tcase err := <-done:\n\t\tif err == nil || !strings.Contains(err.Error(), \"not a regular file\") {\n\t\t\tt.Fatalf(\"a FIFO index: %v\", err)\n\t\t}\n\tcase <-time.After(10 * time.Second):\n\t\tt.Fatal(\"reading a FIFO index blocked\")\n\t}\n}\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\n// staleIndexRepo is a repository whose index holds a stale stat cache for a\n// file whose content did not change, so any read that refreshes the index\n// would write it back.\nfunc staleIndexRepo(t *testing.T) (string, []byte) {\n\tt.Helper()\n\troot := t.TempDir()\n\tgit := func(args ...string) {\n\t\tt.Helper()\n\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, args...)...)\n\t\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t}\n\tgit(\"init\", \"-q\")\n\tif err := os.MkdirAll(filepath.Join(root, \".pose\", \"specs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, f := range []string{\"a.txt\", \".pose/specs/2026-11-26-alpha.md\"} {\n\t\tif err := os.WriteFile(filepath.Join(root, f), []byte(\"x\\n\"), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tgit(\"add\", \"-A\")\n\tgit(\"commit\", \"-q\", \"-m\", \"init\")\n\tlater := time.Now().Add(2 * time.Second)\n\tfor _, f := range []string{\"a.txt\", \".pose/specs/2026-11-26-alpha.md\"} {\n\t\tif err := os.Chtimes(filepath.Join(root, f), later, later); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tindex, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn root, index\n}\n\n// Spec pose-validate-reads-leave-the-index-alone R1, R2: the reads validate,\n// check and report make leave a stale index byte-identical, and still answer\n// that nothing changed.\nfunc TestValidationReadsLeaveTheIndexAlone(t *testing.T) {\n\troot, before := staleIndexRepo(t)\n\tif !materialWorktreeClean(root) {\n\t\tt.Fatal(\"a stat-only change made the work tree dirty\")\n\t}\n\tsel, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n\tif err != nil || len(sel.Changed) != 0 {\n\t\tt.Fatalf(\"the scope diff against the work tree: %v %v\", sel.Changed, err)\n\t}\n\tif files := reportChangedFiles(root, \"HEAD\"); len(files) != 0 {\n\t\tt.Fatalf(\"report listed a stat-only change: %v\", files)\n\t}\n\tif got := (&nativeChecker{root: root}).readyTransitionCandidates(); len(got) != 0 {\n\t\tt.Fatalf(\"the ready transition read listed a stat-only change: %v\", got)\n\t}\n\tafter, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !bytes.Equal(before, after) {\n\t\tt.Fatal(\"a validation read rewrote .git/index\")\n\t}\n}\n\n// Spec pose-validate-reads-leave-the-index-alone R3: while those reads run\n// concurrently, a reader watching .git/index never sees it change.\nfunc TestConcurrentValidationReadsNeverChangeTheIndex(t *testing.T) {\n\troot, before := staleIndexRepo(t)\n\tstop := make(chan struct{})\n\tvar wg sync.WaitGroup\n\tfor i := 0; i < 4; i++ {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tfor j := 0; j < 5; j++ {\n\t\t\t\tmaterialWorktreeClean(root)\n\t\t\t\t_, _ = computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n\t\t\t\treportChangedFiles(root, \"HEAD\")\n\t\t\t\t(&nativeChecker{root: root}).readyTransitionCandidates()\n\t\t\t}\n\t\t}()\n\t}\n\tchanged := make(chan string, 1)\n\tgo func() {\n\t\tfor {\n\t\t\tselect {\n\t\t\tcase <-stop:\n\t\t\t\treturn\n\t\t\tdefault:\n\t\t\t}\n\t\t\tnow, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\t\t\tif err == nil && !bytes.Equal(before, now) {\n\t\t\t\tchanged <- \"the index changed while validation reads ran\"\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif _, err := os.Lstat(filepath.Join(root, \".git\", \"index.lock\")); err == nil {\n\t\t\t\tchanged <- \"a validation read took the index lock\"\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}()\n\twg.Wait()\n\tclose(stop)\n\tselect {\n\tcase why := <-changed:\n\t\tt.Fatal(why)\n\tdefault:\n\t}\n}\n\n// Review round 2, N11: without an index file the reads still answer: the\n// untracked spec is a ready-transition candidate and the report lists it.\nfunc TestValidationReadsAnswerWithoutAnIndex(t *testing.T) {\n\troot, _ := staleIndexRepo(t)\n\tif err := os.Remove(filepath.Join(root, \".git\", \"index\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \".pose\", \"specs\", \"2026-11-26-beta.md\"), []byte(\"x\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfound := false\n\tfor _, c := range (&nativeChecker{root: root}).readyTransitionCandidates() {\n\t\tif strings.HasSuffix(c, \"2026-11-26-beta.md\") {\n\t\t\tfound = true\n\t\t}\n\t}\n\tif !found {\n\t\tt.Fatal(\"the ready transition read lost the new spec without an index\")\n\t}\n\tif files := reportChangedFiles(root, \"\"); len(files) == 0 {\n\t\tt.Fatal(\"report listed nothing without an index\")\n\t}\n\tif _, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{}); err != nil {\n\t\tt.Fatalf(\"scope selection failed without an index: %v\", err)\n\t}\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"b4a71957-fe89-4855-8c00-ef5f8affcc9b","timestamp":"2026-11-26T20:26:42.298Z","tool_use_result":{"stdout":"package pose\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// Spec pose-validate-reads-leave-the-index-alone R1, R2: a diff that reads the\n// index read-only answers exactly as the plain diff does, over the states\n// review round 1 found a status-based reading got wrong, and leaves the index\n// byte-identical where the plain diff rewrites it.\nfunc TestReadOnlyIndexDiffAnswersAsThePlainDiff(t *testing.T) {\n\troot := t.TempDir()\n\trun := func(dir string, args ...string) string {\n\t\tt.Helper()\n\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"-c\", \"protocol.file.allow=always\"}, args...)...)\n\t\tout, err := cmd.CombinedOutput()\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t\treturn string(out)\n\t}\n\twrite := func(rel, body string) {\n\t\tt.Helper()\n\t\tp := filepath.Join(root, rel)\n\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\t// A submodule whose .gitmodules says ignore=all.\n\tsub := t.TempDir()\n\trun(sub, \"init\", \"-q\")\n\tif err := os.WriteFile(filepath.Join(sub, \"s.txt\"), []byte(\"1\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trun(sub, \"add\", \"s.txt\")\n\trun(sub, \"commit\", \"-q\", \"-m\", \"s1\")\n\trun(root, \"init\", \"-q\")\n\tfor _, f := range []string{\"stat.txt\", \"mod.txt\", \"del.txt\", \"proj/back.txt\", \"dir/x.txt\", \"conflict.txt\"} {\n\t\twrite(f, \"x\\n\")\n\t}\n\tif err := os.Symlink(\"target-missing\", filepath.Join(root, \"link\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trun(root, \"add\", \"-A\")\n\trun(root, \"submodule\", \"add\", \"-q\", sub, \"mod\")\n\trun(root, \"config\", \"-f\", \".gitmodules\", \"submodule.mod.ignore\", \"all\")\n\trun(root, \"add\", \".gitmodules\")\n\trun(root, \"commit\", \"-q\", \"-m\", \"base\")\n\tbase := run(root, \"rev-parse\", \"HEAD\")[:40]\n\t// A commit since the base: the gitlink moves, and a file changes and is\n\t// changed back in the work tree.\n\tif err := os.WriteFile(filepath.Join(root, \"mod\", \"s.txt\"), []byte(\"2\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trun(filepath.Join(root, \"mod\"), \"commit\", \"-q\", \"-am\", \"s2\")\n\twrite(\"proj/back.txt\", \"y\\n\")\n\trun(root, \"add\", \"-A\")\n\trun(root, \"commit\", \"-q\", \"-m\", \"next\")\n\twrite(\"proj/back.txt\", \"x\\n\")\n\t// Work-tree states.\n\twrite(\"mod.txt\", \"changed\\n\")\n\tif err := os.Remove(filepath.Join(root, \"del.txt\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\twrite(\"staged.txt\", \"s\\n\")\n\trun(root, \"add\", \"staged.txt\")\n\twrite(\"ita.txt\", \"i\\n\")\n\trun(root, \"add\", \"-N\", \"ita.txt\")\n\twrite(\"conflict.txt\", \"staged then reverted\\n\")\n\trun(root, \"add\", \"conflict.txt\")\n\twrite(\"conflict.txt\", \"x\\n\")\n\tif err := os.RemoveAll(filepath.Join(root, \"dir\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\twrite(\"dir\", \"now a file\\n\")\n\tlater := time.Now().Add(2 * time.Second)\n\tif err := os.Chtimes(filepath.Join(root, \"stat.txt\"), later, later); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treads := [][]string{\n\t\t{\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base, \"--\"},\n\t\t{\"-C\", root, \"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\"},\n\t\t{\"-C\", filepath.Join(root, \"proj\"), \"diff\", \"--name-only\", base},\n\t}\n\tfor _, args := range reads {\n\t\tbefore, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tgot, err := RawGitDiffReadOnly(root, args...)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"%v: %v\", args, err)\n\t\t}\n\t\tafter, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif !bytes.Equal(before, after) {\n\t\t\tt.Fatalf(\"%v rewrote .git/index\", args)\n\t\t}\n\t\twant, err := RawGit(args...).Output()\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif !bytes.Equal(got, want) {\n\t\t\tt.Fatalf(\"%v answered %q, the plain diff %q\", args, got, want)\n\t\t}\n\t\t// Make the stat cache stale again for the next read.\n\t\tlater = later.Add(2 * time.Second)\n\t\tif err := os.Chtimes(filepath.Join(root, \"stat.txt\"), later, later); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\t// The review history ledger's own diff (review round 1, N9).\n\tbefore, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := reviewHistoryGit(root, \"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif after, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\")); !bytes.Equal(before, after) {\n\t\tt.Fatal(\"the review history diff rewrote .git/index\")\n\t}\n\tentries, err := os.ReadDir(filepath.Join(root, \".git\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, e := range entries {\n\t\tif filepath.Ext(e.Name()) == \".lock\" {\n\t\t\tt.Fatalf(\"a read left %s\", e.Name())\n\t\t}\n\t}\n}\n\n// Review round 2, N10: an entry racily clean against the index (its file as\n// new as the index) is still compared by content: the copy keeps the index's\n// time, so Git does not trust the stat a fresher copy would make old.\nfunc TestReadOnlyIndexDiffSeesARacilyCleanEntry(t *testing.T) {\n\troot := t.TempDir()\n\tgit := func(args ...string) {\n\t\tt.Helper()\n\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, args...)...).CombinedOutput(); err != nil {\n\t\t\tt.Fatal(args, err, string(out))\n\t\t}\n\t}\n\tgit(\"init\", \"-q\")\n\tfile := filepath.Join(root, \"a.txt\")\n\tif err := os.WriteFile(file, []byte(\"aaaa\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// An old file time, so the entry is written clean, not smudged as racy.\n\tstamp := time.Now().Add(-time.Hour).Truncate(time.Second)\n\tif err := os.Chtimes(file, stamp, stamp); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit(\"add\", \"a.txt\")\n\tgit(\"commit\", \"-q\", \"-m\", \"i\")\n\t// Same size, same time: only the content tells the change.\n\tif err := os.WriteFile(file, []byte(\"bbbb\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, p := range []string{file, filepath.Join(root, \".git\", \"index\")} {\n\t\tif err := os.Chtimes(p, stamp, stamp); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\targs := []string{\"-C\", root, \"-c\", \"core.trustctime=false\", \"diff\", \"--name-only\", \"--\"}\n\tgot, err := RawGitDiffReadOnly(root, args...)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif string(got) != \"a.txt\\n\" {\n\t\tt.Fatalf(\"a racily clean change was hidden: %q\", got)\n\t}\n}\n\n// Review round 4, N21: a FIFO at the index path is refused, not opened,\n// which would block.\nfunc TestReadOnlyIndexRefusesAFIFOIndex(t *testing.T) {\n\tif runtime.GOOS == \"windows\" {\n\t\tt.Skip(\"no FIFOs\")\n\t}\n\troot := t.TempDir()\n\tif out, err := exec.Command(\"git\", \"-C\", root, \"init\", \"-q\").CombinedOutput(); err != nil {\n\t\tt.Fatal(err, string(out))\n\t}\n\tindex := filepath.Join(root, \".git\", \"index\")\n\t_ = os.Remove(index)\n\tif out, err := exec.Command(\"mkfifo\", index).CombinedOutput(); err != nil {\n\t\tt.Skip(\"mkfifo unavailable:\", err, string(out))\n\t}\n\tdone := make(chan error, 1)\n\tgo func() {\n\t\t_, err := RawGitDiffReadOnly(root, \"-C\", root, \"diff\", \"--name-only\", \"--\")\n\t\tdone <- err\n\t}()\n\tselect {\n\tcase err := <-done:\n\t\tif err == nil || !strings.Contains(err.Error(), \"not a regular file\") {\n\t\t\tt.Fatalf(\"a FIFO index: %v\", err)\n\t\t}\n\tcase <-time.After(10 * time.Second):\n\t\tt.Fatal(\"reading a FIFO index blocked\")\n\t}\n}\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\n// staleIndexRepo is a repository whose index holds a stale stat cache for a\n// file whose content did not change, so any read that refreshes the index\n// would write it back.\nfunc staleIndexRepo(t *testing.T) (string, []byte) {\n\tt.Helper()\n\troot := t.TempDir()\n\tgit := func(args ...string) {\n\t\tt.Helper()\n\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, args...)...)\n\t\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t}\n\tgit(\"init\", \"-q\")\n\tif err := os.MkdirAll(filepath.Join(root, \".pose\", \"specs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, f := range []string{\"a.txt\", \".pose/specs/2026-11-26-alpha.md\"} {\n\t\tif err := os.WriteFile(filepath.Join(root, f), []byte(\"x\\n\"), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tgit(\"add\", \"-A\")\n\tgit(\"commit\", \"-q\", \"-m\", \"init\")\n\tlater := time.Now().Add(2 * time.Second)\n\tfor _, f := range []string{\"a.txt\", \".pose/specs/2026-11-26-alpha.md\"} {\n\t\tif err := os.Chtimes(filepath.Join(root, f), later, later); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tindex, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn root, index\n}\n\n// Spec pose-validate-reads-leave-the-index-alone R1, R2: the reads validate,\n// check and report make leave a stale index byte-identical, and still answer\n// that nothing changed.\nfunc TestValidationReadsLeaveTheIndexAlone(t *testing.T) {\n\troot, before := staleIndexRepo(t)\n\tif !materialWorktreeClean(root) {\n\t\tt.Fatal(\"a stat-only change made the work tree dirty\")\n\t}\n\tsel, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n\tif err != nil || len(sel.Changed) != 0 {\n\t\tt.Fatalf(\"the scope diff against the work tree: %v %v\", sel.Changed, err)\n\t}\n\tif files := reportChangedFiles(root, \"HEAD\"); len(files) != 0 {\n\t\tt.Fatalf(\"report listed a stat-only change: %v\", files)\n\t}\n\tif got := (&nativeChecker{root: root}).readyTransitionCandidates(); len(got) != 0 {\n\t\tt.Fatalf(\"the ready transition read listed a stat-only change: %v\", got)\n\t}\n\tafter, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !bytes.Equal(before, after) {\n\t\tt.Fatal(\"a validation read rewrote .git/index\")\n\t}\n}\n\n// Spec pose-validate-reads-leave-the-index-alone R3: while those reads run\n// concurrently, a reader watching .git/index never sees it change.\nfunc TestConcurrentValidationReadsNeverChangeTheIndex(t *testing.T) {\n\troot, before := staleIndexRepo(t)\n\tstop := make(chan struct{})\n\tvar wg sync.WaitGroup\n\tfor i := 0; i < 4; i++ {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tfor j := 0; j < 5; j++ {\n\t\t\t\tmaterialWorktreeClean(root)\n\t\t\t\t_, _ = computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n\t\t\t\treportChangedFiles(root, \"HEAD\")\n\t\t\t\t(&nativeChecker{root: root}).readyTransitionCandidates()\n\t\t\t}\n\t\t}()\n\t}\n\tchanged := make(chan string, 1)\n\tgo func() {\n\t\tfor {\n\t\t\tselect {\n\t\t\tcase <-stop:\n\t\t\t\treturn\n\t\t\tdefault:\n\t\t\t}\n\t\t\tnow, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\t\t\tif err == nil && !bytes.Equal(before, now) {\n\t\t\t\tchanged <- \"the index changed while validation reads ran\"\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif _, err := os.Lstat(filepath.Join(root, \".git\", \"index.lock\")); err == nil {\n\t\t\t\tchanged <- \"a validation read took the index lock\"\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}()\n\twg.Wait()\n\tclose(stop)\n\tselect {\n\tcase why := <-changed:\n\t\tt.Fatal(why)\n\tdefault:\n\t}\n}\n\n// Review round 2, N11: without an index file the reads still answer: the\n// untracked spec is a ready-transition candidate and the report lists it.\nfunc TestValidationReadsAnswerWithoutAnIndex(t *testing.T) {\n\troot, _ := staleIndexRepo(t)\n\tif err := os.Remove(filepath.Join(root, \".git\", \"index\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \".pose\", \"specs\", \"2026-11-26-beta.md\"), []byte(\"x\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfound := false\n\tfor _, c := range (&nativeChecker{root: root}).readyTransitionCandidates() {\n\t\tif strings.HasSuffix(c, \"2026-11-26-beta.md\") {\n\t\t\tfound = true\n\t\t}\n\t}\n\tif !found {\n\t\tt.Fatal(\"the ready transition read lost the new spec without an index\")\n\t}\n\tif files := reportChangedFiles(root, \"\"); len(files) == 0 {\n\t\tt.Fatal(\"report listed nothing without an index\")\n\t}\n\tif _, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{}); err != nil {\n\t\tt.Fatalf(\"scope selection failed without an index: %v\", err)\n\t}\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Vtq6PoE4aeJLiShXUephEV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChSAixc1rRMN2VHthJi6B","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FH1bmPAmTGwfXcskn8tMYd","name":"Read","input":{"file_path":"/var/tmp/pose-work-go/pose-review-run-0207467d72/worktree/.pose/specs/2026-11-23-pose-validate-reads-leave-the-index-alone.md"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6032,"cache_read_input_tokens":34373,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6032},"output_tokens":21,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"271785c6-2f0b-494d-8ca0-984d95ef283d","timestamp":"2026-11-26T20:26:43.504Z","request_id":"req_011ChSAixQcVen31LM5jQRNF","wire_tool_inputs":{"toolu_01FH1bmPAmTGwfXcskn8tMYd":{"file_path":"/var/tmp/pose-work-go/pose-review-run-0207467d72/worktree/.pose/specs/2026-11-23-pose-validate-reads-leave-the-index-alone.md"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FH1bmPAmTGwfXcskn8tMYd","type":"tool_result","content":"1\t---\n2\tslug: pose-validate-reads-leave-the-index-alone\n3\tstatus: draft\n4\tcreated_at: 2026-11-23\n5\tcompleted_at:\n6\tsupersedes:\n7\tdepends_on: \n8\tremediates:\n9\tpriority: 2\n10\tcomponents: pose-mcp\n11\ttask_type: bugfix\n12\tsurface: standard\n13\tdelivers: capability:validate-reads-leave-the-index-alone\n14\t---\n15\t\n16\t# Spec: pose-validate-reads-leave-the-index-alone\n17\t\n18\t## 1. Intent\n19\t\n20\t### Goal\n21\tMake the engine's own Git reads during `pose validate` and `pose check`, such as the provenance status of `validate`, never rewrite `.git/index` or take index locks in the validated checkout.\n22\t\n23\t### Business value\n24\tIn Harne8 the governance read view of `instance-health-composite` failed intermittently with `review inputs changed during operation: .git` because concurrent reads refreshed the index stat cache. The Harne8 bugfix `harne8-validation-reads-leave-root-index-alone` fixed the instance's own scripts and left this engine part as its follow-up F1.\n25\t\n26\t### Constraints\n27\tReads keep their results. Stale stat caches may cost time, never correctness.\n28\t\n29\t### Non-goals\n30\tChanging which files are compared.\n31\t\n32\t## 2. Requirements\n33\t\n34\t### Functional\n35\t- R1: Every status, diff and ls-files read the engine makes for validation provenance, material cleanliness and readiness checks shall run with optional locks disabled, and a diff against the work tree shall read the index without being able to write it, so none rewrites `.git/index` or takes its lock (D1).\n36\t- R2: A regression test shall run those reads over a checkout with a stale stat cache and prove `.git/index` byte-identical afterwards.\n37\t- R3: A concurrency test shall run those reads together on one checkout while a reader watches `.git/index` and its lock, and see neither change (D2).\n38\t\n39\t### Non-functional\n40\tExisting behaviour outside the stated requirements is unchanged.\n41\t\n42\t### Security\n43\tNo new input crosses a trust boundary without the existing confinement.\n44\t\n45\t### Compatibility\n46\tRecords and indexes written by earlier engines keep their meaning.\n47\t\n48\t## 3. Technical Plan\n49\t\n50\t### Affected areas\n51\t`pose-mcp`: the engine's Git command constructor (`gitCommandContext`), work-tree read helpers (`git_worktree_reads.go`), and the work-tree diffs of `check` (ready transitions), `validate` scope selection, `report` and the review history ledger.\n52\t\n53\t### Artifacts\n54\t- created: .pose/specs/2026-11-23-pose-validate-reads-leave-the-index-alone.md\n55\t- modified: pose-mcp/internal/pose/git_snapshot_integrity.go\n56\t- created: pose-mcp/internal/pose/git_worktree_reads.go\n57\t- created: pose-mcp/internal/pose/git_worktree_reads_test.go\n58\t- created: pose-mcp/internal/pose/git_worktree_reads_linux.go\n59\t- created: pose-mcp/internal/pose/git_worktree_reads_other.go\n60\t- modified: pose-mcp/internal/pose/review_attempt_ledger.go\n61\t- modified: pose-mcp/internal/cli/check.go\n62\t- modified: pose-mcp/internal/cli/validate_scope.go\n63\t- modified: pose-mcp/internal/cli/report.go\n64\t- created: pose-mcp/internal/cli/validate_reads_index_test.go\n65\t\n66\t### Delivery targets\n67\t- capability:validate-reads-leave-the-index-alone module:pose-mcp profile:composed-capability entrypoint:pose-mcp/internal/cli/validate.go\n68\t\n69\t### Accepted limits\n70\t- L1: A Git command the engine runs through another constructor, or a tool a validation step runs, can still refresh the index. Accepted because every engine read goes through `gitCommandContext`, and what a step runs is the project's command, which the Harne8 bugfix of its own scripts already covers.\n71\t- L2: Outside Linux there is no anonymous memory file, so a diff reads a private copy of the index in a temporary directory, which a dry run there would create. Accepted because the copy keeps the checkout's index untouched, which is the defect, and the dry-run test that forbids any file runs on Linux only.\n72\t\n73\t### API/contract changes\n74\tNone: the reads answer as before; only where their stat refresh is written changes.\n75\t\n76\t### Data/storage changes\n77\tNone.\n78\t\n79\t### Technical risks\n80\tIf Git stopped skipping a failed refresh lock silently, the diff would fail instead of answering; the equivalence test would show it.\n81\t\n82\t## 4. Tasks\n83\t\n84\t### Planning\n85\t- [x] Confirm the requirements against the current engine before starting.\n86\t\n87\t### Implementation\n88\t- [x] Implement each requirement with a test that fails before it.\n89\t\n90\t### Validation\n91\t- [ ] `pose validate --carry` and `pose check --strict`.\n92\t\n93\t## 5. Decisions\n94\t\n95\t### Decision D1\n96\t- Basis: R1\n97\tR1 as drafted asked for `diff.autoRefreshIndex=false`. Measured on a stale stat cache, `git diff --name-only HEAD` rewrites the index even with `GIT_OPTIONAL_LOCKS=0`, and with `diff.autoRefreshIndex=false` it lists a file whose stat alone changed, which breaks the constraint that reads keep their results. So every engine Git command carries `GIT_OPTIONAL_LOCKS=0` (enough for `git status`), and a diff against the work tree runs unchanged but reads the index through `GIT_INDEX_FILE=/proc/self/fd/N`, an anonymous memory file (`memfd`) holding the index's bytes. Git resolves that link to `/memfd:pose-index/none (deleted)`, cannot create its lock beside it (the directory does not exist, for any user), and skips the refresh write silently, so the answer is the plain diff's and nothing is written. The memory file keeps the index's modification time, because Git trusts an entry's stat only when its file is older than the index: a fresher copy would hide a change made in the index's own second. A repository without an index file reads plainly, as there is no stat cache to write. Two earlier versions were refused: a private copy of the index in a temporary file, by the full suite (a dry run creates no file, `TestUpdatePreviewHasNoPhysicalMutationEvents`); and answers rebuilt from `git status`, by review round 1, which found five states they got wrong (submodules ignored by configuration, conflicts, symlinks, a POSE root below the repository top). Outside Linux the copy is used (L2).\n98\t\n99\t### Decision D2\n100\t- Basis: R3\n101\tR3 as drafted ran `validate` and `check --strict` together. The property they broke is that a reader saw `.git` change under it; the test runs the reads those commands make, concurrently, while a reader watches `.git/index` and `index.lock`, which shows the property directly and runs in under a second instead of a full validation.\n102\t\n103\t## 6. Validation\n104\t\n105\t### Strategy\n106\tEach requirement gets a regression test shown failing before its code.\n107\t\n108\t### Deterministic checks\n109\t\n110\t#### Test\n111\t- Command: `go test ./...` (in `pose-mcp`), then `pose validate --carry`.\n112\t\n113\t### Execution log\n114\t- 2026-11-26: `GIT_OPTIONAL_LOCKS=0` in `gitCommandContext`; the work-tree diffs of the ready-transition read, scope selection, `report --since` and the review history ledger read `git status` (`WorktreeChanges`, `WorktreeChangedNames`). `TestValidationReadsLeaveTheIndexAlone`, `TestConcurrentValidationReadsNeverChangeTheIndex` and `TestWorktreeReadsLeaveTheIndexAlone` fail with each guard mutated out (the optional-locks setting, each caller's `git diff` restored, the content comparison); the last also checks the answers equal `git diff` for a commit since the base, a modified, a deleted and a staged-new file. A first private-index version was refused by the full suite (D1).\n115\t- 2026-11-26: review round 1 (rrn-b249b5d958a5d8ff) requested changes with N1–N9: the status-based answers differed from `git diff` for a submodule ignored by `.gitmodules`, a submodule with uncommitted content, symlinks and a directory replaced by a file, unmerged entries, a POSE root below the repository top, intent-to-add, staged-then-reverted changes and a range base. They were withdrawn: the callers run their original `git diff` again, reading the index through a `memfd` (D1). `TestReadOnlyIndexDiffAnswersAsThePlainDiff` builds those states and requires each read to answer byte for byte as the plain diff, leave `.git/index` identical and leave no lock; it also runs the review history ledger's diff (N9). Each guard fails its test mutated out.\n116\t- 2026-11-26: review round 2 (rrn-233e9d0e27a7230a) requested changes. N10: the memfd carried a new time, so a racily clean entry was trusted on its stat and a real change was hidden; the memfd (and the copy outside Linux) now keeps the index's modification time, and `TestReadOnlyIndexDiffSeesARacilyCleanEntry` fails with the current time in its place. N11: without an index file the read runs plainly instead of failing, and `check` applies the read-only index to its diff only (`TestValidationReadsAnswerWithoutAnIndex` fails with the missing-index case removed; the diff-only restriction is behaviour-preserving, as `ls-files` never writes, and has no test of its own). N13: scope selection keeps the cause of a failed read, and the index read reports its own error. N12 is a follow-up.\n117\t- 2026-11-26: review round 3 requested changes with follow-ups only (N14–N17), because its sandbox rerun of `validate` failed for environment reasons and was recorded `failed`. N17: the index is checked and read through one open file within the bound. N14–N16 are follow-ups.\n118\t- 2026-11-26: review round 4 (rrn-282d73ecd35bcc64) raised follow-ups only and requested changes for its failed sandbox `validate`, as round 3 did. N21: a FIFO or device at the index path is refused before it is opened, and the opened file must be the one checked (`TestReadOnlyIndexRefusesAFIFOIndex` blocks with the check removed). N18–N20 are the recorded follow-ups.\n119\t\n120\t### Results summary\n121\tThe full `pose-mcp` suite passes; the canonical result is refreshed with `pose validate --carry`.\n122\t\n123\t### Requirement trace\n124\t- R1 [satisfied] test:TestReadOnlyIndexRefusesAFIFOIndex, test:TestValidationReadsLeaveTheIndexAlone, test:TestReadOnlyIndexDiffAnswersAsThePlainDiff, test:TestReadOnlyIndexDiffSeesARacilyCleanEntry, test:TestValidationReadsAnswerWithoutAnIndex\n125\t- R2 [satisfied] test:TestValidationReadsLeaveTheIndexAlone\n126\t- R3 [satisfied] test:TestConcurrentValidationReadsNeverChangeTheIndex\n127\t\n128\t### Known gaps\n129\tNone.\n130\t\n131\t## 7. Final Report\n132\t\n133\t### Delivered scope\n134\tThe engine's Git reads during `validate`, `check` and `report` no longer rewrite `.git/index` or take its lock, and keep their answers.\n135\t\n136\t### Files and modules changed\n137\t`pose-mcp` Git command construction and the work-tree diffs of check, validate scope, report and the review history ledger.\n138\t\n139\t### Validation executed\n140\t`go test ./...` in `pose-mcp`; `pose check --strict`; `pose validate --carry --json-out .pose/results/delivery-validation.json`.\n141\t\n142\t### Residual risks\n143\tL1 and L2 above.\n144\t\n145\t### Follow-ups\n146\t- [open] Keep a split-index read from touching the modification time of `.git/sharedindex.<hash>`, which Git updates when it reads the shared index (review rounds 2 N12, 3 N15). (owner:@pose-maintainers crit:low review:2026-12-26)\n147\t- [open] Report a failed index read in the ready-transition check instead of dropping its diff, and bound the index location lookup by the caller's deadline (review round 3, N14). (owner:@pose-maintainers crit:low review:2026-12-26)\n148\t- [open] Add unmerged, range-base and dirty-submodule cases to the read-only diff equivalence test, and run the review history reader in the CLI concurrency test (review round 3, N16). (owner:@pose-maintainers crit:low review:2026-12-26)\n149\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"8d569982-b84b-4995-bcaf-558091c4da09","timestamp":"2026-11-26T20:26:43.515Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-0207467d72/worktree/.pose/specs/2026-11-23-pose-validate-reads-leave-the-index-alone.md","content":"---\nslug: pose-validate-reads-leave-the-index-alone\nstatus: draft\ncreated_at: 2026-11-23\ncompleted_at:\nsupersedes:\ndepends_on: \nremediates:\npriority: 2\ncomponents: pose-mcp\ntask_type: bugfix\nsurface: standard\ndelivers: capability:validate-reads-leave-the-index-alone\n---\n\n# Spec: pose-validate-reads-leave-the-index-alone\n\n## 1. Intent\n\n### Goal\nMake the engine's own Git reads during `pose validate` and `pose check`, such as the provenance status of `validate`, never rewrite `.git/index` or take index locks in the validated checkout.\n\n### Business value\nIn Harne8 the governance read view of `instance-health-composite` failed intermittently with `review inputs changed during operation: .git` because concurrent reads refreshed the index stat cache. The Harne8 bugfix `harne8-validation-reads-leave-root-index-alone` fixed the instance's own scripts and left this engine part as its follow-up F1.\n\n### Constraints\nReads keep their results. Stale stat caches may cost time, never correctness.\n\n### Non-goals\nChanging which files are compared.\n\n## 2. Requirements\n\n### Functional\n- R1: Every status, diff and ls-files read the engine makes for validation provenance, material cleanliness and readiness checks shall run with optional locks disabled, and a diff against the work tree shall read the index without being able to write it, so none rewrites `.git/index` or takes its lock (D1).\n- R2: A regression test shall run those reads over a checkout with a stale stat cache and prove `.git/index` byte-identical afterwards.\n- R3: A concurrency test shall run those reads together on one checkout while a reader watches `.git/index` and its lock, and see neither change (D2).\n\n### Non-functional\nExisting behaviour outside the stated requirements is unchanged.\n\n### Security\nNo new input crosses a trust boundary without the existing confinement.\n\n### Compatibility\nRecords and indexes written by earlier engines keep their meaning.\n\n## 3. Technical Plan\n\n### Affected areas\n`pose-mcp`: the engine's Git command constructor (`gitCommandContext`), work-tree read helpers (`git_worktree_reads.go`), and the work-tree diffs of `check` (ready transitions), `validate` scope selection, `report` and the review history ledger.\n\n### Artifacts\n- created: .pose/specs/2026-11-23-pose-validate-reads-leave-the-index-alone.md\n- modified: pose-mcp/internal/pose/git_snapshot_integrity.go\n- created: pose-mcp/internal/pose/git_worktree_reads.go\n- created: pose-mcp/internal/pose/git_worktree_reads_test.go\n- created: pose-mcp/internal/pose/git_worktree_reads_linux.go\n- created: pose-mcp/internal/pose/git_worktree_reads_other.go\n- modified: pose-mcp/internal/pose/review_attempt_ledger.go\n- modified: pose-mcp/internal/cli/check.go\n- modified: pose-mcp/internal/cli/validate_scope.go\n- modified: pose-mcp/internal/cli/report.go\n- created: pose-mcp/internal/cli/validate_reads_index_test.go\n\n### Delivery targets\n- capability:validate-reads-leave-the-index-alone module:pose-mcp profile:composed-capability entrypoint:pose-mcp/internal/cli/validate.go\n\n### Accepted limits\n- L1: A Git command the engine runs through another constructor, or a tool a validation step runs, can still refresh the index. Accepted because every engine read goes through `gitCommandContext`, and what a step runs is the project's command, which the Harne8 bugfix of its own scripts already covers.\n- L2: Outside Linux there is no anonymous memory file, so a diff reads a private copy of the index in a temporary directory, which a dry run there would create. Accepted because the copy keeps the checkout's index untouched, which is the defect, and the dry-run test that forbids any file runs on Linux only.\n\n### API/contract changes\nNone: the reads answer as before; only where their stat refresh is written changes.\n\n### Data/storage changes\nNone.\n\n### Technical risks\nIf Git stopped skipping a failed refresh lock silently, the diff would fail instead of answering; the equivalence test would show it.\n\n## 4. Tasks\n\n### Planning\n- [x] Confirm the requirements against the current engine before starting.\n\n### Implementation\n- [x] Implement each requirement with a test that fails before it.\n\n### Validation\n- [ ] `pose validate --carry` and `pose check --strict`.\n\n## 5. Decisions\n\n### Decision D1\n- Basis: R1\nR1 as drafted asked for `diff.autoRefreshIndex=false`. Measured on a stale stat cache, `git diff --name-only HEAD` rewrites the index even with `GIT_OPTIONAL_LOCKS=0`, and with `diff.autoRefreshIndex=false` it lists a file whose stat alone changed, which breaks the constraint that reads keep their results. So every engine Git command carries `GIT_OPTIONAL_LOCKS=0` (enough for `git status`), and a diff against the work tree runs unchanged but reads the index through `GIT_INDEX_FILE=/proc/self/fd/N`, an anonymous memory file (`memfd`) holding the index's bytes. Git resolves that link to `/memfd:pose-index/none (deleted)`, cannot create its lock beside it (the directory does not exist, for any user), and skips the refresh write silently, so the answer is the plain diff's and nothing is written. The memory file keeps the index's modification time, because Git trusts an entry's stat only when its file is older than the index: a fresher copy would hide a change made in the index's own second. A repository without an index file reads plainly, as there is no stat cache to write. Two earlier versions were refused: a private copy of the index in a temporary file, by the full suite (a dry run creates no file, `TestUpdatePreviewHasNoPhysicalMutationEvents`); and answers rebuilt from `git status`, by review round 1, which found five states they got wrong (submodules ignored by configuration, conflicts, symlinks, a POSE root below the repository top). Outside Linux the copy is used (L2).\n\n### Decision D2\n- Basis: R3\nR3 as drafted ran `validate` and `check --strict` together. The property they broke is that a reader saw `.git` change under it; the test runs the reads those commands make, concurrently, while a reader watches `.git/index` and `index.lock`, which shows the property directly and runs in under a second instead of a full validation.\n\n## 6. Validation\n\n### Strategy\nEach requirement gets a regression test shown failing before its code.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./...` (in `pose-mcp`), then `pose validate --carry`.\n\n### Execution log\n- 2026-11-26: `GIT_OPTIONAL_LOCKS=0` in `gitCommandContext`; the work-tree diffs of the ready-transition read, scope selection, `report --since` and the review history ledger read `git status` (`WorktreeChanges`, `WorktreeChangedNames`). `TestValidationReadsLeaveTheIndexAlone`, `TestConcurrentValidationReadsNeverChangeTheIndex` and `TestWorktreeReadsLeaveTheIndexAlone` fail with each guard mutated out (the optional-locks setting, each caller's `git diff` restored, the content comparison); the last also checks the answers equal `git diff` for a commit since the base, a modified, a deleted and a staged-new file. A first private-index version was refused by the full suite (D1).\n- 2026-11-26: review round 1 (rrn-b249b5d958a5d8ff) requested changes with N1–N9: the status-based answers differed from `git diff` for a submodule ignored by `.gitmodules`, a submodule with uncommitted content, symlinks and a directory replaced by a file, unmerged entries, a POSE root below the repository top, intent-to-add, staged-then-reverted changes and a range base. They were withdrawn: the callers run their original `git diff` again, reading the index through a `memfd` (D1). `TestReadOnlyIndexDiffAnswersAsThePlainDiff` builds those states and requires each read to answer byte for byte as the plain diff, leave `.git/index` identical and leave no lock; it also runs the review history ledger's diff (N9). Each guard fails its test mutated out.\n- 2026-11-26: review round 2 (rrn-233e9d0e27a7230a) requested changes. N10: the memfd carried a new time, so a racily clean entry was trusted on its stat and a real change was hidden; the memfd (and the copy outside Linux) now keeps the index's modification time, and `TestReadOnlyIndexDiffSeesARacilyCleanEntry` fails with the current time in its place. N11: without an index file the read runs plainly instead of failing, and `check` applies the read-only index to its diff only (`TestValidationReadsAnswerWithoutAnIndex` fails with the missing-index case removed; the diff-only restriction is behaviour-preserving, as `ls-files` never writes, and has no test of its own). N13: scope selection keeps the cause of a failed read, and the index read reports its own error. N12 is a follow-up.\n- 2026-11-26: review round 3 requested changes with follow-ups only (N14–N17), because its sandbox rerun of `validate` failed for environment reasons and was recorded `failed`. N17: the index is checked and read through one open file within the bound. N14–N16 are follow-ups.\n- 2026-11-26: review round 4 (rrn-282d73ecd35bcc64) raised follow-ups only and requested changes for its failed sandbox `validate`, as round 3 did. N21: a FIFO or device at the index path is refused before it is opened, and the opened file must be the one checked (`TestReadOnlyIndexRefusesAFIFOIndex` blocks with the check removed). N18–N20 are the recorded follow-ups.\n\n### Results summary\nThe full `pose-mcp` suite passes; the canonical result is refreshed with `pose validate --carry`.\n\n### Requirement trace\n- R1 [satisfied] test:TestReadOnlyIndexRefusesAFIFOIndex, test:TestValidationReadsLeaveTheIndexAlone, test:TestReadOnlyIndexDiffAnswersAsThePlainDiff, test:TestReadOnlyIndexDiffSeesARacilyCleanEntry, test:TestValidationReadsAnswerWithoutAnIndex\n- R2 [satisfied] test:TestValidationReadsLeaveTheIndexAlone\n- R3 [satisfied] test:TestConcurrentValidationReadsNeverChangeTheIndex\n\n### Known gaps\nNone.\n\n## 7. Final Report\n\n### Delivered scope\nThe engine's Git reads during `validate`, `check` and `report` no longer rewrite `.git/index` or take its lock, and keep their answers.\n\n### Files and modules changed\n`pose-mcp` Git command construction and the work-tree diffs of check, validate scope, report and the review history ledger.\n\n### Validation executed\n`go test ./...` in `pose-mcp`; `pose check --strict`; `pose validate --carry --json-out .pose/results/delivery-validation.json`.\n\n### Residual risks\nL1 and L2 above.\n\n### Follow-ups\n- [open] Keep a split-index read from touching the modification time of `.git/sharedindex.<hash>`, which Git updates when it reads the shared index (review rounds 2 N12, 3 N15). (owner:@pose-maintainers crit:low review:2026-12-26)\n- [open] Report a failed index read in the ready-transition check instead of dropping its diff, and bound the index location lookup by the caller's deadline (review round 3, N14). (owner:@pose-maintainers crit:low review:2026-12-26)\n- [open] Add unmerged, range-base and dirty-submodule cases to the read-only diff equivalence test, and run the review history reader in the CLI concurrency test (review round 3, N16). (owner:@pose-maintainers crit:low review:2026-12-26)\n","numLines":149,"startLine":1,"totalLines":149}},"tool_result_meta":[{"id":"toolu_01FH1bmPAmTGwfXcskn8tMYd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
