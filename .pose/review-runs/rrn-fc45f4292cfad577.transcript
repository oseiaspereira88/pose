sist {\n+\t\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/technical-debt.md and .pose/state/technical-debt.json\\n\")\n+\t}\n \treturn 0\n }\ndiff --git a/pose-mcp/internal/cli/assess_sealed_test.go b/pose-mcp/internal/cli/assess_sealed_test.go\nnew file mode 100644\nindex 00000000..2d789a29\n--- /dev/null\n+++ b/pose-mcp/internal/cli/assess_sealed_test.go\n@@ -0,0 +1,107 @@\n+package cli\n+\n+import (\n+\t\"crypto/sha256\"\n+\t\"encoding/hex\"\n+\t\"io/fs\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"sort\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/harne8/pose-mcp/internal/pose\"\n+)\n+\n+// treeDigest names every file under root with its content, so any write,\n+// creation or removal changes it.\n+func treeDigest(t *testing.T, root string) string {\n+\tt.Helper()\n+\tvar lines []string\n+\terr := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {\n+\t\tif err != nil || d.IsDir() {\n+\t\t\treturn err\n+\t\t}\n+\t\traw, err := os.ReadFile(path)\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\tsum := sha256.Sum256(raw)\n+\t\trel, _ := filepath.Rel(root, path)\n+\t\tlines = append(lines, rel+\" \"+hex.EncodeToString(sum[:]))\n+\t\treturn nil\n+\t})\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tsort.Strings(lines)\n+\treturn strings.Join(lines, \"\\n\")\n+}\n+\n+func assessSealedRoot(t *testing.T) string {\n+\tt.Helper()\n+\troot := assessTestRoot(t)\n+\twriteCloseoutCLIFile(t, root, \"svc/main.go\", \"package main\\n\\n// TODO: a marker\\nfunc main() {}\\n\")\n+\twriteCloseoutCLIFile(t, root, \"svc/go.mod\", \"module example.com/svc\\n\\ngo 1.22\\n\")\n+\twriteCloseoutCLIFile(t, root, \".pose/state/project-state.md\", \"# Project state\\n\")\n+\treturn root\n+}\n+\n+// Spec pose-assess-leaves-sealed-checkouts-alone R2, R4: inside the sealed\n+// checkout of a delegated review every assessment command leaves the tree\n+// as it was, and the ones that only write refuse.\n+func TestAssessLeavesTheSealedCheckoutUnchanged(t *testing.T) {\n+\troot := assessSealedRoot(t)\n+\tt.Setenv(pose.SealedCheckoutEnv, root)\n+\tbefore := treeDigest(t, root)\n+\tfor _, args := range [][]string{\n+\t\t{\"discover\"}, {\"discover\", \"--update-state\"}, {\"discover\", \"--component\", \"svc\", \"--if-stale\"},\n+\t\t{\"integrate\"}, {\"integrate\", \"--update-state\", \"--json\"},\n+\t\t{\"tech-debt\"}, {\"tech-debt\", \"--update-state\"},\n+\t} {\n+\t\tcode, out, errOut := runAssess(t, root, args...)\n+\t\tif code != 0 || !strings.Contains(errOut, \"sealed checkout of a delegated review\") {\n+\t\t\tt.Fatalf(\"assess %v: %d %s %s\", args, code, out, errOut)\n+\t\t}\n+\t\tif strings.Contains(out, \"Artifacts written\") {\n+\t\t\tt.Fatalf(\"assess %v claims it wrote: %s\", args, out)\n+\t\t}\n+\t\tif after := treeDigest(t, root); after != before {\n+\t\t\tt.Fatalf(\"assess %v changed the sealed checkout:\\n%s\\n---\\n%s\", args, before, after)\n+\t\t}\n+\t}\n+\tfor _, sub := range []string{\"init\", \"snapshot\", \"request\"} {\n+\t\tif code, _, errOut := runAssess(t, root, sub); code == 0 || !strings.Contains(errOut, \"sealed review checkout\") {\n+\t\t\tt.Fatalf(\"assess %s ran in the sealed checkout: %d %s\", sub, code, errOut)\n+\t\t}\n+\t}\n+\tif after := treeDigest(t, root); after != before {\n+\t\tt.Fatal(\"a refused assess command changed the sealed checkout\")\n+\t}\n+\t// The writers refuse on their own, for any other caller.\n+\tif err := (pose.Store{Root: root}).SaveTechDebtReport(&pose.TechDebtReportState{}); err != pose.ErrSealedAssessmentWrite {\n+\t\tt.Fatalf(\"the tech-debt writer wrote into the sealed checkout: %v\", err)\n+\t}\n+}\n+\n+// R1: --no-persist prints the result and writes nothing anywhere; without it\n+// and outside a sealed checkout the records are written as before.\n+func TestAssessNoPersistWritesNothing(t *testing.T) {\n+\troot := assessSealedRoot(t)\n+\tbefore := treeDigest(t, root)\n+\tfor _, sub := range []string{\"discover\", \"integrate\", \"tech-debt\"} {\n+\t\tcode, out, errOut := runAssess(t, root, sub, \"--no-persist\", \"--update-state\")\n+\t\tif code != 0 || !strings.Contains(errOut, \"--no-persist\") || out == \"\" {\n+\t\t\tt.Fatalf(\"assess %s --no-persist: %d %s %s\", sub, code, out, errOut)\n+\t\t}\n+\t\tif after := treeDigest(t, root); after != before {\n+\t\t\tt.Fatalf(\"assess %s --no-persist wrote\", sub)\n+\t\t}\n+\t}\n+\tif code, _, errOut := runAssess(t, root, \"tech-debt\"); code != 0 {\n+\t\tt.Fatal(errOut)\n+\t}\n+\tif _, err := os.Stat(filepath.Join(root, \".pose/state/technical-debt.json\")); err != nil {\n+\t\tt.Fatalf(\"a persisting run outside a sealed checkout wrote nothing: %v\", err)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/check.go b/pose-mcp/internal/cli/check.go\nindex 991e096c..6442799f 100644\n--- a/pose-mcp/internal/cli/check.go\n+++ b/pose-mcp/internal/cli/check.go\n@@ -1131,7 +1131,19 @@ func (checker *nativeChecker) readyTransitionCandidates() []string {\n \t\t{\"diff\", \"--name-only\", \"HEAD\", \"--\", \".pose/specs\"},\n \t\t{\"ls-files\", \"--others\", \"--exclude-standard\", \"--\", \".pose/specs\"},\n \t} {\n-\t\toutput, err := pose.RawHistoryGit(checker.root, command...).Output()\n+\t\t// The diff reads the index without writing it (spec\n+\t\t// pose-validate-reads-leave-the-index-alone R1).\n+\t\tcmd := pose.RawHistoryGit(checker.root, command...)\n+\t\tdone := func() {}\n+\t\tif command[0] == \"diff\" {\n+\t\t\tvar err error\n+\t\t\tif done, err = pose.ReadOnlyIndex(cmd, checker.root); err != nil {\n+\t\t\t\tdone()\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t}\n+\t\toutput, err := cmd.Output()\n+\t\tdone()\n \t\tif err != nil {\n \t\t\tcontinue\n \t\t}\ndiff --git a/pose-mcp/internal/cli/cli.go b/pose-mcp/internal/cli/cli.go\nindex 5bb875d0..29930fe2 100644\n--- a/pose-mcp/internal/cli/cli.go\n+++ b/pose-mcp/internal/cli/cli.go\n@@ -25,6 +25,9 @@ func init() {\n \n // Main is the entrypoint used by cmd/pose. It returns the process exit code.\n func Main(args []string, stdout, stderr io.Writer) int {\n+\tif len(args) > 0 && args[0] == posemodel.ReviewShimArg {\n+\t\treturn posemodel.RunReviewShim(args[1:])\n+\t}\n \treturn mainWithUsage(args, stdout, stderr)\n }\n \ndiff --git a/pose-mcp/internal/cli/cli_test.go b/pose-mcp/internal/cli/cli_test.go\nindex 7d5d1239..bb39972b 100644\n--- a/pose-mcp/internal/cli/cli_test.go\n+++ b/pose-mcp/internal/cli/cli_test.go\n@@ -16,6 +16,11 @@ import (\n )\n \n func TestMain(m *testing.M) {\n+\t// A dispatch re-enters this binary as the review run shim.\n+\tif len(os.Args) > 1 && os.Args[1] == posemodel.ReviewShimArg {\n+\t\tos.Exit(posemodel.RunReviewShim(os.Args[2:]))\n+\t}\n+\tposemodel.ReviewShimAvailable = true\n \tif posemodel.EngineVersion == \"unknown\" {\n \t\tposemodel.EngineVersion = \"pose-test-engine\"\n \t}\ndiff --git a/pose-mcp/internal/cli/delegate.go b/pose-mcp/internal/cli/delegate.go\nindex 68bc3831..d4985971 100644\n--- a/pose-mcp/internal/cli/delegate.go\n+++ b/pose-mcp/internal/cli/delegate.go\n@@ -63,7 +63,7 @@ type delegateFlags struct {\n \trequest                                      string\n \tto, cd, effort, promptFile, session          string\n \taddDirs                                      []string\n-\tnoNetwork, record                            bool\n+\tnoNetwork, record, confirmAbandoned          bool\n \tdryRun, jsonOut, active, wait, detach        bool\n \tverbose, noFollow                            bool\n \tlines                                        int\n@@ -91,7 +91,7 @@ func parseDelegateFlags(args []string, extra ...string) (delegateFlags, string)\n \t\t\treturn f, tr(\"unknown or inapplicable flag \"+name, \"flag desconhecida ou inaplicável \"+name)\n \t\t}\n \t\tswitch name {\n-\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\":\n+\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\", \"--confirm-abandoned\":\n \t\t\tif hasInline {\n \t\t\t\treturn f, tr(name+\" takes no value\", name+\" não recebe valor\")\n \t\t\t}\n@@ -108,6 +108,8 @@ func parseDelegateFlags(args []string, extra ...string) (delegateFlags, string)\n \t\t\t\tf.noNetwork = true\n \t\t\tcase \"--record\":\n \t\t\t\tf.record = true\n+\t\t\tcase \"--confirm-abandoned\":\n+\t\t\t\tf.confirmAbandoned = true\n \t\t\tcase \"--no-follow\":\n \t\t\t\tf.noFollow = true\n \t\t\tdefault:\n@@ -454,6 +456,11 @@ func cmdDelegatePurpose(root, purpose string, args []string, stdout, stderr io.W\n \t}\n \tnotes := \"\"\n \tif f.noteFile != \"\" {\n+\t\t// R5 of spec pose-review-readiness-before-seal: an oversized note is\n+\t\t// named with its size and the limit, not as a generic adapter file.\n+\t\tif info, err := os.Lstat(f.noteFile); err == nil && info.Mode().IsRegular() && info.Size() > posemodel.ReviewNotesMaxBytes {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, fmt.Errorf(\"the note file %s has %d bytes; implementer notes must be at most %d bytes: shorten it\", f.noteFile, info.Size(), posemodel.ReviewNotesMaxBytes))\n+\t\t}\n \t\traw, err := posemodel.ReadReviewAdapterFile(f.noteFile, posemodel.ReviewNotesMaxBytes)\n \t\tif err != nil {\n \t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n@@ -924,6 +931,9 @@ func cmdDelegateLs(root string, args []string, stdout, stderr io.Writer) int {\n \t\t\tif a.StalledAt != \"\" {\n \t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n \t\t\t}\n+\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n+\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n+\t\t\t}\n \t\t\tif a.HookFailure != \"\" {\n \t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n \t\t\t}\n@@ -1100,9 +1110,9 @@ func cmdDelegateResume(root string, args []string, stdout, stderr io.Writer) int\n }\n \n func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n-\tf, problem := parseDelegateFlags(args)\n+\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n \tif problem != \"\" {\n-\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--dry-run] [--json]\")\n+\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n \t}\n \tstore := posemodel.Store{Root: root}\n \tattempts, lost, err := store.ListDelegationAttempts()\n@@ -1113,6 +1123,38 @@ func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int\n \tif err != nil {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n \t}\n+\tif !attempt.Active && !f.dryRun {\n+\t\t// An attempt whose dispatch, or whose earlier release, ended before\n+\t\t// its receipt is released with a failed run and its receipt, so it\n+\t\t// stops blocking the bundle; the release proves the abandonment\n+\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n+\t\t// review round 4, N1).\n+\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n+\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n+\t\t}\n+\t\tif err != nil {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n+\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n+\t\t}\n+\t\tif f.jsonOut {\n+\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n+\t\t\treturn 0\n+\t\t}\n+\t\tout := render(stdout, stderr)\n+\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n+\t\tswitch {\n+\t\tcase run.RunID == \"\":\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n+\t\tcase run.Status == posemodel.ReviewRunFailed && strings.HasPrefix(run.Failure, posemodel.DelegationAbandonedCause):\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n+\t\tdefault:\n+\t\t\t// The attempt had a run already: its receipt was completed with\n+\t\t\t// it (review round 11, N3).\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: completed with run \"+run.RunID+\", already recorded as \"+run.Status, \"true: concluída com o run \"+run.RunID+\", já registrado como \"+run.Status))\n+\t\t}\n+\t\treturn 0\n+\t}\n \tif !attempt.Active {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n \t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\ndiff --git a/pose-mcp/internal/cli/governance_stats.go b/pose-mcp/internal/cli/governance_stats.go\nindex 85edee59..d2830565 100644\n--- a/pose-mcp/internal/cli/governance_stats.go\n+++ b/pose-mcp/internal/cli/governance_stats.go\n@@ -129,7 +129,7 @@ func cmdGovernanceStats(root string, args []string, stdout, stderr io.Writer) in\n \tout.Field(\"coverage.reviews\", fmt.Sprintf(\"bundles=%d invalid=%d attestations=%d invalid=%d without_bundle=%d\", report.Coverage.ReviewBundlesScanned-report.Coverage.ReviewBundlesInvalid, report.Coverage.ReviewBundlesInvalid, report.Coverage.AttestationsScanned-report.Coverage.AttestationsInvalid, report.Coverage.AttestationsInvalid, report.Coverage.AttestationsWithoutBundle))\n \tout.Field(\"attempts\", fmt.Sprintf(\"units=%d observed=%d pass=%d fail=%d partial=%d skipped=%d unknown=%d\", report.Attempts.UnitsObserved, report.Attempts.AttemptsObserved, report.Attempts.Pass, report.Attempts.Fail, report.Attempts.Partial, report.Attempts.Skipped, report.Attempts.Unknown))\n \tout.Field(\"judgment\", fmt.Sprintf(\"attempts=%d first_approved_units=%d approved=%d approved_with_reservations=%d changes_requested=%d rejected=%d unknown=%d\", report.Attempts.JudgmentAttempts, report.Attempts.FirstApprovedUnits, report.Reviews.Approved, report.Reviews.ApprovedWithReservations, report.Reviews.ChangesRequested, report.Reviews.Rejected, report.Reviews.UnknownDecisions))\n-\tout.Field(\"intervention\", fmt.Sprintf(\"observed=%d findings=%d not_applicable=%d accepted_risk=%d resolved=%d open=%d wont_fix=%d\", report.Reviews.InterventionsObserved, report.Reviews.FindingsObserved, report.Reviews.NotApplicable, report.Reviews.AcceptedRisk, report.Reviews.ResolvedFindings, report.Reviews.OpenFindings, report.Reviews.WontFixFindings))\n+\tout.Field(\"intervention\", fmt.Sprintf(\"observed=%d findings=%d not_applicable=%d accepted_risk=%d resolved=%d open=%d wont_fix=%d within_limit=%d\", report.Reviews.InterventionsObserved, report.Reviews.FindingsObserved, report.Reviews.NotApplicable, report.Reviews.AcceptedRisk, report.Reviews.ResolvedFindings, report.Reviews.OpenFindings, report.Reviews.WontFixFindings, report.Reviews.WithinLimitFindings))\n \tout.Field(\"freshness\", fmt.Sprintf(\"stale=%d unknown=%d checks=%d truncated=%v\", report.Reviews.StaleObserved, report.Reviews.StaleUnknown, report.Coverage.FreshnessChecks, report.Coverage.FreshnessTruncated))\n \tout.Field(\"telemetry\", fmt.Sprintf(\"active_duration_observed=%d active_duration_seconds=%.2f active_duration_unknown=%d wait_duration_observed=%d wait_duration_unknown=%d cost_observed=%d cost_usd=%.2f cost_unknown=%d\", report.Attempts.ActiveDurationObserved, report.Attempts.ActiveDurationSeconds, report.Attempts.ActiveDurationUnknown, report.Attempts.WaitDurationObserved, report.Attempts.WaitDurationUnknown, report.Attempts.ObservedCostCount, report.Attempts.ObservedCostUSD, report.Attempts.UnknownCostCount))\n \tremediation := fmt.Sprintf(\"available=%v coverage=%s\", report.Remediation.Available, report.Coverage.RemediationCoverage)\ndiff --git a/pose-mcp/internal/cli/help_catalog.go b/pose-mcp/internal/cli/help_catalog.go\nindex c6381d05..2055220f 100644\n--- a/pose-mcp/internal/cli/help_catalog.go\n+++ b/pose-mcp/internal/cli/help_catalog.go\n@@ -362,7 +362,7 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"wait\", \"pose delegate wait <run> [--timeout <d>] [--json]\", \"Block until a run ends; exit 0 approved, 10 changes requested or rejected, 20 failed, 30 interrupted, 40 stalled, 50 timed out\", \"Bloqueia até um run terminar; sai com 0 aprovado, 10 mudanças pedidas ou rejeitado, 20 falhou, 30 interrompido, 40 travado, 50 tempo esgotado\"},\n \t\t\t{\"resume\", \"pose delegate resume <run> [--wait-until-reset[=<max>]] [--prompt <file|->] [--detach] [--dry-run] [--json]\", \"Continue an interrupted run with the same agent and session, under its original attempt; repeating it returns the recorded continuation\", \"Retoma um run interrompido com o mesmo agente e sessão, sob a tentativa original; repetir devolve a continuação registrada\"},\n \t\t\t{\"handoff\", \"pose delegate handoff <run> --to <agent|auto> [--detach] [--dry-run] [--json]\", \"Continue a stopped run with another agent under the same attempt and budget, its brief carrying the stopped run's quoted partial and commands\", \"Continua um run parado com outro agente na mesma tentativa e orçamento, com o brief levando o parcial citado e os comandos do run parado\"},\n-\t\t\t{\"cancel\", \"pose delegate cancel <run> [--dry-run] [--json]\", \"Stop a running run; it is recorded failed with the cause cancelled and its attempt stays consumed\", \"Para um run em andamento; ele é registrado como failed com a causa cancelled e a tentativa continua consumida\"},\n+\t\t\t{\"cancel\", \"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\", \"Stop a running run; it is recorded failed with the cause cancelled and its attempt stays consumed. A stalled attempt whose dispatch ended before recording its run is released with a failed run and its receipt; one an earlier engine left without a marker needs --confirm-abandoned\", \"Para um run em andamento; ele é registrado como failed com a causa cancelled e a tentativa continua consumida. Uma tentativa parada cujo envio terminou antes de registrar o run é liberada com um run com falha e o recibo; uma que um motor anterior deixou sem marcador exige --confirm-abandoned\"},\n \t\t\t{\"agents\", \"pose delegate agents [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>[/<model>]] [--json]\", \"List configured agents with vendor, model, whether their CLI is on the path, their last usage-limit reset and their state: available, limited until <instant>, missing or probe-failed\", \"Lista os agentes configurados com vendor, modelo, se a CLI está no path, o último reset de limite de uso e o estado: available, limited until <instante>, missing ou probe-failed\"},\n \t\t},\n \t\tExamples: []string{\n@@ -383,6 +383,7 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"bundle\", \"pose review bundle <scope|xref> [--seal] [--explain] [--expect-context <digest>]\", \"Prepare or seal an immutable review subject bundle\", \"Prepara ou sela o bundle imutável de revisão\"},\n \t\t\t{\"brief\", \"pose review brief <bundle-id|scope> [--kind review|adjudication|smoke] [--note-file <path>] [--json]\", \"Render the request a delegated reviewer receives, from the sealed bundle and, from round 2, the previous round's open findings\", \"Gera o pedido que um revisor delegado recebe, a partir do bundle selado e, da rodada 2 em diante, dos findings abertos da rodada anterior\"},\n \t\t\t{\"run-sign\", \"pose review run-sign <run-id> --issuer <name> [--ttl <duration>] [--apply] [--json]\", \"Sign captured run provenance with a pinned native issuer\", \"Assina a proveniência capturada com issuer nativo fixado\"},\n+\t\t\t{\"draft-check\", \"pose review draft-check [<bundle-id|run-id>] --draft <file> [--json]\", \"Report every reason the conclusion step would refuse a review draft, without writing; inside a delegated review the bundle and round come from the run\", \"Relata todo motivo pelo qual a conclusão recusaria um rascunho de review, sem gravar; dentr","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/home/go/.claude/projects/-var-tmp-pose-work-go-pose-review-run-0207467d72-worktree/[private-session]/tool-results/brgpzvltz.txt","persistedOutputSize":339366},"tool_result_meta":[{"id":"toolu_014ZAWVk5WgiTFd24oHDvGPt","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
