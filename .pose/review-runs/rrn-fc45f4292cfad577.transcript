os.ReadFile(sidx); want, werr := RawGit(a...).Output()' \\\n'  t.Log(a[2:], \"equal\", bytes.Equal(got, want), err, werr, e0, \"idx-same\", bytes.Equal(b, x), \"sub-same\", bytes.Equal(sb, sx), string(got)) }' '}' \\\n'func TestProbeUnknownFlag(t *testing.T) { root := t.TempDir(); pg(t, root, \"init\", \"-q\"); t.Logf(\"%q | %q\", pg(t, root, \"rev-parse\", \"--no-such-format=absolute\", \"--git-path\", \"index\"), pg(t, root, \"--version\")) }' > \"$TMPDIR/probe/zz_probe_test.go\" && printf '{\"Replace\":{\"%s/pose-mcp/internal/pose/zz_probe_test.go\":\"%s/probe/zz_probe_test.go\"}}' \"$PWD\" \"$TMPDIR\" > \"$TMPDIR/probe/o.json\" && go -C pose-mcp test -overlay \"$TMPDIR/probe/o.json\" ./internal/pose -count=1 -run 'TestProbe' -v 2>&1","uuid":"55ac1bca-3d55-4367-a81b-8fcd223899d3","session_id":"[private-session]"}
