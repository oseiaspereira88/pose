n   434\t// its change set alone computes it. A spec naming the same commit twice is\n   435\t// left to that per-spec path, since one stream cannot feed it twice in order.\n   436\t// A failed read fails every spec that holds the commit.\n   437\tfunc trailerPatchDigests(files posemodel.Files, root string, order []posemodel.SpecTrailerLogEntry, wanted map[string]bool) (map[string][]byte, map[string]error) {\n   438\t\trepeated := map[string]bool{}\n   439\t\tfor _, entry := range order {\n   440\t\t\tseen := map[string]bool{}\n   441\t\t\tfor _, spec := range entry.Specs {\n   442\t\t\t\tif seen[spec] {\n   443\t\t\t\t\trepeated[spec] = true\n   444\t\t\t\t}\n   445\t\t\t\tseen[spec] = true\n   446\t\t\t}\n   447\t\t}\n   448\t\thashes, failed := map[string]hash.Hash{}, map[string]error{}\n   449\t\tstream := changeSetGitStream(files, root)\n   450\t\tfor _, entry := range order {\n   451\t\t\twriters, specs := []io.Writer{}, []string{}\n   452\t\t\tseen := map[string]bool{}\n   453\t\t\tfor _, spec := range entry.Specs {\n   454\t\t\t\tif seen[spec] || !wanted[spec] || repeated[spec] || failed[spec] != nil {\n   455\t\t\t\t\tcontinue\n   456\t\t\t\t}\n   457\t\t\t\tseen[spec] = true\n   458\t\t\t\tif hashes[spec] == nil {\n   459\t\t\t\t\thashes[spec] = sha256.New()\n   460\t\t\t\t}\n   461\t\t\t\twriters, specs = append(writers, hashes[spec]), append(specs, spec)\n   462\t\t\t}\n   463\t\t\tif len(writers) == 0 {\n   464\t\t\t\tcontinue\n   465\t\t\t}\n   466\t\t\tif err := stream(16*1024*1024, io.MultiWriter(writers...), \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", entry.SHA, \"--\"); err != nil {\n   467\t\t\t\tfor _, spec := range specs {\n   468\t\t\t\t\tfailed[spec] = err\n   469\t\t\t\t}\n   470\t\t\t}\n   471\t\t}\n   472\t\tdigests := map[string][]byte{}\n   473\t\tfor spec, h := range hashes {\n   474\t\t\tif failed[spec] == nil {\n   475\t\t\t\tdigests[spec] = h.Sum(nil)\n   476\t\t\t}\n   477\t\t}\n   478\t\treturn digests, failed\n   479\t}\n   480\t\n   481\tfunc commitsWithSpecTrailer(root, spec string) ([]string, error) {\n   482\t\tspecCommits, err := allCommitsWithSpecTrailers(root)\n   483\t\tif err != nil {\n   484\t\t\treturn nil, err\n   485\t\t}\n   486\t\treturn specCommits[spec], nil\n    20\t// line, trimmed. It does not use Git's trailer parser.\n    21\t// SpecTrailerLogEntry is one commit of the trailer log, in log order, with\n    22\t// the slug of each POSE-Spec line it carries (repeated if the line repeats).\n    23\ttype SpecTrailerLogEntry struct {\n    24\t\tSHA   string\n    25\t\tSpecs []string\n    26\t}\n    27\t\n    28\t// ParseSpecTrailerLogOrdered is ParseSpecTrailerLog keeping the log order:\n    29\t// every spec's commit list is the subsequence of these entries that names it\n    30\t// (spec pose-index-streams-each-commit-once).\n    31\tfunc ParseSpecTrailerLogOrdered(out []byte) []SpecTrailerLogEntry {\n    32\t\tparts := bytes.Split(out, []byte{0})\n    33\t\tentries := []SpecTrailerLogEntry{}\n    34\t\tfor i := 0; i+1 < len(parts); i += 2 {\n    35\t\t\tentry := SpecTrailerLogEntry{SHA: strings.TrimSpace(string(parts[i]))}\n    36\t\t\tfor _, line := range strings.Split(string(parts[i+1]), \"\\n\") {\n    37\t\t\t\tline = strings.TrimSpace(line)\n    38\t\t\t\tif strings.HasPrefix(line, \"POSE-Spec:\") {\n    39\t\t\t\t\tif spec := strings.TrimSpace(strings.TrimPrefix(line, \"POSE-Spec:\")); spec != \"\" {\n    40\t\t\t\t\t\tentry.Specs = append(entry.Specs, spec)\n    41\t\t\t\t\t}\n    42\t\t\t\t}\n    43\t\t\t}\n    44\t\t\tif len(entry.Specs) > 0 {\n    45\t\t\t\tentries = append(entries, entry)\n    46\t\t\t}\n    47\t\t}\n    48\t\treturn entries\n    49\t}\n    50\t\n    51\tfunc ParseSpecTrailerLog(out []byte) map[string][]string {\n    52\t\tparts := bytes.Split(out, []byte{0})\n    53\t\tspecCommits := map[string][]string{}\n    54\t\tfor i := 0; i+1 < len(parts); i += 2 {\n    55\t\t\tsha, body := strings.TrimSpace(string(parts[i])), string(parts[i+