{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 6e853c755a7fe723f8a7940ebb66a6fcc60b07ff..0fcb3111c6fe3d40e6538b9062dd30ebfd317f8d -- pose-mcp/internal/cli/artifact_integrity.go pose-mcp/internal/pose/spec_trailers.go pose-mcp/internal/cli/change_set_single_pass_test.go pose-mcp/internal/cli/governance_operation_performance_test.go'","aggregated_output":"diff --git a/pose-mcp/internal/cli/artifact_integrity.go b/pose-mcp/internal/cli/artifact_integrity.go\nindex e6e6d7cd..1ec6616a 100644\n--- a/pose-mcp/internal/cli/artifact_integrity.go\n+++ b/pose-mcp/internal/cli/artifact_integrity.go\n@@ -9,6 +9,7 @@ import (\n \t\"errors\"\n \t\"fmt\"\n \t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n+\t\"hash\"\n \t\"io\"\n \t\"os\"\n \t\"os/exec\"\n@@ -230,14 +231,10 @@ func resolveGitChangeSetWithTrailersIn(files posemodel.Files, root, spec, base,\n \treturn resolveGitChangeSetWithTrailersAndFiles(files, root, spec, base, head, captured)\n }\n \n-func resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\n-\tgitOutput := func(limit int, args ...string) ([]byte, error) {\n-\t\tif files == nil {\n-\t\t\treturn gitOutputBounded(root, limit, args...)\n-\t\t}\n-\t\treturn gitOutputBoundedIn(files, root, limit, args...)\n-\t}\n-\tgitStream := func(limit int, sink io.Writer, args ...string) error {\n+// changeSetGitStream streams a raw-history read of root into a sink, through\n+// the operation's read view when files carries one.\n+func changeSetGitStream(files posemodel.Files, root string) func(limit int, sink io.Writer, args ...string) error {\n+\treturn func(limit int, sink io.Writer, args ...string) error {\n \t\tif files == nil {\n \t\t\treturn gitStreamBounded(root, limit, sink, args...)\n \t\t}\n@@ -245,7 +242,7 @@ func resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec,\n \t\tdefer cancel()\n \t\terr := posemodel.StreamGovernanceRawHistoryGitIn(files, ctx, root, \"index.delivery-integrity\", int64(limit), sink, args...)\n \t\t// As gitOutputBoundedIn does: keep the bounded stderr as the\n-\t\t// forensic cause of a failed history read (review round 2, N1).\n+\t\t// forensic cause of a failed history read.\n \t\tvar exit *exec.ExitError\n \t\tif errors.As(err, &exit) {\n \t\t\tif detail := strings.TrimSpace(string(exit.Stderr)); detail != \"\" {\n@@ -254,6 +251,23 @@ func resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec,\n \t\t}\n \t\treturn err\n \t}\n+}\n+\n+func resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\n+\treturn resolveGitChangeSetWithPatchDigest(files, root, spec, base, head, captured, nil)\n+}\n+\n+// resolveGitChangeSetWithPatchDigest resolves a change set; a non-nil\n+// patchDigest is the digest trailerPatchDigests already streamed for the\n+// trailer commits of captured, which this resolution then does not read again.\n+func resolveGitChangeSetWithPatchDigest(files posemodel.Files, root, spec, base, head string, captured []string, patchDigest []byte) (posemodel.ChangeSet, error) {\n+\tgitOutput := func(limit int, args ...string) ([]byte, error) {\n+\t\tif files == nil {\n+\t\t\treturn gitOutputBounded(root, limit, args...)\n+\t\t}\n+\t\treturn gitOutputBoundedIn(files, root, limit, args...)\n+\t}\n+\tgitStream := changeSetGitStream(files, root)\n \tresolveRevision := func(revision string) (string, error) {\n \t\treturn resolveGitRevisionWithFiles(files, root, revision)\n \t}\n@@ -329,6 +343,9 @@ func resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec,\n \t\t\t// The commit's patch only feeds the digest: it is streamed into\n \t\t\t// it, the same bytes in the same order, and the read view keeps\n \t\t\t// its digest, not its bytes (spec pose-read-view-streamed-object-digests).\n+\t\t\tif patchDigest != nil {\n+\t\t\t\tcontinue\n+\t\t\t}\n \t\t\tif err := gitStream(16*1024*1024, diffHash, \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", sha, \"--\"); err != nil {\n \t\t\t\treturn posemodel.ChangeSet{}, err\n \t\t\t}\n@@ -363,6 +380,9 @@ func resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec,\n \t\t}\n \t}\n \tdigest := diffHash.Sum(nil)\n+\tif patchDigest != nil && len(trailerCommits) > 0 {\n+\t\tdigest = patchDigest\n+\t}\n \tidSum := sha256.Sum256([]byte(spec + \"\\x00\" + resolvedBase + \"\\x00\" + resolvedHead + \"\\x00\" + hex.EncodeToString(digest[:])))\n \t// A trailer set is judged against the checkout's own tree: a later commit\n \t// without the trailer that changes an observed path or the matrix must move\n@@ -392,11 +412,70 @@ func allCommitsWithSpecTrailers(root string) (map[string][]string, error) {\n }\n \n func allCommitsWithSpecTrailersIn(files posemodel.Files, root string) (map[string][]string, error) {\n+\tspecs, _, err := allCommitsWithSpecTrailersOrderedIn(files, root)\n+\treturn specs, err\n+}\n+\n+// allCommitsWithSpecTrailersOrderedIn reads the trailer log once and returns\n+// it both per spec and in log order.\n+func allCommitsWithSpecTrailersOrderedIn(files posemodel.Files, root string) (map[string][]string, []posemodel.SpecTrailerLogEntry, error) {\n \tout, err := gitOutputBoundedIn(files, root, 32*1024*1024, posemodel.SpecTrailerLogArgs...)\n \tif err != nil {\n-\t\treturn nil, err\n+\t\treturn nil, nil, err\n+\t}\n+\treturn posemodel.ParseSpecTrailerLog(out), posemodel.ParseSpecTrailerLogOrdered(out), nil\n+}\n+\n+// trailerPatchDigests streams the patch of each attributed commit once, in\n+// log order, into the digest of every spec that holds it, so a commit carrying\n+// several specs' trailers is read once instead of once per spec (spec\n+// pose-index-streams-each-commit-once). Each spec's digest is the SHA-256 of\n+// its commits' patches concatenated in its own order, exactly as resolving\n+// its change set alone computes it. A spec naming the same commit twice is\n+// left to that per-spec path, since one stream cannot feed it twice in order.\n+// A failed read fails every spec that holds the commit.\n+func trailerPatchDigests(files posemodel.Files, root string, order []posemodel.SpecTrailerLogEntry, wanted map[string]bool) (map[string][]byte, map[string]error) {\n+\trepeated := map[string]bool{}\n+\tfor _, entry := range order {\n+\t\tseen := map[string]bool{}\n+\t\tfor _, spec := range entry.Specs {\n+\t\t\tif seen[spec] {\n+\t\t\t\trepeated[spec] = true\n+\t\t\t}\n+\t\t\tseen[spec] = true\n+\t\t}\n+\t}\n+\thashes, failed := map[string]hash.Hash{}, map[string]error{}\n+\tstream := changeSetGitStream(files, root)\n+\tfor _, entry := range order {\n+\t\twriters, specs := []io.Writer{}, []string{}\n+\t\tseen := map[string]bool{}\n+\t\tfor _, spec := range entry.Specs {\n+\t\t\tif seen[spec] || !wanted[spec] || repeated[spec] || failed[spec] != nil {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tseen[spec] = true\n+\t\t\tif hashes[spec] == nil {\n+\t\t\t\thashes[spec] = sha256.New()\n+\t\t\t}\n+\t\t\twriters, specs = append(writers, hashes[spec]), append(specs, spec)\n+\t\t}\n+\t\tif len(writers) == 0 {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif err := stream(16*1024*1024, io.MultiWriter(writers...), \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", entry.SHA, \"--\"); err != nil {\n+\t\t\tfor _, spec := range specs {\n+\t\t\t\tfailed[spec] = err\n+\t\t\t}\n+\t\t}\n+\t}\n+\tdigests := map[string][]byte{}\n+\tfor spec, h := range hashes {\n+\t\tif failed[spec] == nil {\n+\t\t\tdigests[spec] = h.Sum(nil)\n+\t\t}\n \t}\n-\treturn posemodel.ParseSpecTrailerLog(out), nil\n+\treturn digests, failed\n }\n \n func commitsWithSpecTrailer(root, spec string) ([]string, error) {\n@@ -576,7 +655,7 @@ func collectArtifactGraphInputsWithGapsIn(files posemodel.Files, root string) ([\n \tfor _, recorded := range recordedSets {\n \t\tchangeSetsMap[recorded.ID] = recorded\n \t}\n-\tspecTrailers, err := allCommitsWithSpecTrailersIn(files, root)\n+\tspecTrailers, trailerOrder, err := allCommitsWithSpecTrailersOrderedIn(files, root)\n \tif err != nil && gaps[\"\"] == \"\" {\n \t\tgaps[\"\"] = \"the commits carrying POSE-Spec trailers could not be read: \" + err.Error()\n \t}\n@@ -587,9 +666,18 @@ func collectArtifactGraphInputsWithGapsIn(files posemodel.Files, root string) ([\n \t\t\tgaps[\"\"] = \"the repository's history is shallow or its depth could not be read\"\n \t\t}\n \t}\n+\twanted := map[string]bool{}\n+\tfor _, spec := range specs {\n+\t\twanted[spec.Slug] = len(specTrailers[spec.Slug]) > 0\n+\t}\n+\tpatchDigests, patchFailures := trailerPatchDigests(files, root, trailerOrder, wanted)\n \tfor _, spec := range specs {\n \t\tif len(specTrailers[spec.Slug]) > 0 {\n-\t\t\tif set, err := resolveGitChangeSetWithTrailersIn(files, root, spec.Slug, \"\", \"\", specTrailers[spec.Slug]); err == nil {\n+\t\t\tif err := patchFailures[spec.Slug]; err != nil {\n+\t\t\t\tgaps[spec.Slug] = \"its trailer change set could not be read: \" + err.Error()\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tif set, err := resolveGitChangeSetWithPatchDigest(files, root, spec.Slug, \"\", \"\", specTrailers[spec.Slug], patchDigests[spec.Slug]); err == nil {\n \t\t\t\tchangeSetsMap[set.ID] = set\n \t\t\t} else {\n \t\t\t\tgaps[spec.Slug] = \"its trailer change set could not be read: \" + err.Error()\ndiff --git a/pose-mcp/internal/cli/change_set_single_pass_test.go b/pose-mcp/internal/cli/change_set_single_pass_test.go\nnew file mode 100644\nindex 00000000..b5721c36\n--- /dev/null\n+++ b/pose-mcp/internal/cli/change_set_single_pass_test.go\n@@ -0,0 +1,66 @@\n+package cli\n+\n+import (\n+\t\"encoding/hex\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n+)\n+\n+// Spec pose-index-streams-each-commit-once: one pass over the trailer log\n+// gives every spec the digest its own resolution computes, and reads each\n+// commit's patch once.\n+func TestAStreamedSinglePassKeepsEverySpecsDigest(t *testing.T) {\n+\trepo := newRemovalRepo(t)\n+\trepo.write(\"a.txt\", \"one\\n\")\n+\trepo.commit(\"first\\n\\nPOSE-Spec: alpha\")\n+\trepo.write(\"a.txt\", \"two\\n\")\n+\trepo.write(\"b.bin\", \"\\x00\\x01binary\\n\")\n+\trepo.commit(\"shared\\n\\nPOSE-Spec: alpha\\nPOSE-Spec: beta\")\n+\trepo.write(\"c.txt\", \"three\\n\")\n+\trepo.commit(\"beta only\\n\\nPOSE-Spec: beta\")\n+\trepo.write(\"d.txt\", \"four\\n\")\n+\trepo.commit(\"repeated\\n\\nPOSE-Spec: gamma\\nPOSE-Spec: gamma\")\n+\trepo.write(\"a.txt\", \"five\\n\")\n+\trepo.commit(\"alpha again\\n\\nPOSE-Spec: alpha\")\n+\n+\treal, err := exec.LookPath(\"git\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tshim, count := t.TempDir(), filepath.Join(t.TempDir(), \"shows\")\n+\tscript := \"#!/bin/sh\\nfor a in \\\"$@\\\"; do [ \\\"$a\\\" = show ] && printf x >> '\" + count + \"'; done\\nexec '\" + real + \"' \\\"$@\\\"\\n\"\n+\tif err := os.WriteFile(filepath.Join(shim, \"git\"), []byte(script), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\n+\t_, order, err := allCommitsWithSpecTrailersOrderedIn(posemodel.NativeFiles(), repo.root)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tt.Setenv(\"PATH\", shim+string(os.PathListSeparator)+os.Getenv(\"PATH\"))\n+\tdigests, failed := trailerPatchDigests(posemodel.NativeFiles(), repo.root, order, map[string]bool{\"alpha\": true, \"beta\": true, \"gamma\": true})\n+\tshows, _ := os.ReadFile(count)\n+\tif len(failed) != 0 || len(shows) != 4 {\n+\t\tt.Fatalf(\"failed=%v; %d patch reads for 4 distinct attributed commits outside the repeated spec\", failed, len(shows))\n+\t}\n+\tif _, ok := digests[\"gamma\"]; ok {\n+\t\tt.Fatal(\"a spec naming one commit twice was streamed in the single pass\")\n+\t}\n+\tfor _, spec := range []string{\"alpha\", \"beta\"} {\n+\t\tset, err := resolveGitChangeSet(repo.root, spec, \"\", \"\")\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif got := \"sha256:\" + hex.EncodeToString(digests[spec]); got != set.DiffDigest {\n+\t\t\tt.Fatalf(\"%s: single pass %s, its own resolution %s\", spec, got, set.DiffDigest)\n+\t\t}\n+\t}\n+\tif !strings.HasPrefix(string(shows), \"x\") {\n+\t\tt.Fatal(\"no patch was read\")\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/governance_operation_performance_test.go b/pose-mcp/internal/cli/governance_operation_performance_test.go\nindex 132b36be..da189e6b 100644\n--- a/pose-mcp/internal/cli/governance_operation_performance_test.go\n+++ b/pose-mcp/internal/cli/governance_operation_performance_test.go\n@@ -66,7 +66,10 @@ func TestGovernanceOperationPerformanceCapturesTrailersOnce(t *testing.T) {\n \t\t\t// Each change set reads its head tree once for the material digest and the root\n \t\t\t// checks once whether the checkout is shallow (one more\n \t\t\t// launch per spec); the full trailer log is still captured exactly once.\n-\t\t\twantCalls := map[int]int{1: 13, 3: 27, 6: 48}[count]\n+\t\t\t// The one commit every spec shares is read for its patch once, not\n+\t\t\t// once per spec (spec pose-index-streams-each-commit-once): N-1\n+\t\t\t// fewer launches than before.\n+\t\t\twantCalls := map[int]int{1: 13, 3: 25, 6: 43}[count]\n \t\t\tif calls != wantCalls {\n \t\t\t\tt.Fatalf(\"Git subprocesses=%d want%d\", calls, wantCalls)\n \t\t\t}\ndiff --git a/pose-mcp/internal/pose/spec_trailers.go b/pose-mcp/internal/pose/spec_trailers.go\nindex 73ddf02a..3f8986a5 100644\n--- a/pose-mcp/internal/pose/spec_trailers.go\n+++ b/pose-mcp/internal/pose/spec_trailers.go\n@@ -18,6 +18,36 @@ var SpecTrailerLogArgs = []string{\"log\", \"--all\", \"--reverse\", \"--grep=POSE-Spec\n // ParseSpecTrailerLog maps each spec slug to the commits that carry its trailer. A trailer is a\n // line of the body that starts with `POSE-Spec:` after trimming; the slug is the rest of the\n // line, trimmed. It does not use Git's trailer parser.\n+// SpecTrailerLogEntry is one commit of the trailer log, in log order, with\n+// the slug of each POSE-Spec line it carries (repeated if the line repeats).\n+type SpecTrailerLogEntry struct {\n+\tSHA   string\n+\tSpecs []string\n+}\n+\n+// ParseSpecTrailerLogOrdered is ParseSpecTrailerLog keeping the log order:\n+// every spec's commit list is the subsequence of these entries that names it\n+// (spec pose-index-streams-each-commit-once).\n+func ParseSpecTrailerLogOrdered(out []byte) []SpecTrailerLogEntry {\n+\tparts := bytes.Split(out, []byte{0})\n+\tentries := []SpecTrailerLogEntry{}\n+\tfor i := 0; i+1 < len(parts); i += 2 {\n+\t\tentry := SpecTrailerLogEntry{SHA: strings.TrimSpace(string(parts[i]))}\n+\t\tfor _, line := range strings.Split(string(parts[i+1]), \"\\n\") {\n+\t\t\tline = strings.TrimSpace(line)\n+\t\t\tif strings.HasPrefix(line, \"POSE-Spec:\") {\n+\t\t\t\tif spec := strings.TrimSpace(strings.TrimPrefix(line, \"POSE-Spec:\")); spec != \"\" {\n+\t\t\t\t\tentry.Specs = append(entry.Specs, spec)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\tif len(entry.Specs) > 0 {\n+\t\t\tentries = append(entries, entry)\n+\t\t}\n+\t}\n+\treturn entries\n+}\n+\n func ParseSpecTrailerLog(out []byte) map[string][]string {\n \tparts := bytes.Split(out, []byte{0})\n \tspecCommits := map[string][]string{}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/specs/2026-11-14-pose-index-streams-each-commit-once.md; cat pose-mcp/internal/pose/spec_trailers.go; sed -n '260,415p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '610,730p' pose-mcp/internal/cli/artifact_integrity.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/specs/2026-11-14-pose-index-streams-each-commit-once.md; cat pose-mcp/internal/pose/spec_trailers.go; sed -n '260,415p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '610,730p' pose-mcp/internal/cli/artifact_integrity.go\"","aggregated_output":"---\nslug: pose-index-streams-each-commit-once\nstatus: in-progress\ncreated_at: 2026-11-14\ncompleted_at:        # stamped on the transition to status: done\nsupersedes:          # slug of the superseded spec (when applicable)\ndepends_on: [pose-read-view-streamed-object-digests]\nremediates:          # optional explicit links: spec:slug@defect-fix, finding:rva-<16hex>/F1@revert (never inferred from depends_on)\npriority:            # integer >= 0 (lower = higher priority); ordering preference, not a blocker\ncomponents: pose-mcp\ntask_type: refactor\nsurface:             # optional: minimal | standard | full (default) — minimal drops Tasks and derivable report sections; `pose specs facts <slug>` derives them\ndelivers: capability:index-streams-each-commit-once\n---\n\n# Spec: pose-index-streams-each-commit-once\n\n## 1. Intent\n\n### Goal\nFazer `pose index` ler o patch de cada commit atribuído uma única vez por operação, distribuindo os bytes para o digest de todas as specs que o incluem, em vez de reler o commit para cada spec.\n\n### Business value\nMedido no corpus do pose-dist com a spec `pose-read-view-streamed-object-digests` (follow-up F1): a operação de construção do índice fazia streaming de 1,26 GB para 2.511 leituras distintas, cerca de 2,4 vezes o volume de uma leitura única, porque commits com o trailer de várias specs (os commits grandes de retenção de evidência) eram lidos uma vez por spec. O I/O do índice cresce com o histórico atribuído; ler cada commit uma vez remove o fator multiplicador sem mudar nenhum resultado.\n\n### Constraints\n- O digest de diff de cada spec continua o SHA-256 dos patches dos seus commits concatenados na sua ordem; `delivery-integrity.json` não pode mudar.\n- O read view continua sem cache entre operações; nenhum byte é retido.\n\n### Non-goals\n- Não mudar a fórmula do digest nem introduzir registro persistente de digest por commit.\n- Não reduzir a releitura da auditoria final, que prova que o patch não mudou.\n\n---\n\n## 2. Requirements\n\n### Functional\n- R1: When `pose index` collects the change sets of every spec, the engine shall read each attributed commit's patch once, in the order of the trailer log, and feed it to the digest of every spec whose change set holds that commit.\n- R2: Each spec's diff digest shall equal the digest its change set resolved alone computes, and `delivery-integrity.json` of the pose-dist corpus shall be byte-identical before and after.\n- R3: A spec that names the same commit more than once shall be resolved by its own per-spec reading, since one stream cannot feed it twice in order.\n- R4: A failed read of a commit shall leave every spec that holds it with a collection gap carrying the cause, and no change set for it.\n\n### Non-functional\n- O streaming da operação de construção do índice fica próximo de uma leitura por commit atribuído.\n\n### Security\n- Mesma política de histórico bruto e o mesmo read view das leituras por spec.\n\n### Compatibility\n- Nenhum formato muda.\n\n---\n\n## 3. Technical Plan\n\n### Affected areas\n- `cli/artifact_integrity.go`: a coleta lê o log de trailers uma vez, em ordem, e calcula os digests numa passada com distribuição; a resolução do change set aceita o digest pré-calculado.\n- `pose/spec_trailers.go`: leitura do log de trailers que preserva a ordem.\n\n### Artifacts\n- modified: pose-mcp/internal/cli/artifact_integrity.go\n- modified: pose-mcp/internal/pose/spec_trailers.go\n- created: pose-mcp/internal/cli/change_set_single_pass_test.go\n- modified: pose-mcp/internal/cli/governance_operation_performance_test.go\n- modified: .pose/indexes/validation-matrix.json\n\n### Delivery targets\n\n- capability:index-streams-each-commit-once module:pose-mcp profile:composed-capability entrypoint:pose-mcp/cmd/pose/main.go\n\nComposto em produção por `pose index`, que coleta os change sets de todas as specs. Check permanente `index-streams-each-commit-once-integration`, evidenceClass `integration`, required: `go test ./internal/cli -run SinglePass -count=1`.\n\n### API/contract changes\n- Nenhuma pública.\n\n### Data/storage changes\n- Nenhuma.\n\n### Technical risks\n- Uma spec com trailer repetido no mesmo commit continua no caminho por spec (R3); é rara e correta.\n\n---\n\n## 4. Tasks\n\n### Planning\n- [x] Medir de onde vêm as releituras: as 375 releituras da operação vêm todas do laço de coleta, de commits com o trailer de várias specs; a prova de fechamento das entradas não lê change set.\n\n### Implementation\n- [x] Log de trailers em ordem e passada única com distribuição (R1, R3, R4).\n- [x] Digest pré-calculado na resolução do change set (R2).\n\n### Validation\n- [x] Teste de equivalência e contagem de leituras; comparação de `delivery-integrity.json` no corpus.\n\n---\n\n## 5. Decisions\n\n### Decision D1\n- Date: 2026-11-14\n- Context: commits com o trailer de várias specs são lidos uma vez por spec.\n- Options considered: (a) guardar os bytes do commit na operação para as specs seguintes; (b) uma passada pelo log de trailers em ordem, distribuindo cada patch para os digests que o incluem; (c) digest persistente por commit.\n- Decision: (b).\n- Rationale: (a) retém bytes e reabre o problema da spec anterior; (c) é um cache entre operações que a ADR de leituras de governança exclui; (b) usa o fato de que a lista de cada spec é uma subsequência do mesmo log.\n- Consequences: as specs com trailer repetido no mesmo commit ficam no caminho por spec.\n\n---\n\n## 6. Validation\n\n### Strategy\nTeste de equivalência sobre um repositório com commit compartilhado e trailer repetido, contando as leituras de patch; comparação de `delivery-integrity.json` do pose-dist entre o motor anterior e o novo; medição do streaming com contadores temporários.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./internal/pose ./internal/cli ./internal/mcpserver -count=1`\n- Scope: pose-mcp\n- Expected: verde\n\n### Execution log\n- Date: 2026-11-14\n- Environment: Linux, Go 1.26, clone do pose-dist em `main`.\n- Notes: `delivery-integrity.json` idêntico byte a byte entre o motor anterior e o novo; `pose index` 160 s antes, 144 s depois. Com contadores temporários do read view (fora do commit): a operação de construção fez streaming de 679.252.955 bytes em 2.518 leituras distintas (antes 1.263.513.529), e a auditoria de 525.734.027; bytes retidos 32.139.646. O excedente sobre uma leitura única vem das specs com trailer repetido, que seguem no caminho por spec.\n\n### Results summary\n- Successes: equivalência dos digests; índice idêntico; streaming da construção reduzido em 46%.\n- Failures: nenhuma.\n- Warnings: nenhum.\n\n### Requirement trace\n- R1 [satisfied] test:TestAStreamedSinglePassKeepsEverySpecsDigest test:TestGovernanceOperationPerformanceCapturesTrailersOnce check:index-streams-each-commit-once-integration\n- R2 [satisfied] test:TestAStreamedSinglePassKeepsEverySpecsDigest\n- R3 [satisfied] test:TestAStreamedSinglePassKeepsEverySpecsDigest\n- R4 [satisfied] test:TestAFailedStreamedPatchReadKeepsItsCause\n\n### Known gaps\n- Nenhuma.\n\n---\n\n## 7. Final Report\n\n### Delivered scope\nA coleta de change sets lê o log de trailers uma vez e, numa passada em ordem, lê o patch de cada commit atribuído uma única vez, distribuindo-o para o digest de cada spec que o inclui; a resolução do change set usa esse digest. Specs com trailer repetido no mesmo commit seguem no caminho por spec.\n\n### Files and modules changed\n- `cli/artifact_integrity.go`, `pose/spec_trailers.go`, teste novo, matriz de validação.\n\n### Validation executed\n- Command: `go test ./internal/pose ./internal/cli ./internal/mcpserver ./internal/scaffold -count=1`; `pose index` no corpus com comparação de `delivery-integrity.json`.\n- Result: verde; idêntico.\n\n### Residual risks\n- O I/O continua proporcional ao histórico atribuído; agora uma leitura por commit, mais a auditoria.\n\n### Follow-ups\n\n- [wont-do: um registro persistente de digest por commit reduziria o I/O restante, mas é o cache entre operações que a ADR de leituras de governança exclui; reabrir só se o tempo de `pose index` voltar a bloquear o fluxo] F1: digest persistente por commit.\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n)\n\n// Spec pose-spec-facts-evidence-binding: the facts and the attribution of change sets read the\n// trailers of the history in one way.\n\n// SpecTrailerLogArgs are the arguments of the `git log` whose output ParseSpecTrailerLog reads:\n// every ref, oldest first, the commits that mention a POSE-Spec trailer, hash and full body.\nvar SpecTrailerLogArgs = []string{\"log\", \"--all\", \"--reverse\", \"--grep=POSE-Spec:\", \"--format=%H%x00%B%x00\"}\n\n// ParseSpecTrailerLog maps each spec slug to the commits that carry its trailer. A trailer is a\n// line of the body that starts with `POSE-Spec:` after trimming; the slug is the rest of the\n// line, trimmed. It does not use Git's trailer parser.\n// SpecTrailerLogEntry is one commit of the trailer log, in log order, with\n// the slug of each POSE-Spec line it carries (repeated if the line repeats).\ntype SpecTrailerLogEntry struct {\n\tSHA   string\n\tSpecs []string\n}\n\n// ParseSpecTrailerLogOrdered is ParseSpecTrailerLog keeping the log order:\n// every spec's commit list is the subsequence of these entries that names it\n// (spec pose-index-streams-each-commit-once).\nfunc ParseSpecTrailerLogOrdered(out []byte) []SpecTrailerLogEntry {\n\tparts := bytes.Split(out, []byte{0})\n\tentries := []SpecTrailerLogEntry{}\n\tfor i := 0; i+1 < len(parts); i += 2 {\n\t\tentry := SpecTrailerLogEntry{SHA: strings.TrimSpace(string(parts[i]))}\n\t\tfor _, line := range strings.Split(string(parts[i+1]), \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif strings.HasPrefix(line, \"POSE-Spec:\") {\n\t\t\t\tif spec := strings.TrimSpace(strings.TrimPrefix(line, \"POSE-Spec:\")); spec != \"\" {\n\t\t\t\t\tentry.Specs = append(entry.Specs, spec)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif len(entry.Specs) > 0 {\n\t\t\tentries = append(entries, entry)\n\t\t}\n\t}\n\treturn entries\n}\n\nfunc ParseSpecTrailerLog(out []byte) map[string][]string {\n\tparts := bytes.Split(out, []byte{0})\n\tspecCommits := map[string][]string{}\n\tfor i := 0; i+1 < len(parts); i += 2 {\n\t\tsha, body := strings.TrimSpace(string(parts[i])), string(parts[i+1])\n\t\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif strings.HasPrefix(line, \"POSE-Spec:\") {\n\t\t\t\tspec := strings.TrimSpace(strings.TrimPrefix(line, \"POSE-Spec:\"))\n\t\t\t\tif spec != \"\" {\n\t\t\t\t\tspecCommits[spec] = append(specCommits[spec], sha)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn specCommits\n}\n\n// RawHistoryGit is a git command on root's raw object history: replace refs\n// (--no-replace-objects) and grafts (GIT_GRAFT_FILE at the always-empty null\n// device, which overrides both the repository's graft file and one the\n// environment names) never change which commits carry a trailer, what a change\n// set holds, or what a later removal is judged on (spec\n// pose-delivery-later-removal R3, review round 4 LR-R4-01).\nfunc RawHistoryGit(root string, args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// RawHistoryGitContext is RawHistoryGit under ctx.\nfunc RawHistoryGitContext(ctx context.Context, root string, args ...string) *exec.Cmd {\n\treturn gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// GitHooksDir is the directory git runs the hooks of root from: a linked worktree shares the\n// one of its common directory, and core.hooksPath moves it. Where git cannot answer it is\n// `.git/hooks`, which is where a repository would keep them.\nfunc GitHooksDir(root string) string {\n\tout, err := RawHistoryGit(root, \"rev-parse\", \"--git-path\", \"hooks\").Output()\n\tif err != nil {\n\t\treturn filepath.Join(root, \".git\", \"hooks\")\n\t}\n\tdir := strings.TrimSuffix(string(out), \"\\n\")\n\tif filepath.IsAbs(dir) {\n\t\treturn dir\n\t}\n\treturn filepath.Join(root, dir)\n}\n\n// RawGit is RawHistoryGit for a caller whose arguments already say where to read.\nfunc RawGit(args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\"}, args...)...)\n}\n\n// SpecTrailerCommits reads the history of root and returns the commits that carry the trailer of\n// slug, the way the attribution of change sets does. An error is a history that could not be\n// read, which is not a history without commits.\nfunc SpecTrailerCommits(root, slug string) ([]string, error) {\n\tout, err := RawHistoryGit(root, SpecTrailerLogArgs...).Output()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn ParseSpecTrailerLog(out)[slug], nil\n}\n// resolveGitChangeSetWithPatchDigest resolves a change set; a non-nil\n// patchDigest is the digest trailerPatchDigests already streamed for the\n// trailer commits of captured, which this resolution then does not read again.\nfunc resolveGitChangeSetWithPatchDigest(files posemodel.Files, root, spec, base, head string, captured []string, patchDigest []byte) (posemodel.ChangeSet, error) {\n\tgitOutput := func(limit int, args ...string) ([]byte, error) {\n\t\tif files == nil {\n\t\t\treturn gitOutputBounded(root, limit, args...)\n\t\t}\n\t\treturn gitOutputBoundedIn(files, root, limit, args...)\n\t}\n\tgitStream := changeSetGitStream(files, root)\n\tresolveRevision := func(revision string) (string, error) {\n\t\treturn resolveGitRevisionWithFiles(files, root, revision)\n\t}\n\tif spec == \"\" || posemodel.ValidateSlug(spec) != nil {\n\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"a valid spec slug is required\")\n\t}\n\tselector := \"range:\" + base + \"..\" + head\n\tvar trailerCommits []string\n\tif base == \"\" && head == \"\" {\n\t\tcommits := append([]string(nil), captured...)\n\t\tif len(commits) == 0 {\n\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"no commits carry POSE-Spec: %s\", spec)\n\t\t}\n\t\ttrailerCommits = commits\n\t\thead = commits[len(commits)-1]\n\t\tbase = commits[0] + \"^\"\n\t\tselector = \"trailers:\" + spec\n\t} else if base == \"\" || head == \"\" {\n\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"--from and --to must be supplied together\")\n\t}\n\tresolvedBase := base\n\tif !posemodel.IsGitEmptyTree(base) {\n\t\tvar err error\n\t\tif resolvedBase, err = resolveRevision(base); err != nil && len(trailerCommits) > 0 {\n\t\t\tvar isRoot bool\n\t\t\tvar headerErr error\n\t\t\tif files == nil {\n\t\t\t\tisRoot, headerErr = commitHasNoParent(root, trailerCommits[0])\n\t\t\t} else {\n\t\t\t\tisRoot, headerErr = commitHasNoParentIn(files, root, trailerCommits[0])\n\t\t\t}\n\t\t\tif headerErr != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"%w; %v\", err, headerErr)\n\t\t\t}\n\t\t\tif isRoot {\n\t\t\t\tbase, resolvedBase, err = posemodel.GitEmptyTree(trailerCommits[0]), posemodel.GitEmptyTree(trailerCommits[0]), nil\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n\t}\n\tresolvedHead, err := resolveRevision(head)\n\tif err != nil {\n\t\treturn posemodel.ChangeSet{}, err\n\t}\n\tcommitsRaw, err := gitOutput(4*1024*1024, \"rev-list\", \"--reverse\", posemodel.ChangeSetRange(resolvedBase, resolvedHead), \"--\")\n\tif err != nil {\n\t\treturn posemodel.ChangeSet{}, err\n\t}\n\tcommits := splitNonEmpty(string(commitsRaw), \"\\n\")\n\n\tvar paths []posemodel.ObservedPath\n\t// observed keeps every commit's own path records, unmerged: folding a create\n\t// and a later rename into one creation would hide that the file moved into an\n\t// administrative class.\n\tvar observed []posemodel.ObservedPath\n\tdiffHash := sha256.New()\n\tif len(trailerCommits) > 0 {\n\t\tcommits = trailerCommits\n\t\tcommitPathLists := make([][]posemodel.ObservedPath, 0, len(commits))\n\t\tfor _, sha := range commits {\n\t\t\tnameStatus, err := gitOutput(4*1024*1024, \"diff-tree\", \"--root\", \"--no-commit-id\", \"--name-status\", \"-z\", \"-M\", \"-r\", sha, \"--\")\n\t\t\tif err != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, err\n\t\t\t}\n\t\t\tparsed, err := parseGitNameStatusNUL(nameStatus)\n\t\t\tif err != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, err\n\t\t\t}\n\t\t\tcommitPathLists = append(commitPathLists, parsed)\n\t\t\tobserved = append(observed, parsed...)\n\t\t\t// The commit's patch only feeds the digest: it is streamed into\n\t\t\t// it, the same bytes in the same order, and the read view keeps\n\t\t\t// its digest, not its bytes (spec pose-read-view-streamed-object-digests).\n\t\t\tif patchDigest != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif err := gitStream(16*1024*1024, diffHash, \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", sha, \"--\"); err != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, err\n\t\t\t}\n\t\t}\n\t\tpaths = mergeObservedPaths(commitPathLists)\n\t} else {\n\t\tnameStatus, err := gitOutput(8*1024*1024, \"diff\", \"--name-status\", \"-z\", \"-M\", \"--no-ext-diff\", resolvedBase, resolvedHead, \"--\")\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n\t\tpaths, err = parseGitNameStatusNUL(nameStatus)\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n\t\tdiff, err := gitOutput(32*1024*1024, \"diff\", \"--binary\", \"--no-ext-diff\", resolvedBase, resolvedHead, \"--\")\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n\t\t_, _ = diffHash.Write(diff)\n\t\t// The net diff folds a create and a later rename into one creation; the\n\t\t// material inputs need each commit's own records.\n\t\tfor _, sha := range commits {\n\t\t\tperCommit, err := gitOutput(4*1024*1024, \"diff-tree\", \"--root\", \"--no-commit-id\", \"--name-status\", \"-z\", \"-M\", \"-r\", sha, \"--\")\n\t\t\tif err != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, err\n\t\t\t}\n\t\t\tparsed, err := parseGitNameStatusNUL(perCommit)\n\t\t\tif err != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, err\n\t\t\t}\n\t\t\tobserved = append(observed, parsed...)\n\t\t}\n\t}\n\tdigest := diffHash.Sum(nil)\n\tif patchDigest != nil && len(trailerCommits) > 0 {\n\t\tdigest = patchDigest\n\t}\n\tidSum := sha256.Sum256([]byte(spec + \"\\x00\" + resolvedBase + \"\\x00\" + resolvedHead + \"\\x00\" + hex.EncodeToString(digest[:])))\n\t// A trailer set is judged against the checkout's own tree: a later commit\n\t// without the trailer that changes an observed path or the matrix must move\n\t// the digest. An explicit range is a historical query and reads its end.\n\tmaterialHead := resolvedHead\n\tif len(trailerCommits) > 0 {\n\t\tmaterialHead = \"HEAD\"\n\t}\n\tif len(observed) == 0 {\n\t\tobserved = paths\n\t}\n\tmaterialInputs := posemodel.MaterialInputsOf(observed)\n\tmaterialDigest := materialSetDigestAt(gitOutput, root, materialHead, materialInputs)\n\treturn posemodel.ChangeSet{ID: \"cs-\" + hex.EncodeToString(idSum[:6]), Spec: spec, Selector: selector, Base: base, Head: head, ResolvedBase: resolvedBase, ResolvedHead: resolvedHead, Commits: commits, Paths: paths, DiffDigest: \"sha256:\" + hex.EncodeToString(digest[:]), MaterialDigest: materialDigest, MaterialInputs: &materialInputs}, nil\n}\n\nfunc allCommitsWithSpecTrailers(root string) (map[string][]string, error) {\n\t// A rolling commit limit changes historical attribution whenever an unrelated\n\t// commit pushes a tagged commit out of the window. Filter in Git and scan the\n\t// full matching history; the output bound still fails closed for huge inputs.\n\tout, err := gitOutputBounded(root, 32*1024*1024, posemodel.SpecTrailerLogArgs...)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tspecCommits := posemodel.ParseSpecTrailerLog(out)\n\treturn specCommits, nil\n}\n\nfunc allCommitsWithSpecTrailersIn(files posemodel.Files, root string) (map[string][]string, error) {\n\tspecs, _, err := allCommitsWithSpecTrailersOrderedIn(files, root)\n}\n\nfunc observedSortKey(path posemodel.ObservedPath) string {\n\treturn path.Action + \"\\x00\" + path.Path + \"\\x00\" + path.OldPath + \"\\x00\" + path.NewPath\n}\n\n// collectArtifactGraphInputsWithGapsIn also returns, by spec, why a part of\n// its history could not be read; the empty key is every spec.\nfunc collectArtifactGraphInputsWithGapsIn(files posemodel.Files, root string) ([]posemodel.Spec, []posemodel.ArtifactClaim, []posemodel.ChangeSet, []string, posemodel.ArtifactPolicy, map[string]string, error) {\n\tstore := posemodel.Store{Root: root, FS: files}\n\tpolicy, err := posemodel.LoadArtifactPolicyIn(files, root)\n\tif err != nil {\n\t\treturn nil, nil, nil, nil, policy, nil, err\n\t}\n\tclaims := []posemodel.ArtifactClaim{}\n\t_, initialSpecsErr := files.Stat(filepath.Join(root, \".pose\", \"specs\"))\n\tspecs, err := store.VisitSpecs(func(full posemodel.Spec) error {\n\t\tparsed, _, err := posemodel.ParseArtifactClaims(full, policy)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tclaims = append(claims, parsed...)\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\t_, currentSpecsErr := files.Stat(filepath.Join(root, \".pose\", \"specs\"))\n\t\t// Only an initially absent catalogue is an empty input. A disappearing\n\t\t// directory after callbacks is a failed capture, never partial success.\n\t\tif !errors.Is(initialSpecsErr, os.ErrNotExist) || !errors.Is(currentSpecsErr, os.ErrNotExist) || !errors.Is(err, os.ErrNotExist) || len(claims) != 0 {\n\t\t\treturn nil, nil, nil, nil, policy, nil, err\n\t\t}\n\t\tspecs = []posemodel.Spec{}\n\t}\n\tgaps := map[string]string{}\n\trefsBefore, refsErr := gitOutputBoundedIn(files, root, 8*1024*1024, \"show-ref\", \"--head\", \"--dereference\")\n\ttracked, err := gitTrackedPathsIn(files, root)\n\tif err != nil {\n\t\ttracked = []string{}\n\t\tgaps[\"\"] = \"the tracked paths could not be read: \" + err.Error()\n\t}\n\tchangeSetsMap := map[string]posemodel.ChangeSet{}\n\trecordedSets, recordedGap := loadRecordedChangeSetsWithGapIn(files, root)\n\tif recordedGap != \"\" && gaps[\"\"] == \"\" {\n\t\tgaps[\"\"] = recordedGap\n\t}\n\tfor _, recorded := range recordedSets {\n\t\tchangeSetsMap[recorded.ID] = recorded\n\t}\n\tspecTrailers, trailerOrder, err := allCommitsWithSpecTrailersOrderedIn(files, root)\n\tif err != nil && gaps[\"\"] == \"\" {\n\t\tgaps[\"\"] = \"the commits carrying POSE-Spec trailers could not be read: \" + err.Error()\n\t}\n\t// A shallow repository may hide commits carrying a trailer, and nothing\n\t// read from it can show which (LR-R3-02).\n\tif out, err := gitOutputBoundedIn(files, root, 4096, \"rev-parse\", \"--is-shallow-repository\"); err != nil || strings.TrimSpace(string(out)) != \"false\" {\n\t\tif gaps[\"\"] == \"\" {\n\t\t\tgaps[\"\"] = \"the repository's history is shallow or its depth could not be read\"\n\t\t}\n\t}\n\twanted := map[string]bool{}\n\tfor _, spec := range specs {\n\t\twanted[spec.Slug] = len(specTrailers[spec.Slug]) > 0\n\t}\n\tpatchDigests, patchFailures := trailerPatchDigests(files, root, trailerOrder, wanted)\n\tfor _, spec := range specs {\n\t\tif len(specTrailers[spec.Slug]) > 0 {\n\t\t\tif err := patchFailures[spec.Slug]; err != nil {\n\t\t\t\tgaps[spec.Slug] = \"its trailer change set could not be read: \" + err.Error()\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif set, err := resolveGitChangeSetWithPatchDigest(files, root, spec.Slug, \"\", \"\", specTrailers[spec.Slug], patchDigests[spec.Slug]); err == nil {\n\t\t\t\tchangeSetsMap[set.ID] = set\n\t\t\t} else {\n\t\t\t\tgaps[spec.Slug] = \"its trailer change set could not be read: \" + err.Error()\n\t\t\t}\n\t\t}\n\t}\n\trefsAfter, afterErr := gitOutputBoundedIn(files, root, 8*1024*1024, \"show-ref\", \"--head\", \"--dereference\")\n\tif refsErr == nil && afterErr == nil && !bytes.Equal(refsBefore, refsAfter) {\n\t\treturn nil, nil, nil, nil, policy, nil, fmt.Errorf(\"Git inputs changed during artifact collection: refs or HEAD moved; retry the operation\")\n\t}\n\tif (refsErr != nil || afterErr != nil) && gaps[\"\"] == \"\" {\n\t\tgaps[\"\"] = \"the repository refs or HEAD could not be bound to this artifact collection\"\n\t}\n\tchangeSets := make([]posemodel.ChangeSet, 0, len(changeSetsMap))\n\tfor _, set := range changeSetsMap {\n\t\tchangeSets = append(changeSets, set)\n\t}\n\tsort.Slice(changeSets, func(i, j int) bool { return changeSets[i].ID < changeSets[j].ID })\n\treturn specs, claims, changeSets, tracked, policy, gaps, nil\n}\n\n// collectArtifactGraphInputs reads and writes the filesystem directly; collectArtifactGraphInputsIn takes the\n// operation's files.\nfunc collectArtifactGraphInputs(root string) ([]posemodel.Spec, []posemodel.ArtifactClaim, []posemodel.ChangeSet, []string, posemodel.ArtifactPolicy, error) {\n\treturn collectArtifactGraphInputsIn(posemodel.NativeFiles(), root)\n}\n\n// collectArtifactGraphInputsIn drops what it could not read; a later removal,\n// which must judge every change of a spec, reads the gaps instead\n// (collectArtifactGraphInputsWithGapsIn, review round 2 LR-R2-03).\nfunc collectArtifactGraphInputsIn(files posemodel.Files, root string) ([]posemodel.Spec, []posemodel.ArtifactClaim, []posemodel.ChangeSet, []string, posemodel.ArtifactPolicy, error) {\n\tspecs, claims, sets, tracked, policy, _, err := collectArtifactGraphInputsWithGapsIn(files, root)\n\treturn specs, claims, sets, tracked, policy, err\n}\n\nfunc gitTrackedPaths(root string) ([]string, error) {\n\ttrackedRaw, err := gitOutputBounded(root, 32*1024*1024, \"ls-files\", \"-z\", \"--\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn parseGitTrackedPaths(trackedRaw)\n}\n\nfunc gitTrackedPathsIn(files posemodel.Files, root string) ([]string, error) {\n\ttrackedRaw, err := gitOutputBoundedIn(files, root, 32*1024*1024, \"ls-files\", \"-z\", \"--\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn parseGitTrackedPaths(trackedRaw)\n}\n","exit_code":0,"status":"completed"}}
