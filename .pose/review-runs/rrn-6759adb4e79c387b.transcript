{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,180p' pose-mcp/internal/cli/governance_operation_performance_test.go; cat .pose/rules/backend-go.md; rg -n 'artifact-check|surface-check' pose-mcp/internal/cli/artifact*.go pose-mcp/internal/cli/surface*.go; ls .pose/results; rg --files .pose | rg '(rvb-3bc|design-3948|delivery-validation)'\"","aggregated_output":"package cli\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nfunc TestGovernanceOperationPerformanceCapturesTrailersOnce(t *testing.T) {\n\trealGit, err := exec.LookPath(\"git\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, count := range []int{1, 3, 6} {\n\t\tt.Run(fmt.Sprint(count), func(t *testing.T) {\n\t\t\troot := t.TempDir()\n\t\t\tartifactGit(t, root, \"init\", \"-q\")\n\t\t\tartifactGit(t, root, \"config\", \"user.name\", \"Fixture\")\n\t\t\tartifactGit(t, root, \"config\", \"user.email\", \"fixture@example.invalid\")\n\t\t\tartifactGit(t, root, \"config\", \"core.hooksPath\", \"/dev/null\")\n\t\t\tmessage := \"one commit, several owners\\n\"\n\t\t\tfor i := 0; i < count; i++ {\n\t\t\t\tslug := fmt.Sprintf(\"sample-%d\", i)\n\t\t\t\twriteArtifactTestFile(t, root, \".pose/specs/\"+slug+\".md\", fmt.Sprintf(\"---\\nslug: %s\\nstatus: draft\\n---\\n\\n# Spec\\n\\n## 3. Technical Plan\\n\\n### Artifacts\\n- none: analysis\\n\", slug))\n\t\t\t\tmessage += \"\\nPOSE-Spec: \" + slug\n\t\t\t}\n\t\t\tartifactGit(t, root, \"add\", \".pose\")\n\t\t\tartifactGit(t, root, \"commit\", \"-q\", \"-m\", message)\n\t\t\tbin, events := t.TempDir(), filepath.Join(t.TempDir(), \"git-events\")\n\t\t\t// A tiny real-Git wrapper records only trailer-log launches. These\n\t\t\t// synthetic paths/arguments contain no newlines; no timing is inferred.\n\t\t\twrapper := \"#!/bin/sh\\nprintf 'call\\\\n' >> \" + shellQuote(events) + \"\\nfor arg do\\n  if [ \\\"$arg\\\" = '--grep=POSE-Spec:' ]; then printf 'log\\\\n' >> \" + shellQuote(events) + \"; fi\\ndone\\noutput=$(mktemp \" + shellQuote(filepath.Join(bin, \"git-output-XXXXXX\")) + \") || exit 99\\n\" + shellQuote(realGit) + \" \\\"$@\\\" > \\\"$output\\\"\\nstatus=$?\\nprintf 'bytes %s\\\\n' \\\"$(wc -c < \\\"$output\\\")\\\" >> \" + shellQuote(events) + \"\\ncat \\\"$output\\\"\\nrm -f \\\"$output\\\"\\nexit \\\"$status\\\"\\n\"\n\t\t\tif err := os.WriteFile(filepath.Join(bin, \"git\"), []byte(wrapper), 0o755); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tt.Setenv(\"PATH\", bin+string(os.PathListSeparator)+os.Getenv(\"PATH\"))\n\t\t\tspecs, _, sets, _, _, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root)\n\t\t\tif err != nil || len(gaps) != 0 || len(specs) != count || len(sets) != count {\n\t\t\t\tt.Fatalf(\"lost collector inputs: specs=%d sets=%d gaps=%v err=%v\", len(specs), len(sets), gaps, err)\n\t\t\t}\n\t\t\traw, err := os.ReadFile(events)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif got := bytes.Count(raw, []byte(\"log\\n\")); got != 1 {\n\t\t\t\tt.Fatalf(\"full trailer log read %d times for %d specs, want one bounded capture\", got, count)\n\t\t\t}\n\t\t\tcalls := bytes.Count(raw, []byte(\"call\\n\"))\n\t\t\t// Each change set reads its head tree once for the material digest and the root\n\t\t\t// checks once whether the checkout is shallow (one more\n\t\t\t// launch per spec); the full trailer log is still captured exactly once.\n\t\t\t// The one commit every spec shares is read for its patch once, not\n\t\t\t// once per spec (spec pose-index-streams-each-commit-once): N-1\n\t\t\t// fewer launches than before.\n\t\t\twantCalls := map[int]int{1: 13, 3: 25, 6: 43}[count]\n\t\t\tif calls != wantCalls {\n\t\t\t\tt.Fatalf(\"Git subprocesses=%d want%d\", calls, wantCalls)\n\t\t\t}\n\t\t\tgeneratedBytes := 0\n\t\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n\t\t\t\tif strings.HasPrefix(line, \"bytes \") {\n\t\t\t\t\tvar size int\n\t\t\t\t\tif _, err := fmt.Sscanf(line, \"bytes %d\", &size); err != nil {\n\t\t\t\t\t\tt.Fatal(err)\n\t\t\t\t\t}\n\t\t\t\t\tgeneratedBytes += size\n\t\t\t\t}\n\t\t\t}\n\t\t\tt.Logf(\"producer=artifact-collector specs=%d full_trailer_logs=1 git_subprocesses=%d git_generated_stdout_bytes=%d\", count, calls, generatedBytes)\n\t\t})\n\t}\n}\n\n// The pre-optimization scoring rule, retained as a test oracle. It normalizes\n// each pair and does not call either prepared production helper.\nfunc governanceLegacySimilarity(left, right string) float64 {\n\tleft, right = normalizeFollowup(left), normalizeFollowup(right)\n\tleftTokens, rightTokens := followupTokens(left), followupTokens(right)\n\tintersection, union := 0, len(leftTokens)\n\tfor token := range rightTokens {\n\t\tif leftTokens[token] {\n\t\t\tintersection++\n\t\t} else {\n\t\t\tunion++\n\t\t}\n\t}\n\tjaccard := 0.0\n\tif union > 0 {\n\t\tjaccard = float64(intersection) / float64(union)\n\t}\n\tsequence := ratcliffRatio([]rune(left), []rune(right))\n\tif sequence > jaccard {\n\t\treturn sequence\n\t}\n\treturn jaccard\n}\n\nfunc governanceLegacyClusters(entries []followup, threshold float64) []nearDuplicateCandidate {\n\tparents := make([]int, len(entries))\n\tfor i := range parents {\n\t\tparents[i] = i\n\t}\n\tvar find func(int) int\n\tfind = func(i int) int {\n\t\tif parents[i] != i {\n\t\t\tparents[i] = find(parents[i])\n\t\t}\n\t\treturn parents[i]\n\t}\n\tfor left := range entries {\n\t\tfor right := left + 1; right < len(entries); right++ {\n\t\t\tif entries[left].Spec != entries[right].Spec && governanceLegacySimilarity(entries[left].Text, entries[right].Text) >= threshold {\n\t\t\t\tparents[find(left)] = find(right)\n\t\t\t}\n\t\t}\n\t}\n\tgroups := map[int][]followup{}\n\tfor i, entry := range entries {\n\t\tgroups[find(i)] = append(groups[find(i)], entry)\n\t}\n\tkeys := []int{}\n\tfor key := range groups {\n\t\tkeys = append(keys, key)\n\t}\n\tsort.Ints(keys)\n\tresult := []nearDuplicateCandidate{}\n\tfor _, key := range keys {\n\t\tspecs := map[string]bool{}\n\t\tfor _, entry := range groups[key] {\n\t\t\tspecs[entry.Spec] = true\n\t\t}\n\t\tif len(specs) < 2 {\n\t\t\tcontinue\n\t\t}\n\t\tcandidate := nearDuplicateCandidate{}\n\t\tfor _, entry := range groups[key] {\n\t\t\tdisposition := entry.RawDisposition\n\t\t\tif disposition == \"\" {\n\t\t\t\tdisposition = \"open\"\n\t\t\t}\n\t\t\tcandidate.Members = append(candidate.Members, nearDuplicateMember{entry.Spec, entry.Text, disposition})\n\t\t}\n\t\tfor spec := range specs {\n\t\t\tcandidate.Specs = append(candidate.Specs, spec)\n\t\t}\n\t\tsort.Strings(candidate.Specs)\n\t\tresult = append(result, candidate)\n\t}\n\treturn result\n}\n\nfunc TestGovernanceOperationPerformanceClustering(t *testing.T) {\n\ttexts := []string{\"\", \"!!!\", \"the and para\", \"Árvore `ação` 123\", \"árvore ação 123\", \"audit the release gate\", \"audit release gate\", \"release audit before publication\", \"aabcc abcab\"}\n\tentries := []followup{}\n\tfor i, text := range texts {\n\t\tentries = append(entries, followup{Spec: fmt.Sprintf(\"sample-%d\", i%4), Text: text})\n\t\tfor _, right := range texts {\n\t\t\tgot := preparedFollowupSimilarity(prepareFollowupSimilarity(text), prepareFollowupSimilarity(right))\n\t\t\tif got != governanceLegacySimilarity(text, right) {\n\t\t\t\tt.Fatalf(\"changed score %q %q: %g\", text, right, got)\n\t\t\t}\n\t\t}\n\t}\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\npose-mcp/internal/cli/artifact_integrity_test.go:74:\t\tt.Fatalf(\"artifact-check code=%d err=%s out=%s\", code, errOut.String(), out.String())\npose-mcp/internal/cli/artifact_integrity_test.go:99:\t\tt.Fatalf(\"artifact-check code=%d err=%s\", code, errOut.String())\npose-mcp/internal/cli/artifact_integrity_test.go:192:\t\tt.Fatalf(\"artifact-check code=%d err=%s out=%s\", code, errOut.String(), out.String())\npose-mcp/internal/cli/surface_check.go:196:\t\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\npose-mcp/internal/cli/surface_check.go:211:\t\t\treturn usageEr