drain)\n438\t\t\twriteReply(conn, reply)\n439\t\tdefault:\n440\t\t\tif s.opts.Handler != nil {\n441\t\t\t\t// The reply of a long operation must still be writable.\n442\t\t\t\t_ = conn.SetDeadline(time.Now().Add(hostedDuration(req.DeadlineMS) + requestDeadline))\n443\t\t\t\tif reply, ok := s.opts.Handler(ctx, req); ok {\n444\t\t\t\t\tid := s.opts.Identity\n445\t\t\t\t\treply.Identity, reply.Epoch, reply.PID = &id, s.epoch, os.Getpid()\n446\t\t\t\t\twriteReply(conn, reply)\n447\t\t\t\t\treturn\n448\t\t\t\t}\n449\t\t\t}\n450\t\t\twriteReply(conn, Reply{Error: fmt.Sprintf(\"the runtime does not host the operation %q\", req.Op)})\n451\t\t}\n452\t}\n453\t\n454\t// drain waits, up to the deadline, for the requests in flight besides this one."}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"a49a07b1-f17b-4f7c-910c-32c839bf658c","timestamp":"2026-11-10T07:59:34.687Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2694577954/worktree/pose-mcp/internal/worktreeruntime/runtime.go","content":"\t\treturn a\n\t}\n\treturn b\n}\n\nfunc (s *server) handle(ctx context.Context, conn net.Conn) {\n\tdefer conn.Close()\n\tatomic.StoreInt64(&s.last, time.Now().UnixNano())\n\t// The operating system says who is on the other end before a byte of it is read.\n\tif uc, ok := conn.(*net.UnixConn); !ok {\n\t\treturn\n\t} else if uid, err := peerUID(uc); err != nil || int(uid) != os.Getuid() {\n\t\treturn\n\t}\n\t_ = conn.SetDeadline(time.Now().Add(requestDeadline))\n\tline, err := bufio.NewReaderSize(io.LimitReader(conn, maxRequest), 4096).ReadBytes('\\n')\n\tif err != nil && len(line) == 0 {\n\t\treturn\n\t}\n\tvar req Request\n\tif err := json.Unmarshal(line, &req); err != nil {\n\t\twriteReply(conn, Reply{Error: \"the request is not valid JSON\"})\n\t\treturn\n\t}\n\ts.served.Add(1)\n\tswitch req.Op {\n\tcase \"handshake\":\n\t\tif req.Identity == nil {\n\t\t\twriteReply(conn, Reply{Error: \"a handshake carries the client's i