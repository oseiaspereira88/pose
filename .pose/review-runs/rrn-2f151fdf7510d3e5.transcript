{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RfPtrsCaHNQCFsxSDeyZiP","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"crypto/sha256\"\n7\t\t\"encoding/hex\"\n8\t\t\"encoding/json\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"sort\"\n14\t\t\"strings\"\n15\t\t\"sync/atomic\"\n16\t\t\"time\"\n17\t\n18\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n19\t\t\"github.com/harne8/pose-mcp/internal/version\"\n20\t\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n21\t)\n22\t\n23\t// Spec pose-worktree-runtime-resident-cache.\n24\t\n25\tconst runtimeRunSchema = \"pose.runtime.run/1\"\n26\t\n27\t// maxHostedOutput bounds what a hosted command's reply carries; past it the reply says the\n28\t// command ran and its output is not sent.\n29\tconst maxHostedOutput = 2 << 20\n30\t\n31\t// hostedCommands are the commands the runtime runs for a caller: the checks that read the\n32\t// project and answer. They run as the user that started the runtime, in its worktree, with\n33\t// the environment digest the caller proved equal to the runtime's: a caller never gains,\n34\t// through the runtime, an authority it does not have standalone.\n35\tvar hostedCommands = map[string]bool{\n36\t\t\"review-check\": true, \"closeout-check\": true, \"artifact-check\": true, \"surface-check\": true, \"roadmap-check\": true,\n37\t}\n38\t\n39\t// runtimeEnvDigest is the digest of the environment that decides what a command answers: the\n40\t// POSE_, HARNE8_, GIT_, CLAUDE and CODEX variables (project roots, identities, session markers\n41\t// seals detect), the locale, the home and state directories and NO_COLOR.\n42\tfunc runtimeEnvDigest(environ []string) string {\n43\t\tkeep := func(k string) bool {\n44\t\t\tfor _, p := range []string{\"POSE_\", \"HARNE8_\", \"GIT_\", \"CLAUDE\", \"CODEX\", \"XDG_STATE_HOME\", \"XDG_CONFIG_HOME\", \"XDG_RUNTIME_DIR\"} {\n45\t\t\t\tif strings.HasPrefix(k, p) {\n46\t\t\t\t\treturn true\n47\t\t\t\t}\n48\t\t\t}\n49\t\t\tswitch k {\n50\t\t\tcase \"LC_ALL\", \"LANG\", \"LANGUAGE\", \"HOME\", \"NO_COLOR\", \"USER\", \"LOGNAME\":\n51\t\t\t\treturn true\n52\t\t\t}\n53\t\t\treturn false\n54\t\t}\n55\t\tvar pairs []string\n56\t\tfor _, kv := range environ {\n57\t\t\tif k, _, ok := strings.Cut(kv, \"=\"); ok && keep(k) {\n58\t\t\t\tpairs = append(pairs, kv)\n59\t\t\t}\n60\t\t}\n61\t\tsort.Strings(pairs)\n62\t\tsum := sha256.Sum256([]byte(strings.Join(pairs, \"\\x00\")))\n63\t\treturn hex.EncodeToString(sum[:])\n64\t}\n65\t\n66\t// runtimeHostedRun runs a hosted command; tests replace it.\n67\ttype hostedRunFunc func(args []string, out, errb io.Writer) int\n68\t\n69\tvar runtimeHostedRun atomic.Pointer[hostedRunFunc]\n70\t\n71\t// Set at init: mainCommand reaches this file through cmdRuntime, so a variable initialised with\n72\t// it would be an initialization cycle.\n73\tfunc init() {\n74\t\trun := hostedRunFunc(func(args []string, out, errb io.Writer) int { return mainCommand(args, out, errb) })\n75\t\truntimeHostedRun.Store(&run)\n76\t}\n77\t\n78\t// runtimeHostedHandler runs the commands the runtime hosts, one at a time (the commands read\n79\t// and may refresh the project's derived files, so two at once would race themselves), and\n80\t// answers with a typed result. Anything it does not host or will not run is refused before it\n81\t// starts.\n82\tfunc runtimeHostedHandler(envDigest string, busy *atomic.Int64) func(context.Context, worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n83\t\tsem := make(chan struct{}, 1)\n84\t\treturn func(ctx context.Context, req worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n85\t\t\tif req.Op != \"run\" {\n86\t\t\t\treturn worktreeruntime.Reply{}, false\n87\t\t\t}\n88\t\t\trefuse := func(why string) (worktreeruntime.Reply, bool) {\n89\t\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeRefused, Reason: why}, true\n90\t\t\t}\n91\t\t\tswitch {\n92\t\t\tcase len(req.Args) == 0 || !hostedCommands[req.Args[0]]:\n93\t\t\t\treturn refuse(\"the runtime does not host this command\")\n94\t\t\tcase req.Env != envDigest:\n95\t\t\t\treturn refuse(\"the caller's environment differs from the one the runtime started in\")\n96\t\t\t}\n97\t\t\tstarted := time.Now()\n98\t\t\t// One hosted command at a time. The deadline covers the wait for its turn: a command\n99\t\t\t// that has not started by then is withdrawn and refused, so its caller may run it\n100\t\t\t// standalone without the runtime running it later as well.\n101\t\t\tlimit := time.Duration(req.DeadlineMS) * time.Millisecond\n102\t\t\tif limit <= 0 || limit > worktreeruntime.MaxHostedDuration {\n103\t\t\t\tlimit = worktreeruntime.MaxHostedDuration\n104\t\t\t}\n105\t\t\ttimer := time.NewTimer(limit)\n106\t\t\tdefer timer.Stop()\n107\t\t\tselect {\n108\t\t\tcase sem <- struct{}{}:\n109\t\t\tcase <-timer.C:\n110\t\t\t\treturn refuse(\"the runtime was busy with another command until the deadline: this one did not start\")\n111\t\t\tcase <-ctx.Done():\n112\t\t\t\treturn refuse(\"the runtime is stopping: this command did not start\")\n113\t\t\t}\n114\t\t\tdone := make(chan worktreeruntime.Reply, 1)\n115\t\t\t// The command counts as work in the runtime until it ends, even after its caller was\n116\t\t\t// answered at a deadline.\n117\t\t\tbusy.Add(1)\n118\t\t\tgo func() {\n119\t\t\t\tdefer busy.Add(-1)\n120\t\t\t\tdefer func() { <-sem }()\n121\t\t\t\thitsBefore, _, _, _ := posemodel.ResidentGitMemoStats()\n122\t\t\t\tvar out, errb bytes.Buffer\n123\t\t\t\tcode := 1\n124\t\t\t\tfunc() {\n125\t\t\t\t\tdefer func() {\n126\t\t\t\t\t\tif r := recover(); r != nil {\n127\t\t\t\t\t\t\terrb.WriteString(\"pose: the command panicked: \" + fmt.Sprint(r) + \"\\n\")\n128\t\t\t\t\t\t}\n129\t\t\t\t\t}()\n130\t\t\t\t\tcode = (*runtimeHostedRun.Load())(req.Args, &out, &errb)\n131\t\t\t\t}()\n132\t\t\t\thitsAfter, _, _, _ := posemodel.ResidentGitMemoStats()\n133\t\t\t\tif out.Len()+errb.Len() > maxHostedOutput {\n134\t\t\t\t\t// The command ran; its output is too large to send whole.\n135\t\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeError, Reason: \"the command's output exceeds what the runtime sends back\", ExitCode: code, ElapsedMS: time.Since(started).Milliseconds()}\n136\t\t\t\t\treturn\n137\t\t\t\t}\n138\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(),\n139\t\t\t\t\tElapsedMS: time.Since(started).Milliseconds(), MemoHits: hitsAfter - hitsBefore}\n140\t\t\t}()\n141\t\t\tselect {\n142\t\t\tcase reply := <-done:\n143\t\t\t\treturn reply, true\n144\t\t\tcase <-timer.C:\n145\t\t\t\t// The command is read-only apart from refreshing derived files and cannot be\n146\t\t\t\t// cancelled; it ends on its own and the next one waits for it.\n147\t\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeDeadline, Reason: \"the deadline passed while the command ran; it was not stopped\", ElapsedMS: time.Since(started).Milliseconds()}, true\n148\t\t\t}\n149\t\t}\n150\t}\n151\t\n152\t// cmdRuntimeRun is `pose runtime run [--envelope] [--timeout <d>] <command> [args...]`: the\n153\t// command runs in the runtime when one is running, compatible and willing, and standalone in\n154\t// this process otherwise. The exit code and the output are the command's; --envelope prints\n155\t// one document with them and with where it ran. A command that reached the runtime and whose\n156\t// answer did not come back whole is never rerun here: it may have run.\n157\tfunc cmdRuntimeRun(root string, args []string, stdout, stderr io.Writer) int {\n158\t\tenvelope, timeout := false, time.Duration(0)\n159\t\tfor len(args) > 0 && strings.HasPrefix(args[0], \"--\") {\n160\t\t\tswitch args[0] {\n161\t\t\tcase \"--envelope\":\n162\t\t\t\tenvelope = true\n163\t\t\t\targs = args[1:]\n164\t\t\tcase \"--timeout\":\n165\t\t\t\tif len(args) < 2 {\n166\t\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: --timeout needs a duration\")\n167\t\t\t\t\treturn 2\n168\t\t\t\t}\n169\t\t\t\td, err := time.ParseDuration(args[1])\n170\t\t\t\tif err != nil || d <= 0 {\n171\t\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: \" + args[1] + \" is not a duration\")\n172\t\t\t\t\treturn 2\n173\t\t\t\t}\n174\t\t\t\ttimeout, args = d, args[2:]\n175\t\t\tdefault:\n176\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: unknown flag \" + args[0])\n177\t\t\t\treturn 2\n178\t\t\t}\n179\t\t}\n180\t\tif len(args) == 0 {\n181\t\t\trender(stdout, stderr).Usage(tr(\"usage: pose runtime run [--envelope] [--timeout <d>] <command> [args...]\", \"uso: pose runtime run [--envelope] [--timeout <d>] <comando> [args...]\"))\n182\t\t\treturn 2\n183\t\t}\n184\t\tvia, reason := \"standalone\", \"\"\n185\t\tvar reply worktreeruntime.Reply\n186\t\tid, err := worktreeruntime.ResolveIdentity(root, version.Version, runtimeBuild())\n187\t\tif err == nil && hostedCommands[args[0]] {\n188\t\t\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n189\t\t\tif _, herr := client.Handshake(context.Background()); herr != nil {\n190\t\t\t\treason = herr.Error()\n191\t\t\t} else {\n192\t\t\t\tvar rerr error\n193\t\t\t\treply, rerr = client.Run(context.Background(), args, runtimeEnvDigest(os.Environ()), timeout)\n194\t\t\t\tvar unknown *worktreeruntime.OutcomeUnknownError\n195\t\t\t\tswitch {\n196\t\t\t\tcase errors.As(rerr, &unknown):\n197\t\t\t\t\treturn runtimeRunUnknown(stdout, stderr, envelope, args, rerr)\n198\t\t\t\tcase rerr != nil:\n199\t\t\t\t\treason = rerr.Error()\n200\t\t\t\tcase reply.Outcome == worktreeruntime.OutcomeCompleted:\n201\t\t\t\t\tvia = \"runtime\"\n202\t\t\t\tcase reply.Outcome == worktreeruntime.OutcomeRefused:\n203\t\t\t\t\treason = reply.Reason\n204\t\t\t\tcase reply.Outcome == worktreeruntime.OutcomeError:\n205\t\t\t\t\t// The command ran and ended; only its output was too large to bring back. The\n206\t\t\t\t\t// outcome is known, so the exit code is the command's.\n207\t\t\t\t\tvia, reply.Stderr = \"runtime\", reply.Reason+\"\\n\"\n208\t\t\t\tdefault:\n209\t\t\t\t\treturn runtimeRunUnknown(stdout, stderr, envelope, args, errors.New(reply.Outcome+\": \"+reply.Reason))\n210\t\t\t\t}\n211\t\t\t}\n212\t\t} else if err != nil {\n213\t\t\treason = err.Error()\n214\t\t} else {\n215\t\t\treason = \"the command is not one the runtime hosts\"\n216\t\t}\n217\t\tif via == \"standalone\" {\n218\t\t\tvar out, errb bytes.Buffer\n219\t\t\tstarted := time.Now()\n220\t\t\tcode := mainCommand(args, &out, &errb)\n221\t\t\treply = worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(), ElapsedMS: time.Since(started).Milliseconds()}\n222\t\t}\n223\t\tif envelope {\n224\t\t\tdoc := map[string]any{\"schema\": runtimeRunSchema, \"via\": via, \"outcome\": reply.Outcome, \"exit_code\": reply.ExitCode, \"stdout\": reply.Stdout, \"stderr\": reply.Stderr, \"elapsed_ms\": reply.ElapsedMS}\n225\t\t\tif reason != \"\" {\n226\t\t\t\tdoc[\"fallback_reason\"] = reason\n227\t\t\t}\n228\t\t\tif via == \"runtime\" {\n229\t\t\t\tdoc[\"epoch\"], doc[\"memo_hits\"] = reply.Epoch, reply.MemoHits\n230\t\t\t}\n231\t\t\t_ = json.NewEncoder(stdout).Encode(doc)\n232\t\t\treturn reply.ExitCode\n233\t\t}\n234\t\t// The command's own output, passed through byte for byte.\n235\t\t_, _ = stdout.Write([]byte(reply.Stdout))\n236\t\t_, _ = stderr.Write([]byte(reply.Stderr))\n237\t\treturn reply.ExitCode\n238\t}\n239\t\n240\tfunc runtimeRunUnknown(stdout, stderr io.Writer, envelope bool, args []string, err error) int {\n241\t\tmsg := \"pose runtime run \" + args[0] + \": \" + err.Error() + \"; \" + tr(\"it may have run, so it was not repeated here: check its effects before running it again\", \"pode ter rodado, então não foi repetido aqui: confira seus efeitos antes de rodá-lo de novo\")\n242\t\tif envelope {\n243\t\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeRunSchema, \"via\": \"runtime\", \"outcome\": \"unknown\", \"exit_code\": 1, \"stderr\": msg})\n244\t\t\treturn 1\n245\t\t}\n246\t\trender(stdout, stderr).Failure(msg)\n247\t\treturn 1\n248\t}\n249\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"7e36ea3b-de49-4044-8db3-3f72b0949c4c","timestamp":"2026-11-10T07:57:16.206Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2694577954/worktree/pose-mcp/internal/cli/runtime_host.go","content":"package cli\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n)\n\n// Spec pose-worktree-runtime-resident-cache.\n\nconst runtimeRunSchema = \"pose.runtime.run/1\"\n\n// maxHostedOutput bounds what a hosted command's reply carries; past it the reply says the\n// command ran and its output is not sent.\nconst maxHostedOutput = 2 << 20\n\n// hostedCommands are the commands the runtime runs for a caller: the checks that read the\n// project and answer. They run as the user that started the runtime, in its worktree, with\n// the environment digest the caller proved equal to the runtime's: a caller never gains,\n// through the runtime, an authority it does not have standalone.\nvar hostedCommands = map[string]bool{\n\t\"review-check\": true, \"closeout-check\": true, \"artifact-check\": true, \"surface-check\": true, \"roadmap-check\": true,\n}\n\n// runtimeEnvDigest is the digest of the environment that decides what a command answers: the\n// POSE_, HARNE8_, GIT_, CLAUDE and CODEX variables (project roots, identities, session markers\n// seals detect), the locale, the home and state directories and NO_COLOR.\nfunc runtimeEnvDigest(environ []string) string {\n\tkeep := func(k string) bool {\n\t\tfor _, p := range []string{\"POSE_\", \"HARNE8_\", \"GIT_\", \"CLAUDE\", \"CODEX\", \"XDG_STATE_HOME\", \"XDG_CONFIG_HOME\", \"XDG_RUNTIME_DIR\"} {\n\t\t\tif strings.HasPrefix(k, p) {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t\tswitch k {\n\t\tcase \"LC_ALL\", \"LANG\", \"LANGUAGE\", \"HOME\", \"NO_COLOR\", \"USER\", \"LOGNAME\":\n\t\t\treturn true\n\t\t}\n\t\treturn false\n\t}\n\tvar pairs []string\n\tfor _, kv := range environ {\n\t\tif k, _, ok := strings.Cut(kv, \"=\"); ok && keep(k) {\n\t\t\tpairs = append(pairs, kv)\n\t\t}\n\t}\n\tsort.Strings(pairs)\n\tsum := sha256.Sum256([]byte(strings.Join(pairs, \"\\x00\")))\n\treturn hex.EncodeToString(sum[:])\n}\n\n// runtimeHostedRun runs a hosted command; tests replace it.\ntype hostedRunFunc func(args []string, out, errb io.Writer) int\n\nvar runtimeHostedRun atomic.Pointer[hostedRunFunc]\n\n// Set at init: mainCommand reaches this file through cmdRuntime, so a variable initialised with\n// it would be an initialization cycle.\nfunc init() {\n\trun := hostedRunFunc(func(args []string, out, errb io.Writer) int { return mainCommand(args, out, errb) })\n\truntimeHostedRun.Store(&run)\n}\n\n// runtimeHostedHandler runs the commands the runtime hosts, one at a time (the commands read\n// and may refresh the project's derived files, so two at once would race themselves), and\n// answers with a typed result. Anything it does not host or will not run is refused before it\n// starts.\nfunc runtimeHostedHandler(envDigest string, busy *atomic.Int64) func(context.Context, worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n\tsem := make(chan struct{}, 1)\n\treturn func(ctx context.Context, req worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n\t\tif req.Op != \"run\" {\n\t\t\treturn worktreeruntime.Reply{}, false\n\t\t}\n\t\trefuse := func(why string) (worktreeruntime.Reply, bool) {\n\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeRefused, Reason: why}, true\n\t\t}\n\t\tswitch {\n\t\tcase len(req.Args) == 0 || !hostedCommands[req.Args[0]]:\n\t\t\treturn refuse(\"the runtime does not host this command\")\n\t\tcase req.Env != envDigest:\n\t\t\treturn refuse(\"the caller's environment differs from the one the runtime started in\")\n\t\t}\n\t\tstarted := time.Now()\n\t\t// One hosted command at a time. The deadline covers the wait for its turn: a command\n\t\t// that has not started by then is withdrawn and refused, so its caller may run it\n\t\t// standalone without the runtime running it later as well.\n\t\tlimit := time.Duration(req.DeadlineMS) * time.Millisecond\n\t\tif limit <= 0 || limit > worktreeruntime.MaxHostedDuration {\n\t\t\tlimit = worktreeruntime.MaxHostedDuration\n\t\t}\n\t\ttimer := time.NewTimer(limit)\n\t\tdefer timer.Stop()\n\t\tselect {\n\t\tcase sem <- struct{}{}:\n\t\tcase <-timer.C:\n\t\t\treturn refuse(\"the runtime was busy with another command until the deadline: this one did not start\")\n\t\tcase <-ctx.Done():\n\t\t\treturn refuse(\"the runtime is stopping: this command did not start\")\n\t\t}\n\t\tdone := make(chan worktreeruntime.Reply, 1)\n\t\t// The command counts as work in the runtime until it ends, even after its caller was\n\t\t// answered at a deadline.\n\t\tbusy.Add(1)\n\t\tgo func() {\n\t\t\tdefer busy.Add(-1)\n\t\t\tdefer func() { <-sem }()\n\t\t\thitsBefore, _, _, _ := posemodel.ResidentGitMemoStats()\n\t\t\tvar out, errb bytes.Buffer\n\t\t\tcode := 1\n\t\t\tfunc() {\n\t\t\t\tdefer func() {\n\t\t\t\t\tif r := recover(); r != nil {\n\t\t\t\t\t\terrb.WriteString(\"pose: the command panicked: \" + fmt.Sprint(r) + \"\\n\")\n\t\t\t\t\t}\n\t\t\t\t}()\n\t\t\t\tcode = (*runtimeHostedRun.Load())(req.Args, &out, &errb)\n\t\t\t}()\n\t\t\thitsAfter, _, _, _ := posemodel.ResidentGitMemoStats()\n\t\t\tif out.Len()+errb.Len() > maxHostedOutput {\n\t\t\t\t// The command ran; its output is too large to send whole.\n\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeError, Reason: \"the command's output exceeds what the runtime sends back\", ExitCode: code, ElapsedMS: time.Since(started).Milliseconds()}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(),\n\t\t\t\tElapsedMS: time.Since(started).Milliseconds(), MemoHits: hitsAfter - hitsBefore}\n\t\t}()\n\t\tselect {\n\t\tcase reply := <-done:\n\t\t\treturn reply, true\n\t\tcase <-timer.C:\n\t\t\t// The command is read-only apart from refreshing derived files and cannot be\n\t\t\t// cancelled; it ends on its own and the next one waits for it.\n\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeDeadline, Reason: \"the deadline passed while the command ran; it was not stopped\", ElapsedMS: time.Since(started).Milliseconds()}, true\n\t\t}\n\t}\n}\n\n// cmdRuntimeRun is `pose runtime run [--envelope] [--timeout <d>] <command> [args...]`: the\n// command runs in the runtime when one is running, compatible and willing, and standalone in\n// this process otherwise. The exit code and the output are the command's; --envelope prints\n// one document with them and with where it ran. A command that reached the runtime and whose\n// answer did not come back whole is never rerun here: it may have run.\nfunc cmdRuntimeRun(root string, args []string, stdout, stderr io.Writer) int {\n\tenvelope, timeout := false, time.Duration(0)\n\tfor len(args) > 0 && strings.HasPrefix(args[0], \"--\") {\n\t\tswitch args[0] {\n\t\tcase \"--envelope\":\n\t\t\tenvelope = true\n\t\t\targs = args[1:]\n\t\tcase \"--timeout\":\n\t\t\tif len(args) < 2 {\n\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: --timeout needs a duration\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\td, err := time.ParseDuration(args[1])\n\t\t\tif err != nil || d <= 0 {\n\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: \" + args[1] + \" is not a duration\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\ttimeout, args = d, args[2:]\n\t\tdefault:\n\t\t\trender(stdout, stderr).Failure(\"pose runtime run: unknown flag \" + args[0])\n\t\t\treturn 2\n\t\t}\n\t}\n\tif len(args) == 0 {\n\t\trender(stdout, stderr).Usage(tr(\"usage: pose runtime run [--envelope] [--timeout <d>] <command> [args...]\", \"uso: pose runtime run [--envelope] [--timeout <d>] <comando> [args...]\"))\n\t\treturn 2\n\t}\n\tvia, reason := \"standalone\", \"\"\n\tvar reply worktreeruntime.Reply\n\tid, err := worktreeruntime.ResolveIdentity(root, version.Version, runtimeBuild())\n\tif err == nil && hostedCommands[args[0]] {\n\t\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n\t\tif _, herr := client.Handshake(context.Background()); herr != nil {\n\t\t\treason = herr.Error()\n\t\t} else {\n\t\t\tvar rerr error\n\t\t\treply, rerr = client.Run(context.Background(), args, runtimeEnvDigest(os.Environ()), timeout)\n\t\t\tvar unknown *worktreeruntime.OutcomeUnknownError\n\t\t\tswitch {\n\t\t\tcase errors.As(rerr, &unknown):\n\t\t\t\treturn runtimeRunUnknown(stdout, stderr, envelope, args, rerr)\n\t\t\tcase rerr != nil:\n\t\t\t\treason = rerr.Error()\n\t\t\tcase reply.Outcome == worktreeruntime.OutcomeCompleted:\n\t\t\t\tvia = \"runtime\"\n\t\t\tcase reply.Outcome == worktreeruntime.OutcomeRefused:\n\t\t\t\treason = reply.Reason\n\t\t\tcase reply.Outcome == worktreeruntime.OutcomeError:\n\t\t\t\t// The command ran and ended; only its output was too large to bring back. The\n\t\t\t\t// outcome is known, so the exit code is the command's.\n\t\t\t\tvia, reply.Stderr = \"runtime\", reply.Reason+\"\\n\"\n\t\t\tdefault:\n\t\t\t\treturn runtimeRunUnknown(stdout, stderr, envelope, args, errors.New(reply.Outcome+\": \"+reply.Reason))\n\t\t\t}\n\t\t}\n\t} else if err != nil {\n\t\treason = err.Error()\n\t} else {\n\t\treason = \"the command is not one the runtime hosts\"\n\t}\n\tif via == \"standalone\" {\n\t\tvar out, errb bytes.Buffer\n\t\tstarted := time.Now()\n\t\tcode := mainCommand(args, &out, &errb)\n\t\treply = worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(), ElapsedMS: time.Since(started).Milliseconds()}\n\t}\n\tif envelope {\n\t\tdoc := map[string]any{\"schema\": runtimeRunSchema, \"via\": via, \"outcome\": reply.Outcome, \"exit_code\": reply.ExitCode, \"stdout\": reply.Stdout, \"stderr\": reply.Stderr, \"elapsed_ms\": reply.ElapsedMS}\n\t\tif reason != \"\" {\n\t\t\tdoc[\"fallback_reason\"] = reason\n\t\t}\n\t\tif via == \"runtime\" {\n\t\t\tdoc[\"epoch\"], doc[\"memo_hits\"] = reply.Epoch, reply.MemoHits\n\t\t}\n\t\t_ = json.NewEncoder(stdout).Encode(doc)\n\t\treturn reply.ExitCode\n\t}\n\t// The command's own output, passed through byte for byte.\n\t_, _ = stdout.Write([]byte(reply.Stdout))\n\t_, _ = stderr.Write([]byte(reply.Stderr))\n\treturn reply.ExitCode\n}\n\nfunc runtimeRunUnknown(stdout, stderr io.Writer, envelope bool, args []string, err error) int {\n\tmsg := \"pose runtime run \" + args[0] + \": \" + err.Error() + \"; \" + tr(\"it may have run, so it was not repeated here: check its effects before running it again\", \"pode ter rodado, então não foi repetido aqui: confira seus efeitos antes de rodá-lo de novo\")\n\tif envelope {\n\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeRunSchema, \"via\": \"runtime\", \"outcome\": \"unknown\", \"exit_code\": 1, \"stderr\": msg})\n\t\treturn 1\n\t}\n\trender(stdout, stderr).Failure(msg)\n\treturn 1\n}\n","numLines":249,"startLine":1,"totalLines":249}},"tool_result_meta":[{"id":"toolu_01RfPtrsCaHNQCFsxSDeyZiP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
