{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0126DY74Lo4b2DJJP5bQPT81","type":"tool_result","content":"diff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex 677861b9..fa1928af 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2596,6 +2596,22 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"resident-cache-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\n+            \"test\",\n+            \"-race\",\n+            \"./internal/pose\",\n+            \"./internal/cli\",\n+            \"./internal/worktreeruntime\",\n+            \"-run\",\n+            \"TestTheResidentGitMemo|TestASecondOperationIsAnswered|TestAHostedCommand|TestACommandThatMayHaveRun|TestTheEnvironmentDigest|TestACommandThatNeverStarted|TestAReplyDoesNotEscape|TestAReplyThatArrives|TestTheRuntimeRefuses|TestACommandRunningPast\",\n+            \"-count=1\"\n+          ],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"audit-pure-git-integration\",\n           \"program\": \"go\",\ndiff --git a/pose-mcp/internal/worktreeruntime/runtime_test.go b/pose-mcp/internal/worktreeruntime/runtime_test.go\nindex b89a510a..ab19424c 100644\n--- a/pose-mcp/internal/worktreeruntime/runtime_test.go\n+++ b/pose-mcp/internal/worktreeruntime/runtime_test.go\n@@ -3,6 +3,7 @@ package worktreeruntime\n import (\n \t\"context\"\n \t\"errors\"\n+\t\"io\"\n \t\"net\"\n \t\"os\"\n \t\"os/exec\"\n@@ -248,8 +249,16 @@ func TestConcurrentStartsLeaveOneRuntimeAndNoOneRemovesItsSocket(t *testing.T) {\n \t\t}\n \t}\n \tc := Client{Identity: id, Dir: dir}\n-\tif _, err := c.Handshake(context.Background()); err != nil {\n-\t\tt.Fatalf(\"the winner does not answer after the losers returned: %v\", err)\n+\t// The winner holds the lock before it listens: it answers once it has bound the socket.\n+\tvar herr error\n+\tfor i := 0; i < 300; i++ {\n+\t\tif _, herr = c.Handshake(context.Background()); herr == nil {\n+\t\t\tbreak\n+\t\t}\n+\t\ttime.Sleep(10 * time.Millisecond)\n+\t}\n+\tif herr != nil {\n+\t\tt.Fatalf(\"the winner does not answer after the losers returned: %v\", herr)\n \t}\n \tcancel()\n \tif err := <-results; err != nil {\n@@ -326,8 +335,8 @@ func TestAStopReportsWhatItDrainedAndWhatItAbandoned(t *testing.T) {\n \t\t\tdefer cancel()\n \t\t\tdone := make(chan error, 1)\n \t\t\tgo func() {\n-\t\t\t\tdone <- Serve(ctx, Options{Identity: id, Dir: dir, Handler: func(_ context.Context, op string) (Reply, bool) {\n-\t\t\t\t\tif op != \"hold\" {\n+\t\t\t\tdone <- Serve(ctx, Options{Identity: id, Dir: dir, Handler: func(_ context.Context, req Request) (Reply, bool) {\n+\t\t\t\t\tif req.Op != \"hold\" {\n \t\t\t\t\t\treturn Reply{}, false\n \t\t\t\t\t}\n \t\t\t\t\tentered <- struct{}{}\n@@ -361,3 +370,48 @@ func TestAStopReportsWhatItDrainedAndWhatItAbandoned(t *testing.T) {\n \t\t})\n \t}\n }\n+\n+// A reply that arrives in part, here cut at its bound, is a request that may have been served:\n+// an unknown outcome, not a plain error a caller could treat as \"it did not run\".\n+func TestAReplyThatArrivesInPartIsAnUnknownOutcome(t *testing.T) {\n+\tskipUnsupported(t)\n+\tid := identity(t, repo(t), \"7.4.1\")\n+\tdir := shortDir(t)\n+\tctx, cancel := context.WithCancel(context.Background())\n+\tdefer cancel()\n+\tdone := make(chan error, 1)\n+\tgo func() {\n+\t\tdone <- Serve(ctx, Options{Identity: id, Dir: dir, Handler: func(_ context.Context, req Request) (Reply, bool) {\n+\t\t\tif req.Op != \"run\" {\n+\t\t\t\treturn Reply{}, false\n+\t\t\t}\n+\t\t\treturn Reply{Outcome: OutcomeCompleted, Stdout: strings.Repeat(\"x\", maxReply+1<<20)}, true\n+\t\t}})\n+\t}()\n+\tc := Client{Identity: id, Dir: dir}\n+\tfor i := 0; i < 200; i++ {\n+\t\tif _, err := c.Status(context.Background()); err == nil {\n+\t\t\tbreak\n+\t\t}\n+\t\ttime.Sleep(10 * time.Millisecond)\n+\t}\n+\t_, err := c.Run(context.Background(), []string{\"review-check\"}, \"env\", 0)\n+\tvar unknown *OutcomeUnknownError\n+\tif !errors.As(err, &unknown) {\n+\t\tt.Fatalf(\"a reply cut at its bound returned %v, not an unknown outcome\", err)\n+\t}\n+\tcancel()\n+\t<-done\n+}\n+\n+// A reply carries < > & as one byte each, so output near the bound is not pushed past it by\n+// escaping.\n+func TestAReplyDoesNotEscapeHTMLCharacters(t *testing.T) {\n+\tclient, server := net.Pipe()\n+\tdefer client.Close()\n+\tgo func() { writeReply(server, Reply{Stdout: \"<a href='x'>&</a>\"}); server.Close() }()\n+\traw, _ := io.ReadAll(client)\n+\tif strings.Contains(string(raw), \"\\\\u003c\") || strings.Contains(string(raw), \"\\\\u0026\") {\n+\t\tt.Fatalf(\"the reply escapes HTML characters: %s\", raw)\n+\t}\n+}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"96543af2-fd19-4ddd-8b8d-46873dbe8075","timestamp":"2026-11-10T07:58:43.426Z","tool_use_result":{"stdout":"diff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex 677861b9..fa1928af 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2596,6 +2596,22 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"resident-cache-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\n+            \"test\",\n+            \"-race\",\n+            \"./internal/pose\",\n+            \"./internal/cli\",\n+            \"./internal/worktreeruntime\",\n+            \"-run\",\n+            \"TestTheResidentGitMemo|TestASecondOperationIsAnswered|TestAHostedCommand|TestACommandThatMayHaveRun|TestTheEnvironmentDigest|TestACommandThatNeverStarted|TestAReplyDoesNotEscape|TestAReplyThatArrives|TestTheRuntimeRefuses|TestACommandRunningPast\",\n+    