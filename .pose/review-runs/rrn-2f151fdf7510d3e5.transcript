{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N465aexxrZYkoJvMrYfVk1","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"io\"\n8\t\t\"os\"\n9\t\t\"os/exec\"\n10\t\t\"strings\"\n11\t\t\"sync/atomic\"\n12\t\t\"testing\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/harne8/pose-mcp/internal/version\"\n16\t\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n17\t)\n18\t\n19\t// Spec pose-worktree-runtime-resident-cache.\n20\t\n21\ttype runtimeFixture struct {\n22\t\troot string\n23\t\trun  func(args ...string) (doc map[string]any, stdout string, code int)\n24\t\tstop func()\n25\t}\n26\t\n27\tfunc newRuntimeFixture(t *testing.T) *runtimeFixture {\n28\t\tt.Helper()\n29\t\tif !worktreeruntime.Supported() {\n30\t\t\tt.Skip(\"no protected local endpoint on this platform\")\n31\t\t}\n32\t\troot := t.TempDir()\n33\t\tif out, err := exec.Command(\"git\", \"-C\", root, \"init\", \"-q\").CombinedOutput(); err != nil {\n34\t\t\tt.Skipf(\"no git: %v %s\", err, out)\n35\t\t}\n36\t\tdir, err := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rth\")\n37\t\tif err != nil {\n38\t\t\tt.Fatal(err)\n39\t\t}\n40\t\tt.Cleanup(func() { os.RemoveAll(dir) })\n41\t\tt.Setenv(worktreeruntime.EnvDir, dir+\"/r\")\n42\t\toriginal := runtimeSpawn\n43\t\truntimeSpawn = func(r string, idle time.Duration) error {\n44\t\t\tgo cmdRuntime(r, []string{\"serve\", \"--idle\", idle.String()}, io.Discard, io.Discard)\n45\t\t\treturn nil\n46\t\t}\n47\t\tt.Cleanup(func() { runtimeSpawn = original })\n48\t\tf := &runtimeFixture{root: root}\n49\t\tf.run = func(args ...string) (map[string]any, string, int) {\n50\t\t\tvar out, errb bytes.Buffer\n51\t\t\tcode := cmdRuntimeRun(root, append([]string{\"--envelope\"}, args...), &out, &errb)\n52\t\t\tvar doc map[string]any\n53\t\t\t_ = json.Unmarshal(out.Bytes(), &doc)\n54\t\t\treturn doc, errb.String(), code\n55\t\t}\n56\t\tf.stop = func() { cmdRuntime(root, []string{\"stop\"}, io.Discard, io.Discard) }\n57\t\tt.Cleanup(f.stop)\n58\t\treturn f\n59\t}\n60\t\n61\tfunc (f *runtimeFixture) start(t *testing.T) {\n62\t\tt.Helper()\n63\t\tif code := cmdRuntime(f.root, []string{\"start\"}, io.Discard, io.Discard); code != 0 {\n64\t\t\tt.Fatalf(\"start exited %d\", code)\n65\t\t}\n66\t}\n67\t\n68\t// R2/R3: a hosted command run through the runtime answers what it answers standalone (the\n69\t// same exit code and output), says where it ran, and a command the runtime does not host, or a\n70\t// caller whose environment differs, runs standalone with the reason.\n71\tfunc TestAHostedCommandAnswersThroughTheRuntimeAsItDoesStandalone(t *testing.T) {\n72\t\tf := newRuntimeFixture(t)\n73\t\tstandalone, _, _ := f.run(\"roadmap-check\")\n74\t\tif standalone[\"via\"] != \"standalone\" || standalone[\"fallback_reason\"] == nil {\n75\t\t\tt.Fatalf(\"with no runtime: %v\", standalone)\n76\t\t}\n77\t\tf.start(t)\n78\t\thosted, _, code := f.run(\"roadmap-check\")\n79\t\tif hosted[\"via\"] != \"runtime\" || hosted[\"epoch\"] == \"\" {\n80\t\t\tt.Fatalf(\"through the runtime: %v\", hosted)\n81\t\t}\n82\t\tif hosted[\"stdout\"] != standalone[\"stdout\"] || hosted[\"stderr\"] != standalone[\"stderr\"] || hosted[\"exit_code\"] != standalone[\"exit_code\"] || code != int(standalone[\"exit_code\"].(float64)) {\n83\t\t\tt.Fatalf(\"the answers differ:\\nruntime:    %v\\nstandalone: %v\", hosted, standalone)\n84\t\t}\n85\t\t// A command the runtime does not host is not sent to it.\n86\t\tif doc, _, _ := f.run(\"state\"); doc[\"via\"] != \"standalone\" || !strings.Contains(doc[\"fallback_reason\"].(string), \"not one the runtime hosts\") {\n87\t\t\tt.Fatalf(\"an unhosted command: %v\", doc)\n88\t\t}\n89\t\t// A caller in another environment is refused by the runtime and runs standalone.\n90\t\tt.Setenv(\"POSE_RUNTIME_TEST_MARKER\", \"different\")\n91\t\tif doc, _, _ := f.run(\"roadmap-check\"); doc[\"via\"] != \"standalone\" || !strings.Contains(doc[\"fallback_reason\"].(string), \"environment\") {\n92\t\t\tt.Fatalf(\"a different environment: %v\", doc)\n93\t\t}\n94\t}\n95\t\n96\t// R4: a hosted command whose deadline passed, or whose answer did not come back, may have run:\n97\t// it is reported as unknown and not repeated standalone.\n98\tfunc TestACommandThatMayHaveRunIsNotRepeatedStandalone(t *testing.T) {\n99\t\tf := newRuntimeFixture(t)\n100\t\tf.start(t)\n101\t\toriginal := runtimeHostedRun.Load()\n102\t\tvar ran atomic.Int64\n103\t\tslow := hostedRunFunc(func(args []string, out, errb io.Writer) int {\n104\t\t\tran.Add(1)\n105\t\t\ttime.Sleep(400 * time.Millisecond)\n106\t\t\treturn (*original)(args, out, errb)\n107\t\t})\n108\t\truntimeHostedRun.Store(&slow)\n109\t\tdefer func() {\n110\t\t\ttime.Sleep(600 * time.Millisecond)\n111\t\t\truntimeHostedRun.Store(original)\n112\t\t}()\n113\t\tdoc, _, code := f.run(\"--timeout\", \"50ms\", \"roadmap-check\")\n114\t\tif code != 1 || doc[\"outcome\"] != \"unknown\" || doc[\"via\"] != \"runtime\" {\n115\t\t\tt.Fatalf(\"a deadline: %v exit %d\", doc, code)\n116\t\t}\n117\t\tif !strings.Contains(doc[\"stderr\"].(string), \"was not repeated here\") {\n118\t\t\tt.Fatalf(\"the report does not say it was not repeated: %v\", doc[\"stderr\"])\n119\t\t}\n120\t\ttime.Sleep(600 * time.Millisecond)\n121\t\tif ran.Load() != 1 {\n122\t\t\tt.Fatalf(\"the command ran %d times: it was repeated\", ran.Load())\n123\t\t}\n124\t}\n125\t\n126\t// The digest names what decides an answer and ignores what does not.\n127\tfunc TestTheEnvironmentDigestFollowsWhatDecidesAnAnswer(t *testing.T) {\n128\t\tbase := []string{\"POSE_PROJECT_ROOTS=/a\", \"LC_ALL=C\", \"PATH=/usr/bin\", \"PWD=/x\", \"CLAUDECODE=1\"}\n129\t\td := runtimeEnvDigest(base)\n130\t\tif d != runtimeEnvDigest([]string{\"PWD=/y\", \"CLAUDECODE=1\", \"PATH=/bin\", \"LC_ALL=C\", \"POSE_PROJECT_ROOTS=/a\"}) {\n131\t\t\tt.Fatal(\"the digest depends on the order or on variables that decide nothing\")\n132\t\t}\n133\t\tfor _, changed := range [][]string{\n134\t\t\t{\"POSE_PROJECT_ROOTS=/b\", \"LC_ALL=C\", \"CLAUDECODE=1\"},\n135\t\t\t{\"POSE_PROJECT_ROOTS=/a\", \"LC_ALL=pt_BR\", \"CLAUDECODE=1\"},\n136\t\t\t{\"POSE_PROJECT_ROOTS=/a\", \"LC_ALL=C\"},\n137\t\t} {\n138\t\t\tif runtimeEnvDigest(changed) == d {\n139\t\t\t\tt.Fatalf(\"the digest ignores a change that decides an answer: %v\", changed)\n140\t\t\t}\n141\t\t}\n142\t\t_ = context.Background\n143\t}\n144\t\n145\t// R10: the runtime itself refuses what it does not host and a caller in another environment,\n146\t// before it starts anything, whatever the client filtered.\n147\tfunc TestTheRuntimeRefusesWhatItDoesNotHostAndAnotherEnvironment(t *testing.T) {\n148\t\tf := newRuntimeFixture(t)\n149\t\tf.start(t)\n150\t\tid, err := worktreeruntime.ResolveIdentity(f.root, version.Version, runtimeBuild())\n151\t\tif err != nil {\n152\t\t\tt.Skip(err)\n153\t\t}\n154\t\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n155\t\tgood := runtimeEnvDigest(os.Environ())\n156\t\tif r, err := client.Run(context.Background(), []string{\"state\"}, good, 0); err != nil || r.Outcome != worktreeruntime.OutcomeRefused {\n157\t\t\tt.Fatalf(\"an unhosted command: %+v %v\", r, err)\n158\t\t}\n159\t\tif r, err := client.Run(context.Background(), []string{\"roadmap-check\"}, \"another\", 0); err != nil || r.Outcome != worktreeruntime.OutcomeRefused || !strings.Contains(r.Reason, \"environment\") {\n160\t\t\tt.Fatalf(\"another environment: %+v %v\", r, err)\n161\t\t}\n162\t\tif r, err := client.Run(context.Background(), nil, good, 0); err != nil || r.Outcome != worktreeruntime.OutcomeRefused {\n163\t\t\tt.Fatalf(\"no command: %+v %v\", r, err)\n164\t\t}\n165\t}\n166\t\n167\t// A command left running after its deadline still counts as work in the runtime: the status\n168\t// shows it in flight, and a stop waits for it and reports what it abandoned.\n169\tfunc TestACommandRunningPastItsDeadlineStillCountsAsInFlight(t *testing.T) {\n170\t\tf := newRuntimeFixture(t)\n171\t\tf.start(t)\n172\t\toriginal := runtimeHostedRun.Load()\n173\t\tslow := hostedRunFunc(func(args []string, out, errb io.Writer) int {\n174\t\t\ttime.Sleep(700 * time.Millisecond)\n175\t\t\treturn (*original)(args, out, errb)\n176\t\t})\n177\t\truntimeHostedRun.Store(&slow)\n178\t\tdefer func() {\n179\t\t\ttime.Sleep(900 * time.Millisecond)\n180\t\t\truntimeHostedRun.Store(original)\n181\t\t}()\n182\t\tf.run(\"--timeout\", \"50ms\", \"roadmap-check\")\n183\t\tid, err := worktreeruntime.ResolveIdentity(f.root, version.Version, runtimeBuild())\n184\t\tif err != nil {\n185\t\t\tt.Skip(err)\n186\t\t}\n187\t\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n188\t\tstatus, err := client.Status(context.Background())\n189\t\tif err != nil || status.InFlight < 1 {\n190\t\t\tt.Fatalf(\"the command running past its deadline is not in flight: %+v %v\", status, err)\n191\t\t}\n192\t\tstopped, err := client.Stop(context.Background(), 50*time.Millisecond)\n193\t\tif err != nil || stopped.Abandoned < 1 {\n194\t\t\tt.Fatalf(\"a stop did not report the running command abandoned: %+v %v\", stopped, err)\n195\t\t}\n196\t}\n197\t\n198\t// A command still waiting for its turn when its deadline passes did not start: it is refused,\n199\t// the caller runs it standalone, and the runtime never runs it later as well.\n200\tfunc TestACommandThatNeverStartedIsRefusedAndNotRunLater(t *testing.T) {\n201\t\tf := newRuntimeFixture(t)\n202\t\tf.start(t)\n203\t\toriginal := runtimeHostedRun.Load()\n204\t\tvar ran atomic.Int64\n205\t\tslow := hostedRunFunc(func(args []string, out, errb io.Writer) int {\n206\t\t\tran.Add(1)\n207\t\t\ttime.Sleep(600 * time.Millisecond)\n208\t\t\treturn (*original)(args, out, errb)\n209\t\t})\n210\t\truntimeHostedRun.Store(&slow)\n211\t\tdefer func() {\n212\t\t\ttime.Sleep(900 * time.Millisecond)\n213\t\t\truntimeHostedRun.Store(original)\n214\t\t}()\n215\t\tfirst := make(chan map[string]any, 1)\n216\t\tgo func() { doc, _, _ := f.run(\"roadmap-check\"); first <- doc }()\n217\t\ttime.Sleep(150 * time.Millisecond)\n218\t\tdoc, _, _ := f.run(\"--timeout\", \"100ms\", \"roadmap-check\")\n219\t\tif doc[\"via\"] != \"standalone\" || !strings.Contains(doc[\"fallback_reason\"].(string), \"did not start\") {\n220\t\t\tt.Fatalf(\"a command queued past its deadline: %v\", doc)\n221\t\t}\n222\t\tif d := <-first; d[\"via\"] != \"runtime\" {\n223\t\t\tt.Fatalf(\"the first command: %v\", d)\n224\t\t}\n225\t\ttime.Sleep(300 * time.Millisecond)\n226\t\tif ran.Load() != 1 {\n227\t\t\tt.Fatalf(\"the runtime ran %d commands: the refused one ran later\", ran.Load())\n228\t\t}\n229\t}\n230\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"c5374ca8-d023-46e1-835f-c754d616d817","timestamp":"2026-11-10T07:58:41.884Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2694577954/worktree/pose-mcp/internal/cli/runtime_host_test.go","content":"package cli\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/harne8/pose-mcp/internal/version\"\n\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n)\n\n// Spec pose-worktree-runtime-resident-cache.\n\ntype runtimeFixture struct {\n\troot string\n\trun  func(args ...string) (doc map[string]any, stdout string, code int)\n\tstop func()\n}\n\nfunc newRuntimeFixture(t *testing.T) *runtimeFixture {\n\tt.Helper()\n\tif !worktreeruntime.Supported() {\n\t\tt.Skip(\"no protected local endpoint on this platform\")\n\t}\n\troot := t.TempDir()\n\tif out, err := exec.Command(\"git\", \"-C\", root, \"init\", \"-q\").CombinedOutput(); err != nil {\n\t\tt.Skipf(\"no git: %v %s\", err, out)\n\t}\n\tdir, err := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rth\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Cleanup(func() { os.RemoveAll(dir) })\n\tt.Setenv(worktreeruntime.EnvDir, dir+\"/r\")\n\toriginal := runtimeSpawn\n\truntimeSpawn = func(r string, idle time.Duration) error {\n\t\tgo cmdRuntime(r, []string{\"serve\", \"--idle\", idle.String()}, io.Discard, io.Discard)\n\t\treturn nil\n\t}\n\tt.Cleanup(func() { runtimeSpawn = original })\n\tf := &runtimeFixture{root: root}\n\tf.run = func(args ...string) (map[string]any, string, int) {\n\t\tvar out, errb bytes.Buffer\n\t\tcode := cmdRuntimeRun(root, append([]string{\"--envelope\"}, args...), &out, &errb)\n\t\tvar doc map[string]any\n\t\t_ = json.Unmarshal(out.Bytes(), &doc)\n\t\treturn doc, errb.String(), code\n\t}\n\tf.stop = func() { cmdRuntime(root, []string{\"stop\"}, io.Discard, io.Discard) }\n\tt.Cleanup(f.stop)\n\treturn f\n}\n\nfunc (f *runtimeFixture) start(t *testing.T) {\n\tt.Helper()\n\tif code := cmdRuntime(f.root, []string{\"start\"}, io.Discard, io.Discard); code != 0 {\n\t\tt.Fatalf(\"start exited %d\", code)\n\t}\n}\n\n// R2/R3: a hosted command run through the runtime answers what it answers standalone (the\n// same exit code and output), says where it ran, and a command the runtime does not host, or a\n// caller whose environment differs, runs standalone with the reason.\nfunc TestAHostedCommandAnswersThroughTheRuntimeAsItDoesStandalone(t *testing.T) {\n\tf := newRuntimeFixture(t)\n\tstandalone, _, _ := f.run(\"roadmap-check\")\n\tif standalone[\"via\"] != \"standalone\" || standalone[\"fallback_reason\"] == nil {\n\t\tt.Fatalf(\"with no runtime: %v\", standalone)\n\t}\n\tf.start(t)\n\thosted, _, code := f.run(\"roadmap-check\")\n\tif hosted[\"via\"] != \"runtime\" || hosted[\"epoch\"] == \"\" {\n\t\tt.Fatalf(\"through the runtime: %v\", hosted)\n\t}\n\tif hosted[\"stdout\"] != standalone[\"stdout\"] || hosted[\"stderr\"] != standalone[\"stderr\"] || hosted[\"exit_code\"] != standalone[\"exit_code\"] || code != int(standalone[\"exit_code\"].(float64)) {\n\t\tt.Fatalf(\"the answers differ:\\nruntime:    %v\\nstandalone: %v\", hosted, standalone)\n\t}\n\t// A command the runtime does not host is not sent to it.\n\tif doc, _, _ := f.run(\"state\"); doc[\"via\"] != \"standalone\" || !strings.Contains(doc[\"fallback_reason\"].(string), \"not one the runtime hosts\") {\n\t\tt.Fatalf(\"an unhosted command: %v\", doc)\n\t}\n\t// A caller in another environment is refused by the runtime and runs standalone.\n\tt.Setenv(\"POSE_RUNTIME_TEST_MARKER\", \"different\")\n\tif doc, _, _ := f.run(\"roadmap-check\"); doc[\"via\"] != \"standalone\" || !strings.Contains(doc[\"fallback_reason\"].(string), \"environment\") {\n\t\tt.Fatalf(\"a different environment: %v\", doc)\n\t}\n}\n\n// R4: a hosted command whose deadline passed, or whose answer did not come back, may have run:\n// it is reported as unknown and not repeated standalone.\nfunc TestACommandThatMayHaveRunIsNotRepeatedStandalone(t *testing.T) {\n\tf := newRuntimeFixture(t)\n\tf.start(t)\n\toriginal := runtimeHostedRun.Load()\n\tvar ran atomic.Int64\n\tslow := hostedRunFunc(func(args []string, out, errb io.Writer) int {\n\t\tran.Add(1)\n\t\ttime.Sleep(400 * time.Millisecond)\n\t\treturn (*original)(args, out, errb)\n\t})\n\truntimeHostedRun.Store(&slow)\n\tdefer func() {\n\t\ttime.Sleep(600 * time.Millisecond)\n\t\truntimeHostedRun.Store(original)\n\t}()\n\tdoc, _, code := f.run(\"--timeout\", \"50ms\", \"roadmap-check\")\n\tif code != 1 || doc[\"outcome\"] != \"unknown\" || doc[\"via\"] != \"runtime\" {\n\t\tt.Fatalf(\"a deadline: %v exit %d\", doc, code)\n\t}\n\tif !strings.Contains(doc[\"stderr\"].(string), \"was not repeated here\") {\n\t\tt.Fatalf(\"the report does not say it was not repeated: %v\", doc[\"stderr\"])\n\t}\n\ttime.Sleep(600 * time.Millisecond)\n\tif ran.Load() != 1 {\n\t\tt.Fatalf(\"the command ran %d times: it was repeated\", ran.Load())\n\t}\n}\n\n// The digest names what decides an answer and ignores what does not.\nfunc TestTheEnvironmentDigestFollowsWhatDecidesAnAnswer(t *testing.T) {\n\tbase := []string{\"POSE_PROJECT_ROOTS=/a\", \"LC_ALL=C\", \"PATH=/usr/bin\", \"PWD=/x\", \"CLAUDECODE=1\"}\n\td := runtimeEnvDigest(base)\n\tif d != runtimeEnvDigest([]string{\"PWD=/y\", \"CLAUDECODE=1\", \"PATH=/bin\", \"LC_ALL=C\", \"POSE_PROJECT_ROOTS=/a\"}) {\n\t\tt.Fatal(\"the digest depends on the order or on variables that decide nothing\")\n\t}\n\tfor _, changed := range [][]string{\n\t\t{\"POSE_PROJECT_ROOTS=/b\", \"LC_ALL=C\", \"CLAUDECODE=1\"},\n\t\t{\"POSE_PROJECT_ROOTS=/a\", \"LC_ALL=pt_BR\", \"CLAUDECODE=1\"},\n\t\t{\"POSE_PROJECT_ROOTS=/a\", \"LC_ALL=C\"},\n\t} {\n\t\tif runtimeEnvDigest(changed) == d {\n\t\t\tt.Fatalf(\"the digest ignores a change that decides an answer: %v\", changed)\n\t\t}\n\t}\n\t_ = context.Background\n}\n\n// R10: the runtime itself refuses what it does not host and a caller in another environment,\n// before it starts anything, whatever the client filtered.\nfunc TestTheRuntimeRefusesWhatItDoesNotHostAndAnotherEnvironment(t *testing.T) {\n\tf := newRuntimeFixture(t)\n\tf.start(t)\n\tid, err := worktreeruntime.ResolveIdentity(f.root, version.Version, runtimeBuild())\n\tif err != nil {\n\t\tt.Skip(err)\n\t}\n\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n\tgood := runtimeEnvDigest(os.Environ())\n\tif r, err := client.Run(context.Background(), []string{\"state\"}, good, 0); err != nil || r.Outcome != worktreeruntime.OutcomeRefused {\n\t\tt.Fatalf(\"an unhosted command: %+v %v\", r, err)\n\t}\n\tif r, err := client.Run(context.Background(), []string{\"roadmap-check\"}, \"another\", 0); err != nil || r.Outcome != worktreeruntime.OutcomeRefused || !strings.Contains(r.Reason, \"environment\") {\n\t\tt.Fatalf(\"another environment: %+v %v\", r, err)\n\t}\n\tif r, err := client.Run(context.Background(), nil, good, 0); err != nil || r.Outcome != worktreeruntime.OutcomeRefused {\n\t\tt.Fatalf(\"no command: %+v %v\", r, err)\n\t}\n}\n\n// A command left running after its deadline still counts as work in the runtime: the status\n// shows it in flight, and a stop waits for it and reports what it abandoned.\nfunc TestACommandRunningPastItsDeadlineStillCountsAsInFlight(t *testing.T) {\n\tf := newRuntimeFixture(t)\n\tf.start(t)\n\toriginal := runtimeHostedRun.Load()\n\tslow := hostedRunFunc(func(args []string, out, errb io.Writer) int {\n\t\ttime.Sleep(700 * time.Millisecond)\n\t\treturn (*original)(args, out, errb)\n\t})\n\truntimeHostedRun.Store(&slow)\n\tdefer func() {\n\t\ttime.Sleep(900 * time.Millisecond)\n\t\truntimeHostedRun.Store(original)\n\t}()\n\tf.run(\"--timeout\", \"50ms\", \"roadmap-check\")\n\tid, err := worktreeruntime.ResolveIdentity(f.root, version.Version, runtimeBuild())\n\tif err != nil {\n\t\tt.Skip(err)\n\t}\n\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n\tstatus, err := client.Status(context.Background())\n\tif err != nil || status.InFlight < 1 {\n\t\tt.Fatalf(\"the command running past its deadline is not in flight: %+v %v\", status, err)\n\t}\n\tstopped, err := client.Stop(context.Background(), 50*time.Millisecond)\n\tif err != nil || stopped.Abandoned < 1 {\n\t\tt.Fatalf(\"a stop did not report the running command abandoned: %+v %v\", stopped, err)\n\t}\n}\n\n// A command still waiting for its turn when its deadline passes did not start: it is refused,\n// the caller runs it standalone, and the runtime never runs it later as well.\nfunc TestACommandThatNeverStartedIsRefusedAndNotRunLater(t *testing.T) {\n\tf := newRuntimeFixture(t)\n\tf.start(t)\n\toriginal := runtimeHostedRun.Load()\n\tvar ran atomic.Int64\n\tslow := hostedRunFunc(func(args []string, out, errb io.Writer) int {\n\t\tran.Add(1)\n\t\ttime.Sleep(600 * time.Millisecond)\n\t\treturn (*original)(args, out, errb)\n\t})\n\truntimeHostedRun.Store(&slow)\n\tdefer func() {\n\t\ttime.Sleep(900 * time.Millisecond)\n\t\truntimeHostedRun.Store(original)\n\t}()\n\tfirst := make(chan map[string]any, 1)\n\tgo func() { doc, _, _ := f.run(\"roadmap-check\"); first <- doc }()\n\ttime.Sleep(150 * time.Millisecond)\n\tdoc, _, _ := f.run(\"--timeout\", \"100ms\", \"roadmap-check\")\n\tif doc[\"via\"] != \"standalone\" || !strings.Contains(doc[\"fallback_reason\"].(string), \"did not start\") {\n\t\tt.Fatalf(\"a command queued past its deadline: %v\", doc)\n\t}\n\tif d := <-first; d[\"via\"] != \"runtime\" {\n\t\tt.Fatalf(\"the first command: %v\", d)\n\t}\n\ttime.Sleep(300 * time.Millisecond)\n\tif ran.Load() != 1 {\n\t\tt.Fatalf(\"the runtime ran %d commands: the refused one ran later\", ran.Load())\n\t}\n}\n","numLines":230,"startLine":1,"totalLines":230}},"tool_result_meta":[{"id":"toolu_01N465aexxrZYkoJvMrYfVk1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
