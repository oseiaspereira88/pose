{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QNQpAuxJvWjZbtHA9zqpP6","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\t\"testing\"\n8\t)\n9\t\n10\t// Spec pose-worktree-runtime-resident-cache.\n11\t\n12\t// R1: the memo is off by default, bounded in bytes, least recently used first, and keyed by the\n13\t// commit, the shallow state and the exact command.\n14\tfunc TestTheResidentGitMemoIsOffByDefaultBoundedAndKeyedByTheCommit(t *testing.T) {\n15\t\tif residentGit.Load() != nil {\n16\t\t\tt.Fatal(\"the resident memo is on without being asked\")\n17\t\t}\n18\t\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\"})\n19\t\tm := EnableResidentGitMemo(400)\n20\t\tdefer DisableResidentGitMemo()\n21\t\targs := []string{\"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\"}\n22\t\tk1, ok := residentGitKey(root, \"head1\", args)\n23\t\tif !ok {\n24\t\t\tt.Fatal(\"a plain .git directory is not memoizable\")\n25\t\t}\n26\t\tk2, _ := residentGitKey(root, \"head2\", args)\n27\t\tif k1 == k2 {\n28\t\t\tt.Fatal(\"two commits share a key\")\n29\t\t}\n30\t\tif err := os.WriteFile(filepath.Join(root, \".git\", \"shallow\"), []byte(\"x\\n\"), 0o644); err != nil {\n31\t\t\tt.Fatal(err)\n32\t\t}\n33\t\tif k3, _ := residentGitKey(root, \"head1\", args); k3 == k1 {\n34\t\t\tt.Fatal(\"a shallow repository shares the key of a full one\")\n35\t\t}\n36\t\tm.put(\"a\", []byte(strings.Repeat(\"x\", 150)))\n37\t\tm.put(\"b\", []byte(strings.Repeat(\"y\", 150)))\n38\t\tif _, hit := m.get(\"a\"); !hit {\n39\t\t\tt.Fatal(\"a fresh entry missed\")\n40\t\t}\n41\t\tm.put(\"c\", []byte(strings.Repeat(\"z\", 150))) // evicts b, the least recently used\n42\t\tif _, hit := m.get(\"b\"); hit {\n43\t\t\tt.Fatal(\"the least recently used entry was kept over the budget\")\n44\t\t}\n45\t\tif _, hit := m.get(\"a\"); !hit {\n46\t\t\tt.Fatal(\"the recently used entry was evicted\")\n47\t\t}\n48\t\tif _, _, _, bytes := ResidentGitMemoStats(); bytes > 400 {\n49\t\t\tt.Fatalf(\"the memo retains %d bytes over its budget of 400\", bytes)\n50\t\t}\n51\t\tm.put(\"huge\", []byte(strings.Repeat(\"h\", 1000)))\n52\t\tif _, hit := m.get(\"huge\"); hit {\n53\t\t\tt.Fatal(\"an entry larger than the budget was retained\")\n54\t\t}\n55\t\t// A linked worktree (.git is a file) is not memoized.\n56\t\tlinked := t.TempDir()\n57\t\tif err := os.WriteFile(filepath.Join(linked, \".git\"), []byte(\"gitdir: elsewhere\\n\"), 0o644); err != nil {\n58\t\t\tt.Fatal(err)\n59\t\t}\n60\t\tif _, ok := residentGitKey(linked, \"h\", args); ok {\n61\t\t\tt.Fatal(\"a linked worktree was memoized\")\n62\t\t}\n63\t}\n64\t\n65\t// R2: a second operation of a process with the memo on is answered from it, with the answer\n66\t// Git gives, and a new commit is a miss; the answers equal those of a process without it.\n67\tfunc TestASecondOperationIsAnsweredFromTheMemoAndANewCommitMissesIt(t *testing.T) {\n68\t\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\", \"b.md\": \"two\\n\"})\n69\t\tcapture := func() string {\n70\t\t\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n71\t\t\tstore := base.withGovernanceReadView(view, \"memo-test\")\n72\t\t\tout, err := captureGovernanceGit(store.fsys(), root, \"memo-test\", \"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\")\n73\t\t\tif err != nil {\n74\t\t\t\tt.Fatal(err)\n75\t\t\t}\n76\t\t\tif audit := view.audit(); len(audit.ChangedPaths) != 0 || audit.ChangedProducers[\"memo-test\"] {\n77\t\t\t\tt.Fatalf(\"a memoized read made the audit report a change: %+v\", audit)\n78\t\t\t}\n79\t\t\treturn strings.TrimSpace(string(out))\n80\t\t}\n81\t\twithout := capture()\n82\t\tEnableResidentGitMemo(1 << 20)\n83\t\tdefer DisableResidentGitMemo()\n84\t\tfirst, second := capture(), capture()\n85\t\tif first != without || second != without {\n86\t\t\tt.Fatalf(\"answers differ: without=%s first=%s second=%s\", without, first, second)\n87\t\t}\n88\t\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 1 {\n89\t\t\tt.Fatalf(\"hits %d misses %d, want 1 and 1\", hits, misses)\n90\t\t}\n91\t\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"one changed\\n\"), 0o644); err != nil {\n92\t\t\tt.Fatal(err)\n93\t\t}\n94\t\tsnapshotTestGit(t, root, \"add\", \"a.md\")\n95\t\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-m\", \"change a\")\n96\t\tthird := capture()\n97\t\tif third == without {\n98\t\t\tt.Fatalf(\"a new commit that changed the path returned the memoized commit %s\", third)\n99\t\t}\n100\t\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 2 {\n101\t\t\tt.Fatalf(\"after the new commit hits %d misses %d, want 1 and 2\", hits, misses)\n102\t\t}\n103\t}\n104\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"ccd9bdf0-24f0-4e7f-b616-406aefc061f3","timestamp":"2026-11-10T07:58:42.491Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2694577954/worktree/pose-mcp/internal/pose/resident_git_memo_test.go","content":"package pose\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// Spec pose-worktree-runtime-resident-cache.\n\n// R1: the memo is off by default, bounded in bytes, least recently used first, and keyed by the\n// commit, the shallow state and the exact command.\nfunc TestTheResidentGitMemoIsOffByDefaultBoundedAndKeyedByTheCommit(t *testing.T) {\n\tif residentGit.Load() != nil {\n\t\tt.Fatal(\"the resident memo is on without being asked\")\n\t}\n\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\"})\n\tm := EnableResidentGitMemo(400)\n\tdefer DisableResidentGitMemo()\n\targs := []string{\"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\"}\n\tk1, ok := residentGitKey(root, \"head1\", args)\n\tif !ok {\n\t\tt.Fatal(\"a plain .git directory is not memoizable\")\n\t}\n\tk2, _ := residentGitKey(root, \"head2\", args)\n\tif k1 == k2 {\n\t\tt.Fatal(\"two commits share a key\")\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \".git\", \"shallow\"), []byte(\"x\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif k3, _ := residentGitKey(root, \"head1\", args); k3 == k1 {\n\t\tt.Fatal(\"a shallow repository shares the key of a full one\")\n\t}\n\tm.put(\"a\", []byte(strings.Repeat(\"x\", 150)))\n\tm.put(\"b\", []byte(strings.Repeat(\"y\", 150)))\n\tif _, hit := m.get(\"a\"); !hit {\n\t\tt.Fatal(\"a fresh entry missed\")\n\t}\n\tm.put(\"c\", []byte(strings.Repeat(\"z\", 150))) // evicts b, the least recently used\n\tif _, hit := m.get(\"b\"); hit {\n\t\tt.Fatal(\"the least recently used entry was kept over the budget\")\n\t}\n\tif _, hit := m.get(\"a\"); !hit {\n\t\tt.Fatal(\"the recently used entry was evicted\")\n\t}\n\tif _, _, _, bytes := ResidentGitMemoStats(); bytes > 400 {\n\t\tt.Fatalf(\"the memo retains %d bytes over its budget of 400\", bytes)\n\t}\n\tm.put(\"huge\", []byte(strings.Repeat(\"h\", 1000)))\n\tif _, hit := m.get(\"huge\"); hit {\n\t\tt.Fatal(\"an entry larger than the budget was retained\")\n\t}\n\t// A linked worktree (.git is a file) is not memoized.\n\tlinked := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(linked, \".git\"), []byte(\"gitdir: elsewhere\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, ok := residentGitKey(linked, \"h\", args); ok {\n\t\tt.Fatal(\"a linked worktree was memoized\")\n\t}\n}\n\n// R2: a second operation of a process with the memo on is answered from it, with the answer\n// Git gives, and a new commit is a miss; the answers equal those of a process without it.\nfunc TestASecondOperationIsAnsweredFromTheMemoAndANewCommitMissesIt(t *testing.T) {\n\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\", \"b.md\": \"two\\n\"})\n\tcapture := func() string {\n\t\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\t\tstore := base.withGovernanceReadView(view, \"memo-test\")\n\t\tout, err := captureGovernanceGit(store.fsys(), root, \"memo-test\", \"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\")\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif audit := view.audit(); len(audit.ChangedPaths) != 0 || audit.ChangedProducers[\"memo-test\"] {\n\t\t\tt.Fatalf(\"a memoized read made the audit report a change: %+v\", audit)\n\t\t}\n\t\treturn strings.TrimSpace(string(out))\n\t}\n\twithout := capture()\n\tEnableResidentGitMemo(1 << 20)\n\tdefer DisableResidentGitMemo()\n\tfirst, second := capture(), capture()\n\tif first != without || second != without {\n\t\tt.Fatalf(\"answers differ: without=%s first=%s second=%s\", without, first, second)\n\t}\n\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 1 {\n\t\tt.Fatalf(\"hits %d misses %d, want 1 and 1\", hits, misses)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"one changed\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsnapshotTestGit(t, root, \"add\", \"a.md\")\n\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-m\", \"change a\")\n\tthird := capture()\n\tif third == without {\n\t\tt.Fatalf(\"a new commit that changed the path returned the memoized commit %s\", third)\n\t}\n\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 2 {\n\t\tt.Fatalf(\"after the new commit hits %d misses %d, want 1 and 2\", hits, misses)\n\t}\n}\n","numLines":104,"startLine":1,"totalLines":104}},"tool_result_meta":[{"id":"toolu_01QNQpAuxJvWjZbtHA9zqpP6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
