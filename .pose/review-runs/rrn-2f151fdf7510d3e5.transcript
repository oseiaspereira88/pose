{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UJTvbWFAcwWgW511S87B8K","type":"tool_result","content":"585\tfunc runGovernanceGitCommandOutputAdmitted(files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n586\t\treturn runGovernanceGitCommandOutputAdmittedContext(context.Background(), files, root, args, limit, admit)\n587\t}\n588\t\n589\t// runGovernanceGitCommandOutputAdmittedContext admits each stream chunk before\n590\t// the bounded output buffer retains it and executes Git under ctx.\n591\tfunc runGovernanceGitCommandOutputAdmittedContext(ctx context.Context, files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n592\t\tif limit < 0 {\n593\t\t\treturn nil, nil, errGovernanceReadViewBudget\n594\t\t}\n595\t\tfiles = FilesOrNative(files)\n596\t\tif ctx == nil {\n597\t\t\tctx = context.Background()\n598\t\t}\n599\t\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n600\t\tcmd.WaitDelay = 2 * time.Second\n601\t\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n602\t\toutput := &boundedGovernanceGitOutput{limit: limit, admit: admit}\n603\t\tcmd.Stdout = governanceGitStream{output: output, stderr: false}\n604\t\tcmd.Stderr = governanceGitStream{output: output, stderr: true}\n605\t\terr := cmd.Run()\n606\t\tstdout, stderr, exceeded := output.values()\n607\t\tif exceeded {\n608\t\t\treturn nil, nil, errGovernanceReadViewBudget\n609\t\t}\n610\t\tif err != nil {\n611\t\t\tif exit, ok := err.(*exec.ExitError); ok {\n612\t\t\t\texit.Stderr = append([]byte(nil), stderr...)\n613\t\t\t}\n614\t\t\treturn stdout, stderr, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n615\t\t}\n616\t\tif len(stderr) > 0 {\n617\t\t\tdetail := strings.TrimSpace(string(stderr))\n618\t\t\tif detail == \"\" {\n619\t\t\t\tdetail = \"Git wrote unclassified stderr output\"\n620\t\t\t}\n621\t\t\treturn 