{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'ValidateRoundDraft|reviewDecisionApproves|completeReviewAttestation|attestationContentBlockers' pose-mcp/internal/pose/review*; cat pose-mcp/internal/pose/review_structure_test.go | tail -85; rg -n 'reviewDesignBasisNamespace|type reviewBasis|Reaches|Known' pose-mcp/internal/pose/review_structure.go; cat pose-mcp/internal/cli/testdata/adversarial/README.md | tail -85; rg -n 'readiness|draft.check|undeclared.delivery' .pose/knowledge\"","aggregated_output":"pose-mcp/internal/pose/review_bundle.go:2993:\tatt, err = completeReviewAttestation(bundle, att, now)\npose-mcp/internal/pose/review_bundle.go:3032:// completeReviewAttestation fills and checks what recording sets: the bundle\npose-mcp/internal/pose/review_bundle.go:3036:func completeReviewAttestation(bundle ReviewBundle, att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\npose-mcp/internal/pose/review_bundle.go:3096:\tcompleted, err := completeReviewAttestation(bundle, att, now)\npose-mcp/internal/pose/review_bundle.go:3144:func reviewDecisionApproves(decision string) bool {\npose-mcp/internal/pose/review_bundle.go:3159:\tif !reviewDecisionApproves(att.Decision) {\npose-mcp/internal/pose/review_bundle.go:3182:\tif !reviewDecisionApproves(att.Decision) {\npose-mcp/internal/pose/review_bundle.go:3190:\tcompleted, err := completeReviewAttestation(bundle, att, now)\npose-mcp/internal/pose/review_bundle.go:3897:\treturn append(blockers, s.attestationContentBlockers(bundle, att, skipEvidenceSupport)...)\npose-mcp/internal/pose/review_bundle.go:3900:// attestationContentBlockers judges what an attestation says about its bundle,\npose-mcp/internal/pose/review_bundle.go:3904:func (s Store) attestationContentBlockers(bundle ReviewBundle, att ReviewAttestation, skipEvidenceSupport bool) []string {\npose-mcp/internal/pose/review_run_provenance.go:730:\t\tif problems := ValidateRoundDraft(round, run.Output); len(problems) > 0 {\npose-mcp/internal/pose/review_write_scope.go:116:\tif reviewDecisionApproves(att.Decision) {\npose-mcp/internal/pose/review_write_scope.go:148:\t\tif reviewDecisionApproves(att.Decision) {\npose-mcp/internal/pose/review_rounds_test.go:90:func TestValidateRoundDraftRequiresAnAccount(t *testing.T) {\npose-mcp/internal/pose/review_rounds_test.go:93:\tif problems := ValidateRoundDraft(round, valid); len(problems) != 0 {\npose-mcp/internal/pose/review_rounds_test.go:102:\t\tif problems := ValidateRoundDraft(round, out); len(problems) == 0 {\npose-mcp/internal/pose/review_rounds_test.go:106:\tif problems := ValidateRoundDraft(ReviewRound{Number: 1}, \"decision: approved\\n\"); len(problems) != 0 {\npose-mcp/internal/pose/review_rounds_test.go:132:\tif problems := ValidateRoundDraft(third, draftOutput(\"approved\", `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"approved\",\"findings\":[],\"sweep\":\"all\"}`)); len(problems) == 0 {\npose-mcp/internal/pose/review_rounds_test.go:219:\tif problems := ValidateRoundDraft(round, invented); len(problems) != 1 || !strings.Contains(problems[0], \"R1-INVENTED\") {\npose-mcp/internal/pose/review_brief_preflight_tie_test.go:22:\t\"review_bundle.go\":   {\"validateBundleAttestationWith\", \"attestationContentBlockers\", \"reviewCriterionEvidenceBlockers\"},\npose-mcp/internal/pose/review_rounds.go:527:// ValidateRoundDraft judges a draft of round against R3 and R4: from round 2\npose-mcp/internal/pose/review_rounds.go:530:func ValidateRoundDraft(round ReviewRound, output string) []string {\npose-mcp/internal/pose/review_approval_follows_children_test.go:359:\tattestation, err := completeReviewAttestation(bundle, attestation, at)\npose-mcp/internal/pose/review_draft_check.go:98:\t\tif problems := ValidateRoundDraft(round, output); len(problems) > 0 {\npose-mcp/internal/pose/review_draft_check.go:102:\tif draft != nil && reviewDecisionApproves(draft.Decision) {\npose-mcp/internal/pose/review_draft_check.go:106:\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\npose-mcp/internal/pose/review_draft_check.go:109:\t\t} else if blockers := s.attestationContentBlockers(bundle, completed, false); len(blockers) > 0 {\npose-mcp/internal/pose/review_closeout.go:1223:\t\taApproves, bApproves := reviewDecisionApproves(a.Decision), reviewDecisionApproves(b.Decision)\npose-mcp/internal/pose/review_domain_preflight_helpers_test.go:109:\tcompleted, err := completeReviewAttestation(bundle, att, now)\npose-mcp/internal/pose/review_bundle_test.go:421:\tcandidate, err := completeReviewAttestation(bundle, att, now.Add(time.Minute))\npose-mcp/internal/pose/review_dispatch.go:1167:\t\trun.Round, run.DraftProblems = round.Number, ValidateRoundDraft(round, run.Output)\n\t\t\t}, \"\"); len(blockers) != 0 {\n\t\t\t\tt.Fatalf(\"%s with a rationale was refused: %+v\", state, blockers)\n\t\t\t}\n\t\t\tassertBlocker(t, causalityBlockers(t, store, []ReviewCriterionMapping{\n\t\t\t\t{Delta: \"SD-aaaa1111\", Disposition: state},\n\t\t\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n\t\t\t}, \"\"), \"disposes SD-aaaa1111 as \"+state+\" with no rationale\")\n\t\t\tassertBlocker(t, causalityBlockers(t, store, []ReviewCriterionMapping{\n\t\t\t\t{Delta: \"SD-aaaa1111\", Disposition: state, Rationale: \"stated reason\", Basis: \"R1\"},\n\t\t\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n\t\t\t}, \"\"), \"and still names basis R1; state one or the other\")\n\t\t})\n\t}\n\tassertBlocker(t, causalityBlockers(t, store, []ReviewCriterionMapping{\n\t\t{Delta: \"SD-aaaa1111\", Disposition: \"handled\"},\n\t\t{Delta: \"SD-bbbb2222\", Basis: \"R1\"},\n\t}, \"\"), `as \"handled\", which is not mapped, missing-evidence, not-applicable or accepted-risk`)\n}\n\n// Opt-in in both directions: no material fact, or no criterion that answers for\n// structure, and the gate asks for nothing.\nfunc TestABMStructuralCausalityIsOptInBothWays(t *testing.T) {\n\tstore := causalityFixture(t)\n\t_, required := causalityInputs()\n\tdispositions := []ReviewCriterion{{ID: \"design-causality\", Disposition: \"passed\", Rationale: \"examined\"}}\n\tif blockers := store.reviewStructuralCausalityBlockers(\"spec:backend\", nil, required, dispositions); len(blockers) != 0 {\n\t\tt.Fatalf(\"no observation still owed a mapping: %+v\", blockers)\n\t}\n\tempty := &ReviewPlanStructure{Observed: true, Status: \"observed\"}\n\tif blockers := store.reviewStructuralCausalityBlockers(\"spec:backend\", empty, required, dispositions); len(blockers) != 0 {\n\t\tt.Fatalf(\"an empty material set owed a mapping: %+v\", blockers)\n\t}\n\tstructure, _ := causalityInputs()\n\tunflagged := map[string]ReviewPlanCriterion{\"design-causality\": {ID: \"design-causality\", Required: true, Kind: ReviewCriterionKindJudgment}}\n\tif blockers := store.reviewStructuralCausalityBlockers(\"spec:backend\", structure, unflagged, dispositions); len(blockers) != 0 {\n\t\tt.Fatalf(\"a criterion that never claimed the obligation owed a mapping: %+v\", blockers)\n\t}\n}\n\n// A bundle sealed before the contract existed is never held to it.\nfunc TestABMStructuralCausalityGovernsOnlySealedContracts(t *testing.T) {\n\tstore := causalityFixture(t)\n\tstructure, required := causalityInputs()\n\tplanned := []ReviewPlanCriterion{}\n\tfor _, criterion := range required {\n\t\tplanned = append(planned, criterion)\n\t}\n\tbundle := ReviewBundle{Payload: ReviewBundlePayload{\n\t\tScope: ReviewBundleScope{Ref: \"spec:backend\"},\n\t\tPlan:  ReviewBundlePlan{Criteria: planned, Structure: structure},\n\t}}\n\tatt := ReviewAttestation{Criteria: []ReviewCriterion{{ID: \"design-causality\", Disposition: \"passed\", Rationale: \"examined\"}}}\n\tif governed, _ := BundleGovernedBy(bundle, \"structural-causality\"); governed {\n\t\tt.Fatal(\"a bundle with no governing contracts was reported governed\")\n\t}\n\tbundle.Payload.GoverningContracts = governingContractsAtSeal()\n\tgoverned, _ := BundleGovernedBy(bundle, \"structural-causality\")\n\tif !governed {\n\t\tt.Fatal(\"a bundle sealed by this engine does not list the contract\")\n\t}\n\tif blockers := store.reviewStructuralCausalityBlockers(bundle.Payload.Scope.Ref, bundle.Payload.Plan.Structure, required, att.Criteria); len(blockers) == 0 {\n\t\tt.Fatal(\"an unmapped judgment passed under the contract\")\n\t}\n}\n\n// Spec pose-review-readiness-before-seal R2: when the plan asks for\n// structural mappings, a decision basis that reaches no requirement is\n// refused at seal; the same scope without structural facts seals.\nfunc TestSealReadinessRefusesADecisionWithoutBasis(t *testing.T) {\n\tstore := causalityFixture(t)\n\tstructure, _ := causalityInputs()\n\tvar bundle ReviewBundle\n\tbundle.Payload.Scope.Ref = \"spec:backend\"\n\tbundle.Payload.Plan.Structure = structure\n\tblockers := store.sealReadinessBlockers(bundle)\n\tassertBlocker(t, blockers, \"decision basis D9 reaches no requirement or constraint\")\n\tassertBlocker(t, blockers, \"decision basis A9 reaches no requirement or constraint\")\n\tif strings.Contains(strings.Join(blockers, \"\\n\"), \"basis D1 \") || strings.Contains(strings.Join(blockers, \"\\n\"), \"basis A1 \") {\n\t\tt.Fatalf(\"a basis that reaches a requirement was refused: %v\", blockers)\n\t}\n\tbundle.Payload.Plan.Structure = nil\n\tif blockers := store.sealReadinessBlockers(bundle); len(blockers) != 0 {\n\t\tt.Fatalf(\"a plan without structural facts was refused: %v\", blockers)\n\t}\n}\n178:// reviewDesignBasisNamespace resolves what a mapping may point at, from the\n182:type reviewDesignBasisNamespace struct {\n184:\tReaches      map[string]bool\n185:\tKnown        map[string]bool\n189:func (s Store) reviewDesignBasisNamespace(scope ScopeRef) reviewDesignBasisNamespace {\n190:\tns := reviewDesignBasisNamespace{Requirements: map[string]bool{}, Reaches: map[string]bool{}, Known: map[string]bool{}}\n198:\t\t\tns.Requirements[id], ns.Known[id], ns.Reaches[id] = true, true, true\n201:\t\t\tns.Requirements[id], ns.Known[id], ns.Reaches[id] = true, true, true\n208:\t\tassumptionReaches := map[string]bool{}\n210:\t\t\tns.Known[assumption.ID] = true\n213:\t\t\t\t\tassumptionReaches[assumption.ID] = true\n216:\t\t\tif assumptionReaches[assumption.ID] {\n217:\t\t\t\tns.Reaches[assumption.ID] = true\n221:\t\t\tns.Known[decision.ID] = true\n227:\t\t\t\tif assumptionReaches[basis] || ns.Requirements[basis] {\n228:\t\t\t\t\tns.Reaches[decision.ID] = true\n255:\tnamespace := s.reviewDesignBasisNamespace(scope)\n305:\t\t\t\tcase !namespace.Known[basis]:\n307:\t\t\t\tcase !namespace.Reaches[basis]:\n# Adversarial corpus\n\nSpec: `pose-mechanization-adversarial-corpus`. Test: `adversarial_corpus_test.go`.\n\nEvery gate POSE adds against mechanical compliance can itself be satisfied\nmechanically. Each row is the cheapest formal satisfaction of one gate. An\n`enforced` case fails the build when the shortcut works again; a `known-gap`\ncase fails the build when the gap closes, so it cannot close or reopen\nsilently; a `planned` case belongs to a spec not yet delivered and gains code\nbefore that spec closes; a `delegated` case is enforced by a test in another\npackage, named in the row, whose existence the corpus checks.\n\nThis corpus belongs to developing POSE's governance. It adds no checklist to an\nadopting project's features.\n\n| Case | Status | Shortcut it refuses | Owner |\n|---|---|---|---|\n| `human-label-without-confirmation` | enforced | An agent writes and applies a review under `human:<name>`; the record reads as a human review | pose-review-attribution-roles |\n| `declared-independent-prefix` | enforced | `agent:independent-*` under declared assurance reads as authenticated separation | pose-review-assurance-disclosure |\n| `confirmation-reused-for-edited-content` | enforced | A confirmation recorded for one set of conclusions is kept after they change | pose-review-attribution-roles |\n| `unknown-recorded-as-satisfied` | enforced | An obligation the engine could not observe is reported as satisfied | pose-obligation-contract |\n| `legacy-blocker-gains-an-actor` | enforced | A blocker known only as text is given an invented recipient | pose-obligation-contract |\n| `blocked-counted-as-resolved` | enforced | Operational waiting counts as a resolved outcome in success metrics | pose-blocked-semantics-alignment |\n| `flat-specs-share-one-journal` | enforced | Two flat specs record amendments in one shared journal | pose-flat-spec-amendments |\n| `local-metadata-read-as-published` | enforced | A locally read version is presented as a proven publication | pose-public-claims-publication-provenance |\n| `invented-trace-test-ref` | known-gap | A requirement trace cites a test that does not exist and `lint-spec --strict` passes (follow-up 097 of pose-abm-design-basis) | pose-mechanization-adversarial-corpus |\n| `unavailable-producer-reads-as-empty` | enforced | A producer fails and Attention reports zero obligations as a complete answer | pose-obligation-projection |\n| `trivial-change-raises-a-request` | enforced | A trivial change or an already-authorized instruction produces an ActionRequest | pose-action-requests |\n| `declined-approval-satisfies` | enforced | A declined approval, or a cancellation without authority, releases a gate | pose-action-request-resolution |\n| `closeout-plan-fills-judgment` | enforced | The recoverable closeout plan answers a judgment criterion to finish | pose-recoverable-closeout-plan |\n| `ready-from-absent-blockers` | enforced | Absence of a known blocker is presented as proven independence | pose-phase-scoped-readiness |\n| `stale-preview-authorizes-apply` | enforced | A start previewed before a restricting request is applied after it | pose-governed-effect-enforcement |\n| `code-change-keeps-judgment` | enforced | The reviewed code changes and every criterion still reads as equivalent, so the old judgment is reused | pose-material-equivalence-reuse |\n| `minimal-surface-skips-trace` | enforced | A done spec declares the minimal surface to drop its requirement trace | pose-progressive-spec-surface |\n| `stale-assessment-reused` | enforced | The assessed component changes and the old assessment still reads as fresh | pose-adaptive-assessment-freshness |\n| `unpinned-premise-trigger-reads-current` | enforced | A premise trigger without a pin can never go stale and nothing says so | pose-assumption-validity-scope |\n| `calendar-ttl-as-premise-trigger` | enforced | An arbitrary expiry date is accepted as the material trigger of a premise | pose-assumption-validity-scope |\n| `unobserved-falsifier-reads-uncontradicted` | enforced | An unbound legacy index cannot prove that a falsifier check was never observed | pose-falsifier-reconsideration |\n| `parity-row-cites-an-unrelated-test` | known-gap | A launcher parity row names a real but unrelated `pose delegate` command and an existing test that does not exercise the capability, and the parity check passes; the check proves existence, review of the cited tests proves coverage | pose-delegation-parity-gate |\n| `imported-fragment-completes-a-replaced-command` | known-gap | A usage or error string assembles a removed command from a constant of another package of the module, which the active-document check reads as a gap; review of assembled messages is the defence | pose-delegation-parity-gate |\n| `cgo-preamble-text-reaches-usage` | known-gap | Operator text written as a C string in a cgo preamble reaches a usage surface; the Go reader sees a comment, not a string | pose-delegation-parity-gate |\n| `later-removal-hides-a-later-touch` | delegated | A later removal satisfies an earlier spec's claim because the history it is judged on omits that spec's change after the removal — change sets in ID order, a merge, root or type-change touch, a failed or shallow read, a recorded report too wide to read whole or a history directory that cannot be listed, a replace ref or graft (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_gaps_test.go:TestLaterRemovalReviewRoundTwo`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundFive`) | pose-delivery-later-removal |\n| `rename-read-as-removal` | delegated | A rename, or a path spelled as a pathspec, is taken for the declared deletion (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`) | pose-delivery-later-removal |\n| `recorded-commit-is-an-option` | delegated | A change set read from a recorded report names a Git option or a tag where a commit belongs (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`) | pose-delivery-later-removal |\n| `peer-removal-stands-for-a-member` | delegated | A review subject digests a removed path from a peer's accepted removal while another observing member — sorted later, sharing a commit, or reduced into the peer's set — has none, whatever action or rename it observed the path with (`pose/review_subject_later_removal_test.go:TestReviewSubjectReadsALaterRemovalFromItsWitness`, `pose/review_subject_later_removal_test.go:TestMilestoneSubjectRemovalHoldsForEveryMember`) | pose-review-subject-later-removal |\n| `retained-child-skips-its-verification` | delegated | A milestone seals over a done member whose own review verification no longer retains its approval — revoked federated trust, lost history, a later negative review (`pose/review_subject_later_removal_test.go:TestRetainedChildFollowsItsVerification`, `pose/review_subject_later_removal_test.go:TestMilestoneSealRetainsADoneChildsApprovedReview`) | pose-review-subject-later-removal |\n| `run-pattern-names-no-test` | delegated | A validation check's `-run` alternative names a test that no longer exists, or never did, and the check passes on Go's exit 0 — through `-run=`, a build-excluded or ignored file, a vendored or nested-module declaration, a benchmark or a name Go does not run (`cli/validation_matrix_patterns_test.go:TestDeadRunPatternGuardFollowsGoSelection`, `cli/validation_matrix_patterns_test.go:TestValidationMatrixRunPatternsNameExistingTests`); a non-plain pattern passes only when listed with its reason | pose-validation-matrix-dead-test-patterns |\n| `removal-witness-outlives-its-history` | delegated | A stale index keeps counting a removal after a later touch, through a merge, a rewritten history or a shallow clone that lost the touch (`pose/removal_witness_freshness_test.go:TestLaterTouchRefusesTheWitness`, `pose/removal_witness_freshness_test.go:TestShallowHistoryRefusesTheWitness`) | pose-removal-witness-freshness |\n| `parent-outlives-a-rejected-child` | delegated | A milestone or roadmap stays approved over a child's later rejection, through retention, a sealed cycle, a replaced approval or a forged `replaces` (`pose/review_approval_follows_children_test.go:TestParentApprovalFollowsAChildsRejection`, `pose/review_approval_follows_children_test.go:TestChildCycleEndsInARefusal`, `pose/review_approval_follows_children_test.go:TestForgedReplacementRetiresNothing`, `pose/review_approval_follows_children_test.go:TestLegacyCoordinatedMatchingFollowsLineage`) | pose-review-approval-follows-children |\n| `go-check-ran-no-test` | delegated | A `go test` check selects nothing and passes on Go's exit 0, through a flag spelling, a flag's value read as a flag, or a package without test files (`cli/validate_empty_go_checks_test.go:TestValidateRefusesAGoCheckThatRanNoTest`, `cli/validate_empty_go_checks_test.go:TestGoTestSelection`); a check outside the plain grammar passes unjudged, and a test printing a result line can still mislead it | pose-validate-refuses-empty-go-checks |\n| `request-opened-after-preview-transfers` | delegated | A request opened after a transfer preview is moved with the spec (`pose/spec_transfer_actions_test.go:TestTransferRefusesARequestOpenedAfterThePreview`) | pose-transfer-preserves-obligations |\n\n| `deleted-reservation-resets-quota` | delegated | Deleting a reservation and receipt makes a surviving run stop consuming quota | pose-delegated-review-attempt-ledger |\n| `witness-bundle-filter-hides-loss` | delegated | Editing a witness bundle makes scoped readers skip its corruption | pose-delegated-review-attempt-ledger |\n| `window-erases-rerun` | delegated | Moving a prior run outside the time window turns a rerun into a first attempt | pose-delegated-review-attempt-ledger |\n| `canned-executor-approval-proves-cognition` | delegated | A complete canned approval from a trusted local command is presented as proof of review cognition or a vendor receipt (`cli/delegated_review_capability_test.go:TestDelegatedReviewCapabilityCannedApprovalDisclosesItsLimits` guards disclosure; the engine cannot detect canned judgments) | pose-delegated-review-capability |\n| `oversized-writer-publishes-unreadable-run` | delegated | A writer reports completion for a run its bounded reader immediately refuses | pose-delegated-review-attempt-ledger |\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:66:byte-a-byte, avisos, readiness, rollback via git puro). `examples/`\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:3:slug: agency-readiness-outcome-review\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:10:  spec: \"spec:pose-agency-readiness-pilot\"\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:12:  commands: [\"pose review verify roadmap:agency-readiness\", \"pose knowledge-check --strict\"]\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:16:# Handoff: agency-readiness outcome review\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:20:Independent outcome review of roadmap:agency-readiness at d72b6abb, bundle\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:29:go vet passes. Registered phase-readiness, source-coverage, effective-governance,\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:49:- Verify roadmap:agency-readiness after recording the explicit attestation.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:68:- Roadmap: `.pose/roadmaps/agency-readiness.md`.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:69:- Pilot: `.pose/specs/2026-10-04-pose-agency-readiness-pilot.md`.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:71:- Full report: `/tmp/pose-roadmaps-evidence/reached/rm-agency-readiness/attest-report.md`.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:72:- Fresh argv/results: `/var/tmp/pose-work-go/review-reached/rm-agency-readiness/attest/round3/`.\n.pose/knowledge/2026-10-18-handoff-pose-b06-source-coverage-closeout.md:33:Aguardar merge do PR #194 pelo maintainer e reavaliar DAG/readiness. Nenhuma\n.pose/knowledge/2026-10-18-handoff-pose-b06-source-coverage-closeout.md:47:@pose-maintainers coordena merge e readiness; @core responde pelos dois follow-ups.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '3015,3220p' pose-mcp/internal/pose/review_bundle.go; rg -n 'preflight|Preflight|Approve|approv|ParseReviewDraft|ValidateRoundDraft' pose-mcp/internal/pose/review_conclusion*.go; sed -n '3900,4140p' pose-mcp/internal/pose/review_bundle.go; rg -n 'SealedCheckout|json-out|WriteFile|Write' pose-mcp/internal/cli/validate.go; rg -n 'StructuralMapping|Mapping|Structure' pose-mcp/internal/pose/review_structure.go | head -35; env | rg '\"'^POSE_(REVIEW_DRAFT_CONTEXT|SEALED)'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '3015,3220p' pose-mcp/internal/pose/review_bundle.go; rg -n 'preflight|Preflight|Approve|approv|ParseReviewDraft|ValidateRoundDraft' pose-mcp/internal/pose/review_conclusion*.go; sed -n '3900,4140p' pose-mcp/internal/pose/review_bundle.go; rg -n 'SealedCheckout|json-out|WriteFile|Write' pose-mcp/internal/cli/validate.go; rg -n 'StructuralMapping|Mapping|Structure' pose-mcp/internal/pose/review_structure.go | head -35; env | rg '\"'^POSE_(REVIEW_DRAFT_CONTEXT|SEALED)'\"'\"","aggregated_output":"\t\t}\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation identity collision for %s\", att.AttestationID)\n\t}\n\traw, err := json.MarshalIndent(att, \"\", \"  \")\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tif err := writeImmutableJSONIn(s.fsys(), path, append(raw, '\\n')); err != nil {\n\t\tvar durability *PublishDurabilityError\n\t\tif errors.As(err, &durability) {\n\t\t\treturn att, err\n\t\t}\n\t\treturn ReviewAttestation{}, err\n\t}\n\treturn att, nil\n}\n\n// completeReviewAttestation fills and checks what recording sets: the bundle\n// binding, schema, attested time and content-derived id. Recording and the MCP\n// preview share it, so an issuer that signs a previewed attestation signs the\n// bytes that will be recorded (spec pose-mcp-review-attest-signed-only).\nfunc completeReviewAttestation(bundle ReviewBundle, att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n\tif att.Limitations == nil {\n\t\tatt.Limitations = append([]string(nil), bundle.Payload.Plan.Limitations...)\n\t}\n\tif strings.Join(att.Limitations, \"\\x00\") != strings.Join(bundle.Payload.Plan.Limitations, \"\\x00\") {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation must retain the sealed review limitations\")\n\t}\n\tif att.BundleDigest == \"\" {\n\t\tatt.BundleDigest = bundle.BundleDigest\n\t}\n\tif att.BundleDigest != bundle.BundleDigest {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation bundle digest mismatch\")\n\t}\n\tif att.Reviewer == \"\" || strings.ContainsAny(att.Reviewer, \"\\r\\n\") || (!strings.HasPrefix(att.Reviewer, \"agent:\") && !strings.HasPrefix(att.Reviewer, \"human:\")) {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid reviewer execution identity\")\n\t}\n\tif att.Decision != \"approved\" && att.Decision != \"approved-with-reservations\" && att.Decision != \"changes-requested\" && att.Decision != \"rejected\" {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid review decision %q\", att.Decision)\n\t}\n\tif err := ValidateReviewAttribution(att); err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tatt.SchemaVersion = ReviewBundleSchemaVersion\n\tif att.AttestedAt == \"\" {\n\t\tatt.AttestedAt = now.UTC().Truncate(time.Second).Format(time.RFC3339)\n\t} else if _, err := time.Parse(time.RFC3339, att.AttestedAt); err != nil {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attested_at must be RFC3339\")\n\t}\n\tatt.BundleID = bundle.BundleID\n\tatt.BundleDigest = bundle.BundleDigest\n\texpectedAttestationID := reviewAttestationID(att)\n\tif att.AttestationID == \"\" {\n\t\tatt.AttestationID = expectedAttestationID\n\t} else if att.AttestationID != expectedAttestationID {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation id does not match its content digest\")\n\t}\n\tif !strings.HasPrefix(att.AttestationID, \"rva-\") || len(att.AttestationID) != 20 {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid attestation id\")\n\t}\n\treturn att, nil\n}\n\n// SignableReviewAttestation completes a draft attestation for its sealed bundle\n// as recording would, including the confirmation digest when the draft names a\n// confirming principal, and returns it with the canonical bytes a trusted\n// issuer signs into a ReviewAttestationEnvelope. It records nothing.\nfunc (s Store) SignableReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, []byte, error) {\n\tbundle, err := s.LoadReviewBundle(att.BundleID)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\tif att.BundleDigest == \"\" {\n\t\tatt.BundleDigest = bundle.BundleDigest\n\t}\n\tif a := att.Attribution; a != nil && a.ConfirmedBy != \"\" && a.ConfirmationDigest == \"\" {\n\t\tbound := *a\n\t\tbound.ConfirmationDigest = ReviewConfirmationDigest(att)\n\t\tatt.Attribution = &bound\n\t}\n\tatt.Path, att.Envelope = \"\", nil\n\tcompleted, err := completeReviewAttestation(bundle, att, now)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\tcanonical, err := json.Marshal(completed)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\treturn completed, canonical, nil\n}\n\n// RecordReviewAttestationEnvelope verifies a trusted issuer's envelope and,\n// with apply, records the attestation it carries: the path both\n// `pose review attest --envelope` and the MCP tool take.\nfunc (s Store) RecordReviewAttestationEnvelope(envelope ReviewAttestationEnvelope, apply bool) (ReviewAttestation, error) {\n\tif !apply {\n\t\treturn s.VerifyReviewAttestationEnvelope(envelope)\n\t}\n\tvar result ReviewAttestation\n\terr := s.withReviewAttestationWriteGuard(\"review.attestation.envelope\", envelope.Attestation, func(guarded Store) error {\n\t\tattestation, err := guarded.VerifyReviewAttestationEnvelope(envelope)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tresult, err = guarded.recordReviewAttestation(attestation, guarded.reviewClock(), true)\n\t\treturn err\n\t})\n\treturn result, err\n}\n\n// ErrReviewApprovalRefused classifies a ReviewApprovalRefusal for errors.Is.\nvar ErrReviewApprovalRefused = errors.New(\"pose: review approval refused before persistence\")\n\n// ReviewApprovalRefusal is the typed result of the domain approval preflight:\n// every reason the verifier would reject the approval, returned before any\n// artifact of the attempt is written