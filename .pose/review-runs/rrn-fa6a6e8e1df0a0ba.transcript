undleID+\" no longer represents the current semantic inputs of \"+bundle.Payload.Scope.Ref+\"; seal the current bundle and review it\")\n\tcase current.BundleID != bundle.BundleID:\n\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" is superseded by \"+current.BundleID+\"; review the current bundle\")\n\t}\n\treturn uniqueSorted(blockers)\n}\n\n// PreflightReviewAttestation returns the reasons the domain writer would\n// refuse an approving attestation, without writing anything. It completes the\n// attestation exactly as recording would and runs the same admission, so a\n// preview and the write cannot disagree (specs\n// pose-attest-refuses-what-verify-rejects, pose-review-approval-domain-preflight).\nfunc (s Store) PreflightReviewAttestation(att ReviewAttestation, now time.Time) []string {\n\tif !reviewDecisionApproves(att.Decision) {\n\t\treturn nil\n\t}\n\tbundle, err := s.LoadReviewBundle(att.BundleID)\n\tif err != nil {\n\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n\t}\n\tatt.Path = \"\"\n\tcompleted, err := completeReviewAttestation(bundle, att, now)\n\tif err != nil {\n\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n\t}\n\treturn s.reviewApprovalAdmissionBlockers(bundle, completed, now)\n}\n\n// VerifyReviewAttestationEnvelope verifies an optional provider-neutral\n// Ed25519 envelope. Trust is pinned as <issuer>#sha256:<public-key-digest> in\n// review policy; a self-declared issuer or public key is never trusted alone.\nfunc (s Store) VerifyReviewAttestationEnvelope(envelope ReviewAttestationEnvelope) (ReviewAttestation, error) {\n\tif envelope.SchemaVersion != ReviewBundleSchemaVersion || envelope.Algorithm != \"ed25519\" {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: unsupported review attestation envelope\")\n\t}\n\tif envelope.Subject != envelope.Attestation.BundleID || envelope.Issuer == \"\" || strings.ContainsAny(envelope.Issuer, \"\\r\\n\") {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation envelope subject or issuer mismatch\")\n\t}\n\tpublicKey, err := base64.StdEncoding.DecodeString(envelope.PublicKey)\n\tif err != nil || len(publicKey) != ed25519.PublicKeySize {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid Ed25519 public key\")\n\t}\n\tsignature, err := base64.StdEncoding.DecodeString(envelope.Signature)\n\tif err != nil || len(signature) != ed25519.SignatureSize {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid Ed25519 signature\")\n\t}\n\tpolicy, _, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tpin := envelope.Issuer + \"#\" + digestBytes(publicKey)\n\ttrusted := false\npose-mcp/internal/pose/review_conclusions_test.go:57:// R1, R4: a run whose typed conclusion approves is recorded by the engine as\npose-mcp/internal/pose/review_conclusions_test.go:58:// the run-backed attestation, signed by the issuer, and verify approves the\npose-mcp/internal/pose/review_conclusions_test.go:62:\tatt := approvedBundleAttestation(f.bundle, \"agent:reviewer\")\npose-mcp/internal/pose/review_conclusions_test.go:79:\tif err != nil || !verification.Approved {\npose-mcp/internal/pose/review_conclusions_test.go:113:\tatt := approvedBundleAttestation(f.bundle, \"agent:reviewer\")\npose-mcp/internal/pose/review_conclusions_test.go:124:\tif verification, err := f.store.VerifyReviewBundle(f.bundle.Payload.Scope.Ref); err != nil || verification.Approved {\npose-mcp/internal/pose/review_conclusions_test.go:125:\t\tt.Fatalf(\"a rejected scope verified approved: %v\", err)\npose-mcp/internal/pose/review_conclusions_test.go:131:// draft did not declare are refused, and an approval verifies only as the\npose-mcp/internal/pose/review_conclusions_test.go:135:\tif err := os.WriteFile(draftPath, []byte(draftFrom(t, ReviewAttestation{Decision: \"approved\"}, nil)), 0o600); err != nil {\npose-mcp/internal/pose/review_conclusions_test.go:143:\tatt := approvedBundleAttestation(f.bundle, \"ag