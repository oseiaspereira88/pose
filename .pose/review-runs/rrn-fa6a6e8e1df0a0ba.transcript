{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/rules/backend-go.md; rg -n 'func \\\\(s Store\\\\) LoadReviewBundle' pose-mcp/internal/pose/review_bundle.go; sed -n '1,130p' pose-mcp/internal/pose/review_brief_conclusion_rules_test.go; git diff 3f63a1bb..62a4e0f2 -- pose-mcp/internal/pose/review_brief_preflight_tie_test.go pose-mcp/internal/pose/live_policy_reads_test.go; pose suggest review --path pose-mcp\"","aggregated_output":"# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n2488:func (s Store) LoadReviewBundle(id string) (ReviewBundle, error) {\npackage pose\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// Spec pose-review-brief-states-the-conclusion-rules.\n\n// R1, R2: every rule the engine enforces on a typed conclusion is stated in the brief\n// that asks for one. The table keys are the blockers the attestation preflight raises\n// (by the words that identify them) and the values are the words the brief must carry,\n// so a rule added to the preflight without a sentence in the brief fails here.\nfunc TestTheBriefStatesEveryRuleThePreflightEnforces(t *testing.T) {\n\tstore, bundle := briefFixture(t)\n\tbrief, err := store.RenderReviewBrief(bundle.BundleID, \"\", \"\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\trules := map[string][]string{\n\t\t\"is a judgment criterion passed with no conclusion\":          {\"`passed` criterion of kind judgment carries a `rationale`\"},\n\t\t\"cites evidence absent from the sealed bundle\":               {\"exactly one of the refs listed under Sealed evidence\", \"never a file and line\"},\n\t\t\"is passed with no evidence\":                                 {\"exactly one of the refs listed under Sealed evidence\"},\n\t\t\"is disposed as a finding and names none\":                    {\"disposed `finding` carries as its `evidence` the `id` of a finding\"},\n\t\t\"names finding X, which this attestation does not record\":    {\"the `id` of a finding listed in `findings`\"},\n\t\t\"passes without answering for <structural fact>\":             {\"structural fact listed above is answered by the criterion that asks for structural mapping\", \"`mappings`\"},\n\t\t\"is not-applicable while the bundle seals evidence of class\": {\"refused when the bundle seals evidence of a class the criterion asks for\"},\n\t\t\"missing criterion\":                                          {\"every required criterion and every tool above is answered\"},\n\t\t\"review tool has invalid disposition\":                        {\"`passed`, `failed`, `not-used` or `deferred`, never anything else\"},\n\t\t\"required review tool did not pass\":                          {\"a tool listed as required must be run and `passed`\"},\n\t\t\"required review tool was not used\":                          {\"`not-used` is accepted for a required tool only when the plan says no producer exists\"},\n\t\t\"recommended review tool lacks not-used rationale\":           {\"a recommended tool you did not run is `not-used` with a `rationale`\"},\n\t\t\"finding F is open\":                                          {\"a draft that approves leaves no finding open\", \"a finding without them is open and the approval is refused\"},\n\t\t\"invalid review evidence ref\":                                {\"`command:` followed by the command you ran; a bare command line is refused\"},\n\t\t\"review tool lacks a required evidence class\":                {\"when the tool lists evidence classes, a ref of one of them that the bundle sealed\"},\n\t}\n\tfor blocker, phrases := range rules {\n\t\tfor _, phrase := range phrases {\n\t\t\tif !strings.Contains(brief.Text, phrase) {\n\t\t\t\tt.Errorf(\"the brief does not state the rule behind %q (%q)\", blocker, phrase)\n\t\t\t}\n\t\t}\n\t}\n}\n\n// R3: a run briefed with review-brief/3 still renders as it did, without the rules, so its\n// digest still verifies; the current template is /6.\nfunc TestAnEarlierConclusionBriefStillRendersWithoutTheRules(t *testing.T) {\n\tstore, bundle := briefFixture(t)\n\tcurrent, err := store.RenderReviewBrief(bundle.BundleID, \"\", \"\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tearlier, err := store.renderReviewBriefAs(bundle.BundleID, ReviewBriefKindReview, \"\", reviewBriefTemplateTypedConclusion)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif current.TemplateVersion != \"review-brief/8\" || earlier.TemplateVersion != \"review-brief/3\" {\n\t\tt.Fatalf(\"templates: %s %s\", current.TemplateVersion, earlier.TemplateVersion)\n\t}\n\tif strings.Contains(earlier.Text, \"POSE checks the conclusion before it records it\") {\n\t\tt.Fatal(\"review-brief/3 changed under the runs briefed with it\")\n\t}\n\tif !strings.Contains(earlier.Text, \"the conclusion POSE records as the attestation\") || earlier.Digest == current.Digest {\n\t\tt.Fatal(\"review-brief/3 no longer asks for the conclusion, or has the digest of /4\")\n\t}\n\tif !reviewBriefAsksConclusion(\"review-brief/3\") || !reviewBriefAsksConclusion(\"review-brief/4\") || !reviewBriefAsksConclusion(\"review-brief/5\") || !reviewBriefAsksConclusion(\"review-brief/6\") || !reviewBriefAsksConclusion(\"review-brief/7\") || !reviewBriefAsksConclusion(\"review-brief/8\") || reviewBriefAsksConclusion(\"review-brief/2\") {\n\t\tt.Fatal(\"the templates that ask for a conclusion are /3 to /8\")\n\t}\n}\n\n// R4: the Claude reviewer profile allows read-only commands in the three commands it is\n// launched with, and nothing that writes.\nfunc TestTheClaudeReviewerProfileAllowsOnlyReadOnlyCommands(t *testing.T) {\n\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"..\", \".pose\", \"policy\", \"delegation.json\"))\n\tif err != nil {\n\t\tt.Skipf(\"no delegation policy at the repository root: %v\", err)\n\t}\n\tvar policy struct {\n\t\tAgents map[string]struct {\n\t\t\tCommands map[string][]string `json:\"commands\"`\n\t\t\tResume   struct {\n\t\t\t\tCommand  []string            `json:\"command\"`\n\t\t\t\tCommands map[string][]string `json:\"commands\"`\n\t\t\t} `json:\"resume\"`\n\t\t} `json:\"agents\"`\n\t}\n\tif err := json.Unmarshal(raw, &policy); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tagent, ok := policy.Agents[\"claude-opus-5-5\"]\n\tif !ok {\n\t\tt.Skip(\"no Claude reviewer profile\")\n\t}\n\tcommands := [][]string{agent.Commands[\"read\"], agent.Resume.Command, agent.Resume.Commands[\"read\"]}\n\t// An allow-list matches a prefix, so a verb that takes a flag that writes a file or runs a program\n\t// (`git log --output`, `go test -exec -c -o`, `go vet -vettool`, `pose lint-spec --json-out`) cannot be\n\t// allowed at all: only verbs without such a flag are.\n\twriters := []string{\"assess\", \"validate\", \"--seal\", \"attest\", \"record\", \"apply\", \"close \", \"start\", \"index\", \"git commit\", \"git push\", \"git add\", \"git checkout\", \"git reset\", \"go build\", \"go install\", \"go test\", \"go vet\", \"git log\", \"git diff\", \"git show\", \"lint-spec\", \"rm \", \"touch\"}\n\tfor i, command := range commands {\n\t\tvar allowed string\n\t\tfor j, arg := range command {\n\t\t\tif arg == \"--allowedTools\" && j+1 < len(command) {\n\t\t\t\tallowed = command[j+1]\n\t\t\t}\n\t\t}\n\t\tif allowed == \"\" {\n\t\t\tt.Fatalf(\"command %d of the Claude reviewer allows no command: it cannot reproduce what it judges\", i)\n\t\t}\n\t\tfor _, want := range []string{\"Bash(git status:*)\", \"Bash(pose artifact-check:*)\", \"Bash(pose surface-check:*)\", \"Bash(pose review-check:*)\", \"Bash(pose closeout-check:*)\"} {\n\t\t\tif !strings.Contains(allowed, want) {\n\t\t\t\tt.Errorf(\"command %d does not allow %s\", i, want)\n\t\t\t}\n\t\t}\n\t\tfor _, verb := range writers {\n\t\t\tif strings.Contains(allowed, verb) {\n\t\t\t\tt.Errorf(\"command %d allows %q, a verb that writes\", i, verb)\n\t\t\t}\n\t\t}\n\t}\n}\n\n// A round after the first tells the reviewer how to name the findings it accounts for: the\n// preflight refuses a draft whose prior_findings use a bare identifier (\"prior finding id F1\n// is not a unique carried identifier\"), and only the brief of a later round can say so.\nfunc TestTheBriefOfALaterRoundStatesTheIdentifiersOfPriorFindings(t *testing.T) {\n\ttext := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 2}, true, nil)\ndiff --git a/pose-mcp/internal/pose/live_policy_reads_test.go b/pose-mcp/internal/pose/live_policy_reads_test.go\nindex 9f96cc29..c88531c3 100644\n--- a/pose-mcp/internal/pose/live_policy_reads_test.go\n+++ b/pose-mcp/internal/pose/live_policy_reads_test.go\n@@ -112,7 +112,7 @@ func validateBundleAttestationWithBody(t *testing.T) string {\n \tfound := false\n \tfor _, declaration := range file.Decls {\n \t\tfn, ok := declaration.(*ast.FuncDecl)\n-\t\tif !ok || (fn.Name.Name != \"validateBundleAttestationWith\" && fn.Name.Name != \"reviewFindingDecisionBlockers\") {\n+\t\tif !ok || (fn.Name.Name != \"validateBundleAttestationWith\" && fn.Name.Name != \"attestationContentBlockers\" && fn.Name.Name != \"reviewFindingDecisionBlockers\") {\n \t\t\tcontinue\n \t\t}\n \t\tif fn.Name.Name == \"validateBundleAttestationWith\" {\ndiff --git a/pose-mcp/internal/pose/review_brief_preflight_tie_test.go b/pose-mcp/internal/pose/review_brief_preflight_tie_test.go\nindex c528b4fc..1b56caa4 100644\n--- a/pose-mcp/internal/pose/review_brief_preflight_tie_test.go\n+++ b/pose-mcp/internal/pose/review_brief_preflight_tie_test.go\n@@ -19,7 +19,7 @@ import (\n // saying so, or without someone writing down why it need not.\n \n var preflightFunctions = map[string][]string{\n-\t\"review_bundle.go\":   {\"validateBundleAttestationWith\", \"reviewCriterionEvidenceBlockers\"},\n+\t\"review_bundle.go\":   {\"validateBundleAttestationWith\", \"attestationContentBlockers\", \"reviewCriterionEvidenceBlockers\"},\n \t\"review_closeout.go\": {\"evaluateReviewToolCoverageIn\", \"reviewToolEvidenceBlocker\"},\n }\n \n# POSE trail — review\n\nAvaliação técnica de PR/diff: escopo, contratos, segurança, validação.\n- Path:      pose-mcp → domain: backend-go (repo-map)\n- Workflow:  .pose/workflows/review.md\n- Skill:     pose-review\n- Rules:     .pose/rules/security.md, .pose/rules/documentation-style.md, .pose/rules/backend-go.md