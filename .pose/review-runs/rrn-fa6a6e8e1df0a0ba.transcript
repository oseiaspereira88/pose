{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '171,246p' pose-mcp/internal/pose/delegated_verdicts.go; sed -n '1,110p' pose-mcp/internal/cli/artifact_check.go; rg -n 'synchronize|write|index|refresh' pose-mcp/internal/cli/artifact_check.go; rg -n 'write|index|refresh' pose-mcp/internal/cli/surface_check.go; rg -n 'ReviewDraftSchema|ParseReviewDraft' pose-mcp/internal/pose/review_rounds.go | head; cat .pose/review-overlays/*structur* 2>/dev/null\"","aggregated_output":"// verdictCoverageReasons are why a draft's typed verdict does not answer\n// exactly what the run was asked: every question of an adjudication, every\n// delivery target of a smoke run, nothing else.\nfunc (s Store) verdictCoverageReasons(run ReviewRun, bundle ReviewBundle, draft *ReviewDraft) []string {\n\tif draft == nil {\n\t\treturn nil\n\t}\n\tvar asked, answered []string\n\tswitch run.Kind {\n\tcase ReviewBriefKindAdjudication:\n\t\tquestions, err := s.AdjudicationQuestions(bundle.Payload.Scope)\n\t\tif err != nil {\n\t\t\treturn []string{\"the adjudicated questions cannot be read: \" + err.Error()}\n\t\t}\n\t\tfor _, q := range questions {\n\t\t\tasked = append(asked, q.ID)\n\t\t}\n\t\tfor _, q := range draft.Questions {\n\t\t\tanswered = append(answered, q.ID)\n\t\t}\n\tcase ReviewBriefKindSmoke:\n\t\ttargets, err := s.smokeTargets(bundle.Payload.Scope)\n\t\tif err != nil {\n\t\t\treturn []string{\"the delivery targets cannot be read: \" + err.Error()}\n\t\t}\n\t\tfor _, t := range targets {\n\t\t\tasked = append(asked, t.Ref)\n\t\t}\n\t\tfor _, sf := range draft.Surfaces {\n\t\t\tanswered = append(answered, sf.Ref)\n\t\t}\n\tdefault:\n\t\treturn nil\n\t}\n\tif len(asked) == 0 {\n\t\treturn []string{\"the scope records nothing for a \" + run.Kind + \" run to answer\"}\n\t}\n\tvar reasons []string\n\thave := map[string]bool{}\n\tfor _, id := range answered {\n\t\thave[id] = true\n\t}\n\twant := map[string]bool{}\n\tfor _, id := range asked {\n\t\twant[id] = true\n\t\tif !have[id] {\n\t\t\treasons = append(reasons, id+\" is not answered\")\n\t\t}\n\t}\n\tfor _, id := range answered {\n\t\tif !want[id] {\n\t\t\treasons = append(reasons, id+\" was not asked\")\n\t\t}\n\t}\n\tif len(reasons) > 0 {\n\t\treturn []string{\"the draft's verdict does not answer what the run was asked: \" + strings.Join(reasons, \"; \")}\n\t}\n\treturn nil\n}\n\nfunc (s Store) smokeTargets(scope ReviewBundleScope) ([]DeliveryTarget, error) {\n\tscript, err := s.smokeScriptFor(scope)\n\treturn script.Surfaces, err\n}\n\n// adjudicationRecordFor is the record an adjudication run's draft concludes.\nfunc adjudicationRecordFor(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, proofID, issuer string, at time.Time) AdjudicationRecord {\n\tquestions := append([]ReviewDraftQuestion(nil), draft.Questions...)\n\tsort.Slice(questions, func(i, j int) bool { return questions[i].ID < questions[j].ID })\n\treturn AdjudicationRecord{SchemaVersion: 1, RunID: run.RunID, ProofID: proofID, Issuer: issuer, BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest,\n\t\tScope: bundle.Payload.Scope.Ref, Spec: bundle.Payload.Scope.Slug, Decision: draft.Decision, Questions: questions, RecordedAt: at.UTC().Format(time.RFC3339Nano)}\n}\n\n// smokeDocumentFor is the result document a smoke run's draft concludes:\n// one required check of class smoke per surface, passing when the surface\n// was observed.\nsed: can't read pose-mcp/internal/cli/artifact_check.go: No such file or directory\nrg: pose-mcp/internal/cli/artifact_check.go: IO error for operation on pose-mcp/internal/cli/artifact_check.go: No such file or directory (os error 2)\n18:\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\"))\n32:// loadDeliveryProfiles reads and writes the filesystem directly; loadDeliveryProfilesIn takes the\n60:// collectDeliveryTargets reads and writes the filesystem directly; collectDeliveryTargetsIn takes the\n120:// loadDeliveryValidationResults reads and writes the filesystem directly; loadDeliveryValidationResultsIn takes the\n131:\t// An absent profile index or specs directory used to return here, before a\n183:// extendCurrentDeliveryGraph reads and writes the filesystem directly; extendCurrentDeliveryGraphIn takes the\n261:\t\t_ = writeJSON(stdout, graph)\n308:\t\t_ = writeJSON(stdout, result)\n431:// arrives by value, which reads as a copy and is not one for a slice: those writes\n25:// ReviewDraftSchema is the schema of a pose-draft block.\n26:const ReviewDraftSchema = \"pose.review.draft/v1\"\n156:// ParseReviewDraft reads the pose-draft block of output: nil when there is\n163:func ParseReviewDraft(output string) (*ReviewDraft, error) {\n228:\tdraft, err := ParseReviewDraft(output)\n239:\tif d.Schema != ReviewDraftSchema {\n240:\t\treturn fmt.Errorf(\"the draft's schema is %q, not %s\", d.Schema, ReviewDraftSchema)\n481:\t\tdraft, err := ParseReviewDraft(c.run.Output)\n531:\tdraft, err := ParseReviewDraft(output)\n832:\t\t\tdraft, err := ParseReviewDraft(r.Output)\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '335,410p' pose-mcp/internal/pose/review_plan.go; nl -ba pose-mcp/internal/pose/review_seal_readiness.go | tail -24; sed -n '156,226p' pose-mcp/internal/pose/review_rounds.go; sed -n '236,335p' pose-mcp/internal/pose/review_rounds.go; rg -n 'func evaluateReviewToolCoverage|command:' pose-mcp/internal/pose/*tool*; rg -n 'func cmdArtifactCheck' pose-mcp/internal/cli; rg -n 'assess|readonly|sealed' pose-mcp/internal/cli/assess.go | head -25; rg -n 'schema|check|program|args' .pose/indexes/validation-matrix.json | head -30\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '335,410p' pose-mcp/internal/pose/review_plan.go; nl -ba pose-mcp/internal/pose/review_seal_readiness.go | tail -24; sed -n '156,226p' pose-mcp/internal/pose/review_rounds.go; sed -n '236,335p' pose-mcp/internal/pose/review_rounds.go; rg -n 'func evaluateReviewToolCoverage|command:' pose-mcp/internal/pose/*tool*; rg -n 'func cmdArtifactCheck' pose-mcp/internal/cli; rg -n 'assess|readonly|sealed' pose-mcp/internal/cli/assess.go | head -25; rg -n 'schema|check|program|args' .pose/indexes/validation-matrix.json | head -30\"","aggregated_output":"\t\t\tfor _, unknown := range plan.Structure.Unknown {\n\t\t\t\tplan.Warnings = append(plan.Warnings, \"unresolved structural coverage \"+unknown)\n\t\t\t}\n\t\t\tfor _, fact := range plan.Structure.Material {\n\t\t\t\tif len(fact.SharedWith) > 0 {\n\t\t\t\t\tplan.Warnings = append(plan.Warnings, \"structural fact \"+fact.ID+\" on \"+firstNonempty(fact.Path, fact.Subject)+\" comes from a commit also attributed to \"+strings.Join(fact.SharedWith, \", \")+\"; map it if this scope made the change, otherwise answer this fact's mapping not-applicable with the reason\")\n\t\t\t\t}\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t\tselected = selectReviewOverlays(overlays, context)\n\t\tfor _, item := range selected {\n\t\t\tprofiles = append(profiles, item.profile)\n\t\t\tplan.SelectedProfiles = append(plan.SelectedProfiles, item.selection)\n\t\t\tplan.Explain = append(plan.Explain, item.profile.Ref()+\" selected: \"+item.selection.Rationale)\n\t\t\tplan.Independence = stricterReviewIndependence(plan.Independence, item.profile.Independence)\n\t\t}\n\t}\n\n\tplan.Criteria, plan.Blockers = composeReviewCriteria(profiles, plan.Blockers)\n\tplan.Criteria, plan.Blockers = s.addMilestoneGateCriterion(scope, plan.Criteria, plan.Blockers)\n\tvar added bool\n\tplan.Criteria, plan.Blockers, added = addCrossComponentReviewCriterion(plan.Criteria, plan.Blockers, len(plan.Components))\n\tif added {\n\t\tplan.Explain = append(plan.Explain, \"cross-component-integration added because multiple mapped component roots are affected\")\n\t}\n\tplan.PolicyBaseline.Paths = guard.Paths\n\tplan.PolicyBaseline.Reason = guard.Reason\n\tif guard.Unreadable != \"\" {\n\t\tplan.PolicyBaseline.Weakened = append(plan.PolicyBaseline.Weakened, \"unreadable_tree_contract:\"+guard.Unreadable)\n\t}\n\tif len(guard.Paths) > 0 && baseline.Resolved {\n\t\tapplyProtectedPolicyBaseline(&plan, baseline, policy, scope, context)\n\t}\n\tplan.Explain = append(plan.Explain, reviewPolicyBaselineExplain(plan.PolicyBaseline)...)\n\tif !plan.PolicyBaseline.Protected && len(guard.Paths) > 0 {\n\t\tplan.Warnings = append(plan.Warnings, \"unprotected review contract change \"+strings.Join(guard.Paths, \",\")+\": \"+firstNonempty(guard.Reason, \"the base contract could not be resolved\"))\n\t}\n\tif policy.DelegatedReviewConfigured && !policy.DelegatedReview && plan.Independence == \"different-actor\" && !plan.PolicyBaseline.Protected {\n\t\tplan.Independence = \"same-actor-separate-execution\"\n\t\tplan.Limitations = []string{ReviewLimitationDelegationDisabled}\n\t\tplan.Explain = append(plan.Explain, ReviewLimitationDelegationDisabled+\": explicit refusal allows a separate execution of the same actor; human requirements are unchanged\")\n\t}\n\tplan.Tools, plan.Blockers, plan.Warnings = buildReviewTools(scope, context, profiles, plan.SelectedProfiles, plan.Criteria, plan.Blockers, plan.Warnings)\n\tplan.Warnings = s.annotateReviewToolProducerCoverage(plan.Tools, plan.Warnings)\n\tfor _, c := range plan.Criteria {\n\t\tfor _, rule := range c.Rules {\n\t\t\tpath := filepath.Join(s.Root, \".pose\", \"rules\", rule+\".md\")\n\t\t\tif _, statErr := s.fsys().Stat(path); statErr != nil {\n\t\t\t\tplan.Warnings = append(plan.Warnings, fmt.Sprintf(\"uninstalled review rule %q for criterion %s (install via extension)\", rule, c.ID))\n\t\t\t}\n\t\t}\n\t}\n\tplan.Warnings = uniqueSorted(plan.Warnings)\n\tplan.Blockers = uniqueSorted(plan.Blockers)\n\tplan.Explain = uniqueStable(plan.Explain)\n\tfloor := normalizeReviewIndependence(policy.ReviewerIndependence[scope.Kind])\n\tplan.Bands, plan.Band = deriveReviewBands(plan, scope.Kind, floor, selected, undecidableReviewOverlays(overlays, selected), context)\n\tif band, ok := reviewPolicyBaselineBand(plan.PolicyBaseline); ok {\n\t\tplan.Bands = append(plan.Bands, band)\n\t\tif reviewBandRank[band.Band] > reviewBandRank[plan.Band] {\n\t\t\tplan.Band = band.Band\n\t\t}\n\t}\n\tplan.Projection = projectDeclaredReviewObligations(plan, scope, base, floor, overlays, context)\n\tplan.PlanDigest, err = digestReviewPlan(plan)\n\tif err != nil {\n\t\treturn ReviewPlan{}, err\n\t}\n\t// Warnings and Explain enter the digest; the decision does not, so it is\n\t// attached only as its own field. A gate that cannot answer (a corrupt or\n\t// drifted receipt) fails the plan as it fails closeout-check.\n\tif !s.planWithoutCloseoutGate {\n\t\tdecision, _, gateErr := s.closeoutReviewGate(ref, policy)\n\t\tif gateErr != nil {\n\t\t\treturn ReviewPlan{}, gateErr\n    26\t\t\t\t\t\tmsg += \" (\" + finding.Remediation + \")\"\n    27\t\t\t\t\t}\n    28\t\t\t\t\tblockers = append(blockers, msg+\"; pose close refuses it after the review\")\n    29\t\t\t\t}\n    30\t\t\t}\n    31\t\t}\n    32\t\t// R2: a structural fact is mapped to a decision basis, and the preflight\n    33\t\t// refuses a basis that reaches no requirement or constraint. When the plan\n    34\t\t// asks for mappings, every declared decision must be usable as one.\n    35\t\tif structure := bundle.Payload.Plan.Structure; structure != nil && len(structure.Material) > 0 {\n    36\t\t\tns := s.reviewDesignBasisNamespace(scope)\n    37\t\t\tvar unreached []string\n    38\t\t\tfor id := range ns.Known {\n    39\t\t\t\tif !ns.Reaches[id] {\n    40\t\t\t\t\tunreached = append(unreached, id)\n    41\t\t\t\t}\n    42\t\t\t}\n    43\t\t\tsort.Strings(unreached)\n    44\t\t\tfor _, id := range unreached {\n    45\t\t\t\tblockers = append(blockers, \"decision basis \"+id+\" reaches no requirement or constraint: give it a `- Basis:` line naming one, or the conclusion preflight refuses a mapping to it\")\n    46\t\t\t}\n    47\t\t}\n    48\t\treturn uniqueSorted(blockers)\n    49\t}\n// ParseReviewDraft reads the pose-draft block of output: nil when there is\n// none, an error when the block is not one valid draft. Fences are whole\n// lines, LF or CRLF: an opening line is exactly \"```pose-draft\", the block\n// closes at the first line that is exactly \"```\", and any other line that\n// starts a fence before it, or a second block, is an error, never a block\n// read as absent (review round 2, R2-B2). Every decision line outside the\n// block must agree with it (R2-B1).\nfunc ParseReviewDraft(output string) (*ReviewDraft, error) {\n\tlines := strings.Split(output, \"\\n\")\n\tfor i := range lines {\n\t\tlines[i] = strings.TrimSuffix(lines[i], \"\\r\")\n\t}\n\topen, close := -1, -1\n\tfor i, line := range lines {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\t// Any fence that names pose-draft — indented, spaced, longer, or\n\t\t// with tildes — is an attempt at a block: only the exact form opens\n\t\t// one, and any other is an error (review round 3, R3-B1).\n\t\tattempt := reviewDraftOpening.MatchString(trimmed)\n\t\tswitch {\n\t\tcase attempt && (open >= 0 || line != reviewDraftFence):\n\t\t\tif close >= 0 || open >= 0 {\n\t\t\t\treturn nil, fmt.Errorf(\"the message carries more than one pose-draft block\")\n\t\t\t}\n\t\t\treturn nil, fmt.Errorf(\"line %d opens a pose-draft block in a form the engine does not read: %q\", i+1, quoteLedgerText(line))\n\t\tcase attempt:\n\t\t\topen = i\n\t\tcase open >= 0 && close < 0 && (strings.HasPrefix(trimmed, \"```\") || strings.HasPrefix(trimmed, \"~~~\")):\n\t\t\tif line != \"```\" {\n\t\t\t\treturn nil, fmt.Errorf(\"line %d inside the pose-draft block is not its closing fence: %q\", i+1, quoteLedgerText(line))\n\t\t\t}\n\t\t\tclose = i\n\t\t}\n\t}\n\tif open < 0 {\n\t\treturn nil, nil\n\t}\n\tif close < 0 {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block is not closed\")\n\t}\n\traw := []byte(strings.Join(lines[open+1:close], \"\\n\"))\n\tvar draft ReviewDraft\n\tdec := json.NewDecoder(bytes.NewReader(raw))\n\tdec.DisallowUnknownFields()\n\tif err := dec.Decode(&draft); err != nil {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block is not a draft: %v\", err)\n\t}\n\tif _, err := dec.Token(); err != io.EOF {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block carries data after the draft\")\n\t}\n\tif err := exactJSONKeys(json.NewDecoder(bytes.NewReader(raw)), reflect.TypeOf(draft)); err != nil {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block is ambiguous: %v\", err)\n\t}\n\tif err := validateReviewDraft(draft); err != nil {\n\t\treturn nil, err\n\t}\n\tfor i, line := range lines {\n\t\tif i > open && i <= close {\n\t\t\tcontinue\n\t\t}\n\t\tkey, value, ok := strings.Cut(strings.TrimSpace(line), \":\")\n\t\tif ok && key == \"decision\" && strings.TrimSpace(value) != draft.Decision {\n\t\t\treturn nil, fmt.Errorf(\"the draft's decision %s differs from the decision line %q\", draft.Decision, strings.TrimSpace(value))\n\t\t}\n\t}\n\treturn &draft, nil\n}\n\n// draftReviewDecision is the decision a run's final message declares: the\n// pose-draft block's when there is one, which a contradicting decision line\n// makes unknown, or else the legacy decision line (review round 1, B13).\n}\n\nfunc validateReviewDraft(d ReviewDraft) error {\n\tif d.Schema != ReviewDraftSchema {\n\t\treturn fmt.Errorf(\"the draft's schema is %q, not %s\", d.Schema, ReviewDraftSchema)\n\t}\n\tswitch d.Decision {\n\tcase \"approved\", \"changes-requested\", \"rejected\":\n\tdefault:\n\t\treturn fmt.Errorf(\"the draft's decision %q is not approved, changes-requested or rejected\", d.Decision)\n\t}\n\tif len(d.Findings) > reviewDraftMaxFindings || len(d.PriorFindings) > reviewDraftMaxFindings || len(d.Sweep) > reviewDraftMaxText {\n\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n\t}\n\tseen := map[string]bool{}\n\tfor _, f := range d.Findings {\n\t\tswitch {\n\t\tcase !reviewFindingID.MatchString(f.ID) || reviewRoundPrefix.MatchString(f.ID) || seen[f.ID]:\n\t\t\treturn fmt.Errorf(\"finding id %q is not a unique identifier without a round prefix\", f.ID)\n\t\tcase f.Severity != \"high\" && f.Severity != \"medium\" && f.Severity != \"low\":\n\t\t\treturn fmt.Errorf(\"finding %s: severity %q is not high, medium or low\", f.ID, f.Severity)\n\t\tcase f.Disposition != \"blocker\" && f.Disposition != \"follow-up\":\n\t\t\treturn fmt.Errorf(\"finding %s: disposition %q is not blocker or follow-up\", f.ID, f.Disposition)\n\t\tcase strings.TrimSpace(f.Summary) == \"\" || len(f.Summary) > reviewDraftMaxText || len(f.File) > 1024 || f.Line < 0:\n\t\t\treturn fmt.Errorf(\"finding %s needs a bounded summary and location\", f.ID)\n\t\t}\n\t\tseen[f.ID] = true\n\t}\n\tanswered := map[string]bool{}\n\tfor _, c := range d.Criteria {\n\t\tswitch {\n\t\tcase ValidateSlug(c.ID) != nil || answered[c.ID]:\n\t\t\treturn fmt.Errorf(\"criterion %q is not a unique criterion id\", c.ID)\n\t\tcase c.Disposition != \"passed\" && c.Disposition != \"finding\" && c.Disposition != \"not-applicable\":\n\t\t\treturn fmt.Errorf(\"criterion %s: disposition %q is not passed, finding or not-applicable\", c.ID, c.Disposition)\n\t\tcase len(c.Evidence) > reviewDraftMaxText || len(c.Rationale) > reviewDraftMaxText || len(c.Mappings) > reviewDraftMaxFindings:\n\t\t\treturn fmt.Errorf(\"criterion %s exceeds its bounds\", c.ID)\n\t\t}\n\t\tfor _, m := range c.Mappings {\n\t\t\tif strings.TrimSpace(m.Delta) == \"\" || len(m.Delta) > 256 || len(m.Basis) > 256 || len(m.Disposition) > 64 || len(m.Rationale) > reviewDraftMaxText || len(m.Owner) > 256 || len(m.ReviewBy) > 64 {\n\t\t\t\treturn fmt.Errorf(\"criterion %s: a mapping needs a delta and bounded text\", c.ID)\n\t\t\t}\n\t\t}\n\t\tanswered[c.ID] = true\n\t}\n\tfor _, t := range d.Tools {\n\t\tif ValidateSlug(t.ID) != nil || strings.TrimSpace(t.Disposition) == \"\" || len(t.Evidence) > reviewDraftMaxText || len(t.Rationale) > reviewDraftMaxText || len(t.Component) > 256 {\n\t\t\treturn fmt.Errorf(\"tool %q needs an id, a disposition and bounded text\", t.ID)\n\t\t}\n\t}\n\tfor _, f := range d.Findings {\n\t\tif len(f.Action) > reviewDraftMaxText || len(f.Owner) > 256 || len(f.ReviewBy) > 64 {\n\t\t\treturn fmt.Errorf(\"finding %s exceeds its bounds\", f.ID)\n\t\t}\n\t}\n\tif len(d.Criteria) > reviewDraftMaxFindings || len(d.Tools) > reviewDraftMaxFindings || len(d.Questions) > reviewDraftMaxFindings || len(d.Surfaces) > reviewDraftMaxFindings {\n\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n\t}\n\tif b := d.BusinessDecision; b != nil {\n\t\tif strings.TrimSpace(b.Question) == \"\" || len(b.Question) > reviewDraftMaxText || len(b.Options) < 2 || len(b.Options) > 8 {\n\t\t\treturn fmt.Errorf(\"a business decision needs a bounded question and two to eight options\")\n\t\t}\n\t\tseen := map[string]bool{}\n\t\tfor _, o := range b.Options {\n\t\t\tif ValidateSlug(o.ID) != nil || seen[o.ID] || strings.TrimSpace(o.Consequence) == \"\" || len(o.Consequence) > reviewDraftMaxText {\n\t\t\t\treturn fmt.Errorf(\"business decision option %q needs a unique slug and its consequence\", o.ID)\n\t\t\t}\n\t\t\tseen[o.ID] = true\n\t\t}\n\t}\n\tasked := map[string]bool{}\n\tfor _, q := range d.Questions {\n\t\tswitch {\n\t\tcase !adjudicationQuestionID.MatchString(q.ID) || asked[q.ID]:\n\t\t\treturn fmt.Errorf(\"question %q is not a unique decision or requirement id\", q.ID)\n\t\tcase q.Verdict != AdjudicationHolds && q.Verdict != AdjudicationDoesNotHold && q.Verdict != AdjudicationCannotDetermine:\n\t\t\treturn fmt.Errorf(\"question %s: verdict %q is not holds, does-not-hold or cannot-determine\", q.ID, q.Verdict)\n\t\tcase strings.TrimSpace(q.Rationale) == \"\" || len(q.Rationale) > reviewDraftMaxText || len(q.Evidence) > reviewDraftMaxText:\n\t\t\treturn fmt.Errorf(\"question %s needs a bounded rationale\", q.ID)\n\t\t}\n\t\tasked[q.ID] = true\n\t}\n\tobserved := map[string]bool{}\n\tfor _, sf := range d.Surfaces {\n\t\tswitch {\n\t\tcase !deliveryRefRE.MatchString(sf.Ref) || observed[sf.Ref]:\n\t\t\treturn fmt.Errorf(\"surface %q is not a unique delivery target\", sf.Ref)\n\t\tcase sf.Outcome != SmokeObserved && sf.Outcome != SmokeNotObserved && sf.Outcome != SmokeNotReachable:\n\t\t\treturn fmt.Errorf(\"surface %s: outcome %q is not observed, not-observed or not-reachable\", sf.Ref, sf.Outcome)\n\t\tcase len(sf.Commands) == 0 || len(sf.Commands) > 64 || strings.TrimSpace(sf.Observed) == \"\" || len(sf.Observed) > reviewDraftMaxText:\n\t\t\treturn fmt.Errorf(\"surface %s needs the commands run and what was observed\", sf.Ref)\n\t\t}\n\t\tfor _, c := range sf.Commands {\n\t\t\tif strings.TrimSpace(c) == \"\" || len(c) > 1024 {\n\t\t\t\treturn fmt.Errorf(\"surface %s: a command must be non-empty and bounded\", sf.Ref)\n\t\t\t}\n\t\t}\n\t\tobserved[sf.Ref] = true\n\t}\n\taccounted := map[string]bool{}\nrg: pose-mcp/internal/pose/*tool*: IO error for operation on pose-mcp/internal/pose/*tool*: No such file or directory (os error 2)\npose-mcp/internal/cli/artifact_integrity.go:787:func cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\n3:// pose assess (spec pose-capability-mechanism): capability assessment as a\n4:// POSE-native artifact. Bare `assess` validates structure, evidence and\n63:\t\t\treturn assessInit(root, stdout, stderr, locale)\n65:\t\t\treturn assessSnapshot(root, stdout, stderr, locale)\n67:\t\t\treturn assessDiff(root, args[1:], stdout, stderr, locale)\n69:\t\t\treturn assessStale(root, args[1:], stdout, stderr, locale)\n71:\t\t\treturn assessRequest(root, args[1:], stdout, stderr, locale)\n73:\t\t\treturn assessDiscover(root, args[1:], stdout, stderr, locale)\n75:\t\t\treturn assessIntegrate(root, args[1:], stdout, stderr, locale)\n77:\t\t\treturn assessTechDebt(root, args[1:], stdout, stderr, locale)\n79:\t\t\treturn assessDesign(root, args[1:], stdout, stderr, locale)\n81:\t\t\treturn assessValidate(root, true, stdout, stderr, locale)\n84:\t\t\t\t\"Usage: pose assess [init|snapshot|diff|stale|request|discover|integrate|tech-debt|design [options]|--json]\",\n85:\t\t\t\t\"Uso: pose assess [init|snapshot|diff|stale|request|discover|integrate|tech-debt|design [opções]|--json]\"))\n89:\treturn assessValidate(root, false, stdout, stderr, locale)\n92:func assessInit(root string, stdout, stderr io.Writer, locale cliLocale) int {\n102:\t\tfmt.Fprintf(stderr, \"pose assess init: %v\\n\", err)\n105:\tcontent := capabilityTemplate(assessBaselineCommit(root))\n107:\t\tfmt.Fprintf(stderr, \"pose assess init: %v\\n\", err)\n111:\t\t\"Capability assessment created: %s (16 default mechanisms; edit scores, targets, evidence and prose)\\n\",\n112:\t\t\"Capability assessment criado: %s (16 mecanismos default; edite scores, targets, evidência e prosa)\\n\"), path)\n116:// assessBaselineCommit resolves HEAD for the scaffold; \"0000000\" when git is\n118:func assessBaselineCommit(root string) string {\n130:type assessReport struct {\n135:\tAssessedAt  string   `json:\"assessed_at\"`\n49:      \"checks\": [\n52:          \"program\": \"npm\",\n53:          \"args\": [\n63:          \"program\": \"npm\",\n64:          \"args\": [\n73:          \"program\": \"npm\",\n74:          \"args\": [\n83:          \"name\": \"typecheck\",\n84:          \"program\": \"npm\",\n85:          \"args\": [\n87:            \"typecheck\",\n91:          \"evidenceClass\": \"typecheck\"\n96:      \"checks\": [\n99:          \"program\": \"go\",\n100:          \"args\": [\n109:          \"program\": \"go\",\n110:          \"args\": [\n119:          \"program\": \"go\",\n120:          \"args\": [\n130:      \"checks\": [\n133:          \"program\": \"cargo\",\n134:          \"args\": [\n143:  