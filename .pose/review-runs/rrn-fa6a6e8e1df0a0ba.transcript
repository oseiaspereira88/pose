{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '2488,2515p' pose-mcp/internal/pose/review_bundle.go; rg -n 'func reviewRunID|runID :=|RunID:' pose-mcp/internal/pose/review_dispatch.go | head -15; python3 - <<'PY'\nimport subprocess,json\nmsg='decision: changes-requested\\\\n\"'```pose-draft'\"\\\\n'+json.dumps({'schema':'pose.review.draft/v1','decision':'changes-requested','findings':[]})+'\\\\n\"'```'\"\\\\n'\nr=subprocess.run(['pose','review','draft-check','run-fixture','--draft','-'],input=msg,text=True,capture_output=True)\nprint('run-id draft-check exit:',r.returncode)\nprint(r.stdout+r.stderr)\nPY\"","aggregated_output":"func (s Store) LoadReviewBundle(id string) (ReviewBundle, error) {\n\tif !strings.HasPrefix(id, \"rvb-\") || len(id) != 20 {\n\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: invalid review bundle id %q\", id)\n\t}\n\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\")), false)\n\tif err != nil {\n\t\treturn ReviewBundle{}, err\n\t}\n\tpath := filepath.Join(dir, id+\".json\")\n\tvar bundle ReviewBundle\n\tif err := strictJSONFileIn(s.fsys(), path, &bundle); err != nil {\n\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: reading review bundle %s: %w\", id, err)\n\t}\n\tif bundle.SchemaVersion != ReviewBundleSchemaVersion || bundle.BundleID != id || bundle.State != \"sealed\" {\n\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: malformed review bundle %s\", id)\n\t}\n\tdigest, err := reviewBundlePayloadDigest(bundle.Payload)\n\tif err != nil || digest != bundle.BundleDigest || id != \"rvb-\"+strings.TrimPrefix(digest, \"sha256:\")[:16] {\n\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: review bundle %s digest mismatch\", id)\n\t}\n\tif impl := bundle.Payload.Implementation; impl != nil {\n\t\tif err := validateBundleImplementation(*impl); err != nil {\n\t\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: review bundle %s: %w\", id, err)\n\t\t}\n\t}\n\t// The order of bundles is by the instant they were sealed: a bundle without a valid one\n\t// has no known place in the history, and is not read as the oldest.\n\tif _, ok := reviewInstant(bundle.SealedAt); !ok {\n1491:\twitness := reviewRunWitness{SchemaVersion: 1, RunID: run.RunID, BundleID: run.BundleID, Scope: run.Scope, RecordDigest: digestBytes(pretty), TranscriptDigest: run.TranscriptDigest}\nrun-id draft-check exit: 2\nUsage: pose review <bundle|brief|attest|auto-attest|verify|record|attribution-supplement> ...\n\n","exit_code":0,"status":"completed"}}
