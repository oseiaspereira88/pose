{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '105,178p' pose-mcp/internal/pose/review_structure.go; sed -n '239,265p' pose-mcp/internal/pose/review_structure.go; rg -n 'resolveReviewStructure' pose-mcp/internal/pose; sed -n '990,1170p' pose-mcp/internal/cli/validate.go; sed -n '100,180p' pose-mcp/internal/pose/review_conclusions.go; sed -n '525,595p' pose-mcp/internal/pose/review_rounds.go; rg -n 'func ParseReviewDraft|decision' pose-mcp/internal/pose/review_draft.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '105,178p' pose-mcp/internal/pose/review_structure.go; sed -n '239,265p' pose-mcp/internal/pose/review_structure.go; rg -n 'resolveReviewStructure' pose-mcp/internal/pose; sed -n '990,1170p' pose-mcp/internal/cli/validate.go; sed -n '100,180p' pose-mcp/internal/pose/review_conclusions.go; sed -n '525,595p' pose-mcp/internal/pose/review_rounds.go; rg -n 'func ParseReviewDraft|decision' pose-mcp/internal/pose/review_draft.go\"","aggregated_output":"\n// resolveReviewStructure observes the sealed subject. It is deliberately not\n// called through PrepareReviewBundle: that builds a bundle *from* a plan, so a\n// plan asking it for a subject would be circular. The subject builder underneath\n// takes the scope, the mapped components and the integrity graph, and knows\n// nothing about plans.\nfunc (s Store) resolveReviewStructure(scope ScopeRef, components []ReviewPlanComponent) *ReviewPlanStructure {\n\tstructure := &ReviewPlanStructure{}\n\tgraph, err := s.GetDeliveryIntegrity(\"\")\n\tif err != nil {\n\t\tstructure.Reason = \"delivery-integrity index is unavailable, so no subject is attributable; run `pose index`\"\n\t\treturn structure\n\t}\n\tsubject, _, blockers, err := s.reviewBundleSubject(scope, components, graph, nil)\n\tif err != nil {\n\t\tstructure.Reason = err.Error()\n\t\treturn structure\n\t}\n\tif len(blockers) > 0 {\n\t\tstructure.Reason = strings.Join(blockers, \"; \")\n\t\treturn structure\n\t}\n\treport, err := AssessDesignDeltaIn(s.fsys(), s.Root, subject, scope.String(), DesignDeltaOptions{})\n\tif err != nil {\n\t\tstructure.Reason = err.Error()\n\t\treturn structure\n\t}\n\tstructure.Observed = true\n\tstructure.Status = report.Status\n\tstructure.InputDigest = report.InputDigest\n\tstructure.SubjectDigest = subject.ImplementationDigest\n\tkinds := []string{}\n\tfor _, delta := range report.Deltas {\n\t\tif !StructuralDeltaIsMaterial(delta) {\n\t\t\tif delta.State != \"observed\" {\n\t\t\t\tstructure.Unknown = append(structure.Unknown, delta.Kind+\":\"+delta.Subject+\":\"+delta.State)\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tkinds = append(kinds, delta.Kind)\n\t\tstructure.Material = append(structure.Material, ReviewStructuralFact{\n\t\t\tID: delta.DisplayID, Kind: delta.Kind, Action: delta.Action,\n\t\t\tSubject: delta.Subject, Path: delta.Path, Runtime: delta.Runtime,\n\t\t\tSharedWith: delta.SharedWith,\n\t\t})\n\t}\n\tfor _, detector := range report.Coverage.Detectors {\n\t\tif detector.State == \"unknown\" || detector.State == \"unsupported\" {\n\t\t\tstructure.Unknown = append(structure.Unknown, \"detector:\"+detector.ID+\":\"+detector.State)\n\t\t}\n\t}\n\tif report.Coverage.Truncated {\n\t\tstructure.Unknown = append(structure.Unknown, \"coverage:truncated\")\n\t}\n\tsort.Slice(structure.Material, func(i, j int) bool { return structure.Material[i].ID < structure.Material[j].ID })\n\tstructure.Kinds = uniqueSorted(kinds)\n\tstructure.Unknown = uniqueSorted(structure.Unknown)\n\treturn structure\n}\n\n// reviewStructuralMappingCriteria returns the required criteria that declared\n// themselves answerable for observed structure.\nfunc reviewStructuralMappingCriteria(required map[string]ReviewPlanCriterion) []string {\n\tids := []string{}\n\tfor id, criterion := range required {\n\t\tif criterion.RequiresStructuralMapping {\n\t\t\tids = append(ids, id)\n\t\t}\n\t}\n\tsort.Strings(ids)\n\treturn ids\n}\n\n// reviewDesignBasisNamespace resolves what a mapping may point at, from the\nfunc (s Store) reviewStructuralCausalityBlockers(scopeRef string, structure *ReviewPlanStructure, required map[string]ReviewPlanCriterion, dispositions []ReviewCriterion) []string {\n\tif structure == nil || len(structure.Material) == 0 {\n\t\treturn nil\n\t}\n\tscope, err := ParseScopeRef(scopeRef)\n\tif err != nil {\n\t\treturn []string{\"structural causality cannot be checked for scope \" + describeMappingDelta(scopeRef)}\n\t}\n\towners := reviewStructuralMappingCriteria(required)\n\tif len(owners) == 0 {\n\t\treturn nil\n\t}\n\tfacts := map[string]ReviewStructuralFact{}\n\tfor _, fact := range structure.Material {\n\t\tfacts[fact.ID] = fact\n\t}\n\tnamespace := s.reviewDesignBasisNamespace(scope)\n\tblockers := []string{}\n\tfor _, id := range owners {\n\t\tdisposition := ReviewCriterion{}\n\t\tfound := false\n\t\tfor _, candidate := range dispositions {\n\t\t\tif candidate.ID == id {\n\t\t\t\tdisposition, found = candidate, true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\npose-mcp/internal/pose/review_structure.go:106:// resolveReviewStructure observes the sealed subject. It is deliberately not\npose-mcp/internal/pose/review_structure.go:111:func (s Store) resolveReviewStructure(scope ScopeRef, components []ReviewPlanComponent) *ReviewPlanStructure {\npose-mcp/internal/pose/review_plan.go:330:\t\t\tplan.Structure = s.resolveReviewStructure(scope, context.Components)\n\t\treturn 2\n\t}\n\tif workspaceFilter != \"\" && (moduleFilter != \"\" || rootOnly) {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --workspace, --module and --root-only are mutually exclusive.\", \"Erro: --workspace, --module e --root-only são mutuamente exclusivos.\"))\n\t\treturn 2\n\t}\n\tif rootOnly {\n\t\tmoduleFilter = \".\"\n\t}\n\tfor _, out := range []string{jsonOut, junitOut, sarifOut, planOut} {\n\t\tif out != \"\" && !confinedRelativePath(out) {\n\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: result output paths must remain inside the project.\", \"Erro: paths de saída de resultado devem permanecer dentro do projeto.\"))\n\t\t\treturn 2\n\t\t}\n\t}\n\tcanonicalResultsPath := \"\"\n\tif jsonOut != \"\" || carry {\n\t\tcanonicalResultsPath = configuredDeliveryResultsPath(root)\n\t}\n\tif carry {\n\t\tswitch {\n\t\tcase moduleFilter != \"\" || stackFilter != \"\" || workspaceFilter != \"\" || changedFrom != \"\" || changedTo != \"\":\n\t\t\trender(stdout, stderr).Failure(cliText(locale, \"--carry refreshes the whole canonical result; it cannot be combined with --module, --stack, --workspace, --root-only, --changed-from or --changed-to\", \"--carry renova o resultado canônico inteiro; não combina com --module, --stack, --workspace, --root-only, --changed-from ou --changed-to\"))\n\t\t\treturn 2\n\t\tcase canonicalResultsPath == \"\":\n\t\t\trender(stdout, stderr).Failure(cliText(locale, \"--carry needs results_path in .pose/policy/delivery.json\", \"--carry exige results_path em .pose/policy/delivery.json\"))\n\t\t\treturn 2\n\t\tcase normalizeValidationOutputPath(jsonOut) != canonicalResultsPath:\n\t\t\trender(stdout, stderr).Failure(fmt.Sprintf(cliText(locale, \"--carry writes the canonical result: use --json-out %s\", \"--carry grava o resultado canônico: use --json-out %s\"), canonicalResultsPath))\n\t\t\treturn 2\n\t\t}\n\t}\n\t// The report --report writes records this run, so it reads this run's own\n\t// output. It used to look for a pose-validate.latest.log that native\n\t// validation never writes, and every report said \"Fill manually\" and \"No\n\t// validation output detected\" under an outcome it could not support (spec\n\t// pose-validate-report-carries-its-run).\n\t// The report records this run from the run's own structured result, not\n\t// from its printed output (spec pose-cli-output-rendering-system R5).\n\t// Capturing stdout to re-parse it is what made every printed line a\n\t// contract.\n\tif stackFilter != \"\" && !map[string]bool{\"node\": true, \"go\": true, \"rust\": true, \"java\": true, \"python\": true, \"dotnet\": true, \"contract\": true}[stackFilter] {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid --stack: %s\\n\", \"Erro: --stack inválido: %s\\n\"), stackFilter)\n\t\treturn 2\n\t}\n\tif moduleFilter == \"..\" || strings.HasPrefix(moduleFilter, \"../\") || filepath.IsAbs(moduleFilter) {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --module must remain inside the project.\", \"Erro: --module deve permanecer dentro do projeto.\"))\n\t\treturn 2\n\t}\n\t// HEAD and its movement witness are pinned before any plan input is read:\n\t// the matrix and the module discovery then belong to this head, or the\n\t// end-of-run comparison sees the move (review round 13, N37).\n\tpinnedHead := \"\"\n\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n\t\tpinnedHead = strings.TrimSpace(string(head))\n\t}\n\tstartReflog := movementWitness(root, pinnedHead)\n\t// The working copy must match the pinned head before the plan inputs are\n\t// read, by the same full predicate checked at the end: status, hidden\n\t// index entries and submodule checkouts (review round 14, N40 and N41).\n\tstartedClean := pinnedHead != \"\" && validationMaterialClean(root, pinnedHead)\n\tmatrixPath := filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\")\n\traw, err := os.ReadFile(matrixPath)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: validation matrix not found at %s\\n\", \"Erro: matriz de validação não encontrada em %s\\n\"), matrixPath)\n\t\treturn 2\n\t}\n\tmatrix, err := parseValidationMatrix(raw)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid validation matrix: %v\\n\", \"Erro: matriz de validação inválida: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif err := validateStructuredMatrixPaths(matrix); err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid validation matrix path: %v\\n\", \"Erro: path inválido na matriz de validação: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif err := validateDeliveryMatrixContract(matrix); err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid delivery validation contract: %v\\n\", \"Erro: contrato de validação de delivery inválido: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif matrixHasLegacyChecks(matrix) {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: legacy shell 'command' checks are unsupported; migrate each check to program + args + env.\", \"Erro: checks shell legados em 'command' não são suportados; migre cada check para program + args + env.\"))\n\t\treturn 2\n\t}\n\tif mode == \"\" {\n\t\tmode = matrix.Defaults.Mode\n\t\tif mode == \"\" {\n\t\t\tmode = \"strict\"\n\t\t}\n\t}\n\tmodules, err := discoverValidationModules(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: discovering modules: %v\\n\", \"Erro: descobrir módulos: %v\\n\"), err)\n\t\treturn 1\n\t}\n\tif workspaceFilter != \"\" {\n\t\tresolved, ok := resolveWorkspaceModulePath(root, modules, workspaceFilter)\n\t\tif !ok {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: no module's manifest name matches --workspace %q.\\n\", \"Erro: nenhum module tem name de manifesto igual a --workspace %q.\\n\"), workspaceFilter)\n\t\t\treturn 2\n\t\t}\n\t\tmoduleFilter = resolved\n\t}\n\tknownModules := map[string]bool{}\n\tfor _, module := range modules {\n\t\tknownModules[module.Rel] = true\n\t}\n\tfor rel, override := range matrix.ModuleOverrides {\n\t\tclean := filepath.ToSlash(filepath.Clean(rel))\n\t\tif clean == \"..\" || strings.HasPrefix(clean, \"../\") || filepath.IsAbs(rel) {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: moduleOverrides contains a path outside the project: %s\\n\", \"Erro: moduleOverrides contém path fora do projeto: %s\\n\"), rel)\n\t\t\treturn 2\n\t\t}\n\t\tif knownModules[clean] {\n\t\t\tif override.Stack != \"\" {\n\t\t\t\tfor idx := range modules {\n\t\t\t\t\tif modules[idx].Rel == clean {\n\t\t\t\t\t\tmodules[idx].Stack = override.Stack\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tabs := filepath.Join(root, filepath.FromSlash(clean))\n\t\tif info, err := os.Stat(abs); err == nil && info.IsDir() {\n\t\t\tstack := override.Stack\n\t\t\tif stack == \"\" {\n\t\t\t\tstack = \"contract\"\n\t\t\t}\n\t\t\tmodules = append(modules, validationModule{Rel: clean, Abs: abs, Stack: stack})\n\t\t\tknownModules[clean] = true\n\t\t}\n\t}\n\tsort.Slice(modules, func(i, j int) bool { return modules[i].Rel < modules[j].Rel })\n\tvar scope *scopeSelection\n\tif changedTo != \"\" && changedFrom == \"\" {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --changed-to requires --changed-from.\", \"Erro: --changed-to exige --changed-from.\"))\n\t\treturn 2\n\t}\n\tif changedFrom != \"\" {\n\t\tsel, err := computeChangedScope(root, changedFrom, changedTo, modules)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: changed-scope selection: %v\\n\", \"Erro: seleção por escopo alterado: %v\\n\"), err)\n\t\t\treturn 2\n\t\t}\n\t\tscope = &sel\n\t\tif explain {\n\t\t\tfmt.Fprintf(stdout, \"[changed-scope] %s: %d changed file(s), %d/%d module(s) selected\\n\", sel.rangeLabel(), len(sel.Changed), len(sel.Selected), len(modules))\n\t\t\tfor _, m := range modules {\n\t\t\t\tif reason, ok := sel.Selected[m.Rel]; ok {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  + %s: %s\\n\", m.Rel, reason)\n\t\t\t\t} else {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  - %s: not affected by %s\\n\", m.Rel, sel.rangeLabel())\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\trun := validationRunResult{\n\t\tSchemaVersion: validationResultSchema,\n\t\tGeneratedAt:   time.Now().UTC().Format(time.RFC3339),\n\t\tMode:          mode,\n\t\tStackFilter:   stackFilter,\n\t\tModuleFilter:  moduleFilter,\n\t\tChecks:        []checkResult{},\n\t}\n\tmatrixDigest := sha256.Sum256(raw)\n\trun.MatrixSHA256 = \"sha256:\" + hex.EncodeToString(matrixDigest[:])\n\trun.EngineVersion = validationEngineIdentity()\n\t// The head is pinned before anything is planned: selection, carried\n\t// results and the end-of-run comparison all name this one commit (review\n\t// round 5, N14).\n\trun.GitHead = pinnedHead\n\tvar carryState carryPlan\n\tif carry {\n\t\tcarryState = planCarry(root, canonicalResultsPath, mode, run.MatrixSHA256, run.GitHead, matrix, modules)\n\t\trun.Carry = carryState.record\n\t\tout := render(stdout, stderr)\n\t\tif !carryState.record.Used {\n\t\t\tout.ContractLine(\"[carry] full run: \" + carryState.record.Reason)\n\t\t} else {\n\t\t\tout.ContractLine(fmt.Sprintf(\"[carry] base %s: %d changed file(s), %d/%d module(s) run\", carryState.record.BaseHead, carryState.record.Changed, len(carryState.record.Selected), len(modules)))\n\t\treasons = append(reasons, \"the run is superseded by \"+run.SupersededBy)\n\t}\n\tif run.Provenance == nil {\n\t\treasons = append(reasons, \"the run captured no provenance, so it cannot be signed\")\n\t}\n\tif run.Safety == nil || run.Safety.Operation.Outcome != OutcomeCompleted {\n\t\treasons = append(reasons, \"the run's cleanup is not confirmed complete\")\n\t}\n\tif why := s.reviewRunTranscriptIntact(run); why != \"\" {\n\t\treasons = append(reasons, \"the run's record is not intact: \"+why)\n\t}\n\tdraft, err := ParseReviewDraft(run.Output)\n\tswitch {\n\tcase err != nil:\n\t\treasons = append(reasons, \"the conclusion cannot be read: \"+err.Error())\n\tcase draft == nil:\n\t\treasons = append(reasons, \"the run's final message carries no pose-draft block\")\n\t}\n\tif len(run.DraftProblems) > 0 {\n\t\treasons = append(reasons, \"the draft does not account for its round: \"+strings.Join(run.DraftProblems, \"; \"))\n\t}\n\tbundle, err := s.LoadReviewBundle(run.BundleID)\n\tif err != nil {\n\t\treturn append(reasons, \"the run's bundle cannot be read: \"+err.Error()), nil, draft\n\t}\n\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n\tif err != nil || current == nil || current.BundleID != bundle.BundleID {\n\t\treasons = append(reasons, \"the run's bundle no longer governs \"+bundle.Payload.Scope.Ref+\": the subject, the plan or the policy changed since it was sealed\")\n\t}\n\tif why := s.ReviewRunStillGoverns(run); why != \"\" {\n\t\treasons = append(reasons, \"the run no longer governs: \"+why)\n\t}\n\treasons = append(reasons, s.verdictCoverageReasons(run, bundle, draft)...)\n\treturn reasons, &bundle, draft\n}\n\n// reviewAttestationFromDraft builds the attestation a draft concludes, for\n// the run that wrote it. Evidence is the run itself and each evidence the\n// draft names; a criterion or a tool the draft does not answer is left for\n// the preflight to refuse, never answered for it.\nfunc reviewAttestationFromDraft(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, reviewer string) ReviewAttestation {\n\tatt := ReviewAttestation{BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest, Reviewer: reviewer, Decision: draft.Decision}\n\tevidence := map[string]bool{\"delegated-run:\" + run.RunID: true}\n\tfor _, c := range draft.Criteria {\n\t\tatt.Criteria = append(att.Criteria, ReviewCriterion{ID: c.ID, Disposition: c.Disposition, Evidence: c.Evidence, Rationale: c.Rationale, Mappings: c.Mappings})\n\t\tif c.Evidence != \"\" {\n\t\t\tevidence[c.Evidence] = true\n\t\t}\n\t}\n\tvar tools []ReviewToolDisposition\n\tfor _, t := range draft.Tools {\n\t\ttools = append(tools, ReviewToolDisposition{ID: t.ID, Component: t.Component, Disposition: t.Disposition, Evidence: t.Evidence, Rationale: t.Rationale})\n\t}\n\tatt.Tools = ReviewToolDefaults(bundle.Payload.Plan.Tools, tools)\n\tfor _, f := range draft.Findings {\n\t\tfinding := ReviewFinding{ID: f.ID, Severity: f.Severity, Evidence: findingEvidence(f), Action: f.Action, Disposition: \"open\"}\n\t\tif f.Action == \"\" {\n\t\t\tfinding.Action = f.Summary\n\t\t}\n\t\t// A follow-up the reviewer gave an action, an owner and a review date\n\t\t// is a risk the reviewer accepted; anything else stays open and blocks\n\t\t// an approval. The engine never writes the action for the reviewer\n\t\t// (review round 1, B3).\n\t\tif f.Disposition == \"follow-up\" && f.Action != \"\" && f.Owner != \"\" && f.ReviewBy != \"\" {\n\t\t\tfinding.Disposition, finding.Owner, finding.ReviewBy, finding.Rationale = \"accepted-risk\", f.Owner, f.ReviewBy, f.Summary\n\t\t}\n\t\tatt.Findings = append(att.Findings, finding)\n\t}\n\tfor ref := range evidence {\n\t\tatt.EvidenceRefs = append(att.EvidenceRefs, ref)\n\t}\n\tsort.Strings(att.EvidenceRefs)\n\tatt.Run = &ReviewRunReference{RunID: run.RunID}\n\treturn att\n}\n\n// ReviewToolDefaults is given followed by the dispositions that state no\n// conclusion, for the plan's tools given leaves out: a post-review gate\n// deferred, a recommended tool not used. A required tool left out stays out,\n// for the domain writer to name. `review attest` and a run's conclusion fill\n// the same defaults, so a run's conclusion and its attestation agree on them.\n}\n\n// ValidateRoundDraft judges a draft of round against R3 and R4: from round 2\n// on, every open finding is accounted for, a fixed one with evidence, and the\n// sweep is stated. It returns the problems; none means valid.\nfunc ValidateRoundDraft(round ReviewRound, output string) []string {\n\tdraft, err := ParseReviewDraft(output)\n\tif err != nil {\n\t\treturn []string{err.Error()}\n\t}\n\tvar problems []string\n\topen := map[string]bool{}\n\tfor _, f := range round.Open {\n\t\topen[f.ID] = true\n\t}\n\tif draft != nil {\n\t\t// An account of a finding no round reported is not an account: it\n\t\t// would count as convergence without a defect (review round 2, R2-B3).\n\t\tfor _, p := range draft.PriorFindings {\n\t\t\tif !open[p.ID] {\n\t\t\t\tproblems = append(problems, \"prior finding \"+p.ID+\" is not an open finding of the scope's rounds\")\n\t\t\t}\n\t\t}\n\t}\n\tif round.Number < 2 {\n\t\treturn problems\n\t}\n\tif draft == nil {\n\t\treturn []string{\"a draft of round \" + fmt.Sprint(round.Number) + \" needs a pose-draft block\"}\n\t}\n\taccounted := map[string]ReviewDraftPrior{}\n\tfor _, p := range draft.PriorFindings {\n\t\taccounted[p.ID] = p\n\t}\n\tfor _, f := range round.Open {\n\t\tp, ok := accounted[f.ID]\n\t\tswitch {\n\t\tcase !ok:\n\t\t\tproblems = append(problems, \"prior finding \"+f.ID+\" is not accounted for\")\n\t\tcase p.Status == PriorFindingFixed && strings.TrimSpace(p.Evidence) == \"\":\n\t\t\tproblems = append(problems, \"prior finding \"+f.ID+\" is reported fixed with no evidence\")\n\t\t}\n\t}\n\tif strings.TrimSpace(draft.Sweep) == \"\" {\n\t\tproblems = append(problems, \"the draft does not state what it swept\")\n\t}\n\treturn problems\n}\n\n// quoteLedgerText renders text an earlier reviewer wrote as one quoted line:\n// whitespace collapsed, backticks neutralized, so it can open no section and\n// carry no instruction of its own (review round 1, B4).\nfunc quoteLedgerText(text string) string {\n\treturn strings.ReplaceAll(strings.Join(strings.Fields(text), \" \"), \"`\", \"'\")\n}\n\n// renderPriorRound is the brief's section of round 2 and later, built only\n// from the ledger, byte-stable for the same ledger state (R2, R3).\nfunc renderPriorRound(round ReviewRound) string {\n\tvar b strings.Builder\n\tline := func(format string, a ...any) { fmt.Fprintf(&b, format+\"\\n\", a...) }\n\tline(\"## Previous round\")\n\tline(\"\")\n\tline(\"This is round %d of the scope.\", round.Number)\n\tif round.Prior != nil {\n\t\thead := \"\"\n\t\tif round.PriorBundle != nil {\n\t\t\thead = round.PriorBundle.Payload.Subject.Head\n\t\t}\n\t\tline(\"The previous round is run %s on bundle %s (commit %s); its draft digest is %s.\", round.Prior.RunID, round.Prior.BundleID, orNone(head), digestBytes([]byte(round.Prior.Output)))\n\t}\nrg: pose-mcp/internal/pose/review_draft.go: IO error for operation on pose-mcp/internal/pose/review_draft.go: No such file or directory (os error 2)\n","exit_code":2,"status":"failed"}}
