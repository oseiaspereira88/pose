{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\nimport subprocess,os,json\nfor args in [[\\\"artifact-check\\\",\\\"--spec\\\",\\\"pose-review-readiness-before-seal\\\",\\\"--strict\\\",\\\"--json\\\"],[\\\"surface-check\\\",\\\"--spec\\\",\\\"pose-review-readiness-before-seal\\\",\\\"--strict\\\",\\\"--json\\\"]]:\n r=subprocess.run([os.environ[\\\"POSE_REVIEW_CLI\\\"]]+args,capture_output=True,text=True)\n print(\\\"COMMAND\\\", \\\" \\\".join(args),\\\"EXIT\\\",r.returncode,flush=True)\n try:\n  d=json.loads(r.stdout)\n  print(json.dumps([x for x in d.get(\\\"findings\\\",[]) if x.get(\\\"spec\\\")==\\\"pose-review-readiness-before-seal\\\" or x.get(\\\"severity\\\") in (\\\"error\\\",\\\"critical\\\")])[:4000],flush=True)\n except Exception: print((r.stdout+r.stderr)[-3000:],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
