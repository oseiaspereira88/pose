a/pose-mcp/internal/cli/help_catalog.go\n+++ b/pose-mcp/internal/cli/help_catalog.go\n@@ -383,6 +383,7 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"bundle\", \"pose review bundle <scope|xref> [--seal] [--explain] [--expect-context <digest>]\", \"Prepare or seal an immutable review subject bundle\", \"Prepara ou sela o bundle imutável de revisão\"},\n \t\t\t{\"brief\", \"pose review brief <bundle-id|scope> [--kind review|adjudication|smoke] [--note-file <path>] [--json]\", \"Render the request a delegated reviewer receives, from the sealed bundle and, from round 2, the previous round's open findings\", \"Gera o pedido que um revisor delegado recebe, a partir do bundle selado e, da rodada 2 em diante, dos findings abertos da rodada anterior\"},\n \t\t\t{\"run-sign\", \"pose review run-sign <run-id> --issuer <name> [--ttl <duration>] [--apply] [--json]\", \"Sign captured run provenance with a pinned native issuer\", \"Assina a proveniência capturada com issuer nativo fixado\"},\n+\t\t\t{\"draft-check\", \"pose review draft-check [<bundle-id|run-id>] --draft <file> [--json]\", \"Report every reason the conclusion step would refuse a review draft, without writing; inside a delegated review the bundle and round come from the run\", \"Relata todo motivo pelo qual a conclusão recusaria um rascunho de review, sem gravar; dentro de uma review delegada o bundle e a rodada vêm do run\"},\n \t\t\t{\"conclude\", \"pose review conclude <run> [--issuer <name>] [--apply] [--json]\", \"Record the typed conclusion of a completed delegated run: a review as its signed attestation, an adjudication on the spec, a smoke run as smoke evidence; or why it records none\", \"Registra a conclusão tipada de um run delegado concluído: uma review como atestação assinada, uma adjudicação na spec, um smoke como evidência smoke; ou por que não registra nenhuma\"},\n \t\t\t{\"request\", \"pose review request <scope|bundle-id> --kind delegated-review [--purpose review|adjudicate|smoke] [--agents <name,...>] [--note-file <path>] [--supersedes <act-id> [--authority <json>] [--role <role>] [--requested-at <time>]] [--apply] [--json]\", \"Open a delegated-review action request that a local run, a CI job or the Conductor fulfils\", \"Abre uma action request de review delegada que um run local, um job de CI ou o Conductor cumpre\"},\n \t\t\t{\"run-proof\", \"pose review run-proof <run-id> <proof-id> [--json]\", \"Verify current run proof and disclose executor assurance\", \"Verifica a prova atual e divulga assurance do executor\"},\ndiff --git a/pose-mcp/internal/cli/review_closeout.go b/pose-mcp/internal/cli/review_closeout.go\nindex 22bfa902..973059fc 100644\n--- a/pose-mcp/internal/cli/review_closeout.go\n+++ b/pose-mcp/internal/cli/review_closeout.go\n@@ -430,6 +430,8 @@ func cmdReview(root string, args []string, stdout, stderr io.Writer) int {\n \t\treturn cmdReviewRunProof(root, args[1:], stdout, stderr)\n \tcase \"conclude\":\n \t\treturn cmdReviewConclude(root, args[1:], stdout, stderr)\n+\tcase \"draft-check\":\n+\t\treturn cmdReviewDraftCheck(root, args[1:], stdout, stderr)\n \tcase \"request\":\n \t\treturn cmdReviewRequest(root, args[1:], stdout, stderr)\n \t// The aliases pose-delegation-surface deprecated are removed (spec\ndiff --git a/pose-mcp/internal/cli/review_conclude.go b/pose-mcp/internal/cli/review_conclude.go\nindex add10fc0..4fb97af5 100644\n--- a/pose-mcp/internal/cli/review_conclude.go\n+++ b/pose-mcp/internal/cli/review_conclude.go\n@@ -102,6 +102,11 @@ func delegateAutoConclude(store posemodel.Store, run posemodel.ReviewRun, err er\n \t\treturn\n \t}\n \tif conclusion == nil {\n+\t\t// R6 of spec pose-review-readiness-before-seal: a completed run that\n+\t\t// is not concluded automatically names the step that concludes it.\n+\t\tif next := delegateConcludeNextStep(store, run); next != \"\" {\n+\t\t\trender(stdout, stderr).Hint(next)\n+\t\t}\n \t\treturn\n \t}\n \tline := \"pose delegate: conclusion \" + conclusion.State\n@@ -113,3 +118,21 @@ func delegateAutoConclude(store posemodel.Store, run posemodel.ReviewRun, err er\n \t}\n \trender(stdout, stderr).Hint(line)\n }\n+\n+// delegateConcludeNextStep is the command that records the conclusion of a\n+// completed run nothing concluded, or \"\" when there is none to record.\n+func delegateConcludeNextStep(store posemodel.Store, run posemodel.ReviewRun) string {\n+\tif run.Status != posemodel.ReviewRunCompleted || run.RunID == \"\" {\n+\t\treturn \"\"\n+\t}\n+\tswitch run.Kind {\n+\tcase posemodel.ReviewBriefKindReview, posemodel.ReviewBriefKindAdjudication, posemodel.ReviewBriefKindSmoke:\n+\tdefault:\n+\t\treturn \"\"\n+\t}\n+\tcommand := \"pose review conclude \" + run.RunID\n+\tif policy, _, found, err := store.LoadDelegationPolicy(); err != nil || !found || policy.ConclusionsIssuer() == \"\" {\n+\t\tcommand += \" --issuer <name>\"\n+\t}\n+\treturn \"pose delegate: nothing concluded this run automatically; preview its conclusion with `\" + command + \"`, then record it with `\" + command + \" --apply`\"\n+}\ndiff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex c77e594c..8ba600c5 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -2134,6 +2134,9 @@ func (s Store) sealReviewBundle(ref string, identity *ReviewBundleImplementation\n \t\treplaced.Replaces = governing.BundleID\n \t\tidentity = &replaced\n \t}\n+\tif blockers := s.sealReadinessBlockers(bundle); len(blockers) > 0 {\n+\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", strings.Join(blockers, \"; \"))\n+\t}\n \t// A bundle already sealed reads as it was; a new seal holds a validation result,\n \t// whatever the lifecycle of the scope says.\n \tif !holdsValidationResult(bundle.Payload.Evidence) {\n@@ -3891,6 +3894,15 @@ func (s Store) validateBundleAttestationWith(bundle ReviewBundle, att ReviewAtte\n \t\t\t}\n \t\t}\n \t}\n+\treturn append(blockers, s.attestationContentBlockers(bundle, att, skipEvidenceSupport)...)\n+}\n+\n+// attestationContentBlockers judges what an attestation says about its bundle,\n+// apart from who signed it: criteria, mappings, findings, evidence and tools.\n+// It is the part a reviewer's draft can be checked against before the run\n+// ends (spec pose-review-readiness-before-seal R3).\n+func (s Store) attestationContentBlockers(bundle ReviewBundle, att ReviewAttestation, skipEvidenceSupport bool) []string {\n+\tblockers := []string{}\n \trequired := map[string]ReviewPlanCriterion{}\n \tfor _, criterion := range bundle.Payload.Plan.Criteria {\n \t\tif criterion.Required {\ndiff --git a/pose-mcp/internal/pose/review_dispatch.go b/pose-mcp/internal/pose/review_dispatch.go\nindex ac0fc598..88a753fa 100644\n--- a/pose-mcp/internal/pose/review_dispatch.go\n+++ b/pose-mcp/internal/pose/review_dispatch.go\n@@ -965,6 +965,22 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t// The reviewer works in a sealed checkout: diagnostics it runs must not\n \t// publish derived records into it (SealedCheckoutEnv).\n \tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n+\t// The reviewer checks its draft against the sealed bundle and the round\n+\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n+\t// context that cannot be built leaves the check unavailable, never the\n+\t// review.\n+\tif plan.Purpose == DelegationPurposeReview {\n+\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n+\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n+\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n+\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n+\t\t\t\t// engine that dispatched the run is the one that checks it.\n+\t\t\t\tif self, err := os.Executable(); err == nil {\n+\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t}\n \tcmd.Env = env\n \tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n \tcmd.Stdout, cmd.Stderr = combined, combined\npackage pose\n\n// Seal readiness (spec pose-review-readiness-before-seal R1, R2): a new seal\n// refuses what `pose close` and the conclusion preflight would refuse only\n// after a full review round, using the same rules. A bundle already sealed\n// is returned as it was and never re-judged here.\n\nimport \"sort\"\n\n// sealReadinessFindingCodes are the declaration findings a seal refuses:\n// what the spec must declare about its own change, known before any review.\n// Evidence findings stay at close, where their inputs are final.\nvar sealReadinessFindingCodes = map[string]bool{\"undeclared-delivery\": true, \"undeclared\": true}\n\nfunc (s Store) sealReadinessBlockers(bundle ReviewBundle) []string {\n\tscope, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n\tif err != nil || scope.Kind != \"spec\" {\n\t\treturn nil\n\t}\n\tvar blockers []string\n\t// R1: the declarations `pose close` requires, read from the same index\n\t// findings its delivery assurance gate reports.\n\t{\n\t\tif graph, err := s.GetDeliveryIntegrity(\"\"); err == nil {\n\t\t\tfor _, finding := range graph.Findings {\n\t\t\t\tif !sealReadinessFindingCodes[finding.Code] || finding.Spec != scope.Slug || finding.Severity != \"error\" && finding.Severity != \"critical\" {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tmsg := finding.Code + \" [\" + finding.Path + \"]: \" + finding.Message\n\t\t\t\tif finding.Remediation != \"\" {\n\t\t\t\t\tmsg += \" (\" + finding.Remediation + \")\"\n\t\t\t\t}\n\t\t\t\tblockers = append(blockers, msg+\"; pose close refuses it after the review\")\n\t\t\t}\n\t\t}\n\t}\n\t// R2: a structural fact is mapped to a decision basis, and the preflight\n\t// refuses a basis that reaches no requirement or constraint. When the plan\n\t// asks for mappings, every declared decision must be usable as one.\n\tasksMapping := false\n\tfor _, criterion := range bundle.Payload.Plan.Criteria {\n\t\tasksMapping = asksMapping || criterion.Required && criterion.RequiresStructuralMapping\n\t}\n\tif structure := bundle.Payload.Plan.Structure; asksMapping && structure != nil && len(structure.Material) > 0 {\n\t\tns := s.reviewDesignBasisNamespace(scope)\n\t\tvar unreached []string\n\t\tfor id := range ns.Known {\n\t\t\tif !ns.Reaches[id] {\n\t\t\t\tunreached = append(unreached, id)\n\t\t\t}\n\t\t}\n\t\tsort.Strings(unreached)\n\t\tfor _, id := range unreached {\n\t\t\tblockers = append(blockers, \"decision basis \"+id+\" reaches no requirement or constraint: give it a `- Basis:` line naming one, or the conclusion preflight refuses a mapping to it\")\n\t\t}\n\t}\n\treturn uniqueSorted(blockers)\n}\n// refused at seal; the same scope without structural facts seals.\nfunc TestSealReadinessRefusesADecisionWithoutBasis(t *testing.T) {\n\tstore := causalityFixture(t)\n\tstructure, required := causalityInputs()\n\tvar bundle ReviewBundle\n\tbundle.Payload.Scope.Ref = \"spec:backend\"\n\tbundle.Payload.Plan.Structure = structure\n\t// Material facts with no criterion that asks for their mapping: nothing\n\t// is mapped, so nothing is refused (review round 1, N1).\n\tif blockers := store.sealReadinessBlockers(bundle); len(blockers) != 0 {\n\t\tt.Fatalf(\"a plan that asks for no mapping was refused: %v\", blockers)\n\t}\n\tbundle.Payload.Plan.Criteria = []ReviewPlanCriterion{required[\"design-causality\"], required[\"correctness\"]}\n\tblockers := store.sealReadinessBlockers(bundle)\n\tassertBlocker(t, blockers, \"decision basis D9 reaches no requirement or constraint\")\n\tassertBlocker(t, blockers, \"decision basis A9 reaches no requirement or constraint\")\n\tif strings.Contains(strings.Join(blockers, \"\\n\"), \"basis D1 \") || strings.Contains(strings.Join(blockers, \"\\n\"), \"basis A1 \") {\n\t\tt.Fatalf(\"a basis that reaches a requirement was refused: %v\", blockers)\n\t}\n\tbundle.Payload.Plan.Structure = nil\n\tif blockers := store.sealReadinessBlockers(bundle); len(blockers) != 0 {\n\t\tt.Fatalf(\"a plan without structural facts was refused: %v\", blockers)\n\t}\n}\n// Spec pose-review-readiness-before-seal R1: a spec scope whose change\n// touches a delivery root without a declaration is refused at seal, with the\n// rule `pose close` uses, instead of after an approved review.\nfunc TestSealRefusesAnUndeclaredDelivery(t *testing.T) {\n\t// The undeclared delivery, and the undeclared artifact of review round 1\n\t// (N3): both are refused by `pose close` and known before the review.\n\tfor _, finding := range []string{\"undeclared-delivery\", \"undeclared\"} {\n\t\troot := sealReadinessRoot(t, finding, \"error\")\n\t\tcode, out := runPose(t, root, \"review\", \"bundle\", \"spec:alpha\", \"--seal\")\n\t\tif code == 0 || !strings.Contains(out, finding+\" [pose-mcp/lib.go]\") || !strings.Contains(out, \"pose close refuses it\") {\n\t\t\tt.Fatalf(\"%s was sealed: %d %s\", finding, code, out)\n\t\t}\n\t}\n\t// A warning, as for a spec created before the delivery policy, seals;\n\t// so does an evidence finding, which stays at close.\n\troot := sealReadinessRoot(t, \"undeclared-delivery\", \"warning\")\n\tif code, out := runPose(t, root, \"review\", \"bundle\", \"spec:alpha\", \"--seal\"); code != 0 {\n\t\tt.Fatalf(\"a warning blocked the seal: %d %s\", code, out)\n\t}\n\troot = sealReadinessRoot(t, \"unconsumed-capability\", \"error\")\n\tif code, out := runPose(t, root, \"review\", \"bundle\", \"spec:alpha\", \"--seal\"); code != 0 {\n\t\tt.Fatalf(\"a warning blocked the seal: %d %s\", code, out)\n\t}\n}\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:66:byte-a-byte, avisos, readiness, rollback via git puro). `examples/`\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:3:slug: agency-readiness-outcome-review\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:10:  spec: \"spec:pose-agency-readiness-pilot\"\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:12:  commands: [\"pose review verify roadmap:agency-readiness\", \"pose knowledge-check --strict\"]\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:16:# Handoff: agency-readiness outcome review\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:20:Independent outcome review of roadmap:agency-readiness at d72b6abb, bundle\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:29:go vet passes. Registered phase-readiness, source-coverage, effective-governance,\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:49:- Verify roadmap:agency-readiness after recording the explicit attestation.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:68:- Roadmap: `.pose/roadmaps/agency-readiness.md`.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:69:- Pilot: `.pose/specs/2026-10-04-pose-agency-readiness-pilot.md`.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:71:- Full report: `/tmp/pose-roadmaps-evidence/reached/rm-agency-readiness/attest-report.md`.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:72:- Fresh argv/results: `/var/tmp/pose-work-go/review-reached/rm-agency-readiness/attest/round3/`.\n.pose/knowledge/2026-10-18-handoff-pose-b06-source-coverage-closeout.md:33:Aguardar merge do PR #194 pelo maintainer e reavaliar DAG/readiness. Nenhuma\n.pose/knowledge/2026-10-18-handoff-pose-b06-source-coverage-closeout.md:47:@pose-maintainers coordena merge e readiness; @core responde pelos dois follow-ups.\n","exit_code":1,"status":"failed"}}
