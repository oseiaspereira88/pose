{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/output.go | sed -n '81,165p'\"","aggregated_output":"    81\ttype gateOutput struct {\n    82\t\tr     *cliout.Renderer\n    83\t\tflags outputFlags\n    84\t\t// result is stdout for a full human run and io.Discard otherwise, for the\n    85\t\t// prose a gate prints around its findings.\n    86\t\tresult io.Writer\n    87\t\t// root anchors --json-out; a gate sets it once it knows the project.\n    88\t\troot string\n    89\t}\n    90\t\n    91\tfunc newGateOutput(command string, flags outputFlags, stdout, stderr io.Writer) *gateOutput {\n    92\t\tr := renderWithColor(stdout, stderr, flags.Color)\n    93\t\tr.SetQuiet(flags.Quiet)\n    94\t\tswitch {\n    95\t\tcase flags.JSON:\n    96\t\t\tr.RecordJSON(command)\n    97\t\tcase flags.JSONOut != \"\":\n    98\t\t\tr.RecordTee(command)\n    99\t\t}\n   100\t\tresult := stdout\n   101\t\tif flags.JSON || flags.Quiet {\n   102\t\t\tresult = io.Discard\n   103\t\t}\n   104\t\treturn &gateOutput{r: r, flags: flags, result: result}\n   105\t}\n   106\t\n   107\t// Field writes a contract `name=value` line; --quiet omits it, --json records it.\n   108\tfunc (g *gateOutput) Field(name, value string) {\n   109\t\tif g.flags.Quiet && !g.flags.JSON {\n   110\t\t\treturn\n   111\t\t}\n   112\t\tg.r.Field(name, value)\n   113\t}\n   114\t\n   115\t// Verdict prints the gate's pinned verdict line, or records state and text\n   116\t// under --json. It prints under --quiet: the verdict is what --quiet keeps.\n   117\tfunc (g *gateOutput) Verdict(state cliout.State, line, text string) {\n   118\t\tg.VerdictWord(state, \"\", line, text)\n   119\t}\n   120\t\n   121\t// VerdictWord is Verdict for a decision the default SUCCESS/FAILURE words do\n   122\t// not name, such as a tolerated failure or a stale state. The word is the\n   123\t// untranslated one a machine keys on.\n   124\tfunc (g *gateOutput) VerdictWord(state cliout.State, word, line, text string) {\n   125\t\tif g.flags.JSON {\n   126\t\t\tg.r.Verdict(cliout.Verdict{State: state, Word: word, Text: text})\n   127\t\t\treturn\n   128\t\t}\n   129\t\tg.r.RecordVerdict(cliout.Verdict{State: state, Word: word, Text: text})\n   130\t\tg.r.ContractLine(line)\n   131\t}\n   132\t\n   133\t// RecordNote adds a machine-only field that has no contract line of its own.\n   134\tfunc (g *gateOutput) RecordNote(name, value string) { g.r.RecordField(name, value) }\n   135\t\n   136\t// Close writes the --json-out file, then flushes the stdout document, if any.\n   137\tfunc (g *gateOutput) Close() {\n   138\t\tif g.flags.JSONOut != \"\" {\n   139\t\t\tif err := writeJSONOut(g.r, g.root, g.flags.JSONOut); err != nil {\n   140\t\t\t\tg.r.Failure(err.Error())\n   141\t\t\t}\n   142\t\t}\n   143\t\t_ = g.r.FlushJSON()\n   144\t}\n   145\t\n   146\t// writeJSONOut writes r's document to path, relative to root.\n   147\tfunc writeJSONOut(r *cliout.Renderer, root, path string) error {\n   148\t\tvar buf bytes.Buffer\n   149\t\tif err := r.WriteJSONTo(&buf); err != nil {\n   150\t\t\treturn err\n   151\t\t}\n   152\t\ttarget := filepath.Join(root, filepath.FromSlash(path))\n   153\t\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n   154\t\t\treturn err\n   155\t\t}\n   156\t\treturn writeAtomic(target, buf.Bytes(), 0o644)\n   157\t}\n","exit_code":0,"status":"completed"}}
