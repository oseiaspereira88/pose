{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/assessment_sealed.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Assessments in a sealed review checkout (spec\n     4\t// pose-assess-leaves-sealed-checkouts-alone): a reviewer running a planned\n     5\t// assessment tool must not change the checkout it reviews, or its own run\n     6\t// fails. The CLI does not persist there; these writers refuse as the last\n     7\t// line, so no other caller can publish an assessment into it either.\n     8\t\n     9\timport \"errors\"\n    10\t\n    11\t// ErrSealedAssessmentWrite is returned by an assessment writer whose root is\n    12\t// the sealed checkout of a delegated review.\n    13\tvar ErrSealedAssessmentWrite = errors.New(\"pose: assessments are not persisted in a sealed review checkout; run the command with --no-persist\")\n    14\t\n    15\tfunc refuseSealedAssessmentWrite(root string) error {\n    16\t\tif IsSealedCheckout(root) {\n    17\t\t\treturn ErrSealedAssessmentWrite\n    18\t\t}\n    19\t\treturn nil\n    20\t}\n","exit_code":0,"status":"completed"}}
