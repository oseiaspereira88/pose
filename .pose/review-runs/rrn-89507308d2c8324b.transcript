{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/cli/assess_sealed_test.go && nl -ba pose-mcp/internal/pose/assessment_sealed_test.go'","aggregated_output":"     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"crypto/sha256\"\n     5\t\t\"encoding/hex\"\n     6\t\t\"io/fs\"\n     7\t\t\"os\"\n     8\t\t\"path/filepath\"\n     9\t\t\"sort\"\n    10\t\t\"strings\"\n    11\t\t\"testing\"\n    12\t\n    13\t\t\"github.com/harne8/pose-mcp/internal/pose\"\n    14\t)\n    15\t\n    16\t// treeDigest names every file under root with its content, so any write,\n    17\t// creation or removal changes it.\n    18\tfunc treeDigest(t *testing.T, root string) string {\n    19\t\tt.Helper()\n    20\t\tvar lines []string\n    21\t\terr := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {\n    22\t\t\tif err != nil || d.IsDir() {\n    23\t\t\t\treturn err\n    24\t\t\t}\n    25\t\t\traw, err := os.ReadFile(path)\n    26\t\t\tif err != nil {\n    27\t\t\t\treturn err\n    28\t\t\t}\n    29\t\t\tsum := sha256.Sum256(raw)\n    30\t\t\trel, _ := filepath.Rel(root, path)\n    31\t\t\tlines = append(lines, rel+\" \"+hex.EncodeToString(sum[:]))\n    32\t\t\treturn nil\n    33\t\t})\n    34\t\tif err != nil {\n    35\t\t\tt.Fatal(err)\n    36\t\t}\n    37\t\tsort.Strings(lines)\n    38\t\treturn strings.Join(lines, \"\\n\")\n    39\t}\n    40\t\n    41\tfunc assessSealedRoot(t *testing.T) string {\n    42\t\tt.Helper()\n    43\t\troot := assessTestRoot(t)\n    44\t\twriteCloseoutCLIFile(t, root, \"svc/main.go\", \"package main\\n\\n// TODO: a marker\\nfunc main() {}\\n\")\n    45\t\twriteCloseoutCLIFile(t, root, \"svc/go.mod\", \"module example.com/svc\\n\\ngo 1.22\\n\")\n    46\t\twriteCloseoutCLIFile(t, root, \".pose/state/project-state.md\", \"# Project state\\n\")\n    47\t\treturn root\n    48\t}\n    49\t\n    50\t// Spec pose-assess-leaves-sealed-checkouts-alone R2, R4: inside the sealed\n    51\t// checkout of a delegated review every assessment command leaves the tree\n    52\t// as it was, and the ones that only write refuse.\n    53\tfunc TestAssessLeavesTheSealedCheckoutUnchanged(t *testing.T) {\n    54\t\troot := assessSealedRoot(t)\n    55\t\tt.Setenv(pose.SealedCheckoutEnv, root)\n    56\t\tbefore := treeDigest(t, root)\n    57\t\tfor _, args := range [][]string{\n    58\t\t\t{\"discover\"}, {\"discover\", \"--update-state\"}, {\"discover\", \"--component\", \"svc\", \"--if-stale\"},\n    59\t\t\t{\"integrate\"}, {\"integrate\", \"--update-state\", \"--json\"},\n    60\t\t\t{\"tech-debt\"}, {\"tech-debt\", \"--update-state\"},\n    61\t\t} {\n    62\t\t\tcode, out, errOut := runAssess(t, root, args...)\n    63\t\t\tif code != 0 || !strings.Contains(errOut, \"sealed checkout of a delegated review\") {\n    64\t\t\t\tt.Fatalf(\"assess %v: %d %s %s\", args, code, out, errOut)\n    65\t\t\t}\n    66\t\t\tif strings.Contains(out, \"Artifacts written\") {\n    67\t\t\t\tt.Fatalf(\"assess %v claims it wrote: %s\", args, out)\n    68\t\t\t}\n    69\t\t\tif after := treeDigest(t, root); after != before {\n    70\t\t\t\tt.Fatalf(\"assess %v changed the sealed checkout:\\n%s\\n---\\n%s\", args, before, after)\n    71\t\t\t}\n    72\t\t}\n    73\t\tfor _, sub := range []string{\"init\", \"snapshot\", \"request\"} {\n    74\t\t\tif code, _, errOut := runAssess(t, root, sub); code == 0 || !strings.Contains(errOut, \"sealed review checkout\") {\n    75\t\t\t\tt.Fatalf(\"assess %s ran in the sealed checkout: %d %s\", sub, code, errOut)\n    76\t\t\t}\n    77\t\t}\n    78\t\tif after := treeDigest(t, root); after != before {\n    79\t\t\tt.Fatal(\"a refused assess command changed the sealed checkout\")\n    80\t\t}\n    81\t\t// The writers refuse on their own, for any other caller.\n    82\t\tif err := (pose.Store{Root: root}).SaveTechDebtReport(&pose.TechDebtReportState{}); err != pose.ErrSealedAssessmentWrite {\n    83\t\t\tt.Fatalf(\"the tech-debt writer wrote into the sealed checkout: %v\", err)\n    84\t\t}\n    85\t}\n    86\t\n    87\t// R1: --no-persist prints the result and writes nothing anywhere; without it\n    88\t// and outside a sealed checkout the records are written as before.\n    89\tfunc TestAssessNoPersistWritesNothing(t *testing.T) {\n    90\t\troot := assessSealedRoot(t)\n    91\t\tbefore := treeDigest(t, root)\n    92\t\tfor _, sub := range []string{\"discover\", \"integrate\", \"tech-debt\"} {\n    93\t\t\tcode, out, errOut := runAssess(t, root, sub, \"--no-persist\", \"--update-state\")\n    94\t\t\tif code != 0 || !strings.Contains(errOut, \"--no-persist\") || out == \"\" {\n    95\t\t\t\tt.Fatalf(\"assess %s --no-persist: %d %s %s\", sub, code, out, errOut)\n    96\t\t\t}\n    97\t\t\tif after := treeDigest(t, root); after != before {\n    98\t\t\t\tt.Fatalf(\"assess %s --no-persist wrote\", sub)\n    99\t\t\t}\n   100\t\t}\n   101\t\tif code, _, errOut := runAssess(t, root, \"tech-debt\"); code != 0 {\n   102\t\t\tt.Fatal(errOut)\n   103\t\t}\n   104\t\tif _, err := os.Stat(filepath.Join(root, \".pose/state/technical-debt.json\")); err != nil {\n   105\t\t\tt.Fatalf(\"a persisting run outside a sealed checkout wrote nothing: %v\", err)\n   106\t\t}\n   107\t}\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"go/ast\"\n     5\t\t\"go/parser\"\n     6\t\t\"go/token\"\n     7\t\t\"strings\"\n     8\t\t\"testing\"\n     9\t)\n    10\t\n    11\t// Spec pose-assess-leaves-sealed-checkouts-alone R3: the review plan runs\n    12\t// every assessment tool in the form that writes nothing.\n    13\tfunc TestReviewPlanRunsAssessmentsWithoutPersisting(t *testing.T) {\n    14\t\tscope := ScopeRef{Kind: \"spec\", Slug: \"fixed\"}\n    15\t\tfor _, id := range []string{\"assess-discover\", \"assess-integrate\", \"assess-tech-debt\"} {\n    16\t\t\tfor _, component := range []string{\"\", \"core\"} {\n    17\t\t\t\targs := strings.Join(reviewToolArgs(id, scope, component), \" \")\n    18\t\t\t\tif !strings.Contains(args, \"--no-persist\") {\n    19\t\t\t\t\tt.Fatalf(\"%s (%q) plans a persisting run: %s\", id, component, args)\n    20\t\t\t\t}\n    21\t\t\t}\n    22\t\t}\n    23\t}\n    24\t\n    25\t// Review round 1 (N1): a writer without the guard could still publish into a\n    26\t// sealed checkout. Every function in the assessment files that writes a file\n    27\t// must call the guard first.\n    28\tfunc TestEveryAssessmentWriterRefusesASealedCheckout(t *testing.T) {\n    29\t\tfor _, file := range []string{\"discovery.go\", \"integration.go\", \"techdebt.go\"} {\n    30\t\t\tparsed, err := parser.ParseFile(token.NewFileSet(), file, nil, 0)\n    31\t\t\tif err != nil {\n    32\t\t\t\tt.Fatal(err)\n    33\t\t\t}\n    34\t\t\tfor _, decl := range parsed.Decls {\n    35\t\t\t\tfn, ok := decl.(*ast.FuncDecl)\n    36\t\t\t\tif !ok || fn.Body == nil {\n    37\t\t\t\t\tcontinue\n    38\t\t\t\t}\n    39\t\t\t\twrites, guarded := false, false\n    40\t\t\t\tast.Inspect(fn.Body, func(n ast.Node) bool {\n    41\t\t\t\t\tcall, ok := n.(*ast.CallExpr)\n    42\t\t\t\t\tif !ok {\n    43\t\t\t\t\t\treturn true\n    44\t\t\t\t\t}\n    45\t\t\t\t\tswitch f := call.Fun.(type) {\n    46\t\t\t\t\tcase *ast.SelectorExpr:\n    47\t\t\t\t\t\tif id, ok := f.X.(*ast.Ident); ok && id.Name == \"os\" && (f.Sel.Name == \"WriteFile\" || f.Sel.Name == \"Create\" || f.Sel.Name == \"MkdirAll\" || f.Sel.Name == \"OpenFile\") {\n    48\t\t\t\t\t\t\twrites = true\n    49\t\t\t\t\t\t}\n    50\t\t\t\t\tcase *ast.Ident:\n    51\t\t\t\t\t\tif f.Name == \"refuseSealedAssessmentWrite\" {\n    52\t\t\t\t\t\t\tguarded = true\n    53\t\t\t\t\t\t}\n    54\t\t\t\t\t}\n    55\t\t\t\t\treturn true\n    56\t\t\t\t})\n    57\t\t\t\tif writes && !guarded {\n    58\t\t\t\t\tt.Errorf(\"%s: %s writes without refusing a sealed checkout\", file, fn.Name.Name)\n    59\t\t\t\t}\n    60\t\t\t}\n    61\t\t}\n    62\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/cli/assess.go'","aggregated_output":"     1\tpackage cli\n     2\t\n     3\t// pose assess (spec pose-capability-mechanism): capability assessment as a\n     4\t// POSE-native artifact. Bare `assess` validates structure, evidence and\n     5\t// staleness; `init` scaffolds the 16 default mechanisms; `snapshot` appends\n     6\t// to the append-only history; `diff` compares two snapshots. Scores are\n     7\t// human judgment — nothing here computes one.\n     8\t\n     9\timport (\n    10\t\t\"encoding/json\"\n    11\t\t\"errors\"\n    12\t\t\"fmt\"\n    13\t\t\"io\"\n    14\t\t\"os\"\n    15\t\t\"path/filepath\"\n    16\t\t\"regexp\"\n    17\t\t\"sort\"\n    18\t\t\"strconv\"\n    19\t\t\"strings\"\n    20\t\t\"time\"\n    21\t\n    22\t\t\"github.com/harne8/pose-mcp/internal/pose\"\n    23\t)\n    24\t\n    25\ttype capabilityPolicy struct {\n    26\t\tStaleAfterDays    int `json:\"stale_after_days\"`\n    27\t\tStaleAfterCommits int `json:\"stale_after_commits\"`\n    28\t}\n    29\t\n    30\tfunc defaultCapabilityPolicy() capabilityPolicy {\n    31\t\treturn capabilityPolicy{StaleAfterDays: 30, StaleAfterCommits: 200}\n    32\t}\n    33\t\n    34\tfunc loadCapabilityPolicyIn(files pose.Files, root string) capabilityPolicy {\n    35\t\tpolicy := defaultCapabilityPolicy()\n    36\t\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"policy\", \"capabilities.json\"))\n    37\t\tif err != nil {\n    38\t\t\treturn policy\n    39\t\t}\n    40\t\tvar loaded capabilityPolicy\n    41\t\tif json.Unmarshal(raw, &loaded) == nil {\n    42\t\t\tif loaded.StaleAfterDays > 0 {\n    43\t\t\t\tpolicy.StaleAfterDays = loaded.StaleAfterDays\n    44\t\t\t}\n    45\t\t\tif loaded.StaleAfterCommits > 0 {\n    46\t\t\t\tpolicy.StaleAfterCommits = loaded.StaleAfterCommits\n    47\t\t\t}\n    48\t\t}\n    49\t\treturn policy\n    50\t}\n    51\t\n    52\t// loadCapabilityPolicy reads and writes the filesystem directly; loadCapabilityPolicyIn takes the\n    53\t// operation's files.\n    54\tfunc loadCapabilityPolicy(root string) capabilityPolicy {\n    55\t\treturn loadCapabilityPolicyIn(pose.NativeFiles(), root)\n    56\t}\n    57\t\n    58\t// assessPersists reports whether an assess command may write its records:\n    59\t// not with --no-persist, and never in the sealed checkout of a delegated\n    60\t// review (spec pose-assess-leaves-sealed-checkouts-alone R1, R2).\n    61\tfunc assessPersists(root string, args []string) (bool, string) {\n    62\t\tfor _, a := range args {\n    63\t\t\tif a == \"--no-persist\" {\n    64\t\t\t\treturn false, \"not persisted (--no-persist)\"\n    65\t\t\t}\n    66\t\t}\n    67\t\tif pose.IsSealedCheckout(root) {\n    68\t\t\treturn false, \"not persisted: this is the sealed checkout of a delegated review\"\n    69\t\t}\n    70\t\treturn true, \"\"\n    71\t}\n    72\t\n    73\tfunc cmdAssess(root string, args []string, stdout, stderr io.Writer) int {\n    74\t\tlocale := cliLocaleValue()\n    75\t\tif len(args) > 0 && pose.IsSealedCheckout(root) {\n    76\t\t\tswitch args[0] {\n    77\t\t\tcase \"init\", \"snapshot\", \"request\":\n    78\t\t\t\trender(stdout, stderr).Failure(\"pose assess \" + args[0] + \": writes the capability assessment, which a sealed review checkout does not take\")\n    79\t\t\t\treturn 1\n    80\t\t\t}\n    81\t\t}\n    82\t\tif len(args) > 0 {\n    83\t\t\tswitch args[0] {\n    84\t\t\tcase \"init\":\n    85\t\t\t\treturn assessInit(root, stdout, stderr, locale)\n    86\t\t\tcase \"snapshot\":\n    87\t\t\t\treturn assessSnapshot(root, stdout, stderr, locale)\n    88\t\t\tcase \"diff\":\n    89\t\t\t\treturn assessDiff(root, args[1:], stdout, stderr, locale)\n    90\t\t\tcase \"stale\":\n    91\t\t\t\treturn assessStale(root, args[1:], stdout, stderr, locale)\n    92\t\t\tcase \"request\":\n    93\t\t\t\treturn assessRequest(root, args[1:], stdout, stderr, locale)\n    94\t\t\tcase \"discover\":\n    95\t\t\t\treturn assessDiscover(root, args[1:], stdout, stderr, locale)\n    96\t\t\tcase \"integrate\":\n    97\t\t\t\treturn assessIntegrate(root, args[1:], stdout, stderr, locale)\n    98\t\t\tcase \"tech-debt\":\n    99\t\t\t\treturn assessTechDebt(root, args[1:], stdout, stderr, locale)\n   100\t\t\tcase \"design\":\n   101\t\t\t\treturn assessDesign(root, args[1:], stdout, stderr, locale)\n   102\t\t\tcase \"--json\":\n   103\t\t\t\treturn assessValidate(root, true, stdout, stderr, locale)\n   104\t\t\tdefault:\n   105\t\t\t\tfmt.Fprintln(stderr, cliText(locale,\n   106\t\t\t\t\t\"Usage: pose assess [init|snapshot|diff|stale|request|discover|integrate|tech-debt|design [options]|--json]\",\n   107\t\t\t\t\t\"Uso: pose assess [init|snapshot|diff|stale|request|discover|integrate|tech-debt|design [opções]|--json]\"))\n   108\t\t\t\treturn 2\n   109\t\t\t}\n   110\t\t}\n   111\t\treturn assessValidate(root, false, stdout, stderr, locale)\n   112\t}\n   113\t\n   114\tfunc assessInit(root string, stdout, stderr io.Writer, locale cliLocale) int {\n   115\t\tstore := pose.Store{Root: root}\n   116\t\tpath := store.CapabilityAssessmentPath()\n   117\t\tif _, err := os.Stat(path); err == nil {\n   118\t\t\tfmt.Fprintf(stderr, cliText(locale,\n   119\t\t\t\t\"Error: %s already exists; edit it instead of re-initializing\\n\",\n   120\t\t\t\t\"Erro: %s já existe; edite-o em vez de re-inicializar\\n\"), path)\n   121\t\t\treturn 1\n   122\t\t}\n   123\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n   124\t\t\tfmt.Fprintf(stderr, \"pose assess init: %v\\n\", err)\n   125\t\t\treturn 1\n   126\t\t}\n   127\t\tcontent := capabilityTemplate(assessBaselineCommit(root))\n   128\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n   129\t\t\tfmt.Fprintf(stderr, \"pose assess init: %v\\n\", err)\n   130\t\t\treturn 1\n   131\t\t}\n   132\t\tfmt.Fprintf(stdout, cliText(locale,\n   133\t\t\t\"Capability assessment created: %s (16 default mechanisms; edit scores, targets, evidence and prose)\\n\",\n   134\t\t\t\"Capability assessment criado: %s (16 mecanismos default; edite scores, targets, evidência e prosa)\\n\"), path)\n   135\t\treturn 0\n   136\t}\n   137\t\n   138\t// assessBaselineCommit resolves HEAD for the scaffold; \"0000000\" when git is\n   139\t// unavailable so the artifact still parses and the user edits it in.\n   140\tfunc assessBaselineCommit(root string) string {\n   141\t\tout, err := pose.RawHistoryGit(root, \"rev-parse\", \"--short=12\", \"HEAD\").Output()\n   142\t\tif err != nil {\n   143\t\t\treturn \"0000000\"\n   144\t\t}\n   145\t\tcommit := strings.TrimSpace(string(out))\n   146\t\tif commit == \"\" {\n   147\t\t\treturn \"0000000\"\n   148\t\t}\n   149\t\treturn commit\n   150\t}\n   151\t\n   152\ttype assessReport struct {\n   153\t\tPath        string   `json:\"path\"`\n   154\t\tMechanisms  int      `json:\"mechanisms\"`\n   155\t\tErrors      []string `json:\"errors,omitempty\"`\n   156\t\tWarnings    []string `json:\"warnings,omitempty\"`\n   157\t\tAssessedAt  string   `json:\"assessed_at\"`\n   158\t\tAgeDays     int      `json:\"age_days\"`\n   159\t\tCommitsLag  string   `json:\"commits_since_baseline\"` // number or \"unknown\"\n   160\t\tStaleByDays bool     `json:\"stale_by_days\"`\n   161\t\tStaleByLag  bool     `json:\"stale_by_commits\"`\n   162\t}\n   163\t\n   164\t// runAssessValidation is the shared R6 validation: structure, evidence,\n   165\t// stable-id contract, staleness. It never writes.\n   166\tfunc runAssessValidationIn(files pose.Files, root string) (*assessReport, error) {\n   167\t\tstore := pose.Store{Root: root, FS: files}\n   168\t\tassessment, err := store.LoadCapabilityAssessment()\n   169\t\tif err != nil {\n   170\t\t\treturn nil, err\n   171\t\t}\n   172\t\treport := &assessReport{Path: assessment.Path, Mechanisms: len(assessment.Mechanisms), AssessedAt: assessment.AssessedAt}\n   173\t\treport.Errors = append(report.Errors, store.ValidateCapabilityEvidence(assessment)...)\n   174\t\n   175\t\thistory, err := pose.LoadCapabilityHistoryIn(files, store.CapabilityHistoryPath())\n   176\t\tif err != nil {\n   177\t\t\treturn nil, err\n   178\t\t}\n   179\t\tif effective := pose.EffectiveSnapshots(history); len(effective) > 0 {\n   180\t\t\tlatest := effective[len(effective)-1]\n   181\t\t\tfor _, id := range pose.RenumberedMechanisms(latest, assessment) {\n   182\t\t\t\treport.Errors = append(report.Errors,\n   183\t\t\t\t\tfmt.Sprintf(\"mechanism %q was published in the latest snapshot but is gone from the assessment; retire it (`- retired: true`) instead of removing it\", id))\n   184\t\t\t}\n   185\t\t}\n   186\t\n   187\t\tpolicy := loadCapabilityPolicyIn(files, root)\n   188\t\tif assessed, err := time.Parse(\"2006-01-02\", assessment.AssessedAt); err == nil {\n   189\t\t\treport.AgeDays = int(files.Now().Sub(assessed).Hours() / 24)\n   190\t\t\tif report.AgeDays > policy.StaleAfterDays {\n   191\t\t\t\treport.StaleByDays = true\n   192\t\t\t\treport.Warnings = append(report.Warnings,\n   193\t\t\t\t\tfmt.Sprintf(\"assessment is %d days old (policy: %d); consider reassessing\", report.AgeDays, policy.StaleAfterDays))\n   194\t\t\t}\n   195\t\t}\n   196\t\treport.CommitsLag = \"unknown\"\n   197\t\tif out, err := pose.RawHistoryGit(root, \"rev-list\", \"--count\", assessment.BaselineCommit+\"..HEAD\").Output(); err == nil {\n   198\t\t\tlag := strings.TrimSpace(string(out))\n   199\t\t\treport.CommitsLag = lag\n   200\t\t\tif n, err := strconv.Atoi(lag); err == nil && n > policy.StaleAfterCommits {\n   201\t\t\t\treport.StaleByLag = true\n   202\t\t\t\treport.Warnings = append(report.Warnings,\n   203\t\t\t\t\tfmt.Sprintf(\"baseline_commit is %d commits behind HEAD (policy: %d); consider reassessing\", n, policy.StaleAfterCommits))\n   204\t\t\t}\n   205\t\t}\n   206\t\treturn report, nil\n   207\t}\n   208\t\n   209\t// runAssessValidation reads and writes the filesystem directly; runAssessValidationIn takes the\n   210\t// operation's files.\n   211\tfunc runAssessValidation(root string) (*assessReport, error) {\n   212\t\treturn runAssessValidationIn(pose.NativeFiles(), root)\n   213\t}\n   214\t\n   215\tfunc assessValidate(root string, asJSON bool, stdout, stderr io.Writer, locale cliLocale) int {\n   216\t\treport, err := runAssessValidation(root)\n   217\t\tif err != nil {\n   218\t\t\tfmt.Fprintf(stderr, \"pose assess: %v\\n\", err)\n   219\t\t\treturn 1\n   220\t\t}\n   221\t\tif asJSON {\n   222\t\t\tencoded, _ := json.MarshalIndent(report, \"\", \"  \")\n   223\t\t\tfmt.Fprintln(stdout, string(encoded))\n   224\t\t\tif len(report.Errors) > 0 {\n   225\t\t\t\treturn 1\n   226\t\t\t}\n   227\t\t\treturn 0\n   228\t\t}\n   229\t\tfor _, issue := range report.Errors {\n   230\t\t\tfmt.Fprintf(stdout, \"[ERRO] %s\\n\", issue)\n   231\t\t}\n   232\t\tfor _, warning := range report.Warnings {\n   233\t\t\tfmt.Fprintf(stdout, \"[AVISO] %s\\n\", warning)\n   234\t\t}\n   235\t\tif len(report.Errors) > 0 {\n   236\t\t\tfmt.Fprintf(stdout, cliText(locale,\n   237\t\t\t\t\"Result: FAILURE — %d error(s) in %s\\n\",\n   238\t\t\t\t\"Resultado: FALHA — %d erro(s) em %s\\n\"), len(report.Errors), report.Path)\n   239\t\t\treturn 1\n   240\t\t}\n   241\t\tfmt.Fprintf(stdout, cliText(locale,\n   242\t\t\t\"Result: SUCCESS — %d mechanisms, assessed %s (%d days ago, %s commits since baseline)\\n\",\n   243\t\t\t\"Resultado: SUCESSO — %d mecanismos, avaliado em %s (%d dias atrás, %s commits desde a baseline)\\n\"),\n   244\t\t\treport.Mechanisms, report.AssessedAt, report.AgeDays, report.CommitsLag)\n   245\t\treturn 0\n   246\t}\n   247\t\n   248\tfunc assessSnapshot(root string, stdout, stderr io.Writer, locale cliLocale) int {\n   249\t\treport, err := runAssessValidation(root)\n   250\t\tif err != nil {\n   251\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   252\t\t\treturn 1\n   253\t\t}\n   254\t\tif len(report.Errors) > 0 {\n   255\t\t\tfor _, issue := range report.Errors {\n   256\t\t\t\tfmt.Fprintf(stdout, \"[ERRO] %s\\n\", issue)\n   257\t\t\t}\n   258\t\t\tfmt.Fprintln(stderr, cliText(locale,\n   259\t\t\t\t\"Error: fix validation errors before snapshotting\",\n   260\t\t\t\t\"Erro: corrija os erros de validação antes do snapshot\"))\n   261\t\t\treturn 1\n   262\t\t}\n   263\t\tstore := pose.Store{Root: root}\n   264\t\traw, err := os.ReadFile(store.CapabilityAssessmentPath())\n   265\t\tif err != nil {\n   266\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   267\t\t\treturn 1\n   268\t\t}\n   269\t\tassessment, err := pose.ParseCapabilityAssessment(string(raw))\n   270\t\tif err != nil {\n   271\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   272\t\t\treturn 1\n   273\t\t}\n   274\t\n   275\t\t// R4 (spec pose-capability-assessment-triggers): running a snapshot IS\n   276\t\t// the human/agent's act of reassessment, so it closes every currently\n   277\t\t// pending demand — clear every mechanism's stale marks before hashing,\n   278\t\t// so merely accumulating a trigger (no human review yet) never fools\n   279\t\t// the \"no change since last snapshot\" dedup check below.\n   280\t\tcontent := string(raw)\n   281\t\tvar clearedStale []string\n   282\t\tfor _, mechanism := range assessment.Mechanisms {\n   283\t\t\tif len(mechanism.StaleTriggers) == 0 {\n   284\t\t\t\tcontinue\n   285\t\t\t}\n   286\t\t\tupdated, didClear, cerr := clearStaleMarks(content, mechanism.ID)\n   287\t\t\tif cerr != nil {\n   288\t\t\t\tcontinue\n   289\t\t\t}\n   290\t\t\tif didClear {\n   291\t\t\t\tcontent = updated\n   292\t\t\t\tclearedStale = append(clearedStale, mechanism.ID)\n   293\t\t\t}\n   294\t\t}\n   295\t\n   296\t\tevent := pose.CapabilitySnapshot{\n   297\t\t\tSchema:         pose.CapabilitySnapshotSchema,\n   298\t\t\tAt:             time.Now().UTC().Format(time.RFC3339),\n   299\t\t\tBaselineCommit: assessment.BaselineCommit,\n   300\t\t\tContentHash:    pose.ContentHash12(content),\n   301\t\t\tScores:         assessment.ScoresOf(),\n   302\t\t\tClearedStale:   clearedStale,\n   303\t\t}\n   304\t\thistory, err := pose.LoadCapabilityHistory(store.CapabilityHistoryPath())\n   305\t\tif err != nil {\n   306\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   307\t\t\treturn 1\n   308\t\t}\n   309\t\tif len(clearedStale) > 0 {\n   310\t\t\tif err := os.WriteFile(store.CapabilityAssessmentPath(), []byte(content), 0o644); err != nil {\n   311\t\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   312\t\t\t\treturn 1\n   313\t\t\t}\n   314\t\t\tfmt.Fprintf(stdout, cliText(locale,\n   315\t\t\t\t\"Cleared stale marks: %s\\n\", \"Marcas de staleness limpas: %s\\n\"), strings.Join(clearedStale, \", \"))\n   316\t\t}\n   317\t\tif len(clearedStale) == 0 && len(history) > 0 && history[len(history)-1].ContentHash == event.ContentHash {\n   318\t\t\tfmt.Fprintf(stdout, cliText(locale,\n   319\t\t\t\t\"No change since the last snapshot (content hash %s); nothing appended\\n\",\n   320\t\t\t\t\"Sem mudança desde o último snapshot (content hash %s); nada acrescentado\\n\"), event.ContentHash)\n   321\t\t\treturn 0\n   322\t\t}\n   323\t\tencoded, err := json.Marshal(event)\n   324\t\tif err != nil {\n   325\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   326\t\t\treturn 1\n   327\t\t}\n   328\t\tf, err := os.OpenFile(store.CapabilityHistoryPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)\n   329\t\tif err != nil {\n   330\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   331\t\t\treturn 1\n   332\t\t}\n   333\t\tdefer f.Close()\n   334\t\tif _, err := f.Write(append(encoded, '\\n')); err != nil {\n   335\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   336\t\t\treturn 1\n   337\t\t}\n   338\t\tif hookErr := EmitHook(root, HookEvent{Kind: \"assessment_snapshot\", Commit: assessment.BaselineCommit, At: time.Now().UTC()}); hookErr != nil {\n   339\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", hookErr)\n   340\t\t\treturn 1\n   341\t\t}\n   342\t\tfmt.Fprintf(stdout, cliText(locale,\n   343\t\t\t\"Snapshot appended: %s (%d mechanisms, content hash %s)\\n\",\n   344\t\t\t\"Snapshot acrescentado: %s (%d mecanismos, content hash %s)\\n\"), event.At, len(event.Scores), event.ContentHash)\n   345\t\treturn 0\n   346\t}\n   347\t\n   348\tfunc assessDiff(root string, args []string, stdout, stderr io.Writer, locale cliLocale) int {\n   349\t\tvar fromTS, toTS, against string\n   350\t\tasJSON := false\n   351\t\tfor i := 0; i < len(args); i++ {\n   352\t\t\tswitch args[i] {\n   353\t\t\tcase \"--json\":\n   354\t\t\t\tasJSON = true\n   355\t\t\tcase \"--against\":\n   356\t\t\t\tif i+1 >= len(args) {\n   357\t\t\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --against requires a project id\", \"Erro: --against exige um project id\"))\n   358\t\t\t\t\treturn 2\n   359\t\t\t\t}\n   360\t\t\t\ti++\n   361\t\t\t\tagainst = args[i]\n   362\t\t\tcase \"--from\":\n   363\t\t\t\tif i+1 >= len(args) {\n   364\t\t\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --from requires a timestamp\", \"Erro: --from exige um timestamp\"))\n   365\t\t\t\t\treturn 2\n   366\t\t\t\t}\n   367\t\t\t\ti++\n   368\t\t\t\tfromTS = args[i]\n   369\t\t\tcase \"--to\":\n   370\t\t\t\tif i+1 >= len(args) {\n   371\t\t\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --to requires a timestamp\", \"Erro: --to exige um timestamp\"))\n   372\t\t\t\t\treturn 2\n   373\t\t\t\t}\n   374\t\t\t\ti++\n   375\t\t\t\ttoTS = args[i]\n   376\t\t\tdefault:\n   377\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid argument: %s\\n\", \"Erro: argumento inválido: %s\\n\"), args[i])\n   378\t\t\t\treturn 2\n   379\t\t\t}\n   380\t\t}\n   381\t\tif against != \"\" {\n   382\t\t\treturn assessAgainst(root, against, asJSON, stdout, stderr, locale)\n   383\t\t}\n   384\t\tstore := pose.Store{Root: root}\n   385\t\thistory, err := pose.LoadCapabilityHistory(store.CapabilityHistoryPath())\n   386\t\tif err != nil {\n   387\t\t\tfmt.Fprintf(stderr, \"pose assess diff: %v\\n\", err)\n   388\t\t\treturn 1\n   389\t\t}\n   390\t\teffective := pose.EffectiveSnapshots(history)\n   391\t\tif len(effective) < 2 {\n   392\t\t\tfmt.Fprintln(stderr, cliText(locale,\n   393\t\t\t\t\"Error: need at least two snapshots to diff (run `pose assess snapshot`)\",\n   394\t\t\t\t\"Erro: são necessários ao menos dois snapshots para diff (rode `pose assess snapshot`)\"))\n   395\t\t\treturn 1\n   396\t\t}\n   397\t\tfrom := effective[len(effective)-2]\n   398\t\tto := effective[len(effective)-1]\n   399\t\tif fromTS != \"\" {\n   400\t\t\tif picked := pickSnapshot(effective, fromTS); picked != nil {\n   401\t\t\t\tfrom = *picked\n   402\t\t\t} else {\n   403\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: no snapshot matches --from %s\\n\", \"Erro: nenhum snapshot corresponde a --from %s\\n\"), fromTS)\n   404\t\t\t\treturn 1\n   405\t\t\t}\n   406\t\t}\n   407\t\tif toTS != \"\" {\n   408\t\t\tif picked := pickSnapshot(effective, toTS); picked != nil {\n   409\t\t\t\tto = *picked\n   410\t\t\t} else {\n   411\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: no snapshot matches --to %s\\n\", \"Erro: nenhum snapshot corresponde a --to %s\\n\"), toTS)\n   412\t\t\t\treturn 1\n   413\t\t\t}\n   414\t\t}\n   415\t\tdiff := pose.DiffCapabilitySnapshots(from, to)\n   416\t\tif asJSON {\n   417\t\t\tencoded, _ := json.MarshalIndent(diff, \"\", \"  \")\n   418\t\t\tfmt.Fprintln(stdout, string(encoded))\n   419\t\t\treturn 0\n   420\t\t}\n   421\t\tfmt.Fprintf(stdout, \"%s -> %s\\n\", diff.FromAt, diff.ToAt)\n   422\t\tfor _, entry := range diff.Raised {\n   423\t\t\tfmt.Fprintf(stdout, \"  ^ %s: %d -> %d\\n\", entry.ID, entry.From, entry.To)\n   424\t\t}\n   425\t\tfor _, entry := range diff.Lowered {\n   426\t\t\tfmt.Fprintf(stdout, \"  v %s: %d -> %d\\n\", entry.ID, entry.From, entry.To)\n   427\t\t}\n   428\t\tfor _, id := range diff.Added {\n   429\t\t\tfmt.Fprintf(stdout, \"  + %s\\n\", id)\n   430\t\t}\n   431\t\tfor _, id := range diff.Removed {\n   432\t\t\tfmt.Fprintf(stdout, \"  - %s\\n\", id)\n   433\t\t}\n   434\t\tfor _, id := range diff.Retired {\n   435\t\t\tfmt.Fprintf(stdout, \"  r %s (retired)\\n\", id)\n   436\t\t}\n   437\t\tfmt.Fprintf(stdout, cliText(locale, \"  = %d stable\\n\", \"  = %d estáveis\\n\"), len(diff.Stable))\n   438\t\treturn 0\n   439\t}\n   440\t\n   441\tfunc pickSnapshot(events []pose.CapabilitySnapshot, prefix string) *pose.CapabilitySnapshot {\n   442\t\tfor i := len(events) - 1; i >= 0; i-- {\n   443\t\t\tif strings.HasPrefix(events[i].At, prefix) {\n   444\t\t\t\tevent := events[i]\n   445\t\t\t\treturn &event\n   446\t\t\t}\n   447\t\t}\n   448\t\treturn nil\n   449\t}\n   450\t\n   451\t// capabilityTemplate scaffolds the method's 16 default mechanisms. Scores\n   452\t// start at 0 with a modest default target — the point of the artifact is\n   453\t// that a human assesses; the scaffold only provides stable ids.\n   454\tfunc capabilityTemplate(baselineCommit string) string {\n   455\t\ttype mech struct{ id, title string }\n   456\t\tdefaults := []mech{\n   457\t\t\t{\"install-upgrade-runtime\", \"Install, upgrade and local-first runtime\"},\n   458\t\t\t{\"spec-lifecycle-closeout\", \"Spec lifecycle and closeout\"},\n   459\t\t\t{\"task-routing-workflows-skills\", \"Task routing, workflows, rules and skills\"},\n   460\t\t\t{\"dependencies-readiness-roadmaps\", \"Dependencies, readiness and roadmaps\"},\n   461\t\t\t{\"validation-structural-integrity\", \"Validation matrix and structural checks\"},\n   462\t\t\t{\"evidence-history-insights\", \"Evidence, history and insights\"},\n   463\t\t\t{\"followups-recurrence\", \"Follow-ups and recurrence\"},\n   464\t\t\t{\"operational-knowledge\", \"Knowledge governance\"},\n   465\t\t\t{\"mcp-agent-interop\", \"MCP and agent interoperability\"},\n   466\t\t\t{\"policy-identity-audit\", \"Policy, identity and audit\"},\n   467\t\t\t{\"ci-release-supply-chain\", \"CI, release and supply-chain trust\"},\n   468\t\t\t{\"import-adoption-interop\", \"Import and adoption interoperability\"},\n   469\t\t\t{\"metrics-observability\", \"Metrics and observability\"},\n   470\t\t\t{\"docs-localization-diagnostics\", \"Documentation, localization and diagnostics\"},\n   471\t\t\t{\"extensibility-ecosystem\", \"Extensibility and ecosystem\"},\n   472\t\t\t{\"multi-repo-enterprise\", \"Multi-repository and enterprise operation\"},\n   473\t\t}\n   474\t\tvar b strings.Builder\n   475\t\tfmt.Fprintf(&b, \"---\\nschema_version: %d\\nassessed_at: %s\\nbaseline_commit: %s\\nmethod: describe how this assessment was measured\\n---\\n\\n\",\n   476\t\t\tpose.CapabilityAssessmentSchema, time.Now().UTC().Format(\"2006-01-02\"), baselineCommit)\n   477\t\tb.WriteString(\"# Capability assessment\\n\\n\")\n   478\t\tb.WriteString(\"Scores are human judgment on a 0-5 scale; the target is not always 5.\\n\")\n   479\t\tb.WriteString(\"Evidence uses typed references (spec:/report:/adr:/knowledge:/doc:/commit:/check:/url:).\\n\")\n   480\t\tfor _, m := range defaults {\n   481\t\t\tfmt.Fprintf(&b, \"\\n## Mechanism: %s\\n- title: %s\\n- score: 0\\n- target: 3\\n- evidence:\\n- gaps:\\n\\nDescribe the current state and why the score holds.\\n\", m.id, m.title)\n   482\t\t}\n   483\t\treturn b.String()\n   484\t}\n   485\t\n   486\t// assessAgainst compares the local score vector with another project's,\n   487\t// resolved through the same authorization allowlist as the cross-repository\n   488\t// portfolio projection (self + scanned projects dir + POSE_PROJECT_ROOTS).\n   489\t// Scores and targets only — prose never crosses roots.\n   490\tfunc assessAgainst(root, projectID string, asJSON bool, stdout, stderr io.Writer, locale cliLocale) int {\n   491\t\tknown, err := discoverAuthorizedProjects(root, \"\")\n   492\t\tif err != nil {\n   493\t\t\tfmt.Fprintf(stderr, \"pose assess diff --against: %v\\n\", err)\n   494\t\t\treturn 1\n   495\t\t}\n   496\t\totherRoot, authorized := known[projectID]\n   497\t\tif !authorized {\n   498\t\t\tfmt.Fprintf(stderr, cliText(locale,\n   499\t\t\t\t\"Error: project %q is not an authorized root (self, HARNE8_PROJECTS_DIR scan, or POSE_PROJECT_ROOTS)\\n\",\n   500\t\t\t\t\"Erro: projeto %q não é um root autorizado (self, scan de HARNE8_PROJECTS_DIR, ou POSE_PROJECT_ROOTS)\\n\"), projectID)\n   501\t\t\treturn 1\n   502\t\t}\n   503\t\tlocal, err := pose.Store{Root: root}.LoadCapabilityAssessment()\n   504\t\tif err != nil {\n   505\t\t\tfmt.Fprintf(stderr, \"pose assess diff --against: local: %v\\n\", err)\n   506\t\t\treturn 1\n   507\t\t}\n   508\t\tother, err := pose.Store{Root: otherRoot}.LoadCapabilityAssessment()\n   509\t\tif err != nil {\n   510\t\t\tfmt.Fprintf(stderr, \"pose assess diff --against: %s: %v\\n\", projectID, err)\n   511\t\t\treturn 1\n   512\t\t}\n   513\t\ttype cell struct {\n   514\t\t\tScore  int  `json:\"score\"`\n   515\t\t\tTarget int  `json:\"target\"`\n   516\t\t\tHas    bool `json:\"present\"`\n   517\t\t}\n   518\t\tmatrix := map[string]map[string]cell{}\n   519\t\tadd := func(project string, a *pose.CapabilityAssessment) {\n   520\t\t\tfor _, m := range a.Mechanisms {\n   521\t\t\t\tif m.Retired {\n   522\t\t\t\t\tcontinue\n   523\t\t\t\t}\n   524\t\t\t\tif matrix[m.ID] == nil {\n   525\t\t\t\t\tmatrix[m.ID] = map[string]cell{}\n   526\t\t\t\t}\n   527\t\t\t\tmatrix[m.ID][project] = cell{Score: m.Score, Target: m.Target, Has: true}\n   528\t\t\t}\n   529\t\t}\n   530\t\tadd(\"local\", local)\n   531\t\tadd(projectID, other)\n   532\t\tif asJSON {\n   533\t\t\tencoded, _ := json.MarshalIndent(map[string]any{\"against\": projectID, \"matrix\": matrix}, \"\", \"  \")\n   534\t\t\tfmt.Fprintln(stdout, string(encoded))\n   535\t\t\treturn 0\n   536\t\t}\n   537\t\tvar ids []string\n   538\t\tfor id := range matrix {\n   539\t\t\tids = append(ids, id)\n   540\t\t}\n   541\t\tsort.Strings(ids)\n   542\t\tfmt.Fprintf(stdout, \"%-36s %-12s %s\\n\", \"mechanism\", \"local\", projectID)\n   543\t\tfor _, id := range ids {\n   544\t\t\trow := matrix[id]\n   545\t\t\tfmt.Fprintf(stdout, \"%-36s %-12s %s\\n\", id, formatCell(row[\"local\"].Score, row[\"local\"].Target, row[\"local\"].Has), formatCell(row[projectID].Score, row[projectID].Target, row[projectID].Has))\n   546\t\t}\n   547\t\treturn 0\n   548\t}\n   549\t\n   550\tfunc formatCell(score, target int, present bool) string {\n   551\t\tif !present {\n   552\t\t\treturn \"-\"\n   553\t\t}\n   554\t\treturn fmt.Sprintf(\"%d/%d\", score, target)\n   555\t}\n   556\t\n   557\t// mergeWithPersistedComponentStates completes a scoped discovery result with\n   558\t// the components this run did not scan, read back from their persisted state.\n   559\t// Freshly scanned components win; the rest keep their last known state so the\n   560\t// consolidated view stays repository-wide. Ordering is by slug so the generated\n   561\t// artifacts stay deterministic.\n   562\tfunc mergeWithPersistedComponentStates(store pose.Store, scanned []*pose.ComponentDiscoveryState) []*pose.ComponentDiscoveryState {\n   563\t\tbySlug := make(map[string]*pose.ComponentDiscoveryState, len(scanned))\n   564\t\tfor _, state := range scanned {\n   565\t\t\tbySlug[state.ComponentSlug] = state\n   566\t\t}\n   567\t\tentries, err := os.ReadDir(store.ComponentStateDir())\n   568\t\tif err != nil {\n   569\t\t\tif !os.IsNotExist(err) {\n   570\t\t\t\t// The persisted states are there and cannot be listed: say so in the\n   571\t\t\t\t// consolidation instead of publishing the fresh components as the repository.\n   572\t\t\t\tbySlug[\"(persisted-states)\"] = unreadableComponentState(\"(persisted-states)\", store.ComponentStateDir(), err)\n   573\t\t\t\treturn sortedComponentStates(bySlug)\n   574\t\t\t}\n   575\t\t\treturn scanned\n   576\t\t}\n   577\t\tfor _, entry := range entries {\n   578\t\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n   579\t\t\t\tcontinue\n   580\t\t\t}\n   581\t\t\tslug := strings.TrimSuffix(entry.Name(), \".json\")\n   582\t\t\tif _, fresh := bySlug[slug]; fresh {\n   583\t\t\t\tcontinue\n   584\t\t\t}\n   585\t\t\tstate, err := store.LoadComponentState(slug)\n   586\t\t\tif err != nil || state == nil {\n   587\t\t\t\t// A persisted state that cannot be read is a component the consolidation\n   588\t\t\t\t// cannot describe, not one that is not there; no metrics are invented for it.\n   589\t\t\t\tbySlug[slug] = unreadableComponentState(slug, filepath.Join(store.ComponentStateDir(), entry.Name()), err)\n   590\t\t\t\tcontinue\n   591\t\t\t}\n   592\t\t\tbySlug[slug] = state\n   593\t\t}\n   594\t\treturn sortedComponentStates(bySlug)\n   595\t}\n   596\t\n   597\t// unreadableComponentState stands for a persisted component state that could not be read: zero\n   598\t// metrics, a loss naming the file, and a status that says why.\n   599\tfunc unreadableComponentState(slug, path string, cause error) *pose.ComponentDiscoveryState {\n   600\t\t// The kind of loss is the nature of the failure, and the detail is the engine's own\n   601\t\t// words, never the content of the file.\n   602\t\tkind, detail := pose.LossReadError, \"the persisted state could not be read\"\n   603\t\tswitch {\n   604\t\tcase errors.Is(cause, pose.ErrComponentStateParse):\n   605\t\t\tkind, detail = pose.LossParseError, \"the persisted state is not valid JSON\"\n   606\t\tcase errors.Is(cause, pose.ErrComponentStateUnsupported):\n   607\t\t\tkind, detail = pose.LossUnsupported, \"the persisted state has a schema_version this engine does not read\"\n   608\t\tcase errors.Is(cause, pose.ErrComponentStateInvalid):\n   609\t\t\tkind, detail = pose.LossInvalid, \"the persisted state names no component\"\n   610\t\tcase cause != nil:\n   611\t\t\tdetail = cause.Error()\n   612\t\t}\n   613\t\treturn &pose.ComponentDiscoveryState{ComponentSlug: slug, Path: slug, Status: \"unreadable\",\n   614\t\t\tCoverage: pose.SourceCoverage{Losses: []pose.SourceLoss{{Producer: \"component-state\", Artifact: filepath.ToSlash(path), Kind: kind, Detail: detail}}}}\n   615\t}\n   616\t\n   617\tfunc sortedComponentStates(bySlug map[string]*pose.ComponentDiscoveryState) []*pose.ComponentDiscoveryState {\n   618\t\tslugs := make([]string, 0, len(bySlug))\n   619\t\tfor slug := range bySlug {\n   620\t\t\tslugs = append(slugs, slug)\n   621\t\t}\n   622\t\tsort.Strings(slugs)\n   623\t\tmerged := make([]*pose.ComponentDiscoveryState, 0, len(slugs))\n   624\t\tfor _, slug := range slugs {\n   625\t\t\tmerged = append(merged, bySlug[slug])\n   626\t\t}\n   627\t\treturn merged\n   628\t}\n   629\t\n   630\tfunc assessDiscover(root string, args []string, stdout, stderr io.Writer, locale cliLocale) int {\n   631\t\tvar targetComp string\n   632\t\tvar asJSON bool\n   633\t\tvar updateState bool\n   634\t\t// --if-stale reuses a component's assessment while its committed\n   635\t\t// content, the engine and the matrix are unchanged (spec\n   636\t\t// pose-adaptive-assessment-freshness).\n   637\t\tvar ifStale bool\n   638\t\tdecisions := map[string]string{}\n   639\t\n   640\t\tfor i := 0; i < len(args); i++ {\n   641\t\t\tswitch args[i] {\n   642\t\t\tcase \"--component\":\n   643\t\t\t\tif i+1 < len(args) {\n   644\t\t\t\t\ttargetComp = args[i+1]\n   645\t\t\t\t\ti++\n   646\t\t\t\t}\n   647\t\t\tcase \"--json\":\n   648\t\t\t\tasJSON = true\n   649\t\t\tcase \"--update-state\":\n   650\t\t\t\tupdateState = true\n   651\t\t\tcase \"--if-stale\":\n   652\t\t\t\tifStale = true\n   653\t\t\t}\n   654\t\t}\n   655\t\tpersist, persistNote := assessPersists(root, args)\n   656\t\n   657\t\tstore := pose.Store{Root: root}\n   658\t\tvar targets []string\n   659\t\n   660\t\tif targetComp != \"\" {\n   661\t\t\ttargets = []string{targetComp}\n   662\t\t} else {\n   663\t\t\t// Dynamically discover components via POSE module metadata or manifest inspection\n   664\t\t\ttargets = store.FindComponentDirectories()\n   665\t\t\tif len(targets) == 0 {\n   666\t\t\t\ttargets = []string{\".\"}\n   667\t\t\t}\n   668\t\t}\n   669\t\n   670\t\tvar results []*pose.ComponentDiscoveryState\n   671\t\tfor _, t := range targets {\n   672\t\t\tif ifStale {\n   673\t\t\t\tfresh := store.ComponentAssessmentFreshness(t)\n   674\t\t\t\tif fresh.State == pose.AssessmentFresh {\n   675\t\t\t\t\tif reused, err := store.LoadComponentState(fresh.Component); err == nil && reused != nil {\n   676\t\t\t\t\t\tdecisions[reused.ComponentSlug] = \"reused (content, engine and matrix unchanged)\"\n   677\t\t\t\t\t\tresults = append(results, reused)\n   678\t\t\t\t\t\tcontinue\n   679\t\t\t\t\t}\n   680\t\t\t\t}\n   681\t\t\t\tdecisions[fresh.Component] = \"refreshed (\" + fresh.State + \": \" + strings.Join(fresh.Reasons, \"; \") + \")\"\n   682\t\t\t}\n   683\t\t\tstate, err := store.DiscoverComponent(t)\n   684\t\t\tif err != nil {\n   685\t\t\t\tfmt.Fprintf(stderr, \"pose assess discover %s: %v\\n\", t, err)\n   686\t\t\t\treturn 1\n   687\t\t\t}\n   688\t\t\tif persist {\n   689\t\t\t\tif err := store.SaveComponentState(state); err != nil {\n   690\t\t\t\t\tfmt.Fprintf(stderr, \"pose assess discover save %s: %v\\n\", t, err)\n   691\t\t\t\t\treturn 1\n   692\t\t\t\t}\n   693\t\t\t}\n   694\t\t\tresults = append(results, state)\n   695\t\t}\n   696\t\n   697\t\t// The consolidated view is repository-wide even when discovery is scoped to\n   698\t\t// one component. Rebuilding it from the scanned subset alone used to drop\n   699\t\t// every other component from README.md/consolidated.md while leaving its\n   700\t\t// per-component report and state file orphaned on disk.\n   701\t\tconsolidated := results\n   702\t\tif targetComp != \"\" {\n   703\t\t\tconsolidated = mergeWithPersistedComponentStates(store, results)\n   704\t\t}\n   705\t\tif persist {\n   706\t\t\tif err := store.GenerateConsolidatedAssessment(consolidated); err != nil {\n   707\t\t\t\tfmt.Fprintf(stderr, \"pose assess discover consolidate: %v\\n\", err)\n   708\t\t\t\treturn 1\n   709\t\t\t}\n   710\t\t}\n   711\t\n   712\t\tif updateState && persist {\n   713\t\t\t// The state is built from what this run observed: a persisted record of a component\n   714\t\t\t// that is no longer there is not part of it. What was recorded and cannot be read is\n   715\t\t\t// carried as a loss, so the state does not read as a certified total.\n   716\t\t\tstateInput := append([]*pose.ComponentDiscoveryState{}, results...)\n   717\t\t\tif targetComp != \"\" {\n   718\t\t\t\tfor _, c := range consolidated {\n   719\t\t\t\t\tif c.Status == \"unreadable\" {\n   720\t\t\t\t\t\tstateInput = append(stateInput, c)\n   721\t\t\t\t\t}\n   722\t\t\t\t}\n   723\t\t\t}\n   724\t\t\tif err := updateProjectStateArchitecture(root, stateInput); err != nil {\n   725\t\t\t\tfmt.Fprintf(stderr, \"pose assess discover update-state: %v\\n\", err)\n   726\t\t\t\treturn 1\n   727\t\t\t}\n   728\t\t}\n   729\t\n   730\t\tif !persist {\n   731\t\t\trender(stdout, stderr).Hint(\"pose assess: \" + persistNote)\n   732\t\t}\n   733\t\tif asJSON {\n   734\t\t\tenc, _ := json.MarshalIndent(results, \"\", \"  \")\n   735\t\t\tfmt.Fprintln(stdout, string(enc))\n   736\t\t\treturn 0\n   737\t\t}\n   738\t\n   739\t\tfmt.Fprintf(stdout, \"Discovered %d components:\\n\", len(results))\n   740\t\tfor _, res := range results {\n   741\t\t\tfmt.Fprintf(stdout, \"  - %-30s LOC: %d (prod) / %d (test) | Debt TODOs: %d, FIXMEs: %d\\n\",\n   742\t\t\t\tres.ComponentSlug, res.Metrics.LOCProduction, res.Metrics.LOCTests, res.TechnicalDebt.TODOs, res.TechnicalDebt.FIXMEs)\n   743\t\t\tif res.ScanIncomplete() {\n   744\t\t\t\trender(stdout, stderr).Field(\"assess.scan.\"+res.ComponentSlug, \"incomplete: \"+res.Coverage.Describe(\"\")+\"; the counts above are a floor\")\n   745\t\t\t}\n   746\t\t\tif decision, ok := decisions[res.ComponentSlug]; ok {\n   747\t\t\t\trender(stdout, stderr).Field(\"assess.freshness.\"+res.ComponentSlug, decision)\n   748\t\t\t}\n   749\t\t}\n   750\t\treturn 0\n   751\t}\n   752\t\n   753\tfunc updateProjectStateArchitecture(root string, current []*pose.ComponentDiscoveryState) error {\n   754\t\tstatePath := filepath.Join(root, \".pose\", \"state\", \"project-state.md\")\n   755\t\traw, err := os.ReadFile(statePath)\n   756\t\tif err != nil {\n   757\t\t\treturn err\n   758\t\t}\n   759\t\n   760\t\tcontent := string(raw)\n   761\t\tif !strings.Contains(content, \"## Arquitetura\") {\n   762\t\t\treturn fmt.Errorf(\"project-state.md has no Arquitetura section\")\n   763\t\t}\n   764\t\n   765\t\tvar totalProd, totalTests, verified int\n   766\t\tvar todos, fixmes, panics, stubs int\n   767\t\tvar completeness float64\n   768\t\tlanguages := make(map[string]bool)\n   769\t\tcomponents, partial, unreadable := 0, 0, 0\n   770\t\tif current == nil {\n   771\t\t\tentries, dirErr := os.ReadDir(filepath.Join(root, \".pose\", \"state\", \"components\"))\n   772\t\t\tif dirErr != nil && !os.IsNotExist(dirErr) {\n   773\t\t\t\tunreadable++\n   774\t\t\t}\n   775\t\t\tfor _, entry := range entries {\n   776\t\t\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") || entry.Name() == \"..json\" {\n   777\t\t\t\t\tcontinue\n   778\t\t\t\t}\n   779\t\t\t\t// The loader that validates a state is the one that reads it here too: a record\n   780\t\t\t\t// of a format this engine does not read, or that names no component, is not a\n   781\t\t\t\t// component with zero debt.\n   782\t\t\t\tstate, loadErr := (pose.Store{Root: root}).LoadComponentState(strings.TrimSuffix(entry.Name(), \".json\"))\n   783\t\t\t\tif loadErr != nil || state == nil {\n   784\t\t\t\t\tunreadable++\n   785\t\t\t\t\tcontinue\n   786\t\t\t\t}\n   787\t\t\t\tcurrent = append(current, state)\n   788\t\t\t}\n   789\t\t}\n   790\t\tfor _, state := range current {\n   791\t\t\tif state == nil || state.ComponentSlug == \"\" {\n   792\t\t\t\tcontinue\n   793\t\t\t}\n   794\t\t\tcomponents++\n   795\t\t\tif state.ScanIncomplete() {\n   796\t\t\t\tpartial++\n   797\t\t\t}\n   798\t\t\ttotalProd += state.Metrics.LOCProduction\n   799\t\t\ttotalTests += state.Metrics.LOCTests\n   800\t\t\ttodos += state.TechnicalDebt.TODOs\n   801\t\t\tfixmes += state.TechnicalDebt.FIXMEs\n   802\t\t\tpanics += state.TechnicalDebt.Panics\n   803\t\t\tstubs += state.TechnicalDebt.Stubs\n   804\t\t\tcompleteness += state.CompletenessScore\n   805\t\t\tif state.Status == \"verified\" {\n   806\t\t\t\tverified++\n   807\t\t\t}\n   808\t\t\tfor _, language := range state.Metrics.Languages {\n   809\t\t\t\tlanguages[language] = true\n   810\t\t\t}\n   811\t\t}\n   812\t\torderedLanguages := make([]string, 0, len(languages))\n   813\t\tfor language := range languages {\n   814\t\t\torderedLanguages = append(orderedLanguages, language)\n   815\t\t}\n   816\t\tsort.Strings(orderedLanguages)\n   817\t\tif len(orderedLanguages) == 0 {\n   818\t\t\torderedLanguages = []string{\"n/a\"}\n   819\t\t}\n   820\t\taverage := 0.0\n   821\t\tif components > 0 {\n   822\t\t\taverage = completeness / float64(components) * 100\n   823\t\t}\n   824\t\tcomponentsLine := fmt.Sprintf(\"- componentes: total=%d verificados=%d completude=%.1f%%\", components, verified, average)\n   825\t\tif partial > 0 || unreadable > 0 {\n   826\t\t\tcomponentsLine += fmt.Sprintf(\" (piso: %d com varredura incompleta, %d estados ilegíveis; não certificado)\", partial, unreadable)\n   827\t\t}\n   828\t\tlines := []string{\n   829\t\t\tcomponentsLine,\n   830\t\t\tfmt.Sprintf(\"- linhas_de_codigo: producao=%d testes=%d total=%d\", totalProd, totalTests, totalProd+totalTests),\n   831\t\t\t\"- linguagens: \" + strings.Join(orderedLanguages, \", \"),\n   832\t\t\tfmt.Sprintf(\"- saude_de_codigo: TODOs=%d FIXMEs=%d panics=%d stubs=%d\", todos, fixmes, panics, stubs),\n   833\t\t}\n   834\t\tif integrationRaw, readErr := os.ReadFile(filepath.Join(root, \".pose\", \"state\", \"integrations.json\")); readErr == nil {\n   835\t\t\tvar matrix pose.IntegrationMatrix\n   836\t\t\tif json.Unmarshal(integrationRaw, &matrix) == nil {\n   837\t\t\t\tlines = append(lines, fmt.Sprintf(\"- integracoes: contratos=%d ativos=%d gaps=%d\", matrix.Summary.TotalIntegrations, matrix.Summary.ActiveContracts, matrix.Summary.IdentifiedGaps))\n   838\t\t\t}\n   839\t\t}\n   840\t\tif debtRaw, readErr := os.ReadFile(filepath.Join(root, \".pose\", \"state\", \"technical-debt.json\")); readErr == nil {\n   841\t\t\tvar report pose.TechDebtReportState\n   842\t\t\tif json.Unmarshal(debtRaw, &report) == nil {\n   843\t\t\t\tdebtLine := fmt.Sprintf(\"- divida_tecnica: total=%d coberta=%d descoberta=%d\", report.Summary.TotalMarkers, report.Summary.CoveredCount, report.Summary.UncoveredCount)\n   844\t\t\t\tif !report.Complete && len(report.Coverage.Losses) > 0 {\n   845\t\t\t\t\tdebtLine += \" (piso: relatório de dívida incompleto — \" + report.Coverage.Describe(\"\") + \"; não certificado)\"\n   846\t\t\t\t}\n   847\t\t\t\tlines = append(lines, debtLine)\n   848\t\t\t}\n   849\t\t}\n   850\t\tlines = append(lines, \"- ultimos_assessments: ver artefatos em .pose/assessments/ e .pose/state/\")\n   851\t\tbody := strings.Join(lines, \"\\n\")\n   852\t\tstatus := \"active\"\n   853\t\tif components == 0 {\n   854\t\t\tstatus = \"unavailable\"\n   855\t\t}\n   856\t\tsection := fmt.Sprintf(\"## Arquitetura\\n<!-- state:derived hash:%s status:%s -->\\n\\n%s\", pose.ContentHash12(body), status, body)\n   857\t\tarchRegex := regexp.MustCompile(`(?s)## Arquitetura\\n<!-- state:derived [^\\n]+ -->\\n.*?(\\n\\n## |\\z)`)\n   858\t\tif !archRegex.MatchString(content) {\n   859\t\t\treturn fmt.Errorf(\"project-state.md Arquitetura section is malformed\")\n   860\t\t}\n   861\t\tupdated := archRegex.ReplaceAllString(content, section+\"$1\")\n   862\t\t// Published over the state read above: a curated edit made while the\n   863\t\t// section was rendered is a conflict, never lost (spec\n   864\t\t// pose-writer-coordination-and-atomic-publication R2/R7).\n   865\t\treturn pose.PublishFile(statePath, []byte(updated), 0o644, pose.PublishAuthoritative, pose.ExpectBytes(raw, true))\n   866\t}\n   867\t\n   868\tfunc assessIntegrate(root string, args []string, stdout, stderr io.Writer, locale cliLocale) int {\n   869\t\tvar asJSON bool\n   870\t\tvar updateState bool\n   871\t\n   872\t\tfor _, a := range args {\n   873\t\t\tswitch a {\n   874\t\t\tcase \"--json\":\n   875\t\t\t\tasJSON = true\n   876\t\t\tcase \"--update-state\":\n   877\t\t\t\tupdateState = true\n   878\t\t\t}\n   879\t\t}\n   880\t\n   881\t\tstore := pose.Store{Root: root}\n   882\t\tmatrix, err := store.AnalyzeIntegrations()\n   883\t\tif err != nil {\n   884\t\t\tfmt.Fprintf(stderr, \"pose assess integrate: %v\\n\", err)\n   885\t\t\treturn 1\n   886\t\t}\n   887\t\n   888\t\tpersist, persistNote := assessPersists(root, args)\n   889\t\tif persist {\n   890\t\t\tif err := store.SaveIntegrationMatrix(matrix); err != nil {\n   891\t\t\t\tfmt.Fprintf(stderr, \"pose assess integrate save: %v\\n\", err)\n   892\t\t\t\treturn 1\n   893\t\t\t}\n   894\t\t} else {\n   895\t\t\trender(stdout, stderr).Hint(\"pose assess: \" + persistNote)\n   896\t\t}\n   897\t\n   898\t\tif updateState && persist {\n   899\t\t\tif err := updateProjectStateArchitecture(root, nil); err != nil {\n   900\t\t\t\tfmt.Fprintf(stderr, \"pose assess integrate update-state: %v\\n\", err)\n   901\t\t\t\treturn 1\n   902\t\t\t}\n   903\t\t}\n   904\t\n   905\t\tif asJSON {\n   906\t\t\tenc, _ := json.MarshalIndent(matrix, \"\", \"  \")\n   907\t\t\tfmt.Fprintln(stdout, string(enc))\n   908\t\t\treturn 0\n   909\t\t}\n   910\t\n   911\t\tfmt.Fprintf(stdout, \"Integration Assessment Results:\\n\")\n   912\t\tfmt.Fprintf(stdout, \"  - Contracts Evaluated: %d\\n\", matrix.Summary.TotalIntegrations)\n   913\t\tfmt.Fprintf(stdout, \"  - Active Contracts: %d\\n\", matrix.Summary.ActiveContracts)\n   914\t\tfmt.Fprintf(stdout, \"  - Integration Gaps Identified: %d\\n\\n\", matrix.Summary.IdentifiedGaps)\n   915\t\n   916\t\tfor _, g := range matrix.Gaps {\n   917\t\t\tfmt.Fprintf(stdout, \"  ⚠️ [%s] %s (%s)\\n     Provider: %s | Consumer: %s\\n     %s\\n\\n\",\n   918\t\t\t\tg.GapID, g.Title, g.Severity, g.Provider, g.Consumer, g.Description)\n   919\t\t}\n   920\t\n   921\t\tif persist {\n   922\t\t\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/integrations.md and .pose/state/integrations.json\\n\")\n   923\t\t}\n   924\t\treturn 0\n   925\t}\n   926\t\n   927\tfunc assessTechDebt(root string, args []string, stdout, stderr io.Writer, locale cliLocale) int {\n   928\t\tvar asJSON bool\n   929\t\tvar updateState bool\n   930\t\n   931\t\tfor _, a := range args {\n   932\t\t\tswitch a {\n   933\t\t\tcase \"--json\":\n   934\t\t\t\tasJSON = true\n   935\t\t\tcase \"--update-state\":\n   936\t\t\t\tupdateState = true\n   937\t\t\t}\n   938\t\t}\n   939\t\n   940\t\tstore := pose.Store{Root: root}\n   941\t\treport, err := store.AnalyzeTechDebt()\n   942\t\tif err != nil {\n   943\t\t\tfmt.Fprintf(stderr, \"pose assess tech-debt: %v\\n\", err)\n   944\t\t\treturn 1\n   945\t\t}\n   946\t\n   947\t\tpersist, persistNote := assessPersists(root, args)\n   948\t\tif persist {\n   949\t\t\tif err := store.SaveTechDebtReport(report); err != nil {\n   950\t\t\t\tfmt.Fprintf(stderr, \"pose assess tech-debt save: %v\\n\", err)\n   951\t\t\t\treturn 1\n   952\t\t\t}\n   953\t\t} else {\n   954\t\t\trender(stdout, stderr).Hint(\"pose assess: \" + persistNote)\n   955\t\t}\n   956\t\n   957\t\tif updateState && persist {\n   958\t\t\tif err := updateProjectStateArchitecture(root, nil); err != nil {\n   959\t\t\t\tfmt.Fprintf(stderr, \"pose assess tech-debt update-state: %v\\n\", err)\n   960\t\t\t\treturn 1\n   961\t\t\t}\n   962\t\t}\n   963\t\n   964\t\tif asJSON {\n   965\t\t\tenc, _ := json.MarshalIndent(report, \"\", \"  \")\n   966\t\t\tfmt.Fprintln(stdout, string(enc))\n   967\t\t\treturn 0\n   968\t\t}\n   969\t\n   970\t\tfmt.Fprintf(stdout, \"Technical Debt Assessment Results:\\n\")\n   971\t\tfmt.Fprintf(stdout, \"  - Total Debt Markers: %d (TODOs: %d, FIXMEs: %d, Panics: %d, Stubs: %d)\\n\",\n   972\t\t\treport.Summary.TotalMarkers, report.Summary.TODOs, report.Summary.FIXMEs, report.Summary.Panics, report.Summary.Stubs)\n   973\t\tfmt.Fprintf(stdout, \"  - Uncovered Debt Items: %d\\n\", report.Summary.UncoveredCount)\n   974\t\tfmt.Fprintf(stdout, \"  - Recommendations: %d Follow-ups, %d Specs, %d Roadmaps\\n\\n\",\n   975\t\t\treport.Summary.RecommendedFollowups, report.Summary.RecommendedSpecs, report.Summary.RecommendedRoadmaps)\n   976\t\n   977\t\tscope := render(stdout, stderr)\n   978\t\tif report.Complete {\n   979\t\t\tscope.Field(\"techdebt.scan\", fmt.Sprintf(\"%d source file(s) scanned, none unreadable\", report.ScannedFiles))\n   980\t\t} else {\n   981\t\t\tscope.Field(\"techdebt.scan\", fmt.Sprintf(\"INCOMPLETE — %d source file(s) scanned; %s; zero markers does not prove the unread files have none\", report.ScannedFiles, report.Coverage.Describe(\"\")))\n   982\t\t}\n   983\t\tfor _, exclusion := range report.Coverage.Exclusions {\n   984\t\t\tscope.Field(\"techdebt.excluded\", fmt.Sprintf(\"%s: %d file(s) — %s\", exclusion.Pattern, exclusion.Count, exclusion.Reason))\n   985\t\t}\n   986\t\tif persist {\n   987\t\t\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/technical-debt.md and .pose/state/technical-debt.json\\n\")\n   988\t\t}\n   989\t\treturn 0\n   990\t}\n","exit_code":0,"status":"completed"}}
