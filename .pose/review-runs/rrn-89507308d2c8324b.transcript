{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/discovery.go | sed -n '840,890p'; nl -ba pose-mcp/internal/pose/integration.go | sed -n '400,520p'; nl -ba pose-mcp/internal/pose/techdebt.go | sed -n '428,515p'\"","aggregated_output":"   840\t\t}\n   841\t\tmd += \"\\n---\\n\\n## 3. Topologia Observada\\n\\n\"\n   842\t\tif len(states) == 0 {\n   843\t\t\tmd += \"Nenhum componente com manifesto ou metadado POSE foi observado.\\n\"\n   844\t\t} else {\n   845\t\t\tfor _, st := range states {\n   846\t\t\t\tlangs := strings.Join(st.Metrics.Languages, \", \")\n   847\t\t\t\tif langs == \"\" {\n   848\t\t\t\t\tlangs = \"n/a\"\n   849\t\t\t\t}\n   850\t\t\t\tmd += fmt.Sprintf(\"- `%s`: caminho `%s`; linguagens %s; status `%s`.\\n\", st.ComponentSlug, st.Path, langs, st.Status)\n   851\t\t\t}\n   852\t\t}\n   853\t\n   854\t\tfile := filepath.Join(dir, \"consolidated.md\")\n   855\t\tif err := os.WriteFile(file, []byte(md), 0o644); err != nil {\n   856\t\t\treturn err\n   857\t\t}\n   858\t\n   859\t\treturn s.GenerateAssessmentsIndex(states)\n   860\t}\n   861\t\n   862\t// GenerateAssessmentsIndex automatically builds .pose/assessments/README.md linking all components.\n   863\tfunc (s Store) GenerateAssessmentsIndex(states []*ComponentDiscoveryState) error {\n   864\t\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n   865\t\t\treturn err\n   866\t\t}\n   867\t\tdir := s.AssessmentsDir()\n   868\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n   869\t\t\treturn err\n   870\t\t}\n   871\t\n   872\t\tmd := fmt.Sprintf(`# Component Assessments: %s\n   873\t\n   874\t> **Gerado Automaticamente por**: POSE Discovery Engine (`+\"`pose assess discover`\"+`)\n   875\t\n   876\t## Assessments por Componente (`+fmt.Sprintf(\"%d Módulos\", len(states))+`)\n   877\t\n   878\t| #  | Componente Slug | Módulo / Path | Linguagens | LOC Produção | LOC Testes | Arquivos | Status | Relatório Markdown |\n   879\t|----|------------|---------------|-----------|--------------|------------|----------|--------|--------------------|\n   880\t`, s.projectLabel())\n   881\t\n   882\t\tfor i, st := range states {\n   883\t\t\tfilename := slugifyAssessmentPath(st.ComponentSlug) + \".md\"\n   884\t\n   885\t\t\tlangs := strings.Join(st.Metrics.Languages, \", \")\n   886\t\t\tif langs == \"\" {\n   887\t\t\t\tlangs = \"n/a\"\n   888\t\t\t}\n   889\t\n   890\t\t\tmd += fmt.Sprintf(\"| %02d | `%s` | `%s` | `%s` | %d | %d | %d | `%s` | [%s](./%s) |\\n\",\n   400\tfunc markdownCell(value string) string {\n   401\t\tvalue = strings.ReplaceAll(value, \"|\", \"\\\\|\")\n   402\t\tvalue = strings.ReplaceAll(value, \"\\n\", \" \")\n   403\t\treturn value\n   404\t}\n   405\t\n   406\t// SaveIntegrationMatrix writes integrations.json and integrations.md in .pose/.\n   407\tfunc (s Store) SaveIntegrationMatrix(matrix *IntegrationMatrix) error {\n   408\t\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n   409\t\t\treturn err\n   410\t\t}\n   411\t\tif matrix == nil {\n   412\t\t\treturn fmt.Errorf(\"integration matrix is required\")\n   413\t\t}\n   414\t\tif err := os.MkdirAll(filepath.Dir(s.IntegrationStatePath()), 0o755); err != nil {\n   415\t\t\treturn err\n   416\t\t}\n   417\t\tif err := os.MkdirAll(s.AssessmentsDir(), 0o755); err != nil {\n   418\t\t\treturn err\n   419\t\t}\n   420\t\tjsonData, err := json.MarshalIndent(matrix, \"\", \"  \")\n   421\t\tif err != nil {\n   422\t\t\treturn err\n   423\t\t}\n   424\t\tif err := os.WriteFile(s.IntegrationStatePath(), append(jsonData, '\\n'), 0o644); err != nil {\n   425\t\t\treturn err\n   426\t\t}\n   427\t\n   428\t\tmd := fmt.Sprintf(`# Integration Assessment: %s\n   429\t\n   430\t> **Gerado por**: POSE Integration Engine (`+\"`pose assess integrate`\"+`)\n   431\t> **Data de Avaliação**: %s\n   432\t> **Baseline Commit**: %s\n   433\t\n   434\t## 1. Resumo Executivo\n   435\t\n   436\t- **Total de Contratos Observados**: %d\n   437\t- **Contratos com Provedor e Consumidor**: %d\n   438\t- **Gaps de Integração**: %d\n   439\t\n   440\t## 2. Matriz de Contratos\n   441\t\n   442\t| Nome do Contrato | Protocolo | Provedor | Consumidor | Status |\n   443\t|---|---|---|---|---|\n   444\t`, s.projectLabel(), matrix.EvaluatedAt, matrix.BaselineCommit, matrix.Summary.TotalIntegrations, matrix.Summary.ActiveContracts, matrix.Summary.IdentifiedGaps)\n   445\t\tfor _, contract := range matrix.Contracts {\n   446\t\t\tmd += fmt.Sprintf(\"| %s | `%s` | `%s` | `%s` | `%s` |\\n\",\n   447\t\t\t\tmarkdownCell(contract.Name), markdownCell(contract.Protocol), markdownCell(contract.Provider),\n   448\t\t\t\tmarkdownCell(contract.Consumer), markdownCell(contract.Status))\n   449\t\t}\n   450\t\tmd += \"\\n## 3. Gaps Observados\\n\\n\"\n   451\t\tif len(matrix.Gaps) == 0 {\n   452\t\t\tmd += \"Nenhum gap estático foi observado.\\n\"\n   453\t\t}\n   454\t\tfor _, gap := range matrix.Gaps {\n   455\t\t\tmd += fmt.Sprintf(\"### [%s] %s\\n- **Severidade**: %s\\n- **Provedor**: `%s`\\n- **Consumidor**: `%s`\\n- **Evidência**: %s\\n\\n\",\n   456\t\t\t\tgap.GapID, gap.Title, gap.Severity, gap.Provider, gap.Consumer, gap.Description)\n   457\t\t}\n   458\t\treturn os.WriteFile(s.IntegrationReportPath(), []byte(strings.TrimRight(md, \"\\n\")+\"\\n\"), 0o644)\n   459\t}\n   428\t// SaveTechDebtReport writes technical-debt.json and technical-debt.md in .pose/.\n   429\tfunc (s Store) SaveTechDebtReport(report *TechDebtReportState) error {\n   430\t\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n   431\t\t\treturn err\n   432\t\t}\n   433\t\tif report == nil {\n   434\t\t\treturn fmt.Errorf(\"technical-debt report is required\")\n   435\t\t}\n   436\t\tif err := os.MkdirAll(filepath.Dir(s.TechDebtStatePath()), 0o755); err != nil {\n   437\t\t\treturn err\n   438\t\t}\n   439\t\tif err := os.MkdirAll(s.AssessmentsDir(), 0o755); err != nil {\n   440\t\t\treturn err\n   441\t\t}\n   442\t\tjsonData, err := json.MarshalIndent(report, \"\", \"  \")\n   443\t\tif err != nil {\n   444\t\t\treturn err\n   445\t\t}\n   446\t\tif err := os.WriteFile(s.TechDebtStatePath(), append(jsonData, '\\n'), 0o644); err != nil {\n   447\t\t\treturn err\n   448\t\t}\n   449\t\n   450\t\tmd := fmt.Sprintf(`# Technical Debt Assessment: %s\n   451\t\n   452\t> **Gerado por**: POSE Technical Debt Engine (`+\"`pose assess tech-debt`\"+`)\n   453\t> **Data de Avaliação**: %s\n   454\t> **Baseline Commit**: %s\n   455\t\n   456\t## 1. Resumo Executivo\n   457\t\n   458\t- **Total de Marcadores**: %d\n   459\t- **TODOs**: %d | **FIXMEs**: %d | **HACKs**: %d | **Panics**: %d | **Stubs**: %d\n   460\t- **Cobertos por Backlog Ativo**: %d\n   461\t- **Não Cobertos**: %d\n   462\t- **Recomendações**: %d Follow-ups | %d Specs | %d Roadmaps\n   463\t%s\n   464\t## 2. Ocorrências\n   465\t\n   466\t| ID | Marcador | Componente | Arquivo e Linha | Cobertura | Evidência | Recomendação |\n   467\t|---|---|---|---|---|---|---|\n   468\t`, s.projectLabel(), report.EvaluatedAt, report.BaselineCommit, report.Summary.TotalMarkers,\n   469\t\t\treport.Summary.TODOs, report.Summary.FIXMEs, report.Summary.Hacks, report.Summary.Panics,\n   470\t\t\treport.Summary.Stubs, report.Summary.CoveredCount, report.Summary.UncoveredCount,\n   471\t\t\treport.Summary.RecommendedFollowups, report.Summary.RecommendedSpecs, report.Summary.RecommendedRoadmaps,\n   472\t\t\ttechDebtScopeMarkdown(report))\n   473\t\tlimit := len(report.Items)\n   474\t\tif limit > 100 {\n   475\t\t\tlimit = 100\n   476\t\t}\n   477\t\tfor _, item := range report.Items[:limit] {\n   478\t\t\tfileLink := fmt.Sprintf(\"[%s:%d](%s)\", filepath.Base(item.File), item.Line, item.Link)\n   479\t\t\tmd += fmt.Sprintf(\"| %s | `%s` | `%s` | %s | `%s` | `%s` | `%s` |\\n\",\n   480\t\t\t\titem.ID, item.Marker, markdownCell(item.Component), fileLink,\n   481\t\t\t\titem.Coverage, markdownCell(item.CoverageRef), item.Recommendation)\n   482\t\t}\n   483\t\tif len(report.Items) > limit {\n   484\t\t\tmd += fmt.Sprintf(\"\\n> Exibindo %d de %d ocorrências; consulte `.pose/state/technical-debt.json` para o conjunto completo.\\n\", limit, len(report.Items))\n   485\t\t}\n   486\t\tmd += \"\\n## 3. Política de Ação\\n\\n\" +\n   487\t\t\t\"- Registre dívida local não coberta como follow-up.\\n\" +\n   488\t\t\t\"- Abra uma spec quando um componente concentrar dívida recorrente.\\n\" +\n   489\t\t\t\"- Estenda o roadmap quando a dívida atravessar vários arquivos e exigir coordenação sistêmica.\\n\" +\n   490\t\t\t\"- Não crie recomendação nova quando uma spec, roadmap ou follow-up ativo já cobrir a ocorrência.\\n\"\n   491\t\treturn os.WriteFile(s.TechDebtReportPath(), []byte(md), 0o644)\n   492\t}\n   493\t\n   494\t// techDebtScopeMarkdown says what the scan covered, so a report with no markers does not\n   495\t// read as a project with none.\n   496\tfunc techDebtScopeMarkdown(report *TechDebtReportState) string {\n   497\t\tvar b strings.Builder\n   498\t\tfmt.Fprintf(&b, \"- **Escopo do scan**: %d arquivo(s) de código lidos\", report.ScannedFiles)\n   499\t\tif report.Complete {\n   500\t\t\tb.WriteString(\"; nenhum arquivo ilegível\\n\")\n   501\t\t} else {\n   502\t\t\tfmt.Fprintf(&b, \"; **INCOMPLETO** — %s. Zero marcadores não prova ausência de dívida nos arquivos não lidos.\\n\", report.Coverage.Describe(\"\"))\n   503\t\t}\n   504\t\tfor _, e := range report.Coverage.Exclusions {\n   505\t\t\tfmt.Fprintf(&b, \"- **Excluídos (%s)**: %d arquivo(s) — %s\\n\", e.Pattern, e.Count, e.Reason)\n   506\t\t}\n   507\t\treturn b.String()\n   508\t}\n","exit_code":0,"status":"completed"}}
