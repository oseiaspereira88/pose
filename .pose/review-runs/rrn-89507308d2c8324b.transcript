if reused, err := store.LoadComponentState(fresh.Component); err == nil && reused != nil {\n   676\t\t\t\t\t\tdecisions[reused.ComponentSlug] = \"reused (content, engine and matrix unchanged)\"\n   677\t\t\t\t\t\tresults = append(results, reused)\n   678\t\t\t\t\t\tcontinue\n   679\t\t\t\t\t}\n   680\t\t\t\t}\n   681\t\t\t\tdecisions[fresh.Component] = \"refreshed (\" + fresh.State + \": \" + strings.Join(fresh.Reasons, \"; \") + \")\"\n   682\t\t\t}\n   683\t\t\tstate, err := store.DiscoverComponent(t)\n   684\t\t\tif err != nil {\n   685\t\t\t\tfmt.Fprintf(stderr, \"pose assess discover %s: %v\\n\", t, err)\n   686\t\t\t\treturn 1\n   687\t\t\t}\n   688\t\t\tif persist {\n   689\t\t\t\tif err := store.SaveComponentState(state); err != nil {\n   690\t\t\t\t\tfmt.Fprintf(stderr, \"pose assess discover save %s: %v\\n\", t, err)\n   691\t\t\t\t\treturn 1\n   692\t\t\t\t}\n   693\t\t\t}\n   694\t\t\tresults = append(results, state)\n   695\t\t}\n   696\t\n   697\t\t// The consolidated view is repository-wide even when discovery is scoped to\n   698\t\t// one component. Rebuilding it from the scanned subset alone used to drop\n   699\t\t// every other component from README.md/consolidated.md while leaving its\n   700\t\t// per-component report and state file orphaned on disk.\n   701\t\tconsolidated := results\n   702\t\tif targetComp != \"\" {\n   703\t\t\tconsolidated = mergeWithPersistedComponentStates(store, results)\n   704\t\t}\n   705\t\tif persist {\n   706\t\t\tif err := store.GenerateConsolidatedAssessment(consolidated); err != nil {\n   707\t\t\t\tfmt.Fprintf(stderr, \"pose assess discover consolidate: %v\\n\", err)\n   708\t\t\t\treturn 1\n   709\t\t\t}\n   710\t\t}\n   711\t\n   712\t\tif updateState && persist {\n   713\t\t\t// The state is built from what this run observed: a persisted record of a component\n   714\t\t\t// that is no longer there is not part of it. What was recorded and cannot be read is\n   715\t\t\t// carried as a loss, so the state does not read as a certified total.\n   716\t\t\tstateInput := append([]*pose.ComponentDiscoveryState{}, results...)\n   717\t\t\tif targetComp != \"\" {\n   718\t\t\t\tfor _, c := range consolidated {\n   719\t\t\t\t\tif c.Status == \"unreadable\" {\n   720\t\t\t\t\t\tstateInput = append(stateInput, c)\n   721\t\t\t\t\t}\n   722\t\t\t\t}\n   723\t\t\t}\n   724\t\t\tif err := updateProjectStateArchitecture(root, stateInput); err != nil {\n   725\t\t\t\tfmt.Fprintf(stderr, \"pose assess discover update-state: %v\\n\", err)\n   726\t\t\t\treturn 1\n   727\t\t\t}\n   728\t\t}\n   729\t\n   730\t\tif !persist {\n   731\t\t\trender(stdout, stderr).Hint(\"pose assess: \" + persistNote)\n   732\t\t}\n   733\t\tif asJSON {\n   734\t\t\tenc, _ := json.MarshalIndent(results, \"\", \"  \")\n   735\t\t\tfmt.Fprintln(stdout, string(enc))\n   736\t\t\treturn 0\n   737\t\t}\n   738\t\n   739\t\tfmt.Fprintf(stdout, \"Discovered %d components:\\n\", len(results))\n   740\t\tfor _, res := range results {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/assessment_sealed.go && nl -ba pose-mcp/internal/pose/discovery.go | sed -n '370,400p;625,780p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Assessments in a sealed review checkout (spec\n     4\t// pose-assess-leaves-sealed-checkouts-alone): a reviewer running a planned\n     5\t// assessment tool must not change the checkout it reviews, or its own run\n     6\t// fails. The CLI does not persist there; these writers refuse as the last\n     7\t// line, so no other caller can publish an assessment into it either.\n     8\t\n     9\timport \"errors\"\n    10\t\n    11\t// ErrSealedAssessmentWrite is returned by an assessment writer whose root is\n    12\t// the sealed checkout of a delegated review.\n    13\tvar ErrSealedAssessmentWrite = errors.New(\"pose: assessments are not persisted in a sealed review checkout; run the command with --no-persist\")\n    14\t\n    15\tfunc refuseSealedAssessmentWrite(root string) error {\n    16\t\tif IsSealedCheckout(root) {\n    17\t\t\treturn ErrSealedAssessmentWrite\n    18\t\t}\n    19\t\treturn nil\n    20\t}\n   370\t// DiscoverAllComponents dynamically finds and discovers all components in the repository.\n   371\tfunc (s Store) DiscoverAllComponents() ([]*ComponentDiscoveryState, error) {\n   372\t\ttargets := s.FindComponentDirectories()\n   373\t\tif len(targets) == 0 {\n   374\t\t\ttargets = []string{\".\"}\n   375\t\t}\n   376\t\n   377\t\tvar results []*ComponentDiscoveryState\n   378\t\tfor _, t := range targets {\n   379\t\t\tstate, err := s.DiscoverComponent(t)\n   380\t\t\tif err != nil {\n   381\t\t\t\treturn nil, err\n   382\t\t\t}\n   383\t\t\tif err := s.SaveComponentState(state); err != nil {\n   384\t\t\t\treturn nil, err\n   385\t\t\t}\n   386\t\t\tresults = append(results, state)\n   387\t\t}\n   388\t\n   389\t\tif err := s.GenerateConsolidatedAssessment(results); err != nil {\n   390\t\t\treturn nil, err\n   391\t\t}\n   392\t\treturn results, nil\n   393\t}\n   394\t\n   395\t// DiscoverComponent scans a directory under root and produces a ComponentDiscoveryState.\n   396\tfunc (s Store) DiscoverComponent(relPath string) (*ComponentDiscoveryState, error) {\n   397\t\tcleanPath, absPath, err := s.resolveComponentDir(relPath)\n   398\t\tif err != nil {\n   399\t\t\treturn nil, fmt.Errorf(\"discover component %q: %w\", relPath, err)\n   400\t\t}\n   625\t\t\t\t}\n   626\t\t\t}\n   627\t\t}\n   628\t\treturn loc, isTest, false, debt, nil\n   629\t}\n   630\t\n   631\t// SaveComponentState writes ComponentDiscoveryState JSON to .pose/state/components/<slug>.json\n   632\t// and automatically generates the corresponding .pose/assessments/<slug>.md report.\n   633\tfunc (s Store) SaveComponentState(state *ComponentDiscoveryState) error {\n   634\t\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n   635\t\t\treturn err\n   636\t\t}\n   637\t\tif state == nil {\n   638\t\t\treturn fmt.Errorf(\"component state is required\")\n   639\t\t}\n   640\t\tstate.ComponentSlug = slugifyAssessmentPath(state.ComponentSlug)\n   641\t\tdir := s.ComponentStateDir()\n   642\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n   643\t\t\treturn err\n   644\t\t}\n   645\t\tfile := filepath.Join(dir, state.ComponentSlug+\".json\")\n   646\t\tdata, err := json.MarshalIndent(state, \"\", \"  \")\n   647\t\tif err != nil {\n   648\t\t\treturn err\n   649\t\t}\n   650\t\tif err := os.WriteFile(file, data, 0o644); err != nil {\n   651\t\t\treturn err\n   652\t\t}\n   653\t\n   654\t\treturn s.GenerateComponentAssessmentMarkdown(state)\n   655\t}\n   656\t\n   657\t// GenerateComponentAssessmentMarkdown automatically builds .pose/assessments/<slug>.md from discovery data.\n   658\tfunc (s Store) GenerateComponentAssessmentMarkdown(state *ComponentDiscoveryState) error {\n   659\t\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n   660\t\t\treturn err\n   661\t\t}\n   662\t\tdir := s.AssessmentsDir()\n   663\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n   664\t\t\treturn err\n   665\t\t}\n   666\t\n   667\t\tfilename := slugifyAssessmentPath(state.ComponentSlug) + \".md\"\n   668\t\n   669\t\tlangs := strings.Join(state.Metrics.Languages, \", \")\n   670\t\tif langs == \"\" {\n   671\t\t\tlangs = \"n/a\"\n   672\t\t}\n   673\t\n   674\t\tmd := fmt.Sprintf(`# Component Assessment: %s (`+\"`%s`\"+`)\n   675\t\n   676\t> **Mapeamento de Módulo POSE**: `+\"`%s`\"+`\n   677\t> **Data de Avaliação**: %s | **Baseline Commit**: %s\n   678\t> **Métricas**: %d LOC Produção | %d LOC Testes | %d Arquivos Totais\n   679\t> **Linguagens**: %s\n   680\t> **Saúde de Código**: %d TODOs | %d FIXMEs | %d Panics | %d Stubs\n   681\t\n   682\t---\n   683\t\n   684\t## 1. Visão Geral e Estrutura do Módulo\n   685\t\n   686\tO componente **%s** reside no caminho `+\"`%s`\"+` do projeto **%s**.\n   687\t\n   688\t- **Status de Verificação POSE**: `+\"`%s`\"+`\n   689\t- **Pontuação de Completude**: %.0f%%\n   690\t\n   691\t---\n   692\t\n   693\t## 2. Matriz de Dívida Técnica & Riscos\n   694\t\n   695\t- **TODOs**: %d\n   696\t- **FIXMEs**: %d\n   697\t- **Panics**: %d\n   698\t- **Stubs**: %d\n   699\t`, state.ComponentSlug, state.Path, state.Path, state.DiscoveredAt, state.BaselineCommit, state.Metrics.LOCProduction, state.Metrics.LOCTests, state.Metrics.TotalFiles, langs, state.TechnicalDebt.TODOs, state.TechnicalDebt.FIXMEs, state.TechnicalDebt.Panics, state.TechnicalDebt.Stubs, state.ComponentSlug, state.Path, s.projectLabel(), state.Status, state.CompletenessScore*100, state.TechnicalDebt.TODOs, state.TechnicalDebt.FIXMEs, state.TechnicalDebt.Panics, state.TechnicalDebt.Stubs)\n   700\t\n   701\t\tmd += componentScanScopeMarkdown(state)\n   702\t\tfile := filepath.Join(dir, filename)\n   703\t\treturn os.WriteFile(file, []byte(md), 0o644)\n   704\t}\n   705\t\n   706\t// ScanIncomplete reports a component whose scan lost files. A state stored before the\n   707\t// scan recorded its coverage has no losses and is not reported as incomplete.\n   708\tfunc (c ComponentDiscoveryState) ScanIncomplete() bool { return len(c.Coverage.Losses) > 0 }\n   709\t\n   710\t// Why a persisted component state could not be used, so a consumer can tell a file it could\n   711\t// not open from one that is not JSON, one of a format it does not read and one that names\n   712\t// no component.\n   713\tvar (\n   714\t\tErrComponentStateParse       = errors.New(\"pose: the component state is not valid JSON\")\n   715\t\tErrComponentStateUnsupported = errors.New(\"pose: the component state has a schema_version this engine does not read\")\n   716\t\tErrComponentStateInvalid     = errors.New(\"pose: the component state is not a valid record\")\n   717\t)\n   718\t\n   719\t// LoadComponentState reads ComponentDiscoveryState JSON from .pose/state/components/<slug>.json\n   720\tfunc (s Store) LoadComponentState(slug string) (*ComponentDiscoveryState, error) {\n   721\t\tcanonical := slugifyAssessmentPath(slug)\n   722\t\tif canonical == \"root\" && slug != \"root\" {\n   723\t\t\treturn nil, fmt.Errorf(\"invalid component slug\")\n   724\t\t}\n   725\t\tfile := filepath.Join(s.ComponentStateDir(), canonical+\".json\")\n   726\t\tdata, err := os.ReadFile(file)\n   727\t\tif err != nil {\n   728\t\t\treturn nil, err\n   729\t\t}\n   730\t\tvar state ComponentDiscoveryState\n   731\t\tif err := json.Unmarshal(data, &state); err != nil {\n   732\t\t\treturn nil, fmt.Errorf(\"%w: %v\", ErrComponentStateParse, err)\n   733\t\t}\n   734\t\tif state.SchemaVersion > 1 {\n   735\t\t\treturn nil, fmt.Errorf(\"%w: schema_version %d\", ErrComponentStateUnsupported, state.SchemaVersion)\n   736\t\t}\n   737\t\tif state.ComponentSlug == \"\" {\n   738\t\t\t// \"null\" and a record with no identity decode to a zero state: not a component.\n   739\t\t\treturn nil, fmt.Errorf(\"%w: the record names no component\", ErrComponentStateInvalid)\n   740\t\t}\n   741\t\treturn &state, nil\n   742\t}\n   743\t\n   744\t// GenerateConsolidatedAssessment builds a project-derived consolidated report.\n   745\tfunc (s Store) GenerateConsolidatedAssessment(states []*ComponentDiscoveryState) error {\n   746\t\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n   747\t\t\treturn err\n   748\t\t}\n   749\t\tdir := s.AssessmentsDir()\n   750\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n   751\t\t\treturn err\n   752\t\t}\n   753\t\n   754\t\tvar totalProd, totalTests, totalFiles int\n   755\t\tvar totalTODOs, totalFIXMEs, totalPanics, totalStubs int\n   756\t\tvar sumCompleteness float64\n   757\t\tvar incomplete []string\n   758\t\n   759\t\tfor _, st := range states {\n   760\t\t\tif st.ScanIncomplete() {\n   761\t\t\t\tincomplete = append(incomplete, st.ComponentSlug)\n   762\t\t\t}\n   763\t\t\ttotalProd += st.Metrics.LOCProduction\n   764\t\t\ttotalTests += st.Metrics.LOCTests\n   765\t\t\ttotalFiles += st.Metrics.TotalFiles\n   766\t\t\ttotalTODOs += st.TechnicalDebt.TODOs\n   767\t\t\ttotalFIXMEs += st.TechnicalDebt.FIXMEs\n   768\t\t\ttotalPanics += st.TechnicalDebt.Panics\n   769\t\t\ttotalStubs += st.TechnicalDebt.Stubs\n   770\t\t\tsumCompleteness += st.CompletenessScore\n   771\t\t}\n   772\t\n   773\t\tavgCompleteness := 1.0\n   774\t\tif len(states) > 0 {\n   775\t\t\tavgCompleteness = sumCompleteness / float64(len(states))\n   776\t\t}\n   777\t\n   778\t\t// Fetch open specs\n   779\t\tvar openSpecsCount int\n   780\t\tif openSpecs, err := s.ListSpecs(\"draft,in_progress,in-progress\", \"\"); err == nil {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/integration.go | sed -n '400,445p' && nl -ba pose-mcp/internal/pose/techdebt.go | sed -n '420,470p'\"","aggregated_output":"   400\tfunc markdownCell(value string) string {\n   401\t\tvalue = strings.ReplaceAll(value, \"|\", \"\\\\|\")\n   402\t\tvalue = strings.ReplaceAll(value, \"\\n\", \" \")\n   403\t\treturn value\n   404\t}\n   405\t\n   406\t// SaveIntegrationMatrix writes integrations.json and integrations.md in .pose/.\n   407\tfunc (s Store) SaveIntegrationMatrix(matrix *IntegrationMatrix) error {\n   408\t\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n   409\t\t\treturn err\n   410\t\t}\n   411\t\tif matrix == nil {\n   412\t\t\treturn fmt.Errorf(\"integration matrix is required\")\n   413\t\t}\n   414\t\tif err := os.MkdirAll(filepath.Dir(s.IntegrationStatePath()), 0o755); err != nil {\n   415\t\t\treturn err\n   416\t\t}\n   417\t\tif err := os.MkdirAll(s.AssessmentsDir(), 0o755); err != nil {\n   418\t\t\treturn err\n   419\t\t}\n   420\t\tjsonData, err := json.MarshalIndent(matrix, \"\", \"  \")\n   421\t\tif err != nil {\n   422\t\t\treturn err\n   423\t\t}\n   424\t\tif err := os.WriteFile(s.IntegrationStatePath(), append(jsonData, '\\n'), 0o644); err != nil {\n   425\t\t\treturn err\n   426\t\t}\n   427\t\n   428\t\tmd := fmt.Sprintf(`# Integration Assessment: %s\n   429\t\n   430\t> **Gerado por**: POSE Integration Engine (`+\"`pose assess integrate`\"+`)\n   431\t> **Data de Avaliação**: %s\n   432\t> **Baseline Commit**: %s\n   433\t\n   434\t## 1. Resumo Executivo\n   435\t\n   436\t- **Total de Contratos Observados**: %d\n   437\t- **Contratos com Provedor e Consumidor**: %d\n   438\t- **Gaps de Integração**: %d\n   439\t\n   440\t## 2. Matriz de Contratos\n   441\t\n   442\t| Nome do Contrato | Protocolo | Provedor | Consumidor | Status |\n   443\t|---|---|---|---|---|\n   444\t`, s.projectLabel(), matrix.EvaluatedAt, matrix.BaselineCommit, matrix.Summary.TotalIntegrations, matrix.Summary.ActiveContracts, matrix.Summary.IdentifiedGaps)\n   445\t\tfor _, contract := range matrix.Contracts {\n   420\t\n   421\t\treturn &TechDebtReportState{\n   422\t\t\tSchemaVersion: 1, EvaluatedAt: time.Now().UTC().Format(time.RFC3339),\n   423\t\t\tBaselineCommit: s.resolveGitCommit(), Summary: summary, Items: items,\n   424\t\t\tScannedFiles: scanned, Complete: coverage.Complete(), Coverage: coverage,\n   425\t\t}, nil\n   426\t}\n   427\t\n   428\t// SaveTechDebtReport writes technical-debt.json and technical-debt.md in .pose/.\n   429\tfunc (s Store) SaveTechDebtReport(report *TechDebtReportState) error {\n   430\t\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n   431\t\t\treturn err\n   432\t\t}\n   433\t\tif report == nil {\n   434\t\t\treturn fmt.Errorf(\"technical-debt report is required\")\n   435\t\t}\n   436\t\tif err := os.MkdirAll(filepath.Dir(s.TechDebtStatePath()), 0o755); err != nil {\n   437\t\t\treturn err\n   438\t\t}\n   439\t\tif err := os.MkdirAll(s.AssessmentsDir(), 0o755); err != nil {\n   440\t\t\treturn err\n   441\t\t}\n   442\t\tjsonData, err := json.MarshalIndent(report, \"\", \"  \")\n   443\t\tif err != nil {\n   444\t\t\treturn err\n   445\t\t}\n   446\t\tif err := os.WriteFile(s.TechDebtStatePath(), append(jsonData, '\\n'), 0o644); err != nil {\n   447\t\t\treturn err\n   448\t\t}\n   449\t\n   450\t\tmd := fmt.Sprintf(`# Technical Debt Assessment: %s\n   451\t\n   452\t> **Gerado por**: POSE Technical Debt Engine (`+\"`pose assess tech-debt`\"+`)\n   453\t> **Data de Avaliação**: %s\n   454\t> **Baseline Commit**: %s\n   455\t\n   456\t## 1. Resumo Executivo\n   457\t\n   458\t- **Total de Marcadores**: %d\n   459\t- **TODOs**: %d | **FIXMEs**: %d | **HACKs**: %d | **Panics**: %d | **Stubs**: %d\n   460\t- **Cobertos por Backlog Ativo**: %d\n   461\t- **Não Cobertos**: %d\n   462\t- **Recomendações**: %d Follow-ups | %d Specs | %d Roadmaps\n   463\t%s\n   464\t## 2. Ocorrências\n   465\t\n   466\t| ID | Marcador | Componente | Arquivo e Linha | Cobertura | Evidência | Recomendação |\n   467\t|---|---|---|---|---|---|---|\n   468\t`, s.projectLabel(), report.EvaluatedAt, report.BaselineCommit, report.Summary.TotalMarkers,\n   469\t\t\treport.Summary.TODOs, report.Summary.FIXMEs, report.Summary.Hacks, report.Summary.Panics,\n   470\t\t\treport.Summary.Stubs, report.Summary.CoveredCount, report.Summary.UncoveredCount,\n","exit_code":0,"status":"completed"}}
