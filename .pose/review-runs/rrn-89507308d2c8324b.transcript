scanned\", strconv.Itoa(len(records)))\n   181\t\tgate.Field(\"recurrence.flagged_keys\", strconv.Itoa(flagged))\n   182\t\t// This gate has no pinned human verdict line; the machine document still\n   183\t\t// records the decision.\n   184\t\tstate, text := cliout.StatePass, \"no recurrent failure\"\n   185\t\tif flagged > 0 {\n   186\t\t\tstate, text = cliout.StateWarning, fmt.Sprintf(\"%d recurrent key(s)\", flagged)\n   187\t\t\tif mode == \"strict\" {\n   188\t\t\t\tstate = cliout.StateFail\n   189\t\t\t}\n   190\t\t}\n   191\t\tword := \"\"\n   192\t\tif state == cliout.StateWarning {\n   193\t\t\tword = \"RECURRENT\"\n   194\t\t}\n   195\t\tgate.r.RecordVerdict(cliout.Verdict{State: state, Word: word, Text: text})\n   196\t\tif flagged > 0 && mode == \"strict\" {\n   197\t\t\treturn 1\n   198\t\t}\n   199\t\treturn 0\n   200\t}\n   201\t\n   202\t// recurrenceGroup is the unresolved failure records of one task and report\n   203\t// type, summed over its stable_hash clusters.\n   204\ttype recurrenceGroup struct {\n   205\t\ttask, reportType string\n   206\t\trecords          []historyRecord\n   207\t}\n   208\t\n   209\t// resolvedCluster is a stable_hash cluster whose failures a later pass settled.\n   210\ttype resolvedCluster struct {\n   211\t\ttask, reportType, hash string\n   212\t\tfailures               int\n   213\t\tpassAt                 string\n   214\t}\n   215\t\n   216\tfunc (c resolvedCluster) hashLabel() string {\n   217\t\tif c.hash == \"\" {\n   218\t\t\treturn \"no stable_hash\"\n   219\t\t}\n   220\t\tif len(c.hash) > 8 {\n","exit_code":0,"status":"completed"}}
