[--json] [--quiet] [--color auto|always|never]\")\n   113\t\t\t}\n   114\t\t}\n   115\t\tgate := newGateOutput(\"recurrence-check\", flags, stdout, stderr)\n   116\t\tgate.root = root\n   117\t\tdefer gate.Close()\n   118\t\trecords, _ := readHistory(root, stderr)\n   119\t\tcutoff := time.Now().UTC().AddDate(0, 0, -days)\n   120\t\tgroups, resolved := recurrenceGroups(records, cutoff, includePass)\n   121\t\tflagged := 0\n   122\t\tfor _, g := range groups {\n   123\t\t\tif len(g.records) < threshold {\n   124\t\t\t\tcontinue\n   125\t\t\t}\n   126\t\t\tflagged++\n   127\t\t\tcounts := map[string]int{}\n   128\t\t\tlatest := \"\"\n   129\t\t\tworkflow := \"\"\n   130\t\t\tfor _, r := range g.records {\n   131\t\t\t\to := r.Outcome\n   132\t\t\t\tif o == \"\" {\n   133\t\t\t\t\to = \"unknown\"\n   134\t\t\t\t}\n   135\t\t\t\tcounts[o]++\n   136\t\t\t\tif r.GeneratedAt > latest {\n   137\t\t\t\t\tlatest = r.GeneratedAt\n   138\t\t\t\t}\n   139\t\t\t\tif r.Workflow != \"\" {\n   140\t\t\t\t\tworkflow = r.Workflow\n   141\t\t\t\t}\n   142\t\t\t}\n   143\t\t\tnames := make([]string, 0, len(counts))\n   144\t\t\tfor n := range counts {\n   145\t\t\t\tnames = append(names, n)\n   146\t\t\t}\n   147\t\t\tsort.Strings(names)\n   148\t\t\tsummary := []string{}\n   149\t\t\tfor _, n := range names {\n   150\t\t\t\tsummary = append(summary, fmt.Sprintf(\"%s=%d\", n, counts[n]))\n   151\t\t\t}\n   152\t\t\tmessage := fmt.Sprintf(\"%d runs in %dd; outcomes=%s; latest=%s\", len(g.records), days, strings.Join(summary, \", \"), latest)\n   153\t\t\tif workflow != \"\" {\n   154\t\t\t\tmessage += \"; workflow=\" + workflow\n   155\t\t\t}\n","exit_code":0,"status":"completed"}}
