{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_refusal.go | sed -n '28,80p'; rg -n 'IsSealedCheckout|refuseSealedAssessmentWrite' pose-mcp/internal\"","aggregated_output":"    28\t// SealedCheckoutEnv marks a process a delegated review launched in its sealed\n    29\t// checkout, as the path of that checkout. Diagnostic commands that would\n    30\t// republish a derived record there (the delivery index) read it and leave the checkout as sealed: a review that\n    31\t// changes its subject is invalid (spec pose-validation-evidence-material-binding R7).\n    32\tconst SealedCheckoutEnv = \"POSE_SEALED_CHECKOUT\"\n    33\t\n    34\t// IsSealedCheckout reports whether root is the sealed checkout the environment\n    35\t// names. The marker carries the checkout's path, so a fixture or another project\n    36\t// a reviewer's process works in is not mistaken for the sealed one.\n    37\tfunc IsSealedCheckout(root string) bool {\n    38\t\tsealed := os.Getenv(SealedCheckoutEnv)\n    39\t\tif sealed == \"\" || root == \"\" {\n    40\t\t\treturn false\n    41\t\t}\n    42\t\tresolve := func(p string) string {\n    43\t\t\tif abs, err := filepath.Abs(p); err == nil {\n    44\t\t\t\tp = abs\n    45\t\t\t}\n    46\t\t\tif real, err := filepath.EvalSymlinks(p); err == nil {\n    47\t\t\t\tp = real\n    48\t\t\t}\n    49\t\t\treturn filepath.Clean(p)\n    50\t\t}\n    51\t\treturn resolve(sealed) == resolve(root)\n    52\t}\n    53\t\n    54\t// DelegationRefusal is a refusal with its reason code.\n    55\ttype DelegationRefusal struct {\n    56\t\tCode string\n    57\t\tErr  error\n    58\t}\n    59\t\n    60\tfunc (r *DelegationRefusal) Error() string { return r.Err.Error() }\n    61\tfunc (r *DelegationRefusal) Unwrap() error { return r.Err }\n    62\t\n    63\tfunc refusal(code string, err error) error {\n    64\t\tif err == nil {\n    65\t\t\treturn nil\n    66\t\t}\n    67\t\treturn &DelegationRefusal{Code: code, Err: err}\n    68\t}\n    69\t\n    70\t// DelegationReasonCode is the reason code of err, or \"\" when it is not a\n    71\t// coded refusal.\n    72\tfunc DelegationReasonCode(err error) string {\n    73\t\tvar r *DelegationRefusal\n    74\t\tif errors.As(err, &r) {\n    75\t\t\treturn r.Code\n    76\t\t}\n    77\t\tvar unavailable *ErrNoDelegationAgentAvailable\n    78\t\tif errors.As(err, &unavailable) {\n    79\t\t\treturn DelegationReasonAgentUnavailable\n    80\t\t}\npose-mcp/internal/cli/assess.go:67:\tif pose.IsSealedCheckout(root) {\npose-mcp/internal/cli/assess.go:75:\tif len(args) > 0 && pose.IsSealedCheckout(root) {\npose-mcp/internal/cli/index.go:261:\tif posepkg.IsSealedCheckout(root) {\npose-mcp/internal/pose/techdebt.go:430:\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\npose-mcp/internal/pose/delegation_refusal.go:34:// IsSealedCheckout reports whether root is the sealed checkout the environment\npose-mcp/internal/pose/delegation_refusal.go:37:func IsSealedCheckout(root string) bool {\npose-mcp/internal/pose/assessment_sealed.go:15:func refuseSealedAssessmentWrite(root string) error {\npose-mcp/internal/pose/assessment_sealed.go:16:\tif IsSealedCheckout(root) {\npose-mcp/internal/pose/discovery.go:634:\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\npose-mcp/internal/pose/discovery.go:659:\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\npose-mcp/internal/pose/discovery.go:746:\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\npose-mcp/internal/pose/discovery.go:864:\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\npose-mcp/internal/pose/integration.go:408:\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\npose-mcp/internal/pose/assessment_sealed_test.go:51:\t\t\t\t\tif f.Name == \"refuseSealedAssessmentWrite\" {\n","exit_code":0,"status":"completed"}}
