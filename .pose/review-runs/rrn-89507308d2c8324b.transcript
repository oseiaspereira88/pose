10\t\t\treturn []string{\"pose\", \"roadmap-check\", scope.Slug, \"--strict\"}\n  1411\t\tcase \"history-check\", \"knowledge-check\", \"skills-check\":\n  1412\t\t\treturn []string{\"pose\", id, \"--strict\"}\n  1413\t\tcase \"review-check\", \"closeout-check\":\n  1414\t\t\treturn []string{\"pose\", id, ref}\n  1415\t\tdefault:\n  1416\t\t\treturn nil\n  1417\t\t}\n  1418\t}\n  1419\t\n  1420\tfunc digestReviewPlan(plan ReviewPlan) (string, error) {\n  1421\t\ttype digestComponent struct {\n  1422\t\t\tID, Path, Kind, Language, Domain, Criticality, ValidationProfile, MetadataStatus string\n  1423\t\t\tSources                                                                          []string\n  1424\t\t}\n  1425\t\tcomponents := []digestComponent{}\n  1426\t\tfor _, component := range plan.Components {\n  1427\t\t\tcomponents = append(components, digestComponent{component.ID, component.Path, component.Kind, component.Language, component.Domain, component.Criticality, component.ValidationProfile, component.MetadataStatus, component.Sources})\n  1428\t\t}\n  1429\t\t// The material structural set is hashed, the coverage report is not. A\n  1430\t\t// criterion answering for observed structure owes one answer per material\n  1431\t\t// fact, so gaining a fact must stale a sealed review; a detector that learns\n  1432\t\t// to report one more unknown must not. Omitted entirely when nothing selected\n  1433\t\t// on structure, so a plan from before this contract keeps its digest.\n  1434\t\tvar structure *[]ReviewStructuralFact\n  1435\t\tif plan.Structure != nil && len(plan.Structure.Material) > 0 {\n","exit_code":0,"status":"completed"}}
