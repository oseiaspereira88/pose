) {\npose-mcp/internal/pose/review_attempt_ledger.go:372:func (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttempt, int, error) {\npose-mcp/internal/pose/review_attempt_ledger.go:423:\tattempts, _, err := s.reviewAttemptAdmission(plan)\npose-mcp/internal/pose/review_attempt_ledger.go:878:// reserveDelegatedReviewAttempt prepares and publishes a reservation at once,\npose-mcp/internal/pose/review_attempt_ledger.go:880:func (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\npose-mcp/internal/pose/review_attempt_ledger_test.go:37:\t\t\ta, err := s.reserveDelegatedReviewAttempt(plan, time.Now())\npose-mcp/internal/pose/review_attempt_ledger_test.go:43:\t\t\tif _, err := s.reserveDelegatedReviewAttempt(plan, time.Now()); err == nil || !strings.Contains(err.Error(), \"budget exhausted\") {\npose-mcp/internal/pose/review_attempt_ledger_test.go:52:\t\t\tif _, err := s.reserveDelegatedReviewAttempt(plan, time.Now()); err == nil {\npose-mcp/internal/pose/review_attempt_ledger_test.go:59:\ta, err := s.reserveDelegatedReviewAttempt(plan, time.Now())\npose-mcp/internal/pose/review_attempt_ledger_test.go:65:\tif _, err := s.reserveDelegatedReviewAttempt(plan, time.Now()); err == nil || !strings.Contains(err.Error(), \"--reason\") {\npose-mcp/internal/pose/review_attempt_ledger_test.go:69:\tnext, err := s.reserveDelegatedReviewAttempt(plan, time.Now())\npose-mcp/internal/pose/review_attempt_ledger_test.go:87:\t\t\tif _, err := s.reserveDelegatedReviewAttempt(plan, time.Now()); err == nil {\npose-mcp/internal/pose/review_attempt_ledger_test.go:99:\tif _, err := s.reserveDelegatedReviewAttempt(plan, time.Now()); err == nil {\npose-mcp/internal/pose/review_attempt_ledger_test.go:178:\ta, err := s.reserveDelegatedReviewAttempt(plan, time.Now())\npose-mcp/internal/pose/review_attempt_ledger_test.go:184:\ta, err = s.reserveDelegatedReviewAttempt(plan, time.Now())\npose-mcp/internal/pose/review_dispatch.go:586:\t_, currentCount, err := s.reviewAttemptAdmission(plan)\n","exit_code":0,"status":"completed"}}
