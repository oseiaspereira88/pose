{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/delegation_release.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"os\"\n    28\t\t\"path/filepath\"\n    29\t\t\"strings\"\n    30\t\t\"time\"\n    31\t)\n    32\t\n    33\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    34\t// proven abandoned.\n    35\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    36\t\n    37\t// reviewOrphanReservationAge is how old a reservation without any marker\n    38\t// must be to count as abandoned.\n    39\tconst reviewOrphanReservationAge = 10 * time.Minute\n    40\t\n    41\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    42\t// dispatch ended before recording it, and removes its stalled marker. A\n    43\t// stalled marker whose reservation was never published is only removed; the\n    44\t// returned run is then empty.\n    45\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    46\t\tif !validAttemptFileName(attemptID) {\n    47\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    48\t\t}\n    49\t\tmarkers, _, err := s.ListDelegationActive()\n    50\t\tif err != nil {\n    51\t\t\treturn ReviewRun{}, err\n    52\t\t}\n    53\t\tvar marker *DelegationActiveRun\n    54\t\tfor i := range markers {\n    55\t\t\tif markers[i].AttemptID == attemptID {\n    56\t\t\t\tmarker = &markers[i]\n    57\t\t\t}\n    58\t\t}\n    59\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    60\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    61\t\t}\n    62\t\tdir, err := s.delegationActiveDir(true)\n    63\t\tif err != nil {\n    64\t\t\treturn ReviewRun{}, err\n    65\t\t}\n    66\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    67\t\tif err != nil {\n    68\t\t\treturn ReviewRun{}, err\n    69\t\t}\n    70\t\tdefer lock.Close()\n    71\t\tunlock, err := lockSpecTransferFile(lock)\n    72\t\tif err != nil {\n    73\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    74\t\t}\n    75\t\tdefer unlock()\n    76\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    77\t}\n    78\t\n    79\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    80\t\tvar reserved *DelegatedReviewAttempt\n    81\t\tif marker != nil {\n    82\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    83\t\t\tif err != nil {\n    84\t\t\t\treturn ReviewRun{}, err\n    85\t\t\t}\n    86\t\t\tfor i := range attempts {\n    87\t\t\t\tif attempts[i].AttemptID == attemptID {\n    88\t\t\t\t\treserved = &attempts[i]\n    89\t\t\t\t}\n    90\t\t\t}\n    91\t\t\tif reserved == nil {\n    92\t\t\t\t// The dispatch ended between its marker and its reservation:\n    93\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    94\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    95\t\t\t}\n    96\t\t} else {\n    97\t\t\tif !operatorConfirmed {\n    98\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n    99\t\t\t}\n   100\t\t\torphans, _, err := s.orphanReservations(now)\n   101\t\t\tif err != nil {\n   102\t\t\t\treturn ReviewRun{}, err\n   103\t\t\t}\n   104\t\t\tfor i := range orphans {\n   105\t\t\t\tif orphans[i].AttemptID == attemptID {\n   106\t\t\t\t\treserved = &orphans[i]\n   107\t\t\t\t}\n   108\t\t\t}\n   109\t\t\tif reserved == nil {\n   110\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   111\t\t\t}\n   112\t\t}\n   113\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   114\t\t\t// A release that stopped after the receipt completes by removing\n   115\t\t\t// the stalled marker; with no marker there is nothing to release.\n   116\t\t\tif marker != nil {\n   117\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   118\t\t\t\tif err != nil {\n   119\t\t\t\t\treturn ReviewRun{}, err\n   120\t\t\t\t}\n   121\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   122\t\t\t\tif err != nil {\n   123\t\t\t\t\treturn ReviewRun{}, err\n   124\t\t\t\t}\n   125\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   126\t\t\t}\n   127\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   128\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   129\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   130\t\t}\n   131\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   132\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   133\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   134\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   135\t\tif marker != nil {\n   136\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   137\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   138\t\t} else {\n   139\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   140\t\t}\n   141\t\t// A run the attempt already recorded, by its dispatch or by a release\n   142\t\t// interrupted before the receipt, completes the attempt; no second run\n   143\t\t// is written for it.\n   144\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   145\t\tif err != nil {\n   146\t\t\treturn ReviewRun{}, err\n   147\t\t}\n   148\t\tif !found {\n   149\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   150\t\t\t\treturn ReviewRun{}, err\n   151\t\t\t}\n   152\t\t}\n   153\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   154\t\t\treturn recorded, err\n   155\t\t}\n   156\t\tif marker != nil {\n   157\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   158\t\t}\n   159\t\treturn recorded, nil\n   160\t}\n   161\t\n   162\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   163\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   164\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   165\t\tif err != nil {\n   166\t\t\treturn ReviewRun{}, false, err\n   167\t\t}\n   168\t\tif len(lost) > 0 {\n   169\t\t\t// An unreadable run may be this release's: the history is unknown,\n   170\t\t\t// and the release does not write another (review round 4, N3).\n   171\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   172\t\t}\n   173\t\tvar latest *ReviewRun\n   174\t\tfor i := range runs {\n   175\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   176\t\t\t\tlatest = &runs[i]\n   177\t\t\t}\n   178\t\t}\n   179\t\tif latest == nil {\n   180\t\t\treturn ReviewRun{}, false, nil\n   181\t\t}\n   182\t\treturn *latest, true, nil\n   183\t}\n   184\t\n   185\t// orphanReservations lists the reservations left without a receipt or a\n   186\t// marker, older than reviewOrphanReservationAge, and\n   187\t// says which reservations or receipts it could not read (review round 3, N3).\n   188\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   189\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   190\t\tdirs, err := os.ReadDir(base)\n   191\t\tif errors.Is(err, os.ErrNotExist) {\n   192\t\t\treturn nil, nil, nil\n   193\t\t}\n   194\t\tif err != nil {\n   195\t\t\treturn nil, nil, err\n   196\t\t}\n   197\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   198\t\tif err != nil {\n   199\t\t\treturn nil, nil, err\n   200\t\t}\n   201\t\tif len(markerLost) > 0 {\n   202\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   203\t\t\t// have no marker (review round 6, N1).\n   204\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   205\t\t}\n   206\t\tmarked := map[string]bool{}\n   207\t\tfor _, m := range markers {\n   208\t\t\tmarked[m.AttemptID] = true\n   209\t\t}\n   210\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   211\t\tif err != nil {\n   212\t\t\treturn nil, nil, err\n   213\t\t}\n   214\t\tif len(runLost) > 0 {\n   215\t\t\t// Without the whole run history nothing is known to have no run.\n   216\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   217\t\t}\n   218\t\t// A recorded run does not finish an attempt, its receipt does: a\n   219\t\t// reservation whose run was recorded without a receipt still blocks and\n   220\t\t// is released with that run (review round 5, N3).\n   221\t\t_ = runs\n   222\t\tvar out []DelegatedReviewAttempt\n   223\t\tvar lost []string\n   224\t\tbudget := reviewReadBudget(nil)\n   225\t\tfor _, d := range dirs {\n   226\t\t\tif !d.IsDir() {\n   227\t\t\t\tcontinue\n   228\t\t\t}\n   229\t\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n   230\t\t\tif err != nil {\n   231\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   232\t\t\t\tcontinue\n   233\t\t\t}\n   234\t\t\tfor _, e := range entries {\n   235\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   236\t\t\t\t\tcontinue\n   237\t\t\t\t}\n   238\t\t\t\tvar a DelegatedReviewAttempt\n   239\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   240\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   241\t\t\t\t\tcontinue\n   242\t\t\t\t}\n   243\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif marked[a.AttemptID] {\n   248\t\t\t\t\tcontinue\n   249\t\t\t\t}\n   250\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   251\t\t\t\t\tcontinue\n   252\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   253\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   254\t\t\t\t\tcontinue\n   255\t\t\t\t}\n   256\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   257\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   258\t\t\t\t\tcontinue\n   259\t\t\t\t}\n   260\t\t\t\tout = append(out, a)\n   261\t\t\t}\n   262\t\t}\n   263\t\treturn out, lost, nil\n   264\t}\n   265\t\n   266\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   267\t\tdir, err := s.delegationActiveDir(false)\n   268\t\tif err != nil {\n   269\t\t\treturn err\n   270\t\t}\n   271\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   272\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   273\t\t\t\treturn err\n   274\t\t\t}\n   275\t\t}\n   276\t\treturn nil\n   277\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_reap_linux.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Leftover reviewer processes (spec\n     6\t// pose-review-run-reaps-lingering-reviewer-processes R1): an adapter such as\n     7\t// `codex exec` runs each command in a session of its own, so killing the\n     8\t// adapter's process group misses a command the reviewer left running, and\n     9\t// that command keeps writing into the run's runtime directory while the\n    10\t// cleanup inventory reads it. Every process of the run inherits\n    11\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n    12\t// that entry, ends them and waits for them before the inventory.\n    13\t//\n    14\t// Each process is pinned by a pidfd before it is signalled, and its\n    15\t// environment is read again through the pinned process, so a pid reused by\n    16\t// an unrelated process between the scan and the signal is never killed\n    17\t// (review round 1, N3). A scan that cannot list or read the state of the\n    18\t// processes fails. A process of this user whose environment cannot be read\n    19\t// (one that made itself non-inspectable) cannot be matched: one that already\n    20\t// existed before the adapter started is not the run's and is skipped; any\n    21\t// other may be the run's, so the scan fails and the run stays unconcludable\n    22\t// (review round 2, N2).\n    23\t\n    24\timport (\n    25\t\t\"bytes\"\n    26\t\t\"errors\"\n    27\t\t\"fmt\"\n    28\t\t\"io/fs\"\n    29\t\t\"os\"\n    30\t\t\"path/filepath\"\n    31\t\t\"strconv\"\n    32\t\t\"strings\"\n    33\t\t\"syscall\"\n    34\t\t\"time\"\n    35\t\n    36\t\t\"golang.org/x/sys/unix\"\n    37\t)\n    38\t\n    39\tconst reviewReapWait = 5 * time.Second\n    40\t\n    41\t// reapSealedCheckoutProcesses ends every process whose environment names\n    42\t// worktree as its sealed checkout and returns a description of each. An\n    43\t// error means the run's processes could not be proven ended within the bound.\n    44\tfunc reapSealedCheckoutProcesses(worktree string, baseline map[int]string) ([]string, int, error) {\n    45\t\tif worktree == \"\" {\n    46\t\t\treturn nil, 0, nil\n    47\t\t}\n    48\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n    49\t\tvar reaped []string\n    50\t\tseen := map[int]bool{}\n    51\t\tdeadline := time.Now().Add(reviewReapWait)\n    52\t\tunreadable := 0\n    53\t\tfor {\n    54\t\t\talive, opaque, err := reviewMarkedProcesses(entry)\n    55\t\t\tif err != nil {\n    56\t\t\t\treturn reaped, unreadable, err\n    57\t\t\t}\n    58\t\t\tunreadable = 0\n    59\t\t\tfor pid, start := range opaque {\n    60\t\t\t\tif baseline[pid] != start {\n    61\t\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"process %d of this user started during the run and cannot be inspected; it may be the run's and was not ended\", pid)\n    62\t\t\t\t}\n    63\t\t\t\tunreadable++\n    64\t\t\t}\n    65\t\t\tfor _, pid := range alive {\n    66\t\t\t\tif !seen[pid] {\n    67\t\t\t\t\tseen[pid] = true\n    68\t\t\t\t\treaped = append(reaped, fmt.Sprintf(\"%d %s\", pid, reviewProcessName(pid)))\n    69\t\t\t\t}\n    70\t\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n    71\t\t\t\t\treturn reaped, unreadable, err\n    72\t\t\t\t}\n    73\t\t\t}\n    74\t\t\tif len(alive) == 0 {\n    75\t\t\t\treturn reaped, unreadable, nil\n    76\t\t\t}\n    77\t\t\tif time.Now().After(deadline) {\n    78\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n    79\t\t\t}\n    80\t\t\ttime.Sleep(50 * time.Millisecond)\n    81\t\t}\n    82\t}\n    83\t\n    84\t// reviewMarkedProcesses lists the live processes whose environment holds\n    85\t// entry, and counts this user's processes whose environment could not be\n    86\t// read. A process that is gone is skipped.\n    87\tfunc reviewMarkedProcesses(entry []byte) ([]int, map[int]string, error) {\n    88\t\tdirs, err := os.ReadDir(\"/proc\")\n    89\t\tif err != nil {\n    90\t\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    91\t\t}\n    92\t\tunreadable := map[int]string{}\n    93\t\tself, uid := os.Getpid(), os.Getuid()\n    94\t\tvar out []int\n    95\t\tfor _, d := range dirs {\n    96\t\t\tpid, err := strconv.Atoi(d.Name())\n    97\t\t\tif err != nil || pid == self {\n    98\t\t\t\tcontinue\n    99\t\t\t}\n   100\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n   101\t\t\tswitch {\n   102\t\t\tcase reviewProcessGoneErr(err):\n   103\t\t\t\tcontinue\n   104\t\t\tcase err != nil:\n   105\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n   106\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n   107\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   108\t\t\t\t\tcontinue\n   109\t\t\t\t}\n   110\t\t\t\tstart, serr := processStartTime(pid)\n   111\t\t\t\tif reviewProcessGoneErr(serr) {\n   112\t\t\t\t\tcontinue\n   113\t\t\t\t}\n   114\t\t\t\tunreadable[pid] = start\n   115\t\t\t\tcontinue\n   116\t\t\tcase !marked:\n   117\t\t\t\tcontinue\n   118\t\t\t}\n   119\t\t\tzombie, err := reviewProcessZombie(pid)\n   120\t\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n   121\t\t\t\tcontinue\n   122\t\t\t}\n   123\t\t\tif err != nil {\n   124\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n   125\t\t\t}\n   126\t\t\tout = append(out, pid)\n   127\t\t}\n   128\t\treturn out, unreadable, nil\n   129\t}\n   130\t\n   131\t// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n   132\t// after the environment read through that same pinned process still holds\n   133\t// entry.\n   134\tfunc killPinnedMarkedProcess(pid int, entry []byte) error {\n   135\t\tfd, err := unix.PidfdOpen(pid, 0)\n   136\t\tif errors.Is(err, unix.ESRCH) {\n   137\t\t\treturn nil\n   138\t\t}\n   139\t\tif err != nil {\n   140\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   141\t\t}\n   142\t\tdefer unix.Close(fd)\n   143\t\t// The pidfd names one process for its lifetime; if pid was reused before\n   144\t\t// it was opened, the new process does not carry this run's entry.\n   145\t\tmarked, err := reviewProcessMarked(pid, entry)\n   146\t\tif reviewProcessGoneErr(err) || err == nil && !marked {\n   147\t\t\treturn nil\n   148\t\t}\n   149\t\tif err != nil {\n   150\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   151\t\t}\n   152\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   153\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   154\t\t}\n   155\t\treturn nil\n   156\t}\n   157\t\n   158\tfunc reviewProcessMarked(pid int, entry []byte) (bool, error) {\n   159\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   160\t\tif err != nil {\n   161\t\t\treturn false, err\n   162\t\t}\n   163\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n   164\t\t\tif bytes.Equal(kv, entry) {\n   165\t\t\t\treturn true, nil\n   166\t\t\t}\n   167\t\t}\n   168\t\treturn false, nil\n   169\t}\n   170\t\n   171\tfunc reviewProcessOwner(pid int) (int, error) {\n   172\t\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n   173\t\tif err != nil {\n   174\t\t\treturn 0, err\n   175\t\t}\n   176\t\tst, ok := info.Sys().(*syscall.Stat_t)\n   177\t\tif !ok {\n   178\t\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n   179\t\t}\n   180\t\treturn int(st.Uid), nil\n   181\t}\n   182\t\n   183\tfunc reviewProcessGoneErr(err error) bool {\n   184\t\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n   185\t}\n   186\t\n   187\tfunc reviewProcessName(pid int) string {\n   188\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n   189\t\tif err != nil {\n   190\t\t\treturn \"?\"\n   191\t\t}\n   192\t\treturn strings.TrimSpace(string(raw))\n   193\t}\n   194\t\n   195\tfunc reviewProcessZombie(pid int) (bool, error) {\n   196\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n   197\t\tif err != nil {\n   198\t\t\treturn false, err\n   199\t\t}\n   200\t\t// The state follows the parenthesised command name.\n   201\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   202\t\t\treturn raw[i+2] == 'Z', nil\n   203\t\t}\n   204\t\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n   205\t}\n   206\t\n   207\t// reviewOpaqueProcessBaseline records, before the adapter starts, the\n   208\t// processes of this user whose environment cannot be read, by pid and start\n   209\t// time: they cannot be the run's.\n   210\tfunc reviewOpaqueProcessBaseline() map[int]string {\n   211\t\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv + \"=\\x00\"))\n   212\t\treturn opaque\n   213\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_subreaper_linux.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Orphaned escapees (spec pose-review-run-reaps-lingering-reviewer-processes,\n     6\t// review round 6, N2): a descendant that leaves the adapter's process group\n     7\t// with a session of its own and clears its environment matches neither the\n     8\t// group kill nor the sealed-checkout entry. The dispatching process makes\n     9\t// itself a child subreaper, so such a process, once its parent ends, is\n    10\t// reparented to the dispatcher instead of to init; after the adapter exits,\n    11\t// every child of the dispatcher in a session other than the dispatcher's,\n    12\t// started after the adapter, is an orphan of a review run. One that names\n    13\t// another run's checkout belongs to that run and is left to it.\n    14\t\n    15\timport (\n    16\t\t\"errors\"\n    17\t\t\"fmt\"\n    18\t\t\"os\"\n    19\t\t\"path/filepath\"\n    20\t\t\"strconv\"\n    21\t\t\"strings\"\n    22\t\t\"time\"\n    23\t\n    24\t\t\"golang.org/x/sys/unix\"\n    25\t)\n    26\t\n    27\t// enableReviewSubreaper makes the dispatching process the subreaper of its\n    28\t// descendants. It is process-wide and idempotent.\n    29\tfunc enableReviewSubreaper() error {\n    30\t\treturn unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0)\n    31\t}\n    32\t\n    33\t// reviewClockTicks is now, in the clock ticks /proc/<pid>/stat uses for a\n    34\t// process start.\n    35\tfunc reviewClockTicks() (uint64, error) {\n    36\t\traw, err := os.ReadFile(\"/proc/uptime\")\n    37\t\tif err != nil {\n    38\t\t\treturn 0, err\n    39\t\t}\n    40\t\tfields := strings.Fields(string(raw))\n    41\t\tif len(fields) == 0 {\n    42\t\t\treturn 0, fmt.Errorf(\"unreadable uptime\")\n    43\t\t}\n    44\t\tseconds, err := strconv.ParseFloat(fields[0], 64)\n    45\t\tif err != nil {\n    46\t\t\treturn 0, err\n    47\t\t}\n    48\t\treturn uint64(seconds * 100), nil // USER_HZ is 100 on Linux\n    49\t}\n    50\t\n    51\ttype reviewProcStat struct {\n    52\t\tppid, session int\n    53\t\tstart         uint64\n    54\t}\n    55\t\n    56\tfunc readReviewProcStat(pid int) (reviewProcStat, error) {\n    57\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n    58\t\tif err != nil {\n    59\t\t\treturn reviewProcStat{}, err\n    60\t\t}\n    61\t\ttext := string(raw)\n    62\t\tend := strings.LastIndexByte(text, ')')\n    63\t\tif end < 0 {\n    64\t\t\treturn reviewProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n    65\t\t}\n    66\t\tf := strings.Fields(text[end+1:])\n    67\t\t// f[0] is field 3 (state): ppid is field 4, session field 6, start field 22.\n    68\t\tif len(f) < 20 {\n    69\t\t\treturn reviewProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n    70\t\t}\n    71\t\tppid, e1 := strconv.Atoi(f[1])\n    72\t\tsession, e2 := strconv.Atoi(f[3])\n    73\t\tstart, e3 := strconv.ParseUint(f[19], 10, 64)\n    74\t\tif e1 != nil || e2 != nil || e3 != nil {\n    75\t\t\treturn reviewProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n    76\t\t}\n    77\t\treturn reviewProcStat{ppid: ppid, session: session, start: start}, nil\n    78\t}\n    79\t\n    80\t// reapOrphanedEscapees ends the orphans of review runs reparented to this\n    81\t// process since since (clock ticks), and reaps them. entry is this run's\n    82\t// sealed-checkout entry; an orphan naming another run's checkout is left.\n    83\tfunc reapOrphanedEscapees(entry []byte, since uint64) ([]string, error) {\n    84\t\tself := os.Getpid()\n    85\t\tselfStat, err := readReviewProcStat(self)\n    86\t\tif err != nil {\n    87\t\t\treturn nil, err\n    88\t\t}\n    89\t\tvar ended []string\n    90\t\tdeadline := time.Now().Add(reviewReapWait)\n    91\t\tfor {\n    92\t\t\tdirs, err := os.ReadDir(\"/proc\")\n    93\t\t\tif err != nil {\n    94\t\t\t\treturn ended, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    95\t\t\t}\n    96\t\t\tfound := 0\n    97\t\t\tfor _, d := range dirs {\n    98\t\t\t\tpid, err := strconv.Atoi(d.Name())\n    99\t\t\t\tif err != nil || pid == self {\n   100\t\t\t\t\tcontinue\n   101\t\t\t\t}\n   102\t\t\t\tst, err := readReviewProcStat(pid)\n   103\t\t\t\tif err != nil || st.ppid != self || st.session == selfStat.session || st.start < since {\n   104\t\t\t\t\tcontinue\n   105\t\t\t\t}\n   106\t\t\t\tif other, err := reviewProcessOtherRun(pid, entry); err == nil && other {\n   107\t\t\t\t\tcontinue\n   108\t\t\t\t}\n   109\t\t\t\tfound++\n   110\t\t\t\tif zombie, _ := reviewProcessZombie(pid); !zombie {\n   111\t\t\t\t\tended = append(ended, fmt.Sprintf(\"%d %s (orphaned)\", pid, reviewProcessName(pid)))\n   112\t\t\t\t\tif err := killPinnedOrphan(pid, st); err != nil {\n   113\t\t\t\t\t\treturn ended, err\n   114\t\t\t\t\t}\n   115\t\t\t\t}\n   116\t\t\t\t// It is this process's child now: reap it, so it leaves no zombie.\n   117\t\t\t\tvar status unix.WaitStatus\n   118\t\t\t\t_, _ = unix.Wait4(pid, &status, unix.WNOHANG, nil)\n   119\t\t\t}\n   120\t\t\tif found == 0 {\n   121\t\t\t\treturn ended, nil\n   122\t\t\t}\n   123\t\t\tif time.Now().After(deadline) {\n   124\t\t\t\treturn ended, fmt.Errorf(\"%d orphaned process(es) of the run could not be ended\", found)\n   125\t\t\t}\n   126\t\t\ttime.Sleep(50 * time.Millisecond)\n   127\t\t}\n   128\t}\n   129\t\n   130\t// reviewProcessOtherRun reports a process whose environment names another\n   131\t// run's sealed checkout.\n   132\tfunc reviewProcessOtherRun(pid int, entry []byte) (bool, error) {\n   133\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   134\t\tif err != nil {\n   135\t\t\treturn false, err\n   136\t\t}\n   137\t\tprefix := SealedCheckoutEnv + \"=\"\n   138\t\tfor _, kv := range strings.Split(string(environ), \"\\x00\") {\n   139\t\t\tif strings.HasPrefix(kv, prefix) {\n   140\t\t\t\treturn kv != string(entry), nil\n   141\t\t\t}\n   142\t\t}\n   143\t\treturn false, nil\n   144\t}\n   145\t\n   146\t// killPinnedOrphan signals pid through a pidfd, after the pinned process is\n   147\t// still the orphan seen (same parent, session and start).\n   148\tfunc killPinnedOrphan(pid int, seen reviewProcStat) error {\n   149\t\tfd, err := unix.PidfdOpen(pid, 0)\n   150\t\tif errors.Is(err, unix.ESRCH) {\n   151\t\t\treturn nil\n   152\t\t}\n   153\t\tif err != nil {\n   154\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   155\t\t}\n   156\t\tdefer unix.Close(fd)\n   157\t\tnow, err := readReviewProcStat(pid)\n   158\t\tif reviewProcessGoneErr(err) || err == nil && now != seen {\n   159\t\t\treturn nil\n   160\t\t}\n   161\t\tif err != nil {\n   162\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   163\t\t}\n   164\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   165\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   166\t\t}\n   167\t\treturn nil\n   168\t}\n","exit_code":0,"status":"completed"}}
