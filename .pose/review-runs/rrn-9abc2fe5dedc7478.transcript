yte(SealedCheckoutEnv+\"=\"+worktree), adapterSince)\n+\t\treaped = append(reaped, orphans...)\n+\t\tif orphanErr != nil {\n+\t\t\tterminationErr = errors.Join(terminationErr, orphanErr)\n+\t\t}\n+\t}\n+\tif len(reaped) > 0 && safety != nil {\n+\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n+\t}\n+\tif opaque > 0 && reapErr == nil && safety != nil {\n+\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n+\t}\n \tterminationFailed = terminationErr != nil\n \t// The adapter exited and a child it left still held the output when\n \t// WaitDelay expired: the run finished, its leftover is killed above, and\n@@ -1459,6 +1504,10 @@ func tail(s string, n int) string {\n \treturn s[len(s)-n:]\n }\n \n+// beforeAttemptPublished runs between the active marker and the reservation;\n+// tests use it to stop a dispatch there.\n+var beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {}\n+\n func (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\n \t// Identity covers only persisted content, never fields derived by a reader\n \t// or a previous write of a copied record.\ndiff --git a/pose-mcp/internal/pose/review_reap_linux.go b/pose-mcp/internal/pose/review_reap_linux.go\nnew file mode 100644\nindex 00000000..218b0050\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_reap_linux.go\n@@ -0,0 +1,213 @@\n+//go:build linux\n+\n+package pose\n+\n+// Leftover reviewer processes (spec\n+// pose-review-run-reaps-lingering-reviewer-processes R1): an adapter such as\n+// `codex exec` runs each command in a session of its own, so killing the\n+// adapter's process group misses a command the reviewer left running, and\n+// that command keeps writing into the run's runtime directory while the\n+// cleanup inventory reads it. Every process of the run inherits\n+// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n+// that entry, ends them and waits for them before the inventory.\n+//\n+// Each process is pinned by a pidfd before it is signalled, and its\n+// environment is read again through the pinned process, so a pid reused by\n+// an unrelated process between the scan and the signal is never killed\n+// (review round 1, N3). A scan that cannot list or read the state of the\n+// processes fails. A process of this user whose environment cannot be read\n+// (one that made itself non-inspectable) cannot be matched: one that already\n+// existed before the adapter started is not the run's and is skipped; any\n+// other may be the run's, so the scan fails and the run stays unconcludable\n+// (review round 2, N2).\n+\n+import (\n+\t\"bytes\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io/fs\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strconv\"\n+\t\"strings\"\n+\t\"syscall\"\n+\t\"time\"\n+\n+\t\"golang.org/x/sys/unix\"\n+)\n+\n+const reviewReapWait = 5 * time.Second\n+\n+// reapSealedCheckoutProcesses ends every process whose environment names\n+// worktree as its sealed checkout and returns a description of each. An\n+// error means the run's processes could not be proven ended within the bound.\n+func reapSealedCheckoutProcesses(worktree string, baseline map[int]string) ([]string, int, error) {\n+\tif worktree == \"\" {\n+\t\treturn nil, 0, nil\n+\t}\n+\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n+\tvar reaped []string\n+\tseen := map[int]bool{}\n+\tdeadline := time.Now().Add(reviewReapWait)\n+\tunreadable := 0\n+\tfor {\n+\t\talive, opaque, err := reviewMarkedProcesses(entry)\n+\t\tif err != nil {\n+\t\t\treturn reaped, unreadable, err\n+\t\t}\n+\t\tunreadable = 0\n+\t\tfor pid, start := range opaque {\n+\t\t\tif baseline[pid] != start {\n+\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"process %d of this user started during the run and cannot be inspected; it may be the run's and was not ended\", pid)\n+\t\t\t}\n+\t\t\tunreadable++\n+\t\t}\n+\t\tfor _, pid := range alive {\n+\t\t\tif !seen[pid] {\n+\t\t\t\tseen[pid] = true\n+\t\t\t\treaped = append(reaped, fmt.Sprintf(\"%d %s\", pid, reviewProcessName(pid)))\n+\t\t\t}\n+\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n+\t\t\t\treturn reaped, unreadable, err\n+\t\t\t}\n+\t\t}\n+\t\tif len(alive) == 0 {\n+\t\t\treturn reaped, unreadable, nil\n+\t\t}\n+\t\tif time.Now().After(deadline) {\n+\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n+\t\t}\n+\t\ttime.Sleep(50 * time.Millisecond)\n+\t}\n+}\n+\n+// reviewMarkedProcesses lists the live processes whose environment holds\n+// entry, and counts this user's processes whose environment could not be\n+// read. A process that is gone is skipped.\n+func reviewMarkedProcesses(entry []byte) ([]int, map[int]string, error) {\n+\tdirs, err := os.ReadDir(\"/proc\")\n+\tif err != nil {\n+\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n+\t}\n+\tunreadable := map[int]string{}\n+\tself, uid := os.Getpid(), os.Getuid()\n+\tvar out []int\n+\tfor _, d := range dirs {\n+\t\tpid, err := strconv.Atoi(d.Name())\n+\t\tif err != nil || pid == self {\n+\t\t\tcontinue\n+\t\t}\n+\t\tmarked, err := reviewProcessMarked(pid, entry)\n+\t\tswitch {\n+\t\tcase reviewProcessGoneErr(err):\n+\t\t\tcontinue\n+\t\tcase err != nil:\n+\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n+\t\t\t\tcontinue // another user's process never inherits this run's environment\n+\t\t\t} else if reviewProcessGoneErr(oerr) {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tstart, serr := processStartTime(pid)\n+\t\t\tif reviewProcessGoneErr(serr) {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tunreadable[pid] = start\n+\t\t\tcontinue\n+\t\tcase !marked:\n+\t\t\tcontinue\n+\t\t}\n+\t\tzombie, err := reviewProcessZombie(pid)\n+\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif err != nil {\n+\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n+\t\t}\n+\t\tout = append(out, pid)\n+\t}\n+\treturn out, unreadable, nil\n+}\n+\n+// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n+// after the environment read through that same pinned process still holds\n+// entry.\n+func killPinnedMarkedProcess(pid int, entry []byte) error {\n+\tfd, err := unix.PidfdOpen(pid, 0)\n+\tif errors.Is(err, unix.ESRCH) {\n+\t\treturn nil\n+\t}\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n+\t}\n+\tdefer unix.Close(fd)\n+\t// The pidfd names one process for its lifetime; if pid was reused before\n+\t// it was opened, the new process does not carry this run's entry.\n+\tmarked, err := reviewProcessMarked(pid, entry)\n+\tif reviewProcessGoneErr(err) || err == nil && !marked {\n+\t\treturn nil\n+\t}\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n+\t}\n+\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n+\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n+\t}\n+\treturn nil\n+}\n+\n+func reviewProcessMarked(pid int, entry []byte) (bool, error) {\n+\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n+\tif err != nil {\n+\t\treturn false, err\n+\t}\n+\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n+\t\tif bytes.Equal(kv, entry) {\n+\t\t\treturn true, nil\n+\t\t}\n+\t}\n+\treturn false, nil\n+}\n+\n+func reviewProcessOwner(pid int) (int, error) {\n+\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n+\tif err != nil {\n+\t\treturn 0, err\n+\t}\n+\tst, ok := info.Sys().(*syscall.Stat_t)\n+\tif !ok {\n+\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n+\t}\n+\treturn int(st.Uid), nil\n+}\n+\n+func reviewProcessGoneErr(err error) bool {\n+\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n+}\n+\n+func reviewProcessName(pid int) string {\n+\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n+\tif err != nil {\n+\t\treturn \"?\"\n+\t}\n+\treturn strings.TrimSpace(string(raw))\n+}\n+\n+func reviewProcessZombie(pid int) (bool, error) {\n+\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n+\tif err != nil {\n+\t\treturn false, err\n+\t}\n+\t// The state follows the parenthesised command name.\n+\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n+\t\treturn raw[i+2] == 'Z', nil\n+\t}\n+\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n+}\n+\n+// reviewOpaqueProcessBaseline records, before the adapter starts, the\n+// processes of this user whose environment cannot be read, by pid and start\n+// time: they cannot be the run's.\n+func reviewOpaqueProcessBaseline() map[int]string {\n+\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv + \"=\\x00\"))\n+\treturn opaque\n+}\ndiff --git a/pose-mcp/internal/pose/review_subreaper_linux.go b/pose-mcp/internal/pose/review_subreaper_linux.go\nnew file mode 100644\nindex 00000000..1e7083b3\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_subreaper_linux.go\n@@ -0,0 +1,168 @@\n+//go:build linux\n+\n+package pose\n+\n+// Orphaned escapees (spec pose-review-run-reaps-lingering-reviewer-processes,\n+// review round 6, N2): a descendant that leaves the adapter's process group\n+// with a session of its own and clears its environment matches neither the\n+// group kill nor the sealed-checkout entry. The dispatching process makes\n+// itself a child subreaper, so such a process, once its parent ends, is\n+// reparented to the dispatcher instead of to init; after the adapter exits,\n+// every child of the dispatcher in a session other than the dispatcher's,\n+// started after the adapter, is an orphan of a review run. One that names\n+// another run's checkout belongs to that run and is left to it.\n+\n+import (\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strconv\"\n+\t\"strings\"\n+\t\"time\"\n+\n+\t\"golang.org/x/sys/unix\"\n+)\n+\n+// enableReviewSubreaper makes the dispatching process the subreaper of its\n+// descendants. It is process-wide and idempotent.\n+func enableReviewSubreaper() error {\n+\treturn unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0)\n+}\n+\n+// reviewClockTicks is now, in the clock ticks /proc/<pid>/stat uses for a\n+// process start.\n+func reviewClockTicks() (uint64, error) {\n+\traw, err := os.ReadFile(\"/proc/uptime\")\n+\tif err != nil {\n+\t\treturn 0, err\n+\t}\n+\tfields := strings.Fields(string(raw))\n+\tif len(fields) == 0 {\n+\t\treturn 0, fmt.Errorf(\"unreadable uptime\")\n+\t}\n+\tseconds, err := strconv.ParseFloat(fields[0], 64)\n+\tif err != nil {\n+\t\treturn 0, err\n+\t}\n+\treturn uint64(seconds * 100), nil // USER_HZ is 100 on Linux\n+}\n+\n+type reviewProcStat struct {\n+\tppid, session int\n+\tstart         uint64\n+}\n+\n+func readReviewProcStat(pid int) (reviewProcStat, error) {\n+\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n+\tif err != nil {\n+\t\treturn reviewProcStat{}, err\n+\t}\n+\ttext := string(raw)\n+\tend := strings.LastIndexByte(text, ')')\n+\tif end < 0 {\n+\t\treturn reviewProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n+\t}\n+\tf := strings.Fields(text[end+1:])\n+\t// f[0] is field 3 (state): ppid is field 4, session field 6, start field 22.\n+\tif len(f) < 20 {\n+\t\treturn reviewProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n+\t}\n+\tppid, e1 := strconv.Atoi(f[1])\n+\tsession, e2 := strconv.Atoi(f[3])\n+\tstart, e3 := strconv.ParseUint(f[19], 10, 64)\n+\tif e1 != nil || e2 != nil || e3 != nil {\n+\t\treturn reviewProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n+\t}\n+\treturn reviewProcStat{ppid: ppid, session: session, start: start}, nil\n+}\n+\n+// reapOrphanedEscapees ends the orphans of review runs reparented to this\n+// process since since (clock ticks), and reaps them. entry is this run's\n+// sealed-checkout entry; an orphan naming another run's checkout is left.\n+func reapOrphanedEscapees(entry []byte, since uint64) ([]string, error) {\n+\tself := os.Getpid()\n+\tselfStat, err := readReviewProcStat(self)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tvar ended []string\n+\tdeadline := time.Now().Add(reviewReapWait)\n+\tfor {\n+\t\tdirs, err := os.ReadDir(\"/proc\")\n+\t\tif err != nil {\n+\t\t\treturn ended, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n+\t\t}\n+\t\tfound := 0\n+\t\tfor _, d := range dirs {\n+\t\t\tpid, err := strconv.Atoi(d.Name())\n+\t\t\tif err != nil || pid == self {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tst, err := readReviewProcStat(pid)\n+\t\t\tif err != nil || st.ppid != self || st.session == selfStat.session || st.start < since {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tif other, err := reviewProcessOtherRun(pid, entry); err == nil && other {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tfound++\n+\t\t\tif zombie, _ := reviewProcessZombie(pid); !zombie {\n+\t\t\t\tended = append(ended, fmt.Sprintf(\"%d %s (orphaned)\", pid, reviewProcessName(pid)))\n+\t\t\t\tif err := killPinnedOrphan(pid, st); err != nil {\n+\t\t\t\t\treturn ended, err\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\t// It is this process's child now: reap it, so it leaves no zombie.\n+\t\t\tvar status unix.WaitStatus\n+\t\t\t_, _ = unix.Wait4(pid, &status, unix.WNOHANG, nil)\n+\t\t}\n+\t\tif found == 0 {\n+\t\t\treturn ended, nil\n+\t\t}\n+\t\tif time.Now().After(deadline) {\n+\t\t\treturn ended, fmt.Errorf(\"%d orphaned process(es) of the run could not be ended\", found)\n+\t\t}\n+\t\ttime.Sleep(50 * time.Millisecond)\n+\t}\n+}\n+\n+// reviewProcessOtherRun reports a process whose environment names another\n+// run's sealed checkout.\n+func reviewProcessOtherRun(pid int, entry []byte) (bool, error) {\n+\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n+\tif err != nil {\n+\t\treturn false, err\n+\t}\n+\tprefix := SealedCheckoutEnv + \"=\"\n+\tfor _, kv := range strings.Split(string(environ), \"\\x00\") {\n+\t\tif strings.HasPrefix(kv, prefix) {\n+\t\t\treturn kv != string(entry), nil\n+\t\t}\n+\t}\n+\treturn false, nil\n+}\n+\n+// killPinnedOrphan signals pid through a pidfd, after the pinned process is\n+// still the orphan seen (same parent, session and start).\n+func killPinnedOrphan(pid int, seen reviewProcStat) error {\n+\tfd, err := unix.PidfdOpen(pid, 0)\n+\tif errors.Is(err, unix.ESRCH) {\n+\t\treturn nil\n+\t}\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n+\t}\n+\tdefer unix.Close(fd)\n+\tnow, err := readReviewProcStat(pid)\n+\tif reviewProcessGoneErr(err) || err == nil && now != seen {\n+\t\treturn nil\n+\t}\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n+\t}\n+\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n+\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n+\t}\n+\treturn nil\n+}\n","exit_code":0,"status":"completed"}}
