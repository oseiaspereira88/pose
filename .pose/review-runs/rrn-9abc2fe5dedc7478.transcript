{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/usr/bin/bash -lc 'git diff -U4 ddb770352f35f2f55c740e9a8479686de3a251e5..f5c4a2941d9d1efeb65154395a80f6c26401d76 -- pose-mcp/internal/pose/review_dispatch.go'","aggregated_output":"diff --git a/pose-mcp/internal/pose/review_dispatch.go b/pose-mcp/internal/pose/review_dispatch.go\nindex 88a753fa..fb43ba90 100644\n--- a/pose-mcp/internal/pose/review_dispatch.go\n+++ b/pose-mcp/internal/pose/review_dispatch.go\n@@ -712,9 +712,9 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t}\n \tvar attempt DelegatedReviewAttempt\n \tif plan.predecessor == nil {\n \t\tvar err error\n-\t\tattempt, err = s.reserveDelegatedReviewAttempt(plan, now())\n+\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n \t\tif err != nil {\n \t\t\treturn ReviewRun{}, err\n \t\t}\n \t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n@@ -748,10 +748,11 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t// The attempt result is published once: before the active marker goes\n \t// when the run was marked, at return otherwise (spec\n \t// pose-delegation-result-before-marker R1–R2).\n \tresultPublished := false\n+\treserved := plan.predecessor != nil\n \tpublishResult := func() {\n-\t\tif resultPublished || result.RunID == \"\" {\n+\t\tif resultPublished || result.RunID == \"\" || !reserved {\n \t\t\treturn\n \t\t}\n \t\tresultPublished = true\n \t\tbeforeRunResultPublished(result)\n@@ -767,10 +768,28 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t}\n \tdefer publishResult()\n \tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n \tif err != nil {\n+\t\tif plan.predecessor == nil {\n+\t\t\t// The attempt is reserved anyway, so the failed run and its\n+\t\t\t// receipt are recorded against it, as before the marker moved\n+\t\t\t// ahead of the reservation (spec\n+\t\t\t// pose-delegation-result-before-marker R1–R2).\n+\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n+\t\t\t\treturn ReviewRun{}, perr\n+\t\t\t}\n+\t\t\treserved = true\n+\t\t}\n \t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n \t}\n+\tif plan.predecessor == nil {\n+\t\tbeforeAttemptPublished(s, attempt)\n+\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n+\t\t\tstopActive()\n+\t\t\treturn ReviewRun{}, err\n+\t\t}\n+\t\treserved = true\n+\t}\n \t// The marker goes only once the record and the attempt result are\n \t// published: without them it is the one trace of the reserved attempt,\n \t// and a waiter that sees it gone must find the receipt.\n \tdefer func() {\n@@ -1001,8 +1020,13 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t// only the parent left a child holding stdout, so the timeout never fired\n \t// (found in review). The run gets its own process group, the whole group\n \t// is killed on timeout and after the run, and pipes are released at most\n \t// a few seconds after the kill.\n+\topaqueBaseline := reviewOpaqueProcessBaseline()\n+\t// Orphans of the run are reparented to this process, so one that left\n+\t// the group and cleared its environment is still found (review round 6, N2).\n+\tsubreaper := enableReviewSubreaper() == nil\n+\tadapterSince, _ := reviewClockTicks()\n \tisolateProcessGroup(cmd)\n \tcmd.WaitDelay = AdapterPipeGrace\n \tvar runErr error\n \tif run.Provenance == nil {\n@@ -1015,8 +1039,29 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t\t\trun.Provenance.ExecutionState = \"started\"\n \t\t}\n \t}\n \tterminationErr = killProcessGroup(cmd)\n+\t// A command the reviewer left running in a session of its own escapes the\n+\t// group kill; it is ended here, before the cleanup inventory reads the\n+\t// directories it may still write (spec\n+\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n+\treaped, opaque, reapErr := reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n+\tif reapErr != nil {\n+\t\tterminationErr = errors.Join(terminationErr, reapErr)\n+\t}\n+\tif subreaper && reapErr == nil {\n+\t\torphans, orphanErr := reapOrphanedEscapees([]byte(SealedCheckoutEnv+\"=\"+worktree), adapterSince)\n+\t\treaped = append(reaped, orphans...)\n+\t\tif orphanErr != nil {\n+\t\t\tterminationErr = errors.Join(terminationErr, orphanErr)\n+\t\t}\n+\t}\n+\tif len(reaped) > 0 && safety != nil {\n+\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n+\t}\n+\tif opaque > 0 && reapErr == nil && safety != nil {\n+\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n+\t}\n \tterminationFailed = terminationErr != nil\n \t// The adapter exited and a child it left still held the output when\n \t// WaitDelay expired: the run finished, its leftover is killed above, and\n \t// the exit status decides (found in review).\n@@ -1458,8 +1503,12 @@ func tail(s string, n int) string {\n \t}\n \treturn s[len(s)-n:]\n }\n \n+// beforeAttemptPublished runs between the active marker and the reservation;\n+// tests use it to stop a dispatch there.\n+var beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {}\n+\n func (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\n \t// Identity covers only persisted content, never fields derived by a reader\n \t// or a previous write of a copied record.\n \trun.RunID, run.Path, run.TranscriptPath, run.SupersededBy = \"\", \"\", \"\", \"\"\n","exit_code":0,"status":"completed"}}
