{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '990,1125p'\"","aggregated_output":"   990\t\t// review.\n   991\t\tif plan.Purpose == DelegationPurposeReview {\n   992\t\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n   993\t\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n   994\t\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n   995\t\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n   996\t\t\t\t\t// engine that dispatched the run is the one that checks it.\n   997\t\t\t\t\tif self, err := os.Executable(); err == nil {\n   998\t\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n   999\t\t\t\t\t}\n  1000\t\t\t\t}\n  1001\t\t\t}\n  1002\t\t}\n  1003\t\tcmd.Env = env\n  1004\t\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n  1005\t\tcmd.Stdout, cmd.Stderr = combined, combined\n  1006\t\t// pose delegate watch follows the normalized, redacted events as they come\n  1007\t\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n  1008\t\t// the record is published.\n  1009\t\tsessionPattern := \"\"\n  1010\t\tif plan.Config.Session != nil {\n  1011\t\t\tsessionPattern = plan.Config.Session.Pattern\n  1012\t\t}\n  1013\t\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n  1014\t\t\ttee := io.MultiWriter(combined, live)\n  1015\t\t\tcmd.Stdout, cmd.Stderr = tee, tee\n  1016\t\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n  1017\t\t\tdefer live.Close()\n  1018\t\t}\n  1019\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n  1020\t\t// only the parent left a child holding stdout, so the timeout never fired\n  1021\t\t// (found in review). The run gets its own process group, the whole group\n  1022\t\t// is killed on timeout and after the run, and pipes are released at most\n  1023\t\t// a few seconds after the kill.\n  1024\t\topaqueBaseline := reviewOpaqueProcessBaseline()\n  1025\t\t// Orphans of the run are reparented to this process, so one that left\n  1026\t\t// the group and cleared its environment is still found (review round 6, N2).\n  1027\t\tsubreaper := enableReviewSubreaper() == nil\n  1028\t\tadapterSince, _ := reviewClockTicks()\n  1029\t\tisolateProcessGroup(cmd)\n  1030\t\tcmd.WaitDelay = AdapterPipeGrace\n  1031\t\tvar runErr error\n  1032\t\tif run.Provenance == nil {\n  1033\t\t\trunErr = cmd.Run()\n  1034\t\t} else {\n  1035\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1036\t\t\trunErr = err\n  1037\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1038\t\t\tif started {\n  1039\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1040\t\t\t}\n  1041\t\t}\n  1042\t\tterminationErr = killProcessGroup(cmd)\n  1043\t\t// A command the reviewer left running in a session of its own escapes the\n  1044\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1045\t\t// directories it may still write (spec\n  1046\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1047\t\treaped, opaque, reapErr := reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n  1048\t\tif reapErr != nil {\n  1049\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1050\t\t}\n  1051\t\tif subreaper && reapErr == nil {\n  1052\t\t\torphans, orphanErr := reapOrphanedEscapees([]byte(SealedCheckoutEnv+\"=\"+worktree), adapterSince)\n  1053\t\t\treaped = append(reaped, orphans...)\n  1054\t\t\tif orphanErr != nil {\n  1055\t\t\t\tterminationErr = errors.Join(terminationErr, orphanErr)\n  1056\t\t\t}\n  1057\t\t}\n  1058\t\tif len(reaped) > 0 && safety != nil {\n  1059\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n  1060\t\t}\n  1061\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1062\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1063\t\t}\n  1064\t\tterminationFailed = terminationErr != nil\n  1065\t\t// The adapter exited and a child it left still held the output when\n  1066\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1067\t\t// the exit status decides (found in review).\n  1068\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1069\t\t\trunErr = nil\n  1070\t\t}\n  1071\t\ttranscript, overflow := combined.result()\n  1072\t\tsafety.CaptureComplete = !overflow\n  1073\t\tif cmd.ProcessState != nil {\n  1074\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1075\t\t}\n  1076\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n  1077\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n  1078\t\t\tsafety.CaptureComplete = false\n  1079\t\t}\n  1080\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1081\t\t\trun.Output = string(raw)\n  1082\t\t\tif run.Provenance != nil {\n  1083\t\t\t\trun.Provenance.OutputComplete = true\n  1084\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1085\t\t\t}\n  1086\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1087\t\t\t// The agent writes no output file; its stream names its final message.\n  1088\t\t\trun.Output = final\n  1089\t\t\tif run.Provenance != nil {\n  1090\t\t\t\trun.Provenance.OutputComplete = true\n  1091\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1092\t\t\t}\n  1093\t\t} else {\n  1094\t\t\trun.Output = tail(string(transcript), 20000)\n  1095\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1096\t\t\t\tsafety.CaptureComplete = false\n  1097\t\t\t}\n  1098\t\t\tif run.Provenance != nil {\n  1099\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1100\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1101\t\t\t}\n  1102\t\t}\n  1103\t\tif run.Provenance != nil {\n  1104\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n  1105\t\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n  1106\t\t}\n  1107\t\tif runErr != nil && cmd.ProcessState == nil {\n  1108\t\t\trun.Output, transcript = \"\", nil\n  1109\t\t\tif run.Provenance != nil {\n  1110\t\t\t\trun.Provenance.OutputComplete = false\n  1111\t\t\t}\n  1112\t\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n  1113\t\t}\n  1114\t\t// Raw provenance hashes above precede redaction; only complete, bounded\n  1115\t\t// redacted channels can be retained. Partial boundaries can expose a secret.\n  1116\t\tsafety.ExecutionCause = executionCause(ctx)\n  1117\t\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n  1118\t\t\tsafety.CaptureComplete = false\n  1119\t\t}\n  1120\t\tif !safety.CaptureComplete {\n  1121\t\t\ttranscript = nil\n  1122\t\t\trun.Output = \"\"\n  1123\t\t\tif run.Provenance != nil {\n  1124\t\t\t\trun.Provenance.OutputComplete = false\n  1125\t\t\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux_test.go | sed -n '1,500p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os\"\n     7\t\t\"os/exec\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strconv\"\n    10\t\t\"strings\"\n    11\t\t\"syscall\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\t// Review round 1, N3: a pid that no longer names a process of the run, as\n    17\t// after reuse by an unrelated process, is never signalled.\n    18\tfunc TestAPidThatLostTheRunsEntryIsNotKilled(t *testing.T) {\n    19\t\tother := exec.Command(\"sleep\", \"30\")\n    20\t\tif err := other.Start(); err != nil {\n    21\t\t\tt.Fatal(err)\n    22\t\t}\n    23\t\tfor i := 0; i < 200 && reviewProcessName(other.Process.Pid) != \"sleep\"; i++ {\n    24\t\t\ttime.Sleep(10 * time.Millisecond)\n    25\t\t}\n    26\t\tt.Cleanup(func() { _ = other.Process.Kill(); _ = other.Wait() })\n    27\t\tentry := []byte(SealedCheckoutEnv + \"=/nonexistent/run-checkout\")\n    28\t\tif err := killPinnedMarkedProcess(other.Process.Pid, entry); err != nil {\n    29\t\t\tt.Fatal(err)\n    30\t\t}\n    31\t\ttime.Sleep(100 * time.Millisecond)\n    32\t\tif zombie, err := reviewProcessZombie(other.Process.Pid); err != nil || zombie {\n    33\t\t\tt.Fatalf(\"a process without the run's entry was killed: zombie=%t %v\", zombie, err)\n    34\t\t}\n    35\t\t// The same process carrying the entry is ended.\n    36\t\tmarked := exec.Command(\"sleep\", \"30\")\n    37\t\tmarked.Env = append(marked.Environ(), string(entry))\n    38\t\tif err := marked.Start(); err != nil {\n    39\t\t\tt.Fatal(err)\n    40\t\t}\n    41\t\t// Until exec, /proc shows the parent's environment.\n    42\t\tfor i := 0; i < 200; i++ {\n    43\t\t\tif ok, _ := reviewProcessMarked(marked.Process.Pid, entry); ok {\n    44\t\t\t\tbreak\n    45\t\t\t}\n    46\t\t\ttime.Sleep(10 * time.Millisecond)\n    47\t\t}\n    48\t\tif err := killPinnedMarkedProcess(marked.Process.Pid, entry); err != nil {\n    49\t\t\tt.Fatal(err)\n    50\t\t}\n    51\t\tif err := marked.Wait(); err == nil {\n    52\t\t\tt.Fatal(\"the marked process was not ended\")\n    53\t\t}\n    54\t}\n    55\t\n    56\t// opaqueProcess starts a process of this user whose environment cannot be\n    57\t// read (it makes itself non-dumpable), or skips without python3.\n    58\tfunc opaqueProcess(t *testing.T) *exec.Cmd {\n    59\t\tt.Helper()\n    60\t\tif _, err := exec.LookPath(\"python3\"); err != nil {\n    61\t\t\tt.Skip(\"python3 is not available\")\n    62\t\t}\n    63\t\tcmd := exec.Command(\"python3\", \"-c\", \"import ctypes,time; ctypes.CDLL(None).prctl(4,0,0,0,0); time.sleep(30)\")\n    64\t\tif err := cmd.Start(); err != nil {\n    65\t\t\tt.Fatal(err)\n    66\t\t}\n    67\t\tt.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })\n    68\t\tfor i := 0; i < 300; i++ {\n    69\t\t\tif _, err := reviewProcessMarked(cmd.Process.Pid, []byte(\"x\")); err != nil && !reviewProcessGoneErr(err) {\n    70\t\t\t\treturn cmd\n    71\t\t\t}\n    72\t\t\ttime.Sleep(10 * time.Millisecond)\n    73\t\t}\n    74\t\tt.Skip(\"the process never became non-inspectable\")\n    75\t\treturn nil\n    76\t}\n    77\t\n    78\t// Review round 2, N2: a non-inspectable process that existed before the run\n    79\t// is not the run's; one that started during it may be, and the scan fails\n    80\t// instead of reporting the run's processes ended.\n    81\tfunc TestANonInspectableProcessStartedDuringTheRunFailsTheScan(t *testing.T) {\n    82\t\tbefore := opaqueProcess(t)\n    83\t\tbaseline := reviewOpaqueProcessBaseline()\n    84\t\tif _, ok := baseline[before.Process.Pid]; !ok {\n    85\t\t\tt.Fatalf(\"the baseline misses process %d\", before.Process.Pid)\n    86\t\t}\n    87\t\tif _, opaque, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err != nil || opaque == 0 {\n    88\t\t\tt.Fatalf(\"a process that predates the run failed the scan or was not counted: %d %v\", opaque, err)\n    89\t\t}\n    90\t\tduring := opaqueProcess(t)\n    91\t\tif _, _, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err == nil || !strings.Contains(err.Error(), \"started during the run\") {\n    92\t\t\tt.Fatalf(\"process %d, started during the run, did not fail the scan: %v\", during.Process.Pid, err)\n    93\t\t}\n    94\t}\n    95\t\n    96\t// Review round 6, N2: a descendant that leaves the group, starts its own\n    97\t// session and clears its environment is still ended with the run.\n    98\tfunc TestAnOrphanThatClearedItsEnvironmentIsEnded(t *testing.T) {\n    99\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   100\t\t\tt.Skip(\"setsid is not available\")\n   101\t\t}\n   102\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   103\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   104\t\t\ta.Containment = containmentPolicy()\n   105\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & ` +\n   106\t\t\t\t`i=0; while [ ! -s \"$1\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`, \"sh\", pidFile}\n   107\t\t})\n   108\t\traw, err := os.ReadFile(pidFile)\n   109\t\tif err != nil {\n   110\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   111\t\t}\n   112\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   113\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   114\t\tif zombie, err := reviewProcessZombie(pid); err == nil && !zombie {\n   115\t\t\tt.Fatalf(\"the orphan that cleared its environment survived the run (status %s: %s)\", f.run.Status, f.run.Failure)\n   116\t\t}\n   117\t\tif f.run.Status != ReviewRunCompleted || !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), \"(orphaned)\") {\n   118\t\t\tt.Fatalf(\"the run did not complete naming the orphan: %s %s %v\", f.run.Status, f.run.Failure, f.run.Safety.Limitations)\n   119\t\t}\n   120\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '1,460p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"context\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"path/filepath\"\n    12\t\t\"strings\"\n    13\t\t\"syscall\"\n    14\t\t\"testing\"\n    15\t\t\"time\"\n    16\t)\n    17\t\n    18\t// Spec pose-review-run-reaps-lingering-reviewer-processes R5, R6: a dispatch\n    19\t// that ended between its reservation and its run record leaves an attempt\n    20\t// that blocks the bundle; once its owner is proven gone, cancel releases it\n    21\t// with a failed run and its receipt, and the ledger reads again.\n    22\tfunc TestAnAbandonedAttemptIsReleasedWithARecord(t *testing.T) {\n    23\t\troot := t.TempDir()\n    24\t\ts := Store{Root: root}\n    25\t\tbundle := \"rvb-00000000000000a1\"\n    26\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n    27\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"0\", 32)}\n    28\t\ta.AttemptID = attemptIdentity(a)\n    29\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    30\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    31\t\t\tt.Fatal(err)\n    32\t\t}\n    33\t\t// The ledger refuses the bundle while the reservation has no receipt.\n    34\t\tif _, err := s.readAttemptReceipt(a); err == nil || !strings.Contains(err.Error(), \"incomplete or unreadable\") {\n    35\t\t\tt.Fatalf(\"an unfinished reservation read as finished: %v\", err)\n    36\t\t}\n    37\t\n    38\t\t// The marker the interrupted dispatch left: its owner is a process that\n    39\t\t// has exited.\n    40\t\tdead := exec.Command(\"true\")\n    41\t\tif err := dead.Run(); err != nil {\n    42\t\t\tt.Fatal(err)\n    43\t\t}\n    44\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    45\t\towner.Host, _ = os.Hostname()\n    46\t\tidentifyStartLockProcess(&owner)\n    47\t\towner.PID = dead.Process.Pid\n    48\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"b\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: a.Scope, BundleID: bundle,\n    49\t\t\tStartedAt: a.ReservedAt, Owner: owner, HeartbeatAt: a.ReservedAt, HeartbeatEvery: 10}\n    50\t\tdir, err := s.delegationActiveDir(true)\n    51\t\tif err != nil {\n    52\t\t\tt.Fatal(err)\n    53\t\t}\n    54\t\traw, _ := json.Marshal(marker)\n    55\t\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), raw, 0o600); err != nil {\n    56\t\t\tt.Fatal(err)\n    57\t\t}\n    58\t\n    59\t\trun, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false)\n    60\t\tif err != nil {\n    61\t\t\tt.Fatal(err)\n    62\t\t}\n    63\t\tif run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"abandoned\") {\n    64\t\t\tt.Fatalf(\"the release recorded %s: %s\", run.Status, run.Failure)\n    65\t\t}\n    66\t\tif _, err := s.readAttemptReceipt(a); err != nil {\n    67\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n    68\t\t}\n    69\t\tif left, _ := filepath.Glob(filepath.Join(dir, a.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n    70\t\t\tt.Fatalf(\"the marker or its stall claim stayed: %v\", left)\n    71\t\t}\n    72\t\t// Released once: a second release finds nothing abandoned.\n    73\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n    74\t\t\tt.Fatalf(\"a released attempt was released again: %v\", err)\n    75\t\t}\n    76\t}\n    77\t\n    78\t// An attempt whose owner is alive is never released.\n    79\tfunc TestARunningAttemptIsNotReleased(t *testing.T) {\n    80\t\troot := t.TempDir()\n    81\t\ts := Store{Root: root}\n    82\t\tbundle := \"rvb-00000000000000a2\"\n    83\t\t// Silent for an hour, so only the owner's liveness keeps it running.\n    84\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n    85\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1, ReservedAt: old, Nonce: strings.Repeat(\"0\", 32)}\n    86\t\ta.AttemptID = attemptIdentity(a)\n    87\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    88\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    89\t\t\tt.Fatal(err)\n    90\t\t}\n    91\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    92\t\towner.Host, _ = os.Hostname()\n    93\t\tidentifyStartLockProcess(&owner)\n    94\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"d\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: bundle, StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n    95\t\tdir, _ := s.delegationActiveDir(true)\n    96\t\traw, _ := json.Marshal(marker)\n    97\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n    98\t\t\tt.Fatal(err)\n    99\t\t}\n   100\t\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n   101\t\t\tt.Fatalf(\"a running attempt was released: %v\", err)\n   102\t\t}\n   103\t}\n   104\t\n   105\t// Review round 1, N1: the dispatch marks the attempt active before it\n   106\t// publishes the reservation, so no instant leaves a reservation without a\n   107\t// marker that turns stalled.\n   108\tfunc TestTheAttemptIsMarkedActiveBeforeItIsReserved(t *testing.T) {\n   109\t\tvar checked bool\n   110\t\tbeforeAttemptPublished = func(store Store, a DelegatedReviewAttempt) {\n   111\t\t\tchecked = true\n   112\t\t\tmarkers, _, err := store.ListDelegationActive()\n   113\t\t\tfound := false\n   114\t\t\tfor _, m := range markers {\n   115\t\t\t\tfound = found || m.AttemptID == a.AttemptID\n   116\t\t\t}\n   117\t\t\tif err != nil || !found {\n   118\t\t\t\tt.Errorf(\"the reservation of %s is published with no active marker: %v\", a.AttemptID, err)\n   119\t\t\t}\n   120\t\t\tif _, err := os.Lstat(reviewAttemptPath(store.Root, a)); !errors.Is(err, os.ErrNotExist) {\n   121\t\t\t\tt.Errorf(\"the reservation was published before the marker: %v\", err)\n   122\t\t\t}\n   123\t\t}\n   124\t\tt.Cleanup(func() { beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {} })\n   125\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\")\n   126\t\tif !checked {\n   127\t\t\tt.Fatal(\"the dispatch never reached the reservation\")\n   128\t\t}\n   129\t}\n   130\t\n   131\t// A marker whose dispatch ended before publishing the reservation is removed\n   132\t// by the release; ls names the cause and the release command (N2).\n   133\tfunc TestAStalledMarkerWithoutReservationIsListedAndRemoved(t *testing.T) {\n   134\t\troot := t.TempDir()\n   135\t\ts := Store{Root: root}\n   136\t\tdead := exec.Command(\"true\")\n   137\t\tif err := dead.Run(); err != nil {\n   138\t\t\tt.Fatal(err)\n   139\t\t}\n   140\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:x\", Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n   141\t\towner.Host, _ = os.Hostname()\n   142\t\tidentifyStartLockProcess(&owner)\n   143\t\towner.PID = dead.Process.Pid\n   144\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   145\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: \"rat-\" + strings.Repeat(\"e\", 64), RunToken: strings.Repeat(\"f\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: \"rvb-00000000000000a3\", StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n   146\t\tdir, _ := s.delegationActiveDir(true)\n   147\t\traw, _ := json.Marshal(marker)\n   148\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n   149\t\t\tt.Fatal(err)\n   150\t\t}\n   151\t\tattempts, _, err := s.ListDelegationAttempts()\n   152\t\tif err != nil || len(attempts) != 1 || attempts[0].State != DelegationStalled || !strings.Contains(attempts[0].Failure, DelegationAbandonedCause) || !strings.Contains(attempts[0].Failure, \"pose delegate cancel \"+marker.AttemptID) {\n   153\t\t\tt.Fatalf(\"the abandoned attempt is not listed with its cause: %+v %v\", attempts, err)\n   154\t\t}\n   155\t\trun, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false)\n   156\t\tif err != nil || run.RunID != \"\" {\n   157\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   158\t\t}\n   159\t\tif left, _ := filepath.Glob(filepath.Join(dir, marker.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n   160\t\t\tt.Fatalf(\"the marker stayed: %v\", left)\n   161\t\t}\n   162\t}\n   163\t\n   164\t// writeDeadMarker rewrites the marker of attempt so its owner is a process\n   165\t// that has exited and its heartbeat is an hour old, as a dispatch killed\n   166\t// mid-run leaves it.\n   167\tfunc writeDeadMarker(t *testing.T, s Store, attempt string) {\n   168\t\tt.Helper()\n   169\t\tdir, err := s.delegationActiveDir(false)\n   170\t\tif err != nil {\n   171\t\t\tt.Fatal(err)\n   172\t\t}\n   173\t\tpath := filepath.Join(dir, attempt+\".json\")\n   174\t\traw, err := os.ReadFile(path)\n   175\t\tif err != nil {\n   176\t\t\tt.Fatal(err)\n   177\t\t}\n   178\t\tvar marker DelegationActiveRun\n   179\t\tif err := json.Unmarshal(raw, &marker); err != nil {\n   180\t\t\tt.Fatal(err)\n   181\t\t}\n   182\t\tdead := exec.Command(\"true\")\n   183\t\tif err := dead.Run(); err != nil {\n   184\t\t\tt.Fatal(err)\n   185\t\t}\n   186\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   187\t\tmarker.Owner.PID, marker.HeartbeatAt, marker.StartedAt = dead.Process.Pid, old, old\n   188\t\traw, _ = json.Marshal(marker)\n   189\t\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n   190\t\t\tt.Fatal(err)\n   191\t\t}\n   192\t}\n   193\t\n   194\t// Review round 2, N4 (R6): a real dispatch interrupted after its reservation\n   195\t// and before its run record blocks the next dispatch; once released, the\n   196\t// next dispatch runs.\n   197\tfunc TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns(t *testing.T) {\n   198\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   199\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   200\t\tif err != nil {\n   201\t\t\tt.Fatal(err)\n   202\t\t}\n   203\t\tattempt := \"\"\n   204\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   205\t\tfunc() {\n   206\t\t\tdefer func() { _ = recover() }()\n   207\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   208\t\t}()\n   209\t\tif attempt == \"\" {\n   210\t\t\tt.Fatal(\"the dispatch never reached its start\")\n   211\t\t}\n   212\t\twriteDeadMarker(t, f.store, attempt)\n   213\t\tif _, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after interruption\"); err == nil || !strings.Contains(err.Error(), \"pose delegate cancel \"+attempt) {\n   214\t\t\tt.Fatalf(\"the interrupted attempt did not block the bundle with its release command: %v\", err)\n   215\t\t}\n   216\t\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil {\n   217\t\t\tt.Fatal(err)\n   218\t\t}\n   219\t\tnext, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\")\n   220\t\tif err != nil {\n   221\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n   222\t\t}\n   223\t\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n   224\t\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n   225\t\t}\n   226\t}\n   227\t\n   228\t// Review rounds 2 and 5 (N3, N1): one release runs at a time, under a lock\n   229\t// the operating system releases when its holder ends.\n   230\tfunc TestOneReleaseRunsAtATime(t *testing.T) {\n   231\t\troot := t.TempDir()\n   232\t\ts := Store{Root: root}\n   233\t\tattempt := \"rat-\" + strings.Repeat(\"9\", 64)\n   234\t\tdir, _ := s.delegationActiveDir(true)\n   235\t\tlockPath := filepath.Join(dir, attempt+\".release.lock\")\n   236\t\theld, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0o600)\n   237\t\tif err != nil {\n   238\t\t\tt.Fatal(err)\n   239\t\t}\n   240\t\tunlock, err := lockSpecTransferFile(held)\n   241\t\tif err != nil {\n   242\t\t\tt.Fatal(err)\n   243\t\t}\n   244\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\n   245\t\t\tt.Fatalf(\"a release ran while another held the lock: %v\", err)\n   246\t\t}\n   247\t\tunlock()\n   248\t\theld.Close()\n   249\t\t// A holder that ends releases the lock with it: nothing is left to take over.\n   250\t\tif _, err := exec.LookPath(\"flock\"); err == nil {\n   251\t\t\tholder := exec.Command(\"flock\", lockPath, \"sleep\", \"30\")\n   252\t\t\tholder.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n   253\t\t\tif err := holder.Start(); err != nil {\n   254\t\t\t\tt.Fatal(err)\n   255\t\t\t}\n   256\t\t\ttime.Sleep(200 * time.Millisecond)\n   257\t\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err == nil || !strings.Contains(err.Error(), \"in progress\") {\n   258\t\t\t\tt.Fatalf(\"the other process's lock was not seen: %v\", err)\n   259\t\t\t}\n   260\t\t\t_ = syscall.Kill(-holder.Process.Pid, syscall.SIGKILL)\n   261\t\t\t_ = holder.Wait()\n   262\t\t}\n   263\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil && strings.Contains(err.Error(), \"in progress\") {\n   264\t\t\tt.Fatalf(\"an ended holder's lock still blocks the release: %v\", err)\n   265\t\t}\n   266\t}\n   267\t\n   268\t// Review round 3, N1: a release interrupted after it recorded the run, and\n   269\t// before the receipt, completes with that run instead of recording another.\n   270\tfunc TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n   271\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   272\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   273\t\tif err != nil {\n   274\t\t\tt.Fatal(err)\n   275\t\t}\n   276\t\tattempt := \"\"\n   277\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   278\t\tfunc() {\n   279\t\t\tdefer func() { _ = recover() }()\n   280\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   281\t\t}()\n   282\t\twriteDeadMarker(t, f.store, attempt)\n   283\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   284\t\tmarkerPath := filepath.Join(activeDir, attempt+\".json\")\n   285\t\tmarkerBytes, err := os.ReadFile(markerPath)\n   286\t\tif err != nil {\n   287\t\t\tt.Fatal(err)\n   288\t\t}\n   289\t\tfirst, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   290\t\tif err != nil {\n   291\t\t\tt.Fatal(err)\n   292\t\t}\n   293\t\t// Undo the receipt and keep the marker, as a release stopped between\n   294\t\t// the run and the receipt leaves them.\n   295\t\tattempts, _ := f.store.readDelegatedReviewAttempts(f.bundle.BundleID)\n   296\t\tfor _, a := range attempts {\n   297\t\t\tif a.AttemptID == attempt {\n   298\t\t\t\tif err := os.Remove(attemptReceiptPath(f.store.Root, a)); err != nil {\n   299\t\t\t\t\tt.Fatal(err)\n   300\t\t\t\t}\n   301\t\t\t}\n   302\t\t}\n   303\t\tif err := os.WriteFile(markerPath, markerBytes, 0o600); err != nil {\n   304\t\t\tt.Fatal(err)\n   305\t\t}\n   306\t\tsecond, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   307\t\tif err != nil || second.RunID != first.RunID {\n   308\t\t\tt.Fatalf(\"the interrupted release recorded another run: %s then %s (%v)\", first.RunID, second.RunID, err)\n   309\t\t}\n   310\t}\n   311\t\n   312\t// Review round 2, N1: a reservation an earlier engine left with no marker is\n   313\t// listed and released once it is old enough, never while it is young.\n   314\tfunc TestAMarkerlessReservationOfAnEarlierEngineIsReleased(t *testing.T) {\n   315\t\troot := t.TempDir()\n   316\t\ts := Store{Root: root}\n   317\t\treserve := func(age time.Duration, nonce string) DelegatedReviewAttempt {\n   318\t\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000b\" + nonce[:1], BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   319\t\t\t\tReservedAt: time.Now().Add(-age).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(nonce[:1], 32)}\n   320\t\t\ta.AttemptID = attemptIdentity(a)\n   321\t\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   322\t\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   323\t\t\t\tt.Fatal(err)\n   324\t\t\t}\n   325\t\t\treturn a\n   326\t\t}\n   327\t\told, young := reserve(time.Hour, \"1\"), reserve(time.Minute, \"2\")\n   328\t\tattempts, _, err := s.ListDelegationAttempts()\n   329\t\tif err != nil {\n   330\t\t\tt.Fatal(err)\n   331\t\t}\n   332\t\tlisted := map[string]DelegationAttempt{}\n   333\t\tfor _, a := range attempts {\n   334\t\t\tlisted[a.AttemptID] = a\n   335\t\t}\n   336\t\tif a, ok := listed[old.AttemptID]; !ok || a.State != DelegationStalled || !strings.Contains(a.Failure, \"pose delegate cancel \"+old.AttemptID+\" --confirm-abandoned\") {\n   337\t\t\tt.Fatalf(\"the old markerless reservation is not listed with its release: %+v\", attempts)\n   338\t\t}\n   339\t\tif _, ok := listed[young.AttemptID]; ok {\n   340\t\t\tt.Fatal(\"a young reservation was listed as abandoned\")\n   341\t\t}\n   342\t\tif _, err := s.ReleaseAbandonedAttempt(young.AttemptID, time.Now(), true); !errors.Is(err, ErrAttemptNotAbandoned) {\n   343\t\t\tt.Fatalf(\"a young reservation was released: %v\", err)\n   344\t\t}\n   345\t\t// Review round 3, N2: nothing proves a markerless reservation abandoned,\n   346\t\t// so it is released only on the operator's confirmation.\n   347\t\tif _, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"--confirm-abandoned\") {\n   348\t\t\tt.Fatalf(\"a markerless reservation was released without confirmation: %v\", err)\n   349\t\t}\n   350\t\trun, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n   351\t\tif err != nil || run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"operator's confirmation\") {\n   352\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   353\t\t}\n   354\t\tif _, err := s.readAttemptReceipt(old); err != nil {\n   355\t\t\tt.Fatalf(\"the released reservation still blocks its bundle: %v\", err)\n   356\t\t}\n   357\t\t// Review round 4, N1: a release stopped between its run and its receipt\n   358\t\t// leaves the attempt with a run; it is still released, with that run.\n   359\t\tif err := os.Remove(attemptReceiptPath(root, old)); err != nil {\n   360\t\t\tt.Fatal(err)\n   361\t\t}\n   362\t\tagain, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n   363\t\tif err != nil || again.RunID != run.RunID {\n   364\t\t\tt.Fatalf(\"the interrupted release did not complete with its run: %s then %s (%v)\", run.RunID, again.RunID, err)\n   365\t\t}\n   366\t}\n   367\t\n   368\t// Review round 3, N3: an unreadable reservation is reported, not skipped.\n   369\tfunc TestAnUnreadableReservationIsReportedAsALoss(t *testing.T) {\n   370\t\troot := t.TempDir()\n   371\t\ts := Store{Root: root}\n   372\t\tdir := filepath.Join(root, reviewAttemptDir, \"broken\")\n   373\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n   374\t\t\tt.Fatal(err)\n   375\t\t}\n   376\t\tif err := os.WriteFile(filepath.Join(dir, \"000001.json\"), []byte(\"{not json\"), 0o644); err != nil {\n   377\t\t\tt.Fatal(err)\n   378\t\t}\n   379\t\t_, lost, err := s.ListDelegationAttempts()\n   380\t\tif err != nil || !strings.Contains(strings.Join(lost, \"\\n\"), \"broken/000001.json could not be read\") {\n   381\t\t\tt.Fatalf(\"an unreadable reservation was skipped silently: %v %v\", lost, err)\n   382\t\t}\n   383\t}\n   384\t\n   385\t// Review round 4, N3: with the run history incomplete, no reservation is\n   386\t// taken as runless, and the loss is reported.\n   387\tfunc TestAnIncompleteRunHistoryRulesNothingOut(t *testing.T) {\n   388\t\troot := t.TempDir()\n   389\t\ts := Store{Root: root}\n   390\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000c1\", BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   391\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"3\", 32)}\n   392\t\ta.AttemptID = attemptIdentity(a)\n   393\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   394\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   395\t\t\tt.Fatal(err)\n   396\t\t}\n   397\t\tif err := os.MkdirAll(filepath.Join(root, reviewRunsDir), 0o755); err != nil {\n   398\t\t\tt.Fatal(err)\n   399\t\t}\n   400\t\tif err := os.WriteFile(filepath.Join(root, reviewRunsDir, \"rrn-0000000000000bad.json\"), []byte(\"{broken\"), 0o644); err != nil {\n   401\t\t\tt.Fatal(err)\n   402\t\t}\n   403\t\tif _, runLost, err := s.ReadReviewRuns(\"\"); err != nil || len(runLost) == 0 {\n   404\t\t\tt.Skipf(\"the fixture does not make the run history incomplete: %v %v\", runLost, err)\n   405\t\t}\n   406\t\torphans, lost, err := s.orphanReservations(time.Now())\n   407\t\tif err != nil || len(orphans) != 0 || !strings.Contains(strings.Join(lost, \"\\n\"), \"run history is incomplete\") {\n   408\t\t\tt.Fatalf(\"an incomplete history ruled a run out: %v %v %v\", orphans, lost, err)\n   409\t\t}\n   410\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n   411\t\t\tt.Fatal(\"a reservation was released over an incomplete run history\")\n   412\t\t}\n   413\t}\n   414\t\n   415\t// Review round 5, N3: a dispatch that recorded its run and stopped before\n   416\t// the receipt is completed with that run, not with a second one; N2: a\n   417\t// release that stopped after the receipt only removes the marker.\n   418\tfunc TestARecordedRunCompletesItsAttempt(t *testing.T) {\n   419\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   420\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"receipt lost\")\n   421\t\tif err != nil {\n   422\t\t\tt.Fatal(err)\n   423\t\t}\n   424\t\tsaved := beforeRunResultPublished\n   425\t\tt.Cleanup(func() { beforeRunResultPublished = saved })\n   426\t\trecorded := \"\"\n   427\t\tbeforeRunResultPublished = func(r ReviewRun) { recorded = r.RunID; panic(\"the dispatching process ends before the receipt\") }\n   428\t\tfunc() {\n   429\t\t\tdefer func() { _ = recover() }()\n   430\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   431\t\t}()\n   432\t\tbeforeRunResultPublished = saved\n   433\t\truns, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID)\n   434\t\tif recorded == \"\" || len(runs) == 0 {\n   435\t\t\tt.Fatalf(\"the dispatch recorded no run: %q %d\", recorded, len(runs))\n   436\t\t}\n   437\t\tattempt := runs[len(runs)-1].AttemptID\n   438\t\twriteDeadMarker(t, f.store, attempt)\n   439\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   440\t\tmarkerBytes, _ := os.ReadFile(filepath.Join(activeDir, attempt+\".json\"))\n   441\t\treleased, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   442\t\tif err != nil || released.RunID != recorded {\n   443\t\t\tt.Fatalf(\"the release did not complete with the recorded run %s: %s %v\", recorded, released.RunID, err)\n   444\t\t}\n   445\t\tif after, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID); len(after) != len(runs) {\n   446\t\t\tt.Fatalf(\"the release recorded another run: %d then %d\", len(runs), len(after))\n   447\t\t}\n   448\t\t// The marker comes back, as a release stopped after the receipt leaves it.\n   449\t\tif err := os.WriteFile(filepath.Join(activeDir, attempt+\".json\"), markerBytes, 0o600); err != nil {\n   450\t\t\tt.Fatal(err)\n   451\t\t}\n   452\t\tagain, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   453\t\tif err != nil || again.RunID != recorded {\n   454\t\t\tt.Fatalf(\"a release after the receipt did not complete: %s %v\", again.RunID, err)\n   455\t\t}\n   456\t\tif left, _ := filepath.Glob(filepath.Join(activeDir, attempt+\".json\")); len(left) != 0 {\n   457\t\t\tt.Fatal(\"the stalled marker stayed after the receipt\")\n   458\t\t}\n   459\t}\n   460\t\n","exit_code":0,"status":"completed"}}
