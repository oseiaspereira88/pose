on.Outcome != OutcomeCompleted {\npose-mcp/internal/pose/review_dispatch.go:684:\t\trun.Safety.Operation = outcome\npose-mcp/internal/pose/review_dispatch.go:699:\t\t\trun.Safety.ExecutionCause = \"cancelled\"\npose-mcp/internal/pose/review_dispatch.go:1059:\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\npose-mcp/internal/pose/review_dispatch.go:1062:\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\npose-mcp/internal/pose/review_dispatch.go:1549:\tif run.Safety != nil && int64(len(pretty)+len(transcript)+len(events)) > run.Safety.RetainedBytes {\n","exit_code":0,"status":"completed"}}
