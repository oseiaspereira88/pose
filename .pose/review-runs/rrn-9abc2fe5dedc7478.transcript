{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '1,300p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Listing and naming delegated runs (spec pose-delegation-surface R11, and the\n     4\t// listing pose-delegated-review-completion-signal extends).\n     5\t//\n     6\t// A person and an agent follow a task, not a process: an attempt and its\n     7\t// continuations are one row, shown by their latest run. A reference names a\n     8\t// row by attempt, by any of its runs, by label or by a prefix of its session.\n     9\t\n    10\timport (\n    11\t\t\"fmt\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t)\n    16\t\n    17\t// DelegationAttempt is one attempt and its continuations.\n    18\ttype DelegationAttempt struct {\n    19\t\tAttemptID    string              `json:\"attempt_id\"`\n    20\t\tRuns         []string            `json:\"runs\"`\n    21\t\tLatestRun    string              `json:\"latest_run,omitempty\"`\n    22\t\tState        string              `json:\"state\"`\n    23\t\tPurpose      string              `json:\"purpose\"`\n    24\t\tAgent        string              `json:\"agent\"`\n    25\t\tVendor       string              `json:\"vendor,omitempty\"`\n    26\t\tModel        string              `json:\"model,omitempty\"`\n    27\t\tLabel        string              `json:\"label,omitempty\"`\n    28\t\tLead         string              `json:\"lead,omitempty\"`\n    29\t\tAccess       string              `json:\"access\"`\n    30\t\tScope        string              `json:\"scope\"`\n    31\t\tBundleID     string              `json:\"bundle_id\"`\n    32\t\tStartedAt    string              `json:\"started_at\"`\n    33\t\tEndedAt      string              `json:\"ended_at,omitempty\"`\n    34\t\tTurns        int                 `json:\"turns\"`\n    35\t\tLastStep     string              `json:\"last_step,omitempty\"`\n    36\t\tFailure      string              `json:\"failure,omitempty\"`\n    37\t\tInterruption *ReviewInterruption `json:\"interruption,omitempty\"`\n    38\t\t// Partial says an interrupted run kept a partial draft; TimeLeft is the\n    39\t\t// wait until its recorded reset, when there is one.\n    40\t\tPartial         bool   `json:\"partial,omitempty\"`\n    41\t\tTimeLeft        string `json:\"time_left,omitempty\"`\n    42\t\tActive          bool   `json:\"active\"`\n    43\t\tLiveness        string `json:\"liveness,omitempty\"`\n    44\t\tCancelRequested bool   `json:\"cancel_requested,omitempty\"`\n    45\t\t// HeartbeatAge is how long ago the running process last beat; a stalled\n    46\t\t// run is not active (spec pose-delegated-review-completion-signal R4, R6).\n    47\t\tHeartbeatAge string `json:\"heartbeat_age,omitempty\"`\n    48\t\tStalledAt    string `json:\"stalled_at,omitempty\"`\n    49\t\t// HookFailure is why the latest run's on_terminal hook failed (R7).\n    50\t\tHookFailure string `json:\"hook_failure,omitempty\"`\n    51\t\t// Round is the review round of the scope the latest run reviewed (spec\n    52\t\t// pose-delegated-review-round-protocol R1).\n    53\t\tRound    int `json:\"round,omitempty\"`\n    54\t\tsessions []string\n    55\t\tlatest   *ReviewRun\n    56\t}\n    57\t\n    58\t// Latest is the latest recorded run of the attempt, if any.\n    59\tfunc (a DelegationAttempt) Latest() *ReviewRun { return a.latest }\n    60\t\n    61\t// DelegationRunning is the state of an attempt whose process is still there;\n    62\t// DelegationStalled, of one whose process is gone without a record.\n    63\tconst (\n    64\t\tDelegationRunning = \"running\"\n    65\t\tDelegationStalled = \"stalled\"\n    66\t\t// DelegationAbandonedCause is the failure of a stalled attempt whose\n    67\t\t// dispatch ended before recording its run.\n    68\t\tDelegationAbandonedCause = \"abandoned: the dispatching process ended before the run was recorded\"\n    69\t)\n    70\t\n    71\t// ListDelegationAttempts groups every recorded run by attempt, adds the runs\n    72\t// in progress, and returns the losses the run history reports.\n    73\tfunc (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n    74\t\t// The markers are read before the runs: a run publishes its record before\n    75\t\t// it removes its marker, so a reader that finds no marker for an attempt\n    76\t\t// it saw running finds its record (spec\n    77\t\t// pose-delegated-review-completion-signal R5).\n    78\t\tactive, activeLost, activeErr := s.ListDelegationActive()\n    79\t\truns, lost, err := s.ReadReviewRuns(\"\")\n    80\t\tif err != nil {\n    81\t\t\treturn nil, nil, err\n    82\t\t}\n    83\t\t// Task runs share the lifecycle, never the review history (spec\n    84\t\t// pose-delegation-task R7, R8).\n    85\t\ttasks, taskLost := s.ReadDelegationTaskRuns()\n    86\t\truns, lost = append(runs, tasks...), append(lost, taskLost...)\n    87\t\tbyAttempt := map[string]*DelegationAttempt{}\n    88\t\torder := []string{}\n    89\t\tfor i := range runs {\n    90\t\t\trun := runs[i]\n    91\t\t\tkey := run.AttemptID\n    92\t\t\tif key == \"\" {\n    93\t\t\t\tkey = run.RunID // a run recorded before attempts existed is its own attempt\n    94\t\t\t}\n    95\t\t\trow, ok := byAttempt[key]\n    96\t\t\tif !ok {\n    97\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    98\t\t\t\tbyAttempt[key] = row\n    99\t\t\t\torder = append(order, key)\n   100\t\t\t}\n   101\t\t\trow.Runs = append(row.Runs, run.RunID)\n   102\t\t\trow.latest = &runs[i]\n   103\t\t\tif run.SessionDigest != \"\" {\n   104\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   105\t\t\t\t\trow.sessions = append(row.sessions, value)\n   106\t\t\t\t}\n   107\t\t\t}\n   108\t\t\tevents, err := s.ReadDelegationEvents(run)\n   109\t\t\tif err != nil {\n   110\t\t\t\t// A turn count read from nothing would report a whole history.\n   111\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   112\t\t\t} else {\n   113\t\t\t\tfor _, e := range events {\n   114\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   115\t\t\t\t\t\trow.Turns++\n   116\t\t\t\t\t}\n   117\t\t\t\t}\n   118\t\t\t\tif len(events) > 0 {\n   119\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   120\t\t\t\t}\n   121\t\t\t}\n   122\t\t}\n   123\t\tfor _, key := range order {\n   124\t\t\trow := byAttempt[key]\n   125\t\t\tlatest := row.latest\n   126\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   127\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   128\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   129\t\t\tif latest.Access != \"\" {\n   130\t\t\t\trow.Access = latest.Access\n   131\t\t\t}\n   132\t\t\trow.Round = latest.Round\n   133\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   134\t\t\t\trow.HookFailure = hook.Failure\n   135\t\t\t}\n   136\t\t\tif row.Purpose == \"\" {\n   137\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   138\t\t\t}\n   139\t\t\tif latest.Status == ReviewRunInterrupted {\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n   206\t\tfor _, key := range order {\n   207\t\t\tout = append(out, *byAttempt[key])\n   208\t\t}\n   209\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   210\t\treturn out, lost, nil\n   211\t}\n   212\t\n   213\tfunc delegationStepText(e DelegationEvent) string {\n   214\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   215\t\tif len(text) > 80 {\n   216\t\t\tcut := 77\n   217\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   218\t\t\t\tcut--\n   219\t\t\t}\n   220\t\t\ttext = text[:cut] + \"...\"\n   221\t\t}\n   222\t\tswitch e.Kind {\n   223\t\tcase DelegationEventToolCall:\n   224\t\t\treturn \"▶ \" + text\n   225\t\tcase DelegationEventToolOutput:\n   226\t\t\tif e.ExitCode != nil && *e.ExitCode != 0 {\n   227\t\t\t\treturn fmt.Sprintf(\"✗ exit %d\", *e.ExitCode)\n   228\t\t\t}\n   229\t\t\treturn \"✓ exit 0\"\n   230\t\tcase DelegationEventTurn:\n   231\t\t\treturn \"turn\"\n   232\t\t}\n   233\t\tif text == \"\" {\n   234\t\t\treturn e.Kind\n   235\t\t}\n   236\t\treturn e.Kind + \": \" + text\n   237\t}\n   238\t\n   239\t// ErrDelegationRefAmbiguous carries the candidates of an ambiguous reference.\n   240\t// Neither reference error carries the reference: it may be a session, which\n   241\t// no output names.\n   242\ttype ErrDelegationRefAmbiguous struct {\n   243\t\tCandidates []string\n   244\t}\n   245\t\n   246\tfunc (e *ErrDelegationRefAmbiguous) Error() string {\n   247\t\treturn \"pose: the reference names more than one delegated run: \" + strings.Join(e.Candidates, \", \")\n   248\t}\n   249\t\n   250\t// ErrDelegationRefUnknown means no attempt matches.\n   251\ttype ErrDelegationRefUnknown struct{}\n   252\t\n   253\tfunc (e *ErrDelegationRefUnknown) Error() string {\n   254\t\treturn \"pose: no delegated run matches the reference (a run id, an attempt id, a label or a session prefix of six characters or more)\"\n   255\t}\n   256\t\n   257\t// ResolveDelegationRef finds the one attempt ref names (R11).\n   258\tfunc ResolveDelegationRef(attempts []DelegationAttempt, ref string) (DelegationAttempt, error) {\n   259\t\tref = strings.TrimSpace(ref)\n   260\t\tif ref == \"\" {\n   261\t\t\treturn DelegationAttempt{}, &ErrDelegationRefUnknown{}\n   262\t\t}\n   263\t\t// An identifier is exact and wins over a label or a session prefix.\n   264\t\tfor _, a := range attempts {\n   265\t\t\tif a.AttemptID == ref || containsString(a.Runs, ref) {\n   266\t\t\t\treturn a, nil\n   267\t\t\t}\n   268\t\t}\n   269\t\tvar matched []DelegationAttempt\n   270\t\tfor _, a := range attempts {\n   271\t\t\thit := a.Label == ref\n   272\t\t\tif !hit && len(ref) >= 6 {\n   273\t\t\t\tfor _, session := range a.sessions {\n   274\t\t\t\t\tif strings.HasPrefix(session, ref) {\n   275\t\t\t\t\t\thit = true\n   276\t\t\t\t\t}\n   277\t\t\t\t}\n   278\t\t\t}\n   279\t\t\tif hit {\n   280\t\t\t\tmatched = append(matched, a)\n   281\t\t\t}\n   282\t\t}\n   283\t\tswitch len(matched) {\n   284\t\tcase 0:\n   285\t\t\treturn DelegationAttempt{}, &ErrDelegationRefUnknown{}\n   286\t\tcase 1:\n   287\t\t\treturn matched[0], nil\n   288\t\t}\n   289\t\tcandidates := make([]string, 0, len(matched))\n   290\t\tfor _, a := range matched {\n   291\t\t\tname := a.AttemptID\n   292\t\t\tif a.Label != \"\" {\n   293\t\t\t\tname += \" (\" + a.Label + \", \" + a.State + \")\"\n   294\t\t\t}\n   295\t\t\tcandidates = append(candidates, name)\n   296\t\t}\n   297\t\treturn DelegationAttempt{}, &ErrDelegationRefAmbiguous{Candidates: candidates}\n   298\t}\n","exit_code":0,"status":"completed"}}
