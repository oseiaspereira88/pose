he run\n  1212\t\t\t// completes, against the rounds before it (R1, R4).\n  1213\t\t\tround, err := s.ReviewRoundOf(plan.Bundle)\n  1214\t\t\tif err != nil {\n  1215\t\t\t\treturn finish(ReviewRunFailed, \"the round of the bundle cannot be derived: \"+err.Error())\n  1216\t\t\t}\n  1217\t\t\trun.Round, run.DraftProblems = round.Number, ValidateRoundDraft(round, run.Output)\n  1218\t\t}\n  1219\t\tpublished, err := finish(ReviewRunCompleted, \"\")\n  1220\t\tif err != nil {\n  1525\t\tidentity, _ := json.Marshal(run)\n  1526\t\tidSum := sha256.Sum256(identity)\n  1527\t\trun.RunID = \"rrn-\" + hex.EncodeToString(idSum[:])[:16]\n  1528\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, reviewRunsDir, true)\n  1529\t\tif err != nil {\n  1530\t\t\treturn ReviewRun{}, err\n  1531\t\t}\n  1532\t\trun.TranscriptPath = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\"))\n  1533\t\tpretty, err := json.MarshalIndent(run, \"\", \"  \")\n  1534\t\tif err != nil {\n  1535\t\t\treturn ReviewRun{}, err\n  1536\t\t}\n  1537\t\tpretty = append(pretty, '\\n')\n  1538\t\tif len(pretty) > reviewLedgerMaxBytes {\n  1539\t\t\treturn ReviewRun{}, fmt.Errorf(\"review run record exceeds %d-byte bound; nothing published\", reviewLedgerMaxBytes)\n  1540\t\t}\n  1541\t\tif len(transcript) > reviewTranscriptMaxBytes {\n  1542\t\t\treturn ReviewRun{}, fmt.Errorf(\"review transcript exceeds %d-byte bound; nothing published\", reviewTranscriptMaxBytes)\n  1543\t\t}\n  1544\t\n  1545\t\twitness := reviewRunWitness{SchemaVersion: 1, RunID: run.RunID, BundleID: run.BundleID, Scope: run.Scope, RecordDigest: digestBytes(pretty), TranscriptDigest: run.TranscriptDigest}\n  1546\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(filepath.Join(reviewRunLedgerDir, run.RunID+\".json\")), witness); err != nil {\n  1547\t\t\treturn ReviewRun{}, err\n  1548\t\t}\n  1549\t\tif run.Safety != nil && int64(len(pretty)+len(transcript)+len(events)) > run.Safety.RetainedBytes {\n  15