{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc 'git diff --find-renames --find-copies ddb770352f35f2f55c740e9a8479686de3a251e5..f5c4a2941d9d1efeb65154395a80f6c26401d76 -- pose-mcp/internal/pose/review_reap_linux.go pose-mcp/internal/pose/review_subreaper_linux.go pose-mcp/internal/pose/delegation_release.go pose-mcp/internal/pose/review_dispatch.go pose-mcp/internal/pose/delegation_list.go pose-mcp/internal/pose/review_attempt_ledger.go pose-mcp/internal/cli/delegate.go'","aggregated_output":"diff --git a/pose-mcp/internal/cli/delegate.go b/pose-mcp/internal/cli/delegate.go\nindex 205aab97..aa8b85eb 100644\n--- a/pose-mcp/internal/cli/delegate.go\n+++ b/pose-mcp/internal/cli/delegate.go\n@@ -63,7 +63,7 @@ type delegateFlags struct {\n \trequest                                      string\n \tto, cd, effort, promptFile, session          string\n \taddDirs                                      []string\n-\tnoNetwork, record                            bool\n+\tnoNetwork, record, confirmAbandoned          bool\n \tdryRun, jsonOut, active, wait, detach        bool\n \tverbose, noFollow                            bool\n \tlines                                        int\n@@ -91,7 +91,7 @@ func parseDelegateFlags(args []string, extra ...string) (delegateFlags, string)\n \t\t\treturn f, tr(\"unknown or inapplicable flag \"+name, \"flag desconhecida ou inaplicável \"+name)\n \t\t}\n \t\tswitch name {\n-\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\":\n+\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\", \"--confirm-abandoned\":\n \t\t\tif hasInline {\n \t\t\t\treturn f, tr(name+\" takes no value\", name+\" não recebe valor\")\n \t\t\t}\n@@ -108,6 +108,8 @@ func parseDelegateFlags(args []string, extra ...string) (delegateFlags, string)\n \t\t\t\tf.noNetwork = true\n \t\t\tcase \"--record\":\n \t\t\t\tf.record = true\n+\t\t\tcase \"--confirm-abandoned\":\n+\t\t\t\tf.confirmAbandoned = true\n \t\t\tcase \"--no-follow\":\n \t\t\t\tf.noFollow = true\n \t\t\tdefault:\n@@ -929,6 +931,9 @@ func cmdDelegateLs(root string, args []string, stdout, stderr io.Writer) int {\n \t\t\tif a.StalledAt != \"\" {\n \t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n \t\t\t}\n+\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n+\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n+\t\t\t}\n \t\t\tif a.HookFailure != \"\" {\n \t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n \t\t\t}\n@@ -1105,9 +1110,9 @@ func cmdDelegateResume(root string, args []string, stdout, stderr io.Writer) int\n }\n \n func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n-\tf, problem := parseDelegateFlags(args)\n+\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n \tif problem != \"\" {\n-\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--dry-run] [--json]\")\n+\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n \t}\n \tstore := posemodel.Store{Root: root}\n \tattempts, lost, err := store.ListDelegationAttempts()\n@@ -1118,6 +1123,33 @@ func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int\n \tif err != nil {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n \t}\n+\tif !attempt.Active && !f.dryRun {\n+\t\t// An attempt whose dispatch, or whose earlier release, ended before\n+\t\t// its receipt is released with a failed run and its receipt, so it\n+\t\t// stops blocking the bundle; the release proves the abandonment\n+\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n+\t\t// review round 4, N1).\n+\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n+\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n+\t\t}\n+\t\tif err != nil {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n+\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n+\t\t}\n+\t\tif f.jsonOut {\n+\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n+\t\t\treturn 0\n+\t\t}\n+\t\tout := render(stdout, stderr)\n+\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n+\t\tif run.RunID == \"\" {\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n+\t\t} else {\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n+\t\t}\n+\t\treturn 0\n+\t}\n \tif !attempt.Active {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n \t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\ndiff --git a/pose-mcp/internal/pose/delegation_list.go b/pose-mcp/internal/pose/delegation_list.go\nindex 94358115..16545c02 100644\n--- a/pose-mcp/internal/pose/delegation_list.go\n+++ b/pose-mcp/internal/pose/delegation_list.go\n@@ -63,6 +63,9 @@ func (a DelegationAttempt) Latest() *ReviewRun { return a.latest }\n const (\n \tDelegationRunning = \"running\"\n \tDelegationStalled = \"stalled\"\n+\t// DelegationAbandonedCause is the failure of a stalled attempt whose\n+\t// dispatch ended before recording its run.\n+\tDelegationAbandonedCause = \"abandoned: the dispatching process ended before the run was recorded\"\n )\n \n // ListDelegationAttempts groups every recorded run by attempt, adds the runs\n@@ -167,6 +170,12 @@ func (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n \t\t}\n \t\tif marker.StalledAt != \"\" {\n \t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n+\t\t\tif row.LatestRun == \"\" {\n+\t\t\t\t// The dispatch ended before recording its run: the cause and\n+\t\t\t\t// the release are said, not left to inspection (review round\n+\t\t\t\t// 1, N2).\n+\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n+\t\t\t}\n \t\t}\n \t\t// A running run's progress comes from its live events (R12).\n \t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n@@ -178,6 +187,21 @@ func (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n \t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n \t\t}\n \t}\n+\t// A reservation an earlier engine left without a marker or a run is\n+\t// listed too, so it can be named and released (review round 2, N1).\n+\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n+\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n+\t} else {\n+\t\tlost = append(lost, orphanLost...)\n+\t\tfor _, a := range orphans {\n+\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n+\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n+\t\t\torder = append(order, a.AttemptID)\n+\t\t}\n+\t}\n \tout := make([]DelegationAttempt, 0, len(order))\n \tfor _, key := range order {\n \t\tout = append(out, *byAttempt[key])\ndiff --git a/pose-mcp/internal/pose/delegation_release.go b/pose-mcp/internal/pose/delegation_release.go\nnew file mode 100644\nindex 00000000..44b69c69\n--- /dev/null\n+++ b/pose-mcp/internal/pose/delegation_release.go\n@@ -0,0 +1,277 @@\n+package pose\n+\n+// Releasing an abandoned attempt (spec\n+// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n+// ends after reserving its attempt but before recording its run leaves a\n+// reservation without a receipt. Every later dispatch of the bundle refuses\n+// on it, and cancellation refused it because nothing runs. Once it is proven\n+// abandoned, the attempt is closed by the same records a failed run writes:\n+// a failed run naming the abandonment and its receipt. Nothing is deleted\n+// from the ledger.\n+//\n+// Proof of abandonment: a marker that is stalled with its owner proven dead.\n+// A reservation an earlier engine left without any marker (it reserved\n+// before marking) records no owner, so nothing proves it abandoned: it is\n+// listed once it is older than reviewOrphanReservationAge and has no\n+// receipt or run, and released only on the operator's explicit confirmation,\n+// which the recorded run states (review round 3, N2). One release runs at a\n+// time per attempt under a lock the operating system releases when its\n+// holder ends, so an interrupted release leaves nothing to take over (review\n+// round 5, N1). A release is idempotent: it completes with a run the\n+// attempt already recorded, whatever wrote it (N3), and with a receipt\n+// already published it only removes the stalled marker (N2).\n+\n+import (\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"time\"\n+)\n+\n+// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n+// proven abandoned.\n+var ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n+\n+// reviewOrphanReservationAge is how old a reservation without any marker\n+// must be to count as abandoned.\n+const reviewOrphanReservationAge = 10 * time.Minute\n+\n+// ReleaseAbandonedAttempt records the failed run of an attempt whose\n+// dispatch ended before recording it, and removes its stalled marker. A\n+// stalled marker whose reservation was never published is only removed; the\n+// returned run is then empty.\n+func (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n+\tif !validAttemptFileName(attemptID) {\n+\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n+\t}\n+\tmarkers, _, err := s.ListDelegationActive()\n+\tif err != nil {\n+\t\treturn ReviewRun{}, err\n+\t}\n+\tvar marker *DelegationActiveRun\n+\tfor i := range markers {\n+\t\tif markers[i].AttemptID == attemptID {\n+\t\t\tmarker = &markers[i]\n+\t\t}\n+\t}\n+\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n+\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n+\t}\n+\tdir, err := s.delegationActiveDir(true)\n+\tif err != nil {\n+\t\treturn ReviewRun{}, err\n+\t}\n+\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n+\tif err != nil {\n+\t\treturn ReviewRun{}, err\n+\t}\n+\tdefer lock.Close()\n+\tunlock, err := lockSpecTransferFile(lock)\n+\tif err != nil {\n+\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n+\t}\n+\tdefer unlock()\n+\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n+}\n+\n+func (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n+\tvar reserved *DelegatedReviewAttempt\n+\tif marker != nil {\n+\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n+\t\tif err != nil {\n+\t\t\treturn ReviewRun{}, err\n+\t\t}\n+\t\tfor i := range attempts {\n+\t\t\tif attempts[i].AttemptID == attemptID {\n+\t\t\t\treserved = &attempts[i]\n+\t\t\t}\n+\t\t}\n+\t\tif reserved == nil {\n+\t\t\t// The dispatch ended between its marker and its reservation:\n+\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n+\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n+\t\t}\n+\t} else {\n+\t\tif !operatorConfirmed {\n+\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n+\t\t}\n+\t\torphans, _, err := s.orphanReservations(now)\n+\t\tif err != nil {\n+\t\t\treturn ReviewRun{}, err\n+\t\t}\n+\t\tfor i := range orphans {\n+\t\t\tif orphans[i].AttemptID == attemptID {\n+\t\t\t\treserved = &orphans[i]\n+\t\t\t}\n+\t\t}\n+\t\tif reserved == nil {\n+\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n+\t\t}\n+\t}\n+\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n+\t\t// A release that stopped after the receipt completes by removing\n+\t\t// the stalled marker; with no marker there is nothing to release.\n+\t\tif marker != nil {\n+\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n+\t\t\tif err != nil {\n+\t\t\t\treturn ReviewRun{}, err\n+\t\t\t}\n+\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n+\t\t\tif err != nil {\n+\t\t\t\treturn ReviewRun{}, err\n+\t\t\t}\n+\t\t\treturn run, s.removeDelegationMarker(*marker)\n+\t\t}\n+\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n+\t} else if !errors.Is(err, os.ErrNotExist) {\n+\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n+\t}\n+\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n+\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n+\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n+\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n+\tif marker != nil {\n+\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n+\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n+\t} else {\n+\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n+\t}\n+\t// A run the attempt already recorded, by its dispatch or by a release\n+\t// interrupted before the receipt, completes the attempt; no second run\n+\t// is written for it.\n+\trecorded, found, err := s.recordedAttemptRun(*reserved)\n+\tif err != nil {\n+\t\treturn ReviewRun{}, err\n+\t}\n+\tif !found {\n+\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n+\t\t\treturn ReviewRun{}, err\n+\t\t}\n+\t}\n+\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n+\t\treturn recorded, err\n+\t}\n+\tif marker != nil {\n+\t\treturn recorded, s.removeDelegationMarker(*marker)\n+\t}\n+\treturn recorded, nil\n+}\n+\n+// recordedAttemptRun finds the latest run recorded for attempt a.\n+func (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n+\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n+\tif err != nil {\n+\t\treturn ReviewRun{}, false, err\n+\t}\n+\tif len(lost) > 0 {\n+\t\t// An unreadable run may be this release's: the history is unknown,\n+\t\t// and the release does not write another (review round 4, N3).\n+\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n+\t}\n+\tvar latest *ReviewRun\n+\tfor i := range runs {\n+\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n+\t\t\tlatest = &runs[i]\n+\t\t}\n+\t}\n+\tif latest == nil {\n+\t\treturn ReviewRun{}, false, nil\n+\t}\n+\treturn *latest, true, nil\n+}\n+\n+// orphanReservations lists the reservations left without a receipt or a\n+// marker, older than reviewOrphanReservationAge, and\n+// says which reservations or receipts it could not read (review round 3, N3).\n+func (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n+\tbase := filepath.Join(s.Root, reviewAttemptDir)\n+\tdirs, err := os.ReadDir(base)\n+\tif errors.Is(err, os.ErrNotExist) {\n+\t\treturn nil, nil, nil\n+\t}\n+\tif err != nil {\n+\t\treturn nil, nil, err\n+\t}\n+\tmarkers, markerLost, err := s.ListDelegationActive()\n+\tif err != nil {\n+\t\treturn nil, nil, err\n+\t}\n+\tif len(markerLost) > 0 {\n+\t\t// An unreadable marker may be a live attempt's: nothing is known to\n+\t\t// have no marker (review round 6, N1).\n+\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n+\t}\n+\tmarked := map[string]bool{}\n+\tfor _, m := range markers {\n+\t\tmarked[m.AttemptID] = true\n+\t}\n+\truns, runLost, err := s.ReadReviewRuns(\"\")\n+\tif err != nil {\n+\t\treturn nil, nil, err\n+\t}\n+\tif len(runLost) > 0 {\n+\t\t// Without the whole run history nothing is known to have no run.\n+\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n+\t}\n+\t// A recorded run does not finish an attempt, its receipt does: a\n+\t// reservation whose run was recorded without a receipt still blocks and\n+\t// is released with that run (review round 5, N3).\n+\t_ = runs\n+\tvar out []DelegatedReviewAttempt\n+\tvar lost []string\n+\tbudget := reviewReadBudget(nil)\n+\tfor _, d := range dirs {\n+\t\tif !d.IsDir() {\n+\t\t\tcontinue\n+\t\t}\n+\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n+\t\tif err != nil {\n+\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor _, e := range entries {\n+\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tvar a DelegatedReviewAttempt\n+\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n+\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tif a.AttemptID != attemptIdentity(a) {\n+\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tif marked[a.AttemptID] {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n+\t\t\t\tcontinue\n+\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n+\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n+\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tout = append(out, a)\n+\t\t}\n+\t}\n+\treturn out, lost, nil\n+}\n+\n+func (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n+\tdir, err := s.delegationActiveDir(false)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n+\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n+\t\t\treturn err\n+\t\t}\n+\t}\n+\treturn nil\n+}\ndiff --git a/pose-mcp/internal/pose/review_attempt_ledger.go b/pose-mcp/internal/pose/review_attempt_ledger.go\nindex 31f33c6d..8cd9edb4 100644\n--- a/pose-mcp/internal/pose/review_attempt_ledger.go\n+++ b/pose-mcp/internal/pose/review_attempt_ledger.go\n@@ -354,7 +354,7 @@ func (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (\n \tbudget := reviewReadBudget(budgets)\n \tvar r reviewAttemptReceipt\n \tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n-\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly: %w\", a.AttemptID, err)\n+\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n \t}\n \tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n \t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n@@ -416,7 +416,10 @@ func (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttem\n \t}\n \treturn attempts, count, nil\n }\n-func (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n+\n+// prepareDelegatedReviewAttempt admits and builds the next reservation of\n+// the bundle without publishing it.\n+func (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n \tattempts, _, err := s.reviewAttemptAdmission(plan)\n \tif err != nil {\n \t\treturn DelegatedReviewAttempt{}, err\n@@ -427,11 +430,20 @@ func (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (D\n \t}\n \ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n \ta.AttemptID = attemptIdentity(a)\n+\treturn a, nil\n+}\n+\n+// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n+// marks the attempt active first, so a dispatch that ends after this point\n+// always leaves a marker that turns stalled and that `pose delegate cancel`\n+// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n+// review round 1, N1).\n+func (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n \trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n \tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n-\t\treturn DelegatedReviewAttempt{}, fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n+\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n \t}\n-\treturn a, nil\n+\treturn nil\n }\n func (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n \traw, _ := json.Marshal(run)\n@@ -862,3 +874,13 @@ func (s Store) delegatedReviewInsights(sinceDays int) *DelegatedReviewInsights {\n \tresult.ByAdapter = finish(adapters)\n \treturn result\n }\n+\n+// reserveDelegatedReviewAttempt prepares and publishes a reservation at once,\n+// for callers that hold no active marker.\n+func (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n+\ta, err := s.prepareDelegatedReviewAttempt(plan, at)\n+\tif err != nil {\n+\t\treturn DelegatedReviewAttempt{}, err\n+\t}\n+\treturn a, s.publishDelegatedReviewAttempt(a)\n+}\ndiff --git a/pose-mcp/internal/pose/review_dispatch.go b/pose-mcp/internal/pose/review_dispatch.go\nindex 88a753fa..fb43ba90 100644\n--- a/pose-mcp/internal/pose/review_dispatch.go\n+++ b/pose-mcp/internal/pose/review_dispatch.go\n@@ -713,7 +713,7 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \tvar attempt DelegatedReviewAttempt\n \tif plan.predecessor == nil {\n \t\tvar err error\n-\t\tattempt, err = s.reserveDelegatedReviewAttempt(plan, now())\n+\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n \t\tif err != nil {\n \t\t\treturn ReviewRun{}, err\n \t\t}\n@@ -749,8 +749,9 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t// when the run was marked, at return otherwise (spec\n \t// pose-delegation-result-before-marker R1–R2).\n \tresultPublished := false\n+\treserved := plan.predecessor != nil\n \tpublishResult := func() {\n-\t\tif resultPublished || result.RunID == \"\" {\n+\t\tif resultPublished || result.RunID == \"\" || !reserved {\n \t\t\treturn\n \t\t}\n \t\tresultPublished = true\n@@ -768,8 +769,26 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \tdefer publishResult()\n \tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n \tif err != nil {\n+\t\tif plan.predecessor == nil {\n+\t\t\t// The attempt is reserved anyway, so the failed run and its\n+\t\t\t// receipt are recorded against it, as before the marker moved\n+\t\t\t// ahead of the reservation (spec\n+\t\t\t// pose-delegation-result-before-marker R1–R2).\n+\t\t\tif perr := s.publishDelegatedReviewAttempt(attem