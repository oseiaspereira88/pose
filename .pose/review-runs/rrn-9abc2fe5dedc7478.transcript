{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '340,530p'\"","aggregated_output":"   340\t\t\t\tfor _, a := range out {\n   341\t\t\t\t\tif filepath.Base(attemptReceiptPath(s.Root, a)) == e.Name() {\n   342\t\t\t\t\t\tfound = true\n   343\t\t\t\t\t\tbreak\n   344\t\t\t\t\t}\n   345\t\t\t\t}\n   346\t\t\t\tif !found {\n   347\t\t\t\t\treturn nil, fmt.Errorf(\"attempt receipt has no reservation: %s\", e.Name())\n   348\t\t\t\t}\n   349\t\t\t}\n   350\t\t}\n   351\t\treturn out, nil\n   352\t}\n   353\tfunc (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (reviewAttemptReceipt, error) {\n   354\t\tbudget := reviewReadBudget(budgets)\n   355\t\tvar r reviewAttemptReceipt\n   356\t\tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n   357\t\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n   358\t\t}\n   359\t\tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n   360\t\t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n   361\t\t}\n   362\t\tvar run ReviewRun\n   363\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, r.RunID+\".json\"), &run, budget); err != nil {\n   364\t\t\treturn r, err\n   365\t\t}\n   366\t\traw, _ := json.Marshal(run)\n   367\t\tif run.AttemptID != a.AttemptID || run.BundleID != a.BundleID || run.BundleDigest != a.BundleDigest || run.Adapter != a.Adapter || digestBytes(raw) != r.RunDigest {\n   368\t\t\treturn r, fmt.Errorf(\"attempt receipt does not bind its final run\")\n   369\t\t}\n   370\t\treturn r, nil\n   371\t}\n   372\tfunc (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttempt, int, error) {\n   373\t\tif len(plan.Reason) > 2048 || strings.ContainsAny(plan.Reason, \"\\x00\\r\\n\") {\n   374\t\t\treturn nil, 0, fmt.Errorf(\"rerun reason must be one line of at most 2048 bytes\")\n   375\t\t}\n   376\t\truns, lost, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n   377\t\tif err != nil {\n   378\t\t\treturn nil, 0, err\n   379\t\t}\n   380\t\tif len(lost) > 0 {\n   381\t\t\treturn nil, 0, fmt.Errorf(\"review run coverage is unknown: %v\", lost)\n   382\t\t}\n   383\t\tattempts, err := s.readDelegatedReviewAttempts(plan.Bundle.BundleID)\n   384\t\tif err != nil {\n   385\t\t\treturn nil, 0, err\n   386\t\t}\n   387\t\tknownAttempts := map[string]bool{}\n   388\t\tcount := 0\n   389\t\treceiptBudget := int64(32 << 20)\n   390\t\tfor _, a := range attempts {\n   391\t\t\tknownAttempts[a.AttemptID] = true\n   392\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   393\t\t\t\treturn nil, 0, err\n   394\t\t\t}\n   395\t\t\tif a.Adapter == plan.Adapter {\n   396\t\t\t\tcount++\n   397\t\t\t}\n   398\t\t}\n   399\t\tcompleted := false\n   400\t\tfor _, run := range runs {\n   401\t\t\tif run.AttemptID != \"\" && !knownAttempts[run.AttemptID] {\n   402\t\t\t\treturn nil, 0, fmt.Errorf(\"missing attempt reservation %s\", run.AttemptID)\n   403\t\t\t}\n   404\t\t\tif run.Status == ReviewRunCompleted {\n   405\t\t\t\tcompleted = true\n   406\t\t\t}\n   407\t\t\tif run.AttemptID == \"\" && run.Adapter == plan.Adapter {\n   408\t\t\t\tcount++\n   409\t\t\t}\n   410\t\t}\n   411\t\tif count >= effectiveReviewMaxRuns(plan.Config) {\n   412\t\t\treturn nil, count, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"budget exhausted: %d attempt(s) of %s on this bundle, at most %d\", count, plan.Adapter, effectiveReviewMaxRuns(plan.Config)))\n   413\t\t}\n   414\t\tif completed && strings.TrimSpace(plan.Reason) == \"\" {\n   415\t\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n   416\t\t}\n   417\t\treturn attempts, count, nil\n   418\t}\n   419\t\n   420\t// prepareDelegatedReviewAttempt admits and builds the next reservation of\n   421\t// the bundle without publishing it.\n   422\tfunc (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n   423\t\tattempts, _, err := s.reviewAttemptAdmission(plan)\n   424\t\tif err != nil {\n   425\t\t\treturn DelegatedReviewAttempt{}, err\n   426\t\t}\n   427\t\tnonce := make([]byte, 16)\n   428\t\tif _, err := rand.Read(nonce); err != nil {\n   429\t\t\treturn DelegatedReviewAttempt{}, err\n   430\t\t}\n   431\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n   432\t\ta.AttemptID = attemptIdentity(a)\n   433\t\treturn a, nil\n   434\t}\n   435\t\n   436\t// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n   437\t// marks the attempt active first, so a dispatch that ends after this point\n   438\t// always leaves a marker that turns stalled and that `pose delegate cancel`\n   439\t// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n   440\t// review round 1, N1).\n   441\tfunc (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n   442\t\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n   443\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n   444\t\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n   445\t\t}\n   446\t\treturn nil\n   447\t}\n   448\tfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n   449\t\traw, _ := json.Marshal(run)\n   450\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n   451\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n   452\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n   453\t}\n   454\t\n   455\t// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n   456\t// exists for legacy records; their content identity remains independently checked.\n   457\tfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n   458\t\tbudget := int64(32 << 20)\n   459\t\treturn s.reviewRunLedgerFindings(bundle, &budget)\n   460\t}\n   461\tfunc (s Store) reviewRunLedgerFindings(bundle string, budget *int64) ([]string, error) {\n   462\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, reviewRunLedgerDir)\n   463\t\tif err != nil {\n   464\t\t\treturn nil, err\n   465\t\t}\n   466\t\tfindings := []string{}\n   467\t\tvar checkedBytes int64\n   468\t\tfor _, e := range entries {\n   469\t\t\tif IsPublisherStaging(e.Name()) {\n   470\t\t\t\tcontinue\n   471\t\t\t}\n   472\t\t\tvar w reviewRunWitness\n   473\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunLedgerDir, e.Name()), &w, budget); err != nil {\n   474\t\t\t\tfindings = append(findings, err.Error())\n   475\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   476\t\t\t\t\tbreak\n   477\t\t\t\t}\n   478\t\t\t\tcontinue\n   479\t\t\t}\n   480\t\t\tif w.SchemaVersion != 1 || e.Name() != w.RunID+\".json\" || strings.ContainsAny(w.RunID, \"/\\\\\") {\n   481\t\t\t\tfindings = append(findings, \"invalid run witness \"+e.Name())\n   482\t\t\t\tcontinue\n   483\t\t\t}\n   484\t\t\tvar run ReviewRun\n   485\t\t\traw, readErr := readLedgerRawBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, w.RunID+\".json\"), budget)\n   486\t\t\tif readErr != nil {\n   487\t\t\t\tfindings = append(findings, \"witnessed run \"+w.RunID+\": \"+readErr.Error())\n   488\t\t\t\tif errors.Is(readErr, errReviewLedgerBudget) {\n   489\t\t\t\t\tbreak\n   490\t\t\t\t}\n   491\t\t\t\tcontinue\n   492\t\t\t}\n   493\t\t\tif err := strictJSONBytes(raw, &run); err != nil {\n   494\t\t\t\tfindings = append(findings, \"unreadable witnessed run \"+w.RunID)\n   495\t\t\t\tcontinue\n   496\t\t\t}\n   497\t\t\tif validateReviewRunRecord(w.RunID+\".json\", run) != nil || digestBytes(raw) != w.RecordDigest || run.TranscriptDigest != w.TranscriptDigest || run.BundleID != w.BundleID || run.Scope != w.Scope {\n   498\t\t\t\tfindings = append(findings, \"rewritten witnessed run \"+w.RunID)\n   499\t\t\t\tcontinue\n   500\t\t\t}\n   501\t\t\tif bundle != \"\" && run.BundleID != bundle {\n   502\t\t\t\tcontinue\n   503\t\t\t}\n   504\t\t\tinfo, statErr := s.fsys().Lstat(filepath.Join(s.Root, run.TranscriptPath))\n   505\t\t\tif statErr == nil {\n   506\t\t\t\tcheckedBytes += info.Size()\n   507\t\t\t}\n   508\t\t\tif checkedBytes > 512<<20 {\n   509\t\t\t\tfindings = append(findings, \"run transcript verification exceeds 512 MiB operation budget\")\n   510\t\t\t\tbreak\n   511\t\t\t}\n   512\t\t\tif why := s.reviewRunTranscriptIntact(run); why != \"\" {\n   513\t\t\t\tfindings = append(findings, w.RunID+\": \"+why)\n   514\t\t\t}\n   515\t\t}\n   516\t\treturn findings, nil\n   517\t}\n   518\t\n   519\ttype reviewHistoryBuffer struct{ bytes.Buffer }\n   520\t\n   521\tfunc (b *reviewHistoryBuffer) Write(p []byte) (int, error) {\n   522\t\tif b.Len()+len(p) > 8<<20 {\n   523\t\t\treturn 0, fmt.Errorf(\"review history Git output exceeds 8 MiB\")\n   524\t\t}\n   525\t\treturn b.Buffer.Write(p)\n   526\t}\n   527\tfunc reviewHistoryGit(root string, args ...string) ([]byte, error) {\n   528\t\tctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)\n   529\t\tdefer cancel()\n   530\t\tbase := gitCommand(append([]string{\"-C\", root}, args...)...)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/delegate.go | sed -n '760,1010p'\"","aggregated_output":"   760\t\tsort.Strings(keys)\n   761\t\tfor _, k := range keys {\n   762\t\t\tif route, ok := extra[k].(*posemodel.DelegationRoutingRecord); ok {\n   763\t\t\t\tif route != nil {\n   764\t\t\t\t\tout.Field(\"delegate.routing\", routeSummary(route))\n   765\t\t\t\t}\n   766\t\t\t\tcontinue\n   767\t\t\t}\n   768\t\t\tif value := fmt.Sprint(extra[k]); value != \"\" {\n   769\t\t\t\tout.Field(\"delegate.\"+k, value)\n   770\t\t\t}\n   771\t\t}\n   772\t\tout.Field(\"delegate.dry_run\", tr(\"true (nothing reserved or claimed)\", \"true (nada reservado nem reivindicado)\"))\n   773\t\treturn 0\n   774\t}\n   775\t\n   776\tfunc delegatePrintRun(stdout, stderr io.Writer, jsonOut bool, command string, run posemodel.ReviewRun, err error, next ...delegateNextAction) int {\n   777\t\tcode := 0\n   778\t\tif err != nil || run.Status != posemodel.ReviewRunCompleted {\n   779\t\t\tcode = 1\n   780\t\t}\n   781\t\tattestation := tr(\"not recorded: a run's conclusion is recorded only by the engine's verified step\", \"não registrada: a conclusão de um run só é registrada pelo passo verificado do motor\")\n   782\t\tif jsonOut {\n   783\t\t\tdoc := map[string]any{\"schema\": delegateRunSchema, \"purpose\": run.Purpose, \"agent\": run.Adapter, \"vendor\": run.Vendor, \"model\": run.Model,\n   784\t\t\t\t\"label\": run.Label, \"lead\": run.Lead, \"scope\": run.Scope, \"bundle\": run.BundleID, \"attempt\": run.AttemptID, \"run\": run.RunID, \"resumes\": run.Resumes, \"hands_off_from\": run.HandsOffFrom,\n   785\t\t\t\t\"status\": run.Status, \"failure\": run.Failure, \"record\": run.Path, \"events\": run.EventsDigest != \"\", \"env_removed\": run.EnvRemoved, \"attestation\": attestation}\n   786\t\t\tif run.Interruption != nil {\n   787\t\t\t\tdoc[\"interruption\"] = run.Interruption\n   788\t\t\t}\n   789\t\t\tif run.Safety != nil {\n   790\t\t\t\tdoc[\"safety\"] = run.Safety\n   791\t\t\t}\n   792\t\t\tif len(next) > 0 {\n   793\t\t\t\tdoc[\"next_actions\"] = next\n   794\t\t\t}\n   795\t\t\tif err != nil {\n   796\t\t\t\tdoc[\"error\"] = strings.TrimPrefix(err.Error(), \"pose: \")\n   797\t\t\t}\n   798\t\t\twriteDelegateJSON(stdout, doc)\n   799\t\t\treturn code\n   800\t\t}\n   801\t\tout := render(stdout, stderr)\n   802\t\tif run.RunID != \"\" {\n   803\t\t\tout.Field(\"delegate.purpose\", run.Purpose)\n   804\t\t\tout.Field(\"delegate.agent\", fmt.Sprintf(\"%s (%s %s)\", run.Adapter, run.Vendor, run.Model))\n   805\t\t\tif run.Label != \"\" {\n   806\t\t\t\tout.Field(\"delegate.label\", run.Label)\n   807\t\t\t}\n   808\t\t\tout.Field(\"delegate.attempt\", run.AttemptID)\n   809\t\t\tif run.Resumes != \"\" {\n   810\t\t\t\tout.Field(\"delegate.resumes\", run.Resumes)\n   811\t\t\t}\n   812\t\t\tif run.HandsOffFrom != \"\" {\n   813\t\t\t\tout.Field(\"delegate.hands_off_from\", run.HandsOffFrom)\n   814\t\t\t}\n   815\t\t\tout.Field(\"delegate.run\", run.RunID)\n   816\t\t\t// R9 outside a terminal: the ways forward of a stopped run.\n   817\t\t\tfor _, action := range next {\n   818\t\t\t\tvalue := action.Command\n   819\t\t\t\tif !action.Available {\n   820\t\t\t\t\tvalue = tr(\"unavailable: \", \"indisponível: \") + action.Why\n   821\t\t\t\t} else if value == \"\" {\n   822\t\t\t\t\tvalue = action.Why\n   823\t\t\t\t}\n   824\t\t\t\tout.Field(\"delegate.next.\"+action.Action, value)\n   825\t\t\t}\n   826\t\t\tout.Field(\"delegate.status\", run.Status)\n   827\t\t\tif run.Failure != \"\" {\n   828\t\t\t\tout.Field(\"delegate.failure\", run.Failure)\n   829\t\t\t}\n   830\t\t\tif run.Interruption != nil {\n   831\t\t\t\tout.Field(\"delegate.interruption\", fmt.Sprintf(\"cause=%s resumable=%t reset_at=%s\", run.Interruption.Cause, run.Interruption.Resumable, run.Interruption.ResetAt))\n   832\t\t\t}\n   833\t\t\tif run.Safety != nil {\n   834\t\t\t\traw, _ := json.Marshal(run.Safety)\n   835\t\t\t\tout.Field(\"delegate.safety\", string(raw))\n   836\t\t\t}\n   837\t\t\tout.Field(\"delegate.record\", run.Path)\n   838\t\t\tout.Field(\"delegate.attestation\", attestation)\n   839\t\t}\n   840\t\tif err != nil {\n   841\t\t\tout.Failure(\"pose delegate \" + command + \": \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   842\t\t}\n   843\t\treturn code\n   844\t}\n   845\t\n   846\tfunc delegateAge(at string) string {\n   847\t\tt, err := time.Parse(time.RFC3339Nano, at)\n   848\t\tif err != nil {\n   849\t\t\treturn \"unknown\"\n   850\t\t}\n   851\t\td := time.Since(t)\n   852\t\tswitch {\n   853\t\tcase d < time.Minute:\n   854\t\t\treturn fmt.Sprintf(\"%ds\", int(d.Seconds()))\n   855\t\tcase d < time.Hour:\n   856\t\t\treturn fmt.Sprintf(\"%dm\", int(d.Minutes()))\n   857\t\tcase d < 48*time.Hour:\n   858\t\t\treturn fmt.Sprintf(\"%dh\", int(d.Hours()))\n   859\t\t}\n   860\t\treturn fmt.Sprintf(\"%dd\", int(d.Hours()/24))\n   861\t}\n   862\t\n   863\tfunc cmdDelegateLs(root string, args []string, stdout, stderr io.Writer) int {\n   864\t\tf, problem := parseDelegateFlags(args, \"--active\")\n   865\t\tif problem == \"\" && len(f.positional) > 1 {\n   866\t\t\tproblem = tr(\"one reference at most\", \"no máximo uma referência\")\n   867\t\t}\n   868\t\tif problem != \"\" {\n   869\t\t\treturn delegateUsage(stdout, stderr, args, \"ls\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate ls [<run>|<bundle-id>] [--active] [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>] [--json]\")\n   870\t\t}\n   871\t\tstore := posemodel.Store{Root: root}\n   872\t\tattempts, lost, err := store.ListDelegationAttempts()\n   873\t\tif err != nil {\n   874\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 1, err)\n   875\t\t}\n   876\t\tif len(f.positional) == 1 && !strings.HasPrefix(f.positional[0], \"rvb-\") {\n   877\t\t\tone, err := posemodel.ResolveDelegationRef(attempts, f.positional[0])\n   878\t\t\tif err != nil {\n   879\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, withDelegationLosses(refError(err), lost))\n   880\t\t\t}\n   881\t\t\t// A named run is refused when a selecting flag does not match it, as on\n   882\t\t\t// every other lifecycle command (D8); without a reference they filter.\n   883\t\t\tif flag := f.mismatch(one); flag != \"\" {\n   884\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, errors.New(tr(\"attempt \"+one.AttemptID+\" does not match \"+flag, \"a tentativa \"+one.AttemptID+\" não corresponde a \"+flag)))\n   885\t\t\t}\n   886\t\t\tattempts = []posemodel.DelegationAttempt{one}\n   887\t\t}\n   888\t\tselected := []posemodel.DelegationAttempt{}\n   889\t\tfor _, a := range attempts {\n   890\t\t\tif len(f.positional) == 1 && strings.HasPrefix(f.positional[0], \"rvb-\") && a.BundleID != f.positional[0] {\n   891\t\t\t\tcontinue\n   892\t\t\t}\n   893\t\t\tif f.active && !a.Active || f.mismatch(a) != \"\" {\n   894\t\t\t\tcontinue\n   895\t\t\t}\n   896\t\t\tselected = append(selected, a)\n   897\t\t}\n   898\t\tif lost == nil {\n   899\t\t\tlost = []string{}\n   900\t\t}\n   901\t\tif f.jsonOut {\n   902\t\t\t// R9: a stopped attempt carries the ways forward it has now.\n   903\t\t\ttype listed struct {\n   904\t\t\t\tposemodel.DelegationAttempt\n   905\t\t\t\tNextActions []delegateNextAction `json:\"next_actions,omitempty\"`\n   906\t\t\t}\n   907\t\t\trows := make([]listed, 0, len(selected))\n   908\t\t\tfor _, a := range selected {\n   909\t\t\t\trows = append(rows, listed{a, delegateNextActions(store, a)})\n   910\t\t\t}\n   911\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateListSchema, \"attempts\": rows, \"losses\": lost})\n   912\t\t} else {\n   913\t\t\tout := render(stdout, stderr)\n   914\t\t\tif len(selected) == 0 {\n   915\t\t\t\tout.Field(\"delegate.runs\", tr(\"none\", \"nenhum\"))\n   916\t\t\t}\n   917\t\t\tfor _, a := range selected {\n   918\t\t\t\tvalue := fmt.Sprintf(\"state=%s purpose=%s agent=%s turns=%d age=%s\", a.State, a.Purpose, a.Agent, a.Turns, delegateAge(a.StartedAt))\n   919\t\t\t\tif a.Round > 0 {\n   920\t\t\t\t\tvalue += fmt.Sprintf(\" round=%d\", a.Round)\n   921\t\t\t\t}\n   922\t\t\t\tif a.Label != \"\" {\n   923\t\t\t\t\tvalue += \" label=\" + a.Label\n   924\t\t\t\t}\n   925\t\t\t\tif a.Active && a.Liveness != \"\" {\n   926\t\t\t\t\tvalue += \" owner=\" + a.Liveness\n   927\t\t\t\t}\n   928\t\t\t\tif a.HeartbeatAge != \"\" {\n   929\t\t\t\t\tvalue += \" heartbeat=\" + a.HeartbeatAge\n   930\t\t\t\t}\n   931\t\t\t\tif a.StalledAt != \"\" {\n   932\t\t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n   933\t\t\t\t}\n   934\t\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n   935\t\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n   936\t\t\t\t}\n   937\t\t\t\tif a.HookFailure != \"\" {\n   938\t\t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n   939\t\t\t\t}\n   940\t\t\t\tif a.Interruption != nil {\n   941\t\t\t\t\tvalue += fmt.Sprintf(\" cause=%s resumable=%t partial=%t\", a.Interruption.Cause, a.Interruption.Resumable, a.Partial)\n   942\t\t\t\t\tif a.Interruption.ResetAt != \"\" {\n   943\t\t\t\t\t\tvalue += \" reset_at=\" + a.Interruption.ResetAt + \" time_left=\" + a.TimeLeft\n   944\t\t\t\t\t}\n   945\t\t\t\t}\n   946\t\t\t\tif a.LatestRun != \"\" {\n   947\t\t\t\t\tvalue += \" run=\" + a.LatestRun\n   948\t\t\t\t}\n   949\t\t\t\tif a.LastStep != \"\" {\n   950\t\t\t\t\tvalue += \" last=\" + a.LastStep\n   951\t\t\t\t}\n   952\t\t\t\tout.Field(\"delegate.\"+a.AttemptID, value)\n   953\t\t\t}\n   954\t\t\tfor _, loss := range lost {\n   955\t\t\t\tout.Failure(tr(\"delegated run history incomplete: \", \"histórico de runs delegados incompleto: \") + loss)\n   956\t\t\t}\n   957\t\t}\n   958\t\tif len(lost) > 0 {\n   959\t\t\treturn 1\n   960\t\t}\n   961\t\treturn 0\n   962\t}\n   963\t\n   964\t// resumeTarget is the run a resume continues (R11 with the delivered\n   965\t// continuity): the run named by its id, or the attempt's latest run when it\n   966\t// is interrupted, or the interrupted run the latest one continued, whose\n   967\t// recorded continuation is then returned instead of a new run.\n   968\tfunc resumeTarget(attempt posemodel.DelegationAttempt, ref string) (string, error) {\n   969\t\tif containsString(attempt.Runs, ref) {\n   970\t\t\treturn ref, nil\n   971\t\t}\n   972\t\tlatest := attempt.Latest()\n   973\t\tswitch {\n   974\t\tcase latest == nil:\n   975\t\t\treturn \"\", errors.New(tr(\"attempt \"+attempt.AttemptID+\" has no recorded run\", \"a tentativa \"+attempt.AttemptID+\" não tem run registrado\"))\n   976\t\tcase latest.Status == posemodel.ReviewRunInterrupted:\n   977\t\t\treturn latest.RunID, nil\n   978\t\tcase latest.Resumes != \"\":\n   979\t\t\treturn latest.Resumes, nil\n   980\t\t}\n   981\t\treturn \"\", errors.New(tr(\"the latest run of attempt \"+attempt.AttemptID+\" is \"+latest.Status+\", not interrupted\",\n   982\t\t\t\"o run mais recente da tentativa \"+attempt.AttemptID+\" está \"+latest.Status+\", não interrompido\"))\n   983\t}\n   984\t\n   985\tfunc cmdDelegateResume(root string, args []string, stdout, stderr io.Writer) int {\n   986\t\tf, problem := parseDelegateFlags(args, \"--wait-until-reset\", \"--prompt\", \"--detach\")\n   987\t\tif problem != \"\" {\n   988\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate resume <run> [--wait-until-reset[=<max>]] [--prompt <file|->] [--detach] [--dry-run] [--json]\")\n   989\t\t}\n   990\t\t// A detached resume is this command run again in its own session (spec\n   991\t\t// pose-delegation-mcp R4); it hands its attempt back once it starts.\n   992\t\tif f.detach && !f.dryRun && !delegateSupervised() {\n   993\t\t\tif f.wait {\n   994\t\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", tr(\"--detach does not wait for a reset: resume after it, or without --detach\", \"--detach não espera um reset: retome depois dele, ou sem --detach\"))\n   995\t\t\t}\n   996\t\t\treturn detachDelegateRun(root, \"resume\", args, f, stdout, stderr)\n   997\t\t}\n   998\t\tstore := cliGovernedStore(root)\n   999\t\tattempts, _, err := store.ListDelegationAttempts()\n  1000\t\tif err != nil {\n  1001\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1002\t\t}\n  1003\t\tattempt, code, err := namedAttempt(attempts, f)\n  1004\t\tif err != nil {\n  1005\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", code, err)\n  1006\t\t}\n  1007\t\tif attempt.Active {\n  1008\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, errors.New(tr(\"attempt \"+attempt.AttemptID+\" is still running\", \"a tentativa \"+attempt.AttemptID+\" ainda está rodando\")))\n  1009\t\t}\n  1010\t\tref := attempt.AttemptID\n","exit_code":0,"status":"completed"}}
