legateLs(root string, args []string, stdout, stderr io.Writer) int {\n \t\t\tif a.StalledAt != \"\" {\n \t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n \t\t\t}\n+\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n+\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n+\t\t\t}\n \t\t\tif a.HookFailure != \"\" {\n \t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n \t\t\t}\n@@ -1105,9 +1110,9 @@ func cmdDelegateResume(root string, args []string, stdout, stderr io.Writer) int\n }\n \n func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n-\tf, problem := parseDelegateFlags(args)\n+\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n \tif problem != \"\" {\n-\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--dry-run] [--json]\")\n+\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n \t}\n \tstore := posemodel.Store{Root: root}\n \tattempts, lost, err := store.ListDelegationAttempts()\n@@ -1118,6 +1123,33 @@ func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int\n \tif err != nil {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n \t}\n+\tif !attempt.Active && !f.dryRun {\n+\t\t// An attempt whose dispatch, or whose earlier release, ended before\n+\t\t// its receipt is released with a failed run and its receipt, so it\n+\t\t// stops blocking the bundle; the release proves the abandonment\n+\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n+\t\t// review round 4, N1).\n+\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n+\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n+\t\t}\n+\t\tif err != nil {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n+\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n+\t\t}\n+\t\tif f.jsonOut {\n+\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n+\t\t\treturn 0\n+\t\t}\n+\t\tout := render(stdout, stderr)\n+\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n+\t\tif run.RunID == \"\" {\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n+\t\t} else {\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n+\t\t}\n+\t\treturn 0\n+\t}\n \tif !attempt.Active {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n \t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\ndiff --git a/pose-mcp/internal/cli/help_catalog.go b/pose-mcp/internal/cli/help_catalog.go\nindex 6df8f572..2055220f 100644\n--- a/pose-mcp/internal/cli/help_catalog.go\n+++ b/pose-mcp/internal/cli/help_catalog.go\n@@ -362,7 +362,7 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"wait\", \"pose delegate wait <run> [--timeout <d>] [--json]\", \"Block until a run ends; exit 0 approved, 10 changes requested or rejected, 20 failed, 30 interrupted, 40 stalled, 50 timed out\", \"Bloqueia até um run terminar; sai com 0 aprovado, 10 mudanças pedidas ou rejeitado, 20 falhou, 30 interrompido, 40 travado, 50 tempo esgotado\"},\n \t\t\t{\"resume\", \"pose delegate resume <run> [--wait-until-reset[=<max>]] [--prompt <file|->] [--detach] [--dry-run] [--json]\", \"Continue an interrupted run with the same agent and session, under its original attempt; repeating it returns the recorded continuation\", \"Retoma um run interrompido com o mesmo agente e sessão, sob a tentativa original; repetir devolve a continuação registrada\"},\n \t\t\t{\"handoff\", \"pose delegate handoff <run> --to <agent|auto> [--detach] [--dry-run] [--json]\", \"Continue a stopped run with another agent under the same attempt and budget, its brief carrying the stopped run's quoted partial and commands\", \"Continua um run parado com outro agente na mesma tentativa e orçamento, com o brief levando o parcial citado e os comandos do run parado\"},\n-\t\t\t{\"cancel\", \"pose delegate cancel <run> [--dry-run] [--json]\", \"Stop a running run; it is recorded failed with the cause cancelled and its attempt stays consumed\", \"Para um run em andamento; ele é registrado como failed com a causa cancelled e a tentativa continua consumida\"},\n+\t\t\t{\"cancel\", \"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\", \"Stop a running run; it is recorded failed with the cause cancelled and its attempt stays consumed. A stalled attempt whose dispatch ended before recording its run is released with a failed run and its receipt; one an earlier engine left without a marker needs --confirm-abandoned\", \"Para um run em andamento; ele é registrado como failed com a causa cancelled e a tentativa continua consumida. Uma tentativa parada cujo envio terminou antes de registrar o run é liberada com um run com falha e o recibo; uma que um motor anterior deixou sem marcador exige --confirm-abandoned\"},\n \t\t\t{\"agents\", \"pose delegate agents [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>[/<model>]] [--json]\", \"List configured agents with vendor, model, whether their CLI is on the path, their last usage-limit reset and their state: available, limited until <instant>, missing or probe-failed\", \"Lista os agentes configurados com vendor, modelo, se a CLI está no path, o último reset de limite de uso e o estado: available, limited until <instante>, missing ou probe-failed\"},\n \t\t},\n \t\tExamples: []string{\n@@ -720,9 +720,9 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\tDescriptionEN:   \"Runs bounded local assessments for component LOC, dependencies, technical debt markers, public contracts, and structural deltas on a canonical review subject.\",\n \t\tDescriptionPtBR: \"Executa assessments locais e bounded de LOC, dependências, débito técnico, contratos públicos e deltas estruturais sobre um subject canônico de review.\",\n \t\tSubcommands: []SubcommandHelp{\n-\t\t\t{\"discover\", \"pose assess discover [--component <dir>] [--update-state]\", \"Discover LOC metrics, debts, and module structure\", \"Descobre métricas de LOC, débitos e estrutura de módulos\"},\n-\t\t\t{\"integrate\", \"pose assess integrate\", \"Check inter-module contracts (REST, Protobuf, Kafka, MCP)\", \"Verifica contratos inter-módulos (REST, Protobuf, Kafka, MCP)\"},\n-\t\t\t{\"tech-debt\", \"pose assess tech-debt\", \"Scan codebase for technical debt markers and uncovered stubs\", \"Escaneia a base de código por marcadores de débito e stubs\"},\n+\t\t\t{\"discover\", \"pose assess discover [--component <dir>] [--update-state] [--no-persist]\", \"Discover LOC metrics, debts, and module structure\", \"Descobre métricas de LOC, débitos e estrutura de módulos\"},\n+\t\t\t{\"integrate\", \"pose assess integrate [--update-state] [--no-persist]\", \"Check inter-module contracts (REST, Protobuf, Kafka, MCP)\", \"Verifica contratos inter-módulos (REST, Protobuf, Kafka, MCP)\"},\n+\t\t\t{\"tech-debt\", \"pose assess tech-debt [--update-state] [--no-persist]\", \"Scan codebase for technical debt markers and uncovered stubs\", \"Escaneia a base de código por marcadores de débito e stubs\"},\n \t\t\t{\"design\", \"pose assess design --spec <slug> [--json] [--max-files N] [--max-bytes N]\", \"Observe bounded structural deltas from the sealed review subject\", \"Observa deltas estruturais bounded a partir do subject selado de review\"},\n \t\t},\n \t\tExamples: []string{\ndiff --git a/pose-mcp/internal/cli/review_reap_test.go b/pose-mcp/internal/cli/review_reap_test.go\nnew file mode 100644\nindex 00000000..69fcb01a\n--- /dev/null\n+++ b/pose-mcp/internal/cli/review_reap_test.go\n@@ -0,0 +1,59 @@\n+//go:build linux\n+\n+package cli\n+\n+import (\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"strconv\"\n+\t\"strings\"\n+\t\"syscall\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/harne8/pose-mcp/internal/pose\"\n+)\n+\n+// Spec pose-review-run-reaps-lingering-reviewer-processes R1, R2, R4: a\n+// reviewer that ends while a command it started in a session of its own is\n+// still running leaves a run that completes, with that command ended before\n+// the cleanup and named in the run record.\n+func TestDispatchEndsWhatTheReviewerLeftRunning(t *testing.T) {\n+\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n+\t\tt.Skip(\"setsid is not available\")\n+\t}\n+\troot := dispatchInstance(t)\n+\tpidFile := filepath.Join(t.TempDir(), \"leftover.pid\")\n+\tscript := `cat >/dev/null; setsid sh -c 'echo $$ > \"` + pidFile + `\"; while :; do touch \"$TMPDIR/leftover\" 2>/dev/null; sleep 0.05; done' </dev/null >/dev/null 2>&1 & ` +\n+\t\t`i=0; while [ ! -s \"` + pidFile + `\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`\n+\twriteReviewers(t, root, map[string]pose.ReviewerAdapter{\"fake\": {Command: []string{\"sh\", \"-c\", script}, Vendor: \"fixture\", Model: \"fixture\", Containment: &pose.ReviewerContainment{SchemaVersion: 1, Profile: \"trusted-process\"}}})\n+\tcode, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\")\n+\traw, err := os.ReadFile(pidFile)\n+\tif err != nil {\n+\t\tt.Fatalf(\"the leftover never started: %v (%d %s)\", err, code, out)\n+\t}\n+\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n+\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n+\tdeadline := time.Now().Add(2 * time.Second)\n+\tfor syscall.Kill(pid, 0) == nil && time.Now().Before(deadline) {\n+\t\tif stat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\"); err == nil && strings.Contains(string(stat), \") Z \") {\n+\t\t\tbreak\n+\t\t}\n+\t\ttime.Sleep(50 * time.Millisecond)\n+\t}\n+\tif stat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\"); err == nil && !strings.Contains(string(stat), \") Z \") {\n+\t\tt.Fatalf(\"the process the reviewer left running survived the run: %s\", stat)\n+\t}\n+\truns, _, _ := (pose.Store{Root: root}).ReadReviewRuns(\"\")\n+\tif len(runs) != 1 {\n+\t\tt.Fatalf(\"runs: %d (%d %s)\", len(runs), code, out)\n+\t}\n+\trun := runs[0]\n+\tif run.Status != pose.ReviewRunCompleted || run.Safety == nil || run.Safety.Operation.Outcome != pose.OutcomeCompleted {\n+\t\tt.Fatalf(\"the run did not complete with its cleanup: status=%s failure=%s safety=%+v\", run.Status, run.Failure, run.Safety)\n+\t}\n+\tif !strings.Contains(strings.Join(run.Safety.Limitations, \"\\n\"), \"process(es) the run left running\") {\n+\t\tt.Fatalf(\"the run record does not name the ended process: %v\", run.Safety.Limitations)\n+\t}\n+}\n","exit_code":0,"status":"completed"}}
