resent := false\n563\t\t\tfor _, root := range roots {\n564\t\t\t\tif _, err := os.Lstat(filepath.Join(s.Root, root)); !os.IsNotExist(err) {\n565\t\t\t\t\tpresent = true\n566\t\t\t\t\tbreak\n567\t\t\t\t}\n568\t\t\t}\n569\t\t\ttracked, trackedErr := reviewHistoryGit(s.Root, append([]string{\"ls-files\", \"--\"}, roots...)...)\n570\t\t\tif !present && trackedErr == nil && len(bytes.TrimSpace(tracked)) == 0 {\n571\t\t\t\treturn uniqueSorted(findings), nil\n572\t\t\t}\n573\t\t\treturn findings, fmt.Errorf(\"delegated history Git anchor unavailable: %w\", headErr)\n574\t\t}\n575\t\n576\t\targs := append([]string{\"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\"}, roots...)\n577\t\tpending, err := reviewHistoryGit(s.Root, args...)\n578\t\tif err != nil {\n579\t\t\treturn nil, err\n580\t\t}\n581\t\targs = append([]string{\"log\", \"--format=\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\"}, roots...)\n582\t\tcommitted, err := reviewHistoryGit(s.Root, args...)\n583\t\tif err != nil {\n584\t\t\treturn nil, err\n585\t\t}\n586\t\tfor _, line := range strings.Split(string(append(pending, committed...)), \"\\n\") {\n587\t\t\tif strings.TrimSpace(line) != \"\" {\n588\t\t\t\tfindings = append(findings, \"immutable review evidence changed: \"+line)\n589\t\t\t}\n590\t\t}\n591\t\truns, lost, err := s.ReadReviewRuns(\"\")\n592\t\tif err != nil {\n593\t\t\treturn nil, err\n594\t\t}\n595\t\t_ = runs\n596\t\tfindings = append(findings, lost...)\n597\t\tattempts, losses := s.allDelegatedReviewAttempts()\n598\t\tfindings = append(findings, losses...)\n599\t\treceiptBudget := int64(32 << 20)\n600\t\tfor _, a := range attempts {\n601\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n602\t\t\t\tfindings = append(findings, err.Error())\n603\t\t\t}\n604\t\t}\n605\t\treturn uniqueSorted(findings), nil\n606\t}\n607\t\n608\t// legacyReviewDecision reads the decision line of a final message; a\n609\t// pose-draft bloc