rr := func() {}, error(nil)\")\n\tmut(\"m_ctx\", led, \"done, err := ReadOnlyIndexContext(ctx, cmd, root)\", \"done, err := ReadOnlyIndex(cmd, root)\")\n\tmut(\"m_ledgerpanic\", led, \"done, err := ReadOnlyIndexContext(ctx, cmd, root)\", \"panic(\\\"reached history diff\\\")\\n\t\tdone, err := ReadOnlyIndexContext(ctx, cmd, root)\")\n\tmut(\"m_lcall\", r, `cmd.Env = append(cmd.Env, \"LC_ALL=C\", \"LANGUAGE=C\")`, \"\")\n\tmut(\"m_wrap\", r, `return done, fmt.Errorf(\"pose: the index of %s cannot be handed to git: %w: %w\", root, ErrIndexUnreadable, err)`, \"return done, err\")\n\tmut(\"m_silence\", filepath.Join(here, \"report.go\"), \"\t\terr = nil\\n\", \"\")\n\tmut(\"m_marker\", filepath.Join(here, \"report.go\"), \"filesChanged = []string{\", \"_ = []string{\")\n}\nEOF\nprintf '{\"Replace\":{\"%s/pose-mcp/internal/cli/zz_gen_test.go\":\"%s/zz_gen_test.go\"}}' \"$PWD\" \"$TMPDIR\" > \"$TMPDIR/ov-gen.json\"; go -C pose-mcp test -overlay \"$TMPDIR/ov-gen.json\" ./internal/cli -run 'ZZGen' -count=1 2>&1\nfor m in m_fb_memfd m_fb_utimes m_fb_write m_unprot m_ledger m_ctx m_ledgerpanic m_lcall m_wrap m_silence m_marker; do printf '\\n== %s\\n' \"$m\"; go -C pose-mcp test -overlay \"$TMPDIR/$m.json\" ./internal/pose ./internal/cli -run 'ReadOnlyIndex|PrivateIndexCopy|FailedIndexRead|ValidationReads|ReportChanged|CorruptIndex' -count=1 -timeout 120s 2>&1 | cat; done; true","description":"Mutate round 2 guards via overlay and rerun tests","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3394,"cache_read_input_tokens":189007,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3394},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"f6b994f7-bb77