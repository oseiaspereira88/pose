n the index, so a fresher copy\n \t// would hide a change made in the index's own second (review round 2,\n \t// N10, racy-clean entries).\n-\treturn readOnlyIndexFor(cmd, raw, info.ModTime())\n+\t// Git's messages in English, so GitReadError can tell an index failure\n+\t// whatever the user's locale.\n+\tcmd.Env = append(cmd.Env, \"LC_ALL=C\", \"LANGUAGE=C\")\n+\tdone, err := readOnlyIndexFor(cmd, raw, info.ModTime())\n+\tif err != nil {\n+\t\treturn done, fmt.Errorf(\"pose: the index of %s cannot be handed to git: %w: %w\", root, ErrIndexUnreadable, err)\n+\t}\n+\treturn done, nil\n+}\n+\n+// GitReadError describes a failed git read with what git said on standard\n+// error, marking it ErrIndexUnreadable when git names the index (review\n+// round 1, N1–N2: a corrupt index made git exit 128 with the cause only on\n+// its standard error).\n+func GitReadError(what string, err error, stderr []byte) error {\n+\tsaid := strings.TrimSpace(string(stderr))\n+\tif said == \"\" {\n+\t\treturn fmt.Errorf(\"%s failed: %w\", what, err)\n+\t}\n+\tif strings.Contains(said, \"index\") {\n+\t\treturn fmt.Errorf(\"%s failed: %w: %w: %s\", what, ErrIndexUnreadable, err, said)\n+\t}\n+\treturn fmt.Errorf(\"%s failed: %w: %s\", what, err, said)\n }\n \n // privateIndexCopy hands raw to cmd as a private copy: Git refreshes and may\n@@ -113,5 +142,11 @@ func RawGitDiffReadOnly(root string, args ...string) ([]byte, error) {\n \tif err != nil {\n \t\treturn nil, err\n \t}\n-\treturn cmd.Output()\n+\tvar stderr bytes.Buffer\n+\tcmd.Stderr = &stderr\n+\tout, err := cmd.Output()\n+\tif err != nil {\n+\t\treturn nil, GitReadError(\"git diff\", err, stderr.Bytes())\n+\t}\n+\treturn out, nil\n }\ndiff --git a/pose-mcp/internal/pose/git_worktree_reads_linux.go b/pose-mcp/internal/pose/git_worktree_reads_linux.go\nindex c6c161f2..508b1ec5 100644\n--- a/pose-mcp/internal/pose/git_worktree_reads_linux.go\n+++ b/pose-mcp/internal/pose/git_worktree_reads_linux.go\n@@ -17,7 +17,7 @@ import (\n // exist, so the lock fails for any user, root included, and the refresh is\n // not written. No file is created.\n func readOnlyIndexFor(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), error) {\n-\tfd, err := unix.MemfdCreate(\"pose-index/none\", unix.MFD_CLOEXEC)\n+\tfd, err := memfdCreate(\"pose-index/none\", unix.MFD_CLOEXEC)\n \tif err != nil {\n \t\t// No memory file here (an old kernel, a seccomp filter): the private\n \t\t// copy keeps the index untouched too (review round 5, N27).\n@@ -26,14 +26,14 @@ func readOnlyIndexFor(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), err\n \tf := os.NewFile(uintptr(fd), \"pose-index\")\n \tif _, err := f.Write(raw); err != nil {\n \t\tf.Close()\n-\t\treturn func() {}, err\n+\t\treturn privateIndexCopy(cmd, raw, modTime) // review round 1, N8\n \t}\n \tif _, err := f.Seek(0, 0); err != nil {\n \t\tf.Close()\n-\t\treturn func() {}, err\n+\t\treturn privateIndexCopy(cmd, raw, modTime)\n \t}\n \tts := unix.NsecToTimespec(modTime.UnixNano())\n-\tif err := unix.UtimesNanoAt(unix.AT_FDCWD, fmt.Sprintf(\"/proc/self/fd/%d\", fd), []unix.Timespec{ts, ts}, 0); err != nil {\n+\tif err := utimesNanoAt(unix.AT_FDCWD, fmt.Sprintf(\"/proc/self/fd/%d\", fd), []unix.Timespec{ts, ts}, 0); err != nil {\n \t\t// Without /proc the memory file cannot carry the time, nor be named\n \t\t// to Git: the private copy is read instead (review round 5, N27).\n \t\tf.Close()\n@@ -43,3 +43,10 @@ func readOnlyIndexFor(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), err\n \tcmd.Env = append(cmd.Env, fmt.Sprintf(\"GIT_INDEX_FILE=/proc/self/fd/%d\", 2+len(cmd.ExtraFiles)))\n \treturn func() { f.Close() }, nil\n }\n+\n+// memfdCreate and utimesNanoAt are the calls the memory file needs; a test\n+// replaces them to exercise the fallback (review round 1, N4).\n+var (\n+\tmemfdCreate  = unix.MemfdCreate\n+\tutimesNanoAt = unix.UtimesNanoAt\n+)\ndiff --git a/pose-mcp/internal/pose/git_worktree_reads_linux_test.go b/pose-mcp/internal/pose/git_worktree_reads_linux_test.go\nnew file mode 100644\nindex 00000000..15c4de41\n--- /dev/null\n+++ b/pose-mcp/internal/pose/git_worktree_reads_linux_test.go\n@@ -0,0 +1,42 @@\n+//go:build linux\n+\n+package pose\n+\n+import (\n+\t\"bytes\"\n+\t\"errors\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"testing\"\n+\n+\t\"golang.org/x/sys/unix\"\n+)\n+\n+// Spec pose-validate-read-only-index-followups R4 (review round 1, N4): when\n+// no memory file can be made, or it cannot carry the index's time, the read\n+// falls back to the private copy, answers and leaves the index.\n+func TestReadOnlyIndexFallsBackWithoutAMemoryFile(t *testing.T) {\n+\tfor _, broken := range []string{\"memfd\", \"utimes\"} {\n+\t\tt.Run(broken, func(t *testing.T) {\n+\t\t\tsaveMemfd, saveUtimes := memfdCreate, utimesNanoAt\n+\t\t\tdefer func() { memfdCreate, utimesNanoAt = saveMemfd, saveUtimes }()\n+\t\t\tif broken == \"memfd\" {\n+\t\t\t\tmemfdCreate = func(string, int) (int, error) { return -1, errors.New(\"no memfd here\") }\n+\t\t\t} else {\n+\t\t\t\tutimesNanoAt = func(int, string, []unix.Timespec, int) error { return errors.New(\"no /proc here\") }\n+\t\t\t}\n+\t\t\ttop, _ := staleRepo(t, \"\")\n+\t\t\tbefore, err := os.ReadFile(filepath.Join(top, \".git\", \"index\"))\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tout, err := RawGitDiffReadOnly(top, \"-C\", top, \"diff\", \"--name-only\", \"--\")\n+\t\t\tif err != nil || len(out) != 0 {\n+\t\t\t\tt.Fatalf(\"the fallback answered %q %v\", out, err)\n+\t\t\t}\n+\t\t\tif after, _ := os.ReadFile(filepath.Join(top, \".git\", \"index\")); !bytes.Equal(before, after) {\n+\t\t\t\tt.Fatal(\"the fallback read rewrote .git/index\")\n+\t\t\t}\n+\t\t})\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/git_worktree_reads_test.go b/pose-mcp/internal/pose/git_worktree_reads_test.go\nindex 752f9e7f..4375bffa 100644\n--- a/pose-mcp/internal/pose/git_worktree_reads_test.go\n+++ b/pose-mcp/internal/pose/git_worktree_reads_test.go\n@@ -363,11 +363,25 @@ 