ignal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n   118\t\tdefer stop()\n   119\t\tif delegateSupervised() {\n   120\t\t\tplan.OnStart = supervisorHandback()\n   121\t\t}\n   122\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n   123\t\thandBackExisting(run, err)\n   124\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n   125\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"handoff\")\n   126\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"handoff\", run, err, delegateRunNextActions(store, run, err)...)\n   127\t\tif err == nil && !f.jsonOut {\n   128\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n   129\t\t\t\treturn next\n   130\t\t\t}\n   131\t\t}\n   132\t\treturn code\n   133\t}\n   134\t\n   135\t// routeHandoff routes a handoff among the agents of the stopped run's purpose,\n   136\t// the stopped agent excluded (R7).\n   137\tfunc routeHandoff(store posemodel.Store, prior posemodel.ReviewRun) (string, *posemodel.DelegationRoutingRecord, error) {\n   138\t\treaders, found, err := store.LoadReviewersPolicyFor(prior.Kind)\n   139\t\tif err != nil {\n   140\t\t\treturn \"\", nil, err\n   141\t\t}\n   142\t\tif !found {\n   143\t\t\treturn \"\", nil, posemodel.ErrNoReviewerAdapter\n   144\t\t}\n   145\t\tpolicy, _, _, err := store.LoadDelegationPolicy()\n   146\t\tif err != nil {\n   147\t\t\treturn \"\", nil, err\n   148\t\t}\n   149\t\tbundle, err := store.LoadReviewBundle(prior.BundleID)\n   150\t\tif err != nil {\n   151\t\t\treturn \"\", nil, err\n   152\t\t}\n   153\t\timpl, from, err := store.RoutingImplementation(bundle, policy, prior.Lead)\n   154\t\tif err != nil {\n   155\t\t\treturn \"\", nil, err\n   156\t\t}\n   157\t\teligible := []string{}\n   158\t\tfor name := range readers.Adapters {\n   159\t\t\tif name != prior.Adapter {\n   160\t\t\t\teligible = append(eligible, name)\n   161\t\t\t}\n   162\t\t}\n   163\t\tavail := store.DelegationAvailabilityOf(policy, time.Now(), true)\n   164\t\tagent, record, err := posemodel.RouteDelegation(policy, eligible, impl, from, avail, time.Now())\n   165\t\tif err != nil {\n   166\t\t\treturn \"\", &record, err\n   167\t\t}\n   168\t\tif record.Step == posemodel.DelegationStepWait {\n   169\t\t\treturn \"\", &record, errors.New(tr(\"every other agent is limited until \"+record.WaitUntil+\"; hand off after the reset, or wait for this run's reset and resume it\",\n   170\t\t\t\t\"todos os outros agentes estão limitados até \"+record.WaitUntil+\"; faça o handoff depois do reset, ou espere o reset deste run e o retome\"))\n   171\t\t}\n   172\t\treturn agent, &record, nil\n   173\t}\n   174\t\n   175\t// delegateNextAction is one way forward for a stopped run (R9).\n   176\ttype delegateNextAction struct {\n   177\t\tAction    string `json:\"action\"`\n   178\t\tCommand   string `json:\"command,omitempty\"`\n   179\t\tAvailable bool   `json:\"available\"`\n   180\t\tWhy       string `json:\"why,omitempty\"`\n   181\t}\n   182\t\n   183\t// delegateCancelAction leaves the attempt stopped: it has no command because\n   184\t// nothing runs to stop, nothing is spent, and a later command can still\n   185\t// continue the run (R8, R9).\n   186\tfunc delegateCancelAction() delegateNextAction {\n   187\t\treturn delegateNextAction{Action: \"cancel\", Available: true, Why: tr(\"leave the run stopped; nothing runs and the attempt's budget is kept\", \"deixar o run parado; nada roda e o orçamento da tentativa é mantido\")}\n   188\t}\n   189\t\n   190\t// delegateNextActions lists what a stopped attempt can do next, each judged by\n   191\t// the same read-only planning its command runs, so an action offered as\n   192\t// available is one its command would start (R9); nil for an attempt that runs\n   193\t// or concluded.\n   194\tfunc delegateNextActions(store posemodel.Store, a posemodel.DelegationAttempt) []delegateNextAction {\n   195\t\tlatest := a.Latest()\n   196\t\tif a.Active || latest == nil || latest.Status == posemodel.ReviewRunCompleted || latest.Status == posemodel.ReviewRunStale {\n   197\t\t\treturn nil\n   198\t\t}\n   199\t\tif latest.Purpose == posemodel.DelegationPurposeTask {\n   200\t\t\treturn delegateTaskNextActions(store, a, *latest)\n   201\t\t}\n   202\t\treason := func(err error) string { return strings.TrimPrefix(err.Error(), \"pose: \") }\n   203\t\tvar actions []delegateNextAction\n   204\t\tif i := latest.Interruption; latest.Status == posemodel.ReviewRunInterrupted && i != nil {\n   205\t\t\tresume := delegateNextAction{Action: \"resume\", Command: \"pose delegate resume \" + a.AttemptID}\n   206\t\t\tplan, err := store.PlanReviewResume(latest.RunID)\n   207\t\t\tswitch {\n   208\t\t\tcase !i.Resumable:\n   209\t\t\t\tresume.Why = tr(\"the stop is not resumable\", \"a parada não é retomável\")\n   210\t\t\tcase err != nil:\n   211\t\t\t\tresume.Why = reason(err)\n   212\t\t\tcase plan.PendingContinuation != nil || plan.Existing != nil:\n   213\t\t\t\tresume.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n   214\t\t\t}\n   215\t\t\tif resume.Why == \"\" {\n   216\t\t\t\treset, resetErr := time.Parse(time.RFC3339Nano, i.ResetAt)\n   217\t\t\t\tif i.ResetAt != \"\" && resetErr == nil && reset.After(time.Now()) {\n   218\t\t\t\t\twait := delegateNextAction{Action: \"wait\", Command: \"pose delegate resume \" + a.AttemptID + \" --wait-until-reset\"}\n   219\t\t\t\t\tif _, err := posemodel.ReviewResumeDelay(*latest, time.Now(), 24*time.Hour, 0); err != nil {\n   220\t\t\t\t\t\twait.Why = reason(err)\n   221\t\t\t\t\t} else {\n   222\t\t\t\t\t\twait.Available = true\n   223\t\t\t\t\t}\n   224\t\t\t\t\tactions = append(actions, wait)\n   225\t\t\t\t\tresume.Why = tr(\"the agent is limited until \", \"o agente está limitado até \") + i.ResetAt\n   226\t\t\t\t} else {\n   227\t\t\t\t\tresume.Available = true\n   228\t\t\t\t}\n   229\t\t\t}\n   230\t\t\tactions = append(actions, resume)\n   231\t\t}\n   232\t\thandoff := delegateNextAction{Action: \"handoff\", Command: \"pose delegate handoff \" + a.AttemptID + \" --to auto\"}\n   233\t\tif agent, _, err := routeHandoff(store, *latest); err != nil {\n   234\t\t\thandoff.Why = reason(err)\n   235\t\t} else if plan, err := store.PlanReviewHandoff(latest.RunID, agent); err != nil {\n   236\t\t\thandoff.Why = reason(err)\n   237\t\t} else if plan.PendingContinuation != nil || plan.Existing != nil {\n   238\t\t\thandoff.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n   239\t\t} else {\n   240\t\t\thandoff.Available = true\n   241\t\t}\n   242\t\treturn append(actions, handoff, delegateCancelAction())\n   243\t}\n   244\t\n   245\t// delegateRunNextActions is the ways forward of the attempt run belongs to,\n   246\t// for a run that just stopped (R9).\n   247\tfunc delegateRunNextActions(store posemodel.Store, run posemodel.ReviewRun, err error) []delegateNextAction {\n   248\t\tif err != nil || run.AttemptID == \"\" || run.Status == posemodel.ReviewRunCompleted {\n   249\t\t\treturn nil\n   250\t\t}\n   251\t\tattempts, _, lerr := store.ListDelegationAttempts()\n   252\t\tif lerr != nil {\n   253\t\t\treturn nil\n   254\t\t}\n   255\t\tfor _, a := range attempts {\n   256\t\t\tif a.AttemptID == run.AttemptID {\n   257\t\t\t\treturn delegateNextActions(store, a)\n   258\t\t\t}\n   259\t\t}\n   260\t\treturn nil\n   270\t\t\t\t}\n   271\t\t\t}\n   272\t\t}\n   273\t\tif err != nil {\n   274\t\t\tout.Failure(\"pose delegate \" + command + \": \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   275\t\t}\n   276\t\treturn code\n   277\t}\n   278\t\n   279\t// cmdDelegateTaskResume continues a stopped task with its own agent and\n   280\t// session; without --prompt it sends the default continuation message (R8).\n   281\tfunc cmdDelegateTaskResume(root string, store posemodel.Store, f delegateFlags, attempt posemodel.DelegationAttempt, target string, stdout, stderr io.Writer) int {\n   282\t\tprompt := \"\"\n   283\t\tif f.promptFile != \"\" {\n   284\t\t\tvar err error\n   285\t\t\tif prompt, err = readDelegatePrompt(f.promptFile); err != nil {\n   286\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 2, err)\n   287\t\t\t}\n   288\t\t}\n   289\t\tplan, err := store.PlanDelegationTaskResume(target, prompt)\n   290\t\tif err != nil {\n   291\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"resume\", err, nil)\n   292\t\t}\n   293\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n   294\t\tdefer stop()\n   295\t\tif f.wait && plan.Existing == nil && !f.dryRun {\n   296\t\t\tlatest := attempt.Latest()\n   297\t\t\tvar seed [1]byte\n   298\t\t\t_, _ = rand.Read(seed[:])\n   299\t\t\tdelay, err := posemodel.ReviewResumeDelay(*latest, time.Now(), f.waitMax, time.Duration(seed[0])*time.Second/255)\n   300\t\t\tif err != nil {\n   301\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n   302\t\t\t}\n   303\t\t\tif delay > 0 {\n   304\t\t\t\trender(io.Discard, stderr).Hint(\"pose delegate resume: \" + tr(\"waiting \", \"esperando \") + delay.String())\n   305\t\t\t\tselect {\n   306\t\t\t\tcase <-ctx.Done():\n   307\t\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, ctx.Err())\n   308\t\t\t\tcase <-time.After(delay):\n   309\t\t\t\t}\n   310\t\t\t\tif plan, err = store.PlanDelegationTaskResume(target, prompt); err != nil {\n   311\t\t\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"resume\", err, nil)\n   312\t\t\t\t}\n   313\t\t\t}\n   314\t\t}\n   315\t\tif plan.Existing != nil {\n   316\t\t\thandBackAttempt(plan.Existing.AttemptID)\n   317\t\t\treturn delegatePrintTask(stdout, stderr, f.jsonOut, \"resume\", *plan.Existing, nil)\n   318\t\t}\n   319\t\treturn runDelegateTask(root, store, ctx, plan, f, \"resume\", map[string]any{\"resumes\": target, \"attempt\": attempt.AttemptID}, stdout, stderr)\n   320\t}\n   321\t\n   322\t// cmdDelegateTaskHandoff continues a stopped task with another agent, its\n   323\t// prompt the stopped run's followed by the handoff section.\n   324\tfunc cmdDelegateTaskHandoff(root string, store posemodel.Store, f delegateFlags, attempt posemodel.DelegationAttempt, latest posemodel.ReviewRun, target string, stdout, stderr io.Writer) int {\n   325\t\tagent := f.to\n   326\t\truns, _ := store.ReadDelegationTaskRuns()\n   327\t\tfor _, r := range runs {\n   328\t\t\tif r.HandsOffFrom != target {\n   329\t\t\t\tcontinue\n   330\t\t\t}\n   331\t\t\tif agent != \"auto\" && agent != r.Adapter {\n   332\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"handoff\", 1, fmt.Errorf(tr(\"run %s was already handed off to %s by run %s\", \"o run %s já foi repassado para %s pelo run %s\"), target, r.Adapter, r.RunID))\n   333\t\t\t}\n   334\t\t\tagent = r.Adapter\n   335\t\t}\n   336\t\tvar route *posemodel.DelegationRoutingRecord\n   337\t\tif agent == \"auto\" {\n   338\t\t\tchosen, record, err := routeTaskHandoff(store, latest)\n   339\t\t\tif err != nil {\n   340\t\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"handoff\", err, record)\n   341\t\t\t}\n   342\t\t\tagent, route = chosen, record\n   343\t\t}\n   344\t\tplan, err := store.PlanDelegationTaskHandoff(target, agent)\n   345\t\tif err != nil {\n   346\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"handoff\", err, nil)\n   347\t\t}\n   348\t\tif plan.Existing != nil {\n   349\t\t\thandBackAttempt(plan.Existing.AttemptID)\n   350\t\t\treturn delegatePrintTask(stdout, stderr, f.jsonOut, \"handoff\", *plan.Existing, nil)\n   351\t\t}\n   352\t\tplan.Routing = route\n   353\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n   354\t\tdefer stop()\n   355\t\treturn runDelegateTask(root, store, ctx, plan, f, \"handoff\", map[string]any{\"hands_off_from\": target, \"attempt\": attempt.AttemptID}, stdout, stderr)\n   356\t}\n   357\t\n   358\t// routeTaskHandoff routes the handoff of a task among the agents with a\n   359\t// command for its access, the stopped agent excluded; it never waits.\n   360\tfunc routeTaskHandoff(store posemodel.Store, prior posemodel.ReviewRun) (string, *posemodel.DelegationRoutingRecord, error) {\n   361\t\tpolicy, _, found, err := store.LoadDelegationPolicy()\n   362\t\tif err != nil {\n   363\t\t\treturn \"\", nil, err\n   364\t\t}\n   365\t\tif !found {\n   366\t\t\treturn \"\", nil, posemodel.ErrNoReviewerAdapter\n   367\t\t}\n   368\t\tagent, record, err := routeTask(store, policy, prior.Access, \"auto\", prior.Lead, prior.Adapter)\n   369\t\tif err != nil {\n   370\t\t\treturn \"\", record, err\n   371\t\t}\n   372\t\tif record.Step == posemodel.DelegationStepWait {\n   373\t\t\treturn \"\", record, errors.New(tr(\"every other agent is limited until \"+record.WaitUntil+\"; hand off after the reset, or wait for this run's reset and resume it\",\n   374\t\t\t\t\"todos os outros agentes estão limitados até \"+record.WaitUntil+\"; faça o handoff depois do reset, ou espere o reset deste run e o retome\"))\n   375\t\t}\n   376\t\treturn agent, record, nil\n   377\t}\n   378\t\n   379\t// delegateTaskNextActions are the ways forward of a stopped task, judged by\n   380\t// the planning their commands run (R9).\n   381\tfunc delegateTaskNextActions(store posemodel.Store, a posemodel.DelegationAttempt, latest posemodel.ReviewRun) []delegateNextAction {\n   382\t\treason := func(err error) string { return strings.TrimPrefix(err.Error(), \"pose: \") }\n   383\t\tvar actions []delegateNextAction\n   384\t\tif i := latest.Interruption; latest.Status == posemodel.ReviewRunInterrupted && i != nil {\n   385\t\t\tresume := delegateNextAction{Action: \"resume\", Command: \"pose delegate resume \" + a.AttemptID}\n   386\t\t\tplan, err := store.PlanDelegationTaskResume(latest.RunID, \"\")\n   387\t\t\tswitch {\n   388\t\t\tcase !i.Resumable:\n   389\t\t\t\tresume.Why = tr(\"the stop is not resumable\", \"a parada não é retomável\")\n   390\t\t\tcase err != nil:\n   391\t\t\t\tresume.Why = reason(err)\n   392\t\t\tcase plan.Existing != nil:\n   393\t\t\t\tresume.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n   394\t\t\t}\n   395\t\t\tif resume.Why == \"\" {\n   396\t\t\t\treset, resetErr := time.Parse(time.RFC3339Nano, i.ResetAt)\n   397\t\t\t\tif i.ResetAt != \"\" && resetErr == nil && reset.After(time.Now()) {\n   398\t\t\t\t\twait := delegateNextAction{Action: \"wait\", Command: \"pose delegate resume \" + a.AttemptID + \" --wait-until-reset\"}\n   399\t\t\t\t\tif _, err := posemodel.ReviewResumeDelay(latest, time.Now(), 24*time.Hour, 0); err != nil {\n   400\t\t\t\t\t\twait.Why = reason(err)\n   401\t\t\t\t\t} else {\n   402\t\t\t\t\t\twait.Available = true\n   403\t\t\t\t\t}\n   404\t\t\t\t\tactions = append(actions, wait)\n   405\t\t\t\t\tresume.Why = tr(\"the agent is limited until \", \"o agente está limitado até \") + i.ResetAt\n   406\t\t\t\t} else {\n   407\t\t\t\t\tresume.Available = true\n   408\t\t\t\t}\n   409\t\t\t}\n   410\t\t\tactions = append(actions, resume)\n   411\t\t}\n   412\t\thandoff := delegateNextAction{Action: \"handoff\", Command: \"pose delegate handoff \" + a.AttemptID + \" --to auto\"}\n   413\t\tif agent, _, err := routeTaskHandoff(store, latest); err != nil {\n   414\t\t\thandoff.Why = reason(err)\n   415\t\t} else if plan, err := store.PlanDelegationTaskHandoff(latest.RunID, agent); err != nil {\n   416\t\t\thandoff.Why = reason(err)\n   417\t\t} else if plan.Existing != nil {\n   418\t\t\thandoff.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n   419\t\t} else {\n   420\t\t\thandoff.Available = true\n   421\t\t}\n   422\t\treturn append(actions, handoff, delegateCancelAction())\n   423\t}\n   605\t\n   606\t// ReadDelegationTaskPrompt is the prompt run was given, checked against the\n   607\t// digest its record binds.\n   608\tfunc (s Store) ReadDelegationTaskPrompt(run ReviewRun) (string, error) {\n   609\t\tif run.eventsDir == \"\" || run.PromptDigest == \"\" {\n   610\t\t\treturn \"\", fmt.Errorf(\"pose: run %s keeps no prompt\", run.RunID)\n   611\t\t}\n   612\t\traw, err := readBoundedRegular(filepath.Join(run.eventsDir, run.RunID+\".prompt\"), delegationTaskPromptMaxBytes)\n   613\t\tif err != nil {\n   614\t\t\treturn \"\", err\n   615\t\t}\n   616\t\tif digestBytes(raw) != run.PromptDigest {\n   617\t\t\treturn \"\", fmt.Errorf(\"pose: the prompt of run %s is not the one its record binds\", run.RunID)\n   618\t\t}\n   619\t\treturn string(raw), nil\n   620\t}\n   621\t\n   622\t// RunDelegationTask runs plan in its directory and records the run; the\n   623\t// returned run is the record (R1, R5, R6).\n   624\tfunc (s Store) RunDelegationTask(parent context.Context, plan DelegationTaskPlan, now func() time.Time) (result ReviewRun, resultErr error) {\n   625\t\tif plan.Existing != nil {\n   626\t\t\treturn *plan.Existing, nil\n   627\t\t}\n   628\t\tif err := parent.Err(); err != nil {\n   629\t\t\treturn ReviewRun{}, err\n   630\t\t}\n   631\t\tparent, cancelRun := context.WithCancel(parent)\n   632\t\tdefer cancelRun()\n   633\t\tsafety, err := ResolveReviewerContainment(plan.adapter)\n   634\t\tif err != nil {\n   635\t\t\treturn ReviewRun{}, err\n   636\t\t}\n   637\t\tdir, err := s.taskRunsDir(plan.Record, true)\n   638\t\tif err != nil {\n   639\t\t\treturn ReviewRun{}, err\n   640\t\t}\n   641\t\trun := ReviewRun{SchemaVersion: 1, Scope: \"task\", Kind: DelegationPurposeTask, Purpose: DelegationPurposeTask, Adapter: plan.Agent, ResumesSession: plan.Session != \"\" && plan.predecessor == nil,\n   642\t\t\tVendor: plan.Config.Vendor, Model: plan.Config.Model, Label: plan.Label, Lead: plan.Lead, Access: plan.Access, Dir: plan.Dir,\n   643\t\t\tAddDirs: plan.AddDirs, NoNetwork: plan.NoNetwork, Recorded: plan.Record, Effort: plan.Effort, Events: plan.Config.Events, Routing: plan.Routing,\n   644\t\t\tStartedAt: now().UTC().Format(time.RFC3339Nano), ExitCode: -1, PromptDigest: digestBytes([]byte(plan.Prompt)), Safety: safety}\n   645\t\tif plan.predecessor == nil {\n   646\t\t\ttoken := make([]byte, 16)\n   647\t\t\tif _, err := rand.Read(token); err != nil {\n   648\t\t\t\treturn ReviewRun{}, err\n   649\t\t\t}\n   650\t\t\trun.AttemptID = \"tat-\" + hex.EncodeToString(token)","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"4c91480d-3c53-49af-9e0f-0dfd1a94d776","timestamp":"2026-11-27T22:06:45.060Z","tool_use_result":{"stdout":"    85\t\t\tif err != nil {\n    86\t\t\t\tif record != nil && f.jsonOut {\n    87\t\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": \"handoff\", \"error\": strings.TrimPrefix(err.Error(), \"pose: \"), \"routing\": record, \"reason_code\": posemodel.DelegationReasonCode(err)})\n    88\t\t\t\t\treturn 1\n    89\t\t\t\t}\n    90\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"handoff\", 1, err)\n    91\t\t\t}\n    92\t\t\tagent, route = chosen, record\n    93\t\t}\n    94\t\tplan, err := store.PlanReviewHandoff(target, agent)\n    95\t\tif err != nil {\n    96\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"handoff\", 1, err)\n    97\t\t}\n    98\t\tif plan.PendingContinuation != nil {\n    99\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"handoff\", 1, errors.New(tr(\"a continuation of \"+target+\" is pending (\"+plan.PendingContinuation.ID+\")\",\n   100\t\t\t\t\"uma continuação de \"+target+\" está pendente (\"+plan.PendingContinuation.ID+\")\")))\n   101\t\t}\n   102\t\tif route != nil {\n   103\t\t\tplan.Routing = route\n   104\t\t}\n   105\t\tplan.Purpose = attempt.Purpose\n   106\t\tfor _, warning := range plan.Warnings {\n   107\t\t\trender(stdout, stderr).Hint(\"pose delegate handoff: \" + warning)\n   108\t\t}\n   109\t\tif f.dryRun {\n   110\t\t\textra := map[string]any{\"hands_off_from\": target, \"attempt\": attempt.AttemptID, \"label\": attempt.Label, \"routing\": plan.Routing}\n   111\t\t\tif plan.Existing != nil {\n   112\t\t\t\textra[\"recorded_continuation\"] = plan.Existing.RunID\n   113\t\t\t}\n   114\t\t\targv := redactArgv(posemodel.ReviewerArgv(plan.Config.Command, \"{output}\", \"\", plan.Effort, plan.Config.Effort), plan.Config)\n   115\t\t\treturn delegatePrintPlan(stdout, stderr, f.jsonOut, plan, argv, extra)\n   116\t\t}\n   117\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n   118\t\tdefer stop()\n   119\t\tif delegateSupervised() {\n   120\t\t\tplan.OnStart = supervisorHandback()\n   121\t\t}\n   122\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n   123\t\thandBackExisting(run, err)\n   124\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n   125\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"handoff\")\n   126\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"handoff\", run, err, delegateRunNextActions(store, run, err)...)\n   127\t\tif err == nil && !f.jsonOut {\n   128\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n   129\t\t\t\treturn next\n   130\t\t\t}\n   131\t\t}\n   132\t\treturn code\n   133\t}\n   134\t\n   135\t// routeHandoff routes a handoff among the agents of the stopped run's purpose,\n   136\t// the stopped agent excluded (R7).\n   137\tfunc routeHandoff(store posemodel.Store, prior posemodel.ReviewRun) (string, *posemodel.DelegationRoutingRecord, error) {\n   138\t\treaders, found, err := store.LoadReviewersPolicyFor(prior.Kind)\n   139\t\tif err != nil {\n   140\t\t\treturn \"\", nil, err\n   141\t\t}\n   142\t\tif !found {\n   143\t\t\treturn \"\", nil, posemodel.ErrNoReviewerAdapter\n   144\t\t}\n   145\t\tpolicy, _, _, err := store.LoadDelegationPolicy()\n   146\t\tif err != nil {\n   147\t\t\treturn \"\", nil, err\n   148\t\t}\n   149\t\tbundle, err := store.LoadReviewBundle(prior.BundleID)\n   150\t\tif err != nil {\n   151\t\t\treturn \"\", nil, err\n   152\t\t}\n   153\t\timpl, from, err := store.RoutingImplementation(bundle, policy, prior.Lead)\n   154\t\tif err != nil {\n   155\t\t\treturn \"\", nil, err\n   156\t\t}\n   157\t\teligible := []string{}\n   158\t\tfor name := range readers.Adapters {\n   159\t\t\tif name != prior.Adapter {\n   160\t\t\t\teligible = append(eligible, name)\n   161\t\t\t}\n   162\t\t}\n   163\t\tavail := store.DelegationAvailabilityOf(policy, time.Now(), true)\n   164\t\tagent, record, err := posemodel.RouteDelegation(policy, eligible, impl, from, avail, time.Now())\n   165\t\tif err != nil {\n   166\t\t\treturn \"\", &record, err\n   167\t\t}\n   168\t\tif record.Step == posemodel.DelegationStepWait {\n   169\t\t\treturn \"\", &record, errors.New(tr(\"every other agent is limited until \"+record.WaitUntil+\"; hand off after the reset, or wait for this run's reset and resume it\",\n   170\t\t\t\t\"todos os outros agentes estão limitados até \"+record.WaitUntil+\"; faça o handoff depois do reset, ou espere o reset deste run e o retome\"))\n   171\t\t}\n   172\t\treturn agent, &record, nil\n   173\t}\n   174\t\n   175\t// delegateNextAction is one way forward for a stopped run (R9).\n   176\ttype delegateNextAction struct {\n   177\t\tAction    string `json:\"action\"`\n   178\t\tCommand   string `json:\"command,omitempty\"`\n   179\t\tAvailable bool   `json:\"available\"`\n   180\t\tWhy       string `json:\"why,omitempty\"`\n   181\t}\n   182\t\n   183\t// delegateCancelAction leaves the attempt stopped: it has no command because\n   184\t// nothing runs to stop, nothing is spent, and a later command can still\n   185\t// continue the run (R8, R9).\n   186\tfunc delegateCancelAction() delegateNextAction {\n   187\t\treturn delegateNextAction{Action: \"cancel\", Available: true, Why: tr(\"leave the run stopped; nothing runs and the attempt's budget is kept\", \"deixar o run parado; nada roda e o orçamento da tentativa é mantido\")}\n   188\t}\n   189\t\n   190\t// delegateNextActions lists what a stopped attempt can do next, each judged by\n   191\t// the same read-only planning its command runs, so an action offered as\n   192\t// available is one its command would start (R9); nil for an attempt that runs\n   193\t// or concluded.\n   194\tfunc delegateNextActions(store posemodel.Store, a posemodel.DelegationAttempt) []delegateNextAction {\n   195\t\tlatest := a.Latest()\n   196\t\tif a.Active || latest == nil || latest.Status == posemodel.ReviewRunCompleted || latest.Status == posemodel.ReviewRunStale {\n   197\t\t\treturn nil\n   198\t\t}\n   199\t\tif latest.Purpose == posemodel.DelegationPurposeTask {\n   200\t\t\treturn delegateTaskNextActions(store, a, *latest)\n   201\t\t}\n   202\t\treason := func(err error) string { return strings.TrimPrefix(err.Error(), \"pose: \") }\n   203\t\tvar actions []delegateNextAction\n   204\t\tif i := latest.Interruption; latest.Status == posemodel.ReviewRunInterrupted && i != nil {\n   205\t\t\tresume := delegateNextAction{Action: \"resume\", Command: \"pose delegate resume \" + a.AttemptID}\n   206\t\t\tplan, err := store.PlanReviewResume(latest.RunID)\n   207\t\t\tswitch {\n   208\t\t\tcase !i.Resumable:\n   209\t\t\t\tresume.Why = tr(\"the stop is not resumable\", \"a parada não é retomável\")\n   210\t\t\tcase err != nil:\n   211\t\t\t\tresume.Why = reason(err)\n   212\t\t\tcase plan.PendingContinuation != nil || plan.Existing != nil:\n   213\t\t\t\tresume.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n   214\t\t\t}\n   215\t\t\tif resume.Why == \"\" {\n   216\t\t\t\treset, resetErr := time.Parse(time.RFC3339Nano, i.ResetAt)\n   217\t\t\t\tif i.ResetAt != \"\" && resetErr == nil && reset.After(time.Now()) {\n   218\t\t\t\t\twait := delegateNextAction{Action: \"wait\", Command: \"pose delegate resume \" + a.AttemptID + \" --wait-until-reset\"}\n   219\t\t\t\t\tif _, err := posemodel.ReviewResumeDelay(*latest, time.Now(), 24*time.Hour, 0); err != nil {\n   220\t\t\t\t\t\twait.Why = reason(err)\n   221\t\t\t\t\t} else {\n   222\t\t\t\t\t\twait.Available = true\n   223\t\t\t\t\t}\n   224\t\t\t\t\tactions = append(actions, wait)\n   225\t\t\t\t\tresume.Why = tr(\"the agent is limited until \", \"o agente está limitado até \") + i.ResetAt\n   226\t\t\t\t} else {\n   227\t\t\t\t\tresume.Available = true\n   228\t\t\t\t}\n   229\t\t\t}\n   230\t\t\tactions = append(actions, resume)\n   231\t\t}\n   232\t\thandoff := delegateNextAction{Action: \"handoff\", Command: \"pose delegate handoff \" + a.AttemptID + \" --to auto\"}\n   233\t\tif agent, _, err := routeHandoff(store, *latest); err != nil {\n   234\t\t\thandoff.Why = reason(err)\n   235\t\t} else if plan, err := store.PlanReviewHandoff(latest.RunID, agent); err != nil {\n   236\t\t\thandoff.Why = reason(err)\n   237\t\t} else if plan.PendingContinuation != nil || plan.Existing != nil {\n   238\t\t\thandoff.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n   239\t\t} else {\n   240\t\t\thandoff.Available = true\n   241\t\t}\n   242\t\treturn append(actions, handoff, delegateCancelAction())\n   243\t}\n   244\t\n   245\t// delegateRunNextActions is the ways forward of the attempt run belongs to,\n   246\t// for a run that just stopped (R9).\n   247\tfunc delegateRunNextActions(store posemodel.Store, run posemodel.ReviewRun, err error) []delegateNextAction {\n   248\t\tif err != nil || run.AttemptID == \"\" || run.Status == posemodel.ReviewRunCompleted {\n   249\t\t\treturn nil\n   250\t\t}\n   251\t\tattempts, _, lerr := store.ListDelegationAttempts()\n   252\t\tif lerr != nil {\n   253\t\t\treturn nil\n   254\t\t}\n   255\t\tfor _, a := range attempts {\n   256\t\t\tif a.AttemptID == run.AttemptID {\n   257\t\t\t\treturn delegateNextActions(store, a)\n   258\t\t\t}\n   259\t\t}\n   260\t\treturn nil\n   270\t\t\t\t}\n   271\t\t\t}\n   272\t\t}\n   273\t\tif err != nil {\n   274\t\t\tout.Failure(\"pose delegate \" + command + \": \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   275\t\t}\n   276\t\treturn code\n   277\t}\n   278\t\n   279\t// cmdDelegateTaskResume continues a stopped task with its own agent and\n   280\t// session; without --prompt it sends the default continuation message (R8).\n   281\tfunc cmdDelegateTaskResume(root string, store posemodel.Store, f delegateFlags, attempt posemodel.DelegationAttempt, target string, stdout, stderr io.Writer) int {\n   282\t\tprompt := \"\"\n   283\t\tif f.promptFile != \"\" {\n   284\t\t\tvar err error\n   285\t\t\tif prompt, err = readDelegatePrompt(f.promptFile); err != nil {\n   286\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 2, err)\n   287\t\t\t}\n   288\t\t}\n   289\t\tplan, err := store.PlanDelegationTaskResume(target, prompt)\n   290\t\tif err != nil {\n   291\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"resume\", err, nil)\n   292\t\t}\n   293\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n   294\t\tdefer stop()\n   295\t\tif f.wait && plan.Existing == nil && !f.dryRun {\n   296\t\t\tlatest := attempt.Latest()\n   297\t\t\tvar seed [1]byte\n   298\t\t\t_, _ = rand.Read(seed[:])\n   299\t\t\tdelay, err := posemodel.ReviewResumeDelay(*latest, time.Now(), f.waitMax, time.Duration(seed[0])*time.Second/255)\n   300\t\t\tif err != nil {\n   301\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n   302\t\t\t}\n   303\t\t\tif delay > 0 {\n   304\t\t\t\trender(io.Discard, stderr).Hint(\"pose delegate resume: \" + tr(\"waiting \", \"esperando \") + delay.String())\n   305\t\t\t\tselect {\n   306\t\t\t\tcase <-ctx.Done():\n   307\t\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, ctx.Err())\n   308\t\t\t\tcase <-time.After(delay):\n   309\t\t\t\t}\n   310\t\t\t\tif plan, err = store.PlanDelegationTaskResume(target, prompt); err != nil {\n   311\t\t\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"resume\", err, nil)\n   312\t\t\t\t}\n   313\t\t\t}\n   314\t\t}\n   315\t\tif plan.Existing != nil {\n   316\t\t\thandBackAttempt(plan.Existing.AttemptID)\n   317\t\t\treturn delegatePrintTask(stdout, stderr, f.jsonOut, \"resume\", *plan.Existing, nil)\n   318\t\t}\n   319\t\treturn runDelegateTask(root, store, ctx, plan, f, \"resume\", map[string]any{\"resumes\": target, \"attempt\": attempt.AttemptID}, stdout, stderr)\n   320\t}\n   321\t\n   322\t// cmdDelegateTaskHandoff continues a stopped task with another agent, its\n   323\t// prompt the stopped run's followed by the handoff section.\n   324\tfunc cmdDelegateTaskHandoff(root string, store posemodel.Store, f delegateFlags, attempt posemodel.DelegationAttempt, latest posemodel.ReviewRun, target string, stdout, stderr io.Writer) int {\n   325\t\tagent := f.to\n   326\t\truns, _ := store.ReadDelegationTaskRuns()\n   327\t\tfor _, r := range runs {\n   328\t\t\tif r.HandsOffFrom != target {\n   329\t\t\t\tcontinue\n   330\t\t\t}\n   331\t\t\tif agent != \"auto\" && agent != r.Adapter {\n   332\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"handoff\", 1, fmt.Errorf(tr(\"run %s was already handed off to %s by run %s\", \"o run %s já foi repassado para %s pelo run %s\"), target, r.Adapter, r.RunID))\n   333\t\t\t}\n   334\t\t\tagent = r.Adapter\n   335\t\t}\n   336\t\tvar route *posemodel.DelegationRoutingRecord\n   337\t\tif agent == \"auto\" {\n   338\t\t\tchosen, record, err := routeTaskHandoff(store, latest)\n   339\t\t\tif err != nil {\n   340\t\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"handoff\", err, record)\n   341\t\t\t}\n   342\t\t\tagent, route = chosen, record\n   343\t\t}\n   344\t\tplan, err := store.PlanDelegationTaskHandoff(target, agent)\n   345\t\tif err != nil {\n   346\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"handoff\", err, nil)\n   347\t\t}\n   348\t\tif plan.Existing != nil {\n   349\t\t\thandBackAttempt(plan.Existing.AttemptID)\n   350\t\t\treturn delegatePrintTask(stdout, stderr, f.jsonOut, \"handoff\", *plan.Existing, nil)\n   351\t\t}\n   352\t\tplan.Routing = route\n   353\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n   354\t\tdefer stop()\n   355\t\treturn runDelegateTask(root, store, ctx, plan, f, \"handoff\", map[string]any{\"hands_off_from\": target, \"attempt\": attempt.AttemptID}, stdout, stderr)\n   356\t}\n   357\t\n   358\t// routeTaskHandoff routes the handoff of a task among the agents with a\n   359\t// command for its access, the stopped agent excluded; it never waits.\n   360\tfunc routeTaskHandoff(store posemodel.Store, prior posemodel.ReviewRun) (string, *posemodel.DelegationRoutingRecord, error) {\n   361\t\tpolicy, _, found, err := store.LoadDelegationPolicy()\n   362\t\tif err != nil {\n   363\t\t\treturn \"\", nil, err\n   364\t\t}\n   365\t\tif !found {\n   366\t\t\treturn \"\", nil, posemodel.ErrNoReviewerAdapter\n   367\t\t}\n   368\t\tagent, record, err := routeTask(store, policy, prior.Access, \"auto\", prior.Lead, prior.Adapter)\n   369\t\tif err != nil {\n   370\t\t\treturn \"\", record, err\n   371\t\t}\n   372\t\tif record.Step == posemodel.DelegationStepWait {\n   373\t\t\treturn \"\", record, errors.New(tr(\"every other agent is limited until \"+record.WaitUntil+\"; hand off after the reset, or wait for this run's reset and resume it\",\n   374\t\t\t\t\"todos os outros agentes estão limitados até \"+record.WaitUntil+\"; faça o handoff depois do reset, ou espere o reset deste run e o retome\"))\n   375\t\t}\n   376\t\treturn agent, record, nil\n   377\t}\n   378\t\n   379\t// delegateTaskNextActions are the ways forward of a stopped task, judged by\n   380\t// the planning their commands run (R9).\n   381\tfunc delegateTaskNextActions(store posemodel.Store, a posemodel.DelegationAttempt, latest posemodel.ReviewRun) []delegateNextAction {\n   382\t\treason := func(err error) string { return strings.TrimPrefix(err.Error(), \"pose: \") }\n   383\t\tvar actions []delegateNextAction\n   384\t\tif i := latest.Interruption; latest.Status == posemodel.ReviewRunInterrupted && i != nil {\n   385\t\t\tresume := delegateNextAction{Action: \"resume\", Command: \"pose delegate resume \" + a.AttemptID}\n   386\t\t\tplan, err := store.PlanDelegationTaskResume(latest.RunID, \"\")\n   387\t\t\tswitch {\n   388\t\t\tcase !i.Resumable:\n   389\t\t\t\tresume.Why = tr(\"the stop is not resumable\", \"a parada não é retomável\")\n   390\t\t\tcase err != nil:\n   391\t\t\t\tresume.Why = reason(err)\n   392\t\t\tcase plan.Existing != nil:\n   393\t\t\t\tresume.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n   394\t\t\t}\n   395\t\t\tif resume.Why == \"\" {\n   396\t\t\t\treset, resetErr := time.Parse(time.RFC3339Nano, i.ResetAt)\n   397\t\t\t\tif i.ResetAt != \"\" && resetErr == nil && reset.After(time.Now()) {\n   398\t\t\t\t\twait := delegateNextAction{Action: \"wait\", Command: \"pose delegate resume \" + a.AttemptID + \" --wait-until-reset\"}\n   399\t\t\t\t\tif _, err := posemodel.ReviewResumeDelay(latest, time.Now(), 24*time.Hour, 0); err != nil {\n   400\t\t\t\t\t\twait.Why = reason(err)\n   401\t\t\t\t\t} else {\n   402\t\t\t\t\t\twait.Available = true\n   403\t\t\t\t\t}\n   404\t\t\t\t\tactions = append(actions, wait)\n   405\t\t\t\t\tresume.Why = tr(\"the agent is limited until \", \"o agente está limitado até \") + i.ResetAt\n   406\t\t\t\t} else {\n   407\t\t\t\t\tresume.Available = true\n   408\t\t\t\t}\n   409\t\t\t}\n   410\t\t\tactions = append(actions, resume)\n   411\t\t}\n   412\t\thandoff := delegateNextAction{Action: \"handoff\", Command: \"pose delegate handoff \" + a.AttemptID + \" --to auto\"}\n   413\t\tif agent, _, err := routeTaskHandoff(store, latest); err != nil {\n   414\t\t\thandoff.Why = reason(err)\n   415\t\t} else if plan, err := store.PlanDelegationTaskHandoff(latest.RunID, agent); err != nil {\n   416\t\t\thandoff.Why = reason(err)\n   417\t\t} else if plan.Existing != nil {\n   418\t\t\thandoff.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n   419\t\t} else {\n   420\t\t\thandoff.Available = true\n   421\t\t}\n   422\t\treturn append(actions, handoff, delegateCancelAction())\n   423\t}\n   605\t\n   606\t// ReadDelegationTaskPrompt is the prompt run was given, checked against the\n   607\t// digest its record binds.\n   608\tfunc (s Store) ReadDelegationTaskPrompt(run ReviewRun) (string, error) {\n   609\t\tif run.eventsDir == \"\" || run.PromptDigest == \"\" {\n   610\t\t\treturn \"\", fmt.Errorf(\"pose: run %s keeps no prompt\", run.RunID)\n   611\t\t}\n   612\t\traw, err := readBoundedRegular(filepath.Join(run.eventsDir, run.RunID+\".prompt\"), delegationTaskPromptMaxBytes)\n   613\t\tif err != nil {\n   614\t\t\treturn \"\", err\n   615\t\t}\n   616\t\tif digestBytes(raw) != run.PromptDigest {\n   617\t\t\treturn \"\", fmt.Errorf(\"pose: the prompt of run %s is not the one its record binds\", run.RunID)\n   618\t\t}\n   619\t\treturn string(raw), nil\n   620\t}\n   621\t\n   622\t// RunDelegationTask runs plan in its directory and records the run; the\n   623\t// returned run is the record (R1, R5, R6).\n   624\tfunc (s Store) RunDelegationTask(parent context.Context, plan DelegationTaskPlan, now func() time.Time) (result ReviewRun, resultErr error) {\n   625\t\tif plan.Existing != nil {\n   626\t\t\treturn *plan.Existing, nil\n   627\t\t}\n   628\t\tif err := parent.Err(); err != nil {\n   629\t\t\treturn ReviewRun{}, err\n   630\t\t}\n   631\t\tparent, cancelRun := context.WithCancel(parent)\n   632\t\tdefer cancelRun()\n   633\t\tsafety, err := ResolveReviewerContainment(plan.adapter)\n   634\t\tif err != nil {\n   635\t\t\treturn ReviewRun{}, err\n   636\t\t}\n   637\t\tdir, err := s.taskRunsDir(plan.Record, true)\n   638\t\tif err != nil {\n   639\t\t\treturn ReviewRun{}, err\n   640\t\t}\n   641\t\trun := ReviewRun{SchemaVersion: 1, Scope: \"task\", Kind: DelegationPurposeTask, Purpose: DelegationPurposeTask, Adapter: plan.Agent, ResumesSession: plan.Session != \"\" && plan.predecessor == nil,\n   642\t\t\tVendor: plan.Config.Vendor, Model: plan.Config.Model, Label: plan.Label, Lead: plan.Lead, Access: plan.Access, Dir: plan.Dir,\n   643\t\t\tAddDirs: plan.AddDirs, NoNetwork: plan.NoNetwork, Recorded: plan.Record, Effort: plan.Effort, Events: plan.Config.Events, Routing: plan.Routing,\n   644\t\t\tStartedAt: now().UTC().Format(time.RFC3339Nano), ExitCode: -1, PromptDigest: digestBytes([]byte(plan.Prompt)), Safety: safety}\n   645\t\tif plan.predecessor == nil {\n   646\t\t\ttoken := make([]byte, 16)\n   647\t\t\tif _, err := rand.Read(token); err != nil {\n   648\t\t\t\treturn ReviewRun{}, err\n   649\t\t\t}\n   650\t\t\trun.AttemptID = \"tat-\" + hex.EncodeToString(token)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Vo9aiz7hrTBE7GpBRr6M5Q","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
