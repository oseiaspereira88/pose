t[key(in.Kind, in.Path)] = in.Digest\n  1975\t\t\t}\n  1976\t\t\tfor _, in := range b.Payload.ConsumedInputs {\n  1977\t\t\t\tswitch in.Kind {\n  1978\t\t\t\tcase \"governed-config\", \"review-profile\", \"rule\":\n  1979\t\t\t\t\tout[key(in.Kind, in.Path)] = in.Digest\n  1980\t\t\t\t}\n  1981\t\t\t}\n  1982\t\t\treturn out\n  1983\t\t}\n  1984\t\twant, got := collect(sealed), collect(other)\n  1985\t\tvar differing []string\n  1986\t\tfor k, digest := range want {\n  1987\t\t\tif got[k] != digest {\n  1988\t\t\t\tdiffering = append(differing, k)\n  1989\t\t\t}\n  1990\t\t}\n  1991\t\t// The implementation the bundle sealed: each file of its subject, as the checkout holds it.\n  1992\t\tfor _, entry := range sealed.Payload.Subject.Entries {\n  1993\t\t\tif entry.Digest == \"\" || entry.Action == \"removed\" || entry.Class == \"submodule\" {\n  1994\t\t\t\tcontinue\n  1995\t\t\t}\n  1996\t\t\trel := reviewBundleEntryPath(entry)\n  1997\t\t\tif strings.HasPrefix(filepath.ToSlash(rel), pendingFragmentDir) {\n  1998\t\t\t\tcontinue // archived since: the ledger, not the path, holds it\n  1999\t\t\t}\n  2000\t\t\traw, err := os.ReadFile(filepath.Join(checkout, filepath.FromSlash(rel)))\n  2001\t\t\tif err != nil || digestBytes(bytes.ReplaceAll(raw, []byte(\"\\r\\n\"), []byte(\"\\n\"))) != entry.Digest {\n  2002\t\t\t\tdiffering = append(differing, \"subject \"+rel)\n  2003\t\t\t}\n  2004\t\t}\n  2005\t\tsort.Strings(differing)\n  2006\t\treturn differing\n  2007\t}\n  2008\t\n  2009\t// checkoutBlockers are the blockers of the sealed checkout that hold there. Two kinds do not,\n  2010\t// because they concern evidence that is not part of the sealed subject and that a checkout of\n  2011\t// the sealed commit cannot hold: the delivery integrity index (derived, not checked out) and the\n  2012\t// sealed review bundles of the children of a roadmap or milestone. The children are reviewed and\n  2013\t// committed before the roadmap bundle is sealed, but the subject's head is the last commit that\n  2014\t// changed a subject path, which is older than their records; the bundle sealed at the real head\n  2015\t// already judged them, and closing the scope judges them again (spec\n  2016\t// pose-sealed-checkout-does-not-require-later-child-evidence).\n  2017\tfunc checkoutBlockers(blockers []string) []string {\n  2018\t\tvar out []string\n  2019\t\tfor _, blocker := range blockers {\n  2020\t\t\tif strings.Contains(blocker, \"delivery integrity is unavailable\") || isChildReviewEvidenceBlocker(blocker) {\n  2021\t\t\t\tcontinue\n  2022\t\t\t}\n  2023\t\t\tout = append(out, blocker)\n  2024\t\t}\n  2025\t\treturn out\n  2026\t}\n  2027\t\n  2028\t// isChildReviewEvidenceBlocker recognises \"child <scope> has no sealed review bundle[: why]\".\n  2029\tfunc isChildReviewEvidenceBlocker(blocker string) bool {\n  2030\t\treturn strings.HasPrefix(blocker, \"child \") && strings.Contains(blocker, \" has no sealed review bundle\")\n  2031\t}\n  2032\t\n  2033\tfunc sourceMaterializationDiffers(root, commit string, entries []ReviewBundleSubjectEntry) string {\n  2034\t\tif commit == \"\" || !hasGitMetadata(root) {\n  2035\t\t\t// No sealed commit, or no repository at all: nothing to compare with (a dispatch has both).\n  2036\t\t\treturn \"\"\n  2037\t\t}\n  2038\t\tcheckedDirs := map[string]bool{}\n  2039\t\tfor _, entry := range entries {\n  2040\t\t\tif entry.Class == \"submodule\" {\n  2041\t\t\t\tcontinue\n  2042\t\t\t}\n  2043\t\t\t// The absence the bundle sealed is part of what it reviewed: a removed path, and the old\n  2044\t\t\t// side of a rename, must still be absent, whatever Git was told to ignore.\n  2045\t\t\tfor _, gone := range removedSides(entry) {\n  2046\t\t\t\tif _, err := os.Lstat(filepath.Join(root, filepath.FromSlash(gone))); err == nil {\n  2047\t\t\t\t\treturn gone + \" (the bundle sealed it as removed, and it is there)\"\n  2048\t\t\t\t}\n  2049\t\t\t}\n  2050\t\t\tif entry.Action == \"removed\" {\n  2051\t\t\t\tcontinue\n  2052\t\t\t}\n  2053\t\t\trel := reviewBundleEntryPath(entry)\n  2054\t\t\tif linkAbove(root, rel, checkedDirs) {\n  2055\t\t\t\treturn rel + \" (a directory above it is a link, or not a directory)\"\n  2056\t\t\t}\n  2057\t\t\tout, err := gitCommand(\"-C\", root, \"ls-tree\", \"-z\", commit, \"--\", rel).Output()\n  2058\t\t\tif err != nil {\n  2059\t\t\t\treturn rel + \" (its record in the sealed commit could not be read: \" + err.Error() + \")\"\n  2060\t\t\t}\n  2061\t\t\tmeta, _, ok := strings.Cut(strings.TrimSuffix(string(out), \"\\x00\"), \"\\t\")\n  2062\t\t\tfields := strings.Fields(meta)\n  2063\t\t\tif !ok || len(fields) < 3 {\n  2064\t\t\t\tcontinue // not in the sealed commit\n  2065\t\t\t}\n  2066\t\t\tmode, object := fields[0], fields[2]\n  2067\t\t\tinfo, lerr := os.Lstat(filepath.Join(root, filepath.FromSlash(rel)))\n  2068\t\t\tif lerr != nil {\n  2069\t\t\t\treturn rel + \" (it cannot be inspected: \" + lerr.Error() + \")\"\n  2070\t\t\t}\n  2071\t\t\tswitch mode {\n  2072\t\t\tcase \"120000\":\n  2073\t\t\t\ttarget, rerr := os.Readlink(filepath.Join(root, filepath.FromSlash(rel)))\n  2074\t\t\t\tif info.Mode()&os.ModeSymlink == 0 || rerr != nil || gitBlobID(\"sha1\", []byte(target)) != object && gitBlobID(\"sha256\", []byte(target)) != object {\n  2075\t\t\t\t\treturn rel + \" (it is not the link the sealed commit records)\"\n  2076\t\t\t\t}\n  2077\t\t\tdefault:\n  2078\t\t\t\tif !info.Mode().IsRegular() {\n  2079\t\t\t\t\treturn rel + \" (it is not a regular file, and the sealed commit records one)\"\n  2080\t\t\t\t}\n  2081\t\t\t\tif runtime.GOOS != \"windows\" && (info.Mode().Perm()&0o111 != 0) != (mode == \"100755\") {\n  2082\t\t\t\t\treturn rel + \" (its executable bit differs)\"\n  2083\t\t\t\t}\n  2084\t\t\t}\n  2085\t\t}\n  2086\t\treturn \"\"\n  2087\t}\n  2088\t\n  2089\t// reviewRunRuntimeHex is how many hex digits of the attempt id name its\n  2090\t// runtime directory: no more than the longest random suffix of\n  2091\t// os.MkdirTemp, a uint32 in decimal (ten digits).\n  2092\tconst reviewRunRuntimeHex = 10\n  2093\t\n  2094\t// reviewRuntimeNameRE is the form of a runtime directory name a run records\n  2095\t// in safety.runtime_id: the stable one, or the random one earlier engines\n  2096\t// and runs without an attempt used.\n  2097\tvar reviewRuntimeNameRE = regexp.MustCompile(`^pose-review-run-[0-9A-Za-z]{1,40}$`)\n  2098\t\n  2099\t// runtimeSourceOf is what names the runtime directory of a continuation of\n  2100\t// prior: the name prior recorded, so the session finds the checkout where it\n  2101\t// saw it, also when an earlier engine named it at random (spec\n  2102\t// pose-review-resume-runtime-dir-followups R2); otherwise prior's attempt.\n  2103\tfunc runtimeSourceOf(prior ReviewRun) string {\n  2104\t\tif prior.Safety != nil && reviewRuntimeNameRE.MatchString(prior.Safety.RuntimeID) {\n  2105\t\t\treturn prior.Safety.RuntimeID\n  2106\t\t}\n  2107\t\treturn prior.AttemptID\n  2108\t}\n  2109\t\n  2110\t// runtimeSourceFor is what names the runtime directory of a run of plan: the\n  2111\t// predecessor's, for a continuation; the previous round's run, for a round\n  2112\t// that continues its thread, whose session saw that checkout; the attempt\n  2113\t// otherwise. The second value says why a continued round could not take the\n  2114\t// previous round's name (spec pose-review-resume-residuals R2).\n  2115\tfunc (s Store) runtimeSourceFor(plan DispatchPlan, attemptID string) (string, string) {\n  2116\t\tif plan.predecessor != nil {\n  2117\t\t\treturn runtimeSourceOf(*plan.predecessor), \"\"\n  2118\t\t}\n  2119\t\tif !plan.thread.continued() {\n  2120\t\t\treturn attemptID, \"\"\n  2121\t\t}\n  2122\t\truns, lost, err := s.ReadReviewRuns(\"\")\n  2123\t\tsource := runtimeSourceAmong(plan, attemptID, runs)\n  2124\t\tswitch {\n  2125\t\tcase err != nil:\n  2126\t\t\treturn source, \"the run ledger could not be read: \" + err.Error()\n  2127\t\tcase source == attemptID && len(lost) > 0:\n  2128\t\t\treturn source, fmt.Sprintf(\"the previous round's run %s is not readable in the ledger\", plan.thread.From)\n  2129\t\tcase source == attemptID:\n  2130\t\t\treturn source, \"the previous round's run \" + plan.thread.From + \" was not found in the ledger\"\n  2131\t\t}\n  2132\t\treturn source, \"\"\n  2133\t}\n  2134\t\n  2135\t// runtimeSourceAmong is runtimeSourceFor over the recorded runs given.\n  2136\tfunc runtimeSourceAmong(plan DispatchPlan, attemptID string, runs []ReviewRun) string {\n  2137\t\tif plan.predecessor != nil {\n  2138\t\t\treturn runtimeSourceOf(*plan.predecessor)\n  2139\t\t}\n  2140\t\tif plan.thread.continued() && plan.thread.From != \"\" {\n  2141\t\t\tfor _, r := range runs {\n  2142\t\t\t\tif r.RunID == plan.thread.From {\n  2143\t\t\t\t\treturn runtimeSourceOf(r)\n  2144\t\t\t\t}\n  2145\t\t\t}\n  2146\t\t}\n  2147\t\treturn attemptID\n  2148\t}\n  2149\t\n  2150\t// reviewAttemptIDRE is the form of a delegated review attempt's id.\n  2151\tvar reviewAttemptIDRE = regexp.MustCompile(`^rat-[0-9a-f]{64}$`)\n  2152\t\n  2153\t// reviewRunRuntimeDir creates the private directory of one run. Every run of\n  2154\t// an attempt uses the same path, so a resumed reviewer session, which still\n  2155\t// refers to the sealed checkout it worked in, finds the checkout recreated\n  2156\t// there after the interrupted run removed it (spec\n  2157\t// pose-review-resume-keeps-the-sealed-checkout R1). The directory is created\n  2158\t// exclusively and never followed: when the path already exists, from an\n  2159\t// unfinished cleanup or from someone else, the run fails instead of sharing\n  2160\t// it. A run without an attempt keeps a random name.\n  2161\tfunc reviewRunRuntimeDir(attemptID string) (string, error) {\n  2162\t\tdir, ok := reviewRunRuntimeDirPath(attemptID)\n  2163\t\tif !ok {\n  2164\t\t\treturn os.MkdirTemp(\"\", \"pose-review-run-*\")\n  2165\t\t}\n  2166\t\tif err := os.Mkdir(dir, 0o700); err != nil {\n  2167\t\t\tif errors.Is(err, fs.ErrExist) {\n  2168\t\t\t\treturn \"\", fmt.Errorf(\"the attempt's runtime directory %s already exists; an earlier run of the attempt did not clean up, or another process holds the path; when no run of the attempt is live, remove it, then run again: %w\", dir, fs.ErrExist)\n  2169\t\t\t}\n  2170\t\t\treturn \"\", err\n  2171\t\t}\n  2172\t\treturn dir, nil\n  2173\t}\n  2174\t\n  2175\t// reviewRunRuntimeDirPath is the runtime directory every run of an attempt\n  2176\t// uses, or false for a run without an attempt.\n  2177\tfunc reviewRunRuntimeDirPath(attemptID string) (string, bool) {\n  2178\t\t// A runtime name a run recorded is used as it is (spec\n  2179\t\t// pose-review-resume-runtime-dir-followups R2, R3).\n  2180\t\tif reviewRuntimeNameRE.MatchString(attemptID) {\n  2181\t\t\treturn filepath.Join(os.TempDir(), attemptID), true\n  2182\t\t}\n  2183\t\tif !reviewAttemptIDRE.MatchString(attemptID) {\n  2184\t\t\treturn \"\", false\n  2185\t\t}\n  2186\t\t// The name is no longer than the longest random one it replaces: the adapter's\n  2187\t\t// TMPDIR is this directory, and a sandboxed reviewer creates Unix\n  2188\t\t// sockets under it, whose paths are bounded (about 108 bytes); the\n  2189\t\t// 32-hex name made the Claude sandbox fail to start (review rounds 1\n  2190\t\t// to 3). Ten hex digits name the attempt; a clash with another attempt\n  2191\t\t// only fails the later run, as the directory is created exclusively.\n  2192\t\treturn filepath.Join(os.TempDir(), \"pose-review-run-\"+attemptID[len(\"rat-\"):len(\"rat-\")+reviewRunRuntimeHex]), true\n  2193\t}\n  2194\t\n  2195\t// reviewRunRuntimeDirFree refuses a continuation whose runtime directory is\n  2196\t// still there, before the continuation is claimed, so removing the\n  2197\t// directory restores the resume instead of losing it to a failed run\n  2198\t// (review round 1, N1).\n  2199\tfunc reviewRunRuntimeDirFree(attemptID, verb string) error {\n  2200\t\tdir, ok := reviewRunRuntimeDirPath(attemptID)\n  2201\t\tif !ok {\n  2202\t\t\treturn nil\n  2203\t\t}\n  2204\t\tif _, err := os.Lstat(dir); err == nil {\n  2205\t\t\treturn fmt.Errorf(\"the attempt's runtime directory %s still exists although its last run cleaned up; another process holds the path, or a run of the attempt is starting; when none is live, remove it, then %s again\", dir, verb)\n  2206\t\t} else if !errors.Is(err, fs.ErrNotExist) {\n  2207\t\t\treturn fmt.Errorf(\"the attempt's runtime directory %s cannot be checked: %w\", dir, err)\n  2208\t\t}\n  2209\t\treturn nil\n  2210\t}\n  2211\t\n  2212\t// takeContinuationRuntimeDir creates the attempt's runtime directory for a\n  2213\t// continuation before its claim. When the directory is there, a claim that\n  2214\t// appears meanwhile means another resume holds it: the continuation is\n  2215\t// pending. Otherwise the directory belongs to no run of the attempt, and the\n  2216\t// resume is refused with nothing claimed.\n  2217\tfunc (s Store) takeContinuationRuntimeDir(ctx context.Context, plan DispatchPlan) (string, error) {\n  2218\t\tsource := runtimeSourceOf(*plan.predecessor)\n  2219\t\tif _, ok := reviewRunRuntimeDirPath(source); !ok {\n  2220\t\t\treturn \"\", nil\n  2221\t\t}\n  2222\t\tdir, err := reviewRunRuntimeDir(source)\n  2223\t\tif err == nil {\n  2224\t\t\treturn dir, nil\n  2225\t\t}\n  2226\t\tif !errors.Is(err, fs.ErrExist) {\n  2227\t\t\treturn \"\", err\n  2228\t\t}\n  2229\t\t// The resume that took it claims right after; look for that claim.\n  2230\t\texisting, pending := s.awaitContinuationClaim(ctx, *plan.predecessor)\n  2231\t\tif pending != nil {\n  2232\t\t\treturn \"\", pending\n  2233\t\t}\n  2234\t\tif existing != nil {\n  2235\t\t\treturn \"\", &continuationRecorded{run: *existing}\n  2236\t\t}\n  2237\t\treturn \"\", err\n  2238\t}\n  2239\t\n  2240\t// continuationRecorded carries a continuation another resume already ended,\n  2241\t// so the disp