ld; each opens a new session, recording why (R6, D1, D5).\n   658\tfunc (s Store) planReviewThread(plan *DispatchPlan) error {\n   659\t\tround, err := s.ReviewRoundOf(plan.Bundle)\n   660\t\tif err != nil {\n   661\t\t\treturn err\n   662\t\t}\n   663\t\tplan.round = round.Number\n   664\t\tif round.Number < 2 || round.Prior == nil {\n   665\t\t\treturn nil\n   666\t\t}\n   667\t\tpolicy, _, _, err := s.LoadDelegationPolicy()\n   668\t\tif err != nil {\n   669\t\t\treturn err\n   670\t\t}\n   671\t\truns, _, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n   672\t\tif err != nil {\n   673\t\t\treturn err\n   674\t\t}\n   675\t\tprior := round.Prior\n   676\t\tthread := &ReviewThread{Round: round.Number, Mode: ReviewThreadNew, From: prior.RunID}\n   677\t\tthreshold := policy.Routing.RoundThresholdOf()\n   678\t\tfailed := FailedContinuation(runs, plan.Bundle.BundleID)\n   679\t\tsession := \"\"\n   680\t\tswitch {\n   681\t\tcase policy.Routing.RoundsMode() == ReviewRoundsColdSession:\n   682\t\t\tthread.Reason = \"routing.rounds is cold-session\"\n   683\t\tcase round.Broken != \"\":\n   684\t\t\tthread.Reason = \"the chain of rounds is broken: \" + round.Broken\n   685\t\tcase !strings.EqualFold(prior.Vendor, plan.Config.Vendor):\n   686\t\t\tthread.Reason = \"the agent's vendor changed from \" + prior.Vendor + \" to \" + plan.Config.Vendor\n   687\t\tcase prior.Adapter != plan.Adapter:\n   688\t\t\tthread.Reason = \"the agent changed from \" + prior.Adapter + \" to \" + plan.Adapter\n   689\t\tcase round.Number >= threshold:\n   690\t\t\tthread.Reason = fmt.Sprintf(\"round %d reached the round threshold %d\", round.Number, threshold)\n   691\t\tcase prior.SessionDigest == \"\" || plan.Config.Resume == nil || len(plan.Config.Resume.Command) == 0:\n   692\t\t\tthread.Reason = \"the previous round's session cannot be resumed: it recorded no session or the agent declares no resume\"\n   693\t\tcase failed != nil:\n   694\t\t\tthread.Reason = FailedContinuationReason(failed)\n   695\t\tcase previousRoundCheckoutHeld(*prior) != \"\":\n   696\t\t\t// The continued session would work where the previous round's run\n   697\t\t\t// did; that path is held by a leftover or a live run, so the round\n   698\t\t\t// opens a new session in its own directory instead of failing after\n   699\t\t\t// its attempt is reserved (spec pose-review-resume-runtime-dir-followups,\n   700\t\t\t// review round 1, N2).\n   701\t\t\tthread.Reason = \"the previous round's checkout path \" + previousRoundCheckoutHeld(*prior) + \" is still in use\"\n   702\t\tdefault:\n   703\t\t\tvalue, rerr := s.readReviewSession(prior.SessionDigest)\n   704\t\t\tif rerr != nil {\n   705\t\t\t\tthread.Reason = \"the previous round's session cannot be resumed: \" + rerr.Error()\n   706\t\t\t\tbreak\n   707\t\t\t}\n   708\t\t\tthread.Mode, session = ReviewThreadContinued, value\n   709\t\t}\n   710\t\tplan.thread, plan.session = thread, session\n   711\t\treturn nil\n   712\t}\n   713\t\n   714\t// FailedContinuation is a run of the bundle that failed while continuing a\n   715\t// session: nothing says why in terms common to every vendor, and resuming what\n   716\t// just failed is not worth an attempt (spec\n   717\t// pose-delegated-review-expired-session R1, D1).\n   718\tfunc FailedContinuation(runs []ReviewRun, bundleID string) *ReviewRun {\n   719\t\tfor i := range runs {\n   720\t\t\tif runs[i].BundleID == bundleID && runs[i].Status == ReviewRunFailed && runs[i].Thread.continued() {\n   721\t\t\t\treturn &runs[i]\n   722\t\t\t}\n   723\t\t}\n   724\t\treturn nil\n   725\t}\n   726\t\n   727\tfunc FailedContinuationReason(run *ReviewRun) string {\n   728\t\treason := \"the session could not be continued: run \" + run.RunID + \" failed\"\n   729\t\tif failure := []rune(run.Failure); len(failure) > 200 {\n   730\t\t\treturn reason + \": \" + string(failure[:200]) + \"…\"\n   731\t\t} else if len(failure) > 0 {\n   732\t\t\treturn reason + \": \" + string(failure)\n   7