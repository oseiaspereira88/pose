{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jj4RwzUHJUq2Vaa5cmc21z","type":"tool_result","content":"   225\t\t}\n   226\t}\n   227\tfunc TestRunContinuityDoctorStatusAndPending(t *testing.T) {\n   228\t\troot, s, r := runContinuityFixture(t)\n   229\t\twarns := 0\n   230\t\tdiagnoseReviewContinuity(root, func(check, level, message, hint string) {\n   231\t\t\tif check == \"review.interrupted\" && level == \"warn\" && strings.Contains(message, r.RunID) {\n   232\t\t\t\twarns++\n   233\t\t\t}\n   234\t\t})\n   235\t\tif warns != 1 {\n   236\t\t\tt.Fatal(\"doctor missed interruption\")\n   237\t\t}\n   238\t\tif code, out := runPose(t, root, \"delegate\", \"ls\", \"--json\"); code != 0 || !strings.Contains(out, `\"time_left\"`) || !strings.Contains(out, `\"partial\": true`) {\n   239\t\t\tt.Fatal(code, out)\n   240\t\t}\n   241\t\traw, _ := json.Marshal(r)\n   242\t\tdigest := sha256.Sum256(raw)\n   243\t\tclaim := map[string]any{\"schema_version\": 1, \"predecessor\": r.RunID, \"attempt_id\": r.AttemptID, \"predecessor_digest\": \"sha256:\" + hex.EncodeToString(digest[:]), \"claimed_at\": time.Now().UTC().Format(time.RFC3339Nano), \"nonce\": strings.Repeat(\"a\", 32)}\n   244\t\tclaimRaw, _ := json.Marshal(claim)\n   245\t\tdir := filepath.Join(root, \".pose/review-continuations\")\n   246\t\tif e := os.MkdirAll(dir, 0755); e != nil {\n   247\t\t\tt.Fatal(e)\n   248\t\t}\n   249\t\tif e := os.WriteFile(filepath.Join(dir, r.RunID+\".json\"), claimRaw, 0644); e != nil {\n   250\t\t\tt.Fatal(e)\n   251\t\t}\n   252\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", r.RunID); code != 0 || !strings.Contains(out, \"delegate.status=pending\") || !strings.Contains(out, \"resume-of:\"+r.RunID) {\n   253\t\t\tt.Fatal(\"pending not returned\", code, out)\n   254\t\t}\n   255\t\truns, _ := s.ListReviewRuns(\"\")\n   256\t\tif len(runs) != 1 {\n   257\t\t\tt.Fatal(\"pending claim launched another process\")\n   258\t\t}\n   259\t}\n   260\t\n   261\tfunc TestRunContinuityConcurrentResumeLaunchesOnce(t *testing.T) {\n   262\t\tmarker := filepath.Join(t.TempDir(), \"launches\")\n   263\t\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n   264\t\t\ta.Resume.Command = []string{\"sh\", \"-c\", `printf 'start\\n' >> \"$2\"; sleep 0.05; printf 'decision: approved\\n'`, \"sh\", \"{session}\", marker}\n   265\t\t})\n   266\t\tplan, e := s.PlanReviewResume(r.RunID)\n   267\t\tif e != nil {\n   268\t\t\tt.Fatal(e)\n   269\t\t}\n   270\t\tvar wg sync.WaitGroup\n   271\t\tfor i := 0; i < 8; i++ {\n   272\t\t\twg.Add(1)\n   273\t\t\tgo func() { defer wg.Done(); _, _ = s.RunReviewDispatch(plan, time.Now) }()\n   274\t\t}\n   275\t\twg.Wait()\n   276\t\traw, e := os.ReadFile(marker)\n   277\t\tif e != nil || string(raw) != \"start\\n\" {\n   278\t\t\tt.Fatalf(\"duplicate launches %q %v\", raw, e)\n   279\t\t}\n   280\t\truns, lost, e := s.ReadReviewRuns(\"\")\n   281\t\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n   282\t\t\tt.Fatal(len(runs), lost, e)\n   283\t\t}\n   284\t}\n   285\tfunc TestRunContinuityObservedProcessLoss(t *testing.T) {\n   286\t\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n   287\t\t\ta.Command = []string{\"sh\", \"-c\", `printf 'session: fixture-private-session\\n'; kill -KILL $$`}\n   288\t\t})\n   289\t\tif r.Interruption.Cause != \"process-lost\" || !r.Interruption.Resumable {\n   290\t\t\tt.Fatal(r.Interruption)\n   291\t\t}\n   292\t\tif _, e := s.PlanReviewResume(r.RunID); e != nil {\n   293\t\t\tt.Fatal(e)\n   294\t\t}\n   295\t}\n   296\t\n   297\t// Spec pose-review-resume-keeps-the-sealed-checkout R1, R2: a resumed session\n   298\t// works in the sealed checkout it saw before the interruption, recreated at\n   299\t// the same path after the interrupted run removed it.\n   300\tfunc TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath(t *testing.T) {\n   301\t\tmarks := t.TempDir()\n   302\t\tfirst := filepath.Join(marks, \"first\")\n   303\t\troot, _, prior := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n   304\t\t\ta.Command = []string{\"sh\", \"-c\", `pwd > \"$1\"; printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\ndecision: rejected\\n'; exit 75`, \"sh\", first}\n   305\t\t\ta.Resume.Command = []string{\"sh\", \"-c\", `test \"$(pwd)\" = \"$(cat \"$1\")\" || { echo \"moved from $(cat \"$1\") to $(pwd)\" >&2; exit 3; }; test -f .pose/specs/alpha/spec.md || exit 4; printf 'decision: approved\\n'`, \"sh\", first, \"{session}\"}\n   306\t\t})\n   307\t\traw, err := os.ReadFile(first)\n   308\t\tif err != nil {\n   309\t\t\tt.Fatal(err)\n   310\t\t}\n   311\t\tcheckout := strings.TrimSpace(string(raw))\n   312\t\tif _, err := os.Stat(checkout); !os.IsNotExist(err) {\n   313\t\t\tt.Fatalf(\"the interrupted run left its checkout %s behind: %v\", checkout, err)\n   314\t\t}\n   315\t\t// Review round 1, N1: a leftover runtime directory refuses the resume\n   316\t\t// before it is claimed, so removing it restores the resume.\n   317\t\truntimeDir := filepath.Dir(checkout)\n   318\t\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n   319\t\t\tt.Fatal(err)\n   320\t\t}\n   321\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID); code == 0 || !strings.Contains(out, \"then resume again\") {\n   322\t\t\tt.Fatalf(\"a resume beside a leftover runtime directory: %d %s\", code, out)\n   323\t\t}\n   324\t\t// Review round 2, N6: a handoff is refused the same way, before it\n   325\t\t// claims the interrupted run.\n   326\t\tif _, err := (posemodel.Store{Root: root}).PlanReviewHandoff(prior.RunID, \"other\"); err == nil || !strings.Contains(err.Error(), \"still exists\") || !strings.Contains(err.Error(), \"then hand off again\") {\n   327\t\t\tt.Fatalf(\"a handoff beside a leftover runtime directory: %v\", err)\n   328\t\t}\n   329\t\tif err := os.Remove(runtimeDir); err != nil {\n   330\t\t\tt.Fatal(err)\n   331\t\t}\n   332\t\t// Spec pose-review-resume-runtime-dir-followups R1: a directory that\n   333\t\t// appears between the plan and the dispatch is refused before the claim,\n   334\t\t// so the interrupted run stays resumable.\n   335\t\tstore := posemodel.Store{Root: root}\n   336\t\tplan, err := store.PlanReviewResume(prior.RunID)\n   337\t\tif err != nil {\n   338\t\t\tt.Fatal(err)\n   339\t\t}\n   340\t\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n   341\t\t\tt.Fatal(err)\n   342\t\t}\n   343\t\tif _, err := store.RunReviewDispatch(plan, time.Now); err == nil || !(strings.Contains(err.Error(), \"already exists\") || strings.Contains(err.Error(), \"still exists\")) {\n   344\t\t\tt.Fatalf(\"a dispatch beside a directory that appeared: %v\", err)\n   345\t\t}\n   346\t\tif err := os.Remove(runtimeDir); err != nil {\n   347\t\t\tt.Fatal(err)\n   348\t\t}\n   349\t\tcode, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID)\n   350\t\tif code != 0 || !strings.Contains(out, \"status=completed\") {\n   351\t\t\tt.Fatalf(\"the resumed session did not find its checkout at %s: %d %s\", checkout, code, out)\n   352\t\t}\n   353\t}\n   354\t\n   355\t// Review round 1 of spec pose-review-resume-runtime-dir-followups, N1: a\n   356\t// continuation that fails before it owns its cleanup removes the runtime\n   357\t// directory it took, so nothing is left for a later continuation to meet.\n   358\tfunc TestRunContinuityAFailedContinuationLeavesNoRuntimeDirectory(t *testing.T) {\n   359\t\tmarks := t.TempDir()\n   360\t\tfirst := filepath.Join(marks, \"first\")\n   361\t\troot, _, prior := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n   362\t\t\ta.Command = []string{\"sh\", \"-c\", `pwd > \"$1\"; printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\ndecision: rejected\\n'; exit 75`, \"sh\", first}\n   363\t\t})\n   364\t\traw, err := os.ReadFile(first)\n   365\t\tif err != nil {\n   366\t\t\tt.Fatal(err)\n   367\t\t}\n   368\t\truntimeDir := filepath.Dir(strings.TrimSpace(string(raw)))\n   369\t\tstore := posemodel.Store{Root: root}\n   370\t\tplan, err := store.PlanReviewResume(prior.RunID)\n   371\t\tif err != nil {\n   372\t\t\tt.Fatal(err)\n   373\t\t}\n   374\t\tplan.OnStart = func(string) error { return errors.New(\"no hand-back here\") }\n   375\t\trun, _ := store.RunReviewDispatch(plan, time.Now)\n   376\t\tif run.Status != posemodel.ReviewRunFailed {\n   377\t\t\tt.Fatalf(\"a failing hand-back did not fail the continuation: %+v\", run.Status)\n   378\t\t}\n   379\t\tif _, err := os.Lstat(runtimeDir); !os.IsNotExist(err) {\n   380\t\t\tt.Fatalf(\"a failed continuation left its runtime directory %s: %v\", runtimeDir, err)\n   381\t\t}\n   382\t}\n    55\t// the runtime name its predecessor recorded, also a random one of an earlier\n    56\t// engine; a round continuing its thread reuses the previous round's; a name\n    57\t// that is not a runtime name is never used as a path.\n    58\tfunc TestRunContinuityRuntimeNameFollowsTheSession(t *testing.T) {\n    59\t\ttmp := t.TempDir()\n    60\t\tfor _, name := range []string{\"TMPDIR\", \"TMP\", \"TEMP\"} {\n    61\t\t\tt.Setenv(name, tmp)\n    62\t\t}\n    63\t\tattempt := \"rat-\" + strings.Repeat(\"cd\", 32)\n    64\t\tstable, _ := reviewRunRuntimeDirPath(attempt)\n    65\t\told := ReviewRun{RunID: \"rrn-old\", AttemptID: attempt, Safety: &ReviewExecutionSafety{RuntimeID: \"pose-review-run-1504287996\"}}\n    66\t\tif got := runtimeSourceOf(old); got != \"pose-review-run-1504287996\" {\n    67\t\t\tt.Fatalf(\"an earlier engine's random name was not reused: %s\", got)\n    68\t\t}\n    69\t\tif dir, ok := reviewRunRuntimeDirPath(runtimeSourceOf(old)); !ok || dir != filepath.Join(os.TempDir(), \"pose-review-run-1504287996\") {\n    70\t\t\tt.Fatalf(\"the recorded name's directory: %s %v\", dir, ok)\n    71\t\t}\n    72\t\tbad := ReviewRun{AttemptID: attempt, Safety: &ReviewExecutionSafety{RuntimeID: \"../escape\"}}\n    73\t\tif dir, _ := reviewRunRuntimeDirPath(runtimeSourceOf(bad)); dir != stable {\n    74\t\t\tt.Fatalf(\"a name that is not a runtime name was used: %s\", dir)\n    75\t\t}\n    76\t\tif got := runtimeSourceAmong(DispatchPlan{predecessor: &old}, \"rat-\"+strings.Repeat(\"ef\", 32), nil); got != \"pose-review-run-1504287996\" {\n    77\t\t\tt.Fatalf(\"a continuation did not follow its predecessor: %s\", got)\n    78\t\t}\n    79\t\tthread := DispatchPlan{thread: &ReviewThread{Mode: ReviewThreadContinued, From: \"rrn-old\"}}\n    80\t\tif got := runtimeSourceAmong(thread, \"rat-\"+strings.Repeat(\"ef\", 32), []ReviewRun{old}); got != \"pose-review-run-1504287996\" {\n    81\t\t\tt.Fatalf(\"a continued thread did not follow its previous round: %s\", got)\n    82\t\t}\n    83\t\tfresh := DispatchPlan{thread: &ReviewThread{Mode: ReviewThreadNew, From: \"rrn-old\"}}\n    84\t\tif got := runtimeSourceAmong(fresh, attempt, []ReviewRun{old}); got != attempt {\n    85\t\t\tt.Fatalf(\"a new thread followed the previous round: %s\", got)\n    86\t\t}\n    87\t}\n    88\t\n    89\t// Spec pose-review-resume-runtime-dir-followups R1: the continuation takes\n    90\t// its runtime directory before any claim; a directory already there, with no\n    91\t// claim appearing, refuses it with nothing claimed.\n    92\tfunc TestRunContinuityTakesTheRuntimeDirectoryBeforeTheClaim(t *testing.T) {\n    93\t\ttmp := t.TempDir()\n    94\t\tfor _, name := range []string{\"TMPDIR\", \"TMP\", \"TEMP\"} {\n    95\t\t\tt.Setenv(name, tmp)\n    96\t\t}\n    97\t\ts := Store{Root: t.TempDir()}\n    98\t\tprior := ReviewRun{RunID: \"rrn-prior\", AttemptID: \"rat-\" + strings.Repeat(\"ab\", 32)}\n    99\t\tplan := DispatchPlan{predecessor: &prior}\n   100\t\tdir, err := s.takeContinuationRuntimeDir(context.Background(), plan)\nbc6da5c9 fix(pose): release a taken runtime directory on early failure and skip held thread paths","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"55b