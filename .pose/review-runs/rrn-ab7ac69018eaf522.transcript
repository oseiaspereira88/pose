{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MLiQNoCHK3d3cs76ffSJDj","type":"tool_result","content":"   150\t\tif len(matches) != 1 || len(matches[0]) != 2 {\n   151\t\t\treturn \"\", fmt.Errorf(\"ambiguous adapter capture\")\n   152\t\t}\n   153\t\tvalue := matches[0][1]\n   154\t\tif len(value) == 0 || len(value) > 2048 || strings.ContainsAny(value, \"\\x00\\r\\n\") {\n   155\t\t\treturn \"\", fmt.Errorf(\"adapter capture is not a bounded reference\")\n   156\t\t}\n   157\t\treturn value, nil\n   158\t}\n   159\tfunc (s Store) saveReviewSession(value string) (string, error) {\n   160\t\tdigest := digestBytes([]byte(value))\n   161\t\tdir, e := ensureReviewArtifactDir(s.Root, reviewPrivateDir, true)\n   162\t\tif e != nil {\n   163\t\t\treturn \"\", e\n   164\t\t}\n   165\t\tif e = os.Chmod(dir, 0700); e != nil {\n   166\t\t\treturn \"\", e\n   167\t\t}\n   168\t\t// Private session files are runtime state, never published evidence.\n   169\t\tignore := filepath.Join(dir, \".gitignore\")\n   170\t\tif e = PublishFile(ignore, []byte(\"*\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); e != nil {\n   171\t\t\treturn \"\", e\n   172\t\t}\n   173\t\te = PublishFile(filepath.Join(dir, strings.TrimPrefix(digest, \"sha256:\")+\".session\"), []byte(value), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n   174\t\treturn digest, e\n   175\t}\n   176\tfunc (s Store) readReviewSession(digest string) (string, error) {\n   177\t\tif len(digest) != 71 || !strings.HasPrefix(digest, \"sha256:\") || strings.ContainsAny(digest, \"/\\\\\") {\n   178\t\t\treturn \"\", fmt.Errorf(\"invalid session digest\")\n   179\t\t}\n   180\t\tdir, e := ensureReviewArtifactDir(s.Root, reviewPrivateDir, false)\n   181\t\tif e != nil {\n   182\t\t\treturn \"\", e\n   183\t\t}\n   184\t\traw, e := readLedgerRaw(filepath.Join(dir, strings.TrimPrefix(digest, \"sha256:\")+\".session\"))\n   185\t\tif e != nil {\n   186\t\t\treturn \"\", e\n   187\t\t}\n   188\t\tif digestBytes(raw) != digest || len(raw) == 0 || len(raw) > 2048 {\n   189\t\t\treturn \"\", fmt.Errorf(\"private session digest differs\")\n   190\t\t}\n   191\t\treturn string(raw), nil\n   192\t}\n   193\tfunc (s Store) classifyReviewInterruption(run *ReviewRun, plan DispatchPlan, transcript []byte, runErr, ctxErr error) (string, string, error) {\n   194\t\t// Inspect both supported output channels before any public publication.\n   195\t\tchannels := append([]string{string(transcript), run.Output}, plan.extraChannels...)\n   196\t\tsessionChannels := make([]string, 0, len(channels))\n   197\t\tfor _, channel := range channels {\n   198\t\t\tcanonical, err := canonicalDelegationSessionChannel(plan.Config.Events, sessionPattern(plan.Config), channel)\n   199\t\t\tif err != nil {\n   200\t\t\t\treturn \"\", \"\", err\n   201\t\t\t}\n   202\t\t\tsessionChannels = append(sessionChannels, canonical)\n   203\t\t}\n   204\t\tvalue, e := captureReviewChannels(sessionPattern(plan.Config), sessionChannels...)\n   205\t\tif e != nil {\n   206\t\t\treturn \"\", \"\", e\n   207\t\t}\n   208\t\tif value != \"\" && plan.session != \"\" && value != plan.session {\n   209\t\t\treturn \"\", \"\", fmt.Errorf(\"adapter changed the captured session\")\n   210\t\t}\n   211\t\tif value == \"\" {\n   212\t\t\tvalue = plan.session\n   213\t\t}\n   214\t\tif value != \"\" {\n   215\t\t\trun.sessionForRedaction = value\n   216\t\t\trun.SessionDigest, e = s.saveReviewSession(value)\n   217\t\t\tif e != nil {\n   218\t\t\t\treturn \"\", \"\", e\n   219\t\t\t}\n   220\t\t}\n   221\t\tcause := \"\"\n   222\t\tif ctxErr != nil {\n   223\t\t\tcause = \"timeout\"\n   224\t\t\tif errors.Is(ctxErr, context.Canceled) {\n   225\t\t\t\tcause = \"cancelled\"\n   226\t\t\t}\n   227\t\t} else if runErr != nil && run.ExitCode < 0 {\n   228\t\t\tcause = \"process-lost\"\n   229\t\t}\n   230\t\tlimit := false\n   231\t\tif p := plan.Config.Limit; p != nil {\n   232\t\t\tfor _, code := range p.ExitCodes {\n   233\t\t\t\tif code == run.ExitCode {\n   234\t\t\t\t\tlimit = true\n   235\t\t\t\t}\n   236\t\t\t}\n   237\t\t\tfor _, pattern := range p.OutputPatterns {\n   238\t\t\t\tfor _, channel := range channels {\n   239\t\t\t\t\tif regexp.MustCompile(pattern).MatchString(channel) {\n   240\t\t\t\t\t\tlimit = true\n   241\t\t\t\t\t}\n   242\t\t\t\t}\n   243\t\t\t}\n   244\t\t}\n   245\t\tif limit {\n   246\t\t\tcause = \"usage-limit\"\n   247\t\t}\n   248\t\tsupervisorCause := cause\n   249\t\tif cause == \"\" {\n   250\t\t\tif runErr != nil {\n   251\t\t\t\treturn ReviewRunFailed, \"the reviewer command failed: \" + runErr.Error(), nil\n   252\t\t\t}\n   253\t\t\treturn \"\", \"\", nil\n   254\t\t}\n   255\t\t// Without any continuity declaration, interruption classification is unknown.\n   256\t\tif plan.Config.Limit == nil && plan.Config.Session == nil && plan.Config.Resume == nil {\n   257\t\t\tcause = \"unknown\"\n   258\t\t}\n   259\t\tinterruption := &ReviewInterruption{Cause: cause, Resumable: run.SessionDigest != \"\" && plan.Config.Resume != nil && len(plan.Config.Resume.Command) > 0}\n   260\t\tif cause == \"usage-limit\" {\n   261\t\t\treset, e := captureReviewChannels(resetPattern(plan.Config), channels...)\n   262\t\t\tif e != nil {\n   263\t\t\t\treturn \"\", \"\", e\n   264\t\t\t}\n   265\t\t\tif reset != \"\" {\n   266\t\t\t\tt, e := time.Parse(time.RFC3339Nano, reset)\n   267\t\t\t\tif e != nil {\n   268\t\t\t\t\treturn \"\", \"\", fmt.Errorf(\"adapter reset instant is not RFC3339\")\n   269\t\t\t\t}\n   270\t\t\t\tinterruption.ResetAt = t.UTC().Format(time.RFC3339Nano)\n   271\t\t\t}\n   272\t\t}\n   273\t\trun.Interruption = interruption\n   274\t\treturn ReviewRunInterrupted, \"review interrupted: \" + cause + \" (supervisor: \" + supervisorCause + \")\", nil\n   275\t}\n   276\tfunc validateContinuityRun(r ReviewRun) error {\n   277\t\tif r.Status == ReviewRunInterrupted {\n   278\t\t\tif r.Interruption == nil {\n   279\t\t\t\treturn fmt.Errorf(\"interrupted run has no cause\")\n   280\t\t\t}\n   281\t\t\tswitch r.Interruption.Cause {\n   282\t\t\tcase \"usage-limit\", \"timeout\", \"process-lost\", \"cancelled\", \"unknown\":\n   283\t\t\tdefault:\n   284\t\t\t\treturn fmt.Errorf(\"invalid interruption cause\")\n   285\t\t\t}\n   286\t\t\tif r.Interruption.ResetAt != \"\" {\n   287\t\t\t\tif _, e := time.Parse(time.RFC3339Nano, r.Interruption.ResetAt); e != nil {\n   288\t\t\t\t\treturn e\n   289\t\t\t\t}\n   290\t\t\t}\n   291\t\t\tif r.Interruption.Resumable && (r.SessionDigest == \"\" || r.TreeDigest == \"\" || r.AttemptID == \"\") {\n   292\t\t\t\treturn fmt.Errorf(\"resumable run lacks bound evidence\")\n   293\t\t\t}\n   294\t\t\tif r.PartialDigest != digestBytes([]byte(r.Output)) {\n   295\t\t\t\treturn fmt.Errorf(\"partial draft digest differs\")\n   296\t\t\t}\n   297\t\t} else if r.Interruption != nil {\n   298\t\t\treturn fmt.Errorf(\"terminal run contains interruption metadata\")\n   299\t\t}\n   300\t\treturn nil\n   301\t}\n   302\tfunc continuationPath(run string, result bool) string {\n   303\t\tsuffix := \".json\"\n   304\t\tif result {\n   305\t\t\tsuffix = \".result.json\"\n   306\t\t}\n   307\t\treturn filepath.ToSlash(filepath.Join(reviewContinuationsDir, run+suffix))\n   308\t}\n   309\tfunc (s Store) claimReviewContinuation(r ReviewRun, at time.Time) error {\n   310\t\traw, _ := json.Marshal(r)\n   311\t\t// Clear reader-only fields before deriving the predecessor digest.\n   312\t\tr.Path, r.SupersededBy = \"\", \"\"\n   313\t\traw, _ = json.Marshal(r)\n   314\t\tnonce := make([]byte, 16)\n   315\t\tif _, err := rand.Read(nonce); err != nil {\n   316\t\t\treturn err\n   317\t\t}\n   318\t\treturn publishLedgerJSON(s.Root, continuationPath(r.RunID, false), reviewContinuation{1, r.RunID, r.AttemptID, digestBytes(raw), at.UTC().Format(time.RFC3339Nano), hex.EncodeToString(nonce)})\n   319\t}\n   320\tfunc (s Store) finishReviewContinuation(r ReviewRun) error {\n   321\t\traw, _ := json.Marshal(r)\n   322\t\treceipt := reviewAttemptReceipt{1, r.AttemptID, r.RunID, digestBytes(raw)}\n   323\t\treturn publishLedgerJSON(s.Root, continuationPath(r.continues(), true), receipt)\n   324\t}\n   325\tfunc (s Store) existingReviewContinuation(r ReviewRun, runs []ReviewRun) (*ReviewRun, error) {\n   326\t\tvar claim reviewContinuation\n   327\t\te := readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, false)), &claim)\n   328\t\tif errors.Is(e, os.ErrNotExist) {\n   329\t\t\treturn nil, nil\n   330\t\t}\n   331\t\tif e != nil {\n   332\t\t\treturn nil, e\n   333\t\t}\n   334\t\tcopy := r\n   335\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n   336\t\traw, _ := json.Marshal(copy)\n   337\t\tif claim.SchemaVersion != 1 || claim.Predecessor != r.RunID || claim.AttemptID != r.AttemptID || claim.PredecessorDigest != digestBytes(raw) {\n   338\t\t\treturn nil, fmt.Errorf(\"continuation predecessor changed\")\n   339\t\t}\n   340\t\tvar receipt reviewAttemptReceipt\n   341\t\tif e = readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, true)), &receipt); e != nil {\n   342\t\t\treturn nil, &PendingReviewContinuation{ID: \"resume-of:\" + r.RunID, Predecessor: r.RunID, AttemptID: r.AttemptID}\n   343\t\t}\n   344\t\tfor _, next := range runs {\n   345\t\t\tif next.RunID == receipt.RunID {\n   346\t\t\t\tcopy := next\n   347\t\t\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n   348\t\t\t\traw, _ := json.Marshal(copy)\n   349\t\t\t\tif receipt.SchemaVersion != 1 || receipt.AttemptID != r.AttemptID || next.AttemptID != r.AttemptID || next.continues() != r.RunID || receipt.RunDigest != digestBytes(raw) {\n   350\t\t\t\t\treturn nil, fmt.Errorf(\"invalid continuation receipt\")\n   351\t\t\t\t}\n   352\t\t\t\treturn &next, nil\n   353\t\t\t}\n   354\t\t}\n   355\t\treturn nil, fmt.Errorf(\"continuation result is missing\")\n   356\t}\n   357\t\n   358\t// PlanReviewResume validates original evidence, policy and all accumulated budgets.\n   359\tfunc (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n   360\t\truns, lost, e := s.ReadReviewRuns(\"\")\n   361\t\tif e != nil {\n   362\t\t\treturn DispatchPlan{}, e\n   363\t\t}\n   364\t\tif len(lost) > 0 {\n   365\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume history incomplete: %v\", lost)\n   366\t\t}\n   367\t\tvar prior *ReviewRun\n   368\t\tfor i := range runs {\n   369\t\t\tif runs[i].RunID == id {\n   370\t\t\t\tprior = &runs[i]\n   371\t\t\t}\n   372\t\t}\n   373\t\tif prior == nil {\n   374\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume predecessor not found\")\n   375\t\t}\n   376\t\tif prior.Status != ReviewRunInterrupted || prior.Interruption == nil || !prior.Interruption.Resumable {\n   377\t\t\treturn DispatchPlan{}, fmt.Errorf(\"run is %s or not resumable\", prior.Status)\n   378\t\t}\n   379\t\tif why := s.reviewRunTranscriptIntact(*prior); why != \"\" {\n   380\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume: %s\", why)\n   381\t\t}\n   382\t\tpolicy, _, e := s.LoadReviewersPolicyFor(prior.Kind)\n   383\t\tif e != nil {\n   384\t\t\treturn DispatchPlan{}, e\n   385\t\t}\n   386\t\tconfig, ok := policy.Adapters[prior.Adapter]\n   387\t\tif !ok || config.Resume == nil || len(config.Resume.Command) == 0 {\n   388\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume adapter declaration missing\")\n   389\t\t}\n   390\t\tbrief, e := s.RenderReviewBriefMatching(prior.BundleID, prior.Kind, prior.BriefNotes, prior.BriefDigest)\n   391\t\tif e != nil {\n   392\t\t\treturn DispatchPlan{}, e\n   393\t\t}\n   394\t\tbundle, e := s.LoadReviewBundle(prior.BundleID)\n   395\t\tif e != nil {\n   396\t\t\treturn DispatchPlan{}, e\n   397\t\t}\n   398\t\tif brief.Digest != prior.BriefDigest || bundle.BundleDigest != prior.BundleDigest || bundle.Payload.Subject.Head != prior.SealedCommit {\n   399\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume bundle or brief digest changed\")\n   400\t\t}\n   401\t\torigin, e := dispatchWorktreeIdentity(s.Root)\n   402\t\tif e != nil {\n   403\t\t\treturn DispatchPlan{}, e\n   404\t\t}\n   405\t\tif prior.Safety != nil && prior.Safety.Operation.Outcome != OutcomeCompleted {\n   406\t\t\treturn DispatchPlan{}, fmt.Errorf(\"predecessor cleanup incomplete; refusing continuation beside possible orphan\")\n   407\t\t}\n   408\t\tplan := DispatchPlan{predecessor: prior, notes: prior.BriefNotes, Reason: prior.Reason, PolicyDigest: prior.PolicyDigest, OriginWorktree: origin, Adapter: prior.Adapter, Config: config, Brief: brief, Bundle: bundle, SealedCommit: prior.SealedCommit}\n   409\t\tcontinuationRound(&plan, *prior, false)\n   410\t\tif e = s.checkDispatchOrigin(plan); e != nil {\n   411\t\t\treturn DispatchPlan{}, e\n   412\t\t}\n   413\t\texisting, e := s.existingReviewContinuation(*prior, runs)\n   414\t\tif e != nil {\n   415\t\t\tvar pending *PendingReviewContinuation\n   416\t\t\tif errors.As(e, &pending) {\n   417\t\t\t\tplan.PendingContinuation = pending\n   418\t\t\t\treturn plan, nil\n   419\t\t\t}\n   420\t\t\treturn DispatchPlan{}, e\n   421\t\t}\n   422\t\tif existing != nil {\n   423\t\t\tif existing.HandsOffFrom == prior.RunID {\n   424\t\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was handed off to run %s; it is not resumed\", prior.RunID, existing.RunID)\n   425\t\t\t}\n   426\t\t\tplan.Existing = existing\n   427\t\t\treturn plan, nil\n   428\t\t}\n   429\t\t// Only a continuation still to start needs the attempt's runtime\n   430\t\t// directory free; a repeated resume returns the recorded one.\n   431\t\tif e = reviewRunRuntimeDirFree(runtimeSourceOf(*prior), \"resume\"); e != nil {\n   432\t\t\t// Another resume takes the directory just before its claim: a claim\n   433\t\t\t// that appears meanwhile makes this one pending (spec\n   434\t\t\t// pose-review-resume-runtime-dir-followups R1).\n   435\t\t\texisting, pending := s.awaitContinuationClaim(context.Background(), *prior)\n   436\t\t\tif pending != nil {\n   437\t\t\t\tplan.PendingContinuation = pending\n   438\t\t\t\treturn plan, nil\n   439\t\t\t}\n   440\t\t\tif existing != nil {\n   441\t\t\t\t// Another resume ended meanwhile: its record is the answer\n   442\t\t\t\t// (spec pose-review-resume-residuals R1).\n   443\t\t\t\tplan.Existing = existing\n   444\t\t\t\treturn plan, nil\n   445\t\t\t}\n   446\t\t\treturn DispatchPlan{}, e\n   447\t\t}\n   448\t\t// The attempt's budget, not this agent's: after a handoff the resumed\n   449\t\t// agent may declare another (spec pose-delegation-handoff R2).\n   450\t\tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\n   451\t\tif e != nil {\n   452\t\t\treturn DispatchPlan{}, e\n   453\t\t}\n   454\t\tif count >= limit || spent >= total {\n   455\t\t\treturn DispatchPlan{}, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"resume budget exhausted: %d resumes, %s wall-clock\", count, spent))\n   456\t\t}\n   457\t\ttimeout := 60 * time.Minute\n   458\t\tif config.Timeout != \"\" {\n   459\t\t\ttimeout, _ = time.ParseDuration(config.Timeout)\n   460\t\t}\n   461\t\tif total-spent < timeout {\n   462\t\t\ttimeout = total - spent\n   463\t\t}\n   464\t\tplan.processTimeout = timeout\n   465\t\t// A continuation runs the same agent the attempt was routed to.\n   466\t\tplan.Routing = prior.Routing\n   467\t\ts.planImplementation(&plan, prior.Lead)\n   468\t\tplan.provenance, e = s.prepareRunProvenance(plan, policy)\n   469\t\tif e != nil {\n   470\t\t\treturn DispatchPlan{}, e\n   471\t\t}\n   472\t\tplan.session, e = s.readReviewSession(prior.SessionDigest)\n   473\t\tif e != nil {\n   474\t\t\treturn DispatchPlan{}, e\n   475\t\t}\n   476\t\treturn plan, nil\n   477\t}\n   478\t\n   479\t// ReviewResumeDelay computes a bounded, non-polling wait; callers revalidate afterwards.\n   480\tfunc ReviewResumeDelay(r ReviewRun, now time.Time, max time.Duration, jitter time.Duration) (time.Duration, error) {\n   481\t\tif r.Interruption == nil || r.Interruption.ResetAt == \"\" {\n   482\t\t\treturn 0, fmt.Errorf(\"no recorded reset instant\")\n   483\t\t}\n   484\t\tif max <= 0 || max > 24*time.Hour || jitter < 0 || jitter > time.Second {\n   485\t\t\treturn 0, fmt.Errorf(\"wait bound must be positive and at most 24h; jitter at most 1s\")\n   486\t\t}\n   487\t\treset, e := time.Parse(time.RFC3339Nano, r.Interruption.ResetAt)\n   488\t\tif e != nil {\n   489\t\t\treturn 0, e\n   490\t\t}\n   491\t\tdelay := reset.Sub(now)\n   492\t\tif delay < 0 {\n   493\t\t\tdelay = 0\n   494\t\t}\n   495\t\tdelay += jitter\n   496\t\tif delay > max {\n   497\t\t\treturn 0, fmt.Errorf(\"recorded reset exceeds maximum wait\")\n   498\t\t}\n   499\t\treturn delay, nil\n   500\t}\n   501\t\n   502\t// Continuation inventories use the same bounds as the attempt ledger. Pending\n   503\t// claims are observable operations, not proof of a completed review.\n   504\tfunc (s Store) reviewContinuationFindings(runs []ReviewRun) []string {\n   505\t\tfiles := s.fsys()\n   506\t\tentries, e := ledgerEntriesIn(files, s.Root, reviewContinuationsDir)\n   507\t\tif e != nil {\n   508\t\t\treturn []string{e.Error()}\n   509\t\t}\n   510\t\tbyID := map[string]ReviewRun{}\n   511\t\tfor _, r := range runs {\n   512\t\t\tbyID[r.RunID] = r\n   513\t\t}\n   514\t\tclaims := map[string]reviewContinuation{}\n   515\t\treceipts := map[string]reviewAttemptReceipt{}\n   516\t\tlosses := []string{}\n   517\t\tbudget := int64(32 << 20)\n   518\t\tfor _, entry := range entries {\n   519\t\t\tif IsPublisherStaging(entry.Name()) {\n   520\t\t\t\tcontinue\n   521\t\t\t}\n   522\t\t\tfull := filepath.Join(s.Root, reviewContinuationsDir, entry.Name())\n   523\t\t\tif strings.HasSuffix(entry.Name(), \".result.json\") {\n   524\t\t\t\tvar receipt reviewAttemptReceipt\n   525\t\t\t\tif e := readLedgerJSONBudgetIn(files, full, &receipt, &budget); e != nil {\n   526\t\t\t\t\tlosses = append(losses, e.Error())\n   527\t\t\t\t\tcontinue\n   528\t\t\t\t}\n   529\t\t\t\treceipts[strings.TrimSuffix(entry.Name(), \".result.json\")] = receipt\n   530\t\t\t} else if strings.HasSuffix(entry.Name(), \".json\") {\n   531\t\t\t\tvar claim reviewContinuation\n   532\t\t\t\tif e := readLedgerJSONBudgetIn(files, full, &claim, &budget); e != nil {\n   533\t\t\t\t\tlosses = append(losses, e.Error())\n   534\t\t\t\t\tcontinue\n   535\t\t\t\t}\n   536\t\t\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n   537\t\t\t\tprior, ok := byID[id]\n   538\t\t\t\tprior.Path, prior.SupersededBy = \"\", \"\"\n   539\t\t\t\traw, _ := json.Marshal(prior)\n   540\t\t\t\tif !ok || claim.SchemaVersion != 1 || claim.Predecessor != id || claim.AttemptID != prior.AttemptID || claim.PredecessorDigest != digestBytes(raw) {\n   541\t\t\t\t\tlosses = append(losses, \"missing or rewritten continuation predecessor \"+id)\n   542\t\t\t\t\tcontinue\n   543\t\t\t\t}\n   544\t\t\t\tif nonce, e := hex.DecodeString(claim.Nonce); e != nil || len(nonce) != 16 {\n   545\t\t\t\t\tlosses = append(losses, \"invalid continuation nonce\")\n   546\t\t\t\t\tcontinue\n   547\t\t\t\t}\n   548\t\t\t\tif _, e := time.Parse(time.RFC3339Nano, claim.ClaimedAt); e != nil {\n   549\t\t\t\t\tlosses = append(losses, \"invalid continuation claim time\")\n   550\t\t\t\t\tcontinue\n   551\t\t\t\t}\n   552\t\t\t\tclaims[id] = claim\n   553\t\t\t} else {\n   554\t\t\t\tlosses = append(losses, \"unknown continuation artifact \"+entry.Name())\n   555\t\t\t}\n   556\t\t\tif budget <= 0 {\n   557\t\t\t\tlosses = append(losses, \"continuation inventory read budget exhausted\")\n   558\t\t\t\tbreak\n   559\t\t\t}\n   560\t\t}\n   561\t\tfor id, receipt := range receipts {\n   562\t\t\tclaim, ok := claims[id]\n   563\t\t\tnext, exists := byID[receipt.RunID]\n   564\t\t\tcopy := next\n   565\t\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n   566\t\t\traw, _ := json.Marshal(copy)\n   567\t\t\tif !ok || !exists || receipt.SchemaVersion != 1 || receipt.AttemptID != claim.AttemptID || next.AttemptID != claim.AttemptID || next.continues() != id || receipt.RunDigest != digestBytes(raw) {\n   568\t\t\t\tlosses = append(losses, \"missing or conflicting continuation result \"+id)\n   569\t\t\t}\n   570\t\t}\n   571\t\tchildren := map[string][]ReviewRun{}\n   572\t\tfor _, r := range runs {\n   573\t\t\tif r.Resumes != \"\" && r.HandsOffFrom != \"\" {\n   574\t\t\t\tlosses = append(losses, \"invalid continuation chain \"+r.RunID+\": both a resume and a handoff\")\n   575\t\t\t}\n   576\t\t\tif parentID := r.continues(); parentID != \"\" {\n   577\t\t\t\tprior, ok := byID[parentID]\n   578\t\t\t\t_, claimed := claims[parentID]\n   579\t\t\t\tsame := ok && claimed && r.AttemptID == prior.AttemptID && r.BundleDigest == prior.BundleDigest && r.BriefDigest == prior.BriefDigest && r.SealedCommit == prior.SealedCommit\n   580\t\t\t\tif r.Resumes != \"\" {\n   581\t\t\t\t\t// A resume continues the same agent and session, of a resumable stop.\n   582\t\t\t\t\tsame = same && prior.Status == ReviewRunInterrupted && prior.Interruption != nil && prior.Interruption.Resumable && r.Adapter == prior.Adapter && r.TreeDigest == prior.TreeDigest\n   583\t\t\t\t} else {\n   584\t\t\t\t\t// A handoff continues another agent, of any stop short of a conclusion.\n   585\t\t\t\t\tsame = same && handoffable(prior) == \"\" && r.Adapter != prior.Adapter && r.HandoffDigest != \"\" && handoffRenderers[r.HandoffRenderer] != nil && (prior.TreeDigest == \"\" || r.TreeDigest == prior.TreeDigest)\n   586\t\t\t\t}\n   587\t\t\t\tif !same {\n   588\t\t\t\t\tlosses = append(losses, \"invalid continuation chain \"+r.RunID)\n   589\t\t\t\t}\n   590\t\t\t\tif _, ok := receipts[parentID]; !ok {\n   591\t\t\t\t\tlosses = append(losses, \"missing continuation result receipt \"+parentID)\n   592\t\t\t\t}\n   593\t\t\t\tchildren[parentID] = append(children[parentID], r)\n   594\t\t\t}\n   595\t\t}\n   596\t\tfor id, group := range children {\n   597\t\t\tendpoints := 0\n   598\t\t\tfor _, child := range group {\n   599\t\t\t\tif child.SupersededBy == \"\" {\n   600\t\t\t\t\tendpoints++\n   601\t\t\t\t\tcontinue\n   602\t\t\t\t}\n   603\t\t\t\tnext, ok := byID[child.SupersededBy]\n   604\t\t\t\tif !ok || next.continues() != id || next.Supersedes != child.RunID {\n   605\t\t\t\t\tlosses = append(losses, \"invalid continuation supersession \"+id)\n   606\t\t\t\t}\n   607\t\t\t}\n   608\t\t\tif endpoints != 1 {\n   609\t\t\t\tlosses = append(losses, \"multiple continuation endpoints \"+id)\n   610\t\t\t}\n   611\t\t}\n   612\t\treturn uniqueSorted(losses)\n   613\t}\n   614\t\n   615\t// PendingReviewInterruptions returns only the latest interrupted endpoint of each\n   616\t// attempt; the public summaries deliberately contain no vendor session material.\n   617\tfunc (s Store) PendingReviewInterruptions() ([]ReviewRunSummary, []string) {\n   618\t\treturn s.reviewInterruptedRuns(false)\n   619\t}\n   620\t\n   621\tfunc (s Store) ReviewInterruptedRuns() ([]ReviewRunSummary, []string) {\n   622\t\treturn s.reviewInterruptedRuns(true)\n   623\t}\n   624\t\n   625\tfunc (s Store) reviewInterruptedRuns(includeContinued bool) ([]ReviewRunSummary, []string) {\n   626\t\truns, lost, e := s.ReadReviewRuns(\"\")\n   627\t\tif e != nil {\n   628\t\t\tlost = append(lost, e.Error())\n   629\t\t}\n   630\t\tcontinued := map[string]string{}\n   631\t\tfor _, r := range runs {\n   632\t\t\tif r.continues() != \"\" {\n   633\t\t\t\tcontinued[r.continues()] = r.RunID\n   634\t\t\t}\n   635\t\t}\n   636\t\tout := []ReviewRunSummary{}\n   637\t\tfor _, r := range runs {\n   638\t\t\tif r.Status == ReviewRunInterrupted && (includeContinued || continued[r.RunID] == \"\") {\n   639\t\t\t\tout = append(out, ReviewRunSummary{ResumedBy: continued[r.RunID], RunID: r.RunID, AttemptID: r.AttemptID, BundleID: r.BundleID, Adapter: r.Adapter, Status: r.Status, Partial: true, Interruption: r.Interruption, DraftDecision: \"unknown\", Assurance: \"partial-draft-not-review\"})\n   640\t\t\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"d6afd77e-24c1-4349-8b98-9f48110186a2","timestamp":"2026-11-27T22:06:27.501Z","tool_use_result":{"stdout":"   150\t\tif len(matches) != 1 || len(matches[0]) != 2 {\n   151\t\t\treturn \"\", fmt.Errorf(\"ambiguous adapter capture\")\n   152\t\t}\n   153\t\tvalue := matches[0][1]\n   154\t\tif len(value) == 0 || len(value) > 2048 || strings.ContainsAny(value, \"\\x00\\r\\n\") {\n   155\t\t\treturn \"\", fmt.Errorf(\"adapter capture is not a bounded reference\")\n   156\t\t}\n   157\t\treturn value, nil\n   158\t}\n   159\tfunc (s Store) saveReviewSession(value string) (string, error) {\n   160\t\tdigest := digestBytes([]byte(value))\n   161\t\tdir, e := ensureReviewArtifactDir(s.Root, reviewPrivateDir, true)\n   162\t\tif e != nil {\n   163\t\t\treturn \"\", e\n   164\t\t}\n   165\t\tif e = os.Chmod(dir, 0700); e != nil {\n   166\t\t\treturn \"\", e\n   167\t\t}\n   168\t\t// Private session files are runtime state, never published evidence.\n   169\t\tignore := filepath.Join(dir, \".gitignore\")\n   170\t\tif e = PublishFile(ignore, []byte(\"*\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); e != nil {\n   171\t\t\treturn \"\", e\n   172\t\t}\n   173\t\te = PublishFile(filepath.Join(dir, strings.TrimPrefix(digest, \"sha256:\")+\".session\"), []byte(value), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n   174\t\treturn digest, e\n   175\t}\n   176\tfunc (s Store) readReviewSession(digest string) (string, error) {\n   177\t\tif len(digest) != 71 || !strings.HasPrefix(digest, \"sha256:\") || strings.ContainsAny(digest, \"/\\\\\") {\n   178\t\t\treturn \"\", fmt.Errorf(\"invalid session digest\")\n   179\t\t}\n   180\t\tdir, e := ensureReviewArtifactDir(s.Root, reviewPrivateDir, false)\n   181\t\tif e != nil {\n   182\t\t\treturn \"\", e\n   183\t\t}\n   184\t\traw, e := readLedgerRaw(filepath.Join(dir, strings.TrimPrefix(digest, \"sha256:\")+\".session\"))\n   185\t\tif e != nil {\n   186\t\t\treturn \"\", e\n   187\t\t}\n   188\t\tif digestBytes(raw) != digest || len(raw) == 0 || len(raw) > 2048 {\n   189\t\t\treturn \"\", fmt.Errorf(\"private session digest differs\")\n   190\t\t}\n   191\t\treturn string(raw), nil\n   192\t}\n   193\tfunc (s Store) classifyReviewInterruption(run *ReviewRun, plan DispatchPlan, transcript []byte, runErr, ctxErr error) (string, string, error) {\n   194\t\t// Inspect both supported output channels before any public publication.\n   195\t\tchannels := append([]string{string(transcript), run.Output}, plan.extraChannels...)\n   196\t\tsessionChannels := make([]string, 0, len(channels))\n   197\t\tfor _, channel := range channels {\n   198\t\t\tcanonical, err := canonicalDelegationSessionChannel(plan.Config.Events, sessionPattern(plan.Config), channel)\n   199\t\t\tif err != nil {\n   200\t\t\t\treturn \"\", \"\", err\n   201\t\t\t}\n   202\t\t\tsessionChannels = append(sessionChannels, canonical)\n   203\t\t}\n   204\t\tvalue, e := captureReviewChannels(sessionPattern(plan.Config), sessionChannels...)\n   205\t\tif e != nil {\n   206\t\t\treturn \"\", \"\", e\n   207\t\t}\n   208\t\tif value != \"\" && plan.session != \"\" && value != plan.session {\n   209\t\t\treturn \"\", \"\", fmt.Errorf(\"adapter changed the captured session\")\n   210\t\t}\n   211\t\tif value == \"\" {\n   212\t\t\tvalue = plan.session\n   213\t\t}\n   214\t\tif value != \"\" {\n   215\t\t\trun.sessionForRedaction = value\n   216\t\t\trun.SessionDigest, e = s.saveReviewSession(value)\n   217\t\t\tif e != nil {\n   218\t\t\t\treturn \"\", \"\", e\n   219\t\t\t}\n   220\t\t}\n   221\t\tcause := \"\"\n   222\t\tif ctxErr != nil {\n   223\t\t\tcause = \"timeout\"\n   224\t\t\tif errors.Is(ctxErr, context.Canceled) {\n   225\t\t\t\tcause = \"cancelled\"\n   226\t\t\t}\n   227\t\t} else if runErr != nil && run.ExitCode < 0 {\n   228\t\t\tcause = \"process-lost\"\n   229\t\t}\n   230\t\tlimit := false\n   231\t\tif p := plan.Config.Limit; p != nil {\n   232\t\t\tfor _, code := range p.ExitCodes {\n   233\t\t\t\tif code == run.ExitCode {\n   234\t\t\t\t\tlimit = true\n   235\t\t\t\t}\n   236\t\t\t}\n   237\t\t\tfor _, pattern := range p.OutputPatterns {\n   238\t\t\t\tfor _, channel := range channels {\n   239\t\t\t\t\tif regexp.MustCompile(pattern).MatchString(channel) {\n   240\t\t\t\t\t\tlimit = true\n   241\t\t\t\t\t}\n   242\t\t\t\t}\n   243\t\t\t}\n   244\t\t}\n   245\t\tif limit {\n   246\t\t\tcause = \"usage-limit\"\n   247\t\t}\n   248\t\tsupervisorCause := cause\n   249\t\tif cause == \"\" {\n   250\t\t\tif runErr != nil {\n   251\t\t\t\treturn ReviewRunFailed, \"the reviewer command failed: \" + runErr.Error(), nil\n   252\t\t\t}\n   253\t\t\treturn \"\", \"\", nil\n   254\t\t}\n   255\t\t// Without any continuity declaration, interruption classification is unknown.\n   256\t\tif plan.Config.Limit == nil && plan.Config.Session == nil && plan.Config.Resume == nil {\n   257\t\t\tcause = \"unknown\"\n   258\t\t}\n   259\t\tinterruption := &ReviewInterruption{Cause: cause, Resumable: run.SessionDigest != \"\" && plan.Config.Resume != nil && len(plan.Config.Resume.Command) > 0}\n   260\t\tif cause == \"usage-limit\" {\n   261\t\t\treset, e := captureReviewChannels(resetPattern(plan.Config), channels...)\n   262\t\t\tif e != nil {\n   263\t\t\t\treturn \"\", \"\", e\n   264\t\t\t}\n   265\t\t\tif reset != \"\" {\n   266\t\t\t\tt, e := time.Parse(time.RFC3339Nano, reset)\n   267\t\t\t\tif e != nil {\n   268\t\t\t\t\treturn \"\", \"\", fmt.Errorf(\"adapter reset instant is not RFC3339\")\n   269\t\t\t\t}\n   270\t\t\t\tinterruption.ResetAt = t.UTC().Format(time.RFC3339Nano)\n   271\t\t\t}\n   272\t\t}\n   273\t\trun.Interruption = interruption\n   274\t\treturn ReviewRunInterrupted, \"review interrupted: \" + cause + \" (supervisor: \" + supervisorCause + \")\", nil\n   275\t}\n   276\tfunc validateContinuityRun(r ReviewRun) error {\n   277\t\tif r.Status == ReviewRunInterrupted {\n   278\t\t\tif r.Interruption == nil {\n   279\t\t\t\treturn fmt.Errorf(\"interrupted run has no cause\")\n   280\t\t\t}\n   281\t\t\tswitch r.Interruption.Cause {\n   282\t\t\tcase \"usage-limit\", \"timeout\", \"process-lost\", \"cancelled\", \"unknown\":\n   283\t\t\tdefault:\n   284\t\t\t\treturn fmt.Errorf(\"invalid interruption cause\")\n   285\t\t\t}\n   286\t\t\tif r.Interruption.ResetAt != \"\" {\n   287\t\t\t\tif _, e := time.Parse(time.RFC3339Nano, r.Interruption.ResetAt); e != nil {\n   288\t\t\t\t\treturn e\n   289\t\t\t\t}\n   290\t\t\t}\n   291\t\t\tif r.Interruption.Resumable && (r.SessionDigest == \"\" || r.TreeDigest == \"\" || r.AttemptID == \"\") {\n   292\t\t\t\treturn fmt.Errorf(\"resumable run lacks bound evidence\")\n   293\t\t\t}\n   294\t\t\tif r.PartialDigest != digestBytes([]byte(r.Output)) {\n   295\t\t\t\treturn fmt.Errorf(\"partial draft digest differs\")\n   296\t\t\t}\n   297\t\t} else if r.Interruption != nil {\n   298\t\t\treturn fmt.Errorf(\"terminal run contains interruption metadata\")\n   299\t\t}\n   300\t\treturn nil\n   301\t}\n   302\tfunc continuationPath(run string, result bool) string {\n   303\t\tsuffix := \".json\"\n   304\t\tif result {\n   305\t\t\tsuffix = \".result.json\"\n   306\t\t}\n   307\t\treturn filepath.ToSlash(filepath.Join(reviewContinuationsDir, run+suffix))\n   308\t}\n   309\tfunc (s Store) claimReviewContinuation(r ReviewRun, at time.Time) error {\n   310\t\traw, _ := json.Marshal(r)\n   311\t\t// Clear reader-only fields before deriving the predecessor digest.\n   312\t\tr.Path, r.SupersededBy = \"\", \"\"\n   313\t\traw, _ = json.Marshal(r)\n   314\t\tnonce := make([]byte, 16)\n   315\t\tif _, err := rand.Read(nonce); err != nil {\n   316\t\t\treturn err\n   317\t\t}\n   318\t\treturn publishLedgerJSON(s.Root, continuationPath(r.RunID, false), reviewContinuation{1, r.RunID, r.AttemptID, digestBytes(raw), at.UTC().Format(time.RFC3339Nano), hex.EncodeToString(nonce)})\n   319\t}\n   320\tfunc (s Store) finishReviewContinuation(r ReviewRun) error {\n   321\t\traw, _ := json.Marshal(r)\n   322\t\treceipt := reviewAttemptReceipt{1, r.AttemptID, r.RunID, digestBytes(raw)}\n   323\t\treturn publishLedgerJSON(s.Root, continuationPath(r.continues(), true), receipt)\n   324\t}\n   325\tfunc (s Store) existingReviewContinuation(r ReviewRun, runs []ReviewRun) (*ReviewRun, error) {\n   326\t\tvar claim reviewContinuation\n   327\t\te := readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, false)), &claim)\n   328\t\tif errors.Is(e, os.ErrNotExist) {\n   329\t\t\treturn nil, nil\n   330\t\t}\n   331\t\tif e != nil {\n   332\t\t\treturn nil, e\n   333\t\t}\n   334\t\tcopy := r\n   335\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n   336\t\traw, _ := json.Marshal(copy)\n   337\t\tif claim.SchemaVersion != 1 || claim.Predecessor != r.RunID || claim.AttemptID != r.AttemptID || claim.PredecessorDigest != digestBytes(raw) {\n   338\t\t\treturn nil, fmt.Errorf(\"continuation predecessor changed\")\n   339\t\t}\n   340\t\tvar receipt reviewAttemptReceipt\n   341\t\tif e = readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, true)), &receipt); e != nil {\n   342\t\t\treturn nil, &PendingReviewContinuation{ID: \"resume-of:\" + r.RunID, Predecessor: r.RunID, AttemptID: r.AttemptID}\n   343\t\t}\n   344\t\tfor _, next := range runs {\n   345\t\t\tif next.RunID == receipt.RunID {\n   346\t\t\t\tcopy := next\n   347\t\t\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n   348\t\t\t\traw, _ := json.Marshal(copy)\n   349\t\t\t\tif receipt.SchemaVersion != 1 || receipt.AttemptID != r.AttemptID || next.AttemptID != r.AttemptID || next.continues() != r.RunID || receipt.RunDigest != digestBytes(raw) {\n   350\t\t\t\t\treturn nil, fmt.Errorf(\"invalid continuation receipt\")\n   351\t\t\t\t}\n   352\t\t\t\treturn &next, nil\n   353\t\t\t}\n   354\t\t}\n   355\t\treturn nil, fmt.Errorf(\"continuation result is missing\")\n   356\t}\n   357\t\n   358\t// PlanReviewResume validates original evidence, policy and all accumulated budgets.\n   359\tfunc (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n   360\t\truns, lost, e := s.ReadReviewRuns(\"\")\n   361\t\tif e != nil {\n   362\t\t\treturn DispatchPlan{}, e\n   363\t\t}\n   364\t\tif len(lost) > 0 {\n   365\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume history incomplete: %v\", lost)\n   366\t\t}\n   367\t\tvar prior *ReviewRun\n   368\t\tfor i := range runs {\n   369\t\t\tif runs[i].RunID == id {\n   370\t\t\t\tprior = &runs[i]\n   371\t\t\t}\n   372\t\t}\n   373\t\tif prior == nil {\n   374\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume predecessor not found\")\n   375\t\t}\n   376\t\tif prior.Status != ReviewRunInterrupted || prior.Interruption == nil || !prior.Interruption.Resumable {\n   377\t\t\treturn DispatchPlan{}, fmt.Errorf(\"run is %s or not resumable\", prior.Status)\n   378\t\t}\n   379\t\tif why := s.reviewRunTranscriptIntact(*prior); why != \"\" {\n   380\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume: %s\", why)\n   381\t\t}\n   382\t\tpolicy, _, e := s.LoadReviewersPolicyFor(prior.Kind)\n   383\t\tif e != nil {\n   384\t\t\treturn DispatchPlan{}, e\n   385\t\t}\n   386\t\tconfig, ok := policy.Adapters[prior.Adapter]\n   387\t\tif !ok || config.Resume == nil || len(config.Resume.Command) == 0 {\n   388\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume adapter declaration missing\")\n   389\t\t}\n   390\t\tbrief, e := s.RenderReviewBriefMatching(prior.BundleID, prior.Kind, prior.BriefNotes, prior.BriefDigest)\n   391\t\tif e != nil {\n   392\t\t\treturn DispatchPlan{}, e\n   393\t\t}\n   394\t\tbundle, e := s.LoadReviewBundle(prior.BundleID)\n   395\t\tif e != nil {\n   396\t\t\treturn DispatchPlan{}, e\n   397\t\t}\n   398\t\tif brief.Digest != prior.BriefDigest || bundle.BundleDigest != prior.BundleDigest || bundle.Payload.Subject.Head != prior.SealedCommit {\n   399\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume bundle or brief digest changed\")\n   400\t\t}\n   401\t\torigin, e := dispatchWorktreeIdentity(s.Root)\n   402\t\tif e != nil {\n   403\t\t\treturn DispatchPlan{}, e\n   404\t\t}\n   405\t\tif prior.Safety != nil && prior.Safety.Operation.Outcome != OutcomeCompleted {\n   406\t\t\treturn DispatchPlan{}, fmt.Errorf(\"predecessor cleanup incomplete; refusing continuation beside possible orphan\")\n   407\t\t}\n   408\t\tplan := DispatchPlan{predecessor: prior, notes: prior.BriefNotes, Reason: prior.Reason, PolicyDigest: prior.PolicyDigest, OriginWorktree: origin, Adapter: prior.Adapter, Config: config, Brief: brief, Bundle: bundle, SealedCommit: prior.SealedCommit}\n   409\t\tcontinuationRound(&plan, *prior, false)\n   410\t\tif e = s.checkDispatchOrigin(plan); e != nil {\n   411\t\t\treturn DispatchPlan{}, e\n   412\t\t}\n   413\t\texisting, e := s.existingReviewContinuation(*prior, runs)\n   414\t\tif e != nil {\n   415\t\t\tvar pending *PendingReviewContinuation\n   416\t\t\tif errors.As(e, &pending) {\n   417\t\t\t\tplan.PendingContinuation = pending\n   418\t\t\t\treturn plan, nil\n   419\t\t\t}\n   420\t\t\treturn DispatchPlan{}, e\n   421\t\t}\n   422\t\tif existing != nil {\n   423\t\t\tif existing.HandsOffFrom == prior.RunID {\n   424\t\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was handed off to run %s; it is not resumed\", prior.RunID, existing.RunID)\n   425\t\t\t}\n   426\t\t\tplan.Existing = existing\n   427\t\t\treturn plan, nil\n   428\t\t}\n   429\t\t// Only a continuation still to start needs the attempt's runtime\n   430\t\t// directory free; a repeated resume returns the recorded one.\n   431\t\tif e = reviewRunRuntimeDirFree(runtimeSourceOf(*prior), \"resume\"); e != nil {\n   432\t\t\t// Another resume takes the directory just before its claim: a claim\n   433\t\t\t// that appears meanwhile makes this one pending (spec\n   434\t\t\t// pose-review-resume-runtime-dir-followups R1).\n   435\t\t\texisting, pending := s.awaitContinuationClaim(context.Background(), *prior)\n   436\t\t\tif pending !=