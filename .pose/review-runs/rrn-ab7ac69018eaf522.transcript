{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L6PBzJceUrszy5DWQq5t2F","type":"tool_result","content":"   600\t\t}\n   601\t\ts.planImplementation(&plan, \"\")\n   602\t\tplan.provenance, err = s.prepareRunProvenance(plan, policy)\n   603\t\tif err != nil {\n   604\t\t\treturn DispatchPlan{}, err\n   605\t\t}\n   606\t\treturn plan, nil\n   607\t}\n   608\t\n   609\t// ErrNoReviewerAdapter means the project configured no reviewer.\n   610\tvar ErrNoReviewerAdapter = errors.New(\"pose: no agent is configured in .pose/policy/delegation.json\")\n   611\t\n   612\t// RunReviewDispatch executes plan and records the run, failed or completed.\n   613\tfunc (s Store) RunReviewDispatch(plan DispatchPlan, now func() time.Time) (ReviewRun, error) {\n   614\t\treturn s.RunReviewDispatchContext(context.Background(), plan, now)\n   615\t}\n   616\t\n   617\t// RunReviewDispatchContext also propagates caller cancellation to the covered\n   618\t// process set. Cleanup has its own bounded context and never respawns the adapter.\n   619\tfunc (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPlan, now func() time.Time) (result ReviewRun, resultErr error) {\n   620\t\tif err := parent.Err(); err != nil {\n   621\t\t\treturn ReviewRun{}, err\n   622\t\t}\n   623\t\tif why := routingAgainstAnotherBundle(plan); why != \"\" {\n   624\t\t\treturn ReviewRun{}, errors.New(\"pose: \" + why)\n   625\t\t}\n   626\t\t// pose delegate cancel stops the run through this context (R13).\n   627\t\tparent, cancelRun := context.WithCancel(parent)\n   628\t\tdefer cancelRun()\n   629\t\tvar cancelled *atomic.Bool\n   630\t\tif plan.PendingContinuation != nil {\n   631\t\t\treturn ReviewRun{}, plan.PendingContinuation\n   632\t\t}\n   633\t\tif plan.Existing != nil {\n   634\t\t\tif plan.predecessor == nil {\n   635\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation lacks predecessor\")\n   636\t\t\t}\n   637\t\t\tfresh, err := s.replanContinuation(plan)\n   638\t\t\tif err != nil {\n   639\t\t\t\treturn ReviewRun{}, err\n   640\t\t\t}\n   641\t\t\tif fresh.Existing == nil {\n   642\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation disappeared\")\n   643\t\t\t}\n   644\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   645\t\t}\n   646\t\tif _, _, err := reviewAdapterEnvironment(plan.Config, \"\", plan.Brief.Text, plan.notes); err != nil {\n   647\t\t\treturn ReviewRun{}, err\n   648\t\t}\n   649\t\trun := ReviewRun{Provenance: plan.provenance, BriefNotes: plan.notes, LimitOf: plan.LimitOf, SchemaVersion: 1, Scope: plan.Brief.Scope, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest,\n   650\t\t\tSealedCommit: plan.SealedCommit, Kind: plan.Brief.Kind, BriefDigest: plan.Brief.Digest, Adapter: plan.Adapter,\n   651\t\t\tVendor: plan.Config.Vendor, Model: plan.Config.Model, Reason: plan.Reason, PolicyDigest: plan.PolicyDigest, StartedAt: now().UTC().Format(time.RFC3339Nano), ExitCode: -1,\n   652\t\t\tLabel: plan.Label, Purpose: plan.Purpose, Lead: plan.Lead, Events: plan.Config.Events, Routing: plan.Routing, Round: plan.round, Thread: plan.thread}\n   653\t\timpl := plan.Implementation()\n   654\t\trun.IndependenceAchieved = AchievedIndependence(impl.Vendor, impl.Model, plan.Config.Vendor, plan.Config.Model)\n   655\t\tsafety, err := ResolveReviewerContainment(plan.Config)\n   656\t\tif err != nil {\n   657\t\t\treturn ReviewRun{}, err\n   658\t\t}\n   659\t\tif err := validateReviewNotes(plan.notes); err != nil {\n   660\t\t\treturn ReviewRun{}, err\n   661\t\t}\n   662\t\trun.Safety = safety\n   663\t\tvar cleanup func() error\n   664\t\t// The runtime directory a continuation took before its claim.\n   665\t\tpreparedRuntimeDir := \"\"\n   666\t\tvar cleanupErr error\n   667\t\tvar terminationFailed bool\n   668\t\tcleaned := false\n   669\t\tdoCleanup := func() {\n   670\t\t\tif cleaned {\n   671\t\t\t\treturn\n   672\t\t\t}\n   673\t\t\tcleaned = true\n   674\t\t\toutcome := NewOperationResult(\"review.dispatch.cleanup\", run.Scope)\n   675\t\t\toutcome.StepsRun = append(outcome.StepsRun, OperationStep{ID: \"cleanup\", Result: \"done\"})\n   676\t\t\tif terminationFailed {\n   677\t\t\t\tcleanupErr = fmt.Errorf(\"process termination incomplete; runtime resources retained\")\n   678\t\t\t} else if cleanup != nil {\n   679\t\t\t\tcleanupErr = cleanup()\n   680\t\t\t}\n   681\t\t\tif cleanupErr != nil {\n   682\t\t\t\toutcome.StepsRun[0].Result = \"failed\"\n   683\t\t\t\toutcome.Fail(OutcomeFailed, \"cleanup\", \"cleanup-incomplete\", cleanupErr.Error())\n   684\t\t\t\toutcome.Unconfirmed = []OperationUncertain{{Step: \"cleanup\", Reason: \"owned resources may remain; no automatic respawn\"}}\n   685\t\t\t} else {\n   686\t\t\t\toutcome.Outcome = OutcomeCompleted\n   687\t\t\t}\n   688\t\t\trun.Safety.Operation = outcome\n   689\t\t}\n   690\t\tdefer func() {\n   691\t\t\tdoCleanup()\n   692\t\t\tif cleanupErr != nil {\n   693\t\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n   694\t\t\t}\n   695\t\t}()\n   696\t\ttranscript := []byte{}\n   697\t\tfinish := func(status, failure string) (ReviewRun, error) {\n   698\t\t\tif cleanup == nil && preparedRuntimeDir != \"\" {\n   699\t\t\t\t// The continuation took its directory before the claim and fails\n   700\t\t\t\t// before it owns its cleanup: nothing is in it yet (review round\n   701\t\t\t\t// 1, N1).\n   702\t\t\t\t_ = os.Remove(preparedRuntimeDir)\n   703\t\t\t}\n   704\t\t\tdoCleanup()\n   705\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n   706\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n   707\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n   708\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n   709\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n   710\t\t\t}\n   711\t\t\trun.sessionForRedaction = \"\"\n   712\t\t\trun.Status, run.Failure = status, failure\n   713\t\t\tif status != ReviewRunInterrupted {\n   714\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n   715\t\t\t}\n   716\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n   717\t\t\treturn s.recordReviewRun(run, transcript)\n   718\t\t}\n   719\t\t// Recompute semantic freshness at execution time, not just preview time.\n   720\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n   721\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   722\t\t}\n   723\t\tvar attempt DelegatedReviewAttempt\n   724\t\tif plan.predecessor == nil {\n   725\t\t\tvar err error\n   726\t\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n   727\t\t\tif err != nil {\n   728\t\t\t\treturn ReviewRun{}, err\n   729\t\t\t}\n   730\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n   731\t\t} else {\n   732\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n   733\t\t\tfresh, err := s.replanContinuation(plan)\n   734\t\t\tif err != nil {\n   735\t\t\t\treturn ReviewRun{}, err\n   736\t\t\t}\n   737\t\t\tif fresh.PendingContinuation != nil {\n   738\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n   739\t\t\t}\n   740\t\t\tif fresh.Existing != nil {\n   741\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   742\t\t\t}\n   743\t\t\tplan = fresh\n   744\t\t\trun.Provenance = fresh.provenance\n   745\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n   746\t\t\tif fresh.handoff {\n   747\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n   748\t\t\t} else {\n   749\t\t\t\trun.Resumes = fresh.predecessor.RunID\n   750\t\t\t}\n   751\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n   752\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n   753\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n   754\t\t\t// The attempt's runtime directory is taken before the claim, and is\n   755\t\t\t// the lock: a resume that cannot take it claims nothing, so the\n   756\t\t\t// predecessor stays resumable, and one that lost the race to another\n   757\t\t\t// resume is told the continuation is pending (spec\n   758\t\t\t// pose-review-resume-runtime-dir-followups R1).\n   759\t\t\tdir, err := s.takeContinuationRuntimeDir(parent, plan)\n   760\t\t\tvar recorded *continuationRecorded\n   761\t\t\tif errors.As(err, &recorded) {\n   762\t\t\t\treturn existingReviewDispatchResult(recorded.run)\n   763\t\t\t}\n   764\t\t\tif err != nil {\n   765\t\t\t\treturn ReviewRun{}, err\n   766\t\t\t}\n   767\t\t\tpreparedRuntimeDir = dir\n   768\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n   769\t\t\t\tif dir != \"\" {\n   770\t\t\t\t\t_ = os.Remove(dir)\n   771\t\t\t\t}\n   772\t\t\t\t// Another resume claimed and may already have ended: its record\n   773\t\t\t\t// is the answer, not the publication conflict (R1).\n   774\t\t\t\tif again, rerr := s.replanContinuation(plan); rerr == nil {\n   775\t\t\t\t\tif again.Existing != nil {\n   776\t\t\t\t\t\treturn existingReviewDispatchResult(*again.Existing)\n   777\t\t\t\t\t}\n   778\t\t\t\t\tif again.PendingContinuation != nil {\n   779\t\t\t\t\t\treturn ReviewRun{}, again.PendingContinuation\n   780\t\t\t\t\t}\n   781\t\t\t\t}\n   782\t\t\t\treturn ReviewRun{}, err\n   783\t\t\t}\n   784\t\t}\n   785\t\t// The attempt result is published once: before the active marker goes\n   786\t\t// when the run was marked, at return otherwise (spec\n   787\t\t// pose-delegation-result-before-marker R1–R2).\n   788\t\tresultPublished := false\n   789\t\treserved := plan.predecessor != nil\n   790\t\tpublishResult := func() {\n   791\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n   792\t\t\t\treturn\n   793\t\t\t}\n   794\t\t\tresultPublished = true\n   795\t\t\tbeforeRunResultPublished(result)\n   796\t\t\tvar err error\n   797\t\t\tif plan.predecessor == nil {\n   798\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   799\t\t\t} else {\n   800\t\t\t\terr = s.finishReviewContinuation(result)\n   801\t\t\t}\n   802\t\t\tif err != nil {\n   803\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n   804\t\t\t}\n   805\t\t}\n   806\t\tdefer publishResult()\n   807\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n   808\t\tif err != nil {\n   809\t\t\tif plan.predecessor == nil {\n   810\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n   811\t\t\t\t// receipt are recorded against it, as before the marker moved\n   812\t\t\t\t// ahead of the reservation (spec\n   813\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n   814\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n   815\t\t\t\t\treturn ReviewRun{}, perr\n   816\t\t\t\t}\n   817\t\t\t\treserved = true\n   818\t\t\t}\n   819\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   820\t\t}\n   821\t\tif plan.predecessor == nil {\n   822\t\t\tbeforeAttemptPublished(s, attempt)\n   823\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n   824\t\t\t\tstopActive()\n   825\t\t\t\treturn ReviewRun{}, err\n   826\t\t\t}\n   827\t\t\treserved = true\n   828\t\t}\n   829\t\t// The marker goes only once the record and the attempt result are\n   830\t\t// published: without them it is the one trace of the reserved attempt,\n   831\t\t// and a waiter that sees it gone must find the receipt.\n   832\t\tdefer func() {\n   833\t\t\tpublishResult()\n   834\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n   835\t\t}()\n   836\t\tcancelled = cancelFlag\n   837\t\t// A detached run that cannot hand its attempt back stops here: nobody\n   838\t