unc (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPlan, now func() time.Time) (result ReviewRun, resultErr error) {\n   620\t\tif err := parent.Err(); err != nil {\n   621\t\t\treturn ReviewRun{}, err\n   622\t\t}\n   623\t\tif why := routingAgainstAnotherBundle(plan); why != \"\" {\n   624\t\t\treturn ReviewRun{}, errors.New(\"pose: \" + why)\n   625\t\t}\n   626\t\t// pose delegate cancel stops the run through this context (R13).\n   627\t\tparent, cancelRun := context.WithCancel(parent)\n   628\t\tdefer cancelRun()\n   629\t\tvar cancelled *atomic.Bool\n   630\t\tif plan.PendingContinuation != nil {\n   631\t\t\treturn ReviewRun{}, plan.PendingContinuation\n   632\t\t}\n   633\t\tif plan.Existing != nil {\n   634\t\t\tif plan.predecessor == nil {\n   635\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation lacks predecessor\")\n   636\t\t\t}\n   637\t\t\tfresh, err := s.replanContinuation(plan)\n   638\t\t\tif err != nil {\n   639\t\t\t\treturn ReviewRun{}, err\n   640\t\t\t}\n   641\t\t\tif fresh.Existing == nil {\n   642\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation disappeared\")\n   643\t\t\t}\n   644\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   645\t\t}\n   646\t\tif _, _, err := reviewAdapterEnvironment(plan.Config, \"\", plan.Brief.Text, plan.notes); err != nil {\n   647\t\t\treturn ReviewRun{}, err\n   648\t\t}\n   649\t\trun := ReviewRun{Provenance: plan.provenance, BriefNotes: plan.notes, LimitOf: plan.LimitOf, SchemaVersion: 1, Scope: plan.Brief.Scope, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest,\n   650\t\t\tSealedCommit: plan.SealedCommit, Kind: plan.Brief.Kind, BriefDigest: plan.Brief.Digest, Adapter: plan.Adapter,\n   651\t\t\tVendor: plan.Config.Vendor, Model: plan.Config.Model, Reason: plan.Reason, PolicyDigest: plan.PolicyDigest, StartedAt: now().UTC().Format(time.RFC3339Nano), ExitCode: -1,\n   652\t\t\tLabel: plan.Label, Purpose: plan.Purpose, Lead: plan.Lead, Events: plan.Config.Events, Routing: plan.Routing, Round: plan.round, Thread: plan.thread}\n   653\t\timpl := plan.Implementation()\n   654\t\trun.IndependenceAchieved = AchievedIndependence(impl.Vendor, impl.Model, plan.Config.Vendor, plan.Config.Model)\n   655\t\tsafety, err := ResolveReviewerContainment(plan.Config)\n   656\t\tif err != nil {\n   657\t\t\treturn ReviewRun{}, err\n   658\t\t}\n   659\t\tif err := validateReviewNotes(plan.notes); err != nil {\n   660\t\t\treturn ReviewRun{}, err\n   661\t\t}\n   662\t\trun.Safety = safety\n   663\t\tvar cleanup func() error\n   664\t\t// The runtime directory a continuation took before its claim.\n   665\t\tpreparedRuntimeDir := \"\"\n   666\t\tvar cleanupErr error\n   667\t\tvar terminationFailed bool\n   668\t\tcleaned := false\n   669\t\tdoCleanup := func() {\n   670\t\t\tif cleaned {\n   671\t\t\t\treturn\n   672\t\t\t}\n   673\t\t\tcleaned = true\n   674\t\t\toutcome := NewOperationResult(\"review.dispatch.cleanup\", run.Scope)\n   675\t\t\toutcome.StepsRun = append(outcome.StepsRun, OperationStep{ID: \"cleanup\", Result: \"done\"})\n   676\t\t\tif terminationFailed {\n   677\t\t\t\tcleanupErr = fmt.Errorf(\"process termination incomplete; runtime resources retained\")\n   678\t\t\t} else if cleanup != nil {\n   679\t\t\t\tcleanupErr = cleanup()\n   680\t\t\t}\n   681\t\t\tif cleanupErr != nil {\n   682\t\t\t\toutcome.StepsRun[0].Result = \"failed\"\n   683\t\t\t\toutcome.Fail(OutcomeFailed, \"cleanup\", \"cleanup-incomplete\", cleanupErr.Error())\n   684\t\t\t\toutcome.Unconfirmed = []OperationUncertain{{Step: \"cleanup\", Reason: \"owned resources may remain; no automatic respawn\"}}\n   685\t\t\t} else {\n   686\t\t\t\toutcome.Outcome = OutcomeCompleted\n   687\t\t\t}\n   688\t\t\trun.Safety.Operation = outcome\n   689\t\t}\n   690\t\tdefer func() {\n   691\t\t\tdoCleanup()\n   692\t\t\tif cleanupErr != nil {\n   693\t\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n   694\t\t\t}\n   695\t\t