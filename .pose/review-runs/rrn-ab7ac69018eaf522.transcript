n    33\t\t\tt.Fatal(runs, lost, e)\n    34\t\t}\n    35\t\treturn root, s, runs[0]\n    36\t}\n    37\tfunc TestRunContinuityInterruptedResumeAndAccounting(t *testing.T) {\n    38\t\troot, s, prior := runContinuityFixture(t)\n    39\t\tif prior.PartialDigest == \"\" || prior.Interruption.Cause != \"usage-limit\" || !prior.Interruption.Resumable {\n    40\t\t\tt.Fatalf(\"partial: %+v\", prior)\n    41\t\t}\n    42\t\tfor _, path := range []string{prior.Path, prior.TranscriptPath} {\n    43\t\t\traw, e := os.ReadFile(filepath.Join(root, path))\n    44\t\t\tif e != nil || strings.Contains(string(raw), \"fixture-private-session\") {\n    45\t\t\t\tt.Fatal(\"session leaked\", path, e)\n    46\t\t\t}\n    47\t\t}\n    48\t\tif code, out := runPose(t, root, \"delegate\", \"ls\"); code != 0 || !strings.Contains(out, \"cause=usage-limit\") || !strings.Contains(out, \"partial=true\") || strings.Contains(out, \"fixture-private-session\") {\n    49\t\t\tt.Fatal(code, out)\n    50\t\t}\n    51\t\tmetrics, e := s.Insights(\"workflow\", 0)\n    52\t\tif e != nil || metrics.DelegatedReview.ByBundle[0].RejectingDrafts != 0 {\n    53\t\t\tt.Fatal(\"partial counted as verdict\", e)\n    54\t\t}\n    55\t\tif _, e = s.PlanReviewResume(prior.RunID); e != nil {\n    56\t\t\tt.Fatal(e)\n    57\t\t}\n    58\t\tcode, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID)\n    59\t\tif code != 0 || !strings.Contains(out, \"status=completed\") {\n    60\t\t\tt.Fatal(code, out)\n    61\t\t}\n    62\t\truns, lost, e := s.ReadReviewRuns(\"\")\n    63\t\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n    64\t\t\tt.Fatal(len(runs), lost, e)\n    65\t\t}\n    66\t\tvar completed posemodel.ReviewRun\n    67\t\tfor _, r := range runs {\n    68\t\t\tif r.Status == posemodel.ReviewRunCompleted {\n    69\t\t\t\tcompleted = r\n    70\t\t\t}\n    71\t\t}\n    72\t\tif completed.Resumes != prior.RunID || completed.AttemptID != prior.AttemptID || completed.BriefDigest != prior.BriefDigest || com