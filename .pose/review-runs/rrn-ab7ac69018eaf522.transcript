nuityConcurrentResumeLaunchesOnce(t *testing.T) {\n   262\t\tmarker := filepath.Join(t.TempDir(), \"launches\")\n   263\t\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n   264\t\t\ta.Resume.Command = []string{\"sh\", \"-c\", `printf 'start\\n' >> \"$2\"; sleep 0.05; printf 'decision: approved\\n'`, \"sh\", \"{session}\", marker}\n   265\t\t})\n   266\t\tplan, e := s.PlanReviewResume(r.RunID)\n   267\t\tif e != nil {\n   268\t\t\tt.Fatal(e)\n   269\t\t}\n   270\t\tvar wg sync.WaitGroup\n   271\t\tfor i := 0; i < 8; i++ {\n   272\t\t\twg.Add(1)\n   273\t\t\tgo func() { defer wg.Done(); _, _ = s.RunReviewDispatch(plan, time.Now) }()\n   274\t\t}\n   275\t\twg.Wait()\n   276\t\traw, e := os.ReadFile(marker)\n   277\t\tif e != nil || string(raw) != \"start\\n\" {\n   278\t\t\tt.Fatalf(\"duplicate launches %q %v\", raw, e)\n   279\t\t}\n   280\t\truns, lost, e := s.ReadReviewRuns(\"\")\n   281\t\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n   282\t\t\tt.Fatal(len(runs), lost, e)\n   283\t\t}\n   284\t}\n   285\tfunc TestRunContinuityObservedProcessLoss(t *testing.T) {\n   286\t\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n   287\t\t\ta.Command = []string{\"sh\", \"-c\", `printf 'session: fixture-private-session\\n'; kill -KILL $$`}\n   288\t\t})\n   289\t\tif r.Interruption.Cause != \"process-lost\" || !r.Interruption.Resumable {\n   290\t\t\tt.Fatal(r.Interruption)\n   291\t\t}\n   292\t\tif _, e := s.PlanReviewResume(r.RunID); e != nil {\n   293\t\t\tt.Fatal(e)\n   294\t\t}\n   295\t}\n   296\t\n   297\t// Spec pose-review-resume-keeps-the-sealed-checkout R1, R2: a resumed session\n   298\t// works in the sealed checkout it saw before the interruption, recreated at\n   299\t// the same path after the interrupted run removed it.\n   300\tfunc TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath(t *testing.T) {\n   301\t\tmarks := t.TempDir()\n   302\t\tfirst := filepath.Join(marks, \"first\")\n   303\t\troot, _, prior := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n   304\t\t\ta.Command = []string{\"sh\", \"-c\", `pwd > \"$1\"; printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\ndecision: rejected\\n'; exit 75`, \"sh\", first}\n   305\t\t\ta.Resume.Command = []string{\"sh\", \"-c\", `test \"$(pwd)\" = \"$(cat \"$1\")\" || { echo \"moved from $(cat \"$1\") to $(pwd)\" >&2; exit 3; }; test -f .pose/specs/alpha/spec.md || exit 4; printf 'decision: approved\\n'`, \"sh\", first, \"{session}\"}\n   306\t\t})\n   307\t\traw, err := os.ReadFile(first)\n   308\t\tif err != nil {\n   309\t\t\tt.Fatal(err)\n   310\t\t}\n   311\t\tcheckout := strings.TrimSpace(string(raw))\n   312\t\tif _, err := os.Stat(checkout); !os.IsNotExist(err) {\n   313\t\t\tt.Fatalf(\"the interrupted run left its checkout %s behind: %v\", checkout, err)\n   314\t\t}\n   315\t\t// Review round 1, N1: a leftover runtime directory refuses the resume\n   316\t\t// before it is claimed, so removing it restores the resume.\n   317\t\truntimeDir := filepath.Dir(checkout)\n   318\t\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n   319\t\t\tt.Fatal(err)\n   320\t\t}\n   321\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID); code == 0 || !strings.Contains(out, \"then resume again\") {\n   322\t\t\tt.Fatalf(\"a resume beside a leftover runtime directory: %d %s\", code, out)\n   323\t\t}\n   324\t\t// Review round 2, N6: a handoff is refused the same way, before it\n   325\t\t// claims the interrupted run.\n   326\t\tif _, err := (posemodel.Store{Root: root}).PlanReviewHandoff(prior.RunID, \"other\"); err == nil || !strings.Contains(err.Error(), \"still exists\") || !strings.Contains(err.Error(), \"then hand off again\") {\n   327\t\t\tt.Fatalf(\"a handoff beside a leftover runtime directory: %v\", err)\n   328\t\t}\n   329\t\tif err := os.Remove(runtimeDir); err != nil {\n   330\t\t\tt.Fatal(err)\n   331\t\t}\n   332\t\t// Spec pose-rev