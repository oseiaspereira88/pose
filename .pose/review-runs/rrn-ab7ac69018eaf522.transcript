oundCheckoutHeld(prior ReviewRun) string {\n \tdir, ok := reviewRunRuntimeDirPath(runtimeSourceOf(prior))\n \tif !ok {\n-\t\treturn false\n+\t\treturn \"\"\n \t}\n-\t_, err := os.Lstat(dir)\n-\treturn err == nil\n+\tif _, err := os.Lstat(dir); errors.Is(err, os.ErrNotExist) {\n+\t\treturn \"\"\n+\t}\n+\treturn dir\n }\ndiff --git a/pose-mcp/internal/pose/review_run_continuity.go b/pose-mcp/internal/pose/review_run_continuity.go\nindex 77ac8f69..7946ebdb 100644\n--- a/pose-mcp/internal/pose/review_run_continuity.go\n+++ b/pose-mcp/internal/pose/review_run_continuity.go\n@@ -432,10 +432,17 @@ func (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n \t\t// Another resume takes the directory just before its claim: a claim\n \t\t// that appears meanwhile makes this one pending (spec\n \t\t// pose-review-resume-runtime-dir-followups R1).\n-\t\tif pending := s.awaitContinuationClaim(*prior); pending != nil {\n+\t\texisting, pending := s.awaitContinuationClaim(context.Background(), *prior)\n+\t\tif pending != nil {\n \t\t\tplan.PendingContinuation = pending\n \t\t\treturn plan, nil\n \t\t}\n+\t\tif existing != nil {\n+\t\t\t// Another resume ended meanwhile: its record is the answer\n+\t\t\t// (spec pose-review-resume-residuals R1).\n+\t\t\tplan.Existing = existing\n+\t\t\treturn plan, nil\n+\t\t}\n \t\treturn DispatchPlan{}, e\n \t}\n \t// The attempt's budget, not this agent's: after a handoff the resumed\ndiff --git a/pose-mcp/internal/pose/review_run_runtime_dir_test.go b/pose-mcp/internal/pose/review_run_runtime_dir_test.go\nindex 4aef8d6c..a2f02216 100644\n--- a/pose-mcp/internal/pose/review_run_runtime_dir_test.go\n+++ b/pose-mcp/internal/pose/review_run_runtime_dir_test.go\n@@ -1,10 +1,12 @@\n package pose\n \n import (\n+\t\"context\"\n \t\"os\"\n \t\"path/filepath\"\n \t\"strings\"\n \t\"testing\"\n+\t\"time\"\n )\n \n // Spec pose-review-resume-keeps-the-sealed-checkout R3: the attempt's\n@@ -95,11 +97,11 @@ func TestRunContinuityTakesTheRuntimeDirectoryBeforeTheClaim(t *testing.T) {\n \ts := Store{Root: t.TempDir()}\n \tprior := ReviewRun{RunID: \"rrn-prior\", AttemptID: \"rat-\" + strings.Repeat(\"ab\", 32)}\n \tplan := DispatchPlan{predecessor: &prior}\n-\tdir, err := s.takeContinuationRuntimeDir(plan)\n+\tdir, err := s.takeContinuationRuntimeDir(context.Background(), plan)\n \tif err != nil || dir == \"\" {\n \t\tt.Fatalf(\"a free directory was not taken: %q %v\", dir, err)\n \t}\n-\tif _, err := s.takeContinuationRuntimeDir(plan); err == nil || !strings.Contains(err.Error(), \"already exists\") {\n+\tif _, err := s.takeContinuationRuntimeDir(context.Background(), plan); err == nil || !strings.Contains(err.Error(), \"already exists\") {\n \t\tt.Fatalf(\"a taken directory was shared: %v\", err)\n \t}\n \tif entries, _ := os.ReadDir(filepath.Join(s.Root, \".pose\")); len(entries) != 0 {\n@@ -115,14 +117,41 @@ func TestRunContinuityARoundDoesNotContinueIntoAHeldPath(t *testing.T) {\n \t\tt.Setenv(name, tmp)\n \t}\n \tprior := ReviewRun{RunID: \"rrn-prior\", AttemptID: \"rat-\" + strings.Repeat(\"ab\", 32)}\n-\tif previousRoundCheckoutHeld(prior) {\n+\tif previousRoundCheckoutHeld(prior) != \"\" {\n \t\tt.Fatal(\"a free path was taken for held\")\n \t}\n \tdir, _ := reviewRunRuntimeDirPath(runtimeSourceOf(prior))\n \tif err := os.Mkdir(dir, 0o700); err != nil {\n \t\tt.Fatal(err)\n \t}\n-\tif !previousRoundCheckoutHeld(prior) {\n+\tif previousRoundCheckoutHeld(prior) == \"\" {\n \t\tt.Fatal(\"a held path was taken for free\")\n \t}\n }\n+\n+// Spec pose-review-resume-residuals R1, R4: the wait for a claim stops with\n+// its context, and a path that cannot be checked counts as held.\n+func TestRunContinuityTheClaimWaitStopsAndHeldPathsAreNamed(t *testing.T) {\n+\tctx, cancel := context.WithCancel(context.Background())\n+\tcancel()\n+\tstarted := time.Now()\n+\texisting, pending := Store{Root: t.TempDir()}.awaitContinuationClaim(ctx, ReviewRun{RunID: \"rrn-x\"})\n+\tif existing != nil || pending != nil || time.Since(started) > time.Second {\n+\t\tt.Fatalf(\"a cancelled wait: %v %v after %s\", existing, pending, time.Since(started))\n+\t}\n+\ttmp := t.TempDir()\n+\tfor _, name := range []string{\"TMPDIR\", \"TMP\", \"TEMP\"} {\n+\t\tt.Setenv(name, tmp)\n+\t}\n+\tprior := ReviewRun{RunID: \"rrn-p\", AttemptID: \"rat-\" + strings.Repeat(\"ab\", 32)}\n+\tif got := previousRoundCheckoutHeld(prior); got != \"\" {\n+\t\tt.Fatalf(\"a free path: %s\", got)\n+\t}\n+\tdir, _ := reviewRunRuntimeDirPath(runtimeSourceOf(prior))\n+\tif err := os.Mkdir(dir, 0o700); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif got := previousRoundCheckoutHeld(prior); got != dir {\n+\t\tt.Fatalf(\"the held path is not named: %q\", got)\n+\t}\n+}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HYNuoTkiNXXmTXe4q5Bit8","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
