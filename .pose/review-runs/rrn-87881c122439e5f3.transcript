{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018MHjg8Xd5yqGtQtqS7hg9y","type":"tool_result","content":"package pose\n\n// Accepted limits (spec pose-review-declared-threat-model): a spec declares\n// the residual limits of a guarantee it makes, each with a stable id and why\n// it is accepted. The review plan seals them; the brief lists them; a\n// reviewer classifies a finding that falls inside one as within that limit,\n// or disputes the limit as a finding of its own. A declared limit never\n// hides a defect inside the declared scope: it is visible in the bundle, the\n// brief and the attestation.\n\nimport (\n\t\"regexp\"\n\t\"strings\"\n)\n\n// ReviewAcceptedLimit is one declared residual limit.\ntype ReviewAcceptedLimit struct {\n\tID   string `json:\"id\"`\n\tText string `json:\"text\"`\n\t// Spec names the spec that declared the limit when the scope holds more\n\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n\tSpec string `json:\"spec,omitempty\"`\n}\n\nvar acceptedLimitRE = regexp.MustCompile(`^[-*]\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n\n// acceptedLimitMarkerRE finds the marker where a sentence opens, after the\n// assumption: \"<assumption>. Accepted because <reason>.\" A marker inside a\n// sentence (\"Not accepted because\") is not one (review round 3, N1).\nvar acceptedLimitMarkerRE = regexp.MustCompile(`[.;:!?]\\s+(?:Accepted because|Aceito porque)\\s+`)\n\n// acceptedLimitReasonWordRE is a word with at least one letter.\nvar acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n\n// hasAcceptedLimitReason reads an entry as written: an assumption of at\n// least two words, then the marker opening a sentence, then a reason of at\n// least two words in that same sentence. A marker alone, punctuation, a\n// missing assumption or a reason borrowed from a later sentence does not say\n// why a limit is accepted (review rounds 1–4).\nfunc hasAcceptedLimitReason(text string) bool {\n\tloc := acceptedLimitMarkerRE.FindStringIndex(text)\n\tif loc == nil {\n\t\treturn false\n\t}\n\tassumption, rest := text[:loc[0]], text[loc[1]:]\n\tif end := strings.IndexAny(rest, \".;!?\"); end >= 0 {\n\t\trest = rest[:end]\n\t}\n\treturn len(acceptedLimitReasonWordRE.FindAllString(assumption, -1)) >= 2 && len(acceptedLimitReasonWordRE.FindAllString(rest, -1)) >= 2\n}\n\n// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n// It returns the limits and the problems that keep the section from being\n// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n// limit that does not say why it is accepted (\"Accepted because ...\" or\n// \"Aceito porque ...\").\nfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n\tvar limits []ReviewAcceptedLimit\n\tvar problems []string\n\tin := false\n\tseen := map[string]bool{}\n\t// An entry is one Markdown list item: it may wrap over indented lines,\n\t// including after a blank line, and it ends at an unindented line or the\n\t// next item\n\t// (review rounds 8 N1 and 9 N2). Fenced blocks and HTML comments are not\n\t// the spec's declarations, so examples there are never sealed (round 8\n\t// N2); a fence closes only with its own marker, at least as long.\n\ttype entry struct{ id, text string }\n\tvar entries []entry\n\topen := false\n\tfence := \"\"\n\tfor _, line := range strings.Split(stripHTMLComments(body), \"\\n\") {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif marker := fenceMarker(trimmed); marker != \"\" {\n\t\t\tswitch {\n\t\t\tcase fence == \"\":\n\t\t\t\tfence = marker\n\t\t\tcase marker[0] == fence[0] && len(marker) >= len(fence) && strings.TrimLeft(trimmed, marker[:1]) == \"\":\n\t\t\t\tfence = \"\"\n\t\t\t}\n\t\t\topen = false\n\t\t\tcontinue\n\t\t}\n\t\tif fence != \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tindented := trimmed != \"\" && (strings.HasPrefix(line, \" \") || strings.HasPrefix(line, \"\\t\"))\n\t\tif !indented && strings.HasPrefix(trimmed, \"#\") {\n\t\t\theading := strings.TrimSpace(strings.TrimLeft(trimmed, \"#\"))\n\t\t\tin = strings.EqualFold(heading, \"Accepted limits\") || strings.EqualFold(heading, \"Limites aceitos\")\n\t\t\topen = false\n\t\t\tcontinue\n\t\t}\n\t\tif !in {\n\t\t\tcontinue\n\t\t}\n\t\tswitch {\n\t\tcase trimmed == \"\":\n\t\t\t// A blank line inside an item keeps it open: an indented\n\t\t\t// paragraph after it still belongs to the item, and an\n\t\t\t// unindented line ends it.\n\t\tcase !indented && (strings.HasPrefix(trimmed, \"- \") || strings.HasPrefix(trimmed, \"* \")):\n\t\t\tm := acceptedLimitRE.FindStringSubmatch(trimmed)\n\t\t\tif m == nil {\n\t\t\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(trimmed)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n\t\t\t\topen = false\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tentries = append(entries, entry{id: m[1], text: strings.TrimSpace(m[2])})\n\t\t\topen = true\n\t\tcase indented && open && (strings.HasPrefix(trimmed, \"- \") || strings.HasPrefix(trimmed, \"* \") || strings.HasPrefix(trimmed, \"+ \")):\n\t\t\t// A nested list cannot be read as one sentence: the whole limit\n\t\t\t// is refused and not sealed.\n\t\t\tproblems = append(problems, \"accepted limit \"+entries[len(entries)-1].id+\" holds a nested list; write it as one item\")\n\t\t\tentries[len(entries)-1].id = \"\"\n\t\t\topen = false\n\t\tcase indented && open:\n\t\t\tentries[len(entries)-1].text += \" \" + trimmed\n\t\tdefault:\n\t\t\topen = false\n\t\t}\n\t}\n\tfor _, e := range entries {\n\t\tif e.id == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif seen[e.id] {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is declared twice\")\n\t\t\tcontinue\n\t\t}\n\t\tseen[e.id] = true\n\t\tif !hasAcceptedLimitReason(e.text) {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" does not say why it is accepted ('Accepted because ...')\")\n\t\t\tcontinue\n\t\t}\n\t\tlimits = append(limits, ReviewAcceptedLimit{ID: e.id, Text: e.text})\n\t}\n\treturn limits, problems\n}\n\n// fenceMarker returns the run of backticks or tildes that opens a code\n// fence on trimmed, or \"\".\nfunc fenceMarker(trimmed string) string {\n\tfor _, c := range []string{\"`\", \"~\"} {\n\t\tn := len(trimmed) - len(strings.TrimLeft(trimmed, c))\n\t\tif n >= 3 {\n\t\t\treturn trimmed[:n]\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// acceptedLimitsOf collects the limits the scope's specs declare.\nfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n\tspecs, err := s.reviewScopeSpecs(scope)\n\tif err != nil {\n\t\treturn nil\n\t}\n\treturn acceptedLimitsOfSpecs(specs)\n}\n\n// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n// by its spec when there is more than one spec.\nfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n\tvar out []ReviewAcceptedLimit\n\tfor _, spec := range specs {\n\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n\t\tfor _, l := range limits {\n\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n\t\t\t// so a finding names exactly one sealed limit.\n\t\t\tif len(specs) > 1 {\n\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n\t\t\t}\n\t\t\tout = append(out, l)\n\t\t}\n\t}\n\treturn out\n}\n\n// sealedAcceptedLimit reports whether the bundle sealed limit id.\nfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n\t\tif l.ID == id {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\npackage pose\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nconst limitsSection = `\n### Accepted limits\n- L1: A process that clears its environment escapes. Accepted because the shim covers it.\n- L2: Windows is untested here. Accepted because the host is Linux.\n`\n\n// Spec pose-review-declared-threat-model R1: the section is read as\n// written, and what does not say why it is accepted is reported.\nfunc TestAcceptedLimitsAreParsed(t *testing.T) {\n\tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n\tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n\t}\n\t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n- L3: a marker with nothing after it. Accepted because\\n\")\n\tjoined := strings.Join(problems, \"\\n\")\n\tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\", \"L3 does not say why it is accepted\"} {\n\t\tif !strings.Contains(joined, want) {\n\t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n\t\t}\n\t}\n}\n\n// R1: the review plan seals the limits the spec declares, and they enter the\n// plan digest; a spec without limits keeps its digest.\nfunc TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n\troot, store := reviewBundleFixture(t)\n\tbefore, err := store.ReviewPlan(\"spec:backend\")\n\tif err != nil || len(before.AcceptedLimits) != 0 {\n\t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n\t}\n\tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n\traw, _ := os.ReadFile(path)\n\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tafter, err := store.ReviewPlan(\"spec:backend\")\n\tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n\t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n\t}\n\twithout := after\n\twithout.AcceptedLimits = nil\n\tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n\t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n\t}\n}\n\n// R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n// recorded within-limit, naming it, and does not block an approval whatever\n// its severity; a limit the bundle did not seal accepts nothing.\nfunc TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n\tvar bundle ReviewBundle\n\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n\tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n\t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n\t}}\n\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n\t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n\t}\n\tatt.Decision = \"approved\"\n\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n\t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n\t}\n\tatt.Findings[0].Limit = \"L9\"\n\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n\t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n\t}\n\tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"  \\t \"\n\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n\t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n\t}\n}\n\n// Review round 1, N1: across the specs of a composite scope each limit is\n// qualified by its spec, so a finding names exactly one.\nfunc TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n\tbody := \"### Accepted limits\\n- L1: one escape. Accepted because it is rare.\\n\"\n\tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n\tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n\t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n\t}\n\tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n\tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n\t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n\t}\n}\n\n// Review round 2, N1: punctuation is not a reason, and a reason may start\n// with a one-letter word.\nfunc TestAnAcceptedLimitNeedsWordsAsItsReason(t *testing.T) {\n\tfor text, want := range map[string]bool{\n\t\t\"x. Accepted because ..\":                                          false,\n\t\t\"x. Accepted because -- !\":                                        false,\n\t\t\"x. Accepted because rare\":                                        false,\n\t\t\"An escape. Accepted because a shim covers it.\":                   true,\n\t\t\"Uma fuga. Aceito porque o shim cobre o caso.\":                    true,\n\t\t\"Not accepted because this would violate scope.\":                  false,\n\t\t\"Accepted because it is rare.\":                                    false,\n\t\t\"An escape. Accepted because. Then unrelated prose follows here.\": false,\n\t\t\"An escape. Accepted because a shim covers it. More context.\":     true,\n\t\t\"An escape. Accepted because ; later prose has words.\":            false,\n\t\t\"X. Accepted because a shim covers it.\":                           false,\n\t\t\"x, accepted because it is rare.\":                                 false,\n\t} {\n\t\tif got := hasAcceptedLimitReason(text); got != want {\n\t\t\tt.Errorf(\"%q: reason=%t, want %t\", text, got, want)\n\t\t}\n\t}\n}\n\n// Review round 6, N1: the bundle's plan digest covers the sealed limits, and\n// a plan without limits keeps the digest it had before them.\nfunc TestTheBundlePlanDigestCoversTheAcceptedLimits(t *testing.T) {\n\tvar plan ReviewPlan\n\tplan.SchemaVersion, plan.Independence = 1, \"different-actor\"\n\tempty, err := reviewBundlePlanDigest(plan)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlegacy, _ := digestJSON(struct {\n\t\tSchemaVersion             int                   `json:\"schema_version\"`\n\t\tPolicySchemaVersion       int                   `json:\"policy_schema_version\"`\n\t\tBaseProfile               string                `json:\"base_profile\"`\n\t\tIndependence              string                `json:\"independence\"`\n\t\tComponents                []ReviewPlanComponent `json:\"components\"`\n\t\tSelectedProfiles          []ReviewPlanProfile   `json:\"selected_profiles\"`\n\t\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n\t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n\t\tLimitations               []string              `json:\"limitations,omitempty\"`\n\t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n\t}{1, 0, \"\", \"different-actor\", []ReviewPlanComponent{}, []ReviewPlanProfile{}, []ReviewPlanCriterion{}, []ReviewPlanTool{}, nil, false})\n\tif empty != legacy {\n\t\tt.Fatal(\"a plan without limits changed its bundle plan digest\")\n\t}\n\tplan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"An escape. Accepted because a shim covers it.\"}}\n\tone, _ := reviewBundlePlanDigest(plan)\n\tplan.AcceptedLimits[0].Text = \"An escape. Accepted because nothing else covers it.\"\n\tother, _ := reviewBundlePlanDigest(plan)\n\tif one == empty || one == other {\n\t\tt.Fatalf(\"the bundle plan digest does not cover the accepted limits: %s %s %s\", empty, one, other)\n\t}\n}\n\n// Review round 8, N1, N2: a wrapped entry keeps its continuation; fenced and\n// commented examples are not sealed.\nfunc TestAcceptedLimitsReadWrappedEntriesAndSkipExamples(t *testing.T) {\n\tbody := \"### Accepted limits\\n- L1: An escape. Accepted because a shim covers it\\n  only on Linux and only for children.\\n\\n```\\n- L2: An example. Accepted because it is only shown.\\n```\\n<!--\\n- L3: A hidden one. Accepted because nobody sees it.\\n-->\\n\"\n\tlimits, problems := ParseAcceptedLimits(body)\n\tif len(problems) != 0 || len(limits) != 1 {\n\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n\t}\n\tif !strings.HasSuffix(limits[0].Text, \"only on Linux and only for children.\") {\n\t\tt.Fatalf(\"the continuation line was cut: %q\", limits[0].Text)\n\t}\n}\n\n// Review round 9, N2, N4: an entry ends where its list item ends; a wrapped\n// '#' is no heading; a nested list or a borrowed reason is refused and not\n// sealed; fences close only with their own marker.\nfunc TestAcceptedLimitsEndWhereTheirItemEnds(t *testing.T) {\n\tcases := []struct {\n\t\tname, body string\n\t\twant       map[string]string\n\t\tproblem    string\n\t}{\n\t\t{\"wrapped hash\", \"### Accepted limits\\n- L1: An escape is open. Accepted because see issue\\n  #42 only on Linux.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because see issue #42 only on Linux.\"}, \"\"},\n\t\t{\"nested list\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n  - only on Linux\\n\", map[string]string{}, \"nested list\"},\n\t\t{\"later paragraph\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\\nSome note that follows the list.\\n* L2: Another escape. Accepted because it is rarer.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare.\", \"L2\": \"Another escape. Accepted because it is rarer.\"}, \"\"},\n\t\t{\"indented paragraph\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n\\n  and only on Linux.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare and only on Linux.\"}, \"\"},\n\t\t{\"borrowed reason\", \"### Accepted limits\\n- L1: no reason here\\n\\nSome unrelated note. Accepted because other words follow.\\n\", map[string]string{}, \"does not say why\"},\n\t\t{\"four backticks\", \"### Accepted limits\\n````\\n```\\n- L1: An example escape. Accepted because it is only shown.\\n```\\n````\\n\", map[string]string{}, \"\"},\n\t\t{\"tilde fence\", \"### Accepted limits\\n~~~\\n```\\n- L1: An example escape. Accepted because it is only shown.\\n~~~\\n\", map[string]string{}, \"\"},\n\t}\n\tfor _, c := range cases {\n\t\tlimits, problems := ParseAcceptedLimits(c.body)\n\t\tgot := map[string]string{}\n\t\tfor _, l := range limits {\n\t\t\tgot[l.ID] = l.Text\n\t\t}\n\t\tif len(got) != len(c.want) {\n\t\t\tt.Fatalf(\"%s: limits %+v, want %v (problems %v)\", c.name, limits, c.want, problems)\n\t\t}\n\t\tfor id, text := range c.want {\n\t\t\tif got[id] != text {\n\t\t\t\tt.Fatalf(\"%s: %s = %q, want %q\", c.name, id, got[id], text)\n\t\t\t}\n\t\t}\n\t\tjoined := strings.Join(problems, \"; \")\n\t\tif (c.problem == \"\") != (joined == \"\") || !strings.Contains(joined, c.problem) {\n\t\t\tt.Fatalf(\"%s: problems %q, want %q\", c.name, joined, c.problem)\n\t\t}\n\t}\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"a755f65c-d7f0-46fe-ae60-49bb15b629cc","timestamp":"2026-11-26T04:20:43.463Z","tool_use_result":{"stdout":"package pose\n\n// Accepted limits (spec pose-review-declared-threat-model): a spec declares\n// the residual limits of a guarantee it makes, each with a stable id and why\n// it is accepted. The review plan seals them; the brief lists them; a\n// reviewer classifies a finding that falls inside one as within that limit,\n// or disputes the limit as a finding of its own. A declared limit never\n// hides a defect inside the declared scope: it is visible in the bundle, the\n// brief and the attestation.\n\nimport (\n\t\"regexp\"\n\t\"strings\"\n)\n\n// ReviewAcceptedLimit is one declared residual limit.\ntype ReviewAcceptedLimit struct {\n\tID   string `json:\"id\"`\n\tText string `json:\"text\"`\n\t// Spec names the spec that declared the limit when the scope holds more\n\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n\tSpec string `json:\"spec,omitempty\"`\n}\n\nvar acceptedLimitRE = regexp.MustCompile(`^[-*]\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n\n// acceptedLimitMarkerRE finds the marker where a sentence opens, after the\n// assumption: \"<assumption>. Accepted because <reason>.\" A marker inside a\n// sentence (\"Not accepted because\") is not one (review round 3, N1).\nvar acceptedLimitMarkerRE = regexp.MustCompile(`[.;:!?]\\s+(?:Accepted because|Aceito porque)\\s+`)\n\n// acceptedLimitReasonWordRE is a word with at least one letter.\nvar acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n\n// hasAcceptedLimitReason reads an entry as written: an assumption of at\n// least two words, then the marker opening a sentence, then a reason of at\n// least two words in that same sentence. A marker alone, punctuation, a\n// missing assumption or a reason borrowed from a later sentence does not say\n// why a limit is accepted (review rounds 1–4).\nfunc hasAcceptedLimitReason(text string) bool {\n\tloc := acceptedLimitMarkerRE.FindStringIndex(text)\n\tif loc == nil {\n\t\treturn false\n\t}\n\tassumption, rest := text[:loc[0]], text[loc[1]:]\n\tif end := strings.IndexAny(rest, \".;!?\"); end >= 0 {\n\t\trest = rest[:end]\n\t}\n\treturn len(acceptedLimitReasonWordRE.FindAllString(assumption, -1)) >= 2 && len(acceptedLimitReasonWordRE.FindAllString(rest, -1)) >= 2\n}\n\n// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n// It returns the limits and the problems that keep the section from being\n// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n// limit that does not say why it is accepted (\"Accepted because ...\" or\n// \"Aceito porque ...\").\nfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n\tvar limits []ReviewAcceptedLimit\n\tvar problems []string\n\tin := false\n\tseen := map[string]bool{}\n\t// An entry is one Markdown list item: it may wrap over indented lines,\n\t// including after a blank line, and it ends at an unindented line or the\n\t// next item\n\t// (review rounds 8 N1 and 9 N2). Fenced blocks and HTML comments are not\n\t// the spec's declarations, so examples there are never sealed (round 8\n\t// N2); a fence closes only with its own marker, at least as long.\n\ttype entry struct{ id, text string }\n\tvar entries []entry\n\topen := false\n\tfence := \"\"\n\tfor _, line := range strings.Split(stripHTMLComments(body), \"\\n\") {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif marker := fenceMarker(trimmed); marker != \"\" {\n\t\t\tswitch {\n\t\t\tcase fence == \"\":\n\t\t\t\tfence = marker\n\t\t\tcase marker[0] == fence[0] && len(marker) >= len(fence) && strings.TrimLeft(trimmed, marker[:1]) == \"\":\n\t\t\t\tfence = \"\"\n\t\t\t}\n\t\t\topen = false\n\t\t\tcontinue\n\t\t}\n\t\tif fence != \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tindented := trimmed != \"\" && (strings.HasPrefix(line, \" \") || strings.HasPrefix(line, \"\\t\"))\n\t\tif !indented && strings.HasPrefix(trimmed, \"#\") {\n\t\t\theading := strings.TrimSpace(strings.TrimLeft(trimmed, \"#\"))\n\t\t\tin = strings.EqualFold(heading, \"Accepted limits\") || strings.EqualFold(heading, \"Limites aceitos\")\n\t\t\topen = false\n\t\t\tcontinue\n\t\t}\n\t\tif !in {\n\t\t\tcontinue\n\t\t}\n\t\tswitch {\n\t\tcase trimmed == \"\":\n\t\t\t// A blank line inside an item keeps it open: an indented\n\t\t\t// paragraph after it still belongs to the item, and an\n\t\t\t// unindented line ends it.\n\t\tcase !indented && (strings.HasPrefix(trimmed, \"- \") || strings.HasPrefix(trimmed, \"* \")):\n\t\t\tm := acceptedLimitRE.FindStringSubmatch(trimmed)\n\t\t\tif m == nil {\n\t\t\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(trimmed)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n\t\t\t\topen = false\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tentries = append(entries, entry{id: m[1], text: strings.TrimSpace(m[2])})\n\t\t\topen = true\n\t\tcase indented && open && (strings.HasPrefix(trimmed, \"- \") || strings.HasPrefix(trimmed, \"* \") || strings.HasPrefix(trimmed, \"+ \")):\n\t\t\t// A nested list cannot be read as one sentence: the whole limit\n\t\t\t// is refused and not sealed.\n\t\t\tproblems = append(problems, \"accepted limit \"+entries[len(entries)-1].id+\" holds a nested list; write it as one item\")\n\t\t\tentries[len(entries)-1].id = \"\"\n\t\t\topen = false\n\t\tcase indented && open:\n\t\t\tentries[len(entries)-1].text += \" \" + trimmed\n\t\tdefault:\n\t\t\topen = false\n\t\t}\n\t}\n\tfor _, e := range entries {\n\t\tif e.id == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif seen[e.id] {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is declared twice\")\n\t\t\tcontinue\n\t\t}\n\t\tseen[e.id] = true\n\t\tif !hasAcceptedLimitReason(e.text) {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" does not say why it is accepted ('Accepted because ...')\")\n\t\t\tcontinue\n\t\t}\n\t\tlimits = append(limits, ReviewAcceptedLimit{ID: e.id, Text: e.text})\n\t}\n\treturn limits, problems\n}\n\n// fenceMarker returns the run of backticks or tildes that opens a code\n// fence on trimmed, or \"\".\nfunc fenceMarker(trimmed string) string {\n\tfor _, c := range []string{\"`\", \"~\"} {\n\t\tn := len(trimmed) - len(strings.TrimLeft(trimmed, c))\n\t\tif n >= 3 {\n\t\t\treturn trimmed[:n]\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// acceptedLimitsOf collects the limits the scope's specs declare.\nfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n\tspecs, err := s.reviewScopeSpecs(scope)\n\tif err != nil {\n\t\treturn nil\n\t}\n\treturn acceptedLimitsOfSpecs(specs)\n}\n\n// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n// by its spec when there is more than one spec.\nfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n\tvar out []ReviewAcceptedLimit\n\tfor _, spec := range specs {\n\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n\t\tfor _, l := range limits {\n\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n\t\t\t// so a finding names exactly one sealed limit.\n\t\t\tif len(specs) > 1 {\n\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n\t\t\t}\n\t\t\tout = append(out, l)\n\t\t}\n\t}\n\treturn out\n}\n\n// sealedAcceptedLimit reports whether the bundle sealed limit id.\nfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n\t\tif l.ID == id {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\npackage pose\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nconst limitsSection = `\n### Accepted limits\n- L1: A process that clears its environment escapes. Accepted because the shim covers it.\n- L2: Windows is untested here. Accepted because the host is Linux.\n`\n\n// Spec pose-review-declared-threat-model R1: the section is read as\n// written, and what does not say why it is accepted is reported.\nfunc TestAcceptedLimitsAreParsed(t *testing.T) {\n\tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n\tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n\t}\n\t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n- L3: a marker with nothing after it. Accepted because\\n\")\n\tjoined := strings.Join(problems, \"\\n\")\n\tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\", \"L3 does not say why it is accepted\"} {\n\t\tif !strings.Contains(joined, want) {\n\t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n\t\t}\n\t}\n}\n\n// R1: the review plan seals the limits the spec declares, and they enter the\n// plan digest; a spec without limits keeps its digest.\nfunc TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n\troot, store := reviewBundleFixture(t)\n\tbefore, err := store.ReviewPlan(\"spec:backend\")\n\tif err != nil || len(before.AcceptedLimits) != 0 {\n\t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n\t}\n\tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n\traw, _ := os.ReadFile(path)\n\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tafter, err := store.ReviewPlan(\"spec:backend\")\n\tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n\t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n\t}\n\twithout := after\n\twithout.AcceptedLimits = nil\n\tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n\t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n\t}\n}\n\n// R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n// recorded within-limit, naming it, and does not block an approval whatever\n// its severity; a limit the bundle did not seal accepts nothing.\nfunc TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n\tvar bundle ReviewBundle\n\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n\tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n\t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n\t}}\n\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n\t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n\t}\n\tatt.Decision = \"approved\"\n\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n\t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n\t}\n\tatt.Findings[0].Limit = \"L9\"\n\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n\t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n\t}\n\tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"  \\t \"\n\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n\t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n\t}\n}\n\n// Review round 1, N1: across the specs of a composite scope each limit is\n// qualified by its spec, so a finding names exactly one.\nfunc TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n\tbody := \"### Accepted limits\\n- L1: one escape. Accepted because it is rare.\\n\"\n\tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n\tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n\t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n\t}\n\tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n\tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n\t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n\t}\n}\n\n// Review round 2, N1: punctuation is not a reason, and a reason may start\n// with a one-letter word.\nfunc TestAnAcceptedLimitNeedsWordsAsItsReason(t *testing.T) {\n\tfor text, want := range map[string]bool{\n\t\t\"x. Accepted because ..\":                                          false,\n\t\t\"x. Accepted because -- !\":                                        false,\n\t\t\"x. Accepted because rare\":                                        false,\n\t\t\"An escape. Accepted because a shim covers it.\":                   true,\n\t\t\"Uma fuga. Aceito porque o shim cobre o caso.\":                    true,\n\t\t\"Not accepted because this would violate scope.\":                  false,\n\t\t\"Accepted because it is rare.\":                                    false,\n\t\t\"An escape. Accepted because. Then unrelated prose follows here.\": false,\n\t\t\"An escape. Accepted because a shim covers it. More context.\":     true,\n\t\t\"An escape. Accepted because ; later prose has words.\":            false,\n\t\t\"X. Accepted because a shim covers it.\":                           false,\n\t\t\"x, accepted because it is rare.\":                                 false,\n\t} {\n\t\tif got := hasAcceptedLimitReason(text); got != want {\n\t\t\tt.Errorf(\"%q: reason=%t, want %t\", text, got, want)\n\t\t}\n\t}\n}\n\n// Review round 6, N1: the bundle's plan digest covers the sealed limits, and\n// a plan without limits keeps the digest it had before them.\nfunc TestTheBundlePlanDigestCoversTheAcceptedLimits(t *testing.T) {\n\tvar plan ReviewPlan\n\tplan.SchemaVersion, plan.Independence = 1, \"different-actor\"\n\tempty, err := reviewBundlePlanDigest(plan)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlegacy, _ := digestJSON(struct {\n\t\tSchemaVersion             int                   `json:\"schema_version\"`\n\t\tPolicySchemaVersion       int                   `json:\"policy_schema_version\"`\n\t\tBaseProfile               string                `json:\"base_profile\"`\n\t\tIndependence              string                `json:\"independence\"`\n\t\tComponents                []ReviewPlanComponent `json:\"components\"`\n\t\tSelectedProfiles          []ReviewPlanProfile   `json:\"selected_profiles\"`\n\t\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n\t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n\t\tLimitations               []string              `json:\"limitations,omitempty\"`\n\t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n\t}{1, 0, \"\", \"different-actor\", []ReviewPlanComponent{}, []ReviewPlanProfile{}, []ReviewPlanCriterion{}, []ReviewPlanTool{}, nil, false})\n\tif empty != legacy {\n\t\tt.Fatal(\"a plan without limits changed its bundle plan digest\")\n\t}\n\tplan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"An escape. Accepted because a shim covers it.\"}}\n\tone, _ := reviewBundlePlanDigest(plan)\n\tplan.AcceptedLimits[0].Text = \"An escape. Accepted because nothing else covers it.\"\n\tother, _ := reviewBundlePlanDigest(plan)\n\tif one == empty || one == other {\n\t\tt.Fatalf(\"the bundle plan digest does not cover the accepted limits: %s %s %s\", empty, one, other)\n\t}\n}\n\n// Review round 8, N1, N2: a wrapped entry keeps its continuation; fenced and\n// commented examples are not sealed.\nfunc TestAcceptedLimitsReadWrappedEntriesAndSkipExamples(t *testing.T) {\n\tbody := \"### Accepted limits\\n- L1: An escape. Accepted because a shim covers it\\n  only on Linux and only for children.\\n\\n```\\n- L2: An example. Accepted because it is only shown.\\n```\\n<!--\\n- L3: A hidden one. Accepted because nobody sees it.\\n-->\\n\"\n\tlimits, problems := ParseAcceptedLimits(body)\n\tif len(problems) != 0 || len(limits) != 1 {\n\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n\t}\n\tif !strings.HasSuffix(limits[0].Text, \"only on Linux and only for children.\") {\n\t\tt.Fatalf(\"the continuation line was cut: %q\", limits[0].Text)\n\t}\n}\n\n// Review round 9, N2, N4: an entry ends where its list item ends; a wrapped\n// '#' is no heading; a nested list or a borrowed reason is refused and not\n// sealed; fences close only with their own marker.\nfunc TestAcceptedLimitsEndWhereTheirItemEnds(t *testing.T) {\n\tcases := []struct {\n\t\tname, body string\n\t\twant       map[string]string\n\t\tproblem    string\n\t}{\n\t\t{\"wrapped hash\", \"### Accepted limits\\n- L1: An escape is open. Accepted because see issue\\n  #42 only on Linux.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because see issue #42 only on Linux.\"}, \"\"},\n\t\t{\"nested list\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n  - only on Linux\\n\", map[string]string{}, \"nested list\"},\n\t\t{\"later paragraph\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\\nSome note that follows the list.\\n* L2: Another escape. Accepted because it is rarer.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare.\", \"L2\": \"Another escape. Accepted because it is rarer.\"}, \"\"},\n\t\t{\"indented paragraph\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n\\n  and only on Linux.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare and only on Linux.\"}, \"\"},\n\t\t{\"borrowed reason\", \"### Accepted limits\\n- L1: no reason here\\n\\nSome unrelated note. Accepted because other words follow.\\n\", map[string]string{}, \"does not say why\"},\n\t\t{\"four backticks\", \"### Accepted limits\\n````\\n```\\n- L1: An example escape. Accepted because it is only shown.\\n```\\n````\\n\", map[string]string{}, \"\"},\n\t\t{\"tilde fence\", \"### Accepted limits\\n~~~\\n```\\n- L1: An example escape. Accepted because it is only shown.\\n~~~\\n\", map[string]string{}, \"\"},\n\t}\n\tfor _, c := range cases {\n\t\tlimits, problems := ParseAcceptedLimits(c.body)\n\t\tgot := map[string]string{}\n\t\tfor _, l := range limits {\n\t\t\tgot[l.ID] = l.Text\n\t\t}\n\t\tif len(got) != len(c.want) {\n\t\t\tt.Fatalf(\"%s: limits %+v, want %v (problems %v)\", c.name, limits, c.want, problems)\n\t\t}\n\t\tfor id, text := range c.want {\n\t\t\tif got[id] != text {\n\t\t\t\tt.Fatalf(\"%s: %s = %q, want %q\", c.name, id, got[id], text)\n\t\t\t}\n\t\t}\n\t\tjoined := strings.Join(problems, \"; \")\n\t\tif (c.problem == \"\") != (joined == \"\") || !strings.Contains(joined, c.problem) {\n\t\t\tt.Fatalf(\"%s: problems %q, want %q\", c.name, joined, c.problem)\n\t\t}\n\t}\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018MHjg8Xd5yqGtQtqS7hg9y","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
