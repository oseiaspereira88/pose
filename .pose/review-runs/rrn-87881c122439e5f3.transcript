{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0136pNwvWLTjqcVtrVbqnoTp","type":"tool_result","content":"diff --git a/pose-mcp/internal/cli/lintspec.go b/pose-mcp/internal/cli/lintspec.go\nindex 6b9ce779..2619ee9d 100644\n--- a/pose-mcp/internal/cli/lintspec.go\n+++ b/pose-mcp/internal/cli/lintspec.go\n@@ -4,6 +4,7 @@ package cli\n // stable machine metrics without an external runtime.\n \n import (\n+\t\"errors\"\n \t\"fmt\"\n \t\"io\"\n \t\"os\"\n@@ -566,6 +567,21 @@ func lintOneSpecWith(r *cliout.Renderer, fields bool, specPath string, requiredO\n \t\t\tlint.finding(cliout.StateError, \"dor\", fmt.Sprintf(cliText(locale, \"DoR: invalid depends_on reference: '%s'\", \"DoR: ref inválida em depends_on: '%s'\"), ref))\n \t\t\tfailures++\n \t\t}\n+\t\t// Accepted limits (spec pose-review-declared-threat-model R4): each\n+\t\t// says why it is accepted, and an ADR that names the spec names each\n+\t\t// limit, so the decision record carries what the review will treat as\n+\t\t// out of scope.\n+\t\tlimits, limitProblems := posepkg.ParseAcceptedLimits(text)\n+\t\tfor _, problem := range limitProblems {\n+\t\t\tlint.finding(cliout.StateError, \"dor\", \"DoR: \"+problem)\n+\t\t\tfailures++\n+\t\t}\n+\t\tif len(limits) > 0 {\n+\t\t\tfor _, missing := range acceptedLimitsMissingFromADRs(lintProjectRoot(specPath), slug, limits) {\n+\t\t\t\tlint.finding(cliout.StateError, \"dor\", missing)\n+\t\t\t\tfailures++\n+\t\t\t}\n+\t\t}\n \t\temitDesignBasis()\n \t\tfailures += designFailures + lineageFailures\n \t\tready := \"true\"\n@@ -1168,3 +1184,77 @@ func containsSection(names []string, name string) bool {\n \t}\n \treturn false\n }\n+\n+// acceptedLimitsMissingFromADRs names each declared limit an ADR that cites\n+// the spec does not mention. With no ADR citing the spec nothing is required.\n+func acceptedLimitsMissingFromADRs(root, slug string, limits []posepkg.ReviewAcceptedLimit) []string {\n+\tentries, err := os.ReadDir(filepath.Join(root, \".pose\", \"adr\"))\n+\tif errors.Is(err, os.ErrNotExist) {\n+\t\treturn nil\n+\t}\n+\t// An ADR that cannot be read may be the one that cites the spec: the\n+\t// check fails closed instead of reading it as absent (review round 5, N2).\n+\tif err != nil {\n+\t\treturn []string{\"DoR: the ADRs cannot be read to check the accepted limits: \" + err.Error()}\n+\t}\n+\t// A whole slug, or the dated file a link names (review round 9, N3).\n+\tcitesSlug := regexp.MustCompile(`(^|[^A-Za-z0-9_-]|[0-9]{4}-[0-9]{2}-[0-9]{2}-)` + regexp.QuoteMeta(slug) + `($|[^A-Za-z0-9_-])`)\n+\tvar citing []string\n+\tvar unreadable []string\n+\tfor _, e := range entries {\n+\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".md\") {\n+\t\t\tcontinue\n+\t\t}\n+\t\traw, err := readADRBounded(filepath.Join(root, \".pose\", \"adr\", e.Name()))\n+\t\tif err != nil {\n+\t\t\tunreadable = append(unreadable, \"DoR: ADR \"+e.Name()+\" cannot be read to check the accepted limits: \"+err.Error())\n+\t\t\tcontinue\n+\t\t}\n+\t\t// The slug as a whole name: an ADR about a longer slug does not cite a\n+\t\t// shorter one it contains (review round 8, N4).\n+\t\tif !citesSlug.MatchString(string(raw)) {\n+\t\t\tcontinue\n+\t\t}\n+\t\tciting = append(citing, string(raw))\n+\t}\n+\tif len(unreadable) > 0 {\n+\t\treturn unreadable\n+\t}\n+\tif len(citing) == 0 {\n+\t\treturn nil\n+\t}\n+\tvar missing []string\n+\tfor _, l := range limits {\n+\t\tfound := false\n+\t\t// The id as a word: L10 does not name L1 (review round 1, N3).\n+\t\tnamed := regexp.MustCompile(`\\b` + regexp.QuoteMeta(l.ID) + `\\b`)\n+\t\tfor _, adr := range citing {\n+\t\t\tfound = found || named.MatchString(adr)\n+\t\t}\n+\t\tif !found {\n+\t\t\tmissing = append(missing, \"DoR: accepted limit \"+l.ID+\" is not named by the ADR that cites \"+slug)\n+\t\t}\n+\t}\n+\treturn missing\n+}\n+\n+// adrReadLimit bounds one ADR the ready check reads.\n+const adrReadLimit = 1 << 20\n+\n+// readADRBounded reads a regular ADR file without following a link and\n+// within adrReadLimit, so a link out of the project or to an endless source\n+// fails instead of hanging the check (review round 7, N2).\n+func readADRBounded(path string) ([]byte, error) {\n+\tinfo, err := os.Lstat(path)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif !info.Mode().IsRegular() {\n+\t\treturn nil, fmt.Errorf(\"not a regular file\")\n+\t}\n+\tf, err := posepkg.ReadReviewAdapterFile(path, adrReadLimit)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\treturn f, nil\n+}\ndiff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex c77e594c..53b6aba6 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -117,13 +117,18 @@ type ReviewBundleSubject struct {\n }\n \n type ReviewBundlePlan struct {\n-\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n-\tLimitations               []string              `json:\"limitations,omitempty\"`\n-\tPlanDigest                string                `json:\"plan_digest\"`\n-\tIndependence              string                `json:\"independence\"`\n-\tComponents                []ReviewPlanComponent `json:\"components\"`\n-\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n-\tTools                     []ReviewPlanTool      `json:\"tools\"`\n+\tDelegatedRunProofRequired bool     `json:\"delegated_run_proof_required,omitempty\"`\n+\tLimitations               []string `json:\"limitations,omitempty\"`\n+\t// AcceptedLimits seals the residual limits the scope's spec declares, so\n+\t// the brief and the conclusion read them from the bundle (spec\n+\t// pose-review-declared-threat-model). Omitted when none, so every other\n+\t// bundle keeps its digest.\n+\tAcceptedLimits []ReviewAcceptedLimit `json:\"accepted_limits,omitempty\"`\n+\tPlanDigest     string                `json:\"plan_digest\"`\n+\tIndependence   string                `json:\"independence\"`\n+\tComponents     []ReviewPlanComponent `json:\"components\"`\n+\tCriteria       []ReviewPlanCriterion `json:\"criteria\"`\n+\tTools          []ReviewPlanTool      `json:\"tools\"`\n \t// SelectedProfiles records which components each profile was selected for.\n \t// A criterion names the profiles it came from, and without this mapping the\n \t// sealed subject cannot say which components that criterion answers for —\n@@ -515,7 +520,7 @@ func (s Store) prepareReviewBundle(ref string, legacyMilestoneManifest bool) (Re\n \tif err != nil {\n \t\treturn ReviewBundle{}, err\n \t}\n-\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview}\n+\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview, AcceptedLimits: append([]ReviewAcceptedLimit(nil), plan.AcceptedLimits...)}\n \n \tscopeProjection, excluded, err := s.reviewBundleScopeProjection(scope)\n \tif err != nil {\n@@ -1969,7 +1974,10 @@ func reviewBundlePlanDigest(plan ReviewPlan) (string, error) {\n \t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n \t\tLimitations               []string              `json:\"limitations,omitempty\"`\n \t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n-\t}{plan.SchemaVersion, plan.PolicySchemaVersion, plan.BaseProfile, plan.Independence, append([]ReviewPlanComponent{}, plan.Components...), append([]ReviewPlanProfile{}, plan.SelectedProfiles...), append([]ReviewPlanCriterion{}, plan.Criteria...), append([]ReviewPlanTool{}, plan.Tools...), plan.Limitations, plan.DelegatedRunProofRequired}\n+\t\t// The sealed limits enter the bundle's plan digest too; omitted when\n+\t\t// none, so every other bundle keeps its digest (review round 6, N1).\n+\t\tAcceptedLimits []ReviewAcceptedLimit `json:\"accepted_limits,omitempty\"`\n+\t}{plan.SchemaVersion, plan.PolicySchemaVersion, plan.BaseProfile, plan.Independence, append([]ReviewPlanComponent{}, plan.Components...), append([]ReviewPlanProfile{}, plan.SelectedProfiles...), append([]ReviewPlanCriterion{}, plan.Criteria...), append([]ReviewPlanTool{}, plan.Tools...), plan.Limitations, plan.DelegatedRunProofRequired, plan.AcceptedLimits}\n \treturn digestJSON(contract)\n }\n \n@@ -2134,6 +2142,9 @@ func (s Store) sealReviewBundle(ref string, identity *ReviewBundleImplementation\n \t\treplaced.Replaces = governing.BundleID\n \t\tidentity = &replaced\n \t}\n+\tif blockers := s.sealReadinessBlockers(bundle); len(blockers) > 0 {\n+\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", strings.Join(blockers, \"; \"))\n+\t}\n \t// A bundle already sealed reads as it was; a new seal holds a validation result,\n \t// whatever the lifecycle of the scope says.\n \tif !holdsValidationResult(bundle.Payload.Evidence) {\n@@ -3891,6 +3902,15 @@ func (s Store) validateBundleAttestationWith(bundle ReviewBundle, att ReviewAtte\n \t\t\t}\n \t\t}\n \t}\n+\treturn append(blockers, s.attestationContentBlockers(bundle, att, skipEvidenceSupport)...)\n+}\n+\n+// attestationContentBlockers judges what an att