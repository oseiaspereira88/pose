 indented or plain line that\n-\t// follows it continues it (review round 8, N1). Fenced blocks and HTML\n-\t// comments are not the spec's declarations, so examples there are never\n-\t// sealed (N2).\n+\t// An entry is one Markdown list item: it may wrap over indented lines,\n+\t// including after a blank line, and it ends at an unindented line or the\n+\t// next item\n+\t// (review rounds 8 N1 and 9 N2). Fenced blocks and HTML comments are not\n+\t// the spec's declarations, so examples there are never sealed (round 8\n+\t// N2); a fence closes only with its own marker, at least as long.\n \ttype entry struct{ id, text string }\n \tvar entries []entry\n-\tmalformed := func(line string) {\n-\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(line)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n-\t}\n-\tfenced := false\n+\topen := false\n+\tfence := \"\"\n \tfor _, line := range strings.Split(stripHTMLComments(body), \"\\n\") {\n \t\ttrimmed := strings.TrimSpace(line)\n-\t\tif strings.HasPrefix(trimmed, \"```\") || strings.HasPrefix(trimmed, \"~~~\") {\n-\t\t\tfenced = !fenced\n+\t\tif marker := fenceMarker(trimmed); marker != \"\" {\n+\t\t\tswitch {\n+\t\t\tcase fence == \"\":\n+\t\t\t\tfence = marker\n+\t\t\tcase marker[0] == fence[0] && len(marker) >= len(fence) && strings.TrimLeft(trimmed, marker[:1]) == \"\":\n+\t\t\t\tfence = \"\"\n+\t\t\t}\n+\t\t\topen = false\n \t\t\tcontinue\n \t\t}\n-\t\tif fenced {\n+\t\tif fence != \"\" {\n \t\t\tcontinue\n \t\t}\n-\t\tif strings.HasPrefix(trimmed, \"#\") {\n+\t\tindented := trimmed != \"\" && (strings.HasPrefix(line, \" \") || strings.HasPrefix(line, \"\\t\"))\n+\t\tif !indented && strings.HasPrefix(trimmed, \"#\") {\n \t\t\theading := strings.TrimSpace(strings.TrimLeft(trimmed, \"#\"))\n \t\t\tin = strings.EqualFold(heading, \"Accepted limits\") || strings.EqualFold(heading, \"Limites aceitos\")\n+\t\t\topen = false\n \t\t\tcontinue\n \t\t}\n-\t\tif !in || trimmed == \"\" {\n+\t\tif !in {\n \t\t\tcontinue\n \t\t}\n-\t\tif strings.HasPrefix(trimmed, \"- \") {\n+\t\tswitch {\n+\t\tcase trimmed == \"\":\n+\t\t\t// A blank line inside an item keeps it open: an indented\n+\t\t\t// paragraph after it still belongs to the item, and an\n+\t\t\t// unindented line ends it.\n+\t\tcase !indented && (strings.HasPrefix(trimmed, \"- \") || strings.HasPrefix(trimmed, \"* \")):\n \t\t\tm := acceptedLimitRE.FindStringSubmatch(trimmed)\n \t\t\tif m == nil {\n-\t\t\t\tmalformed(trimmed)\n-\t\t\t\tentries = append(entries, entry{})\n+\t\t\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(trimmed)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n+\t\t\t\topen = false\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\tentries = append(entries, entry{id: m[1], text: strings.TrimSpace(m[2])})\n-\t\t\tcontinue\n-\t\t}\n-\t\tif len(entries) > 0 && entries[len(entries)-1].id != \"\" {\n+\t\t\topen = true\n+\t\tcase indented && open && (strings.HasPrefix(trimmed, \"- \") || strings.HasPrefix(trimmed, \"* \") || strings.HasPrefix(trimmed, \"+ \")):\n+\t\t\t// A nested list cannot be read as one sentence: the whole limit\n+\t\t\t// is refused and not sealed.\n+\t\t\tproblems = append(problems, \"accepted limit \"+entries[len(entries)-1].id+\" holds a nested list; write it as one item\")\n+\t\t\tentries[len(entries)-1].id = \"\"\n+\t\t\topen = false\n+\t\tcase indented && open:\n \t\t\tentries[len(entries)-1].text += \" \" + trimmed\n+\t\tdefault:\n+\t\t\topen = false\n \t\t}\n \t}\n \tfor _, e := range entries {\n@@ -111,12 +131,25 @@ func ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n \t\tseen[e.id] = true\n \t\tif !hasAcceptedLimitReason(e.text) {\n \t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" does not say why it is accepted ('Accepted because ...')\")\n+\t\t\tcontinue\n \t\t}\n \t\tlimits = append(limits, ReviewAcceptedLimit{ID: e.id, Text: e.text})\n \t}\n \treturn limits, problems\n }\n \n+// fenceMarker returns the run of backticks or tildes that opens a code\n+// fence on trimmed, or \"\".\n+func fenceMarker(trimmed string) string {\n+\tfor _, c := range []string{\"`\", \"~\"} {\n+\t\tn := len(trimmed) - len(strings.TrimLeft(trimmed, c))\n+\t\tif n >= 3 {\n+\t\t\treturn trimmed[:n]\n+\t\t}\n+\t}\n+\treturn \"\"\n+}\n+\n // acceptedLimitsOf collects the limits the scope's specs declare.\n func (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n \tspecs, err := s.reviewScopeSpecs(scope)\ndiff --git a/pose-mcp/internal/pose/accepted_limits_test.go b/pose-mcp/internal/pose/accepted_limits_test.go\nindex 4e18919b..e3992928 100644\n--- a/pose-mcp/internal/pose/accepted_limits_test.go\n+++ b/pose-mcp/internal/pose/accepted_limits_test.go\n@@ -83,7 +83,7 @@ func TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n // Review round 1, N1: across the specs of a composite scope each limit is\n // qualified by its spec, so a finding names exactly one.\n func TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n-\tbody := \"### Accepted limits\\n- L1: one. Accepted because it is rare.\\n\"\n+\tbody := \"### Accepted limits\\n- L1: one escape. Accepted because it is rare.\\n\"\n \tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n \tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n \t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n@@ -162,3 +162,41 @@ func TestAcceptedLimitsReadWrappedEntriesAndSkipExamples(t *testing.T) {\n \t\tt.Fatalf(\"the continuation line was cut: %q\", limits[0].Text)\n \t}\n }\n+\n+// Review round 9, N2, N4: an entry ends where its list item ends; a wrapped\n+// '#' is no heading; a nested list or a borrowed reason is refused and not\n+// sealed; fences close only with their own marker.\n+func TestAcceptedLimitsEndWhereTheirItemEnds(t *testing.T) {\n+\tcases := []struct {\n+\t\tname, body string\n+\t\twant       map[string]string\n+\t\tproblem    string\n+\t}{\n+\t\t{\"wrapped hash\", \"### Accepted limits\\n- L1: An escape is open. Accepted because see issue\\n  #42 only on Linux.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because see issue #42 only on Linux.\"}, \"\"},\n+\t\t{\"nested list\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n  - only on Linux\\n\", map[string]string{}, \"nested list\"},\n+\t\t{\"later paragraph\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\\nSome note that follows the list.\\n* L2: Another escape. Accepted because it is rarer.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare.\", \"L2\": \"Another escape. Accepted because it is rarer.\"}, \"\"},\n+\t\t{\"indented paragraph\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n\\n  and only on Linux.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare and only on Linux.\"}, \"\"},\n+\t\t{\"borrowed reason\", \"### Accepted limits\\n- L1: no reason here\\n\\nSome unrelated note. Accepted because other words follow.\\n\", map[string]string{}, \"does not say why\"},\n+\t\t{\"four backticks\", \"### Accepted limits\\n````\\n```\\n- L1: An example escape. Accepted because it is only shown.\\n```\\n````\\n\", map[string]string{}, \"\"},\n+\t\t{\"tilde fence\", \"### Accepted limits\\n~~~\\n```\\n- L1: An example escape. Accepted because it is only shown.\\n~~~\\n\", map[string]string{}, \"\"},\n+\t}\n+\tfor _, c := range cases {\n+\t\tlimits, problems := ParseAcceptedLimits(c.body)\n+\t\tgot := map[string]string{}\n+\t\tfor _, l := range limits {\n+\t\t\tgot[l.ID] = l.Text\n+\t\t}\n+\t\tif len(got) != len(c.want) {\n+\t\t\tt.Fatalf(\"%s: limits %+v, want %v (problems %v)\", c.name, limits, c.want, problems)\n+\t\t}\n+\t\tfor id, text := range c.want {\n+\t\t\tif got[id] != text {\n+\t\t\t\tt.Fatalf(\"%s: %s = %q, want %q\", c.name, id, got[id], text)\n+\t\t\t}\n+\t\t}\n+\t\tjoined := strings.Join(problems, \"; \")\n+\t\tif (c.problem == \"\") != (joined == \"\") || !strings.Contains(joined, c.problem) {\n+\t\t\tt.Fatalf(\"%s: problems %q, want %q\", c.name, joined, c.problem)\n+\t\t}\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_brief.go b/pose-mcp/internal/pose/review_brief.go\nindex debc921f..9cb882e2 100644\n--- a/pose-mcp/internal/pose/review_brief.go\n+++ b/pose-mcp/internal/pose/review_brief.go\n@@ -560,7 +560,12 @@ func renderReviewBriefBody(bundle ReviewBundle, kind, template, notes string, sm\n \t\t}\n \t\tline(\"%d. At the end, the draft POSE reads: one fenced block opened with ```pose-draft holding a JSON object with `schema` %q, `decision` (the decision above), `findings` (each with `id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line` and `summary`%s)%s. Everything outside the block is yours and is not read.\", next, ReviewDraftSchema, limitField, roundFields(*round, template))\n \t\tif conclusion {\n-\t\t\tline(\"%d. In the same block, the conclusion POSE records as the attestation: `criteria` (one entry per criterion above, each with `id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>` — a class the criterion asks for when it names one — and `rationale` for not-applicable), and `tools` (one entry per tool above, each with `id`, `component` when it has one, `disposition`, `evidence` and `rationale`). A follow-up finding that should be accepted as a risk carries `action`, `owner` and `review_by`; any other finding stays open. A criterion or tool you do not answer is not answered for you.\", next+1)\n+\t\t\ttext := fmt.Sprintf(\"%d. In the same block, the conclusion POSE records as the attestation: `criteria` (one entry per criterion above, each with `id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>` — a class the criterion asks for when it names one — and `rationale` for not-applicable), and `tools` (one entry per tool above, each with `id`, `component` when it has one, `disposition`, `evidence` and `rationale`). A follow-up finding that should be accepted as a risk carries `action`, `owner` and `review_by`; any other finding stays open. A criterion or tool you do not answer is not answered for you.\", next+1)\n+\t\t\tif template == reviewBriefTemplateAcceptedLimits {\n+\t\t\t\t// A follow-up within a sealed limit is not open (review round 9, N6).\n+\t\t\t\ttext = strings.Replace(text, \"; any other finding stays open.\", \"; a follow-up whose `limit` names an accepted limit above is recorded within that limit; any other finding stays open.\", 1)\n+\t\t\t}\n+\t\t\tline(\"%s\", text)\n \t\t\tif reviewBriefStatesRules(template) {\n \t\t\t\tline(\"%d. %s\", next+2, briefRulesText(template, bundle))\n \t\t\t}\ndiff --git a/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go b/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\nindex 6f4b7f65..4bf169e0 100644\n--- a/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\n+++ b/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\n@@ -186,7 +186,7 @@ func TestTheCurrentBriefAsksCommandsToFinish(t *testing.T) {\n // /10 never did.\n func TestTheCurrentBriefListsTheAcceptedLimits(t *testing.T) {\n \tcurrent := renderReviewBriefBody(richBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n-\tif !strings.Contains(current, \"## Accepted limits\") || !strings.Contains(current, \"- L1: A process that clears its environment escapes.\") || !strings.Contains(current, \"with `limit` set to its id\") || !strings.Contains(current, \"(m) the one exception to (i)\") || !strings.Contains(current, \"and `limit` when it falls inside an accepted limit\") {\n+\tif !strings.Contains(current, \"## Accepted limits\") || !strings.Contains(current, \"- L1: A process that clears its environment escapes.\") || !strings.Contains(current, \"with `limit` set to its id\") || !strings.Contains(current, \"(m) the one exception to (i)\") || !strings.Contains(current, \"and `limit` when it falls inside an accepted limit\") || !strings.Contains(current, \"is recorded within that limit; any other finding stays open.\") {\n \t\tt.Fatalf(\"the current brief does not list the accepted limits:\\n%s\", current)\n \t}\n \tearlier := renderReviewBriefBody(richBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateFinishCommands, \"\", nil, &ReviewRound{Number: 1}, true, nil)\ndiff --git a/pose-mcp/internal/pose/testdata/review_brief_template_digests.json b/pose-mcp/internal/pose/testdata/review_brief_template_digests.json\nindex 8d941f7d..55f91c77 100644\n--- a/pose-mcp/internal/pose/testdata/review_brief_template_digests.json\n+++ b/pose-mcp/internal/pose/testdata/review_brief_template_digests.json\n@@ -1,7 +1,7 @@\n {\n   \"review-brief/1\": \"sha256:044c5e094cc0bc9f91268e64c8aa7af3c9e4a941b4d6516c7b2ed2e1b3a4de24\",\n   \"review-brief/10\": \"sha256:7bc73ce9b27c5360350867235a0a458ff96c4409f14df58cfec0caa64d3992a4\",\n-  \"review-brief/11\": \"sha256:cca9009b80d0292c2a9b3a012a4115cb3f1938923669c52448d7028dc7ec0d47\",\n+  \"review-brief/11\": \"sha256:b22f500119b2e8455b13eb3f0735ab1c48aca7028a2b2597d3c2c7e1aaf954c6\",\n   \"review-brief/2\": \"sha256:de1a8d85203b31bbda2fe4441348abfde0c2bb6b466febdb1a88731c9dfc4d1f\",\n   \"review-brief/3\": \"sha256:36231de8df017908ea02753d257660316d8ffb57f02a4b9e217ec87e4f9fbbfd\",\n   \"review-brief/4\": \"sha256:f6f98745b15e24041ef42b55bf19e4850b72610223b7c7662356a6c4383ab4e9\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HHFz18PanEGmTgvqbYubJa","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
