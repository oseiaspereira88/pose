{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015ZYzPEtSeN2nKEFwZReUqn","type":"tool_result","content":"3920\t\t// The findings this attestation records, so a criterion disposed as\n3921\t\t// `finding` can be checked against them. The CLI parser already refused a\n3922\t\t// criterion naming a finding it does not record; the Store did not, so any\n3923\t\t// other caller — a Store client, a signed import, a reuse — could approve a\n3924\t\t// criterion that explicitly did not pass while filing nothing. A signature\n3925\t\t// authenticates bytes; it does not repair a reference to something that\n3926\t\t// does not exist (spec pose-abm-review-soundness).\n3927\t\trecordedFindings := map[string]bool{}\n3928\t\tfor _, finding := range att.Findings {\n3929\t\t\trecordedFindings[finding.ID] = true\n3930\t\t}\n3931\t\tsealedClasses := map[string]bool{}\n3932\t\tfor _, ev := range bundle.Payload.Evidence {\n3933\t\t\tsealedClasses[ev.EvidenceClass] = true\n3934\t\t}\n3935\t\tjudgmentGoverned, _ := BundleGovernedBy(bundle, \"explicit-judgment\")\n3936\t\tif structuralGoverned, _ := BundleGovernedBy(bundle, \"structural-causality\"); structuralGoverned {\n3937\t\t\tblockers = append(blockers, s.reviewStructuralCausalityBlockers(bundle.Payload.Scope.Ref, bundle.Payload.Plan.Structure, required, att.Criteria)...)\n3938\t\t}\n3939\t\tif closeoutGoverned, _ := BundleGovernedBy(bundle, CausalityCloseoutContract); closeoutGoverned {\n3940\t\t\tblockers = append(blockers, s.reviewCausalityCloseoutBlockers(bundle.Payload.Scope.Ref, bundle.Payload.Plan.Structure, bundle.Payload.Plan.Band, required, att.Criteria)...)\n3941\t\t}\n3942\t\t// Validation evidence can be required by implementation components even\n3943\t\t// when no delivery target is declared. A target-gated tool must use the\n3944\t\t// sealed declaration, not the broader evidence requirement.\n3945\t\thasDeliveryTarget := len(bundle.Payload.Scope.Deliveries) > 0\n3946\t\tif bundle.Payload.Scope.Kind != \"spec\" {\n3947\t\t\ttoolScope, _ := ParseScopeRef(bundle.Payload.Scope.Ref)\n3948\t\t\ttoolGraph, _ := s.GetDeliveryIntegrity(\"\")\n3949\t\t\thasDeliveryTarget = s.reviewScopeRequiresValidationEvidence(toolScope, bundle.Payload.Plan, toolGraph)\n3950\t\t}\n3951\t\tseen := map[string]bool{}\n3952\t\tnotApplicable := 0\n3953\t\tfor _, criterion := range att.Criteria {\n3954\t\t\tif seen[criterion.ID] {\n3955\t\t\t\tblockers = append(blockers, \"duplicate criterion \"+criterion.ID)\n3956\t\t\t}\n3957\t\t\tseen[criterion.ID] = true\n3958\t\t\tplanned, known := required[criterion.ID]\n3959\t\t\tif !known {\n3960\t\t\t\tblockers = append(blockers, \"unknown criterion \"+criterion.ID)\n3961\t\t\t}\n3962\t\t\tif criterion.Disposition != \"passed\" && criterion.Disposition != \"not-applicable\" && criterion.Disposition != \"finding\" {\n3963\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" has invalid disposition\")\n3964\t\t\t}\n3965\t\t\tif criterion.Disposition == \"not-applicable\" {\n3966\t\t\t\tnotApplicable++\n3967\t\t\t\tif criterion.Rationale == \"\" {\n3968\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" lacks not-applicable rationale\")\n3969\t\t\t\t}\n3970\t\t\t\t// Inapplicability and absence are different states, and only one of\n3971\t\t\t\t// them is an answer. A criterion that asks for a class the bundle\n3972\t\t\t\t// actually seals is applicable by construction: dispensing with it\n3973\t\t\t\t// would be reading missing judgment as missing relevance.\n3974\t\t\t\t//\n3975\t\t\t\t// Gated, unlike the finding-reference rule beside it. That one is\n3976\t\t\t\t// referential integrity — a criterion naming a finding nobody filed\n3977\t\t\t\t// is incomplete under any policy, and no stored record does it. This\n3978\t\t\t\t// one is a stricter judgment default, and 12 of the 499 attestations\n3979\t\t\t\t// in the two repositories would fail it. Holding a review to a rule\n3980\t\t\t\t// that did not exist when it was given is what the sealed-contract\n3981\t\t\t\t// mechanism exists to prevent.\n3982\t\t\t\tif known && judgmentGoverned {\n3983\t\t\t\t\tfor _, class := range planned.EvidenceClasses {\n3984\t\t\t\t\t\tif sealedClasses[class] {\n3985\t\t\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" is not-applicable while the bundle seals evidence of class \"+class+\"; missing judgment is a pendency, not inapplicability\")\n3986\t\t\t\t\t\t\tbreak\n3987\t\t\t\t\t\t}\n3988\t\t\t\t\t}\n3989\t\t\t\t}\n3990\t\t\t}\n3991\t\t\tif criterion.Disposition == \"finding\" {\n3992\t\t\t\tif criterion.Evidence == \"\" {\n3993\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" is disposed as a finding and names none\")\n3994\t\t\t\t} else if !recordedFindings[criterion.Evidence] {\n3995\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" names finding \"+criterion.Evidence+\", which this attestation does not record\")\n3996\t\t\t\t}\n3997\t\t\t}\n3998\t\t\tif criterion.Disposition == \"passed\" {\n3999\t\t\t\tif !skipEvidenceSupport {\n4000\t\t\t\t\tblockers = append(blockers, reviewCriterionEvidenceBlockers(bundle, planned, criterion)...)\n4001\t\t\t\t}\n4002\t\t\t\t// A judged criterion passes on a conclusion, not on a reference.\n4003\t\t\t\t// Gated on the contract the bundle sealed, so the 470 attestations\n4004\t\t\t\t// recorded before it keep their verdict and stay readable: this\n4005\t\t\t\t// raises the bar for reviews taken under the contract, and never\n4006\t\t\t\t// re-judges one taken before it existed.\n4007\t\t\t\tif judgmentGoverned && known && ReviewCriterionKind(planned) == ReviewCriterionKindJudgment && strings.TrimSpace(criterion.Rationale) == \"\" {\n4008\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" is a judgment criterion passed with no conclusion; record what was examined and what it concluded\")\n4009\t\t\t\t}\n4010\t\t\t}\n4011\t\t}\n4012\t\tfor id := range required {\n4013\t\t\tif !seen[id] {\n4014\t\t\t\tblockers = append(blockers, \"missing criterion \"+id)\n4015\t\t\t}\n4016\t\t}\n4017\t\t// Every criterion dispensed with is not a review of anything. The engine\n4018\t\t// cannot judge whether one dispensation is honest, but it can refuse the\n4019\t\t// degenerate case, where the attestation states that nothing the plan asked\n4020\t\t// about applies to the change it approves.\n4021\t\t//\n4022\t\t// Bounded to a scope that carries a delivery target, because the other case\n4023\t\t// is already modelled and already honest: a documentation-only spec collects\n4024\t\t// no validation evidence by design, and recording every criterion\n4025\t\t// not-applicable — naming what is missing — is the answer the engine itself\n4026\t\t// prepares for it. Refusing that would break the distinction this contract\n4027\t\t// depends on rather than reinforce it.\n4028\t\tif judgmentGoverned && hasDeliveryTarget && len(required) > 0 && notApplicable == len(required) && len(att.Criteria) == len(required) {\n4029\t\t\tblockers = append(blockers, \"every required criterion is not-applicable; a scope where the whole plan is inapplicable is not reviewed by it\")\n4030\t\t}\n4031\t\treuseBlockers, _ := s.evaluateReviewReuse(bundle, att, bundle.Payload.SealedGates().AllowCriterionReuse)\n4032\t\tblockers = append(blockers, reuseBlockers...)\n4033\t\tsealedEvidence := map[string]ReviewBundleEvidence{}\n4034\t\tfor _, ev := range bundle.Payload.Evidence {\n4035\t\t\tsealedEvidence[ev.EvidenceClass+\":\"+ev.ID] = ev\n4036\t\t}\n4037\t\tif skipEvidenceSupport {\n4038\t\t\tsealedEvidence = nil\n4039\t\t}\n4040\t\ttoolWarnings, toolBlockers := evaluateReviewToolCoverageIn(s.fsys(), s.Root, bundle.Payload.Plan.Tools, att.Tools, sealedEvidence, hasDeliveryTarget)\n4041\t\t_ = toolWarnings\n4042\t\tblockers = append(blockers, toolBlockers...)\n4043\t\tblockers = append(blockers, reviewFindingDecisionBlockers(bundle, att)...)\n4044\t\treturn blockers\n4045\t}\n4046\t\n4047\t// The same finding and decision gate protects fresh and reused approvals.\n4048\tfunc reviewFindingDecisionBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n4049\t\tblockers := []string{}\n4050\t\t// The finding contract, which this path did not have. It accepted a\n4051\t\t// `critical` risk with no owner, no rationale and no review date; a\n4052\t\t// disposition the engine does not know; and a finding with neither severity\n4053\t\t// nor action — all three with no blocker at all, while the legacy attempt\n4054\t\t// path refused every one of them. A project that adopted review bundles\n4055\t\t// silently lost the gate (spec\n4056\t\t// pose-bundle-findings-take-the-contract-the-legacy-path-had).\n4057\t\t//\n4058\t\t// Only the accepted-risk severities and the reservations flag come from the\n4059\t\t// sealed gates. The rest is not configuration: a finding without a severity\n4060\t\t// is incomplete under any policy.\n4061\t\tallowedRisk := map[string]bool{}\n4062\t\tfor _, severity := range bundle.Payload.SealedGates().AcceptedRiskSeverities {\n4063\t\t\tallowedRisk[severity] = true\n4064\t\t}\n4065\t\tseenFindings := map[string]bool{}\n4066\t\tfor _, finding := range att.Findings {\n4067\t\t\tif seenFindings[finding.ID] {\n4068\t\t\t\tblockers = append(blockers, \"duplicate finding \"+finding.ID)\n4069\t\t\t}\n4070\t\t\tseenFindings[finding.ID] = true\n4071\t\t\tif finding.Severity == \"\" || finding.Action == \"\" {\n4072\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" lacks severity or action\")\n4073\t\t\t}\n4074\t\t\tswitch finding.Disposition {\n4075\t\t\tcase \"resolved\":\n4076\t\t\tcase \"accepted-risk\", \"wont-fix\":\n4077\t\t\t\t// Leaving a finding unresolved accepts its risk regardless of the\n4078\t\t\t\t// disposition's spelling. Use the policy frozen into this bundle.\n4079\t\t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n4080\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n4081\t\t\t\t}\n4082\t\t\tcase \"within-limit\":\n4083\t\t\t\t// Inside a limit the spec declared and the bundle sealed, whatever\n4084\t\t\t\t// its severity; a limit the bundle did not seal accepts nothing\n4085\t\t\t\t// (spec pose-review-declared-threat-model R3).\n4086\t\t\t\tif !sealedAcceptedLimit(bundle, finding.Limit) {\n4087\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" names accepted limit \"+firstNonempty(finding.Limit, \"(none)\")+\", which this bundle did not seal\")\n4088\t\t\t\t} else if strings.TrimSpace(finding.Rationale) == \"\" {\n4089\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is within limit \"+finding.Limit+\" without saying why\")\n4090\t\t\t\t}\n4091\t\t\tcase \"open\", \"changes-requested\":\n4092\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n4093\t\t\tdefault:\n4094\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has invalid disposition\")\n4095\t\t\t}\n4096\t\t}\n4097\t\tif att.Decision != \"approved\" && !(att.Decision == \"approved-with-reservations\" && bundle.Payload.SealedGates().AllowApprovedWithReservations) {\n4098\t\t\tblockers = append(blockers, \"review decision does not permit closeout: \"+att.Decision)\n4099\t\t}\n4100\t\treturn blockers\n4101\t}\n4102\t\n4103\tfunc (s Store) verifyStoredReviewAttestationSignature(att ReviewAttestation) error {\n4104\t\tif att.Envelope == nil {\n4105\t\t\t// Recorded before signing was required, and sealed unchanged into a\n4106\t\t\t// trusted legacy ledger (spec pose-signed-legacy-attestation-ledger).\n4107\t\t\tif s.legacyLedgerCovers(att) {\n4108\t\t\t\treturn nil\n4109\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"a9ca76ff-54d0-4828-8c74-e91b16bc4198","timestamp":"2026-11-26T04:23:45.958Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-1702975921/worktree/pose-mcp/internal/pose/review_bundle.go","content":"\t// The findings this attestation records, so a criterion disposed as\n\t// `finding` can be checked against them. The CLI parser already refused a\n\t// criterion naming a finding it does not record; the Store did not, so any\n\t// other caller — a Store client, a signed import, a reuse — could approve a\n\t// criterion that explicitly did not pass while filing nothing. A signature\n\t// authenticates bytes; it does not repair a reference to something that\n\t// does not exist (spec pose-abm-review-soundness).\n\trecordedFindings := map[string]bool{}\n\tfor _, finding := range att.Findings {\n\t\trecordedFindings[finding.ID] = true\n\t}\n\tsealedClasses := map[string]bool{}\n\tfor _, ev := range bundle.Payload.Evidence {\n\t\tsealedClasses[ev.EvidenceClass] = true\n\t}\n\tjudgmentGoverned, _ := BundleGovernedBy(bundle, \"explicit-judgment\")\n\tif structuralGoverned, _ := BundleGovernedBy(bundle, \"structural-causality\"); structuralGoverned {\n\t\tblockers = append(blockers, s.reviewStructuralCausalityBlockers(bundle.Payload.Scope.Ref, bundle.Payload.Plan.Structure, required, att.Criteria)...)\n\t}\n\tif closeoutGoverned, _ := BundleGovernedBy(bundle, CausalityCloseoutContract); closeoutGoverned {\n\t\tblockers = append(blockers, s.reviewCausalityCloseoutBlockers(bundle.Payload.Scope.Ref, bundle.Payload.Plan.Structure, bundle.Payload.Plan.Band, required, att.Criteria)...)\n\t}\n\t// Validation evidence can be required by implementation components even\n\t// when no delivery target is declared. A target-gated tool must use the\n\t// sealed declaration, not the broader evidence requirement.\n\thasDeliveryTarget := len(bundle.Payload.Scope.Deliveries) > 0\n\tif bundle.Payload.Scope.Kind != \"spec\" {\n\t\ttoolScope, _ := ParseScopeRef(bundle.Payload.Scope.Ref)\n\t\ttoolGraph, _ := s.GetDeliveryIntegrity(\"\")\n\t\thasDeliveryTarget = s.reviewScopeRequiresValidationEvidence(toolScope, bundle.Payload.Plan, toolGraph)\n\t}\n\tseen := map[string]bool{}\n\tnotApplicable := 0\n\tfor _, criterion := range att.Criteria {\n\t\tif seen[criterion.ID] {\n\t\t\tblockers = append(blockers, \"duplicate criterion \"+criterion.ID)\n\t\t}\n\t\tseen[criterion.ID] = true\n\t\tplanned, known := required[criterion.ID]\n\t\tif !known {\n\t\t\tblockers = append(blockers, \"unknown criterion \"+criterion.ID)\n\t\t}\n\t\tif criterion.Disposition != \"passed\" && criterion.Disposition != \"not-applicable\" && criterion.Disposition != \"finding\" {\n\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" has invalid disposition\")\n\t\t}\n\t\tif criterion.Disposition == \"not-applicable\" {\n\t\t\tnotApplicable++\n\t\t\tif criterion.Rationale == \"\" {\n\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" lacks not-applicable rationale\")\n\t\t\t}\n\t\t\t// Inapplicability and absence are different states, and only one of\n\t\t\t// them is an answer. A criterion that asks for a class the bundle\n\t\t\t// actually seals is applicable by construction: dispensing with it\n\t\t\t// would be reading missing judgment as missing relevance.\n\t\t\t//\n\t\t\t// Gated, unlike the finding-reference rule beside it. That one is\n\t\t\t// referential integrity — a criterion naming a finding nobody filed\n\t\t\t// is incomplete under any policy, and no stored record does it. This\n\t\t\t// one is a stricter judgment default, and 12 of the 499 attestations\n\t\t\t// in the two repositories would fail it. Holding a review to a rule\n\t\t\t// that did not exist when it was given is what the sealed-contract\n\t\t\t// mechanism exists to prevent.\n\t\t\tif known && judgmentGoverned {\n\t\t\t\tfor _, class := range planned.EvidenceClasses {\n\t\t\t\t\tif sealedClasses[class] {\n\t\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" is not-applicable while the bundle seals evidence of class \"+class+\"; missing judgment is a pendency, not inapplicability\")\n\t\t\t\t\t\tbreak\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif criterion.Disposition == \"finding\" {\n\t\t\tif criterion.Evidence == \"\" {\n\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" is disposed as a finding and names none\")\n\t\t\t} else if !recordedFindings[criterion.Evidence] {\n\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" names finding \"+criterion.Evidence+\", which this attestation does not record\")\n\t\t\t}\n\t\t}\n\t\tif criterion.Disposition == \"passed\" {\n\t\t\tif !skipEvidenceSupport {\n\t\t\t\tblockers = append(blockers, reviewCriterionEvidenceBlockers(bundle, planned, criterion)...)\n\t\t\t}\n\t\t\t// A judged criterion passes on a conclusion, not on a reference.\n\t\t\t// Gated on the contract the bundle sealed, so the 470 attestations\n\t\t\t// recorded before it keep their verdict and stay readable: this\n\t\t\t// raises the bar for reviews taken under the contract, and never\n\t\t\t// re-judges one taken before it existed.\n\t\t\tif judgmentGoverned && known && ReviewCriterionKind(planned) == ReviewCriterionKindJudgment && strings.TrimSpace(criterion.Rationale) == \"\" {\n\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" is a judgment criterion passed with no conclusion; record what was examined and what it concluded\")\n\t\t\t}\n\t\t}\n\t}\n\tfor id := range required {\n\t\tif !seen[id] {\n\t\t\tblockers = append(blockers, \"missing criterion \"+id)\n\t\t}\n\t}\n\t// Every criterion dispensed with is not a review of anything. The engine\n\t// cannot judge whether one dispensation is honest, but it can refuse the\n\t// degenerate case, where the attestation states that nothing the plan asked\n\t// about applies to the change it approves.\n\t//\n\t// Bounded to a scope that carries a delivery target, because the other case\n\t// is already modelled and already honest: a documentation-only spec collects\n\t// no validation evidence by design, and recording every criterion\n\t// not-applicable — naming what is missing — is the answer the engine itself\n\t// prepares for it. Refusing that would break the distinction this contract\n\t// depends on rather than reinforce it.\n\tif judgmentGoverned && hasDeliveryTarget && len(required) > 0 && notApplicable == len(required) && len(att.Criteria) == len(required) {\n\t\tblockers = append(blockers, \"every required criterion is not-applicable; a scope where the whole plan is inapplicable is not reviewed by it\")\n\t}\n\treuseBlockers, _ := s.evaluateReviewReuse(bundle, att, bundle.Payload.SealedGates().AllowCriterionReuse)\n\tblockers = append(blockers, reuseBlockers...)\n\tsealedEvidence := map[string]ReviewBundleEvidence{}\n\tfor _, ev := range bundle.Payload.Evidence {\n\t\tsealedEvidence[ev.EvidenceClass+\":\"+ev.ID] = ev\n\t}\n\tif skipEvidenceSupport {\n\t\tsealedEvidence = nil\n\t}\n\ttoolWarnings, toolBlockers := evaluateReviewToolCoverageIn(s.fsys(), s.Root, bundle.Payload.Plan.Tools, att.Tools, sealedEvidence, hasDeliveryTarget)\n\t_ = toolWarnings\n\tblockers = append(blockers, toolBlockers...)\n\tblockers = append(blockers, reviewFindingDecisionBlockers(bundle, att)...)\n\treturn blockers\n}\n\n// The same finding and decision gate protects fresh and reused approvals.\nfunc reviewFindingDecisionBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n\tblockers := []string{}\n\t// The finding contract, which this path did not have. It accepted a\n\t// `critical` risk with no owner, no rationale and no review date; a\n\t// disposition the engine does not know; and a finding with neither severity\n\t// nor action — all three with no blocker at all, while the legacy attempt\n\t// path refused every one of them. A project that adopted review bundles\n\t// silently lost the gate (spec\n\t// pose-bundle-findings-take-the-contract-the-legacy-path-had).\n\t//\n\t// Only the accepted-risk severities and the reservations flag come from the\n\t// sealed gates. The rest is not configuration: a finding without a severity\n\t// is incomplete under any policy.\n\tallowedRisk := map[string]bool{}\n\tfor _, severity := range bundle.Payload.SealedGates().AcceptedRiskSeverities {\n\t\tallowedRisk[severity] = true\n\t}\n\tseenFindings := map[string]bool{}\n\tfor _, finding := range att.Findings {\n\t\tif seenFindings[finding.ID] {\n\t\t\tblockers = append(blockers, \"duplicate finding \"+finding.ID)\n\t\t}\n\t\tseenFindings[finding.ID] = true\n\t\tif finding.Severity == \"\" || finding.Action == \"\" {\n\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" lacks severity or action\")\n\t\t}\n\t\tswitch finding.Disposition {\n\t\tcase \"resolved\":\n\t\tcase \"accepted-risk\", \"wont-fix\":\n\t\t\t// Leaving a finding unresolved accepts its risk regardless of the\n\t\t\t// disposition's spelling. Use the policy frozen into this bundle.\n\t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n\t\t\t}\n\t\tcase \"within-limit\":\n\t\t\t// Inside a limit the spec declared and the bundle sealed, whatever\n\t\t\t// its severity; a limit the bundle did not seal accepts nothing\n\t\t\t// (spec pose-review-declared-threat-model R3).\n\t\t\tif !sealedAcceptedLimit(bundle, finding.Limit) {\n\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" names accepted limit \"+firstNonempty(finding.Limit, \"(none)\")+\", which this bundle did not seal\")\n\t\t\t} else if strings.TrimSpace(finding.Rationale) == \"\" {\n\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is within limit \"+finding.Limit+\" without saying why\")\n\t\t\t}\n\t\tcase \"open\", \"changes-requested\":\n\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n\t\tdefault:\n\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has invalid disposition\")\n\t\t}\n\t}\n\tif att.Decision != \"approved\" && !(att.Decision == \"approved-with-reservations\" && bundle.Payload.SealedGates().AllowApprovedWithReservations) {\n\t\tblockers = append(blockers, \"review decision does not permit closeout: \"+att.Decision)\n\t}\n\treturn blockers\n}\n\nfunc (s Store) verifyStoredReviewAttestationSignature(att ReviewAttestation) error {\n\tif att.Envelope == nil {\n\t\t// Recorded before signing was required, and sealed unchanged into a\n\t\t// trusted legacy ledger (spec pose-signed-legacy-attestation-ledger).\n\t\tif s.legacyLedgerCovers(att) {\n\t\t\treturn nil\n\t\t}","numLines":190,"startLine":3920,"totalLines":4951}},"tool_result_meta":[{"id":"toolu_015ZYzPEtSeN2nKEFwZReUqn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
