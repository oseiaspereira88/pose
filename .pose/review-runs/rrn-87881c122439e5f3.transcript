{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0132ni95XXkGYarPWBWCv3j2","type":"tool_result","content":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://pose.dev/schemas/v1/review-attestation.schema.json\",\n  \"title\": \"POSE review attestation\",\n  \"type\": \"object\",\n  \"additionalProperties\": true,\n  \"required\": [\"schema_version\", \"attestation_id\", \"bundle_id\", \"bundle_digest\", \"reviewer\", \"decision\", \"criteria\", \"findings\", \"attested_at\"],\n  \"$defs\": {\n    \"criterionDisposition\": {\n      \"type\": \"object\", \"additionalProperties\": true,\n      \"required\": [\"id\", \"disposition\"],\n      \"properties\": {\n        \"id\": {\"type\": \"string\"},\n        \"disposition\": {\"enum\": [\"passed\", \"not-applicable\", \"finding\"]},\n        \"evidence\": {\"type\": \"string\"},\n        \"rationale\": {\"type\": \"string\"},\n        \"mappings\": {\n          \"comment\": \"One answer per material structural fact, required when the planned criterion declares requires_structural_mapping. Either a basis that reaches a requirement or constraint, or one of the three explicit non-mappings with a rationale.\",\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\", \"additionalProperties\": true,\n            \"required\": [\"delta\"],\n            \"properties\": {\n              \"delta\": {\"type\": \"string\", \"pattern\": \"^SD-[0-9a-f]{8,12}$\"},\n              \"basis\": {\"type\": \"string\", \"pattern\": \"^[RACD][0-9]+$\"},\n              \"disposition\": {\"enum\": [\"mapped\", \"missing-evidence\", \"not-applicable\", \"accepted-risk\"]},\n              \"rationale\": {\"type\": \"string\"}\n            }\n          }\n        }\n      }\n    }\n  },\n  \"properties\": {\n    \"schema_version\": {\"const\": 1},\n    \"attestation_id\": {\"type\": \"string\", \"pattern\": \"^rva-[a-f0-9]{16}$\"},\n    \"bundle_id\": {\"type\": \"string\", \"pattern\": \"^rvb-[a-f0-9]{16}$\"},\n    \"bundle_digest\": {\"type\": \"string\", \"pattern\": \"^sha256:[a-f0-9]{64}$\"},\n    \"reviewer\": {\"type\": \"string\", \"pattern\": \"^(agent|human):[^\\\\r\\\\n]+$\"},\n    \"decision\": {\"enum\": [\"approved\", \"approved-with-reservations\", \"changes-requested\", \"rejected\"]},\n    \"criteria\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/criterionDisposition\"}},\n    \"tools\": {\"type\": \"array\", \"items\": {\"type\": \"object\"}},\n    \"evidence_refs\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n    \"findings\": {\"type\": \"array\", \"items\": {\"type\": \"object\"}},\n    \"attribution\": {\n      \"description\": \"Who prepared, concluded, confirmed and applied the review (spec pose-review-attribution-roles). Optional; absent on legacy records, which render as legacy-undifferentiated. Never derived from reviewer.\",\n      \"type\": \"object\", \"additionalProperties\": false,\n      \"required\": [\"schema_version\"],\n      \"properties\": {\n        \"schema_version\": {\"const\": 1},\n        \"prepared_by\": {\"type\": \"string\", \"pattern\": \"^(agent|human):[^\\\\r\\\\n]+$\"},\n        \"concluded_by\": {\"type\": \"string\", \"pattern\": \"^(agent|human):[^\\\\r\\\\n]+$\"},\n        \"confirmed_by\": {\"type\": \"string\", \"pattern\": \"^(agent|human):[^\\\\r\\\\n]+$\"},\n        \"applied_by\": {\"type\": \"string\", \"pattern\": \"^(agent|human):[^\\\\r\\\\n]+$\"},\n        \"confirmation_mode\": {\"enum\": [\"none\", \"adopted-conclusions\", \"authorized-operation\"]},\n        \"confirmation_digest\": {\"type\": \"string\", \"pattern\": \"^sha256:[0-9a-f]{64}$\"}\n      }\n    },\n    \"authority\": {\n      \"type\": \"object\",\n      \"required\": [\"schema_version\", \"project\", \"bundle_digest\", \"principal\", \"role\", \"review_execution\", \"issuer\", \"issued_at\", \"audience\"],\n      \"properties\": {\n        \"schema_version\": {\"const\": 1},\n        \"project\": {\"type\": \"string\", \"minLength\": 1},\n        \"bundle_digest\": {\"$ref\": \"review-bundle.schema.json#/$defs/digest\"},\n        \"principal\": {\"type\": \"string\", \"pattern\": \"^(agent|human):[^\\\\r\\\\n]+$\"},\n        \"role\": {\"enum\": [\"agent\", \"human\"]},\n        \"review_execution\": {\"type\": \"string\", \"minLength\": 1},\n        \"implementation_principal\": {\"type\": \"string\"},\n        \"implementation_execution\": {\"type\": \"string\"},\n        \"issuer\": {\"type\": \"string\", \"minLength\": 1},\n        \"issued_at\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"expires_at\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"audience\": {\"type\": \"string\", \"minLength\": 1}\n      }\n    },\n    \"reused_from\": {\"type\": \"array\", \"items\": {\"type\": \"object\"}},\n    \"supersedes\": {\"type\": \"string\"},\n    \"envelope\": {\n      \"type\": \"object\",\n      \"required\": [\"issuer\", \"subject\", \"algorithm\", \"public_key\", \"signature\"],\n      \"properties\": {\n        \"issuer\": {\"type\": \"string\"},\n        \"subject\": {\"type\": \"string\", \"pattern\": \"^rvb-[a-f0-9]{16}$\"},\n        \"algorithm\": {\"const\": \"ed25519\"},\n        \"public_key\": {\"type\": \"string\"},\n        \"signature\": {\"type\": \"string\"}\n      }\n    },\n    \"attested_at\": {\"type\": \"string\", \"format\": \"date-time\"},\n    \"path\": {\"type\": \"string\"}\n  }\n}\ndocs-site/docs/cli.md\npose-mcp/schemas/README.md\npose-mcp/schemas/v1/artifact.schema.json\npose-mcp/schemas/v1/closeout-receipt.schema.json\npose-mcp/schemas/v1/contract-nodes.schema.json\npose-mcp/schemas/v1/gate-result.schema.json\npose-mcp/schemas/v1/insights.schema.json\npose-mcp/schemas/v1/obligation.schema.json\npose-mcp/schemas/v1/review-attestation-envelope.schema.json\npose-mcp/schemas/v1/review-attestation.schema.json\npose-mcp/schemas/v1/review-bundle.schema.jso