{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FjCXZiG83kUAXxrk7MhXFF","type":"tool_result","content":"\t\tif newestVerified != \"\" && compareReleaseVersions(release.Version, newestVerified) <= 0 {\n\t\t\tcontinue\n\t\t}\n\t\t// A release left prepared or failed while a later one moved on was\n\t\t// abandoned for it.\n\t\tif (release.State == \"prepared\" || release.State == \"failed\") && newestProgressed != \"\" && compareReleaseVersions(release.Version, newestProgressed) < 0 {\n\t\t\tcontinue\n\t\t}\n\t\to := newObligation(project, \"release\", projectNode(project, \"release\", obligationNodeID(release.Version)), \"release-lifecycle\", release.Version)\n\t\to.Category = ObligationRelease\n\t\to.ReasonCode = \"release-\" + release.State\n\t\to.Effects = []ObligationEffect{{Phase: PhaseRelease, Mode: EffectAdvisory}}\n\t\tswitch release.State {\n\t\tcase \"prepared\":\n\t\t\to.Condition = \"the release commit is tagged `\" + release.Version + \"`\"\n\t\t\to.Waiting = WaitingExecution\n\t\tcase \"tagged\":\n\t\t\to.Condition = \"the release workflow publishes `\" + release.Version + \"` and its evidence is recorded\"\n\t\t\to.Waiting = WaitingExternal\n\t\tcase \"published\":\n\t\t\to.Condition = \"`pose release record --version \" + release.Version + \" --event verified --evidence <file>` binds verification to the publication\"\n\t\t\to.Waiting = WaitingExecution\n\t\tcase \"verified\":\n\t\t\to.Condition = \"the record of `\" + release.Version + \"` is made sound again (its tag, its snapshot or its files)\"\n\t\t\to.Waiting = WaitingExecution\n\t\tdefault:\n\t\t\to.Condition = \"the failure of `\" + release.Version + \"` is recovered and the release published\"\n\t\t\to.Waiting = WaitingExecution\n\t\t}\n\t\to.Message = \"release \" + release.Version + \" is \" + release.State\n\t\tout = append(out, o)\n\t}\n\treturn out, nil\n}\n\n// findingObligations projects findings recorded outside review attestations\n// — in the latest review record of each scope — whose accepted risk or\n// follow-up has passed its review date. Open findings of a current review are\n// the review producer's; free-form investigation notes carry no state to\n// project.\nfunc (s Store) findingObligations(project string, now time.Time, coverage *Coverage, scope string, specs []Spec) ([]Obligation, error) {\n\tread, err := s.ReadReviewAttempts(\"\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tattempts := read.Attempts\n\t// A review record that could not be read may hold a finding that is due. A query\n\t// about one spec is incomplete only for the losses that can concern it: those\n\t// attributed to it or to nothing; a record that names another scope is not its loss.\n\tlost := []SourceLoss{}\n\tfor _, loss := range read.Coverage.Losses {\n\t\tconcerns := scope == \"\" || loss.Scope == \"\" || loss.Scope == scope\n\t\tif roadmap, ok := strings.CutPrefix(scope, \"roadmap:\"); ok {\n\t\t\t// A roadmap is reviewed with the milestones it contains.\n\t\t\tconcerns = concerns || strings.HasPrefix(loss.Scope, \"milestone:\"+roadmap+\"/\")\n\t\t}\n\t\tif rest, ok := strings.CutPrefix(scope, \"milestone:\"); ok {\n\t\t\t// A milestone is reviewed with its roadmap.\n\t\t\tif roadmap, _, found := strings.Cut(rest, \"/\"); found {\n\t\t\t\tconcerns = concerns || loss.Scope == \"roadmap:\"+roadmap\n\t\t\t}\n\t\t}\n\t\tfor _, sp := range specs {\n\t\t\tconcerns = concerns || loss.Scope == \"spec:\"+sp.Slug\n\t\t}\n\t\tif concerns {\n\t\t\tlost = append(lost, loss)\n\t\t}\n\t}\n\tif len(lost) > 0 && coverage != nil {\n\t\tmarkCoverageIncomplete(coverage, (SourceCoverage{Losses: lost}).Describe(\"\"))\n\t}\n\tlatest := map[string]ReviewAttempt{}\n\tfor _, attempt := range attempts {\n\t\tif old, ok := latest[attempt.Scope]; !ok || reviewInstantLess(old.ReviewedAt, old.ReviewID, attempt.ReviewedAt, attempt.ReviewID) {\n\t\t\tlatest[attempt.Scope] = attempt\n\t\t}\n\t}\n\ttoday := now.UTC().Format(\"2006-01-02\")\n\tscopes := make([]string, 0, len(latest))\n\tfor scope := range latest {\n\t\tscopes = append(scopes, scope)\n\t}\n\tsort.Strings(scopes)\n\tout := []Obligation{}\n\tfor _, scope := range scopes {\n\t\tattempt := latest[scope]\n\t\tfor _, finding := range attempt.Findings {\n\t\t\tif finding.Disposition != \"accepted-risk\" && finding.Disposition != \"follow-up\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif finding.ReviewBy == \"\" || finding.ReviewBy >= today {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\to := newObligation(project, \"findings\", projectNode(project, \"finding\", obligationNodeID(scope+\"/\"+finding.ID)), \"finding-review-due\", attempt.ReviewID+\"/\"+finding.ID)\n\t\t\to.Category = ObligationJudgment\n\t\t\to.ReasonCode = \"finding-\" + finding.Disposition + \"-overdue\"\n\t\t\to.Condition = \"the \" + finding.Disposition + \" finding \" + finding.ID + \" of \" + scope + \" is reconsidered and a superseding review records the outcome\"\n\t\t\to.Effects = []ObligationEffect{{Phase: PhaseRelease, Mode: EffectAdvisory}}\n\t\t\to.Waiting = WaitingExecution\n\t\t\tif owner := strings.TrimSpace(finding.Owner); owner != \"\" {\n\t\t\t\to.Recipient = ObligationActor{Principal: owner}\n\t\t\t\to.Waiting = WaitingActor\n\t\t\t}\n\t\t\to.Message = finding.ID + \" (\" + finding.Severity + \") in \" + scope + \" was due for review on \" + finding.ReviewBy\n\t\t\tout = append(out, o)\n\t\t}\n\t}\n\treturn out, nil\n}\ndiff --git a/pose-mcp/internal/pose/review_draft_check.go b/pose-mcp/internal/pose/review_draft_check.go\nnew file mode 100644\nindex 00000000..67188422\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_draft_check.go\n@@ -0,0 +1,128 @@\n+package pose\n+\n+// Draft check (spec pose-review-readiness-before-seal R3): the reasons the\n+// conclusion step and the attestation preflight would refuse a reviewer's\n+// draft, computed before the run ends and without writing anything. It\n+// reuses the same parsers and content checks; only the run's own proof,\n+// signature and identity, which do not exist yet, are left out.\n+//\n+// A sealed checkout holds the subject, not the bundle sealed over it nor the\n+// run ledger, so the dispatch writes both to the run's private directory and\n+// names it in ReviewDraftContextEnv.\n+\n+import (\n+\t\"encoding/json\"\n+\t\"fmt\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"time\"\n+)\n+\n+// ReviewDraftContextEnv names the file holding the bundle and round a draft\n+// is checked against inside a delegated review.\n+const ReviewDraftContextEnv = \"POSE_REVIEW_DRAFT_CONTEXT\"\n+\n+// ReviewCLIEnv names the executable of the engine that dispatched a review,\n+// so the reviewer checks its draft with it and not with another installed\n+// `pose` (review round 1).\n+const ReviewCLIEnv = \"POSE_REVIEW_CLI\"\n+\n+const reviewDraftContextSchema = \"pose.review-draft-context/v1\"\n+\n+// ReviewDraftContext is what a draft is judged against: the sealed bundle and\n+// the findings its round must account for.\n+type ReviewDraftContext struct {\n+\tSchema string              `json:\"schema\"`\n+\tBundle ReviewBundle        `json:\"bundle\"`\n+\tRound  int                 `json:\"round\"`\n+\tOpen   []ReviewOpenFinding `json:\"open,omitempty\"`\n+}\n+\n+// ReviewDraftContextFor builds the context of bundle from the run ledger.\n+func (s Store) ReviewDraftContextFor(bundle ReviewBundle) (ReviewDraftContext, error) {\n+\tround, err := s.ReviewRoundOf(bundle)\n+\tif err != nil {\n+\t\treturn ReviewDraftContext{}, err\n+\t}\n+\treturn ReviewDraftContext{Schema: reviewDraftContextSchema, Bundle: bundle, Round: round.Number, Open: round.Open}, nil\n+}\n+\n+// writeReviewDraftContext writes ctx under dir and returns its path.\n+func writeReviewDraftContext(dir string, ctx ReviewDraftContext) (string, error) {\n+\traw, err := json.Marshal(ctx)\n+\tif err != nil {\n+\t\treturn \"\", err\n+\t}\n+\tpath := filepath.Join(dir, \"pose-review-draft-context.json\")\n+\treturn path, os.WriteFile(path, raw, 0o600)\n+}\n+\n+// ReadReviewDraftContext reads a context file a dispatch wrote.\n+func ReadReviewDraftContext(path string) (ReviewDraftContext, error) {\n+\tvar ctx ReviewDraftContext\n+\traw, err := os.ReadFile(path)\n+\tif err != nil {\n+\t\treturn ctx, err\n+\t}\n+\tif err := json.Unmarshal(raw, &ctx); err != nil {\n+\t\treturn ctx, fmt.Errorf(\"pose: reading draft context %s: %w\", path, err)\n+\t}\n+\tif ctx.Schema != reviewDraftContextSchema || ctx.Bundle.BundleID == \"\" {\n+\t\treturn ctx, fmt.Errorf(\"pose: %s is not a review draft context\", path)\n+\t}\n+\treturn ctx, nil\n+}\n+\n+// CheckReviewDraft returns every reason a draft for ref would be refused at\n+// conclusion, or nil when none applies. ref is a bundle id, or a run id whose\n+// bundle is used.\n+func (s Store) CheckReviewDraft(ref, output string, now time.Time) ([]string, error) {\n+\tbundleID := ref\n+\tif strings.HasPrefix(ref, \"rrn-\") {\n+\t\trun, err := s.LoadProvenanceReviewRun(ref)\n+\t\tif err != nil {\n+\t\t\treturn nil, err\n+\t\t}\n+\t\tbundleID = run.BundleID\n+\t}\n+\tbundle, err := s.LoadReviewBundle(bundleID)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tctx, err := s.ReviewDraftContextFor(bundle)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\treturn s.CheckReviewDraftIn(ctx, output, now), nil\n+}\n+\n+// CheckReviewDraftIn judges output against ctx.\n+func (s Store) CheckReviewDraftIn(ctx ReviewDraftContext, output string, now time.Time) []string {\n+\tvar reasons []string\n+\tdraft, err := ParseReviewDraft(output)\n+\tswitch {\n+\tcase err != nil:\n+\t\treasons = append(reasons, \"the conclusion cannot be read: \"+err.Error())\n+\tcase draft == nil:\n+\t\treasons = append(reasons, \"the final message carries no pose-draft block\")\n+\t}\n+\tif err == nil {\n+\t\tround := ReviewRound{Number: ctx.Round, Open: ctx.Open}\n+\t\tif problems := ValidateRoundDraft(round, output); len(problems) > 0 {\n+\t\t\treasons = append(reasons, \"the draft does not account for its round: \"+strings.Join(problems, \"; \"))\n+\t\t}\n+\t}\n+\tif draft != nil && reviewDecisionApproves(draft.Decision) {\n+\t\tbundle := ctx.Bundle\n+\t\trun := ReviewRun{RunID: \"draft-check\", BundleID: bundle.BundleID, Kind: ReviewBriefKindReview}\n+\t\tatt := reviewAttestationFromDraft(run, bundle, *draft, \"agent:draft-check/unknown\")\n+\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\n+\t\tif err != nil {\n+\t\t\treasons = append(reasons, \"the attestation preflight refuses it: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n+\t\t} else if blockers := s.attestationContentBlockers(bundle, completed, false); len(blockers) > 0 {\n+\t\t\treasons = append(reasons, \"the attestation preflight refuses it: \"+strings.Join(uniqueSorted(blockers), \"; \"))\n+\t\t}\n+\t}\n+\treturn reasons\n+}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"2b27c65d-4746-4bcf-b077-9d290a8398ce","timestamp":"2026-11-26T04:23:33.506Z","tool_use_result":{"stdout":"\t\tif newestVerified != \"\" && compareReleaseVersions(release.Version, newestVerified) <= 0 {\n\t\t\tcontinue\n\t\t}\n\t\t// A release left prepared or failed while a later one moved on was\n\t\t// abandoned for it.\n\t\tif (release.State == \"prepared\" || release.State == \"failed\") && newestProgressed != \"\" && compareReleaseVersions(release.Version, newestProgressed) < 0 {\n\t\t\tcontinue\n\t\t}\n\t\to := newObligation(project, \"release\", projectNode(project, \"release\", obligationNodeID(release.Version)), \"release-lifecycle\", release.Version)\n\t\to.Category = ObligationRelease\n\t\to.ReasonCode = \"release-\" + release.State\n\t\to.Effects = []ObligationEffect{{Phase: PhaseRelease, Mode: EffectAdvisory}}\n\t\tswitch release.State {\n\t\tcase \"prepared\":\n\t\t\to.Condition = \"the release commit is tagged `\" + release.Version + \"`\"\n\t\t\to.Waiting = WaitingExecution\n\t\tcase \"tagged\":\n\t\t\to.Condition = \"the release workflow publishes `\" + release.Version + \"` and