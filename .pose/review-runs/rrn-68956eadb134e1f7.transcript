$i -lt 200 ]; do sleep 0.1; i=$((i+1)); done; fi; \")\n\tif !strings.Contains(agent, marks) {\n\t\tt.Fatal(\"agent not patched\")\n\t}\n\twriteDelegation(t, root, delegationPolicy(agent))\n\tfirst := runRecord(t, root, roundRun(t, root, \"rounder\")[\"run\"].(string))\n\tnextReviewRound(t, root, \"fix B1\")\n\ts := posemodel.Store{Root: root}\n\tplan, err := s.PlanReviewDispatch(\"spec:alpha\", \"review\", \"\", \"rounder\", \"live round\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdone := make(chan string, 1)\n\tgo func() {\n\t\tr, _ := s.RunReviewDispatch(plan, time.Now)\n\t\tdone <- r.Status + \" \" + r.Safety.RuntimeID\n\t}()\n\tfor i := 0; i < 100; i++ {\n\t\tif _, err := os.Stat(marks + \"/live\"); err == nil {\n\t\t\tbreak\n\t\t}\n\t\ttime.Sleep(100 * time.Millisecond)\n\t}\n\tnextReviewRound(t, root, \"fix B2\")\n\tsecond := runRecord(t, root, roundRun(t, root, \"rounder\")[\"run\"].(string))\n\tt.Logf(\"beside live: status=%s runtime=%s first=%s thread=%+v\", second.Status, second.Safety.RuntimeID, first.Safety.RuntimeID, second.Thread)\n\t_ = os.WriteFile(marks+\"/release\", nil, 0o600)\n\tt.Logf(\"live run: %s\", <-done)\n\t// A path taken between the plan and the dispatch.\n\tnextReviewRound(t, root, \"fix B3\")\n\tp, err := s.PlanReviewDispatch(\"spec:alpha\", \"review\", \"\", \"rounder\", \"race\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\theld := filepath.Join(os.TempDir(), second.Safety.RuntimeID)\n\tif err := os.Mkdir(held, 0o700); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tr, err := s.RunReviewDispatch(p, time.Now)\n\tt.Logf(\"after-plan: status=%s err=%v failure=%q\", r.Status, err, r.Failure)\n}\nEOF\nprintf '{\"Replace\":{\"%s/pose-mcp/internal/cli/zz_probe_test.go\":\"%s/probe_test.go\"}}\\n' \"$PWD\" \"$TMPDIR\" > \"$TMPDIR/overlay.json\"; XDG_STATE_HOME=\"$TMPDIR/state\" go -C pose-mcp test -overlay \"$TMPDIR/overlay.json\" ./internal/cli -run 'ZZ2' -count=1 -v 2>&1; git status --short","is_backgrounded":false,"task_type":"local_bash","uui