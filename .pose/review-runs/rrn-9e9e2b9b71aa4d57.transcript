{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014XskVGHazMixY25EWQzjWU","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"fmt\"\n6\t\t\"sort\"\n7\t\t\"strings\"\n8\t)\n9\t\n10\tvar (\n11\t\t// ErrGovernanceReadViewChanged means the captured input closure changed\n12\t\t// and could not be certified after a failed callback or the permitted retry.\n13\t\tErrGovernanceReadViewChanged = errors.New(\"pose: governance read view changed during capture\")\n14\t\t// ErrGovernanceReadViewUnknown means the operation could not prove the\n15\t\t// completeness of its captured input closure.\n16\t\tErrGovernanceReadViewUnknown = errors.New(\"pose: governance read view input closure is unknown\")\n17\t)\n18\t\n19\t// WithGovernanceReadView runs a read-only callback against one immutable view\n20\t// and audits that view before returning. A changed view is retried once; if\n21\t// the retry changes or any required observation is unknown, the callback must\n22\t// not be used to publish a derived result. The callback must keep its outputs\n23\t// in memory; publishers write through the caller's original guarded Store only\n24\t// after this method succeeds.\n25\tfunc (s Store) WithGovernanceReadView(producer string, run func(Store) error) error {\n26\t\tif run == nil {\n27\t\t\treturn errors.New(\"pose: governance read view callback is required\")\n28\t\t}\n29\t\tif producer == \"\" {\n30\t\t\treturn errors.New(\"pose: governance read view producer is required\")\n31\t\t}\n32\t\treturn withGovernanceReadViewCaptureAttempt(s.withoutGovernanceReadView(), producer, 0, false, func(store Store) (bool, error) {\n33\t\t\treturn true, run(store)\n34\t\t})\n35\t}\n36\t\n37\t// WithGovernanceReadViewForIndexBuild allows the callback to discover whether\n38\t// the index inputs depend on a Git source revision. A missing primary HEAD is\n39\t// captured and audited as data; the callback returns true when that revision\n40\t// is semantically required by the generation it produced.\n41\tfunc (s Store) WithGovernanceReadViewForIndexBuild(producer string, run func(Store) (requiresPrimaryRevision bool, err error)) error {\n42\t\tif run == nil {\n43\t\t\treturn errors.New(\"pose: governance read view callback is required\")\n44\t\t}\n45\t\tif producer == \"\" {\n46\t\t\treturn errors.New(\"pose: governance read view producer is required\")\n47\t\t}\n48\t\treturn withGovernanceReadViewCaptureAttempt(s.withoutGovernanceReadView(), producer, 0, true, run)\n49\t}\n50\t\n51\tfunc withGovernanceReadViewCaptureAttempt(s Store, producer string, attempt int, allowMissingPrimaryRevision bool, run func(Store) (bool, error)) error {\n52\t\tbase, view := s.beginGovernanceReadView(allowMissingPrimaryRevision)\n53\t\tstore := base.withGovernanceReadView(view, producer).PinIndexes()\n54\t\tif !allowMissingPrimaryRevision {\n55\t\t\t_, _ = captureGovernanceSourceRevision(store.fsys(), store.Root, producer)\n56\t\t}\n57\t\trequiresPrimaryRevision, err := run(store)\n58\t\tif err != nil {\n59\t\t\t// A callback can translate a failed read into a domain error. Preserve\n60\t\t\t// that error and the independently audited closure failure, without\n61\t\t\t// retrying a callback that has already failed.\n62\t\t\taudit := view.audit()\n63\t\t\tauditErr := governanceReadViewUnknownError(audit)\n64\t\t\tif governanceReviewAuditChanged(audit) {\n65\t\t\t\tauditErr = errors.Join(auditErr, ErrGovernanceReadViewChanged)\n66\t\t\t}\n67\t\t\tif auditErr == nil {\n68\t\t\t\treturn err\n69\t\t\t}\n70\t\t\treturn errors.Join(err, auditErr)\n71\t\t}\n72\t\tif requiresPrimaryRevision {\n73\t\t\tview.operation.requirePrimaryRevision(producer)\n74\t\t}\n75\t\taudit := view.audit()\n76\t\tchanged := governanceReviewAuditChanged(audit)\n77\t\tif changed && attempt == 0 {\n78\t\t\treturn withGovernanceReadViewCaptureAttempt(base.withoutGovernanceReadView(), producer, 1, allowMissingPrimaryRevision, run)\n79\t\t}\n80\t\tif changed {\n81\t\t\treturn ErrGovernanceReadViewChanged\n82\t\t}\n83\t\treturn governanceReadViewUnknownError(audit)\n84\t}\n85\t\n86\t// Summaries contain producer labels and audit reasons, excluding observed paths\n87\t// and the underlying path-bearing details of root/index resolution failures.\n88\tfunc governanceReadViewUnknownError(audit governanceReadViewAudit) error {\n89\t\tif len(audit.UnknownProducers) > 0 {\n90\t\t\tproducers := make([]string, 0, len(audit.UnknownProducers))\n91\t\t\tfor producer := range audit.UnknownProducers {\n92\t\t\t\tproducers = append(producers, producer)\n93\t\t\t}\n94\t\t\tsort.Strings(producers)\n95\t\t\tclip := func(value string, limit int) string {\n96\t\t\t\tif len(value) <= limit {\n97\t\t\t\t\treturn value\n98\t\t\t\t}\n99\t\t\t\treturn value[:limit-3] + \"...\"\n100\t\t\t}\n101\t\t\tvar summary strings.Builder\n102\t\t\tfor i, producer := range producers {\n103\t\t\t\tif i >= 8 {\n104\t\t\t\t\tfmt.Fprintf(&summary, \"; ... %d more producer(s)\", len(producers)-i)\n105\t\t\t\t\tbreak\n106\t\t\t\t}\n107\t\t\t\tif i > 0 {\n108\t\t\t\t\tsummary.WriteString(\"; \")\n109\t\t\t\t}\n110\t\t\t\tsummary.WriteString(clip(producer, 128))\n111\t\t\t\tsummary.WriteString(\": \")\n112\t\t\t\treasons := append([]string(nil), audit.UnknownProducers[producer]...)\n113\t\t\t\tsort.Strings(reasons)\n114\t\t\t\tfor j, reason := range reasons {\n115\t\t\t\t\tif j >= 4 {\n116\t\t\t\t\t\tfmt.Fprintf(&summary, \"; ... %d more reason(s)\", len(reasons)-j)\n117\t\t\t\t\t\tbreak\n118\t\t\t\t\t}\n119\t\t\t\t\tif j > 0 {\n120\t\t\t\t\t\tsummary.WriteString(\" | \")\n121\t\t\t\t\t}\n122\t\t\t\t\tfor _, prefix := range []string{\"index generation could not be pinned:\", \"authorized roots could not be resolved:\"} {\n123\t\t\t\t\t\tif strings.HasPrefix(reason, prefix) {\n124\t\t\t\t\t\t\treason = strings.TrimSuffix(prefix, \":\")\n125\t\t\t\t\t\t\tbreak\n126\t\t\t\t\t\t}\n127\t\t\t\t\t}\n128\t\t\t\t\tsummary.WriteString(clip(reason, 256))\n129\t\t\t\t}\n130\t\t\t}\n131\t\t\tdetail := summary.String()\n132\t\t\tif len(detail) > 2048 {\n133\t\t\t\tdetail = detail[:2045] + \"...\"\n134\t\t\t}\n135\t\t\treturn fmt.Errorf(\"%w: %d producer(s) lack a complete observation: %s\", ErrGovernanceReadViewUnknown, len(audit.UnknownProducers), detail)\n136\t\t}\n137\t\treturn nil\n138\t}\n139\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"e350a68a-505c-469c-84f2-098afe00641b","timestamp":"2026-11-06T19:09:25.166Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/pose-review-run-3263644701/worktree/pose-mcp/internal/pose/governance_read_view_capture.go","content":"package pose\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"sort\"\n\t\"strings\"\n)\n\nvar (\n\t// ErrGovernanceReadViewChanged means the captured input closure changed\n\t// and could not be certified after a failed callback or the permitted retry.\n\tErrGovernanceReadViewChanged = errors.New(\"pose: governance read view changed during capture\")\n\t// ErrGovernanceReadViewUnknown means the operation could not prove the\n\t// completeness of its captured input closure.\n\tErrGovernanceReadViewUnknown = errors.New(\"pose: governance read view input closure is unknown\")\n)\n\n// WithGovernanceReadView runs a read-only callback against one immutable view\n// and audits that view before returning. A changed view is retried once; if\n// the retry changes or any required observation is unknown, the callback must\n// not be used to publish a derived result. The callback must keep its outputs\n// in memory; publishers write through the caller's original guarded Store only\n// after this method succeeds.\nfunc (s Store) WithGovernanceReadView(producer string, run func(Store) error) error {\n\tif run == nil {\n\t\treturn errors.New(\"pose: governance read view callback is required\")\n\t}\n\tif producer == \"\" {\n\t\treturn errors.New(\"pose: governance read view producer is required\")\n\t}\n\treturn withGovernanceReadViewCaptureAttempt(s.withoutGovernanceReadView(), producer, 0, false, func(store Store) (bool, error) {\n\t\treturn true, run(store)\n\t})\n}\n\n// WithGovernanceReadViewForIndexBuild allows the callback to discover whether\n// the index inputs depend on a Git source revision. A missing primary HEAD is\n// captured and audited as data; the callback returns true when that revision\n// is semantically required by the generation it produced.\nfunc (s Store) WithGovernanceReadViewForIndexBuild(producer string, run func(Store) (requiresPrimaryRevision bool, err error)) error {\n\tif run == nil {\n\t\treturn errors.New(\"pose: governance read view callback is required\")\n\t}\n\tif producer == \"\" {\n\t\treturn errors.New(\"pose: governance read view producer is required\")\n\t}\n\treturn withGovernanceReadViewCaptureAttempt(s.withoutGovernanceReadView(), producer, 0, true, run)\n}\n\nfunc withGovernanceReadViewCaptureAttempt(s Store, producer string, attempt int, allowMissingPrimaryRevision bool, run func(Store) (bool, error)) error {\n\tbase, view := s.beginGovernanceReadView(allowMissingPrimaryRevision)\n\tstore := base.withGovernanceReadView(view, producer).PinIndexes()\n\tif !allowMissingPrimaryRevision {\n\t\t_, _ = captureGovernanceSourceRevision(store.fsys(), store.Root, producer)\n\t}\n\trequiresPrimaryRevision, err := run(store)\n\tif err != nil {\n\t\t// A callback can translate a failed read into a domain error. Preserve\n\t\t// that error and the independently audited closure failure, without\n\t\t// retrying a callback that has already failed.\n\t\taudit := view.audit()\n\t\tauditErr := governanceReadViewUnknownError(audit)\n\t\tif governanceReviewAuditChanged(audit) {\n\t\t\tauditErr = errors.Join(auditErr, ErrGovernanceReadViewChanged)\n\t\t}\n\t\tif auditErr == nil {\n\t\t\treturn err\n\t\t}\n\t\treturn errors.Join(err, auditErr)\n\t}\n\tif requiresPrimaryRevision {\n\t\tview.operation.requirePrimaryRevision(producer)\n\t}\n\taudit := view.audit()\n\tchanged := governanceReviewAuditChanged(audit)\n\tif changed && attempt == 0 {\n\t\treturn withGovernanceReadViewCaptureAttempt(base.withoutGovernanceReadView(), producer, 1, allowMissingPrimaryRevision, run)\n\t}\n\tif changed {\n\t\treturn ErrGovernanceReadViewChanged\n\t}\n\treturn governanceReadViewUnknownError(audit)\n}\n\n// Summaries contain producer labels and audit reasons, excluding observed paths\n// and the underlying path-bearing details of root/index resolution failures.\nfunc governanceReadViewUnknownError(audit governanceReadViewAudit) error {\n\tif len(audit.UnknownProducers) > 0 {\n\t\tproducers := make([]string, 0, len(audit.UnknownProducers))\n\t\tfor producer := range audit.UnknownProducers {\n\t\t\tproducers = append(producers, producer)\n\t\t}\n\t\tsort.Strings(producers)\n\t\tclip := func(value string, limit int) string {\n\t\t\tif len(value) <= limit {\n\t\t\t\treturn value\n\t\t\t}\n\t\t\treturn value[:limit-3] + \"...\"\n\t\t}\n\t\tvar summary strings.Builder\n\t\tfor i, producer := range producers {\n\t\t\tif i >= 8 {\n\t\t\t\tfmt.Fprintf(&summary, \"; ... %d more producer(s)\", len(producers)-i)\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif i > 0 {\n\t\t\t\tsummary.WriteString(\"; \")\n\t\t\t}\n\t\t\tsummary.WriteString(clip(producer, 128))\n\t\t\tsummary.WriteString(\": \")\n\t\t\treasons := append([]string(nil), audit.UnknownProducers[producer]...)\n\t\t\tsort.Strings(reasons)\n\t\t\tfor j, reason := range reasons {\n\t\t\t\tif j >= 4 {\n\t\t\t\t\tfmt.Fprintf(&summary, \"; ... %d more reason(s)\", len(reasons)-j)\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\tif j > 0 {\n\t\t\t\t\tsummary.WriteString(\" | \")\n\t\t\t\t}\n\t\t\t\tfor _, prefix := range []string{\"index generation could not be pinned:\", \"authorized roots could not be resolved:\"} {\n\t\t\t\t\tif strings.HasPrefix(reason, prefix) {\n\t\t\t\t\t\treason = strings.TrimSuffix(prefix, \":\")\n\t\t\t\t\t\tbreak\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tsummary.WriteString(clip(reason, 256))\n\t\t\t}\n\t\t}\n\t\tdetail := summary.String()\n\t\tif len(detail) > 2048 {\n\t\t\tdetail = detail[:2045] + \"...\"\n\t\t}\n\t\treturn fmt.Errorf(\"%w: %d producer(s) lack a complete observation: %s\", ErrGovernanceReadViewUnknown, len(audit.UnknownProducers), detail)\n\t}\n\treturn nil\n}\n","numLines":139,"startLine":1,"totalLines":139}},"tool_result_meta":[{"id":"toolu_014XskVGHazMixY25EWQzjWU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
