{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0168N7Fz1XqxsBC6fCr9GkeP","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"path/filepath\"\n8\t\t\"sort\"\n9\t\t\"strings\"\n10\t\n11\t\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n12\t\tposepkg \"github.com/harne8/pose-mcp/internal/pose\"\n13\t)\n14\t\n15\ttype indexGenerationBuild struct {\n16\t\tEncoded                 map[string][]byte\n17\t\tInputs                  map[string]string\n18\t\tProjects                []string\n19\t\tReferencedProjects      []string\n20\t\tRequiresPrimaryRevision bool\n21\t\tSpecs                   int\n22\t\tRoadmaps                int\n23\t\tModules                 int\n24\t\tDeliveryFindings        int\n25\t}\n26\t\n27\ttype indexMaterialPreflight struct {\n28\t\tProjects           []string\n29\t\tReferencedProjects []string\n30\t}\n31\t\n32\ttype indexGenerationBuildFailure struct {\n33\t\tCode    string\n34\t\tMessage string\n35\t}\n36\t\n37\tfunc (e *indexGenerationBuildFailure) Error() string { return e.Message }\n38\t\n39\tfunc indexBuildFailure(err error) (string, string) {\n40\t\tswitch {\n41\t\tcase errors.Is(err, posepkg.ErrGovernanceReadViewUnknown):\n42\t\t\treturn \"index-generation-read-view-unknown\", \"index input closure could not be proved: \" + err.Error() + \"; nothing was written\"\n43\t\tcase errors.Is(err, posepkg.ErrGovernanceReadViewChanged):\n44\t\t\treturn \"index-generation-read-view-changed\", \"index inputs changed during generation; nothing was written, run `pose index` again\"\n45\t\t}\n46\t\tvar buildErr *indexGenerationBuildFailure\n47\t\tif errors.As(err, &buildErr) {\n48\t\t\treturn buildErr.Code, buildErr.Message\n49\t\t}\n50\t\treturn \"index-generation-read-view-unknown\", \"index generation could not be built safely: \" + err.Error() + \"; nothing was written\"\n51\t}\n52\t\n53\tfunc generateIndexGeneration(files posepkg.Files, root string, gate *gateOutput, out *cliout.Renderer, fail func(code, message string) int) int {\n54\t\tresolver, project, err := posepkg.EnvironmentArtifactResolverIn(files, root, \"\")\n55\t\tif err != nil {\n56\t\t\treturn fail(\"invalid-project-configuration\", \"invalid-project-configuration: \"+err.Error())\n57\t\t}\n58\t\tstore := posepkg.Store{Root: root, FS: files, FederatedProjectID: project, FederatedResolver: &resolver}\n59\t\tpreflight, err := captureIndexMaterialPreflight(store)\n60\t\tif err != nil {\n61\t\t\tcode, message := indexBuildFailure(err)\n62\t\t\treturn fail(code, message)\n63\t\t}\n64\t\n65\t\tstatus := 1\n66\t\tguardErr := store.WithGovernanceWriteGuardForProjects(\"index.generate\", preflight.Projects, func(guarded posepkg.Store) error {\n67\t\t\tbuilt, buildErr := captureIndexGeneration(guarded)\n68\t\t\tif buildErr != nil {\n69\t\t\t\tcode, message := indexBuildFailure(buildErr)\n70\t\t\t\tstatus = fail(code, message)\n71\t\t\t\treturn nil\n72\t\t\t}\n73\t\t\texpanded := expandedIndexMaterialProjects(preflight, built)\n74\t\t\tif len(expanded) > 0 {\n75\t\t\t\tmessage := \"federated index material expanded after root preflight (\" + strings.Join(expanded, \", \") + \"); nothing was written, rerun `pose index`\"\n76\t\t\t\tstatus = fail(\"index-material-expanded\", message)\n77\t\t\t\treturn nil\n78\t\t\t}\n79\t\n80\t\t\t// Publish only after the captured read view has passed its final audit.\n81\t\t\t// Keep using the guarded source Files; captured Files are read-only.\n82\t\t\treceipt, publishErr := guarded.PublishIndexGeneration(built.Encoded, built.Inputs)\n83\t\t\tif publishErr != nil {\n84\t\t\t\tswitch {\n85\t\t\t\tcase receipt.Committed:\n86\t\t\t\t\tout.RecordField(\"index_generation\", receipt.GenerationID)\n87\t\t\t\t\tstatus = fail(indexPublishCode(publishErr), fmt.Sprintf(\"generation %s was committed but not confirmed durable: %v; run `pose index --verify`\", receipt.GenerationID, publishErr))\n88\t\t\t\tcase errors.Is(publishErr, posepkg.ErrIndexGenerationBusy):\n89\t\t\t\t\tstatus = fail(indexPublishCode(publishErr), fmt.Sprintf(\"%v; nothing was written, run `pose index` again when it finishes\", publishErr))\n90\t\t\t\tdefault:\n91\t\t\t\t\tstatus = fail(indexPublishCode(publishErr), fmt.Sprintf(\"publishing the index generation: %v (the previous generation stays in force; run `pose index` again)\", publishErr))\n92\t\t\t\t}\n93\t\t\t\treturn nil\n94\t\t\t}\n95\t\t\tout.RecordField(\"index_generation\", receipt.GenerationID)\n96\t\t\tif receipt.Previous != \"\" {\n97\t\t\t\tout.RecordField(\"index_generation_previous\", receipt.Previous)\n98\t\t\t}\n99\t\t\tif receipt.CleanupError != nil {\n100\t\t\t\tout.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"index-generation-cleanup\", Message: \"retention of old index generations failed: \" + receipt.CleanupError.Error()})\n101\t\t\t}\n102\t\t\tindexesDir := filepath.Join(root, \".pose\", \"indexes\")\n103\t\t\tout.RecordField(\"indexes_dir\", indexesDir)\n104\t\t\tout.RecordCount(\"specs\", built.Specs)\n105\t\t\tout.RecordCount(\"roadmaps\", built.Roadmaps)\n106\t\t\tout.RecordCount(\"modules\", built.Modules)\n107\t\t\tout.RecordCount(\"delivery_findings\", built.DeliveryFindings)\n108\t\t\tgate.Verdict(cliout.StatePass, \"POSE indexes updated at \"+indexesDir, \"indexes updated\")\n109\t\t\tstatus = 0\n110\t\t\treturn nil\n111\t\t})\n112\t\tif guardErr != nil {\n113\t\t\tmessage := fmt.Sprintf(\"%v; nothing was written, run `pose index` again when the roots are available\", guardErr)\n114\t\t\treturn fail(indexPublishCode(guardErr), message)\n115\t\t}\n116\t\treturn status\n117\t}\n118\t\n119\tfunc captureIndexMaterialPreflight(store posepkg.Store) (indexMaterialPreflight, error) {\n120\t\tvar preflight indexMaterialPreflight\n121\t\terr := store.WithGovernanceReadViewForIndexBuild(\"index.generate.preflight\", func(captured posepkg.Store) (bool, error) {\n122\t\t\tmaterial, err := posepkg.BuildIndexFederatedMaterialIn(captured)\n123\t\t\tif err != nil {\n124\t\t\t\treturn false, err\n125\t\t\t}\n126\t\t\tpreflight = indexMaterialPreflight{Projects: material.Projects, ReferencedProjects: material.ReferencedProjects}\n127\t\t\treturn material.RequiresPrimaryRevision, nil\n128\t\t})\n129\t\tif err != nil {\n130\t\t\treturn indexMaterialPreflight{}, err\n131\t\t}\n132\t\treturn preflight, nil\n133\t}\n134\t\n135\tfunc captureIndexGeneration(store posepkg.Store) (indexGenerationBuild, error) {\n136\t\tvar built indexGenerationBuild\n137\t\terr := store.WithGovernanceReadViewForIndexBuild(\"index.generate\", func(captured posepkg.Store) (bool, error) {\n138\t\t\tattempt, err := buildIndexGenerationIn(captured)\n139\t\t\tif err != nil {\n140\t\t\t\treturn false, err\n141\t\t\t}\n142\t\t\tbuilt = attempt\n143\t\t\treturn attempt.RequiresPrimaryRevision, nil\n144\t\t})\n145\t\tif err != nil {\n146\t\t\treturn indexGenerationBuild{}, err\n147\t\t}\n148\t\treturn built, nil\n149\t}\n150\t\n151\t// buildIndexGenerationIn is a pure in-memory projection over the captured\n152\t// Store. It performs no publication and binds the exact federated projections\n153\t// it used to build the output files.\n154\tfunc buildIndexGenerationIn(store posepkg.Store) (indexGenerationBuild, error) {\n155\t\tfiles, root := store.FS, store.Root\n156\t\tmodules, manifests, dockers, charts, readmes, scanErr := scanModulesBoundedIn(files, root)\n157\t\tif scanErr != nil {\n158\t\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"module-discovery-unavailable\", Message: fmt.Sprintf(\"module discovery: %v\", scanErr)}\n159\t\t}\n160\t\tmetadataDefaults, metadata := loadModuleMetadataIn(files, root)\n161\t\tapps, services, packages := []indexedModule{}, []indexedModule{}, []indexedModule{}\n162\t\tfor _, module := range modules {\n163\t\t\tdecl := metadata[module.Path]\n164\t\t\tdefaults := map[string]string{\"owner\": \"unknown\", \"criticality\": \"medium\", \"domain\": \"unknown\", \"validationProfile\": \"baseline\"}\n165\t\t\tfor key, value := range metadataDefaults {\n166\t\t\t\tif value != \"\" {\n167\t\t\t\t\tdefaults[key] = value\n168\t\t\t\t}\n169\t\t\t}\n170\t\t\tmissing := []string{}\n171\t\t\tfor key := range defaults {\n172\t\t\t\tif value := decl[key]; value != \"\" {\n173\t\t\t\t\tdefaults[key] = value\n174\t\t\t\t} else {\n175\t\t\t\t\tmissing = append(missing, key)\n176\t\t\t\t}\n177\t\t\t}\n178\t\t\tsort.Strings(missing)\n179\t\t\tmodule.Owner = defaults[\"owner\"]\n180\t\t\tmodule.Criticality = defaults[\"criticality\"]\n181\t\t\tmodule.Domain = defaults[\"domain\"]\n182\t\t\tmodule.ValidationProfile = defaults[\"validationProfile\"]\n183\t\t\tmodule.Metadata = defaults\n184\t\t\tsource := \"declared\"\n185\t\t\tif len(decl) == 0 {\n186\t\t\t\tsource = \"defaulted\"\n187\t\t\t} else if len(missing) > 0 {\n188\t\t\t\tsource = \"partial\"\n189\t\t\t}\n190\t\t\tmodule.MetadataStatus = map[string]any{\"isComplete\": len(missing) == 0 && len(decl) > 0, \"source\": source, \"missingFields\": missing}\n191\t\t\tlower := strings.ToLower(module.Path + \"/\" + module.Name)\n192\t\t\tif strings.Contains(lower, \"service\") || strings.Contains(lower, \"/services/\") {\n193\t\t\t\tservices = append(services, module)\n194\t\t\t} else if strings.Contains(lower, \"/app\") || strings.Contains(lower, \"web\") || strings.Contains(lower, \"portal\") || strings.HasSuffix(lower, \"-ui\") {\n195\t\t\t\tapps = append(apps, module)\n196\t\t\t} else {\n197\t\t\t\tpackages = append(packages, module)\n198\t\t\t}\n199\t\t}\n200\t\trepo := map[string]any{\"root\": \".\", \"apps\": apps, \"services\": services, \"packages\": packages, \"manifests\": manifests, \"dockerfiles\": dockers, \"helmCharts\": charts, \"readmes\": readmes, \"moduleMetadata\": map[string]any{\"schemaVersion\": 1, \"source\": \".pose/indexes/module-metadata.json\"}}\n201\t\n202\t\tmaterial, err := posepkg.BuildIndexFederatedMaterialIn(store)\n203\t\tif err != nil {\n204\t\t\tcode := \"index-material-unavailable\"\n205\t\t\tif strings.Contains(err.Error(), \"federated roadmap \") {\n206\t\t\t\tcode = \"federated-roadmap\"\n207\t\t\t}\n208\t\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: code, Message: err.Error()}\n209\t\t}\n210\t\tspecMap := map[string]any{}\n211\t\tedges := []map[string]string{}\n212\t\tfor _, spec := range material.Specs {\n213\t\t\tif _, exists := specMap[spec.Slug]; exists {\n214\t\t\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"conflicting-artifact-identity\", Message: \"conflicting-artifact-identity\"}\n215\t\t\t}\n216\t\t\tidentity, _ := posepkg.ParseArtifactRef(\"spec:\" + spec.Slug)\n217\t\t\tidentity.Project = store.FederatedProjectID\n218\t\t\tspecMap[spec.Slug] = map[string]any{\"identity\": identity, \"dependency_resolutions\": material.SpecDependencyResolutions[spec.Slug], \"status\": spec.Status, \"depends_on\": spec.DependsOn, \"priority\": spec.Priority, \"path\": relativePath(root, spec.Path)}\n219\t\t\tfor _, raw := range spec.DependsOn {\n220\t\t\t\tif ref, parseErr := posepkg.ParseArtifactRef(raw); parseErr == nil && ref.Kind == \"spec\" {\n221\t\t\t\t\tedges = append(edges, map[string]string{\"from\": spec.Slug, \"to\": raw})\n222\t\t\t\t}\n223\t\t\t}\n224\t\t}\n225\t\troadmapMap := map[string]any{}\n226\t\tfor _, roadmap := range material.Roadmaps {\n227\t\t\troadmapMap[roadmap.Slug] = map[string]any{\"status\": roadmap.Status, \"created_at\": roadmap.CreatedAt, \"depends_on\": roadmap.DependsOn, \"consumes\": roadmap.Consumes, \"milestones\": roadmap.Milestones, \"federated_acceptance\": material.RoadmapAcceptances[roadmap.Slug], \"path\": relativePath(root, roadmap.Path)}\n228\t\t}\n229\t\tdeliveryGraph, err := buildCurrentDeliveryGraphIn(files, root)\n230\t\tif err != nil {\n231\t\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"delivery-integrity\", Message: fmt.Sprintf(\"delivery integrity: %v\", err)}\n232\t\t}\n233\t\treleaseStatus, err := store.GetReleaseStatus(\"\")\n234\t\tif err != nil {\n235\t\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"release-lifecycle\", Message: fmt.Sprintf(\"release lifecycle: %v\", err)}\n236\t\t}\n237\t\toutputs := map[string]any{\"repo-map.json\": repo, \"services.json\": services, \"packages.json\": packages, \"spec-graph.json\": map[string]any{\"schemaVersion\": 1, \"specs\": specMap, \"edges\": edges}, \"roadmaps.json\": map[string]any{\"schemaVersion\": 1, \"roadmaps\": roadmapMap}, \"delivery-integrity.json\": deliveryGraph, \"releases.json\": releaseStatus}\n238\t\tencoded := make(map[string][]byte, len(outputs))\n239\t\tfor name, value := range outputs {\n240\t\t\tvar raw []byte\n241\t\t\tif graph, ok := value.(posepkg.DeliveryIntegrityGraph); ok {\n242\t\t\t\traw, err = graph.IndexJSON()\n243\t\t\t} else {\n244\t\t\t\traw, err = json.MarshalIndent(value, \"\", \"  \")\n245\t\t\t}\n246\t\t\tif err != nil {\n247\t\t\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"encode\", Message: fmt.Sprintf(\"encoding %s: %v\", name, err)}\n248\t\t\t}\n249\t\t\tencoded[name] = append(raw, '\\n')\n250\t\t}\n251\t\tinputs, unknown := posepkg.IndexInputBindingsForFederatedMaterialIn(files, root, material.Projection)\n252\t\tif len(unknown) > 0 {\n253\t\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"index-input-unknown\", Message: \"index inputs could not be bound: \" + strings.Join(unknown, \", \")}\n254\t\t}\n255\t\tfor _, name := range posepkg.IndexInputNames {\n256\t\t\tif strings.TrimSpace(inputs[name]) == \"\" {\n257\t\t\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"index-input-unknown\", Message: \"required index input has no binding: \" + name}\n258\t\t\t}\n259\t\t}\n260\t\treturn indexGenerationBuild{\n261\t\t\tEncoded: encoded, Inputs: inputs, Projects: material.Projects, ReferencedProjects: material.ReferencedProjects,\n262\t\t\tRequiresPrimaryRevision: material.RequiresPrimaryRevision, Specs: len(specMap), Roadmaps: len(roadmapMap),\n263\t\t\tModules: len(modules), DeliveryFindings: len(deliveryGraph.Findings),\n264\t\t}, nil\n265\t}\n266\t\n267\tfunc expandedIndexMaterialProjects(preflight indexMaterialPreflight, guarded indexGenerationBuild) []string {\n268\t\tinitialProjects := make(map[string]bool, len(preflight.Projects))\n269\t\tfor _, project := range preflight.Projects {\n270\t\t\tinitialProjects[project] = true\n271\t\t}\n272\t\tinitialReferences := make(map[string]bool, len(preflight.ReferencedProjects))\n273\t\tfor _, project := range preflight.ReferencedProjects {\n274\t\t\tinitialReferences[project] = true\n275\t\t}\n276\t\texpanded := []string{}\n277\t\tfor _, project := range guarded.Projects {\n278\t\t\tif !initialProjects[project] {\n279\t\t\t\texpanded = append(expanded, project)\n280\t\t\t}\n281\t\t}\n282\t\tfor _, project := range guarded.ReferencedProjects {\n283\t\t\tif !initialReferences[project] {\n284\t\t\t\texpanded = append(expanded, project)\n285\t\t\t}\n286\t\t}\n287\t\treturn uniqueSortedStrings(expanded)\n288\t}\n289\t\n290\tfunc uniqueSortedStrings(values []string) []string {\n291\t\tif len(values) == 0 {\n292\t\t\treturn values\n293\t\t}\n294\t\tsort.Strings(values)\n295\t\tunique := values[:1]\n296\t\tfor _, value := range values[1:] {\n297\t\t\tif value != unique[len(unique)-1] {\n298\t\t\t\tunique = append(unique, value)\n299\t\t\t}\n300\t\t}\n301\t\treturn unique\n302\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"71c84aa5-f078-488b-a197-5457c501db64","timestamp":"2026-11-06T19:09:21.713Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/pose-review-run-3263644701/worktree/pose-mcp/internal/cli/index_generation_build.go","content":"package cli\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n\tposepkg \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\ntype indexGenerationBuild struct {\n\tEncoded                 map[string][]byte\n\tInputs                  map[string]string\n\tProjects                []string\n\tReferencedProjects      []string\n\tRequiresPrimaryRevision bool\n\tSpecs                   int\n\tRoadmaps                int\n\tModules                 int\n\tDeliveryFindings        int\n}\n\ntype indexMaterialPreflight struct {\n\tProjects           []string\n\tReferencedProjects []string\n}\n\ntype indexGenerationBuildFailure struct {\n\tCode    string\n\tMessage string\n}\n\nfunc (e *indexGenerationBuildFailure) Error() string { return e.Message }\n\nfunc indexBuildFailure(err error) (string, string) {\n\tswitch {\n\tcase errors.Is(err, posepkg.ErrGovernanceReadViewUnknown):\n\t\treturn \"index-generation-read-view-unknown\", \"index input closure could not be proved: \" + err.Error() + \"; nothing was written\"\n\tcase errors.Is(err, posepkg.ErrGovernanceReadViewChanged):\n\t\treturn \"index-generation-read-view-changed\", \"index inputs changed during generation; nothing was written, run `pose index` again\"\n\t}\n\tvar buildErr *indexGenerationBuildFailure\n\tif errors.As(err, &buildErr) {\n\t\treturn buildErr.Code, buildErr.Message\n\t}\n\treturn \"index-generation-read-view-unknown\", \"index generation could not be built safely: \" + err.Error() + \"; nothing was written\"\n}\n\nfunc generateIndexGeneration(files posepkg.Files, root string, gate *gateOutput, out *cliout.Renderer, fail func(code, message string) int) int {\n\tresolver, project, err := posepkg.EnvironmentArtifactResolverIn(files, root, \"\")\n\tif err != nil {\n\t\treturn fail(\"invalid-project-configuration\", \"invalid-project-configuration: \"+err.Error())\n\t}\n\tstore := posepkg.Store{Root: root, FS: files, FederatedProjectID: project, FederatedResolver: &resolver}\n\tpreflight, err := captureIndexMaterialPreflight(store)\n\tif err != nil {\n\t\tcode, message := indexBuildFailure(err)\n\t\treturn fail(code, message)\n\t}\n\n\tstatus := 1\n\tguardErr := store.WithGovernanceWriteGuardForProjects(\"index.generate\", preflight.Projects, func(guarded posepkg.Store) error {\n\t\tbuilt, buildErr := captureIndexGeneration(guarded)\n\t\tif buildErr != nil {\n\t\t\tcode, message := indexBuildFailure(buildErr)\n\t\t\tstatus = fail(code, message)\n\t\t\treturn nil\n\t\t}\n\t\texpanded := expandedIndexMaterialProjects(preflight, built)\n\t\tif len(expanded) > 0 {\n\t\t\tmessage := \"federated index material expanded after root preflight (\" + strings.Join(expanded, \", \") + \"); nothing was written, rerun `pose index`\"\n\t\t\tstatus = fail(\"index-material-expanded\", message)\n\t\t\treturn nil\n\t\t}\n\n\t\t// Publish only after the captured read view has passed its final audit.\n\t\t// Keep using the guarded source Files; captured Files are read-only.\n\t\treceipt, publishErr := guarded.PublishIndexGeneration(built.Encoded, built.Inputs)\n\t\tif publishErr != nil {\n\t\t\tswitch {\n\t\t\tcase receipt.Committed:\n\t\t\t\tout.RecordField(\"index_generation\", receipt.GenerationID)\n\t\t\t\tstatus = fail(indexPublishCode(publishErr), fmt.Sprintf(\"generation %s was committed but not confirmed durable: %v; run `pose index --verify`\", receipt.GenerationID, publishErr))\n\t\t\tcase errors.Is(publishErr, posepkg.ErrIndexGenerationBusy):\n\t\t\t\tstatus = fail(indexPublishCode(publishErr), fmt.Sprintf(\"%v; nothing was written, run `pose index` again when it finishes\", publishErr))\n\t\t\tdefault:\n\t\t\t\tstatus = fail(indexPublishCode(publishErr), fmt.Sprintf(\"publishing the index generation: %v (the previous generation stays in force; run `pose index` again)\", publishErr))\n\t\t\t}\n\t\t\treturn nil\n\t\t}\n\t\tout.RecordField(\"index_generation\", receipt.GenerationID)\n\t\tif receipt.Previous != \"\" {\n\t\t\tout.RecordField(\"index_generation_previous\", receipt.Previous)\n\t\t}\n\t\tif receipt.CleanupError != nil {\n\t\t\tout.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"index-generation-cleanup\", Message: \"retention of old index generations failed: \" + receipt.CleanupError.Error()})\n\t\t}\n\t\tindexesDir := filepath.Join(root, \".pose\", \"indexes\")\n\t\tout.RecordField(\"indexes_dir\", indexesDir)\n\t\tout.RecordCount(\"specs\", built.Specs)\n\t\tout.RecordCount(\"roadmaps\", built.Roadmaps)\n\t\tout.RecordCount(\"modules\", built.Modules)\n\t\tout.RecordCount(\"delivery_findings\", built.DeliveryFindings)\n\t\tgate.Verdict(cliout.StatePass, \"POSE indexes updated at \"+indexesDir, \"indexes updated\")\n\t\tstatus = 0\n\t\treturn nil\n\t})\n\tif guardErr != nil {\n\t\tmessage := fmt.Sprintf(\"%v; nothing was written, run `pose index` again when the roots are available\", guardErr)\n\t\treturn fail(indexPublishCode(guardErr), message)\n\t}\n\treturn status\n}\n\nfunc captureIndexMaterialPreflight(store posepkg.Store) (indexMaterialPreflight, error) {\n\tvar preflight indexMaterialPreflight\n\terr := store.WithGovernanceReadViewForIndexBuild(\"index.generate.preflight\", func(captured posepkg.Store) (bool, error) {\n\t\tmaterial, err := posepkg.BuildIndexFederatedMaterialIn(captured)\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tpreflight = indexMaterialPreflight{Projects: material.Projects, ReferencedProjects: material.ReferencedProjects}\n\t\treturn material.RequiresPrimaryRevision, nil\n\t})\n\tif err != nil {\n\t\treturn indexMaterialPreflight{}, err\n\t}\n\treturn preflight, nil\n}\n\nfunc captureIndexGeneration(store posepkg.Store) (indexGenerationBuild, error) {\n\tvar built indexGenerationBuild\n\terr := store.WithGovernanceReadViewForIndexBuild(\"index.generate\", func(captured posepkg.Store) (bool, error) {\n\t\tattempt, err := buildIndexGenerationIn(captured)\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tbuilt = attempt\n\t\treturn attempt.RequiresPrimaryRevision, nil\n\t})\n\tif err != nil {\n\t\treturn indexGenerationBuild{}, err\n\t}\n\treturn built, nil\n}\n\n// buildIndexGenerationIn is a pure in-memory projection over the captured\n// Store. It performs no publication and binds the exact federated projections\n// it used to build the output files.\nfunc buildIndexGenerationIn(store posepkg.Store) (indexGenerationBuild, error) {\n\tfiles, root := store.FS, store.Root\n\tmodules, manifests, dockers, charts, readmes, scanErr := scanModulesBoundedIn(files, root)\n\tif scanErr != nil {\n\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"module-discovery-unavailable\", Message: fmt.Sprintf(\"module discovery: %v\", scanErr)}\n\t}\n\tmetadataDefaults, metadata := loadModuleMetadataIn(files, root)\n\tapps, services, packages := []indexedModule{}, []indexedModule{}, []indexedModule{}\n\tfor _, module := range modules {\n\t\tdecl := metadata[module.Path]\n\t\tdefaults := map[string]string{\"owner\": \"unknown\", \"criticality\": \"medium\", \"domain\": \"unknown\", \"validationProfile\": \"baseline\"}\n\t\tfor key, value := range metadataDefaults {\n\t\t\tif value != \"\" {\n\t\t\t\tdefaults[key] = value\n\t\t\t}\n\t\t}\n\t\tmissing := []string{}\n\t\tfor key := range defaults {\n\t\t\tif value := decl[key]; value != \"\" {\n\t\t\t\tdefaults[key] = value\n\t\t\t} else {\n\t\t\t\tmissing = append(missing, key)\n\t\t\t}\n\t\t}\n\t\tsort.Strings(missing)\n\t\tmodule.Owner = defaults[\"owner\"]\n\t\tmodule.Criticality = defaults[\"criticality\"]\n\t\tmodule.Domain = defaults[\"domain\"]\n\t\tmodule.ValidationProfile = defaults[\"validationProfile\"]\n\t\tmodule.Metadata = defaults\n\t\tsource := \"declared\"\n\t\tif len(decl) == 0 {\n\t\t\tsource = \"defaulted\"\n\t\t} else if len(missing) > 0 {\n\t\t\tsource = \"partial\"\n\t\t}\n\t\tmodule.MetadataStatus = map[string]any{\"isComplete\": len(missing) == 0 && len(decl) > 0, \"source\": source, \"missingFields\": missing}\n\t\tlower := strings.ToLower(module.Path + \"/\" + module.Name)\n\t\tif strings.Contains(lower, \"service\") || strings.Contains(lower, \"/services/\") {\n\t\t\tservices = append(services, module)\n\t\t} else if strings.Contains(lower, \"/app\") || strings.Contains(lower, \"web\") || strings.Contains(lower, \"portal\") || strings.HasSuffix(lower, \"-ui\") {\n\t\t\tapps = append(apps, module)\n\t\t} else {\n\t\t\tpackages = append(packages, module)\n\t\t}\n\t}\n\trepo := map[string]any{\"root\": \".\", \"apps\": apps, \"services\": services, \"packages\": packages, \"manifests\": manifests, \"dockerfiles\": dockers, \"helmCharts\": charts, \"readmes\": readmes, \"moduleMetadata\": map[string]any{\"schemaVersion\": 1, \"source\": \".pose/indexes/module-metadata.json\"}}\n\n\tmaterial, err := posepkg.BuildIndexFederatedMaterialIn(store)\n\tif err != nil {\n\t\tcode := \"index-material-unavailable\"\n\t\tif strings.Contains(err.Error(), \"federated roadmap \") {\n\t\t\tcode = \"federated-roadmap\"\n\t\t}\n\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: code, Message: err.Error()}\n\t}\n\tspecMap := map[string]any{}\n\tedges := []map[string]string{}\n\tfor _, spec := range material.Specs {\n\t\tif _, exists := specMap[spec.Slug]; exists {\n\t\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"conflicting-artifact-identity\", Message: \"conflicting-artifact-identity\"}\n\t\t}\n\t\tidentity, _ := posepkg.ParseArtifactRef(\"spec:\" + spec.Slug)\n\t\tidentity.Project = store.FederatedProjectID\n\t\tspecMap[spec.Slug] = map[string]any{\"identity\": identity, \"dependency_resolutions\": material.SpecDependencyResolutions[spec.Slug], \"status\": spec.Status, \"depends_on\": spec.DependsOn, \"priority\": spec.Priority, \"path\": relativePath(root, spec.Path)}\n\t\tfor _, raw := range spec.DependsOn {\n\t\t\tif ref, parseErr := posepkg.ParseArtifactRef(raw); parseErr == nil && ref.Kind == \"spec\" {\n\t\t\t\tedges = append(edges, map[string]string{\"from\": spec.Slug, \"to\": raw})\n\t\t\t}\n\t\t}\n\t}\n\troadmapMap := map[string]any{}\n\tfor _, roadmap := range material.Roadmaps {\n\t\troadmapMap[roadmap.Slug] = map[string]any{\"status\": roadmap.Status, \"created_at\": roadmap.CreatedAt, \"depends_on\": roadmap.DependsOn, \"consumes\": roadmap.Consumes, \"milestones\": roadmap.Milestones, \"federated_acceptance\": material.RoadmapAcceptances[roadmap.Slug], \"path\": relativePath(root, roadmap.Path)}\n\t}\n\tdeliveryGraph, err := buildCurrentDeliveryGraphIn(files, root)\n\tif err != nil {\n\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"delivery-integrity\", Message: fmt.Sprintf(\"delivery integrity: %v\", err)}\n\t}\n\treleaseStatus, err := store.GetReleaseStatus(\"\")\n\tif err != nil {\n\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"release-lifecycle\", Message: fmt.Sprintf(\"release lifecycle: %v\", err)}\n\t}\n\toutputs := map[string]any{\"repo-map.json\": repo, \"services.json\": services, \"packages.json\": packages, \"spec-graph.json\": map[string]any{\"schemaVersion\": 1, \"specs\": specMap, \"edges\": edges}, \"roadmaps.json\": map[string]any{\"schemaVersion\": 1, \"roadmaps\": roadmapMap}, \"delivery-integrity.json\": deliveryGraph, \"releases.json\": releaseStatus}\n\tencoded := make(map[string][]byte, len(outputs))\n\tfor name, value := range outputs {\n\t\tvar raw []byte\n\t\tif graph, ok := value.(posepkg.DeliveryIntegrityGraph); ok {\n\t\t\traw, err = graph.IndexJSON()\n\t\t} else {\n\t\t\traw, err = json.MarshalIndent(value, \"\", \"  \")\n\t\t}\n\t\tif err != nil {\n\t\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"encode\", Message: fmt.Sprintf(\"encoding %s: %v\", name, err)}\n\t\t}\n\t\tencoded[name] = append(raw, '\\n')\n\t}\n\tinputs, unknown := posepkg.IndexInputBindingsForFederatedMaterialIn(files, root, material.Projection)\n\tif len(unknown) > 0 {\n\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"index-input-unknown\", Message: \"index inputs could not be bound: \" + strings.Join(unknown, \", \")}\n\t}\n\tfor _, name := range posepkg.IndexInputNames {\n\t\tif strings.TrimSpace(inputs[name]) == \"\" {\n\t\t\treturn indexGenerationBuild{}, &indexGenerationBuildFailure{Code: \"index-input-unknown\", Message: \"required index input has no binding: \" + name}\n\t\t}\n\t}\n\treturn indexGenerationBuild{\n\t\tEncoded: encoded, Inputs: inputs, Projects: material.Projects, ReferencedProjects: material.ReferencedProjects,\n\t\tRequiresPrimaryRevision: material.RequiresPrimaryRevision, Specs: len(specMap), Roadmaps: len(roadmapMap),\n\t\tModules: len(modules), DeliveryFindings: len(deliveryGraph.Findings),\n\t}, nil\n}\n\nfunc expandedIndexMaterialProjects(preflight indexMaterialPreflight, guarded indexGenerationBuild) []string {\n\tinitialProjects := make(map[string]bool, len(preflight.Projects))\n\tfor _, project := range preflight.Projects {\n\t\tinitialProjects[project] = true\n\t}\n\tinitialReferences := make(map[string]bool, len(preflight.ReferencedProjects))\n\tfor _, project := range preflight.ReferencedProjects {\n\t\tinitialReferences[project] = true\n\t}\n\texpanded := []string{}\n\tfor _, project := range guarded.Projects {\n\t\tif !initialProjects[project] {\n\t\t\texpanded = append(expanded, project)\n\t\t}\n\t}\n\tfor _, project := range guarded.ReferencedProjects {\n\t\tif !initialReferences[project] {\n\t\t\texpanded = append(expanded, project)\n\t\t}\n\t}\n\treturn uniqueSortedStrings(expanded)\n}\n\nfunc uniqueSortedStrings(values []string) []string {\n\tif len(values) == 0 {\n\t\treturn values\n\t}\n\tsort.Strings(values)\n\tunique := values[:1]\n\tfor _, value := range values[1:] {\n\t\tif value != unique[len(unique)-1] {\n\t\t\tunique = append(unique, value)\n\t\t}\n\t}\n\treturn unique\n}","numLines":302,"startLine":1,"totalLines":303}},"tool_result_meta":[{"id":"toolu_0168N7Fz1XqxsBC6fCr9GkeP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
