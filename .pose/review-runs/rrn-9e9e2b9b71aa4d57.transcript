h, baseName: file.baseName, digest: digestBytes(file.bytes), errText: file.errText, info: frozenInfo(file.info), witness: frozenInfo(file.witness), rootReal: file.rootReal, resolved: file.resolved, inputBytes: int64(len(file.bytes)), readLimit: file.readLimit, producers: sortedBoolKeys(file.producers)})\n2225\t\t}\n2226\t\tfor _, observation := range v.observed {\n2227\t\t\tproof.entries = append(proof.entries, governanceReadProofEntry{method: observation.method, path: observation.path, baseName: observation.baseName, errText: observation.errText, info: frozenInfo(observation.info), witness: frozenInfo(observation.witness), entries: append([]string(nil), observation.entries...), value: observation.value, producers: sortedBoolKeys(observation.producers)})\n2228\t\t}\n2229\t\tfor producer, reasons := range audit.UnknownProducers {\n2230\t\t\tfor _, reason := range reasons {\n2231\t\t\t\tunknown[producer] = mergeReason(unknown[producer], reason)\n2232\t\t\t}\n2233\t\t}\n2234\t\tinputBytes := v.inputBytes\n2235\t\tobservedInputs := len(v.observed) + len(v.files)\n2236\t\tv.mu.Unlock()\n2237\t\n2238\t\trootRealAbs, err := filepath.Abs(rootReal)\n2239\t\tif err == nil {\n2240\t\t\trootReal = rootRealAbs\n2241\t\t}\n2242\t\trootDigest := digestBytes([]byte(rootReal))\n2243\t\tif err != nil {\n2244\t\t\tunknown[\"projection\"] = mergeReason(unknown[\"projection\"], \"authorized root identity could not be resolved\")\n2245\t\t}\n2246\t\tengineVersion := EngineVersion\n2247\t\tif engineVersion == \"\" || engineVersion == \"unknown\" {\n2248\t\t\tengineVersion = \"unknown\"\n2249\t\t\tunknown[\"projection\"] = mergeReason(unknown[\"projection\"], \"engine version is unavailable\")\n2250\t\t}\n2251\t\tparserVersions := map[string]string{\"governance-inputs\": governanceReadViewParserVersion}\n2252\t\tbindings := []ReadViewBinding{{ProjectID: project, RootDigest: rootDigest, SourceRevision: revision, IndexGeneration: indexGeneration}}\n2253\t\tif project == \"\" {\n2254\t\t\tunk