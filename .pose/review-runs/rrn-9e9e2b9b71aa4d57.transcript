{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CpeA935QQV26CHGeGs9zU2","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"fmt\"\n6\t\t\"sort\"\n7\t)\n8\t\n9\t// WithGovernanceWriteGuardForProjects runs a domain writer under the exact\n10\t// previously discovered project set. The callback receives a fresh Store with\n11\t// an operation-local resolver bound to those guarded roots; callers must\n12\t// recompute their material set under the guard and refuse any expansion.\n13\t// Foreign projects must have explicit RootsConfig bindings. Resolver read\n14\t// authorization and directory discovery do not grant write coordination.\n15\tfunc (s Store) WithGovernanceWriteGuardForProjects(operation string, projectIDs []string, callback func(Store) error) error {\n16\t\treturn s.withExplicitGovernanceWriteGuard(operation, projectIDs, callback)\n17\t}\n18\t\n19\t// withExplicitGovernanceWriteGuard locks the local project and the exact set\n20\t// of foreign projects already discovered from the operation's material. A\n21\t// foreign root is eligible only when RootsConfig binds it explicitly; read\n22\t// discovery and ArtifactResolver.Authorize are not write coordination grants.\n23\t// The callback receives a fresh Store whose resolver is rebound to the guarded\n24\t// Stores and cannot resolve a project outside this set.\n25\tfunc (s Store) withExplicitGovernanceWriteGuard(operation string, projects []string, callback func(Store) error) error {\n26\t\tif callback == nil {\n27\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"callback is required\"))\n28\t\t}\n29\t\tlocalID := s.FederatedProjectID\n30\t\tif localID == \"\" {\n31\t\t\tvar err error\n32\t\t\tlocalID, err = s.WriteProjectID()\n33\t\t\tif err != nil {\n34\t\t\t\treturn err\n35\t\t\t}\n36\t\t}\n37\t\tif ValidateSlug(localID) != nil {\n38\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, \"\", errors.New(\"local project identity is unavailable\"))\n39\t\t}\n40\t\n41\t\tselected := map[string]bool{localID: true}\n42\t\tfor _, id := range projects {\n43\t\t\tif ValidateSlug(id) != nil {\n44\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, \"\", errors.New(\"invalid project identity in material set\"))\n45\t\t\t}\n46\t\t\tselected[id] = true\n47\t\t}\n48\t\tids := make([]string, 0, len(selected))\n49\t\tfor id := range selected {\n50\t\t\tids = append(ids, id)\n51\t\t}\n52\t\tsort.Strings(ids)\n53\t\n54\t\tresolver := ArtifactResolver{}\n55\t\tif s.FederatedResolver != nil {\n56\t\t\tresolver = *s.FederatedResolver\n57\t\t} else if len(ids) > 1 {\n58\t\t\tvar err error\n59\t\t\tresolver, _, err = EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n60\t\t\tif err != nil {\n61\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, \"\", err)\n62\t\t\t}\n63\t\t}\n64\t\tif len(ids) > 1 && resolver.Roots == nil {\n65\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, \"\", errors.New(\"federated roots are unavailable\"))\n66\t\t}\n67\t\n68\t\tstores := make([]Store, 0, len(ids))\n69\t\tcanonical := make(map[string]string, len(ids))\n70\t\tfor _, id := range ids {\n71\t\t\tstore := s\n72\t\t\tif id != localID {\n73\t\t\t\tconfigured := resolver.Roots.cfg.Explicit[id]\n74\t\t\t\tif configured == \"\" {\n75\t\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, id, errors.New(\"foreign writes require an explicit project root\"))\n76\t\t\t\t}\n77\t\t\t\tvar err error\n78\t\t\t\tstore, err = resolver.Roots.StoreFor(id)\n79\t\t\t\tif err != nil {\n80\t\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, id, err)\n81\t\t\t\t}\n82\t\t\t\twant, err := canonicalGovernanceRoot(configured)\n83\t\t\t\tif err != nil {\n84\t\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, id, err)\n85\t\t\t\t}\n86\t\t\t\tgot, err := canonicalGovernanceRoot(store.Root)\n87\t\t\t\tif err != nil || governanceRootKey(got) != governanceRootKey(want) {\n88\t\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, id, err)\n89\t\t\t\t}\n90\t\t\t}\n91\t\t\tstore.FederatedProjectID = id\n92\t\t\troot, err := canonicalGovernanceRoot(store.Root)\n93\t\t\tif err != nil {\n94\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, id, err)\n95\t\t\t}\n96\t\t\tcanonical[id] = root\n97\t\t\tstores = append(stores, store)\n98\t\t}\n99\t\tif lease, present := s.governanceWriteGuardInFiles(); present {\n100\t\t\tif lease == nil || !lease.Active() {\n101\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardReleased, operation, \"\", nil)\n102\t\t\t}\n103\t\t\tguardedByProject := make(map[string]Store, len(stores))\n104\t\t\tfor i, id := range ids {\n105\t\t\t\tstore := stores[i]\n106\t\t\t\tif !lease.Covers(store) {\n107\t\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, id, errors.New(\"the carried lease does not cover every material root\"))\n108\t\t\t\t}\n109\t\t\t\tchildLease, ok := store.GovernanceWriteLease()\n110\t\t\t\tif !ok || childLease != lease {\n111\t\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, id, errors.New(\"material store does not carry the same explicit lease\"))\n112\t\t\t\t}\n113\t\t\t\tguardedByProject[id] = store\n114\t\t\t}\n115\t\t\tlocal, ok := guardedByProject[localID]\n116\t\t\tif !ok {\n117\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, localID, errors.New(\"local project was not guarded\"))\n118\t\t\t}\n119\t\t\tif resolver.Roots != nil {\n120\t\t\t\tguardedResolver := resolver\n121\t\t\t\tguardedResolver.Roots = resolver.Roots.withGovernanceStores(guardedByProject)\n122\t\t\t\tguardedResolver.FS = newGovernanceRootVectorFiles(guardedByProject, localID)\n123\t\t\t\tguardedResolver.