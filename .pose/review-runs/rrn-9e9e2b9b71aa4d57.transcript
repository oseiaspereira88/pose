ey(canonical[id]) {\n162\t\t\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, id, err)\n163\t\t\t\t\t}\n164\t\t\t\t}\n165\t\t\t\tguardedResolver := resolver\n166\t\t\t\tguardedResolver.Roots = resolver.Roots.withGovernanceStores(guardedByProject)\n167\t\t\t\tguardedResolver.FS = newGovernanceRootVectorFiles(guardedByProject, localID)\n168\t\t\t\tguardedResolver.snapshots = nil\n169\t\t\t\tpriorAuthorize := resolver.Authorize\n170\t\t\t\tguardedResolver.Authorize = func(projectID string) bool {\n171\t\t\t\t\treturn selected[projectID] && (priorAuthorize == nil || priorAuthorize(projectID))\n172\t\t\t\t}\n173\t\t\t\tlocal.FederatedResolver = &guardedResolver\n174\t\t\t}\n175\t\t\treturn callback(local)\n176\t\t})\n177\t}\n178\t\n179\tfunc governanceProjectSetEqual(a, b map[string]bool) bool {\n180\t\tif len(a) != len(b) {\n181\t\t\treturn false\n182\t\t}\n183\t\tfor id := range a {\n184\t\t\tif !b[id] {\n185\t\t\t\treturn false\n186\t\t\t}\n187\t\t}\n188\t\treturn true\n189\t}\n190\t\n191\tfunc governanceProjectSetFromManifest(manifest *FederatedRoadmapManifest) map[string]bool {\n192\t\tout := map[string]bool{}\n193\t\tif manifest == nil {\n194\t\t\treturn out\n195\t\t}\n196\t\tfor _, dep := range manifest.Dependencies {\n197\t\t\tif dep.Identity.Project != \"\" {\n198\t\t\t\tout[dep.Identity.Project] = true\n199\t\t\t}\n200\t\t}\n201\t\treturn out\n202\t}\n203\t\n204\tfunc mergeGovernanceProjectSets(sets ...map[string]bool) map[string]bool {\n205\t\tout := map[string]bool{}\n206\t\tfor _, set := range sets {\n207\t\t\tfor id := range set {\n208\t\t\t\tout[id] = true\n209\t\t\t}\n210\t\t}\n211\t\treturn out\n212\t}\n213\t\n214\tfunc governanceProjectIDs(set map[string]bool) []string {\n215\t\tids := make([]string, 0, len(set))\n216\t\tfor id := range set {\n217\t\t\tids = append(ids, id)\n218\t\t}\n219\t\tsort.Strings(ids)\n220\t\treturn ids\n221\t}\n222\t\n223\tfunc requireSameGovernanceProjectSet(operation string, locked, observed m