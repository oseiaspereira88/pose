{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ECYh4c1ThxmF6xw3nNZU2q","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"fmt\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"reflect\"\n9\t\t\"runtime\"\n10\t\t\"sort\"\n11\t\t\"strings\"\n12\t\t\"sync\"\n13\t\t\"sync/atomic\"\n14\t)\n15\t\n16\tconst (\n17\t\t// MaxGovernanceWriteRoots bounds the root lock set of one operation.\n18\t\tMaxGovernanceWriteRoots    = 16\n19\t\tmaxGovernanceFilesWrappers = 8\n20\t)\n21\t\n22\tvar (\n23\t\tErrGovernanceWriteGuardBusy         = errors.New(\"governance-write-guard-busy\")\n24\t\tErrGovernanceWriteGuardUnsupported  = errors.New(\"governance-write-guard-unsupported\")\n25\t\tErrGovernanceWriteGuardUnavailable  = errors.New(\"governance-write-guard-unavailable\")\n26\t\tErrGovernanceWriteGuardInvalid      = errors.New(\"governance-write-guard-invalid\")\n27\t\tErrGovernanceWriteGuardTooManyRoots = errors.New(\"governance-write-guard-too-many-roots\")\n28\t\tErrGovernanceWriteGuardRootBinding  = errors.New(\"governance-write-guard-root-binding\")\n29\t\tErrGovernanceWriteGuardReleased     = errors.New(\"governance-write-guard-released\")\n30\t\tErrGovernanceWriteGuardReentrant    = errors.New(\"governance-write-guard-reentrant\")\n31\t\tErrGovernanceWriteGuardMixedPreview = errors.New(\"governance-write-guard-mixed-preview\")\n32\t)\n33\t\n34\t// GovernanceWriteGuardError is a bounded, non-waiting refusal. Root names are\n35\t// project IDs when available and otherwise the final path element; absolute\n36\t// host paths are never included in the error.\n37\ttype GovernanceWriteGuardError struct {\n38\t\tkind      error\n39\t\toperation string\n40\t\troot      string\n41\t\tcause     error\n42\t}\n43\t\n44\tfunc (e *GovernanceWriteGuardError) Error() string {\n45\t\tmessage := \"pose: \" + e.kind.Error()\n46\t\tif e.operation != \"\" {\n47\t\t\tmessage += \" during \" + e.operation\n48\t\t}\n49\t\tif e.root != \"\" {\n50\t\t\tmessage += \" for \" + e.root\n51\t\t}\n52\t\tif e.cause != nil {\n53\t\t\tmessage += \": \" + e.cause.Error()\n54\t\t}\n55\t\treturn message\n56\t}\n57\t\n58\tfunc (e *GovernanceWriteGuardError) Unwrap() error { return e.cause }\n59\tfunc (e *GovernanceWriteGuardError) Is(target error) bool {\n60\t\treturn target == e.kind\n61\t}\n62\t\n63\tfunc governanceGuardError(kind error, operation, root string, cause error) error {\n64\t\treturn &GovernanceWriteGuardError{kind: kind, operation: operation, root: root, cause: cause}\n65\t}\n66\t\n67\ttype governanceGuardRoot struct {\n68\t\tpath      string // canonical physical root; internal only\n69\t\tkey       string\n70\t\tprojectID string\n71\t\tlabel     string\n72\t}\n73\t\n74\t// GovernanceWriteLease is the explicit lease carried by guarded Store/Files\n75\t// copies. It only coordinates writers that acquire the same per-root lock.\n76\t// The lease is not an atomic filesystem snapshot and grants no authorization\n77\t// after Release.\n78\ttype GovernanceWriteLease struct {\n79\t\toperation string\n80\t\troots     []governanceGuardRoot // canonical acquisition order\n81\t\tbyKey     map[string]governanceGuardRoot\n82\t\tpreview   bool\n83\t\tactive    atomic.Bool\n84\t\tonce      sync.Once\n85\t\trelease   func()\n86\t}\n87\t\n88\t// Release releases roots in reverse canonical order. Repeated calls are safe.\n89\tfunc (l *GovernanceWriteLease) Release() {\n90\t\tif l == nil {\n91\t\t\treturn\n92\t\t}\n93\t\tl.once.Do(func() {\n94\t\t\tl.active.Store(false)\n95\t\t\tif l.release != nil {\n96\t\t\t\tl.release()\n97\t\t\t}\n98\t\t})\n99\t}\n100\t\n101\t// Active reports whether this lease is still in its guarded callback.\n102\tfunc (l *GovernanceWriteLease) Active() bool {\n103\t\treturn l != nil && l.active.Load()\n104\t}\n105\t\n106\t// Preview reports a non-locking lease used only to stage a preview. It never\n107\t// claims to exclude a concurrent writer.\n108\tfunc (l *GovernanceWriteLease) Preview() bool {\n109\t\treturn l != nil && l.preview\n110\t}\n111\t\n112\t// Covers reports whether this lease is bound to the Store's physical root and\n113\t// project selector. It returns false after the lease is released.\n114\tfunc (l *GovernanceWriteLease) Covers(store Store) bool {\n115\t\tif l == nil || !l.active.Load() {\n116\t\t\treturn false\n117\t\t}\n118\t\troot, err := canonicalGovernanceRoot(store.Root)\n119\t\tif err != nil {\n120\t\t\treturn false\n121\t\t}\n122\t\tbinding, ok := l.byKey[governanceRootKey(root)]\n123\t\treturn ok && binding.projectID == store.FederatedProjectID\n124\t}\n125\t\n126\t// WithGovernanceWriteGuard acquires one non-waiting root guard for every\n127\t// already-authorized Store, in canonical root order, then invokes callback\n128\t// with copies that carry the lease through Files. It never discovers or\n129\t// authorizes roots. The guard uses the stable B14 transfer lock path and must\n130\t// be acquired before resource locks. A preview stages through PreviewFiles\n131\t// without creating lock directories or files.\n132\tfunc WithGovernanceWriteGuard(operation string, roots []Store, callback func([]Store) error) error {\n133\t\tif callback == nil || strings.TrimSpace(operation) == \"\" || len(operation) > 96 || strings.ContainsAny(operation, \"\\r\\n\\x00\") {\n134\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"operation and callback are required\"))\n135\t\t}\n136\t\tif len(roots) == 0 {\n137\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"no authorized roots were supplied\"))\n138\t\t}\n139\t\tfreshRoots := make([]Store, len(roots))\n140\t\tfor i, store := range roots {\n141\t\t\tif lease, present := store.governanceWriteGuardInFiles(); present {\n142\t\t\t\tif lease == nil || !lease.Active() {\n143\t\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardReleased, operation, \"\", nil)\n144\t\t\t\t}\n145\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardReentrant, operation, \"\", errors.New(\"pass the existing lease through Store/Files instead of reacquiring it\"))\n146\t\t\t}\n147\t\t\tfreshRoots[i] = store.withoutGovernanceReadView()\n148\t\t}\n149\t\troots = freshRoots\n150\t\n151\t\tbindings, storeKeys, preview, err := prepareGovernanceGuardRoots(roots, operation)\n152\t\tif err != nil {\n153\t\t\treturn err\n154\t\t}\n155\t\tif len(bindings) > MaxGovernanceWriteRoots {\n156\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardTooManyRoots, operation, \"\", fmt.Errorf(\"got %d unique roots; maximum is %d\", len(bindings), MaxGovernanceWriteRoots))\n157\t\t}\n158\t\n159\t\tlease := &GovernanceWriteLease{operation: operation, roots: bindings, byKey: make(map[string]governanceGuardRoot, len(bindings)), preview: preview}\n160\t\tfor _, binding := range bindings {\n161\t\t\tlease.byKey[binding.key] = binding\n162\t\t}\n163\t\tif !preview {\n164\t\t\trelease, lockErr := acquireGovernanceRootLocks(bindings, operation)\n165\t\t\tif lockErr != nil {\n166\t\t\t\treturn lockErr\n167\t\t\t}\n168\t\t\tlease.release = release\n169\t\t}\n170\t\tlease.active.Store(true)\n171\t\tdefer lease.Release()\n172\t\n173\t\tguarded := make([]Store, len(roots))\n174\t\tfor i, store := range roots {\n175\t\t\tbinding, ok := lease.byKey[storeKeys[i]]\n176\t\t\tif !ok || binding.projectID != store.FederatedProjectID {\n177\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, \"\", errors.New(\"root binding changed during guard preparation\"))\n178\t\t\t}\n179\t\t\t// Bind both Files path checks and Store path construction to the same\n180\t\t\t// physical root. Keeping a symlink spelling in Store.Root would make\n181\t\t\t// legitimate writes appear outside the canonical root.\n182\t\t\tstore.Root = binding.path\n183\t\t\tstore.FS = &governanceGuardFiles{Files: store.fsys(), lease: lease, root: binding.path, projectID: binding.projectID}\n184\t\t\tguarded[i] = store\n185\t\t}\n186\t\treturn callback(guarded)\n187\t}\n188\t\n189\t// GovernanceWriteLease retrieves the explicit lease from a Store's Files\n190\t// chain. Optional UnderlyingFiles wrappers are followed with a depth and\n191\t// cycle bound, so a read-only view can carry but cannot manufacture a lease.\n192\tfunc (s Store) GovernanceWriteLease() (*GovernanceWriteLease, bool) {\n193\t\tlease, present := s.governanceWriteGuardInFiles()\n194\t\tif !present || !lease.Active() || !lease.Covers(s) {\n195\t\t\treturn nil, false\n196\t\t}\n197\t\treturn lease, true\n198\t}\n199\t\n200\t// withGovernanceWriteGuard runs an effectful operation under the explicit\n201\t// per-root lease. Callers may compose guarded operations by carrying the Store\n202\t// received in their callback; a released or misbound lease is a refusal.\n203\tfunc (s Store) withGovernanceWriteGuard(operation string, callback func(Store) error) error {\n204\t\tif callback == nil {\n205\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"callback is required\"))\n206\t\t}\n207\t\tif lease, present := s.governanceWriteGuardInFiles(); present {\n208\t\t\tif lease == nil || !lease.Active() {\n209\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardReleased, operation, \"\", nil)\n210\t\t\t}\n211\t\t\tif !lease.Covers(s) {\n212\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, \"\", nil)\n213\t\t\t}\n214\t\t\t// Reuse the explicit lease, but never let an earlier read-only\n215\t\t\t// operation view authorize a fresh effect evaluation. Unwrap that\n216\t\t\t// observation to the guarded source and clear Store-level memoized\n217\t\t\t// inputs before evaluating under the lease.\n218\t\t\treturn callback(s.withoutGovernanceReadView())\n219\t\t}\n220\t\treturn WithGovernanceWriteGuard(operation, []Store{s}, func(stores []Store) error {\n221\t\t\treturn callback(stores[0])\n222\t\t})\n223\t}\n224\t\n225\tfunc (s Store) governanceWriteGuardInFiles() (*GovernanceWriteLease, bool) {\n226\t\tfiles := s.fsys()\n227\t\tseen := make([]Files, 0, maxGovernanceFilesWrappers)\n228\t\tfor depth := 0; depth < maxGovernanceFilesWrappers; depth++ {\n229\t\t\tfor _, prior := range seen {\n230\t\t\t\tif sameGovernanceFiles(prior, files) {\n231\t\t\t\t\treturn nil, false\n232\t\t\t\t}\n233\t\t\t}\n234\t\t\tseen = append(seen, files)\n235\t\t\tif carrier, ok := files.(interface{ GovernanceWriteLease() *GovernanceWriteLease }); ok {\n236\t\t\t\tlease := carrier.GovernanceWriteLease()\n237\t\t\t\treturn lease, lease != nil\n238\t\t\t}\n239\t\t\tunwrapper, ok := files.(interface{ UnderlyingFiles() Files })\n240\t\t\tif !ok {\n241\t\t\t\treturn nil, false\n242\t\t\t}\n243\t\t\tnext := unwrapper.UnderlyingFiles()\n244\t\t\tif next == nil {\n245\t\t\t\treturn nil, false\n246\t\t\t}\n247\t\t\tfiles = next\n248\t\t}\n249\t\treturn nil, false\n250\t}\n251\t\n252\tfunc sameGovernanceFiles(a, b Files) bool {\n253\t\tif a == nil || b == nil || reflect.TypeOf(a) != reflect.TypeOf(b) {\n254\t\t\treturn a == nil && b == nil\n255\t\t}\n256\t\tva, vb := reflect.ValueOf(a), reflect.ValueOf(b)\n257\t\tif va.Comparable() {\n258\t\t\treturn va.Interface() == vb.Interface()\n259\t\t}\n260\t\tif va.Kind() == reflect.Ptr {\n261\t\t\treturn va.Pointer() == vb.Pointer()\n262\t\t}\n263\t\treturn false // the wrapper-depth bound still stops an uncomparable cycle\n264\t}\n265\t\n266\ttype governanceGuardFiles struct {\n267\t\tFiles\n268\t\tlease     *GovernanceWriteLease\n269\t\troot      string\n270\t\tprojectID string\n271\t}\n272\t\n273\t// UnderlyingFiles lets another operation-scoped Files wrapper preserve the\n274\t// explicit lease without making Files itself grow a mandatory method.\n275\tfunc (f *governanceGuardFiles) UnderlyingFiles() Files { return f.Files }\n276\t\n277\tfunc (f *governanceGuardFiles) GovernanceWriteLease() *GovernanceWriteLease { return f.lease }\n278\t\n279\t// Preserve operation-specific durability hooks carried by a Files wrapper.\n280\t// The guard remains the mutation boundary; the underlying hook still observes\n281\t// the same append receipt after the journal lock has been acquired.\n282\tfunc (f *governanceGuardFiles) syncActionJournal(file *os.File) error {\n283\t\tif syncer, ok := f.Files.(interface{ syncActionJournal(*os.File) error }); ok {\n284\t\t\treturn syncer.syncActionJournal(file)\n285\t\t}\n286\t\treturn file.Sync()\n287\t}\n288\t\n289\tfunc (f *governanceGuardFiles) writable() error {\n290\t\tif f == nil || f.lease == nil || !f.lease.Active() {\n291\t\t\treturn ErrGovernanceWriteGuardReleased\n292\t\t}\n293\t\tif !f.lease.preview && !f.lease.coversBinding(f.root, f.projectID) {\n294\t\t\treturn ErrGovernanceWriteGuardRootBinding\n295\t\t}\n296\t\treturn nil\n297\t}\n298\t\n299\t// Writes through a retained guarded Store stop when its callback releases the\n300\t// lease. Preview writes remain staged by PreviewFiles and never touch disk.\n301\tfunc (f *governanceGuardFiles) WriteFile(name string, data []byte, perm os.FileMode) error {\n302\t\tif err := f.writable(); err != nil {\n303\t\t\treturn err\n304\t\t}\n305\t\treturn f.Files.WriteFile(name, data, perm)\n306\t}\n307\tfunc (f *governanceGuardFiles) CreateExclusive(name string, data []byte, perm os.FileMode, syncFile bool) error {\n308\t\tif err := f.writable(); err != nil {\n309\t\t\treturn err\n310\t\t}\n311\t\treturn f.Files.CreateExclusive(name, data, perm, syncFile)\n312\t}\n313\tfunc (f *governanceGuardFiles) Publish(name string, data []byte, perm os.FileMode, class string, expect PublishExpectation) error {\n314\t\tif err := f.writable(); err != nil {\n315\t\t\treturn err\n316\t\t}\n317\t\treturn f.Files.Publish(name, data, perm, class, expect)\n318\t}\n319\tfunc (f *governanceGuardFiles) MkdirAll(name string, perm os.FileMode) error {\n320\t\tif err := f.writable(); err != nil {\n321\t\t\treturn err\n322\t\t}\n323\t\treturn f.Files.MkdirAll(name, perm)\n324\t}\n325\tfunc (f *governanceGuardFiles) Mkdir(name string, perm os.FileMode) error {\n326\t\tif err := f.writable(); err != nil {\n327\t\t\treturn err\n328\t\t}\n329\t\treturn f.Files.Mkdir(name, perm)\n330\t}\n331\tfunc (f *governanceGuardFiles) Remove(name string) error {\n332\t\tif err := f.writable(); err != nil {\n333\t\t\treturn err\n334\t\t}\n335\t\treturn f.Files.Remove(name)\n336\t}\n337\tfunc (f *governanceGuardFiles) RemoveAll(name string) error {\n338\t\tif err := f.writable(); err != nil {\n339\t\t\treturn err\n340\t\t}\n341\t\treturn f.Files.RemoveAll(name)\n342\t}\n343\tfunc (f *governanceGuardFiles) Symlink(oldname, newname string) error {\n344\t\tif err := f.writable(); err != nil {\n345\t\t\treturn err\n346\t\t}\n347\t\treturn f.Files.Symlink(oldname, newname)\n348\t}\n349\t\n350\tfunc (l *GovernanceWriteLease) coversBinding(root, projectID string) bool {\n351\t\tif l == nil || !l.active.Load() {\n352\t\t\treturn false\n353\t\t}\n354\t\tbinding, ok := l.byKey[governanceRootKey(root)]\n355\t\treturn ok && binding.path == root && binding.projectID == projectID\n356\t}\n357\t\n358\tfunc prepareGovernanceGuardRoots(stores []Store, operation string) ([]governanceGuardRoot, []string, bool, error) {\n359\t\tpreviewCount := 0\n360\t\tfor _, store := range stores {\n361\t\t\tif store.fsys().Preview() != nil {\n362\t\t\t\tpreviewCount++\n363\t\t\t}\n364\t\t}\n365\t\tif previewCount != 0 && previewCount != len(stores) {\n366\t\t\treturn nil, nil, false, governanceGuardError(ErrGovernanceWriteGuardMixedPreview, operation, \"\", errors.New(\"all roots must use preview Files or all roots must use native Files\"))\n367\t\t}\n368\t\tpreview := previewCount == len(stores)\n369\t\n370\t\tbyKey := make(map[string]governanceGuardRoot, len(stores))\n371\t\tstoreKeys := make([]string, len(stores))\n372\t\tfor i, store := range stores {\n373\t\t\troot, err := canonicalGovernanceRoot(store.Root)\n374\t\t\tif err != nil {\n375\t\t\t\treturn nil, nil, false, governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, store.FederatedProjectID, err)\n376\t\t\t}\n377\t\t\tkey := governanceRootKey(root)\n378\t\t\tbinding := governanceGuardRoot{path: root, key: key, projectID: store.FederatedProjectID, label: governanceRootLabel(root, store.FederatedProjectID)}\n379\t\t\tif prior, exists := byKey[key]; exists {\n380\t\t\t\tif prior.projectID != binding.projectID {\n381\t\t\t\t\treturn nil, nil, false, governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, binding.label, errors.New(\"one physical root was selected with different project bindings\"))\n382\t\t\t\t}\n383\t\t\t} else {\n384\t\t\t\tif err := validateGovernanceLockPaths(binding); err != nil {\n385\t\t\t\t\treturn nil, nil, false, governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, binding.label, err)\n386\t\t\t\t}\n387\t\t\t\tbyKey[key] = binding\n388\t\t\t}\n389\t\t\tstoreKeys[i] = key\n390\t\t}\n391\t\tbindings := make([]governanceGuardRoot, 0, len(byKey))\n392\t\tfor _, binding := range byKey {\n393\t\t\tbindings = append(bindings, binding)\n394\t\t}\n395\t\tsort.Slice(bindings, func(i, j int) bool { return bindings[i].key < bindings[j].key })\n396\t\treturn bindings, storeKeys, preview, nil\n397\t}\n398\t\n399\tfunc canonicalGovernanceRoot(root string) (string, error) {\n400\t\tif strings.TrimSpace(root) == \"\" {\n401\t\t\treturn \"\", errors.New(\"root is empty\")\n402\t\t}\n403\t\tabs, err := filepath.Abs(root)\n404\t\tif err != nil {\n405\t\t\treturn \"\", err\n406\t\t}\n407\t\tphysical, err := filepath.EvalSymlinks(abs)\n408\t\tif err != nil {\n409\t\t\treturn \"\", err\n410\t\t}\n411\t\tphysical = filepath.Clean(physical)\n412\t\tinfo, err := os.Stat(physical)\n413\t\tif err != nil {\n414\t\t\treturn \"\", err\n415\t\t}\n416\t\tif !info.IsDir() {\n417\t\t\treturn \"\", errors.New(\"root is not a directory\")\n418\t\t}\n419\t\treturn physical, nil\n420\t}\n421\t\n422\tfunc governanceRootKey(root string) string {\n423\t\tkey := filepath.Clean(root)\n424\t\tif runtime.GOOS == \"windows\" {\n425\t\t\tkey = strings.ToLower(key)\n426\t\t}\n427\t\treturn key\n428\t}\n429\t\n430\tfunc governanceRootLabel(root, projectID string) string {\n431\t\tif projectID != \"\" {\n432\t\t\treturn projectID\n433\t\t}\n434\t\treturn filepath.Base(root)\n435\t}\n436\t\n437\tfunc validateGovernanceLockPaths(root governanceGuardRoot) error {\n438\t\tposeDir := filepath.Join(root.path, \".pose\")\n439\t\tinfo, err := os.Lstat(poseDir)\n440\t\tif errors.Is(err, os.ErrNotExist) {\n441\t\t\t// A first effectful write may be the operation that creates .pose.\n442\t\t\t// The canonical root is already validated and the lock path below is\n443\t\t\t// created with non-recursive mkdirs that reject a link substituted in\n444\t\t\t// this gap.\n445\t\t\treturn nil\n446\t\t}\n447\t\tif err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(NativeFiles(), root.path, poseDir) {\n448\t\t\tif err != nil {\n449\t\t\t\treturn fmt.Errorf(\".pose directory is unavailable: %w\", err)\n450\t\t\t}\n451\t\t\treturn errors.New(\".pose directory is linked, not a directory, or escapes the authorized root\")\n452\t\t}\n453\t\ttransfersDir := filepath.Join(poseDir, \"transfers\")\n454\t\tif info, err := os.Lstat(transfersDir); err == nil {\n455\t\t\tif !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(NativeFiles(), root.path, transfersDir) {\n456\t\t\t\treturn errors.New(\"transfer lock directory is linked, not a directory, or escapes the authorized root\")\n457\t\t\t}\n458\t\t} else if !errors.Is(err, os.ErrNotExist) {\n459\t\t\treturn fmt.Errorf(\"transfer lock directory cannot be inspected: %w\", err)\n460\t\t}\n461\t\tlockPath := filepath.Join(transfersDir, \".authority-transfer.lock\")\n462\t\tif info, err := os.Lstat(lockPath); err == nil {\n463\t\t\tif !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(NativeFiles(), root.path, lockPath) {\n464\t\t\t\treturn errors.New(\"authority transfer lock is linked, not a regular file, or escapes the authorized root\")\n465\t\t\t}\n466\t\t} else if !errors.Is(err, os.ErrNotExist) {\n467\t\t\treturn fmt.Errorf(\"authority transfer lock cannot be inspected: %w\", err)\n468\t\t}\n469\t\treturn nil\n470\t}\n471\t\n472\tfunc acquireGovernanceRootLocks(roots []governanceGuardRoot, operation string) (func(), error) {\n473\t\tfiles := make([]*os.File, 0, len(roots))\n474\t\tunlockers := make([]func(), 0, len(roots))\n475\t\tcleanup := func() {\n476\t\t\tfor i := len(unlockers) - 1; i >= 0; i-- {\n477\t\t\t\tunlockers[i]()\n478\t\t\t}\n479\t\t\tfor i := len(files) - 1; i >= 0; i-- {\n480\t\t\t\t_ = files[i].Close()\n481\t\t\t}\n482\t\t}\n483\t\tfor _, root := range roots {\n484\t\t\tposeDir := filepath.Join(root.path, \".pose\")\n485\t\t\tif err := ensureGovernanceLockDirectory(root, poseDir); err != nil {\n486\t\t\t\tcleanup()\n487\t\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, root.label, err)\n488\t\t\t}\n489\t\t\ttransfersDir := filepath.Join(root.path, \".pose\", \"transfers\")\n490\t\t\tif err := ensureGovernanceLockDirectory(root, transfersDir); err != nil {\n491\t\t\t\tcleanup()\n492\t\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, root.label, err)\n493\t\t\t}\n494\t\t\tif err := validateGovernanceLockPaths(root); err != nil {\n495\t\t\t\tcleanup()\n496\t\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, root.label, err)\n497\t\t\t}\n498\t\t\tpath := filepath.Join(transfersDir, \".authority-transfer.lock\")\n499\t\t\tfile, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o644)\n500\t\t\tif err != nil {\n501\t\t\t\tcleanup()\n502\t\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, root.label, err)\n503\t\t\t}\n504\t\t\tfiles = append(files, file)\n505\t\t\topened, statErr := file.Stat()\n506\t\t\tcurrent, lstatErr := os.Lstat(path)\n507\t\t\tif statErr != nil || lstatErr != nil || current.Mode()&os.ModeSymlink != 0 || !current.Mode().IsRegular() || !os.SameFile(opened, current) || !artifactPathWithin(NativeFiles(), root.path, path) {\n508\t\t\t\tcleanup()\n509\t\t\t\tcause := errors.New(\"authority transfer lock changed or escaped during open\")\n510\t\t\t\tif statErr != nil {\n511\t\t\t\t\tcause = statErr\n512\t\t\t\t} else if lstatErr != nil {\n513\t\t\t\t\tcause = lstatErr\n514\t\t\t\t}\n515\t\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, root.label, cause)\n516\t\t\t}\n517\t\t\tunlock, lockErr := lockSpecTransferFile(file)\n518\t\t\tif lockErr != nil {\n519\t\t\t\tcleanup()\n520\t\t\t\tif errors.Is(lockErr, errFileLockUnsupported) {\n521\t\t\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnsupported, operation, root.label, lockErr)\n522\t\t\t\t}\n523\t\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardBusy, operation, root.label, lockErr)\n524\t\t\t}\n525\t\t\tunlockers = append(unlockers, unlock)\n526\t\t}\n527\t\treturn cleanup, nil\n528\t}\n529\t\n530\tfunc ensureGovernanceLockDirectory(root governanceGuardRoot, path string) error {\n531\t\tif info, err := os.Lstat(path); errors.Is(err, os.ErrNotExist) {\n532\t\t\tif err := os.Mkdir(path, 0o755); err != nil && !errors.Is(err, os.ErrExist) {\n533\t\t\t\treturn err\n534\t\t\t}\n535\t\t} else if err != nil {\n536\t\t\treturn err\n537\t\t} else if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(NativeFiles(), root.path, path) {\n538\t\t\treturn errors.New(\"guard directory is linked, not a directory, or escapes the authorized root\")\n539\t\t}\n540\t\tinfo, err := os.Lstat(path)\n541\t\tif err != nil {\n542\t\t\treturn err\n543\t\t}\n544\t\tif !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(NativeFiles(), root.path, path) {\n545\t\t\treturn errors.New(\"guard directory changed to a link, non-directory, or escaped the authorized root\")\n546\t\t}\n547\t\treturn nil\n548\t}\n549\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"40c90180-9c0f-4eb9-8774-4811e6b2d9e4","timestamp":"2026-11-06T19:07:55.580Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/pose-review-run-3263644701/worktree/pose-mcp/internal/pose/governance_write_guard.go","content":"package pose\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n)\n\nconst (\n\t// MaxGovernanceWriteRoots bounds the root lock set of one operation.\n\tMaxGovernanceWriteRoots    = 16\n\tmaxGovernanceFilesWrappers = 8\n)\n\nvar (\n\tErrGovernanceWriteGuardBusy         = errors.New(\"governance-write-guard-busy\")\n\tErrGovernanceWriteGuardUnsupported  = errors.New(\"governance-write-guard-unsupported\")\n\tErrGovernanceWriteGuardUnavailable  = errors.New(\"governance-write-guard-unavailable\")\n\tErrGovernanceWriteGuardInvalid      = errors.New(\"governance-write-guard-invalid\")\n\tErrGovernanceWriteGuardTooManyRoots = errors.New(\"governance-write-guard-too-many-roots\")\n\tErrGovernanceWriteGuardRootBinding  = errors.New(\"governance-write-guard-root-binding\")\n\tErrGovernanceWriteGuardReleased     = errors.New(\"governance-write-guard-released\")\n\tErrGovernanceWriteGuardReentrant    = errors.New(\"governance-write-guard-reentrant\")\n\tErrGovernanceWriteGuardMixedPreview = errors.New(\"governance-write-guard-mixed-preview\")\n)\n\n// GovernanceWriteGuardError is a bounded, non-waiting refusal. Root names are\n// project IDs when available and otherwise the final path element; absolute\n// host paths are never included in the error.\ntype GovernanceWriteGuardError struct {\n\tkind      error\n\toperation string\n\troot      string\n\tcause     error\n}\n\nfunc (e *GovernanceWriteGuardError) Error() string {\n\tmessage := \"pose: \" + e.kind.Error()\n\tif e.operation != \"\" {\n\t\tmessage += \" during \" + e.operation\n\t}\n\tif e.root != \"\" {\n\t\tmessage += \" for \" + e.root\n\t}\n\tif e.cause != nil {\n\t\tmessage += \": \" + e.cause.Error()\n\t}\n\treturn message\n}\n\nfunc (e *GovernanceWriteGuardError) Unwrap() error { return e.cause }\nfunc (e *GovernanceWriteGuardError) Is(target error) bool {\n\treturn target == e.kind\n}\n\nfunc governanceGuardError(kind error, operation, root string, cause error) error {\n\treturn &GovernanceWriteGuardError{kind: kind, operation: operation, root: root, cause: cause}\n}\n\ntype governanceGuardRoot struct {\n\tpath      string // canonical physical root; internal only\n\tkey       string\n\tprojectID string\n\tlabel     string\n}\n\n// GovernanceWriteLease is the explicit lease carried by guarded Store/Files\n// copies. It only coordinates writers that acquire the same per-root lock.\n// The lease is not an atomic filesystem snapshot and grants no authorization\n// after Release.\ntype GovernanceWriteLease struct {\n\toperation string\n\troots     []governanceGuardRoot // canonical acquisition order\n\tbyKey     map[string]governanceGuardRoot\n\tpreview   bool\n\tactive    atomic.Bool\n\tonce      sync.Once\n\trelease   func()\n}\n\n// Release releases roots in reverse canonical order. Repeated calls are safe.\nfunc (l *GovernanceWriteLease) Release() {\n\tif l == nil {\n\t\treturn\n\t}\n\tl.once.Do(func() {\n\t\tl.active.Store(false)\n\t\tif l.release != nil {\n\t\t\tl.release()\n\t\t}\n\t})\n}\n\n// Active reports whether this lease is still in its guarded callback.\nfunc (l *GovernanceWriteLease) Active() bool {\n\treturn l != nil && l.active.Load()\n}\n\n// Preview reports a non-locking lease used only to stage a preview. It never\n// claims to exclude a concurrent writer.\nfunc (l *GovernanceWriteLease) Preview() bool {\n\treturn l != nil && l.preview\n}\n\n// Covers reports whether this lease is bound to the Store's physical root and\n// project selector. It returns false after the lease is released.\nfunc (l *GovernanceWriteLease) Covers(store Store) bool {\n\tif l == nil || !l.active.Load() {\n\t\treturn false\n\t}\n\troot, err := canonicalGovernanceRoot(store.Root)\n\tif err != nil {\n\t\treturn false\n\t}\n\tbinding, ok := l.byKey[governanceRootKey(root)]\n\treturn ok && binding.projectID == store.FederatedProjectID\n}\n\n// WithGovernanceWriteGuard acquires one non-waiting root guard for every\n// already-authorized Store, in canonical root order, then invokes callback\n// with copies that carry the lease through Files. It never discovers or\n// authorizes roots. The guard uses the stable B14 transfer lock path and must\n// be acquired before resource locks. A preview stages through PreviewFiles\n// without creating lock directories or files.\nfunc WithGovernanceWriteGuard(operation string, roots []Store, callback func([]Store) error) error {\n\tif callback == nil || strings.TrimSpace(operation) == \"\" || len(operation) > 96 || strings.ContainsAny(operation, \"\\r\\n\\x00\") {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"operation and callback are required\"))\n\t}\n\tif len(roots) == 0 {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"no authorized roots were supplied\"))\n\t}\n\tfreshRoots := make([]Store, len(roots))\n\tfor i, store := range roots {\n\t\tif lease, present := store.governanceWriteGuardInFiles(); present {\n\t\t\tif lease == nil || !lease.Active() {\n\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardReleased, operation, \"\", nil)\n\t\t\t}\n\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardReentrant, operation, \"\", errors.New(\"pass the existing lease through Store/Files instead of reacquiring it\"))\n\t\t}\n\t\tfreshRoots[i] = store.withoutGovernanceReadView()\n\t}\n\troots = freshRoots\n\n\tbindings, storeKeys, preview, err := prepareGovernanceGuardRoots(roots, operation)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif len(bindings) > MaxGovernanceWriteRoots {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardTooManyRoots, operation, \"\", fmt.Errorf(\"got %d unique roots; maximum is %d\", len(bindings), MaxGovernanceWriteRoots))\n\t}\n\n\tlease := &GovernanceWriteLease{operation: operation, roots: bindings, byKey: make(map[string]governanceGuardRoot, len(bindings)), preview: preview}\n\tfor _, binding := range bindings {\n\t\tlease.byKey[binding.key] = binding\n\t}\n\tif !preview {\n\t\trelease, lockErr := acquireGovernanceRootLocks(bindings, operation)\n\t\tif lockErr != nil {\n\t\t\treturn lockErr\n\t\t}\n\t\tlease.release = release\n\t}\n\tlease.active.Store(true)\n\tdefer lease.Release()\n\n\tguarded := make([]Store, len(roots))\n\tfor i, store := range roots {\n\t\tbinding, ok := lease.byKey[storeKeys[i]]\n\t\tif !ok || binding.projectID != store.FederatedProjectID {\n\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, \"\", errors.New(\"root binding changed during guard preparation\"))\n\t\t}\n\t\t// Bind both Files path checks and Store path construction to the same\n\t\t// physical root. Keeping a symlink spelling in Store.Root would make\n\t\t// legitimate writes appear outside the canonical root.\n\t\tstore.Root = binding.path\n\t\tstore.FS = &governanceGuardFiles{Files: store.fsys(), lease: lease, root: binding.path, projectID: binding.projectID}\n\t\tguarded[i] = store\n\t}\n\treturn callback(guarded)\n}\n\n// GovernanceWriteLease retrieves the explicit lease from a Store's Files\n// chain. Optional UnderlyingFiles wrappers are followed with a depth and\n// cycle bound, so a read-only view can carry but cannot manufacture a lease.\nfunc (s Store) GovernanceWriteLease() (*GovernanceWriteLease, bool) {\n\tlease, present := s.governanceWriteGuardInFiles()\n\tif !present || !lease.Active() || !lease.Covers(s) {\n\t\treturn nil, false\n\t}\n\treturn lease, true\n}\n\n// withGovernanceWriteGuard runs an effectful operation under the explicit\n// per-root lease. Callers may compose guarded operations by carrying the Store\n// received in their callback; a released or misbound lease is a refusal.\nfunc (s Store) withGovernanceWriteGuard(operation string, callback func(Store) error) error {\n\tif callback == nil {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"callback is required\"))\n\t}\n\tif lease, present := s.governanceWriteGuardInFiles(); present {\n\t\tif lease == nil || !lease.Active() {\n\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardReleased, operation, \"\", nil)\n\t\t}\n\t\tif !lease.Covers(s) {\n\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, \"\", nil)\n\t\t}\n\t\t// Reuse the explicit lease, but never let an earlier read-only\n\t\t// operation view authorize a fresh effect evaluation. Unwrap that\n\t\t// observation to the guarded source and clear Store-level memoized\n\t\t// inputs before evaluating under the lease.\n\t\treturn callback(s.withoutGovernanceReadView())\n\t}\n\treturn WithGovernanceWriteGuard(operation, []Store{s}, func(stores []Store) error {\n\t\treturn callback(stores[0])\n\t})\n}\n\nfunc (s Store) governanceWriteGuardInFiles() (*GovernanceWriteLease, bool) {\n\tfiles := s.fsys()\n\tseen := make([]Files, 0, maxGovernanceFilesWrappers)\n\tfor depth := 0; depth < maxGovernanceFilesWrappers; depth++ {\n\t\tfor _, prior := range seen {\n\t\t\tif sameGovernanceFiles(prior, files) {\n\t\t\t\treturn nil, false\n\t\t\t}\n\t\t}\n\t\tseen = append(seen, files)\n\t\tif carrier, ok := files.(interface{ GovernanceWriteLease() *GovernanceWriteLease }); ok {\n\t\t\tlease := carrier.GovernanceWriteLease()\n\t\t\treturn lease, lease != nil\n\t\t}\n\t\tunwrapper, ok := files.(interface{ UnderlyingFiles() Files })\n\t\tif !ok {\n\t\t\treturn nil, false\n\t\t}\n\t\tnext := unwrapper.UnderlyingFiles()\n\t\tif next == nil {\n\t\t\treturn nil, false\n\t\t}\n\t\tfiles = next\n\t}\n\treturn nil, false\n}\n\nfunc sameGovernanceFiles(a, b Files) bool {\n\tif a == nil || b == nil || reflect.TypeOf(a) != reflect.TypeOf(b) {\n\t\treturn a == nil && b == nil\n\t}\n\tva, vb := reflect.ValueOf(a), reflect.ValueOf(b)\n\tif va.Comparable() {\n\t\treturn va.Interface() == vb.Interface()\n\t}\n\tif va.Kind() == reflect.Ptr {\n\t\treturn va.Pointer() == vb.Pointer()\n\t}\n\treturn false // the wrapper-depth bound still stops an uncomparable cycle\n}\n\ntype governanceGuardFiles struct {\n\tFiles\n\tlease     *GovernanceWriteLease\n\troot      string\n\tprojectID string\n}\n\n// UnderlyingFiles lets another operation-scoped Files wrapper preserve the\n// explicit lease without making Files itself grow a mandatory method.\nfunc (f *governanceGuardFiles) UnderlyingFiles() Files { return f.Files }\n\nfunc (f *governanceGuardFiles) GovernanceWriteLease() *GovernanceWriteLease { return f.lease }\n\n// Preserve operation-specific durability hooks carried by a Files wrapper.\n// The guard remains the mutation boundary; the underlying hook still observes\n// the same append receipt after the journal lock has been acquired.\nfunc (f *governanceGuardFiles) syncActionJournal(file *os.File) error {\n\tif syncer, ok := f.Files.(interface{ syncActionJournal(*os.File) error }); ok {\n\t\treturn syncer.syncActionJournal(file)\n\t}\n\treturn file.Sync()\n}\n\nfunc (f *governanceGuardFiles) writable() error {\n\tif f == nil || f.lease == nil || !f.lease.Active() {\n\t\treturn ErrGovernanceWriteGuardReleased\n\t}\n\tif !f.lease.preview && !f.lease.coversBinding(f.root, f.projectID) {\n\t\treturn ErrGovernanceWriteGuardRootBinding\n\t}\n\treturn nil\n}\n\n// Writes through a retained guarded Store stop when its callback releases the\n// lease. Preview writes remain staged by PreviewFiles and never touch disk.\nfunc (f *governanceGuardFiles) WriteFile(name string, data []byte, perm os.FileMode) error {\n\tif err := f.writable(); err != nil {\n\t\treturn err\n\t}\n\treturn f.Files.WriteFile(name, data, perm)\n}\nfunc (f *governanceGuardFiles) CreateExclusive(name string, data []byte, perm os.FileMode, syncFile bool) error {\n\tif err := f.writable(); err != nil {\n\t\treturn err\n\t}\n\treturn f.Files.CreateExclusive(name, data, perm, syncFile)\n}\nfunc (f *governanceGuardFiles) Publish(name string, data []byte, perm os.FileMode, class string, expect PublishExpectation) error {\n\tif err := f.writable(); err != nil {\n\t\treturn err\n\t}\n\treturn f.Files.Publish(name, data, perm, class, expect)\n}\nfunc (f *governanceGuardFiles) MkdirAll(name string, perm os.FileMode) error {\n\tif err := f.writable(); err != nil {\n\t\treturn err\n\t}\n\treturn f.Files.MkdirAll(name, perm)\n}\nfunc (f *governanceGuardFiles) Mkdir(name string, perm os.FileMode) error {\n\tif err := f.writable(); err != nil {\n\t\treturn err\n\t}\n\treturn f.Files.Mkdir(name, perm)\n}\nfunc (f *governanceGuardFiles) Remove(name string) error {\n\tif err := f.writable(); err != nil {\n\t\treturn err\n\t}\n\treturn f.Files.Remove(name)\n}\nfunc (f *governanceGuardFiles) RemoveAll(name string) error {\n\tif err := f.writable(); err != nil {\n\t\treturn err\n\t}\n\treturn f.Files.RemoveAll(name)\n}\nfunc (f *governanceGuardFiles) Symlink(oldname, newname string) error {\n\tif err := f.writable(); err != nil {\n\t\treturn err\n\t}\n\treturn f.Files.Symlink(oldname, newname)\n}\n\nfunc (l *GovernanceWriteLease) coversBinding(root, projectID string) bool {\n\tif l == nil || !l.active.Load() {\n\t\treturn false\n\t}\n\tbinding, ok := l.byKey[governanceRootKey(root)]\n\treturn ok && binding.path == root && binding.projectID == projectID\n}\n\nfunc prepareGovernanceGuardRoots(stores []Store, operation string) ([]governanceGuardRoot, []string, bool, error) {\n\tpreviewCount := 0\n\tfor _, store := range stores {\n\t\tif store.fsys().Preview() != nil {\n\t\t\tpreviewCount++\n\t\t}\n\t}\n\tif previewCount != 0 && previewCount != len(stores) {\n\t\treturn nil, nil, false, governanceGuardError(ErrGovernanceWriteGuardMixedPreview, operation, \"\", errors.New(\"all roots must use preview Files or all roots must use native Files\"))\n\t}\n\tpreview := previewCount == len(stores)\n\n\tbyKey := make(map[string]governanceGuardRoot, len(stores))\n\tstoreKeys := make([]string, len(stores))\n\tfor i, store := range stores {\n\t\troot, err := canonicalGovernanceRoot(store.Root)\n\t\tif err != nil {\n\t\t\treturn nil, nil, false, governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, store.FederatedProjectID, err)\n\t\t}\n\t\tkey := governanceRootKey(root)\n\t\tbinding := governanceGuardRoot{path: root, key: key, projectID: store.FederatedProjectID, label: governanceRootLabel(root, store.FederatedProjectID)}\n\t\tif prior, exists := byKey[key]; exists {\n\t\t\tif prior.projectID != binding.projectID {\n\t\t\t\treturn nil, nil, false, governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, binding.label, errors.New(\"one physical root was selected with different project bindings\"))\n\t\t\t}\n\t\t} else {\n\t\t\tif err := validateGovernanceLockPaths(binding); err != nil {\n\t\t\t\treturn nil, nil, false, governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, binding.label, err)\n\t\t\t}\n\t\t\tbyKey[key] = binding\n\t\t}\n\t\tstoreKeys[i] = key\n\t}\n\tbindings := make([]governanceGuardRoot, 0, len(byKey))\n\tfor _, binding := range byKey {\n\t\tbindings = append(bindings, binding)\n\t}\n\tsort.Slice(bindings, func(i, j int) bool { return bindings[i].key < bindings[j].key })\n\treturn bindings, storeKeys, preview, nil\n}\n\nfunc canonicalGovernanceRoot(root string) (string, error) {\n\tif strings.TrimSpace(root) == \"\" {\n\t\treturn \"\", errors.New(\"root is empty\")\n\t}\n\tabs, err := filepath.Abs(root)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tphysical, err := filepath.EvalSymlinks(abs)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tphysical = filepath.Clean(physical)\n\tinfo, err := os.Stat(physical)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif !info.IsDir() {\n\t\treturn \"\", errors.New(\"root is not a directory\")\n\t}\n\treturn physical, nil\n}\n\nfunc governanceRootKey(root string) string {\n\tkey := filepath.Clean(root)\n\tif runtime.GOOS == \"windows\" {\n\t\tkey = strings.ToLower(key)\n\t}\n\treturn key\n}\n\nfunc governanceRootLabel(root, projectID string) string {\n\tif projectID != \"\" {\n\t\treturn projectID\n\t}\n\treturn filepath.Base(root)\n}\n\nfunc validateGovernanceLockPaths(root governanceGuardRoot) error {\n\tposeDir := filepath.Join(root.path, \".pose\")\n\tinfo, err := os.Lstat(poseDir)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\t// A first effectful write may be the operation that creates .pose.\n\t\t// The canonical root is already validated and the lock path below is\n\t\t// created with non-recursive mkdirs that reject a link substituted in\n\t\t// this gap.\n\t\treturn nil\n\t}\n\tif err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(NativeFiles(), root.path, poseDir) {\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\".pose directory is unavailable: %w\", err)\n\t\t}\n\t\treturn errors.New(\".pose directory is linked, not a directory, or escapes the authorized root\")\n\t}\n\ttransfersDir := filepath.Join(poseDir, \"transfers\")\n\tif info, err := os.Lstat(transfersDir); err == nil {\n\t\tif !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(NativeFiles(), root.path, transfersDir) {\n\t\t\treturn errors.New(\"transfer lock directory is linked, not a directory, or escapes the authorized root\")\n\t\t}\n\t} else if !errors.Is(err, os.ErrNotExist) {\n\t\treturn fmt.Errorf(\"transfer lock directory cannot be inspected: %w\", err)\n\t}\n\tlockPath := filepath.Join(transfersDir, \".authority-transfer.lock\")\n\tif info, err := os.Lstat(lockPath); err == nil {\n\t\tif !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(NativeFiles(), root.path, lockPath) {\n\t\t\treturn errors.New(\"authority transfer lock is linked, not a regular file, or escapes the authorized root\")\n\t\t}\n\t} else if !errors.Is(err, os.ErrNotExist) {\n\t\treturn fmt.Errorf(\"authority transfer lock cannot be inspected: %w\", err)\n\t}\n\treturn nil\n}\n\nfunc acquireGovernanceRootLocks(roots []governanceGuardRoot, operation string) (func(), error) {\n\tfiles := make([]*os.File, 0, len(roots))\n\tunlockers := make([]func(), 0, len(roots))\n\tcleanup := func() {\n\t\tfor i := len(unlockers) - 1; i >= 0; i-- {\n\t\t\tunlockers[i]()\n\t\t}\n\t\tfor i := len(files) - 1; i >= 0; i-- {\n\t\t\t_ = files[i].Close()\n\t\t}\n\t}\n\tfor _, root := range roots {\n\t\tposeDir := filepath.Join(root.path, \".pose\")\n\t\tif err := ensureGovernanceLockDirectory(root, poseDir); err != nil {\n\t\t\tcleanup()\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, root.label, err)\n\t\t}\n\t\ttransfersDir := filepath.Join(root.path, \".pose\", \"transfers\")\n\t\tif err := ensureGovernanceLockDirectory(root, transfersDir); err != nil {\n\t\t\tcleanup()\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, root.label, err)\n\t\t}\n\t\tif err := validateGovernanceLockPaths(root); err != nil {\n\t\t\tcleanup()\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, root.label, err)\n\t\t}\n\t\tpath := filepath.Join(transfersDir, \".authority-transfer.lock\")\n\t\tfile, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o644)\n\t\tif err != nil {\n\t\t\tcleanup()\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, root.label, err)\n\t\t}\n\t\tfiles = append(files, file)\n\t\topened, statErr := file.Stat()\n\t\tcurrent, lstatErr := os.Lstat(path)\n\t\tif statErr != nil || lstatErr != nil || current.Mode()&os.ModeSymlink != 0 || !current.Mode().IsRegular() || !os.SameFile(opened, current) || !artifactPathWithin(NativeFiles(), root.path, path) {\n\t\t\tcleanup()\n\t\t\tcause := errors.New(\"authority transfer lock changed or escaped during open\")\n\t\t\tif statErr != nil {\n\t\t\t\tcause = statErr\n\t\t\t} else if lstatErr != nil {\n\t\t\t\tcause = lstatErr\n\t\t\t}\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, root.label, cause)\n\t\t}\n\t\tunlock, lockErr := lockSpecTransferFile(file)\n\t\tif lockErr != nil {\n\t\t\tcleanup()\n\t\t\tif errors.Is(lockErr, errFileLockUnsupported) {\n\t\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnsupported, operation, root.label, lockErr)\n\t\t\t}\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardBusy, operation, root.label, lockErr)\n\t\t}\n\t\tunlockers = append(unlockers, unlock)\n\t}\n\treturn cleanup, nil\n}\n\nfunc ensureGovernanceLockDirectory(root governanceGuardRoot, path string) error {\n\tif info, err := os.Lstat(path); errors.Is(err, os.ErrNotExist) {\n\t\tif err := os.Mkdir(path, 0o755); err != nil && !errors.Is(err, os.ErrExist) {\n\t\t\treturn err\n\t\t}\n\t} else if err != nil {\n\t\treturn err\n\t} else if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(NativeFiles(), root.path, path) {\n\t\treturn errors.New(\"guard directory is linked, not a directory, or escapes the authorized root\")\n\t}\n\tinfo, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(NativeFiles(), root.path, path) {\n\t\treturn errors.New(\"guard directory changed to a link, non-directory, or escaped the authorized root\")\n\t}\n\treturn nil\n}\n","numLines":549,"startLine":1,"totalLines":549}},"tool_result_meta":[{"id":"toolu_01ECYh4c1ThxmF6xw3nNZU2q","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
