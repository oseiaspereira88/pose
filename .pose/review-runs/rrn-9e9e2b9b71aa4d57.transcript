\t\top.indexPins[rootID] = slot\n284\t\t}\n285\t\top.mu.Unlock()\n286\t\n287\t\tview.markUnknownIf(storeErr != nil, producer, \"authorized project root could not be opened\")\n288\t\trevisionBytes, revisionErr := op.capture(rootPath, producer, \"rev-parse\", \"--verify\", \"HEAD\")\n289\t\tentry.revision = strings.TrimSpace(string(revisionBytes))\n290\t\tif revisionErr != nil || entry.revision == \"\" {\n291\t\t\tentry.revision = \"unknown\"\n292\t\t}\n293\t\tif entry.revision == \"unknown\" {\n294\t\t\tview.markUnknown(producer, \"source revision for an authorized root is unavailable\")\n295\t\t}\n296\t\tpinned := rootStore\n297\t\tpinned.Root, pinned.FS = rootPath, view.filesFor(producer)\n298\t\tpinned = pinned.PinIndexes()\n299\t\tif pinned.indexPin != nil {\n300\t\t\t*slot = *pinned.indexPin\n301\t\t\tentry.indexPin = slot\n302\t\t\tswitch slot.Status {\n303\t\t\tcase IndexGenerationCurrent:\n304\t\t\t\tentry.indexGeneration = slot.Descriptor.GenerationID\n305\t\t\tcase IndexGenerationUnavailable:\n306\t\t\t\tentry.indexGeneration = \"unknown\"\n307\t\t\t\tview.markUnknown(producer, \"index generation could not be pinned: \"+slot.Reason)\n308\t\t\t}\n309\t\t}\n310\t\tif err := op.adoptCapturedView(view); err != nil {\n311\t\t\tview.markUnknown(producer, err.Error())\n312\t\t}\n313\t\tview.operation = op\n314\t\tclose(ready)\n315\t\treturn view\n316\t}\n317\t\n318\tfunc (op *governanceReadViewOperation) rootForPathLocked(path, project string) (string, string) {\n319\t\tif project != \"\" {\n320\t\t\tconfigured := op.initialRoots[project]\n321\t\t\tif configured != \"\" && pathWithin(configured, path) {\n322\t\t\t\treturn project, configured\n323\t\t\t}\n324\t\t}\n325\t\t// A Files wrapper may be rooted at the coordinator while a consumer passes\n326\t\t// an absolute path in another already-authorized root. Route that path by\n327\t\t// the frozen vector so all roots still share the operation budgets.\n328\t\tfor ancestor := path; ; ancestor = filepath.Dir(ances