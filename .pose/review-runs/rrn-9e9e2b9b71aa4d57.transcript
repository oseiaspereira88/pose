{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RD6W3ZgZPMGe1f33D4QR5t","type":"tool_result","content":"120\t\tcase \"capability-trigger\":\n121\t\t\treturn exists(\".pose/capabilities/assessment.md\")\n122\t\tcase \"findings\":\n123\t\t\treturn any(\".pose/reviews/*.md\") || any(\".pose/investigations/*\")\n124\t\t}\n125\t\treturn true\n126\t}\n127\t\n128\t// The producer seam also permits coverage fault injection in contract tests.\n129\tvar actionRequestObligationSource = func(s Store, project string, specs []Spec, global bool, coverage *Coverage) ([]Obligation, error) {\n130\t\treturn s.scopedActionObligations(project, specs, global, coverage)\n131\t}\n132\t\n133\tconst ObligationReportSchemaVersion = 1\n134\t\n135\t// ProjectObligations aggregates obligations read-only. It changes no file.\n136\tfunc (s Store) ProjectObligations(q ObligationQuery) (ObligationReport, error) {\n137\t\treturn s.projectObligationsAttempt(q, 0)\n138\t}\n139\t\n140\tfunc (s Store) projectObligationsAttempt(q ObligationQuery, attempt int) (ObligationReport, error) {\n141\t\tbaseStore, view := s.beginGovernanceReadView()\n142\t\ts = baseStore.withGovernanceReadView(view, \"projection\").PinIndexes()\n143\t\treport := ObligationReport{SchemaVersion: ObligationReportSchemaVersion, Query: q, Counts: map[string]int{}, Durations: map[string]float64{}, producerState: map[string]*Coverage{}}\n144\t\tfor _, producer := range obligationProducers {\n145\t\t\treport.producerState[producer] = &Coverage{Producer: producer, State: CoverageStateCurrent}\n146\t\t}\n147\t\treport.Snapshot = s.CurrentObligationSnapshot()\n148\t\tproject := report.Snapshot.Project\n149\t\tindexGeneration := \"legacy\"\n150\t\tif s.indexPin != nil {\n151\t\t\tswitch s.indexPin.Status {\n152\t\t\tcase IndexGenerationCurrent:\n153\t\t\t\tindexGeneration = s.indexPin.Descriptor.GenerationID\n154\t\t\tcase IndexGenerationUnavailable:\n155\t\t\t\tindexGeneration = \"unknown\"\n156\t\t\t\tview.markUnknown(\"projection\", \"index generation could not be pinned: \"+s.indexPin.Reason)\n157\t\t\t}\n158\t\t}\n159\t\n160\t\tspecs, err := s.obligationScopeSpecs(q.Scope)\n161\t\tif err != nil {\n162\t\t\taudit := view.audit()\n163\t\t\treadView, proof := view.metadata(project, report.Snapshot.SourceRevision, indexGeneration, audit)\n164\t\t\treadView.Scope = q.Scope\n165\t\t\treport.Snapshot.ReadView = &readView\n166\t\t\treport.Snapshot.readViewProof = proof\n167\t\t\treport.Snapshot.readViewFiles = view.base\n168\t\t\treport.Snapshot.Digest = snapshotDigest(report.Snapshot)\n169\t\t\treturn report, err\n170\t\t}\n171\t\treport.scopeSpecs = specs\n172\t\n173\t\t// Producers run side by side; each writes only its own result slot and\n174\t\t// its own coverage entry, and results are joined in a fixed order.\n175\t\ttype produced struct {\n176\t\t\titems    []Obligation\n177\t\t\terr      error\n178\t\t\tduration float64\n179\t\t}\n180\t\tassurance := map[string]ReviewAssurance{}\n181\t\tproducers := []struct {\n182\t\t\tname string\n183\t\t\tfn   func(Store) ([]Obligation, error)\n184\t\t}{\n185\t\t\t{\"readiness\", func(store Store) ([]Obligation, error) { return store.readinessObligations(project, specs) }},\n186\t\t\t{\"closeout\", func(store Store) ([]Obligation, error) {\n187\t\t\t\titems, err := store.closeoutObligations(project, specs, report.producerState, assurance)\n188\t\t\t\tif err != nil {\n189\t\t\t\t\treturn nil, err\n190\t\t\t\t}\n191\t\t\t\treached, err := store.milestoneReachedObligations(project, q.Scope, report.producerState[\"closeout\"])\n192\t\t\t\treturn append(items, reached...), err\n193\t\t\t}},\n194\t\t\t{\"start\", func(store Store) ([]Obligation, error) {\n195\t\t\t\treturn store.startObligationItems(project, specs, report.producerState[\"start\"])\n196\t\t\t}},\n197\t\t\t{\"followups\", func(store Store) ([]Obligation, error) {\n198\t\t\t\treturn store.followupObligations(project, specs, q.Scope, report.producerState[\"followups\"])\n199\t\t\t}},\n200\t\t\t{\"assessments\", func(store Store) ([]Obligation, error) { return store.assessmentObligations(project, specs), nil }},\n201\t\t\t{\"premises\", func(store Store) ([]Obligation, error) { return store.premiseObligations(project, specs) }},\n202\t\t\t{\"falsifiers\", func(store Store) ([]Obligation, error) { return store.falsifierObligations(project, specs) }},\n203\t\t\t{\"docs-review\", func(store Store) ([]Obligation, error) { return store.docsReviewObligations(project) }},\n204\t\t\t{\"capability-trigger\", func(store Store) ([]Obligation, error) { return store.capabilityTriggerObligations(project) }},\n205\t\t\t{\"release\", func(store Store) ([]Obligation, error) { return store.releaseQueueObligations(project) }},\n206\t\t\t{\"findings\", func(store Store) ([]Obligation, error) {\n207\t\t\t\treturn store.findingObligations(project, time.Now(), report.producerState[\"findings\"], q.Scope, specs)\n208\t\t\t}},\n209\t\t\t{\"action-requests\", func(store Store) ([]Obligation, error) {\n210\t\t\t\tif actionRequestObligationSource == nil {\n211\t\t\t\t\tcov := report.producerState[\"action-requests\"]\n212\t\t\t\t\tcov.State, cov.Detail = CoverageStateUnsupported, \"action requests are not available in this engine\"\n213\t\t\t\t\treturn nil, nil\n214\t\t\t\t}\n215\t\t\t\treturn actionRequestObligationSource(store, project, specs, q.Scope == \"\", report.producerState[\"action-requests\"])\n216\t\t\t}},\n217\t\t}\n218\t\tproducerStores := make([]Store, len(producers))\n219\t\tfor i, producer := range producers {\n220\t\t\tproducerStores[i] = s.withGovernanceReadView(view, producer.name).withSpecSnapshot()\n221\t\t}\n222\t\tresults := make([]produced, len(producers))\n223\t\tvar wg sync.WaitGroup\n224\t\tfor i := range producers {\n225\t\t\twg.Add(1)\n226\t\t\tgo func(i int, store Store) {\n227\t\t\t\tdefer wg.Done()\n228\t\t\t\tstarted := time.Now()\n229\t\t\t\titems, err := producers[i].fn(store)\n230\t\t\t\tresults[i] = produced{items: items, err: err, duration: time.Since(started).Seconds()}\n231\t\t\t}(i, producerStores[i])\n232\t\t}\n233\t\twg.Wait()\n234\t\tif len(assurance) > 0 {\n235\t\t\treport.ReviewAssurance = assurance\n236\t\t}\n237\t\tpendingUsed := make(map[string]bool, len(obligationProducersPending))\n238\t\tfor producer := range obligationProducersPending {\n239\t\t\tpendingUsed[producer] = pendingSourceUsed(s.fsys(), s.Root, producer)\n240\t\t}\n241\t\tfinalSnapshot := s.CurrentObligationSnapshot()\n242\t\tsnapshotChanged := snapshotDigest(finalSnapshot) != snapshotDigest(report.Snapshot)\n243\t\tif snapshotChanged {\n244\t\t\tview.markUnknown(\"projection\", \"source snapshot binding changed during the read\")\n245\t\t}\n246\t\taudit := view.audit()\n247\t\tif (len(audit.ChangedPaths) > 0 || snapshotChanged) && attempt == 0 {\n248\t\t\treturn baseStore.projectObligationsAttempt(q, 1)\n249\t\t}\n250\t\tchanged := snapshotChanged || len(audit.ChangedPaths) > 0 || len(audit.ChangedProducers) > 0\n251\t\tif changed {\n252\t\t\treport.Snapshot.Coherent = false\n253\t\t\tif snapshotChanged {\n254\t\t\t\treport.Snapshot.Limitations = append(report.Snapshot.Limitations, \"source snapshot bindings changed while obligations were projected\")\n255\t\t\t} else {\n256\t\t\t\treport.Snapshot.Limitations = append(report.Snapshot.Limitations, \"observed inputs changed while obligations were projected\")\n257\t\t\t}\n258\t\t}\n259\t\tfor producer, reasons := range audit.UnknownProducers {\n260\t\t\tdetail := \"read view could not prove this producer's input closure: \" + strings.Join(reasons, \"; \")\n261\t\t\tif producer == \"projection\" {\n262\t\t\t\tfor _, reason := range reasons {\n263\t\t\t\t\tif !governanceReadViewProjectionReasonAffectsCoverage(reason) {\n264\t\t\t\t\t\tcontinue\n265\t\t\t\t\t}\n266\t\t\t\t\tfor _, cov := range report.producerState {\n267\t\t\t\t\t\tmarkCoverageIncomplete(cov, detail)\n268\t\t\t\t\t}\n269\t\t\t\t\tbreak\n270\t\t\t\t}\n271\t\t\t\tcontinue\n272\t\t\t}\n273\t\t\tif cov := report.producerState[producer]; cov != nil {\n274\t\t\t\tmarkCoverageIncomplete(cov, detail)\n275\t\t\t}\n276\t\t}\n277\t\tfor producer := range audit.ChangedProducers {\n278\t\t\tif cov := report.producerState[producer]; cov != nil {\n279\t\t\t\tmarkCoverageIncomplete(cov, \"input closure changed during the operation and the single retry did not stabilize\")\n280\t\t\t} else {\n281\t\t\t\tfor _, cov := range report.producerState {\n282\t\t\t\t\tmarkCoverageIncomplete(cov, \"shared projection inputs changed during the operation and the single retry did not stabilize\")\n283\t\t\t\t}\n284\t\t\t}\n285\t\t}\n286\t\tif changed && len(audit.ChangedProducers) == 0 {\n287\t\t\tfor _, cov := range report.producerState {\n288\t\t\t\tmarkCoverageIncomplete(cov, \"input closure changed but could not be localized to a producer\")\n289\t\t\t}\n290\t\t}\n291\t\treadView, proof := view.metadata(project, report.Snapshot.SourceRevision, indexGeneration, audit)\n292\t\treadView.Scope = q.Scope\n293\t\treport.Snapshot.ReadView = &readView\n294\t\treport.Snapshot.readViewProof = proof\n295\t\treport.Snapshot.readViewFiles = view.base\n296\t\treport.Snapshot.Digest = snapshotDigest(report.Snapshot)\n297\t\treport.Limitations = append(report.Limitations, readView.Limitations...)\n298\t\tvar all []Obligation\n299\t\tfor i, producer := range producers {\n300\t\t\treport.Durations[producer.name] = results[i].duration\n301\t\t\tif results[i].err != nil {\n302\t\t\t\tcov := report.producerState[producer.name]\n303\t\t\t\tcov.State, cov.Detail = CoverageStateUnavailable, results[i].err.Error()\n304\t\t\t\tcontinue\n305\t\t\t}\n306\t\t\tfor _, o := range results[i].items {\n307\t\t\t\t// Where the element came from is known by the slot that produced it, not by\n308\t\t\t\t// a field the producer filled in: an element refused because that field is\n309\t\t\t\t// empty must still be a loss of its producer.\n310\t\t\t\to.producerSlot = producer.name\n311\t\t\t\tall = append(all, o)\n312\t\t\t}\n313\t\t}\n314\t\n315\t\tall = correlateObligations(all)\n316\t\tfor _, o := range all {\n317\t\t\tif err := ValidateObligation(o); err != nil {\n318\t\t\t\treport.Limitations = append(report.Limitations, \"dropped an invalid projected obligation: \"+err.Error())\n319\t\t\t\t// A dropped element is a loss of its producer: the set it returned is not the\n320\t\t\t\t// set it found, so the read is not complete and the producer says why.\n321\t\t\t\tslot := o.producerSlot\n322\t\t\t\tif slot == \"\" {\n323\t\t\t\t\tslot = o.Source.Producer\n324\t\t\t\t}\n325\t\t\t\tif cov := report.producerState[slot]; cov != nil {\n326\t\t\t\t\tmarkCoverageIncomplete(cov, \"dropped an invalid projected obligation: \"+err.Error())\n327\t\t\t\t}\n328\t\t\t\tcontinue\n329\t\t\t}\n330\t\t\tif !q.matches(o) {\n331\t\t\t\tcontinue\n332\t\t\t}\n333\t\t\treport.Obligations = append(report.Obligations, o)\n334\t\t\treport.Counts[o.Category]++\n335\t\t}\n336\t\tsort.Slice(report.Obligations, func(i, j int) bool { return report.Obligations[i].ID < report.Obligations[j].ID })\n337\t\tif report.Obligations == nil {\n338\t\t\treport.Obligations = []Obligation{}\n339\t\t}\n340\t\n341\t\treport.Complete = report.Snapshot.Coherent\n342\t\tfor _, producer := range obligationProducers {\n343\t\t\tcov := *report.producerState[producer]\n344\t\t\treport.Coverage = append(report.Coverage, cov)\n345\t\t\tif cov.State != CoverageStateCurrent {\n346\t\t\t\treport.Complete = false\n347\t\t\t}\n348\t\t}\n349\t\tpending := make([]string, 0, len(obligationProducersPending))\n350\t\tfor producer := range obligationProducersPending {\n351\t\t\tpending = append(pending, producer)\n352\t\t}\n353\t\tsort.Strings(pending)\n354\t\tfor _, producer := range pending {\n355\t\t\treport.Coverage = append(report.Coverage, ProducerCoverage{Producer: producer, State: CoverageStateUnsupported, Detail: obligationProducersPending[producer], NotUsed: !pendingUsed[producer]})\n356\t\t}\n357\t\treport.Limitations = append(report.Limitations, report.Snapshot.Limitations...)\n358\t\treturn report, nil\n359\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"afeead11-e7c0-4275-8bb6-fa9201907fb2","timestamp":"2026-11-06T19:08:08.209Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/pose-review-run-3263644701/worktree/pose-mcp/internal/pose/obligation_projection.go","content":"\tcase \"capability-trigger\":\n\t\treturn exists(\".pose/capabilities/assessment.md\")\n\tcase \"findings\":\n\t\treturn any(\".pose/reviews/*.md\") || any(\".pose/investigations/*\")\n\t}\n\treturn true\n}\n\n// The producer seam also permits coverage fault injection in contract tests.\nvar actionRequestObligationSource = func(s Store, project string, specs []Spec, global bool, coverage *Coverage) ([]Obligation, error) {\n\treturn s.scopedActionObligations(project, specs, global, coverage)\n}\n\nconst ObligationReportSchemaVersion = 1\n\n// ProjectObligations aggregates obligations read-only. It changes no file.\nfunc (s Store) ProjectObligations(q ObligationQuery) (ObligationReport, error) {\n\treturn s.projectObligationsAttempt(q, 0)\n}\n\nfunc (s Store) projectObligationsAttempt(q ObligationQuery, attempt int) (ObligationReport, error) {\n\tbaseStore, view := s.beginGovernanceReadView()\n\ts = baseStore.withGovernanceReadView(view, \"projection\").PinIndexes()\n\treport := ObligationReport{SchemaVersion: ObligationReportSchemaVersion, Query: q, Counts: map[string]int{}, Durations: map[string]float64{}, producerState: map[string]*Coverage{}}\n\tfor _, producer := range obligationProducers {\n\t\treport.producerState[producer] = &Coverage{Producer: producer, State: CoverageStateCurrent}\n\t}\n\treport.Snapshot = s.CurrentObligationSnapshot()\n\tproject := report.Snapshot.Project\n\tindexGeneration := \"legacy\"\n\tif s.indexPin != nil {\n\t\tswitch s.indexPin.Status {\n\t\tcase IndexGenerationCurrent:\n\t\t\tindexGeneration = s.indexPin.Descriptor.GenerationID\n\t\tcase IndexGenerationUnavailable:\n\t\t\tindexGeneration = \"unknown\"\n\t\t\tview.markUnknown(\"projection\", \"index generation could not be pinned: \"+s.indexPin.Reason)\n\t\t}\n\t}\n\n\tspecs, err := s.obligationScopeSpecs(q.Scope)\n\tif err != nil {\n\t\taudit := view.audit()\n\t\treadView, proof := view.metadata(project, report.Snapshot.SourceRevision, indexGeneration, audit)\n\t\treadView.Scope = q.Scope\n\t\treport.Snapshot.ReadView = &readView\n\t\treport.Snapshot.readViewProof = proof\n\t\treport.Snapshot.readViewFiles = view.base\n\t\treport.Snapshot.Digest = snapshotDigest(report.Snapshot)\n\t\treturn report, err\n\t}\n\treport.scopeSpecs = specs\n\n\t// Producers run side by side; each writes only its own result slot and\n\t// its own coverage entry, and results are joined in a fixed order.\n\ttype produced struct {\n\t\titems    []Obligation\n\t\terr      error\n\t\tduration float64\n\t}\n\tassurance := map[string]ReviewAssurance{}\n\tproducers := []struct {\n\t\tname string\n\t\tfn   func(Store) ([]Obligation, error)\n\t}{\n\t\t{\"readiness\", func(store Store) ([]Obligation, error) { return store.readinessObligations(project, specs) }},\n\t\t{\"closeout\", func(store Store) ([]Obligation, error) {\n\t\t\titems, err := store.closeoutObligations(project, specs, report.producerState, assurance)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t\treached, err := store.milestoneReachedObligations(project, q.Scope, report.producerState[\"closeout\"])\n\t\t\treturn append(items, reached...), err\n\t\t}},\n\t\t{\"start\", func(store Store) ([]Obligation, error) {\n\t\t\treturn store.startObligationItems(project, specs, report.producerState[\"start\"])\n\t\t}},\n\t\t{\"followups\", func(store Store) ([]Obligation, error) {\n\t\t\treturn store.followupObligations(project, specs, q.Scope, report.producerState[\"followups\"])\n\t\t}},\n\t\t{\"assessments\", func(store Store) ([]Obligation, error) { return store.assessmentObligations(project, specs), nil }},\n\t\t{\"premises\", func(store Store) ([]Obligation, error) { return store.premiseObligations(project, specs) }},\n\t\t{\"falsifiers\", func(store Store) ([]Obligation, error) { return store.falsifierObligations(project, specs) }},\n\t\t{\"docs-review\", func(store Store) ([]Obligation, error) { return store.docsReviewObligations(project) }},\n\t\t{\"capability-trigger\", func(store Store) ([]Obligation, error) { return store.capabilityTriggerObligations(project) }},\n\t\t{\"release\", func(store Store) ([]Obligation, error) { return store.releaseQueueObligations(project) }},\n\t\t{\"findings\", func(store Store) ([]Obligation, error) {\n\t\t\treturn store.findingObligations(project, time.Now(), report.producerState[\"findings\"], q.Scope, specs)\n\t\t}},\n\t\t{\"action-requests\", func(store Store) ([]Obligation, error) {\n\t\t\tif actionRequestObligationSource == nil {\n\t\t\t\tcov := report.producerState[\"action-requests\"]\n\t\t\t\tcov.State, cov.Detail = CoverageStateUnsupported, \"action requests are not available in this engine\"\n\t\t\t\treturn nil, nil\n\t\t\t}\n\t\t\treturn actionRequestObligationSource(store, project, specs, q.Scope == \"\", report.producerState[\"action-requests\"])\n\t\t}},\n\t}\n\tproducerStores := make([]Store, len(producers))\n\tfor i, producer := range producers {\n\t\tproducerStores[i] = s.withGovernanceReadView(view, producer.name).withSpecSnapshot()\n\t}\n\tresults := make([]produced, len(producers))\n\tvar wg sync.WaitGroup\n\tfor i := range producers {\n\t\twg.Add(1)\n\t\tgo func(i int, store Store) {\n\t\t\tdefer wg.Done()\n\t\t\tstarted := time.Now()\n\t\t\titems, err := producers[i].fn(store)\n\t\t\tresults[i] = produced{items: items, err: err, duration: time.Since(started).Seconds()}\n\t\t}(i, producerStores[i])\n\t}\n\twg.Wait()\n\tif len(assurance) > 0 {\n\t\treport.ReviewAssurance = assurance\n\t}\n\tpendingUsed := make(map[string]bool, len(obligationProducersPending))\n\tfor producer := range obligationProducersPending {\n\t\tpendingUsed[producer] = pendingSourceUsed(s.fsys(), s.Root, producer)\n\t}\n\tfinalSnapshot := s.CurrentObligationSnapshot()\n\tsnapshotChanged := snapshotDigest(finalSnapshot) != snapshotDigest(report.Snapshot)\n\tif snapshotChanged {\n\t\tview.markUnknown(\"projection\", \"source snapshot binding changed during the read\")\n\t}\n\taudit := view.audit()\n\tif (len(audit.ChangedPaths) > 0 || snapshotChanged) && attempt == 0 {\n\t\treturn baseStore.projectObligationsAttempt(q, 1)\n\t}\n\tchanged := snapshotChanged || len(audit.ChangedPaths) > 0 || len(audit.ChangedProducers) > 0\n\tif changed {\n\t\treport.Snapshot.Coherent = false\n\t\tif snapshotChanged {\n\t\t\treport.Snapshot.Limitations = append(report.Snapshot.Limitations, \"source snapshot bindings changed while obligations were projected\")\n\t\t} else {\n\t\t\treport.Snapshot.Limitations = append(report.Snapshot.Limitations, \"observed inputs changed while obligations were projected\")\n\t\t}\n\t}\n\tfor producer, reasons := range audit.UnknownProducers {\n\t\tdetail := \"read view could not prove this producer's input closure: \" + strings.Join(reasons, \"; \")\n\t\tif producer == \"projection\" {\n\t\t\tfor _, reason := range reasons {\n\t\t\t\tif !governanceReadViewProjectionReasonAffectsCoverage(reason) {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tfor _, cov := range report.producerState {\n\t\t\t\t\tmarkCoverageIncomplete(cov, detail)\n\t\t\t\t}\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif cov := report.producerState[producer]; cov != nil {\n\t\t\tmarkCoverageIncomplete(cov, detail)\n\t\t}\n\t}\n\tfor producer := range audit.ChangedProducers {\n\t\tif cov := report.producerState[producer]; cov != nil {\n\t\t\tmarkCoverageIncomplete(cov, \"input closure changed during the operation and the single retry did not stabilize\")\n\t\t} else {\n\t\t\tfor _, cov := range report.producerState {\n\t\t\t\tmarkCoverageIncomplete(cov, \"shared projection inputs changed during the operation and the single retry did not stabilize\")\n\t\t\t}\n\t\t}\n\t}\n\tif changed && len(audit.ChangedProducers) == 0 {\n\t\tfor _, cov := range report.producerState {\n\t\t\tmarkCoverageIncomplete(cov, \"input closure changed but could not be localized to a producer\")\n\t\t}\n\t}\n\treadView, proof := view.metadata(project, report.Snapshot.SourceRevision, indexGeneration, audit)\n\treadView.Scope = q.Scope\n\treport.Snapshot.ReadView = &readView\n\treport.Snapshot.readViewProof = proof\n\treport.Snapshot.readViewFiles = view.base\n\treport.Snapshot.Digest = snapshotDigest(report.Snapshot)\n\treport.Limitations = append(report.Limitations, readView.Limitations...)\n\tvar all []Obligation\n\tfor i, producer := range producers {\n\t\treport.Durations[producer.name] = results[i].duration\n\t\tif results[i].err != nil {\n\t\t\tcov := report.producerState[producer.name]\n\t\t\tcov.State, cov.Detail = CoverageStateUnavailable, results[i].err.Error()\n\t\t\tcontinue\n\t\t}\n\t\tfor _, o := range results[i].items {\n\t\t\t// Where the element came from is known by the slot that produced it, not by\n\t\t\t// a field the producer filled in: an element refused because that field is\n\t\t\t// empty must still be a loss of its producer.\n\t\t\to.producerSlot = producer.name\n\t\t\tall = append(all, o)\n\t\t}\n\t}\n\n\tall = correlateObligations(all)\n\tfor _, o := range all {\n\t\tif err := ValidateObligation(o); err != nil {\n\t\t\treport.Limitations = append(report.Limitations, \"dropped an invalid projected obligation: \"+err.Error())\n\t\t\t// A dropped element is a loss of its producer: the set it returned is not the\n\t\t\t// set it found, so the read is not complete and the producer says why.\n\t\t\tslot := o.producerSlot\n\t\t\tif slot == \"\" {\n\t\t\t\tslot = o.Source.Producer\n\t\t\t}\n\t\t\tif cov := report.producerState[slot]; cov != nil {\n\t\t\t\tmarkCoverageIncomplete(cov, \"dropped an invalid projected obligation: \"+err.Error())\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif !q.matches(o) {\n\t\t\tcontinue\n\t\t}\n\t\treport.Obligations = append(report.Obligations, o)\n\t\treport.Counts[o.Category]++\n\t}\n\tsort.Slice(report.Obligations, func(i, j int) bool { return report.Obligations[i].ID < report.Obligations[j].ID })\n\tif report.Obligations == nil {\n\t\treport.Obligations = []Obligation{}\n\t}\n\n\treport.Complete = report.Snapshot.Coherent\n\tfor _, producer := range obligationProducers {\n\t\tcov := *report.producerState[producer]\n\t\treport.Coverage = append(report.Coverage, cov)\n\t\tif cov.State != CoverageStateCurrent {\n\t\t\treport.Complete = false\n\t\t}\n\t}\n\tpending := make([]string, 0, len(obligationProducersPending))\n\tfor producer := range obligationProducersPending {\n\t\tpending = append(pending, producer)\n\t}\n\tsort.Strings(pending)\n\tfor _, producer := range pending {\n\t\treport.Coverage = append(report.Coverage, ProducerCoverage{Producer: producer, State: CoverageStateUnsupported, Detail: obligationProducersPending[producer], NotUsed: !pendingUsed[producer]})\n\t}\n\treport.Limitations = append(report.Limitations, report.Snapshot.Limitations...)\n\treturn report, nil\n}","numLines":240,"startLine":120,"totalLines":1127}},"tool_result_meta":[{"id":"toolu_01RD6W3ZgZPMGe1f33D4QR5t","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
