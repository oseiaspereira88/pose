re(path, item.producers, \"final read-view audit exceeded its record or metadata budget\")\n2117\t\t\t\tcontinue\n2118\t\t\t}\n2119\t\t\tvar raw []byte\n2120\t\t\tvar err error\n2121\t\t\tvar witness fs.FileInfo\n2122\t\t\tif item.source == \"open\" || item.source == \"readfile\" {\n2123\t\t\t\tif item.errText != \"\" && len(item.bytes) == 0 {\n2124\t\t\t\t\terr = reobserveGovernanceFileFailure(v.base, item.baseName, item.rootReal, item.resolved)\n2125\t\t\t\t} else {\n2126\t\t\t\t\tif !budget.reserveInput(item.readLimit) {\n2127\t\t\t\t\t\tmarkBudgetFailure(path, item.producers, \"final read-view audit exceeded its input byte budget\")\n2128\t\t\t\t\t\tcontinue\n2129\t\t\t\t\t}\n2130\t\t\t\t\traw, _, witness, err = readGovernanceFileLimited(v.base, item.baseName, item.readLimit, item.rootReal, item.resolved)\n2131\t\t\t\t}\n2132\t\t\t}\n2133\t\t\tif errorText(err) != item.errText || !bytes.Equal(raw, item.bytes) || item.witness != nil && !sameObservedFile(item.witness, witness) {\n2134\t\t\t\tfor producer := range item.producers {\n2135\t\t\t\t\tresult.ChangedProducers[producer] = true\n2136\t\t\t\t}\n2137\t\t\t\tresult.ChangedPaths = append(result.ChangedPaths, v.displayPath(path))\n2138\t\t\t}\n2139\t\t}\n2140\t\tfor _, item := range observations {\n2141\t\t\tmetadataCost := int64(len(item.method) + len(v.displayPath(item.path)) + len(item.errText) + len(item.value) + 128)\n2142\t\t\tif !budget.reserve(metadataCost) {\n2143\t\t\t\tmarkBudgetFailure(item.path, item.producers, \"final read-view audit exceeded its record or metadata budget\")\n2144\t\t\t\tcontinue\n2145\t\t\t}\n2146\t\t\tchanged := false\n2147\t\t\tswitch item.method {\n2148\t\t\tcase \"stat\":\n2149\t\t\t\tinfo, err := v.base.Stat(item.baseName)\n2150\t\t\t\tchanged = errorText(err) != item.errText || err == nil && !sameObservedFile(item.witness, info)\n2151\t\t\tcase \"lstat\":\n2152\t\t\t\tinfo, err := v.base.Lstat(item.baseName)\n2153\t\t\t\tchanged = errorText(err) != item.errText || err == nil && !sameObservedFile(item.witness, info)\n2154\t\t\tcase \"directory\":\n2155\t\t\t\tentries, err := auditDirectory(item.baseName)\n2156\t\t\t\tif errors.Is(err, errGovernanceReadViewBudget) {\n2157\t\t\t\t\tmarkBudgetFailure(item.path, item.producers, \"final directory audit exceeded its bounded record or metadata budget\")\n2158\t\t\t\t\tcontinue\n2159\t\t\t\t}\n2160\t\t\t\tchanged = errorText(err) != item.errText || err == nil && strings.Join(item.entries, \"\\x00\") != strings.Join(dirEntryIdentities(entries), \"\\x00\")\n2161\t\t\tcase \"direntry-info\":\n2162\t\t\t\tentries, err := auditDirectory(item.baseName)\n2163\t\t\t\tif errors.Is(err, errGovernanceReadViewBudget) {\n2164\t\t\t\t\tmarkBudgetFailure(item.path, item.producers, \"final directory audit exceeded its bounded record or metadata budget\")\n2165\t\t\t\t\tcontinue\n2166\t\t\t\t}\n2167\t\t\t\tif errorText(err) == item.errText && err == nil {\n2168\t\t\t\t\tfound := false\n2169\t\t\t\t\tfor _, entry := range entries {\n2170\t\t\t\t\t\tif entry.Name() == filepath.Base(item.path) {\n2171\t\t\t\t\t\t\tfound = true\n2172\t\t\t\t\t\t\tinfo, infoErr := entry.Info()\n2173\t\t\t\t\t\t\tchanged = errorText(infoErr) != item.errText || infoErr == nil && !sameObservedFile(item.witness, info)\n2174\t\t\t\t\t\t\tbreak\n2175\t\t\t\t\t\t}\n2176\t\t\t\t\t}\n2177\t\t\t\t\tchanged = changed || !found\n2178\t\t\t\t} else {\n2179\t\t\t\t\tchanged = errorText(err) != item.errText\n2180\t\t\t\t}\n2181\t\t\tcase \"readlink\":\n2182\t\t\t\tvalue, err := v.base.Readlink(item.baseName)\n2183\t\t\t\tchanged = errorText(err) != item.errText || err == nil && value != item.value\n2184\t\t\tcase \"eval-symlinks\":\n2185\t\t\t\tvalue, err := v.base.EvalSymlinks(item.baseName)\n2186\t\t\t\tchanged = errorText(err) != item.errText || err == nil && filepath.Clean(value) != filepath.Clean(item.value)\n2187\t\t\tcase \"eval-parent-symlinks\":\n2188\t\t\t\tvalue, err := v.base.EvalSymlinks(item.baseName)\n2189\t\t\t\tchanged = errorText