{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ly9hXSSYJecDybpoN4vyAv","type":"tool_result","content":"962\t// ObligationSnapshotChanges compares an advisory snapshot with the current\n963\t// repository state. A missing private read-view proof cannot certify current\n964\t// inputs, and an empty result is not authorization to write. Effectful callers\n965\t// must recompute under their governance write guard.\n966\tfunc (s Store) ObligationSnapshotChanges(snap ObligationSnapshot) []string {\n967\t\tnow := s.CurrentObligationSnapshot()\n968\t\tcurrentFiles := s.withoutGovernanceReadView().fsys()\n969\t\tvar changed []string\n970\t\t// A state that could not be read is not a state that did not change.\n971\t\t// A baseline that was not read whole is not one to compare with: a later, coherent read is\n972\t\t// a different answer, not a confirmation.\n973\t\tif !snap.Coherent {\n974\t\t\tchanged = append(changed, \"baseline\")\n975\t\t}\n976\t\tif !now.Coherent {\n977\t\t\tchanged = append(changed, \"coherence\")\n978\t\t}\n979\t\n980\t\tif now.Project != snap.Project {\n981\t\t\tchanged = append(changed, \"project\")\n982\t\t}\n983\t\tif now.SourceRevision != snap.SourceRevision {\n984\t\t\tchanged = append(changed, \"source-revision\")\n985\t\t}\n986\t\tif now.PolicyDigest != snap.PolicyDigest || now.PolicyDigest == directoryUnavailable {\n987\t\t\tchanged = append(changed, \"policy\")\n988\t\t}\n989\t\tif now.ContractDigest != snap.ContractDigest {\n990\t\t\tchanged = append(changed, \"authority-contract\")\n991\t\t}\n992\t\tif now.AuthorityContextRevision != snap.AuthorityContextRevision {\n993\t\t\tchanged = append(changed, \"authority-context\")\n994\t\t}\n995\t\tif now.IndexDigest != snap.IndexDigest {\n996\t\t\tchanged = append(changed, \"delivery-index\")\n997\t\t}\n998\t\t// A clean tree that became dirty (or the reverse) is a change of what the answer describes.\n999\t\tif now.WorktreeDirty != snap.WorktreeDirty {\n1000\t\t\tchanged = append(changed, \"worktree\")\n1001\t\t}\n1002\t\tif snap.ReadView != nil && (snap.ReadView.Freshness != ReadViewFreshnessCurrent || snap.readViewProof == nil || snap.readViewFiles == nil) {\n1003\t\t\tchanged = append(changed, \"read-view-unverified\")\n1004\t\t} else if snap.ReadView != nil {\n1005\t\t\tfor _, path := range snap.readViewProof.changes(currentFiles) {\n1006\t\t\t\tchanged = append(changed, \"read-view:\"+path)\n1007\t\t\t}\n1008\t\t}\n1009\t\treturn changed\n1010\t}\n1011\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"57313d85-def6-4e4b-a942-a41a7758730e","timestamp":"2026-11-06T19:09:59.983Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/pose-review-run-3263644701/worktree/pose-mcp/internal/pose/obligation_projection.go","content":"// ObligationSnapshotChanges compares an advisory snapshot with the current\n// repository state. A missing private read-view proof cannot certify current\n// inputs, and an empty result is not authorization to write. Effectful callers\n// must recompute under their governance write guard.\nfunc (s Store) ObligationSnapshotChanges(snap ObligationSnapshot) []string {\n\tnow := s.CurrentObligationSnapshot()\n\tcurrentFiles := s.withoutGovernanceReadView().fsys()\n\tvar changed []string\n\t// A state that could not be read is not a state that did not change.\n\t// A baseline that was not read whole is not one to compare with: a later, coherent read is\n\t// a different answer, not a confirmation.\n\tif !snap.Coherent {\n\t\tchanged = append(changed, \"baseline\")\n\t}\n\tif !now.Coherent {\n\t\tchanged = append(changed, \"coherence\")\n\t}\n\n\tif now.Project != snap.Project {\n\t\tchanged = append(changed, \"project\")\n\t}\n\tif now.SourceRevision != snap.SourceRevision {\n\t\tchanged = append(changed, \"source-revision\")\n\t}\n\tif now.PolicyDigest != snap.PolicyDigest || now.PolicyDigest == directoryUnavailable {\n\t\tchanged = append(changed, \"policy\")\n\t}\n\tif now.ContractDigest != snap.ContractDigest {\n\t\tchanged = append(changed, \"authority-contract\")\n\t}\n\tif now.AuthorityContextRevision != snap.AuthorityContextRevision {\n\t\tchanged = append(changed, \"authority-context\")\n\t}\n\tif now.IndexDigest != snap.IndexDigest {\n\t\tchanged = append(changed, \"delivery-index\")\n\t}\n\t// A clean tree that became dirty (or the reverse) is a change of what the answer describes.\n\tif now.WorktreeDirty != snap.WorktreeDirty {\n\t\tchanged = append(changed, \"worktree\")\n\t}\n\tif snap.ReadView != nil && (snap.ReadView.Freshness != ReadViewFreshnessCurrent || snap.readViewProof == nil || snap.readViewFiles == nil) {\n\t\tchanged = append(changed, \"read-view-unverified\")\n\t} else if snap.ReadView != nil {\n\t\tfor _, path := range snap.readViewProof.changes(currentFiles) {\n\t\t\tchanged = append(changed, \"read-view:\"+path)\n\t\t}\n\t}\n\treturn changed\n}\n","numLines":50,"startLine":962,"totalLines":1127}},"tool_result_meta":[{"id":"toolu_01Ly9hXSSYJecDybpoN4vyAv","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
