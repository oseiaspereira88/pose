shares.\nfunc incompleteTransferIn(files Files, root string, identity ArtifactRef, listing transferListing) (string, bool) {\n\tif listing.code != \"\" {\n\t\treturn listing.code, true\n\t}\n\tfor _, entry := range listing.entries {\n\t\tplan, err := entry.plan, entry.err\n\t\tif err != nil || plan.OperationID != entry.name {\n\t\t\treturn \"transfer-state-invalid\", true\n\t\t}\n\t\timpacted := false\n\t\tfor _, impact := range plan.ImpactedReferences {\n\t\t\tif impact.ProjectID == identity.Project && impact.Owner == identity {\n\t\t\t\timpacted = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif plan.Source != identity && plan.Destination != identity && !impacted {\n\t\t\tcontinue\n\t\t}\n\t\tstatus, err := ReadSpecTransferStatusIn(files, Store{Root: root, FS: files}, entry.name, identity.Project)\n\t\tif err == nil && status.Phase != \"activated\" {\n\t\t\treturn entry.name, true\n\t\t}\n\t\tif err != nil {\n\t\t\treturn \"transfer-state-invalid\", true\n\t\t}\n\t}\n\treturn \"\", false\n}\n\nfunc readSpecTransferRedirect(files Files, store Store, identity ArtifactRef) (specTransferRedirect, bool, error) {\n\tif !filepath.IsLocal(identity.Slug) {\n\t\treturn specTransferRedirect{}, false, specTransferError(\"invalid-spec-redirect\")\n\t}","numLines":35,"startLine":1215,"totalLines":2257}},"tool_result_meta":[{"id":"toolu_01VxnSLXLopKMa917YMPaHN7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
