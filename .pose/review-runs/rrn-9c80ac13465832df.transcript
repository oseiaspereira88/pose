le operation.\n+\t\ts.specs.transfersOnce.Do(func() { s.specs.transfers = listTransfers(r.fsys(), s.Root) })\n+\t\toperationID, pending = incompleteTransferIn(r.fsys(), s.Root, ref, s.specs.transfers)\n+\t} else {\n+\t\toperationID, pending = incompleteTransferFor(r.fsys(), s.Root, ref)\n+\t}\n+\tif pending {\n \t\tout.State = \"transfer-in-progress\"\n \t\tout.OperationID = operationID\n \t\treturn out\ndiff --git a/pose-mcp/internal/pose/federated_acceptance.go b/pose-mcp/internal/pose/federated_acceptance.go\nindex 5e4e4731..93ff8452 100644\n--- a/pose-mcp/internal/pose/federated_acceptance.go\n+++ b/pose-mcp/internal/pose/federated_acceptance.go\n@@ -431,6 +431,7 @@ func (s Store) federatedAcceptance(projectID string, coordinator ArtifactRef, ed\n \t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n \t\t\tcontinue\n \t\t}\n+\t\tsource = resolver.withSpecSnapshot(identity.Project, source)\n \t\tprojectRoots[identity.Project] = source\n \t\tsource.FederatedProjectID = identity.Project\n \t\tsource.FederatedResolver = &resolver\ndiff --git a/pose-mcp/internal/pose/spec.go b/pose-mcp/internal/pose/spec.go\nindex 7afb348d..bd17f7a4 100644\n--- a/pose-mcp/internal/pose/spec.go\n+++ b/pose-mcp/internal/pose/spec.go\n@@ -83,6 +83,10 @@ type specSnapshot struct {\n \t// read once per operation; ListReviewBundles otherwise decodes every\n \t// bundle for every scoped call.\n \tbundleScopes sync.Map\n+\t// transfers is the listing of the project's transfer plans, read once per operation\n+\t// (spec pose-index-input-binding-reads-each-transfer-once).\n+\ttransfersOnce sync.Once\n+\ttransfers     transferListing\n }\n \n // bundleScope returns the scope ref of the bundle file name in dir, reading\ndiff --git a/pose-mcp/internal/pose/spec_transfer.go b/pose-mcp/internal/pose/spec_transfer.go\nindex dbcf6c8f..09ae1fe4 100644\n--- a/pose-mcp/internal/pose/spec_transfer.go\n+++ b/pose-mcp/internal/pose/spec_transfer.go\n@@ -1164,28 +1164,62 @@ func transferPlanFile(root, operationID string) string {\n \treturn filepath.Join(transferOperationDir(root, operationID), \"plan.json\")\n }\n \n-func incompleteTransferFor(files Files, root string, identity ArtifactRef) (string, bool) {\n+// transferListing is what one read of a project's transfer directory found: either a state\n+// that holds for every identity (code), or the plans of its operations in directory order. A\n+// plan that did not read stays in its place with its error, so the order in which a bad entry\n+// is met is the order of a fresh read.\n+type transferListing struct {\n+\tcode    string\n+\tentries []transferListingEntry\n+}\n+\n+type transferListingEntry struct {\n+\tname string\n+\tplan SpecTransferPlan\n+\terr  error\n+}\n+\n+func listTransfers(files Files, root string) transferListing {\n \ttransfersDir := filepath.Join(root, \".pose\", \"transfers\")\n \tinfo, err := files.Lstat(transfersDir)\n \tif os.IsNotExist(err) {\n-\t\treturn \"\", false\n+\t\treturn transferListing{}\n \t}\n \tif err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !artifactPathWithin(files, root, transfersDir) {\n-\t\treturn \"transfer-state-invalid\", true\n+\t\treturn transferListing{code: \"transfer-state-invalid\"}\n \t}\n \tentries, err := files.ReadDir(transfersDir)\n \tif err != nil {\n-\t\treturn \"transfer-state-unavailable\", true\n+\t\treturn transferListing{code: \"transfer-state-unavailable\"}\n \t}\n \tif len(entries) > maxSpecTransferOperationsRead {\n-\t\treturn \"transfer-state-invalid\", true\n+\t\treturn transferListing{code: \"transfer-state-invalid\"}\n \t}\n+\tvar listing transferListing\n \tfor _, entry := range entries {\n \t\tif !entry.IsDir() || !specTransferIDRE.MatchString(entry.Name()) {\n \t\t\tcontinue\n \t\t}\n \t\tplan, err := readSpecTransferPlan(files, transferPlanFile(root, entry.Name()))\n-\t\tif err != nil || plan.OperationID != entry.Name() {\n+\t\tlisting.entries = append(listing.entries, transferListingEntry{name: entry.Name(), plan: plan, err: err})\n+\t}\n+\treturn listing\n+}\n+\n+// incompleteTransferFor reads the transfer directory for one identity.\n+func incompleteTransferFor(files Files, root string, identity ArtifactRef) (string, bool) {\n+\treturn incompleteTransferIn(files, root, identity, listTransfers(files, root))\n+}\n+\n+// incompleteTransferIn answers for one identity from a listing, which an operation reads once\n+// and every resolution of the operation then shares.\n+func incompleteTransferIn(files Files, root string, identity ArtifactRef, listing transferListing) (string, bool) {\n+\tif listing.code != \"\" {\n+\t\treturn listing.code, true\n+\t}\n+\tfor _, entry := range listing.entries {\n+\t\tplan, err := entry.plan, entry.err\n+\t\tif err != nil || plan.OperationID != entry.name {\n \t\t\treturn \"transfer-state-invalid\", true\n \t\t}\n \t\timpacted := false\n@@ -1198,9 +1232,9 @@ func incompleteTransferFor(files Files, root string, identity ArtifactRef) (stri\n \t\tif plan.Source != identity && plan.Destination != identity && !impacted {\n \t\t\tcontinue\n \t\t}\n-\t\tstatus, err := ReadSpecTransferStatusIn(files, Store{Root: root, FS: files}, entry.Name(), identity.Project)\n+\t\tstatus, err := ReadSpecTransferStatusIn(files, Store{Root: root, FS: files}, entry.name, identity.Project)\n \t\tif err == nil && status.Phase != \"activated\" {\n-\t\t\treturn entry.Name(), true\n+\t\t\treturn entry.name, true\n \t\t}\n \t\tif err != nil {\n \t\t\treturn \"transfer-state-invalid\", true\ndiff --git a/pose-mcp/internal/pose/transfer_listing_once_test.go b/pose-mcp/internal/pose/transfer_listing_once_test.go\nnew file mode 100644\nindex 00000000..f9714e00\n--- /dev/null\n+++ b/pose-mcp/internal/pose/transfer_listing_once_test.go\n@@ -0,0 +1,66 @@\n+package pose\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"sync/atomic\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-index-input-binding-reads-each-transfer-once.\n+\n+type countingPlanFiles struct {\n+\tFiles\n+\tplans *atomic.Int64\n+}\n+\n+func (c countingPlanFiles) ReadFile(name string) ([]byte, error) {\n+\tif strings.HasSuffix(name, \"plan.json\") {\n+\t\tc.plans.Add(1)\n+\t}\n+\treturn c.Files.ReadFile(name)\n+}\n+\n+// R1: one operation reads the transfer plans of a project once, however many artifacts it\n+// resolves; without the operation's snapshots every resolution reads them again.\n+func TestAnOperationReadsTheTransferPlansOfAProjectOnce(t *testing.T) {\n+\troot := t.TempDir()\n+\tfor i := 0; i < 4; i++ {\n+\t\tqualifiedFile(t, root, \"specs/n\"+string(rune('a'+i))+\".md\", \"---\\nslug: n\"+string(rune('a'+i))+\"\\nstatus: done\\n---\\n\")\n+\t}\n+\tfor _, id := range []string{\"stf-000000000000000000000001\", \"stf-000000000000000000000002\", \"stf-000000000000000000000003\"} {\n+\t\tdir := filepath.Join(root, \".pose\", \"transfers\", id)\n+\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif err := os.WriteFile(filepath.Join(dir, \"plan.json\"), []byte(\"{}\"), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\trefs := []string{\"xref:p/spec:na\", \"xref:p/spec:nb\", \"xref:p/spec:nc\", \"xref:p/spec:nd\", \"xref:p/spec:na\"}\n+\tcount := func(snapshots bool) (int64, []string) {\n+\t\tvar plans atomic.Int64\n+\t\tr := ArtifactResolver{Roots: NewRoots(RootsConfig{Explicit: map[string]string{\"p\": root}}), FS: countingPlanFiles{Files: NativeFiles(), plans: &plans}}\n+\t\tif snapshots {\n+\t\t\tr = r.WithSpecSnapshots()\n+\t\t}\n+\t\tvar states []string\n+\t\tfor _, ref := range refs {\n+\t\t\tstates = append(states, r.Resolve(\"p\", ref).State)\n+\t\t}\n+\t\treturn plans.Load(), states\n+\t}\n+\tonce, withSnapshots := count(true)\n+\tmany, without := count(false)\n+\tif once != 3 {\n+\t\tt.Fatalf(\"one operation read %d plan files for 3 plans and %d resolutions, want 3\", once, len(refs))\n+\t}\n+\tif many != 3*int64(len(refs)) && many <= once {\n+\t\tt.Fatalf(\"without snapshots %d reads: the comparison does not show the saving\", many)\n+\t}\n+\t// What a resolution answers does not depend on whether the listing was shared.\n+\tif strings.Join(withSnapshots, \",\") != strings.Join(without, \",\") {\n+\t\tt.Fatalf(\"the answers differ: %v vs %v\", withSnapshots, without)\n+\t}\n+}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WcAQ5AALGe1MN566ek3sHR","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
