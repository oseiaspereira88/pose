{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019xYSARDT8LbMYkj7AMxTqb","type":"tool_result","content":"460\t\t}\n461\t}\n462\t\n463\t// readinessObligations projects unmet prerequisites. They restrict start and\n464\t// execution of the whole spec: depends_on is a spec-level precondition.\n465\tfunc (s Store) readinessObligations(project string, specs []Spec) ([]Obligation, error) {\n466\t\tvar resolver ArtifactResolver\n467\t\tif s.FederatedResolver != nil {\n468\t\t\tresolver = *s.FederatedResolver\n469\t\t} else {\n470\t\t\tvar err error\n471\t\t\tresolver, _, err = EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n472\t\t\tif err != nil {\n473\t\t\t\treturn nil, err\n474\t\t\t}\n475\t\t}\n476\t\tresolver = resolver.WithSpecSnapshots()\n477\t\treturn forEachSpec(specs, func(sp Spec) ([]Obligation, error) {\n478\t\t\tif terminalStatuses[sp.Status] {\n479\t\t\t\treturn nil, nil\n480\t\t\t}\n481\t\t\tvar out []Obligation\n482\t\t\treadiness, err := s.SpecReadinessWithResolver(sp.Slug, project, resolver)\n483\t\t\tif err != nil {\n484\t\t\t\treturn nil, err\n485\t\t\t}\n486\t\t\tsource := specNode(project, sp.Slug)\n487\t\t\tfor _, waiting := range readiness.WaitingOn {\n488\t\t\t\to := newObligation(project, \"readiness\", source, \"depends_on\", waiting.Ref)\n489\t\t\t\to.Category = ObligationDependency"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"8898763d-60ba-4e30-910b-0c8f383ff522","timestamp":"2026-11-10T05:02:27.807Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3962742447/worktree/pose-mcp/internal/pose/obligation_projection.go","content":"\t}\n}\n\n// readinessObligations projects unmet prerequisites. They restrict start and\n// execution of the whole spec: depends_on is a spec-level precondition.\nfunc (s Store) readinessObligations(project string, specs []Spec) ([]Obligation, error) {\n\tvar resolver ArtifactResolver\n\tif s.FederatedResolver != nil {\n