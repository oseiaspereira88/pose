{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"Both listing routes now use the 64 MiB limit and two-minute deadline. I’m checking how the governed route preserves that deadline during read-view audit, along with cleanup ownership and failure behavior. I’ll use the sealed test results because this sandbox cannot run builds or write test fixtures.\n"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '260,455p' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '600,710p' pose-mcp/internal/pose/governance_read_view_git.go; rg -n 'obs.ctx|obs.deadline|hasDeadline|WithoutCancel|observation.ctx' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '445,625p' pose-mcp/internal/pose/review_adapter_containment.go; sed -n '1,160p' pose-mcp/internal/pose/git_snapshot_integrity.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '260,455p' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '600,710p' pose-mcp/internal/pose/governance_read_view_git.go; rg -n 'obs.ctx|obs.deadline|hasDeadline|WithoutCancel|observation.ctx' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '445,625p' pose-mcp/internal/pose/review_adapter_containment.go; sed -n '1,160p' pose-mcp/internal/pose/git_snapshot_integrity.go\"","aggregated_output":"\t\tfiles = underlying.UnderlyingFiles()\n\t}\n\treturn nil, nil\n}\n\n// capture is also used while an authorized child root is being opened, before\n// a producer Files wrapper for that root exists. Root membership is checked\n// against the operation's already-bound roots.\nfunc (op *governanceReadViewOperation) capture(root, producer string, args ...string) ([]byte, error) {\n\treturn op.captureFiles(NativeFiles(), root, producer, args...)\n}\n\nfunc (op *governanceReadViewOperation) captureFiles(files Files, root, producer string, args ...string) ([]byte, error) {\n\treturn op.captureFilesBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n}\n\nfunc (op *governanceReadViewOperation) captureFilesBounded(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn op.captureFilesBoundedContext(files, context.Background(), root, producer, maxOutputBytes, args...)\n}\n\nfunc (op *governanceReadViewOperation) captureFilesBoundedContext(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif op == nil {\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tabsolute, target, state, err := op.gitRoot(root, producer)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif err := target.begin(); err != nil {\n\t\treturn nil, err\n\t}\n\tdefer target.end()\n\treturn state.capture(files, ctx, absolute, producer, maxOutputBytes, args...)\n}\n\n// gitRoot resolves a Git command's root against the operation's authorized\n// roots and returns the view that owns it and the operation's Git state.\nfunc (op *governanceReadViewOperation) gitRoot(root, producer string) (string, *governanceReadView, *governanceReadViewGitState, error) {\n\tabsolute, err := filepath.Abs(root)\n\tif err != nil {\n\t\top.primary.markUnknown(producer, \"Git root identity could not be resolved\")\n\t\treturn \"\", nil, nil, err\n\t}\n\tabsolute = filepath.Clean(absolute)\n\top.mu.Lock()\n\tauthorized := false\n\tvar target *governanceReadView\n\tfor _, entry := range op.roots {\n\t\tif sameLexicalRoot(entry.root, absolute) {\n\t\t\tauthorized = true\n\t\t\ttarget = entry.view\n\t\t\tbreak\n\t\t}\n\t}\n\tstate := op.git\n\tif state == nil {\n\t\tstate = newGovernanceReadViewGitState(op)\n\t\top.git = state\n\t}\n\top.mu.Unlock()\n\tif !authorized {\n\t\top.primary.markUnknown(producer, \"Git command root is outside the authorized root generation vector\")\n\t\treturn \"\", nil, nil, errGovernanceReadViewOutsideRoot\n\t}\n\tif target == nil {\n\t\ttarget = op.primary\n\t}\n\treturn absolute, target, state, nil\n}\n\nfunc (state *governanceReadViewGitState) capture(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif state == nil || state.op == nil {\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif ctx == nil {\n\t\tctx = context.Background()\n\t}\n\tdeadline, hasDeadline := ctx.Deadline()\n\tauditContext := context.WithoutCancel(ctx)\n\tkey := governanceGitObservationKey(root, args, maxOutputBytes)\n\tstate.mu.Lock()\n\tif prior := state.observations[key]; prior != nil {\n\t\tprior.producers[producer] = true\n\t\tstdout, err := append([]byte(nil), prior.stdout...), prior.err\n\t\tstate.mu.Unlock()\n\t\treturn stdout, err\n\t}\n\tmetadataCost := int64(len(root) + len(key) + len(producer) + 128)\n\tif !state.op.reserveRecord(metadataCost) {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its shared record or metadata budget while capturing Git\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tlimit := maxOutputBytes\n\tif state.op.remainingInput() < limit {\n\t\tlimit = state.op.remainingInput()\n\t}\n\tif limit <= 0 {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its Git input byte budget\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tbyObject, byHead := governancePureGitRead(args)\n\theadBefore := \"\"\n\tif byHead {\n\t\theadBefore = governanceHeadAt(ctx, files, root)\n\t}\n\t// A process that turned the resident memo on answers a pure read from it; the bytes are\n\t// admitted against the operation's budget as a fresh read's are.\n\tvar stdout, stderr []byte\n\tvar runErr error\n\tmemoKey, memoized := \"\", false\n\tmemo := residentGit.Load()\n\tif memo != nil && (byObject || byHead && headBefore != \"\") {\n\t\tif key, ok := residentGitKey(root, headBefore, state.effectiveGitConfig(ctx, files, root), args); ok {\n\t\t\tmemoKey = key\n\t\t\tif hit, found := memo.get(key); found {\n\t\t\t\tif int64(len(hit)) > limit || !state.op.reserveInput(int64(len(hit))) {\n\t\t\t\t\tstate.mu.Unlock()\n\t\t\t\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n\t\t\t\t\treturn nil, errGovernanceReadViewBudget\n\t\t\t\t}\n\t\t\t\tstdout, memoized = hit, true\n\t\t\t}\n\t\t}\n\t}\n\tif !memoized {\n\t\tstdout, stderr, runErr = runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, state.op.reserveInput)\n\t}\n\tif errors.Is(runErr, errGovernanceReadViewBudget) {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tobservation := &governanceReadViewGitObservation{\n\t\troot: root, args: append([]string(nil), args...), files: files, ctx: auditContext, deadline: deadline, hasDeadline: hasDeadline, maxOutputBytes: maxOutputBytes,\n\t\tstdout: append([]byte(nil), stdout...), stderr: append([]byte(nil), stderr...), err: runErr, errText: errorText(runErr),\n\t\tproducers: map[string]bool{producer: true},\n\t}\n\tif runErr == nil && len(stderr) == 0 {\n\t\tswitch {\n\t\tcase byObject:\n\t\t\tobservation.pure = true\n\t\tcase memoized && byHead:\n\t\t\t// The commit is the one the memo's key names; nothing ran, so there is no second read.\n\t\t\tobservation.pure, observation.headAt = true, headBefore\n\t\tcase byHead && headBefore != \"\" && governanceHeadAt(ctx, files, root) == headBefore:\n\t\t\tobservation.pure, observation.headAt = true, headBefore\n\t\t}\n\t\tif memoKey != \"\" && !memoized && observation.pure {\n\t\t\tmemo.put(memoKey, stdout)\n\t\t}\n\t}\n\tstate.observations[key] = observation\n\tstate.mu.Unlock()\n\tif isGovernanceGitHeadCommand(args) {\n\t\tif runErr != nil {\n\t\t\tif !state.op.mayOmitPrimaryRevision(root) {\n\t\t\t\tstate.markUnknownForRoot(root, producer, \"source revision could not be read from Git\")\n\t\t\t}\n\t\t} else {\n\t\t\trevision := strings.TrimSpace(string(stdout))\n\t\t\tif revision == \"\" && state.op.mayOmitPrimaryRevision(root) {\n\t\t\t\treturn append([]byte(nil), stdout...), runErr\n\t\t\t}\n\t\t\tstate.bindRevision(root, revision)\n\t\t}\n\t}\n\treturn append([]byte(nil), stdout...), runErr\n}\n\nfunc isGovernanceGitHeadCommand(args []string) bool {\n\treturn len(args) == 3 && args[0] == \"rev-parse\" && args[1] == \"--verify\" && args[2] == \"HEAD\"\n}\n\nfunc governanceGitObservationKey(root string, args []string, maxOutputBytes int64) string {\n\tencoded, _ := json.Marshal(args)\n\treturn filepath.Clean(root) + \"\\x00\" + string(encoded) + \"\\x00\" + fmt.Sprint(maxOutputBytes)\n}\n\nfunc (state *governanceReadViewGitState) bindRevision(root, revision string) {\n\tif revision == \"\" || state == nil || state.op == nil {\n\t\tstate.markUnknownForRoot(root, \"projection\", \"source revision binding is unavailable\")\n\t\treturn\n\t}\n\tstate.op.mu.Lock()\n\tfor _, entry := range state.op.roots {\n\t\tif sameLexicalRoot(entry.root, root) {\n\t\t\tentry.revision = revision\n\t\t\tstate.op.mu.Unlock()\n\t\t\treturn\n\t\t}\n\t}\n\tstate.op.mu.Unlock()\n\tstate.markUnknownForRoot(root, \"projection\", \"source revision root is outside the authorized vector\")\n}\n\traw, _ := json.Marshal(items)\n\tsum := sha256.Sum256(raw)\n\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n}\n\nfunc runGovernanceGitCommand(files Files, root string, args []string, limit int64) ([]byte, error) {\n\tstdout, _, err := runGovernanceGitCommandOutput(files, root, args, limit)\n\treturn stdout, err\n}\n\nfunc runGovernanceGitCommandContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, error) {\n\tstdout, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, args, limit)\n\treturn stdout, err\n}\n\nfunc runGovernanceGitCommandOutput(files Files, root string, args []string, limit int64) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmitted(files, root, args, limit, nil)\n}\n\nfunc runGovernanceGitCommandOutputContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, nil)\n}\n\n// runGovernanceGitCommandOutputAdmitted admits each stream chunk before the\n// bounded output buffer retains it. The operation callback is shared with\n// Files reads, so concurrent producers cannot spend the same remaining bytes.\nfunc runGovernanceGitCommandOutputAdmitted(files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmittedContext(context.Background(), files, root, args, limit, admit)\n}\n\n// runGovernanceGitCommandOutputAdmittedContext admits each stream chunk before\n// the bounded output buffer retains it and executes Git under ctx.\n// governanceGitEnv is added to every Git command the governance read view\n// runs, captured or streamed. Governance classifies Git's failures by what\n// Git writes to stderr, so Git writes it untranslated: a translated \"not a\n// git repository\" left a directory outside any repository unknown under\n// pt_BR (spec pose-governance-git-reads-untranslated).\nvar governanceGitEnv = []string{\"GIT_OPTIONAL_LOCKS=0\", \"LC_ALL=C\", \"LANGUAGE=C\"}\n\nfunc runGovernanceGitCommandOutputAdmittedContext(ctx context.Context, files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n\tif limit < 0 {\n\t\treturn nil, nil, errGovernanceReadViewBudget\n\t}\n\tfiles = FilesOrNative(files)\n\tif ctx == nil {\n\t\tctx = context.Background()\n\t}\n\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n\tcmd.WaitDelay = 2 * time.Second\n\tcmd.Env = append(cmd.Env, governanceGitEnv...)\n\toutput := &boundedGovernanceGitOutput{limit: limit, admit: admit}\n\tcmd.Stdout = governanceGitStream{output: output, stderr: false}\n\tcmd.Stderr = governanceGitStream{output: output, stderr: true}\n\terr := cmd.Run()\n\tstdout, stderr, exceeded := output.values()\n\tif exceeded {\n\t\treturn nil, nil, errGovernanceReadViewBudget\n\t}\n\tif err != nil {\n\t\tif exit, ok := err.(*exec.ExitError); ok {\n\t\t\texit.Stderr = append([]byte(nil), stderr...)\n\t\t}\n\t\treturn stdout, stderr, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n\t}\n\tif len(stderr) > 0 {\n\t\tdetail := strings.TrimSpace(string(stderr))\n\t\tif detail == \"\" {\n\t\t\tdetail = \"Git wrote unclassified stderr output\"\n\t\t}\n\t\treturn stdout, stderr, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: errors.New(detail)}\n\t}\n\treturn stdout, stderr, nil\n}\n\ntype boundedGovernanceGitOutput struct {\n\tmu       sync.Mutex\n\tlimit    int64\n\tused     int64\n\tadmit    func(int64) bool\n\tstdout   bytes.Buffer\n\tstderr   bytes.Buffer\n\texceeded bool\n}\n\ntype governanceGitStream struct {\n\toutput *boundedGovernanceGitOutput\n\tstderr bool\n}\n\nfunc (stream governanceGitStream) Write(data []byte) (int, error) {\n\toutput := stream.output\n\toutput.mu.Lock()\n\tdefer output.mu.Unlock()\n\tif output.exceeded || int64(len(data)) > output.limit-output.used {\n\t\toutput.exceeded = true\n\t\treturn 0, errGovernanceReadViewBudget\n\t}\n\tif output.admit != nil && !output.admit(int64(len(data))) {\n\t\toutput.exceeded = true\n\t\treturn 0, errGovernanceReadViewBudget\n\t}\n\tvar err error\n\tif stream.stderr {\n\t\t_, err = output.stderr.Write(data)\n\t} else {\n\t\t_, err = output.stdout.Write(data)\n\t}\n\tif err == nil {\n\t\toutput.used += int64(len(data))\n\t}\n\treturn len(data), err\n27:\thasDeadline    bool\n337:\tdeadline, hasDeadline := ctx.Deadline()\n338:\tauditContext := context.WithoutCancel(ctx)\n395:\t\troot: root, args: append([]string(nil), args...), files: files, ctx: auditContext, deadline: deadline, hasDeadline: hasDeadline, maxOutputBytes: maxOutputBytes,\n525:\t\tif item.hasDeadline {\n\t// checked-out commit's tree plus the snapshot margin, read from the\n\t// coordinator repository when the worktree is registered (spec\n\t// pose-git-snapshot-budget-scales-with-the-tree).\n\tinventoryBytes int64\n}\n\nfunc (s Store) captureReviewCleanupOwnership(runtime *os.Root, worktree string, marker []byte) (*reviewCleanupOwnership, error) {\n\traw, err := snapshotGit(s.Root, \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tparent := filepath.Join(strings.TrimSpace(string(raw)), \"worktrees\")\n\tpath := strings.TrimSpace(strings.TrimPrefix(string(marker), \"gitdir: \"))\n\tif !strings.HasPrefix(string(marker), \"gitdir: \") || !filepath.IsAbs(path) || filepath.Dir(path) != parent {\n\t\treturn nil, fmt.Errorf(\"unexpected worktree registration\")\n\t}\n\tregistry, err := os.OpenRoot(parent)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tname := filepath.Base(path)\n\tinfo, err := registry.Lstat(name)\n\tif err != nil || !info.IsDir() {\n\t\tregistry.Close()\n\t\treturn nil, fmt.Errorf(\"worktree registration unavailable\")\n\t}\n\to := &reviewCleanupOwnership{runtime: runtime, registry: registry, registration: name, registrationInfo: info, backlink: filepath.Join(worktree, \".git\"), inventoryBytes: gitSnapshotMarginBytes}\n\tif head, err := registry.ReadFile(filepath.Join(name, \"HEAD\")); err == nil {\n\t\tif commit := strings.TrimSpace(string(head)); !strings.HasPrefix(commit, \"ref:\") && commit != \"\" {\n\t\t\tif listing, err := listCommittedTree(s.Root, commit); err == nil {\n\t\t\t\to.inventoryBytes = gitSnapshotBudget(gitCommittedTreeBytes(listing))\n\t\t\t}\n\t\t}\n\t}\n\tchild, err := registry.OpenRoot(name)\n\tif err != nil {\n\t\tregistry.Close()\n\t\treturn nil, err\n\t}\n\tbacklink, err := readReviewRootFile(child, \"gitdir\", 4096)\n\tchild.Close()\n\tif err != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n\t\tregistry.Close()\n\t\treturn nil, fmt.Errorf(\"worktree registration backlink differs\")\n\t}\n\treturn o, nil\n}\n\nfunc (s Store) cleanupReviewResources(tmp string, owned os.FileInfo, worktree string, worktreeOwned os.FileInfo, gitMarker []byte, ownership ...*reviewCleanupOwnership) error {\n\tvar o *reviewCleanupOwnership\n\tif len(ownership) > 0 {\n\t\to = ownership[0]\n\t}\n\tcurrent, err := os.Lstat(tmp)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\tif (o != nil && !o.removed) || (o == nil && worktreeOwned != nil) {\n\t\t\treturn fmt.Errorf(\"runtime path disappeared without confirmed cleanup; resources may remain\")\n\t\t}\n\t\treturn nil\n\t}\n\tif err != nil || !current.IsDir() || !os.SameFile(owned, current) {\n\t\treturn fmt.Errorf(\"cleanup refused: runtime directory identity changed\")\n\t}\n\n\tvar root *os.Root\n\tif o != nil {\n\t\troot = o.runtime\n\t} else {\n\t\troot, err = os.OpenRoot(tmp)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"runtime cleanup root unavailable\")\n\t\t}\n\t\tdefer root.Close()\n\t}\n\tstat, err := root.Stat(\".\")\n\tif err != nil || !os.SameFile(owned, stat) {\n\t\treturn fmt.Errorf(\"runtime cleanup root identity changed\")\n\t}\n\tif worktreeOwned != nil {\n\t\tinfo, err := root.Lstat(\"worktree\")\n\t\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\t\treturn fmt.Errorf(\"worktree cleanup unavailable\")\n\t\t}\n\t\tif err == nil {\n\t\t\tmarker, e := readReviewRootFile(root, \"worktree/.git\", 4096)\n\t\t\tif e != nil || !info.IsDir() || !os.SameFile(worktreeOwned, info) || !bytes.Equal(marker, gitMarker) {\n\t\t\t\treturn fmt.Errorf(\"cleanup refused: worktree identity changed\")\n\t\t\t}\n\t\t}\n\t\tif o == nil || o.registry == nil {\n\t\t\treturn fmt.Errorf(\"cleanup registration ownership unavailable; resources retained\")\n\t\t}\n\t\tinfo, e := o.registry.Lstat(o.registration)\n\t\tif e != nil || !info.IsDir() || !os.SameFile(info, o.registrationInfo) {\n\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n\t\t}\n\t\tregistration, e := o.registry.OpenRoot(o.registration)\n\t\tif e != nil {\n\t\t\treturn fmt.Errorf(\"cleanup registration unavailable\")\n\t\t}\n\t\tdefer registration.Close()\n\t\tinfo, e = registration.Stat(\".\")\n\t\tif e != nil || !os.SameFile(info, o.registrationInfo) {\n\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n\t\t}\n\t\tbacklink, e := readReviewRootFile(registration, \"gitdir\", 4096)\n\t\tif e != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n\t\t\treturn fmt.Errorf(\"cleanup registration backlink changed\")\n\t\t}\n\t\tfor _, lock := range []string{\"locked\", \"index.lock\", \"HEAD.lock\"} {\n\t\t\tif _, e := registration.Lstat(lock); !errors.Is(e, os.ErrNotExist) {\n\t\t\t\treturn fmt.Errorf(\"worktree registration has a live or unknown lock; resources retained\")\n\t\t\t}\n\t\t}\n\t\tif err == nil {\n\t\t\ttree, e := root.OpenRoot(\"worktree\")\n\t\t\tif e != nil {\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup root unavailable\")\n\t\t\t}\n\t\t\tinfo, e := tree.Stat(\".\")\n\t\t\tif e != nil || !os.SameFile(info, worktreeOwned) {\n\t\t\t\ttree.Close()\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup identity changed\")\n\t\t\t}\n\t\t\tlimit := gitSnapshotMarginBytes\n\t\t\tif o.inventoryBytes > limit {\n\t\t\t\tlimit = o.inventoryBytes\n\t\t\t}\n\t\t\te = removeReviewOwnedContents(tree, 100000, limit)\n\t\t\ttree.Close()\n\t\t\tif e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tif e := root.Remove(\"worktree\"); e != nil && !errors.Is(e, os.ErrNotExist) {\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup incomplete\")\n\t\t\t}\n\t\t}\n\t\tif e := removeReviewOwnedContents(registration, 1024, 256<<20); e != nil {\n\t\t\treturn e\n\t\t}\n\t\tregistration.Close()\n\t\tif e := o.registry.Remove(o.registration); e != nil && !errors.Is(e, os.ErrNotExist) {\n\t\t\treturn fmt.Errorf(\"worktree registration cleanup incomplete\")\n\t\t}\n\t} else if _, e := root.Lstat(\"worktree\"); !errors.Is(e, os.ErrNotExist) {\n\t\treturn fmt.Errorf(\"partial worktree setup has no verified ownership; resources retained\")\n\t}\n\tif err := removeReviewGoBuildLeftovers(root); err != nil {\n\t\treturn err\n\t}\n\tif err := removeReviewOwnedContents(root, reviewRuntimeMaxEntries, 128<<20); err != nil {\n\t\treturn err\n\t}\n\tcurrent, err = os.Lstat(tmp)\n\tif err != nil || !os.SameFile(owned, current) {\n\t\treturn fmt.Errorf(\"runtime path changed during cleanup; replacement retained\")\n\t}\n\tif err := os.Remove(tmp); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\treturn fmt.Errorf(\"runtime directory cleanup incomplete\")\n\t}\n\tif o != nil {\n\t\to.removed = true\n\t}\n\treturn nil\n}\n\n// reviewGoBuildDir names the temporary build directory the Go toolchain\n// creates under the TMPDIR the engine gives a review run.\nvar reviewGoBuildDir = regexp.MustCompile(`^go-build[0-9]+$`)\n\n// reviewGoBuildBeforeOpen runs after a go-build name is listed and before it\n// is opened, reviewGoBuildAfterContents after the directory is emptied and\n// before its name is checked again, and reviewGoBuildBeforeRemove between that\n// check and the removal; tests use them to change the name there.\nvar (\n\treviewGoBuildBeforeOpen    = func(string) {}\n\treviewGoBuildAfterContents = func(string) {}\n\treviewGoBuildBeforeRemove  = func(string) {}\n)\n\n// removeReviewGoBuildLeftovers removes the Go build directories a reviewer's\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha1\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"fmt\"\n\t\"hash\"\n\t\"io\"\n\t\"io/fs\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n)\n\n// The bytes a snapshot reads are bounded by the committed tree it compares\n// against plus a margin, never less than the margin alone and never more than\n// the ceiling: a fixed bound stopped every closeout once a repository's\n// committed tree outgrew it (spec pose-git-snapshot-budget-scales-with-the-tree).\nvar (\n\tgitSnapshotMarginBytes  int64 = 256 << 20\n\tgitSnapshotCeilingBytes int64 = 4 << 30\n)\n\nfunc gitSnapshotBudget(committedBytes int64) int64 {\n\tif committedBytes < 0 {\n\t\tcommittedBytes = 0\n\t}\n\tif committedBytes > gitSnapshotCeilingBytes-gitSnapshotMarginBytes {\n\t\treturn gitSnapshotCeilingBytes\n\t}\n\treturn committedBytes + gitSnapshotMarginBytes\n}\n\n// A committed tree listing is read through a bounded buffer under a\n// deadline: 100,000 entries of ordinary paths fit well inside it, and a\n// listing past it fails closed before it is retained (review N2).\nvar (\n\tgitTreeListingMaxBytes int64 = 64 << 20\n\tgitTreeListingTimeout        = 2 * time.Minute\n)\n\n// listCommittedTree returns `ls-tree -r -l -z commit` of root, bounded.\nfunc listCommittedTree(root, commit string) ([]byte, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), gitTreeListingTimeout)\n\tdefer cancel()\n\treturn runGovernanceGitCommandContext(ctx, NativeFiles(), root, []string{\"ls-tree\", \"-r\", \"-l\", \"-z\", commit}, gitTreeListingMaxBytes)\n}\n\n// gitCommittedTreeBytes sums the blob sizes of an `ls-tree -r -l -z` listing.\nfunc gitCommittedTreeBytes(listing []byte) int64 {\n\tvar total int64\n\tfor _, record := range bytes.Split(listing, []byte{0}) {\n\t\ti := bytes.IndexByte(record, '\\t')\n\t\tif i < 0 {\n\t\t\tcontinue\n\t\t}\n\t\tfields := strings.Fields(string(record[:i]))\n\t\tif len(fields) == 4 {\n\t\t\tif size, err := strconv.ParseInt(fields[3], 10, 64); err == nil && size > 0 {\n\t\t\t\ttotal += size\n\t\t\t}\n\t\t}\n\t}\n\treturn total\n}\n\n// Snapshot disk, including ignored files. Git status alone cannot witness\n// creation of an ignored output. WalkDir never follows a directory symlink.\nfunc dispatchDiskSnapshot(root string) (map[string]string, error) {\n\tentries := map[string]string{}\n\tvar total int64\n\tcommitted := int64(0)\n\tif listing, err := listCommittedTree(root, \"HEAD\"); err == nil {\n\t\tcommitted = gitCommittedTreeBytes(listing)\n\t}\n\tbudget := gitSnapshotBudget(committed)\n\terr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\trel, err := filepath.Rel(root, path)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif rel == \".\" {\n\t\t\treturn nil\n\t\t}\n\t\tif rel == \".git\" {\n\t\t\tif entry.IsDir() {\n\t\t\t\treturn filepath.SkipDir\n\t\t\t}\n\t\t\treturn nil\n\t\t}\n\t\tinfo, err := entry.Info()\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\t// The per-root authority lock is runtime coordination state, not a\n\t\t// project input. Ignore only the exact regular file: a linked or special\n\t\t// replacement remains visible to the snapshot and fails closed.\n\t\tif filepath.ToSlash(rel) == \".pose/transfers/.authority-transfer.lock\" && info.Mode().IsRegular() {\n\t\t\treturn nil\n\t\t}\n\t\tif len(entries) >= 100000 {\n\t\t\treturn fmt.Errorf(\"disk snapshot exceeds 100000 entries\")\n\t\t}\n\t\thash := sha256.New()\n\t\tfmt.Fprintf(hash, \"%s\\x00\", info.Mode().String())\n\t\tswitch {\n\t\tcase info.Mode().IsRegular():\n\t\t\tfile, err := os.Open(path)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tn, readErr := io.Copy(hash, io.LimitReader(file, budget-total+1))\n\t\t\tcloseErr := file.Close()\n\t\t\ttotal += n\n\t\t\tif readErr != nil {\n\t\t\t\treturn readErr\n\t\t\t}\n\t\t\tif closeErr != nil {\n\t\t\t\treturn closeErr\n\t\t\t}\n\t\t\tif total > budget {\n\t\t\t\treturn fmt.Errorf(\"disk snapshot exceeds its budget of %d bytes\", budget)\n\t\t\t}\n\t\tcase info.Mode()&os.ModeSymlink != 0:\n\t\t\ttarget, err := os.Readlink(path)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\thash.Write([]byte(target))\n\t\tcase info.IsDir():\n\t\tdefault:\n\t\t\treturn fmt.Errorf(\"unsupported file type at %q\", rel)\n\t\t}\n\t\tentries[filepath.ToSlash(rel)] = hex.EncodeToString(hash.Sum(nil))\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn nil, &GitSnapshotError{\"disk snapshot\", err}\n\t}\n\treturn entries, nil\n}\n\n// GitSnapshotError means a repository observation was unavailable, not clean.\ntype GitSnapshotError struct {\n\tOperation string\n\tCause     error\n}\n","exit_code":0,"status":"completed"}}
