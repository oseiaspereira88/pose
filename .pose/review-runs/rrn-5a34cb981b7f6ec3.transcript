c9a8c1813fca2679b579f9b9555bab63fa364c4378c62648afeed68\",\n    \"pose-action-answers-reverify-on-read\": \"sha256:181daf24439925b12143d88f0f73d9d3b73560e36a34f431899239f9eba6fe9b\",\n    \"pose-action-request-presentation\": \"sha256:b27e65dd57486a5aed26998a94a119b96270ad35433bd53f06e8aa517bedb604\",\n    \"pose-action-request-recovery-and-preflight\": \"sha256:b49ced479077d3c17d966ac24118944d1849c6c5d0f2e25532fa605c6a1e4c0a\",\n    \"pose-action-request-resolution\": \"sha256:bc622517b26db6e9f0b35834e24fbde210cc984d27c11d17110f9c49ec706aca\",\n    \"pose-action-requests\": \"sha256:85116b16918adfa846c3ae9ef6685bf7f06ccfbe3be2b255223e7337b72334a4\",\n    \"pose-action-runtime-currency-gate\": \"sha256:afbd9397cf55900b904a6c359fb96cbd07e150f4286f959d8ce058c2a628e818\",\n    \"pose-action-target-and-node-scoping\": \"sha256:108f636bf4dc7198e82aaaaa4fb3d268df044991b2d26d69c8a014edf4f4c614\",\n    \"pose-action-waiver-and-supersession-authority\": \"sha256:3a422e634acdc543081d9768a96767d29cce06aa5722d4330780cd720f790124\",\n    \"pose-actions-node24-bump\": \"sha256:aaff42b0f2fb8f9cae03dda5866664ce308568935287d928be069be522b5f0c4\",\n    \"pose-adaptive-assessment-freshness\": \"sha256:a2b7d101380d90d22735d9817cf9a47fa49860e182eeed739189e44186017b1c\",\n    \"pose-adaptive-rule-delivery\": \"sha256:1f1acc8351772b002161e0eb6a42a815dcd9707ef1764aeee8e57d52ac0b888b\",\n    \"pose-adopt-request-keeps-the-reason\": \"sha256:bb6b9b695a1f81fc2be18cbe71f102d1e9ee1110b51d418f1d85aaa4e90935b8\",\n    \"pose-adopt-request-shows-what-it-sets\": \"sha256:41ea2b5c99ac2e23111f69513f32a5a7c7450a4a706d1fdb79c84918b57d3128\",\n    \"pose-adoption-stamp-stays-readable\": \"sha256:0b6b5cfffbc3d59c5e4de0399ddc0efde2ce9dbe65797253ae8b383ec0485d72\",\n    \"pose-agency-readiness-pilot\": \"sha256:91b5f9021e2e696e98a883d265245e8ad11290d9e8b03d1ecc199a4088c29957\",\n    \"pose-agent-project-context\": \"sha256:6d9a6c35d51195b498204e7275b2ef5e3994404523bc3982669a11555d2096b3\",\n    \"pose-agy-smoke-test\": \"sha256:5f872a6a5557eea571045cefb63a0f3abde6af4224791d2f8731d321159c51f4\",\n    \"pose-amendment-history-holds-before-close\": \"sha256:ae0e513d5082f58063623e798b10aa55a856ec61d85426aa9aa545e1046b110d\",\n    \"pose-artifact-provenance-ledger\": \"sha256:7442046320bf8083ead3c33cbe91d137e2dfdc821dac8fd4d87f6853367cc662\",\n    \"pose-assessment-engine-precision\": \"sha256:de53350ca126ff48bb94050cb1680ee90bd6b1447ea9790d5f44ccab9f88ea7d\",\n    \"pose-assumption-validity-scope\": \"sha256:e62c9d9dee74384bd193c1983c599604dd11089c9889c4cc979290196b45cf0a\",\n    \"pose-atomic-start-adoption-cutoff\": \"sha256:057b602c42e05445fd102376a414d2354852a3c7536594f3eeb37106434bf520\",\n    \"pose-attention-federated-parity\": \"sha256:e32d17a06783a26c70e60c03c4e69e428a302c4a0e9d774879bd5f8d1527255d\",\n    \"pose-attention-lists-only-open-obligations\": \"sha256:c65275051969cb835993845179b1e6617884a85fc84d74536c2cf0274777779f\",\n    \"pose-attention-projects-every-source\": \"sha256:90286cf1ed9bcafef35d53425f14e0bb50417eedd517d42c61e81538f2df9575\",\n    \"pose-attention-within-a-second\": \"sha256:4c3b38c8c7f8226092daf16f90b27c3a450e714e9cd2804f4d2a3e5ddd26936f\",\n    \"pose-attest-records-not-applicable\": \"sha256:9cf53485aac1d3195975630fb6f49f3cc86510f9d3dd10c16ea6ff797e990c19\",\n    \"pose-attest-refuses-what-verify-rejects\": \"sha256:985515cc29d94aba4f944aa12d4b3e0ee53442de35faab7cfa6bb9e547270458\",\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n","exit_code":0,"status":"completed"}}
