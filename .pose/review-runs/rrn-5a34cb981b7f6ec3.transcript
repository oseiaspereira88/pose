{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,180p' pose-mcp/internal/pose/governance_read_view_git.go; rg -n 'runGovernanceGitCommandContext|CaptureGovernanceGitContextIn' pose-mcp/internal/pose; sed -n '235,460p' pose-mcp/internal/pose/git_snapshot_integrity.go\"","aggregated_output":"package pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n)\n\nconst governanceReadViewGitParserVersion = \"pose-governance-git-inputs-v1\"\n\ntype governanceReadViewGitObservation struct {\n\troot           string\n\targs           []string\n\tfiles          Files\n\tctx            context.Context\n\tdeadline       time.Time\n\thasDeadline    bool\n\tmaxOutputBytes int64\n\tstdout         []byte\n\tstderr         []byte\n\terr            error\n\terrText        string\n\tproducers      map[string]bool\n\t// pure is set when the output cannot change while the commit it was read at stands: it is a\n\t// function of object ids, or of headAt, the commit HEAD named before and after the command.\n\t// The final audit then reruns it only if HEAD moved.\n\tpure   bool\n\theadAt string\n}\n\n// governanceReadViewGitState captures exact, bounded Git command results for\n// one read-view operation. Repeated commands replay the first result; audit\n// reruns each exact command and reports any changed or unprovable result.\ntype governanceReadViewGitState struct {\n\top            *governanceReadViewOperation\n\tmu            sync.Mutex\n\tobservations  map[string]*governanceReadViewGitObservation\n\tstreams       map[string]*governanceReadViewStreamObservation\n\tconfigMu      sync.Mutex\n\tconfigDigests map[string]string\n}\n\n// effectiveGitConfig is the digest of `git config --list` of a root (every scope, includes\n// followed), read once per operation and kept apart from the command observations: it is a key\n// of the resident memo, not an input the audit replays. Empty when it could not be read.\nfunc (state *governanceReadViewGitState) effectiveGitConfig(ctx context.Context, files Files, root string) string {\n\tstate.configMu.Lock()\n\tdefer state.configMu.Unlock()\n\tif digest, ok := state.configDigests[root]; ok {\n\t\treturn digest\n\t}\n\tdigest := \"\"\n\tif out, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, []string{\"config\", \"--list\", \"-z\", \"--includes\"}, 1<<20); err == nil {\n\t\tsum := sha256.Sum256(out)\n\t\tdigest = hex.EncodeToString(sum[:8])\n\t}\n\tstate.configDigests[root] = digest\n\treturn digest\n}\n\nfunc newGovernanceReadViewGitState(op *governanceReadViewOperation) *governanceReadViewGitState {\n\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}, configDigests: map[string]string{}}\n}\n\n// captureGovernanceGit runs a Git command through the read-view generation\n// when Files belongs to one. Native and preview operations retain their\n// existing behavior when there is no governance view.\nfunc captureGovernanceGit(files Files, root, producer string, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n}\n\n// CaptureGovernanceGitIn executes one bounded raw-history Git command through\n// the operation's captured read view when Files carries one. maxOutputBytes\n// bounds combined stdout and stderr before bytes are retained. Git commands\n// use gitCommand, which disables replacement refs and grafts.\nfunc CaptureGovernanceGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBounded(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitIn names the history semantics explicitly for\n// callers whose result depends on raw commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitIn(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceGitContextIn is CaptureGovernanceGitIn under ctx. The same\n// context is retained for the final audit rerun.\nfunc CaptureGovernanceGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitContextIn names raw history semantics for\n// context-bound callers that inspect commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitContextIn(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceGitBounded(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBoundedContext(files, context.Background(), root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceGitBoundedContext(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tfiles = FilesOrNative(files)\n\tview, viewFiles := governanceReadViewFromFiles(files)\n\tif view == nil {\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif view.operation == nil {\n\t\tview.markUnknown(producer, \"Git input has no operation-scoped generation vector\")\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif viewFiles != nil {\n\t\tproject := viewFiles.project\n\t\tif target := view.route(root, producer, project); target == nil {\n\t\t\tview.markUnknown(producer, \"Git input is outside the authorized root generation vector\")\n\t\t\treturn nil, errGovernanceReadViewOutsideRoot\n\t\t} else {\n\t\t\tview = target\n\t\t}\n\t}\n\treturn view.operation.captureFilesBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceSourceRevision(files Files, root, producer string) (string, error) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\traw, err := captureGovernanceGit(files, root, producer, \"rev-parse\", \"--verify\", \"HEAD\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\trevision := strings.TrimSpace(string(raw))\n\tif revision == \"\" {\n\t\tif view, _ := governanceReadViewFromFiles(files); view != nil {\n\t\t\tview.markUnknown(producer, \"source revision binding is unavailable\")\n\t\t}\n\t\treturn \"\", fmt.Errorf(\"pose: Git returned no source revision\")\n\t}\n\treturn revision, nil\n}\n\nfunc readGitStatusGovernedIn(files Files, root, producer string, pathspecs ...string) ([]GitStatusEntry, error) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\targs := []string{\"status\", \"--porcelain=v1\", \"-z\", \"--untracked-files=all\", \"--ignore-submodules=none\"}\n\tif len(pathspecs) > 0 {\n\t\targs = append(args, \"--\")\n\t\targs = append(args, pathspecs...)\n\t}\n\tout, err := captureGovernanceGit(files, root, producer, args...)\n\tif err != nil {\n\t\tif hasGitMetadataIn(FilesOrNative(files), root) {\n\t\t\tmarkGovernanceReadUnknownForProject(files, root, \"\", producer, \"Git status could not be read in this repository\")\n\t\t} else {\n\t\t\treturn nil, fmt.Errorf(\"%w: %v\", ErrGitUnavailable, err)\n\t\t}\n\t\treturn nil, err\n\t}\n\tentries, err := parseGitStatusEntries(out)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif preview := FilesOrNative(files).Preview(); preview != nil {\n\t\treturn projectGitStatus(preview, root, entries, pathspecs)\n\t}\n\treturn entries, nil\n}\npose-mcp/internal/pose/governance_read_view_git.go:99:// CaptureGovernanceGitContextIn is CaptureGovernanceGitIn under ctx. The same\npose-mcp/internal/pose/governance_read_view_git.go:101:func CaptureGovernanceGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\npose-mcp/internal/pose/governance_read_view_git.go:111:\treturn CaptureGovernanceGitContextIn(files, ctx, root, producer, maxOutputBytes, args...)\npose-mcp/internal/pose/governance_read_view_git.go:122:\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:126:\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:282:\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:332:\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:610:func runGovernanceGitCommandContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, error) {\npose-mcp/internal/pose/git_snapshot_integrity.go:56:\treturn runGovernanceGitCommandContext(ctx, NativeFiles(), root, []string{\"ls-tree\", \"-r\", \"-l\", \"-z\", commit}, gitTreeListingMaxBytes)\npose-mcp/internal/pose/git_snapshot_integrity.go:252:\t\t\t\treturn CaptureGovernanceGitContextIn(files, ctx, root, producer, gitTreeListingMaxBytes, args...)\n\tif producer != \"\" {\n\t\tproducer = governanceProducerFromFiles(files, producer)\n\t}\n\trunGit := func(root string, args ...string) ([]byte, error) {\n\t\tif len(args) == 5 && args[0] == \"ls-tree\" {\n\t\t\treturn listCommittedTree(root, args[4])\n\t\t}\n\t\treturn snapshotGit(root, args...)\n\t}\n\tworktreeIdentity := dispatchWorktreeIdentity\n\tif producer != \"\" {\n\t\trunGit = func(root string, args ...string) ([]byte, error) {\n\t\t\tif len(args) == 5 && args[0] == \"ls-tree\" {\n\t\t\t\t// The governed listing keeps its read-view provenance under the\n\t\t\t\t// listing's own bound and deadline (review N4).\n\t\t\t\tctx, cancel := context.WithTimeout(context.Background(), gitTreeListingTimeout)\n\t\t\t\tdefer cancel()\n\t\t\t\treturn CaptureGovernanceGitContextIn(files, ctx, root, producer, gitTreeListingMaxBytes, args...)\n\t\t\t}\n\t\t\treturn captureGovernanceGit(files, root, producer, args...)\n\t\t}\n\t\tworktreeIdentity = func(root string) (string, error) {\n\t\t\treturn dispatchWorktreeIdentityGoverned(files, root, producer)\n\t\t}\n\t}\n\tvar err error\n\troot, err = filepath.Abs(root)\n\tif err != nil {\n\t\treturn nil, &GitSnapshotError{\"root\", err}\n\t}\n\tif _, err := worktreeIdentity(root); err != nil {\n\t\treturn nil, err\n\t}\n\tout, err := runGit(root, \"ls-tree\", \"-r\", \"-l\", \"-z\", commit)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tbudget := gitSnapshotBudget(gitCommittedTreeBytes(out))\n\tvar changed []string\n\tvar total int64\n\tcount := 0\n\tfor _, record := range bytes.Split(out, []byte{0}) {\n\t\tif len(record) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tcount++\n\t\tif count > 100000 {\n\t\t\treturn nil, &GitSnapshotError{\"tree snapshot\", fmt.Errorf(\"exceeds 100000 entries\")}\n\t\t}\n\t\ti := bytes.IndexByte(record, '\\t')\n\t\tif i < 0 {\n\t\t\treturn nil, &GitSnapshotError{\"tree protocol\", fmt.Errorf(\"missing path\")}\n\t\t}\n\t\tfields := strings.Fields(string(record[:i]))\n\t\tif len(fields) != 4 {\n\t\t\treturn nil, &GitSnapshotError{\"tree protocol\", fmt.Errorf(\"invalid entry\")}\n\t\t}\n\t\tfields = fields[:3]\n\t\tpath := string(record[i+1:])\n\t\tif fields[0] == \"160000\" && matters != nil && !matters(path) {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(root, filepath.FromSlash(path))\n\t\t// Lstat every parent: a link in a parent must never read outside root.\n\t\tunsafe := false\n\t\tfor parent := filepath.Dir(full); parent != root; parent = filepath.Dir(parent) {\n\t\t\tif parent == filepath.Dir(parent) {\n\t\t\t\treturn nil, &GitSnapshotError{\"path\", fmt.Errorf(\"path outside worktree: %q\", path)}\n\t\t\t}\n\t\t\tvar info os.FileInfo\n\t\t\tvar e error\n\t\t\tif producer != \"\" {\n\t\t\t\tinfo, e = files.Lstat(parent)\n\t\t\t} else {\n\t\t\t\tinfo, e = os.Lstat(parent)\n\t\t\t}\n\t\t\tif e != nil || !info.IsDir() {\n\t\t\t\tunsafe = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif unsafe {\n\t\t\tchanged = append(changed, path)\n\t\t\tcontinue\n\t\t}\n\t\tvar info os.FileInfo\n\t\tvar e error\n\t\tif producer != \"\" {\n\t\t\tinfo, e = files.Lstat(full)\n\t\t} else {\n\t\t\tinfo, e = os.Lstat(full)\n\t\t}\n\t\tif os.IsNotExist(e) {\n\t\t\tchanged = append(changed, path)\n\t\t\tcontinue\n\t\t}\n\t\tif e != nil {\n\t\t\treturn nil, &GitSnapshotError{\"lstat \" + path, e}\n\t\t}\n\t\tif fields[0] == \"160000\" {\n\t\t\tif !info.IsDir() {\n\t\t\t\tchanged = append(changed, path)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, err := worktreeIdentity(full); err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t\thead, e := runGit(full, \"rev-parse\", \"--verify\", \"HEAD\")\n\t\t\tif e != nil {\n\t\t\t\treturn nil, e\n\t\t\t}\n\t\t\tvar dirty []string\n\t\t\tif producer != \"\" {\n\t\t\t\tdirty, e = gitChangedPathsGovernedIn(files, full, producer)\n\t\t\t} else {\n\t\t\t\tdirty, e = gitChangedPaths(full)\n\t\t\t}\n\t\t\tif e != nil {\n\t\t\t\treturn nil, e\n\t\t\t}\n\t\t\tif strings.TrimSpace(string(head)) != fields[2] || len(dirty) != 0 {\n\t\t\t\tchanged = append(changed, path)\n\t\t\t} else {\n\t\t\t\tvar nested []string\n\t\t\t\tif producer != \"\" {\n\t\t\t\t\tnested, err = gitMaterializedChangesForIn(files, full, fields[2], matters, producer)\n\t\t\t\t} else {\n\t\t\t\t\tnested, err = gitMaterializedChanges(full, fields[2])\n\t\t\t\t}\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn nil, err\n\t\t\t\t}\n\t\t\t\tif len(nested) != 0 {\n\t\t\t\t\tchanged = append(changed, path)\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tvar raw []byte\n\t\tif fields[0] == \"120000\" {\n\t\t\tif info.Mode()&os.ModeSymlink == 0 {\n\t\t\t\tchanged = append(changed, path)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tvar target string\n\t\t\ttarget, e = os.Readlink(full)\n\t\t\traw = []byte(target)\n\t\t} else {\n\t\t\tif !info.Mode().IsRegular() {\n\t\t\t\tchanged = append(changed, path)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// Verify executable materialization even when index flags hide it.\n\t\t\t// Windows does not materialize POSIX executable bits.\n\t\t\tif runtime.GOOS != \"windows\" && (info.Mode().Perm()&0111 != 0) != (fields[0] == \"100755\") {\n\t\t\t\tchanged = append(changed, path)\n\t\t\t}\n\t\t\tif info.Size() > budget-total {\n\t\t\t\treturn nil, &GitSnapshotError{\"read \" + path, fmt.Errorf(\"snapshot exceeds its budget of %d bytes\", budget)}\n\t\t\t}\n\t\t\tvar file *os.File\n\t\t\tfile, e = os.Open(full)\n\t\t\tif e == nil {\n\t\t\t\traw, e = io.ReadAll(io.LimitReader(file, budget-total+1))\n\t\t\t\tcloseErr := file.Close()\n\t\t\t\tif e == nil {\n\t\t\t\t\te = closeErr\n\t\t\t\t}\n\t\t\t\ttotal += int64(len(raw))\n\t\t\t\tif total > budget {\n\t\t\t\t\treturn nil, &GitSnapshotError{\"read \" + path, fmt.Errorf(\"snapshot exceeds its budget of %d bytes\", budget)}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif e != nil {\n\t\t\treturn nil, &GitSnapshotError{\"read \" + path, e}\n\t\t}\n\t\tcmd := gitCommand(\"-C\", root, \"hash-object\", \"--stdin\", \"--path=\"+path)\n\t\tif fields[0] == \"120000\" {\n\t\t\tcmd = gitCommand(\"-C\", root, \"hash-object\", \"--stdin\", \"--no-filters\")\n\t\t}\n\t\tcmd.Stdin = bytes.NewReader(raw)\n\t\thash, e := cmd.Output()\n\t\tif e != nil {\n\t\t\treturn nil, &GitSnapshotError{\"hash \" + path, e}\n\t\t}\n\t\tif strings.TrimSpace(string(hash)) != fields[2] {\n\t\t\tchanged = append(changed, path)\n\t\t}\n\t}\n\tsort.Strings(changed)\n\treturn changed, nil\n}\n\n// These readers are shared by the bundle, obligation and execution snapshots.\nvar ErrGitUnknown = errors.New(\"pose: git state is unknown\")\nvar ErrGitUnavailable = errors.New(\"pose: not a git repository\")\n\nfunc (e *GitSnapshotError) Is(target error) bool { return target == ErrGitUnknown }\n\nfunc hasGitMetadata(root string) bool {\n\tdir, err := filepath.Abs(root)\n\tif err != nil {\n\t\treturn true\n\t}\n\tif gitMetadataAbove(dir) {\n\t\treturn true\n\t}\n\t// git walks the physical path, and a link can lead out of the lexical one.\n\tphysical, err := filepath.EvalSymlinks(dir)\n\treturn err == nil && physical != dir && gitMetadataAbove(physical)\n}\n\nfunc gitMetadataAbove(dir string) bool {\n\tfor {\n\t\tif gitMetadataAt(dir) {\n\t\t\treturn true\n\t\t}\n\t\tparent := filepath.Dir(dir)\n\t\tif parent == dir {\n\t\t\treturn false\n\t\t}\n\t\tdir = parent\n\t}\n}\n\n","exit_code":0,"status":"completed"}}
