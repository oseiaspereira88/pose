tf(\"%s: %s\", name, target))\n\t\t\tcontinue\n\t\t}\n\t\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: creating %s result directory: %v\\n\", \"Erro: criando diretório do resultado %s: %v\\n\"), name, err)\n\t\t\treturn 1\n\t\t}\n\t\tif err := writer.write(target, run); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: writing %s result: %v\\n\", \"Erro: escrevendo resultado %s: %v\\n\"), name, err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"%s: %s\\n\", name, target)\n\t}\n\tif planOut != \"\" {\n\t\tdigest := sha256.Sum256(raw)\n\t\thead := \"\"\n\t\tif out, err := posemodel.RawHistoryGit(root, \"rev-parse\", \"HEAD\").Output(); err == nil {\n\t\t\thead = strings.TrimSpace(string(out))\n\t\t}\n\t\tplan := executionPlan{\n\t\t\tSchemaVersion: validationResultSchema,\nPOSE - artifact-check\n\nReconcile declared spec artifacts with immutable Git changesets\n\nUsage:\n  pose artifact-check --spec <slug> [--from <rev> --to <rev>] [--strict|--tolerant] [--json]\n\nDescription:\n  Verifies that all files declared in section 3 (Technical Plan -> Artifacts) match the actual Git change set attributed to the spec trailer (POSE-Spec: <slug>).\n\nOptions / Flags:\n  --spec <slug>            Specification slug to reconcile\n  --from <rev>             Starting git revision for change set comparison\n  --to <rev>               Ending git revision for change set comparison\n  --strict                 Fail on any undeclared or missing artifact mismatch\n  --json                   Output reconciliation results in JSON format\n\nExamples:\n  $ pose artifact-check --spec user-auth --strict\n\n","exit_code":0,"status":"completed"}}
