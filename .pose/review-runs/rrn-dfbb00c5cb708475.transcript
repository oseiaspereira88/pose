 +\n .pose/review-runs/rrn-67a184e6a36ce92e.transcript  |   65 +\n .../review-runs/rrn-78b11adc9ff36dd0.events.ndjson |   46 +\n .pose/review-runs/rrn-78b11adc9ff36dd0.json        |  142 +\n .pose/review-runs/rrn-78b11adc9ff36dd0.transcript  |   47 +\n .../review-runs/rrn-a7caa3d63cc0d538.events.ndjson |   79 +\n .pose/review-runs/rrn-a7caa3d63cc0d538.json        |  143 +\n .pose/review-runs/rrn-a7caa3d63cc0d538.transcript  |   80 +\n ...-11-14-pose-adopt-request-shows-what-it-sets.md |    4 +-\n ...se-review-cleanup-removes-go-build-leftovers.md |  154 +\n ...-review-cleanup-removes-go-build-leftovers.json |   38 +\n .pose/state/components/docs-site.json              |    6 +-\n .pose/state/components/mcp-enforce.json            |    6 +-\n .pose/state/components/pose-mcp.json               |   12 +-\n .pose/state/project-state.md                       |    4 +-\n .../internal/pose/review_adapter_containment.go    |   41 +\n .../review_adapter_containment_regression_test.go  |  114 +\n .../internal/pose/review_go_build_cleanup_other.go |   17 +\n .../internal/pose/review_go_build_cleanup_unix.go  |  131 +\n .../pose/review_go_build_cleanup_unix_test.go      |   82 +\n 72 files changed, 24613 insertions(+), 4079 deletions(-)\n","exit_code":0,"status":"completed"}}
