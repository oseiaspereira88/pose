K|unix.O_CLOEXEC, 0)\n    37\t\tif errors.Is(err, unix.ENOTDIR) || errors.Is(err, unix.ELOOP) || errors.Is(err, unix.ENOENT) {\n    38\t\t\treturn nil // not a directory now: the runtime inventory judges it\n    39\t\t}\n    40\t\tif err != nil {\n    41\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n    42\t\t}\n    43\t\tdefer unix.Close(dfd)\n    44\t\tvar opened unix.Stat_t\n    45\t\tif err := unix.Fstat(dfd, &opened); err != nil || opened.Mode&unix.S_IFMT != unix.S_IFDIR {\n    46\t\t\treturn errReviewGoBuildChanged\n    47\t\t}\n    48\t\tbudget := reviewGoBuildBudget{entries: reviewGoBuildMaxEntries, bytes: reviewGoBuildMaxBytes}\n    49\t\tif err := removeReviewGoBuildContents(dfd, 0, &budget); err != nil {\n    50\t\t\treturn err\n    51\t\t}\n    52\t\treviewGoBuildAfterContents(name)\n    53\t\tvar bound unix.Stat_t\n    54\t\tif err := unix.Fstatat(pfd, name, &bound, unix.AT_SYMLINK_NOFOLLOW); err != nil || bound.Dev != opened.Dev || bound.Ino != opened.Ino {\n    55\t\t\treturn errReviewGoBuildChanged\n    56\t\t}\n    57\t\treviewGoBuildBeforeRemove(name)\n    58\t\tif err := unix.Unlinkat(pfd, name, unix.AT_REMOVEDIR); err != nil {\n    59\t\t\treturn fmt.Errorf(\"runtime cleanup incomplete; resources retained\")\n    60\t\t}\n    61\t\tvar after unix.Stat_t\n    62\t\tif err := unix.Fstat(dfd, &after); err != nil || after.Dev != opened.Dev || after.Ino != opened.Ino || after.Nlink != 0 {\n    63\t\t\treturn errReviewGoBuildChanged\n    64\t\t}\n    65\t\treturn nil\n    66\t}\n    67\t\n    68\ttype reviewGoBuildBudget struct {\n    69\t\tentries int\n    70\t\tbytes   int64\n    71\t}\n    72\t\n    73\t// removeReviewGoBuildContents empties the directory open as dfd: every entry\n    74\t// is examined without following links, subdirectories are opened relative to\n    75\t// dfd as directories without blocking, and every removal is relative to the\n    76\t// descriptor that holds the entry.\n    77\tfunc removeReviewGoBuildContents(dfd, depth int, budget *reviewGoBuildBudget) error {\n    78\t\tif depth > reviewGoBuildMaxDepth {\n    79\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n    80\t\t}\n    81\t\tdup, err := unix.Dup(dfd)\n    82\t\tif err != nil {\n    83\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n    84\t\t}\n    85\t\tdir := os.NewFile(uintptr(dup), \"go-build\")\n    86\t\tnames, err := dir.Readdirnames(-1)\n    87\t\tdir.Close()\n    88\t\tif err != nil {\n    89\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n    90\t\t}\n    91\t\tfor _, name := range names {\n    92\t\t\tbudget.entries--\n    93\t\t\tif budget.entries < 0 {\n    94\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n    95\t\t\t}\n    96\t\t\tvar st unix.Stat_t\n    97\t\t\tif err := unix.Fstatat(dfd, name, &st, unix.AT_SYMLINK_NOFOLLOW); err != nil {\n    98\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n    99\t\t\t}\n   100\t\t\tif st.Mode&unix.S_IFMT != unix.S_IFDIR {\n   101\t\t\t\tif st.Mode&unix.S_IFMT == unix.S_IFREG {\n   102\t\t\t\t\tbudget.bytes -= st.Size\n   103\t\t\t\t\tif budget.bytes < 0 {\n   104\t\t\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n   105\t\t\t\t\t}\n   106\t\t\t\t}\n   107\t\t\t\tif err := unix.Unlinkat(dfd, name, 0); err != nil {\n   108\t\t\t\t\treturn fmt.Errorf(\"runtime cleanup incomplete; resources retained\")\n   109\t\t\t\t}\n   110\t\t\t\tcontinue\n   111\t\t\t}\n   112\t\t\tchild, err := unix.Openat(dfd, name, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_NONBLOCK|unix.O_CLOEXEC, 0)\n   113\t\t\tif err != nil {\n   114\t\t\t\treturn errReviewGoBuildChanged\n   115\t\t\t}\n   116\t\t\tvar opened unix.Stat_t\n   117\t\t\tif err := unix.Fstat(child, &opened); err != nil || opened.Dev != st.Dev || opened.Ino != st.Ino {\n   118\t\t\t\tunix.Close(child)\n   119\t\t\t\treturn errReviewGoBuildChanged\n   120\t\t\t}\n   121\t\t\terr = removeReviewGoBuildContents(child, depth+1, budget)\n   122\t\t\tunix.Close(child)\n   123\t\t\tif err != nil {\n   124\t\t\t\treturn err\n   125\t\t\t}\n   126\t\t\tif err := unix.Unlinkat(dfd, name, unix.AT_REMOVEDIR); err != nil {\n   127\t\t\t\treturn fmt.Errorf(\"runtime cleanup incomplete; resources retained\")\n   128\t\t\t}\n   129\t\t}\n   130\t\treturn nil\n   131\t}\n     1\t//go:build !unix\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport \"os\"\n     6\t\n     7\t// removeReviewGoBuildDir has no descriptor-relative removal on this\n     8\t// platform: the go-build directory is left to the runtime inventory, which\n     9\t// keeps the cleanup incomplete when it exceeds its bounds (spec\n    10\t// pose-review-cleanup-removes-go-build-leftovers).\n    11\tfunc removeReviewGoBuildDir(*os.Root, string) error { return nil }\n    12\t\n    13\tvar (\n    14\t\t_ = reviewGoBuildBeforeOpen\n    15\t\t_ = reviewGoBuildAfterContents\n    16\t\t_ = reviewGoBuildBeforeRemove\n    17\t)\nrg: .pose/review-bundles/rvb-249f4597d714e0f4.json: No such file or directory (os error 2)\n.pose/results/delivery-validation.json:31:    \"pose-abm-structural-delta\": \"sha256:636d1a67de7238315f37d36e363357fd44e7539a7eb4304a98ba91ff96cb8998\",\n.pose/results/delivery-validation.json:167:    \"pose-design-delta-batched-git-reads\": \"sha256:14342934733c748eec17aff7849f968785f0e8b8c98ae7803531db82ecae0f0e\",\n.pose/results/delivery-validation.json:405:    \"pose-structural-facts-stay-in-their-commits\": \"sha256:ecd3d9eb0e5035bc5b03980d7644b99965ca4089ae4610e2380e60fca89c19a5\",\n.pose/results/delivery-validation.json:491:    \"pose-abm-structural-delta\": \"sha256:c9202bfb58fa7d502f817071a31c7197d473ed24b2199f1827a8f3101a866d98\",\n.pose/results/delivery-validation.json:627:    \"pose-design-delta-batched-git-reads\": \"sha256:6b2e7439b4ccf485c