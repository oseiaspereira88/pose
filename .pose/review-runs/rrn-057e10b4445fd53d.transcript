nal/pose/closeout_review_policy_test.go:226:func TestCloseoutReviewPolicyAssociations(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:295:func TestCloseoutReviewPolicyProtection(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:366:func TestCloseoutReviewPolicyVeto(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:387:func TestCloseoutReviewPolicyReceipt(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:447:func TestCloseoutReviewPolicyHistory(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:475:func TestCloseoutReviewPolicyUnavailable(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:508:func TestCloseoutReviewPolicyFederation(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:535:func TestCloseoutReviewPolicyReceiptIntegrity(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:575:func TestCloseoutReviewPolicyInterruptedRoadmapClose(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:605:func TestCloseoutReviewPolicyRecoveryKeepsTheVeto(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:621:func TestCloseoutReviewPolicyFederatedReceiptProof(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:663:func TestCloseoutReviewPolicyStatusAloneIsNotHistory(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:677:func TestCloseoutReviewPolicyRoundTwo(t *testing.T) {\n","exit_code":0,"status":"completed"}}
