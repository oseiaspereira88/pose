{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '630,705p' pose-mcp/internal/pose/obligation_projection.go\"","aggregated_output":"\t\t\t\to.Category = ObligationJudgment\n\t\t\t\to.ReasonCode = firstNonempty(p.Code, \"judgment-unanswered\")\n\t\t\t\to.Condition = firstNonempty(p.Condition, DiagnosticCatalog[\"judgment-unanswered\"].Condition)\n\t\t\t\to.Recipient = ObligationActor{Role: \"reviewer\"}\n\t\t\t\to.Effects = []ObligationEffect{{Phase: PhaseCloseout, Mode: EffectBlock}}\n\t\t\t\to.Waiting = WaitingActor\n\t\t\t\to.Message = sp.Slug + \": criterion \" + p.Criterion + \" needs a reviewer's conclusion (\" + p.Reason + \")\"\n\t\t\t\tout = append(out, o)\n\t\t\t}\n\t\t}\n\t\treturn out, nil\n\t})\n}\n\n// milestoneReachedObligations projects the milestones that can be closed. The\n// rule restricts nothing: a reached milestone waits for an operator to close it,\n// and the roadmap's own close refuses it anyway. What cannot be read leaves the\n// producer's coverage incomplete and never reads as reached.\nfunc (s Store) milestoneReachedObligations(project, scope string, coverage *Coverage) ([]Obligation, error) {\n\tlost := func(err error) ([]Obligation, error) {\n\t\tmarkCoverageIncomplete(coverage, \"reached milestones could not be read: \"+err.Error())\n\t\treturn nil, nil\n\t}\n\tspec, within := \"\", scope\n\tif ref, err := ParseScopeRef(scope); scope != \"\" && err == nil && ref.Kind == \"spec\" {\n\t\tspec, within = ref.Slug, \"\"\n\t}\n\tcandidates, err := s.milestonesWithTerminalMembers(spec, within)\n\tif err != nil {\n\t\treturn lost(err)\n\t}\n\trecorded, refused, err := s.milestonesWithRecordedApproval(append(candidates, s.soleMemberRefs(candidates)...))\n\tif err != nil {\n\t\treturn lost(err)\n\t}\n\tpolicy, _, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn lost(err)\n\t}\n\tvar out []Obligation\n\tfor _, ref := range candidates {\n\t\tparsed, err := ParseScopeRef(ref)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\trequired, err := s.reviewRequiredForScope(parsed, policy)\n\t\tif err != nil {\n\t\t\treturn lost(err)\n\t\t}\n\t\tif policy.CloseoutReviewAdopted() {\n\t\t\t// Under an adopted closeout review policy a reached milestone is\n\t\t\t// closed only by its explicit close, which publishes a receipt,\n\t\t\t// approved review or not (spec pose-closeout-review-policy-by-cost-benefit).\n\t\t\tclosed, err := s.closedByReceipt(ref)\n\t\t\tif err != nil {\n\t\t\t\treturn lost(err)\n\t\t\t}\n\t\t\tif closed {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t} else {\n\t\t\tmember, sole := s.soleMemberOf(parsed)\n\t\t\towed := !recorded[ref] && !(sole && recorded[\"spec:\"+member]) && s.declaredUnreviewed(parsed) == \"\"\n\t\t\tif !required || !owed && !refused[ref] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tsource := QualifyNodeRef(project, ArtifactRef{Kind: \"milestone\", Slug: parsed.Roadmap, Milestone: parsed.Milestone}, \"\", \"\")\n\t\to := newObligation(project, \"closeout\", source, \"milestone-reached\", ref)\n\t\to.Category = ObligationReconciliation\n\t\to.ReasonCode = \"milestone-reached\"\n\t\to.Condition = DiagnosticCatalog[\"milestone-reached\"].Condition\n\t\to.Effects = []ObligationEffect{{Phase: PhaseCloseout, Mode: EffectAdvisory}}\n\t\to.Waiting = WaitingActor\n\t\to.Message = ref + \" is reached: pose close \" + ref\n\t\tout = append(out, o)\n","exit_code":0,"status":"completed"}}
