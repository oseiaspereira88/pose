{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '3450,3545p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"// owes no review of its own: one made of a single closed, approved spec, or one a roadmap\n// declares. Every reader of an approval comes through here, so they give one answer (ADR\n// a-milestone-of-one-member-is-that-member). A negative review recorded on it stands.\nfunc (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerification, error) {\n\town, err := s.computeReviewVerification(scope)\n\tif err != nil || own.Approved {\n\t\treturn own, err\n\t}\n\tref, parseErr := ParseScopeRef(scope)\n\tif parseErr != nil || (ref.Kind != \"milestone\" && ref.Kind != \"roadmap\") {\n\t\treturn own, nil\n\t}\n\t// A policy without bundles answers through its review attempts alone, and has no\n\t// bundle of the spec to stand on.\n\tpolicy, err := s.GetReviewPolicy()\n\tif err != nil || !policy.ReviewBundles {\n\t\treturn own, nil\n\t}\n\tif s.milestoneReviewRefused(scope) {\n\t\treturn own, nil\n\t}\n\t// An adopted closeout review policy is the only rule for an open scope:\n\t// legacy inheritance and declared exemptions cannot weaken `always`, and\n\t// the policy's own exemption reads the same gate as reviewCheck. A roadmap\n\t// closed before adoption keeps the legacy reading below.\n\tadopted := policy.CloseoutReviewAdopted() && !s.closeoutScopeHistorical(ref)\n\tif adopted {\n\t\tdecision, exempt, gateErr := s.closeoutReviewGate(scope, policy)\n\t\tif gateErr != nil || decision == nil || !exempt || !decision.Known {\n\t\t\treturn own, nil\n\t\t}\n\t\tif ref.Kind == \"milestone\" && s.FederatedResolver != nil {\n\t\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n\t\t\tif err != nil || !acceptance.Ready {\n\t\t\t\treturn own, nil\n\t\t\t}\n\t\t}\n\t\treturn ReviewBundleVerification{\n\t\t\tScope: scope, State: \"closed\", Fresh: true, Approved: true, NextAction: \"none\",\n\t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n\t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n\t\t}, nil\n\t}\n\tif ref.Kind != \"milestone\" {\n\t\treturn own, nil\n\t}\n\t// Edges still bind: a milestone inherits a review, not the acceptance of what it\n\t// depends on, and revoked trust or an open predecessor leaves it where it was.\n\tif s.FederatedResolver != nil {\n\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n\t\tif err != nil || !acceptance.Ready {\n\t\t\treturn own, nil\n\t\t}\n\t}\n\tif member, ok := s.soleMemberOf(ref); ok {\n\t\tchild, err := s.verifyReviewBundle(\"spec:\" + member)\n\t\tif err == nil && child.State == \"closed\" && child.Fresh && child.Approved {\n\t\t\treturn ReviewBundleVerification{\n\t\t\t\tScope: scope, State: \"closed\", Bundle: child.Bundle, Attestation: child.Attestation, Fresh: true, Approved: true,\n\t\t\t\tNextAction: \"none\", Warnings: []string{\"the approval of \" + scope + \" is inherited from spec:\" + member + \", its only member\"},\n\t\t\t\tApprovalOrigin: \"inherited:spec:\" + member, inherited: true,\n\t\t\t}, nil\n\t\t}\n\t}\n\tif reason := s.declaredUnreviewed(ref); reason != \"\" {\n\t\treturn ReviewBundleVerification{\n\t\t\tScope: scope, State: \"closed\", Fresh: true, Approved: true, NextAction: \"none\",\n\t\t\tWarnings:       []string{scope + \" stands without a review, as its roadmap declares: \" + reason},\n\t\t\tApprovalOrigin: \"declared:roadmap:\" + ref.Roadmap, inherited: true,\n\t\t}, nil\n\t}\n\treturn own, nil\n}\n\n// milestoneReviewRefused reports a refusal recorded on the milestone itself, in a bundle\n// or in a legacy attempt.\nfunc (s Store) milestoneReviewRefused(scope string) bool {\n\tif bundle, _ := s.latestNegativeReview(scope); bundle != nil {\n\t\treturn true\n\t}\n\tattempts, err := s.ReadReviewAttempts(scope)\n\tif err != nil || !attempts.Coverage.CompleteFor(scope) {\n\t\treturn true\n\t}\n\tif len(attempts.Attempts) == 0 {\n\t\treturn false\n\t}\n\tlatest := attempts.Attempts[len(attempts.Attempts)-1]\n\treturn latest.Decision == \"rejected\" || latest.Decision == \"changes-requested\"\n}\n\nfunc (s Store) computeReviewVerification(scope string) (ReviewBundleVerification, error) {\n\tpolicy, err := s.GetReviewPolicy()\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n","exit_code":0,"status":"completed"}}
