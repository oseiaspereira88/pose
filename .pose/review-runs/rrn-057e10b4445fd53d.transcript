{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2..9d495d5 -- pose-mcp/internal/cli/review_closeout.go pose-mcp/internal/pose/review_closeout.go'","aggregated_output":"diff --git a/pose-mcp/internal/cli/review_closeout.go b/pose-mcp/internal/cli/review_closeout.go\nindex 5339f00a..95be9cc1 100644\n--- a/pose-mcp/internal/cli/review_closeout.go\n+++ b/pose-mcp/internal/cli/review_closeout.go\n@@ -1953,11 +1953,19 @@ func cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref strin\n \t\tout.Failure(fmt.Sprintf(\"pose close: %d action request(s) restrict closeout of %s\", len(governed), ref))\n \t\treturn 1\n \t}\n-\tif !state.Review.Approved || len(state.Children) > 0 && hasOpenChild(state.Children) {\n+\tscope, _ := posemodel.ParseScopeRef(ref)\n+\t// Under an adopted closeout review policy (spec\n+\t// pose-closeout-review-policy-by-cost-benefit) the close of a milestone or a\n+\t// roadmap publishes a receipt. A receipt already there makes the close a\n+\t// read-only verification; a scope the evaluator cannot decide is refused.\n+\treceiptClose, code := closeoutReceiptPreflight(store, ref, scope, &state, stdout, stderr)\n+\tif code >= 0 {\n+\t\treturn code\n+\t}\n+\tif !closeReviewSatisfied(state) || len(state.Children) > 0 && hasOpenChild(state.Children) {\n \t\tfmt.Fprintf(stderr, \"pose close: scope is not eligible; next action: %s\\n\", state.NextAction)\n \t\treturn 1\n \t}\n-\tscope, _ := posemodel.ParseScopeRef(ref)\n \tif scope.Kind == \"milestone\" {\n \t\tgate, err := roadmapGate(root, scope.Roadmap, scope.Milestone)\n \t\tif err != nil {\n@@ -1968,7 +1976,18 @@ func cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref strin\n \t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + strings.Join(blockers, \"; \"))\n \t\t\treturn 1\n \t\t}\n-\t\tfmt.Fprintf(stdout, \"Milestone closeout verified: %s\\n\", ref)\n+\t\tlabel := \"Milestone closeout verified\"\n+\t\tif receiptClose != nil {\n+\t\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, guard, stderr)\n+\t\t\tif code != 0 {\n+\t\t\t\treturn code\n+\t\t\t}\n+\t\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, judgedState, stdout, stderr); code != 0 {\n+\t\t\t\treturn code\n+\t\t\t}\n+\t\t\tlabel = \"Closed\"\n+\t\t}\n+\t\tfmt.Fprintf(stdout, \"%s: %s\\n\", label, ref)\n \t\trenderCloseNext(render(stdout, stderr), nextCloses(store, ref))\n \t\treturn 0\n \t}\n@@ -2061,7 +2080,7 @@ func cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref strin\n \tif current, err := cliCloseoutStateForStore(store, ref); err != nil {\n \t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n \t\treturn 1\n-\t} else if !current.Review.Approved || hasActionRequestPending(current.Diagnostics) || hasDiagnostic(current.Diagnostics, posemodel.AdjudicationDoesNotHoldCode) {\n+\t} else if !(closeReviewSatisfied(current) || receiptClose != nil && !receiptClose.Required) || hasActionRequestPending(current.Diagnostics) || hasDiagnostic(current.Diagnostics, posemodel.AdjudicationDoesNotHoldCode) {\n \t\trender(io.Discard, stderr).Failure(\"pose close: the closeout authorization changed while its gates ran; next action: \" + current.NextAction)\n \t\treturn 1\n \t}\n@@ -2082,6 +2101,23 @@ func cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref strin\n \t\t\treturn 1\n \t\t}\n \t}\n+\tvar receiptState posemodel.CloseoutState\n+\tif receiptClose != nil {\n+\t\t// Judged before the status is published: afterwards the index no\n+\t\t// longer matches the tree until it is regenerated.\n+\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, nil, stderr)\n+\t\tif code != 0 {\n+\t\t\treturn code\n+\t\t}\n+\t\treceiptState = judgedState\n+\t\t// The intent stands from before the status until the receipt: an\n+\t\t// interruption between them reads as an incomplete close, never as\n+\t\t// a roadmap closed before adoption.\n+\t\tif err := store.PublishCloseoutIntent(ref, *receiptClose, time.Now()); err != nil {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: closeout intent not recorded: \" + err.Error())\n+\t\t\treturn 1\n+\t\t}\n+\t}\n \tvar unsynced error\n \tif err := applyLifecycleDoneIn(store.FS, path, scope.Kind == \"spec\", judged); err != nil {\n \t\tif errors.Is(err, posemodel.ErrPublishConflict) {\n@@ -2097,6 +2133,14 @@ func cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref strin\n \t\tunsynced = err\n \t\trender(stdout, stderr).Field(\"close.unsynced\", err.Error())\n \t}\n+\tif receiptClose != nil {\n+\t\t// The status is published; the receipt is the terminal marker and\n+\t\t// comes after it. A failure here leaves the roadmap explicitly\n+\t\t// incomplete, and the next `pose close` verifies again and publishes.\n+\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, receiptState, stdout, stderr); code != 0 {\n+\t\t\treturn code\n+\t\t}\n+\t}\n \tif transitioned != nil {\n \t\ttransitioned(unsynced)\n \t}\n@@ -2383,3 +2427,151 @@ func hasActionRequestPending(diagnostics []posemodel.Diagnostic) bool {\n // before the protected region. Only tests set it, to change the repository\n // at that point.\n var closeGatesJudged func()\n+\n+// closeReviewSatisfied is the review half of close eligibility: an approval,\n+// or a review the adopted closeout review policy does not require.\n+func closeReviewSatisfied(state posemodel.CloseoutState) bool {\n+\treturn state.Review.Approved || state.Review.CloseoutReview != nil && !state.Review.Required\n+}\n+\n+// closeoutReceiptPreflight decides whether this close publishes a receipt.\n+// It returns the decision to record (nil: legacy close) and an exit code, or\n+// -1 to go on. A receipt already there makes the close a verification of the\n+// current terminal contract. A done roadmap with no receipt is the incomplete\n+// case: its decision is taken again over the current inputs, under the same\n+// rules as an open scope, so a recorded rejection is never closed over.\n+func closeoutReceiptPreflight(store posemodel.Store, ref string, scope posemodel.ScopeRef, state *posemodel.CloseoutState, stdout, stderr io.Writer) (*posemodel.CloseoutReviewDecision, int) {\n+\tif scope.Kind != \"milestone\" && scope.Kind != \"roadmap\" {\n+\t\treturn nil, -1\n+\t}\n+\tpolicy, err := store.GetReviewPolicy()\n+\tif err != nil {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n+\t\treturn nil, 1\n+\t}\n+\tif !policy.CloseoutReviewAdopted() {\n+\t\treturn nil, -1\n+\t}\n+\tif state.CloseoutReceipt != nil {\n+\t\tif !state.Terminal {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n+\t\t\treturn nil, 1\n+\t\t}\n+\t\treceipt := state.CloseoutReceipt\n+\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; closeout receipt of \"+receipt.ClosedAt+\" stands (review: \"+receipt.Review+\"); applicable terminal verifier passed; no transition executed\")\n+\t\treturn nil, 0\n+\t}\n+\tdecision := state.Review.CloseoutReview\n+\tif decision == nil {\n+\t\tif scope.Kind != \"roadmap\" || !state.LifecycleDone {\n+\t\t\treturn nil, -1\n+\t\t}\n+\t\trecovered, exempt, err := store.CloseoutRecoveryDecision(ref)\n+\t\tif err != nil {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n+\t\t\treturn nil, 1\n+\t\t}\n+\t\tif recovered.Required && !state.Review.Approved {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + ref + \" is done without a receipt and owes an approved review (\" + recovered.PolicyKey + \"=\" + recovered.PolicyValue + \", \" + recovered.Reason + \"); next action: \" + state.NextAction)\n+\t\t\treturn nil, 1\n+\t\t}\n+\t\tif !recovered.Required && !exempt && !state.Review.Approved {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + ref + \" has a review on file that is not approved; it stands until remediated\")\n+\t\t\treturn nil, 1\n+\t\t}\n+\t\tdecision = &recovered\n+\t\tif exempt {\n+\t\t\tstate.Review.CloseoutReview, state.Review.Required = decision, false\n+\t\t}\n+\t}\n+\tif !decision.Known {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout review of \" + ref + \" cannot be decided: \" + strings.Join(decision.Diagnostics, \"; \"))\n+\t\treturn nil, 1\n+\t}\n+\t// An exemption replaces the review's approval, not the other gates: a\n+\t// scope with any blocker, an unknown read view included, does not close.\n+\tif !decision.Required && len(state.Blockers) > 0 && !onlyLifecycleBlockers(state.Blockers) {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: \" + ref + \" is not eligible: \" + strings.Join(state.Blockers, \"; \"))\n+\t\treturn nil, 1\n+\t}\n+\trender(stdout, stderr).Field(\"close.review\", decision.Review()+\" (\"+decision.PolicyKey+\"=\"+decision.PolicyValue+\", \"+decision.Reason+\")\")\n+\treturn decision, -1\n+}\n+\n+// verifyCloseoutPublication judges the whole authorization once more inside\n+// the protected region: the same protected decision, the same members and\n+// associations, and a closeout state still eligible. It returns that state,\n+// which the receipt is built from.\n+func verifyCloseoutPublication(store posemodel.Store, ref string, decision posemodel.CloseoutReviewDecision, guard func() error, stderr io.Writer) (posemodel.CloseoutState, int) {\n+\tif guard != nil {\n+\t\tif err := guard(); err != nil {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n+\t\t\treturn posemodel.CloseoutState{}, 1\n+\t\t}\n+\t}\n+\tchanged := func(why string) (posemodel.CloseoutState, int) {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout of \" + ref + \" changed while its gates ran (\" + why + \"); run `pose close \" + ref + \"` again\")\n+\t\treturn posemodel.CloseoutState{}, 1\n+\t}\n+\tcurrent, err := store.CurrentCloseoutDecision(ref)\n+\tif err != nil {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n+\t\treturn posemodel.CloseoutState{}, 1\n+\t}\n+\tif current.Required != decision.Required || current.Known != decision.Known || current.PolicyValue != decision.PolicyValue ||\n+\t\tstrings.Join(current.Members, \",\") != strings.Join(decision.Members, \",\") || strings.Join(current.ADRs, \",\") != strings.Join(decision.ADRs, \",\") {\n+\t\treturn changed(\"the review decision differs\")\n+\t}\n+\tstate, err := cliCloseoutStateForStore(store, ref)\n+\tif err != nil {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n+\t\treturn posemodel.CloseoutState{}, 1\n+\t}\n+\tif state.CloseoutReceipt != nil {\n+\t\treturn changed(\"a receipt was published meanwhile\")\n+\t}\n+\tif decision.Required && !state.Review.Approved {\n+\t\treturn changed(\"the required review is no longer approved\")\n+\t}\n+\tif !decision.Required && state.Review.Required && !state.LifecycleDone {\n+\t\treturn changed(\"the review is required again\")\n+\t}\n+\tif len(state.Blockers) > 0 && !onlyLifecycleBlockers(state.Blockers) {\n+\t\treturn changed(strings.Join(state.Blockers, \"; \"))\n+\t}\n+\treturn state, 0\n+}\n+\n+// publishCloseoutReceipt publishes the receipt of a close from the state the\n+// protected region judged, then removes the close's intent.\n+func publishCloseoutReceipt(store posemodel.Store, ref string, decision posemodel.CloseoutReviewDecision, judged posemodel.CloseoutState, stdout, stderr io.Writer) int {\n+\treceipt, err := store.NewCloseoutReceipt(ref, decision, judged.Review, judged.ScopeDigest, time.Now())\n+\tif err != nil {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n+\t\treturn 1\n+\t}\n+\tif err := store.PublishCloseoutReceipt(receipt); err != nil {\n+\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n+\t\t\trender(stdout, stderr).Field(\"close.unsynced\", err.Error())\n+\t\t} else {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: closeout receipt not published: \" + err.Error() + \"; `pose close \" + ref + \"` verifies again and publishes it\")\n+\t\t\treturn 1\n+\t\t}\n+\t}\n+\tif err := store.ClearCloseoutIntent(ref); err != nil {\n+\t\trender(stdout, stderr).Field(\"close.intent\", \"the receipt stands; its intent record could not be removed: \"+err.Error())\n+\t}\n+\trender(stdout, stderr).Field(\"close.receipt\", \"review: \"+receipt.Review+\"; \"+decision.PolicyKey+\"=\"+decision.PolicyValue+\"; \"+decision.Reason)\n+\treturn 0\n+}\n+\n+// onlyLifecycleBlockers reports blockers that only say the roadmap's status\n+// is not done yet: the receipt is published right after that status.\n+func onlyLifecycleBlockers(blockers []string) bool {\n+\tfor _, blocker := range blockers {\n+\t\tif blocker != \"lifecycle status is not done\" {\n+\t\t\treturn false\n+\t\t}\n+\t}\n+\treturn true\n+}\ndiff --git a/pose-mcp/internal/pose/review_closeout.go b/pose-mcp/internal/pose/review_closeout.go\nindex 8c4bfe79..c9bf55e5 100644\n--- a/pose-mcp/internal/pose/review_closeout.go\n+++ b/pose-mcp/internal/pose/review_closeout.go\n@@ -29,6 +29,13 @@ const QualifiedArtifactPolicySchemaVersion = 3\n // refused by older engines so they cannot silently operate on transfer state.\n const SpecAuthorityTransferPolicySchemaVersion = 4\n \n+// CloseoutReviewPolicySchemaVersion carries milestone_review_required and\n+// roadmap_review_required (spec pose-closeout-review-policy-by-cost-benefit).\n+// Older engines refuse it, so none of them reads an adopted exemption as the\n+// legacy rule. It decouples the schema number from qualified references and\n+// authority transfer: both stay optional under it.\n+const CloseoutReviewPolicySchemaVersion = 5\n+\n // ScopeRef is the canonical address of a reviewable POSE scope.\n type ScopeRef struct {\n \tKind      string `json:\"kind\"`\n@@ -247,6 +254,13 @@ type ReviewPolicy struct {\n \t// pose-authority-claim-project-is-not-the-audience). Like the audience it is\n \t// read from the protected policy, never from the environment.\n \tAuthorityProject string `json:\"authority_project,omitempty\"`\n+\t// MilestoneReviewRequired and RoadmapReviewRequired decide whether the close\n+\t// of an aggregate scope owes its own independent review: never,\n+\t// when-justified or always. Both are present exactly under schema 5; an\n+\t// older schema keeps the legacy rule (ADR\n+\t// closeout-review-policy-by-cost-and-benefit).\n+\tMilestoneReviewRequired string `json:\"milestone_review_required,omitempty\"`\n+\tRoadmapReviewRequired   string `json:\"roadmap_review_required,omitempty\"`\n }\n \n // ReviewIdentityAssurance resolves the assurance a scope kind requires,\n@@ -412,6 +426,13 @@ type ReviewEvaluation struct {\n \tBundleDigest  string         `json:\"bundle_digest,omitempty\"`\n \tAttestationID string         `json:\"attestation_id,omitempty\"`\n \tBundleState   string         `json:\"bundle_state,omitempty\"`\n+\t// ApprovalOrigin names where an approval not attested on the scope itself\n+\t// came from: an inherited member, a roadmap declaration, or\n+\t// not-required:<key>=<value> under an adopted closeout review policy.\n+\tApprovalOrigin string `json:\"approval_origin,omitempty\"`\n+\t// CloseoutReview is the closeout-review@1 decision for an aggregate scope\n+\t// under an adopted policy (spec pose-closeout-review-policy-by-cost-benefit).\n+\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n \t// Assurance discloses what the current review record proves about its\n \t// reviewer (spec pose-review-assurance-disclosure).\n \tAssurance *ReviewAssurance `json:\"assurance,omitempty\"`\n@@ -445,6 +466,12 @@ type CloseoutState struct {\n \t// NextStep is NextAction as a code and refs, for a consumer that must not\n \t// parse the sentence.\n \tNextStep *Diagnostic `json:\"next_step,omitempty\"`\n+\t// CloseoutReceipt is the receipt an explicit close published under an\n+\t// adopted closeout review policy; CloseRequired says the scope is\n+\t// eligible but still owes that close (spec\n+\t// pose-closeout-review-policy-by-cost-benefit R4).\n+\tCloseoutReceipt *CloseoutReceipt `json:\"closeout_receipt,omitempty\"`\n+\tCloseRequired   bool             `json:\"close_required,omitempty\"`\n }\n \n func withGovernanceReviewReadView[T any](s Store, producer string, run func(Store) (T, error), attach func(*T, *ReadViewMetadata, governanceReadViewAudit)) (T, error) {\n@@ -667,8 +694,17 @@ func (s Store) parseReviewPolicy(raw []byte) (ReviewPolicy, error) {\n \tif err := ValidateDelegationAdoptionDate(p.DelegatedReviewDisabledAt); err != nil {\n \t\treturn ReviewPolicy{}, err\n \t}\n+\tif err := validateCloseoutReviewPolicyKeys(raw, fields, p.SchemaVersion); err != nil {\n+\t\treturn ReviewPolicy{}, err\n+\t}\n \tqualifiedRefsRequired := p.SchemaVersion == QualifiedArtifactPolicySchemaVersion || p.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion\n-\tif (qualifiedRefsRequired && p.QualifiedArtifactRefsVersion != 1) || (!qualifiedRefsRequired && p.QualifiedArtifactRefsVersion != 0) {\n+\tif p.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n+\t\t// Schema 5 recognizes the closeout pair without adopting references or\n+\t\t// transfer: each stays at 0, or 1 as the earlier schemas define it.\n+\t\tif p.QualifiedArtifactRefsVersion != 0 && p.QualifiedArtifactRefsVersion != 1 {\n+\t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: unsupported qualified_artifact_refs_version %d\", p.QualifiedArtifactRefsVersion)\n+\t\t}\n+\t} else if (qualifiedRefsRequired && p.QualifiedArtifactRefsVersion != 1) || (!qualifiedRefsRequired && p.QualifiedArtifactRefsVersion != 0) {\n \t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: qualified artifact references require review policy schema 3 and qualified_artifact_refs_version 1\")\n \t}\n \tif p.CausalityCloseoutVersion != 0 && p.CausalityCloseoutVersion != CausalityCloseoutPolicyVersion {\n@@ -705,7 +741,14 @@ func (s Store) parseReviewPolicy(raw []byte) (ReviewPolicy, error) {\n \tif p.ContractNodesVersion != 0 && p.ContractNodesVersion != ContractNodesPolicyVersion {\n \t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: unsupported contract_nodes_version %d (engine supports %d)\", p.ContractNodesVersion, ContractNodesPolicyVersion)\n \t}\n-\tif (p.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion && p.SpecAuthorityTransferVersion != 1) || (p.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && p.SpecAuthorityTransferVersion != 0) {\n+\tif p.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n+\t\tif p.SpecAuthorityTransferVersion != 0 && p.SpecAuthorityTransferVersion != 1 {\n+\t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: unsupported spec_authority_transfer_version %d\", p.SpecAuthorityTransferVersion)\n+\t\t}\n+\t\tif p.SpecAuthorityTransferVersion == 1 && p.QualifiedArtifactRefsVersion != 1 {\n+\t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: spec authority transfer requires qualified_artifact_refs_version 1\")\n+\t\t}\n+\t} else if (p.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion && p.SpecAuthorityTransferVersion != 1) || (p.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && p.SpecAuthorityTransferVersion != 0) {\n \t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: spec authority transfer requires review policy schema 4 and spec_authority_transfer_version 1\")\n \t}\n \tif p.SchemaVersion >= ReviewPolicySchemaVersion {\n@@ -719,7 +762,7 @@ func (s Store) parseReviewPolicy(raw []byte) (ReviewPolicy, error) {\n \t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: invalid schema-v2 review policy: %w\", err)\n \t\t}\n \t}\n-\tif p.SchemaVersion != ReviewSchemaVersion && p.SchemaVersion != ReviewPolicySchemaVersion && p.SchemaVersion != QualifiedArtifactPolicySchemaVersion && p.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion {\n+\tif p.SchemaVersion != ReviewSchemaVersion && p.SchemaVersion != ReviewPolicySchemaVersion && p.SchemaVersion != QualifiedArtifactPolicySchemaVersion && p.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && p.SchemaVersion != CloseoutReviewPolicySchemaVersion {\n \t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: unsupported review policy schema %d\", p.SchemaVersion)\n \t}\n \tif err := validateReviewPolicyScopes(\"identity_assurance\", p.IdentityAssurance); err != nil {\n@@ -1477,15 +1520,40 @@ func (s Store) reviewCheck(ref string) (ReviewEvaluation, error) {\n \t\treturn ReviewEvaluation{}, err\n \t}\n \teval := ReviewEvaluation{Scope: ref, ScopeDigest: digest, PolicyEnabled: policy.Enabled, Required: policy.Enabled, Fresh: false, Approved: false, Blockers: []string{}}\n-\tif !policy.Enabled {\n+\t// An adopted closeout review policy decides an aggregate scope before the\n+\t// legacy shortcuts: neither enabled=false nor an adoption cutoff weakens\n+\t// what it requires (spec pose-closeout-review-policy-by-cost-benefit).\n+\tdecision, exempt, err := s.closeoutReviewGate(ref, policy)\n+\tif err != nil {\n+\t\treturn eval, err\n+\t}\n+\teval.CloseoutReview = decision\n+\tif decision != nil {\n+\t\tif exempt {\n+\t\t\teval.Required = false\n+\t\t\teval.Fresh = true\n+\t\t\teval.ApprovalOrigin = closeoutApprovalOrigin(*decision)\n+\t\t\teval.Warnings = append(eval.Warnings, closeoutExemptionWarning(ref, *decision))\n+\t\t\treturn eval, nil\n+\t\t}\n+\t\teval.Required = true\n+\t\tif !decision.Known {\n+\t\t\teval.Blockers = append(eval.Blockers, decision.Diagnostics...)\n+\t\t\treturn eval, nil\n+\t\t}\n+\t}\n+\tif !policy.Enabled && decision == nil {\n \t\teval.Warnings = append(eval.Warnings, \"review policy is absent or disabled; closeout review is not enforced\")\n \t\treturn eval, nil\n \t}\n \tprofileRef := policy.Profiles[scope.Kind]\n \teval.Profile = profileRef\n-\trequired, err := s.reviewRequiredForScope(scope, policy)\n-\tif err != nil {\n-\t\treturn eval, err\n+\trequired := true\n+\tif decision == nil {\n+\t\trequired, err = s.reviewRequiredForScope(scope, policy)\n+\t\tif err != nil {\n+\t\t\treturn eval, err\n+\t\t}\n \t}\n \teval.Required = required\n \tif !required {\n@@ -2725,6 +2793,28 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t}\n \t\t}\n \t}\n+\tcloseOwed := false\n+\tif scope.Kind == \"milestone\" || scope.Kind == \"roadmap\" {\n+\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil && policy.CloseoutReviewAdopted() {\n+\t\t\treceipt, receiptErr := s.ReadCloseoutReceipt(ref)\n+\t\t\tif receiptErr != nil {\n+\t\t\t\tblock(OpaqueDiagnostic(\"closeout-receipt-invalid\", DiagnosticCloseout, receiptErr.Error()))\n+\t\t\t}\n+\t\t\tstate.CloseoutReceipt = receipt\n+\t\t\tif decision := review.CloseoutReview; decision != nil && receipt == nil && receiptErr == nil {\n+\t\t\t\t// Terminal members make the scope eligible, never closed: the\n+\t\t\t\t// explicit close publishes the receipt that makes it terminal.\n+\t\t\t\tcloseOwed = true\n+\t\t\t\tfor _, diagnostic := range decision.Diagnostics {\n+\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", diagnostic, ref))\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif review.CloseoutReview == nil && receipt == nil && scope.Kind == \"roadmap\" && state.LifecycleDone && review.Required && !review.Approved {\n+\t\t\t\tdiagnostics = append(diagnostics, NewDiagnostic(\"closeout-receipt-incomplete\", \"roadmap \"+scope.Slug+\" is done with neither an approved review nor a closeout receipt; `pose close \"+ref+\"` verifies its inputs again and publishes the receipt\", ref))\n+\t\t\t}\n+\t\t}\n+\t}\n+\tstate.CloseRequired = closeOwed\n \tif !review.Required {\n \t\tstate.Blockers = removeReviewOnlyBlockers(state.Blockers)\n \t\tkept := diagnostics[:0]\n@@ -2757,7 +2847,7 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t}\n \t}\n \tstate.Blockers = uniqueSorted(state.Blockers)\n-\tstate.Terminal = len(state.Blocker