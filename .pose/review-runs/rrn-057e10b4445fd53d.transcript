{"type":"item.completed","item":{"id":"item_98","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/schemas/v1/closeout-receipt.schema.json'","aggregated_output":"     1\t{\n     2\t  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n     3\t  \"$id\": \"https://pose.dev/schemas/v1/closeout-receipt.schema.json\",\n     4\t  \"title\": \"POSE closeout receipt of a milestone or roadmap\",\n     5\t  \"description\": \"Published by the explicit `pose close` of an aggregate scope under an adopted closeout review policy (spec pose-closeout-review-policy-by-cost-benefit). Written once; never reinterpreted by a later policy.\",\n     6\t  \"type\": \"object\",\n     7\t  \"additionalProperties\": false,\n     8\t  \"required\": [\"schema_version\", \"scope\", \"closed_at\", \"review\", \"decision\", \"policy_digest\", \"subject_digest\"],\n     9\t  \"properties\": {\n    10\t    \"schema_version\": {\"const\": 1},\n    11\t    \"scope\": {\"$ref\": \"#/$defs/scope\"},\n    12\t    \"closed_at\": {\"type\": \"string\", \"format\": \"date-time\"},\n    13\t    \"review\": {\"enum\": [\"required\", \"not-required\"]},\n    14\t    \"decision\": {\"$ref\": \"#/$defs/decision\"},\n    15\t    \"policy_digest\": {\"type\": \"string\", \"pattern\": \"^sha256:[a-f0-9]{64}$\"},\n    16\t    \"subject_digest\": {\"type\": \"string\", \"pattern\": \"^sha256:[a-f0-9]{64}$\"},\n    17\t    \"review_bundle\": {\"type\": \"string\"},\n    18\t    \"review_attestation\": {\"type\": \"string\"},\n    19\t    \"approval_origin\": {\"type\": \"string\"}\n    20\t  },\n    21\t  \"$defs\": {\n    22\t    \"scope\": {\"type\": \"string\", \"pattern\": \"^roadmap:[a-z0-9][a-z0-9._-]*$|^milestone:[a-z0-9][a-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$\"},\n    23\t    \"decision\": {\n    24\t      \"type\": \"object\",\n    25\t      \"additionalProperties\": false,\n    26\t      \"required\": [\"scope\", \"adopted\", \"required\", \"known\"],\n    27\t      \"properties\": {\n    28\t        \"scope\": {\"$ref\": \"#/$defs/scope\"},\n    29\t        \"adopted\": {\"type\": \"boolean\"},\n    30\t        \"evaluator_version\": {\"const\": \"closeout-review@1\"},\n    31\t        \"policy_key\": {\"enum\": [\"milestone_review_required\", \"roadmap_review_required\"]},\n    32\t        \"policy_value\": {\"enum\": [\"never\", \"when-justified\", \"always\"]},\n    33\t        \"required\": {\"type\": \"boolean\"},\n    34\t        \"known\": {\"type\": \"boolean\"},\n    35\t        \"reason\": {\"type\": \"string\"},\n    36\t        \"members\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"pattern\": \"^xref:[^/]+/spec:[a-z0-9][a-z0-9._-]*$\"}},\n    37\t        \"adr_associations\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"pattern\": \"^[^/\\\\\\\\]+\\\\.md$\"}},\n    38\t        \"diagnostics\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}\n    39\t      }\n    40\t    }\n    41\t  }\n    42\t}\n","exit_code":0,"status":"completed"}}
