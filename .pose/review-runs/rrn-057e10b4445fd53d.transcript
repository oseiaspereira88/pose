{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '2630,2805p' pose-mcp/internal/pose/review_closeout.go\"","aggregated_output":"\tif len(parts) != 2 || !slugPattern.MatchString(parts[0]) || strings.TrimSpace(parts[1]) == \"\" {\n\t\treturn fmt.Errorf(\"invalid review evidence ref %q\", ref)\n\t}\n\tif parts[0] != \"report\" {\n\t\treturn nil\n\t}\n\trel := filepath.Clean(filepath.FromSlash(parts[1]))\n\tif !filepath.IsLocal(rel) {\n\t\treturn fmt.Errorf(\"review evidence path escapes project root: %q\", ref)\n\t}\n\tif !strings.HasPrefix(filepath.ToSlash(rel), \".pose/reports/\") {\n\t\trel = filepath.Join(\".pose\", \"reports\", rel)\n\t}\n\tpath := filepath.Join(root, rel)\n\tif err := validateProjectPathIn(files, root, rel); err != nil {\n\t\treturn fmt.Errorf(\"review evidence path escapes project root: %q: %w\", ref, err)\n\t}\n\tif _, err := files.Stat(path); err != nil {\n\t\treturn fmt.Errorf(\"review evidence does not resolve: %q\", ref)\n\t}\n\treturn nil\n}\n\nfunc (s Store) GetCloseoutState(ref string) (CloseoutState, error) {\n\treturn withGovernanceReviewReadView(s, \"closeout\", func(store Store) (CloseoutState, error) {\n\t\treturn store.getCloseoutState(ref, true)\n\t}, func(state *CloseoutState, metadata *ReadViewMetadata, audit governanceReadViewAudit) {\n\t\tapplyCloseoutReadView(state, metadata, ref, audit)\n\t})\n}\n\nfunc (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutState, error) {\n\ts = s.reviewOperation()\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn CloseoutState{}, err\n\t}\n\treview, err := s.ReviewCheck(ref)\n\tif err != nil {\n\t\treturn CloseoutState{}, err\n\t}\n\tstate := CloseoutState{SchemaVersion: ReviewSchemaVersion, Scope: ref, ScopeDigest: review.ScopeDigest, Review: review, LifecycleDone: true, Blockers: append([]string{}, review.Blockers...)}\n\tstate.VerificationBasis = \"applicable-review-contract\"\n\tif review.BundleID != \"\" {\n\t\tstate.VerificationBasis = \"sealed-review-contract\"\n\t}\n\tif !review.Required {\n\t\tstate.VerificationBasis = \"review-not-required-under-applicable-policy\"\n\t\tstate.Limitations = []string{\"Review is not required under the applicable policy/cutoff; this does not establish a historical execution receipt.\"}\n\t}\n\tvar diagnostics []Diagnostic\n\tfor _, blocker := range review.Blockers {\n\t\tdiagnostics = append(diagnostics, OpaqueDiagnostic(\"review-blocker\", DiagnosticCloseout, blocker))\n\t}\n\tblock := func(d Diagnostic) {\n\t\tdiagnostics = append(diagnostics, d)\n\t\tstate.Blockers = append(state.Blockers, d.Message)\n\t}\n\tchildStore := s\n\t// includeFederated=false already suppresses recursive acceptance. Keep the\n\t// authorized binding: clearing it makes a child borrow its parent's active\n\t// read view under a different Store context.\n\tswitch scope.Kind {\n\tcase \"spec\":\n\t\tsp, err := s.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tstate.LifecycleDone = sp.Status == \"done\"\n\t\t// A question the current bundle's adjudication says does not hold\n\t\t// blocks the closeout as it fails the lint (spec\n\t\t// pose-delegated-verdict-destinations R1; review round 1, B05).\n\t\tfor _, message := range s.adjudicationBlockers(scope.Slug) {\n\t\t\tblock(OpaqueDiagnostic(AdjudicationDoesNotHoldCode, DiagnosticCloseout, message))\n\t\t}\n\t\tif _, findings, historyErr := s.InspectAmendmentHistory(*sp); historyErr != nil {\n\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+historyErr.Error()))\n\t\t\tstate.Limitations = append(state.Limitations, \"Amendment history could not be verified; inspect and repair it explicitly.\")\n\t\t} else {\n\t\t\tfor _, finding := range findings {\n\t\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+finding))\n\t\t\t}\n\t\t}\n\tcase \"milestone\":\n\t\trm, err := s.GetRoadmap(scope.Roadmap)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tvar found bool\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tif milestone.ID != scope.Milestone {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfound = true\n\t\t\tfor _, raw := range milestone.Specs {\n\t\t\t\tslug, external := s.milestoneMember(raw)\n\t\t\t\tif external {\n\t\t\t\t\tif s.FederatedResolver == nil {\n\t\t\t\t\t\tblock(NewDiagnostic(\"external-member-unaccepted\", \"external member \"+raw+\" needs federated acceptance\", raw))\n\t\t\t\t\t}\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tchild, err := childStore.getCloseoutState(\"spec:\"+slug, false)\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn state, err\n\t\t\t\t}\n\t\t\t\tstate.Children = append(state.Children, child)\n\t\t\t\t// A roadmap may declare why a terminal member owes this milestone nothing.\n\t\t\t\tif !child.Terminal && !(review.Approved && s.declaredUnreviewed(scope) != \"\") {\n\t\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\n\t\t\t\t}\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t\tif !found {\n\t\t\treturn state, fmt.Errorf(\"pose: milestone %s/%s not found\", scope.Roadmap, scope.Milestone)\n\t\t}\n\tcase \"roadmap\":\n\t\trm, err := s.GetRoadmap(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tstate.LifecycleDone = rm.Status == \"done\"\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tchild, err := childStore.getCloseoutState(\"milestone:\"+rm.Slug+\"/\"+milestone.ID, false)\n\t\t\tif err != nil {\n\t\t\t\treturn state, err\n\t\t\t}\n\t\t\tstate.Children = append(state.Children, child)\n\t\t\tif !child.Terminal {\n\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\n\t\t\t}\n\t\t}\n\t}\n\tif includeFederated && s.FederatedResolver != nil && (scope.Kind == \"roadmap\" || scope.Kind == \"milestone\") {\n\t\tvar acceptance FederatedRoadmapAcceptanceReport\n\t\tvar err error\n\t\tif scope.Kind == \"milestone\" {\n\t\t\tacceptance, err = s.FederatedMilestoneAcceptance(s.FederatedProjectID, scope.Roadmap, scope.Milestone, *s.FederatedResolver)\n\t\t} else {\n\t\t\tacceptance, err = s.FederatedRoadmapAcceptance(s.FederatedProjectID, scope.Slug, *s.FederatedResolver)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tstate.FederatedAcceptance = &acceptance\n\t\tif !acceptance.Ready {\n\t\t\tfor _, blocker := range acceptance.Blockers {\n\t\t\t\tblock(OpaqueDiagnostic(\"federated-acceptance-blocker\", DiagnosticCloseout, blocker))\n\t\t\t}\n\t\t}\n\t}\n\tif includeFederated && s.FederatedResolver != nil && scope.Kind == \"spec\" {\n\t\tacceptance, applies, err := s.FederatedSpecAcceptance(s.FederatedProjectID, scope.Slug, *s.FederatedResolver)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tif applies {\n\t\t\tstate.FederatedAcceptance = &acceptance\n\t\t\tif !acceptance.Ready {\n\t\t\t\tfor _, blocker := range acceptance.Blockers {\n\t\t\t\t\tblock(OpaqueDiagnostic(\"federated-acceptance-blocker\", DiagnosticCloseout, blocker))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tcloseOwed := false\n\tif scope.Kind == \"milestone\" || scope.Kind == \"roadmap\" {\n\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil && policy.CloseoutReviewAdopted() {\n\t\t\treceipt, receiptErr := s.ReadCloseoutReceipt(ref)\n\t\t\tif receiptErr != nil {\n\t\t\t\tblock(OpaqueDiagnostic(\"closeout-receipt-invalid\", DiagnosticCloseout, receiptErr.Error()))\n\t\t\t}\n\t\t\tstate.CloseoutReceipt = receipt\n\t\t\tif decision := review.CloseoutReview; decision != nil && receipt == nil && receiptErr == nil {\n\t\t\t\t// Terminal members make the scope eligible, never closed: the\n","exit_code":0,"status":"completed"}}
