{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"git diff --stat 0afb81e4dc90d5ebb644db98eaa0b0dcc5a5326f..HEAD -- pose-mcp .pose/indexes/validation-matrix.json; sed -n '700,742p' .pose/review-bundles/rvb-7dfa88290fed19a5.json; sed -n '3290,3337p' pose-mcp/internal/pose/review_bundle.go; cat pose-mcp/internal/pose/operation_result.go | head -85; sed -n '40,68p' pose-mcp/internal/pose/source_coverage.go; rg -n 'func .*withGovernanceReadView|func .*fsys' pose-mcp/internal/pose/{governance_read_view.go,store.go}; rg -n 'ledgerMemo|review-ledger' .pose/assessments/design*\"","aggregated_output":"          \"components\": [\n            \"pose-mcp\"\n          ],\n          \"rationale\": \"matched typed structure selector\"\n        }\n      ],\n      \"structure\": {\n        \"observed\": true,\n        \"status\": \"observed\",\n        \"input_digest\": \"sha256:c0693406841990a9e041fab69474972336aab60137b0ac76c358cbf09a4748c0\",\n        \"subject_digest\": \"sha256:ab98ff61c5c24286f8cd22cab73eee6c86e7890202b9b30262736f5cf649e3e7\",\n        \"kinds\": [\n          \"delivery-metadata\",\n          \"governance-contract\"\n        ],\n        \"material\": [\n          {\n            \"id\": \"SD-16da51ec\",\n            \"kind\": \"delivery-metadata\",\n            \"action\": \"changed\",\n            \"subject\": \".pose/indexes/validation-matrix.json\",\n            \"path\": \".pose/indexes/validation-matrix.json\"\n          },\n          {\n            \"id\": \"SD-55df3a37\",\n            \"kind\": \"governance-contract\",\n            \"action\": \"changed\",\n            \"subject\": \".pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\",\n            \"path\": \".pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\"\n          }\n        ]\n      },\n      \"band\": \"critical\"\n    },\n    \"evidence\": [\n      {\n        \"id\": \"design-c0693406841990a9\",\n        \"check\": \"assess-design\",\n        \"evidence_class\": \"structure\",\n        \"outcome\": \"pass\",\n        \"subject_digest\": \"sha256:ab98ff61c5c24286f8cd22cab73eee6c86e7890202b9b30262736f5cf649e3e7\",\n        \"subject_observation\": \"observed\",\n        \"provenance_digest\": \"sha256:c0693406841990a9e041fab69474972336aab60137b0ac76c358cbf09a4748c0\",\n\t\treturn err\n\t})\n\treturn result, err\n}\n\nfunc (s Store) LoadReviewAttestation(id string) (ReviewAttestation, error) {\n\tif !strings.HasPrefix(id, \"rva-\") || len(id) != 20 {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid review attestation id %q\", id)\n\t}\n\tvar att ReviewAttestation\n\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), false)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tpath := filepath.Join(dir, id+\".json\")\n\tif err := strictJSONFileIn(s.fsys(), path, &att); err != nil {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: reading review attestation %s: %w\", id, err)\n\t}\n\tif att.SchemaVersion != ReviewBundleSchemaVersion || att.AttestationID != id {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: malformed review attestation %s\", id)\n\t}\n\tif reviewAttestationID(att) != id {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation %s content digest mismatch\", id)\n\t}\n\tif _, ok := reviewInstant(att.AttestedAt); !ok {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation %s has no valid attested_at\", id)\n\t}\n\tatt.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", id+\".json\"))\n\treturn att, nil\n}\n\nfunc (s Store) ListReviewAttestations(bundleID string) ([]ReviewAttestation, error) {\n\tread, err := s.ReadReviewAttestations(bundleID)\n\treturn read.Attestations, err\n}\n\n// ReviewAttestationsRead is the attestations a read found and the records it could not\n// read. An attestation that is lost may be the later one, a rejection among them: the\n// last attestation read is the current one only if nothing that concerns the bundle\n// was lost.\ntype ReviewAttestationsRead struct {\n\tAttestations []ReviewAttestation\n\tCoverage     SourceCoverage\n}\n\n// ReadReviewAttestations lists attestations and reports the records it could not read,\n// attributed to the bundle their readable prefix names. With a bundle, a record that\n// names another bundle is not a loss for this one; one that names none is, because it may\npackage pose\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n)\n\n// OperationResult is the result of an operation that runs steps or can wait\n// (spec pose-cli-mcp-operation-results, ADR 2026-10-16 \"Operation results\n// separate execution from verdict\"). It names what the call executed and what\n// the domain confirmed; it is never a gate verdict. Adapters render it and map\n// it to an exit code; the human and the JSON renderers read the same value.\ntype OperationResult struct {\n\tSchemaVersion int                  `json:\"schema_version\"`\n\tOperation     string               `json:\"operation\"`\n\tScope         string               `json:\"scope,omitempty\"`\n\tOutcome       string               `json:\"outcome\"`\n\tStep          string               `json:\"step,omitempty\"`\n\tStepsRun      []OperationStep      `json:\"steps_run\"`\n\tPending       []OperationPending   `json:\"pending,omitempty\"`\n\tNextAction    string               `json:\"next_action,omitempty\"`\n\tEffects       []OperationEffect    `json:\"effects\"`\n\tUnconfirmed   []OperationUncertain `json:\"unconfirmed,omitempty\"`\n\tResumable     bool                 `json:\"resumable\"`\n\tError         *OperationError      `json:\"error,omitempty\"`\n\tData          any                  `json:\"data,omitempty\"`\n}\n\n// OperationResultSchemaVersion is the schema of OperationResult.\nconst OperationResultSchemaVersion = 1\n\n// Outcomes of an operation. They are disjoint and describe the execution.\nconst (\n\t// OutcomeCompleted: every step this call ran succeeded; for a query, the\n\t// query ran (its payload says whether the scope is ready).\n\tOutcomeCompleted = \"completed\"\n\t// OutcomeAlreadySatisfied: no step ran in this call because the stored\n\t// state already says done. It is not a fresh verification of any gate.\n\tOutcomeAlreadySatisfied = \"already-satisfied\"\n\t// OutcomeWaiting: stopped on another actor; Pending and NextAction say\n\t// who owes what and how to continue.\n\tOutcomeWaiting = \"waiting\"\n\t// OutcomeBlocked: the plan refuses the next step; nothing ran for it.\n\tOutcomeBlocked = \"blocked\"\n\t// OutcomeConflict: the input digest no longer matches the repository.\n\tOutcomeConflict = \"conflict\"\n\t// OutcomeFailed: a step ran and failed.\n\tOutcomeFailed = \"failed\"\n\t// OutcomeInconclusive: a deadline or a cancellation ended the execution;\n\t// there is no verdict.\n\tOutcomeInconclusive = \"inconclusive\"\n)\n\n// OperationStep is one step this call executed and how it ended.\ntype OperationStep struct {\n\tID     string `json:\"id\"`\n\tResult string `json:\"result\"`\n}\n\n// OperationPending is one item the operation waits on.\ntype OperationPending struct {\n\tID     string `json:\"id\"`\n\tKind   string `json:\"kind,omitempty\"`\n\tReason string `json:\"reason,omitempty\"`\n}\n\n// OperationEffect is an effect the domain confirmed: the step returned\n// without error and the repository reflects it.\ntype OperationEffect struct {\n\tStep   string `json:\"step\"`\n\tEffect string `json:\"effect\"`\n\tRef    string `json:\"ref,omitempty\"`\n}\n\n// OperationUncertain names a step that failed after it may have written. The\n// absence of an effect in Effects never proves a rollback.\n// It can also name a property of a confirmed step, such as the durability of a transition that\n// took effect: its presence does not say the operation failed, and Outcome does.\ntype OperationUncertain struct {\n\tStep   string `json:\"step\"`\n\tReason string `json:\"reason\"`\n}\n\n// OperationError is the typed cause of an outcome other than completed,\ntype SourceLoss struct {\n\tProducer string `json:\"producer\"`\n\tArtifact string `json:\"artifact\"`\n\t// Scope is the spec slug (or scope ref) the loss belongs to, when that can be\n\t// shown; empty means it could not be attributed, and a read of any scope may\n\t// have lost something to it.\n\tScope string `json:\"scope,omitempty\"`\n\t// AttributedBy says how Scope was found (\"path\", \"header\"); empty when Scope is.\n\tAttributedBy string `json:\"attributed_by,omitempty\"`\n\tKind         string `json:\"kind\"`\n\tDetail       string `json:\"detail,omitempty\"`\n\t// At is when the lost record was made, when its name says so (RFC 3339, UTC), so a\n\t// reader can tell a record older than the one it selected from one that may have\n\t// superseded it. Empty when nothing can be said.\n\tAt string `json:\"at,omitempty\"`\n\t// ID is the record's name without its extension, the key records of the same\n\t// instant are ordered by.\n\tID string `json:\"id,omitempty\"`\n}\n\n// SourceExclusion is a part of a source that a read leaves out on purpose. A read\n// with exclusions is complete for the slice it declares, not for the whole.\ntype SourceExclusion struct {\n\tProducer string `json:\"producer\"`\n\tPattern  string `json:\"pattern\"`\n\tReason   string `json:\"reason\"`\n\t// Count is how many artifacts the exclusion left out; Examples names a few.\n\tCount    int      `json:\"count,omitempty\"`\n\tExamples []string `json:\"examples,omitempty\"`\nrg: pose-mcp/internal/pose/store.go: No such file or directory (os error 2)\npose-mcp/internal/pose/governance_read_view.go:2608:func (s Store) withGovernanceReadView(view *governanceReadView, producer string) Store {\nrg: .pose/assessments/design*: IO error for operation on .pose/assessments/design*: No such file or directory (os error 2)\n","exit_code":2,"status":"failed"}}
