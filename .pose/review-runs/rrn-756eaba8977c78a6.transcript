{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/usr/bin/bash -lc \"git status --short; git diff 319bfd9c99ae17e6db4945ab348b5a4cf4f51551..7e2b4a3ea129338d2001051bebe562835d6d2ad6 --stat; rg --files -g AGENTS.md -g '*review-ledger*' -g '*backend*' .pose .agents pose-mcp; cat .pose/workflows/review.md; cat .pose/rules/security.md; cat .pose/rules/delivery-evidence.md\"","aggregated_output":" .github/workflows/ci.yml                           |   12 +\n ...nce-reads-use-bounded-operation-scoped-views.md |   28 +\n ...ec-pose-doctor-recommends-the-commit-graph.json |    8 +\n ...e-review-ledger-is-read-once-per-operation.json |    8 +\n .pose/indexes/delivery-integrity.json              | 6816 ++++++++++++--------\n .pose/indexes/generation.json                      |   18 +-\n .pose/indexes/spec-graph.json                      | 1178 ++--\n .pose/indexes/validation-matrix.json               |   14 +\n .pose/results/delivery-validation.json             | 1714 ++---\n .../2672eb8d6166063d8e7032e6/000001.json           |   11 +\n .../2672eb8d6166063d8e7032e6/000001.result.json    |    6 +\n .../3512a7b0dc793c24f0844ce8/000001.json           |   11 +\n .../3512a7b0dc793c24f0844ce8/000001.result.json    |    6 +\n .../435ed2f19bdec7cc00585bf9/000001.json           |   11 +\n .../435ed2f19bdec7cc00585bf9/000001.result.json    |    6 +\n .../9ae03042ebc23753dfe28f0d/000001.json           |   11 +\n .../9ae03042ebc23753dfe28f0d/000001.result.json    |    6 +\n .../d3198413af5042e97b9712a0/000001.json           |   11 +\n .../d3198413af5042e97b9712a0/000001.result.json    |    6 +\n .../review-attestations/rva-2b5ed8730abb8c5f.json  |  238 +\n .../review-attestations/rva-7eeed0b579ea2302.json  |  229 +\n .pose/review-bundles/rvb-72a03e6f783555fb.json     | 3314 ++++++++++\n .pose/review-bundles/rvb-7dfa88290fed19a5.json     | 3505 ++++++++++\n .pose/review-bundles/rvb-aa61bb656377ad01.json     | 3451 ++++++++++\n .pose/review-bundles/rvb-b5149e7feaba9233.json     | 3407 ++++++++++\n .pose/review-bundles/rvb-fcdbee3d8ac391e9.json     | 3389 ++++++++++\n .pose/review-conclusions/rrn-237e7d9be5f0c4f5.json |   13 +\n .pose/review-conclusions/rrn-7dfb663ed1e8ebbb.json |   15 +\n .pose/review-conclusions/rrn-8531130b0d7334cb.json |   14 +\n .pose/review-conclusions/rrn-9b810c44750e6d93.json |   13 +\n .pose/review-conclusions/rrn-c7c3feb56ea14783.json |   14 +\n .pose/review-run-ledger/rrn-237e7d9be5f0c4f5.json  |    8 +\n .pose/review-run-ledger/rrn-7dfb663ed1e8ebbb.json  |    8 +\n .pose/review-run-ledger/rrn-8531130b0d7334cb.json  |    8 +\n .pose/review-run-ledger/rrn-9b810c44750e6d93.json  |    8 +\n .pose/review-run-ledger/rrn-c7c3feb56ea14783.json  |    8 +\n ...3876378af3250c04fc681024f7dc335e686edcb658.json |   23 +\n ...b44a530ecdc2b1cbfa53bbe80effc0d965ce82f0a5.json |   23 +\n .../review-runs/rrn-237e7d9be5f0c4f5.events.ndjson |   35 +\n .pose/review-runs/rrn-237e7d9be5f0c4f5.json        |  137 +\n .pose/review-runs/rrn-237e7d9be5f0c4f5.transcript  |   42 +\n .../review-runs/rrn-7dfb663ed1e8ebbb.events.ndjson |   57 +\n .pose/review-runs/rrn-7dfb663ed1e8ebbb.json        |  138 +\n .pose/review-runs/rrn-7dfb663ed1e8ebbb.transcript  |   59 +\n .../review-runs/rrn-8531130b0d7334cb.events.ndjson |   45 +\n .pose/review-runs/rrn-8531130b0d7334cb.json        |  142 +\n .pose/review-runs/rrn-8531130b0d7334cb.transcript  |   46 +\n .../review-runs/rrn-9b810c44750e6d93.events.ndjson |   52 +\n .pose/review-runs/rrn-9b810c44750e6d93.json        |  143 +\n .pose/review-runs/rrn-9b810c44750e6d93.transcript  |   53 +\n .../review-runs/rrn-c7c3feb56ea14783.events.ndjson |   41 +\n .pose/review-runs/rrn-c7c3feb56ea14783.json        |  146 +\n .pose/review-runs/rrn-c7c3feb56ea14783.transcript  |   52 +\n ...1-16-pose-doctor-recommends-the-commit-graph.md |  161 +\n ...ose-review-ledger-is-read-once-per-operation.md |  168 +\n .../pose-doctor-recommends-the-commit-graph.json   |   57 +\n ...e-review-ledger-is-read-once-per-operation.json |   57 +\n pose-mcp/internal/cli/doctor.go                    |   24 +\n pose-mcp/internal/cli/doctor_commit_graph.go       |  192 +\n pose-mcp/internal/cli/doctor_commit_graph_test.go  |  248 +\n pose-mcp/internal/pose/governance_read_view.go     |    3 +\n pose-mcp/internal/pose/review_bundle.go            |   12 +\n pose-mcp/internal/pose/review_dispatch.go          |   47 +-\n pose-mcp/internal/pose/review_ledger_memo.go       |   83 +\n pose-mcp/internal/pose/review_ledger_memo_test.go  |  300 +\n pose-mcp/internal/pose/review_operation_view.go    |   22 +\n 66 files changed, 25917 insertions(+), 4214 deletions(-)\n.pose/rules/backend-go.md\n.pose/reports/history/standard-migrate-backend-go-frontend-react-rules-to-extensions.jsonl\n.pose/reports/2026-08-15-standard-migrate-backend-go-frontend-react-rules-to-extensions.md\npose-mcp/internal/scaffold/dist/AGENTS.md\n.pose/review-profiles/backend-review.json\npose-mcp/internal/scaffold/dist/locales/pt-BR/AGENTS.md\n.pose/closeout-plans/spec-pose-review-ledger-is-read-once-per-operation.json\n.pose/starts/pose-review-ledger-is-read-once-per-operation.json\n.pose/specs/2026-11-16-pose-review-ledger-is-read-once-per-operation.md\n# Workflow: Review\n\n## Objective\n\nVerify that a change is correct, production-safe, and aligned with its approved scope and specs.\n\n## Preconditions\n\n- Make the final diff readable through cohesive commits or batches.\n- Provide requirement and spec context.\n- Attach implementer validation evidence, including `pose validate` output.\n- Define acceptance criteria and expected risk.\n\n## Execution checklist\n\n1. Resolve `pose review bundle <scope> --explain` (or `pose_review_bundle`) when bundle policy is enabled; otherwise resolve `pose review-plan <scope> --explain`.\n2. Confirm the semantic scope, patch/tree identity, mapped components and bundle plan digest.\n3. Run required active tools first, evaluate recommended tools explicitly and leave completion-only tools deferred until an attestation exists.\n4. Select the plan's applicable rules explicitly and record them in the review.\n5. Resolve rule conflicts with the most restrictive option, prioritizing security for exposure, authorization, and integrity risks.\n6. Consult `.pose/knowledge/` for relevant handoffs, accepted risks, follow-ups, and decision logs.\n7. Check compliance with specs, contracts, and local instructions.\n8. Review functional correctness and edge cases.\n9. Evaluate security, observability, and performance risks.\n10. Require validation evidence from `.pose/indexes/validation-matrix.json` proportional to risk.\n11. Identify regression and rollout or rollback risks.\n12. Run plan-selected assessments, including tech-debt and integration when applicable.\n13. Classify findings by severity and propose objective actions.\n14. **Produce a handoff** in `.pose/knowledge/` when findings result in accepted risk, post-merge monitoring, or deferred work (`pose new-knowledge handoff <slug>`); link it from the review.\n15. Seal the validated subject with `pose review bundle <scope> --seal`; stop if any input is unclassified or changed since preparation.\n16. Issue a final decision: approved, approved with reservations, changes requested, or rejected.\n17. Record the decision with `pose review attest <bundle-id> ... --plan-digest <sha256> --apply`; signed external envelopes use `pose review attest --envelope <path> --apply`.\n18. Run `pose review verify <scope>` and `pose review-check <scope>`; reject stale, incomplete, conflicting or transitively invalid reused criteria.\n19. Apply closeout only after verification reports `ready-to-close`; lifecycle, state and report refreshes must not change the sealed bundle.\n20. When Contributor Mode is active and review identifies linter false-positives, diagnostic frictions, or POSE rule gaps, stage an improvement proposal via `pose contribute stage --type enhancement`.\n\n## Required rule selection\n\nAttach this section to the review:\n\n```md\n## Rules applied during review\n- Change type: <feature|bugfix|refactor|documentation-update|mixed>\n- Workflow consulted: `.pose/workflows/<file>.md`\n- Rules selected:\n  - [ ] `.pose/rules/security.md`\n  - [ ] `.pose/rules/backend-go.md` (extension `pose-rule-backend-go`, when installed)\n  - [ ] `.pose/rules/frontend-react.md` (extension `pose-rule-frontend-react`, when installed)\n  - [ ] `.pose/rules/kubernetes.md` (extension `pose-rule-kubernetes`, when installed)\n  - [ ] `.pose/rules/documentation-style.md`\n  - [ ] `.pose/rules/knowledge-governance.md` when knowledge or process changes\n- Rationale for each selected rule: <one line per item>\n- Rules not applicable: <list and explain>\n```\n\n## Recurrence escalation\n\n- Trigger `.pose/workflows/recurrence-escalation.md` when recurring rework is uncovered and the threshold is met.\n- Require `recurrence_rework_uncovered` evidence for the 30-day period.\n- Require explicit links from the specialized workflow to applicable domain rules.\n- Require a formal keep, adjust, or discard decision after the 45-day pilot.\n\n## Minimum domain coverage\n\n- React UI: apply `frontend-react`, `security`, and `documentation-style`.\n- Go services: apply `backend-go`, `security`, and `documentation-style`.\n- Cluster deployment or infrastructure: apply `kubernetes`, `security`, and `documentation-style`.\n- Process, spec, workflow, rule, or report: apply `documentation-style`, `knowledge-governance`, and security when sensitive data is involved.\n- Cross-stack changes: apply every touched domain rule cumulatively.\n\n## Domain review checklist\n\n### Security\n\n- Confirm authentication, authorization, and least privilege when applicable.\n- Verify that code, configuration, manifests, docs, and logs contain no secrets.\n- Require applicable vulnerability and secret-scanning evidence.\n\n### Contracts\n\n- Confirm compatibility of public HTTP, event, schema, CLI, and file contracts.\n- Validate forward and backward compatibility for rollout and rollback.\n- Require a spec update for contract changes.\n\n### Observability\n\n- Verify structured logs and metrics without sensitive data.\n- Confirm that probes, health checks, and alerts reflect real behavior.\n- Preserve enough traceability for post-deployment diagnosis.\n\n### Validation\n\n- Require lint, typecheck, test, and build coverage proportional to risk.\n- Require executed `pose validate` evidence and relevant results.\n- Record environment limitations and residual validation risks.\n\n## Editorial checklist\n\n- Use imperative, actionable instructions.\n- Keep bullets short and avoid duplicated sections.\n- Use `check`, `spec`, and `workflow` consistently.\n- Reference explicit files and paths.\n\n## Required outputs\n\n- A review decision with rationale.\n- The inspected effective plan, its component provenance and tool dispositions.\n- An immutable sealed review bundle and separate attestation bound to its exact digest.\n- A completed rule-selection section.\n- Findings with severity, evidence, and recommendation.\n- Recurrence classification by domain and cause with preventive actions.\n- An explicit statement about public contracts and compatibility.\n- Residual risks and safe-deployment conditions.\n- References to executed checks and collected evidence.\n\n## Complete multi-rule review example\n\n```md\n## Review Summary\n- Decision: approved with reservations\n- Change type: feature (Go API, React UI, and Helm)\n- Workflow: `.pose/workflows/feature.md`\n\n## Rules applied during review\n- `.pose/rules/backend-go.md` (extension `pose-rule-backend-go`): verified handlers, context, and error handling.\n- `.pose/rules/frontend-react.md` (extension `pose-rule-frontend-react`): verified accessibility and explicit loading and error states.\n- `.pose/rules/kubernetes.md` (extension `pose-rule-kubernetes`): verified resources, probes, and immutable images.\n- `.pose/rules/security.md`: verified authorization and absence of secrets.\n- `.pose/rules/documentation-style.md`: verified editorial consistency.\n\n## Checks and evidence\n- `pose validate`: passed\n- `go test ./...`: passed in the backend module\n- `pnpm lint && pnpm test`: passed in the frontend module\n- `helm template` and `kubectl apply --dry-run=client`: passed\n\n## Contracts and compatibility\n- Preserved `POST /v1/storage`.\n- Added optional `retentionDays`, preserving backward compatibility.\n\n## Findings\n- Medium: missing queue-saturation alert; add a metric and alert before production.\n- Low: frontend error lacks request-id context; improve observable UX.\n\n## Residual risks\n- Review did not simulate real cluster load.\n- Increase monitoring during the first 24 hours.\n```\n\n## CI failure interpretation\n\n- Treat `POSE check (strict)` as merge-blocking on protected branches.\n- Treat failed required checks in `POSE validate (strict)` as merge-blocking.\n- Attach pipeline artifacts: `pose-check.log`, `pose-validate.latest.log`, and the POSE report.\n- Classify optional-check failures as quality reservations with an owned remediation plan.\n- Reject changes that violate specs, public contracts, security, or safe rollout.\n\n## Phased rollout for unready modules\n\n- Enforce the current required checks immediately.\n- Use `moduleOverrides` to phase adoption without weakening global structural and required gates.\n- Promote optional checks to required by module with an owner and agreed window.\n\n### Optional-to-required promotion protocol\n\n- Select a pilot domain and map candidate checks with owners and explicit risks.\n- Measure success for four weeks and require a baseline of at least 95 percent.\n- Promote only eligible domains through `moduleOverrides`.\n- Update the validation matrix and quality policy in the same change set.\n- Monitor regressions and adjust rollout without removing established required gates.\n- Update specs and rules when rollout changes merge acceptance criteria.\n\n## Definition of done\n\n- Resolve or formally accept every critical and high finding.\n- Make the final decision clear and actionable.\n- Support quality and security conclusions with evidence.\n- Preserve approved scope without unjustified drift.\n\n## Reviewer mode\n\n**Objective:** evaluate technical quality and production readiness with emphasis on correctness, risk, and scope.\n\n- **Focus:** functional correctness, spec consistency, regression and security risk, operability, validation quality, and actionable feedback.\n- **Anti-patterns:** approve without sufficient evidence; review style while ignoring functional risk; request unrelated changes; block progress on subjective preference.\n- **Handoff:** state the decision, severity and evidence for each finding, safe merge or deployment conditions, accepted risks, and recommended monitoring.\n# Rule: Security\n\n## When to consult\n\nConsult this guide for authentication, authorization, sensitive data, external integrations, dependencies, and attack surfaces.\n\n## Required patterns\n\n- Apply least privilege to resource and credential access.\n- Store secrets only in appropriate secret-management mechanisms, never in code.\n- Validate and sanitize external input for its execution context.\n- Keep personal and confidential data out of plaintext logs and metrics.\n- Evaluate new dependencies for maintenance, licensing, and known vulnerabilities.\n- Test both positive and negative authentication and authorization cases.\n\n## Blocking anti-patterns\n\n- Committing credentials, tokens, keys, or secrets in any versioned artifact.\n- Disabling TLS or certificate verification without a formally documented mitigation.\n- Trusting client input for authorization decisions.\n- Executing dynamic commands without adequate validation and escaping.\n- Ignoring critical security alerts without an approved exception record.\n\n## Minimum checks\n\n- Run secret scanning on the changed diff or scope.\n- Run the module's applicable dependency vulnerability scanner.\n- Pass the relevant authentication and authorization tests.\n- Complete a review for sensitive-data exposure in logs and configuration.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Delivery Evidence\n\n## When to consult\n\nConsult this guide when writing or reviewing any document that **claims delivery,\ncompletion, or readiness**: status reports, handoffs, summaries, module READMEs,\ncurrent-state sections in specs or proposals, and messages that say something is complete.\n\n## Required conventions\n\n- Claim delivery only with attached, verifiable gate evidence: command and output\n  (`pose validate`, `go test`, `tsc`, `vitest`) or a link to the corresponding POSE report.\n- Use POSE lifecycle vocabulary: `draft`, `in-progress`, `done`, `blocked`,\n  `superseded`, or `abandoned`. Do not invent labels such as `completed` or `100% COMPLETE`.\n- Separate **implemented and verified** work from **planned or documented** work.\n  A plan describes intent; do not present that intent as current reality.\n- Reference the report or evidence that crossed the spec exit gate before using `done`.\n- Convert relative dates to absolute dates and stamp the verification date.\n- Declare exact source-tree artifact actions in the spec and reconcile them\n  against an immutable Git change set before claiming delivery.\n- Treat artifact declarations, Git observations and delivery verification as\n  separate evidence; none proves the others by itself.\n- For typed delivery targets, require a path from reconciled artifacts through\n  a production entrypoint to current structured validation results. A surface\n  requires reachability plus integration/e2e evidence; a composed capability\n  requires integration evidence.\n- Evidence answers for the component it ran in or for a component inside it: a\n  module-wide run covers its subtree, but a result from a directory inside a\n  component does not answer for the whole component. Coverage that rests only\n  on a containing module is reported as `inferred-coverage` — name it as such.\n\n## Blocking anti-patterns\n\n- Claiming `100% COMPLETE` or production readiness without a green\n  `pose validate --strict` for every affected module.\n- Publishing contradictory delivery documents for the same scope; reconcile them first.\n- Merging code with completion documentation before the applicable POSE checks pass.\n- Mixing aspiration and verified state in one paragraph without clear labels.\n\n## Minimum checks\n\n- Run `pose check --strict` for structure and spec status enums.\n- Run `pose validate --strict` for every module the document claims to deliver.\n- Run `pose lint-spec` when the document is a spec.\n- Run `pose artifact-check --strict` when the scope changes governed source-tree paths.\n- Run `pose surface-check --strict` for specs with `delivers` and `pose\n  roadmap-check --strict` before a roadmap claims completion.\n- `pose assess discover --if-stale --update-state` when closing specs to update completeness metrics, technical debt, and reports under `.pose/assessments/` and `.pose/state/`.\n\n## Precedence in multi-domain conflicts\n\n- Prefer verifiable check evidence over progress narratives when rules conflict.\n- When pressured to claim completion without a gate, record the real state\n  (`in-progress` or `blocked`) and the remaining exit conditions.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/specs/2026-11-16-pose-review-ledger-is-read-once-per-operation.md; git diff 319bfd9c99ae17e6db4945ab348b5a4cf4f51551..7e2b4a3ea129338d2001051bebe562835d6d2ad6 -- pose-mcp/internal/pose/governance_read_view.go pose-mcp/internal/pose/review_bundle.go pose-mcp/internal/pose/review_dispatch.go pose-mcp/internal/pose/review_operation_view.go pose-mcp/internal/pose/review_ledger_memo.go .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md .pose/indexes/validation-matrix.json'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/specs/2026-11-16-pose-review-ledger-is-read-once-per-operation.md; git diff 319bfd9c99ae17e6db4945ab348b5a4cf4f51551..7e2b4a3ea129338d2001051bebe562835d6d2ad6 -- pose-mcp/internal/pose/governance_read_view.go pose-mcp/internal/pose/review_bundle.go pose-mcp/internal/pose/review_dispatch.go pose-mcp/internal/pose/review_operation_view.go pose-mcp/internal/pose/review_ledger_memo.go .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md .pose/indexes/validation-matrix.json'","aggregated_output":"---\nslug: pose-review-ledger-is-read-once-per-operation\nstatus: in-progress\ncreated_at: 2026-11-16\ncompleted_at:        # stamped on the transition to status: done\nsupersedes:          # slug of the superseded spec (when applicable)\ndepends_on:          # prerequisites, inline list: other-spec, milestone:<roadmap>/<id>, roadmap:<slug>\nremediates:          # optional explicit links: spec:slug@defect-fix, finding:rva-<16hex>/F1@revert (never inferred from depends_on)\npriority:            # integer >= 0 (lower = higher priority); ordering preference, not a blocker\ncomponents: pose-mcp\ntask_type: refactor\nsurface:             # optional: minimal | standard | full (default) — minimal drops Tasks and derivable report sections; `pose specs facts <slug>` derives them\ndelivers: capability:review-ledger-is-read-once-per-operation\n---\n\n# Spec: pose-review-ledger-is-read-once-per-operation\n\n## 1. Intent\n\n### Goal\nFazer uma operação de read view ler, interpretar e conferir o ledger de revisão de cada projeto uma vez, e não a cada verificação de bundle que a operação faz.\n\n### Business value\nA primeira chamada `pose_closeout_state` de um servidor MCP no harne8 ainda leva de 140 a 200 s; a spec `pose-index-material-is-kept-per-repository-state` só acelerou as seguintes. O perfil de CPU de uma chamada mostra que cerca de 98 s vão para `federatedSourceProof`, que verifica o bundle de revisão de cada dependência federada. Numa só chamada, contada com uma build instrumentada sobre o harne8 com o pose-dist em 7e46b1e: 64 provas de fonte, 280 leituras de `ReadReviewRuns`, 304 de `ReadReviewAttestations`, 140 de `ReviewRoundOf` e 29.680 conferências de digest de transcript, sobre um ledger de 318 runs (80 MB de transcripts, 13 MB de attestations). SHA-256 sozinho soma 31 s de CPU, e cópia de memória e JSON somam outros 30 s. É o custo que deixa a primeira chamada acima dos tetos dos clientes do `conductor`.\n\n### Constraints\n- Dentro de uma operação a read view já devolve os mesmos bytes para a mesma leitura; o memo guarda só valores derivados dessas leituras e não pode mudar nenhuma resposta.\n- A primeira leitura de cada entrada continua passando pela read view, de modo que o fecho e a auditoria final da operação a cobrem.\n- O memo vive e morre com a operação; nada é guardado entre operações.\n\n### Non-goals\n- Mudar o formato do ledger, os limites de leitura ou o que uma verificação de bundle exige.\n- Guardar resultados entre operações (isso é da spec `pose-index-material-is-kept-per-repository-state`).\n\n---\n\n## 2. Requirements\n\n### Functional\n- R1: Within a read-view operation, the engine shall, for each producer, read and parse a project's review runs, its review attestations per bundle filter, and each review bundle's header at most once, and shall answer every later request of that operation for them from the parsed result, filtered as before.\n- R2: Within a read-view operation, the engine shall check a transcript's digest at most once per transcript path, size and expected digest, and shall reuse the outcome.\n- R3: A store with no read-view operation shall read, parse and check as before, on every call.\n- R4: The answers of every review verification, closeout state and federated acceptance shall be the same with and without the memo, including when a record is lost, out of bound or unreadable.\n\n### Non-functional\n- No harne8, a CPU da primeira chamada `pose_closeout_state` de um servidor MCP cai para menos da metade, com o mesmo veredito; as conferências de transcript caem de 29.680 para no máximo o número de transcripts do ledger.\n\n### Security\n- Nenhuma mudança de autorização ou de limite: o memo guarda o que a operação já leu pelas raízes que ela autoriza.\n\n### Compatibility\n- Sem mudança de contrato, saída ou formato de arquivo.\n\n---\n\n## 3. Technical Plan\n\n### Affected areas\n- `pose/review_dispatch.go`: `ReadReviewRuns` e `reviewRunTranscriptIntact` passam pelo memo da operação.\n- `pose/review_bundle.go`: `ReadReviewAttestations` passa pelo memo da operação.\n- `pose/review_operation_view.go`: `readReviewBundleHeader` passa pelo memo da operação.\n- `pose/governance_read_view.go`: a operação carrega o memo, descartado com ela.\n\n### Artifacts\n- created: pose-mcp/internal/pose/review_ledger_memo.go\n- created: pose-mcp/internal/pose/review_ledger_memo_test.go\n- modified: pose-mcp/internal/pose/review_dispatch.go\n- modified: pose-mcp/internal/pose/review_bundle.go\n- modified: pose-mcp/internal/pose/review_operation_view.go\n- modified: pose-mcp/internal/pose/governance_read_view.go\n- modified: .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n- modified: .pose/indexes/validation-matrix.json\n\n### Delivery targets\n\n- capability:review-ledger-is-read-once-per-operation module:pose-mcp profile:composed-capability entrypoint:pose-mcp/cmd/pose/main.go\n\nComposto em produção por toda operação de revisão, fechamento e aceitação federada que verifica bundles. Check permanente `review-ledger-is-read-once-per-operation-integration`, evidenceClass `integration`, required: `go test ./internal/pose -run 'TestReviewLedgerIsReadOncePerOperation|TestReviewLedgerWithoutAnOperationIsReadEveryTime|TestReviewLedgerMemoAnswersAsAFreshRead|TestReviewLedgerMemoComputesOnceForConcurrentMisses|TestReviewLedgerMemoGivesIsolatedCopies|TestCopyReviewRunsCoversEveryUnexportedField|TestReviewLedgerMemoIsNotServedAfterTheOperationEnds|TestReviewLedgerMemoRefusalsStayVisible|TestReviewLedgerMemoAttributesEveryConsumingProducer' -count=1`.\n\n### API/contract changes\n- Nenhuma.\n\n### Data/storage changes\n- Nenhuma.\n\n### Technical risks\n- Um chamador que altere o que recebeu mudaria a resposta de chamadas seguintes; o memo devolve cópias profundas, e os campos não exportados de `ReviewRun` são copiados por nome, com um teste que reprova se surgir um novo.\n\n---\n\n## 4. Tasks\n\n### Implementation\n- [x] Memo de runs, attestations, cabeçalhos de bundle e conferência de transcript por operação (R1, R2, R3).\n- [x] Emenda D14 do ADR das leituras de governança.\n\n### Validation\n- [x] Testes de contagem e de equivalência das respostas, com prova de reprovação; medição no harne8.\n\n---\n\n## 5. Decisions\n\n### Decision D1\n- Date: 2026-11-16\n- Context: o perfil da primeira chamada mostrou o ledger do pose-dist lido 280 vezes e 29.680 conferências de transcript numa só operação; o maintainer escolheu um memo por operação.\n- Options considered: (a) memo por operação dos valores derivados do ledger; (b) guardar entre operações, junto do material do índice; (c) paralelizar as verificações.\n- Decision: (a).\n- Basis: R1, R2, R4\n- Rationale: dentro da operação a read view já fixa os bytes, então (a) não muda resposta nem fecho; (b) exigiria reproduzir o fecho do ledger a cada chamada; (c) foi medida no material do índice e não deu ganho (155 s contra cerca de 140 s).\n- Consequences: o custo do ledger passa a ser uma leitura por operação.\n\n---\n\n## 6. Validation\n\n### Strategy\nTestes que contam leituras e conferências numa operação e comparam as respostas com e sem memo; medição da primeira chamada MCP no harne8.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./internal/pose ./internal/cli ./internal/mcpserver ./internal/scaffold -count=1`\n- Scope: pose-mcp\n- Expected: verde\n\n### Execution log\n- Date: 2026-11-16\n- Environment: Linux, Go 1.26; clone limpo do harne8 em cc7780b1 com o pose-dist em 7e46b1e; `closeout-check spec:harne8-abm-governed-execution`, que equivale à primeira chamada de um servidor MCP.\n- Notes: sem o memo, 197 s de parede e 130 s de CPU; o ledger do pose-dist lido 280 vezes, attestations 304, 29.680 conferências de transcript. Com o memo de runs, attestations e transcripts, 3 leituras de runs, 46 de attestations, 212 conferências, 164 s e 92 s de CPU; o perfil passou a mostrar `ReadReviewBundles` lendo e hasheando os 1.724 bundles (104 MB) a cada chamada. Com o memo de cabeçalhos de bundle, 136 s e 53 s de CPU. O resto é Git: 8.960 comandos somando 94 s, dos quais 1.116 `git log -1 --format=%H -- <path>` (81 s) sobre 436 caminhos distintos. Com o commit-graph com filtros de Bloom de caminhos alterados (`git commit-graph write --reachable --changed-paths`) nos dois repositórios, cada uma dessas consultas cai de 47 ms para 2 ms, e duas chamadas MCP seguidas levam 59 s e 10 s, terminais. Sem o memo, o teste de contagem reprova (22 leituras de runs e 28 de cabeçalhos numa verificação da fixture); sem as cópias, o de equivalência reprova.\n\n### Results summary\n- Successes: a CPU da primeira chamada cai de 130 s para 53 s, com o mesmo veredito; com o commit-graph do Git, a primeira chamada leva 59 s.\n- Failures: nenhuma.\n- Warnings: sem o commit-graph, a parede da primeira chamada continua em cerca de 136 s, dominada por `git log -1 -- <path>`.\n\n### Requirement trace\n- R1 [satisfied] test:TestReviewLedgerIsReadOncePerOperation test:TestReviewLedgerMemoComputesOnceForConcurrentMisses check:review-ledger-is-read-once-per-operation-integration\n- R2 [satisfied] test:TestReviewLedgerIsReadOncePerOperation\n- R3 [satisfied] test:TestReviewLedgerWithoutAnOperationIsReadEveryTime\n- R4 [satisfied] test:TestReviewLedgerMemoAnswersAsAFreshRead test:TestReviewLedgerMemoIsNotServedAfterTheOperationEnds test:TestReviewLedgerMemoRefusalsStayVisible test:TestReviewLedgerMemoAttributesEveryConsumingProducer test:TestReviewLedgerMemoGivesIsolatedCopies test:TestCopyReviewRunsCoversEveryUnexportedField\n\n### Known gaps\n- O ganho de parede da primeira chamada depende do commit-graph do Git, que é manutenção do repositório e não do motor (follow-up F1).\n\n---\n\n## 7. Final Report\n\n### Delivered scope\n\nNão concluída.\n\n### Residual risks\n\n### Follow-ups\n\n- [open] F1: tornar o commit-graph com caminhos alterados parte da instalação e do CI: `pose update`/`pose doctor` reportam a falta dele e o comando que o escreve, e os workflows do harne8 e do pose-dist o escrevem antes dos gates; com ele, `git log -1 -- <path>` cai de 47 ms para 2 ms. (owner:@pose-maintainers crit:high review:2026-11-23)\n- [open] F2: guardar entre operações as leituras Git puras do servidor MCP (o memo residente que o runtime de worktree já liga), para que os 1.116 `git log -1 -- <path>` de uma chamada, sobre 436 caminhos, não se repitam entre operações. (owner:@pose-maintainers crit:medium review:2026-11-23)\n\n### Review\n\nRodada 1 (run rrn-7dfb663ed1e8ebbb, changes-requested; a mensagem final não trouxe bloco `pose-draft`): 3 achados, corrigidos com teste que reprova sem a correção. F1 duas faltas concorrentes da mesma chave computavam as duas antes de publicar; agora cada chave tem uma célula com `sync.Once` (`TestReviewLedgerMemoComputesOnceForConcurrentMisses`). F2 as cópias eram rasas, e mudar `Criteria[0].Disposition` de uma attestation devolvida mudava a guardada; agora `deepCopyValue` copia tudo o que é exportado, e `copyReviewRuns` copia os três campos não exportados de `ReviewRun` por nome (`TestReviewLedgerMemoGivesIsolatedCopies`, `TestCopyReviewRunsCoversEveryUnexportedField`). F3 copiar sobre `nil` trocava um slice vazio por `nil`, e o JSON de `[]` por `null`; a cópia profunda preserva nil e vazio, e o teste compara uma resposta vazia com a de uma leitura nova.\n\nRodada 2 (run rrn-8531130b0d7334cb, recusada: o rascunho citou os achados da rodada 1 como `R1-F1` a `R1-F3`, que o motor não tinha registrado, porque a rodada 1 terminou sem bloco `pose-draft`). O rascunho declarou F1 a F3 corrigidos e trouxe um achado novo, corrigido com teste que reprova sem a correção: F4 um acerto do memo não passava pela verificação de ciclo de vida da view, e um leitor que guardasse a store depois de a operação terminar recebia registros guardados, mesmo com o ledger mudado; agora o memo chama `begin()` da view antes de servir ou calcular, e uma view finalizada recusa como uma leitura recusaria (`TestReviewLedgerMemoIsNotServedAfterTheOperationEnds`).\n\nRodada 3 (run rrn-9b810c44750e6d93, changes-requested): 3 bloqueadores, corrigidos com teste que reprova sem a correção. N1 depois de a operação terminar, a recusa do memo virava uma conferência de transcript sem problema, que os chamadores leem como transcript íntegro; agora a recusa vira o problema \"cannot be inspected\". N2 a mesma recusa virava uma observação de cabeçalho vazia, e o bundle sumia sem perda registrada; agora vira a perda de leitura de antes (`TestReviewLedgerMemoRefusalsStayVisible`). N3 o valor guardado era de quem o calculou primeiro, e a auditoria final atribuía uma mudança do ledger só a esse produtor; agora a chave inclui o produtor e o projeto da `Files`, cada produtor lê uma vez pela view e é atribuído, e uma `Files` sem produtor conhecido não usa o memo (`TestReviewLedgerMemoAttributesEveryConsumingProducer`).\n\ndiff --git a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\nindex ceb93f61..20ed7079 100644\n--- a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n+++ b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n@@ -333,3 +333,31 @@ before reuse.\n Measured on harne8: the second closeout call of one MCP server falls from\n 136 s to 43 s, with the same terminal verdict. The replay, not a rebuild,\n is the remaining cost.\n+\n+## The review ledger is read once per operation (D14) — 2026-11-16\n+\n+Spec `pose-review-ledger-is-read-once-per-operation`. After D13, the first\n+closeout call of an MCP server on harne8 still took 140 to 200 s. Its CPU\n+profile put about 98 s in verifying the review bundles of federated\n+dependencies. Counted in one call, pose-dist's review ledger (318 runs,\n+80 MB of transcripts) was read 280 times, its attestations 304 times, and\n+transcript digests were checked 29,680 times, because every bundle\n+verification read and checked the whole ledger again.\n+\n+Within one operation the read view already returns the same bytes for the\n+same read. A value derived only from those reads is therefore the same on\n+every request of the operation. The operation now keeps, for its own life,\n+each project's parsed review runs, its review attestations per bundle filter,\n+each review bundle's header, and each transcript check per path and expected\n+digest. The first\n+computation reads through the view, so the closure and the final audit cover\n+every input as before. Callers receive copies of the kept slices. A store\n+without an operation reads and checks on every call. Nothing is kept across\n+operations.\n+\n+Measured on harne8: the first call's CPU falls from 130 s to 53 s, and its\n+wall time from about 197 s to 136 s. The rest is Git: 1,116\n+`git log -1 -- <path>` commands, 81 s. A commit-graph with changed-path Bloom\n+filters takes each from 47 ms to 2 ms and the first call to 59 s; it is\n+repository maintenance, not part of this decision.\n+\ndiff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex 573cd04f..3d3fa181 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2419,6 +2419,20 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"doctor-recommends-the-commit-graph-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/cli\", \"-run\", \"TestDoctorRecommendsTheCommitGraph|TestDoctorCommitGraphReportsAnUnreadableHistory|TestDoctorCommitGraphTellsUnbornFromBroken|TestDoctorCommitGraphProbesALiteralPath|TestDoctorCommitGraphNamesDisabledReads\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n+        {\n+          \"name\": \"review-ledger-is-read-once-per-operation-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestReviewLedgerIsReadOncePerOperation|TestReviewLedgerWithoutAnOperationIsReadEveryTime|TestReviewLedgerMemoAnswersAsAFreshRead|TestReviewLedgerMemoComputesOnceForConcurrentMisses|TestReviewLedgerMemoGivesIsolatedCopies|TestCopyReviewRunsCoversEveryUnexportedField|TestReviewLedgerMemoIsNotServedAfterTheOperationEnds|TestReviewLedgerMemoRefusalsStayVisible|TestReviewLedgerMemoAttributesEveryConsumingProducer\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"index-material-is-kept-per-repository-state-integration\",\n           \"program\": \"go\",\ndiff --git a/pose-mcp/internal/pose/governance_read_view.go b/pose-mcp/internal/pose/governance_read_view.go\nindex be037243..8b15f4d9 100644\n--- a/pose-mcp/internal/pose/governance_read_view.go\n+++ b/pose-mcp/internal/pose/governance_read_view.go\n@@ -90,6 +90,9 @@ type governanceReadViewRoot struct {\n }\n \n type governanceReadViewOperation struct {\n+\t// ledgerMemo keeps values derived from the review ledger for the life of\n+\t// the operation (spec pose-review-ledger-is-read-once-per-operation).\n+\tledgerMemo sync.Map\n \t// indexInputsFrom, when set, is the coordinator operation a scope\n \t// operation was created under: the scope's check of the consumed index's\n \t// inputs is the coordinator's, read through the coordinator's Files and\ndiff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex d2da9242..c77e594c 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -3337,6 +3337,18 @@ type ReviewAttestationsRead struct {\n // names another bundle is not a loss for this one; one that names none is, because it may\n // be a rejection of this bundle.\n func (s Store) ReadReviewAttestations(bundleID string) (ReviewAttestationsRead, error) {\n+\tread, _, err := memoizedLedgerRead(s.fsys(), \"review-attestations\\x00\"+filepath.Clean(s.Root)+\"\\x00\"+bundleID, func() (ReviewAttestationsRead, error) {\n+\t\treturn s.readReviewAttestations(bundleID)\n+\t})\n+\tif err != nil {\n+\t\treturn ReviewAttestationsRead{}, err\n+\t}\n+\treturn deepCopyValue(read), nil\n+}\n+\n+// readReviewAttestations reads the store's review attestations, those of\n+// bundleID when it is set, with the coverage of what could not be read.\n+func (s Store) readReviewAttestations(bundleID string) (ReviewAttestationsRead, error) {\n \tcoverage := SourceCoverage{Losses: []SourceLoss{}}\n \tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), false)\n \tif os.IsNotExist(err) {\ndiff --git a/pose-mcp/internal/pose/review_dispatch.go b/pose-mcp/internal/pose/review_dispatch.go\nindex 9d9e5442..60a165d1 100644\n--- a/pose-mcp/internal/pose/review_dispatch.go\n+++ b/pose-mcp/internal/pose/review_dispatch.go\n@@ -247,6 +247,31 @@ func (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n }\n \n func (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n+\t// Within a read-view operation the ledger is read and checked once per\n+\t// root; every request of the operation is answered from that read,\n+\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n+\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n+\t\truns, lost, err := s.readAllReviewRuns()\n+\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n+\t})\n+\tif err != nil {\n+\t\treturn nil, nil, err\n+\t}\n+\tout := copyReviewRuns(all.runs)\n+\tif bundleID != \"\" {\n+\t\tfiltered := []ReviewRun{}\n+\t\tfor _, run := range out {\n+\t\t\tif run.BundleID == bundleID {\n+\t\t\t\tfiltered = append(filtered, run)\n+\t\t\t}\n+\t\t}\n+\t\tout = filtered\n+\t}\n+\treturn out, deepCopyValue(all.lost), nil\n+}\n+\n+// readAllReviewRuns reads, checks and orders every review run of the store.\n+func (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n \tfiles := s.fsys()\n \tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n \t// The storage is read where the writer writes it: a link in its place is another place.\n@@ -361,15 +386,6 @@ func (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n \t}\n \tlost = append(lost, findings...)\n \tlost = append(lost, s.reviewContinuationFindings(out)...)\n-\tif bundleID != \"\" {\n-\t\tfiltered := []ReviewRun{}\n-\t\tfor _, run := range out {\n-\t\t\tif run.BundleID == bundleID {\n-\t\t\t\tfiltered = append(filtered, run)\n-\t\t\t}\n-\t\t}\n-\t\tout = filtered\n-\t}\n \treturn out, uniqueSorted(lost), nil\n }\n \n@@ -1642,6 +1658,19 @@ func validateReviewRunRecord(name string, run ReviewRun) error {\n const reviewTranscriptMaxBytes = 256 << 20\n \n func (s Store) reviewRunTranscriptIntact(run ReviewRun) string {\n+\tproblem, _, err := memoizedLedgerRead(s.fsys(), \"transcript\\x00\"+filepath.Clean(s.Root)+\"\\x00\"+run.TranscriptPath+\"\\x00\"+run.TranscriptDigest, func() (string, error) {\n+\t\treturn s.checkReviewRunTranscript(run), nil\n+\t})\n+\tif err != nil {\n+\t\t// A refused read is not an intact transcript (review N1).\n+\t\treturn \"the transcript of the run cannot be inspected: \" + err.Error()\n+\t}\n+\treturn problem\n+}\n+\n+// checkReviewRunTranscript reads a run's transcript and checks it against\n+// the digest the run names; it returns the problem, or \"\".\n+func (s Store) checkReviewRunTranscript(run ReviewRun) string {\n \tfull := filepath.Join(s.Root, filepath.FromSlash(run.TranscriptPath))\n \tfiles := s.fsys()\n \tinfo, err := files.Lstat(full)\ndiff --git a/pose-mcp/internal/pose/review_ledger_memo.go b/pose-mcp/internal/pose/review_ledger_memo.go\nnew file mode 100644\nindex 00000000..62b8a7d3\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_ledger_memo.go\n@@ -0,0 +1,83 @@\n+package pose\n+\n+import \"sync\"\n+\n+// The review ledger of a project is read by every bundle verification an\n+// operation makes: a closeout that verifies 64 federated dependencies read\n+// pose-dist's ledger 280 times and checked transcript digests 29,680 times.\n+// Within a read-view operation the view already returns the same bytes for\n+// the same read, so a value derived only from those reads is the same on\n+// every request: it is computed once and kept for the life of the operation\n+// (spec pose-review-ledger-is-read-once-per-operation, ADR\n+// governance-reads-use-bounded-operation-scoped-views D14). The first\n+// computation reads through the view, so the operation's closure and final\n+// audit cover every input as before.\n+\n+type reviewRunsRead struct {\n+\truns []ReviewRun\n+\tlost []string\n+}\n+\n+// ledgerMemoCell computes its value once: concurrent requests for the same\n+// key wait for the one computation.\n+type ledgerMemoCell[V any] struct {\n+\tonce  sync.Once\n+\tvalue V\n+\terr   error\n+}\n+\n+// ledgerMemoComputed sees each computation; tests count them.\n+var ledgerMemoComputed = func(key string) {}\n+\n+// memoizedLedgerRead returns compute's result, kept per key in the\n+// read-view operation of files; without an operation it computes every\n+// time. The bool reports whether the value came from the memo.\n+func memoizedLedgerRead[V any](files Files, key string, compute func() (V, error)) (V, bool, error) {\n+\tview, viewFiles := governanceReadViewFromFiles(files)\n+\tif view == nil || view.operation == nil || viewFiles == nil {\n+\t\t// Without an operation, or without the producer the reads are\n+\t\t// attributed to, every request computes and reads for itself.\n+\t\tledgerMemoComputed(key)\n+\t\tvalue, err := compute()\n+\t\treturn value, false, err\n+\t}\n+\t// A kept value is served only while the view is open, as a read is: a\n+\t// finalized view rejects it (review F4).\n+\tif err := view.begin(); err != nil {\n+\t\tvar zero V\n+\t\treturn zero, false, err\n+\t}\n+\tdefer view.end()\n+\t// A kept value is the producer's own: each producer reads once through\n+\t// the view, so the final audit attributes a changed input to every\n+\t// producer that consumed it (review N3).\n+\tkey += \"\\x00producer=\" + viewFiles.producer + \"\\x00project=\" + viewFiles.project\n+\tkept, _ := view.operation.ledgerMemo.LoadOrStore(key, &ledgerMemoCell[V]{})\n+\tcell := kept.(*ledgerMemoCell[V])\n+\tcomputed := false\n+\tcell.once.Do(func() {\n+\t\tcomputed = true\n+\t\tledgerMemoComputed(key)\n+\t\tcell.value, cell.err = compute()\n+\t})\n+\treturn cell.value, !computed, cell.err\n+}\n+\n+// copyReviewRuns gives a caller runs that share nothing with the kept ones:\n+// deepCopyValue copies every exported field, and the unexported ones are\n+// copied here (a reflection test holds this list to ReviewRun's fields).\n+func copyReviewRuns(runs []ReviewRun) []ReviewRun {\n+\tif runs == nil {\n+\t\treturn nil\n+\t}\n+\tout := make([]ReviewRun, len(runs))\n+\tfor i, run := range runs {\n+\t\tout[i] = deepCopyValue(run)\n+\t\tout[i].sessionForRedaction = run.sessionForRedaction\n+\t\tout[i].eventsDir = run.eventsDir\n+\t\tif run.eventsBytes != nil {\n+\t\t\tout[i].eventsBytes = append(make([]byte, 0, len(run.eventsBytes)), run.eventsBytes...)\n+\t\t}\n+\t}\n+\treturn out\n+}\ndiff --git a/pose-mcp/internal/pose/review_operation_view.go b/pose-mcp/internal/pose/review_operation_view.go\nindex 032c8a01..6a4bbbd4 100644\n--- a/pose-mcp/internal/pose/review_operation_view.go\n+++ b/pose-mcp/internal/pose/review_operation_view.go\n@@ -24,6 +24,28 @@ type reviewHeaderObservation struct {\n // readReviewBundleHeader is the same classification for cached and live reads.\n // A known different owner is skippable only after whole-JSON and ambiguity checks.\n func readReviewBundleHeader(files Files, dir, name string) reviewHeaderObservation {\n+\t// A bundle's header is read, hashed and classified once per operation:\n+\t// a closeout lists every bundle for every scope it verifies (spec\n+\t// pose-review-ledger-is-read-once-per-operation).\n+\tobservation, _, err := memoizedLedgerRead(files, \"bundle-header\\x00\"+filepath.Clean(dir)+\"\\x00\"+name, func() (reviewHeaderObservation, error) {\n+\t\treturn observeReviewBundleHeader(files, dir, name), nil\n+\t})\n+\tif err != nil {\n+\t\t// A refused read is a read error of the record, as before (review N2).\n+\t\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", name))\n+\t\tloss := SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossReadError, Detail: err.Error()}\n+\t\treturn reviewHeaderObservation{loss: &loss, readError: err.Error()}\n+\t}\n+\tif observation.loss != nil {\n+\t\tloss := *observation.loss\n+\t\tobservation.loss = &loss\n+\t}\n+\treturn observation\n+}\n+\n+// observeReviewBundleHeader reads one bundle's bytes and classifies the scope\n+// they declare.\n+func observeReviewBundleHeader(files Files, dir, name string) reviewHeaderObservation {\n \trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", name))\n \traw, err := files.ReadFile(filepath.Join(dir, name))\n \tif err != nil {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/internal/pose/review_ledger_memo_test.go; cat pose-mcp/internal/pose/review_operation_view.go; sed -n '240,400p' pose-mcp/internal/pose/review_dispatch.go; sed -n '1655,1735p' pose-mcp/internal/pose/review_dispatch.go; sed -n '3330,3485p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/internal/pose/review_ledger_memo_test.go; cat pose-mcp/internal/pose/review_operation_view.go; sed -n '240,400p' pose-mcp/internal/pose/review_dispatch.go; sed -n '1655,1735p' pose-mcp/internal/pose/review_dispatch.go; sed -n '3330,3485p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"package pose\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n)\n\n// countLedgerComputations counts every computation of a memoized ledger\n// value by the kind of value (the key's first field).\nfunc countLedgerComputations(t *testing.T) func() map[string]int {\n\tt.Helper()\n\tvar mu sync.Mutex\n\tcounts := map[string]int{}\n\tkeys := map[string]int{}\n\toriginal := ledgerMemoComputed\n\tledgerMemoComputed = func(key string) {\n\t\tmu.Lock()\n\t\tcounts[strings.SplitN(key, \"\\x00\", 2)[0]]++\n\t\tkeys[key]++\n\t\tmu.Unlock()\n\t}\n\tt.Cleanup(func() { ledgerMemoComputed = original })\n\treturn func() map[string]int {\n\t\tmu.Lock()\n\t\tdefer mu.Unlock()\n\t\tout := map[string]int{}\n\t\tfor kind, n := range counts {\n\t\t\tout[kind] = n\n\t\t}\n\t\tfor key, n := range keys {\n\t\t\tif n > out[\"max-per-key\"] {\n\t\t\t\tout[\"max-per-key\"] = n\n\t\t\t}\n\t\t\t_ = key\n\t\t}\n\t\treturn out\n\t}\n}\n\nfunc ledgerOperation(t *testing.T, store Store) Store {\n\tt.Helper()\n\tbase, view := store.beginGovernanceReadView()\n\tif view == nil || view.operation == nil {\n\t\tt.Fatal(\"no read-view operation\")\n\t}\n\treturn base.withGovernanceReadView(view, \"review\")\n}\n\n// Spec pose-review-ledger-is-read-once-per-operation, R1 and R2: every\n// verification of an operation after the first is answered without reading\n// or checking the ledger again.\nfunc TestReviewLedgerIsReadOncePerOperation(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tscope := f.bundle.Payload.Scope.Ref\n\tcounts := countLedgerComputations(t)\n\tscoped := ledgerOperation(t, f.store)\n\tfirst, err := scoped.VerifyReviewBundle(scope)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tafterFirst := counts()\n\tfor i := 0; i < 3; i++ {\n\t\tif _, err := scoped.VerifyReviewBundle(scope); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif _, _, err := scoped.ReadReviewRuns(run.BundleID); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tafter := counts()\n\tif afterFirst[\"review-runs\"] == 0 || afterFirst[\"transcript\"] == 0 || afterFirst[\"bundle-header\"] == 0 {\n\t\tt.Fatalf(\"the first verification read no ledger: %v\", afterFirst)\n\t}\n\tif after[\"max-per-key\"] != 1 || !reflect.DeepEqual(after, afterFirst) {\n\t\tt.Fatalf(\"later verifications read the ledger again: first %v, after %v\", afterFirst, after)\n\t}\n\tif !first.Approved {\n\t\tt.Fatalf(\"the fixture's verification is not approved: %v\", first.Blockers)\n\t}\n}\n\n// R3: a store with no read-view operation reads the ledger on every call.\nfunc TestReviewLedgerWithoutAnOperationIsReadEveryTime(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tcounts := countLedgerComputations(t)\n\tfor i := 0; i < 2; i++ {\n\t\tif _, _, err := f.store.ReadReviewRuns(run.BundleID); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif got := counts()[\"review-runs\"]; got != 2 {\n\t\tt.Fatalf(\"review runs read %d times without an operation, want 2\", got)\n\t}\n}\n\n// R4: the answers are the same with and without the memo, a lost record and\n// a caller that changes what it was given included.\nfunc TestReviewLedgerMemoAnswersAsAFreshRead(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tscope := f.bundle.Payload.Scope.Ref\n\tbroken := filepath.Join(f.store.Root, filepath.FromSlash(reviewRunsDir), \"rrn-0000000000000000.json\")\n\tif err := os.WriteFile(broken, []byte(\"{not json\"), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfreshRuns, freshLost, freshErr := f.store.ReadReviewRuns(run.BundleID)\n\tfreshAtt, freshAttErr := f.store.ReadReviewAttestations(run.BundleID)\n\tfresh, freshVerifyErr := f.store.VerifyReviewBundle(scope)\n\tscoped := ledgerOperation(t, f.store)\n\tfor i := 0; i < 2; i++ {\n\t\truns, lost, err := scoped.ReadReviewRuns(run.BundleID)\n\t\tif !reflect.DeepEqual(runs, freshRuns) || !reflect.DeepEqual(lost, freshLost) || (err == nil) != (freshErr == nil) {\n\t\t\tt.Fatalf(\"read %d: runs or losses differ from a fresh read: lost %v, want %v\", i, lost, freshLost)\n\t\t}\n\t\tif len(runs) > 0 {\n\t\t\truns[0].RunID = \"changed by the caller\"\n\t\t}\n\t\tatt, attErr := scoped.ReadReviewAttestations(run.BundleID)\n\t\tif !reflect.DeepEqual(att, freshAtt) || (attErr == nil) != (freshAttErr == nil) {\n\t\t\tt.Fatalf(\"read %d: attestations differ from a fresh read\", i)\n\t\t}\n\t\tif len(att.Attestations) > 0 {\n\t\t\tatt.Attestations[0].BundleID = \"changed by the caller\"\n\t\t}\n\t\tverification, err := scoped.VerifyReviewBundle(scope)\n\t\tif verification.Approved != fresh.Approved || verification.Fresh != fresh.Fresh || !reflect.DeepEqual(verification.Blockers, fresh.Blockers) || (err == nil) != (freshVerifyErr == nil) {\n\t\t\tt.Fatalf(\"read %d: verification differs from a fresh one: %v, want %v\", i, verification.Blockers, fresh.Blockers)\n\t\t}\n\t}\n\tif len(freshLost) == 0 {\n\t\tt.Fatal(\"the unreadable run was not reported as lost\")\n\t}\n}\n\n// Review F1: concurrent misses of one key in one operation compute once.\nfunc TestReviewLedgerMemoComputesOnceForConcurrentMisses(t *testing.T) {\n\tf, _ := approvedByARunThenDone(t)\n\tscoped := ledgerOperation(t, f.store)\n\tvar mu sync.Mutex\n\tcomputed := 0\n\trelease := make(chan struct{})\n\tvar wg sync.WaitGroup\n\tfor i := 0; i < 16; i++ {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tvalue, _, _ := memoizedLedgerRead(scoped.fsys(), \"concurrent\", func() (int, error) {\n\t\t\t\tmu.Lock()\n\t\t\t\tcomputed++\n\t\t\t\tmu.Unlock()\n\t\t\t\t<-release\n\t\t\t\treturn 7, nil\n\t\t\t})\n\t\t\tif value != 7 {\n\t\t\t\tt.Errorf(\"a waiter got %d\", value)\n\t\t\t}\n\t\t}()\n\t}\n\tclose(release)\n\twg.Wait()\n\tif computed != 1 {\n\t\tt.Fatalf(\"16 concurrent misses computed %d times, want 1\", computed)\n\t}\n}\n\n// Review F2 and F3: a caller that changes a nested field of what it was\n// given does not change a later answer, and an empty answer keeps its shape.\nfunc TestReviewLedgerMemoGivesIsolatedCopies(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tfreshAtt, _ := f.store.ReadReviewAttestations(run.BundleID)\n\tfreshNone, _ := f.store.ReadReviewAttestations(\"rvb-0000000000000000\")\n\tfreshRuns, _, _ := f.store.ReadReviewRuns(\"\")\n\tscoped := ledgerOperation(t, f.store)\n\tfor i := 0; i < 2; i++ {\n\t\tatt, _ := scoped.ReadReviewAttestations(run.BundleID)\n\t\tif !reflect.DeepEqual(att, freshAtt) {\n\t\t\tt.Fatalf(\"read %d: attestations differ from a fresh read\", i)\n\t\t}\n\t\tif len(att.Attestations) == 0 || len(att.Attestations[0].Criteria) == 0 {\n\t\t\tt.Fatal(\"the fixture's attestation has no criteria\")\n\t\t}\n\t\tatt.Attestations[0].Criteria[0].Disposition = \"changed by the caller\"\n\t\tnone, _ := scoped.ReadReviewAttestations(\"rvb-0000000000000000\")\n\t\tif !reflect.DeepEqual(none, freshNone) || (none.Attestations == nil) != (freshNone.Attestations == nil) {\n\t\t\tt.Fatalf(\"read %d: an empty answer changed shape: %#v, want %#v\", i, none.Attestations, freshNone.Attestations)\n\t\t}\n\t\truns, _, _ := scoped.ReadReviewRuns(\"\")\n\t\tif !reflect.DeepEqual(runs, freshRuns) {\n\t\t\tt.Fatalf(\"read %d: runs differ from a fresh read\", i)\n\t\t}\n\t\tif len(runs) > 0 {\n\t\t\truns[0].eventsBytes = append(runs[0].eventsBytes[:0:0], 'x')\n\t\t\truns[0].Argv = append(runs[0].Argv[:0:0], \"changed by the caller\")\n\t\t\tif len(runs[0].EnvRemoved) > 0 {\n\t\t\t\truns[0].EnvRemoved[0] = \"changed by the caller\"\n\t\t\t}\n\t\t\tif runs[0].Provenance != nil {\n\t\t\t\truns[0].Provenance.Project = \"changed by the caller\"\n\t\t\t}\n\t\t}\n\t}\n}\n\n// copyReviewRuns copies ReviewRun's unexported fields by name; a field added\n// later must be added there too.\nfunc TestCopyReviewRunsCoversEveryUnexportedField(t *testing.T) {\n\twant := map[string]bool{\"sessionForRedaction\": true, \"eventsBytes\": true, \"eventsDir\": true}\n\trunType := reflect.TypeOf(ReviewRun{})\n\tfor i := 0; i < runType.NumField(); i++ {\n\t\tfield := runType.Field(i)\n\t\tif !field.IsExported() && !want[field.Name] {\n\t\t\tt.Errorf(\"ReviewRun.%s is unexported and not copied by copyReviewRuns\", field.Name)\n\t\t}\n\t}\n}\n\n// Review F4: a kept value is not served once the operation's view is\n// finalized; the reader fails as a read through a finalized view does.\nfunc TestReviewLedgerMemoIsNotServedAfterTheOperationEnds(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tscoped := ledgerOperation(t, f.store)\n\tif _, _, err := scoped.ReadReviewRuns(run.BundleID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := scoped.ReadReviewAttestations(run.BundleID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tview, _ := governanceReadViewFromFiles(scoped.fsys())\n\tview.audit()\n\tif _, _, err := scoped.ReadReviewRuns(run.BundleID); !errors.Is(err, errGovernanceReadViewFinalized) {\n\t\tt.Fatalf(\"kept runs served after the operation ended: %v\", err)\n\t}\n\tif _, err := scoped.ReadReviewAttestations(run.BundleID); !errors.Is(err, errGovernanceReadViewFinalized) {\n\t\tt.Fatalf(\"kept attestations served after the operation ended: %v\", err)\n\t}\n}\n\n// Review N1 and N2: after the operation ends, a transcript check reports a\n// problem and a bundle header reports a read error, as reads would, instead\n// of an intact transcript or an unreported omission.\nfunc TestReviewLedgerMemoRefusalsStayVisible(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tscoped := ledgerOperation(t, f.store)\n\truns, _, err := scoped.ReadReviewRuns(run.BundleID)\n\tif err != nil || len(runs) == 0 {\n\t\tt.Fatalf(\"runs: %d %v\", len(runs), err)\n\t}\n\tif problem := scoped.reviewRunTranscriptIntact(runs[0]); problem != \"\" {\n\t\tt.Fatalf(\"the fixture's transcript is not intact: %s\", problem)\n\t}\n\tdir := filepath.Join(f.store.Root, \".pose\", \"review-bundles\")\n\tentries, err := os.ReadDir(dir)\n\tif err != nil || len(entries) == 0 {\n\t\tt.Fatalf(\"bundles: %v\", err)\n\t}\n\tif observation := readReviewBundleHeader(scoped.fsys(), dir, entries[0].Name()); observation.loss != nil {\n\t\tt.Fatalf(\"the fixture's bundle header has a loss: %+v\", observation.loss)\n\t}\n\tview, _ := governanceReadViewFromFiles(scoped.fsys())\n\tview.audit()\n\tif problem := scoped.reviewRunTranscriptIntact(runs[0]); problem == \"\" {\n\t\tt.Fatal(\"a transcript check after the operation ended reports an intact transcript\")\n\t}\n\tobservation := readReviewBundleHeader(scoped.fsys(), dir, entries[0].Name())\n\tif observation.loss == nil || observation.loss.Kind != LossReadError {\n\t\tt.Fatalf(\"a header read after the operation ended reports no read error: %+v\", observation)\n\t}\n}\n\n// Review N3: two producers that consume the ledger in one operation are both\n// attributed a change of it by the final audit.\nfunc TestReviewLedgerMemoAttributesEveryConsumingProducer(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tbase, view := f.store.beginGovernanceReadView()\n\tfirst := base.withGovernanceReadView(view, \"producer-a\")\n\tsecond := base.withGovernanceReadView(view, \"producer-b\")\n\tfor _, s := range []Store{first, second} {\n\t\tif _, _, err := s.ReadReviewRuns(run.BundleID); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\trecord := filepath.Join(f.store.Root, filepath.FromSlash(run.Path))\n\traw, err := os.ReadFile(record)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(record, append(raw, ' '), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\taudit := view.audit()\n\tfor _, producer := range []string{\"producer-a\", \"producer-b\"} {\n\t\tif !audit.ChangedProducers[producer] {\n\t\t\tt.Errorf(\"the audit does not attribute the changed ledger to %s: %v\", producer, audit.ChangedProducers)\n\t\t}\n\t}\n}\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n)\n\ntype reviewHeaderObservation struct {\n\towner      string\n\tloss       *SourceLoss\n\tdigest     [32]byte\n\treadError  string\n\tinputBytes int\n}\n\n// readReviewBundleHeader is the same classification for cached and live reads.\n// A known different owner is skippable only after whole-JSON and ambiguity checks.\nfunc readReviewBundleHeader(files Files, dir, name string) reviewHeaderObservation {\n\t// A bundle's header is read, hashed and classified once per operation:\n\t// a closeout lists every bundle for every scope it verifies (spec\n\t// pose-review-ledger-is-read-once-per-operation).\n\tobservation, _, err := memoizedLedgerRead(files, \"bundle-header\\x00\"+filepath.Clean(dir)+\"\\x00\"+name, func() (reviewHeaderObservation, error) {\n\t\treturn observeReviewBundleHeader(files, dir, name), nil\n\t})\n\tif err != nil {\n\t\t// A refused read is a read error of the record, as before (review N2).\n\t\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", name))\n\t\tloss := SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossReadError, Detail: err.Error()}\n\t\treturn reviewHeaderObservation{loss: &loss, readError: err.Error()}\n\t}\n\tif observation.loss != nil {\n\t\tloss := *observation.loss\n\t\tobservation.loss = &loss\n\t}\n\treturn observation\n}\n\n// observeReviewBundleHeader reads one bundle's bytes and classifies the scope\n// they declare.\nfunc observeReviewBundleHeader(files Files, dir, name string) reviewHeaderObservation {\n\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", name))\n\traw, err := files.ReadFile(filepath.Join(dir, name))\n\tif err != nil {\n\t\tloss := SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossReadError, Detail: err.Error()}\n\t\treturn reviewHeaderObservation{loss: &loss, readError: err.Error()}\n\t}\n\tresult := reviewHeaderObservation{digest: sha256.Sum256(raw), inputBytes: len(raw)}\n\t// What a bundle's bytes say about their scope is a function of the\n\t// bytes: it is parsed once per content digest, so a governance check\n\t// that reads every bundle for every scope parses each content once\n\t// (spec pose-federated-proof-reads-each-input-once).\n\tparsed := reviewBundleHeaderParses.get(string(result.digest[:]), func() (reviewBundleHeaderParse, bool) {\n\t\treturn parseReviewBundleHeader(raw, rel), true\n\t})\n\tresult.owner = parsed.owner\n\tif parsed.loss != nil {\n\t\tloss := *parsed.loss\n\t\tloss.Artifact = rel\n\t\tresult.loss = &loss\n\t}\n\treturn result\n}\n\n// parseReviewBundleHeader reads the scope a bundle's bytes declare, or why\n// they declare none.\nfunc parseReviewBundleHeader(raw []byte, rel string) reviewBundleHeaderParse {\n\tvar header struct {\n\t\tPayload struct {\n\t\t\tScope struct {\n\t\t\t\tRef string `json:\"ref\"`\n\t\t\t} `json:\"scope\"`\n\t\t} `json:\"payload\"`\n\t}\n\tvar loss SourceLoss\n\tswitch {\n\tcase json.Unmarshal(raw, &header) != nil:\n\t\tloss = attributeLoss(SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossParseError, Detail: \"the record is not valid JSON\"}, raw, \"payload\", \"scope\", \"ref\")\n\tcase func() bool { _, _, ambiguous := sniffJSONString(raw, \"payload\", \"scope\", \"ref\"); return ambiguous }():\n\t\tloss = SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossInvalid, Detail: \"the record names its scope more than once\"}\n\tcase header.Payload.Scope.Ref == \"\":\n\t\tloss = SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossParseError, Detail: \"the record names no scope\"}\n\tdefault:\n\t\treturn reviewBundleHeaderParse{owner: header.Payload.Scope.Ref}\n\t}\n\treturn reviewBundleHeaderParse{loss: &loss}\n}\n\n// reviewBundleHeaderParses keeps, per content digest, the scope a bundle\n// names or why it names none; bounded for a long-running process.\nvar reviewBundleHeaderParses = newKeptCache[reviewBundleHeaderParse](50000)\n\ntype reviewBundleHeaderParse struct {\n\towner string\n\tloss  *SourceLoss\n}\n\ntype reviewOperationView struct {\n\tcoordinator      *reviewOperationView\n\tcoordinatorStore Store\n\tscopeBase        Store\n\tscopeRoots       map[string]string\n\tscopeConflicts   map[string]bool\n\tscopeInit        sync.Once\n\tscopeInitErr     error\n\n\tspecOnce        sync.Once\n\tspecUsed        bool\n\tspecErr         error\n\tspecFallback    bool\n\tspecEntries     []Spec\n\tspecBySlug      map[string]int\n\tspecBodyMu      sync.Mutex\n\tspecBodySeen    []bool\n\tspecBodyDigests [][32]byte\n\tspecConflict    bool\n\troot            string\n\tfiles           Files\n\tproject         string\n\tresolver        *ArtifactResolver\n\tonce            sync.Once\n\tclosed          atomic.Bool\n\tcontextConflict atomic.Bool\n\tused            bool // published by once; consumers call once before inspecting it\n\tdirectoryError  string\n\tinventory       [32]byte\n\theaders         map[string]reviewHeaderObservation\n\tfallback        bool\n\tmaxRecords      int\n\tmaxInputBytes   int\n\tmaxRetainedText int\n}\n\n// WithReviewOperationView shares immutable headers and spec metadata for this\n// callback. Strict loading, ordering, trust and each worker's traversal remain\n// live. Finalization rereads observed bytes before the read can be green.\n// This is not an atomic filesystem snapshot or a write authorization cache.\nfunc (s Store) WithReviewOperationView(run func(Store)) error {\n\tbaseFiles := s.fsys()\n\tkeyable := reflect.ValueOf(baseFiles).Comparable()\n\tbase, readView := s.beginGovernanceReadView()\n\tshared := base.withGovernanceReadView(readView, \"review-operation\")\n\tview := &reviewOperationView{root: filepath.Clean(shared.Root), files: shared.fsys(),\n\t\tproject: shared.FederatedProjectID, resolver: shared.FederatedResolver,\n\t\tmaxRecords: 10000, maxInputBytes: 128 * 1024 * 1024, maxRetainedText: 8 * 1024 * 1024}\n\tvar operationErr error\n\tif !keyable {\n\t\t// Unknown identity cannot safely key the bounded optimization. The\n\t\t// operation still reads through the governance view and receives its\n\t\t// final closure audit; it simply falls back to live catalogue traversal.\n\t\tshared.reviewView = nil\n\t\tshared.specs = nil\n\t\tshared.reviewReuse = nil\n\t\trun(shared)\n\t} else {\n\t\toperationErr = shared.withReviewOperationView(view, run)\n\t}\n\taudit := readView.audit()\n\treturn errors.Join(operationErr, reviewOperationGovernanceAuditError(audit, readView, view))\n}\n\nfunc reviewOperationGovernanceAuditError(audit governanceReadViewAudit, readView *governanceReadView, operationView *reviewOperationView) error {\n\tvar result error\n\tchanged := audit.ChangedProducers[\"review-operation\"] || audit.ChangedProducers[\"projection\"]\n\tif changed {\n\t\tpaths := append([]string(nil), audit.ChangedPaths...)\n\t\tif len(paths) == 0 {\n\t\t\tpaths = []string{\"input closure\"}\n\t\t}\n\t\tresult = fmt.Errorf(\"pose: review inputs changed during operation: %s: %w\", strings.Join(uniqueSorted(paths), \", \"), ErrGovernanceReadViewChanged)\n\t}\n\t// The operation view certifies the bytes and metadata its review producers\n\t// consumed. Projection-only context such as an unavailable HEAD does not\n\t// become a write authorization or a current-generation claim here; any\n\t// unprovable read attributed to this operation still fails closed.\n\tif reasons := audit.UnknownProducers[\"review-operation\"]; len(reasons) > 0 && !reviewOperationReadLossIsCovered(audit, readView, operationView) {\n\t\tresult = errors.Join(result, fmt.Errorf(\"pose: review input closure is unknown: %s: %w\", strings.Join(uniqueSorted(reasons), \"; \"), ErrGovernanceReadViewUnknown))\n\t}\n\treturn result\n}\n\n// reviewOperationReadLossIsCovered keeps a stable, unreadable bundle in the\n// operation result as source-coverage loss. ReadReviewBundles reports that\n// loss to its caller, and validate() proves the same file remains unreadable;\n// this wrapper should not turn a localized record loss into a second API error.\n// Other unknown inputs still make the operation result unavailable.\nfunc reviewOperationReadLossIsCovered(audit governanceReadViewAudit, readView *governanceReadView, operationView *reviewOperationView) bool {\n\tif readView == nil || operationView == nil || !operationView.used || operationView.fallback {\n\t\treturn false\n\t}\n\tfor _, reason := range audit.UnknownProducers[\"review-operation\"] {\n\t\tif reason != \"input bytes could not be read\" {\n\t\t\treturn false\n\t\t}\n\t}\n\treadView.mu.Lock()\n\tdefer readView.mu.Unlock()\n\tcovered := map[string]string{}\n\tfor name, observation := range operationView.headers {\n\t\tif observation.readError == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif observation.loss == nil || observation.loss.Kind != LossReadError {\n\t\t\treturn false\n\t\t}\n\t\tcovered[filepath.Base(name)] = observation.readError\n\t}\n\tif len(covered) == 0 {\n\t\treturn false\n\t}\n\tmatched := 0\n\tfor path, observation := range readView.files {\n\t\tif !observation.producers[\"review-operation\"] || observation.err == nil || os.IsNotExist(observation.err) {\n\t\t\tcontinue\n\t\t}\n\t\trel, err := filepath.Rel(operationView.root, path)\n\t\tif err != nil || !strings.HasPrefix(filepath.ToSlash(rel), \".pose/review-bundles/\") {\n\t\t\treturn false\n\t\t}\n\t\tname := filepath.Base(path)\n\t\tif covered[name] == \"\" || covered[name] != observation.errText {\n\t\t\treturn false\n\t\t}\n\t\tdelete(covered, name)\n\t\tmatched++\n\t}\n\treturn matched > 0 && len(covered) == 0\n}\n\nfunc (s Store) withReviewOperationView(view *reviewOperationView, run func(Store)) error {\n\ts.reviewView = view\n\ts.specs = nil       // an earlier advisory listing is not this operation's capture\n\ts.reviewReuse = nil // copied worker stores each start their own traversal\n\tdefer view.closed.Store(true)\n\trun(s)\n\t// Join lazy initialization, if any; finalization must follow joined workers.\n\tview.once.Do(func() {})\n\tview.specOnce.Do(func() {})\n\treturn errors.Join(view.validateSpecs(), view.validate())\n}\n\n// prepareReviewOperationRead preserves Store's live-read behavior after an\n// operation view retires, while refusing to borrow an active view under a\n// different root, project, resolver, or Files binding.\nfunc (s Store) prepareReviewOperationRead() (Store, error) {\n\tif s.reviewView != nil && s.reviewView.closed.Load() {\n\t\ts = s.withoutGovernanceReadView()\n\t}\n\treadView, viewFiles := governanceReadViewFromFiles(s.fsys())\n\tif readView != nil {\n\t\treadView.mu.Lock()\n\t\tfinalized := readView.closed\n\t\treadView.mu.Unlock()\n\t\tif finalized {\n\t\t\ts = s.withoutGovernanceReadView()\n\t\t\treadView, viewFiles = governanceReadViewFromFiles(s.fsys())\n\t\t}\n\t}\n\tif s.reviewView != nil && !s.reviewView.closed.Load() && !s.reviewView.boundTo(s) {\n\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t}\n\tif readView != nil && viewFiles != nil {\n\t\tif s.FederatedProjectID != \"\" && viewFiles.project != \"\" && s.FederatedProjectID != viewFiles.project {\n\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t}\n\t\tif readView.operation == nil {\n\t\t\tif filepath.Clean(s.Root) != filepath.Clean(readView.root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t\t// A same-root advisory view may be attached directly to a local Store\n\t\t\t// without an operation coordinator. Keep that local read path usable,\n\t\t\t// but do not infer a federated identity or borrow a resolver binding.\n\t\t\tif s.FederatedProjectID != viewFiles.project || s.FederatedResolver != nil || viewFiles.project != \"\" {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t} else {\n\t\t\t// StoreFor(project) deliberately returns an unscoped Store whose Files\n\t\t\t// wrapper still carries the primary read view. Route by the captured\n\t\t\t// project/root vector first, then verify the selected root itself;\n\t\t\t// comparing against readView.root here would reject every valid child.\n\t\t\trouteProject := viewFiles.project\n\t\t\tif routeProject == \"\" {\n\t\t\t\trouteProject = s.FederatedProjectID\n\t\t\t}\n\t\t\tif routeProject == \"\" {\n\t\t\t\trouteProject = readView.operation.mainProject\n\t\t\t}\n\t\t\tif !sameLexicalRoot(readView.operation.initialRoots[routeProject], s.Root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t\ttarget := readView.operation.route(s.Root, viewFiles.producer, routeProject)\n\t\t\tif target == nil || !sameLexicalRoot(target.root, s.Root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t}\n\t}\n\treturn s, nil\n}\n\nfunc (s Store) refuseReviewOperationContext(readView *governanceReadView, viewFiles *governanceReadViewFiles) error {\n\tif s.reviewView != nil && !s.reviewView.closed.Load() {\n\t\ts.reviewView.contextConflict.Store(true)\n\t}\n\tif readView != nil {\n\t\tproducer := \"review-operation\"\n\t\tif viewFiles != nil && viewFiles.producer != \"\" {\n\t\t\tproducer = viewFiles.producer\n\t\t}\n\t\treadView.markUnknown(producer, \"review Store context no longer matches the authorized operation binding\")\n\t}\n\treturn fmt.Errorf(\"pose: review Store context changed: %w\", errGovernanceReadViewOutsideRoot)\n}\n\nfunc (v *reviewOperationView) captureSpecs(s Store) {\n\tv.specOnce.Do(func() {\n\t\tv.specUsed = true\n\t\tentries, err := s.listSpecs(\"\", \"\")\n\t\tv.specErr = err\n\t\tif err != nil {\n\t\t\treturn\n\t\t}\n\t\tif len(entries) > v.maxRecords {\n\t\t\tv.specFallback = true\n\t\t\treturn\n\t\t}\n\t\tretained := 0\n\t\tfor _, sp := range entries {\n\t\t\traw, _ := json.Marshal(sp)\n\t\t\tretained += len(raw)\n\t\t\tif retained > v.maxRetainedText {\n\t\t\t\tv.specFallback = true\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\tv.specEntries = entries\n\t\tv.specBySlug = make(map[string]int, len(entries))\n\t\tfor i, sp := range entries {\n\t\t\tif _, exists := v.specBySlug[sp.Slug]; exists {\n\t\t\t\tv.specBySlug[sp.Slug] = -1\n\t\t\t} else {\n\t\t\t\tv.specBySlug[sp.Slug] = i\n\t\t\t}\n\t\t}\n\t\tv.specBodySeen = make([]bool, len(entries))\n\t\tv.specBodyDigests = make([][32]byte, len(entries))\n\t})\n}\n\nfunc (s Store) reviewViewSpec(slug string) (*Spec, bool, error) {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil, false, nil\n\t}\n\tv.captureSpecs(s)\n\tif v.specFallback {\n\t\treturn nil, false, nil\n\t}\n\tif v.specErr != nil {\n\t\treturn nil, true, v.specErr\n\t}\n\tindex, exists := v.specBySlug[slug]\n\tif !exists {\n\t\treturn nil, true, fmt.Errorf(\"pose: spec %q not found\", slug)\n\t}\n\tif index < 0 {\n\t\treturn nil, true, SpecIdentityConflictError{Slug: slug}\n\t}\n\tfull, err := s.readListedSpec(cloneSpec(v.specEntries[index]))\n\treturn full, true, err\n}\n\nfunc (s Store) reviewViewSpecs(status, components string) ([]Spec, bool, error) {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil, false, nil\n\t}\n\tv.captureSpecs(s)\n\tif v.specFallback {\n\t\treturn nil, false, nil\n\t}\n\tif v.specErr != nil {\n\t\treturn nil, true, v.specErr\n\t}\n\twantedStatus, wantedComponents := splitStatusFilter(status), splitCommaFilter(components)\n\tresult := []Spec{}\n\tfor _, sp := range v.specEntries {\n\t\tif len(wantedStatus) > 0 && !statusMatchesAny(sp.Status, wantedStatus) {\n\t\t\tcontinue\n\t\t}\n\t\tif len(wantedComponents) > 0 && !componentsMatchAny(sp.Components, wantedComponents) {\n\t\t\tcontinue\n\t\t}\n\t\tresult = append(result, cloneSpec(sp))\n\t}\n\treturn result, true, nil\n}\n\nfunc (s Store) observeReviewSpecBody(listed Spec, full *Spec) error {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil\n\t}\n\tv.captureSpecs(s)\n\tif v.specFallback {\n\t\treturn nil\n\t}\n\tif v.specErr != nil {\n\t\treturn v.specErr\n\t}\n\tindex, exists := v.specBySlug[listed.Slug]\n\tmetadata := *full\n\tmetadata.Body = \"\"\n\tdigest := sha256.Sum256([]byte(full.Body))\n\tv.specBodyMu.Lock()\n\tdefer v.specBodyMu.Unlock()\n\tif !exists || index < 0 || !reflect.DeepEqual(metadata, v.specEntries[index]) || (v.specBodySeen[index] && v.specBodyDigests[index] != digest) {\n\t\tv.specConflict = true\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: spec %s\", listed.Slug)\n\t}\n\tv.specBodySeen[index] = true\n\tv.specBodyDigests[index] = digest\n\treturn nil\n}\n\nfunc (v *reviewOperationView) validateSpecs() error {\n\tif v.coordinator != nil {\n\t\tif v.specConflict {\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: consumed spec body: %w\", ErrGovernanceReadViewChanged)\n\t\t}\n\t\treturn nil\n\t}\n\tif !v.specUsed || v.specFallback {\n\t\treturn nil\n\t}\n\tstore := Store{Root: v.root, FS: v.files}\n\tcurrent, err := store.listSpecs(\"\", \"\")\n\tif v.specErr != nil {\n\t\tif err != nil && err.Error() == v.specErr.Error() {\n\t\t\treturn nil\n\t\t}\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: spec catalogue availability\")\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %w\", err)\n\t}\n\tif !reflect.DeepEqual(current, v.specEntries) {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: spec catalogue\")\n\t}\n\tv.specBodyMu.Lock()\n\tconflict := v.specConflict\n\tseen := append([]bool(nil), v.specBodySeen...)\n\tdigests := append([][32]byte(nil), v.specBodyDigests...)\n\tv.specBodyMu.Unlock()\n\tif conflict {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: consumed spec body\")\n\t}\n\tfor i, listed := range current {\n\t\tif !seen[i] {\n\t\t\tcontinue\n\t\t}\n\t\tfull, err := store.readListedSpec(listed)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %w\", err)\n\t\t}\n\t\tdigest := sha256.Sum256([]byte(full.Body))\n\t\tfull.Body = \"\"\n\t\tif digest != digests[i] || !reflect.DeepEqual(*full, listed) {\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: spec %s\", listed.Slug)\n\t\t}\n\t}\n\tcurrent, err = store.listSpecs(\"\", \"\")\n\tif err != nil || !reflect.DeepEqual(current, v.specEntries) {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: spec catalogue after body audit\")\n\t}\n\treturn nil\n}\n\nfunc (v *reviewOperationView) boundTo(s Store) bool {\n\tfiles := s.fsys()\n\treturn !v.closed.Load() && filepath.Clean(s.Root) == v.root &&\n\t\ts.FederatedProjectID == v.project && s.FederatedResolver == v.resolver &&\n\t\treflect.TypeOf(files) == reflect.TypeOf(v.files) && reflect.ValueOf(files).Comparable() && reflect.ValueOf(v.files).Comparable() && files == v.files\n}\n\nfunc reviewHeaderInventory(entries []os.DirEntry) [32]byte {\n\th := sha256.New()\n\tfor _, entry := range entries {\n\t\tif !entry.IsDir() && strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tfmt.Fprintf(h, \"%s\\x00%d\\x00\", entry.Name(), entry.Type())\n\t\t}\n\t}\n\tvar result [32]byte\n\tcopy(result[:], h.Sum(nil))\n\treturn result\n}\n\nfunc (v *reviewOperationView) observeDirectoryError(s Store, err error) {\n\tif v.boundTo(s) {\n\t\tv.once.Do(func() { v.used = true; v.directoryError = err.Error() })\n\t}\n}\n\nfunc (s Store) reviewBundleHeaders(dir string, entries []os.DirEntry) (map[string]reviewHeaderObservation, error) {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil, nil\n\t}\n\tv.once.Do(func() {\n\t\tv.used = true\n\t\tv.inventory = reviewHeaderInventory(entries)\n\t\theaders := map[string]reviewHeaderObservation{}\n\t\tinputBytes, textBytes := 0, 0\n\t\tfor _, entry := range entries {\n\t\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif len(headers) >= v.maxRecords {\n\t\t\t\tv.fallback = true\n\t\t\t\treturn\n\t\t\t}\n\t\t\tobservation := readReviewBundleHeader(v.files, dir, entry.Name())\n\t\t\tinputBytes += observation.inputBytes\n\t\t\ttextBytes += len(entry.Name()) + len(observation.owner) + len(observation.readError)\n\t\t\tif observation.loss != nil {\n\t\t\t\traw, _ := json.Marshal(observation.loss)\n\t\t\t\ttextBytes += len(raw)\n\t\t\t}\n\t\t\tif inputBytes > v.maxInputBytes || textBytes > v.maxRetainedText {\n\t\t\t\tv.fallback = true\n\t\t\t\treturn\n\t\t\t}\n\t\t\theaders[entry.Name()] = observation\n\t\t}\n\t\tv.headers = headers // publish only the complete immutable catalogue\n\t})\n\tif v.directoryError != \"\" || v.inventory != reviewHeaderInventory(entries) {\n\t\treturn nil, fmt.Errorf(\"pose: review inputs changed during operation: bundle directory\")\n\t}\n\tif v.fallback {\n\t\treturn nil, nil\n\t}\n\treturn v.headers, nil\n}\n\nfunc (v *reviewOperationView) validate() error {\n\tif v.contextConflict.Load() {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: Store context\")\n\t}\n\tif v.coordinator != nil || !v.used {\n\t\treturn nil\n\t}\n\tdir, err := ensureReviewArtifactDirIn(v.files, v.root, \".pose/review-bundles\", false)\n\tvar entries []os.DirEntry\n\tif err == nil {\n\t\tentries, err = v.files.ReadDir(dir)\n\t}\n\tif v.directoryError != \"\" {\n\t\tif err != nil && err.Error() == v.directoryError {\n\t\t\treturn nil\n\t\t}\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: bundle directory availability\")\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %w\", err)\n\t}\n\tif reviewHeaderInventory(entries) != v.inventory {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: bundle inventory\")\n\t}\n\tif v.fallback {\n\t\treturn nil\n\t} // no header observations were reused\n\tfor _, entry := range entries {\n\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tbefore := v.headers[entry.Name()]\n\t\traw, err := v.files.ReadFile(filepath.Join(dir, entry.Name()))\n\t\tif before.readError != \"\" {\n\t\t\tif err != nil && err.Error() == before.readError {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %s availability\", entry.Name())\n\t\t}\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %s: %w\", entry.Name(), err)\n\t\t}\n\t\tif sha256.Sum256(raw) != before.digest {\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %s bytes\", entry.Name())\n\t\t}\n\t}\n\treturn nil\n}\n\n// WithReviewCoordinator audits shared selection and catalogue inputs after all\n// scope callbacks join. Findings must be buffered until this method returns.\n// Scope operations certify their own closures, not a simultaneous batch snapshot.\nfunc (s Store) WithReviewCoordinator(run func(Store) error) error {\n\tvar callbackErr error\n\tauditErr := s.WithReviewOperationView(func(shared Store) {\n\t\tv := shared.reviewView\n\t\tif v == nil {\n\t\t\tcallbackErr = fmt.Errorf(\"pose: review coordinator requires comparable Files binding\")\n\t\t\treturn\n\t\t}\n\t\treadView, _ := governanceReadViewFromFiles(shared.fsys())\n\t\tv.scopeBase = readView.operation.baseStore\n\t\tv.scopeRoots = readView.operation.initialRoots\n\t\tv.scopeConflicts = readView.operation.initialConflicts\n\t\tv.coordinatorStore = shared\n\t\tcallbackErr = run(shared)\n\t})\n\treturn errors.Join(callbackErr, auditErr)\n}\n\n// reviewScopeCatalogue authorizes reuse against the exact coordinator Store,\n// and creates a separately bound catalogue consumer. It never unwraps Files.\ntype reviewScopeCatalogue interface {\n\tscopeCatalogue(Store) (Store, *reviewOperationView, error)\n}\n\nfunc (v *reviewOperationView) scopeCatalogue(s Store) (Store, *reviewOperationView, error) {\n\tif !v.boundTo(s) || v.coordinator != nil || v.coordinatorStore.reviewView != v {\n\t\treturn Store{}, nil, s.refuseReviewOperationContext(nil, nil)\n\t}\n\tv.scopeInit.Do(func() {\n\t\tshared := v.coordinatorStore\n\t\tv.captureSpecs(shared)\n\t\tif v.specErr != nil {\n\t\t\tv.scopeInitErr = v.specErr\n\t\t\treturn\n\t\t}\n\t\tdir, err := ensureReviewArtifactDirIn(v.files, v.root, \".pose/review-bundles\", false)\n\t\tif err != nil {\n\t\t\tv.observeDirectoryError(shared, err)\n\t\t\treturn\n\t\t}\n\t\tentries, err := v.files.ReadDir(dir)\n\t\tif err != nil {\n\t\t\tv.observeDirectoryError(shared, err)\n\t\t\treturn\n\t\t}\n\t\t_, v.scopeInitErr = shared.reviewBundleHeaders(dir, entries)\n\t})\n\tif v.scopeInitErr != nil {\n\t\treturn Store{}, nil, v.scopeInitErr\n\t}\n\treturn v.scopeBase, v, nil\n}\n\n// WithReviewScopeOperationView evaluates one scope, including recursive children\n// and authorized roots, with an independent bounded capture and final audit.\nfunc (s Store) WithReviewScopeOperationView(run func(Store) error) error {\n\tvar catalog reviewScopeCatalogue = s.reviewView\n\tif s.reviewView == nil {\n\t\treturn fmt.Errorf(\"pose: review scope requires an active coordinator\")\n\t}\n\tbase, parent, err := catalog.scopeCatalogue(s)\n\tif err != nil {\n\t\treturn err\n\t}\n\tbase, readView := base.beginGovernanceReadView()\n\tshared := base.withGovernanceReadView(readView, \"review-operation\")\n\tif !sameStringMap(parent.scopeRoots, readView.operation.initialRoots) || !sameBoolMap(parent.scopeConflicts, readView.operation.initialConflicts) {\n\t\treadView.markUnknown(\"review-operation\", \"scope authorized root vector differs from coordinator\")\n\t\treturn errors.Join(errGovernanceReadViewOutsideRoot, reviewOperationGovernanceAuditError(readView.audit(), readView, nil))\n\t}\n\t// The consumed index's inputs, the federated material among them, are the\n\t// same for every scope of the coordinator: they are checked once, under\n\t// the coordinator's view, whose audit runs after every scope joins (ADR\n\t// governance-reads-use-bounded-operation-scoped-views D12).\n\tif coordinatorView, _ := governanceReadViewFromFiles(parent.coordinatorStore.fsys()); coordinatorView != nil && coordinatorView.operation != nil {\n\t\treadView.operation.indexInputsFrom = coordinatorView.operation\n\t\treadView.operation.indexInputsFiles = parent.coordinatorStore.fsys()\n\t}\n\tview := &reviewOperationView{root: filepath.Clean(shared.Root), files: shared.fsys(), project: shared.FederatedProjectID, resolver: shared.FederatedResolver,\n\t\tcoordinator: parent, specUsed: parent.specUsed, specErr: parent.specErr, specFallback: parent.specFallback, specEntries: parent.specEntries, specBySlug: parent.specBySlug,\n\t\tspecBodySeen: make([]bool, len(parent.specEntries)), specBodyDigests: make([][32]byte, len(parent.specEntries)),\n\t\tused: parent.used, directoryError: parent.directoryError, inventory: parent.inventory, headers: parent.headers, fallback: parent.fallback,\n\t\tmaxRecords: parent.maxRecords, maxInputBytes: parent.maxInputBytes, maxRetainedText: parent.maxRetainedText}\n\tview.specOnce.Do(func() {})\n\tview.once.Do(func() {})\n\tvar callbackErr error\n\toperationErr := shared.withReviewOperationView(view, func(scoped Store) { callbackErr = run(scoped) })\n\taudit := readView.audit()\n\treturn errors.Join(callbackErr, operationErr, reviewOperationGovernanceAuditError(audit, readView, view))\n}\n\tReviewRunStale       = \"stale\"\n)\n\n// ListReviewRuns returns the recorded runs for bundleID (\"\" for all).\nfunc (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n\truns, _, err := s.ReadReviewRuns(bundleID)\n\treturn runs, err\n}\n\nfunc (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n\t// Within a read-view operation the ledger is read and checked once per\n\t// root; every request of the operation is answered from that read,\n\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n\t\truns, lost, err := s.readAllReviewRuns()\n\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n\t})\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tout := copyReviewRuns(all.runs)\n\tif bundleID != \"\" {\n\t\tfiltered := []ReviewRun{}\n\t\tfor _, run := range out {\n\t\t\tif run.BundleID == bundleID {\n\t\t\t\tfiltered = append(filtered, run)\n\t\t\t}\n\t\t}\n\t\tout = filtered\n\t}\n\treturn out, deepCopyValue(all.lost), nil\n}\n\n// readAllReviewRuns reads, checks and orders every review run of the store.\nfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n\tfiles := s.fsys()\n\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n\t// The storage is read where the writer writes it: a link in its place is another place.\n\tif info, lerr := files.Lstat(dir); lerr == nil {\n\t\tif info.Mode()&os.ModeSymlink != 0 {\n\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n\t\t}\n\t} else if !errors.Is(lerr, os.ErrNotExist) {\n\t\treturn nil, nil, lerr\n\t}\n\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n\t\t\treturn nil, nil, lerr\n\t\t}\n\t\treturn []ReviewRun{}, nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tout := []ReviewRun{}\n\tvar lost []string\n\treadBudget := int64(32 << 20)\n\tfor _, e := range entries {\n\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(dir, e.Name())\n\t\tinfo, infoErr := files.Lstat(full)\n\t\tif infoErr != nil || !info.Mode().IsRegular() {\n\t\t\tlost = append(lost, e.Name()+\" (not a regular file)\")\n\t\t\tcontinue\n\t\t}\n\t\tif info.Size() < 0 || info.Size() > reviewLedgerMaxBytes {\n\t\t\tlost = append(lost, e.Name()+\" (record exceeds bound or is unreadable)\")\n\t\t\tcontinue\n\t\t}\n\t\traw, err := readLedgerRawBudgetIn(files, full, &readBudget)\n\t\tif err != nil {\n\t\t\tlost = append(lost, e.Name()+\" (\"+err.Error()+\")\")\n\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tvar run ReviewRun\n\t\tif json.Unmarshal(raw, &run) != nil || run.RunID == \"\" {\n\t\t\tlost = append(lost, e.Name()+\" (not a review run)\")\n\t\t\tcontinue\n\t\t}\n\t\tif verr := validateReviewRunRecord(e.Name(), run); verr != nil {\n\t\t\tlost = append(lost, e.Name()+\" (\"+verr.Error()+\")\")\n\t\t\tcontinue\n\t\t}\n\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, e.Name()))\n\t\tout = append(out, run)\n\t}\n\tsort.Slice(out, func(i, j int) bool {\n\t\ta, _ := time.Parse(time.RFC3339Nano, out[i].StartedAt)\n\t\tb, _ := time.Parse(time.RFC3339Nano, out[j].StartedAt)\n\t\tif !a.Equal(b) {\n\t\t\treturn a.Before(b)\n\t\t}\n\t\treturn out[i].RunID < out[j].RunID\n\t})\n\tsuperseded := map[string]string{}\n\tfor _, run := range out {\n\t\tif run.Supersedes != \"\" {\n\t\t\tsuperseded[run.Supersedes] = run.RunID\n\t\t}\n\t}\n\tfor i := range out {\n\t\tout[i].SupersededBy = superseded[out[i].RunID]\n\t}\n\tchecked := map[string][]DelegatedReviewAttempt{}\n\tfor _, run := range out {\n\t\tif run.LedgerVersion == 1 {\n\t\t\tif _, err := files.Lstat(filepath.Join(s.Root, reviewRunLedgerDir, run.RunID+\".json\")); err != nil {\n\t\t\t\tlost = append(lost, \"missing run witness \"+run.RunID)\n\t\t\t}\n\t\t}\n\t\tif run.AttemptID != \"\" {\n\t\t\tattempts, ok := checked[run.BundleID]\n\t\t\tif !ok {\n\t\t\t\tvar aerr error\n\t\t\t\tattempts, aerr = s.readDelegatedReviewAttempts(run.BundleID, &readBudget)\n\t\t\t\tif aerr != nil {\n\t\t\t\t\tlost = append(lost, aerr.Error())\n\t\t\t\t}\n\t\t\t\tchecked[run.BundleID] = attempts\n\t\t\t}\n\t\t\t// The reservation names the attempt's first agent; a continuation's\n\t\t\t// agent is checked against its own predecessor by the continuation\n\t\t\t// chain (a resume keeps it, a handoff changes it).\n\t\t\tfound := false\n\t\t\tfor _, a := range attempts {\n\t\t\t\tif a.AttemptID == run.AttemptID && a.BundleDigest == run.BundleDigest && a.Scope == run.Scope && (a.Adapter == run.Adapter || run.continues() != \"\") && a.Reason == run.Reason {\n\t\t\t\t\tfound = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !found {\n\t\t\t\tlost = append(lost, \"missing or conflicting attempt reservation \"+run.AttemptID)\n\t\t\t}\n\t\t}\n\t}\n\tfindings, ledgerErr := s.reviewRunLedgerFindings(\"\", &readBudget)\n\tif ledgerErr != nil {\n\t\tlost = append(lost, ledgerErr.Error())\n\t}\n\tlost = append(lost, findings...)\n\tlost = append(lost, s.reviewContinuationFindings(out)...)\n\treturn out, uniqueSorted(lost), nil\n}\n\n// DispatchPlan is what a dispatch will do.\ntype DispatchPlan struct {\n\tprovenance          *ReviewRunProvenance\n\tPendingContinuation *PendingReviewContinuation\n\tprocessTimeout      time.Duration\n\tpredecessor         *ReviewRun\n\t// handoff makes the continuation another agent's, with handoffSection\n\t// appended to the brief (spec pose-delegation-handoff).\n\thandoff        bool\n\treturn nil\n}\n\nconst reviewTranscriptMaxBytes = 256 << 20\n\nfunc (s Store) reviewRunTranscriptIntact(run ReviewRun) string {\n\tproblem, _, err := memoizedLedgerRead(s.fsys(), \"transcript\\x00\"+filepath.Clean(s.Root)+\"\\x00\"+run.TranscriptPath+\"\\x00\"+run.TranscriptDigest, func() (string, error) {\n\t\treturn s.checkReviewRunTranscript(run), nil\n\t})\n\tif err != nil {\n\t\t// A refused read is not an intact transcript (review N1).\n\t\treturn \"the transcript of the run cannot be inspected: \" + err.Error()\n\t}\n\treturn problem\n}\n\n// checkReviewRunTranscript reads a run's transcript and checks it against\n// the digest the run names; it returns the problem, or \"\".\nfunc (s Store) checkReviewRunTranscript(run ReviewRun) string {\n\tfull := filepath.Join(s.Root, filepath.FromSlash(run.TranscriptPath))\n\tfiles := s.fsys()\n\tinfo, err := files.Lstat(full)\n\tif err != nil {\n\t\treturn \"the transcript of the run cannot be inspected: \" + err.Error()\n\t}\n\tif !info.Mode().IsRegular() {\n\t\treturn \"the transcript of the run is not a regular file\"\n\t}\n\tif info.Size() > reviewTranscriptMaxBytes {\n\t\treturn \"the transcript exceeds the 256 MiB verification bound\"\n\t}\n\tfile, err := files.Open(full)\n\tif err != nil {\n\t\treturn \"the transcript of the run cannot be read: \" + err.Error()\n\t}\n\topened, statErr := file.Stat()\n\tif statErr != nil || !opened.Mode().IsRegular() || !sameObservedFile(info, opened) {\n\t\tfile.Close()\n\t\treturn \"the transcript changed while opening\"\n\t}\n\thash := sha256.New()\n\tn, readErr := io.Copy(hash, io.LimitReader(file, reviewTranscriptMaxBytes+1))\n\tcloseErr := file.Close()\n\tif readErr != nil || closeErr != nil {\n\t\treturn fmt.Sprintf(\"the transcript could not be verified: %v %v\", readErr, closeErr)\n\t}\n\tif n > reviewTranscriptMaxBytes {\n\t\treturn \"the transcript exceeds the 256 MiB verification bound\"\n\t}\n\tif \"sha256:\"+hex.EncodeToString(hash.Sum(nil)) != run.TranscriptDigest {\n\t\treturn \"the transcript of the run is not the one its digest names\"\n\t}\n\treturn \"\"\n}\n\nfunc removedSides(entry ReviewBundleSubjectEntry) []string {\n\tswitch entry.Action {\n\tcase \"removed\":\n\t\tif p := reviewBundleEntryPath(entry); p != \"\" {\n\t\t\treturn []string{p}\n\t\t}\n\tcase \"renamed\":\n\t\tif entry.OldPath != \"\" {\n\t\t\treturn []string{entry.OldPath}\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc sealedInputsThatDiffer(sealed, other ReviewBundle, checkout string) []string {\n\tkey := func(kind, p string) string { return kind + \" \" + p }\n\tcollect := func(b ReviewBundle) map[string]string {\n\t\tout := map[string]string{}\n\t\tfor _, in := range b.Payload.Scope.Sections {\n\t\t\tout[key(in.Kind, in.Path)] = in.Digest\n\t\t}\n\t\tfor _, in := range b.Payload.ConsumedInputs {\n\t\t\tswitch in.Kind {\n\t\t\tcase \"governed-config\", \"review-profile\", \"rule\":\n\t\t\t\tout[key(in.Kind, in.Path)] = in.Digest\n\t\t\t}\ntype ReviewAttestationsRead struct {\n\tAttestations []ReviewAttestation\n\tCoverage     SourceCoverage\n}\n\n// ReadReviewAttestations lists attestations and reports the records it could not read,\n// attributed to the bundle their readable prefix names. With a bundle, a record that\n// names another bundle is not a loss for this one; one that names none is, because it may\n// be a rejection of this bundle.\nfunc (s Store) ReadReviewAttestations(bundleID string) (ReviewAttestationsRead, error) {\n\tread, _, err := memoizedLedgerRead(s.fsys(), \"review-attestations\\x00\"+filepath.Clean(s.Root)+\"\\x00\"+bundleID, func() (ReviewAttestationsRead, error) {\n\t\treturn s.readReviewAttestations(bundleID)\n\t})\n\tif err != nil {\n\t\treturn ReviewAttestationsRead{}, err\n\t}\n\treturn deepCopyValue(read), nil\n}\n\n// readReviewAttestations reads the store's review attestations, those of\n// bundleID when it is set, with the coverage of what could not be read.\nfunc (s Store) readReviewAttestations(bundleID string) (ReviewAttestationsRead, error) {\n\tcoverage := SourceCoverage{Losses: []SourceLoss{}}\n\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), false)\n\tif os.IsNotExist(err) {\n\t\treturn ReviewAttestationsRead{Attestations: []ReviewAttestation{}, Coverage: coverage}, nil\n\t}\n\tif err != nil {\n\t\treturn ReviewAttestationsRead{}, err\n\t}\n\tentries, err := s.fsys().ReadDir(dir)\n\tif os.IsNotExist(err) {\n\t\treturn ReviewAttestationsRead{Attestations: []ReviewAttestation{}, Coverage: coverage}, nil\n\t}\n\tif err != nil {\n\t\treturn ReviewAttestationsRead{}, err\n\t}\n\tresult := []ReviewAttestation{}\n\tfor _, entry := range entries {\n\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n\t\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", entry.Name()))\n\t\tif bundleID != \"\" {\n\t\t\traw, err := s.fsys().ReadFile(filepath.Join(dir, entry.Name()))\n\t\t\tif err != nil {\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossReadError, Detail: err.Error()})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tvar header struct {\n\t\t\t\tBundleID string `json:\"bundle_id\"`\n\t\t\t}\n\t\t\tif err := json.Unmarshal(raw, &header); err != nil {\n\t\t\t\tcoverage.Add(attributeLoss(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: \"the record is not valid JSON\"}, raw, \"bundle_id\"))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, _, ambiguous := sniffJSONString(raw, \"bundle_id\"); ambiguous {\n\t\t\t\t// A repeated name is valid JSON whose decoder keeps the last one: which\n\t\t\t\t// bundle the record belongs to is not settled, so it is not another's.\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossInvalid, Detail: \"the record names its bundle more than once\"})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif header.BundleID == \"\" {\n\t\t\t\t// Valid JSON that names no bundle is not another bundle's attestation.\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: \"the record names no bundle\"})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif header.BundleID != bundleID {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tatt, loadErr := s.LoadReviewAttestation(id)\n\t\tif loadErr != nil {\n\t\t\tif bundleID != \"\" {\n\t\t\t\treturn ReviewAttestationsRead{}, loadErr\n\t\t\t}\n\t\t\tloss := SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: loadErr.Error()}\n\t\t\tif raw, readErr := s.fsys().ReadFile(filepath.Join(dir, entry.Name())); readErr == nil {\n\t\t\t\tif futureSchema(raw) {\n\t\t\t\t\tloss.Kind, loss.Detail = LossUnsupported, \"the record has a schema_version this engine does not read\"\n\t\t\t\t}\n\t\t\t\tloss = attributeLoss(loss, raw, \"bundle_id\")\n\t\t\t} else {\n\t\t\t\tloss.Kind, loss.Detail = LossReadError, readErr.Error()\n\t\t\t}\n\t\t\tcoverage.Add(loss)\n\t\t\tcontinue\n\t\t}\n\t\tif bundleID == \"\" || att.BundleID == bundleID {\n\t\t\tresult = append(result, att)\n\t\t}\n\t}\n\tsort.Slice(result, func(i, j int) bool {\n\t\t// By instant: \"04:02-08:00\" is later than \"12:01Z\", whatever the text says.\n\t\treturn attestationLess(result[i], result[j])\n\t})\n\tcoverage.Normalize()\n\treturn ReviewAttestationsRead{Attestations: result, Coverage: coverage}, nil\n}\n\n// futureSchema reports well-formed JSON whose schema_version is one this engine does not read.\nfunc futureSchema(raw []byte) bool {\n\tvar header struct {\n\t\tSchemaVersion int `json:\"schema_version\"`\n\t}\n\tif json.Unmarshal(raw, &header) != nil {\n\t\treturn false\n\t}\n\treturn header.SchemaVersion > ReviewBundleSchemaVersion\n}\n\nfunc (s Store) VerifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tverification, err := s.verifyReviewBundle(scope)\n\tif err == nil && verification.Bundle != nil {\n\t\tassurance := s.DescribeReviewAssurance(*verification.Bundle, verification.Attestation)\n\t\tverification.Assurance = &assurance\n\t}\n\tif err == nil {\n\t\tverification.DelegatedRuns, verification.DelegatedHistoryLosses = s.reviewRunSummaries(scope)\n\t}\n\tif err == nil && verification.Bundle != nil {\n\t\tif round, rerr := s.ReviewRoundOf(*verification.Bundle); rerr != nil {\n\t\t\tverification.DelegatedHistoryLosses = append(verification.DelegatedHistoryLosses, \"the round cannot be derived: \"+rerr.Error())\n\t\t} else {\n\t\t\tverification.Round = round.Number\n\t\t\tpolicy, _, _, _ := s.LoadDelegationPolicy()\n\t\t\tif threshold := policy.Routing.RoundThresholdOf(); round.Number >= threshold {\n\t\t\t\tverification.Warnings = append(verification.Warnings, fmt.Sprintf(\"%s is in review round %d, at or past the round threshold %d: the rounds are not converging; consider a different agent or a human adjudication\", scope, round.Number, threshold))\n\t\t\t}\n\t\t}\n\t}\n\treturn verification, err\n}\n\n// verifyReviewBundle verifies scope once per operation of the same project and\n// resolver, and refuses a scope already being verified: sealed children are\n// data, and a cycle among them must end in a named refusal (spec\n// pose-review-approval-follows-children R6).\nfunc (s Store) verifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tstate := s.reviewReuse\n\tkey := fmt.Sprintf(\"%s\\x00%t\\x00%s\", s.Root, s.FederatedResolver != nil, scope)\n\tif result, ok := state.children[key]; ok {\n\t\treturn result.verification, result.err\n\t}\n\tif state.verifying[key] {\n\t\treturn ReviewBundleVerification{}, fmt.Errorf(\"pose: the sealed children of %s form a cycle\", scope)\n\t}\n\tstate.verifying[key] = true\n\tdefer delete(state.verifying, key)\n\tif s.onReviewVerify != nil {\n\t\ts.onReviewVerify(scope)\n\t}\n\tverification, err := s.proportionalReviewVerification(scope)\n","exit_code":0,"status":"completed"}}
