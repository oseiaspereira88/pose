e': 'pass', 'duration_seconds': 0.22218383}\n{'id': 'pose-mcp/go/trace-test-refs-integration', 'module': 'pose-mcp', 'stack': 'go', 'name': 'trace-test-refs-integration', 'program': 'go', 'args': ['test', './internal/pose', './internal/cli', '-run', 'TraceTestRefs', '-count=1'], 'severity': 'required', 'evidence_class': 'integration', 'outcome': 'pass', 'duration_seconds': 1.1454422690000001}\n{'id': 'pose-mcp/go/attest-preflight-integration', 'module': 'pose-mcp', 'stack': 'go', 'name': 'attest-preflight-integration', 'program': 'go', 'args': ['test', './internal/cli', '-run', 'AttestPreflight|ReviewRecordDelegatesToBundleAttestation|ReviewAttestationWontFixCannotApproveThroughCLI', '-count=1'], 'severity': 'required', 'evidence_class': 'integration', 'outcome': 'pass', 'duration_seconds': 1.095971159}\n{'id': 'pose-mcp/go/mcp-review-attest-integration', 'module': 'pose-mcp', 'stack': 'go', 'name': 'mcp-review-attest-integration', 'program': 'go', 'args': ['test', './internal/mcpserver', './internal/pose', '-run', 'ReviewAttest|ReviewPrepare|SignedPreview|EnvelopeOverOther|AgentConfirmation|PreviewBindsOnly', '-count=1'], 'severity': 'required', 'evidence_class': 'integration', 'outcome': 'pass', 'duration_seconds': 1.265362365}\n{'id': 'pose-mcp/go/test-scripts-remove-their-temp-files-integration', 'module': 'pose-mcp', 'stack': 'go', 'name': 'test-scripts-remove-their-temp-files-integration', 'program': 'bash', 'args': ['../tests/hygiene/temp-cleanup.sh'], 'severity': 'required', 'evidence_class': 'integration', 'outcome': 'pass', 'duration_seconds': 4.14948594}\n{'id': 'pose-mcp/go/review-ledger-is-read-once-per-operation-integration', 'module': 'pose-mcp', 'stack': 'go', 'name': 'review-ledger-is-read-once-per-operation-integration', 'program': 'go', 'args': ['test', './internal/pose', '-run', 'TestReviewLedgerIsReadOncePerOperation|TestReviewLedgerWithoutAnOperationIsReadEveryTime|TestReviewLedgerMemoAnswersAsAFreshRead|TestReviewLedgerMemoComputesOnceForConcurrentMisses|TestReviewLedgerMemoGivesIsolatedCopies|TestCopyReviewRunsCoversEveryUnexportedField|TestReviewLedgerMemoIsNotServedAfterTheOperationEnds|TestReviewLedgerMemoRefusalsStayVisible|TestReviewLedgerMemoAttributesEveryConsumingProducer', '-count=1'], 'severity': 'required', 'evidence_class': 'integration', 'outcome': 'pass', 'duration_seconds': 5.891645372}\n{'id': 'pose-mcp/go/review-cleanup-removes-go-build-leftovers-integration', 'module': 'pose-mcp', 'stack': 'go', 'name': 'review-cleanup-removes-go-build-leftovers-integration', 'program': 'go', 'args': ['test', './internal/pose', '-run', 'TestAdapterCleanupRemovesGoBuildLeftovers|TestAdapterContainmentCleanup', '-count=1'], 'severity': 'required', 'evidence_class': 'integration', 'outcome': 'pass', 'duration_seconds': 0.52592461}\n{'id': 'pose-mcp/go/release-cross-build-windows', 'module': 'pose-mcp', 'stack': 'go', 'name': 'release-cross-build-windows', 'program': 'go', 'args': ['build', '-o', '/dev/null', './cmd/pose'], 'env': {'GOARCH': 'amd64', 'GOOS': 'windows'}, 'severity': 'required', 'evidence_class': 'build', 'outcome': 'pass', 'duration_seconds': 6.553695548}\n{'id': 'pose-mcp/go/release-cross-build-darwin', 'module': 'pose-mcp', 'stack': 'go', 'name': 'release-cross-build-darwin', 'program': 'go', 'args': ['build', '-o', '/dev/null', './cmd/pose'], 'env': {'GOARCH': 'arm64', 'GOOS': 'darwin'}, 'severity': 'required', 'evidence_class': 'build', 'outcome': 'pass', 'duration_seconds': 6.867837582}\n{'id': 'pose-mcp/go/release-test-compile-windows', 'module': 'pose-mcp', 'stack': 'go', 'name': 'release-test-compile-windows', 'program': 'go', 'args': ['vet', './internal/pose'], 'env': {'GOARCH': 'amd64', 'GOOS': 'windows'}, 'severity': 'required', 'evidence_class': 'build', 'outcome': 'pass', 'duration_seconds': 9.224079525}\n{'id': 'pose-mcp/go/release-test-compile-darwin', 'module': 'pose-mcp', 'stack': 'go', 'name': 'release-test-compile-darwin', 'program': 'go', 'args': ['vet', './...'], 'env': {'GOARCH': 'arm64', 'GOOS': 'darwin'}, 'severity': 'required', 'evidence_class': 'build', 'outcome': 'pass', 'duration_seconds': 10.070345314}\n{'id': 'pose-mcp/go/cli-test-wall-time-integration', 'module': 'pose-mcp', 'stack': 'go', 'name': 'cli-test-wall-time-integration', 'program': 'go', 'args': ['test', './internal/cli', '-run', 'TestDelegateToolsOverMCPHoldAgainstTheFirstReview|TestDelegateToolsOverMCPMatchTheCLI|TestADetachedRun|TestDelegateDetachAndWait|TestTheWaitAcknowledgementNeverTouchesAnExistingEntry|TestReviewDispatchJudgesTheRunNotItsLeftovers|TestDelegateWatchFollowsLive|TestPreviewCarriesVerboseAndLsReadsLiveProgress', '-count=1'], 'severity': 'required', 'evidence_class': 'integration', 'outcome': 'pass', 'duration_seconds': 18.548166923}\ntype ReviewAttestation struct {\n\tRun           *ReviewRunReference     `json:\"run,omitempty\"`\n\tSchemaVersion int                     `json:\"schema_version\"`\n\tAttestationID string                  `json:\"attestation_id\"`\n\tBundleID      string                  `json:\"bundle_id\"`\n\tBundleDigest  string                  `json:\"bundle_digest\"`\n\tReviewer      string                  `json:\"reviewer\"`\n\tDecision      string                  `json:\"decision\"`\n\tLimitations   []string                `json:\"limitations,omitempty\"`\n\tCriteria      []ReviewCriterion       `json:\"criteria\"`\n\tTools         []ReviewToolDisposition `json:\"tools,omitempty\"`\n\tEvidenceRefs  []string                `json:\"evidence_refs,omitempty\"`\n\tFindings      []ReviewFinding         `json:\"findings\"`\n\tAuthority     *ReviewAuthorityClaim   `json:\"authority,omitempty\"`\n\t// Attribution separates who prepared, concluded, confirmed and applied\n\t// the review (spec pose-review-attribution-roles). Absent on every record\n\t// written before it, which renders as legacy-undifferentiated.\n\tAttribution *ReviewAttribution          `json:\"attribution,omitempty\"`\n\tReusedFrom  []ReviewAttestationReuse    `json:\"reused_from,omitempty\"`\n\tSupersedes  string                      `json:\"supersedes,omitempty\"`\n\tEnvelope    *ReviewAttestationSignature `json:\"envelope,omitempty\"`\n\tAttestedAt  string                      `json:\"attested_at\"`\n\tPath        string                      `json:\"path,omitempty\"`\n}\n\ntype ReviewAttestationEnvelope struct {\n\tSchemaVersion int               `json:\"schema_version\"`\n\tIssuer        string            `json:\"issuer\"`\n\tSubject       string            `json:\"subject\"`\n\tAlgorithm     string            `json:\"algorithm\"`\n\tPublicKey     string            `json:\"public_key\"`\n\tSignature     string            `json:\"signature\"`\n\tAttestation   ReviewAttestation `json:\"attestation\"`\n}\n\n// ReviewAttestationPendency is one answer the attestation still owes. It is\n// not a disposition: nothing is written for a pending criterion, because the\n// whole point is that no value stands in for the answer.\ntype ReviewAttestationPendency struct {\n\tCriterion string `json:\"criterion\"`\n\tKind      string `json:\"kind\"`\n\tReason    string `json:\"reason\"`\n\t// Code, Source and Condition type the pendency (spec\n\t// pose-typed-producer-diagnostics): which bundle owes it and what\n\t// satisfies it.\n\tCode      string `json:\"code,omitempty\"`\n\tSource    string `json:\"source,omitempty\"`\n\tCondition string `json:\"condition,omitempty\"`\n}\n\n// ReviewAttestationPreparation is what automation can honestly produce on its\n// own: every mechanical criterion answered from sealed evidence, and an\n// explicit list of what a reviewer still has to answer.\ntype ReviewAttestationPreparation struct {\n\tAttestation ReviewAttestation           `json:\"attestation\"`\n\tPending     []ReviewAttestationPendency `json:\"pending,omitempty\"`\n\tComplete    bool                        `json:\"complete\"`\n}\ntype ReviewRunProvenance struct {\n\tExecutionState        string        `json:\"execution_state\"`\n\tPlannedWireDigest     string        `json:\"planned_wire_digest\"`\n\tWireBytes             int64         `json:\"wire_bytes\"`\n\tWireComplete          bool          `json:\"wire_complete\"`\n\tSchemaVersion         int           `json:\"schema_version\"`\n\tProject               string        `json:\"project\"`\n\tAudience              string        `json:\"audience\"`\n\tWorktreeDigest        string        `json:\"worktree_digest\"`\n\tTrust                 string        `json:\"trust\"`\n\tImplementation        ModelIdentity `json:\"implementation\"`\n\tReviewer              ModelIdentity `json:\"reviewer\"`\n\tConfigDigest          string        `json:\"config_digest\"`\n\tCommandTemplateDigest string        `json:\"command_template_digest\"`\n\tArgvDigest            string        `json:\"argv_digest\"`\n\tExecutableDigest      string        `json:\"executable_digest\"`\n\tTemplateVersion       string        `json:\"template_version\"`\n\tWireDigest            string        `json:\"wire_digest\"`\n\tNotesDigest           string        `json:\"notes_digest\"`\n\tRawTranscriptDigest   string        `json:\"raw_transcript_digest\"`\n\tRawOutputDigest       string        `json:\"raw_output_digest\"`\n\tOutputSource          string        `json:\"output_source\"`\n\tOutputComplete        bool          `json:\"output_complete\"`\n}\ntype ReviewRunReference struct {\n\tRunID   string `json:\"run_id\"`\n\tProofID string `json:\"proof_id\"`\n}\ntype ReviewRunProofClaim struct {\n\tSchemaVersion    int    `json:\"schema_version\"`\n\tProject          string `json:\"project\"`\n\tAudience         string `json:\"audience\"`\n\tRunID            string `json:\"run_id\"`\n\tRecordDigest     string `json:\"record_digest\"`\n\tBundleDigest     string `json:\"bundle_digest\"`\n\tScope            string `json:\"scope\"`\n\tKind             string `json:\"kind\"`\n\tAttemptID        string `json:\"attempt_id\"`\n\tResumes          string `json:\"resumes,omitempty\"`\n\tTranscriptDigest string `json:\"transcript_digest\"`\n\tOutputDigest     string `json:\"output_digest\"`\n\tProvenanceDigest string `json:\"provenance_digest\"`\n\tIssuedAt         string `json:\"issued_at\"`\n\tExpiresAt        string `json:\"expires_at,omitempty\"`\n}\ntype ReviewRunProof struct {\n\tSchemaVersion int                 `json:\"schema_version\"`\n\tProofID       string              `json:\"proof_id,omitempty\"`\n\tIssuer        string              `json:\"issuer\"`\n\tAlgorithm     string              `json:\"algorithm\"`\n\tPublicKey     string              `json:\"public_key\"`\n\tSignature     string              `json:\"signature,omitempty\"`\n\tClaim         ReviewRunProofClaim `json:\"claim\"`\ntype ReviewExecutionSafety struct {\n\tSchemaVersion   int               `json:\"schema_version\"`\n\tProfile         string            `json:\"profile\"`\n\tPlatform        string            `json:\"platform\"`\n\tCapabilities    map[string]string `json:\"capabilities\"`\n\tLimitations     []string          `json:\"limitations\"`\n\tStreamBytes     int64             `json:\"stream_bytes\"`\n\tOutputBytes     int64             `json:\"output_bytes\"`\n\tRetainedBytes   int64             `json:\"retained_bytes\"`\n\tTimeoutMS       int64             `json:\"timeout_ms\"`\n\tMaxRuns         int               `json:\"max_runs_per_bundle\"`\n\tRetention       string            `json:\"retention\"`\n\tCaptureComplete bool              `json:\"capture_complete\"`\n\tRuntimeID       string            `json:\"runtime_id,omitempty\"`\n\tExecutionCause  string            `json:\"execution_cause,omitempty\"`\n\tOperation       OperationResult   `json:\"operation\"`\n}\n\nvar adapterEnvironmentName = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\n\nfunc effectiveReviewMaxRuns(a ReviewerAdapter) int {\n\tif a.MaxRunsPerBundle == 0 {\n\t\treturn 3\n\t}\n\treturn a.MaxRunsPerBundle\n}\n\n// ResolveReviewerContainment is shared by preview, execution and consumers.\n// It makes no changes, including attempt reservations.\nfunc ResolveReviewerContainment(a ReviewerAdapter) (*ReviewExecutionSafety, error) {\n\tsafety, err := resolveReviewerContainment(a)\n\treturn safety, refusal(DelegationReasonContainment, err)\n}\n\nfunc resolveReviewerContainment(a ReviewerAdapter) (*ReviewExecutionSafety, error) {\ntype DelegationRoutingRecord struct {\n\tRequested string `json:\"requested\"`\n\tPrefer    string `json:\"prefer,omitempty\"`\n\t// Implementation is the identity the run was routed against, and From\n\t// where it was read: the sealed bundle, the policy (a bundle sealed before\n\t// bundles recorded it), --lead, or none.\n\tImplementation     ReviewBundleImplementation   `json:\"implementation\"`\n\tImplementationFrom string                       `json:\"implementation_from\"`\n\tCandidates         []DelegationRoutingCandidate `json:\"candidates,omitempty\"`\n\tStep               string                       `json:\"step\"`\n\tWaitUntil          string                       `json:\"wait_until,omitempty\"`\n}\n\n// Where a routing implementation was read.\nconst (\n\tImplementationFromBundle = \"bundle\"\n\tImplementationFromPolicy = \"policy\"\n\tImplementationFromLead   = \"lead\"\n\tImplementationFromNone   = \"none\"\n\t// ImplementationFromSession is the launching session, the implementation\n\t// a task is routed against (spec pose-delegation-task R10).\n\tImplementationFromSession = \"session\"\n)\n\n// ErrNoDelegationAgentAvailable means routing found no agent it may start.\ntype ErrNoDelegationAgentAvailable struct{ Record DelegationRoutingRecord }\n\nfunc (e *ErrNoDelegationAgentAvailable) Error() string {\n\treasons := make([]string, 0, len(e.Record.Candidates))\n\tfor _, c := range e.Record.Candidates {\n\t\treasons = append(reasons, c.Agent+\": \"+c.Skipped)\n\t}\n\treturn \"pose: no agent is available for this run (\" + strings.Join(reasons, \"; \") + \")\"\n}\n","exit_code":0,"status":"completed"}}
