eStores)),\n\t\tlastScan:         roots.lastScan,\n\t\trescanWindow:     roots.rescanWindow,\n\t\tfs:               files,\n\t}\nmaterial provenance keys dict_keys(['artifact-claims-stop-at-the-section-end', 'calendar-dates-tolerate-utc-stamping', 'check-builds-the-delivery-graph-once', 'check-strict-verdict-names-its-mode', 'check-worker-count-is-the-machines', 'parse-the-delivery-index-once-per-content', 'pose-abm-atomic-start', 'pose-abm-authority-fixture-clock', 'pose-abm-capability-adoption', 'pose-abm-causality-attestation', 'pose-abm-contract-nodes', 'pose-abm-design-basis', 'pose-abm-doctor-state-health', 'pose-abm-governance-outcomes', 'pose-abm-progressive-review', 'pose-abm-remediation-lineage', 'pose-abm-retrospective-replay', 'pose-abm-review-authority', 'pose-abm-review-soundness', 'pose-abm-review-soundness-residuals', 'pose-abm-review-tool-deferred-without-delivery', 'pose-abm-state-followup-origins', 'pose-abm-structural-delta', 'pose-abm-subject-evidence', 'pose-action-answers-reverify-on-read', 'pose-action-request-presentation', 'pose-action-request-recovery-and-preflight', 'pose-action-request-resolution', 'pose-action-requests', 'pose-action-runtime-currency-gate', 'pose-action-target-and-node-scoping', 'pose-action-waiver-and-supersession-authority', 'pose-actions-node24-bump', 'pose-adaptive-assessment-freshness', 'pose-adaptive-rule-delivery', 'pose-adopt-request-keeps-the-reason', 'pose-adopt-request-shows-what-it-sets', 'pose-adoption-stamp-stays-readable', 'pose-agency-readiness-pilot', 'pose-agent-project-context', 'pose-agy-smoke-test', 'pose-amendment-history-holds-before-close', 'pose-artifact-provenance-ledger', 'pose-assessment-engine-precision', 'pose-assumption-validity-scope', 'pose-atomic-start-adoption-cutoff', 'pose-attention-federated-parity', 'pose-attention-lists-only-open-obligations', 'pose-attention-projects-every-source', 'pose-attention-within-a-second', 'pose-attest-records-not-applicable', 'pose-attest-refuses-what-v