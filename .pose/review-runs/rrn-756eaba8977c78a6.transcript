{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'SD-16da51ec|SD-55df3a37|SD-7d460311|design-5471fde61abf05ed' .pose/assessments .pose/review-bundles .pose/results; nl -ba pose-mcp/internal/pose/review_ledger_memo.go | head -85; nl -ba pose-mcp/internal/pose/review_ledger_memo_test.go | tail -95; rg -n 'func .*LoadReviewAttestation|type OperationResult|type SourceLoss' pose-mcp/internal/pose\"","aggregated_output":".pose/review-bundles/rvb-aa61bb656377ad01.json:710:            \"id\": \"SD-55df3a37\",\n.pose/review-bundles/rvb-fcdbee3d8ac391e9.json:710:            \"id\": \"SD-55df3a37\",\n.pose/review-bundles/rvb-7dfa88290fed19a5.json:717:            \"id\": \"SD-16da51ec\",\n.pose/review-bundles/rvb-7dfa88290fed19a5.json:724:            \"id\": \"SD-55df3a37\",\n     1\tpackage pose\n     2\t\n     3\timport \"sync\"\n     4\t\n     5\t// The review ledger of a project is read by every bundle verification an\n     6\t// operation makes: a closeout that verifies 64 federated dependencies read\n     7\t// pose-dist's ledger 280 times and checked transcript digests 29,680 times.\n     8\t// Within a read-view operation the view already returns the same bytes for\n     9\t// the same read, so a value derived only from those reads is the same on\n    10\t// every request: it is computed once and kept for the life of the operation\n    11\t// (spec pose-review-ledger-is-read-once-per-operation, ADR\n    12\t// governance-reads-use-bounded-operation-scoped-views D14). The first\n    13\t// computation reads through the view, so the operation's closure and final\n    14\t// audit cover every input as before.\n    15\t\n    16\ttype reviewRunsRead struct {\n    17\t\truns []ReviewRun\n    18\t\tlost []string\n    19\t}\n    20\t\n    21\t// ledgerMemoCell computes its value once: concurrent requests for the same\n    22\t// key wait for the one computation.\n    23\ttype ledgerMemoCell[V any] struct {\n    24\t\tonce  sync.Once\n    25\t\tvalue V\n    26\t\terr   error\n    27\t}\n    28\t\n    29\t// ledgerMemoComputed sees each computation; tests count them.\n    30\tvar ledgerMemoComputed = func(key string) {}\n    31\t\n    32\t// memoizedLedgerRead returns compute's result, kept per key in the\n    33\t// read-view operation of files; without an operation it computes every\n    34\t// time. The bool reports whether the value came from the memo.\n    35\tfunc memoizedLedgerRead[V any](files Files, key string, compute func() (V, error)) (V, bool, error) {\n    36\t\tview, viewFiles := governanceReadViewFromFiles(files)\n    37\t\tif view == nil || view.operation == nil || viewFiles == nil {\n    38\t\t\t// Without an operation, or without the producer the reads are\n    39\t\t\t// attributed to, every request computes and reads for itself.\n    40\t\t\tledgerMemoComputed(key)\n    41\t\t\tvalue, err := compute()\n    42\t\t\treturn value, false, err\n    43\t\t}\n    44\t\t// A kept value is served only while the view is open, as a read is: a\n    45\t\t// finalized view rejects it (review F4).\n    46\t\tif err := view.begin(); err != nil {\n    47\t\t\tvar zero V\n    48\t\t\treturn zero, false, err\n    49\t\t}\n    50\t\tdefer view.end()\n    51\t\t// A kept value is the producer's own: each producer reads once through\n    52\t\t// the view, so the final audit attributes a changed input to every\n    53\t\t// producer that consumed it (review N3).\n    54\t\tkey += \"\\x00producer=\" + viewFiles.producer + \"\\x00project=\" + viewFiles.project\n    55\t\tkept, _ := view.operation.ledgerMemo.LoadOrStore(key, &ledgerMemoCell[V]{})\n    56\t\tcell := kept.(*ledgerMemoCell[V])\n    57\t\tcomputed := false\n    58\t\tcell.once.Do(func() {\n    59\t\t\tcomputed = true\n    60\t\t\tledgerMemoComputed(key)\n    61\t\t\tcell.value, cell.err = compute()\n    62\t\t})\n    63\t\treturn cell.value, !computed, cell.err\n    64\t}\n    65\t\n    66\t// copyReviewRuns gives a caller runs that share nothing with the kept ones:\n    67\t// deepCopyValue copies every exported field, and the unexported ones are\n    68\t// copied here (a reflection test holds this list to ReviewRun's fields).\n    69\tfunc copyReviewRuns(runs []ReviewRun) []ReviewRun {\n    70\t\tif runs == nil {\n    71\t\t\treturn nil\n    72\t\t}\n    73\t\tout := make([]ReviewRun, len(runs))\n    74\t\tfor i, run := range runs {\n    75\t\t\tout[i] = deepCopyValue(run)\n    76\t\t\tout[i].sessionForRedaction = run.sessionForRedaction\n    77\t\t\tout[i].eventsDir = run.eventsDir\n    78\t\t\tif run.eventsBytes != nil {\n    79\t\t\t\tout[i].eventsBytes = append(make([]byte, 0, len(run.eventsBytes)), run.eventsBytes...)\n    80\t\t\t}\n    81\t\t}\n    82\t\treturn out\n    83\t}\n   206\t}\n   207\t\n   208\t// copyReviewRuns copies ReviewRun's unexported fields by name; a field added\n   209\t// later must be added there too.\n   210\tfunc TestCopyReviewRunsCoversEveryUnexportedField(t *testing.T) {\n   211\t\twant := map[string]bool{\"sessionForRedaction\": true, \"eventsBytes\": true, \"eventsDir\": true}\n   212\t\trunType := reflect.TypeOf(ReviewRun{})\n   213\t\tfor i := 0; i < runType.NumField(); i++ {\n   214\t\t\tfield := runType.Field(i)\n   215\t\t\tif !field.IsExported() && !want[field.Name] {\n   216\t\t\t\tt.Errorf(\"ReviewRun.%s is unexported and not copied by copyReviewRuns\", field.Name)\n   217\t\t\t}\n   218\t\t}\n   219\t}\n   220\t\n   221\t// Review F4: a kept value is not served once the operation's view is\n   222\t// finalized; the reader fails as a read through a finalized view does.\n   223\tfunc TestReviewLedgerMemoIsNotServedAfterTheOperationEnds(t *testing.T) {\n   224\t\tf, run := approvedByARunThenDone(t)\n   225\t\tscoped := ledgerOperation(t, f.store)\n   226\t\tif _, _, err := scoped.ReadReviewRuns(run.BundleID); err != nil {\n   227\t\t\tt.Fatal(err)\n   228\t\t}\n   229\t\tif _, err := scoped.ReadReviewAttestations(run.BundleID); err != nil {\n   230\t\t\tt.Fatal(err)\n   231\t\t}\n   232\t\tview, _ := governanceReadViewFromFiles(scoped.fsys())\n   233\t\tview.audit()\n   234\t\tif _, _, err := scoped.ReadReviewRuns(run.BundleID); !errors.Is(err, errGovernanceReadViewFinalized) {\n   235\t\t\tt.Fatalf(\"kept runs served after the operation ended: %v\", err)\n   236\t\t}\n   237\t\tif _, err := scoped.ReadReviewAttestations(run.BundleID); !errors.Is(err, errGovernanceReadViewFinalized) {\n   238\t\t\tt.Fatalf(\"kept attestations served after the operation ended: %v\", err)\n   239\t\t}\n   240\t}\n   241\t\n   242\t// Review N1 and N2: after the operation ends, a transcript check reports a\n   243\t// problem and a bundle header reports a read error, as reads would, instead\n   244\t// of an intact transcript or an unreported omission.\n   245\tfunc TestReviewLedgerMemoRefusalsStayVisible(t *testing.T) {\n   246\t\tf, run := approvedByARunThenDone(t)\n   247\t\tscoped := ledgerOperation(t, f.store)\n   248\t\truns, _, err := scoped.ReadReviewRuns(run.BundleID)\n   249\t\tif err != nil || len(runs) == 0 {\n   250\t\t\tt.Fatalf(\"runs: %d %v\", len(runs), err)\n   251\t\t}\n   252\t\tif problem := scoped.reviewRunTranscriptIntact(runs[0]); problem != \"\" {\n   253\t\t\tt.Fatalf(\"the fixture's transcript is not intact: %s\", problem)\n   254\t\t}\n   255\t\tdir := filepath.Join(f.store.Root, \".pose\", \"review-bundles\")\n   256\t\tentries, err := os.ReadDir(dir)\n   257\t\tif err != nil || len(entries) == 0 {\n   258\t\t\tt.Fatalf(\"bundles: %v\", err)\n   259\t\t}\n   260\t\tif observation := readReviewBundleHeader(scoped.fsys(), dir, entries[0].Name()); observation.loss != nil {\n   261\t\t\tt.Fatalf(\"the fixture's bundle header has a loss: %+v\", observation.loss)\n   262\t\t}\n   263\t\tview, _ := governanceReadViewFromFiles(scoped.fsys())\n   264\t\tview.audit()\n   265\t\tif problem := scoped.reviewRunTranscriptIntact(runs[0]); problem == \"\" {\n   266\t\t\tt.Fatal(\"a transcript check after the operation ended reports an intact transcript\")\n   267\t\t}\n   268\t\tobservation := readReviewBundleHeader(scoped.fsys(), dir, entries[0].Name())\n   269\t\tif observation.loss == nil || observation.loss.Kind != LossReadError {\n   270\t\t\tt.Fatalf(\"a header read after the operation ended reports no read error: %+v\", observation)\n   271\t\t}\n   272\t}\n   273\t\n   274\t// Review N3: two producers that consume the ledger in one operation are both\n   275\t// attributed a change of it by the final audit.\n   276\tfunc TestReviewLedgerMemoAttributesEveryConsumingProducer(t *testing.T) {\n   277\t\tf, run := approvedByARunThenDone(t)\n   278\t\tbase, view := f.store.beginGovernanceReadView()\n   279\t\tfirst := base.withGovernanceReadView(view, \"producer-a\")\n   280\t\tsecond := base.withGovernanceReadView(view, \"producer-b\")\n   281\t\tfor _, s := range []Store{first, second} {\n   282\t\t\tif _, _, err := s.ReadReviewRuns(run.BundleID); err != nil {\n   283\t\t\t\tt.Fatal(err)\n   284\t\t\t}\n   285\t\t}\n   286\t\trecord := filepath.Join(f.store.Root, filepath.FromSlash(run.Path))\n   287\t\traw, err := os.ReadFile(record)\n   288\t\tif err != nil {\n   289\t\t\tt.Fatal(err)\n   290\t\t}\n   291\t\tif err := os.WriteFile(record, append(raw, ' '), 0o600); err != nil {\n   292\t\t\tt.Fatal(err)\n   293\t\t}\n   294\t\taudit := view.audit()\n   295\t\tfor _, producer := range []string{\"producer-a\", \"producer-b\"} {\n   296\t\t\tif !audit.ChangedProducers[producer] {\n   297\t\t\t\tt.Errorf(\"the audit does not attribute the changed ledger to %s: %v\", producer, audit.ChangedProducers)\n   298\t\t\t}\n   299\t\t}\n   300\t}\npose-mcp/internal/pose/review_bundle.go:3295:func (s Store) LoadReviewAttestation(id string) (ReviewAttestation, error) {\npose-mcp/internal/pose/source_coverage.go:40:type SourceLoss struct {\npose-mcp/internal/pose/operation_result.go:14:type OperationResult struct {\n","exit_code":0,"status":"completed"}}
