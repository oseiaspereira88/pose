{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '272,395p' pose-mcp/internal/pose/review_dispatch.go; sed -n '1670,1725p' pose-mcp/internal/pose/review_dispatch.go; sed -n '3350,3445p' pose-mcp/internal/pose/review_bundle.go; cat .pose/rules/backend-go.md; cat .pose/rules/documentation-style.md; cat .pose/rules/knowledge-governance.md\"","aggregated_output":"\n// readAllReviewRuns reads, checks and orders every review run of the store.\nfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n\tfiles := s.fsys()\n\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n\t// The storage is read where the writer writes it: a link in its place is another place.\n\tif info, lerr := files.Lstat(dir); lerr == nil {\n\t\tif info.Mode()&os.ModeSymlink != 0 {\n\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n\t\t}\n\t} else if !errors.Is(lerr, os.ErrNotExist) {\n\t\treturn nil, nil, lerr\n\t}\n\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n\t\t\treturn nil, nil, lerr\n\t\t}\n\t\treturn []ReviewRun{}, nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tout := []ReviewRun{}\n\tvar lost []string\n\treadBudget := int64(32 << 20)\n\tfor _, e := range entries {\n\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(dir, e.Name())\n\t\tinfo, infoErr := files.Lstat(full)\n\t\tif infoErr != nil || !info.Mode().IsRegular() {\n\t\t\tlost = append(lost, e.Name()+\" (not a regular file)\")\n\t\t\tcontinue\n\t\t}\n\t\tif info.Size() < 0 || info.Size() > reviewLedgerMaxBytes {\n\t\t\tlost = append(lost, e.Name()+\" (record exceeds bound or is unreadable)\")\n\t\t\tcontinue\n\t\t}\n\t\traw, err := readLedgerRawBudgetIn(files, full, &readBudget)\n\t\tif err != nil {\n\t\t\tlost = append(lost, e.Name()+\" (\"+err.Error()+\")\")\n\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tvar run ReviewRun\n\t\tif json.Unmarshal(raw, &run) != nil || run.RunID == \"\" {\n\t\t\tlost = append(lost, e.Name()+\" (not a review run)\")\n\t\t\tcontinue\n\t\t}\n\t\tif verr := validateReviewRunRecord(e.Name(), run); verr != nil {\n\t\t\tlost = append(lost, e.Name()+\" (\"+verr.Error()+\")\")\n\t\t\tcontinue\n\t\t}\n\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, e.Name()))\n\t\tout = append(out, run)\n\t}\n\tsort.Slice(out, func(i, j int) bool {\n\t\ta, _ := time.Parse(time.RFC3339Nano, out[i].StartedAt)\n\t\tb, _ := time.Parse(time.RFC3339Nano, out[j].StartedAt)\n\t\tif !a.Equal(b) {\n\t\t\treturn a.Before(b)\n\t\t}\n\t\treturn out[i].RunID < out[j].RunID\n\t})\n\tsuperseded := map[string]string{}\n\tfor _, run := range out {\n\t\tif run.Supersedes != \"\" {\n\t\t\tsuperseded[run.Supersedes] = run.RunID\n\t\t}\n\t}\n\tfor i := range out {\n\t\tout[i].SupersededBy = superseded[out[i].RunID]\n\t}\n\tchecked := map[string][]DelegatedReviewAttempt{}\n\tfor _, run := range out {\n\t\tif run.LedgerVersion == 1 {\n\t\t\tif _, err := files.Lstat(filepath.Join(s.Root, reviewRunLedgerDir, run.RunID+\".json\")); err != nil {\n\t\t\t\tlost = append(lost, \"missing run witness \"+run.RunID)\n\t\t\t}\n\t\t}\n\t\tif run.AttemptID != \"\" {\n\t\t\tattempts, ok := checked[run.BundleID]\n\t\t\tif !ok {\n\t\t\t\tvar aerr error\n\t\t\t\tattempts, aerr = s.readDelegatedReviewAttempts(run.BundleID, &readBudget)\n\t\t\t\tif aerr != nil {\n\t\t\t\t\tlost = append(lost, aerr.Error())\n\t\t\t\t}\n\t\t\t\tchecked[run.BundleID] = attempts\n\t\t\t}\n\t\t\t// The reservation names the attempt's first agent; a continuation's\n\t\t\t// agent is checked against its own predecessor by the continuation\n\t\t\t// chain (a resume keeps it, a handoff changes it).\n\t\t\tfound := false\n\t\t\tfor _, a := range attempts {\n\t\t\t\tif a.AttemptID == run.AttemptID && a.BundleDigest == run.BundleDigest && a.Scope == run.Scope && (a.Adapter == run.Adapter || run.continues() != \"\") && a.Reason == run.Reason {\n\t\t\t\t\tfound = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !found {\n\t\t\t\tlost = append(lost, \"missing or conflicting attempt reservation \"+run.AttemptID)\n\t\t\t}\n\t\t}\n\t}\n\tfindings, ledgerErr := s.reviewRunLedgerFindings(\"\", &readBudget)\n\tif ledgerErr != nil {\n\t\tlost = append(lost, ledgerErr.Error())\n\t}\n\tlost = append(lost, findings...)\n\tlost = append(lost, s.reviewContinuationFindings(out)...)\n\treturn out, uniqueSorted(lost), nil\n}\n\n// DispatchPlan is what a dispatch will do.\ntype DispatchPlan struct {\n\tprovenance          *ReviewRunProvenance\n\tPendingContinuation *PendingReviewContinuation\n\n// checkReviewRunTranscript reads a run's transcript and checks it against\n// the digest the run names; it returns the problem, or \"\".\nfunc (s Store) checkReviewRunTranscript(run ReviewRun) string {\n\tfull := filepath.Join(s.Root, filepath.FromSlash(run.TranscriptPath))\n\tfiles := s.fsys()\n\tinfo, err := files.Lstat(full)\n\tif err != nil {\n\t\treturn \"the transcript of the run cannot be inspected: \" + err.Error()\n\t}\n\tif !info.Mode().IsRegular() {\n\t\treturn \"the transcript of the run is not a regular file\"\n\t}\n\tif info.Size() > reviewTranscriptMaxBytes {\n\t\treturn \"the transcript exceeds the 256 MiB verification bound\"\n\t}\n\tfile, err := files.Open(full)\n\tif err != nil {\n\t\treturn \"the transcript of the run cannot be read: \" + err.Error()\n\t}\n\topened, statErr := file.Stat()\n\tif statErr != nil || !opened.Mode().IsRegular() || !sameObservedFile(info, opened) {\n\t\tfile.Close()\n\t\treturn \"the transcript changed while opening\"\n\t}\n\thash := sha256.New()\n\tn, readErr := io.Copy(hash, io.LimitReader(file, reviewTranscriptMaxBytes+1))\n\tcloseErr := file.Close()\n\tif readErr != nil || closeErr != nil {\n\t\treturn fmt.Sprintf(\"the transcript could not be verified: %v %v\", readErr, closeErr)\n\t}\n\tif n > reviewTranscriptMaxBytes {\n\t\treturn \"the transcript exceeds the 256 MiB verification bound\"\n\t}\n\tif \"sha256:\"+hex.EncodeToString(hash.Sum(nil)) != run.TranscriptDigest {\n\t\treturn \"the transcript of the run is not the one its digest names\"\n\t}\n\treturn \"\"\n}\n\nfunc removedSides(entry ReviewBundleSubjectEntry) []string {\n\tswitch entry.Action {\n\tcase \"removed\":\n\t\tif p := reviewBundleEntryPath(entry); p != \"\" {\n\t\t\treturn []string{p}\n\t\t}\n\tcase \"renamed\":\n\t\tif entry.OldPath != \"\" {\n\t\t\treturn []string{entry.OldPath}\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc sealedInputsThatDiffer(sealed, other ReviewBundle, checkout string) []string {\n\tkey := func(kind, p string) string { return kind + \" \" + p }\n// bundleID when it is set, with the coverage of what could not be read.\nfunc (s Store) readReviewAttestations(bundleID string) (ReviewAttestationsRead, error) {\n\tcoverage := SourceCoverage{Losses: []SourceLoss{}}\n\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), false)\n\tif os.IsNotExist(err) {\n\t\treturn ReviewAttestationsRead{Attestations: []ReviewAttestation{}, Coverage: coverage}, nil\n\t}\n\tif err != nil {\n\t\treturn ReviewAttestationsRead{}, err\n\t}\n\tentries, err := s.fsys().ReadDir(dir)\n\tif os.IsNotExist(err) {\n\t\treturn ReviewAttestationsRead{Attestations: []ReviewAttestation{}, Coverage: coverage}, nil\n\t}\n\tif err != nil {\n\t\treturn ReviewAttestationsRead{}, err\n\t}\n\tresult := []ReviewAttestation{}\n\tfor _, entry := range entries {\n\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n\t\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", entry.Name()))\n\t\tif bundleID != \"\" {\n\t\t\traw, err := s.fsys().ReadFile(filepath.Join(dir, entry.Name()))\n\t\t\tif err != nil {\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossReadError, Detail: err.Error()})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tvar header struct {\n\t\t\t\tBundleID string `json:\"bundle_id\"`\n\t\t\t}\n\t\t\tif err := json.Unmarshal(raw, &header); err != nil {\n\t\t\t\tcoverage.Add(attributeLoss(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: \"the record is not valid JSON\"}, raw, \"bundle_id\"))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, _, ambiguous := sniffJSONString(raw, \"bundle_id\"); ambiguous {\n\t\t\t\t// A repeated name is valid JSON whose decoder keeps the last one: which\n\t\t\t\t// bundle the record belongs to is not settled, so it is not another's.\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossInvalid, Detail: \"the record names its bundle more than once\"})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif header.BundleID == \"\" {\n\t\t\t\t// Valid JSON that names no bundle is not another bundle's attestation.\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: \"the record names no bundle\"})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif header.BundleID != bundleID {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tatt, loadErr := s.LoadReviewAttestation(id)\n\t\tif loadErr != nil {\n\t\t\tif bundleID != \"\" {\n\t\t\t\treturn ReviewAttestationsRead{}, loadErr\n\t\t\t}\n\t\t\tloss := SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: loadErr.Error()}\n\t\t\tif raw, readErr := s.fsys().ReadFile(filepath.Join(dir, entry.Name())); readErr == nil {\n\t\t\t\tif futureSchema(raw) {\n\t\t\t\t\tloss.Kind, loss.Detail = LossUnsupported, \"the record has a schema_version this engine does not read\"\n\t\t\t\t}\n\t\t\t\tloss = attributeLoss(loss, raw, \"bundle_id\")\n\t\t\t} else {\n\t\t\t\tloss.Kind, loss.Detail = LossReadError, readErr.Error()\n\t\t\t}\n\t\t\tcoverage.Add(loss)\n\t\t\tcontinue\n\t\t}\n\t\tif bundleID == \"\" || att.BundleID == bundleID {\n\t\t\tresult = append(result, att)\n\t\t}\n\t}\n\tsort.Slice(result, func(i, j int) bool {\n\t\t// By instant: \"04:02-08:00\" is later than \"12:01Z\", whatever the text says.\n\t\treturn attestationLess(result[i], result[j])\n\t})\n\tcoverage.Normalize()\n\treturn ReviewAttestationsRead{Attestations: result, Coverage: coverage}, nil\n}\n\n// futureSchema reports well-formed JSON whose schema_version is one this engine does not read.\nfunc futureSchema(raw []byte) bool {\n\tvar header struct {\n\t\tSchemaVersion int `json:\"schema_version\"`\n\t}\n\tif json.Unmarshal(raw, &header) != nil {\n\t\treturn false\n\t}\n\treturn header.SchemaVersion > ReviewBundleSchemaVersion\n}\n\nfunc (s Store) VerifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tverification, err := s.verifyReviewBundle(scope)\n\tif err == nil && verification.Bundle != nil {\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Documentation Style\n\n## When to consult\n\nConsult this guide for process documentation, rules, specs, workflows, and operational instructions.\n\n## Required conventions\n\n- Write instructions in the imperative mood and begin them with action verbs.\n- Keep bullets short and limited to one idea.\n- Avoid duplicating sections with the same purpose across files.\n- Link to the single source of truth instead of copying its content.\n- Use `check`, `spec`, and `workflow` consistently.\n- State each instruction's scope explicitly to reduce ambiguity.\n\n## Examples: good and bad\n\n### Redundancy\n\n- **Good:** \"Update review criteria in `.pose/workflows/review.md` and reference that workflow from the root AGENTS file.\"\n- **Bad:** \"Repeat review criteria in AGENTS, the workflow, and every related spec.\"\n\n### Ambiguous reference\n\n- **Good:** \"Run the lint check described by the review workflow.\"\n- **Bad:** \"Run that standard validation before pushing.\"\n\n## Quick editorial checklist\n\n- Language is imperative and direct.\n- Bullets are short and non-overlapping.\n- Files do not duplicate sections.\n- `check`, `spec`, and `workflow` are used consistently.\n- References point to explicit files or paths.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Knowledge Governance\n\n## When to consult\n\nConsult this guide when creating, updating, reviewing, or removing artifacts under `.pose/knowledge/`.\n\n## TTL and retention\n\n- Set `expires_at` on every artifact when it is created.\n- Use a default TTL of 30 days for notes, decision logs, and handoffs.\n- Use a TTL of up to 90 days only with a justification recorded in the artifact body.\n- Treat an artifact without `expires_at` as non-compliant and block its creation or merge.\n\n## When this is not the right home\n\n- Use `.pose/knowledge/` only for time-bound operational memory: content\n  tied to a decision moment, a handoff between executions, or something\n  meant to be reviewed and eventually expire.\n- A durable fact or convention that will not become false and carries no\n  review trigger — a third-party tool's parsing quirk, a naming\n  convention, a recurring gotcha — is not a `decision-log` just because no\n  better type exists. Route it to `.pose/rules/` instead: add it to an\n  existing rule file or create one, then wire it into the relevant task\n  type's base `rules` array in `.pose/indexes/task-map.json` so\n  `pose suggest <task>` surfaces it automatically. No path scoping is\n  required — a task type's base `rules` list is returned regardless of\n  `--path`; only language/component-specific rules need the\n  `rules_by_domain` layer.\n- Rule of thumb: if nothing was decided or traded off, and nothing about\n  the fact will change on a predictable timeline, it is not a\n  `decision-log` and not an ADR — it is a rule. See ADR\n  `2026-08-15-durable-non-architectural-knowledge-belongs-in-rules-not-a-new-type`.\n\n## Reusable cross-execution format\n\n- Structure reusable context as a handoff with fixed sections: Context, Current state, Next checks, Risks, and Next owner.\n- Keep `source_refs` linked to the relevant spec, workflow, and executed check commands.\n- Record `last_reviewed_at` in the body to make effective cross-execution updates traceable.\n\n## Archiving and purging\n\n- Run biweekly triage to list expired artifacts.\n- Move expired artifacts to `.pose/knowledge/archive/` when they retain audit value.\n- Purge archived artifacts 180 days after expiration unless documented legal or compliance requirements apply.\n- Record every archive and purge action in the housekeeping log.\n\n## Sensitive content\n\n- Prohibit secrets, tokens, credentials, private keys, and equivalent material.\n- Prohibit personal data and non-anonymized customer data.\n- Do not copy restricted incidents or reports in full; keep only a controlled reference.\n- Classify frontmatter `sensitivity` as `public-internal` or `restricted`.\n- Remove identified sensitive content immediately and open a security follow-up.\n\n## Ownership and review\n\n- Keep `@pose-maintainers` as the primary governance owner.\n- Require an owner in every artifact frontmatter.\n- Review expiration biweekly and quality monthly.\n- Escalate a backlog overdue by more than two cycles to the primary owner.\n- Block backlog growth when `list-expired` exceeds the operational limit: zero in strict mode, two in tolerant mode.\n\n## Minimum operational checks\n\n- Run `pose knowledge-check --strict` biweekly to validate the expired backlog.\n- Run `pose knowledge-housekeeping list-expired` for detailed triage.\n- Run `pose knowledge-housekeeping archive-expired --dry-run` before applying changes.\n- Execute destructive actions only with an explicit `--apply` flag.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1220,1255p' pose-mcp/internal/pose/governance_read_view.go; sed -n '2080,2145p' pose-mcp/internal/pose/governance_read_view.go; sed -n '245,274p' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '85,175p' pose-mcp/internal/pose/cache_size.go; sed -n '148,236p' pose-mcp/internal/pose/review_dispatch.go; sed -n '485,565p' pose-mcp/internal/pose/review_run_continuity.go; rg -n 'review-ledger|bounded-operation-scoped|ledger memo' .pose/knowledge; rg -n 'ReadReviewRuns|reviewRunTranscriptIntact' pose-mcp/internal/pose/review_run_continuity.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1220,1255p' pose-mcp/internal/pose/governance_read_view.go; sed -n '2080,2145p' pose-mcp/internal/pose/governance_read_view.go; sed -n '245,274p' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '85,175p' pose-mcp/internal/pose/cache_size.go; sed -n '148,236p' pose-mcp/internal/pose/review_dispatch.go; sed -n '485,565p' pose-mcp/internal/pose/review_run_continuity.go; rg -n 'review-ledger|bounded-operation-scoped|ledger memo' .pose/knowledge; rg -n 'ReadReviewRuns|reviewRunTranscriptIntact' pose-mcp/internal/pose/review_run_continuity.go\"","aggregated_output":"\nfunc (v *governanceReadView) begin() error {\n\tv.mu.Lock()\n\tdefer v.mu.Unlock()\n\tif v.closed {\n\t\treturn errGovernanceReadViewFinalized\n\t}\n\tv.active++\n\treturn nil\n}\n\nfunc (v *governanceReadView) end() {\n\tv.mu.Lock()\n\tv.active--\n\tif v.active == 0 && v.cond != nil {\n\t\tv.cond.Broadcast()\n\t}\n\tv.mu.Unlock()\n}\n\nfunc (v *governanceReadView) displayPath(path string) string {\n\trel, err := filepath.Rel(v.root, path)\n\tif err == nil && rel != \"..\" && !strings.HasPrefix(rel, \"..\"+string(filepath.Separator)) {\n\t\treturn filepath.ToSlash(rel)\n\t}\n\treturn \"external:\" + digestBytes([]byte(filepath.Clean(path)))\n}\n\nfunc (v *governanceReadView) markUnknownLocked(producer, reason string) {\n\tif producer == \"\" {\n\t\tproducer = \"projection\"\n\t}\n\tif v.unknown[producer] == nil {\n\t\tv.unknown[producer] = map[string]bool{}\n\t}\n\tv.unknown[producer][reason] = true\nfunc (v *governanceReadView) audit() governanceReadViewAudit {\n\tif v.operation != nil && v.operation.primary == v {\n\t\treturn v.operation.audit()\n\t}\n\treturn v.auditSingle()\n}\n\nfunc (v *governanceReadView) auditSingle() governanceReadViewAudit {\n\treturn v.auditSingleWithBudget(&governanceReadViewAuditBudget{})\n}\n\nfunc (v *governanceReadView) auditSingleWithBudget(budget *governanceReadViewAuditBudget) governanceReadViewAudit {\n\tv.mu.Lock()\n\tv.closed = true\n\tfor v.active > 0 {\n\t\tv.cond.Wait()\n\t}\n\tobservations := make([]governanceReadObservation, 0, len(v.observed))\n\tfor _, o := range v.observed {\n\t\tcopy := *o\n\t\tcopy.producers = cloneBoolMap(o.producers)\n\t\tcopy.entries = append([]string(nil), o.entries...)\n\t\tcopy.dirEntries = cloneReadViewDir(o.dirEntries)\n\t\tobservations = append(observations, copy)\n\t}\n\tfiles := make(map[string]governanceReadFileObservation, len(v.files))\n\tfor path, item := range v.files {\n\t\tcopy := *item\n\t\t// Capture is closed and all active readers have joined. These bytes\n\t\t// are immutable and caller reads already receive independent buffers.\n\t\t// Keep the snapshot alive without duplicating the entire input budget.\n\t\tcopy.bytes = item.bytes\n\t\tcopy.producers = cloneBoolMap(item.producers)\n\t\tfiles[path] = copy\n\t}\n\tunknown := unknownReasons(v.unknown)\n\tv.mu.Unlock()\n\n\tresult := governanceReadViewAudit{ChangedProducers: map[string]bool{}, UnknownProducers: unknown}\n\t// One final listing serves the directory inventory and its Info observations.\n\t// Re-listing N entries for each of N Info calls charges an unchanged directory\n\t// quadratically and can exhaust an audit whose capture fits the same limits.\n\ttype directoryAudit struct {\n\t\tentries []fs.DirEntry\n\t\terr     error\n\t}\n\tdirectories := map[string]directoryAudit{}\n\tauditDirectory := func(path string) ([]fs.DirEntry, error) {\n\t\tif prior, ok := directories[path]; ok {\n\t\t\treturn prior.entries, prior.err\n\t\t}\n\t\tremainingRecords := governanceReadViewMaxRecords - budget.records\n\t\tremainingMetadata := governanceReadViewMaxMetadata - budget.metadata\n\t\tentries, err := readDirGovernanceBoundedWithBudget(v.base, path, remainingRecords, remainingMetadata)\n\t\tif err == nil && !budget.reserveDirectory(entries, remainingRecords, remainingMetadata) {\n\t\t\tentries, err = nil, errGovernanceReadViewBudget\n\t\t}\n\t\tdirectories[path] = directoryAudit{entries, err}\n\t\treturn entries, err\n\t}\n\tmarkBudgetFailure := func(path string, producers map[string]bool, reason string) {\n\t\tfor producer := range producers {\n\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], reason)\n\t\t}\n\t}\n\tfor _, item := range files {\nfunc governanceReadViewFromFiles(files Files) (*governanceReadView, *governanceReadViewFiles) {\n\tfor depth := 0; depth < maxGovernanceFilesWrappers; depth++ {\n\t\tfiles = FilesOrNative(files)\n\t\tif viewFiles, ok := files.(*governanceReadViewFiles); ok {\n\t\t\treturn viewFiles.view, viewFiles\n\t\t}\n\t\tif provider, ok := files.(interface{ GovernanceReadView() *governanceReadView }); ok {\n\t\t\tif view := provider.GovernanceReadView(); view != nil {\n\t\t\t\treturn view, nil\n\t\t\t}\n\t\t}\n\t\tunderlying, ok := files.(interface{ UnderlyingFiles() Files })\n\t\tif !ok {\n\t\t\treturn nil, nil\n\t\t}\n\t\tfiles = underlying.UnderlyingFiles()\n\t}\n\treturn nil, nil\n}\n\n// capture is also used while an authorized child root is being opened, before\n// a producer Files wrapper for that root exists. Root membership is checked\n// against the operation's already-bound roots.\nfunc (op *governanceReadViewOperation) capture(root, producer string, args ...string) ([]byte, error) {\n\treturn op.captureFiles(NativeFiles(), root, producer, args...)\n}\n\nfunc (op *governanceReadViewOperation) captureFiles(files Files, root, producer string, args ...string) ([]byte, error) {\n\treturn op.captureFilesBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n}\n\tcase reflect.Struct:\n\t\tfor i := 0; i < t.NumField(); i++ {\n\t\t\tif !isFlat(t.Field(i).Type) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\treturn true\n\t}\n\treturn false\n}\n\n// deepCopyValue copies a value so that the copy shares no slice, map or pointer with\n// the original. It covers every field by construction, so a field added later is\n// isolated without anyone remembering it; the graph keeps a hand-written copy only\n// because it is hot, and a reflection test holds that copy to the same standard.\nfunc deepCopyValue[T any](in T) T {\n\tout := reflect.New(reflect.TypeOf(in)).Elem()\n\tcopyInto(out, reflect.ValueOf(in))\n\treturn out.Interface().(T)\n}\n\nfunc copyInto(dst, src reflect.Value) {\n\tswitch src.Kind() {\n\tcase reflect.Struct:\n\t\tfor i := 0; i < src.NumField(); i++ {\n\t\t\tif dst.Field(i).CanSet() {\n\t\t\t\tcopyInto(dst.Field(i), src.Field(i))\n\t\t\t}\n\t\t}\n\tcase reflect.Slice:\n\t\tif src.IsNil() {\n\t\t\treturn\n\t\t}\n\t\ts := reflect.MakeSlice(src.Type(), src.Len(), src.Len())\n\t\tfor i := 0; i < src.Len(); i++ {\n\t\t\tcopyInto(s.Index(i), src.Index(i))\n\t\t}\n\t\tdst.Set(s)\n\tcase reflect.Map:\n\t\tif src.IsNil() {\n\t\t\treturn\n\t\t}\n\t\tm := reflect.MakeMapWithSize(src.Type(), src.Len())\n\t\titer := src.MapRange()\n\t\tfor iter.Next() {\n\t\t\tval := reflect.New(src.Type().Elem()).Elem()\n\t\t\tcopyInto(val, iter.Value())\n\t\t\tm.SetMapIndex(iter.Key(), val)\n\t\t}\n\t\tdst.Set(m)\n\tcase reflect.Ptr:\n\t\tif src.IsNil() {\n\t\t\treturn\n\t\t}\n\t\tp := reflect.New(src.Type().Elem())\n\t\tcopyInto(p.Elem(), src.Elem())\n\t\tdst.Set(p)\n\tcase reflect.Interface:\n\t\tif src.IsNil() {\n\t\t\treturn\n\t\t}\n\t\tinner := reflect.New(src.Elem().Type()).Elem()\n\t\tcopyInto(inner, src.Elem())\n\t\tdst.Set(inner)\n\tdefault:\n\t\tdst.Set(src)\n\t}\n}\ntype ReviewRun struct {\n\tSafety              *ReviewExecutionSafety `json:\"safety,omitempty\"`\n\tProvenance          *ReviewRunProvenance   `json:\"provenance,omitempty\"`\n\tsessionForRedaction string\n\teventsBytes         []byte\n\tResumes             string `json:\"resumes,omitempty\"`\n\t// ResumesSession marks a task that continued a session POSE never\n\t// recorded, named by its caller (spec pose-delegation-parity-gate SA-07).\n\tResumesSession bool `json:\"resumes_session,omitempty\"`\n\t// HandsOffFrom names the run this one continues with another agent, and\n\t// HandoffDigest the section its brief added (spec\n\t// pose-delegation-handoff R4, R5).\n\tHandsOffFrom  string `json:\"hands_off_from,omitempty\"`\n\tHandoffDigest string `json:\"handoff_digest,omitempty\"`\n\t// HandoffRenderer is the version of the renderer that listed the\n\t// predecessor's commands in the section; absent on runs recorded before it.\n\tHandoffRenderer  int                 `json:\"handoff_renderer,omitempty\"`\n\tInterruption     *ReviewInterruption `json:\"interruption,omitempty\"`\n\tSessionDigest    string              `json:\"session_digest,omitempty\"`\n\tTreeDigest       string              `json:\"tree_digest,omitempty\"`\n\tBriefNotes       string              `json:\"brief_notes,omitempty\"`\n\tPartialDigest    string              `json:\"partial_digest,omitempty\"`\n\tLimitOf          string              `json:\"limit_of,omitempty\"`\n\tLedgerVersion    int                 `json:\"ledger_version,omitempty\"`\n\tAttemptID        string              `json:\"attempt_id,omitempty\"`\n\tReason           string              `json:\"reason,omitempty\"`\n\tSchemaVersion    int                 `json:\"schema_version\"`\n\tRunID            string              `json:\"run_id\"`\n\tScope            string              `json:\"scope\"`\n\tBundleID         string              `json:\"bundle_id\"`\n\tBundleDigest     string              `json:\"bundle_digest\"`\n\tSealedCommit     string              `json:\"sealed_commit\"`\n\tKind             string              `json:\"kind\"`\n\tBriefDigest      string              `json:\"brief_digest\"`\n\tAdapter          string              `json:\"adapter\"`\n\tVendor           string              `json:\"vendor\"`\n\tModel            string              `json:\"model\"`\n\tStartedAt        string              `json:\"started_at\"`\n\tEndedAt          string              `json:\"ended_at\"`\n\tExitCode         int                 `json:\"exit_code\"`\n\tStatus           string              `json:\"status\"`\n\tFailure          string              `json:\"failure,omitempty\"`\n\tTranscriptDigest string              `json:\"transcript_digest\"`\n\tTranscriptPath   string              `json:\"transcript_path\"`\n\tOutput           string              `json:\"output\"`\n\tPolicyDigest     string              `json:\"policy_digest,omitempty\"`\n\tSupersedes       string              `json:\"supersedes,omitempty\"`\n\t// Label, Purpose and Lead are given by pose delegate; EnvRemoved names the\n\t// parent session variables the child did not receive (never their values);\n\t// Events and EventsDigest bind the normalized event stream kept beside\n\t// the transcript (spec pose-delegation-surface R8, R9, R11).\n\tLabel        string   `json:\"label,omitempty\"`\n\tPurpose      string   `json:\"purpose,omitempty\"`\n\tLead         string   `json:\"lead,omitempty\"`\n\tEnvRemoved   []string `json:\"env_removed,omitempty\"`\n\tEvents       string   `json:\"events,omitempty\"`\n\tEventsDigest string   `json:\"events_digest,omitempty\"`\n\tSupersededBy string   `json:\"superseded_by,omitempty\"`\n\t// Routing is how the run's agent was chosen and IndependenceAchieved what\n\t// it achieved against the implementation (spec pose-delegation-routing R8).\n\tRouting              *DelegationRoutingRecord `json:\"routing,omitempty\"`\n\tIndependenceAchieved string                   `json:\"independence_achieved,omitempty\"`\n\t// A task run (spec pose-delegation-task) records the access it ran with,\n\t// its directory and flags, the argv it ran, and the digests of the prompt\n\t// and the error stream kept beside its record; Recorded is --record.\n\tAccess       string   `json:\"access,omitempty\"`\n\tDir          string   `json:\"dir,omitempty\"`\n\tAddDirs      []string `json:\"add_dirs,omitempty\"`\n\tNoNetwork    bool     `json:\"no_network,omitempty\"`\n\tRecorded     bool     `json:\"recorded,omitempty\"`\n\tArgv         []string `json:\"argv,omitempty\"`\n\tPromptDigest string   `json:\"prompt_digest,omitempty\"`\n\tEffort       string   `json:\"effort,omitempty\"`\n\tStderrDigest string   `json:\"stderr_digest,omitempty\"`\n\t// Round is the round of the scope the run reviewed, DraftProblems what\n\t// keeps its draft from counting for that round, and Thread how its session\n\t// relates to the previous round's (spec\n\t// pose-delegated-review-round-protocol R1, R4, R6).\n\tRound         int           `json:\"round,omitempty\"`\n\tDraftProblems []string      `json:\"draft_problems,omitempty\"`\n\tThread        *ReviewThread `json:\"thread,omitempty\"`\n\tPath          string        `json:\"-\"`\n\t// eventsDir is where a task run's files are; a review run's are in\n\t// reviewRunsDir.\n\teventsDir string\n}\n\n// Review run states.\nconst (\nfunc (s Store) reviewContinuationFindings(runs []ReviewRun) []string {\n\tfiles := s.fsys()\n\tentries, e := ledgerEntriesIn(files, s.Root, reviewContinuationsDir)\n\tif e != nil {\n\t\treturn []string{e.Error()}\n\t}\n\tbyID := map[string]ReviewRun{}\n\tfor _, r := range runs {\n\t\tbyID[r.RunID] = r\n\t}\n\tclaims := map[string]reviewContinuation{}\n\treceipts := map[string]reviewAttemptReceipt{}\n\tlosses := []string{}\n\tbudget := int64(32 << 20)\n\tfor _, entry := range entries {\n\t\tif IsPublisherStaging(entry.Name()) {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(s.Root, reviewContinuationsDir, entry.Name())\n\t\tif strings.HasSuffix(entry.Name(), \".result.json\") {\n\t\t\tvar receipt reviewAttemptReceipt\n\t\t\tif e := readLedgerJSONBudgetIn(files, full, &receipt, &budget); e != nil {\n\t\t\t\tlosses = append(losses, e.Error())\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\treceipts[strings.TrimSuffix(entry.Name(), \".result.json\")] = receipt\n\t\t} else if strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tvar claim reviewContinuation\n\t\t\tif e := readLedgerJSONBudgetIn(files, full, &claim, &budget); e != nil {\n\t\t\t\tlosses = append(losses, e.Error())\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n\t\t\tprior, ok := byID[id]\n\t\t\tprior.Path, prior.SupersededBy = \"\", \"\"\n\t\t\traw, _ := json.Marshal(prior)\n\t\t\tif !ok || claim.SchemaVersion != 1 || claim.Predecessor != id || claim.AttemptID != prior.AttemptID || claim.PredecessorDigest != digestBytes(raw) {\n\t\t\t\tlosses = append(losses, \"missing or rewritten continuation predecessor \"+id)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif nonce, e := hex.DecodeString(claim.Nonce); e != nil || len(nonce) != 16 {\n\t\t\t\tlosses = append(losses, \"invalid continuation nonce\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, e := time.Parse(time.RFC3339Nano, claim.ClaimedAt); e != nil {\n\t\t\t\tlosses = append(losses, \"invalid continuation claim time\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tclaims[id] = claim\n\t\t} else {\n\t\t\tlosses = append(losses, \"unknown continuation artifact \"+entry.Name())\n\t\t}\n\t\tif budget <= 0 {\n\t\t\tlosses = append(losses, \"continuation inventory read budget exhausted\")\n\t\t\tbreak\n\t\t}\n\t}\n\tfor id, receipt := range receipts {\n\t\tclaim, ok := claims[id]\n\t\tnext, exists := byID[receipt.RunID]\n\t\tcopy := next\n\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n\t\traw, _ := json.Marshal(copy)\n\t\tif !ok || !exists || receipt.SchemaVersion != 1 || receipt.AttemptID != claim.AttemptID || next.AttemptID != claim.AttemptID || next.continues() != id || receipt.RunDigest != digestBytes(raw) {\n\t\t\tlosses = append(losses, \"missing or conflicting continuation result \"+id)\n\t\t}\n\t}\n\tchildren := map[string][]ReviewRun{}\n\tfor _, r := range runs {\n\t\tif r.Resumes != \"\" && r.HandsOffFrom != \"\" {\n\t\t\tlosses = append(losses, \"invalid continuation chain \"+r.RunID+\": both a resume and a handoff\")\n\t\t}\n\t\tif parentID := r.continues(); parentID != \"\" {\n\t\t\tprior, ok := byID[parentID]\n\t\t\t_, claimed := claims[parentID]\n\t\t\tsame := ok && claimed && r.AttemptID == prior.AttemptID && r.BundleDigest == prior.BundleDigest && r.BriefDigest == prior.BriefDigest && r.SealedCommit == prior.SealedCommit\n\t\t\tif r.Resumes != \"\" {\n\t\t\t\t// A resume continues the same agent and session, of a resumable stop.\n\t\t\t\tsame = same && prior.Status == ReviewRunInterrupted && prior.Interruption != nil && prior.Interruption.Resumable && r.Adapter == prior.Adapter && r.TreeDigest == prior.TreeDigest\n\t\t\t} else {\n\t\t\t\t// A handoff continues another agent, of any stop short of a conclusion.\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:119:- [ADR aceito](../adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md)\n360:\truns, lost, e := s.ReadReviewRuns(\"\")\n379:\tif why := s.reviewRunTranscriptIntact(*prior); why != \"\" {\n607:\truns, lost, e := s.ReadReviewRuns(\"\")\n","exit_code":0,"status":"completed"}}
