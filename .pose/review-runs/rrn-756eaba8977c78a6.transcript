{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'SD-|delivery-metadata' pose-mcp/internal/pose/design_delta.go; sed -n '2545,2635p' pose-mcp/internal/pose/review_bundle.go; sed -n '485,550p' pose-mcp/internal/pose/review_operation_view.go\"","aggregated_output":"158:\t\t\"delivery-metadata\",\n815:\tshort := \"SD-\" + hex.EncodeToString(sum[:4])\n818:\t\tdelta.DisplayID = \"SD-\" + hex.EncodeToString(sum[:6])\n925:\tcase \"delivery-metadata\":\n926:\t\treturn \"delivery-metadata\"\n946:\t\treturn \"delivery-metadata\"\nfunc (s Store) ReadReviewBundles(scope string) (ReviewBundlesRead, error) {\n\tvar err error\n\ts, err = s.prepareReviewOperationRead()\n\tif err != nil {\n\t\treturn ReviewBundlesRead{}, err\n\t}\n\tcoverage := SourceCoverage{Losses: []SourceLoss{}}\n\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\")), false)\n\tif err != nil && scope != \"\" && s.reviewView != nil {\n\t\ts.reviewView.observeDirectoryError(s, err)\n\t}\n\tif os.IsNotExist(err) {\n\t\treturn ReviewBundlesRead{Bundles: []ReviewBundle{}, Coverage: coverage}, nil\n\t}\n\tif err != nil {\n\t\treturn ReviewBundlesRead{}, err\n\t}\n\tentries, err := s.fsys().ReadDir(dir)\n\tif err != nil && scope != \"\" && s.reviewView != nil {\n\t\ts.reviewView.observeDirectoryError(s, err)\n\t}\n\tif os.IsNotExist(err) {\n\t\treturn ReviewBundlesRead{Bundles: []ReviewBundle{}, Coverage: coverage}, nil\n\t}\n\tif err != nil {\n\t\treturn ReviewBundlesRead{}, err\n\t}\n\tbundles := []ReviewBundle{}\n\tvar headers map[string]reviewHeaderObservation\n\tif scope != \"\" {\n\t\theaders, err = s.reviewBundleHeaders(dir, entries)\n\t\tif err != nil {\n\t\t\treturn ReviewBundlesRead{}, err\n\t\t}\n\t}\n\tfor _, entry := range entries {\n\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n\t\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", entry.Name()))\n\t\tif scope != \"\" {\n\t\t\tvar observation reviewHeaderObservation\n\t\t\tif headers != nil {\n\t\t\t\tobservation = headers[entry.Name()]\n\t\t\t} else {\n\t\t\t\tobservation = readReviewBundleHeader(s.fsys(), dir, entry.Name())\n\t\t\t}\n\t\t\tif observation.loss != nil {\n\t\t\t\tcoverage.Add(*observation.loss)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif observation.owner != scope {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tbundle, loadErr := s.LoadReviewBundle(id)\n\t\tif loadErr != nil {\n\t\t\tif scope != \"\" {\n\t\t\t\treturn ReviewBundlesRead{}, loadErr\n\t\t\t}\n\t\t\tloss := SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossParseError, Detail: loadErr.Error()}\n\t\t\tif raw, readErr := s.fsys().ReadFile(filepath.Join(dir, entry.Name())); readErr == nil {\n\t\t\t\tif futureSchema(raw) {\n\t\t\t\t\t// Well-formed JSON of a format this engine does not read.\n\t\t\t\t\tloss.Kind, loss.Detail = LossUnsupported, \"the record has a schema_version this engine does not read\"\n\t\t\t\t}\n\t\t\t\tloss = attributeLoss(loss, raw, \"payload\", \"scope\", \"ref\")\n\t\t\t} else {\n\t\t\t\tloss.Kind, loss.Detail = LossReadError, readErr.Error()\n\t\t\t}\n\t\t\tcoverage.Add(loss)\n\t\t\tcontinue\n\t\t}\n\t\tif scope == \"\" || bundle.Payload.Scope.Ref == scope {\n\t\t\tbundles = append(bundles, bundle)\n\t\t}\n\t}\n\ts.sortReviewBundles(bundles)\n\tcoverage.Normalize()\n\treturn ReviewBundlesRead{Bundles: bundles, Coverage: coverage}, nil\n}\n\n// sortReviewBundles puts bundles in the seal order every selection starts from.\nfunc (s Store) sortReviewBundles(bundles []ReviewBundle) {\n\tsort.Slice(bundles, func(i, j int) bool {\n\t\treturn reviewInstantLess(bundles[i].SealedAt, bundles[i].BundleID, bundles[j].SealedAt, bundles[j].BundleID)\n\t})\n\ts.orderTiedBundlesNegativeLast(bundles)\n}\n\nfunc (v *reviewOperationView) boundTo(s Store) bool {\n\tfiles := s.fsys()\n\treturn !v.closed.Load() && filepath.Clean(s.Root) == v.root &&\n\t\ts.FederatedProjectID == v.project && s.FederatedResolver == v.resolver &&\n\t\treflect.TypeOf(files) == reflect.TypeOf(v.files) && reflect.ValueOf(files).Comparable() && reflect.ValueOf(v.files).Comparable() && files == v.files\n}\n\nfunc reviewHeaderInventory(entries []os.DirEntry) [32]byte {\n\th := sha256.New()\n\tfor _, entry := range entries {\n\t\tif !entry.IsDir() && strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tfmt.Fprintf(h, \"%s\\x00%d\\x00\", entry.Name(), entry.Type())\n\t\t}\n\t}\n\tvar result [32]byte\n\tcopy(result[:], h.Sum(nil))\n\treturn result\n}\n\nfunc (v *reviewOperationView) observeDirectoryError(s Store, err error) {\n\tif v.boundTo(s) {\n\t\tv.once.Do(func() { v.used = true; v.directoryError = err.Error() })\n\t}\n}\n\nfunc (s Store) reviewBundleHeaders(dir string, entries []os.DirEntry) (map[string]reviewHeaderObservation, error) {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil, nil\n\t}\n\tv.once.Do(func() {\n\t\tv.used = true\n\t\tv.inventory = reviewHeaderInventory(entries)\n\t\theaders := map[string]reviewHeaderObservation{}\n\t\tinputBytes, textBytes := 0, 0\n\t\tfor _, entry := range entries {\n\t\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif len(headers) >= v.maxRecords {\n\t\t\t\tv.fallback = true\n\t\t\t\treturn\n\t\t\t}\n\t\t\tobservation := readReviewBundleHeader(v.files, dir, entry.Name())\n\t\t\tinputBytes += observation.inputBytes\n\t\t\ttextBytes += len(entry.Name()) + len(observation.owner) + len(observation.readError)\n\t\t\tif observation.loss != nil {\n\t\t\t\traw, _ := json.Marshal(observation.loss)\n\t\t\t\ttextBytes += len(raw)\n\t\t\t}\n\t\t\tif inputBytes > v.maxInputBytes || textBytes > v.maxRetainedText {\n\t\t\t\tv.fallback = true\n\t\t\t\treturn\n\t\t\t}\n\t\t\theaders[entry.Name()] = observation\n\t\t}\n\t\tv.headers = headers // publish only the complete immutable catalogue\n\t})\n\tif v.directoryError != \"\" || v.inventory != reviewHeaderInventory(entries) {\n\t\treturn nil, fmt.Errorf(\"pose: review inputs changed during operation: bundle directory\")\n\t}\n\tif v.fallback {\n\t\treturn nil, nil\n\t}\n\treturn v.headers, nil\n}\n","exit_code":0,"status":"completed"}}
