c runtimeHostedHandler(envDigest string, busy *atomic.Int64, lanes *hostedLanes) func(context.Context, worktreeruntime.Request) (worktreeruntime.Reply, bool) {\npose-mcp/internal/cli/runtime_host.go:83:\treturn func(ctx context.Context, req worktreeruntime.Request) (worktreeruntime.Reply, bool) {\npose-mcp/internal/cli/onboarding_context_test.go:74:func TestExtractProjectContextCombinesReadmeAndClaude(t *testing.T) {\npose-mcp/internal/cli/onboarding_context_test.go:87:func TestExtractProjectContextNeitherFilePresent(t *testing.T) {\npose-mcp/internal/cli/onboarding_context_test.go:94:func TestInjectExtractedProjectContextReplacesPlaceholderPrefixOnly(t *testing.T) {\npose-mcp/internal/cli/onboarding_context_test.go:107:func TestInjectExtractedProjectContextNoOpWithoutReadme(t *testing.T) {\npose-mcp/internal/cli/onboarding_context_test.go:117:func TestInstallExtractsProjectContextFromReadme(t *testing.T) {\npose-mcp/internal/cli/onboarding_context_test.go:156:func TestInstallPreservesHandEditedProjectContextOnRerun(t *testing.T) {\npose-mcp/internal/cli/cli.go:67:\tcase \"context\":\npose-mcp/internal/cli/cli.go:285:\tcase \"review\", \"review-plan\", \"review-check\", \"closeout-check\", \"close\", \"continuous-closeout\", \"artifact-check\", \"artifact-backfill\", \"surface-check\", \"roadmap-check\":\npose-mcp/internal/cli/cli.go:302:\t\tcase \"artifact-check\":\npose-mcp/internal/cli/cli.go:306:\t\tcase \"surface-check\":\npose-mcp/internal/cli/cli.go:508:  artifact-check | surface-check | roadmap-check | public-claims | docs-check\n# Adversarial corpus\n\nSpec: `pose-mechanization-adversarial-corpus`. Test: `adversarial_corpus_test.go`.\n\nEvery gate POSE adds against mechanical compliance can itself be satisfied\nmechanically. Each row is the cheapest formal satisfaction of one gate. An\n`enforced` case fails the build when the shortcut works again; a `known-gap`\ncase fails the build when the gap closes, so it cannot close or reopen\nsilently; a `planned` case belongs to a spec not yet delivered and gains code\nbefore that spec closes; a `delegated` case is enforced by a test in another\npackage, named in the row, whose existence the corpus checks.\n\nThis corpus belongs to developing POSE's governance. It adds no checklist to an\nadopting project's features.\n\n| Case | Status | Shortcut it refuses | Owner |\n|---|---|---|---|\n| `human-label-without-confirmation` | enforced | An agent writes and applies a review under `human:<name>`; the record reads as a human review | pose-review-attribution-roles |\n| `declared-independent-prefix` | enforced | `agent:independent-*` under declared assurance reads as authenticated separation | pose-review-assurance-disclosure |\n| `confirmation-reused-for-edited-content` | enforced | A confirmation recorded for one set of conclusions is kept after they change | pose-review-attribution-roles |\n| `unknown-recorded-as-satisfied` | enforced | An obligation the engine could not observe is reported as satisfied | pose-obligation-contract |\n| `legacy-blocker-gains-an-actor` | enforced | A blocker known only as text is given an invented recipient | pose-obligation-contract |\n| `blocked-counted-as-resolved` | enforced | Operational waiting counts as a resolved outcome in success metrics | pose-blocked-semantics-alignment |\n| `flat-specs-share-one-journal` | enforced | Two flat specs record amendments in one shared journal | pose-flat-spec-amendments |\n| `local-metadata-read-as-published` | enforced | A locally read version is presented as a proven publication | pose-public-claims-publication-provenance |\n| `invented-trace-test-ref` | known-gap | A requirement trace cites a test that does not exist and `lint-spec --strict` passes (follow-up 097 of pose-abm-design-basis) | pose-mechanization-adversarial-corpus |\n| `unavailable-producer-reads-as-empty` | enforced | A producer fails and Attention reports zero obligations as a complete answer | pose-obligation-projection |\n| `trivial-change-raises-a-request` | enforced | A trivial change or an already-authorized instruction produces an ActionRequest | pose-action-requests |\n| `declined-approval-satisfies` | enforced | A declined approval, or a cancellation without authority, releases a gate | pose-action-request-resolution |\n| `closeout-plan-fills-judgment` | enforced | The recoverable closeout plan answers a judgment criterion to finish | pose-recoverable-closeout-plan |\n| `ready-from-absent-blockers` | enforced | Absence of a known blocker is presented as proven independence | pose-phase-scoped-readiness |\n| `stale-preview-authorizes-apply` | enforced | A start previewed before a restricting request is applied after it | pose-governed-effect-enforcement |\n| `code-change-keeps-judgment` | enforced | The reviewed code changes and every criterion still reads as equivalent, so the old judgment is reused | pose-material-equivalence-reuse |\n| `minimal-surface-skips-trace` | enforced | A done spec declares the minimal surface to drop its requirement trace | pose-progressive-spec-surface |\n| `stale-assessment-reused` | enforced | The assessed component changes and the old assessment still reads as fresh | pose-adaptive-assessment-freshness |\n| `unpinned-premise-trigger-reads-current` | enforced | A premise trigger without a pin can never go stale and nothing says so | pose-assumption-validity-scope |\n| `calendar-ttl-as-premise-trigger` | enforced | An arbitrary expiry date is accepted as the material trigger of a premise | pose-assumption-validity-scope |\n| `unobserved-falsifier-reads-uncontradicted` | enforced | An unbound legacy index cannot prove that a falsifier check was never observed | pose-falsifier-reconsideration |\n| `parity-row-cites-an-unrelated-test` | known-gap | A launcher parity row names a real but unrelated `pose delegate` command and an existing test that does not exercise the capability, and the parity check passes; the check proves existence, review of the cited tests proves coverage | pose-delegation-parity-gate |\n| `imported-fragment-completes-a-replaced-command` | known-gap | A usage or error string assembles a removed command from a constant of another package of the module, which the active-document check reads as a gap; review of assembled messages is the defence | pose-delegation-parity-gate |\n| `cgo-preamble-text-reaches-usage` | known-gap | Operator text written as a C string in a cgo preamble reaches a usage surface; the Go reader sees a comment, not a string | pose-delegation-parity-gate |\n| `later-removal-hides-a-later-touch` | delegated | A later removal satisfies an earlier spec's claim because the history it is judged on omits that spec's change after the removal — change sets in ID order, a merge, root or type-change touch, a failed or shallow read, a recorded report too wide to read whole or a history directory that cannot be listed, a replace ref or graft (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_gaps_test.go:TestLaterRemovalReviewRoundTwo`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundFive`) | pose-delivery-later-removal |\n| `rename-read-as-removal` | delegated | A rename, or a path spelled as a pathspec, is taken for the declared deletion (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`) | pose-delivery-later-removal |\n| `recorded-commit-is-an-option` | delegated | A change set read from a recorded report names a Git option or a tag where a commit belongs (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`) | pose-delivery-later-removal |\n| `peer-removal-stands-for-a-member` | delegated | A review subject digests a removed path from a peer's accepted removal while another observing member — sorted later, sharing a commit, or reduced into the peer's set — has none, whatever action or rename it observed the path with (`pose/review_subject_later_removal_test.go:TestReviewSubjectReadsALaterRemovalFromItsWitness`, `pose/review_subject_later_removal_test.go:TestMilestoneSubjectRemovalHoldsForEveryMember`) | pose-review-subject-later-removal |\n| `retained-child-skips-its-verification` | delegated | A milestone seals over a done member whose own review verification no longer retains its approval — revoked federated trust, lost history, a later negative review (`pose/review_subject_later_removal_test.go:TestRetainedChildFollowsItsVerification`, `pose/review_subject_later_removal_test.go:TestMilestoneSealRetainsADoneChildsApprovedReview`) | pose-review-subject-later-removal |\n| `run-pattern-names-no-test` | delegated | A validation check's `-run` alternative names a test that no longer exists, or never did, and the check passes on Go's exit 0 — through `-run=`, a build-excluded or ignored file, a vendored or nested-module declaration, a benchmark or a name Go does not run (`cli/validation_matrix_patterns_test.go:TestDeadRunPatternGuardFollowsGoSelection`, `cli/validation_matrix_patterns_test.go:TestValidationMatrixRunPatternsNameExistingTests`); a non-plain pattern passes only when listed with its reason | pose-validation-matrix-dead-test-patterns |\n| `removal-witness-outlives-its-history` | delegated | A stale index keeps counting a removal after a later touch, through a merge, a rewritten history or a shallow clone that lost the touch (`pose/removal_witness_freshness_test.go:TestLaterTouchRefusesTheWitness`, `pose/removal_witness_freshness_test.go:TestShallowHistoryRefusesTheWitness`) | pose-removal-witness-freshness |\n| `parent-outlives-a-rejected-child` | delegated | A milestone or roadmap stays approved over a child's later rejection, through retention, a sealed cycle, a replaced approval or a forged `replaces` (`pose/review_approval_follows_children_test.go:TestParentApprovalFollowsAChildsRejection`, `pose/review_approval_follows_children_test.go:TestChildCycleEndsInARefusal`, `pose/review_approval_follows_children_test.go:TestForgedReplacementRetiresNothing`, `pose/review_approval_follows_children_test.go:TestLegacyCoordinatedMatchingFollowsLineage`) | pose-review-approval-follows-children |\n| `go-check-ran-no-test` | delegated | A `go test` check selects nothing and passes on Go's exit 0, through a flag spelling, a flag's value read as a flag, or a package without test files (`cli/validate_empty_go_checks_test.go:TestValidateRefusesAGoCheckThatRanNoTest`, `cli/validate_empty_go_checks_test.go:TestGoTestSelection`); a check outside the plain grammar passes unjudged, and a test printing a result line can still mislead it | pose-validate-refuses-empty-go-checks |\n| `request-opened-after-preview-transfers` | delegated | A request opened after a transfer preview is moved with the spec (`pose/spec_transfer_actions_test.go:TestTransferRefusesARequestOpenedAfterThePreview`) | pose-transfer-preserves-obligations |\n\n| `deleted-reservation-resets-quota` | delegated | Deleting a reservation and receipt makes a surviving run stop consuming quota | pose-delegated-review-attempt-ledger |\n| `witness-bundle-filter-hides-loss` | delegated | Editing a witness bundle makes scoped readers skip its corruption | pose-delegated-review-attempt-ledger |\n| `window-erases-rerun` | delegated | Moving a prior run outside the time window turns a rerun into a first attempt | pose-delegated-review-attempt-ledger |\n| `canned-executor-approval-proves-cognition` | delegated | A complete canned approval from a trusted local command is presented as proof of review cognition or a vendor receipt (`cli/delegated_review_capability_test.go:TestDelegatedReviewCapabilityCannedApprovalDisclosesItsLimits` guards disclosure; the engine cannot detect canned judgments) | pose-delegated-review-capability |\n| `oversized-writer-publishes-unreadable-run` | delegated | A writer reports completion for a run its bounded reader immediately refuses | pose-delegated-review-attempt-ledger |\npose-mcp/internal/pose/remediation_lineage_test.go:196:\tlegacyDigest, err := store.ScopeDigest(\"spec:backend\")\npose-mcp/internal/pose/remediation_lineage_test.go:227:\tlinkedDigest, err := store.ScopeDigest(\"spec:backend\")\npose-mcp/internal/pose/review_plan_test.go:541:\tbody := \"---\\nschema_version: 1\\nreview_id: rvw-plan\\nscope: spec:backend\\nscope_digest: \" + plan.ScopeDigest + \"\\nprofile: spec-closeout@2\\nreviewer: agent:separate-review\\ndecision: approved\\nreviewed_at: 2026-08-13T12:00:00Z\\nevidence_refs: [unit:review-plan, integration:review-plan]\\n---\\n\\n## Criteria\\n\" + criteria.String() + \"\\n## Findings\\n\"\npose-mcp/internal/pose/closeout_review_policy_test.go:409:\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\npose-mcp/internal/pose/closeout_review_policy_test.go:545:\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\npose-mcp/internal/pose/closeout_review_policy_test.go:619:\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\npose-mcp/internal/pose/closeout_review_policy_test.go:715:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\npose-mcp/internal/pose/closeout_review_policy_test.go:731:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\npose-mcp/internal/pose/closeout_review_policy_test.go:768:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\npose-mcp/internal/pose/closeout_review_policy_test.go: