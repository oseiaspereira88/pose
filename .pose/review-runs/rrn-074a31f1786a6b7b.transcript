{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '252,286p' pose-mcp/internal/pose/review_conclusions.go; sed -n '260,277p' pose-mcp/internal/cli/index.go; python3 -c 'import json; d=json.load(open(\\\".pose/results/delivery-validation.json\\\")); print(list(d)); r=d.get(\\\"results\\\",[]); print(\\\"results\\\",len(r)); print([x for x in r if \\\"closed-scope-stands\\\" in str(x)])'\"","aggregated_output":"\t}\n\treturn out\n}\n\n// concludingTools are the dispositions of tools that state a conclusion:\n// a post-review gate deferred and a recommended tool not used state none,\n// whatever their rationale says, so a writer that fills them is not\n// answering for the reviewer.\nfunc concludingTools(plan []ReviewPlanTool, tools []ReviewToolDisposition) []ReviewToolDisposition {\n\tplanned := map[string]ReviewPlanTool{}\n\tfor _, tool := range plan {\n\t\tplanned[tool.ID+\"\\x00\"+tool.Component] = tool\n\t}\n\tout := []ReviewToolDisposition{}\n\tfor _, t := range tools {\n\t\ttool, ok := planned[t.ID+\"\\x00\"+t.Component]\n\t\tif ok && t.Evidence == \"\" && (t.Disposition == \"deferred\" && containsString(tool.Preconditions, \"review-complete\") || t.Disposition == \"not-used\" && tool.Requiredness == \"recommended\") {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, t)\n\t}\n\treturn out\n}\n\n// differingItems names the items of got and want, keyed by id and\n// component, that one has and the other lacks or states differently.\nfunc differingItems[T any](kind string, got, want []T) []string {\n\tindex := func(items []T) (map[string]string, []string) {\n\t\tout, keys := map[string]string{}, []string{}\n\t\tfor _, v := range items {\n\t\t\traw, _ := json.Marshal(v)\n\t\t\tvar m struct {\n\t\t\t\tID        string `json:\"id\"`\n\t\t\t\tComponent string `json:\"component\"`\n\t\t\t}\nfunc refreshDeliveryIndex(root string, data []byte, stderr io.Writer) {\n\tif posepkg.IsSealedCheckout(root) {\n\t\treturn\n\t}\n\t_ = os.MkdirAll(filepath.Join(root, \".pose\", \"indexes\"), 0o755)\n\treceipt, _, err := posepkg.Store{Root: root}.ReplaceIndexOrLegacy(\"delivery-integrity.json\", data)\n\tswitch {\n\tcase err == nil:\n\t\tif receipt.CleanupError != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose: retention of old index generations failed: \" + receipt.CleanupError.Error())\n\t\t}\n\tcase receipt.Committed:\n\t\trender(io.Discard, stderr).Failure(\"pose: the delivery index was published as generation \" + receipt.GenerationID + \", but its durability could not be confirmed: \" + err.Error() + \"; run `pose index --verify`\")\n\tdefault:\n\t\trender(io.Discard, stderr).Failure(\"pose: the delivery index was not refreshed: \" + err.Error() + \"; run `pose index`\")\n\t}\n}\n['schema_version', 'generated_at', 'mode', 'git_head', 'matrix_sha256', 'provenance_digest', 'scope_provenance', 'material_provenance', 'jobs', 'wall_seconds', 'outcome', 'counts', 'checks']\nresults 0\n[]\n","exit_code":0,"status":"completed"}}
