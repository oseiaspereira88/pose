{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '350,560p' pose-mcp/internal/pose/federated_acceptance.go; sed -n '695,785p' pose-mcp/internal/pose/federated_acceptance.go; rg -n 'sameFederatedManifest|federatedManifestStands|PlanDigest|plan_digest' pose-mcp/internal/pose/review_bundle.go pose-mcp/internal/pose/review_plan.go; git status --short; command -v go; ls /tmp/pose /var/tmp/pose 2>/dev/null\"","aggregated_output":"\nfunc (s Store) federatedAcceptance(projectID string, coordinator ArtifactRef, edges []federatedRoadmapEdge, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, error) {\n\tpolicy, policyDigest, err := LoadFederatedRoadmapPolicyIn(s.fsys(), s.Root)\n\tif err != nil {\n\t\treturn FederatedRoadmapAcceptanceReport{}, err\n\t}\n\trevision := gitHeadAtRootIn(s.fsys(), s.Root, federatedAcceptanceProducer)\n\tcoordinatorRevision := revision\n\tif stable := federatedArtifactLastChange(s.fsys(), s, coordinator); stable != \"\" {\n\t\tcoordinatorRevision = stable\n\t}\n\treport := FederatedRoadmapAcceptanceReport{Manifest: FederatedRoadmapManifest{\n\t\tSchemaVersion: 1, Coordinator: coordinator, CoordinatorRevision: coordinatorRevision,\n\t\tTrustPolicyDigest: policyDigest, Dependencies: []FederatedDependency{},\n\t}, Blockers: []string{}}\n\tqueue := []federatedQueuedRef{}\n\tfor _, edge := range edges {\n\t\tqueue = append(queue, federatedQueuedRef{project: edge.project, parent: edge.project, raw: edge.raw, relationship: edge.relationship})\n\t}\n\tvisited := map[string]bool{}\n\tdependencyIndexes := map[string]int{}\n\tprojectRoots := map[string]Store{projectID: s}\n\tsnapshotRevisions := map[string]string{}\n\tif revision != \"\" {\n\t\tsnapshotRevisions[projectID] = revision\n\t}\n\tfor len(queue) > 0 {\n\t\titem := queue[0]\n\t\tqueue = queue[1:]\n\t\tresolved := resolver.Resolve(item.project, item.raw)\n\t\tidentity := resolved.Identity\n\t\tif identity.Project == \"\" {\n\t\t\tidentity.Project = item.project\n\t\t}\n\t\tkey := identity.String()\n\t\tif visited[key] {\n\t\t\tif index, ok := dependencyIndexes[key]; ok {\n\t\t\t\tentry := &report.Manifest.Dependencies[index]\n\t\t\t\tfound := item.relationship == entry.Relationship\n\t\t\t\tfor _, relationship := range entry.Relationships {\n\t\t\t\t\tfound = found || relationship == item.relationship\n\t\t\t\t}\n\t\t\t\tif !found {\n\t\t\t\t\tentry.Relationships = append(entry.Relationships, item.relationship)\n\t\t\t\t\tsort.Strings(entry.Relationships)\n\t\t\t\t\tentry.Relationship = entry.Relationships[0]\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif len(visited) >= 256 {\n\t\t\treport.Blockers = append(report.Blockers, \"resolution-limit\")\n\t\t\tbreak\n\t\t}\n\t\tvisited[key] = true\n\t\tentry := FederatedDependency{Ref: key, Relationship: item.relationship, Relationships: []string{item.relationship}, Identity: identity, ResolutionState: resolved.State, Status: resolved.Status, SourceRevision: resolved.Revision, SourceDigest: resolved.Digest}\n\t\t// The dependency keeps the identity it was named by, as the manifest\n\t\t// records it; a transferred artifact is proven at its canonical\n\t\t// destination: its store, revision, trust and closeout (review\n\t\t// round 7, N25). The resolver authorized the redirect chain.\n\t\tproven := identity\n\t\tif resolved.CanonicalIdentity != nil {\n\t\t\tproven = *resolved.CanonicalIdentity\n\t\t}\n\t\tdependencyIndexes[key] = len(report.Manifest.Dependencies)\n\t\tif !resolved.Resolved {\n\t\t\treport.Blockers = append(report.Blockers, key+\":\"+resolved.State)\n\t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n\t\t\tcontinue\n\t\t}\n\t\tif selected, exists := snapshotRevisions[proven.Project]; exists && selected != \"\" && resolved.Revision != selected {\n\t\t\treport.Blockers = append(report.Blockers, key+\":source-revision-changed-during-resolution\")\n\t\t} else if _, exists := snapshotRevisions[proven.Project]; !exists && resolved.Revision != \"\" {\n\t\t\tsnapshotRevisions[proven.Project] = resolved.Revision\n\t\t}\n\t\tgraphValid := true\n\t\tif reason := resolver.ValidateGraph(item.project, item.raw); reason != \"\" {\n\t\t\tgraphValid = false\n\t\t\tentry.ResolutionState = reason\n\t\t\treport.Blockers = append(report.Blockers, key+\":\"+reason)\n\t\t}\n\t\tstatusDone := resolved.Status == \"done\"\n\t\tif !statusDone {\n\t\t\treport.Blockers = append(report.Blockers, key+\":not-done\")\n\t\t}\n\t\tsource, sourceErr := resolver.Roots.StoreFor(proven.Project)\n\t\tif sourceErr != nil {\n\t\t\tentry.ResolutionState = projectResolutionState(sourceErr)\n\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n\t\t\tcontinue\n\t\t}\n\t\tsource = resolver.withSpecSnapshot(proven.Project, source)\n\t\tprojectRoots[proven.Project] = source\n\t\tsource.FederatedProjectID = proven.Project\n\t\tsource.FederatedResolver = &resolver\n\t\tartifactValid := true\n\t\tif err := verifyFederatedArtifactAtRevision(s.fsys(), source, proven, resolved); err != nil {\n\t\t\tartifactValid = false\n\t\t\tentry.ResolutionState = err.Error()\n\t\t\tblocker := key + \":\" + err.Error()\n\t\t\tif err.Error() == federatedSourceUncommitted {\n\t\t\t\tblocker += \": commit the artifact, its working file differs from its revision\"\n\t\t\t}\n\t\t\treport.Blockers = append(report.Blockers, blocker)\n\t\t}\n\t\t// Same-project dependencies need the revision of their own artifact.\n\t\t// Using repository HEAD makes every unrelated evidence commit stale a\n\t\t// sealed milestone or roadmap. External dependencies retain the explicit\n\t\t// whole-repository pin checked below.\n\t\tif proven.Project == projectID {\n\t\t\tif stable := federatedArtifactLastChange(s.fsys(), source, proven); stable != \"\" {\n\t\t\t\tentry.SourceRevision = stable\n\t\t\t}\n\t\t\t// Under an adopted closeout review policy a local milestone or\n\t\t\t// roadmap is closed by its explicit close, never by the status\n\t\t\t// its members give it: the edge asks the terminal projection,\n\t\t\t// along a chain that stops at a cycle (review round 6, N22).\n\t\t\tif statusDone && graphValid && !s.indexMaterial && (proven.Kind == \"milestone\" || proven.Kind == \"roadmap\") {\n\t\t\t\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || adopted && !s.localScopeClosed(localFederatedScope(proven)) {\n\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":closeout-not-terminal\")\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif proven.Project != projectID {\n\t\t\t// Do not recurse into source closeout when graph traversal has already\n\t\t\t// found a cycle or stale artifact. The blocker is conclusive, and\n\t\t\t// recursively asking each side of a cycle for its review would never\n\t\t\t// converge.\n\t\t\tgitlinkValid := true\n\t\t\tpin, pinErr := FederatedProjectTrustForIn(s.fsys(), source.Root, proven.Project)\n\t\t\tif pinErr != nil {\n\t\t\t\tentry.ResolutionState = pinErr.Error()\n\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t} else {\n\t\t\t\tentry.SourceContractDigest, entry.SourcePolicyDigest = pin.ContractDigest, pin.PolicyDigest\n\t\t\t}\n\t\t\tif !policy.Enabled {\n\t\t\t\tentry.ResolutionState = \"consumer-trust-not-adopted\"\n\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t} else {\n\t\t\t\taccepted, exists := policy.TrustedProjects[proven.Project]\n\t\t\t\tif pinErr != nil {\n\t\t\t\t\t// The pin error was recorded above; retain the stable state.\n\t\t\t\t} else if !exists {\n\t\t\t\t\tentry.ResolutionState = \"consumer-trust-not-adopted\"\n\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t\t} else if accepted != pin {\n\t\t\t\t\tentry.ResolutionState = \"consumer-trust-stale\"\n\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t\t} else {\n\t\t\t\t\tif proven.Project == item.parent {\n\t\t\t\t\t\t// This edge remains inside the selected source repository;\n\t\t\t\t\t\t// its local artifacts inherit that repository's pin.\n\t\t\t\t\t} else if parentStore, parentErr := resolver.Roots.StoreFor(item.parent); parentErr != nil || !federatedGitlinkMatchesIn(s.fsys(), parentStore, source, resolved.Revision) {\n\t\t\t\t\t\tgitlinkValid = false\n\t\t\t\t\t\tif parentErr != nil {\n\t\t\t\t\t\t\tentry.ResolutionState = projectResolutionState(parentErr)\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\tentry.ResolutionState = \"gitlink-revision-mismatch\"\n\t\t\t\t\t\t}\n\t\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\taccepted, trusted := policy.TrustedProjects[proven.Project]\n\t\t\tproofInputsReady := graphValid && statusDone && artifactValid && pinErr == nil && policy.Enabled && trusted && accepted == pin && gitlinkValid\n\t\t\tif proofInputsReady {\n\t\t\t\tbundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, proofBlockers := federatedSourceProof(s.fsys(), source, proven, resolved.Revision)\n\t\t\t\tentry.ReviewBundleID, entry.ReviewBundleDigest = bundleID, bundleDigest\n\t\t\t\tentry.ImplementationDigest, entry.PlanDigest = subjectDigest, planDigest\n\t\t\t\tentry.GoverningContracts, entry.Evidence = contracts, evidence\n\t\t\t\treport.Blockers = append(report.Blockers, proofBlockers...)\n\t\t\t\tif len(proofBlockers) > 0 {\n\t\t\t\t\tentry.ResolutionState = \"source-evidence-incomplete\"\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n\t\tfor _, dep := range resolved.Dependencies {\n\t\t\tqueue = append(queue, federatedQueuedRef{project: dep.Project, parent: proven.Project, raw: dep.String(), relationship: \"prerequisite\"})\n\t\t}\n\t}\n\tfor project, selected := range snapshotRevisions {\n\t\tif selected == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\troot, ok := projectRoots[project]\n\t\tif ok && gitHeadAtRootIn(s.fsys(), root.Root, federatedAcceptanceProducer) != selected {\n\t\t\treport.Blockers = append(report.Blockers, \"source-snapshot-changed-during-resolution:\"+project)\n\t\t}\n\t}\n\treport.Blockers = append(report.Blockers, federatedOwnershipConflicts(s.fsys(), projectRoots, resolver)...)\n\tsort.Slice(report.Manifest.Dependencies, func(i, j int) bool {\n\t\tleft, right := report.Manifest.Dependencies[i], report.Manifest.Dependencies[j]\n\t\tif left.Identity.String() != right.Identity.String() {\n\t\t\treturn left.Identity.String() < right.Identity.String()\n\t\t}\n\t\treturn left.Relationship < right.Relationship\n\t})\n\treport.Blockers = uniqueSorted(report.Blockers)\n\treport.Manifest.Ready = len(report.Blockers) == 0\n\treport.Manifest.Blockers = append([]string{}, report.Blockers...)\n\treport.Manifest.Digest = \"\"\n\treport.Manifest.Digest = canonicalFederatedDigest(report.Manifest)\n\treport.Ready = report.Manifest.Ready\n\treturn report, nil\n}\n\nfunc federatedArtifactLastChange(files Files, source Store, identity ArtifactRef) string {\n\tvar path string\n\tif len(fields) < 3 || fields[0] != \"160000\" || fields[1] != \"commit\" {\n\t\treturn false\n\t}\n\treturn fields[2] == revision\n}\n\n// federatedGitlinkMatches reads the filesystem directly; federatedGitlinkMatchesIn reads the operation's files.\nfunc federatedGitlinkMatches(parent, child Store, revision string) bool {\n\treturn federatedGitlinkMatchesIn(NativeFiles(), parent, child, revision)\n}\n\nfunc federatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\n\tscope := localFederatedScope(identity)\n\tstate, err := source.GetCloseoutState(scope)\n\tif err != nil || !state.Terminal {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-not-terminal\"}\n\t}\n\t// A milestone or roadmap the source closed without its own review, under\n\t// its adopted closeout review policy, is proven by the receipt of that\n\t// close: the source's policy decides, never the consumer's. Its members\n\t// are federated with their own reviews (spec\n\t// pose-closeout-review-policy-by-cost-benefit).\n\tif receipt := state.CloseoutReceipt; receipt != nil && !receipt.Decision.Required && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n\t\traw, err := json.Marshal(receipt)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-receipt-unreadable\"}\n\t\t}\n\t\treturn \"closeout-receipt:\" + scope, \"sha256:\" + digestHex(raw), receipt.SubjectDigest, receipt.PolicyDigest, nil, nil, nil\n\t}\n\tverification, err := source.VerifyReviewBundle(scope)\n\t// A milestone its roadmap declares has no review of its own: what a consumer can\n\t// hold is the review of that roadmap, which sealed the declaration.\n\tif err == nil && identity.Kind == \"milestone\" && strings.HasPrefix(verification.ApprovalOrigin, \"declared:\") {\n\t\tverification, err = source.VerifyReviewBundle(\"roadmap:\" + identity.Slug)\n\t}\n\tif err != nil || !verification.Fresh || !verification.Approved || verification.Bundle == nil || verification.Attestation == nil || !source.sealedDeclarationHolds(verification.Bundle) {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-review-not-approved\"}\n\t}\n\tbundle := verification.Bundle\n\teligible := federatedSourceEvidenceEligibilityIn(files, source.Root, pinnedRevision, bundle.Payload.Subject.Head)\n\tif identity.Kind == \"spec\" {\n\t\tspec, err := source.GetSpec(identity.Slug)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":unavailable-artifact\"}\n\t\t}\n\t\ttargets, _, err := ParseDeliveryTargets(*spec)\n\t\tif err != nil || len(targets) == 0 {\n\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-target-missing\"}\n\t\t}\n\t\tprofiles, err := loadFederatedDeliveryProfiles(files, source.Root)\n\t\tif err != nil {\n\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-profile-unavailable\"}\n\t\t}\n\t\tblockers := []string{}\n\t\tfor _, target := range targets {\n\t\t\tprofile, ok := profiles[target.Profile]\n\t\t\tif !ok || profile.Kind != target.Kind {\n\t\t\t\tblockers = append(blockers, scope+\":source-delivery-profile-unsupported\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseen := map[string]bool{}\n\t\t\tfor _, evidence := range bundle.Payload.Evidence {\n\t\t\t\tif eligible(evidence) && moduleMatchesTarget(evidence.Module, target.Module) {\n\t\t\t\t\tseen[evidence.EvidenceClass] = true\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor _, required := range profile.RequiredEvidenceClasses {\n\t\t\t\tif !seen[required] {\n\t\t\t\t\tblockers = append(blockers, scope+\":source-delivery-evidence-missing:\"+target.Ref+\":\"+required)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif len(profile.AnyEvidenceClasses) > 0 {\n\t\t\t\tfound := false\n\t\t\t\tfor _, class := range profile.AnyEvidenceClasses {\n\t\t\t\t\tfound = found || seen[class]\n\t\t\t\t}\n\t\t\t\tif !found {\n\t\t\t\t\tblockers = append(blockers, scope+\":source-delivery-evidence-missing:\"+target.Ref+\":one-of\")\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tproof := federatedBundleEvidence(files, bundle, eligible)\n\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, proof, uniqueSorted(blockers)\n\t}\n\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, federatedBundleEvidence(files, bundle, eligible), nil\n}\n\n// A fresh approved source bundle already checked provenance. A carried result\n// can additionally prove delivery only if it ran after the reviewed subject\n// and belongs to the pinned source history. An earlier or unknown result never\n// observed the implementation being federated.\npose-mcp/internal/pose/review_plan.go:104:\tPlanDigest          string                `json:\"plan_digest\"`\npose-mcp/internal/pose/review_plan.go:400:\tplan.PlanDigest, err = digestReviewPlan(plan)\npose-mcp/internal/pose/review_bundle.go:118:\tPlanDigest                string                `json:\"plan_digest\"`\npose-mcp/internal/pose/review_bundle.go:510:\tbundlePlanDigest, err := reviewBundlePlanDigest(plan)\npose-mcp/internal/pose/review_bundle.go:514:\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview}\npose-mcp/internal/pose/review_bundle.go:1924:\tplanDigest, _ := reviewBundlePlanDigest(plan)\npose-mcp/internal/pose/review_bundle.go:1956:func reviewBundlePlanDigest(plan ReviewPlan) (string, error) {\npose-mcp/internal/pose/review_bundle.go:4533:// sameFederatedManifest reports whether two sealed federated manifests record\npose-mcp/internal/pose/review_bundle.go:4535:func sameFederatedManifest(a, b *FederatedRoadmapManifest) bool {\npose-mcp/internal/pose/review_bundle.go:4553:\treturn s.FederatedResolver == nil || s.federatedManifestStands(bundle.Payload.FederatedManifest, current)\npose-mcp/internal/pose/review_bundle.go:4609:// federatedManifestStands reports whether a closed scope's sealed manifest still\npose-mcp/internal/pose/review_bundle.go:4610:// holds against the current one. It is sameFederatedManifest, less the one thing a\npose-mcp/internal/pose/review_bundle.go:4614:func (s Store) federatedManifestStands(sealed, current *FederatedRoadmapManifest) bool {\npose-mcp/internal/pose/review_bundle.go:4642:\tif sameFederatedManifest(sealed, current) {\npose-mcp/internal/pose/review_bundle.go:4703:\treturn sameFederatedManifest(&was, current)\npose-mcp/internal/pose/review_bundle.go:4719:\tif then.PlanDigest == \"\" || then.PlanDigest != now.PlanDigest || !slices.Equal(then.GoverningContracts, now.GoverningContracts) {\n/usr/bin/go\n","exit_code":2,"status":"failed"}}
