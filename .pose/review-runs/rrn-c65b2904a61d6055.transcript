{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ULh7pzPVu75kh7rUSYA5og","type":"tool_result","content":"internal/cli/doctor.go:1153:\t\t\t\tif issue := (posemodel.Store{Root: root}).ReviewProfileMigrationIssue(raw); issue != \"\" {\ninternal/cli/review_closeout.go:1362:\tprofile, err := store.ReviewProfileForScope(ref)\ninternal/cli/review_closeout.go:1429:func renderReviewAttempt(id, scope, digest string, plan posemodel.ReviewPlan, profile posemodel.ReviewProfile, reviewer, decision, reviewedAt, supersedes string, evidence, rawTools, findings []string, componentAware bool) (string, error) {\ninternal/pose/review_bands.go:132:func reviewOverlayUndecided(selectors ReviewProfileSelectors, component ReviewPlanComponent) []string {\ninternal/pose/review_bands.go:180:func reviewOverlayFacts(selectors ReviewProfileSelectors, matched []string, components map[string]ReviewPlanComponent, deliveryKinds, structuralKinds []string) (string, string, bool) {\ninternal/pose/review_bands.go:265:func deriveReviewBands(plan ReviewPlan, scopeKind, floor string, selected []reviewOverlaySelection, undecidable []ReviewProfile, context reviewPlanContext) ([]ReviewPlanBand, string) {\ninternal/pose/review_closeout.go:118:type ReviewProfileSelectors struct {\ninternal/pose/review_closeout.go:138:type ReviewProfileTool struct {\ninternal/pose/review_closeout.go:146:type ReviewProfile struct {\ninternal/pose/review_closeout.go:152:\tSelectors     ReviewProfileSelectors   `json:\"selectors,omitempty\"`\ninternal/pose/review_closeout.go:153:\tTools         []ReviewProfileTool      `json:\"tools,omitempty\"`\ninternal/pose/review_closeout.go:157:func (p ReviewProfile) Ref() string { return fmt.Sprintf(\"%s@%d\", p.ID, p.Version) }\ninternal/pose/review_closeout.go:823:func (s Store) loadReviewProfile(ref string) (ReviewProfile, []byte, error) {\ninternal/pose/review_closeout.go:826:\t\treturn ReviewProfile{}, nil, fmt.Errorf(\"pose: invalid review profile ref %q\", ref)