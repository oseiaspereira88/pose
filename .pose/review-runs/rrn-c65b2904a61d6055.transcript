ession/interrupt recognition\"\n292\t \tstatus, failure, captureErr := s.classifyReviewInterruption(&run, plan, transcript, runErr, ctx.Err())\n293\t \tif captureErr == nil {\n294\t \t\tvar redactErr error\n295\t \t\traw := transcript\n296\t+\t\tcaptureStage = \"stdout\"\n297\t \t\ttranscript, redactErr = redactReviewCapture(transcript, secrets, run.sessionForRedaction, safety.StreamBytes)\n298\t \t\tvar output []byte\n299\t \t\tif redactErr == nil {\n300\t+\t\t\tcaptureStage = \"final output\"\n301\t \t\t\toutput, redactErr = redactReviewCapture([]byte(run.Output), secrets, run.sessionForRedaction, safety.OutputBytes)\n302\t \t\t}\n303\t \t\trun.Output = string(output)\n304\t \t\tif redactErr == nil && run.Events != \"\" {\n305\t+\t\t\tcaptureStage = \"normalized events\"\n306\t \t\t\t// Events are parsed from the decoded stream, where a JSON escape no longer\n307\t \t\t\t// hides a value: each text is redacted again after decoding.\n308\t \t\t\trun.eventsBytes, redactErr = redactedDelegationEvents(run.Events, raw, run.Output, secrets, run.sessionForRedaction)\n309\t@@ -1048,7 +1063,7 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n310\t \t\tif run.Provenance != nil {\n311\t \t\t\trun.Provenance.OutputComplete = false\n312\t \t\t}\n313\t-\t\treturn finish(ReviewRunFailed, \"adapter capture failed; unredacted output withheld\")\n314\t+\t\treturn finish(ReviewRunFailed, \"adapter capture failed; unredacted output withheld; \"+delegationCaptureFailure(run.Adapter, run.Events, captureStage, captureErr))\n315\t \t}\n316\t \trun.sessionForRedaction = \"\"\n317\t \n318\t@@ -1120,6 +1135,30 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n319\t \treturn published, nil\n320\t }\n321\t \n322\t+// Materialize only empty vendor staging directories in the disposable checkout,\n323\t+// before its integrity snapshot. Files created there remain visible as mutations.\n324\t+// The source repository and the legacy read profile are untouched.\n325\t+func prepareClaudeReviewStaging(runtime *os.Root, components []ReviewPlanComponent) error {\n326\t+\troot, err := runtime.OpenRoot(\"worktree\")\n327\t+\tif err != nil {\n328\t+\t\treturn err\n329\t+\t}\n330\t+\tdefer root.Close()\n331\t+\tpaths := []string{\".\"}\n332\t+\tfor _, component := range components {\n333\t+\t\tif !filepath.IsLocal(component.Path) {\n334\t+\t\t\treturn fmt.Errorf(\"review staging component is not confined\")\n335\t+\t\t}\n336\t+\t\tpaths = append(paths, component.Path)\n337\t+\t}\n338\t+\tfor _, path := range paths {\n339\t+\t\tif err := root.MkdirAll(filepath.Join(path, \".claude\", \".cc-writes\"), 0o700); err != nil {\n340\t+\t\t\treturn err\n341\t+\t\t}\n342\t+\t}\n343\t+\treturn nil\n344\t+}\n345\t+\n346\t // The adapter has no authenticated producer/output declaration. Until such a\n347\t // declaration exists, a directory name cannot authorize regenerated evidence.\n348\t func verifyDispatchWorktree(root, commit string) error {\n349\tdiff --git a/pose-mcp/internal/pose/review_run_continuity.go b/pose-mcp/internal/pose/review_run_continuity.go\n350\tindex 06b067ac..dfbcc596 100644\n351\t--- a/pose-mcp/internal/pose/review_run_continuity.go\n352\t+++ b/pose-mcp/internal/pose/review_run_continuity.go\n353\t@@ -193,7 +193,15 @@ func (s Store) readReviewSession(digest string) (string, error) {\n354\t func (s Store) classifyReviewInterruption(run *ReviewRun, plan DispatchPlan, transcript []byte, runErr, ctxErr error) (string, string, error) {\n355\t \t// Inspect both supported output channels before any public publication.\n356\t \tchannels := append([]string{string(transcript), run.Output}, plan.extraChannels...)\n357\t-\tvalue, e := captureReviewChannels(sessionPattern(plan.Config), channels...)\n358\t+\tsessionChannels := make([]string, 0, len(channels))\n359\t+\tfor _, channel := range channels {\n360\t+\t\tcanonical, err := canonicalDelegationSessionChannel(plan.Config.Events, sessionPattern(p