it 1; }\\ngit_common=$(cd \\\"$git_common\\\" && pwd -P) || exit 1\\nsettings=$(printf '%s' \\\"$settings\\\" | jq -c --arg scratch \\\"$scratch\\\" --arg cwd \\\"$(pwd -P)\\\" --arg git_common \\\"$git_common\\\" '.sandbox.filesystem.allowWrite=[$scratch] | .sandbox.filesystem.denyWrite=[$cwd,$git_common]') || exit 1\\nexec \\\"$@\\\" --settings \\\"$settings\\\"\",\n+          \"sh\",\n+          \"{output}\",\n+          \"{\\\"disableAllHooks\\\":true,\\\"sandbox\\\":{\\\"enabled\\\":true,\\\"failIfUnavailable\\\":true,\\\"autoAllowBashIfSandboxed\\\":true,\\\"allowUnsandboxedCommands\\\":false,\\\"excludedCommands\\\":[],\\\"filesystem\\\":{\\\"denyWrite\\\":[\\\".\\\"],\\\"disabled\\\":false},\\\"allowNestedUserNamespaces\\\":false}}\",\n+          \"claude\",\n+          \"--safe-mode\",\n+          \"--restricted\",\n+          \"--strict-mcp-config\",\n+          \"-p\",\n+          \"--model\",\n+          \"claude-opus-5-5\",\n+          \"{effort}\",\n+          \"--permission-mode\",\n+          \"manual\",\n+          \"--permission-prompts\",\n+          \"none\",\n+          \"--output-format\",\n+          \"stream-json\",\n+          \"--verbose\",\n+          \"--tools\",\n+          \"Read,Grep,Glob,Bash\",\n+          \"--allowedTools\",\n+          \"Bash\",\n+          \"--resume\",\n+          \"{session}\",\n+          \"--append-system-prompt\",\n+          \"Before returning the final review draft, wait for every test/build/background job to finish. Then run go clean -cache as a final Bash tool command INSIDE the mandatory sandbox, and remove only leftover go-build* directories directly under GOTMPDIR using `find \\\"$GOTMPDIR\\\" -mindepth 1 -maxdepth 1 -type d -name \\\"go-build*\\\" -exec rm -rf -- {} +`. Cache and Go temporary workspaces are operation-owned. Do not clean outside the sandbox or request an override. The engine retains incomplete cleanup as a failed run. Never claim successful cleanup when a command fails.\"\n+        ]\n       }\n     }\n   },\ndiff --git a/POSE.md b/POSE.md\nindex 404ee8cb..43aad9b3 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -899,6 +899,10 @@ versus task and follow native next actions.\n \n `pose review` governs the subject (bundle, brief, attestation, verify); `pose delegate` governs executions. An **agent** is a CLI profile configured in `.pose/policy/delegation.json`; a **run** is one execution; an **attempt** is a run and its continuations; a **thread** is the rounds of one scope. `pose delegate review`, `adjudicate` and `smoke` run the sealed bundle's generated brief on a disposable worktree at the sealed commit with read access only, under the attempt ledger and containment below; any other `--access` is refused. The agent never records an attestation: the engine records the conclusion of a completed review run only as the conclusions of delegated reviews below describe. Without `--agent` (or with `auto`) routing chooses among the agents of the purpose: first by `routing.prefer` (default `opposite-vendor-of-implementation`, in the order the policy declares its agents), then by the steps of `routing.on_unavailable` (default `same-vendor-other-model`, `wait`, `same-model`). `wait` applies only when every earlier candidate is limited with a known reset within `routing.max_wait` (default 5h) and starts the run after the first reset, without polling. The implementation routed against is the identity the bundle sealed; for a bundle sealed before bundles recorded it, the policy's `provenance.implementation`, else `--lead`. An agent named with `--agent` bypasses routing and warns when it shares the implementation's vendor. Every run records the decision (`routing`: the candidates, why each was skipped, the step taken) and `independence_achieved` (`different-vendor`, `different-model` or `same-model`); with no agent available the run does not start and the error carries the decision. `--label` names the run, `--lead <vendor>[/<model>]` declares the implementation when the bundle records none, `--dry-run` prints the resolved agent, purpose, access, working directory and argv (authorized credential values redacted) and reserves nothing, and `--json` prints one versioned document (`pose.delegate.run/v1`, `plan/v1`, `ls/v1`, `cancel/v1`, `agents/v1`, `error/v1`), usage errors included. On `ls`, `resume`, `cancel` and `agents` the same flags select: a run or an agent that does not match is not listed, or is refused when named; `--dry-run` changes nothing anywhere. Messages follow `POSE_LOCALE` (`en` or `pt-BR`). A run reference is a run id, an attempt id, a label or a session prefix of six characters or more; an ambiguous reference exits 2 and lists the candidates.\n \n+A schema-2 agent may opt in to `review_profile.command` and `review_profile.resume_command` for governed review only. Omission preserves its existing read adapter; tasks, adjudication and smoke keep their commands. A resumable agent must declare the profile's resumed command with `{session}`. Once selected, failure never falls back to the read or task profile. The selected commands remain bound by policy/provenance verification. Older strict parsers reject the new field. The configured Claude event codec canonicalizes repeated typed init records only for the same parsed session identity before session recognition. Different identities and generic regex ambiguity are still refused; raw provenance/redaction and limit/reset channels retain the original bytes.\n+\n+This repository's Claude review profile uses safe/restricted mode, Read/Grep/Glob/Bash only, mandatory shell sandboxing (`failIfUnavailable:true`, `allowUnsandboxedCommands:false`), and a read-only sealed source tree. Both fresh and resumed wrappers require bubblewrap, socat and jq on Linux (jq remains required on macOS), with installation advice on refusal. Go cache/temp writes go to private operation-owned scratch outside the checkout; the existing module cache is read, and unavailable downloads/tests that write into source can fail. The profile instructs the reviewer to run `go clean -cache` as its final Bash command inside the sandbox; the engine independently retains incomplete cleanup as a failed run under its unchanged limits. Never clean an adapter-controlled cache outside the sandbox: a test can replace its path with a symlink. This qualifies Claude's shell subprocess boundary, not isolation of the trusted Claude executable or arbitrary credential reads. Checkout integrity checks still apply. Installing engine code does not adopt the profile in another instance; copy and qualify its explicit policy block before use. The wrapper also denies the resolved physical Git common directory, because Claude auto-allows it for worktrees. For this opt-in profile, POSE prepares only empty `.claude/.cc-writes` directories at the disposable checkout root and declared components before taking its integrity snapshot; added files and all later mutations still fail. Final sandboxed cleanup includes leftover `go-build*` directories directly under GOTMPDIR after all jobs finish.\n+\n `pose delegate ls` lists attempts by their latest run with state, purpose, agent, label, turns, age and last step — for an interrupted run also its cause, whether a partial draft exists, the reset instant and the time left — and the runs in progress with the liveness of their process. `pose delegate cancel <run>` stops a run in progress; it is recorded `failed` with the cause `cancelled`, and its attempt stays consumed. `pose delegate agents` lists each agent with vendor, model, whether its CLI is on the path, the reset instant of its last recorded usage limit and the state routing reads: `available`, `limited until <instant>` (its last run hit a usage limit whose reset is ahead), `missing` (its CLI is not on the path), `unknown` (the run history could not be read whole) or `probe-failed` (its optional `probe` failed within its bound). Availability is read from the path and the recorded runs; only a configured probe runs anything. `pose delegate review|adjudicate|smoke --detach` starts the run as a process of its own, in a session of its own that survives the caller's terminal, and returns at once with the attempt (a run reference) and the path of its log; a run whose route must first wait for a usage-limit reset is not detached. `pose delegate wait <run> [--timeout <d>] [--json]` is a plain foreground process that ends when the run does and prints one line — run, state, decision, resumable flag, reset instant — with the exit code `0` approved, `10` changes requested or rejected, `20` failed (a completed run with no decision too), `30` interrupted, `40` stalled, `50` the wait timed out, and `2` for a usage error; every waiter is released, a run already ended returns at once, and killing a wait leaves the run running. The process running an attempt rewrites a heartbeat in its marker every 10 seconds; a run whose heartbeat is older than three intervals and whose process is provably gone is recorded `stalled` by the first reader, through an exclusive claim every reader then agrees on, and `ls` shows each running run's heartbeat age. `pose delegate watch [<run>|<label>]` shows an attempt as one task: the runs it recorded are replayed with a marker where a run resumed another and the interrupted run naming the run that continued it, then a running attempt is followed through the normalized, redacted events its process writes as they come, until the record is published; `--no-follow` prints what exists and exits, `-v` adds the tail of each tool's output (`--lines <n>`, default 12) and `--json` prints NDJSON. With no reference it follows the only running run; at a terminal it otherwise opens fzf with a preview of the run under the cursor refreshed every `--refresh <d>` (default 2s, 0 turns it off), or a numbered menu without fzf; outside a terminal an absent reference exits 2 and lists the candidates. Colours appear only on a terminal and follow `NO_COLOR`. A live event is redacted with the credentials and the session references the stream has declared so far; the events bound to the record are derived again from the whole transcript. `on_terminal` on an agent (or else on a purpose) is a command run once after a run ends, with only `POSE_DELEGATE_RUN` and `POSE_DELEGATE_STATE` in its environment, the run directory as working directory, its own process group and a bound (`timeout`, default 30s, at most 5m); its failure is recorded beside the run, shown by `ls`, and never changes the run's state. `pose delegate handoff <run> --to <agent|auto>` continues a run that stopped interrupted or failed, short of a conclusion, with another agent under the same attempt and its continuation budget, which is the `resume.max_resumes` and `max_wall_time` of the agent that opened the attempt (3 and 60 minutes by default) whichever agent continues it, so changing agents never widens it; a completed run, the same agent and a run already continued are refused, and a run handed off is no longer resumed. Its brief is the predecessor's generated brief followed by a labelled section: the predecessor's partial final message and the commands it ran with their exit status, paired by the call identifier the agent's stream records and otherwise left unknown rather than guessed, each with its digest, quoted so no line of it reads as a decision, bounded at 16 KiB with the cut disclosed, and an instruction to re-verify. Only the handoff run concludes. The record binds the base brief digest and the section digest in `handoff_digest`, names its predecessor in `hands_off_from`, and a signed proof verifies the section against the predecessor's record. `--to auto` routes as the purpose does, the stopped agent excluded and unavailable ones skipped. A foreground run or handoff that stops interrupted in a terminal offers waiting for its reset and resuming, handing off, or cancelling, which is offered even alone, and does nothing until answered; the stopping command's result, `ls --json` and `wait --json` carry the same ways forward as `next_actions`, each with its command, whether it is available now — judged by the planning its command runs, budget and wait bound included — and why not, and a `cancel` that leaves the run stopped. `watch` marks a handoff with `⇄` beside the `↻` of a resume. `pose delegate task <prompt-file|->` hands any task to another agent: the prompt goes on stdin in `--cd` (default: the current directory) with the agent's command for `--access read|sandboxed|write|full`; the default is `purposes.task.default_access` (read when unset), `full` is never a default and prints a warning naming what it disables. A task's template places `{add_dirs}`, `{no_network}` and `{outside_git}`, filled from the agent's `add_dir_args` (with `{dir}`), `no_network_args` and `outside_git_args`; `--add-dir`, `--no-network` and `--effort` that the agent's template cannot carry are refused with exit 2, and `--no-network` with `write` or `full` too. The final message goes to stdout and the agent's exit code is returned; `--json` replaces both with one document. A task runs in the real directory: containment bounds its time and output, not its filesystem. Its record (prompt, stream, error stream, normalized events, argv, removed variable names, exit code, label) is owner-only under the user's state directory (`$XDG_STATE_HOME/pose/delegate/`, where `XDG_STATE_HOME` counts only as an absolute path and `~/.local/state` is the default), or, with `--record`, in the `delegate-runs` directory of `.pose`. The state directory may be reached through a link of the user's own; resolved, it and every directory above it must belong to the user or to root and be writable by no group or other user unless sticky, and `pose`, `pose/delegate` and the project's directory below it must be real directories of the user's that no group or other user can write; a task refuses to record or read anywhere else and names the directory (on Windows only links are refused). `--detach` starts a task as the review purposes start a detached run and returns its attempt, its log and the place of its record; a prompt piped to `task -` or `resume --prompt -` is read before detaching and written to the detached run through a pipe, never a file, and a refusal before the attempt is reserved returns the foreground's document and exit code. A detached call keeps its log and hand-back in `.pose/review-private/supervisors`, which, with every directory up to the project root, must be the user's and writable by no group or other user, and whose root's ancestors must belong to the user or root and be writable by no one else unless sticky; the root is resolved once and only that resolved root is used, a caller whose current directory is gone is refused, and a project's private task history is keyed by its resolved root (records an earlier engine kept under a linked spelling are still read). A detached call believes a hand-back only once a piped prompt is through and a run reserved the attempt it names. A checkout that fails this can still run in the foreground; on Windows only links and non-directories are refused, and ACLs are not checked. A task is never evidence: no review reader reads it, `pose review attest --run` refuses it by name, and `wait` returns 0 when the agent succeeded, with no decision. `ls`, `watch`, `wait`, `cancel`, `resume` and `handoff` work on tasks; `resume` without `--prompt` sends a default continuation message, with the agent's `resume.commands` for the task's access, and `--agent auto` routes against the launching session. A task can also continue a session POSE never recorded, such as one a personal launcher opened, with `--session <id> --agent <name>`: the agent's resume command for the access runs with that session, the prompt optional, and the record says it continued a session without keeping it. `pose review dispatch`, `resume` and `status`, the aliases this surface deprecated, were removed: each exits 2 and names its `pose delegate` replacement.\n \n `delegation.json` is schema 2: `agents` (vendor, model, `cli`, `events`, per-access `commands`, `effort`, `timeout`, `limit`, `session`, `resume`, `executor`, `containment`, `on_terminal`, `probe` — `command` and an optional `timeout` up to 60s, default 10s, with no placeholder), `routing` (`prefer`, `on_unavailable`, `lead_models` as `{vendor: model}` in lower case, `max_wait` up to 24h), per-purpose budgets (`purposes.<review|adjudicate|smoke|task>.max_runs_per_bundle`, `timeout`) and `env_unset`. Command templates are argv arrays; `{output}`, `{session}` and `{effort}` are whole elements, never interpolated, and `{effort}` becomes the argv fragment of the agent's effort level. An agent's own `max_runs_per_bundle` wins over the purpose's; a purpose's `timeout` wins over the agent's. `pose update` converts `reviewers.json` (schema 1) into `delegation.json` deterministically and removes it: each adapter becomes an agent whose `read` command is the adapter's command, a budget all adapters share moves to the review-path purposes, and every agent projects exactly the adapter it came from. The converted file is archived outside `.pose/policy` and named in `migrated_from`, so a run recorded before the conversion keeps its policy baseline while `delegation.json` is exactly that conversion; editing `delegation.json` ends that, as any policy change does. The engine reads `reviewers.json` while `delegation.json` is absent and refuses when both exist. A schema 1 adapter that interpolates `{output}` or `{session}` inside an argument (in `sh -c` code, for example) is not converted: `pose update` warns and keeps `reviewers.json` until the template passes the placeholder as a whole element.\ndiff --git a/pose-mcp/internal/pose/delegation_events.go b/pose-mcp/internal/pose/delegation_events.go\nindex 62421010..a52d6423 100644\n--- a/pose-mcp/internal/pose/delegation_events.go\n+++ b/pose-mcp/internal/pose/delegation_events.go\n@@ -440,3 +440,49 @@ func redactedDelegationEvents(format string, raw []byte, final string, secrets [\n \t}\n \treturn EncodeDelegationEvents(events), nil\n }\n+\n+// A vendor can repeat a typed init for the same session. Canonicalize only\n+// those records for identity recognition; raw provenance and redaction still\n+// use the original bytes. Generic regex captures remain strict, including the\n+// legacy broad session_id pattern that also matches result events.\n+func canonicalDelegationSessionChannel(format, pattern, channel string) (string, error) {\n+\tif format != DelegationEventsClaudeStreamJSON || pattern == \"\" {\n+\t\treturn channel, nil\n+\t}\n+\t_, originalErr := captureReviewValue(pattern, channel)\n+\tif originalErr != nil && originalErr.Error() != \"ambiguous adapter capture\" {\n+\t\treturn \"\", originalErr\n+\t}\n+\tvar out strings.Builder\n+\tidentity := \"\"\n+\tmatched := false\n+\tfor _, chunk := range strings.SplitAfter(channel, \"\\n\") {\n+\t\tline := strings.TrimSuffix(chunk, \"\\n\")\n+\t\tvar event struct {\n+\t\t\tType    string `json:\"type\"`\n+\t\t\tSubtype string `json:\"subtype\"`\n+\t\t\tSession string `json:\"session_id\"`\n+\t\t}\n+\t\tif json.Unmarshal([]byte(line), &event) == nil && event.Type == \"system\" && event.Subtype == \"init\" && event.Session != \"\" {\n+\t\t\tif len(event.Session) > 2048 || strings.ContainsAny(event.Session, \"\\x00\\r\\n\") {\n+\t\t\t\treturn \"\", fmt.Errorf(\"adapter capture is not a bounded reference\")\n+\t\t\t}\n+\t\t\tif identity != \"\" && identity != event.Session {\n+\t\t\t\treturn \"\", fmt.Errorf(\"conflicting adapter capture channels\")\n+\t\t\t}\n+\t\t\tidentity = event.Session\n+\t\t\tvalue, err := captureReviewValue(pattern, line)\n+\t\t\tif err != nil {\n+\t\t\t\treturn \"\", err\n+\t\t\t}\n+\t\t\tif originalErr != nil && value == event.Session {\n+\t\t\t\tif matched {\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n+\t\t\t\tmatched = true\n+\t\t\t}\n+\t\t}\n+\t\tout.WriteString(chunk)\n+\t}\n+\treturn out.String(), nil\n+}\ndiff --git a/pose-mcp/internal/pose/delegation_policy.go b/pose-mcp/internal/pose/delegation_policy.go\nindex 0dd71bc9..af059e9e 100644\n--- a/pose-mcp/internal/pose/delegation_policy.go\n+++ b/pose-mcp/internal/pose/delegation_policy.go\n@@ -94,19 +94,22 @@ type ReviewerEffort struct {\n \n // DelegationAgent is one configured CLI profile.\n type DelegationAgent struct {\n-\tVendor           string               `json:\"vendor\"`\n-\tModel            string               `json:\"model\"`\n-\tCLI              string               `json:\"cli,omitempty\"`\n-\tEvents           string               `json:\"events,omitempty\"`\n-\tCommands         map[string][]string  `json:\"commands\"`\n-\tEffort           *ReviewerEffort      `json:\"effort,omitempty\"`\n-\tTimeout          string               `json:\"timeout,omitempty\"`\n-\tMaxRunsPerBundle int                  `json:\"max_runs_per_bundle,omitempty\"`\n-\tLimit            *ReviewerLimit       `json:\"limit,omitempty\"`\n-\tSession          *ReviewerSession     `json:\"session,omitempty\"`\n-\tResume           *ReviewerResume      `json:\"resume,omitempty\"`\n-\tExecutor         string               `json:\"executor,omitempty\"`\n-\tContainment      *ReviewerContainment `json:\"containment,omitempty\"`\n+\tVendor   string              `json:\"vendor\"`\n+\tModel    string              `json:\"model\"`\n+\tCLI      string              `json:\"cli,omitempty\"`\n+\tEvents   string              `json:\"events,omitempty\"`\n+\tCommands map[string][]string `json:\"commands\"`\n+\t// ReviewProfile selects a separate executable contract for governed review only.\n+\t// Omission preserves the read adapter, including its provenance digest.\n+\tReviewProfile    *DelegationReviewProfile `json:\"review_profile,omitempty\"`\n+\tEffort           *ReviewerEffort          `json:\"effort,omitempty\"`\n+\tTimeout          string                   `json:\"timeout,omitempty\"`\n+\tMaxRunsPerBundle int                      `json:\"max_runs_per_bundle,omitempty\"`\n+\tLimit            *ReviewerLimit           `json:\"limit,omitempty\"`\n+\tSession          *ReviewerSession         `json:\"session,omitempty\"`\n+\tResume           *ReviewerResume          `json:\"resume,omitempty\"`\n+\tExecutor         string                   `json:\"executor,omitempty\"`\n+\tContainment      *ReviewerContainment     `json:\"containment,omitempty\"`\n \t// Probe is an optional availability check (spec pose-delegation-routing\n \t// R6). It is not part of the adapter the review path verifies, so it never\n \t// changes the adapter digest a run's provenance binds; adding one is still a\n@@ -130,6 +133,13 @@ type DelegationAgent struct {\n \tRequires map[string]DelegationRequirement `json:\"requires,omitempty\"`\n }\n \n+// DelegationReviewProfile permits test execution without widening read tasks.\n+// Spec pose-claude-reviewer-runs-tests-in-sandbox.\n+type DelegationReviewProfile struct {\n+\tCommand       []string `json:\"command\"`\n+\tResumeCommand []string `json:\"resume_command,omitempty\"`\n+}\n+\n // DelegationRequirement is what an access profile needs on the machine that runs it.\n type DelegationRequirement struct {\n \tExecutables []string `json:\"executables\"`\n@@ -588,6 +598,28 @@ func validateDelegationPolicy(policy DelegationPolicy) error {\n \t\tif err := validateTaskFragments(name, agent); err != nil {\n \t\t\treturn err\n \t\t}\n+\t\tif profile := agent.ReviewProfile; profile != nil {\n+\t\t\tif len(agent.Commands[DelegationAccessRead]) == 0 {\n+\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s review_profile requires read access\", name)\n+\t\t\t}\n+\t\t\tif err := validateDelegationArgv(profile.Command, agent.Effort); err != nil {\n+\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s review_profile command: %w\", name, err)\n+\t\t\t}\n+\t\t\tfor _, argv := range [][]string{profile.Command, profile.ResumeCommand} {\n+\t\t\t\tfor _, arg := range argv {\n+\t\t\t\t\tif contain