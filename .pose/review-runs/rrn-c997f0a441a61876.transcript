{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UnXHjWbaF5PBqci3FQkw5R","type":"tool_result","content":"60\t// ResolveIdentity reads the identity of the worktree at root for this engine. The root's\n61\t// symlinks are resolved and the Git common directory is read, so neither project_id nor\n62\t// the common directory alone names a mutable tree.\n63\tfunc ResolveIdentity(root, engine, build string) (Identity, error) {\n64\t\tworktree, err := filepath.EvalSymlinks(root)\n65\t\tif err == nil {\n66\t\t\tworktree, err = filepath.Abs(worktree)\n67\t\t}\n68\t\tif err != nil {\n69\t\t\treturn Identity{}, fmt.Errorf(\"the worktree %s cannot be resolved: %w\", root, err)\n70\t\t}\n71\t\tout, err := posemodel.RawHistoryGit(worktree, \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\").Output()\n72\t\tif err != nil {\n73\t\t\treturn Identity{}, fmt.Errorf(\"%s is not a Git worktree, or git failed (%v): the runtime is identified by it\", worktree, err)\n74\t\t}\n75\t\tcommon := strings.TrimSpace(string(out))\n76\t\tif resolved, err := filepath.EvalSymlinks(common); err == nil {\n77\t\t\tcommon = resolved\n78\t\t}\n79\t\treturn Identity{UID: os.Getuid(), Worktree: worktree, GitCommonDir: common, Engine: engine, Build: build, Protocol: Protocol, Schema: Schema}, nil\n80\t}\n81\t\n82\t// location is the digest of the part that names the endpoint.\n83\tfunc (i Identity) location() string {\n84\t\tsum := sha256.Sum256([]byte(fmt.Sprintf(\"%d\\x00%s\\x00%s\", i.UID, i.Worktree, i.GitCommonDir)))\n85\t\treturn hex.EncodeToString(sum[:])[:socketNameDigits]\n86\t}\n87\t\n88\t// Mismatches names each field of the engine part where other differs from i.\n89\tfunc (i Identity) Mismatches(other Identity) []string {\n90\t\tvar out []string\n91\t\tadd := func(name string, mine, theirs any) {\n92\t\t\tif fmt.Sprint(mine) != fmt.Sprint(theirs) {\n93\t\t\t\tout = append(out, fmt.Sprintf(\"%s: this side %v, the other %v\", name, mine, theirs))\n94\t\t\t}\n95\t\t}\n96\t\tadd(\"uid\", i.UID, other.UID)\n97\t\tadd(\"worktree\", i.Worktree, other.Worktree)\n98\t\tadd(\"git_common_dir\", i.GitCommonDir, other.GitCommonDir)\n99\t\tadd(\"engine\", i.Engine, other.Engine)\n100\t\tadd(\"build\", i.Build, other.Build)\n101\t\tadd(\"protocol\", i.Protocol, other.Protocol)\n102\t\tadd(\"schema\", i.Schema, other.Schema)\n103\t\treturn out\n104\t}\n105\t\n106\t// DefaultDir is the directory of the endpoints of the current user.\n107\tfunc DefaultDir() string {\n108\t\tif dir := os.Getenv(EnvDir); dir != \"\" {\n109\t\t\treturn dir\n110\t\t}\n111\t\tif run := os.Getenv(\"XDG_RUNTIME_DIR\"); filepath.IsAbs(run) {\n112\t\t\treturn filepath.Join(run, \"pose\")\n113\t\t}\n114\t\treturn filepath.Join(os.TempDir(), fmt.Sprintf(\"pose-runtime-%d\", os.Getuid()))\n115\t}\n116\t\n117\t// SocketPath is where the endpoint of the identity lives in dir.\n118\tfunc SocketPath(dir string, id Identity) string {\n119\t\treturn filepath.Join(dir, id.location()+\".sock\")\n120\t}\n121\t\n122\t// Errors a client can tell apart.\n123\tvar (\n124\t\tErrUnsupported   = errors.New(\"the worktree runtime is not supported on this platform: every command runs standalone\")\n125\t\tErrNoRuntime     = errors.New(\"no runtime is running for this worktree\")\n126\t\tErrAlreadyServed = errors.New(\"a runtime is already serving this worktree\")\n127\t)\n128\t\n129\t// IncompatibleError is an attach refused at the handshake.\n130\ttype IncompatibleError struct{ Mismatch []string }\n131\t\n132\tfunc (e *IncompatibleError) Error() string {\n133\t\treturn \"the running runtime is not compatible: \" + strings.Join(e.Mismatch, \"; \")\n134\t}\n135\t\n136\t// OutcomeUnknownError is a request that was sent and whose answer did not arrive whole: the\n137\t// operation may have run, so it is not repeated in another process unasked.\n138\ttype OutcomeUnknownError struct{ Cause error }\n139\t\n140\tfunc (e *OutcomeUnknownError) Error() string {\n141\t\treturn \"the runtime did not answer a request it received: \" + e.Cause.Error()\n142\t}\n143\t\n144\tfunc (e *OutcomeUnknownError) Unwrap() error { return e.Cause }\n145\t\n146\t// UnsafeError is an endpoint or directory that fails the ownership, mode or type checks.\n147\ttype UnsafeError struct{ Path, Reason string }\n148\t\n149\tfunc (e *UnsafeError) Error() string { return \"unsafe runtime endpoint \" + e.Path + \": \" + e.Reason }\n150\t\n151\t// EnsureDir creates dir (one level, mode 0700) when it is absent and checks it is a real\n152\t// directory, owned by the user and closed to group and others.\n153\tfunc EnsureDir(dir string) error {\n154\t\tif !Supported() {\n155\t\t\treturn ErrUnsupported\n156\t\t}\n157\t\tinfo, err := os.Lstat(dir)\n158\t\tif errors.Is(err, os.ErrNotExist) {\n159\t\t\tif err := os.Mkdir(dir, 0o700); err != nil && !errors.Is(err, os.ErrExist) {\n160\t\t\t\treturn err\n161\t\t\t}\n162\t\t\tinfo, err = os.Lstat(dir)\n163\t\t}\n164\t\tif err != nil {\n165\t\t\treturn err\n166\t\t}\n167\t\treturn checkDir(dir, info)\n168\t}\n169\t\n170\tfunc checkDir(dir string, info os.FileInfo) error {\n171\t\tswitch {\n172\t\tcase info.Mode()&os.ModeSymlink != 0:\n173\t\t\treturn &UnsafeError{dir, \"it is a symbolic link\"}\n174\t\tcase !info.IsDir():\n175\t\t\treturn &UnsafeError{dir, \"it is not a directory\"}\n176\t\tcase info.Mode().Perm()&0o077 != 0:\n177\t\t\treturn &UnsafeError{dir, fmt.Sprintf(\"its mode %o lets group or others in\", info.Mode().Perm())}\n178\t\t}\n179\t\tif uid, ok := fileOwnerUID(info); ok && int(uid) != os.Getuid() {\n180\t\t\treturn &UnsafeError{dir, fmt.Sprintf(\"it is owned by uid %d, not %d\", uid, os.Getuid())}\n181\t\t}\n182\t\treturn nil\n183\t}\n184\t\n185\t// checkSocket is the check of an endpoint before it is dialled or replaced: a socket owned\n186\t// by the user, not a link or a file someone put there.\n187\tfunc checkSocket(path string) (os.FileInfo, error) {\n188\t\tinfo, err := os.Lstat(path)\n189\t\tif err != nil {\n190\t\t\treturn nil, err\n191\t\t}\n192\t\tif info.Mode()&os.ModeSocket == 0 {\n193\t\t\treturn nil, &UnsafeError{path, \"it is not a socket\"}\n194\t\t}\n195\t\tif uid, ok := fileOwnerUID(info); ok && int(uid) != os.Getuid() {\n196\t\t\treturn nil, &UnsafeError{path, fmt.Sprintf(\"it is owned by uid %d, not %d\", uid, os.Getuid())}\n197\t\t}\n198\t\treturn info, nil\n199\t}\n200\t\n201\t// Request is one message to a runtime. Args, Env and DeadlineMS belong to a hosted operation:\n202\t// the command line, the digest of the environment the caller ran in and how long it may take.\n203\ttype Request struct {\n204\t\tOp         string    `json:\"op\"`\n205\t\tIdentity   *Identity `json:\"identity,omitempty\"`\n206\t\tDrainMS    int       `json:\"drain_ms,omitempty\"`\n207\t\tArgs       []string  `json:\"args,omitempty\"`\n208\t\tEnv        string    `json:\"env,omitempty\"`\n209\t\tDeadlineMS int       `json:\"deadline_ms,omitempty\"`\n210\t}\n211\t\n212\t// Outcomes of a hosted operation. A refused one did not start; an error, a deadline and an\n213\t// unknown outcome may have had effects, so a caller never repeats them elsewhere unasked.\n214\tconst (\n215\t\tOutcomeCompleted = \"completed\"\n216\t\tOutcomeRefused   = \"refused\"\n217\t\tOutcomeDeadline  = \"deadline\"\n218\t\tOutcomeError     = \"error\"\n219\t)\n220\t\n221\t// Reply is the answer of a runtime.\n222\ttype Reply struct {\n223\t\tOK        bool      `json:\"ok\"`\n224\t\tMismatch  []string  `json:\"mismatch,omitempty\"`\n225\t\tError     string    `json:\"error,omitempty\"`\n226\t\tIdentity  *Identity `json:\"identity,omitempty\"`\n227\t\tEpoch     string    `json:\"epoch,omitempty\"`\n228\t\tPID       int       `json:\"pid,omitempty\"`\n229\t\tStartedAt string    `json:\"started_at,omitempty\"`\n230\t\tUptimeMS  int64     `json:\"uptime_ms,omitempty\"`\n231\t\tIdleMS    int64     `json:\"idle_timeout_ms,omitempty\"`\n232\t\tInFlight  int64     `json:\"in_flight\"`\n233\t\tServed    int64     `json:\"served\"`\n234\t\t// Drained and Abandoned answer a stop: the requests in flight that finished within the\n235\t\t// drain deadline and the ones that did not.\n236\t\tDrained   int64 `json:\"drained,omitempty\"`\n237\t\tAbandoned int64 `json:\"abandoned,omitempty\"`\n238\t\t// A hosted operation's typed result.\n239\t\tOutcome   string `json:\"outcome,omitempty\"`\n240\t\tReason    string `json:\"reason,omitempty\"`\n241\t\tExitCode  int    `json:\"exit_code,omitempty\"`\n242\t\tStdout    string `json:\"stdout,omitempty\"`\n243\t\tStderr    string `json:\"stderr,omitempty\"`\n244\t\tElapsedMS int64  `json:\"elapsed_ms,omitempty\"`\n245\t\tMemoHits  int64  `json:\"memo_hits,omitempty\"`\n246\t\t// Metrics are the counters the runtime's host reports.\n247\t\tMetrics map[string]int64 `json:\"metrics,omitempty\"`\n248\t}\n249\t\n250\t// Options start a runtime.\n251\ttype Options struct {\n252\t\tIdentity Identity\n253\t\tDir      string\n254\t\t// Idle stops the runtime after this long without a request; zero never does.\n255\t\tIdle time.Duration\n256\t\t// Metrics, when set, adds named counters to the status and handshake replies (admission,\n257\t\t// queue and wait figures of what the runtime hosts).\n258\t\tMetrics func() map[string]int64\n259\t\t// Busy, when set, counts work a handler left running after it answered (a command whose\n260\t\t// deadline passed): it is in flight for the idle timeout, the drain and the status.\n261\t\tBusy func() int64\n262\t\t// Handler, when set, is called for each request the runtime does not answer itself, and\n263\t\t// counts as in flight while it runs; it reports whether it hosts the operation.\n264\t\tHandler func(ctx context.Context, req Request) (Reply, bool)\n265\t}\n266\t\n267\t// Serve runs the runtime until ctx ends, a client stops it or it idles out. The epoch of\n268\t// each run is new: nothing a previous process knew is inherited.\n269\tfunc Serve(ctx context.Context, opts Options) error {\n270\t\tif !Supported() {\n271\t\t\treturn ErrUnsupported\n272\t\t}\n273\t\tif err := EnsureDir(opts.Dir); err != nil {\n274\t\t\treturn err\n275\t\t}\n276\t\tpath := SocketPath(opts.Dir, opts.Identity)\n277\t\t// One lock per endpoint, held for the life of the runtime: of two concurrent starts only\n278\t\t// one holds it, so only the holder checks for, replaces or removes the socket.\n279\t\tunlock, err := lockEndpoint(path + \".lock\")\n280\t\tif err != nil {\n281\t\t\treturn err\n282\t\t}\n283\t\tdefer unlock()\n284\t\tif err := clearStale(path); err != nil {\n285\t\t\treturn err\n286\t\t}\n287\t\tlistener, err := net.Listen(\"unix\", path)\n288\t\tif err != nil {\n289\t\t\treturn err\n290\t\t}\n291\t\t// The listener would unlink the path on close whatever is there by then; the guard below\n292\t\t// removes it only if it is still ours.\n293\t\tif ul, ok := listener.(*net.UnixListener); ok {\n294\t\t\tul.SetUnlinkOnClose(false)\n295\t\t}\n296\t\tif err := os.Chmod(path, 0o600); err != nil {\n297\t\t\tlistener.Close()\n298\t\t\treturn err\n299\t\t}\n300\t\tours, _ := os.Lstat(path)\n301\t\t// The endpoint is removed only if it is still the one this process created.\n302\t\tdefer func() {\n303\t\t\tif now, err := os.Lstat(path); err == nil && ours != nil && os.SameFile(ours, now) {\n304\t\t\t\tos.Remove(path)\n305\t\t\t}\n306\t\t}()\n307\t\tvar token [8]byte\n308\t\t_, _ = rand.Read(token[:])\n309\t\ts := &server{opts: opts, listener: listener, epoch: hex.EncodeToString(token[:]), started: time.Now(), last: time.Now().UnixNano(), done: make(chan struct{})}\n310\t\treturn s.run(ctx)\n311\t}\n312\t\n313\t// clearStale removes an endpoint nobody answers on, and refuses one somebody does or one\n314\t// that is not a socket of the user.\n315\tfunc clearStale(path string) error {\n316\t\tif _, err := checkSocket(path); err != nil {\n317\t\t\tif errors.Is(err, os.ErrNotExist) {\n318\t\t\t\treturn nil\n319\t\t\t}\n320\t\t\treturn err\n321\t\t}\n322\t\tconn, err := net.DialTimeout(\"unix\", path, time.Second)\n323\t\tif err == nil {\n324\t\t\tconn.Close()\n325\t\t\treturn ErrAlreadyServed\n326\t\t}\n327\t\treturn os.Remove(path)\n328\t}\n329\t\n330\ttype server struct {\n331\t\topts     Options\n332\t\tlistener net.Listener\n333\t\tepoch    string\n334\t\tstarted  time.Time\n335\t\tlast     int64 // unix nanos of the last request, atomic\n336\t\tinflight atomic.Int64\n337\t\tserved   atomic.Int64\n338\t\twg       sync.WaitGroup\n339\t\tdone     chan struct{}\n340\t\tonce     sync.Once\n341\t}\n342\t\n343\tfunc (s *server) run(ctx context.Context) error {\n344\t\tgo func() {\n345\t\t\tselect {\n346\t\t\tcase <-ctx.Done():\n347\t\t\t\ts.shutdown()\n348\t\t\tcase <-s.done:\n349\t\t\t}\n350\t\t}()\n351\t\tif s.opts.Idle > 0 {\n352\t\t\tgo s.watchIdle()\n353\t\t}\n354\t\tfor {\n355\t\t\tconn, err := s.listener.Accept()\n356\t\t\tif err != nil {\n357\t\t\t\tselect {\n358\t\t\t\tcase <-s.done:\n359\t\t\t\t\ts.wg.Wait()\n360\t\t\t\t\treturn nil\n361\t\t\t\tdefault:\n362\t\t\t\t\treturn err\n363\t\t\t\t}\n364\t\t\t}\n365\t\t\ts.inflight.Add(1)\n366\t\t\ts.wg.Add(1)\n367\t\t\tgo func() {\n368\t\t\t\tdefer s.wg.Done()\n369\t\t\t\tdefer s.inflight.Add(-1)\n370\t\t\t\ts.handle(ctx, conn)\n371\t\t\t}()\n372\t\t}\n373\t}\n374\t\n375\tfunc (s *server) shutdown() { s.once.Do(func() { close(s.done); s.listener.Close() }) }\n376\t\n377\tfunc (s *server) watchIdle() {\n378\t\ttick := time.NewTicker(minDuration(s.opts.Idle/4, time.Second))\n379\t\tdefer tick.Stop()\n380\t\tfor {\n381\t\t\tselect {\n382\t\t\tcase <-s.done:\n383\t\t\t\treturn\n384\t\t\tcase <-tick.C:\n385\t\t\t\tif s.inflight.Load()+s.busy() == 0 && time.Since(time.Unix(0, atomic.LoadInt64(&s.last))) >= s.opts.Idle {\n386\t\t\t\t\ts.shutdown()\n387\t\t\t\t\treturn\n388\t\t\t\t}\n389\t\t\t}\n390\t\t}\n391\t}\n392\t\n393\tfunc minDuration(a, b time.Duration) time.Duration {\n394\t\tif a < b && a > 0 {\n395\t\t\treturn a\n396\t\t}\n397\t\treturn b\n398\t}\n399\t\n400\tfunc (s *server) handle(ctx context.Context, conn net.Conn) {\n401\t\tdefer conn.Close()\n402\t\tatomic.StoreInt64(&s.last, time.Now().UnixNano())\n403\t\t// The operating system says who is on the other end before a byte of it is read.\n404\t\tif uc, ok := conn.(*net.UnixConn); !ok {\n405\t\t\treturn\n406\t\t} else if uid, err := peerUID(uc); err != nil || int(uid) != os.Getuid() {\n407\t\t\treturn\n408\t\t}\n409\t\t_ = conn.SetDeadline(time.Now().Add(requestDeadline))\n410\t\tline, err := bufio.NewReaderSize(io.LimitReader(conn, maxRequest), 4096).ReadBytes('\\n')\n411\t\tif err != nil && len(line) == 0 {\n412\t\t\treturn\n413\t\t}\n414\t\tvar req Request\n415\t\tif err := json.Unmarshal(line, &req); err != nil {\n416\t\t\twriteReply(conn, Reply{Error: \"the request is not valid JSON\"})\n417\t\t\treturn\n418\t\t}\n419\t\ts.served.Add(1)\n420\t\tswitch req.Op {\n421\t\tcase \"handshake\":\n422\t\t\tif req.Identity == nil {\n423\t\t\t\twriteReply(conn, Reply{Error: \"a handshake carries the client's identity\"})\n424\t\t\t\treturn\n425\t\t\t}\n426\t\t\tif mism := s.opts.Identity.Mismatches(*req.Identity); len(mism) > 0 {\n427\t\t\t\twriteReply(conn, Reply{Mismatch: mism, Error: \"incompatible\", PID: os.Getpid()})\n428\t\t\t\treturn\n429\t\t\t}\n430\t\t\twriteReply(conn, s.state(true))\n431\t\tcase \"status\":\n432\t\t\twriteReply(conn, s.state(true))\n433\t\tcase \"stop\":\n434\t\t\tdrain := defaultDrain\n435\t\t\tif req.DrainMS > 0 {\n436\t\t\t\tdrain = time.Duration(req.DrainMS) * time.Millisecond\n437\t\t\t}\n438\t\t\t// No new connection is accepted while the requests in flight drain.\n439\t\t\ts.shutdown()\n440\t\t\t// The reply of a long drain must still be writable.\n441\t\t\t_ = conn.SetDeadline(time.Now().Add(drain + requestDeadline))\n442\t\t\treply := s.drain(drain)\n443\t\t\twriteReply(conn, reply)\n444\t\tdefault:\n445\t\t\tif s.opts.Handler != nil {\n446\t\t\t\t// A hosted operation is its own handshake: it carries the caller's identity, and a\n447\t\t\t\t// caller of another engine, build, protocol, schema or worktree is refused before the\n448\t\t\t\t// handler sees it, whatever the caller handshook with a moment before.\n449\t\t\t\tif req.Identity == nil {\n450\t\t\t\t\twriteReply(conn, Reply{Error: \"a hosted operation carries the caller's identity\"})\n451\t\t\t\t\treturn\n452\t\t\t\t}\n453\t\t\t\tif mism := s.opts.Identity.Mismatches(*req.Identity); len(mism) > 0 {\n454\t\t\t\t\twriteReply(conn, Reply{Mismatch: mism, Error: \"incompatible\", PID: os.Getpid()})\n455\t\t\t\t\treturn\n456\t\t\t\t}\n457\t\t\t\t// The reply of a long operation must still be writable.\n458\t\t\t\t_ = conn.SetDeadline(time.Now().Add(hostedDuration(req.DeadlineMS) + requestDeadline))\n459\t\t\t\tif reply, ok := s.opts.Handler(ctx, req); ok {\n460\t\t\t\t\tid := s.opts.Identity\n461\t\t\t\t\treply.Identity, reply.Epoch, reply.PID = &id, s.epoch, os.Getpid()\n462\t\t\t\t\twriteReply(conn, reply)\n463\t\t\t\t\treturn\n464\t\t\t\t}\n465\t\t\t}\n466\t\t\twriteReply(conn, Reply{Error: fmt.Sprintf(\"the runtime does not host the operation %q\", req.Op)})\n467\t\t}\n468\t}\n469\t\n470\t// drain waits, up to the deadline, for the requests in flight besides this one.\n471\tfunc (s *server) drain(deadline time.Duration) Reply {\n472\t\tbefore := s.inflight.Load() + s.busy() - 1\n473\t\tend := time.Now().Add(deadline)\n474\t\tfor s.inflight.Load()+s.busy() > 1 && time.Now().Before(end) {\n475\t\t\ttime.Sleep(5 * time.Millisecond)\n476\t\t}\n477\t\tleft := s.inflight.Load() + s.busy() - 1\n478\t\tif left < 0 {\n479\t\t\tleft = 0\n480\t\t}\n481\t\tif before < 0 {\n482\t\t\tbefore = 0\n483\t\t}\n484\t\tr := s.state(true)\n485\t\tr.Drained, r.Abandoned = before-left, left\n486\t\treturn r\n487\t}\n488\t\n489\tfunc (s *server) busy() int64 {\n490\t\tif s.opts.Busy == nil {\n491\t\t\treturn 0\n492\t\t}\n493\t\treturn s.opts.Busy()\n494\t}\n495\t\n496\tfunc (s *server) state(ok bool) Reply {\n497\t\tid := s.opts.Identity\n498\t\tvar metrics map[string]int64\n499\t\tif s.opts.Metrics != nil {\n500\t\t\tmetrics = s.opts.Metrics()\n501\t\t}\n502\t\treturn Reply{Metrics: metrics, OK: ok, Identity: &id, Epoch: s.epoch, PID: os.Getpid(), StartedAt: s.started.UTC().Format(time.RFC3339),\n503\t\t\tUptimeMS: time.Since(s.started).Milliseconds(), IdleMS: s.opts.Idle.Milliseconds(), InFlight: s.inflight.Load() + s.busy() - 1, Served: s.served.Load()}\n504\t}\n505\t\n506\tfunc writeReply(conn net.Conn, r Reply) {\n507\t\t// Without HTML escaping a < or & in a command's output costs one byte, not six; the output\n508\t\t// travels as UTF-8 text, so bytes that are not valid UTF-8 come back replaced.\n509\t\tvar buf bytes.Buffer\n510\t\tenc := json.NewEncoder(&buf)\n511\t\tenc.SetEscapeHTML(false)\n512\t\t_ = enc.Encode(r)\n513\t\t_, _ = conn.Write(buf.Bytes())\n514\t}\n515\t\n516\t// Client talks to the runtime of one identity.\n517\ttype Client struct {\n518\t\tIdentity Identity\n519\t\tDir      string\n520\t}\n521\t\n522\tfunc (c Client) roundTrip(ctx context.Context, req Request) (Reply, error) {\n523\t\tif !Supported() {\n524\t\t\treturn Reply{}, ErrUnsupported\n525\t\t}\n526\t\tif info, err := os.Lstat(c.Dir); err == nil {\n527\t\t\tif err := checkDir(c.Dir, info); err != nil {\n528\t\t\t\treturn Reply{}, err\n529\t\t\t}\n530\t\t} else if errors.Is(err, os.ErrNotExist) {\n531\t\t\treturn Reply{}, ErrNoRuntime\n532\t\t} else {\n533\t\t\treturn Reply{}, err\n534\t\t}\n535\t\tpath := SocketPath(c.Dir, c.Identity)\n536\t\tif _, err := checkSocket(path); err != nil {\n537\t\t\tif errors.Is(err, os.ErrNotExist) {\n538\t\t\t\treturn Reply{}, ErrNoRuntime\n539\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"3e480619-640a-41f9-b4b3-cbd793af6032","timestamp":"2026-11-10T19:18:05.285Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3317037589/worktree/pose-mcp/internal/worktreeruntime/runtime.go","content":"// ResolveIdentity reads the identity of the worktree at root for this engine. The root's\n// symlinks are resolved and the Git common directory is read, so neither project_id nor\n// the common directory alone names a mutable tree.\nfunc ResolveIdentity(root, engine, build string) (Identity, error) {\n\tworktree, err := filepath.EvalSymlinks(root)\n\tif err == nil {\n\t\tworktree, err = filepath.Abs(worktree)\n\t}\n\tif err != nil {\n\t\treturn Identity{}, fmt.Errorf(\"the worktree %s cannot be resolved: %w\", root, err)\n\t}\n\tout, err := posemodel.RawHistoryGit(worktree, \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\").Output()\n\tif err != nil {\n\t\treturn Identity{}, fmt.Errorf(\"%s is not a Git worktree, or git failed (%v): the runtime is identified by it\", worktree, err)\n\t}\n\tcommon := strings.TrimSpace(string(out))\n\tif resolved, err := filepath.EvalSymlinks(common); err == nil {\n\t\tcommon = resolved\n\t}\n\treturn Identity{UID: os.Getuid(), Worktree: worktree, GitCommonDir: common, Engine: engine, Build: build, Protocol: Protocol, Schema: Schema}, nil\n}\n\n// location is the digest of the part that names the endpoint.\nfunc (i Identity) location() string {\n\tsum := sha256.Sum256([]byte(fmt.Sprintf(\"%d\\x00%s\\x00%s\", i.UID, i.Worktree, i.GitCommonDir)))\n\treturn hex.EncodeToString(sum[:])[:socketNameDigits]\n}\n\n// Mismatches names each field of the engine part where other differs from i.\nfunc (i Identity) Mismatches(other Identity) []string {\n\tvar out []string\n\tadd := func(name string, mine, theirs any) {\n\t\tif fmt.Sprint(mine) != fmt.Sprint(theirs) {\n\t\t\tout = append(out, fmt.Sprintf(\"%s: this side %v, the other %v\", name, mine, theirs))\n\t\t}\n\t}\n\tadd(\"uid\", i.UID, other.UID)\n\tadd(\"worktree\", i.Worktree, other.Worktree)\n\tadd(\"git_common_dir\", i.GitCommonDir, other.GitCommonDir)\n\tadd(\"engine\", i.Engine, other.Engine)\n\tadd(\"build\", i.Build, other.Build)\n\tadd(\"protocol\", i.Protocol, other.Protocol)\n\tadd(\"schema\", i.Schema, other.Schema)\n\treturn out\n}\n\n// DefaultDir is the directory of the endpoints of the current user.\nfunc DefaultDir() string {\n\tif dir := os.Getenv(EnvDir); dir != \"\" {\n\t\treturn dir\n\t}\n\tif run := os.Getenv(\"XDG_RUNTIME_DIR\"); filepath.IsAbs(run) {\n\t\treturn filepath.Join(run, \"pose\")\n\t}\n\treturn filepath.Join(os.TempDir(), fmt.Sprintf(\"pose-runtime-%d\", os.Getuid()))\n}\n\n// SocketPath is where the endpoint of the identity lives in dir.\nfunc SocketPath(dir string, id Identity) string {\n\treturn filepath.Join(dir, id.location()+\".sock\")\n}\n\n// Errors a client can tell apart.\nvar (\n\tErrUnsupported   = errors.New(\"the worktree runtime is not supported on this platform: every command runs standalone\")\n\tErrNoRuntime     = errors.New(\"no runtime is running for this worktree\")\n\tErrAlreadyServed = errors.New(\"a runtime is already serving this worktree\")\n)\n\n// IncompatibleError is an attach refused at the handshake.\ntype IncompatibleError struct{ Mismatch []string }\n\nfunc (e *IncompatibleError) Error() string {\n\treturn \"the running runtime is not compatible: \" + strings.Join(e.Mismatch, \"; \")\n}\n\n// OutcomeUnknownError is a request that was sent and whose answer did not arrive whole: the\n// operation may have run, so it is not repeated in another process unasked.\ntype OutcomeUnknownError struct{ Cause error }\n\nfunc (e *OutcomeUnknownError) Error() string {\n\treturn \"the runtime did not answer a request it received: \" + e.Cause.Error()\n}\n\nfunc (e *OutcomeUnknownError) Unwrap() error { return e.Cause }\n\n// UnsafeError is an endpoint or directory that fails the ownership, mode or type checks.\ntype UnsafeError struct{ Path, Reason string }\n\nfunc (e *UnsafeError) Error() string { return \"unsafe runtime endpoint \" + e.Path + \": \" + e.Reason }\n\n// EnsureDir creates dir (one level, mode 0700) when it is absent and checks it is a real\n// directory, owned by the user and closed to group and others.\nfunc EnsureDir(dir string) error {\n\tif !Supported() {\n\t\treturn ErrUnsupported\n\t}\n\tinfo, err := os.Lstat(dir)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\tif err := os.Mkdir(dir, 0o700); err != nil && !errors.Is(err, os.ErrExist) {\n\t\t\treturn err\n\t\t}\n\t\tinfo, err = os.Lstat(dir)\n\t}\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn checkDir(dir, info)\n}\n\nfunc checkDir(dir string, info os.FileInfo) error {\n\tswitch {\n\tcase info.Mode()&os.ModeSymlink != 0:\n\t\treturn &UnsafeError{dir, \"it is a symbolic link\"}\n\tcase !info.IsDir():\n\t\treturn &UnsafeError{dir, \"it is not a directory\"}\n\tcase info.Mode().Perm()&0o077 != 0:\n\t\treturn &UnsafeError{dir, fmt.Sprintf(\"its mode %o lets group or others in\", info.Mode().Perm())}\n\t}\n\tif uid, ok := fileOwnerUID(info); ok && int(uid) != os.Getuid() {\n\t\treturn &UnsafeError{dir, fmt.Sprintf(\"it is owned by uid %d, not %d\", uid, os.Getuid())}\n\t}\n\treturn nil\n}\n\n// checkSocket is the check of an endpoint before it is dialled or replaced: a socket owned\n// by the user, not a link or a file someone put there.\nfunc checkSocket(path string) (os.FileInfo, error) {\n\tinfo, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif info.Mode()&os.ModeSocket == 0 {\n\t\treturn nil, &UnsafeError{path, \"it is not a socket\"}\n\t}\n\tif uid, ok := fileOwnerUID(info); ok && int(uid) != os.Getuid() {\n\t\treturn nil, &UnsafeError{path, fmt.Sprintf(\"it is owned by uid %d, not %d\", uid, os.Getuid())}\n\t}\n\treturn info, nil\n}\n\n// Request is one message to a runtime. Args, Env and DeadlineMS belong to a hosted operation:\n// the command line, the digest of the environment the caller ran in and how long it may take.\ntype Request struct {\n\tOp         string    `json:\"op\"`\n\tIdentity   *Identity `json:\"identity,omitempty\"`\n\tDrainMS    int       `json:\"drain_ms,omitempty\"`\n\tArgs       []string  `json:\"args,omitempty\"`\n\tEnv        string    `json:\"env,omitempty\"`\n\tDeadlineMS int       `json:\"deadline_ms,omitempty\"`\n}\n\n// Outcomes of a hosted operation. A refused one did not start; an error, a deadline and an\n// unknown outcome may have had effects, so a caller never repeats them elsewhere unasked.\nconst (\n\tOutcomeCompleted = \"completed\"\n\tOutcomeRefused   = \"refused\"\n\tOutcomeDeadline  = \"deadline\"\n\tOutcomeError     = \"error\"\n)\n\n// Reply is the answer of a runtime.\ntype Reply struct {\n\tOK        bool      `json:\"ok\"`\n\tMismatch  []string  `json:\"mismatch,omitempty\"`\n\tError     string    `json:\"error,omitempty\"`\n\tIdentity  *Identity `json:\"identity,omitempty\"`\n\tEpoch     string    `json:\"epoch,omitempty\"`\n\tPID       int       `json:\"pid,omitempty\"`\n\tStartedAt string    `json:\"started_at,omitempty\"`\n\tUptimeMS  int64     `json:\"uptime_ms,omitempty\"`\n\tIdleMS    int64     `json:\"idle_timeout_ms,omitempty\"`\n\tInFlight  int64     `json:\"in_flight\"`\n\tServed    int64     `json:\"served\"`\n\t// Drained and Abandoned answer a stop: the requests in flight that finished within the\n\t// drain deadline and the ones that did not.\n\tDrained   int64 `json:\"drained,omitempty\"`\n\tAbandoned int64 `json:\"abandoned,omitempty\"`\n\t// A hosted operation's typed result.\n\tOutcome   string `json:\"outcome,omitempty\"`\n\tReason    string `json:\"reason,omitempty\"`\n\tExitCode  int    `json:\"exit_code,omitempty\"`\n\tStdout    string `json:\"stdout,omitempty\"`\n\tStderr    string `json:\"stderr,omitempty\"`\n\tElapsedMS int64  `json:\"elapsed_ms,omitempty\"`\n\tMemoHits  int64  `json:\"memo_hits,omitempty\"`\n\t// Metrics are the counters the runtime's host reports.\n\tMetrics map[string]int64 `json:\"metrics,omitempty\"`\n}\n\n// Options start a runtime.\ntype Options struct {\n\tIdentity Identity\n\tDir      string\n\t// Idle stops the runtime after this long without a request; zero never does.\n\tIdle time.Duration\n\t// Metrics, when set, adds named counters to the status and handshake replies (admission,\n\t// queue and wait figures of what the runtime hosts).\n\tMetrics func() map[string]int64\n\t// Busy, when set, counts work a handler left running after it answered (a command whose\n\t// deadline passed): it is in flight for the idle timeout, the drain and the status.\n\tBusy func() int64\n\t// Handler, when set, is called for each request the runtime does not answer itself, and\n\t// counts as in flight while it runs; it reports whether it hosts the operation.\n\tHandler func(ctx context.Context, req Request) (Reply, bool)\n}\n\n// Serve runs the runtime until ctx ends, a client stops it or it idles out. The epoch of\n// each run is new: nothing a previous process knew is inherited.\nfunc Serve(ctx context.Context, opts Options) error {\n\tif !Supported() {\n\t\treturn ErrUnsupported\n\t}\n\tif err := EnsureDir(opts.Dir); err != nil {\n\t\treturn err\n\t}\n\tpath := SocketPath(opts.Dir, opts.Identity)\n\t// One lock per endpoint, held for the life of the runtime: of two concurrent starts only\n\t// one holds it, so only the holder checks for, replaces or removes the socket.\n\tunlock, err := lockEndpoint(path + \".lock\")\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer unlock()\n\tif err := clearStale(path); err != nil {\n\t\treturn err\n\t}\n\tlistener, err := net.Listen(\"unix\", path)\n\tif err != nil {\n\t\treturn err\n\t}\n\t// The listener would unlink the path on close whatever is there by then; the guard below\n\t// removes it only if it is still ours.\n\tif ul, ok := listener.(*net.UnixListener); ok {\n\t\tul.SetUnlinkOnClose(false)\n\t}\n\tif err := os.Chmod(path, 0o600); err != nil {\n\t\tlistener.Close()\n\t\treturn err\n\t}\n\tours, _ := os.Lstat(path)\n\t// The endpoint is removed only if it is still the one this process created.\n\tdefer func() {\n\t\tif now, err := os.Lstat(path); err == nil && ours != nil && os.SameFile(ours, now) {\n\t\t\tos.Remove(path)\n\t\t}\n\t}()\n\tvar token [8]byte\n\t_, _ = rand.Read(token[:])\n\ts := &server{opts: opts, listener: listener, epoch: hex.EncodeToString(token[:]), started: time.Now(), last: time.Now().UnixNano(), done: make(chan struct{})}\n\treturn s.run(ctx)\n}\n\n// clearStale removes an endpoint nobody answers on, and refuses one somebody does or one\n// that is not a socket of the user.\nfunc clearStale(path string) error {\n\tif _, err := checkSocket(path); err != nil {\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\treturn nil\n\t\t}\n\t\treturn err\n\t}\n\tconn, err := net.DialTimeout(\"unix\", path, time.Second)\n\tif err == nil {\n\t\tconn.Close()\n\t\treturn ErrAlreadyServed\n\t}\n\treturn os.Remove(path)\n}\n\ntype server struct {\n\topts     Options\n\tlistener net.Listener\n\tepoch    string\n\tstarted  time.Time\n\tlast     int64 // unix nanos of the last request, atomic\n\tinflight atomic.Int64\n\tserved   atomic.Int64\n\twg       sync.WaitGroup\n\tdone     chan struct{}\n\tonce     sync.Once\n}\n\nfunc (s *server) run(ctx context.Context) error {\n\tgo func() {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\ts.shutdown()\n\t\tcase <-s.done:\n\t\t}\n\t}()\n\tif s.opts.Idle > 0 {\n\t\tgo s.watchIdle()\n\t}\n\tfor {\n\t\tconn, err := s.listener.Accept()\n\t\tif err != nil {\n\t\t\tselect {\n\t\t\tcase <-s.done:\n\t\t\t\ts.wg.Wait()\n\t\t\t\treturn nil\n\t\t\tdefault:\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\ts.inflight.Add(1)\n\t\ts.wg.Add(1)\n\t\tgo func() {\n\t\t\tdefer s.wg.Done()\n\t\t\tdefer s.inflight.Add(-1)\n\t\t\ts.handle(ctx, conn)\n\t\t}()\n\t}\n}\n\nfunc (s *server) shutdown() { s.once.Do(func() { close(s.done); s.listener.Close() }) }\n\nfunc (s *server) watchIdle() {\n\ttick := time.NewTicker(minDuration(s.opts.Idle/4, time.Second))\n\tdefer tick.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-s.done:\n\t\t\treturn\n\t\tcase <-tick.C:\n\t\t\tif s.inflight.Load()+s.busy() == 0 && time.Since(time.Unix(0, atomic.LoadInt64(&s.last))) >= s.opts.Idle {\n\t\t\t\ts.shutdown()\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc minDuration(a, b time.Duration) time.Duration {\n\tif a < b && a > 0 {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc (s *server) handle(ctx context.Context, conn net.Conn) {\n\tdefer conn.Close()\n\tatomic.StoreInt64(&s.last, time.Now().UnixNano())\n\t// The operating system says who is on the other end before a byte of it is read.\n\tif uc, ok := conn.(*net.UnixConn); !ok {\n\t\treturn\n\t} else if uid, err := peerUID(uc); err != nil || int(uid) != os.Getuid() {\n\t\treturn\n\t}\n\t_ = conn.SetDeadline(time.Now().Add(requestDeadline))\n\tline, err := bufio.NewReaderSize(io.LimitReader(conn, maxRequest), 4096).ReadBytes('\\n')\n\tif err != nil && len(line) == 0 {\n\t\treturn\n\t}\n\tvar req Request\n\tif err := json.Unmarshal(line, &req); err != nil {\n\t\twriteReply(conn, Reply{Error: \"the request is not valid JSON\"})\n\t\treturn\n\t}\n\ts.served.Add(1)\n\tswitch req.Op {\n\tcase \"handshake\":\n\t\tif req.Identity == nil {\n\t\t\twriteReply(conn, Reply{Error: \"a handshake carries the client's identity\"})\n\t\t\treturn\n\t\t}\n\t\tif mism := s.opts.Identity.Mismatches(*req.Identity); len(mism) > 0 {\n\t\t\twriteReply(conn, Reply{Mismatch: mism, Error: \"incompatible\", PID: os.Getpid()})\n\t\t\treturn\n\t\t}\n\t\twriteReply(conn, s.state(true))\n\tcase \"status\":\n\t\twriteReply(conn, s.state(true))\n\tcase \"stop\":\n\t\tdrain := defaultDrain\n\t\tif req.DrainMS > 0 {\n\t\t\tdrain = time.Duration(req.DrainMS) * time.Millisecond\n\t\t}\n\t\t// No new connection is accepted while the requests in flight drain.\n\t\ts.shutdown()\n\t\t// The reply of a long drain must still be writable.\n\t\t_ = conn.SetDeadline(time.Now().Add(drain + requestDeadline))\n\t\treply := s.drain(drain)\n\t\twriteReply(conn, reply)\n\tdefault:\n\t\tif s.opts.Handler != nil {\n\t\t\t// A hosted operation is its own handshake: it carries the caller's identity, and a\n\t\t\t// caller of another engine, build, protocol, schema or worktree is refused before the\n\t\t\t// handler sees it, whatever the caller handshook with a moment before.\n\t\t\tif req.Identity == nil {\n\t\t\t\twriteReply(conn, Reply{Error: \"a hosted operation carries the caller's identity\"})\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif mism := s.opts.Identity.Mismatches(*req.Identity); len(mism) > 0 {\n\t\t\t\twriteReply(conn, Reply{Mismatch: mism, Error: \"incompatible\", PID: os.Getpid()})\n\t\t\t\treturn\n\t\t\t}\n\t\t\t// The reply of a long operation must still be writable.\n\t\t\t_ = conn.SetDeadline(time.Now().Add(hostedDuration(req.DeadlineMS) + requestDeadline))\n\t\t\tif reply, ok := s.opts.Handler(ctx, req); ok {\n\t\t\t\tid := s.opts.Identity\n\t\t\t\treply.Identity, reply.Epoch, reply.PID = &id, s.epoch, os.Getpid()\n\t\t\t\twriteReply(conn, reply)\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\twriteReply(conn, Reply{Error: fmt.Sprintf(\"the runtime does not host the operation %q\", req.Op)})\n\t}\n}\n\n// drain waits, up to the deadline, for the requests in flight besides this one.\nfunc (s *server) drain(deadline time.Duration) Reply {\n\tbefore := s.inflight.Load() + s.busy() - 1\n\tend := time.Now().Add(deadline)\n\tfor s.inflight.Load()+s.busy() > 1 && time.Now().Before(end) {\n\t\ttime.Sleep(5 * time.Millisecond)\n\t}\n\tleft := s.inflight.Load() + s.busy() - 1\n\tif left < 0 {\n\t\tleft = 0\n\t}\n\tif before < 0 {\n\t\tbefore = 0\n\t}\n\tr := s.state(true)\n\tr.Drained, r.Abandoned = before-left, left\n\treturn r\n}\n\nfunc (s *server) busy() int64 {\n\tif s.opts.Busy == nil {\n\t\treturn 0\n\t}\n\treturn s.opts.Busy()\n}\n\nfunc (s *server) state(ok bool) Reply {\n\tid := s.opts.Identity\n\tvar metrics map[string]int64\n\tif s.opts.Metrics != nil {\n\t\tmetrics = s.opts.Metrics()\n\t}\n\treturn Reply{Metrics: metrics, OK: ok, Identity: &id, Epoch: s.epoch, PID: os.Getpid(), StartedAt: s.started.UTC().Format(time.RFC3339),\n\t\tUptimeMS: time.Since(s.started).Milliseconds(), IdleMS: s.opts.Idle.Milliseconds(), InFlight: s.inflight.Load() + s.busy() - 1, Served: s.served.Load()}\n}\n\nfunc writeReply(conn net.Conn, r Reply) {\n\t// Without HTML escaping a < or & in a command's output costs one byte, not six; the output\n\t// travels as UTF-8 text, so bytes that are not valid UTF-8 come back replaced.\n\tvar buf bytes.Buffer\n\tenc := json.NewEncoder(&buf)\n\tenc.SetEscapeHTML(false)\n\t_ = enc.Encode(r)\n\t_, _ = conn.Write(buf.Bytes())\n}\n\n// Client talks to the runtime of one identity.\ntype Client struct {\n\tIdentity Identity\n\tDir      string\n}\n\nfunc (c Client) roundTrip(ctx context.Context, req Request) (Reply, error) {\n\tif !Supported() {\n\t\treturn Reply{}, ErrUnsupported\n\t}\n\tif info, err := os.Lstat(c.Dir); err == nil {\n\t\tif err := checkDir(c.Dir, info); err != nil {\n\t\t\treturn Reply{}, err\n\t\t}\n\t} else if errors.Is(err, os.ErrNotExist) {\n\t\treturn Reply{}, ErrNoRuntime\n\t} else {\n\t\treturn Reply{}, err\n\t}\n\tpath := SocketPath(c.Dir, c.Identity)\n\tif _, err := checkSocket(path); err != nil {\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\treturn Reply{}, ErrNoRuntime\n\t\t}","numLines":480,"startLine":60,"totalLines":655}},"tool_result_meta":[{"id":"toolu_01UnXHjWbaF5PBqci3FQkw5R","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
