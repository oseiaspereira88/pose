{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Hz4u8niHdympP4E3LqocKx","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"runtime\"\n5\t\t\"sync/atomic\"\n6\t\t\"time\"\n7\t)\n8\t\n9\t// Spec pose-worktree-runtime-qos-and-measurement.\n10\t\n11\t// runtimeAdmission is the runtime's policy for hosted commands: two lanes, each with its own\n12\t// slots and queue, so that a short query is never queued behind a heavy check, and a bound on\n13\t// what waits. The defaults are the ones the measurements of the spec were made with.\n14\ttype runtimeAdmission struct {\n15\t\tHeavySlots, ShortSlots int\n16\t\tHeavyQueue, ShortQueue int\n17\t\tMemoMiB                int\n18\t}\n19\t\n20\tfunc defaultRuntimeAdmission() runtimeAdmission {\n21\t\theavy := 1\n22\t\tshort := 2\n23\t\tif runtime.GOMAXPROCS(0) < 2 {\n24\t\t\tshort = 1\n25\t\t}\n26\t\treturn runtimeAdmission{HeavySlots: heavy, ShortSlots: short, HeavyQueue: 4, ShortQueue: 16, MemoMiB: 256}\n27\t}\n28\t\n29\t// shortCommands are the hosted commands that answer in well under a second on a repository of\n30\t// this size (measured in the spec: surface-check of one spec takes about 10 ms; roadmap-check\n31\t// takes minutes here); every other hosted command is heavy.\n32\tvar shortCommands = map[string]bool{\"surface-check\": true}\n33\t\n34\t// hostedLane is one lane of the admission policy and its counters.\n35\ttype hostedLane struct {\n36\t\tname     string\n37\t\tslots    chan struct{}\n38\t\tmaxQueue int64\n39\t\tqueued   atomic.Int64\n40\t\trunning  atomic.Int64\n41\t\tadmitted atomic.Int64\n42\t\trefused  atomic.Int64\n43\t\twaitNS   atomic.Int64\n44\t\tmaxWait  atomic.Int64\n45\t}\n46\t\n47\tfunc newHostedLane(name string, slots, queue int) *hostedLane {\n48\t\tif slots < 1 {\n49\t\t\tslots = 1\n50\t\t}\n51\t\treturn &hostedLane{name: name, slots: make(chan struct{}, slots), maxQueue: int64(queue)}\n52\t}\n53\t\n54\t// enter reserves a place in the queue; false means every slot is busy and the queue is full,\n55\t// and the command is refused before it waits. Two arrivals that find the same last free slot\n56\t// may both wait: the queue limit can be exceeded by the arrivals of one instant.\n57\tfunc (l *hostedLane) enter() bool {\n58\t\tif l.queued.Add(1) > l.maxQueue && len(l.slots) == cap(l.slots) {\n59\t\t\tl.queued.Add(-1)\n60\t\t\tl.refused.Add(1)\n61\t\t\treturn false\n62\t\t}\n63\t\treturn true\n64\t}\n65\t\n66\tfunc (l *hostedLane) admit(wait time.Duration) {\n67\t\tl.queued.Add(-1)\n68\t\tl.running.Add(1)\n69\t\tl.admitted.Add(1)\n70\t\tl.waitNS.Add(int64(wait))\n71\t\tfor {\n72\t\t\tcur := l.maxWait.Load()\n73\t\t\tif int64(wait) <= cur || l.maxWait.CompareAndSwap(cur, int64(wait)) {\n74\t\t\t\treturn\n75\t\t\t}\n76\t\t}\n77\t}\n78\t\n79\tfunc (l *hostedLane) withdrawn() { l.queued.Add(-1); l.refused.Add(1) }\n80\t\n81\tfunc (l *hostedLane) metrics(out map[string]int64) {\n82\t\tout[l.name+\"_slots\"] = int64(cap(l.slots))\n83\t\tout[l.name+\"_queue_limit\"] = l.maxQueue\n84\t\tout[l.name+\"_queued\"] = l.queued.Load()\n85\t\tout[l.name+\"_running\"] = l.running.Load()\n86\t\tout[l.name+\"_admitted\"] = l.admitted.Load()\n87\t\tout[l.name+\"_refused\"] = l.refused.Load()\n88\t\tout[l.name+\"_wait_ms_total\"] = l.waitNS.Load() / int64(time.Millisecond)\n89\t\tout[l.name+\"_wait_ms_max\"] = l.maxWait.Load() / int64(time.Millisecond)\n90\t}\n91\t\n92\ttype hostedLanes struct{ heavy, short *hostedLane }\n93\t\n94\tfunc newHostedLanes(p runtimeAdmission) *hostedLanes {\n95\t\treturn &hostedLanes{heavy: newHostedLane(\"heavy\", p.HeavySlots, p.HeavyQueue), short: newHostedLane(\"short\", p.ShortSlots, p.ShortQueue)}\n96\t}\n97\t\n98\tfunc (h *hostedLanes) of(command string) *hostedLane {\n99\t\tif shortCommands[command] {\n100\t\t\treturn h.short\n101\t\t}\n102\t\treturn h.heavy\n103\t}\n104\t\n105\tfunc (h *hostedLanes) metrics() map[string]int64 {\n106\t\tout := map[string]int64{}\n107\t\th.heavy.metrics(out)\n108\t\th.short.metrics(out)\n109\t\treturn out\n110\t}\n111\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"dfea87bf-002c-4d6b-81ea-56eaedac3c81","timestamp":"2026-11-10T08:49:51.026Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2313386238/worktree/pose-mcp/internal/cli/runtime_lanes.go","content":"package cli\n\nimport (\n\t\"runtime\"\n\t\"sync/atomic\"\n\t\"time\"\n)\n\n// Spec pose-worktree-runtime-qos-and-measurement.\n\n// runtimeAdmission is the runtime's policy for hosted commands: two lanes, each with its own\n// slots and queue, so that a short query is never queued behind a heavy check, and a bound on\n// what waits. The defaults are the ones the measurements of the spec were made with.\ntype runtimeAdmission struct {\n\tHeavySlots, ShortSlots int\n\tHeavyQueue, ShortQueue int\n\tMemoMiB                int\n}\n\nfunc defaultRuntimeAdmission() runtimeAdmission {\n\theavy := 1\n\tshort := 2\n\tif runtime.GOMAXPROCS(0) < 2 {\n\t\tshort = 1\n\t}\n\treturn runtimeAdmission{HeavySlots: heavy, ShortSlots: short, HeavyQueue: 4, ShortQueue: 16, MemoMiB: 256}\n}\n\n// shortCommands are the hosted commands that answer in well under a second on a repository of\n// this size (measured in the spec: surface-check of one spec takes about 10 ms; roadmap-check\n// takes minutes here); every other hosted command is heavy.\nvar shortCommands = map[string]bool{\"surface-check\": true}\n\n// hostedLane is one lane of the admission policy and its counters.\ntype hostedLane struct {\n\tname     string\n\tslots    chan struct{}\n\tmaxQueue int64\n\tqueued   atomic.Int64\n\trunning  atomic.Int64\n\tadmitted atomic.Int64\n\trefused  atomic.Int64\n\twaitNS   atomic.Int64\n\tmaxWait  atomic.Int64\n}\n\nfunc newHostedLane(name string, slots, queue int) *hostedLane {\n\tif slots < 1 {\n\t\tslots = 1\n\t}\n\treturn &hostedLane{name: name, slots: make(chan struct{}, slots), maxQueue: int64(queue)}\n}\n\n// enter reserves a place in the queue; false means every slot is busy and the queue is full,\n// and the command is refused before it waits. Two arrivals that find the same last free slot\n// may both wait: the queue limit can be exceeded by the arrivals of one instant.\nfunc (l *hostedLane) enter() bool {\n\tif l.queued.Add(1) > l.maxQueue && len(l.slots) == cap(l.slots) {\n\t\tl.queued.Add(-1)\n\t\tl.refused.Add(1)\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc (l *hostedLane) admit(wait time.Duration) {\n\tl.queued.Add(-1)\n\tl.running.Add(1)\n\tl.admitted.Add(1)\n\tl.waitNS.Add(int64(wait))\n\tfor {\n\t\tcur := l.maxWait.Load()\n\t\tif int64(wait) <= cur || l.maxWait.CompareAndSwap(cur, int64(wait)) {\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc (l *hostedLane) withdrawn() { l.queued.Add(-1); l.refused.Add(1) }\n\nfunc (l *hostedLane) metrics(out map[string]int64) {\n\tout[l.name+\"_slots\"] = int64(cap(l.slots))\n\tout[l.name+\"_queue_limit\"] = l.maxQueue\n\tout[l.name+\"_queued\"] = l.queued.Load()\n\tout[l.name+\"_running\"] = l.running.Load()\n\tout[l.name+\"_admitted\"] = l.admitted.Load()\n\tout[l.name+\"_refused\"] = l.refused.Load()\n\tout[l.name+\"_wait_ms_total\"] = l.waitNS.Load() / int64(time.Millisecond)\n\tout[l.name+\"_wait_ms_max\"] = l.maxWait.Load() / int64(time.Millisecond)\n}\n\ntype hostedLanes struct{ heavy, short *hostedLane }\n\nfunc newHostedLanes(p runtimeAdmission) *hostedLanes {\n\treturn &hostedLanes{heavy: newHostedLane(\"heavy\", p.HeavySlots, p.HeavyQueue), short: newHostedLane(\"short\", p.ShortSlots, p.ShortQueue)}\n}\n\nfunc (h *hostedLanes) of(command string) *hostedLane {\n\tif shortCommands[command] {\n\t\treturn h.short\n\t}\n\treturn h.heavy\n}\n\nfunc (h *hostedLanes) metrics() map[string]int64 {\n\tout := map[string]int64{}\n\th.heavy.metrics(out)\n\th.short.metrics(out)\n\treturn out\n}\n","numLines":111,"startLine":1,"totalLines":111}},"tool_result_meta":[{"id":"toolu_01Hz4u8niHdympP4E3LqocKx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
