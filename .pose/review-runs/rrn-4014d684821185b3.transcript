{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015xEQSYNiXrW1XwZ3eSLJnx","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"crypto/sha256\"\n7\t\t\"encoding/hex\"\n8\t\t\"encoding/json\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"sort\"\n14\t\t\"strings\"\n15\t\t\"sync/atomic\"\n16\t\t\"time\"\n17\t\n18\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n19\t\t\"github.com/harne8/pose-mcp/internal/version\"\n20\t\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n21\t)\n22\t\n23\t// Spec pose-worktree-runtime-resident-cache.\n24\t\n25\tconst runtimeRunSchema = \"pose.runtime.run/1\"\n26\t\n27\t// maxHostedOutput bounds what a hosted command's reply carries; past it the reply says the\n28\t// command ran and its output is not sent.\n29\tconst maxHostedOutput = 2 << 20\n30\t\n31\t// hostedCommands are the commands the runtime runs for a caller: the checks that read the\n32\t// project and answer. They run as the user that started the runtime, in its worktree, with\n33\t// the environment digest the caller proved equal to the runtime's: a caller never gains,\n34\t// through the runtime, an authority it does not have standalone.\n35\tvar hostedCommands = map[string]bool{\n36\t\t\"review-check\": true, \"closeout-check\": true, \"artifact-check\": true, \"surface-check\": true, \"roadmap-check\": true,\n37\t}\n38\t\n39\t// runtimeEnvDigest is the digest of the environment that decides what a command answers: the\n40\t// POSE_, HARNE8_, GIT_, CLAUDE and CODEX variables (project roots, identities, session markers\n41\t// seals detect), the locale, the home and state directories and NO_COLOR.\n42\tfunc runtimeEnvDigest(environ []string) string {\n43\t\tkeep := func(k string) bool {\n44\t\t\tfor _, p := range []string{\"POSE_\", \"HARNE8_\", \"GIT_\", \"CLAUDE\", \"CODEX\", \"XDG_STATE_HOME\", \"XDG_CONFIG_HOME\", \"XDG_RUNTIME_DIR\"} {\n45\t\t\t\tif strings.HasPrefix(k, p) {\n46\t\t\t\t\treturn true\n47\t\t\t\t}\n48\t\t\t}\n49\t\t\tswitch k {\n50\t\t\tcase \"LC_ALL\", \"LANG\", \"LANGUAGE\", \"HOME\", \"NO_COLOR\", \"USER\", \"LOGNAME\":\n51\t\t\t\treturn true\n52\t\t\t}\n53\t\t\treturn false\n54\t\t}\n55\t\tvar pairs []string\n56\t\tfor _, kv := range environ {\n57\t\t\tif k, _, ok := strings.Cut(kv, \"=\"); ok && keep(k) {\n58\t\t\t\tpairs = append(pairs, kv)\n59\t\t\t}\n60\t\t}\n61\t\tsort.Strings(pairs)\n62\t\tsum := sha256.Sum256([]byte(strings.Join(pairs, \"\\x00\")))\n63\t\treturn hex.EncodeToString(sum[:])\n64\t}\n65\t\n66\t// runtimeHostedRun runs a hosted command; tests replace it.\n67\ttype hostedRunFunc func(args []string, out, errb io.Writer) int\n68\t\n69\tvar runtimeHostedRun atomic.Pointer[hostedRunFunc]\n70\t\n71\t// Set at init: mainCommand reaches this file through cmdRuntime, so a variable initialised with\n72\t// it would be an initialization cycle.\n73\tfunc init() {\n74\t\trun := hostedRunFunc(func(args []string, out, errb io.Writer) int { return mainCommand(args, out, errb) })\n75\t\truntimeHostedRun.Store(&run)\n76\t}\n77\t\n78\t// runtimeHostedHandler runs the commands the runtime hosts, one at a time (the commands read\n79\t// and may refresh the project's derived files, so two at once would race themselves), and\n80\t// answers with a typed result. Anything it does not host or will not run is refused before it\n81\t// starts.\n82\tfunc runtimeHostedHandler(envDigest string, busy *atomic.Int64, lanes *hostedLanes) func(context.Context, worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n83\t\treturn func(ctx context.Context, req worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n84\t\t\tif req.Op != \"run\" {\n85\t\t\t\treturn worktreeruntime.Reply{}, false\n86\t\t\t}\n87\t\t\trefuse := func(why string) (worktreeruntime.Reply, bool) {\n88\t\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeRefused, Reason: why}, true\n89\t\t\t}\n90\t\t\tswitch {\n91\t\t\tcase len(req.Args) == 0 || !hostedCommands[req.Args[0]]:\n92\t\t\t\treturn refuse(\"the runtime does not host this command\")\n93\t\t\tcase req.Env != envDigest:\n94\t\t\t\treturn refuse(\"the caller's environment differs from the one the runtime started in\")\n95\t\t\t}\n96\t\t\tstarted := time.Now()\n97\t\t\t// One hosted command at a time. The deadline covers the wait for its turn: a command\n98\t\t\t// that has not started by then is withdrawn and refused, so its caller may run it\n99\t\t\t// standalone without the runtime running it later as well.\n100\t\t\tlimit := time.Duration(req.DeadlineMS) * time.Millisecond\n101\t\t\tif limit <= 0 || limit > worktreeruntime.MaxHostedDuration {\n102\t\t\t\tlimit = worktreeruntime.MaxHostedDuration\n103\t\t\t}\n104\t\t\ttimer := time.NewTimer(limit)\n105\t\t\tdefer timer.Stop()\n106\t\t\tlane := lanes.of(req.Args[0])\n107\t\t\tif !lane.enter() {\n108\t\t\t\treturn refuse(\"the \" + lane.name + \" lane of the runtime is full: this command did not start\")\n109\t\t\t}\n110\t\t\twaitStart := time.Now()\n111\t\t\tselect {\n112\t\t\tcase lane.slots <- struct{}{}:\n113\t\t\t\tlane.admit(time.Since(waitStart))\n114\t\t\tcase <-timer.C:\n115\t\t\t\tlane.withdrawn()\n116\t\t\t\treturn refuse(\"the runtime was busy with another command until the deadline: this one did not start\")\n117\t\t\tcase <-ctx.Done():\n118\t\t\t\tlane.withdrawn()\n119\t\t\t\treturn refuse(\"the runtime is stopping: this command did not start\")\n120\t\t\t}\n121\t\t\tdone := make(chan worktreeruntime.Reply, 1)\n122\t\t\t// The command counts as work in the runtime until it ends, even after its caller was\n123\t\t\t// answered at a deadline.\n124\t\t\tbusy.Add(1)\n125\t\t\tgo func() {\n126\t\t\t\tdefer busy.Add(-1)\n127\t\t\t\tdefer func() { <-lane.slots; lane.running.Add(-1) }()\n128\t\t\t\thitsBefore, _, _, _ := posemodel.ResidentGitMemoStats()\n129\t\t\t\tvar out, errb bytes.Buffer\n130\t\t\t\tcode := 1\n131\t\t\t\tfunc() {\n132\t\t\t\t\tdefer func() {\n133\t\t\t\t\t\tif r := recover(); r != nil {\n134\t\t\t\t\t\t\terrb.WriteString(\"pose: the command panicked: \" + fmt.Sprint(r) + \"\\n\")\n135\t\t\t\t\t\t}\n136\t\t\t\t\t}()\n137\t\t\t\t\tcode = (*runtimeHostedRun.Load())(req.Args, &out, &errb)\n138\t\t\t\t}()\n139\t\t\t\thitsAfter, _, _, _ := posemodel.ResidentGitMemoStats()\n140\t\t\t\tif out.Len()+errb.Len() > maxHostedOutput {\n141\t\t\t\t\t// The command ran; its output is too large to send whole.\n142\t\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeError, Reason: \"the command's output exceeds what the runtime sends back\", ExitCode: code, ElapsedMS: time.Since(started).Milliseconds()}\n143\t\t\t\t\treturn\n144\t\t\t\t}\n145\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(),\n146\t\t\t\t\tElapsedMS: time.Since(started).Milliseconds(), MemoHits: hitsAfter - hitsBefore}\n147\t\t\t}()\n148\t\t\tselect {\n149\t\t\tcase reply := <-done:\n150\t\t\t\treturn reply, true\n151\t\t\tcase <-timer.C:\n152\t\t\t\t// The command is read-only apart from refreshing derived files and cannot be\n153\t\t\t\t// cancelled; it ends on its own and the next one waits for it.\n154\t\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeDeadline, Reason: \"the deadline passed while the command ran; it was not stopped\", ElapsedMS: time.Since(started).Milliseconds()}, true\n155\t\t\t}\n156\t\t}\n157\t}\n158\t\n159\t// cmdRuntimeRun is `pose runtime run [--envelope] [--timeout <d>] <command> [args...]`: the\n160\t// command runs in the runtime when one is running, compatible and willing, and standalone in\n161\t// this process otherwise. The exit code and the output are the command's; --envelope prints\n162\t// one document with them and with where it ran. A command that reached the runtime and whose\n163\t// answer did not come back whole is never rerun here: it may have run.\n164\tfunc cmdRuntimeRun(root string, args []string, stdout, stderr io.Writer) int {\n165\t\tenvelope, timeout := false, time.Duration(0)\n166\t\tfor len(args) > 0 && strings.HasPrefix(args[0], \"--\") {\n167\t\t\tswitch args[0] {\n168\t\t\tcase \"--envelope\":\n169\t\t\t\tenvelope = true\n170\t\t\t\targs = args[1:]\n171\t\t\tcase \"--timeout\":\n172\t\t\t\tif len(args) < 2 {\n173\t\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: --timeout needs a duration\")\n174\t\t\t\t\treturn 2\n175\t\t\t\t}\n176\t\t\t\td, err := time.ParseDuration(args[1])\n177\t\t\t\tif err != nil || d <= 0 {\n178\t\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: \" + args[1] + \" is not a duration\")\n179\t\t\t\t\treturn 2\n180\t\t\t\t}\n181\t\t\t\ttimeout, args = d, args[2:]\n182\t\t\tdefault:\n183\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: unknown flag \" + args[0])\n184\t\t\t\treturn 2\n185\t\t\t}\n186\t\t}\n187\t\tif len(args) == 0 {\n188\t\t\trender(stdout, stderr).Usage(tr(\"usage: pose runtime run [--envelope] [--timeout <d>] <command> [args...]\", \"uso: pose runtime run [--envelope] [--timeout <d>] <comando> [args...]\"))\n189\t\t\treturn 2\n190\t\t}\n191\t\tvia, reason := \"standalone\", \"\"\n192\t\tvar reply worktreeruntime.Reply\n193\t\tid, err := worktreeruntime.ResolveIdentity(root, version.Version, runtimeBuild())\n194\t\tif err == nil && hostedCommands[args[0]] {\n195\t\t\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n196\t\t\tif _, herr := client.Handshake(context.Background()); herr != nil {\n197\t\t\t\treason = herr.Error()\n198\t\t\t} else {\n199\t\t\t\tvar rerr error\n200\t\t\t\treply, rerr = client.Run(context.Background(), args, runtimeEnvDigest(os.Environ()), timeout)\n201\t\t\t\tvar unknown *worktreeruntime.OutcomeUnknownError\n202\t\t\t\tswitch {\n203\t\t\t\tcase errors.As(rerr, &unknown):\n204\t\t\t\t\treturn runtimeRunUnknown(stdout, stderr, envelope, args, rerr)\n205\t\t\t\tcase rerr != nil:\n206\t\t\t\t\treason = rerr.Error()\n207\t\t\t\tcase reply.Outcome == worktreeruntime.OutcomeCompleted:\n208\t\t\t\t\tvia = \"runtime\"\n209\t\t\t\tcase reply.Outcome == worktreeruntime.OutcomeRefused:\n210\t\t\t\t\treason = reply.Reason\n211\t\t\t\tcase reply.Outcome == worktreeruntime.OutcomeError:\n212\t\t\t\t\t// The command ran and ended; only its output was too large to bring back. The\n213\t\t\t\t\t// outcome is known, so the exit code is the command's.\n214\t\t\t\t\tvia, reply.Stderr = \"runtime\", reply.Reason+\"\\n\"\n215\t\t\t\tdefault:\n216\t\t\t\t\treturn runtimeRunUnknown(stdout, stderr, envelope, args, errors.New(reply.Outcome+\": \"+reply.Reason))\n217\t\t\t\t}\n218\t\t\t}\n219\t\t} else if err != nil {\n220\t\t\treason = err.Error()\n221\t\t} else {\n222\t\t\treason = \"the command is not one the runtime hosts\"\n223\t\t}\n224\t\tif via == \"standalone\" {\n225\t\t\tvar out, errb bytes.Buffer\n226\t\t\tstarted := time.Now()\n227\t\t\tcode := mainCommand(args, &out, &errb)\n228\t\t\treply = worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(), ElapsedMS: time.Since(started).Milliseconds()}\n229\t\t}\n230\t\tif envelope {\n231\t\t\tdoc := map[string]any{\"schema\": runtimeRunSchema, \"via\": via, \"outcome\": reply.Outcome, \"exit_code\": reply.ExitCode, \"stdout\": reply.Stdout, \"stderr\": reply.Stderr, \"elapsed_ms\": reply.ElapsedMS}\n232\t\t\tif reason != \"\" {\n233\t\t\t\tdoc[\"fallback_reason\"] = reason\n234\t\t\t}\n235\t\t\tif via == \"runtime\" {\n236\t\t\t\tdoc[\"epoch\"], doc[\"memo_hits\"] = reply.Epoch, reply.MemoHits\n237\t\t\t}\n238\t\t\t_ = json.NewEncoder(stdout).Encode(doc)\n239\t\t\treturn reply.ExitCode\n240\t\t}\n241\t\t// The command's own output, passed through byte for byte.\n242\t\t_, _ = stdout.Write([]byte(reply.Stdout))\n243\t\t_, _ = stderr.Write([]byte(reply.Stderr))\n244\t\treturn reply.ExitCode\n245\t}\n246\t\n247\tfunc runtimeRunUnknown(stdout, stderr io.Writer, envelope bool, args []string, err error) int {\n248\t\tmsg := \"pose runtime run \" + args[0] + \": \" + err.Error() + \"; \" + tr(\"it may have run, so it was not repeated here: check its effects before running it again\", \"pode ter rodado, então não foi repetido aqui: confira seus efeitos antes de rodá-lo de novo\")\n249\t\tif envelope {\n250\t\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeRunSchema, \"via\": \"runtime\", \"outcome\": \"unknown\", \"exit_code\": 1, \"stderr\": msg})\n251\t\t\treturn 1\n252\t\t}\n253\t\trender(stdout, stderr).Failure(msg)\n254\t\treturn 1\n255\t}\n256\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"096aa70f-659f-48d9-a779-62abc3064f10","timestamp":"2026-11-10T08:50:07.469Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2313386238/worktree/pose-mcp/internal/cli/runtime_host.go","content":"package cli\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n)\n\n// Spec pose-worktree-runtime-resident-cache.\n\nconst runtimeRunSchema = \"pose.runtime.run/1\"\n\n// maxHostedOutput bounds what a hosted command's reply carries; past it the reply says the\n// command ran and its output is not sent.\nconst maxHostedOutput = 2 << 20\n\n// hostedCommands are the commands the runtime runs for a caller: the checks that read the\n// project and answer. They run as the user that started the runtime, in its worktree, with\n// the environment digest the caller proved equal to the runtime's: a caller never gains,\n// through the runtime, an authority it does not have standalone.\nvar hostedCommands = map[string]bool{\n\t\"review-check\": true, \"closeout-check\": true, \"artifact-check\": true, \"surface-check\": true, \"roadmap-check\": true,\n}\n\n// runtimeEnvDigest is the digest of the environment that decides what a command answers: the\n// POSE_, HARNE8_, GIT_, CLAUDE and CODEX variables (project roots, identities, session markers\n// seals detect), the locale, the home and state directories and NO_COLOR.\nfunc runtimeEnvDigest(environ []string) string {\n\tkeep := func(k string) bool {\n\t\tfor _, p := range []string{\"POSE_\", \"HARNE8_\", \"GIT_\", \"CLAUDE\", \"CODEX\", \"XDG_STATE_HOME\", \"XDG_CONFIG_HOME\", \"XDG_RUNTIME_DIR\"} {\n\t\t\tif strings.HasPrefix(k, p) {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t\tswitch k {\n\t\tcase \"LC_ALL\", \"LANG\", \"LANGUAGE\", \"HOME\", \"NO_COLOR\", \"USER\", \"LOGNAME\":\n\t\t\treturn true\n\t\t}\n\t\treturn false\n\t}\n\tvar pairs []string\n\tfor _, kv := range environ {\n\t\tif k, _, ok := strings.Cut(kv, \"=\"); ok && keep(k) {\n\t\t\tpairs = append(pairs, kv)\n\t\t}\n\t}\n\tsort.Strings(pairs)\n\tsum := sha256.Sum256([]byte(strings.Join(pairs, \"\\x00\")))\n\treturn hex.EncodeToString(sum[:])\n}\n\n// runtimeHostedRun runs a hosted command; tests replace it.\ntype hostedRunFunc func(args []string, out, errb io.Writer) int\n\nvar runtimeHostedRun atomic.Pointer[hostedRunFunc]\n\n// Set at init: mainCommand reaches this file through cmdRuntime, so a variable initialised with\n// it would be an initialization cycle.\nfunc init() {\n\trun := hostedRunFunc(func(args []string, out, errb io.Writer) int { return mainCommand(args, out, errb) })\n\truntimeHostedRun.Store(&run)\n}\n\n// runtimeHostedHandler runs the commands the runtime hosts, one at a time (the commands read\n// and may refresh the project's derived files, so two at once would race themselves), and\n// answers with a typed result. Anything it does not host or will not run is refused before it\n// starts.\nfunc runtimeHostedHandler(envDigest string, busy *atomic.Int64, lanes *hostedLanes) func(context.Context, worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n\treturn func(ctx context.Context, req worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n\t\tif req.Op != \"run\" {\n\t\t\treturn worktreeruntime.Reply{}, false\n\t\t}\n\t\trefuse := func(why string) (worktreeruntime.Reply, bool) {\n\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeRefused, Reason: why}, true\n\t\t}\n\t\tswitch {\n\t\tcase len(req.Args) == 0 || !hostedCommands[req.Args[0]]:\n\t\t\treturn refuse(\"the runtime does not host this command\")\n\t\tcase req.Env != envDigest:\n\t\t\treturn refuse(\"the caller's environment differs from the one the runtime started in\")\n\t\t}\n\t\tstarted := time.Now()\n\t\t// One hosted command at a time. The deadline covers the wait for its turn: a command\n\t\t// that has not started by then is withdrawn and refused, so its caller may run it\n\t\t// standalone without the runtime running it later as well.\n\t\tlimit := time.Duration(req.DeadlineMS) * time.Millisecond\n\t\tif limit <= 0 || limit > worktreeruntime.MaxHostedDuration {\n\t\t\tlimit = worktreeruntime.MaxHostedDuration\n\t\t}\n\t\ttimer := time.NewTimer(limit)\n\t\tdefer timer.Stop()\n\t\tlane := lanes.of(req.Args[0])\n\t\tif !lane.enter() {\n\t\t\treturn refuse(\"the \" + lane.name + \" lane of the runtime is full: this command did not start\")\n\t\t}\n\t\twaitStart := time.Now()\n\t\tselect {\n\t\tcase lane.slots <- struct{}{}:\n\t\t\tlane.admit(time.Since(waitStart))\n\t\tcase <-timer.C:\n\t\t\tlane.withdrawn()\n\t\t\treturn refuse(\"the runtime was busy with another command until the deadline: this one did not start\")\n\t\tcase <-ctx.Done():\n\t\t\tlane.withdrawn()\n\t\t\treturn refuse(\"the runtime is stopping: this command did not start\")\n\t\t}\n\t\tdone := make(chan worktreeruntime.Reply, 1)\n\t\t// The command counts as work in the runtime until it ends, even after its caller was\n\t\t// answered at a deadline.\n\t\tbusy.Add(1)\n\t\tgo func() {\n\t\t\tdefer busy.Add(-1)\n\t\t\tdefer func() { <-lane.slots; lane.running.Add(-1) }()\n\t\t\thitsBefore, _, _, _ := posemodel.ResidentGitMemoStats()\n\t\t\tvar out, errb bytes.Buffer\n\t\t\tcode := 1\n\t\t\tfunc() {\n\t\t\t\tdefer func() {\n\t\t\t\t\tif r := recover(); r != nil {\n\t\t\t\t\t\terrb.WriteString(\"pose: the command panicked: \" + fmt.Sprint(r) + \"\\n\")\n\t\t\t\t\t}\n\t\t\t\t}()\n\t\t\t\tcode = (*runtimeHostedRun.Load())(req.Args, &out, &errb)\n\t\t\t}()\n\t\t\thitsAfter, _, _, _ := posemodel.ResidentGitMemoStats()\n\t\t\tif out.Len()+errb.Len() > maxHostedOutput {\n\t\t\t\t// The command ran; its output is too large to send whole.\n\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeError, Reason: \"the command's output exceeds what the runtime sends back\", ExitCode: code, ElapsedMS: time.Since(started).Milliseconds()}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(),\n\t\t\t\tElapsedMS: time.Since(started).Milliseconds(), MemoHits: hitsAfter - hitsBefore}\n\t\t}()\n\t\tselect {\n\t\tcase reply := <-done:\n\t\t\treturn reply, true\n\t\tcase <-timer.C:\n\t\t\t// The command is read-only apart from refreshing derived files and cannot be\n\t\t\t// cancelled; it ends on its own and the next one waits for it.\n\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeDeadline, Reason: \"the deadline passed while the command ran; it was not stopped\", ElapsedMS: time.Since(started).Milliseconds()}, true\n\t\t}\n\t}\n}\n\n// cmdRuntimeRun is `pose runtime run [--envelope] [--timeout <d>] <command> [args...]`: the\n// command runs in the runtime when one is running, compatible and willing, and standalone in\n// this process otherwise. The exit code and the output are the command's; --envelope prints\n// one document with them and with where it ran. A command that reached the runtime and whose\n// answer did not come back whole is never rerun here: it may have run.\nfunc cmdRuntimeRun(root string, args []string, stdout, stderr io.Writer) int {\n\tenvelope, timeout := false, time.Duration(0)\n\tfor len(args) > 0 && strings.HasPrefix(args[0], \"--\") {\n\t\tswitch args[0] {\n\t\tcase \"--envelope\":\n\t\t\tenvelope = true\n\t\t\targs = args[1:]\n\t\tcase \"--timeout\":\n\t\t\tif len(args) < 2 {\n\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: --timeout needs a duration\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\td, err := time.ParseDuration(args[1])\n\t\t\tif err != nil || d <= 0 {\n\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: \" + args[1] + \" is not a duration\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\ttimeout, args = d, args[2:]\n\t\tdefault:\n\t\t\trender(stdout, stderr).Failure(\"pose runtime run: unknown flag \" + args[0])\n\t\t\treturn 2\n\t\t}\n\t}\n\tif len(args) == 0 {\n\t\trender(stdout, stderr).Usage(tr(\"usage: pose runtime run [--envelope] [--timeout <d>] <command> [args...]\", \"uso: pose runtime run [--envelope] [--timeout <d>] <comando> [args...]\"))\n\t\treturn 2\n\t}\n\tvia, reason := \"standalone\", \"\"\n\tvar reply worktreeruntime.Reply\n\tid, err := worktreeruntime.ResolveIdentity(root, version.Version, runtimeBuild())\n\tif err == nil && hostedCommands[args[0]] {\n\t\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n\t\tif _, herr := client.Handshake(context.Background()); herr != nil {\n\t\t\treason = herr.Error()\n\t\t} else {\n\t\t\tvar rerr error\n\t\t\treply, rerr = client.Run(context.Background(), args, runtimeEnvDigest(os.Environ()), timeout)\n\t\t\tvar unknown *worktreeruntime.OutcomeUnknownError\n\t\t\tswitch {\n\t\t\tcase errors.As(rerr, &unknown):\n\t\t\t\treturn runtimeRunUnknown(stdout, stderr, envelope, args, rerr)\n\t\t\tcase rerr != nil:\n\t\t\t\treason = rerr.Error()\n\t\t\tcase reply.Outcome == worktreeruntime.OutcomeCompleted:\n\t\t\t\tvia = \"runtime\"\n\t\t\tcase reply.Outcome == worktreeruntime.OutcomeRefused:\n\t\t\t\treason = reply.Reason\n\t\t\tcase reply.Outcome == worktreeruntime.OutcomeError:\n\t\t\t\t// The command ran and ended; only its output was too large to bring back. The\n\t\t\t\t// outcome is known, so the exit code is the command's.\n\t\t\t\tvia, reply.Stderr = \"runtime\", reply.Reason+\"\\n\"\n\t\t\tdefault:\n\t\t\t\treturn runtimeRunUnknown(stdout, stderr, envelope, args, errors.New(reply.Outcome+\": \"+reply.Reason))\n\t\t\t}\n\t\t}\n\t} else if err != nil {\n\t\treason = err.Error()\n\t} else {\n\t\treason = \"the command is not one the runtime hosts\"\n\t}\n\tif via == \"standalone\" {\n\t\tvar out, errb bytes.Buffer\n\t\tstarted := time.Now()\n\t\tcode := mainCommand(args, &out, &errb)\n\t\treply = worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(), ElapsedMS: time.Since(started).Milliseconds()}\n\t}\n\tif envelope {\n\t\tdoc := map[string]any{\"schema\": runtimeRunSchema, \"via\": via, \"outcome\": reply.Outcome, \"exit_code\": reply.ExitCode, \"stdout\": reply.Stdout, \"stderr\": reply.Stderr, \"elapsed_ms\": reply.ElapsedMS}\n\t\tif reason != \"\" {\n\t\t\tdoc[\"fallback_reason\"] = reason\n\t\t}\n\t\tif via == \"runtime\" {\n\t\t\tdoc[\"epoch\"], doc[\"memo_hits\"] = reply.Epoch, reply.MemoHits\n\t\t}\n\t\t_ = json.NewEncoder(stdout).Encode(doc)\n\t\treturn reply.ExitCode\n\t}\n\t// The command's own output, passed through byte for byte.\n\t_, _ = stdout.Write([]byte(reply.Stdout))\n\t_, _ = stderr.Write([]byte(reply.Stderr))\n\treturn reply.ExitCode\n}\n\nfunc runtimeRunUnknown(stdout, stderr io.Writer, envelope bool, args []string, err error) int {\n\tmsg := \"pose runtime run \" + args[0] + \": \" + err.Error() + \"; \" + tr(\"it may have run, so it was not repeated here: check its effects before running it again\", \"pode ter rodado, então não foi repetido aqui: confira seus efeitos antes de rodá-lo de novo\")\n\tif envelope {\n\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeRunSchema, \"via\": \"runtime\", \"outcome\": \"unknown\", \"exit_code\": 1, \"stderr\": msg})\n\t\treturn 1\n\t}\n\trender(stdout, stderr).Failure(msg)\n\treturn 1\n}\n","numLines":256,"startLine":1,"totalLines":256}},"tool_result_meta":[{"id":"toolu_015xEQSYNiXrW1XwZ3eSLJnx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgtxeyp4x9Q56MkjTab5k","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XvShk72JN2Zm65SGMVKt5H","name":"Read","input":{"file_path":"/var/tmp/pose-work-go/pose-review-run-2313386238/worktree/pose-mcp/internal/cli/runtime_measure_test.go"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16511,"cache_read_input_tokens":25361,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16511},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"0d8ad821-2a4d-451a-82fe-b651f471a31b","timestamp":"2026-11-10T08:50:07.969Z","request_id":"req_011Cgtxeyf8fUpSdqkZXQCJY","wire_tool_inputs":{"toolu_01XvShk72JN2Zm65SGMVKt5H":{"file_path":"/var/tmp/pose-work-go/pose-review-run-2313386238/worktree/pose-mcp/internal/cli/runtime_measure_test.go"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XvShk72JN2Zm65SGMVKt5H","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"os\"\n8\t\t\"os/exec\"\n9\t\t\"path/filepath\"\n10\t\t\"runtime\"\n11\t\t\"sort\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\t\"sync\"\n15\t\t\"testing\"\n16\t\t\"time\"\n17\t)\n18\t\n19\t// Spec pose-worktree-runtime-qos-and-measurement R8.\n20\t//\n21\t// The measurement of the optional runtime on a real repository. It runs only when\n22\t// POSE_RUNTIME_MEASURE names the output file, because it takes minutes and measures the\n23\t// repository it runs in. The samples, scenarios and thresholds below are fixed here and in the\n24\t// spec before any number is read; the test fails when a threshold is not met, and writes the\n25\t// figures either way.\n26\tconst (\n27\t\tmeasureColdSamples  = 3\n28\t\tmeasureWarmSamples  = 5\n29\t\tmeasureChurnSamples = 3\n30\t\tmeasureShortSamples = 10\n31\t\t// Thresholds (fixed before the first run).\n32\t\tthresholdWarmOverCold    = 0.60 // median warm run <= 0.6 x median cold run\n33\t\tthresholdChurnOverCold   = 0.80 // a restarted runtime inherits nothing: median >= 0.8 x cold\n34\t\tthresholdShortUnderHeavy = 3.0  // p95 of a short query under heavy load <= 3 x idle p95 ...\n35\t\tthresholdShortFloorMS    = 250  // ... or 250 ms, whichever is more\n36\t\tthresholdRSSMiB          = 1536 // resident set of the runtime after the warm runs\n37\t\tthresholdFallbackExtraMS = 500  // trying a runtime that is not there costs at most this\n38\t)\n39\t\n40\ttype measureReport struct {\n41\t\tEnvironment map[string]any     `json:\"environment\"`\n42\t\tScenarios   map[string][]int64 `json:\"scenarios_ms\"`\n43\t\tFigures     map[string]float64 `json:\"figures\"`\n44\t\tMetrics     map[string]int64   `json:\"runtime_metrics\"`\n45\t\tVerdicts    map[string]string  `json:\"verdicts\"`\n46\t}\n47\t\n48\tfunc measureMedian(v []int64) int64 {\n49\t\ts := append([]int64(nil), v...)\n50\t\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n51\t\treturn s[len(s)/2]\n52\t}\n53\t\n54\tfunc measureP95(v []int64) int64 {\n55\t\ts := append([]int64(nil), v...)\n56\t\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n57\t\ti := (len(s)*95 + 99) / 100\n58\t\tif i >= len(s) {\n59\t\t\ti = len(s) - 1\n60\t\t}\n61\t\treturn s[i]\n62\t}\n63\t\n64\tfunc TestMeasureTheRuntimeOnTheRealRepository(t *testing.T) {\n65\t\tout := os.Getenv(\"POSE_RUNTIME_MEASURE\")\n66\t\tif out == \"\" {\n67\t\t\tt.Skip(\"set POSE_RUNTIME_MEASURE=<output file> to measure the runtime on this repository\")\n68\t\t}\n69\t\trepo, err := filepath.Abs(\"../../..\")\n70\t\tif err != nil {\n71\t\t\tt.Fatal(err)\n72\t\t}\n73\t\tspec := os.Getenv(\"POSE_RUNTIME_MEASURE_SPEC\")\n74\t\tif spec == \"\" {\n75\t\t\tspec = \"spec:pose-governance-audit-skips-pure-git-reads\"\n76\t\t}\n77\t\tbin := filepath.Join(t.TempDir(), \"pose\")\n78\t\tif b, err := exec.Command(\"go\", \"build\", \"-o\", bin, \"../../cmd/pose\").CombinedOutput(); err != nil {\n79\t\t\tt.Fatalf(\"build: %v %s\", err, b)\n80\t\t}\n81\t\trtDir, _ := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rtm\")\n82\t\tdefer os.RemoveAll(rtDir)\n83\t\tenv := append(os.Environ(), \"POSE_RUNTIME_DIR=\"+rtDir+\"/r\")\n84\t\tfor _, drop := range []string{\"POSE_PROJECT_ROOT\", \"POSE_PROJECT_ROOTS\", \"POSE_DEFAULT_PROJECT_ID\", \"CLAUDECODE\"} {\n85\t\t\tenv = append(env, drop+\"=\")\n86\t\t}\n87\t\trun := func(args ...string) (string, int64, int) {\n88\t\t\tcmd := exec.Command(bin, args...)\n89\t\t\tcmd.Dir, cmd.Env = repo, env\n90\t\t\tvar o, e bytes.Buffer\n91\t\t\tcmd.Stdout, cmd.Stderr = &o, &e\n92\t\t\tstart := time.Now()\n93\t\t\terr := cmd.Run()\n94\t\t\tcode := 0\n95\t\t\tif ee, ok := err.(*exec.ExitError); ok {\n96\t\t\t\tcode = ee.ExitCode()\n97\t\t\t}\n98\t\t\treturn o.String() + \"\\x00\" + e.String(), time.Since(start).Milliseconds(), code\n99\t\t}\n100\t\truntimeRun := func(args ...string) (stdout string, ms int64, via string) {\n101\t\t\to, ms, _ := run(append([]string{\"runtime\", \"run\", \"--envelope\"}, args...)...)\n102\t\t\tvar doc struct {\n103\t\t\t\tVia, Stdout, Stderr string\n104\t\t\t}\n105\t\t\tdoc.Via = \"\"\n106\t\t\tvar raw map[string]any\n107\t\t\tif err := json.Unmarshal([]byte(strings.SplitN(o, \"\\x00\", 2)[0]), &raw); err != nil {\n108\t\t\t\tt.Fatalf(\"not an envelope: %q\", o)\n109\t\t\t}\n110\t\t\tvia, _ = raw[\"via\"].(string)\n111\t\t\tso, _ := raw[\"stdout\"].(string)\n112\t\t\tse, _ := raw[\"stderr\"].(string)\n113\t\t\treturn so + \"\\x00\" + se, ms, via\n114\t\t}\n115\t\trep := measureReport{Scenarios: map[string][]int64{}, Figures: map[string]float64{}, Verdicts: map[string]string{}}\n116\t\thead, _ := exec.Command(\"git\", \"-C\", repo, \"rev-parse\", \"HEAD\").Output()\n117\t\tcommits, _ := exec.Command(\"git\", \"-C\", repo, \"rev-list\", \"--count\", \"HEAD\").Output()\n118\t\tgitv, _ := exec.Command(\"git\", \"--version\").Output()\n119\t\tkernel, _ := os.ReadFile(\"/proc/sys/kernel/osrelease\")\n120\t\trep.Environment = map[string]any{\"cpus\": runtime.NumCPU(), \"gomaxprocs\": runtime.GOMAXPROCS(0), \"goos\": runtime.GOOS, \"goarch\": runtime.GOARCH,\n121\t\t\t\"go\": runtime.Version(), \"git\": strings.TrimSpace(string(gitv)), \"kernel\": strings.TrimSpace(string(kernel)), \"repo_head\": strings.TrimSpace(string(head)),\n122\t\t\t\"repo_commits\": strings.TrimSpace(string(commits)), \"check\": \"review-check \" + spec, \"short_query\": \"surface-check \" + spec,\n123\t\t\t\"samples\": map[string]int{\"cold\": measureColdSamples, \"warm\": measureWarmSamples, \"churn\": measureChurnSamples, \"short\": measureShortSamples}}\n124\t\n125\t\tfail := func(name, format string, a ...any) {\n126\t\t\trep.Verdicts[name] = \"FAIL: \" + fmt.Sprintf(format, a...)\n127\t\t\tt.Errorf(\"%s: \"+format, append([]any{name}, a...)...)\n128\t\t}\n129\t\tpass := func(name, format string, a ...any) { rep.Verdicts[name] = \"pass: \" + fmt.Sprintf(format, a...) }\n130\t\n131\t\t// S1: cold, standalone, a new process each time.\n132\t\tvar coldOut string\n133\t\tfor i := 0; i < measureColdSamples; i++ {\n134\t\t\to, ms, _ := run(\"review-check\", spec)\n135\t\t\tif i == 0 {\n136\t\t\t\tcoldOut = o\n137\t\t\t}\n138\t\t\trep.Scenarios[\"cold_standalone\"] = append(rep.Scenarios[\"cold_standalone\"], ms)\n139\t\t\tif o != coldOut {\n140\t\t\t\tt.Fatalf(\"standalone output changed between samples %d and 0\", i)\n141\t\t\t}\n142\t\t}\n143\t\tcold := measureMedian(rep.Scenarios[\"cold_standalone\"])\n144\t\n145\t\t// S2: asking for a runtime that is not there.\n146\t\tfor i := 0; i < measureColdSamples; i++ {\n147\t\t\to, ms, via := runtimeRun(\"review-check\", spec)\n148\t\t\trep.Scenarios[\"fallback_no_runtime\"] = append(rep.Scenarios[\"fallback_no_runtime\"], ms)\n149\t\t\tif via != \"standalone\" || o != coldOut {\n150\t\t\t\tt.Fatalf(\"a run with no runtime: via %q, same output %v\", via, o == coldOut)\n151\t\t\t}\n152\t\t}\n153\t\textra := measureMedian(rep.Scenarios[\"fallback_no_runtime\"]) - cold\n154\t\trep.Figures[\"fallback_extra_ms\"] = float64(extra)\n155\t\tif extra <= thresholdFallbackExtraMS {\n156\t\t\tpass(\"T6 fallback overhead\", \"%d ms <= %d ms\", extra, thresholdFallbackExtraMS)\n157\t\t} else {\n158\t\t\tfail(\"T6 fallback overhead\", \"%d ms > %d ms\", extra, thresholdFallbackExtraMS)\n159\t\t}\n160\t\n161\t\t// S3: resident, warm. The first run is the cold one inside the runtime; it is recorded apart.\n162\t\tif o, _, _ := run(\"runtime\", \"start\"); !strings.Contains(o, \"started\") {\n163\t\t\tt.Fatalf(\"start: %s\", o)\n164\t\t}\n165\t\tdefer run(\"runtime\", \"stop\")\n166\t\tfor i := 0; i < measureWarmSamples+1; i++ {\n167\t\t\to, ms, via := runtimeRun(\"review-check\", spec)\n168\t\t\tif via != \"runtime\" || o != coldOut {\n169\t\t\t\tt.Fatalf(\"a hosted run: via %q, same output as standalone %v\", via, o == coldOut)\n170\t\t\t}\n171\t\t\tif i == 0 {\n172\t\t\t\trep.Scenarios[\"resident_first\"] = []int64{ms}\n173\t\t\t} else {\n174\t\t\t\trep.Scenarios[\"resident_warm\"] = append(rep.Scenarios[\"resident_warm\"], ms)\n175\t\t\t}\n176\t\t}\n177\t\twarm := measureMedian(rep.Scenarios[\"resident_warm\"])\n178\t\trep.Figures[\"warm_over_cold\"] = float64(warm) / float64(cold)\n179\t\tif float64(warm) <= thresholdWarmOverCold*float64(cold) {\n180\t\t\tpass(\"T1 warm over cold\", \"%d ms / %d ms = %.2f <= %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n181\t\t} else {\n182\t\t\tfail(\"T1 warm over cold\", \"%d ms / %d ms = %.2f > %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n183\t\t}\n184\t\t// Memory of the runtime after the warm runs.\n185\t\tstatus, _, _ := run(\"runtime\", \"status\", \"--json\")\n186\t\tvar st struct {\n187\t\t\tPID int `json:\"pid\"`\n188\t\t}\n189\t\t_ = json.Unmarshal([]byte(strings.SplitN(status, \"\\x00\", 2)[0]), &st)\n190\t\tif raw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(st.PID) + \"/status\"); err == nil {\n191\t\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n192\t\t\t\tif strings.HasPrefix(line, \"VmHWM:\") || strings.HasPrefix(line, \"VmRSS:\") {\n193\t\t\t\t\tf := strings.Fields(line)\n194\t\t\t\t\tkb, _ := strconv.ParseFloat(f[1], 64)\n195\t\t\t\t\trep.Figures[strings.TrimSuffix(f[0], \":\")+\"_mib\"] = kb / 1024\n196\t\t\t\t}\n197\t\t\t}\n198\t\t\tif mib := rep.Figures[\"VmHWM_mib\"]; mib <= thresholdRSSMiB {\n199\t\t\t\tpass(\"T4 runtime memory\", \"peak resident %.0f MiB <= %d MiB\", mib, thresholdRSSMiB)\n200\t\t\t} else {\n201\t\t\t\tfail(\"T4 runtime memory\", \"peak resident %.0f MiB > %d MiB\", mib, thresholdRSSMiB)\n202\t\t\t}\n203\t\t} else {\n204\t\t\trep.Verdicts[\"T4 runtime memory\"] = \"not measured: no /proc on this platform\"\n205\t\t}\n206\t\n207\t\t// S5: short queries, idle then under a heavy check.\n208\t\tshortArgs := []string{\"surface-check\", spec}\n209\t\tfor i := 0; i < measureShortSamples; i++ {\n210\t\t\t_, ms, via := runtimeRun(shortArgs...)\n211\t\t\tif via != \"runtime\" {\n212\t\t\t\tt.Fatalf(\"a short query went %s\", via)\n213\t\t\t}\n214\t\t\trep.Scenarios[\"short_idle\"] = append(rep.Scenarios[\"short_idle\"], ms)\n215\t\t}\n216\t\tvar wg sync.WaitGroup\n217\t\twg.Add(1)\n218\t\tgo func() { defer wg.Done(); runtimeRun(\"review-check\", spec) }()\n219\t\ttime.Sleep(1500 * time.Millisecond)\n220\t\tfor i := 0; i < measureShortSamples; i++ {\n221\t\t\t_, ms, via := runtimeRun(shortArgs...)\n222\t\t\tif via != \"runtime\" {\n223\t\t\t\tt.Fatalf(\"a short query under load went %s\", via)\n224\t\t\t}\n225\t\t\trep.Scenarios[\"short_under_heavy\"] = append(rep.Scenarios[\"short_under_heavy\"], ms)\n226\t\t}\n227\t\twg.Wait()\n228\t\tidle, loaded := measureP95(rep.Scenarios[\"short_idle\"]), measureP95(rep.Scenarios[\"short_under_heavy\"])\n229\t\tbound := int64(thresholdShortUnderHeavy * float64(idle))\n230\t\tif bound < thresholdShortFloorMS {\n231\t\t\tbound = thresholdShortFloorMS\n232\t\t}\n233\t\trep.Figures[\"short_p95_idle_ms\"], rep.Figures[\"short_p95_under_heavy_ms\"] = float64(idle), float64(loaded)\n234\t\tif loaded <= bound {\n235\t\t\tpass(\"T3 short under heavy\", \"p95 %d ms <= %d ms (idle p95 %d ms)\", loaded, bound, idle)\n236\t\t} else {\n237\t\t\tfail(\"T3 short under heavy\", \"p95 %d ms > %d ms (idle p95 %d ms)\", loaded, bound, idle)\n238\t\t}\n239\t\tst2, _, _ := run(\"runtime\", \"status\", \"--json\")\n240\t\tvar full struct {\n241\t\t\tMetrics map[string]int64 `json:\"metrics\"`\n242\t\t}\n243\t\t_ = json.Unmarshal([]byte(strings.SplitN(st2, \"\\x00\", 2)[0]), &full)\n244\t\trep.Metrics = full.Metrics\n245\t\n246\t\t// S4: a restart inherits nothing.\n247\t\tfor i := 0; i < measureChurnSamples; i++ {\n248\t\t\trun(\"runtime\", \"stop\")\n249\t\t\trun(\"runtime\", \"start\")\n250\t\t\to, ms, via := runtimeRun(\"review-check\", spec)\n251\t\t\tif via != \"runtime\" || o != coldOut {\n252\t\t\t\tt.Fatalf(\"a run after a restart: via %q, same output %v\", via, o == coldOut)\n253\t\t\t}\n254\t\t\trep.Scenarios[\"restart_then_run\"] = append(rep.Scenarios[\"restart_then_run\"], ms)\n255\t\t}\n256\t\tchurn := measureMedian(rep.Scenarios[\"restart_then_run\"])\n257\t\trep.Figures[\"churn_over_cold\"] = float64(churn) / float64(cold)\n258\t\tif float64(churn) >= thresholdChurnOverCold*float64(cold) {\n259\t\t\tpass(\"T2 restart inherits nothing\", \"%d ms / %d ms = %.2f >= %.2f\", churn, cold, float64(churn)/float64(cold), thresholdChurnOverCold)\n260\t\t} else {\n261\t\t\tfail(\"T2 restart inherits nothing\", \"%d ms / %d ms = %.2f < %.2f\", churn, cold, float64(churn)/float64(cold), thresholdChurnOverCold)\n262\t\t}\n263\t\tpass(\"T5 output\", \"every hosted run printed exactly what the standalone run printed (%d bytes)\", len(coldOut))\n264\t\n265\t\traw, _ := json.MarshalIndent(rep, \"\", \"  \")\n266\t\tif err := os.WriteFile(out, append(raw, '\\n'), 0o644); err != nil {\n267\t\t\tt.Fatal(err)\n268\t\t}\n269\t}\n270\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"75fbed12-4317-4617-82f0-03722c014c5b","timestamp":"2026-11-10T08:50:07.974Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2313386238/worktree/pose-mcp/internal/cli/runtime_measure_test.go","content":"package cli\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\n// Spec pose-worktree-runtime-qos-and-measurement R8.\n//\n// The measurement of the optional runtime on a real repository. It runs only when\n// POSE_RUNTIME_MEASURE names the output file, because it takes minutes and measures the\n// repository it runs in. The samples, scenarios and thresholds below are fixed here and in the\n// spec before any number is read; the test fails when a threshold is not met, and writes the\n// figures either way.\nconst (\n\tmeasureColdSamples  = 3\n\tmeasureWarmSamples  = 5\n\tmeasureChurnSamples = 3\n\tmeasureShortSamples = 10\n\t// Thresholds (fixed before the first run).\n\tthresholdWarmOverCold    = 0.60 // median warm run <= 0.6 x median cold run\n\tthresholdChurnOverCold   = 0.80 // a restarted runtime inherits nothing: median >= 0.8 x cold\n\tthresholdShortUnderHeavy = 3.0  // p95 of a short query under heavy load <= 3 x idle p95 ...\n\tthresholdShortFloorMS    = 250  // ... or 250 ms, whichever is more\n\tthresholdRSSMiB          = 1536 // resident set of the runtime after the warm runs\n\tthresholdFallbackExtraMS = 500  // trying a runtime that is not there costs at most this\n)\n\ntype measureReport struct {\n\tEnvironment map[string]any     `json:\"environment\"`\n\tScenarios   map[string][]int64 `json:\"scenarios_ms\"`\n\tFigures     map[string]float64 `json:\"figures\"`\n\tMetrics     map[string]int64   `json:\"runtime_metrics\"`\n\tVerdicts    map[string]string  `json:\"verdicts\"`\n}\n\nfunc measureMedian(v []int64) int64 {\n\ts := append([]int64(nil), v...)\n\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n\treturn s[len(s)/2]\n}\n\nfunc measureP95(v []int64) int64 {\n\ts := append([]int64(nil), v...)\n\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n\ti := (len(s)*95 + 99) / 100\n\tif i >= len(s) {\n\t\ti = len(s) - 1\n\t}\n\treturn s[i]\n}\n\nfunc TestMeasureTheRuntimeOnTheRealRepository(t *testing.T) {\n\tout := os.Getenv(\"POSE_RUNTIME_MEASURE\")\n\tif out == \"\" {\n\t\tt.Skip(\"set POSE_RUNTIME_MEASURE=<output file> to measure the runtime on this repository\")\n\t}\n\trepo, err := filepath.Abs(\"../../..\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tspec := os.Getenv(\"POSE_RUNTIME_MEASURE_SPEC\")\n\tif spec == \"\" {\n\t\tspec = \"spec:pose-governance-audit-skips-pure-git-reads\"\n\t}\n\tbin := filepath.Join(t.TempDir(), \"pose\")\n\tif b, err := exec.Command(\"go\", \"build\", \"-o\", bin, \"../../cmd/pose\").CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"build: %v %s\", err, b)\n\t}\n\trtDir, _ := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rtm\")\n\tdefer os.RemoveAll(rtDir)\n\tenv := append(os.Environ(), \"POSE_RUNTIME_DIR=\"+rtDir+\"/r\")\n\tfor _, drop := range []string{\"POSE_PROJECT_ROOT\", \"POSE_PROJECT_ROOTS\", \"POSE_DEFAULT_PROJECT_ID\", \"CLAUDECODE\"} {\n\t\tenv = append(env, drop+\"=\")\n\t}\n\trun := func(args ...string) (string, int64, int) {\n\t\tcmd := exec.Command(bin, args...)\n\t\tcmd.Dir, cmd.Env = repo, env\n\t\tvar o, e bytes.Buffer\n\t\tcmd.Stdout, cmd.Stderr = &o, &e\n\t\tstart := time.Now()\n\t\terr := cmd.Run()\n\t\tcode := 0\n\t\tif ee, ok := err.(*exec.ExitError); ok {\n\t\t\tcode = ee.ExitCode()\n\t\t}\n\t\treturn o.String() + \"\\x00\" + e.String(), time.Since(start).Milliseconds(), code\n\t}\n\truntimeRun := func(args ...string) (stdout string, ms int64, via string) {\n\t\to, ms, _ := run(append([]string{\"runtime\", \"run\", \"--envelope\"}, args...)...)\n\t\tvar doc struct {\n\t\t\tVia, Stdout, Stderr string\n\t\t}\n\t\tdoc.Via = \"\"\n\t\tvar raw map[string]any\n\t\tif err := json.Unmarshal([]byte(strings.SplitN(o, \"\\x00\", 2)[0]), &raw); err != nil {\n\t\t\tt.Fatalf(\"not an envelope: %q\", o)\n\t\t}\n\t\tvia, _ = raw[\"via\"].(string)\n\t\tso, _ := raw[\"stdout\"].(string)\n\t\tse, _ := raw[\"stderr\"].(string)\n\t\treturn so + \"\\x00\" + se, ms, via\n\t}\n\trep := measureReport{Scenarios: map[string][]int64{}, Figures: map[string]float64{}, Verdicts: map[string]string{}}\n\thead, _ := exec.Command(\"git\", \"-C\", repo, \"rev-parse\", \"HEAD\").Output()\n\tcommits, _ := exec.Command(\"git\", \"-C\", repo, \"rev-list\", \"--count\", \"HEAD\").Output()\n\tgitv, _ := exec.Command(\"git\", \"--version\").Output()\n\tkernel, _ := os.ReadFile(\"/proc/sys/kernel/osrelease\")\n\trep.Environment = map[string]any{\"cpus\": runtime.NumCPU(), \"gomaxprocs\": runtime.GOMAXPROCS(0), \"goos\": runtime.GOOS, \"goarch\": runtime.GOARCH,\n\t\t\"go\": runtime.Version(), \"git\": strings.TrimSpace(string(gitv)), \"kernel\": strings.TrimSpace(string(kernel)), \"repo_head\": strings.TrimSpace(string(head)),\n\t\t\"repo_commits\": strings.TrimSpace(string(commits)), \"check\": \"review-check \" + spec, \"short_query\": \"surface-check \" + spec,\n\t\t\"samples\": map[string]int{\"cold\": measureColdSamples, \"warm\": measureWarmSamples, \"churn\": measureChurnSamples, \"short\": measureShortSamples}}\n\n\tfail := func(name, format string, a ...any) {\n\t\trep.Verdicts[name] = \"FAIL: \" + fmt.Sprintf(format, a...)\n\t\tt.Errorf(\"%s: \"+format, append([]any{name}, a...)...)\n\t}\n\tpass := func(name, format string, a ...any) { rep.Verdicts[name] = \"pass: \" + fmt.Sprintf(format, a...) }\n\n\t// S1: cold, standalone, a new process each time.\n\tvar coldOut string\n\tfor i := 0; i < measureColdSamples; i++ {\n\t\to, ms, _ := run(\"review-check\", spec)\n\t\tif i == 0 {\n\t\t\tcoldOut = o\n\t\t}\n\t\trep.Scenarios[\"cold_standalone\"] = append(rep.Scenarios[\"cold_standalone\"], ms)\n\t\tif o != coldOut {\n\t\t\tt.Fatalf(\"standalone output changed between samples %d and 0\", i)\n\t\t}\n\t}\n\tcold := measureMedian(rep.Scenarios[\"cold_standalone\"])\n\n\t// S2: asking for a runtime that is not there.\n\tfor i := 0; i < measureColdSamples; i++ {\n\t\to, ms, via := runtimeRun(\"review-check\", spec)\n\t\trep.Scenarios[\"fallback_no_runtime\"] = append(rep.Scenarios[\"fallback_no_runtime\"], ms)\n\t\tif via != \"standalone\" || o != coldOut {\n\t\t\tt.Fatalf(\"a run with no runtime: via %q, same output %v\", via, o == coldOut)\n\t\t}\n\t}\n\textra := measureMedian(rep.Scenarios[\"fallback_no_runtime\"]) - cold\n\trep.Figures[\"fallback_extra_ms\"] = float64(extra)\n\tif extra <= thresholdFallbackExtraMS {\n\t\tpass(\"T6 fallback overhead\", \"%d ms <= %d ms\", extra, thresholdFallbackExtraMS)\n\t} else {\n\t\tfail(\"T6 fallback overhead\", \"%d ms > %d ms\", extra, thresholdFallbackExtraMS)\n\t}\n\n\t// S3: resident, warm. The first run is the cold one inside the runtime; it is recorded apart.\n\tif o, _, _ := run(\"runtime\", \"start\"); !strings.Contains(o, \"started\") {\n\t\tt.Fatalf(\"start: %s\", o)\n\t}\n\tdefer run(\"runtime\", \"stop\")\n\tfor i := 0; i < measureWarmSamples+1; i++ {\n\t\to, ms, via := runtimeRun(\"review-check\", spec)\n\t\tif via != \"runtime\" || o != coldOut {\n\t\t\tt.Fatalf(\"a hosted run: via %q, same output as standalone %v\", via, o == coldOut)\n\t\t}\n\t\tif i == 0 {\n\t\t\trep.Scenarios[\"resident_first\"] = []int64{ms}\n\t\t} else {\n\t\t\trep.Scenarios[\"resident_warm\"] = append(rep.Scenarios[\"resident_warm\"], ms)\n\t\t}\n\t}\n\twarm := measureMedian(rep.Scenarios[\"resident_warm\"])\n\trep.Figures[\"warm_over_cold\"] = float64(warm) / float64(cold)\n\tif float64(warm) <= thresholdWarmOverCold*float64(cold) {\n\t\tpass(\"T1 warm over cold\", \"%d ms / %d ms = %.2f <= %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n\t} else {\n\t\tfail(\"T1 warm over cold\", \"%d ms / %d ms = %.2f > %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n\t}\n\t// Memory of the runtime after the warm runs.\n\tstatus, _, _ := run(\"runtime\", \"status\", \"--json\")\n\tvar st struct {\n\t\tPID int `json:\"pid\"`\n\t}\n\t_ = json.Unmarshal([]byte(strings.SplitN(status, \"\\x00\", 2)[0]), &st)\n\tif raw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(st.PID) + \"/status\"); err == nil {\n\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n\t\t\tif strings.HasPrefix(line, \"VmHWM:\") || strings.HasPrefix(line, \"VmRSS:\") {\n\t\t\t\tf := strings.Fields(line)\n\t\t\t\tkb, _ := strconv.ParseFloat(f[1], 64)\n\t\t\t\trep.Figures[strings.TrimSuffix(f[0], \":\")+\"_mib\"] = kb / 1024\n\t\t\t}\n\t\t}\n\t\tif mib := rep.Figures[\"VmHWM_mib\"]; mib <= thresholdRSSMiB {\n\t\t\tpass(\"T4 runtime memory\", \"peak resident %.0f MiB <= %d MiB\", mib, thresholdRSSMiB)\n\t\t} else {\n\t\t\tfail(\"T4 runtime memory\", \"peak resident %.0f MiB > %d MiB\", mib, thresholdRSSMiB)\n\t\t}\n\t} else {\n\t\trep.Verdicts[\"T4 runtime memory\"] = \"not measured: no /proc on this platform\"\n\t}\n\n\t// S5: short queries, idle then under a heavy check.\n\tshortArgs := []string{\"surface-check\", spec}\n\tfor i := 0; i < measureShortSamples; i++ {\n\t\t_, ms, via := runtimeRun(shortArgs...)\n\t\tif via != \"runtime\" {\n\t\t\tt.Fatalf(\"a short query went %s\", via)\n\t\t}\n\t\trep.Scenarios[\"short_idle\"] = append(rep.Scenarios[\"short_idle\"], ms)\n\t}\n\tvar wg sync.WaitGroup\n\twg.Add(1)\n\tgo func() { defer wg.Done(); runtimeRun(\"review-check\", spec) }()\n\ttime.Sleep(1500 * time.Millisecond)\n\tfor i := 0; i < measureShortSamples; i++ {\n\t\t_, ms, via := runtimeRun(shortArgs...)\n\t\tif via != \"runtime\" {\n\t\t\tt.Fatalf(\"a short query under load went %s\", via)\n\t\t}\n\t\trep.Scenarios[\"short_under_heavy\"] = append(rep.Scenarios[\"short_under_heavy\"], ms)\n\t}\n\twg.Wait()\n\tidle, loaded := measureP95(rep.Scenarios[\"short_idle\"]), measureP95(rep.Scenarios[\"short_under_heavy\"])\n\tbound := int64(thresholdShortUnderHeavy * float64(idle))\n\tif bound < thresholdShortFloorMS {\n\t\tbound = thresholdShortFloorMS\n\t}\n\trep.Figures[\"short_p95_idle_ms\"], rep.Figures[\"short_p95_under_heavy_ms\"] = float64(idle), float64(loaded)\n\tif loaded <= bound {\n\t\tpass(\"T3 short under heavy\", \"p95 %d ms <= %d ms (idle p95 %d ms)\", loaded, bound, idle)\n\t} else {\n\t\tfail(\"T3 short under heavy\", \"p95 %d ms > %d ms (idle p95 %d ms)\", loaded, bound, idle)\n\t}\n\tst2, _, _ := run(\"runtime\", \"status\", \"--json\")\n\tvar full struct {\n\t\tMetrics map[string]int64 `json:\"metrics\"`\n\t}\n\t_ = json.Unmarshal([]byte(strings.SplitN(st2, \"\\x00\", 2)[0]), &full)\n\trep.Metrics = full.Metrics\n\n\t// S4: a restart inherits nothing.\n\tfor i := 0; i < measureChurnSamples; i++ {\n\t\trun(\"runtime\", \"stop\")\n\t\trun(\"runtime\", \"start\")\n\t\to, ms, via := runtimeRun(\"review-check\", spec)\n\t\tif via != \"runtime\" || o != coldOut {\n\t\t\tt.Fatalf(\"a run after a restart: via %q, same output %v\", via, o == coldOut)\n\t\t}\n\t\trep.Scenarios[\"restart_then_run\"] = append(rep.Scenarios[\"restart_then_run\"], ms)\n\t}\n\tchurn := measureMedian(rep.Scenarios[\"restart_then_run\"])\n\trep.Figures[\"churn_over_cold\"] = float64(churn) / float64(cold)\n\tif float64(churn) >= thresholdChurnOverCold*float64(cold) {\n\t\tpass(\"T2 restart inherits nothing\", \"%d ms / %d ms = %.2f >= %.2f\", churn, cold, float64(churn)/float64(cold), thresholdChurnOverCold)\n\t} else {\n\t\tfail(\"T2 restart inherits nothing\", \"%d ms / %d ms = %.2f < %.2f\", churn, cold, float64(churn)/float64(cold), thresholdChurnOverCold)\n\t}\n\tpass(\"T5 output\", \"every hosted run printed exactly what the standalone run printed (%d bytes)\", len(coldOut))\n\n\traw, _ := json.MarshalIndent(rep, \"\", \"  \")\n\tif err := os.WriteFile(out, append(raw, '\\n'), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n","numLines":270,"startLine":1,"totalLines":270}},"tool_result_meta":[{"id":"toolu_01XvShk72JN2Zm65SGMVKt5H","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
