{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CtGGLyS9MHN6NVkp6q9aih","type":"tool_result","content":"650\t\n651\t// planReviewThread decides the session of a review round after the first:\n652\t// with continue-thread it resumes the session the previous round ended with,\n653\t// unless the agent's vendor or the agent changed, a draft of the chain cannot\n654\t// be read, that session cannot be resumed, or the scope reached the round\n655\t// threshold; each opens a new session, recording why (R6, D1, D5).\n656\tfunc (s Store) planReviewThread(plan *DispatchPlan) error {\n657\t\tround, err := s.ReviewRoundOf(plan.Bundle)\n658\t\tif err != nil {\n659\t\t\treturn err\n660\t\t}\n661\t\tplan.round = round.Number\n662\t\tif round.Number < 2 || round.Prior == nil {\n663\t\t\treturn nil\n664\t\t}\n665\t\tpolicy, _, _, err := s.LoadDelegationPolicy()\n666\t\tif err != nil {\n667\t\t\treturn err\n668\t\t}\n669\t\truns, _, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n670\t\tif err != nil {\n671\t\t\treturn err\n672\t\t}\n673\t\tprior := round.Prior\n674\t\tthread := &ReviewThread{Round: round.Number, Mode: ReviewThreadNew, From: prior.RunID}\n675\t\tthreshold := policy.Routing.RoundThresholdOf()\n676\t\tfailed := FailedContinuation(runs, plan.Bundle.BundleID)\n677\t\tsession := \"\"\n678\t\tswitch {\n679\t\tcase policy.Routing.RoundsMode() == ReviewRoundsColdSession:\n680\t\t\tthread.Reason = \"routing.rounds is cold-session\"\n681\t\tcase round.Broken != \"\":\n682\t\t\tthread.Reason = \"the chain of rounds is broken: \" + round.Broken\n683\t\tcase !strings.EqualFold(prior.Vendor, plan.Config.Vendor):\n684\t\t\tthread.Reason = \"the agent's vendor changed from \" + prior.Vendor + \" to \" + plan.Config.Vendor\n685\t\tcase prior.Adapter != plan.Adapter:\n686\t\t\tthread.Reason = \"the agent changed from \" + prior.Adapter + \" to \" + plan.Adapter\n687\t\tcase round.Number >= threshold:\n688\t\t\tthread.Reason = fmt.Sprintf(\"round %d reached the round threshold %d\", round.Number, threshold)\n689\t\tcase prior.SessionDigest == \"\" || plan.Config.Resume == nil || len(plan.Config.Resume.Command) == 0:\n690\t\t\tthread.Reason = \"the previous round's session cannot be resumed: it recorded no session or the agent declares no resume\"\n691\t\tcase failed != nil:\n692\t\t\tthread.Reason = FailedContinuationReason(failed)\n693\t\tdefault:\n694\t\t\tvalue, rerr := s.readReviewSession(prior.SessionDigest)\n695\t\t\tif rerr != nil {\n696\t\t\t\tthread.Reason = \"the previous round's session cannot be resumed: \" + rerr.Error()\n697\t\t\t\tbreak\n698\t\t\t}\n699\t\t\tthread.Mode, session = ReviewThreadContinued, value\n700\t\t}\n701\t\tplan.thread, plan.session = thread, session\n702\t\treturn nil\n703\t}\n704\t\n705\t// FailedContinuation is a run of the bundle that failed while continuing a\n706\t// session: nothing says why in terms common to every vendor, and resuming what\n707\t// just failed is not worth an attempt (spec\n708\t// pose-delegated-review-expired-session R1, D1).\n709\tfunc FailedContinuation(runs []ReviewRun, bundleID string) *ReviewRun {\n710\t\tfor i := range runs {\n711\t\t\tif runs[i].BundleID == bundleID && runs[i].Status == ReviewRunFailed && runs[i].Thread.continued() {\n712\t\t\t\treturn &runs[i]\n713\t\t\t}\n714\t\t}\n715\t\treturn nil\n716\t}\n717\t\n718\tfunc FailedContinuationReason(run *ReviewRun) string {\n719\t\treason := \"the session could not be continued: run \" + run.RunID + \" failed\"\n720\t\tif failure := []rune(run.Failure); len(failure) > 200 {\n721\t\t\treturn reason + \": \" + string(failure[:200]) + \"…\"\n722\t\t} else if len(failure) > 0 {\n723\t\t\treturn reason + \": \" + string(failure)\n724\t\t}\n725\t\treturn reason\n726\t}\n727\t\n728\t// continuationRound carries the round of a run's predecessor to its\n729\t// continuation: a resume keeps the predecessor's thread, a handoff records a\n730\t// new session because another agent runs (review round 1, B11).\n731\tfunc continuationRound(plan *DispatchPlan, prior ReviewRun, handoff bool) {\n732\t\tplan.round, plan.thread = prior.Round, prior.Thread\n733\t\tif handoff && prior.Round >= 2 {\n734\t\t\tplan.thread = &ReviewThread{Round: prior.Round, Mode: ReviewThreadNew, From: prior.RunID, Reason: \"the run was handed off to agent \" + plan.Adapter}\n735\t\t}\n736\t}\n737\t\n738\t// ReviewRoundMetric is the convergence of one scope's rounds (R7, R10).\n739\ttype ReviewRoundMetric struct {\n740\t\tScope            string                 `json:\"scope\"`\n741\t\tRounds           int                    `json:\"rounds\"`\n742\t\tFindingsPerRound []int                  `json:\"findings_per_round\"`\n743\t\tInvalidRounds    int                    `json:\"invalid_rounds\"`\n744\t\tRoundsToApproval *int                   `json:\"rounds_to_approval\"`\n745\t\tContinued        ReviewRoundConvergence `json:\"continued\"`\n746\t\tCold             ReviewRoundConvergence `json:\"cold\"`\n747\t}\n748\t\n749\t// ReviewRoundConvergence is the R7 figures of the rounds after the first of\n750\t// one kind: those whose session continued the previous round's, or cold ones\n751\t// (R10). Shares are of the prior findings accounted for in valid drafts.\n752\ttype ReviewRoundConvergence struct {\n753\t\t// Trajectory is the findings each round of this kind reported, and\n754\t\t// RoundsToApproval the round of this kind whose valid draft first\n755\t\t// approved, if one did (R7 per kind, R10; review round 2, R2-B4).\n756\t\tTrajectory       []ReviewRoundPoint `json:\"trajectory\"`\n757\t\tRoundsToApproval *int               `json:\"rounds_to_approval\"`\n758\t\tRounds           int                `json:\"rounds\"`\n759\t\tInvalidRounds    int                `json:\"invalid_rounds\"`"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"c2d9b92d-978f-43ad-acd1-f8ac6bfbfad6","timestamp":"2026-11-26T11:38:24.408Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-874c23d9d3/worktree/pose-mcp/internal/pose/review_rounds.go","content":"\n// planReviewThread decides the session of a review round after the first:\n// with continue-thread it resumes the session the previous round ended with,\n// unless the agent's vendor or the agent changed, a draft of the chain cannot\n// be read, that session cannot be resumed, or the scope reached the round\n// threshold; each opens a new session, recording why (R6, D1, D5).\nfunc (s Store) planReviewThread(plan *DispatchPlan) error {\n\tround, err := s.ReviewRoundOf(plan.Bundle)\n\tif err != nil {\n\t\treturn err\n\t}\n\tplan.round = round.Number\n\tif round.Number < 2 || round.Prior == nil {\n\t\treturn nil\n\t}\n\tpolicy, _, _, err := s.LoadDelegationPolicy()\n\tif err != nil {\n\t\treturn err\n\t}\n\truns, _, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n\tif err != nil {\n\t\treturn err\n\t}\n\tprior := round.Prior\n\tthread := &ReviewThread{Round: round.Number, Mode: ReviewThreadNew, From: prior.RunID}\n\tthreshold := policy.Routing.RoundThresholdOf()\n\tfailed := FailedContinuation(runs, plan.Bundle.BundleID)\n\tsession := \"\"\n\tswitch {\n\tcase policy.Routing.RoundsMode() == ReviewRoundsColdSession:\n\t\tthread.Reason = \"routing.rounds is cold-session\"\n\tcase round.Broken != \"\":\n\t\tthread.Reason = \"the chain of rounds is broken: \" + round.Broken\n\tcase !strings.EqualFold(prior.Vendor, plan.Config.Vendor):\n\t\tthread.Reason = \"the agent's vendor changed from \" + prior.Vendor + \" to \" + plan.Config.Vendor\n\tcase prior.Adapter != plan.Adapter:\n\t\tthread.Reason = \"the agent changed from \" + prior.Adapter + \" to \" + plan.Adapter\n\tcase round.Number >= threshold:\n\t\tthread.Reason = fmt.Sprintf(\"round %d reached the round threshold %d\", round.Number, threshold)\n\tcase prior.SessionDigest == \"\" || plan.Config.Resume == nil || len(plan.Config.Resume.Command) == 0:\n\t\tthread.Reason = \"the previous round's session cannot be resumed: it recorded no session or the agent declares no resume\"\n\tcase failed != nil:\n\t\tthread.Reason = FailedContinuationReason(failed)\n\tdefault:\n\t\tvalue, rerr := s.readReviewSession(prior.SessionDigest)\n\t\tif rerr != nil {\n\t\t\tthread.Reason = \"the previous round's session cannot be resumed: \" + rerr.Error()\n\t\t\tbreak\n\t\t}\n\t\tthread.Mode, session = ReviewThreadContinued, value\n\t}\n\tplan.thread, plan.session = thread, session\n\treturn nil\n}\n\n// FailedContinuation is a run of the bundle that failed while continuing a\n// session: nothing says why in terms common to every vendor, and resuming what\n// just failed is not worth an attempt (spec\n// pose-delegated-review-expired-session R1, D1).\nfunc FailedContinuation(runs []ReviewRun, bundleID string) *ReviewRun {\n\tfor i := range runs {\n\t\tif runs[i].BundleID == bundleID && runs[i].Status == ReviewRunFailed && runs[i].Thread.continued() {\n\t\t\treturn &runs[i]\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc FailedContinuationReason(run *ReviewRun) string {\n\treason := \"the session could not be continued: run \" + run.RunID + \" failed\"\n\tif failure := []rune(run.Failure); len(failure) > 200 {\n\t\treturn reason + \": \" + string(failure[:200]) + \"…\"\n\t} else if len(failure) > 0 {\n\t\treturn reason + \": \" + string(failure)\n\t}\n\treturn reason\n}\n\n// continuationRound carries the round of a run's predecessor to its\n// continuation: a resume keeps the predecessor's thread, a handoff records a\n// new session because another agent runs (review round 1, B11).\nfunc continuationRound(plan *DispatchPlan, prior ReviewRun, handoff bool) {\n\tplan.round, plan.thread = prior.Round, prior.Thread\n\tif handoff && prior.Round >= 2 {\n\t\tplan.thread = &ReviewThread{Round: prior.Round, Mode: ReviewThreadNew, From: prior.RunID, Reason: \"the run was handed off to agent \" + plan.Adapter}\n\t}\n}\n\n// ReviewRoundMetric is the convergence of one scope's rounds (R7, R10).\ntype ReviewRoundMetric struct {\n\tScope            string                 `json:\"scope\"`\n\tRounds           int                    `json:\"rounds\"`\n\tFindingsPerRound []int                  `json:\"findings_per_round\"`\n\tInvalidRounds    int                    `json:\"invalid_rounds\"`\n\tRoundsToApproval *int                   `json:\"rounds_to_approval\"`\n\tContinued        ReviewRoundConvergence `json:\"continued\"`\n\tCold             ReviewRoundConvergence `json:\"cold\"`\n}\n\n// ReviewRoundConvergence is the R7 figures of the rounds after the first of\n// one kind: those whose session continued the previous round's, or cold ones\n// (R10). Shares are of the prior findings accounted for in valid drafts.\ntype ReviewRoundConvergence struct {\n\t// Trajectory is the findings each round of this kind reported, and\n\t// RoundsToApproval the round of this kind whose valid draft first\n\t// approved, if one did (R7 per kind, R10; review round 2, R2-B4).\n\tTrajectory       []ReviewRoundPoint `json:\"trajectory\"`\n\tRoundsToApproval *int               `json:\"rounds_to_approval\"`\n\tRounds           int                `json:\"rounds\"`\n\tInvalidRounds    int                `json:\"invalid_rounds\"`","numLines":110,"startLine":650,"totalLines":895}},"tool_result_meta":[{"id":"toolu_01CtGGLyS9MHN6NVkp6q9aih","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
