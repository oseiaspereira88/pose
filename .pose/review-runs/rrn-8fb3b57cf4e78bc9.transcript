{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B3ddufWk4cky4FYRLxgenP","type":"tool_result","content":"diff --git a/pose-mcp/internal/cli/review_run_continuity_test.go b/pose-mcp/internal/cli/review_run_continuity_test.go\nindex 306ad67d..414ace8f 100644\n--- a/pose-mcp/internal/cli/review_run_continuity_test.go\n+++ b/pose-mcp/internal/cli/review_run_continuity_test.go\n@@ -292,3 +292,44 @@ func TestRunContinuityObservedProcessLoss(t *testing.T) {\n \t\tt.Fatal(e)\n \t}\n }\n+\n+// Spec pose-review-resume-keeps-the-sealed-checkout R1, R2: a resumed session\n+// works in the sealed checkout it saw before the interruption, recreated at\n+// the same path after the interrupted run removed it.\n+func TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath(t *testing.T) {\n+\tmarks := t.TempDir()\n+\tfirst := filepath.Join(marks, \"first\")\n+\troot, _, prior := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n+\t\ta.Command = []string{\"sh\", \"-c\", `pwd > \"$1\"; printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\ndecision: rejected\\n'; exit 75`, \"sh\", first}\n+\t\ta.Resume.Command = []string{\"sh\", \"-c\", `test \"$(pwd)\" = \"$(cat \"$1\")\" || { echo \"moved from $(cat \"$1\") to $(pwd)\" >&2; exit 3; }; test -f .pose/specs/alpha/spec.md || exit 4; printf 'decision: approved\\n'`, \"sh\", first, \"{session}\"}\n+\t})\n+\traw, err := os.ReadFile(first)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tcheckout := strings.TrimSpace(string(raw))\n+\tif _, err := os.Stat(checkout); !os.IsNotExist(err) {\n+\t\tt.Fatalf(\"the interrupted run left its checkout %s behind: %v\", checkout, err)\n+\t}\n+\t// Review round 1, N1: a leftover runtime directory refuses the resume\n+\t// before it is claimed, so removing it restores the resume.\n+\truntimeDir := filepath.Dir(checkout)\n+\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID); code == 0 || !strings.Contains(out, \"still exists\") {\n+\t\tt.Fatalf(\"a resume beside a leftover runtime directory: %d %s\", code, out)\n+\t}\n+\t// Review round 2, N6: a handoff is refused the same way, before it\n+\t// claims the interrupted run.\n+\tif _, err := (posemodel.Store{Root: root}).PlanReviewHandoff(prior.RunID, \"other\"); err == nil || !strings.Contains(err.Error(), \"still exists\") || !strings.Contains(err.Error(), \"then hand off again\") {\n+\t\tt.Fatalf(\"a handoff beside a leftover runtime directory: %v\", err)\n+\t}\n+\tif err := os.Remove(runtimeDir); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tcode, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID)\n+\tif code != 0 || !strings.Contains(out, \"status=completed\") {\n+\t\tt.Fatalf(\"the resumed session did not find its checkout at %s: %d %s\", checkout, code, out)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/delegation_handoff.go b/pose-mcp/internal/pose/delegation_handoff.go\nindex e5ed504a..c5b6278b 100644\n--- a/pose-mcp/internal/pose/delegation_handoff.go\n+++ b/pose-mcp/internal/pose/delegation_handoff.go\n@@ -342,6 +342,11 @@ func (s Store) PlanReviewHandoff(id, agent string) (DispatchPlan, error) {\n \t\tplan.Existing = existing\n \t\treturn plan, nil\n \t}\n+\t// A handoff runs in the attempt's runtime directory too (spec\n+\t// pose-review-resume-keeps-the-sealed-checkout, review round 2, N6).\n+\tif e = reviewRunRuntimeDirFree(prior.AttemptID, \"hand off\"); e != nil {\n+\t\treturn DispatchPlan{}, e\n+\t}\n \tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\n \tif e != nil {\n \t\treturn DispatchPlan{}, e\ndiff --git a/pose-mcp/internal/pose/review_dispatch.go b/pose-mcp/internal/pose/review_dispatch.go\nindex 34f53c9d..ec60960f 100644\n--- a/pose-mcp/internal/pose/review_dispatch.go\n+++ b/pose-mcp/internal/pose/review_dispatch.go\n@@ -19,10 +19,12 @@ import (\n \t\"errors\"\n \t\"fmt\"\n \t\"io\"\n+\t\"io/fs\"\n \t\"os\"\n \t\"os/exec\"\n \t\"path/filepath\"\n \t\"reflect\"\n+\t\"regexp\"\n \t\"runtime\"\n \t\"sort\"\n \t\"strings\"\n@@ -804,17 +806,21 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n \t\t}\n \t}\n-\ttmp, err := os.MkdirTemp(\"\", \"pose-review-run-*\")\n+\ttmp, err := reviewRunRuntimeDir(run.AttemptID)\n \tif err != nil {\n-\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n+\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed: \"+err.Error())\n \t}\n \tsafety.RuntimeID = filepath.Base(tmp)\n \towned, err := os.Lstat(tmp)\n \tif err != nil {\n+\t\t// Nothing is in it yet: removing it keeps the attempt's path free\n+\t\t// for its next run (review round 1, N4).\n+\t\t_ = os.Remove(tmp)\n \t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n \t}\n \truntimeRoot, err := os.OpenRoot(tmp)\n \tif err != nil {\n+\t\t_ = os.Remove(tmp)\n \t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n \t}\n \tdefer runtimeRoot.Close()\n@@ -2028,3 +2034,65 @@ func sourceMaterializationDiffers(root, commit string, entries []ReviewBundleSub\n \t}\n \treturn \"\"\n }\n+\n+// reviewRunRuntimeHex is how many hex digits of the attempt id name its\n+// runtime directory: no more than the longest random suffix of\n+// os.MkdirTemp, a uint32 in decimal (ten digits).\n+const reviewRunRuntimeHex = 10\n+\n+// reviewAttemptIDRE is the form of a delegated review attempt's id.\n+var reviewAttemptIDRE = regexp.MustCompile(`^rat-[0-9a-f]{64}$`)\n+\n+// reviewRunRuntimeDir creates the private directory of one run. Every run of\n+// an attempt uses the same path, so a resumed reviewer session, which still\n+// refers to the sealed checkout it worked in, finds the checkout recreated\n+// there after the interrupted run removed it (spec\n+// pose-review-resume-keeps-the-sealed-checkout R1). The directory is created\n+// exclusively and never followed: when the path already exists, from an\n+// unfinished cleanup or from someone else, the run fails instead of sharing\n+// it. A run without an attempt keeps a random name.\n+func reviewRunRuntimeDir(attemptID string) (string, error) {\n+\tdir, ok := reviewRunRuntimeDirPath(attemptID)\n+\tif !ok {\n+\t\treturn os.MkdirTemp(\"\", \"pose-review-run-*\")\n+\t}\n+\tif err := os.Mkdir(dir, 0o700); err != nil {\n+\t\tif errors.Is(err, fs.ErrExist) {\n+\t\t\treturn \"\", fmt.Errorf(\"the attempt's runtime directory %s already exists; an earlier run of the attempt did not clean up, or another process holds the path; when no run of the attempt is live, remove it, then run again\", dir)\n+\t\t}\n+\t\treturn \"\", err\n+\t}\n+\treturn dir, nil\n+}\n+\n+// reviewRunRuntimeDirPath is the runtime directory every run of an attempt\n+// uses, or false for a run without an attempt.\n+func reviewRunRuntimeDirPath(attemptID string) (string, bool) {\n+\tif !reviewAttemptIDRE.MatchString(attemptID) {\n+\t\treturn \"\", false\n+\t}\n+\t// The name is no longer than the longest random one it replaces: the adapter's\n+\t// TMPDIR is this directory, and a sandboxed reviewer creates Unix\n+\t// sockets under it, whose paths are bounded (about 108 bytes); the\n+\t// 32-hex name made the Claude sandbox fail to start (review rounds 1\n+\t// to 3). Ten hex digits name the attempt; a clash with another attempt\n+\t// only fails the later run, as the directory is created exclusively.\n+\treturn filepath.Join(os.TempDir(), \"pose-review-run-\"+attemptID[len(\"rat-\"):len(\"rat-\")+reviewRunRuntimeHex]), true\n+}\n+\n+// reviewRunRuntimeDirFree refuses a continuation whose runtime directory is\n+// still there, before the continuation is claimed, so removing the\n+// directory restores the resume instead of losing it to a failed run\n+// (review round 1, N1).\n+func reviewRunRuntimeDirFree(attemptID, verb string) error {\n+\tdir, ok := reviewRunRuntimeDirPath(attemptID)\n+\tif !ok {\n+\t\treturn nil\n+\t}\n+\tif _, err := os.Lstat(dir); err == nil {\n+\t\treturn fmt.Errorf(\"the attempt's runtime directory %s still exists although its last run cleaned up; another process holds the path, or a run of the attempt is starting; when none is live, remove it, then %s again\", dir, verb)\n+\t} else if !errors.Is(err, fs.ErrNotExist) {\n+\t\treturn fmt.Errorf(\"the attempt's runtime directory %s cannot be checked: %w\", dir, err)\n+\t}\n+\treturn nil\n+}\ndiff --git a/pose-mcp/internal/pose/review_run_continuity.go b/pose-mcp/internal/pose/review_run_continuity.go\nindex dfbcc596..66697c22 100644\n--- a/pose-mcp/internal/pose/review_run_continuity.go\n+++ b/pose-mcp/internal/pose/review_run_continuity.go\n@@ -426,6 +426,11 @@ func (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n \t\tplan.Existing = existing\n \t\treturn plan, nil\n \t}\n+\t// Only a continuation still to start needs the attempt's runtime\n+\t// directory free; a repeated resume returns the recorded one.\n+\tif e = reviewRunRuntimeDirFree(prior.AttemptID, \"resume\"); e != nil {\n+\t\treturn DispatchPlan{}, e\n+\t}\n \t// The attempt's budget, not this agent's: after a handoff the resumed\n \t// agent may declare another (spec pose-delegation-handoff R2).\n \tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\ndiff --git a/pose-mcp/internal/pose/review_run_runtime_dir_test.go b/pose-mcp/internal/pose/review_run_runtime_dir_test.go\nnew file mode 100644\nindex 00000000..2bea2bbc\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_run_runtime_dir_test.go\n@@ -0,0 +1,50 @@\n+package pose\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-review-resume-keeps-the-sealed-checkout R3: the attempt's\n+// directory is created exclusively; an existing path, a link included, fails\n+// the run instead of being shared or followed.\n+func TestRunContinuityAttemptRuntimeDirectoryIsCreatedExclusively(t *testing.T) {\n+\t// os.TempDir reads TMPDIR on Unix and TMP/TEMP on Windows (review round\n+\t// 2, N10).\n+\ttmp := t.TempDir()\n+\tfor _, name := range []string{\"TMPDIR\", \"TMP\", \"TEMP\"} {\n+\t\tt.Setenv(name, tmp)\n+\t}\n+\tid := \"rat-\" + strings.Repeat(\"ab\", 32)\n+\tdir, err := reviewRunRuntimeDir(id)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t// The adapter's TMPDIR is this directory and sandboxes create Unix\n+\t// sockets under it: the name is no longer than a random one (review\n+\t// rounds 1 to 3, the reviewer's sandbox failed to start).\n+\t// os.MkdirTemp's suffix is a uint32 in decimal, at most ten digits\n+\t// (review round 4, N16).\n+\tif longest := len(\"pose-review-run-\") + 10; len(filepath.Base(dir)) > longest {\n+\t\tt.Fatalf(\"the attempt's runtime directory %s is longer than the longest random one (%d bytes)\", filepath.Base(dir), longest)\n+\t}\n+\tif _, err := reviewRunRuntimeDir(id); err == nil || !strings.Contains(err.Error(), \"already exists\") {\n+\t\tt.Fatalf(\"an existing runtime directory was shared: %v\", err)\n+\t}\n+\tif err := os.Remove(dir); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\ttarget := t.TempDir()\n+\t// Without the privilege to create a link (Windows), only the link case\n+\t// is skipped (review round 4, N20).\n+\tif err := os.Symlink(target, dir); err != nil {\n+\t\tt.Logf(\"link case skipped: %v\", err)\n+\t} else if _, err := reviewRunRuntimeDir(id); err == nil {\n+\t\tt.Fatal(\"a link at the runtime directory was followed\")\n+\t}\n+\tif again, err := reviewRunRuntimeDir(\"\"); err != nil || filepath.Dir(again) != os.TempDir() {\n+\t\tt.Fatalf(\"a run without an attempt: %s %v\", again, err)\n+\t}\n+}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"d0b66cf2-8527-417a-ae8f-5bf204d22e1e","timestamp":"2026-11-26T11:37:01.343Z","tool_use_result":{"stdout":"diff --git a/pose-mcp/internal/cli/re