\n863\t\tif err != nil {\n864\t\t\treturn finish(ReviewRunFailed, \"worktree marker unavailable\")\n865\t\t}\n866\t\townership, err = s.captureReviewCleanupOwnership(runtimeRoot, worktree, gitMarker)\n867\t\tif err != nil {\n868\t\t\treturn finish(ReviewRunFailed, \"worktree registration ownership unavailable\")\n869\t\t}\n870\t\tdefer ownership.registry.Close()\n871\t\n872\t\tsubmodules := map[string]bool{}\n873\t\tfor _, entry := range plan.Bundle.Payload.Subject.Entries {\n874\t\t\tif entry.Class == \"submodule\" {\n875\t\t\t\tsubmodules[reviewBundleEntryPath(entry)] = true\n876\t\t\t}\n877\t\t}\n878\t\tcommittedWorktreeBytes := ownership.inventoryBytes - gitSnapshotMarginBytes\n879\t\tgitlinks := reviewGitlinkSetup{\n880\t\t\tctx: setupCtx, cancel: stopSetup, hooks: hooks,\n881\t\t\tmetadata:          filepath.Join(tmp, reviewGitlinkMetadataDir),\n882\t\t\tmaxCommittedBytes: gitSnapshotCeilingBytes - committedWorktreeBytes,\n883\t\t}\n884\t\tgitlinkErr := gitlinks.materialize(s.Root, worktree, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries)\n885\t\townership.inventoryBytes = gitSnapshotBudget(committedWorktreeBytes + gitlinks.committedBytes)\n886\t\townership.gitlinkMetadata = gitlinks.metadataOwned\n887\t\townership.gitlinkMetadataBytes = gitSnapshotBudget(gitlinks.committedBytes)\n888\t\tif gitlinkErr != nil {\n889\t\t\tterminationFailed = gitlinks.terminationFailure\n890\t\t\tsafety.ExecutionCause = executionCause(setupCtx)\n891\t\t\tif gitlinks.captureOverflow {\n892\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n893\t\t\t}\n894\t\t\treturn finish(ReviewRunFailed, \"sealed gitlink setup failed: \"+gitlinkErr.Error())\n895\t\t}\n896\t\tstopSetup()\n897\t\tcheckout := s\n898\t\tcheckout.Root, checkout.indexPin = worktree, nil\n899\t\tif prepared, err := checkout.PrepareReviewBundle(plan.Brief.Scope); err != nil {\n900\t\t\treturn finish(ReviewRunFailed, \"sealed checkout inputs unavailable: \"+err.Error())\n901\t\t} else if blockers := checkou