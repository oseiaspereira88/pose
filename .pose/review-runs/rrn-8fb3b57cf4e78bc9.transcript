{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pio3hYM6H1mRB3QBMsSsi3","type":"tool_result","content":"690\t\t\tif cleanupErr != nil {\n691\t\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n692\t\t\t}\n693\t\t}()\n694\t\ttranscript := []byte{}\n695\t\tfinish := func(status, failure string) (ReviewRun, error) {\n696\t\t\tdoCleanup()\n697\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n698\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n699\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n700\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n701\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n702\t\t\t}\n703\t\t\trun.sessionForRedaction = \"\"\n704\t\t\trun.Status, run.Failure = status, failure\n705\t\t\tif status != ReviewRunInterrupted {\n706\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n707\t\t\t}\n708\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n709\t\t\treturn s.recordReviewRun(run, transcript)\n710\t\t}\n711\t\t// Recompute semantic freshness at execution time, not just preview time.\n712\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n713\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n714\t\t}\n715\t\tvar attempt DelegatedReviewAttempt\n716\t\tif plan.predecessor == nil {\n717\t\t\tvar err error\n718\t\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n719\t\t\tif err != nil {\n720\t\t\t\treturn ReviewRun{}, err\n721\t\t\t}\n722\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n723\t\t} else {\n724\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n725\t\t\tfresh, err := s.replanContinuation(plan)\n726\t\t\tif err != nil {\n727\t\t\t\treturn ReviewRun{}, err\n728\t\t\t}\n729\t\t\tif fresh.PendingContinuation != nil {\n730\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n731\t\t\t}\n732\t\t\tif fresh.Existing != nil {\n733\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n734\t\t\t}\n735\t\t\tplan = fresh\n736\t\t\trun.Provenance = fresh.provenance\n737\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n738\t\t\tif fresh.handoff {\n739\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n740\t\t\t} else {\n741\t\t\t\trun.Resumes = fresh.predecessor.RunID\n742\t\t\t}\n743\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n744\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n745\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n746\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n747\t\t\t\treturn ReviewRun{}, err\n748\t\t\t}\n749\t\t}\n750\t\t// The attempt result is published once: before the active marker goes\n751\t\t// when the run was marked, at return otherwise (spec\n752\t\t// pose-delegation-result-before-marker R1–R2).\n753\t\tresultPublished := false\n754\t\treserved := plan.predecessor != nil\n755\t\tpublishResult := func() {\n756\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n757\t\t\t\treturn\n758\t\t\t}\n759\t\t\tresultPublished = true\n760\t\t\tbeforeRunResultPublished(result)\n761\t\t\tvar err error\n762\t\t\tif plan.predecessor == nil {\n763\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n764\t\t\t} else {\n765\t\t\t\terr = s.finishReviewContinuation(result)\n766\t\t\t}\n767\t\t\tif err != nil {\n768\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n769\t\t\t}\n770\t\t}\n771\t\tdefer publishResult()\n772\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n773\t\tif err != nil {\n774\t\t\tif plan.predecessor == nil {\n775\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n776\t\t\t\t// receipt are recorded against it, as before the marker moved\n777\t\t\t\t// ahead of the reservation (spec\n778\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n779\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n780\t\t\t\t\treturn ReviewRun{}, perr\n781\t\t\t\t}\n782\t\t\t\treserved = true\n783\t\t\t}\n784\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n785\t\t}\n786\t\tif plan.predecessor == nil {\n787\t\t\tbeforeAttemptPublished(s, attempt)\n788\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n789\t\t\t\tstopActive()\n790\t\t\t\treturn ReviewRun{}, err\n791\t\t\t}\n792\t\t\treserved = true\n793\t\t}\n794\t\t// The marker goes only once the record and the attempt result are\n795\t\t// published: without them it is the one trace of the reserved attempt,\n796\t\t// and a waiter that sees it gone must find the receipt.\n797\t\tdefer func() {\n798\t\t\tpublishResult()\n799\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n800\t\t}()\n801\t\tcancelled = cancelFlag\n802\t\t// A detached run that cannot hand its attempt back stops here: nobody\n803\t\t// would know which attempt runs (R1).\n804\t\tif plan.OnStart != nil {\n805\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n806\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n807\t\t\t}\n808\t\t}\n809\t\ttmp, err := reviewRunRuntimeDir(run.AttemptID)\n810\t\tif err != nil {\n811\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed: \"+err.Error())\n812\t\t}\n813\t\tsafety.RuntimeID = filepath.Base(tmp)\n814\t\towned, err := os.Lstat(tmp)\n815\t\tif err != nil {\n816\t\t\t// Nothing is in it yet: removing it keeps the attempt's path free\n817\t\t\t// for its next run (review round 1, N4).\n818\t\t\t_ = os.Remove(tmp)\n819\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity una