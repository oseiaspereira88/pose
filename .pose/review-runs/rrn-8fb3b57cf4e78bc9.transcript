{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GWrLk3fAEj6auc38cgPoQj","type":"tool_result","content":"190\t// delegateNextActions lists what a stopped attempt can do next, each judged by\n191\t// the same read-only planning its command runs, so an action offered as\n192\t// available is one its command would start (R9); nil for an attempt that runs\n193\t// or concluded.\n194\tfunc delegateNextActions(store posemodel.Store, a posemodel.DelegationAttempt) []delegateNextAction {\n195\t\tlatest := a.Latest()\n196\t\tif a.Active || latest == nil || latest.Status == posemodel.ReviewRunCompleted || latest.Status == posemodel.ReviewRunStale {\n197\t\t\treturn nil\n198\t\t}\n199\t\tif latest.Purpose == posemodel.DelegationPurposeTask {\n200\t\t\treturn delegateTaskNextActions(store, a, *latest)\n201\t\t}\n202\t\treason := func(err error) string { return strings.TrimPrefix(err.Error(), \"pose: \") }\n203\t\tvar actions []delegateNextAction\n204\t\tif i := latest.Interruption; latest.Status == posemodel.ReviewRunInterrupted && i != nil {\n205\t\t\tresume := delegateNextAction{Action: \"resume\", Command: \"pose delegate resume \" + a.AttemptID}\n206\t\t\tplan, err := store.PlanReviewResume(latest.RunID)\n207\t\t\tswitch {\n208\t\t\tcase !i.Resumable:\n209\t\t\t\tresume.Why = tr(\"the stop is not resumable\", \"a parada não é retomável\")\n210\t\t\tcase err != nil:\n211\t\t\t\tresume.Why = reason(err)\n212\t\t\tcase plan.PendingContinuation != nil || plan.Existing != nil:\n213\t\t\t\tresume.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n214\t\t\t}\n215\t\t\tif resume.Why == \"\" {\n216\t\t\t\treset, resetErr := time.Parse(time.RFC3339Nano, i.ResetAt)\n217\t\t\t\tif i.ResetAt != \"\" && resetErr == nil && reset.After(time.Now()) {\n218\t\t\t\t\twait := delegateNextAction{Action: \"wait\", Command: \"pose delegate resume \" + a.AttemptID + \" --wait-until-reset\"}\n219\t\t\t\t\tif _, err := posemodel.ReviewResumeDelay(*latest, time.Now(), 24*time.Hour, 0); err != nil {\n220\t\t\t\t\t\twait.Why = reason(err)\n221\t\t\t\t\t} else {\n222\t\t\t\t\t\twait.Available = true\n223\t\t\t\t\t}\n224\t\t\t\t\tactions = append(actions, wait)\n225\t\t\t\t\tresume.Why = tr(\"the agent is limited until \", \"o agente está limitado até \") + i.ResetAt\n226\t\t\t\t} else {\n227\t\t\t\t\tresume.Available = true\n228\t\t\t\t}\n229\t\t\t}\n230\t\t\tactions = append(actions, resume)\n231\t\t}\n232\t\thandoff := delegateNextAction{Action: \"handoff\", Command: \"pose delegate handoff \" + a.AttemptID + \" --to auto\"}\n233\t\tif agent, _, err := routeHandoff(store, *latest); err != nil {\n234\t\t\thandoff.Why = reason(err)\n235\t\t} else if plan, err := store.PlanReviewHandoff(latest.RunID, agent); err != nil {\n236\t\t\thandoff.Why = reason(err)\n237\t\t} else if plan.PendingContinuation != nil || plan.Existing != nil {\n238\t\t\thandoff.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n239\t\t} else {\n240\t\t\thandoff.Available = true\n241\t\t}\n242\t\treturn append(actions, handoff, delegateCancelAction())\n243\t}\n244\t\n245\t// delegateRunNextActions is the ways forward of the attempt run belongs to,\n246\t// for a run that just stopped (R9).\n247\tfunc delegateRunNextActions(store posemodel.Store, run posemodel.ReviewRun, err error) []delegateNextAction {\n248\t\tif err != nil || run.AttemptID == \"\" || run.Status == posemodel.ReviewRunCompleted {\n249\t\t\treturn nil"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"1bf56d5c-f562-44d4-b86d-4969718f1c31","timestamp":"2026-11-26T11:48:44.725Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-874c23d9d3/worktree/pose-mcp/internal/cli/delegate_handoff.go","content":"// delegateNextActions lists what a stopped attempt can do next, each judged by\n// the same read-only planning its command runs, so an action offered as\n// available is one its command would start (R9); nil for an attempt that runs\n// or concluded.\nfunc delegateNextActions(store posemodel.Store, a posemodel.DelegationAttempt) []delegateNextAction {\n\tlatest := a.Latest()\n\tif a.Active || latest == nil || latest.Status == posemodel.ReviewRunCompleted || latest.Status == posemodel.ReviewRunStale {\n\t\treturn nil\n\t}\n\tif latest.Purpose == posemodel.DelegationPurposeTask {\n\t\treturn delegateTaskNextActions(store, a, *latest)\n\t}\n\treason := func(err error) string { return strings.TrimPrefix(err.Error(), \"pose: \") }\n\tvar actions []delegateNextAction\n\tif i := latest.Interruption; latest.Status == posemodel.ReviewRunInterrupted && i != nil {\n\t\tresume := delegateNextAction{Action: \"resume\", Command: \"pose delegate resume \" + a.AttemptID}\n\t\tplan, err := store.PlanReviewResume(latest.RunID)\n\t\tswitch {\n\t\tcase !i.Resumable:\n\t\t\tresume.Why = tr(\"the stop is not resumable\", \"a parada não é retomável\")\n\t\tcase err != nil:\n\t\t\tresume.Why = reason(err)\n\t\tcase plan.PendingContinuation != nil || plan.Existing != nil:\n\t\t\tresume.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n\t\t}\n\t\tif resume.Why == \"\" {\n\t\t\treset, resetErr := time.Parse(time.RFC3339Nano, i.ResetAt)\n\t\t\tif i.ResetAt != \"\" && resetErr == nil && reset.After(time.Now()) {\n\t\t\t\twait := delegateNextAction{Action: \"wait\", Command: \"pose delegate resume \" + a.AttemptID + \" --wait-until-reset\"}\n\t\t\t\tif _, err := posemodel.ReviewResumeDelay(*latest, time.Now(), 24*time.Hour, 0); err != nil {\n\t\t\t\t\twait.Why = reason(err)\n\t\t\t\t} else {\n\t\t\t\t\twait.Available = true\n\t\t\t\t}\n\t\t\t\tactions = append(actions, wait)\n\t\t\t\tresume.Why = tr(\"the agent is limited until \", \"o agente está limitado até \") + i.ResetAt\n\t\t\t} else {\n\t\t\t\tresume.Available = true\n\t\t\t}\n\t\t}\n\t\tactions = append(actions, resume)\n\t}\n\thandoff := delegateNextAction{Action: \"handoff\", Command: \"pose delegate handoff \" + a.AttemptID + \" --to auto\"}\n\tif agent, _, err := routeHandoff(store, *latest); err != nil {\n\t\thandoff.Why = reason(err)\n\t} else if plan, err := store.PlanReviewHandoff(latest.RunID, agent); err != nil {\n\t\thandoff.Why = reason(err)\n\t} else if plan.PendingContinuation != nil || plan.Existing != nil {\n\t\thandoff.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n\t} else {\n\t\thandoff.Available = true\n\t}\n\treturn append(actions, handoff, delegateCancelAction())\n}\n\n// delegateRunNextActions is the ways forward of the attempt run belongs to,\n// for a run that just stopped (R9).\nfunc delegateRunNextActions(store posemodel.Store, run posemodel.ReviewRun, err error) []delegateNextAction {\n\tif err != nil || run.AttemptID == \"\" || run.Status == posemodel.ReviewRunCompleted {\n\t\treturn nil","numLines":60,"startLine":190,"totalLines":309}},"tool_result_meta":[{"id":"toolu_01GWrLk3fAEj6auc38cgPoQj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
