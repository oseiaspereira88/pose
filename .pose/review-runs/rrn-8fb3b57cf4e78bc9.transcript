out)\n+\t}\n+\t// Review round 2, N6: a handoff is refused the same way, before it\n+\t// claims the interrupted run.\n+\tif _, err := (posemodel.Store{Root: root}).PlanReviewHandoff(prior.RunID, \"other\"); err == nil || !strings.Contains(err.Error(), \"still exists\") || !strings.Contains(err.Error(), \"then hand off again\") {\n+\t\tt.Fatalf(\"a handoff beside a leftover runtime directory: %v\", err)\n+\t}\n+\tif err := os.Remove(runtimeDir); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tcode, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID)\n+\tif code != 0 || !strings.Contains(out, \"status=completed\") {\n+\t\tt.Fatalf(\"the resumed session did not find its checkout at %s: %d %s\", checkout, code, out)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/delegation_handoff.go b/pose-mcp/internal/pose/delegation_handoff.go\nindex e5ed504a..c5b6278b 100644\n--- a/pose-mcp/internal/pose/delegation_handoff.go\n+++ b/pose-mcp/internal/pose/delegation_handoff.go\n@@ -342,6 +342,11 @@ func (s Store) PlanReviewHandoff(id, agent string) (DispatchPlan, error) {\n \t\tplan.Existing = existing\n \t\treturn plan, nil\n \t}\n+\t// A handoff runs in the attempt's runtime directory too (spec\n+\t// pose-review-resume-keeps-the-sealed-checkout, review round 2, N6).\n+\tif e = reviewRunRuntimeDirFree(prior.AttemptID, \"hand off\"); e != nil {\n+\t\treturn DispatchPlan{}, e\n+\t}\n \tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\n \tif e != nil {\n \t\treturn DispatchPlan{}, e\ndiff --git a/pose-mcp/internal/pose/review_dispatch.go b/pose-mcp/internal/pose/review_dispatch.go\nindex 34f53c9d..ec60960f 100644\n--- a/pose-mcp/internal/pose/review_dispatch.go\n+++ b/pose-mcp/internal/pose/review_dispatch.go\n@@ -19,10 +19,12 @@ import (\n \t\"errors\"\n \t\"fmt\"\n \t\"io\"\n+\t\"io/fs\"\n \t\"os\"\n \t\"os/exec\"\n \t\"path/filepath\"\n \t\"reflect\"\n+\t\"regexp\"\n \t\"runtime\"\n \t\"sort\"\n \t\"strings\"\n@@ -804,17 +806,21 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n \t\t}\n \t}\n-\ttmp, err := os.MkdirTemp(\"\", \"pose-review-run-*\")\n+\ttmp, err := reviewRunRuntimeDir(run.AttemptID)\n \tif err != nil {\n-\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n+\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed: \"+err.Error())\n \t}\n \tsafety.RuntimeID = filepath.Base(tmp)\n \towned, err := os.Lstat(tmp)\n \tif err != nil {\n+\t\t// Nothing is in it yet: removing it keeps the attempt's path free\n+\t\t// for its next run (review round 1, N4).\n+\t\t_ = os.Remove(tmp)\n \t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n \t}\n \truntimeRoot, err := os.OpenRoot(tmp)\n \tif err != nil {\n+\t\t_ = os.Remove(tmp)\n \t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n \t}\n \tdefer runtimeRoot.Close()\n@@ -2028,3 +2034,65 @@ func sourceMaterializationDiffers(root, commit string, entries []ReviewBundleSub\n \t}\n \treturn \"\"\n }\n+\n+// reviewRunRuntimeHex is how many hex digits of the attempt id name its\n+// runtime directory: no more than the longest random suffix of\n+// os.MkdirTemp, a uint32 in decimal (ten digits).\n+const reviewRunRuntimeHex = 10\n+\n+// reviewAttemptIDRE is the form of a delegated review attempt's id.\n+var reviewAttemptIDRE = regexp.MustCompile(`^rat-[0-9a-f]{64}$`)\n+\n+// reviewRunRuntimeDir creates the private directory of one run. Every run of\n+// an attempt uses the same path, so a resumed reviewer session, which still\n+// refers to the sealed checkout it worked in, finds the checkout recreated\n+// there after the interrupted run removed it (spec\n+// pose-review-resume-keeps-the-sealed-checkout R1). The directory is created\n+// exclusively and never followed: when the path already exists, from an\n+// unfinished cleanup or from someone else, the run fails instead of sharing\n+// it. A run without an attempt keeps a random name.\n+func reviewRunRuntimeDir(attemptID string) (string, error) {\n+\tdir, ok := reviewRunRuntimeDirPath(attemptID)\n+\tif !ok {\n+\t\treturn os.MkdirTemp(\"\", \"pose-review-run-*\")\n+\t}\n+\tif err := os.Mkdir(dir, 0o700); err != nil {\n+\t\tif errors.Is(err, fs.ErrExist) {\n+\t\t\treturn \"\", fmt.Errorf(\"the attempt's runtime directory %s already exists; an earlier run of the attempt did not clean up, or another process holds the path; when no run of the attempt is live, remove it, then run again\", dir)\n+\t\t}\n+\t\treturn \"\", err\n+\t}\n+\treturn dir, nil\n+}\n+\n+// reviewRunRuntimeDirPath is the runtime directory every run of an attempt\n+// uses, or false for a run without an attempt.\n+func reviewRunRuntimeDirPath(attemptID string) (string, bool) {\n+\tif !reviewAttemptIDRE.MatchString(attemptID) {\n+\t\treturn \"\", false\n+\t}\n+\t// The name is no longer than the longest random one it replaces: the adapter's\n+\t// TMPDIR is this directory, and a sandboxed reviewer creates Unix\n+\t// sockets under it, whose paths are bounded (about 108 bytes); the\n+\t// 32-hex name made the Claude sandbox fail to start (review rounds 1\n+\t// to 3). Ten hex digits name the attempt; a clash with another attempt\n+\t// only fails the later run, as the directory is created exclusively.\n+\treturn filepath.Join(os.TempDir(), \"pose-review-run-\"+attemptID[len(\"rat-\"):len(\"rat-\")+reviewRunRuntimeHex]), true\n+}\n+\n+// reviewRunRuntimeDirFree refuses a continuation whose runtime directory is\n+// still there, before the continuation is claimed, so removing the\n+// directory restores the resume instead of losing it to a failed run\n+// (review round 1, N1).\n+func reviewRunRuntimeDirFree(attemptID, verb string) error {\n+\tdir, ok := reviewRunRuntimeDirPath(attemptID)\n+\tif !ok {\n+\t\treturn nil\n+\t}\n+\tif _, err := os.Lstat(dir); err == nil {\n+\t\treturn fmt.Errorf(\"the attempt's runtime directory %s still exists although its last run cleaned up; another process holds the path, or a run of the attempt is starting; when none is live, remove it, then %s again\", dir, verb)\n+\t} else if !errors.Is(err, fs.ErrNotExist) {\n+\t\treturn fmt.Errorf(\"the attempt's runtime directory %s cannot be checked: %w\", dir, err)\n+\t}\n+\treturn nil\n+}\ndiff --git a/pose-mcp/internal/pose/review_run_continuity.go b/pose-mcp/internal/pose/review_run_continuity.go\nindex dfbcc596..66697c22 100644\n--- a/pose-mcp/internal/pose/review_run_continuity.go\n+++ b/pose-mcp/internal/pose/review_run_continuity.go\n@@ -426,6 +426,11 @@ func (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n \t\tplan.Existing = existing\n \t\treturn plan, nil\n \t}\n+\t// Only a continuation still to start needs the attempt's runtime\n+\t// directory free; a repeated resume returns the recorded one.\n+\tif e = reviewRunRuntimeDirFree(prior.AttemptID, \"resume\"); e != nil {\n+\t\treturn DispatchPlan{}, e\n+\t}\n \t// The attempt's budget, not this agent's: after a handoff the resumed\n \t// agent may declare another (spec pose-delegation-handoff R2).\n \tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\ndiff --git a/pose-mcp/internal/pose/review_run_runtime_dir_test.go b/pose-mcp/internal/pose/review_run_runtime_dir_test.go\nnew file mode 100644\nindex 00000000..2bea2bbc\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_run_runtime_dir_test.go\n@@ -0,0 +1,50 @@\n+package pose\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-review-resume-keeps-the-sealed-checkout R3: the attempt's\n+// directory is created exclusively; an existing path, a link included, fails\n+// the run instead of being shared or followed.\n+func TestRunContinuityAttemptRuntimeDirectoryIsCreatedExclusively(t *testing.T) {\n+\t// os.TempDir reads TMPDIR on Unix and TMP/TEMP on Windows (review round\n+\t// 2, N10).\n+\ttmp := t.TempDir()\n+\tfor _, name := range []string{\"TMPDIR\", \"TMP\", \"TEMP\"} {\n+\t\tt.Setenv(name, tmp)\n+\t}\n+\tid := \"rat-\" + strings.Repeat(\"ab\", 32)\n+\tdir, err := reviewRunRuntimeDir(id)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t// The adapter's TMPDIR is this directory and sandboxes create Unix\n+\t// sockets under it: the name is no longer than a random one (review\n+\t// rounds 1 to 3, the reviewer's sandbox failed to start).\n+\t// os.MkdirTemp's suffix is a uint32 in decimal, at most ten digits\n+\t// (review round 4, N16).\n+\tif longest := len(\"pose-review-run-\") + 10; len(filepath.Base(dir)) > longest {\n+\t\tt.Fatalf(\"the attempt's runtime directory %s is longer than the longest random one (%d bytes)\", filepath.Base(dir), longest)\n+\t}\n+\tif _, err := reviewRunRuntimeDir(id); err == nil || !strings.Contains(err.Error(), \"already exists\") {\n+\t\tt.Fatalf(\"an existing runtime directory was shared: %v\", err)\n+\t}\n+\tif err := os.Remove(dir); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\ttarget := t.TempDir()\n+\t// Without the privilege to create a link (Windows), only the link case\n+\t// is skipped (review round 4, N20).\n+\tif err := os.Symlink(target, dir); err != nil {\n+\t\tt.Logf(\"link case skipped: %v\", err)\n+\t} else if _, err := reviewRunRuntimeDir(id); err == nil {\n+\t\tt.Fatal(\"a link at the runtime directory was followed\")\n+\t}\n+\tif again, err := reviewRunRuntimeDir(\"\"); err != nil || filepath.Dir(again) != os.TempDir() {\n+\t\tt.Fatalf(\"a run without an attempt: %s %v\", again, err)\n+\t}\n+}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01B3ddufWk4cky4FYRLxgenP","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChRUL7eSNdStJTGFNP3tp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KTDuUA9RPnmNcKr6m62PP5","name":"Read","input":{"file_path":"/var/tmp/pose-work-go/pose-review-run-874c23d9d3/worktree/.pose/specs/2026-11-25-pose-review-resume-keeps-the-sealed-checkout.md"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11289,"cache_read_input_tokens":24864,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11289},"output_tokens":17,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"632c54e7-8164-4213-bc53-dfbfd21c4f01","timestamp":"2026-11-26T11:37:01.767Z","request_id":"req_011ChRUL7U1aoAKGf37hHCUN","wire_tool_inputs":{"toolu_01KTDuUA9RPnmNcKr6m62PP5":{"file_path":"/var/tmp/pose-work-go/pose-review-run-874c23d9d3/worktree/.pose/specs/2026-11-25-pose-review-resume-keeps-the-sealed-checkout.md"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KTDuUA9RPnmNcKr6m62PP5","type":"tool_result","content":"1\t---\n2\tslug: pose-review-resume-keeps-the-sealed-checkout\n3\tstatus: in-progress        # draft | in-progress | done | superseded | abandoned; blocked = operational wait, not terminal\n4\tcreated_at: 2026-11-25\n5\tcompleted_at:        # stamped on the transition to status: done\n6\tsupersedes:          # slug of the superseded spec (when applicable)\n7\tdepends_on:          # prerequisites, inline list: other-spec, milestone:<roadmap>/<id>, roadmap:<slug>\n8\tremediates:          # optional explicit links: spec:slug@defect-fix, finding:rva-<16hex>/F1@revert (never inferred from depends_on)\n9\tpriority: 2\n10\tcomponents: pose-mcp\n11\ttask_type: bugfix\n12\tsurface: standard\n13\tdelivers: capability:review-resume-keeps-the-sealed-checkout\n14\t---\n15\t\n16\t# Spec: pose-review-resume-keeps-the-sealed-checkout\n17\t\n18\t## 1. Intent\n19\t\n20\t### Goal\n21\tMake `pose delegate resume` give the resumed reviewer session a sealed checkout it can reach: either at the path the interrupted run used, or with the new path stated to the session, so a resume never points the reviewer at a removed directory.\n22\t\n23\t### Business value\n24\tOn 2026-11-25 round 11 of `pose-review-run-reaps-lingering-reviewer-processes` hit the Codex usage limit; `pose delegate resume rrn-7e7520ad4fac9345` started a new run whose session still referred to the first attempt's sealed checkout, which the cleanup had removed. The reviewer correctly stopped (`the sealed checkout ... has disappeared`), the resume produced no draft, and the round had to be dispatched again from scratch.\n25\t\n26\t### Constraints\n27\tThe resumed run still reviews exactly the sealed subject; no path outside the run's runtime is trusted.\n28\t\n29\t### Non-goals\n30\tChanging round accounting or the conclusion step.\n31\t\n32\t## 2. Requirements\n33\t\n34\t### Functional\n35\t- R1: A resumed run shall materialize its sealed checkout where the resumed session can reach it, or tell the session its new path in the continuation prompt.\n36\t- R2: A regression test shall resume an interrupted run whose first checkout was removed and see the session work in the recreated checkout.\n37\t- R3: The attempt's runtime directory shall be created exclusively: an existing path, a link included, shall fail the run with its reason, never be shared or followed; a resume beside it shall be refused before the continuation is claimed.\n38\t\n39\t### Non-functional\n40\tExisting behaviour outside the stated requirements is unchanged.\n41\t\n42\t### Security\n43\tNo new input crosses a trust boundary without the existing confinement.\n44\t\n45\t### Compatibility\n46\tRuns recorded by earlier engines keep their meaning.\n47\t\n48\t## 3. Technical Plan\n49\t\n50\t### Affected areas\n51\t`pose-mcp` review dispatch: the runtime directory of a run (`reviewRunRuntimeDir` in `internal/pose/review_dispatch.go`).\n52\t\n53\t### Artifacts\n54\t- created: .pose/specs/2026-11-25-pose-review-resume-keeps-the-sealed-checkout.md\n55\t- modified: pose-mcp/internal/pose/review_dispatch.go\n56\t- created: pose-mcp/internal/pose/review_run_runtime_dir_test.go\n57\t- modified: pose-mcp/internal/cli/review_run_continuity_test.go\n58\t- modified: pose-mcp/internal/pose/review_run_continuity.go\n59\t- modified: pose-mcp/internal/pose/delegation_handoff.go\n60\t- modified: POSE.md\n61\t- modified: locales/pt-BR/POSE.md\n62\t- modified: pose-mcp/internal/scaffold/dist/POSE.md\n63\t- modified: pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n64\t\n65\t### Delivery targets\n66\t- capability:review-resume-keeps-the-sealed-checkout module:pose-mcp profile:composed-capability entrypoint:pose-mcp/internal/cli/delegate.go\n67\t\n68\t### Accepted limits\n69\t- L1: The path is derived from the temporary directory of the process that dispatches, so a resume run with another `TMPDIR` recreates the checkout elsewhere and the session meets the old failure. Accepted because the dispatcher's environment is the operator's and the failure is the same one this spec removes for the usual case, a resume from the same shell.\n70\t- L2: The path is predictable, so another local user can create it first and block the attempt's runs. Accepted because the directory is created exclusively and never followed, so such a path only fails the run with its reason and is never shared.\n71\t- L3: A process that escaped an earlier run of the attempt knows the next run's paths, including its output file outside the checkout, which random names used to hide. Accepted because such a process already runs as the dispatching user and can reach any of that user's paths; on Linux the review run shim ends the run's subtree, and elsewhere the escape is the limit `pose-review-run-reaping-beyond-linux` addresses.\n72\t\n73\t### API/contract changes\n74\tNone: the run records, briefs and adapter commands are unchanged; only where the run directory is created changes.\n75\t\n76\t### Data/storage changes\n77\tNone.\n78\t\n79\t### Technical risks\n80\tA run whose cleanup failed leaves the directory, and resume already refuses such a predecessor. A directory present although the last run cleaned up (another process holding the path) makes resume and handoff refuse before they claim the run, naming the directory, so removing it restores them; a run that fails before anything is in the directory removes it.\n81\t\n82\t## 4. Tasks\n83\t\n84\t### Planning\n85\t- [x] Confirm how the continuation prompt and the worktree path are built.\n86\t\n87\t### Implementation\n88\t- [x] Implement each requirement with a test that fails before it.\n89\t\n90\t### Validation\n91\t- [ ] `pose validate --carry` and `pose check --strict`.\n92\t\n93\t## 5. Decisions\n94\t\n95\t### Decision D1\n96\t- Basis: R1, R3\n97\tKeep the checkout where the session last saw it rather than telling the session a new path: the continuation sends the same sealed brief, whose wire digest the provenance checks, so adding a path notice would change what is verified; a path stable per attempt changes nothing the run records. Every run of an attempt uses `pose-review-run-<first 10 hex of the attempt id>` under the temporary directory, created exclusively; a run with no attempt keeps a random name. The name is no longer than the longest random one (`os.MkdirTemp`'s suffix is a uint32 in decimal, at most ten digits), because the reviewer's `TMPDIR` is this directory and a sandboxed reviewer creates Unix sockets under it, whose paths are bounded.\n98\t\n99\t## 6. Validation\n100\t\n101\t### Strategy\n102\tEach requirement gets a regression test shown failing before its code.\n103\t\n104\t### Deterministic checks\n105\t\n106\t#### Test\n107\t- Command: `go test ./...` (in `pose-mcp`), then `pose validate --carry`.\n108\t\n109\t### Execution log\n110\t- 2026-11-26: `reviewRunRuntimeDir` gives every run of an attempt the same runtime directory, created with `os.Mkdir` (no link followed, an existing path refused). `TestResumedReviewFindsItsSealedCheckoutAtTheSamePath` fails with the random name restored (the session was moved from the first checkout); `TestTheAttemptRuntimeDirectoryIsCreatedExclusively` fails with `MkdirAll`.\n111\t- 2026-11-26: review round 1 (rrn-7adbffa551b9acf2, Claude Sonnet 5.5) ended without a draft: its Bash sandbox did not start. From its reading: N1, resume refuses a leftover runtime directory before claiming the continuation (the test fails with the check mutated out); N2, the R2 adapter fails unless the recreated checkout holds the spec; N3, the manual in both locales states the stable path, the `TMPDIR` condition and the remedy; N4, a run that fails right after creating the directory removes it; N5 is declared as L3.\n112\t- 2026-11-26: the full suite caught a repeated resume refused beside the directory; the check now runs only for a continuation still to start. Review round 2 (rrn-c5d57ff07d69ec1a) requested changes: N7, the manual, the technical risks and the messages no longer promise that removing a directory left by an unfinished cleanup restores resume (that predecessor is refused anyway); N6, a handoff checks the directory before it claims the run (the test fails with the check mutated out); N9, the regression tests are named `TestRunContinuity…`, so the matrix's continuity pattern runs them; N10, the exclusivity test isolates `TMP` and `TEMP` as well. N8 is a follow-up.\n113\t- 2026-11-26: review round 3 (rrn-95a0d363d2041e1d) approved, but its conclusion was refused: its required tools were `deferred`, because, as in round 1, the reviewer's Bash sandbox failed to start (\"Failed to create bridge sockets\"). Cause: this spec's 32-hex directory name made the reviewer's `TMPDIR` 70 bytes long, and the Claude sandbox's Unix socket paths under it passed the ~108-byte bound; the random name was 48. The name now uses 10 hex digits, as long as the random suffix, and `TestRunContinuityAttemptRuntimeDirectoryIsCreatedExclusively` fails when it is longer than a random one. The round's follow-ups N11–N15 are recorded with its attestation once a round concludes.\n114\t- 2026-11-26: review round 4 (rrn-17b88c930fddf599) ran its tools (the sandbox started) and requested changes: N16, the length test compared with one random name, whose decimal suffix can be shorter (235 failures in 1000 runs); it now compares with the longest one, ten digits, and passes 300 repeated runs. N19, the handoff refusal says \"hand off again\"; N20, the link case is skipped where links cannot be made. N17, N18 and N21 are follow-ups.\n115\t\n116\t### Results summary\n117\tThe full `pose-mcp` suite passes; the canonical result is refreshed with `pose validate --carry`.\n118\t\n119\t### Requirement trace\n120\t- R1 [satisfied] test:TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath\n121\t- R2 [satisfied] test:TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath\n122\t- R3 [satisfied] test:TestRunContinuityAttemptRuntimeDirectoryIsCreatedExclusively, test:TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath\n123\t\n124\t### Known gaps\n125\tNone.\n126\t\n127\t## 7. Final Report\n128\t\n129\t### Delivered scope\n130\tA resumed review run recreates its sealed checkout at the path the interrupted run used, so the resumed session keeps working in it.\n131\t\n132\t### Files and modules changed\n133\t`pose-mcp` review dispatch and its tests.\n134\t\n135\t### Validation executed\n136\t`go test ./...` in `pose-mcp`; `pose check --strict`; `pose validate --carry --json-out .pose/results/delivery-validation.json`.\n137\t\n138\t### Residual risks\n139\tL1, L2 and L3 above.\n140\t\n141\t### Follow-ups\n142\t- [open] Make the continuation claim and the runtime-directory check one step, so a resume that loses a race is told the continuation is pending instead of being asked to remove a live run's directory (review rounds 2 N8, 3 N12, 4 N17). (owner:@pose-maintainers crit:low review:2026-12-26)\n143\t- [open] Refuse to resume a run interrupted under an engine that named its runtime directory at random (its recorded `safety.runtime_id` differs from the attempt's stable name), pointing to a handoff, since its session refers to a checkout path that is not recreated (review rounds 3 N11, 4 N18). (owner:@pose-maintainers crit:low review:2026-12-26)\n144\t- [open] Give a session continued into a new review round the checkout path it saw, which belongs to a new attempt and so differs (review rounds 3 N15, 4 N21; outside resume). (owner:@pose-maintainers crit:low review:2026-12-26)\n145\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"494ad1c0-6662-401a-8393-d8c1553f52e2","timestamp":"2026-11-26T11:37:01.783Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-874c23d9d3/worktree/.pose/specs/2026-11-25-pose-review-resume-keeps-the-sealed-checkout.md","content":"---\nslug: pose-review-resume-keeps-the-sealed-checkout\nstatus: in-progress        # draft | in-progress | done | superseded | abandoned; blocked = operational wait, not terminal\ncreated_at: 2026-11-25\ncompleted_at:        # stamped on the transition to status: done\nsupersedes:          # slug of the superseded spec (when applicable)\ndepends_on:          # prerequisites, inline list: other-spec, milestone:<roadmap>/<id>, roadmap:<slug>\nremediates:          # optional explicit links: spec:slug@defect-fix, finding:rva-<16hex>/F1@revert (never inferred from depends_on)\npriority: 2\ncomponents: pose-mcp\ntask_type: bugfix\nsurface: standard\ndelivers: capability:review-resume-keeps-the-sealed-checkout\n---\n\n# Spec: pose-review-resume-keeps-the-sealed-checkout\n\n## 1. Intent\n\n### Goal\nMake `pose delegate resume` give the resumed reviewer session a sealed checkout it can reach: either at the path the interrupted run used, or with the new path stated to the session, so a resume never points the reviewer at a removed directory.\n\n### Business value\nOn 2026-11-25 round 11 of `pose-review-run-reaps-lingering-reviewer-processes` hit the Codex usage limit; `pose delegate resume rrn-7e7520ad4fac9345` started a new run whose session still referred to the first attempt's sealed checkout, which the cleanup had removed. The reviewer correctly stopped (`the sealed checkout ... has disappeared`), the resume produced no draft, and the round had to be dispatched again from scratch.\n\n### Constraints\nThe resumed run still reviews exactly the sealed subject; no path outside the run's runtime is trusted.\n\n### Non-goals\nChanging round accounting or the conclusion step.\n\n## 2. Requirements\n\n### Functional\n- R1: A resumed run shall materialize its sealed checkout where the resumed session can reach it, or tell the session its new path in the continuation prompt.\n- R2: A regression test shall resume an interrupted run whose first checkout was removed and see the session work in the recreated checkout.\n- R3: The attempt's runtime directory shall be created exclusively: an existing path, a link included, shall fail the run with its reason, never be shared or followed; a resume beside it shall be refused before the continuation is claimed.\n\n### Non-functional\nExisting behaviour outside the stated requirements is unchanged.\n\n### Security\nNo new input crosses a trust boundary without the existing confinement.\n\n### Compatibility\nRuns recorded by earlier engines keep their meaning.\n\n## 3. Technical Plan\n\n### Affected areas\n`pose-mcp` review dispatch: the runtime directory of a run (`reviewRunRuntimeDir` in `internal/pose/review_dispatch.go`).\n\n### Artifacts\n- created: .pose/specs/2026-11-25-pose-review-resume-keeps-the-sealed-checkout.md\n- modified: pose-mcp/internal/pose/review_dispatch.go\n- created: pose-mcp/internal/pose/review_run_runtime_dir_test.go\n- modified: pose-mcp/internal/cli/review_run_continuity_test.go\n- modified: pose-mcp/internal/pose/review_run_continuity.go\n- modified: pose-mcp/internal/pose/delegation_handoff.go\n- modified: POSE.md\n- modified: locales/pt-BR/POSE.md\n- modified: pose-mcp/internal/scaffold/dist/POSE.md\n- modified: pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n\n### Delivery targets\n- capability:review-resume-keeps-the-sealed-checkout module:pose-mcp profile:composed-capability entrypoint:pose-mcp/internal/cli/delegate.go\n\n### Accepted limits\n- L1: The path is derived from the temporary directory of the process that dispatches, so a resume run with another `TMPDIR` recreates the checkout elsewhere and the session meets the old failure. Accepted because the dispatcher's environment is the operator's and the failure is the same one this spec removes for the usual case, a resume from the same shell.\n- L2: The path is predictable, so another local user can create it first and block the attempt's runs. Accepted because the directory is created exclusively and never followed, so such a path only fails the run with its reason and is never shared.\n- L3: A process that escaped an earlier run of the attempt knows the next run's paths, including its output file outside the checkout, which random names used to hide. Accepted because such a process already runs as the dispatching user and can reach any of that user's paths; on Linux the review run shim ends the run's subtree, and elsewhere the escape is the limit `pose-review-run-reaping-beyond-linux` addresses.\n\n### API/contract changes\nNone: the run records, briefs and adapter commands are unchanged; only where the run directory is created changes.\n\n### Data/storage changes\nNone.\n\n### Technical risks\nA run whose cleanup failed leaves the directory, and resume already refuses such a predecessor. A directory present although the last run cleaned up (another process holding the path) makes resume and handoff refuse before they claim the run, naming the directory, so removing it restores them; a run that fails before anything is in the directory removes it.\n\n## 4. Tasks\n\n### Planning\n- [x] Confirm how the continuation prompt and the worktree path are built.\n\n### Implementation\n- [x] Implement each requirement with a test that fails before it.\n\n### Validation\n- [ ] `pose validate --carry` and `pose check --strict`.\n\n## 5. Decisions\n\n### Decision D1\n- Basis: R1, R3\nKeep the checkout where the session last saw it rather than telling the session a new path: the continuation sends the same sealed brief, whose wire digest the provenance checks, so adding a path notice would change what is verified; a path stable per attempt changes nothing the run records. Every run of an attempt uses `pose-review-run-<first 10 hex of the attempt id>` under the temporary directory, created exclusively; a run with no attempt keeps a random name. The name is no longer than the longest random one (`os.MkdirTemp`'s suffix is a uint32 in decimal, at most ten digits), because the reviewer's `TMPDIR` is this directory and a sandboxed reviewer creates Unix sockets under it, whose paths are bounded.\n\n## 6. Validation\n\n### Strategy\nEach requirement gets a regression test shown failing before its code.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./...` (in `pose-mcp`), then `pose validate --carry`.\n\n### Execution log\n- 2026-11-26: `reviewRunRuntimeDir` gives every run of an attempt the same runtime directory, created with `os.Mkdir` (no link followed, an existing path refused). `TestResumedReviewFindsItsSealedCheckoutAtTheSamePath` fails with the random name restored (the session was moved from the first checkout); `TestTheAttemptRuntimeDirectoryIsCreatedExclusively` fails with `MkdirAll`.\n- 2026-11-26: review round 1 (rrn-7adbffa551b9acf2, Claude Sonnet 5.5) ended without a draft: its Bash sandbox did not start. From its reading: N1, resume refuses a leftover runtime directory before claiming the continuation (the test fails with the check mutated out); N2, the R2 adapter fails unless the recreated checkout holds the spec; N3, the manual in both locales states the stable path, the `TMPDIR` condition and the remedy; N4, a run that fails right after creating the directory removes it; N5 is declared as L3.\n- 2026-11-26: the full suite caught a repeated resume refused beside the directory; the check now runs only for a continuation still to start. Review round 2 (rrn-c5d57ff07d69ec1a) requested changes: N7, the manual, the technical risks and the messages no longer promise that removing a directory left by an unfinished cleanup restores resume (that predecessor is refused anyway); N6, a handoff checks the directory before it claims the run (the test fails with the check mutated out); N9, the regression tests are named `TestRunContinuity…`, so the matrix's continuity pattern runs them; N10, the exclusivity test isolates `TMP` and `TEMP` as well. N8 is a follow-up.\n- 2026-11-26: review round 3 (rrn-95a0d363d2041e1d) approved, but its conclusion was refused: its required tools were `deferred`, because, as in round 1, the reviewer's Bash sandbox failed to start (\"Failed to create bridge sockets\"). Cause: this spec's 32-hex directory name made the reviewer's `TMPDIR` 70 bytes long, and the Claude sandbox's Unix socket paths under it passed the ~108-byte bound; the random name was 48. The name now uses 10 hex digits, as long as the random suffix, and `TestRunContinuityAttemptRuntimeDirectoryIsCreatedExclusively` fails when it is longer than a random one. The round's follow-ups N11–N15 are recorded with its attestation once a round concludes.\n- 2026-11-26: review round 4 (rrn-17b88c930fddf599) ran its tools (the sandbox started) and requested changes: N16, the length test compared with one random name, whose decimal suffix can be shorter (235 failures in 1000 runs); it now compares with the longest one, ten digits, and passes 300 repeated runs. N19, the handoff refusal says \"hand off again\"; N20, the link case is skipped where links cannot be made. N17, N18 and N21 are follow-ups.\n\n### Results summary\nThe full `pose-mcp` suite passes; the canonical result is refreshed with `pose validate --carry`.\n\n### Requirement trace\n- R1 [satisfied] test:TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath\n- R2 [satisfied] test:TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath\n- R3 [satisfied] test:TestRunContinuityAttemptRuntimeDirectoryIsCreatedExclusively, test:TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath\n\n### Known gaps\nNone.\n\n## 7. Final Report\n\n### Delivered scope\nA resumed review run recreates its sealed checkout at the path the interrupted run used, so the resumed session keeps working in it.\n\n### Files and modules changed\n`pose-mcp` review dispatch and its tests.\n\n### Validation executed\n`go test ./...` in `pose-mcp`; `pose check --strict`; `pose validate --carry --json-out .pose/results/delivery-validation.json`.\n\n### Residual risks\nL1, L2 and L3 above.\n\n### Follow-ups\n- [open] Make the continuation claim and the runtime-directory check one step, so a resume that loses a race is told the continuation is pending instead of being asked to remove a live run's directory (review rounds 2 N8, 3 N12, 4 N17). (owner:@pose-maintainers crit:low review:2026-12-26)\n- [open] Refuse to resume a run interrupted under an engine that named its runtime directory at random (its recorded `safety.runtime_id` differs from the attempt's stable name), pointing to a handoff, since its session refers to a checkout path that is not recreated (review rounds 3 N11, 4 N18). (owner:@pose-maintainers crit:low review:2026-12-26)\n- [open] Give a session continued into a new review round the checkout path it saw, which belongs to a new attempt and so differs (review rounds 3 N15, 4 N21; outside resume). (owner:@pose-maintainers crit:low review:2026-12-26)\n","numLines":145,"startLine":1,"totalLines":145}},"tool_result_meta":[{"id":"toolu_01KTDuUA9RPnmNcKr6m62PP5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
