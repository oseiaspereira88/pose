:= ValidateSlug(slug); err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: invalid roadmap slug %q\", slug)\n\t}\n\tpath := filepath.Join(s.roadmapsDir(), slug+\".md\")\n","exit_code":0,"status":"completed"}}
