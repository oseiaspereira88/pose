{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1020,1105p' pose-mcp/internal/pose/review_plan.go\"","aggregated_output":"}\n\nfunc missingFrom(values, known []string) []string {\n\tpresent := map[string]bool{}\n\tfor _, value := range known {\n\t\tpresent[value] = true\n\t}\n\tmissing := []string{}\n\tfor _, value := range values {\n\t\tif !present[value] {\n\t\t\tmissing = append(missing, value)\n\t\t}\n\t}\n\treturn uniqueSorted(missing)\n}\n\nfunc composeReviewCriteria(profiles []ReviewProfile, blockers []string) ([]ReviewPlanCriterion, []string) {\n\tcriteria := []ReviewPlanCriterion{}\n\tfor _, profile := range profiles {\n\t\tfor _, item := range profile.Criteria {\n\t\t\trequired := item.Required == nil || *item.Required\n\t\t\t// No filter here any more. A profile that declares a class outside\n\t\t\t// the vocabulary now fails to load, so nothing unproducible reaches\n\t\t\t// this point — the blocker this used to raise, and the class-drop\n\t\t\t// tools used to receive, were both guarding against input the\n\t\t\t// contract no longer admits.\n\t\t\tclasses := uniqueSorted(item.EvidenceClasses)\n\t\t\tkind := item.Kind\n\t\t\tif kind == \"\" {\n\t\t\t\tkind = DeriveReviewCriterionKind(classes)\n\t\t\t}\n\t\t\tcriterion := ReviewPlanCriterion{ID: item.ID, Description: item.Description, Required: required, Kind: kind, Rules: uniqueSorted(item.Rules), EvidenceClasses: classes, RequiresStructuralMapping: item.RequiresStructuralMapping, Profiles: []string{profile.Ref()}}\n\t\t\tcriteria, blockers = addReviewCriterion(criteria, criterion, blockers)\n\t\t}\n\t}\n\tsort.Slice(criteria, func(i, j int) bool { return criteria[i].ID < criteria[j].ID })\n\treturn criteria, blockers\n}\n\n// addMilestoneGateCriterion carries the exit gate of a milestone into the review of the\n// spec it is made of: that milestone has no review of its own, so this is where the\n// gate is judged. A done spec keeps the plan it was sealed with (spec\n// pose-done-spec-keeps-its-sealed-plan): the criterion stays in its plan when a sealed\n// bundle of the spec carries it, because the plan is an input of the bundle and a plan\n// that loses the criterion at the transition to done makes the bundle the approval was\n// attested over read superseded. A done spec sealed without it gains none.\nfunc (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCriterion, blockers []string) ([]ReviewPlanCriterion, []string) {\n\tif scope.Kind != \"spec\" {\n\t\treturn criteria, blockers\n\t}\n\tsp, err := s.GetSpec(scope.Slug)\n\tif err != nil {\n\t\treturn criteria, blockers\n\t}\n\tdone := terminalStatuses[sp.Status]\n\tvar sealedWith map[string]bool // criterion ids of the governing bundle of a done spec, read once\n\tvar historyUnknown string      // why the history could not say, when it could not\n\tsealedCarries := func(id string) bool {\n\t\tif sealedWith == nil {\n\t\t\tsealedWith = map[string]bool{}\n\t\t\t// The governing bundle is the newest: a gate that only an older round of\n\t\t\t// the review carried was dropped by a later seal and is not kept.\n\t\t\tread, readErr := s.ReadReviewBundles(\"spec:\" + scope.Slug)\n\t\t\tswitch {\n\t\t\tcase readErr != nil:\n\t\t\t\thistoryUnknown = readErr.Error()\n\t\t\tcase !read.Coverage.CompleteFor(\"spec:\" + scope.Slug):\n\t\t\t\thistoryUnknown = \"a sealed bundle of the scope could not be read\"\n\t\t\tdefault:\n\t\t\t\tif lineage := reviewBundleLineage(read.Bundles); len(lineage) > 0 {\n\t\t\t\t\tfor _, criterion := range lineage[0].Payload.Plan.Criteria {\n\t\t\t\t\t\tsealedWith[criterion.ID] = true\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn sealedWith[id]\n\t}\n\troadmaps, err := s.ListRoadmaps()\n\tif err != nil {\n\t\treturn criteria, blockers\n\t}\n\tadopted, _ := s.closeoutReviewPolicyAdopted()\n\tfor _, rm := range roadmaps {\n\t\tif terminalStatuses[rm.Status] {\n\t\t\tcontinue\n","exit_code":0,"status":"completed"}}
