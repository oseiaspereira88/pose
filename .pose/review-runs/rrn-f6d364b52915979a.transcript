{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_receipt.go'","aggregated_output":"package pose\n\n// Closeout receipts (spec pose-closeout-review-policy-by-cost-benefit R4, R7).\n// Under an adopted closeout review policy, the explicit `pose close` of a\n// milestone or a roadmap publishes a receipt: the terminal marker of that\n// close, with the evaluator's decision and the policy it was made under. A\n// receipt is written once and never reinterpreted: a later policy change does\n// not re-evaluate it, and a different or corrupt receipt is never overwritten.\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n)\n\nconst CloseoutReceiptSchemaVersion = 1\n\ntype CloseoutReceipt struct {\n\tSchemaVersion int    `json:\"schema_version\"`\n\tScope         string `json:\"scope\"`\n\tClosedAt      string `json:\"closed_at\"`\n\t// Review is the literal `required` or `not-required`.\n\tReview        string                 `json:\"review\"`\n\tDecision      CloseoutReviewDecision `json:\"decision\"`\n\tPolicyDigest  string                 `json:\"policy_digest\"`\n\tSubjectDigest string                 `json:\"subject_digest\"`\n\t// ExitGateDigest binds a milestone's exit gate as it was closed.\n\tExitGateDigest string `json:\"exit_gate_digest,omitempty\"`\n\t// ReviewBundle and ReviewAttestation name the verified review the close\n\t// stood on: required, or made by choice when not required.\n\tReviewBundle      string `json:\"review_bundle,omitempty\"`\n\tReviewAttestation string `json:\"review_attestation,omitempty\"`\n\tApprovalOrigin    string `json:\"approval_origin,omitempty\"`\n}\n\n// CloseoutReceiptPath is where the receipt of an aggregate scope lives.\nfunc (s Store) CloseoutReceiptPath(ref string) (string, error) {\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tbase := filepath.Join(s.Root, \".pose\", \"review-closeouts\")\n\tswitch scope.Kind {\n\tcase \"milestone\":\n\t\tif ValidateSlug(scope.Roadmap) != nil || !filepath.IsLocal(scope.Milestone) || filepath.Base(scope.Milestone) != scope.Milestone {\n\t\t\treturn \"\", fmt.Errorf(\"pose: invalid milestone scope %s\", ref)\n\t\t}\n\t\treturn filepath.Join(base, \"milestone\", scope.Roadmap, scope.Milestone+\".json\"), nil\n\tcase \"roadmap\":\n\t\tif ValidateSlug(scope.Slug) != nil {\n\t\t\treturn \"\", fmt.Errorf(\"pose: invalid roadmap scope %s\", ref)\n\t\t}\n\t\treturn filepath.Join(base, \"roadmap\", scope.Slug+\".json\"), nil\n\t}\n\treturn \"\", fmt.Errorf(\"pose: %s has no closeout receipt; only milestones and roadmaps do\", ref)\n}\n\n// ReadCloseoutReceipt returns the receipt of a scope, nil when there is none.\n// A receipt that cannot be read or does not validate is an error, never an\n// absence: it would otherwise reopen a closed scope or hide a corruption.\nfunc (s Store) ReadCloseoutReceipt(ref string) (*CloseoutReceipt, error) {\n\tpath, err := s.CloseoutReceiptPath(ref)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tinfo, err := s.fsys().Lstat(path)\n\tif os.IsNotExist(err) {\n\t\treturn nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\tif !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s is not a regular file of this project\", ref)\n\t}\n\traw, err := s.fsys().ReadFile(path)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\treceipt, err := parseCloseoutReceipt(raw)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\tif receipt.Scope != ref || receipt.Decision.Scope != ref {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt at %s names %s, not %s\", path, receipt.Scope, ref)\n\t}\n\treturn &receipt, nil\n}\n\nfunc parseCloseoutReceipt(raw []byte) (CloseoutReceipt, error) {\n\tvar receipt CloseoutReceipt\n\tif err := rejectDuplicateJSONKeysAndControls(raw); err != nil {\n\t\treturn receipt, err\n\t}\n\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n\tdecoder.DisallowUnknownFields()\n\tif err := decoder.Decode(&receipt); err != nil {\n\t\treturn receipt, err\n\t}\n\tif err := decoder.Decode(new(any)); err != io.EOF {\n\t\treturn receipt, errors.New(\"trailing content\")\n\t}\n\tif receipt.SchemaVersion != CloseoutReceiptSchemaVersion {\n\t\treturn receipt, fmt.Errorf(\"unsupported schema_version %d\", receipt.SchemaVersion)\n\t}\n\tif _, valid := reviewInstant(receipt.ClosedAt); !valid {\n\t\treturn receipt, fmt.Errorf(\"closed_at %q is not an instant\", receipt.ClosedAt)\n\t}\n\td := receipt.Decision\n\tif !d.Adopted || d.EvaluatorVersion != CloseoutReviewEvaluatorVersion || !validCloseoutReviewValue(d.PolicyValue) || d.Reason == \"\" {\n\t\treturn receipt, errors.New(\"decision is not one of \" + CloseoutReviewEvaluatorVersion)\n\t}\n\tif d.PolicyValue == CloseoutReviewNever && d.Required && d.Reason == \"\" || d.PolicyValue == CloseoutReviewAlways && !d.Required {\n\t\treturn receipt, fmt.Errorf(\"a %s decision cannot be required=%v\", d.PolicyValue, d.Required)\n\t}\n\tif receipt.Review != d.Review() {\n\t\treturn receipt, fmt.Errorf(\"review %q contradicts the recorded decision (%s)\", receipt.Review, d.Review())\n\t}\n\tif d.Required && receipt.ReviewBundle == \"\" && receipt.ApprovalOrigin == \"\" {\n\t\treturn receipt, errors.New(\"a required review names no verified review\")\n\t}\n\tif !d.Known {\n\t\treturn receipt, errors.New(\"a close cannot stand on unknown members or associations\")\n\t}\n\tif receipt.PolicyDigest == \"\" || receipt.SubjectDigest == \"\" {\n\t\treturn receipt, errors.New(\"policy_digest and subject_digest are required\")\n\t}\n\treturn receipt, nil\n}\n\n// NewCloseoutReceipt builds the receipt of a close from the evaluator's\n// decision and the verification it stood on. It writes nothing.\nfunc (s Store) NewCloseoutReceipt(ref string, decision CloseoutReviewDecision, verification ReviewEvaluation, subjectDigest string, now time.Time) (CloseoutReceipt, error) {\n\t_, raw, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn CloseoutReceipt{}, err\n\t}\n\t_, gate, _, err := s.closeoutSubject(ref)\n\tif err != nil {\n\t\treturn CloseoutReceipt{}, err\n\t}\n\treceipt := CloseoutReceipt{\n\t\tExitGateDigest: gate,\n\t\tSchemaVersion:  CloseoutReceiptSchemaVersion, Scope: ref, ClosedAt: now.UTC().Format(time.RFC3339),\n\t\tReview: decision.Review(), Decision: decision, PolicyDigest: \"sha256:\" + digestHex(raw), SubjectDigest: subjectDigest,\n\t\tReviewBundle: verification.BundleID, ReviewAttestation: verification.AttestationID,\n\t}\n\tif receipt.ReviewBundle == \"\" && verification.Current != nil {\n\t\treceipt.ApprovalOrigin = \"review:\" + verification.Current.ReviewID\n\t}\n\tif receipt.ReviewBundle == \"\" && receipt.ApprovalOrigin == \"\" {\n\t\treceipt.ApprovalOrigin = verification.ApprovalOrigin\n\t}\n\tif _, err := parseCloseoutReceipt(CanonicalJSON(receipt)); err != nil {\n\t\treturn CloseoutReceipt{}, fmt.Errorf(\"pose: the closeout receipt of %s would be refused: %w\", ref, err)\n\t}\n\treturn receipt, nil\n}\n\n// ErrCloseoutReceiptExists reports a receipt already published for the scope.\nvar ErrCloseoutReceiptExists = errors.New(\"pose: a closeout receipt already exists\")\n\n// PublishCloseoutReceipt publishes a receipt where none exists. It never\n// replaces one: an equal receipt is the caller's to verify, a different one\n// stays as it is.\nfunc (s Store) PublishCloseoutReceipt(receipt CloseoutReceipt) error {\n\tpath, err := s.CloseoutReceiptPath(receipt.Scope)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif existing, err := s.ReadCloseoutReceipt(receipt.Scope); err != nil {\n\t\treturn err\n\t} else if existing != nil {\n\t\treturn ErrCloseoutReceiptExists\n\t}\n\traw, err := json.MarshalIndent(receipt, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\terr = s.fsys().Publish(path, append(raw, '\\n'), 0o644, PublishDerived, PublishExpectation{Mode: ExpectAbsent})\n\tif errors.Is(err, ErrPublishConflict) {\n\t\treturn ErrCloseoutReceiptExists\n\t}\n\treturn err\n}\n\n// A roadmap's close publishes its status and then its receipt. Between the\n// two an intent stands, so a close interrupted there reads as incomplete,\n// never as a roadmap closed before adoption (spec\n// pose-closeout-review-policy-by-cost-benefit R4, R7).\nfunc (s Store) closeoutIntentPath(ref string) (string, error) {\n\tpath, err := s.CloseoutReceiptPath(ref)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn strings.TrimSuffix(path, \".json\") + \".intent.json\", nil\n}\n\n// closeoutIntentPending reports an intent on file. What cannot be read is an\n// error, which the caller treats as pending: it never proves history.\nfunc (s Store) closeoutIntentPending(ref string) (bool, error) {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif _, err := s.fsys().Lstat(path); err == nil {\n\t\treturn true, nil\n\t} else if os.IsNotExist(err) {\n\t\treturn false, nil\n\t} else {\n\t\treturn false, err\n\t}\n}\n\n// PublishCloseoutIntent records that this engine is closing ref under the\n// adopted policy, before the roadmap's status is published.\nfunc (s Store) PublishCloseoutIntent(ref string, decision CloseoutReviewDecision, now time.Time) error {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn err\n\t}\n\traw, err := json.MarshalIndent(map[string]any{\"schema_version\": 1, \"scope\": ref, \"started_at\": now.UTC().Format(time.RFC3339), \"review\": decision.Review()}, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\treturn s.fsys().Publish(path, append(raw, '\\n'), 0o644, PublishDerived, PublishExpectation{Mode: ExpectAny})\n}\n\n// ClearCloseoutIntent removes the intent once the receipt stands.\nfunc (s Store) ClearCloseoutIntent(ref string) error {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().Remove(path); err != nil && !os.IsNotExist(err) {\n\t\treturn err\n\t}\n\treturn nil\n}\n\n// roadmapCriteriaBlockers evaluates a roadmap's cut criteria from the indexed\n// delivery graph, as the roadmap gate does: a criterion that does not pass,\n// or a manual review that does not resolve inside the project. A graph that\n// cannot be read is a blocker, never a pass.\nfunc (s Store) roadmapCriteriaBlockers(slug string) []string {\n\tgraph, err := s.GetDeliveryIntegrity(\"\")\n\tif err != nil {\n\t\treturn []string{\"the cut criteria of roadmap \" + slug + \" cannot be evaluated: \" + err.Error()}\n\t}\n\tblockers := []string{}\n\tfor _, criterion := range graph.RoadmapCriteria {\n\t\tif criterion.Roadmap != slug {\n\t\t\tcontinue\n\t\t}\n\t\tif !criterion.Passed {\n\t\t\tblockers = append(blockers, criterion.ID+\": \"+strings.Join(criterion.Reasons, \"; \"))\n\t\t}\n\t\tfor _, ref := range criterion.Refs {\n\t\t\trelative, manual := strings.CutPrefix(ref, \"manual-review:\")\n\t\t\tif !manual {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tpath := filepath.Join(s.Root, filepath.FromSlash(relative))\n\t\t\tif !filepath.IsLocal(filepath.FromSlash(relative)) || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\t\t\tblockers = append(blockers, criterion.ID+\": manual review escapes project\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif info, err := s.fsys().Stat(path); err != nil || info.IsDir() {\n\t\t\t\tblockers = append(blockers, criterion.ID+\": manual review does not resolve: \"+relative)\n\t\t\t}\n\t\t}\n\t}\n\treturn blockers\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_adr_associations.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_adr_associations.go'","aggregated_output":"package pose\n\n// ADR associations of a roadmap, for the when-justified roadmap rule of the\n// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n//\n// An association is explicit, never inferred from prose:\n//   - forward: the roadmap's `adrs: [adr:<file>.md]` frontmatter, or a local\n//     Markdown link from its body to a file in .pose/adr/;\n//   - backward: an ADR's `roadmaps: [roadmap:<slug>]` (or the qualified\n//     `xref:<project>/roadmap:<slug>`) frontmatter, or a local Markdown link\n//     from the ADR to .pose/roadmaps/<slug>.md.\n//\n// Only the owning project's .pose/adr/ is inventoried; nothing searches other\n// projects. A malformed declaration, a link to a missing file or an\n// incomplete inventory is unknown, which can never prove absence.\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n)\n\nconst (\n\tcloseoutADRInventoryLimit = 4096\n\tcloseoutADRSizeLimit      = 1 << 20\n)\n\nvar (\n\t// [text](dest \"title\") and [text](<dest>) inline links.\n\tmarkdownInlineLinkRE = regexp.MustCompile(`\\]\\(\\s*(<[^>\\n]*>|[^)\\s]+)(?:\\s+(?:\"[^\"]*\"|'[^']*'|\\([^)]*\\)))?\\s*\\)`)\n\t// [label]: dest \"title\" reference definitions.\n\tmarkdownReferenceLinkRE = regexp.MustCompile(`(?m)^\\s{0,3}\\[[^\\]\\n]+\\]:\\s*(<[^>\\n]*>|\\S+)`)\n)\n\nfunc (s Store) adrDir() string { return filepath.Join(s.Root, \".pose\", \"adr\") }\n\n// markdownLinkDestinations lists the link destinations of a Markdown body,\n// angle brackets and fragments removed. External URLs are kept out.\nfunc markdownLinkDestinations(body string) []string {\n\tout := []string{}\n\tadd := func(dest string) {\n\t\tdest = strings.TrimSpace(dest)\n\t\tdest = strings.TrimSuffix(strings.TrimPrefix(dest, \"<\"), \">\")\n\t\tif i := strings.IndexAny(dest, \"#?\"); i >= 0 {\n\t\t\tdest = dest[:i]\n\t\t}\n\t\tif dest == \"\" || strings.Contains(dest, \"://\") || strings.HasPrefix(dest, \"mailto:\") || strings.HasPrefix(dest, \"/\") {\n\t\t\treturn\n\t\t}\n\t\tout = append(out, dest)\n\t}\n\tfor _, m := range markdownInlineLinkRE.FindAllStringSubmatch(body, -1) {\n\t\tadd(m[1])\n\t}\n\tfor _, m := range markdownReferenceLinkRE.FindAllStringSubmatch(body, -1) {\n\t\tadd(m[1])\n\t}\n\treturn out\n}\n\n// validADRBasename accepts exactly a file name ending in .md directly inside\n// .pose/adr/: no directory, traversal, hidden file or URI.\nfunc validADRBasename(name string) bool {\n\treturn name != \"\" && filepath.Base(name) == name && !strings.ContainsAny(name, `/\\:`) &&\n\t\t!strings.HasPrefix(name, \".\") && strings.HasSuffix(name, \".md\") && name != \".md\"\n}\n\n// regularADR reports a regular, non-symlinked file of .pose/adr/ within the root.\nfunc (s Store) regularADR(name string) error {\n\tpath := filepath.Join(s.adrDir(), name)\n\tinfo, err := s.fsys().Lstat(path)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\treturn fmt.Errorf(\"not a regular file inside .pose/adr\")\n\t}\n\treturn nil\n}\n\n// closeoutADRAssociations returns the sorted ADR basenames associated with a\n// roadmap, and the diagnostics that make the answer unknown.\nfunc (s Store) closeoutADRAssociations(rm *Roadmap, project string) ([]string, []string) {\n\tfound := map[string]bool{}\n\tdiagnostics := []string{}\n\tif rm.ADRs != \"\" {\n\t\tvalue := strings.TrimSpace(rm.ADRs)\n\t\tif !strings.HasPrefix(value, \"[\") || !strings.HasSuffix(value, \"]\") {\n\t\t\tdiagnostics = append(diagnostics, \"roadmap \"+rm.Slug+\" declares adrs: outside a [list]\")\n\t\t} else {\n\t\t\tfor _, item := range parseInlineList(value) {\n\t\t\t\tname, ok := strings.CutPrefix(item, \"adr:\")\n\t\t\t\tif !ok || !validADRBasename(name) {\n\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares %q, not adr:<file>.md\", rm.Slug, item))\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif err := s.regularADR(name); err != nil {\n\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares adr:%s, which cannot be read: %v\", rm.Slug, name, err))\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tfound[name] = true\n\t\t\t}\n\t\t}\n\t}\n\tbody := rm.Body\n\tif body == \"\" {\n\t\tif full, err := s.GetRoadmap(rm.Slug); err == nil {\n\t\t\tbody = full.Body\n\t\t}\n\t}\n\troadmapDir := filepath.Dir(rm.Path)\n\tfor _, dest := range markdownLinkDestinations(body) {\n\t\ttarget := filepath.Clean(filepath.Join(roadmapDir, filepath.FromSlash(dest)))\n\t\tif filepath.Dir(target) != filepath.Clean(s.adrDir()) || !strings.HasSuffix(target, \".md\") {\n\t\t\tcontinue\n\t\t}\n\t\tname := filepath.Base(target)\n\t\tif err := s.regularADR(name); err != nil {\n\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, which cannot be read: %v\", rm.Slug, dest, err))\n\t\t\tcontinue\n\t\t}\n\t\tfound[name] = true\n\t}\n\tentries, err := s.fsys().ReadDir(s.adrDir())\n\tif err != nil && !os.IsNotExist(err) {\n\t\tdiagnostics = append(diagnostics, \"the ADR inventory could not be read: \"+err.Error())\n\t}\n\tif len(entries) > closeoutADRInventoryLimit {\n\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"the ADR inventory has %d entries, above the limit of %d\", len(entries), closeoutADRInventoryLimit))\n\t\tentries = nil\n\t}\n\troadmapPath := filepath.Clean(filepath.Join(s.roadmapsDir(), rm.Slug+\".md\"))\n\tfor _, entry := range entries {\n\t\tname := entry.Name()\n\t\t// Every candidate is read, the associated ones included: its size,\n\t\t// its readability and its own declaration are inputs. One that\n\t\t// cannot be read could hold a backlink, so it is unknown.\n\t\tif entry.IsDir() || !strings.HasSuffix(name, \".md\") {\n\t\t\tcontinue\n\t\t}\n\t\tif err := s.regularADR(name); err != nil {\n\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is not a regular file of .pose/adr: \"+err.Error())\n\t\t\tcontinue\n\t\t}\n\t\tpath := filepath.Join(s.adrDir(), name)\n\t\tif info, err := s.fsys().Lstat(path); err != nil || info.Size() > closeoutADRSizeLimit {\n\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is unreadable or above the size limit\")\n\t\t\tcontinue\n\t\t}\n\t\traw, err := s.fsys().ReadFile(path)\n\t\tif err != nil {\n\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" could not be read: \"+err.Error())\n\t\t\tcontinue\n\t\t}\n\t\tfm, adrBody := SplitFrontmatter(string(raw))\n\t\tif declared, ok := fm[\"roadmaps\"]; ok {\n\t\t\tvalue := strings.TrimSpace(declared)\n\t\t\tif !strings.HasPrefix(value, \"[\") || !strings.HasSuffix(value, \"]\") {\n\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" declares roadmaps: outside a [list]\")\n\t\t\t} else {\n\t\t\t\tfor _, item := range parseInlineList(value) {\n\t\t\t\t\tref, err := ParseArtifactRef(item)\n\t\t\t\t\tif err != nil || ref.Kind != \"roadmap\" || ref.Milestone != \"\" {\n\t\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %q, not roadmap:<slug>\", name, item))\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tif ref.Project != \"\" && ref.Project != project {\n\t\t\t\t\t\tcontinue // a roadmap of another project: not this association\n\t\t\t\t\t}\n\t\t\t\t\tif _, err := s.GetRoadmap(ref.Slug); err != nil {\n\t\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %s, which names no roadmap of this project\", name, item))\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tif ref.Slug == rm.Slug {\n\t\t\t\t\t\tfound[name] = true\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tfor _, dest := range markdownLinkDestinations(adrBody) {\n\t\t\ttarget := filepath.Clean(filepath.Join(s.adrDir(), filepath.FromSlash(dest)))\n\t\t\tif filepath.Dir(target) != filepath.Clean(s.roadmapsDir()) || !strings.HasSuffix(target, \".md\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// A link into the roadmaps namespace is an association input: one\n\t\t\t// that does not resolve to a roadmap leaves the answer unknown.\n\t\t\tif info, err := s.fsys().Lstat(target); err != nil || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, target) {\n\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which is not a roadmap of this project\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// The target is read as the roadmap it names, as a roadmaps:\n\t\t\t// declaration is: a regular entry that cannot be read or parsed\n\t\t\t// leaves the answer unknown, never an absence. The roadmaps README\n\t\t\t// is no roadmap, as ListRoadmaps reads the namespace.\n\t\t\tif strings.EqualFold(filepath.Base(target), \"README.md\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, err := s.GetRoadmap(strings.TrimSuffix(filepath.Base(target), \".md\")); err != nil {\n\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which could not be read as a roadmap of this project\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif target == roadmapPath {\n\t\t\t\tfound[name] = true\n\t\t\t}\n\t\t}\n\t}\n\tadrs := make([]string, 0, len(found))\n\tfor name := range found {\n\t\tadrs = append(adrs, name)\n\t}\n\tsort.Strings(adrs)\n\tsort.Strings(diagnostics)\n\treturn adrs, diagnostics\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2..8ce96337 -- pose-mcp/internal/cli/review_closeout.go pose-mcp/internal/cli/surface_check.go pose-mcp/internal/pose/review_bundle.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2..8ce96337 -- pose-mcp/internal/cli/review_closeout.go pose-mcp/internal/cli/surface_check.go pose-mcp/internal/pose/review_bundle.go'","aggregated_output":"diff --git a/pose-mcp/internal/cli/review_closeout.go b/pose-mcp/internal/cli/review_closeout.go\nindex 5339f00a..22bfa902 100644\n--- a/pose-mcp/internal/cli/review_closeout.go\n+++ b/pose-mcp/internal/cli/review_closeout.go\n@@ -1953,11 +1953,19 @@ func cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref strin\n \t\tout.Failure(fmt.Sprintf(\"pose close: %d action request(s) restrict closeout of %s\", len(governed), ref))\n \t\treturn 1\n \t}\n-\tif !state.Review.Approved || len(state.Children) > 0 && hasOpenChild(state.Children) {\n+\tscope, _ := posemodel.ParseScopeRef(ref)\n+\t// Under an adopted closeout review policy (spec\n+\t// pose-closeout-review-policy-by-cost-benefit) the close of a milestone or a\n+\t// roadmap publishes a receipt. A receipt already there makes the close a\n+\t// read-only verification; a scope the evaluator cannot decide is refused.\n+\treceiptClose, code := closeoutReceiptPreflight(store, ref, scope, &state, stdout, stderr)\n+\tif code >= 0 {\n+\t\treturn code\n+\t}\n+\tif !closeReviewSatisfied(state) || len(state.Children) > 0 && hasOpenChild(state.Children) {\n \t\tfmt.Fprintf(stderr, \"pose close: scope is not eligible; next action: %s\\n\", state.NextAction)\n \t\treturn 1\n \t}\n-\tscope, _ := posemodel.ParseScopeRef(ref)\n \tif scope.Kind == \"milestone\" {\n \t\tgate, err := roadmapGate(root, scope.Roadmap, scope.Milestone)\n \t\tif err != nil {\n@@ -1968,7 +1976,18 @@ func cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref strin\n \t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + strings.Join(blockers, \"; \"))\n \t\t\treturn 1\n \t\t}\n-\t\tfmt.Fprintf(stdout, \"Milestone closeout verified: %s\\n\", ref)\n+\t\tlabel := \"Milestone closeout verified\"\n+\t\tif receiptClose != nil {\n+\t\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, guard, stderr)\n+\t\t\tif code != 0 {\n+\t\t\t\treturn code\n+\t\t\t}\n+\t\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, judgedState, stdout, stderr); code != 0 {\n+\t\t\t\treturn code\n+\t\t\t}\n+\t\t\tlabel = \"Closed\"\n+\t\t}\n+\t\tfmt.Fprintf(stdout, \"%s: %s\\n\", label, ref)\n \t\trenderCloseNext(render(stdout, stderr), nextCloses(store, ref))\n \t\treturn 0\n \t}\n@@ -2061,7 +2080,7 @@ func cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref strin\n \tif current, err := cliCloseoutStateForStore(store, ref); err != nil {\n \t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n \t\treturn 1\n-\t} else if !current.Review.Approved || hasActionRequestPending(current.Diagnostics) || hasDiagnostic(current.Diagnostics, posemodel.AdjudicationDoesNotHoldCode) {\n+\t} else if !(closeReviewSatisfied(current) || receiptClose != nil && !receiptClose.Required) || hasActionRequestPending(current.Diagnostics) || hasDiagnostic(current.Diagnostics, posemodel.AdjudicationDoesNotHoldCode) {\n \t\trender(io.Discard, stderr).Failure(\"pose close: the closeout authorization changed while its gates ran; next action: \" + current.NextAction)\n \t\treturn 1\n \t}\n@@ -2082,6 +2101,23 @@ func cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref strin\n \t\t\treturn 1\n \t\t}\n \t}\n+\tvar receiptState posemodel.CloseoutState\n+\tif receiptClose != nil {\n+\t\t// Judged before the status is published: afterwards the index no\n+\t\t// longer matches the tree until it is regenerated.\n+\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, nil, stderr)\n+\t\tif code != 0 {\n+\t\t\treturn code\n+\t\t}\n+\t\treceiptState = judgedState\n+\t\t// The intent stands from before the status until the receipt: an\n+\t\t// interruption between them reads as an incomplete close, never as\n+\t\t// a roadmap closed before adoption.\n+\t\tif err := store.PublishCloseoutIntent(ref, *receiptClose, time.Now()); err != nil {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: closeout intent not recorded: \" + err.Error())\n+\t\t\treturn 1\n+\t\t}\n+\t}\n \tvar unsynced error\n \tif err := applyLifecycleDoneIn(store.FS, path, scope.Kind == \"spec\", judged); err != nil {\n \t\tif errors.Is(err, posemodel.ErrPublishConflict) {\n@@ -2097,6 +2133,14 @@ func cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref strin\n \t\tunsynced = err\n \t\trender(stdout, stderr).Field(\"close.unsynced\", err.Error())\n \t}\n+\tif receiptClose != nil {\n+\t\t// The status is published; the receipt is the terminal marker and\n+\t\t// comes after it. A failure here leaves the roadmap explicitly\n+\t\t// incomplete, and the next `pose close` verifies again and publishes.\n+\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, receiptState, stdout, stderr); code != 0 {\n+\t\t\treturn code\n+\t\t}\n+\t}\n \tif transitioned != nil {\n \t\ttransitioned(unsynced)\n \t}\n@@ -2383,3 +2427,170 @@ func hasActionRequestPending(diagnostics []posemodel.Diagnostic) bool {\n // before the protected region. Only tests set it, to change the repository\n // at that point.\n var closeGatesJudged func()\n+\n+// closeReviewSatisfied is the review half of close eligibility: an approval,\n+// or a review the adopted closeout review policy does not require.\n+func closeReviewSatisfied(state posemodel.CloseoutState) bool {\n+\treturn state.Review.Approved || state.Review.CloseoutReview != nil && !state.Review.Required\n+}\n+\n+// closeoutReceiptPreflight decides whether this close publishes a receipt.\n+// It returns the decision to record (nil: legacy close) and an exit code, or\n+// -1 to go on. A receipt already there makes the close a verification of the\n+// current terminal contract. A done roadmap with no receipt is the incomplete\n+// case: its decision is taken again over the current inputs, under the same\n+// rules as an open scope, so a recorded rejection is never closed over.\n+func closeoutReceiptPreflight(store posemodel.Store, ref string, scope posemodel.ScopeRef, state *posemodel.CloseoutState, stdout, stderr io.Writer) (*posemodel.CloseoutReviewDecision, int) {\n+\tif scope.Kind != \"milestone\" && scope.Kind != \"roadmap\" {\n+\t\treturn nil, -1\n+\t}\n+\tpolicy, err := store.GetReviewPolicy()\n+\tif err != nil {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n+\t\treturn nil, 1\n+\t}\n+\tif !policy.CloseoutReviewAdopted() {\n+\t\treturn nil, -1\n+\t}\n+\tif state.CloseoutReceipt != nil {\n+\t\tif !state.Terminal {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n+\t\t\treturn nil, 1\n+\t\t}\n+\t\t// The gates the close passed are verified again, independently of the\n+\t\t// policy: a receipt does not stand for a gate that no longer holds.\n+\t\tif blocker := closeGateBlocker(store.Root, scope); blocker != \"\" {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + blocker)\n+\t\t\treturn nil, 1\n+\t\t}\n+\t\treceipt := state.CloseoutReceipt\n+\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; closeout receipt of \"+receipt.ClosedAt+\" stands (review: \"+receipt.Review+\"); applicable terminal verifier passed; no transition executed\")\n+\t\treturn nil, 0\n+\t}\n+\tdecision := state.Review.CloseoutReview\n+\tif decision == nil {\n+\t\t// No decision: a scope of a roadmap closed before adoption, verified by\n+\t\t// the contract it was sealed under. It never gets a receipt; for a done\n+\t\t// roadmap the close is a read-only verification.\n+\t\tif scope.Kind == \"roadmap\" && state.LifecycleDone {\n+\t\t\tif !state.Terminal {\n+\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n+\t\t\t\treturn nil, 1\n+\t\t\t}\n+\t\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; closed before the closeout review policy was adopted; its sealed contract verifies; no transition executed\")\n+\t\t\treturn nil, 0\n+\t\t}\n+\t\treturn nil, -1\n+\t}\n+\tif !decision.Known {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout review of \" + ref + \" cannot be decided: \" + strings.Join(decision.Diagnostics, \"; \"))\n+\t\treturn nil, 1\n+\t}\n+\t// An exemption replaces the review's approval, not the other gates: a\n+\t// scope with any blocker, an unknown read view included, does not close.\n+\tif !decision.Required && len(state.Blockers) > 0 && !onlyLifecycleBlockers(state.Blockers) {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: \" + ref + \" is not eligible: \" + strings.Join(state.Blockers, \"; \"))\n+\t\treturn nil, 1\n+\t}\n+\trender(stdout, stderr).Field(\"close.review\", decision.Review()+\" (\"+decision.PolicyKey+\"=\"+decision.PolicyValue+\", \"+decision.Reason+\")\")\n+\treturn decision, -1\n+}\n+\n+// verifyCloseoutPublication judges the whole authorization once more inside\n+// the protected region: the same protected decision, the same members and\n+// associations, and a closeout state still eligible. It returns that state,\n+// which the receipt is built from.\n+func verifyCloseoutPublication(store posemodel.Store, ref string, decision posemodel.CloseoutReviewDecision, guard func() error, stderr io.Writer) (posemodel.CloseoutState, int) {\n+\tif guard != nil {\n+\t\tif err := guard(); err != nil {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n+\t\t\treturn posemodel.CloseoutState{}, 1\n+\t\t}\n+\t}\n+\tchanged := func(why string) (posemodel.CloseoutState, int) {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout of \" + ref + \" changed while its gates ran (\" + why + \"); run `pose close \" + ref + \"` again\")\n+\t\treturn posemodel.CloseoutState{}, 1\n+\t}\n+\tcurrent, err := store.CurrentCloseoutDecision(ref)\n+\tif err != nil {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n+\t\treturn posemodel.CloseoutState{}, 1\n+\t}\n+\tif current.Required != decision.Required || current.Known != decision.Known || current.PolicyValue != decision.PolicyValue ||\n+\t\tstrings.Join(current.Members, \",\") != strings.Join(decision.Members, \",\") || strings.Join(current.ADRs, \",\") != strings.Join(decision.ADRs, \",\") {\n+\t\treturn changed(\"the review decision differs\")\n+\t}\n+\tstate, err := cliCloseoutStateForStore(store, ref)\n+\tif err != nil {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n+\t\treturn posemodel.CloseoutState{}, 1\n+\t}\n+\tif state.CloseoutReceipt != nil {\n+\t\treturn changed(\"a receipt was published meanwhile\")\n+\t}\n+\tif decision.Required && !state.Review.Approved {\n+\t\treturn changed(\"the required review is no longer approved\")\n+\t}\n+\tif !decision.Required && state.Review.Required && !state.LifecycleDone {\n+\t\treturn changed(\"the review is required again\")\n+\t}\n+\tif len(state.Blockers) > 0 && !onlyLifecycleBlockers(state.Blockers) {\n+\t\treturn changed(strings.Join(state.Blockers, \"; \"))\n+\t}\n+\treturn state, 0\n+}\n+\n+// publishCloseoutReceipt publishes the receipt of a close from the state the\n+// protected region judged, then removes the close's intent.\n+func publishCloseoutReceipt(store posemodel.Store, ref string, decision posemodel.CloseoutReviewDecision, judged posemodel.CloseoutState, stdout, stderr io.Writer) int {\n+\treceipt, err := store.NewCloseoutReceipt(ref, decision, judged.Review, judged.ScopeDigest, time.Now())\n+\tif err != nil {\n+\t\trender(io.Discard, stderr).Failure(\"pose close: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n+\t\treturn 1\n+\t}\n+\tif err := store.PublishCloseoutReceipt(receipt); err != nil {\n+\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n+\t\t\trender(stdout, stderr).Field(\"close.unsynced\", err.Error())\n+\t\t} else {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: closeout receipt not published: \" + err.Error() + \"; `pose close \" + ref + \"` verifies again and publishes it\")\n+\t\t\treturn 1\n+\t\t}\n+\t}\n+\tif err := store.ClearCloseoutIntent(ref); err != nil {\n+\t\trender(stdout, stderr).Field(\"close.intent\", \"the receipt stands; its intent record could not be removed: \"+err.Error())\n+\t}\n+\trender(stdout, stderr).Field(\"close.receipt\", \"review: \"+receipt.Review+\"; \"+decision.PolicyKey+\"=\"+decision.PolicyValue+\"; \"+decision.Reason)\n+\treturn 0\n+}\n+\n+// onlyLifecycleBlockers reports blockers that only say the roadmap's status\n+// is not done yet: the receipt is published right after that status.\n+func onlyLifecycleBlockers(blockers []string) bool {\n+\tfor _, blocker := range blockers {\n+\t\tif blocker != \"lifecycle status is not done\" {\n+\t\t\treturn false\n+\t\t}\n+\t}\n+\treturn true\n+}\n+\n+// closeGateBlocker runs the gate the close of an aggregate scope passed: the\n+// milestone gate, or the roadmap check with its cut criteria.\n+func closeGateBlocker(root string, scope posemodel.ScopeRef) string {\n+\tswitch scope.Kind {\n+\tcase \"milestone\":\n+\t\tgate, err := roadmapGate(root, scope.Roadmap, scope.Milestone)\n+\t\tif err != nil {\n+\t\t\treturn \"milestone gate failed: \" + err.Error()\n+\t\t}\n+\t\tif blockers := uniqueCLIStrings(gate.blockers); len(blockers) > 0 {\n+\t\t\treturn \"milestone gate failed: \" + strings.Join(blockers, \"; \")\n+\t\t}\n+\tcase \"roadmap\":\n+\t\tvar gateOut, gateErr bytes.Buffer\n+\t\tif code := cmdRoadmapCheck(root, []string{scope.Slug, \"--strict\"}, &gateOut, &gateErr); code != 0 {\n+\t\t\treturn \"roadmap gate failed: \" + strings.TrimSpace(gateErr.String()+gateOut.String())\n+\t\t}\n+\t}\n+\treturn \"\"\n+}\ndiff --git a/pose-mcp/internal/cli/surface_check.go b/pose-mcp/internal/cli/surface_check.go\nindex 1c9cd9c2..84abc287 100644\n--- a/pose-mcp/internal/cli/surface_check.go\n+++ b/pose-mcp/internal/cli/surface_check.go\n@@ -403,6 +403,9 @@ func roadmapGate(root, slug, milestone string) (roadmapGateResult, error) {\n \t\t\t\t\tcontinue\n \t\t\t\t}\n \t\t\t\tlocal = ref.Slug\n+\t\t\t} else if err == nil && ref.Kind == \"spec\" && ref.Milestone == \"\" {\n+\t\t\t\t// `spec:<slug>` and `<slug>` name the same local member.\n+\t\t\t\tlocal = ref.Slug\n \t\t\t}\n \t\t\tstate, err := store.GetCloseoutState(\"spec:\" + local)\n \t\t\tif err != nil || !state.Terminal {\ndiff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex 355f8f37..3d4e761b 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -127,6 +127,11 @@ type ReviewBundlePlan struct {\n \t// would judge an immutable bundle by today's selection, which is the whole\n \t// thing sealing exists to prevent.\n \tSelectedProfiles []ReviewPlanProfile `json:\"selected_profiles,omitempty\"`\n+\t// CloseoutReview seals the closeout-review@1 decision an aggregate scope\n+\t// was reviewed under (spec pose-closeout-review-policy-by-cost-benefit).\n+\t// Nil on every bundle sealed before adoption, which is how such a bundle\n+\t// proves a closure from before the policy.\n+\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n \t// Structure seals the material structural facts the plan observed, so the\n \t// mapping obligation is fixed at seal time. Recomputing it at verification\n \t// would let a later detector improvement retroactively block an approved\n@@ -505,7 +510,7 @@ func (s Store) prepareReviewBundle(ref string, legacyMilestoneManifest bool) (Re\n \tif err != nil {\n \t\treturn ReviewBundle{}, err\n \t}\n-\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure}\n+\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview}\n \n \tscopeProjection, excluded, err := s.reviewBundleScopeProjection(scope)\n \tif err != nil {\n@@ -1196,7 +1201,7 @@ func reviewBundlePathClass(path string, scope ScopeRef, components []ReviewPlanC\n \t\t// like the repository's own LICENSE and NOTICE (found in review).\n \t\treturn \"documentation\", true\n \t}\n-\tfor _, prefix := range []string{\".pose/state/\", \".pose/assessments/\", \".pose/reports/\", \".pose/results/\", \".pose/reviews/\", \".pose/review-bundles/\", \".pose/review-attestations/\", \".pose/review-attribution-supplements/\", \".pose/closeout-plans/\", \".pose/contributions/\", \".pose/feedback/\", \".pose/review-runs/\", \".pose/review-attempts/\", \".pose/review-run-ledger/\", \".pose/review-continuations/\", \".pose/review-private/\", \".pose/review-run-proofs/\", \".pose/delegate-runs/\", \".pose/review-conclusions/\", \".pose/adjudications/\", \".pose/events/\", \".pose/investigations/\"} {\n+\tfor _, prefix := range []string{\".pose/state/\", \".pose/assessments/\", \".pose/reports/\", \".pose/results/\", \".pose/reviews/\", \".pose/review-bundles/\", \".pose/review-attestations/\", \".pose/review-attribution-supplements/\", \".pose/closeout-plans/\", \".pose/contributions/\", \".pose/feedback/\", \".pose/review-runs/\", \".pose/review-attempts/\", \".pose/review-run-ledger/\", \".pose/review-continuations/\", \".pose/review-private/\", \".pose/review-run-proofs/\", \".pose/delegate-runs/\", \".pose/review-conclusions/\", \".pose/review-closeouts/\", \".pose/adjudications/\", \".pose/events/\", \".pose/investigations/\"} {\n \t\tif strings.HasPrefix(path, prefix) {\n \t\t\treturn \"derived-evidence\", false\n \t\t}\n@@ -3456,17 +3461,43 @@ func (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerific\n \t\treturn own, err\n \t}\n \tref, parseErr := ParseScopeRef(scope)\n-\tif parseErr != nil || ref.Kind != \"milestone\" {\n+\tif parseErr != nil || (ref.Kind != \"milestone\" && ref.Kind != \"roadmap\") {\n \t\treturn own, nil\n \t}\n \t// A policy without bundles answers through its review attempts alone, and has no\n \t// bundle of the spec to stand on.\n-\tif policy, err := s.GetReviewPolicy(); err != nil || !policy.ReviewBundles {\n+\tpolicy, err := s.GetReviewPolicy()\n+\tif err != nil || !policy.ReviewBundles {\n \t\treturn own, nil\n \t}\n \tif s.milestoneReviewRefused(scope) {\n \t\treturn own, nil\n \t}\n+\t// An adopted closeout review policy is the only rule for an open scope:\n+\t// legacy inheritance and declared exemptions cannot weaken `always`, and\n+\t// the policy's own exemption reads the same gate as reviewCheck. A roadmap\n+\t// closed before adoption keeps the legacy reading below.\n+\tadopted := policy.CloseoutReviewAdopted() && !s.closeoutScopeHistorical(ref)\n+\tif adopted {\n+\t\tdecision, exempt, gateErr := s.closeoutReviewGate(scope, policy)\n+\t\tif gateErr != nil || decision == nil || !exempt || !decision.Known {\n+\t\t\treturn own, nil\n+\t\t}\n+\t\tif ref.Kind == \"milestone\" && s.FederatedResolver != nil {\n+\t\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n+\t\t\tif err != nil || !acceptance.Ready {\n+\t\t\t\treturn own, nil\n+\t\t\t}\n+\t\t}\n+\t\treturn ReviewBundleVerification{\n+\t\t\tScope: scope, State: \"closed\", Fresh: true, Approved: true, NextAction: \"none\",\n+\t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n+\t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n+\t\t}, nil\n+\t}\n+\tif ref.Kind != \"milestone\" {\n+\t\treturn own, nil\n+\t}\n \t// Edges still bind: a milestone inherits a review, not the acceptance of what it\n \t// depends on, and revoked trust or an open predecessor leaves it where it was.\n \tif s.FederatedResolver != nil {\n","exit_code":0,"status":"completed"}}
