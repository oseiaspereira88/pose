nown {\n+\t\t\teval.Blockers = append(eval.Blockers, decision.Diagnostics...)\n+\t\t\treturn eval, nil\n+\t\t}\n+\t}\n+\tif !policy.Enabled && decision == nil {\n \t\teval.Warnings = append(eval.Warnings, \"review policy is absent or disabled; closeout review is not enforced\")\n \t\treturn eval, nil\n \t}\n \tprofileRef := policy.Profiles[scope.Kind]\n \teval.Profile = profileRef\n-\trequired, err := s.reviewRequiredForScope(scope, policy)\n-\tif err != nil {\n-\t\treturn eval, err\n+\trequired := true\n+\tif decision == nil {\n+\t\trequired, err = s.reviewRequiredForScope(scope, policy)\n+\t\tif err != nil {\n+\t\t\treturn eval, err\n+\t\t}\n \t}\n \teval.Required = required\n \tif !required {\n@@ -2671,6 +2739,12 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\n \t\t\t\t}\n \t\t\t}\n+\t\t\t// An exempt milestone of more members has no review of its own to\n+\t\t\t// judge its exit gate: an approved member review must have judged\n+\t\t\t// it, or the close is blocked; the review stays dispensed.\n+\t\t\tif decision := review.CloseoutReview; decision != nil && !decision.Required && len(milestone.Specs) > 1 && strings.TrimSpace(milestone.ExitGate) != \"\" && !review.Approved && !s.exitGateJudgedByMember(rm.Slug, milestone, state.Children) {\n+\t\t\t\tblock(NewDiagnostic(\"milestone-exit-gate-unjudged\", \"the exit gate of \"+ref+\" is judged by no approved review: once every other member is closed, seal and review its last member, whose plan then carries the gate, or review the milestone itself (`pose review bundle \"+ref+\" --seal`)\", ref))\n+\t\t\t}\n \t\t\tbreak\n \t\t}\n \t\tif !found {\n@@ -2725,7 +2799,38 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t}\n \t\t}\n \t}\n-\tif !review.Required {\n+\tcloseOwed := false\n+\tif scope.Kind == \"milestone\" || scope.Kind == \"roadmap\" {\n+\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil && policy.CloseoutReviewAdopted() {\n+\t\t\treceipt, receiptErr := s.ReadCloseoutReceipt(ref)\n+\t\t\tif receiptErr != nil {\n+\t\t\t\tblock(OpaqueDiagnostic(\"closeout-receipt-invalid\", DiagnosticCloseout, receiptErr.Error()))\n+\t\t\t}\n+\t\t\tstate.CloseoutReceipt = receipt\n+\t\t\tif decision := review.CloseoutReview; decision != nil && receipt == nil && receiptErr == nil {\n+\t\t\t\t// Terminal members make the scope eligible, never closed: the\n+\t\t\t\t// explicit close publishes the receipt that makes it terminal.\n+\t\t\t\tcloseOwed = true\n+\t\t\t\tfor _, diagnostic := range decision.Diagnostics {\n+\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", diagnostic, ref))\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif review.CloseoutReview == nil && receipt == nil && scope.Kind == \"roadmap\" && state.LifecycleDone && review.Required && !review.Approved {\n+\t\t\t\tdiagnostics = append(diagnostics, NewDiagnostic(\"closeout-receipt-incomplete\", \"roadmap \"+scope.Slug+\" is done with neither an approved review nor a closeout receipt; `pose close \"+ref+\"` verifies its inputs again and publishes the receipt\", ref))\n+\t\t\t}\n+\t\t}\n+\t}\n+\tstate.CloseRequired = closeOwed\n+\tif scope.Kind == \"roadmap\" && state.CloseoutReceipt != nil {\n+\t\t// A receipt stands for its cut criteria only while they still hold:\n+\t\t// the shared terminal path checks them, as the roadmap gate does.\n+\t\tfor _, blocker := range s.roadmapCriteriaBlockers(scope.Slug) {\n+\t\t\tblock(NewDiagnostic(\"closeout-receipt-gate-failed\", blocker, ref))\n+\t\t}\n+\t}\n+\t// An exemption under the adopted policy leaves the review no blockers to\n+\t// remove; only the legacy path strips review-only messages, by text.\n+\tif !review.Required && review.CloseoutReview == nil {\n \t\tstate.Blockers = removeReviewOnlyBlockers(state.Blockers)\n \t\tkept := diagnostics[:0]\n \t\tfor _, d := range diagnostics {\n@@ -2757,7 +2862,7 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t}\n \t}\n \tstate.Blockers = uniqueSorted(state.Blockers)\n-\tstate.Terminal = len(state.Blockers) == 0 && (review.Approved || !review.Required) && state.LifecycleDone\n+\tstate.Terminal = len(state.Blockers) == 0 && (review.Approved || !review.Required) && state.LifecycleDone && !closeOwed\n \tif state.Terminal {\n \t\tstate.NextAction = \"none\"\n \t} else if len(state.Children) > 0 {\n@@ -2781,6 +2886,9 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \tif state.NextAction == \"\" && scope.Kind == \"spec\" && state.FederatedAcceptance != nil && !state.FederatedAcceptance.Ready {\n \t\tstate.NextAction = \"resolve federated dependency blockers for \" + ref\n \t}\n+\tif state.NextAction == \"\" && closeOwed && len(state.Blockers) == 0 {\n+\t\tstate.NextAction = \"close \" + ref + \" with `pose close \" + ref + \"`, which publishes its closeout receipt\"\n+\t}\n \tif state.NextAction == \"\" {\n \t\tstate.NextAction = \"resolve closeout blockers for \" + ref\n \t}\n@@ -2815,6 +2923,9 @@ func closeoutNextStep(state CloseoutState, review ReviewEvaluation, ref string)\n \t\t\t\treturn step(\"continue-child\", child.Scope)\n \t\t\t}\n \t\t}\n+\t\tif state.CloseRequired && len(state.Blockers) == 0 {\n+\t\t\treturn step(\"close-scope\", ref)\n+\t\t}\n \t\treturn step(\"resolve-federated-blockers\", ref)\n \tcase !review.Approved && review.Required:\n \t\treturn step(\"record-fresh-review\", ref)\n@@ -2822,6 +2933,8 @@ func closeoutNextStep(state CloseoutState, review ReviewEvaluation, ref string)\n \t\treturn step(\"apply-lifecycle-transition\", ref)\n \tcase state.FederatedAcceptance != nil && !state.FederatedAcceptance.Ready:\n \t\treturn step(\"resolve-federated-blockers\", ref)\n+\tcase state.CloseRequired && len(state.Blockers) == 0:\n+\t\treturn step(\"close-scope\", ref)\n \t}\n \treturn step(\"resolve-closeout-blockers\", ref)\n }\n@@ -2856,6 +2969,10 @@ func (s Store) GetCloseoutStateWithFederatedAcceptance(ref, projectID string, re\n // a federated resolver must fail closed on an external member.\n func (s Store) milestoneMember(raw string) (string, bool) {\n \tref, err := ParseArtifactRef(raw)\n+\tif err == nil && ref.Project == \"\" && ref.Kind == \"spec\" && ref.Milestone == \"\" {\n+\t\t// `spec:<slug>` and `<slug>` name the same local member.\n+\t\treturn ref.Slug, false\n+\t}\n \tif err != nil || ref.Project == \"\" {\n \t\treturn raw, false\n \t}\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex 0782e239..5d03f40d 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -131,6 +131,10 @@ type ReviewPlan struct {\n \tWarnings                  []string `json:\"warnings,omitempty\"`\n \tBlockers                  []string `json:\"blockers,omitempty\"`\n \tExplain                   []string `json:\"explain\"`\n+\t// CloseoutReview is the closeout-review@1 decision for a milestone or a\n+\t// roadmap under an adopted policy. Like Band it is a projection: it stays\n+\t// out of the plan digest (spec pose-closeout-review-policy-by-cost-benefit).\n+\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n }\n \n type reviewRepoEntry struct {\n@@ -397,6 +401,16 @@ func (s Store) ReviewPlan(ref string) (ReviewPlan, error) {\n \tif err != nil {\n \t\treturn ReviewPlan{}, err\n \t}\n+\t// Warnings and Explain enter the digest; the decision does not, so it is\n+\t// attached only as its own field. A gate that cannot answer (a corrupt or\n+\t// drifted receipt) fails the plan as it fails closeout-check.\n+\tif !s.planWithoutCloseoutGate {\n+\t\tdecision, _, gateErr := s.closeoutReviewGate(ref, policy)\n+\t\tif gateErr != nil {\n+\t\t\treturn ReviewPlan{}, gateErr\n+\t\t}\n+\t\tplan.CloseoutReview = decision\n+\t}\n \treturn plan, nil\n }\n \n@@ -1085,6 +1099,7 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \tif err != nil {\n \t\treturn criteria, blockers\n \t}\n+\tadopted, _ := s.closeoutReviewPolicyAdopted()\n \tfor _, rm := range roadmaps {\n \t\tif terminalStatuses[rm.Status] {\n \t\t\tcontinue\n@@ -1094,10 +1109,19 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\tref := ScopeRef{Kind: \"milestone\", Roadmap: rm.Slug, Milestone: milestone.ID}\n-\t\t\tif member, ok := s.soleMemberOf(ref); !ok || member != scope.Slug {\n+\t\t\tmember, ok := s.soleMemberOf(ref)\n+\t\t\tcarries := ok && member == scope.Slug\n+\t\t\t// Under an adopted closeout review policy a milestone of more\n+\t\t\t// members may close without its own review; its gate is then\n+\t\t\t// judged in the review of its last member (spec\n+\t\t\t// pose-closeout-review-policy-by-cost-benefit, review round 5 N19).\n+\t\t\tif !carries && adopted {\n+\t\t\t\tcarries = s.lastOpenMemberOf(rm.Slug, milestone, scope.Slug)\n+\t\t\t}\n+\t\t\tif !carries {\n \t\t\t\tcontinue\n \t\t\t}\n-\t\t\tif done && !sealedCarries(\"milestone-exit-gate-\"+rm.Slug+\"-\"+milestone.ID) {\n+\t\t\tif done && !sealedCarries(milestoneExitGateCriterionID(rm.Slug, milestone.ID)) {\n \t\t\t\tif historyUnknown != \"\" {\n \t\t\t\t\t// Absent history is not unreadable history: the plan says it cannot\n \t\t\t\t\t// tell whether the gate was sealed, instead of silently dropping it.\n@@ -1106,8 +1130,8 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\tcriteria, blockers = addReviewCriterion(criteria, ReviewPlanCriterion{\n-\t\t\t\tID:          \"milestone-exit-gate-\" + rm.Slug + \"-\" + milestone.ID,\n-\t\t\t\tDescription: \"The exit gate of milestone:\" + rm.Slug + \"/\" + milestone.ID + \" holds: \" + milestone.ExitGate,\n+\t\t\t\tID:          milestoneExitGateCriterionID(rm.Slug, milestone.ID),\n+\t\t\t\tDescription: milestoneExitGateCriterionDescription(rm.Slug, milestone.ID, milestone.ExitGate),\n \t\t\t\tRequired:    true,\n \t\t\t\tKind:        ReviewCriterionKindJudgment,\n \t\t\t\tProfiles:    []string{\"milestone-exit-gate\"},\ndiff --git a/pose-mcp/internal/pose/roadmaps.go b/pose-mcp/internal/pose/roadmaps.go\nindex 54366f7e..dbc2c3ce 100644\n--- a/pose-mcp/internal/pose/roadmaps.go\n+++ b/pose-mcp/internal/pose/roadmaps.go\n@@ -22,10 +22,14 @@ type Roadmap struct {\n \tConsumes  []string `json:\"consumes,omitempty\"`\n \t// UnreviewedMilestones is the reason a roadmap gives for its reached milestones\n \t// standing without a review (ADR a-milestone-of-one-member-is-that-member).\n-\tUnreviewedMilestones string      `json:\"-\"`\n-\tMilestones           []Milestone `json:\"milestones\"`\n-\tPath                 string      `json:\"path\"`\n-\tBody                 string      `json:\"body,omitempty\"`\n+\tUnreviewedMilestones string `json:\"-\"`\n+\t// ADRs is the raw `adrs:` declaration, `[adr:<file>.md, …]`, read by the\n+\t// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n+\t// Raw so that a malformed declaration is unknown, not absent.\n+\tADRs       string      `json:\"-\"`\n+\tMilestones []Milestone `json:\"milestones\"`\n+\tPath       string      `json:\"path\"`\n+\tBody       string      `json:\"body,omitempty\"`\n }\n \n type Milestone struct {\n@@ -52,6 +56,22 @@ func (s Store) ReachedMilestones(spec string) ([]string, error) {\n \t\treturn nil, err\n \t}\n \treached := []string{}\n+\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil {\n+\t\treturn reached, err\n+\t} else if adopted {\n+\t\t// Under an adopted closeout review policy, only the explicit close\n+\t\t// makes a milestone terminal: reached means no receipt yet.\n+\t\tfor _, ref := range candidates {\n+\t\t\tclosed, err := s.closedByReceipt(ref)\n+\t\t\tif err != nil {\n+\t\t\t\treturn reached, err\n+\t\t\t}\n+\t\t\tif !closed {\n+\t\t\t\treached = append(reached, ref)\n+\t\t\t}\n+\t\t}\n+\t\treturn reached, nil\n+\t}\n \tfor _, ref := range candidates {\n \t\t// Its only member has just closed, uncommitted, so its verification cannot\n \t\t// answer yet: only a refusal recorded on the milestone says it will not stand.\n@@ -290,6 +310,10 @@ func (s Store) RoadmapsReachedBy(spec string) ([]string, error) {\n \t\treturn nil, err\n \t}\n \tfound := []string{}\n+\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || adopted {\n+\t\t// Adopted: a member's close leaves its milestone reached, never closed.\n+\t\treturn found, err\n+\t}\n \tfor _, rm := range roadmaps {\n \t\tfor _, milestone := range rm.Milestones {\n \t\t\tif member, ok := s.soleMemberOf(ScopeRef{Kind: \"milestone\", Roadmap: rm.Slug, Milestone: milestone.ID}); ok && member == spec {\n@@ -316,10 +340,20 @@ func (s Store) roadmapReachedApartFrom(slug, closing string) bool {\n \tif err != nil || rm.Status == \"done\" || len(rm.Milestones) == 0 {\n \t\treturn false\n \t}\n+\tadopted, err := s.closeoutReviewPolicyAdopted()\n+\tif err != nil {\n+\t\treturn false\n+\t}\n \tfor _, milestone := range rm.Milestones {\n \t\tif milestone.ID == closing {\n \t\t\tcontinue\n \t\t}\n+\t\tif adopted {\n+\t\t\tif closed, err := s.closedByReceipt(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !closed {\n+\t\t\t\treturn false\n+\t\t\t}\n+\t\t\tcontinue\n+\t\t}\n \t\tif approved, err := s.scopeApproved(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !approved {\n \t\t\treturn false\n \t\t}\n@@ -434,6 +468,8 @@ func parseRoadmapFile(files Files, path, slug string, includeBody bool) (*Roadma\n \t\t\trm.Consumes = parseInlineList(value)\n \t\tcase \"unreviewed_milestones\":\n \t\t\trm.UnreviewedMilestones = cleanValue(value)\n+\t\tcase \"adrs\":\n+\t\t\trm.ADRs = strings.TrimSpace(value)\n \t\t}\n \t}\n \tvar current *Milestone\n@@ -487,3 +523,8 @@ func parseRoadmapFile(files Files, path, slug string, includeBody bool) (*Roadma\n \t}\n \treturn rm, nil\n }\n+\n+func (s Store) closeoutReviewPolicyAdopted() (bool, error) {\n+\tpolicy, _, err := s.loadReviewPolicy()\n+\treturn policy.CloseoutReviewAdopted(), err\n+}\n","exit_code":0,"status":"completed"}}
