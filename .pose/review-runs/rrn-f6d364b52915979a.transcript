:\t\t\tt.Fatalf(\"a roadmap receipt survived a new cut criterion: %v\", err)\n793:\tt.Run(\"emitted receipts conform to the published schema\", func(t *testing.T) {\n797:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n801:\t\traw, _ := json.Marshal(receipt)\n804:\t\tschemaRaw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"schemas\", \"v1\", \"closeout-receipt.schema.json\"))\n818:\t\t\t\tt.Fatalf(\"receipt field %q is not in the published schema\", key)\n834:func TestCloseoutReviewPolicyRoundFour(t *testing.T) {\n835:\tt.Run(\"a dispensed multi-member milestone with an exit gate keeps its mode\", func(t *testing.T) {\n840:\t\t// Round 5 N19: the threshold decides, the gate adds no review.\n843:\t\t\tt.Fatalf(\"an exit gate forced the aggregate review under when-justified: %+v %v\", d, err)\n863:\t\t\tt.Fatalf(\"a historically approved milestone owes a receipt: %+v %v\", state, err)\n880:func TestCloseoutReviewPolicyRoundFive(t *testing.T) {\n886:\t\t\tt.Fatalf(\"a historically approved milestone is offered for close again: %v %v\", reached, err)\n889:\t\t\tt.Fatalf(\"the shared terminal projection does not recognise the historical closure: %v %v\", closed, err)\n892:\tt.Run(\"a merely reached milestone without a receipt is not closed\", func(t *testing.T) {\n895:\t\t\tt.Fatalf(\"a milestone with neither receipt nor historical approval reads closed: %v %v\", closed, err)\n898:\tt.Run(\"a receipt does not close a milestone whose consumed outcome is unavailable\", func(t *testing.T) {\n905:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n906:\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n914:\t\t\tt.Fatalf(\"a receipt with an unavailable dependency still reads closed: %v %v\", reached, err)\n918:\t\t\tt.Fatalf(\"without a bound resolver the dependency edges were not judged: %v %v\", closed, err)\n921:\tt.Run(\"the last open member carries a multi-member exit gate\", func(t *testing.T) {\n934:\t\t\t\t\treturn criterion.Description == \"The exit gate of milestone:program/two holds: both parts integrate\" && criterion.Required\n940:\t\t\tt.Fatal(\"the last open member does not carry the milestone's exit gate\")\n954:\tt.Run(\"an exempt multi-member milestone with an unjudged exit gate does not close\", func(t *testing.T) {\n963:\t\t\tt.Fatalf(\"an unjudged exit gate did not block the exempt close: required=%v blockers=%v\", state.Review.Required, state.Blockers)\n","exit_code":0,"status":"completed"}}
