{"type":"item.completed","item":{"id":"item_77","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '151,190p' pose-mcp/internal/pose/spec.go\"","aggregated_output":"func (s Store) GetSpec(slug string) (*Spec, error) {\n\tif err := ValidateSlug(slug); err != nil {\n\t\treturn nil, err\n\t}\n\tvar err error\n\ts, err = s.prepareReviewOperationRead()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif sp, handled, err := s.reviewViewSpec(slug); handled {\n\t\treturn sp, err\n\t}\n\tspecs, err := s.ListSpecs(\"\", \"\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar match *Spec\n\tfor i := range specs {\n\t\tif specs[i].Slug != slug {\n\t\t\tcontinue\n\t\t}\n\t\tif match != nil {\n\t\t\treturn nil, SpecIdentityConflictError{Slug: slug}\n\t\t}\n\t\tmatch = &specs[i]\n\t}\n\tif match == nil {\n\t\treturn nil, fmt.Errorf(\"pose: spec %q not found\", slug)\n\t}\n\treturn s.readListedSpec(*match)\n}\n\nfunc (s Store) readListedSpec(match Spec) (*Spec, error) {\n\tif within, err := artifactPathWithinObserved(s.fsys(), s.Root, match.Path); err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: spec containment unavailable: %s: %w\", match.Slug, err)\n\t} else if !within {\n\t\treturn nil, fmt.Errorf(\"pose: spec path escapes project: %s\", match.Slug)\n\t}\n\tvar full *Spec\n\tvar err error\n","exit_code":0,"status":"completed"}}
