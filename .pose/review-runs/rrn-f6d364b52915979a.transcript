{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'CloseoutReview|closeout' pose-mcp/internal/pose/spec.go pose-mcp/internal/pose/diagnostic_codes.go pose-mcp/internal/cli/doctor.go\"","aggregated_output":"pose-mcp/internal/cli/doctor.go:265:\tdiagnoseCloseoutReviewPolicy(root, add, text)\npose-mcp/internal/cli/doctor.go:941:\t// date, rules introduced after a closeout was recorded judge it anyway, and\npose-mcp/internal/cli/doctor.go:1579:// diagnoseCloseoutReviewPolicy reports open milestones and roadmaps that owe\npose-mcp/internal/cli/doctor.go:1580:// their own review under the adopted closeout review policy, because of the\npose-mcp/internal/cli/doctor.go:1581:// policy or of their composition (spec pose-closeout-review-policy-by-cost-benefit\npose-mcp/internal/cli/doctor.go:1583:func diagnoseCloseoutReviewPolicy(root string, add func(string, string, string, string), text func(string, string) string) {\npose-mcp/internal/cli/doctor.go:1586:\tif err != nil || !policy.CloseoutReviewAdopted() {\npose-mcp/internal/cli/doctor.go:1589:\towing, err := store.CloseoutReviewsOwed()\npose-mcp/internal/cli/doctor.go:1591:\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"open scopes owing a closeout review could not be listed: %v\", \"escopos abertos que devem revisão de fechamento não puderam ser listados: %v\"), err), text(\"run `pose closeout-check <scope>` for each open milestone and roadmap\", \"rode `pose closeout-check <escopo>` para cada milestone e roadmap aberto\"))\npose-mcp/internal/cli/doctor.go:1595:\t\tadd(\"closeout-review.owed\", \"ok\", fmt.Sprintf(text(\"no open scope owes a review it lacks (milestone_review_required=%s, roadmap_review_required=%s)\", \"nenhum escopo aberto deve uma revisão que não tem (milestone_review_required=%s, roadmap_review_required=%s)\"), policy.MilestoneReviewRequired, policy.RoadmapReviewRequired), \"\")\npose-mcp/internal/cli/doctor.go:1599:\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"%s owes its own review: %s=%s, %s; previous rule %s\", \"%s deve revisão própria: %s=%s, %s; regra anterior %s\"), item.Scope, item.Decision.PolicyKey, item.Decision.PolicyValue, item.Decision.Reason, item.Previous), item.Action)\npose-mcp/internal/pose/diagnostic_codes.go:29:\tDiagnosticCloseout  = \"closeout\"\npose-mcp/internal/pose/diagnostic_codes.go:50:\t\"child-scope-open\":                {DiagnosticCloseout, \"the child scope's closeout is terminal\"},\npose-mcp/internal/pose/diagnostic_codes.go:52:\t\"closeout-receipt-invalid\":        {DiagnosticCloseout, \"the closeout receipt of the scope is restored or its corruption is resolved; it is never overwritten\"},\npose-mcp/internal/pose/diagnostic_codes.go:53:\t\"closeout-review-unknown\":         {DiagnosticCloseout, \"every member and ADR association of the scope resolves, so the closeout review policy can decide\"},\npose-mcp/internal/pose/diagnostic_codes.go:54:\t\"closeout-receipt-gate-failed\":    {DiagnosticCloseout, \"the cut criteria the roadmap's closeout receipt stands for hold again\"},\npose-mcp/internal/pose/diagnostic_codes.go:56:\t\"closeout-receipt-incomplete\":     {DiagnosticCloseout, \"`pose close` verifies the inputs again and publishes the closeout receipt\"},\npose-mcp/internal/pose/diagnostic_codes.go:61:\t\"review-criterion-owed\":           {DiagnosticStart, \"the criterion is answered at closeout review\"},\npose-mcp/internal/pose/spec.go:71:\t// closeout review gate, for the gate's own question about the plan's\npose-mcp/internal/pose/spec.go:72:\t// effective independence (spec pose-closeout-review-policy-by-cost-benefit).\n","exit_code":0,"status":"completed"}}
