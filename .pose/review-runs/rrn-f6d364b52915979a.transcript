{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/usr/bin/bash -lc 'pose context --task spec:pose-closeout-review-policy-by-cost-benefit --json'","aggregated_output":"{\n  \"schema_version\": 1,\n  \"selected_project_id\": \"proj.pose-dist\",\n  \"selected_revision\": \"8ce963376d5825e714df8f8ee94e92e629cf77a2\",\n  \"task_ref\": \"xref:proj.pose-dist/spec:pose-closeout-review-policy-by-cost-benefit\",\n  \"authority\": {\n    \"project_id\": \"proj.pose-dist\",\n    \"kind\": \"spec\",\n    \"slug\": \"pose-closeout-review-policy-by-cost-benefit\"\n  },\n  \"coordinator_relation\": \"same-project-authority\",\n  \"task_resolution\": {\n    \"schema_version\": 1,\n    \"identity\": {\n      \"project_id\": \"proj.pose-dist\",\n      \"kind\": \"spec\",\n      \"slug\": \"pose-closeout-review-policy-by-cost-benefit\"\n    },\n    \"resolved\": true,\n    \"resolution_state\": \"resolved\",\n    \"status\": \"in-progress\",\n    \"source_revision\": \"8ce963376d5825e714df8f8ee94e92e629cf77a2\",\n    \"source_digest\": \"45153ec9ea5f302bc642d2e1b2bde5aa9c22df277b17984fc1e71365dc09143b\"\n  },\n  \"authority_revision\": \"8ce963376d5825e714df8f8ee94e92e629cf77a2\",\n  \"supported_contracts\": [\n    \"qualified-artifact-refs@1\",\n    \"spec-authority-transfer@1\",\n    \"federated-roadmap-acceptance@1\"\n  ],\n  \"context_revision\": \"837798b85a54df43eef2d0fae595b2421c031d0bc3ff4be4e70685e667ea50d3\"\n}\n","exit_code":0,"status":"completed"}}
