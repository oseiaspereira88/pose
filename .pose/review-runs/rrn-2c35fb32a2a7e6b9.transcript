 {\n+\t\t\tt.Fatalf(\"%s: limits %+v problems %v\", c.name, limits, problems)\n+\t\t}\n+\t}\n+\tindented := \"### Accepted limits\\n  - L1: An escape is open. Accepted because a shim covers it\\n  # of cases on Linux.\\n\"\n+\tif limits, problems := ParseAcceptedLimits(indented); len(limits) != 0 || !strings.Contains(strings.Join(problems, \";\"), \"heading inside a limit\") {\n+\t\tt.Fatalf(\"an indented heading under an indented marker: %+v %v\", limits, problems)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex d038610a..01a0e39c 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -401,7 +401,9 @@ func (s Store) ReviewPlan(ref string) (ReviewPlan, error) {\n \t\t}\n \t}\n \tplan.Projection = projectDeclaredReviewObligations(plan, scope, base, floor, overlays, context)\n-\tplan.AcceptedLimits = s.acceptedLimitsOf(scope)\n+\tvar limitProblems []string\n+\tplan.AcceptedLimits, limitProblems = s.acceptedLimitsAndProblemsOf(scope)\n+\tplan.Warnings = append(plan.Warnings, limitProblems...)\n \tplan.PlanDigest, err = digestReviewPlan(plan)\n \tif err != nil {\n \t\treturn ReviewPlan{}, err","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01PTeZB9ism69RWZawdcCHoJ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
