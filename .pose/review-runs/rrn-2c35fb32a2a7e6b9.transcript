{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013bAKfuzCNXoW6JZW3m5ouw","type":"tool_result","content":"52\t// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n53\t// It returns the limits and the problems that keep the section from being\n54\t// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n55\t// limit that does not say why it is accepted (\"Accepted because ...\" or\n56\t// \"Aceito porque ...\").\n57\tfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n58\t\tvar limits []ReviewAcceptedLimit\n59\t\tvar problems []string\n60\t\tin := false\n61\t\tseen := map[string]bool{}\n62\t\t// The section is read fail-closed (review rounds 8 to 10): it holds only\n63\t\t// limits, each one list item whose wrapped lines are indented deeper than\n64\t\t// its marker (also after a blank line). Any other line in the section\n65\t\t// (prose, a lazy unindented continuation, a nested list, a fence, another\n66\t\t// kind of item) is reported, and the limit it belongs to or follows is\n67\t\t// not sealed: the engine never seals a limit it may have read in part.\n68\t\t// Fenced blocks and HTML comments outside the section are not the spec's\n69\t\t// declarations, so examples there are never read.\n70\t\ttype entry struct {\n71\t\t\tid, text string\n72\t\t\tindent   int\n73\t\t\tbad      bool\n74\t\t}\n75\t\tvar entries []entry\n76\t\treport := func(line, why string) {\n77\t\t\tproblems = append(problems, \"accepted limits: \"+quoteLedgerText(strings.TrimSpace(line))+\" \"+why)\n78\t\t\tif len(entries) > 0 && !entries[len(entries)-1].bad {\n79\t\t\t\tentries[len(entries)-1].bad = true\n80\t\t\t}\n81\t\t}\n82\t\t// One pass over the raw text, so comments, fences and the section are\n83\t\t// read from the same lines (spec pose-review-declared-limits-followups\n84\t\t// D1; review round 1, N1–N4). Outside the section a comment hides what\n85\t\t// it holds, as Markdown does, and a marker in inline code opens none.\n86\t\t// Inside the section, and on its heading, any comment marker refuses the\n87\t\t// whole section: the engine never seals a limit a comment may have cut.\n88\t\trefused := false\n89\t\tinComment := false\n90\t\tfence := \"\"\n91\t\tfor _, raw := range strings.Split(body, \"\\n\") {\n92\t\t\tmarker := strings.Contains(raw, \"<!--\") || strings.Contains(raw, \"-->\")\n93\t\t\tif in && marker {\n94\t\t\t\tif !refused {\n95\t\t\t\t\tproblems = append(problems, \"accepted limits: the section holds an HTML comment marker; write the limits without comments\")\n96\t\t\t\t}\n97\t\t\t\trefused = true\n98\t\t\t\t_, inComment = visibleOutsideComments(raw, inComment)\n99\t\t\t\tcontinue\n100\t\t\t}\n101\t\t\tline := raw\n102\t\t\tif fence == \"\" {\n103\t\t\t\tvisible, still := visibleOutsideComments(raw, inComment)\n104\t\t\t\tinComment = still\n105\t\t\t\tline = visible\n106\t\t\t\tif marker && acceptedLimitsHeadingRE.MatchString(strings.TrimSpace(line)) {\n107\t\t\t\t\t// A comment on the section's own heading line.\n108\t\t\t\t\tproblems = append(problems, \"accepted limits: the section heading holds an HTML comment marker; write it without comments\")\n109\t\t\t\t\trefused = true\n110\t\t\t\t\tin = true\n111\t\t\t\t\tcontinue\n112\t\t\t\t}\n113\t\t\t}\n114\t\t\ttrimmed := strings.TrimSpace(line)\n115\t\t\tindent := len(line) - len(strings.TrimLeft(line, \" \\t\"))\n116\t\t\tif m := fenceMarker(trimmed); m != \"\" {\n117\t\t\t\tif in {\n118\t\t\t\t\treport(line, \"is a code fence; examples belong outside the section\")\n119\t\t\t\t}\n120\t\t\t\tswitch {\n121\t\t\t\tcase fence == \"\":\n122\t\t\t\t\tfence = m\n123\t\t\t\tcase m[0] == fence[0] && len(m) >= len(fence) && strings.TrimLeft(trimmed, m[:1]) == \"\":\n124\t\t\t\t\tfence = \"\"\n125\t\t\t\t}\n126\t\t\t\tcontinue\n127\t\t\t}\n128\t\t\tif fence != \"\" {\n129\t\t\t\tcontinue\n130\t\t\t}\n131\t\t\tif in && indent >= 1 && indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n132\t\t\t\t// An indented heading-like line inside the section: read as a\n133\t\t\t\t// heading it would end the section and cut a limit (R1; review\n134\t\t\t\t// round 1, N5).\n135\t\t\t\treport(line, \"is a heading inside a limit; write the limit as one item\")\n136\t\t\t\tcontinue\n137\t\t\t}\n138\t\t\tif indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n139\t\t\t\tin = acceptedLimitsHeadingRE.MatchString(trimmed)\n140\t\t\t\tcontinue\n141\t\t\t}\n142\t\t\tif !in || trimmed == \"\" {\n143\t\t\t\tcontinue\n144\t\t\t}\n145\t\t\t// A line indented under the current limit belongs to it: a list\n146\t\t\t// there is nested, anything else continues the limit.\n147\t\t\tunder := len(entries) > 0 && indent > entries[len(entries)-1].indent\n148\t\t\tif under && listItemRE.MatchString(trimmed) {\n149\t\t\t\treport(line, \"is a nested list; write the limit as one item\")\n150\t\t\t\tcontinue\n151\t\t\t}\n152\t\t\tif !under && indent <= 3 {\n153\t\t\t\tif m := acceptedLimitRE.FindStringSubmatch(trimmed); m != nil {\n154\t\t\t\t\tentries = append(entries, entry{id: m[1], text: strings.TrimSpace(m[2]), indent: indent})\n155\t\t\t\t\tcontinue\n156\t\t\t\t}\n157\t\t\t\tif listItemRE.MatchString(trimmed) {\n158\t\t\t\t\treport(line, \"is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n159\t\t\t\t\tentries = append(entries, entry{bad: true})\n160\t\t\t\t\tcontinue\n161\t\t\t\t}\n162\t\t\t}\n163\t\t\tif !under {\n164\t\t\t\treport(line, \"is neither a limit nor indented under one; the section holds only limits\")\n165\t\t\t\tcontinue\n166\t\t\t}\n167\t\t\tentries[len(entries)-1].text += \" \" + trimmed\n168\t\t}\n169\t\tif inComment {\n170\t\t\tproblems = append(problems, \"accepted limits: an unterminated HTML comment hides the rest of the spec\")\n171\t\t\treturn nil, problems\n172\t\t}\n173\t\tif refused {\n174\t\t\treturn nil, problems\n175\t\t}\n176\t\tfor _, e := range entries {\n177\t\t\tif e.id == \"\" {\n178\t\t\t\tcontinue\n179\t\t\t}\n180\t\t\tif seen[e.id] {\n181\t\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is declared twice\")\n182\t\t\t\tcontinue\n183\t\t\t}\n184\t\t\tseen[e.id] = true\n185\t\t\tif e.bad {\n186\t\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is not sealed: part of it could not be read\")\n187\t\t\t\tcontinue\n188\t\t\t}\n189\t\t\tif !hasAcceptedLimitReason(e.text) {\n190\t\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" does not say why it is accepted ('Accepted because ...')\")\n191\t\t\t\tcontinue\n192\t\t\t}\n193\t\t\tlimits = append(limits, ReviewAcceptedLimit{ID: e.id, Text: e.text})\n194\t\t}\n195\t\treturn limits, problems\n196\t}\n197\t\n198\tvar (\n199\t\t// acceptedLimitsHeadingRE is the heading of the accepted limits section.\n200\t\tacceptedLimitsHeadingRE = regexp.MustCompile(`(?i)^#{1,6}\\s+(accepted limits|limites aceitos)\\s*#*$`)\n201\t\tmarkdownHeadingRE       = regexp.MustCompile(`^#{1,6}(\\s|$)`)\n202\t\tlistItemRE              = regexp.MustCompile(`^([-*+]|[0-9]+[.)])(\\s|$)`)\n203\t)\n204\t\n205\t// fenceMarker returns the run of backticks or tildes that opens or closes a\n206\t// code fence on trimmed, or \"\". A backtick run followed by more backticks on\n207\t// the line is inline code, not a fence.\n208\tfunc fenceMarker(trimmed string) string {\n209\t\tfor _, c := range []string{\"`\", \"~\"} {\n210\t\t\tn := len(trimmed) - len(strings.TrimLeft(trimmed, c))\n211\t\t\tif n < 3 {\n212\t\t\t\tcontinue\n213\t\t\t}\n214\t\t\tif c == \"`\" && strings.Contains(trimmed[n:], \"`\") {\n215\t\t\t\treturn \"\"\n216\t\t\t}\n217\t\t\treturn trimmed[:n]\n218\t\t}\n219\t\treturn \"\"\n220\t}\n221\t\n222\t// acceptedLimitsOf collects the limits the scope's specs declare.\n223\tfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n224\t\tlimits, _ := s.acceptedLimitsAndProblemsOf(scope)\n225\t\treturn limits\n226\t}\n227\t\n228\t// acceptedLimitsAndProblemsOf is acceptedLimitsOf with the problems that kept\n229\t// limits from being sealed, so the plan says so (review round 1, N1).\n230\tfunc (s Store) acceptedLimitsAndProblemsOf(scope ScopeRef) ([]ReviewAcceptedLimit, []string) {\n231\t\tspecs, err := s.reviewScopeSpecs(scope)\n232\t\tif err != nil {\n233\t\t\treturn nil, nil\n234\t\t}\n235\t\tvar problems []string\n236\t\tfor _, spec := range specs {\n237\t\t\tif _, p := ParseAcceptedLimits(spec.Body); len(p) > 0 {\n238\t\t\t\tproblems = append(problems, \"accepted limits of spec \"+spec.Slug+\" are not all sealed: \"+strings.Join(p, \"; \"))\n239\t\t\t}\n240\t\t}\n241\t\treturn acceptedLimitsOfSpecs(specs), problems\n242\t}\n243\t\n244\t// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n245\t// by its spec when there is more than one spec.\n246\tfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n247\t\tvar out []ReviewAcceptedLimit\n248\t\tfor _, spec := range specs {\n249\t\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n250\t\t\tfor _, l := range limits {\n251\t\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n252\t\t\t\t// so a finding names exactly one sealed limit.\n253\t\t\t\tif len(specs) > 1 {\n254\t\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n255\t\t\t\t}\n256\t\t\t\tout = append(out, l)\n257\t\t\t}\n258\t\t}\n259\t\treturn out\n260\t}\n261\t\n262\t// sealedAcceptedLimit reports whether the bundle sealed limit id.\n263\tfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n264\t\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n265\t\t\tif l.ID == id {\n266\t\t\t\treturn true\n267\t\t\t}\n268\t\t}\n269\t\treturn false\n270\t}\n271\t\n272\t// htmlCommentStart returns the index in s, from from on, of the next \"<!--\"\n273\t// that opens an HTML comment, or -1. One written in inline code (an odd\n274\t// number of backticks before it on its line) opens nothing: Markdown shows\n275\t// it as text, as a spec that names the marker does (review of\n276\t// pose-review-declared-limits-followups: its own R2 named it).\n277\tfunc htmlCommentStart(s string, from int) int {\n278\t\tfor {\n279\t\t\tk := strings.Index(s[from:], \"<!--\")\n280\t\t\tif k < 0 {\n281\t\t\t\treturn -1\n282\t\t\t}\n283\t\t\tk += from\n284\t\t\tlineStart := strings.LastIndex(s[:k], \"\\n\") + 1\n285\t\t\tif strings.Count(s[lineStart:k], \"`\")%2 == 0 {\n286\t\t\t\treturn k\n287\t\t\t}\n288\t\t\tfrom = k + 4\n289\t\t}\n290\t}\n291\t\n292\t// visibleOutsideComments returns what of line Markdown shows outside HTML\n293\t// comments, and whether a comment is still open after it.\n294\tfunc visibleOutsideComments(line string, inComment bool) (string, bool) {\n295\t\tvar visible strings.Builder\n296\t\trest := line\n297\t\tfor rest != \"\" {\n298\t\t\tif inComment {\n299\t\t\t\tend := strings.Index(rest, \"-->\")\n300\t\t\t\tif end < 0 {\n301\t\t\t\t\treturn visible.String(), true\n302\t\t\t\t}\n303\t\t\t\trest = rest[end+3:]\n304\t\t\t\tinComment = false\n305\t\t\t\tcontinue\n306\t\t\t}\n307\t\t\tstart := htmlCommentStart(rest, 0)\n308\t\t\tif start < 0 {\n309\t\t\t\tvisible.WriteString(rest)\n310\t\t\t\tbreak\n311\t\t\t}\n312\t\t\tvisible.WriteString(rest[:start])\n313\t\t\trest = rest[start+4:]\n314\t\t\tinComment = true\n315\t\t}\n316\t\treturn visible.String(), inComment\n317\t}\n318\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"84c554d5-037e-41c9-a962-b5789cc0cee5","timestamp":"2026-11-27T13:12:26.028Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-f7649a2054/worktree/pose-mcp/internal/pose/accepted_limits.go","content":"// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n// It returns the limits and the problems that keep the section from being\n// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n// limit that does not say why it is accepted (\"Accepted because ...\" or\n// \"Aceito porque ...\").\nfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n\tvar limits []ReviewAcceptedLimit\n\tvar problems []string\n\tin := false\n\tseen := map[string]bool{}\n\t// The section is read fail-closed (review rounds 8 to 10): it holds only\n\t// limits, each one list item whose wrapped lines are indented deeper than\n\t// its marker (also after a blank line). Any other line in the section\n\t// (prose, a lazy unindented continuation, a nested list, a fence, another\n\t// kind of item) is reported, and the limit it belongs to or follows is\n\t// not sealed: the engine never seals a limit it may have read in part.\n\t// Fenced blocks and HTML comments outside the section are not the spec's\n\t// declarations, so examples there are never read.\n\ttype entry struct {\n\t\tid, text string\n\t\tindent   int\n\t\tbad      bool\n\t}\n\tvar entries []entry\n\treport := func(line, why string) {\n\t\tproblems = append(problems, \"accepted limits: \"+quoteLedgerText(strings.TrimSpace(line))+\" \"+why)\n\t\tif len(entries) > 0 && !entries[len(entries)-1].bad {\n\t\t\tentries[len(entries)-1].bad = true\n\t\t}\n\t}\n\t// One pass over the raw text, so comments, fences and the section are\n\t// read from the same lines (spec pose-review-declared-limits-followups\n\t// D1; review round 1, N1–N4). Outside the section a comment hides what\n\t// it holds, as Markdown does, and a marker in inline code opens none.\n\t// Inside the section, and on its heading, any comment marker refuses the\n\t// whole section: the engine never seals a limit a comment may have cut.\n\trefused := false\n\tinComment := false\n\tfence := \"\"\n\tfor _, raw := range strings.Split(body, \"\\n\") {\n\t\tmarker := strings.Contains(raw, \"<!--\") || strings.Contains(raw, \"-->\")\n\t\tif in && marker {\n\t\t\tif !refused {\n\t\t\t\tproblems = append(problems, \"accepted limits: the section holds an HTML comment marker; write the limits without comments\")\n\t\t\t}\n\t\t\trefused = true\n\t\t\t_, inComment = visibleOutsideComments(raw, inComment)\n\t\t\tcontinue\n\t\t}\n\t\tline := raw\n\t\tif fence == \"\" {\n\t\t\tvisible, still := visibleOutsideComments(raw, inComment)\n\t\t\tinComment = still\n\t\t\tline = visible\n\t\t\tif marker && acceptedLimitsHeadingRE.MatchString(strings.TrimSpace(line)) {\n\t\t\t\t// A comment on the section's own heading line.\n\t\t\t\tproblems = append(problems, \"accepted limits: the section heading holds an HTML comment marker; write it without comments\")\n\t\t\t\trefused = true\n\t\t\t\tin = true\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tindent := len(line) - len(strings.TrimLeft(line, \" \\t\"))\n\t\tif m := fenceMarker(trimmed); m != \"\" {\n\t\t\tif in {\n\t\t\t\treport(line, \"is a code fence; examples belong outside the section\")\n\t\t\t}\n\t\t\tswitch {\n\t\t\tcase fence == \"\":\n\t\t\t\tfence = m\n\t\t\tcase m[0] == fence[0] && len(m) >= len(fence) && strings.TrimLeft(trimmed, m[:1]) == \"\":\n\t\t\t\tfence = \"\"\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif fence != \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif in && indent >= 1 && indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n\t\t\t// An indented heading-like line inside the section: read as a\n\t\t\t// heading it would end the section and cut a limit (R1; review\n\t\t\t// round 1, N5).\n\t\t\treport(line, \"is a heading inside a limit; write the limit as one item\")\n\t\t\tcontinue\n\t\t}\n\t\tif indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n\t\t\tin = acceptedLimitsHeadingRE.MatchString(trimmed)\n\t\t\tcontinue\n\t\t}\n\t\tif !in || trimmed == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\t// A line indented under the current limit belongs to it: a list\n\t\t// there is nested, anything else continues the limit.\n\t\tunder := len(entries) > 0 && indent > entries[len(entries)-1].indent\n\t\tif under && listItemRE.MatchString(trimmed) {\n\t\t\treport(line, \"is a nested list; write the limit as one item\")\n\t\t\tcontinue\n\t\t}\n\t\tif !under && indent <= 3 {\n\t\t\tif m := acceptedLimitRE.FindStringSubmatch(trimmed); m != nil {\n\t\t\t\tentries = append(entries, entry{id: m[1], text: strings.TrimSpace(m[2]), indent: indent})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif listItemRE.MatchString(trimmed) {\n\t\t\t\treport(line, \"is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n\t\t\t\tentries = append(entries, entry{bad: true})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif !under {\n\t\t\treport(line, \"is neither a limit nor indented under one; the section holds only limits\")\n\t\t\tcontinue\n\t\t}\n\t\tentries[len(entries)-1].text += \" \" + trimmed\n\t}\n\tif inComment {\n\t\tproblems = append(problems, \"accepted limits: an unterminated HTML comment hides the rest of the spec\")\n\t\treturn nil, problems\n\t}\n\tif refused {\n\t\treturn nil, problems\n\t}\n\tfor _, e := range entries {\n\t\tif e.id == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif seen[e.id] {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is declared twice\")\n\t\t\tcontinue\n\t\t}\n\t\tseen[e.id] = true\n\t\tif e.bad {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is not sealed: part of it could not be read\")\n\t\t\tcontinue\n\t\t}\n\t\tif !hasAcceptedLimitReason(e.text) {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" does not say why it is accepted ('Accepted because ...')\")\n\t\t\tcontinue\n\t\t}\n\t\tlimits = append(limits, ReviewAcceptedLimit{ID: e.id, Text: e.text})\n\t}\n\treturn limits, problems\n}\n\nvar (\n\t// acceptedLimitsHeadingRE is the heading of the accepted limits section.\n\tacceptedLimitsHeadingRE = regexp.MustCompile(`(?i)^#{1,6}\\s+(accepted limits|limites aceitos)\\s*#*$`)\n\tmarkdownHeadingRE       = regexp.MustCompile(`^#{1,6}(\\s|$)`)\n\tlistItemRE              = regexp.MustCompile(`^([-*+]|[0-9]+[.)])(\\s|$)`)\n)\n\n// fenceMarker returns the run of backticks or tildes that opens or closes a\n// code fence on trimmed, or \"\". A backtick run followed by more backticks on\n// the line is inline code, not a fence.\nfunc fenceMarker(trimmed string) string {\n\tfor _, c := range []string{\"`\", \"~\"} {\n\t\tn := len(trimmed) - len(strings.TrimLeft(trimmed, c))\n\t\tif n < 3 {\n\t\t\tcontinue\n\t\t}\n\t\tif c == \"`\" && strings.Contains(trimmed[n:], \"`\") {\n\t\t\treturn \"\"\n\t\t}\n\t\treturn trimmed[:n]\n\t}\n\treturn \"\"\n}\n\n// acceptedLimitsOf collects the limits the scope's specs declare.\nfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n\tlimits, _ := s.acceptedLimitsAndProblemsOf(scope)\n\treturn limits\n}\n\n// acceptedLimitsAndProblemsOf is acceptedLimitsOf with the problems that kept\n// limits from being sealed, so the plan says so (review round 1, N1).\nfunc (s Store) acceptedLimitsAndProblemsOf(scope ScopeRef) ([]ReviewAcceptedLimit, []string) {\n\tspecs, err := s.reviewScopeSpecs(scope)\n\tif err != nil {\n\t\treturn nil, nil\n\t}\n\tvar problems []string\n\tfor _, spec := range specs {\n\t\tif _, p := ParseAcceptedLimits(spec.Body); len(p) > 0 {\n\t\t\tproblems = append(problems, \"accepted limits of spec \"+spec.Slug+\" are not all sealed: \"+strings.Join(p, \"; \"))\n\t\t}\n\t}\n\treturn acceptedLimitsOfSpecs(specs), problems\n}\n\n// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n// by its spec when there is more than one spec.\nfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n\tvar out []ReviewAcceptedLimit\n\tfor _, spec := range specs {\n\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n\t\tfor _, l := range limits {\n\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n\t\t\t// so a finding names exactly one sealed limit.\n\t\t\tif len(specs) > 1 {\n\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n\t\t\t}\n\t\t\tout = append(out, l)\n\t\t}\n\t}\n\treturn out\n}\n\n// sealedAcceptedLimit reports whether the bundle sealed limit id.\nfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n\t\tif l.ID == id {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// htmlCommentStart returns the index in s, from from on, of the next \"<!--\"\n// that opens an HTML comment, or -1. One written in inline code (an odd\n// number of backticks before it on its line) opens nothing: Markdown shows\n// it as text, as a spec that names the marker does (review of\n// pose-review-declared-limits-followups: its own R2 named it).\nfunc htmlCommentStart(s string, from int) int {\n\tfor {\n\t\tk := strings.Index(s[from:], \"<!--\")\n\t\tif k < 0 {\n\t\t\treturn -1\n\t\t}\n\t\tk += from\n\t\tlineStart := strings.LastIndex(s[:k], \"\\n\") + 1\n\t\tif strings.Count(s[lineStart:k], \"`\")%2 == 0 {\n\t\t\treturn k\n\t\t}\n\t\tfrom = k + 4\n\t}\n}\n\n// visibleOutsideComments returns what of line Markdown shows outside HTML\n// comments, and whether a comment is still open after it.\nfunc visibleOutsideComments(line string, inComment bool) (string, bool) {\n\tvar visible strings.Builder\n\trest := line\n\tfor rest != \"\" {\n\t\tif inComment {\n\t\t\tend := strings.Index(rest, \"-->\")\n\t\t\tif end < 0 {\n\t\t\t\treturn visible.String(), true\n\t\t\t}\n\t\t\trest = rest[end+3:]\n\t\t\tinComment = false\n\t\t\tcontinue\n\t\t}\n\t\tstart := htmlCommentStart(rest, 0)\n\t\tif start < 0 {\n\t\t\tvisible.WriteString(rest)\n\t\t\tbreak\n\t\t}\n\t\tvisible.WriteString(rest[:start])\n\t\trest = rest[start+4:]\n\t\tinComment = true\n\t}\n\treturn visible.String(), inComment\n}\n","numLines":267,"startLine":52,"totalLines":318}},"tool_result_meta":[{"id":"toolu_013bAKfuzCNXoW6JZW3m5ouw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
