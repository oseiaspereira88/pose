le, err := s.PrepareReviewBundle(ref)\n\tif err != nil {\n\t\treturn ReviewBundle{}, err\n\t}\n\tif len(bundle.Blockers) > 0 {\n\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", strings.Join(bundle.Blockers, \"; \"))\n\t}\n\tsealed, err := s.ListReviewBundles(bundle.Payload.Scope.Ref)\n\tif err != nil {\n\t\treturn ReviewBundle{}, err\n\t}\n\t// Content a sealed bundle already holds keeps the bundle that governs it,\n\t// unless a declared identity names another: then the new seal replaces\n\t// that bundle's identity by name, so it governs whatever the seal instants\n\t// say, and a historical identity declared again is a new seal, never the\n\t// historical bundle handed back (spec pose-delegation-routing D3).\n\tif governing := governingSealedBundle(sealed, bundle); governing != nil {\n\t\tif !declared || identity == nil || governing.Payload.Implementation != nil && sameImplementation(*governing.Payload.Implementation, *identity) {\n\t\t\treturn *governing, nil\n\t\t}\n\t\treplaced := *identity\n\t\treplaced.Replaces = governing.BundleID\n\t\tidentity = &replaced\n\t}\n\tif blockers := s.sealReadinessBlockers(bundle); len(blockers) > 0 {\n\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", strings.Join(blockers, \"; \"))\n\t}\n\t// A bundle already sealed reads as it was; a new seal holds a validation result,\n\t// whatever the lifecycle of the scope says.\n\tif !holdsValidationResult(bundle.Payload.Evidence) {\n\t\tscope, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n\t\tif err != nil {\n\t\t\treturn ReviewBundle{}, err\n}\n\n// validateBundleAttestationWithBody returns the source of the function that\n// judges an attestation against a sealed bundle.\nfunc validateBundleAttestationWithBody(t *testing.T) string {\n\tt.Helper()\n\tset := token.NewFileSet()\n\tfile, err := parser.ParseFile(set, \"review_bundle.go\", nil, 0)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar body bytes.Buffer\n\tfound := false\n\tfor _, declaration := range file.Decls {\n\t\tfn, ok := declaration.(*ast.FuncDecl)\n\t\tif !ok || (fn.Name.Name != \"validateBundleAttestationWith\" && fn.Name.Name != \"attestationContentBlockers\" && fn.Name.Name != \"reviewFindingDecisionBlockers\") {\n\t\t\tcontinue\n\t\t}\n\t\tif fn.Name.Name == \"validateBundleAttestationWith\" {\n\t\t\tfound = true\n\t\t}\n\t\tif err := format.Node(&body, set, fn); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tbody.WriteString(\"\\n\")\n\t}\n\tif !found {\n\t\tt.Fatal(\"validateBundleAttestationWith not found\")\n\t}\n\treturn body.String()\n}\n\nfunc TestOnlyTheSigningGateIsReadFromLivePolicy(t *testing.T) {\n\tbody := validateBundleAttestationWithBody(t)\n\tseen, err := livePolicyFields(body)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !seen[\"RequireSignedAttestations\"] {\n\t\tt.Error(\"the signing requirement is no longer read from the live policy — a bundle sealed before a project started requiring signatures is now permanently exempt from it\")\n\t}\n\tdelete(seen, \"RequireSignedAttestations\")\n\tif !seen[\"DelegatedReview\"] {\n\t\tt.Error(\"the delegated run proof bar is no longer read live; prefix-only identities could remain exempt after explicit opt-in\")\n\t}\n\tdelete(seen, \"DelegatedReview\")\n\tfor field := range seen {\n\t\tt.Errorf(\"policy.%s is read live while judging a sealed bundle: seal it into the bundle's gates, or record here why it is an additional explicit trust exception\", field)\n\t}\n}\n\n// The other side of the same contract: the gates a bundle carries are the ones\n// the validator consults. A gate added to the struct and never read is a\n// setting that seals and does nothing.\nfunc TestEverySealedGateIsConsulted(t *testing.T) {\n\tbody := validateBundleAttestationWithBody(t)\n\tfor _, gate := range []string{\"AllowApprovedWithReservations\", \"AcceptedRiskSeverities\", \"AllowCriterionReuse\"} {\n\t\tif !strings.Contains(body, \"SealedGates().\"+gate) {\n\t\t\tt.Errorf(\"%s is sealed into the bundle and never consulted while judging one\", gate)\n\t\t}\n\t}\n\ttext := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 2}, true, nil)\n\tfor _, phrase := range []string{\"the identifier listed under Findings to account for, which carries its round, for example R2-F1, never a bare F1\", \"a finding you report now takes an `id` that no earlier round used\"} {\n\t\tif !strings.Contains(text, phrase) {\n\t\t\tt.Errorf(\"the brief of round 2 does not state the rule behind \\\"prior finding id is not a unique carried identifier\\\": %q\", phrase)\n\t\t}\n\t}\n\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateConclusions, \"\", nil, &ReviewRound{Number: 2}, true, nil)\n\tif strings.Contains(earlier, \"never a bare F1\") {\n\t\tt.Error(\"review-brief/4 changed under its version: the rule belongs to review-brief/5 and later\")\n\t}\n}\n\n// Spec pose-review-readiness-before-seal R4: the current brief asks the\n// reviewer to check its draft before finishing; /7 never did.\nfunc TestTheCurrentBriefAsksForTheDraftCheck(t *testing.T) {\n\tconst step = \"pipe it to `\\\"$POSE_REVIEW_CLI\\\" review draft-check --draft -`\"\n\tcurrent := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n\tif !strings.Contains(current, step) {\n\t\tt.Fatal(\"the current review brief does not ask for the draft check\")\n\t}\n\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateAllNotApplicable, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n\tif strings.Contains(earlier, step) {\n\t\tt.Fatal(\"review-brief/7 changed under the runs briefed with it\")\n\t}\n}\npose-mcp/internal/pose/review_brief_versions_test.go:95:func TestEveryReviewBriefTemplateVersionRendersWhatItRenderedWhenItWasPublished(t *testing.T) {\npose-mcp/internal/pose/review_brief_versions_test.go:147:func TestTheDigestSeesEverySectionOfEveryVariant(t *testing.T) {\n13:This corpus belongs to developing POSE's governance. It adds no checklist to an\n56:| `canned-executor-approval-proves-cognition` | delegated | A complete canned approval from a trusted local command is presented as proof of review cognition or a vendor receipt (`cli/delegated_review_capability_test.go:TestDelegatedReviewCapabilityCannedApprovalDisclosesItsLimits` guards disclosure; the engine cannot detect canned judgments) | pose-delegated-review-capability |\nplan sha256:94c5e8ed0db62ef3b181346f2d2219dc8a2adde13bf37aaf466973e6266f49c0\nround 2\nopen ['R1-N1', 'R1-N2', 'R1-N3']\n","exit_code":0,"status":"completed"}}
