{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc \"git diff 3f63a1bb..5c35b3a8 -- pose-mcp/internal/pose/review_dispatch.go pose-mcp/internal/pose/review_bundle.go pose-mcp/internal/pose/review_brief.go pose-mcp/internal/cli/review_conclude.go pose-mcp/internal/cli/delegate.go; rg -n 'TemplateVersion|BriefDigest|renderReviewBriefAs' pose-mcp/internal/pose/review_run_provenance.go; cat pose-mcp/internal/cli/review_draft_check.go; rg -n 'Brief|Template' pose-mcp/internal/pose/review_run_provenance.go | tail -25\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc \"git diff 3f63a1bb..5c35b3a8 -- pose-mcp/internal/pose/review_dispatch.go pose-mcp/internal/pose/review_bundle.go pose-mcp/internal/pose/review_brief.go pose-mcp/internal/cli/review_conclude.go pose-mcp/internal/cli/delegate.go; rg -n 'TemplateVersion|BriefDigest|renderReviewBriefAs' pose-mcp/internal/pose/review_run_provenance.go; cat pose-mcp/internal/cli/review_draft_check.go; rg -n 'Brief|Template' pose-mcp/internal/pose/review_run_provenance.go | tail -25\"","aggregated_output":"diff --git a/pose-mcp/internal/cli/delegate.go b/pose-mcp/internal/cli/delegate.go\nindex 68bc3831..205aab97 100644\n--- a/pose-mcp/internal/cli/delegate.go\n+++ b/pose-mcp/internal/cli/delegate.go\n@@ -454,6 +454,11 @@ func cmdDelegatePurpose(root, purpose string, args []string, stdout, stderr io.W\n \t}\n \tnotes := \"\"\n \tif f.noteFile != \"\" {\n+\t\t// R5 of spec pose-review-readiness-before-seal: an oversized note is\n+\t\t// named with its size and the limit, not as a generic adapter file.\n+\t\tif info, err := os.Lstat(f.noteFile); err == nil && info.Mode().IsRegular() && info.Size() > posemodel.ReviewNotesMaxBytes {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, fmt.Errorf(\"the note file %s has %d bytes; implementer notes must be at most %d bytes: shorten it\", f.noteFile, info.Size(), posemodel.ReviewNotesMaxBytes))\n+\t\t}\n \t\traw, err := posemodel.ReadReviewAdapterFile(f.noteFile, posemodel.ReviewNotesMaxBytes)\n \t\tif err != nil {\n \t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\ndiff --git a/pose-mcp/internal/cli/review_conclude.go b/pose-mcp/internal/cli/review_conclude.go\nindex add10fc0..4fb97af5 100644\n--- a/pose-mcp/internal/cli/review_conclude.go\n+++ b/pose-mcp/internal/cli/review_conclude.go\n@@ -102,6 +102,11 @@ func delegateAutoConclude(store posemodel.Store, run posemodel.ReviewRun, err er\n \t\treturn\n \t}\n \tif conclusion == nil {\n+\t\t// R6 of spec pose-review-readiness-before-seal: a completed run that\n+\t\t// is not concluded automatically names the step that concludes it.\n+\t\tif next := delegateConcludeNextStep(store, run); next != \"\" {\n+\t\t\trender(stdout, stderr).Hint(next)\n+\t\t}\n \t\treturn\n \t}\n \tline := \"pose delegate: conclusion \" + conclusion.State\n@@ -113,3 +118,21 @@ func delegateAutoConclude(store posemodel.Store, run posemodel.ReviewRun, err er\n \t}\n \trender(stdout, stderr).Hint(line)\n }\n+\n+// delegateConcludeNextStep is the command that records the conclusion of a\n+// completed run nothing concluded, or \"\" when there is none to record.\n+func delegateConcludeNextStep(store posemodel.Store, run posemodel.ReviewRun) string {\n+\tif run.Status != posemodel.ReviewRunCompleted || run.RunID == \"\" {\n+\t\treturn \"\"\n+\t}\n+\tswitch run.Kind {\n+\tcase posemodel.ReviewBriefKindReview, posemodel.ReviewBriefKindAdjudication, posemodel.ReviewBriefKindSmoke:\n+\tdefault:\n+\t\treturn \"\"\n+\t}\n+\tcommand := \"pose review conclude \" + run.RunID\n+\tif policy, _, found, err := store.LoadDelegationPolicy(); err != nil || !found || policy.ConclusionsIssuer() == \"\" {\n+\t\tcommand += \" --issuer <name>\"\n+\t}\n+\treturn \"pose delegate: nothing concluded this run automatically; preview its conclusion with `\" + command + \"`, then record it with `\" + command + \" --apply`\"\n+}\ndiff --git a/pose-mcp/internal/pose/review_brief.go b/pose-mcp/internal/pose/review_brief.go\nindex 8b66ef79..a4f69b9b 100644\n--- a/pose-mcp/internal/pose/review_brief.go\n+++ b/pose-mcp/internal/pose/review_brief.go\n@@ -27,7 +27,7 @@ const (\n )\n \n var reviewBriefTemplates = map[string]string{\n-\tReviewBriefKindReview:       reviewBriefTemplateAllNotApplicable,\n+\tReviewBriefKindReview:       reviewBriefTemplateDraftCheck,\n \tReviewBriefKindAdjudication: adjudicationBriefTemplateTyped,\n \tReviewBriefKindSmoke:        smokeBriefTemplateTyped,\n }\n@@ -65,6 +65,10 @@ const (\n \t// reviewBriefTemplateAllNotApplicable is the current template: it also says that a draft\n \t// cannot dispense with every required criterion as not-applicable.\n \treviewBriefTemplateAllNotApplicable = \"review-brief/7\"\n+\t// reviewBriefTemplateDraftCheck is the current template: /7 plus the step\n+\t// that checks the draft with `pose review draft-check` before the run ends\n+\t// (spec pose-review-readiness-before-seal R4).\n+\treviewBriefTemplateDraftCheck = \"review-brief/8\"\n \t// reviewBriefTemplateConclusions asked for the typed conclusion and stated its rules,\n \t// without the identifiers of the findings of earlier rounds.\n \t// reviewBriefTemplateConclusions (/4) asked for the typed conclusion and stated the rules\n@@ -77,9 +81,15 @@ const (\n \treviewBriefTemplateFirst           = \"review-brief/1\"\n )\n \n+// reviewBriefFromAllNotApplicable reports /7 and the templates that keep its\n+// text and add to it.\n+func reviewBriefFromAllNotApplicable(template string) bool {\n+\treturn template == reviewBriefTemplateAllNotApplicable || template == reviewBriefTemplateDraftCheck\n+}\n+\n // reviewBriefAsksConclusion reports a template that asks for the typed conclusion.\n func reviewBriefAsksConclusion(template string) bool {\n-\treturn template == reviewBriefTemplateAllNotApplicable || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions || template == reviewBriefTemplateTypedConclusion\n+\treturn reviewBriefFromAllNotApplicable(template) || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions || template == reviewBriefTemplateTypedConclusion\n }\n \n // briefRulesTextV5 is the statement of the rules the conclusion is checked against that\n@@ -91,7 +101,7 @@ const briefRulesTextV5 = \"POSE checks the conclusion before it records it, and r\n // precondition is the completion of the review is answered deferred, the component scoping of\n // evidence, and what a mapping's basis is.\n func briefRulesText(template string, bundle ReviewBundle) string {\n-\tif template != reviewBriefTemplateRiskRules && template != reviewBriefTemplateAllNotApplicable {\n+\tif template != reviewBriefTemplateRiskRules && !reviewBriefFromAllNotApplicable(template) {\n \t\treturn briefRulesTextV5\n \t}\n \ttext := briefRulesTextV5\n@@ -101,7 +111,7 @@ func briefRulesText(template string, bundle ReviewBundle) string {\n \t}\n \ttext = strings.Replace(text, \"a recommended tool you did not run is `not-used` with a `rationale`;\", \"a recommended tool you did not run is `not-used` with a `rationale`; a required tool whose precondition is the completion of the review (`review-check`, `closeout-check`) cannot pass before your attestation: answer it `deferred` with a `rationale`;\", 1)\n \ttext = strings.Replace(text, \"which is recorded as an accepted risk, or the draft requests changes;\", \"which is recorded as an accepted risk only when its severity is one the sealed review policy accepts (\"+severities+\"), or the draft requests changes and any finding of another severity is fixed first;\", 1)\n-\tif template == reviewBriefTemplateAllNotApplicable {\n+\tif reviewBriefFromAllNotApplicable(template) {\n \t\ttext += \" (l) a draft that dispenses with every required criterion as `not-applicable` is refused: a scope whose whole plan is inapplicable is not reviewed by it;\"\n \t}\n \treturn text + \" (j) the `evidence` of a `passed` criterion is of a class the criterion asks for and, when the criterion or tool belongs to a component, of that component (the Sealed evidence list names the module of each ref); (k) the `basis` of a mapping is a requirement or decision id of the scope's spec, such as R1 or D1.\"\n@@ -110,14 +120,14 @@ func briefRulesText(template string, bundle ReviewBundle) string {\n // reviewBriefStatesRules reports a template that states the rules the conclusion is\n // checked against.\n func reviewBriefStatesRules(template string) bool {\n-\treturn template == reviewBriefTemplateAllNotApplicable || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions\n+\treturn reviewBriefFromAllNotApplicable(template) || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions\n }\n \n // reviewBriefEarlierTemplates are the review templates a run may have been\n // briefed with before the current one, newest first; a run briefed with one\n // is re-rendered with it to verify and to continue (the brief a run was sent\n // never changes under it).\n-var reviewBriefEarlierTemplates = []string{reviewBriefTemplateRiskRules, reviewBriefTemplateRoundIDs, reviewBriefTemplateConclusions, reviewBriefTemplateTypedConclusion, reviewBriefTemplateRounds, reviewBriefTemplateFirst}\n+var reviewBriefEarlierTemplates = []string{reviewBriefTemplateAllNotApplicable, reviewBriefTemplateRiskRules, reviewBriefTemplateRoundIDs, reviewBriefTemplateConclusions, reviewBriefTemplateTypedConclusion, reviewBriefTemplateRounds, reviewBriefTemplateFirst}\n \n // briefEarlierTemplates are, per kind, the templates a run may have been\n // briefed with before the current one, newest first.\n@@ -475,9 +485,12 @@ func renderReviewBriefBody(bundle ReviewBundle, kind, template, notes string, sm\n \t\t\tif reviewBriefStatesRules(template) {\n \t\t\t\tline(\"%d. %s\", next+2, briefRulesText(template, bundle))\n \t\t\t}\n+\t\t\tif template == reviewBriefTemplateDraftCheck {\n+\t\t\t\tline(\"%d. Before you finish, check your final message: pipe it to `\\\"$POSE_REVIEW_CLI\\\" review draft-check --draft -`, the engine that dispatched this run (it reads this run's bundle and round, writes nothing and works in a read-only sandbox) and fix every reason it reports. A draft it refuses is refused at conclusion, and the round is spent.\", next+3)\n+\t\t\t}\n \t\t}\n \t}\n-\tif template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateAllNotApplicable {\n+\tif template == reviewBriefTemplateRiskRules || reviewBriefFromAllNotApplicable(template) {\n \t\t// ParseReviewDraft refuses a draft whose `decision:` line outside the block disagrees\n \t\t// with the block, so the brief cannot say the outside is not read at all.\n \t\t// The last occurrence is the instruction of the step; an earlier one may be in the notes.\n@@ -495,7 +508,7 @@ func roundFields(round ReviewRound, template string) string {\n \tif round.Number < 2 {\n \t\treturn \"\"\n \t}\n-\tif template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateAllNotApplicable {\n+\tif template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateRiskRules || reviewBriefFromAllNotApplicable(template) {\n \t\treturn \", `prior_findings` (each with `id`, `status` and `evidence`, one for every finding of the previous round; the `id` is the identifier listed under Findings to account for, which carries its round, for example R2-F1, never a bare F1, and a finding you report now takes an `id` that no earlier round used, for example N1: a bare or reused identifier makes the whole draft unreadable) and `sweep` (what you swept)\"\n \t}\n \treturn \", `prior_findings` (each with `id`, `status` and `evidence`, one for every finding of the previous round) and `sweep` (what you swept)\"\ndiff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex c77e594c..8ba600c5 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -2134,6 +2134,9 @@ func (s Store) sealReviewBundle(ref string, identity *ReviewBundleImplementation\n \t\treplaced.Replaces = governing.BundleID\n \t\tidentity = &replaced\n \t}\n+\tif blockers := s.sealReadinessBlockers(bundle); len(blockers) > 0 {\n+\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", strings.Join(blockers, \"; \"))\n+\t}\n \t// A bundle already sealed reads as it was; a new seal holds a validation result,\n \t// whatever the lifecycle of the scope says.\n \tif !holdsValidationResult(bundle.Payload.Evidence) {\n@@ -3891,6 +3894,15 @@ func (s Store) validateBundleAttestationWith(bundle ReviewBundle, att ReviewAtte\n \t\t\t}\n \t\t}\n \t}\n+\treturn append(blockers, s.attestationContentBlockers(bundle, att, skipEvidenceSupport)...)\n+}\n+\n+// attestationContentBlockers judges what an attestation says about its bundle,\n+// apart from who signed it: criteria, mappings, findings, evidence and tools.\n+// It is the part a reviewer's draft can be checked against before the run\n+// ends (spec pose-review-readiness-before-seal R3).\n+func (s Store) attestationContentBlockers(bundle ReviewBundle, att ReviewAttestation, skipEvidenceSupport bool) []string {\n+\tblockers := []string{}\n \trequired := map[string]ReviewPlanCriterion{}\n \tfor _, criterion := range bundle.Payload.Plan.Criteria {\n \t\tif criterion.Required {\ndiff --git a/pose-mcp/internal/pose/review_dispatch.go b/pose-mcp/internal/pose/review_dispatch.go\nindex ac0fc598..88a753fa 100644\n--- a/pose-mcp/internal/pose/review_dispatch.go\n+++ b/pose-mcp/internal/pose/review_dispatch.go\n@@ -965,6 +965,22 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t// The reviewer works in a sealed checkout: diagnostics it runs must not\n \t// publish derived records into it (SealedCheckoutEnv).\n \tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n+\t// The reviewer checks its draft against the sealed bundle and the round\n+\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n+\t// context that cannot be built leaves the check unavailable, never the\n+\t// review.\n+\tif plan.Purpose == DelegationPurposeReview {\n+\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n+\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n+\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n+\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n+\t\t\t\t// engine that dispatched the run is the one that checks it.\n+\t\t\t\tif self, err := os.Executable(); err == nil {\n+\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t}\n \tcmd.Env = env\n \tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n \tcmd.Stdout, cmd.Stderr = combined, combined\n56:\tTemplateVersion       string        `json:\"template_version\"`\n219:\treturn &ReviewRunProvenance{ExecutionState: \"not-started\", SchemaVersion: 1, Project: review.AuthorityProject, Audience: review.AuthorityAudience, WorktreeDigest: digestBytes([]byte(plan.OriginWorktree)), Trust: policy.Provenance.Trust, Implementation: implementation, Reviewer: reviewer, ConfigDigest: digestBytes(raw), CommandTemplateDigest: digestBytes(argv), TemplateVersion: plan.Brief.TemplateVersion, PlannedWireDigest: digestBytes([]byte(plan.Brief.Text)), NotesDigest: digestBytes([]byte(plan.notes))}, nil\n508:\tbrief, e := s.RenderReviewBriefMatching(run.BundleID, run.Kind, run.BriefNotes, run.BriefDigest)\n523:\tif e != nil || brief.Digest != run.BriefDigest || p.PlannedWireDigest != digestBytes([]byte(brief.Text)) || p.TemplateVersion != brief.TemplateVersion || p.NotesDigest != digestBytes([]byte(run.BriefNotes)) {\npackage cli\n\nimport (\n\t\"io\"\n\t\"os\"\n\t\"strings\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nconst reviewDraftCheckUsage = \"pose review draft-check [<bundle-id|run-id>] --draft <file> [--json]\"\n\n// cmdReviewDraftCheck reports the reasons a draft would be refused at\n// conclusion, writing nothing (spec pose-review-readiness-before-seal R3).\nfunc cmdReviewDraftCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar bundleID, draftPath string\n\tjsonOut := false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--json\":\n\t\t\tjsonOut = true\n\t\tcase \"--draft\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"pose review draft-check: --draft needs a file\\nUsage: \"+reviewDraftCheckUsage)\n\t\t\t}\n\t\t\ti++\n\t\t\tdraftPath = args[i]\n\t\tdefault:\n\t\t\tif strings.HasPrefix(args[i], \"-\") || bundleID != \"\" {\n\t\t\t\treturn usageError(stderr, \"pose review draft-check: unexpected argument \"+args[i]+\"\\nUsage: \"+reviewDraftCheckUsage)\n\t\t\t}\n\t\t\tbundleID = args[i]\n\t\t}\n\t}\n\tif draftPath == \"\" {\n\t\treturn usageError(stderr, \"pose review draft-check: name the draft with --draft\\nUsage: \"+reviewDraftCheckUsage)\n\t}\n\tvar raw []byte\n\tvar err error\n\tif draftPath == \"-\" {\n\t\traw, err = io.ReadAll(io.LimitReader(os.Stdin, 4<<20))\n\t} else {\n\t\traw, err = os.ReadFile(draftPath)\n\t}\n\tif err != nil {\n\t\trender(stdout, stderr).Failure(\"pose review draft-check: \" + err.Error())\n\t\treturn 1\n\t}\n\tstore := cliGovernedStore(root)\n\tvar reasons []string\n\tcontextPath := os.Getenv(posemodel.ReviewDraftContextEnv)\n\tswitch {\n\tcase bundleID == \"\" && contextPath == \"\":\n\t\treturn usageError(stderr, \"pose review draft-check: name the bundle; only a delegated review provides it\\nUsage: \"+reviewDraftCheckUsage)\n\tcase contextPath != \"\" && bundleID == \"\":\n\t\tctx, err := posemodel.ReadReviewDraftContext(contextPath)\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose review draft-check: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n\t\t\treturn 1\n\t\t}\n\t\treasons = store.CheckReviewDraftIn(ctx, string(raw), time.Now())\n\tdefault:\n\t\treasons, err = store.CheckReviewDraft(bundleID, string(raw), time.Now())\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose review draft-check: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n\t\t\treturn 1\n\t\t}\n\t}\n\tif jsonOut {\n\t\twriteJSON(stdout, map[string]any{\"ok\": len(reasons) == 0, \"reasons\": nonNilStrings(reasons)})\n\t} else if len(reasons) == 0 {\n\t\trender(stdout, stderr).ContractLine(\"Draft check: the conclusion step would accept this draft.\")\n\t} else {\n\t\tout := render(stdout, stderr)\n\t\tout.ContractLine(\"Draft check: the conclusion step would refuse this draft:\")\n\t\tfor _, r := range reasons {\n\t\t\tout.ContractLine(\"  - \" + r)\n\t\t}\n\t}\n\tif len(reasons) > 0 {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc nonNilStrings(v []string) []string {\n\tif v == nil {\n\t\treturn []string{}\n\t}\n\treturn v\n}\n53:\tCommandTemplateDigest string        `json:\"command_template_digest\"`\n56:\tTemplateVersion       string        `json:\"template_version\"`\n219:\treturn &ReviewRunProvenance{ExecutionState: \"not-started\", SchemaVersion: 1, Project: review.AuthorityProject, Audience: review.AuthorityAudience, WorktreeDigest: digestBytes([]byte(plan.OriginWorktree)), Trust: policy.Provenance.Trust, Implementation: implementation, Reviewer: reviewer, ConfigDigest: digestBytes(raw), CommandTemplateDigest: digestBytes(argv), TemplateVersion: plan.Brief.TemplateVersion, PlannedWireDigest: digestBytes([]byte(plan.Brief.Text)), NotesDigest: digestBytes([]byte(plan.notes))}, nil\n508:\tbrief, e := s.RenderReviewBriefMatching(run.BundleID, run.Kind, run.BriefNotes, run.BriefDigest)\n523:\tif e != nil || brief.Digest != run.BriefDigest || p.PlannedWireDigest != digestBytes([]byte(brief.Text)) || p.TemplateVersion != brief.TemplateVersion || p.NotesDigest != digestBytes([]byte(run.BriefNotes)) {\n534:\tif p.CommandTemplateDigest != digestBytes(raw) {\n708:\tif run.BundleID != bundle.BundleID || run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.Kind != ReviewBriefKindReview || run.Status != ReviewRunCompleted || !assurance.CompleteReview || att.Reviewer != assurance.Reviewer.Principal {\n779:\treturn s.dispatchNoLongerGoverns(DispatchPlan{Bundle: bundle, Brief: ReviewBrief{Scope: run.Scope}, SealedCommit: run.SealedCommit, PolicyDigest: run.PolicyDigest})\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\nimport subprocess,os,json\nfor args in [[\\\"artifact-check\\\",\\\"--spec\\\",\\\"pose-review-readiness-before-seal\\\",\\\"--strict\\\",\\\"--json\\\"],[\\\"surface-check\\\",\\\"--spec\\\",\\\"pose-review-readiness-before-seal\\\",\\\"--strict\\\",\\\"--json\\\"]]:\n r=subprocess.run([os.environ[\\\"POSE_REVIEW_CLI\\\"]]+args,capture_output=True,text=True)\n print(\\\"COMMAND\\\", \\\" \\\".join(args),\\\"EXIT\\\",r.returncode)\n try:\n  d=json.loads(r.stdout)\n  print(json.dumps({k:v for k,v in d.items() if k in (\\\"findings\\\",\\\"spec\\\",\\\"claims\\\",\\\"observed\\\",\\\"blockers\\\") and k\"'!=\"findings\"})[:500])\n  print(json.dumps([x for x in d.get(\"findings\",[]) if x.get(\"spec\")==\"pose-review-readiness-before-seal\" or x.get(\"severity\") in (\"error\",\"critical\")])[:4000])\n except Exception:\n  print((r.stdout+r.stderr)[-3000:])\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
