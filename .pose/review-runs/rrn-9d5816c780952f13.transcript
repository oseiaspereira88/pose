\n\tfor version := range golden {\n\t\tif !inUse[version] {\n\t\t\tt.Errorf(\"%s has a recorded digest but is no longer a template a run may have been briefed with: runs briefed with it could not be verified or resumed; keep it in reviewBriefEarlierTemplates\", version)\n\t\t}\n\t}\n\tfor _, version := range briefTemplatesInUse() {\n\t\twant, ok := golden[version]\n\t\tif !ok {\n\t\t\tt.Errorf(\"%s has no golden digest: record it with UPDATE_BRIEF_GOLDEN=1 when the version is published, and never rewrite one\", version)\n\t\t\tcontinue\n\t\t}\n\t\tif got := briefTemplateDigest(version); got != want {\n\t\t\tt.Errorf(\"%s renders different text than when it was published (%s, was %s): runs briefed with it can no longer be re-rendered; a change to the text takes a new template version, and the old one keeps rendering\", version, got, want)\n\t\t}\n\t}\n}\n\n// The guard itself: every section of every variant is under the digest, two renderings agree\n// (also across a rebuilt bundle), and two versions never render the same text.\nfunc TestTheDigestSeesEverySectionOfEveryVariant(t *testing.T) {\n\ttext := renderFixedBriefs(reviewBriefTemplateConclusions)\n\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n\t}\n\tif runErr != nil && cmd.ProcessState == nil {\n\t\trun.Output, transcript = \"\", nil\n\t\tif run.Provenance != nil {\n\t\t\trun.Provenance.OutputComplete = false\n\t\t}\n\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n\t}\n\t// Raw provenance hashes above precede redaction; only complete, bounded\n\t// redacted channels can be retained. Partial boundaries can expose a secret.\n\tsafety.ExecutionCause = executionCause(ctx)\n\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n\t\tsafety.CaptureComplete = false\n\t}\n\tif !safety.CaptureComplete {\n\t\ttranscript = nil\n\t\trun.Output = \"\"\n\t\tif run.Provenance != nil {\n\t\t\trun.Provenance.OutputComplete = false\n\t\t}\n\t\tif terminationErr != nil {\n\t\t\treturn finish(ReviewRunFailed, \"process group termination failed; descendants may remain\")\n\t\t}\n\t\tsafety.ExecutionCause = \"capture-incomplete\"\n\t\treturn finish(ReviewRunFailed, \"adapter capture incomplete: stream/output limit or unsafe output file\")\n\t}\n\tcaptureStage := \"session/interrupt recognition\"\n\tstatus, failure, captureErr := s.classifyReviewInterruption(&run, plan, transcript, runErr, ctx.Err())\n\tif captureErr == nil {\n\t\tvar redactErr error\n\t\traw := transcript\n\t\tcaptureStage = \"stdout\"\n\t\ttranscript, redactErr = redactReviewCapture(transcript, secrets, run.sessionForRedaction, safety.StreamBytes)\n\t\tvar output []byte\n\t\tif redactErr == nil {\n\t\t\tcaptureStage = \"final output\"\n\t\t\toutput, redactErr = redactReviewCapture([]byte(run.Output), secrets, run.sessionForRedaction, safety.OutputBytes)\n\t\t}\n\t\trun.Output = string(output)\n\t\tif redactErr == nil && run.Events != \"\" {\n\t\t\tcaptureStage = \"normalized events\"\n\t\t\t// Events are parsed from the decoded stream, where a JSON escape no longer\n\t\t\t// hides a value: each text is redacted again after decoding.\n\t\t\trun.eventsBytes, redactErr = redactedDelegationEvents(run.Events, raw, run.Output, secrets, run.sessionForRedaction)\n\t\t}\n\t\tif redactErr != nil {\n\t\t\tcaptureErr = redactErr\n\t\t}\npose-mcp/internal/pose/governance_read_view_integration_test.go:522:\tif state := governanceReadViewIntegrationCoverage(deep, \"readiness\"); state != CoverageStateIncomplete {\npose-mcp/internal/pose/governance_read_view_integration_test.go:523:\t\tt.Fatalf(\"depth-limited readiness coverage = %q, want incomplete\", state)\npose-mcp/internal/pose/governance_read_view_integration_test.go:530:\t\tfoundLimit = foundLimit || obligation.Source.Producer == \"readiness\" && strings.Contains(obligation.Message, \"resolution-limit\")\npose-mcp/internal/pose/governance_read_view_integration_test.go:536:\t\tif coverage.Producer == \"readiness\" {\npose-mcp/in