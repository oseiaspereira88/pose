rement or constraint. When the plan\n \t// asks for mappings, every declared decision must be usable as one.\n-\tif structure := bundle.Payload.Plan.Structure; structure != nil && len(structure.Material) > 0 {\n+\tasksMapping := false\n+\tfor _, criterion := range bundle.Payload.Plan.Criteria {\n+\t\tasksMapping = asksMapping || criterion.Required && criterion.RequiresStructuralMapping\n+\t}\n+\tif structure := bundle.Payload.Plan.Structure; asksMapping && structure != nil && len(structure.Material) > 0 {\n \t\tns := s.reviewDesignBasisNamespace(scope)\n \t\tvar unreached []string\n \t\tfor id := range ns.Known {\ndiff --git a/pose-mcp/internal/pose/review_structure_test.go b/pose-mcp/internal/pose/review_structure_test.go\nindex 2deb34fa..b9cfc2fa 100644\n--- a/pose-mcp/internal/pose/review_structure_test.go\n+++ b/pose-mcp/internal/pose/review_structure_test.go\n@@ -380,10 +380,16 @@ func TestABMStructuralCausalityGovernsOnlySealedContracts(t *testing.T) {\n // refused at seal; the same scope without structural facts seals.\n func TestSealReadinessRefusesADecisionWithoutBasis(t *testing.T) {\n \tstore := causalityFixture(t)\n-\tstructure, _ := causalityInputs()\n+\tstructure, required := causalityInputs()\n \tvar bundle ReviewBundle\n \tbundle.Payload.Scope.Ref = \"spec:backend\"\n \tbundle.Payload.Plan.Structure = structure\n+\t// Material facts with no criterion that asks for their mapping: nothing\n+\t// is mapped, so nothing is refused (review round 1, N1).\n+\tif blockers := store.sealReadinessBlockers(bundle); len(blockers) != 0 {\n+\t\tt.Fatalf(\"a plan that asks for no mapping was refused: %v\", blockers)\n+\t}\n+\tbundle.Payload.Plan.Criteria = []ReviewPlanCriterion{required[\"design-causality\"], required[\"correctness\"]}\n \tblockers := store.sealReadinessBlockers(bundle)\n \tassertBlocker(t, blockers, \"decision basis D9 reaches no requirement or constraint\")\n \tassertBlocker(t, blockers, \"decision basis A9 reaches no requirement or constraint\")\ndiff --git a/pose-mcp/internal/pose/testdata/review_brief_template_digests.json b/pose-mcp/internal/pose/testdata/review_brief_template_digests.json\nindex cb522d64..e5e1adca 100644\n--- a/pose-mcp/internal/pose/testdata/review_brief_template_digests.json\n+++ b/pose-mcp/internal/pose/testdata/review_brief_template_digests.json\n@@ -6,5 +6,5 @@\n   \"review-brief/5\": \"sha256:3a8019cc31749e160d0d9b1d89a280581ca46eda48061db1ab5dd51a25bab3ce\",\n   \"review-brief/6\": \"sha256:cdfac24cfa83d18d44426f33213bece9a6b454d81b69a717666bb5cb84590082\",\n   \"review-brief/7\": \"sha256:75bee416b983c24f93b2cc8cf97a46dd971386a9a025b3b8386a93af48f8be27\",\n-  \"review-brief/8\": \"sha256:21ea4ec0141ab59638b95409c7ffe8983ae629da28ab21ad921a32034f99dc47\"\n+  \"review-brief/8\": \"sha256:dcd7d088e3edab7fed949acc383a4828e4fead69c9de49e565f9c5d0e4cd9f3b\"\n }\n\t\t\t\treturn fmt.Errorf(\"surface %s: a command must be non-empty and bounded\", sf.Ref)\n\t\t\t}\n\t\t}\n\t\tobserved[sf.Ref] = true\n\t}\n\taccounted := map[string]bool{}\n\tfor _, p := range d.PriorFindings {\n\t\tswitch {\n\t\tcase !reviewCarriedID.MatchString(p.ID) || accounted[p.ID]:\n\t\t\treturn fmt.Errorf(\"prior finding id %q is not a unique carried identifier\", p.ID)\n\t\tcase p.Status != PriorFindingFixed && p.Status != PriorFindingPartial && p.Status != PriorFindingNotFixed && p.Status != PriorFindingSuperseded:\n\t\t\treturn fmt.Errorf(\"prior finding %s: status %q is not fixed, partial, not-fixed or superseded\", p.ID, p.Status)\n\t\tcase len(p.Evidence) > reviewDraftMaxText:\n\t\t\treturn fmt.Errorf(\"prior finding %s: evidence exceeds its bound\", p.ID)\n\t\t}\n\t\taccounted[p.ID] = true\n\t}\n\treturn nil\n}\n\n// ReviewOpenFinding is a finding a round must account for: its identity\n// across rounds, the round it was first reported in, its details and, when it\n// was carried, the account the last round gave it (R2, R5).\ntype ReviewOpenFinding struct {\n\tID          string\n\tRound       int\n\tSeverity    string\n\tDisposition string\n\tFile        string\n\tLine        int\n\tSummary     string\n\tCarried     string\n}\n\n// ReviewRound is the round a bundle is in and what it must account for.\ntype ReviewRound struct {\n\tNumber int\n\t// Prior is the run that concluded the round before, nil in round 1.\n\tPrior       *ReviewRun\n\tPriorBundle *ReviewBundle\n\t// Open are the findings this round must account for.\n\tOpen []ReviewOpenFinding\n\t// Broken names the drafts of the chain that could not be read: a round\n\t// after one opens a new session; its open findings stay open.\n\tBroken string\n}\n\n// roundFindingID is the identity a finding gets when first reported in round.\nfunc roundFindingID(round int, id string) string {\n\treturn fmt.Sprintf(\"R%d-%s\", round, id)\n}\n\n// concludingReviewRun is the run a round concluded with on bundle: of the\n// completed review runs of it that no run supersedes, the one that ended\n// last, the run id breaking a tie (review round 2, R2-F1).\nfunc concludingReviewRun(runs []ReviewRun, bundleID string) *ReviewRun {\n\tvar out *ReviewRun\n\tvar outEnded time.Time\n\tfor i := range runs {\n\t\tr := &runs[i]\n\t\tif r.BundleID != bundleID || r.Kind != ReviewBriefKindReview || r.Status != ReviewRunCompleted || r.SupersededBy != \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tended, _ := time.Parse(time.RFC3339Nano, r.EndedAt)\n\t\tif out == nil || ended.After(outEnded) || ended.Equal(outEnded) && r.RunID > out.RunID {\n\t\t\tout, outEnded = r, ended\n\t\t}\n\t}\n\treturn out\n}\n\n// ReviewRoundOf derives the round of bundle from the sealed bundles of its\n// scope and the run history (R1). A history or a bundle inventory with a loss\n// that may concern the scope, a previous round whose record is not intact,\n// or a run of the scope whose bundle is missing make it fail: a round is\n// never silently lowered (security; review round 1, B9).\nfunc (s Store) ReviewRoundOf(bundle ReviewBundle) (ReviewRound, error) {\n\truns, lost, err := s.ReadReviewRuns(\"\")\n\tif err != nil {\n\t\treturn ReviewRound{}, err\n\t}\n\tif len(lost) > 0 {\n\t\treturn ReviewRound{}, fmt.Errorf(\"pose: the review run history is incomplete, so the round of %s cannot be derived: %v\", bundle.BundleID, lost)\n\t}\n\tscope := bundle.Payload.Scope.Ref\n\tread, err := s.ReadReviewBundles(scope)\n\tif err != nil {\n\t\treturn ReviewRound{}, err\n\t}\n\tfor _, loss := range read.Coverage.Losses {\n\t\tif loss.Scope == \"\" || loss.Scope == scope || loss.Scope == bundle.Payload.Scope.Slug {\n\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: a sealed bundle that may belong to %s could not be read (%s), so its round cannot be derived\", scope, loss.Artifact)\n\t\t}\n\t}\n\tpresent := map[string]bool{}\n\tfor _, b := range read.Bundles {\n\t\tpresent[b.BundleID] = true\n\t}\n\tfor _, r := range runs {\n\t\tif r.Scope == scope && r.Kind == ReviewBriefKindReview && r.Status == ReviewRunCompleted && !present[r.BundleID] && r.BundleID != bundle.BundleID {\n\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s reviewed bundle %s of %s, which is missing, so the round cannot be derived\", r.RunID, r.BundleID, scope)\n\t\t}\n\t}\n\treturn reviewRoundFrom(bundle, read.Bundles, runs, s.reviewRunTranscriptIntact)\n}\n\n// reviewRoundFrom derives the round of bundle from bundles and runs; intact\n// says why a run's record is not intact, or \"\".\nfunc reviewRoundFrom(bundle ReviewBundle, bundles []ReviewBundle, runs []ReviewRun, intact func(ReviewRun) string) (ReviewRound, error) {\n\ttype concluded struct {\n\t\tbundle ReviewBundle\n\t\trun    *ReviewRun\n\t\tended  time.Time\n\t}\n\t// A round precedes bundle when its concluding run ended no later than the\n\t// second bundle was sealed in: a bundle is sealed after the rejection it\n\t// answers. Seals have second precision, runs nanoseconds, so the runs, as\n\t// instants, order the chain (D4; review round 1, B3).\n\tsealed, sealErr := time.Parse(time.RFC3339, bundle.SealedAt)\n\tvar chain []concluded\n\tfor _, b := range bundles {\n\t\tif b.BundleID == bundle.BundleID || b.BundleDigest == bundle.BundleDigest {\n\t\t\tcontinue\n\t\t}\n\t\trun := concludingReviewRun(runs, b.BundleID)\n\t\tif run == nil {\n\t\t\tcontinue\n\t\t}\n\t\tended, err := time.Parse(time.RFC3339Nano, run.EndedAt)\n\t\tif err != nil {\n\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s records no valid end, so the order of the rounds cannot be derived\", run.RunID)\n\t\t}\n\t\tif bundle.SealedAt != \"\" && sealErr == nil && ended.Truncate(time.Second).After(sealed) {\n\t\t\tcontinue\n\t\t}\n\t\tchain = append(chain, concluded{b, run, ended})\n\t}\n\tsort.SliceStable(chain, func(i, j int) bool {\n\t\tif !chain[i].ended.Equal(chain[j].ended) {\n\t\t\treturn chain[i].ended.Before(chain[j].ended)\n\t\t}\n\t\treturn chain[i].run.RunID < chain[j].run.RunID\n\t})\n\tround := ReviewRound{Number: len(chain) + 1}\n\tvar open []ReviewOpenFinding\n\tvar broken []string\n\tfor i, c := range chain {\n\t\tnumber := i + 1\n\t\tif why := intact(*c.run); why != \"\" {\n\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: the run of round %d (%s) is not intact, so its findings cannot be carried: %s\", number, c.run.RunID, why)\n\t\t}\n\t\tdraft, err := ParseReviewDraft(c.run.Output)\n\t\tif draft == nil || err != nil {\n\t\t\twhy := \"it carries no pose-draft block\"\n\t\t\tif err != nil {\n\t\t\t\twhy = err.Error()\n\t\t\t}\n\t\t\t// What this round said cannot be read: nothing is added, and\n\t\t\t// nothing open is closed (review round 1, B1).\n\t\t\tbroken = append(broken, fmt.Sprintf(\"the draft of round %d (%s) cannot be read: %s\", number, c.run.RunID, why))\n\t\t\tcontinue\n\t\t}\n\t\taccounted := map[string]ReviewDraftPrior{}\n\t\tfor _, p := range draft.PriorFindings {\n\t\t\taccounted[p.ID] = p\n\t\t}\n\t\t// A finding leaves the open set only when this round reported it\n\t\t// fixed with evidence, or superseded; unaccounted or unevidenced, it\n\t\t// stays open, so an invalid account never closes it (B1).\n\t\tvar next []ReviewOpenFinding\n\t\tfor _, f := range open {\n\t\t\tp, ok := accounted[f.ID]\n\t\t\tswitch {\n\t\t\tcase !ok:\n\t\t\t\tf.Carried = \"unaccounted\"\n\t\t\tcase p.Status == PriorFindingFixed && strings.TrimSpace(p.Evidence) == \"\":\n\t\t\t\tf.Carried = \"fixed-without-evidence\"\n\t\t\tcase p.Status == PriorFindingFixed || p.Status == PriorFindingSuperseded:\n\t\t\t\tcontinue\n\t\t\tdefault:\n\t\t\t\tf.Carried = p.Status\n\t\t\t}\n\t\t\tnext = append(next, f)\n\t\t}\n\t\tfor _, f := range draft.Findings {\n\t\t\tnext = append(next, ReviewOpenFinding{ID: roundFindingID(number, f.ID), Round: number, Severity: f.Severity, Disposition: f.Disposition, File: f.File, Line: f.Line, Summary: f.Summary})\n\t\t}\n\t\topen = next\n\t}\n\tif len(chain) > 0 {\n\t\tlast := chain[len(chain)-1]\n\t\tround.Prior, round.PriorBundle = last.run, &last.bundle\n\t}\n\tround.Open, round.Broken = open, strings.Join(broken, \"; \")\n\treturn round, nil\n}\npackage cli\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\n// Spec pose-review-readiness-before-seal R3: draft-check reports what the\n// conclusion step would refuse, before the run ends, and writes nothing.\nfunc TestReviewDraftCheckMatchesTheConclusionStep(t *testing.T) {\n\tcontextCopy := filepath.Join(t.TempDir(), \"context.json\")\n\troot, draftPath, bundleID := cliProvenanceInstance(t, func(root, draftPath string) {\n\t\treviewers := posemodel.ReviewersPolicy{SchemaVersion: 1, Provenance: &posemodel.ReviewRunProvenancePolicy{Trust: \"executor-attested\", Implementation: posemodel.ModelIdentity{Principal: \"agent:implementer\", Execution: \"implementation-fixture\", Vendor: \"openai\", Model: \"implementation-model\"}}, Adapters: map[string]posemodel.ReviewerAdapter{\"fake\": {Executor: \"agent:reviewer\", Command: []string{\"sh\", \"-c\", \"cat >/dev/null; cp \\\"$POSE_REVIEW_DRAFT_CONTEXT\\\" '\" + contextCopy + \"'; printf %s \\\"$POSE_REVIEW_CLI\\\" > '\" + contextCopy + \".cli'; cat '\" + draftPath + \"'\"}, Vendor: \"openai\", Model: \"review-model\"}}}\n\t\traw, _ := json.Marshal(reviewers)\n\t\twriteCloseoutCLIFile(t, root, \".pose/policy/reviewers.json\", string(raw))\n\t})\n\ts := posemodel.Store{Root: root}\n\twriteRunConclusion(t, s, bundleID, draftPath)\n\tif code, out := runPose(t, root, \"review\", \"draft-check\", bundleID, \"--draft\", draftPath); code != 0 || !strings.Contains(out, \"would accept\") {\n\t\tt.Fatalf(\"a draft the conclusion accepts was refused: %d %s\", code, out)\n\t}\n\n\t// A criterion citing evidence the bundle did not seal, and a new finding\n\t// carrying a round prefix: both refused, by the same words conclude uses.\n\tgood, _ := os.ReadFile(draftPath)\n\tbad := strings.Replace(string(good), \"integration:val-alpha\", \"integration:val-missing\", 1)\n\tbadPath := filepath.Join(t.TempDir(), \"bad.txt\")\n\tif err := os.WriteFile(badPath, []byte(bad), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcode, out := runPose(t, root, \"review\", \"draft-check\", bundleID, \"--draft\", badPath, \"--json\")\n\tvar report struct {\n\t\tOK      bool     `json:\"ok\"`\n\t\tReasons []string `json:\"reasons\"`\n\t}\n\tif code == 0 || json.Unmarshal([]byte(out), &report) != nil || report.OK || len(report.Reasons) == 0 || !strings.Contains(strings.Join(report.Reasons, \" \"), \"the attestation preflight refuses it\") {\n\t\tt.Fatalf(\"a draft the preflight refuses passed the draft check: %d %s\", code, out)\n\t}\n\n\t// Inside a delegated review, the run provides the bundle and the round.\n\tif code, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\"); code != 0 {\n\t\tt.Fatal(code, out)\n\t}\n\tif _, err := os.Stat(contextCopy); err != nil {\n\t\tt.Fatalf(\"the dispatch named no draft context: %v\", err)\n\t}\n\tif cli, _ := os.ReadFile(contextCopy + \".cli\"); len(cli) == 0 {\n\t\tt.Fatal(\"the dispatch named no review CLI\")\n\t}\n\t// A run id selects its bundle (review round 1, N2).\n\truns, _, _ := s.ReadReviewRuns(\"\")\n\tif code, out := runPose(t, root, \"review\", \"draft-check\", runs[0].RunID, \"--draft\", badPath); code == 0 || !strings.Contains(out, \"would refuse\") {\n\t\tt.Fatalf(\"a run id did not select its bundle: %d %s\", code, out)\n\t}\n\tt.Setenv(posemodel.ReviewDraftContextEnv, contextCopy)\n\tif code, out := runPose(t, root, \"review\", \"draft-check\", \"--draft\", badPath); code == 0 || !strings.Contains(out, \"would refuse\") {\n\t\tt.Fatalf(\"the run's context did not judge the draft: %d %s\", code, out)\n\t}\n\tif code, out := runPose(t, root, \"review\", \"draft-check\", \"--draft\", draftPath); code != 0 {\n\t\tt.Fatalf(\"the run's context refused a good draft: %d %s\", code, out)\n\t}\n\t// From standard input, as a read-only sandbox can only offer it.\n\tt.Setenv(posemodel.ReviewDraftContextEnv, \"\")\n\tstdin, _ := os.Open(badPath)\n\tdefer stdin.Close()\n\tsaved := os.Stdin\n\tos.Stdin = stdin\n\tcode, out = runPose(t, root, \"review\", \"draft-check\", bundleID, \"--draft\", \"-\")\n\tos.Stdin = saved\n\tif code == 0 || !strings.Contains(out, \"would refuse\") {\n\t\tt.Fatalf(\"a draft on standard input was not judged: %d %s\", code, out)\n\t}\n\t_ = time.Now\n}\n\n// The same refusal at the conclusion step, so the check cannot drift from it.\nfunc TestReviewDraftCheckRefusalIsTheConclusionRefusal(t *testing.T) {\n\troot, draftPath, bundleID := cliProvenanceInstance(t)\n\ts := posemodel.Store{Root: root}\n\twriteRunConclusion(t, s, bundleID, draftPath)\n\tgood, _ := os.ReadFile(draftPath)\n\tif err := os.WriteFile(draftPath, []byte(strings.Replace(string(good), \"integration:val-alpha\", \"integration:val-missing\", 1)), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, checked := runPose(t, root, \"review\", \"draft-check\", bundleID, \"--draft\", draftPath, \"--json\")\n\tif code, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\"); code != 0 {\n\t\tt.Fatal(code, out)\n\t}\n\truns, _, _ := s.ReadReviewRuns(\"\")\n\tcode, concluded := runPose(t, root, \"review\", \"conclude\", runs[0].RunID, \"--issuer\", \"fixture-executor\", \"--apply\")\n\tif code == 0 {\n\t\tt.Fatalf(\"conclude accepted the draft: %s\", concluded)\n\t}\n\tvar report struct{ Reasons []string }\n\t_ = json.Unmarshal([]byte(checked), &report)\n\tfor _, r := range report.Reasons {\n\t\tfor _, part := range strings.Split(strings.TrimPrefix(r, \"the attestation preflight refuses it: \"), \"; \") {\n\t\t\tif !strings.Contains(concluded, part) {\n\t\t\t\tt.Fatalf(\"draft-check reported %q, which conclude did not: %s\", part, concluded)\n\t\t\t}\n\t\t}\n\t}\n}\n\n// Spec pose-review-readiness-before-seal R5, R6: an oversized note is named\n// with its size and the limit; a completed run nothing concluded names the\n// command that concludes it.\nfunc TestDelegateNamesTheNoteLimitAndTheConclusionStep(t *testing.T) {\n\troot, draftPath, bundleID := cliProvenanceInstance(t)\n\ts := posemodel.Store{Root: root}\n\twriteRunConclusion(t, s, bundleID, draftPath)\n\tnote := filepath.Join(t.TempDir(), \"note.md\")\n\tif err := os.WriteFile(note, []byte(strings.Repeat(\"n\", int(posemodel.ReviewNotesMaxBytes)+1)), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcode, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\", \"--note-file\", note)\n\tif code == 0 || !strings.Contains(out, \"implementer notes must be at most\") || !strings.Contains(out, note) {\n\t\tt.Fatalf(\"an oversized note was not named: %d %s\", code, out)\n\t}\n\tcode, out = runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\")\n\truns, _, _ := s.ReadReviewRuns(\"\")\n\tif code != 0 || len(runs) != 1 || !strings.Contains(out, \"pose review conclude \"+runs[0].RunID+\" --issuer <name> --apply\") {\n\t\tt.Fatalf(\"the conclusion step was not named: %d %s\", code, out)\n\t}\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/usr/bin/bash -lc '\"$POSE_REVIEW_CLI\" context --task spec:pose-review-readiness-before-seal --json; \"$POSE_REVIEW_CLI\" suggest review --path pose-mcp; cat .pose/workflows/review.md .pose/rules/backend-go.md .pose/rules/security.md .pose/rules/documentation-style.md .pose/adr/2026-11-23-review-readiness-before-seal.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/usr/bin/bash -lc '\"$POSE_REVIEW_CLI\" context --task spec:pose-review-readiness-before-seal --json; \"$POSE_REVIEW_CLI\" suggest review --path pose-mcp; cat .pose/workflows/review.md .pose/rules/backend-go.md .pose/rules/security.md .pose/rules/documentation-style.md .pose/adr/2026-11-23-review-readiness-before-seal.md'","aggregated_output":"{\n  \"schema_version\": 1,\n  \"selected_project_id\": \"proj.pose-dist\",\n  \"selected_revision\": \"5c35b3a8606998283606aec34881b3959145576f\",\n  \"task_ref\": \"xref:proj.pose-dist/spec:pose-review-readiness-before-seal\",\n  \"authority\": {\n    \"project_id\": \"proj.pose-dist\",\n    \"kind\": \"spec\",\n    \"slug\": \"pose-review-readiness-before-seal\"\n  },\n  \"coordinator_relation\": \"same-project-authority\",\n  \"task_resolution\": {\n    \"schema_version\": 1,\n    \"identity\": {\n      \"project_id\": \"proj.pose-dist\",\n      \"kind\": \"spec\",\n      \"slug\": \"pose-review-readiness-before-seal\"\n    },\n    \"resolved\": true,\n    \"resolution_state\": \"resolved\",\n    \"status\": \"in-progress\",\n    \"source_revision\": \"5c35b3a8606998283606aec34881b3959145576f\",\n    \"source_digest\": \"3b3eaa1112eb65929298f2167ea2e9248d5856f3360658d7309c7b31e87e1af3\"\n  },\n  \"authority_revision\": \"5c35b3a8606998283606aec34881b3959145576f\",\n  \"supported_contracts\": [\n    \"qualified-artifact-refs@1\",\n    \"spec-authority-transfer@1\",\n    \"federated-roadmap-acceptance@1\"\n  ],\n  \"context_revision\": \"99f265df7d8b640336dc452f51c043ced2ec97dbcc3c9a532e7b257ec86f4e64\"\n}\n# POSE trail — review\n\nAvaliação técnica de PR/diff: escopo, contratos, segurança, validação.\n- Path:      pose-mcp → domain: backend-go (repo-map)\n- Workflow:  .pose/workflows/review.md\n- Skill:     pose-review\n- Rules:     .pose/rules/security.md, .pose/rules/documentation-style.md, .pose/rules/backend-go.md\n- Spec:      false\n- ADR:       false\n- Knowledge: consume=true, produce=handoff (quando aceitar risco residual ou condicionar merge)\n- Validation: exigir evidência de pose validate do implementador\n# Workflow: Review\n\n## Objective\n\nVerify that a change is correct, production-safe, and aligned with its approved scope and specs.\n\n## Preconditions\n\n- Make the final diff readable through cohesive commits or batches.\n- Provide requirement and spec context.\n- Attach implementer validation evidence, including `pose validate` output.\n- Define acceptance criteria and expected risk.\n\n## Execution checklist\n\n1. Resolve `pose review bundle <scope> --explain` (or `pose_review_bundle`) when bundle policy is enabled; otherwise resolve `pose review-plan <scope> --explain`.\n2. Confirm the semantic scope, patch/tree identity, mapped components and bundle plan digest.\n3. Run required active tools first, evaluate recommended tools explicitly and leave completion-only tools deferred until an attestation exists.\n4. Select the plan's applicable rules explicitly and record them in the review.\n5. Resolve rule conflicts with the most restrictive option, prioritizing security for exposure, authorization, and integrity risks.\n6. Consult `.pose/knowledge/` for relevant handoffs, accepted risks, follow-ups, and decision logs.\n7. Check compliance with specs, contracts, and local instructions.\n8. Review functional correctness and edge cases.\n9. Evaluate security, observability, and performance risks.\n10. Require validation evidence from `.pose/indexes/validation-matrix.json` proportional to risk.\n11. Identify regression and rollout or rollback risks.\n12. Run plan-selected assessments, including tech-debt and integration when applicable.\n13. Classify findings by severity and propose objective actions.\n14. **Produce a handoff** in `.pose/knowledge/` when findings result in accepted risk, post-merge monitoring, or deferred work (`pose new-knowledge handoff <slug>`); link it from the review.\n15. Seal the validated subject with `pose review bundle <scope> --seal`; stop if any input is unclassified or changed since preparation.\n16. Issue a final decision: approved, approved with reservations, changes requested, or rejected.\n17. Record the decision with `pose review attest <bundle-id> ... --plan-digest <sha256> --apply`; signed external envelopes use `pose review attest --envelope <path> --apply`.\n18. Run `pose review verify <scope>` and `pose review-check <scope>`; reject stale, incomplete, conflicting or transitively invalid reused criteria.\n19. Apply closeout only after verification reports `ready-to-close`; lifecycle, state and report refreshes must not change the sealed bundle.\n20. When Contributor Mode is active and review identifies linter false-positives, diagnostic frictions, or POSE rule gaps, stage an improvement proposal via `pose contribute stage --type enhancement`.\n\n## Required rule selection\n\nAttach this section to the review:\n\n```md\n## Rules applied during review\n- Change type: <feature|bugfix|refactor|documentation-update|mixed>\n- Workflow consulted: `.pose/workflows/<file>.md`\n- Rules selected:\n  - [ ] `.pose/rules/security.md`\n  - [ ] `.pose/rules/backend-go.md` (extension `pose-rule-backend-go`, when installed)\n  - [ ] `.pose/rules/frontend-react.md` (extension `pose-rule-frontend-react`, when installed)\n  - [ ] `.pose/rules/kubernetes.md` (extension `pose-rule-kubernetes`, when installed)\n  - [ ] `.pose/rules/documentation-style.md`\n  - [ ] `.pose/rules/knowledge-governance.md` when knowledge or process changes\n- Rationale for each selected rule: <one line per item>\n- Rules not applicable: <list and explain>\n```\n\n## Recurrence escalation\n\n- Trigger `.pose/workflows/recurrence-escalation.md` when recurring rework is uncovered and the threshold is met.\n- Require `recurrence_rework_uncovered` evidence for the 30-day period.\n- Require explicit links from the specialized workflow to applicable domain rules.\n- Require a formal keep, adjust, or discard decision after the 45-day pilot.\n\n## Minimum domain coverage\n\n- React UI: apply `frontend-react`, `security`, and `documentation-style`.\n- Go services: apply `backend-go`, `security`, and `documentation-style`.\n- Cluster deployment or infrastructure: apply `kubernetes`, `security`, and `documentation-style`.\n- Process, spec, workflow, rule, or report: apply `documentation-style`, `knowledge-governance`, and security when sensitive data is involved.\n- Cross-stack changes: apply every touched domain rule cumulatively.\n\n## Domain review checklist\n\n### Security\n\n- Confirm authentication, authorization, and least privilege when applicable.\n- Verify that code, configuration, manifests, docs, and logs contain no secrets.\n- Require applicable vulnerability and secret-scanning evidence.\n\n### Contracts\n\n- Confirm compatibility of public HTTP, event, schema, CLI, and file contracts.\n- Validate forward and backward compatibility for rollout and rollback.\n- Require a spec update for contract changes.\n\n### Observability\n\n- Verify structured logs and metrics without sensitive data.\n- Confirm that probes, health checks, and alerts reflect real behavior.\n- Preserve enough traceability for post-deployment diagnosis.\n\n### Validation\n\n- Require lint, typecheck, test, and build coverage proportional to risk.\n- Require executed `pose validate` evidence and relevant results.\n- Record environment limitations and residual validation risks.\n\n## Editorial checklist\n\n- Use imperative, actionable instructions.\n- Keep bullets short and avoid duplicated sections.\n- Use `check`, `spec`, and `workflow` consistently.\n- Reference explicit files and paths.\n\n## Required outputs\n\n- A review decision with rationale.\n- The inspected effective plan, its component provenance and tool dispositions.\n- An immutable sealed review bundle and separate attestation bound to its exact digest.\n- A completed rule-selection section.\n- Findings with severity, evidence, and recommendation.\n- Recurrence classification by domain and cause with preventive actions.\n- An explicit statement about public contracts and compatibility.\n- Residual risks and safe-deployment conditions.\n- References to executed checks and collected evidence.\n\n## Complete multi-rule review example\n\n```md\n## Review Summary\n- Decision: approved with reservations\n- Change type: feature (Go API, React UI, and Helm)\n- Workflow: `.pose/workflows/feature.md`\n\n## Rules applied during review\n- `.pose/rules/backend-go.md` (extension `pose-rule-backend-go`): verified handlers, context, and error handling.\n- `.pose/rules/frontend-react.md` (extension `pose-rule-frontend-react`): verified accessibility and explicit loading and error states.\n- `.pose/rules/kubernetes.md` (extension `pose-rule-kubernetes`): verified resources, probes, and immutable images.\n- `.pose/rules/security.md`: verified authorization and absence of secrets.\n- `.pose/rules/documentation-style.md`: verified editorial consistency.\n\n## Checks and evidence\n- `pose validate`: passed\n- `go test ./...`: passed in the backend module\n- `pnpm lint && pnpm test`: passed in the frontend module\n- `helm template` and `kubectl apply --dry-run=client`: passed\n\n## Contracts and compatibility\n- Preserved `POST /v1/storage`.\n- Added optional `retentionDays`, preserving backward compatibility.\n\n## Findings\n- Medium: missing queue-saturation alert; add a metric and alert before production.\n- Low: frontend error lacks request-id context; improve observable UX.\n\n## Residual risks\n- Review did not simulate real cluster load.\n- Increase monitoring during the first 24 hours.\n```\n\n## CI failure interpretation\n\n- Treat `POSE check (strict)` as merge-blocking on protected branches.\n- Treat failed required checks in `POSE validate (strict)` as merge-blocking.\n- Attach pipeline artifacts: `pose-check.log`, `pose-validate.latest.log`, and the POSE report.\n- Classify optional-check failures as quality reservations with an owned remediation plan.\n- Reject changes that violate specs, public contracts, security, or safe rollout.\n\n## Phased rollout for unready modules\n\n- Enforce the current required checks immediately.\n- Use `moduleOverrides` to phase adoption without weakening global structural and required gates.\n- Promote optional checks to required by module with an owner and agreed window.\n\n### Optional-to-required promotion protocol\n\n- Select a pilot domain and map candidate checks with owners and explicit risks.\n- Measure success for four weeks and require a baseline of at least 95 percent.\n- Promote only eligible domains through `moduleOverrides`.\n- Update the validation matrix and quality policy in the same change set.\n- Monitor regressions and adjust rollout without removing established required gates.\n- Update specs and rules when rollout changes merge acceptance criteria.\n\n## Definition of done\n\n- Resolve or formally accept every critical and high finding.\n- Make the final decision clear and actionable.\n- Support quality and security conclusions with evidence.\n- Preserve approved scope without unjustified drift.\n\n## Reviewer mode\n\n**Objective:** evaluate technical quality and production readiness with emphasis on correctness, risk, and scope.\n\n- **Focus:** functional correctness, spec consistency, regression and security risk, operability, validation quality, and actionable feedback.\n- **Anti-patterns:** approve without sufficient evidence; review style while ignoring functional risk; request unrelated changes; block progress on subjective preference.\n- **Handoff:** state the decision, severity and evidence for each finding, safe merge or deployment conditions, accepted risks, and recommended monitoring.\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Security\n\n## When to consult\n\nConsult this guide for authentication, authorization, sensitive data, external integrations, dependencies, and attack surfaces.\n\n## Required patterns\n\n- Apply least privilege to resource and credential access.\n- Store secrets only in appropriate secret-management mechanisms, never in code.\n- Validate and sanitize external input for its execution context.\n- Keep personal and confidential data out of plaintext logs and metrics.\n- Evaluate new dependencies for maintenance, licensing, and known vulnerabilities.\n- Test both positive and negative authentication and authorization cases.\n\n## Blocking anti-patterns\n\n- Committing credentials, tokens, keys, or secrets in any versioned artifact.\n- Disabling TLS or certificate verification without a formally documented mitigation.\n- Trusting client input for authorization decisions.\n- Executing dynamic commands without adequate validation and escaping.\n- Ignoring critical security alerts without an approved exception record.\n\n## Minimum checks\n\n- Run secret scanning on the changed diff or scope.\n- Run the module's applicable dependency vulnerability scanner.\n- Pass the relevant authentication and authorization tests.\n- Complete a review for sensitive-data exposure in logs and configuration.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Documentation Style\n\n## When to consult\n\nConsult this guide for process documentation, rules, specs, workflows, and operational instructions.\n\n## Required conventions\n\n- Write instructions in the imperative mood and begin them with action verbs.\n- Keep bullets short and limited to one idea.\n- Avoid duplicating sections with the same purpose across files.\n- Link to the single source of truth instead of copying its content.\n- Use `check`, `spec`, and `workflow` consistently.\n- State each instruction's scope explicitly to reduce ambiguity.\n\n## Examples: good and bad\n\n### Redundancy\n\n- **Good:** \"Update review criteria in `.pose/workflows/review.md` and reference that workflow from the root AGENTS file.\"\n- **Bad:** \"Repeat review criteria in AGENTS, the workflow, and every related spec.\"\n\n### Ambiguous reference\n\n- **Good:** \"Run the lint check described by the review workflow.\"\n- **Bad:** \"Run that standard validation before pushing.\"\n\n## Quick editorial checklist\n\n- Language is imperative and direct.\n- Bullets are short and non-overlapping.\n- Files do not duplicate sections.\n- `check`, `spec`, and `workflow` are used consistently.\n- References point to explicit files or paths.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# ADR: Check review readiness before the seal and inside the run\n\n## Status\n\nAccepted on 2026-11-23 for `pose-review-readiness-before-seal`.\n\n## Context\n\nA delegated review round costs a seal, a run of about forty minutes and a conclusion. In the 23 rounds of `pose-validate-carries-unchanged-checks`, about seven were lost to refusals that existed before the reviewer started: `pose close` refused an approved scope for an undeclared delivery; the conclusion preflight refused drafts for a decision with no requirement basis, prefixed finding ids, prior findings outside the open ones, and criterion evidence outside its component. The reviewer could not see those rules applied to its own draft until the run had ended.\n\n## Decision\n\nMove each check to the earliest point that has its inputs, reusing the same predicate:\n\n- The seal of a new spec bundle refuses the declaration findings the delivery index holds at error severity for the scope (`undeclared-delivery` and the artifact finding `undeclared`), which `pose close` reports. Evidence findings stay at close. When a required criterion asks for structural mappings, it also refuses a decision or assumption that reaches no requirement or constraint, the namespace the preflight checks mappings against.\n- `pose review draft-check` runs the conclusion's draft parser, the round accounting and the attestation content checks over a draft, writing nothing. The content checks are the part of the bundle-attestation validation that does not depend on the run's signature or identity, extracted as one function both paths call.\n- A sealed checkout holds neither the bundle nor the run ledger, so the dispatch writes the bundle and the round's open findings to the run's private directory and names the file in `POSE_REVIEW_DRAFT_CONTEXT`. It also names its own executable in `POSE_REVIEW_CLI`, because the reviewer's shell may resolve another installed `pose`. `--draft -` reads standard input for read-only sandboxes. A run id selects its bundle.\n- The brief of the new template `review-brief/8` asks the reviewer to run the check. Template texts are immutable, so `/7` stays for the runs briefed with it.\n\n## Consequences\n\nA scope that would fail at close now fails at seal, before any review cost. A reviewer can converge its draft inside one run. The draft check is advisory: the conclusion step stays the gate and still runs every check, including the signature and identity checks the draft check cannot run.\n\nResidual limits:\n- L1: the draft check judges against the context the dispatch wrote. A reviewer that edits that file only misleads itself, because the conclusion re-reads the sealed bundle and the ledger.\n- L2: the seal reads the delivery finding from the committed index. A stale index can miss a finding that a later `pose index` would add. `pose close` still refuses it, so the cost is a round, never a wrong closure.\n\n## Alternatives considered\n\n- A per-instance cap on review rounds would stop the loop by approving unreviewed work.\n- Running the full `pose close` gate at seal would refuse scopes for evidence that only exists after the review.\n","exit_code":0,"status":"completed"}}
