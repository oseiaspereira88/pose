{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\nimport subprocess,os,json\nfor args in [[\\\"artifact-check\\\",\\\"--spec\\\",\\\"pose-review-readiness-before-seal\\\",\\\"--strict\\\",\\\"--json\\\"],[\\\"surface-check\\\",\\\"--spec\\\",\\\"pose-review-readiness-before-seal\\\",\\\"--strict\\\",\\\"--json\\\"]]:\n r=subprocess.run([os.environ[\\\"POSE_REVIEW_CLI\\\"]]+args,capture_output=True,text=True)\n print(\\\"COMMAND\\\", \\\" \\\".join(args),\\\"EXIT\\\",r.returncode)\n try:\n  d=json.loads(r.stdout)\n  print(json.dumps({k:v for k,v in d.items() if k in (\\\"findings\\\",\\\"spec\\\",\\\"claims\\\",\\\"observed\\\",\\\"blockers\\\") and k\"'!=\"findings\"})[:500])\n  print(json.dumps([x for x in d.get(\"findings\",[]) if x.get(\"spec\")==\"pose-review-readiness-before-seal\" or x.get(\"severity\") in (\"error\",\"critical\")])[:4000])\n except Exception:\n  print((r.stdout+r.stderr)[-3000:])\nPY'","aggregated_output":"COMMAND artifact-check --spec pose-review-readiness-before-seal --strict --json EXIT 0\n{\"claims\": [{\"spec\": \"pose-review-readiness-before-seal\", \"action\": \"created\", \"path\": \".pose/adr/2026-11-23-review-readiness-before-seal.md\"}, {\"spec\": \"pose-review-readiness-before-seal\", \"action\": \"created\", \"path\": \".pose/specs/2026-11-23-pose-review-readiness-before-seal.md\"}, {\"spec\": \"pose-review-readiness-before-seal\", \"action\": \"created\", \"path\": \"pose-mcp/internal/cli/review_draft_check.go\"}, {\"spec\": \"pose-review-readiness-before-seal\", \"action\": \"created\", \"path\": \"pose-mcp/internal/\n[]\nCOMMAND surface-check --spec pose-review-readiness-before-seal --strict --json EXIT 0\n{\"claims\": [{\"spec\": \"artifact-claims-stop-at-the-section-end\", \"action\": \"created\", \"path\": \".pose/changelogs/unreleased/artifact-claims-stop-at-the-section-end.md\"}, {\"spec\": \"artifact-claims-stop-at-the-section-end\", \"action\": \"created\", \"path\": \".pose/specs/2026-09-20-artifact-claims-stop-at-the-section-end.md\"}, {\"spec\": \"artifact-claims-stop-at-the-section-end\", \"action\": \"created\", \"path\": \"pose-mcp/internal/pose/artifact_claims_boundary_test.go\"}, {\"spec\": \"artifact-claims-stop-at-the-se\n[]\n","exit_code":0,"status":"completed"}}
