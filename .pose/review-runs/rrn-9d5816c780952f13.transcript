o\n    64\t- modified: pose-mcp/internal/pose/review_brief_test.go\n    65\t- modified: pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\n    66\t- modified: pose-mcp/internal/pose/review_brief_preflight_tie_test.go\n    67\t- modified: pose-mcp/internal/pose/live_policy_reads_test.go\n    68\t- modified: pose-mcp/internal/pose/review_structure_test.go\n    69\t- modified: pose-mcp/internal/pose/testdata/review_brief_template_digests.json\n    70\t- created: pose-mcp/internal/cli/review_draft_check.go\n","exit_code":0,"status":"completed"}}
