{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LJG1zhbwXzA6hC2wRzVvaL","type":"tool_result","content":"420\t\tafter, err := f.Stat()\n421\t\tif err != nil {\n422\t\t\treturn nil, err\n423\t\t}\n424\t\tif !after.Mode().IsRegular() || !os.SameFile(before, after) {\n425\t\t\treturn nil, fmt.Errorf(\"output identity changed\")\n426\t\t}\n427\t\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n428\t\tif err != nil {\n429\t\t\treturn nil, err\n430\t\t}\n431\t\tif int64(len(raw)) > limit {\n432\t\t\treturn nil, fmt.Errorf(\"output exceeds byte budget\")\n433\t\t}\n434\t\tlast, err := root.Lstat(path)\n435\t\tif err != nil || !os.SameFile(last, after) || last.Size() != int64(len(raw)) {\n436\t\t\treturn nil, fmt.Errorf(\"output changed while reading\")\n437\t\t}\n438\t\treturn raw, nil\n439\t}\n440\t\n441\tfunc validateReviewNotes(notes string) error {\n442\t\tif len(notes) > ReviewNotesMaxBytes || !utf8.ValidString(notes) || strings.ContainsRune(notes, 0) {\n443\t\t\treturn fmt.Errorf(\"review notes must be valid UTF-8, without NUL, at most %d bytes\", ReviewNotesMaxBytes)\n444\t\t}\n445\t\treturn nil\n446\t}\n447\t\n448\t// reviewCleanupOwnership holds descriptors opened before the adapter starts.\n449\t// Git's recursive worktree-remove command takes a path, so it cannot safely\n450\t// delete after a hostile rename. Workspace and exact registration are instead\n451\t// removed independently through confined roots. No global prune is performed.\n452\ttype reviewCleanupOwnership struct {\n453\t\tremoved          bool\n454\t\truntime          *os.Root\n455\t\tregistry         *os.Root\n456\t\tregistration     string\n457\t\tregistrationInfo os.FileInfo\n458\t\tbacklink         string\n459\t\t// inventoryBytes bounds the bytes the worktree's cleanup may remove: the\n460\t\t// checked-out commit's tree plus the snapshot margin, read from the\n461\t\t// coordinator repository when the worktree is registered (spec\n462\t\t// pose-git-snapshot-budget-scales-with-the-tree).\n463\t\tinventoryBytes       int64\n464\t\tgitlinkMetadata      os.FileInfo\n465\t\tgitlinkMetadataBytes int64\n466\t}\n467\t\n468\tfunc (s Store) captureReviewCleanupOwnership(runtime *os.Root, worktree string, marker []byte) (*reviewCleanupOwnership, error) {\n469\t\traw, err := snapshotGit(s.Root, \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\")\n470\t\tif err != nil {\n471\t\t\treturn nil, err\n472\t\t}\n473\t\tparent := filepath.Join(strings.TrimSpace(string(raw)), \"worktrees\")\n474\t\tpath := strings.TrimSpace(strings.TrimPrefix(string(marker), \"gitdir: \"))\n475\t\tif !strings.HasPrefix(string(marker), \"gitdir: \") || !filepath.IsAbs(path) || filepath.Dir(path) != parent {\n476\t\t\treturn nil, fmt.Errorf(\"unexpected worktree registration\")\n477\t\t}\n478\t\tregistry, err := os.OpenRoot(parent)\n479\t\tif err != nil {\n480\t\t\treturn nil, err\n481\t\t}\n482\t\tname := filepath.Base(path)\n483\t\tinfo, err := registry.Lstat(name)\n484\t\tif err != nil || !info.IsDir() {\n485\t\t\tregistry.Close()\n486\t\t\treturn nil, fmt.Errorf(\"worktree registration unavailable\")\n487\t\t}\n488\t\to := &reviewCleanupOwnership{runtime: runtime, registry: registry, registration: name, registrationInfo: info, backlink: filepath.Join(worktree, \".git\"), inventoryBytes: gitSnapshotMarginBytes}\n489\t\tif head, err := registry.ReadFile(filepath.Join(name, \"HEAD\")); err == nil {\n490\t\t\tif commit := strings.TrimSpace(string(head)); !strings.HasPrefix(commit, \"ref:\") && commit != \"\" {\n491\t\t\t\tif listing, err := listCommittedTree(s.Root, commit); err == nil {\n492\t\t\t\t\to.inventoryBytes = gitSnapshotBudget(gitCommittedTreeBytes(listing))\n493\t\t\t\t}\n494\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"e9bd9dad-59ac-4f9f-8b60-699123102cde","timestamp":"2026-11-26T08:19:29.464Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-ed41371fa91497af9df96f254af372d5/worktree/pose-mcp/internal/pose/review_adapter_containment.go","content":"\tafter, err := f.Stat()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif !after.Mode().IsRegular() || !os.SameFile(before, after) {\n\t\treturn nil, fmt.Errorf(\"output identity changed\")\n\t}\n\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif int64(len(raw)) > limit {\n\t\treturn nil, fmt.Errorf(\"output exceeds byte budget\")\n\t}\n\tlast, err := root.Lstat(path)\n\tif err != nil || !os.SameFile(last, after) || last.Size() != int64(len(raw)) {\n\t\treturn nil, fmt.Errorf(\"output changed while reading\")\n\t}\n\treturn raw, nil\n}\n\nfunc validateReviewNotes(notes string) error {\n\tif len(notes) > ReviewNotesMaxBytes || !utf8.ValidString(notes) || strings.ContainsRune(notes, 0) {\n\t\treturn fmt.Errorf(\"review notes must be valid UTF-8, without NUL, at most %d bytes\", ReviewNotesMaxBytes)\n\t}\n\treturn nil\n}\n\n// reviewCleanupOwnership holds descriptors opened before the adapter starts.\n// Git's recursive worktree-remove command takes a path, so it cannot safely\n// delete after a hostile rename. Workspace and exact registration are instead\n// removed independently through confined roots. No global prune is performed.\ntype reviewCleanupOwnership struct {\n\tremoved          bool\n\truntime          *os.Root\n\tregistry         *os.Root\n\tregistration     string\n\tregistrationInfo os.FileInfo\n\tbacklink         string\n\t// inventoryBytes bounds the bytes the worktree's cleanup may remove: the\n\t// checked-out commit's tree plus the snapshot margin, read from the\n\t// coordinator repository when the worktree is registered (spec\n\t// pose-git-snapshot-budget-scales-with-the-tree).\n\tinventoryBytes       int64\n\tgitlinkMetadata      os.FileInfo\n\tgitlinkMetadataBytes int64\n}\n\nfunc (s Store) captureReviewCleanupOwnership(runtime *os.Root, worktree string, marker []byte) (*reviewCleanupOwnership, error) {\n\traw, err := snapshotGit(s.Root, \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tparent := filepath.Join(strings.TrimSpace(string(raw)), \"worktrees\")\n\tpath := strings.TrimSpace(strings.TrimPrefix(string(marker), \"gitdir: \"))\n\tif !strings.HasPrefix(string(marker), \"gitdir: \") || !filepath.IsAbs(path) || filepath.Dir(path) != parent {\n\t\treturn nil, fmt.Errorf(\"unexpected worktree registration\")\n\t}\n\tregistry, err := os.OpenRoot(parent)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tname := filepath.Base(path)\n\tinfo, err := registry.Lstat(name)\n\tif err != nil || !info.IsDir() {\n\t\tregistry.Close()\n\t\treturn nil, fmt.Errorf(\"worktree registration unavailable\")\n\t}\n\to := &reviewCleanupOwnership{runtime: runtime, registry: registry, registration: name, registrationInfo: info, backlink: filepath.Join(worktree, \".git\"), inventoryBytes: gitSnapshotMarginBytes}\n\tif head, err := registry.ReadFile(filepath.Join(name, \"HEAD\")); err == nil {\n\t\tif commit := strings.TrimSpace(string(head)); !strings.HasPrefix(commit, \"ref:\") && commit != \"\" {\n\t\t\tif listing, err := listCommittedTree(s.Root, commit); err == nil {\n\t\t\t\to.inventoryBytes = gitSnapshotBudget(gitCommittedTreeBytes(listing))\n\t\t\t}\n\t\t}","numLines":75,"startLine":420,"totalLines":775}},"tool_result_meta":[{"id":"toolu_01LJG1zhbwXzA6hC2wRzVvaL","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
