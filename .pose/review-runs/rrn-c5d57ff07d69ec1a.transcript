{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PjFRZSXqPudMpCYVWQHu1R","type":"tool_result","content":"390\t\tfor _, a := range attempts {\n391\t\t\tknownAttempts[a.AttemptID] = true\n392\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n393\t\t\t\treturn nil, 0, err\n394\t\t\t}\n395\t\t\tif a.Adapter == plan.Adapter {\n396\t\t\t\tcount++\n397\t\t\t}\n398\t\t}\n399\t\tcompleted := false\n400\t\tfor _, run := range runs {\n401\t\t\tif run.AttemptID != \"\" && !knownAttempts[run.AttemptID] {\n402\t\t\t\treturn nil, 0, fmt.Errorf(\"missing attempt reservation %s\", run.AttemptID)\n403\t\t\t}\n404\t\t\tif run.Status == ReviewRunCompleted {\n405\t\t\t\tcompleted = true\n406\t\t\t}\n407\t\t\tif run.AttemptID == \"\" && run.Adapter == plan.Adapter {\n408\t\t\t\tcount++\n409\t\t\t}\n410\t\t}\n411\t\tif count >= effectiveReviewMaxRuns(plan.Config) {\n412\t\t\treturn nil, count, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"budget exhausted: %d attempt(s) of %s on this bundle, at most %d\", count, plan.Adapter, effectiveReviewMaxRuns(plan.Config)))\n413\t\t}\n414\t\tif completed && strings.TrimSpace(plan.Reason) == \"\" {\n415\t\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n416\t\t}\n417\t\treturn attempts, count, nil\n418\t}\n419\t\n420\t// prepareDelegatedReviewAttempt admits and builds the next reservation of\n421\t// the bundle without publishing it.\n422\tfunc (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n423\t\tattempts, _, err := s.reviewAttemptAdmission(plan)\n424\t\tif err != nil {\n425\t\t\treturn DelegatedReviewAttempt{}, err\n426\t\t}\n427\t\tnonce := make([]byte, 16)\n428\t\tif _, err := rand.Read(nonce); err != nil {\n429\t\t\treturn DelegatedReviewAttempt{}, err\n430\t\t}\n431\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n432\t\ta.AttemptID = attemptIdentity(a)\n433\t\treturn a, nil\n434\t}\n435\t\n436\t// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n437\t// marks the attempt active first, so a dispatch that ends after this point\n438\t// always leaves a marker that turns stalled and that `pose delegate cancel`\n439\t// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n440\t// review round 1, N1).\n441\tfunc (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n442\t\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n443\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n444\t\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n445\t\t}\n446\t\treturn nil\n447\t}\n448\tfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n449\t\traw, _ := json.Marshal(run)\n450\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n451\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n452\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n453\t}\n454\t\n455\t// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n456\t// exists for legacy records; their content identity remains independently checked.\n457\tfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n458\t\tbudget := int64(32 << 20)\n459\t\treturn s.reviewRunLedgerFindings(bundle, &budget)"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"7f18765d-7d74-4419-a158-812de53e4385","timestamp":"2026-11-26T08:19:22.098Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-ed41371fa91497af9df96f254af372d5/worktree/pose-mcp/internal/pose/review_attempt_ledger.go","content":"\tfor _, a := range attempts {\n\t\tknownAttempts[a.AttemptID] = true\n\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n\t\t\treturn nil, 0, err\n\t\t}\n\t\tif a.Adapter == plan.Adapter {\n\t\t\tcount++\n\t\t}\n\t}\n\tcompleted := false\n\tfor _, run := range runs {\n\t\tif run.AttemptID != \"\" && !knownAttempts[run.AttemptID] {\n\t\t\treturn nil, 0, fmt.Errorf(\"missing attempt reservation %s\", run.AttemptID)\n\t\t}\n\t\tif run.Status == ReviewRunCompleted {\n\t\t\tcompleted = true\n\t\t}\n\t\tif run.AttemptID == \"\" && run.Adapter == plan.Adapter {\n\t\t\tcount++\n\t\t}\n\t}\n\tif count >= effectiveReviewMaxRuns(plan.Config) {\n\t\treturn nil, count, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"budget exhausted: %d attempt(s) of %s on this bundle, at most %d\", count, plan.Adapter, effectiveReviewMaxRuns(plan.Config)))\n\t}\n\tif completed && strings.TrimSpace(plan.Reason) == \"\" {\n\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n\t}\n\treturn attempts, count, nil\n}\n\n// prepareDelegatedReviewAttempt admits and builds the next reservation of\n// the bundle without publishing it.\nfunc (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n\tattempts, _, err := s.reviewAttemptAdmission(plan)\n\tif err != nil {\n\t\treturn DelegatedReviewAttempt{}, err\n\t}\n\tnonce := make([]byte, 16)\n\tif _, err := rand.Read(nonce); err != nil {\n\t\treturn DelegatedReviewAttempt{}, err\n\t}\n\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n\ta.AttemptID = attemptIdentity(a)\n\treturn a, nil\n}\n\n// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n// marks the attempt active first, so a dispatch that ends after this point\n// always leaves a marker that turns stalled and that `pose delegate cancel`\n// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n// review round 1, N1).\nfunc (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n\t}\n\treturn nil\n}\nfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n\traw, _ := json.Marshal(run)\n\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n}\n\n// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n// exists for legacy records; their content identity remains independently checked.\nfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n\tbudget := int64(32 << 20)\n\treturn s.reviewRunLedgerFindings(bundle, &budget)","numLines":70,"startLine":390,"totalLines":887}},"tool_result_meta":[{"id":"toolu_01PjFRZSXqPudMpCYVWQHu1R","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
