{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vz2t4H2aeB4WmzKuheAsRR","type":"tool_result","content":"1\tpackage pose\n2\t\n3\t// Delegated review dispatch (spec pose-delegated-review-dispatch, roadmap\n4\t// delegated-review).\n5\t//\n6\t// A run hands the brief of a sealed bundle to a configured reviewer command —\n7\t// another vendor's agent, typically — on a disposable worktree at the sealed\n8\t// commit, and records what happened. It never records an attestation: turning\n9\t// a run's conclusion into one is the engine's verified step (spec\n10\t// pose-delegated-review-capability). A run that changed files, exceeded its\n11\t// time or budget, or failed is recorded as failed, never as a review.\n12\t\n13\timport (\n14\t\t\"bytes\"\n15\t\t\"context\"\n16\t\t\"crypto/sha256\"\n17\t\t\"encoding/hex\"\n18\t\t\"encoding/json\"\n19\t\t\"errors\"\n20\t\t\"fmt\"\n21\t\t\"io\"\n22\t\t\"io/fs\"\n23\t\t\"os\"\n24\t\t\"os/exec\"\n25\t\t\"path/filepath\"\n26\t\t\"reflect\"\n27\t\t\"regexp\"\n28\t\t\"runtime\"\n29\t\t\"sort\"\n30\t\t\"strings\"\n31\t\t\"sync/atomic\"\n32\t\t\"time\"\n33\t\t\"unicode/utf8\"\n34\t)\n35\t\n36\t// beforeRunResultPublished is a test seam called with a run just before its\n37\t// attempt result is published (spec pose-delegation-result-before-marker).\n38\tvar beforeRunResultPublished = func(ReviewRun) {}\n39\t\n40\t// AdapterPipeGrace is how long a finished or killed adapter's children may\n41\t// hold its pipes before they are released. Tests that exercise a lingering\n42\t// child shorten it (spec pose-cli-test-wall-time R1).\n43\tvar AdapterPipeGrace = 5 * time.Second\n44\t\n45\t// ReviewersPolicySchemaVersion versions .pose/policy/reviewers.json.\n46\tconst ReviewersPolicySchemaVersion = 1\n47\t\n48\tconst reviewRunsDir = \".pose/review-runs\"\n49\t\n50\t// ReviewerAdapter is one configured reviewer command.\n51\ttype ReviewerAdapter struct {\n52\t\tContainment *ReviewerContainment `json:\"containment,omitempty\"`\n53\t\t// Command is the argv; \"{output}\" is replaced by a file the reviewer may\n54\t\t// write its final message to. The brief arrives on stdin and the working\n55\t\t// directory is the disposable worktree.\n56\t\tExecutor         string           `json:\"executor,omitempty\"`\n57\t\tCommand          []string         `json:\"command\"`\n58\t\tVendor           string           `json:\"vendor\"`\n59\t\tModel            string           `json:\"model\"`\n60\t\tTimeout          string           `json:\"timeout,omitempty\"`\n61\t\tMaxRunsPerBundle int              `json:\"max_runs_per_bundle,omitempty\"`\n62\t\tLimit            *ReviewerLimit   `json:\"limit,omitempty\"`\n63\t\tSession          *ReviewerSession `json:\"session,omitempty\"`\n64\t\tResume           *ReviewerResume  `json:\"resume,omitempty\"`\n65\t\t// Events and Effort come from a delegation.json agent (schema 2); a\n66\t\t// schema 1 adapter has neither, so its projection is unchanged.\n67\t\tEvents string          `json:\"events,omitempty\"`\n68\t\tEffort *ReviewerEffort `json:\"effort,omitempty\"`\n69\t}\n70\t\n71\t// ReviewersPolicy is .pose/policy/reviewers.json.\n72\ttype ReviewersPolicy struct {\n73\t\tProvenance    *ReviewRunProvenancePolicy `json:\"provenance,omitempty\"`\n74\t\tSchemaVersion int                        `json:\"schema_version\"`\n75\t\tAdapters      map[string]ReviewerAdapter `json:\"adapters\"`\n76\t}\n77\t\n78\t// ExampleReviewersPolicy is what POSE suggests and never enables by itself.\n79\tfunc ExampleReviewersPolicy() ReviewersPolicy {\n80\t\treturn ReviewersPolicy{SchemaVersion: ReviewersPolicySchemaVersion, Adapters: map[string]ReviewerAdapter{\n81\t\t\t\"codex\": {Command: []string{\"codex\", \"exec\", \"-m\", \"gpt-6.1-sol\", \"-c\", `model_reasoning_effort=\"medium\"`, \"-s\", \"read-only\", \"--skip-git-repo-check\", \"-o\", \"{output}\", \"-\"},\n82\t\t\t\tVendor: \"openai\", Model: \"gpt-6.1-sol\", Timeout: \"60m\", MaxRunsPerBundle: 3},\n83\t\t\t\"claude\": {Command: []string{\"claude\", \"-p\", \"--model\", \"claude-opus-5-5\", \"--permission-mode\", \"plan\"},\n84\t\t\t\tVendor: \"anthropic\", Model: \"claude-opus-5-5\", Timeout: \"60m\", MaxRunsPerBundle: 3},\n85\t\t}}\n86\t}\n87\t\n88\t// LoadReviewersPolicy reads the adapters of the review purpose; an absent\n89\t// policy means none.\n90\tfunc (s Store) LoadReviewersPolicy() (ReviewersPolicy, bool, error) {\n91\t\treturn s.LoadReviewersPolicyFor(\"review\")\n92\t}\n93\t\n94\t// LoadReviewersPolicyFor reads the adapters for the purpose that runs a brief\n95\t// of kind: delegation.json (schema 2) projected for that purpose, or\n96\t// reviewers.json (schema 1) through the same conversion.\n97\tfunc (s Store) LoadReviewersPolicyFor(kind string) (ReviewersPolicy, bool, error) {\n98\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n99\t\tif err != nil || !found {\n100\t\t\treturn ReviewersPolicy{}, false, err\n101\t\t}\n102\t\treturn policy.reviewersView(DelegationPurposeForKind(kind)), true, nil\n103\t}\n104\t\n105\t// activeDelegationPolicyPath is the policy file the engine reads now.\n106\tfunc (s Store) activeDelegationPolicyPath() string {\n107\t\tif _, err := os.Lstat(filepath.Join(s.Root, filepath.FromSlash(delegationPolicyPath))); err == nil {\n108\t\t\treturn delegationPolicyPath\n109\t\t}\n110\t\treturn reviewersPolicyPath\n111\t}\n112\t\n113\tfunc parseReviewersPolicy(raw []byte) (ReviewersPolicy, error) {\n114\t\tvar policy ReviewersPolicy\n115\t\tif err := json.Unmarshal(raw, &policy); err != nil {\n116\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: invalid .pose/policy/reviewers.json: %w\", err)\n117\t\t}\n118\t\tif policy.SchemaVersion != ReviewersPolicySchemaVersion {\n119\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: .pose/policy/reviewers.json schema_version %d is not supported\", policy.SchemaVersion)\n120\t\t}\n121\t\tif err := validateExplicitReviewBudget(raw); err != nil {\n122\t\t\treturn ReviewersPolicy{}, err\n123\t\t}\n124\t\tif err := validateRunProvenancePolicy(policy); err != nil {\n125\t\t\treturn ReviewersPolicy{}, err\n126\t\t}\n127\t\tfor name, adapter := range policy.Adapters {\n128\t\t\tif adapter.Events != \"\" || adapter.Effort != nil {\n129\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s: events and effort are delegation.json fields\", name)\n130\t\t\t}\n131\t\t\tif _, err := ResolveReviewerContainment(adapter); err != nil {\n132\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"adapter %s: %w\", name, err)\n133\t\t\t}\n134\t\t\tif err := validateContinuityAdapter(adapter); err != nil {\n135\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s: %w\", name, err)\n136\t\t\t}\n137\t\t\tif len(adapter.Command) == 0 || adapter.Vendor == \"\" || adapter.Model == \"\" {\n138\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s needs command, vendor and model\", name)\n139\t\t\t}\n140\t\t\tif adapter.Timeout != \"\" {\n141\t\t\t\tif _, err := time.ParseDuration(adapter.Timeout); err != nil {\n142\t\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s timeout: %w\", name, err)\n143\t\t\t\t}\n144\t\t\t}\n145\t\t}\n146\t\treturn policy, nil\n147\t}\n148\t\n149\t// ReviewRun is one recorded dispatch.\n150\ttype ReviewRun struct {\n151\t\tSafety              *ReviewExecutionSafety `json:\"safety,omitempty\"`\n152\t\tProvenance          *ReviewRunProvenance   `json:\"provenance,omitempty\"`\n153\t\tsessionForRedaction string\n154\t\teventsBytes         []byte\n155\t\tResumes             string `json:\"resumes,omitempty\"`\n156\t\t// ResumesSession marks a task that continued a session POSE never\n157\t\t// recorded, named by its caller (spec pose-delegation-parity-gate SA-07).\n158\t\tResumesSession bool `json:\"resumes_session,omitempty\"`\n159\t\t// HandsOffFrom names the run this one continues with another agent, and\n160\t\t// HandoffDigest the section its brief added (spec\n161\t\t// pose-delegation-handoff R4, R5).\n162\t\tHandsOffFrom  string `json:\"hands_off_from,omitempty\"`\n163\t\tHandoffDigest string `json:\"handoff_digest,omitempty\"`\n164\t\t// HandoffRenderer is the version of the renderer that listed the\n165\t\t// predecessor's commands in the section; absent on runs recorded before it.\n166\t\tHandoffRenderer  int                 `json:\"handoff_renderer,omitempty\"`\n167\t\tInterruption     *ReviewInterruption `json:\"interruption,omitempty\"`\n168\t\tSessionDigest    string              `json:\"session_digest,omitempty\"`\n169\t\tTreeDigest       string              `json:\"tree_digest,omitempty\"`\n170\t\tBriefNotes       string              `json:\"brief_notes,omitempty\"`\n171\t\tPartialDigest    string              `json:\"partial_digest,omitempty\"`\n172\t\tLimitOf          string              `json:\"limit_of,omitempty\"`\n173\t\tLedgerVersion    int                 `json:\"ledger_version,omitempty\"`\n174\t\tAttemptID        string              `json:\"attempt_id,omitempty\"`\n175\t\tReason           string              `json:\"reason,omitempty\"`\n176\t\tSchemaVersion    int                 `json:\"schema_version\"`\n177\t\tRunID            string              `json:\"run_id\"`\n178\t\tScope            string              `json:\"scope\"`\n179\t\tBundleID         string              `json:\"bundle_id\"`\n180\t\tBundleDigest     string              `json:\"bundle_digest\"`\n181\t\tSealedCommit     string              `json:\"sealed_commit\"`\n182\t\tKind             string              `json:\"kind\"`\n183\t\tBriefDigest      string              `json:\"brief_digest\"`\n184\t\tAdapter          string              `json:\"adapter\"`\n185\t\tVendor           string              `json:\"vendor\"`\n186\t\tModel            string              `json:\"model\"`\n187\t\tStartedAt        string              `json:\"started_at\"`\n188\t\tEndedAt          string              `json:\"ended_at\"`\n189\t\tExitCode         int                 `json:\"exit_code\"`\n190\t\tStatus           string              `json:\"status\"`\n191\t\tFailure          string              `json:\"failure,omitempty\"`\n192\t\tTranscriptDigest string              `json:\"transcript_digest\"`\n193\t\tTranscriptPath   string              `json:\"transcript_path\"`\n194\t\tOutput           string              `json:\"output\"`\n195\t\tPolicyDigest     string              `json:\"policy_digest,omitempty\"`\n196\t\tSupersedes       string              `json:\"supersedes,omitempty\"`\n197\t\t// Label, Purpose and Lead are given by pose delegate; EnvRemoved names the\n198\t\t// parent session variables the child did not receive (never their values);\n199\t\t// Events and EventsDigest bind the normalized event stream kept beside\n200\t\t// the transcript (spec pose-delegation-surface R8, R9, R11)."}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"53f01837-c20b-43c3-8015-9c8c3a3311d2","timestamp":"2026-11-26T08:18:51.735Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-ed41371fa91497af9df96f254af372d5/worktree/pose-mcp/internal/pose/review_dispatch.go","content":"package pose\n\n// Delegated review dispatch (spec pose-delegated-review-dispatch, roadmap\n// delegated-review).\n//\n// A run hands the brief of a sealed bundle to a configured reviewer command —\n// another vendor's agent, typically — on a disposable worktree at the sealed\n// commit, and records what happened. It never records an attestation: turning\n// a run's conclusion into one is the engine's verified step (spec\n// pose-delegated-review-capability). A run that changed files, exceeded its\n// time or budget, or failed is recorded as failed, never as a review.\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"io/fs\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"regexp\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"time\"\n\t\"unicode/utf8\"\n)\n\n// beforeRunResultPublished is a test seam called with a run just before its\n// attempt result is published (spec pose-delegation-result-before-marker).\nvar beforeRunResultPublished = func(ReviewRun) {}\n\n// AdapterPipeGrace is how long a finished or killed adapter's children may\n// hold its pipes before they are released. Tests that exercise a lingering\n// child shorten it (spec pose-cli-test-wall-time R1).\nvar AdapterPipeGrace = 5 * time.Second\n\n// ReviewersPolicySchemaVersion versions .pose/policy/reviewers.json.\nconst ReviewersPolicySchemaVersion = 1\n\nconst reviewRunsDir = \".pose/review-runs\"\n\n// ReviewerAdapter is one configured reviewer command.\ntype ReviewerAdapter struct {\n\tContainment *ReviewerContainment `json:\"containment,omitempty\"`\n\t// Command is the argv; \"{output}\" is replaced by a file the reviewer may\n\t// write its final message to. The brief arrives on stdin and the working\n\t// directory is the disposable worktree.\n\tExecutor         string           `json:\"executor,omitempty\"`\n\tCommand          []string         `json:\"command\"`\n\tVendor           string           `json:\"vendor\"`\n\tModel            string           `json:\"model\"`\n\tTimeout          string           `json:\"timeout,omitempty\"`\n\tMaxRunsPerBundle int              `json:\"max_runs_per_bundle,omitempty\"`\n\tLimit            *ReviewerLimit   `json:\"limit,omitempty\"`\n\tSession          *ReviewerSession `json:\"session,omitempty\"`\n\tResume           *ReviewerResume  `json:\"resume,omitempty\"`\n\t// Events and Effort come from a delegation.json agent (schema 2); a\n\t// schema 1 adapter has neither, so its projection is unchanged.\n\tEvents string          `json:\"events,omitempty\"`\n\tEffort *ReviewerEffort `json:\"effort,omitempty\"`\n}\n\n// ReviewersPolicy is .pose/policy/reviewers.json.\ntype ReviewersPolicy struct {\n\tProvenance    *ReviewRunProvenancePolicy `json:\"provenance,omitempty\"`\n\tSchemaVersion int                        `json:\"schema_version\"`\n\tAdapters      map[string]ReviewerAdapter `json:\"adapters\"`\n}\n\n// ExampleReviewersPolicy is what POSE suggests and never enables by itself.\nfunc ExampleReviewersPolicy() ReviewersPolicy {\n\treturn ReviewersPolicy{SchemaVersion: ReviewersPolicySchemaVersion, Adapters: map[string]ReviewerAdapter{\n\t\t\"codex\": {Command: []string{\"codex\", \"exec\", \"-m\", \"gpt-6.1-sol\", \"-c\", `model_reasoning_effort=\"medium\"`, \"-s\", \"read-only\", \"--skip-git-repo-check\", \"-o\", \"{output}\", \"-\"},\n\t\t\tVendor: \"openai\", Model: \"gpt-6.1-sol\", Timeout: \"60m\", MaxRunsPerBundle: 3},\n\t\t\"claude\": {Command: []string{\"claude\", \"-p\", \"--model\", \"claude-opus-5-5\", \"--permission-mode\", \"plan\"},\n\t\t\tVendor: \"anthropic\", Model: \"claude-opus-5-5\", Timeout: \"60m\", MaxRunsPerBundle: 3},\n\t}}\n}\n\n// LoadReviewersPolicy reads the adapters of the review purpose; an absent\n// policy means none.\nfunc (s Store) LoadReviewersPolicy() (ReviewersPolicy, bool, error) {\n\treturn s.LoadReviewersPolicyFor(\"review\")\n}\n\n// LoadReviewersPolicyFor reads the adapters for the purpose that runs a brief\n// of kind: delegation.json (schema 2) projected for that purpose, or\n// reviewers.json (schema 1) through the same conversion.\nfunc (s Store) LoadReviewersPolicyFor(kind string) (ReviewersPolicy, bool, error) {\n\tpolicy, _, found, err := s.LoadDelegationPolicy()\n\tif err != nil || !found {\n\t\treturn ReviewersPolicy{}, false, err\n\t}\n\treturn policy.reviewersView(DelegationPurposeForKind(kind)), true, nil\n}\n\n// activeDelegationPolicyPath is the policy file the engine reads now.\nfunc (s Store) activeDelegationPolicyPath() string {\n\tif _, err := os.Lstat(filepath.Join(s.Root, filepath.FromSlash(delegationPolicyPath))); err == nil {\n\t\treturn delegationPolicyPath\n\t}\n\treturn reviewersPolicyPath\n}\n\nfunc parseReviewersPolicy(raw []byte) (ReviewersPolicy, error) {\n\tvar policy ReviewersPolicy\n\tif err := json.Unmarshal(raw, &policy); err != nil {\n\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: invalid .pose/policy/reviewers.json: %w\", err)\n\t}\n\tif policy.SchemaVersion != ReviewersPolicySchemaVersion {\n\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: .pose/policy/reviewers.json schema_version %d is not supported\", policy.SchemaVersion)\n\t}\n\tif err := validateExplicitReviewBudget(raw); err != nil {\n\t\treturn ReviewersPolicy{}, err\n\t}\n\tif err := validateRunProvenancePolicy(policy); err != nil {\n\t\treturn ReviewersPolicy{}, err\n\t}\n\tfor name, adapter := range policy.Adapters {\n\t\tif adapter.Events != \"\" || adapter.Effort != nil {\n\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s: events and effort are delegation.json fields\", name)\n\t\t}\n\t\tif _, err := ResolveReviewerContainment(adapter); err != nil {\n\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"adapter %s: %w\", name, err)\n\t\t}\n\t\tif err := validateContinuityAdapter(adapter); err != nil {\n\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s: %w\", name, err)\n\t\t}\n\t\tif len(adapter.Command) == 0 || adapter.Vendor == \"\" || adapter.Model == \"\" {\n\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s needs command, vendor and model\", name)\n\t\t}\n\t\tif adapter.Timeout != \"\" {\n\t\t\tif _, err := time.ParseDuration(adapter.Timeout); err != nil {\n\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s timeout: %w\", name, err)\n\t\t\t}\n\t\t}\n\t}\n\treturn policy, nil\n}\n\n// ReviewRun is one recorded dispatch.\ntype ReviewRun struct {\n\tSafety              *ReviewExecutionSafety `json:\"safety,omitempty\"`\n\tProvenance          *ReviewRunProvenance   `json:\"provenance,omitempty\"`\n\tsessionForRedaction string\n\teventsBytes         []byte\n\tResumes             string `json:\"resumes,omitempty\"`\n\t// ResumesSession marks a task that continued a session POSE never\n\t// recorded, named by its caller (spec pose-delegation-parity-gate SA-07).\n\tResumesSession bool `json:\"resumes_session,omitempty\"`\n\t// HandsOffFrom names the run this one continues with another agent, and\n\t// HandoffDigest the section its brief added (spec\n\t// pose-delegation-handoff R4, R5).\n\tHandsOffFrom  string `json:\"hands_off_from,omitempty\"`\n\tHandoffDigest string `json:\"handoff_digest,omitempty\"`\n\t// HandoffRenderer is the version of the renderer that listed the\n\t// predecessor's commands in the section; absent on runs recorded before it.\n\tHandoffRenderer  int                 `json:\"handoff_renderer,omitempty\"`\n\tInterruption     *ReviewInterruption `json:\"interruption,omitempty\"`\n\tSessionDigest    string              `json:\"session_digest,omitempty\"`\n\tTreeDigest       string              `json:\"tree_digest,omitempty\"`\n\tBriefNotes       string              `json:\"brief_notes,omitempty\"`\n\tPartialDigest    string              `json:\"partial_digest,omitempty\"`\n\tLimitOf          string              `json:\"limit_of,omitempty\"`\n\tLedgerVersion    int                 `json:\"ledger_version,omitempty\"`\n\tAttemptID        string              `json:\"attempt_id,omitempty\"`\n\tReason           string              `json:\"reason,omitempty\"`\n\tSchemaVersion    int                 `json:\"schema_version\"`\n\tRunID            string              `json:\"run_id\"`\n\tScope            string              `json:\"scope\"`\n\tBundleID         string              `json:\"bundle_id\"`\n\tBundleDigest     string              `json:\"bundle_digest\"`\n\tSealedCommit     string              `json:\"sealed_commit\"`\n\tKind             string              `json:\"kind\"`\n\tBriefDigest      string              `json:\"brief_digest\"`\n\tAdapter          string              `json:\"adapter\"`\n\tVendor           string              `json:\"vendor\"`\n\tModel            string              `json:\"model\"`\n\tStartedAt        string              `json:\"started_at\"`\n\tEndedAt          string              `json:\"ended_at\"`\n\tExitCode         int                 `json:\"exit_code\"`\n\tStatus           string              `json:\"status\"`\n\tFailure          string              `json:\"failure,omitempty\"`\n\tTranscriptDigest string              `json:\"transcript_digest\"`\n\tTranscriptPath   string              `json:\"transcript_path\"`\n\tOutput           string              `json:\"output\"`\n\tPolicyDigest     string              `json:\"policy_digest,omitempty\"`\n\tSupersedes       string              `json:\"supersedes,omitempty\"`\n\t// Label, Purpose and Lead are given by pose delegate; EnvRemoved names the\n\t// parent session variables the child did not receive (never their values);\n\t// Events and EventsDigest bind the normalized event stream kept beside\n\t// the transcript (spec pose-delegation-surface R8, R9, R11).","numLines":200,"startLine":1,"totalLines":2088}},"tool_result_meta":[{"id":"toolu_01Vz2t4H2aeB4WmzKuheAsRR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
