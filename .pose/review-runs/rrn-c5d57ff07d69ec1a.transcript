{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017BtYshsvCFvL6owAC7Pqrs","type":"tool_result","content":"35\tconst delegationHandoffBound = 16 << 10\n36\t\n37\t// continues names the run r continues, by a resume or a handoff.\n38\tfunc (r ReviewRun) continues() string {\n39\t\tif r.Resumes != \"\" {\n40\t\t\treturn r.Resumes\n41\t\t}\n42\t\treturn r.HandsOffFrom\n43\t}\n44\t\n45\t// handoffable reports why a run cannot be handed off, or \"\" when it can (R1).\n46\tfunc handoffable(r ReviewRun) string {\n47\t\tswitch r.Status {\n48\t\tcase ReviewRunInterrupted, ReviewRunFailed:\n49\t\t\treturn \"\"\n50\t\tcase ReviewRunCompleted:\n51\t\t\treturn \"it completed: a concluded run is not handed off; start a new run with a reason\"\n52\t\t}\n53\t\treturn \"it is \" + r.Status\n54\t}\n55\t\n56\t// renderHandoffSection is the labelled section the handoff brief carries:\n57\t// derived only from the predecessor's recorded output and normalized events,\n58\t// so a verifier derives the same bytes.\n59\tfunc renderHandoffSection(prior ReviewRun, events []DelegationEvent, eventsErr error) string {\n60\t\treturn renderHandoffSectionWith(prior, events, eventsErr, handoffCommands)\n61\t}\n62\t\n63\tfunc renderHandoffSectionWith(prior ReviewRun, events []DelegationEvent, eventsErr error, render func([]DelegationEvent) []string) string {\n64\t\tvar b strings.Builder\n65\t\tcause := prior.Status\n66\t\tif prior.Interruption != nil {\n67\t\t\tcause += \", \" + prior.Interruption.Cause\n68\t\t} else if prior.Failure != \"\" {\n69\t\t\tcause += \", \" + firstLine(prior.Failure)\n70\t\t}\n71\t\tfmt.Fprintf(&b, \"\\n## Handoff from run %s (%s, %s)\\n\\n\", prior.RunID, prior.Adapter, cause)\n72\t\tb.WriteString(\"The run above stopped before it concluded and you continue its task. What follows is what it recorded. It is not a review, a verdict or evidence: re-verify anything you rely on, and conclude only from your own work.\\n\\n\")\n73\t\tpartial := strings.TrimSpace(prior.Output)\n74\t\tfmt.Fprintf(&b, \"### Partial final message (%s)\\n\\n\", digestBytes([]byte(prior.Output)))\n75\t\tif partial == \"\" {\n76\t\t\tb.WriteString(\"> (none)\\n\")\n77\t\t}\n78\t\tfor _, line := range strings.Split(partial, \"\\n\") {\n79\t\t\tif partial != \"\" {\n80\t\t\t\tb.WriteString(\"> \" + line + \"\\n\")\n81\t\t\t}\n82\t\t}\n83\t\tb.WriteString(\"\\n\")\n84\t\tcommands := render(events)\n85\t\tlisted := strings.Join(commands, \"\\n\")\n86\t\tfmt.Fprintf(&b, \"### Commands it ran (%s)\\n\\n\", digestBytes([]byte(listed)))\n87\t\tswitch {\n88\t\tcase eventsErr != nil:\n89\t\t\tb.WriteString(\"> (its normalized events could not be read: \" + eventsErr.Error() + \")\\n\")\n90\t\tcase prior.EventsDigest == \"\":\n91\t\t\tb.WriteString(\"> (the run recorded no normalized events, so its commands are not known)\\n\")\n92\t\tcase len(commands) == 0:\n93\t\t\tb.WriteString(\"> (none)\\n\")\n94\t\tdefault:\n95\t\t\tb.WriteString(listed + \"\\n\")\n96\t\t}\n97\t\tsection := b.String()\n98\t\tif len(section) > delegationHandoffBound {\n99\t\t\tcut := delegationHandoffBound\n100\t\t\tfor cut > 0 && !utf8RuneStart(section[cut]) {\n101\t\t\t\tcut--\n102\t\t\t}\n103\t\t\tsection = section[:cut] + \"\\n\\n> (this section was cut at \" + fmt.Sprint(delegationHandoffBound) + \" bytes; the rest is in the predecessor's record)\\n\"\n104\t\t}\n105\t\treturn section\n106\t}\n107\t\n108\t// handoffCommands lists the commands a run made with their exit status. An\n109\t// output is paired with a call only when nothing else could have produced it:\n110\t// by a call identifier that names exactly one waiting call, or, without one,\n111\t// when exactly one call waits and none is owed an earlier ambiguous output.\n112\t// Anything else is listed with its status unknown rather than guessed (R3).\n113\tfunc handoffCommands(events []DelegationEvent) []string {\n114\t\ttype call struct {\n115\t\t\ttext string\n116\t\t\texit string\n117\t\t}\n118\t\tvar calls []*call\n119\t\tbyID := map[string][]*call{} // waiting calls by identifier\n120\t\tambiguous := map[string]bool{}\n121\t\tvar anonymous []*call // waiting calls without an identifier\n122\t\t// unclaimed counts outputs still owed to calls that became ambiguous:\n123\t\t// until they arrive, no anonymous output is paired by elimination.\n124\t\tunclaimed := 0\n125\t\twaitingIdentified := func() int {\n126\t\t\tn := 0\n127\t\t\tfor _, waiting := range byID {\n128\t\t\t\tn += len(waiting)\n129\t\t\t}\n130\t\t\treturn n\n131\t\t}\n132\t\tunknown := func(code string) {\n133\t\t\tcalls = append(calls, &call{text: \"(an output whose command is not known)\", exit: code})\n134\t\t}\n135\t\tfor _, e := range events {\n136\t\t\tswitch e.Kind {\n137\t\t\tcase DelegationEventToolCall:\n138\t\t\t\tc := &call{text: strings.ReplaceAll(strings.Join(strings.Fields(e.Text), \" \"), \"`\", \"'\"), exit: \"unknown\"}\n139\t\t\t\tcalls = append(calls, c)\n140\t\t\t\tif e.Call == \"\" {\n141\t\t\t\t\tanonymous = append(anonymous, c)\n142\t\t\t\t\tcontinue\n143\t\t\t\t}\n144\t\t\t\tbyID[e.Call] = append(byID[e.Call], c)\n145\t\t\t\tif len(byID[e.Call]) > 1 {\n146\t\t\t\t\tambiguous[e.Call] = true\n147\t\t\t\t}\n148\t\t\tcase DelegationEventToolOutput:\n149\t\t\t\tcode := \"unknown\"\n150\t\t\t\tif e.ExitCode != nil {\n151\t\t\t\t\tcode = fmt.Sprint(*e.ExitCode)\n152\t\t\t\t}\n153\t\t\t\tif e.Call != \"\" {\n154\t\t\t\t\twaiting := byID[e.Call]\n155\t\t\t\t\tswitch {\n156\t\t\t\t\tcase len(waiting) == 0:\n157\t\t\t\t\t\tunknown(code)\n158\t\t\t\t\tcase ambiguous[e.Call]:\n159\t\t\t\t\t\t// Several calls share the identifier: one of them ended,\n160\t\t\t\t\t\t// which one is not known.\n161\t\t\t\t\t\tunknown(code)\n162\t\t\t\t\t\tbyID[e.Call] = waiting[1:]\n163\t\t\t\t\tdefault:\n164\t\t\t\t\t\twaiting[0].exit = code\n165\t\t\t\t\t\tdelete(byID, e.Call)\n166\t\t\t\t\t}\n167\t\t\t\t\tcontinue\n168\t\t\t\t}\n169\t\t\t\tif len(anonymous) == 1 && waitingIdentified() == 0 && unclaimed == 0 {\n170\t\t\t\t\tanonymous[0].exit = code\n171\t\t\t\t\tanonymous = nil\n172\t\t\t\t\tcontinue\n173\t\t\t\t}\n174\t\t\t\t// Several calls wait, or none: which command this output belongs\n175\t\t\t\t// to is not known, and the anonymous calls it may answer stay\n176\t\t\t\t// unknown.\n177\t\t\t\tunknown(code)\n178\t\t\t\tunclaimed += len(anonymous)\n179\t\t\t\tanonymous = nil\n180\t\t\t\tif unclaimed > 0 {\n181\t\t\t\t\tunclaimed--\n182\t\t\t\t}\n183\t\t\t}\n184\t\t}\n185\t\tout := make([]string, 0, len(calls))\n186\t\tfor _, c := range calls {\n187\t\t\tout = append(out, fmt.Sprintf(\"> `%s` → exit %s\", c.text, c.exit))\n188\t\t}\n189\t\treturn out\n190\t}\n191\t\n192\tfunc firstLine(s string) string {\n193\t\tline, _, _ := strings.Cut(strings.TrimSpace(s), \"\\n\")\n194\t\treturn line\n195\t}\n196\t\n197\t// attemptContinuationBudget is what attempt of prior has spent and may spend:\n198\t// its ceiling is the resume budget of the agent that opened it, whichever agent\n199\t// continues it, so changing agents never widens it (spec\n200\t// pose-delegation-handoff R2, D1).\n201\tfunc attemptContinuationBudget(runs []ReviewRun, prior ReviewRun, policy ReviewersPolicy) (int, time.Duration, int, time.Duration, error) {\n202\t\tvar origin *ReviewRun\n203\t\tcount, spent := 0, time.Duration(0)\n204\t\tfor i, r := range runs {\n205\t\t\tif r.AttemptID != prior.AttemptID || r.SupersededBy != \"\" {\n206\t\t\t\tcontinue\n207\t\t\t}\n208\t\t\tstart, e1 := time.Parse(time.RFC3339Nano, r.StartedAt)\n209\t\t\tend, e2 := time.Parse(time.RFC3339Nano, r.EndedAt)\n210\t\t\tif e1 != nil || e2 != nil || end.Before(start) {\n211\t\t\t\treturn 0, 0, 0, 0, fmt.Errorf(\"invalid accumulated wall-clock evidence\")\n212\t\t\t}\n213\t\t\tspent += end.Sub(start)\n214\t\t\tif r.continues() != \"\" {\n215\t\t\t\tcount++\n216\t\t\t} else {\n217\t\t\t\torigin = &runs[i]\n218\t\t\t}\n219\t\t}\n220\t\tif origin == nil {\n221\t\t\treturn 0, 0, 0, 0, fmt.Errorf(\"pose: the first run of attempt %s is not recorded, so its continuation budget cannot be read\", prior.AttemptID)\n222\t\t}\n223\t\tconfig, ok := policy.Adapters[origin.Adapter]\n224\t\tif !ok {\n225\t\t\treturn 0, 0, 0, 0, fmt.Errorf(\"pose: agent %s, which opened attempt %s, is no longer configured, so its continuation budget cannot be read\", origin.Adapter, prior.AttemptID)\n226\t\t}\n227\t\tlimit, total := 3, 60*time.Minute\n228\t\tif config.Resume != nil {\n229\t\t\tif config.Resume.MaxResumes > 0 {\n230\t\t\t\tlimit = config.Resume.MaxResumes\n231\t\t\t}\n232\t\t\tif config.Resume.MaxWallTime != \"\" {\n233\t\t\t\ttotal, _ = time.ParseDuration(config.Resume.MaxWallTime)\n234\t\t\t}\n235\t\t}\n236\t\treturn count, spent, limit, total, nil\n237\t}\n238\t\n239\t// handoffSectionFor reads the predecessor's events and renders its section.\n240\tfunc (s Store) handoffSectionFor(prior ReviewRun) string {\n241\t\tevents, err := s.ReadDelegationEvents(prior)\n242\t\treturn renderHandoffSection(prior, events, err)\n243\t}\n244\t\n245\t// recordedHandoffSection is the section run was sent, derived again from its\n246\t// predecessor's record with the renderer run recorded, or \"\" when no renderer\n247\t// of that version yields the digest run carries.\n248\tfunc (s Store) recordedHandoffSection(run, prior ReviewRun) string {\n249\t\tevents, err := s.ReadDelegationEvents(prior)\n250\t\treturn handoffSectionMatching(run, prior, events, err)\n251\t}\n252\t\n253\tfunc handoffSectionMatching(run, prior ReviewRun, events []DelegationEvent, err error) string {\n254\t\tfor _, render := range handoffRenderers[run.HandoffRenderer] {\n255\t\t\tif section := renderHandoffSectionWith(prior, events, err, render); digestBytes([]byte(section)) == run.HandoffDigest {\n256\t\t\t\treturn section\n257\t\t\t}\n258\t\t}\n259\t\treturn \"\"\n260\t}\n261\t\n262\t// PlanReviewHandoff plans the continuation of run id by agent, under the same\n263\t// attempt and its continuation budget (R1–R4).\n264\tfunc (s Store) PlanReviewHandoff(id, agent string) (DispatchPlan, error) {\n265\t\truns, lost, e := s.ReadReviewRuns(\"\")\n266\t\tif e != nil {\n267\t\t\treturn DispatchPlan{}, e\n268\t\t}\n269\t\tif len(lost) > 0 {\n270\t\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff history incomplete: %v\", lost)\n271\t\t}\n272\t\tvar prior *ReviewRun\n273\t\tfor i := range runs {\n274\t\t\tif runs[i].RunID == id {\n275\t\t\t\tprior = &runs[i]\n276\t\t\t}\n277\t\t}\n278\t\tif prior == nil {\n279\t\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff predecessor not found\")\n280\t\t}\n281\t\tif why := handoffable(*prior); why != \"\" {\n282\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s cannot be handed off: %s\", prior.RunID, why)\n283\t\t}\n284\t\tif prior.AttemptID == \"\" {\n285\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was recorded before attempts existed and cannot be continued\", prior.RunID)\n286\t\t}\n287\t\tif prior.Adapter == agent {\n288\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s already ran agent %s; resume it to continue the same agent\", prior.RunID, agent)\n289\t\t}\n290\t\tif why := s.reviewRunTranscriptIntact(*prior); why != \"\" {\n291\t\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff: %s\", why)\n292\t\t}\n293\t\tif prior.Safety != nil && prior.Safety.Operation.Outcome != OutcomeCompleted {\n294\t\t\treturn DispatchPlan{}, fmt.Errorf(\"predecessor cleanup incomplete; refusing continuation beside possible orphan\")\n295\t\t}\n296\t\tpolicy, _, e := s.LoadReviewersPolicyFor(prior.Kind)\n297\t\tif e != nil {\n298\t\t\treturn DispatchPlan{}, e\n299\t\t}\n300\t\tconfig, ok := policy.Adapters[agent]\n301\t\tif !ok {\n302\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: no agent %q can run this purpose\", agent)\n303\t\t}\n304\t\tbrief, e := s.RenderReviewBriefMatching(prior.BundleID, prior.Kind, prior.BriefNotes, prior.BriefDigest)\n305\t\tif e != nil {\n306\t\t\treturn DispatchPlan{}, e\n307\t\t}\n308\t\tbundle, e := s.LoadReviewBundle(prior.BundleID)\n309\t\tif e != nil {\n310\t\t\treturn DispatchPlan{}, e\n311\t\t}\n312\t\tif brief.Digest != prior.BriefDigest || bundle.BundleDigest != prior.BundleDigest || bundle.Payload.Subject.Head != prior.SealedCommit {\n313\t\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff bundle or brief digest changed\")\n314\t\t}\n315\t\torigin, e := dispatchWorktreeIdentity(s.Root)\n316\t\tif e != nil {\n317\t\t\treturn DispatchPlan{}, e\n318\t\t}\n319\t\tsection := s.handoffSectionFor(*prior)\n320\t\thandoffBrief := brief\n321\t\thandoffBrief.Text = brief.Text + section\n322\t\tplan := DispatchPlan{predecessor: prior, handoff: true, handoffSection: section, notes: prior.BriefNotes, Reason: prior.Reason,\n323\t\t\tPolicyDigest: directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")), OriginWorktree: origin, Adapter: agent, Config: config,\n324\t\t\tBrief: handoffBrief, Bundle: bundle, SealedCommit: prior.SealedCommit}\n325\t\tcontinuationRound(&plan, *prior, true)\n326\t\tif e = s.checkDispatchOrigin(plan); e != nil {\n327\t\t\treturn DispatchPlan{}, e\n328\t\t}\n329\t\texisting, e := s.existingReviewContinuation(*prior, runs)\n330\t\tif e != nil {\n331\t\t\tvar pending *PendingReviewContinuation\n332\t\t\tif errors.As(e, &pending) {\n333\t\t\t\tplan.PendingContinuation = pending\n334\t\t\t\treturn plan, nil\n335\t\t\t}\n336\t\t\treturn DispatchPlan{}, e\n337\t\t}\n338\t\tif existing != nil {\n339\t\t\tif existing.HandsOffFrom != prior.RunID || existing.Adapter != agent {\n340\t\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was already continued by run %s\", prior.RunID, existing.RunID)\n341\t\t\t}\n342\t\t\tplan.Existing = existing\n343\t\t\treturn plan, nil\n344\t\t}\n345\t\tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\n346\t\tif e != nil {\n347\t\t\treturn DispatchPlan{}, e\n348\t\t}\n349\t\tif count >= limit || spent >= total {\n350\t\t\treturn DispatchPlan{}, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"pose: the attempt's continuation budget is spent: %d continuations, %s wall-clock\", count, spent))\n351\t\t}\n352\t\ttimeout := 60 * time.Minute\n353\t\tif config.Timeout != \"\" {\n354\t\t\ttimeout, _ = time.ParseDuration(config.Timeout)\n355\t\t}\n356\t\tif total-spent < timeout {\n357\t\t\ttimeout = total - spent\n358\t\t}\n359\t\tplan.processTimeout = timeout\n360\t\ts.planImplementation(&plan, prior.Lead)\n361\t\tplan.provenance, e = s.prepareRunProvenance(plan, policy)\n362\t\tif e != nil {\n363\t\t\treturn DispatchPlan{}, e\n364\t\t}\n365\t\treturn plan, nil\n366\t}\n367\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"03ccf4f8-2fe5-41aa-8486-f25927e74900","timestamp":"2026-11-26T08:19:18.938Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-ed41371fa91497af9df96f254af372d5/worktree/pose-mcp/internal/pose/delegation_handoff.go","content":"const delegationHandoffBound = 16 << 10\n\n// continues names the run r continues, by a resume or a handoff.\nfunc (r ReviewRun) continues() string {\n\tif r.Resumes != \"\" {\n\t\treturn r.Resumes\n\t}\n\treturn r.HandsOffFrom\n}\n\n// handoffable reports why a run cannot be handed off, or \"\" when it can (R1).\nfunc handoffable(r ReviewRun) string {\n\tswitch r.Status {\n\tcase ReviewRunInterrupted, ReviewRunFailed:\n\t\treturn \"\"\n\tcase ReviewRunCompleted:\n\t\treturn \"it completed: a concluded run is not handed off; start a new run with a reason\"\n\t}\n\treturn \"it is \" + r.Status\n}\n\n// renderHandoffSection is the labelled section the handoff brief carries:\n// derived only from the predecessor's recorded output and normalized events,\n// so a verifier derives the same bytes.\nfunc renderHandoffSection(prior ReviewRun, events []DelegationEvent, eventsErr error) string {\n\treturn renderHandoffSectionWith(prior, events, eventsErr, handoffCommands)\n}\n\nfunc renderHandoffSectionWith(prior ReviewRun, events []DelegationEvent, eventsErr error, render func([]DelegationEvent) []string) string {\n\tvar b strings.Builder\n\tcause := prior.Status\n\tif prior.Interruption != nil {\n\t\tcause += \", \" + prior.Interruption.Cause\n\t} else if prior.Failure != \"\" {\n\t\tcause += \", \" + firstLine(prior.Failure)\n\t}\n\tfmt.Fprintf(&b, \"\\n## Handoff from run %s (%s, %s)\\n\\n\", prior.RunID, prior.Adapter, cause)\n\tb.WriteString(\"The run above stopped before it concluded and you continue its task. What follows is what it recorded. It is not a review, a verdict or evidence: re-verify anything you rely on, and conclude only from your own work.\\n\\n\")\n\tpartial := strings.TrimSpace(prior.Output)\n\tfmt.Fprintf(&b, \"### Partial final message (%s)\\n\\n\", digestBytes([]byte(prior.Output)))\n\tif partial == \"\" {\n\t\tb.WriteString(\"> (none)\\n\")\n\t}\n\tfor _, line := range strings.Split(partial, \"\\n\") {\n\t\tif partial != \"\" {\n\t\t\tb.WriteString(\"> \" + line + \"\\n\")\n\t\t}\n\t}\n\tb.WriteString(\"\\n\")\n\tcommands := render(events)\n\tlisted := strings.Join(commands, \"\\n\")\n\tfmt.Fprintf(&b, \"### Commands it ran (%s)\\n\\n\", digestBytes([]byte(listed)))\n\tswitch {\n\tcase eventsErr != nil:\n\t\tb.WriteString(\"> (its normalized events could not be read: \" + eventsErr.Error() + \")\\n\")\n\tcase prior.EventsDigest == \"\":\n\t\tb.WriteString(\"> (the run recorded no normalized events, so its commands are not known)\\n\")\n\tcase len(commands) == 0:\n\t\tb.WriteString(\"> (none)\\n\")\n\tdefault:\n\t\tb.WriteString(listed + \"\\n\")\n\t}\n\tsection := b.String()\n\tif len(section) > delegationHandoffBound {\n\t\tcut := delegationHandoffBound\n\t\tfor cut > 0 && !utf8RuneStart(section[cut]) {\n\t\t\tcut--\n\t\t}\n\t\tsection = section[:cut] + \"\\n\\n> (this section was cut at \" + fmt.Sprint(delegationHandoffBound) + \" bytes; the rest is in the predecessor's record)\\n\"\n\t}\n\treturn section\n}\n\n// handoffCommands lists the commands a run made with their exit status. An\n// output is paired with a call only when nothing else could have produced it:\n// by a call identifier that names exactly one waiting call, or, without one,\n// when exactly one call waits and none is owed an earlier ambiguous output.\n// Anything else is listed with its status unknown rather than guessed (R3).\nfunc handoffCommands(events []DelegationEvent) []string {\n\ttype call struct {\n\t\ttext string\n\t\texit string\n\t}\n\tvar calls []*call\n\tbyID := map[string][]*call{} // waiting calls by identifier\n\tambiguous := map[string]bool{}\n\tvar anonymous []*call // waiting calls without an identifier\n\t// unclaimed counts outputs still owed to calls that became ambiguous:\n\t// until they arrive, no anonymous output is paired by elimination.\n\tunclaimed := 0\n\twaitingIdentified := func() int {\n\t\tn := 0\n\t\tfor _, waiting := range byID {\n\t\t\tn += len(waiting)\n\t\t}\n\t\treturn n\n\t}\n\tunknown := func(code string) {\n\t\tcalls = append(calls, &call{text: \"(an output whose command is not known)\", exit: code})\n\t}\n\tfor _, e := range events {\n\t\tswitch e.Kind {\n\t\tcase DelegationEventToolCall:\n\t\t\tc := &call{text: strings.ReplaceAll(strings.Join(strings.Fields(e.Text), \" \"), \"`\", \"'\"), exit: \"unknown\"}\n\t\t\tcalls = append(calls, c)\n\t\t\tif e.Call == \"\" {\n\t\t\t\tanonymous = append(anonymous, c)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tbyID[e.Call] = append(byID[e.Call], c)\n\t\t\tif len(byID[e.Call]) > 1 {\n\t\t\t\tambiguous[e.Call] = true\n\t\t\t}\n\t\tcase DelegationEventToolOutput:\n\t\t\tcode := \"unknown\"\n\t\t\tif e.ExitCode != nil {\n\t\t\t\tcode = fmt.Sprint(*e.ExitCode)\n\t\t\t}\n\t\t\tif e.Call != \"\" {\n\t\t\t\twaiting := byID[e.Call]\n\t\t\t\tswitch {\n\t\t\t\tcase len(waiting) == 0:\n\t\t\t\t\tunknown(code)\n\t\t\t\tcase ambiguous[e.Call]:\n\t\t\t\t\t// Several calls share the identifier: one of them ended,\n\t\t\t\t\t// which one is not known.\n\t\t\t\t\tunknown(code)\n\t\t\t\t\tbyID[e.Call] = waiting[1:]\n\t\t\t\tdefault:\n\t\t\t\t\twaiting[0].exit = code\n\t\t\t\t\tdelete(byID, e.Call)\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif len(anonymous) == 1 && waitingIdentified() == 0 && unclaimed == 0 {\n\t\t\t\tanonymous[0].exit = code\n\t\t\t\tanonymous = nil\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// Several calls wait, or none: which command this output belongs\n\t\t\t// to is not known, and the anonymous calls it may answer stay\n\t\t\t// unknown.\n\t\t\tunknown(code)\n\t\t\tunclaimed += len(anonymous)\n\t\t\tanonymous = nil\n\t\t\tif unclaimed > 0 {\n\t\t\t\tunclaimed--\n\t\t\t}\n\t\t}\n\t}\n\tout := make([]string, 0, len(calls))\n\tfor _, c := range calls {\n\t\tout = append(out, fmt.Sprintf(\"> `%s` → exit %s\", c.text, c.exit))\n\t}\n\treturn out\n}\n\nfunc firstLine(s string) string {\n\tline, _, _ := strings.Cut(strings.TrimSpace(s), \"\\n\")\n\treturn line\n}\n\n// attemptContinuationBudget is what attempt of prior has spent and may spend:\n// its ceiling is the resume budget of the agent that opened it, whichever agent\n// continues it, so changing agents never widens it (spec\n// pose-delegation-handoff R2, D1).\nfunc attemptContinuationBudget(runs []ReviewRun, prior ReviewRun, policy ReviewersPolicy) (int, time.Duration, int, time.Duration, error) {\n\tvar origin *ReviewRun\n\tcount, spent := 0, time.Duration(0)\n\tfor i, r := range runs {\n\t\tif r.AttemptID != prior.AttemptID || r.SupersededBy != \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tstart, e1 := time.Parse(time.RFC3339Nano, r.StartedAt)\n\t\tend, e2 := time.Parse(time.RFC3339Nano, r.EndedAt)\n\t\tif e1 != nil || e2 != nil || end.Before(start) {\n\t\t\treturn 0, 0, 0, 0, fmt.Errorf(\"invalid accumulated wall-clock evidence\")\n\t\t}\n\t\tspent += end.Sub(start)\n\t\tif r.continues() != \"\" {\n\t\t\tcount++\n\t\t} else {\n\t\t\torigin = &runs[i]\n\t\t}\n\t}\n\tif origin == nil {\n\t\treturn 0, 0, 0, 0, fmt.Errorf(\"pose: the first run of attempt %s is not recorded, so its continuation budget cannot be read\", prior.AttemptID)\n\t}\n\tconfig, ok := policy.Adapters[origin.Adapter]\n\tif !ok {\n\t\treturn 0, 0, 0, 0, fmt.Errorf(\"pose: agent %s, which opened attempt %s, is no longer configured, so its continuation budget cannot be read\", origin.Adapter, prior.AttemptID)\n\t}\n\tlimit, total := 3, 60*time.Minute\n\tif config.Resume != nil {\n\t\tif config.Resume.MaxResumes > 0 {\n\t\t\tlimit = config.Resume.MaxResumes\n\t\t}\n\t\tif config.Resume.MaxWallTime != \"\" {\n\t\t\ttotal, _ = time.ParseDuration(config.Resume.MaxWallTime)\n\t\t}\n\t}\n\treturn count, spent, limit, total, nil\n}\n\n// handoffSectionFor reads the predecessor's events and renders its section.\nfunc (s Store) handoffSectionFor(prior ReviewRun) string {\n\tevents, err := s.ReadDelegationEvents(prior)\n\treturn renderHandoffSection(prior, events, err)\n}\n\n// recordedHandoffSection is the section run was sent, derived again from its\n// predecessor's record with the renderer run recorded, or \"\" when no renderer\n// of that version yields the digest run carries.\nfunc (s Store) recordedHandoffSection(run, prior ReviewRun) string {\n\tevents, err := s.ReadDelegationEvents(prior)\n\treturn handoffSectionMatching(run, prior, events, err)\n}\n\nfunc handoffSectionMatching(run, prior ReviewRun, events []DelegationEvent, err error) string {\n\tfor _, render := range handoffRenderers[run.HandoffRenderer] {\n\t\tif section := renderHandoffSectionWith(prior, events, err, render); digestBytes([]byte(section)) == run.HandoffDigest {\n\t\t\treturn section\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// PlanReviewHandoff plans the continuation of run id by agent, under the same\n// attempt and its continuation budget (R1–R4).\nfunc (s Store) PlanReviewHandoff(id, agent string) (DispatchPlan, error) {\n\truns, lost, e := s.ReadReviewRuns(\"\")\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif len(lost) > 0 {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff history incomplete: %v\", lost)\n\t}\n\tvar prior *ReviewRun\n\tfor i := range runs {\n\t\tif runs[i].RunID == id {\n\t\t\tprior = &runs[i]\n\t\t}\n\t}\n\tif prior == nil {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff predecessor not found\")\n\t}\n\tif why := handoffable(*prior); why != \"\" {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s cannot be handed off: %s\", prior.RunID, why)\n\t}\n\tif prior.AttemptID == \"\" {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was recorded before attempts existed and cannot be continued\", prior.RunID)\n\t}\n\tif prior.Adapter == agent {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s already ran agent %s; resume it to continue the same agent\", prior.RunID, agent)\n\t}\n\tif why := s.reviewRunTranscriptIntact(*prior); why != \"\" {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff: %s\", why)\n\t}\n\tif prior.Safety != nil && prior.Safety.Operation.Outcome != OutcomeCompleted {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"predecessor cleanup incomplete; refusing continuation beside possible orphan\")\n\t}\n\tpolicy, _, e := s.LoadReviewersPolicyFor(prior.Kind)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tconfig, ok := policy.Adapters[agent]\n\tif !ok {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: no agent %q can run this purpose\", agent)\n\t}\n\tbrief, e := s.RenderReviewBriefMatching(prior.BundleID, prior.Kind, prior.BriefNotes, prior.BriefDigest)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tbundle, e := s.LoadReviewBundle(prior.BundleID)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif brief.Digest != prior.BriefDigest || bundle.BundleDigest != prior.BundleDigest || bundle.Payload.Subject.Head != prior.SealedCommit {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff bundle or brief digest changed\")\n\t}\n\torigin, e := dispatchWorktreeIdentity(s.Root)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tsection := s.handoffSectionFor(*prior)\n\thandoffBrief := brief\n\thandoffBrief.Text = brief.Text + section\n\tplan := DispatchPlan{predecessor: prior, handoff: true, handoffSection: section, notes: prior.BriefNotes, Reason: prior.Reason,\n\t\tPolicyDigest: directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")), OriginWorktree: origin, Adapter: agent, Config: config,\n\t\tBrief: handoffBrief, Bundle: bundle, SealedCommit: prior.SealedCommit}\n\tcontinuationRound(&plan, *prior, true)\n\tif e = s.checkDispatchOrigin(plan); e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\texisting, e := s.existingReviewContinuation(*prior, runs)\n\tif e != nil {\n\t\tvar pending *PendingReviewContinuation\n\t\tif errors.As(e, &pending) {\n\t\t\tplan.PendingContinuation = pending\n\t\t\treturn plan, nil\n\t\t}\n\t\treturn DispatchPlan{}, e\n\t}\n\tif existing != nil {\n\t\tif existing.HandsOffFrom != prior.RunID || existing.Adapter != agent {\n\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was already continued by run %s\", prior.RunID, existing.RunID)\n\t\t}\n\t\tplan.Existing = existing\n\t\treturn plan, nil\n\t}\n\tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif count >= limit || spent >= total {\n\t\treturn DispatchPlan{}, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"pose: the attempt's continuation budget is spent: %d continuations, %s wall-clock\", count, spent))\n\t}\n\ttimeout := 60 * time.Minute\n\tif config.Timeout != \"\" {\n\t\ttimeout, _ = time.ParseDuration(config.Timeout)\n\t}\n\tif total-spent < timeout {\n\t\ttimeout = total - spent\n\t}\n\tplan.processTimeout = timeout\n\ts.planImplementation(&plan, prior.Lead)\n\tplan.provenance, e = s.prepareRunProvenance(plan, policy)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\treturn plan, nil\n}\n","numLines":333,"startLine":35,"totalLines":367}},"tool_result_meta":[{"id":"toolu_017BtYshsvCFvL6owAC7Pqrs","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
