tory setup failed: \"+err.Error())\n812\t\t}\n813\t\tsafety.RuntimeID = filepath.Base(tmp)\n814\t\towned, err := os.Lstat(tmp)\n815\t\tif err != nil {\n816\t\t\t// Nothing is in it yet: removing it keeps the attempt's path free\n817\t\t\t// for its next run (review round 1, N4).\n818\t\t\t_ = os.Remove(tmp)\n819\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n820\t\t}\n821\t\truntimeRoot, err := os.OpenRoot(tmp)\n822\t\tif err != nil {\n823\t\t\t_ = os.Remove(tmp)\n824\t\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n825\t\t}\n826\t\tdefer runtimeRoot.Close()\n827\t\tvar worktreeOwned os.FileInfo\n828\t\tvar gitMarker []byte\n829\t\tvar ownership *reviewCleanupOwnership\n830\t\tworktree := filepath.Join(tmp, \"worktree\")\n831\t\tcleanup = func() error {\n832\t\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n833\t\t}\n834\t\thooks := filepath.Join(tmp, \"empty-hooks\")\n835\t\tif err := os.Mkdir(hooks, 0700); err != nil {\n836\t\t\treturn finish(ReviewRunFailed, \"private hook directory setup failed\")\n837\t\t}\n838\t\tsetupCtx, stopSetup := context.WithTimeout(parent, 2*time.Minute)\n839\t\tdefer stopSetup()\n840\t\tsetup := reviewSetupCommand(setupCtx, gitCommand(\"-C\", s.Root, \"-c\", \"core.hooksPath=\"+hooks, \"worktree\", \"add\", \"--detach\", worktree, plan.SealedCommit))\n841\t\tsetupOutput := &reviewBoundedCapture{limit: 64 << 10, cancel: stopSetup}\n842\t\tsetup.Stdout, setup.Stderr = setupOutput, setupOutput\n843\t\tsetupErr := setup.Run()\n844\t\t_, setupOverflow := setupOutput.result()\n845\t\tterminationErr := killProcessGroup(setup)\n846\t\tif terminationErr != nil {\n847\t\t\tterminationFailed = true\n848\t\t}\n849\t\tsetupCause := executionCause(setupCtx)\n850\t\tif setupErr != nil || terminationErr != nil || setupOverflow {\n851\t\t\tsafety.ExecutionCause = setupCause\n852\t\t\tif setupOverflow {\n853\t\t\t\tsafety.ExecutionCause = \"setup-capture-l