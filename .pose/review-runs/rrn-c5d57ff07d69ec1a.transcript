n\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n\t}\n\tif plan.predecessor == nil {\n\t\tbeforeAttemptPublished(s, attempt)\n\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n\t\t\tstopActive()\n\t\t\treturn ReviewRun{}, err\n\t\t}\n\t\treserved = true\n\t}\n\t// The marker goes only once the record and the attempt result are\n\t// published: without them it is the one trace of the reserved attempt,\n\t// and a waiter that sees it gone must find the receipt.\n\tdefer func() {\n\t\tpublishResult()\n\t\tstopActive(resultErr != nil || result.Path == \"\")\n\t}()\n\tcancelled = cancelFlag\n\t// A detached run that cannot hand its attempt back stops here: nobody\n\t// would know which attempt runs (R1).\n\tif plan.OnStart != nil {\n\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n\t\t}\n\t}\n\ttmp, err := reviewRunRuntimeDir(run.AttemptID)\n\tif err != nil {\n\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed: \"+err.Error())\n\t}\n\tsafety.RuntimeID = filepath.Base(tmp)\n\towned, err := os.Lstat(tmp)\n\tif err != nil {\n\t\t// Nothing is in it yet: removing it keeps the attempt's path free\n\t\t// for its next run (review round 1, N4).\n\t\t_ = os.Remove(tmp)\n\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n\t}\n\truntimeRoot, err := os.OpenRoot(tmp)\n\tif err != nil {\n\t\t_ = os.Remove(tmp)\n\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n\t}\n\tdefer runtimeRoot.Close()\n\tvar worktreeOwned os.FileInfo\n\tvar gitMarker []byte\n\tvar ownership *reviewCleanupOwnership\n\tworktree := filepath.Join(tmp, \"worktree\")\n\tcleanup = func() error {\n\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n\t}\n\thooks := filepath.Join(tmp, \"empty-hooks\")\n\tif err := os.Mkdir(hooks, 0700); err