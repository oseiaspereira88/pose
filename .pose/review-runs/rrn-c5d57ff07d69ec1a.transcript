69\tfunc existingReviewDispatchResult(run ReviewRun) (ReviewRun, error) {\n770\t\tif run.Safety != nil && run.Safety.Operation.Outcome != OutcomeCompleted {\n771\t\t\treturn run, fmt.Errorf(\"existing dispatch has incomplete cleanup; no new adapter was started\")\n772\t\t}\n773\t\treturn run, nil\n774\t}\n775\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"b62bc9ea-0c95-4b4a-a5f8-d458749b049f","timestamp":"2026-11-26T08:19:19.698Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-ed41371fa91497af9df96f254af372d5/worktree/pose-mcp/internal/pose/review_adapter_containment.go","content":"\t\tif commit := strings.TrimSpace(string(head)); !strings.HasPrefix(commit, \"ref:\") && commit != \"\" {\n\t\t\tif listing, err := listCommittedTree(s.Root, commit); err == nil {\n\t\t\t\to.inventoryBytes = gitSnapshotBudget(gitCommittedTreeBytes(listing))\n\t\t\t}\n\t\t}\n\t}\n\tchild, err := registry.OpenRoot(name)\n\tif err != nil {\n\t\tregistry.Close()\n\t\treturn nil, err\n\t}\n\tbacklink, err := readReviewRootFile(child, \"gitdir\", 4096)\n\tchild.Close()\n\tif err != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n\t\tregistry.Close()\n\t\treturn nil, fmt.Errorf(\"worktree registration backlink differs\")\n\t}\n\treturn o, nil\n}\n\nfunc (s Store) cleanupReviewResources(tmp string, owned os.FileInfo, worktree string, worktreeOwned os.FileInfo, gitMarker []byte, ownership ...*reviewCleanupOwnership) error {\n\tvar o *reviewCleanupOwnership\n\tif len(ownership) > 0 {\n\t\to = ownership[0]\n\t}\n\tcurrent, err := os.Lstat(tmp)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\tif (o != nil && !o.removed) || (o == nil && worktreeOwned != nil) {\n\t\t\treturn fmt.Errorf(\"runtime path disappeared without confirmed cleanup; resources may remain\")\n\t\t}\n\t\treturn nil\n\t}\n\tif err != nil || !current.IsDir() || !os.SameFile(owned, current) {\n\t\treturn fmt.Errorf(\"cleanup refused: runtime directory identity changed\")\n\t}\n\n\tvar root *os.Root\n\tif o != nil {\n\t\troot = o.runtime\n\t} else {\n\t\troot, err = os.OpenRoot(tmp)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"runtime cleanup root unavailable\")\n\t\t}\n\t\tdefer root.Close()\n\t}\n\tstat, err := root.Stat(\".\")\n\tif err != nil || !os.SameFile(owned, stat) {\n\t\treturn fmt.Errorf(\"runtime cleanup root identity changed\")\n\t}\n\tif worktreeOwned != nil {\n\t\tinfo, err := root.Lstat(\"worktree\")\n\t\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\t\treturn fmt.Errorf(\"worktree cleanup unavailable\")\n\t\t}\n\t\tif err == nil {\n\t\t\tmarker, e := readReviewRootFile(root, \"worktree/.git\", 4096)\n\t\t\tif e != nil || !info.IsDir() || !os.SameFile(worktreeOwned, info) || !bytes.Equal(marker, gitMarker) {\n\t\t\t\treturn fmt.Errorf(\"cleanup refused: worktree identity changed\")\n\t\t\t}\n\t\t}\n\t\tif o == nil || o.registry == nil {\n\t\t\treturn fmt.Errorf(\"cleanup registration ownership unavailable; resources retained\")\n\t\t}\n\t\tinfo, e := o.registry.Lstat(o.registration)\n\t\tif e != nil || !info.IsDir() || !os.SameFile(info, o.registrationInfo) {\n\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n\t\t}\n\t\tregistration, e := o.registry.OpenRoot(o.registration)\n\t\tif e != nil {\n\t\t\treturn fmt.Errorf(\"cleanup registration unavailable\")\n\t\t}\n\t\tdefer registration.Close()\n\t\tinfo, e = registration.Stat(\".\")\n\t\tif e != nil || !os.SameFile(info, o.registrationInfo) {\n\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n\t\t}\n\t\tbacklink, e := readReviewRootFile(registration, \"gitdir\", 4096)\n\t\tif e != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n\t\t\treturn fmt.Errorf(\"cleanup registration backlink changed\")\n\t\t}\n\t\tfor _, lock := range []string{\"locked\", \"index.lock\", \"HEAD.lock\"} {\n\t\t\tif _, e := registration.Lstat(lock); !errors.Is(e, os.ErrNotExist) {\n\t\t\t\treturn fmt.Errorf(\"worktree registration has a live or unknown lock; resources retained\")\n\t\t\t}\n\t\t}\n\t\tif err == nil {\n\t\t\ttree, e := root.OpenRoot(\"worktree\")\n\t\t\tif e != nil {\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup root unavailable\")\n\t\t\t}\n\t\t\tinfo, e := tree.Stat(\".\")\n\t\t\tif e != nil || !os.SameFile(info, worktreeOwned) {\n\t\t\t\ttree.Close()\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup identity changed\")\n\t\t\t}\n\t\t\tlimit := gitSnapshotMarginBytes\n\t\t\tif o.inventoryBytes > limit {\n\t\t\t\tlimit = o.inventoryBytes\n\t\t\t}\n\t\t\te = removeReviewOwnedContents(tree, 100000, limit)\n\t\t\ttree.Close()\n\t\t\tif e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tif e := root.Remove(\"worktree\"); e != nil && !errors.Is(e, os.ErrNotExist) {\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup incomplete\")\n\t\t\t}\n\t\t}\n\t\tif e := removeReviewOwnedContents(registration, 1024, 256<<20); e != nil {\n\t\t\treturn e\n\t\t}\n\t\tregistration.Close()\n\t\tif e := o.registry.Remove(o.registration); e != nil && !errors.Is(e, os.ErrNotExist) {\n\t\t\treturn fmt.Errorf(\"worktree registration cleanup incomplete\")\n\t\t}\n\t} else if _, e := root.Lstat(\"worktree\"); !errors.Is(e, os.ErrNotExist) {\n\t\treturn fmt.Errorf(\"partial worktree setup has no verified ownership; resources retained\")\n\t}\n\tif o != nil && o.gitlinkMetadata != nil {\n\t\tif err := removeReviewGitlinkMetadata(root, o.gitlinkMetadata, o.gitlinkMetadataBytes); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := removeReviewGoBuildLeftovers(root); err != nil {\n\t\treturn err\n\t}\n\tif err := removeReviewOwnedContents(root, reviewRuntimeMaxEntries, 128<<20); err != nil {\n\t\treturn err\n\t}\n\tcurrent, err = os.Lstat(tmp)\n\tif err != nil || !os.SameFile(owned, current) {\n\t\treturn fmt.Errorf(\"runtime path changed during cleanup; replacement retained\")\n\t}\n\tif err := os.Remove(tmp); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\treturn fmt.Errorf(\"runtime directory cleanup incomplete\")\n\t}\n\tif o != nil {\n\t\to.removed = true\n\t}\n\treturn nil\n}\n\n// Private gitlink stores are charged separately from the adapter's runtime\n// output. Both the opened directory and the removal target must be the\n// directory setup created inside the operation root.\nfunc removeReviewGitlinkMetadata(root *os.Root, owned os.FileInfo, limit int64) error {\n\tdir, err := root.OpenRoot(reviewGitlinkMetadataDir)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"private gitlink metadata cleanup unavailable\")\n\t}\n\tdefer dir.Close()\n\tinfo, err := dir.Stat(\".\")\n\tif err != nil || !os.SameFile(owned, info) {\n\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n\t}\n\tif err := removeReviewOwnedContents(dir, 100000, limit); err != nil {\n\t\treturn err\n\t}\n\tinfo, err = root.Lstat(reviewGitlinkMetadataDir)\n\tif err != nil || !os.SameFile(owned, info) {\n\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n\t}\n\tdir.Close()\n\tif err := root.Remove(reviewGitlinkMetadataDir); err != nil {\n\t\treturn fmt.Errorf(\"private gitlink metadata cleanup incomplete\")\n\t}\n\treturn nil\n}\n\n// reviewGoBuildDir names the temporary build directory the Go toolchain\n// creates under the TMPDIR the engine gives a review run.\nvar reviewGoBuildDir = regexp.MustCompile(`^go-build[0-9]+$`)\n\n// reviewGoBuildBeforeOpen runs after a go-build name is listed and before it\n// is opened, reviewGoBuildAfterContents after the directory is emptied and\n// before its name is checked again, and reviewGoBuildBeforeRemove between that\n// check and the removal; tests use them to change the name there.\nvar (\n\treviewGoBuildBeforeOpen    = func(string) {}\n\treviewGoBuildAfterContents = func(string) {}\n\treviewGoBuildBeforeRemove  = func(string) {}\n)\n\n// removeReviewGoBuildLeftovers removes the Go build directories a reviewer's\n// interrupted `go test` or `go build` left at the top of the run's runtime\n// directory, each under its own bounded