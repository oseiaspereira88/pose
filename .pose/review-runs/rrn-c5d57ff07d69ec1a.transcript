{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BTVmXCyZsXqb7wgzaie7Cy","type":"tool_result","content":"490\t\t\tif commit := strings.TrimSpace(string(head)); !strings.HasPrefix(commit, \"ref:\") && commit != \"\" {\n491\t\t\t\tif listing, err := listCommittedTree(s.Root, commit); err == nil {\n492\t\t\t\t\to.inventoryBytes = gitSnapshotBudget(gitCommittedTreeBytes(listing))\n493\t\t\t\t}\n494\t\t\t}\n495\t\t}\n496\t\tchild, err := registry.OpenRoot(name)\n497\t\tif err != nil {\n498\t\t\tregistry.Close()\n499\t\t\treturn nil, err\n500\t\t}\n501\t\tbacklink, err := readReviewRootFile(child, \"gitdir\", 4096)\n502\t\tchild.Close()\n503\t\tif err != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n504\t\t\tregistry.Close()\n505\t\t\treturn nil, fmt.Errorf(\"worktree registration backlink differs\")\n506\t\t}\n507\t\treturn o, nil\n508\t}\n509\t\n510\tfunc (s Store) cleanupReviewResources(tmp string, owned os.FileInfo, worktree string, worktreeOwned os.FileInfo, gitMarker []byte, ownership ...*reviewCleanupOwnership) error {\n511\t\tvar o *reviewCleanupOwnership\n512\t\tif len(ownership) > 0 {\n513\t\t\to = ownership[0]\n514\t\t}\n515\t\tcurrent, err := os.Lstat(tmp)\n516\t\tif errors.Is(err, os.ErrNotExist) {\n517\t\t\tif (o != nil && !o.removed) || (o == nil && worktreeOwned != nil) {\n518\t\t\t\treturn fmt.Errorf(\"runtime path disappeared without confirmed cleanup; resources may remain\")\n519\t\t\t}\n520\t\t\treturn nil\n521\t\t}\n522\t\tif err != nil || !current.IsDir() || !os.SameFile(owned, current) {\n523\t\t\treturn fmt.Errorf(\"cleanup refused: runtime directory identity changed\")\n524\t\t}\n525\t\n526\t\tvar root *os.Root\n527\t\tif o != nil {\n528\t\t\troot = o.runtime\n529\t\t} else {\n530\t\t\troot, err = os.OpenRoot(tmp)\n531\t\t\tif err != nil {\n532\t\t\t\treturn fmt.Errorf(\"runtime cleanup root unavailable\")\n533\t\t\t}\n534\t\t\tdefer root.Close()\n535\t\t}\n536\t\tstat, err := root.Stat(\".\")\n537\t\tif err != nil || !os.SameFile(owned, stat) {\n538\t\t\treturn fmt.Errorf(\"runtime cleanup root identity changed\")\n539\t\t}\n540\t\tif worktreeOwned != nil {\n541\t\t\tinfo, err := root.Lstat(\"worktree\")\n542\t\t\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n543\t\t\t\treturn fmt.Errorf(\"worktree cleanup unavailable\")\n544\t\t\t}\n545\t\t\tif err == nil {\n546\t\t\t\tmarker, e := readReviewRootFile(root, \"worktree/.git\", 4096)\n547\t\t\t\tif e != nil || !info.IsDir() || !os.SameFile(worktreeOwned, info) || !bytes.Equal(marker, gitMarker) {\n548\t\t\t\t\treturn fmt.Errorf(\"cleanup refused: worktree identity changed\")\n549\t\t\t\t}\n550\t\t\t}\n551\t\t\tif o == nil || o.registry == nil {\n552\t\t\t\treturn fmt.Errorf(\"cleanup registration ownership unavailable; resources retained\")\n553\t\t\t}\n554\t\t\tinfo, e := o.registry.Lstat(o.registration)\n555\t\t\tif e != nil || !info.IsDir() || !os.SameFile(info, o.registrationInfo) {\n556\t\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n557\t\t\t}\n558\t\t\tregistration, e := o.registry.OpenRoot(o.registration)\n559\t\t\tif e != nil {\n560\t\t\t\treturn fmt.Errorf(\"cleanup registration unavailable\")\n561\t\t\t}\n562\t\t\tdefer registration.Close()\n563\t\t\tinfo, e = registration.Stat(\".\")\n564\t\t\tif e != nil || !os.SameFile(info, o.registrationInfo) {\n565\t\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n566\t\t\t}\n567\t\t\tbacklink, e := readReviewRootFile(registration, \"gitdir\", 4096)\n568\t\t\tif e != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n569\t\t\t\treturn fmt.Errorf(\"cleanup registration backlink changed\")\n570\t\t\t}\n571\t\t\tfor _, lock := range []string{\"locked\", \"index.lock\", \"HEAD.lock\"} {\n572\t\t\t\tif _, e := registration.Lstat(lock); !errors.Is(e, os.ErrNotExist) {\n573\t\t\t\t\treturn fmt.Errorf(\"worktree registration has a live or unknown lock; resources retained\")\n574\t\t\t\t}\n575\t\t\t}\n576\t\t\tif err == nil {\n577\t\t\t\ttree, e := root.OpenRoot(\"worktree\")\n578\t\t\t\tif e != nil {\n579\t\t\t\t\treturn fmt.Errorf(\"worktree cleanup root unavailable\")\n580\t\t\t\t}\n581\t\t\t\tinfo, e := tree.Stat(\".\")\n582\t\t\t\tif e != nil || !os.SameFile(info, worktreeOwned) {\n583\t\t\t\t\ttree.Close()\n584\t\t\t\t\treturn fmt.Errorf(\"worktree cleanup identity changed\")\n585\t\t\t\t}\n586\t\t\t\tlimit := gitSnapshotMarginBytes\n587\t\t\t\tif o.inventoryBytes > limit {\n588\t\t\t\t\tlimit = o.inventoryBytes\n589\t\t\t\t}\n590\t\t\t\te = removeReviewOwnedContents(tree, 100000, limit)\n591\t\t\t\ttree.Close()\n592\t\t\t\tif e != nil {\n593\t\t\t\t\treturn e\n594\t\t\t\t}\n595\t\t\t\tif e := root.Remove(\"worktree\"); e != nil && !errors.Is(e, os.ErrNotExist) {\n596\t\t\t\t\treturn fmt.Errorf(\"worktree cleanup incomplete\")\n597\t\t\t\t}\n598\t\t\t}\n599\t\t\tif e := removeReviewOwnedContents(registration, 1024, 256<<20); e != nil {\n600\t\t\t\treturn e\n601\t\t\t}\n602\t\t\tregistration.Close()\n603\t\t\tif e := o.registry.Remove(o.registration); e != nil && !errors.Is(e, os.ErrNotExist) {\n604\t\t\t\treturn fmt.Errorf(\"worktree registration cleanup incomplete\")\n605\t\t\t}\n606\t\t} else if _, e := root.Lstat(\"worktree\"); !errors.Is(e, os.ErrNotExist) {\n607\t\t\treturn fmt.Errorf(\"partial worktree setup has no verified ownership; resources retained\")\n608\t\t}\n609\t\tif o != nil && o.gitlinkMetadata != nil {\n610\t\t\tif err := removeReviewGitlinkMetadata(root, o.gitlinkMetadata, o.gitlinkMetadataBytes); err != nil {\n611\t\t\t\treturn err\n612\t\t\t}\n613\t\t}\n614\t\tif err := removeReviewGoBuildLeftovers(root); err != nil {\n615\t\t\treturn err\n616\t\t}\n617\t\tif err := removeReviewOwnedContents(root, reviewRuntimeMaxEntries, 128<<20); err != nil {\n618\t\t\treturn err\n619\t\t}\n620\t\tcurrent, err = os.Lstat(tmp)\n621\t\tif err != nil || !os.SameFile(owned, current) {\n622\t\t\treturn fmt.Errorf(\"runtime path changed during cleanup; replacement retained\")\n623\t\t}\n624\t\tif err := os.Remove(tmp); err != nil && !errors.Is(err, os.ErrNotExist) {\n625\t\t\treturn fmt.Errorf(\"runtime directory cleanup incomplete\")\n626\t\t}\n627\t\tif o != nil {\n628\t\t\to.removed = true\n629\t\t}\n630\t\treturn nil\n631\t}\n632\t\n633\t// Private gitlink stores are charged separately from the adapter's runtime\n634\t// output. Both the opened directory and the removal target must be the\n635\t// directory setup created inside the operation root.\n636\tfunc removeReviewGitlinkMetadata(root *os.Root, owned os.FileInfo, limit int64) error {\n637\t\tdir, err := root.OpenRoot(reviewGitlinkMetadataDir)\n638\t\tif err != nil {\n639\t\t\treturn fmt.Errorf(\"private gitlink metadata cleanup unavailable\")\n640\t\t}\n641\t\tdefer dir.Close()\n642\t\tinfo, err := dir.Stat(\".\")\n643\t\tif err != nil || !os.SameFile(owned, info) {\n644\t\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n645\t\t}\n646\t\tif err := removeReviewOwnedContents(dir, 100000, limit); err != nil {\n647\t\t\treturn err\n648\t\t}\n649\t\tinfo, err = root.Lstat(reviewGitlinkMetadataDir)\n650\t\tif err != nil || !os.SameFile(owned, info) {\n651\t\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n652\t\t}\n653\t\tdir.Close()\n654\t\tif err := root.Remove(reviewGitlinkMetadataDir); err != nil {\n655\t\t\treturn fmt.Errorf(\"private gitlink metadata cleanup incomplete\")\n656\t\t}\n657\t\treturn nil\n658\t}\n659\t\n660\t// reviewGoBuildDir names the temporary build directory the Go toolchain\n661\t// creates under the TMPDIR the engine gives a review run.\n662\tvar reviewGoBuildDir = regexp.MustCompile(`^go-build[0-9]+$`)\n663\t\n664\t// reviewGoBuildBeforeOpen runs after a go-build name is listed and before it\n665\t// is opened, reviewGoBuildAfterContents after the directory is emptied and\n666\t// before its name is checked again, and reviewGoBuildBeforeRemove between that\n667\t// check and the removal; tests use them to change the name there.\n668\tvar (\n669\t\treviewGoBuildBeforeOpen    = func(string) {}\n670\t\treviewGoBuildAfterContents = func(string) {}\n671\t\treviewGoBuildBeforeRemove  = func(string) {}\n672\t)\n673\t\n674\t// removeReviewGoBuildLeftovers removes the Go build directories a reviewer's\n675\t// interrupted `go test` or `go build` left at the top of the run's runtime\n676\t// directory, each under its own bounded inventory, before the runtime's own\n677\t// inventory, which a single test binary can exceed (spec\n678\t// pose-review-cleanup-removes-go-build-leftovers). Only a real directory is\n679\t// removed; the platform implementation opens it without blocking and only as\n680\t// a directory, so a link, a FIFO or any other entry stays for the runtime\n681\t// inventory to judge.\n682\tfunc removeReviewGoBuildLeftovers(root *os.Root) error {\n683\t\t// The top level is read in bounded batches and each go-build directory\n684\t\t// is removed as it is read, so nothing accumulates; only the other\n685\t\t// entries, which the runtime inventory will judge, count against its\n686\t\t// bound (review rounds 5 and 6, N6 and N10).\n687\t\tdir, err := root.Open(\".\")\n688\t\tif err != nil {\n689\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n690\t\t}\n691\t\tdefer dir.Close()\n692\t\tothers := 0\n693\t\tfor {\n694\t\t\tbatch, err := dir.Readdirnames(256)\n695\t\t\tfor _, name := range batch {\n696\t\t\t\tif !reviewGoBuildDir.MatchString(name) {\n697\t\t\t\t\tothers++\n698\t\t\t\t\tif others > reviewRuntimeMaxEntries {\n699\t\t\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n700\t\t\t\t\t}\n701\t\t\t\t\tcontinue\n702\t\t\t\t}\n703\t\t\t\tif err := removeReviewGoBuildDir(root, name); err != nil {\n704\t\t\t\t\treturn err\n705\t\t\t\t}\n706\t\t\t}\n707\t\t\tif len(batch) == 0 {\n708\t\t\t\tif err == nil || errors.Is(err, io.EOF) {\n709\t\t\t\t\treturn nil\n710\t\t\t\t}\n711\t\t\t\treturn fmt.Errorf(\"run