{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DBbBTGWHwYqFL5Ra1W52EE","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\t\"testing\"\n8\t)\n9\t\n10\tconst limitsSection = `\n11\t### Accepted limits\n12\t- L1: A process that clears its environment escapes. Accepted because the shim covers it.\n13\t- L2: Windows is untested here. Accepted because the host is Linux.\n14\t`\n15\t\n16\t// Spec pose-review-declared-threat-model R1: the section is read as\n17\t// written, and what does not say why it is accepted is reported.\n18\tfunc TestAcceptedLimitsAreParsed(t *testing.T) {\n19\t\tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n20\t\tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n21\t\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n22\t\t}\n23\t\t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n- L3: a marker with nothing after it. Accepted because\\n\")\n24\t\tjoined := strings.Join(problems, \"\\n\")\n25\t\tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\", \"L3 does not say why it is accepted\"} {\n26\t\t\tif !strings.Contains(joined, want) {\n27\t\t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n28\t\t\t}\n29\t\t}\n30\t}\n31\t\n32\t// R1: the review plan seals the limits the spec declares, and they enter the\n33\t// plan digest; a spec without limits keeps its digest.\n34\tfunc TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n35\t\troot, store := reviewBundleFixture(t)\n36\t\tbefore, err := store.ReviewPlan(\"spec:backend\")\n37\t\tif err != nil || len(before.AcceptedLimits) != 0 {\n38\t\t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n39\t\t}\n40\t\tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n41\t\traw, _ := os.ReadFile(path)\n42\t\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n43\t\t\tt.Fatal(err)\n44\t\t}\n45\t\tafter, err := store.ReviewPlan(\"spec:backend\")\n46\t\tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n47\t\t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n48\t\t}\n49\t\twithout := after\n50\t\twithout.AcceptedLimits = nil\n51\t\tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n52\t\t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n53\t\t}\n54\t}\n55\t\n56\t// R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n57\t// recorded within-limit, naming it, and does not block an approval whatever\n58\t// its severity; a limit the bundle did not seal accepts nothing.\n59\tfunc TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n60\t\tvar bundle ReviewBundle\n61\t\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n62\t\tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n63\t\t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n64\t\t}}\n65\t\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n66\t\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n67\t\t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n68\t\t}\n69\t\tatt.Decision = \"approved\"\n70\t\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n71\t\t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n72\t\t}\n73\t\tatt.Findings[0].Limit = \"L9\"\n74\t\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n75\t\t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n76\t\t}\n77\t\tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"  \\t \"\n78\t\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n79\t\t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n80\t\t}\n81\t}\n82\t\n83\t// Review round 1, N1: across the specs of a composite scope each limit is\n84\t// qualified by its spec, so a finding names exactly one.\n85\tfunc TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n86\t\tbody := \"### Accepted limits\\n- L1: one escape. Accepted because it is rare.\\n\"\n87\t\tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n88\t\tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n89\t\t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n90\t\t}\n91\t\tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n92\t\tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n93\t\t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n94\t\t}\n95\t}\n96\t\n97\t// Review round 2, N1: punctuation is not a reason, and a reason may start\n98\t// with a one-letter word.\n99\tfunc TestAnAcceptedLimitNeedsWordsAsItsReason(t *testing.T) {\n100\t\tfor text, want := range map[string]bool{\n101\t\t\t\"x. Accepted because ..\":                                          false,\n102\t\t\t\"x. Accepted because -- !\":                                        false,\n103\t\t\t\"x. Accepted because rare\":                                        false,\n104\t\t\t\"An escape. Accepted because a shim covers it.\":                   true,\n105\t\t\t\"Uma fuga. Aceito porque o shim cobre o caso.\":                    true,\n106\t\t\t\"Not accepted because this would violate scope.\":                  false,\n107\t\t\t\"Accepted because it is rare.\":                                    false,\n108\t\t\t\"An escape. Accepted because. Then unrelated prose follows here.\": false,\n109\t\t\t\"An escape. Accepted because a shim covers it. More context.\":     true,\n110\t\t\t\"An escape. Accepted because ; later prose has words.\":            false,\n111\t\t\t\"X. Accepted because a shim covers it.\":                           false,\n112\t\t\t\"x, accepted because it is rare.\":                                 false,\n113\t\t} {\n114\t\t\tif got := hasAcceptedLimitReason(text); got != want {\n115\t\t\t\tt.Errorf(\"%q: reason=%t, want %t\", text, got, want)\n116\t\t\t}\n117\t\t}\n118\t}\n119\t\n120\t// Review round 6, N1: the bundle's plan digest covers the sealed limits, and\n121\t// a plan without limits keeps the digest it had before them.\n122\tfunc TestTheBundlePlanDigestCoversTheAcceptedLimits(t *testing.T) {\n123\t\tvar plan ReviewPlan\n124\t\tplan.SchemaVersion, plan.Independence = 1, \"different-actor\"\n125\t\tempty, err := reviewBundlePlanDigest(plan)\n126\t\tif err != nil {\n127\t\t\tt.Fatal(err)\n128\t\t}\n129\t\tlegacy, _ := digestJSON(struct {\n130\t\t\tSchemaVersion             int                   `json:\"schema_version\"`\n131\t\t\tPolicySchemaVersion       int                   `json:\"policy_schema_version\"`\n132\t\t\tBaseProfile               string                `json:\"base_profile\"`\n133\t\t\tIndependence              string                `json:\"independence\"`\n134\t\t\tComponents                []ReviewPlanComponent `json:\"components\"`\n135\t\t\tSelectedProfiles          []ReviewPlanProfile   `json:\"selected_profiles\"`\n136\t\t\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n137\t\t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n138\t\t\tLimitations               []string              `json:\"limitations,omitempty\"`\n139\t\t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n140\t\t}{1, 0, \"\", \"different-actor\", []ReviewPlanComponent{}, []ReviewPlanProfile{}, []ReviewPlanCriterion{}, []ReviewPlanTool{}, nil, false})\n141\t\tif empty != legacy {\n142\t\t\tt.Fatal(\"a plan without limits changed its bundle plan digest\")\n143\t\t}\n144\t\tplan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"An escape. Accepted because a shim covers it.\"}}\n145\t\tone, _ := reviewBundlePlanDigest(plan)\n146\t\tplan.AcceptedLimits[0].Text = \"An escape. Accepted because nothing else covers it.\"\n147\t\tother, _ := reviewBundlePlanDigest(plan)\n148\t\tif one == empty || one == other {\n149\t\t\tt.Fatalf(\"the bundle plan digest does not cover the accepted limits: %s %s %s\", empty, one, other)\n150\t\t}\n151\t}\n152\t\n153\t// Review round 8, N1, N2: a wrapped entry keeps its continuation; fenced and\n154\t// commented examples are not sealed.\n155\tfunc TestAcceptedLimitsReadWrappedEntriesAndSkipExamples(t *testing.T) {\n156\t\tbody := \"### Accepted limits\\n- L1: An escape. Accepted because a shim covers it\\n  only on Linux and only for children.\\n<!--\\n- L3: A hidden one. Accepted because nobody sees it.\\n-->\\n### Notes\\n```\\n### Accepted limits\\n- L2: An example. Accepted because it is only shown.\\n```\\n\"\n157\t\tlimits, problems := ParseAcceptedLimits(body)\n158\t\tif len(problems) != 0 || len(limits) != 1 {\n159\t\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n160\t\t}\n161\t\tif !strings.HasSuffix(limits[0].Text, \"only on Linux and only for children.\") {\n162\t\t\tt.Fatalf(\"the continuation line was cut: %q\", limits[0].Text)\n163\t\t}\n164\t}\n165\t\n166\t// Review round 9, N2, N4: an entry ends where its list item ends; a wrapped\n167\t// '#' is no heading; a nested list or a borrowed reason is refused and not\n168\t// sealed; fences close only with their own marker.\n169\tfunc TestAcceptedLimitsEndWhereTheirItemEnds(t *testing.T) {\n170\t\tcases := []struct {\n171\t\t\tname, body string\n172\t\t\twant       map[string]string\n173\t\t\tproblem    string\n174\t\t}{\n175\t\t\t{\"wrapped hash\", \"### Accepted limits\\n- L1: An escape is open. Accepted because see issue\\n  #42 only on Linux.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because see issue #42 only on Linux.\"}, \"\"},\n176\t\t\t{\"indented paragraph\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n\\n  and only on Linux.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare and only on Linux.\"}, \"\"},\n177\t\t\t{\"nested list\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n  - only on Linux\\n\", map[string]string{}, \"nested list\"},\n178\t\t\t{\"later paragraph\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\\nSome note that follows the list.\\n* L2: Another escape. Accepted because it is rarer.\\n\", map[string]string{\"L2\": \"Another escape. Accepted because it is rarer.\"}, \"holds only limits\"},\n179\t\t\t{\"borrowed reason\", \"### Accepted limits\\n- L1: no reason here\\n\\nSome unrelated note. Accepted because other words follow.\\n\", map[string]string{}, \"holds only limits\"},\n180\t\t\t// Review round 10, N1: a lazy continuation and a fence inside an\n181\t\t\t// item are reported, and the limit is not sealed in part.\n182\t\t\t{\"lazy continuation\", \"### Accepted limits\\n- L1: An escape is open. Accepted because a shim covers it\\nonly on Linux and only for children.\\n\", map[string]string{}, \"is not sealed\"},\n183\t\t\t{\"fence in item\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n  ```\\n  code\\n  ```\\n  and only on Linux.\\n\", map[string]string{}, \"code fence\"},\n184\t\t\t{\"four backticks\", \"### Accepted limits\\n````\\n```\\n- L1: An example escape. Accepted because it is only shown.\\n```\\n````\\n\", map[string]string{}, \"code fence\"},\n185\t\t\t// Review round 10, N2: valid list forms are read; others are reported.\n186\t\t\t{\"indented items\", \"  ### Accepted limits\\n  - L1: An escape is open. Accepted because it is rare.\\n+ L2: Another escape. Accepted because it is rarer.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare.\", \"L2\": \"Another escape. Accepted because it is rarer.\"}, \"\"},\n187\t\t\t{\"ordered item\", \"### Accepted limits\\n1. L1: An escape is open. Accepted because it is rare.\\n\", map[string]string{}, \"is not written as\"},\n188\t\t\t// Review round 10, N4: inline code is no fence; an unterminated\n189\t\t\t// comment is reported.\n190\t\t\t{\"inline backticks\", \"### Notes\\n```a``` is inline\\n### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare.\"}, \"\"},\n191\t\t\t{\"unterminated comment\", \"<!-- draft\\n### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\", map[string]string{}, \"unterminated HTML comment\"},\n192\t\t}\n193\t\tfor _, c := range cases {\n194\t\t\tlimits, problems := ParseAcceptedLimits(c.body)\n195\t\t\tgot := map[string]string{}\n196\t\t\tfor _, l := range limits {\n197\t\t\t\tgot[l.ID] = l.Text\n198\t\t\t}\n199\t\t\tif len(got) != len(c.want) {\n200\t\t\t\tt.Fatalf(\"%s: limits %+v, want %v (problems %v)\", c.name, limits, c.want, problems)\n201\t\t\t}\n202\t\t\tfor id, text := range c.want {\n203\t\t\t\tif got[id] != text {\n204\t\t\t\t\tt.Fatalf(\"%s: %s = %q, want %q\", c.name, id, got[id], text)\n205\t\t\t\t}\n206\t\t\t}\n207\t\t\tjoined := strings.Join(problems, \"; \")\n208\t\t\tif (c.problem == \"\") != (joined == \"\") || !strings.Contains(joined, c.problem) {\n209\t\t\t\tt.Fatalf(\"%s: problems %q, want %q\", c.name, joined, c.problem)\n210\t\t\t}\n211\t\t}\n212\t}\n213\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"4c7db8b2-6f94-470a-88f1-340ca34b55bd","timestamp":"2026-11-26T05:36:43.555Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-349050671/worktree/pose-mcp/internal/pose/accepted_limits_test.go","content":"package pose\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nconst limitsSection = `\n### Accepted limits\n- L1: A process that clears its environment escapes. Accepted because the shim covers it.\n- L2: Windows is untested here. Accepted because the host is Linux.\n`\n\n// Spec pose-review-declared-threat-model R1: the section is read as\n// written, and what does not say why it is accepted is reported.\nfunc TestAcceptedLimitsAreParsed(t *testing.T) {\n\tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n\tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n\t}\n\t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n- L3: a marker with nothing after it. Accepted because\\n\")\n\tjoined := strings.Join(problems, \"\\n\")\n\tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\", \"L3 does not say why it is accepted\"} {\n\t\tif !strings.Contains(joined, want) {\n\t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n\t\t}\n\t}\n}\n\n// R1: the review plan seals the limits the spec declares, and they enter the\n// plan digest; a spec without limits keeps its digest.\nfunc TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n\troot, store := reviewBundleFixture(t)\n\tbefore, err := store.ReviewPlan(\"spec:backend\")\n\tif err != nil || len(before.AcceptedLimits) != 0 {\n\t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n\t}\n\tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n\traw, _ := os.ReadFile(path)\n\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tafter, err := store.ReviewPlan(\"spec:backend\")\n\tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n\t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n\t}\n\twithout := after\n\twithout.AcceptedLimits = nil\n\tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n\t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n\t}\n}\n\n// R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n// recorded within-limit, naming it, and does not block an approval whatever\n// its severity; a limit the bundle did not seal accepts nothing.\nfunc TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n\tvar bundle ReviewBundle\n\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n\tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n\t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n\t}}\n\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n\t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n\t}\n\tatt.Decision = \"approved\"\n\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n\t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n\t}\n\tatt.Findings[0].Limit = \"L9\"\n\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n\t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n\t}\n\tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"  \\t \"\n\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n\t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n\t}\n}\n\n// Review round 1, N1: across the specs of a composite scope each limit is\n// qualified by its spec, so a finding names exactly one.\nfunc TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n\tbody := \"### Accepted limits\\n- L1: one escape. Accepted because it is rare.\\n\"\n\tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n\tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n\t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n\t}\n\tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n\tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n\t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n\t}\n}\n\n// Review round 2, N1: punctuation is not a reason, and a reason may start\n// with a one-letter word.\nfunc TestAnAcceptedLimitNeedsWordsAsItsReason(t *testing.T) {\n\tfor text, want := range map[string]bool{\n\t\t\"x. Accepted because ..\":                                          false,\n\t\t\"x. Accepted because -- !\":                                        false,\n\t\t\"x. Accepted because rare\":                                        false,\n\t\t\"An escape. Accepted because a shim covers it.\":                   true,\n\t\t\"Uma fuga. Aceito porque o shim cobre o caso.\":                    true,\n\t\t\"Not accepted because this would violate scope.\":                  false,\n\t\t\"Accepted because it is rare.\":                                    false,\n\t\t\"An escape. Accepted because. Then unrelated prose follows here.\": false,\n\t\t\"An escape. Accepted because a shim covers it. More context.\":     true,\n\t\t\"An escape. Accepted because ; later prose has words.\":            false,\n\t\t\"X. Accepted because a shim covers it.\":                           false,\n\t\t\"x, accepted because it is rare.\":                                 false,\n\t} {\n\t\tif got := hasAcceptedLimitReason(text); got != want {\n\t\t\tt.Errorf(\"%q: reason=%t, want %t\", text, got, want)\n\t\t}\n\t}\n}\n\n// Review round 6, N1: the bundle's plan digest covers the sealed limits, and\n// a plan without limits keeps the digest it had before them.\nfunc TestTheBundlePlanDigestCoversTheAcceptedLimits(t *testing.T) {\n\tvar plan ReviewPlan\n\tplan.SchemaVersion, plan.Independence = 1, \"different-actor\"\n\tempty, err := reviewBundlePlanDigest(plan)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlegacy, _ := digestJSON(struct {\n\t\tSchemaVersion             int                   `json:\"schema_version\"`\n\t\tPolicySchemaVersion       int                   `json:\"policy_schema_version\"`\n\t\tBaseProfile               string                `json:\"base_profile\"`\n\t\tIndependence              string                `json:\"independence\"`\n\t\tComponents                []ReviewPlanComponent `json:\"components\"`\n\t\tSelectedProfiles          []ReviewPlanProfile   `json:\"selected_profiles\"`\n\t\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n\t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n\t\tLimitations               []string              `json:\"limitations,omitempty\"`\n\t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n\t}{1, 0, \"\", \"different-actor\", []ReviewPlanComponent{}, []ReviewPlanProfile{}, []ReviewPlanCriterion{}, []ReviewPlanTool{}, nil, false})\n\tif empty != legacy {\n\t\tt.Fatal(\"a plan without limits changed its bundle plan digest\")\n\t}\n\tplan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"An escape. Accepted because a shim covers it.\"}}\n\tone, _ := reviewBundlePlanDigest(plan)\n\tplan.AcceptedLimits[0].Text = \"An escape. Accepted because nothing else covers it.\"\n\tother, _ := reviewBundlePlanDigest(plan)\n\tif one == empty || one == other {\n\t\tt.Fatalf(\"the bundle plan digest does not cover the accepted limits: %s %s %s\", empty, one, other)\n\t}\n}\n\n// Review round 8, N1, N2: a wrapped entry keeps its continuation; fenced and\n// commented examples are not sealed.\nfunc TestAcceptedLimitsReadWrappedEntriesAndSkipExamples(t *testing.T) {\n\tbody := \"### Accepted limits\\n- L1: An escape. Accepted because a shim covers it\\n  only on Linux and only for children.\\n<!--\\n- L3: A hidden one. Accepted because nobody sees it.\\n-->\\n### Notes\\n```\\n### Accepted limits\\n- L2: An example. Accepted because it is only shown.\\n```\\n\"\n\tlimits, problems := ParseAcceptedLimits(body)\n\tif len(problems) != 0 || len(limits) != 1 {\n\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n\t}\n\tif !strings.HasSuffix(limits[0].Text, \"only on Linux and only for children.\") {\n\t\tt.Fatalf(\"the continuation line was cut: %q\", limits[0].Text)\n\t}\n}\n\n// Review round 9, N2, N4: an entry ends where its list item ends; a wrapped\n// '#' is no heading; a nested list or a borrowed reason is refused and not\n// sealed; fences close only with their own marker.\nfunc TestAcceptedLimitsEndWhereTheirItemEnds(t *testing.T) {\n\tcases := []struct {\n\t\tname, body string\n\t\twant       map[string]string\n\t\tproblem    string\n\t}{\n\t\t{\"wrapped hash\", \"### Accepted limits\\n- L1: An escape is open. Accepted because see issue\\n  #42 only on Linux.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because see issue #42 only on Linux.\"}, \"\"},\n\t\t{\"indented paragraph\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n\\n  and only on Linux.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare and only on Linux.\"}, \"\"},\n\t\t{\"nested list\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n  - only on Linux\\n\", map[string]string{}, \"nested list\"},\n\t\t{\"later paragraph\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\\nSome note that follows the list.\\n* L2: Another escape. Accepted because it is rarer.\\n\", map[string]string{\"L2\": \"Another escape. Accepted because it is rarer.\"}, \"holds only limits\"},\n\t\t{\"borrowed reason\", \"### Accepted limits\\n- L1: no reason here\\n\\nSome unrelated note. Accepted because other words follow.\\n\", map[string]string{}, \"holds only limits\"},\n\t\t// Review round 10, N1: a lazy continuation and a fence inside an\n\t\t// item are reported, and the limit is not sealed in part.\n\t\t{\"lazy continuation\", \"### Accepted limits\\n- L1: An escape is open. Accepted because a shim covers it\\nonly on Linux and only for children.\\n\", map[string]string{}, \"is not sealed\"},\n\t\t{\"fence in item\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare\\n  ```\\n  code\\n  ```\\n  and only on Linux.\\n\", map[string]string{}, \"code fence\"},\n\t\t{\"four backticks\", \"### Accepted limits\\n````\\n```\\n- L1: An example escape. Accepted because it is only shown.\\n```\\n````\\n\", map[string]string{}, \"code fence\"},\n\t\t// Review round 10, N2: valid list forms are read; others are reported.\n\t\t{\"indented items\", \"  ### Accepted limits\\n  - L1: An escape is open. Accepted because it is rare.\\n+ L2: Another escape. Accepted because it is rarer.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare.\", \"L2\": \"Another escape. Accepted because it is rarer.\"}, \"\"},\n\t\t{\"ordered item\", \"### Accepted limits\\n1. L1: An escape is open. Accepted because it is rare.\\n\", map[string]string{}, \"is not written as\"},\n\t\t// Review round 10, N4: inline code is no fence; an unterminated\n\t\t// comment is reported.\n\t\t{\"inline backticks\", \"### Notes\\n```a``` is inline\\n### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\", map[string]string{\"L1\": \"An escape is open. Accepted because it is rare.\"}, \"\"},\n\t\t{\"unterminated comment\", \"<!-- draft\\n### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\", map[string]string{}, \"unterminated HTML comment\"},\n\t}\n\tfor _, c := range cases {\n\t\tlimits, problems := ParseAcceptedLimits(c.body)\n\t\tgot := map[string]string{}\n\t\tfor _, l := range limits {\n\t\t\tgot[l.ID] = l.Text\n\t\t}\n\t\tif len(got) != len(c.want) {\n\t\t\tt.Fatalf(\"%s: limits %+v, want %v (problems %v)\", c.name, limits, c.want, problems)\n\t\t}\n\t\tfor id, text := range c.want {\n\t\t\tif got[id] != text {\n\t\t\t\tt.Fatalf(\"%s: %s = %q, want %q\", c.name, id, got[id], text)\n\t\t\t}\n\t\t}\n\t\tjoined := strings.Join(problems, \"; \")\n\t\tif (c.problem == \"\") != (joined == \"\") || !strings.Contains(joined, c.problem) {\n\t\t\tt.Fatalf(\"%s: problems %q, want %q\", c.name, joined, c.problem)\n\t\t}\n\t}\n}\n","numLines":213,"startLine":1,"totalLines":213}},"tool_result_meta":[{"id":"toolu_01DBbBTGWHwYqFL5Ra1W52EE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
