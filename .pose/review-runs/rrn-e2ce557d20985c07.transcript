{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Hu2Y5sm3JKHeAxSnKT9AEu","type":"tool_result","content":"3150\tfunc (e *ReviewApprovalRefusal) Unwrap() error { return ErrReviewApprovalRefused }\n3151\t\n3152\tfunc reviewDecisionApproves(decision string) bool {\n3153\t\treturn decision == \"approved\" || decision == \"approved-with-reservations\"\n3154\t}\n3155\t\n3156\t// reviewApprovalAdmissionBlockers is the semantic admission of a new approving\n3157\t// attestation, completed as it will be recorded. It reuses the verifier itself\n3158\t// over the bundle's sealed gates and the deliberately live signing and trust\n3159\t// requirements, adds the time admissibility of a new operation, and requires\n3160\t// the bundle to still be the current sealed subject of its scope, so the\n3161\t// approval of a stale preview or of a superseded bundle is not written.\n3162\t//\n3163\t// A non-approving decision is an audit record the verifier rejects for\n3164\t// closeout by definition, so its criteria are not held to the approval bar;\n3165\t// its channel's authentication still applies in the writer.\n3166\tfunc (s Store) reviewApprovalAdmissionBlockers(bundle ReviewBundle, att ReviewAttestation, now time.Time) []string {\n3167\t\tif !reviewDecisionApproves(att.Decision) {\n3168\t\t\treturn nil\n3169\t\t}\n3170\t\tblockers := s.atReviewTime(now).validateBundleAttestation(bundle, att)\n3171\t\tblockers = append(blockers, reviewNewOperationTimeBlockers(att, now)...)\n3172\t\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n3173\t\tswitch {\n3174\t\tcase err != nil:\n3175\t\t\tblockers = append(blockers, \"the current review subject of \"+bundle.Payload.Scope.Ref+\" cannot be established: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n3176\t\tcase current == nil:\n3177\t\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" no longer represents the current semantic inputs of \"+bundle.Payload.Scope.Ref+\"; seal the current bundle and review it\")\n3178\t\tcase current.BundleID != bundle.BundleID:\n3179\t\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" is superseded by \"+current.BundleID+\"; review the current bundle\")\n3180\t\t}\n3181\t\treturn uniqueSorted(blockers)\n3182\t}\n3183\t\n3184\t// PreflightReviewAttestation returns the reasons the domain writer would\n3185\t// refuse an approving attestation, without writing anything. It completes the\n3186\t// attestation exactly as recording would and runs the same admission, so a\n3187\t// preview and the write cannot disagree (specs\n3188\t// pose-attest-refuses-what-verify-rejects, pose-review-approval-domain-preflight).\n3189\tfunc (s Store) PreflightReviewAttestation(att ReviewAttestation, now time.Time) []string {\n3190\t\tif !reviewDecisionApproves(att.Decision) {\n3191\t\t\treturn nil\n3192\t\t}\n3193\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n3194\t\tif err != nil {\n3195\t\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n3196\t\t}\n3197\t\tatt.Path = \"\"\n3198\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\n3199\t\tif err != nil {\n3200\t\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n3201\t\t}\n3202\t\treturn s.reviewApprovalAdmissionBlockers(bundle, completed, now)\n3203\t}\n3204\t\n3205\t// VerifyReviewAttestationEnvelope verifies an optional provider-neutral\n3206\t// Ed25519 envelope. Trust is pinned as <issuer>#sha256:<public-key-digest> in\n3207\t// review policy; a self-declared issuer or public key is never trusted alone.\n3208\tfunc (s Store) VerifyReviewAttestationEnvelope(envelope ReviewAttestationEnvelope) (ReviewAttestation, error) {\n3209\t\tif envelope.SchemaVersion != ReviewBundleSchemaVersion || envelope.Algorithm != \"ed25519\" {\n3210\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: unsupported review attestation envelope\")\n3211\t\t}\n3212\t\tif envelope.Subject != envelope.Attestation.BundleID || envelope.Issuer == \"\" || strings.ContainsAny(envelope.Issuer, \"\\r\\n\") {\n3213\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation envelope subject or issuer mismatch\")\n3214\t\t}\n3215\t\tpublicKey, err := base64.StdEncoding.DecodeString(envelope.PublicKey)\n3216\t\tif err != nil || len(publicKey) != ed25519.PublicKeySize {\n3217\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid Ed25519 public key\")\n3218\t\t}\n3219\t\tsignature, err := base64.StdEncoding.DecodeString(envelope.Signature)"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"93daf4e3-6fc1-498a-8704-6b04ebc31a43","timestamp":"2026-11-26T05:38:33.360Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-349050671/worktree/pose-mcp/internal/pose/review_bundle.go","content":"func (e *ReviewApprovalRefusal) Unwrap() error { return ErrReviewApprovalRefused }\n\nfunc reviewDecisionApproves(decision string) bool {\n\treturn decision == \"approved\" || decision == \"approved-with-reservations\"\n}\n\n// reviewApprovalAdmissionBlockers is the semantic admission of a new approving\n// attestation, completed as it will be recorded. It reuses the verifier itself\n// over the bundle's sealed gates and the deliberately live signing and trust\n// requirements, adds the time admissibility of a new operation, and requires\n// the bundle to still be the current sealed subject of its scope, so the\n// approval of a stale preview or of a superseded bundle is not written.\n//\n// A non-approving decision is an audit record the verifier rejects for\n// closeout by definition, so its criteria are not held to the approval bar;\n// its channel's authentication still applies in the writer.\nfunc (s Store) reviewApprovalAdmissionBlockers(bundle ReviewBundle, att ReviewAttestation, now time.Time) []string {\n\tif !reviewDecisionApproves(att.Decision) {\n\t\treturn nil\n\t}\n\tblockers := s.atReviewTime(now).validateBundleAttestation(bundle, att)\n\tblockers = append(blockers, reviewNewOperationTimeBlockers(att, now)...)\n\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n\tswitch {\n\tcase err != nil:\n\t\tblockers = append(blockers, \"the current review subject of \"+bundle.Payload.Scope.Ref+\" cannot be established: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n\tcase current == nil:\n\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" no longer represents the current semantic inputs of \"+bundle.Payload.Scope.Ref+\"; seal the current bundle and review it\")\n\tcase current.BundleID != bundle.BundleID:\n\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" is superseded by \"+current.BundleID+\"; review the current bundle\")\n\t}\n\treturn uniqueSorted(blockers)\n}\n\n// PreflightReviewAttestation returns the reasons the domain writer would\n// refuse an approving attestation, without writing anything. It completes the\n// attestation exactly as recording would and runs the same admission, so a\n// preview and the write cannot disagree (specs\n// pose-attest-refuses-what-verify-rejects, pose-review-approval-domain-preflight).\nfunc (s Store) PreflightReviewAttestation(att ReviewAttestation, now time.Time) []string {\n\tif !reviewDecisionApproves(att.Decision) {\n\t\treturn nil\n\t}\n\tbundle, err := s.LoadReviewBundle(att.BundleID)\n\tif err != nil {\n\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n\t}\n\tatt.Path = \"\"\n\tcompleted, err := completeReviewAttestation(bundle, att, now)\n\tif err != nil {\n\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n\t}\n\treturn s.reviewApprovalAdmissionBlockers(bundle, completed, now)\n}\n\n// VerifyReviewAttestationEnvelope verifies an optional provider-neutral\n// Ed25519 envelope. Trust is pinned as <issuer>#sha256:<public-key-digest> in\n// review policy; a self-declared issuer or public key is never trusted alone.\nfunc (s Store) VerifyReviewAttestationEnvelope(envelope ReviewAttestationEnvelope) (ReviewAttestation, error) {\n\tif envelope.SchemaVersion != ReviewBundleSchemaVersion || envelope.Algorithm != \"ed25519\" {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: unsupported review attestation envelope\")\n\t}\n\tif envelope.Subject != envelope.Attestation.BundleID || envelope.Issuer == \"\" || strings.ContainsAny(envelope.Issuer, \"\\r\\n\") {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation envelope subject or issuer mismatch\")\n\t}\n\tpublicKey, err := base64.StdEncoding.DecodeString(envelope.PublicKey)\n\tif err != nil || len(publicKey) != ed25519.PublicKeySize {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid Ed25519 public key\")\n\t}\n\tsignature, err := base64.StdEncoding.DecodeString(envelope.Signature)","numLines":70,"startLine":3150,"totalLines":4951}},"tool_result_meta":[{"id":"toolu_01Hu2Y5sm3JKHeAxSnKT9AEu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
