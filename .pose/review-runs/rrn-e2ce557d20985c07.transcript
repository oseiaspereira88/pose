{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019uWhtpvgxAy3MtCpL7EZKs","type":"tool_result","content":"1\tpackage pose\n2\t\n3\t// Accepted limits (spec pose-review-declared-threat-model): a spec declares\n4\t// the residual limits of a guarantee it makes, each with a stable id and why\n5\t// it is accepted. The review plan seals them; the brief lists them; a\n6\t// reviewer classifies a finding that falls inside one as within that limit,\n7\t// or disputes the limit as a finding of its own. A declared limit never\n8\t// hides a defect inside the declared scope: it is visible in the bundle, the\n9\t// brief and the attestation.\n10\t\n11\timport (\n12\t\t\"regexp\"\n13\t\t\"strings\"\n14\t)\n15\t\n16\t// ReviewAcceptedLimit is one declared residual limit.\n17\ttype ReviewAcceptedLimit struct {\n18\t\tID   string `json:\"id\"`\n19\t\tText string `json:\"text\"`\n20\t\t// Spec names the spec that declared the limit when the scope holds more\n21\t\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n22\t\tSpec string `json:\"spec,omitempty\"`\n23\t}\n24\t\n25\tvar acceptedLimitRE = regexp.MustCompile(`^[-*+]\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n26\t\n27\t// acceptedLimitMarkerRE finds the marker where a sentence opens, after the\n28\t// assumption: \"<assumption>. Accepted because <reason>.\" A marker inside a\n29\t// sentence (\"Not accepted because\") is not one (review round 3, N1).\n30\tvar acceptedLimitMarkerRE = regexp.MustCompile(`[.;:!?]\\s+(?:Accepted because|Aceito porque)\\s+`)\n31\t\n32\t// acceptedLimitReasonWordRE is a word with at least one letter.\n33\tvar acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n34\t\n35\t// hasAcceptedLimitReason reads an entry as written: an assumption of at\n36\t// least two words, then the marker opening a sentence, then a reason of at\n37\t// least two words in that same sentence. A marker alone, punctuation, a\n38\t// missing assumption or a reason borrowed from a later sentence does not say\n39\t// why a limit is accepted (review rounds 1–4).\n40\tfunc hasAcceptedLimitReason(text string) bool {\n41\t\tloc := acceptedLimitMarkerRE.FindStringIndex(text)\n42\t\tif loc == nil {\n43\t\t\treturn false\n44\t\t}\n45\t\tassumption, rest := text[:loc[0]], text[loc[1]:]\n46\t\tif end := strings.IndexAny(rest, \".;!?\"); end >= 0 {\n47\t\t\trest = rest[:end]\n48\t\t}\n49\t\treturn len(acceptedLimitReasonWordRE.FindAllString(assumption, -1)) >= 2 && len(acceptedLimitReasonWordRE.FindAllString(rest, -1)) >= 2\n50\t}\n51\t\n52\t// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n53\t// It returns the limits and the problems that keep the section from being\n54\t// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n55\t// limit that does not say why it is accepted (\"Accepted because ...\" or\n56\t// \"Aceito porque ...\").\n57\tfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n58\t\tvar limits []ReviewAcceptedLimit\n59\t\tvar problems []string\n60\t\tin := false\n61\t\tseen := map[string]bool{}\n62\t\t// The section is read fail-closed (review rounds 8 to 10): it holds only\n63\t\t// limits, each one list item whose wrapped lines are indented deeper than\n64\t\t// its marker (also after a blank line). Any other line in the section\n65\t\t// (prose, a lazy unindented continuation, a nested list, a fence, another\n66\t\t// kind of item) is reported, and the limit it belongs to or follows is\n67\t\t// not sealed: the engine never seals a limit it may have read in part.\n68\t\t// Fenced blocks and HTML comments outside the section are not the spec's\n69\t\t// declarations, so examples there are never read.\n70\t\ttype entry struct {\n71\t\t\tid, text string\n72\t\t\tindent   int\n73\t\t\tbad      bool\n74\t\t}\n75\t\tvar entries []entry\n76\t\treport := func(line, why string) {\n77\t\t\tproblems = append(problems, \"accepted limits: \"+quoteLedgerText(strings.TrimSpace(line))+\" \"+why)\n78\t\t\tif len(entries) > 0 && !entries[len(entries)-1].bad {\n79\t\t\t\tentries[len(entries)-1].bad = true\n80\t\t\t}\n81\t\t}\n82\t\ttext := body\n83\t\tif start := strings.Index(text, \"<!--\"); start >= 0 && !strings.Contains(text[start:], \"-->\") {\n84\t\t\tproblems = append(problems, \"accepted limits: an unterminated HTML comment hides the rest of the spec\")\n85\t\t}\n86\t\ttext = stripHTMLComments(text)\n87\t\tfence := \"\"\n88\t\tfor _, line := range strings.Split(text, \"\\n\") {\n89\t\t\ttrimmed := strings.TrimSpace(line)\n90\t\t\tindent := len(line) - len(strings.TrimLeft(line, \" \\t\"))\n91\t\t\tif marker := fenceMarker(trimmed); marker != \"\" {\n92\t\t\t\tif in {\n93\t\t\t\t\treport(line, \"is a code fence; examples belong outside the section\")\n94\t\t\t\t}\n95\t\t\t\tswitch {\n96\t\t\t\tcase fence == \"\":\n97\t\t\t\t\tfence = marker\n98\t\t\t\tcase marker[0] == fence[0] && len(marker) >= len(fence) && strings.TrimLeft(trimmed, marker[:1]) == \"\":\n99\t\t\t\t\tfence = \"\"\n100\t\t\t\t}\n101\t\t\t\tcontinue\n102\t\t\t}\n103\t\t\tif fence != \"\" {\n104\t\t\t\tcontinue\n105\t\t\t}\n106\t\t\tif indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n107\t\t\t\theading := strings.TrimSpace(strings.Trim(trimmed, \"# \"))\n108\t\t\t\tin = strings.EqualFold(heading, \"Accepted limits\") || strings.EqualFold(heading, \"Limites aceitos\")\n109\t\t\t\tcontinue\n110\t\t\t}\n111\t\t\tif !in || trimmed == \"\" {\n112\t\t\t\tcontinue\n113\t\t\t}\n114\t\t\t// A line indented under the current limit belongs to it: a list\n115\t\t\t// there is nested, anything else continues the limit.\n116\t\t\tunder := len(entries) > 0 && indent > entries[len(entries)-1].indent\n117\t\t\tif under && listItemRE.MatchString(trimmed) {\n118\t\t\t\treport(line, \"is a nested list; write the limit as one item\")\n119\t\t\t\tcontinue\n120\t\t\t}\n121\t\t\tif !under && indent <= 3 {\n122\t\t\t\tif m := acceptedLimitRE.FindStringSubmatch(trimmed); m != nil {\n123\t\t\t\t\tentries = append(entries, entry{id: m[1], text: strings.TrimSpace(m[2]), indent: indent})\n124\t\t\t\t\tcontinue\n125\t\t\t\t}\n126\t\t\t\tif listItemRE.MatchString(trimmed) {\n127\t\t\t\t\treport(line, \"is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n128\t\t\t\t\tentries = append(entries, entry{bad: true})\n129\t\t\t\t\tcontinue\n130\t\t\t\t}\n131\t\t\t}\n132\t\t\tif !under {\n133\t\t\t\treport(line, \"is neither a limit nor indented under one; the section holds only limits\")\n134\t\t\t\tcontinue\n135\t\t\t}\n136\t\t\tentries[len(entries)-1].text += \" \" + trimmed\n137\t\t}\n138\t\tfor _, e := range entries {\n139\t\t\tif e.id == \"\" {\n140\t\t\t\tcontinue\n141\t\t\t}\n142\t\t\tif seen[e.id] {\n143\t\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is declared twice\")\n144\t\t\t\tcontinue\n145\t\t\t}\n146\t\t\tseen[e.id] = true\n147\t\t\tif e.bad {\n148\t\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is not sealed: part of it could not be read\")\n149\t\t\t\tcontinue\n150\t\t\t}\n151\t\t\tif !hasAcceptedLimitReason(e.text) {\n152\t\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" does not say why it is accepted ('Accepted because ...')\")\n153\t\t\t\tcontinue\n154\t\t\t}\n155\t\t\tlimits = append(limits, ReviewAcceptedLimit{ID: e.id, Text: e.text})\n156\t\t}\n157\t\treturn limits, problems\n158\t}\n159\t\n160\tvar (\n161\t\tmarkdownHeadingRE = regexp.MustCompile(`^#{1,6}(\\s|$)`)\n162\t\tlistItemRE        = regexp.MustCompile(`^([-*+]|[0-9]+[.)])(\\s|$)`)\n163\t)\n164\t\n165\t// fenceMarker returns the run of backticks or tildes that opens or closes a\n166\t// code fence on trimmed, or \"\". A backtick run followed by more backticks on\n167\t// the line is inline code, not a fence.\n168\tfunc fenceMarker(trimmed string) string {\n169\t\tfor _, c := range []string{\"`\", \"~\"} {\n170\t\t\tn := len(trimmed) - len(strings.TrimLeft(trimmed, c))\n171\t\t\tif n < 3 {\n172\t\t\t\tcontinue\n173\t\t\t}\n174\t\t\tif c == \"`\" && strings.Contains(trimmed[n:], \"`\") {\n175\t\t\t\treturn \"\"\n176\t\t\t}\n177\t\t\treturn trimmed[:n]\n178\t\t}\n179\t\treturn \"\"\n180\t}\n181\t\n182\t// acceptedLimitsOf collects the limits the scope's specs declare.\n183\tfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n184\t\tspecs, err := s.reviewScopeSpecs(scope)\n185\t\tif err != nil {\n186\t\t\treturn nil\n187\t\t}\n188\t\treturn acceptedLimitsOfSpecs(specs)\n189\t}\n190\t\n191\t// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n192\t// by its spec when there is more than one spec.\n193\tfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n194\t\tvar out []ReviewAcceptedLimit\n195\t\tfor _, spec := range specs {\n196\t\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n197\t\t\tfor _, l := range limits {\n198\t\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n199\t\t\t\t// so a finding names exactly one sealed limit.\n200\t\t\t\tif len(specs) > 1 {\n201\t\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n202\t\t\t\t}\n203\t\t\t\tout = append(out, l)\n204\t\t\t}\n205\t\t}\n206\t\treturn out\n207\t}\n208\t\n209\t// sealedAcceptedLimit reports whether the bundle sealed limit id.\n210\tfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n211\t\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n212\t\t\tif l.ID == id {\n213\t\t\t\treturn true\n214\t\t\t}\n215\t\t}\n216\t\treturn false\n217\t}\n218\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"cd5eb01f-23b7-46c1-a59f-cd6936d693c6","timestamp":"2026-11-26T05:36:43.161Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-349050671/worktree/pose-mcp/internal/pose/accepted_limits.go","content":"package pose\n\n// Accepted limits (spec pose-review-declared-threat-model): a spec declares\n// the residual limits of a guarantee it makes, each with a stable id and why\n// it is accepted. The review plan seals them; the brief lists them; a\n// reviewer classifies a finding that falls inside one as within that limit,\n// or disputes the limit as a finding of its own. A declared limit never\n// hides a defect inside the declared scope: it is visible in the bundle, the\n// brief and the attestation.\n\nimport (\n\t\"regexp\"\n\t\"strings\"\n)\n\n// ReviewAcceptedLimit is one declared residual limit.\ntype ReviewAcceptedLimit struct {\n\tID   string `json:\"id\"`\n\tText string `json:\"text\"`\n\t// Spec names the spec that declared the limit when the scope holds more\n\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n\tSpec string `json:\"spec,omitempty\"`\n}\n\nvar acceptedLimitRE = regexp.MustCompile(`^[-*+]\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n\n// acceptedLimitMarkerRE finds the marker where a sentence opens, after the\n// assumption: \"<assumption>. Accepted because <reason>.\" A marker inside a\n// sentence (\"Not accepted because\") is not one (review round 3, N1).\nvar acceptedLimitMarkerRE = regexp.MustCompile(`[.;:!?]\\s+(?:Accepted because|Aceito porque)\\s+`)\n\n// acceptedLimitReasonWordRE is a word with at least one letter.\nvar acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n\n// hasAcceptedLimitReason reads an entry as written: an assumption of at\n// least two words, then the marker opening a sentence, then a reason of at\n// least two words in that same sentence. A marker alone, punctuation, a\n// missing assumption or a reason borrowed from a later sentence does not say\n// why a limit is accepted (review rounds 1–4).\nfunc hasAcceptedLimitReason(text string) bool {\n\tloc := acceptedLimitMarkerRE.FindStringIndex(text)\n\tif loc == nil {\n\t\treturn false\n\t}\n\tassumption, rest := text[:loc[0]], text[loc[1]:]\n\tif end := strings.IndexAny(rest, \".;!?\"); end >= 0 {\n\t\trest = rest[:end]\n\t}\n\treturn len(acceptedLimitReasonWordRE.FindAllString(assumption, -1)) >= 2 && len(acceptedLimitReasonWordRE.FindAllString(rest, -1)) >= 2\n}\n\n// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n// It returns the limits and the problems that keep the section from being\n// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n// limit that does not say why it is accepted (\"Accepted because ...\" or\n// \"Aceito porque ...\").\nfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n\tvar limits []ReviewAcceptedLimit\n\tvar problems []string\n\tin := false\n\tseen := map[string]bool{}\n\t// The section is read fail-closed (review rounds 8 to 10): it holds only\n\t// limits, each one list item whose wrapped lines are indented deeper than\n\t// its marker (also after a blank line). Any other line in the section\n\t// (prose, a lazy unindented continuation, a nested list, a fence, another\n\t// kind of item) is reported, and the limit it belongs to or follows is\n\t// not sealed: the engine never seals a limit it may have read in part.\n\t// Fenced blocks and HTML comments outside the section are not the spec's\n\t// declarations, so examples there are never read.\n\ttype entry struct {\n\t\tid, text string\n\t\tindent   int\n\t\tbad      bool\n\t}\n\tvar entries []entry\n\treport := func(line, why string) {\n\t\tproblems = append(problems, \"accepted limits: \"+quoteLedgerText(strings.TrimSpace(line))+\" \"+why)\n\t\tif len(entries) > 0 && !entries[len(entries)-1].bad {\n\t\t\tentries[len(entries)-1].bad = true\n\t\t}\n\t}\n\ttext := body\n\tif start := strings.Index(text, \"<!--\"); start >= 0 && !strings.Contains(text[start:], \"-->\") {\n\t\tproblems = append(problems, \"accepted limits: an unterminated HTML comment hides the rest of the spec\")\n\t}\n\ttext = stripHTMLComments(text)\n\tfence := \"\"\n\tfor _, line := range strings.Split(text, \"\\n\") {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tindent := len(line) - len(strings.TrimLeft(line, \" \\t\"))\n\t\tif marker := fenceMarker(trimmed); marker != \"\" {\n\t\t\tif in {\n\t\t\t\treport(line, \"is a code fence; examples belong outside the section\")\n\t\t\t}\n\t\t\tswitch {\n\t\t\tcase fence == \"\":\n\t\t\t\tfence = marker\n\t\t\tcase marker[0] == fence[0] && len(marker) >= len(fence) && strings.TrimLeft(trimmed, marker[:1]) == \"\":\n\t\t\t\tfence = \"\"\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif fence != \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n\t\t\theading := strings.TrimSpace(strings.Trim(trimmed, \"# \"))\n\t\t\tin = strings.EqualFold(heading, \"Accepted limits\") || strings.EqualFold(heading, \"Limites aceitos\")\n\t\t\tcontinue\n\t\t}\n\t\tif !in || trimmed == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\t// A line indented under the current limit belongs to it: a list\n\t\t// there is nested, anything else continues the limit.\n\t\tunder := len(entries) > 0 && indent > entries[len(entries)-1].indent\n\t\tif under && listItemRE.MatchString(trimmed) {\n\t\t\treport(line, \"is a nested list; write the limit as one item\")\n\t\t\tcontinue\n\t\t}\n\t\tif !under && indent <= 3 {\n\t\t\tif m := acceptedLimitRE.FindStringSubmatch(trimmed); m != nil {\n\t\t\t\tentries = append(entries, entry{id: m[1], text: strings.TrimSpace(m[2]), indent: indent})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif listItemRE.MatchString(trimmed) {\n\t\t\t\treport(line, \"is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n\t\t\t\tentries = append(entries, entry{bad: true})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif !under {\n\t\t\treport(line, \"is neither a limit nor indented under one; the section holds only limits\")\n\t\t\tcontinue\n\t\t}\n\t\tentries[len(entries)-1].text += \" \" + trimmed\n\t}\n\tfor _, e := range entries {\n\t\tif e.id == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif seen[e.id] {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is declared twice\")\n\t\t\tcontinue\n\t\t}\n\t\tseen[e.id] = true\n\t\tif e.bad {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is not sealed: part of it could not be read\")\n\t\t\tcontinue\n\t\t}\n\t\tif !hasAcceptedLimitReason(e.text) {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" does not say why it is accepted ('Accepted because ...')\")\n\t\t\tcontinue\n\t\t}\n\t\tlimits = append(limits, ReviewAcceptedLimit{ID: e.id, Text: e.text})\n\t}\n\treturn limits, problems\n}\n\nvar (\n\tmarkdownHeadingRE = regexp.MustCompile(`^#{1,6}(\\s|$)`)\n\tlistItemRE        = regexp.MustCompile(`^([-*+]|[0-9]+[.)])(\\s|$)`)\n)\n\n// fenceMarker returns the run of backticks or tildes that opens or closes a\n// code fence on trimmed, or \"\". A backtick run followed by more backticks on\n// the line is inline code, not a fence.\nfunc fenceMarker(trimmed string) string {\n\tfor _, c := range []string{\"`\", \"~\"} {\n\t\tn := len(trimmed) - len(strings.TrimLeft(trimmed, c))\n\t\tif n < 3 {\n\t\t\tcontinue\n\t\t}\n\t\tif c == \"`\" && strings.Contains(trimmed[n:], \"`\") {\n\t\t\treturn \"\"\n\t\t}\n\t\treturn trimmed[:n]\n\t}\n\treturn \"\"\n}\n\n// acceptedLimitsOf collects the limits the scope's specs declare.\nfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n\tspecs, err := s.reviewScopeSpecs(scope)\n\tif err != nil {\n\t\treturn nil\n\t}\n\treturn acceptedLimitsOfSpecs(specs)\n}\n\n// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n// by its spec when there is more than one spec.\nfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n\tvar out []ReviewAcceptedLimit\n\tfor _, spec := range specs {\n\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n\t\tfor _, l := range limits {\n\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n\t\t\t// so a finding names exactly one sealed limit.\n\t\t\tif len(specs) > 1 {\n\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n\t\t\t}\n\t\t\tout = append(out, l)\n\t\t}\n\t}\n\treturn out\n}\n\n// sealedAcceptedLimit reports whether the bundle sealed limit id.\nfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n\t\tif l.ID == id {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n","numLines":218,"startLine":1,"totalLines":218}},"tool_result_meta":[{"id":"toolu_019uWhtpvgxAy3MtCpL7EZKs","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
