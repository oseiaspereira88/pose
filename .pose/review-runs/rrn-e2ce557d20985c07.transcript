{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RY8w5bfdPyXmXCEUkd2P4Q","type":"tool_result","content":"100\t\t})\n101\t}\n102\t\n103\tfunc (s Store) reviewAttestationProjectSet(att ReviewAttestation) (map[string]bool, error) {\n104\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n105\t\tif err != nil {\n106\t\t\treturn nil, err\n107\t\t}\n108\t\tlocalID := s.FederatedProjectID\n109\t\tif localID == \"\" {\n110\t\t\tlocalID, err = s.WriteProjectID()\n111\t\t\tif err != nil {\n112\t\t\t\treturn nil, err\n113\t\t\t}\n114\t\t}\n115\t\tprojects := map[string]bool{localID: true}\n116\t\tif reviewDecisionApproves(att.Decision) {\n117\t\t\t_, current, err := s.reviewBundleProjectSet(bundle.Payload.Scope.Ref)\n118\t\t\tif err != nil {\n119\t\t\t\treturn nil, err\n120\t\t\t}\n121\t\t\tprojects = mergeGovernanceProjectSets(projects, current)\n122\t\t}\n123\t\treturn projects, nil\n124\t}\n125\t\n126\tfunc (s Store) withReviewAttestationWriteGuard(operation string, att ReviewAttestation, callback func(Store) error) error {\n127\t\tif callback == nil {\n128\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"callback is required\"))\n129\t\t}\n130\t\tlockedProjects, err := s.reviewAttestationProjectSet(att)\n131\t\tif err != nil {\n132\t\t\treturn err\n133\t\t}\n134\t\treturn s.withExplicitGovernanceWriteGuard(operation, governanceProjectIDs(lockedProjects), func(guarded Store) error {\n135\t\t\tbundle, err := guarded.LoadReviewBundle(att.BundleID)\n136\t\t\tif err != nil {\n137\t\t\t\treturn err\n138\t\t\t}\n139\t\t\tobserved := map[string]bool{}\n140\t\t\tlocalID := guarded.FederatedProjectID\n141\t\t\tif localID == \"\" {\n142\t\t\t\tlocalID, err = guarded.WriteProjectID()\n143\t\t\t\tif err != nil {\n144\t\t\t\t\treturn err\n145\t\t\t\t}\n146\t\t\t}\n147\t\t\tobserved[localID] = true\n148\t\t\tif reviewDecisionApproves(att.Decision) {\n149\t\t\t\t_, current, prepErr := guarded.reviewBundleProjectSet(bundle.Payload.Scope.Ref)\n150\t\t\t\tif prepErr != nil {\n151\t\t\t\t\treturn prepErr\n152\t\t\t\t}\n153\t\t\t\tobserved = mergeGovernanceProjectSets(observed, current)\n154\t\t\t}\n155\t\t\tif err := requireSameGovernanceProjectSet(operation, lockedProjects, observed); err != nil {\n156\t\t\t\treturn err\n157\t\t\t}\n158\t\t\treturn callback(guarded)\n159\t\t})\n160\t}\n161\t\n162\tfunc (s Store) reviewRunProjectSet(runID string) (map[string]bool, error) {\n163\t\tlocalID := s.FederatedProjectID\n164\t\tif localID == \"\" {\n165\t\t\tvar err error\n166\t\t\tlocalID, err = s.WriteProjectID()\n167\t\t\tif err != nil {\n168\t\t\t\treturn nil, err\n169\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"7cb1388d-8e87-4645-afc0-e840e28c89b1","timestamp":"2026-11-26T06:11:26.666Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-349050671/worktree/pose-mcp/internal/pose/review_write_scope.go","content":"\t})\n}\n\nfunc (s Store) reviewAttestationProjectSet(att ReviewAttestation) (map[string]bool, error) {\n\tbundle, err := s.LoadReviewBundle(att.BundleID)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tlocalID := s.FederatedProjectID\n\tif localID == \"\" {\n\t\tlocalID, err = s.WriteProjectID()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tprojects := map[string]bool{localID: true}\n\tif reviewDecisionApproves(att.Decision) {\n\t\t_, current, err := s.reviewBundleProjectSet(bundle.Payload.Scope.Ref)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tprojects = mergeGovernanceProjectSets(projects, current)\n\t}\n\treturn projects, nil\n}\n\nfunc (s Store) withReviewAttestationWriteGuard(operation string, att ReviewAttestation, callback func(Store) error) error {\n\tif callback == nil {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"callback is required\"))\n\t}\n\tlockedProjects, err := s.reviewAttestationProjectSet(att)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn s.withExplicitGovernanceWriteGuard(operation, governanceProjectIDs(lockedProjects), func(guarded Store) error {\n\t\tbundle, err := guarded.LoadReviewBundle(att.BundleID)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tobserved := map[string]bool{}\n\t\tlocalID := guarded.FederatedProjectID\n\t\tif localID == \"\" {\n\t\t\tlocalID, err = guarded.WriteProjectID()\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\tobserved[localID] = true\n\t\tif reviewDecisionApproves(att.Decision) {\n\t\t\t_, current, prepErr := guarded.reviewBundleProjectSet(bundle.Payload.Scope.Ref)\n\t\t\tif prepErr != nil {\n\t\t\t\treturn prepErr\n\t\t\t}\n\t\t\tobserved = mergeGovernanceProjectSets(observed, current)\n\t\t}\n\t\tif err := requireSameGovernanceProjectSet(operation, lockedProjects, observed); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn callback(guarded)\n\t})\n}\n\nfunc (s Store) reviewRunProjectSet(runID string) (map[string]bool, error) {\n\tlocalID := s.FederatedProjectID\n\tif localID == \"\" {\n\t\tvar err error\n\t\tlocalID, err = s.WriteProjectID()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}","numLines":70,"startLine":100,"totalLines":217}},"tool_result_meta":[{"id":"toolu_01RY8w5bfdPyXmXCEUkd2P4Q","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
