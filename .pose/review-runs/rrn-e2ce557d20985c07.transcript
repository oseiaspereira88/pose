{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AU2FzgruuRsZnfL5qd44Sd","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"testing\"\n8\t)\n9\t\n10\t// TestSchemaDrift guards the contract between the Go structs and the\n11\t// versioned response schemas (ADR-014, additive-only): every field the Go\n12\t// side serializes must be declared in the schema, and every schema-required\n13\t// field must actually serialize.\n14\tfunc TestSchemaDrift(t *testing.T) {\n15\t\tcases := []struct {\n16\t\t\tschema string\n17\t\t\tsample any\n18\t\t}{\n19\t\t\t{\"spec.schema.json\", Spec{Slug: \"s\", Status: \"done\", CreatedAt: \"2026-01-01\",\n20\t\t\t\tCompletedAt: \"2026-01-02\", Supersedes: \"old\", Remediates: []string{\"spec:old@defect-fix\"}, Title: \"T\", Path: \"p\", Body: \"b\"}},\n21\t\t\t{\"artifact.schema.json\", Markdown{Name: \"n\", Title: \"T\", Path: \"p\", Body: \"b\"}},\n22\t\t\t{\"gate-result.schema.json\", GateResult{Command: \"c\", ExitCode: 1, Passed: false, Output: \"o\"}},\n23\t\t\t{\"insights.schema.json\", InsightsResult{GroupBy: \"workflow\", SinceDays: 30,\n24\t\t\t\tRecordsScanned: 2, RecordsSkippedByWindow: 1, RecordsSkippedInvalid: 0,\n25\t\t\t\tRows: []InsightRow{{Key: \"feature\", Pass: 1, Total: 1}}}},\n26\t\t\t{\"obligation.schema.json\", sampleObligation(ObligationDependency)},\n27\t\t\t{\"contract-nodes.schema.json\", ProjectContractNodes(\"nodes\", \"# Spec\\n\\n## 2. Requirements\\n\\n- R1: One.\\n\\n## 5. Decisions\\n\\n### Decision D1\\n- Basis: R7\\n\")},\n28\t\t}\n29\t\tfor _, tc := range cases {\n30\t\t\tt.Run(tc.schema, func(t *testing.T) {\n31\t\t\t\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"schemas\", \"v1\", tc.schema))\n32\t\t\t\tif err != nil {\n33\t\t\t\t\tt.Fatalf(\"reading schema: %v\", err)\n34\t\t\t\t}\n35\t\t\t\tvar schema struct {\n36\t\t\t\t\tProperties map[string]any `json:\"properties\"`\n37\t\t\t\t\tRequired   []string       `json:\"required\"`\n38\t\t\t\t}\n39\t\t\t\tif err := json.Unmarshal(raw, &schema); err != nil {\n40\t\t\t\t\tt.Fatalf(\"parsing schema: %v\", err)\n41\t\t\t\t}\n42\t\n43\t\t\t\tdata, err := json.Marshal(tc.sample)\n44\t\t\t\tif err != nil {\n45\t\t\t\t\tt.Fatal(err)\n46\t\t\t\t}\n47\t\t\t\tvar serialized map[string]any\n48\t\t\t\tif err := json.Unmarshal(data, &serialized); err != nil {\n49\t\t\t\t\tt.Fatal(err)\n50\t\t\t\t}\n51\t\n52\t\t\t\tfor field := range serialized {\n53\t\t\t\t\tif _, ok := schema.Properties[field]; !ok {\n54\t\t\t\t\t\tt.Errorf(\"field %q serialized by Go but absent from %s (additive-only: declare it)\", field, tc.schema)\n55\t\t\t\t\t}\n56\t\t\t\t}\n57\t\t\t\tfor _, req := range schema.Required {\n58\t\t\t\t\tif _, ok := serialized[req]; !ok {\n59\t\t\t\t\t\tt.Errorf(\"schema-required field %q not serialized by the Go struct\", req)\n60\t\t\t\t\t}\n61\t\t\t\t}\n62\t\t\t})\n63\t\t}\n64\t}\n65\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"b03b4e6d-e6f4-468e-bbc6-f5518edb503d","timestamp":"2026-11-26T05:37:59.460Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-349050671/worktree/pose-mcp/internal/pose/schema_test.go","content":"package pose\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\n// TestSchemaDrift guards the contract between the Go structs and the\n// versioned response schemas (ADR-014, additive-only): every field the Go\n// side serializes must be declared in the schema, and every schema-required\n// field must actually serialize.\nfunc TestSchemaDrift(t *testing.T) {\n\tcases := []struct {\n\t\tschema string\n\t\tsample any\n\t}{\n\t\t{\"spec.schema.json\", Spec{Slug: \"s\", Status: \"done\", CreatedAt: \"2026-01-01\",\n\t\t\tCompletedAt: \"2026-01-02\", Supersedes: \"old\", Remediates: []string{\"spec:old@defect-fix\"}, Title: \"T\", Path: \"p\", Body: \"b\"}},\n\t\t{\"artifact.schema.json\", Markdown{Name: \"n\", Title: \"T\", Path: \"p\", Body: \"b\"}},\n\t\t{\"gate-result.schema.json\", GateResult{Command: \"c\", ExitCode: 1, Passed: false, Output: \"o\"}},\n\t\t{\"insights.schema.json\", InsightsResult{GroupBy: \"workflow\", SinceDays: 30,\n\t\t\tRecordsScanned: 2, RecordsSkippedByWindow: 1, RecordsSkippedInvalid: 0,\n\t\t\tRows: []InsightRow{{Key: \"feature\", Pass: 1, Total: 1}}}},\n\t\t{\"obligation.schema.json\", sampleObligation(ObligationDependency)},\n\t\t{\"contract-nodes.schema.json\", ProjectContractNodes(\"nodes\", \"# Spec\\n\\n## 2. Requirements\\n\\n- R1: One.\\n\\n## 5. Decisions\\n\\n### Decision D1\\n- Basis: R7\\n\")},\n\t}\n\tfor _, tc := range cases {\n\t\tt.Run(tc.schema, func(t *testing.T) {\n\t\t\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"schemas\", \"v1\", tc.schema))\n\t\t\tif err != nil {\n\t\t\t\tt.Fatalf(\"reading schema: %v\", err)\n\t\t\t}\n\t\t\tvar schema struct {\n\t\t\t\tProperties map[string]any `json:\"properties\"`\n\t\t\t\tRequired   []string       `json:\"required\"`\n\t\t\t}\n\t\t\tif err := json.Unmarshal(raw, &schema); err != nil {\n\t\t\t\tt.Fatalf(\"parsing schema: %v\", err)\n\t\t\t}\n\n\t\t\tdata, err := json.Marshal(tc.sample)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tvar serialized map[string]any\n\t\t\tif err := json.Unmarshal(data, &serialized); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\n\t\t\tfor field := range serialized {\n\t\t\t\tif _, ok := schema.Properties[field]; !ok {\n\t\t\t\t\tt.Errorf(\"field %q serialized by Go but absent from %s (additive-only: declare it)\", field, tc.schema)\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor _, req := range schema.Required {\n\t\t\t\tif _, ok := serialized[req]; !ok {\n\t\t\t\t\tt.Errorf(\"schema-required field %q not serialized by the Go struct\", req)\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\n","numLines":65,"startLine":1,"totalLines":65}},"tool_result_meta":[{"id":"toolu_01AU2FzgruuRsZnfL5qd44Sd","permission_decision":{"decision":"accept"