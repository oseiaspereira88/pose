{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014MxZjtR61EwVc4DdQWZ2tK","type":"tool_result","content":"1265\t\t\tfmt.Fprintf(stderr, \"pose review auto-attest: %v\\n\", err)\n1266\t\t\treturn 1\n1267\t\t}\n1268\t\tfmt.Fprintf(stdout, \"Review attestation auto-recorded: %s\\n\", filepath.Join(root, filepath.FromSlash(att.Path)))\n1269\t\treturn 0\n1270\t}\n1271\t\n1272\tfunc parseCLIReviewFindings(values []string) ([]posemodel.ReviewFinding, error) {\n1273\t\tresult := make([]posemodel.ReviewFinding, 0, len(values))\n1274\t\tfor _, raw := range values {\n1275\t\t\tparts := strings.Split(raw, \"|\")\n1276\t\t\tif len(parts) < 5 || posemodel.ValidateSlug(parts[0]) != nil {\n1277\t\t\t\treturn nil, fmt.Errorf(\"finding must be ID|severity|disposition|action|evidence[|owner|rationale|review-by]\")\n1278\t\t\t}\n1279\t\t\tfinding := posemodel.ReviewFinding{ID: parts[0], Severity: parts[1], Disposition: parts[2], Action: parts[3], Evidence: parts[4]}\n1280\t\t\tif len(parts) > 5 {\n1281\t\t\t\tfinding.Owner = parts[5]\n1282\t\t\t}\n1283\t\t\tif len(parts) > 6 {\n1284\t\t\t\tfinding.Rationale = parts[6]\n1285\t\t\t}\n1286\t\t\tif len(parts) > 7 {\n1287\t\t\t\tfinding.ReviewBy = parts[7]\n1288\t\t\t}\n1289\t\t\tresult = append(result, finding)\n1290\t\t}\n1291\t\treturn result, nil\n1292\t}\n1293\t\n1294\tfunc cmdReviewRecord(root string, args []string, stdout, stderr io.Writer) int {\n1295\t\tvar ref, reviewer, decision, expectedPlanDigest string\n1296\t\tvar evidence, findings, toolDispositions []string\n1297\t\tapply := false\n1298\t\tfor i := 0; i < len(args); i++ {\n1299\t\t\tswitch args[i] {\n1300\t\t\tcase \"--reviewer\", \"--decision\", \"--evidence\", \"--finding\", \"--plan-digest\", \"--tool\":\n1301\t\t\t\tif i+1 >= len(args) {\n1302\t\t\t\t\tfmt.Fprintln(stderr, \"pose review record: missing option value\")\n1303\t\t\t\t\treturn 2\n1304\t\t\t\t}\n1305\t\t\t\ti++\n1306\t\t\t\tswitch args[i-1] {\n1307\t\t\t\tcase \"--reviewer\":\n1308\t\t\t\t\treviewer = args[i]\n1309\t\t\t\tcase \"--decision\":\n1310\t\t\t\t\tdecision = args[i]\n1311\t\t\t\tcase \"--evidence\":\n1312\t\t\t\t\tevidence = append(evidence, args[i])\n1313\t\t\t\tcase \"--finding\":\n1314\t\t\t\t\tfindings = append(findings, args[i])\n1315\t\t\t\tcase \"--plan-digest\":\n1316\t\t\t\t\texpectedPlanDigest = args[i]\n1317\t\t\t\tcase \"--tool\":\n1318\t\t\t\t\ttoolDispositions = append(toolDispositions, args[i])\n1319\t\t\t\t}\n1320\t\t\tcase \"--apply\":\n1321\t\t\t\tapply = true\n1322\t\t\tdefault:\n1323\t\t\t\tif strings.HasPrefix(args[i], \"-\") || ref != \"\" {\n1324\t\t\t\t\tfmt.Fprintf(stderr, \"pose review record: unexpected argument %q\\n\", args[i])\n1325\t\t\t\t\treturn 2\n1326\t\t\t\t}\n1327\t\t\t\tref = args[i]\n1328\t\t\t}\n1329\t\t}\n1330\t\tif ref == \"\" || reviewer == \"\" || decision == \"\" || len(evidence) == 0 {\n1331\t\t\tfmt.Fprintln(stderr, \"pose review record: scope, reviewer, decision and at least one evidence ref are required\")\n1332\t\t\treturn 2\n1333\t\t}\n1334\t\tallowedDecision := map[string]bool{\"approved\": true, \"approved-with-reservations\": true, \"changes-requested\": true, \"rejected\": true}\n1335\t\tif !allowedDecision[decision] || strings.ContainsAny(reviewer, \"\\r\\n\") {\n1336\t\t\tfmt.Fprintln(stderr, \"pose review record: invalid decision or reviewer\")\n1337\t\t\treturn 2\n1338\t\t}\n1339\t\tstore := cliGovernedStore(root)\n1340\t\tpolicy, err := store.GetReviewPolicy()\n1341\t\tif err != nil {\n1342\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n1343\t\t\treturn 1\n1344\t\t}\n1345\t\tif policy.ReviewBundles {\n1346\t\t\tverification, verifyErr := store.VerifyReviewBundle(ref)\n1347\t\t\tif verifyErr != nil {\n1348\t\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", verifyErr)\n1349\t\t\t\treturn 1\n1350\t\t\t}\n1351\t\t\tif verification.Bundle == nil || !verification.Fresh {\n1352\t\t\t\tfmt.Fprintln(stderr, \"pose review record: bundle policy requires a current sealed bundle; run pose review bundle <scope> --seal\")\n1353\t\t\t\treturn 1\n1354\t\t\t}\n1355\t\t\tadapted := append([]string{}, args...)\n1356\t\t\tfor i, value := range adapted {\n1357\t\t\t\tif value == ref {\n1358\t\t\t\t\tadapted[i] = verification.Bundle.BundleID\n1359\t\t\t\t\tbreak\n1360\t\t\t\t}\n1361\t\t\t}\n1362\t\t\treturn cmdReviewAttest(root, adapted, stdout, stderr)\n1363\t\t}\n1364\t\tprofile, err := store.ReviewProfileForScope(ref)\n1365\t\tif err != nil {\n1366\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n1367\t\t\treturn 1\n1368\t\t}\n1369\t\tdigest, err := store.ScopeDigest(ref)\n1370\t\tif err != nil {\n1371\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n1372\t\t\treturn 1\n1373\t\t}\n1374\t\tplan, err := store.ReviewPlan(ref)\n1375\t\tif err != nil {\n1376\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n1377\t\t\treturn 1\n1378\t\t}\n1379\t\tif len(plan.Blockers) > 0 {\n1380\t\t\tfmt.Fprintf(stderr, \"pose review record: effective review plan is blocked: %s\\n\", strings.Join(plan.Blockers, \"; \"))\n1381\t\t\treturn 1\n1382\t\t}\n1383\t\tif expectedPlanDigest != \"\" && expectedPlanDigest != plan.PlanDigest {\n1384\t\t\tfmt.Fprintf(stderr, \"pose review record: expected plan digest %s, current is %s\\n\", expectedPlanDigest, plan.PlanDigest)\n1385\t\t\treturn 1\n1386\t\t}\n1387\t\tattemptsRead, err := store.ReadReviewAttempts(ref)\n1388\t\tattempts := attemptsRead.Attempts\n1389\t\tlastAt, lastID := \"\", \"\"\n1390\t\tif len(attempts) > 0 {\n1391\t\t\tlastAt, lastID = attempts[len(attempts)-1].ReviewedAt, attempts[len(attempts)-1].ReviewID\n1392\t\t}\n1393\t\tif lost := attemptsRead.HistoryUncertainAfter(ref, lastAt, lastID); err == nil && len(lost) > 0 {\n1394\t\t\t// The attempt this one supersedes would be chosen from a history with a hole.\n1395\t\t\terr = fmt.Errorf(\"the review history for %s is incomplete (%s); restore or remove the unreadable record before recording\", ref, (posemodel.SourceCoverage{Losses: lost}).Describe(\"\"))\n1396\t\t}\n1397\t\tif err != nil {\n1398\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n1399\t\t\treturn 1\n1400\t\t}\n1401\t\tsupersedes := \"\"\n1402\t\tif len(attempts) > 0 {\n1403\t\t\tsupersedes = attempts[len(attempts)-1].ReviewID\n1404\t\t}\n1405\t\tnow := time.Now().UTC().Truncate(time.Second)\n1406\t\tsum := sha256.Sum256([]byte(ref + digest + reviewer + now.Format(time.RFC3339)))\n1407\t\treviewID := \"rvw-\" + now.Format(\"20060102T150405Z\") + \"-\" + hex.EncodeToString(sum[:4])\n1408\t\tsort.Strings(evidence)\n1409\t\tcontent, err := renderReviewAttempt(reviewID, ref, digest, plan, profile, reviewer, decision, now.Format(time.RFC3339), supersedes, evidence, toolDispositions, findings, policy.SchemaVersion >= 2 && policy.ComponentAware)\n1410\t\tif err != nil {\n1411\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n1412\t\t\treturn 2\n1413\t\t}\n1414\t\tpath := filepath.Join(root, \".pose\", \"reviews\", reviewID+\".md\")\n1415\t\tif !apply {\n1416\t\t\tfmt.Fprintf(stdout, \"review.plan=record\\nreview.id=%s\\nreview.scope=%s\\nreview.digest=%s\\nreview.plan_digest=%s\\nreview.path=%s\\nreview.apply=false\\n\", reviewID, ref, digest, plan.PlanDigest, filepath.ToSlash(strings.TrimPrefix(path, root+string(os.PathSeparator))))\n1417\t\t\treturn 0\n1418\t\t}\n1419\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n1420\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n1421\t\t\treturn 1\n1422\t\t}\n1423\t\tif err := writeFileExclusive(path, []byte(content)); err != nil {\n1424\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n1425\t\t\treturn 1\n1426\t\t}\n1427\t\tfmt.Fprintf(stdout, \"Review recorded: %s\\n\", path)\n1428\t\treturn 0\n1429\t}\n1430\t\n1431\tfunc renderReviewAttempt(id, scope, digest string, plan posemodel.ReviewPlan, profile posemodel.ReviewProfile, reviewer, decision, reviewedAt, supersedes string, evidence, rawTools, findings []string, componentAware bool) (string, error) {\n1432\t\ttools, err := reviewToolDispositions(plan, rawTools, componentAware)\n1433\t\tif err != nil {\n1434\t\t\treturn \"\", err\n1435\t\t}\n1436\t\tvar b strings.Builder\n1437\t\tfmt.Fprintf(&b, \"---\\nschema_version: 1\\nreview_id: %s\\nscope: %s\\nscope_digest: %s\\nplan_digest: %s\\nprofile: %s\\nreviewer: %s\\ndecision: %s\\nreviewed_at: %s\\n\", id, scope, digest, plan.PlanDigest, profile.Ref(), reviewer, decision, reviewedAt)\n1438\t\tif supersedes == \"\" {\n1439\t\t\tb.WriteString(\"supersedes:\\n\")\n1440\t\t} else {\n1441\t\t\tfmt.Fprintf(&b, \"supersedes: %s\\n\", supersedes)\n1442\t\t}\n1443\t\tfmt.Fprintf(&b, \"evidence_refs: [%s]\\n---\\n\\n## Criteria\\n\", strings.Join(evidence, \", \"))\n1444\t\tfor _, criterion := range plan.Criteria {\n1445\t\t\tif !criterion.Required {\n1446\t\t\t\tcontinue\n1447\t\t\t}\n1448\t\t\tfmt.Fprintf(&b, \"- %s [passed] evidence:%s\\n\", criterion.ID, reviewCriterionEvidence(criterion, evidence))\n1449\t\t}\n1450\t\tb.WriteString(\"\\n## Tools\\n\")\n1451\t\tfor _, tool := range tools {\n1452\t\t\tfmt.Fprintf(&b, \"- %s [%s]\", tool.ID, tool.Disposition)\n1453\t\t\tif tool.Component != \"\" {\n1454\t\t\t\tfmt.Fprintf(&b, \" component:%s\", url.QueryEscape(tool.Component))\n1455\t\t\t}\n1456\t\t\tif tool.Evidence != \"\" {\n1457\t\t\t\tfmt.Fprintf(&b, \" evidence:%s\", tool.Evidence)\n1458\t\t\t}\n1459\t\t\tif tool.Rationale != \"\" {\n1460\t\t\t\tfmt.Fprintf(&b, \" rationale:%s\", strings.ReplaceAll(tool.Rationale, \" \", \"_\"))\n1461\t\t\t}\n1462\t\t\tb.WriteByte('\\n')\n1463\t\t}\n1464\t\tb.WriteString(\"\\n## Findings\\n\")\n1465\t\tfor _, raw := range findings {\n1466\t\t\tparts := strings.Split(raw, \"|\")\n1467\t\t\tif len(parts) < 5 || posemodel.ValidateSlug(parts[0]) != nil {\n1468\t\t\t\treturn \"\", fmt.Errorf(\"finding must be ID|severity|disposition|action|evidence\")\n1469\t\t\t}\n1470\t\t\tfmt.Fprintf(&b, \"- %s [%s] severity:%s action:%s evidence:%s\", parts[0], parts[2], parts[1], strings.ReplaceAll(parts[3], \" \", \"_\"), strings.ReplaceAll(parts[4], \" \", \"_\"))\n1471\t\t\tif len(parts) > 5 && parts[5] != \"\" {\n1472\t\t\t\tfmt.Fprintf(&b, \" owner:%s\", parts[5])\n1473\t\t\t}\n1474\t\t\tif len(parts) > 6 && parts[6] != \"\" {\n1475\t\t\t\tfmt.Fprintf(&b, \" rationale:%s\", strings.ReplaceAll(parts[6], \" \", \"_\"))\n1476\t\t\t}\n1477\t\t\tif len(parts) > 7 && parts[7] != \"\" {\n1478\t\t\t\tfmt.Fprintf(&b, \" review_by:%s\", parts[7])\n1479\t\t\t}\n1480\t\t\tb.WriteByte('\\n')\n1481\t\t}\n1482\t\treturn b.String(), nil\n1483\t}\n1484\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"6233c967-3660-4dd5-8c2c-a29251011ad5","timestamp":"2026-11-26T05:38:34.000Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-349050671/worktree/pose-mcp/internal/cli/review_closeout.go","content":"\t\tfmt.Fprintf(stderr, \"pose review auto-attest: %v\\n\", err)\n\t\treturn 1\n\t}\n\tfmt.Fprintf(stdout, \"Review attestation auto-recorded: %s\\n\", filepath.Join(root, filepath.FromSlash(att.Path)))\n\treturn 0\n}\n\nfunc parseCLIReviewFindings(values []string) ([]posemodel.ReviewFinding, error) {\n\tresult := make([]posemodel.ReviewFinding, 0, len(values))\n\tfor _, raw := range values {\n\t\tparts := strings.Split(raw, \"|\")\n\t\tif len(parts) < 5 || posemodel.ValidateSlug(parts[0]) != nil {\n\t\t\treturn nil, fmt.Errorf(\"finding must be ID|severity|disposition|action|evidence[|owner|rationale|review-by]\")\n\t\t}\n\t\tfinding := posemodel.ReviewFinding{ID: parts[0], Severity: parts[1], Disposition: parts[2], Action: parts[3], Evidence: parts[4]}\n\t\tif len(parts) > 5 {\n\t\t\tfinding.Owner = parts[5]\n\t\t}\n\t\tif len(parts) > 6 {\n\t\t\tfinding.Rationale = parts[6]\n\t\t}\n\t\tif len(parts) > 7 {\n\t\t\tfinding.ReviewBy = parts[7]\n\t\t}\n\t\tresult = append(result, finding)\n\t}\n\treturn result, nil\n}\n\nfunc cmdReviewRecord(root string, args []string, stdout, stderr io.Writer) int {\n\tvar ref, reviewer, decision, expectedPlanDigest string\n\tvar evidence, findings, toolDispositions []string\n\tapply := false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--reviewer\", \"--decision\", \"--evidence\", \"--finding\", \"--plan-digest\", \"--tool\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\tfmt.Fprintln(stderr, \"pose review record: missing option value\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\ti++\n\t\t\tswitch args[i-1] {\n\t\t\tcase \"--reviewer\":\n\t\t\t\treviewer = args[i]\n\t\t\tcase \"--decision\":\n\t\t\t\tdecision = args[i]\n\t\t\tcase \"--evidence\":\n\t\t\t\tevidence = append(evidence, args[i])\n\t\t\tcase \"--finding\":\n\t\t\t\tfindings = append(findings, args[i])\n\t\t\tcase \"--plan-digest\":\n\t\t\t\texpectedPlanDigest = args[i]\n\t\t\tcase \"--tool\":\n\t\t\t\ttoolDispositions = append(toolDispositions, args[i])\n\t\t\t}\n\t\tcase \"--apply\":\n\t\t\tapply = true\n\t\tdefault:\n\t\t\tif strings.HasPrefix(args[i], \"-\") || ref != \"\" {\n\t\t\t\tfmt.Fprintf(stderr, \"pose review record: unexpected argument %q\\n\", args[i])\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\tref = args[i]\n\t\t}\n\t}\n\tif ref == \"\" || reviewer == \"\" || decision == \"\" || len(evidence) == 0 {\n\t\tfmt.Fprintln(stderr, \"pose review record: scope, reviewer, decision and at least one evidence ref are required\")\n\t\treturn 2\n\t}\n\tallowedDecision := map[string]bool{\"approved\": true, \"approved-with-reservations\": true, \"changes-requested\": true, \"rejected\": true}\n\tif !allowedDecision[decision] || strings.ContainsAny(reviewer, \"\\r\\n\") {\n\t\tfmt.Fprintln(stderr, \"pose review record: invalid decision or reviewer\")\n\t\treturn 2\n\t}\n\tstore := cliGovernedStore(root)\n\tpolicy, err := store.GetReviewPolicy()\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif policy.ReviewBundles {\n\t\tverification, verifyErr := store.VerifyReviewBundle(ref)\n\t\tif verifyErr != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", verifyErr)\n\t\t\treturn 1\n\t\t}\n\t\tif verification.Bundle == nil || !verification.Fresh {\n\t\t\tfmt.Fprintln(stderr, \"pose review record: bundle policy requires a current sealed bundle; run pose review bundle <scope> --seal\")\n\t\t\treturn 1\n\t\t}\n\t\tadapted := append([]string{}, args...)\n\t\tfor i, value := range adapted {\n\t\t\tif value == ref {\n\t\t\t\tadapted[i] = verification.Bundle.BundleID\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\treturn cmdReviewAttest(root, adapted, stdout, stderr)\n\t}\n\tprofile, err := store.ReviewProfileForScope(ref)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n\t\treturn 1\n\t}\n\tdigest, err := store.ScopeDigest(ref)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n\t\treturn 1\n\t}\n\tplan, err := store.ReviewPlan(ref)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif len(plan.Blockers) > 0 {\n\t\tfmt.Fprintf(stderr, \"pose review record: effective review plan is blocked: %s\\n\", strings.Join(plan.Blockers, \"; \"))\n\t\treturn 1\n\t}\n\tif expectedPlanDigest != \"\" && expectedPlanDigest != plan.PlanDigest {\n\t\tfmt.Fprintf(stderr, \"pose review record: expected plan digest %s, current is %s\\n\", expectedPlanDigest, plan.PlanDigest)\n\t\treturn 1\n\t}\n\tattemptsRead, err := store.ReadReviewAttempts(ref)\n\tattempts := attemptsRead.Attempts\n\tlastAt, lastID := \"\", \"\"\n\tif len(attempts) > 0 {\n\t\tlastAt, lastID = attempts[len(attempts)-1].ReviewedAt, attempts[len(attempts)-1].ReviewID\n\t}\n\tif lost := attemptsRead.HistoryUncertainAfter(ref, lastAt, lastID); err == nil && len(lost) > 0 {\n\t\t// The attempt this one supersedes would be chosen from a history with a hole.\n\t\terr = fmt.Errorf(\"the review history for %s is incomplete (%s); restore or remove the unreadable record before recording\", ref, (posemodel.SourceCoverage{Losses: lost}).Describe(\"\"))\n\t}\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n\t\treturn 1\n\t}\n\tsupersedes := \"\"\n\tif len(attempts) > 0 {\n\t\tsupersedes = attempts[len(attempts)-1].ReviewID\n\t}\n\tnow := time.Now().UTC().Truncate(time.Second)\n\tsum := sha256.Sum256([]byte(ref + digest + reviewer + now.Format(time.RFC3339)))\n\treviewID := \"rvw-\" + now.Format(\"20060102T150405Z\") + \"-\" + hex.EncodeToString(sum[:4])\n\tsort.Strings(evidence)\n\tcontent, err := renderReviewAttempt(reviewID, ref, digest, plan, profile, reviewer, decision, now.Format(time.RFC3339), supersedes, evidence, toolDispositions, findings, policy.SchemaVersion >= 2 && policy.ComponentAware)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n\t\treturn 2\n\t}\n\tpath := filepath.Join(root, \".pose\", \"reviews\", reviewID+\".md\")\n\tif !apply {\n\t\tfmt.Fprintf(stdout, \"review.plan=record\\nreview.id=%s\\nreview.scope=%s\\nreview.digest=%s\\nreview.plan_digest=%s\\nreview.path=%s\\nreview.apply=false\\n\", reviewID, ref, digest, plan.PlanDigest, filepath.ToSlash(strings.TrimPrefix(path, root+string(os.PathSeparator))))\n\t\treturn 0\n\t}\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif err := writeFileExclusive(path, []byte(content)); err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n\t\treturn 1\n\t}\n\tfmt.Fprintf(stdout, \"Review recorded: %s\\n\", path)\n\treturn 0\n}\n\nfunc renderReviewAttempt(id, scope, digest string, plan posemodel.ReviewPlan, profile posemodel.ReviewProfile, reviewer, decision, reviewedAt, supersedes string, evidence, rawTools, findings []string, componentAware bool) (string, error) {\n\ttools, err := reviewToolDispositions(plan, rawTools, componentAware)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tvar b strings.Builder\n\tfmt.Fprintf(&b, \"---\\nschema_version: 1\\nreview_id: %s\\nscope: %s\\nscope_digest: %s\\nplan_digest: %s\\nprofile: %s\\nreviewer: %s\\ndecision: %s\\nreviewed_at: %s\\n\", id, scope, digest, plan.PlanDigest, profile.Ref(), reviewer, decision, reviewedAt)\n\tif supersedes == \"\" {\n\t\tb.WriteString(\"supersedes:\\n\")\n\t} else {\n\t\tfmt.Fprintf(&b, \"supersedes: %s\\n\", supersedes)\n\t}\n\tfmt.Fprintf(&b, \"evidence_refs: [%s]\\n---\\n\\n## Criteria\\n\", strings.Join(evidence, \", \"))\n\tfor _, criterion := range plan.Criteria {\n\t\tif !criterion.Required {\n\t\t\tcontinue\n\t\t}\n\t\tfmt.Fprintf(&b, \"- %s [passed] evidence:%s\\n\", criterion.ID, reviewCriterionEvidence(criterion, evidence))\n\t}\n\tb.WriteString(\"\\n## Tools\\n\")\n\tfor _, tool := range tools {\n\t\tfmt.Fprintf(&b, \"- %s [%s]\", tool.ID, tool.Disposition)\n\t\tif tool.Component != \"\" {\n\t\t\tfmt.Fprintf(&b, \" component:%s\", url.QueryEscape(tool.Component))\n\t\t}\n\t\tif tool.Evidence != \"\" {\n\t\t\tfmt.Fprintf(&b, \" evidence:%s\", tool.Evidence)\n\t\t}\n\t\tif tool.Rationale != \"\" {\n\t\t\tfmt.Fprintf(&b, \" rationale:%s\", strings.ReplaceAll(tool.Rationale, \" \", \"_\"))\n\t\t}\n\t\tb.WriteByte('\\n')\n\t}\n\tb.WriteString(\"\\n## Findings\\n\")\n\tfor _, raw := range findings {\n\t\tparts := strings.Split(raw, \"|\")\n\t\tif len(parts) < 5 || posemodel.ValidateSlug(parts[0]) != nil {\n\t\t\treturn \"\", fmt.Errorf(\"finding must be ID|severity|disposition|action|evidence\")\n\t\t}\n\t\tfmt.Fprintf(&b, \"- %s [%s] severity:%s action:%s evidence:%s\", parts[0], parts[2], parts[1], strings.ReplaceAll(parts[3], \" \", \"_\"), strings.ReplaceAll(parts[4], \" \", \"_\"))\n\t\tif len(parts) > 5 && parts[5] != \"\" {\n\t\t\tfmt.Fprintf(&b, \" owner:%s\", parts[5])\n\t\t}\n\t\tif len(parts) > 6 && parts[6] != \"\" {\n\t\t\tfmt.Fprintf(&b, \" rationale:%s\", strings.ReplaceAll(parts[6], \" \", \"_\"))\n\t\t}\n\t\tif len(parts) > 7 && parts[7] != \"\" {\n\t\t\tfmt.Fprintf(&b, \" review_by:%s\", parts[7])\n\t