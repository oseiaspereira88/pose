:= range acceptedLimitsMissingFromADRs(lintProjectRoot(specPath), slug, limits) {\n+\t\t\t\tlint.finding(cliout.StateError, \"dor\", missing)\n+\t\t\t\tfailures++\n+\t\t\t}\n+\t\t}\n \t\temitDesignBasis()\n \t\tfailures += designFailures + lineageFailures\n \t\tready := \"true\"\n@@ -1168,3 +1184,77 @@ func containsSection(names []string, name string) bool {\n \t}\n \treturn false\n }\n+\n+// acceptedLimitsMissingFromADRs names each declared limit an ADR that cites\n+// the spec does not mention. With no ADR citing the spec nothing is required.\n+func acceptedLimitsMissingFromADRs(root, slug string, limits []posepkg.ReviewAcceptedLimit) []string {\n+\tentries, err := os.ReadDir(filepath.Join(root, \".pose\", \"adr\"))\n+\tif errors.Is(err, os.ErrNotExist) {\n+\t\treturn nil\n+\t}\n+\t// An ADR that cannot be read may be the one that cites the spec: the\n+\t// check fails closed instead of reading it as absent (review round 5, N2).\n+\tif err != nil {\n+\t\treturn []string{\"DoR: the ADRs cannot be read to check the accepted limits: \" + err.Error()}\n+\t}\n+\t// A whole slug, or the dated file a link names (review round 9, N3).\n+\tcitesSlug := regexp.MustCompile(`(^|[^A-Za-z0-9_-]|[0-9]{4}-[0-9]{2}-[0-9]{2}-)` + regexp.QuoteMeta(slug) + `($|[^A-Za-z0-9_-])`)\n+\tvar citing []string\n+\tvar unreadable []string\n+\tfor _, e := range entries {\n+\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".md\") {\n+\t\t\tcontinue\n+\t\t}\n+\t\traw, err := readADRBounded(filepath.Join(root, \".pose\", \"adr\", e.Name()))\n+\t\tif err != nil {\n+\t\t\tunreadable = append(unreadable, \"DoR: ADR \"+e.Name()+\" cannot be read to check the accepted limits: \"+err.Error())\n+\t\t\tcontinue\n+\t\t}\n+\t\t// The slug as a whole name: an ADR about a longer slug does not cite a\n+\t\t// shorter one it contains (review round 8, N4).\n+\t\tif !citesSlug.MatchString(string(raw)) {\n+\t\t\tcontinue\n+\t\t}\n+\t\tciting = append(citing, string(raw))\n+\t}\n+\tif len(unreadable) > 0 {\n+\t\treturn unreadable\n+\t}\n+\tif len(citing) == 0 {\n+\t\treturn nil\n+\t}\n+\tvar missing []string\n+\tfor _, l := range limits {\n+\t\tfound := false\n+\t\t// The id as a word: L10 does not name L1 (review round 1, N3).\n+\t\tnamed := regexp.MustCompile(`\\b` + regexp.QuoteMeta(l.ID) + `\\b`)\n+\t\tfor _, adr := range citing {\n+\t\t\tfound = found || named.MatchString(adr)\n+\t\t}\n+\t\tif !found {\n+\t\t\tmissing = append(missing, \"DoR: accepted limit \"+l.ID+\" is not named by the ADR that cites \"+slug)\n+\t\t}\n+\t}\n+\treturn missing\n+}\n+\n+// adrReadLimit bounds one ADR the ready check reads.\n+const adrReadLimit = 1 << 20\n+\n+// readADRBounded reads a regular ADR file without following a link and\n+// within adrReadLimit, so a link out of the project or to an endless source\n+// fails instead of hanging the check (review round 7, N2).\n+func readADRBounded(path string) ([]byte, error) {\n+\tinfo, err := os.Lstat(path)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif !info.Mode().IsRegular() {\n+\t\treturn nil, fmt.Errorf(\"not a regular file\")\n+\t}\n+\tf, err := posepkg.ReadReviewAdapterFile(path, adrReadLimit)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\treturn f, nil\n+}\ndiff --git a/pose-mcp/internal/pose/governance_outcomes.go b/pose-mcp/internal/pose/governance_outcomes.go\nindex 050acbd8..e9541dcc 100644\n--- a/pose-mcp/internal/pose/governance_outcomes.go\n+++ b/pose-mcp/internal/pose/governance_outcomes.go\n@@ -103,6 +103,7 @@ type GovernanceReviewDimensions struct {\n \tResolvedFindings         int `json:\"resolved_findings\"`\n \tWontFixFindings          int `json:\"wont_fix_findings\"`\n \tOpenFindings             int `json:\"open_findings\"`\n+\tWithinLimitFindings      int `json:\"within_limit_findings\"`\n \tStaleObserved            int `json:\"stale_observed\"`\n \tStaleUnknown             int `json:\"stale_unknown\"`\n }\n@@ -451,6 +452,10 @@ func (s Store) GovernanceOutcomes(query GovernanceOutcomesQuery) (*GovernanceOut\n 