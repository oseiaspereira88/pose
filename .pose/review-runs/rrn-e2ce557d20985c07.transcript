nt.finding(sectionState(isRequired[name]), \"section\", fmt.Sprintf(cliText(locale, \"%s: skeletal (placeholders or comments only)\", \"%s: esqueleto (apenas placeholders/comentários)\"), name))\n637\t\t\t\tif isRequired[name] {\n638\t\t\t\t\trequiredMissing++\n639\t\t\t\t}\n640\t\t\tdefault:\n641\t\t\t\tempty++\n642\t\t\t\tlint.finding(sectionState(isRequired[name]), \"section\", fmt.Sprintf(cliText(locale, \"%s: empty\", \"%s: vazia\"), name))\n643\t\t\t\tif isRequired[name] {\n644\t\t\t\t\trequiredMissing++\n645\t\t\t\t}\n646\t\t\t}\n647\t\t}\n648\t\n649\t\tspecStatus := frontmatter[\"status\"]\n650\t\tif specStatus == \"\" {\n651\t\t\tspecStatus = \"unset\"\n652\t\t}\n653\t\tlifecycle := 0\n654\t\tif specStatus != \"unset\" && !validStatus[specStatus] {\n655\t\t\tlint.finding(cliout.StateError, \"frontmatter\", fmt.Sprintf(cliText(locale, \"invalid frontmatter status: '%s' (use draft|in-progress|done|blocked|superseded|abandoned)\", \"status inválido no frontmatter: '%s' (use draft|in-progress|done|blocked|superseded|abandoned)\"), specStatus))\n656\t\t\tlifecycle++\n657\t\t}\n658\t\t// `blocked` is an operational condition, not an outcome (spec\n659\t\t// pose-blocked-semantics-alignment). Without a declared prerequisite\n660\t\t// nothing in the spec says what it waits on, so readiness can only report\n661\t\t// `cause: unknown`. A warning, never a failure: legacy records stay valid.\n662\t\tif specStatus == \"blocked\" && strings.TrimSpace(frontmatter[\"depends_on\"]) == \"\" {\n663\t\t\tlint.finding(cliout.StateWarning, \"frontmatter\", cliText(locale,\n664\t\t\t\t\"status: blocked records no cause (depends_on is empty), so readiness reports cause: unknown; declare the prerequisite in depends_on or describe the wait in Known gaps\",\n665\t\t\t\t\"status: blocked não registra causa (depends_on vazio), então a readiness reporta cause: unknown; declare o pré-requisito em depends_on ou descreva a espera em Known gaps\"))\n666\t\t}\n667\t\n668\t\t// Lifecycle dat