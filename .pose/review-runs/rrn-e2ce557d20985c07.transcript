{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H75ZTmwnAovyCVhk34gDPG","type":"tool_result","content":"3044\tfunc completeReviewAttestation(bundle ReviewBundle, att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n3045\t\tif att.Limitations == nil {\n3046\t\t\tatt.Limitations = append([]string(nil), bundle.Payload.Plan.Limitations...)\n3047\t\t}\n3048\t\tif strings.Join(att.Limitations, \"\\x00\") != strings.Join(bundle.Payload.Plan.Limitations, \"\\x00\") {\n3049\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation must retain the sealed review limitations\")\n3050\t\t}\n3051\t\tif att.BundleDigest == \"\" {\n3052\t\t\tatt.BundleDigest = bundle.BundleDigest\n3053\t\t}\n3054\t\tif att.BundleDigest != bundle.BundleDigest {\n3055\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation bundle digest mismatch\")\n3056\t\t}\n3057\t\tif att.Reviewer == \"\" || strings.ContainsAny(att.Reviewer, \"\\r\\n\") || (!strings.HasPrefix(att.Reviewer, \"agent:\") && !strings.HasPrefix(att.Reviewer, \"human:\")) {\n3058\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid reviewer execution identity\")\n3059\t\t}\n3060\t\tif att.Decision != \"approved\" && att.Decision != \"approved-with-reservations\" && att.Decision != \"changes-requested\" && att.Decision != \"rejected\" {\n3061\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid review decision %q\", att.Decision)\n3062\t\t}\n3063\t\tif err := ValidateReviewAttribution(att); err != nil {\n3064\t\t\treturn ReviewAttestation{}, err\n3065\t\t}\n3066\t\tatt.SchemaVersion = ReviewBundleSchemaVersion\n3067\t\tif att.AttestedAt == \"\" {\n3068\t\t\tatt.AttestedAt = now.UTC().Truncate(time.Second).Format(time.RFC3339)\n3069\t\t} else if _, err := time.Parse(time.RFC3339, att.AttestedAt); err != nil {\n3070\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attested_at must be RFC3339\")\n3071\t\t}\n3072\t\tatt.BundleID = bundle.BundleID\n3073\t\tatt.BundleDigest = bundle.BundleDigest\n3074\t\texpectedAttestationID := reviewAttestationID(att)\n3075\t\tif att.AttestationID == \"\" {\n3076\t\t\tatt.AttestationID = expectedAttestationID\n3077\t\t} else if att.AttestationID != expectedAttestationID {\n3078\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation id does not match its content digest\")\n3079\t\t}\n3080\t\tif !strings.HasPrefix(att.AttestationID, \"rva-\") || len(att.AttestationID) != 20 {\n3081\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid attestation id\")\n3082\t\t}\n3083\t\treturn att, nil\n3084\t}\n3085\t\n3086\t// SignableReviewAttestation completes a draft attestation for its sealed bundle\n3087\t// as recording would, including the confirmation digest when the draft names a\n3088\t// confirming principal, and returns it with the canonical bytes a trusted\n3089\t// issuer signs into a ReviewAttestationEnvelope. It records nothing.\n3090\tfunc (s Store) SignableReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, []byte, error) {\n3091\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n3092\t\tif err != nil {\n3093\t\t\treturn ReviewAttestation{}, nil, err\n3094\t\t}\n3095\t\tif att.BundleDigest == \"\" {\n3096\t\t\tatt.BundleDigest = bundle.BundleDigest\n3097\t\t}\n3098\t\tif a := att.Attribution; a != nil && a.ConfirmedBy != \"\" && a.ConfirmationDigest == \"\" {\n3099\t\t\tbound := *a\n3100\t\t\tbound.ConfirmationDigest = ReviewConfirmationDigest(att)\n3101\t\t\tatt.Attribution = &bound\n3102\t\t}\n3103\t\tatt.Path, att.Envelope = \"\", nil\n3104\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\n3105\t\tif err != nil {\n3106\t\t\treturn ReviewAttestation{}, nil, err\n3107\t\t}\n3108\t\tcanonical, err := json.Marshal(completed)\n3109\t\tif err != nil {\n3110\t\t\treturn ReviewAttestation{}, nil, err\n3111\t\t}\n3112\t\treturn completed, canonical, nil\n3113\t}\n3114\t\n3115\t// RecordReviewAttestationEnvelope verifies a trusted issuer's envelope and,\n3116\t// with apply, records the attestation it carries: the path both\n3117\t// `pose review attest --envelope` and the MCP tool take.\n3118\tfunc (s Store) RecordReviewAttestationEnvelope(envelope ReviewAttestationEnvelope, apply bool) (ReviewAttestation, error) {\n3119\t\tif !apply {\n3120\t\t\treturn s.VerifyReviewAttestationEnvelope(envelope)\n3121\t\t}\n3122\t\tvar result ReviewAttestation\n3123\t\terr := s.withReviewAttestationWriteGuard(\"review.attestation.envelope\", envelope.Attestation, func(guarded Store) error {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"be0db6a9-e7e3-4a92-99ec-fa25fef3a551","timestamp":"2026-11-26T06:11:26.029Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-349050671/worktree/pose-mcp/internal/pose/review_bundle.go","content":"func completeReviewAttestation(bundle ReviewBundle, att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n\tif att.Limitations == nil {\n\t\tatt.Limitations = append([]string(nil), bundle.Payload.Plan.Limitations...)\n\t}\n\tif strings.Join(att.Limitations, \"\\x00\") != strings.Join(bundle.Payload.Plan.Limitations, \"\\x00\") {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation must retain the sealed review limitations\")\n\t}\n\tif att.BundleDigest == \"\" {\n\t\tatt.BundleDigest = bundle.BundleDigest\n\t}\n\tif att.BundleDigest != bundle.BundleDigest {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation bundle digest mismatch\")\n\t}\n\tif att.Reviewer == \"\" || strings.ContainsAny(att.Reviewer, \"\\r\\n\") || (!strings.HasPrefix(att.Reviewer, \"agent:\") && !strings.HasPrefix(att.Reviewer, \"human:\")) {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid reviewer execution identity\")\n\t}\n\tif att.Decision != \"approved\" && att.Decision != \"approved-with-reservations\" && att.Decision != \"changes-requested\" && att.Decision != \"rejected\" {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid review decision %q\", att.Decision)\n\t}\n\tif err := ValidateReviewAttribution(att); err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tatt.SchemaVersion = ReviewBundleSchemaVersion\n\tif att.AttestedAt == \"\" {\n\t\tatt.AttestedAt = now.UTC().Truncate(time.Second).Format(time.RFC3339)\n\t} else if _, err := time.Parse(time.RFC3339, att.AttestedAt); err != nil {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attested_at must be RFC3339\")\n\t}\n\tatt.BundleID = bundle.BundleID\n\tatt.BundleDigest = bundle.BundleDigest\n\texpectedAttestationID := reviewAttestationID(att)\n\tif att.AttestationID == \"\" {\n\t\tatt.AttestationID = expectedAttestationID\n\t} else if att.AttestationID != expectedAttestationID {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation id does not match its content digest\")\n\t}\n\tif !strings.HasPrefix(att.AttestationID, \"rva-\") || len(att.AttestationID) != 20 {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid attestation id\")\n\t}\n\treturn att, nil\n}\n\n// SignableReviewAttestation completes a draft attestation for its sealed bundle\n// as recording would, including the confirmation digest when the draft names a\n// confirming principal, and returns it with the canonical bytes a trusted\n// issuer signs into a ReviewAttestationEnvelope. It records nothing.\nfunc (s Store) SignableReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, []byte, error) {\n\tbundle, err := s.LoadReviewBundle(att.BundleID)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\tif att.BundleDigest == \"\" {\n\t\tatt.BundleDigest = bundle.BundleDigest\n\t}\n\tif a := att.Attribution; a != nil && a.ConfirmedBy != \"\" && a.ConfirmationDigest == \"\" {\n\t\tbound := *a\n\t\tbound.ConfirmationDigest = ReviewConfirmationDigest(att)\n\t\tatt.Attribution = &bound\n\t}\n\tatt.Path, att.Envelope = \"\", nil\n\tcompleted, err := completeReviewAttestation(bundle, att, now)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\tcanonical, err := json.Marshal(completed)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\treturn completed, canonical, nil\n}\n\n// RecordReviewAttestationEnvelope verifies a trusted issuer's envelope and,\n// with apply, records the attestation it carries: the path both\n// `pose review attest --envelope` and the MCP tool take.\nfunc (s Store) RecordReviewAttestationEnvelope(envelope ReviewAttestationEnvelope, apply bool) (ReviewAttestation, error) {\n\tif !apply {\n\t\treturn s.VerifyReviewAttestationEnvelope(envelope)\n\t}\n\tvar result ReviewAttestation\n\terr := s.withReviewAttestationWriteGuard(\"review.attestation.envelope\", envelope.Attestation, func(guarded Store) error {","numLines":80,"startLine":3044,"totalLines":4951}},"tool_result_meta":[{"id":"toolu_01H75ZTmwnAovyCVhk34gDPG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
