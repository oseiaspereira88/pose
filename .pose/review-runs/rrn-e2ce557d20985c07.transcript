 R4).\n+\treviewBriefTemplateDraftCheck = \"review-brief/8\"\n+\t// reviewBriefTemplateEngineTools was the current template: /8 plus the\n+\t// instruction to run the planned `pose` commands with the engine that\n+\t// dispatched the run, since the reviewer's shell may resolve an older\n+\t// installed `pose` that ignores flags such as --no-persist (spec\n+\t// pose-assess-leaves-sealed-checkouts-alone R5).\n+\treviewBriefTemplateEngineTools = \"review-brief/9\"\n+\t// reviewBriefTemplateFinishCommands was the current template: /9 plus the\n+\t// boundary that every command the reviewer starts ends before it does\n+\t// (spec pose-review-run-reaps-lingering-reviewer-processes R3).\n+\treviewBriefTemplateFinishCommands = \"review-brief/10\"\n+\t// reviewBriefTemplateAcceptedLimits is the current template: /10 plus the\n+\t// accepted limits the bundle sealed and how a finding inside one is\n+\t// classified (spec pose-review-declared-threat-model R2).\n+\treviewBriefTemplateAcceptedLimits = \"review-brief/11\"\n \t// reviewBriefTemplateConclusions asked for the typed conclusion and stated its rules,\n \t// without the identifiers of the findings of earlier rounds.\n \t// reviewBriefTemplateConclusions (/4) asked for the typed conclusion and stated the rules\n@@ -77,9 +95,30 @@ const (\n \treviewBriefTemplateFirst           = \"review-brief/1\"\n )\n \n+// reviewBriefFromAllNotApplicable reports /7 and the templates that keep its\n+// text and add to it.\n+func reviewBriefFromAllNotApplicable(template string) bool {\n+\treturn template == reviewBriefTemplateAllNotApplicable || reviewBriefFromDraftCheck(template)\n+}\n+\n+// reviewBriefFromDraftCheck reports /8 and the templates that keep its text.\n+func reviewBriefFromDraftCheck(template string) bool {\n+\treturn template == reviewBriefTemplateDraftCheck || reviewBriefFromEngineTools(template)\n+}\n+\n+// reviewBriefFromEngineTools reports /9 and the templates that keep its text.\n+func reviewBriefFromEngineTools(template string) bool {\n+\treturn template == reviewBriefTemplateEngineTools || reviewBriefFromFinishCommands(template)\n+}\n+\n+// reviewBriefFromFinishCommands reports /10 and the templates that keep its text.\n+func reviewBriefFromFinishCommands(template string) bool {\n+\treturn template == reviewBriefTemplateFinishCommands || template == reviewBriefTemplateAcceptedLimits\n+}\n+\n // reviewBriefAsksConclusion reports a template that asks for the typed conclusion.\n func reviewBriefAsksConclusion(template string) bool {\n-\treturn template == reviewBriefTemplateAllNotApplicable || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions || template == reviewBriefTemplateTypedConclusion\n+\treturn reviewBriefFromAllNotApplicable(template) || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions || template == reviewBriefTemplateTypedConclusion\n }\n \n // briefRulesTextV5 is the statement of the rules the conclusion is checked against that\n@@ -91,7 +130,7 @@ const briefRulesTextV5 = \"POSE checks the conclusion before it records it, and r\n // precondition is the completion of the review is answered deferred, the component scoping of\n // evidence, and what a mapping's basis is.\n func briefRulesText(template string, bundle ReviewBundle) string {\n-\tif template != reviewBriefTemplateRiskRules && template != reviewBriefTemplateAllNotApplicable {\n+\tif template != reviewBriefTemplateRiskRules && !reviewBriefFromAllNotApplicable(template) {\n \t\treturn briefRulesTextV5\n \t}\n \ttext := briefRulesTextV5\n@@ -101,23 +140,28 @@ func briefRulesText(template string, bundle ReviewBundle) string {\n \t}\n \ttext = strings.Replace(text, \"a recommended tool you did not run is `not-used` with a `rationale`;\", \"a recommended tool you did not run is `not-used` with a `rationale`; a required tool whose precondition is the completion of the review (`review-check`, `closeout-check`) cannot pass before your attestation: answer it `deferred` with a `rationale`;\", 1)\n \ttext = strings.Replace(text, \"which is recorded as an accepted risk, or the draft requests changes;\", \"which is recorded as an accepted risk only when its severity is one the sealed review policy accepts (\"+severities+\"), or the draft requests changes and any finding of another severity is fixed first;\", 1)\n-\tif template == reviewBriefTemplateAllNotApplicable {\n+\tif reviewBriefFromAllNotApplicable(template) {\n \t\ttext += \" (l) a draft that dispenses with every required criterion as `not-applicable` is refused: a scope whose whole plan is inapplicable is not reviewed by it;\"\n \t}\n+\tif template == reviewBriefTemplateAcceptedLimits {\n+\t\t// The exception to (i) for a finding inside a declared limit, which\n+\t\t// the engine applies (review round 8, N3).\n+\t\ttext += \" (m) the one exception to (i): a follow-up whose `limit` names an accepted limit listed above is recorded within that limit, needs no `action`, `owner` or `review_by` and does not block an approval whatever its severity; its limit must be listed and its `summary` says why it falls inside;\"\n+\t}\n \treturn text + \" (j) the `evidence` of a `passed` criterion is of a class the criterion asks for and, when the criterion or tool belongs to a component, of that component (the Sealed evidence list names the module of each ref); (k) the `basis` of a mapping is a requirement or decision id of the scope's spec, such as R1 or D1.\"\n }\n \n // reviewBriefStatesRules reports a template that states the rules the conclusion is\n // checked against.\n func reviewBriefStatesRules(template string) bool {\n-\treturn template == reviewBriefTemplateAllNotApplicable || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions\n+\treturn reviewBriefFromAllNotApplicable(template) || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions\n }\n \n // reviewBriefEarlierTemplates are the review templates a run may have been\n // briefed with before the current one, newest first; a run briefed with one\n // is re-rendered with it to verify and to continue (the brief a run was sent\n // never changes under it).\n-var reviewBriefEarlierTemplates = []string{reviewBriefTemplateRiskRules, reviewBriefTemplateRoundIDs, reviewBriefTemplateConclusions, reviewBriefTemplateTypedConclusion, reviewBriefTemplateRounds, reviewBriefTemplateFirst}\n+var reviewBriefEarlierTemplates = []string{reviewBriefTemplateFinishCommands, reviewBriefTemplateEngineTools, reviewBriefTemplateDraftCheck, reviewBriefTemplateAllNotApplicable, reviewBriefTemplateRiskRules, reviewBriefTemplateRoundIDs, reviewBriefTemplateConclusions, reviewBriefTemplateTypedConclusion, reviewBriefTemplateRounds, reviewBriefTemplateFirst}\n \n // briefEarlierTemplates are, per kind, the templates a run may have been\n // briefed with before the current one, newest first.\n@@ -144,7 +188,20 @@ func (s Store) RenderReviewBrief(target, kind string, notes string) (ReviewBrief\n // recorded, so a run briefed before the round protocol still verifies and\n // continues.\n func (s Store) RenderReviewBriefMatching(target, kind, notes, digest string) (ReviewBrief, error) {\n-\tbrief, err := s.renderReviewBriefAs(target, kind, notes, \"\")\n+\treturn s.renderReviewBriefMatching(target, kind, notes, digest, true)\n+}\n+\n+// renderRunBriefMatching re-renders the brief a run of bundle target was\n+// sent, whether or not the bundle is still the current subject: a run is\n+// verified against what it reviewed. Whether an approval still approves the\n+// current subject is decided apart (spec\n+// pose-review-conclude-ignores-unrelated-local-edits R1).\n+func (s Store) renderRunBriefMatching(target, kind, notes, digest string) (ReviewBrief, error) {\n+\treturn s.renderReviewBriefMatching(target, kind, notes, digest, false)\n+}\n+\n+func (s Store) renderReviewBriefMatching(target, kind, notes, digest string, requireCurrent bool) (ReviewBrief, error) {\n+\tbrief, err := s.renderReviewBriefAsCurrent(target, kind, notes, \"\", requireCurrent)\n \tif err != nil || brief.Digest == digest {\n \t\treturn brief, err\n \t}\n@@ -152,7 +209,7 @@ func (s Store) RenderReviewBriefMatching(target, kind, notes, digest string) (Re\n \t\tkind = ReviewBriefKindReview\n \t}\n \tfor _, version := range briefEarlierTemplates[kind] {\n-\t\tif earlier, eerr := s.renderReviewBriefAs(target, kind, notes, version); eerr == nil && earlier.Digest == digest {\n+\t\tif earlier, eerr := s.renderReviewBriefAsCurrent(target, kind, notes, version, requireCurrent); eerr == nil && earlier.Digest == digest {\n \t\t\treturn earlier, nil\n \t\t}\n \t}\n@@ -160,6 +217,10 @@ func (s Store) RenderReviewBriefMatching(target, kind, notes, digest string) (Re\n }\n \n func (s Store) renderReviewBriefAs(target, kind, notes, version string) (ReviewBrief, error) {\n+\treturn s.renderReviewBriefAsCurrent(target, kind, notes, version, true)\n+}\n+\n+func (s Store) renderReviewBriefAsCurrent(target, kind, notes, version string, requireCurrent bool) (ReviewBrief, error) {\n \tif kind == \"\" {\n \t\tkind = ReviewBriefKindReview\n \t}\n@@ -176,12 +237,14 @@ func (s Store) renderReviewBriefAs(target, kind, notes, version string) (ReviewB\n \t\tif err != nil {\n \t\t\treturn ReviewBrief{}, err\n \t\t}\n-\t\tcurrent, err := s.CurrentReviewBundle(loaded.Payload.Scope.Ref)\n-\t\tif err != nil {\n-\t\t\treturn ReviewBrief{}, err\n-\t\t}\n-\t\tif current == nil || current.BundleID != loaded.BundleID {\n-\t\t\treturn ReviewBrief{}, fmt.Errorf(\"pose: bundle %s is superseded by current semantic inputs; seal the scope again and brief the new bundle\", target)\n+\t\tif requireCurrent {\n+\t\t\tcurrent, err := s.CurrentReviewBundle(loaded.Payload.Scope.Ref)\n+\t\t\tif err != nil {\n