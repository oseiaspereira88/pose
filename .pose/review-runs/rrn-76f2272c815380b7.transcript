{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012KzwL6yqjwaFQ8XXhz1rbJ","type":"tool_result","content":"25\t\n26\t// Main is the entrypoint used by cmd/pose. It returns the process exit code.\n27\tfunc Main(args []string, stdout, stderr io.Writer) int {\n28\t\treturn mainWithUsage(args, stdout, stderr)\n29\t}\n30\t\n31\tfunc mainCommand(args []string, stdout, stderr io.Writer) int {\n32\t\tlocale := cliLocaleFor(stderr)\n33\t\tcmd := \"help\"\n34\t\tif len(args) > 0 {\n35\t\t\tcmd = args[0]\n36\t\t\targs = args[1:]\n37\t\t}\n38\t\n39\t\tif cmd == \"help\" {\n40\t\t\treturn cmdHelp(stdout, args)\n41\t\t}\n42\t\n43\t\tif hasHelpFlag(args) || cmd == \"-h\" || cmd == \"--help\" {\n44\t\t\tif cmd == \"-h\" || cmd == \"--help\" {\n45\t\t\t\treturn cmdHelp(stdout, nil)\n46\t\t\t}\n47\t\t\tif dispatchCommandHelp(cmd, args, stdout, locale) {\n48\t\t\t\treturn 0\n49\t\t\t}\n50\t\t\treturn cmdHelp(stdout, []string{cmd})\n51\t\t}\n52\t\n53\t\tswitch cmd {\n54\t\tcase \"version\", \"--version\", \"-v\":\n55\t\t\ttarget := \"\"\n56\t\t\tif len(args) > 0 {\n57\t\t\t\ttarget = args[0]\n58\t\t\t}\n59\t\t\treturn cmdVersion(stdout, target)\n60\t\tcase \"init\":\n61\t\t\troot, err := projectRoot()\n62\t\t\tif err != nil {\n63\t\t\t\tfmt.Fprintf(stderr, \"pose init: %v\\n\", err)\n64\t\t\t\treturn 1\n65\t\t\t}\n66\t\t\treturn cmdInitCommand(root, args, stdout, stderr)\n67\t\tcase \"context\":\n68\t\t\troot, err := projectRoot()\n69\t\t\tif err != nil {\n70\t\t\t\trender(io.Discard, stderr).Failure(\"pose context: \" + err.Error())\n71\t\t\t\treturn 1\n72\t\t\t}\n73\t\t\treturn cmdProjectContext(root, args, stdout, stderr)\n74\t\tcase \"new-spec\":\n75\t\t\troot, err := projectRoot()\n76\t\t\tif err != nil {\n77\t\t\t\tfmt.Fprintf(stderr, \"pose new-spec: %v\\n\", err)\n78\t\t\t\treturn 1\n79\t\t\t}\n80\t\t\treturn cmdNewSpec(root, args, stdout, stderr)\n81\t\tcase \"new-spec-qualified\":\n82\t\t\troot, err := projectRoot()\n83\t\t\tif err != nil {\n84\t\t\t\t