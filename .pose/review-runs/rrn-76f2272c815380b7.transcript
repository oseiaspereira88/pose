{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BJ1e3shwJaamTNH6ju1vQt","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"path/filepath\"\n6\t\t\"regexp\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t)\n10\t\n11\t// The command reference in POSE.md is what an agent reads to decide which\n12\t// command to invoke, so a command missing from it is a shipped capability\n13\t// nothing will use. It drifted to 29 of 57 commands undetected until a consumer\n14\t// repository hand-edited its own copy (spec pose-command-reference-parity).\n15\t//\n16\t// `pose help` is the authoritative public surface: this gate asserts the manual\n17\t// documents every command the help advertises. Commands deliberately absent\n18\t// from the help are internal and equally absent from the manual, so the two\n19\t// stay consistent by construction.\n20\t\n21\tvar (\n22\t\tcommandBashBlockRE = regexp.MustCompile(\"(?s)```bash\\n(.*?)\\n```\")\n23\t\tcommandTokenRE     = regexp.MustCompile(`^[a-z][a-z-]{2,}$`)\n24\t\tcommandBracketRE   = regexp.MustCompile(`<[^>]*>|\\[[^\\]]*\\]`)\n25\t\t// A reference line may group alternatives — `pose a <x> | pose b <y>` — so\n26\t\t// every `pose <cmd>` on the line counts, not just the one at its start.\n27\t\tdocumentedTokenRE = regexp.MustCompile(`(?m)(?:^|\\|\\s*)pose ([a-z][a-z-]*)`)\n28\t)\n29\t\n30\t// helpAdvertisedCommands extracts the command names `pose help` lists. Entries\n31\t// appear either one per line with a trailing description or grouped on a single\n32\t// line separated by pipes.\n33\tfunc helpAdvertisedCommands(help string) []string {\n34\t\tseen := map[string]bool{}\n35\t\tfor _, line := range strings.Split(help, \"\\n\") {\n36\t\t\t// A command starts at the margin of its group; a line indented further is the\n37\t\t\t// continuation of the description above it.\n38\t\t\tif !strings.HasPrefix(line, \"  \") || strings.HasPrefix(line, \"      \") || strings.HasPrefix(strings.TrimSpace(line), \"-\") {\n39\t\t\t\tcontinue\n40\t\t\t}\n41\t\t\tentry := strings.TrimSpace(line)\n42\t\t\t// Drop the description: it starts at the first run of two or more\n43\t\t\t// spaces after the command form.\n44\t\t\tif idx := strings.Index(entry, \"  \"); idx > 0 {\n45\t\t\t\tentry = entry[:idx]\n46\t\t\t}\n47\t\t\t// Placeholders can themselves contain pipes (`<plan|prepare|...>`),\n48\t\t\t// so remove them before splitting alternatives.\n49\t\t\tentry = commandBracketRE.ReplaceAllString(entry, \" \")\n50\t\t\tfor _, alternative := range strings.Split(entry, \"|\") {\n51\t\t\t\tfields := strings.Fields(alternative)\n52\t\t\t\tif len(fields) == 0 {\n53\t\t\t\t\tcontinue\n54\t\t\t\t}\n55\t\t\t\tif name := fields[0]; commandTokenRE.MatchString(name) {\n56\t\t\t\t\tseen[name] = true\n57\t\t\t\t}\n58\t\t\t}\n59\t\t}\n60\t\tnames := make([]string, 0, len(seen))\n61\t\tfor name := range seen {\n62\t\t\tnames = append(names, name)\n63\t\t}\n64\t\tsort.Strings(names)\n65\t\treturn names\n66\t}\n67\t\n68\t// documentedCommands returns the command names the manual's bash reference\n69\t// block lists.\n70\tfunc documentedCommands(manual string) map[string]bool {\n71\t\tdocumented := map[string]bool{}\n72\t\tfor _, block := range commandBashBlockRE.FindAllStringSubmatch(manual, -1) {\n73\t\t\tfor _, match := range documentedTokenRE.FindAllStringSubmatch(block[1], -1) {\n74\t\t\t\tdocumented[match[1]] = true\n75\t\t\t}\n76\t\t}\n77\t\treturn documented\n78\t}\n79\t\n80\t// CommandReferenceGaps lists the commands `pose help` advertises that the\n81\t// manual's reference block does not document, sorted for stable reporting.\n82\tfunc CommandReferenceGaps(manual, help string) []string {\n83\t\tdocumented := documentedCommands(manual)\n84\t\tvar missing []string\n85\t\tfor _, name := range helpAdvertisedCommands(help) {\n86\t\t\tif !documented[name] {\n87\t\t\t\tmissing = append(missing, name)\n88\t\t\t}\n89\t\t}\n90\t\treturn missing\n91\t}\n92\t\n93\t// checkCommandReference fails when POSE.md stops documenting a command the CLI\n94\t// advertises. Localized manuals are checked against the same help surface: a\n95\t// translation that lags is as unusable to an agent as a missing entry.\n96\tfunc (checker *nativeChecker) checkCommandReference() {\n97\t\tmanuals := []string{\"POSE.md\"}\n98\t\tif entries, err := checker.fsys().ReadDir(filepath.Join(checker.root, \"locales\")); err == nil {\n99\t\t\tfor _, entry := range entries {\n100\t\t\t\tif entry.IsDir() {\n101\t\t\t\t\tmanuals = append(manuals, filepath.Join(\"locales\", entry.Name(), \"POSE.md\"))\n102\t\t\t\t}\n103\t\t\t}\n104\t\t}\n105\t\tfor _, manual := range manuals {\n106\t\t\traw, err := checker.fsys().ReadFile(filepath.Join(checker.root, manual))\n107\t\t\tif err != nil {\n108\t\t\t\tcontinue\n109\t\t\t}\n110\t\t\t// A manual with no reference block at all is a different contract\n111\t\t\t// (an instance may trim it); only drift within an existing block is\n112\t\t\t// reported.\n113\t\t\tif !commandBashBlockRE.MatchString(string(raw)) {\n114\t\t\t\tcontinue\n115\t\t\t}\n116\t\t\tmissing := CommandReferenceGaps(string(raw), helpTextEN)\n117\t\t\tif len(missing) == 0 {\n118\t\t\t\tcontinue\n119\t\t\t}\n120\t\t\tchecker.failOrWarn(fmt.Sprintf(checker.message(\n121\t\t\t\t\"command reference: %s omits commands the CLI advertises: %s\",\n122\t\t\t\t\"referência de comandos: %s omite comandos que a CLI anuncia: %s\",\n123\t\t\t), filepath.ToSlash(manual), strings.Join(missing, \", \")))\n124\t\t}\n125\t}\n126\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"310aac2f-81fa-4aa2-90b5-a619e87c195f","timestamp":"2026-11-09T07:27:38.576Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2282587684/worktree/pose-mcp/internal/cli/command_reference.go","content":"package cli\n\nimport (\n\t\"fmt\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// The command reference in POSE.md is what an agent reads to decide which\n// command to invoke, so a command missing from it is a shipped capability\n// nothing will use. It drifted to 29 of 57 commands undetected until a consumer\n// repository hand-edited its own copy (spec pose-command-reference-parity).\n//\n// `pose help` is the authoritative public surface: this gate asserts the manual\n// documents every command the help advertises. Commands deliberately absent\n// from the help are internal and equally absent from the manual, so the two\n// stay consistent by construction.\n\nvar (\n\tcommandBashBlockRE = regexp.MustCompile(\"(?s)```bash\\n(.*?)\\n```\")\n\tcommandTokenRE     = regexp.MustCompile(`^[a-z][a-z-]{2,}$`)\n\tcommandBracketRE   = regexp.MustCompile(`<[^>]*>|\\[[^\\]]*\\]`)\n\t// A reference line may group alternatives — `pose a <x> | pose b <y>` — so\n\t// every `pose <cmd>` on the line counts, not just the one at its start.\n\tdocumentedTokenRE = regexp.MustCompile(`(?m)(?:^|\\|\\s*)pose ([a-z][a-z-]*)`)\n)\n\n// helpAdvertisedCommands extracts the command names `pose help` lists. Entries\n// appear either one per line with a trailing description or grouped on a single\n// line separated by pipes.\nfunc helpAdvertisedCommands(help string) []string {\n\tseen := map[string]bool{}\n\tfor _, line := range strings.Split(help, \"\\n\") {\n\t\t// A command starts at the margin of its group; a line indented further is the\n\t\t// continuation of the description above it.\n\t\tif !strings.HasPrefix(line, \"  \") || strings.HasPrefix(line, \"      \") || strings.HasPrefix(strings.TrimSpace(line), \"-\") {\n\t\t\tcontinue\n\t\t}\n\t\tentry := strings.TrimSpace(line)\n\t\t// Drop the description: it starts at the first run of two or more\n\t\t// spaces after the command form.\n\t\tif idx := strings.Index(entry, \"  \"); idx > 0 {\n\t\t\tentry = entry[:idx]\n\t\t}\n\t\t// Placeholders can themselves contain pipes (`<plan|prepare|...>`),\n\t\t// so remove them before splitting alternatives.\n\t\tentry = commandBracketRE.ReplaceAllString(entry, \" \")\n\t\tfor _, alternative := range strings.Split(entry, \"|\") {\n\t\t\tfields := strings.Fields(alternative)\n\t\t\tif len(fields) == 0 {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif name := fields[0]; commandTokenRE.MatchString(name) {\n\t\t\t\tseen[name] = true\n\t\t\t}\n\t\t}\n\t}\n\tnames := make([]string, 0, len(seen))\n\tfor name := range seen {\n\t\tnames = append(names, name)\n\t}\n\tsort.Strings(names)\n\treturn names\n}\n\n// documentedCommands returns the command names the manual's bash reference\n// block lists.\nfunc documentedCommands(manual string) map[string]bool {\n\tdocumented := map[string]bool{}\n\tfor _, block := range commandBashBlockRE.FindAllStringSubmatch(manual, -1) {\n\t\tfor _, match := range documentedTokenRE.FindAllStringSubmatch(block[1], -1) {\n\t\t\tdocumented[match[1]] = true\n\t\t}\n\t}\n\treturn documented\n}\n\n// CommandReferenceGaps lists the commands `pose help` advertises that the\n// manual's reference block does not document, sorted for stable reporting.\nfunc CommandReferenceGaps(manual, help string) []string {\n\tdocumented := documentedCommands(manual)\n\tvar missing []string\n\tfor _, name := range helpAdvertisedCommands(help) {\n\t\tif !documented[name] {\n\t\t\tmissing = append(missing, name)\n\t\t}\n\t}\n\treturn missing\n}\n\n// checkCommandReference fails when POSE.md stops documenting a command the CLI\n// advertises. Localized manuals are checked against the same help surface: a\n// translation that lags is as unusable to an agent as a missing entry.\nfunc (checker *nativeChecker) checkCommandReference() {\n\tmanuals := []string{\"POSE.md\"}\n\tif entries, err := checker.fsys().ReadDir(filepath.Join(checker.root, \"locales\")); err == nil {\n\t\tfor _, entry := range entries {\n\t\t\tif entry.IsDir() {\n\t\t\t\tmanuals = append(manuals, filepath.Join(\"locales\", entry.Name(), \"POSE.md\"))\n\t\t\t}\n\t\t}\n\t}\n\tfor _, manual := range manuals {\n\t\traw, err := checker.fsys().ReadFile(filepath.Join(checker.root, manual))\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\t// A manual with no reference block at all is a different contract\n\t\t// (an instance may trim it); only drift within an existing block is\n\t\t// reported.\n\t\tif !commandBashBlockRE.MatchString(string(raw)) {\n\t\t\tcontinue\n\t\t}\n\t\tmissing := CommandReferenceGaps(string(raw), helpTextEN)\n\t\tif len(missing) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tchecker.failOrWarn(fmt.Sprintf(checker.message(\n\t\t\t\"command reference: %s omits commands the CLI advertises: %s\",\n\t\t\t\"referência de comandos: %s omite comandos que a CLI anuncia: %s\",\n\t\t), filepath.ToSlash(manual), strings.Join(missing, \", \")))\n\t}\n}\n","numLines":126,"startLine":1,"totalLines":126}},"tool_result_meta":[{"id":"toolu_01BJ1e3shwJaamTNH6ju1vQt","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
