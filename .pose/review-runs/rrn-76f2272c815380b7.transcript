-check\n+\n+Governança de documentação:\n+  docs-init | docs-review | docs-sync Semeia, revisa e exporta o contrato de docs de um projeto\n \n Fechamento governado:\n   review-plan <escopo> [--explain]     Resolve critérios e ferramentas por componente\n@@ -563,6 +590,7 @@ Fechamento governado:\n   review attest <bundle-id> [...]      Registra/importa atestação separada\n   review verify <escopo|bundle-id>     Verifica atualidade e prontidão para fechamento\n   review record <escopo> [...]         Entrada de compatibilidade\n+  action <open|list|show|resolve|...>  Abre, lê e resolve pedidos materiais a uma pessoa ou sistema\n   delegate review <escopo> [--agent]   Roda um review delegado; também adjudicate, smoke, ls, resume, cancel, agents\n   close <escopo>                        Aplica transição de ciclo de vida governada\n   continuous-closeout <ação>            Persiste e projeta um escopo terminal\n@@ -571,6 +599,8 @@ Fechamento governado:\n Ciclo de release:\n   release <plan|prepare|check|notes|record|status|open-next|backfill>\n   release-notes --version vX.Y.Z        Alias para notas imutáveis\n+  release-package-manifests --version X.Y.Z --checksums <arquivo> --out <dir>\n+                                        Manifestos de gerenciadores de pacote de uma release\n \n Estado do projeto:\n   state [init|refresh|diff]           Artefato nativo de project-state (sem subcomando = validar)\n@@ -579,6 +609,7 @@ Descoberta e métricas:\n   suggest | stats | insights | usage | recurrence-effect | stacks\n   record-deployment | record-incident | dora-metrics | adoption-metrics\n   semantic-suggest | suggest-feedback | portfolio-projection | reconcile-evidence\n+  assess <discover|integrate|tech-debt|design>  Avaliações locais limitadas de módulos e contratos\n \n Extensões:\n   extension install <dir> [--target <dir>] [--dry-run] [--yes] [--force] [--allow-unsigned]\ndiff --git a/pose-mcp/internal/cli/command_catalog_parity_test.go b/pose-mcp/internal/cli/command_catalog_parity_test.go\nnew file mode 100644\nindex 00000000..78725036\n--- /dev/null\n+++ b/pose-mcp/internal/cli/command_catalog_parity_test.go\n@@ -0,0 +1,143 @@\n+package cli\n+\n+import (\n+\t\"go/ast\"\n+\t\"go/parser\"\n+\t\"go/token\"\n+\t\"os\"\n+\t\"sort\"\n+\t\"strconv\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-help-lists-every-command.\n+\n+// helpAliases are dispatched names that are another command spelled differently:\n+// they are not a command of their own and `pose help` does not list them twice.\n+var helpAliases = map[string]string{\"feedback\": \"report-limitation\"}\n+\n+// mainSwitchCommands returns the command names mainCommand dispatches, read from\n+// the switch itself so the catalog cannot be a second copy that drifts.\n+func mainSwitchCommands(t *testing.T) []string {\n+\tt.Helper()\n+\tfile, err := parser.ParseFile(token.NewFileSet(), \"cli.go\", nil, 0)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tseen := map[string]bool{}\n+\tast.Inspect(file, func(node ast.Node) bool {\n+\t\tfn, ok := node.(*ast.FuncDecl)\n+\t\tif !ok || fn.Name.Name != \"mainCommand\" {\n+\t\t\treturn true\n+\t\t}\n+\t\tfor _, stmt := range fn.Body.List {\n+\t\t\tsw, ok := stmt.(*ast.SwitchStmt)\n+\t\t\tif !ok {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\ttag, ok := sw.Tag.(*ast.Ident)\n+\t\t\tif !ok || tag.Name != \"cmd\" {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tfor _, clause := range sw.Body.List {\n+\t\t\t\tfor _, expr := range clause.(*ast.CaseClause).List {\n+\t\t\t\t\tif lit, ok := expr.(*ast.BasicLit); ok && lit.Kind == token.STRING {\n+\t\t\t\t\t\tname, _ := strconv.Unquote(lit.Value)\n+\t\t\t\t\t\tif !strings.HasPrefix(name, \"-\") {\n+\t\t\t\t\t\t\tseen[name] = true\n+\t\t\t\t\t\t}\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\treturn false\n+\t})\n+\tnames := make([]string, 0, len(seen))\n+\tfor name := range seen {\n+\t\tif _, alias := helpAliases[name]; !alias {\n+\t\t\tnames = append(names, name)\n+\t\t}\n+\t}\n+\tsort.Strings(names)\n+\tif len(names) < 50 {\n+\t\tt.Fatalf(\"read only %d commands from the dispatch switch: the parser lost it\", len(names))\n+\t}\n+\treturn names\n+}\n+\n+func setOf(names []string) map[string]bool {\n+\tset := map[string]bool{}\n+\tfor _, name := range names {\n+\t\tset[name] = true\n+\t}\n+\treturn set\n+}\n+\n+// R1, R2: `pose help`, in each language, lists every command the binary dispatches.\n+func TestPoseHelpListsEveryDispatchedCommand(t *testing.T) {\n+\tfor name, help := range map[string]string{\"en\": helpTextEN, \"pt-BR\": helpTextPtBR} {\n+\t\tadvertised := setOf(helpAdvertisedCommands(help))\n+\t\tvar missing []string\n+\t\tfor _, command := range mainSwitchCommands(t) {\n+\t\t\tif !advertised[command] {\n+\t\t\t\tmissing = append(missing, command)\n+\t\t\t}\n+\t\t}\n+\t\tif len(missing) > 0 {\n+\t\t\tt.Errorf(\"pose help (%s) omits dispatched commands: %s\", name, strings.Join(missing, \", \"))\n+\t\t}\n+\t}\n+}\n+\n+// R3: the two languages advertise the same commands, so a translation that lags is caught.\n+func TestPoseHelpAdvertisesTheSameCommandsInEveryLanguage(t *testing.T) {\n+\ten, pt := setOf(helpAdvertisedCommands(helpTextEN)), setOf(helpAdvertisedCommands(helpTextPtBR))\n+\tfor command := range en {\n+\t\tif !pt[command] {\n+\t\t\tt.Errorf(\"pose help in pt-BR omits %s, which the English help lists\", command)\n+\t\t}\n+\t}\n+\tfor command := range pt {\n+\t\tif !en[command] {\n+\t\t\tt.Errorf(\"pose help in English omits %s, which the pt-BR help lists\", command)\n+\t\t}\n+\t}\n+}\n+\n+// R4: everything the help advertises is dispatched, so the help does not promise what the binary lacks.\n+func TestPoseHelpAdvertisesNothingTheBinaryDoesNotDispatch(t *testing.T) {\n+\tdispatched := setOf(mainSwitchCommands(t))\n+\tfor _, command := range helpAdvertisedCommands(helpTextEN) {\n+\t\tif !dispatched[command] && command != \"help\" {\n+\t\t\tt.Errorf(\"pose help advertises %s, which mainCommand does not dispatch\", command)\n+\t\t}\n+\t}\n+}\n+\n+// R4: every copy of the manual documents every command the help advertises. The runtime gate\n+// of `pose check` does the same for an instance; this holds the copies this repository ships.\n+func TestTheManualsDocumentEveryCommandTheHelpAdvertises(t *testing.T) {\n+\tfor _, path := range []string{\n+\t\t\"../../../POSE.md\", \"../../../locales/pt-BR/POSE.md\",\n+\t\t\"../scaffold/dist/POSE.md\", \"../scaffold/dist/locales/pt-BR/POSE.md\",\n+\t} {\n+\t\traw, err := os.ReadFile(path)\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif missing := CommandReferenceGaps(string(raw), helpTextEN); len(missing) > 0 {\n+\t\t\tt.Errorf(\"%s does not document: %s\", path, strings.Join(missing, \", \"))\n+\t\t}\n+\t}\n+}\n+\n+// R5: a command is read from the margin of its group; the continuation of a description\n+// that begins with a word is not a command.\n+func TestTheHelpReaderIgnoresDescriptionContinuations(t *testing.T) {\n+\thelp := \"Group:\\n  first <x>                           Does a thing and\\n                                      sem continuation words here\\n  second | third                      Others\\n\"\n+\tgot := strings.Join(helpAdvertisedCommands(help), \",\")\n+\tif got != \"first,second,third\" {\n+\t\tt.Fatalf(\"commands read = %s\", got)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/command_reference.go b/pose-mcp/internal/cli/command_reference.go\nindex 499c5233..d84172cf 100644\n--- a/pose-mcp/internal/cli/command_reference.go\n+++ b/pose-mcp/internal/cli/command_reference.go\n@@ -33,7 +33,9 @@ var (\n func helpAdvertisedCommands(help string) []string {\n \tseen := map[string]bool{}\n \tfor _, line := range strings.Split(help, \"\\n\") {\n-\t\tif !strings.HasPrefix(line, \"  \") || strings.HasPrefix(strings.TrimSpace(line), \"-\") {\n+\t\t// A command starts at the margin of its group; a line indented further is the\n+\t\t// continuation of the description above it.\n+\t\tif !strings.HasPrefix(line, \"  \") || strings.HasPrefix(line, \"      \") || strings.HasPrefix(strings.TrimSpace(line), \"-\") {\n \t\t\tcontinue\n \t\t}\n \t\tentry := strings.TrimSpace(line)","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"f6725ea7-6cce-462e-b22b-c4210e655065","timestamp":"2026-11-09T07:27:27.853Z","tool_use_result":{"stdout":"diff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex c18214df..c239ca87 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2596,6 +2596,20 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"help-lists-every-command-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\n+            \"test\",\n+            \"-race\",\n+            \"./internal/cli\",\n+            \"-run\",\n+            \"TestPoseHelp|TestTheManualsDocumentEveryCommand|TestTheHelpReaderIgnores\",\n+            \"-count=1\"\n+          ],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"review-brief-conclusion-rules-integration\",\n           \"program\": \"go\",\n@@ -2635,7 +2649,7 @@\n             \"./internal/cli\",\n             \"./internal/mcpserver\",\n             \"-run\",\n-            \"InProcessRun|CloseoutHandoff|AHandoff|NoHandoff|PendingJudgment|InProcessWrapper|EveryMCPRoute|OnlyAdmitted|ReadOnlyWrappers|KeepTheProcessBoundary|TypedHandoff|StableAndADone|TheMCPPlanIsTheDomainPlan|AdmittedWritesAreExactly|Golden|BlockedOrUnstable|SelectedTarget|TheDigestOfAHandoff|ACancelledCaller|ACompletionThat|AbandonedRuns|NotTakenWhenTheSpawn|APanicInAnInProcess\",\n+            \"InProcessRun|CloseoutHandoff|AHandoff|NoHandoff|PendingJudgment|InProcessWrapper|EveryMCPRoute|OnlyAdmitted|ReadOnlyWrappers|KeepTheProcessBoundary|TypedHandoff|StableAndADone|TheMCPPlanIsTheDomainPlan|AdmittedWritesAreExactly|Golde