\n297\t\t\tcase \"artifact-backfill\":\n298\t\t\t\treturn cmdArtifactBackfill(root, args, stdout, stderr)\n299\t\t\tcase \"surface-check\":\n300\t\t\t\treturn cmdSurfaceCheck(root, args, stdout, stderr)\n301\t\t\tcase \"roadmap-check\":\n302\t\t\t\treturn cmdRoadmapCheck(root, args, stdout, stderr)\n303\t\t\tdefault:\n304\t\t\t\treturn cmdClose(root, args, stdout, stderr)\n305\t\t\t}\n306\t\tcase \"update\", \"index\", \"knowledge-check\", \"knowledge-housekeeping\", \"knowledge-usage\", \"knowledge-suggest\", \"reports-housekeeping\", \"recurrence-check\", \"recurrence-effect\", \"hooks\", \"suggest\", \"stats\", \"insights\", \"usage\", \"stacks\", \"skills-check\", \"record-deployment\", \"record-incident\", \"dora-metrics\", \"adoption-metrics\", \"events-housekeeping\", \"semantic-suggest\", \"suggest-feedback\", \"portfolio-projection\", \"reconcile-evidence\":\n307\t\t\troot, err := projectRoot()\n308\t\t\tif err != nil {\n309\t\t\t\tfmt.Fprintf(stderr, \"pose %s: %v\\n\", cmd, err)\n310\t\t\t\treturn 1\n311\t\t\t}\n312\t\t\tswitch cmd {\n313\t\t\tcase \"update\":\n314\t\t\t\treturn cmdUpdate(root, args, stdout, stderr)\n315\t\t\tcase \"index\":\n316\t\t\t\treturn cmdIndex(root, args, stdout, stderr)\n317\t\t\tcase \"knowledge-check\":\n318\t\t\t\treturn cmdKnowledgeCheck(root, args, stdout, stderr)\n319\t\t\tcase \"knowledge-housekeeping\":\n320\t\t\t\treturn cmdKnowledgeHousekeeping(root, args, stdout, stderr)\n321\t\t\tcase \"knowledge-usage\":\n322\t\t\t\treturn cmdKnowledgeUsage(root, stdout, stderr)\n323\t\t\tcase \"knowledge-suggest\":\n324\t\t\t\treturn cmdKnowledgeSuggest(root, args, stdout, stderr)\n325\t\t\tcase \"reports-housekeeping\":\n326\t\t\t\treturn cmdReportsHousekeeping(root, args, stdout, stderr)\n327\t\t\tcase \"recurrence-check\":\n328\t\t\t\treturn cmdRecurrenceCheck(root, args, stdout, stderr)\n329\t\t\tcase \"recurrence-effect\":\n330\t\t\t\treturn cmdRecurrenceEffect(root, args, stdout, stderr)\n331\t\t\tcase \"skills-check\":\n332\t\t\t\treturn cmdSkillsCheck(root, args, stdout, stderr)\n333\t\t\tcase \"stacks\":\n334\t\t\t\treturn cmdStacks(root, args, stdout, stderr)\n335\t\t\tcase \"hooks\":\n336\t\t\t\treturn cmdHooks(root, args, stdout, stderr)\n337\t\t\tcase \"suggest\":\n338\t\t\t\treturn cmdSuggest(root, args, stdout, stderr)\n339\t\t\tcase \"usage\":\n340\t\t\t\treturn cmdUsage(root, args, stdout, stderr)\n341\t\t\tcase \"record-deployment\":\n342\t\t\t\treturn cmdRecordDeployment(root, args, stdout, stderr)\n343\t\t\tcase \"record-incident\":\n344\t\t\t\treturn cmdRecordIncident(root, args, stdout, stderr)\n345\t\t\tcase \"dora-metrics\":\n346\t\t\t\treturn cmdDORAMetrics(root, args, stdout, stderr)\n347\t\t\tcase \"adoption-metrics\":\n348\t\t\t\treturn cmdAdoptionMetrics(root, args, stdout, stderr)\n349\t\t\tcase \"events-housekeeping\":\n350\t\t\t\treturn cmdEventsHousekeeping(root, args, stdout, stderr)\n351\t\t\tcase \"semantic-suggest\":\n352\t\t\t\treturn cmdSemanticSuggest(root, args, stdout, stderr)\n353\t\t\tcase \"suggest-feedback\":\n354\t\t\t\treturn cmdSuggestFeedback(root, args, stdout, stderr)\n355\t\t\tcase \"portfolio-projection\":\n356\t\t\t\treturn cmdPortfolioProjection(root, args, stdout, stderr)\n357\t\t\tcase \"reconcile-evidence\":\n358\t\t\t\treturn cmdReconcileEvidence(root, args, stdout, stderr)\n359\t\t\tdefault:\n360\t\t\t\treturn cmdStats(root, args, stdout, stderr)\n361\t\t\t}\n362\t\tcase \"release-notes\":\n363\t\t\troot, err := projectRoot()\n364\t\t\tif err != nil {\n365\t\t\t\tfmt.Fprintf(stderr, \"pose release-notes: %v\\n\", err)\n366\t\t\t\treturn 1\n367\t\t\t}\n368\t\t\treturn cmdReleaseNotes(root, args, stdout, stderr)\n369\t\tcase \"release\":\n370\t\t\troot, err := projectRoot()\n371\t\t\tif err != nil {\n372\t\t\t\tfmt.Fprintf(stderr, \"pose release: %v\\n\", err)\n373\t\t\t\treturn 1\n374\t\t\t}\n375\t\t\treturn cmdRelease(root, args, stdout, stderr)\n376\t\tcase \"release-package-manifests\":\n377\t\t\treturn cmdReleasePackageManifests(args, stdout, stderr)\n378\t\tcase \"install\":\n379\t\t\treturn cmdInstall(args, stdout, stderr)\n380\t\tcase \"doctor\":\n381\t\t\treturn cmdDoctor(args, stdout, stderr)\n382\t\tcase \"import\":\n383\t\t\tdefer emitTelemetry(\"import\")\n384\t\t\treturn cmdImport(args, stdout, stderr)\n385\t\tcase \"extension\":\n386\t\t\troot, err := projectRoot()\n387\t\t\tif err != nil {\n388\t\t\t\tfmt.Fprintf(stderr, \"pose extension: %v\\n\", err)\n389\t\t\t\treturn 1\n390\t\t\t}\n391\t\t\treturn cmdExtension(root, args, stdout, stderr)\n392\t\tcase \"contribute\":\n393\t\t\troot, err := projectRoot()\n394\t\t\tif err != nil {\n395\t\t\t\tfmt.Fprintf(stderr, \"pose contribute: %v\\n\", err)\n396\t\t\t\treturn 1\n397\t\t\t}\n398\t\t\treturn cmdContribute(root, args, stdout, stderr)\n399\t\tcase \"lint-spec\":\n400\t\t\tdefer emitTelemetry(\"lint-spec\")\n401\t\t\treturn cmdLintSpec(args, stdout, stderr)\n402\t\tcase \"history-check\":\n403\t\t\tdefer emitTelemetry(\"history-check\")\n404\t\t\treturn cmdHistoryCheck(args, stdout, stderr)\n405\t\tcase \"telemetry\":\n406\t\t\treturn cmdTelemetry(args, stdout, stderr)\n407\t\tcase \"serve-mcp\":\n408\t\t\t// Blocking; wiring lives in internal/bootstrap.\n409\t\t\trunServeMCP(args)\n410\t\t\treturn 0\n411\t\t}\n412\t\n413\t\t// It used to print the whole argv as if it were the command's name, and\n414\t\t// offered nothing when the input was a typo (spec\n415\t\t// pose-cli-output-rendering-system R11).\n416\t\trender(stdout, stderr).UnknownToken(cliText(locale, \"command\", \"comando\"), cmd, knownCommandNames())\n417\t\tfmt.Fprintln(stderr, cliText(locale, \"Run 'pose help' to see available commands.\", \"Execute 'pose help' para ver os comandos disponíveis.\"))\n418\t\treturn 2\n419\t}\n420\t\n421\t// projectRoot resolves the git toplevel, falling back to the current directory.\n422\tfunc projectRoot() (string, error) {\n423\t\treturn projectRootAt(\".\")\n424\t}\n425\t\n426\t// projectRootAt resolves the git top-level starting from dir, falling back\n427\t// to dir's own absolute path when dir isn't inside a git work tree (spec\n428\t// pose-instance-engine-version-tracking R2) — the same fallback shape\n429\t// projectRoot() already had for \".\".\n430\tfunc projectRootAt(dir string) (string, error) {\n431\t\tout, err := posemodel.RawHistoryGit(dir, \"rev-parse\", \"--show-toplevel\").Output()\n432\t\tif err == nil {\n433\t\t\treturn strings.TrimSpace(string(out)), nil\n434\t\t}\n435\t\tabs, err := filepath.Abs(dir)\n436\t\tif err != nil {\n437\t\t\treturn \"\", err\n438\t\t}\n439\t\treturn abs, nil\n440\t}\n441\t\n442\t// cmdVersion prints the binary version and, when an instance is resolvable\n443\t// (target, or the current directory when target is \"\"), its schema and —\n444\t// when recorded — the engine version that last delivered its machinery\n445\t// (spec pose-instance-engine-version-tracking).\n446\tfunc cmdVersion(w io.Writer, target string) int {\n447\t\tfmt.Fprintf(w, \"pose %s\\n\", Version)\n448\t\tdir := \".\"\n449\t\tif target != \"\" {\n450\t\t\tdir = target\n451\t\t}\n452\t\tif root, err := projectRootAt(dir); err == nil {\n453\t\t\tsv := filepath.Join(root, \".pose\", \"schema-version\")\n454\t\t\tif b, err := os.ReadFile(sv); err == nil {\n455\t\t\t\tfmt.Fprintf(w, \"schema: %s\\n\", strings.TrimSpace(string(b)))\n456\t\t\t} else if _, err := os.Stat(filepath.Join(root, \".pose\")); err == nil {\n457\t\t\t\tfmt.Fprintf(w, \"schema: unversioned (run 'pose update')\\n\")\n458\t\t\t}\n459\t\t\tif ev := instanceEngineVersion(root); ev != \"\" {\n460\t\t\t\tfmt.Fprintf(w, \"instance last updated by: pose %s\\n\", ev)\n461\t\t\t}\n462\t\t}\n463\t\treturn 0\n464\t}\n465\t\n466\tconst helpTextEN = `POSE - Project Operating Standard for Engineering\n467\t\n468\tUsage: pose <command> [options]\n469\t\n470\tNative binary:\n471\t  version                             Binary and instance schema versions\n472\t  init                                Ensure the minimum POSE repository structure\n473\t  serve-mcp [--stdio]                 Start the POSE MCP server (POSE_* environment)\n474\t  doctor [--json]                     Diagnose installation and instance health\n475\t  report-limitation --title \"...\"     Report an engine limitation, bug or proposal\n476\t                                      [--kind limitation|bug|suggestion] [--submit]\n477\t  install <dir> [--locale tag] [...]  Install embedded POSE without cloning\n478\t  import <spec-kit|openspec> <path>   Import external specs [--dry-run]\n479\t  telemetry <enable|disable|status>   Anonymous opt-in telemetry\n480\t  setup [--json] [--no-input]         See what is in force, what is new and what is missing\n481\t  context [--project-id <id>] [--task <ref>]  Resolve the selected project and qualified task context\n482\t  identity <add|list|remove> [...]    Register the SSH keys a principal proves its answers with\n483\t  issuer <init|pin|list|...>          Create and pin native issuers that sign review attestations\n484\t  adopt <capability> | --list         Turn a governed capability on or off in this instance\n485\t  migrate v7 --dry-run [--json]       Dry-run the legacy inventory a future major would convert\n486\t\n487\tScaffolds:\n488\t  new-spec <slug>                     Create a feature spec scaffold\n489\t  new-spec-qualified <slug>           Create via a qualified authority and fresh context\n490\t  new-roadmap <slug>                  Create a governed roadmap\n491\t  new-adr \"<title>\"                   Create an ADR\n492\t  new-knowledge <type> <slug>         Create a handoff, note, or decision log\n493\t  spec-transfer <preview|apply|resume|status> Transfer specification authority across projects\n494\t  specs [--recent N] [--status S]     List and discover specifications\n495\t  spec-format <migrate|status>        Inspect and migrate specs to the chronological layout\n496\t  start spec:<slug> [--apply]         Preview or apply the atomic start of a draft spec\n497\t\n498\tDeterministic gates:\n499\t  check | validate | knowledge-check | recurrence-check | lint-spec |\n500\t  followups | amend | history-check | skills-check | review-check | closeout-check |\n501\t  artifact-check | surface-check | roadmap-check | public-claims | docs-check\n502\t\n503\tDocumentation governance:\n504\t  docs-init | docs-review | docs-sync Seed, review and export the docs contract of a project\n505\t\n506\tGoverned closeout:\n507\t  review-plan <scope> [--explain]     Resolve component-aware criteria and tools\n508\t  review bundle <scope> [--seal]      Prepare or seal an immutable review subject\n509\t  review attest <bundle-id> [...]     Record/import a separate attestation\n510\t  review verify <scope|bundle-id>     Verify freshness and closeout readiness\n511\t  review record <scope> [...]         Compatibility entrypoint\n512\t  action <open|list|show|resolve|...> Open, read and resolve material requests to a person or system\n513\t  delegate review <scope> [--agent]   Run a delegated review; also adjudicate, smoke, ls, resume, cancel, agents\n514\t  close <scope>                         Apply a review-gated lifecycle transition\n515\t  continuous-closeout <action>          Persist and project a terminal scope\n516\t  artifact-backfill --from-git          Propose explicit historical provenance\n517\t\n518\tRelease lifecycle:\n519\t  release <plan|prepare|check|notes|record|status|open-next|backfill>\n520\t  release-notes --version vX.Y.Z        Compatibility alias for immutable notes\n521\t  release-package-manifests --version X.Y.Z --checksums <file> --out <dir>\n522\t                                        Package-manager manifests of a release\n523\t\n524\tProject state:\n525\t  state [init|refresh|diff]           Native project-state artifact (bare = validate)\n526\t\n527\tDiscovery and metrics:\n528\t  suggest | stats | insights | usage | recurrence-effect | stacks\n529\t  record-deployment | record-incident | dora-metrics | adoption-metrics\n530\t  semantic-suggest | suggest-feedback | portfolio-projection | reconcile-evidence\n531\t  assess <discover|integrate|tech-debt|design>  Bounded local assessments of modules and contracts\n532\t\n533\tExtensions:\n534\t  extension install <dir> [--target <dir>] [--dry-run] [--yes] [--force] [--allow-unsigned]\n535\t  extension list [--json] | extension remove <id> [...] | extension verify <dir>\n536\t\n537\tContributions:\n538\t  contribute <enable|disable|status|stage|list> [--target <dir>] [--json]\n539\t\n540\tArtifacts and maintenance:\n541\t  index | report | update [--dry-run] | knowledge-housekeeping |\n542\t  knowledge-usage | knowledge-suggest | reports-housekeeping | events-housekeeping | hooks\n543\t\n544\tAll commands execute in the Go binary without Bash or Python fallbacks.\n545\t`\n546\t\n547\tconst helpTextPtBR = `POSE - Project Operating Standard for Engineering\n548\t\n549\tUso: pose <comando> [opções]\n550\t\n551\tNativos (binário):\n552\t  version                             Versão do binário + schema da instância\n553\t  init                                Garante a estrutura mínima do POSE no repo\n554\t  serve-mcp [--stdio]                 Sobe o servidor MCP do POSE (env POSE_*)\n555\t  doctor [--json]                     Diagnóstico da instalação/instância\n556\t  report-limitation --title \"...\"     Relata limitação, bug ou sugestão do engine\n557\t                                      [--kind limitation|bug|suggestion] [--submit]\n558\t  install <dir> [--locale tag] [...]  Instala o POSE embutido num repo (sem clone)\n559\t  import <spec-kit|openspec> <path>   Importa specs externas [--dry-run]\n560\t  telemetry <enable|disable|status>   Telemetria anônima OPT-IN (nada é enviado sem opt-in E POSE_TELEMETRY_URL)\n561\t  setup [--json] [--no-input]         Veja o que está em vigor, o que é novo e o que falta\n562\t  context [--project-id <id>] [--task <ref>]  Resolve o projeto selecionado e o contexto qualificado da tarefa\n563\t  identity <add|list|remove> [...]    Registra as chaves SSH com que um principal prova suas respostas\n564\t  issuer <init|pin|list|...>          Cria e fixa issuers nativos que assinam atestações de review\n565\t  adopt <capacidade> | --list         Liga ou desliga uma capacidade governada nesta instância\n566\t  migrate v7 --dry-run [--json]       Simula o inventário legado que um major futuro converteria\n567\t\n568\tScaffold:\n569\t  new-spec <slug>                     Cria scaffold de spec por feature\n570\t  new-spec-qualified <slug>           Cria pela autoridade qualificada com contexto atual\n571\t  new-roadmap <slug>                  Cria roadmap governado em .pose/roadmaps/\n572\t  new-adr \"<título>\"                  Cria ADR com template padrão\n573\t  new-knowledge <type> <slug>         Cria handoff/note/decision-log\n574\t  spec-transfer <preview|apply|resume|status> Transfere autoridade de spec entre projetos\n575\t  specs [--recent N] [--status S]     Lista e descobre specs\n576\t  spec-format <migrate|status>        Inspeciona e migra specs para o layout cronológico\n577\t  start spec:<slug> [--apply]         Pré-visualiza ou aplica o início atômico de uma spec em rascunho\n578\t\n579\tGates determinísticos:\n580\t  check | validate | knowledge-check | recurrence-check | lint-spec |\n581\t  followups | amend | history-check | skills-check | review-check | closeout-check |\n582\t  artifact-check | surface-check | roadmap-check | public-claims | docs-check\n583\t\n584\tGovernança de documentação:\n585\t  docs-init | docs-review | docs-sync Semeia, revisa e exporta o contrato de docs de um projeto\n586\t\n587\tFechamento governado:\n588\t  review-plan <escopo> [--explain]     Resolve critérios e ferramentas por componente\n589\t  review bundle <escopo> [--seal]      Prepara ou sela o sujeito imutável do review\n590\t  review attest <bundle-id> [...]      Registra/importa atestação separada\n591\t  review verify <escopo|bundle-id>     Verifica atualidade e prontidão para fechamento\n592\t  review record <escopo> [...]         Entrada de compatibilidade\n593\t  action <open|list|show|resolve|...>  Abre, lê e resolve pedidos materiais a uma pessoa ou sistema\n594\t  delegate review <escopo> [--agent]   Roda um review delegado; também adjudicate, smoke, ls, resume, cancel, agents\n595\t  close <escopo>                        Aplica transição de ciclo de vida governada\n596\t  continuous-closeout <ação>            Persiste e projeta um escopo terminal\n597\t  artifact-backfill --from-git          Propõe proveniência histórica explícita\n598\t\n599\tCiclo de release:\n600\t  release <plan|prepare|check|notes|record|status|open-next|backfill>\n601\t  release-notes --version vX.Y.Z        Alias para notas imutáveis\n602\t  release-package-manifests --version X.Y.Z --checksums <arquivo> --out <dir>\n603\t                                        Manifestos de gerenciadores de pacote de uma release\n604\t\n605\tEstado do projeto:\n606\t  state [init|refresh|diff]           Artefato nativo de project-state (sem subcomando = validar)\n607\t\n608\tDescoberta e métricas:\n609\t  suggest | stats | insights | usage | recurrence-effect | stacks\n610\t  record-deployment | record-incident | dora-metrics | adoption-metrics\n611\t  semantic-suggest | suggest-feedback | portfolio-projection | reconcile-evidence\n612\t  assess <discover|integrate|tech-debt|design>  Avaliações locais limitadas de módulos e contratos\n613\t\n614\tExtensões:\n615\t  extension install <dir> [--target <dir>] [--dry-run] [--yes] [--force] [--allow-unsigned]\n616\t  extension list [--json] | extension remove <id> [...] | extension verify <dir>\n617\t\n618\tContribuições:\n619\t  contribute <enable|disable|status|stage|list> [--target <dir>] [--json]\n620\t\n621\tGeração de artefatos:\n622\t  index | report\n623\t\n624\tManutenção:\n625\t  update [--dry-run] | knowledge-housekeeping | knowledge-usage |\n626\t  knowledge-suggest | reports-housekeeping | events-housekeeping | hooks\n627\t\n628\tTodos os comandos executam no binário Go, sem fallbacks Bash ou Python.\n629\t'pose help' completo por comando: consulte o POSE.md da instância.\n630\t`\n631\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"744394fd-1830-4d13-a83d-ce0d689df696","timestamp":"2026-11-09T07:27:42.713Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2282587684/worktree/pose-mcp/internal/cli/cli.go","content":"\n// Main is the entrypoint used by cmd/pose. It returns the process exit code.\nfunc Main(args []string, stdout, stderr io.Writer) int {\n\treturn mainWithUsage(args, stdout, stderr)\n}\n\nfunc mainCommand(args []string, stdout, stderr io.Writer) int {\n\tlocale := cliLocaleFor(stderr)\n\tcmd := \"help\"\n\tif len(args) > 0 {\n\t\tcmd = args[0]\n\t\targs = args[1:]\n\t}\n\n\tif cmd == \"help\" {\n\t\treturn cmdHelp(stdout, args)\n\t}\n\n\tif hasHelpFlag(args) || cmd == \"-h\" || cmd == \"--help\" {\n\t\tif cmd == \"-h\" || cmd == \"--help\" {\n\t\t\treturn cmdHelp(stdout, nil)\n\t\t}\n\t\tif dispatchCommandHelp(cmd, args, stdout, locale) {\n\t\t\treturn 0\n\t\t}\n\t\treturn cmdHelp(stdout, []string{cmd})\n\t}\n\n\tswitch cmd {\n\tcase \"version\", \"--version\", \"-v\":\n\t\ttarget := \"\"\n\t\tif len(args) > 0 {\n\t\t\ttarget = args[0]\n\t\t}\n\t\treturn cmdVersion(stdout, target)\n\tcase \"init\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose init: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdInitCommand(root, args, stdout, stderr)\n\tcase \"context\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose context: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdProjectContext(root, args, stdout, stderr)\n\tcase \"new-spec\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose new-spec: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdNewSpec(root, args, stdout, stderr)\n\tcase \"new-spec-qualified\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose new-spec-qualified: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdNewSpecQualified(root, args, stdout, stderr)\n\tcase \"new-roadmap\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose new-roadmap: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdNewRoadmap(root, args, stdout, stderr)\n\tcase \"new-adr\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose new-adr: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdNewADR(root, args, stdout, stderr)\n\tcase \"new-knowledge\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose new-knowledge: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdNewKnowledge(root, args, stdout, stderr)\n\tcase \"migrate\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose migrate: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdMigrate(root, args, stdout, stderr)\n\tcase \"specs\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose specs: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdSpecs(root, args, stdout, stderr)\n\tcase \"spec-format\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose spec-format: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdSpecFormat(root, args, stdout, stderr)\n\tcase \"spec-transfer\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose spec-transfer: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdSpecTransfer(root, args, stdout, stderr)\n\tcase \"followups\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose followups: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdFollowups(root, args, stdout, stderr)\n\tcase \"amend\":\n\t\treturn cmdAmend(args, stdout, stderr)\n\tcase \"assess\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose assess: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdAssess(root, args, stdout, stderr)\n\tcase \"state\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose state: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdState(root, args, stdout, stderr)\n\tcase \"docs-init\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose docs-init: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdDocsInit(root, args, stdout, stderr)\n\tcase \"docs-check\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose docs-check: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdDocsCheck(root, args, stdout, stderr)\n\tcase \"docs-review\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose docs-review: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdDocsReview(root, args, stdout, stderr)\n\tcase \"public-claims\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose public-claims: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdPublicClaims(root, args, stdout, stderr)\n\tcase \"docs-sync\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose docs-sync: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdDocsSync(root, args, stdout, stderr)\n\tcase \"report-limitation\", \"feedback\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose report-limitation: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdReportLimitation(root, args, stdout, stderr)\n\tcase \"report\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose report: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdReport(root, args, stdout, stderr)\n\tcase \"validate\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose validate: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdValidate(root, args, stdout, stderr)\n\tcase \"check\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose check: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdCheck(root, args, stdout, stderr)\n\tcase \"start\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose start: \" + err.Error())\n\t\t\treturn 2\n\t\t}\n\t\treturn cmdStart(root, args, stdout, stderr)\n\tcase \"setup\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose setup: \" + err.Error())\n\t\t\treturn 2\n\t\t}\n\t\treturn cmdSetup(root, args, stdout, stderr)\n\tcase \"issuer\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose issuer: \" + err.Error())\n\t\t\treturn 2\n\t\t}\n\t\treturn cmdIssuer(root, args, stdout, stderr)\n\tcase \"identity\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose identity: \" + err.Error())\n\t\t\treturn 2\n\t\t}\n\t\treturn cmdIdentity(root, args, stdout, stderr)\n\tcase \"adopt\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose adopt: \" + err.Error())\n\t\t\treturn 2\n\t\t}\n\t\treturn cmdAdopt(root, args, stdout, stderr)\n\tcase \"delegate\":\n\t\troot, err := projectRoot()\n\t\t// The root a caller resolved and authorized wins over the one the\n\t\t// directory would yield (spec pose-delegation-mcp R6).\n\t\tif given := os.Getenv(posemodel.DelegateRootEnv); given != \"\" {\n\t\t\troot, err = delegateGivenRoot(given)\n\t\t}\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose delegate: \" + err.Error())\n\t\t\treturn 2\n\t\t}\n\t\treadDetachedCallerRoot()\n\t\treturn cmdDelegate(root, args, stdout, stderr)\n\tcase \"action\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose action: \" + err.Error())\n\t\t\treturn 2\n\t\t}\n\t\treturn cmdAction(root, args, stdout, stderr)\n\tcase \"review\", \"review-plan\", \"review-check\", \"closeout-check\", \"close\", \"continuous-closeout\", \"artifact-check\", \"artifact-backfill\", \"surface-check\", \"roadmap-check\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose %s: %v\\n\", cmd, err)\n\t\t\treturn 1\n\t\t}\n\t\tswitch cmd {\n\t\tcase \"review\":\n\t\t\treturn cmdReview(root, args, stdout, stderr)\n\t\tcase \"review-plan\":\n\t\t\treturn cmdReviewPlan(root, args, stdout, stderr)\n\t\tcase \"review-check\":\n\t\t\treturn cmdReviewCheck(root, args, stdout, stderr)\n\t\tcase \"closeout-check\":\n\t\t\treturn cmdCloseoutCheck(root, args, stdout, stderr)\n\t\tcase \"continuous-closeout\":\n\t\t\treturn cmdContinuousCloseout(root, args, stdout, stderr)\n\t\tcase \"artifact-check\":\n\t\t\treturn cmdArtifactCheck(root, args, stdout, stderr)\n\t\tcase \"artifact-backfill\":\n\t\t\treturn cmdArtifactBackfill(root, args, stdout, stderr)\n\t\tcase \"surface-check\":\n\t\t\treturn cmdSurfaceCheck(root, args, stdout, stderr)\n\t\tcase \"roadmap-check\":\n\t\t\treturn cmdRoadmapCheck(root, args, stdout, stderr)\n\t\tdefault:\n\t\t\treturn cmdClose(root, args, stdout, stderr)\n\t\t}\n\tcase \"update\", \"index\", \"knowledge-check\", \"knowledge-housekeeping\", \"knowledge-usage\", \"knowledge-suggest\", \"reports-housekeeping\", \"recurrence-check\", \"recurrence-effect\", \"hooks\", \"suggest\", \"stats\", \"insights\", \"usage\", \"stacks\", \"skills-check\", \"record-deployment\", \"record-incident\", \"dora-metrics\", \"adoption-metrics\", \"events-housekeeping\", \"semantic-suggest\", \"suggest-feedback\", \"portfolio-projection\", \"reconcile-evidence\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose %s: %v\\n\", cmd, err)\n\t\t\treturn 1\n\t\t}\n\t\tswitch cmd {\n\t\tcase \"update\":\n\t\t\treturn cmdUpdate(root, args, stdout, stderr)\n\t\tcase \"index\":\n\t\t\treturn cmdIndex(root, args, stdout, stderr)\n\t\tcase \"knowledge-check\":\n\t\t\treturn cmdKnowledgeCheck(root, args, stdout, stderr)\n\t\tcase \"knowledge-housekeeping\":\n\t\t\treturn cmdKnowledgeHousekeeping(root, args, stdout, stderr)\n\t\tcase \"knowledge-usage\":\n\t\t\treturn cmdKnowledgeUsage(root, stdout, stderr)\n\t\tcase \"knowledge-suggest\":\n\t\t\treturn cmdKnowledgeSuggest(root, args, stdout, stderr)\n\t\tcase \"reports-housekeeping\":\n\t\t\treturn cmdReportsHousekeeping(root, args, stdout, stderr)\n\t\tcase \"recurrence-check\":\n\t\t\treturn cmdRecurrenceCheck(root, args, stdout, stderr)\n\t\tcase \"recurrence-effect\":\n\t\t\treturn cmdRecurrenceEffect(root, args, stdout, stderr)\n\t\tcase \"skills-check\":\n\t\t\treturn cmdSkillsCheck(root, args, stdout, stderr)\n\t\tcase \"stacks\":\n\t\t\treturn cmdStacks(root, args, stdout, stderr)\n\t\tcase \"hooks\":\n\t\t\treturn cmdHooks(root, args, stdout, stderr)\n\t\tcase \"suggest\":\n\t\t\treturn cmdSuggest(root, args, stdout, stderr)\n\t\tcase \"usage\":\n\t\t\treturn cmdUsage(root, args, stdout, stderr)\n\t\tcase \"record-deployment\":\n\t\t\treturn cmdRecordDeployment(root, args, stdout, stderr)\n\t\tcase \"record-incident\":\n\t\t\treturn cmdRecordIncident(root, args, stdout, stderr)\n\t\tcase \"dora-metrics\":\n\t\t\treturn cmdDORAMetrics(root, args, stdout, stderr)\n\t\tcase \"adoption-metrics\":\n\t\t\treturn cmdAdoptionMetrics(root, args, stdout, stderr)\n\t\tcase \"events-housekeeping\":\n\t\t\treturn cmdEventsHousekeeping(root, args, stdout, stderr)\n\t\tcase \"semantic-suggest\":\n\t\t\treturn cmdSemanticSuggest(root, args, stdout, stderr)\n\t\tcase \"suggest-feedback\":\n\t\t\treturn cmdSuggestFeedback(root, args, stdout, stderr)\n\t\tcase \"portfolio-projection\":\n\t\t\treturn cmdPortfolioProjection(root, args, stdout, stderr)\n\t\tcase \"reconcile-evidence\":\n\t\t\treturn cmdReconcileEvidence(root, args, stdout, stderr)\n\t\tdefault:\n\t\t\treturn cmdStats(root, args, stdout, stderr)\n\t\t}\n\tcase \"release-notes\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose release-notes: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdReleaseNotes(root, args, stdout, stderr)\n\tcase \"release\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose release: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdRelease(root, args, stdout, stderr)\n\tcase \"release-package-manifests\":\n\t\treturn cmdReleasePackageManifests(args, stdout, stderr)\n\tcase \"install\":\n\t\treturn cmdInstall(args, stdout, stderr)\n\tcase \"doctor\":\n\t\treturn cmdDoctor(args, stdout, stderr)\n\tcase \"import\":\n\t\tdefer emitTelemetry(\"import\")\n\t\treturn cmdImport(args, stdout, stderr)\n\tcase \"extension\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose extension: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdExtension(root, args, stdout, stderr)\n\tcase \"contribute\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose contribute: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdContribute(root, args, stdout, stderr)\n\tcase \"lint-spec\":\n\t\tdefer emitTelemetry(\"lint-spec\")\n\t\treturn cmdLintSpec(args, stdout, stderr)\n\tcase \"history-check\":\n\t\tdefer emitTelemetry(\"history-check\")\n\t\treturn cmdHistoryCheck(args, stdout, stderr)\n\tcase \"telemetry\":\n\t\treturn cmdTelemetry(args, stdout, stderr)\n\tcase \"serve-mcp\":\n\t\t// Blocking; wiring lives in internal/bootstrap.\n\t\trunServeMCP(args)\n\t\treturn 0\n\t}\n\n\t// It used to print the whole argv as if it were the command's name, and\n\t// offered nothing when the input was a typo (spec\n\t// pose-cli-output-rendering-system R11).\n\trender(stdout, stderr).UnknownToken(cliText(locale, \"command\", \"comando\"), cmd, knownCommandNames())\n\tfmt.Fprintln(stderr, cliText(locale, \"Run 'pose help' to see available commands.\", \"Execute 'pose help' para ver os comandos disponíveis.\"))\n\treturn 2\n}\n\n// projectRoot resolves the git toplevel, falling back to the current directory.\nfunc projectRoot() (string, error) {\n\treturn projectRootAt(\".\")\n}\n\n// projectRootAt resolves the git top-level starting from dir, falling back\n// to dir's own absolute path when dir isn't inside a git work tree (spec\n// pose-instance-engine-version-tracking R2) — the same fallback shape\n// projectRoot() already had for \".\".\nfunc projectRootAt(dir string) (string, error) {\n\tout, err := posemodel.RawHistoryGit(dir, \"rev-parse\", \"--show-toplevel\").Output()\n\tif err == nil {\n\t\treturn strings.TrimSpace(string(out)), nil\n\t}\n\tabs, err := filepath.Abs(dir)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn abs, nil\n}\n\n// cmdVersion prints the binary version and, when an instance is resolvable\n// (target, or the current directory when target is \"\"), its schema and —\n// when recorded — the engine version that last delivered its machinery\n// (spec pose-instance-engine-version-tracking).\nfunc cmdVersion(w io.Writer, target string) int {\n\tfmt.Fprintf(w, \"pose %s\\n\", Version)\n\tdir := \".\"\n\tif target != \"\" {\n\t\tdir = target\n\t}\n\tif root, err := projectRootAt(dir); err == nil {\n\t\tsv := filepath.Join(root, \".pose\", \"schema-version\")\n\t\tif b, err := os.ReadFile(sv); err == nil {\n\t\t\tfmt.Fprintf(w, \"schema: %s\\n\", strings.TrimSpace(string(b)))\n\t\t} else if _, err := os.Stat(filepath.Join(root, \".pose\")); err == nil {\n\t\t\tfmt.Fprintf(w, \"schema: unversioned (run 'pose update')\\n\")\n\t\t}\n\t\tif ev := instanceEngineVersion(root); ev != \"\" {\n\t\t\tfmt.Fprintf(w, \"instance last updated by: pose %s\\n\", ev)\n\t\t}\n\t}\n\treturn 0\n}\n\nconst helpTextEN = `POSE - Project Operating Standard for Engineering\n\nUsage: pose <command> [options]\n\nNative binary:\n  version                             Binary and instance schema versions\n  init                                Ensure the minimum POSE repository structure\n  serve-mcp [--stdio]                 Start the POSE MCP server (POSE_* environment)\n  doctor [--json]                     Diagnose installation and instance health\n  report-limitation --title \"...\"     Report an engine limitation, bug or proposal\n                                      [--kind limitation|bug|suggestion] [--submit]\n  install <dir> [--locale tag] [...]  Install embedded POSE without cloning\n  import <spec-kit|openspec> <path>   Import external specs [--dry-run]\n  telemetry <enable|disable|status>   Anonymous opt-in telemetry\n  setup [--json] [--no-input]         See what is in force, what is new and what is missing\n  context [--project-id <id>] [--task <ref>]  Resolve the selected project and qualified task context\n  identity <add|list|remove> [...]    Register the SSH keys a principal proves its answers with\n  issuer <init|pin|list|...>          Create and pin native issuers that sign review attestations\n  adopt <capability> | --list         Turn a governed capability on or off in this instance\n  migrate v7 --dry-run [--json]       Dry-run the legacy inventory a future major would convert\n\nScaffolds:\n  new-spec <slug>                     Create a feature spec scaffold\n  new-spec-qualified <slug>           Create via a qualified authority and fresh context\n  new-roadmap <slug>                  Create a governed roadmap\n  new-adr \"<title>\"                   Create an ADR\n  new-knowledge <type> <slug>         Create a handoff, note, or decision log\n  spec-transfer <preview|apply|resume|status> Transfer specification authority across projects\n  specs [--recent N] [--status S]     List and discover specifications\n  spec-format <migrate|status>        Inspect and migrate specs to the chronological layout\n  start spec:<slug> [--apply]         Preview or apply the atomic start of a draft spec\n\nDeterministic gates:\n  check | validate | knowledge-check | recurrence-check | lint-spec |\n  followups | amend | history-check | skills-check | review-check | closeout-check |\n  artifact-check | surface-check | roadmap-check | public-claims | docs-check\n\nDocumentation governance:\n  docs-init | docs-review | docs-sync Seed, review and export the docs contract of a project\n\nGoverned closeout:\n  review-plan <scope> [--explain]     Resolve component-aware criteria and tools\n  review bundle <scope> [--seal]      Prepare or seal an immutable review subject\n  review attest <bundle-id> [...]     Record/import a separate attestation\n  review verify <scope|bundle-id>     Verify freshness and closeout readiness\n  review record <scope> [...]         Compatibility entrypoint\n  action <open|list|show|resolve|...> Open, read and resolve material requests to a person or system\n  delegate review <scope> [--agent]   Run a delegated review; also adjudicate, smoke, ls, resume, cancel, agents\n  close <scope>                         Apply a review-gated lifecycle transition\n  continuous-closeout <action>          Persist and project a terminal scope\n  artifact-backfill --from-git          Propose explicit historical provenance\n\nRelease lifecycle:\n  release <plan|prepare|check|notes|record|status|open-next|backfill>\n  release-notes --version vX.Y.Z        Compatibility alias for immutable notes\n  release-package-manifests --version X.Y.Z --checksums <file> --out <dir>\n                                        Package-manager manifests of a release\n\nProject state:\n  state [init|refresh|diff]           Native project-state artifact (bare = validate)\n\nDiscovery and metrics:\n  suggest | stats | insights | usage | recurrence-effect | stacks\n  record-deployment | record-incident | dora-metrics | adoption-metrics\n  semantic-suggest | suggest-feedback | portfolio-projection | reconcile-evidence\n  assess <discover|integrate|tech-debt|design>  Bounded local assessments of modules and contracts\n\nExtensions:\n  extension install <dir> [--target <dir>] [--dry-run] [--yes] [--force] [--allow-unsigned]\n  extension list [--json] | extension remove <id> [...] | extension verify <dir>\n\nContributions:\n  contribute <enable|disable|status|stage|list> [--target <dir>] [--json]\n\nArtifacts and maintenance:\n  index | report | update [--dry-run] | knowledge-housekeeping |\n  knowledge-usage | knowledge-suggest | reports-housekeeping | events-housekeeping | hooks\n\nAll commands execute in the Go binary without Bash or Python fallbacks.\n`\n\nconst helpTextPtBR = `POSE - Project Operating Standard for Engineering\n\nUso: pose <comando> [opções]\n\nNativos (binário):\n  version                             Versão do binário + schema da instância\n  init                                Garante a estrutura mínima do POSE no repo\n  serve-mcp [--stdio]                 Sobe o servidor MCP do POSE (env POSE_*)\n  doctor [--json]                     Diagnóstico da instalação/instância\n  report-limitation --title \"...\"     Relata limitação, bug ou sugestão do engine\n                                      [--kind limitation|bug|suggestion] [--submit]\n  install <dir> [--locale tag] [...]  Instala o POSE embutido num repo (sem clone)\n  import <spec-kit|openspec> <path>   Importa specs externas [--dry-run]\n  telemetry <enable|disable|status>   Telemetria anônima OPT-IN (nada é enviado sem opt-in E POSE_TELEMETRY_URL)\n  setup [--json] [--no-input]         Veja o que está em vigor, o que é novo e o que falta\n  context [--project-id <id>] [--task <ref>]  Resolve o projeto selecionado e o contexto qualificado da tarefa\n  identity <add|list|remove> [...]    Registra as chaves SSH com que um principal prova suas respostas\n  issuer <init|pin|list|...>          Cria e fixa issuers nativos que assinam atestações de review\n  adopt <capacidade> | --list         Liga ou desliga uma capacidade governada nesta instância\n  migrate v7 --dry-run [--json]       Simula o inventário legado que um major futuro converteria\n\nScaffold:\n  new-spec <slug>                     Cria scaffold de spec por feature\n  new-spec-qualified <slug>           Cria pela autoridade qualificada com contexto atual\n  new-roadmap <slug>                  Cria roadmap governado em .pose/roadmaps/\n  new-adr \"<título>\"                  Cria ADR com template padrão\n  new-knowledge <type> <slug>         Cria handoff/note/decision-log\n  spec-transfer <preview|apply|resume|status> Transfere autoridade de spec entre projetos\n  specs [--recent N] [--status S]     Lista e descobre specs\n  spec-format <migrate|status>        Inspeciona e migra specs para o layout cronológico\n  start spec:<slug> [--apply]         Pré-visualiza ou aplica o início atômico de uma spec em rascunho\n\nGates determinísticos:\n  check | validate | knowledge-check | recurrence-check | lint-spec |\n  followups | amend | history-check | skills-check | review-check | closeout-check |\n  artifact-check | surface-check | roadmap-check | public-claims | docs-check\n\nGovernança de documentação:\n  docs-init | docs-review | docs-sync Semeia, revisa e exporta o contrato de docs de um projeto\n\nFechamento governado:\n  review-plan <escopo> [--explain]     Resolve critérios e ferramentas por componente\n  review bundle <escopo> [--seal]      Prepara ou sela o sujeito imutável do review\n  review attest <bundle-id> [...]      Registra/importa atestação separada\n  review verify <escopo|bundle-id>     Verifica atualidade e prontidão para fechamento\n  review record <escopo> [...]         Entrada de compatibilidade\n  action <open|list|show|resolve|...>  Abre, lê e resolve pedidos materiais a uma pessoa ou sistema\n  delegate review <escopo> [--agent]   Roda um review delegado; também adjudicate, smoke, ls, resume, cancel, agents\n  close <escopo>                        Aplica transição de ciclo de vida governada\n  continuous-closeout <ação>            Persiste e projeta um escopo terminal\n  artifact-backfill --from-git          Propõe proveniência histórica explícita\n\nCiclo de release:\n  release <plan|prepare|check|notes|record|status|open-next|backfill>\n  release-notes --version vX.Y.Z        Alias para notas imutáveis\n  release-package-manifests --version X.Y.Z --checksums <arquivo> --out <dir>\n                                        Manifestos de gerenciadores de pacote de uma release\n\nEstado do projeto:\n  state [init|refresh|diff]           Artefato nativo de project-state (sem subcomando = validar)\n\nDescoberta e métricas:\n  suggest | stats | insights | usage | recurrence-effect | stacks\n  record-deployment | record-incident | dora-metrics | adoption-metrics\n  semantic-suggest | suggest-feedback | portfolio-projection | reconcile-evidence\n  assess <discover|integrate|tech-debt|design>  Avaliações locais limitadas de módulos e contratos\n\nExtensões:\n  extension install <dir> [--target <dir>] [--dry-run] [--yes] [--force] [--allow-unsigned]\n  extension list [--json] | extension remove <id> [...] | extension verify <dir>\n\nContribuições:\n  contribute <enable|disable|status|stage|list> [--target <dir>] [--json]\n\nGeração de artefatos:\n  index | report\n\nManutenção:\n  update [--dry-run] | knowledge-housekeeping | knowledge-usage |\n  knowledge-suggest | reports-housekeeping | events-housekeeping | hooks\n\nTodos os comandos executam no binário Go, sem fallbacks Bash ou Python.\n'pose help' completo por comando: consulte o POSE.md da instância.\n`\n","numLines":607,"startLine":25,"totalLines":631}},"tool_result_meta":[{"id":"toolu_012KzwL6yqjwaFQ8XXhz1rbJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
