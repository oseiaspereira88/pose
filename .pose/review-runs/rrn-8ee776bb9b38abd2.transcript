<n>] [--no-follow] [--refresh <d>] [--json]\")\n48\t\t}\n49\t\tif f.lines == 0 {\n50\t\t\tf.lines = delegateWatchLines\n51\t\t}\n52\t\tif f.refresh == 0 && !containsFlag(args, \"--refresh\") {\n53\t\t\tf.refresh = 2 * time.Second\n54\t\t}\n55\t\tstore := posemodel.Store{Root: root}\n56\t\tattempts, lost, err := store.ListDelegationAttempts()\n57\t\tif err != nil {\n58\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"watch\", 1, err)\n59\t\t}\n60\t\tvar attempt posemodel.DelegationAttempt\n61\t\tif len(f.positional) == 1 || f.label != \"\" {\n62\t\t\ta, code, err := namedAttempt(attempts, f)\n63\t\t\tif err != nil {\n64\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"watch\", code, err)\n65\t\t\t}\n66\t\t\tattempt = a\n67\t\t} else {\n68\t\t\ta, code, err := chooseWatchedAttempt(root, attempts, f, stderr)\n69\t\t\tif err != nil {\n70\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"watch\", code, err)\n71\t\t\t}\n72\t\t\tattempt = a\n73\t\t}\n74\t\tw := &watchPrinter{out: stdout, profile: render(stdout, stderr).OutProfile(), f: f, losses: map[string]bool{}}\n75\t\tw.lose(lost)\n76\t\tcode := w.follow(store, attempt)\n77\t\t// What could not be read is said, and the watch does not end as if the\n78\t\t// history it showed were whole.\n79\t\tif len(w.losses) > 0 {\n80\t\t\tout := render(stdout, stderr)\n81\t\t\tfor loss := range w.losses {\n82\t\t\t\tout.Failure(tr(\"delegated run history incomplete: \", \"histórico de runs delegados incompleto: \") + loss)\n83\t\t\t}\n84\t\t\treturn 1\n85\t\t}\n86\t\treturn code\n87\t}\n88\t\n89\tfunc (w *watchPrinter) lose(lost []string) {\n90\t\tfor _, loss := range lost {\n91\t\t\tw.losses[loss] = true\n92\t\t}\n93\t}\n94\t\n95\tfunc containsFlag(args []string, name string) bool {\n96\t\tfor _, arg := range args {\n97\t\t\tif arg == name || strings.HasPrefix(arg, name+\"=\") {\n98\t\t\t\treturn true\n99\t\t\t}\n100\t\t}\n101\t\treturn false\n102\t}\n103\t\n104\t// chooseWatchedAttempt follows the only active run