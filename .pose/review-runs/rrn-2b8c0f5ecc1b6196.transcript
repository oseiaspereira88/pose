ing-reviewer-processes R5,\n  1131\t\t\t// review round 4, N1).\n  1132\t\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n  1133\t\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n  1134\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1135\t\t\t}\n  1136\t\t\tif err != nil {\n  1137\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1138\t\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1139\t\t\t}\n  1140\t\t\tif f.jsonOut {\n  1141\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n  1142\t\t\t\treturn 0\n  1143\t\t\t}\n  1144\t\t\tout := render(stdout, stderr)\n  1145\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1146\t\t\tif run.RunID == \"\" {\n  1147\t\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n  1148\t\t\t} else {\n  1149\t\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n  1150\t\t\t}\n  1151\t\t\treturn 0\n  1152\t\t}\n  1153\t\tif !attempt.Active {\n  1154\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1155\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1156\t\t}\n  1157\t\tif f.dryRun {\n  