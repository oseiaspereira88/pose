{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_run_provenance_test.go | sed -n '1,115p' && nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '676,766p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"context\"\n     6\t\t\"encoding/json\"\n     7\t\t\"os\"\n     8\t\t\"os/exec\"\n     9\t\t\"path/filepath\"\n    10\t\t\"strings\"\n    11\t\t\"testing\"\n    12\t\t\"time\"\n    13\t)\n    14\t\n    15\ttype runProvenanceFixture struct {\n    16\t\tstore  Store\n    17\t\tkey    IssuerKey\n    18\t\trun    ReviewRun\n    19\t\tproof  ReviewRunProof\n    20\t\tbundle ReviewBundle\n    21\t}\n    22\t\n    23\tfunc provenanceRunFixture(t *testing.T, vendor, model string, changes ...func(*ReviewerAdapter)) runProvenanceFixture {\n    24\t\tt.Helper()\n    25\t\treturn provenanceRunFixtureAs(t, nil, vendor, model, changes...)\n    26\t}\n    27\t\n    28\t// provenanceRunFixtureAs seals with identity; nil seals the way bundles were\n    29\t// sealed before they recorded one.\n    30\tfunc provenanceRunFixtureAs(t *testing.T, identity *ReviewBundleImplementation, vendor, model string, changes ...func(*ReviewerAdapter)) runProvenanceFixture {\n    31\t\tt.Helper()\n    32\t\tuseIssuerHome(t)\n    33\t\tkey, e := CreateIssuerKey(\"\", \"executor-fixture\", time.Now())\n    34\t\tif e != nil {\n    35\t\t\tt.Fatal(e)\n    36\t\t}\n    37\t\troot, s := reviewBundleFixture(t)\n    38\t\twriteReviewFixture(t, root, \".pose/project.json\", `{\"schema_version\":1,\"project_id\":\"fixture-project\",\"name\":\"fixture\"}`)\n    39\t\traw, e := os.ReadFile(filepath.Join(root, \".pose/policy/review.json\"))\n    40\t\tif e != nil {\n    41\t\t\tt.Fatal(e)\n    42\t\t}\n    43\t\tvar policy map[string]any\n    44\t\tif e = json.Unmarshal(raw, &policy); e != nil {\n    45\t\t\tt.Fatal(e)\n    46\t\t}\n    47\t\tpolicy[\"reviewer_independence\"] = map[string]string{\"spec\": \"different-actor\"}\n    48\t\tpolicy[\"identity_assurance\"] = map[string]string{\"spec\": \"verified\"}\n    49\t\tpolicy[\"delegated_review\"] = true\n    50\t\tpolicy[\"authority_project\"] = \"fixture-project\"\n    51\t\tpolicy[\"authority_audience\"] = \"fixture-audience\"\n    52\t\tpolicy[\"trusted_attestation_issuers\"] = []string{key.Pin()}\n    53\t\traw, _ = json.Marshal(policy)\n    54\t\twriteReviewFixture(t, root, \".pose/policy/review.json\", string(raw))\n    55\t\t// The reviewer returns the typed conclusion its brief asks for, written\n    56\t\t// once the bundle is sealed: a run's attestation states that conclusion\n    57\t\t// (spec pose-delegated-review-conclusions D1).\n    58\t\tdraftPath := filepath.Join(t.TempDir(), \"draft.txt\")\n    59\t\treviewers := ReviewersPolicy{SchemaVersion: 1, Provenance: &ReviewRunProvenancePolicy{Trust: \"executor-attested\", Implementation: ModelIdentity{Principal: \"agent:implementer\", Execution: \"implementation-fixture\", Vendor: \"openai\", Model: \"implementation-model\"}}, Adapters: map[string]ReviewerAdapter{\"fake\": {Executor: \"agent:reviewer\", Command: []string{\"sh\", \"-c\", \"cat >/dev/null; cat '\" + draftPath + \"'\"}, Vendor: vendor, Model: model}}}\n    60\t\tadapter := reviewers.Adapters[\"fake\"]\n    61\t\tfor _, change := range changes {\n    62\t\t\tchange(&adapter)\n    63\t\t}\n    64\t\treviewers.Adapters[\"fake\"] = adapter\n    65\t\traw, _ = json.Marshal(reviewers)\n    66\t\twriteReviewFixture(t, root, \".pose/policy/reviewers.json\", string(raw))\n    67\t\twriteReviewFixture(t, root, \".gitignore\", \".pose/indexes/delivery-integrity.json\\n\")\n    68\t\tgit := func(args ...string) string {\n    69\t\t\tt.Helper()\n    70\t\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", root, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\"}, args...)...)\n    71\t\t\tout, e := cmd.CombinedOutput()\n    72\t\t\tif e != nil {\n    73\t\t\t\tt.Fatalf(\"git %v: %v %s\", args, e, out)\n    74\t\t\t}\n    75\t\t\treturn strings.TrimSpace(string(out))\n    76\t\t}\n    77\t\tgit(\"init\", \"-q\")\n    78\t\tgit(\"add\", \"-A\")\n    79\t\tgit(\"commit\", \"-q\", \"-m\", \"fixture\")\n    80\t\thead := git(\"rev-parse\", \"HEAD\")\n    81\t\tgraphPath := filepath.Join(root, \".pose/indexes/delivery-integrity.json\")\n    82\t\traw, e = os.ReadFile(graphPath)\n    83\t\tif e != nil {\n    84\t\t\tt.Fatal(e)\n    85\t\t}\n    86\t\tvar graph DeliveryIntegrityGraph\n    87\t\tjson.Unmarshal(raw, &graph)\n    88\t\tfor i := range graph.ChangeSets {\n    89\t\t\tgraph.ChangeSets[i].Base = head\n    90\t\t\tgraph.ChangeSets[i].Head = head\n    91\t\t\tgraph.ChangeSets[i].ResolvedBase = head\n    92\t\t\tgraph.ChangeSets[i].ResolvedHead = head\n    93\t\t\tgraph.ChangeSets[i].Selector = \"range:\" + head + \"..\" + head\n    94\t\t}\n    95\t\tfor i := range graph.ValidationResults {\n    96\t\t\tgraph.ValidationResults[i].GitHead = head\n    97\t\t}\n    98\t\traw, _ = json.Marshal(graph)\n    99\t\tif e = os.WriteFile(graphPath, raw, 0644); e != nil {\n   100\t\t\tt.Fatal(e)\n   101\t\t}\n   102\t\t// Without an identity, the bundle is sealed the way bundles were before\n   103\t\t// they recorded their implementation, and the run is compared with the\n   104\t\t// policy's declaration (spec pose-delegation-routing R4).\n   105\t\tbundle, e := s.sealReviewBundle(\"spec:backend\", identity, identity != nil, \"\", time.Now())\n   106\t\tif e != nil {\n   107\t\t\tt.Fatal(e)\n   108\t\t}\n   109\t\tif e = os.WriteFile(draftPath, []byte(draftFrom(t, approvedBundleAttestation(bundle, \"agent:reviewer\"), nil)), 0o600); e != nil {\n   110\t\t\tt.Fatal(e)\n   111\t\t}\n   112\t\tplan, e := s.PlanReviewDispatch(bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\")\n   113\t\tif e != nil {\n   114\t\t\tt.Fatal(e)\n   115\t\t}\n   676\t\t\t}\n   677\t\t\tif cleanupErr != nil {\n   678\t\t\t\toutcome.StepsRun[0].Result = \"failed\"\n   679\t\t\t\toutcome.Fail(OutcomeFailed, \"cleanup\", \"cleanup-incomplete\", cleanupErr.Error())\n   680\t\t\t\toutcome.Unconfirmed = []OperationUncertain{{Step: \"cleanup\", Reason: \"owned resources may remain; no automatic respawn\"}}\n   681\t\t\t} else {\n   682\t\t\t\toutcome.Outcome = OutcomeCompleted\n   683\t\t\t}\n   684\t\t\trun.Safety.Operation = outcome\n   685\t\t}\n   686\t\tdefer func() {\n   687\t\t\tdoCleanup()\n   688\t\t\tif cleanupErr != nil {\n   689\t\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n   690\t\t\t}\n   691\t\t}()\n   692\t\ttranscript := []byte{}\n   693\t\tfinish := func(status, failure string) (ReviewRun, error) {\n   694\t\t\tdoCleanup()\n   695\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n   696\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n   697\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n   698\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n   699\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n   700\t\t\t}\n   701\t\t\trun.sessionForRedaction = \"\"\n   702\t\t\trun.Status, run.Failure = status, failure\n   703\t\t\tif status != ReviewRunInterrupted {\n   704\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n   705\t\t\t}\n   706\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n   707\t\t\treturn s.recordReviewRun(run, transcript)\n   708\t\t}\n   709\t\t// Recompute semantic freshness at execution time, not just preview time.\n   710\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n   711\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   712\t\t}\n   713\t\tvar attempt DelegatedReviewAttempt\n   714\t\tif plan.predecessor == nil {\n   715\t\t\tvar err error\n   716\t\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n   717\t\t\tif err != nil {\n   718\t\t\t\treturn ReviewRun{}, err\n   719\t\t\t}\n   720\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n   721\t\t} else {\n   722\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n   723\t\t\tfresh, err := s.replanContinuation(plan)\n   724\t\t\tif err != nil {\n   725\t\t\t\treturn ReviewRun{}, err\n   726\t\t\t}\n   727\t\t\tif fresh.PendingContinuation != nil {\n   728\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n   729\t\t\t}\n   730\t\t\tif fresh.Existing != nil {\n   731\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   732\t\t\t}\n   733\t\t\tplan = fresh\n   734\t\t\trun.Provenance = fresh.provenance\n   735\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n   736\t\t\tif fresh.handoff {\n   737\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n   738\t\t\t} else {\n   739\t\t\t\trun.Resumes = fresh.predecessor.RunID\n   740\t\t\t}\n   741\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n   742\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n   743\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n   744\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n   745\t\t\t\treturn ReviewRun{}, err\n   746\t\t\t}\n   747\t\t}\n   748\t\t// The attempt result is published once: before the active marker goes\n   749\t\t// when the run was marked, at return otherwise (spec\n   750\t\t// pose-delegation-result-before-marker R1–R2).\n   751\t\tresultPublished := false\n   752\t\treserved := plan.predecessor != nil\n   753\t\tpublishResult := func() {\n   754\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n   755\t\t\t\treturn\n   756\t\t\t}\n   757\t\t\tresultPublished = true\n   758\t\t\tbeforeRunResultPublished(result)\n   759\t\t\tvar err error\n   760\t\t\tif plan.predecessor == nil {\n   761\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   762\t\t\t} else {\n   763\t\t\t\terr = s.finishReviewContinuation(result)\n   764\t\t\t}\n   765\t\t\tif err != nil {\n   766\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n","exit_code":0,"status":"completed"}}
