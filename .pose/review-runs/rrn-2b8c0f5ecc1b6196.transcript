{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '410,465p' && nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '270,320p' && nl -ba pose-mcp/internal/cli/delegate.go | sed -n '1140,1152p'\"","aggregated_output":"   410\t\t}\n   411\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n   412\t\t\tt.Fatal(\"a reservation was released over an incomplete run history\")\n   413\t\t}\n   414\t}\n   415\t\n   416\t// Review round 5, N3: a dispatch that recorded its run and stopped before\n   417\t// the receipt is completed with that run, not with a second one; N2: a\n   418\t// release that stopped after the receipt only removes the marker.\n   419\tfunc TestARecordedRunCompletesItsAttempt(t *testing.T) {\n   420\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   421\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"receipt lost\")\n   422\t\tif err != nil {\n   423\t\t\tt.Fatal(err)\n   424\t\t}\n   425\t\tsaved := beforeRunResultPublished\n   426\t\tt.Cleanup(func() { beforeRunResultPublished = saved })\n   427\t\trecorded := \"\"\n   428\t\tbeforeRunResultPublished = func(r ReviewRun) { recorded = r.RunID; panic(\"the dispatching process ends before the receipt\") }\n   429\t\tfunc() {\n   430\t\t\tdefer func() { _ = recover() }()\n   431\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   432\t\t}()\n   433\t\tbeforeRunResultPublished = saved\n   434\t\truns, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID)\n   435\t\tif recorded == \"\" || len(runs) == 0 {\n   436\t\t\tt.Fatalf(\"the dispatch recorded no run: %q %d\", recorded, len(runs))\n   437\t\t}\n   438\t\tattempt := runs[len(runs)-1].AttemptID\n   439\t\twriteDeadMarker(t, f.store, attempt)\n   440\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   441\t\tmarkerBytes, _ := os.ReadFile(filepath.Join(activeDir, attempt+\".json\"))\n   442\t\treleased, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   443\t\tif err != nil || released.RunID != recorded {\n   444\t\t\tt.Fatalf(\"the release did not complete with the recorded run %s: %s %v\", recorded, released.RunID, err)\n   445\t\t}\n   446\t\tif after, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID); len(after) != len(runs) {\n   447\t\t\tt.Fatalf(\"the release recorded another run: %d then %d\", len(runs), len(after))\n   448\t\t}\n   449\t\t// The marker comes back, as a release stopped after the receipt leaves it.\n   450\t\tif err := os.WriteFile(filepath.Join(activeDir, attempt+\".json\"), markerBytes, 0o600); err != nil {\n   451\t\t\tt.Fatal(err)\n   452\t\t}\n   453\t\tagain, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   454\t\tif err != nil || again.RunID != recorded {\n   455\t\t\tt.Fatalf(\"a release after the receipt did not complete: %s %v\", again.RunID, err)\n   456\t\t}\n   457\t\tif left, _ := filepath.Glob(filepath.Join(activeDir, attempt+\".json\")); len(left) != 0 {\n   458\t\t\tt.Fatal(\"the stalled marker stayed after the receipt\")\n   459\t\t}\n   460\t}\n   461\t\n   462\t// Review round 6, N1: an unreadable active marker may be a live attempt's,\n   463\t// so no reservation is taken as markerless.\n   464\tfunc TestAnUnreadableMarkerRulesNothingOut(t *testing.T) {\n   465\t\troot := t.TempDir()\n   270\t// before the receipt, completes with that run instead of recording another.\n   271\tfunc TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n   272\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   273\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   274\t\tif err != nil {\n   275\t\t\tt.Fatal(err)\n   276\t\t}\n   277\t\tattempt := \"\"\n   278\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   279\t\tfunc() {\n   280\t\t\tdefer func() { _ = recover() }()\n   281\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   282\t\t}()\n   283\t\twriteDeadMarker(t, f.store, attempt)\n   284\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   285\t\tmarkerPath := filepath.Join(activeDir, attempt+\".json\")\n   286\t\tmarkerBytes, err := os.ReadFile(markerPath)\n   287\t\tif err != nil {\n   288\t\t\tt.Fatal(err)\n   289\t\t}\n   290\t\tfirst, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   291\t\tif err != nil {\n   292\t\t\tt.Fatal(err)\n   293\t\t}\n   294\t\t// Undo the receipt and keep the marker, as a release stopped between\n   295\t\t// the run and the receipt leaves them.\n   296\t\tattempts, _ := f.store.readDelegatedReviewAttempts(f.bundle.BundleID)\n   297\t\tfor _, a := range attempts {\n   298\t\t\tif a.AttemptID == attempt {\n   299\t\t\t\tif err := os.Remove(attemptReceiptPath(f.store.Root, a)); err != nil {\n   300\t\t\t\t\tt.Fatal(err)\n   301\t\t\t\t}\n   302\t\t\t}\n   303\t\t}\n   304\t\tif err := os.WriteFile(markerPath, markerBytes, 0o600); err != nil {\n   305\t\t\tt.Fatal(err)\n   306\t\t}\n   307\t\tsecond, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   308\t\tif err != nil || second.RunID != first.RunID {\n   309\t\t\tt.Fatalf(\"the interrupted release recorded another run: %s then %s (%v)\", first.RunID, second.RunID, err)\n   310\t\t}\n   311\t}\n   312\t\n   313\t// Review round 2, N1: a reservation an earlier engine left with no marker is\n   314\t// listed and released once it is old enough, never while it is young.\n   315\tfunc TestAMarkerlessReservationOfAnEarlierEngineIsReleased(t *testing.T) {\n   316\t\troot := t.TempDir()\n   317\t\ts := Store{Root: root}\n   318\t\treserve := func(age time.Duration, nonce string) DelegatedReviewAttempt {\n   319\t\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000b\" + nonce[:1], BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   320\t\t\t\tReservedAt: time.Now().Add(-age).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(nonce[:1], 32)}\n  1140\t\t\tif f.jsonOut {\n  1141\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n  1142\t\t\t\treturn 0\n  1143\t\t\t}\n  1144\t\t\tout := render(stdout, stderr)\n  1145\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1146\t\t\tif run.RunID == \"\" {\n  1147\t\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n  1148\t\t\t} else {\n  1149\t\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n  1150\t\t\t}\n  1151\t\t\treturn 0\n  1152\t\t}\n","exit_code":0,"status":"completed"}}
