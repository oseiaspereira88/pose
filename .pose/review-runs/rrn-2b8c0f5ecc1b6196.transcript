{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '940,1170p'\"","aggregated_output":"   940\t\t\trun.Provenance = &copy\n   941\t\t\tselected, resolved, err := provenanceExecutableSelection(argv[0], worktree)\n   942\t\t\tif err != nil {\n   943\t\t\t\treturn finish(ReviewRunFailed, \"provenance executable could not be resolved\")\n   944\t\t\t}\n   945\t\t\tdigest, err := reviewExecutableDigest(resolved)\n   946\t\t\tif err != nil {\n   947\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n   948\t\t\t}\n   949\t\t\trun.Provenance.ExecutableDigest = digest\n   950\t\t\texecPath = selected\n   951\t\t\traw, _ := json.Marshal(argv)\n   952\t\t\trun.Provenance.ArgvDigest = digestBytes(raw)\n   953\t\t}\n   954\t\tif plan.processTimeout > 0 {\n   955\t\t\tstarted, err := time.Parse(time.RFC3339Nano, run.StartedAt)\n   956\t\t\tif err != nil {\n   957\t\t\t\treturn finish(ReviewRunFailed, \"invalid execution start\")\n   958\t\t\t}\n   959\t\t\tsetup := now().Sub(started)\n   960\t\t\tremaining := plan.processTimeout - setup\n   961\t\t\tif setup < 0 || remaining <= 0 {\n   962\t\t\t\treturn finish(ReviewRunFailed, \"accumulated wall-clock budget spent before adapter launch\")\n   963\t\t\t}\n   964\t\t\tif remaining < timeout {\n   965\t\t\t\ttimeout = remaining\n   966\t\t\t}\n   967\t\t}\n   968\t\tctx, cancel := context.WithTimeout(parent, timeout)\n   969\t\tdefer cancel()\n   970\t\tcmd := exec.CommandContext(ctx, execPath, argv[1:]...)\n   971\t\tcmd.Args[0] = argv[0]\n   972\t\t// The adapter runs under the review run shim, which ends what the run\n   973\t\t// leaves in its subtree (review_shim.go).\n   974\t\tuseShim := false\n   975\t\tvar shimRead, shimWrite *os.File\n   976\t\tif ReviewShimAvailable && runtime.GOOS == \"linux\" && cmd.Err == nil {\n   977\t\t\t// The adapter's path as resolved here, in the dispatcher's PATH.\n   978\t\t\tif self, err := os.Executable(); err == nil {\n   979\t\t\t\tif r, w, err := os.Pipe(); err == nil {\n   980\t\t\t\t\tuseShim, shimRead, shimWrite = true, r, w\n   981\t\t\t\t\tcmd = exec.CommandContext(ctx, self, append([]string{ReviewShimArg, cmd.Path}, argv...)...)\n   982\t\t\t\t\tcmd.ExtraFiles = []*os.File{w}\n   983\t\t\t\t}\n   984\t\t\t}\n   985\t\t}\n   986\t\tcmd.Dir = worktree\n   987\t\tcmd.Stdin = strings.NewReader(plan.Brief.Text)\n   988\t\tenv, secrets, err := reviewAdapterEnvironment(plan.Config, tmp, plan.Brief.Text, plan.notes)\n   989\t\tif err != nil {\n   990\t\t\trun.BriefNotes = \"\"\n   991\t\t\treturn finish(ReviewRunFailed, err.Error())\n   992\t\t}\n   993\t\tunset := []string{}\n   994\t\tif policy, _, found, perr := s.LoadDelegationPolicy(); perr == nil && found {\n   995\t\t\tunset = policy.EnvUnset\n   996\t\t}\n   997\t\tenv, run.EnvRemoved = withoutParentSession(env, unset)\n   998\t\t// The reviewer works in a sealed checkout: diagnostics it runs must not\n   999\t\t// publish derived records into it (SealedCheckoutEnv).\n  1000\t\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n  1001\t\tif useShim {\n  1002\t\t\tenv = append(env, ReviewShimReportEnv+\"=\"+fmt.Sprint(os.Getpid()))\n  1003\t\t}\n  1004\t\t// The reviewer checks its draft against the sealed bundle and the round\n  1005\t\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n  1006\t\t// context that cannot be built leaves the check unavailable, never the\n  1007\t\t// review.\n  1008\t\tif plan.Purpose == DelegationPurposeReview {\n  1009\t\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n  1010\t\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n  1011\t\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n  1012\t\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n  1013\t\t\t\t\t// engine that dispatched the run is the one that checks it.\n  1014\t\t\t\t\tif self, err := os.Executable(); err == nil {\n  1015\t\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n  1016\t\t\t\t\t}\n  1017\t\t\t\t}\n  1018\t\t\t}\n  1019\t\t}\n  1020\t\tcmd.Env = env\n  1021\t\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n  1022\t\tcmd.Stdout, cmd.Stderr = combined, combined\n  1023\t\t// pose delegate watch follows the normalized, redacted events as they come\n  1024\t\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n  1025\t\t// the record is published.\n  1026\t\tsessionPattern := \"\"\n  1027\t\tif plan.Config.Session != nil {\n  1028\t\t\tsessionPattern = plan.Config.Session.Pattern\n  1029\t\t}\n  1030\t\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n  1031\t\t\ttee := io.MultiWriter(combined, live)\n  1032\t\t\tcmd.Stdout, cmd.Stderr = tee, tee\n  1033\t\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n  1034\t\t\tdefer live.Close()\n  1035\t\t}\n  1036\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n  1037\t\t// only the parent left a child holding stdout, so the timeout never fired\n  1038\t\t// (found in review). The run gets its own process group, the whole group\n  1039\t\t// is killed on timeout and after the run, and pipes are released at most\n  1040\t\t// a few seconds after the kill.\n  1041\t\topaqueBaseline := reviewOpaqueProcessBaseline()\n  1042\t\t// Orphans of the run are reparented to this process, so one that left\n  1043\t\t// the group and cleared its environment is still found (review round 6, N2).\n  1044\t\tisolateProcessGroup(cmd)\n  1045\t\tcmd.WaitDelay = AdapterPipeGrace\n  1046\t\tvar shimReport []byte\n  1047\t\tshimReportDone := make(chan struct{})\n  1048\t\tif useShim {\n  1049\t\t\t// A timeout asks the shim to end the run's subtree first; the group\n  1050\t\t\t// kill after Wait remains the backstop (review round 8, N3).\n  1051\t\t\tcmd.Cancel = stopReviewShim(cmd)\n  1052\t\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n  1053\t\t\tgo func() {\n  1054\t\t\t\tdefer close(shimReportDone)\n  1055\t\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n  1056\t\t\t\t// Whatever exceeds the bound is drained, so the shim never blocks.\n  1057\t\t\t\t_, _ = io.Copy(io.Discard, shimRead)\n  1058\t\t\t}()\n  1059\t\t} else {\n  1060\t\t\tclose(shimReportDone)\n  1061\t\t}\n  1062\t\tvar runErr error\n  1063\t\tif run.Provenance == nil {\n  1064\t\t\trunErr = cmd.Run()\n  1065\t\t} else {\n  1066\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1067\t\t\trunErr = err\n  1068\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1069\t\t\tif started {\n  1070\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1071\t\t\t}\n  1072\t\t}\n  1073\t\tif useShim && safety != nil {\n  1074\t\t\t// With the shim the run's leftovers are its subtree, not an\n  1075\t\t\t// environment match (review round 9, N1).\n  1076\t\t\tfor i, limit := range safety.Limitations {\n  1077\t\t\t\tif strings.HasPrefix(limit, \"no memory/CPU quota;\") {\n  1078\t\t\t\t\tsafety.Limitations[i] = \"no memory/CPU quota; the review run shim ends every process left in the run's subtree, including one in its own session\"\n  1079\t\t\t\t}\n  1080\t\t\t}\n  1081\t\t}\n  1082\t\tif useShim {\n  1083\t\t\t_ = shimWrite.Close()\n  1084\t\t\t<-shimReportDone\n  1085\t\t\t_ = shimRead.Close()\n  1086\t\t}\n  1087\t\tterminationErr = killProcessGroup(cmd)\n  1088\t\t// A command the reviewer left running in a session of its own escapes the\n  1089\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1090\t\t// directories it may still write (spec\n  1091\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1092\t\t// The environment entry is the reviewer's to set, so it is searched only\n  1093\t\t// without the shim, whose subtree is the run's by construction (review\n  1094\t\t// round 8, N1).\n  1095\t\tvar reaped []string\n  1096\t\tvar opaque int\n  1097\t\tvar reapErr error\n  1098\t\tif !useShim {\n  1099\t\t\treaped, opaque, reapErr = reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n  1100\t\t\tif reapErr != nil {\n  1101\t\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1102\t\t\t}\n  1103\t\t}\n  1104\t\tif useShim && cmd.ProcessState != nil {\n  1105\t\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n  1106\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1107\t\t\t} else {\n  1108\t\t\t\tfor _, pid := range report.Ended {\n  1109\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1110\t\t\t\t}\n  1111\t\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n  1112\t\t\t\t\treaped = append(reaped, fmt.Sprintf(\"and %d more (orphaned)\", more))\n  1113\t\t\t\t}\n  1114\t\t\t\tif report.Error != \"\" {\n  1115\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1116\t\t\t\t\t// The shim's own words go into the record, not only the\n  1117\t\t\t\t\t// generic failure (review round 10, N3).\n  1118\t\t\t\t\tif safety != nil {\n  1119\t\t\t\t\t\tsafety.Limitations = append(safety.Limitations, \"the review run shim could not end the whole subtree: \"+report.Error)\n  1120\t\t\t\t\t}\n  1121\t\t\t\t}\n  1122\t\t\t}\n  1123\t\t}\n  1124\t\tif len(reaped) > 0 && safety != nil {\n  1125\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n  1126\t\t}\n  1127\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1128\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1129\t\t}\n  1130\t\tterminationFailed = terminationErr != nil\n  1131\t\t// The adapter exited and a child it left still held the output when\n  1132\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1133\t\t// the exit status decides (found in review).\n  1134\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1135\t\t\trunErr = nil\n  1136\t\t}\n  1137\t\ttranscript, overflow := combined.result()\n  1138\t\tsafety.CaptureComplete = !overflow\n  1139\t\tif cmd.ProcessState != nil {\n  1140\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1141\t\t}\n  1142\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n  1143\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n  1144\t\t\tsafety.CaptureComplete = false\n  1145\t\t}\n  1146\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1147\t\t\trun.Output = string(raw)\n  1148\t\t\tif run.Provenance != nil {\n  1149\t\t\t\trun.Provenance.OutputComplete = true\n  1150\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1151\t\t\t}\n  1152\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1153\t\t\t// The agent writes no output file; its stream names its final message.\n  1154\t\t\trun.Output = final\n  1155\t\t\tif run.Provenance != nil {\n  1156\t\t\t\trun.Provenance.OutputComplete = true\n  1157\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1158\t\t\t}\n  1159\t\t} else {\n  1160\t\t\trun.Output = tail(string(transcript), 20000)\n  1161\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1162\t\t\t\tsafety.CaptureComplete = false\n  1163\t\t\t}\n  1164\t\t\tif run.Provenance != nil {\n  1165\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1166\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1167\t\t\t}\n  1168\t\t}\n  1169\t\tif run.Provenance != nil {\n  1170\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '1,340p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"io\"\n    28\t\t\"os\"\n    29\t\t\"path/filepath\"\n    30\t\t\"strings\"\n    31\t\t\"time\"\n    32\t)\n    33\t\n    34\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    35\t// proven abandoned.\n    36\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    37\t\n    38\t// reviewOrphanReservationAge is how old a reservation without any marker\n    39\t// must be to count as abandoned.\n    40\tconst reviewOrphanReservationAge = 10 * time.Minute\n    41\t\n    42\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    43\t// dispatch ended before recording it, and removes its stalled marker. A\n    44\t// stalled marker whose reservation was never published is only removed; the\n    45\t// returned run is then empty.\n    46\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    47\t\tif !validAttemptFileName(attemptID) {\n    48\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    49\t\t}\n    50\t\tmarkers, _, err := s.ListDelegationActive()\n    51\t\tif err != nil {\n    52\t\t\treturn ReviewRun{}, err\n    53\t\t}\n    54\t\tvar marker *DelegationActiveRun\n    55\t\tfor i := range markers {\n    56\t\t\tif markers[i].AttemptID == attemptID {\n    57\t\t\t\tmarker = &markers[i]\n    58\t\t\t}\n    59\t\t}\n    60\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    61\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    62\t\t}\n    63\t\tdir, err := s.delegationActiveDir(true)\n    64\t\tif err != nil {\n    65\t\t\treturn ReviewRun{}, err\n    66\t\t}\n    67\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    68\t\tif err != nil {\n    69\t\t\treturn ReviewRun{}, err\n    70\t\t}\n    71\t\tdefer lock.Close()\n    72\t\tunlock, err := lockSpecTransferFile(lock)\n    73\t\tif err != nil {\n    74\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    75\t\t}\n    76\t\tdefer unlock()\n    77\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    78\t}\n    79\t\n    80\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    81\t\tvar reserved *DelegatedReviewAttempt\n    82\t\tif marker != nil {\n    83\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    84\t\t\tif err != nil {\n    85\t\t\t\treturn ReviewRun{}, err\n    86\t\t\t}\n    87\t\t\tfor i := range attempts {\n    88\t\t\t\tif attempts[i].AttemptID == attemptID {\n    89\t\t\t\t\treserved = &attempts[i]\n    90\t\t\t\t}\n    91\t\t\t}\n    92\t\t\tif reserved == nil {\n    93\t\t\t\t// The dispatch ended between its marker and its reservation:\n    94\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    95\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    96\t\t\t}\n    97\t\t} else {\n    98\t\t\tif !operatorConfirmed {\n    99\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n   100\t\t\t}\n   101\t\t\torphans, _, err := s.orphanReservations(now)\n   102\t\t\tif err != nil {\n   103\t\t\t\treturn ReviewRun{}, err\n   104\t\t\t}\n   105\t\t\tfor i := range orphans {\n   106\t\t\t\tif orphans[i].AttemptID == attemptID {\n   107\t\t\t\t\treserved = &orphans[i]\n   108\t\t\t\t}\n   109\t\t\t}\n   110\t\t\tif reserved == nil {\n   111\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   112\t\t\t}\n   113\t\t}\n   114\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   115\t\t\t// A release that stopped after the receipt completes by removing\n   116\t\t\t// the stalled marker; with no marker there is nothing to release.\n   117\t\t\tif marker != nil {\n   118\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   119\t\t\t\tif err != nil {\n   120\t\t\t\t\treturn ReviewRun{}, err\n   121\t\t\t\t}\n   122\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   123\t\t\t\tif err != nil {\n   124\t\t\t\t\treturn ReviewRun{}, err\n   125\t\t\t\t}\n   126\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   127\t\t\t}\n   128\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   129\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   130\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   131\t\t}\n   132\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   133\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   134\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   135\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   136\t\tif marker != nil {\n   137\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   138\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   139\t\t} else {\n   140\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   141\t\t}\n   142\t\t// A run the attempt already recorded, by its dispatch or by a release\n   143\t\t// interrupted before the receipt, completes the attempt; no second run\n   144\t\t// is written for it.\n   145\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   146\t\tif err != nil {\n   147\t\t\treturn ReviewRun{}, err\n   148\t\t}\n   149\t\tif !found {\n   150\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   151\t\t\t\treturn ReviewRun{}, err\n   152\t\t\t}\n   153\t\t}\n   154\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   155\t\t\treturn recorded, err\n   156\t\t}\n   157\t\tif marker != nil {\n   158\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   159\t\t}\n   160\t\treturn recorded, nil\n   161\t}\n   162\t\n   163\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   164\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   165\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   166\t\tif err != nil {\n   167\t\t\treturn ReviewRun{}, false, err\n   168\t\t}\n   169\t\tif len(lost) > 0 {\n   170\t\t\t// An unreadable run may be this release's: the history is unknown,\n   171\t\t\t// and the release does not write another (review round 4, N3).\n   172\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   173\t\t}\n   174\t\tvar latest *ReviewRun\n   175\t\tfor i := range runs {\n   176\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   177\t\t\t\tlatest = &runs[i]\n   178\t\t\t}\n   179\t\t}\n   180\t\tif latest == nil {\n   181\t\t\treturn ReviewRun{}, false, nil\n   182\t\t}\n   183\t\treturn *latest, true, nil\n   184\t}\n   185\t\n   186\t// orphanReservations lists the reservations left without a receipt or a\n   187\t// marker, older than reviewOrphanReservationAge, and\n   188\t// says which reservations or receipts it could not read (review round 3, N3).\n   189\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   190\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   191\t\tdirs, dirsTruncated, err := readDirBounded(base, reviewOrphanScanMaxEntries)\n   192\t\tif errors.Is(err, os.ErrNotExist) {\n   193\t\t\treturn nil, nil, nil\n   194\t\t}\n   195\t\tif err != nil {\n   196\t\t\treturn nil, nil, err\n   197\t\t}\n   198\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   199\t\tif err != nil {\n   200\t\t\treturn nil, nil, err\n   201\t\t}\n   202\t\tif len(markerLost) > 0 {\n   203\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   204\t\t\t// have no marker (review round 6, N1).\n   205\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   206\t\t}\n   207\t\tmarked := map[string]bool{}\n   208\t\tfor _, m := range markers {\n   209\t\t\tmarked[m.AttemptID] = true\n   210\t\t}\n   211\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   212\t\tif err != nil {\n   213\t\t\treturn nil, nil, err\n   214\t\t}\n   215\t\tif len(runLost) > 0 {\n   216\t\t\t// Without the whole run history nothing is known to have no run.\n   217\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   218\t\t}\n   219\t\t// A recorded run does not finish an attempt, its receipt does: a\n   220\t\t// reservation whose run was recorded without a receipt still blocks and\n   221\t\t// is released with that run (review round 5, N3).\n   222\t\t_ = runs\n   223\t\tvar out []DelegatedReviewAttempt\n   224\t\tvar lost []string\n   225\t\tbudget := reviewReadBudget(nil)\n   226\t\tfor _, d := range dirs {\n   227\t\t\tif !d.IsDir() {\n   228\t\t\t\tcontinue\n   229\t\t\t}\n   230\t\t\tentries, truncated, err := readDirBounded(filepath.Join(base, d.Name()), reviewOrphanScanMaxEntries)\n   231\t\t\tif err != nil {\n   232\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   233\t\t\t\tcontinue\n   234\t\t\t}\n   235\t\t\tif truncated {\n   236\t\t\t\tlost = append(lost, fmt.Sprintf(\"the reservations in %s exceed %d entries; the rest were not read\", d.Name(), reviewOrphanScanMaxEntries))\n   237\t\t\t}\n   238\t\t\tfor _, e := range entries {\n   239\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   240\t\t\t\t\tcontinue\n   241\t\t\t\t}\n   242\t\t\t\tvar a DelegatedReviewAttempt\n   243\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   248\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   249\t\t\t\t\tcontinue\n   250\t\t\t\t}\n   251\t\t\t\tif marked[a.AttemptID] {\n   252\t\t\t\t\tcontinue\n   253\t\t\t\t}\n   254\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   255\t\t\t\t\tcontinue\n   256\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   257\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   258\t\t\t\t\tcontinue\n   259\t\t\t\t}\n   260\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   261\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   262\t\t\t\t\tcontinue\n   263\t\t\t\t}\n   264\t\t\t\tout = append(out, a)\n   265\t\t\t}\n   266\t\t}\n   267\t\tif dirsTruncated {\n   268\t\t\tlost = append(lost, fmt.Sprintf(\"the attempt directories exceed %d entries; the rest were not read\", reviewOrphanScanMaxEntries))\n   269\t\t}\n   270\t\treturn out, lost, nil\n   271\t}\n   272\t\n   273\t// reviewOrphanScanMaxEntries bounds each directory the orphan scan lists\n   274\t// (review round 10, N2).\n   275\tconst reviewOrphanScanMaxEntries = 10000\n   276\t\n   277\t// readDirBounded lists at most max entries of dir and says whether more exist.\n   278\tfunc readDirBounded(dir string, max int) ([]os.DirEntry, bool, error) {\n   279\t\tf, err := os.Open(dir)\n   280\t\tif err != nil {\n   281\t\t\treturn nil, false, err\n   282\t\t}\n   283\t\tdefer f.Close()\n   284\t\tentries, err := f.ReadDir(max + 1)\n   285\t\tif err != nil && !errors.Is(err, io.EOF) {\n   286\t\t\treturn nil, false, err\n   287\t\t}\n   288\t\tif len(entries) > max {\n   289\t\t\treturn entries[:max], true, nil\n   290\t\t}\n   291\t\treturn entries, false, nil\n   292\t}\n   293\t\n   294\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   295\t\tdir, err := s.delegationActiveDir(false)\n   296\t\tif err != nil {\n   297\t\t\treturn err\n   298\t\t}\n   299\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   300\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   301\t\t\t\treturn err\n   302\t\t\t}\n   303\t\t}\n   304\t\treturn nil\n   305\t}\n","exit_code":0,"status":"completed"}}
