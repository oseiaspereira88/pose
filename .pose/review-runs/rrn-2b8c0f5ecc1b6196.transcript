ase_test.go:271:func TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\npose-mcp/internal/pose/delegation_release_test.go:315:func TestAMarkerlessReservationOfAnEarlierEngineIsReleased(t *testing.T) {\npose-mcp/internal/pose/delegation_release_test.go:370:func TestAnUnreadableReservationIsReportedAsALoss(t *testing.T) {\npose-mcp/internal/pose/delegation_release_test.go:388:func TestAnIncompleteRunHistoryRulesNothingOut(t *testing.T) {\npose-mcp/internal/pose/delegation_release_test.go:419:func TestARecordedRunCompletesItsAttempt(t *testing.T) {\npose-mcp/internal/pose/delegation_release_test.go:464:func TestAnUnreadableMarkerRulesNothingOut(t *testing.T) {\npose-mcp/internal/pose/delegation_release_test.go:489:func TestTheOrphanScanListsBoundedDirectories(t *testing.T) {\n","exit_code":0,"status":"completed"}}
