epEqual(diskBefore, diskAfter) {\n  1254\t\t\tchanged := []string{}\n  1255\t\t\tfor path, digest := range diskBefore {\n  1256\t\t\t\tif diskAfter[path] != digest {\n  1257\t\t\t\t\tchanged = append(changed, path)\n  1258\t\t\t\t}\n  1259\t\t\t}\n  1260\t\t\tfor path := range diskAfter {\n  1261\t\t\t\tif _, exists := diskBefore[path]; !exists {\n  1262\t\t\t\t\tchanged = append(changed, path)\n  1263\t\t\t\t}\n  1264\t\t\t}\n  1265\t\t\tsort.Strings(changed)\n  1266\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"the run changed files in the sealed worktree (including ignored materialization): %q\", changed))\n  1267\t\t}\n  1268\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n  1269\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1270\t\t}\n  1271\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n  1272\t\t\treturn finish(ReviewRunFailed, \"origin or policy changed: \"+err.Error())\n  1273\t\t}\n  1274\t\n  1275\t\tevents := run.eventsBytes\n  1276\t\tif run.Kind == ReviewBriefKindReview {\n  1277\t\t\t// The round and the draft's account of it are judged when the run\n  1278\t\t\t// completes, against the rounds before it (R1, R4).\n  1279\t\t\tround, err := s.ReviewRoundOf(plan.Bundle)\n  1280\t\t\tif err != nil {\n  1281\t\t\t\treturn finish(ReviewRunFailed, \"the round of the bundle cannot be derived: \"+err.Error())\n  1282\t\t\t}\n  1283\t\t\trun.Round, run.DraftProblems = round.Number, ValidateRoundDraft(round, run.Output)\n  1284\t\t}\n  1285\t\tpublished, err := finish(ReviewRunCompleted, \"\")\n  1286\t\tif err != nil {\n  1287\t\t\treturn published, err\n  1288\t\t}\n  1289\t\tif why := s.checkDispatchOrigin(plan); why != nil {\n  1290\t\t\tlate := published\n  1291\t\t\tlate.RunID, late.Path, late.TranscriptDigest, late.TranscriptPath = \"\", \"\", \"\", \"\"\n  1292\t\t\tlate.Status, late.Failure, late.Supersedes = ReviewRunFailed, why.Error(), published.RunID\n  1293\t\t\tlate.eventsBytes = events\n  1294\t\t\tlate.EndedAt = now().UTC().Format(time.RFC3339Nano)\n  1295\t\t\treturn s.recordReviewRun(late, transcript)\n  1296\t\t}\n  1297\t\treturn published, nil\n  1298\t}\n  1299\t\n  1300\t// Materialize only empty vendor staging directories in the disposable checkout,\n  1301\t// before its integrity snapshot. Files created there remain visible as mutations.\n  1302\t// The source repository and the legacy read profile are untouched.\n  1303\tfunc prepareClaudeReviewStaging(runtime *os.Root, components []ReviewPlanComponent) error {\n  1304\t\troot, err := runtime.OpenRoot(\"worktree\")\n  1305\t\tif err != nil {\n  1306\t\t\treturn err\n  1307\t\t}\n  1308\t\tdefer root.Close()\n  1309\t\tpaths := []string{\".\"}\n  1310\t\tfor _, component := range components {\n  1311\t\t\tif !filepath.IsLocal(component.Path) {\n  1312\t\t\t\treturn fmt.Errorf(\"review staging component is not confined\")\n  1313\t\t\t}\n  1314\t\t\tpaths = append(paths, component.Path)\n  1315\t\t}\n  1316\t\tfor _, path := range paths {\n  1317\t\t\tif err := root.MkdirAll(filepath.Join(path, \".claude\", \".cc-writes\"), 0o700); err != nil {\n  1318\t\t\t\treturn err\n  1319\t\t\t}\n  1320\t\t}\n  1321\t\treturn nil\n  1322\t}\n  1323\t\n  1324\t// The adapter has no authenticated producer/output declaration. Until such a\n  1325\t// declaration exists, a directory name cannot authorize regenerated evidence.\npose-mcp/internal/cli/release_surface_coverage_test.go:131:\t\tt.Errorf(\"pending=%d, want the one unreleased fragment: %s\", len(status.Pending), out)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/usr/bin/bash -lc \"cat <<'EOF' | \\\"\"'$POSE_REVIEW_CLI\" review draft-check --draft -\ndecision: changes-requested\n\nThe review found one medium blocking cleanup gap and two low reporting defects. The targeted regression tests and vet passed; the full strict matrix could not execute its Go steps because this sandbox denies writes to Go'\"'s build/cache paths.\n\n\"'```pose-draft\n{\n  \"schema\": \"pose.review.draft/v1\",\n  \"decision\": \"changes-requested\",\n  \"findings\": [\n    {\n      \"id\": \"N1\",\n      \"severity\": \"medium\",\n      \"disposition\": \"blocker\",\n      \"file\": \"pose-mcp/internal/pose/review_dispatch.go\",\n      \"line\": 979,\n      \"summary\": \"On Linux, if the standard CLI cannot resolve its executable or create the shim report pipe, dispatch silently launches the adapter without the run shim and falls back to matching POSE_SEALED_CHECKOUT. A reviewer can clear that entry and start a separate-session child, so cleanup can miss a live process and inventory may run while it still writes. Fail closed or preserve the shim guarantee when setup fails.\"\n    },\n    {\n      \"id\": \"N2\",\n      \"severity\": \"low\",\n      \"disposition\": \"follow-up\",\n      \"file\": \"pose-mcp/internal/pose/review_shim_linux.go\",\n      \"line\": 219,\n      \"summary\": \"killPinnedChild treats pidfd-open ESRCH as success, and reapShimSubtree then records that PID as ended; the signal path also treats pidfd-send ESRCH as success. A child that exited before signaling is therefore reported as terminated by the reaper, contrary to the run record'\"'s meaning.\\\"\n    },\n    {\n      \\\"id\\\": \\\"N3\\\",\n      \\\"severity\\\": \\\"low\\\",\n      \\\"disposition\\\": \\\"follow-up\\\",\n      \\\"file\\\": \\\"pose-mcp/internal/cli/delegate.go\\\",\n      \\\"line\\\": 1149,\n      \\\"summary\\\": \\\"The human cancel output always says a released attempt was recorded as a failed run abandoned before the run was recorded. ReleaseAbandonedAttempt can instead complete a run record already written by dispatch (including a completed run) and return that actual status, so the CLI message is false for the interrupted-after-run-before-receipt recovery path.\\\"\n    }\n  ],\n  \\\"prior_findings\\\": [\n    {\n      \\\"id\\\": \\\"R10-N1\\\",\n      \\\"status\\\": \\\"fixed\\\",\n      \\\"evidence\\\": \\\"pose-mcp/internal/pose/review_shim_linux.go:151\\\"\n    },\n    {\n      \\\"id\\\": \\\"R10-N2\\\",\n      \\\"status\\\": \\\"fixed\\\",\n      \\\"evidence\\\": \\\"pose-mcp/internal/pose/delegation_release.go:191\\\"\n    },\n    {\n      \\\"id\\\": \\\"R10-N3\\\",\n      \\\"status\\\": \\\"partial\\\",\n      \\\"evidence\\\": \\\"pose-mcp/internal/pose/review_shim_linux.go:219\\\"\n    },\n    {\n      \\\"id\\\": \\\"R10-N4\\\",\n      \\\"status\\\": \\\"fixed\\\",\n      \\\"evidence\\\": \\\"pose-mcp/internal/pose/review_reap_linux.go:5\\\"\n    }\n  ],\n  \\\"sweep\\\": \\\"Swept all 29 attributed subject paths in pose-mcp and the manuals/scaffold copies: review dispatch, Linux shim and fallback reaper, attempt release/list/cancel ledger paths, brief rendering/digest, platform-specific behavior, and their focused regression tests. Checked the current spec, D1/D2, and the applicable docs. The design assessment reported no structural deltas. The CLI cancel recovery branch is known not to have an end-to-end test, so N3 is based on the branch and the existing Store recovery behavior.\\\",\n  \\\"criteria\\\": [\n    {\n      \\\"id\\\": \\\"assumption-integrity\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/delegated-run-continuity-integration\\\",\n      \\\"rationale\\\": \\\"Verified the CLI enables the shim, the shim adopts and reaps its subtree, and the abandonment release records an ordinary failed run; focused tests cover orphan, timeout, dispatcher death and live-owner refusal. The fallback on shim setup failure is unresolved and reported as N1. Documented accepted limits include an externally reparented process that escapes both group and checkout marker (L1), non-Linux group-only cleanup (L2), and operator-confirmed markerless reservations (L4).\\\"\n    },\n    {\n      \\\"id\\\": \\\"backend-concurrency\\\",\n      \\\"disposition\\\": \\\"finding\\\",\n      \\\"evidence\\\": \\\"N1\\\"\n    },\n    {\n      \\\"id\\\": \\\"backend-contracts\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/delegation-surface-integration\\\"\n    },\n    {\n      \\\"id\\\": \\\"backend-input-errors\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\"\n    },\n    {\n      \\\"id\\\": \\\"backend-integration-impact\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/delegation-surface-integration\\\"\n    },\n    {\n      \\\"id\\\": \\\"backend-observability\\\",\n      \\\"disposition\\\": \\\"finding\\\",\n      \\\"evidence\\\": \\\"N2\\\"\n    },\n    {\n      \\\"id\\\": \\\"compatibility\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/delegation-surface-integration\\\",\n      \\\"rationale\\\": \\\"The CLI addition is additive, old run/receipt records keep their schema and failed-run meaning, and review-brief/10 preserves earlier template versions while adding the finish-commands instruction.\\\"\n    },\n    {\n      \\\"id\\\": \\\"correctness\\\",\n      \\\"disposition\\\": \\\"finding\\\",\n      \\\"evidence\\\": \\\"N1\\\"\n    },\n    {\n      \\\"id\\\": \\\"design-causality\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"structure:design-5860890eb74e4e52\\\",\n      \\\"rationale\\\": \\\"D1's isolated shim addresses descendants that leave the adapter process group or clear their environment without making the dispatcher a process-wide subreaper; D2 closes interrupted reservations using the existing failed-run and receipt records. The structure assessment found no structural deltas; N1 is the unhandled shim-setup failure path.\\\",\n      \\\"mappings\\\": []\n    },\n    {\n      \\\"id\\\": \\\"documentation\\\",\n      \\\"disposition\\\": \\\"finding\\\",\n      \\\"evidence\\\": \\\"N1\\\"\n    },\n    {\n      \\\"id\\\": \\\"operability\\\",\n      \\\"disposition\\\": \\\"finding\\\",\n      \\\"evidence\\\": \\\"N3\\\"\n    },\n    {\n      \\\"id\\\": \\\"requirements\\\",\n      \\\"disposition\\\": \\\"finding\\\",\n      \\\"evidence\\\": \\\"N1\\\"\n    },\n    {\n      \\\"id\\\": \\\"scope\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/delegation-surface-integration\\\",\n      \\\"rationale\\\": \\\"The reviewed paths are the declared pose-mcp dispatch, reaper, attempt-release, brief and documentation surfaces for R1-R6; no unrelated implementation change was included in the findings.\\\"\n    },\n    {\n      \\\"id\\\": \\\"security\\\",\n      \\\"disposition\\\": \\\"finding\\\",\n      \\\"evidence\\\": \\\"N1\\\"\n    },\n    {\n      \\\"id\\\": \\\"solution-proportionality\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"structure:design-5860890eb74e4e52\\\",\n      \\\"rationale\\\": \\\"An isolated shim is the narrowest sufficient Linux subreaper boundary; a process-wide subreaper would adopt children from unrelated dispatcher work. The release ledger uses existing records and a kernel lock rather than new record schemas. Shim setup failure is the condition that invalidates the runtime guarantee and is tracked as N1; non-Linux cleanup is explicitly limited to the process group.\\\"\n    }\n  ],\n  \\\"tools\\\": [\n    {\n      \\\"id\\\": \\\"artifact-check\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n    