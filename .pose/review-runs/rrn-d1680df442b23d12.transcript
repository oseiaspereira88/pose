{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/lintspec.go | sed -n '400,610p'; nl -ba pose-mcp/internal/pose/accepted_limits_test.go; nl -ba pose-mcp/internal/cli/accepted_limits_lint_test.go\"","aggregated_output":"   400\ttype specFindings struct {\n   401\t\tr    *cliout.Renderer\n   402\t\tslug string\n   403\t}\n   404\t\n   405\tfunc (f specFindings) finding(state cliout.State, code, message string) {\n   406\t\tf.r.Finding(cliout.Finding{State: state, Code: code, Path: f.slug, Message: message})\n   407\t}\n   408\t\n   409\t// sectionState reads the section's own requiredness: a missing required section\n   410\t// is an error, an optional one a warning.\n   411\tfunc sectionState(required bool) cliout.State {\n   412\t\tif required {\n   413\t\t\treturn cliout.StateError\n   414\t\t}\n   415\t\treturn cliout.StateWarning\n   416\t}\n   417\t\n   418\t// lintProjectRoot is the directory that holds the .pose tree of specPath.\n   419\tfunc lintProjectRoot(specPath string) string {\n   420\t\tdir := filepath.Dir(specPath)\n   421\t\tfor {\n   422\t\t\tif filepath.Base(dir) == \".pose\" {\n   423\t\t\t\treturn filepath.Dir(dir)\n   424\t\t\t}\n   425\t\t\tparent := filepath.Dir(dir)\n   426\t\t\tif parent == dir {\n   427\t\t\t\treturn filepath.Dir(filepath.Dir(specPath))\n   428\t\t\t}\n   429\t\t\tdir = parent\n   430\t\t}\n   431\t}\n   432\t\n   433\tfunc lintOneSpec(specPath string, requiredOnly, readyCheck bool, stdout, stderr io.Writer, designCheck ...bool) int {\n   434\t\treturn lintOneSpecWith(render(stdout, stderr), true, specPath, requiredOnly, readyCheck, stderr, len(designCheck) > 0 && designCheck[0])\n   435\t}\n   436\t\n   437\t// lintOneSpecWith lints one spec through r. A caller that lints many specs into\n   438\t// one machine document passes fields=false: the per-spec `spec.*` fields would\n   439\t// collide in the document's field map, and every finding already names its spec.\n   440\tfunc lintOneSpecWith(r *cliout.Renderer, fields bool, specPath string, requiredOnly, readyCheck bool, stderr io.Writer, checkDesign bool) int {\n   441\t\tfield := func(name, value string) {\n   442\t\t\tif fields {\n   443\t\t\t\tr.Field(name, value)\n   444\t\t\t}\n   445\t\t}\n   446\t\tlocale := cliLocaleValue()\n   447\t\traw, err := os.ReadFile(specPath)\n   448\t\tif err != nil {\n   449\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: spec not found: %s\\n\", \"Erro: spec ausente: %s\\n\"), specPath)\n   450\t\t\treturn 2\n   451\t\t}\n   452\t\tfrontmatter := lintParseFrontmatter(string(raw))\n   453\t\ttext := htmlCommentRE.ReplaceAllString(string(raw), \"\")\n   454\t\tsections := splitLintSections(text)\n   455\t\tslug := frontmatter[\"slug\"]\n   456\t\tif slug == \"\" {\n   457\t\t\tslug = filepath.Base(filepath.Dir(specPath))\n   458\t\t}\n   459\t\tlint := specFindings{r: r, slug: slug}\n   460\t\tif frontmatter[\"status\"] == \"superseded\" {\n   461\t\t\tif canonical, ok := posepkg.VerifiedTransferStub(lintProjectRoot(specPath), slug, string(raw)); ok {\n   462\t\t\t\t// A verified redirect owns no requirements or lifecycle of its\n   463\t\t\t\t// own; the canonical task is linted where it lives.\n   464\t\t\t\tfield(\"spec.redirect\", canonical.String())\n   465\t\t\t\treturn 0\n   466\t\t\t}\n   467\t\t}\n   468\t\tlineageFailures := 0\n   469\t\tif links := posepkg.RemediationValues(frontmatter[\"remediates\"]); len(links) > 0 {\n   470\t\t\troot, lineageErr := projectRootAt(filepath.Dir(specPath))\n   471\t\t\tif lineageErr == nil {\n   472\t\t\t\tlineageErr = (posepkg.Store{Root: root}).ValidateRemediationLineage(posepkg.Spec{Slug: slug, Remediates: links})\n   473\t\t\t}\n   474\t\t\tif lineageErr != nil {\n   475\t\t\t\tlint.finding(cliout.StateError, \"remediation-lineage\", lineageErr.Error())\n   476\t\t\t\tlineageFailures++\n   477\t\t\t}\n   478\t\t\tfield(\"spec.remediation.links\", strconv.Itoa(len(links)))\n   479\t\t\tfield(\"spec.remediation.failures\", strconv.Itoa(lineageFailures))\n   480\t\t}\n   481\t\tdesignFailures := 0\n   482\t\temitDesignBasis := func() {\n   483\t\t\tif !checkDesign {\n   484\t\t\t\treturn\n   485\t\t\t}\n   486\t\t\troot, rootErr := projectRootAt(filepath.Dir(specPath))\n   487\t\t\tif rootErr != nil {\n   488\t\t\t\troot = \"\"\n   489\t\t\t}\n   490\t\t\treport := posepkg.ValidateDesignBasis(string(raw), root)\n   491\t\t\t// Buffered so the fields follow the findings, as they always have.\n   492\t\t\tdesignFields := [][2]string{}\n   493\t\t\tdesignFields = append(designFields, [2]string{\"spec.design_basis.present\", strconv.FormatBool(report.HasSection)})\n   494\t\t\tdesignFields = append(designFields, [2]string{\"spec.design_basis.assumptions\", strconv.Itoa(len(report.Assumptions))})\n   495\t\t\tdesignFields = append(designFields, [2]string{\"spec.design_basis.decisions\", strconv.Itoa(len(report.Decisions))})\n   496\t\t\tdesignFields = append(designFields, [2]string{\"spec.design_basis.diagnostics\", strconv.Itoa(len(report.Diagnostics))})\n   497\t\t\terrors, warnings := 0, 0\n   498\t\t\tfor _, diagnostic := range report.Diagnostics {\n   499\t\t\t\tstate := cliout.StateWarning\n   500\t\t\t\tif diagnostic.Severity == \"error\" {\n   501\t\t\t\t\tstate = cliout.StateError\n   502\t\t\t\t\terrors++\n   503\t\t\t\t} else {\n   504\t\t\t\t\twarnings++\n   505\t\t\t\t}\n   506\t\t\t\tmessage := fmt.Sprintf(\"design basis line %d: %s\", diagnostic.Line, diagnostic.Message)\n   507\t\t\t\tlint.finding(state, \"design-basis/\"+diagnostic.Code, message)\n   508\t\t\t}\n   509\t\t\tdesignFailures = errors\n   510\t\t\tdesignFields = append(designFields, [2]string{\"spec.design_basis.errors\", strconv.Itoa(errors)})\n   511\t\t\tdesignFields = append(designFields, [2]string{\"spec.design_basis.warnings\", strconv.Itoa(warnings)})\n   512\t\t\tif report.Digest != \"\" {\n   513\t\t\t\tdesignFields = append(designFields, [2]string{\"spec.design_basis.digest\", report.Digest})\n   514\t\t\t}\n   515\t\t\tfor _, f := range designFields {\n   516\t\t\t\tfield(f[0], f[1])\n   517\t\t\t}\n   518\t\t}\n   519\t\n   520\t\t// The verdicts delegated adjudications recorded on this spec (spec\n   521\t\t// pose-delegated-verdict-destinations R1): a question the current bundle's\n   522\t\t// adjudication says does not hold fails the lint; one it cannot determine,\n   523\t\t// and a record that does not verify, are warned about.\n   524\t\tadjudicationFailures := 0\n   525\t\tif root, err := projectRootAt(filepath.Dir(specPath)); err == nil {\n   526\t\t\tif adjudications, err := (posepkg.Store{Root: root}).SpecAdjudications(slug); err == nil && len(adjudications) > 0 {\n   527\t\t\t\tfor _, a := range adjudications {\n   528\t\t\t\t\tswitch {\n   529\t\t\t\t\tcase !a.Verified:\n   530\t\t\t\t\t\tlint.finding(cliout.StateWarning, \"adjudication\", fmt.Sprintf(cliText(locale, \"%s does not verify: %s\", \"%s não verifica: %s\"), a.Path, a.Why))\n   531\t\t\t\t\tcase !a.Current:\n   532\t\t\t\t\t\tcontinue\n   533\t\t\t\t\tdefault:\n   534\t\t\t\t\t\tfor _, q := range a.Record.Questions {\n   535\t\t\t\t\t\t\tswitch q.Verdict {\n   536\t\t\t\t\t\t\tcase posepkg.AdjudicationDoesNotHold:\n   537\t\t\t\t\t\t\t\tlint.finding(cliout.StateError, \"adjudication\", fmt.Sprintf(cliText(locale, \"%s does not hold, adjudicated by %s: %s\", \"%s não se sustenta, adjudicado por %s: %s\"), q.ID, a.Record.RunID, q.Rationale))\n   538\t\t\t\t\t\t\t\tadjudicationFailures++\n   539\t\t\t\t\t\t\tcase posepkg.AdjudicationCannotDetermine:\n   540\t\t\t\t\t\t\t\tlint.finding(cliout.StateWarning, \"adjudication\", fmt.Sprintf(cliText(locale, \"%s cannot be determined, adjudicated by %s: %s\", \"%s não pôde ser determinado, adjudicado por %s: %s\"), q.ID, a.Record.RunID, q.Rationale))\n   541\t\t\t\t\t\t\t}\n   542\t\t\t\t\t\t}\n   543\t\t\t\t\t}\n   544\t\t\t\t}\n   545\t\t\t\tfield(\"spec.adjudications\", strconv.Itoa(len(adjudications)))\n   546\t\t\t\tfield(\"spec.adjudications.failures\", strconv.Itoa(adjudicationFailures))\n   547\t\t\t}\n   548\t\t}\n   549\t\tif readyCheck {\n   550\t\t\tfailures := 0\n   551\t\t\tfor _, name := range []string{\"Intent\", \"Requirements\", \"Technical Plan\"} {\n   552\t\t\t\tlines, ok := sections[name]\n   553\t\t\t\tif !ok || classifySection(lines) != \"filled\" {\n   554\t\t\t\t\tlint.finding(cliout.StateError, \"dor\", fmt.Sprintf(cliText(locale, \"DoR: section %s is missing, empty, or skeletal\", \"DoR: seção %s ausente/vazia/esquelética\"), name))\n   555\t\t\t\t\tfailures++\n   556\t\t\t\t}\n   557\t\t\t}\n   558\t\t\tif len(parseRequirementIDs(sections[\"Requirements\"])) == 0 {\n   559\t\t\t\tlint.finding(cliout.StateError, \"dor\", cliText(locale, \"DoR: no acceptance criterion has a stable ID (use '- R<N>: ...' bullets in Requirements)\", \"DoR: nenhum acceptance criterion com ID estável (use bullets '- R<N>: ...' em Requirements)\"))\n   560\t\t\t\tfailures++\n   561\t\t\t}\n   562\t\t\tfor _, ref := range lintParseDependsOn(frontmatter[\"depends_on\"]) {\n   563\t\t\t\tif _, err := posepkg.ParseArtifactRef(ref); err == nil {\n   564\t\t\t\t\tcontinue\n   565\t\t\t\t}\n   566\t\t\t\tlint.finding(cliout.StateError, \"dor\", fmt.Sprintf(cliText(locale, \"DoR: invalid depends_on reference: '%s'\", \"DoR: ref inválida em depends_on: '%s'\"), ref))\n   567\t\t\t\tfailures++\n   568\t\t\t}\n   569\t\t\t// Accepted limits (spec pose-review-declared-threat-model R4): each\n   570\t\t\t// says why it is accepted, and an ADR that names the spec names each\n   571\t\t\t// limit, so the decision record carries what the review will treat as\n   572\t\t\t// out of scope.\n   573\t\t\tlimits, limitProblems := posepkg.ParseAcceptedLimits(text)\n   574\t\t\tfor _, problem := range limitProblems {\n   575\t\t\t\tlint.finding(cliout.StateError, \"dor\", \"DoR: \"+problem)\n   576\t\t\t\tfailures++\n   577\t\t\t}\n   578\t\t\tif len(limits) > 0 {\n   579\t\t\t\tfor _, missing := range acceptedLimitsMissingFromADRs(lintProjectRoot(specPath), slug, limits) {\n   580\t\t\t\t\tlint.finding(cliout.StateError, \"dor\", missing)\n   581\t\t\t\t\tfailures++\n   582\t\t\t\t}\n   583\t\t\t}\n   584\t\t\temitDesignBasis()\n   585\t\t\tfailures += designFailures + lineageFailures\n   586\t\t\tready := \"true\"\n   587\t\t\tif failures > 0 {\n   588\t\t\t\tready = \"false\"\n   589\t\t\t}\n   590\t\t\tfield(\"spec.ready\", ready)\n   591\t\t\tfield(\"spec.ready.failures\", strconv.Itoa(failures))\n   592\t\t\tif failures > 0 {\n   593\t\t\t\treturn 1\n   594\t\t\t}\n   595\t\t\treturn 0\n   596\t\t}\n   597\t\n   598\t\t// A spec declares its surface (spec pose-progressive-spec-surface): a\n   599\t\t// minimal surface does not require the planner-local Tasks section. It\n   600\t\t// never relaxes the lifecycle gates below — trace, follow-ups and\n   601\t\t// amendments are checked the same way.\n   602\t\trequired := posepkg.RequiredSpecSections(strings.TrimSpace(frontmatter[\"surface\"]))\n   603\t\ttargets := append([]string{}, required...)\n   604\t\tif !requiredOnly {\n   605\t\t\ttargets = append(targets, optionalSections...)\n   606\t\t\tfor _, name := range requiredSections {\n   607\t\t\t\tif !containsSection(targets, name) {\n   608\t\t\t\t\ttargets = append(targets, name)\n   609\t\t\t\t}\n   610\t\t\t}\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"os\"\n     5\t\t\"path/filepath\"\n     6\t\t\"strings\"\n     7\t\t\"testing\"\n     8\t)\n     9\t\n    10\tconst limitsSection = `\n    11\t### Accepted limits\n    12\t- L1: A process that clears its environment escapes. Accepted because the shim covers it.\n    13\t- L2: Windows is untested here. Accepted because the host is Linux.\n    14\t`\n    15\t\n    16\t// Spec pose-review-declared-threat-model R1: the section is read as\n    17\t// written, and what does not say why it is accepted is reported.\n    18\tfunc TestAcceptedLimitsAreParsed(t *testing.T) {\n    19\t\tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n    20\t\tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n    21\t\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n    22\t\t}\n    23\t\t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n\")\n    24\t\tjoined := strings.Join(problems, \"\\n\")\n    25\t\tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\"} {\n    26\t\t\tif !strings.Contains(joined, want) {\n    27\t\t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n    28\t\t\t}\n    29\t\t}\n    30\t}\n    31\t\n    32\t// R1: the review plan seals the limits the spec declares, and they enter the\n    33\t// plan digest; a spec without limits keeps its digest.\n    34\tfunc TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n    35\t\troot, store := reviewBundleFixture(t)\n    36\t\tbefore, err := store.ReviewPlan(\"spec:backend\")\n    37\t\tif err != nil || len(before.AcceptedLimits) != 0 {\n    38\t\t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n    39\t\t}\n    40\t\tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n    41\t\traw, _ := os.ReadFile(path)\n    42\t\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n    43\t\t\tt.Fatal(err)\n    44\t\t}\n    45\t\tafter, err := store.ReviewPlan(\"spec:backend\")\n    46\t\tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n    47\t\t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n    48\t\t}\n    49\t\twithout := after\n    50\t\twithout.AcceptedLimits = nil\n    51\t\tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n    52\t\t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n    53\t\t}\n    54\t}\n    55\t\n    56\t// R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n    57\t// recorded within-limit, naming it, and does not block an approval whatever\n    58\t// its severity; a limit the bundle did not seal accepts nothing.\n    59\tfunc TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n    60\t\tvar bundle ReviewBundle\n    61\t\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n    62\t\tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n    63\t\t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n    64\t\t}}\n    65\t\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n    66\t\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n    67\t\t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n    68\t\t}\n    69\t\tatt.Decision = \"approved\"\n    70\t\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n    71\t\t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n    72\t\t}\n    73\t\tatt.Findings[0].Limit = \"L9\"\n    74\t\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n    75\t\t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n    76\t\t}\n    77\t\tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"\"\n    78\t\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n    79\t\t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n    80\t\t}\n    81\t}\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"os\"\n     6\t\t\"path/filepath\"\n     7\t\t\"strings\"\n     8\t\t\"testing\"\n     9\t)\n    10\t\n    11\t// Spec pose-review-declared-threat-model R4: the ready check refuses an\n    12\t// accepted limit without its reason, and one an ADR citing the spec omits.\n    13\tfunc TestReadyCheckJudgesAcceptedLimits(t *testing.T) {\n    14\t\troot := t.TempDir()\n    15\t\twrite := func(rel, body string) {\n    16\t\t\tp := filepath.Join(root, rel)\n    17\t\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n    18\t\t\t\tt.Fatal(err)\n    19\t\t\t}\n    20\t\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\n    21\t\t\t\tt.Fatal(err)\n    22\t\t\t}\n    23\t\t}\n    24\t\tspec := func(limits string) string {\n    25\t\t\treturn \"---\\nslug: limited\\nstatus: draft\\ncreated_at: 2026-11-25\\n---\\n\\n# Spec: limited\\n\\n## 1. Intent\\n\\n### Goal\\nA goal worth stating.\\n\\n## 2. Requirements\\n\\n### Functional\\n- R1: It works.\\n\\n## 3. Technical Plan\\n\\n### Affected areas\\nThe engine.\\n\" + limits + \"\\n## 4. Tasks\\n- [ ] Do it.\\n\"\n    26\t\t}\n    27\t\tpath := filepath.Join(root, \".pose/specs/limited/spec.md\")\n    28\t\trun := func() (int, string) {\n    29\t\t\tvar out, errOut bytes.Buffer\n    30\t\t\tcode := lintOneSpec(path, false, true, &out, &errOut)\n    31\t\t\treturn code, out.String() + errOut.String()\n    32\t\t}\n    33\t\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n\"))\n    34\t\tif code, out := run(); code != 0 {\n    35\t\t\tt.Fatalf(\"a justified limit failed the ready check: %d %s\", code, out)\n    36\t\t}\n    37\t\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape with no reason.\\n\"))\n    38\t\tif code, out := run(); code == 0 || !strings.Contains(out, \"does not say why it is accepted\") {\n    39\t\t\tt.Fatalf(\"an unjustified limit passed: %d %s\", code, out)\n    40\t\t}\n    41\t\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n- L2: another. Accepted because it is rarer.\\n\"))\n    42\t\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited`. L1 is accepted.\\n\")\n    43\t\tif code, out := run(); code == 0 || !strings.Contains(out, \"accepted limit L2 is not named by the ADR\") {\n    44\t\t\tt.Fatalf(\"a limit the ADR omits passed: %d %s\", code, out)\n    45\t\t}\n    46\t}\n","exit_code":0,"status":"completed"}}
