{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_plan.go | sed -n '280,445p'\"","aggregated_output":"   280\t\t\tIndependence: normalizeReviewIndependence(policy.ReviewerIndependence[scope.Kind]),\n   281\t\t}\n   282\t\tif policy.DelegatedReview {\n   283\t\t\tplan.Independence = stricterReviewIndependence(plan.Independence, \"different-actor\")\n   284\t\t\tplan.Explain = append(plan.Explain, \"adopted delegated review requires another vendor or model; a same-model run cannot approve\")\n   285\t\t}\n   286\t\tprofiles := []ReviewProfile{base}\n   287\t\tplan.SelectedProfiles = append(plan.SelectedProfiles, ReviewPlanProfile{Ref: base.Ref(), Category: \"base\", Order: 0, Source: \".pose/review-profiles/\" + base.ID + \".json\", Rationale: \"selected by terminal scope policy\"})\n   288\t\tplan.Explain = append(plan.Explain, \"base profile \"+base.Ref()+\" selected by \"+scope.Kind+\" scope policy\")\n   289\t\n   290\t\tcontext := reviewPlanContext{}\n   291\t\toverlays, selected := []ReviewProfile{}, []reviewOverlaySelection{}\n   292\t\tif policy.SchemaVersion >= ReviewPolicySchemaVersion && policy.ComponentAware {\n   293\t\t\tcontext, err = s.resolveReviewPlanContext(scope)\n   294\t\t\tif err != nil {\n   295\t\t\t\treturn ReviewPlan{}, err\n   296\t\t\t}\n   297\t\t\tplan.Components = context.Components\n   298\t\t\tplan.Warnings = append(plan.Warnings, context.Warnings...)\n   299\t\t\tplan.Blockers = append(plan.Blockers, context.Blockers...)\n   300\t\t\tfor _, message := range append([]string{}, context.Warnings...) {\n   301\t\t\t\tif policy.UnmappedComponentBehavior == \"blocker\" && (strings.HasPrefix(message, \"unmapped review component\") || strings.HasPrefix(message, \"metadata-incomplete review component\")) {\n   302\t\t\t\t\tplan.Blockers = append(plan.Blockers, message)\n   303\t\t\t\t}\n   304\t\t\t}\n   305\t\n   306\t\t\tfor _, overlayRef := range uniqueSorted(policy.OverlayProfiles) {\n   307\t\t\t\toverlay, loadErr := s.loadReviewProfileFrom(profileRevision, overlayRef)\n   308\t\t\t\tif loadErr != nil {\n   309\t\t\t\t\tplan.Blockers = append(plan.Blockers, loadErr.Error())\n   310\t\t\t\t\tcontinue\n   311\t\t\t\t}\n   312\t\t\t\tif overlay.SchemaVersion < ReviewPolicySchemaVersion || !hasReviewSelectors(overlay.Selectors) {\n   313\t\t\t\t\tplan.Blockers = append(plan.Blockers, \"review overlay \"+overlayRef+\" must use schema v2 with typed selectors\")\n   314\t\t\t\t\tcontinue\n   315\t\t\t\t}\n   316\t\t\t\tif overlay.Scope != scope.Kind {\n   317\t\t\t\t\tcontinue\n   318\t\t\t\t}\n   319\t\t\t\t// An overlay adopted after work was under way applies to the work\n   320\t\t\t\t// that starts after it (spec pose-causality-closeout-adoption-cutoff).\n   321\t\t\t\tif date := policy.OverlayAdoptedAt[overlayRef]; s.reviewScopeCreatedBefore(scope, date) {\n   322\t\t\t\t\tplan.Explain = append(plan.Explain, overlayRef+\" not selected: adopted on \"+date+\", after every spec in \"+ref+\" was created\")\n   323\t\t\t\t\tcontinue\n   324\t\t\t\t}\n   325\t\t\t\toverlays = append(overlays, overlay)\n   326\t\t\t}\n   327\t\t\t// Resolved only when something selects on it. A repository that adopted\n   328\t\t\t// no structural profile pays nothing here, not even the Git reads, which\n   329\t\t\t// is what keeps an opt-in contract opt-in in cost as well as in effect.\n   330\t\t\tfor _, overlay := range overlays {\n   331\t\t\t\tif len(overlay.Selectors.StructuralKinds) == 0 {\n   332\t\t\t\t\tcontinue\n   333\t\t\t\t}\n   334\t\t\t\tplan.Structure = s.resolveReviewStructure(scope, context.Components)\n   335\t\t\t\tcontext.StructuralKinds = plan.Structure.Kinds\n   336\t\t\t\tif !plan.Structure.Observed {\n   337\t\t\t\t\tplan.Warnings = append(plan.Warnings, \"structural selectors are adopted but the subject was not observed: \"+firstNonempty(plan.Structure.Reason, \"no reason reported\"))\n   338\t\t\t\t}\n   339\t\t\t\tfor _, unknown := range plan.Structure.Unknown {\n   340\t\t\t\t\tplan.Warnings = append(plan.Warnings, \"unresolved structural coverage \"+unknown)\n   341\t\t\t\t}\n   342\t\t\t\tfor _, fact := range plan.Structure.Material {\n   343\t\t\t\t\tif len(fact.SharedWith) > 0 {\n   344\t\t\t\t\t\tplan.Warnings = append(plan.Warnings, \"structural fact \"+fact.ID+\" on \"+firstNonempty(fact.Path, fact.Subject)+\" comes from a commit also attributed to \"+strings.Join(fact.SharedWith, \", \")+\"; map it if this scope made the change, otherwise answer this fact's mapping not-applicable with the reason\")\n   345\t\t\t\t\t}\n   346\t\t\t\t}\n   347\t\t\t\tbreak\n   348\t\t\t}\n   349\t\t\tselected = selectReviewOverlays(overlays, context)\n   350\t\t\tfor _, item := range selected {\n   351\t\t\t\tprofiles = append(profiles, item.profile)\n   352\t\t\t\tplan.SelectedProfiles = append(plan.SelectedProfiles, item.selection)\n   353\t\t\t\tplan.Explain = append(plan.Explain, item.profile.Ref()+\" selected: \"+item.selection.Rationale)\n   354\t\t\t\tplan.Independence = stricterReviewIndependence(plan.Independence, item.profile.Independence)\n   355\t\t\t}\n   356\t\t}\n   357\t\n   358\t\tplan.Criteria, plan.Blockers = composeReviewCriteria(profiles, plan.Blockers)\n   359\t\tplan.Criteria, plan.Blockers = s.addMilestoneGateCriterion(scope, plan.Criteria, plan.Blockers)\n   360\t\tvar added bool\n   361\t\tplan.Criteria, plan.Blockers, added = addCrossComponentReviewCriterion(plan.Criteria, plan.Blockers, len(plan.Components))\n   362\t\tif added {\n   363\t\t\tplan.Explain = append(plan.Explain, \"cross-component-integration added because multiple mapped component roots are affected\")\n   364\t\t}\n   365\t\tplan.PolicyBaseline.Paths = guard.Paths\n   366\t\tplan.PolicyBaseline.Reason = guard.Reason\n   367\t\tif guard.Unreadable != \"\" {\n   368\t\t\tplan.PolicyBaseline.Weakened = append(plan.PolicyBaseline.Weakened, \"unreadable_tree_contract:\"+guard.Unreadable)\n   369\t\t}\n   370\t\tif len(guard.Paths) > 0 && baseline.Resolved {\n   371\t\t\tapplyProtectedPolicyBaseline(&plan, baseline, policy, scope, context)\n   372\t\t}\n   373\t\tplan.Explain = append(plan.Explain, reviewPolicyBaselineExplain(plan.PolicyBaseline)...)\n   374\t\tif !plan.PolicyBaseline.Protected && len(guard.Paths) > 0 {\n   375\t\t\tplan.Warnings = append(plan.Warnings, \"unprotected review contract change \"+strings.Join(guard.Paths, \",\")+\": \"+firstNonempty(guard.Reason, \"the base contract could not be resolved\"))\n   376\t\t}\n   377\t\tif policy.DelegatedReviewConfigured && !policy.DelegatedReview && plan.Independence == \"different-actor\" && !plan.PolicyBaseline.Protected {\n   378\t\t\tplan.Independence = \"same-actor-separate-execution\"\n   379\t\t\tplan.Limitations = []string{ReviewLimitationDelegationDisabled}\n   380\t\t\tplan.Explain = append(plan.Explain, ReviewLimitationDelegationDisabled+\": explicit refusal allows a separate execution of the same actor; human requirements are unchanged\")\n   381\t\t}\n   382\t\tplan.Tools, plan.Blockers, plan.Warnings = buildReviewTools(scope, context, profiles, plan.SelectedProfiles, plan.Criteria, plan.Blockers, plan.Warnings)\n   383\t\tplan.Warnings = s.annotateReviewToolProducerCoverage(plan.Tools, plan.Warnings)\n   384\t\tfor _, c := range plan.Criteria {\n   385\t\t\tfor _, rule := range c.Rules {\n   386\t\t\t\tpath := filepath.Join(s.Root, \".pose\", \"rules\", rule+\".md\")\n   387\t\t\t\tif _, statErr := s.fsys().Stat(path); statErr != nil {\n   388\t\t\t\t\tplan.Warnings = append(plan.Warnings, fmt.Sprintf(\"uninstalled review rule %q for criterion %s (install via extension)\", rule, c.ID))\n   389\t\t\t\t}\n   390\t\t\t}\n   391\t\t}\n   392\t\tplan.Warnings = uniqueSorted(plan.Warnings)\n   393\t\tplan.Blockers = uniqueSorted(plan.Blockers)\n   394\t\tplan.Explain = uniqueStable(plan.Explain)\n   395\t\tfloor := normalizeReviewIndependence(policy.ReviewerIndependence[scope.Kind])\n   396\t\tplan.Bands, plan.Band = deriveReviewBands(plan, scope.Kind, floor, selected, undecidableReviewOverlays(overlays, selected), context)\n   397\t\tif band, ok := reviewPolicyBaselineBand(plan.PolicyBaseline); ok {\n   398\t\t\tplan.Bands = append(plan.Bands, band)\n   399\t\t\tif reviewBandRank[band.Band] > reviewBandRank[plan.Band] {\n   400\t\t\t\tplan.Band = band.Band\n   401\t\t\t}\n   402\t\t}\n   403\t\tplan.Projection = projectDeclaredReviewObligations(plan, scope, base, floor, overlays, context)\n   404\t\tplan.AcceptedLimits = s.acceptedLimitsOf(scope)\n   405\t\tplan.PlanDigest, err = digestReviewPlan(plan)\n   406\t\tif err != nil {\n   407\t\t\treturn ReviewPlan{}, err\n   408\t\t}\n   409\t\t// Warnings and Explain enter the digest; the decision does not, so it is\n   410\t\t// attached only as its own field. A gate that cannot answer (a corrupt or\n   411\t\t// drifted receipt) fails the plan as it fails closeout-check.\n   412\t\tif !s.planWithoutCloseoutGate {\n   413\t\t\tdecision, _, gateErr := s.closeoutReviewGate(ref, policy)\n   414\t\t\tif gateErr != nil {\n   415\t\t\t\treturn ReviewPlan{}, gateErr\n   416\t\t\t}\n   417\t\t\tplan.CloseoutReview = decision\n   418\t\t}\n   419\t\treturn plan, nil\n   420\t}\n   421\t\n   422\tfunc (s Store) resolveReviewPlanContext(scope ScopeRef) (reviewPlanContext, error) {\n   423\t\t// One generation for the whole plan: the component map and the observed\n   424\t\t// paths are read from the same set, even if a publication commits meanwhile.\n   425\t\tif s.indexPin == nil {\n   426\t\t\ts = s.PinIndexes()\n   427\t\t}\n   428\t\tcontext := reviewPlanContext{Components: []ReviewPlanComponent{}, DeliveryKinds: []string{}, ArtifactPaths: []string{}, SpecSlugs: []string{}}\n   429\t\tspecs, err := s.reviewScopeSpecs(scope)\n   430\t\tif err != nil {\n   431\t\t\treturn context, err\n   432\t\t}\n   433\t\tentries, err := s.loadReviewRepoEntries()\n   434\t\tif err != nil {\n   435\t\t\tcontext.Blockers = append(context.Blockers, err.Error())\n   436\t\t}\n   437\t\tbyPath := map[string]ReviewPlanComponent{}\n   438\t\tunmapped := map[string]bool{}\n   439\t\taddEntry := func(entry reviewRepoEntry, source string) {\n   440\t\t\tpath := filepath.ToSlash(filepath.Clean(entry.Path))\n   441\t\t\tcomponent := byPath[path]\n   442\t\t\tcomponent.ID, component.Path, component.Kind, component.Language = entry.Name, path, entry.Kind, entry.Language\n   443\t\t\tcomponent.Owner, component.Domain, component.Criticality = firstNonempty(entry.Owner, entry.Metadata.Owner), firstNonempty(entry.Domain, entry.Metadata.Domain), firstNonempty(entry.Criticality, entry.Metadata.Criticality)\n   444\t\t\tcomponent.ValidationProfile = firstNonempty(entry.ValidationProfile, entry.Metadata.ValidationProfile)\n   445\t\t\tcomponent.MetadataStatus = entry.MetadataStatus.Source\n","exit_code":0,"status":"completed"}}
