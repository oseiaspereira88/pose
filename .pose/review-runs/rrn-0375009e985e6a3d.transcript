test.go:542:\t\tf.write(\"a/nested/go.mod\", \"module nested\\n\")\npose-mcp/internal/cli/validate_carry_test.go:543:\t\tf.commit(\"nested module\")\npose-mcp/internal/cli/validate_carry_test.go:544:\t\tf.write(\"a/nested/changed.go\", \"package nested\\n\")\npose-mcp/internal/cli/validate_carry_test.go:545:\t\tf.commit(\"change nested\")\npose-mcp/internal/cli/validate_carry_test.go:630:\tf.write(\"a/nested/go.mod\", \"module nested\\n\")\npose-mcp/internal/cli/validate_carry_test.go:631:\tf.commit(\"nested module\")\npose-mcp/internal/cli/validate_carry_test.go:632:\tf.write(\"a/nested/input.txt\", \"x\\n\")\npose-mcp/internal/cli/validate_carry_test.go:633:\tf.commit(\"change nested\")\npose-mcp/internal/cli/validate_carry_test.go:635:\tif !strings.Contains(out, \"+ b: declared dependency a changed: a/nested/input.txt\") {\npose-mcp/internal/cli/validate_carry_test.go:641:\tg.commit(\"root module\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"metadata\") {\n\t\tt.Fatalf(\"carry = %+v, want a full run over undecodable metadata\", run.Carry)\n\t}\n\tif code, out := runValidate(t, f.root, \"--changed-from\", \"HEAD~1\"); code != 2 || !strings.Contains(out, \"metadata\") {\n\t\tt.Fatalf(\"--changed-from over undecodable metadata: exit=%d %s\", code, out)\n\t}\n}\n\n// A gitlink above a declared dependency changes what lies under it. The\n// selection is shared by --changed-from and --carry.\nfunc TestChangedScopeGitlinkAboveADependencySelectsItsDependents(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"a\":{\"selfContained\":true},\"b\":{\"selfContained\":true,\"dependsOn\":[\"vendor/lib\"]}}}`)\n\tfirst := f.git(\"rev-parse\", \"HEAD\")\n\tf.git(\"update-index\", \"--add\", \"--cacheinfo\", \"160000,\"+first+\",vendor\")\n\tf.git(\"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-qm\", \"gitlink\")\n\tsecond := f.git(\"rev-parse\", \"HEAD\")\n\tf.git(\"update-index\", \"--add\", \"--cacheinfo\", \"160000,\"+second+\",vendor\")\n\tf.git(\"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-qm\", \"move the gitlink\")\n\t_, out := runValidate(t, f.root, \"--changed-from\", \"HEAD~1\", \"--changed-to\", \"HEAD\", \"--explain\")\n\tif !strings.Contains(out, \"+ b: declared dependency vendor/lib changed: vendor\") || !strings.Contains(out, \"- a: not affected\") {\n\t\tt.Fatalf(\"a gitlink above b's dependency must select b and leave a: %s\", out)\n\t}\n}\n\n// A dependency beneath a surviving module keeps its dependents selected after\n// it is deleted (review round 4, N7).\nfunc TestCarryDeletedNestedDependencySelectsItsDependents(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"a/nested\"]}}}`)\n\tf.write(\"a/nested/go.mod\", \"module nested\\n\")\n\tf.commit(\"nested module\")\n\tf.baseline()\n\tf.git(\"rm\", \"-rq\", \"a/nested\")\n\tf.commit(\"delete the nested dependency\")\n\t_, _, run := f.validate(\"--carry\")\n\tif !strings.Contains(run.Carry.Selected[\"b\"], \"a/nested\") {\n\t\tt.Fatalf(\"selected = %v, want b selected by its deleted nested dependency\", run.Carry.Selected)\n\t}\n}\n\n// A dependency on the project root is changed by any file once the root\n// module is gone (review round 4, N8).\nfunc TestCarryRootDependencyIsChangedByRootFiles(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"a\":{\"selfContained\":true},\"b\":{\"selfContained\":true,\"dependsOn\":[\".\"]}}}`)\n\tf.baseline()\n\tf.write(\"root.txt\", \"edited\\n\")\n\tf.commit(\"root change\")\n\t_, _, run := f.validate(\"--carry\")\n\tif _, ok := run.Carry.Selected[\"b\"]; !ok {\n\t\tt.Fatalf(\"selected = %v, want b selected through its root dependency\", run.Carry.Selected)\n\t}\n\tif _, ok := run.Carry.Selected[\"a\"]; ok {\n\t\tt.Fatalf(\"selected = %v, want a carried\", run.Carry.Selected)\n\t}\n}\n\n// A module reached through a symlink is never carried (review round 4, N9).\nfunc TestCarryRefusesModulesReachedThroughASymlink(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tif err := os.Symlink(\"a\", filepath.Join(f.root, \"alias\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\"`, `\"moduleOverrides\":{\"alias\":{\"stack\":\"go\"}},\"stacks\"`, 1))\n\tf.commit(\"alias\")\n\tf.baseline()\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"change a\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"symlink\") {\n\t\tt.Fatalf(\"carry = %+v, want an aliased module refused\", run.Carry)\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n)\n\n// Spec pose-spec-facts-evidence-binding: the facts and the attribution of change sets read the\n// trailers of the history in one way.\n\n// SpecTrailerLogArgs are the arguments of the `git log` whose output ParseSpecTrailerLog reads:\n// every ref, oldest first, the commits that mention a POSE-Spec trailer, hash and full body.\nvar SpecTrailerLogArgs = []string{\"log\", \"--all\", \"--reverse\", \"--grep=POSE-Spec:\", \"--format=%H%x00%B%x00\"}\n\n// ParseSpecTrailerLog maps each spec slug to the commits that carry its trailer. A trailer is a\n// line of the body that starts with `POSE-Spec:` after trimming; the slug is the rest of the\n// line, trimmed. It does not use Git's trailer parser.\n// SpecTrailerLogEntry is one commit of the trailer log, in log order, with\n// the slug of each POSE-Spec line it carries (repeated if the line repeats).\ntype SpecTrailerLogEntry struct {\n\tSHA   string\n\tSpecs []string\n}\n\n// ParseSpecTrailerLogOrdered is ParseSpecTrailerLog keeping the log order:\n// every spec's commit list is the subsequence of these entries that names it\n// (spec pose-index-streams-each-commit-once).\nfunc ParseSpecTrailerLogOrdered(out []byte) []SpecTrailerLogEntry {\n\tparts := bytes.Split(out, []byte{0})\n\tentries := []SpecTrailerLogEntry{}\n\tfor i := 0; i+1 < len(parts); i += 2 {\n\t\tentry := SpecTrailerLogEntry{SHA: strings.TrimSpace(string(parts[i]))}\n\t\tfor _, line := range strings.Split(string(parts[i+1]), \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif strings.HasPrefix(line, \"POSE-Spec:\") {\n\t\t\t\tif spec := strings.TrimSpace(strings.TrimPrefix(line, \"POSE-Spec:\")); spec != \"\" {\n\t\t\t\t\tentry.Specs = append(entry.Specs, spec)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif len(entry.Specs) > 0 {\n\t\t\tentries = append(entries, entry)\n\t\t}\n\t}\n\treturn entries\n}\n\nfunc ParseSpecTrailerLog(out []byte) map[string][]string {\n\tparts := bytes.Split(out, []byte{0})\n\tspecCommits := map[string][]string{}\n\tfor i := 0; i+1 < len(parts); i += 2 {\n\t\tsha, body := strings.TrimSpace(string(parts[i])), string(parts[i+1])\n\t\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif strings.HasPrefix(line, \"POSE-Spec:\") {\n\t\t\t\tspec := strings.TrimSpace(strings.TrimPrefix(line, \"POSE-Spec:\"))\n\t\t\t\tif spec != \"\" {\n\t\t\t\t\tspecCommits[spec] = append(specCommits[spec], sha)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn specCommits\n}\n\n// RawHistoryGit is a git command on root's raw object history: replace refs\n// (--no-replace-objects) and grafts (GIT_GRAFT_FILE at the always-empty null\n// device, which overrides both the repository's graft file and one the\n// environment names) never change which commits carry a trailer, what a change\n// set holds, or what a later removal is judged on (spec\n// pose-delivery-later-removal R3, review round 4 LR-R4-01).\nfunc RawHistoryGit(root string, args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// RawHistoryGitContext is RawHistoryGit under ctx.\nfunc RawHistoryGitContext(ctx context.Context, root string, args ...string) *exec.Cmd {\n\treturn gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// GitHooksDir is the directory git runs the hooks of root from: a linked worktree shares the\n// one of its common directory, and core.hooksPath moves it. Where git cannot answer it is\n// `.git/hooks`, which is where a repository would keep them.\nfunc GitHooksDir(root string) string {\n\tout, err := RawHistoryGit(root, \"rev-parse\", \"--git-path\", \"hooks\").Output()\n\tif err != nil {\n\t\treturn filepath.Join(root, \".git\", \"hooks\")\n\t}\n\tdir := strings.TrimSuffix(string(out), \"\\n\")\n\tif filepath.IsAbs(dir) {\n\t\treturn dir\n\t}\n\treturn filepath.Join(root, dir)\n}\n\n// RawGit is RawHistoryGit for a caller whose arguments already say where to read.\nfunc RawGit(args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\"}, args...)...)\n}\n\n// SpecTrailerCommits reads the history of root and returns the commits that carry the trailer of\n// slug, the way the attribution of change sets does. An error is a history that could not be\n// read, which is not a history without commits.\nfunc SpecTrailerCommits(root, slug string) ([]string, error) {\n\tout, err := RawHistoryGit(root, SpecTrailerLogArgs...).Output()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn ParseSpecTrailerLog(out)[slug], nil\n}\npose-mcp/internal/cli/validation_matrix_patterns_test.go:220:// TestMain(*testing.M) is the hook, not a test.\npose-mcp/internal/cli/validation_matrix_patterns_test.go:247:\t\t\t\tif n == \"TestMain\" && isTestFunc(fn, \"M\") {\npose-mcp/internal/cli/validation_matrix_patterns_test.go:464:\twrite(\"m/d/d_test.go\", \"package d\\n\\nimport . \\\"testing\\\"\\n\\nfunc TestDot(t *T) {}\\nfunc TestEmpty(t *T) () {}\\nfunc TestMain(t *T) {}\\nfunc Example_lower() {\\n\\t// output:\\n}\\n\")\npose-mcp/internal/cli/validation_matrix_patterns_test.go:465:\twrite(\"m/h/h_test.go\", \"package h\\n\\nimport \\\"testing\\\"\\n\\nfunc TestMain(m *testing.M) {}\\n\")\npose-mcp/internal/cli/validation_matrix_patterns_test.go:498:\t\t{\"dot-imported T, empty results, TestMain as a test, lower-case output\", `\"./d\", \"-run\", \"TestDot|TestEmpty|TestMain|Example_lower\"`, false, \"\"},\npose-mcp/internal/cli/validation_matrix_patterns_test.go:499:\t\t{\"TestMain hook is not a test\", `\"./h\", \"-run\", \"TestMain\"`, true, \"\"},\npose-mcp/internal/cli/validate_results_test.go:54:func runValidate(t *testing.T, root string, args ...string) (int, string) {\npose-mcp/internal/cli/cli_test.go:18:func TestMain(m *testing.M) {\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'dependsOn|selfContained' pose-mcp/internal/cli/check* pose-mcp/internal/pose/*metadata* .pose/templates/module-metadata* .pose/indexes/module-metadata.json; sed -n '1,65p' pose-mcp/internal/cli/cli_test.go; sed -n '1,65p' pose-mcp/internal/cli/validate_results_test.go; sed -n '520,565p' pose-mcp/internal/cli/validate_carry_test.go; ps -eo pid,etime,args | rg 'pose validate|pose artifact|go test'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'dependsOn|selfContained' pose-mcp/internal/cli/check* pose-mcp/internal/pose/*metadata* .pose/templates/module-metadata* .pose/indexes/module-metadata.json; sed -n '1,65p' pose-mcp/internal/cli/cli_test.go; sed -n '1,65p' pose-mcp/internal/cli/validate_results_test.go; sed -n '520,565p' pose-mcp/internal/cli/validate_carry_test.go; ps -eo pid,etime,args | rg 'pose validate|pose artifact|go test'\"","aggregated_output":"rg: pose-mcp/internal/pose/*metadata*: No such file or directory (os error 2)\nrg: .pose/templates/module-metadata*: No such file or directory (os error 2)\npose-mcp/internal/cli/check.go:701:\tslug, status, dependsOn, path string\npose-mcp/internal/cli/check.go:728:\t\tspecs[sp.Slug] = checkSpec{slug: sp.Slug, status: sp.Status, dependsOn: strings.Join(sp.DependsOn, \",\"), path: sp.Path, priority: priority}\npose-mcp/internal/cli/check.go:733:\t\tfor _, ref := range splitInlineList(spec.dependsOn) {\npose-mcp/internal/cli/check.go:813:\tdependsOn    []string\npose-mcp/internal/cli/check.go:819:\troadmap := checkRoadmap{slug: fields[\"slug\"], status: fields[\"status\"], dependsOn: splitInlineList(fields[\"depends_on\"])}\npose-mcp/internal/cli/check.go:899:\t\tfor _, dep := range rm.dependsOn {\npose-mcp/internal/cli/check.go:968:\t\t\tfor _, ref := range splitInlineList(spec.dependsOn) {\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/testgit\"\n)\n\nfunc TestMain(m *testing.M) {\n\tif posemodel.EngineVersion == \"unknown\" {\n\t\tposemodel.EngineVersion = \"pose-test-engine\"\n\t}\n\t_ = os.Setenv(\"POSE_USAGE_DISABLED\", \"1\")\n\t// A bundle sealed here must not record the agent running the suite as its\n\t// implementation (spec pose-delegation-routing R2).\n\tfor _, name := range posemodel.DelegationSessionVariables() {\n\t\t_ = os.Unsetenv(name)\n\t}\n\t// A detached run started in this process would run the test binary as\n\t// its supervisor; the detach tests run the built pose command instead.\n\tdelegateExecutable = func() (string, error) {\n\t\treturn \"\", fmt.Errorf(\"tests start detached runs through the built pose command (poseBinary)\")\n\t}\n\tcleanup, err := testgit.Isolate()\n\tif err != nil {\n\t\tpanic(err)\n\t}\n\tcode := m.Run()\n\t// The pose command the detach tests built is removed with the run.\n\tif builtPose != \"\" {\n\t\t_ = os.RemoveAll(filepath.Dir(builtPose))\n\t}\n\tcleanup()\n\tos.Exit(code)\n}\n\n// newGitRepo creates a temp dir initialized as a git repository and returns\n// its path. Tests chdir into it so projectRoot() resolves there.\nfunc newGitRepo(t *testing.T) string {\n\tt.Helper()\n\tdir := t.TempDir()\n\tif out, err := exec.Command(\"git\", \"-C\", dir, \"init\", \"-q\").CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git init: %v: %s\", err, out)\n\t}\n\treturn dir\n}\n\nfunc inDir(t *testing.T, dir string, fn func()) {\n\tt.Helper()\n\told, err := os.Getwd()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Chdir(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\npackage cli\n\n// Structured result contract behavior (spec pose-structured-validation-results):\n// canonical JSON with stable IDs and distinguishable outcomes, JUnit/SARIF\n// projections, deterministic skip reasons, bounded capture and redaction.\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"encoding/xml\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\n// resultFixture builds a project whose matrix exercises pass, fail, infra\n// error, skip and secret redaction in one deterministic run.\nfunc resultFixture(t *testing.T) string {\n\tt.Helper()\n\troot := t.TempDir()\n\twrite := func(rel, content string) {\n\t\tpath := filepath.Join(root, rel)\n\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\twrite(\"mod/go.mod\", \"module fixture\\n\")\n\tmatrix := map[string]any{\n\t\t\"defaults\": map[string]any{\"mode\": \"strict\"},\n\t\t\"stacks\": map[string]any{\n\t\t\t\"go\": map[string]any{\"checks\": []map[string]any{\n\t\t\t\t{\"name\": \"ok\", \"program\": \"true\", \"severity\": \"required\"},\n\t\t\t\t{\"name\": \"leaky\", \"program\": \"env\", \"severity\": \"optional\",\n\t\t\t\t\t\"env\": map[string]string{\"MY_API_TOKEN\": \"hush123\", \"PLAIN\": \"visible\"}},\n\t\t\t\t{\"name\": \"broken\", \"program\": \"definitely-missing-binary-xyz\", \"severity\": \"optional\"},\n\t\t\t\t{\"name\": \"conditional\", \"program\": \"true\", \"severity\": \"required\",\n\t\t\t\t\t\"when\": map[string]string{\"fileExists\": \"nope.txt\"}},\n\t\t\t}},\n\t\t},\n\t}\n\traw, _ := json.Marshal(matrix)\n\twrite(\".pose/indexes/validation-matrix.json\", string(raw))\n\treturn root\n}\n\nfunc runValidate(t *testing.T, root string, args ...string) (int, string) {\n\tt.Helper()\n\tvar out, errB bytes.Buffer\n\tcode := cmdValidate(root, args, &out, &errB)\n\treturn code, out.String() + errB.String()\n}\n\nfunc loadRun(t *testing.T, root string) validationRunResult {\n\tt.Helper()\n\traw, err := os.ReadFile(filepath.Join(root, \"result.json\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t\tt.Fatalf(\"carry = %+v, want an aliased module refused\", run.Carry)\n\t}\n}\n\n// A run whose HEAD moved while checks ran did not validate its recorded head\n// (review round 4, N10).\nfunc TestValidateHeadMovingDuringTheRunIsNotClean(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\tcommit := `git -C .. -c user.name=t -c user.email=t@t -c core.hooksPath=/dev/null commit -q --allow-empty -m moved`\n\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\":{\"go\":{\"checks\":[`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"moves\",\"program\":\"sh\",\"args\":[\"-c\",\"`+commit+`\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\":{\"go\":{\"checks\":[`, 1))\n\tf.commit(\"a check that commits\")\n\t_, out, run := f.validate()\n\tif run.MaterialClean {\n\t\tt.Fatalf(\"material_clean = true although HEAD moved during the run: %s\", out)\n\t}\n}\n\n// Every eligible dependency counts, whatever its order (review round 5, N11).\nfunc TestChangedScopeEvaluatesEveryDeclaredDependency(t *testing.T) {\n\tfor _, deps := range []string{`[\"a\",\".\"]`, `[\".\",\"a\"]`} {\n\t\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":`+deps+`}}}`)\n\t\tf.write(\"a/nested/go.mod\", \"module nested\\n\")\n\t\tf.commit(\"nested module\")\n\t\tf.write(\"a/nested/changed.go\", \"package nested\\n\")\n\t\tf.commit(\"change nested\")\n\t\t_, out := runValidate(t, f.root, \"--changed-from\", \"HEAD~1\", \"--changed-to\", \"HEAD\", \"--explain\")\n\t\tif !strings.Contains(out, \"+ b: declared dependency \") {\n\t\t\tt.Fatalf(\"dependsOn %s: b must be selected whatever the order: %s\", deps, out)\n\t\t}\n\t}\n}\n\n// A run whose HEAD moved binds no material (review round 5, N12).\nfunc TestValidateHeadMovingDuringTheRunBindsNoMaterial(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.write(\".pose/specs/2026-11-23-carry-fixture.md\", \"---\\nslug: carry-fixture\\nstatus: in-progress\\ncreated_at: 2026-11-23\\n---\\n\\n# Spec: carry-fixture\\n\\n## 3. Technical Plan\\n\\n### Artifacts\\n- created: a/feature.go\\n\")\n\tf.write(\"a/feature.go\", \"package a\\n\")\n\tf.git(\"add\", \"-A\")\n\tf.git(\"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-qm\", \"feature\\n\\nPOSE-Spec: carry-fixture\")\n\tif _, out, run := f.validate(); len(run.MaterialProvenance) == 0 {\n\t\tt.Fatalf(\"the fixture must bind material for this test to mean anything: %s\", out)\n\t}\n\tf.commit(\"record\")\n\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\tcommit := `git -C .. -c user.name=t -c user.email=t@t -c core.hooksPath=/dev/null commit -q --allow-empty -m moved`\n      1       00:00 codex-linux-sandbox --sandbox-policy-cwd /var/tmp/pose-work-go/pose-review-run-710645564/worktree --command-cwd /var/tmp/pose-work-go/pose-review-run-710645564/worktree --permission-profile {\"type\":\"managed\",\"file_system\":{\"type\":\"restricted\",\"entries\":[{\"path\":{\"type\":\"special\",\"value\":{\"kind\":\"root\"}},\"access\":\"read\"}]},\"network\":\"restricted\"} --apply-seccomp-then-exec -- /usr/bin/bash -c __CODEX_SNAPSHOT_OVERRIDE_SET_0=\"${CODEX_APPLY_PATCH_PRESERVE_LINE_ENDINGS+x}\" __CODEX_SNAPSHOT_OVERRIDE_0=\"${CODEX_APPLY_PATCH_PRESERVE_LINE_ENDINGS-}\" __CODEX_SNAPSHOT_OVERRIDE_SET_1=\"${CODEX_PERMISSION_PROFILE+x}\" __CODEX_SNAPSHOT_OVERRIDE_1=\"${CODEX_PERMISSION_PROFILE-}\" __CODEX_SNAPSHOT_OVERRIDE_SET_2=\"${CODEX_PLUGIN_METRICS_OUTPUT+x}\" __CODEX_SNAPSHOT_OVERRIDE_2=\"${CODEX_PLUGIN_METRICS_OUTPUT-}\" __CODEX_SNAPSHOT_OVERRIDE_SET_3=\"${CODEX_SESSION_ID+x}\" __CODEX_SNAPSHOT_OVERRIDE_3=\"${CODEX_SESSION_ID-}\" __CODEX_SNAPSHOT_OVERRIDE_SET_4=\"${CODEX_THREAD_ID+x}\" __CODEX_SNAPSHOT_OVERRIDE_4=\"${CODEX_THREAD_ID-}\" __CODEX_SNAPSHOT_OVERRIDE_SET_5=\"${CODEX_TOOL_CALL_ID+x}\" __CODEX_SNAPSHOT_OVERRIDE_5=\"${CODEX_TOOL_CALL_ID-}\" __CODEX_SNAPSHOT_OVERRIDE_SET_6=\"${CODEX_VERSION+x}\" __CODEX_SNAPSHOT_OVERRIDE_6=\"${CODEX_VERSION-}\" __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_0=\"${ALL_PROXY+x}\" __CODEX_SNAPSHOT_PROXY_OVERRIDE_0=\"${ALL_PROXY-}\" __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_1=\"${BUNDLE_HTTPS_PROXY+x}\" __CODEX_SNAPSHOT_PROXY_OVERRIDE_1=\"${BUNDLE_HTTPS_PROXY-}\" __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_2=\"${BUNDLE_HTTP_PROXY+x}\" __CODEX_SNAPSHO