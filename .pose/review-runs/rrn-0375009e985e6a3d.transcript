iles posemodel.Files, root string) ([]validationModule, error) {\npose-mcp/internal/cli/validate.go:732:// discoverValidationModules reads and writes the filesystem directly; discoverValidationModulesIn takes the\npose-mcp/internal/cli/validate.go:734:func discoverValidationModules(root string) ([]validationModule, error) {\npose-mcp/internal/cli/validate.go:735:\treturn discoverValidationModulesIn(posemodel.NativeFiles(), root)\npose-mcp/internal/cli/validate.go:814:\t\tif err := validate(\"moduleOverrides.\"+name, override.Checks); err != nil {\npose-mcp/internal/cli/validate.go:832:\t\t\t\treturn fmt.Errorf(\"moduleOverrides.%s check %s has unknown evidenceClass %q\", scope, check.Name, check.EvidenceClass)\npose-mcp/internal/cli/validate.go:1068:\tmodules, err := discoverValidationModules(root)\npose-mcp/internal/cli/validate.go:1088:\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: moduleOverrides contains a path outside the project: %s\\n\", \"Erro: moduleOverrides contém path fora do projeto: %s\\n\"), rel)\npose-mcp/internal/cli/validate.go:1152:\tstartedClean := materialWorktreeClean(root)\npose-mcp/internal/cli/validate.go:1185:\t\tclean := materialWorktreeClean(root)\npose-mcp/internal/cli/validate.go:1425:\tendedClean := materialTrackedUnchanged(root)\npose-mcp/internal/cli/validate.go:1488:\t\t\"json\":  {jsonOut, writeValidationJSON},\npose-mcp/internal/cli/validate.go:1489:\t\t\"junit\": {junitOut, writeValidationJUnit},\npose-mcp/internal/cli/validate.go:1490:\t\t\"sarif\": {sarifOut, writeValidationSARIF},\npose-mcp/internal/cli/validate.go:1693:// materialWorktreeClean reports whether the working copy equals HEAD in every\npose-mcp/internal/cli/validate.go:1696:func materialWorktreeClean(root string) bool {\npose-mcp/internal/cli/validate.go:1717:\t\t\tif !posemodel.IsAdministrativePath(p) {\npose-mcp/internal/cli/validate.go:1726:// materialTrackedUnchanged reports whether no tracked file differs from HEAD\npose-mcp/internal/cli/validate.go:1729:func materialTrackedUnchanged(root string) bool {\npose-mcp/internal/cli/validate.go:1749:\t\t\tif !posemodel.IsAdministrativePath(p) {\npose-mcp/internal/cli/validate_results.go:198:func writeValidationJSON(path string, run validationRunResult) error {\npose-mcp/internal/cli/validate_results.go:299:func writeValidationJUnit(path string, run validationRunResult) error {\npose-mcp/internal/cli/validate_results.go:346:func writeValidationSARIF(path string, run validationRunResult) error {\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Documentation Style\n\n## When to consult\n\nConsult this guide for process documentation, rules, specs, workflows, and operational instructions.\n\n## Required conventions\n\n- Write instructions in the imperative mood and begin them with action verbs.\n- Keep bullets short and limited to one idea.\n- Avoid duplicating sections with the same purpose across files.\n- Link to the single source of truth instead of copying its content.\n- Use `check`, `spec`, and `workflow` consistently.\n- State each instruction's scope explicitly to reduce ambiguity.\n\n## Examples: good and bad\n\n### Redundancy\n\n- **Good:** \"Update review criteria in `.pose/workflows/review.md` and reference that workflow from the root AGENTS file.\"\n- **Bad:** \"Repeat review criteria in AGENTS, the workflow, and every related spec.\"\n\n### Ambiguous reference\n\n- **Good:** \"Run the lint check described by the review workflow.\"\n- **Bad:** \"Run that standard validation before pushing.\"\n\n## Quick editorial checklist\n\n- Language is imperative and direct.\n- Bullets are short and non-overlapping.\n- Files do not duplicate sections.\n- `check`, `spec`, and `workflow` are used consistently.\n- References point to explicit files or paths.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n.pose/knowledge/2026-10-27-handoff-delegation-mcp-round5.md\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md\n.pose/knowledge/2026-08-14-decision-log-escalation-validate-native.md\n.pose/knowledge/archive/2026-09-24-handoff-multirepo-review-continuation.md\n.pose/knowledge/2026-10-13-decision-log-action-answer-proof-and-historical-time.md\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md\n.pose/knowledge/2026-10-20-handoff-pose-b07-implementation.md\n.pose/knowledge/2026-11-02-handoff-roadmap-v7-independent-outcomes-20261102.md\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md\n.pose/knowledge/2026-10-13-decision-log-review-assurance-requires-cryptographic-proof.md\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md\n","exit_code":0,"status":"completed"}}
