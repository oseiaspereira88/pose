{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1040,1145p' pose-mcp/internal/cli/validate.go; sed -n '1470,1520p' pose-mcp/internal/cli/validate.go; sed -n '1690,1770p' pose-mcp/internal/cli/validate.go; sed -n '190,220p' pose-mcp/internal/cli/validate_results.go; cat pose-mcp/internal/pose/material_binding.go; sed -n '620,800p' pose-mcp/internal/cli/validate_carry_test.go; rg -n 'func moduleValidationChecks' pose-mcp/internal/cli/*; cat pose-mcp/internal/cli/validate_engine_identity_test.go\"","aggregated_output":"\traw, err := os.ReadFile(matrixPath)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: validation matrix not found at %s\\n\", \"Erro: matriz de validação não encontrada em %s\\n\"), matrixPath)\n\t\treturn 2\n\t}\n\tmatrix, err := parseValidationMatrix(raw)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid validation matrix: %v\\n\", \"Erro: matriz de validação inválida: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif err := validateStructuredMatrixPaths(matrix); err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid validation matrix path: %v\\n\", \"Erro: path inválido na matriz de validação: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif err := validateDeliveryMatrixContract(matrix); err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid delivery validation contract: %v\\n\", \"Erro: contrato de validação de delivery inválido: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif matrixHasLegacyChecks(matrix) {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: legacy shell 'command' checks are unsupported; migrate each check to program + args + env.\", \"Erro: checks shell legados em 'command' não são suportados; migre cada check para program + args + env.\"))\n\t\treturn 2\n\t}\n\tif mode == \"\" {\n\t\tmode = matrix.Defaults.Mode\n\t\tif mode == \"\" {\n\t\t\tmode = \"strict\"\n\t\t}\n\t}\n\tmodules, err := discoverValidationModules(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: discovering modules: %v\\n\", \"Erro: descobrir módulos: %v\\n\"), err)\n\t\treturn 1\n\t}\n\tif workspaceFilter != \"\" {\n\t\tresolved, ok := resolveWorkspaceModulePath(root, modules, workspaceFilter)\n\t\tif !ok {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: no module's manifest name matches --workspace %q.\\n\", \"Erro: nenhum module tem name de manifesto igual a --workspace %q.\\n\"), workspaceFilter)\n\t\t\treturn 2\n\t\t}\n\t\tmoduleFilter = resolved\n\t}\n\tknownModules := map[string]bool{}\n\tfor _, module := range modules {\n\t\tknownModules[module.Rel] = true\n\t}\n\tfor rel, override := range matrix.ModuleOverrides {\n\t\tclean := filepath.ToSlash(filepath.Clean(rel))\n\t\tif clean == \"..\" || strings.HasPrefix(clean, \"../\") || filepath.IsAbs(rel) {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: moduleOverrides contains a path outside the project: %s\\n\", \"Erro: moduleOverrides contém path fora do projeto: %s\\n\"), rel)\n\t\t\treturn 2\n\t\t}\n\t\tif knownModules[clean] {\n\t\t\tif override.Stack != \"\" {\n\t\t\t\tfor idx := range modules {\n\t\t\t\t\tif modules[idx].Rel == clean {\n\t\t\t\t\t\tmodules[idx].Stack = override.Stack\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tabs := filepath.Join(root, filepath.FromSlash(clean))\n\t\tif info, err := os.Stat(abs); err == nil && info.IsDir() {\n\t\t\tstack := override.Stack\n\t\t\tif stack == \"\" {\n\t\t\t\tstack = \"contract\"\n\t\t\t}\n\t\t\tmodules = append(modules, validationModule{Rel: clean, Abs: abs, Stack: stack})\n\t\t\tknownModules[clean] = true\n\t\t}\n\t}\n\tsort.Slice(modules, func(i, j int) bool { return modules[i].Rel < modules[j].Rel })\n\tvar scope *scopeSelection\n\tif changedTo != \"\" && changedFrom == \"\" {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --changed-to requires --changed-from.\", \"Erro: --changed-to exige --changed-from.\"))\n\t\treturn 2\n\t}\n\tif changedFrom != \"\" {\n\t\tsel, err := computeChangedScope(root, changedFrom, changedTo, modules)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: changed-scope selection: %v\\n\", \"Erro: seleção por escopo alterado: %v\\n\"), err)\n\t\t\treturn 2\n\t\t}\n\t\tscope = &sel\n\t\tif explain {\n\t\t\tfmt.Fprintf(stdout, \"[changed-scope] %s: %d changed file(s), %d/%d module(s) selected\\n\", sel.rangeLabel(), len(sel.Changed), len(sel.Selected), len(modules))\n\t\t\tfor _, m := range modules {\n\t\t\t\tif reason, ok := sel.Selected[m.Rel]; ok {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  + %s: %s\\n\", m.Rel, reason)\n\t\t\t\t} else {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  - %s: not affected by %s\\n\", m.Rel, sel.rangeLabel())\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\trun := validationRunResult{\n\t\tSchemaVersion: validationResultSchema,\n\t\tGeneratedAt:   time.Now().UTC().Format(time.RFC3339),\n\t\tMode:          mode,\n\t\tStackFilter:   stackFilter,\n\t\tModuleFilter:  moduleFilter,\n\t\tChecks:        []checkResult{},\n\t}\n\tmatrixDigest := sha256.Sum256(raw)\n\trun.MatrixSHA256 = \"sha256:\" + hex.EncodeToString(matrixDigest[:])\n\trun.EngineVersion = validationEngineIdentity()\n\t}\n\trun.Outcome = result\n\tusageFindings := make([]usageFinding, 0, run.Counts.Failed+run.Counts.OptionalFailed+run.Counts.Errored)\n\tfor _, check := range run.Checks {\n\t\tif check.Outcome != \"fail\" && check.Outcome != \"error\" {\n\t\t\tcontinue\n\t\t}\n\t\tseverity := check.Severity\n\t\tif check.Outcome == \"error\" {\n\t\t\tseverity = \"error\"\n\t\t}\n\t\tusageFindings = append(usageFindings, usageFinding{ID: check.ID, Severity: severity})\n\t}\n\tnoteUsageFindings(stdout, result, usageFindings, true)\n\tfor name, writer := range map[string]struct {\n\t\tpath  string\n\t\twrite func(string, validationRunResult) error\n\t}{\n\t\t\"json\":  {jsonOut, writeValidationJSON},\n\t\t\"junit\": {junitOut, writeValidationJUnit},\n\t\t\"sarif\": {sarifOut, writeValidationSARIF},\n\t} {\n\t\tif writer.path == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\ttarget := filepath.Join(root, filepath.FromSlash(writer.path))\n\t\tif name == \"json\" && canonicalResultsPath != \"\" && normalizeValidationOutputPath(writer.path) == canonicalResultsPath {\n\t\t\terr := publishCanonicalValidationJSONIn(store, writer.path, canonicalResultsPath, run)\n\t\t\tif err != nil {\n\t\t\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n\t\t\t\t\tout := render(stdout, stderr)\n\t\t\t\t\tout.ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n\t\t\t\t\tout.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"validation-result-durability\",\n\t\t\t\t\t\tMessage: fmt.Sprintf(\"%s result was published but durability is unconfirmed: %v\", name, err)})\n\t\t\t\t\treturn 1\n\t\t\t\t}\n\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(cliText(locale, \"writing %s result: %v\", \"escrevendo resultado %s: %v\"), name, err))\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\trender(stdout, stderr).ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n\t\t\tcontinue\n\t\t}\n\t\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: creating %s result directory: %v\\n\", \"Erro: criando diretório do resultado %s: %v\\n\"), name, err)\n\t\t\treturn 1\n\t\t}\n\t\tif err := writer.write(target, run); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: writing %s result: %v\\n\", \"Erro: escrevendo resultado %s: %v\\n\"), name, err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"%s: %s\\n\", name, target)\n\treturn newArgs\n}\n\n// materialWorktreeClean reports whether the working copy equals HEAD in every\n// path outside the administrative classes, untracked files included. A status\n// that cannot be read is not clean.\nfunc materialWorktreeClean(root string) bool {\n\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n\tif err != nil {\n\t\treturn false\n\t}\n\trecords := strings.Split(string(out), \"\\x00\")\n\tvar administrative []string\n\tfor i := 0; i < len(records); i++ {\n\t\trecord := records[i]\n\t\tif len(record) < 4 {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{record[3:]}\n\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n\t\t\t// A rename or copy carries its source as the next record.\n\t\t\tif i+1 < len(records) {\n\t\t\t\ti++\n\t\t\t\tpaths = append(paths, records[i])\n\t\t\t}\n\t\t}\n\t\tfor _, p := range paths {\n\t\t\tif !posemodel.IsAdministrativePath(p) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tadministrative = append(administrative, p)\n\t\t}\n\t}\n\treturn administrativeRecordsAreRegular(root, administrative)\n}\n\n// materialTrackedUnchanged reports whether no tracked file differs from HEAD\n// outside the administrative records. Untracked files are not counted: checks\n// leave build products behind, and those are not the material they ran over.\nfunc materialTrackedUnchanged(root string) bool {\n\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=no\")\n\tif err != nil {\n\t\treturn false\n\t}\n\trecords := strings.Split(string(out), \"\\x00\")\n\tvar administrative []string\n\tfor i := 0; i < len(records); i++ {\n\t\trecord := records[i]\n\t\tif len(record) < 4 {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{record[3:]}\n\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n\t\t\tif i+1 < len(records) {\n\t\t\t\ti++\n\t\t\t\tpaths = append(paths, records[i])\n\t\t\t}\n\t\t}\n\t\tfor _, p := range paths {\n\t\t\tif !posemodel.IsAdministrativePath(p) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tadministrative = append(administrative, p)\n\t\t}\n\t}\n\treturn administrativeRecordsAreRegular(root, administrative)\n}\n\n// administrativeRecordsAreRegular reports whether every changed administrative\n// path is a regular file at HEAD (or new): editing a committed symlink or\n// submodule inside a class is a material change, as in MaterialSetDigest.\nfunc administrativeRecordsAreRegular(root string, paths []string) bool {\n\tif len(paths) == 0 {\n\t\treturn true\n\t}\n\targs := []string{\"ls-tree\", \"-z\", \"HEAD\", \"--\"}\n\tfor _, p := range paths {\n\t\tif strings.ContainsAny(p, \"\\n\\x00\") {\n\t\t\treturn false\n\t\t}\n\t\t// The working copy as well as HEAD: a regular record replaced by a link, or\nfunc writeExecutionPlan(path string, plan executionPlan) error {\n\tpayload, err := json.MarshalIndent(plan, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(path, append(payload, '\\n'), 0o644)\n}\n\nfunc writeValidationJSON(path string, run validationRunResult) error {\n\tpayload, err := marshalValidationJSON(run)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(path, payload, 0o644)\n}\n\nfunc marshalValidationJSON(run validationRunResult) ([]byte, error) {\n\tpayload, err := json.MarshalIndent(run, \"\", \"  \")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn append(payload, '\\n'), nil\n}\n\n// configuredDeliveryResultsPath identifies the project-local JSON artifact\n// that downstream delivery and closeout gates consume. Other --json-out\n// paths remain ordinary exports and keep their existing writer behavior.\nfunc configuredDeliveryResultsPath(root string) string {\n\tpolicy, err := posemodel.LoadDeliveryPolicy(root)\n\tif err != nil || policy.ResultsPath == \"\" {\n\t\treturn \"\"\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Validation evidence binds to the material it validated (spec\n// pose-validation-evidence-material-binding, ADR\n// validation-evidence-binds-to-validated-material). A commit whose every\n// changed path is a derived administrative record does not change what the\n// checks exercised, so it does not move the material digest.\n\n// engineVersion is the running engine, registered by the binaries (internal/pose\n// stays importable on its own). It is part of every material digest, so a new\n// engine never inherits evidence the previous one produced.\nvar engineVersion = \"unregistered\"\n\n// SetEngineVersion registers the running engine for material digests.\nfunc SetEngineVersion(v string) { engineVersion = v }\n\n// administrativeDirs is the closed list of derived-record directories. It is\n// owned by the engine; adding a class is a contract change that needs an ADR.\nvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n\n// materialIndexes are files inside an administrative directory that still\n// change what the checks demand.\nvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\n// IsAdministrativePath reports whether p is a derived administrative record.\nfunc IsAdministrativePath(p string) bool {\n\tif p == \"\" || p != path.Clean(p) || strings.HasPrefix(p, \"/\") || strings.HasPrefix(p, \"../\") {\n\t\treturn false\n\t}\n\tif materialIndexes[p] {\n\t\treturn false\n\t}\n\tif !recordExtensions[strings.ToLower(path.Ext(p))] {\n\t\treturn false\n\t}\n\tfor _, dir := range administrativeDirs {\n\t\tif strings.HasPrefix(p, dir) {\n\t\t\treturn true\n\t\t}\n\t}\n\tif rest, ok := strings.CutPrefix(p, \".pose/\"); ok {\n\t\tif i := strings.Index(rest, \"/\"); i > 0 && strings.HasPrefix(rest[:i], \"review-\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// recordExtensions are the data formats a derived record is written in. Code or\n// a script stored in a class is material: that keeps a source file moved or\n// copied into a class from hiding its later edits. A copied data file stays\n// indistinguishable from a record; a check that reads data out of a derived-record\n// directory is outside this contract (ADR validation-evidence-binds-to-validated-material).\nvar recordExtensions = map[string]bool{\".json\": true, \".jsonl\": true, \".ndjson\": true, \".md\": true, \".txt\": true, \".log\": true, \".transcript\": true}\n\n// TreeEntry is one entry of the validated head's tree.\ntype TreeEntry struct{ Mode, Blob string }\n\nfunc regularMode(mode string) bool { return mode == \"100644\" || mode == \"100755\" }\n\n// MaterialInputs are what a material digest is computed from: the paths a change\n// set names (both sides of a rename, and the validation matrix) and the\n// destinations of renames. They are stored with the set so the digest can be\n// recomputed against the current tree without the commits' own records.\ntype MaterialInputs struct {\n\tNames []string `json:\"names\"`\n\tMoved []string `json:\"moved,omitempty\"`\n}\n\n// MaterialInputsOf derives the inputs from per-commit path records. They must\n// be unmerged: folding a create and a later rename into one creation would hide\n// that the file moved into a class.\nfunc MaterialInputsOf(paths []ObservedPath) MaterialInputs {\n\tnames := map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\tmoved := map[string]bool{}\n\tfor _, p := range paths {\n\t\tfor _, name := range []string{p.Path, p.OldPath, p.NewPath} {\n\t\t\tif name != \"\" {\n\t\t\t\tnames[name] = true\n\t\t\t}\n\t\t}\n\t\t// A rename destination is material whatever directory it lands in:\n\t\t// otherwise moving a source file into a class would hide its later edits.\n\t\tif p.OldPath != \"\" && p.NewPath != \"\" {\n\t\t\tmoved[p.NewPath] = true\n\t\t}\n\t}\n\tin := MaterialInputs{}\n\tfor name := range names {\n\t\tin.Names = append(in.Names, name)\n\t}\n\tfor name := range moved {\n\t\tin.Moved = append(in.Moved, name)\n\t}\n\tsort.Strings(in.Names)\n\tsort.Strings(in.Moved)\n\treturn in\n}\n\n// MaterialSetDigest digests the head state of the material a change set\n// touched: every path it names (both sides of a rename) with its mode and blob\n// at the validated head, minus the paths that are administrative records and\n// still regular files there, plus the validation matrix. A symlink, submodule\n// or directory in an administrative class is material; so is a path that left\n// a class. tree maps each named path (and the matrix) to its entry; a path\n// absent from the head tree is \"absent\".\nfunc MaterialSetDigest(in MaterialInputs, tree map[string]TreeEntry) string {\n\tmoved := map[string]bool{}\n\tfor _, name := range in.Moved {\n\t\tmoved[name] = true\n\t}\n\tsorted := in.Names\n\th := sha256.New()\n\tfor _, name := range sorted {\n\t\tentry, present := tree[name]\n\t\tif IsAdministrativePath(name) && !moved[name] && (!present || regularMode(entry.Mode)) {\n\t\t\tcontinue\n\t\t}\n\t\tif !present {\n\t\t\th.Write([]byte(name + \"\\x00absent\\n\"))\n\t\t\tcontinue\n\t\t}\n\t\th.Write([]byte(name + \"\\x00\" + entry.Mode + \"\\x00\" + entry.Blob + \"\\n\"))\n\t}\n\treturn \"sha256:\" + hex.EncodeToString(h.Sum(nil))\n}\n\n// MaterialDigestUnreadable marks a change set whose head tree could not be read\n// or whose checkout is not complete. It never binds evidence and never lets\n// evidence recorded without it pass as current.\nconst MaterialDigestUnreadable = \"unreadable\"\n\n// MaterialBindingUnavailable is recorded for a scope whose material cannot be\n// established, so the result is stale for it instead of falling back to the\n// commit-bound rules.\nconst MaterialBindingUnavailable = \"unavailable\"\n\n// MaterialBinding returns what a validation run should record for a spec: the\n// scoped digest, the unavailable marker when a change set's material could not\n// be read, or nothing when the spec has no material-bound change set.\nfunc MaterialBinding(graph DeliveryIntegrityGraph, spec string) (string, bool) {\n\tsets := 0\n\tfor _, set := range graph.ChangeSets {\n\t\tif set.Spec != spec {\n\t\t\tcontinue\n\t\t}\n\t\tsets++\n\t\t// A set read back from the report history carries no material digest, and\n\t\t// one that could not be read has the unreadable marker: either way the\n\t\t// scope's material cannot be established, so the run records the binding as\n\t\t// unavailable instead of silently falling back to the commit-bound rules.\n\t\tif set.MaterialDigest == \"\" || set.MaterialDigest == MaterialDigestUnreadable {\n\t\t\treturn MaterialBindingUnavailable, true\n\t\t}\n\t}\n\tif sets == 0 {\n\t\treturn \"\", false\n\t}\n\tif digest := ScopedMaterialDigest(graph, spec); digest != \"\" {\n\t\treturn digest, true\n\t}\n\treturn \"\", false\n}\n\n// ScopedMaterialDigest binds evidence to the claims and material of one spec's\n// change sets and to the engine. It is empty when any change set has no\n// material digest, so no binding can be recorded for it.\nfunc ScopedMaterialDigest(graph DeliveryIntegrityGraph, spec string) string {\n\tclaims := []ArtifactClaim{}\n\tdigests := []string{}\n\tfor _, claim := range graph.Claims {\n\t\tif claim.Spec == spec {\n\t\t\tclaims = append(claims, claim)\n\t\t}\n\t}\n\tfor _, set := range graph.ChangeSets {\n\t\tif set.Spec != spec {\n\t\t\tcontinue\n\t\t}\n\t\tif set.MaterialDigest == \"\" || set.MaterialDigest == MaterialDigestUnreadable {\n\t\t\treturn \"\"\n\t\t}\n\t\tdigests = append(digests, set.MaterialDigest)\n\t}\n\tif len(digests) == 0 {\n\t\treturn \"\"\n\t}\n\tsort.Slice(claims, func(i, j int) bool { return claimKey(claims[i]) < claimKey(claims[j]) })\n\tsort.Strings(digests)\n\traw, _ := json.Marshal(struct {\n\t\tEngine string          `json:\"engine\"`\n\t\tClaims []ArtifactClaim `json:\"claims\"`\n\t\tDigest []string        `json:\"material\"`\n\t}{engineVersion, claims, digests})\n\tsum := sha256.Sum256(raw)\n\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n}\n\n// withoutMaterialDigest copies change sets without the material digest, so the\n// commit-bound digests keep the representation results were recorded against.\nfunc withoutMaterialDigest(sets []ChangeSet) []ChangeSet {\n\tout := make([]ChangeSet, len(sets))\n\tfor i, set := range sets {\n\t\tset.MaterialDigest = \"\"\n\t\tset.MaterialInputs = nil\n\t\tout[i] = set\n\t}\n\treturn out\n}\n\n// CurrentMaterialDigests recomputes the material digest of each set from its\n// stored inputs against the current tree, through the hook the binary\n// registered. Evidence is judged against these, not against the digests the\n// persisted index recorded when it was built: an untrailered commit after the\n// index changes what the evidence describes (spec\n// pose-validation-evidence-material-binding R6). A set without inputs, or a\n// binary without a hook, keeps the recorded digest.\nvar CurrentMaterialDigests func(root string, inputs MaterialInputs) string\n\n// SetCurrentMaterialDigests registers the recomputation.\nfunc SetCurrentMaterialDigests(f func(root string, inputs MaterialInputs) string) {\n\tCurrentMaterialDigests = f\n}\n\n// currentMaterialHead resolves a repository's HEAD to its commit, and\n// currentMaterialAt digests a set's inputs in that commit's tree; the binary\n// registers both. A commit names its tree by content, so the digest of the\n// same inputs at the same commit is kept for the process: a review bundle\n// recomputes the material of every change set of the graph for every spec it\n// prepares, and a governance check prepares bundles for every scope (spec\n// pose-federated-proof-reads-each-input-once).\nvar (\n\tcurrentMaterialHead func(root string) string\n\tcurrentMaterialAt   func(root, head string, inputs MaterialInputs) string\n\t// currentMaterialKept bounds the kept digests of a long-running process\n\t// (the MCP server sees HEAD move): past the bound, they are dropped.\n\tcurrentMaterialKept = newKeptCache[string](20000)\n)\n\n// SetCurrentMaterialAt registers the commit-bound recomputation.\nfunc SetCurrentMaterialAt(head func(root string) string, at func(root, head string, inputs MaterialInputs) string) {\n\tcurrentMaterialHead, currentMaterialAt = head, at\n}\n\nfunc withCurrentMaterial(root string, sets []ChangeSet) []ChangeSet {\n\tif CurrentMaterialDigests == nil && currentMaterialAt == nil {\n\t\treturn sets\n\t}\n\t// HEAD is resolved once for the whole graph; a set's digest is then the\n\t// digest at that commit. Unresolvable HEAD falls back to reading the tree\n\t// of HEAD per set, uncached.\n\thead := \"\"\n\tif CurrentMaterialDigests == nil && currentMaterialHead != nil {\n\t\thead = currentMaterialHead(root)\n\t}\n\tout := make([]ChangeSet, len(sets))\n\tfor i, set := range sets {\n\t\tif set.MaterialInputs != nil && set.MaterialDigest != \"\" && set.MaterialDigest != MaterialDigestUnreadable {\n\t\t\tset.MaterialDigest = currentMaterialDigest(root, head, *set.MaterialInputs)\n\t\t}\n\t\tout[i] = set\n\t}\n\treturn out\n}\n\nfunc currentMaterialDigest(root, head string, inputs MaterialInputs) string {\n\tif CurrentMaterialDigests != nil {\n\t\treturn CurrentMaterialDigests(root, inputs)\n\t}\n\tif !isGitRevision(head) {\n\t\treturn currentMaterialAt(root, \"HEAD\", inputs)\n\t}\n\tencoded, err := json.Marshal(inputs)\n\tif err != nil {\n\t\treturn currentMaterialAt(root, head, inputs)\n\t}\n\tkey := filepath.Clean(root) + \"\\x00\" + head + \"\\x00\" + string(encoded)\n\t// An unreadable tree is not the commit's answer: it is asked again\n\t// (review round 1, F1).\n\treturn currentMaterialKept.get(key, func() (string, bool) {\n\t\tdigest := currentMaterialAt(root, head, inputs)\n\t\treturn digest, digest != \"\" && digest != MaterialDigestUnreadable\n\t})\n}\n\t}\n\tif !plan.record.Used && !strings.Contains(plan.record.Reason, \"engine\") {\n\t\tt.Fatalf(\"carry unused for an unexpected reason: %q\", plan.record.Reason)\n\t}\n}\n\n// A discovered dependency above the changed module selects its dependents\n// (review round 6, N15), and so does a discovered root dependency.\nfunc TestChangedScopeDiscoveredAncestorDependencySelectsItsDependents(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"a\"]}}}`)\n\tf.write(\"a/nested/go.mod\", \"module nested\\n\")\n\tf.commit(\"nested module\")\n\tf.write(\"a/nested/input.txt\", \"x\\n\")\n\tf.commit(\"change nested\")\n\t_, out := runValidate(t, f.root, \"--changed-from\", \"HEAD~1\", \"--changed-to\", \"HEAD\", \"--explain\")\n\tif !strings.Contains(out, \"+ b: declared dependency a changed: a/nested/input.txt\") {\n\t\tt.Fatalf(\"b must be selected through its discovered ancestor dependency: %s\", out)\n\t}\n\n\tg := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\".\"]}}}`)\n\tg.write(\"go.mod\", \"module root\\n\")\n\tg.commit(\"root module\")\n\tg.write(\"a/changed.go\", \"package a\\n\")\n\tg.commit(\"change a\")\n\t_, out = runValidate(t, g.root, \"--changed-from\", \"HEAD~1\", \"--changed-to\", \"HEAD\", \"--explain\")\n\tif !strings.Contains(out, \"+ b: declared dependency . changed: a/changed.go\") {\n\t\tt.Fatalf(\"b must be selected through its discovered root dependency: %s\", out)\n\t}\n}\n\n// A declared dependency reached through a symlink refuses the carry (review\n// round 6, N16).\nfunc TestCarryRefusesDependenciesReachedThroughASymlink(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"link\"]}}}`)\n\tif err := os.Symlink(\"a\", filepath.Join(f.root, \"link\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.commit(\"link\")\n\tf.baseline()\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"change a\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"symlink link\") {\n\t\tt.Fatalf(\"carry = %+v, want an aliased dependency refused\", run.Carry)\n\t}\n}\n\n// A symlink inside a module refuses the carry even when the dependency it\n// leads to is absent (review round 7, N17).\nfunc TestCarryRefusesASymlinkInsideAModule(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"b/link/input\"]}}}`)\n\tf.write(\"a/input\", \"x\\n\")\n\tif err := os.Symlink(\"../a\", filepath.Join(f.root, \"b\", \"link\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.commit(\"link from b into a\")\n\tf.baseline()\n\tf.git(\"rm\", \"-q\", \"a/input\")\n\tf.commit(\"delete the input\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"symlink b/link\") {\n\t\tt.Fatalf(\"carry = %+v, want a symlink inside a module refused\", run.Carry)\n\t}\n}\n\n// Symlinks between paths no module owns do not block a carry.\nfunc TestCarryAllowsSymlinksBetweenUnownedPaths(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.write(\".agents/skills/x/SKILL.md\", \"skill\\n\")\n\tif err := os.MkdirAll(filepath.Join(f.root, \".claude\", \"skills\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Symlink(\"../../.agents/skills/x\", filepath.Join(f.root, \".claude\", \"skills\", \"x\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.commit(\"skills link\")\n\tf.baseline()\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"change a\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || !run.Carry.Used || checkOf(run, \"b\").CarriedFrom == \"\" {\n\t\tt.Fatalf(\"carry = %+v, want b carried despite an unowned symlink\", run.Carry)\n\t}\n}\n\n// A case-folding filesystem refuses the carry (review round 7, N18); faked,\n// since this filesystem is case-sensitive.\nfunc TestCarryDetectsACaseInsensitiveFilesystem(t *testing.T) {\n\tdir := t.TempDir()\n\tinfo, err := os.Stat(dir)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfolding := func(string) (os.FileInfo, error) { return info, nil }\n\tif !caseInsensitiveFilesystem(\"/repo\", folding) {\n\t\tt.Fatal(\"a filesystem where .GIT names .git must read as case-insensitive\")\n\t}\n\tsensitive := func(p string) (os.FileInfo, error) {\n\t\tif strings.HasSuffix(p, \".GIT\") {\n\t\t\treturn nil, os.ErrNotExist\n\t\t}\n\t\treturn info, nil\n\t}\n\tif caseInsensitiveFilesystem(\"/repo\", sensitive) {\n\t\tt.Fatal(\"a case-sensitive filesystem refused\")\n\t}\n}\n\n// Two checks with one id never share a base result (review round 7, N19).\nfunc TestCarryRefusesDuplicateCheckIDs(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\"`, `\"moduleOverrides\":{\"b\":{\"checks\":[{\"name\":\"ok\",\"program\":\"true\",\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\"`, 1))\n\tf.commit(\"duplicate check\")\n\tf.validate()\n\tf.commit(\"record\")\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"change a\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"more than once\") {\n\t\tt.Fatalf(\"carry = %+v, want duplicate check ids refused\", run.Carry)\n\t}\n}\n\n// A symlink inside a self-contained module that leads to a path no module owns\n// would hide that path's changes from the module (review round 7, N17).\nfunc TestCarryRefusesASymlinkFromAModuleToAnUnownedPath(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true}}}`)\n\tf.write(\"shared/input\", \"x\\n\")\n\tif err := os.Symlink(\"../shared\", filepath.Join(f.root, \"b\", \"shared\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.commit(\"link from b to an unowned path\")\n\tf.baseline()\n\tf.write(\"shared/input\", \"y\\n\")\n\tf.commit(\"change the shared input\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"symlink b/shared\") {\n\t\tt.Fatalf(\"carry = %+v, want a module's outward symlink refused\", run.Carry)\n\t}\n}\npose-mcp/internal/cli/validate.go:1571:func moduleValidationChecks(module validationModule, matrix validationMatrix, stackFilter, moduleFilter string) (string, []validationCheck, bool) {\npackage cli\n\nimport (\n\t\"runtime/debug\"\n\t\"testing\"\n\n\t\"github.com/harne8/pose-mcp/internal/version\"\n)\n\n// A modified build is not a comparable engine identity (spec\n// pose-validate-carries-unchanged-checks, review round 2, N4).\nfunc TestEngineIdentityRefusesModifiedBuilds(t *testing.T) {\n\tinfo := func(settings ...debug.BuildSetting) *debug.BuildInfo { return &debug.BuildInfo{Settings: settings} }\n\tcases := []struct {\n\t\tname       string\n\t\tinfo       *debug.BuildInfo\n\t\twant       string\n\t\tverifiable bool\n\t}{\n\t\t{\"clean\", info(debug.BuildSetting{Key: \"vcs.revision\", Value: \"abc\"}, debug.BuildSetting{Key: \"vcs.modified\", Value: \"false\"}), version.Version + \"+abc\", true},\n\t\t{\"modified\", info(debug.BuildSetting{Key: \"vcs.revision\", Value: \"abc\"}, debug.BuildSetting{Key: \"vcs.modified\", Value: \"true\"}), version.Version + \"+abc.dirty\", false},\n\t\t{\"unstamped\", info(), version.Version, true},\n\t}\n\tfor _, tc := range cases {\n\t\tgot, verifiable := engineIdentityFrom(tc.info, true)\n\t\tif got != tc.want || verifiable != tc.verifiable {\n\t\t\tt.Fatalf(\"%s: identity %q verifiable %v, want %q %v\", tc.name, got, verifiable, tc.want, tc.verifiable)\n\t\t}\n\t}\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc \"printf '%s\\\\n' \\\"\"'$TMPDIR\"; sed -n '\"'220,300p' pose-mcp/internal/cli/validate_results.go; sed -n '1570,1620p' pose-mcp/internal/cli/validate.go; rg -n 'carry|selfContained' POSE.md; git diff --stat dec2e64c..2f2c1ab; cat .pose/knowledge/2026-08-14-decision-log-escalation-validate-native.md; sed -n '1,150p' pose-mcp/internal/cli/testdata/adversarial/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc \"printf '%s\\\\n' \\\"\"'$TMPDIR\"; sed -n '\"'220,300p' pose-mcp/internal/cli/validate_results.go; sed -n '1570,1620p' pose-mcp/internal/cli/validate.go; rg -n 'carry|selfContained' POSE.md; git diff --stat dec2e64c..2f2c1ab; cat .pose/knowledge/2026-08-14-decision-log-escalation-validate-native.md; sed -n '1,150p' pose-mcp/internal/cli/testdata/adversarial/README.md\"","aggregated_output":"/var/tmp/pose-work-go/pose-review-run-710645564\n\t\treturn \"\"\n\t}\n\treturn normalizeValidationOutputPath(policy.ResultsPath)\n}\n\nfunc normalizeValidationOutputPath(path string) string {\n\tif path == \"\" {\n\t\treturn \"\"\n\t}\n\treturn filepath.ToSlash(filepath.Clean(filepath.FromSlash(path)))\n}\n\n// publishCanonicalValidationJSON rechecks the delivery policy after acquiring\n// the root lease, then publishes the exact canonical result through B14. A\n// changed path is refused before creating or replacing the result.\nfunc publishCanonicalValidationJSON(root, relative, expectedPolicyPath string, run validationRunResult) error {\n\treturn publishCanonicalValidationJSONIn(cliGovernedStore(root), relative, expectedPolicyPath, run)\n}\n\nfunc publishCanonicalValidationJSONIn(store posemodel.Store, relative, expectedPolicyPath string, run validationRunResult) error {\n\treturn store.WithGovernanceWriteGuardForProjects(\"validate.publish-results\", nil, func(store posemodel.Store) error {\n\t\tpolicy, err := posemodel.LoadDeliveryPolicyIn(store.FS, store.Root)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tcurrentPath := normalizeValidationOutputPath(policy.ResultsPath)\n\t\tif currentPath == \"\" || currentPath != expectedPolicyPath || currentPath != normalizeValidationOutputPath(relative) {\n\t\t\treturn fmt.Errorf(\"configured delivery results path changed before publication; nothing was written\")\n\t\t}\n\t\tpayload, err := marshalValidationJSON(run)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\ttarget := filepath.Join(store.Root, filepath.FromSlash(currentPath))\n\t\tif err := store.FS.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn store.FS.Publish(target, payload, 0o644, posemodel.PublishAuthoritative, posemodel.PublishExpectation{Mode: posemodel.ExpectAny})\n\t})\n}\n\n// --- JUnit projection -------------------------------------------------------\n// Mapping: one <testsuite> per module, one <testcase> per check. POSE\n// \"error\" maps to <error> (infrastructure), \"fail\" to <failure>, \"skipped\"\n// to <skipped> with the deterministic reason. Optional-severity failures are\n// still <failure> — JUnit has no tolerated level, so the POSE severity is\n// preserved in the testcase classname suffix (documented lossy edge).\n\ntype junitTestCase struct {\n\tXMLName   xml.Name      `xml:\"testcase\"`\n\tName      string        `xml:\"name,attr\"`\n\tClassName string        `xml:\"classname,attr\"`\n\tTime      string        `xml:\"time,attr\"`\n\tFailure   *junitMessage `xml:\"failure,omitempty\"`\n\tError     *junitMessage `xml:\"error,omitempty\"`\n\tSkipped   *junitMessage `xml:\"skipped,omitempty\"`\n}\n\ntype junitMessage struct {\n\tMessage string `xml:\"message,attr\"`\n\tBody    string `xml:\",chardata\"`\n}\n\ntype junitSuite struct {\n\tXMLName  xml.Name        `xml:\"testsuite\"`\n\tName     string          `xml:\"name,attr\"`\n\tTests    int             `xml:\"tests,attr\"`\n\tFailures int             `xml:\"failures,attr\"`\n\tErrors   int             `xml:\"errors,attr\"`\n\tSkipped  int             `xml:\"skipped,attr\"`\n\tCases    []junitTestCase `xml:\"testcase\"`\n}\n\ntype junitSuites struct {\n\tXMLName xml.Name     `xml:\"testsuites\"`\n\tName    string       `xml:\"name,attr\"`\n\tSuites  []junitSuite `xml:\"testsuite\"`\n}\n\nfunc writeValidationJUnit(path string, run validationRunResult) error {\n\tbyModule := map[string]*junitSuite{}\n// (spec pose-cli-output-rendering-system R6).\nfunc moduleValidationChecks(module validationModule, matrix validationMatrix, stackFilter, moduleFilter string) (string, []validationCheck, bool) {\n\toverride := matrix.ModuleOverrides[module.Rel]\n\tstack := module.Stack\n\tif override.Stack != \"\" {\n\t\tstack = override.Stack\n\t}\n\tif stackFilter != \"\" && stack != stackFilter || moduleFilter != \"\" && module.Rel != moduleFilter {\n\t\treturn stack, nil, false\n\t}\n\tchecks := append([]validationCheck(nil), matrix.Stacks[stack].Checks...)\n\tif override.ReplaceDefaultChecks {\n\t\tchecks = nil\n\t}\n\treturn stack, append(checks, override.Checks...), true\n}\n\n// tailLines keeps the last n lines of a check's captured output: enough to see\n// why it failed, with the full output one path away.\nfunc tailLines(text string, n int) string {\n\tlines := strings.Split(strings.TrimRight(text, \"\\n\"), \"\\n\")\n\tif len(lines) <= n {\n\t\treturn strings.Join(lines, \"\\n\")\n\t}\n\treturn strings.Join(lines[len(lines)-n:], \"\\n\")\n}\n\nfunc validationSummaryOf(run validationRunResult) *validationSummary {\n\tsummary := &validationSummary{Outcome: run.Outcome}\n\tfor _, check := range run.Checks {\n\t\tcommand := strings.TrimSpace(check.Program + \" \" + strings.Join(check.Args, \" \"))\n\t\tif check.Outcome != \"skipped\" && command != \"\" {\n\t\t\tsummary.Commands = append(summary.Commands, command)\n\t\t}\n\t\tline := \"- [\" + check.Outcome + \"] \" + check.ID\n\t\tswitch {\n\t\tcase check.SkipReason != \"\":\n\t\t\tline += \" (\" + check.SkipReason + \")\"\n\t\tcase check.DurationSeconds > 0:\n\t\t\tline += fmt.Sprintf(\" (%.1fs)\", check.DurationSeconds)\n\t\t}\n\t\tif check.ExitCode != nil {\n\t\t\tline += fmt.Sprintf(\" exit=%d\", *check.ExitCode)\n\t\t}\n\t\tsummary.Results = append(summary.Results, line)\n\t}\n\t// The report records the run's verdict too, built from the outcome rather\n\t// than copied from the printed line, so the recorded evidence keeps its\n\t// shape while the terminal is free to change.\n\tif run.Counts.OptionalFailed > 0 {\n\t\tsummary.Results = append(summary.Results, fmt.Sprintf(\"Warning: %d optional check(s) failed.\", run.Counts.OptionalFailed))\n218:              [--changed-from rev [--changed-to rev] | --carry] [--jobs n] [--explain] [--emit-plan f]\n353:  **Changed scope:** `--changed-from <rev> [--changed-to <rev>]` selects the minimum safe module set deterministically — modules containing changed files (tracked and untracked), transitive dependents via `dependsOn` edges in [`module-metadata.json`](.pose/indexes/module-metadata.json), and policy widening (criticality `high` always runs). Changed names are read NUL-delimited and a rename names both its source and its destination. Each changed file selects its most specific owning module, every module beneath it (a gitlink or replaced directory changes what lies under it), and every module whose declared `dependsOn` contains it, lies beneath it or is the root `.`, even after that dependency is deleted. A file no module owns selects the root module. Module metadata that does not decode stops the selection (a full run under `--carry`, an error under `--changed-from`). A change outside every module runs every module that does not declare `\"selfContained\": true` in its metadata (uncertainty prefers safe execution; the declaration states that the module's checks read only its own directory and its `dependsOn` modules); unselected checks are recorded as skipped with the selection reason and `--explain` prints every decision. Revisions are confined to a safe grammar; without the flags, full validation is unchanged.\n355:  **Carried checks:** `--carry --json-out <results_path>` refreshes the canonical result instead of rerunning the whole matrix. It uses the current canonical result as its base when the base is comparable: same schema, mode, matrix digest and `engine_version` (the engine version plus the VCS revision the binary was built from; a build of a modified tree never carries), unfiltered, not cancelled, recorded `material_clean` (it validated an unchanged working copy of its own head, and HEAD did not move while it ran) with no unavailable material binding, with its `git_head` an ancestor of `HEAD`, a clean material working copy now, a case-sensitive filesystem, no module reached through a symlink or sharing its directory with another module, no tracked symlink whose path or target lies in a module other than the root or in a declared `dependsOn` (or whose target leaves the repository), and no check id defined twice. The head is pinned before planning, and a run whose HEAD moved records its material bindings as unavailable. It runs the modules the changed-scope rules select between the base head and `HEAD`; the canonical result file and the derived administrative records that material bindings ignore (data files that are still regular files in the derived-record directories under `.pose/`: indexes, results, state, assessments and review records; the validation matrix stays material) are not changes. A module whose checks are not all in the base also runs. Every other check keeps the base result, its outcome included, and records `carried_from` (the head it ran at, kept through chained carries) and `carried_generated_at`; the delivery index reads that head for the result, so evidence freshness judges the commit a carried check really observed. A carried failure still fails the run. Any unmet condition runs everything, and `carry.reason` says why. `carry` records the base, the number of changed files and each selected module's reason, and `counts.carried` the reused checks. `--carry` does not combine with `--module`, `--stack`, `--workspace`, `--root-only`, `--changed-from` or `--changed-to`.\n371:- `review-plan` / `review-check` / `closeout-check` — resolve a deterministic component-aware plan from governed metadata, typed overlays and a closed native-tool catalog, then validate immutable attempts against both scope and plan digests. Opt in explicitly with review-policy schema v2, `component_aware: true` and `component_aware_adopted_at`; preview the migration read-only with `pose review-plan <scope> --explain` before committing the policy. Completed attempts older than that component adoption date remain auditable, while open scopes require the new plan. `pose review record` is dry-run by default, accepts `--plan-digest` to reject drift and appends with `--apply`; recommended tools are never executed implicitly. Hierarchical closeout rolls approvals through `spec:`, `milestone:` and `roadmap:` scopes. Read-only MCP: `pose_review_plan`, `pose_closeout_state`. The JSON of `closeout-check` and `pose_closeout_state` types its blockers in `diagnostics` (code, domain, refs, satisfaction condition; text blockers the engine cannot type yet are carried as `opaque`) and its next action in `next_step`; readiness `waiting_on` entries carry a `code`, and auto-attest pendencies a `code`, `source` and `condition` (spec `pose-typed-producer-diagnostics`). The prose fields stay for people; consumers read the codes.\n380:- `artifact-check` — parses exact `### Artifacts` actions, resolves an explicit base/head range or `POSE-Spec: <slug>` commit trailers with safe structured Git arguments, and reports resolvability, existence, action mismatch, undeclared and orphan findings. A claim on a changelog fragment that `pose release prepare` archived resolves through the release manifest, which records the fragment's spec and digest; prepare never edits a spec. A file a later spec removes needs no longer exist for the earlier specs that declare it `created` or `modified`: their claim is satisfied — an edge `removed-by` in `delivery-integrity.json` — when the later spec declares `removed:` for the path, its attributed change sets contain a commit that deleted it (a rename is not a deletion), and every change the earlier spec made to the path — a merge, a root creation, a type change or a deletion included — is a Git ancestor of that commit; a change after the removal, a removal its spec never performed, a change set naming something other than an immutable commit, or history Git cannot read — a shallow clone included; replace refs and grafts are ignored — keeps the existence finding, and the finding says why. Commits modifying artifacts declared by a spec must carry a `POSE-Spec: <slug>` trailer in their commit message for `artifact-check` and `pose close` to attribute the changes. `pose report --change-from/--change-to` persists immutable change-set evidence; `pose index` projects claims, observations, reverse provenance and findings into `delivery-integrity.json`. The seven files `pose index` writes are one generation (spec `pose-index-generation-integrity`): their bytes are written under `generations/<id>/` in the indexes directory, the legacy names are published from the same bytes, and the descriptor `generation.json` there — SHA-256 of each file plus the digests of the inputs they were computed from — is published last and is the commit. A reader fixes the generation the descriptor names and checks each file against it: a set that does not verify (a file missing, replaced, from another generation, or a descriptor it cannot read) is `unavailable`, with the reason, never an empty or mixed result; a repository that never ran `pose index` since this contract keeps working and is reported `legacy-unversioned`, with no claim of coherence. A generated index edited by hand has no effect while the generation's copy exists (readers read the generation), and in a clone without the copy it makes the set unavailable; either way `pose index --verify` names the file. `pose index --verify` reads without writing and exits 1 unless the set is current, the legacy names are those of the generation and its inputs (specs, roadmaps, policy, module metadata, validation matrix) still hold. A failed publication leaves the previous generation in force and a retry converges on the same identity; publishers hold a generation lock in the indexes directory (it never waits: a second `pose index` is refused with `index-generation-busy` and writes nothing, and a lock whose holder is proven dead is recovered), the first publication of a repository is marked pending so one that did not commit reads as `unavailable` and not as a mixture of two runs, an operation that reads several indexes (the review plan) fixes one generation for all of them, and a commit whose durability could not be confirmed is reported as committed; retention keeps the current generation and the newest others up to three, never anything younger than ten minutes, and a retention failure is a warning, not a failed publication. Limits: Git history is read by the delivery graph but not pinned by the descriptor, and a clone without the git-ignored `generations/` directory verifies the legacy names against the descriptor. MCP: `pose_delivery_integrity`.\n385:- `state --attention` (specs `pose-obligation-projection`, `pose-state-attention`) — live, read-only answer to \"what is still owed, by whom, restricting which phase?\". Obligations are projected from the subsystems that own them — readiness (unmet `depends_on`, Definition of Ready, unexplained `blocked`), closeout and review of in-progress specs (an unapproved review, each judgment criterion a sealed bundle still owes, text blockers carried as `legacy-opaque`), start reconciliation when atomic start is adopted, and open follow-ups as advisory residual debt — never stored a second time. Project-level sources are projected too (spec `pose-attention-projects-every-source`), originating on `xref:<project>/project:<project>`: an open docs review mark (owed by the doc's owner until `pose docs-review resolve`), a capability mechanism with a stale trigger, a release newer than the newest verified one that is not yet verified, and an accepted-risk or follow-up finding past its review date in the latest legacy review record. Free-form investigation notes carry no state and are not a source. The render shows coverage first: a producer that failed, or action requests until adopted, makes the answer `INCOMPLETE`, so an empty group never reads as nothing owed, and a fresh install, once committed, reads `complete`. Then what needs `--actor` (or any person or role), then what restricts each phase (`start`, `execution`, `review`, `closeout`, `release`), then residual debt. `--json` returns the report — stable `obl-` ids, qualified refs, reason codes, conditions, recipients, effects, satisfaction, knowledge, waiting, a snapshot of revision/dirty tree/policy/contract/index digests, per-producer coverage — plus the `attention` grouping. MCP: `pose_obligations` returns the same ids from the same function. Attention is not a gate.\n650:names the matrix did not carry is reported as one `validation-check` fact per\n660:trailers also name other specs cannot be split by commit; its facts carry\n739:two directories are the contract — policy and profiles carry their own schema\n760:`agent:`/`human:` prefixes remain labels only. The attestation must carry a\n778:`closeout-check` print one assurance line and carry an `assurance` object in\n792:claim names that human. Records written before this carry no block and render\n821:An answer proof authorizes its answer only. New waiver, cancellation and supersession events carry `lifecycle_version: 1`. Under verified action policy they require an operation-bound SSHSIG (`pose-action-lifecycle`) or a trusted issuer's schema-2 action claim. MCP always requires this proof. Both supplied emitters must verify; human presence follows the current explicit channel scope.\n909:`pose delegate ls` lists attempts by their latest run with state, purpose, agent, label, turns, age and last step — for an interrupted run also its cause, whether a partial draft exists, the reset instant and the time left — and the runs in progress with the liveness of their process. `pose delegate cancel <run>` stops a run in progress; it is recorded `failed` with the cause `cancelled`, and its attempt stays consumed. `pose delegate agents` lists each agent with vendor, model, whether its CLI is on the path, the reset instant of its last recorded usage limit and the state routing reads: `available`, `limited until <instant>` (its last run hit a usage limit whose reset is ahead), `missing` (its CLI is not on the path), `unknown` (the run history could not be read whole) or `probe-failed` (its optional `probe` failed within its bound). Availability is read from the path and the recorded runs; only a configured probe runs anything. `pose delegate review|adjudicate|smoke --detach` starts the run as a process of its own, in a session of its own that survives the caller's terminal, and returns at once with the attempt (a run reference) and the path of its log; a run whose route must first wait for a usage-limit reset is not detached. `pose delegate wait <run> [--timeout <d>] [--json]` is a plain foreground process that ends when the run does and prints one line — run, state, decision, resumable flag, reset instant — with the exit code `0` approved, `10` changes requested or rejected, `20` failed (a completed run with no decision too), `30` interrupted, `40` stalled, `50` the wait timed out, and `2` for a usage error; every waiter is released, a run already ended returns at once, and killing a wait leaves the run running. The process running an attempt rewrites a heartbeat in its marker every 10 seconds; a run whose heartbeat is older than three intervals and whose process is provably gone is recorded `stalled` by the first reader, through an exclusive claim every reader then agrees on, and `ls` shows each running run's heartbeat age. `pose delegate watch [<run>|<label>]` shows an attempt as one task: the runs it recorded are replayed with a marker where a run resumed another and the interrupted run naming the run that continued it, then a running attempt is followed through the normalized, redacted events its process writes as they come, until the record is published; `--no-follow` prints what exists and exits, `-v` adds the tail of each tool's output (`--lines <n>`, default 12) and `--json` prints NDJSON. With no reference it follows the only running run; at a terminal it otherwise opens fzf with a preview of the run under the cursor refreshed every `--refresh <d>` (default 2s, 0 turns it off), or a numbered menu without fzf; outside a terminal an absent reference exits 2 and lists the candidates. Colours appear only on a terminal and follow `NO_COLOR`. A live event is redacted with the credentials and the session references the stream has declared so far; the events bound to the record are derived again from the whole transcript. `on_terminal` on an agent (or else on a purpose) is a command run once after a run ends, with only `POSE_DELEGATE_RUN` and `POSE_DELEGATE_STATE` in its environment, the run directory as working directory, its own process group and a bound (`timeout`, default 30s, at most 5m); its failure is recorded beside the run, shown by `ls`, and never changes the run's state. `pose delegate handoff <run> --to <agent|auto>` continues a run that stopped interrupted or failed, short of a conclusion, with another agent under the same attempt and its continuation budget, which is the `resume.max_resumes` and `max_wall_time` of the agent that opened the attempt (3 and 60 minutes by default) whichever agent continues it, so changing agents never widens it; a completed run, the same agent and a run already continued are refused, and a run handed off is no longer resumed. Its brief is the predecessor's generated brief followed by a labelled section: the predecessor's partial final message and the commands it ran with their exit status, paired by the call identifier the agent's stream records and otherwise left unknown rather than guessed, each with its digest, quoted so no line of it reads as a decision, bounded at 16 KiB with the cut disclosed, and an instruction to re-verify. Only the handoff run concludes. The record binds the base brief digest and the section digest in `handoff_digest`, names its predecessor in `hands_off_from`, and a signed proof verifies the section against the predecessor's record. `--to auto` routes as the purpose does, the stopped agent excluded and unavailable ones skipped. A foreground run or handoff that stops interrupted in a terminal offers waiting for its reset and resuming, handing off, or cancelling, which is offered even alone, and does nothing until answered; the stopping command's result, `ls --json` and `wait --json` carry the same ways forward as `next_actions`, each with its command, whether it is available now — judged by the planning its command runs, budget and wait bound included — and why not, and a `cancel` that leaves the run stopped. `watch` marks a handoff with `⇄` beside the `↻` of a resume. `pose delegate task <prompt-file|->` hands any task to another agent: the prompt goes on stdin in `--cd` (default: the current directory) with the agent's command for `--access read|sandboxed|write|full`; the default is `purposes.task.default_access` (read when unset), `full` is never a default and prints a warning naming what it disables. A task's template places `{add_dirs}`, `{no_network}` and `{outside_git}`, filled from the agent's `add_dir_args` (with `{dir}`), `no_network_args` and `outside_git_args`; `--add-dir`, `--no-network` and `--effort` that the agent's template cannot carry are refused with exit 2, and `--no-network` with `write` or `full` too. The final message goes to stdout and the agent's exit code is returned; `--json` replaces both with one document. A task runs in the real directory: containment bounds its time and output, not its filesystem. Its record (prompt, stream, error stream, normalized events, argv, removed variable names, exit code, label) is owner-only under the user's state directory (`$XDG_STATE_HOME/pose/delegate/`, where `XDG_STATE_HOME` counts only as an absolute path and `~/.local/state` is the default), or, with `--record`, in the `delegate-runs` directory of `.pose`. The state directory may be reached through a link of the user's own; resolved, it and every directory above it must belong to the user or to root and be writable by no group or other user unless sticky, and `pose`, `pose/delegate` and the project's directory below it must be real directories of the user's that no group or other user can write; a task refuses to record or read anywhere else and names the directory (on Windows only links are refused). `--detach` starts a task as the review purposes start a detached run and returns its attempt, its log and the place of its record; a prompt piped to `task -` or `resume --prompt -` is read before detaching and written to the detached run through a pipe, never a file, and a refusal before the attempt is reserved returns the foreground's document and exit code. A detached call keeps its log and hand-back in `.pose/review-private/supervisors`, which, with every directory up to the project root, must be the user's and writable by no group or other user, and whose root's ancestors must belong to the user or root and be writable by no one else unless sticky; the root is resolved once and only that resolved root is used, a caller whose current directory is gone is refused, and a project's private task history is keyed by its resolved root (records an earlier engine kept under a linked spelling are still read). A detached call believes a hand-back only once a piped prompt is through and a run reserved the attempt it names. A checkout that fails this can still run in the foreground; on Windows only links and non-directories are refused, and ACLs are not checked. A task is never evidence: no review reader reads it, `pose review attest --run` refuses it by name, and `wait` returns 0 when the agent succeeded, with no decision. `ls`, `watch`, `wait`, `cancel`, `resume` and `handoff` work on tasks; `resume` without `--prompt` sends a default continuation message, with the agent's `resume.commands` for the task's access, and `--agent auto` routes against the launching session. A task can also continue a session POSE never recorded, such as one a personal launcher opened, with `--session <id> --agent <name>`: the agent's resume command for the access runs with that session, the prompt optional, and the record says it continued a session without keeping it. `pose review dispatch`, `resume` and `status`, the aliases this surface deprecated, were removed: each exits 2 and names its `pose delegate` replacement.\n948:Reservations live in `.pose/review-attempts/`, final receipts link the run, and `.pose/review-run-ledger/` witnesses exact run bytes and transcript digests. Every publication uses the exclusive synced publisher. New runs carry `ledger_version: 1`, `attempt_id` and the optional reason; legacy schema-1 runs retain their original identities, with no invented reservation or signature. An incomplete reservation, missing witness/run/transcript, inconsistent receipt, unknown record or exhausted read budget is explicitly incomplete. Inspect it; no automatic deletion, truncation, repair or retry occurs. Upgrade writers sharing these directories together. Run continuity and authenticated provenance remain separate deliveries.\n956:**Hosted checks and the resident Git memo.** `pose runtime run [--envelope] [--timeout <d>] <command> [args...]` runs `review-check`, `closeout-check`, `artifact-check`, `surface-check` or `roadmap-check` in the runtime of the worktree when one is running, compatible and willing, and standalone in this process otherwise; the exit code and the output are the command's, and `--envelope` prints one document (`pose.runtime.run/1`) with them and with `via` (`runtime` or `standalone`), the `fallback_reason`, the typed `outcome` (`completed`; `error` when the command ran and ended but its output (over 2 MiB) is not sent back, with the command's exit code; or `unknown` for a deadline or a lost answer), the epoch and the memo hits. The runtime refuses, before the command starts, one it does not host and a caller whose environment digest (the `POSE_`, `HARNE8_`, `GIT_`, `CLAUDE` and `CODEX` variables, `XDG_STATE_HOME`, `XDG_CONFIG_HOME` and `XDG_RUNTIME_DIR`, the locale, `HOME`, `NO_COLOR` and the user) differs from its own, so the caller runs standalone; a command that reached the runtime and whose answer did not come back whole, or whose `--timeout` passed, may have run and is never repeated standalone unasked: it exits 1 and says so. The runtime runs hosted commands as the user that started it, in its worktree, with the output of a non-terminal, in the admission lanes described below; a command still waiting for its slot when its `--timeout` passes is refused, not started, so the caller runs it standalone. A runtime also keeps, between commands, the output of the Git reads that are pure functions of object ids or of the commit HEAD named when they ran, keyed by that commit and the shallow state (256 MiB, least recently used first; not for a linked worktree): the second `review-check` of this repository took about 10 s against about 25 s standalone, with the same output. The runtime admits hosted commands in two lanes, each with its own slots and a bounded queue: `short` (`surface-check`, about 10 ms on this repository) and `heavy` (the other hosted commands; `roadmap-check <slug>` takes minutes here), 2 and 1 slots by default and queues of 16 and 4; `pose runtime start|serve` take `--short-slots`, `--heavy-slots`, `--short-queue`, `--heavy-queue` and `--memo-mib` (default 256). A short query is not queued behind a heavy check, and a command that finds every slot of its lane busy and the queue full is refused before it waits and runs standalone. `status` and the handshake carry, per lane, `<lane>_slots`, `_queue_limit`, `_queued`, `_running`, `_admitted`, `_refused`, `_wait_ms_total` and `_wait_ms_max` in `metrics`. A measurement of the runtime on a real repository, with its thresholds fixed before the numbers, is `POSE_RUNTIME_MEASURE=<file> go test ./internal/cli -run TestMeasureTheRuntimeOnTheRealRepository`; its report is under `.pose/reports/`.\\n\\n**Review rounds.** The rounds of a scope are its sealed bundles that a completed delegated review concluded on, in the order those runs ended; `pose review verify`, `pose delegate ls` and `pose insights` show the round. From round 2, the generated brief (template `review-brief/2`; runs briefed with `review-brief/1` still verify) carries a `Previous round` section built from the ledger: every open finding with the identifier it keeps across rounds (`R<round>-<id>`), its severity, disposition and location, the previous run and its draft digest. The reviewer's draft is the fenced code block whose info string is `pose-draft`: JSON with `schema` `pose.review.draft/v1`, `decision` and `findings` (`id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line`, `summary`), and from round 2 `prior_findings` (`id`, `status` fixed|partial|not-fixed|superseded, `evidence`) and `sweep`. A finding reported `partial` or `not-fixed` keeps its identifier in the next brief. A round-2-or-later draft that leaves an open finding unaccounted, calls one `fixed` without evidence or states no sweep is recorded with `draft_problems`, `wait` reports it as `invalid`, and it is never accepted as an approval. With `routing.rounds` `continue-thread` (the default) a round resumes the session the previous round ended with, through the agent's resume command; it opens a new session, recording why, when the agent or its vendor changes, the chain of drafts is broken, that session cannot be resumed, or the round reaches `routing.round_threshold` (5 by default), where `verify` also warns that the rounds are not converging. `cold-session` opens a new session every round. Each run records its `round` and `thread`; `pose insights` reports, per scope, findings per round, rounds to approval, and how prior findings were accounted for in continued and in cold rounds. A previous round whose record is not intact makes the brief refuse.\n958:**Delegated runs over MCP.** `pose_delegate_start` (review, adjudicate or smoke), `pose_delegate_status`, `pose_delegate_wait`, `pose_delegate_resume` and `pose_delegate_handoff` run `pose delegate … --json` in the project the server resolved for the call, so every plan, refusal and run is the CLI's: a start, resume or handoff is always detached and returns once the run has reserved its attempt (without `apply` it previews), a status never blocks, and a wait blocks at most its `timeout_seconds` (300 at most), returning `still-running` when the bound passes. Refusals carry the same `reason_code` as the CLI's error document (`rerun-without-reason`, `budget-exhausted`, `containment-incompatible`, `agent-unavailable`, `no-agent`), and results carry the normalized summary only: no transcript, prompt, session reference or environment value. `pose delegate resume` and `handoff` take `--detach` as the purposes do. A task is not started over MCP.\n ...2026-11-22-validate-carries-unchanged-checks.md |   31 +\n .pose/indexes/delivery-integrity.json              | 2604 +++++++++------\n .pose/indexes/generation.json                      |   16 +-\n .pose/indexes/spec-graph.json                      | 1221 +++----\n .pose/results/delivery-validation.json             | 1800 +++++-----\n ...ose-validate-carries-unchanged-checks-matrix.md |    3 +\n .../1c024e388d325dc56d77af3c/000001.json           |   11 +\n .../1c024e388d325dc56d77af3c/000001.result.json    |    6 +\n .../8840117922a59bca830a748f/000001.json           |   11 +\n .../8840117922a59bca830a748f/000001.result.json    |    6 +\n .../8840117922a59bca830a748f/000002.json           |   12 +\n .../8840117922a59bca830a748f/000002.result.json    |    6 +\n .../ad1d921e7cff58c9fdee3d9b/000001.json           |   11 +\n .../ad1d921e7cff58c9fdee3d9b/000001.result.json    |    6 +\n .../cb45d187edddbc8058d10a4f/000001.json           |   11 +\n .../cb45d187edddbc8058d10a4f/000001.result.json    |    6 +\n .../fda41365aaab0a33f0024cad/000001.json           |   11 +\n .../fda41365aaab0a33f0024cad/000001.result.json    |    6 +\n .../fe1f6e655b23082755555ede/000001.json           |   11 +\n .../fe1f6e655b23082755555ede/000001.result.json    |    6 +\n .../fe48c6d01cb1f704a7443c90/000001.json           |   11 +\n .../fe48c6d01cb1f704a7443c90/000001.result.json    |    6 +\n .pose/review-bundles/rvb-2557a395e6a8121c.json     | 3526 ++++++++++++++++++++\n .pose/review-bundles/rvb-2abee56e5867cac6.json     | 3526 ++++++++++++++++++++\n .pose/review-bundles/rvb-6328a001e83e150f.json     | 3526 ++++++++++++++++++++\n .pose/review-bundles/rvb-b0296611766ddddc.json     | 3508 +++++++++++++++++++\n .pose/review-bundles/rvb-c34faf32453c43f1.json     | 3526 ++++++++++++++++++++\n .pose/review-bundles/rvb-de108bca16e5f2a2.json     | 3526 ++++++++++++++++++++\n .pose/review-bundles/rvb-f509df70749ff77f.json     | 3504 +++++++++++++++++++\n .pose/review-run-ledger/rrn-0dd98c4aab8b5918.json  |    8 +\n .pose/review-run-ledger/rrn-1c033e4c349d7794.json  |    8 +\n .pose/review-run-ledger/rrn-3461f6ff36909419.json  |    8 +\n .pose/review-run-ledger/rrn-360343d3dc95895e.json  |    8 +\n .pose/review-run-ledger/rrn-4b28f2ff95acf9c4.json  |    8 +\n .pose/review-run-ledger/rrn-85704a129332a685.json  |    8 +\n .pose/review-run-ledger/rrn-88e0428bda9bc9c7.json  |    8 +\n .pose/review-run-ledger/rrn-b07ee93779a65e40.json  |    8 +\n .../review-runs/rrn-0dd98c4aab8b5918.events.ndjson |   60 +\n .pose/review-runs/rrn-0dd98c4aab8b5918.json        |  151 +\n .pose/review-runs/rrn-0dd98c4aab8b5918.transcript  |   61 +\n .../review-runs/rrn-1c033e4c349d7794.events.ndjson |   76 +\n .pose/review-runs/rrn-1c033e4c349d7794.json        |  152 +\n .pose/review-runs/rrn-1c033e4c349d7794.transcript  |   77 +\n .../review-runs/rrn-3461f6ff36909419.events.ndjson |   51 +\n .pose/review-runs/rrn-3461f6ff36909419.json        |  154 +\n .pose/review-runs/rrn-3461f6ff36909419.transcript  |   52 +\n .../review-runs/rrn-360343d3dc95895e.events.ndjson |    0\n .pose/review-runs/rrn-360343d3dc95895e.json        |  135 +\n .pose/review-runs/rrn-360343d3dc95895e.transcript  |    0\n .../review-runs/rrn-4b28f2ff95acf9c4.events.ndjson |   44 +\n .pose/review-runs/rrn-4b28f2ff95acf9c4.json        |  154 +\n .pose/review-runs/rrn-4b28f2ff95acf9c4.transcript  |   45 +\n .../review-runs/rrn-85704a129332a685.events.ndjson |   80 +\n .pose/review-runs/rrn-85704a129332a685.json        |  166 +\n .pose/review-runs/rrn-85704a129332a685.transcript  |   81 +\n .../review-runs/rrn-88e0428bda9bc9c7.events.ndjson |   40 +\n .pose/review-runs/rrn-88e0428bda9bc9c7.json        |  155 +\n .pose/review-runs/rrn-88e0428bda9bc9c7.transcript  |   41 +\n .../review-runs/rrn-b07ee93779a65e40.events.ndjson |   34 +\n .pose/review-runs/rrn-b07ee93779a65e40.json        |  154 +\n .pose/review-runs/rrn-b07ee93779a65e40.transcript  |   35 +\n ...11-22-pose-validate-carries-unchanged-checks.md |  215 ++\n POSE.md                                            |    6 +-\n locales/pt-BR/POSE.md                              |    6 +-\n pose-mcp/internal/cli/help_catalog.go              |    1 +\n pose-mcp/internal/cli/validate.go                  |  107 +-\n pose-mcp/internal/cli/validate_carry.go            |  350 ++\n pose-mcp/internal/cli/validate_carry_test.go       |  760 +++++\n .../internal/cli/validate_engine_identity_test.go  |   30 +\n pose-mcp/internal/cli/validate_results.go          |   13 +\n pose-mcp/internal/cli/validate_scope.go            |  122 +-\n pose-mcp/internal/pose/delivery_validation_run.go  |   10 +-\n .../internal/pose/delivery_validation_run_test.go  |   30 +\n pose-mcp/internal/scaffold/dist/POSE.md            |    6 +-\n .../internal/scaffold/dist/locales/pt-BR/POSE.md   |    6 +-\n 75 files changed, 31638 insertions(+), 2540 deletions(-)\n---\ntype: decision-log\nslug: escalation-validate-native\nowner: @pose-maintainers\nsensitivity: public-internal\ncreated_at: 2026-08-14\nlast_reviewed_at: 2026-08-14\nexpires_at: 2026-11-12\nsource_refs:\n  spec: \"pose-component-aware-review-plans\"\n  workflow: \"recurrence-escalation\"\n  commands: [\"pose recurrence-check --tolerant --window-days 30 --threshold 3\", \"pose stats workflows --since-days 30\", \"pose stats tasks --since-days 30 --json\", \"pose validate --strict --module pose-mcp --json .pose/results/delivery-validation.json --report\"]\n  external_sources: []  # [{url: \"\", accessed_at: \"YYYY-MM-DD\"}]\n---\n\n# decision-log: escalation-validate-native\n\n## Context\n\nThe 30-day recurrence projection crossed its threshold for `validate-native`\nwith 13 retained failures. Four recent failures came from\n`.qwen/worktrees/pr15-review`; module discovery recursively treated that\nagent-local worktree as another product module. The same projection flagged\nthree `test-plan-baseline-pose-mcp-active-context` failures from 2026-08-06,\nbut those were implementation retries interleaved with passes and ended with\nstrict PASS on the same day, so they are not uncovered incidents.\n\n## Current state\n\nCommit `3177e80` excludes `.qwen` from validation discovery and adds a\nregression. Commit `39bf6ac` applies the same boundary to repository indexing.\nStrict module validation now passes and its canonical JSON is bound to both\nrelease specs. A 45-day intervention is registered in\n`.pose/reports/history/interventions.jsonl`; the historical failures remain\nappend-only, so `recurrence-check` will continue to report them until the\nwindow ages out.\n\n## Next checks\n\n- After 2026-09-28, run `pose recurrence-effect --min-sample 3` and record a\n  `keep`, `adjust`, or `discard` decision.\n- Expect no new `validate-native` failure whose `report_path` is below\n  `.qwen/worktrees/`; any such failure reopens the discovery boundary.\n- Keep `pose recurrence-check --tolerant --window-days 30 --threshold 3` in\n  review closeout. Success means zero new uncovered failures, not deletion of\n  immutable historical failures.\n\n## Risks\n\nThe pre-intervention sample mixes ordinary development failures with the\nrecursive-worktree defect, so effectiveness may be inconclusive. Classify\nfuture records by execution root and cause, preserve all outcomes, and do not\nclaim success before the observation window completes.\n\n## Next owner\n\n`@pose-maintainers` on or after 2026-09-28.\n\n## References\n\n- `spec:pose-component-aware-review-plans`\n- `knowledge:pr15-component-aware-review-provenance`\n- `.pose/workflows/recurrence-escalation.md`\n- `.pose/reports/history/standard-validate-native.jsonl`\n- `.pose/reports/history/standard-test-plan-baseline-pose-mcp-active-context.jsonl`\n- Commits `3177e80` and `39bf6ac`\n# Adversarial corpus\n\nSpec: `pose-mechanization-adversarial-corpus`. Test: `adversarial_corpus_test.go`.\n\nEvery gate POSE adds against mechanical compliance can itself be satisfied\nmechanically. Each row is the cheapest formal satisfaction of one gate. An\n`enforced` case fails the build when the shortcut works again; a `known-gap`\ncase fails the build when the gap closes, so it cannot close or reopen\nsilently; a `planned` case belongs to a spec not yet delivered and gains code\nbefore that spec closes; a `delegated` case is enforced by a test in another\npackage, named in the row, whose existence the corpus checks.\n\nThis corpus belongs to developing POSE's governance. It adds no checklist to an\nadopting project's features.\n\n| Case | Status | Shortcut it refuses | Owner |\n|---|---|---|---|\n| `human-label-without-confirmation` | enforced | An agent writes and applies a review under `human:<name>`; the record reads as a human review | pose-review-attribution-roles |\n| `declared-independent-prefix` | enforced | `agent:independent-*` under declared assurance reads as authenticated separation | pose-review-assurance-disclosure |\n| `confirmation-reused-for-edited-content` | enforced | A confirmation recorded for one set of conclusions is kept after they change | pose-review-attribution-roles |\n| `unknown-recorded-as-satisfied` | enforced | An obligation the engine could not observe is reported as satisfied | pose-obligation-contract |\n| `legacy-blocker-gains-an-actor` | enforced | A blocker known only as text is given an invented recipient | pose-obligation-contract |\n| `blocked-counted-as-resolved` | enforced | Operational waiting counts as a resolved outcome in success metrics | pose-blocked-semantics-alignment |\n| `flat-specs-share-one-journal` | enforced | Two flat specs record amendments in one shared journal | pose-flat-spec-amendments |\n| `local-metadata-read-as-published` | enforced | A locally read version is presented as a proven publication | pose-public-claims-publication-provenance |\n| `invented-trace-test-ref` | known-gap | A requirement trace cites a test that does not exist and `lint-spec --strict` passes (follow-up 097 of pose-abm-design-basis) | pose-mechanization-adversarial-corpus |\n| `unavailable-producer-reads-as-empty` | enforced | A producer fails and Attention reports zero obligations as a complete answer | pose-obligation-projection |\n| `trivial-change-raises-a-request` | enforced | A trivial change or an already-authorized instruction produces an ActionRequest | pose-action-requests |\n| `declined-approval-satisfies` | enforced | A declined approval, or a cancellation without authority, releases a gate | pose-action-request-resolution |\n| `closeout-plan-fills-judgment` | enforced | The recoverable closeout plan answers a judgment criterion to finish | pose-recoverable-closeout-plan |\n| `ready-from-absent-blockers` | enforced | Absence of a known blocker is presented as proven independence | pose-phase-scoped-readiness |\n| `stale-preview-authorizes-apply` | enforced | A start previewed before a restricting request is applied after it | pose-governed-effect-enforcement |\n| `code-change-keeps-judgment` | enforced | The reviewed code changes and every criterion still reads as equivalent, so the old judgment is reused | pose-material-equivalence-reuse |\n| `minimal-surface-skips-trace` | enforced | A done spec declares the minimal surface to drop its requirement trace | pose-progressive-spec-surface |\n| `stale-assessment-reused` | enforced | The assessed component changes and the old assessment still reads as fresh | pose-adaptive-assessment-freshness |\n| `unpinned-premise-trigger-reads-current` | enforced | A premise trigger without a pin can never go stale and nothing says so | pose-assumption-validity-scope |\n| `calendar-ttl-as-premise-trigger` | enforced | An arbitrary expiry date is accepted as the material trigger of a premise | pose-assumption-validity-scope |\n| `unobserved-falsifier-reads-uncontradicted` | enforced | An unbound legacy index cannot prove that a falsifier check was never observed | pose-falsifier-reconsideration |\n| `parity-row-cites-an-unrelated-test` | known-gap | A launcher parity row names a real but unrelated `pose delegate` command and an existing test that does not exercise the capability, and the parity check passes; the check proves existence, review of the cited tests proves coverage | pose-delegation-parity-gate |\n| `imported-fragment-completes-a-replaced-command` | known-gap | A usage or error string assembles a removed command from a constant of another package of the module, which the active-document check reads as a gap; review of assembled messages is the defence | pose-delegation-parity-gate |\n| `cgo-preamble-text-reaches-usage` | known-gap | Operator text written as a C string in a cgo preamble reaches a usage surface; the Go reader sees a comment, not a string | pose-delegation-parity-gate |\n| `later-removal-hides-a-later-touch` | delegated | A later removal satisfies an earlier spec's claim because the history it is judged on omits that spec's change after the removal — change sets in ID order, a merge, root or type-change touch, a failed or shallow read, a recorded report too wide to read whole or a history directory that cannot be listed, a replace ref or graft (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_gaps_test.go:TestLaterRemovalReviewRoundTwo`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundFive`) | pose-delivery-later-removal |\n| `rename-read-as-removal` | delegated | A rename, or a path spelled as a pathspec, is taken for the declared deletion (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`) | pose-delivery-later-removal |\n| `recorded-commit-is-an-option` | delegated | A change set read from a recorded report names a Git option or a tag where a commit belongs (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`) | pose-delivery-later-removal |\n| `peer-removal-stands-for-a-member` | delegated | A review subject digests a removed path from a peer's accepted removal while another observing member — sorted later, sharing a commit, or reduced into the peer's set — has none, whatever action or rename it observed the path with (`pose/review_subject_later_removal_test.go:TestReviewSubjectReadsALaterRemovalFromItsWitness`, `pose/review_subject_later_removal_test.go:TestMilestoneSubjectRemovalHoldsForEveryMember`) | pose-review-subject-later-removal |\n| `retained-child-skips-its-verification` | delegated | A milestone seals over a done member whose own review verification no longer retains its approval — revoked federated trust, lost history, a later negative review (`pose/review_subject_later_removal_test.go:TestRetainedChildFollowsItsVerification`, `pose/review_subject_later_removal_test.go:TestMilestoneSealRetainsADoneChildsApprovedReview`) | pose-review-subject-later-removal |\n| `run-pattern-names-no-test` | delegated | A validation check's `-run` alternative names a test that no longer exists, or never did, and the check passes on Go's exit 0 — through `-run=`, a build-excluded or ignored file, a vendored or nested-module declaration, a benchmark or a name Go does not run (`cli/validation_matrix_patterns_test.go:TestDeadRunPatternGuardFollowsGoSelection`, `cli/validation_matrix_patterns_test.go:TestValidationMatrixRunPatternsNameExistingTests`); a non-plain pattern passes only when listed with its reason | pose-validation-matrix-dead-test-patterns |\n| `removal-witness-outlives-its-history` | delegated | A stale index keeps counting a removal after a later touch, through a merge, a rewritten history or a shallow clone that lost the touch (`pose/removal_witness_freshness_test.go:TestLaterTouchRefusesTheWitness`, `pose/removal_witness_freshness_test.go:TestShallowHistoryRefusesTheWitness`) | pose-removal-witness-freshness |\n| `parent-outlives-a-rejected-child` | delegated | A milestone or roadmap stays approved over a child's later rejection, through retention, a sealed cycle, a replaced approval or a forged `replaces` (`pose/review_approval_follows_children_test.go:TestParentApprovalFollowsAChildsRejection`, `pose/review_approval_follows_children_test.go:TestChildCycleEndsInARefusal`, `pose/review_approval_follows_children_test.go:TestForgedReplacementRetiresNothing`, `pose/review_approval_follows_children_test.go:TestLegacyCoordinatedMatchingFollowsLineage`) | pose-review-approval-follows-children |\n| `go-check-ran-no-test` | delegated | A `go test` check selects nothing and passes on Go's exit 0, through a flag spelling, a flag's value read as a flag, or a package without test files (`cli/validate_empty_go_checks_test.go:TestValidateRefusesAGoCheckThatRanNoTest`, `cli/validate_empty_go_checks_test.go:TestGoTestSelection`); a check outside the plain grammar passes unjudged, and a test printing a result line can still mislead it | pose-validate-refuses-empty-go-checks |\n| `request-opened-after-preview-transfers` | delegated | A request opened after a transfer preview is moved with the spec (`pose/spec_transfer_actions_test.go:TestTransferRefusesARequestOpenedAfterThePreview`) | pose-transfer-preserves-obligations |\n\n| `deleted-reservation-resets-quota` | delegated | Deleting a reservation and receipt makes a surviving run stop consuming quota | pose-delegated-review-attempt-ledger |\n| `witness-bundle-filter-hides-loss` | delegated | Editing a witness bundle makes scoped readers skip its corruption | pose-delegated-review-attempt-ledger |\n| `window-erases-rerun` | delegated | Moving a prior run outside the time window turns a rerun into a first attempt | pose-delegated-review-attempt-ledger |\n| `canned-executor-approval-proves-cognition` | delegated | A complete canned approval from a trusted local command is presented as proof of review cognition or a vendor receipt (`cli/delegated_review_capability_test.go:TestDelegatedReviewCapabilityCannedApprovalDisclosesItsLimits` guards disclosure; the engine cannot detect canned judgments) | pose-delegated-review-capability |\n| `oversized-writer-publishes-unreadable-run` | delegated | A writer reports completion for a run its bounded reader immediately refuses | pose-delegated-review-attempt-ledger |\n","exit_code":0,"status":"completed"}}
