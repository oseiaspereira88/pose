 strings.HasPrefix(p, dep+\"/\") || strings.HasPrefix(dep, p+\"/\") {\n   291\t\t\t\t\treturn true\n   292\t\t\t\t}\n   293\t\t\t}\n   294\t\t\treturn false\n   295\t\t}\n   296\t\tfor _, entry := range strings.Split(string(out), \"\\x00\") {\n   297\t\t\tif !strings.HasPrefix(entry, \"120000 \") {\n   298\t\t\t\tcontinue\n   299\t\t\t}\n   300\t\t\ttab := strings.IndexByte(entry, '\\t')\n   301\t\t\tif tab < 0 {\n   302\t\t\t\treturn \"\", fmt.Errorf(\"unexpected tree entry %q\", entry)\n   303\t\t\t}\n   304\t\t\tfields := strings.Fields(entry[:tab])\n   305\t\t\tif len(fields) != 3 {\n   306\t\t\t\treturn \"\", fmt.Errorf(\"unexpected tree entry %q\", entry)\n   307\t\t\t}\n   308\t\t\tlink := entry[tab+1:]\n   309\t\t\tblob, err := posemodel.RawGit(\"-C\", root, \"cat-file\", \"blob\", fields[2]).Output()\n   310\t\t\tif err != nil {\n   311\t\t\t\treturn \"\", err\n   312\t\t\t}\n   313\t\t\ttarget := string(blob)\n   314\t\t\tresolved := path.Clean(path.Join(path.Dir(link), target))\n   315\t\t\tif path.IsAbs(target) || resolved == \"..\" || strings.HasPrefix(resolved, \"../\") || touches(link) || touches(resolved) {\n   316\t\t\t\treturn link, nil\n   317\t\t\t}\n   318\t\t}\n   319\t\treturn \"\", nil\n   320\t}\n   321\t\n   322\t// caseInsensitiveFilesystem reports whether root's filesystem folds case: the\n   323\t// upper-case spelling of its .git entry names the same file.\n   324\tfunc caseInsensitiveFilesystem(root string, stat func(string) (os.FileInfo, error)) bool {\n   325\t\tlower, err := stat(filepath.Join(root, \".git\"))\n   326\t\tif err != nil {\n   327\t\t\treturn true\n   328\t\t}\n   329\t\tupper, err := stat(filepath.Join(root, \".GIT\"))\n   330\t\treturn err == nil && os.SameFile(lower, upper)\n   331\t}\n   332\t\n   333\t// duplicateCheckID returns a check id the matrix defines more than once.\n   334\tfunc duplicateCheckID(matrix validationMatrix, modules []validationModule) string {\n   335\t\tseen := map[string]bool{}\n   336\t\tf