e/delivery_surface.go:656:\t\tif result.GitHead == set.Head || result.GitHead == set.ResolvedHead {\npose-mcp/internal/pose/delivery_surface.go:660:\t\t\tif result.GitHead == commit {\npose-mcp/internal/pose/delivery_integrity_compact_test.go:39:\t\t\tGitHead: \"abc123\", GeneratedAt: \"2026-10-02T00:00:00Z\", ProvenanceDigest: base.ProvenanceDigest, Report: \".pose/results/delivery-validation.json\", ScopeProvenance: scope,\npose-mcp/internal/pose/delivery_integrity_compact_test.go:90:\t\tif result.ScopeProvenance[\"spec-03\"] == \"\" || result.GitHead != \"abc123\" || result.Report == \"\" {\npose-mcp/internal/pose/delivery_integrity_compact.go:41:\tGitHead            string            `json:\"git_head,omitempty\"`\npose-mcp/internal/pose/delivery_integrity_compact.go:165:\t\trun := compactValidationRun{GitHead: result.GitHead, GeneratedAt: result.GeneratedAt, ProvenanceDigest: result.ProvenanceDigest, Report: result.Report, ScopeProvenance: result.ScopeProvenance, MaterialProvenance: result.MaterialProvenance}\npose-mcp/internal/pose/delivery_integrity_compact.go:166:\t\tif run.GitHead != \"\" || run.GeneratedAt != \"\" || run.ProvenanceDigest != \"\" || run.Report != \"\" || len(run.ScopeProvenance) > 0 || len(run.MaterialProvenance) > 0 {\npose-mcp/internal/pose/delivery_integrity_compact.go:259:\t\t\texpanded.GitHead, expanded.GeneratedAt, expanded.ProvenanceDigest, expanded.Report = run.GitHead, run.GeneratedAt, run.ProvenanceDigest, run.Report\npose-mcp/internal/pose/delivery_validation_run.go:20:\t\tGitHead            string            `json:\"git_head,omitempty\"`\npose-mcp/internal/pose/delivery_validation_run.go:33:\t\t\tCarriedFrom        string `json:\"carried_from,omitempty\"`\npose-mcp/internal/pose/delivery_validation_run.go:34:\t\t\tCarriedGeneratedAt string `json:\"carried_generated_at,omitempty\"`\npose-mcp/internal/pose/delivery_validation_run.go:45:\t\thead, generated := run.GitHead, run.GeneratedAt\npose-mcp/internal/pose/delivery_validation_run.go:46:\t\tif check.CarriedFrom != \"\" {\npose-mcp/internal/pose/delivery_validation_run.go:47:\t\t\thead, generated = check.CarriedFrom, check.CarriedGeneratedAt\npose-mcp/internal/pose/delivery_validation_run.go:49:\t\tresults = append(results, DeliveryValidationResult{ID: check.ID, Module: check.Module, Check: check.Name, EvidenceClass: check.EvidenceClass, Severity: check.Severity, Outcome: check.Outcome, GitHead: head, GeneratedAt: generated, ProvenanceDigest: run.ProvenanceDigest, ScopeProvenance: run.ScopeProvenance, MaterialProvenance: run.MaterialProvenance, Report: relative})\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:2:slug: pose-changed-scope-validation\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:11:# Spec: Explainable changed-scope validation\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:38:- Without changed-scope flags, preserve full validation.\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:46:- Add revision and changed-scope options with explain output.\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:64:- [x] Define deterministic revision, dependency and policy inputs: `--changed-from <rev> [--changed-to <rev>]` with a safe revision grammar rejecting option injection before Git runs; `dependsOn` edges added to `module-metadata.json`; policy widening for `criticality: high` (ADR `2026-07-19-explainable-changed-scope-selection`). ([reference](https://nx.dev/ci/features/affected))\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:66:- [x] Test rename, delete, shared library and uncertain dependency cases: `validate_scope_test.go` covers direct selection with `--explain` reasons, dependency-chain widening, root-level change running everything, all-skipped-with-reasons when nothing changed, and unsafe-revision rejection; unselected checks are recorded `skipped` in the structured result with a machine-readable reason (composes with the result contract from milestone 1). ([reference](https://nx.dev/ci/features/affected))\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:74:- ADR `.pose/adr/2026-07-19-explainable-changed-scope-selection.md` (Accepted): path prefixes + declared dependency edges + policy widening with reasons everywhere, over per-language build-graph analysis (contradicts the thin deterministic core and the non-goal against perfect semantic impact analysis).\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:83:- Readiness: `pose lint-spec pose-changed-scope-validation --ready-check`.\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:95:- `pose check --strict` — SUCCESS; `pose lint-spec pose-changed-scope-validation --strict` — SUCCESS.\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:100:### Delivered scope\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:102:Deterministic changed-scope selection (`--changed-from/--changed-to`) over\n.pose/specs/2026-07-18-pose-changed-scope-validation.md:116:- [open] Seed dependsOn edges for this repository's real modules (pose-mcp, mcp-enforce) once cross-module coupling needs scoped validation. (owner:@pose-maintainers crit:low review:2026-10-16)\n.pose/adr/2026-07-19-explainable-changed-scope-selection.md:1:# ADR: Explainable changed-scope selection\n.pose/adr/2026-07-19-explainable-changed-scope-selection.md:4:Accepted (2026-07-19) — spec `pose-changed-scope-validation`\n.pose/adr/2026-07-19-explainable-changed-scope-selection.md:38:  `changed-scope: module not affected by <base>..<head>`; `--explain`\npose-mcp/internal/cli/suggest_review_regression_test.go:347:func TestSuggestAndTheCheckerRefuseANonCanonicalSpellingOfAnOperationalField(t *testing.T) {\npose-mcp/internal/cli/publicclaims_test.go:113:func TestPublicClaimsFailsOnSchemaOrgVersionAndNonCanonicalDocs(t *testing.T) {\npose-mcp/internal/cli/multirepo_agent_flow_test.go:262:func TestMultiRepoAgentNegativeTransferBlocksUntilCanonicalAuthorityIsActive(t *testing.T) {\npose-mcp/internal/cli/validate_results_