s(+), 4200 deletions(-)\ndiff --git a/.pose/changelogs/unreleased/pose-claude-sandboxed-profile.md b/.pose/changelogs/unreleased/pose-claude-sandboxed-profile.md\nnew file mode 100644\nindex 00000000..e4d19008\n--- /dev/null\n+++ b/.pose/changelogs/unreleased/pose-claude-sandboxed-profile.md\n@@ -0,0 +1,6 @@\n+---\n+spec: pose-claude-sandboxed-profile\n+category: added\n+breaking: false\n+---\n+The Claude agent of the delegation policy offers a `sandboxed` access profile, as Codex does, using the Claude Code operating-system sandbox. The profile refuses to start, naming which of bubblewrap and socat is missing and how to install it, rather than letting Claude Code run its commands unsandboxed.\ndiff --git a/.pose/starts/pose-claude-sandboxed-profile.json b/.pose/starts/pose-claude-sandboxed-profile.json\nnew file mode 100644\nindex 00000000..551a918c\n--- /dev/null\n+++ b/.pose/starts/pose-claude-sandboxed-profile.json\n@@ -0,0 +1,48 @@\n+{\n+  \"schema_version\": 1,\n+  \"spec\": \"pose-claude-sandboxed-profile\",\n+  \"plan_digest\": \"e8912fb3a463f899fba458d5e2d6baefbb49fd74c67d3045466b1543e692399d\",\n+  \"revision\": \"fe1738ee7d5264918876d58cb619e2c89ffa5149\",\n+  \"spec_digest_before\": \"e74ab5edea379fb454db02e434052cd605eb4f6c41fe8cc339a16db717674e44\",\n+  \"spec_digest_after\": \"33c2897d991356c4a62754f293a8e5135f4e195739bb4505dce15e60a7d8d807\",\n+  \"baseline\": {\n+    \"schema_version\": 1,\n+    \"namespace\": \"spec:pose-claude-sandboxed-profile\",\n+    \"nodes\": [\n+      {\n+        \"id\": \"R1\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-claude-sandboxed-profile\",\n+        \"hash\": \"02af24b572d2\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R2\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-claude-sandboxed-profile\",\n+        \"hash\": \"9121963ecb0a\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R3\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-claude-sandboxed-profile\",\n+        \"hash\": \"1b509d5996d1\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"D1\",\n+        \"kind\": \"decision\",\n+        \"namespace\": \"spec:pose-claude-sandboxed-profile\",\n+        \"hash\": \"73d76c8b5edb\",\n+        \"state\": \"active\",\n+        \"relations\": [\n+          \"R2\"\n+        ]\n+      }\n+    ],\n+    \"digest\": \"sha256:5ce5f68038c0e0dec70f588abfbf859980a114aca85233f934768e51a5950a31\"\n+  },\n+  \"phase\": \"started\",\n+  \"recorded_at\": \"2026-11-09T15:27:09Z\"\n+}\ndiff --git a/pose-mcp/internal/cli/delegate.go b/pose-mcp/internal/cli/delegate.go\nindex e9cc89bc..68bc3831 100644\n--- a/pose-mcp/internal/cli/delegate.go\n+++ b/pose-mcp/internal/cli/delegate.go\n@@ -1187,6 +1187,9 @@ type delegateAgentRow struct {\n \tLimitedUntil      string   `json:\"limited_until,omitempty\"`\n \tDetail            string   `json:\"detail,omitempty\"`\n \tIndependentOfLead *bool    `json:\"independent_of_lead,omitempty\"`\n+\t// Unavailable names the access profiles whose dependencies are missing, with what is\n+\t// missing and how to install it.\n+\tUnavailable map[string]string `json:\"unavailable_access,omitempty\"`\n }\n \n func cmdDelegateAgents(root string, args []string, stdout, stderr io.Writer) int {\n@@ -1233,6 +1236,12 @@ func cmdDelegateAgents(root string, args []string, stdout, stderr io.Writer) int\n \t\t// limited is the state routing reads now; limit_reset_at stays the\n \t\t// reset of the last limit ever recorded.\n \t\trow.Limited = a.State == posemodel.DelegationAgentLimited\n+\t\tfor access, missing := range agent.MissingRequirements() {\n+\t\t\tif row.Unavailable == nil {\n+\t\t\t\trow.Unavailable = map[string]string{}\n+\t\t\t}\n+\t\t\trow.Unavailable[access] = tr(\"missing \", \"falta \") + strings.Join(missing, \", \") + installHint(agent, access)\n+\t\t}\n \t\tif f.lead != \"\" {\n \t\t\tindependent := !strings.EqualFold(strings.TrimSpace(agent.Vendor), leadVendor(f.lead))\n \t\t\trow.IndependentOfLead = &independent\n@@ -1275,11 +1284,27 @@ func cmdDelegateAgents(root string, args []string, stdout, stderr io.Writer) int\n \t\tif row.IndependentOfLead != nil {\n \t\t\tvalue += fmt.Sprintf(\" independent_of_lead=%t\", *row.IndependentOfLead)\n \t\t}\n+\t\taccesses := make([]string, 0, len(row.Unavailable))\n+\t\tfor access := range row.Unavailable {\n+\t\t\taccesses = append(accesses, access)\n+\t\t}\n+\t\tsort.Strings(accesses)\n+\t\tfor _, access := range accesses {\n+\t\t\tvalue += \" unavailable_access=\" + access + \"(\" + row.Unavailable[access] + \")\"\n+\t\t}\n \t\tout.Field(\"delegate.agent.\"+row.Name, value)\n \t}\n \treturn 0\n }\n \n+// installHint is how to install what an access profile needs, when the policy says.\n+func installHint(agent posemodel.DelegationAgent, access string) string {\n+\tif install := agent.Requires[access].Install; install != \"\" {\n+\t\treturn tr(\"; install: \", \"; instale: \") + install\n+\t}\n+\treturn \"\"\n+}\n+\n func containsString(values []string, wanted string) bool {\n \tfor _, value := range values {\n \t\tif value == wanted {\ndiff --git a/pose-mcp/internal/cli/delegate_requirements_test.go b/pose-mcp/internal/cli/delegate_requirements_test.go\nnew file mode 100644\nindex 00000000..6a339e88\n--- /dev/null\n+++ b/pose-mcp/internal/cli/delegate_requirements_test.go\n@@ -0,0 +1,27 @@\n+package cli\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-claude-sandboxed-profile R4: `delegate agents` and `doctor` say which profile\n+// is unavailable and how to install what it needs.\n+func TestDelegateAgentsAndDoctorSayHowToInstallWhatAProfileNeeds(t *testing.T) {\n+\troot := t.TempDir()\n+\tpolicy := `{\"schema_version\":2,\"agents\":{\"a1\":{\"vendor\":\"v\",\"model\":\"m\",\"cli\":\"sh\",\"commands\":{\"read\":[\"sh\"],\"sandboxed\":[\"sh\"]},` +\n+\t\t`\"requires\":{\"sandboxed\":{\"executables\":[\"definitely-not-installed-xyz\"],\"install\":\"apt install xyz\"}}}},\"purposes\":{}}`\n+\tif err := os.MkdirAll(filepath.Join(root, \".pose\", \"policy\"), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.WriteFile(filepath.Join(root, \".pose\", \"policy\", \"delegation.json\"), []byte(policy), 0o644); err != nil {\n+\t\tt.Skip(err)\n+\t}\n+\tvar out, errb strings.Builder\n+\t_ = cmdDelegateAgents(root, nil, &out, &errb)\n+\tif !strings.Contains(out.String(), \"unavailable_access=sandboxed(\") || !strings.Contains(out.String(), \"apt install xyz\") {\n+\t\tt.Fatalf(\"delegate agents does not say the profile is unavailable and how to install: %s %s\", out.String(), errb.String())\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/delegate_watch.go b/pose-mcp/internal/cli/delegate_watch.go\nindex 2aa777c2..d9937817 100644\n--- a/pose-mcp/internal/cli/delegate_watch.go\n+++ b/pose-mcp/internal/cli/delegate_watch.go\n@@ -146,23 +146,14 @@ func chooseWatchedAttempt(root string, attempts []posemodel.DelegationAttempt, f\n // pickAttempt opens fzf with a live preview of the run under the cursor, or a\n // numbered menu without it.\n func pickAttempt(root string, candidates []posemodel.DelegationAttempt, f delegateFlags, stderr io.Writer) (string, error) {\n-\tlines := make([]string, 0, len(candidates))\n-\tfor _, a := range candidates {\n-\t\t// The id leads and is hidden (--with-nth 2..): it is what {1} hands the preview.\n-\t\t// The columns are padded so the state, the agent and the age line up and the label,\n-\t\t// which varies in length, comes last.\n-\t\tlines = append(lines, fmt.Sprintf(\"%s\\t%-11s %-18s %-5s %s\", a.AttemptID, delegateStateGlyph(a.State)+\" \"+a.State, a.Agent, delegateAge(a.StartedAt), a.Label))\n-\t}\n+\tlines := pickerLines(candidates)\n \tif path, err := exec.LookPath(delegatePicker); err == nil {\n \t\tself, err := os.Executable()\n \t\tif err != nil {\n \t\t\treturn \"\", err\n \t\t}\n \t\tpreview := pickerPreviewCommand(self, f)\n-\t\tcmd := exec.Command(path, \"--delimiter\", \"\\t\", \"--with-nth\", \"2..\", \"--preview\", preview,\n-\t\t\t\"--preview-window\", \"right,55%,border-left,wrap\", \"--layout\", \"reverse\", \"--height\", \"90%\", \"--border\",\n-\t\t\t\"--prompt\", tr(\"run> \", \"run> \"), \"--no-sort\",\n-\t\t\t\"--header\", fmt.Sprintf(\"%-11s %-18s %-5s %s\", tr(\"STATE\", \"ESTADO\"), tr(\"AGENT\", \"AGENTE\"), tr(\"AGE\", \"IDADE\"), tr(\"LABEL\", \"RÓTULO\")))\n+\t\tcmd := exec.Command(path, pickerArgs(preview, candidates)...)\n \t\tcmd.Dir = root\n \t\tcmd.Stdin = strings.NewReader(strings.Join(lines, \"\\n\") + \"\\n\")\n \t\tcmd.Stderr = stderr\n@@ -186,6 +177,48 @@ func pickAttempt(root string, candidates []posemodel.DelegationAttempt, f delega\n \treturn candidates[n-1].AttemptID, nil\n }\n \n+// pickerStateWidth is the width of the state column: the widest \"glyph state\" among the\n+// candidates, counted in code points, and never less than the header.\n+func pickerStateWidth(candidates []posemodel.DelegationAttempt) int {\n+\twidth := utf8.RuneCountInString(tr(\"STATE\", \"ESTADO\"))\n+\tfor _, a := range candidates {\n+\t\tif n := utf8.RuneCountInString(delegateStateGlyph(a.State) + \" \" + a.State); n > width {\n+\t\t\twidth = n\n+\t\t}\n+\t}\n+\treturn width\n+}\n+\n+// pickerLines are the rows fzf shows. The id leads and is hidden (--with-nth 2..): it is what\n+// {1} hands the preview. The columns are padded so the state, the agent and the age line up\n+// and the label, which varies in length, comes last.\n+func pickerLines(candidates []posemodel.DelegationAttempt) []string {\n+\twidth := pickerStateWidth(candidates)\n+\tlines := make([]string, 0, len(candidates))\n+\tfor _, a := range candidates {\n+\t\tlines = append(lines, fmt.Sprintf(\"%s\\t%s %-18s %-5s %s\", a.AttemptID, padCells(delegateStateGlyph(a.State)+\" \"+a.State, width), a.Agent, delegateAge(a.StartedAt), a.Label))\n+\t}\n+\treturn lines\n+}\n+\n+// padCells pads to width code points; fmt pads by bytes of the rune count only for ASCII-safe\n+// widths, and the glyphs are multi-byte.\n+func padCells(s string, width int) string {\n+\tif n := utf8.RuneCountInString(s); n < width {\n+\t\treturn s + strings.Repeat(\" \", width-n)\n+\t}\n+\treturn s\n+}\n+\n+// pickerArgs are the arguments of fzf: the hidden id, the preview, the layout and the header\n+// over the same columns as the rows.\n+func pickerArgs(preview string, candidates []posemodel.DelegationAttempt) []string {\n+\treturn []string{\"--delimiter\", \"\\t\", \"--with-nth\", \"2..\", \"--preview\", preview,\n+\t\t\"--preview-window\", \"right,55%,border-left,wrap\", \"--layout\", \"reverse\", \"--height\", \"90%\", \"--border\",\n+\t\t\"--prompt\", \"run> \", \"--no-sort\",\n+\t\t\"--header\", fmt.Sprintf(\"%s %-18s %-5s %s\", padCells(tr(\"STATE\", \"ESTADO\"), pickerStateWidth(candidates)), tr(\"AGENT\", \"AGENTE\"), tr(\"AGE\", \"IDADE\"), tr(\"LABEL\", \"RÓTULO\"))}\n+}\n+\n // pickerPreviewCommand is the command fzf runs for the run under the cursor. fzf hands it to\n // the user's login shell ($SHELL -c), which may be fish or any other: the command is\n // therefore one word of POSIX sh, `sh -c '<script>' <pose> {1}`, with the script in single\ndiff --git a/pose-mcp/internal/cli/delegate_watch_picker_test.go b/pose-mcp/internal/cli/delegate_watch_picker_test.go\nindex 360f9614..72832cb1 100644\n--- a/pose-mcp/internal/cli/delegate_watch_picker_test.go\n+++ b/pose-mcp/internal/cli/delegate_watch_picker_test.go\n@@ -5,6 +5,9 @@ import (\n \t\"strings\"\n \t\"testing\"\n \t\"time\"\n+\t\"unicode/utf8\"\n+\n+\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n )\n \n // Spec pose-delegate-picker-and-claude-runs.\n@@ -43,3 +46,42 @@ func TestTheStateGlyphIsOneCellAndEveryStateHasOne(t *testing.T) {\n \t\t}\n \t}\n }\n+\n+// R2/R3: the rows and the arguments of the picker. The state column is as wide as the widest\n+// \"glyph state\" in code points, so no state shifts the columns after it; the id leads and is\n+// hidden; the layout is reversed with a border and a header over the same columns.\n+func TestThePickerRowsAlignEveryStateAndTheArgumentsHideTheID(t *testing.T) {\n+\tcandidates := []posemodel.DelegationAttempt{\n+\t\t{AttemptID: \"a1\", State: \"completed\", Agent: \"x\", Label: \"one\"},\n+\t\t{AttemptID: \"a2\", State: \"interrupted\", Agent: \"y\", Label: \"two\"},\n+\t\t{AttemptID: \"a3\", State: \"running\", Agent: \"z\", Label: \"three\"},\n+\t}\n+\tvar agentAt []int\n+\tfor i, line := range pickerLines(candidates) {\n+\t\tif !strings.HasPrefix(line, candidates[i].AttemptID+\"\\t\") {\n+\t\t\tt.Errorf(\"the id does not lead row %d: %q\", i, line)\n+\t\t}\n+\t\t_, rest, _ := strings.Cut(line, \"\\t\")\n+\t\tat := utf8.RuneCountInString(rest[:strings.Index(rest, string(candidates[i].Agent[0])+\" \")])\n+\t\tagentAt = append(agentAt, at)\n+\t}\n+\tfor _, at := range agentAt {\n+\t\tif at != agentAt[0] {\n+\t\t\tt.Fatalf(\"the agent column shifts between states: %v\", agentAt)\n+\t\t}\n+\t}\n+\tif want := utf8.RuneCountInString(\"◐ interrupted\"); agentAt[0] < want {\n+\t\tt.Errorf(\"the state column (%d) is narrower than the widest state (%d)\", agentAt[0], want)\n+\t}\n+\targs := strings.Join(pickerArgs(\"PREVIEW\", candidates), \"\\x00\")\n+\tfor _, want := range []string{\"--with-nth\\x002..\", \"--layout\\x00reverse\", \"--border\", \"--preview\\x00PREVIEW\", \"--delimiter\\x00\\t\"} {\n+\t\tif !strings.Contains(args, want) {\n+\t\t\tt.Errorf(\"the picker arguments lack %q\", want)\n+\t\t}\n+\t}\n+\theader := pickerArgs(\"P\", candidates)\n+\thdr := header[len(header)-1]\n+\tif got := utf8.RuneCountInString(hdr[:strings.Index(hdr, \"AGENT\")]); got != agentAt[0] {\n+\t\tt.Errorf(\"the header does not line up with the rows: %q\", hdr)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/doctor.go b/pose-mcp/internal/cli/doctor.go\nindex 77ec3620..8944a53d 100644\n--- a/pose-mcp/internal/cli/doctor.go\n+++ b/pose-mcp/internal/cli/doctor.go\n@@ -1000,6 +1000,19 @@ func runDoctorDiagnostics(locale cliLocale) (root string, findings []doctorFindi\n \t\t\t\t\t}\n \t\t\t\t}\n \t\t\t}\n+\t\t\t// A delegation profile whose dependencies are not installed would start and\n+\t\t\t// fail, or run without the guarantee it names: say so before it is used (spec\n+\t\t\t// pose-claude-sandboxed-profile).\n+\t\t\tif policy, _, found, policyErr := (posemodel.Store{Root: root}).LoadDelegationPolicy(); policyErr == nil && found {\n+\t\t\t\tfor _, name := range policy.DeclaredAgentNames() {\n+\t\t\t\t\tagent := policy.Agents[name]\n+\t\t\t\t\tfor access, missing := range agent.MissingRequirements() {\n+\t\t\t\t\t\tadd(\"delegation.requirements\", \"warn\",\n+\t\t\t\t\t\t\tfmt.Sprintf(text(\"agent %s: its %s profile needs %s, which is not installed\", \"agente %s: o perfil %s precisa de %s, que não está instalado\"), name, access, strings.Join(missing, \", \")),\n+\t\t\t\t\t\t\tstrings.TrimPrefix(installHint(agent, access), \"; \")+text(\" — until then that profile refuses to start\", \" — até lá esse perfil recusa iniciar\"))\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t}\n \t\t\t// Capabilities this project has not decided for the engine it runs\n \t\t\t// are a next step, not a fault (spec pose-setup-command).\n \t\t\tif pending, pendingErr := posemodel.CapabilitiesToReview(root, version.ReleaseBase()); pendingErr == nil && len(pending) > 0 {\ndiff --git a/pose-mcp/internal/pose/claude_sandboxed_profile_test.go b/pose-mcp/internal/pose/claude_sandboxed_profile_test.go\nnew file mode 100644\nindex 00000000..1457fcbb\n--- /dev/null\n+++ b/pose-mcp/internal/pose/claude_sandboxed_profile_test.go\n@@ -0,0 +1,138 @@\n+package pose\n+\n+import (\n+\t\"encoding/json\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"runtime\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-claude-sandboxed-profile.\n+\n+func claudeSandboxedCommand(t *testing.T) []string {\n+\tt.Helper()\n+\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"..\", \".pose\", \"policy\", \"delegation.json\"))\n+\tif err != nil {\n+\t\tt.Skipf(\"no delegation policy at the repository root: %v\", err)\n+\t}\n+\tvar policy struct {\n+\t\tAgents map[string]struct {\n+\t\t\tCommands map[string][]string `json:\"commands\"`\n+\t\t\tResume   struct {\n+\t\t\t\tCommands map[string][]string `json:\"commands\"`\n+\t\t\t} `json:\"resume\"`\n+\t\t} `json:\"agents\"`\n+\t}\n+\tif err := json.Unmarshal(raw, &policy); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tagent, ok := policy.Agents[\"claude-opus-5-5\"]\n+\tif !ok {\n+\t\tt.Skip(\"no Claude agent\")\n+\t}\n+\tfor _, command := range [][]string{agent.Commands[\"sandboxed\"], agent.Resume.Commands[\"sandboxed\"]} {\n+\t\tif len(command) == 0 {\n+\t\t\tt.Fatal(\"the Claude agent has no sandboxed command, fresh or resumed\")\n+\t\t}\n+\t}\n+\treturn agent.Commands[\"sandboxed\"]\n+}\n+\n+// R1: the profile turns the Claude Code sandbox on and forbids unsandboxed commands.\n+func TestTheClaudeAgentDeclaresASandboxedProfileThatTurnsTheSandboxOn(t *testing.T) {\n+\tcommand := strings.Join(claudeSandboxedCommand(t), \"\\x00\")\n+\tfor _, want := range []string{`\"enabled\":true`, `\"allowUnsandboxedCommands\":false`, \"--settings\", \"claude\"} {\n+\t\tif !strings.Contains(command, want) {\n+\t\t\tt.Errorf(\"the sandboxed command lacks %q\", want)\n+\t\t}\n+\t}\n+}\n+\n+// R2: without bwrap and socat the command stops with 127, names what is missing and how to install it,\n+// and never starts the program it was to run.\n+func TestTheSandboxedProfileRefusesToStartWithoutItsDependenciesAndSaysHowToInstallThem(t *testing.T) {\n+\tcommand := claudeSandboxedCommand(t)\n+\tif len(command) < 4 || command[0] != \"sh\" || command[1] != \"-c\" {\n+\t\tt.Fatalf(\"the sandboxed command is not a checked sh -c: %v\", command[:min(4, len(command))])\n+\t}\n+\tsh, err := exec.LookPath(\"sh\")\n+\tif err != nil {\n+\t\tt.Skip(\"no sh\")\n+\t}\n+\tmarker := filepath.Join(t.TempDir(), \"started\")\n+\t// The script runs with an empty PATH, so neither dependency is found, and its program is a\n+\t// shell builtin-free path that would leave a marker if it were started.\n+\tcmd := exec.Command(sh, \"-c\", command[2], \"sh\", \"/bin/sh\", \"-c\", \"echo started > \"+marker)\n+\tcmd.Env = []string{\"PATH=/nonexistent\"}\n+\tout, runErr := cmd.CombinedOutput()\n+\texit := -1\n+\tif ee, ok := runErr.(*exec.ExitError); ok {\n+\t\texit = ee.ExitCode()\n+\t}\n+\tif runtimeIsDarwin() {\n+\t\tt.Skip(\"macOS has no such dependency\")\n+\t}\n+\tif exit != 127 {\n+\t\tt.Fatalf(\"exit = %d, want 127: %s\", exit, out)\n+\t}\n+\tfor _, want := range []string{\"bubblewrap and socat\", \"is missing\", \"sudo apt install bubblewrap socat\", \"sudo dnf install bubblewrap socat\", \"sudo pacman -S bubblewrap socat\"} {\n+\t\tif !strings.Contains(string(out), want) {\n+\t\t\tt.Errorf(\"the refusal does not say %q: %s\", want, out)\n+\t\t}\n+\t}\n+\tif _, err := os.Stat(marker); err == nil {\n+\t\tt.Fatal(\"the program was started although the dependencies are missing\")\n+\t}\n+}\n+\n+// R3 (the check half): with both present the command hands over to its program.\n+func TestTheSandboxedProfileStartsWhenTheDependenciesArePresent(t *testing.T) {\n+\tcommand := claudeSandboxedCommand(t)\n+\tsh, err := exec.LookPath(\"sh\")\n+\tif err != nil {\n+\t\tt.Skip(\"no sh\")\n+\t}\n+\tdir := t.TempDir()\n+\tfor _, name := range []string{\"bwrap\", \"socat\"} {\n+\t\tif err := os.WriteFile(filepath.Join(dir, name), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tmarker := filepath.Join(dir, \"started\")\n+\tcmd := exec.Command(sh, \"-c\", command[2], \"sh\", \"/bin/sh\", \"-c\", \"echo started > \"+marker)\n+\tcmd.Env = []string{\"PATH=\" + dir + \":/usr/bin:/bin\"}\n+\tif out, err := cmd.CombinedOutput(); err != nil {\n+\t\tt.Fatalf(\"the command failed with both dependencies present: %v %s\", err, out)\n+\t}\n+\tif _, err := os.Stat(marker); err != nil {\n+\t\tt.Fatal(\"the program was not started although both dependencies are present\")\n+\t}\n+}\n+\n+func runtimeIsDarwin() bool {\n+\tout, err := exec.Command(\"uname\").Output()\n+\treturn err == nil && strings.TrimSpace(string(out)) == \"Darwin\"\n+}\n+\n+// R4: an agent that declares requirements for a profile reports which executables are missing,\n+// and nothing when they are present or the platform is exempt.\n+func TestTheDelegationPolicyReportsTheMissingRequirementsOfAProfile(t *testing.T) {\n+\tagent := DelegationAgent{Requires: map[string]DelegationRequirement{\n+\t\t\"sandboxed\": {Executables: []string{\"definitely-not-installed-xyz\"}, Install: \"install it\"},\n+\t}}\n+\tmissing := agent.MissingRequirements()\n+\tif got := missing[\"sandboxed\"]; len(got) != 1 || got[0] != \"definitely-not-installed-xyz\" {\n+\t\tt.Fatalf(\"missing = %v\", missing)\n+\t}\n+\tagent.Requires[\"sandboxed\"] = DelegationRequirement{Executables: []string{\"definitely-not-installed-xyz\"}, SkipOn: []string{runtime.GOOS}}\n+\tif len(agent.MissingRequirements()) != 0 {\n+\t\tt.Fatal(\"a platform in skip_on still reports missing executables\")\n+\t}\n+\tagent.Requires[\"sandboxed\"] = DelegationRequirement{Executables: []string{\"sh\"}}\n+\tif len(agent.MissingRequirements()) != 0 {\n+\t\tt.Fatal(\"an installed executable is reported missing\")\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/delegation_policy.go b/pose-mcp/internal/pose/delegation_policy.go\nindex 863c0d00..0dd71bc9 100644\n--- a/pose-mcp/internal/pose/delegation_policy.go\n+++ b/pose-mcp/internal/pose/delegation_policy.go\n@@ -17,8 +17,10 @@ import (\n \t\"fmt\"\n \t\"io\"\n \t\"os\"\n+\t\"os/exec\"\n \t\"path/filepath\"\n \t\"reflect\"\n+\t\"runtime\"\n \t\"sort\"\n \t\"strings\"\n \t\"time\"\n@@ -121,6 +123,40 @@ type DelegationAgent struct {\n \tOutsideGitArgs []string `json:\"outside_git_args,omitempty\"`\n \tAddDirArgs     []string `json:\"add_dir_args,omitempty\"`\n \tNoNetworkArgs  []string `json:\"no_network_args,omitempty\"`\n+\t// Requires names, per access profile, the executables that profile needs beyond the\n+\t// agent's CLI, and how to install them (spec pose-claude-sandboxed-profile). It is not\n+\t// part of the adapter a run's provenance binds: a profile that checks its own\n+\t// dependencies at launch still refuses to start; this is how the diagnostics say so first.\n+\tRequires map[string]DelegationRequirement `json:\"requires,omitempty\"`\n+}\n+\n+// DelegationRequirement is what an access profile needs on the machine that runs it.\n+type DelegationRequirement struct {\n+\tExecutables []string `json:\"executables\"`\n+\t// SkipOn lists the operating systems (GOOS) where the profile needs none of them.\n+\tSkipOn  []string `json:\"skip_on,omitempty\"`\n+\tInstall string   `json:\"install,omitempty\"`\n+}\n+\n+// MissingRequirements returns, per access profile, the executables that are not on the\n+// path, for the profiles that declare requirements.\n+func (a DelegationAgent) MissingRequirements() map[string][]string {\n+\tout := map[string][]string{}\n+\tfor access, need := range a.Requires {\n+\t\tskipped := false\n+\t\tfor _, goos := range need.SkipOn {\n+\t\t\tskipped = skipped || goos == runtime.GOOS\n+\t\t}\n+\t\tif skipped {\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor _, name := range need.Executables {\n+\t\t\tif _, err := exec.LookPath(name); err != nil {\n+\t\t\t\tout[access] = append(out[access], name)\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn out\n }\n \n // DelegationHook is a command run after a run ends, with the run identifier\ndiff --git a/pose-mcp/internal/pose/engine_reads_raw_history_test.go b/pose-mcp/internal/pose/engine_reads_raw_history_test.go\nindex d5cdb863..18b9b80c 100644\n--- a/pose-mcp/internal/pose/engine_reads_raw_history_test.go\n+++ b/pose-mcp/internal/pose/engine_reads_raw_history_test.go\n@@ -42,6 +42,7 @@ var directGitExceptions = map[string]string{\n // What starts a program the source does not name, by file and function, each with what\n // that program is. A new one has to say here that it is not git.\n var dynamicLaunches = map[string]string{\n+\t\"internal/pose/delegation_policy.go#MissingRequirements\":              \"looks an executable of a profile up on the path, and starts nothing\",\n \t\"internal/cli/action_resolve.go#sshSignNamespace\":                      \"ssh-keygen\",\n \t\"internal/cli/delegate_wait.go#detachDelegateRun\":                      \"this binary\",\n \t\"internal/cli/delegate_watch.go#pickAttempt\":                           \"fzf\",","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"b64a9bdb-6e21-4da0-b2d6-a5771d0ef606","timestamp":"2026-11-09T20:47:33.551Z","tool_use_result":{"stdout":" .../unreleased/pose-claude-sandboxed-profile.md    |    6 +\n .pose/indexes/delivery-integrity.json              | 6109 +++++++++++---------\n .pose/indexes/generation.json                      |   26 +-\n .pose/indexes/releases.json                        |    8 +\n .pose/indexes/spec-graph.json                      | 1130 ++--\n .pose/indexes/validation-matrix.json               |   15 +\n .pose/policy/delegation.json                       |   66 +\n .pose/results/delivery-validation.json             | 1527 ++---\n .../f7d6201017ab58eb4d2f5dcb/000001.json           |   11 +\n .../f7d6201017ab58eb4d2f5dcb/000001.result.json    |    6 +\n .../review-attestations/rva-cfedfc43d72f6d4d.json  |  250 +\n .pose/review-bundles/rvb-e86d3f5595cf9ff2.json     | 2971 ++++++++++\n .pose/review-conclusions/rrn-8ee776bb9b38abd2.json |   13 +\n .pose/review-run-ledger/rrn-8ee776bb9b38abd2.json  |    8 +\n ...e26be4f1c06c917fc991f53f424c2b56398d7a5ddb.json |   23 +\n .../review-runs/rrn-8ee776bb9b38abd2.events.ndjson |   52 +\n .pose/review-runs/rrn-8ee776bb9b38abd2.json        |  137 +\n .pose/review-runs/rrn-8ee776bb9b38abd2.transcript  |  130 +\n .../2026-11-09-pose-claude-sandboxed-profile.md    |  146 +\n ...6-11-09-pose-d