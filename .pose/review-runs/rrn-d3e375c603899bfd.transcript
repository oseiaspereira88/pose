{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YBkfTwxpJRpY7KUbs3jKPy","type":"tool_result","content":"640\t\t\t\tfor _, access := range delegationAccessLevels {\n641\t\t\t\t\tif len(adapter.Command) == 0 {\n642\t\t\t\t\t\tadapter.Command = agent.Commands[access]\n643\t\t\t\t\t}\n644\t\t\t\t}\n645\t\t\t\tif _, err := ResolveReviewerContainment(adapter); err != nil {\n646\t\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s: %w\", name, err)\n647\t\t\t\t}\n648\t\t\t\tif err := validateContinuityAdapter(adapter); err != nil {\n649\t\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s: %w\", name, err)\n650\t\t\t\t}\n651\t\t\t}\n652\t\t}\n653\t\tif m := policy.MigratedFrom; m != nil && (m.Path != reviewersPolicyPath || m.Archive != delegationArchivePath || !isSHA256(m.Digest)) {\n654\t\t\treturn fmt.Errorf(\"pose: migrated_from must name %s, its archive %s and the archive's digest\", reviewersPolicyPath, delegationArchivePath)\n655\t\t}\n656\t\treturn validateRunProvenancePolicy(policy.reviewersView(DelegationPurposeReview))\n657\t}\n658\t\n659\t// validateDelegationHook checks an on_terminal command: an argv with no\n660\t// placeholder and a timeout up to five minutes.\n661\tfunc validateDelegationHook(hook *DelegationHook) error {\n662\t\tif hook == nil {\n663\t\t\treturn nil\n664\t\t}\n665\t\tif err := validateDelegationArgv(hook.Command, nil); err != nil {\n666\t\t\treturn err\n667\t\t}\n668\t\tfor _, arg := range hook.Command {\n669\t\t\tif delegationPlaceholder(arg) != \"\" {\n670\t\t\t\treturn fmt.Errorf(\"a hook takes no placeholder; the run and its state are in its environment\")\n671\t\t\t}\n672\t\t}\n673\t\tif hook.Timeout != \"\" {\n674\t\t\tif d, err := time.ParseDuration(hook.Timeout); err != nil || d <= 0 || d > delegationHookMaxBound {\n675\t\t\t\treturn fmt.Errorf(\"timeout must be a positive duration up to %s\", delegationHookMaxBound)\n676\t\t\t}\n677\t\t}\n678\t\treturn nil\n679\t}\n680\t\n681\t// delegationPlaceholder names the placeholder an argv element is, or \"\".\n682\tfunc delegationPlaceholder(arg string) string {\n683\t\tswitch arg {\n684\t\tcase \"{output}\", \"{session}\", \"{effort}\", \"{outside_git}\", \"{add_dirs}\", \"{no_network}\":\n685\t\t\treturn arg\n686\t\t}\n687\t\treturn \"\"\n688\t}\n689\t\n690\t// validateTaskFragments checks the task fragments of agent and the resume\n691\t// commands it declares per access (spec pose-delegation-task R3, R4, R8).\n692\tfunc validateTaskFragments(name string, agent DelegationAgent) error {\n693\t\tfor label, fragment := range map[string][]string{\"outside_git_args\": agent.OutsideGitArgs, \"add_dir_args\": agent.AddDirArgs, \"no_network_args\": agent.NoNetworkArgs} {\n694\t\t\tdirs := 0\n695\t\t\tfor _, arg := range fragment {\n696\t\t\t\tif arg == \"{dir}\" {\n697\t\t\t\t\tdirs++\n698\t\t\t\t} else if strings.Contains(arg, \"{\") {\n699\t\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s: %s carries a placeholder\", name, label)\n700\t\t\t\t}\n701\t\t\t}\n702\t\t\tif label == \"add_dir_args\" && len(fragment) > 0 && dirs != 1 || label != \"add_dir_args\" && dirs > 0 {\n703\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s: add_dir_args takes {dir} once as a whole element, and the other fragments take none\", name)\n704\t\t\t}\n705\t\t}\n706\t\tif agent.Resume != nil {\n707\t\t\tfor access, argv := range agent.Resume.Commands {\n708\t\t\t\tif !containsString(delegationAccessLevels, access) {\n709\t\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s: resume access %q is not one of %s\", name, access, strings.Join(delegationAccessLevels, \", \"))\n710\t\t\t\t}\n711\t\t\t\tif err := validateDelegationArgv(argv, agent.Effort); err != nil || !containsString(argv, \"{session}\") {\n712\t\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s resume command %s: it needs {session} as a whole element and a valid argv\", name, access)\n713\t\t\t\t}\n714\t\t\t}\n715\t\t}\n716\t\treturn nil\n717\t}\n718\t\n719\tfunc validateDelegationArgv(argv []string, effort *ReviewerEffort) error {\n720\t\tif len(argv) == 0 || argv[0] == \"\" {\n721\t\t\treturn fmt.Errorf(\"the argv is empty\")\n722\t\t}\n723\t\tfor i, arg := range argv {\n724\t\t\tif delegationPlaceholder(arg) != \"\" {\n725\t\t\t\tif i == 0 {\n726\t\t\t\t\treturn fmt.Errorf(\"a placeholder cannot be the executable\")\n727\t\t\t\t}\n728\t\t\t\tif arg == \"{effort}\" && effort == nil {\n729\t\t\t\t\treturn fmt.Errorf(\"{effort} needs the agent's effort levels\")\n730\t\t\t\t}\n731\t\t\t\tcontinue\n732\t\t\t}\n733\t\t\tfor _, p := range []string{\"{output}\", \"{session}\", \"{effort}\", \"{outside_git}\", \"{add_dirs}\", \"{no_network}\"} {\n734\t\t\t\tif strings.Contains(arg, p) {\n735\t\t\t\t\treturn fmt.Errorf(\"%s must be a whole argv element, never interpolated\", p)\n736\t\t\t\t}\n737\t\t\t}\n738\t\t}\n739\t\treturn nil\n740\t}\n741\t\n742\t// agentAdapter projects agent name for purpose onto the adapter the delivered\n743\t// review path reads. Budgets: the agent's own max_runs_per_bundle wins, then\n744\t// the purpose's; the purpose's timeout wins, then the agent's.\n745\tfunc (p DelegationPolicy) agentAdapter(name, purpose string) (ReviewerAdapter, bool) {\n746\t\tagent, ok := p.Agents[name]\n747\t\tif !ok {\n748\t\t\treturn ReviewerAdapter{}, false\n749\t\t}\n750\t\tbudget := p.Purposes[purpose]\n751\t\tadapter := ReviewerAdapter{\n752\t\t\tContainment: agent.Containment, Executor: agent.Executor, Command: agent.Commands[DelegationAccessRead],\n753\t\t\tVendor: agent.Vendor, Model: agent.Model, Timeout: agent.Timeout, MaxRunsPerBundle: agent.MaxRunsPerBundle,\n754\t\t\tLimit: agent.Limit, Session: agent.Session, Resume: agent.Resume, Events: agent.Events, Effort: agent.Effort,\n755\t\t}\n756\t\tif budget.Timeout != \"\" {\n757\t\t\tadapter.Timeout = budget.Timeout\n758\t\t}\n759\t\tif adapter.MaxRunsPerBundle == 0 {\n760\t\t\tadapter.MaxRunsPerBundle = budget.MaxRunsPerBundle\n761\t\t}\n762\t\treturn adapter, true\n763\t}\n764\t\n765\t// reviewersView is the schema 1 shape of the policy for one purpose: every\n766\t// agent that can read, projected for that purpose.\n767\tfunc (p DelegationPolicy) reviewersView(purpose string) ReviewersPolicy {\n768\t\tview := ReviewersPolicy{SchemaVersion: ReviewersPolicySchemaVersion, Provenance: p.Provenance, Adapters: map[string]ReviewerAdapter{}}\n769\t\tfor name, agent := range p.Agents {\n770\t\t\tif _, ok := agent.Commands[DelegationAccessRead]; !ok {\n771\t\t\t\tcontinue\n772\t\t\t}\n773\t\t\tview.Adapters[name], _ = p.agentAdapter(name, purpose)\n774\t\t}\n775\t\treturn view\n776\t}\n777\t\n778\t// AgentNames lists the configured agents in order.\n779\tfunc (p DelegationPolicy) AgentNames() []string {\n780\t\tnames := make([]string, 0, len(p.Agents))\n781\t\tfor name := range p.Agents {\n782\t\t\tnames = append(names, name)\n783\t\t}\n784\t\tsort.Strings(names)\n785\t\treturn names\n786\t}\n787\t\n788\t// MigrateReviewersPolicy converts schema 1 into schema 2 (R7). Each adapter\n789\t// becomes an agent whose read command is the adapter's command; a budget all\n790\t// adapters share moves to the review-path purposes, a budget they do not\n791\t// share stays on each agent. The projection of every migrated agent is the\n792\t// adapter it came from, byte for byte.\n793\tfunc MigrateReviewersPolicy(legacy ReviewersPolicy) (DelegationPolicy, error) {\n794\t\tpolicy := DelegationPolicy{SchemaVersion: DelegationPolicySchemaVersion, Agents: map[string]DelegationAgent{}, Provenance: legacy.Provenance}\n795\t\tbudgets := map[int]bool{}\n796\t\tfor _, adapter := range legacy.Adapters {\n797\t\t\tbudgets[adapter.MaxRunsPerBundle] = true\n798\t\t}\n799\t\tshared := 0\n800\t\tif len(budgets) == 1 {\n801\t\t\tfor b := range budgets {\n802\t\t\t\tshared = b\n803\t\t\t}\n804\t\t}\n805\t\tfor name, adapter := range legacy.Adapters {\n806\t\t\tagent := DelegationAgent{Vendor: adapter.Vendor, Model: adapter.Model, Events: adapter.Events, Commands: map[string][]string{DelegationAccessRead: adapter.Command},\n807\t\t\t\tEffort: adapter.Effort, Timeout: adapter.Timeout, Limit: adapter.Limit, Session: adapter.Session, Resume: adapter.Resume, Executor: adapter.Executor, Containment: adapter.Containment}\n808\t\t\tif len(budgets) > 1 {\n809\t\t\t\tagent.MaxRunsPerBundle = adapter.MaxRunsPerBundle"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"695ef89b-eb86-4505-aec9-c3cb4ca3ac3a","timestamp":"2026-11-09T20:48:11.249Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3567912673/worktree/pose-mcp/internal/pose/delegation_policy.go","content":"\t\t\tfor _, access := range delegationAccessLevels {\n\t\t\t\tif len(adapter.Command) == 0 {\n\t\t\t\t\tadapter.Command = agent.Commands[access]\n\t\t\t\t}\n\t\t\t}\n\t\t\tif _, err := ResolveReviewerContainment(adapter); err != nil {\n\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s: %w\", name, err)\n\t\t\t}\n\t\t\tif err := validateContinuityAdapter(adapter); err != nil {\n\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s: %w\", name, err)\n\t\t\t}\n\t\t}\n\t}\n\tif m := policy.MigratedFrom; m != nil && (m.Path != reviewersPolicyPath || m.Archive != delegationArchivePath || !isSHA256(m.Digest)) {\n\t\treturn fmt.Errorf(\"pose: migrated_from must name %s, its archive %s and the archive's digest\", reviewersPolicyPath, delegationArchivePath)\n\t}\n\treturn validateRunProvenancePolicy(policy.reviewersView(DelegationPurposeReview))\n}\n\n// validateDelegationHook checks an on_terminal command: an argv with no\n// placeholder and a timeout up to five minutes.\nfunc validateDelegationHook(hook *DelegationHook) error {\n\tif hook == nil {\n\t\treturn nil\n\t}\n\tif err := validateDelegationArgv(hook.Command, nil); err != nil {\n\t\treturn err\n\t}\n\tfor _, arg := range hook.Command {\n\t\tif delegationPlaceholder(arg) != \"\" {\n\t\t\treturn fmt.Errorf(\"a hook takes no placeholder; the run and its state are in its environment\")\n\t\t}\n\t}\n\tif hook.Timeout != \"\" {\n\t\tif d, err := time.ParseDuration(hook.Timeout); err != nil || d <= 0 || d > delegationHookMaxBound {\n\t\t\treturn fmt.Errorf(\"timeout must be a positive duration up to %s\", delegationHookMaxBound)\n\t\t}\n\t}\n\treturn nil\n}\n\n// delegationPlaceholder names the placeholder an argv element is, or \"\".\nfunc delegationPlaceholder(arg string) string {\n\tswitch arg {\n\tcase \"{output}\", \"{session}\", \"{effort}\", \"{outside_git}\", \"{add_dirs}\", \"{no_network}\":\n\t\treturn arg\n\t}\n\treturn \"\"\n}\n\n// validateTaskFragments checks the task fragments of agent and the resume\n// commands it declares per access (spec pose-delegation-task R3, R4, R8).\nfunc validateTaskFragments(name string, agent DelegationAgent) error {\n\tfor label, fragment := range map[string][]string{\"outside_git_args\": agent.OutsideGitArgs, \"add_dir_args\": agent.AddDirArgs, \"no_network_args\": agent.NoNetworkArgs} {\n\t\tdirs := 0\n\t\tfor _, arg := range fragment {\n\t\t\tif arg == \"{dir}\" {\n\t\t\t\tdirs++\n\t\t\t} else if strings.Contains(arg, \"{\") {\n\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s: %s carries a placeholder\", name, label)\n\t\t\t}\n\t\t}\n\t\tif label == \"add_dir_args\" && len(fragment) > 0 && dirs != 1 || label != \"add_dir_args\" && dirs > 0 {\n\t\t\treturn fmt.Errorf(\"pose: delegation agent %s: add_dir_args takes {dir} once as a whole element, and the other fragments take none\", name)\n\t\t}\n\t}\n\tif agent.Resume != nil {\n\t\tfor access, argv := range agent.Resume.Commands {\n\t\t\tif !containsString(delegationAccessLevels, access) {\n\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s: resume access %q is not one of %s\", name, access, strings.Join(delegationAccessLevels, \", \"))\n\t\t\t}\n\t\t\tif err := validateDelegationArgv(argv, agent.Effort); err != nil || !containsString(argv, \"{session}\") {\n\t\t\t\treturn fmt.Errorf(\"pose: delegation agent %s resume command %s: it needs {session} as a whole element and a valid argv\", name, access)\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc validateDelegationArgv(argv []string, effort *ReviewerEffort) error {\n\tif len(argv) == 0 || argv[0] == \"\" {\n\t\treturn fmt.Errorf(\"the argv is empty\")\n\t}\n\tfor i, arg := range argv {\n\t\tif delegationPlaceholder(arg) != \"\" {\n\t\t\tif i == 0 {\n\t\t\t\treturn fmt.Errorf(\"a placeholder cannot be the executable\")\n\t\t\t}\n\t\t\tif arg == \"{effort}\" && effort == nil {\n\t\t\t\treturn fmt.Errorf(\"{effort} needs the agent's effort levels\")\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tfor _, p := range []string{\"{output}\", \"{session}\", \"{effort}\", \"{outside_git}\", \"{add_dirs}\", \"{no_network}\"} {\n\t\t\tif strings.Contains(arg, p) {\n\t\t\t\treturn fmt.Errorf(\"%s must be a whole argv element, never interpolated\", p)\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\n\n// agentAdapter projects agent name for purpose onto the adapter the delivered\n// review path reads. Budgets: the agent's own max_runs_per_bundle wins, then\n// the purpose's; the purpose's timeout wins, then the agent's.\nfunc (p DelegationPolicy) agentAdapter(name, purpose string) (ReviewerAdapter, bool) {\n\tagent, ok := p.Agents[name]\n\tif !ok {\n\t\treturn ReviewerAdapter{}, false\n\t}\n\tbudget := p.Purposes[purpose]\n\tadapter := ReviewerAdapter{\n\t\tContainment: agent.Containment, Executor: agent.Executor, Command: agent.Commands[DelegationAccessRead],\n\t\tVendor: agent.Vendor, Model: agent.Model, Timeout: agent.Timeout, MaxRunsPerBundle: agent.MaxRunsPerBundle,\n\t\tLimit: agent.Limit, Session: agent.Session, Resume: agent.Resume, Events: agent.Events, Effort: agent.Effort,\n\t}\n\tif budget.Timeout != \"\" {\n\t\tadapter.Timeout = budget.Timeout\n\t}\n\tif adapter.MaxRunsPerBundle == 0 {\n\t\tadapter.MaxRunsPerBundle = budget.MaxRunsPerBundle\n\t}\n\treturn adapter, true\n}\n\n// reviewersView is the schema 1 shape of the policy for one purpose: every\n// agent that can read, projected for that purpose.\nfunc (p DelegationPolicy) reviewersView(purpose string) ReviewersPolicy {\n\tview := ReviewersPolicy{SchemaVersion: ReviewersPolicySchemaVersion, Provenance: p.Provenance, Adapters: map[string]ReviewerAdapter{}}\n\tfor name, agent := range p.Agents {\n\t\tif _, ok := agent.Commands[DelegationAccessRead]; !ok {\n\t\t\tcontinue\n\t\t}\n\t\tview.Adapters[name], _ = p.agentAdapter(name, purpose)\n\t}\n\treturn view\n}\n\n// AgentNames lists the configured agents in order.\nfunc (p DelegationPolicy) AgentNames() []string {\n\tnames := make([]string, 0, len(p.Agents))\n\tfor name := range p.Agents {\n\t\tnames = append(names, name)\n\t}\n\tsort.Strings(names)\n\treturn names\n}\n\n// MigrateReviewersPolicy converts schema 1 into schema 2 (R7). Each adapter\n// becomes an agent whose read command is the adapter's command; a budget all\n// adapters share moves to the review-path purposes, a budget they do not\n// share stays on each agent. The projection of every migrated agent is the\n// adapter it came from, byte for byte.\nfunc MigrateReviewersPolicy(legacy ReviewersPolicy) (DelegationPolicy, error) {\n\tpolicy := DelegationPolicy{SchemaVersion: DelegationPolicySchemaVersion, Agents: map[string]DelegationAgent{}, Provenance: legacy.Provenance}\n\tbudgets := map[int]bool{}\n\tfor _, adapter := range legacy.Adapters {\n\t\tbudgets[adapter.MaxRunsPerBundle] = true\n\t}\n\tshared := 0\n\tif len(budgets) == 1 {\n\t\tfor b := range budgets {\n\t\t\tshared = b\n\t\t}\n\t}\n\tfor name, adapter := range legacy.Adapters {\n\t\tagent := DelegationAgent{Vendor: adapter.Vendor, Model: adapter.Model, Events: adapter.Events, Commands: map[string][]string{DelegationAccessRead: adapter.Command},\n\t\t\tEffort: adapter.Effort, Timeout: adapter.Timeout, Limit: adapter.Limit, Session: adapter.Session, Resume: adapter.Resume, Executor: adapter.Executor, Containment: adapter.Containment}\n\t\tif len(budgets) > 1 {\n\t\t\tagent.MaxRunsPerBundle = adapter.M