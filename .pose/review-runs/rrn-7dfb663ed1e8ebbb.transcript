{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc \"git diff 319bfd9c99ae17e6db4945ab348b5a4cf4f51551 d1641533c4b419fbb01ab0c630a677f89171426f -- pose-mcp .pose/adr .pose/indexes/validation-matrix.json; rg --files -g AGENTS.md -g '*ledger*' .pose/knowledge pose-mcp\"","aggregated_output":"diff --git a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\nindex ceb93f61..20ed7079 100644\n--- a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n+++ b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n@@ -333,3 +333,31 @@ before reuse.\n Measured on harne8: the second closeout call of one MCP server falls from\n 136 s to 43 s, with the same terminal verdict. The replay, not a rebuild,\n is the remaining cost.\n+\n+## The review ledger is read once per operation (D14) — 2026-11-16\n+\n+Spec `pose-review-ledger-is-read-once-per-operation`. After D13, the first\n+closeout call of an MCP server on harne8 still took 140 to 200 s. Its CPU\n+profile put about 98 s in verifying the review bundles of federated\n+dependencies. Counted in one call, pose-dist's review ledger (318 runs,\n+80 MB of transcripts) was read 280 times, its attestations 304 times, and\n+transcript digests were checked 29,680 times, because every bundle\n+verification read and checked the whole ledger again.\n+\n+Within one operation the read view already returns the same bytes for the\n+same read. A value derived only from those reads is therefore the same on\n+every request of the operation. The operation now keeps, for its own life,\n+each project's parsed review runs, its review attestations per bundle filter,\n+each review bundle's header, and each transcript check per path and expected\n+digest. The first\n+computation reads through the view, so the closure and the final audit cover\n+every input as before. Callers receive copies of the kept slices. A store\n+without an operation reads and checks on every call. Nothing is kept across\n+operations.\n+\n+Measured on harne8: the first call's CPU falls from 130 s to 53 s, and its\n+wall time from about 197 s to 136 s. The rest is Git: 1,116\n+`git log -1 -- <path>` commands, 81 s. A commit-graph with changed-path Bloom\n+filters takes each from 47 ms to 2 ms and the first call to 59 s; it is\n+repository maintenance, not part of this decision.\n+\ndiff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex 573cd04f..7a759cb0 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2419,6 +2419,13 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"review-ledger-is-read-once-per-operation-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestReviewLedgerIsReadOncePerOperation|TestReviewLedgerWithoutAnOperationIsReadEveryTime|TestReviewLedgerMemoAnswersAsAFreshRead\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"index-material-is-kept-per-repository-state-integration\",\n           \"program\": \"go\",\ndiff --git a/pose-mcp/internal/pose/governance_read_view.go b/pose-mcp/internal/pose/governance_read_view.go\nindex be037243..8b15f4d9 100644\n--- a/pose-mcp/internal/pose/governance_read_view.go\n+++ b/pose-mcp/internal/pose/governance_read_view.go\n@@ -90,6 +90,9 @@ type governanceReadViewRoot struct {\n }\n \n type governanceReadViewOperation struct {\n+\t// ledgerMemo keeps values derived from the review ledger for the life of\n+\t// the operation (spec pose-review-ledger-is-read-once-per-operation).\n+\tledgerMemo sync.Map\n \t// indexInputsFrom, when set, is the coordinator operation a scope\n \t// operation was created under: the scope's check of the consumed index's\n \t// inputs is the coordinator's, read through the coordinator's Files and\ndiff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex d2da9242..e389a500 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -3337,6 +3337,20 @@ type ReviewAttestationsRead struct {\n // names another bundle is not a loss for this one; one that names none is, because it may\n // be a rejection of this bundle.\n func (s Store) ReadReviewAttestations(bundleID string) (ReviewAttestationsRead, error) {\n+\tread, _, err := memoizedLedgerRead(s.fsys(), \"review-attestations\\x00\"+filepath.Clean(s.Root)+\"\\x00\"+bundleID, func() (ReviewAttestationsRead, error) {\n+\t\treturn s.readReviewAttestations(bundleID)\n+\t})\n+\tif err != nil {\n+\t\treturn ReviewAttestationsRead{}, err\n+\t}\n+\tread.Attestations = append([]ReviewAttestation(nil), read.Attestations...)\n+\tread.Coverage.Losses = append([]SourceLoss(nil), read.Coverage.Losses...)\n+\treturn read, nil\n+}\n+\n+// readReviewAttestations reads the store's review attestations, those of\n+// bundleID when it is set, with the coverage of what could not be read.\n+func (s Store) readReviewAttestations(bundleID string) (ReviewAttestationsRead, error) {\n \tcoverage := SourceCoverage{Losses: []SourceLoss{}}\n \tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), false)\n \tif os.IsNotExist(err) {\ndiff --git a/pose-mcp/internal/pose/review_dispatch.go b/pose-mcp/internal/pose/review_dispatch.go\nindex 9d9e5442..2390a21c 100644\n--- a/pose-mcp/internal/pose/review_dispatch.go\n+++ b/pose-mcp/internal/pose/review_dispatch.go\n@@ -247,6 +247,31 @@ func (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n }\n \n func (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n+\t// Within a read-view operation the ledger is read and checked once per\n+\t// root; every request of the operation is answered from that read,\n+\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n+\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n+\t\truns, lost, err := s.readAllReviewRuns()\n+\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n+\t})\n+\tif err != nil {\n+\t\treturn nil, nil, err\n+\t}\n+\tout := append([]ReviewRun(nil), all.runs...)\n+\tif bundleID != \"\" {\n+\t\tfiltered := []ReviewRun{}\n+\t\tfor _, run := range out {\n+\t\t\tif run.BundleID == bundleID {\n+\t\t\t\tfiltered = append(filtered, run)\n+\t\t\t}\n+\t\t}\n+\t\tout = filtered\n+\t}\n+\treturn out, append([]string(nil), all.lost...), nil\n+}\n+\n+// readAllReviewRuns reads, checks and orders every review run of the store.\n+func (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n \tfiles := s.fsys()\n \tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n \t// The storage is read where the writer writes it: a link in its place is another place.\n@@ -361,15 +386,6 @@ func (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n \t}\n \tlost = append(lost, findings...)\n \tlost = append(lost, s.reviewContinuationFindings(out)...)\n-\tif bundleID != \"\" {\n-\t\tfiltered := []ReviewRun{}\n-\t\tfor _, run := range out {\n-\t\t\tif run.BundleID == bundleID {\n-\t\t\t\tfiltered = append(filtered, run)\n-\t\t\t}\n-\t\t}\n-\t\tout = filtered\n-\t}\n \treturn out, uniqueSorted(lost), nil\n }\n \n@@ -1642,6 +1658,15 @@ func validateReviewRunRecord(name string, run ReviewRun) error {\n const reviewTranscriptMaxBytes = 256 << 20\n \n func (s Store) reviewRunTranscriptIntact(run ReviewRun) string {\n+\tproblem, _, _ := memoizedLedgerRead(s.fsys(), \"transcript\\x00\"+filepath.Clean(s.Root)+\"\\x00\"+run.TranscriptPath+\"\\x00\"+run.TranscriptDigest, func() (string, error) {\n+\t\treturn s.checkReviewRunTranscript(run), nil\n+\t})\n+\treturn problem\n+}\n+\n+// checkReviewRunTranscript reads a run's transcript and checks it against\n+// the digest the run names; it returns the problem, or \"\".\n+func (s Store) checkReviewRunTranscript(run ReviewRun) string {\n \tfull := filepath.Join(s.Root, filepath.FromSlash(run.TranscriptPath))\n \tfiles := s.fsys()\n \tinfo, err := files.Lstat(full)\ndiff --git a/pose-mcp/internal/pose/review_ledger_memo.go b/pose-mcp/internal/pose/review_ledger_memo.go\nnew file mode 100644\nindex 00000000..2a9ed445\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_ledger_memo.go\n@@ -0,0 +1,47 @@\n+package pose\n+\n+// The review ledger of a project is read by every bundle verification an\n+// operation makes: a closeout that verifies 64 federated dependencies read\n+// pose-dist's ledger 280 times and checked transcript digests 29,680 times.\n+// Within a read-view operation the view already returns the same bytes for\n+// the same read, so a value derived only from those reads is the same on\n+// every request: it is computed once and kept for the life of the operation\n+// (spec pose-review-ledger-is-read-once-per-operation, ADR\n+// governance-reads-use-bounded-operation-scoped-views D14). The first\n+// computation reads through the view, so the operation's closure and final\n+// audit cover every input as before.\n+\n+type reviewRunsRead struct {\n+\truns []ReviewRun\n+\tlost []string\n+}\n+\n+type ledgerMemoEntry[V any] struct {\n+\tvalue V\n+\terr   error\n+}\n+\n+// ledgerMemoComputed sees each computation; tests count them.\n+var ledgerMemoComputed = func(key string) {}\n+\n+// memoizedLedgerRead returns compute's result, kept per key in the\n+// read-view operation of files; without an operation it computes every\n+// time. The bool reports whether the value came from the memo.\n+func memoizedLedgerRead[V any](files Files, key string, compute func() (V, error)) (V, bool, error) {\n+\tview, _ := governanceReadViewFromFiles(files)\n+\tif view == nil || view.operation == nil {\n+\t\tledgerMemoComputed(key)\n+\t\tvalue, err := compute()\n+\t\treturn value, false, err\n+\t}\n+\top := view.operation\n+\tif kept, ok := op.ledgerMemo.Load(key); ok {\n+\t\tentry := kept.(ledgerMemoEntry[V])\n+\t\treturn entry.value, true, entry.err\n+\t}\n+\tledgerMemoComputed(key)\n+\tvalue, err := compute()\n+\tkept, _ := op.ledgerMemo.LoadOrStore(key, ledgerMemoEntry[V]{value: value, err: err})\n+\tentry := kept.(ledgerMemoEntry[V])\n+\treturn entry.value, false, entry.err\n+}\ndiff --git a/pose-mcp/internal/pose/review_ledger_memo_test.go b/pose-mcp/internal/pose/review_ledger_memo_test.go\nnew file mode 100644\nindex 00000000..ea5c276b\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_ledger_memo_test.go\n@@ -0,0 +1,136 @@\n+package pose\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"reflect\"\n+\t\"strings\"\n+\t\"sync\"\n+\t\"testing\"\n+)\n+\n+// countLedgerComputations counts every computation of a memoized ledger\n+// value by the kind of value (the key's first field).\n+func countLedgerComputations(t *testing.T) func() map[string]int {\n+\tt.Helper()\n+\tvar mu sync.Mutex\n+\tcounts := map[string]int{}\n+\tkeys := map[string]int{}\n+\toriginal := ledgerMemoComputed\n+\tledgerMemoComputed = func(key string) {\n+\t\tmu.Lock()\n+\t\tcounts[strings.SplitN(key, \"\\x00\", 2)[0]]++\n+\t\tkeys[key]++\n+\t\tmu.Unlock()\n+\t}\n+\tt.Cleanup(func() { ledgerMemoComputed = original })\n+\treturn func() map[string]int {\n+\t\tmu.Lock()\n+\t\tdefer mu.Unlock()\n+\t\tout := map[string]int{}\n+\t\tfor kind, n := range counts {\n+\t\t\tout[kind] = n\n+\t\t}\n+\t\tfor key, n := range keys {\n+\t\t\tif n > out[\"max-per-key\"] {\n+\t\t\t\tout[\"max-per-key\"] = n\n+\t\t\t}\n+\t\t\t_ = key\n+\t\t}\n+\t\treturn out\n+\t}\n+}\n+\n+func ledgerOperation(t *testing.T, store Store) Store {\n+\tt.Helper()\n+\tbase, view := store.beginGovernanceReadView()\n+\tif view == nil || view.operation == nil {\n+\t\tt.Fatal(\"no read-view operation\")\n+\t}\n+\treturn base.withGovernanceReadView(view, \"review\")\n+}\n+\n+// Spec pose-review-ledger-is-read-once-per-operation, R1 and R2: every\n+// verification of an operation after the first is answered without reading\n+// or checking the ledger again.\n+func TestReviewLedgerIsReadOncePerOperation(t *testing.T) {\n+\tf, run := approvedByARunThenDone(t)\n+\tscope := f.bundle.Payload.Scope.Ref\n+\tcounts := countLedgerComputations(t)\n+\tscoped := ledgerOperation(t, f.store)\n+\tfirst, err := scoped.VerifyReviewBundle(scope)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tafterFirst := counts()\n+\tfor i := 0; i < 3; i++ {\n+\t\tif _, err := scoped.VerifyReviewBundle(scope); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif _, _, err := scoped.ReadReviewRuns(run.BundleID); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tafter := counts()\n+\tif afterFirst[\"review-runs\"] == 0 || afterFirst[\"transcript\"] == 0 || afterFirst[\"bundle-header\"] == 0 {\n+\t\tt.Fatalf(\"the first verification read no ledger: %v\", afterFirst)\n+\t}\n+\tif after[\"max-per-key\"] != 1 || !reflect.DeepEqual(after, afterFirst) {\n+\t\tt.Fatalf(\"later verifications read the ledger again: first %v, after %v\", afterFirst, after)\n+\t}\n+\tif !first.Approved {\n+\t\tt.Fatalf(\"the fixture's verification is not approved: %v\", first.Blockers)\n+\t}\n+}\n+\n+// R3: a store with no read-view operation reads the ledger on every call.\n+func TestReviewLedgerWithoutAnOperationIsReadEveryTime(t *testing.T) {\n+\tf, run := approvedByARunThenDone(t)\n+\tcounts := countLedgerComputations(t)\n+\tfor i := 0; i < 2; i++ {\n+\t\tif _, _, err := f.store.ReadReviewRuns(run.BundleID); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tif got := counts()[\"review-runs\"]; got != 2 {\n+\t\tt.Fatalf(\"review runs read %d times without an operation, want 2\", got)\n+\t}\n+}\n+\n+// R4: the answers are the same with and without the memo, a lost record and\n+// a caller that changes what it was given included.\n+func TestReviewLedgerMemoAnswersAsAFreshRead(t *testing.T) {\n+\tf, run := approvedByARunThenDone(t)\n+\tscope := f.bundle.Payload.Scope.Ref\n+\tbroken := filepath.Join(f.store.Root, filepath.FromSlash(reviewRunsDir), \"rrn-0000000000000000.json\")\n+\tif err := os.WriteFile(broken, []byte(\"{not json\"), 0o600); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfreshRuns, freshLost, freshErr := f.store.ReadReviewRuns(run.BundleID)\n+\tfreshAtt, freshAttErr := f.store.ReadReviewAttestations(run.BundleID)\n+\tfresh, freshVerifyErr := f.store.VerifyReviewBundle(scope)\n+\tscoped := ledgerOperation(t, f.store)\n+\tfor i := 0; i < 2; i++ {\n+\t\truns, lost, err := scoped.ReadReviewRuns(run.BundleID)\n+\t\tif !reflect.DeepEqual(runs, freshRuns) || !reflect.DeepEqual(lost, freshLost) || (err == nil) != (freshErr == nil) {\n+\t\t\tt.Fatalf(\"read %d: runs or losses differ from a fresh read: lost %v, want %v\", i, lost, freshLost)\n+\t\t}\n+\t\tif len(runs) > 0 {\n+\t\t\truns[0].RunID = \"changed by the caller\"\n+\t\t}\n+\t\tatt, attErr := scoped.ReadReviewAttestations(run.BundleID)\n+\t\tif !reflect.DeepEqual(att, freshAtt) || (attErr == nil) != (freshAttErr == nil) {\n+\t\t\tt.Fatalf(\"read %d: attestations differ from a fresh read\", i)\n+\t\t}\n+\t\tif len(att.Attestations) > 0 {\n+\t\t\tatt.Attestations[0].BundleID = \"changed by the caller\"\n+\t\t}\n+\t\tverification, err := scoped.VerifyReviewBundle(scope)\n+\t\tif verification.Approved != fresh.Approved || verification.Fresh != fresh.Fresh || !reflect.DeepEqual(verification.Blockers, fresh.Blockers) || (err == nil) != (freshVerifyErr == nil) {\n+\t\t\tt.Fatalf(\"read %d: verification differs from a fresh one: %v, want %v\", i, verification.Blockers, fresh.Blockers)\n+\t\t}\n+\t}\n+\tif len(freshLost) == 0 {\n+\t\tt.Fatal(\"the unreadable run was not reported as lost\")\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_operation_view.go b/pose-mcp/internal/pose/review_operation_view.go\nindex 032c8a01..72133b77 100644\n--- a/pose-mcp/internal/pose/review_operation_view.go\n+++ b/pose-mcp/internal/pose/review_operation_view.go\n@@ -24,6 +24,22 @@ type reviewHeaderObservation struct {\n // readReviewBundleHeader is the same classification for cached and live reads.\n // A known different owner is skippable only after whole-JSON and ambiguity checks.\n func readReviewBundleHeader(files Files, dir, name string) reviewHeaderObservation {\n+\t// A bundle's header is read, hashed and classified once per operation:\n+\t// a closeout lists every bundle for every scope it verifies (spec\n+\t// pose-review-ledger-is-read-once-per-operation).\n+\tobservation, _, _ := memoizedLedgerRead(files, \"bundle-header\\x00\"+filepath.Clean(dir)+\"\\x00\"+name, func() (reviewHeaderObservation, error) {\n+\t\treturn observeReviewBundleHeader(files, dir, name), nil\n+\t})\n+\tif observation.loss != nil {\n+\t\tloss := *observation.loss\n+\t\tobservation.loss = &loss\n+\t}\n+\treturn observation\n+}\n+\n+// observeReviewBundleHeader reads one bundle's bytes and classifies the scope\n+// they declare.\n+func observeReviewBundleHeader(files Files, dir, name string) reviewHeaderObservation {\n \trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", name))\n \traw, err := files.ReadFile(filepath.Join(dir, name))\n \tif err != nil {\npose-mcp/internal/cli/review_attempt_ledger_test.go\npose-mcp/internal/pose/legacy_ledger_test.go\npose-mcp/internal/pose/review_ledger_memo_test.go\npose-mcp/internal/pose/review_ledger_memo.go\npose-mcp/internal/pose/review_attempt_ledger_test.go\npose-mcp/internal/pose/review_attempt_ledger.go\npose-mcp/internal/pose/legacy_ledger.go\npose-mcp/internal/mcpserver/review_attempt_ledger_test.go\npose-mcp/internal/scaffold/dist/AGENTS.md\npose-mcp/internal/scaffold/dist/locales/pt-BR/AGENTS.md\n","exit_code":0,"status":"completed"}}
