{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '274,390p' pose-mcp/internal/pose/review_dispatch.go; sed -n '1669,1735p' pose-mcp/internal/pose/review_dispatch.go; sed -n '3353,3450p' pose-mcp/internal/pose/review_bundle.go; sed -n '2490,2595p' pose-mcp/internal/pose/governance_read_view.go; cat pose-mcp/internal/pose/review_operation_view.go\"","aggregated_output":"func (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n\tfiles := s.fsys()\n\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n\t// The storage is read where the writer writes it: a link in its place is another place.\n\tif info, lerr := files.Lstat(dir); lerr == nil {\n\t\tif info.Mode()&os.ModeSymlink != 0 {\n\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n\t\t}\n\t} else if !errors.Is(lerr, os.ErrNotExist) {\n\t\treturn nil, nil, lerr\n\t}\n\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n\t\t\treturn nil, nil, lerr\n\t\t}\n\t\treturn []ReviewRun{}, nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tout := []ReviewRun{}\n\tvar lost []string\n\treadBudget := int64(32 << 20)\n\tfor _, e := range entries {\n\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(dir, e.Name())\n\t\tinfo, infoErr := files.Lstat(full)\n\t\tif infoErr != nil || !info.Mode().IsRegular() {\n\t\t\tlost = append(lost, e.Name()+\" (not a regular file)\")\n\t\t\tcontinue\n\t\t}\n\t\tif info.Size() < 0 || info.Size() > reviewLedgerMaxBytes {\n\t\t\tlost = append(lost, e.Name()+\" (record exceeds bound or is unreadable)\")\n\t\t\tcontinue\n\t\t}\n\t\traw, err := readLedgerRawBudgetIn(files, full, &readBudget)\n\t\tif err != nil {\n\t\t\tlost = append(lost, e.Name()+\" (\"+err.Error()+\")\")\n\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tvar run ReviewRun\n\t\tif json.Unmarshal(raw, &run) != nil || run.RunID == \"\" {\n\t\t\tlost = append(lost, e.Name()+\" (not a review run)\")\n\t\t\tcontinue\n\t\t}\n\t\tif verr := validateReviewRunRecord(e.Name(), run); verr != nil {\n\t\t\tlost = append(lost, e.Name()+\" (\"+verr.Error()+\")\")\n\t\t\tcontinue\n\t\t}\n\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, e.Name()))\n\t\tout = append(out, run)\n\t}\n\tsort.Slice(out, func(i, j int) bool {\n\t\ta, _ := time.Parse(time.RFC3339Nano, out[i].StartedAt)\n\t\tb, _ := time.Parse(time.RFC3339Nano, out[j].StartedAt)\n\t\tif !a.Equal(b) {\n\t\t\treturn a.Before(b)\n\t\t}\n\t\treturn out[i].RunID < out[j].RunID\n\t})\n\tsuperseded := map[string]string{}\n\tfor _, run := range out {\n\t\tif run.Supersedes != \"\" {\n\t\t\tsuperseded[run.Supersedes] = run.RunID\n\t\t}\n\t}\n\tfor i := range out {\n\t\tout[i].SupersededBy = superseded[out[i].RunID]\n\t}\n\tchecked := map[string][]DelegatedReviewAttempt{}\n\tfor _, run := range out {\n\t\tif run.LedgerVersion == 1 {\n\t\t\tif _, err := files.Lstat(filepath.Join(s.Root, reviewRunLedgerDir, run.RunID+\".json\")); err != nil {\n\t\t\t\tlost = append(lost, \"missing run witness \"+run.RunID)\n\t\t\t}\n\t\t}\n\t\tif run.AttemptID != \"\" {\n\t\t\tattempts, ok := checked[run.BundleID]\n\t\t\tif !ok {\n\t\t\t\tvar aerr error\n\t\t\t\tattempts, aerr = s.readDelegatedReviewAttempts(run.BundleID, &readBudget)\n\t\t\t\tif aerr != nil {\n\t\t\t\t\tlost = append(lost, aerr.Error())\n\t\t\t\t}\n\t\t\t\tchecked[run.BundleID] = attempts\n\t\t\t}\n\t\t\t// The reservation names the attempt's first agent; a continuation's\n\t\t\t// agent is checked against its own predecessor by the continuation\n\t\t\t// chain (a resume keeps it, a handoff changes it).\n\t\t\tfound := false\n\t\t\tfor _, a := range attempts {\n\t\t\t\tif a.AttemptID == run.AttemptID && a.BundleDigest == run.BundleDigest && a.Scope == run.Scope && (a.Adapter == run.Adapter || run.continues() != \"\") && a.Reason == run.Reason {\n\t\t\t\t\tfound = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !found {\n\t\t\t\tlost = append(lost, \"missing or conflicting attempt reservation \"+run.AttemptID)\n\t\t\t}\n\t\t}\n\t}\n\tfindings, ledgerErr := s.reviewRunLedgerFindings(\"\", &readBudget)\n\tif ledgerErr != nil {\n\t\tlost = append(lost, ledgerErr.Error())\n\t}\n\tlost = append(lost, findings...)\n\tlost = append(lost, s.reviewContinuationFindings(out)...)\n\treturn out, uniqueSorted(lost), nil\n}\nfunc (s Store) checkReviewRunTranscript(run ReviewRun) string {\n\tfull := filepath.Join(s.Root, filepath.FromSlash(run.TranscriptPath))\n\tfiles := s.fsys()\n\tinfo, err := files.Lstat(full)\n\tif err != nil {\n\t\treturn \"the transcript of the run cannot be inspected: \" + err.Error()\n\t}\n\tif !info.Mode().IsRegular() {\n\t\treturn \"the transcript of the run is not a regular file\"\n\t}\n\tif info.Size() > reviewTranscriptMaxBytes {\n\t\treturn \"the transcript exceeds the 256 MiB verification bound\"\n\t}\n\tfile, err := files.Open(full)\n\tif err != nil {\n\t\treturn \"the transcript of the run cannot be read: \" + err.Error()\n\t}\n\topened, statErr := file.Stat()\n\tif statErr != nil || !opened.Mode().IsRegular() || !sameObservedFile(info, opened) {\n\t\tfile.Close()\n\t\treturn \"the transcript changed while opening\"\n\t}\n\thash := sha256.New()\n\tn, readErr := io.Copy(hash, io.LimitReader(file, reviewTranscriptMaxBytes+1))\n\tcloseErr := file.Close()\n\tif readErr != nil || closeErr != nil {\n\t\treturn fmt.Sprintf(\"the transcript could not be verified: %v %v\", readErr, closeErr)\n\t}\n\tif n > reviewTranscriptMaxBytes {\n\t\treturn \"the transcript exceeds the 256 MiB verification bound\"\n\t}\n\tif \"sha256:\"+hex.EncodeToString(hash.Sum(nil)) != run.TranscriptDigest {\n\t\treturn \"the transcript of the run is not the one its digest names\"\n\t}\n\treturn \"\"\n}\n\nfunc removedSides(entry ReviewBundleSubjectEntry) []string {\n\tswitch entry.Action {\n\tcase \"removed\":\n\t\tif p := reviewBundleEntryPath(entry); p != \"\" {\n\t\t\treturn []string{p}\n\t\t}\n\tcase \"renamed\":\n\t\tif entry.OldPath != \"\" {\n\t\t\treturn []string{entry.OldPath}\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc sealedInputsThatDiffer(sealed, other ReviewBundle, checkout string) []string {\n\tkey := func(kind, p string) string { return kind + \" \" + p }\n\tcollect := func(b ReviewBundle) map[string]string {\n\t\tout := map[string]string{}\n\t\tfor _, in := range b.Payload.Scope.Sections {\n\t\t\tout[key(in.Kind, in.Path)] = in.Digest\n\t\t}\n\t\tfor _, in := range b.Payload.ConsumedInputs {\n\t\t\tswitch in.Kind {\n\t\t\tcase \"governed-config\", \"review-profile\", \"rule\":\n\t\t\t\tout[key(in.Kind, in.Path)] = in.Digest\n\t\t\t}\n\t\t}\n\t\treturn out\n\t}\n\twant, got := collect(sealed), collect(other)\nfunc (s Store) readReviewAttestations(bundleID string) (ReviewAttestationsRead, error) {\n\tcoverage := SourceCoverage{Losses: []SourceLoss{}}\n\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), false)\n\tif os.IsNotExist(err) {\n\t\treturn ReviewAttestationsRead{Attestations: []ReviewAttestation{}, Coverage: coverage}, nil\n\t}\n\tif err != nil {\n\t\treturn ReviewAttestationsRead{}, err\n\t}\n\tentries, err := s.fsys().ReadDir(dir)\n\tif os.IsNotExist(err) {\n\t\treturn ReviewAttestationsRead{Attestations: []ReviewAttestation{}, Coverage: coverage}, nil\n\t}\n\tif err != nil {\n\t\treturn ReviewAttestationsRead{}, err\n\t}\n\tresult := []ReviewAttestation{}\n\tfor _, entry := range entries {\n\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n\t\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", entry.Name()))\n\t\tif bundleID != \"\" {\n\t\t\traw, err := s.fsys().ReadFile(filepath.Join(dir, entry.Name()))\n\t\t\tif err != nil {\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossReadError, Detail: err.Error()})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tvar header struct {\n\t\t\t\tBundleID string `json:\"bundle_id\"`\n\t\t\t}\n\t\t\tif err := json.Unmarshal(raw, &header); err != nil {\n\t\t\t\tcoverage.Add(attributeLoss(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: \"the record is not valid JSON\"}, raw, \"bundle_id\"))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, _, ambiguous := sniffJSONString(raw, \"bundle_id\"); ambiguous {\n\t\t\t\t// A repeated name is valid JSON whose decoder keeps the last one: which\n\t\t\t\t// bundle the record belongs to is not settled, so it is not another's.\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossInvalid, Detail: \"the record names its bundle more than once\"})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif header.BundleID == \"\" {\n\t\t\t\t// Valid JSON that names no bundle is not another bundle's attestation.\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: \"the record names no bundle\"})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif header.BundleID != bundleID {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tatt, loadErr := s.LoadReviewAttestation(id)\n\t\tif loadErr != nil {\n\t\t\tif bundleID != \"\" {\n\t\t\t\treturn ReviewAttestationsRead{}, loadErr\n\t\t\t}\n\t\t\tloss := SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: loadErr.Error()}\n\t\t\tif raw, readErr := s.fsys().ReadFile(filepath.Join(dir, entry.Name())); readErr == nil {\n\t\t\t\tif futureSchema(raw) {\n\t\t\t\t\tloss.Kind, loss.Detail = LossUnsupported, \"the record has a schema_version this engine does not read\"\n\t\t\t\t}\n\t\t\t\tloss = attributeLoss(loss, raw, \"bundle_id\")\n\t\t\t} else {\n\t\t\t\tloss.Kind, loss.Detail = LossReadError, readErr.Error()\n\t\t\t}\n\t\t\tcoverage.Add(loss)\n\t\t\tcontinue\n\t\t}\n\t\tif bundleID == \"\" || att.BundleID == bundleID {\n\t\t\tresult = append(result, att)\n\t\t}\n\t}\n\tsort.Slice(result, func(i, j int) bool {\n\t\t// By instant: \"04:02-08:00\" is later than \"12:01Z\", whatever the text says.\n\t\treturn attestationLess(result[i], result[j])\n\t})\n\tcoverage.Normalize()\n\treturn ReviewAttestationsRead{Attestations: result, Coverage: coverage}, nil\n}\n\n// futureSchema reports well-formed JSON whose schema_version is one this engine does not read.\nfunc futureSchema(raw []byte) bool {\n\tvar header struct {\n\t\tSchemaVersion int `json:\"schema_version\"`\n\t}\n\tif json.Unmarshal(raw, &header) != nil {\n\t\treturn false\n\t}\n\treturn header.SchemaVersion > ReviewBundleSchemaVersion\n}\n\nfunc (s Store) VerifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tverification, err := s.verifyReviewBundle(scope)\n\tif err == nil && verification.Bundle != nil {\n\t\tassurance := s.DescribeReviewAssurance(*verification.Bundle, verification.Attestation)\n\t\tverification.Assurance = &assurance\n\t}\n\t\t\tdiffers = errorText(err) != item.errText || err == nil && value != item.value\n\t\t}\n\t\tif differs {\n\t\t\tchanged = append(changed, p.displayPath(item.path))\n\t\t}\n\t}\n\tsort.Strings(changed)\n\treturn changed\n}\n\nfunc (p *governanceReadViewProof) displayPath(path string) string {\n\trel, err := filepath.Rel(p.root, path)\n\tif err == nil && rel != \"..\" && !strings.HasPrefix(rel, \"..\"+string(filepath.Separator)) {\n\t\treturn filepath.ToSlash(rel)\n\t}\n\treturn \"external:\" + digestBytes([]byte(filepath.Clean(path)))\n}\n\ntype governanceReadViewFiles struct {\n\tview     *governanceReadView\n\tproducer string\n\tproject  string\n}\n\nfunc (f *governanceReadViewFiles) ReadFile(name string) ([]byte, error) {\n\treturn f.view.route(name, f.producer, f.project).readFile(name, f.producer)\n}\nfunc (f *governanceReadViewFiles) Open(name string) (fs.File, error) {\n\treturn f.view.route(name, f.producer, f.project).open(name, f.producer)\n}\nfunc (f *governanceReadViewFiles) Stat(name string) (fs.FileInfo, error) {\n\treturn f.view.route(name, f.producer, f.project).statInfo(name, f.producer, false)\n}\nfunc (f *governanceReadViewFiles) Lstat(name string) (fs.FileInfo, error) {\n\treturn f.view.route(name, f.producer, f.project).statInfo(name, f.producer, true)\n}\nfunc (f *governanceReadViewFiles) ReadDir(name string) ([]fs.DirEntry, error) {\n\treturn f.view.route(name, f.producer, f.project).readDir(name, f.producer)\n}\nfunc (f *governanceReadViewFiles) Readlink(name string) (string, error) {\n\treturn f.view.route(name, f.producer, f.project).readString(name, f.producer, \"readlink\")\n}\nfunc (f *governanceReadViewFiles) EvalSymlinks(name string) (string, error) {\n\treturn f.view.route(name, f.producer, f.project).readString(name, f.producer, \"eval-symlinks\")\n}\nfunc (*governanceReadViewFiles) WriteFile(string, []byte, fs.FileMode) error {\n\treturn errGovernanceReadViewWrite\n}\nfunc (*governanceReadViewFiles) CreateExclusive(string, []byte, fs.FileMode, bool) error {\n\treturn errGovernanceReadViewWrite\n}\nfunc (*governanceReadViewFiles) Publish(string, []byte, fs.FileMode, string, PublishExpectation) error {\n\treturn errGovernanceReadViewWrite\n}\nfunc (*governanceReadViewFiles) MkdirAll(string, fs.FileMode) error {\n\treturn errGovernanceReadViewWrite\n}\nfunc (*governanceReadViewFiles) Mkdir(string, fs.FileMode) error { return errGovernanceReadViewWrite }\nfunc (*governanceReadViewFiles) Remove(string) error             { return errGovernanceReadViewWrite }\nfunc (*governanceReadViewFiles) RemoveAll(string) error          { return errGovernanceReadViewWrite }\nfunc (*governanceReadViewFiles) Symlink(string, string) error    { return errGovernanceReadViewWrite }\nfunc (f *governanceReadViewFiles) Preview() *PreviewFiles        { return f.view.base.Preview() }\nfunc (f *governanceReadViewFiles) Now() time.Time                { return f.view.base.Now() }\nfunc (f *governanceReadViewFiles) UnderlyingFiles() Files        { return f.view.base }\nfunc (f *governanceReadViewFiles) GovernanceReadView() *governanceReadView {\n\treturn f.view\n}\nfunc (f *governanceReadViewFiles) GovernanceReadViewRootFor(path string) string {\n\treturn f.view.route(path, f.producer, f.project).root\n}\n\n// withoutGovernanceReadView gives a new operation the original Files binding,\n// never an earlier observation that has already been finalized. Operation\n// caches tied to that observation are dropped with it.\nfunc (s Store) withoutGovernanceReadView() Store {\n\tif base, unwrapped := unwrapGovernanceReadViewFiles(s.fsys()); unwrapped {\n\t\ts.FS = base\n\t}\n\tif s.FederatedResolver != nil {\n\t\tresolver := *s.FederatedResolver\n\t\tif base, unwrapped := unwrapGovernanceReadViewFiles(resolver.fsys()); unwrapped {\n\t\t\tresolver.FS = base\n\t\t}\n\t\tif resolver.Roots != nil {\n\t\t\trootFiles := resolver.Roots.fsys()\n\t\t\tif base, unwrapped := unwrapGovernanceReadViewFiles(rootFiles); unwrapped {\n\t\t\t\troots := cloneRootsWithFiles(resolver.Roots, base)\n\t\t\t\troots.governanceStores = map[string]Store{}\n\t\t\t\tresolver.Roots.mu.RLock()\n\t\t\t\tstores := make(map[string]Store, len(resolver.Roots.governanceStores))\n\t\t\t\tfor id, store := range resolver.Roots.governanceStores {\n\t\t\t\t\tstores[id] = store\n\t\t\t\t}\n\t\t\t\tresolver.Roots.mu.RUnlock()\n\t\t\t\tfor id, store := range stores {\n\t\t\t\t\troots.governanceStores[id] = store.withoutGovernanceReadView()\n\t\t\t\t}\n\t\t\t\tresolver.Roots = roots\n\t\t\t}\n\t\t}\n\t\tresolver.snapshots = nil\n\t\ts.FederatedResolver = &resolver\n\t}\n\ts.specs = nil\n\ts.reviewView = nil\n\ts.reviewReuse = nil\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n)\n\ntype reviewHeaderObservation struct {\n\towner      string\n\tloss       *SourceLoss\n\tdigest     [32]byte\n\treadError  string\n\tinputBytes int\n}\n\n// readReviewBundleHeader is the same classification for cached and live reads.\n// A known different owner is skippable only after whole-JSON and ambiguity checks.\nfunc readReviewBundleHeader(files Files, dir, name string) reviewHeaderObservation {\n\t// A bundle's header is read, hashed and classified once per operation:\n\t// a closeout lists every bundle for every scope it verifies (spec\n\t// pose-review-ledger-is-read-once-per-operation).\n\tobservation, _, _ := memoizedLedgerRead(files, \"bundle-header\\x00\"+filepath.Clean(dir)+\"\\x00\"+name, func() (reviewHeaderObservation, error) {\n\t\treturn observeReviewBundleHeader(files, dir, name), nil\n\t})\n\tif observation.loss != nil {\n\t\tloss := *observation.loss\n\t\tobservation.loss = &loss\n\t}\n\treturn observation\n}\n\n// observeReviewBundleHeader reads one bundle's bytes and classifies the scope\n// they declare.\nfunc observeReviewBundleHeader(files Files, dir, name string) reviewHeaderObservation {\n\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", name))\n\traw, err := files.ReadFile(filepath.Join(dir, name))\n\tif err != nil {\n\t\tloss := SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossReadError, Detail: err.Error()}\n\t\treturn reviewHeaderObservation{loss: &loss, readError: err.Error()}\n\t}\n\tresult := reviewHeaderObservation{digest: sha256.Sum256(raw), inputBytes: len(raw)}\n\t// What a bundle's bytes say about their scope is a function of the\n\t// bytes: it is parsed once per content digest, so a governance check\n\t// that reads every bundle for every scope parses each content once\n\t// (spec pose-federated-proof-reads-each-input-once).\n\tparsed := reviewBundleHeaderParses.get(string(result.digest[:]), func() (reviewBundleHeaderParse, bool) {\n\t\treturn parseReviewBundleHeader(raw, rel), true\n\t})\n\tresult.owner = parsed.owner\n\tif parsed.loss != nil {\n\t\tloss := *parsed.loss\n\t\tloss.Artifact = rel\n\t\tresult.loss = &loss\n\t}\n\treturn result\n}\n\n// parseReviewBundleHeader reads the scope a bundle's bytes declare, or why\n// they declare none.\nfunc parseReviewBundleHeader(raw []byte, rel string) reviewBundleHeaderParse {\n\tvar header struct {\n\t\tPayload struct {\n\t\t\tScope struct {\n\t\t\t\tRef string `json:\"ref\"`\n\t\t\t} `json:\"scope\"`\n\t\t} `json:\"payload\"`\n\t}\n\tvar loss SourceLoss\n\tswitch {\n\tcase json.Unmarshal(raw, &header) != nil:\n\t\tloss = attributeLoss(SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossParseError, Detail: \"the record is not valid JSON\"}, raw, \"payload\", \"scope\", \"ref\")\n\tcase func() bool { _, _, ambiguous := sniffJSONString(raw, \"payload\", \"scope\", \"ref\"); return ambiguous }():\n\t\tloss = SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossInvalid, Detail: \"the record names its scope more than once\"}\n\tcase header.Payload.Scope.Ref == \"\":\n\t\tloss = SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossParseError, Detail: \"the record names no scope\"}\n\tdefault:\n\t\treturn reviewBundleHeaderParse{owner: header.Payload.Scope.Ref}\n\t}\n\treturn reviewBundleHeaderParse{loss: &loss}\n}\n\n// reviewBundleHeaderParses keeps, per content digest, the scope a bundle\n// names or why it names none; bounded for a long-running process.\nvar reviewBundleHeaderParses = newKeptCache[reviewBundleHeaderParse](50000)\n\ntype reviewBundleHeaderParse struct {\n\towner string\n\tloss  *SourceLoss\n}\n\ntype reviewOperationView struct {\n\tcoordinator      *reviewOperationView\n\tcoordinatorStore Store\n\tscopeBase        Store\n\tscopeRoots       map[string]string\n\tscopeConflicts   map[string]bool\n\tscopeInit        sync.Once\n\tscopeInitErr     error\n\n\tspecOnce        sync.Once\n\tspecUsed        bool\n\tspecErr         error\n\tspecFallback    bool\n\tspecEntries     []Spec\n\tspecBySlug      map[string]int\n\tspecBodyMu      sync.Mutex\n\tspecBodySeen    []bool\n\tspecBodyDigests [][32]byte\n\tspecConflict    bool\n\troot            string\n\tfiles           Files\n\tproject         string\n\tresolver        *ArtifactResolver\n\tonce            sync.Once\n\tclosed          atomic.Bool\n\tcontextConflict atomic.Bool\n\tused            bool // published by once; consumers call once before inspecting it\n\tdirectoryError  string\n\tinventory       [32]byte\n\theaders         map[string]reviewHeaderObservation\n\tfallback        bool\n\tmaxRecords      int\n\tmaxInputBytes   int\n\tmaxRetainedText int\n}\n\n// WithReviewOperationView shares immutable headers and spec metadata for this\n// callback. Strict loading, ordering, trust and each worker's traversal remain\n// live. Finalization rereads observed bytes before the read can be green.\n// This is not an atomic filesystem snapshot or a write authorization cache.\nfunc (s Store) WithReviewOperationView(run func(Store)) error {\n\tbaseFiles := s.fsys()\n\tkeyable := reflect.ValueOf(baseFiles).Comparable()\n\tbase, readView := s.beginGovernanceReadView()\n\tshared := base.withGovernanceReadView(readView, \"review-operation\")\n\tview := &reviewOperationView{root: filepath.Clean(shared.Root), files: shared.fsys(),\n\t\tproject: shared.FederatedProjectID, resolver: shared.FederatedResolver,\n\t\tmaxRecords: 10000, maxInputBytes: 128 * 1024 * 1024, maxRetainedText: 8 * 1024 * 1024}\n\tvar operationErr error\n\tif !keyable {\n\t\t// Unknown identity cannot safely key the bounded optimization. The\n\t\t// operation still reads through the governance view and receives its\n\t\t// final closure audit; it simply falls back to live catalogue traversal.\n\t\tshared.reviewView = nil\n\t\tshared.specs = nil\n\t\tshared.reviewReuse = nil\n\t\trun(shared)\n\t} else {\n\t\toperationErr = shared.withReviewOperationView(view, run)\n\t}\n\taudit := readView.audit()\n\treturn errors.Join(operationErr, reviewOperationGovernanceAuditError(audit, readView, view))\n}\n\nfunc reviewOperationGovernanceAuditError(audit governanceReadViewAudit, readView *governanceReadView, operationView *reviewOperationView) error {\n\tvar result error\n\tchanged := audit.ChangedProducers[\"review-operation\"] || audit.ChangedProducers[\"projection\"]\n\tif changed {\n\t\tpaths := append([]string(nil), audit.ChangedPaths...)\n\t\tif len(paths) == 0 {\n\t\t\tpaths = []string{\"input closure\"}\n\t\t}\n\t\tresult = fmt.Errorf(\"pose: review inputs changed during operation: %s: %w\", strings.Join(uniqueSorted(paths), \", \"), ErrGovernanceReadViewChanged)\n\t}\n\t// The operation view certifies the bytes and metadata its review producers\n\t// consumed. Projection-only context such as an unavailable HEAD does not\n\t// become a write authorization or a current-generation claim here; any\n\t// unprovable read attributed to this operation still fails closed.\n\tif reasons := audit.UnknownProducers[\"review-operation\"]; len(reasons) > 0 && !reviewOperationReadLossIsCovered(audit, readView, operationView) {\n\t\tresult = errors.Join(result, fmt.Errorf(\"pose: review input closure is unknown: %s: %w\", strings.Join(uniqueSorted(reasons), \"; \"), ErrGovernanceReadViewUnknown))\n\t}\n\treturn result\n}\n\n// reviewOperationReadLossIsCovered keeps a stable, unreadable bundle in the\n// operation result as source-coverage loss. ReadReviewBundles reports that\n// loss to its caller, and validate() proves the same file remains unreadable;\n// this wrapper should not turn a localized record loss into a second API error.\n// Other unknown inputs still make the operation result unavailable.\nfunc reviewOperationReadLossIsCovered(audit governanceReadViewAudit, readView *governanceReadView, operationView *reviewOperationView) bool {\n\tif readView == nil || operationView == nil || !operationView.used || operationView.fallback {\n\t\treturn false\n\t}\n\tfor _, reason := range audit.UnknownProducers[\"review-operation\"] {\n\t\tif reason != \"input bytes could not be read\" {\n\t\t\treturn false\n\t\t}\n\t}\n\treadView.mu.Lock()\n\tdefer readView.mu.Unlock()\n\tcovered := map[string]string{}\n\tfor name, observation := range operationView.headers {\n\t\tif observation.readError == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif observation.loss == nil || observation.loss.Kind != LossReadError {\n\t\t\treturn false\n\t\t}\n\t\tcovered[filepath.Base(name)] = observation.readError\n\t}\n\tif len(covered) == 0 {\n\t\treturn false\n\t}\n\tmatched := 0\n\tfor path, observation := range readView.files {\n\t\tif !observation.producers[\"review-operation\"] || observation.err == nil || os.IsNotExist(observation.err) {\n\t\t\tcontinue\n\t\t}\n\t\trel, err := filepath.Rel(operationView.root, path)\n\t\tif err != nil || !strings.HasPrefix(filepath.ToSlash(rel), \".pose/review-bundles/\") {\n\t\t\treturn false\n\t\t}\n\t\tname := filepath.Base(path)\n\t\tif covered[name] == \"\" || covered[name] != observation.errText {\n\t\t\treturn false\n\t\t}\n\t\tdelete(covered, name)\n\t\tmatched++\n\t}\n\treturn matched > 0 && len(covered) == 0\n}\n\nfunc (s Store) withReviewOperationView(view *reviewOperationView, run func(Store)) error {\n\ts.reviewView = view\n\ts.specs = nil       // an earlier advisory listing is not this operation's capture\n\ts.reviewReuse = nil // copied worker stores each start their own traversal\n\tdefer view.closed.Store(true)\n\trun(s)\n\t// Join lazy initialization, if any; finalization must follow joined workers.\n\tview.once.Do(func() {})\n\tview.specOnce.Do(func() {})\n\treturn errors.Join(view.validateSpecs(), view.validate())\n}\n\n// prepareReviewOperationRead preserves Store's live-read behavior after an\n// operation view retires, while refusing to borrow an active view under a\n// different root, project, resolver, or Files binding.\nfunc (s Store) prepareReviewOperationRead() (Store, error) {\n\tif s.reviewView != nil && s.reviewView.closed.Load() {\n\t\ts = s.withoutGovernanceReadView()\n\t}\n\treadView, viewFiles := governanceReadViewFromFiles(s.fsys())\n\tif readView != nil {\n\t\treadView.mu.Lock()\n\t\tfinalized := readView.closed\n\t\treadView.mu.Unlock()\n\t\tif finalized {\n\t\t\ts = s.withoutGovernanceReadView()\n\t\t\treadView, viewFiles = governanceReadViewFromFiles(s.fsys())\n\t\t}\n\t}\n\tif s.reviewView != nil && !s.reviewView.closed.Load() && !s.reviewView.boundTo(s) {\n\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t}\n\tif readView != nil && viewFiles != nil {\n\t\tif s.FederatedProjectID != \"\" && viewFiles.project != \"\" && s.FederatedProjectID != viewFiles.project {\n\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t}\n\t\tif readView.operation == nil {\n\t\t\tif filepath.Clean(s.Root) != filepath.Clean(readView.root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t\t// A same-root advisory view may be attached directly to a local Store\n\t\t\t// without an operation coordinator. Keep that local read path usable,\n\t\t\t// but do not infer a federated identity or borrow a resolver binding.\n\t\t\tif s.FederatedProjectID != viewFiles.project || s.FederatedResolver != nil || viewFiles.project != \"\" {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t} else {\n\t\t\t// StoreFor(project) deliberately returns an unscoped Store whose Files\n\t\t\t// wrapper still carries the primary read view. Route by the captured\n\t\t\t// project/root vector first, then verify the selected root itself;\n\t\t\t// comparing against readView.root here would reject every valid child.\n\t\t\trouteProject := viewFiles.project\n\t\t\tif routeProject == \"\" {\n\t\t\t\trouteProject = s.FederatedProjectID\n\t\t\t}\n\t\t\tif routeProject == \"\" {\n\t\t\t\trouteProject = readView.operation.mainProject\n\t\t\t}\n\t\t\tif !sameLexicalRoot(readView.operation.initialRoots[routeProject], s.Root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t\ttarget := readView.operation.route(s.Root, viewFiles.producer, routeProject)\n\t\t\tif target == nil || !sameLexicalRoot(target.root, s.Root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t}\n\t}\n\treturn s, nil\n}\n\nfunc (s Store) refuseReviewOperationContext(readView *governanceReadView, viewFiles *governanceReadViewFiles) error {\n\tif s.reviewView != nil && !s.reviewView.closed.Load() {\n\t\ts.reviewView.contextConflict.Store(true)\n\t}\n\tif readView != nil {\n\t\tproducer := \"review-operation\"\n\t\tif viewFiles != nil && viewFiles.producer != \"\" {\n\t\t\tproducer = viewFiles.producer\n\t\t}\n\t\treadView.markUnknown(producer, \"review Store context no longer matches the authorized operation binding\")\n\t}\n\treturn fmt.Errorf(\"pose: review Store context changed: %w\", errGovernanceReadViewOutsideRoot)\n}\n\nfunc (v *reviewOperationView) captureSpecs(s Store) {\n\tv.specOnce.Do(func() {\n\t\tv.specUsed = true\n\t\tentries, err := s.listSpecs(\"\", \"\")\n\t\tv.specErr = err\n\t\tif err != nil {\n\t\t\treturn\n\t\t}\n\t\tif len(entries) > v.maxRecords {\n\t\t\tv.specFallback = true\n\t\t\treturn\n\t\t}\n\t\tretained := 0\n\t\tfor _, sp := range entries {\n\t\t\traw, _ := json.Marshal(sp)\n\t\t\tretained += len(raw)\n\t\t\tif retained > v.maxRetainedText {\n\t\t\t\tv.specFallback = true\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\tv.specEntries = entries\n\t\tv.specBySlug = make(map[string]int, len(entries))\n\t\tfor i, sp := range entries {\n\t\t\tif _, exists := v.specBySlug[sp.Slug]; exists {\n\t\t\t\tv.specBySlug[sp.Slug] = -1\n\t\t\t} else {\n\t\t\t\tv.specBySlug[sp.Slug] = i\n\t\t\t}\n\t\t}\n\t\tv.specBodySeen = make([]bool, len(entries))\n\t\tv.specBodyDigests = make([][32]byte, len(entries))\n\t})\n}\n\nfunc (s Store) reviewViewSpec(slug string) (*Spec, bool, error) {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil, false, nil\n\t}\n\tv.captureSpecs(s)\n\tif v.specFallback {\n\t\treturn nil, false, nil\n\t}\n\tif v.specErr != nil {\n\t\treturn nil, true, v.specErr\n\t}\n\tindex, exists := v.specBySlug[slug]\n\tif !exists {\n\t\treturn nil, true, fmt.Errorf(\"pose: spec %q not found\", slug)\n\t}\n\tif index < 0 {\n\t\treturn nil, true, SpecIdentityConflictError{Slug: slug}\n\t}\n\tfull, err := s.readListedSpec(cloneSpec(v.specEntries[index]))\n\treturn full, true, err\n}\n\nfunc (s Store) reviewViewSpecs(status, components string) ([]Spec, bool, error) {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil, false, nil\n\t}\n\tv.captureSpecs(s)\n\tif v.specFallback {\n\t\treturn nil, false, nil\n\t}\n\tif v.specErr != nil {\n\t\treturn nil, true, v.specErr\n\t}\n\twantedStatus, wantedComponents := splitStatusFilter(status), splitCommaFilter(components)\n\tresult := []Spec{}\n\tfor _, sp := range v.specEntries {\n\t\tif len(wantedStatus) > 0 && !statusMatchesAny(sp.Status, wantedStatus) {\n\t\t\tcontinue\n\t\t}\n\t\tif len(wantedComponents) > 0 && !componentsMatchAny(sp.Components, wantedComponents) {\n\t\t\tcontinue\n\t\t}\n\t\tresult = append(result, cloneSpec(sp))\n\t}\n\treturn result, true, nil\n}\n\nfunc (s Store) observeReviewSpecBody(listed Spec, full *Spec) error {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil\n\t}\n\tv.captureSpecs(s)\n\tif v.specFallback {\n\t\treturn nil\n\t}\n\tif v.specErr != nil {\n\t\treturn v.specErr\n\t}\n\tindex, exists := v.specBySlug[listed.Slug]\n\tmetadata := *full\n\tmetadata.Body = \"\"\n\tdigest := sha256.Sum256([]byte(full.Body))\n\tv.specBodyMu.Lock()\n\tdefer v.specBodyMu.Unlock()\n\tif !exists || index < 0 || !reflect.DeepEqual(metadata, v.specEntries[index]) || (v.specBodySeen[index] && v.specBodyDigests[index] != digest) {\n\t\tv.specConflict = true\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: spec %s\", listed.Slug)\n\t}\n\tv.specBodySeen[index] = true\n\tv.specBodyDigests[index] = digest\n\treturn nil\n}\n\nfunc (v *reviewOperationView) validateSpecs() error {\n\tif v.coordinator != nil {\n\t\tif v.specConflict {\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: consumed spec body: %w\", ErrGovernanceReadViewChanged)\n\t\t}\n\t\treturn nil\n\t}\n\tif !v.specUsed || v.specFallback {\n\t\treturn nil\n\t}\n\tstore := Store{Root: v.root, FS: v.files}\n\tcurrent, err := store.listSpecs(\"\", \"\")\n\tif v.specErr != nil {\n\t\tif err != nil && err.Error() == v.specErr.Error() {\n\t\t\treturn nil\n\t\t}\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: spec catalogue availability\")\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %w\", err)\n\t}\n\tif !reflect.DeepEqual(current, v.specEntries) {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: spec catalogue\")\n\t}\n\tv.specBodyMu.Lock()\n\tconflict := v.specConflict\n\tseen := append([]bool(nil), v.specBodySeen...)\n\tdigests := append([][32]byte(nil), v.specBodyDigests...)\n\tv.specBodyMu.Unlock()\n\tif conflict {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: consumed spec body\")\n\t}\n\tfor i, listed := range current {\n\t\tif !seen[i] {\n\t\t\tcontinue\n\t\t}\n\t\tfull, err := store.readListedSpec(listed)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %w\", err)\n\t\t}\n\t\tdigest := sha256.Sum256([]byte(full.Body))\n\t\tfull.Body = \"\"\n\t\tif digest != digests[i] || !reflect.DeepEqual(*full, listed) {\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: spec %s\", listed.Slug)\n\t\t}\n\t}\n\tcurrent, err = store.listSpecs(\"\", \"\")\n\tif err != nil || !reflect.DeepEqual(current, v.specEntries) {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: spec catalogue after body audit\")\n\t}\n\treturn nil\n}\n\nfunc (v *reviewOperationView) boundTo(s Store) bool {\n\tfiles := s.fsys()\n\treturn !v.closed.Load() && filepath.Clean(s.Root) == v.root &&\n\t\ts.FederatedProjectID == v.project && s.FederatedResolver == v.resolver &&\n\t\treflect.TypeOf(files) == reflect.TypeOf(v.files) && reflect.ValueOf(files).Comparable() && reflect.ValueOf(v.files).Comparable() && files == v.files\n}\n\nfunc reviewHeaderInventory(entries []os.DirEntry) [32]byte {\n\th := sha256.New()\n\tfor _, entry := range entries {\n\t\tif !entry.IsDir() && strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tfmt.Fprintf(h, \"%s\\x00%d\\x00\", entry.Name(), entry.Type())\n\t\t}\n\t}\n\tvar result [32]byte\n\tcopy(result[:], h.Sum(nil))\n\treturn result\n}\n\nfunc (v *reviewOperationView) observeDirectoryError(s Store, err error) {\n\tif v.boundTo(s) {\n\t\tv.once.Do(func() { v.used = true; v.directoryError = err.Error() })\n\t}\n}\n\nfunc (s Store) reviewBundleHeaders(dir string, entries []os.DirEntry) (map[string]reviewHeaderObservation, error) {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil, nil\n\t}\n\tv.once.Do(func() {\n\t\tv.used = true\n\t\tv.inventory = reviewHeaderInventory(entries)\n\t\theaders := map[string]reviewHeaderObservation{}\n\t\tinputBytes, textBytes := 0, 0\n\t\tfor _, entry := range entries {\n\t\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif len(headers) >= v.maxRecords {\n\t\t\t\tv.fallback = true\n\t\t\t\treturn\n\t\t\t}\n\t\t\tobservation := readReviewBundleHeader(v.files, dir, entry.Name())\n\t\t\tinputBytes += observation.inputBytes\n\t\t\ttextBytes += len(entry.Name()) + len(observation.owner) + len(observation.readError)\n\t\t\tif observation.loss != nil {\n\t\t\t\traw, _ := json.Marshal(observation.loss)\n\t\t\t\ttextBytes += len(raw)\n\t\t\t}\n\t\t\tif inputBytes > v.maxInputBytes || textBytes > v.maxRetainedText {\n\t\t\t\tv.fallback = true\n\t\t\t\treturn\n\t\t\t}\n\t\t\theaders[entry.Name()] = observation\n\t\t}\n\t\tv.headers = headers // publish only the complete immutable catalogue\n\t})\n\tif v.directoryError != \"\" || v.inventory != reviewHeaderInventory(entries) {\n\t\treturn nil, fmt.Errorf(\"pose: review inputs changed during operation: bundle directory\")\n\t}\n\tif v.fallback {\n\t\treturn nil, nil\n\t}\n\treturn v.headers, nil\n}\n\nfunc (v *reviewOperationView) validate() error {\n\tif v.contextConflict.Load() {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: Store context\")\n\t}\n\tif v.coordinator != nil || !v.used {\n\t\treturn nil\n\t}\n\tdir, err := ensureReviewArtifactDirIn(v.files, v.root, \".pose/review-bundles\", false)\n\tvar entries []os.DirEntry\n\tif err == nil {\n\t\tentries, err = v.files.ReadDir(dir)\n\t}\n\tif v.directoryError != \"\" {\n\t\tif err != nil && err.Error() == v.directoryError {\n\t\t\treturn nil\n\t\t}\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: bundle directory availability\")\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %w\", err)\n\t}\n\tif reviewHeaderInventory(entries) != v.inventory {\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: bundle inventory\")\n\t}\n\tif v.fallback {\n\t\treturn nil\n\t} // no header observations were reused\n\tfor _, entry := range entries {\n\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tbefore := v.headers[entry.Name()]\n\t\traw, err := v.files.ReadFile(filepath.Join(dir, entry.Name()))\n\t\tif before.readError != \"\" {\n\t\t\tif err != nil && err.Error() == before.readError {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %s availability\", entry.Name())\n\t\t}\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %s: %w\", entry.Name(), err)\n\t\t}\n\t\tif sha256.Sum256(raw) != before.digest {\n\t\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: %s bytes\", entry.Name())\n\t\t}\n\t}\n\treturn nil\n}\n\n// WithReviewCoordinator audits shared selection and catalogue inputs after all\n// scope callbacks join. Findings must be buffered until this method returns.\n// Scope operations certify their own closures, not a simultaneous batch snapshot.\nfunc (s Store) WithReviewCoordinator(run func(Store) error) error {\n\tvar callbackErr error\n\tauditErr := s.WithReviewOperationView(func(shared Store) {\n\t\tv := shared.reviewView\n\t\tif v == nil {\n\t\t\tcallbackErr = fmt.Errorf(\"pose: review coordinator requires comparable Files binding\")\n\t\t\treturn\n\t\t}\n\t\treadView, _ := governanceReadViewFromFiles(shared.fsys())\n\t\tv.scopeBase = readView.operation.baseStore\n\t\tv.scopeRoots = readView.operation.initialRoots\n\t\tv.scopeConflicts = readView.operation.initialConflicts\n\t\tv.coordinatorStore = shared\n\t\tcallbackErr = run(shared)\n\t})\n\treturn errors.Join(callbackErr, auditErr)\n}\n\n// reviewScopeCatalogue authorizes reuse against the exact coordinator Store,\n// and creates a separately bound catalogue consumer. It never unwraps Files.\ntype reviewScopeCatalogue interface {\n\tscopeCatalogue(Store) (Store, *reviewOperationView, error)\n}\n\nfunc (v *reviewOperationView) scopeCatalogue(s Store) (Store, *reviewOperationView, error) {\n\tif !v.boundTo(s) || v.coordinator != nil || v.coordinatorStore.reviewView != v {\n\t\treturn Store{}, nil, s.refuseReviewOperationContext(nil, nil)\n\t}\n\tv.scopeInit.Do(func() {\n\t\tshared := v.coordinatorStore\n\t\tv.captureSpecs(shared)\n\t\tif v.specErr != nil {\n\t\t\tv.scopeInitErr = v.specErr\n\t\t\treturn\n\t\t}\n\t\tdir, err := ensureReviewArtifactDirIn(v.files, v.root, \".pose/review-bundles\", false)\n\t\tif err != nil {\n\t\t\tv.observeDirectoryError(shared, err)\n\t\t\treturn\n\t\t}\n\t\tentries, err := v.files.ReadDir(dir)\n\t\tif err != nil {\n\t\t\tv.observeDirectoryError(shared, err)\n\t\t\treturn\n\t\t}\n\t\t_, v.scopeInitErr = shared.reviewBundleHeaders(dir, entries)\n\t})\n\tif v.scopeInitErr != nil {\n\t\treturn Store{}, nil, v.scopeInitErr\n\t}\n\treturn v.scopeBase, v, nil\n}\n\n// WithReviewScopeOperationView evaluates one scope, including recursive children\n// and authorized roots, with an independent bounded capture and final audit.\nfunc (s Store) WithReviewScopeOperationView(run func(Store) error) error {\n\tvar catalog reviewScopeCatalogue = s.reviewView\n\tif s.reviewView == nil {\n\t\treturn fmt.Errorf(\"pose: review scope requires an active coordinator\")\n\t}\n\tbase, parent, err := catalog.scopeCatalogue(s)\n\tif err != nil {\n\t\treturn err\n\t}\n\tbase, readView := base.beginGovernanceReadView()\n\tshared := base.withGovernanceReadView(readView, \"review-operation\")\n\tif !sameStringMap(parent.scopeRoots, readView.operation.initialRoots) || !sameBoolMap(parent.scopeConflicts, readView.operation.initialConflicts) {\n\t\treadView.markUnknown(\"review-operation\", \"scope authorized root vector differs from coordinator\")\n\t\treturn errors.Join(errGovernanceReadViewOutsideRoot, reviewOperationGovernanceAuditError(readView.audit(), readView, nil))\n\t}\n\t// The consumed index's inputs, the federated material among them, are the\n\t// same for every scope of the coordinator: they are checked once, under\n\t// the coordinator's view, whose audit runs after every scope joins (ADR\n\t// governance-reads-use-bounded-operation-scoped-views D12).\n\tif coordinatorView, _ := governanceReadViewFromFiles(parent.coordinatorStore.fsys()); coordinatorView != nil && coordinatorView.operation != nil {\n\t\treadView.operation.indexInputsFrom = coordinatorView.operation\n\t\treadView.operation.indexInputsFiles = parent.coordinatorStore.fsys()\n\t}\n\tview := &reviewOperationView{root: filepath.Clean(shared.Root), files: shared.fsys(), project: shared.FederatedProjectID, resolver: shared.FederatedResolver,\n\t\tcoordinator: parent, specUsed: parent.specUsed, specErr: parent.specErr, specFallback: parent.specFallback, specEntries: parent.specEntries, specBySlug: parent.specBySlug,\n\t\tspecBodySeen: make([]bool, len(parent.specEntries)), specBodyDigests: make([][32]byte, len(parent.specEntries)),\n\t\tused: parent.used, directoryError: parent.directoryError, inventory: parent.inventory, headers: parent.headers, fallback: parent.fallback,\n\t\tmaxRecords: parent.maxRecords, maxInputBytes: parent.maxInputBytes, maxRetainedText: parent.maxRetainedText}\n\tview.specOnce.Do(func() {})\n\tview.once.Do(func() {})\n\tvar callbackErr error\n\toperationErr := shared.withReviewOperationView(view, func(scoped Store) { callbackErr = run(scoped) })\n\taudit := readView.audit()\n\treturn errors.Join(callbackErr, operationErr, reviewOperationGovernanceAuditError(audit, readView, view))\n}\n","exit_code":0,"status":"completed"}}
