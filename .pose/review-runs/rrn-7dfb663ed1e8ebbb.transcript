{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1546,1625p' pose-mcp/internal/pose/governance_read_view.go; sed -n '485,550p' pose-mcp/internal/pose/review_run_continuity.go; sed -n '245,275p' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '306,375p' pose-mcp/internal/pose/review_attempt_ledger.go; rg -n 'json:.*(runs|attestations|losses)' pose-mcp/internal/pose/{source_coverage.go,review_bundle.go,review_rounds.go}; rg -n 'att\\\\.Findings|att\\\\.Criteria|attestation\\\\.Findings|attestation\\\\.Criteria|run\\\\.Safety\\\\.|run\\\\.Provenance\\\\.' pose-mcp/internal/pose --glob '*.go' | head -55\"","aggregated_output":"func (v *governanceReadView) open(name, producer string) (fs.File, error) {\n\tif err := v.begin(); err != nil {\n\t\treturn nil, err\n\t}\n\tdefer v.end()\n\tpath := v.pathKey(name)\n\tv.mu.Lock()\n\tif cached := v.files[path]; cached != nil {\n\t\tcached.producers[producer] = true\n\t\tdata, err, info := append([]byte(nil), cached.bytes...), cached.err, cached.info\n\t\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\t\tv.markUnknownLocked(producer, \"input bytes could not be read\")\n\t\t}\n\t\tv.mu.Unlock()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif info == nil {\n\t\t\tvar err error\n\t\t\tinfo, err = v.statInfo(path, producer, false)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t}\n\t\treturn newGovernanceReadFile(data, info), nil\n\t}\n\tresolved, rootReal, resolveErr := v.resolveForReadLocked(path, producer)\n\tif resolveErr != nil {\n\t\tv.mu.Unlock()\n\t\treturn nil, resolveErr\n\t}\n\tpreflight, preflightErr := v.base.Stat(path)\n\tif preflightErr != nil {\n\t\tif !errors.Is(preflightErr, os.ErrNotExist) {\n\t\t\tv.markUnknownLocked(producer, \"input metadata could not be read before opening\")\n\t\t}\n\t\tv.files[path] = &governanceReadFileObservation{err: preflightErr, errText: errorText(preflightErr), source: \"open\", baseName: path, rootReal: rootReal, resolved: resolved, producers: map[string]bool{producer: true}}\n\t\tv.mu.Unlock()\n\t\treturn nil, preflightErr\n\t}\n\tif preflight.IsDir() {\n\t\tv.mu.Unlock()\n\t\tinfo, statErr := v.statInfo(path, producer, false)\n\t\tif statErr != nil {\n\t\t\treturn nil, statErr\n\t\t}\n\t\tif info == nil || !info.IsDir() {\n\t\t\tv.markUnknown(producer, \"directory changed while its metadata was captured\")\n\t\t\treturn nil, errGovernanceReadViewOutsideRoot\n\t\t}\n\t\tentries, dirErr := v.readDir(path, producer)\n\t\tif dirErr != nil {\n\t\t\treturn nil, dirErr\n\t\t}\n\t\treturn newGovernanceReadDirectoryFile(path, producer, entries, info), nil\n\t}\n\tif !preflight.Mode().IsRegular() {\n\t\tv.markUnknownLocked(producer, \"input is not a regular file\")\n\t\tv.mu.Unlock()\n\t\treturn nil, fmt.Errorf(\"pose: read view cannot capture non-regular file %s\", v.displayPath(path))\n\t}\n\tremaining := governanceReadViewMaxInputBytes - v.inputBytes\n\tif v.operation != nil && v.operation.remainingInput() < remaining {\n\t\tremaining = v.operation.remainingInput()\n\t}\n\tif remaining < 0 || v.operation == nil && int64(len(v.files)+len(v.observed)+1) > governanceReadViewMaxRecords {\n\t\tv.markUnknownLocked(producer, \"file bytes were not retained within the read view budget\")\n\t\tv.mu.Unlock()\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tif v.operation != nil {\n\t\tmetadataCost := int64(len(\"file\") + len(v.displayPath(path)) + 64)\n\t\tif !v.operation.reserveRecord(metadataCost) {\n\t\t\tv.markUnknownLocked(producer, \"read view exceeded its operation record or metadata budget\")\n\t\t\tv.mu.Unlock()\n\t\t\treturn nil, errGovernanceReadViewBudget\n\t\t}\n\t}\n\tif preflight.Size() < 0 {\n\t\tv.markUnknownLocked(producer, \"input size is unavailable before opening\")\nfunc (s Store) reviewContinuationFindings(runs []ReviewRun) []string {\n\tfiles := s.fsys()\n\tentries, e := ledgerEntriesIn(files, s.Root, reviewContinuationsDir)\n\tif e != nil {\n\t\treturn []string{e.Error()}\n\t}\n\tbyID := map[string]ReviewRun{}\n\tfor _, r := range runs {\n\t\tbyID[r.RunID] = r\n\t}\n\tclaims := map[string]reviewContinuation{}\n\treceipts := map[string]reviewAttemptReceipt{}\n\tlosses := []string{}\n\tbudget := int64(32 << 20)\n\tfor _, entry := range entries {\n\t\tif IsPublisherStaging(entry.Name()) {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(s.Root, reviewContinuationsDir, entry.Name())\n\t\tif strings.HasSuffix(entry.Name(), \".result.json\") {\n\t\t\tvar receipt reviewAttemptReceipt\n\t\t\tif e := readLedgerJSONBudgetIn(files, full, &receipt, &budget); e != nil {\n\t\t\t\tlosses = append(losses, e.Error())\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\treceipts[strings.TrimSuffix(entry.Name(), \".result.json\")] = receipt\n\t\t} else if strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tvar claim reviewContinuation\n\t\t\tif e := readLedgerJSONBudgetIn(files, full, &claim, &budget); e != nil {\n\t\t\t\tlosses = append(losses, e.Error())\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n\t\t\tprior, ok := byID[id]\n\t\t\tprior.Path, prior.SupersededBy = \"\", \"\"\n\t\t\traw, _ := json.Marshal(prior)\n\t\t\tif !ok || claim.SchemaVersion != 1 || claim.Predecessor != id || claim.AttemptID != prior.AttemptID || claim.PredecessorDigest != digestBytes(raw) {\n\t\t\t\tlosses = append(losses, \"missing or rewritten continuation predecessor \"+id)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif nonce, e := hex.DecodeString(claim.Nonce); e != nil || len(nonce) != 16 {\n\t\t\t\tlosses = append(losses, \"invalid continuation nonce\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, e := time.Parse(time.RFC3339Nano, claim.ClaimedAt); e != nil {\n\t\t\t\tlosses = append(losses, \"invalid continuation claim time\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tclaims[id] = claim\n\t\t} else {\n\t\t\tlosses = append(losses, \"unknown continuation artifact \"+entry.Name())\n\t\t}\n\t\tif budget <= 0 {\n\t\t\tlosses = append(losses, \"continuation inventory read budget exhausted\")\n\t\t\tbreak\n\t\t}\n\t}\n\tfor id, receipt := range receipts {\n\t\tclaim, ok := claims[id]\n\t\tnext, exists := byID[receipt.RunID]\n\t\tcopy := next\n\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n\t\traw, _ := json.Marshal(copy)\n\t\tif !ok || !exists || receipt.SchemaVersion != 1 || receipt.AttemptID != claim.AttemptID || next.AttemptID != claim.AttemptID || next.continues() != id || receipt.RunDigest != digestBytes(raw) {\n\t\t\tlosses = append(losses, \"missing or conflicting continuation result \"+id)\n\t\t}\nfunc governanceReadViewFromFiles(files Files) (*governanceReadView, *governanceReadViewFiles) {\n\tfor depth := 0; depth < maxGovernanceFilesWrappers; depth++ {\n\t\tfiles = FilesOrNative(files)\n\t\tif viewFiles, ok := files.(*governanceReadViewFiles); ok {\n\t\t\treturn viewFiles.view, viewFiles\n\t\t}\n\t\tif provider, ok := files.(interface{ GovernanceReadView() *governanceReadView }); ok {\n\t\t\tif view := provider.GovernanceReadView(); view != nil {\n\t\t\t\treturn view, nil\n\t\t\t}\n\t\t}\n\t\tunderlying, ok := files.(interface{ UnderlyingFiles() Files })\n\t\tif !ok {\n\t\t\treturn nil, nil\n\t\t}\n\t\tfiles = underlying.UnderlyingFiles()\n\t}\n\treturn nil, nil\n}\n\n// capture is also used while an authorized child root is being opened, before\n// a producer Files wrapper for that root exists. Root membership is checked\n// against the operation's already-bound roots.\nfunc (op *governanceReadViewOperation) capture(root, producer string, args ...string) ([]byte, error) {\n\treturn op.captureFiles(NativeFiles(), root, producer, args...)\n}\n\nfunc (op *governanceReadViewOperation) captureFiles(files Files, root, producer string, args ...string) ([]byte, error) {\n\treturn op.captureFilesBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n}\n\nfunc (s Store) readDelegatedReviewAttempts(bundle string, budgets ...*int64) ([]DelegatedReviewAttempt, error) {\n\tbudget := reviewReadBudget(budgets)\n\trel := filepath.ToSlash(filepath.Join(reviewAttemptDir, reviewAttemptKey(bundle)))\n\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, rel)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tout := []DelegatedReviewAttempt{}\n\tfor _, e := range entries {\n\t\tif IsPublisherStaging(e.Name()) {\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n\t\t\tcontinue\n\t\t}\n\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n\t\t\treturn nil, fmt.Errorf(\"unknown attempt artifact %s\", e.Name())\n\t\t}\n\t\tvar a DelegatedReviewAttempt\n\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, rel, e.Name()), &a, budget); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif a.SchemaVersion != 1 || a.BundleID != bundle || a.Ordinal != len(out)+1 || a.AttemptID != attemptIdentity(a) || e.Name() != fmt.Sprintf(\"%06d.json\", a.Ordinal) {\n\t\t\treturn nil, fmt.Errorf(\"invalid attempt reservation %s\", e.Name())\n\t\t}\n\t\tif _, err := time.Parse(time.RFC3339Nano, a.ReservedAt); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tout = append(out, a)\n\t}\n\t// Orphan receipts are an unknown history, never ignored.\n\tfor _, e := range entries {\n\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n\t\t\tfound := false\n\t\t\tfor _, a := range out {\n\t\t\t\tif filepath.Base(attemptReceiptPath(s.Root, a)) == e.Name() {\n\t\t\t\t\tfound = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !found {\n\t\t\t\treturn nil, fmt.Errorf(\"attempt receipt has no reservation: %s\", e.Name())\n\t\t\t}\n\t\t}\n\t}\n\treturn out, nil\n}\nfunc (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (reviewAttemptReceipt, error) {\n\tbudget := reviewReadBudget(budgets)\n\tvar r reviewAttemptReceipt\n\tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly: %w\", a.AttemptID, 