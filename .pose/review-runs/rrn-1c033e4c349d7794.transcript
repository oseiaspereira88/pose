{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1660,1760p' pose-mcp/internal/cli/validate.go; cat pose-mcp/internal/pose/material_binding.go | head -145; sed -n '1100,1328p' pose-mcp/internal/cli/validate.go; rg -n 'func startValidation|entry.silent|entry.carried' pose-mcp/internal/cli/validate*.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1660,1760p' pose-mcp/internal/cli/validate.go; cat pose-mcp/internal/pose/material_binding.go | head -145; sed -n '1100,1328p' pose-mcp/internal/cli/validate.go; rg -n 'func startValidation|entry.silent|entry.carried' pose-mcp/internal/cli/validate*.go\"","aggregated_output":"\t\tif trimmed != \"\" && !strings.Contains(trimmed, \"/node_modules/\") {\n\t\t\tfilteredPkgs = append(filteredPkgs, trimmed)\n\t\t}\n\t}\n\n\tif len(filteredPkgs) == 0 {\n\t\treturn args\n\t}\n\n\tvar newArgs []string\n\tfor _, a := range args {\n\t\tif a == \"./...\" || strings.HasSuffix(a, \"/...\") {\n\t\t\tnewArgs = append(newArgs, filteredPkgs...)\n\t\t} else {\n\t\t\tnewArgs = append(newArgs, a)\n\t\t}\n\t}\n\treturn newArgs\n}\n\n// materialWorktreeClean reports whether the working copy equals HEAD in every\n// path outside the administrative classes, untracked files included. A status\n// that cannot be read is not clean.\nfunc materialWorktreeClean(root string) bool {\n\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n\tif err != nil {\n\t\treturn false\n\t}\n\trecords := strings.Split(string(out), \"\\x00\")\n\tvar administrative []string\n\tfor i := 0; i < len(records); i++ {\n\t\trecord := records[i]\n\t\tif len(record) < 4 {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{record[3:]}\n\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n\t\t\t// A rename or copy carries its source as the next record.\n\t\t\tif i+1 < len(records) {\n\t\t\t\ti++\n\t\t\t\tpaths = append(paths, records[i])\n\t\t\t}\n\t\t}\n\t\tfor _, p := range paths {\n\t\t\tif !posemodel.IsAdministrativePath(p) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tadministrative = append(administrative, p)\n\t\t}\n\t}\n\treturn administrativeRecordsAreRegular(root, administrative)\n}\n\n// materialTrackedUnchanged reports whether no tracked file differs from HEAD\n// outside the administrative records. Untracked files are not counted: checks\n// leave build products behind, and those are not the material they ran over.\nfunc materialTrackedUnchanged(root string) bool {\n\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=no\")\n\tif err != nil {\n\t\treturn false\n\t}\n\trecords := strings.Split(string(out), \"\\x00\")\n\tvar administrative []string\n\tfor i := 0; i < len(records); i++ {\n\t\trecord := records[i]\n\t\tif len(record) < 4 {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{record[3:]}\n\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n\t\t\tif i+1 < len(records) {\n\t\t\t\ti++\n\t\t\t\tpaths = append(paths, records[i])\n\t\t\t}\n\t\t}\n\t\tfor _, p := range paths {\n\t\t\tif !posemodel.IsAdministrativePath(p) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tadministrative = append(administrative, p)\n\t\t}\n\t}\n\treturn administrativeRecordsAreRegular(root, administrative)\n}\n\n// administrativeRecordsAreRegular reports whether every changed administrative\n// path is a regular file at HEAD (or new): editing a committed symlink or\n// submodule inside a class is a material change, as in MaterialSetDigest.\nfunc administrativeRecordsAreRegular(root string, paths []string) bool {\n\tif len(paths) == 0 {\n\t\treturn true\n\t}\n\targs := []string{\"ls-tree\", \"-z\", \"HEAD\", \"--\"}\n\tfor _, p := range paths {\n\t\tif strings.ContainsAny(p, \"\\n\\x00\") {\n\t\t\treturn false\n\t\t}\n\t\t// The working copy as well as HEAD: a regular record replaced by a link, or\n\t\t// a new link, is not a record.\n\t\tif info, err := os.Lstat(filepath.Join(root, filepath.FromSlash(p))); err == nil && !info.Mode().IsRegular() {\n\t\t\treturn false\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Validation evidence binds to the material it validated (spec\n// pose-validation-evidence-material-binding, ADR\n// validation-evidence-binds-to-validated-material). A commit whose every\n// changed path is a derived administrative record does not change what the\n// checks exercised, so it does not move the material digest.\n\n// engineVersion is the running engine, registered by the binaries (internal/pose\n// stays importable on its own). It is part of every material digest, so a new\n// engine never inherits evidence the previous one produced.\nvar engineVersion = \"unregistered\"\n\n// SetEngineVersion registers the running engine for material digests.\nfunc SetEngineVersion(v string) { engineVersion = v }\n\n// administrativeDirs is the closed list of derived-record directories. It is\n// owned by the engine; adding a class is a contract change that needs an ADR.\nvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n\n// materialIndexes are files inside an administrative directory that still\n// change what the checks demand.\nvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\n// IsAdministrativePath reports whether p is a derived administrative record.\nfunc IsAdministrativePath(p string) bool {\n\tif p == \"\" || p != path.Clean(p) || strings.HasPrefix(p, \"/\") || strings.HasPrefix(p, \"../\") {\n\t\treturn false\n\t}\n\tif materialIndexes[p] {\n\t\treturn false\n\t}\n\tif !recordExtensions[strings.ToLower(path.Ext(p))] {\n\t\treturn false\n\t}\n\tfor _, dir := range administrativeDirs {\n\t\tif strings.HasPrefix(p, dir) {\n\t\t\treturn true\n\t\t}\n\t}\n\tif rest, ok := strings.CutPrefix(p, \".pose/\"); ok {\n\t\tif i := strings.Index(rest, \"/\"); i > 0 && strings.HasPrefix(rest[:i], \"review-\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// recordExtensions are the data formats a derived record is written in. Code or\n// a script stored in a class is material: that keeps a source file moved or\n// copied into a class from hiding its later edits. A copied data file stays\n// indistinguishable from a record; a check that reads data out of a derived-record\n// directory is outside this contract (ADR validation-evidence-binds-to-validated-material).\nvar recordExtensions = map[string]bool{\".json\": true, \".jsonl\": true, \".ndjson\": true, \".md\": true, \".txt\": true, \".log\": true, \".transcript\": true}\n\n// TreeEntry is one entry of the validated head's tree.\ntype TreeEntry struct{ Mode, Blob string }\n\nfunc regularMode(mode string) bool { return mode == \"100644\" || mode == \"100755\" }\n\n// MaterialInputs are what a material digest is computed from: the paths a change\n// set names (both sides of a rename, and the validation matrix) and the\n// destinations of renames. They are stored with the set so the digest can be\n// recomputed against the current tree without the commits' own records.\ntype MaterialInputs struct {\n\tNames []string `json:\"names\"`\n\tMoved []string `json:\"moved,omitempty\"`\n}\n\n// MaterialInputsOf derives the inputs from per-commit path records. They must\n// be unmerged: folding a create and a later rename into one creation would hide\n// that the file moved into a class.\nfunc MaterialInputsOf(paths []ObservedPath) MaterialInputs {\n\tnames := map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\tmoved := map[string]bool{}\n\tfor _, p := range paths {\n\t\tfor _, name := range []string{p.Path, p.OldPath, p.NewPath} {\n\t\t\tif name != \"\" {\n\t\t\t\tnames[name] = true\n\t\t\t}\n\t\t}\n\t\t// A rename destination is material whatever directory it lands in:\n\t\t// otherwise moving a source file into a class would hide its later edits.\n\t\tif p.OldPath != \"\" && p.NewPath != \"\" {\n\t\t\tmoved[p.NewPath] = true\n\t\t}\n\t}\n\tin := MaterialInputs{}\n\tfor name := range names {\n\t\tin.Names = append(in.Names, name)\n\t}\n\tfor name := range moved {\n\t\tin.Moved = append(in.Moved, name)\n\t}\n\tsort.Strings(in.Names)\n\tsort.Strings(in.Moved)\n\treturn in\n}\n\n// MaterialSetDigest digests the head state of the material a change set\n// touched: every path it names (both sides of a rename) with its mode and blob\n// at the validated head, minus the paths that are administrative records and\n// still regular files there, plus the validation matrix. A symlink, submodule\n// or directory in an administrative class is material; so is a path that left\n// a class. tree maps each named path (and the matrix) to its entry; a path\n// absent from the head tree is \"absent\".\nfunc MaterialSetDigest(in MaterialInputs, tree map[string]TreeEntry) string {\n\tmoved := map[string]bool{}\n\tfor _, name := range in.Moved {\n\t\tmoved[name] = true\n\t}\n\tsorted := in.Names\n\th := sha256.New()\n\tfor _, name := range sorted {\n\t\tentry, present := tree[name]\n\t\tif IsAdministrativePath(name) && !moved[name] && (!present || regularMode(entry.Mode)) {\n\t\t\tcontinue\n\t\t}\n\t\tif !present {\n\t\t\th.Write([]byte(name + \"\\x00absent\\n\"))\n\t\t\tcontinue\n\t\t}\n\t\th.Write([]byte(name + \"\\x00\" + entry.Mode + \"\\x00\" + entry.Blob + \"\\n\"))\n\t}\n\treturn \"sha256:\" + hex.EncodeToString(h.Sum(nil))\n}\n\n// MaterialDigestUnreadable marks a change set whose head tree could not be read\n// or whose checkout is not complete. It never binds evidence and never lets\n// evidence recorded without it pass as current.\nconst MaterialDigestUnreadable = \"unreadable\"\n\n// MaterialBindingUnavailable is recorded for a scope whose material cannot be\n// established, so the result is stale for it instead of falling back to the\n// commit-bound rules.\n\t\t}\n\t\tabs := filepath.Join(root, filepath.FromSlash(clean))\n\t\tif info, err := os.Stat(abs); err == nil && info.IsDir() {\n\t\t\tstack := override.Stack\n\t\t\tif stack == \"\" {\n\t\t\t\tstack = \"contract\"\n\t\t\t}\n\t\t\tmodules = append(modules, validationModule{Rel: clean, Abs: abs, Stack: stack})\n\t\t\tknownModules[clean] = true\n\t\t}\n\t}\n\tsort.Slice(modules, func(i, j int) bool { return modules[i].Rel < modules[j].Rel })\n\tvar scope *scopeSelection\n\tif changedTo != \"\" && changedFrom == \"\" {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --changed-to requires --changed-from.\", \"Erro: --changed-to exige --changed-from.\"))\n\t\treturn 2\n\t}\n\tif changedFrom != \"\" {\n\t\tsel, err := computeChangedScope(root, changedFrom, changedTo, modules)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: changed-scope selection: %v\\n\", \"Erro: seleção por escopo alterado: %v\\n\"), err)\n\t\t\treturn 2\n\t\t}\n\t\tscope = &sel\n\t\tif explain {\n\t\t\tfmt.Fprintf(stdout, \"[changed-scope] %s: %d changed file(s), %d/%d module(s) selected\\n\", sel.rangeLabel(), len(sel.Changed), len(sel.Selected), len(modules))\n\t\t\tfor _, m := range modules {\n\t\t\t\tif reason, ok := sel.Selected[m.Rel]; ok {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  + %s: %s\\n\", m.Rel, reason)\n\t\t\t\t} else {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  - %s: not affected by %s\\n\", m.Rel, sel.rangeLabel())\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\trun := validationRunResult{\n\t\tSchemaVersion: validationResultSchema,\n\t\tGeneratedAt:   time.Now().UTC().Format(time.RFC3339),\n\t\tMode:          mode,\n\t\tStackFilter:   stackFilter,\n\t\tModuleFilter:  moduleFilter,\n\t\tChecks:        []checkResult{},\n\t}\n\tmatrixDigest := sha256.Sum256(raw)\n\trun.MatrixSHA256 = \"sha256:\" + hex.EncodeToString(matrixDigest[:])\n\trun.EngineVersion = validationEngineIdentity()\n\tstartedClean := materialWorktreeClean(root)\n\tvar carryState carryPlan\n\tif carry {\n\t\tcarryState = planCarry(root, canonicalResultsPath, mode, run.MatrixSHA256, matrix, modules)\n\t\trun.Carry = carryState.record\n\t\tout := render(stdout, stderr)\n\t\tif !carryState.record.Used {\n\t\t\tout.ContractLine(\"[carry] full run: \" + carryState.record.Reason)\n\t\t} else {\n\t\t\tout.ContractLine(fmt.Sprintf(\"[carry] base %s: %d changed file(s), %d/%d module(s) run\", carryState.record.BaseHead, carryState.record.Changed, len(carryState.record.Selected), len(modules)))\n\t\t\tif explain {\n\t\t\t\tfor _, m := range modules {\n\t\t\t\t\tif reason, ok := carryState.record.Selected[m.Rel]; ok {\n\t\t\t\t\t\tout.ContractLine(\"  + \" + m.Rel + \": \" + reason)\n\t\t\t\t\t} else {\n\t\t\t\t\t\tout.ContractLine(\"  = \" + m.Rel + \": carried from \" + carryState.record.BaseHead)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n\t\trun.GitHead = strings.TrimSpace(string(head))\n\t}\n\tif graph, err := buildCurrentDeliveryGraph(root); err == nil {\n\t\trun.ProvenanceDigest = graph.ProvenanceDigest\n\t\trun.ScopeProvenance = map[string]string{}\n\t\tseenSpecs := map[string]bool{}\n\t\tfor _, set := range graph.ChangeSets {\n\t\t\tif set.Spec != \"\" {\n\t\t\t\tseenSpecs[set.Spec] = true\n\t\t\t}\n\t\t}\n\t\t// The binding names the committed tree. Checks run on the working copy, so a\n\t\t// working copy that differs from it in any material path validated something\n\t\t// else: the run then records the binding as unavailable.\n\t\tclean := materialWorktreeClean(root)\n\t\tfor spec := range seenSpecs {\n\t\t\trun.ScopeProvenance[spec] = posemodel.ScopedDeliveryProvenanceDigest(graph, spec)\n\t\t\tif !clean {\n\t\t\t\tif run.MaterialProvenance == nil {\n\t\t\t\t\trun.MaterialProvenance = map[string]string{}\n\t\t\t\t}\n\t\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n\t\t\t} else if material, ok := posemodel.MaterialBinding(graph, spec); ok {\n\t\t\t\tif run.MaterialProvenance == nil {\n\t\t\t\t\trun.MaterialProvenance = map[string]string{}\n\t\t\t\t}\n\t\t\t\trun.MaterialProvenance[spec] = material\n\t\t\t}\n\t\t}\n\t}\n\tfailures := 0\n\toptionalFailures := 0\n\texecuted := 0\n\tr := render(stdout, stderr)\n\tr.SetVerbose(verbose)\n\t// The counter needs the whole plan up front, so the checks a module runs are\n\t// resolved by one helper called twice: counting here, executing below. A\n\t// second copy of the filter logic would drift from this one.\n\tplanned := 0\n\tfor _, module := range modules {\n\t\t_, checks, selected := moduleValidationChecks(module, matrix, stackFilter, moduleFilter)\n\t\tif !selected {\n\t\t\tcontinue\n\t\t}\n\t\tif scope != nil {\n\t\t\tif _, inScope := scope.Selected[module.Rel]; !inScope {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif carryState.carried(module.Rel) {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, check := range checks {\n\t\t\tif check.Program != \"\" {\n\t\t\t\tplanned++\n\t\t\t}\n\t\t}\n\t}\n\tsteps := r.Steps(planned)\n\tvar entries []*validationEntry\n\tfor _, module := range modules {\n\t\toverride := matrix.ModuleOverrides[module.Rel]\n\t\tstack := module.Stack\n\t\tif override.Stack != \"\" {\n\t\t\tstack = override.Stack\n\t\t}\n\t\tif stackFilter != \"\" && stack != stackFilter || moduleFilter != \"\" && module.Rel != moduleFilter {\n\t\t\tcontinue\n\t\t}\n\t\tchecks := append([]validationCheck(nil), matrix.Stacks[stack].Checks...)\n\t\tif override.ReplaceDefaultChecks {\n\t\t\tchecks = nil\n\t\t}\n\t\tchecks = append(checks, override.Checks...)\n\t\tif scope != nil {\n\t\t\tif _, selected := scope.Selected[module.Rel]; !selected {\n\t\t\t\t// R3: every unselected check keeps a machine-readable reason.\n\t\t\t\treason := \"changed-scope: module not affected by \" + scope.rangeLabel()\n\t\t\t\tfor _, check := range checks {\n\t\t\t\t\tif check.Program == \"\" {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tseverity := check.Severity\n\t\t\t\t\tif severity == \"\" {\n\t\t\t\t\t\tseverity = \"required\"\n\t\t\t\t\t}\n\t\t\t\t\tentries = append(entries, &validationEntry{check: check, severity: severity, skip: reason, silent: true, result: checkResult{\n\t\t\t\t\t\tID: module.Rel + \"/\" + stack + \"/\" + check.Name, Module: module.Rel,\n\t\t\t\t\t\tStack: stack, Name: check.Name, Program: check.Program,\n\t\t\t\t\t\tArgs: check.Args, Env: redactedEnv(check.Env), Severity: severity, EvidenceClass: check.EvidenceClass,\n\t\t\t\t\t}})\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif carryState.carried(module.Rel) {\n\t\t\tfor _, check := range checks {\n\t\t\t\tif check.Program == \"\" {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n\t\t\t\tentries = append(entries, &validationEntry{check: check, silent: true, carried: true, result: carryState.carriedResult(id)})\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tmoduleMode := mode\n\t\tif override.Mode != \"\" {\n\t\t\tmoduleMode = override.Mode\n\t\t}\n\t\tentries = append(entries, &validationEntry{note: fmt.Sprintf(\"[module] %s (%s, mode=%s)\", module.Rel, stack, moduleMode)})\n\t\tfor _, check := range checks {\n\t\t\tif check.Program == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseverity := check.Severity\n\t\t\tif severity == \"\" {\n\t\t\t\tseverity = \"required\"\n\t\t\t}\n\t\t\tentry := &validationEntry{check: check, moduleDir: module.Abs, severity: severity, done: make(chan struct{}), result: checkResult{\n\t\t\t\tID: module.Rel + \"/\" + stack + \"/\" + check.Name, Module: module.Rel,\n\t\t\t\tStack: stack, Name: check.Name, Program: check.Program,\n\t\t\t\tArgs: check.Args, Env: redactedEnv(check.Env), Severity: severity, EvidenceClass: check.EvidenceClass,\n\t\t\t}}\n\t\t\tif check.Isolation == \"required\" {\n\t\t\t\t// The local CLI never weakens its boundary: isolated\n\t\t\t\t// execution is delegated to the Harness via --emit-plan.\n\t\t\t\tentry.skip = \"requires isolated execution (harness) — include via --emit-plan\"\n\t\t\t\tentry.isolated = true\n\t\t\t}\n\t\t\tentries = append(entries, entry)\n\t\t}\n\t}\n\t// Checks run up to jobs at a time; results are shown and counted here,\n\t// in matrix order, whatever order they finish in (spec\n\t// pose-validate-concurrent-steps R1). --verbose streams a check's output,\n\t// so it runs them one at a time.\n\tif jobs == 0 {\n\t\tjobs = defaultValidationJobs(effectiveValidationResources(os.ReadFile, runtime.NumCPU()))\n\t}\n\tif verbose {\n\t\tjobs = 1\n\t}\n\trun.Jobs = jobs\n\trunCtx, stopSignals := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stopSignals()\n\t// The first signal cancels the run; a second one acts as it always did,\n\t// even while the run shuts down (review round 1, B4).\n\tgo func() {\n\t\t<-runCtx.Done()\n\t\tstopSignals()\n\t}()\n\twallStart := time.Now()\n\tif jobs > 1 {\n\t\tgo dispatchValidationEntries(runCtx, entries, jobs, matrix)\n\t}\n\tfor _, entry := range entries {\n\t\tif entry.note != \"\" {\n\t\t\tsteps.Note(entry.note)\n\t\t\tcontinue\n\t\t}\n\t\tif entry.carried {\npose-mcp/internal/cli/validate.go:337:\t\tif entry.note != \"\" || entry.silent || entry.isolated {\npose-mcp/internal/cli/validate.go:1328:\t\tif entry.carried {\npose-mcp/internal/cli/validate.go:1356:\t\tif !entry.silent && !entry.isolated {\npose-mcp/internal/cli/validate.go:1375:\t\t\tif !entry.silent {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,120p' .pose/indexes/validation-matrix.json; cat .pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md; cat pose-mcp/internal/pose/delivery_validation_run_test.go; pose assess design --spec pose-validate-carries-unchanged-checks --json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,120p' .pose/indexes/validation-matrix.json; cat .pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md; cat pose-mcp/internal/pose/delivery_validation_run_test.go; pose assess design --spec pose-validate-carries-unchanged-checks --json\"","aggregated_output":"{\n  \"defaults\": {\n    \"mode\": \"strict\"\n  },\n  \"deliveryProfiles\": {\n    \"cli-surface\": {\n      \"kind\": \"surface\",\n      \"requiredEvidenceClasses\": [\n        \"reachability\"\n      ],\n      \"anyEvidenceClasses\": [\n        \"integration\",\n        \"e2e\"\n      ]\n    },\n    \"composed-capability\": {\n      \"kind\": \"capability\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"api-contract\": {\n      \"kind\": \"contract\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"release-governance\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"backend-go\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"structural-delta\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    }\n  },\n  \"stacks\": {\n    \"node\": {\n      \"checks\": [\n        {\n          \"name\": \"lint\",\n          \"program\": \"npm\",\n          \"args\": [\n            \"run\",\n            \"lint\",\n            \"--if-present\"\n          ],\n          \"severity\": \"optional\",\n          \"evidenceClass\": \"lint\"\n        },\n        {\n          \"name\": \"test\",\n          \"program\": \"npm\",\n          \"args\": [\n            \"test\",\n            \"--if-present\"\n          ],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"unit\"\n        },\n        {\n          \"name\": \"build\",\n          \"program\": \"npm\",\n          \"args\": [\n            \"run\",\n            \"build\",\n            \"--if-present\"\n          ],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"build\"\n        },\n        {\n          \"name\": \"typecheck\",\n          \"program\": \"npm\",\n          \"args\": [\n            \"run\",\n            \"typecheck\",\n            \"--if-present\"\n          ],\n          \"severity\": \"optional\",\n          \"evidenceClass\": \"typecheck\"\n        }\n      ]\n    },\n    \"go\": {\n      \"checks\": [\n        {\n          \"name\": \"build\",\n          \"program\": \"go\",\n          \"args\": [\n            \"build\",\n            \"./...\"\n          ],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"build\"\n        },\n        {\n          \"name\": \"test\",\n          \"program\": \"go\",\n          \"args\": [\n            \"test\",\n            \"./...\"\n          ],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"unit\"\n        },\n        {\n          \"name\": \"vet\",\n          \"program\": \"go\",\n          \"args\": [\n---\ntype: decision-log\nslug: module-metadata-discovery-invalidates-review-provenance\nowner: @pose-maintainers\nsensitivity: public-internal\ncreated_at: 2026-08-16\nlast_reviewed_at: 2026-08-16\nexpires_at: 2026-11-14\nsource_refs:\n  spec: \"pose-upgrade-path-audit-fixes\"\n  workflow: \"bugfix\"\n  commands: [\"pose update --force\", \"pose install\", \"pose index\", \"pose review bundle --seal\"]\n  external_sources: []\n---\n\n# decision-log: module-metadata-discovery-invalidates-review-provenance\n\n## Context\n\nAuditing `pose update`/`pose install` across 7 real repositories ahead of\nthe v1.4.0 release found that running either command on `pose-dist` itself\n(the product's own dogfooding instance) discovered\n`examples/brownfield-kits/direct-adoption/fixture/service/go.mod` — an\nillustrative fixture, not a real deliverable module — as a genuine module\nand added it to `.pose/indexes/module-metadata.json`. That single addition\nrecomputed the global provenance digest (`graph.ProvenanceDigest`, computed\nover the whole delivery-integrity graph, not per-spec — see the\n`pose-gate-closeout-procedure` session note this decision-log\ngeneralizes) and superseded the review attestation of every already-closed\nspec whose scope touches `module-metadata.json`: between 3 and 22 specs\nacross the audit's trial runs, depending on which other specs had most\nrecently closed.\n\n## Current state\n\nFixed the trigger only (spec `pose-upgrade-path-audit-fixes`, R7):\n`testdata`, `fixture` and `fixtures` directories are now excluded from\nmodule discovery in all three independent walkers\n(`discoverValidationModules` in validate.go, `scanModules` in index.go,\nand `internal/pose/discovery.go`'s capability scanner). A genuine,\nintentional module-metadata change — a real module added, removed or\nreclassified — still invalidates every closed spec's review attestation\nthat touches it, exactly as designed today. That broader behavior was\ndeliberately left unchanged (Decision 2 in the spec above): narrowing the\nprovenance digest so it only invalidates reviews whose scope actually\nincludes the changed module is a real design trade-off (what counts as\n\"unrelated,\" whether a narrower digest weakens the guarantee it exists to\nprovide) that deserves its own spec and explicit review, not a side effect\nof fixing a discovery false-positive.\n\n## Next checks\n\n- None deterministic yet. If a future spec pursues narrowing the\n  provenance digest, `pose-mcp/internal/pose/delivery_integrity.go`\n  (`ProvenanceDigest`) and `pose review bundle --seal`'s scope-provenance\n  matching are the two places to start reading.\n\n## Risks\n\n- Any *other* directory-discovery path added in the future (a fourth\n  scanner, or a stack detector that walks the tree independently) needs\n  the same `testdata`/`fixture`/`fixtures` exclusion applied by hand —\n  there is no single shared walker all three call today (each has its own\n  `ignored` map/condition; see the follow-up already on record about this\n  in `pose-review-bundle-roadmap-path-portability`/session knowledge about\n  \"enumerate by hand\" gaps recurring across this repository).\n- Every maintainer who runs `pose update --force`/`pose install` on\n  `pose-dist` itself after a *real* module-metadata change should expect\n  to reseal/reattest every closed spec whose review scope includes\n  `module-metadata.json`, per `pose-gate-closeout-procedure` — this is\n  expected, not a bug, and this decision-log's fix does not change it.\n\n## Next owner\n\n@pose-maintainers — no active handoff; revisit only if the digest-scoping\nfollow-up (spec `pose-upgrade-path-audit-fixes`, Follow-ups) is picked up.\n\n## References\n\n- spec:pose-upgrade-path-audit-fixes (Decision 2, R7, Non-goals)\n- knowledge: session note `pose-gate-closeout-procedure` (this repository's\n  own local agent memory, not a `.pose/knowledge/` artifact) — first\n  documented that the provenance digest is global-over-the-graph, not\n  per-spec, and that reseal/reattest is required after any reindex that\n  changes it.\npackage pose\n\nimport \"testing\"\n\n// A carried check is read as an observation of the head it ran at (spec\n// pose-validate-carries-unchanged-checks R7); an executed one keeps the run's.\nfunc TestDeliveryValidationRunReadsTheCarriedHead(t *testing.T) {\n\traw := []byte(`{\"schema_version\":1,\"generated_at\":\"2026-11-22T10:00:00Z\",\"git_head\":\"bbbb\",\"checks\":[` +\n\t\t`{\"id\":\"a/go/ok\",\"module\":\"a\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\"},` +\n\t\t`{\"id\":\"b/go/ok\",\"module\":\"b\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\",\"carried_from\":\"aaaa\",\"carried_generated_at\":\"2026-11-21T09:00:00Z\"}]}`)\n\tresults, err := ParseDeliveryValidationRun(raw, \".pose/results/delivery-validation.json\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(results) != 2 {\n\t\tt.Fatalf(\"results = %+v\", results)\n\t}\n\tfor _, r := range results {\n\t\tswitch r.ID {\n\t\tcase \"a/go/ok\":\n\t\t\tif r.GitHead != \"bbbb\" || r.GeneratedAt != \"2026-11-22T10:00:00Z\" {\n\t\t\t\tt.Fatalf(\"executed check read as %s at %s\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\tcase \"b/go/ok\":\n\t\t\tif r.GitHead != \"aaaa\" || r.GeneratedAt != \"2026-11-21T09:00:00Z\" {\n\t\t\t\tt.Fatalf(\"carried check read as %s at %s, want the head it ran at\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\t}\n\t}\n}\n{\"schema_version\":1,\"parser_version\":\"pose-design-delta/v2\",\"scope\":\"spec:pose-validate-carries-unchanged-checks\",\"status\":\"observed\",\"input_digest\":\"sha256:b9c442f12ae40005efe421f2b91126a4aa4ae862e97e1c7f4171b8ba64cc1634\",\"cache_key\":\"sha256:b9c442f12ae40005efe421f2b91126a4aa4ae862e97e1c7f4171b8ba64cc1634\",\"subject\":{\"base\":\"dec2e64c1395fafbf8e2a78171e5437c1720bbbf\",\"head\":\"35b4cc7fba4c1eae22a44f5e05ba45ffa179cecb\",\"patch_digest\":\"sha256:a7623e2f35e85aa9262bd1a1216f4c217ec5ed19179fcf19ce1d4c6e2ffbcc98\",\"tree_digest\":\"sha256:037b49e0bcc772470d7d40e5236ca7b70d85c90d5089dfc509d3a01bc3a49266\",\"implementation_digest\":\"sha256:7c3461b394c058a9b13016c495eaba5473f375edca5c20e9528a085e9ec3535f\",\"entries\":13},\"coverage\":{\"files_in_subject\":13,\"files_observed\":13,\"bytes_read\":2083020,\"max_files\":4096,\"max_bytes\":16777216,\"detectors\":[{\"id\":\"dependency-go\",\"state\":\"not-applicable\"},{\"id\":\"dependency-npm\",\"state\":\"not-applicable\"},{\"id\":\"component\",\"state\":\"not-applicable\"},{\"id\":\"delivery-metadata\",\"state\":\"not-applicable\"},{\"id\":\"governance-contract\",\"state\":\"observed\",\"observed\":1},{\"id\":\"public-contract\",\"state\":\"not-applicable\"},{\"id\":\"git-actions\",\"state\":\"observed\",\"observed\":13}]},\"deltas\":[{\"id\":\"sd-a9e60b2a01259dff960bd3bb7c2fcdec\",\"display_id\":\"SD-a9e60b2a\",\"kind\":\"governance-contract\",\"action\":\"added\",\"state\":\"observed\",\"subject\":\".pose/adr/2026-11-22-validate-carries-unchanged-checks.md\",\"path\":\".pose/adr/2026-11-22-validate-carries-unchanged-checks.md\",\"after_digest\":\"sha256:22a8cd63f4b5afb4bdc1b1e743e67eaee7d47c104f332f867187409e893a54bd\"}]}\n","exit_code":0,"status":"completed"}}
