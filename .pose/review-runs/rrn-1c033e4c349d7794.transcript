check.Name\n   126\t\t\t\tif prior, ok := plan.base[id]; !ok || prior.Outcome == \"skipped\" || prior.Outcome == \"\" {\n   127\t\t\t\t\tselection.Selected[module.Rel] = \"carry: no prior result for \" + id\n   128\t\t\t\t\tbreak\n   129\t\t\t\t}\n   130\t\t\t}\n   131\t\t}\n   132\t\tplan.selection, plan.baseHead, plan.baseTime = &selection, base.GitHead, base.GeneratedAt\n   133\t\tplan.record.Used, plan.record.BaseHead, plan.record.Changed, plan.record.Selected = true, base.GitHead, len(selection.Changed), selection.Selected\n   134\t\treturn plan\n   135\t}\n   136\t\n   137\t// carryExclusions are the changed paths that are not changes for the carry\n   138\t// selection (R3): the canonical result itself and the derived administrative\n   139\t// records of the engine's closed list (the same classes material bindings\n   140\t// ignore) that are still regular files, or gone, at HEAD. A symlink,\n   141\t// submodule or directory in a class stays a change.\n   142\tfunc carryExclusions(root, base, resultsPath string) []string {\n   143\t\texclude := []string{resultsPath}\n   144\t\tout, err := posemodel.RawGit(\"-C\", root, \"diff\", \"--name-only\", \"-z\", base, \"HEAD\", \"--\").Output()\n   145\t\tif err != nil {\n   146\t\t\treturn exclude\n   147\t\t}\n   148\t\tfor _, file := range strings.Split(string(out), \"\\x00\") {\n   149\t\t\tfile = filepath.ToSlash(file)\n   150\t\t\tif file == \"\" || !posemodel.IsAdministrativePath(file) {\n   151\t\t\t\tcontinue\n   152\t\t\t}\n   153\t\t\tentry, err := posemodel.RawGit(\"-C\", root, \"ls-tree\", \"-z\", \"HEAD\", \"--\", file).Output()\n   154\t\t\tif err != nil {\n   155\t\t\t\tcontinue\n   156\t\t\t}\n   157\t\t\tfields := strings.Fields(string(entry))\n   158\t\t\tif len(fields) == 0 || fields[0] == \"100644\" || fields[0] == \"100755\" {\n   159\t\t\t\texclude = append(exclude, file)\n   160\t\t\t}\n   161\t\t}\n   162\t\treturn exclude\n   163\t}\n   164\t\n   165\t// validationEngineIdentity names the engine that ran a validation: its version\n   166\t// plus, when the binary records it, the VCS revision it was built from, marked\n   167\t// when the build tree was modified. Development builds share a version string,\n   168\t// so the revision is what tells two of them apart (R2).\n   169\tfunc validationEngineIdentity() string {\n   170\t\tidentity := version.Version\n   171\t\tinfo, ok := debug.ReadBuildInfo()\n   172\t\tif !ok {\n   173\t\t\treturn identity\n   174\t\t}\n   175\t\trevision, modified := \"\", false\n   176\t\tfor _, setting := range info.Settings {\n   177\t\t\tswitch setting.Key {\n   178\t\t\tcase \"vcs.revision\":\n   179\t\t\t\trevision = setting.Value\n   180\t\t\tcase \"vcs.modified\":\n   181\t\t\t\tmodified = setting.Value == \"true\"\n   182\t\t\t}\n   183\t\t}\n   184\t\tif revision != \"\" {\n   185\t\t\tidentity += \"+\" + revision\n   186\t\t\tif modified {\n   187\t\t\t\tidentity += \".dirty\"\n   188\t\t\t}\n   189\t\t}\n   190\t\treturn identity\n   191\t}\npose-mcp/internal/pose/delivery_surface.go:625:\tif bound := result.MaterialProvenance[spec]; bound != \"\" {\npose-mcp/internal/pose/delivery_surface.go:652:\tif result.GitHead == \"\" {\npose-mcp/internal/pose/delivery_surface.go:656:\t\tif result.GitHead == set.Head || result.GitHead == set.ResolvedHead {\npose-mcp/internal/pose/delivery_surface.go:660:\t\t\tif result.GitHead == commit {\npose-mcp/internal/pose/delivery_integrity_compact_test.go:90:\t\tif result.ScopeProvenance[\"spec-03\"] == \"\" || result.GitHead != \"abc123\" || result.Report == \"\" {\npose-mcp/internal/pose/delivery_integrity_compact.go:165:\t\trun := compactValidationRun{GitHead: result.GitHead, GeneratedAt: result.GeneratedAt, ProvenanceDigest: result.ProvenanceDigest, Report: result.Report, ScopeProvenance: result.ScopeProvenance, MaterialProvenance: result.MaterialProvenance}\npose-mcp/internal/pose/delivery_integrity_compact.go:271:\t\t\t\t\texpanded.MaterialProvenance[spec] = digest\npose-mcp/i