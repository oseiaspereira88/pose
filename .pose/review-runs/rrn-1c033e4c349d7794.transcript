1\t\t\tfor _, path := range exclude {\n   102\t\t\t\texcluded[filepath.ToSlash(filepath.Clean(path))] = true\n   103\t\t\t}\n   104\t\t\tkept := sel.Changed[:0]\n   105\t\t\tfor _, file := range sel.Changed {\n   106\t\t\t\tif !excluded[file] {\n   107\t\t\t\t\tkept = append(kept, file)\n   108\t\t\t\t}\n   109\t\t\t}\n   110\t\t\tsel.Changed = kept\n   111\t\t}\n   112\t\tsort.Strings(sel.Changed)\n   113\t\n   114\t\tmeta := loadScopeMetadata(root)\n   115\t\tmoduleOf := func(file string) string {\n   116\t\t\tmatch := \"\"\n   117\t\t\tfor _, m := range modules {\n   118\t\t\t\tif file == m.Rel || strings.HasPrefix(file, m.Rel+\"/\") {\n   119\t\t\t\t\tif len(m.Rel) > len(match) {\n   120\t\t\t\t\t\tmatch = m.Rel\n   121\t\t\t\t\t}\n   122\t\t\t\t}\n   123\t\t\t}\n   124\t\t\treturn match\n   125\t\t}\n   126\t\tfor _, file := range sel.Changed {\n   127\t\t\tif m := moduleOf(file); m != \"\" {\n   128\t\t\t\tif _, ok := sel.Selected[m]; !ok {\n   129\t\t\t\t\tsel.Selected[m] = \"contains changed file: \" + file\n   130\t\t\t\t}\n   131\t\t\t} else {\n   132\t\t\t\t// Root-level or unmapped change: safe execution wins, except for\n   133\t\t\t\t// modules that declare their checks read nothing outside them.\n   134\t\t\t\tfor _, m := range modules {\n   135\t\t\t\t\tif meta.Modules[m.Rel].SelfContained {\n   136\t\t\t\t\t\tcontinue\n   137\t\t\t\t\t}\n   138\t\t\t\t\tif _, ok := sel.Selected[m.Rel]; !ok {\n   139\t\t\t\t\t\tsel.Selected[m.Rel] = \"root-level change outside any module: \" + file\n   140\t\t\t\t\t}\n   141\t\t\t\t}\n   142\t\t\t}\n   143\t\t}\n   144\t\t// Policy widening: high-criticality modules always run.\n   145\t\tfor _, m := range modules {\n   146\t\t\tif meta.Modules[m.Rel].Criticality == \"high\" {\n   147\t\t\t\tif _, ok := sel.Selected[m.Rel]; !ok {\n   148\t\t\t\t\tsel.Selected[m.Rel] = \"policy: criticality high always runs\"\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\t// Transitive dependents of selected modules (declared