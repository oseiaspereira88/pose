mt.Errorf(\"pose_list_specs: %s must not be null; omit it instead\", key)\n\t\t\t}\n\t\t}\n\t\tif _, given := present[\"sort\"]; given && a.Sort != \"date\" && a.Sort != \"slug\" {\n\t\t\treturn nil, fmt.Errorf(\"pose_list_specs: sort must be \\\"date\\\" or \\\"slug\\\"\")\n\t\t}\n\t\tvar sinceDate time.Time\n\t\tif a.Since != nil {\n\t\t\tparsed, parseErr := pose.ParseSinceDate(*a.Since)\n\t\t\tif parseErr != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"pose_list_specs: %w\", parseErr)\n\t\t\t}\n\t\t\tsinceDate = parsed\n\t\t}\n\t\trecent, limit := 0, 0\n\t\tif a.Recent != nil {\n\t\t\tif *a.Recent <= 0 {\n\t\t\t\treturn nil, fmt.Errorf(\"pose_list_specs: recent must be a positive number\")\n\t\t\t}\n\t\t\trecent = *a.Recent\n\t\t}\n\t\tif a.Limit != nil {\n\t\t\tif *a.Limit <= 0 {\n\t\t\t\treturn nil, fmt.Errorf(\"pose_list_specs: limit must be a positive number\")\n\t\t\t}\n\t\t\tlimit = *a.Limit\n\t\t}\n\t\tgenBefore := s.pageGeneration(store)\n\t\tspecs, err := store.ListSpecs(a.Status, a.Components)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif a.Since != nil {\n\t\t\tfiltered := []pose.Spec{}\n\t\t\tfor _, sp := range specs {\n\t\t\t\tdateStr := sp.CreatedAt\n\t\t\t\tif dateStr == \"\" {\n\t\t\t\t\tdateStr = sp.CompletedAt\n\t\t\t\t}\n\t\t\t\tif dateStr != \"\" {\n\t\t\t\t\tif t, err := time.Parse(\"2006-01-02\", dateStr); err == nil && !t.Before(sinceDate) {\n\t\t\t\t\t\tfiltered = append(filtered, sp)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tspecs = filtered\n\t\t}\n\t\tif a.Sort == \"slug\" && recent == 0 {\n\t\t\tsort.Slice(specs, func(i, j int) bool { return specs[i].Slug < specs[j].Slug })\n\t\t}\n\t\tif a.Sort == \"date\" || recent > 0 {\n\t\t\tsort.Slice(specs, func(i, j int) bool {\n\t\t\t\tif specs[i].CreatedAt != specs[j].CreatedAt {\n\t\t\t\t\treturn specs[i].CreatedAt > specs[j].CreatedAt\n\t\t\t\t}\n\t\t\t\treturn specs[i].Slug < specs[j].Slug\n\t\t\t})\n\t\t}\n\t\tif recent > 0 && recent < len(specs) {\n\t\t\tspecs = specs[:recent]\n\t\t}\n\t\tsinceFilter := \"\"\n\t\tif !sinceDate.IsZero() {\n\t\t\tsinceFilter = sinceDate.Format(\"2006-01-02\")\n\t\t}\n\t\t// The listing is in slug order unless a date order is asked for, so an omitted\n\t\t// sort and an explicit \"slug\" are the same query.\n\t\teffectiveSort := a.Sort\n\t\tif effectiveSort == \"\" {\n\t\t\teffectiveSort = \"slug\"\n\t\t}\n\t\tif recent > 0 {\n\t\t\teffectiveSort = \"date\"\n\t\t}\n\t\t// An unambiguous encoding of the normalized tuple: a delimiter inside a value\n\t\t// must not make two different queries read the same.\n\t\tencoded, _ := json.Marshal([]any{canonicalList(a.Status), canonicalList(a.Components), effectiveSort, recent, sinceFilter})\n\t\tfilters := string(encoded)\n\t\tpage, next, meta, err := pageList(s, store, \"pose_list_specs\", filters, genBefore, specs, contentKeys(specs), a.Cursor, limit)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tresult := map[string]any{\"specs\": page, \"count\": len(page), \"total\": len(specs), \"next_cursor\": next, \"page\": meta}\n\t\tif notice := listNotice(len(specs), `narrow with \"status\" (comma-separated, e.g. \"draft,in-progress\"), \"components\" (comma-separated, matches any tag), or page with \"limit\"/\"cursor\"`); notice != \"\" {\n\t\t\tresult[\"notice\"] = notice\n\t\t}\n\t\treturn result, nil\n\tcase \"pose_spec_readiness\":\n\t\tvar a struct {\n\t\t\tSlug   string `json:\"slug\"`\n\t\t\tPhases bool   `json:\"phases\"`\n\t\t}\n\t\tif err := json.Unmarshal(args, &a); err != nil || a.Slug == \"\" {\n\t\t\treturn nil, fmt.Errorf(\"pose_spec_readiness: required argument %q missing\", \"slug\")\n\t\t}\n\t\tresolver := pose.ArtifactResolver{Roots: s.roots, Authorize: func(projectID string) bool {\n\t\t\tcandidate := policyInputFromContext(ctx)\n","exit_code":0,"status":"completed"}}
