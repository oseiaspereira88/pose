r():\n\t\t\tslug := specFilenameSlug(e.Name())\n\t\t\tdir := filepath.Join(s.specsDir(), e.Name())\n\t\t\tpath := filepath.Join(dir, \"spec.md\")\n\t\t\tif _, statErr := s.fsys().Stat(path); statErr == nil {\n","exit_code":0,"status":"completed"}}
