{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '640,750p' pose-mcp/internal/cli/artifact_integrity.go\"","aggregated_output":"}\n\nfunc cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar spec, from, to string\n\tstrict, jsonOutput := true, false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--spec\", \"--from\", \"--to\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t\t}\n\t\t\ti++\n\t\t\tswitch args[i-1] {\n\t\t\tcase \"--spec\":\n\t\t\t\tspec = args[i]\n\t\t\tcase \"--from\":\n\t\t\t\tfrom = args[i]\n\t\t\tcase \"--to\":\n\t\t\t\tto = args[i]\n\t\t\t}\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t}\n\t}\n\tstore := posemodel.Store{Root: root}\n\tfull, err := store.GetSpec(spec)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tpolicy, err := posemodel.LoadArtifactPolicy(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tclaims, found, err := posemodel.ParseArtifactClaims(*full, policy)\n\tif err != nil || !found || len(claims) == 0 {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: spec %s has no valid artifact declaration: %v\\n\", spec, err)\n\t\treturn 1\n\t}\n\tvar sets []posemodel.ChangeSet\n\tif from != \"\" || to != \"\" {\n\t\tset, err := resolveGitChangeSet(root, spec, from, to)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tsets = append(sets, set)\n\t} else {\n\t\tfor _, recorded := range loadRecordedChangeSets(root) {\n\t\t\tif recorded.Spec == spec {\n\t\t\t\tsets = append(sets, recorded)\n\t\t\t}\n\t\t}\n\t\tif set, err := resolveGitChangeSet(root, spec, \"\", \"\"); err == nil {\n\t\t\talreadyPresent := false\n\t\t\tfor _, existing := range sets {\n\t\t\t\tif existing.ID == set.ID {\n\t\t\t\t\talreadyPresent = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !alreadyPresent {\n\t\t\t\tsets = append(sets, set)\n\t\t\t}\n\t\t}\n\t\tif len(sets) == 0 {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: no commits carry POSE-Spec: %s\\n\", spec)\n\t\t\treturn 1\n\t\t}\n\t}\n\tset := sets[0]\n\ttracked, err := gitTrackedPaths(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\t// A later removal by another spec is read from every spec's claims and\n\t// change sets (spec pose-delivery-later-removal R4).\n\tvar removals []posemodel.ArtifactRemoval\n\tif _, allClaims, allSets, _, _, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root); err == nil {\n\t\tremovals = artifactRemovals(root, allClaims, allSets, tracked, gaps, sets...)\n\t}\n\tgraph := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), []posemodel.Spec{*full}, claims, sets, tracked, policy, posemodel.LoadArchivedFragments(root), removals)\n\tfor _, claim := range claims {\n\t\tif claim.Action == \"none\" {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{claim.Path}\n\t\tif claim.Action == \"renamed\" {\n\t\t\tpaths = []string{claim.OldPath, claim.NewPath}\n\t\t}\n\t\tfor _, path := range paths {\n\t\t\tif err := posemodel.ValidateArtifactPath(root, path, false); err != nil {\n\t\t\t\tseverity := policy.Severities[\"resolvability\"]\n\t\t\t\tif severity == \"\" {\n\t\t\t\t\tseverity = \"warning\"\n\t\t\t\t}\n\t\t\t\tgraph.Findings = append(graph.Findings, posemodel.NewDeliveryIntegrityFinding(\"resolvability\", severity, spec, path, set.ID, err.Error(), \"declare an exact confined tracked file path\"))\n\t\t\t}\n\t\t}\n\t}\n\tsort.Slice(graph.Findings, func(i, j int) bool { return graph.Findings[i].ID < graph.Findings[j].ID })\n\tif jsonOutput {\n\t\t_ = writeJSON(stdout, graph)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,125p' pose-mcp/internal/cli/review_closeout.go\"","aggregated_output":"package cli\n\nimport (\n\t\"bytes\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/url\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nfunc cliGovernedStore(root string) posemodel.Store {\n\tstore := posemodel.Store{Root: root}\n\tresolver, project, err := posemodel.EnvironmentArtifactResolver(root, \"\")\n\tif err != nil {\n\t\tstore.FederatedResolver = &posemodel.ArtifactResolver{}\n\t\treturn store\n\t}\n\tstore.FederatedProjectID = project\n\tstore.FederatedResolver = &resolver\n\treturn store\n}\n\n// cliReviewStore keeps the authority resolver selected from the caller's root.\n// Reconstructing it at a foreign root would apply the caller's default project\n// identity to that root and lose the authorized federation context.\nfunc cliReviewStore(root, ref string) (posemodel.Store, string, error) {\n\tcontext, resolver, _, err := cliAgentContext(root, ref)\n\tqualified := strings.HasPrefix(ref, \"xref:\")\n\tif err != nil {\n\t\tif qualified {\n\t\t\treturn posemodel.Store{}, \"\", err\n\t\t}\n\t\treturn cliGovernedStore(root), ref, nil\n\t}\n\tif context.TaskResolution != nil && context.TaskResolution.State == \"transfer-in-progress\" {\n\t\treturn posemodel.Store{}, \"\", fmt.Errorf(\"transfer-in-progress\")\n\t}\n\tif context.TaskResolution == nil || !context.TaskResolution.Resolved || context.Authority == nil {\n\t\tif qualified {\n\t\t\tstate := \"unknown-artifact\"\n\t\t\tif context.TaskResolution != nil {\n\t\t\t\tstate = context.TaskResolution.State\n\t\t\t}\n\t\t\treturn posemodel.Store{}, \"\", fmt.Errorf(\"task-authority-unavailable: %s\", state)\n\t\t}\n\t\treturn cliGovernedStore(root), ref, nil\n\t}\n\tif !qualified && !context.TaskResolution.Redirected {\n\t\treturn cliGovernedStore(root), ref, nil\n\t}\n\tstore, err := resolver.Roots.StoreFor(context.Authority.Project)\n\tif err != nil {\n\t\treturn posemodel.Store{}, \"\", fmt.Errorf(\"task-authority-unavailable\")\n\t}\n\tstore.FederatedProjectID, store.FederatedResolver = context.Authority.Project, &resolver\n\treturn store, scopeRefForArtifact(*context.Authority), nil\n}\n\nfunc cmdReviewCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tref, jsonOutput, ok := parseScopeCheckArgs(\"review-check\", args, stderr)\n\tif !ok {\n\t\treturn 2\n\t}\n\tstore, localRef, err := cliReviewStore(root, ref)\n\tif err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose review-check: \" + err.Error())\n\t\treturn 1\n\t}\n\troot, ref = store.Root, localRef\n\teval, err := store.ReviewCheck(ref)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif jsonOutput {\n\t\tif code := writeJSON(stdout, eval); code != 0 {\n\t\t\treturn code\n\t\t}\n\t\tif eval.Required && !eval.Approved {\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\t}\n\tfmt.Fprintf(stdout, \"review.scope=%s\\nreview.required=%t\\nreview.profile=%s\\nreview.digest=%s\\nreview.fresh=%t\\nreview.approved=%t\\n\", eval.Scope, eval.Required, eval.Profile, eval.ScopeDigest, eval.Fresh, eval.Approved)\n\tif eval.ReadView != nil {\n\t\trender(stdout, stderr).Field(\"review.read_view\", fmt.Sprintf(\"id:%s freshness:%s roots:%d inputs:%d bytes:%d\",\n\t\t\teval.ReadView.ID, eval.ReadView.Freshness, len(eval.ReadView.Bindings), eval.ReadView.ObservedInputs, eval.ReadView.InputBytes))\n\t}\n\tif eval.Assurance != nil {\n\t\trender(stdout, stderr).Field(\"review.assurance\", posemodel.RenderReviewAssurance(*eval.Assurance))\n\t}\n\tfor _, warning := range eval.Warnings {\n\t\tfmt.Fprintf(stdout, \"[WARN] %s\\n\", warning)\n\t}\n\tfor _, blocker := range eval.Blockers {\n\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n\t}\n\tif eval.Required && !eval.Approved {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc cmdReviewPlan(root string, args []string, stdout, stderr io.Writer) int {\n\tref, jsonOutput, explain := \"\", false, false\n\tfor _, arg := range args {\n\t\tswitch arg {\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tcase \"--explain\":\n\t\t\texplain = true\n\t\tdefault:\n\t\t\tif strings.HasPrefix(arg, \"-\") || ref != \"\" {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/mcpserver/generation_cursor_test.go'","aggregated_output":"package mcpserver\n\n// Generation-bound query cursors over MCP (spec pose-generation-bound-query-cursors).\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nfunc cursorServer(t *testing.T, n int) (*httptest.Server, string) {\n\tt.Helper()\n\troot := t.TempDir()\n\tfor i := 0; i < n; i++ {\n\t\twriteCursorSpec(t, root, fmt.Sprintf(\"spec-%02d\", i))\n\t}\n\tts := httptest.NewServer(New(pose.Store{Root: root}).Handler(\"\", \"\"))\n\tt.Cleanup(ts.Close)\n\treturn ts, root\n}\n\nfunc writeCursorSpec(t *testing.T, root, slug string) {\n\tt.Helper()\n\tpath := filepath.Join(root, \".pose\", \"specs\", slug, \"spec.md\")\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbody := fmt.Sprintf(\"---\\nslug: %s\\nstatus: draft\\ncreated_at: 2026-06-01\\n---\\n\\n# Spec: %s\\n\", slug, slug)\n\tif err := os.WriteFile(path, []byte(body), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\n// call returns the structured result and whether the tool reported an error and its text.\nfunc cursorCall(t *testing.T, ts *httptest.Server, tool string, args map[string]any) (map[string]any, bool, string) {\n\tt.Helper()\n\traw, _ := json.Marshal(args)\n\t_, out := post(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":%q,\"arguments\":%s}}`, tool, raw))\n\tisErr, _ := out.Result[\"isError\"].(bool)\n\tstructured, _ := out.Result[\"structuredContent\"].(map[string]any)\n\ttext := \"\"\n\tif content, ok := out.Result[\"content\"].([]any); ok && len(content) > 0 {\n\t\tif m, ok := content[0].(map[string]any); ok {\n\t\t\ttext, _ = m[\"text\"].(string)\n\t\t}\n\t}\n\treturn structured, isErr, text\n}\n\nfunc TestEveryPageDisclosesItsGenerationAndCollection(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tresult, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tif isErr {\n\t\tt.Fatal(\"first page failed\")\n\t}\n\tpage, _ := result[\"page\"].(map[string]any)\n\tif page[\"collection\"] == \"\" || page[\"collection\"] == nil || page[\"disclosure\"] == nil || page[\"total\"] != float64(7) {\n\t\tt.Fatalf(\"the page does not disclose what it was read from: %+v\", page)\n\t}\n\tif result[\"next_cursor\"] == \"\" {\n\t\tt.Fatal(\"no cursor for a collection larger than the page\")\n\t}\n}\n\nfunc TestACursorIsRefusedAfterTheCollectionChangesBetweenPages(t *testing.T) {\n\tts, root := cursorServer(t, 7)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\n\t// An unchanged collection continues.\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor}); isErr {\n\t\tt.Fatalf(\"an unchanged collection must continue: %s\", text)\n\t}\n\t// A new spec arrives: the cursor is stale, not continued over the changed collection.\n\twriteCursorSpec(t, root, \"spec-new\")\n\t_, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor})\n\tif !isErr || !strings.Contains(text, pose.CursorStale) || !strings.Contains(text, \"restart\") {\n\t\tt.Fatalf(\"a changed collection was continued or the refusal is not actionable: err=%v %q\", isErr, text)\n\t}\n\t// Restarting from the first page works and sees the new spec.\n\tagain, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tif isErr || again[\"total\"] != float64(8) {\n\t\tt.Fatalf(\"restart did not see the changed collection: %+v\", again)\n\t}\n}\n\nfunc TestACursorStaysWithItsToolAndFilters(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_roadmaps\", map[string]any{\"limit\": 3, \"cursor\": cursor}); !isErr || !strings.Contains(text, pose.CursorBinding) {\n\t\tt.Fatalf(\"a cursor crossed to another tool: %v %q\", isErr, text)\n\t}\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor, \"status\": \"done\"}); !isErr || !strings.Contains(text, pose.CursorBinding) {\n\t\tt.Fatalf(\"a cursor survived a changed filter: %v %q\", isErr, text)\n\t}\n}\n\nfunc TestACursorDoesNotSurviveAnotherServerProcess(t *testing.T) {\n\tts, root := cursorServer(t, 7)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tother := httptest.NewServer(New(pose.Store{Root: root}).Handler(\"\", \"\"))\n\tt.Cleanup(other.Close)\n\t_, isErr, text := cursorCall(t, other, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor})\n\tif !isErr || !strings.Contains(text, pose.CursorSignature) {\n\t\tt.Fatalf(\"a cursor crossed a process boundary: %v %q\", isErr, text)\n\t}\n}\n\nfunc TestAHostileCursorIsRefusedOverMCP(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tfor _, token := range []string{\"AAAA\", \"eyJ2IjoxLCJhZnRlciI6M30\", strings.Repeat(\"x\", pose.GenerationCursorMaxBytes+1)} {\n\t\tif _, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"cursor\": token}); !isErr {\n\t\t\tt.Errorf(\"hostile cursor %.12q was accepted\", token)\n\t\t}\n\t}\n}\n\nfunc TestPageLimitIsBoundedAndDisclosed(t *testing.T) {\n\tts, _ := cursorServer(t, 3)\n\tresult, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 100000})\n\tpage, _ := result[\"page\"].(map[string]any)\n\tif isErr || page[\"limit_applied\"] != float64(pose.GenerationPageMax) {\n\t\tt.Fatalf(\"an oversized limit was not bounded and disclosed: %v %+v\", isErr, page)\n\t}\n}\n\nfunc TestACursorIsRefusedWhenAReturnedFieldChanges(t *testing.T) {\n\tts, root := cursorServer(t, 7)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\t// A field the listing returns changes while the slug, status and date do not.\n\tpath := filepath.Join(root, \".pose\", \"specs\", \"spec-05\", \"spec.md\")\n\tbody := \"---\\nslug: spec-05\\nstatus: draft\\ncreated_at: 2026-06-01\\npriority: 3\\n---\\n\\n# Spec: spec-05\\n\"\n\tif err := os.WriteFile(path, []byte(body), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor})\n\tif !isErr || !strings.Contains(text, pose.CursorStale) {\n\t\tt.Fatalf(\"a cursor continued over changed results: %v %q\", isErr, text)\n\t}\n}\n\nfunc TestEquivalentFiltersShareACursor(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tfirst, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"status\": \"Draft, draft\"})\n\tif isErr {\n\t\tt.Fatal(text)\n\t}\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor, \"status\": \"draft\"}); isErr {\n\t\tt.Fatalf(\"equivalent filters were treated as another query: %s\", text)\n\t}\n}\n\nfunc TestAPageStatesItsCostAndGenerationStatus(t *testing.T) {\n\tts, _ := cursorServer(t, 3)\n\tresult, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2})\n\tpage, _ := result[\"page\"].(map[string]any)\n\tif isErr || page[\"cost\"] == nil || !strings.Contains(page[\"cost\"].(string), \"full-scan\") || page[\"generation_status\"] == nil {\n\t\tt.Fatalf(\"a page must state its cost and the status of its generation: %v %+v\", isErr, page)\n\t}\n}\n\nfunc TestAContinuationWithoutALimitIsBoundedOverMCP(t *testing.T) {\n\tts, _ := cursorServer(t, pose.GenerationPageMax+25)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 1})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tsecond, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"cursor\": cursor})\n\tif isErr {\n\t\tt.Fatal(text)\n\t}\n\tif got := second[\"count\"]; got != float64(pose.GenerationPageMax) {\n\t\tt.Fatalf(\"a continuation without limit returned %v items, want %d\", got, pose.GenerationPageMax)\n\t}\n}\n\nfunc TestAnExplicitNonPositiveLimitIsRefusedOnEveryPaginatedTool(t *testing.T) {\n\tts, _ := cursorServer(t, 3)\n\tfor _, tool := range []string{\"pose_list_specs\", \"pose_list_roadmaps\", \"pose_list_knowledge\", \"pose_list_reports\", \"pose_capability_history\"} {\n\t\tfor _, limit := range []any{0, -1, nil} {\n\t\t\tif _, isErr, _ := cursorCall(t, ts, tool, map[string]any{\"limit\": limit}); !isErr {\n\t\t\t\tt.Errorf(\"%s accepted limit %v\", tool, limit)\n\t\t\t}\n\t\t}\n\t}\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_roadmaps\", map[string]any{}); isErr {\n\t\tt.Fatalf(\"omitting the limit is the legacy call and must work: %s\", text)\n\t}\n}\n\nfunc TestAPageCarriesTheIndexReadersStatusReasonAndDivergedFiles(t *testing.T) {\n\tts, root := cursorServer(t, 3)\n\toutputs := map[string][]byte{}\n\tfor _, name := range pose.IndexGenerationFiles {\n\t\toutputs[name] = []byte(\"[]\\n\")\n\t}\n\tif _, err := (pose.Store{Root: root}).PublishIndexGeneration(outputs, map[string]string{\"specs\": \"sha256:a\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresult, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2})\n\tpage, _ := result[\"page\"].(map[string]any)\n\tif isErr || page[\"generation_status\"] != \"current\" || page[\"generation\"] == \"\" || page[\"generation_diverged\"] != nil {\n\t\tt.Fatalf(\"a whole, untouched generation: %v %+v\", isErr, page)\n\t}\n\t// A legacy file edited by hand beside a whole generation: the generation is still\n\t// current, and the page names the files that diverge from it.\n\tidx := filepath.Join(root, \".pose\", \"indexes\")\n\tif err := os.WriteFile(filepath.Join(idx, \"packages.json\"), []byte(\"{}\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Remove(filepath.Join(idx, \"releases.json\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresult, isErr, _ = cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2})\n\tpage, _ = result[\"page\"].(map[string]any)\n\tdiverged, _ := page[\"generation_diverged\"].([]any)\n\tif isErr || page[\"generation_status\"] != \"current\" || len(diverged) != 2 || diverged[0] != \"packages.json\" || diverged[1] != \"releases.json\" {\n\t\tt.Fatalf(\"the diverged legacy files were not disclosed: %v %+v\", isErr, page)\n\t}\n\t// A broken generation is not reported as current, and its reason is kept.\n\tif err := os.WriteFile(filepath.Join(idx, \"generation.json\"), []byte(\"not json\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresult, _, _ = cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2})\n\tpage, _ = result[\"page\"].(map[string]any)\n\tif page[\"generation_status\"] == \"current\" || page[\"generation_status\"] == nil || page[\"generation_reason\"] == nil {\n\t\tt.Fatalf(\"an unavailable generation lost its status or reason: %+v\", page)\n\t}\n}\n\nfunc TestAnAliasOfLimitOrCursorIsRefused(t *testing.T) {\n\tts, _ := cursorServer(t, 3)\n\tfor _, tool := range []string{\"pose_list_specs\", \"pose_list_roadmaps\", \"pose_list_knowledge\", \"pose_list_reports\", \"pose_capability_history\"} {\n\t\t_, out := post(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":%q,\"arguments\":{\"limit\":1,\"Limit\":0}}}`, tool))\n\t\tif isErr, _ := out.Result[\"isError\"].(bool); !isErr {\n\t\t\tt.Errorf(\"%s accepted a case-variant duplicate of limit\", tool)\n\t\t}\n\t}\n}\n\nfunc TestACursorAliasCannotRestartAWalk(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tfor _, alias := range []string{\"Cursor\", \"CURSOR\"} {\n\t\targs, _ := json.Marshal(map[string]any{\"limit\": 3, \"cursor\": cursor, alias: \"\"})\n\t\t_, out := post(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_list_specs\",\"arguments\":%s}}`, args))\n\t\tif isErr, _ := out.Result[\"isError\"].(bool); !isErr {\n\t\t\tt.Errorf(\"a %s alias restarted or altered a continuation\", alias)\n\t\t}\n\t}\n}\n\nfunc TestAnOmittedSortAndSlugSortAreTheSameQuery(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tomitted, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\texplicit, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"sort\": \"slug\"})\n\ta, _ := json.Marshal(omitted[\"specs\"])\n\tb, _ := json.Marshal(explicit[\"specs\"])\n\tif string(a) != string(b) {\n\t\tt.Fatalf(\"the default order is not slug order: %s vs %s\", a, b)\n\t}\n\tcursor, _ := omitted[\"next_cursor\"].(string)\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor, \"sort\": \"slug\"}); isErr {\n\t\tt.Fatalf(\"an equivalent sort was treated as another query: %s\", text)\n\t}\n}\n\nfunc TestANullCursorIsRefusedOnEveryPaginatedTool(t *testing.T) {\n\tts, _ := cursorServer(t, 3)\n\tfor _, tool := range []string{\"pose_list_specs\", \"pose_list_roadmaps\", \"pose_list_knowledge\", \"pose_list_reports\", \"pose_capability_history\"} {\n\t\tif _, isErr, _ := cursorCall(t, ts, tool, map[string]any{\"cursor\": nil}); !isErr {\n\t\t\tt.Errorf(\"%s accepted a null cursor\", tool)\n\t\t}\n\t}\n}\n\nfunc TestFiltersThatSerializeAlikeBindDifferentCursors(t *testing.T) {\n\tts, root := cursorServer(t, 0)\n\tfor i := 0; i < 4; i++ {\n\t\tslug := fmt.Sprintf(\"spec-%02d\", i)\n\t\tpath := filepath.Join(root, \".pose\", \"specs\", slug, \"spec.md\")\n\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tbody := fmt.Sprintf(\"---\\nslug: %s\\nstatus: draft\\ncreated_at: 2026-06-01\\ncomponents: x, y\\n---\\n\\n# Spec: %s\\n\", slug, slug)\n\t\tif err := os.WriteFile(path, []byte(body), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tfirst, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2, \"status\": \"draft,z;components=x\", \"components\": \"y\"})\n\tif isErr {\n\t\tt.Fatal(text)\n\t}\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tif cursor == \"\" {\n\t\tt.Skip(\"the filters matched too few specs to page\")\n\t}\n\t_, isErr, text = cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2, \"cursor\": cursor, \"status\": \"draft,z\", \"components\": \"x;components=y\"})\n\tif !isErr || !strings.Contains(text, pose.CursorBinding) {\n\t\tt.Fatalf(\"two different filter tuples shared one cursor binding: %v %q\", isErr, text)\n\t}\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,140p' pose-mcp/internal/cli/assess.go\"","aggregated_output":"package cli\n\n// pose assess (spec pose-capability-mechanism): capability assessment as a\n// POSE-native artifact. Bare `assess` validates structure, evidence and\n// staleness; `init` scaffolds the 16 default mechanisms; `snapshot` appends\n// to the append-only history; `diff` compares two snapshots. Scores are\n// human judgment — nothing here computes one.\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/harne8/pose-mcp/internal/pose\"\n)\n\ntype capabilityPolicy struct {\n\tStaleAfterDays    int `json:\"stale_after_days\"`\n\tStaleAfterCommits int `json:\"stale_after_commits\"`\n}\n\nfunc defaultCapabilityPolicy() capabilityPolicy {\n\treturn capabilityPolicy{StaleAfterDays: 30, StaleAfterCommits: 200}\n}\n\nfunc loadCapabilityPolicyIn(files pose.Files, root string) capabilityPolicy {\n\tpolicy := defaultCapabilityPolicy()\n\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"policy\", \"capabilities.json\"))\n\tif err != nil {\n\t\treturn policy\n\t}\n\tvar loaded capabilityPolicy\n\tif json.Unmarshal(raw, &loaded) == nil {\n\t\tif loaded.StaleAfterDays > 0 {\n\t\t\tpolicy.StaleAfterDays = loaded.StaleAfterDays\n\t\t}\n\t\tif loaded.StaleAfterCommits > 0 {\n\t\t\tpolicy.StaleAfterCommits = loaded.StaleAfterCommits\n\t\t}\n\t}\n\treturn policy\n}\n\n// loadCapabilityPolicy reads and writes the filesystem directly; loadCapabilityPolicyIn takes the\n// operation's files.\nfunc loadCapabilityPolicy(root string) capabilityPolicy {\n\treturn loadCapabilityPolicyIn(pose.NativeFiles(), root)\n}\n\nfunc cmdAssess(root string, args []string, stdout, stderr io.Writer) int {\n\tlocale := cliLocaleValue()\n\tif len(args) > 0 {\n\t\tswitch args[0] {\n\t\tcase \"init\":\n\t\t\treturn assessInit(root, stdout, stderr, locale)\n\t\tcase \"snapshot\":\n\t\t\treturn assessSnapshot(root, stdout, stderr, locale)\n\t\tcase \"diff\":\n\t\t\treturn assessDiff(root, args[1:], stdout, stderr, locale)\n\t\tcase \"stale\":\n\t\t\treturn assessStale(root, args[1:], stdout, stderr, locale)\n\t\tcase \"request\":\n\t\t\treturn assessRequest(root, args[1:], stdout, stderr, locale)\n\t\tcase \"discover\":\n\t\t\treturn assessDiscover(root, args[1:], stdout, stderr, locale)\n\t\tcase \"integrate\":\n\t\t\treturn assessIntegrate(root, args[1:], stdout, stderr, locale)\n\t\tcase \"tech-debt\":\n\t\t\treturn assessTechDebt(root, args[1:], stdout, stderr, locale)\n\t\tcase \"design\":\n\t\t\treturn assessDesign(root, args[1:], stdout, stderr, locale)\n\t\tcase \"--json\":\n\t\t\treturn assessValidate(root, true, stdout, stderr, locale)\n\t\tdefault:\n\t\t\tfmt.Fprintln(stderr, cliText(locale,\n\t\t\t\t\"Usage: pose assess [init|snapshot|diff|stale|request|discover|integrate|tech-debt|design [options]|--json]\",\n\t\t\t\t\"Uso: pose assess [init|snapshot|diff|stale|request|discover|integrate|tech-debt|design [opções]|--json]\"))\n\t\t\treturn 2\n\t\t}\n\t}\n\treturn assessValidate(root, false, stdout, stderr, locale)\n}\n\nfunc assessInit(root string, stdout, stderr io.Writer, locale cliLocale) int {\n\tstore := pose.Store{Root: root}\n\tpath := store.CapabilityAssessmentPath()\n\tif _, err := os.Stat(path); err == nil {\n\t\tfmt.Fprintf(stderr, cliText(locale,\n\t\t\t\"Error: %s already exists; edit it instead of re-initializing\\n\",\n\t\t\t\"Erro: %s já existe; edite-o em vez de re-inicializar\\n\"), path)\n\t\treturn 1\n\t}\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\tfmt.Fprintf(stderr, \"pose assess init: %v\\n\", err)\n\t\treturn 1\n\t}\n\tcontent := capabilityTemplate(assessBaselineCommit(root))\n\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\tfmt.Fprintf(stderr, \"pose assess init: %v\\n\", err)\n\t\treturn 1\n\t}\n\tfmt.Fprintf(stdout, cliText(locale,\n\t\t\"Capability assessment created: %s (16 default mechanisms; edit scores, targets, evidence and prose)\\n\",\n\t\t\"Capability assessment criado: %s (16 mecanismos default; edite scores, targets, evidência e prosa)\\n\"), path)\n\treturn 0\n}\n\n// assessBaselineCommit resolves HEAD for the scaffold; \"0000000\" when git is\n// unavailable so the artifact still parses and the user edits it in.\nfunc assessBaselineCommit(root string) string {\n\tout, err := pose.RawHistoryGit(root, \"rev-parse\", \"--short=12\", \"HEAD\").Output()\n\tif err != nil {\n\t\treturn \"0000000\"\n\t}\n\tcommit := strings.TrimSpace(string(out))\n\tif commit == \"\" {\n\t\treturn \"0000000\"\n\t}\n\treturn commit\n}\n\ntype assessReport struct {\n\tPath        string   `json:\"path\"`\n\tMechanisms  int      `json:\"mechanisms\"`\n\tErrors      []string `json:\"errors,omitempty\"`\n\tWarnings    []string `json:\"warnings,omitempty\"`\n\tAssessedAt  string   `json:\"assessed_at\"`\n\tAgeDays     int      `json:\"age_days\"`\n\tCommitsLag  string   `json:\"commits_since_baseline\"` // number or \"unknown\"\n\tStaleByDays bool     `json:\"stale_by_days\"`\n\tStaleByLag  bool     `json:\"stale_by_commits\"`\n}\n","exit_code":0,"status":"completed"}}
