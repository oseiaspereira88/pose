--roadmap-review-required\":\n+\t\t\tif i+1 >= len(args) {\n+\t\t\t\treturn usageError(stderr, adoptUsage)\n+\t\t\t}\n+\t\t\tif args[i] == \"--milestone-review-required\" {\n+\t\t\t\tmilestoneReview = args[i+1]\n+\t\t\t} else {\n+\t\t\t\troadmapReview = args[i+1]\n+\t\t\t}\n+\t\t\tcloseoutPairGiven = true\n+\t\t\ti++\n \t\tcase \"--date\", \"--reason\", \"--request\", \"--issuer\":\n \t\t\tif i+1 >= len(args) {\n \t\t\t\treturn usageError(stderr, adoptUsage)\n@@ -89,7 +101,7 @@ func cmdAdopt(root string, args []string, stdout, stderr io.Writer) int {\n \tif requestID != \"\" {\n \t\t// An answered configuration-review request decides the capability\n \t\t// it asked about (spec pose-update-configuration-review).\n-\t\tif id != \"\" || mode != \"on\" {\n+\t\tif id != \"\" || mode != \"on\" || closeoutPairGiven {\n \t\t\treturn usageError(stderr, adoptUsage)\n \t\t}\n \t\treq, err := loadReviewRequest(root, requestID)\n@@ -132,6 +144,13 @@ func cmdAdopt(root string, args []string, stdout, stderr io.Writer) int {\n \tif id == \"\" {\n \t\treturn usageError(stderr, adoptUsage)\n \t}\n+\t// The closeout review pair is set together, only for its own capability,\n+\t// and only to turn it on or change it (spec\n+\t// pose-closeout-review-policy-by-cost-benefit R6).\n+\tif closeoutPairGiven && (id != \"closeout-review-policy\" || mode != \"on\" || milestoneReview == \"\" || roadmapReview == \"\") {\n+\t\tout.Failure(\"pose adopt: --milestone-review-required and --roadmap-review-required go together, with closeout-review-policy, without --off, --decline or --defer\")\n+\t\treturn 2\n+\t}\n \tentry, known := posemodel.LookupCatalogEntry(id)\n \tif !known {\n \t\tout.Failure(\"pose adopt: unknown capability \" + id + \"; governed capabilities: \" + strings.Join(posemodel.CatalogIDs(), \", \"))\n@@ -186,7 +205,21 @@ func cmdAdopt(root string, args []string, stdout, stderr io.Writer) int {\n \t\t\t\treturn 1\n \t\t\t}\n \t\t}\n-\t\tchanges = entry.Adopt(docs, date)\n+\t\tif id == \"closeout-review-policy\" {\n+\t\t\t// Preview shows the rule applied today next to the one proposed.\n+\t\t\t_, milestoneNow, roadmapNow := posemodel.CloseoutReviewPolicyEffective(docs)\n+\t\t\tout.Field(\"adopt.current\", posemodel.MilestoneReviewRequiredKey+\"=\"+milestoneNow+\"; \"+posemodel.RoadmapReviewRequiredKey+\"=\"+roadmapNow)\n+\t\t}\n+\t\tif closeoutPairGiven {\n+\t\t\tpair, err := posemodel.SetCloseoutReviewPolicy(docs, milestoneReview, roadmapReview)\n+\t\t\tif err != nil {\n+\t\t\t\tout.Failure(\"pose adopt: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n+\t\t\t\treturn 2\n+\t\t\t}\n+\t\t\tchanges = pair\n+\t\t} else {\n+\t\t\tchanges = entry.Adopt(docs, date)\n+\t\t}\n \t}\n \tvar effects []posemodel.AdoptionEffect\n \tif mode == \"on\" && len(changes) > 0 {\n@@ -274,6 +307,11 @@ func adoptGovernedCapabilitiesAtInstallIn(files posemodel.Files, target string,\n \t\treturn\n \t}\n \tfor _, id := range adopted {\n+\t\tif id == \"closeout-review-policy\" {\n+\t\t\t// This one is not turned off: its values change instead.\n+\t\t\tlog(\"capability (adoption): %s from %s — `pose adopt %s --milestone-review-required <never|when-justified|always> --roadmap-review-required <never|when-justified|always> --apply` changes it\", \"capacidade (adoção): %s desde %s — `pose adopt %s --milestone-review-required <never|when-justified|always> --roadmap-review-required <never|when-justified|always> --apply` altera\", id, date, id)\n+\t\t\tcontinue\n+\t\t}\n \t\tlog(\"capability (adoption): %s from %s — `pose adopt %s --off --apply` turns it off\", \"capacidade (adoção): %s desde %s — `pose adopt %s --off --apply` desliga\", id, date, id)\n \t}\n }\ndiff --git a/pose-mcp/internal/cli/setup.go b/pose-mcp/internal/cli/setup.go\nindex 9d48840c..501849ed 100644\n--- a/pose-mcp/internal/cli/setup.go\n+++ b/pose-mcp/internal/cli/setup.go\n@@ -65,10 +65,22 @@ type setupPlan struct {\n \tNeedsSetup      []posemodel.CapabilityState `json:\"needs_setup\"`\n \tAvailable       []string                    `json:\"available\"`\n \tOnboarding      string                      `json:\"onboarding_spec,omitempty\"`\n+\tCloseoutReview  setupCloseoutReview         `json:\"closeout_review\"`\n \tSteps           []setupStep                 `json:\"steps\"`\n \tNext            *setupStep                  `json:\"next,omitempty\"`\n }\n \n+// setupCloseoutReview shows the closeout review rule in force and the pair an\n+// adoption would write (spec pose-closeout-review-policy-by-cost-benefit R6).\n+type setupCloseoutReview struct {\n+\tAdopted           bool   `json:\"adopted\"`\n+\tMilestone         string `json:\"milestone_review_required\"`\n+\tRoadmap           string `json:\"roadmap_review_required\"`\n+\tProposedMilestone string `json:\"proposed_milestone_review_required,omitempty\"`\n+\tProposedRoadmap   string `json:\"proposed_roadmap_review_required,omitempty\"`\n+\tCommand           string `json:\"command\"`\n+}\n+\n // candidateKeyFile returns the user's public key POSE would suggest\n // registering, preferring a security key.\n func candidateKeyFile() string {\n@@ -135,6 +147,14 @@ func buildSetupPlan(root string) (setupPlan, error) {\n \tif err != nil {\n \t\treturn plan, err\n \t}\n+\tif docs, err := posemodel.LoadPolicyDocs(root); err == nil {\n+\t\tadopted, milestone, roadmap := posemodel.CloseoutReviewPolicyEffective(docs)\n+\t\tplan.CloseoutReview = setupCloseoutReview{Adopted: adopted, Milestone: milestone, Roadmap: roadmap,\n+\t\t\tCommand: \"pose adopt closeout-review-policy --milestone-review-required <never|when-justified|always> --roadmap-review-required <never|when-justified|always> --apply\"}\n+\t\tif !adopted {\n+\t\t\tplan.CloseoutReview.ProposedMilestone, plan.CloseoutReview.ProposedRoadmap = posemodel.CloseoutReviewNever, posemodel.CloseoutReviewNever\n+\t\t}\n+\t}\n \tisNew := map[string]bool{}\n \tfor _, state := range review {\n \t\tisNew[state.ID] = true\n@@ -396,6 +416,14 @@ func renderSetupPlan(rawField func(string, string), section func(string), plan s\n \tfor _, state := range plan.NeedsSetup {\n \t\tfield(\"setup.needs_setup.\"+state.ID, state.Missing)\n \t}\n+\tif closeout := plan.CloseoutReview; closeout.Milestone != \"\" {\n+\t\tline := \"milestone_review_required=\" + closeout.Milestone + \"; roadmap_review_required=\" + closeout.Roadmap\n+\t\tif !closeout.Adopted {\n+\t\t\tline += \" — adopting proposes milestone_review_required=\" + closeout.ProposedMilestone + \", roadmap_review_required=\" + closeout.ProposedRoadmap\n+\t\t}\n+\t\trawField(\"setup.closeout_review\", line)\n+\t\trawField(\"setup.closeout_review.command\", closeout.Command)\n+\t}\n \tif len(plan.Available) > 0 {\n \t\tsort.Strings(plan.Available)\n \t\tfield(\"setup.available\", strings.Join(plan.Available, \", \")+\" — off; `pose adopt --list` explains each\")\n@@ -489,7 +517,19 @@ func runSetupInteractive(root string, plan setupPlan, in *bufio.Reader, stdout,\n \t\t\tanswer := strings.ToLower(ask(step.Summary + \"\\n  [a]dopt, [d]ecline, [l]ater (defer), [s]kip? \"))\n \t\t\tswitch answer {\n \t\t\tcase \"a\", \"adopt\":\n-\t\t\t\tif code := cmdAdopt(root, []string{step.capability, \"--apply\"}, stdout, stderr); code != 0 {\n+\t\t\t\targs := []string{step.capability, \"--apply\"}\n+\t\t\t\tif step.capability == \"closeout-review-policy\" {\n+\t\t\t\t\t// The pair is chosen here and written by the same operation.\n+\t\t\t\t\tchoose := func(key string) string {\n+\t\t\t\t\t\tvalue := strings.TrimSpace(ask(\"  \" + key + \" [never|when-justified|always] (never)? \"))\n+\t\t\t\t\t\tif value == \"\" {\n+\t\t\t\t\t\t\tvalue = posemodel.CloseoutReviewNever\n+\t\t\t\t\t\t}\n+\t\t\t\t\t\treturn value\n+\t\t\t\t\t}\n+\t\t\t\t\targs = []string{step.capability, \"--milestone-review-required\", choose(\"milestone_review_required\"), \"--roadmap-review-required\", choose(\"roadmap_review_required\"), \"--apply\"}\n+\t\t\t\t}\n+\t\t\t\tif code := cmdAdopt(root, args, stdout, stderr); code != 0 {\n \t\t\t\t\treturn code\n \t\t\t\t}\n \t\t\t\tdecided = true\ndiff --git a/pose-mcp/internal/pose/capability_catalog.go b/pose-mcp/internal/pose/capability_catalog.go\nindex 59f85700..db9e4d61 100644\n--- a/pose-mcp/internal/pose/capability_catalog.go\n+++ b/pose-mcp/internal/pose/capability_catalog.go\n@@ -195,6 +195,8 @@ type CatalogEntry struct {\n \tAdopt        func(docs PolicyDocs, date string) []string\n \tRetire       func(docs PolicyDocs) []string\n \tAdopted      func(docs PolicyDocs) bool\n+\t// RetireRefusal, when set, is why the capability cannot be turned off.\n+\tRetireRefusal string\n }\n \n func governedEntry(c GovernedCapability, introduced, effect string, implies ...string) CatalogEntry {\n@@ -305,6 +307,7 @@ func catalogEntries() []CatalogEntry {\n \t\t\t},\n \t\t\tAdopted: func(docs PolicyDocs) bool { v, _ := docs.DoR[\"adopted_at\"].(string); return v != \"\" },\n \t\t},\n+\t\tcloseoutReviewPolicyCatalogEntry(),\n \t\toverlayEntry(\"backend-review\", \"1.1.0\", \"a spec touching a backend component is also reviewed for contracts, input errors, concurrency, observability and integration impact\"),\n \t\toverlayEntry(\"engineering-judgment\", \"6.0.0\", \"a scope selected by its declared risk is also reviewed for engineering judgment\"),\n \t\toverlayEntry(\"frontend-review\", \"1.1.0\", \"a spec touching a frontend component is also reviewed for accessibility, state and rendering\"),\n@@ -319,7 +322,7 @@ func catalogEntries() []CatalogEntry {\n \t\t\t\t}\n \t\t\t\tchanges := []string{\"set qualified_artifact_refs_version=1\"}\n \t\t\t\tdocs.Review[\"qualified_artifact_refs_version\"] = 1\n-\t\t\t\tif schemaVersionOf(docs) < QualifiedArtifactPolicySchemaVersion {\n+\t\t\t\tif schemaVersionOf(docs) < QualifiedArtifactPolicySchemaVersion && !closeoutPairPresent(docs) {\n \t\t\t\t\tdocs.Review[\"schema_version\"] = QualifiedArtifactPolicySchemaVersion\n \t\t\t\t\tchanges = append(changes, fmt.Sprintf(\"set schema_version=%d\", QualifiedArtifactPolicySchemaVersion))\n \t\t\t\t}\n@@ -330,6 +333,10 @@ func catalogEntries() []CatalogEntry {\n \t\t\t\t\treturn nil\n \t\t\t\t}\n \t\t\t\tdelete(docs.Review, \"qualified_artifact_refs_version\")\n+\t\t\t\tif closeoutPairPresent(docs) {\n+\t\t\t\t\t// Schema 5 keeps the closeout pair; references are optional under it.\n+\t\t\t\t\treturn []string{\"remove qualified_artifact_refs_version\"}\n+\t\t\t\t}\n \t\t\t\tdocs.Review[\"schema_version\"] = ReviewPolicySchemaVersion\n \t\t\t\treturn []string{\"remove qualified_artifact_refs_version\", fmt.Sprintf(\"set schema_version=%d\", ReviewPolicySchemaVersion)}\n \t\t\t},\n@@ -343,6 +350,9 @@ func catalogEntries() []CatalogEntry {\n \t\t\t\t\treturn nil\n \t\t\t\t}\n \t\t\t\tdocs.Review[\"spec_authority_transfer_version\"] = 1\n+\t\t\t\tif closeoutPairPresent(docs) {\n+\t\t\t\t\treturn []string{\"set spec_authority_transfer_version=1\"}\n+\t\t\t\t}\n \t\t\t\tdocs.Review[\"schema_version\"] = SpecAuthorityTransferPolicySchemaVersion\n \t\t\t\treturn []string{\"set spec_authority_transfer_version=1\", fmt.Sprintf(\"set schema_version=%d\", SpecAuthorityTransferPolicySchemaVersion)}\n \t\t\t},\n@@ -351,6 +361,9 @@ func catalogEntries() []CatalogEntry {\n \t\t\t\t\treturn nil\n \t\t\t\t}\n \t\t\t\tdelete(docs.Review, \"spec_authority_transfer_version\")\n+\t\t\t\tif closeoutPairPresent(docs) {\n+\t\t\t\t\treturn []string{\"remove spec_authority_transfer_version\"}\n+\t\t\t\t}\n \t\t\t\tdocs.Review[\"schema_version\"] = QualifiedArtifactPolicySchemaVersion\n \t\t\t\treturn []string{\"remove spec_authority_transfer_version\", fmt.Sprintf(\"set schema_version=%d\", QualifiedArtifactPolicySchemaVersion)}\n \t\t\t},\n@@ -493,6 +506,9 @@ func CatalogAdoptBlocker(root string, docs PolicyDocs, entry CatalogEntry) strin\n \n // CatalogRetireBlocker names the adopted capability that depends on entry.\n func CatalogRetireBlocker(docs PolicyDocs, entry CatalogEntry) string {\n+\tif entry.RetireRefusal != \"\" && entry.Adopted(docs) {\n+\t\treturn entry.RetireRefusal\n+\t}\n \tfor _, other := range catalogEntries() {\n \t\tif other.ID == entry.ID || !other.Adopted(docs) {\n \t\t\tcontinue\n@@ -771,3 +787,61 @@ func CapabilityStatesIn(files Files, root string) ([]CapabilityState, error) {\n func CapabilityStates(root string) ([]CapabilityState, error) {\n \treturn CapabilityStatesIn(NativeFiles(), root)\n }\n+\n+// closeoutPairPresent reports a policy that carries the closeout review pair,\n+// whose schema (5) no other capability may lower.\n+func closeoutPairPresent(docs PolicyDocs) bool {\n+\t_, milestone := docs.Review[MilestoneReviewRequiredKey]\n+\t_, roadmap := docs.Review[RoadmapReviewRequiredKey]\n+\treturn milestone || roadmap\n+}\n+\n+// SetCloseoutReviewPolicy writes both closeout review keys and schema 5\n+// together (spec pose-closeout-review-policy-by-cost-benefit R2, R6). It is the\n+// one producer for adoption, install defaults and later changes, so the pair\n+// is never written half.\n+func SetCloseoutReviewPolicy(docs PolicyDocs, milestone, roadmap string) ([]string, error) {\n+\tif !validCloseoutReviewValue(milestone) || !validCloseoutReviewValue(roadmap) {\n+\t\treturn nil, fmt.Errorf(\"pose: %s and %s take never, when-justified or always (got %q, %q)\", MilestoneReviewRequiredKey, RoadmapReviewRequiredKey, milestone, roadmap)\n+\t}\n+\tchanges := []string{}\n+\tif schemaVersionOf(docs) != CloseoutReviewPolicySchemaVersion {\n+\t\tdocs.Review[\"schema_version\"] = CloseoutReviewPolicySchemaVersion\n+\t\tchanges = append(changes, fmt.Sprintf(\"set schema_version=%d\", CloseoutReviewPolicySchemaVersion))\n+\t}\n+\tfor _, pair := range [][2]string{{MilestoneReviewRequiredKey, milestone}, {RoadmapReviewRequiredKey, roadmap}} {\n+\t\tif current, _ := docs.Review[pair[0]].(string); current != pair[1] {\n+\t\t\tdocs.Review[pair[0]] = pair[1]\n+\t\t\tchanges = append(changes, \"set \"+pair[0]+\"=\"+pair[1])\n+\t\t}\n+\t}\n+\treturn changes, nil\n+}\n+\n+// CloseoutReviewPolicyEffective describes the rule a policy applies today: the\n+// adopted pair, or the legacy rule it keeps until adoption.\n+func CloseoutReviewPolicyEffective(docs PolicyDocs) (adopted bool, milestone, roadmap string) {\n+\tif !closeoutPairPresent(docs) {\n+\t\treturn false, \"legacy (a one-member milestone inherits its spec; others and roadmaps owe their own review)\", \"legacy (owes its own review)\"\n+\t}\n+\tmilestone, _ = docs.Review[MilestoneReviewRequiredKey].(string)\n+\troadmap, _ = docs.Review[RoadmapReviewRequiredKey].(string)\n+\treturn true, milestone, roadmap\n+}\n+\n+func closeoutReviewPolicyCatalogEntry() CatalogEntry {\n+\treturn CatalogEntry{\n+\t\tID: \"closeout-review-policy\", Summary: \"milestone and roadmap reviews by cost and benefit\", IntroducedIn: \"7.4.1\", DefaultForNew: true,\n+\t\tEffect: \"the close of a milestone or a roadmap owes its own review only as milestone_review_required and roadmap_review_required say (never, when-justified, always); `pose close` stays explicit and records why\",\n+\t\tAdopt: func(docs PolicyDocs, _ string) []string {\n+\t\t\tif closeoutPairPresent(docs) {\n+\t\t\t\treturn nil\n+\t\t\t}\n+\t\t\tchanges, _ := SetCloseoutReviewPolicy(docs, CloseoutReviewNever, CloseoutReviewNever)\n+\t\t\treturn changes\n+\t\t},\n+\t\tRetire:        func(PolicyDocs) []string { return nil },\n+\t\tRetireRefusal: \"closeout-review-policy cannot be turned off: removing the pair would reinterpret closes already recorded under it; change the values with `pose adopt closeout-review-policy --milestone-review-required <v> --roadmap-review-required <v> --apply`\",\n+\t\tAdopted:       func(docs PolicyDocs) bool { return closeoutPairPresent(docs) },\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex 355f8f37..3d4e761b 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -127,6 +127,11 @@ type ReviewBundlePlan struct {\n \t// would judge an immutable bundle by today's selection, which is the whole\n \t// thing sealing exists to prevent.\n \tSelectedProfiles []ReviewPlanProfile `json:\"selected_profiles,omitempty\"`\n+\t// CloseoutReview seals the closeout-review@1 decision an aggregate scope\n+\t// was reviewed under (spec pose-closeout-review-policy-by-cost-benefit).\n+\t// Nil on every bundle sealed before adoption, which is how such a bundle\n+\t// proves a closure from before the policy.\n+\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n \t// Structure seals the material structural facts the plan observed, so the\n \t// mapping obligation is fixed at seal time. Recomputing it at verification\n \t// would let a later detector improvement retroactively block an approved\n@@ -505,7 +510,7 @@ func (s Store) prepareReviewBundle(ref string, legacyMilestoneManifest bool) (Re\n \tif err != nil {\n \t\treturn ReviewBundle{}, err\n \t}\n-\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure}\n+\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview}\n \n \tscopeProjection, excluded, err := 