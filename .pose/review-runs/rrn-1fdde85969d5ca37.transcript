{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1760,1898p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"\t\tif milestone.ID != scope.Milestone {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, raw := range milestone.Specs {\n\t\t\tif _, external := s.milestoneMember(raw); !external {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\treturn len(milestone.Specs) > 0\n\t}\n\treturn false\n}\n\nfunc (s Store) reviewBundleChildRefs(scope ScopeRef) ([]string, error) {\n\trefs := []string{}\n\tif scope.Kind == \"milestone\" {\n\t\trm, err := s.GetRoadmap(scope.Roadmap)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tif milestone.ID == scope.Milestone {\n\t\t\t\tfor _, raw := range milestone.Specs {\n\t\t\t\t\t// External members are sealed through the federated\n\t\t\t\t\t// manifest, not as local child bundles.\n\t\t\t\t\tif slug, external := s.milestoneMember(raw); !external {\n\t\t\t\t\t\trefs = append(refs, \"spec:\"+slug)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t} else if scope.Kind == \"roadmap\" {\n\t\trm, err := s.GetRoadmap(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\trefs = append(refs, \"milestone:\"+rm.Slug+\"/\"+milestone.ID)\n\t\t}\n\t}\n\treturn refs, nil\n}\n\nfunc (s Store) reviewBundleChildren(scope ScopeRef) ([]ReviewBundleChild, []string, error) {\n\trefs, err := s.reviewBundleChildRefs(scope)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\ts = s.reviewOperation()\n\tparentDone, _ := s.scopeLifecycleDone(scope)\n\tchildren, blockers := []ReviewBundleChild{}, []string{}\n\tfor _, ref := range refs {\n\t\tif verification, err := s.verifyReviewBundle(ref); err == nil && verification.inherited {\n\t\t\t// A declared milestone has no bundle to seal over: the reason is in the\n\t\t\t// roadmap, which this bundle seals.\n\t\t\tif verification.Bundle != nil {\n\t\t\t\tchildren = append(children, ReviewBundleChild{Scope: ref, BundleID: verification.Bundle.BundleID, BundleDigest: verification.Bundle.BundleDigest})\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tsealed, err := s.CurrentReviewBundle(ref)\n\t\tif err != nil {\n\t\t\treturn nil, nil, err\n\t\t}\n\t\tif sealed == nil {\n\t\t\tretained, why := s.retainedChildReviewBundle(ref)\n\t\t\tif retained == nil {\n\t\t\t\tblockers = append(blockers, \"child \"+ref+\" has no sealed review bundle\"+why)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tsealed = retained\n\t\t} else if why := s.childReviewStanding(ref, parentDone); why != \"\" {\n\t\t\tblockers = append(blockers, reviewChildPrefix+ref+\" does not stand: \"+why)\n\t\t}\n\t\tchildren = append(children, ReviewBundleChild{Scope: ref, BundleID: sealed.BundleID, BundleDigest: sealed.BundleDigest})\n\t}\n\treturn children, blockers, nil\n}\n\n// retainedChildReviewBundle is the approved review a done child keeps after\n// later commits changed what is prepared for it: the bundle the child's own\n// verification retains, with every condition that verification applies —\n// lost attestation history, a later negative review, a changed federated\n// manifest — or nil and why not (spec pose-review-subject-later-removal R3).\nfunc (s Store) retainedChildReviewBundle(ref string) (*ReviewBundle, string) {\n\tverification, err := s.reviewOperation().verifyReviewBundle(ref)\n\tif err != nil {\n\t\treturn nil, \": its review could not be verified: \" + err.Error()\n\t}\n\tif verification.State != \"closed\" || !verification.Fresh || !verification.Approved || verification.Bundle == nil {\n\t\tif len(verification.Blockers) > 0 {\n\t\t\treturn nil, \": \" + strings.Join(uniqueSorted(verification.Blockers), \"; \")\n\t\t}\n\t\treturn nil, \"\"\n\t}\n\treturn verification.Bundle, \"\"\n}\n\n// reviewChildPrefix opens every blocker that names a child of the scope.\nconst reviewChildPrefix = \"child \"\n\n// childReviewStanding says why a child's review no longer stands under its\n// parent, or nothing when it does: the child's own verification decides, so\n// every way a review stops standing counts (spec\n// pose-review-approval-follows-children R1-R3, D1).\nfunc (s Store) childReviewStanding(ref string, parentDone bool) string {\n\tverification, err := s.reviewOperation().verifyReviewBundle(ref)\n\tif err != nil {\n\t\treturn \"its review could not be verified: \" + err.Error()\n\t}\n\tif !verification.Fresh || !verification.Approved {\n\t\tif len(verification.Blockers) > 0 {\n\t\t\treturn strings.Join(uniqueSorted(verification.Blockers), \"; \")\n\t\t}\n\t\treturn \"its review is \" + verification.State\n\t}\n\tif parentDone && verification.State != \"closed\" {\n\t\treturn \"it is not closed: \" + verification.State\n\t}\n\treturn \"\"\n}\n\n// reviewChildBlockers are the children a retained bundle integrated that no\n// longer stand. Only a done scope retains, so its children must be closed.\nfunc (s Store) reviewChildBlockers(children []ReviewBundleChild) []string {\n\tblockers := []string{}\n\tfor _, child := range children {\n\t\tif why := s.childReviewStanding(child.Scope, true); why != \"\" {\n\t\t\tblockers = append(blockers, reviewChildPrefix+child.Scope+\" does not stand: \"+why)\n\t\t}\n\t}\n\treturn blockers\n}\n\nfunc blockedByAChild(blockers []string) bool {\n\tfor _, blocker := range blockers {\n\t\tif strings.HasPrefix(blocker, reviewChildPrefix) {\n\t\t\treturn true\n\t\t}\n","exit_code":0,"status":"completed"}}
