{"type":"item.completed","item":{"id":"item_83","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_bundle.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Review bundles provide the fixed review subject described by\n     4\t// ADR 2026-08-13-sealed-review-bundles-and-attestations. A bundle hashes only\n     5\t// governed semantic inputs. Its attestation is a separate immutable artifact,\n     6\t// so recording approval and applying closeout cannot invalidate that approval.\n     7\t\n     8\timport (\n     9\t\t\"bytes\"\n    10\t\t\"crypto/ed25519\"\n    11\t\t\"crypto/sha256\"\n    12\t\t\"encoding/base64\"\n    13\t\t\"encoding/hex\"\n    14\t\t\"encoding/json\"\n    15\t\t\"errors\"\n    16\t\t\"fmt\"\n    17\t\t\"io\"\n    18\t\t\"os\"\n    19\t\t\"os/exec\"\n    20\t\t\"path/filepath\"\n    21\t\t\"sort\"\n    22\t\t\"strconv\"\n    23\t\t\"strings\"\n    24\t\t\"time\"\n    25\t\t\"unicode\"\n    26\t)\n    27\t\n    28\tconst ReviewBundleSchemaVersion = 1\n    29\tconst maxReviewBundleBytes = 4 << 20\n    30\t\n    31\ttype ReviewBundleInput struct {\n    32\t\tKind   string `json:\"kind\"`\n    33\t\tPath   string `json:\"path,omitempty\"`\n    34\t\tDigest string `json:\"digest,omitempty\"`\n    35\t\tReason string `json:\"reason\"`\n    36\t}\n    37\t\n    38\ttype ReviewBundleScope struct {\n    39\t\tRef        string              `json:\"ref\"`\n    40\t\tKind       string              `json:\"kind\"`\n    41\t\tSlug       string              `json:\"slug,omitempty\"`\n    42\t\tRoadmap    string              `json:\"roadmap,omitempty\"`\n    43\t\tMilestone  string              `json:\"milestone,omitempty\"`\n    44\t\tDependsOn  []string            `json:\"depends_on,omitempty\"`\n    45\t\tRemediates []string            `json:\"remediates,omitempty\"`\n    46\t\tSupersedes string              `json:\"supersedes,omitempty\"`\n    47\t\tComponents []string            `json:\"components,omitempty\"`\n    48\t\tDeliveries []string            `json:\"deliveries,omitempty\"`\n    49\t\tSections   []ReviewBundleInput `json:\"sections\"`\n    50\t}\n    51\t\n    52\ttype ReviewBundleSubjectEntry struct {\n    53\t\tAction  string `json:\"action\"`\n    54\t\tPath    string `json:\"path,omitempty\"`\n    55\t\tOldPath string `json:\"old_path,omitempty\"`\n    56\t\tNewPath string `json:\"new_path,omitempty\"`\n    57\t\tClass   string `json:\"class\"`\n    58\t\tDigest  string `json:\"digest,omitempty\"`\n    59\t\tReason  string `json:\"reason\"`\n    60\t}\n    61\t\n    62\t// ReviewBundleRangeObservation records what a change set's commit range spans,\n    63\t// as distinct from what it attributes.\n    64\t//\n    65\t// A change set resolved from trailers takes its paths from the commits that\n    66\t// carry the trailer, which is exact. Its Base and Head, however, describe a\n    67\t// range, and that range spans whatever else was committed in between. Reading\n    68\t// Base..Head as \"the changes of this spec\" is therefore wrong whenever work on\n    69\t// two specs interleaved, and nothing said so.\n    70\ttype ReviewBundleRangeObservation struct {\n    71\t\tChangeSet string `json:\"change_set\"`\n    72\t\t// State is `clean`, `contaminated` or `unknown`. Unknown is not clean: it\n    73\t\t// means the range could not be counted here, and saying so is the point.\n    74\t\tState               string `json:\"state\"`\n    75\t\tAttributedCommits   int    `json:\"attributed_commits\"`\n    76\t\tRangeCommits        int    `json:\"range_commits,omitempty\"`\n    77\t\tUnattributedCommits int    `json:\"unattributed_commits,omitempty\"`\n    78\t\t// UnattributedSpecs names the specs whose POSE-Spec trailer is on a\n    79\t\t// commit the range spans but this change set does not attribute, and\n    80\t\t// UntrailedCommits counts those that carry no trailer at all, so the\n    81\t\t// reviewer knows whose work the range also holds.\n    82\t\tUnattributedSpecs []string `json:\"unattributed_specs,omitempty\"`\n    83\t\tUntrailedCommits  int      `json:\"untrailed_commits,omitempty\"`\n    84\t\tReason            string   `json:\"reason,omitempty\"`\n    85\t}\n    86\t\n    87\ttype ReviewBundleSubject struct {\n    88\t\tChangeSets []string `json:\"change_sets\"`\n    89\t\tBase       string   `json:\"base,omitempty\"`\n    90\t\tHead       string   `json:\"head,omitempty\"`\n    91\t\t// ImplementationDigest identifies the implementation content alone: the\n    92\t\t// attributed change sets, the range they resolve to and the ordered\n    93\t\t// manifest of entries. It is computed from the subject and nothing else.\n    94\t\t//\n    95\t\t// The bundle digest covers this, the plan and the evidence. Anything that\n    96\t\t// observes the implementation — a structural assessment, a receipt, a cache\n    97\t\t// key — anchors here instead, so the graph stays a DAG:\n    98\t\t// implementation -> assessment -> plan -> bundle -> attestation. An\n    99\t\t// assessment that keyed on the bundle containing it would be defining\n   100\t\t// itself in terms of its own output.\n   101\t\tImplementationDigest string                     `json:\"implementation_digest,omitempty\"`\n   102\t\tPatchDigest          string                     `json:\"patch_digest\"`\n   103\t\tTreeDigest           string                     `json:\"tree_digest\"`\n   104\t\tEntries              []ReviewBundleSubjectEntry `json:\"entries\"`\n   105\t\t// Attribution narrows each path to what this scope's own commits changed\n   106\t\t// (see ReviewBundlePathAttribution). It is not implementation identity, so\n   107\t\t// the implementation, patch and tree digests leave it out; it is sealed with\n   108\t\t// the rest of the payload. Absent on bundles sealed before it existed, and\n   109\t\t// whenever Git could not answer: the structural assessment then compares\n   110\t\t// Base and Head.\n   111\t\tAttribution []ReviewBundlePathAttribution `json:\"attribution,omitempty\"`\n   112\t}\n   113\t\n   114\ttype ReviewBundlePlan struct {\n   115\t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n   116\t\tLimitations               []string              `json:\"limitations,omitempty\"`\n   117\t\tPlanDigest                string                `json:\"plan_digest\"`\n   118\t\tIndependence              string                `json:\"independence\"`\n   119\t\tComponents                []ReviewPlanComponent `json:\"components\"`\n   120\t\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n   121\t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n   122\t\t// SelectedProfiles records which components each profile was selected for.\n   123\t\t// A criterion names the profiles it came from, and without this mapping the\n   124\t\t// sealed subject cannot say which components that criterion answers for —\n   125\t\t// so evidence could only be matched by reference and class, never by where\n   126\t\t// it came from. Re-reading it from the current policy at verification time\n   127\t\t// would judge an immutable bundle by today's selection, which is the whole\n   128\t\t// thing sealing exists to prevent.\n   129\t\tSelectedProfiles []ReviewPlanProfile `json:\"selected_profiles,omitempty\"`\n   130\t\t// CloseoutReview seals the closeout-review@1 decision an aggregate scope\n   131\t\t// was reviewed under (spec pose-closeout-review-policy-by-cost-benefit).\n   132\t\t// Nil on every bundle sealed before adoption, which is how such a bundle\n   133\t\t// proves a closure from before the policy.\n   134\t\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n   135\t\t// Structure seals the material structural facts the plan observed, so the\n   136\t\t// mapping obligation is fixed at seal time. Recomputing it at verification\n   137\t\t// would let a later detector improvement retroactively block an approved\n   138\t\t// review; sealing it means a changed observation changes the plan digest and\n   139\t\t// the review goes stale, which is the mechanism this engine already has for\n   140\t\t// \"the thing you approved is not the thing in front of me\". Everything in it\n   141\t\t// is content-derived, so it carries no provider ref into bundle identity.\n   142\t\tStructure *ReviewPlanStructure `json:\"structure,omitempty\"`\n   143\t\t// Band is sealed only under the causality-closeout contract, which raises\n   144\t\t// obligations for elevated and critical plans; omitted otherwise so every\n   145\t\t// other bundle keeps its digest.\n   146\t\tBand string `json:\"band,omitempty\"`\n   147\t}\n   148\t\n   149\ttype ReviewBundleEvidence struct {\n   150\t\tID            string `json:\"id\"`\n   151\t\tModule        string `json:\"module,omitempty\"`\n   152\t\tCheck         string `json:\"check\"`\n   153\t\tEvidenceClass string `json:\"evidence_class\"`\n   154\t\tOutcome       string `json:\"outcome\"`\n   155\t\t// SubjectDigest is the semantic implementation identity observed by a\n   156\t\t// derived producer that is not itself a commit-based validation. It keeps\n   157\t\t// the observation current across provider-ref/derived-only movement while\n   158\t\t// still binding the evidence to the sealed subject content.\n   159\t\tSubjectDigest string `json:\"subject_digest,omitempty\"`\n   160\t\t// SubjectObservation is `observed`, `carried-forward` or `unknown`, and is\n   161\t\t// sealed rather than inferred later. A result that names no commit is\n   162\t\t// unknown, never current: an absent fingerprint is a gap in what we know,\n   163\t\t// and reading it as agreement is how a check that never saw this change\n   164\t\t// comes to stand for it.\n   165\t\tSubjectObservation string `json:\"subject_observation,omitempty\"`\n   166\t\tGitHead            string `json:\"git_head,omitempty\"`\n   167\t\tProvenanceDigest   string `json:\"provenance_digest,omitempty\"`\n   168\t\tReport             string `json:\"report,omitempty\"`\n   169\t}\n   170\t\n   171\t// ReviewEvidenceObservation classifies one sealed result against the subject\n   172\t// head it is sealed beside.\n   173\tfunc ReviewEvidenceObservation(subjectHead string, evidence ReviewBundleEvidence) string {\n   174\t\tif evidence.GitHead == \"\" || subjectHead == \"\" {\n   175\t\t\treturn \"unknown\"\n   176\t\t}\n   177\t\tif evidence.GitHead == subjectHead {\n   178\t\t\treturn \"observed\"\n   179\t\t}\n   180\t\treturn \"carried-forward\"\n   181\t}\n   182\t\n   183\t// ReviewEvidenceObservationForSubject prefers the semantic subject identity\n   184\t// for derived evidence and retains the commit-based compatibility path for\n   185\t// ordinary validation results.\n   186\tfunc ReviewEvidenceObservationForSubject(subject ReviewBundleSubject, evidence ReviewBundleEvidence) string {\n   187\t\tif evidence.SubjectDigest != \"\" {\n   188\t\t\tif subject.ImplementationDigest == \"\" {\n   189\t\t\t\treturn \"unknown\"\n   190\t\t\t}\n   191\t\t\tif evidence.SubjectDigest == subject.ImplementationDigest {\n   192\t\t\t\treturn \"observed\"\n   193\t\t\t}\n   194\t\t\treturn \"carried-forward\"\n   195\t\t}\n   196\t\treturn ReviewEvidenceObservation(subject.Head, evidence)\n   197\t}\n   198\t\n   199\ttype ReviewBundleChild struct {\n   200\t\tScope        string `json:\"scope\"`\n   201\t\tBundleID     string `json:\"bundle_id\"`\n   202\t\tBundleDigest string `json:\"bundle_digest\"`\n   203\t}\n   204\t\n   205\ttype ReviewBundlePayload struct {\n   206\t\tScope    ReviewBundleScope      `json:\"scope\"`\n   207\t\tSubject  ReviewBundleSubject    `json:\"subject\"`\n   208\t\tPlan     ReviewBundlePlan       `json:\"plan\"`\n   209\t\tEvidence []ReviewBundleEvidence `json:\"evidence\"`\n   210\t\t// GoverningContracts are the governance contracts in force when this bundle\n   211\t\t// was sealed, so verification judges it by the rules that existed then\n   212\t\t// rather than by an editable date in today's policy\n   213\t\t// (spec pose-bundles-seal-the-contracts-that-govern-them).\n   214\t\t//\n   215\t\t// A bundle sealed before this field existed carries none, and is read by the\n   216\t\t// dated rule it was always read by. That is the only thing the dates are\n   217\t\t// for now.\n   218\t\tGoverningContracts []string                  `json:\"governing_contracts,omitempty\"`\n   219\t\tFederatedManifest  *FederatedRoadmapManifest `json:\"federated_manifest,omitempty\"`\n   220\t\t// Basis seals the contract-node digest of each spec in scope, only under\n   221\t\t// the causality-closeout contract: a material R/A/D change makes the\n   222\t\t// review stale (spec pose-abm-causality-attestation).\n   223\t\tBasis map[string]string `json:\"basis,omitempty\"`\n   224\t\t// Gates are the two closeout settings that depend on policy, frozen at seal\n   225\t\t// time for the same reason the contracts are: read live, a flag flipped\n   226\t\t// today would approve a closeout recorded years ago\n   227\t\t// (spec pose-bundle-findings-take-the-contract-the-legacy-path-had).\n   228\t\t// A pointer, not a value: `omitempty` does nothing for a struct, so a value\n   229\t\t// here serialised as `\"gates\":{}` in every payload and changed the digest of\n   230\t\t// every bundle already sealed. Nil means the bundle predates the field; a\n   231\t\t// pointer to an empty struct means it was sealed with the defaults, and the\n   232\t\t// two are different facts.\n   233\t\tGates          *ReviewBundleGates  `json:\"gates,omitempty\"`\n   234\t\tChildren       []ReviewBundleChild `json:\"children,omitempty\"`\n   235\t\tConsumedInputs []ReviewBundleInput `json:\"consumed_inputs\"`\n   236\t\t// Implementation is who produced the subject, as the sealing session\n   237\t\t// declared or was detected to be (spec pose-delegation-routing R1). It is\n   238\t\t// sealed, so it cannot be edited after the fact, but it is not content: a\n   239\t\t// preparation never carries it, and a sealed bundle matches a preparation\n   240\t\t// when they are equal apart from it (see sealedBundleMatches). Nil means the\n   241\t\t// bundle predates the field and its implementation is read from the policy\n   242\t\t// (R4).\n   243\t\tImplementation *ReviewBundleImplementation `json:\"implementation,omitempty\"`\n   244\t}\n   245\t\n   246\t// ReviewBundleGates are the policy-dependent parts of the closeout contract.\n   247\t// The rest of it — a finding needing a severity, an action, a disposition the\n   248\t// engine knows, and an accepted risk needing an owner, a rationale and a review\n   249\t// date — is not configuration and is not sealed.\n   250\ttype ReviewBundleGates struct {\n   251\t\tAllowApprovedWithReservations bool     `json:\"allow_approved_with_reservations,omitempty\"`\n   252\t\tAcceptedRiskSeverities        []string `json:\"accepted_risk_severities,omitempty\"`\n   253\t\t// AllowCriterionReuse is sealed for the same reason: reuse carries a prior\n   254\t\t// disposition into this attestation, and whether that was permitted is a\n   255\t\t// property of the review, not of the policy as it stands today\n   256\t\t// (spec pose-reuse-is-sealed-signing-stays-live).\n   257\t\tAllowCriterionReuse bool `json:\"allow_criterion_reuse,omitempty\"`\n   258\t\t// IdentityAssurance is sealed for the same reason as the rest: whether this\n   259\t\t// review had to prove the reviewer's identity, or could declare it, is a\n   260\t\t// property of the review and not of the policy as it stands today.\n   261\t\tIdentityAssurance string `json:\"identity_assurance,omitempty\"`\n   262\t}\n   263\t\n   264\t// SealedGates returns the gates sealed into the bundle, or the conservative\n   265\t// defaults when it predates the field: reservations refused, no risk severity\n   266\t// accepted, no criterion reuse. That is exactly what this path enforced before\n   267\t// the gates existed, so no bundle already sealed changes verdict.\n   268\t//\n   269\t// Identity assurance is the one gate whose conservative default is the weaker\n   270\t// value. A bundle sealed before the field existed was reviewed under an engine\n   271\t// where a prefix was the only identity there was; reading its absence as\n   272\t// `verified` would retroactively claim a proof that was never asked for, and\n   273\t// fail every review already recorded.\n   274\tfunc (p ReviewBundlePayload) SealedGates() ReviewBundleGates {\n   275\t\tif p.Gates == nil {\n   276\t\t\treturn ReviewBundleGates{IdentityAssurance: ReviewIdentityAssuranceDeclared}\n   277\t\t}\n   278\t\tgates := *p.Gates\n   279\t\tif gates.IdentityAssurance == \"\" {\n   280\t\t\tgates.IdentityAssurance = ReviewIdentityAssuranceDeclared\n   281\t\t}\n   282\t\treturn gates\n   283\t}\n   284\t\n   285\t// BundleGovernedBy reports whether the contract governed this bundle, and\n   286\t// whether the bundle says so at all. An unstamped bundle answers `false, false`\n   287\t// and its caller falls back to the dated reading.\n   288\tfunc BundleGovernedBy(bundle ReviewBundle, contractID string) (governed, stamped bool) {\n   289\t\tif len(bundle.Payload.GoverningContracts) == 0 {\n   290\t\t\treturn false, false\n   291\t\t}\n   292\t\tfor _, id := range bundle.Payload.GoverningContracts {\n   293\t\t\tif id == contractID {\n   294\t\t\t\treturn true, true\n   295\t\t\t}\n   296\t\t}\n   297\t\treturn false, true\n   298\t}\n   299\t\n   300\t// governingContractsAtSeal is every contract this engine knows. A bundle sealed\n   301\t// now is held to all of them; one sealed by an engine that did not know a\n   302\t// contract never lists it, and is never retroactively held to it. That is the\n   303\t// property the adoption date could not have, because a date can be edited after\n   304\t// the fact and this cannot.\n   305\tfunc governingContractsAtSeal() []string {\n   306\t\tids := []string{}\n   307\t\tfor _, contract := range ReviewContracts() {\n   308\t\t\tids = append(ids, contract.ID)\n   309\t\t}\n   310\t\tsort.Strings(ids)\n   311\t\treturn ids\n   312\t}\n   313\t\n   314\ttype ReviewBundle struct {\n   315\t\tSchemaVersion  int                 `json:\"schema_version\"`\n   316\t\tBundleID       string              `json:\"bundle_id\"`\n   317\t\tBundleDigest   string              `json:\"bundle_digest\"`\n   318\t\tState          string              `json:\"state\"`\n   319\t\tSealedAt       string              `json:\"sealed_at,omitempty\"`\n   320\t\tPayload        ReviewBundlePayload `json:\"payload\"`\n   321\t\tExcludedInputs []ReviewBundleInput `json:\"excluded_inputs,omitempty\"`\n   322\t\t// RangeObservations sit outside the payload, so outside the digest.\n   323\t\t//\n   324\t\t// They describe the repository around the change — how many commits the\n   325\t\t// attributed range spans — and that moves whenever anything else is\n   326\t\t// committed or reindexed. Sealing it would make an unrelated commit stale a\n   327\t\t// review of content that did not move, which is the invalidation rule this\n   328\t\t// contract exists to keep narrow. They are diagnostics, recomputed on every\n   329\t\t// preparation, like the warnings beside them.\n   330\t\tRangeObservations []ReviewBundleRangeObservation `json:\"range_observations,omitempty\"`\n   331\t\tWarnings          []string                       `json:\"warnings,omitempty\"`\n   332\t\tBlockers          []string                       `json:\"blockers,omitempty\"`\n   333\t\tPath              string                         `json:\"path,omitempty\"`\n   334\t}\n   335\t\n   336\ttype ReviewAttestationReuse struct {\n   337\t\tMode            string `json:\"mode,omitempty\"`\n   338\t\tCriterion       string `json:\"criterion\"`\n   339\t\tFromAttestation string `json:\"from_attestation\"`\n   340\t\tInputDigest     string `json:\"input_digest\"`\n   341\t}\n   342\t\n   343\ttype ReviewAttestationSignature struct {\n   344\t\tIssuer    string `json:\"issuer\"`\n   345\t\tSubject   string `json:\"subject\"`\n   346\t\tAlgorithm string `json:\"algorithm\"`\n   347\t\tPublicKey string `json:\"public_key\"`\n   348\t\tSignature string `json:\"signature\"`\n   349\t}\n   350\t\n   351\t// ReviewAuthorityClaim is what an authorized issuer asserts about who reviewed,\n   352\t// bound to the exact bundle they reviewed.\n   353\t//\n   354\t// The engine does not learn who anyone is from this. It verifies that an issuer\n   355\t// it trusts, holding the grant for the role being claimed, signed a statement\n   356\t// binding these principals and executions to this bundle — and that the\n   357\t// statement is current and addressed to this project. Whether the issuer told\n   358\t// the truth is the issuer's authority, not POSE's inference, and that boundary\n   359\t// is the honest one: the alternative is a local engine claiming to know\n   360\t// something no local evidence can show.\n   361\ttype ReviewAuthorityClaim struct {\n   362\t\tSchemaVersion int    `json:\"schema_version\"`\n   363\t\tProject       string `json:\"project\"`\n   364\t\tBundleDigest  string `json:\"bundle_digest\"`\n   365\t\t// Principal and Role describe the reviewer. Role is `agent` or `human`.\n   366\t\tPrincipal string `json:\"principal\"`\n   367\t\tRole      string `json:\"role\"`\n   368\t\t// ReviewExecution and ImplementationExecution are the two runs the\n   369\t\t// separation is about; ImplementationPrincipal is who produced the change.\n   370\t\tReviewExecution         string `json:\"review_execution\"`\n   371\t\tImplementationPrincipal string `json:\"implementation_principal\"`\n   372\t\tImplementationExecution string `json:\"implementation_execution\"`\n   373\t\tIssuer                  string `json:\"issuer\"`\n   374\t\tIssuedAt                string `json:\"issued_at\"`\n   375\t\tExpiresAt               string `json:\"expires_at,omitempty\"`\n   376\t\t// Audience is the project this claim was issued for. A claim replayed from\n   377\t\t// another project names that project here and stops being satisfied.\n   378\t\tAudience string `json:\"audience\"`\n   379\t}\n   380\t\n   381\ttype ReviewAttestation struct {\n   382\t\tRun           *ReviewRunReference     `json:\"run,omitempty\"`\n   383\t\tSchemaVersion int                     `json:\"schema_version\"`\n   384\t\tAttestationID string                  `json:\"attestation_id\"`\n   385\t\tBundleID      string                  `json:\"bundle_id\"`\n   386\t\tBundleDigest  string                  `json:\"bundle_digest\"`\n   387\t\tReviewer      string                  `json:\"reviewer\"`\n   388\t\tDecision      string                  `json:\"decision\"`\n   389\t\tLimitations   []string                `json:\"limitations,omitempty\"`\n   390\t\tCriteria      []ReviewCriterion       `json:\"criteria\"`\n   391\t\tTools         []ReviewToolDisposition `json:\"tools,omitempty\"`\n   392\t\tEvidenceRefs  []string                `json:\"evidence_refs,omitempty\"`\n   393\t\tFindings      []ReviewFinding         `json:\"findings\"`\n   394\t\tAuthority     *ReviewAuthorityClaim   `json:\"authority,omitempty\"`\n   395\t\t// Attribution separates who prepared, concluded, confirmed and applied\n   396\t\t// the review (spec pose-review-attribution-roles). Absent on every record\n   397\t\t// written before it, which renders as legacy-undifferentiated.\n   398\t\tAttribution *ReviewAttribution          `json:\"attribution,omitempty\"`\n   399\t\tReusedFrom  []ReviewAttestationReuse    `json:\"reused_from,omitempty\"`\n   400\t\tSupersedes  string                      `json:\"supersedes,omitempty\"`\n   401\t\tEnvelope    *ReviewAttestationSignature `json:\"envelope,omitempty\"`\n   402\t\tAttestedAt  string                      `json:\"attested_at\"`\n   403\t\tPath        string                      `json:\"path,omitempty\"`\n   404\t}\n   405\t\n   406\ttype ReviewAttestationEnvelope struct {\n   407\t\tSchemaVersion int               `json:\"schema_version\"`\n   408\t\tIssuer        string            `json:\"issuer\"`\n   409\t\tSubject       string            `json:\"subject\"`\n   410\t\tAlgorithm     string            `json:\"algorithm\"`\n   411\t\tPublicKey     string            `json:\"public_key\"`\n   412\t\tSignature     string            `json:\"signature\"`\n   413\t\tAttestation   ReviewAttestation `json:\"attestation\"`\n   414\t}\n   415\t\n   416\t// ReviewAttestationPendency is one answer the attestation still owes. It is\n   417\t// not a disposition: nothing is written for a pending criterion, because the\n   418\t// whole point is that no value stands in for the answer.\n   419\ttype ReviewAttestationPendency struct {\n   420\t\tCriterion string `json:\"criterion\"`\n   421\t\tKind      string `json:\"kind\"`\n   422\t\tReason    string `json:\"reason\"`\n   423\t\t// Code, Source and Condition type the pendency (spec\n   424\t\t// pose-typed-producer-diagnostics): which bundle owes it and what\n   425\t\t// satisfies it.\n   426\t\tCode      string `json:\"code,omitempty\"`\n   427\t\tSource    string `json:\"source,omitempty\"`\n   428\t\tCondition string `json:\"condition,omitempty\"`\n   429\t}\n   430\t\n   431\t// ReviewAttestationPreparation is what automation can honestly produce on its\n   432\t// own: every mechanical criterion answered from sealed evidence, and an\n   433\t// explicit list of what a reviewer still has to answer.\n   434\ttype ReviewAttestationPreparation struct {\n   435\t\tAttestation ReviewAttestation           `json:\"attestation\"`\n   436\t\tPending     []ReviewAttestationPendency `json:\"pending,omitempty\"`\n   437\t\tComplete    bool                        `json:\"complete\"`\n   438\t}\n   439\t\n   440\ttype ReviewBundleDelta struct {\n   441\t\tFromBundle             string   `json:\"from_bundle,omitempty\"`\n   442\t\tToBundle               string   `json:\"to_bundle\"`\n   443\t\tChangedComponents      []string `json:\"changed_components,omitempty\"`\n   444\t\tChangedSections        []string `json:\"changed_sections,omitempty\"`\n   445\t\tChangedPaths           []string `json:\"changed_paths,omitempty\"`\n   446\t\tChangedCriteria        []string `json:\"changed_criteria,omitempty\"`\n   447\t\tChangedEvidence        []string `json:\"changed_evidence,omitempty\"`\n   448\t\tChangedEvidenceClasses []string `json:\"changed_evidence_classes,omitempty\"`\n   449\t\tChangedFindings        []string `json:\"changed_findings,omitempty\"`\n   450\t\tReusableCriteria       []string `json:\"reusable_criteria,omitempty\"`\n   451\t\t// CriterionReuse explains, per criterion, which material inputs changed\n   452\t\t// (spec pose-material-equivalence-reuse).\n   453\t\tCriterionReuse []CriterionReuseExplanation `json:\"criterion_reuse,omitempty\"`\n   454\t}\n   455\t\n   456\ttype ReviewBundleVerification struct {\n   457\t\t// Round is the round of the scope the bundle is in (spec\n   458\t\t// pose-delegated-review-round-protocol R1, R7).\n   459\t\tRound                  int                `json:\"round,omitempty\"`\n   460\t\tDelegatedRuns          []ReviewRunSummary `json:\"delegated_runs,omitempty\"`\n   461\t\tDelegatedHistoryLosses []string           `json:\"delegated_history_losses,omitempty\"`\n   462\t\tScope                  string             `json:\"scope\"`\n   463\t\tState                  string             `json:\"state\"`\n   464\t\tBundle                 *ReviewBundle      `json:\"bundle,omitempty\"`\n   465\t\tAttestation            *ReviewAttestation `json:\"attestation,omitempty\"`\n   466\t\tDelta                  *ReviewBundleDelta `json:\"delta,omitempty\"`\n   467\t\tFresh                  bool               `json:\"fresh\"`\n   468\t\tApproved               bool               `json:\"approved\"`\n   469\t\tNextAction             string             `json:\"next_action\"`\n   470\t\tWarnings               []string           `json:\"warnings,omitempty\"`\n   471\t\tBlockers               []string           `json:\"blockers,omitempty\"`\n   472\t\t// Assurance discloses what this record proves about its reviewer (spec\n   473\t\t// pose-review-assurance-disclosure).\n   474\t\tAssurance *ReviewAssurance `json:\"assurance,omitempty\"`\n   475\t\t// currentManifest is the manifest the scope resolves to now, which a retained\n   476\t\t// approval is judged against.\n   477\t\tcurrentManifest *FederatedRoadmapManifest\n   478\t\t// ApprovalOrigin says where the approval of a milestone with no review of its own\n   479\t\t// comes from: the spec it inherits, or the roadmap that declares it.\n   480\t\tApprovalOrigin string `json:\"approval_origin,omitempty\"`\n   481\t\t// inherited marks a milestone that owes no review of its own: Bundle, when there is\n   482\t\t// one, belongs to its spec.\n   483\t\tinherited bool\n   484\t}\n   485\t\n   486\t// PrepareReviewBundle resolves a deterministic bundle without writing it.\n   487\tfunc (s Store) PrepareReviewBundle(ref string) (ReviewBundle, error) {\n   488\t\treturn s.prepareReviewBundle(ref, false)\n   489\t}\n   490\t\n   491\t// prepareReviewBundle with legacyMilestoneManifest reproduces bundles sealed\n   492\t// before milestone scopes had their own federated manifest, when a milestone\n   493\t// sealed the acceptance of its whole roadmap. It exists only so those sealed\n   494\t// bundles keep their semantics; new bundles never use it.\n   495\tfunc (s Store) prepareReviewBundle(ref string, legacyMilestoneManifest bool) (ReviewBundle, error) {\n   496\t\t// One index generation for the plan and for the evidence read after it.\n   497\t\tif s.indexPin == nil {\n   498\t\t\ts = s.PinIndexes()\n   499\t\t}\n   500\t\tscope, err := ParseScopeRef(ref)\n   501\t\tif err != nil {\n   502\t\t\treturn ReviewBundle{}, err\n   503\t\t}\n   504\t\tplan, err := s.ReviewPlan(ref)\n   505\t\tif err != nil {\n   506\t\t\treturn ReviewBundle{}, err\n   507\t\t}\n   508\t\tbundle := ReviewBundle{SchemaVersion: ReviewBundleSchemaVersion, State: \"prepared\", Warnings: uniqueSorted(append([]string{}, plan.Warnings...)), Blockers: uniqueSorted(append([]string{}, plan.Blockers...))}\n   509\t\tbundlePlanDigest, err := reviewBundlePlanDigest(plan)\n   510\t\tif err != nil {\n   511\t\t\treturn ReviewBundle{}, err\n   512\t\t}\n   513\t\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview}\n   514\t\n   515\t\tscopeProjection, excluded, err := s.reviewBundleScopeProjection(scope)\n   516\t\tif err != nil {\n   517\t\t\treturn ReviewBundle{}, err\n   518\t\t}\n   519\t\tbundle.Payload.Scope = scopeProjection\n   520\t\tbundle.ExcludedInputs = excluded\n   521\t\n   522\t\tgraph, graphErr := s.GetDeliveryIntegrity(\"\")\n   523\t\tif graphErr != nil {\n   524\t\t\tbundle.Blockers = append(bundle.Blockers, \"delivery integrity is unavailable: run pose index\")\n   525\t\t} else {\n   526\t\t\tvar subjectExcluded []ReviewBundleInput\n   527\t\t\tbundle.Payload.Subject, subjectExcluded, bundle.Blockers, err = s.reviewBundleSubject(scope, bundle.Payload.Plan.Components, graph, bundle.Blockers)\n   528\t\t\tif err != nil {\n   529\t\t\t\treturn ReviewBundle{}, err\n   530\t\t\t}\n   531\t\t\tbundle.ExcludedInputs = append(bundle.ExcludedInputs, subjectExcluded...)\n   532\t\t\tbundle.Payload.Evidence = s.reviewBundleEvidence(scope, graph, bundle.Payload.Subject, bundle.Payload.Plan)\n   533\t\t\tfor i := range bundle.Payload.Evidence {\n   534\t\t\t\tbundle.Payload.Evidence[i].SubjectObservation = ReviewEvidenceObservationForSubject(bundle.Payload.Subject, bundle.Payload.Evidence[i])\n   535\t\t\t}\n   536\t\t\t// Without a change set no evidence can be attributed: that blocker already\n   537\t\t\t// names the cause, and a second one would send the operator to re-validate.\n   538\t\t\tif !reportsMissingChangeSet(bundle.Blockers) && s.evidenceFallsShort(scope, bundle.Payload.Evidence) && s.reviewScopeRequiresValidationEvidence(scope, bundle.Payload.Plan, graph) {\n   539\t\t\t\tbundle.Blockers = append(bundle.Blockers, noValidationEvidenceBlocker)\n   540\t\t\t}\n   541\t\t\tbundle.Warnings = append(bundle.Warnings, staleEvidenceWarnings(bundle.Payload.Subject, bundle.Payload.Evidence)...)\n   542\t\t\tbundle.RangeObservations = s.reviewBundleRangeObservations(bundle.Payload.Subject.ChangeSets, graph)\n   543\t\t\tbundle.Warnings = append(bundle.Warnings, rangeObservationWarnings(bundle.RangeObservations)...)\n   544\t\t}\n   545\t\n   546\t\tif scope.Kind != \"spec\" {\n   547\t\t\tchildren, childBlockers, childErr := s.reviewBundleChildren(scope)\n   548\t\t\tif childErr != nil {\n   549\t\t\t\treturn ReviewBundle{}, childErr\n   550\t\t\t}\n   551\t\t\tbundle.Payload.Children = children\n   552\t\t\tbundle.Blockers = append(bundle.Blockers, childBlockers...)\n   553\t\t}\n   554\t\n   555\t\tbundle.Payload.ConsumedInputs = s.reviewBundleConsumedInputs(plan)\n   556\t\tbundle.Payload.GoverningContracts = governingContractsAtSeal()\n   557\t\tif adopted, err := s.CausalityCloseoutAdopted(); err == nil && adopted && s.causalityCloseoutExempts(scope) {\n   558\t\t\tbundle.Warnings = append(bundle.Warnings, \"causality closeout not stamped: every spec in \"+scope.String()+\" was created before causality_closeout_adopted_at \"+s.causalityCloseoutCutoff())\n   559\t\t} else if err == nil && adopted {\n   560\t\t\t// Stamped only on adoption, so no bundle is held to it retroactively.\n   561\t\t\tbundle.Payload.GoverningContracts = uniqueSorted(append(bundle.Payload.GoverningContracts, CausalityCloseoutContract))\n   562\t\t\tbundle.Payload.Plan.Band = plan.Band\n   563\t\t\tbundle.Payload.Basis = s.reviewScopeBasis(scope)\n   564\t\t}\n   565\t\tif s.FederatedResolver != nil && (scope.Kind == \"roadmap\" || scope.Kind == \"milestone\") {\n   566\t\t\tvar report FederatedRoadmapAcceptanceReport\n   567\t\t\tvar err error\n   568\t\t\tif scope.Kind == \"milestone\" && !legacyMilestoneManifest {\n   569\t\t\t\treport, err = s.FederatedMilestoneAcceptance(s.FederatedProjectID, scope.Roadmap, scope.Milestone, *s.FederatedResolver)\n   570\t\t\t} else if scope.Kind == \"milestone\" {\n   571\t\t\t\treport, err = s.FederatedRoadmapAcceptance(s.FederatedProjectID, scope.Roadmap, *s.FederatedResolver)\n   572\t\t\t} else {\n   573\t\t\t\treport, err = s.FederatedRoadmapAcceptance(s.FederatedProjectID, scope.Slug, *s.FederatedResolver)\n   574\t\t\t}\n   575\t\t\tif err != nil {\n   576\t\t\t\treturn ReviewBundle{}, err\n   577\t\t\t}\n   578\t\t\tbundle.Payload.FederatedManifest = &report.Manifest\n   579\t\t}\n   580\t\tif s.FederatedResolver != nil && scope.Kind == \"spec\" {\n   581\t\t\treport, applies, err := s.FederatedSpecAcceptance(s.FederatedProjectID, scope.Slug, *s.FederatedResolver)\n   582\t\t\tif err != nil {\n   583\t\t\t\treturn ReviewBundle{}, err\n   584\t\t\t}\n   585\t\t\tif applies {\n   586\t\t\t\tbundle.Payload.FederatedManifest = &report.Manifest\n   587\t\t\t}\n   588\t\t}\n   589\t\tif policy, _, policyErr := s.loadReviewPolicy(); policyErr == nil {\n   590\t\t\tbundle.Payload.Gates = &ReviewBundleGates{\n   591\t\t\t\tAllowApprovedWithReservations: policy.AllowApprovedWithReservations,\n   592\t\t\t\tAcceptedRiskSeverities:        append([]string{}, policy.AcceptedRiskSeverities...),\n   593\t\t\t\tAllowCriterionReuse:           policy.AllowCriterionReuse,\n   594\t\t\t\tIdentityAssurance:             policy.ReviewIdentityAssurance(scope.Kind),\n   595\t\t\t}\n   596\t\t}\n   597\t\tbundle.Blockers = uniqueSorted(bundle.Blockers)\n   598\t\tbundle.Warnings = uniqueSorted(bundle.Warnings)\n   599\t\tbundle.ExcludedInputs = sortedBundleInputs(bundle.ExcludedInputs)\n   600\t\tnormalizeReviewBundlePayload(&bundle.Payload)\n   601\t\tdigest, err := reviewBundlePayloadDigest(bundle.Payload)\n   602\t\tif err != nil {\n   603\t\t\treturn ReviewBundle{}, err\n   604\t\t}\n   605\t\tbundle.BundleDigest = digest\n   606\t\tbundle.BundleID = \"rvb-\" + strings.TrimPrefix(digest, \"sha256:\")[:16]\n   607\t\treturn bundle, nil\n   608\t}\n   609\t\n   610\tfunc (s Store) reviewBundleScopeProjection(scope ScopeRef) (ReviewBundleScope, []ReviewBundleInput, error) {\n   611\t\tprojection := ReviewBundleScope{Ref: scope.String(), Kind: scope.Kind, Slug: scope.Slug, Roadmap: scope.Roadmap, Milestone: scope.Milestone, Sections: []ReviewBundleInput{}}\n   612\t\texcluded := []ReviewBundleInput{}\n   613\t\tswitch scope.Kind {\n   614\t\tcase \"spec\":\n   615\t\t\tsp, err := s.GetSpec(scope.Slug)\n   616\t\t\tif err != nil {\n   617\t\t\t\treturn projection, nil, err\n   618\t\t\t}\n   619\t\t\tprojection.DependsOn = append([]string{}, sp.DependsOn...)\n   620\t\t\tif err := s.ValidateRemediationLineage(*sp); err != nil {\n   621\t\t\t\treturn projection, nil, err\n   622\t\t\t}\n   623\t\t\tprojection.Remediates = append([]string{}, sp.Remediates...)\n   624\t\t\tsort.Strings(projection.Remediates)\n   625\t\t\tprojection.Supersedes = sp.Supersedes\n   626\t\t\tprojection.Components = append([]string{}, sp.Components...)\n   627\t\t\tprojection.Deliveries = append([]string{}, sp.Delivers...)\n   628\t\t\tsort.Strings(projection.DependsOn)\n   629\t\t\tsort.Strings(projection.Components)\n   630\t\t\tsort.Strings(projection.Deliveries)\n   631\t\t\tsections := markdownLevelTwoSections(sp.Body)\n   632\t\t\tfor _, name := range []string{\"intent\", \"requirements\", \"technical plan\", \"decisions\"} {\n   633\t\t\t\tbody := sections[name]\n   634\t\t\t\tif body == \"\" {\n   635\t\t\t\t\tcontinue\n   636\t\t\t\t}\n   637\t\t\t\tprojection.Sections = append(projection.Sections, ReviewBundleInput{Kind: \"semantic-section\", Path: name, Digest: digestText(body), Reason: \"governed semantic review input\"})\n   638\t\t\t}\n   639\t\t\tfor _, name := range []string{\"tasks\", \"validation\", \"final report\"} {\n   640\t\t\t\tif sections[name] != \"\" {\n   641\t\t\t\t\texcluded = append(excluded, ReviewBundleInput{Kind: \"derived-section\", Path: name, Digest: digestText(sections[name]), Reason: \"operational closeout content is verified by its own gate\"})\n   642\t\t\t\t}\n   643\t\t\t}\n   644\t\t\tlifecyclePath, err := filepath.Rel(s.Root, sp.Path)\n   645\t\t\tif err != nil {\n   646\t\t\t\treturn projection, nil, err\n   647\t\t\t}\n   648\t\t\texcluded = append(excluded, ReviewBundleInput{Kind: \"lifecycle\", Path: filepath.ToSlash(lifecyclePath), Reason: \"status and completed_at do not define the reviewed semantic subject\"})\n   649\t\tcase \"milestone\":\n   650\t\t\trm, err := s.GetRoadmap(scope.Roadmap)\n   651\t\t\tif err != nil {\n   652\t\t\t\treturn projection, nil, err\n   653\t\t\t}\n   654\t\t\tcontent := normalizeBundleText(roadmapMilestoneSection(rm.Body, scope.Milestone))\n   655\t\t\tif content == \"\" {\n   656\t\t\t\treturn projection, nil, fmt.Errorf(\"pose: milestone %s/%s not found\", scope.Roadmap, scope.Milestone)\n   657\t\t\t}\n   658\t\t\tprojection.Sections = append(projection.Sections, ReviewBundleInput{Kind: \"milestone\", Path: scope.Milestone, Digest: digestText(content), Reason: \"governed milestone exit and cut criteria\"})\n   659\t\tcase \"roadmap\":\n   660\t\t\trm, err := s.GetRoadmap(scope.Slug)\n   661\t\t\tif err != nil {\n   662\t\t\t\treturn projection, nil, err\n   663\t\t\t}\n   664\t\t\t// Repo-relative by construction, not rm.Path (absolute — Store.Root\n   665\t\t\t// joined with the roadmap file): an absolute path bakes the sealing\n   666\t\t\t// machine's checkout location into the sealed bundle's semantic\n   667\t\t\t// identity, so the exact same content re-sealed from a different\n   668\t\t\t// checkout path (any other clone, including CI's) computes a\n   669\t\t\t// different ChangedSections key and reads as \"changed\" even though\n   670\t\t\t// nothing changed. Every other scope kind already avoids this\n   671\t\t\t// (spec uses section names, milestone uses the milestone ID).\n   672\t\t\tif rm.UnreviewedMilestones != \"\" {\n   673\t\t\t\tprojection.Sections = append(projection.Sections, ReviewBundleInput{Kind: unreviewedMilestonesSection, Path: rm.UnreviewedMilestones, Digest: digestText(rm.UnreviewedMilestones), Reason: \"the reason its roadmap gives for milestones standing without a review\"})\n   674\t\t\t}\n   675\t\t\tprojection.Sections = append(projection.Sections, ReviewBundleInput{Kind: \"roadmap\", Path: filepath.ToSlash(filepath.Join(\".pose\", \"roadmaps\", scope.Slug+\".md\")), Digest: digestText(normalizeBundleText(rm.Body)), Reason: \"governed roadmap outcomes and ordered membership\"})\n   676\t\t}\n   677\t\treturn projection, excluded, nil\n   678\t}\n   679\t\n   680\tfunc markdownLevelTwoSections(body string) map[string]string {\n   681\t\tsections := map[string]string{}\n   682\t\tcurrent := \"\"\n   683\t\tvar lines []string\n   684\t\tflush := func() {\n   685\t\t\tif current != \"\" {\n   686\t\t\t\tsections[current] = normalizeBundleText(strings.Join(lines, \"\\n\"))\n   687\t\t\t}\n   688\t\t\tlines = nil\n   689\t\t}\n   690\t\tfor _, raw := range strings.Split(strings.ReplaceAll(body, \"\\r\\n\", \"\\n\"), \"\\n\") {\n   691\t\t\tline := strings.TrimSpace(raw)\n   692\t\t\tif strings.HasPrefix(line, \"## \") && !strings.HasPrefix(line, \"### \") {\n   693\t\t\t\tflush()\n   694\t\t\t\ttitle := strings.TrimSpace(strings.TrimPrefix(line, \"## \"))\n   695\t\t\t\tif dot := strings.Index(title, \".\"); dot >= 0 && dot < 3 {\n   696\t\t\t\t\ttitle = strings.TrimSpace(title[dot+1:])\n   697\t\t\t\t}\n   698\t\t\t\tcurrent = strings.ToLower(title)\n   699\t\t\t\tcontinue\n   700\t\t\t}\n   701\t\t\tif current != \"\" {\n   702\t\t\t\tlines = append(lines, strings.TrimRight(raw, \" \\t\"))\n   703\t\t\t}\n   704\t\t}\n   705\t\tflush()\n   706\t\treturn sections\n   707\t}\n   708\t\n   709\tfunc (s Store) reviewBundleSubject(scope ScopeRef, components []ReviewPlanComponent, graph DeliveryIntegrityGraph, blockers []string) (ReviewBundleSubject, []ReviewBundleInput, []string, error) {\n   710\t\tif len(components) == 0 {\n   711\t\t\tif ctx, err := s.resolveReviewPlanContext(scope); err == nil {\n   712\t\t\t\tcomponents = ctx.Components\n   713\t\t\t}\n   714\t\t}\n   715\t\tsubject := ReviewBundleSubject{ChangeSets: []string{}, Entries: []ReviewBundleSubjectEntry{}}\n   716\t\texcluded := []ReviewBundleInput{}\n   717\t\tallowedSpecs, err := s.reviewBundleScopeSpecs(scope)\n   718\t\tif err != nil {\n   719\t\t\treturn subject, excluded, blockers, err\n   720\t\t}\n   721\t\tsets := []ChangeSet{}\n   722\t\tfor _, set := range graph.ChangeSets {\n   723\t\t\tif allowedSpecs[set.Spec] {\n   724\t\t\t\tsets = append(sets, set)\n   725\t\t\t}\n   726\t\t}\n   727\t\t// Every selected spec that observes a path the subject reads — whatever\n   728\t\t// its action, and read before reduction drops a set whose commits\n   729\t\t// another contains: an entry is kept once, but a removal must hold for\n   730\t\t// all of them (SR-R1-02, SR-R2-01, SR-R3-01). The removing spec's own\n   731\t\t// observation asks nothing of it.\n   732\t\tobservers := map[string][]string{}\n   733\t\tfor _, set := range sets {\n   734\t\t\tfor _, observed := range set.Paths {\n   735\t\t\t\tif observed.Action == \"removed\" {\n   736\t\t\t\t\tcontinue\n   737\t\t\t\t}\n   738\t\t\t\tpath := observed.Path\n   739\t\t\t\tif observed.Action == \"renamed\" {\n   740\t\t\t\t\tpath = observed.NewPath\n   741\t\t\t\t}\n   742\t\t\t\tobservers[path] = append(observers[path], set.Spec)\n   743\t\t\t}\n   744\t\t}\n   745\t\tsets = reduceReviewBundleChangeSets(sets)\n   746\t\tif len(sets) == 0 && s.milestoneOnlyExternal(scope) {\n   747\t\t\t// Every member is owned by another project: the implementation is\n   748\t\t\t// sealed through the federated manifest, with its source proof, and\n   749\t\t\t// there is no local subject to attribute.\n   750\t\t\treturn subject, excluded, blockers, nil\n   751\t\t}\n   752\t\tif len(sets) == 0 {\n   753\t\t\tmissing := missingChangeSetBlocker + scope.String()\n   754\t\t\tif scope.Kind == \"spec\" {\n   755\t\t\t\tmissing += \"; the index holds no commit with `POSE-Spec: \" + scope.Slug + \"`: add the line to the implementing commit, run `pose index` and confirm with `pose artifact-check --spec \" + scope.Slug + \"`\"\n   756\t\t\t}\n   757\t\t\tblockers = append(blockers, missing)\n   758\t\t\treturn subject, excluded, blockers, nil\n   759\t\t}\n   760\t\tsort.Slice(sets, func(i, j int) bool { return sets[i].ID < sets[j].ID })\n   761\t\tseen := map[string]bool{}\n   762\t\tsupersededPaths := map[string]bool{}\n   763\t\tfor _, set := range sets {\n   764\t\t\tfor _, observed := range set.Paths {\n   765\t\t\t\tif observed.Action == \"renamed\" && observed.OldPath != \"\" {\n   766\t\t\t\t\tsupersededPaths[observed.OldPath] = true\n   767\t\t\t\t}\n   768\t\t\t}\n   769\t\t}\n   770\t\t// Resolve every gitlink up front, in one call. A submodule is a gitlink in\n   771\t\t// the index and a directory in the working tree, so it has no blob to read —\n   772\t\t// and it is not recognisable by path shape, which means asking after the\n   773\t\t// shape rules have already classified it is too late: a submodule under a\n   774\t\t// mapped component or a known prefix is classified as implementation, skips\n   775\t\t// the lookup, and then fails when the digest step tries to read a directory.\n   776\t\tcandidatePaths := []string{}\n   777\t\tfor _, set := range sets {\n   778\t\t\tfor _, observed := range set.Paths {\n   779\t\t\t\tcandidatePaths = append(candidatePaths, observed.Path)\n   780\t\t\t\tif observed.NewPath != \"\" {\n   781\t\t\t\t\tcandidatePaths = append(candidatePaths, observed.NewPath)\n   782\t\t\t\t}\n   783\t\t\t}\n   784\t\t}\n   785\t\tgitlinks := reviewBundleGitlinksIn(s.fsys(), s.Root, uniqueSorted(candidatePaths))\n   786\t\t// One status of the tree for the whole subject, taken on first need.\n   787\t\tvar status *workingTreeSnapshot\n   788\t\tnewestHead := s.newestResolvedHead(sets)\n   789\t\tfor _, set := range sets {\n   790\t\t\tsubject.ChangeSets = append(subject.ChangeSets, set.ID)\n   791\t\t\tif subject.Base == \"\" {\n   792\t\t\t\tsubject.Base = set.ResolvedBase\n   793\t\t\t}\n   794\t\t\t// The head of the subject is the newest head of its change sets, not the head of the\n   795\t\t\t// one the sort by id happens to put last (spec pose-review-subject-head-is-the-newest).\n   796\t\t\tsubject.Head = set.ResolvedHead\n   797\t\t\tif newestHead != \"\" {\n   798\t\t\t\tsubject.Head = newestHead\n   799\t\t\t}\n   800\t\t\tfor _, observed := range set.Paths {\n   801\t\t\t\tif observed.Action != \"renamed\" && supersededPaths[observed.Path] {\n   802\t\t\t\t\texcluded = append(excluded, ReviewBundleInput{Kind: \"superseded-path\", Path: observed.Path, Reason: \"a later attributed rename supplies the current review subject identity\"})\n   803\t\t\t\t\tcontinue\n   804\t\t\t\t}\n   805\t\t\t\tkey := observedKey(observed)\n   806\t\t\t\tif seen[key] {\n   807\t\t\t\t\tcontinue\n   808\t\t\t\t}\n   809\t\t\t\tseen[key] = true\n   810\t\t\t\tentry := ReviewBundleSubjectEntry{Action: observed.Action, Path: observed.Path, OldPath: observed.OldPath, NewPath: observed.NewPath}\n   811\t\t\t\tpath := observed.Path\n   812\t\t\t\tif observed.Action == \"renamed\" {\n   813\t\t\t\t\tpath = observed.NewPath\n   814\t\t\t\t}\n   815\t\t\t\tclass, include := reviewBundlePathClass(path, scope, components)\n   816\t\t\t\t// Git's answer wins over the path's shape. reviewBundlePathClass stays\n   817\t\t\t\t// a pure function of the path; being a gitlink is a fact about the\n   818\t\t\t\t// index that no path shape can express.\n   819\t\t\t\tgitlinkSHA := gitlinks[path]\n   820\t\t\t\tif gitlinkSHA != \"\" {\n   821\t\t\t\t\tclass, include = \"submodule\", true\n   822\t\t\t\t}\n   823\t\t\t\tswitch {\n   824\t\t\t\tcase class == \"\" && observed.Action == \"removed\":\n   825\t\t\t\t\t// A removal has no content to classify and none to read. The\n   826\t\t\t\t\t// reviewable fact is the deletion itself, and it is in the\n   827\t\t\t\t\t// subject either way — so refusing the whole bundle because the\n   828\t\t\t\t\t// shape rules do not recognise a path that no longer exists\n   829\t\t\t\t\t// costs the reviewer the entire review to tell them nothing.\n   830\t\t\t\t\tentry.Class, include = \"removed\", true\n   831\t\t\t\t\tentry.Reason = \"attributed removal of a path with no governed classification\"\n   832\t\t\t\tcase class == \"\":\n   833\t\t\t\t\tblockers = append(blockers, \"unclassified review subject path \"+path)\n   834\t\t\t\t\tentry.Class = \"unclassified\"\n   835\t\t\t\t\tentry.Reason = \"attributed path has no governed review classification\"\n   836\t\t\t\tcase gitlinkSHA != \"\":\n   837\t\t\t\t\tentry.Class = class\n   838\t\t\t\t\tentry.Reason = \"attributed submodule pinned to \" + gitlinkSHA\n   839\t\t\t\tdefault:\n   840\t\t\t\t\tentry.Class = class\n   841\t\t\t\t\tentry.Reason = \"attributed \" + class + \" path in the immutable change set\"\n   842\t\t\t\t}\n   843\t\t\t\tif !include {\n   844\t\t\t\t\texcluded = append(excluded, ReviewBundleInput{Kind: class, Path: path, Reason: \"attributed path is outside the semantic review subject\"})\n   845\t\t\t\t\tcontinue\n   846\t\t\t\t}\n   847\t\t\t\tif status == nil {\n   848\t\t\t\t\tstatus = takeWorkingTreeSnapshotIn(s.fsys(), s.Root)\n   849\t\t\t\t}\n   850\t\t\t\tif dirty, detail := status.change(path); dirty {\n   851\t\t\t\t\tblockers = append(blockers, \"review subject path \"+path+\" has working-tree-only content\"+detail)\n   852\t\t\t\t}\n   853\t\t\t\tif include && observed.Action != \"removed\" {\n   854\t\t\t\t\tif gitlinkSHA != \"\" {\n   855\t\t\t\t\t\t// The reviewable identity of a submodule is the commit it is\n   856\t\t\t\t\t\t// pinned to. There is no file to read: the path is a directory\n   857\t\t\t\t\t\t// in the working tree and a gitlink in the index.\n   858\t\t\t\t\t\tentry.Digest = digestBytes([]byte(gitlinkSHA))\n   859\t\t\t\t\t} else if digest, err := s.reviewBundleFileDigest(path, set, graph, observers[path]); err != nil {\n   860\t\t\t\t\t\tblockers = append(blockers, err.Error())\n   861\t\t\t\t\t} else {\n   862\t\t\t\t\t\tentry.Digest = digest\n   863\t\t\t\t\t}\n   864\t\t\t\t}\n   865\t\t\t\tsubject.Entries = append(subject.Entries, entry)\n   866\t\t\t}\n   867\t\t}\n   868\t\tsort.Slice(subject.Entries, func(i, j int) bool {\n   869\t\t\ta, b := subject.Entries[i], subject.Entries[j]\n   870\t\t\treturn a.Action+\"\\x00\"+a.Path+\"\\x00\"+a.OldPath+\"\\x00\"+a.NewPath < b.Action+\"\\x00\"+b.Path+\"\\x00\"+b.OldPath+\"\\x00\"+b.NewPath\n   871\t\t})\n   872\t\tpatchRaw, _ := json.Marshal(subject.Entries)\n   873\t\tsubject.PatchDigest = digestBytes(patchRaw)\n   874\t\ttreeEntries := make([]struct {\n   875\t\t\tPath, Digest string\n   876\t\t}, 0, len(subject.Entries))\n   877\t\tfor _, entry := range subject.Entries {\n   878\t\t\tpath := entry.Path\n   879\t\t\tif entry.NewPath != \"\" {\n   880\t\t\t\tpath = entry.NewPath\n   881\t\t\t}\n   882\t\t\ttreeEntries = append(treeEntries, struct{ Path, Digest string }{path, entry.Digest})\n   883\t\t}\n   884\t\ttreeRaw, _ := json.Marshal(treeEntries)\n   885\t\tsubject.TreeDigest = digestBytes(treeRaw)\n   886\t\tsubject.ImplementationDigest = reviewImplementationDigest(subject)\n   887\t\tsubject.Attribution = reviewBundleAttribution(s.fsys(), s.Root, sets, allowedSpecs, subject.Entries)\n   888\t\treturn subject, sortedBundleInputs(excluded), blockers, nil\n   889\t}\n   890\t\n   891\t// reviewImplementationDigest identifies the implementation content of a subject\n   892\t// and nothing else.\n   893\tfunc reviewImplementationDigest(subject ReviewBundleSubject) string {\n   894\t\t// Content only. Not the change-set ids, not base and head: a squash merge\n   895\t\t// or a rebase gives the same content a different SHA, and an implementation\n   896\t\t// identity that moved with the SHA would call that a different subject. It\n   897\t\t// is the same rule the bundle digest already follows, named once so an\n   898\t\t// observer outside the bundle can anchor on it.\n   899\t\traw, err := json.Marshal(struct {\n   900\t\t\tEntries     []ReviewBundleSubjectEntry `json:\"entries\"`\n   901\t\t\tPatchDigest string                     `json:\"patch_digest\"`\n   902\t\t\tTreeDigest  string                     `json:\"tree_digest\"`\n   903\t\t}{Entries: subject.Entries, PatchDigest: subject.PatchDigest, TreeDigest: subject.TreeDigest})\n   904\t\tif err != nil {\n   905\t\t\treturn \"\"\n   906\t\t}\n   907\t\treturn digestBytes(raw)\n   908\t}\n   909\t\n   910\t// reviewBundleRangeObservations counts, for each attributed change set, how\n   911\t// many commits its range spans against how many it attributes.\n   912\t//\n   913\t// The count needs Git, and Git is not always there — an exported tree, a unit\n   914\t// fixture. When it cannot be taken the observation is `unknown`, never `clean`,\n   915\t// because the whole purpose is to stop a range being read as an attribution.\n   916\tfunc (s Store) reviewBundleRangeObservations(ids []string, graph DeliveryIntegrityGraph) []ReviewBundleRangeObservation {\n   917\t\t// Resolved from the ids the subject sealed, so the observation always\n   918\t\t// describes the same change sets the review is about.\n   919\t\tbyID := map[string]ChangeSet{}\n   920\t\tfor _, set := range graph.ChangeSets {\n   921\t\t\tbyID[set.ID] = set\n   922\t\t}\n   923\t\tobservations := []ReviewBundleRangeObservation{}\n   924\t\tfor _, id := range ids {\n   925\t\t\tset, ok := byID[id]\n   926\t\t\tif !ok {\n   927\t\t\t\tobservations = append(observations, ReviewBundleRangeObservation{ChangeSet: id, State: \"unknown\", Reason: \"the change set is not present in the current integrity graph\"})\n   928\t\t\t\tcontinue\n   929\t\t\t}\n   930\t\t\tobservation := ReviewBundleRangeObservation{\n   931\t\t\t\tChangeSet:         set.ID,\n   932\t\t\t\tAttributedCommits: len(set.Commits),\n   933\t\t\t}\n   934\t\t\tswitch {\n   935\t\t\tcase set.ResolvedBase == \"\" || set.ResolvedHead == \"\":\n   936\t\t\t\tobservation.State = \"unknown\"\n   937\t\t\t\tobservation.Reason = \"the change set resolves no immutable range to count against\"\n   938\t\t\tdefault:\n   939\t\t\t\tcount, err := gitRevListCountIn(s.fsys(), s.Root, \"review\", set.ResolvedBase, set.ResolvedHead)\n   940\t\t\t\tswitch {\n   941\t\t\t\tcase err != nil:\n   942\t\t\t\t\tobservation.State = \"unknown\"\n   943\t\t\t\t\tobservation.Reason = \"the range could not be counted in this working tree\"\n   944\t\t\t\tcase len(set.Commits) == 0:\n   945\t\t\t\t\tobservation.State = \"unknown\"\n   946\t\t\t\t\tobservation.Reason = \"the change set attributes no commit to compare the range with\"\n   947\t\t\t\tcase count > len(set.Commits):\n   948\t\t\t\t\tobservation.State = \"contaminated\"\n   949\t\t\t\t\tobservation.RangeCommits = count\n   950\t\t\t\t\tobservation.UnattributedCommits = count - len(set.Commits)\n   951\t\t\t\t\tobservation.UnattributedSpecs, observation.UntrailedCommits = rangeUnattributedOwners(s.fsys(), s.Root, set)\n   952\t\t\t\t\tobservation.Reason = \"the range spans commits this change set does not attribute; its paths are attributed, its base..head is not\"\n   953\t\t\t\tdefault:\n   954\t\t\t\t\tobservation.State = \"clean\"\n   955\t\t\t\t\tobservation.RangeCommits = count\n   956\t\t\t\t}\n   957\t\t\t}\n   958\t\t\tobservations = append(observations, observation)\n   959\t\t}\n   960\t\tsort.Slice(observations, func(i, j int) bool { return observations[i].ChangeSet < observations[j].ChangeSet })\n   961\t\treturn observations\n   962\t}\n   963\t\n   964\t// rangeUnattributedOwners reads the trailers of the commits set's range spans\n   965\t// but does not attribute. It reports nothing when Git cannot answer: the\n   966\t// counts above already say the range is contaminated.\n   967\tfunc rangeUnattributedOwners(files Files, root string, set ChangeSet) ([]string, int) {\n   968\t\tattributed := map[string]bool{}\n   969\t\tfor _, commit := range set.Commits {\n   970\t\t\tattributed[commit] = true\n   971\t\t}\n   972\t\tvar out bytes.Buffer\n   973\t\tproducer := governanceProducerFromFiles(files, \"review\")\n   974\t\traw, err := captureGovernanceGit(files, root, producer, \"log\", \"--no-color\", \"--format=%x01%H%n%B%x02\", ChangeSetRange(set.ResolvedBase, set.ResolvedHead), \"--\")\n   975\t\tif err != nil || len(raw) > reviewAttributionMaxBytes {\n   976\t\t\treturn nil, 0\n   977\t\t}\n   978\t\tout.Write(raw)\n   979\t\tspecs := []string{}\n   980\t\tuntrailed := 0\n   981\t\tfor _, chunk := range strings.Split(out.String(), \"\\x01\") {\n   982\t\t\tend := strings.Index(chunk, \"\\x02\")\n   983\t\t\tnewline := strings.Index(chunk, \"\\n\")\n   984\t\t\tif end < 0 || newline < 0 || newline > end {\n   985\t\t\t\tcontinue\n   986\t\t\t}\n   987\t\t\tsha := strings.TrimSpace(chunk[:newline])\n   988\t\t\tif attributed[sha] {\n   989\t\t\t\tcontinue\n   990\t\t\t}\n   991\t\t\towned := false\n   992\t\t\tfor _, line := range strings.Split(chunk[newline+1:end], \"\\n\") {\n   993\t\t\t\tif spec, ok := strings.CutPrefix(strings.TrimSpace(line), \"POSE-Spec:\"); ok && strings.TrimSpace(spec) != \"\" {\n   994\t\t\t\t\towned = true\n   995\t\t\t\t\tif strings.TrimSpace(spec) != set.Spec {\n   996\t\t\t\t\t\tspecs = append(specs, strings.TrimSpace(spec))\n   997\t\t\t\t\t}\n   998\t\t\t\t}\n   999\t\t\t}\n  1000\t\t\tif !owned {\n  1001\t\t\t\tuntrailed++\n  1002\t\t\t}\n  1003\t\t}\n  1004\t\treturn uniqueSorted(specs), untrailed\n  1005\t}\n  1006\t\n  1007\tfunc gitRevListCount(root, base, head string) (int, error) {\n  1008\t\tout, err := gitCommand(\"-C\", root, \"rev-list\", \"--count\", ChangeSetRange(base, head), \"--\").Output()\n  1009\t\tif err != nil {\n  1010\t\t\treturn 0, err\n  1011\t\t}\n  1012\t\treturn strconv.Atoi(strings.TrimSpace(string(out)))\n  1013\t}\n  1014\t\n  1015\tfunc gitRevListCountIn(files Files, root, producer, base, head string) (int, error) {\n  1016\t\tproducer = governanceProducerFromFiles(files, producer)\n  1017\t\tout, err := captureGovernanceGit(files, root, producer, \"rev-list\", \"--count\", ChangeSetRange(base, head), \"--\")\n  1018\t\tif err != nil {\n  1019\t\t\treturn 0, err\n  1020\t\t}\n  1021\t\treturn strconv.Atoi(strings.TrimSpace(string(out)))\n  1022\t}\n  1023\t\n  1024\tfunc reduceReviewBundleChangeSets(sets []ChangeSet) []ChangeSet {\n  1025\t\tresult := make([]ChangeSet, 0, len(sets))\n  1026\t\tfor i, candidate := range sets {\n  1027\t\t\tcandidateCommits := map[string]bool{}\n  1028\t\t\tfor _, commit := range candidate.Commits {\n  1029\t\t\t\tcandidateCommits[commit] = true\n  1030\t\t\t}\n  1031\t\t\tsubsumed := false\n  1032\t\t\tif len(candidateCommits) > 0 {\n  1033\t\t\t\tfor j, other := range sets {\n  1034\t\t\t\t\tif i == j || len(other.Commits) <= len(candidate.Commits) {\n  1035\t\t\t\t\t\tcontinue\n  1036\t\t\t\t\t}\n  1037\t\t\t\t\tcontainsAll := true\n  1038\t\t\t\t\totherCommits := map[string]bool{}\n  1039\t\t\t\t\tfor _, commit := range other.Commits {\n  1040\t\t\t\t\t\totherCommits[commit] = true\n  1041\t\t\t\t\t}\n  1042\t\t\t\t\tfor commit := range candidateCommits {\n  1043\t\t\t\t\t\tif !otherCommits[commit] {\n  1044\t\t\t\t\t\t\tcontainsAll = false\n  1045\t\t\t\t\t\t\tbreak\n  1046\t\t\t\t\t\t}\n  1047\t\t\t\t\t}\n  1048\t\t\t\t\tif containsAll {\n  1049\t\t\t\t\t\tsubsumed = true\n  1050\t\t\t\t\t\tbreak\n  1051\t\t\t\t\t}\n  1052\t\t\t\t}\n  1053\t\t\t}\n  1054\t\t\tif !subsumed {\n  1055\t\t\t\tresult = append(result, candidate)\n  1056\t\t\t}\n  1057\t\t}\n  1058\t\treturn result\n  1059\t}\n  1060\t\n  1061\tfunc (s Store) reviewBundleScopeSpecs(scope ScopeRef) (map[string]bool, error) {\n  1062\t\tresult := map[string]bool{}\n  1063\t\tswitch scope.Kind {\n  1064\t\tcase \"spec\":\n  1065\t\t\tresult[scope.Slug] = true\n  1066\t\tcase \"milestone\":\n  1067\t\t\trm, err := s.GetRoadmap(scope.Roadmap)\n  1068\t\t\tif err != nil {\n  1069\t\t\t\treturn nil, err\n  1070\t\t\t}\n  1071\t\t\tfor _, milestone := range rm.Milestones {\n  1072\t\t\t\tif milestone.ID == scope.Milestone {\n  1073\t\t\t\t\tfor _, raw := range milestone.Specs {\n  1074\t\t\t\t\t\tif slug, external := s.milestoneMember(raw); !external {\n  1075\t\t\t\t\t\t\tresult[slug] = true\n  1076\t\t\t\t\t\t}\n  1077\t\t\t\t\t}\n  1078\t\t\t\t\treturn result, nil\n  1079\t\t\t\t}\n  1080\t\t\t}\n  1081\t\t\treturn nil, fmt.Errorf(\"pose: milestone %s/%s not found\", scope.Roadmap, scope.Milestone)\n  1082\t\tcase \"roadmap\":\n  1083\t\t\trm, err := s.GetRoadmap(scope.Slug)\n  1084\t\t\tif err != nil {\n  1085\t\t\t\treturn nil, err\n  1086\t\t\t}\n  1087\t\t\tfor _, milestone := range rm.Milestones {\n  1088\t\t\t\tfor _, raw := range milestone.Specs {\n  1089\t\t\t\t\tif slug, external := s.milestoneMember(raw); !external {\n  1090\t\t\t\t\t\tresult[slug] = true\n  1091\t\t\t\t\t}\n  1092\t\t\t\t}\n  1093\t\t\t}\n  1094\t\t}\n  1095\t\treturn result, nil\n  1096\t}\n  1097\t\n  1098\t// reviewBundleGitlinks maps each of the given paths that is a gitlink to the\n  1099\t// commit it is pinned to. Git records a submodule in the index with mode 160000\n  1100\t// and the commit id in place of a blob id, so that pointer is the only content a\n  1101\t// submodule has to review. Resolved in one call over the candidate set rather\n  1102\t// than one call per path, and bounded by the subject's own size.\n  1103\tfunc reviewBundleGitlinksIn(files Files, root string, paths []string) map[string]string {\n  1104\t\tlinks := map[string]string{}\n  1105\t\tif len(paths) == 0 {\n  1106\t\t\treturn links\n  1107\t\t}\n  1108\t\targs := append([]string{\"ls-files\", \"--stage\", \"--\"}, paths...)\n  1109\t\tproducer := governanceProducerFromFiles(files, \"review\")\n  1110\t\tout, err := captureGovernanceGit(files, root, producer, args...)\n  1111\t\tif err != nil {\n  1112\t\t\tif hasGitMetadataIn(FilesOrNative(files), root) {\n  1113\t\t\t\tmarkGovernanceReadUnknownForProject(files, root, \"\", producer, \"Git index entries could not be read while classifying review inputs\")\n  1114\t\t\t}\n  1115\t\t\t// Unit fixtures and exported source trees may not have Git metadata. A\n  1116\t\t\t// path that cannot be resolved keeps its shape-based class and fails\n  1117\t\t\t// closed downstream if it has no readable content.\n  1118\t\t\treturn links\n  1119\t\t}\n  1120\t\tfor _, line := range strings.Split(string(out), \"\\n\") {\n  1121\t\t\ttab := strings.IndexByte(line, '\\t')\n  1122\t\t\tif tab < 0 {\n  1123\t\t\t\tcontinue\n  1124\t\t\t}\n  1125\t\t\tfields := strings.Fields(line[:tab])\n  1126\t\t\tif len(fields) < 2 || fields[0] != \"160000\" {\n  1127\t\t\t\tcontinue\n  1128\t\t\t}\n  1129\t\t\tlinks[filepath.ToSlash(line[tab+1:])] = fields[1]\n  1130\t\t}\n  1131\t\treturn links\n  1132\t}\n  1133\t\n  1134\t// reviewBundleGitlinks reads the filesystem directly; reviewBundleGitlinksIn reads the operation's files.\n  1135\tfunc reviewBundleGitlinks(root string, paths []string) map[string]string {\n  1136\t\treturn reviewBundleGitlinksIn(NativeFiles(), root, paths)\n  1137\t}\n  1138\t\n  1139\tfunc reviewBundleWorkingTreeChangeIn(files Files, root, path string) (bool, string) {\n  1140\t\tentries, err := readGitStatusGovernedIn(files, root, \"review\", path)\n  1141\t\tif errors.Is(err, ErrGitUnavailable) {\n  1142\t\t\t// Unit fixtures and exported source trees may not have Git metadata. The\n  1143\t\t\t// immutable change-set gate remains authoritative there.\n  1144\t\t\treturn false, \"\"\n  1145\t\t}\n  1146\t\tif err != nil {\n  1147\t\t\t// A status that could not be read does not say the path is unchanged.\n  1148\t\t\treturn true, \" (git status unknown: \" + err.Error() + \")\"\n  1149\t\t}\n  1150\t\tif len(entries) == 0 {\n  1151\t\t\treturn false, \"\"\n  1152\t\t}\n  1153\t\treturn true, statusDetail(strings.TrimSpace(entries[0].XY))\n  1154\t}\n  1155\t\n  1156\t// reviewBundleWorkingTreeChange reads the filesystem directly; reviewBundleWorkingTreeChangeIn reads the operation's files.\n  1157\tfunc reviewBundleWorkingTreeChange(root, path string) (bool, string) {\n  1158\t\treturn reviewBundleWorkingTreeChangeIn(NativeFiles(), root, path)\n  1159\t}\n  1160\t\n  1161\t// ReviewSubjectPathClass is the review-subject class of a path outside any\n  1162\t// scope's own files, \"\" when the path is unclassified and a seal would refuse\n  1163\t// it. Tests outside this package use it to guard what the engine writes.\n  1164\tfunc ReviewSubjectPathClass(path string) string {\n  1165\t\tclass, _ := reviewBundlePathClass(path, ScopeRef{Kind: \"spec\", Slug: \"\\x00none\"}, nil)\n  1166\t\treturn class\n  1167\t}\n  1168\t\n  1169\tfunc reviewBundlePathClass(path string, scope ScopeRef, components []ReviewPlanComponent) (string, bool) {\n  1170\t\tpath = filepath.ToSlash(filepath.Clean(path))\n  1171\t\tif path == \".\" || path == \"\" {\n  1172\t\t\treturn \"\", false\n  1173\t\t}\n  1174\t\tif scope.Kind == \"spec\" && (path == \".pose/specs/\"+scope.Slug+\"/spec.md\" || path == \".pose/specs/\"+scope.Slug+\".md\" || strings.HasPrefix(path, \".pose/specs/\"+scope.Slug+\"/\")) {\n  1175\t\t\treturn \"semantic-scope\", false\n  1176\t\t}\n  1177\t\tif strings.HasPrefix(path, \".pose/specs/\") {\n  1178\t\t\treturn \"semantic-scope\", false\n  1179\t\t}\n  1180\t\t// The capability history appends snapshots taken from the assessment, so\n  1181\t\t// it carries nothing a reviewer must judge apart from it. The assessment\n  1182\t\t// itself is classified with the governance records below.\n  1183\t\tif path == \".pose/capabilities/history.jsonl\" {\n  1184\t\t\treturn \"derived-evidence\", false\n  1185\t\t}\n  1186\t\t// .pose/review-runs/ records delegated review runs, .pose/delegate-runs/\n  1187\t\t// the task runs kept with --record (spec pose-delegation-task),\n  1188\t\t// .pose/review-conclusions/ what the engine did with a run's conclusion\n  1189\t\t// (spec pose-delegated-review-conclusions), .pose/adjudications/ the\n  1190\t\t// verdicts of adjudication runs (spec pose-delegated-verdict-destinations), .pose/events/ DORA\n  1191\t\t// events and .pose/investigations/ investigation notes: evidence about\n  1192\t\t// work, like reviews (spec pose-review-subject-classifies-engine-records).\n  1193\t\t// .pose/telemetry.json, .pose/continuous-closeout.json and\n  1194\t\t// .pose/pose-validate.log are operational state: an opt-in switch, a\n  1195\t\t// running closeout session and a log.\n  1196\t\tswitch path {\n  1197\t\tcase \".pose/telemetry.json\", \".pose/continuous-closeout.json\", \".pose/pose-validate.log\":\n  1198\t\t\treturn \"derived-evidence\", false\n  1199\t\tcase \".pose/LICENSE\", \".pose/NOTICE\":\n  1200\t\t\t// The distribution's license terms, copied by install; classified\n  1201\t\t\t// like the repository's own LICENSE and NOTICE (found in review).\n  1202\t\t\treturn \"documentation\", true\n  1203\t\t}\n  1204\t\tfor _, prefix := range []string{\".pose/state/\", \".pose/assessments/\", \".pose/reports/\", \".pose/results/\", \".pose/reviews/\", \".pose/review-bundles/\", \".pose/review-attestations/\", \".pose/review-attribution-supplements/\", \".pose/closeout-plans/\", \".pose/contributions/\", \".pose/feedback/\", \".pose/review-runs/\", \".pose/review-attempts/\", \".pose/review-run-ledger/\", \".pose/review-continuations/\", \".pose/review-private/\", \".pose/review-run-proofs/\", \".pose/delegate-runs/\", \".pose/review-conclusions/\", \".pose/review-closeouts/\", \".pose/adjudications/\", \".pose/events/\", \".pose/investigations/\"} {\n  1205\t\t\tif strings.HasPrefix(path, prefix) {\n  1206\t\t\t\treturn \"derived-evidence\", false\n  1207\t\t\t}\n  1208\t\t}\n  1209\t\tfor _, exact := range []string{\".pose/indexes/delivery-integrity.json\", \".pose/indexes/releases.json\", \".pose/indexes/spec-graph.json\"} {\n  1210\t\t\tif path == exact {\n  1211\t\t\t\treturn \"derived-index\", false\n  1212\t\t\t}\n  1213\t\t}\n  1214\t\tfor _, exact := range []string{\".pose/indexes/validation-matrix.json\", \".pose/indexes/module-metadata.json\", \".pose/indexes/task-map.json\", \".pose/indexes/repo-map.json\"} {\n  1215\t\t\tif path == exact {\n  1216\t\t\t\treturn \"governance\", true\n  1217\t\t\t}\n  1218\t\t}\n  1219\t\tif strings.HasPrefix(path, \".pose/indexes/\") {\n  1220\t\t\treturn \"derived-index\", false\n  1221\t\t}\n  1222\t\t// Client aliases are authored governance, not generated evidence. Only a\n  1223\t\t// single skill name is classified; its link is validated when hashed.\n  1224\t\tif reviewBundleClaudeSkillAlias(path) {\n  1225\t\t\treturn \"governance\", true\n  1226\t\t}\n  1227\t\t// .pose/public/ holds the public claims contract (spec\n  1228\t\t// pose-public-claims-contract): what the project asserts about itself in\n  1229\t\t// public. It is authored policy, not derived output, so a change to it\n  1230\t\t// belongs in the review subject exactly like a rule or a workflow.\n  1231\t\t// The transfer lock is runtime state, never an authority record.\n  1232\t\tif path == \".pose/transfers/.authority-transfer.lock\" {\n  1233\t\t\treturn \"derived-evidence\", false\n  1234\t\t}\n  1235\t\t// A start lock is runtime state too: it names the call that holds it,\n  1236\t\t// never what was started (spec pose-journal-checkpoint-and-lock-recovery).\n  1237\t\tif strings.HasPrefix(path, \".pose/starts/.\") && strings.HasSuffix(path, \".lock\") {\n  1238\t\t\treturn \"derived-evidence\", false\n  1239\t\t}\n  1240\t\t// .pose/transfers/ holds transfer and reconciliation plans, receipts,\n  1241\t\t// archived sources and redirects: the record of who owns a spec.\n  1242\t\t// .pose/actions/ holds action request journals: decisions, approvals and\n  1243\t\t// their answers, which restrict phases (spec pose-action-requests).\n  1244\t\t// .pose/capabilities/ holds the capability assessment, whose bullets are\n  1245\t\t// the authority on each mechanism's state (spec\n  1246\t\t// review-subject-classifies-capabilities).\n  1247\t\t// .pose/starts/ holds atomic start records: the baseline a started spec is\n  1248\t\t// reconciled against (spec pose-atomic-start-adoption-cutoff).\n  1249\t\t// .pose/review-ledgers/ holds signed legacy ledgers, which decide which\n  1250\t\t// unsigned attestations stay trusted; `pose adopt` writes them, and a scope\n  1251\t\t// that carried one could not be sealed (spec\n  1252\t\t// pose-review-subject-classifies-engine-records). .pose/schema-version is\n  1253\t\t// the instance's schema stamp. .pose/usage/ holds the usage verdict\n  1254\t\t// journal, reviewed in Git (ADR 2026-10-01-reviewable-usage-verdict-journal).\n  1255\t\t// .pose/policy-migrations/ keeps a policy file pose update converted, which\n  1256\t\t// still carries the baseline of runs recorded before it (spec\n  1257\t\t// pose-delegation-surface D7).\n  1258\t\t// .pose/parity/ holds the authored parity matrices a retirement is gated\n  1259\t\t// by (spec pose-delegation-parity-gate R1).\n  1260\t\tif path == \".pose/schema-version\" {\n  1261\t\t\treturn \"governance\", true\n  1262\t\t}\n  1263\t\tfor _, prefix := range []string{\".pose/policy/\", \".pose/public/\", \".pose/releases/\", \".pose/review-profiles/\", \".pose/rules/\", \".pose/workflows/\", \".pose/roadmaps/\", \".agents/skills/\", \"extensions/\", \".pose/changelogs/\", \".pose/adr/\", \".pose/knowledge/\", \".pose/templates/\", \".pose/transfers/\", \".pose/capabilities/\", \".pose/actions/\", \".pose/starts/\", \".pose/review-ledgers/\", \".pose/usage/\", \".pose/policy-migrations/\", \".pose/parity/\"} {\n  1264\t\t\tif strings.HasPrefix(path, prefix) {\n  1265\t\t\t\treturn \"governance\", true\n  1266\t\t\t}\n  1267\t\t}\n  1268\t\t// composition-contract.json joins the list for the same reason compatibility.json\n  1269\t\t// is on it: both are published root manifests describing what this repository\n  1270\t\t// exposes, and a change to either is a governance change. Without it, a spec that\n  1271\t\t// adds an environment variable — which the composition contract enumerates —\n  1272\t\t// could not seal a review bundle at all, because the classifier refuses an\n  1273\t\t// unclassified subject path rather than guessing at one.\n  1274\t\t// The root .env.example is an authored configuration example. Keep it in\n  1275\t\t// the subject for byte-level review without classifying secret-bearing .env.\n  1276\t\tfor _, exact := range []string{\".pose/docs.json\", \".pose/docs-review.jsonl\", \".pose/release-policy.json\", \".pose/project.json\", \".env.example\", \".gitleaks.toml\", \".gitleaksignore\", \"compatibility.json\", \"composition-contract.json\", \"pose-mcp/server.json\"} {\n  1277\t\t\tif path == exact {\n  1278\t\t\t\treturn \"governance\", true\n  1279\t\t\t}\n  1280\t\t}\n  1281\t\tbaseName := filepath.Base(path)\n  1282\t\tmanifestNames := map[string]bool{\n  1283\t\t\t\"go.mod\": true, \"go.sum\": true, \"go.work\": true, \"go.work.sum\": true,\n  1284\t\t\t\"package.json\": true, \"package-lock.json\": true, \"pnpm-lock.yaml\": true, \"yarn.lock\": true, \"bun.lockb\": true,\n  1285\t\t\t\"Cargo.toml\": true, \"Cargo.lock\": true,\n  1286\t\t\t\"pyproject.toml\": true, \"poetry.lock\": true, \"requirements.txt\": true, \"Pipfile\": true, \"Pipfile.lock\": true, \"setup.py\": true, \"setup.cfg\": true,\n  1287\t\t\t\"pom.xml\": true, \"build.gradle\": true, \"build.gradle.kts\": true, \"settings.gradle\": true, \"settings.gradle.kts\": true,\n  1288\t\t\t\"CMakeLists.txt\": true, \"Makefile\": true, \"Dockerfile\": true, \"docker-compose.yml\": true, \"docker-compose.yaml\": true, \"compose.yaml\": true, \"compose.yml\": true,\n  1289\t\t\t\"tsconfig.json\": true, \"jsconfig.json\": true, \"turbo.json\": true, \"biome.json\": true,\n  1290\t\t\t\".gitignore\": true, \".gitattributes\": true, \".editorconfig\": true, \".mcp.json\": true,\n  1291\t\t\t\".golangci.yml\": true, \".golangci.yaml\": true, \"buf.yaml\": true, \"buf.gen.yaml\": true,\n  1292\t\t\t\".pre-commit-config.yaml\": true, \".goreleaser.yaml\": true, \".goreleaser.yml\": true,\n  1293\t\t}\n  1294\t\tif manifestNames[baseName] || strings.HasPrefix(baseName, \".eslintrc\") || strings.HasPrefix(baseName, \".prettierrc\") || strings.HasPrefix(baseName, \"vite.config.\") || strings.HasPrefix(baseName, \"webpack.config.\") || strings.HasPrefix(baseName, \"rollup.config.\") || strings.HasPrefix(baseName, \"next.config.\") {\n  1295\t\t\treturn \"governance\", true\n  1296\t\t}\n  1297\t\tif !strings.Contains(path, \"/\") {\n  1298\t\t\tbaseLower := strings.ToLower(path)\n  1299\t\t\tif strings.HasSuffix(baseLower, \".md\") || strings.HasSuffix(baseLower, \".txt\") || strings.HasPrefix(baseLower, \"license\") || baseLower == \"notice\" {\n  1300\t\t\t\treturn \"documentation\", true\n  1301\t\t\t}\n  1302\t\t}\n  1303\t\tfor _, component := range components {\n  1304\t\t\troot := strings.TrimSuffix(filepath.ToSlash(filepath.Clean(component.Path)), \"/\")\n  1305\t\t\tif root == \".\" || root == \"\" {\n  1306\t\t\t\tif !strings.HasPrefix(path, \".pose/\") && !strings.HasPrefix(path, \".git/\") {\n  1307\t\t\t\t\treturn \"implementation\", true\n  1308\t\t\t\t}\n  1309\t\t\t} else if path == root || strings.HasPrefix(path, root+\"/\") {\n  1310\t\t\t\treturn \"implementation\", true\n  1311\t\t\t}\n  1312\t\t}\n  1313\t\tif strings.HasPrefix(path, \"docs/decisions/\") {\n  1314\t\t\treturn \"governance\", true\n  1315\t\t}\n  1316\t\tif strings.HasPrefix(path, \"docs-site/docs/\") || strings.HasPrefix(path, \"docs/\") || strings.HasPrefix(path, \"locales/\") {\n  1317\t\t\treturn \"documentation\", true\n  1318\t\t}\n  1319\t\tfor _, prefix := range []string{\"pose-mcp/\", \"mcp-enforce/\", \"docs-site/\", \"locales/\", \"scripts/\", \"tests/\", \".github/\", \"cmd/\", \"internal/\", \"pkg/\", \"src/\", \"lib/\", \"app/\", \"api/\"} {\n  1320\t\t\tif strings.HasPrefix(path, prefix) {\n  1321\t\t\t\treturn \"implementation\", true\n  1322\t\t\t}\n  1323\t\t}\n  1324\t\treturn \"\", false\n  1325\t}\n  1326\t\n  1327\t// reviewBundleFileDigest reads rel for set; owners are the specs of every\n  1328\t// selected change set that observes the path, all of which an absent path's\n  1329\t// removal must supersede.\n  1330\tfunc (s Store) reviewBundleFileDigest(rel string, set ChangeSet, graph DeliveryIntegrityGraph, owners []string) (string, error) {\n  1331\t\tif reviewBundleClaudeSkillAlias(rel) {\n  1332\t\t\treturn s.reviewBundleClaudeSkillDigest(rel)\n  1333\t\t}\n  1334\t\tif err := ValidateArtifactPathIn(s.fsys(), s.Root, rel, false); err != nil {\n  1335\t\t\treturn \"\", fmt.Errorf(\"review subject path %s is invalid: %w\", rel, err)\n  1336\t\t}\n  1337\t\tclean, _ := validateArtifactPathSyntax(rel)\n  1338\t\traw, err := s.fsys().ReadFile(filepath.Join(s.Root, clean))\n  1339\t\tif os.IsNotExist(err) && strings.HasPrefix(filepath.ToSlash(clean), pendingFragmentDir) {\n  1340\t\t\t// Archival changes the physical location, not the attributed subject\n  1341\t\t\t// path. The existing ledger supplies the owning spec and frozen bytes;\n  1342\t\t\t// both witnesses must also belong to the selected committed head.\n  1343\t\t\tledger := newArchivalLedger(LoadArchivedFragmentsIn(s.fsys(), s.Root), func(path string) bool {\n  1344\t\t\t\treturn s.reviewBundleCommittedArchive(path)\n  1345\t\t\t})\n  1346\t\t\tpending := filepath.ToSlash(clean)\n  1347\t\t\tvar notes []string\n  1348\t\t\tresolved := false\n  1349\t\t\tfor _, owner := range s.reviewBundleFragmentOwners(set, graph, pending) {\n  1350\t\t\t\tif witness, note, ok := ledger.resolve(owner, pending, \"\"); ok {\n  1351\t\t\t\t\traw, err = s.fsys().ReadFile(filepath.Join(s.Root, filepath.FromSlash(witness.Archived)))\n  1352\t\t\t\t\tresolved = true\n  1353\t\t\t\t\tbreak\n  1354\t\t\t\t} else {\n  1355\t\t\t\t\tnotes = append(notes, note)\n  1356\t\t\t\t}\n  1357\t\t\t}\n  1358\t\t\tif !resolved {\n  1359\t\t\t\treturn \"\", fmt.Errorf(\"review subject path %s has no committed release archival: %s\", rel, strings.Join(uniqueSorted(notes), \"; \"))\n  1360\t\t\t}\n  1361\t\t}\n  1362\t\tif os.IsNotExist(err) {\n  1363\t\t\t// A later spec's observed removal is the path's reviewable identity\n  1364\t\t\t// for the specs it supersedes, as the delivery graph already accepts\n  1365\t\t\t// it (spec pose-review-subject-later-removal R1–R2).\n  1366\t\t\tif witness, ok := reviewBundleRemovalWitness(graph, filepath.ToSlash(clean), owners); ok {\n  1367\t\t\t\tif why := s.removalWitnessStale(filepath.ToSlash(clean), graph, owners); why != \"\" {\n  1368\t\t\t\t\treturn \"\", fmt.Errorf(\"review subject path %s reads as a later removal that no longer holds: %s; run pose index\", rel, why)\n  1369\t\t\t\t}\n  1370\t\t\t\treturn digestBytes([]byte(witness)), nil\n  1371\t\t\t}\n  1372\t\t}\n  1373\t\tif err != nil {\n  1374\t\t\treturn \"\", fmt.Errorf(\"review subject path %s cannot be read: %w\", rel, err)\n  1375\t\t}\n  1376\t\treturn digestBytes(bytes.ReplaceAll(raw, []byte(\"\\r\\n\"), []byte(\"\\n\"))), nil\n  1377\t}\n  1378\t\n  1379\t// A squash can attribute the same path to multiple specs. The owning release\n  1380\t// witness can name one of those specs, but a dependency or matching filename\n  1381\t// alone is not proof: require a shared attributed commit and observed path.\n  1382\t// reviewBundleRemovalWitness is the identity of a path a later spec removed:\n  1383\t// for each of owners, the removing spec and the deleting commit the delivery\n  1384\t// graph accepted for that very spec, never another's (SR-R1-01). It is false\n  1385\t// unless every owner has such a removal by a spec other than itself\n  1386\t// (SR-R1-02).\n  1387\tfunc reviewBundleRemovalWitness(graph DeliveryIntegrityGraph, path string, owners []string) (string, bool) {\n  1388\t\tvar lines []string\n  1389\t\tfor _, owner := range uniqueSorted(owners) {\n  1390\t\t\tfound := \"\"\n  1391\t\t\tfor _, removal := range graph.Removals {\n  1392\t\t\t\tif removal.Path == path && removal.Spec != owner && removal.Supersedes[owner] != \"\" {\n  1393\t\t\t\t\tfound = \"removed-by \" + removal.Spec + \" \" + removal.Supersedes[owner]\n  1394\t\t\t\t\tbreak\n  1395\t\t\t\t}\n  1396\t\t\t}\n  1397\t\t\tif owner == \"\" || found == \"\" {\n  1398\t\t\t\treturn \"\", false\n  1399\t\t\t}\n  1400\t\t\tlines = append(lines, found)\n  1401\t\t}\n  1402\t\tif len(lines) == 0 {\n  1403\t\t\treturn \"\", false\n  1404\t\t}\n  1405\t\treturn strings.Join(uniqueSorted(lines), \"\\n\"), true\n  1406\t}\n  1407\t\n  1408\t// removalWitnessStale says why path's removal for owners no longer holds in\n  1409\t// raw history, or nothing when it does: its deleting commit must be on HEAD,\n  1410\t// with no commit after it touching the path. The graph that accepted the\n  1411\t// removal is not bound to Git, so this is asked at the moment the witness\n  1412\t// counts (spec pose-removal-witness-freshness R1-R2, D1).\n  1413\tfunc (s Store) removalWitnessStale(path string, graph DeliveryIntegrityGraph, owners []string) string {\n  1414\t\tchecked := map[string]bool{}\n  1415\t\tfor _, removal := range graph.Removals {\n  1416\t\t\tif removal.Path != path {\n  1417\t\t\t\tcontinue\n  1418\t\t\t}\n  1419\t\t\tfor _, owner := range owners {\n  1420\t\t\t\tcommit := removal.Supersedes[owner]\n  1421\t\t\t\tif commit == \"\" || checked[commit] {\n  1422\t\t\t\t\tcontinue\n  1423\t\t\t\t}\n  1424\t\t\t\tchecked[commit] = true\n  1425\t\t\t\tif why := s.removalCommitStale(path, commit); why != \"\" {\n  1426\t\t\t\t\treturn why\n  1427\t\t\t\t}\n  1428\t\t\t}\n  1429\t\t}\n  1430\t\treturn \"\"\n  1431\t}\n  1432\t\n  1433\tfunc (s Store) removalCommitStale(path, commit string) string {\n  1434\t\tfiles := s.fsys()\n  1435\t\tproducer := governanceProducerFromFiles(files, \"review\")\n  1436\t\t_, err := captureGovernanceGit(files, s.Root, producer, \"merge-base\", \"--is-ancestor\", commit, \"HEAD\")\n  1437\t\tvar exit *exec.ExitError\n  1438\t\tif errors.As(err, &exit) && exit.ExitCode() == 1 {\n  1439\t\t\treturn \"its deleting commit \" + commit + \" is not on HEAD\"\n  1440\t\t}\n  1441\t\tif err != nil {\n  1442\t\t\treturn \"its deleting commit \" + commit + \" cannot be read: \" + err.Error()\n  1443\t\t}\n  1444\t\tout, err := captureGovernanceGit(files, s.Root, producer, \"--literal-pathspecs\", \"rev-list\", \"-1\", \"--full-history\", commit+\"..HEAD\", \"--\", path)\n  1445\t\tif err != nil {\n  1446\t\t\treturn \"the history after its deleting commit \" + commit + \" cannot be read: \" + err.Error()\n  1447\t\t}\n  1448\t\tif later := strings.TrimSpace(string(out)); later != \"\" {\n  1449\t\t\treturn \"commit \" + later + \" touches it after its deleting commit \" + commit\n  1450\t\t}\n  1451\t\t// An empty answer proves nothing about history a shallow clone lacks.\n  1452\t\tshallow, err := captureGovernanceGit(files, s.Root, producer, \"rev-parse\", \"--is-shallow-repository\")\n  1453\t\tif err != nil {\n  1454\t\t\treturn \"the history after its deleting commit \" + commit + \" cannot be read: \" + err.Error()\n  1455\t\t}\n  1456\t\tif strings.TrimSpace(string(shallow)) != \"false\" {\n  1457\t\t\treturn \"this clone is shallow, so the history after its deleting commit \" + commit + \" is incomplete\"\n  1458\t\t}\n  1459\t\treturn \"\"\n  1460\t}\n  1461\t\n  1462\tfunc (s Store) reviewBundleFragmentOwners(set ChangeSet, graph DeliveryIntegrityGraph, pending string) []string {\n  1463\t\towners := []string{set.Spec}\n  1464\t\tcommits := map[string]bool{}\n  1465\t\tfor _, commit := range set.Commits {\n  1466\t\t\tif commit != \"\" {\n  1467\t\t\t\tcommits[commit] = true\n  1468\t\t\t}\n  1469\t\t}\n  1470\t\tfor _, other := range graph.ChangeSets {\n  1471\t\t\tif other.Spec == \"\" || other.Spec == set.Spec {\n  1472\t\t\t\tcontinue\n  1473\t\t\t}\n  1474\t\t\tshared := false\n  1475\t\t\tfor _, commit := range other.Commits {\n  1476\t\t\t\tif commits[commit] && s.reviewBundleCommitChangedPath(commit, pending) {\n  1477\t\t\t\t\tshared = true\n  1478\t\t\t\t\tbreak\n  1479\t\t\t\t}\n  1480\t\t\t}\n  1481\t\t\tif !shared {\n  1482\t\t\t\tcontinue\n  1483\t\t\t}\n  1484\t\t\tfor _, observed := range other.Paths {\n  1485\t\t\t\tif observed.Path == pending && (observed.Action == \"created\" || observed.Action == \"modified\") {\n  1486\t\t\t\t\towners = append(owners, other.Spec)\n  1487\t\t\t\t\tbreak\n  1488\t\t\t\t}\n  1489\t\t\t}\n  1490\t\t}\n  1491\t\treturn uniqueSorted(owners)\n  1492\t}\n  1493\t\n  1494\tfunc (s Store) reviewBundleCommitChangedPath(commit, path string) bool {\n  1495\t\t// Attribution uses full object IDs. Never resolve a mutable ref or an\n  1496\t\t// option supplied through a stale/malformed integrity graph.\n  1497\t\tif len(commit) != 40 && len(commit) != 64 {\n  1498\t\t\treturn false\n  1499\t\t}\n  1500\t\tfor _, c := range commit {\n  1501\t\t\tif !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {\n  1502\t\t\t\treturn false\n  1503\t\t\t}\n  1504\t\t}\n  1505\t\tpaths, ok := commitChangedPathsGovernedIn(s.fsys(), s.Root, \"review\", commit)\n  1506\t\treturn ok && paths[path]\n  1507\t}\n  1508\t\n  1509\tfunc (s Store) reviewBundleCommittedArchive(rel string) bool {\n  1510\t\tfiles := s.fsys()\n  1511\t\tproducer := governanceProducerFromFiles(files, \"review\")\n  1512\t\tpath := filepath.Join(s.Root, filepath.FromSlash(rel))\n  1513\t\tresolved, err := files.EvalSymlinks(path)\n  1514\t\tif err != nil {\n  1515\t\t\treturn false\n  1516\t\t}\n  1517\t\tinside, err := filepath.Rel(s.Root, resolved)\n  1518\t\tif err != nil || inside == \"..\" || strings.HasPrefix(inside, \"..\"+string(os.PathSeparator)) {\n  1519\t\t\treturn false\n  1520\t\t}\n  1521\t\tif dirty, _ := reviewBundleWorkingTreeChangeIn(files, s.Root, rel); dirty {\n  1522\t\t\treturn false\n  1523\t\t}\n  1524\t\tcommitted, err := captureGovernanceGit(files, s.Root, producer, \"show\", \"HEAD:\"+rel)\n  1525\t\tif err != nil {\n  1526\t\t\tif hasGitMetadataIn(files, s.Root) {\n  1527\t\t\t\tmarkGovernanceReadUnknownForProject(files, s.Root, \"\", producer, \"archived review input could not be checked against HEAD\")\n  1528\t\t\t}\n  1529\t\t\treturn false\n  1530\t\t}\n  1531\t\traw, err := files.ReadFile(path)\n  1532\t\treturn err == nil && bytes.Equal(raw, committed)\n  1533\t}\n  1534\t\n  1535\t// staleEvidenceWarnings names evidence that ran against a commit other than the\n  1536\t// head this bundle approves.\n  1537\t//\n  1538\t// A warning, not a blocker. `deliveryEvidenceCurrent` already decides what\n  1539\t// counts as current, and it accepts a result whose provenance digest matches the\n  1540\t// graph or whose scope is closed — legitimately, since re-running every check to\n  1541\t// re-seal a finished spec would be theatre. What it does not do is say so, and a\n  1542\t// reviewer reading a sealed bundle cannot tell a result produced against this\n  1543\t// subject from one carried forward.\n  1544\t//\n  1545\t// That distinction is the whole question an attestation answers, so it belongs\n  1546\t// where the reviewer sees it rather than inferred from two commit hashes nobody\n  1547\t// compares.\n  1548\tfunc staleEvidenceWarnings(subject ReviewBundleSubject, evidence []ReviewBundleEvidence) []string {\n  1549\t\tcarried := []string{}\n  1550\t\tunknown := []string{}\n  1551\t\tfor _, ev := range evidence {\n  1552\t\t\tswitch ReviewEvidenceObservationForSubject(subject, ev) {\n  1553\t\t\tcase \"carried-forward\":\n  1554\t\t\t\tcarried = append(carried, ev.EvidenceClass+\":\"+ev.ID)\n  1555\t\t\tcase \"unknown\":\n  1556\t\t\t\tunknown = append(unknown, ev.EvidenceClass+\":\"+ev.ID)\n  1557\t\t\t}\n  1558\t\t}\n  1559\t\twarnings := []string{}\n  1560\t\tif len(carried) > 0 {\n  1561\t\t\tsort.Strings(carried)\n  1562\t\t\twarnings = append(warnings, \"sealed evidence ran against a commit other than the subject head \"+shortCommit(subject.Head)+\n  1563\t\t\t\t\"; it is current by provenance, not by having observed this change: \"+strings.Join(carried, \", \"))\n  1564\t\t}\n  1565\t\t// The third state, which used to be silently folded into the first two. A\n  1566\t\t// result carrying no commit says nothing about which content it observed,\n  1567\t\t// and a reviewer reading a clean bundle had no way to tell that apart from\n  1568\t\t// a result that did observe this change.\n  1569\t\tif len(unknown) > 0 {\n  1570\t\t\tsort.Strings(unknown)\n  1571\t\t\twarnings = append(warnings, \"sealed evidence names no commit, so which content it observed is unknown rather than current: \"+strings.Join(unknown, \", \"))\n  1572\t\t}\n  1573\t\treturn warnings\n  1574\t}\n  1575\t\n  1576\t// rangeObservationWarnings reports a change set whose range spans commits it\n  1577\t// does not attribute, so nobody reads base..head as this scope's work.\n  1578\tfunc rangeObservationWarnings(observations []ReviewBundleRangeObservation) []string {\n  1579\t\twarnings := []string{}\n  1580\t\tfor _, observation := range observations {\n  1581\t\t\tswitch observation.State {\n  1582\t\t\tcase \"contaminated\":\n  1583\t\t\t\towners := \"\"\n  1584\t\t\t\tif len(observation.UnattributedSpecs) > 0 {\n  1585\t\t\t\t\towners = \"; they carry trailers of \" + strings.Join(observation.UnattributedSpecs, \", \")\n  1586\t\t\t\t}\n  1587\t\t\t\tif observation.UntrailedCommits > 0 {\n  1588\t\t\t\t\towners += fmt.Sprintf(\"; %d carry no POSE-Spec trailer\", observation.UntrailedCommits)\n  1589\t\t\t\t}\n  1590\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"change set %s attributes %d commit(s) but its range spans %d; %d commit(s) in base..head belong to other work%s, so the range is provenance and the attributed paths are the subject\",\n  1591\t\t\t\t\tobservation.ChangeSet, observation.AttributedCommits, observation.RangeCommits, observation.UnattributedCommits, owners))\n  1592\t\t\tcase \"unknown\":\n  1593\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"change set %s could not have its range counted: %s\", observation.ChangeSet, observation.Reason))\n  1594\t\t\t}\n  1595\t\t}\n  1596\t\treturn warnings\n  1597\t}\n  1598\t\n  1599\tfunc shortCommit(commit string) string {\n  1600\t\tif len(commit) > 12 {\n  1601\t\t\treturn commit[:12]\n  1602\t\t}\n  1603\t\treturn commit\n  1604\t}\n  1605\t\n  1606\tfunc (s Store) reviewBundleEvidence(scope ScopeRef, graph DeliveryIntegrityGraph, subject ReviewBundleSubject, plan ReviewBundlePlan) []ReviewBundleEvidence {\n  1607\t\tmodules := map[string]bool{}\n  1608\t\tfor _, target := range graph.Deliveries {\n  1609\t\t\tif scope.Kind == \"spec\" && target.Spec == scope.Slug {\n  1610\t\t\t\tmodules[target.Module] = true\n  1611\t\t\t}\n  1612\t\t}\n  1613\t\t// A per-component validate tool answers for its module. When the targets\n  1614\t\t// live elsewhere, sealing only their modules would leave the plan demanding\n  1615\t\t// a disposition that no sealed evidence can support, so the modules those\n  1616\t\t// tools name are sealed too. With no target at all every module already is.\n  1617\t\tif len(modules) > 0 {\n  1618\t\t\tfor _, tool := range plan.Tools {\n  1619\t\t\t\tif tool.ID == \"validate\" && tool.Component != \"\" {\n  1620\t\t\t\t\tmodules[tool.Component] = true\n  1621\t\t\t\t}\n  1622\t\t\t}\n  1623\t\t}\n  1624\t\tstatus := \"\"\n  1625\t\tif scope.Kind == \"spec\" {\n  1626\t\t\tif spec, err := s.GetSpec(scope.Slug); err == nil {\n  1627\t\t\t\tstatus = spec.Status\n  1628\t\t\t}\n  1629\t\t}\n  1630\t\tsets := []ChangeSet{}\n  1631\t\tfor _, set := range graph.ChangeSets {\n  1632\t\t\tif scope.Kind == \"spec\" && set.Spec == scope.Slug {\n  1633\t\t\t\tsets = append(sets, set)\n  1634\t\t\t}\n  1635\t\t}\n  1636\t\t// Evidence is judged against the material as it is now, not as the persisted\n  1637\t\t// index last saw it.\n  1638\t\tif scope.Kind == \"spec\" {\n  1639\t\t\tgraph.ChangeSets = withCurrentMaterial(s.Root, graph.ChangeSets)\n  1640\t\t\tsets = withCurrentMaterial(s.Root, sets)\n  1641\t\t}\n  1642\t\tresult := []ReviewBundleEvidence{}\n  1643\t\tfor _, evidence := range graph.ValidationResults {\n  1644\t\t\tif evidence.Outcome != \"pass\" || evidence.Severity != \"required\" {\n  1645\t\t\t\tcontinue\n  1646\t\t\t}\n  1647\t\t\tif len(modules) > 0 {\n  1648\t\t\t\tmatched := false\n  1649\t\t\t\tfor targetMod := range modules {\n  1650\t\t\t\t\tif moduleMatchesTarget(evidence.Module, targetMod) {\n  1651\t\t\t\t\t\tmatched = true\n  1652\t\t\t\t\t\tbreak\n  1653\t\t\t\t\t}\n  1654\t\t\t\t}\n  1655\t\t\t\tif !matched {\n  1656\t\t\t\t\tcontinue\n  1657\t\t\t\t}\n  1658\t\t\t}\n  1659\t\t\tif scope.Kind == \"spec\" && !deliveryEvidenceCurrent(evidence, scope.Slug, status, graph, sets) {\n  1660\t\t\t\tcontinue\n  1661\t\t\t}\n  1662\t\t\tresult = append(result, ReviewBundleEvidence{ID: evidence.ID, Module: evidence.Module, Check: evidence.Check, EvidenceClass: evidence.EvidenceClass, Outcome: evidence.Outcome, GitHead: evidence.GitHead, ProvenanceDigest: evidence.ProvenanceDigest, Report: evidence.Report})\n  1663\t\t}\n  1664\t\tif scope.Kind == \"spec\" && subject.ImplementationDigest != \"\" {\n  1665\t\t\tif design, err := AssessDesignDeltaIn(s.fsys(), s.Root, subject, scope.String(), DesignDeltaOptions{}); err == nil && len(design.InputDigest) > len(\"sha256:\")+16 {\n  1666\t\t\t\tid := \"design-\" + strings.TrimPrefix(design.InputDigest, \"sha256:\")[:16]\n  1667\t\t\t\tresult = append(result, ReviewBundleEvidence{\n  1668\t\t\t\t\tID: id, Check: \"assess-design\", EvidenceClass: \"structure\", Outcome: \"pass\",\n  1669\t\t\t\t\tSubjectDigest: subject.ImplementationDigest, ProvenanceDigest: design.InputDigest,\n  1670\t\t\t\t\tReport: \"derived:design-delta/\" + strings.TrimPrefix(design.InputDigest, \"sha256:\"),\n  1671\t\t\t\t})\n  1672\t\t\t}\n  1673\t\t}\n  1674\t\tsort.Slice(result, func(i, j int) bool { return result[i].ID < result[j].ID })\n  1675\t\treturn result\n  1676\t}\n  1677\t\n  1678\t// holdsValidationResult reports evidence of a run. What the engine derives from the\n  1679\t// subject answers structural criteria and says nothing of whether anything ran.\n  1680\tfunc holdsValidationResult(evidence []ReviewBundleEvidence) bool {\n  1681\t\tfor _, ev := range evidence {\n  1682\t\t\tif !derivedDesignEvidence(ev) {\n  1683\t\t\t\treturn true\n  1684\t\t\t}\n  1685\t\t}\n  1686\t\treturn false\n  1687\t}\n  1688\t\n  1689\t// derivedDesignEvidence recognizes what reviewBundleEvidence appends for the design\n  1690\t// delta. Check, class, module and the path of a report are all the operator's to give\n  1691\t// a validation result, so it reads the one thing a run does not have: an id and a\n  1692\t// report computed from the entry's own provenance digest.\n  1693\tfunc derivedDesignEvidence(ev ReviewBundleEvidence) bool {\n  1694\t\tinput := strings.TrimPrefix(ev.ProvenanceDigest, \"sha256:\")\n  1695\t\treturn len(input) >= 16 && ev.Check == \"assess-design\" && ev.ID == \"design-\"+input[:16] && ev.Report == \"derived:design-delta/\"+input\n  1696\t}\n  1697\t\n  1698\t// evidenceFallsShort is the gate over a prepared bundle. Verification prepares a done\n  1699\t// spec again, so that spec answers only for evidence being absent, and an approval\n  1700\t// over derived evidence stays; a new seal of it is refused by sealReviewBundle.\n  1701\tfunc (s Store) evidenceFallsShort(scope ScopeRef, evidence []ReviewBundleEvidence) bool {\n  1702\t\tif scope.Kind == \"spec\" {\n  1703\t\t\tif sp, err := s.GetSpec(scope.Slug); err == nil && sp.Status == \"done\" {\n  1704\t\t\t\treturn len(evidence) == 0\n  1705\t\t\t}\n  1706\t\t}\n  1707\t\treturn !holdsValidationResult(evidence)\n  1708\t}\n  1709\t\n  1710\tfunc (s Store) reviewScopeRequiresValidationEvidence(scope ScopeRef, plan ReviewBundlePlan, graph DeliveryIntegrityGraph) bool {\n  1711\t\tswitch scope.Kind {\n  1712\t\tcase \"spec\":\n  1713\t\t\tfor _, target := range graph.Deliveries {\n  1714\t\t\t\tif target.Spec == scope.Slug {\n  1715\t\t\t\t\treturn true\n  1716\t\t\t\t}\n  1717\t\t\t}\n  1718\t\t\tif len(plan.Components) > 0 {\n  1719\t\t\t\treturn true\n  1720\t\t\t}\n  1721\t\t\tfor _, tool := range plan.Tools {\n  1722\t\t\t\tif tool.ID == \"validate\" && tool.Requiredness == \"required\" && !containsFold(tool.Preconditions, \"delivery-target-declared\") {\n  1723\t\t\t\t\treturn true\n  1724\t\t\t\t}\n  1725\t\t\t}\n  1726\t\t\treturn false\n  1727\t\tcase \"milestone\", \"roadmap\":\n  1728\t\t\treturn len(graph.Deliveries) > 0\n  1729\t\tdefault:\n  1730\t\t\treturn true\n  1731\t\t}\n  1732\t}\n  1733\t\n  1734\tconst unreviewedMilestonesSection = \"unreviewed-milestones\"\n  1735\t\n  1736\tconst noValidationEvidenceBlocker = \"no passed structured validation evidence is attributed to the review scope\"\n  1737\t\n  1738\tconst missingChangeSetBlocker = \"no immutable attributed change set exists for \"\n  1739\t\n  1740\tfunc reportsMissingChangeSet(blockers []string) bool {\n  1741\t\tfor _, blocker := range blockers {\n  1742\t\t\tif strings.HasPrefix(blocker, missingChangeSetBlocker) {\n  1743\t\t\t\treturn true\n  1744\t\t\t}\n  1745\t\t}\n  1746\t\treturn false\n  1747\t}\n  1748\t\n  1749\t// milestoneOnlyExternal reports a milestone whose members all belong to other\n  1750\t// projects, judged by a configured federated resolver.\n  1751\tfunc (s Store) milestoneOnlyExternal(scope ScopeRef) bool {\n  1752\t\tif scope.Kind != \"milestone\" || s.FederatedResolver == nil {\n  1753\t\t\treturn false\n  1754\t\t}\n  1755\t\trm, err := s.GetRoadmap(scope.Roadmap)\n  1756\t\tif err != nil {\n  1757\t\t\treturn false\n  1758\t\t}\n  1759\t\tfor _, milestone := range rm.Milestones {\n  1760\t\t\tif milestone.ID != scope.Milestone {\n  1761\t\t\t\tcontinue\n  1762\t\t\t}\n  1763\t\t\tfor _, raw := range milestone.Specs {\n  1764\t\t\t\tif _, external := s.milestoneMember(raw); !external {\n  1765\t\t\t\t\treturn false\n  1766\t\t\t\t}\n  1767\t\t\t}\n  1768\t\t\treturn len(milestone.Specs) > 0\n  1769\t\t}\n  1770\t\treturn false\n  1771\t}\n  1772\t\n  1773\tfunc (s Store) reviewBundleChildRefs(scope ScopeRef) ([]string, error) {\n  1774\t\trefs := []string{}\n  1775\t\tif scope.Kind == \"milestone\" {\n  1776\t\t\trm, err := s.GetRoadmap(scope.Roadmap)\n  1777\t\t\tif err != nil {\n  1778\t\t\t\treturn nil, err\n  1779\t\t\t}\n  1780\t\t\tfor _, milestone := range rm.Milestones {\n  1781\t\t\t\tif milestone.ID == scope.Milestone {\n  1782\t\t\t\t\tfor _, raw := range milestone.Specs {\n  1783\t\t\t\t\t\t// External members are sealed through the federated\n  1784\t\t\t\t\t\t// manifest, not as local child bundles.\n  1785\t\t\t\t\t\tif slug, external := s.milestoneMember(raw); !external {\n  1786\t\t\t\t\t\t\trefs = append(refs, \"spec:\"+slug)\n  1787\t\t\t\t\t\t}\n  1788\t\t\t\t\t}\n  1789\t\t\t\t}\n  1790\t\t\t}\n  1791\t\t} else if scope.Kind == \"roadmap\" {\n  1792\t\t\trm, err := s.GetRoadmap(scope.Slug)\n  1793\t\t\tif err != nil {\n  1794\t\t\t\treturn nil, err\n  1795\t\t\t}\n  1796\t\t\tfor _, milestone := range rm.Milestones {\n  1797\t\t\t\trefs = append(refs, \"milestone:\"+rm.Slug+\"/\"+milestone.ID)\n  1798\t\t\t}\n  1799\t\t}\n  1800\t\treturn refs, nil\n  1801\t}\n  1802\t\n  1803\tfunc (s Store) reviewBundleChildren(scope ScopeRef) ([]ReviewBundleChild, []string, error) {\n  1804\t\trefs, err := s.reviewBundleChildRefs(scope)\n  1805\t\tif err != nil {\n  1806\t\t\treturn nil, nil, err\n  1807\t\t}\n  1808\t\ts = s.reviewOperation()\n  1809\t\tparentDone, _ := s.scopeLifecycleDone(scope)\n  1810\t\tchildren, blockers := []ReviewBundleChild{}, []string{}\n  1811\t\tfor _, ref := range refs {\n  1812\t\t\tif verification, err := s.verifyReviewBundle(ref); err == nil && verification.inherited {\n  1813\t\t\t\t// A declared milestone has no bundle to seal over: the reason is in the\n  1814\t\t\t\t// roadmap, which this bundle seals.\n  1815\t\t\t\tif verification.Bundle != nil {\n  1816\t\t\t\t\tchildren = append(children, ReviewBundleChild{Scope: ref, BundleID: verification.Bundle.BundleID, BundleDigest: verification.Bundle.BundleDigest})\n  1817\t\t\t\t}\n  1818\t\t\t\tcontinue\n  1819\t\t\t}\n  1820\t\t\tsealed, err := s.CurrentReviewBundle(ref)\n  1821\t\t\tif err != nil {\n  1822\t\t\t\treturn nil, nil, err\n  1823\t\t\t}\n  1824\t\t\tif sealed == nil {\n  1825\t\t\t\tretained, why := s.retainedChildReviewBundle(ref)\n  1826\t\t\t\tif retained == nil {\n  1827\t\t\t\t\tblockers = append(blockers, \"child \"+ref+\" has no sealed review bundle\"+why)\n  1828\t\t\t\t\tcontinue\n  1829\t\t\t\t}\n  1830\t\t\t\tsealed = retained\n  1831\t\t\t} else if why := s.childReviewStanding(ref, parentDone); why != \"\" {\n  1832\t\t\t\tblockers = append(blockers, reviewChildPrefix+ref+\" does not stand: \"+why)\n  1833\t\t\t}\n  1834\t\t\tchildren = append(children, ReviewBundleChild{Scope: ref, BundleID: sealed.BundleID, BundleDigest: sealed.BundleDigest})\n  1835\t\t}\n  1836\t\treturn children, blockers, nil\n  1837\t}\n  1838\t\n  1839\t// retainedChildReviewBundle is the approved review a done child keeps after\n  1840\t// later commits changed what is prepared for it: the bundle the child's own\n  1841\t// verification retains, with every condition that verification applies —\n  1842\t// lost attestation history, a later negative review, a changed federated\n  1843\t// manifest — or nil and why not (spec pose-review-subject-later-removal R3).\n  1844\tfunc (s Store) retainedChildReviewBundle(ref string) (*ReviewBundle, string) {\n  1845\t\tverification, err := s.reviewOperation().verifyReviewBundle(ref)\n  1846\t\tif err != nil {\n  1847\t\t\treturn nil, \": its review could not be verified: \" + err.Error()\n  1848\t\t}\n  1849\t\tif verification.State != \"closed\" || !verification.Fresh || !verification.Approved || verification.Bundle == nil {\n  1850\t\t\tif len(verification.Blockers) > 0 {\n  1851\t\t\t\treturn nil, \": \" + strings.Join(uniqueSorted(verification.Blockers), \"; \")\n  1852\t\t\t}\n  1853\t\t\treturn nil, \"\"\n  1854\t\t}\n  1855\t\treturn verification.Bundle, \"\"\n  1856\t}\n  1857\t\n  1858\t// reviewChildPrefix opens every blocker that names a child of the scope.\n  1859\tconst reviewChildPrefix = \"child \"\n  1860\t\n  1861\t// childReviewStanding says why a child's review no longer stands under its\n  1862\t// parent, or nothing when it does: the child's own verification decides, so\n  1863\t// every way a review stops standing counts (spec\n  1864\t// pose-review-approval-follows-children R1-R3, D1).\n  1865\tfunc (s Store) childReviewStanding(ref string, parentDone bool) string {\n  1866\t\tverification, err := s.reviewOperation().verifyReviewBundle(ref)\n  1867\t\tif err != nil {\n  1868\t\t\treturn \"its review could not be verified: \" + err.Error()\n  1869\t\t}\n  1870\t\tif !verification.Fresh || !verification.Approved {\n  1871\t\t\tif len(verification.Blockers) > 0 {\n  1872\t\t\t\treturn strings.Join(uniqueSorted(verification.Blockers), \"; \")\n  1873\t\t\t}\n  1874\t\t\treturn \"its review is \" + verification.State\n  1875\t\t}\n  1876\t\tif parentDone && verification.State != \"closed\" {\n  1877\t\t\treturn \"it is not closed: \" + verification.State\n  1878\t\t}\n  1879\t\treturn \"\"\n  1880\t}\n  1881\t\n  1882\t// reviewChildBlockers are the children a retained bundle integrated that no\n  1883\t// longer stand. Only a done scope retains, so its children must be closed.\n  1884\tfunc (s Store) reviewChildBlockers(children []ReviewBundleChild) []string {\n  1885\t\tblockers := []string{}\n  1886\t\tfor _, child := range children {\n  1887\t\t\tif why := s.childReviewStanding(child.Scope, true); why != \"\" {\n  1888\t\t\t\tblockers = append(blockers, reviewChildPrefix+child.Scope+\" does not stand: \"+why)\n  1889\t\t\t}\n  1890\t\t}\n  1891\t\treturn blockers\n  1892\t}\n  1893\t\n  1894\tfunc blockedByAChild(blockers []string) bool {\n  1895\t\tfor _, blocker := range blockers {\n  1896\t\t\tif strings.HasPrefix(blocker, reviewChildPrefix) {\n  1897\t\t\t\treturn true\n  1898\t\t\t}\n  1899\t\t}\n  1900\t\treturn false\n  1901\t}\n  1902\t\n  1903\tfunc (s Store) reviewBundleConsumedInputs(plan ReviewPlan) []ReviewBundleInput {\n  1904\t\tplanDigest, _ := reviewBundlePlanDigest(plan)\n  1905\t\tinputs := []ReviewBundleInput{\n  1906\t\t\t{Kind: \"review-plan\", Path: plan.BaseProfile, Digest: planDigest, Reason: \"effective component-aware plan contract\"},\n  1907\t\t\t{Kind: \"tool-catalog\", Path: \"native-review-tools@1\", Digest: planDigest, Reason: \"closed resolved native tool contract\"},\n  1908\t\t\t{Kind: \"schema\", Path: \"review-bundle@1\", Digest: digestText(\"review-bundle-schema-v1\\nreview-attestation-schema-v1\\nreview-attestation-envelope-schema-v1\"), Reason: \"canonical bundle and attestation schema identity\"},\n  1909\t\t}\n  1910\t\tfor _, rel := range []string{\".pose/policy/review.json\", \".pose/indexes/validation-matrix.json\"} {\n  1911\t\t\tif raw, err := s.fsys().ReadFile(filepath.Join(s.Root, filepath.FromSlash(rel))); err == nil {\n  1912\t\t\t\tinputs = append(inputs, ReviewBundleInput{Kind: \"governed-config\", Path: rel, Digest: digestBytes(raw), Reason: \"consumed review policy or validation contract\"})\n  1913\t\t\t}\n  1914\t\t}\n  1915\t\tfor _, profile := range plan.SelectedProfiles {\n  1916\t\t\traw, err := s.fsys().ReadFile(filepath.Join(s.Root, filepath.FromSlash(profile.Source)))\n  1917\t\t\tif err == nil {\n  1918\t\t\t\tinputs = append(inputs, ReviewBundleInput{Kind: \"review-profile\", Path: profile.Source, Digest: digestBytes(raw), Reason: \"selected by effective review plan\"})\n  1919\t\t\t}\n  1920\t\t}\n  1921\t\trules := map[string]bool{}\n  1922\t\tfor _, criterion := range plan.Criteria {\n  1923\t\t\tfor _, rule := range criterion.Rules {\n  1924\t\t\t\trules[rule] = true\n  1925\t\t\t}\n  1926\t\t}\n  1927\t\tfor rule := range rules {\n  1928\t\t\trel := \".pose/rules/\" + rule + \".md\"\n  1929\t\t\tif raw, err := s.fsys().ReadFile(filepath.Join(s.Root, filepath.FromSlash(rel))); err == nil {\n  1930\t\t\t\tinputs = append(inputs, ReviewBundleInput{Kind: \"rule\", Path: rel, Digest: digestBytes(raw), Reason: \"selected by effective review criterion\"})\n  1931\t\t\t}\n  1932\t\t}\n  1933\t\treturn sortedBundleInputs(inputs)\n  1934\t}\n  1935\t\n  1936\tfunc reviewBundlePlanDigest(plan ReviewPlan) (string, error) {\n  1937\t\tcontract := struct {\n  1938\t\t\tSchemaVersion             int                   `json:\"schema_version\"`\n  1939\t\t\tPolicySchemaVersion       int                   `json:\"policy_schema_version\"`\n  1940\t\t\tBaseProfile               string                `json:\"base_profile\"`\n  1941\t\t\tIndependence              string                `json:\"independence\"`\n  1942\t\t\tComponents                []ReviewPlanComponent `json:\"components\"`\n  1943\t\t\tSelectedProfiles          []ReviewPlanProfile   `json:\"selected_profiles\"`\n  1944\t\t\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n  1945\t\t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n  1946\t\t\tLimitations               []string              `json:\"limitations,omitempty\"`\n  1947\t\t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n  1948\t\t}{plan.SchemaVersion, plan.PolicySchemaVersion, plan.BaseProfile, plan.Independence, append([]ReviewPlanComponent{}, plan.Components...), append([]ReviewPlanProfile{}, plan.SelectedProfiles...), append([]ReviewPlanCriterion{}, plan.Criteria...), append([]ReviewPlanTool{}, plan.Tools...), plan.Limitations, plan.DelegatedRunProofRequired}\n  1949\t\treturn digestJSON(contract)\n  1950\t}\n  1951\t\n  1952\tfunc normalizeReviewBundlePayload(payload *ReviewBundlePayload) {\n  1953\t\tsort.Slice(payload.Scope.Sections, func(i, j int) bool { return payload.Scope.Sections[i].Path < payload.Scope.Sections[j].Path })\n  1954\t\tsort.Slice(payload.Plan.Components, func(i, j int) bool { return payload.Plan.Components[i].ID < payload.Plan.Components[j].ID })\n  1955\t\tsort.Slice(payload.Plan.Criteria, func(i, j int) bool { return payload.Plan.Criteria[i].ID < payload.Plan.Criteria[j].ID })\n  1956\t\tsort.Slice(payload.Plan.Tools, func(i, j int) bool {\n  1957\t\t\treturn reviewToolKey(payload.Plan.Tools[i].ID, payload.Plan.Tools[i].Component) < reviewToolKey(payload.Plan.Tools[j].ID, payload.Plan.Tools[j].Component)\n  1958\t\t})\n  1959\t\tpayload.ConsumedInputs = sortedBundleInputs(payload.ConsumedInputs)\n  1960\t}\n  1961\t\n  1962\tfunc reviewBundlePayloadDigest(payload ReviewBundlePayload) (string, error) {\n  1963\t\tcanonical := payload\n  1964\t\t// Change-set IDs and Git refs remain exported for audit/debugging but are\n  1965\t\t// advisory provenance. Stable subject identity is the classified patch and\n  1966\t\t// tree manifest, so provider ref movement or a derived-only follow-up commit\n  1967\t\t// cannot change the bundle identity.\n  1968\t\tcanonical.Subject.ChangeSets = nil\n  1969\t\tcanonical.Subject.Base = \"\"\n  1970\t\tcanonical.Subject.Head = \"\"\n  1971\t\t// The observation is derived from the head just cleared above, so sealing\n  1972\t\t// it would smuggle that ref back into the identity: a provider ref moving,\n  1973\t\t// or a derived-only follow-up commit, would flip a result from observed to\n  1974\t\t// carried-forward and stale a review of content that did not move. It stays\n  1975\t\t// in the written bundle for the reader, as advisory provenance, exactly\n  1976\t\t// like the refs it is computed from.\n  1977\t\t//\n  1978\t\t// Copied first: `canonical := payload` shares the slice backing array, so\n  1979\t\t// clearing in place would erase the state on the bundle the caller is\n  1980\t\t// holding, not on the copy being hashed.\n  1981\t\tcanonical.Evidence = append([]ReviewBundleEvidence{}, canonical.Evidence...)\n  1982\t\tfor i := range canonical.Evidence {\n  1983\t\t\tcanonical.Evidence[i].SubjectObservation = \"\"\n  1984\t\t}\n  1985\t\treturn digestJSON(canonical)\n  1986\t}\n  1987\t\n  1988\tfunc sortedBundleInputs(values []ReviewBundleInput) []ReviewBundleInput {\n  1989\t\tresult := append([]ReviewBundleInput{}, values...)\n  1990\t\tsort.Slice(result, func(i, j int) bool {\n  1991\t\t\treturn result[i].Kind+\"\\x00\"+result[i].Path+\"\\x00\"+result[i].Digest < result[j].Kind+\"\\x00\"+result[j].Path+\"\\x00\"+result[j].Digest\n  1992\t\t})\n  1993\t\treturn result\n  1994\t}\n  1995\t\n  1996\tfunc normalizeBundleText(value string) string {\n  1997\t\tlines := strings.Split(strings.ReplaceAll(value, \"\\r\\n\", \"\\n\"), \"\\n\")\n  1998\t\tfor i := range lines {\n  1999\t\t\tlines[i] = strings.TrimRight(lines[i], \" \\t\")\n  2000\t\t}\n  2001\t\treturn strings.TrimSpace(strings.Join(lines, \"\\n\"))\n  2002\t}\n  2003\t\n  2004\tfunc digestText(value string) string { return digestBytes([]byte(normalizeBundleText(value))) }\n  2005\tfunc digestBytes(value []byte) string {\n  2006\t\tsum := sha256.Sum256(value)\n  2007\t\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n  2008\t}\n  2009\t\n  2010\tfunc (s Store) reviewBundlesDir() string { return filepath.Join(s.Root, \".pose\", \"review-bundles\") }\n  2011\tfunc (s Store) reviewAttestationsDir() string {\n  2012\t\treturn filepath.Join(s.Root, \".pose\", \"review-attestations\")\n  2013\t}\n  2014\t\n  2015\tfunc ensureReviewArtifactDirIn(files Files, root, rel string, create bool) (string, error) {\n  2016\t\tclean, err := validateArtifactPathSyntax(rel)\n  2017\t\tif err != nil {\n  2018\t\t\treturn \"\", err\n  2019\t\t}\n  2020\t\tcurrent := root\n  2021\t\tfor _, part := range strings.Split(filepath.Clean(clean), string(os.PathSeparator)) {\n  2022\t\t\tcurrent = filepath.Join(current, part)\n  2023\t\t\tinfo, statErr := files.Lstat(current)\n  2024\t\t\tif os.IsNotExist(statErr) && create {\n  2025\t\t\t\tif mkdirErr := files.Mkdir(current, 0o755); mkdirErr != nil && !os.IsExist(mkdirErr) {\n  2026\t\t\t\t\treturn \"\", mkdirErr\n  2027\t\t\t\t}\n  2028\t\t\t\tinfo, statErr = files.Lstat(current)\n  2029\t\t\t}\n  2030\t\t\tif statErr != nil {\n  2031\t\t\t\treturn \"\", statErr\n  2032\t\t\t}\n  2033\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n  2034\t\t\t\trelPath, _ := filepath.Rel(root, current)\n  2035\t\t\t\treturn \"\", fmt.Errorf(\"pose: refusing to follow review artifact symlink at %s\", filepath.ToSlash(relPath))\n  2036\t\t\t}\n  2037\t\t\tif !info.IsDir() {\n  2038\t\t\t\treturn \"\", fmt.Errorf(\"pose: review artifact path is not a directory: %s\", filepath.ToSlash(rel))\n  2039\t\t\t}\n  2040\t\t}\n  2041\t\treturn current, nil\n  2042\t}\n  2043\t\n  2044\t// ensureReviewArtifactDir reads the filesystem directly; ensureReviewArtifactDirIn reads the operation's files.\n  2045\tfunc ensureReviewArtifactDir(root, rel string, create bool) (string, error) {\n  2046\t\treturn ensureReviewArtifactDirIn(NativeFiles(), root, rel, create)\n  2047\t}\n  2048\t\n  2049\t// SealReviewBundle writes a prepared, unblocked bundle atomically. Replaying\n  2050\t// the same payload is idempotent.\n  2051\tfunc (s Store) SealReviewBundle(ref string, now time.Time) (ReviewBundle, error) {\n  2052\t\treturn s.SealReviewBundleLead(ref, \"\", now)\n  2053\t}\n  2054\t\n  2055\t// SealReviewBundleLead seals with the implementation identity lead declares,\n  2056\t// or the one detected from the sealing session when lead is empty (spec\n  2057\t// pose-delegation-routing R1–R3). Sealing content that a sealed bundle of the\n  2058\t// scope already holds returns that bundle, which keeps the identity it was\n  2059\t// sealed with: a reviewer resealing to close out never becomes the\n  2060\t// implementation. Only a declared lead that names another identity seals anew.\n  2061\tfunc (s Store) SealReviewBundleLead(ref, lead string, now time.Time) (ReviewBundle, error) {\n  2062\t\tvar result ReviewBundle\n  2063\t\terr := s.withReviewBundleWriteGuard(\"review.bundle.seal\", ref, func(guarded Store, _ ReviewBundle) error {\n  2064\t\t\tvar err error\n  2065\t\t\tresult, err = guarded.sealReviewBundleLead(ref, lead, now)\n  2066\t\t\treturn err\n  2067\t\t})\n  2068\t\treturn result, err\n  2069\t}\n  2070\t\n  2071\tfunc (s Store) sealReviewBundleLead(ref, lead string, now time.Time) (ReviewBundle, error) {\n  2072\t\tidentity, warning, err := s.SealingIdentity(lead)\n  2073\t\tif err != nil {\n  2074\t\t\treturn ReviewBundle{}, err\n  2075\t\t}\n  2076\t\tif identity.Vendor == ImplementationUnknown {\n  2077\t\t\twarning = joinWarnings(warning, \"the seal records an unknown implementation vendor: no agent session was detected; seal from the implementing session or declare it with --lead\")\n  2078\t\t} else if identity.ExecutionDigest == \"\" {\n  2079\t\t\twarning = joinWarnings(warning, \"the seal names no implementation execution (no \"+identity.Vendor+\" session reference in the environment), so a review that must prove a different actor cannot be attested against it\")\n  2080\t\t}\n  2081\t\treturn s.sealReviewBundle(ref, &identity, lead != \"\", warning, now)\n  2082\t}\n  2083\t\n  2084\t// sealReviewBundle seals ref recording identity; declared reseals content a\n  2085\t// bundle already holds when that bundle records another identity. A nil\n  2086\t// identity seals the way bundles were sealed before they recorded one, which\n  2087\t// only the tests of the legacy reading need.\n  2088\tfunc (s Store) sealReviewBundle(ref string, identity *ReviewBundleImplementation, declared bool, warning string, now time.Time) (ReviewBundle, error) {\n  2089\t\tbundle, err := s.PrepareReviewBundle(ref)\n  2090\t\tif err != nil {\n  2091\t\t\treturn ReviewBundle{}, err\n  2092\t\t}\n  2093\t\tif len(bundle.Blockers) > 0 {\n  2094\t\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", strings.Join(bundle.Blockers, \"; \"))\n  2095\t\t}\n  2096\t\tsealed, err := s.ListReviewBundles(bundle.Payload.Scope.Ref)\n  2097\t\tif err != nil {\n  2098\t\t\treturn ReviewBundle{}, err\n  2099\t\t}\n  2100\t\t// Content a sealed bundle already holds keeps the bundle that governs it,\n  2101\t\t// unless a declared identity names another: then the new seal replaces\n  2102\t\t// that bundle's identity by name, so it governs whatever the seal instants\n  2103\t\t// say, and a historical identity declared again is a new seal, never the\n  2104\t\t// historical bundle handed back (spec pose-delegation-routing D3).\n  2105\t\tif governing := governingSealedBundle(sealed, bundle); governing != nil {\n  2106\t\t\tif !declared || identity == nil || governing.Payload.Implementation != nil && sameImplementation(*governing.Payload.Implementation, *identity) {\n  2107\t\t\t\treturn *governing, nil\n  2108\t\t\t}\n  2109\t\t\treplaced := *identity\n  2110\t\t\treplaced.Replaces = governing.BundleID\n  2111\t\t\tidentity = &replaced\n  2112\t\t}\n  2113\t\t// A bundle already sealed reads as it was; a new seal holds a validation result,\n  2114\t\t// whatever the lifecycle of the scope says.\n  2115\t\tif !holdsValidationResult(bundle.Payload.Evidence) {\n  2116\t\t\tscope, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n  2117\t\t\tif err != nil {\n  2118\t\t\t\treturn ReviewBundle{}, err\n  2119\t\t\t}\n  2120\t\t\tgraph, err := s.GetDeliveryIntegrity(\"\")\n  2121\t\t\tif err != nil {\n  2122\t\t\t\treturn ReviewBundle{}, err\n  2123\t\t\t}\n  2124\t\t\tif s.reviewScopeRequiresValidationEvidence(scope, bundle.Payload.Plan, graph) {\n  2125\t\t\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", noValidationEvidenceBlocker)\n  2126\t\t\t}\n  2127\t\t}\n  2128\t\tif identity != nil {\n  2129\t\t\tbundle.Payload.Implementation = identity\n  2130\t\t\tdigest, err := reviewBundlePayloadDigest(bundle.Payload)\n  2131\t\t\tif err != nil {\n  2132\t\t\t\treturn ReviewBundle{}, err\n  2133\t\t\t}\n  2134\t\t\tbundle.BundleDigest = digest\n  2135\t\t\tbundle.BundleID = \"rvb-\" + strings.TrimPrefix(digest, \"sha256:\")[:16]\n  2136\t\t}\n  2137\t\tif warning != \"\" {\n  2138\t\t\tbundle.Warnings = uniqueSorted(append(bundle.Warnings, warning))\n  2139\t\t}\n  2140\t\tbundle.State = \"sealed\"\n  2141\t\tbundle.SealedAt = now.UTC().Truncate(time.Second).Format(time.RFC3339)\n  2142\t\tbundle.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", bundle.BundleID+\".json\"))\n  2143\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\")), true)\n  2144\t\tif err != nil {\n  2145\t\t\treturn ReviewBundle{}, err\n  2146\t\t}\n  2147\t\tpath := filepath.Join(dir, bundle.BundleID+\".json\")\n  2148\t\tif existing, readErr := s.LoadReviewBundle(bundle.BundleID); readErr == nil {\n  2149\t\t\tif existing.BundleDigest != bundle.BundleDigest {\n  2150\t\t\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: review bundle identity collision for %s\", bundle.BundleID)\n  2151\t\t\t}\n  2152\t\t\treturn existing, nil\n  2153\t\t}\n  2154\t\traw, err := json.MarshalIndent(bundle, \"\", \"  \")\n  2155\t\tif err != nil {\n  2156\t\t\treturn ReviewBundle{}, err\n  2157\t\t}\n  2158\t\traw = append(raw, '\\n')\n  2159\t\tif err := writeImmutableJSONIn(s.fsys(), path, raw); err != nil {\n  2160\t\t\tvar durability *PublishDurabilityError\n  2161\t\t\tif errors.As(err, &durability) {\n  2162\t\t\t\t// The publisher reports this error only after the immutable name is\n  2163\t\t\t\t// visible. Return the committed identity with the error so operation\n  2164\t\t\t\t// receipts can distinguish it from a failed publication.\n  2165\t\t\t\treturn bundle, err\n  2166\t\t\t}\n  2167\t\t\treturn ReviewBundle{}, err\n  2168\t\t}\n  2169\t\treturn bundle, nil\n  2170\t}\n  2171\t\n  2172\tfunc joinWarnings(a, b string) string {\n  2173\t\tif a == \"\" {\n  2174\t\t\treturn b\n  2175\t\t}\n  2176\t\treturn a + \"; \" + b\n  2177\t}\n  2178\t\n  2179\t// sealedBundleMatches reports whether sealed holds the content prepared\n  2180\t// holds: equal digests once prepared carries the implementation sealed\n  2181\t// recorded, which a preparation never has (spec pose-delegation-routing D3).\n  2182\tfunc sealedBundleMatches(sealed, prepared ReviewBundle) bool {\n  2183\t\tif sealed.Payload.Implementation == nil || prepared.Payload.Implementation != nil {\n  2184\t\t\treturn sealed.BundleDigest == prepared.BundleDigest\n  2185\t\t}\n  2186\t\tpayload := prepared.Payload\n  2187\t\tpayload.Implementation = sealed.Payload.Implementation\n  2188\t\tdigest, err := reviewBundlePayloadDigest(payload)\n  2189\t\treturn err == nil && digest == sealed.BundleDigest\n  2190\t}\n  2191\t\n  2192\t// governingSealedBundle is the sealed bundle that governs prepared's content:\n  2193\t// among the bundles holding it, the newest whose identity no other of them\n  2194\t// replaced. Bundles are in seal order.\n  2195\tfunc governingSealedBundle(bundles []ReviewBundle, prepared ReviewBundle) *ReviewBundle {\n  2196\t\tmatching := []ReviewBundle{}\n  2197\t\tfor i := range bundles {\n  2198\t\t\tif sealedBundleMatches(bundles[i], prepared) {\n  2199\t\t\t\tmatching = append(matching, bundles[i])\n  2200\t\t\t}\n  2201\t\t}\n  2202\t\tif len(matching) == 0 {\n  2203\t\t\treturn nil\n  2204\t\t}\n  2205\t\tbundle := reviewBundleLineage(matching)[0]\n  2206\t\treturn &bundle\n  2207\t}\n  2208\t\n  2209\t// replacementHolds says whether successor really replaced predecessor's\n  2210\t// identity: the same content, under another identity. A sealed `replaces` is\n  2211\t// data and names anything, so an edge between different content counts for no\n  2212\t// selection (spec pose-review-approval-follows-children R4).\n  2213\tfunc replacementHolds(successor, predecessor ReviewBundle) bool {\n  2214\t\tpayload := predecessor.Payload\n  2215\t\tpayload.Implementation = successor.Payload.Implementation\n  2216\t\tdigest, err := reviewBundlePayloadDigest(payload)\n  2217\t\treturn err == nil && digest == successor.BundleDigest\n  2218\t}\n  2219\t\n  2220\t// reviewBundleReplacements maps each bundle's index to the index of the bundle\n  2221\t// it holds a replacement of.\n  2222\tfunc reviewBundleReplacements(bundles []ReviewBundle) map[int]int {\n  2223\t\tposition := make(map[string]int, len(bundles))\n  2224\t\tfor i := range bundles {\n  2225\t\t\tposition[bundles[i].BundleID] = i\n  2226\t\t}\n  2227\t\treplacements := map[int]int{}\n  2228\t\tfor i := range bundles {\n  2229\t\t\timpl := bundles[i].Payload.Implementation\n  2230\t\t\tif impl == nil || impl.Replaces == \"\" {\n  2231\t\t\t\tcontinue\n  2232\t\t\t}\n  2233\t\t\tif at, ok := position[impl.Replaces]; ok && at != i && replacementHolds(bundles[i], bundles[at]) {\n  2234\t\t\t\treplacements[i] = at\n  2235\t\t\t}\n  2236\t\t}\n  2237\t\treturn replacements\n  2238\t}\n  2239\t\n  2240\tfunc replacedReviewBundles(bundles []ReviewBundle) map[string]bool {\n  2241\t\treplaced := map[string]bool{}\n  2242\t\tfor _, at := range reviewBundleReplacements(bundles) {\n  2243\t\t\treplaced[bundles[at].BundleID] = true\n  2244\t\t}\n  2245\t\treturn replaced\n  2246\t}\n  2247\t\n  2248\t// reviewBundleLineage orders bundles, given oldest first, newest first by\n  2249\t// lineage: every replacement before what it replaces, and each bundle in the\n  2250\t// newest place of the chain it replaced, since it was sealed after them\n  2251\t// whatever its seal time says. Bundles in a replacement cycle follow newest\n  2252\t// first. Every selection reads this one order, so none can disagree with\n  2253\t// another (spec pose-review-approval-follows-children R4, D3).\n  2254\tfunc reviewBundleLineage(bundles []ReviewBundle) []ReviewBundle {\n  2255\t\treplacements := reviewBundleReplacements(bundles)\n  2256\t\tsuccessors := make([]int, len(bundles))\n  2257\t\tnewest := make([]int, len(bundles))\n  2258\t\tfor i := range bundles {\n  2259\t\t\tnewest[i] = i\n  2260\t\t\tseen := map[int]bool{i: true}\n  2261\t\t\tfor at, ok := replacements[i]; ok && !seen[at]; at, ok = replacements[at] {\n  2262\t\t\t\tseen[at] = true\n  2263\t\t\t\tnewest[i] = max(newest[i], at)\n  2264\t\t\t}\n  2265\t\t}\n  2266\t\tfor _, at := range replacements {\n  2267\t\t\tsuccessors[at]++\n  2268\t\t}\n  2269\t\tplaced := make([]bool, len(bundles))\n  2270\t\tordered := make([]ReviewBundle, 0, len(bundles))\n  2271\t\tbetter := func(a, b int) bool {\n  2272\t\t\treturn b < 0 || newest[a] > newest[b] || newest[a] == newest[b] && a > b\n  2273\t\t}\n  2274\t\tfor len(ordered) < len(bundles) {\n  2275\t\t\tnext, cycle := -1, -1\n  2276\t\t\tfor i := range bundles {\n  2277\t\t\t\tif placed[i] {\n  2278\t\t\t\t\tcontinue\n  2279\t\t\t\t}\n  2280\t\t\t\tif successors[i] == 0 && better(i, next) {\n  2281\t\t\t\t\tnext = i\n  2282\t\t\t\t}\n  2283\t\t\t\tif better(i, cycle) {\n  2284\t\t\t\t\tcycle = i\n  2285\t\t\t\t}\n  2286\t\t\t}\n  2287\t\t\tif next < 0 {\n  2288\t\t\t\tnext = cycle\n  2289\t\t\t}\n  2290\t\t\tplaced[next] = true\n  2291\t\t\tordered = append(ordered, bundles[next])\n  2292\t\t\tif at, ok := replacements[next]; ok && !placed[at] {\n  2293\t\t\t\tsuccessors[at]--\n  2294\t\t\t}\n  2295\t\t}\n  2296\t\treturn ordered\n  2297\t}\n  2298\t\n  2299\tfunc sameImplementation(a, b ReviewBundleImplementation) bool {\n  2300\t\treturn a.Vendor == b.Vendor && a.Model == b.Model && a.Source == b.Source && a.Principal == b.Principal\n  2301\t}\n  2302\t\n  2303\t// SealingIdentity is the identity a seal records: lead when declared, the\n  2304\t// session's otherwise, with the model from routing.lead_models (R2, R3).\n  2305\tfunc (s Store) SealingIdentity(lead string) (ReviewBundleImplementation, string, error) {\n  2306\t\tvar leadModels map[string]string\n  2307\t\tif policy, _, found, err := s.LoadDelegationPolicy(); err == nil && found && policy.Routing != nil {\n  2308\t\t\tleadModels = policy.Routing.LeadModels\n  2309\t\t}\n  2310\t\treturn EnvironmentSessionIdentity(lead, leadModels)\n  2311\t}\n  2312\t\n  2313\tfunc writeImmutableJSON(path string, raw []byte) error {\n  2314\t\treturn writeImmutableJSONIn(NativeFiles(), path, raw)\n  2315\t}\n  2316\t\n  2317\tfunc writeImmutableJSONIn(files Files, path string, raw []byte) error {\n  2318\t\tif len(raw) > maxReviewBundleBytes {\n  2319\t\t\treturn fmt.Errorf(\"pose: review artifact exceeds %d bytes\", maxReviewBundleBytes)\n  2320\t\t}\n  2321\t\tif err := files.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n  2322\t\t\treturn err\n  2323\t\t}\n  2324\t\tif err := files.Publish(path, raw, 0o644, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  2325\t\t\tif errors.Is(err, ErrPublishConflict) {\n  2326\t\t\t\treturn fmt.Errorf(\"pose: immutable review artifact already exists: %s\", filepath.Base(path))\n  2327\t\t\t}\n  2328\t\t\treturn err\n  2329\t\t}\n  2330\t\treturn nil\n  2331\t}\n  2332\t\n  2333\tfunc strictJSONFileIn(files Files, path string, target any) error {\n  2334\t\tfile, err := files.Open(path)\n  2335\t\tif err != nil {\n  2336\t\t\treturn err\n  2337\t\t}\n  2338\t\tdefer file.Close()\n  2339\t\traw, err := io.ReadAll(io.LimitReader(file, maxReviewBundleBytes+1))\n  2340\t\tif err != nil {\n  2341\t\t\treturn err\n  2342\t\t}\n  2343\t\tif len(raw) > maxReviewBundleBytes {\n  2344\t\t\treturn fmt.Errorf(\"review artifact exceeds %d bytes\", maxReviewBundleBytes)\n  2345\t\t}\n  2346\t\tif err := rejectDuplicateJSONKeysAndControls(raw); err != nil {\n  2347\t\t\treturn err\n  2348\t\t}\n  2349\t\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n  2350\t\tdecoder.DisallowUnknownFields()\n  2351\t\tif err := decoder.Decode(target); err != nil {\n  2352\t\t\treturn err\n  2353\t\t}\n  2354\t\tvar trailing any\n  2355\t\tif err := decoder.Decode(&trailing); err != io.EOF {\n  2356\t\t\tif err == nil {\n  2357\t\t\t\treturn fmt.Errorf(\"trailing JSON content\")\n  2358\t\t\t}\n  2359\t\t\treturn fmt.Errorf(\"trailing JSON content: %w\", err)\n  2360\t\t}\n  2361\t\treturn nil\n  2362\t}\n  2363\t\n  2364\t// strictJSONFile reads the filesystem directly; strictJSONFileIn reads the operation's files.\n  2365\tfunc strictJSONFile(path string, target any) error {\n  2366\t\treturn strictJSONFileIn(NativeFiles(), path, target)\n  2367\t}\n  2368\t\n  2369\tfunc rejectDuplicateJSONKeysAndControls(raw []byte) error {\n  2370\t\treturn rejectDuplicateJSONKeys(raw, true, false)\n  2371\t}\n  2372\t\n  2373\t// rejectDuplicateJSONKeys refuses a JSON document with a duplicate object\n  2374\t// field or trailing content; with controls it also refuses control\n  2375\t// characters in strings and keys. With fold, two keys that differ only in\n  2376\t// case are duplicates too, because encoding/json matches a field\n  2377\t// case-insensitively and the later one would silently replace the first.\n  2378\tfunc rejectDuplicateJSONKeys(raw []byte, controls, fold bool) error {\n  2379\t\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n  2380\t\tdecoder.UseNumber()\n  2381\t\tvar walk func() error\n  2382\t\tcheckText := func(value string) error {\n  2383\t\t\tif !controls {\n  2384\t\t\t\treturn nil\n  2385\t\t\t}\n  2386\t\t\tfor _, r := range value {\n  2387\t\t\t\tif r < 0x20 || r == 0x7f {\n  2388\t\t\t\t\treturn fmt.Errorf(\"JSON string contains a control character\")\n  2389\t\t\t\t}\n  2390\t\t\t}\n  2391\t\t\treturn nil\n  2392\t\t}\n  2393\t\twalk = func() error {\n  2394\t\t\ttoken, err := decoder.Token()\n  2395\t\t\tif err != nil {\n  2396\t\t\t\treturn err\n  2397\t\t\t}\n  2398\t\t\tswitch value := token.(type) {\n  2399\t\t\tcase json.Delim:\n  2400\t\t\t\tswitch value {\n  2401\t\t\t\tcase '{':\n  2402\t\t\t\t\tseen := map[string]bool{}\n  2403\t\t\t\t\tfor decoder.More() {\n  2404\t\t\t\t\t\tkeyToken, err := decoder.Token()\n  2405\t\t\t\t\t\tif err != nil {\n  2406\t\t\t\t\t\t\treturn err\n  2407\t\t\t\t\t\t}\n  2408\t\t\t\t\t\tkey, ok := keyToken.(string)\n  2409\t\t\t\t\t\tif !ok {\n  2410\t\t\t\t\t\t\treturn fmt.Errorf(\"JSON object key must be a string\")\n  2411\t\t\t\t\t\t}\n  2412\t\t\t\t\t\tif err := checkText(key); err != nil {\n  2413\t\t\t\t\t\t\treturn err\n  2414\t\t\t\t\t\t}\n  2415\t\t\t\t\t\tname := key\n  2416\t\t\t\t\t\tif fold {\n  2417\t\t\t\t\t\t\tname = foldJSONKey(key)\n  2418\t\t\t\t\t\t}\n  2419\t\t\t\t\t\tif seen[name] {\n  2420\t\t\t\t\t\t\treturn fmt.Errorf(\"duplicate JSON field %q\", key)\n  2421\t\t\t\t\t\t}\n  2422\t\t\t\t\t\tseen[name] = true\n  2423\t\t\t\t\t\tif err := walk(); err != nil {\n  2424\t\t\t\t\t\t\treturn err\n  2425\t\t\t\t\t\t}\n  2426\t\t\t\t\t}\n  2427\t\t\t\t\tend, err := decoder.Token()\n  2428\t\t\t\t\tif err != nil || end != json.Delim('}') {\n  2429\t\t\t\t\t\treturn fmt.Errorf(\"malformed JSON object\")\n  2430\t\t\t\t\t}\n  2431\t\t\t\tcase '[':\n  2432\t\t\t\t\tfor decoder.More() {\n  2433\t\t\t\t\t\tif err := walk(); err != nil {\n  2434\t\t\t\t\t\t\treturn err\n  2435\t\t\t\t\t\t}\n  2436\t\t\t\t\t}\n  2437\t\t\t\t\tend, err := decoder.Token()\n  2438\t\t\t\t\tif err != nil || end != json.Delim(']') {\n  2439\t\t\t\t\t\treturn fmt.Errorf(\"malformed JSON array\")\n  2440\t\t\t\t\t}\n  2441\t\t\t\tdefault:\n  2442\t\t\t\t\treturn fmt.Errorf(\"unexpected JSON delimiter %q\", value)\n  2443\t\t\t\t}\n  2444\t\t\tcase string:\n  2445\t\t\t\treturn checkText(value)\n  2446\t\t\t}\n  2447\t\t\treturn nil\n  2448\t\t}\n  2449\t\tif err := walk(); err != nil {\n  2450\t\t\treturn err\n  2451\t\t}\n  2452\t\tif _, err := decoder.Token(); err != io.EOF {\n  2453\t\t\tif err == nil {\n  2454\t\t\t\treturn fmt.Errorf(\"trailing JSON content\")\n  2455\t\t\t}\n  2456\t\t\treturn fmt.Errorf(\"trailing JSON content: %w\", err)\n  2457\t\t}\n  2458\t\treturn nil\n  2459\t}\n  2460\t\n  2461\tfunc (s Store) LoadReviewBundle(id string) (ReviewBundle, error) {\n  2462\t\tif !strings.HasPrefix(id, \"rvb-\") || len(id) != 20 {\n  2463\t\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: invalid review bundle id %q\", id)\n  2464\t\t}\n  2465\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\")), false)\n  2466\t\tif err != nil {\n  2467\t\t\treturn ReviewBundle{}, err\n  2468\t\t}\n  2469\t\tpath := filepath.Join(dir, id+\".json\")\n  2470\t\tvar bundle ReviewBundle\n  2471\t\tif err := strictJSONFileIn(s.fsys(), path, &bundle); err != nil {\n  2472\t\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: reading review bundle %s: %w\", id, err)\n  2473\t\t}\n  2474\t\tif bundle.SchemaVersion != ReviewBundleSchemaVersion || bundle.BundleID != id || bundle.State != \"sealed\" {\n  2475\t\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: malformed review bundle %s\", id)\n  2476\t\t}\n  2477\t\tdigest, err := reviewBundlePayloadDigest(bundle.Payload)\n  2478\t\tif err != nil || digest != bundle.BundleDigest || id != \"rvb-\"+strings.TrimPrefix(digest, \"sha256:\")[:16] {\n  2479\t\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: review bundle %s digest mismatch\", id)\n  2480\t\t}\n  2481\t\tif impl := bundle.Payload.Implementation; impl != nil {\n  2482\t\t\tif err := validateBundleImplementation(*impl); err != nil {\n  2483\t\t\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: review bundle %s: %w\", id, err)\n  2484\t\t\t}\n  2485\t\t}\n  2486\t\t// The order of bundles is by the instant they were sealed: a bundle without a valid one\n  2487\t\t// has no known place in the history, and is not read as the oldest.\n  2488\t\tif _, ok := reviewInstant(bundle.SealedAt); !ok {\n  2489\t\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: review bundle %s has no valid sealed_at\", id)\n  2490\t\t}\n  2491\t\tbundle.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", id+\".json\"))\n  2492\t\treturn bundle, nil\n  2493\t}\n  2494\t\n  2495\tfunc (s Store) ListReviewBundles(scope string) ([]ReviewBundle, error) {\n  2496\t\tread, err := s.ReadReviewBundles(scope)\n  2497\t\treturn read.Bundles, err\n  2498\t}\n  2499\t\n  2500\t// ReviewBundlesRead is the sealed bundles a read found and the records it could not\n  2501\t// read (spec pose-source-coverage-integrity). A bundle that is lost is not absent.\n  2502\ttype ReviewBundlesRead struct {\n  2503\t\tBundles  []ReviewBundle\n  2504\t\tCoverage SourceCoverage\n  2505\t}\n  2506\t\n  2507\t// attributeLoss names, from the readable prefix of a record that could not be read\n  2508\t// whole, the scope or bundle it belongs to: the string at one structural path, once.\n  2509\t// A prefix that never reaches it, reaches it twice or crosses an array attributes\n  2510\t// nothing, and the loss then concerns any scope.\n  2511\tfunc attributeLoss(loss SourceLoss, raw []byte, path ...string) SourceLoss {\n  2512\t\tif value, found, ambiguous := sniffJSONString(raw, path...); found && !ambiguous && value != \"\" {\n  2513\t\t\tloss.Scope, loss.AttributedBy = value, \"header\"\n  2514\t\t}\n  2515\t\treturn loss\n  2516\t}\n  2517\t\n  2518\t// ReadReviewBundles lists sealed bundles and reports the records it could not read. A\n  2519\t// record that does not parse is attributed to the scope its readable prefix names; one\n  2520\t// that names none is unattributed, and may be a bundle of any scope.\n  2521\tfunc (s Store) ReadReviewBundles(scope string) (ReviewBundlesRead, error) {\n  2522\t\tvar err error\n  2523\t\ts, err = s.prepareReviewOperationRead()\n  2524\t\tif err != nil {\n  2525\t\t\treturn ReviewBundlesRead{}, err\n  2526\t\t}\n  2527\t\tcoverage := SourceCoverage{Losses: []SourceLoss{}}\n  2528\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\")), false)\n  2529\t\tif err != nil && scope != \"\" && s.reviewView != nil {\n  2530\t\t\ts.reviewView.observeDirectoryError(s, err)\n  2531\t\t}\n  2532\t\tif os.IsNotExist(err) {\n  2533\t\t\treturn ReviewBundlesRead{Bundles: []ReviewBundle{}, Coverage: coverage}, nil\n  2534\t\t}\n  2535\t\tif err != nil {\n  2536\t\t\treturn ReviewBundlesRead{}, err\n  2537\t\t}\n  2538\t\tentries, err := s.fsys().ReadDir(dir)\n  2539\t\tif err != nil && scope != \"\" && s.reviewView != nil {\n  2540\t\t\ts.reviewView.observeDirectoryError(s, err)\n  2541\t\t}\n  2542\t\tif os.IsNotExist(err) {\n  2543\t\t\treturn ReviewBundlesRead{Bundles: []ReviewBundle{}, Coverage: coverage}, nil\n  2544\t\t}\n  2545\t\tif err != nil {\n  2546\t\t\treturn ReviewBundlesRead{}, err\n  2547\t\t}\n  2548\t\tbundles := []ReviewBundle{}\n  2549\t\tvar headers map[string]reviewHeaderObservation\n  2550\t\tif scope != \"\" {\n  2551\t\t\theaders, err = s.reviewBundleHeaders(dir, entries)\n  2552\t\t\tif err != nil {\n  2553\t\t\t\treturn ReviewBundlesRead{}, err\n  2554\t\t\t}\n  2555\t\t}\n  2556\t\tfor _, entry := range entries {\n  2557\t\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n  2558\t\t\t\tcontinue\n  2559\t\t\t}\n  2560\t\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n  2561\t\t\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", entry.Name()))\n  2562\t\t\tif scope != \"\" {\n  2563\t\t\t\tvar observation reviewHeaderObservation\n  2564\t\t\t\tif headers != nil {\n  2565\t\t\t\t\tobservation = headers[entry.Name()]\n  2566\t\t\t\t} else {\n  2567\t\t\t\t\tobservation = readReviewBundleHeader(s.fsys(), dir, entry.Name())\n  2568\t\t\t\t}\n  2569\t\t\t\tif observation.loss != nil {\n  2570\t\t\t\t\tcoverage.Add(*observation.loss)\n  2571\t\t\t\t\tcontinue\n  2572\t\t\t\t}\n  2573\t\t\t\tif observation.owner != scope {\n  2574\t\t\t\t\tcontinue\n  2575\t\t\t\t}\n  2576\t\t\t}\n  2577\t\t\tbundle, loadErr := s.LoadReviewBundle(id)\n  2578\t\t\tif loadErr != nil {\n  2579\t\t\t\tif scope != \"\" {\n  2580\t\t\t\t\treturn ReviewBundlesRead{}, loadErr\n  2581\t\t\t\t}\n  2582\t\t\t\tloss := SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossParseError, Detail: loadErr.Error()}\n  2583\t\t\t\tif raw, readErr := s.fsys().ReadFile(filepath.Join(dir, entry.Name())); readErr == nil {\n  2584\t\t\t\t\tif futureSchema(raw) {\n  2585\t\t\t\t\t\t// Well-formed JSON of a format this engine does not read.\n  2586\t\t\t\t\t\tloss.Kind, loss.Detail = LossUnsupported, \"the record has a schema_version this engine does not read\"\n  2587\t\t\t\t\t}\n  2588\t\t\t\t\tloss = attributeLoss(loss, raw, \"payload\", \"scope\", \"ref\")\n  2589\t\t\t\t} else {\n  2590\t\t\t\t\tloss.Kind, loss.Detail = LossReadError, readErr.Error()\n  2591\t\t\t\t}\n  2592\t\t\t\tcoverage.Add(loss)\n  2593\t\t\t\tcontinue\n  2594\t\t\t}\n  2595\t\t\tif scope == \"\" || bundle.Payload.Scope.Ref == scope {\n  2596\t\t\t\tbundles = append(bundles, bundle)\n  2597\t\t\t}\n  2598\t\t}\n  2599\t\ts.sortReviewBundles(bundles)\n  2600\t\tcoverage.Normalize()\n  2601\t\treturn ReviewBundlesRead{Bundles: bundles, Coverage: coverage}, nil\n  2602\t}\n  2603\t\n  2604\t// sortReviewBundles puts bundles in the seal order every selection starts from.\n  2605\tfunc (s Store) sortReviewBundles(bundles []ReviewBundle) {\n  2606\t\tsort.Slice(bundles, func(i, j int) bool {\n  2607\t\t\treturn reviewInstantLess(bundles[i].SealedAt, bundles[i].BundleID, bundles[j].SealedAt, bundles[j].BundleID)\n  2608\t\t})\n  2609\t\ts.orderTiedBundlesNegativeLast(bundles)\n  2610\t}\n  2611\t\n  2612\t// orderTiedBundlesNegativeLast settles bundles sealed in the same instant. Seal times have a\n  2613\t// resolution of a second and the identifier is a hash, so which of them is newer cannot be told:\n  2614\t// the one whose latest attestation rejects the work or requests changes is placed last, where a\n  2615\t// reader takes the current word, so an approval of a sibling cannot be kept over it.\n  2616\tfunc (s Store) orderTiedBundlesNegativeLast(bundles []ReviewBundle) {\n  2617\t\tfor start := 0; start < len(bundles); {\n  2618\t\t\tend := start + 1\n  2619\t\t\tfirst, firstOK := reviewInstant(bundles[start].SealedAt)\n  2620\t\t\tfor end < len(bundles) {\n  2621\t\t\t\tnext, ok := reviewInstant(bundles[end].SealedAt)\n  2622\t\t\t\tif !firstOK || !ok || !first.Equal(next) {\n  2623\t\t\t\t\tbreak\n  2624\t\t\t\t}\n  2625\t\t\t\tend++\n  2626\t\t\t}\n  2627\t\t\tif end-start > 1 {\n  2628\t\t\t\tnegative := map[string]bool{}\n  2629\t\t\t\tfor _, bundle := range bundles[start:end] {\n  2630\t\t\t\t\tread, err := s.ReadReviewAttestations(bundle.BundleID)\n  2631\t\t\t\t\tif err != nil || len(read.Coverage.LossesFor(bundle.BundleID)) > 0 {\n  2632\t\t\t\t\t\t// A history that cannot be read may hold a rejection: it is placed where a\n  2633\t\t\t\t\t\t// rejection would be, so that nothing is retained over it.\n  2634\t\t\t\t\t\tnegative[bundle.BundleID] = true\n  2635\t\t\t\t\t\tcontinue\n  2636\t\t\t\t\t}\n  2637\t\t\t\t\tif len(read.Attestations) > 0 {\n  2638\t\t\t\t\t\tdecision := read.Attestations[len(read.Attestations)-1].Decision\n  2639\t\t\t\t\t\tnegative[bundle.BundleID] = decision == \"rejected\" || decision == \"changes-requested\"\n  2640\t\t\t\t\t}\n  2641\t\t\t\t}\n  2642\t\t\t\tgroup := bundles[start:end]\n  2643\t\t\t\tsort.SliceStable(group, func(i, j int) bool { return !negative[group[i].BundleID] && negative[group[j].BundleID] })\n  2644\t\t\t}\n  2645\t\t\tstart = end\n  2646\t\t}\n  2647\t}\n  2648\t\n  2649\tfunc (s Store) CurrentReviewBundle(scope string) (*ReviewBundle, error) {\n  2650\t\tprepared, err := s.PrepareReviewBundle(scope)\n  2651\t\tif err != nil {\n  2652\t\t\treturn nil, err\n  2653\t\t}\n  2654\t\tbundles, err := s.ListReviewBundles(scope)\n  2655\t\tif err != nil {\n  2656\t\t\treturn nil, err\n  2657\t\t}\n  2658\t\treturn s.matchSealedReviewBundle(scope, prepared, bundles)\n  2659\t}\n  2660\t\n  2661\t// matchSealedReviewBundle returns the newest sealed bundle whose digest equals\n  2662\t// the prepared one. A milestone bundle sealed with its roadmap as federated\n  2663\t// coordinator is matched against the legacy preparation instead, so it stays\n  2664\t// fresh exactly while that sealed roadmap-wide snapshot is unchanged. That\n  2665\t// snapshot contains every edge of the milestone's own manifest, so revocation\n  2666\t// or a source change still stales it.\n  2667\tfunc (s Store) matchSealedReviewBundle(scope string, prepared ReviewBundle, bundles []ReviewBundle) (*ReviewBundle, error) {\n  2668\t\tif governing := governingSealedBundle(bundles, prepared); governing != nil {\n  2669\t\t\treturn governing, nil\n  2670\t\t}\n  2671\t\tif prepared.Payload.Scope.Kind != \"milestone\" || s.FederatedResolver == nil {\n  2672\t\t\treturn nil, nil\n  2673\t\t}\n  2674\t\tcoordinated := []ReviewBundle{}\n  2675\t\tfor i := range bundles {\n  2676\t\t\tif manifest := bundles[i].Payload.FederatedManifest; manifest != nil && manifest.Coordinator.Kind == \"roadmap\" {\n  2677\t\t\t\tcoordinated = append(coordinated, bundles[i])\n  2678\t\t\t}\n  2679\t\t}\n  2680\t\tif len(coordinated) == 0 {\n  2681\t\t\treturn nil, nil\n  2682\t\t}\n  2683\t\tlegacy, err := s.prepareReviewBundle(scope, true)\n  2684\t\tif err != nil {\n  2685\t\t\treturn nil, err\n  2686\t\t}\n  2687\t\treturn governingSealedBundle(coordinated, legacy), nil\n  2688\t}\n  2689\t\n  2690\t// AutoAttestReviewBundle prepares an attestation from the bundle's validated\n  2691\t// evidence and plan dispositions, and records it only when nothing is left for\n  2692\t// a reviewer to answer.\n  2693\t//\n  2694\t// It used to record an `approved` decision for every required criterion,\n  2695\t// including the ones no check reports on. In POSE's own history that produced\n  2696\t// 458 of 470 attestations in which every criterion cites the same single\n  2697\t// evidence reference and no criterion carries a conclusion — `roadmap-outcome`\n  2698\t// has six criteria and not one evidence class, so a roadmap closeout was\n  2699\t// approved in full by whichever result happened to be first in the bundle. The\n  2700\t// collection half of that was always useful and is kept; the approval half is\n  2701\t// what this stops doing (spec pose-abm-review-soundness).\n  2702\tfunc (s Store) AutoAttestReviewBundle(bundleID, reviewer string, apply bool, now time.Time) (ReviewAttestation, error) {\n  2703\t\treturn s.autoAttestReviewBundle(bundleID, reviewer, apply, now)\n  2704\t}\n  2705\t\n  2706\tfunc (s Store) autoAttestReviewBundle(bundleID, reviewer string, apply bool, now time.Time) (ReviewAttestation, error) {\n  2707\t\tprepared, err := s.PrepareReviewAttestation(bundleID, reviewer, now)\n  2708\t\tif err != nil {\n  2709\t\t\treturn ReviewAttestation{}, err\n  2710\t\t}\n  2711\t\tif !prepared.Complete {\n  2712\t\t\tif !apply {\n  2713\t\t\t\treturn prepared.Attestation, nil\n  2714\t\t\t}\n  2715\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: %s\", ReviewPendencySummary(bundleID, prepared.Pending))\n  2716\t\t}\n  2717\t\tif !apply {\n  2718\t\t\treturn prepared.Attestation, nil\n  2719\t\t}\n  2720\t\treturn s.RecordReviewAttestation(prepared.Attestation, now)\n  2721\t}\n  2722\t\n  2723\t// ReviewPendencySummary renders the pendencies as one actionable line: what is\n  2724\t// unanswered, why, and the command that answers it.\n  2725\tfunc ReviewPendencySummary(bundleID string, pending []ReviewAttestationPendency) string {\n  2726\t\tids := make([]string, 0, len(pending))\n  2727\t\tfor _, item := range pending {\n  2728\t\t\tids = append(ids, item.Criterion)\n  2729\t\t}\n  2730\t\tsort.Strings(ids)\n  2731\t\treturn fmt.Sprintf(\"bundle %s has %d criteria awaiting a reviewer's judgment (%s); record them with `pose review attest --criterion ID|passed|<evidence>|<conclusion>` (or `not-applicable`, or `finding`), because no collected evidence answers them\", bundleID, len(pending), strings.Join(ids, \", \"))\n  2732\t}\n  2733\t\n  2734\t// PrepareReviewAttestation answers every criterion automation may answer and\n  2735\t// reports the rest as pendencies. It never writes.\n  2736\tfunc (s Store) PrepareReviewAttestation(bundleID, reviewer string, now time.Time) (ReviewAttestationPreparation, error) {\n  2737\t\tatt, pending, err := s.prepareReviewAttestation(bundleID, reviewer, now)\n  2738\t\tif err != nil {\n  2739\t\t\treturn ReviewAttestationPreparation{}, err\n  2740\t\t}\n  2741\t\treturn ReviewAttestationPreparation{Attestation: att, Pending: pending, Complete: len(pending) == 0}, nil\n  2742\t}\n  2743\t\n  2744\tfunc (s Store) prepareReviewAttestation(bundleID, reviewer string, now time.Time) (ReviewAttestation, []ReviewAttestationPendency, error) {\n  2745\t\tbundle, err := s.LoadReviewBundle(bundleID)\n  2746\t\tif err != nil {\n  2747\t\t\treturn ReviewAttestation{}, nil, err\n  2748\t\t}\n  2749\t\tif reviewer == \"\" {\n  2750\t\t\treviewer = \"agent:auto-attest\"\n  2751\t\t}\n  2752\t\tscope, _ := ParseScopeRef(bundle.Payload.Scope.Ref)\n  2753\t\tgraph, _ := s.GetDeliveryIntegrity(\"\")\n  2754\t\trequiresEvidence := s.reviewScopeRequiresValidationEvidence(scope, bundle.Payload.Plan, graph)\n  2755\t\tif !holdsValidationResult(bundle.Payload.Evidence) && requiresEvidence {\n  2756\t\t\treturn ReviewAttestation{}, nil, fmt.Errorf(\"pose: bundle %s has no passed structured validation evidence\", bundleID)\n  2757\t\t}\n  2758\t\tevidenceRefs := make([]string, 0, len(bundle.Payload.Evidence))\n  2759\t\tbyClass := map[string][]string{}\n  2760\t\tevidenceModule := map[string]string{}\n  2761\t\tfor _, ev := range bundle.Payload.Evidence {\n  2762\t\t\tref := ev.EvidenceClass + \":\" + ev.ID\n  2763\t\t\tevidenceRefs = append(evidenceRefs, ref)\n  2764\t\t\tbyClass[ev.EvidenceClass] = append(byClass[ev.EvidenceClass], ref)\n  2765\t\t\tevidenceModule[ref] = ev.Module\n  2766\t\t}\n  2767\t\t// Pick evidence that answers for the component being asked about. Taking the\n  2768\t\t// first of a class was fine while nothing compared modules; now that the\n  2769\t\t// validator does, it would make this command record an immutable\n  2770\t\t// attestation the engine itself rejects — and `--apply` reports success\n  2771\t\t// before verification ever runs.\n  2772\t\tpickScoped := func(classes []string, components []string) string {\n  2773\t\t\tfor _, class := range classes {\n  2774\t\t\t\tfor _, ref := range byClass[class] {\n  2775\t\t\t\t\tif len(components) == 0 {\n  2776\t\t\t\t\t\treturn ref\n  2777\t\t\t\t\t}\n  2778\t\t\t\t\tfor _, component := range components {\n  2779\t\t\t\t\t\tif moduleMatchesTarget(evidenceModule[ref], component) {\n  2780\t\t\t\t\t\t\treturn ref\n  2781\t\t\t\t\t\t}\n  2782\t\t\t\t\t}\n  2783\t\t\t\t}\n  2784\t\t\t}\n  2785\t\t\treturn \"\"\n  2786\t\t}\n  2787\t\tsort.Strings(evidenceRefs)\n  2788\t\n  2789\t\tjudgmentGoverned, _ := BundleGovernedBy(bundle, \"explicit-judgment\")\n  2790\t\tpending := []ReviewAttestationPendency{}\n  2791\t\tcriteria := make([]ReviewCriterion, 0, len(bundle.Payload.Plan.Criteria))\n  2792\t\tfor _, criterion := range bundle.Payload.Plan.Criteria {\n  2793\t\t\tif !criterion.Required {\n  2794\t\t\t\tcontinue\n  2795\t\t\t}\n  2796\t\t\tif judgmentGoverned && ReviewCriterionKind(criterion) == ReviewCriterionKindJudgment {\n  2797\t\t\t\t// The criterion no check reports on. Collecting evidence for it is\n  2798\t\t\t\t// still useful and still happens — it is sealed in the bundle and\n  2799\t\t\t\t// the reviewer cites it. What stops here is answering on the\n  2800\t\t\t\t// reviewer's behalf.\n  2801\t\t\t\treason := \"no registered check reports on this criterion\"\n  2802\t\t\t\tif len(criterion.EvidenceClasses) > 0 {\n  2803\t\t\t\t\treason = \"the profile asks a reviewer to conclude, even though evidence of class \" + strings.Join(criterion.EvidenceClasses, \"|\") + \" exists\"\n  2804\t\t\t\t}\n  2805\t\t\t\tpending = append(pending, ReviewAttestationPendency{Criterion: criterion.ID, Kind: ReviewCriterionKindJudgment, Reason: reason,\n  2806\t\t\t\t\tCode: \"judgment-unanswered\", Source: bundleID, Condition: DiagnosticCatalog[\"judgment-unanswered\"].Condition})\n  2807\t\t\t\tcontinue\n  2808\t\t\t}\n  2809\t\t\tcritEvidence := pickScoped(criterion.EvidenceClasses, reviewCriterionComponents(bundle.Payload.Plan, criterion))\n  2810\t\t\tif critEvidence == \"\" && len(criterion.EvidenceClasses) == 0 && len(bundle.Payload.Evidence) > 0 {\n  2811\t\t\t\t// A criterion that asks for no particular class is satisfied by any\n  2812\t\t\t\t// sealed evidence. Citing the first is weak, but it is real and in\n  2813\t\t\t\t// the bundle, which is the property that was missing.\n  2814\t\t\t\tfirst := bundle.Payload.Evidence[0]\n  2815\t\t\t\tcritEvidence = first.EvidenceClass + \":\" + first.ID\n  2816\t\t\t}\n  2817\t\t\tif critEvidence == \"\" {\n  2818\t\t\t\t// This used to invent a reference — `<class>:auto-attest`, or the\n  2819\t\t\t\t// first unrelated ref in the bundle, or `docs:auto-attest`. The\n  2820\t\t\t\t// invented ref pointed at nothing, and nothing downstream checked\n  2821\t\t\t\t// it, so the command recorded a passed criterion that no evidence\n  2822\t\t\t\t// supported.\n  2823\t\t\t\t//\n  2824\t\t\t\t// Where the scope is expected to carry validation evidence, the\n  2825\t\t\t\t// honest answer is to refuse: the check exists and was not run, and\n  2826\t\t\t\t// a reviewer must run it or disposition the criterion themselves\n  2827\t\t\t\t// with a reason. Where it is not — a documentation-only spec with no\n  2828\t\t\t\t// delivery target, the case the same distinction already exempts\n  2829\t\t\t\t// above — the criterion is recorded not-applicable, naming what is\n  2830\t\t\t\t// missing. Either way the absence is visible instead of dressed as\n  2831\t\t\t\t// a pass.\n  2832\t\t\t\tif requiresEvidence {\n  2833\t\t\t\t\tif len(criterion.EvidenceClasses) > 0 {\n  2834\t\t\t\t\t\treturn ReviewAttestation{}, nil, fmt.Errorf(\"pose: criterion %s requires evidence class %s and bundle %s seals none; run the check, or record the criterion as not-applicable with a rationale using `pose review attest`\", criterion.ID, strings.Join(criterion.EvidenceClasses, \"|\"), bundleID)\n  2835\t\t\t\t\t}\n  2836\t\t\t\t\treturn ReviewAttestation{}, nil, fmt.Errorf(\"pose: criterion %s has no evidence in bundle %s; run a check, or record the criterion as not-applicable with a rationale using `pose review attest`\", criterion.ID, bundleID)\n  2837\t\t\t\t}\n  2838\t\t\t\trationale := \"the scope carries no delivery target, so no validation evidence is collected for it\"\n  2839\t\t\t\tif len(criterion.EvidenceClasses) > 0 {\n  2840\t\t\t\t\trationale = \"the scope carries no delivery target, so no evidence of class \" + strings.Join(criterion.EvidenceClasses, \"|\") + \" is collected for it\"\n  2841\t\t\t\t}\n  2842\t\t\t\tcriteria = append(criteria, ReviewCriterion{\n  2843\t\t\t\t\tID:          criterion.ID,\n  2844\t\t\t\t\tDisposition: \"not-applicable\",\n  2845\t\t\t\t\tRationale:   rationale,\n  2846\t\t\t\t})\n  2847\t\t\t\tcontinue\n  2848\t\t\t}\n  2849\t\t\tevidenceRefs = append(evidenceRefs, critEvidence)\n  2850\t\t\tcriteria = append(criteria, ReviewCriterion{\n  2851\t\t\t\tID:          criterion.ID,\n  2852\t\t\t\tDisposition: \"passed\",\n  2853\t\t\t\tEvidence:    critEvidence,\n  2854\t\t\t})\n  2855\t\t}\n  2856\t\tevidenceRefs = uniqueSorted(evidenceRefs)\n  2857\t\n  2858\t\ttools := make([]ReviewToolDisposition, 0, len(bundle.Payload.Plan.Tools))\n  2859\t\tfor _, tool := range bundle.Payload.Plan.Tools {\n  2860\t\t\tdisposition := ReviewToolDisposition{\n  2861\t\t\t\tID:        tool.ID,\n  2862\t\t\t\tComponent: tool.Component,\n  2863\t\t\t}\n  2864\t\t\tif containsFold(tool.Preconditions, \"review-complete\") {\n  2865\t\t\t\tdisposition.Disposition = \"deferred\"\n  2866\t\t\t\tdisposition.Rationale = \"post-review gate\"\n  2867\t\t\t} else if tool.ProducerCoverage == \"none\" {\n  2868\t\t\t\t// A fact the engine computed from the matrix, not a judgment: this\n  2869\t\t\t\t// component declares that it runs no check, so nothing can produce\n  2870\t\t\t\t// what the tool asks for. Preparing it here is what keeps the\n  2871\t\t\t\t// reviewer from having to cite another component's result.\n  2872\t\t\t\tdisposition.Disposition = \"not-used\"\n  2873\t\t\t\tdisposition.Rationale = \"the validation matrix declares this component runs no check, so no producer can emit evidence of class \" + strings.Join(tool.EvidenceClasses, \"|\")\n  2874\t\t\t} else if tool.Requiredness == \"recommended\" {\n  2875\t\t\t\tdisposition.Disposition = \"not-used\"\n  2876\t\t\t\tdisposition.Rationale = \"not used during automated attestation\"\n  2877\t\t\t} else {\n  2878\t\t\t\ttoolEv := \"\"\n  2879\t\t\t\ttoolComponents := []string{}\n  2880\t\t\t\tif tool.Component != \"\" {\n  2881\t\t\t\t\ttoolComponents = append(toolComponents, tool.Component)\n  2882\t\t\t\t}\n  2883\t\t\t\ttoolEv = pickScoped(tool.EvidenceClasses, toolComponents)\n  2884\t\t\t\tif toolEv == \"\" && len(tool.EvidenceClasses) == 0 {\n  2885\t\t\t\t\t// A tool that declares no evidence class does not report a\n  2886\t\t\t\t\t// validation result at all — `artifact-check` and `review-check`\n  2887\t\t\t\t\t// are POSE commands, and what supports their disposition is that\n  2888\t\t\t\t\t// the command ran. Naming the tool is a real reference to that;\n  2889\t\t\t\t\t// reaching for an unrelated sealed result, as this used to, said\n  2890\t\t\t\t\t// nothing about whether the tool ran.\n  2891\t\t\t\t\ttoolEv = \"check:\" + tool.ID\n  2892\t\t\t\t}\n  2893\t\t\t\tif toolEv == \"\" {\n  2894\t\t\t\t\t// The same invention the criteria path stopped doing one spec\n  2895\t\t\t\t\t// ago, on the other half of the attestation: `validation:auto-\n  2896\t\t\t\t\t// attest`, `<class>:auto-attest`, `docs:auto-attest` — none of\n  2897\t\t\t\t\t// them pointing at anything, and nothing downstream checking.\n  2898\t\t\t\t\t// The distinction between a judged review and a stamped one\n  2899\t\t\t\t\t// does not survive one half of it being fabricated.\n  2900\t\t\t\t\tif requiresEvidence {\n  2901\t\t\t\t\t\tif len(tool.EvidenceClasses) > 0 {\n  2902\t\t\t\t\t\t\treturn ReviewAttestation{}, nil, fmt.Errorf(\"pose: review tool %s requires evidence class %s and bundle %s seals none; run the tool, or record its disposition with `pose review attest --tool`\", tool.ID, strings.Join(tool.EvidenceClasses, \"|\"), bundleID)\n  2903\t\t\t\t\t\t}\n  2904\t\t\t\t\t\treturn ReviewAttestation{}, nil, fmt.Errorf(\"pose: review tool %s has no evidence in bundle %s; run the tool, or record its disposition with `pose review attest --tool`\", tool.ID, bundleID)\n  2905\t\t\t\t\t}\n  2906\t\t\t\t\t// `deferred`, not `not-used`: a required tool recorded not-used\n  2907\t\t\t\t\t// is a blocker whatever the reason, while a deferral is the\n  2908\t\t\t\t\t// disposition the engine already accepts for a tool whose\n  2909\t\t\t\t\t// precondition this scope cannot meet.\n  2910\t\t\t\t\tdisposition.Disposition = \"deferred\"\n  2911\t\t\t\t\tdisposition.Rationale = \"the scope carries no delivery target, so no evidence this tool reports is collected for it\"\n  2912\t\t\t\t\ttools = append(tools, disposition)\n  2913\t\t\t\t\tcontinue\n  2914\t\t\t\t}\n  2915\t\t\t\tdisposition.Disposition = \"passed\"\n  2916\t\t\t\tdisposition.Evidence = toolEv\n  2917\t\t\t}\n  2918\t\t\ttools = append(tools, disposition)\n  2919\t\t}\n  2920\t\n  2921\t\tdecision := \"approved\"\n  2922\t\tif len(pending) > 0 {\n  2923\t\t\t// A preparation that still owes answers is not an approval waiting to\n  2924\t\t\t// be written. Naming the decision `changes-requested` keeps the object\n  2925\t\t\t// honest if anything persists it anyway: the verifier refuses it, which\n  2926\t\t\t// is the correct outcome for a review nobody finished.\n  2927\t\t\tdecision = \"changes-requested\"\n  2928\t\t}\n  2929\t\tatt := ReviewAttestation{\n  2930\t\t\tBundleID:     bundle.BundleID,\n  2931\t\t\tBundleDigest: bundle.BundleDigest,\n  2932\t\t\tReviewer:     reviewer,\n  2933\t\t\tDecision:     decision,\n  2934\t\t\tCriteria:     criteria,\n  2935\t\t\tTools:        tools,\n  2936\t\t\tEvidenceRefs: evidenceRefs,\n  2937\t\t\tFindings:     []ReviewFinding{},\n  2938\t\t}\n  2939\t\tsort.Slice(pending, func(i, j int) bool { return pending[i].Criterion < pending[j].Criterion })\n  2940\t\treturn att, pending, nil\n  2941\t}\n  2942\t\n  2943\t// RecordReviewAttestation appends an immutable decision for one sealed bundle.\n  2944\tfunc (s Store) RecordReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n  2945\t\tvar result ReviewAttestation\n  2946\t\terr := s.withReviewAttestationWriteGuard(\"review.attestation.record\", att, func(guarded Store) error {\n  2947\t\t\tvar err error\n  2948\t\t\tresult, err = guarded.recordReviewAttestation(att, now, false)\n  2949\t\t\treturn err\n  2950\t\t})\n  2951\t\treturn result, err\n  2952\t}\n  2953\t\n  2954\tfunc (s Store) recordReviewAttestation(att ReviewAttestation, now time.Time, signed bool) (ReviewAttestation, error) {\n  2955\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n  2956\t\tif err != nil {\n  2957\t\t\treturn ReviewAttestation{}, err\n  2958\t\t}\n  2959\t\tpolicy, _, err := s.loadReviewPolicy()\n  2960\t\tif err != nil {\n  2961\t\t\treturn ReviewAttestation{}, err\n  2962\t\t}\n  2963\t\tif policy.RequireSignedAttestations && !signed {\n  2964\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review policy requires a trusted signed attestation envelope\")\n  2965\t\t}\n  2966\t\tatt, err = completeReviewAttestation(bundle, att, now)\n  2967\t\tif err != nil {\n  2968\t\t\treturn ReviewAttestation{}, err\n  2969\t\t}\n  2970\t\t// The approval preflight runs here, in the one writer every channel shares,\n  2971\t\t// before anything is written: an approval the verifier would reject is\n  2972\t\t// refused, not recorded and rejected later (spec\n  2973\t\t// pose-review-approval-domain-preflight).\n  2974\t\tif blockers := s.reviewApprovalAdmissionBlockers(bundle, att, now); len(blockers) > 0 {\n  2975\t\t\treturn ReviewAttestation{}, &ReviewApprovalRefusal{BundleID: bundle.BundleID, Blockers: blockers}\n  2976\t\t}\n  2977\t\tatt.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", att.AttestationID+\".json\"))\n  2978\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), true)\n  2979\t\tif err != nil {\n  2980\t\t\treturn ReviewAttestation{}, err\n  2981\t\t}\n  2982\t\tpath := filepath.Join(dir, att.AttestationID+\".json\")\n  2983\t\tif existing, loadErr := s.LoadReviewAttestation(att.AttestationID); loadErr == nil {\n  2984\t\t\texistingRaw, _ := json.Marshal(existing)\n  2985\t\t\tcandidateRaw, _ := json.Marshal(att)\n  2986\t\t\tif bytes.Equal(existingRaw, candidateRaw) {\n  2987\t\t\t\treturn existing, nil\n  2988\t\t\t}\n  2989\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation identity collision for %s\", att.AttestationID)\n  2990\t\t}\n  2991\t\traw, err := json.MarshalIndent(att, \"\", \"  \")\n  2992\t\tif err != nil {\n  2993\t\t\treturn ReviewAttestation{}, err\n  2994\t\t}\n  2995\t\tif err := writeImmutableJSONIn(s.fsys(), path, append(raw, '\\n')); err != nil {\n  2996\t\t\tvar durability *PublishDurabilityError\n  2997\t\t\tif errors.As(err, &durability) {\n  2998\t\t\t\treturn att, err\n  2999\t\t\t}\n  3000\t\t\treturn ReviewAttestation{}, err\n  3001\t\t}\n  3002\t\treturn att, nil\n  3003\t}\n  3004\t\n  3005\t// completeReviewAttestation fills and checks what recording sets: the bundle\n  3006\t// binding, schema, attested time and content-derived id. Recording and the MCP\n  3007\t// preview share it, so an issuer that signs a previewed attestation signs the\n  3008\t// bytes that will be recorded (spec pose-mcp-review-attest-signed-only).\n  3009\tfunc completeReviewAttestation(bundle ReviewBundle, att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n  3010\t\tif att.Limitations == nil {\n  3011\t\t\tatt.Limitations = append([]string(nil), bundle.Payload.Plan.Limitations...)\n  3012\t\t}\n  3013\t\tif strings.Join(att.Limitations, \"\\x00\") != strings.Join(bundle.Payload.Plan.Limitations, \"\\x00\") {\n  3014\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation must retain the sealed review limitations\")\n  3015\t\t}\n  3016\t\tif att.BundleDigest == \"\" {\n  3017\t\t\tatt.BundleDigest = bundle.BundleDigest\n  3018\t\t}\n  3019\t\tif att.BundleDigest != bundle.BundleDigest {\n  3020\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation bundle digest mismatch\")\n  3021\t\t}\n  3022\t\tif att.Reviewer == \"\" || strings.ContainsAny(att.Reviewer, \"\\r\\n\") || (!strings.HasPrefix(att.Reviewer, \"agent:\") && !strings.HasPrefix(att.Reviewer, \"human:\")) {\n  3023\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid reviewer execution identity\")\n  3024\t\t}\n  3025\t\tif att.Decision != \"approved\" && att.Decision != \"approved-with-reservations\" && att.Decision != \"changes-requested\" && att.Decision != \"rejected\" {\n  3026\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid review decision %q\", att.Decision)\n  3027\t\t}\n  3028\t\tif err := ValidateReviewAttribution(att); err != nil {\n  3029\t\t\treturn ReviewAttestation{}, err\n  3030\t\t}\n  3031\t\tatt.SchemaVersion = ReviewBundleSchemaVersion\n  3032\t\tif att.AttestedAt == \"\" {\n  3033\t\t\tatt.AttestedAt = now.UTC().Truncate(time.Second).Format(time.RFC3339)\n  3034\t\t} else if _, err := time.Parse(time.RFC3339, att.AttestedAt); err != nil {\n  3035\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attested_at must be RFC3339\")\n  3036\t\t}\n  3037\t\tatt.BundleID = bundle.BundleID\n  3038\t\tatt.BundleDigest = bundle.BundleDigest\n  3039\t\texpectedAttestationID := reviewAttestationID(att)\n  3040\t\tif att.AttestationID == \"\" {\n  3041\t\t\tatt.AttestationID = expectedAttestationID\n  3042\t\t} else if att.AttestationID != expectedAttestationID {\n  3043\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation id does not match its content digest\")\n  3044\t\t}\n  3045\t\tif !strings.HasPrefix(att.AttestationID, \"rva-\") || len(att.AttestationID) != 20 {\n  3046\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid attestation id\")\n  3047\t\t}\n  3048\t\treturn att, nil\n  3049\t}\n  3050\t\n  3051\t// SignableReviewAttestation completes a draft attestation for its sealed bundle\n  3052\t// as recording would, including the confirmation digest when the draft names a\n  3053\t// confirming principal, and returns it with the canonical bytes a trusted\n  3054\t// issuer signs into a ReviewAttestationEnvelope. It records nothing.\n  3055\tfunc (s Store) SignableReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, []byte, error) {\n  3056\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n  3057\t\tif err != nil {\n  3058\t\t\treturn ReviewAttestation{}, nil, err\n  3059\t\t}\n  3060\t\tif att.BundleDigest == \"\" {\n  3061\t\t\tatt.BundleDigest = bundle.BundleDigest\n  3062\t\t}\n  3063\t\tif a := att.Attribution; a != nil && a.ConfirmedBy != \"\" && a.ConfirmationDigest == \"\" {\n  3064\t\t\tbound := *a\n  3065\t\t\tbound.ConfirmationDigest = ReviewConfirmationDigest(att)\n  3066\t\t\tatt.Attribution = &bound\n  3067\t\t}\n  3068\t\tatt.Path, att.Envelope = \"\", nil\n  3069\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\n  3070\t\tif err != nil {\n  3071\t\t\treturn ReviewAttestation{}, nil, err\n  3072\t\t}\n  3073\t\tcanonical, err := json.Marshal(completed)\n  3074\t\tif err != nil {\n  3075\t\t\treturn ReviewAttestation{}, nil, err\n  3076\t\t}\n  3077\t\treturn completed, canonical, nil\n  3078\t}\n  3079\t\n  3080\t// RecordReviewAttestationEnvelope verifies a trusted issuer's envelope and,\n  3081\t// with apply, records the attestation it carries: the path both\n  3082\t// `pose review attest --envelope` and the MCP tool take.\n  3083\tfunc (s Store) RecordReviewAttestationEnvelope(envelope ReviewAttestationEnvelope, apply bool) (ReviewAttestation, error) {\n  3084\t\tif !apply {\n  3085\t\t\treturn s.VerifyReviewAttestationEnvelope(envelope)\n  3086\t\t}\n  3087\t\tvar result ReviewAttestation\n  3088\t\terr := s.withReviewAttestationWriteGuard(\"review.attestation.envelope\", envelope.Attestation, func(guarded Store) error {\n  3089\t\t\tattestation, err := guarded.VerifyReviewAttestationEnvelope(envelope)\n  3090\t\t\tif err != nil {\n  3091\t\t\t\treturn err\n  3092\t\t\t}\n  3093\t\t\tresult, err = guarded.recordReviewAttestation(attestation, guarded.reviewClock(), true)\n  3094\t\t\treturn err\n  3095\t\t})\n  3096\t\treturn result, err\n  3097\t}\n  3098\t\n  3099\t// ErrReviewApprovalRefused classifies a ReviewApprovalRefusal for errors.Is.\n  3100\tvar ErrReviewApprovalRefused = errors.New(\"pose: review approval refused before persistence\")\n  3101\t\n  3102\t// ReviewApprovalRefusal is the typed result of the domain approval preflight:\n  3103\t// every reason the verifier would reject the approval, returned before any\n  3104\t// artifact of the attempt is written. Every channel — Store, CLI, signed\n  3105\t// import and MCP — receives this same value.\n  3106\ttype ReviewApprovalRefusal struct {\n  3107\t\tBundleID string   `json:\"bundle_id\"`\n  3108\t\tBlockers []string `json:\"blockers\"`\n  3109\t}\n  3110\t\n  3111\tfunc (e *ReviewApprovalRefusal) Error() string {\n  3112\t\treturn \"pose: verify would reject this approval for bundle \" + e.BundleID + \", so nothing was written: \" + strings.Join(e.Blockers, \"; \")\n  3113\t}\n  3114\t\n  3115\tfunc (e *ReviewApprovalRefusal) Unwrap() error { return ErrReviewApprovalRefused }\n  3116\t\n  3117\tfunc reviewDecisionApproves(decision string) bool {\n  3118\t\treturn decision == \"approved\" || decision == \"approved-with-reservations\"\n  3119\t}\n  3120\t\n  3121\t// reviewApprovalAdmissionBlockers is the semantic admission of a new approving\n  3122\t// attestation, completed as it will be recorded. It reuses the verifier itself\n  3123\t// over the bundle's sealed gates and the deliberately live signing and trust\n  3124\t// requirements, adds the time admissibility of a new operation, and requires\n  3125\t// the bundle to still be the current sealed subject of its scope, so the\n  3126\t// approval of a stale preview or of a superseded bundle is not written.\n  3127\t//\n  3128\t// A non-approving decision is an audit record the verifier rejects for\n  3129\t// closeout by definition, so its criteria are not held to the approval bar;\n  3130\t// its channel's authentication still applies in the writer.\n  3131\tfunc (s Store) reviewApprovalAdmissionBlockers(bundle ReviewBundle, att ReviewAttestation, now time.Time) []string {\n  3132\t\tif !reviewDecisionApproves(att.Decision) {\n  3133\t\t\treturn nil\n  3134\t\t}\n  3135\t\tblockers := s.atReviewTime(now).validateBundleAttestation(bundle, att)\n  3136\t\tblockers = append(blockers, reviewNewOperationTimeBlockers(att, now)...)\n  3137\t\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n  3138\t\tswitch {\n  3139\t\tcase err != nil:\n  3140\t\t\tblockers = append(blockers, \"the current review subject of \"+bundle.Payload.Scope.Ref+\" cannot be established: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n  3141\t\tcase current == nil:\n  3142\t\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" no longer represents the current semantic inputs of \"+bundle.Payload.Scope.Ref+\"; seal the current bundle and review it\")\n  3143\t\tcase current.BundleID != bundle.BundleID:\n  3144\t\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" is superseded by \"+current.BundleID+\"; review the current bundle\")\n  3145\t\t}\n  3146\t\treturn uniqueSorted(blockers)\n  3147\t}\n  3148\t\n  3149\t// PreflightReviewAttestation returns the reasons the domain writer would\n  3150\t// refuse an approving attestation, without writing anything. It completes the\n  3151\t// attestation exactly as recording would and runs the same admission, so a\n  3152\t// preview and the write cannot disagree (specs\n  3153\t// pose-attest-refuses-what-verify-rejects, pose-review-approval-domain-preflight).\n  3154\tfunc (s Store) PreflightReviewAttestation(att ReviewAttestation, now time.Time) []string {\n  3155\t\tif !reviewDecisionApproves(att.Decision) {\n  3156\t\t\treturn nil\n  3157\t\t}\n  3158\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n  3159\t\tif err != nil {\n  3160\t\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n  3161\t\t}\n  3162\t\tatt.Path = \"\"\n  3163\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\n  3164\t\tif err != nil {\n  3165\t\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n  3166\t\t}\n  3167\t\treturn s.reviewApprovalAdmissionBlockers(bundle, completed, now)\n  3168\t}\n  3169\t\n  3170\t// VerifyReviewAttestationEnvelope verifies an optional provider-neutral\n  3171\t// Ed25519 envelope. Trust is pinned as <issuer>#sha256:<public-key-digest> in\n  3172\t// review policy; a self-declared issuer or public key is never trusted alone.\n  3173\tfunc (s Store) VerifyReviewAttestationEnvelope(envelope ReviewAttestationEnvelope) (ReviewAttestation, error) {\n  3174\t\tif envelope.SchemaVersion != ReviewBundleSchemaVersion || envelope.Algorithm != \"ed25519\" {\n  3175\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: unsupported review attestation envelope\")\n  3176\t\t}\n  3177\t\tif envelope.Subject != envelope.Attestation.BundleID || envelope.Issuer == \"\" || strings.ContainsAny(envelope.Issuer, \"\\r\\n\") {\n  3178\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation envelope subject or issuer mismatch\")\n  3179\t\t}\n  3180\t\tpublicKey, err := base64.StdEncoding.DecodeString(envelope.PublicKey)\n  3181\t\tif err != nil || len(publicKey) != ed25519.PublicKeySize {\n  3182\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid Ed25519 public key\")\n  3183\t\t}\n  3184\t\tsignature, err := base64.StdEncoding.DecodeString(envelope.Signature)\n  3185\t\tif err != nil || len(signature) != ed25519.SignatureSize {\n  3186\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid Ed25519 signature\")\n  3187\t\t}\n  3188\t\tpolicy, _, err := s.loadReviewPolicy()\n  3189\t\tif err != nil {\n  3190\t\t\treturn ReviewAttestation{}, err\n  3191\t\t}\n  3192\t\tpin := envelope.Issuer + \"#\" + digestBytes(publicKey)\n  3193\t\ttrusted := false\n  3194\t\tfor _, candidate := range policy.TrustedAttestationIssuers {\n  3195\t\t\tif candidate == pin {\n  3196\t\t\t\ttrusted = true\n  3197\t\t\t\tbreak\n  3198\t\t\t}\n  3199\t\t}\n  3200\t\tif !trusted {\n  3201\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: untrusted review attestation issuer or public key\")\n  3202\t\t}\n  3203\t\tattestation := envelope.Attestation\n  3204\t\tattestation.Path = \"\"\n  3205\t\tattestation.Envelope = nil\n  3206\t\traw, err := json.Marshal(attestation)\n  3207\t\tif err != nil || !ed25519.Verify(ed25519.PublicKey(publicKey), raw, signature) {\n  3208\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation signature verification failed\")\n  3209\t\t}\n  3210\t\tbundle, err := s.LoadReviewBundle(attestation.BundleID)\n  3211\t\tif err != nil {\n  3212\t\t\treturn ReviewAttestation{}, err\n  3213\t\t}\n  3214\t\tif attestation.BundleDigest != bundle.BundleDigest {\n  3215\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: signed attestation does not bind the exact bundle\")\n  3216\t\t}\n  3217\t\tattestation.Envelope = &ReviewAttestationSignature{Issuer: envelope.Issuer, Subject: envelope.Subject, Algorithm: envelope.Algorithm, PublicKey: envelope.PublicKey, Signature: envelope.Signature}\n  3218\t\treturn attestation, nil\n  3219\t}\n  3220\t\n  3221\tfunc (s Store) ImportReviewAttestationEnvelope(rel string, apply bool) (ReviewAttestation, error) {\n  3222\t\treadEnvelope := func(store Store) (ReviewAttestationEnvelope, error) {\n  3223\t\t\tif err := ValidateArtifactPathIn(store.fsys(), store.Root, rel, false); err != nil {\n  3224\t\t\t\treturn ReviewAttestationEnvelope{}, fmt.Errorf(\"pose: invalid attestation envelope path: %w\", err)\n  3225\t\t\t}\n  3226\t\t\tclean, _ := validateArtifactPathSyntax(rel)\n  3227\t\t\tvar envelope ReviewAttestationEnvelope\n  3228\t\t\tif err := strictJSONFileIn(store.fsys(), filepath.Join(store.Root, clean), &envelope); err != nil {\n  3229\t\t\t\treturn ReviewAttestationEnvelope{}, fmt.Errorf(\"pose: reading review attestation envelope: %w\", err)\n  3230\t\t\t}\n  3231\t\t\treturn envelope, nil\n  3232\t\t}\n  3233\t\tif !apply {\n  3234\t\t\tenvelope, err := readEnvelope(s)\n  3235\t\t\tif err != nil {\n  3236\t\t\t\treturn ReviewAttestation{}, err\n  3237\t\t\t}\n  3238\t\t\treturn s.RecordReviewAttestationEnvelope(envelope, false)\n  3239\t\t}\n  3240\t\tpreflight, err := readEnvelope(s)\n  3241\t\tif err != nil {\n  3242\t\t\treturn ReviewAttestation{}, err\n  3243\t\t}\n  3244\t\tlockedProjects, err := s.reviewAttestationProjectSet(preflight.Attestation)\n  3245\t\tif err != nil {\n  3246\t\t\treturn ReviewAttestation{}, err\n  3247\t\t}\n  3248\t\tvar result ReviewAttestation\n  3249\t\terr = s.withExplicitGovernanceWriteGuard(\"review.attestation.import\", governanceProjectIDs(lockedProjects), func(guarded Store) error {\n  3250\t\t\tfreshEnvelope, err := readEnvelope(guarded)\n  3251\t\t\tif err != nil {\n  3252\t\t\t\treturn err\n  3253\t\t\t}\n  3254\t\t\tobservedProjects, err := guarded.reviewAttestationProjectSet(freshEnvelope.Attestation)\n  3255\t\t\tif err != nil {\n  3256\t\t\t\treturn err\n  3257\t\t\t}\n  3258\t\t\tif err := requireSameGovernanceProjectSet(\"review.attestation.import\", lockedProjects, observedProjects); err != nil {\n  3259\t\t\t\treturn err\n  3260\t\t\t}\n  3261\t\t\tattestation, err := guarded.VerifyReviewAttestationEnvelope(freshEnvelope)\n  3262\t\t\tif err != nil {\n  3263\t\t\t\treturn err\n  3264\t\t\t}\n  3265\t\t\tresult, err = guarded.recordReviewAttestation(attestation, guarded.reviewClock(), true)\n  3266\t\t\treturn err\n  3267\t\t})\n  3268\t\treturn result, err\n  3269\t}\n  3270\t\n  3271\tfunc (s Store) LoadReviewAttestation(id string) (ReviewAttestation, error) {\n  3272\t\tif !strings.HasPrefix(id, \"rva-\") || len(id) != 20 {\n  3273\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid review attestation id %q\", id)\n  3274\t\t}\n  3275\t\tvar att ReviewAttestation\n  3276\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), false)\n  3277\t\tif err != nil {\n  3278\t\t\treturn ReviewAttestation{}, err\n  3279\t\t}\n  3280\t\tpath := filepath.Join(dir, id+\".json\")\n  3281\t\tif err := strictJSONFileIn(s.fsys(), path, &att); err != nil {\n  3282\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: reading review attestation %s: %w\", id, err)\n  3283\t\t}\n  3284\t\tif att.SchemaVersion != ReviewBundleSchemaVersion || att.AttestationID != id {\n  3285\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: malformed review attestation %s\", id)\n  3286\t\t}\n  3287\t\tif reviewAttestationID(att) != id {\n  3288\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation %s content digest mismatch\", id)\n  3289\t\t}\n  3290\t\tif _, ok := reviewInstant(att.AttestedAt); !ok {\n  3291\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation %s has no valid attested_at\", id)\n  3292\t\t}\n  3293\t\tatt.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", id+\".json\"))\n  3294\t\treturn att, nil\n  3295\t}\n  3296\t\n  3297\tfunc (s Store) ListReviewAttestations(bundleID string) ([]ReviewAttestation, error) {\n  3298\t\tread, err := s.ReadReviewAttestations(bundleID)\n  3299\t\treturn read.Attestations, err\n  3300\t}\n  3301\t\n  3302\t// ReviewAttestationsRead is the attestations a read found and the records it could not\n  3303\t// read. An attestation that is lost may be the later one, a rejection among them: the\n  3304\t// last attestation read is the current one only if nothing that concerns the bundle\n  3305\t// was lost.\n  3306\ttype ReviewAttestationsRead struct {\n  3307\t\tAttestations []ReviewAttestation\n  3308\t\tCoverage     SourceCoverage\n  3309\t}\n  3310\t\n  3311\t// ReadReviewAttestations lists attestations and reports the records it could not read,\n  3312\t// attributed to the bundle their readable prefix names. With a bundle, a record that\n  3313\t// names another bundle is not a loss for this one; one that names none is, because it may\n  3314\t// be a rejection of this bundle.\n  3315\tfunc (s Store) ReadReviewAttestations(bundleID string) (ReviewAttestationsRead, error) {\n  3316\t\tcoverage := SourceCoverage{Losses: []SourceLoss{}}\n  3317\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), false)\n  3318\t\tif os.IsNotExist(err) {\n  3319\t\t\treturn ReviewAttestationsRead{Attestations: []ReviewAttestation{}, Coverage: coverage}, nil\n  3320\t\t}\n  3321\t\tif err != nil {\n  3322\t\t\treturn ReviewAttestationsRead{}, err\n  3323\t\t}\n  3324\t\tentries, err := s.fsys().ReadDir(dir)\n  3325\t\tif os.IsNotExist(err) {\n  3326\t\t\treturn ReviewAttestationsRead{Attestations: []ReviewAttestation{}, Coverage: coverage}, nil\n  3327\t\t}\n  3328\t\tif err != nil {\n  3329\t\t\treturn ReviewAttestationsRead{}, err\n  3330\t\t}\n  3331\t\tresult := []ReviewAttestation{}\n  3332\t\tfor _, entry := range entries {\n  3333\t\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n  3334\t\t\t\tcontinue\n  3335\t\t\t}\n  3336\t\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n  3337\t\t\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", entry.Name()))\n  3338\t\t\tif bundleID != \"\" {\n  3339\t\t\t\traw, err := s.fsys().ReadFile(filepath.Join(dir, entry.Name()))\n  3340\t\t\t\tif err != nil {\n  3341\t\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossReadError, Detail: err.Error()})\n  3342\t\t\t\t\tcontinue\n  3343\t\t\t\t}\n  3344\t\t\t\tvar header struct {\n  3345\t\t\t\t\tBundleID string `json:\"bundle_id\"`\n  3346\t\t\t\t}\n  3347\t\t\t\tif err := json.Unmarshal(raw, &header); err != nil {\n  3348\t\t\t\t\tcoverage.Add(attributeLoss(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: \"the record is not valid JSON\"}, raw, \"bundle_id\"))\n  3349\t\t\t\t\tcontinue\n  3350\t\t\t\t}\n  3351\t\t\t\tif _, _, ambiguous := sniffJSONString(raw, \"bundle_id\"); ambiguous {\n  3352\t\t\t\t\t// A repeated name is valid JSON whose decoder keeps the last one: which\n  3353\t\t\t\t\t// bundle the record belongs to is not settled, so it is not another's.\n  3354\t\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossInvalid, Detail: \"the record names its bundle more than once\"})\n  3355\t\t\t\t\tcontinue\n  3356\t\t\t\t}\n  3357\t\t\t\tif header.BundleID == \"\" {\n  3358\t\t\t\t\t// Valid JSON that names no bundle is not another bundle's attestation.\n  3359\t\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: \"the record names no bundle\"})\n  3360\t\t\t\t\tcontinue\n  3361\t\t\t\t}\n  3362\t\t\t\tif header.BundleID != bundleID {\n  3363\t\t\t\t\tcontinue\n  3364\t\t\t\t}\n  3365\t\t\t}\n  3366\t\t\tatt, loadErr := s.LoadReviewAttestation(id)\n  3367\t\t\tif loadErr != nil {\n  3368\t\t\t\tif bundleID != \"\" {\n  3369\t\t\t\t\treturn ReviewAttestationsRead{}, loadErr\n  3370\t\t\t\t}\n  3371\t\t\t\tloss := SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: loadErr.Error()}\n  3372\t\t\t\tif raw, readErr := s.fsys().ReadFile(filepath.Join(dir, entry.Name())); readErr == nil {\n  3373\t\t\t\t\tif futureSchema(raw) {\n  3374\t\t\t\t\t\tloss.Kind, loss.Detail = LossUnsupported, \"the record has a schema_version this engine does not read\"\n  3375\t\t\t\t\t}\n  3376\t\t\t\t\tloss = attributeLoss(loss, raw, \"bundle_id\")\n  3377\t\t\t\t} else {\n  3378\t\t\t\t\tloss.Kind, loss.Detail = LossReadError, readErr.Error()\n  3379\t\t\t\t}\n  3380\t\t\t\tcoverage.Add(loss)\n  3381\t\t\t\tcontinue\n  3382\t\t\t}\n  3383\t\t\tif bundleID == \"\" || att.BundleID == bundleID {\n  3384\t\t\t\tresult = append(result, att)\n  3385\t\t\t}\n  3386\t\t}\n  3387\t\tsort.Slice(result, func(i, j int) bool {\n  3388\t\t\t// By instant: \"04:02-08:00\" is later than \"12:01Z\", whatever the text says.\n  3389\t\t\treturn attestationLess(result[i], result[j])\n  3390\t\t})\n  3391\t\tcoverage.Normalize()\n  3392\t\treturn ReviewAttestationsRead{Attestations: result, Coverage: coverage}, nil\n  3393\t}\n  3394\t\n  3395\t// futureSchema reports well-formed JSON whose schema_version is one this engine does not read.\n  3396\tfunc futureSchema(raw []byte) bool {\n  3397\t\tvar header struct {\n  3398\t\t\tSchemaVersion int `json:\"schema_version\"`\n  3399\t\t}\n  3400\t\tif json.Unmarshal(raw, &header) != nil {\n  3401\t\t\treturn false\n  3402\t\t}\n  3403\t\treturn header.SchemaVersion > ReviewBundleSchemaVersion\n  3404\t}\n  3405\t\n  3406\tfunc (s Store) VerifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n  3407\t\ts = s.reviewOperation()\n  3408\t\tverification, err := s.verifyReviewBundle(scope)\n  3409\t\tif err == nil && verification.Bundle != nil {\n  3410\t\t\tassurance := s.DescribeReviewAssurance(*verification.Bundle, verification.Attestation)\n  3411\t\t\tverification.Assurance = &assurance\n  3412\t\t}\n  3413\t\tif err == nil {\n  3414\t\t\tverification.DelegatedRuns, verification.DelegatedHistoryLosses = s.reviewRunSummaries(scope)\n  3415\t\t}\n  3416\t\tif err == nil && verification.Bundle != nil {\n  3417\t\t\tif round, rerr := s.ReviewRoundOf(*verification.Bundle); rerr != nil {\n  3418\t\t\t\tverification.DelegatedHistoryLosses = append(verification.DelegatedHistoryLosses, \"the round cannot be derived: \"+rerr.Error())\n  3419\t\t\t} else {\n  3420\t\t\t\tverification.Round = round.Number\n  3421\t\t\t\tpolicy, _, _, _ := s.LoadDelegationPolicy()\n  3422\t\t\t\tif threshold := policy.Routing.RoundThresholdOf(); round.Number >= threshold {\n  3423\t\t\t\t\tverification.Warnings = append(verification.Warnings, fmt.Sprintf(\"%s is in review round %d, at or past the round threshold %d: the rounds are not converging; consider a different agent or a human adjudication\", scope, round.Number, threshold))\n  3424\t\t\t\t}\n  3425\t\t\t}\n  3426\t\t}\n  3427\t\treturn verification, err\n  3428\t}\n  3429\t\n  3430\t// verifyReviewBundle verifies scope once per operation of the same project and\n  3431\t// resolver, and refuses a scope already being verified: sealed children are\n  3432\t// data, and a cycle among them must end in a named refusal (spec\n  3433\t// pose-review-approval-follows-children R6).\n  3434\tfunc (s Store) verifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n  3435\t\ts = s.reviewOperation()\n  3436\t\tstate := s.reviewReuse\n  3437\t\tkey := fmt.Sprintf(\"%s\\x00%t\\x00%s\", s.Root, s.FederatedResolver != nil, scope)\n  3438\t\tif result, ok := state.children[key]; ok {\n  3439\t\t\treturn result.verification, result.err\n  3440\t\t}\n  3441\t\tif state.verifying[key] {\n  3442\t\t\treturn ReviewBundleVerification{}, fmt.Errorf(\"pose: the sealed children of %s form a cycle\", scope)\n  3443\t\t}\n  3444\t\tstate.verifying[key] = true\n  3445\t\tdefer delete(state.verifying, key)\n  3446\t\tif s.onReviewVerify != nil {\n  3447\t\t\ts.onReviewVerify(scope)\n  3448\t\t}\n  3449\t\tverification, err := s.proportionalReviewVerification(scope)\n  3450\t\tstate.children[key] = childVerificationResult{verification, err}\n  3451\t\treturn verification, err\n  3452\t}\n  3453\t\n  3454\t// proportionalReviewVerification is the verification of a scope, and of a milestone that\n  3455\t// owes no review of its own: one made of a single closed, approved spec, or one a roadmap\n  3456\t// declares. Every reader of an approval comes through here, so they give one answer (ADR\n  3457\t// a-milestone-of-one-member-is-that-member). A negative review recorded on it stands.\n  3458\tfunc (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerification, error) {\n  3459\t\town, err := s.computeReviewVerification(scope)\n  3460\t\tif err != nil || own.Approved {\n  3461\t\t\treturn own, err\n  3462\t\t}\n  3463\t\tref, parseErr := ParseScopeRef(scope)\n  3464\t\tif parseErr != nil || (ref.Kind != \"milestone\" && ref.Kind != \"roadmap\") {\n  3465\t\t\treturn own, nil\n  3466\t\t}\n  3467\t\t// A policy without bundles answers through its review attempts alone, and has no\n  3468\t\t// bundle of the spec to stand on.\n  3469\t\tpolicy, err := s.GetReviewPolicy()\n  3470\t\tif err != nil || !policy.ReviewBundles {\n  3471\t\t\treturn own, nil\n  3472\t\t}\n  3473\t\tif s.milestoneReviewRefused(scope) {\n  3474\t\t\treturn own, nil\n  3475\t\t}\n  3476\t\t// An adopted closeout review policy is the only rule for an open scope:\n  3477\t\t// legacy inheritance and declared exemptions cannot weaken `always`, and\n  3478\t\t// the policy's own exemption reads the same gate as reviewCheck. A roadmap\n  3479\t\t// closed before adoption keeps the legacy reading below.\n  3480\t\tadopted := policy.CloseoutReviewAdopted() && !s.closeoutScopeHistorical(ref)\n  3481\t\tif adopted {\n  3482\t\t\tdecision, exempt, gateErr := s.closeoutReviewGate(scope, policy)\n  3483\t\t\tif gateErr != nil || decision == nil || !exempt || !decision.Known {\n  3484\t\t\t\treturn own, nil\n  3485\t\t\t}\n  3486\t\t\tif ref.Kind == \"milestone\" && s.FederatedResolver != nil {\n  3487\t\t\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n  3488\t\t\t\tif err != nil || !acceptance.Ready {\n  3489\t\t\t\t\treturn own, nil\n  3490\t\t\t\t}\n  3491\t\t\t}\n  3492\t\t\treturn ReviewBundleVerification{\n  3493\t\t\t\tScope: scope, State: \"closed\", Fresh: true, Approved: true, NextAction: \"none\",\n  3494\t\t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n  3495\t\t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n  3496\t\t\t}, nil\n  3497\t\t}\n  3498\t\tif ref.Kind != \"milestone\" {\n  3499\t\t\treturn own, nil\n  3500\t\t}\n  3501\t\t// Edges still bind: a milestone inherits a review, not the acceptance of what it\n  3502\t\t// depends on, and revoked trust or an open predecessor leaves it where it was.\n  3503\t\tif s.FederatedResolver != nil {\n  3504\t\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n  3505\t\t\tif err != nil || !acceptance.Ready {\n  3506\t\t\t\treturn own, nil\n  3507\t\t\t}\n  3508\t\t}\n  3509\t\tif member, ok := s.soleMemberOf(ref); ok {\n  3510\t\t\tchild, err := s.verifyReviewBundle(\"spec:\" + member)\n  3511\t\t\tif err == nil && child.State == \"closed\" && child.Fresh && child.Approved {\n  3512\t\t\t\treturn ReviewBundleVerification{\n  3513\t\t\t\t\tScope: scope, State: \"closed\", Bundle: child.Bundle, Attestation: child.Attestation, Fresh: true, Approved: true,\n  3514\t\t\t\t\tNextAction: \"none\", Warnings: []string{\"the approval of \" + scope + \" is inherited from spec:\" + member + \", its only member\"},\n  3515\t\t\t\t\tApprovalOrigin: \"inherited:spec:\" + member, inherited: true,\n  3516\t\t\t\t}, nil\n  3517\t\t\t}\n  3518\t\t}\n  3519\t\tif reason := s.declaredUnreviewed(ref); reason != \"\" {\n  3520\t\t\treturn ReviewBundleVerification{\n  3521\t\t\t\tScope: scope, State: \"closed\", Fresh: true, Approved: true, NextAction: \"none\",\n  3522\t\t\t\tWarnings:       []string{scope + \" stands without a review, as its roadmap declares: \" + reason},\n  3523\t\t\t\tApprovalOrigin: \"declared:roadmap:\" + ref.Roadmap, inherited: true,\n  3524\t\t\t}, nil\n  3525\t\t}\n  3526\t\treturn own, nil\n  3527\t}\n  3528\t\n  3529\t// milestoneReviewRefused reports a refusal recorded on the milestone itself, in a bundle\n  3530\t// or in a legacy attempt.\n  3531\tfunc (s Store) milestoneReviewRefused(scope string) bool {\n  3532\t\tif bundle, _ := s.latestNegativeReview(scope); bundle != nil {\n  3533\t\t\treturn true\n  3534\t\t}\n  3535\t\tattempts, err := s.ReadReviewAttempts(scope)\n  3536\t\tif err != nil || !attempts.Coverage.CompleteFor(scope) {\n  3537\t\t\treturn true\n  3538\t\t}\n  3539\t\tif len(attempts.Attempts) == 0 {\n  3540\t\t\treturn false\n  3541\t\t}\n  3542\t\tlatest := attempts.Attempts[len(attempts.Attempts)-1]\n  3543\t\treturn latest.Decision == \"rejected\" || latest.Decision == \"changes-requested\"\n  3544\t}\n  3545\t\n  3546\tfunc (s Store) computeReviewVerification(scope string) (ReviewBundleVerification, error) {\n  3547\t\tpolicy, err := s.GetReviewPolicy()\n  3548\t\tif err != nil {\n  3549\t\t\treturn ReviewBundleVerification{}, err\n  3550\t\t}\n  3551\t\tscopeRef, scopeErr := ParseScopeRef(scope)\n  3552\t\tif scopeErr != nil {\n  3553\t\t\treturn ReviewBundleVerification{}, scopeErr\n  3554\t\t}\n  3555\t\n  3556\t\tbundlesRead, err := s.ReadReviewBundles(scope)\n  3557\t\tif err != nil {\n  3558\t\t\treturn ReviewBundleVerification{}, err\n  3559\t\t}\n  3560\t\tbundles := bundlesRead.Bundles\n  3561\t\n  3562\t\tif (policy.SchemaVersion < ReviewPolicySchemaVersion || !policy.ReviewBundles) && len(bundles) == 0 {\n  3563\t\t\teval, evalErr := s.ReviewCheck(scope)\n  3564\t\t\tif evalErr != nil {\n  3565\t\t\t\treturn ReviewBundleVerification{}, evalErr\n  3566\t\t\t}\n  3567\t\t\tverification := ReviewBundleVerification{\n  3568\t\t\t\tScope:    scope,\n  3569\t\t\t\tState:    \"needs-review\",\n  3570\t\t\t\tFresh:    eval.Fresh,\n  3571\t\t\t\tApproved: eval.Approved,\n  3572\t\t\t\tWarnings: append([]string{}, eval.Warnings...),\n  3573\t\t\t\tBlockers: append([]string{}, eval.Blockers...),\n  3574\t\t\t}\n  3575\t\t\tif eval.Current != nil {\n  3576\t\t\t\tverification.NextAction = \"record fresh review for \" + scope\n  3577\t\t\t\tif eval.Current.Decision == \"changes-requested\" || eval.Current.Decision == \"rejected\" {\n  3578\t\t\t\t\tverification.State = eval.Current.Decision\n  3579\t\t\t\t} else if !eval.Fresh {\n  3580\t\t\t\t\tverification.State = \"superseded\"\n  3581\t\t\t\t}\n  3582\t\t\t} else {\n  3583\t\t\t\tverification.NextAction = \"record review for \" + scope\n  3584\t\t\t}\n  3585\t\t\tif eval.Approved && eval.Fresh {\n  3586\t\t\t\tdone, doneErr := s.scopeLifecycleDone(scopeRef)\n  3587\t\t\t\tif doneErr == nil && done {\n  3588\t\t\t\t\tverification.State = \"closed\"\n  3589\t\t\t\t\tverification.NextAction = \"scope is closed with an approved review\"\n  3590\t\t\t\t} else {\n  3591\t\t\t\t\tverification.State = \"ready-to-close\"\n  3592\t\t\t\t\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope\n  3593\t\t\t\t}\n  3594\t\t\t}\n  3595\t\t\tverification.Blockers = uniqueSorted(verification.Blockers)\n  3596\t\t\tverification.Warnings = uniqueSorted(verification.Warnings)\n  3597\t\t\treturn verification, nil\n  3598\t\t}\n  3599\t\n  3600\t\tprepared, err := s.PrepareReviewBundle(scope)\n  3601\t\tif err != nil {\n  3602\t\t\treturn ReviewBundleVerification{}, err\n  3603\t\t}\n  3604\t\tverification := ReviewBundleVerification{Scope: scope, State: \"needs-validation\", Fresh: false, Approved: false, Warnings: append([]string{}, prepared.Warnings...), Blockers: append([]string{}, prepared.Blockers...), currentManifest: prepared.Payload.FederatedManifest}\n  3605\t\tif bundleLosses := bundlesRead.Coverage.LossesFor(scope); len(bundleLosses) > 0 {\n  3606\t\t\t// A sealed bundle that could not be read may belong to this scope: the history\n  3607\t\t\t// below is the readable part of it.\n  3608\t\t\tverification.Warnings = append(verification.Warnings, \"sealed bundle history is incomplete: \"+(SourceCoverage{Losses: bundleLosses}).Describe(\"\")+\"; a record that could not be read may belong to this scope\")\n  3609\t\t}\n  3610\t\tif len(prepared.Blockers) == 0 {\n  3611\t\t\tverification.State = \"ready-to-seal\"\n  3612\t\t}\n  3613\t\tcurrent, err := s.matchSealedReviewBundle(scope, prepared, bundles)\n  3614\t\tif err != nil {\n  3615\t\t\treturn ReviewBundleVerification{}, err\n  3616\t\t}\n  3617\t\tif current == nil {\n  3618\t\t\tif len(bundles) > 0 {\n  3619\t\t\t\tprevious := reviewBundleLineage(bundles)[0]\n  3620\t\t\t\tdelta := ReviewBundleDiff(previous, prepared)\n  3621\t\t\t\t// The per-criterion explanation is computed only where a person\n  3622\t\t\t\t// reads it; analytics over many bundles use the plain diff.\n  3623\t\t\t\tdelta.CriterionReuse = ExplainCriterionReuse(previous, prepared)\n  3624\t\t\t\tif attempts, listErr := s.ListReviewAttestations(previous.BundleID); listErr == nil && len(attempts) > 0 {\n  3625\t\t\t\t\tfor _, finding := range attempts[len(attempts)-1].Findings {\n  3626\t\t\t\t\t\tdelta.ChangedFindings = append(delta.ChangedFindings, finding.ID)\n  3627\t\t\t\t\t}\n  3628\t\t\t\t\tdelta.ChangedFindings = uniqueSorted(delta.ChangedFindings)\n  3629\t\t\t\t}\n  3630\t\t\t\tverification.Delta = &delta\n  3631\t\t\t\tif done, doneErr := s.scopeLifecycleDone(scopeRef); doneErr == nil && done {\n  3632\t\t\t\t\t// Only routine drift is retained. A changed federated manifest —\n  3633\t\t\t\t\t// revoked trust, a moved or unauthorized source — bears on the\n  3634\t\t\t\t\t// review's authority, so it stales a closed scope as it always did.\n  3635\t\t\t\t\tbundle, att, retainLost, childBlockers := s.retainedCompletedReviewWithHistory(scopeRef, scope, policy)\n  3636\t\t\t\t\tif len(retainLost) > 0 {\n  3637\t\t\t\t\t\tverification.Blockers = append(verification.Blockers, \"the approval cannot be retained: the attestation history of its bundle is incomplete, so the latest readable attestation is not known to be the current one: \"+(SourceCoverage{Losses: retainLost}).Describe(\"\")+\"; restore or remove the unreadable record\")\n  3638\t\t\t\t\t}\n  3639\t\t\t\t\tif len(childBlockers) > 0 {\n  3640\t\t\t\t\t\tverification.State = \"superseded\"\n  3641\t\t\t\t\t\tverification.Blockers = uniqueSorted(append(verification.Blockers, childBlockers...))\n  3642\t\t\t\t\t\tverification.NextAction = \"restore the review of the children of \" + scope\n  3643\t\t\t\t\t\treturn verification, nil\n  3644\t\t\t\t\t}\n  3645\t\t\t\t\tif bundle != nil && !s.retainedApprovalStands(bundle, prepared.Payload.FederatedManifest) {\n  3646\t\t\t\t\t\tverification.Blockers = append(verification.Blockers, retainedManifestChanged(bundle, scope))\n  3647\t\t\t\t\t} else if bundle != nil {\n  3648\t\t\t\t\t\tverification.Bundle, verification.Attestation = bundle, att\n  3649\t\t\t\t\t\tverification.Warnings = append(verification.Warnings, staleEvidenceWarnings(bundle.Payload.Subject, bundle.Payload.Evidence)...)\n  3650\t\t\t\t\t\tverification.Fresh, verification.Approved = true, true\n  3651\t\t\t\t\t\tverification.State = \"closed\"\n  3652\t\t\t\t\t\tverification.NextAction = \"scope is closed with its retained approved bundle attestation\"\n  3653\t\t\t\t\t\tverification.Blockers = []string{}\n  3654\t\t\t\t\t\tverification.Warnings = uniqueSorted(append(verification.Warnings, retainedCompletedReviewWarning))\n  3655\t\t\t\t\t\treturn verification, nil\n  3656\t\t\t\t\t}\n  3657\t\t\t\t}\n  3658\t\t\t\tverification.State = \"superseded\"\n  3659\t\t\t\tverification.Blockers = append(verification.Blockers, \"current semantic inputs are not represented by a sealed bundle\")\n  3660\t\t\t}\n  3661\t\t\tverification.NextAction = \"seal the current review bundle for \" + scope\n  3662\t\t\tverification.Blockers = uniqueSorted(verification.Blockers)\n  3663\t\t\treturn verification, nil\n  3664\t\t}\n  3665\t\tverification.Bundle = current\n  3666\t\tverification.Warnings = uniqueSorted(append(verification.Warnings, staleEvidenceWarnings(current.Payload.Subject, current.Payload.Evidence)...))\n  3667\t\tverification.Fresh = true\n  3668\t\tverification.State = \"ready-for-review\"\n  3669\t\tattestationsRead, err := s.ReadReviewAttestations(current.BundleID)\n  3670\t\tif err != nil {\n  3671\t\t\treturn verification, err\n  3672\t\t}\n  3673\t\tattestations := attestationsRead.Attestations\n  3674\t\t// A record that could not be read may be a later attestation, a rejection among\n  3675\t\t// them: an earlier approval is not taken as the current one while that is open.\n  3676\t\t// A record that names another bundle, or another scope, does not concern this one.\n  3677\t\tattestationHistory := attestationsRead.Coverage.LossesFor(current.BundleID)\n  3678\t\tif len(attestations) == 0 {\n  3679\t\t\tif len(attestationHistory) > 0 {\n  3680\t\t\t\tverification.Blockers = append(verification.Blockers, \"no readable attestation exists for bundle \"+current.BundleID+\", and the attestation history is incomplete: \"+(SourceCoverage{Losses: attestationHistory}).Describe(\"\"))\n  3681\t\t\t} else {\n  3682\t\t\t\tverification.Blockers = append(verification.Blockers, \"sealed review bundle has no attestation\")\n  3683\t\t\t}\n  3684\t\t\tverification.NextAction = \"review and attest bundle \" + current.BundleID\n  3685\t\t\tverification.Blockers = uniqueSorted(verification.Blockers)\n  3686\t\t\treturn verification, nil\n  3687\t\t}\n  3688\t\tatt := attestations[len(attestations)-1]\n  3689\t\tverification.Attestation = &att\n  3690\t\tverification.Blockers = append(verification.Blockers, s.validateBundleAttestation(*current, att)...)\n  3691\t\tif len(attestationHistory) > 0 {\n  3692\t\t\tverification.Blockers = append(verification.Blockers, \"attestation history for bundle \"+current.BundleID+\" is incomplete, so the latest readable attestation is not known to be the current one: \"+(SourceCoverage{Losses: attestationHistory}).Describe(\"\")+\"; restore or remove the unreadable record\")\n  3693\t\t}\n  3694\t\n  3695\t\tif len(verification.Blockers) == 0 {\n  3696\t\t\tverification.Approved = true\n  3697\t\t\tscopeRef, scopeErr := ParseScopeRef(scope)\n  3698\t\t\tdone, doneErr := false, scopeErr\n  3699\t\t\tif scopeErr == nil {\n  3700\t\t\t\tdone, doneErr = s.scopeLifecycleDone(scopeRef)\n  3701\t\t\t}\n  3702\t\t\tif doneErr == nil && done {\n  3703\t\t\t\tverification.State = \"closed\"\n  3704\t\t\t\tverification.NextAction = \"scope is closed with a fresh bundle attestation\"\n  3705\t\t\t} else {\n  3706\t\t\t\tverification.State = \"ready-to-close\"\n  3707\t\t\t\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope\n  3708\t\t\t}\n  3709\t\t} else if att.Decision == \"changes-requested\" || att.Decision == \"rejected\" {\n  3710\t\t\tverification.State = \"changes-requested\"\n  3711\t\t\tverification.NextAction = \"remediate findings and seal a superseding bundle\"\n  3712\t\t} else if blockedByAChild(prepared.Blockers) {\n  3713\t\t\tverification.NextAction = \"restore the review of the children of \" + scope\n  3714\t\t} else {\n  3715\t\t\tverification.NextAction = \"replace the invalid attestation for \" + current.BundleID\n  3716\t\t}\n  3717\t\tverification.Blockers = uniqueSorted(verification.Blockers)\n  3718\t\treturn verification, nil\n  3719\t}\n  3720\t\n  3721\t// validateBundleAttestation reports why an attestation does not stand for its\n  3722\t// bundle. skipEvidenceSupport waives only the checks introduced by\n  3723\t// pose-attestation-evidence-must-be-in-the-bundle, for a completed scope whose\n  3724\t// approval predates them; everything else still applies. See\n  3725\t// evidenceVocabularyLegacyExempt for why that exemption exists and its bounds.\n  3726\tfunc (s Store) validateBundleAttestation(bundle ReviewBundle, att ReviewAttestation) []string {\n  3727\t\treturn s.validateBundleAttestationWith(bundle, att, false)\n  3728\t}\n  3729\t\n  3730\tfunc (s Store) validateBundleAttestationWith(bundle ReviewBundle, att ReviewAttestation, skipEvidenceSupport bool) []string {\n  3731\t\ts = s.reviewOperation()\n  3732\t\tblockers := []string{}\n  3733\t\tpolicy, _, policyErr := s.loadReviewPolicy()\n  3734\t\tif policyErr != nil {\n  3735\t\t\tblockers = append(blockers, policyErr.Error())\n  3736\t\t}\n  3737\t\tif strings.Join(att.Limitations, \"\\x00\") != strings.Join(bundle.Payload.Plan.Limitations, \"\\x00\") {\n  3738\t\t\tblockers = append(blockers, \"attestation does not retain the sealed review limitations\")\n  3739\t\t}\n  3740\t\tif att.BundleDigest != bundle.BundleDigest || att.BundleID != bundle.BundleID {\n  3741\t\t\tblockers = append(blockers, \"attestation does not reference the exact sealed bundle\")\n  3742\t\t}\n  3743\t\t// The one gate that stays live, deliberately. Everything else a bundle is\n  3744\t\t// judged by is sealed with it, because a setting flipped today must not\n  3745\t\t// re-judge a review recorded years ago. Signing is the opposite case: a\n  3746\t\t// project that starts requiring signed attestations is raising a bar, and a\n  3747\t\t// bundle sealed before that must not be permanently exempt from it — the\n  3748\t\t// exemption would be exactly the work an attacker or a hurry would want\n  3749\t\t// (spec pose-reuse-is-sealed-signing-stays-live).\n  3750\t\t// Verified authority checks the signature in the shared proof path below,\n  3751\t\t// also used by disclosure. Declared records retain their signing gate.\n  3752\t\tif bundle.Payload.SealedGates().IdentityAssurance != ReviewIdentityAssuranceVerified && (policy.RequireSignedAttestations || att.Envelope != nil) {\n  3753\t\t\tif err := s.verifyStoredReviewAttestationSignature(att); err != nil {\n  3754\t\t\t\tblockers = append(blockers, err.Error())\n  3755\t\t\t}\n  3756\t\t}\n  3757\t\tif _, err := time.Parse(time.RFC3339, att.AttestedAt); err != nil {\n  3758\t\t\tblockers = append(blockers, \"attested_at must be RFC3339\")\n  3759\t\t}\n  3760\t\tif !strings.HasPrefix(att.Reviewer, \"agent:\") && !strings.HasPrefix(att.Reviewer, \"human:\") {\n  3761\t\t\tblockers = append(blockers, \"reviewer execution identity is malformed\")\n  3762\t\t}\n  3763\t\tif err := ValidateReviewAttribution(att); err != nil {\n  3764\t\t\tblockers = append(blockers, strings.TrimPrefix(err.Error(), \"pose: \"))\n  3765\t\t}\n  3766\t\t// Two axes, kept apart. Independence says what separation the review\n  3767\t\t// requires; assurance says whether the reviewer's identity is read from the\n  3768\t\t// string they wrote or from an authority an authorized issuer signed.\n  3769\t\t//\n  3770\t\t// Under `declared` this is the prefix check it always was, and the warning\n  3771\t\t// beside it stops the enum being read as proof: `agent:independent-anything`\n  3772\t\t// satisfies `different-actor`, and `human:` satisfies `mandatory-human`,\n  3773\t\t// because nothing here compares a principal, a session or a grant\n  3774\t\t// (spec pose-abm-review-authority).\n  3775\t\tif att.Run != nil {\n  3776\t\t\tblockers = append(blockers, s.runBackedReviewBlockers(bundle, att)...)\n  3777\t\t} else if (policy.DelegatedReview || bundle.Payload.Plan.DelegatedRunProofRequired) && strings.HasPrefix(att.Reviewer, \"agent:\") && bundle.Payload.Plan.Independence == \"different-actor\" {\n  3778\t\t\tblockers = append(blockers, \"delegated-review requires a signed run reference; reviewer prefix does not prove independence\")\n  3779\t\t} else {\n  3780\t\t\tswitch bundle.Payload.SealedGates().IdentityAssurance {\n  3781\t\t\tcase ReviewIdentityAssuranceVerified:\n  3782\t\t\t\tblockers = append(blockers, s.verifiedAuthorityBlockers(bundle, att)...)\n  3783\t\t\tdefault:\n  3784\t\t\t\tswitch bundle.Payload.Plan.Independence {\n  3785\t\t\t\tcase \"different-actor\":\n  3786\t\t\t\t\tif !strings.HasPrefix(att.Reviewer, \"agent:independent-\") && !strings.HasPrefix(att.Reviewer, \"human:\") {\n  3787\t\t\t\t\t\tblockers = append(blockers, \"review policy requires a different-actor reviewer identity; under declared assurance that is read from the reviewer prefix, not authenticated\")\n  3788\t\t\t\t\t}\n  3789\t\t\t\tcase \"mandatory-human\":\n  3790\t\t\t\t\tif !strings.HasPrefix(att.Reviewer, \"human:\") {\n  3791\t\t\t\t\t\tblockers = append(blockers, \"review policy requires human approval\")\n  3792\t\t\t\t\t}\n  3793\t\t\t\t}\n  3794\t\t\t}\n  3795\t\t}\n  3796\t\trequired := map[string]ReviewPlanCriterion{}\n  3797\t\tfor _, criterion := range bundle.Payload.Plan.Criteria {\n  3798\t\t\tif criterion.Required {\n  3799\t\t\t\trequired[criterion.ID] = criterion\n  3800\t\t\t}\n  3801\t\t}\n  3802\t\t// The findings this attestation records, so a criterion disposed as\n  3803\t\t// `finding` can be checked against them. The CLI parser already refused a\n  3804\t\t// criterion naming a finding it does not record; the Store did not, so any\n  3805\t\t// other caller — a Store client, a signed import, a reuse — could approve a\n  3806\t\t// criterion that explicitly did not pass while filing nothing. A signature\n  3807\t\t// authenticates bytes; it does not repair a reference to something that\n  3808\t\t// does not exist (spec pose-abm-review-soundness).\n  3809\t\trecordedFindings := map[string]bool{}\n  3810\t\tfor _, finding := range att.Findings {\n  3811\t\t\trecordedFindings[finding.ID] = true\n  3812\t\t}\n  3813\t\tsealedClasses := map[string]bool{}\n  3814\t\tfor _, ev := range bundle.Payload.Evidence {\n  3815\t\t\tsealedClasses[ev.EvidenceClass] = true\n  3816\t\t}\n  3817\t\tjudgmentGoverned, _ := BundleGovernedBy(bundle, \"explicit-judgment\")\n  3818\t\tif structuralGoverned, _ := BundleGovernedBy(bundle, \"structural-causality\"); structuralGoverned {\n  3819\t\t\tblockers = append(blockers, s.reviewStructuralCausalityBlockers(bundle.Payload.Scope.Ref, bundle.Payload.Plan.Structure, required, att.Criteria)...)\n  3820\t\t}\n  3821\t\tif closeoutGoverned, _ := BundleGovernedBy(bundle, CausalityCloseoutContract); closeoutGoverned {\n  3822\t\t\tblockers = append(blockers, s.reviewCausalityCloseoutBlockers(bundle.Payload.Scope.Ref, bundle.Payload.Plan.Structure, bundle.Payload.Plan.Band, required, att.Criteria)...)\n  3823\t\t}\n  3824\t\t// Validation evidence can be required by implementation components even\n  3825\t\t// when no delivery target is declared. A target-gated tool must use the\n  3826\t\t// sealed declaration, not the broader evidence requirement.\n  3827\t\thasDeliveryTarget := len(bundle.Payload.Scope.Deliveries) > 0\n  3828\t\tif bundle.Payload.Scope.Kind != \"spec\" {\n  3829\t\t\ttoolScope, _ := ParseScopeRef(bundle.Payload.Scope.Ref)\n  3830\t\t\ttoolGraph, _ := s.GetDeliveryIntegrity(\"\")\n  3831\t\t\thasDeliveryTarget = s.reviewScopeRequiresValidationEvidence(toolScope, bundle.Payload.Plan, toolGraph)\n  3832\t\t}\n  3833\t\tseen := map[string]bool{}\n  3834\t\tnotApplicable := 0\n  3835\t\tfor _, criterion := range att.Criteria {\n  3836\t\t\tif seen[criterion.ID] {\n  3837\t\t\t\tblockers = append(blockers, \"duplicate criterion \"+criterion.ID)\n  3838\t\t\t}\n  3839\t\t\tseen[criterion.ID] = true\n  3840\t\t\tplanned, known := required[criterion.ID]\n  3841\t\t\tif !known {\n  3842\t\t\t\tblockers = append(blockers, \"unknown criterion \"+criterion.ID)\n  3843\t\t\t}\n  3844\t\t\tif criterion.Disposition != \"passed\" && criterion.Disposition != \"not-applicable\" && criterion.Disposition != \"finding\" {\n  3845\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" has invalid disposition\")\n  3846\t\t\t}\n  3847\t\t\tif criterion.Disposition == \"not-applicable\" {\n  3848\t\t\t\tnotApplicable++\n  3849\t\t\t\tif criterion.Rationale == \"\" {\n  3850\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" lacks not-applicable rationale\")\n  3851\t\t\t\t}\n  3852\t\t\t\t// Inapplicability and absence are different states, and only one of\n  3853\t\t\t\t// them is an answer. A criterion that asks for a class the bundle\n  3854\t\t\t\t// actually seals is applicable by construction: dispensing with it\n  3855\t\t\t\t// would be reading missing judgment as missing relevance.\n  3856\t\t\t\t//\n  3857\t\t\t\t// Gated, unlike the finding-reference rule beside it. That one is\n  3858\t\t\t\t// referential integrity — a criterion naming a finding nobody filed\n  3859\t\t\t\t// is incomplete under any policy, and no stored record does it. This\n  3860\t\t\t\t// one is a stricter judgment default, and 12 of the 499 attestations\n  3861\t\t\t\t// in the two repositories would fail it. Holding a review to a rule\n  3862\t\t\t\t// that did not exist when it was given is what the sealed-contract\n  3863\t\t\t\t// mechanism exists to prevent.\n  3864\t\t\t\tif known && judgmentGoverned {\n  3865\t\t\t\t\tfor _, class := range planned.EvidenceClasses {\n  3866\t\t\t\t\t\tif sealedClasses[class] {\n  3867\t\t\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" is not-applicable while the bundle seals evidence of class \"+class+\"; missing judgment is a pendency, not inapplicability\")\n  3868\t\t\t\t\t\t\tbreak\n  3869\t\t\t\t\t\t}\n  3870\t\t\t\t\t}\n  3871\t\t\t\t}\n  3872\t\t\t}\n  3873\t\t\tif criterion.Disposition == \"finding\" {\n  3874\t\t\t\tif criterion.Evidence == \"\" {\n  3875\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" is disposed as a finding and names none\")\n  3876\t\t\t\t} else if !recordedFindings[criterion.Evidence] {\n  3877\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" names finding \"+criterion.Evidence+\", which this attestation does not record\")\n  3878\t\t\t\t}\n  3879\t\t\t}\n  3880\t\t\tif criterion.Disposition == \"passed\" {\n  3881\t\t\t\tif !skipEvidenceSupport {\n  3882\t\t\t\t\tblockers = append(blockers, reviewCriterionEvidenceBlockers(bundle, planned, criterion)...)\n  3883\t\t\t\t}\n  3884\t\t\t\t// A judged criterion passes on a conclusion, not on a reference.\n  3885\t\t\t\t// Gated on the contract the bundle sealed, so the 470 attestations\n  3886\t\t\t\t// recorded before it keep their verdict and stay readable: this\n  3887\t\t\t\t// raises the bar for reviews taken under the contract, and never\n  3888\t\t\t\t// re-judges one taken before it existed.\n  3889\t\t\t\tif judgmentGoverned && known && ReviewCriterionKind(planned) == ReviewCriterionKindJudgment && strings.TrimSpace(criterion.Rationale) == \"\" {\n  3890\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" is a judgment criterion passed with no conclusion; record what was examined and what it concluded\")\n  3891\t\t\t\t}\n  3892\t\t\t}\n  3893\t\t}\n  3894\t\tfor id := range required {\n  3895\t\t\tif !seen[id] {\n  3896\t\t\t\tblockers = append(blockers, \"missing criterion \"+id)\n  3897\t\t\t}\n  3898\t\t}\n  3899\t\t// Every criterion dispensed with is not a review of anything. The engine\n  3900\t\t// cannot judge whether one dispensation is honest, but it can refuse the\n  3901\t\t// degenerate case, where the attestation states that nothing the plan asked\n  3902\t\t// about applies to the change it approves.\n  3903\t\t//\n  3904\t\t// Bounded to a scope that carries a delivery target, because the other case\n  3905\t\t// is already modelled and already honest: a documentation-only spec collects\n  3906\t\t// no validation evidence by design, and recording every criterion\n  3907\t\t// not-applicable — naming what is missing — is the answer the engine itself\n  3908\t\t// prepares for it. Refusing that would break the distinction this contract\n  3909\t\t// depends on rather than reinforce it.\n  3910\t\tif judgmentGoverned && hasDeliveryTarget && len(required) > 0 && notApplicable == len(required) && len(att.Criteria) == len(required) {\n  3911\t\t\tblockers = append(blockers, \"every required criterion is not-applicable; a scope where the whole plan is inapplicable is not reviewed by it\")\n  3912\t\t}\n  3913\t\treuseBlockers, _ := s.evaluateReviewReuse(bundle, att, bundle.Payload.SealedGates().AllowCriterionReuse)\n  3914\t\tblockers = append(blockers, reuseBlockers...)\n  3915\t\tsealedEvidence := map[string]ReviewBundleEvidence{}\n  3916\t\tfor _, ev := range bundle.Payload.Evidence {\n  3917\t\t\tsealedEvidence[ev.EvidenceClass+\":\"+ev.ID] = ev\n  3918\t\t}\n  3919\t\tif skipEvidenceSupport {\n  3920\t\t\tsealedEvidence = nil\n  3921\t\t}\n  3922\t\ttoolWarnings, toolBlockers := evaluateReviewToolCoverageIn(s.fsys(), s.Root, bundle.Payload.Plan.Tools, att.Tools, sealedEvidence, hasDeliveryTarget)\n  3923\t\t_ = toolWarnings\n  3924\t\tblockers = append(blockers, toolBlockers...)\n  3925\t\tblockers = append(blockers, reviewFindingDecisionBlockers(bundle, att)...)\n  3926\t\treturn blockers\n  3927\t}\n  3928\t\n  3929\t// The same finding and decision gate protects fresh and reused approvals.\n  3930\tfunc reviewFindingDecisionBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n  3931\t\tblockers := []string{}\n  3932\t\t// The finding contract, which this path did not have. It accepted a\n  3933\t\t// `critical` risk with no owner, no rationale and no review date; a\n  3934\t\t// disposition the engine does not know; and a finding with neither severity\n  3935\t\t// nor action — all three with no blocker at all, while the legacy attempt\n  3936\t\t// path refused every one of them. A project that adopted review bundles\n  3937\t\t// silently lost the gate (spec\n  3938\t\t// pose-bundle-findings-take-the-contract-the-legacy-path-had).\n  3939\t\t//\n  3940\t\t// Only the accepted-risk severities and the reservations flag come from the\n  3941\t\t// sealed gates. The rest is not configuration: a finding without a severity\n  3942\t\t// is incomplete under any policy.\n  3943\t\tallowedRisk := map[string]bool{}\n  3944\t\tfor _, severity := range bundle.Payload.SealedGates().AcceptedRiskSeverities {\n  3945\t\t\tallowedRisk[severity] = true\n  3946\t\t}\n  3947\t\tseenFindings := map[string]bool{}\n  3948\t\tfor _, finding := range att.Findings {\n  3949\t\t\tif seenFindings[finding.ID] {\n  3950\t\t\t\tblockers = append(blockers, \"duplicate finding \"+finding.ID)\n  3951\t\t\t}\n  3952\t\t\tseenFindings[finding.ID] = true\n  3953\t\t\tif finding.Severity == \"\" || finding.Action == \"\" {\n  3954\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" lacks severity or action\")\n  3955\t\t\t}\n  3956\t\t\tswitch finding.Disposition {\n  3957\t\t\tcase \"resolved\":\n  3958\t\t\tcase \"accepted-risk\", \"wont-fix\":\n  3959\t\t\t\t// Leaving a finding unresolved accepts its risk regardless of the\n  3960\t\t\t\t// disposition's spelling. Use the policy frozen into this bundle.\n  3961\t\t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n  3962\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n  3963\t\t\t\t}\n  3964\t\t\tcase \"open\", \"changes-requested\":\n  3965\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n  3966\t\t\tdefault:\n  3967\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has invalid disposition\")\n  3968\t\t\t}\n  3969\t\t}\n  3970\t\tif att.Decision != \"approved\" && !(att.Decision == \"approved-with-reservations\" && bundle.Payload.SealedGates().AllowApprovedWithReservations) {\n  3971\t\t\tblockers = append(blockers, \"review decision does not permit closeout: \"+att.Decision)\n  3972\t\t}\n  3973\t\treturn blockers\n  3974\t}\n  3975\t\n  3976\tfunc (s Store) verifyStoredReviewAttestationSignature(att ReviewAttestation) error {\n  3977\t\tif att.Envelope == nil {\n  3978\t\t\t// Recorded before signing was required, and sealed unchanged into a\n  3979\t\t\t// trusted legacy ledger (spec pose-signed-legacy-attestation-ledger).\n  3980\t\t\tif s.legacyLedgerCovers(att) {\n  3981\t\t\t\treturn nil\n  3982\t\t\t}\n  3983\t\t\tif coverage := s.LegacyLedgerCoverage(); !coverage.Complete() {\n  3984\t\t\t\t// Not trusted, and not for want of a ledger: one could not be used.\n  3985\t\t\t\treturn fmt.Errorf(\"signed attestation proof is required by review policy; a legacy ledger that may cover it could not be used: %s\", coverage.Describe(\"\"))\n  3986\t\t\t}\n  3987\t\t\treturn fmt.Errorf(\"signed attestation proof is required by review policy\")\n  3988\t\t}\n  3989\t\tproof := *att.Envelope\n  3990\t\tunsigned := att\n  3991\t\tunsigned.Path = \"\"\n  3992\t\tunsigned.Envelope = nil\n  3993\t\t_, err := s.VerifyReviewAttestationEnvelope(ReviewAttestationEnvelope{SchemaVersion: ReviewBundleSchemaVersion, Issuer: proof.Issuer, Subject: proof.Subject, Algorithm: proof.Algorithm, PublicKey: proof.PublicKey, Signature: proof.Signature, Attestation: unsigned})\n  3994\t\treturn err\n  3995\t}\n  3996\t\n  3997\t// reviewCriterionEvidenceBlockers checks that a criterion recorded as passed is\n  3998\t// supported by evidence the sealed bundle actually contains, of a class the\n  3999\t// criterion asks for.\n  4000\t//\n  4001\t// Nothing checked this before. A `passed` disposition could cite evidence\n  4002\t// absent from the bundle, evidence of the wrong class, or nothing at all, and\n  4003\t// the attestation verified — which is how three closeouts in an adopting\n  4004\t// repository were approved against a bundle carrying zero evidence, and how a\n  4005\t// criterion requiring `integration` passed on a `go vet` result. An attestation\n  4006\t// that cannot be checked against its own subject is a signature on an empty\n  4007\t// page.\n  4008\t//\n  4009\t// Only `passed` is constrained. `not-applicable` already requires a rationale,\n  4010\t// which is the reviewer's judgement standing in for evidence, and `finding`\n  4011\t// records a problem rather than a clearance.\n  4012\tfunc reviewCriterionEvidenceBlockers(bundle ReviewBundle, planned ReviewPlanCriterion, attested ReviewCriterion) []string {\n  4013\t\tif attested.Evidence == \"\" {\n  4014\t\t\treturn []string{\"criterion \" + attested.ID + \" is passed with no evidence\"}\n  4015\t\t}\n  4016\t\tsealed := map[string]ReviewBundleEvidence{}\n  4017\t\tfor _, ev := range bundle.Payload.Evidence {\n  4018\t\t\tsealed[ev.EvidenceClass+\":\"+ev.ID] = ev\n  4019\t\t}\n  4020\t\tevidence, ok := sealed[attested.Evidence]\n  4021\t\tif !ok {\n  4022\t\t\treturn []string{\"criterion \" + attested.ID + \" cites evidence absent from the sealed bundle: \" + attested.Evidence}\n  4023\t\t}\n  4024\t\tif len(planned.EvidenceClasses) > 0 {\n  4025\t\t\tmatched := false\n  4026\t\t\tfor _, want := range planned.EvidenceClasses {\n  4027\t\t\t\tif want == evidence.EvidenceClass {\n  4028\t\t\t\t\tmatched = true\n  4029\t\t\t\t\tbreak\n  4030\t\t\t\t}\n  4031\t\t\t}\n  4032\t\t\tif !matched {\n  4033\t\t\t\treturn []string{\"criterion \" + attested.ID + \" requires evidence class \" + strings.Join(planned.EvidenceClasses, \"|\") + \" but cites \" + evidence.EvidenceClass + \": \" + attested.Evidence}\n  4034\t\t\t}\n  4035\t\t}\n  4036\t\t// Only a criterion that demands a class is scoped. Without one the plan made\n  4037\t\t// no claim about what the evidence shows, so narrowing it by module would\n  4038\t\t// invent a constraint the plan never stated — and auto-attest deliberately\n  4039\t\t// takes any sealed evidence for such a criterion, so scoping it here would\n  4040\t\t// make the engine reject its own output. The spec said this in its\n  4041\t\t// non-goals and the first implementation did it anyway.\n  4042\t\tif len(planned.EvidenceClasses) == 0 {\n  4043\t\t\treturn nil\n  4044\t\t}\n  4045\t\tif components := reviewCriterionComponents(bundle.Payload.Plan, planned); len(components) > 0 {\n  4046\t\t\tfor _, component := range components {\n  4047\t\t\t\tif moduleMatchesTarget(evidence.Module, component) {\n  4048\t\t\t\t\treturn nil\n  4049\t\t\t\t}\n  4050\t\t\t}\n  4051\t\t\treturn []string{\"criterion \" + attested.ID + \" is scoped to \" + strings.Join(components, \"|\") + \" but cites evidence from \" + evidenceModuleLabel(evidence) + \": \" + attested.Evidence}\n  4052\t\t}\n  4053\t\treturn nil\n  4054\t}\n  4055\t\n  4056\t// reviewCriterionComponents resolves the components a criterion answers for, or\n  4057\t// nil when it answers for all of them.\n  4058\t//\n  4059\t// A criterion comes from one or more profiles, and the plan records which\n  4060\t// components each profile was selected for. An overlay matched specific\n  4061\t// components; a base profile carries none and governs every one. So a criterion\n  4062\t// governed by any base profile has no component constraint, and one governed\n  4063\t// only by overlays is constrained to what they matched.\n  4064\t//\n  4065\t// Without this, evidence was matched by reference and class alone: a backend\n  4066\t// criterion could be satisfied by a frontend sibling's integration result, in a\n  4067\t// bundle that seals both. The reference was real, the class was demanded, and\n  4068\t// the result said nothing about the component the criterion is about.\n  4069\tfunc reviewCriterionComponents(plan ReviewBundlePlan, criterion ReviewPlanCriterion) []string {\n  4070\t\tselected := map[string][]string{}\n  4071\t\tfor _, profile := range plan.SelectedProfiles {\n  4072\t\t\tselected[profile.Ref] = profile.Components\n  4073\t\t}\n  4074\t\tcomponents := []string{}\n  4075\t\tfor _, ref := range criterion.Profiles {\n  4076\t\t\tscoped, known := selected[ref]\n  4077\t\t\tif !known {\n  4078\t\t\t\t// A profile the plan does not record cannot be scoped, and guessing\n  4079\t\t\t\t// would narrow a criterion on no evidence.\n  4080\t\t\t\treturn nil\n  4081\t\t\t}\n  4082\t\t\tif len(scoped) == 0 {\n  4083\t\t\t\treturn nil\n  4084\t\t\t}\n  4085\t\t\tcomponents = append(components, scoped...)\n  4086\t\t}\n  4087\t\treturn uniqueSorted(components)\n  4088\t}\n  4089\t\n  4090\tfunc evidenceModuleLabel(evidence ReviewBundleEvidence) string {\n  4091\t\tif evidence.Module == \"\" {\n  4092\t\t\treturn \"the repository root\"\n  4093\t\t}\n  4094\t\treturn evidence.Module\n  4095\t}\n  4096\t\n  4097\tfunc reviewCriterionInputContract(bundle ReviewBundle, criterion ReviewPlanCriterion) criterionInputContract {\n  4098\t\tevidence := []ReviewBundleEvidence{}\n  4099\t\tclasses := map[string]bool{}\n  4100\t\tfor _, class := range criterion.EvidenceClasses {\n  4101\t\t\tclasses[class] = true\n  4102\t\t}\n  4103\t\tfor _, item := range bundle.Payload.Evidence {\n  4104\t\t\tif classes[item.EvidenceClass] {\n  4105\t\t\t\tevidence = append(evidence, item)\n  4106\t\t\t}\n  4107\t\t}\n  4108\t\tinputs := []ReviewBundleInput{}\n  4109\t\tfor _, input := range bundle.Payload.ConsumedInputs {\n  4110\t\t\tif input.Kind == \"schema\" || input.Kind == \"governed-config\" {\n  4111\t\t\t\tinputs = append(inputs, input)\n  4112\t\t\t\tcontinue\n  4113\t\t\t}\n  4114\t\t\tif (input.Kind == \"review-plan\" || input.Kind == \"tool-catalog\") && reviewCriterionSubjectSensitive(criterion) {\n  4115\t\t\t\tinputs = append(inputs, input)\n  4116\t\t\t\tcontinue\n  4117\t\t\t}\n  4118\t\t\tif input.Kind == \"rule\" {\n  4119\t\t\t\tfor _, rule := range criterion.Rules {\n  4120\t\t\t\t\tif input.Path == \".pose/rules/\"+rule+\".md\" {\n  4121\t\t\t\t\t\tinputs = append(inputs, input)\n  4122\t\t\t\t\t}\n  4123\t\t\t\t}\n  4124\t\t\t}\n  4125\t\t\tif input.Kind == \"review-profile\" {\n  4126\t\t\t\tfor _, profile := range criterion.Profiles {\n  4127\t\t\t\t\tif input.Path == \".pose/review-profiles/\"+strings.Split(profile, \"@\")[0]+\".json\" {\n  4128\t\t\t\t\t\tinputs = append(inputs, input)\n  4129\t\t\t\t\t}\n  4130\t\t\t\t}\n  4131\t\t\t}\n  4132\t\t}\n  4133\t\tsubjectSensitive := reviewCriterionSubjectSensitive(criterion)\n  4134\t\trelevantTools := []ReviewPlanTool{}\n  4135\t\tfor _, tool := range bundle.Payload.Plan.Tools {\n  4136\t\t\tfor _, criterionID := range tool.Criteria {\n  4137\t\t\t\tif criterionID == criterion.ID {\n  4138\t\t\t\t\trelevantTools = append(relevantTools, tool)\n  4139\t\t\t\t\tbreak\n  4140\t\t\t\t}\n  4141\t\t\t}\n  4142\t\t}\n  4143\t\tcontract := criterionInputContract{Criterion: criterion, Independence: bundle.Payload.Plan.Independence, Evidence: evidence, Inputs: sortedBundleInputs(inputs), Tools: relevantTools}\n  4144\t\tif subjectSensitive {\n  4145\t\t\tcontract.Scope = append([]ReviewBundleInput{}, bundle.Payload.Scope.Sections...)\n  4146\t\t\tcontract.Subject = append([]ReviewBundleSubjectEntry{}, bundle.Payload.Subject.Entries...)\n  4147\t\t\tcontract.PatchDigest = bundle.Payload.Subject.PatchDigest\n  4148\t\t\tcontract.TreeDigest = bundle.Payload.Subject.TreeDigest\n  4149\t\t} else {\n  4150\t\t\tcontract.Scope = append([]ReviewBundleInput{}, bundle.Payload.Scope.Sections...)\n  4151\t\t\tfor _, entry := range bundle.Payload.Subject.Entries {\n  4152\t\t\t\t// `removed` is the one class whose category is unknown: the path\n  4153\t\t\t\t// carries no governed classification and there is no content left to\n  4154\t\t\t\t// read, so it cannot be shown to be irrelevant to this criterion the\n  4155\t\t\t\t// way an unrelated implementation file can. Omitting it would leave\n  4156\t\t\t\t// the digest unchanged when a superseding bundle adds the deletion,\n  4157\t\t\t\t// and a passed criterion would be reused over a subject it never saw.\n  4158\t\t\t\tif entry.Class == \"documentation\" || entry.Class == \"governance\" || entry.Class == \"removed\" {\n  4159\t\t\t\t\tcontract.Subject = append(contract.Subject, entry)\n  4160\t\t\t\t}\n  4161\t\t\t}\n  4162\t\t}\n  4163\t\treturn contract\n  4164\t}\n  4165\t\n  4166\t// criterionInputContract is everything a criterion's answer depends on. Its\n  4167\t// digest decides reuse; its fields explain it (spec\n  4168\t// pose-material-equivalence-reuse).\n  4169\ttype criterionInputContract struct {\n  4170\t\tCriterion    ReviewPlanCriterion        `json:\"criterion\"`\n  4171\t\tIndependence string                     `json:\"independence\"`\n  4172\t\tScope        []ReviewBundleInput        `json:\"scope,omitempty\"`\n  4173\t\tSubject      []ReviewBundleSubjectEntry `json:\"subject,omitempty\"`\n  4174\t\tPatchDigest  string                     `json:\"patch_digest,omitempty\"`\n  4175\t\tTreeDigest   string                     `json:\"tree_digest,omitempty\"`\n  4176\t\tEvidence     []ReviewBundleEvidence     `json:\"evidence,omitempty\"`\n  4177\t\tInputs       []ReviewBundleInput        `json:\"inputs\"`\n  4178\t\tTools        []ReviewPlanTool           `json:\"tools,omitempty\"`\n  4179\t}\n  4180\t\n  4181\tfunc reviewCriterionInputDigest(bundle ReviewBundle, criterion ReviewPlanCriterion) string {\n  4182\t\tdigest, _ := digestJSON(reviewCriterionInputContract(bundle, criterion))\n  4183\t\treturn digest\n  4184\t}\n  4185\t\n  4186\tfunc reviewAttestationID(att ReviewAttestation) string {\n  4187\t\tidentity := att\n  4188\t\tidentity.AttestationID = \"\"\n  4189\t\tidentity.Path = \"\"\n  4190\t\tidentity.Envelope = nil\n  4191\t\tdigest, _ := digestJSON(identity)\n  4192\t\treturn \"rva-\" + strings.TrimPrefix(digest, \"sha256:\")[:16]\n  4193\t}\n  4194\t\n  4195\tfunc reviewCriterionSubjectSensitive(criterion ReviewPlanCriterion) bool {\n  4196\t\tif len(criterion.EvidenceClasses) > 0 || len(criterion.Rules) == 0 {\n  4197\t\t\treturn true\n  4198\t\t}\n  4199\t\tfor _, rule := range criterion.Rules {\n  4200\t\t\tif rule != \"documentation-style\" && rule != \"knowledge-governance\" {\n  4201\t\t\t\treturn true\n  4202\t\t\t}\n  4203\t\t}\n  4204\t\treturn false\n  4205\t}\n  4206\t\n  4207\tfunc ReviewBundleDiff(from, to ReviewBundle) ReviewBundleDelta {\n  4208\t\tdelta := ReviewBundleDelta{FromBundle: from.BundleID, ToBundle: to.BundleID}\n  4209\t\tfromComponents := map[string]string{}\n  4210\t\ttoComponents := map[string]string{}\n  4211\t\tfor _, component := range from.Payload.Plan.Components {\n  4212\t\t\traw, _ := json.Marshal(component)\n  4213\t\t\tfromComponents[component.ID] = digestBytes(raw)\n  4214\t\t}\n  4215\t\tfor _, component := range to.Payload.Plan.Components {\n  4216\t\t\traw, _ := json.Marshal(component)\n  4217\t\t\ttoComponents[component.ID] = digestBytes(raw)\n  4218\t\t}\n  4219\t\tdelta.ChangedComponents = changedReviewBundleKeys(fromComponents, toComponents)\n  4220\t\tfromSections := map[string]string{}\n  4221\t\ttoSections := map[string]string{}\n  4222\t\tfor _, input := range from.Payload.Scope.Sections {\n  4223\t\t\tfromSections[input.Path] = input.Digest\n  4224\t\t}\n  4225\t\tfor _, input := range to.Payload.Scope.Sections {\n  4226\t\t\ttoSections[input.Path] = input.Digest\n  4227\t\t}\n  4228\t\tdelta.ChangedSections = changedReviewBundleKeys(fromSections, toSections)\n  4229\t\tfromPaths := map[string]string{}\n  4230\t\ttoPaths := map[string]string{}\n  4231\t\tpathNames := map[string]string{}\n  4232\t\tfor _, entry := range from.Payload.Subject.Entries {\n  4233\t\t\tkey := entry.Action + \"\\x00\" + entry.Path + \"\\x00\" + entry.NewPath\n  4234\t\t\tfromPaths[key] = entry.Digest\n  4235\t\t\tpathNames[key] = reviewBundleEntryPath(entry)\n  4236\t\t}\n  4237\t\tfor _, entry := range to.Payload.Subject.Entries {\n  4238\t\t\tkey := entry.Action + \"\\x00\" + entry.Path + \"\\x00\" + entry.NewPath\n  4239\t\t\ttoPaths[key] = entry.Digest\n  4240\t\t\tpathNames[key] = reviewBundleEntryPath(entry)\n  4241\t\t}\n  4242\t\tfor _, key := range changedReviewBundleKeys(fromPaths, toPaths) {\n  4243\t\t\tdelta.ChangedPaths = append(delta.ChangedPaths, pathNames[key])\n  4244\t\t}\n  4245\t\tfromCriteria := map[string]string{}\n  4246\t\ttoCriteria := map[string]string{}\n  4247\t\tfor _, criterion := range from.Payload.Plan.Criteria {\n  4248\t\t\tfromCriteria[criterion.ID] = reviewCriterionInputDigest(from, criterion)\n  4249\t\t}\n  4250\t\tfor _, criterion := range to.Payload.Plan.Criteria {\n  4251\t\t\ttoCriteria[criterion.ID] = reviewCriterionInputDigest(to, criterion)\n  4252\t\t\tif fromCriteria[criterion.ID] == toCriteria[criterion.ID] {\n  4253\t\t\t\tdelta.ReusableCriteria = append(delta.ReusableCriteria, criterion.ID)\n  4254\t\t\t}\n  4255\t\t}\n  4256\t\tdelta.ChangedCriteria = changedReviewBundleKeys(fromCriteria, toCriteria)\n  4257\t\tfromEvidence := map[string]string{}\n  4258\t\ttoEvidence := map[string]string{}\n  4259\t\tevidenceClasses := map[string][]string{}\n  4260\t\tfor _, evidence := range from.Payload.Evidence {\n  4261\t\t\traw, _ := json.Marshal(evidence)\n  4262\t\t\tfromEvidence[evidence.ID] = digestBytes(raw)\n  4263\t\t\tevidenceClasses[evidence.ID] = append(evidenceClasses[evidence.ID], evidence.EvidenceClass)\n  4264\t\t}\n  4265\t\tfor _, evidence := range to.Payload.Evidence {\n  4266\t\t\traw, _ := json.Marshal(evidence)\n  4267\t\t\ttoEvidence[evidence.ID] = digestBytes(raw)\n  4268\t\t\tevidenceClasses[evidence.ID] = append(evidenceClasses[evidence.ID], evidence.EvidenceClass)\n  4269\t\t}\n  4270\t\tdelta.ChangedEvidence = changedReviewBundleKeys(fromEvidence, toEvidence)\n  4271\t\tfor _, id := range delta.ChangedEvidence {\n  4272\t\t\tdelta.ChangedEvidenceClasses = append(delta.ChangedEvidenceClasses, evidenceClasses[id]...)\n  4273\t\t}\n  4274\t\tdelta.ChangedComponents = uniqueSorted(delta.ChangedComponents)\n  4275\t\tdelta.ChangedSections = uniqueSorted(delta.ChangedSections)\n  4276\t\tdelta.ChangedPaths = uniqueSorted(delta.ChangedPaths)\n  4277\t\tdelta.ChangedCriteria = uniqueSorted(delta.ChangedCriteria)\n  4278\t\tdelta.ChangedEvidence = uniqueSorted(delta.ChangedEvidence)\n  4279\t\tdelta.ChangedEvidenceClasses = uniqueSorted(delta.ChangedEvidenceClasses)\n  4280\t\tdelta.ReusableCriteria = uniqueSorted(delta.ReusableCriteria)\n  4281\t\treturn delta\n  4282\t}\n  4283\t\n  4284\tfunc changedReviewBundleKeys(from, to map[string]string) []string {\n  4285\t\tkeys := map[string]bool{}\n  4286\t\tfor key, value := range from {\n  4287\t\t\tif to[key] != value {\n  4288\t\t\t\tkeys[key] = true\n  4289\t\t\t}\n  4290\t\t}\n  4291\t\tfor key, value := range to {\n  4292\t\t\tif from[key] != value {\n  4293\t\t\t\tkeys[key] = true\n  4294\t\t\t}\n  4295\t\t}\n  4296\t\tresult := make([]string, 0, len(keys))\n  4297\t\tfor key := range keys {\n  4298\t\t\tresult = append(result, key)\n  4299\t\t}\n  4300\t\treturn uniqueSorted(result)\n  4301\t}\n  4302\t\n  4303\tfunc reviewBundleEntryPath(entry ReviewBundleSubjectEntry) string {\n  4304\t\tif entry.NewPath != \"\" {\n  4305\t\t\treturn entry.NewPath\n  4306\t\t}\n  4307\t\treturn entry.Path\n  4308\t}\n  4309\t\n  4310\t// verifiedAuthorityBlockers holds an attestation to a signed authority claim\n  4311\t// instead of to the string the reviewer wrote.\n  4312\t//\n  4313\t// What it proves is bounded and worth stating exactly: that an issuer this\n  4314\t// repository pinned, holding the grant for the role being claimed, signed a\n  4315\t// statement binding these principals and executions to this bundle, addressed\n  4316\t// to this project, still current. It does not prove the issuer told the truth,\n  4317\t// and it does not prove two principals think differently. Independence of\n  4318\t// execution and identity is what the contract can carry; cognitive\n  4319\t// independence is not, and the engine must not be read as claiming it.\n  4320\tfunc (s Store) verifiedAuthorityBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n  4321\t\tblockers := []string{}\n  4322\t\t// Claim fields are declarations until their signed bytes and bundle binding\n  4323\t\t// are authenticated. Keep this proof check shared with assurance disclosure\n  4324\t\t// (spec pose-review-disclosure-requires-proof), apart from approval semantics.\n  4325\t\tif att.BundleID != bundle.BundleID || att.BundleDigest != bundle.BundleDigest {\n  4326\t\t\tblockers = append(blockers, \"attestation does not reference the exact sealed bundle\")\n  4327\t\t}\n  4328\t\tif err := s.verifyStoredReviewAttestationSignature(att); err != nil {\n  4329\t\t\tblockers = append(blockers, err.Error())\n  4330\t\t}\n  4331\t\tclaim := att.Authority\n  4332\t\tif claim == nil {\n  4333\t\t\treturn append(blockers, \"review policy requires verified identity assurance and the attestation carries no authority claim; a reviewer prefix is a declaration, not a proof\")\n  4334\t\t}\n  4335\t\tif att.Envelope == nil {\n  4336\t\t\treturn append(blockers, \"an authority claim is only as good as its signature and this attestation carries none\")\n  4337\t\t}\n  4338\t\tpolicy, _, policyErr := s.loadReviewPolicy()\n  4339\t\tif policyErr != nil {\n  4340\t\t\treturn append(blockers, policyErr.Error())\n  4341\t\t}\n  4342\t\tif claim.SchemaVersion != ReviewBundleSchemaVersion {\n  4343\t\t\tblockers = append(blockers, fmt.Sprintf(\"the authority claim has unsupported schema version %d\", claim.SchemaVersion))\n  4344\t\t}\n  4345\t\tif claim.BundleDigest != bundle.BundleDigest {\n  4346\t\t\tblockers = append(blockers, \"the authority claim binds a different bundle than the one attested\")\n  4347\t\t}\n  4348\t\tif claim.Issuer != att.Envelope.Issuer {\n  4349\t\t\tblockers = append(blockers, \"the authority claim names an issuer other than the one that signed the attestation\")\n  4350\t\t}\n  4351\t\tif claim.Principal == \"\" || claim.Principal != att.Reviewer {\n  4352\t\t\tblockers = append(blockers, \"the authority claim principal does not match the attestation reviewer\")\n  4353\t\t}\n  4354\t\t// Replay from another project names that project here. An instance that\n  4355\t\t// requires verified authority and does not say who it is cannot check that,\n  4356\t\t// so the configuration is the blocker rather than the claim.\n  4357\t\tswitch {\n  4358\t\tcase policy.AuthorityAudience == \"\":\n  4359\t\t\tblockers = append(blockers, \"review policy requires verified identity assurance but declares no authority_audience, so a claim issued for any project would satisfy it\")\n  4360\t\tdefault:\n  4361\t\t\tif claim.Audience == \"\" {\n  4362\t\t\t\tblockers = append(blockers, \"the authority claim names no audience, so it is satisfied by any project that replays it\")\n  4363\t\t\t} else if claim.Audience != policy.AuthorityAudience {\n  4364\t\t\t\tblockers = append(blockers, \"the authority claim is addressed to \"+claim.Audience+\" and this project answers to \"+policy.AuthorityAudience)\n  4365\t\t\t}\n  4366\t\t\tif claim.Project == \"\" {\n  4367\t\t\t\tblockers = append(blockers, \"the authority claim names no project\")\n  4368\t\t\t} else if claim.Project != policy.AuthorityProject {\n  4369\t\t\t\tblockers = append(blockers, \"the authority claim names project \"+claim.Project+\" and this project is \"+policy.AuthorityProject)\n  4370\t\t\t}\n  4371\t\t}\n  4372\t\tblockers = append(blockers, s.reviewAuthorityTime(att).HistoricalBlockers...)\n  4373\t\tif claim.ReviewExecution == \"\" {\n  4374\t\t\tblockers = append(blockers, \"the authority claim must name the reviewing execution\")\n  4375\t\t}\n  4376\t\tswitch claim.Role {\n  4377\t\tcase \"agent\":\n  4378\t\t\tif !strings.HasPrefix(claim.Principal, \"agent:\") {\n  4379\t\t\t\tblockers = append(blockers, \"an agent authority claim must name an agent principal\")\n  4380\t\t\t}\n  4381\t\tcase \"human\":\n  4382\t\t\tif !strings.HasPrefix(claim.Principal, \"human:\") {\n  4383\t\t\t\tblockers = append(blockers, \"a human authority claim must name a human principal\")\n  4384\t\t\t}\n  4385\t\t\t// Signing an attestation and vouching for a person being a person are\n  4386\t\t\t// different authorities, so asserting a human role needs its own grant.\n  4387\t\t\tif !reviewIssuerHoldsGrant(policy.HumanAuthorityIssuers, att.Envelope.Issuer, att.Envelope.PublicKey) {\n  4388\t\t\t\tblockers = append(blockers, \"issuer \"+att.Envelope.Issuer+\" is trusted to sign attestations but is not authorised to assert a human principal\")\n  4389\t\t\t}\n  4390\t\tdefault:\n  4391\t\t\tblockers = append(blockers, \"the authority claim names an unknown role \"+claim.Role)\n  4392\t\t}\n  4393\t\t// The three values are ordered, and the checks have to be ordered with them.\n  4394\t\t//\n  4395\t\t// `mandatory-human` used to assert only the role, so the strongest value in\n  4396\t\t// the enum verified *less* separation than the one below it: the same human\n  4397\t\t// principal could implement and review in one run and satisfy it, while\n  4398\t\t// `different-actor` refused exactly that. Under `declared` the inconsistency\n  4399\t\t// was moot, since nothing was verified either way. Under `verified` it was a\n  4400\t\t// hole, because there the engine does claim to have checked separation\n  4401\t\t// (spec pose-abm-review-authority).\n  4402\t\t//\n  4403\t\t// The lowest value asks for a separate execution, not for the same actor:\n  4404\t\t// a review by another principal, in another run, is more separation, and\n  4405\t\t// refusing it made the floor stricter than `different-actor` for exactly\n  4406\t\t// the delegated reviews the roadmap delegated-review makes standard\n  4407\t\t// (spec pose-same-actor-level-admits-a-different-actor).\n  4408\t\tswitch bundle.Payload.Plan.Independence {\n  4409\t\tcase \"same-actor-separate-execution\":\n  4410\t\t\tif claim.ImplementationPrincipal == \"\" || claim.ImplementationExecution == \"\" {\n  4411\t\t\t\tblockers = append(blockers, \"review policy requires the implementation principal and execution in the authority claim\")\n  4412\t\t\t} else if claim.ReviewExecution == claim.ImplementationExecution {\n  4413\t\t\t\tblockers = append(blockers, \"review policy requires a separate execution and the claim names the implementation's own run\")\n  4414\t\t\t}\n  4415\t\tcase \"different-actor\", \"mandatory-human\":\n  4416\t\t\tif claim.ImplementationPrincipal == \"\" || claim.ImplementationExecution == \"\" {\n  4417\t\t\t\tblockers = append(blockers, \"review policy requires a different actor and the claim does not say who implemented\")\n  4418\t\t\t} else if att.Run != nil && claim.Role == \"agent\" && bundle.Payload.Plan.Independence == \"different-actor\" {\n  4419\t\t\t\tif _, err := s.verifyRunReviewReference(bundle, att); err != nil {\n  4420\t\t\t\t\tblockers = append(blockers, err.Error())\n  4421\t\t\t\t}\n  4422\t\t\t} else if claim.Principal == claim.ImplementationPrincipal {\n  4423\t\t\t\tblockers = append(blockers, \"review policy requires a different actor and the same principal implemented and reviewed\")\n  4424\t\t\t} else if claim.ReviewExecution == claim.ImplementationExecution {\n  4425\t\t\t\tblockers = append(blockers, \"review policy requires a separate review execution and the claim names the implementation's own run\")\n  4426\t\t\t}\n  4427\t\t\tif bundle.Payload.Plan.Independence == \"mandatory-human\" && claim.Role != \"human\" {\n  4428\t\t\t\tblockers = append(blockers, \"review policy requires human approval and the claim asserts role \"+claim.Role)\n  4429\t\t\t}\n  4430\t\t}\n  4431\t\treturn blockers\n  4432\t}\n  4433\t\n  4434\t// reviewIssuerHoldsGrant compares against the same `<issuer>#sha256:<digest>`\n  4435\t// pin form the attestation trust list uses, so a grant follows the key rather\n  4436\t// than the name: rotating a key revokes the grant until the new pin is added.\n  4437\tfunc reviewIssuerHoldsGrant(grants []string, issuer, publicKey string) bool {\n  4438\t\traw, err := base64.StdEncoding.DecodeString(publicKey)\n  4439\t\tif err != nil {\n  4440\t\t\treturn false\n  4441\t\t}\n  4442\t\tpin := issuer + \"#\" + digestBytes(raw)\n  4443\t\tfor _, grant := range grants {\n  4444\t\t\tif grant == pin {\n  4445\t\t\t\treturn true\n  4446\t\t\t}\n  4447\t\t}\n  4448\t\treturn false\n  4449\t}\n  4450\t\n  4451\t// sameFederatedManifest reports whether two sealed federated manifests record\n  4452\t// the same trust, sources and acceptance, including both being absent.\n  4453\tfunc sameFederatedManifest(a, b *FederatedRoadmapManifest) bool {\n  4454\t\tif a == nil || b == nil {\n  4455\t\t\treturn a == nil && b == nil\n  4456\t\t}\n  4457\t\tleft, errA := json.Marshal(a)\n  4458\t\tright, errB := json.Marshal(b)\n  4459\t\treturn errA == nil && errB == nil && bytes.Equal(left, right)\n  4460\t}\n  4461\t\n  4462\t// retainedApprovalStands reports whether a bundle retained for a closed scope holds\n  4463\t// against the manifest the scope resolves to now. It is the one judgment of that, so\n  4464\t// that `review verify` and closeout give the same answer (spec\n  4465\t// pose-closeout-judges-the-manifest R1, R2). Without a resolver no manifest can be\n  4466\t// judged.\n  4467\tfunc (s Store) retainedApprovalStands(bundle *ReviewBundle, current *FederatedRoadmapManifest) bool {\n  4468\t\tif !s.sealedDeclarationHolds(bundle) {\n  4469\t\t\treturn false\n  4470\t\t}\n  4471\t\treturn s.FederatedResolver == nil || s.federatedManifestStands(bundle.Payload.FederatedManifest, current)\n  4472\t}\n  4473\t\n  4474\t// sealedDeclarationHolds reports that a bundle of a roadmap sealed the reason the roadmap\n  4475\t// gives now for unreviewed milestones: an approval is no authority for an exception its\n  4476\t// reviewer never read.\n  4477\tfunc (s Store) sealedDeclarationHolds(bundle *ReviewBundle) bool {\n  4478\t\tif bundle.Payload.Scope.Kind != \"roadmap\" {\n  4479\t\t\treturn true\n  4480\t\t}\n  4481\t\trm, err := s.GetRoadmap(bundle.Payload.Scope.Slug)\n  4482\t\tif err != nil {\n  4483\t\t\treturn false\n  4484\t\t}\n  4485\t\tsealed := \"\"\n  4486\t\tfor _, section := range bundle.Payload.Scope.Sections {\n  4487\t\t\tif section.Kind == unreviewedMilestonesSection {\n  4488\t\t\t\tsealed = section.Path\n  4489\t\t\t}\n  4490\t\t}\n  4491\t\treturn sealed == rm.UnreviewedMilestones\n  4492\t}\n  4493\t\n  4494\t// newestResolvedHead is, of the heads of the change sets, the one no other descends from (the\n  4495\t// first commit of the topological order of their histories, which lists a descendant before its\n  4496\t// ancestors, so it does not depend on timestamps); empty when\n  4497\t// there are fewer than two distinct heads (nothing to choose) or Git cannot order them, in which\n  4498\t// case the caller keeps the head of the last set.\n  4499\tfunc (s Store) newestResolvedHead(sets []ChangeSet) string {\n  4500\t\tvar heads []string\n  4501\t\tseen := map[string]bool{}\n  4502\t\tfor _, set := range sets {\n  4503\t\t\tif set.ResolvedHead != \"\" && !seen[set.ResolvedHead] {\n  4504\t\t\t\tseen[set.ResolvedHead] = true\n  4505\t\t\t\theads = append(heads, set.ResolvedHead)\n  4506\t\t\t}\n  4507\t\t}\n  4508\t\tif len(heads) < 2 {\n  4509\t\t\treturn \"\"\n  4510\t\t}\n  4511\t\tfiles := s.fsys()\n  4512\t\tproducer := governanceProducerFromFiles(files, \"review\")\n  4513\t\tout, err := captureGovernanceGit(files, s.Root, producer, append([]string{\"rev-list\", \"--topo-order\", \"-n\", \"1\"}, heads...)...)\n  4514\t\tif err != nil {\n  4515\t\t\treturn \"\"\n  4516\t\t}\n  4517\t\tif first, _, _ := strings.Cut(strings.TrimSpace(string(out)), \"\\n\"); governanceFullObjectID.MatchString(first) {\n  4518\t\t\treturn first\n  4519\t\t}\n  4520\t\treturn \"\"\n  4521\t}\n  4522\t\n  4523\tfunc retainedManifestChanged(bundle *ReviewBundle, scope string) string {\n  4524\t\treturn \"the approval of bundle \" + bundle.BundleID + \" is not retained: the federated manifest of \" + scope + \" changed in a way that bears on its authority\"\n  4525\t}\n  4526\t\n  4527\t// federatedManifestStands reports whether a closed scope's sealed manifest still\n  4528\t// holds against the current one. It is sameFederatedManifest, less the one thing a\n  4529\t// guarded close itself changes: the lifecycle of a roadmap of this project, and the\n  4530\t// not-done blocker of a dependency that reached done. Anything not proved to be that\n  4531\t// is a difference (spec pose-roadmap-close-keeps-its-approvals R1-R3).\n  4532\tfunc (s Store) federatedManifestStands(sealed, current *FederatedRoadmapManifest) bool {\n  4533\t\tif s.manifestStandsOver(sealed, current) {\n  4534\t\t\treturn true\n  4535\t\t}\n  4536\t\twider := s.milestoneManifestWithItsRoadmapDependencies(sealed)\n  4537\t\treturn wider != nil && s.manifestStandsOver(sealed, wider)\n  4538\t}\n  4539\t\n  4540\t// milestoneManifestWithItsRoadmapDependencies is the manifest a milestone sealed\n  4541\t// before the depends_on of its roadmap stopped binding it (ADR\n  4542\t// a-milestone-answers-to-its-own-edges) would hold now. The edge moved by rule, so\n  4543\t// it is judged where it was sealed, for as long as the roadmap still declares it.\n  4544\tfunc (s Store) milestoneManifestWithItsRoadmapDependencies(sealed *FederatedRoadmapManifest) *FederatedRoadmapManifest {\n  4545\t\tif sealed == nil || sealed.Coordinator.Kind != \"milestone\" || s.FederatedResolver == nil {\n  4546\t\t\treturn nil\n  4547\t\t}\n  4548\t\trm, err := s.GetRoadmap(sealed.Coordinator.Slug)\n  4549\t\tif err != nil || len(rm.DependsOn) == 0 {\n  4550\t\t\treturn nil\n  4551\t\t}\n  4552\t\treport, err := s.milestoneAcceptance(s.FederatedProjectID, rm.Slug, sealed.Coordinator.Milestone, *s.FederatedResolver, true)\n  4553\t\tif err != nil {\n  4554\t\t\treturn nil\n  4555\t\t}\n  4556\t\treturn &report.Manifest\n  4557\t}\n  4558\t\n  4559\tfunc (s Store) manifestStandsOver(sealed, current *FederatedRoadmapManifest) bool {\n  4560\t\tif sameFederatedManifest(sealed, current) {\n  4561\t\t\treturn true\n  4562\t\t}\n  4563\t\tif sealed == nil || current == nil || len(sealed.Dependencies) != len(current.Dependencies) {\n  4564\t\t\treturn false\n  4565\t\t}\n  4566\t\twas := *sealed\n  4567\t\tif was.CoordinatorRevision != current.CoordinatorRevision {\n  4568\t\t\tif !s.sameRoadmapApartFromLifecycle(was.Coordinator, was.CoordinatorRevision, current.CoordinatorRevision) {\n  4569\t\t\t\treturn false\n  4570\t\t\t}\n  4571\t\t\twas.CoordinatorRevision = current.CoordinatorRevision\n  4572\t\t}\n  4573\t\twas.Dependencies = append([]FederatedDependency{}, sealed.Dependencies...)\n  4574\t\tmet := map[string]bool{}\n  4575\t\tfor i := range was.Dependencies {\n  4576\t\t\tthen, now := &was.Dependencies[i], current.Dependencies[i]\n  4577\t\t\tif then.SourceRevision == now.SourceRevision && then.SourceDigest == now.SourceDigest && then.Status == now.Status {\n  4578\t\t\t\tcontinue\n  4579\t\t\t}\n  4580\t\t\tif now.Identity.Project != was.Coordinator.Project || then.Status != now.Status && now.Status != \"done\" {\n  4581\t\t\t\treturn false\n  4582\t\t\t}\n  4583\t\t\tif !s.sameRoadmapApartFromLifecycle(now.Identity, then.SourceRevision, now.SourceRevision) {\n  4584\t\t\t\treturn false\n  4585\t\t\t}\n  4586\t\t\tif then.Status != now.Status {\n  4587\t\t\t\tmet[now.Ref+\":not-done\"] = true\n  4588\t\t\t}\n  4589\t\t\tthen.SourceRevision, then.SourceDigest, then.Status = now.SourceRevision, now.SourceDigest, now.Status\n  4590\t\t}\n  4591\t\tblockers := []string{}\n  4592\t\tfor _, blocker := range sealed.Blockers {\n  4593\t\t\tif !met[blocker] {\n  4594\t\t\t\tblockers = append(blockers, blocker)\n  4595\t\t\t}\n  4596\t\t}\n  4597\t\twas.Blockers, was.Ready, was.Digest = blockers, current.Ready, current.Digest\n  4598\t\treturn sameFederatedManifest(&was, current)\n  4599\t}\n  4600\t\n  4601\t// sameRoadmapApartFromLifecycle reports whether a roadmap's committed file holds\n  4602\t// the same between two revisions, but for its transition to done.\n  4603\tfunc (s Store) sameRoadmapApartFromLifecycle(identity ArtifactRef, from, to string) bool {\n  4604\t\tif identity.Kind != \"roadmap\" && identity.Kind != \"milestone\" {\n  4605\t\t\treturn false\n  4606\t\t}\n  4607\t\trm, err := s.GetRoadmap(identity.Slug)\n  4608\t\tif err != nil {\n  4609\t\t\treturn false\n  4610\t\t}\n  4611\t\trel, err := filepath.Rel(s.Root, rm.Path)\n  4612\t\tif err != nil {\n  4613\t\t\treturn false\n  4614\t\t}\n  4615\t\trel = filepath.ToSlash(rel)\n  4616\t\tfiles := s.fsys()\n  4617\t\tproducer := governanceProducerFromFiles(files, \"review\")\n  4618\t\tthen, err := captureGovernanceGit(files, s.Root, producer, \"show\", from+\":\"+rel)\n  4619\t\tif err != nil {\n  4620\t\t\tif hasGitMetadataIn(files, s.Root) {\n  4621\t\t\t\tmarkGovernanceReadUnknownForProject(files, s.Root, \"\", producer, \"the earlier roadmap revision could not be read from Git\")\n  4622\t\t\t}\n  4623\t\t\treturn false\n  4624\t\t}\n  4625\t\tnow, err := captureGovernanceGit(files, s.Root, producer, \"show\", to+\":\"+rel)\n  4626\t\tif err != nil {\n  4627\t\t\tif hasGitMetadataIn(files, s.Root) {\n  4628\t\t\t\tmarkGovernanceReadUnknownForProject(files, s.Root, \"\", producer, \"the later roadmap revision could not be read from Git\")\n  4629\t\t\t}\n  4630\t\t\treturn false\n  4631\t\t}\n  4632\t\treturn bytes.Equal(then, now) || roadmapClosedBetween(string(then), string(now))\n  4633\t}\n  4634\t\n  4635\t// roadmapClosedBetween reports whether now is then and the bytes the guarded close\n  4636\t// of a roadmap writes, on a roadmap that was not done, and no others.\n  4637\tfunc roadmapClosedBetween(then, now string) bool {\n  4638\t\tbefore, bodyBefore := SplitFrontmatter(then)\n  4639\t\tafter, bodyAfter := SplitFrontmatter(now)\n  4640\t\treturn before[\"status\"] != \"done\" && after[\"status\"] == \"done\" && bodyBefore == bodyAfter && ReplaceFrontmatterValue(then, \"status\", \"done\") == now\n  4641\t}\n  4642\t\n  4643\t// foldJSONKey maps a key to one representative of its case-folding class,\n  4644\t// the classes encoding/json treats as the same field.\n  4645\tfunc foldJSONKey(key string) string {\n  4646\t\tvar b strings.Builder\n  4647\t\tfor _, r := range key {\n  4648\t\t\tleast := r\n  4649\t\t\tfor f := unicode.SimpleFold(r); f != r; f = unicode.SimpleFold(f) {\n  4650\t\t\t\tif f < least {\n  4651\t\t\t\t\tleast = f\n  4652\t\t\t\t}\n  4653\t\t\t}\n  4654\t\t\tb.WriteRune(least)\n  4655\t\t}\n  4656\t\treturn b.String()\n  4657\t}\n  4658\t\n  4659\t// Only the distributed directory-alias shape is supported. Hash the link's\n  4660\t// own bytes, never read through a client alias to arbitrary filesystem content.\n  4661\tfunc reviewBundleClaudeSkillAlias(path string) bool {\n  4662\t\tconst prefix = \".claude/skills/\"\n  4663\t\tname := strings.TrimPrefix(path, prefix)\n  4664\t\treturn name != path && name != \"\" && name != \".\" && name != \"..\" && !strings.ContainsAny(name, \"/\\\\\")\n  4665\t}\n  4666\t\n  4667\tfunc (s Store) reviewBundleClaudeSkillDigest(rel string) (string, error) {\n  4668\t\tfail := func() (string, error) {\n  4669\t\t\treturn \"\", fmt.Errorf(\"review subject skill alias %s must link directly to its canonical project skill through real directories\", rel)\n  4670\t\t}\n  4671\t\tfiles := s.fsys()\n  4672\t\tname := strings.TrimPrefix(rel, \".claude/skills/\")\n  4673\t\tfor _, parent := range []string{\".claude\", \".claude/skills\", \".agents\", \".agents/skills\", \".agents/skills/\" + name} {\n  4674\t\t\tinfo, err := files.Lstat(filepath.Join(s.Root, filepath.FromSlash(parent)))\n  4675\t\t\tif err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {\n  4676\t\t\t\treturn fail()\n  4677\t\t\t}\n  4678\t\t}\n  4679\t\ttarget, err := files.Readlink(filepath.Join(s.Root, filepath.FromSlash(rel)))\n  4680\t\tif err != nil || target != \"../../.agents/skills/\"+name {\n  4681\t\t\treturn fail()\n  4682\t\t}\n  4683\t\tinfo, err := files.Lstat(filepath.Join(s.Root, \".agents\", \"skills\", name, \"SKILL.md\"))\n  4684\t\tif err != nil || !info.Mode().IsRegular() {\n  4685\t\t\treturn fail()\n  4686\t\t}\n  4687\t\treturn digestBytes([]byte(target)), nil\n  4688\t}\n","exit_code":0,"status":"completed"}}
