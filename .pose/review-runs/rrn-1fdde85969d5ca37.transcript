{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '680,780p' pose-mcp/internal/pose/federated_acceptance.go\"","aggregated_output":"\t}\n\tparentReal, err1 := files.EvalSymlinks(parent.Root)\n\tchildReal, err2 := files.EvalSymlinks(child.Root)\n\tif err1 != nil || err2 != nil {\n\t\treturn false\n\t}\n\trel, err := filepath.Rel(parentReal, childReal)\n\tif err != nil || rel == \"..\" || strings.HasPrefix(rel, \"..\"+string(filepath.Separator)) {\n\t\treturn true // sibling project, explicitly selected in Roots.\n\t}\n\tlisting, err := captureFederatedGit(files, parent.Root, \"ls-tree\", \"HEAD\", \"--\", filepath.ToSlash(rel))\n\tif err != nil {\n\t\treturn false\n\t}\n\tfields := strings.Fields(string(listing))\n\tif len(fields) < 3 || fields[0] != \"160000\" || fields[1] != \"commit\" {\n\t\treturn false\n\t}\n\treturn fields[2] == revision\n}\n\n// federatedGitlinkMatches reads the filesystem directly; federatedGitlinkMatchesIn reads the operation's files.\nfunc federatedGitlinkMatches(parent, child Store, revision string) bool {\n\treturn federatedGitlinkMatchesIn(NativeFiles(), parent, child, revision)\n}\n\nfunc federatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\n\tscope := localFederatedScope(identity)\n\tstate, err := source.GetCloseoutState(scope)\n\tif err != nil || !state.Terminal {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-not-terminal\"}\n\t}\n\t// A milestone or roadmap the source closed without its own review, under\n\t// its adopted closeout review policy, is proven by the receipt of that\n\t// close: the source's policy decides, never the consumer's. Its members\n\t// are federated with their own reviews (spec\n\t// pose-closeout-review-policy-by-cost-benefit).\n\tif receipt := state.CloseoutReceipt; receipt != nil && !receipt.Decision.Required && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n\t\traw, err := json.Marshal(receipt)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-receipt-unreadable\"}\n\t\t}\n\t\treturn \"closeout-receipt:\" + scope, \"sha256:\" + digestHex(raw), receipt.SubjectDigest, receipt.PolicyDigest, nil, nil, nil\n\t}\n\tverification, err := source.VerifyReviewBundle(scope)\n\t// A milestone its roadmap declares has no review of its own: what a consumer can\n\t// hold is the review of that roadmap, which sealed the declaration.\n\tif err == nil && identity.Kind == \"milestone\" && strings.HasPrefix(verification.ApprovalOrigin, \"declared:\") {\n\t\tverification, err = source.VerifyReviewBundle(\"roadmap:\" + identity.Slug)\n\t}\n\tif err != nil || !verification.Fresh || !verification.Approved || verification.Bundle == nil || verification.Attestation == nil || !source.sealedDeclarationHolds(verification.Bundle) {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-review-not-approved\"}\n\t}\n\tbundle := verification.Bundle\n\teligible := federatedSourceEvidenceEligibilityIn(files, source.Root, pinnedRevision, bundle.Payload.Subject.Head)\n\tif identity.Kind == \"spec\" {\n\t\tspec, err := source.GetSpec(identity.Slug)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":unavailable-artifact\"}\n\t\t}\n\t\ttargets, _, err := ParseDeliveryTargets(*spec)\n\t\tif err != nil || len(targets) == 0 {\n\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-target-missing\"}\n\t\t}\n\t\tprofiles, err := loadFederatedDeliveryProfiles(files, source.Root)\n\t\tif err != nil {\n\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-profile-unavailable\"}\n\t\t}\n\t\tblockers := []string{}\n\t\tfor _, target := range targets {\n\t\t\tprofile, ok := profiles[target.Profile]\n\t\t\tif !ok || profile.Kind != target.Kind {\n\t\t\t\tblockers = append(blockers, scope+\":source-delivery-profile-unsupported\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseen := map[string]bool{}\n\t\t\tfor _, evidence := range bundle.Payload.Evidence {\n\t\t\t\tif eligible(evidence) && moduleMatchesTarget(evidence.Module, target.Module) {\n\t\t\t\t\tseen[evidence.EvidenceClass] = true\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor _, required := range profile.RequiredEvidenceClasses {\n\t\t\t\tif !seen[required] {\n\t\t\t\t\tblockers = append(blockers, scope+\":source-delivery-evidence-missing:\"+target.Ref+\":\"+required)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif len(profile.AnyEvidenceClasses) > 0 {\n\t\t\t\tfound := false\n\t\t\t\tfor _, class := range profile.AnyEvidenceClasses {\n\t\t\t\t\tfound = found || seen[class]\n\t\t\t\t}\n\t\t\t\tif !found {\n\t\t\t\t\tblockers = append(blockers, scope+\":source-delivery-evidence-missing:\"+target.Ref+\":one-of\")\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tproof := federatedBundleEvidence(files, bundle, eligible)\n\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, proof, uniqueSorted(blockers)\n\t}\n\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, federatedBundleEvidence(files, bundle, eligible), nil\n}\n","exit_code":0,"status":"completed"}}
