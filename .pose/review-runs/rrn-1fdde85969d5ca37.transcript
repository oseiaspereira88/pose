 false, Blockers: []string{}}\n-\tif !policy.Enabled {\n+\t// An adopted closeout review policy decides an aggregate scope before the\n+\t// legacy shortcuts: neither enabled=false nor an adoption cutoff weakens\n+\t// what it requires (spec pose-closeout-review-policy-by-cost-benefit).\n+\tdecision, exempt, err := s.closeoutReviewGate(ref, policy)\n+\tif err != nil {\n+\t\treturn eval, err\n+\t}\n+\teval.CloseoutReview = decision\n+\tif decision != nil {\n+\t\tif exempt {\n+\t\t\teval.Required = false\n+\t\t\teval.Fresh = true\n+\t\t\teval.ApprovalOrigin = closeoutApprovalOrigin(*decision)\n+\t\t\teval.Warnings = append(eval.Warnings, closeoutExemptionWarning(ref, *decision))\n+\t\t\treturn eval, nil\n+\t\t}\n+\t\teval.Required = true\n+\t\tif !decision.Known {\n+\t\t\teval.Blockers = append(eval.Blockers, decision.Diagnostics...)\n+\t\t\treturn eval, nil\n+\t\t}\n+\t}\n+\tif !policy.Enabled && decision == nil {\n \t\teval.Warnings = append(eval.Warnings, \"review policy is absent or disabled; closeout review is not enforced\")\n \t\treturn eval, nil\n \t}\n \tprofileRef := policy.Profiles[scope.Kind]\n \teval.Profile = profileRef\n-\trequired, err := s.reviewRequiredForScope(scope, policy)\n-\tif err != nil {\n-\t\treturn eval, err\n+\trequired := true\n+\tif decision == nil {\n+\t\trequired, err = s.reviewRequiredForScope(scope, policy)\n+\t\tif err != nil {\n+\t\t\treturn eval, err\n+\t\t}\n \t}\n \teval.Required = required\n \tif !required {\n@@ -2654,7 +2722,11 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t}\n \t\t\tfound = true\n \t\t\tfor _, raw := range milestone.Specs {\n-\t\t\t\tslug, external := s.milestoneMember(raw)\n+\t\t\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n+\t\t\t\tif unresolved != \"\" {\n+\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", unresolved, raw))\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n \t\t\t\tif external {\n \t\t\t\t\tif s.FederatedResolver == nil {\n \t\t\t\t\t\tblock(NewDiagnostic(\"external-member-unaccepted\", \"external member \"+raw+\" needs federated acceptance\", raw))\n@@ -2671,6 +2743,14 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\n \t\t\t\t}\n \t\t\t}\n+\t\t\t// An exempt milestone has no review of its own to judge its exit\n+\t\t\t// gate: an approved member review must have judged it as it reads\n+\t\t\t// now, or the close is blocked; the review stays dispensed. This\n+\t\t\t// holds for one member too: a done spec sealed before the gate\n+\t\t\t// existed never gains it (review round 6, N21).\n+\t\t\tif decision := review.CloseoutReview; decision != nil && !decision.Required && strings.TrimSpace(milestone.ExitGate) != \"\" && !review.Approved && !s.exitGateJudgedByMember(rm.Slug, milestone, state.Children) {\n+\t\t\t\tblock(NewDiagnostic(\"milestone-exit-gate-unjudged\", \"the exit gate of \"+ref+\" is judged by no approved review: seal and review the member that carries it (the only member, or the last one once every other member is closed), or review the milestone itself (`pose review bundle \"+ref+\" --seal`)\", ref))\n+\t\t\t}\n \t\t\tbreak\n \t\t}\n \t\tif !found {\n@@ -2725,7 +2805,38 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t}\n \t\t}\n \t}\n-\tif !review.Required {\n+\tcloseOwed := false\n+\tif scope.Kind == \"milestone\" || scope.Kind == \"roadmap\" {\n+\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil && policy.CloseoutReviewAdopted() {\n+\t\t\treceipt, receiptErr := s.ReadCloseoutReceipt(ref)\n+\t\t\tif receiptErr != nil {\n+\t\t\t\tblock(OpaqueDiagnostic(\"closeout-receipt-invalid\", DiagnosticCloseout, receiptErr.Error()))\n+\t\t\t}\n+\t\t\tstate.CloseoutReceipt = receipt\n+\t\t\tif decision := review.CloseoutReview; decision != nil && receipt == nil && receiptErr == nil {\n+\t\t\t\t/