{"type":"item.completed","item":{"id":"item_88","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '709,758p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"func (s Store) reviewBundleSubject(scope ScopeRef, components []ReviewPlanComponent, graph DeliveryIntegrityGraph, blockers []string) (ReviewBundleSubject, []ReviewBundleInput, []string, error) {\n\tif len(components) == 0 {\n\t\tif ctx, err := s.resolveReviewPlanContext(scope); err == nil {\n\t\t\tcomponents = ctx.Components\n\t\t}\n\t}\n\tsubject := ReviewBundleSubject{ChangeSets: []string{}, Entries: []ReviewBundleSubjectEntry{}}\n\texcluded := []ReviewBundleInput{}\n\tallowedSpecs, err := s.reviewBundleScopeSpecs(scope)\n\tif err != nil {\n\t\treturn subject, excluded, blockers, err\n\t}\n\tsets := []ChangeSet{}\n\tfor _, set := range graph.ChangeSets {\n\t\tif allowedSpecs[set.Spec] {\n\t\t\tsets = append(sets, set)\n\t\t}\n\t}\n\t// Every selected spec that observes a path the subject reads — whatever\n\t// its action, and read before reduction drops a set whose commits\n\t// another contains: an entry is kept once, but a removal must hold for\n\t// all of them (SR-R1-02, SR-R2-01, SR-R3-01). The removing spec's own\n\t// observation asks nothing of it.\n\tobservers := map[string][]string{}\n\tfor _, set := range sets {\n\t\tfor _, observed := range set.Paths {\n\t\t\tif observed.Action == \"removed\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tpath := observed.Path\n\t\t\tif observed.Action == \"renamed\" {\n\t\t\t\tpath = observed.NewPath\n\t\t\t}\n\t\t\tobservers[path] = append(observers[path], set.Spec)\n\t\t}\n\t}\n\tsets = reduceReviewBundleChangeSets(sets)\n\tif len(sets) == 0 && s.milestoneOnlyExternal(scope) {\n\t\t// Every member is owned by another project: the implementation is\n\t\t// sealed through the federated manifest, with its source proof, and\n\t\t// there is no local subject to attribute.\n\t\treturn subject, excluded, blockers, nil\n\t}\n\tif len(sets) == 0 {\n\t\tmissing := missingChangeSetBlocker + scope.String()\n\t\tif scope.Kind == \"spec\" {\n\t\t\tmissing += \"; the index holds no commit with `POSE-Spec: \" + scope.Slug + \"`: add the line to the implementing commit, run `pose index` and confirm with `pose artifact-check --spec \" + scope.Slug + \"`\"\n\t\t}\n\t\tblockers = append(blockers, missing)\n\t\treturn subject, excluded, blockers, nil\n","exit_code":0,"status":"completed"}}
