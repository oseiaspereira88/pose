_policy_test.go    |   346 +\n .../cli/delegate_redaction_failure_test.go         |    55 +\n pose-mcp/internal/cli/doctor.go                    |    25 +\n pose-mcp/internal/cli/portfolio_projection.go      |     5 +\n pose-mcp/internal/cli/progressive_review_test.go   |     6 +\n .../internal/cli/release_compatibility_test.go     |    28 +\n pose-mcp/internal/cli/review_closeout.go           |   219 +-\n pose-mcp/internal/cli/setup.go                     |    42 +-\n pose-mcp/internal/cli/surface_check.go             |    16 +-\n .../mcpserver/closeout_review_policy_test.go       |    74 +\n pose-mcp/internal/pose/artifact_ref.go             |     8 +-\n pose-mcp/internal/pose/capability_catalog.go       |    76 +-\n pose-mcp/internal/pose/capability_catalog_test.go  |     2 +-\n .../internal/pose/claude_sandboxed_review_test.go  |   352 +\n .../internal/pose/closeout_adr_associations.go     |   217 +\n pose-mcp/internal/pose/closeout_receipt.go         |   286 +\n pose-mcp/internal/pose/closeout_review_policy.go   |   897 ++\n .../internal/pose/closeout_review_policy_test.go   |  1232 +++\n pose-mcp/internal/pose/delegation_events.go        |    46 +\n pose-mcp/internal/pose/delegation_policy.go        |    66 +-\n pose-mcp/internal/pose/diagnostic_codes.go         |     5 +\n pose-mcp/internal/pose/federated_acceptance.go     |    63 +-\n pose-mcp/internal/pose/obligation_projection.go    |    21 +-\n pose-mcp/internal/pose/readiness.go                |     2 +\n pose-mcp/internal/pose/review_bundle.go            |    39 +-\n pose-mcp/internal/pose/review_closeout.go          |   143 +-\n pose-mcp/internal/pose/review_dispatch.go          |    41 +-\n pose-mcp/internal/pose/review_plan.go              |    32 +-\n pose-mcp/internal/pose/review_run_continuity.go    |    10 +-\n pose-mcp/internal/pose/roadmaps.go                 |    57 +-\n pose-mcp/internal/pose/spec.go                     |     8 +\n pose-mcp/internal/pose/spec_transfer.go            |     2 +-