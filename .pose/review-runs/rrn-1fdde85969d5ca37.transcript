{"type":"item.completed","item":{"id":"item_101","type":"command_execution","command":"/usr/bin/bash -lc \"python3 -c 'from pathlib import Path; p=Path(\\\"pose-mcp/internal/pose/closeout_review_policy.go\\\"); a=p.read_text().splitlines(); print(\\\"\\\\n\\\".join(f\\\"{i+1}: {a[i]}\\\" for lo,hi in [(735,798),(866,896)] for i in range(lo-1,hi)))'\"","aggregated_output":"735: \t}\n736: \treturn true\n737: }\n738: \n739: // closedByReceipt reports an aggregate scope that reads closed: a receipt\n740: // that still stands for the scope as it is, or, with no receipt, a verified\n741: // closure from before adoption (a historical roadmap's scopes, or a milestone\n742: // approved under a plan without a closeout decision), never backfilled with a\n743: // receipt. Either way the scope must pass the whole terminal verifier closeout\n744: // applies: its review, a refusal recorded later, its children, its gates, and\n745: // the acceptance of its dependency edges (predecessors, consumed outcomes,\n746: // members), local and remote. It is the one terminal projection reached,\n747: // roadmap-reached, attention and doctor ask.\n748: func (s Store) closedByReceipt(ref string) (bool, error) {\n749: \tif len(s.closeoutChain) == 0 || s.closeoutChain[len(s.closeoutChain)-1] != ref {\n750: \t\ts.closeoutChain = append(append([]string{}, s.closeoutChain...), ref)\n751: \t}\n752: \treceipt, err := s.ReadCloseoutReceipt(ref)\n753: \tif err != nil {\n754: \t\treturn false, err\n755: \t}\n756: \tif receipt != nil {\n757: \t\tpolicy, _, err := s.loadReviewPolicy()\n758: \t\tif err != nil {\n759: \t\t\treturn false, err\n760: \t\t}\n761: \t\tif s.closeoutReceiptStands(*receipt, policy) != nil {\n762: \t\t\treturn false, nil\n763: \t\t}\n764: \t} else {\n765: \t\tscope, err := ParseScopeRef(ref)\n766: \t\tif err != nil {\n767: \t\t\treturn false, err\n768: \t\t}\n769: \t\tif !s.closeoutScopeHistorical(scope) && !s.milestoneClosedBeforeAdoption(scope) {\n770: \t\t\treturn false, nil\n771: \t\t}\n772: \t}\n773: \treturn s.closeoutTerminalWithDependencies(ref), nil\n774: }\n775: \n776: // closeoutTerminalWithDependencies runs the terminal verifier with dependency\n777: // acceptance, through the store's bound resolver or, without one, the\n778: // resolver the environment binds to this root, as `pose close` does. A\n779: // resolver that cannot be built leaves the edges unjudged, so the scope does\n780: // not read closed. Same-project edges are judged by their lifecycle and\n781: // revision, without recursion into their closeout, and remote recursion stops\n782: // at a cycle, so the projection converges.\n783: func (s Store) closeoutTerminalWithDependencies(ref string) bool {\n784: \tif s.FederatedResolver == nil || s.FederatedResolver.Roots == nil {\n785: \t\tresolver, project, err := EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n786: \t\tif err != nil {\n787: \t\t\treturn false\n788: \t\t}\n789: \t\ts.FederatedProjectID, s.FederatedResolver = project, &resolver\n790: \t}\n791: \tstate, err := s.getCloseoutState(ref, true)\n792: \treturn err == nil && state.Terminal\n793: }\n794: \n795: // scopeReviewRecorded reports a review of the scope on file: a bundle or a\n796: // legacy attempt. A record that cannot be read counts as recorded, so an\n797: // unreadable rejection never turns into an exemption.\n798: func (s Store) scopeReviewRecorded(ref string) bool {\n866: \t\t\tcontinue\n867: \t\t}\n868: \t\t// The applicable gate, not the current threshold alone: a receipt\n869: \t\t// keeps the decision it closed under, and a review recorded on the\n870: \t\t// scope anyway stands until it approves (review round 7, N26).\n871: \t\tgated, exempt, err := s.closeoutReviewGate(ref, policy)\n872: \t\tif err != nil {\n873: \t\t\towing = append(owing, CloseoutReviewOwing{Scope: ref, Decision: CloseoutReviewDecision{Scope: ref, Adopted: true, Required: true, Reason: err.Error()}, Previous: \"unknown: no snapshot of the earlier policy or composition is recorded\", Action: \"resolve \" + err.Error()})\n874: \t\t\tcontinue\n875: \t\t}\n876: \t\tif exempt || gated == nil {\n877: \t\t\tcontinue\n878: \t\t}\n879: \t\tdecision := *gated\n880: \t\t// A recorded approval counts only while it satisfies the current\n881: \t\t// obligation: fresh, for the scope as it is now.\n882: \t\tif eval, err := s.ReviewCheck(ref); err == nil && eval.Approved && eval.Fresh {\n883: \t\t\tcontinue\n884: \t\t}\n885: \t\taction := \"seal and review \" + ref + \" (`pose review bundle \" + ref + \" --seal`), then `pose close \" + ref + \"`\"\n886: \t\tif !decision.Known {\n887: \t\t\taction = \"resolve \" + strings.Join(decision.Diagnostics, \"; \")\n888: \t\t}\n889: \t\towing = append(owing, CloseoutReviewOwing{Scope: ref, Decision: decision, Previous: \"unknown: no snapshot of the earlier policy or composition is recorded\", Action: action})\n890: \t}\n891: \treturn owing, nil\n892: }\n893: \n894: func mustScope(ref string) ScopeRef {\n895: \tscope, _ := ParseScopeRef(ref)\n896: \treturn scope\n","exit_code":0,"status":"completed"}}
