endencyClosed(resolver, project, resolved); !closed {\npose-mcp/internal/cli/surface_check.go:402: \t\t\t// external one by federated acceptance (review round 6, N24).\npose-mcp/internal/cli/portfolio_projection.go:179: \t\t\t\t\tif closed, why := store.AggregateDependencyClosed(resolver, project, resolved); !res.Blocking && !closed {\n","exit_code":0,"status":"completed"}}
