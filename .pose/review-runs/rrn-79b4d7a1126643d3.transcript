{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BQo6HXWsCg6Z4EYMmxvMt6","type":"tool_result","content":"1\tpackage pose\n2\t\n3\t// Accepted limits (spec pose-review-declared-threat-model): a spec declares\n4\t// the residual limits of a guarantee it makes, each with a stable id and why\n5\t// it is accepted. The review plan seals them; the brief lists them; a\n6\t// reviewer classifies a finding that falls inside one as within that limit,\n7\t// or disputes the limit as a finding of its own. A declared limit never\n8\t// hides a defect inside the declared scope: it is visible in the bundle, the\n9\t// brief and the attestation.\n10\t\n11\timport (\n12\t\t\"regexp\"\n13\t\t\"strings\"\n14\t)\n15\t\n16\t// ReviewAcceptedLimit is one declared residual limit.\n17\ttype ReviewAcceptedLimit struct {\n18\t\tID   string `json:\"id\"`\n19\t\tText string `json:\"text\"`\n20\t\t// Spec names the spec that declared the limit when the scope holds more\n21\t\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n22\t\tSpec string `json:\"spec,omitempty\"`\n23\t}\n24\t\n25\tvar acceptedLimitRE = regexp.MustCompile(`^[-*+]\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n26\t\n27\t// acceptedLimitMarkerRE finds the marker where a sentence opens, after the\n28\t// assumption: \"<assumption>. Accepted because <reason>.\" A marker inside a\n29\t// sentence (\"Not accepted because\") is not one (review round 3, N1).\n30\tvar acceptedLimitMarkerRE = regexp.MustCompile(`[.;:!?]\\s+(?:Accepted because|Aceito porque)\\s+`)\n31\t\n32\t// acceptedLimitReasonWordRE is a word with at least one letter.\n33\tvar acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n34\t\n35\t// hasAcceptedLimitReason reads an entry as written: an assumption of at\n36\t// least two words, then the marker opening a sentence, then a reason of at\n37\t// least two words in that same sentence. A marker alone, punctuation, a\n38\t// missing assumption or a reason borrowed from a later sentence does not say\n39\t// why a limit is accepted (review rounds 1–4).\n40\tfunc hasAcceptedLimitReason(text string) bool {\n41\t\tloc := acceptedLimitMarkerRE.FindStringIndex(text)\n42\t\tif loc == nil {\n43\t\t\treturn false\n44\t\t}\n45\t\tassumption, rest := text[:loc[0]], text[loc[1]:]\n46\t\tif end := strings.IndexAny(rest, \".;!?\"); end >= 0 {\n47\t\t\trest = rest[:end]\n48\t\t}\n49\t\treturn len(acceptedLimitReasonWordRE.FindAllString(assumption, -1)) >= 2 && len(acceptedLimitReasonWordRE.FindAllString(rest, -1)) >= 2\n50\t}\n51\t\n52\t// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n53\t// It returns the limits and the problems that keep the section from being\n54\t// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n55\t// limit that does not say why it is accepted (\"Accepted because ...\" or\n56\t// \"Aceito porque ...\").\n57\tfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n58\t\tvar limits []ReviewAcceptedLimit\n59\t\tvar problems []string\n60\t\tin := false\n61\t\tseen := map[string]bool{}\n62\t\t// The section is read fail-closed (review rounds 8 to 10): it holds only\n63\t\t// limits, each one list item whose wrapped lines are indented deeper than\n64\t\t// its marker (also after a blank line). Any other line in the section\n65\t\t// (prose, a lazy unindented continuation, a nested list, a fence, another\n66\t\t// kind of item) is reported, and the limit it belongs to or follows is\n67\t\t// not sealed: the engine never seals a limit it may have read in part.\n68\t\t// Fenced blocks and HTML comments outside the section are not the spec's\n69\t\t// declarations, so examples there are never read.\n70\t\ttype entry struct {\n71\t\t\tid, text string\n72\t\t\tindent   int\n73\t\t\tbad      bool\n74\t\t}\n75\t\tvar entries []entry\n76\t\treport := func(line, why string) {\n77\t\t\tproblems = append(problems, \"accepted limits: \"+quoteLedgerText(strings.TrimSpace(line))+\" \"+why)\n78\t\t\tif len(entries) > 0 && !entries[len(entries)-1].bad {\n79\t\t\t\tentries[len(entries)-1].bad = true\n80\t\t\t}\n81\t\t}\n82\t\t// Any unterminated comment, not only the first, hides what follows it\n83\t\t// (spec pose-review-declared-limits-followups R2).\n84\t\tif unterminatedHTMLComment(body) {\n85\t\t\tproblems = append(problems, \"accepted limits: an unterminated HTML comment hides the rest of the spec\")\n86\t\t}\n87\t\t// A comment inside the section, also one written in inline code, would\n88\t\t// change a limit's sealed text: the section is refused whole instead of\n89\t\t// guessing which is meant (R2, D1).\n90\t\tif commentInAcceptedLimitsSection(body) {\n91\t\t\tproblems = append(problems, \"accepted limits: the section holds an HTML comment marker; write the limits without comments\")\n92\t\t\treturn nil, problems\n93\t\t}\n94\t\ttext := stripLimitComments(body)\n95\t\tfence := \"\"\n96\t\tfor _, line := range strings.Split(text, \"\\n\") {\n97\t\t\ttrimmed := strings.TrimSpace(line)\n98\t\t\tindent := len(line) - len(strings.TrimLeft(line, \" \\t\"))\n99\t\t\tif marker := fenceMarker(trimmed); marker != \"\" {\n100\t\t\t\tif in {\n101\t\t\t\t\treport(line, \"is a code fence; examples belong outside the section\")\n102\t\t\t\t}\n103\t\t\t\tswitch {\n104\t\t\t\tcase fence == \"\":\n105\t\t\t\t\tfence = marker\n106\t\t\t\tcase marker[0] == fence[0] && len(marker) >= len(fence) && strings.TrimLeft(trimmed, marker[:1]) == \"\":\n107\t\t\t\t\tfence = \"\"\n108\t\t\t\t}\n109\t\t\t\tcontinue\n110\t\t\t}\n111\t\t\tif fence != \"\" {\n112\t\t\t\tcontinue\n113\t\t\t}\n114\t\t\tif in && indent > 0 && len(entries) > 0 && indent > entries[len(entries)-1].indent && indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n115\t\t\t\t// A heading-like line indented under a limit: read as a heading it\n116\t\t\t\t// would end the section and cut the limit (R1).\n117\t\t\t\treport(line, \"is a heading inside a limit; write the limit as one item\")\n118\t\t\t\tcontinue\n119\t\t\t}\n120\t\t\tif indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n121\t\t\t\theading := strings.TrimSpace(strings.Trim(trimmed, \"# \"))\n122\t\t\t\tin = strings.EqualFold(heading, \"Accepted limits\") || strings.EqualFold(heading, \"Limites aceitos\")\n123\t\t\t\tcontinue\n124\t\t\t}\n125\t\t\tif !in || trimmed == \"\" {\n126\t\t\t\tcontinue\n127\t\t\t}\n128\t\t\t// A line indented under the current limit belongs to it: a list\n129\t\t\t// there is nested, anything else continues the limit.\n130\t\t\tunder := len(entries) > 0 && indent > entries[len(entries)-1].indent\n131\t\t\tif under && listItemRE.MatchString(trimmed) {\n132\t\t\t\treport(line, \"is a nested list; write the limit as one item\")\n133\t\t\t\tcontinue\n134\t\t\t}\n135\t\t\tif !under && indent <= 3 {\n136\t\t\t\tif m := acceptedLimitRE.FindStringSubmatch(trimmed); m != nil {\n137\t\t\t\t\tentries = append(entries, entry{id: m[1], text: strings.TrimSpace(m[2]), indent: indent})\n138\t\t\t\t\tcontinue\n139\t\t\t\t}\n140\t\t\t\tif listItemRE.MatchString(trimmed) {\n141\t\t\t\t\treport(line, \"is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n142\t\t\t\t\tentries = append(entries, entry{bad: true})\n143\t\t\t\t\tcontinue\n144\t\t\t\t}\n145\t\t\t}\n146\t\t\tif !under {\n147\t\t\t\treport(line, \"is neither a limit nor indented under one; the section holds only limits\")\n148\t\t\t\tcontinue\n149\t\t\t}\n150\t\t\tentries[len(entries)-1].text += \" \" + trimmed\n151\t\t}\n152\t\tfor _, e := range entries {\n153\t\t\tif e.id == \"\" {\n154\t\t\t\tcontinue\n155\t\t\t}\n156\t\t\tif seen[e.id] {\n157\t\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is declared twice\")\n158\t\t\t\tcontinue\n159\t\t\t}\n160\t\t\tseen[e.id] = true\n161\t\t\tif e.bad {\n162\t\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is not sealed: part of it could not be read\")\n163\t\t\t\tcontinue\n164\t\t\t}\n165\t\t\tif !hasAcceptedLimitReason(e.text) {\n166\t\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" does not say why it is accepted ('Accepted because ...')\")\n167\t\t\t\tcontinue\n168\t\t\t}\n169\t\t\tlimits = append(limits, ReviewAcceptedLimit{ID: e.id, Text: e.text})\n170\t\t}\n171\t\treturn limits, problems\n172\t}\n173\t\n174\tvar (\n175\t\tmarkdownHeadingRE = regexp.MustCompile(`^#{1,6}(\\s|$)`)\n176\t\tlistItemRE        = regexp.MustCompile(`^([-*+]|[0-9]+[.)])(\\s|$)`)\n177\t)\n178\t\n179\t// fenceMarker returns the run of backticks or tildes that opens or closes a\n180\t// code fence on trimmed, or \"\". A backtick run followed by more backticks on\n181\t// the line is inline code, not a fence.\n182\tfunc fenceMarker(trimmed string) string {\n183\t\tfor _, c := range []string{\"`\", \"~\"} {\n184\t\t\tn := len(trimmed) - len(strings.TrimLeft(trimmed, c))\n185\t\t\tif n < 3 {\n186\t\t\t\tcontinue\n187\t\t\t}\n188\t\t\tif c == \"`\" && strings.Contains(trimmed[n:], \"`\") {\n189\t\t\t\treturn \"\"\n190\t\t\t}\n191\t\t\treturn trimmed[:n]\n192\t\t}\n193\t\treturn \"\"\n194\t}\n195\t\n196\t// acceptedLimitsOf collects the limits the scope's specs declare.\n197\tfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n198\t\tspecs, err := s.reviewScopeSpecs(scope)\n199\t\tif err != nil {\n200\t\t\treturn nil\n201\t\t}\n202\t\treturn acceptedLimitsOfSpecs(specs)\n203\t}\n204\t\n205\t// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n206\t// by its spec when there is more than one spec.\n207\tfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n208\t\tvar out []ReviewAcceptedLimit\n209\t\tfor _, spec := range specs {\n210\t\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n211\t\t\tfor _, l := range limits {\n212\t\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n213\t\t\t\t// so a finding names exactly one sealed limit.\n214\t\t\t\tif len(specs) > 1 {\n215\t\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n216\t\t\t\t}\n217\t\t\t\tout = append(out, l)\n218\t\t\t}\n219\t\t}\n220\t\treturn out\n221\t}\n222\t\n223\t// sealedAcceptedLimit reports whether the bundle sealed limit id.\n224\tfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n225\t\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n226\t\t\tif l.ID == id {\n227\t\t\t\treturn true\n228\t\t\t}\n229\t\t}\n230\t\treturn false\n231\t}\n232\t\n233\t// htmlCommentStart returns the index in s, from from on, of the next \"<!--\"\n234\t// that opens an HTML comment, or -1. One written in inline code (an odd\n235\t// number of backticks before it on its line) opens nothing: Markdown shows\n236\t// it as text, as a spec that names the marker does (review of\n237\t// pose-review-declared-limits-followups: its own R2 named it).\n238\tfunc htmlCommentStart(s string, from int) int {\n239\t\tfor {\n240\t\t\tk := strings.Index(s[from:], \"<!--\")\n241\t\t\tif k < 0 {\n242\t\t\t\treturn -1\n243\t\t\t}\n244\t\t\tk += from\n245\t\t\tlineStart := strings.LastIndex(s[:k], \"\\n\") + 1\n246\t\t\tif strings.Count(s[lineStart:k], \"`\")%2 == 0 {\n247\t\t\t\treturn k\n248\t\t\t}\n249\t\t\tfrom = k + 4\n250\t\t}\n251\t}\n252\t\n253\t// stripLimitComments removes the HTML comments of body, as Markdown hides\n254\t// them; an unterminated one hides the rest.\n255\tfunc stripLimitComments(body string) string {\n256\t\tvar b strings.Builder\n257\t\tfrom := 0\n258\t\tfor {\n259\t\t\tstart := htmlCommentStart(body, from)\n260\t\t\tif start < 0 {\n261\t\t\t\tb.WriteString(body[from:])\n262\t\t\t\treturn b.String()\n263\t\t\t}\n264\t\t\tb.WriteString(body[from:start])\n265\t\t\tend := strings.Index(body[start+4:], \"-->\")\n266\t\t\tif end < 0 {\n267\t\t\t\treturn b.String()\n268\t\t\t}\n269\t\t\tfrom = start + 4 + end + 3\n270\t\t}\n271\t}\n272\t\n273\t// unterminatedHTMLComment reports whether any comment body opens has no\n274\t// \"-->\" after it.\n275\tfunc unterminatedHTMLComment(body string) bool {\n276\t\tfrom := 0\n277\t\tfor {\n278\t\t\tstart := htmlCommentStart(body, from)\n279\t\t\tif start < 0 {\n280\t\t\t\treturn false\n281\t\t\t}\n282\t\t\tend := strings.Index(body[start+4:], \"-->\")\n283\t\t\tif end < 0 {\n284\t\t\t\treturn true\n285\t\t\t}\n286\t\t\tfrom = start + 4 + end + 3\n287\t\t}\n288\t}\n289\t\n290\t// commentInAcceptedLimitsSection reports whether a line of the accepted\n291\t// limits section, read before comments are stripped, holds a comment marker.\n292\t// A comment outside the section, and a section heading inside one, are not\n293\t// the section.\n294\tfunc commentInAcceptedLimitsSection(body string) bool {\n295\t\tin, inComment := false, false\n296\t\tfor _, line := range strings.Split(body, \"\\n\") {\n297\t\t\tif inComment {\n298\t\t\t\tk := strings.Index(line, \"-->\")\n299\t\t\t\tif k < 0 {\n300\t\t\t\t\tcontinue\n301\t\t\t\t}\n302\t\t\t\tinComment = false\n303\t\t\t\tline = line[k+3:]\n304\t\t\t}\n305\t\t\tif in && (strings.Contains(line, \"<!--\") || strings.Contains(line, \"-->\")) {\n306\t\t\t\treturn true\n307\t\t\t}\n308\t\t\tif k := htmlCommentStart(line, 0); k >= 0 {\n309\t\t\t\tif !strings.Contains(line[k:], \"-->\") {\n310\t\t\t\t\tinComment = true\n311\t\t\t\t}\n312\t\t\t\tcontinue\n313\t\t\t}\n314\t\t\ttrimmed := strings.TrimSpace(line)\n315\t\t\tindent := len(line) - len(strings.TrimLeft(line, \" \\t\"))\n316\t\t\tif indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n317\t\t\t\theading := strings.TrimSpace(strings.Trim(trimmed, \"# \"))\n318\t\t\t\tin = strings.EqualFold(heading, \"Accepted limits\") || strings.EqualFold(heading, \"Limites aceitos\")\n319\t\t\t}\n320\t\t}\n321\t\treturn false\n322\t}\n323\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"c975089e-88b2-4f5b-8e01-d814f38506ad","timestamp":"2026-11-27T12:02:17.997Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-f7649a2054/worktree/pose-mcp/internal/pose/accepted_limits.go","content":"package pose\n\n// Accepted limits (spec pose-review-declared-threat-model): a spec declares\n// the residual limits of a guarantee it makes, each with a stable id and why\n// it is accepted. The review plan seals them; the brief lists them; a\n// reviewer classifies a finding that falls inside one as within that limit,\n// or disputes the limit as a finding of its own. A declared limit never\n// hides a defect inside the declared scope: it is visible in the bundle, the\n// brief and the attestation.\n\nimport (\n\t\"regexp\"\n\t\"strings\"\n)\n\n// ReviewAcceptedLimit is one declared residual limit.\ntype ReviewAcceptedLimit struct {\n\tID   string `json:\"id\"`\n\tText string `json:\"text\"`\n\t// Spec names the spec that declared the limit when the scope holds more\n\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n\tSpec string `json:\"spec,omitempty\"`\n}\n\nvar acceptedLimitRE = regexp.MustCompile(`^[-*+]\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n\n// acceptedLimitMarkerRE finds the marker where a sentence opens, after the\n// assumption: \"<assumption>. Accepted because <reason>.\" A marker inside a\n// sentence (\"Not accepted because\") is not one (review round 3, N1).\nvar acceptedLimitMarkerRE = regexp.MustCompile(`[.;:!?]\\s+(?:Accepted because|Aceito porque)\\s+`)\n\n// acceptedLimitReasonWordRE is a word with at least one letter.\nvar acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n\n// hasAcceptedLimitReason reads an entry as written: an assumption of at\n// least two words, then the marker opening a sentence, then a reason of at\n// least two words in that same sentence. A marker alone, punctuation, a\n// missing assumption or a reason borrowed from a later sentence does not say\n// why a limit is accepted (review rounds 1–4).\nfunc hasAcceptedLimitReason(text string) bool {\n\tloc := acceptedLimitMarkerRE.FindStringIndex(text)\n\tif loc == nil {\n\t\treturn false\n\t}\n\tassumption, rest := text[:loc[0]], text[loc[1]:]\n\tif end := strings.IndexAny(rest, \".;!?\"); end >= 0 {\n\t\trest = rest[:end]\n\t}\n\treturn len(acceptedLimitReasonWordRE.FindAllString(assumption, -1)) >= 2 && len(acceptedLimitReasonWordRE.FindAllString(rest, -1)) >= 2\n}\n\n// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n// It returns the limits and the problems that keep the section from being\n// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n// limit that does not say why it is accepted (\"Accepted because ...\" or\n// \"Aceito porque ...\").\nfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n\tvar limits []ReviewAcceptedLimit\n\tvar problems []string\n\tin := false\n\tseen := map[string]bool{}\n\t// The section is read fail-closed (review rounds 8 to 10): it holds only\n\t// limits, each one list item whose wrapped lines are indented deeper than\n\t// its marker (also after a blank line). Any other line in the section\n\t// (prose, a lazy unindented continuation, a nested list, a fence, another\n\t// kind of item) is reported, and the limit it belongs to or follows is\n\t// not sealed: the engine never seals a limit it may have read in part.\n\t// Fenced blocks and HTML comments outside the section are not the spec's\n\t// declarations, so examples there are never read.\n\ttype entry struct {\n\t\tid, text string\n\t\tindent   int\n\t\tbad      bool\n\t}\n\tvar entries []entry\n\treport := func(line, why string) {\n\t\tproblems = append(problems, \"accepted limits: \"+quoteLedgerText(strings.TrimSpace(line))+\" \"+why)\n\t\tif len(entries) > 0 && !entries[len(entries)-1].bad {\n\t\t\tentries[len(entries)-1].bad = true\n\t\t}\n\t}\n\t// Any unterminated comment, not only the first, hides what follows it\n\t// (spec pose-review-declared-limits-followups R2).\n\tif unterminatedHTMLComment(body) {\n\t\tproblems = append(problems, \"accepted limits: an unterminated HTML comment hides the rest of the spec\")\n\t}\n\t// A comment inside the section, also one written in inline code, would\n\t// change a limit's sealed text: the section is refused whole instead of\n\t// guessing which is meant (R2, D1).\n\tif commentInAcceptedLimitsSection(body) {\n\t\tproblems = append(problems, \"accepted limits: the section holds an HTML comment marker; write the limits without comments\")\n\t\treturn nil, problems\n\t}\n\ttext := stripLimitComments(body)\n\tfence := \"\"\n\tfor _, line := range strings.Split(text, \"\\n\") {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tindent := len(line) - len(strings.TrimLeft(line, \" \\t\"))\n\t\tif marker := fenceMarker(trimmed); marker != \"\" {\n\t\t\tif in {\n\t\t\t\treport(line, \"is a code fence; examples belong outside the section\")\n\t\t\t}\n\t\t\tswitch {\n\t\t\tcase fence == \"\":\n\t\t\t\tfence = marker\n\t\t\tcase marker[0] == fence[0] && len(marker) >= len(fence) && strings.TrimLeft(trimmed, marker[:1]) == \"\":\n\t\t\t\tfence = \"\"\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif fence != \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif in && indent > 0 && len(entries) > 0 && indent > entries[len(entries)-1].indent && indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n\t\t\t// A heading-like line indented under a limit: read as a heading it\n\t\t\t// would end the section and cut the limit (R1).\n\t\t\treport(line, \"is a heading inside a limit; write the limit as one item\")\n\t\t\tcontinue\n\t\t}\n\t\tif indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n\t\t\theading := strings.TrimSpace(strings.Trim(trimmed, \"# \"))\n\t\t\tin = strings.EqualFold(heading, \"Accepted limits\") || strings.EqualFold(heading, \"Limites aceitos\")\n\t\t\tcontinue\n\t\t}\n\t\tif !in || trimmed == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\t// A line indented under the current limit belongs to it: a list\n\t\t// there is nested, anything else continues the limit.\n\t\tunder := len(entries) > 0 && indent > entries[len(entries)-1].indent\n\t\tif under && listItemRE.MatchString(trimmed) {\n\t\t\treport(line, \"is a nested list; write the limit as one item\")\n\t\t\tcontinue\n\t\t}\n\t\tif !under && indent <= 3 {\n\t\t\tif m := acceptedLimitRE.FindStringSubmatch(trimmed); m != nil {\n\t\t\t\tentries = append(entries, entry{id: m[1], text: strings.TrimSpace(m[2]), indent: indent})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif listItemRE.MatchString(trimmed) {\n\t\t\t\treport(line, \"is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n\t\t\t\tentries = append(entries, entry{bad: true})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif !under {\n\t\t\treport(line, \"is neither a limit nor indented under one; the section holds only limits\")\n\t\t\tcontinue\n\t\t}\n\t\tentries[len(entries)-1].text += \" \" + trimmed\n\t}\n\tfor _, e := range entries {\n\t\tif e.id == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif seen[e.id] {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is declared twice\")\n\t\t\tcontinue\n\t\t}\n\t\tseen[e.id] = true\n\t\tif e.bad {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is not sealed: part of it could not be read\")\n\t\t\tcontinue\n\t\t}\n\t\tif !hasAcceptedLimitReason(e.text) {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" does not say why it is accepted ('Accepted because ...')\")\n\t\t\tcontinue\n\t\t}\n\t\tlimits = append(limits, ReviewAcceptedLimit{ID: e.id, Text: e.text})\n\t}\n\treturn limits, problems\n}\n\nvar (\n\tmarkdownHeadingRE = regexp.MustCompile(`^#{1,6}(\\s|$)`)\n\tlistItemRE        = regexp.MustCompile(`^([-*+]|[0-9]+[.)])(\\s|$)`)\n)\n\n// fenceMarker returns the run of backticks or tildes that opens or closes a\n// code fence on trimmed, or \"\". A backtick run followed by more backticks on\n// the line is inline code, not a fence.\nfunc fenceMarker(trimmed string) string {\n\tfor _, c := range []string{\"`\", \"~\"} {\n\t\tn := len(trimmed) - len(strings.TrimLeft(trimmed, c))\n\t\tif n < 3 {\n\t\t\tcontinue\n\t\t}\n\t\tif c == \"`\" && strings.Contains(trimmed[n:], \"`\") {\n\t\t\treturn \"\"\n\t\t}\n\t\treturn trimmed[:n]\n\t}\n\treturn \"\"\n}\n\n// acceptedLimitsOf collects the limits the scope's specs declare.\nfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n\tspecs, err := s.reviewScopeSpecs(scope)\n\tif err != nil {\n\t\treturn nil\n\t}\n\treturn acceptedLimitsOfSpecs(specs)\n}\n\n// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n// by its spec when there is more than one spec.\nfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n\tvar out []ReviewAcceptedLimit\n\tfor _, spec := range specs {\n\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n\t\tfor _, l := range limits {\n\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n\t\t\t// so a finding names exactly one sealed limit.\n\t\t\tif len(specs) > 1 {\n\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n\t\t\t}\n\t\t\tout = append(out, l)\n\t\t}\n\t}\n\treturn out\n}\n\n// sealedAcceptedLimit reports whether the bundle sealed limit id.\nfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n\t\tif l.ID == id {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// htmlCommentStart returns the index in s, from from on, of the next \"<!--\"\n// that opens an HTML comment, or -1. One written in inline code (an odd\n// number of backticks before it on its line) opens nothing: Markdown shows\n// it as text, as a spec that names the marker does (review of\n// pose-review-declared-limits-followups: its own R2 named it).\nfunc htmlCommentStart(s string, from int) int {\n\tfor {\n\t\tk := strings.Index(s[from:], \"<!--\")\n\t\tif k < 0 {\n\t\t\treturn -1\n\t\t}\n\t\tk += from\n\t\tlineStart := strings.LastIndex(s[:k], \"\\n\") + 1\n\t\tif strings.Count(s[lineStart:k], \"`\")%2 == 0 {\n\t\t\treturn k\n\t\t}\n\t\tfrom = k + 4\n\t}\n}\n\n// stripLimitComments removes the HTML comments of body, as Markdown hides\n// them; an unterminated one hides the rest.\nfunc stripLimitComments(body string) string {\n\tvar b strings.Builder\n\tfrom := 0\n\tfor {\n\t\tstart := htmlCommentStart(body, from)\n\t\tif start < 0 {\n\t\t\tb.WriteString(body[from:])\n\t\t\treturn b.String()\n\t\t}\n\t\tb.WriteString(body[from:start])\n\t\tend := strings.Index(body[start+4:], \"-->\")\n\t\tif end < 0 {\n\t\t\treturn b.String()\n\t\t}\n\t\tfrom = start + 4 + end + 3\n\t}\n}\n\n// unterminatedHTMLComment reports whether any comment body opens has no\n// \"-->\" after it.\nfunc unterminatedHTMLComment(body string) bool {\n\tfrom := 0\n\tfor {\n\t\tstart := htmlCommentStart(body, from)\n\t\tif start < 0 {\n\t\t\treturn false\n\t\t}\n\t\tend := strings.Index(body[start+4:], \"-->\")\n\t\tif end < 0 {\n\t\t\treturn true\n\t\t}\n\t\tfrom = start + 4 + end + 3\n\t}\n}\n\n// commentInAcceptedLimitsSection reports whether a line of the accepted\n// limits section, read before comments are stripped, holds a comment marker.\n// A comment outside the section, and a section heading inside one, are not\n// the section.\nfunc commentInAcceptedLimitsSection(body string) bool {\n\tin, inComment := false, false\n\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\tif inComment {\n\t\t\tk := strings.Index(line, \"-->\")\n\t\t\tif k < 0 {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tinComment = false\n\t\t\tline = line[k+3:]\n\t\t}\n\t\tif in && (strings.Contains(line, \"<!--\") || strings.Contains(line, \"-->\")) {\n\t\t\treturn true\n\t\t}\n\t\tif k := htmlCommentStart(line, 0); k >= 0 {\n\t\t\tif !strings.Contains(line[k:], \"-->\") {\n\t\t\t\tinComment = true\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tindent := len(line) - len(strings.TrimLeft(line, \" \\t\"))\n\t\tif indent <= 3 && markdownHeadingRE.MatchString(trimmed) {\n\t\t\theading := strings.TrimSpace(strings.Trim(trimmed, \"# \"))\n\t\t\tin = strings.EqualFold(heading, \"Accepted limits\") || strings.EqualFold(heading, \"Limites aceitos\")\n\t\t}\n\t}\n\treturn false\n}\n","numLines":323,"startLine":1,"totalLines":323}},"tool_result_meta":[{"id":"toolu_01BQo6HXWsCg6Z4EYMmxvMt6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
