\t\t}\n276\t\t\tout = append(out, c)\n277\t\t}\n278\t\treturn out\n279\t}\n280\t\n281\t// concludingTools are the dispositions of tools that state a conclusion:\n282\t// a post-review gate deferred and a recommended tool not used state none,\n283\t// whatever their rationale says, so a writer that fills them is not\n284\t// answering for the reviewer.\n285\tfunc concludingTools(plan []ReviewPlanTool, tools []ReviewToolDisposition) []ReviewToolDisposition {\n286\t\tplanned := map[string]ReviewPlanTool{}\n287\t\tfor _, tool := range plan {\n288\t\t\tplanned[tool.ID+\"\\x00\"+tool.Component] = tool\n289\t\t}\n290\t\tout := []ReviewToolDisposition{}\n291\t\tfor _, t := range tools {\n292\t\t\ttool, ok := planned[t.ID+\"\\x00\"+t.Component]\n293\t\t\tif ok && t.Evidence == \"\" && (t.Disposition == \"deferred\" && containsString(tool.Preconditions, \"review-complete\") || t.Disposition == \"not-used\" && tool.Requiredness == \"recommended\") {\n294\t\t\t\tcontinue\n295\t\t\t}\n296\t\t\tout = append(out, t)\n297\t\t}\n298\t\treturn out\n299\t}\n300\t\n301\t// differingItems names the items of got and want, keyed by id and\n302\t// component, that one has and the other lacks or states differently.\n303\tfunc differingItems[T any](kind string, got, want []T) []string {\n304\t\tindex := func(items []T) (map[string]string, []string) {\n305\t\t\tout, keys := map[string]string{}, []string{}\n306\t\t\tfor _, v := range items {\n307\t\t\t\traw, _ := json.Marshal(v)\n308\t\t\t\tvar m struct {\n309\t\t\t\t\tID        string `json:\"id\"`\n310\t\t\t\t\tComponent string `json:\"component\"`\n311\t\t\t\t}\n312\t\t\t\t_ = json.Unmarshal(raw, &m)\n313\t\t\t\tkey := m.ID\n314\t\t\t\tif m.Component != \"\" {\n315\t\t\t\t\tkey += \" (component \" + m.Component + \")\"\n316\t\t\t\t}\n317\t\t\t\tif _, seen := out[key]; !seen {\n318\t\t\t\t\tkeys = append(keys, key)\n319\t\t\t\t}\n320\t\t\t\tout[key] += string(raw)\n321\t\t\t}\n322\t\t\treturn out, keys\n323\t\t}\n324\t\tg, gk := index(got)\n325\t\tw, wk := index(want)\n326\t\tvar differ []string\n327\t\tfor _, k := range gk {\n328\t\t\tswitch wv, ok := w[k]; {\n329\t\t\tcase !ok:\n330\t\t\t\tdiffer = append(differ, kind+\" \"+k+\" is not in the draft\")\n331\t\t\tcase wv != g[k]:\n332\t\t\t\tdiffer = append(differ, kind+\" \"+k+\" differs from the draft's\")\n333\t\t\t}\n334\t\t}\n335\t\tfor _, k := range wk {\n336\t\t\tif _, ok := g[k]; !ok {\n337\t\t\t\tdiffer = append(differ, kind+\" \"+k+\" of the draft is missing\")\n338\t\t\t}\n339\t\t}\n340\t\treturn differ\n341\t}\n342\t\n343\t// reviewConclusionLockWait bounds how long a conclusion waits for another\n344\t// conclusion of the same run to finish.\n345\tconst reviewConclusionLockWait = 2 * time.Minute\n346\t\n347\t// lockPrivateName holds an exclusive lock on name in a private directory,\n348\t// waiting while another process holds it.\n349\tfunc (s Store) lockPrivateName(dir, name string) (func(), error) {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"f6d34923-36fa-4045-bece-8631723af087","timestamp":"2026-11-27T12:04:34.736Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-f7649a2054/worktree/pose-mcp/internal/pose/review_conclusions.go","content":"func runConclusionDiffers(run ReviewRun, bundle ReviewBundle, att ReviewAttestation) string {\n\tif run.Provenance == nil || !reviewBriefAsksConclusion(run.Provenance.TemplateVersion) {\n\t\treturn \"\"\n\t}\n\tdraft, err := ParseReviewDraft(run.Output)\n\tif err != nil {\n\t\treturn \"the run's draft cannot be read: \" + err.Error()\n\t}\n\tif draft == nil {\n\t\tdraft = &ReviewDraft{Decision: att.Decision}\n\t}\n\twant := reviewAttestationFromDraft(run, bundle, *draft, att.Reviewer)\n\tvar differ []string\n\tdiffer = append(differ, differingItems(\"criterion\", mappingsByDelta(att.Criteria), mappingsByDelta(want.Criteria))...)\n\tdiffer = append(differ, differingItems(\"tool\", concludingTools(bundle.Payload.Plan.Tools, att.Tools)