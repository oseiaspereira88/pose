{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HZVUioX33TwDjNqxYbnxZo","type":"tool_result","content":"4020\t\t// about applies to the change it approves.\n4021\t\t//\n4022\t\t// Bounded to a scope that carries a delivery target, because the other case\n4023\t\t// is already modelled and already honest: a documentation-only spec collects\n4024\t\t// no validation evidence by design, and recording every criterion\n4025\t\t// not-applicable — naming what is missing — is the answer the engine itself\n4026\t\t// prepares for it. Refusing that would break the distinction this contract\n4027\t\t// depends on rather than reinforce it.\n4028\t\tif judgmentGoverned && hasDeliveryTarget && len(required) > 0 && notApplicable == len(required) && len(att.Criteria) == len(required) {\n4029\t\t\tblockers = append(blockers, \"every required criterion is not-applicable; a scope where the whole plan is inapplicable is not reviewed by it\")\n4030\t\t}\n4031\t\treuseBlockers, _ := s.evaluateReviewReuse(bundle, att, bundle.Payload.SealedGates().AllowCriterionReuse)\n4032\t\tblockers = append(blockers, reuseBlockers...)\n4033\t\tsealedEvidence := map[string]ReviewBundleEvidence{}\n4034\t\tfor _, ev := range bundle.Payload.Evidence {\n4035\t\t\tsealedEvidence[ev.EvidenceClass+\":\"+ev.ID] = ev\n4036\t\t}\n4037\t\tif skipEvidenceSupport {\n4038\t\t\tsealedEvidence = nil\n4039\t\t}\n4040\t\ttoolWarnings, toolBlockers := evaluateReviewToolCoverageIn(s.fsys(), s.Root, bundle.Payload.Plan.Tools, att.Tools, sealedEvidence, hasDeliveryTarget)\n4041\t\t_ = toolWarnings\n4042\t\tblockers = append(blockers, toolBlockers...)\n4043\t\tblockers = append(blockers, reviewFindingDecisionBlockers(bundle, att)...)\n4044\t\treturn blockers\n4045\t}\n4046\t\n4047\t// The same finding and decision gate protects fresh and reused approvals.\n4048\tfunc reviewFindingDecisionBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n4049\t\tblockers := []string{}\n4050\t\t// The finding contract, which this path did not have. It accepted a\n4051\t\t// `critical` risk with no owner, no rationale and no review date; a\n4052\t\t// disposition the engine does not know; and a finding with neither severity\n4053\t\t// nor action — all three with no blocker at all, while the legacy attempt\n4054\t\t// path refused every one of them. A project that adopted review bundles\n4055\t\t// silently lost the gate (spec\n4056\t\t// pose-bundle-findings-take-the-contract-the-legacy-path-had).\n4057\t\t//\n4058\t\t// Only the accepted-risk severities and the reservations flag come from the\n4059\t\t// sealed gates. The rest is not configuration: a finding without a severity\n4060\t\t// is incomplete under any policy.\n4061\t\tallowedRisk := map[string]bool{}\n4062\t\tfor _, severity := range bundle.Payload.SealedGates().AcceptedRiskSeverities {\n4063\t\t\tallowedRisk[severity] = true\n4064\t\t}\n4065\t\tseenFindings := map[string]bool{}\n4066\t\tfor _, finding := range att.Findings {\n4067\t\t\tif seenFindings[finding.ID] {\n4068\t\t\t\tblockers = append(blockers, \"duplicate finding \"+finding.ID)\n4069\t\t\t}\n4070\t\t\tseenFindings[finding.ID] = true\n4071\t\t\tif finding.Severity == \"\" || finding.Action == \"\" {\n4072\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" lacks severity or action\")\n4073\t\t\t}\n4074\t\t\tswitch finding.Disposition {\n4075\t\t\tcase \"resolved\":\n4076\t\t\tcase \"accepted-risk\", \"wont-fix\":\n4077\t\t\t\t// Leaving a finding unresolved accepts its risk regardless of the\n4078\t\t\t\t// disposition's spelling. Use the policy frozen into this bundle.\n4079\t\t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n4080\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n4081\t\t\t\t}\n4082\t\t\tcase \"within-limit\":\n4083\t\t\t\t// Inside a limit the spec declared and the bundle sealed, whatever\n4084\t\t\t\t// its severity; a limit the bundle did not seal accepts nothing\n4085\t\t\t\t// (spec pose-review-declared-threat-model R3).\n4086\t\t\t\tif !sealedAcceptedLimit(bundle, finding.Limit) {\n4087\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" names accepted limit \"+firstNonempty(finding.Limit, \"(none)\")+\", which this bundle did not seal\")\n4088\t\t\t\t} else if strings.TrimSpace(finding.Rationale) == \"\" {\n4089\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is within limit \"+finding.Limit+\" without saying why\")\n4090\t\t\t\t}\n4091\t\t\tcase \"open\", \"changes-requested\":\n4092\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n4093\t\t\tdefault:\n4094\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has invalid disposition\")\n4095\t\t\t}\n4096\t\t}\n4097\t\tif att.Decision != \"approved\" && !(att.Decision == \"approved-with-reservations\" && bundle.Payload.SealedGates().AllowApprovedWithReservations) {\n4098\t\t\tblockers = append(blockers, \"review decision does not permit closeout: \"+att.Decision)\n4099\t\t}\n4100\t\treturn blockers\n4101\t}\n4102\t\n4103\tfunc (s Store) verifyStoredReviewAttestationSignature(att ReviewAttestation) error {\n4104\t\tif att.Envelope == nil {\n4105\t\t\t// Recorded before signing was required, and sealed unchanged into a\n4106\t\t\t// trusted legacy ledger (spec pose-signed-legacy-attestation-ledger).\n4107\t\t\tif s.legacyLedgerCovers(att) {\n4108\t\t\t\treturn nil\n4109\t\t\t}\n4110\t\t\tif coverage := s.LegacyLedgerCoverage(); !coverage.Complete() {\n4111\t\t\t\t// Not trusted, and not for want of a ledger: one could not be used.\n4112\t\t\t\treturn fmt.Errorf(\"signed attestation proof is required by review policy; a legacy ledger that may cover it could not be used: %s\", coverage.Describe(\"\"))\n4113\t\t\t}\n4114\t\t\treturn fmt.Errorf(\"signed attestation proof is required by review policy\")\n4115\t\t}\n4116\t\tproof := *att.Envelope\n4117\t\tunsigned := att\n4118\t\tunsigned.Path = \"\"\n4119\t\tunsigned.Envelope = nil"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"1c3f2983-1cdc-4227-b416-f6c669e55771","timestamp":"2026-11-27T12:02:23.353Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-f7649a2054/worktree/pose-mcp/internal/pose/review_bundle.go","content":"\t// about applies to the change it approves.\n\t//\n\t// Bounded to a scope that carries a delivery target, because the other case\n\t// is already modelled and already honest: a documentation-only spec collects\n\t// no validation evidence by design, and recording every criterion\n\t// not-applicable — naming what is missing — is the answer the engine itself\n\t// prepares for it. Refusing that would break the distinction this contract\n\t// depends on rather than reinforce it.\n\tif judgmentGoverned && hasDeliveryTarget && len(required) > 0 && notApplicable == len(required) && len(att.Criteria) == len(required) {\n\t\tblockers = append(blockers, \"every required criterion is not-applicable; a scope where the whole plan is inapplicable is not reviewed by it\")\n\t}\n\treuseBlockers, _ := s.evaluateReviewReuse(bundle, att, bundle.Payload.SealedGates().AllowCriterionReuse)\n\tblockers = append(blockers, reuseBlockers...)\n\tsealedEvidence := map[string]ReviewBundleEvidence{}\n\tfor _, ev := range bundle.Payload.Evidence {\n\t\tsealedEvidence[ev.EvidenceClass+\":\"+ev.ID] = ev\n\t}\n\tif skipEvidenceSupport {\n\t\tsealedEvidence = nil\n\t}\n\ttoolWarnings, toolBlockers := evaluateReviewToolCoverageIn(s.fsys(), s.Root, bundle.Payload.Plan.Tools, att.Tools, sealedEvidence, hasDeliveryTarget)\n\t_ = toolWarnings\n\tblockers = append(blockers, toolBlockers...)\n\tblockers = append(blockers, reviewFindingDecisionBlockers(bundle, att)...)\n\treturn blockers\n}\n\n// The same finding and decision gate protects fresh and reused approvals.\nfunc reviewFindingDecisionBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n\tblockers := []string{}\n\t// The finding contract, which this path did not have. It accepted a\n\t// `critical` risk with no owner, no rationale and no review date; a\n\t// disposition the engine does not know; and a finding with neither severity\n\t// nor action — all three with no blocker at all, while the legacy attempt\n\t// path refused every one of them. A project that adopted review bundles\n\t// silently lost the gate (spec\n\t// pose-bundle-findings-take-the-contract-the-legacy-path-had).\n\t//\n\t// Only the accepted-risk severities and the reservations flag come from the\n\t// sealed gates. The rest is not configuration: a finding without a severity\n\t// is incomplete under any policy.\n\tallowedRisk := map[string]bool{}\n\tfor _, severity := range bundle.Payload.SealedGates().AcceptedRiskSeverities {\n\t\tallowedRisk[severity] = true\n\t}\n\tseenFindings := map[string]bool{}\n\tfor _, finding := range att.Findings {\n\t\tif seenFindings[finding.ID] {\n\t\t\tblockers = append(blockers, \"duplicate finding \"+finding.ID)\n\t\t}\n\t\tseenFindings[finding.ID] = true\n\t\tif finding.Severity == \"\" || finding.Action == \"\" {\n\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" lacks severity or action\")\n\t\t}\n\t\tswitch finding.Disposition {\n\t\tcase \"resolved\":\n\t\tcase \"accepted-risk\", \"wont-fix\":\n\t\t\t// Leaving a finding unresolved accepts its risk regardless of the\n\t\t\t// disposition's spelling. Use the policy frozen into this bundle.\n\t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n\t\t\t}\n\t\tcase \"within-limit\":\n\t\t\t// Inside a limit the spec declared and the bundle sealed, whatever\n\t\t\t// its severity; a limit the bundle did not seal accepts nothing\n\t\t\t// (spec pose-review-declared-threat-model R3).\n\t\t\tif !sealedAcceptedLimit(bundle, finding.Limit) {\n\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" names accepted limit \"+firstNonempty(finding.Limit, \"(none)\")+\", which this bundle did not seal\")\n\t\t\t} else if strings.TrimSpace(finding.Rationale) == \"\" {\n\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is within limit \"+finding.Limit+\" without saying why\")\n\t\t\t}\n\t\tcase \"open\", \"changes-requested\":\n\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n\t\tdefault:\n\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has invalid disposition\")\n\t\t}\n\t}\n\tif att.Decision != \"approved\" && !(att.Decision == \"approved-with-reservations\" && bundle.Payload.SealedGates().AllowApprovedWithReservations) {\n\t\tblockers = append(blockers, \"review decision does not permit closeout: \"+att.Decision)\n\t}\n\treturn blockers\n}\n\nfunc (s Store) verifyStoredReviewAttestationSignature(att ReviewAttestation) error {\n\tif att.Envelope == nil {\n\t\t// Recorded before signing was required, and sealed unchanged into a\n\t\t// trusted legacy ledger (spec pose-signed-legacy-attestation-ledger).\n\t\tif s.legacyLedgerCovers(att) {\n\t\t\treturn nil\n\t\t}\n\t\tif coverage := s.LegacyLedgerCoverage(); !coverage.Complete() {\n\t\t\t// Not trusted, and not for want of a ledger: one could not be used.\n\t\t\treturn fmt.Errorf(\"signed attestation proof is required by review policy; a legacy ledger that may cover it could not be used: %s\", coverage.Describe(\"\"))\n\t\t}\n\t\treturn fmt.Errorf(\"signed attestation proof is required by review policy\")\n\t}\n\tproof := *att.Envelope\n\tunsigned := att\n\tunsigned.Path = \"\"\n\tunsigned.Envelope = nil","numLines":100,"startLine":4020,"totalLines":4951}},"tool_result_meta":[{"id":"toolu_01HZVUioX33TwDjNqxYbnxZo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
