{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014o76gYRizQUxoe2osaQFYQ","type":"tool_result","content":"60\t}\n61\t\n62\t// ReadReviewConclusion is the conclusion record of run, if any.\n63\tfunc (s Store) ReadReviewConclusion(runID string) (*ReviewConclusion, error) {\n64\t\tif !validAttemptFileName(runID) {\n65\t\t\treturn nil, fmt.Errorf(\"pose: %q is not a run id\", runID)\n66\t\t}\n67\t\tc, _, err := s.readReviewConclusionRaw(runID)\n68\t\treturn c, err\n69\t}\n70\t\n71\t// readReviewConclusionRaw is the conclusion record of run and the bytes it\n72\t// was parsed from: one read, so what is judged is what a write expects\n73\t// (review round 2, B4).\n74\tfunc (s Store) readReviewConclusionRaw(runID string) (*ReviewConclusion, []byte, error) {\n75\t\traw, err := readBoundedRegular(reviewConclusionPath(s.Root, runID), 1<<20)\n76\t\tif errors.Is(err, os.ErrNotExist) {\n77\t\t\treturn nil, nil, nil\n78\t\t}\n79\t\tif err != nil {\n80\t\t\treturn nil, nil, err\n81\t\t}\n82\t\tvar c ReviewConclusion\n83\t\tif err := json.Unmarshal(raw, &c); err != nil || c.RunID != runID {\n84\t\t\treturn nil, nil, fmt.Errorf(\"pose: the conclusion record of %s cannot be read\", runID)\n85\t\t}\n86\t\treturn &c, raw, nil\n87\t}\n88\t\n89\t// reviewConclusionChecks are the conditions a run must meet before its\n90\t// conclusion is recorded, each a reason when it does not (R1, R3, R4).\n91\tfunc (s Store) reviewConclusionChecks(run ReviewRun) ([]string, *ReviewBundle, *ReviewDraft) {\n92\t\tvar reasons []string\n93\t\tif run.Kind != ReviewBriefKindReview && run.Kind != ReviewBriefKindAdjudication && run.Kind != ReviewBriefKindSmoke || run.Purpose != \"\" && run.Purpose != DelegationPurposeForKind(run.Kind) {\n94\t\t\treasons = append(reasons, \"the run is not a review, an adjudication or a smoke run\")\n95\t\t}\n96\t\tif run.Status != ReviewRunCompleted {\n97\t\t\treasons = append(reasons, \"the run did not complete: it is \"+run.Status)\n98\t\t}\n99\t\tif run.SupersededBy != \"\" {\n100\t\t\treasons = append(reasons, \"the run is superseded by \"+run.SupersededBy)\n101\t\t}\n102\t\tif run.Provenance == nil {\n103\t\t\treasons = append(reasons, \"the run captured no provenance, so it cannot be signed\")\n104\t\t}\n105\t\tif run.Safety == nil || run.Safety.Operation.Outcome != OutcomeCompleted {\n106\t\t\treasons = append(reasons, \"the run's cleanup is not confirmed complete\")\n107\t\t}\n108\t\tif why := s.reviewRunTranscriptIntact(run); why != \"\" {\n109\t\t\treasons = append(reasons, \"the run's record is not intact: \"+why)\n110\t\t}\n111\t\tdraft, err := ParseReviewDraft(run.Output)\n112\t\tswitch {\n113\t\tcase err != nil:\n114\t\t\treasons = append(reasons, \"the conclusion cannot be read: \"+err.Error())\n115\t\tcase draft == nil:\n116\t\t\treasons = append(reasons, \"the run's final message carries no pose-draft block\")\n117\t\t}\n118\t\tif len(run.DraftProblems) > 0 {\n119\t\t\treasons = append(reasons, \"the draft does not account for its round: \"+strings.Join(run.DraftProblems, \"; \"))\n120\t\t}\n121\t\tbundle, err := s.LoadReviewBundle(run.BundleID)\n122\t\tif err != nil {\n123\t\t\treturn append(reasons, \"the run's bundle cannot be read: \"+err.Error()), nil, draft\n124\t\t}\n125\t\t// The run's own record must stand whatever it concludes. Whether its\n126\t\t// bundle is still the current subject matters only to an approval: a\n127\t\t// verdict that requests changes or rejects is a fact about the bundle it\n128\t\t// reviewed, and the working tree the implementer is already fixing does\n129\t\t// not change it (spec pose-review-conclude-ignores-unrelated-local-edits R1).\n130\t\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n131\t\t\treasons = append(reasons, \"the run no longer governs: \"+why)\n132\t\t}\n133\t\treasons = append(reasons, s.verdictCoverageReasons(run, bundle, draft)...)\n134\t\treturn reasons, &bundle, draft\n135\t}\n136\t\n137\t// reviewConclusionCurrency is why an approval of run's bundle would no longer\n138\t// approve the current subject.\n139\tfunc (s Store) reviewConclusionCurrency(run ReviewRun, bundle ReviewBundle) []string {\n140\t\tvar reasons []string\n141\t\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n142\t\tif err != nil || current == nil || current.BundleID != bundle.BundleID {\n143\t\t\treasons = append(reasons, \"the run's bundle no longer governs \"+bundle.Payload.Scope.Ref+\": the subject, the plan or the policy changed since it was sealed\")\n144\t\t}\n145\t\tif why := s.ReviewRunStillGoverns(run); why != \"\" {\n146\t\t\treasons = append(reasons, \"the run no longer governs: \"+why)\n147\t\t}\n148\t\treturn reasons\n149\t}\n150\t\n151\t// reviewAttestationFromDraft builds the attestation a draft concludes, for\n152\t// the run that wrote it. Evidence is the run itself and each evidence the\n153\t// draft names; a criterion or a tool the draft does not answer is left for\n154\t// the preflight to refuse, never answered for it.\n155\tfunc reviewAttestationFromDraft(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, reviewer string) ReviewAttestation {\n156\t\tatt := ReviewAttestation{BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest, Reviewer: reviewer, Decision: draft.Decision}\n157\t\tevidence := map[string]bool{\"delegated-run:\" + run.RunID: true}\n158\t\tfor _, c := range draft.Criteria {\n159\t\t\tatt.Criteria = append(att.Criteria, ReviewCriterion{ID: c.ID, Disposition: c.Disposition, Evidence: c.Evidence, Rationale: c.Rationale, Mappings: c.Mappings})\n160\t\t\tif c.Evidence != \"\" {\n161\t\t\t\tevidence[c.Evidence] = true\n162\t\t\t}\n163\t\t}\n164\t\tvar tools []ReviewToolDisposition\n165\t\tfor _, t := range draft.Tools {\n166\t\t\ttools = append(tools, ReviewToolDisposition{ID: t.ID, Component: t.Component, Disposition: t.Disposition, Evidence: t.Evidence, Rationale: t.Rationale})\n167\t\t}\n168\t\tatt.Tools = ReviewToolDefaults(bundle.Payload.Plan.Tools, tools)\n169\t\tfor _, f := range draft.Findings {\n170\t\t\tfinding := ReviewFinding{ID: f.ID, Severity: f.Severity, Evidence: findingEvidence(f), Action: f.Action, Disposition: \"open\"}\n171\t\t\tif f.Action == \"\" {\n172\t\t\t\tfinding.Action = f.Summary\n173\t\t\t}\n174\t\t\t// A follow-up the reviewer gave an action, an owner and a review date\n175\t\t\t// is a risk the reviewer accepted; anything else stays open and blocks\n176\t\t\t// an approval. The engine never writes the action for the reviewer\n177\t\t\t// (review round 1, B3).\n178\t\t\tif f.Disposition == \"follow-up\" && f.Action != \"\" && f.Owner != \"\" && f.ReviewBy != \"\" {\n179\t\t\t\tfinding.Disposition, finding.Owner, finding.ReviewBy, finding.Rationale = \"accepted-risk\", f.Owner, f.ReviewBy, f.Summary\n180\t\t\t}\n181\t\t\t// A follow-up the reviewer classified inside a declared accepted\n182\t\t\t// limit is recorded as such, naming the limit (spec\n183\t\t\t// pose-review-declared-threat-model R3).\n184\t\t\t// Only a limit the bundle sealed: a draft of any decision naming\n185\t\t\t// another is recorded as the follow-up it otherwise is, so no\n186\t\t\t// attestation names a limit that does not exist (spec\n187\t\t\t// pose-review-declared-limits-followups R4).\n188\t\t\tif f.Disposition == \"follow-up\" && f.Limit != \"\" && sealedAcceptedLimit(bundle, f.Limit) {\n189\t\t\t\tfinding.Disposition, finding.Limit, finding.Rationale, finding.Owner, finding.ReviewBy = \"within-limit\", f.Limit, f.Summary, f.Owner, f.ReviewBy\n190\t\t\t}\n191\t\t\tatt.Findings = append(att.Findings, finding)\n192\t\t}\n193\t\tfor ref := range evidence {\n194\t\t\tatt.EvidenceRefs = append(att.EvidenceRefs, ref)\n195\t\t}\n196\t\tsort.Strings(att.EvidenceRefs)\n197\t\tatt.Run = &ReviewRunReference{RunID: run.RunID}\n198\t\treturn att\n199\t}\n200\t\n201\t// ReviewToolDefaults is given followed by the dispositions that state no\n202\t// conclusion, for the plan's tools given leaves out: a post-review gate\n203\t// deferred, a recommended tool not used. A required tool left out stays out,\n204\t// for the domain writer to name. `review attest` and a run's conclusion fill\n205\t// the same defaults, so a run's conclusion and its attestation agree on them.\n206\tfunc ReviewToolDefaults(plan []ReviewPlanTool, given []ReviewToolDisposition) []ReviewToolDisposition {\n207\t\tout := append([]ReviewToolDisposition{}, given...)\n208\t\tprovided := map[string]bool{}\n209\t\tfor _, t := range given {\n210\t\t\tprovided[t.ID+\"\\x00\"+t.Component] = true\n211\t\t}\n212\t\tfor _, tool := range plan {\n213\t\t\tif provided[tool.ID+\"\\x00\"+tool.Component] {\n214\t\t\t\tcontinue\n215\t\t\t}\n216\t\t\tif containsString(tool.Preconditions, \"review-complete\") {\n217\t\t\t\tout = append(out, ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"deferred\", Rationale: \"post-review gate\"})\n218\t\t\t} else if tool.Requiredness == \"recommended\" {\n219\t\t\t\tout = append(out, ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"not-used\", Rationale: \"not used during review\"})\n220\t\t\t}\n221\t\t}\n222\t\treturn out\n223\t}\n224\t\n225\tfunc findingEvidence(f ReviewDraftFinding) string {\n226\t\tif f.File == \"\" {\n227\t\t\treturn \"\"\n228\t\t}\n229\t\tif f.Line > 0 {\n230\t\t\treturn fmt.Sprintf(\"file:%s:%d\", f.File, f.Line)\n231\t\t}\n232\t\treturn \"file:\" + f.File\n233\t}\n234\t\n235\t// runConclusionDiffers is why att does not state the typed conclusion of a\n236\t// run briefed to write one (template review-brief/3), or \"\": its criteria,\n237\t// tools and findings are the ones the run's draft concludes, whoever signs\n238\t// it. A run briefed with an earlier template carried no typed conclusion and\n239\t// binds only its decision, as before (review round 1, B1; decision D1)."}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"0680a35a-3302-4219-9088-3be5fa2aebe5","timestamp":"2026-11-27T12:02:24.152Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-f7649a2054/worktree/pose-mcp/internal/pose/review_conclusions.go","content":"}\n\n// ReadReviewConclusion is the conclusion record of run, if any.\nfunc (s Store) ReadReviewConclusion(runID string) (*ReviewConclusion, error) {\n\tif !validAttemptFileName(runID) {\n\t\treturn nil, fmt.Errorf(\"pose: %q is not a run id\", runID)\n\t}\n\tc, _, err := s.readReviewConclusionRaw(runID)\n\treturn c, err\n}\n\n// readReviewConclusionRaw is the conclusion record of run and the bytes it\n// was parsed from: one read, so what is judged is what a write expects\n// (review round 2, B4).\nfunc (s Store) readReviewConclusionRaw(runID string) (*ReviewConclusion, []byte, error) {\n\traw, err := readBoundedRegular(reviewConclusionPath(s.Root, runID), 1<<20)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\treturn nil, nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tvar c ReviewConclusion\n\tif err := json.Unmarshal(raw, &c); err != nil || c.RunID != runID {\n\t\treturn nil, nil, fmt.Errorf(\"pose: the conclusion record of %s cannot be read\", runID)\n\t}\n\treturn &c, raw, nil\n}\n\n// reviewConclusionChecks are the conditions a run must meet before its\n// conclusion is recorded, each a reason when it does not (R1, R3, R4).\nfunc (s Store) reviewConclusionChecks(run ReviewRun) ([]string, *ReviewBundle, *ReviewDraft) {\n\tvar reasons []string\n\tif run.Kind != ReviewBriefKindReview && run.Kind != ReviewBriefKindAdjudication && run.Kind != ReviewBriefKindSmoke || run.Purpose != \"\" && run.Purpose != DelegationPurposeForKind(run.Kind) {\n\t\treasons = append(reasons, \"the run is not a review, an adjudication or a smoke run\")\n\t}\n\tif run.Status != ReviewRunCompleted {\n\t\treasons = append(reasons, \"the run did not complete: it is \"+run.Status)\n\t}\n\tif run.SupersededBy != \"\" {\n\t\treasons = append(reasons, \"the run is superseded by \"+run.SupersededBy)\n\t}\n\tif run.Provenance == nil {\n\t\treasons = append(reasons, \"the run captured no provenance, so it cannot be signed\")\n\t}\n\tif run.Safety == nil || run.Safety.Operation.Outcome != OutcomeCompleted {\n\t\treasons = append(reasons, \"the run's cleanup is not confirmed complete\")\n\t}\n\tif why := s.reviewRunTranscriptIntact(run); why != \"\" {\n\t\treasons = append(reasons, \"the run's record is not intact: \"+why)\n\t}\n\tdraft, err := ParseReviewDraft(run.Output)\n\tswitch {\n\tcase err != nil:\n\t\treasons = append(reasons, \"the conclusion cannot be read: \"+err.Error())\n\tcase draft == nil:\n\t\treasons = append(reasons, \"the run's final message carries no pose-draft block\")\n\t}\n\tif len(run.DraftProblems) > 0 {\n\t\treasons = append(reasons, \"the draft does not account for its round: \"+strings.Join(run.DraftProblems, \"; \"))\n\t}\n\tbundle, err := s.LoadReviewBundle(run.BundleID)\n\tif err != nil {\n\t\treturn append(reasons, \"the run's bundle cannot be read: \"+err.Error()), nil, draft\n\t}\n\t// The run's own record must stand whatever it concludes. Whether its\n\t// bundle is still the current subject matters only to an approval: a\n\t// verdict that requests changes or rejects is a fact about the bundle it\n\t// reviewed, and the working tree the implementer is already fixing does\n\t// not change it (spec pose-review-conclude-ignores-unrelated-local-edits R1).\n\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n\t\treasons = append(reasons, \"the run no longer governs: \"+why)\n\t}\n\treasons = append(reasons, s.verdictCoverageReasons(run, bundle, draft)...)\n\treturn reasons, &bundle, draft\n}\n\n// reviewConclusionCurrency is why an approval of run's bundle would no longer\n// approve the current subject.\nfunc (s Store) reviewConclusionCurrency(run ReviewRun, bundle ReviewBundle) []string {\n\tvar reasons []string\n\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n\tif err != nil || current == nil || current.BundleID != bundle.BundleID {\n\t\treasons = append(reasons, \"the run's bundle no longer governs \"+bundle.Payload.Scope.Ref+\": the subject, the plan or the policy changed since it was sealed\")\n\t}\n\tif why := s.ReviewRunStillGoverns(run); why != \"\" {\n\t\treasons = append(reasons, \"the run no longer governs: \"+why)\n\t}\n\treturn reasons\n}\n\n// reviewAttestationFromDraft builds the attestation a draft concludes, for\n// the run that wrote it. Evidence is the run itself and each evidence the\n// draft names; a criterion or a tool the draft does not answer is left for\n// the preflight to refuse, never answered for it.\nfunc reviewAttestationFromDraft(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, reviewer string) ReviewAttestation {\n\tatt := ReviewAttestation{BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest, Reviewer: reviewer, Decision: draft.Decision}\n\tevidence := map[string]bool{\"delegated-run:\" + run.RunID: true}\n\tfor _, c := range draft.Criteria {\n\t\tatt.Criteria = append(att.Criteria, ReviewCriterion{ID: c.ID, Disposition: c.Disposition, Evidence: c.Evidence, Rationale: c.Rationale, Mappings: c.Mappings})\n\t\tif c.Evidence != \"\" {\n\t\t\tevidence[c.Evidence] = true\n\t\t}\n\t}\n\tvar tools []ReviewToolDisposition\n\tfor _, t := range draft.Tools {\n\t\ttools = append(tools, ReviewToolDisposition{ID: t.ID, Component: t.Component, Disposition: t.Disposition, Evidence: t.Evidence, Rationale: t.Rationale})\n\t}\n\tatt.Tools = ReviewToolDefaults(bundle.Payload.Plan.Tools, tools)\n\tfor _, f := range draft.Findings {\n\t\tfinding := ReviewFinding{ID: f.ID, Severity: f.Severity, Evidence: findingEvidence(f), Action: f.Action, Disposition: \"open\"}\n\t\tif f.Action == \"\" {\n\t\t\tfinding.Action = f.Summary\n\t\t}\n\t\t// A follow-up the reviewer gave an action, an owner and a review date\n\t\t// is a risk the reviewer accepted; anything else stays open and blocks\n\t\t// an approval. The engine never writes the action for the reviewer\n\t\t// (review round 1, B3).\n\t\tif f.Disposition == \"follow-up\" && f.Action != \"\" && f.Owner != \"\" && f.ReviewBy != \"\" {\n\t\t\tfinding.Disposition, finding.Owner, finding.ReviewBy, finding.Rationale = \"accepted-risk\", f.Owner, f.ReviewBy, f.Summary\n\t\t}\n\t\t// A follow-up the reviewer classified inside a declared accepted\n\t\t// limit is recorded as such, naming the limit (spec\n\t\t// pose-review-declared-threat-model R3).\n\t\t// Only a limit the bundle sealed: a draft of any decision naming\n\t\t// another is recorded as the follow-up it otherwise is, so no\n\t\t// attestation names a limit that does not exist (spec\n\t\t// pose-review-declared-limits-followups R4).\n\t\tif f.Disposition == \"follow-up\" && f.Limit != \"\" && sealedAcceptedLimit(bundle, f.Limit) {\n\t\t\tfinding.Disposition, finding.Limit, finding.Rationale, finding.Owner, finding.ReviewBy = \"within-limit\", f.Limit, f.Summary, f.Owner, f.ReviewBy\n\t\t}\n\t\tatt.Findings = append(att.Findings, finding)\n\t}\n\tfor ref := range evidence {\n\t\tatt.EvidenceRefs = append(att.EvidenceRefs, ref)\n\t}\n\tsort.Strings(att.EvidenceRefs)\n\tatt.Run = &ReviewRunReference{RunID: run.RunID}\n\treturn att\n}\n\n// ReviewToolDefaults is given followed by the dispositions that state no\n// conclusion, for the plan's tools given leaves out: a post-review gate\n// deferred, a recommended tool not used. A required tool left out stays out,\n// for the domain writer to name. `review attest` and a run's conclusion fill\n// the same defaults, so a run's conclusion and its attestation agree on them.\nfunc ReviewToolDefaults(plan []ReviewPlanTool, given []ReviewToolDisposition) []ReviewToolDisposition {\n\tout := append([]ReviewToolDisposition{}, given...)\n\tprovided := map[string]bool{}\n\tfor _, t := range given {\n\t\tprovided[t.ID+\"\\x00\"+t.Component] = true\n\t}\n\tfor _, tool := range plan {\n\t\tif provided[tool.ID+\"\\x00\"+tool.Component] {\n\t\t\tcontinue\n\t\t}\n\t\tif containsString(tool.Preconditions, \"review-complete\") {\n\t\t\tout = append(out, ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"deferred\", Rationale: \"post-review gate\"})\n\t\t} else if tool.Requiredness == \"recommended\" {\n\t\t\tout = append(out, ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"not-used\", Rationale: \"not used during review\"})\n\t\t}\n\t}\n\treturn out\n}\n\nfunc findingEvidence(f ReviewDraftFinding) string {\n\tif f.File == \"\" {\n\t\treturn \"\"\n\t}\n\tif f.Line > 0 {\n\t\treturn fmt.Sprintf(\"file:%s:%d\", f.File, f.Line)\n\t}\n\treturn \"file:\" + f.File\n}\n\n// runConclusionDiffers is why att does not state the typed conclusion of a\n// run briefed to write one (template review-brief/3), or \"\": its criteria,\n// tools and findings are the ones the run's draft concludes, whoever signs\n// it. A run briefed with an earlier template carried no typed conclusion and\n// binds only its decision, as before (review round 1, B1; decision D1).","numLines":180,"startLine":60,"totalLines":737}},"tool_result_meta":[{"id":"toolu_014o76gYRizQUxoe2osaQFYQ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
