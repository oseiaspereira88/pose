{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014dksgQ6Qc1TjkThqZdmwG2","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"testing\"\n8\t)\n9\t\n10\t// TestSchemaDrift guards the contract between the Go structs and the\n11\t// versioned response schemas (ADR-014, additive-only): every field the Go\n12\t// side serializes must be declared in the schema, and every schema-required\n13\t// field must actually serialize.\n14\tfunc TestSchemaDrift(t *testing.T) {\n15\t\tcases := []struct {\n16\t\t\tschema string\n17\t\t\tsample any\n18\t\t}{\n19\t\t\t{\"spec.schema.json\", Spec{Slug: \"s\", Status: \"done\", CreatedAt: \"2026-01-01\",\n20\t\t\t\tCompletedAt: \"2026-01-02\", Supersedes: \"old\", Remediates: []string{\"spec:old@defect-fix\"}, Title: \"T\", Path: \"p\", Body: \"b\"}},\n21\t\t\t{\"artifact.schema.json\", Markdown{Name: \"n\", Title: \"T\", Path: \"p\", Body: \"b\"}},\n22\t\t\t{\"gate-result.schema.json\", GateResult{Command: \"c\", ExitCode: 1, Passed: false, Output: \"o\"}},\n23\t\t\t{\"insights.schema.json\", InsightsResult{GroupBy: \"workflow\", SinceDays: 30,\n24\t\t\t\tRecordsScanned: 2, RecordsSkippedByWindow: 1, RecordsSkippedInvalid: 0,\n25\t\t\t\tRows: []InsightRow{{Key: \"feature\", Pass: 1, Total: 1}}}},\n26\t\t\t{\"obligation.schema.json\", sampleObligation(ObligationDependency)},\n27\t\t\t// Spec pose-review-declared-limits-followups R5.\n28\t\t\t{\"review-plan.schema.json\", ReviewPlan{AcceptedLimits: []ReviewAcceptedLimit{{ID: \"L1\", Text: \"t\", Spec: \"s\"}}, Limitations: []string{\"l\"}}},\n29\t\t\t{\"contract-nodes.schema.json\", ProjectContractNodes(\"nodes\", \"# Spec\\n\\n## 2. Requirements\\n\\n- R1: One.\\n\\n## 5. Decisions\\n\\n### Decision D1\\n- Basis: R7\\n\")},\n30\t\t}\n31\t\tfor _, tc := range cases {\n32\t\t\tt.Run(tc.schema, func(t *testing.T) {\n33\t\t\t\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"schemas\", \"v1\", tc.schema))\n34\t\t\t\tif err != nil {\n35\t\t\t\t\tt.Fatalf(\"reading schema: %v\", err)\n36\t\t\t\t}\n37\t\t\t\tvar schema struct {\n38\t\t\t\t\tProperties map[string]any `json:\"properties\"`\n39\t\t\t\t\tRequired   []string       `json:\"required\"`\n40\t\t\t\t}\n41\t\t\t\tif err := json.Unmarshal(raw, &schema); err != nil {\n42\t\t\t\t\tt.Fatalf(\"parsing schema: %v\", err)\n43\t\t\t\t}\n44\t\n45\t\t\t\tdata, err := json.Marshal(tc.sample)\n46\t\t\t\tif err != nil {\n47\t\t\t\t\tt.Fatal(err)\n48\t\t\t\t}\n49\t\t\t\tvar serialized map[string]any\n50\t\t\t\tif err := json.Unmarshal(data, &serialized); err != nil {\n51\t\t\t\t\tt.Fatal(err)\n52\t\t\t\t}\n53\t\n54\t\t\t\tfor field := range serialized {\n55\t\t\t\t\tif _, ok := schema.Properties[field]; !ok {\n56\t\t\t\t\t\tt.Errorf(\"field %q serialized by Go but absent from %s (additive-only: declare it)\", field, tc.schema)\n57\t\t\t\t\t}\n58\t\t\t\t}\n59\t\t\t\tfor _, req := range schema.Required {\n60\t\t\t\t\tif _, ok := serialized[req]; !ok {\n61\t\t\t\t\t\tt.Errorf(\"schema-required field %q not serialized by the Go struct\", req)\n62\t\t\t\t\t}\n63\t\t\t\t}\n64\t\t\t})\n65\t\t}\n66\t}\n67\t\n68\t// Spec pose-review-declared-limits-followups R5: the bundle schema's plan\n69\t// declares the fields the sealed bundle plan carries.\n70\tfunc TestTheBundleSchemaDeclaresTheAcceptedLimits(t *testing.T) {\n71\t\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"schemas\", \"v1\", \"review-bundle.schema.json\"))\n72\t\tif err != nil {\n73\t\t\tt.Fatal(err)\n74\t\t}\n75\t\tvar schema map[string]any\n76\t\tif err := json.Unmarshal(raw, &schema); err != nil {\n77\t\t\tt.Fatal(err)\n78\t\t}\n79\t\tvar walk func(any) bool\n80\t\twalk = func(node any) bool {\n81\t\t\tswitch v := node.(type) {\n82\t\t\tcase map[string]any:\n83\t\t\t\tif p, ok := v[\"properties\"].(map[string]any); ok {\n84\t\t\t\t\tif _, digest := p[\"plan_digest\"]; digest {\n85\t\t\t\t\t\t_, limits := p[\"accepted_limits\"]\n86\t\t\t\t\t\t_, limitations := p[\"limitations\"]\n87\t\t\t\t\t\treturn limits && limitations\n88\t\t\t\t\t}\n89\t\t\t\t}\n90\t\t\t\tfor _, child := range v {\n91\t\t\t\t\tif walk(child) {\n92\t\t\t\t\t\treturn true\n93\t\t\t\t\t}\n94\t\t\t\t}\n95\t\t\t}\n96\t\t\treturn false\n97\t\t}\n98\t\tif !walk(schema) {\n99\t\t\tt.Fatal(\"the bundle schema's plan does not declare accepted_limits and limitations\")\n100\t\t}\n101\t}\n102\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"f75f4fda-5c8b-495e-8313-5b19c07b1a08","timestamp":"2026-11-27T12:04:29.006Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-f7649a2054/worktree/pose-mcp/internal/pose/schema_test.go","content":"package pose\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\n// TestSchemaDrift guards the contract between the Go structs and the\n// versioned response schemas (ADR-014, additive-only): every field the Go\n// side serializes must be declared in the schema, and every schema-required\n// field must actually serialize.\nfunc TestSchemaDrift(t *testing.T) {\n\tcases := []struct {\n\t\tschema string\n\t\tsample any\n\t}{\n\t\t{\"spec.schema.json\", Spec{Slug: \"s\", Status: \"done\", CreatedAt: \"2026-01-01\",\n\t\t\tCompletedAt: \"2026-01-02\", Supersedes: \"old\", Remediates: []string{\"spec:old@defect-fix\"}, Title: \"T\", Path: \"p\", Body: \"b\"}},\n\t\t{\"artifact.schema.json\", Markdown{Name: \"n\", Title: \"T\", Path: \"p\", Body: \"b\"}},\n\t\t{\"gate-result.schema.json\", GateResult{Command: \"c\", ExitCode: 1, Passed: false, Output: \"o\"}},\n\t\t{\"insights.schema.json\", InsightsResult{GroupBy: \"workflow\", SinceDays: 30,\n\t\t\tRecordsScanned: 2, RecordsSkippedByWindow: 1, RecordsSkippedInvalid: 0,\n\t\t\tRows: []InsightRow{{Key: \"feature\", Pass: 1, Total: 1}}}},\n\t\t{\"obligation.schema.json\", sampleObligation(ObligationDependency)},\n\t\t// Spec pose-review-declared-limits-followups R5.\n\t\t{\"review-plan.schema.json\", ReviewPlan{AcceptedLimits: []ReviewAcceptedLimit{{ID: \"L1\", Text: \"t\", Spec: \"s\"}}, Limitations: []string{\"l\"}}},\n\t\t{\"contract-nodes.schema.json\", ProjectContractNodes(\"nodes\", \"# Spec\\n\\n## 2. Requirements\\n\\n- R1: One.\\n\\n## 5. Decisions\\n\\n### Decision D1\\n- Basis: R7\\n\")},\n\t}\n\tfor _, tc := range cases {\n\t\tt.Run(tc.schema, func(t *testing.T) {\n\t\t\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"schemas\", \"v1\", tc.schema))\n\t\t\tif err != nil {\n\t\t\t\tt.Fatalf(\"reading schema: %v\", err)\n\t\t\t}\n\t\t\tvar schema struct {\n\t\t\t\tProperties map[string]any `json:\"properties\"`\n\t\t\t\tRequired   []string       `json:\"required\"`\n\t\t\t}\n\t\t\tif err := json.Unmarshal(raw, &schema); err != nil {\n\t\t\t\tt.Fatalf(\"parsing schema: %v\", err)\n\t\t\t}\n\n\t\t\tdata, err := json.Marshal(tc.sample)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tvar serialized map[string]any\n\t\t\tif err := json.Unmarshal(data, &serialized); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\n\t\t\tfor field := range serialized {\n\t\t\t\tif _, ok := schema.Properties[field]; !ok {\n\t\t\t\t\tt.Errorf(\"field %q serialized by Go but absent from %s (additive-only: declare it)\", field, tc.schema)\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor _, req := range schema.Required {\n\t\t\t\tif _, ok := serialized[req]; !ok {\n\t\t\t\t\tt.Errorf(\"schema-required field %q not serialized by the Go struct\", req)\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\n\n// Spec pose-review-declared-limits-followups R5: the bundle schema's plan\n// declares the fields the sealed bundle plan carries.\nfunc TestTheBundleSchemaDeclaresTheAcceptedLimits(t *testing.T) {\n\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"schemas\", \"v1\", \"review-bundle.schema.json\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar schema map[string]any\n\tif err := json.Unmarshal(raw, &schema); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar walk func(any) bool\n\twalk = func(node any) bool {\n\t\tswitch v := node.(type) {\n\t\tcase map[string]any:\n\t\t\tif p, ok := v[\"properties\"].(map[string]any); ok {\n\t\t\t\tif _, digest := p[\"plan_digest\"]; digest {\n\t\t\t\t\t_, limits := p[\"accepted_limits\"]\n\t\t\t\t\t_, limitations := p[\"limitations\"]\n\t\t\t\t\treturn limits && limitations\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor _, child := range v {\n\t\t\t\tif walk(child) {\n\t\t\t\t\treturn true\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn false\n\t}\n\tif !walk(schema) {\n\t\tt.Fatal(\"the bundle schema's plan does not declare accepted_limits and limitations\")\n\t}\n}\n","numLines":102,"startLine":1,"totalLines":102}},"tool_result_meta":[{"id":"toolu_014dksgQ6Qc1TjkThqZdmwG2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
