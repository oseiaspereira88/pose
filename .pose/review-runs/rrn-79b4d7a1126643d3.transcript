{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LuhkAEorgg4Z5ptbVtwoy1","type":"tool_result","content":"2979\tfunc (s Store) RecordReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n2980\t\tvar result ReviewAttestation\n2981\t\terr := s.withReviewAttestationWriteGuard(\"review.attestation.record\", att, func(guarded Store) error {\n2982\t\t\tvar err error\n2983\t\t\tresult, err = guarded.recordReviewAttestation(att, now, false)\n2984\t\t\treturn err\n2985\t\t})\n2986\t\treturn result, err\n2987\t}\n2988\t\n2989\tfunc (s Store) recordReviewAttestation(att ReviewAttestation, now time.Time, signed bool) (ReviewAttestation, error) {\n2990\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n2991\t\tif err != nil {\n2992\t\t\treturn ReviewAttestation{}, err\n2993\t\t}\n2994\t\tpolicy, _, err := s.loadReviewPolicy()\n2995\t\tif err != nil {\n2996\t\t\treturn ReviewAttestation{}, err\n2997\t\t}\n2998\t\tif policy.RequireSignedAttestations && !signed {\n2999\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review policy requires a trusted signed attestation envelope\")\n3000\t\t}\n3001\t\tatt, err = completeReviewAttestation(bundle, att, now)\n3002\t\tif err != nil {\n3003\t\t\treturn ReviewAttestation{}, err\n3004\t\t}\n3005\t\t// The approval preflight runs here, in the one writer every channel shares,\n3006\t\t// before anything is written: an approval the verifier would reject is\n3007\t\t// refused, not recorded and rejected later (spec\n3008\t\t// pose-review-approval-domain-preflight).\n3009\t\tif blockers := s.reviewApprovalAdmissionBlockers(bundle, att, now); len(blockers) > 0 {\n3010\t\t\treturn ReviewAttestation{}, &ReviewApprovalRefusal{BundleID: bundle.BundleID, Blockers: blockers}\n3011\t\t}\n3012\t\tatt.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", att.AttestationID+\".json\"))\n3013\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), true)\n3014\t\tif err != nil {\n3015\t\t\treturn ReviewAttestation{}, err\n3016\t\t}\n3017\t\tpath := filepath.Join(dir, att.AttestationID+\".json\")\n3018\t\tif existing, loadErr := s.LoadReviewAttestation(att.AttestationID); loadErr == nil {\n3019\t\t\texistingRaw, _ := json.Marshal(existing)\n3020\t\t\tcandidateRaw, _ := json.Marshal(att)\n3021\t\t\tif bytes.Equal(existingRaw, candidateRaw) {\n3022\t\t\t\treturn existing, nil\n3023\t\t\t}\n3024\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation identity collision for %s\", att.AttestationID)\n3025\t\t}\n3026\t\traw, err := json.MarshalIndent(att, \"\", \"  \")\n3027\t\tif err != nil {\n3028\t\t\treturn ReviewAttestation{}, err\n3029\t\t}\n3030\t\tif err := writeImmutableJSONIn(s.fsys(), path, append(raw, '\\n')); err != nil {\n3031\t\t\tvar durability *PublishDurabilityError\n3032\t\t\tif errors.As(err, &durability) {\n3033\t\t\t\treturn att, err\n3034\t\t\t}\n3035\t\t\treturn ReviewAttestation{}, err\n3036\t\t}\n3037\t\treturn att, nil\n3038\t}\n3039\t\n3040\t// completeReviewAttestation fills and checks what recording sets: the bundle\n3041\t// binding, schema, attested time and content-derived id. Recording and the MCP\n3042\t// preview share it, so an issuer that signs a previewed attestation signs the\n3043\t// bytes that will be recorded (spec pose-mcp-review-attest-signed-only).\n3044\tfunc completeReviewAttestation(bundle ReviewBundle, att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n3045\t\tif att.Limitations == nil {\n3046\t\t\tatt.Limitations = append([]string(nil), bundle.Payload.Plan.Limitations...)\n3047\t\t}\n3048\t\tif strings.Join(att.Limitations, \"\\x00\") != strings.Join(bundle.Payload.Plan.Limitations, \"\\x00\") {\n3049\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation must retain the sealed review limitations\")\n3050\t\t}\n3051\t\tif att.BundleDigest == \"\" {\n3052\t\t\tatt.BundleDigest = bundle.BundleDigest\n3053\t\t}\n3054\t\tif att.BundleDigest != bundle.BundleDigest {\n3055\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation bundle digest mismatch\")\n3056\t\t}\n3057\t\tif att.Reviewer == \"\" || strings.ContainsAny(att.Reviewer, \"\\r\\n\") || (!strings.HasPrefix(att.Reviewer, \"agent:\") && !strings.HasPrefix(att.Reviewer, \"human:\")) {\n3058\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid reviewer execution identity\")\n3059\t\t}\n3060\t\tif att.Decision != \"approved\" && att.Decision != \"approved-with-reservations\" && att.Decision != \"changes-requested\" && att.Decision != \"rejected\" {\n3061\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid review decision %q\", att.Decision)\n3062\t\t}\n3063\t\tif err := ValidateReviewAttribution(att); err != nil {\n3064\t\t\treturn ReviewAttestation{}, err\n3065\t\t}\n3066\t\tatt.SchemaVersion = ReviewBundleSchemaVersion\n3067\t\tif att.AttestedAt == \"\" {\n3068\t\t\tatt.AttestedAt = now.UTC().Truncate(time.Second).Format(time.RFC3339)\n3069\t\t} else if _, err := time.Parse(time.RFC3339, att.AttestedAt); err != nil {\n3070\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attested_at must be RFC3339\")\n3071\t\t}\n3072\t\tatt.BundleID = bundle.BundleID\n3073\t\tatt.BundleDigest = bundle.BundleDigest\n3074\t\texpectedAttestationID := reviewAttestationID(att)\n3075\t\tif att.AttestationID == \"\" {\n3076\t\t\tatt.AttestationID = expectedAttestationID\n3077\t\t} else if att.AttestationID != expectedAttestationID {\n3078\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation id does not match its content digest\")\n3079\t\t}\n3080\t\tif !strings.HasPrefix(att.AttestationID, \"rva-\") || len(att.AttestationID) != 20 {\n3081\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid attestation id\")\n3082\t\t}\n3083\t\treturn att, nil\n3084\t}\n3085\t\n3086\t// SignableReviewAttestation completes a draft attestation for its sealed bundle\n3087\t// as recording would, including the confirmation digest when the draft names a\n3088\t// confirming principal, and returns it with the canonical bytes a trusted\n3089\t// issuer signs into a ReviewAttestationEnvelope. It records nothing.\n3090\tfunc (s Store) SignableReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, []byte, error) {\n3091\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n3092\t\tif err != nil {\n3093\t\t\treturn ReviewAttestation{}, nil, err\n3094\t\t}\n3095\t\tif att.BundleDigest == \"\" {\n3096\t\t\tatt.BundleDigest = bundle.BundleDigest\n3097\t\t}\n3098\t\tif a := att.Attribution; a != nil && a.ConfirmedBy != \"\" && a.ConfirmationDigest == \"\" {\n3099\t\t\tbound := *a\n3100\t\t\tbound.ConfirmationDigest = ReviewConfirmationDigest(att)\n3101\t\t\tatt.Attribution = &bound\n3102\t\t}\n3103\t\tatt.Path, att.Envelope = \"\", nil\n3104\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\n3105\t\tif err != nil {\n3106\t\t\treturn ReviewAttestation{}, nil, err\n3107\t\t}\n3108\t\tcanonical, err := json.Marshal(completed)\n3109\t\tif err != nil {\n3110\t\t\treturn ReviewAttestation{}, nil, err\n3111\t\t}\n3112\t\treturn completed, canonical, nil\n3113\t}\n3114\t\n3115\t// RecordReviewAttestationEnvelope verifies a trusted issuer's envelope and,\n3116\t// with apply, records the attestation it carries: the path both\n3117\t// `pose review attest --envelope` and the MCP tool take.\n3118\tfunc (s Store) RecordReviewAttestationEnvelope(envelope ReviewAttestationEnvelope, apply bool) (ReviewAttestation, error) {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"f0baa0ef-dd57-4769-9697-56b6eb96d6fd","timestamp":"2026-11-27T12:03:10.027Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-f7649a2054/worktree/pose-mcp/internal/pose/review_bundle.go","content":"func (s Store) RecordReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n\tvar result ReviewAttestation\n\terr := s.withReviewAttestationWriteGuard(\"review.attestation.record\", att, func(guarded Store) error {\n\t\tvar err error\n\t\tresult, err = guarded.recordReviewAttestation(att, now, false)\n\t\treturn err\n\t})\n\treturn result, err\n}\n\nfunc (s Store) recordReviewAttestation(att ReviewAttestation, now time.Time, signed bool) (ReviewAttestation, error) {\n\tbundle, err := s.LoadReviewBundle(att.BundleID)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tpolicy, _, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tif policy.RequireSignedAttestations && !signed {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review policy requires a trusted signed attestation envelope\")\n\t}\n\tatt, err = completeReviewAttestation(bundle, att, now)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\t// The approval preflight runs here, in the one writer every channel shares,\n\t// before anything is written: an approval the verifier would reject is\n\t// refused, not recorded and rejected later (spec\n\t// pose-review-approval-domain-preflight).\n\tif blockers := s.reviewApprovalAdmissionBlockers(bundle, att, now); len(blockers) > 0 {\n\t\treturn ReviewAttestation{}, &ReviewApprovalRefusal{BundleID: bundle.BundleID, Blockers: blockers}\n\t}\n\tatt.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", att.AttestationID+\".json\"))\n\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), true)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tpath := filepath.Join(dir, att.AttestationID+\".json\")\n\tif existing, loadErr := s.LoadReviewAttestation(att.AttestationID); loadErr == nil {\n\t\texistingRaw, _ := json.Marshal(existing)\n\t\tcandidateRaw, _ := json.Marshal(att)\n\t\tif bytes.Equal(existingRaw, candidateRaw) {\n\t\t\treturn existing, nil\n\t\t}\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation identity collision for %s\", att.AttestationID)\n\t}\n\traw, err := json.MarshalIndent(att, \"\", \"  \")\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tif err := writeImmutableJSONIn(s.fsys(), path, append(raw, '\\n')); err != nil {\n\t\tvar durability *PublishDurabilityError\n\t\tif errors.As(err, &durability) {\n\t\t\treturn att, err\n\t\t}\n\t\treturn ReviewAttestation{}, err\n\t}\n\treturn att, nil\n}\n\n// completeReviewAttestation fills and checks what recording sets: the bundle\n// binding, schema, attested time and content-derived id. Recording and the MCP\n// preview share it, so an issuer that signs a previewed attestation signs the\n// bytes that will be recorded (spec pose-mcp-review-attest-signed-only).\nfunc completeReviewAttestation(bundle ReviewBundle, att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n\tif att.Limitations == nil {\n\t\tatt.Limitations = append([]string(nil), bundle.Payload.Plan.Limitations...)\n\t}\n\tif strings.Join(att.Limitations, \"\\x00\") != strings.Join(bundle.Payload.Plan.Limitations, \"\\x00\") {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation must retain the sealed review limitations\")\n\t}\n\tif att.BundleDigest == \"\" {\n\t\tatt.BundleDigest = bundle.BundleDigest\n\t}\n\tif att.BundleDigest != bundle.BundleDigest {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation bundle digest mismatch\")\n\t}\n\tif att.Reviewer == \"\" || strings.ContainsAny(att.Reviewer, \"\\r\\n\") || (!strings.HasPrefix(att.Reviewer, \"agent:\") && !strings.HasPrefix(att.Reviewer, \"human:\")) {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid reviewer execution identity\")\n\t}\n\tif att.Decision != \"approved\" && att.Decision != \"approved-with-reservations\" && att.Decision != \"changes-requested\" && att.Decision != \"rejected\" {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid review decision %q\", att.Decision)\n\t}\n\tif err := ValidateReviewAttribution(att); err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tatt.SchemaVersion = ReviewBundleSchemaVersion\n\tif att.AttestedAt == \"\" {\n\t\tatt.AttestedAt = now.UTC().Truncate(time.Second).Format(time.RFC3339)\n\t} else if _, err := time.Parse(time.RFC3339, att.AttestedAt); err != nil {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attested_at must be RFC3339\")\n\t}\n\tatt.BundleID = bundle.BundleID\n\tatt.BundleDigest = bundle.BundleDigest\n\texpectedAttestationID := reviewAttestationID(att)\n\tif att.AttestationID == \"\" {\n\t\tatt.AttestationID = expectedAttestationID\n\t} else if att.AttestationID != expectedAttestationID {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation id does not match its content digest\")\n\t}\n\tif !strings.HasPrefix(att.AttestationID, \"rva-\") || len(att.AttestationID) != 20 {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid attestation id\")\n\t}\n\treturn att, nil\n}\n\n// SignableReviewAttestation completes a draft attestation for its sealed bundle\n// as recording would, including the confirmation digest when the draft names a\n// confirming principal, and returns it with the canonical bytes a trusted\n// issuer signs into a ReviewAttestationEnvelope. It records nothing.\nfunc (s Store) SignableReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, []byte, error) {\n\tbundle, err := s.LoadReviewBundle(att.BundleID)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\tif att.BundleDigest == \"\" {\n\t\tatt.BundleDigest = bundle.BundleDigest\n\t}\n\tif a := att.Attribution; a != nil && a.ConfirmedBy != \"\" && a.ConfirmationDigest == \"\" {\n\t\tbound := *a\n\t\tbound.ConfirmationDigest = ReviewConfirmationDigest(att)\n\t\tatt.Attribution = &bound\n\t}\n\tatt.Path, att.Envelope = \"\", nil\n\tcompleted, err := completeReviewAttestation(bundle, att, now)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\tcanonical, err := json.Marshal(completed)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\treturn completed, canonical, nil\n}\n\n// RecordReviewAttestationEnvelope verifies a trusted issuer's envelope and,\n// with apply, records the attestation it carries: the path both\n// `pose review attest --envelope` and the MCP tool take.\nfunc (s Store) RecordReviewAttestationEnvelope(envelope ReviewAttestationEnvelope, apply bool) (ReviewAttestation, error) {","numLines":140,"startLine":2979,"totalLines":4951}},"tool_result_meta":[{"id":"toolu_01LuhkAEorgg4Z5ptbVtwoy1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
