{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018AdKBkqwx7uaysnY1LkHXP","type":"tool_result","content":"685\t}\n686\t\n687\t// errReviewRunHistoryIncomplete is a run history that could not be read whole.\n688\tvar errReviewRunHistoryIncomplete = errors.New(\"run provenance history is incomplete\")\n689\t\n690\tfunc (s Store) verifyRunReviewReference(bundle ReviewBundle, att ReviewAttestation) (ReviewRunAssurance, error) {\n691\t\tif att.Run == nil {\n692\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"signed run reference is missing\")\n693\t\t}\n694\t\tvar assurance ReviewRunAssurance\n695\t\tvar e error\n696\t\tif s.runApprovalAsSealed(bundle) {\n697\t\t\tassurance, e = s.VerifyReviewRunProofAsSealed(att.Run.RunID, att.Run.ProofID)\n698\t\t} else {\n699\t\t\tassurance, e = s.VerifyReviewRunProof(att.Run.RunID, att.Run.ProofID)\n700\t\t}\n701\t\tif e != nil {\n702\t\t\treturn assurance, e\n703\t\t}\n704\t\trun, e := s.LoadProvenanceReviewRun(att.Run.RunID)\n705\t\tif e != nil {\n706\t\t\treturn assurance, e\n707\t\t}\n708\t\tif run.BundleID != bundle.BundleID || run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.Kind != ReviewBriefKindReview || run.Status != ReviewRunCompleted || !assurance.CompleteReview || att.Reviewer != assurance.Reviewer.Principal {\n709\t\t\treturn assurance, fmt.Errorf(\"attestation and referenced run context differ\")\n710\t\t}\n711\t\tattested, e1 := time.Parse(time.RFC3339Nano, att.AttestedAt)\n712\t\tended, e2 := time.Parse(time.RFC3339Nano, run.EndedAt)\n713\t\tissued, e3 := time.Parse(time.RFC3339Nano, assurance.ProofIssuedAt)\n714\t\tif e1 != nil || e2 != nil || e3 != nil || ended.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) || issued.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) {\n715\t\t\treturn assurance, fmt.Errorf(\"run-backed attestation predates its completed run or authenticated run proof\")\n716\t\t}\n717\t\tdraft := draftReviewDecision(run.Output)\n718\t\tapproval := att.Decision == \"approved\" || att.Decision == \"approved-with-reservations\"\n719\t\tif approval && draft != \"approved\" {\n720\t\t\treturn assurance, fmt.Errorf(\"run draft does not support an approval: decision is %s\", draft)\n721\t\t}\n722\t\tif approval {\n723\t\t\t// A draft that does not account for the previous round is never an\n724\t\t\t// approval, whatever its decision line says (spec\n725\t\t\t// pose-delegated-review-round-protocol R4, R9, D2).\n726\t\t\tround, err := s.ReviewRoundOf(bundle)\n727\t\t\tif err != nil {\n728\t\t\t\treturn assurance, err\n729\t\t\t}\n730\t\t\tif problems := ValidateRoundDraft(round, run.Output); len(problems) > 0 {\n731\t\t\t\treturn assurance, fmt.Errorf(\"the run's draft is invalid for round %d: %s\", round.Number, strings.Join(problems, \"; \"))\n732\t\t\t}\n733\t\t}\n734\t\tif !approval && (draft != \"rejected\" && draft != \"changes-requested\") {\n735\t\t\treturn assurance, fmt.Errorf(\"run draft does not support a rejecting attestation: decision is %s\", draft)\n736\t\t}\n737\t\tif why := runConclusionDiffers(run, bundle, att); why != \"\" {\n738\t\t\treturn assurance, fmt.Errorf(\"the attestation does not state the run's conclusion: %s\", why)\n739\t\t}\n740\t\tif att.Authority == nil || att.Authority.Role != \"agent\" || att.Authority.ReviewExecution != run.RunID || att.Authority.ImplementationPrincipal != assurance.Implementation.Principal || att.Authority.ImplementationExecution != assurance.Implementation.Execution {\n741\t\t\treturn assurance, fmt.Errorf(\"attestation authority differs from run provenance\")\n742\t\t}\n743\t\tif assurance.Implementation.Execution == run.RunID {\n744\t\t\treturn assurance, fmt.Errorf(\"implementation and review executions are the same\")\n745\t\t}\n746\t\tif bundle.Payload.Plan.Independence == \"different-actor\" && !assurance.VendorDifference && !assurance.ModelDifference {\n747\t\t\treturn assurance, fmt.Errorf(\"reviewer vendor and model both match the implementation\")\n748\t\t}\n749\t\tif bundle.Payload.Plan.Independence == \"mandatory-human\" {\n750\t\t\treturn assurance, fmt.Errorf(\"machine-attested run cannot satisfy mandatory-human\")\n751\t\t}\n752\t\treturn assurance, nil\n753\t}\n754\tfunc (s Store) runBackedReviewBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n755\t\tblockers := s.verifiedAuthorityBlockers(bundle, att)\n756\t\tif _, e := s.verifyRunReviewReference(bundle, att); e != nil {\n757\t\t\tblockers = append(blockers, e.Error())\n758\t\t}\n759\t\treturn uniqueSorted(blockers)"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"6614df8e-6f1b-46d6-93b0-9eb7f75abad1","timestamp":"2026-11-27T12:04:39.712Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-f7649a2054/worktree/pose-mcp/internal/pose/review_run_provenance.go","content":"}\n\n// errReviewRunHistoryIncomplete is a run history that could not be read whole.\nvar errReviewRunHistoryIncomplete = errors.New(\"run provenance history is incomplete\")\n\nfunc (s Store) verifyRunReviewReference(bundle ReviewBundle, att ReviewAttestation) (ReviewRunAssurance, error) {\n\tif att.Run == nil {\n\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"signed run reference is missing\")\n\t}\n\tvar assurance ReviewRunAssurance\n\tvar e error\n\tif s.runApprovalAsSealed(bundle) {\n\t\tassurance, e = s.VerifyReviewRunProofAsSealed(att.Run.RunID, att.Run.ProofID)\n\t} else {\n\t\tassurance, e = s.VerifyReviewRunProof(att.Run.RunID, att.Run.ProofID)\n\t}\n\tif e != nil {\n\t\treturn assurance, e\n\t}\n\trun, e := s.LoadProvenanceReviewRun(att.Run.RunID)\n\tif e != nil {\n\t\treturn assurance, e\n\t}\n\tif run.BundleID != bundle.BundleID || run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.Kind != ReviewBriefKindReview || run.Status != ReviewRunCompleted || !assurance.CompleteReview || att.Reviewer != assurance.Reviewer.Principal {\n\t\treturn assurance, fmt.Errorf(\"attestation and referenced run context differ\")\n\t}\n\tattested, e1 := time.Parse(time.RFC3339Nano, att.AttestedAt)\n\tended, e2 := time.Parse(time.RFC3339Nano, run.EndedAt)\n\tissued, e3 := time.Parse(time.RFC3339Nano, assurance.ProofIssuedAt)\n\tif e1 != nil || e2 != nil || e3 != nil || ended.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) || issued.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) {\n\t\treturn assurance, fmt.Errorf(\"run-backed attestation predates its completed run or authenticated run proof\")\n\t}\n\tdraft := draftReviewDecision(run.Output)\n\tapproval := att.Decision == \"approved\" || att.Decision == \"approved-with-reservations\"\n\tif approval && draft != \"approved\" {\n\t\treturn assurance, fmt.Errorf(\"run draft does not support an approval: decision is %s\", draft)\n\t}\n\tif approval {\n\t\t// A draft that does not account for the previous round is never an\n\t\t// approval, whatever its decision line says (spec\n\t\t// pose-delegated-review-round-protocol R4, R9, D2).\n\t\tround, err := s.ReviewRoundOf(bundle)\n\t\tif err != nil {\n\t\t\treturn assurance, err\n\t\t}\n\t\tif problems := ValidateRoundDraft(round, run.Output); len(problems) > 0 {\n\t\t\treturn assurance, fmt.Errorf(\"the run's draft is invalid for round %d: %s\", round.Number, strings.Join(problems, \"; \"))\n\t\t}\n\t}\n\tif !approval && (draft != \"rejected\" && draft != \"changes-requested\") {\n\t\treturn assurance, fmt.Errorf(\"run draft does not support a rejecting attestation: decision is %s\", draft)\n\t}\n\tif why := runConclusionDiffers(run, bundle, att); why != \"\" {\n\t\treturn assurance, fmt.Errorf(\"the attestation does not state the run's conclusion: %s\", why)\n\t}\n\tif att.Authority == nil || att.Authority.Role != \"agent\" || att.Authority.ReviewExecution != run.RunID || att.Authority.ImplementationPrincipal != assurance.Implementation.Principal || att.Authority.ImplementationExecution != assurance.Implementation.Execution {\n\t\treturn assurance, fmt.Errorf(\"attestation authority differs from run provenance\")\n\t}\n\tif assurance.Implementation.Execution == run.RunID {\n\t\treturn assurance, fmt.Errorf(\"implementation and review executions are the same\")\n\t}\n\tif bundle.Payload.Plan.Independence == \"different-actor\" && !assurance.VendorDifference && !assurance.ModelDifference {\n\t\treturn assurance, fmt.Errorf(\"reviewer vendor and model both match the implementation\")\n\t}\n\tif bundle.Payload.Plan.Independence == \"mandatory-human\" {\n\t\treturn assurance, fmt.Errorf(\"machine-attested run cannot satisfy mandatory-human\")\n\t}\n\treturn assurance, nil\n}\nfunc (s Store) runBackedReviewBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n\tblockers := s.verifiedAuthorityBlockers(bundle, att)\n\tif _, e := s.verifyRunReviewReference(bundle, att); e != nil {\n\t\tblockers = append(blockers, e.Error())\n\t}\n\treturn uniqueSorted(blockers)","numLines":75,"startLine":685,"totalLines":949}},"tool_result_meta":[{"id":"toolu_018AdKBkqwx7uaysnY1LkHXP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
