{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L7XFVxaF6FCUiAqJzFYpko","type":"tool_result","content":"diff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex a4121d4d..355f8f37 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -780,12 +780,18 @@ func (s Store) reviewBundleSubject(scope ScopeRef, components []ReviewPlanCompon\n \tgitlinks := reviewBundleGitlinksIn(s.fsys(), s.Root, uniqueSorted(candidatePaths))\n \t// One status of the tree for the whole subject, taken on first need.\n \tvar status *workingTreeSnapshot\n+\tnewestHead := s.newestResolvedHead(sets)\n \tfor _, set := range sets {\n \t\tsubject.ChangeSets = append(subject.ChangeSets, set.ID)\n \t\tif subject.Base == \"\" {\n \t\t\tsubject.Base = set.ResolvedBase\n \t\t}\n+\t\t// The head of the subject is the newest head of its change sets, not the head of the\n+\t\t// one the sort by id happens to put last (spec pose-review-subject-head-is-the-newest).\n \t\tsubject.Head = set.ResolvedHead\n+\t\tif newestHead != \"\" {\n+\t\t\tsubject.Head = newestHead\n+\t\t}\n \t\tfor _, observed := range set.Paths {\n \t\t\tif observed.Action != \"renamed\" && supersededPaths[observed.Path] {\n \t\t\t\texcluded = append(excluded, ReviewBundleInput{Kind: \"superseded-path\", Path: observed.Path, Reason: \"a later attributed rename supplies the current review subject identity\"})\n@@ -4454,6 +4460,35 @@ func (s Store) sealedDeclarationHolds(bundle *ReviewBundle) bool {\n \treturn sealed == rm.UnreviewedMilestones\n }\n \n+// newestResolvedHead is, of the heads of the change sets, the one no other descends from (the\n+// first commit of the topological order of their histories, which lists a descendant before its\n+// ancestors, so it does not depend on timestamps); empty when\n+// there are fewer than two distinct heads (nothing to choose) or Git cannot order them, in which\n+// case the caller keeps the head of the last set.\n+func (s Store) newestResolvedHead(sets []ChangeSet) string {\n+\tvar heads []string\n+\tseen := map[string]bool{}\n+\tfor _, set := range sets {\n+\t\tif set.ResolvedHead != \"\" && !seen[set.ResolvedHead] {\n+\t\t\tseen[set.ResolvedHead] = true\n+\t\t\theads = append(heads, set.ResolvedHead)\n+\t\t}\n+\t}\n+\tif len(heads) < 2 {\n+\t\treturn \"\"\n+\t}\n+\tfiles := s.fsys()\n+\tproducer := governanceProducerFromFiles(files, \"review\")\n+\tout, err := captureGovernanceGit(files, s.Root, producer, append([]string{\"rev-list\", \"--topo-order\", \"-n\", \"1\"}, heads...)...)\n+\tif err != nil {\n+\t\treturn \"\"\n+\t}\n+\tif first, _, _ := strings.Cut(strings.TrimSpace(string(out)), \"\\n\"); governanceFullObjectID.MatchString(first) {\n+\t\treturn first\n+\t}\n+\treturn \"\"\n+}\n+\n func retainedManifestChanged(bundle *ReviewBundle, scope string) string {\n \treturn \"the approval of bundle \" + bundle.BundleID + \" is not retained: the federated manifest of \" + scope + \" changed in a way that bears on its authority\"\n }\ndiff --git a/pose-mcp/internal/pose/review_subject_head_newest_test.go b/pose-mcp/internal/pose/review_subject_head_newest_test.go\nnew file mode 100644\nindex 00000000..96fd5a06\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_subject_head_newest_test.go\n@@ -0,0 +1,35 @@\n+package pose\n+\n+import (\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-review-subject-head-is-the-newest.\n+\n+// R1: of the heads of the change sets of a scope, the subject's head is the newest commit,\n+// whatever the order of the sets (the sort is by id) and whichever of them is last.\n+func TestTheSubjectHeadIsTheNewestHeadOfItsChangeSets(t *testing.T) {\n+\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\"})\n+\tcommit := func(name string) string {\n+\t\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"--allow-empty\", \"-m\", name)\n+\t\treturn strings.TrimSpace(snapshotTestGit(t, root, \"rev-parse\", \"HEAD\"))\n+\t}\n+\tfirst, second, third := commit(\"first\"), commit(\"second\"), commit(\"third\")\n+\ts := Store{Root: root}\n+\tfor _, order := range [][]string{{first, second, third}, {third, first, second}, {second, third, first}} {\n+\t\tvar sets []ChangeSet\n+\t\tfor _, head := range order {\n+\t\t\tsets = append(sets, ChangeSet{ID: \"cs-\" + head[:6], ResolvedHead: head})\n+\t\t}\n+\t\tif got := s.newestResolvedHead(sets); got != third {\n+\t\t\tt.Fatalf(\"order %v: newest = %s, want %s\", order, got, third)\n+\t\t}\n+\t}\n+\tif got := s.newestResolvedHead([]ChangeSet{{ID: \"one\", ResolvedHead: first}, {ID: \"same\", ResolvedHead: first}}); got != \"\" {\n+\t\tt.Fatalf(\"a single distinct head chose %q: there is nothing to choose\", got)\n+\t}\n+\tif got := s.newestResolvedHead([]ChangeSet{{ID: \"a\", ResolvedHead: first}, {ID: \"b\", ResolvedHead: \"0000000000000000000000000000000000000000\"}}); got != \"\" {\n+\t\tt.Fatalf(\"an unknown head was ordered: %q\", got)\n+\t}\n+}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"2bded7f0-10be-4675-8c36-ec50979bb497","timestamp":"2026-11-11T06:16:38.542Z","tool_use_result":{"stdout":"diff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex a4121d4d..355f8f37 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -780,12 +780,18 @@ func (s Store) reviewBundleSubject(scope ScopeRef, components []ReviewPlanCompon\n \tgitlinks := reviewBundleGitlinksIn(s.fsys(), s.Root, uniqueSorted(candidatePaths))\n \t// One status of the tree for the whole subject, taken on first need.\n \tvar status *workingTreeSnapshot\n+\tnewestHead := s.newestResolvedHead(sets)\n \tfor _, set := range sets {\n \t\tsubject.ChangeSets = append(subject.ChangeSets, set.ID)\n \t\tif subject.Base == \"\" {\n \t\t\tsubject.Base = set.ResolvedBase\n \t\t}\n+\t\t// The head of the subject is the newest head of its change sets, not the head of the\n+\t\t// one the sort by id happens to put last (spec pose-review-subject-head-is-the-newest).\n \t\tsubject.Head = set.ResolvedHead\n+\t\tif newestHead != \"\" {\n+\t\t\tsubject.Head = newestHead\n+\t\t}\n \t\tfor _, observed := range set.Paths {\n \t\t\tif observed.Action != \"renamed\" && supersededPaths[observed.Path] {\n \t\t\t\texcluded = append(excluded, ReviewBundleInput{Kind: \"superseded-path\", Path: observed.Path, Reason: \"a later attributed rename supplies the current review subject identity\"})\n@@ -4454,6 +4460,35 @@ func (s Store) sealedDeclarationHolds(bundle *ReviewBundle) bool {\n \treturn sealed == rm.UnreviewedMilestones\n }\n \n+// newestResolvedHead is, of the heads of the change sets, the one no other descends from (the\n+// first commit of the topological order of their histories, which lists a descendant before its\n+// ancestors, so it does not depend on timestamps); empty when\n+// there are fewer than two distinct heads (nothing to choose) or Git cannot order them, in which\n+// case the caller keeps the head of the last set.\n+func (s Store) newestResolvedHead(sets []ChangeSet) string {\n+\tvar heads []string\n+\tseen := map[string]bool{}\n+\tfor _, set := range sets {\n+\t\tif set.ResolvedHead != \"\" && !seen[set.ResolvedHead] {\n+\t\t\tseen[set.ResolvedHead] = true\n+\t\t\theads = append(heads, set.ResolvedHead)\n+\t\t}\n+\t}\n+\tif len(heads) < 2 {\n+\t\treturn \"\"\n+\t}\n+\tfiles := s.fsys()\n+\tproducer := governanceProducerFromFiles(files, \"review\")\n+\tout, err := captureGovernanceGit(files, s.Root, producer, append([]string{\"rev-list\", \"--topo-order\", \"-n\", \"1\"}, heads...)...)\n+\tif err != nil {\n+\t\treturn \"\"\n+\t}\n+\tif first, _, _ := strings.Cut(strings.TrimSpace(string(out)), \"\\n\"); governanceFullObjectID.MatchString(first) {\n+\t\treturn first\n+\t}\n+\treturn \"\"\n+}\n+\n func retainedManifestChanged(bundle *ReviewBundle, scope string) string {\n \treturn \"the approval of bundle \" + bundle.BundleID + \" is not retained: the federated manifest of \" + scope + \" changed in a way that bears on its authority\"\n }\ndiff --git a/pose-mcp/internal/pose/review_subject_head_newest_test.go b/pose-mcp/internal/pose/review_subject_head_newest_test.go\nnew file mode 100644\nindex 00000000..96fd5a06\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_subject_head_newest_test.go\n@@ -0,0 +1,35 @@\n+package pose\n+\n+import (\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-review-subject-head-is-the-newest.\n+\n+// R1: of the heads of the change sets of a scope, the subject's head is the newest commit,\n+// whatever the order of the sets (the sort is by id) and whichever of them is last.\n+func TestTheSubjectHeadIsTheNewestHeadOfItsChangeSets(t *testing.T) {\n+\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\"})\n+\tcommit := func(name string) string {\n+\t\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"--allow-empty\", \"-m\", name)\n+\t\treturn strings.TrimSpace(snapshotTestGit(t, root, \"rev-parse\", \"HEAD\"))\n+\t}\n+\tfirst, second, third := commit(\"first\"), commit(\"second\"), commit(\"third\")\n+\ts := Store{Root: root}\n+\tfor _, order := range [][]string{{first, second, third}, {third, first, second}, {second, third, first}} {\n+\t\tvar sets []ChangeSet\n+\t\tfor _, head := range order {\n+\t\t\tsets = append(sets, ChangeSet{ID: \"cs-\" + head[:6], ResolvedHead: head})\n+\t\t}\n+\t\tif got := s.newestResolvedHead(sets); got != third {\n+\t\t\tt.Fatalf(\"order %v: newest = %s, want %s\", order, got, third)\n+\t\t}\n+\t}\n+\tif got := s.newestResolvedHead([]ChangeSet{{ID: \"one\", ResolvedHead: first}, {ID: \"same\", ResolvedHead: first}}); got != \"\" {\n+\t\tt.Fatalf(\"a single distinct head chose %q: there is nothing to choose\", got)\n+\t}\n+\tif got := s.newestResolvedHead([]ChangeSet{{ID: \"a\", ResolvedHead: first}, {ID: \"b\", ResolvedHead: \"0000000000000000000000000000000000000000\"}}); got != \"\" {\n+\t\tt.Fatalf(\"an unknown head was ordered: %q\", got)\n+\t}\n+}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01L7XFVxaF6FCUiAqJzFYpko","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
