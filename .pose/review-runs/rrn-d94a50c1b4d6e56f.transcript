{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/closeout_adr_associations.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// ADR associations of a roadmap, for the when-justified roadmap rule of the\n     4\t// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n     5\t//\n     6\t// An association is explicit, never inferred from prose:\n     7\t//   - forward: the roadmap's `adrs: [adr:<file>.md]` frontmatter, or a local\n     8\t//     Markdown link from its body to a file in .pose/adr/;\n     9\t//   - backward: an ADR's `roadmaps: [roadmap:<slug>]` (or the qualified\n    10\t//     `xref:<project>/roadmap:<slug>`) frontmatter, or a local Markdown link\n    11\t//     from the ADR to .pose/roadmaps/<slug>.md.\n    12\t//\n    13\t// Only the owning project's .pose/adr/ is inventoried; nothing searches other\n    14\t// projects. A malformed declaration, a link to a missing file or an\n    15\t// incomplete inventory is unknown, which can never prove absence.\n    16\t\n    17\timport (\n    18\t\t\"fmt\"\n    19\t\t\"os\"\n    20\t\t\"path/filepath\"\n    21\t\t\"regexp\"\n    22\t\t\"sort\"\n    23\t\t\"strings\"\n    24\t)\n    25\t\n    26\tconst (\n    27\t\tcloseoutADRInventoryLimit = 4096\n    28\t\tcloseoutADRSizeLimit      = 1 << 20\n    29\t)\n    30\t\n    31\tvar (\n    32\t\t// [text](dest \"title\") and [text](<dest>) inline links.\n    33\t\tmarkdownInlineLinkRE = regexp.MustCompile(`\\]\\(\\s*(<[^>\\n]*>|[^)\\s]+)(?:\\s+(?:\"[^\"]*\"|'[^']*'|\\([^)]*\\)))?\\s*\\)`)\n    34\t\t// [label]: dest \"title\" reference definitions.\n    35\t\tmarkdownReferenceLinkRE = regexp.MustCompile(`(?m)^\\s{0,3}\\[[^\\]\\n]+\\]:\\s*(<[^>\\n]*>|\\S+)`)\n    36\t)\n    37\t\n    38\tfunc (s Store) adrDir() string { return filepath.Join(s.Root, \".pose\", \"adr\") }\n    39\t\n    40\t// markdownLinkDestinations lists the link destinations of a Markdown body,\n    41\t// angle brackets and fragments removed. External URLs are kept out.\n    42\tfunc markdownLinkDestinations(body string) []string {\n    43\t\tout := []string{}\n    44\t\tadd := func(dest string) {\n    45\t\t\tdest = strings.TrimSpace(dest)\n    46\t\t\tdest = strings.TrimSuffix(strings.TrimPrefix(dest, \"<\"), \">\")\n    47\t\t\tif i := strings.IndexAny(dest, \"#?\"); i >= 0 {\n    48\t\t\t\tdest = dest[:i]\n    49\t\t\t}\n    50\t\t\tif dest == \"\" || strings.Contains(dest, \"://\") || strings.HasPrefix(dest, \"mailto:\") || strings.HasPrefix(dest, \"/\") {\n    51\t\t\t\treturn\n    52\t\t\t}\n    53\t\t\tout = append(out, dest)\n    54\t\t}\n    55\t\tfor _, m := range markdownInlineLinkRE.FindAllStringSubmatch(body, -1) {\n    56\t\t\tadd(m[1])\n    57\t\t}\n    58\t\tfor _, m := range markdownReferenceLinkRE.FindAllStringSubmatch(body, -1) {\n    59\t\t\tadd(m[1])\n    60\t\t}\n    61\t\treturn out\n    62\t}\n    63\t\n    64\t// validADRBasename accepts exactly a file name ending in .md directly inside\n    65\t// .pose/adr/: no directory, traversal, hidden file or URI.\n    66\tfunc validADRBasename(name string) bool {\n    67\t\treturn name != \"\" && filepath.Base(name) == name && !strings.ContainsAny(name, `/\\:`) &&\n    68\t\t\t!strings.HasPrefix(name, \".\") && strings.HasSuffix(name, \".md\") && name != \".md\"\n    69\t}\n    70\t\n    71\t// regularADR reports a regular, non-symlinked file of .pose/adr/ within the root.\n    72\tfunc (s Store) regularADR(name string) error {\n    73\t\tpath := filepath.Join(s.adrDir(), name)\n    74\t\tinfo, err := s.fsys().Lstat(path)\n    75\t\tif err != nil {\n    76\t\t\treturn err\n    77\t\t}\n    78\t\tif info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n    79\t\t\treturn fmt.Errorf(\"not a regular file inside .pose/adr\")\n    80\t\t}\n    81\t\treturn nil\n    82\t}\n    83\t\n    84\t// closeoutADRAssociations returns the sorted ADR basenames associated with a\n    85\t// roadmap, and the diagnostics that make the answer unknown.\n    86\tfunc (s Store) closeoutADRAssociations(rm *Roadmap, project string) ([]string, []string) {\n    87\t\tfound := map[string]bool{}\n    88\t\tdiagnostics := []string{}\n    89\t\tif rm.ADRs != \"\" {\n    90\t\t\tvalue := strings.TrimSpace(rm.ADRs)\n    91\t\t\tif !strings.HasPrefix(value, \"[\") || !strings.HasSuffix(value, \"]\") {\n    92\t\t\t\tdiagnostics = append(diagnostics, \"roadmap \"+rm.Slug+\" declares adrs: outside a [list]\")\n    93\t\t\t} else {\n    94\t\t\t\tfor _, item := range parseInlineList(value) {\n    95\t\t\t\t\tname, ok := strings.CutPrefix(item, \"adr:\")\n    96\t\t\t\t\tif !ok || !validADRBasename(name) {\n    97\t\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares %q, not adr:<file>.md\", rm.Slug, item))\n    98\t\t\t\t\t\tcontinue\n    99\t\t\t\t\t}\n   100\t\t\t\t\tif err := s.regularADR(name); err != nil {\n   101\t\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares adr:%s, which cannot be read: %v\", rm.Slug, name, err))\n   102\t\t\t\t\t\tcontinue\n   103\t\t\t\t\t}\n   104\t\t\t\t\tfound[name] = true\n   105\t\t\t\t}\n   106\t\t\t}\n   107\t\t}\n   108\t\tbody := rm.Body\n   109\t\tif body == \"\" {\n   110\t\t\tif full, err := s.GetRoadmap(rm.Slug); err == nil {\n   111\t\t\t\tbody = full.Body\n   112\t\t\t}\n   113\t\t}\n   114\t\troadmapDir := filepath.Dir(rm.Path)\n   115\t\tfor _, dest := range markdownLinkDestinations(body) {\n   116\t\t\ttarget := filepath.Clean(filepath.Join(roadmapDir, filepath.FromSlash(dest)))\n   117\t\t\tif filepath.Dir(target) != filepath.Clean(s.adrDir()) || !strings.HasSuffix(target, \".md\") {\n   118\t\t\t\tcontinue\n   119\t\t\t}\n   120\t\t\tname := filepath.Base(target)\n   121\t\t\tif err := s.regularADR(name); err != nil {\n   122\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, which cannot be read: %v\", rm.Slug, dest, err))\n   123\t\t\t\tcontinue\n   124\t\t\t}\n   125\t\t\tfound[name] = true\n   126\t\t}\n   127\t\tentries, err := s.fsys().ReadDir(s.adrDir())\n   128\t\tif err != nil && !os.IsNotExist(err) {\n   129\t\t\tdiagnostics = append(diagnostics, \"the ADR inventory could not be read: \"+err.Error())\n   130\t\t}\n   131\t\tif len(entries) > closeoutADRInventoryLimit {\n   132\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"the ADR inventory has %d entries, above the limit of %d\", len(entries), closeoutADRInventoryLimit))\n   133\t\t\tentries = nil\n   134\t\t}\n   135\t\troadmapPath := filepath.Clean(filepath.Join(s.roadmapsDir(), rm.Slug+\".md\"))\n   136\t\tfor _, entry := range entries {\n   137\t\t\tname := entry.Name()\n   138\t\t\t// An ADR already associated is read like any other: its size, its\n   139\t\t\t// readability and its own declaration are inputs too.\n   140\t\t\tif entry.IsDir() || !strings.HasSuffix(name, \".md\") || strings.EqualFold(name, \"README.md\") {\n   141\t\t\t\tcontinue\n   142\t\t\t}\n   143\t\t\tif err := s.regularADR(name); err != nil {\n   144\t\t\t\tif found[name] {\n   145\t\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is associated but is not a regular file of .pose/adr\")\n   146\t\t\t\t}\n   147\t\t\t\tcontinue // not an ADR record this inventory reads; a link to it is judged above\n   148\t\t\t}\n   149\t\t\tpath := filepath.Join(s.adrDir(), name)\n   150\t\t\tif info, err := s.fsys().Lstat(path); err != nil || info.Size() > closeoutADRSizeLimit {\n   151\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is unreadable or above the size limit\")\n   152\t\t\t\tcontinue\n   153\t\t\t}\n   154\t\t\traw, err := s.fsys().ReadFile(path)\n   155\t\t\tif err != nil {\n   156\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" could not be read: \"+err.Error())\n   157\t\t\t\tcontinue\n   158\t\t\t}\n   159\t\t\tfm, adrBody := SplitFrontmatter(string(raw))\n   160\t\t\tif declared, ok := fm[\"roadmaps\"]; ok {\n   161\t\t\t\tvalue := strings.TrimSpace(declared)\n   162\t\t\t\tif !strings.HasPrefix(value, \"[\") || !strings.HasSuffix(value, \"]\") {\n   163\t\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" declares roadmaps: outside a [list]\")\n   164\t\t\t\t} else {\n   165\t\t\t\t\tfor _, item := range parseInlineList(value) {\n   166\t\t\t\t\t\tref, err := ParseArtifactRef(item)\n   167\t\t\t\t\t\tif err != nil || ref.Kind != \"roadmap\" || ref.Milestone != \"\" {\n   168\t\t\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %q, not roadmap:<slug>\", name, item))\n   169\t\t\t\t\t\t\tcontinue\n   170\t\t\t\t\t\t}\n   171\t\t\t\t\t\tif ref.Slug == rm.Slug && (ref.Project == \"\" || ref.Project == project) {\n   172\t\t\t\t\t\t\tfound[name] = true\n   173\t\t\t\t\t\t}\n   174\t\t\t\t\t}\n   175\t\t\t\t}\n   176\t\t\t}\n   177\t\t\tfor _, dest := range markdownLinkDestinations(adrBody) {\n   178\t\t\t\tif filepath.Clean(filepath.Join(s.adrDir(), filepath.FromSlash(dest))) == roadmapPath {\n   179\t\t\t\t\tfound[name] = true\n   180\t\t\t\t}\n   181\t\t\t}\n   182\t\t}\n   183\t\tadrs := make([]string, 0, len(found))\n   184\t\tfor name := range found {\n   185\t\t\tadrs = append(adrs, name)\n   186\t\t}\n   187\t\tsort.Strings(adrs)\n   188\t\tsort.Strings(diagnostics)\n   189\t\treturn adrs, diagnostics\n   190\t}\n","exit_code":0,"status":"completed"}}
