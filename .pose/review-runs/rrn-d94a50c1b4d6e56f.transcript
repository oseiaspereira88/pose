{"type":"item.completed","item":{"id":"item_86","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/cli/adopt.go'","aggregated_output":"     1\tpackage cli\n     2\t\n     3\t// pose adopt — decide a capability from the catalog: turn it on or off, or\n     4\t// record that this project declined or deferred it (specs\n     5\t// pose-governed-capabilities-default-on-new-instances, pose-capability-catalog).\n     6\t// A new instance adopts the catalog's defaults at install; an existing one\n     7\t// decides each capability here, without knowing which policy keys, dates,\n     8\t// overlays or schema versions go together.\n     9\t\n    10\timport (\n    11\t\t\"errors\"\n    12\t\t\"fmt\"\n    13\t\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n    14\t\t\"io\"\n    15\t\t\"strings\"\n    16\t\t\"time\"\n    17\t\n    18\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    19\t\t\"github.com/harne8/pose-mcp/internal/version\"\n    20\t)\n    21\t\n    22\tconst adoptUsage = \"Usage: pose adopt --list [--json] | pose adopt <capability> [--off | --decline --reason <text> | --defer --reason <text>] [--date YYYY-MM-DD] [--issuer <name>] [--apply] | pose adopt closeout-review-policy --milestone-review-required <never|when-justified|always> --roadmap-review-required <never|when-justified|always> [--apply] | pose adopt --request <act-id> [--issuer <name>] [--reason <text>] [--apply]\"\n    23\t\n    24\tfunc cmdAdopt(root string, args []string, stdout, stderr io.Writer) int {\n    25\t\tid, mode, reason, apply, list, jsonOutput, requestID, issuer := \"\", \"on\", \"\", false, false, false, \"\", \"\"\n    26\t\tmilestoneReview, roadmapReview, closeoutPairGiven := \"\", \"\", false\n    27\t\tdate := time.Now().UTC().Format(time.DateOnly)\n    28\t\tfor i := 0; i < len(args); i++ {\n    29\t\t\tswitch args[i] {\n    30\t\t\tcase \"--list\":\n    31\t\t\t\tlist = true\n    32\t\t\tcase \"--json\":\n    33\t\t\t\tjsonOutput = true\n    34\t\t\tcase \"--off\":\n    35\t\t\t\tmode = \"off\"\n    36\t\t\tcase \"--decline\":\n    37\t\t\t\tmode = posemodel.AdoptionDeclined\n    38\t\t\tcase \"--defer\":\n    39\t\t\t\tmode = posemodel.AdoptionDeferred\n    40\t\t\tcase \"--apply\":\n    41\t\t\t\tapply = true\n    42\t\t\tcase \"--milestone-review-required\", \"--roadmap-review-required\":\n    43\t\t\t\tif i+1 >= len(args) {\n    44\t\t\t\t\treturn usageError(stderr, adoptUsage)\n    45\t\t\t\t}\n    46\t\t\t\tif args[i] == \"--milestone-review-required\" {\n    47\t\t\t\t\tmilestoneReview = args[i+1]\n    48\t\t\t\t} else {\n    49\t\t\t\t\troadmapReview = args[i+1]\n    50\t\t\t\t}\n    51\t\t\t\tcloseoutPairGiven = true\n    52\t\t\t\ti++\n    53\t\t\tcase \"--date\", \"--reason\", \"--request\", \"--issuer\":\n    54\t\t\t\tif i+1 >= len(args) {\n    55\t\t\t\t\treturn usageError(stderr, adoptUsage)\n    56\t\t\t\t}\n    57\t\t\t\tswitch args[i] {\n    58\t\t\t\tcase \"--date\":\n    59\t\t\t\t\tdate = args[i+1]\n    60\t\t\t\tcase \"--reason\":\n    61\t\t\t\t\treason = args[i+1]\n    62\t\t\t\tcase \"--issuer\":\n    63\t\t\t\t\tissuer = args[i+1]\n    64\t\t\t\tdefault:\n    65\t\t\t\t\trequestID = args[i+1]\n    66\t\t\t\t}\n    67\t\t\t\ti++\n    68\t\t\tdefault:\n    69\t\t\t\tif strings.HasPrefix(args[i], \"--\") || id != \"\" {\n    70\t\t\t\t\treturn usageError(stderr, adoptUsage)\n    71\t\t\t\t}\n    72\t\t\t\tid = args[i]\n    73\t\t\t}\n    74\t\t}\n    75\t\tout := render(stdout, stderr)\n    76\t\tif list {\n    77\t\t\tstates, err := posemodel.CapabilityStates(root)\n    78\t\t\tif err != nil {\n    79\t\t\t\tout.Failure(\"pose adopt: \" + err.Error())\n    80\t\t\t\treturn 1\n    81\t\t\t}\n    82\t\t\tif jsonOutput {\n    83\t\t\t\treturn writeJSON(stdout, states)\n    84\t\t\t}\n    85\t\t\tfor _, state := range states {\n    86\t\t\t\tline := fmt.Sprintf(\"%s — %s (since %s\", state.State, state.Effect, state.IntroducedIn)\n    87\t\t\t\tif state.DefaultForNew {\n    88\t\t\t\t\tline += \", on in new instances\"\n    89\t\t\t\t}\n    90\t\t\t\tline += \")\"\n    91\t\t\t\tif state.Missing != \"\" {\n    92\t\t\t\t\tline += \"; \" + state.Missing\n    93\t\t\t\t}\n    94\t\t\t\tif state.Decision != nil {\n    95\t\t\t\t\tline += fmt.Sprintf(\"; %s on %s: %s\", state.Decision.Decision, state.Decision.Date, state.Decision.Reason)\n    96\t\t\t\t}\n    97\t\t\t\tout.Field(\"adopt.\"+state.ID, line)\n    98\t\t\t}\n    99\t\t\treturn 0\n   100\t\t}\n   101\t\tif requestID != \"\" {\n   102\t\t\t// An answered configuration-review request decides the capability\n   103\t\t\t// it asked about (spec pose-update-configuration-review).\n   104\t\t\tif id != \"\" || mode != \"on\" {\n   105\t\t\t\treturn usageError(stderr, adoptUsage)\n   106\t\t\t}\n   107\t\t\treq, err := loadReviewRequest(root, requestID)\n   108\t\t\tif err != nil {\n   109\t\t\t\tout.Failure(\"pose adopt: \" + err.Error())\n   110\t\t\t\treturn 1\n   111\t\t\t}\n   112\t\t\tout.Field(\"adopt.request\", requestID)\n   113\t\t\tout.Field(\"adopt.capability\", req.Capability)\n   114\t\t\tout.Field(\"adopt.answer\", req.View.Answer+\" by \"+req.View.AnsweredBy+\" (\"+req.View.Assurance+\")\")\n   115\t\t\tif reviewAnswerApplied(root, req) {\n   116\t\t\t\tout.Field(\"adopt.result\", \"already applied; nothing to change\")\n   117\t\t\t\treturn 0\n   118\t\t\t}\n   119\t\t\t// The preview of an answered request shows what applying it does,\n   120\t\t\t// sealing included, as the direct path does (found in review by\n   121\t\t\t// agent:gpt-6.1-sol).\n   122\t\t\tif req.View.Answer == reviewAnswerAdopt {\n   123\t\t\t\teffects, err := posemodel.PlanAdoptionEffects(root, req.Capability, issuer, time.Now())\n   124\t\t\t\tif err != nil {\n   125\t\t\t\t\tout.Failure(\"pose adopt: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   126\t\t\t\t\treturn 1\n   127\t\t\t\t}\n   128\t\t\t\tfor _, effect := range effects {\n   129\t\t\t\t\tout.Field(\"adopt.change\", effect.Description)\n   130\t\t\t\t}\n   131\t\t\t}\n   132\t\t\tout.Field(\"adopt.apply\", boolString(apply))\n   133\t\t\tif !apply {\n   134\t\t\t\treturn 0\n   135\t\t\t}\n   136\t\t\tresult, err := applyReviewAnswer(root, req, date, issuer, reason)\n   137\t\t\tif err != nil {\n   138\t\t\t\tout.Failure(\"pose adopt: \" + err.Error())\n   139\t\t\t\treturn 1\n   140\t\t\t}\n   141\t\t\tout.Field(\"adopt.result\", result)\n   142\t\t\treturn 0\n   143\t\t}\n   144\t\tif id == \"\" {\n   145\t\t\treturn usageError(stderr, adoptUsage)\n   146\t\t}\n   147\t\t// The closeout review pair is set together, only for its own capability,\n   148\t\t// and only to turn it on or change it (spec\n   149\t\t// pose-closeout-review-policy-by-cost-benefit R6).\n   150\t\tif closeoutPairGiven && (id != \"closeout-review-policy\" || mode != \"on\" || milestoneReview == \"\" || roadmapReview == \"\") {\n   151\t\t\tout.Failure(\"pose adopt: --milestone-review-required and --roadmap-review-required go together, with closeout-review-policy, without --off, --decline or --defer\")\n   152\t\t\treturn 2\n   153\t\t}\n   154\t\tentry, known := posemodel.LookupCatalogEntry(id)\n   155\t\tif !known {\n   156\t\t\tout.Failure(\"pose adopt: unknown capability \" + id + \"; governed capabilities: \" + strings.Join(posemodel.CatalogIDs(), \", \"))\n   157\t\t\treturn 2\n   158\t\t}\n   159\t\tif _, err := time.Parse(time.DateOnly, date); err != nil {\n   160\t\t\tout.Failure(\"pose adopt: --date must be YYYY-MM-DD, got \" + date)\n   161\t\t\treturn 2\n   162\t\t}\n   163\t\tdocs, err := posemodel.LoadPolicyDocs(root)\n   164\t\tif err != nil {\n   165\t\t\tout.Failure(\"pose adopt: \" + err.Error())\n   166\t\t\treturn 1\n   167\t\t}\n   168\t\tout.Field(\"adopt.capability\", entry.ID+\" — \"+entry.Effect)\n   169\t\tout.Field(\"adopt.action\", mode)\n   170\t\n   171\t\tif mode == posemodel.AdoptionDeclined || mode == posemodel.AdoptionDeferred {\n   172\t\t\tif entry.Adopted(docs) {\n   173\t\t\t\tout.Failure(\"pose adopt: \" + entry.ID + \" is on; turn it off with `pose adopt \" + entry.ID + \" --off --apply` before recording that it was \" + mode)\n   174\t\t\t\treturn 1\n   175\t\t\t}\n   176\t\t\tif strings.TrimSpace(reason) == \"\" {\n   177\t\t\t\tflag := map[string]string{posemodel.AdoptionDeclined: \"--decline\", posemodel.AdoptionDeferred: \"--defer\"}[mode]\n   178\t\t\t\tout.Failure(\"pose adopt: \" + flag + \" needs --reason, so the decision can be revisited\")\n   179\t\t\t\treturn 2\n   180\t\t\t}\n   181\t\t\tout.Field(\"adopt.change\", \"record \"+entry.ID+\" as \"+mode+\" on \"+date+\": \"+reason)\n   182\t\t\tout.Field(\"adopt.apply\", boolString(apply))\n   183\t\t\tif !apply {\n   184\t\t\t\treturn 0\n   185\t\t\t}\n   186\t\t\tif err := posemodel.RecordAdoptionDecisionFor(root, entry.ID, posemodel.AdoptionDecision{Decision: mode, Reason: reason, Date: date, Version: version.ReleaseBase()}); err != nil {\n   187\t\t\t\tout.Failure(\"pose adopt: \" + err.Error())\n   188\t\t\t\treturn 1\n   189\t\t\t}\n   190\t\t\tadvanceReviewedVersion(root)\n   191\t\t\treturn 0\n   192\t\t}\n   193\t\n   194\t\tvar changes []string\n   195\t\tif mode == \"off\" {\n   196\t\t\tif blocker := posemodel.CatalogRetireBlocker(docs, entry); blocker != \"\" {\n   197\t\t\t\tout.Failure(\"pose adopt: \" + blocker)\n   198\t\t\t\treturn 1\n   199\t\t\t}\n   200\t\t\tchanges = entry.Retire(docs)\n   201\t\t} else {\n   202\t\t\tif !entry.Adopted(docs) {\n   203\t\t\t\tif blocker := posemodel.CatalogAdoptBlocker(root, docs, entry); blocker != \"\" {\n   204\t\t\t\t\tout.Failure(\"pose adopt: \" + blocker)\n   205\t\t\t\t\treturn 1\n   206\t\t\t\t}\n   207\t\t\t}\n   208\t\t\tif id == \"closeout-review-policy\" {\n   209\t\t\t\t// Preview shows the rule applied today next to the one proposed.\n   210\t\t\t\t_, milestoneNow, roadmapNow := posemodel.CloseoutReviewPolicyEffective(docs)\n   211\t\t\t\tout.Field(\"adopt.current\", posemodel.MilestoneReviewRequiredKey+\"=\"+milestoneNow+\"; \"+posemodel.RoadmapReviewRequiredKey+\"=\"+roadmapNow)\n   212\t\t\t}\n   213\t\t\tif closeoutPairGiven {\n   214\t\t\t\tpair, err := posemodel.SetCloseoutReviewPolicy(docs, milestoneReview, roadmapReview)\n   215\t\t\t\tif err != nil {\n   216\t\t\t\t\tout.Failure(\"pose adopt: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   217\t\t\t\t\treturn 2\n   218\t\t\t\t}\n   219\t\t\t\tchanges = pair\n   220\t\t\t} else {\n   221\t\t\t\tchanges = entry.Adopt(docs, date)\n   222\t\t\t}\n   223\t\t}\n   224\t\tvar effects []posemodel.AdoptionEffect\n   225\t\tif mode == \"on\" && len(changes) > 0 {\n   226\t\t\tplanned, err := posemodel.PlanAdoptionEffects(root, entry.ID, issuer, time.Now())\n   227\t\t\tif err != nil {\n   228\t\t\t\tout.Failure(\"pose adopt: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   229\t\t\t\treturn 1\n   230\t\t\t}\n   231\t\t\teffects = planned\n   232\t\t}\n   233\t\tif len(changes) == 0 {\n   234\t\t\tif mode == \"off\" {\n   235\t\t\t\tout.Field(\"adopt.result\", entry.ID+\" is not adopted; nothing to change\")\n   236\t\t\t} else {\n   237\t\t\t\tout.Field(\"adopt.result\", entry.ID+\" is already adopted; its date is kept, so nothing is re-judged\")\n   238\t\t\t}\n   239\t\t\treturn 0\n   240\t\t}\n   241\t\tfor _, change := range changes {\n   242\t\t\tout.Field(\"adopt.change\", change)\n   243\t\t}\n   244\t\tfor _, effect := range effects {\n   245\t\t\tout.Field(\"adopt.change\", effect.Description)\n   246\t\t}\n   247\t\t// The readers decide, before anything is written: a policy they would\n   248\t\t// refuse is never left behind.\n   249\t\tif _, _, _, _, err := docs.Rendered(posemodel.Store{Root: root}); err != nil {\n   250\t\t\tout.Failure(\"pose adopt: the resulting policy would be refused: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   251\t\t\treturn 1\n   252\t\t}\n   253\t\tout.Field(\"adopt.apply\", boolString(apply))\n   254\t\tif !apply {\n   255\t\t\treturn 0\n   256\t\t}\n   257\t\tfor _, effect := range effects {\n   258\t\t\tif err := effect.Apply(); err != nil {\n   259\t\t\t\tout.Failure(\"pose adopt: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   260\t\t\t\treturn 1\n   261\t\t\t}\n   262\t\t}\n   263\t\tif err := policyPublished(docs.Write(root, posemodel.Store{Root: root}), stderr); err != nil {\n   264\t\t\tout.Failure(\"pose adopt: \" + err.Error())\n   265\t\t\treturn 1\n   266\t\t}\n   267\t\tif mode == \"on\" {\n   268\t\t\t_ = posemodel.ClearAdoptionDecision(root, entry.ID)\n   269\t\t}\n   270\t\tadvanceReviewedVersion(root)\n   271\t\treturn 0\n   272\t}\n   273\t\n   274\t// adoptGovernedCapabilitiesAtInstall adopts every capability the catalog turns\n   275\t// on for a new instance, dated today, in a review policy this install has just\n   276\t// created. It is never called for a policy that existed before the install,\n   277\t// and never by `pose update`: an instance already under way decides when.\n   278\tfunc adoptGovernedCapabilitiesAtInstallIn(files posemodel.Files, target string, now time.Time, log func(english, portuguese string, a ...any)) {\n   279\t\tdocs, err := posemodel.LoadPolicyDocsIn(files, target)\n   280\t\tif err != nil {\n   281\t\t\treturn\n   282\t\t}\n   283\t\tdate := now.UTC().Format(time.DateOnly)\n   284\t\t// A new instance has reviewed this engine's catalog by adopting its\n   285\t\t// defaults; only what a later engine introduces is new to it.\n   286\t\t_ = posemodel.SetReviewedVersionIn(files, target, version.ReleaseBase())\n   287\t\tadopted := []string{}\n   288\t\tfor _, entry := range posemodel.CapabilityCatalog() {\n   289\t\t\tif !entry.DefaultForNew || entry.Adopted(docs) {\n   290\t\t\t\tcontinue\n   291\t\t\t}\n   292\t\t\tif posemodel.CatalogAdoptBlockerIn(files, target, docs, entry) != \"\" {\n   293\t\t\t\tcontinue\n   294\t\t\t}\n   295\t\t\tif len(entry.Adopt(docs, date)) > 0 {\n   296\t\t\t\tadopted = append(adopted, entry.ID)\n   297\t\t\t}\n   298\t\t}\n   299\t\tif len(adopted) == 0 {\n   300\t\t\treturn\n   301\t\t}\n   302\t\terr = docs.Write(target, posemodel.Store{Root: target, FS: files})\n   303\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n   304\t\t\tlog(\"warning: governed capabilities adopted, with durability unconfirmed: %v\", \"aviso: capacidades governadas adotadas, sem durabilidade confirmada: %v\", err)\n   305\t\t} else if err != nil {\n   306\t\t\tlog(\"warning: governed capabilities not adopted, the policy would be refused: %v\", \"aviso: capacidades governadas não adotadas, a política seria recusada: %v\", err)\n   307\t\t\treturn\n   308\t\t}\n   309\t\tfor _, id := range adopted {\n   310\t\t\tlog(\"capability (adoption): %s from %s — `pose adopt %s --off --apply` turns it off\", \"capacidade (adoção): %s desde %s — `pose adopt %s --off --apply` desliga\", id, date, id)\n   311\t\t}\n   312\t}\n   313\t\n   314\t// adoptGovernedCapabilitiesAtInstall reads and writes the filesystem directly; adoptGovernedCapabilitiesAtInstallIn takes the\n   315\t// operation's files.\n   316\tfunc adoptGovernedCapabilitiesAtInstall(target string, now time.Time, log func(english, portuguese string, a ...any)) {\n   317\t\tadoptGovernedCapabilitiesAtInstallIn(posemodel.NativeFiles(), target, now, log)\n   318\t}\n   319\t\n   320\t// policyPublished reads a policy write: a publication with its durability unconfirmed took\n   321\t// effect, so it is a warning here and the caller goes on to report what it did.\n   322\tfunc policyPublished(err error, stderr io.Writer) error {\n   323\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n   324\t\t\trender(stderr, stderr).Finding(cliout.Finding{State: cliout.StateWarning, Code: \"policy-durability\", Message: err.Error()})\n   325\t\t\treturn nil\n   326\t\t}\n   327\t\treturn err\n   328\t}\n   329\t\n   330\tfunc boolString(value bool) string {\n   331\t\tif value {\n   332\t\t\treturn \"true\"\n   333\t\t}\n   334\t\treturn \"false\"\n   335\t}\n","exit_code":0,"status":"completed"}}
