{"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1420,1445p' pose-mcp/internal/pose/review_closeout.go\"","aggregated_output":"\t\tfor _, milestone := range rm.Milestones {\n\t\t\td, err := s.ScopeDigest(\"milestone:\" + rm.Slug + \"/\" + milestone.ID)\n\t\t\tif err != nil {\n\t\t\t\treturn \"\", err\n\t\t\t}\n\t\t\tchildren[milestone.ID] = d\n\t\t}\n\t\tbase[\"content\"] = strings.ReplaceAll(strings.TrimSpace(rm.Body), \"\\r\\n\", \"\\n\")\n\t\tbase[\"children\"] = children\n\t\tif rm.UnreviewedMilestones != \"\" {\n\t\t\tbase[\"unreviewed_milestones\"] = rm.UnreviewedMilestones\n\t\t}\n\t}\n\treturn digestJSON(base)\n}\n\nfunc roadmapMilestoneSection(body, id string) string {\n\tstart := \"## Milestone: \" + id\n\tidx := strings.Index(body, start)\n\tif idx < 0 {\n\t\treturn \"\"\n\t}\n\trest := body[idx:]\n\tif next := strings.Index(rest[len(start):], \"\\n## Milestone: \"); next >= 0 {\n\t\treturn strings.TrimSpace(rest[:len(start)+next])\n\t}\n","exit_code":0,"status":"completed"}}
