s 0.0s\n  -> audit-pure-git-integration go test ./internal/pose -run TestOnlyReadsThatCannotDependOnMutableStateAreClassifiedPure|TestTheFinalAuditSkipsPureReads|GovernanceReadViewGit -count=1\n  <- audit-pure-git-integration pass 0.0s\n  -> index-input-binding-integration go test ./internal/pose -run TestAnOperationReadsTheTransferPlans -count=1\n  <- index-input-binding-integration pass 0.0s\n  -> optional-worktree-runtime-integration go test -race ./internal/worktreeruntime ./internal/cli -run TheIdentityNamesTheWorktree|TheEndpointIsProtected|TheLifecycleDrains|WithNoRuntimeTheClient|TestRuntimeCommands|ConcurrentStartsLeaveOne|AStopAcceptsNothing|RuntimeThatOutlives|AStopReports -count=1\n  <- optional-worktree-runtime-integration pass 0.0s\n  -> claude-sandboxed-profile-integration go test -race ./internal/pose ./internal/cli -run TestTheClaudeAgentDeclaresASandboxedProfile|TestTheSandboxedProfile|TestTheDelegationPolicyReports|TestDelegateAgentsAndDoctorSay -count=1\n  <- claude-sandboxed-profile-integration pass 0.0s\n  -> delegate-picker-integration go test -race ./internal/cli -run TestThePickerPreview|TestTheStateGlyph|TestDelegateWatchPicksARun -count=1\n  <- delegate-picker-integration pass 0.0s\n  -> review-brief-templates-are-immutable-integration go test -race ./internal/pose -run TestEveryReviewBriefTemplateVersion|TestTheDigestSeesEverySectionOfEveryVariant -count=1\n  <- review-brief-templates-are-immutable-integration pass 0.0s\n  -> delegated-approval-survives-routine-drift-integration go test -race ./internal/pose -run ADelegatedApproval|ARetainedDelegatedApproval|TheAssuranceOfARetained|ConcludeReviewRunRecordsTheAttestation -count=1\n  <- delegated-approval-survives-routine-drift-integration pass 0.0s\n  -> help-lists-every-command-integration go test -race ./internal/cli -run TestPoseHelp|TestTheManualsDocumentEveryCommand|TestTheHelpReaderIgnores -count=1\n  <- help-lists-every-command-integration pass 0.0s\n  -> review-brief-conclusion-rules-integration go test -race ./internal/pose -run TheBriefStatesEveryRule|EveryMessageThePreflight|TheBriefOfALaterRound|AnEarlierConclusionBrief|ReviewBriefIsRenderedFromTheBundle|TheClaudeReviewerProfile -count=1\n  <- review-brief-conclusion-rules-integration pass 0.0s\n  -> done-spec-keeps-its-sealed-plan-integration go test -race ./internal/pose ./internal/cli -run ADoneSpecSealed|AnOpenSpecStillOwes|TheSpecAnswersForTheExitGate|EachExitGateHasItsOwnCriterion|AStopOnAnUnknownView|EveryOtherStopStillRecords|TheStopOnUnstableInputs|AStopWhoseCheckpoint|UnreadableSealedHistory -count=1\n  <- done-spec-keeps-its-sealed-plan-integration pass 0.0s\n  -> common-domain-and-cli-mcp-handoff-integration go test -race ./internal/pose ./internal/cli ./internal/mcpserver -run InProcessRun|CloseoutHandoff|AHandoff|NoHandoff|PendingJudgment|InProcessWrapper|EveryMCPRoute|OnlyAdmitted|ReadOnlyWrappers|KeepTheProcessBoundary|TypedHandoff|StableAndADone|TheMCPPlanIsTheDomainPlan|AdmittedWritesAreExactly|Golden|BlockedOrUnstable|TheDigestOfAHandoff|ACancelledCaller|ACompletionThat|AbandonedRuns|NotTakenWhenTheSpawn|APanicInAnInProcess|APendingMechanicalStep|TheHandoffKeepsTheSelectedProject|TheHandoffOverMCP -count=1\n  <- common-domain-and-cli-mcp-handoff-integration pass 0.0s\n  -> generation-bound-query-cursors-integration go test ./internal/pose ./internal/mcpserver -run PageByGeneration|ACursor|HostileCursor|ExpiredCursor|APositionOutside|AContinuation|AnIssuedCursor|EveryPage|PageLimitIsBounded|EquivalentFilters|APageStates|APageCarries|PageCost|DoesNotReverify|SymlinkTarget|PreservesSizeAndModTime|NullCursor|FiltersThatSerialize|ACursorAlias|OmittedSort|AnAlias|AnExplicit|Pagination|ListToolsShareThePaginationSchema -count=1\n  <- generation-bound-query-cursors-integration pass 0.0s\n[module] scripts (contract, mode=strict)\n[module] tests (contract, mode=strict)\n[time] wall 580.0s, checks 2591.3s, jobs 7\n[time] 580.0s pose-mcp/test\n[time] 197.2s pose-mcp/delegation-surf