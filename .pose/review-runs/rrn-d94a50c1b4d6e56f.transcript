s-v2.md\n.pose/specs/2026-11-10-pose-sealed-checkout-does-not-require-later-child-evidence.md\n.pose/specs/2026-10-13-pose-policy-scope-validation.md\n.pose/specs/2026-08-15-pose-domain-rule-extension-migration.md\n.pose/specs/2026-10-30-pose-validation-matrix-dead-test-patterns.amendments.jsonl\n.pose/specs/2026-08-07-pose-compat-gate-candidate-integrity.md\n.pose/specs/2026-10-06-pose-project-binding-consistency.md\n.pose/specs/2026-10-13-pose-delegated-adapter-containment.md\n.pose/specs/2026-09-10-pose-only-the-signing-gate-is-read-live.md\n.pose/specs/2026-09-08-pose-diagnose-invisible-governance-failures.md\n.pose/specs/2026-09-29-project-id-from-any-directory-name.md\n.pose/specs/2026-09-09-pose-release-boundary-rehearsal.md\n.pose/specs/2026-09-09-pose-policy-keys-and-release-surface-coverage.md\n.pose/specs/2026-08-16-pose-derived-index-self-referential-leak.md\n.pose/specs/2026-07-18-pose-public-install-contract.md\n.pose/specs/2026-09-06-pose-readme-evaluation-path.md\n.pose/specs/2026-10-26-pose-delegation-task.md\n.pose/specs/2026-10-14-pose-optional-worktree-runtime.md\n.pose/specs/2026-10-13-pose-action-target-and-node-scoping.md\n.pose/specs/2026-10-13-pose-generation-bound-query-cursors.md\n.pose/specs/2026-10-05-pose-atomic-start-adoption-cutoff.md\n.pose/specs/2026-10-10-pose-ci-avoids-anonymous-rate-limits.md\n.pose/specs/2026-09-19-pose-abm-progressive-review.md\n.pose/specs/2026-10-31-pose-review-approval-follows-children.md\n.pose/specs/2026-10-13-pose-consolidation-batch-6-authoring.md\n.pose/specs/2026-07-18-pose-monorepo-validation-recipes.md\n.pose/specs/2026-09-26-pose-review-bundle-classifies-transfer-records.md\n.pose/specs/2026-10-30-pose-delegation-marker-stop-joins-heartbeat.amendments.jsonl\n.pose/specs/2026-10-13-pose-governance-operation-performance.md\n.pose/specs/2026-11-10-pose-delegated-output-redaction-root-cause.md\n.pose/specs/2026-10-14-pose-consolidation-batch-14-authoring.md\n.pose/specs/2026-09-11-pose-usage-findings-ad