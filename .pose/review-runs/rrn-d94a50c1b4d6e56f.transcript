{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '3525,3630p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"// or in a legacy attempt.\nfunc (s Store) milestoneReviewRefused(scope string) bool {\n\tif bundle, _ := s.latestNegativeReview(scope); bundle != nil {\n\t\treturn true\n\t}\n\tattempts, err := s.ReadReviewAttempts(scope)\n\tif err != nil || !attempts.Coverage.CompleteFor(scope) {\n\t\treturn true\n\t}\n\tif len(attempts.Attempts) == 0 {\n\t\treturn false\n\t}\n\tlatest := attempts.Attempts[len(attempts.Attempts)-1]\n\treturn latest.Decision == \"rejected\" || latest.Decision == \"changes-requested\"\n}\n\nfunc (s Store) computeReviewVerification(scope string) (ReviewBundleVerification, error) {\n\tpolicy, err := s.GetReviewPolicy()\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n\tscopeRef, scopeErr := ParseScopeRef(scope)\n\tif scopeErr != nil {\n\t\treturn ReviewBundleVerification{}, scopeErr\n\t}\n\n\tbundlesRead, err := s.ReadReviewBundles(scope)\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n\tbundles := bundlesRead.Bundles\n\n\tif (policy.SchemaVersion < ReviewPolicySchemaVersion || !policy.ReviewBundles) && len(bundles) == 0 {\n\t\teval, evalErr := s.ReviewCheck(scope)\n\t\tif evalErr != nil {\n\t\t\treturn ReviewBundleVerification{}, evalErr\n\t\t}\n\t\tverification := ReviewBundleVerification{\n\t\t\tScope:    scope,\n\t\t\tState:    \"needs-review\",\n\t\t\tFresh:    eval.Fresh,\n\t\t\tApproved: eval.Approved,\n\t\t\tWarnings: append([]string{}, eval.Warnings...),\n\t\t\tBlockers: append([]string{}, eval.Blockers...),\n\t\t}\n\t\tif eval.Current != nil {\n\t\t\tverification.NextAction = \"record fresh review for \" + scope\n\t\t\tif eval.Current.Decision == \"changes-requested\" || eval.Current.Decision == \"rejected\" {\n\t\t\t\tverification.State = eval.Current.Decision\n\t\t\t} else if !eval.Fresh {\n\t\t\t\tverification.State = \"superseded\"\n\t\t\t}\n\t\t} else {\n\t\t\tverification.NextAction = \"record review for \" + scope\n\t\t}\n\t\tif eval.Approved && eval.Fresh {\n\t\t\tdone, doneErr := s.scopeLifecycleDone(scopeRef)\n\t\t\tif doneErr == nil && done {\n\t\t\t\tverification.State = \"closed\"\n\t\t\t\tverification.NextAction = \"scope is closed with an approved review\"\n\t\t\t} else {\n\t\t\t\tverification.State = \"ready-to-close\"\n\t\t\t\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope\n\t\t\t}\n\t\t}\n\t\tverification.Blockers = uniqueSorted(verification.Blockers)\n\t\tverification.Warnings = uniqueSorted(verification.Warnings)\n\t\treturn verification, nil\n\t}\n\n\tprepared, err := s.PrepareReviewBundle(scope)\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n\tverification := ReviewBundleVerification{Scope: scope, State: \"needs-validation\", Fresh: false, Approved: false, Warnings: append([]string{}, prepared.Warnings...), Blockers: append([]string{}, prepared.Blockers...), currentManifest: prepared.Payload.FederatedManifest}\n\tif bundleLosses := bundlesRead.Coverage.LossesFor(scope); len(bundleLosses) > 0 {\n\t\t// A sealed bundle that could not be read may belong to this scope: the history\n\t\t// below is the readable part of it.\n\t\tverification.Warnings = append(verification.Warnings, \"sealed bundle history is incomplete: \"+(SourceCoverage{Losses: bundleLosses}).Describe(\"\")+\"; a record that could not be read may belong to this scope\")\n\t}\n\tif len(prepared.Blockers) == 0 {\n\t\tverification.State = \"ready-to-seal\"\n\t}\n\tcurrent, err := s.matchSealedReviewBundle(scope, prepared, bundles)\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n\tif current == nil {\n\t\tif len(bundles) > 0 {\n\t\t\tprevious := reviewBundleLineage(bundles)[0]\n\t\t\tdelta := ReviewBundleDiff(previous, prepared)\n\t\t\t// The per-criterion explanation is computed only where a person\n\t\t\t// reads it; analytics over many bundles use the plain diff.\n\t\t\tdelta.CriterionReuse = ExplainCriterionReuse(previous, prepared)\n\t\t\tif attempts, listErr := s.ListReviewAttestations(previous.BundleID); listErr == nil && len(attempts) > 0 {\n\t\t\t\tfor _, finding := range attempts[len(attempts)-1].Findings {\n\t\t\t\t\tdelta.ChangedFindings = append(delta.ChangedFindings, finding.ID)\n\t\t\t\t}\n\t\t\t\tdelta.ChangedFindings = uniqueSorted(delta.ChangedFindings)\n\t\t\t}\n\t\t\tverification.Delta = &delta\n\t\t\tif done, doneErr := s.scopeLifecycleDone(scopeRef); doneErr == nil && done {\n\t\t\t\t// Only routine drift is retained. A changed federated manifest —\n\t\t\t\t// revoked trust, a moved or unauthorized source — bears on the\n\t\t\t\t// review's authority, so it stales a closed scope as it always did.\n\t\t\t\tbundle, att, retainLost, childBlockers := s.retainedCompletedReviewWithHistory(scopeRef, scope, policy)\n","exit_code":0,"status":"completed"}}
