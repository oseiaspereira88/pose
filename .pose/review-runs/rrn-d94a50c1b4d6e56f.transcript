l/pose/review_closeout.go:771:\tif err := validateReviewPolicyScopes(\"reviewer_independence\", p.ReviewerIndependence); err != nil {\npose-mcp/internal/pose/review_closeout.go:842:\tfor scope, independence := range p.ReviewerIndependence {\npose-mcp/internal/pose/review_closeout.go:843:\t\tif !validReviewIndependence(independence) {\npose-mcp/internal/pose/review_closeout.go:953:\tif p.SchemaVersion == ReviewSchemaVersion && (hasReviewSelectors(p.Selectors) || len(p.Tools) > 0 || p.Independence != \"\") {\npose-mcp/internal/pose/review_closeout.go:956:\tif p.Independence != \"\" && !validReviewIndependence(p.Independence) {\npose-mcp/internal/pose/review_closeout.go:957:\t\treturn ReviewProfile{}, fmt.Errorf(\"pose: invalid reviewer independence %q in %s\", p.Independence, ref)\npose-mcp/internal/pose/review_closeout.go:1020:func validReviewIndependence(value string) bool {\npose-mcp/internal/pose/review_closeout.go:1021:\treturn value == \"same-actor-separate-execution\" || value == \"different-actor\" || value == \"mandatory-human\"\npose-mcp/internal/pose/review_closeout.go:1497:\t\t\tindependence = policy.ReviewerIndependence[scope.Kind]\npose-mcp/internal/pose/review_closeout.go:1681:\tbaseIndependence := policy.ReviewerIndependence[scope.Kind]\npose-mcp/internal/pose/review_closeout.go:1682:\tindependence := baseIndependence\npose-mcp/internal/pose/review_closeout.go:1700:\t\tindependence = plan.Independence\npose-mcp/internal/pose/review_closeout.go:1757:\t\tindependence = baseIndependence\npose-mcp/internal/pose/review_closeout.go:1802:\tcase \"mandatory-human\":\n","exit_code":0,"status":"completed"}}
