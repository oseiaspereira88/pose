prove := draftOutput(\"approved\", `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"approved\",\"findings\":[],\"prior_findings\":[{\"id\":\"R1-B1\",\"status\":\"fixed\",\"evidence\":\"x\"}],\"sweep\":\"all\"}`)\npose-mcp/internal/pose/review_rounds_test.go:228:\trequest := draftOutput(\"changes-requested\", `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"changes-requested\",\"findings\":[{\"id\":\"B1\",\"severity\":\"low\",\"disposition\":\"blocker\",\"summary\":\"x\"}]}`)\npose-mcp/internal/pose/review_rounds_test.go:231:\t\t{RunID: \"2\", Scope: \"spec:s\", Kind: ReviewBriefKindReview, Status: ReviewRunCompleted, Round: 2, Output: draftOutput(\"changes-requested\", `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"changes-requested\",\"findings\":[{\"id\":\"B2\",\"severity\":\"low\",\"disposition\":\"blocker\",\"summary\":\"y\"}],\"prior_findings\":[{\"id\":\"R1-B1\",\"status\":\"partial\",\"evidence\":\"x\"}],\"sweep\":\"all\"}`), Thread: &ReviewThread{Mode: ReviewThreadNew}},\npose-mcp/internal/pose/review_rounds_test.go:246:\tbody := `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"approved\",\"findings\":[]}`\npose-mcp/internal/pose/review_rounds_test.go:247:\trejected := `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"rejected\",\"findings\":[]}`\npose-mcp/internal/pose/review_brief_conclusion_rules_test.go:127:// preflight refuses a draft whose prior_findings use a bare identifier (\"prior finding id F1\npose-mcp/internal/pose/review_brief_conclusion_rules_test.go:129:func TestTheBriefOfALaterRoundStatesTheIdentifiersOfPriorFindings(t *testing.T) {\npose-mcp/internal/pose/review_brief.go:499:\t\treturn \", `prior_findings` (each with `id`, `status` and `evidence`, one for every finding of the previous round; the `id` is the identifier listed under Findings to account for, which carries its round, for example R2-F1, never a bare F1, and a finding you report now takes an `id` that no earlier round used, for example N1: a bare or reused id