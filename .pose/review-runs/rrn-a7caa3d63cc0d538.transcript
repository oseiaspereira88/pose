{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '235,330p' pose-mcp/internal/cli/adopt.go; sed -n '630,718p' pose-mcp/internal/pose/capability_catalog.go; rg -n 'CapabilityPartial|CapabilityIncomplete|CapabilityOn|Adopted\\\\(docs\\\\)' pose-mcp/internal/pose/capability_catalog.go\"","aggregated_output":"\t\t\t}\n\t\t\tchanges = pair\n\t\t} else {\n\t\t\tchanges = entry.Adopt(docs, date)\n\t\t}\n\t}\n\tvar effects []posemodel.AdoptionEffect\n\tif mode == \"on\" && len(changes) > 0 {\n\t\tplanned, err := posemodel.PlanAdoptionEffects(root, entry.ID, issuer, time.Now())\n\t\tif err != nil {\n\t\t\tout.Failure(\"pose adopt: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n\t\t\treturn 1\n\t\t}\n\t\teffects = planned\n\t}\n\tif len(changes) == 0 {\n\t\tif mode == \"off\" {\n\t\t\tout.Field(\"adopt.result\", entry.ID+\" is not adopted; nothing to change\")\n\t\t} else {\n\t\t\tout.Field(\"adopt.result\", entry.ID+\" is already adopted; its date is kept, so nothing is re-judged\")\n\t\t}\n\t\treturn 0\n\t}\n\tfor _, change := range changes {\n\t\tout.Field(\"adopt.change\", change)\n\t}\n\tfor _, effect := range effects {\n\t\tout.Field(\"adopt.change\", effect.Description)\n\t}\n\t// The readers decide, before anything is written: a policy they would\n\t// refuse is never left behind.\n\tif _, _, _, _, err := docs.Rendered(posemodel.Store{Root: root}); err != nil {\n\t\tout.Failure(\"pose adopt: the resulting policy would be refused: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n\t\treturn 1\n\t}\n\tout.Field(\"adopt.apply\", boolString(apply))\n\tif !apply {\n\t\treturn 0\n\t}\n\tfor _, effect := range effects {\n\t\tif err := effect.Apply(); err != nil {\n\t\t\tout.Failure(\"pose adopt: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n\t\t\treturn 1\n\t\t}\n\t}\n\tif err := policyPublished(docs.Write(root, posemodel.Store{Root: root}), stderr); err != nil {\n\t\tout.Failure(\"pose adopt: \" + err.Error())\n\t\treturn 1\n\t}\n\tif mode == \"on\" {\n\t\t_ = posemodel.ClearAdoptionDecision(root, entry.ID)\n\t}\n\tadvanceReviewedVersion(root)\n\treturn 0\n}\n\n// adoptGovernedCapabilitiesAtInstall adopts every capability the catalog turns\n// on for a new instance, dated today, in a review policy this install has just\n// created. It is never called for a policy that existed before the install,\n// and never by `pose update`: an instance already under way decides when.\nfunc adoptGovernedCapabilitiesAtInstallIn(files posemodel.Files, target string, now time.Time, log func(english, portuguese string, a ...any)) {\n\tdocs, err := posemodel.LoadPolicyDocsIn(files, target)\n\tif err != nil {\n\t\treturn\n\t}\n\tdate := now.UTC().Format(time.DateOnly)\n\t// A new instance has reviewed this engine's catalog by adopting its\n\t// defaults; only what a later engine introduces is new to it.\n\t_ = posemodel.SetReviewedVersionIn(files, target, version.ReleaseBase())\n\tadopted := []string{}\n\tfor _, entry := range posemodel.CapabilityCatalog() {\n\t\tif !entry.DefaultForNew || entry.Adopted(docs) {\n\t\t\tcontinue\n\t\t}\n\t\tif posemodel.CatalogAdoptBlockerIn(files, target, docs, entry) != \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif len(entry.Adopt(docs, date)) > 0 {\n\t\t\tadopted = append(adopted, entry.ID)\n\t\t}\n\t}\n\tif len(adopted) == 0 {\n\t\treturn\n\t}\n\terr = docs.Write(target, posemodel.Store{Root: target, FS: files})\n\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n\t\tlog(\"warning: governed capabilities adopted, with durability unconfirmed: %v\", \"aviso: capacidades governadas adotadas, sem durabilidade confirmada: %v\", err)\n\t} else if err != nil {\n\t\tlog(\"warning: governed capabilities not adopted, the policy would be refused: %v\", \"aviso: capacidades governadas não adotadas, a política seria recusada: %v\", err)\n\t\treturn\n\t}\n\tfor _, id := range adopted {\n\t\tif id == \"closeout-review-policy\" {\n\t\t\t// This one is not turned off: its values change instead.\n\t\t\tlog(\"capability (adoption): %s from %s — `pose adopt %s --milestone-review-required <never|when-justified|always> --roadmap-review-required <never|when-justified|always> --apply` changes it\", \"capacidade (adoção): %s desde %s — `pose adopt %s --milestone-review-required <never|when-justified|always> --roadmap-review-required <never|when-justified|always> --apply` altera\", id, date, id)\n\t\t\tcontinue\n\t\treturn setReviewedVersionIn(guarded.fsys(), guarded.Root, version)\n\t})\n}\n\nfunc setReviewedVersionIn(files Files, root, version string) error {\n\tdoc, err := ReadAdoptionDecisionsIn(files, root)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif doc.ReviewedVersion == version {\n\t\treturn nil\n\t}\n\tdoc.ReviewedVersion = version\n\treturn writeAdoptionDecisions(files, root, doc)\n}\n\n// SetReviewedVersion reads and writes the filesystem directly; SetReviewedVersionIn takes the\n// operation's files.\nfunc SetReviewedVersion(root, version string) error {\n\treturn SetReviewedVersionIn(NativeFiles(), root, version)\n}\n\n// CompareReleaseVersions orders two `MAJOR.MINOR.PATCH` versions (a suffix\n// after `-` is ignored); an unreadable part counts as zero.\nfunc CompareReleaseVersions(a, b string) int {\n\tparse := func(v string) [3]int {\n\t\tvar out [3]int\n\t\tv = strings.TrimPrefix(strings.SplitN(v, \"-\", 2)[0], \"v\")\n\t\tfor i, part := range strings.SplitN(v, \".\", 3) {\n\t\t\tn := 0\n\t\t\tfor _, r := range part {\n\t\t\t\tif r < '0' || r > '9' {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\tn = n*10 + int(r-'0')\n\t\t\t}\n\t\t\tout[i] = n\n\t\t}\n\t\treturn out\n\t}\n\tpa, pb := parse(a), parse(b)\n\tfor i := range pa {\n\t\tif pa[i] != pb[i] {\n\t\t\tif pa[i] < pb[i] {\n\t\t\t\treturn -1\n\t\t\t}\n\t\t\treturn 1\n\t\t}\n\t}\n\treturn 0\n}\n\n// CapabilitiesToReview returns the capabilities this project has not decided\n// for the engine release it runs: off, undecided and introduced after the\n// reviewed version (every off, undecided one when none is recorded), and\n// deferrals taken under an older release. Capabilities that need setup are\n// not decisions yet and are not returned.\nfunc CapabilitiesToReviewIn(files Files, root, engine string) ([]CapabilityState, error) {\n\tstates, err := CapabilityStatesIn(files, root)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdecisions, err := ReadAdoptionDecisionsIn(files, root)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tout := []CapabilityState{}\n\tfor _, state := range states {\n\t\tswitch state.State {\n\t\tcase CapabilityOff:\n\t\t\tif decisions.ReviewedVersion == \"\" || CompareReleaseVersions(state.IntroducedIn, decisions.ReviewedVersion) > 0 {\n\t\t\t\tout = append(out, state)\n\t\t\t}\n\t\tcase CapabilityDeferred:\n\t\t\tif state.Decision != nil && (state.Decision.Version == \"\" || CompareReleaseVersions(state.Decision.Version, engine) < 0) {\n\t\t\t\tout = append(out, state)\n\t\t\t}\n\t\t}\n\t}\n\treturn out, nil\n}\n\n// CapabilitiesToReview reads and writes the filesystem directly; CapabilitiesToReviewIn takes the\n// operation's files.\nfunc CapabilitiesToReview(root, engine string) ([]CapabilityState, error) {\n\treturn CapabilitiesToReviewIn(NativeFiles(), root, engine)\n}\n\n// ClearAdoptionDecision forgets a recorded decision, as adopting does.\n491:\t\tif dependency, ok := LookupCatalogEntry(required); ok && !dependency.Adopted(docs) {\n509:\tif entry.RetireRefusal != \"\" && entry.Adopted(docs) {\n513:\t\tif other.ID == entry.ID || !other.Adopted(docs) {\n733:\tCapabilityOn         = \"on\"\n766:\t\tcase entry.Adopted(docs):\n767:\t\t\tstate.State = CapabilityOn\n","exit_code":0,"status":"completed"}}
