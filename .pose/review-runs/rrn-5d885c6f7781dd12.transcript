ario that follows.\n62:\t_ = os.WriteFile(\"/proc/\"+strconv.Itoa(pid)+\"/clear_refs\", []byte(\"5\"), 0o200)\n68:\t\tif strings.HasPrefix(line, \"VmHWM:\") {\n93:\t\tif strings.HasPrefix(line, \"VmRSS:\") {\n307:\t\tfail(\"T7 two simultaneous heavy checks\", \"via %v, outputs equal to standalone %v %v\", twoVia, two[0] == coldOut, two[1] == coldOut)\n309:\t\tpass(\"T7 two simultaneous heavy checks\", \"both through the runtime with the standalone output; wall %d ms <= %.1f x %d ms\", twoWall, thresholdTwoHeavyOverOne, warm)\n311:\t\tfail(\"T7 two simultaneous heavy checks\", \"wall %d ms > %.1f x %d ms\", twoWall, thresholdTwoHeavyOverOne, warm)\n332:\t\t\tif strings.HasPrefix(line, \"VmHWM:\") || strings.HasPrefix(line, \"VmRSS:\") {","numLines":12,"totalLines":12},"tool_result_meta":[{"id":"toolu_01BDeMR3poXT6cztZ4SzSeXg","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
