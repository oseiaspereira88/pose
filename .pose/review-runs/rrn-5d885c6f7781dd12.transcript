{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019KLzWQGFMcyXyREeSjvrWA","type":"tool_result","content":"25\t// figures either way.\n26\tconst (\n27\t\tmeasureColdSamples  = 3\n28\t\tmeasureWarmSamples  = 5\n29\t\tmeasureChurnSamples = 3\n30\t\tmeasureShortSamples = 10\n31\t\t// Thresholds (fixed before the first run).\n32\t\tthresholdWarmOverCold    = 0.60 // median warm run <= 0.6 x median cold run\n33\t\tthresholdChurnOverCold   = 0.80 // a restarted runtime inherits nothing: median >= 0.8 x cold\n34\t\tthresholdShortUnderHeavy = 3.0  // p95 of a short query under heavy load <= 3 x idle p95 ...\n35\t\tthresholdShortFloorMS    = 250  // ... or 250 ms, whichever is more\n36\t\tthresholdRSSMiB          = 1536 // resident set of the runtime after the warm runs\n37\t\tthresholdFallbackExtraMS = 500  // trying a runtime that is not there costs at most this\n38\t\tthresholdTwoHeavyOverOne = 2.5  // T7: two simultaneous heavy checks on the one heavy slot: wall <= 2.5 x one warm run\n39\t)\n40\t\n41\ttype measureReport struct {\n42\t\tEnvironment map[string]any     `json:\"environment\"`\n43\t\tScenarios   map[string][]int64 `json:\"scenarios_ms\"`\n44\t\tFigures     map[string]float64 `json:\"figures\"`\n45\t\tMetrics     map[string]int64   `json:\"runtime_metrics\"`\n46\t\tVerdicts    map[string]string  `json:\"verdicts\"`\n47\t}\n48\t\n49\t// measureClockTicks is the kernel's clock tick (getconf CLK_TCK), 100 where it cannot be read.\n50\tfunc measureClockTicks() int64 {\n51\t\tif out, err := exec.Command(\"getconf\", \"CLK_TCK\").Output(); err == nil {\n52\t\t\tif n, err := strconv.ParseInt(strings.TrimSpace(string(out)), 10, 64); err == nil && n > 0 {\n53\t\t\t\treturn n\n54\t\t\t}\n55\t\t}\n56\t\treturn 100\n57\t}\n58\t\n59\t// resetPeak resets the process's peak resident set (Linux: clear_refs 5), so that the next\n60\t// reading of VmHWM is the peak of the scenario that follows.\n61\tfunc resetPeak(pid int) {\n62\t\t_ = os.WriteFile(\"/proc/\"+strconv.Itoa(pid)+\"/clear_refs\", []byte(\"5\"), 0o200)\n63\t}\n64\t\n65\tfunc peakMiB(pid int) float64 {\n66\t\tstatus, _ := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/status\")\n67\t\tfor _, line := range strings.Split(string(status), \"\\n\") {\n68\t\t\tif strings.HasPrefix(line, \"VmHWM:\") {\n69\t\t\t\tkb, _ := strconv.ParseFloat(strings.Fields(line)[1], 64)\n70\t\t\t\treturn kb / 1024\n71\t\t\t}\n72\t\t}\n73\t\treturn 0\n74\t}\n75\t\n76\t// runtimeProc reads the runtime process's cumulative CPU time (user + system, ms) and its\n77\t// resident set (MiB) from /proc; ok is false where there is none.\n78\tfunc runtimeProc(pid int) (cpuMS int64, rssMiB float64, ok bool) {\n79\t\tstat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n80\t\tif err != nil {\n81\t\t\treturn 0, 0, false\n82\t\t}\n83\t\t// The command name is in parentheses and may hold spaces: fields count from after it.\n84\t\ttext := string(stat)\n85\t\tfields := strings.Fields(text[strings.LastIndex(text, \")\")+2:])\n86\t\tif len(fields) < 13 {\n87\t\t\treturn 0, 0, false\n88\t\t}\n89\t\tutime, _ := strconv.ParseInt(fields[11], 10, 64)\n90\t\tstime, _ := strconv.ParseInt(fields[12], 10, 64)\n91\t\tstatus, _ := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/status\")\n92\t\tfor _, line := range strings.Split(string(status), \"\\n\") {\n93\t\t\tif strings.HasPrefix(line, \"VmRSS:\") {\n94\t\t\t\tkb, _ := strconv.ParseFloat(strings.Fields(line)[1], 64)\n95\t\t\t\trssMiB = kb / 1024\n96\t\t\t}\n97\t\t}\n98\t\treturn (utime + stime) * 1000 / measureClockTicks(), rssMiB, true\n99\t}\n100\t\n101\tfunc measureMedian(v []int64) int64 {\n102\t\ts := append([]int64(nil), v...)\n103\t\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n104\t\treturn s[len(s)/2]\n105\t}\n106\t\n107\tfunc measureP95(v []int64) int64 {\n108\t\ts := append([]int64(nil), v...)\n109\t\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n110\t\ti := (len(s)*95 + 99) / 100\n111\t\tif i >= len(s) {\n112\t\t\ti = len(s) - 1\n113\t\t}\n114\t\treturn s[i]\n115\t}\n116\t\n117\tfunc TestMeasureTheRuntimeOnTheRealRepository(t *testing.T) {\n118\t\tout := os.Getenv(\"POSE_RUNTIME_MEASURE\")\n119\t\tif out == \"\" {\n120\t\t\tt.Skip(\"set POSE_RUNTIME_MEASURE=<output file> to measure the runtime on this repository\")\n121\t\t}\n122\t\trepo, err := filepath.Abs(\"../../..\")\n123\t\tif err != nil {\n124\t\t\tt.Fatal(err)\n125\t\t}\n126\t\tspec := os.Getenv(\"POSE_RUNTIME_MEASURE_SPEC\")\n127\t\tif spec == \"\" {\n128\t\t\tspec = \"spec:pose-governance-audit-skips-pure-git-reads\"\n129\t\t}\n130\t\tbin := filepath.Join(t.TempDir(), \"pose\")\n131\t\tif b, err := exec.Command(\"go\", \"build\", \"-o\", bin, \"../../cmd/pose\").CombinedOutput(); err != nil {\n132\t\t\tt.Fatalf(\"build: %v %s\", err, b)\n133\t\t}\n134\t\trtDir, _ := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rtm\")\n135\t\tdefer os.RemoveAll(rtDir)\n136\t\tenv := append(os.Environ(), \"POSE_RUNTIME_DIR=\"+rtDir+\"/r\")\n137\t\tfor _, drop := range []string{\"POSE_PROJECT_ROOT\", \"POSE_PROJECT_ROOTS\", \"POSE_DEFAULT_PROJECT_ID\", \"CLAUDECODE\"} {\n138\t\t\tenv = append(env, drop+\"=\")\n139\t\t}\n140\t\trun := func(args ...string) (string, int64, int) {\n141\t\t\tcmd := exec.Command(bin, args...)\n142\t\t\tcmd.Dir, cmd.Env = repo, env\n143\t\t\tvar o, e bytes.Buffer\n144\t\t\tcmd.Stdout, cmd.Stderr = &o, &e\n145\t\t\tstart := time.Now()\n146\t\t\terr := cmd.Run()\n147\t\t\tcode := 0\n148\t\t\tif ee, ok := err.(*exec.ExitError); ok {\n149\t\t\t\tcode = ee.ExitCode()\n150\t\t\t}\n151\t\t\treturn o.String() + \"\\x00\" + e.String(), time.Since(start).Milliseconds(), code\n152\t\t}\n153\t\truntimeRun := func(args ...string) (stdout string, ms int64, via string) {\n154\t\t\to, ms, _ := run(append([]string{\"runtime\", \"run\", \"--envelope\"}, args...)...)\n155\t\t\tvar doc struct {\n156\t\t\t\tVia, Stdout, Stderr string\n157\t\t\t}\n158\t\t\tdoc.Via = \"\"\n159\t\t\tvar raw map[string]any\n160\t\t\tif err := json.Unmarshal([]byte(strings.SplitN(o, \"\\x00\", 2)[0]), &raw); err != nil {\n161\t\t\t\tt.Fatalf(\"not an envelope: %q\", o)\n162\t\t\t}\n163\t\t\tvia, _ = raw[\"via\"].(string)\n164\t\t\tso, _ := raw[\"stdout\"].(string)\n165\t\t\tse, _ := raw[\"stderr\"].(string)\n166\t\t\treturn so + \"\\x00\" + se, ms, via\n167\t\t}\n168\t\trep := measureReport{Scenarios: map[string][]int64{}, Figures: map[string]float64{}, Verdicts: map[string]string{}}\n169\t\thead, _ := exec.Command(\"git\", \"-C\", repo, \"rev-parse\", \"HEAD\").Output()\n170\t\tcommits, _ := exec.Command(\"git\", \"-C\", repo, \"rev-list\", \"--count\", \"HEAD\").Output()\n171\t\tgitv, _ := exec.Command(\"git\", \"--version\").Output()\n172\t\tkernel, _ := os.ReadFile(\"/proc/sys/kernel/osrelease\")\n173\t\trep.Environment = map[string]any{\"cpus\": runtime.NumCPU(), \"gomaxprocs\": runtime.GOMAXPROCS(0), \"goos\": runtime.GOOS, \"goarch\": runtime.GOARCH,\n174\t\t\t\"go\": runtime.Version(), \"git\": strings.TrimSpace(string(gitv)), \"kernel\": strings.TrimSpace(string(kernel)), \"repo_head\": strings.TrimSpace(string(head)),\n175\t\t\t\"repo_commits\": strings.TrimSpace(string(commits)), \"check\": \"review-check \" + spec, \"short_query\": \"surface-check \" + spec,\n176\t\t\t\"samples\": map[string]int{\"cold\": measureColdSamples, \"warm\": measureWarmSamples, \"churn\": measureChurnSamples, \"short\": measureShortSamples}}\n177\t\n178\t\tfail := func(name, format string, a ...any) {\n179\t\t\trep.Verdicts[name] = \"FAIL: \" + fmt.Sprintf(format, a...)\n180\t\t\tt.Errorf(\"%s: \"+format, append([]any{name}, a...)...)\n181\t\t}\n182\t\tpass := func(name, format string, a ...any) { rep.Verdicts[name] = \"pass: \" + fmt.Sprintf(format, a...) }\n183\t\n184\t\t// S1: cold, standalone, a new process each time.\n185\t\tvar coldOut string\n186\t\tfor i := 0; i < measureColdSamples; i++ {\n187\t\t\to, ms, _ := run(\"review-check\", spec)\n188\t\t\tif i == 0 {\n189\t\t\t\tcoldOut = o\n190\t\t\t}\n191\t\t\trep.Scenarios[\"cold_standalone\"] = append(rep.Scenarios[\"cold_standalone\"], ms)\n192\t\t\tif o != coldOut {\n193\t\t\t\tt.Fatalf(\"standalone output changed between samples %d and 0\", i)\n194\t\t\t}\n195\t\t}\n196\t\tcold := measureMedian(rep.Scenarios[\"cold_standalone\"])\n197\t\n198\t\t// S2: asking for a runtime that is not there.\n199\t\tfor i := 0; i < measureColdSamples; i++ {\n200\t\t\to, ms, via := runtimeRun(\"review-check\", spec)\n201\t\t\trep.Scenarios[\"fallback_no_runtime\"] = append(rep.Scenarios[\"fallback_no_runtime\"], ms)\n202\t\t\tif via != \"standalone\" || o != coldOut {\n203\t\t\t\tt.Fatalf(\"a run with no runtime: via %q, same output %v\", via, o == coldOut)\n204\t\t\t}\n205\t\t}\n206\t\textra := measureMedian(rep.Scenarios[\"fallback_no_runtime\"]) - cold\n207\t\trep.Figures[\"fallback_extra_ms\"] = float64(extra)\n208\t\tif extra <= thresholdFallbackExtraMS {\n209\t\t\tpass(\"T6 fallback overhead\", \"%d ms <= %d ms\", extra, thresholdFallbackExtraMS)\n210\t\t} else {\n211\t\t\tfail(\"T6 fallback overhead\", \"%d ms > %d ms\", extra, thresholdFallbackExtraMS)\n212\t\t}\n213\t\n214\t\t// S3: resident, warm. The first run is the cold one inside the runtime; it is recorded apart.\n215\t\tif o, _, _ := run(\"runtime\", \"start\"); !strings.Contains(o, \"started\") {\n216\t\t\tt.Fatalf(\"start: %s\", o)\n217\t\t}\n218\t\tdefer run(\"runtime\", \"stop\")\n219\t\tpidOf := func() int {\n220\t\t\to, _, _ := run(\"runtime\", \"status\", \"--json\")\n221\t\t\tvar d struct {\n222\t\t\t\tPID int `json:\"pid\"`\n223\t\t\t}\n224\t\t\t_ = json.Unmarshal([]byte(strings.SplitN(o, \"\\x00\", 2)[0]), &d)\n225\t\t\treturn d.PID\n226\t\t}\n227\t\tpid := pidOf()\n228\t\tpeakAll := 0.0\n229\t\t// Per scenario: the CPU time the runtime process spent and its resident set afterwards.\n230\t\tmark := func(scenario string, since int64) int64 {\n231\t\t\tcpu, rss, ok := runtimeProc(pid)\n232\t\t\tif ok {\n233\t\t\t\trep.Figures[\"cpu_ms_\"+scenario] = float64(cpu - since)\n234\t\t\t\trep.Figures[\"rss_mib_after_\"+scenario] = rss\n235\t\t\t\tpeak := peakMiB(pid)\n236\t\t\t\trep.Figures[\"peak_rss_mib_\"+scenario] = peak\n237\t\t\t\tif peak > peakAll {\n238\t\t\t\t\tpeakAll = peak\n239\t\t\t\t}\n240\t\t\t\tresetPeak(pid)\n241\t\t\t}\n242\t\t\treturn cpu\n243\t\t}\n244\t\tcpuNow := func() int64 { cpu, _, _ := runtimeProc(pid); return cpu }\n245\t\tcpuBefore := cpuNow()\n246\t\tfor i := 0; i < measureWarmSamples+1; i++ {\n247\t\t\to, ms, via := runtimeRun(\"review-check\", spec)\n248\t\t\tif via != \"runtime\" || o != coldOut {\n249\t\t\t\tt.Fatalf(\"a hosted run: via %q, same output as standalone %v\", via, o == coldOut)\n250\t\t\t}\n251\t\t\tif i == 0 {\n252\t\t\t\trep.Scenarios[\"resident_first\"] = []int64{ms}\n253\t\t\t} else {\n254\t\t\t\trep.Scenarios[\"resident_warm\"] = append(rep.Scenarios[\"resident_warm\"], ms)\n255\t\t\t}\n256\t\t}\n257\t\tmark(\"resident_first_and_warm\", cpuBefore)\n258\t\twarm := measureMedian(rep.Scenarios[\"resident_warm\"])\n259\t\trep.Figures[\"warm_over_cold\"] = float64(warm) / float64(cold)\n260\t\tif float64(warm) <= thresholdWarmOverCold*float64(cold) {\n261\t\t\tpass(\"T1 warm over cold\", \"%d ms / %d ms = %.2f <= %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n262\t\t} else {\n263\t\t\tfail(\"T1 warm over cold\", \"%d ms / %d ms = %.2f > %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n264\t\t}\n265\t\t// S5: short queries, idle then under a heavy check.\n266\t\tshortArgs := []string{\"surface-check\", spec}\n267\t\tshortStandalone, _, _ := run(shortArgs...)\n268\t\tcpuShortStart := cpuNow()\n269\t\tresetPeak(pid)\n270\t\tfor i := 0; i < measureShortSamples; i++ {\n271\t\t\tso, ms, via := runtimeRun(shortArgs...)\n272\t\t\tif via != \"runtime\" || so != shortStandalone {\n273\t\t\t\tt.Fatalf(\"a short query went %s, same output as standalone %v\", via, so == shortStandalone)\n274\t\t\t}\n275\t\t\trep.Scenarios[\"short_idle\"] = append(rep.Scenarios[\"short_idle\"], ms)\n276\t\t}\n277\t\tcpuHeavyStart := mark(\"short_idle\", cpuShortStart)\n278\t\tvar wg sync.WaitGroup\n279\t\twg.Add(1)\n280\t\tgo func() { defer wg.Done(); runtimeRun(\"review-check\", spec) }()\n281\t\ttime.Sleep(1500 * time.Millisecond)\n282\t\tfor i := 0; i < measureShortSamples; i++ {\n283\t\t\tso, ms, via := runtimeRun(shortArgs...)\n284\t\t\tif via != \"runtime\" || so != shortStandalone {\n285\t\t\t\tt.Fatalf(\"a short query under load went %s, same output as standalone %v\", via, so == shortStandalone)\n286\t\t\t}\n287\t\t\trep.Scenarios[\"short_under_heavy\"] = append(rep.Scenarios[\"short_under_heavy\"], ms)\n288\t\t}\n289\t\twg.Wait()\n290\t\tmark(\"heavy_with_short_queries\", cpuHeavyStart)\n291\t\t// S6: two heavy checks at once on the one heavy slot: the second waits its turn.\n292\t\ttwoStart := time.Now()\n293\t\tcpuTwo := cpuNow()\n294\t\tvar two [2]string\n295\t\tvar twoVia [2]string\n296\t\tvar wg2 sync.WaitGroup\n297\t\tfor k := 0; k < 2; k++ {\n298\t\t\twg2.Add(1)\n299\t\t\tgo func(k int) { defer wg2.Done(); two[k], _, twoVia[k] = runtimeRun(\"review-check\", spec) }(k)\n300\t\t}\n301\t\twg2.Wait()\n302\t\ttwoWall := time.Since(twoStart).Milliseconds()\n303\t\tmark(\"two_simultaneous_heavy\", cpuTwo)\n304\t\trep.Scenarios[\"two_heavy_wall\"] = []int64{twoWall}\n305\t\trep.Figures[\"two_heavy_over_one_warm\"] = float64(twoWall) / float64(warm)\n306\t\tif two[0] != coldOut || two[1] != coldOut || twoVia[0] != \"runtime\" || twoVia[1] != \"runtime\" {\n307\t\t\tfail(\"T7 two simultaneous heavy checks\", \"via %v, outputs equal to standalone %v %v\", twoVia, two[0] == coldOut, two[1] == coldOut)\n308\t\t} else if float64(twoWall) <= thresholdTwoHeavyOverOne*float64(warm) {\n309\t\t\tpass(\"T7 two simultaneous heavy checks\", \"both through the runtime with the standalone output; wall %d ms <= %.1f x %d ms\", twoWall, thresholdTwoHeavyOverOne, warm)\n310\t\t} else {\n311\t\t\tfail(\"T7 two simultaneous heavy checks\", \"wall %d ms > %.1f x %d ms\", twoWall, thresholdTwoHeavyOverOne, warm)\n312\t\t}\n313\t\tidle, loaded := measureP95(rep.Scenarios[\"short_idle\"]), measureP95(rep.Scenarios[\"short_under_heavy\"])\n314\t\tbound := int64(thresholdShortUnderHeavy * float64(idle))\n315\t\tif bound < thresholdShortFloorMS {\n316\t\t\tbound = thresholdShortFloorMS\n317\t\t}\n318\t\trep.Figures[\"short_p95_idle_ms\"], rep.Figures[\"short_p95_under_heavy_ms\"] = float64(idle), float64(loaded)\n319\t\tif loaded <= bound {\n320\t\t\tpass(\"T3 short under heavy\", \"p95 %d ms <= %d ms (idle p95 %d ms)\", loaded, bound, idle)\n321\t\t} else {\n322\t\t\tfail(\"T3 short under heavy\", \"p95 %d ms > %d ms (idle p95 %d ms)\", loaded, bound, idle)\n323\t\t}\n324\t\t// Memory of the runtime after the warm runs and the concurrent phase.\n325\t\tstatus, _, _ := run(\"runtime\", \"status\", \"--json\")\n326\t\tvar st struct {\n327\t\t\tPID int `json:\"pid\"`\n328\t\t}\n329\t\t_ = json.Unmarshal([]byte(strings.SplitN(status, \"\\x00\", 2)[0]), &st)\n330\t\tif raw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(st.PID) + \"/status\"); err == nil {\n331\t\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n332\t\t\t\tif strings.HasPrefix(line, \"VmHWM:\") || strings.HasPrefix(line, \"VmRSS:\") {\n333\t\t\t\t\tf := strings.Fields(line)\n334\t\t\t\t\tkb, _ := strconv.ParseFloat(f[1], 64)\n335\t\t\t\t\trep.Figures[strings.TrimSuffix(f[0], \":\")+\"_mib\"] = kb / 1024\n336\t\t\t\t}\n337\t\t\t}\n338\t\t\tif end := peakMiB(pid); end > peakAll {\n339\t\t\t\tpeakAll = end\n340\t\t\t}\n341\t\t\trep.Figures[\"peak_rss_mib_whole_run\"] = peakAll\n342\t\t\tif mib := peakAll; mib <= thresholdRSSMiB {\n343\t\t\t\tpass(\"T4 runtime memory\", \"peak resident %.0f MiB <= %d MiB\", mib, thresholdRSSMiB)\n344\t\t\t} else {\n345\t\t\t\tfail(\"T4 runtime memory\", \"peak resident %.0f MiB > %d MiB\", mib, thresholdRSSMiB)\n346\t\t\t}\n347\t\t} else {\n348\t\t\trep.Verdicts[\"T4 runtime memory\"] = \"not measured: no /proc on this platform\"\n349\t\t}\n350\t\n351\t\tst2, _, _ := run(\"runtime\", \"status\", \"--json\")\n352\t\tvar full struct {\n353\t\t\tMetrics map[string]int64 `json:\"metrics\"`\n354\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"28e91253-696f-4b6d-9842-835a36848033","timestamp":"2026-11-10T11:40:59.221Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2687461199/worktree/pose-mcp/internal/cli/runtime_measure_test.go","content":"// figures either way.\nconst (\n\tmeasureColdSamples  = 3\n\tmeasureWarmSamples  = 5\n\tmeasureChurnSamples = 3\n\tmeasureShortSamples = 10\n\t// Thresholds (fixed before the first run).\n\tthresholdWarmOverCold    = 0.60 // median warm run <= 0.6 x median cold run\n\tthresholdChurnOverCold   = 0.80 // a restarted runtime inherits nothing: median >= 0.8 x cold\n\tthresholdShortUnderHeavy = 3.0  // p95 of a short query under heavy load <= 3 x idle p95 ...\n\tthresholdShortFloorMS    = 250  // ... or 250 ms, whichever is more\n\tthresholdRSSMiB          = 1536 // resident set of the runtime after the warm runs\n\tthresholdFallbackExtraMS = 500  // trying a runtime that is not there costs at most this\n\tthresholdTwoHeavyOverOne = 2.5  // T7: two simultaneous heavy checks on the one heavy slot: wall <= 2.5 x one warm run\n)\n\ntype measureReport struct {\n\tEnvironment map[string]any     `json:\"environment\"`\n\tScenarios   map[string][]int64 `json:\"scenarios_ms\"`\n\tFigures     map[string]float64 `json:\"figures\"`\n\tMetrics     map[string]int64   `json:\"runtime_metrics\"`\n\tVerdicts    map[string]string  `json:\"verdicts\"`\n}\n\n// measureClockTicks is the kernel's clock tick (getconf CLK_TCK), 100 where it cannot be read.\nfunc measureClockTicks() int64 {\n\tif out, err := exec.Command(\"getconf\", \"CLK_TCK\").Output(); err == nil {\n\t\tif n, err := strconv.ParseInt(strings.TrimSpace(string(out)), 10, 64); err == nil && n > 0 {\n\t\t\treturn n\n\t\t}\n\t}\n\treturn 100\n}\n\n// resetPeak resets the process's peak resident set (Linux: clear_refs 5), so that the next\n// reading of VmHWM is the peak of the scenario that follows.\nfunc resetPeak(pid int) {\n\t_ = os.WriteFile(\"/proc/\"+strconv.Itoa(pid)+\"/clear_refs\", []byte(\"5\"), 0o200)\n}\n\nfunc peakMiB(pid int) float64 {\n\tstatus, _ := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/status\")\n\tfor _, line := range strings.Split(string(status), \"\\n\") {\n\t\tif strings.HasPrefix(line, \"VmHWM:\") {\n\t\t\tkb, _ := strconv.ParseFloat(strings.Fields(line)[1], 64)\n\t\t\treturn kb / 1024\n\t\t}\n\t}\n\treturn 0\n}\n\n// runtimeProc reads the runtime process's cumulative CPU time (user + system, ms) and its\n// resident set (MiB) from /proc; ok is false where there is none.\nfunc runtimeProc(pid int) (cpuMS int64, rssMiB float64, ok bool) {\n\tstat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n\tif err != nil {\n\t\treturn 0, 0, false\n\t}\n\t// The command name is in parentheses and may hold spaces: fields count from after it.\n\ttext := string(stat)\n\tfields := strings.Fields(text[strings.LastIndex(text, \")\")+2:])\n\tif len(fields) < 13 {\n\t\treturn 0, 0, false\n\t}\n\tutime, _ := strconv.ParseInt(fields[11], 10, 64)\n\tstime, _ := strconv.ParseInt(fields[12], 10, 64)\n\tstatus, _ := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/status\")\n\tfor _, line := range strings.Split(string(status), \"\\n\") {\n\t\tif strings.HasPrefix(line, \"VmRSS:\") {\n\t\t\tkb, _ := strconv.ParseFloat(strings.Fields(line)[1], 64)\n\t\t\trssMiB = kb / 1024\n\t\t}\n\t}\n\treturn (utime + stime) * 1000 / measureClockTicks(), rssMiB, true\n}\n\nfunc measureMedian(v []int64) int64 {\n\ts := append([]int64(nil), v...)\n\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n\treturn s[len(s)/2]\n}\n\nfunc measureP95(v []int64) int64 {\n\ts := append([]int64(nil), v...)\n\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n\ti := (len(s)*95 + 99) / 100\n\tif i >= len(s) {\n\t\ti = len(s) - 1\n\t}\n\treturn s[i]\n}\n\nfunc TestMeasureTheRuntimeOnTheRealRepository(t *testing.T) {\n\tout := os.Getenv(\"POSE_RUNTIME_MEASURE\")\n\tif out == \"\" {\n\t\tt.Skip(\"set POSE_RUNTIME_MEASURE=<output file> to measure the runtime on this repository\")\n\t}\n\trepo, err := filepath.Abs(\"../../..\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tspec := os.Getenv(\"POSE_RUNTIME_MEASURE_SPEC\")\n\tif spec == \"\" {\n\t\tspec = \"spec:pose-governance-audit-skips-pure-git-reads\"\n\t}\n\tbin := filepath.Join(t.TempDir(), \"pose\")\n\tif b, err := exec.Command(\"go\", \"build\", \"-o\", bin, \"../../cmd/pose\").CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"build: %v %s\", err, b)\n\t}\n\trtDir, _ := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rtm\")\n\tdefer os.RemoveAll(rtDir)\n\tenv := append(os.Environ(), \"POSE_RUNTIME_DIR=\"+rtDir+\"/r\")\n\tfor _, drop := range []string{\"POSE_PROJECT_ROOT\", \"POSE_PROJECT_ROOTS\", \"POSE_DEFAULT_PROJECT_ID\", \"CLAUDECODE\"} {\n\t\tenv = append(env, drop+\"=\")\n\t}\n\trun := func(args ...string) (string, int64, int) {\n\t\tcmd := exec.Command(bin, args...)\n\t\tcmd.Dir, cmd.Env = repo, env\n\t\tvar o, e bytes.Buffer\n\t\tcmd.Stdout, cmd.Stderr = &o, &e\n\t\tstart := time.Now()\n\t\terr := cmd.Run()\n\t\tcode := 0\n\t\tif ee, ok := err.(*exec.ExitError); ok {\n\t\t\tcode = ee.ExitCode()\n\t\t}\n\t\treturn o.String() + \"\\x00\" + e.String(), time.Since(start).Milliseconds(), code\n\t}\n\truntimeRun := func(args ...string) (stdout string, ms int64, via string) {\n\t\to, ms, _ := run(append([]string{\"runtime\", \"run\", \"--envelope\"}, args...)...)\n\t\tvar doc struct {\n\t\t\tVia, Stdout, Stderr string\n\t\t}\n\t\tdoc.Via = \"\"\n\t\tvar raw map[string]any\n\t\tif err := json.Unmarshal([]byte(strings.SplitN(o, \"\\x00\", 2)[0]), &raw); err != nil {\n\t\t\tt.Fatalf(\"not an envelope: %q\", o)\n\t\t}\n\t\tvia, _ = raw[\"via\"].(string)\n\t\tso, _ := raw[\"stdout\"].(string)\n\t\tse, _ := raw[\"stderr\"].(string)\n\t\treturn so + \"\\x00\" + se, ms, via\n\t}\n\trep := measureReport{Scenarios: map[string][]int64{}, Figures: map[string]float64{}, Verdicts: map[string]string{}}\n\thead, _ := exec.Command(\"git\", \"-C\", repo, \"rev-parse\", \"HEAD\").Output()\n\tcommits, _ := exec.Command(\"git\", \"-C\", repo, \"rev-list\", \"--count\", \"HEAD\").Output()\n\tgitv, _ := exec.Command(\"git\", \"--version\").Output()\n\tkernel, _ := os.ReadFile(\"/proc/sys/kernel/osrelease\")\n\trep.Environment = map[string]any{\"cpus\": runtime.NumCPU(), \"gomaxprocs\": runtime.GOMAXPROCS(0), \"goos\": runtime.GOOS, \"goarch\": runtime.GOARCH,\n\t\t\"go\": runtime.Version(), \"git\": strings.TrimSpace(string(gitv)), \"kernel\": strings.TrimSpace(string(kernel)), \"repo_head\": strings.TrimSpace(string(head)),\n\t\t\"repo_commits\": strings.TrimSpace(string(commits)), \"check\": \"review-check \" + spec, \"short_query\": \"surface-check \" + spec,\n\t\t\"samples\": map[string]int{\"cold\": measureColdSamples, \"warm\": measureWarmSamples, \"churn\": measureChurnSamples, \"short\": measureShortSamples}}\n\n\tfail := func(name, format string, a ...any) {\n\t\trep.Verdicts[name] = \"FAIL: \" + fmt.Sprintf(format, a...)\n\t\tt.Errorf(\"%s: \"+format, append([]any{name}, a...)...)\n\t}\n\tpass := func(name, format string, a ...any) { rep.Verdicts[name] = \"pass: \" + fmt.Sprintf(format, a...) }\n\n\t// S1: cold, standalone, a new process each time.\n\tvar coldOut string\n\tfor i := 0; i < measureColdSamples; i++ {\n\t\to, ms, _ := run(\"review-check\", spec)\n\t\tif i == 0 {\n\t\t\tcoldOut = o\n\t\t}\n\t\trep.Scenarios[\"cold_standalone\"] = append(rep.Scenarios[\"cold_standalone\"], ms)\n\t\tif o != coldOut {\n\t\t\tt.Fatalf(\"standalone output changed between samples %d and 0\", i)\n\t\t}\n\t}\n\tcold := measureMedian(rep.Scenarios[\"cold_standalone\"])\n\n\t// S2: asking for a runtime that is not there.\n\tfor i := 0; i < measureColdSamples; i++ {\n\t\to, ms, via := runtimeRun(\"review-check\", spec)\n\t\trep.Scenarios[\"fallback_no_runtime\"] = append(rep.Scenarios[\"fallback_no_runtime\"], ms)\n\t\tif via != \"standalone\" || o != coldOut {\n\t\t\tt.Fatalf(\"a run with no runtime: via %q, same output %v\", via, o == coldOut)\n\t\t}\n\t}\n\textra := measureMedian(rep.Scenarios[\"fallback_no_runtime\"]) - cold\n\trep.Figures[\"fallback_extra_ms\"] = float64(extra)\n\tif extra <= thresholdFallbackExtraMS {\n\t\tpass(\"T6 fallback overhead\", \"%d ms <= %d ms\", extra, thresholdFallbackExtraMS)\n\t} else {\n\t\tfail(\"T6 fallback overhead\", \"%d ms > %d ms\", extra, thresholdFallbackExtraMS)\n\t}\n\n\t// S3: resident, warm. The first run is the cold one inside the runtime; it is recorded apart.\n\tif o, _, _ := run(\"runtime\", \"start\"); !strings.Contains(o, \"started\") {\n\t\tt.Fatalf(\"start: %s\", o)\n\t}\n\tdefer run(\"runtime\", \"stop\")\n\tpidOf := func() int {\n\t\to, _, _ := run(\"runtime\", \"status\", \"--json\")\n\t\tvar d struct {\n\t\t\tPID int `json:\"pid\"`\n\t\t}\n\t\t_ = json.Unmarshal([]byte(strings.SplitN(o, \"\\x00\", 2)[0]), &d)\n\t\treturn d.PID\n\t}\n\tpid := pidOf()\n\tpeakAll := 0.0\n\t// Per scenario: the CPU time the runtime process spent and its resident set afterwards.\n\tmark := func(scenario string, since int64) int64 {\n\t\tcpu, rss, ok := runtimeProc(pid)\n\t\tif ok {\n\t\t\trep.Figures[\"cpu_ms_\"+scenario] = float64(cpu - since)\n\t\t\trep.Figures[\"rss_mib_after_\"+scenario] = rss\n\t\t\tpeak := peakMiB(pid)\n\t\t\trep.Figures[\"peak_rss_mib_\"+scenario] = peak\n\t\t\tif peak > peakAll {\n\t\t\t\tpeakAll = peak\n\t\t\t}\n\t\t\tresetPeak(pid)\n\t\t}\n\t\treturn cpu\n\t}\n\tcpuNow := func() int64 { cpu, _, _ := runtimeProc(pid); return cpu }\n\tcpuBefore := cpuNow()\n\tfor i := 0; i < measureWarmSamples+1; i++ {\n\t\to, ms, via := runtimeRun(\"review-check\", spec)\n\t\tif via != \"runtime\" || o != coldOut {\n\t\t\tt.Fatalf(\"a hosted run: via %q, same output as standalone %v\", via, o == coldOut)\n\t\t}\n\t\tif i == 0 {\n\t\t\trep.Scenarios[\"resident_first\"] = []int64{ms}\n\t\t} else {\n\t\t\trep.Scenarios[\"resident_warm\"] = append(rep.Scenarios[\"resident_warm\"], ms)\n\t\t}\n\t}\n\tmark(\"resident_first_and_warm\", cpuBefore)\n\twarm := measureMedian(rep.Scenarios[\"resident_warm\"])\n\trep.Figures[\"warm_over_cold\"] = float64(warm) / float64(cold)\n\tif float64(warm) <= thresholdWarmOverCold*float64(cold) {\n\t\tpass(\"T1 warm over cold\", \"%d ms / %d ms = %.2f <= %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n\t} else {\n\t\tfail(\"T1 warm over cold\", \"%d ms / %d ms = %.2f > %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n\t}\n\t// S5: short queries, idle then under a heavy check.\n\tshortArgs := []string{\"surface-check\", spec}\n\tshortStandalone, _, _ := run(shortArgs...)\n\tcpuShortStart := cpuNow()\n\tresetPeak(pid)\n\tfor i := 0; i < measureShortSamples; i++ {\n\t\tso, ms, via := runtimeRun(shortArgs...)\n\t\tif via != \"runtime\" || so != shortStandalone {\n\t\t\tt.Fatalf(\"a short query went %s, same output as standalone %v\", via, so == shortStandalone)\n\t\t}\n\t\trep.Scenarios[\"short_idle\"] = append(rep.Scenarios[\"short_idle\"], ms)\n\t}\n\tcpuHeavyStart := mark(\"short_idle\", cpuShortStart)\n\tvar wg sync.WaitGroup\n\twg.Add(1)\n\tgo func() { defer wg.Done(); runtimeRun(\"review-check\", spec) }()\n\ttime.Sleep(1500 * time.Millisecond)\n\tfor i := 0; i < measureShortSamples; i++ {\n\t\tso, ms, via := runtimeRun(shortArgs...)\n\t\tif via != \"runtime\" || so != shortStandalone {\n\t\t\tt.Fatalf(\"a short query under load went %s, same output as standalone %v\", via, so == shortStandalone)\n\t\t}\n\t\trep.Scenarios[\"short_under_heavy\"] = append(rep.Scenarios[\"short_under_heavy\"], ms)\n\t}\n\twg.Wait()\n\tmark(\"heavy_with_short_queries\", cpuHeavyStart)\n\t// S6: two heavy checks at once on the one heavy slot: the second waits its turn.\n\ttwoStart := time.Now()\n\tcpuTwo := cpuNow()\n\tvar two [2]string\n\tvar twoVia [2]string\n\tvar wg2 sync.WaitGroup\n\tfor k := 0; k < 2; k++ {\n\t\twg2.Add(1)\n\t\tgo func(k int) { defer wg2.Done(); two[k], _, twoVia[k] = runtimeRun(\"review-check\", spec) }(k)\n\t}\n\twg2.Wait()\n\ttwoWall := time.Since(twoStart).Milliseconds()\n\tmark(\"two_simultaneous_heavy\", cpuTwo)\n\trep.Scenarios[\"two_heavy_wall\"] = []int64{twoWall}\n\trep.Figures[\"two_heavy_over_one_warm\"] = float64(twoWall) / float64(warm)\n\tif two[0] != coldOut || two[1] != coldOut || twoVia[0] != \"runtime\" || twoVia[1] != \"runtime\" {\n\t\tfail(\"T7 two simultaneous heavy checks\", \"via %v, outputs equal to standalone %v %v\", twoVia, two[0] == coldOut, two[1] == coldOut)\n\t} else if float64(twoWall) <= thresholdTwoHeavyOverOne*float64(warm) {\n\t\tpass(\"T7 two simultaneous heavy checks\", \"both through the runtime with the standalone output; wall %d ms <= %.1f x %d ms\", twoWall, thresholdTwoHeavyOverOne, warm)\n\t} else {\n\t\tfail(\"T7 two simultaneous heavy checks\", \"wall %d ms > %.1f x %d ms\", twoWall, thresholdTwoHeavyOverOne, warm)\n\t}\n\tidle, loaded := measureP95(rep.Scenarios[\"short_idle\"]), measureP95(rep.Scenarios[\"short_under_heavy\"])\n\tbound := int64(thresholdShortUnderHeavy * float64(idle))\n\tif bound < thresholdShortFloorMS {\n\t\tbound = thresholdShortFloorMS\n\t}\n\trep.Figures[\"short_p95_idle_ms\"], rep.Figures[\"short_p95_under_heavy_ms\"] = float64(idle), float64(loaded)\n\tif loaded <= bound {\n\t\tpass(\"T3 short under heavy\", \"p95 %d ms <= %d ms (idle p95 %d ms)\", loaded, bound, idle)\n\t} else {\n\t\tfail(\"T3 short under heavy\", \"p95 %d ms > %d ms (idle p95 %d ms)\", loaded, bound, idle)\n\t}\n\t// Memory of the runtime after the warm runs and the concurrent phase.\n\tstatus, _, _ := run(\"runtime\", \"status\", \"--json\")\n\tvar st struct {\n\t\tPID int `json:\"pid\"`\n\t}\n\t_ = json.Unmarshal([]byte(strings.SplitN(status, \"\\x00\", 2)[0]), &st)\n\tif raw, err := os.ReadFile(\"/proc