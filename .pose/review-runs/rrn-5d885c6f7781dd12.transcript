{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TbixWMtyeRRMvkTa5LmX6i","type":"tool_result","content":"330\ttype server struct {\n331\t\topts     Options\n332\t\tlistener net.Listener\n333\t\tepoch    string\n334\t\tstarted  time.Time\n335\t\tlast     int64 // unix nanos of the last request, atomic\n336\t\tinflight atomic.Int64\n337\t\tserved   atomic.Int64\n338\t\twg       sync.WaitGroup\n339\t\tdone     chan struct{}\n340\t\tonce     sync.Once\n341\t}\n342\t\n343\tfunc (s *server) run(ctx context.Context) error {\n344\t\tgo func() {\n345\t\t\tselect {\n346\t\t\tcase <-ctx.Done():\n347\t\t\t\ts.shutdown()\n348\t\t\tcase <-s.done:\n349\t\t\t}\n350\t\t}()\n351\t\tif s.opts.Idle > 0 {\n352\t\t\tgo s.watchIdle()\n353\t\t}\n354\t\tfor {\n355\t\t\tconn, err := s.listener.Accept()\n356\t\t\tif err != nil {\n357\t\t\t\tselect {\n358\t\t\t\tcase <-s.done:\n359\t\t\t\t\ts.wg.Wait()\n360\t\t\t\t\treturn nil\n361\t\t\t\tdefault:\n362\t\t\t\t\treturn err\n363\t\t\t\t}\n364\t\t\t}\n365\t\t\ts.inflight.Add(1)\n366\t\t\ts.wg.Add(1)\n367\t\t\tgo func() {\n368\t\t\t\tdefer s.wg.Done()\n369\t\t\t\tdefer s.inflight.Add(-1)\n370\t\t\t\ts.handle(ctx, conn)\n371\t\t\t}()\n372\t\t}\n373\t}\n374\t\n375\tfunc (s *server) shutdown() { s.once.Do(func() { close(s.done); s.listener.Close() }) }\n376\t\n377\tfunc (s *server) watchIdle() {\n378\t\ttick := time.NewTicker(minDuration(s.opts.Idle/4, time.Second))\n379\t\tdefer tick.Stop()\n380\t\tfor {\n381\t\t\tselect {\n382\t\t\tcase <-s.done:\n383\t\t\t\treturn\n384\t\t\tcase <-tick.C:\n385\t\t\t\tif s.inflight.Load()+s.busy() == 0 && time.Since(time.Unix(0, atomic.LoadInt64(&s.last))) >= s.opts.Idle {\n386\t\t\t\t\ts.shutdown()\n387\t\t\t\t\treturn\n388\t\t\t\t}\n389\t\t\t}\n390\t\t}\n391\t}\n392\t\n393\tfunc minDuration(a, b time.Duration) time.Duration {\n394\t\tif a < b && a > 0 {\n395\t\t\treturn a\n396\t\t}\n397\t\treturn b\n398\t}\n399\t\n400\tfunc (s *server) handle(ctx context.Context, conn net.Conn) {\n401\t\tdefer conn.Close()\n402\t\tatomic.StoreInt64(&s.last, time.Now().UnixNano())\n403\t\t// The operating system says who is on the other end before a byte of it is read.\n404\t\tif uc, ok := conn.(*net.UnixConn); !ok {\n405\t\t\treturn\n406\t\t} else if uid, err := peerUID(uc); err != nil || int(uid) != os.Getuid() {\n407\t\t\treturn\n408\t\t}\n409\t\t_ = conn.SetDeadline(time.Now().Add(requestDeadline))\n410\t\tline, err := bufio.NewReaderSize(io.LimitReader(conn, maxRequest), 4096).ReadBytes('\\n')\n411\t\tif err != nil && len(line) == 0 {\n412\t\t\treturn\n413\t\t}\n414\t\tvar req Request\n415\t\tif err := json.Unmarshal(line, &req); err != nil {\n416\t\t\twriteReply(conn, Reply{Error: \"the request is not valid JSON\"})\n417\t\t\treturn\n418\t\t}\n419\t\ts.served.Add(1)\n420\t\tswitch req.Op {\n421\t\tcase \"handshake\":\n422\t\t\tif req.Identity == nil {\n423\t\t\t\twriteReply(conn, Reply{Error: \"a handshake carries the client's identity\"})\n424\t\t\t\treturn\n425\t\t\t}\n426\t\t\tif mism := s.opts.Identity.Mismatches(*req.Identity); len(mism) > 0 {\n427\t\t\t\twriteReply(conn, Reply{Mismatch: mism, Error: \"incompatible\", PID: os.Getpid()})\n428\t\t\t\treturn\n429\t\t\t}\n430\t\t\twriteReply(conn, s.state(true))\n431\t\tcase \"status\":\n432\t\t\twriteReply(conn, s.state(true))\n433\t\tcase \"stop\":\n434\t\t\tdrain := defaultDrain\n435\t\t\tif req.DrainMS > 0 {\n436\t\t\t\tdrain = time.Duration(req.DrainMS) * time.Millisecond\n437\t\t\t}\n438\t\t\t// No new connection is accepted while the requests in flight drain.\n439\t\t\ts.shutdown()\n440\t\t\t// The reply of a long drain must still be writable.\n441\t\t\t_ = conn.SetDeadline(time.Now().Add(drain + requestDeadline))\n442\t\t\treply := s.drain(drain)\n443\t\t\twriteReply(conn, reply)\n444\t\tdefault:\n445\t\t\tif s.opts.Handler != nil {\n446\t\t\t\t// A hosted operation is its own handshake: it carries the caller's identity, and a\n447\t\t\t\t// caller of another engine, build, protocol, schema or worktree is refused before the\n448\t\t\t\t// handler sees it, whatever the caller handshook with a moment before.\n449\t\t\t\tif req.Identity == nil {\n450\t\t\t\t\twriteReply(conn, Reply{Error: \"a hosted operation carries the caller's identity\"})\n451\t\t\t\t\treturn\n452\t\t\t\t}\n453\t\t\t\tif mism := s.opts.Identity.Mismatches(*req.Identity); len(mism) > 0 {\n454\t\t\t\t\twriteReply(conn, Reply{Mismatch: mism, Error: \"incompatible\", PID: os.Getpid()})\n455\t\t\t\t\treturn\n456\t\t\t\t}\n457\t\t\t\t// The reply of a long operation must still be writable.\n458\t\t\t\t_ = conn.SetDeadline(time.Now().Add(hostedDuration(req.DeadlineMS) + requestDeadline))\n459\t\t\t\tif reply, ok := s.opts.Handler(ctx, req); ok {\n460\t\t\t\t\tid := s.opts.Identity\n461\t\t\t\t\treply.Identity, reply.Epoch, reply.PID = &id, s.epoch, os.Getpid()\n462\t\t\t\t\twriteReply(conn, reply)\n463\t\t\t\t\treturn\n464\t\t\t\t}\n465\t\t\t}\n466\t\t\twriteReply(conn, Reply{Error: fmt.Sprintf(\"the runtime does not host the operation %q\", req.Op)})\n467\t\t}\n468\t}\n469\t\n470\t// drain waits, up to the deadline, for the requests in flight besides this one.\n471\tfunc (s *server) drain(deadline time.Duration) Reply {\n472\t\tbefore := s.inflight.Load() + s.busy() - 1\n473\t\tend := time.Now().Add(deadline)\n474\t\tfor s.inflight.Load()+s.busy() > 1 && time.Now().Before(end) {\n475\t\t\ttime.Sleep(5 * time.Millisecond)\n476\t\t}\n477\t\tleft := s.inflight.Load() + s.busy() - 1\n478\t\tif left < 0 {\n479\t\t\tleft = 0\n480\t\t}\n481\t\tif before < 0 {\n482\t\t\tbefore = 0\n483\t\t}\n484\t\tr := s.state(true)\n485\t\tr.Drained, r.Abandoned = before-left, left\n486\t\treturn r\n487\t}\n488\t\n489\tfunc (s *server) busy() int64 {\n490\t\tif s.opts.Busy == nil {\n491\t\t\treturn 0\n492\t\t}\n493\t\treturn s.opts.Busy()\n494\t}\n495\t\n496\tfunc (s *server) state(ok bool) Reply {\n497\t\tid := s.opts.Identity\n498\t\tvar metrics map[string]int64\n499\t\tif s.opts.Metrics != nil {\n500\t\t\tmetrics = s.opts.Metrics()\n501\t\t}\n502\t\treturn Reply{Metrics: metrics, OK: ok, Identity: &id, Epoch: s.epoch, PID: os.Getpid(), StartedAt: s.started.UTC().Format(time.RFC3339),\n503\t\t\tUptimeMS: time.Since(s.started).Milliseconds(), IdleMS: s.opts.Idle.Milliseconds(), InFlight: s.inflight.Load() + s.busy() - 1, Served: s.served.Load()}\n504\t}\n505\t\n506\tfunc writeReply(conn net.Conn, r Reply) {\n507\t\t// Without HTML escaping a < or & in a command's output costs one byte, not six; the output\n508\t\t// travels as UTF-8 text, so bytes that are not valid UTF-8 come back replaced.\n509\t\tvar buf bytes.Buffer"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"62d05749-c40c-46a6-b567-0cbca1fc875c","timestamp":"2026-11-10T11:41:09.525Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2687461199/worktree/pose-mcp/internal/worktreeruntime/runtime.go","content":"type server struct {\n\topts     Options\n\tlistener net.Listener\n\tepoch    string\n\tstarted  time.Time\n\tlast     int64 // unix nanos of the last request, atomic\n\tinflight atomic.Int64\n\tserved   atomic.Int64\n\twg       sync.WaitGroup\n\tdone     chan struct{}\n\tonce     sync.Once\n}\n\nfunc (s *server) run(ctx context.Context) error {\n\tgo func() {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\ts.shutdown()\n\t\tcase <-s.done:\n\t\t}\n\t}()\n\tif s.opts.Idle > 0 {\n\t\tgo s.watchIdle()\n\t}\n\tfor {\n\t\tconn, err := s.listener.Accept()\n\t\tif err != nil {\n\t\t\tselect {\n\t\t\tcase <-s.done:\n\t\t\t\ts.wg.Wait()\n\t\t\t\treturn nil\n\t\t\tdefault:\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\ts.inflight.Add(1)\n\t\ts.wg.Add(1)\n\t\tgo func() {\n\t\t\tdefer s.wg.Done()\n\t\t\tdefer s.inflight.Add(-1)\n\t\t\ts.handle(ctx, conn)\n\t\t}()\n\t}\n}\n\nfunc (s *server) shutdown() { s.once.Do(func() { close(s.done); s.listener.Close() }) }\n\nfunc (s *server) watchIdle() {\n\ttick := time.NewTicker(minDuration(s.opts.Idle/4, time.Second))\n\tdefer tick.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-s.done:\n\t\t\treturn\n\t\tcase <-tick.C:\n\t\t\tif s.inflight.Load()+s.busy() == 0 && time.Since(time.Unix(0, atomic.LoadInt64(&s.last))) >= s.opts.Idle {\n\t\t\t\ts.shutdown()\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc minDuration(a, b time.Duration) time.Duration {\n\tif a < b && a > 0 {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc (s *server) handle(ctx context.Context, conn net.Conn) {\n\tdefer conn.Close()\n\tatomic.StoreInt64(&s.last, time.Now().UnixNano())\n\t// The operating system says who is on the other end before a byte of it is read.\n\tif uc, ok := conn.(*net.UnixConn); !ok {\n\t\treturn\n\t} else if uid, err := peerUID(uc); err != nil || int(uid) != os.Getuid() {\n\t\treturn\n\t}\n\t_ = conn.SetDeadline(time.Now().Add(requestDeadline))\n\tline, err := bufio.NewReaderSize(io.LimitReader(conn, maxRequest), 4096).ReadBytes('\\n')\n\tif err != nil && len(line) == 0 {\n\t\treturn\n\t}\n\tvar req Request\n\tif err := json.Unmarshal(line, &req); err != nil {\n\t\twriteReply(conn, Reply{Error: \"the request is not valid JSON\"})\n\t\treturn\n\t}\n\ts.served.Add(1)\n\tswitch req.Op {\n\tcase \"handshake\":\n\t\tif req.Identity == nil {\n\t\t\twriteReply(conn, Reply{Error: \"a handshake carries the client's identity\"})\n\t\t\treturn\n\t\t}\n\t\tif mism := s.opts.Identity.Mismatches(*req.Identity); len(mism) > 0 {\n\t\t\twriteReply(conn, Reply{Mismatch: mism, Error: \"incompatible\", PID: os.Getpid()})\n\t\t\treturn\n\t\t}\n\t\twriteReply(conn, s.state(true))\n\tcase \"status\":\n\t\twriteReply(conn, s.state(true))\n\tcase \"stop\":\n\t\tdrain := defaultDrain\n\t\tif req.DrainMS > 0 {\n\t\t\tdrain = time.Duration(req.DrainMS) * time.Millisecond\n\t\t}\n\t\t// No new connection is accepted while the requests in flight drain.\n\t\ts.shutdown()\n\t\t// The reply of a long drain must still be writable.\n\t\t_ = conn.SetDeadline(time.Now().Add(drain + requestDeadline))\n\t\treply := s.drain(drain)\n\t\twriteReply(conn, reply)\n\tdefault:\n\t\tif s.opts.Handler != nil {\n\t\t\t// A hosted operation is its own handshake: it carries the caller's identity, and a\n\t\t\t// caller of another engine, build, protocol, schema or worktree is refused before the\n\t\t\t// handler sees it, whatever the caller handshook with a moment before.\n\t\t\tif req.Identity == nil {\n\t\t\t\twriteReply(conn, Reply{Error: \"a hosted operation carries the caller's identity\"})\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif mism := s.opts.Identity.Mismatches(*req.Identity); len(mism) > 0 {\n\t\t\t\twriteReply(conn, Reply{Mismatch: mism, Error: \"incompatible\", PID: os.Getpid()})\n\t\t\t\treturn\n\t\t\t}\n\t\t\t// The reply of a long operation must still be writable.\n\t\t\t_ = conn.SetDeadline(time.Now().Add(hostedDuration(req.DeadlineMS) + requestDeadline))\n\t\t\tif reply, ok := s.opts.Handler(ctx, req); ok {\n\t\t\t\tid := s.opts.Identity\n\t\t\t\treply.Identity, reply.Epoch, reply.PID = &id, s.epoch, os.Getpid()\n\t\t\t\twriteReply(conn, reply)\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\twriteReply(conn, Reply{Error: fmt.Sprintf(\"the runtime does not host the operation %q\", req.Op)})\n\t}\n}\n\n// drain waits, up to the deadline, for the requests in flight besides this one.\nfunc (s *server) drain(deadline time.Duration) Reply {\n\tbefore := s.inflight.Load() + s.busy() - 1\n\tend := time.Now().Add(deadline)\n\tfor s.inflight.Load()+s.busy() > 1 && time.Now().Before(end) {\n\t\ttime.Sleep(5 * time.Millisecond)\n\t}\n\tleft := s.inflight.Load() + s.busy() - 1\n\tif left < 0 {\n\t\tleft = 0\n\t}\n\tif before < 0 {\n\t\tbefore = 0\n\t}\n\tr := s.state(true)\n\tr.Drained, r.Abandoned = before-left, left\n\treturn r\n}\n\nfunc (s *server) busy() int64 {\n\tif s.opts.Busy == nil {\n\t\treturn 0\n\t}\n\treturn s.opts.Busy()\n}\n\nfunc (s *server) state(ok bool) Reply {\n\tid := s.opts.Identity\n\tvar metrics map[string]int64\n\tif s.opts.Metrics != nil {\n\t\tmetrics = s.opts.Metrics()\n\t}\n\treturn Reply{Metrics: metrics, OK: ok, Identity: &id, Epoch: s.epoch, PID: os.Getpid(), StartedAt: s.started.UTC().Format(time.RFC3339),\n\t\tUptimeMS: time.Since(s.started).Milliseconds(), IdleMS: s.opts.Idle.Milliseconds(), InFlight: s.inflight.Load() + s.busy() - 1, Served: s.served.Load()}\n}\n\nfunc writeReply(conn net.Conn, r Reply) {\n\t// Without HTML escaping a < or & in a command's output costs one byte, not six; the output\n\t// travels as UTF-8 text, so bytes that are not valid UTF-8 come back replaced.\n\tvar buf bytes.Buffer","numLines":180,"startLine":330,"totalLines":655}},"tool_result_meta":[{"id":"toolu_01TbixWMtyeRRMvkTa5LmX6i","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
