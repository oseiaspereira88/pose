{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NNjLyMLneBi69qke7P5eqd","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"container/list\"\n5\t\t\"crypto/sha256\"\n6\t\t\"encoding/hex\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"strings\"\n10\t\t\"sync\"\n11\t\t\"sync/atomic\"\n12\t)\n13\t\n14\t// ResidentGitMemo keeps, in a process that outlives one operation, the output of the Git reads\n15\t// that are pure functions of object ids or of the commit HEAD named when they ran (see\n16\t// governancePureGitRead). It is off unless a process turns it on, so nothing changes for a\n17\t// command that runs once; the optional worktree runtime turns it on (spec\n18\t// pose-worktree-runtime-resident-cache). A hit is the answer Git would give: the key\n19\t// holds the commit and the shallow state, and the output of such a read cannot differ for them.\n20\ttype ResidentGitMemo struct {\n21\t\tmu      sync.Mutex\n22\t\tmax     int64\n23\t\tbytes   int64\n24\t\tentries map[string]*list.Element\n25\t\torder   *list.List // front is the most recently used\n26\t\thits    atomic.Int64\n27\t\tmisses  atomic.Int64\n28\t}\n29\t\n30\ttype residentGitEntry struct {\n31\t\tkey    string\n32\t\tstdout []byte\n33\t}\n34\t\n35\tvar residentGit atomic.Pointer[ResidentGitMemo]\n36\t\n37\t// EnableResidentGitMemo turns the memo on with a byte budget for what it retains.\n38\tfunc EnableResidentGitMemo(maxBytes int64) *ResidentGitMemo {\n39\t\tm := &ResidentGitMemo{max: maxBytes, entries: map[string]*list.Element{}, order: list.New()}\n40\t\tresidentGit.Store(m)\n41\t\treturn m\n42\t}\n43\t\n44\t// DisableResidentGitMemo turns the memo off and drops what it held.\n45\tfunc DisableResidentGitMemo() { residentGit.Store(nil) }\n46\t\n47\t// ResidentGitMemoStats are the hits, misses, entries and retained bytes since it was enabled.\n48\tfunc ResidentGitMemoStats() (hits, misses int64, entries int, bytes int64) {\n49\t\tm := residentGit.Load()\n50\t\tif m == nil {\n51\t\t\treturn 0, 0, 0, 0\n52\t\t}\n53\t\tm.mu.Lock()\n54\t\tdefer m.mu.Unlock()\n55\t\treturn m.hits.Load(), m.misses.Load(), len(m.entries), m.bytes\n56\t}\n57\t\n58\t// residentGitKey names a read: the root, the commit it was made at (empty for a read by object\n59\t// id), the shallow state of the repository and the exact command. A root whose Git directory\n60\t// is not a plain .git directory is not memoized: its shallow state is not read here.\n61\tfunc residentGitKey(root, head string, args []string) (string, bool) {\n62\t\tgitDir := filepath.Join(root, \".git\")\n63\t\tinfo, err := os.Lstat(gitDir)\n64\t\tif err != nil || !info.IsDir() {\n65\t\t\treturn \"\", false\n66\t\t}\n67\t\t// The shallow file and the repository config are small: their content, not a timestamp,\n68\t\t// is part of the key.\n69\t\tdigestOf := func(name string) string {\n70\t\t\traw, err := os.ReadFile(filepath.Join(gitDir, name))\n71\t\t\tif err != nil {\n72\t\t\t\treturn \"-\"\n73\t\t\t}\n74\t\t\tsum := sha256.Sum256(raw)\n75\t\t\treturn hex.EncodeToString(sum[:8])\n76\t\t}\n77\t\tshallow := digestOf(\"shallow\")\n78\t\t// The repository's own config can change what a read answers (log.follow, for one).\n79\t\tconfig := digestOf(\"config\")\n80\t\treturn strings.Join([]string{filepath.Clean(root), head, shallow, config, strings.Join(args, \"\\x00\")}, \"\\x01\"), true\n81\t}\n82\t\n83\tfunc (m *ResidentGitMemo) get(key string) ([]byte, bool) {\n84\t\tm.mu.Lock()\n85\t\tdefer m.mu.Unlock()\n86\t\tel, ok := m.entries[key]\n87\t\tif !ok {\n88\t\t\tm.misses.Add(1)\n89\t\t\treturn nil, false\n90\t\t}\n91\t\tm.order.MoveToFront(el)\n92\t\tm.hits.Add(1)\n93\t\treturn append([]byte(nil), el.Value.(*residentGitEntry).stdout...), true\n94\t}\n95\t\n96\tfunc (m *ResidentGitMemo) put(key string, stdout []byte) {\n97\t\tsize := int64(len(key) + len(stdout))\n98\t\tm.mu.Lock()\n99\t\tdefer m.mu.Unlock()\n100\t\tif size > m.max {\n101\t\t\treturn\n102\t\t}\n103\t\tif el, ok := m.entries[key]; ok {\n104\t\t\tm.bytes -= int64(len(el.Value.(*residentGitEntry).key) + len(el.Value.(*residentGitEntry).stdout))\n105\t\t\tm.order.Remove(el)\n106\t\t\tdelete(m.entries, key)\n107\t\t}\n108\t\tfor m.bytes+size > m.max {\n109\t\t\tlast := m.order.Back()\n110\t\t\tif last == nil {\n111\t\t\t\tbreak\n112\t\t\t}\n113\t\t\te := last.Value.(*residentGitEntry)\n114\t\t\tm.bytes -= int64(len(e.key) + len(e.stdout))\n115\t\t\tm.order.Remove(last)\n116\t\t\tdelete(m.entries, e.key)\n117\t\t}\n118\t\tm.entries[key] = m.order.PushFront(&residentGitEntry{key: key, stdout: append([]byte(nil), stdout...)})\n119\t\tm.bytes += size\n120\t}\n121\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"6fd5df44-b60b-487b-8ece-5546b12672ca","timestamp":"2026-11-10T11:41:26.929Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2687461199/worktree/pose-mcp/internal/pose/resident_git_memo.go","content":"package pose\n\nimport (\n\t\"container/list\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n)\n\n// ResidentGitMemo keeps, in a process that outlives one operation, the output of the Git reads\n// that are pure functions of object ids or of the commit HEAD named when they ran (see\n// governancePureGitRead). It is off unless a process turns it on, so nothing changes for a\n// command that runs once; the optional worktree runtime turns it on (spec\n// pose-worktree-runtime-resident-cache). A hit is the answer Git would give: the key\n// holds the commit and the shallow state, and the output of such a read cannot differ for them.\ntype ResidentGitMemo struct {\n\tmu      sync.Mutex\n\tmax     int64\n\tbytes   int64\n\tentries map[string]*list.Element\n\torder   *list.List // front is the most recently used\n\thits    atomic.Int64\n\tmisses  atomic.Int64\n}\n\ntype residentGitEntry struct {\n\tkey    string\n\tstdout []byte\n}\n\nvar residentGit atomic.Pointer[ResidentGitMemo]\n\n// EnableResidentGitMemo turns the memo on with a byte budget for what it retains.\nfunc EnableResidentGitMemo(maxBytes int64) *ResidentGitMemo {\n\tm := &ResidentGitMemo{max: maxBytes, entries: map[string]*list.Element{}, order: list.New()}\n\tresidentGit.Store(m)\n\treturn m\n}\n\n// DisableResidentGitMemo turns the memo off and drops what it held.\nfunc DisableResidentGitMemo() { residentGit.Store(nil) }\n\n// ResidentGitMemoStats are the hits, misses, entries and retained bytes since it was enabled.\nfunc ResidentGitMemoStats() (hits, misses int64, entries int, bytes int64) {\n\tm := residentGit.Load()\n\tif m == nil {\n\t\treturn 0, 0, 0, 0\n\t}\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\treturn m.hits.Load(), m.misses.Load(), len(m.entries), m.bytes\n}\n\n// residentGitKey names a read: the root, the commit it was made at (empty for a read by object\n// id), the shallow state of the repository and the exact command. A root whose Git directory\n// is not a plain .git directory is not memoized: its shallow state is not read here.\nfunc residentGitKey(root, head string, args []string) (string, bool) {\n\tgitDir := filepath.Join(root, \".git\")\n\tinfo, err := os.Lstat(gitDir)\n\tif err != nil || !info.IsDir() {\n\t\treturn \"\", false\n\t}\n\t// The shallow file and the repository config are small: their content, not a timestamp,\n\t// is part of the key.\n\tdigestOf := func(name string) string {\n\t\traw, err := os.ReadFile(filepath.Join(gitDir, name))\n\t\tif err != nil {\n\t\t\treturn \"-\"\n\t\t}\n\t\tsum := sha256.Sum256(raw)\n\t\treturn hex.EncodeToString(sum[:8])\n\t}\n\tshallow := digestOf(\"shallow\")\n\t// The repository's own config can change what a read answers (log.follow, for one).\n\tconfig := digestOf(\"config\")\n\treturn strings.Join([]string{filepath.Clean(root), head, shallow, config, strings.Join(args, \"\\x00\")}, \"\\x01\"), true\n}\n\nfunc (m *ResidentGitMemo) get(key string) ([]byte, bool) {\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\tel, ok := m.entries[key]\n\tif !ok {\n\t\tm.misses.Add(1)\n\t\treturn nil, false\n\t}\n\tm.order.MoveToFront(el)\n\tm.hits.Add(1)\n\treturn append([]byte(nil), el.Value.(*residentGitEntry).stdout...), true\n}\n\nfunc (m *ResidentGitMemo) put(key string, stdout []byte) {\n\tsize := int64(len(key) + len(stdout))\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\tif size > m.max {\n\t\treturn\n\t}\n\tif el, ok := m.entries[key]; ok {\n\t\tm.bytes -= int64(len(el.Value.(*residentGitEntry).key) + len(el.Value.(*residentGitEntry).stdout))\n\t\tm.order.Remove(el)\n\t\tdelete(m.entries, key)\n\t}\n\tfor m.bytes+size > m.max {\n\t\tlast := m.order.Back()\n\t\tif last == nil {\n\t\t\tbreak\n\t\t}\n\t\te := last.Value.(*residentGitEntry)\n\t\tm.bytes -= int64(len(e.key) + len(e.stdout))\n\t\tm.order.Remove(last)\n\t\tdelete(m.entries, e.key)\n\t}\n\tm.entries[key] = m.order.PushFront(&residentGitEntry{key: key, stdout: append([]byte(nil), stdout...)})\n\tm.bytes += size\n}\n","numLines":121,"startLine":1,"totalLines":121}},"tool_result_meta":[{"id":"toolu_01NNjLyMLneBi69qke7P5eqd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
