{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015RYZ33a4FzQBvoaJpazCpz","type":"tool_result","content":"60-\n61-// CaptureGovernanceGitIn executes one bounded raw-history Git command through\n62-// the operation's captured read view when Files carries one. maxOutputBytes\n63-// bounds combined stdout and stderr before bytes are retained. Git commands\n64:// use gitCommand, which disables replacement refs and grafts.\n65-func CaptureGovernanceGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n66-\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n67-\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n68-\t}\n--\n327-\t\tstate.mu.Unlock()\n328-\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its Git input byte budget\")\n329-\t\treturn nil, errGovernanceReadViewBudget\n330-\t}\n331:\tbyObject, byHead := governancePureGitRead(args)\n332-\theadBefore := \"\"\n333-\tif byHead {\n334-\t\theadBefore = governanceHeadAt(ctx, files, root)\n335-\t}\n--\n337-\t// admitted against the operation's budget as a fresh read's are.\n338-\tvar stdout, stderr []byte\n339-\tvar runErr error\n340-\tmemoKey, memoized := \"\", false\n341:\tmemo := residentGit.Load()\n342-\tif memo != nil && (byObject || byHead && headBefore != \"\") {\n343:\t\tif key, ok := residentGitKey(root, headBefore, args); ok {\n344-\t\t\tmemoKey = key\n345-\t\t\tif hit, found := memo.get(key); found {\n346-\t\t\t\tif int64(len(hit)) > limit || !state.op.reserveInput(int64(len(hit))) {\n347-\t\t\t\t\tstate.mu.Unlock()\n--\n595-\tfiles = FilesOrNative(files)\n596-\tif ctx == nil {\n597-\t\tctx = context.Background()\n598-\t}\n599:\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n600-\tcmd.WaitDelay = 2 * time.Second\n601-\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\"