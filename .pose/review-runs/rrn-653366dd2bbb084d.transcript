git status` refreshes\n+\t// and rewrites the index, which a governed read view that watches .git reads as an input that\n+\t// changed during the operation (spec pose-git-status-leaves-the-git-directory-alone).\n+\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n \tout, err := cmd.Output()\n \tif err != nil {\n \t\treturn nil, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\ndiff --git a/pose-mcp/internal/pose/git_status_leaves_git_dir_test.go b/pose-mcp/internal/pose/git_status_leaves_git_dir_test.go\nnew file mode 100644\nindex 00000000..e41e7ba9\n--- /dev/null\n+++ b/pose-mcp/internal/pose/git_status_leaves_git_dir_test.go\n@@ -0,0 +1,40 @@\n+package pose\n+\n+import (\n+\t\"bytes\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+// Spec pose-git-status-leaves-the-git-directory-alone.\n+\n+// Asking which paths changed writes nothing under .git: a stale stat cache in the index is left\n+// as it is, so a governed read view that watches .git does not see its own question as a change.\n+func TestGitChangedPathsWritesNothingUnderTheGitDirectory(t *testing.T) {\n+\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\", \"b.md\": \"two\\n\"})\n+\t// The content is the same and the stat data is not: a plain `git status` refreshes the index.\n+\tlater := time.Now().Add(2 * time.Hour)\n+\tif err := os.Chtimes(filepath.Join(root, \"a.md\"), later, later); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tindexPath := filepath.Join(root, \".git\", \"index\")\n+\tbefore, err := os.ReadFile(indexPath)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif _, err := gitChangedPaths(root); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tafter, err := os.ReadFile(indexPath)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif !bytes.Equal(before, after) {\n+\t\tt.Fatal(\"asking for the changed paths rewrote .git/index\")\n+\t}\n+\tif _, err := os.Lstat(filepath.Join(root, \".git\", \"index.lock\")); err == nil {\n+\t\tt.Fatal(\"a lock file was left under .git\")\n+\t}\n+}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"38bb0044-5c2e-4e2c-9442-f63f343e0514","timestamp":"2026-11-10T15:08:24.827Z","tool_use_result":{"stdout":" ...se-git-status-leaves-the-git-directory-alone.md |    6 +\n .pose/indexes/delivery-integrity.json              | 6890 ++++++++++----------\n .pose/indexes/generation.json                      |   24 +-\n .pose/indexes/releases.json                        |    8 +\n .pose/indexes/spec-graph.json                      | 1160 ++--\n .pose/indexes/validation-matrix.json               |   13 +\n .pose/results/delivery-validation.json             | 1571 ++---\n ...se-git-status-leaves-the-git-directory-alone.md |  116 +\n ...-git-status-leaves-the-git-directory-alone.json |   41 +\n pose-mcp/internal/pose/git_snapshot_integrity.go   |    4 +\n .../pose/git_status_leaves_git_dir_test.go         |   40 +\n 11 files changed, 5113 insertions(+), 4760 deletions(-)\ndiff --git a/.pose/changelogs/unreleased/pose-git-status-leaves-the-git-directory-alone.md b/.pose/changelogs/unreleased/pose-git-status-leaves-the-git-directory-alone.md\nnew file mode 100644\nindex 00000000..7d08ef43\n--- /dev/null\n+++ b/.pose/changelogs/unreleased/pose-git-status-leaves-the-git-directory-alone.md\n@@ -0,0 +1,6 @@\n+---\n+spec: pose-git-status-leaves-the-git-directory-alone\n+category: fixed\n+breaking: false\n+---\n+O `git status` do snapshot de integridade deixa de reescrever o índice sob `.git` (`GIT_OPTIONAL_LOCKS=0`); em instâncias com submódulos, os closeouts de review deixam de sair com \"review inputs changed during operation: .git\" por causa da própria pergunta ao Git.\ndiff --git a/.pose/starts/pose-git-status-leaves-the-git-directory-alone.json b/.pose/starts/pose-git-status-leaves-the-git-directory-alone.json\nnew file mode 100644\nindex 00000000..44229c20\n--- /dev/null\n+++ b/.pose/starts/pose-git-status-leaves-the-git-directory-alone.json\n@@ -0,0 +1,41 