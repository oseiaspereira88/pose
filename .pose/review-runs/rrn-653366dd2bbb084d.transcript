{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ByotngJkAdBx4HKQPxyzAJ","type":"tool_result","content":"100\t\tCause     error\n101\t}\n102\t\n103\tfunc (e *GitSnapshotError) Error() string {\n104\t\treturn fmt.Sprintf(\"pose: Git snapshot unavailable (%s): %v\", e.Operation, e.Cause)\n105\t}\n106\tfunc (e *GitSnapshotError) Unwrap() error { return e.Cause }\n107\t\n108\tfunc snapshotGit(root string, args ...string) ([]byte, error) {\n109\t\tcmd := gitCommand(append([]string{\"-C\", root}, args...)...)\n110\t\t// Asking about the worktree writes nothing under .git: without this `git status` refreshes\n111\t\t// and rewrites the index, which a governed read view that watches .git reads as an input that\n112\t\t// changed during the operation (spec pose-git-status-leaves-the-git-directory-alone).\n113\t\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n114\t\tout, err := cmd.Output()\n115\t\tif err != nil {\n116\t\t\treturn nil, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n117\t\t}\n118\t\treturn out, nil\n119\t}\n120\t\n121\t// gitChangedPaths uses the NUL protocol; porcelain's quoted display is not a path.\n122\tfunc gitChangedPaths(root string) ([]string, error) {\n123\t\tout, err := snapshotGit(root, \"status\", \"--porcelain=v1\", \"-z\", \"--untracked-files=all\", \"--ignore-submodules=none\")\n124\t\tif err != nil {\n125\t\t\treturn nil, err\n126\t\t}\n127\t\tentries, err := parseGitStatusEntries(out)\n128\t\tif err != nil {\n129\t\t\treturn nil, err\n130\t\t}\n131\t\tpaths := make([]string, 0, len(entries)*2)\n132\t\tfor _, entry := range entries {\n133\t\t\tif untrackedAuthorityTransferLock(entry) {\n134\t\t\t\tcontinue\n135\t\t\t}\n136\t\t\tpaths = append(paths, entry.Path)\n137\t\t\tif entry.OrigPath != \"\" {\n138\t\t\t\tpaths = append(paths, entry.OrigPath)\n139\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"ec13a4ee-0c3f-4179-b7c1-a3e8601a943f","timestamp":"2026-11-10T1