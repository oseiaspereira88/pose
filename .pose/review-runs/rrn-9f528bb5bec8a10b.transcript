{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '190,330p' pose-mcp/internal/cli/artifact_integrity.go\"","aggregated_output":"func resolveGitChangeSetWithTrailers(root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\n\treturn resolveGitChangeSetWithTrailersAndFiles(nil, root, spec, base, head, captured)\n}\n\nfunc resolveGitChangeSetWithTrailersIn(files posemodel.Files, root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\n\treturn resolveGitChangeSetWithTrailersAndFiles(files, root, spec, base, head, captured)\n}\n\nfunc resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\n\tgitOutput := func(limit int, args ...string) ([]byte, error) {\n\t\tif files == nil {\n\t\t\treturn gitOutputBounded(root, limit, args...)\n\t\t}\n\t\treturn gitOutputBoundedIn(files, root, limit, args...)\n\t}\n\tresolveRevision := func(revision string) (string, error) {\n\t\treturn resolveGitRevisionWithFiles(files, root, revision)\n\t}\n\tif spec == \"\" || posemodel.ValidateSlug(spec) != nil {\n\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"a valid spec slug is required\")\n\t}\n\tselector := \"range:\" + base + \"..\" + head\n\tvar trailerCommits []string\n\tif base == \"\" && head == \"\" {\n\t\tcommits := append([]string(nil), captured...)\n\t\tif len(commits) == 0 {\n\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"no commits carry POSE-Spec: %s\", spec)\n\t\t}\n\t\ttrailerCommits = commits\n\t\thead = commits[len(commits)-1]\n\t\tbase = commits[0] + \"^\"\n\t\tselector = \"trailers:\" + spec\n\t} else if base == \"\" || head == \"\" {\n\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"--from and --to must be supplied together\")\n\t}\n\tresolvedBase := base\n\tif !posemodel.IsGitEmptyTree(base) {\n\t\tvar err error\n\t\tif resolvedBase, err = resolveRevision(base); err != nil && len(trailerCommits) > 0 {\n\t\t\tvar isRoot bool\n\t\t\tvar headerErr error\n\t\t\tif files == nil {\n\t\t\t\tisRoot, headerErr = commitHasNoParent(root, trailerCommits[0])\n\t\t\t} else {\n\t\t\t\tisRoot, headerErr = commitHasNoParentIn(files, root, trailerCommits[0])\n\t\t\t}\n\t\t\tif headerErr != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"%w; %v\", err, headerErr)\n\t\t\t}\n\t\t\tif isRoot {\n\t\t\t\tbase, resolvedBase, err = posemodel.GitEmptyTree(trailerCommits[0]), posemodel.GitEmptyTree(trailerCommits[0]), nil\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n\t}\n\tresolvedHead, err := resolveRevision(head)\n\tif err != nil {\n\t\treturn posemodel.ChangeSet{}, err\n\t}\n\tcommitsRaw, err := gitOutput(4*1024*1024, \"rev-list\", \"--reverse\", posemodel.ChangeSetRange(resolvedBase, resolvedHead), \"--\")\n\tif err != nil {\n\t\treturn posemodel.ChangeSet{}, err\n\t}\n\tcommits := splitNonEmpty(string(commitsRaw), \"\\n\")\n\n\tvar paths []posemodel.ObservedPath\n\t// observed keeps every commit's own path records, unmerged: folding a create\n\t// and a later rename into one creation would hide that the file moved into an\n\t// administrative class.\n\tvar observed []posemodel.ObservedPath\n\tdiffHash := sha256.New()\n\tif len(trailerCommits) > 0 {\n\t\tcommits = trailerCommits\n\t\tcommitPathLists := make([][]posemodel.ObservedPath, 0, len(commits))\n\t\tfor _, sha := range commits {\n\t\t\tnameStatus, err := gitOutput(4*1024*1024, \"diff-tree\", \"--root\", \"--no-commit-id\", \"--name-status\", \"-z\", \"-M\", \"-r\", sha, \"--\")\n\t\t\tif err != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, err\n\t\t\t}\n\t\t\tparsed, err := parseGitNameStatusNUL(nameStatus)\n\t\t\tif err != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, err\n\t\t\t}\n\t\t\tcommitPathLists = append(commitPathLists, parsed)\n\t\t\tobserved = append(observed, parsed...)\n\t\t\tcommitDiff, err := gitOutput(16*1024*1024, \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", sha, \"--\")\n\t\t\tif err != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, err\n\t\t\t}\n\t\t\t_, _ = diffHash.Write(commitDiff)\n\t\t}\n\t\tpaths = mergeObservedPaths(commitPathLists)\n\t} else {\n\t\tnameStatus, err := gitOutput(8*1024*1024, \"diff\", \"--name-status\", \"-z\", \"-M\", \"--no-ext-diff\", resolvedBase, resolvedHead, \"--\")\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n\t\tpaths, err = parseGitNameStatusNUL(nameStatus)\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n\t\tdiff, err := gitOutput(32*1024*1024, \"diff\", \"--binary\", \"--no-ext-diff\", resolvedBase, resolvedHead, \"--\")\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n\t\t_, _ = diffHash.Write(diff)\n\t\t// The net diff folds a create and a later rename into one creation; the\n\t\t// material inputs need each commit's own records.\n\t\tfor _, sha := range commits {\n\t\t\tperCommit, err := gitOutput(4*1024*1024, \"diff-tree\", \"--root\", \"--no-commit-id\", \"--name-status\", \"-z\", \"-M\", \"-r\", sha, \"--\")\n\t\t\tif err != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, err\n\t\t\t}\n\t\t\tparsed, err := parseGitNameStatusNUL(perCommit)\n\t\t\tif err != nil {\n\t\t\t\treturn posemodel.ChangeSet{}, err\n\t\t\t}\n\t\t\tobserved = append(observed, parsed...)\n\t\t}\n\t}\n\tdigest := diffHash.Sum(nil)\n\tidSum := sha256.Sum256([]byte(spec + \"\\x00\" + resolvedBase + \"\\x00\" + resolvedHead + \"\\x00\" + hex.EncodeToString(digest[:])))\n\t// A trailer set is judged against the checkout's own tree: a later commit\n\t// without the trailer that changes an observed path or the matrix must move\n\t// the digest. An explicit range is a historical query and reads its end.\n\tmaterialHead := resolvedHead\n\tif len(trailerCommits) > 0 {\n\t\tmaterialHead = \"HEAD\"\n\t}\n\tif len(observed) == 0 {\n\t\tobserved = paths\n\t}\n\tmaterialInputs := posemodel.MaterialInputsOf(observed)\n\tmaterialDigest := materialSetDigestAt(gitOutput, root, materialHead, materialInputs)\n\treturn posemodel.ChangeSet{ID: \"cs-\" + hex.EncodeToString(idSum[:6]), Spec: spec, Selector: selector, Base: base, Head: head, ResolvedBase: resolvedBase, ResolvedHead: resolvedHead, Commits: commits, Paths: paths, DiffDigest: \"sha256:\" + hex.EncodeToString(digest[:]), MaterialDigest: materialDigest, MaterialInputs: &materialInputs}, nil\n}\n\nfunc allCommitsWithSpecTrailers(root string) (map[string][]string, error) {\n\t// A rolling commit limit changes historical attribution whenever an unrelated\n","exit_code":0,"status":"completed"}}
