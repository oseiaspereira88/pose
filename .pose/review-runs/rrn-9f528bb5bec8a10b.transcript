{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/closeout_adr_associations.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// ADR associations of a roadmap, for the when-justified roadmap rule of the\n     4\t// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n     5\t//\n     6\t// An association is explicit, never inferred from prose:\n     7\t//   - forward: the roadmap's `adrs: [adr:<file>.md]` frontmatter, or a local\n     8\t//     Markdown link from its body to a file in .pose/adr/;\n     9\t//   - backward: an ADR's `roadmaps: [roadmap:<slug>]` (or the qualified\n    10\t//     `xref:<project>/roadmap:<slug>`) frontmatter, or a local Markdown link\n    11\t//     from the ADR to .pose/roadmaps/<slug>.md.\n    12\t//\n    13\t// Only the owning project's .pose/adr/ is inventoried; nothing searches other\n    14\t// projects. A malformed declaration, a link to a missing file or an\n    15\t// incomplete inventory is unknown, which can never prove absence.\n    16\t\n    17\timport (\n    18\t\t\"fmt\"\n    19\t\t\"html\"\n    20\t\t\"net/url\"\n    21\t\t\"os\"\n    22\t\t\"path/filepath\"\n    23\t\t\"regexp\"\n    24\t\t\"sort\"\n    25\t\t\"strings\"\n    26\t)\n    27\t\n    28\tconst (\n    29\t\tcloseoutADRInventoryLimit = 4096\n    30\t\tcloseoutADRSizeLimit      = 1 << 20\n    31\t)\n    32\t\n    33\tvar (\n    34\t\t// [text](dest \"title\") and [text](<dest>) inline links.\n    35\t\tmarkdownInlineLinkRE = regexp.MustCompile(`\\]\\(\\s*(<[^>\\n]*>|[^)\\s]+)(?:\\s+(?:\"[^\"]*\"|'[^']*'|\\([^)]*\\)))?\\s*\\)`)\n    36\t\t// [label]: dest \"title\" reference definitions.\n    37\t\tmarkdownReferenceLinkRE = regexp.MustCompile(`(?m)^\\s{0,3}\\[[^\\]\\n]+\\]:\\s*(<[^>\\n]*>|\\S+)`)\n    38\t)\n    39\t\n    40\tfunc (s Store) adrDir() string { return filepath.Join(s.Root, \".pose\", \"adr\") }\n    41\t\n    42\t// markdownLinkDestinations lists the link destinations of a Markdown body,\n    43\t// angle brackets and fragments removed. External URLs are kept out.\n    44\tfunc markdownLinkDestinations(body string) ([]string, []string) {\n    45\t\t// Code and comments are read like prose: a link shown as an example\n    46\t\t// still counts, so the reader over-enforces rather than dropping a real\n    47\t\t// link it misparsed (review round 14, N46; follow-up F6).\n    48\t\tout, undecodable := []string{}, []string{}\n    49\t\tadd := func(raw string) {\n    50\t\t\tdest := strings.TrimSpace(raw)\n    51\t\t\tdest = strings.TrimSuffix(strings.TrimPrefix(dest, \"<\"), \">\")\n    52\t\t\t// The destination as Markdown resolves it: character references and\n    53\t\t\t// backslash escapes first, then the fragment and query, then URL\n    54\t\t\t// escapes. One that does not decode is reported, never skipped\n    55\t\t\t// (review round 15, N48).\n    56\t\t\tdest = markdownBackslashEscapeRE.ReplaceAllString(html.UnescapeString(dest), \"$1\")\n    57\t\t\tif i := strings.IndexAny(dest, \"#?\"); i >= 0 {\n    58\t\t\t\tdest = dest[:i]\n    59\t\t\t}\n    60\t\t\tdecoded, err := url.PathUnescape(dest)\n    61\t\t\tif err != nil {\n    62\t\t\t\tundecodable = append(undecodable, strings.TrimSpace(raw))\n    63\t\t\t\treturn\n    64\t\t\t}\n    65\t\t\tdest = decoded\n    66\t\t\tif dest == \"\" || strings.Contains(dest, \"://\") || strings.HasPrefix(dest, \"mailto:\") || strings.HasPrefix(dest, \"/\") {\n    67\t\t\t\treturn\n    68\t\t\t}\n    69\t\t\tout = append(out, dest)\n    70\t\t}\n    71\t\tfor _, m := range markdownInlineLinkRE.FindAllStringSubmatch(body, -1) {\n    72\t\t\tadd(m[1])\n    73\t\t}\n    74\t\tfor _, m := range markdownReferenceLinkRE.FindAllStringSubmatch(body, -1) {\n    75\t\t\tadd(m[1])\n    76\t\t}\n    77\t\treturn out, undecodable\n    78\t}\n    79\t\n    80\t// markdownBackslashEscapeRE is a CommonMark backslash escape of ASCII\n    81\t// punctuation.\n    82\tvar markdownBackslashEscapeRE = regexp.MustCompile(`\\\\([!-/:-@\\[-` + \"`\" + `{-~])`)\n    83\t\n    84\t// associationList reads one association key (adrs: on a roadmap, roadmaps: on\n    85\t// an ADR) from the raw frontmatter of a governance file, strictly: a key\n    86\t// declared more than once, declared with no value, outside a [list], or with\n    87\t// an empty item is reported, never read as an absent or empty association. An\n    88\t// explicit [] declares none (review round 12, N39).\n    89\tfunc associationList(raw, key, owner string) ([]string, bool, string) {\n    90\t\tlines := strings.Split(strings.ReplaceAll(raw, \"\\r\\n\", \"\\n\"), \"\\n\")\n    91\t\tif len(lines) == 0 || strings.TrimSpace(lines[0]) != \"---\" {\n    92\t\t\treturn nil, false, \"\"\n    93\t\t}\n    94\t\tvalues := []string{}\n    95\t\tfor _, line := range lines[1:] {\n    96\t\t\tif strings.TrimSpace(line) == \"---\" {\n    97\t\t\t\tbreak\n    98\t\t\t}\n    99\t\t\t// The key and value as SplitFrontmatter reads them: the key trimmed,\n   100\t\t\t// a template comment removed (review round 13, N45).\n   101\t\t\tif name, value, ok := strings.Cut(line, \":\"); ok && strings.TrimSpace(name) == key {\n   102\t\t\t\tvalues = append(values, cleanValue(value))\n   103\t\t\t}\n   104\t\t}\n   105\t\tswitch {\n   106\t\tcase len(values) == 0:\n   107\t\t\treturn nil, false, \"\"\n   108\t\tcase len(values) > 1:\n   109\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: %d times; one declaration is required\", owner, key, len(values))\n   110\t\t}\n   111\t\tvalue := values[0]\n   112\t\tif value == \"\" {\n   113\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with no value; declare [] for none\", owner, key)\n   114\t\t}\n   115\t\tif !strings.HasPrefix(value, \"[\") || !strings.HasSuffix(value, \"]\") {\n   116\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: outside a [list]\", owner, key)\n   117\t\t}\n   118\t\tinner := strings.TrimSpace(value[1 : len(value)-1])\n   119\t\tif inner == \"\" {\n   120\t\t\treturn []string{}, true, \"\"\n   121\t\t}\n   122\t\titems := []string{}\n   123\t\tfor _, item := range strings.Split(inner, \",\") {\n   124\t\t\titem = strings.TrimSpace(item)\n   125\t\t\tif item == \"\" {\n   126\t\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with an empty item\", owner, key)\n   127\t\t\t}\n   128\t\t\titems = append(items, item)\n   129\t\t}\n   130\t\treturn items, true, \"\"\n   131\t}\n   132\t\n   133\t// validADRBasename accepts exactly a file name ending in .md directly inside\n   134\t// .pose/adr/: no directory, traversal, hidden file or URI.\n   135\tfunc validADRBasename(name string) bool {\n   136\t\treturn name != \"\" && filepath.Base(name) == name && !strings.ContainsAny(name, `/\\:`) &&\n   137\t\t\t!strings.HasPrefix(name, \".\") && strings.HasSuffix(name, \".md\") && name != \".md\"\n   138\t}\n   139\t\n   140\t// regularADR reports a regular, non-symlinked file of .pose/adr/ within the root.\n   141\tfunc (s Store) regularADR(name string) error {\n   142\t\tpath := filepath.Join(s.adrDir(), name)\n   143\t\tinfo, err := s.fsys().Lstat(path)\n   144\t\tif err != nil {\n   145\t\t\treturn err\n   146\t\t}\n   147\t\tif info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n   148\t\t\treturn fmt.Errorf(\"not a regular file inside .pose/adr\")\n   149\t\t}\n   150\t\treturn nil\n   151\t}\n   152\t\n   153\t// closeoutADRAssociations returns the sorted ADR basenames associated with a\n   154\t// roadmap, and the diagnostics that make the answer unknown.\n   155\tfunc (s Store) closeoutADRAssociations(rm *Roadmap, project string) ([]string, []string) {\n   156\t\tfound := map[string]bool{}\n   157\t\tdiagnostics := []string{}\n   158\t\trawRoadmap, readErr := s.fsys().ReadFile(rm.Path)\n   159\t\tif readErr != nil {\n   160\t\t\tdiagnostics = append(diagnostics, \"roadmap \"+rm.Slug+\" could not be read for its adrs: \"+readErr.Error())\n   161\t\t}\n   162\t\tdeclared, _, declarationProblem := associationList(string(rawRoadmap), \"adrs\", \"roadmap \"+rm.Slug)\n   163\t\tif declarationProblem != \"\" {\n   164\t\t\tdiagnostics = append(diagnostics, declarationProblem)\n   165\t\t}\n   166\t\tfor _, item := range declared {\n   167\t\t\tname, ok := strings.CutPrefix(item, \"adr:\")\n   168\t\t\tif !ok || !validADRBasename(name) {\n   169\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares %q, not adr:<file>.md\", rm.Slug, item))\n   170\t\t\t\tcontinue\n   171\t\t\t}\n   172\t\t\tif err := s.regularADR(name); err != nil {\n   173\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares adr:%s, which cannot be read: %v\", rm.Slug, name, err))\n   174\t\t\t\tcontinue\n   175\t\t\t}\n   176\t\t\tfound[name] = true\n   177\t\t}\n   178\t\tbody := rm.Body\n   179\t\tif body == \"\" {\n   180\t\t\tif full, err := s.GetRoadmap(rm.Slug); err == nil {\n   181\t\t\t\tbody = full.Body\n   182\t\t\t}\n   183\t\t}\n   184\t\troadmapDir := filepath.Dir(rm.Path)\n   185\t\tlinks, undecodable := markdownLinkDestinations(body)\n   186\t\tfor _, dest := range undecodable {\n   187\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, whose escapes do not decode; the association reader cannot tell where it points\", rm.Slug, dest))\n   188\t\t}\n   189\t\tfor _, dest := range links {\n   190\t\t\ttarget := filepath.Clean(filepath.Join(roadmapDir, filepath.FromSlash(dest)))\n   191\t\t\tif filepath.Dir(target) == filepath.Clean(s.adrDir()) && strings.ContainsAny(dest, \"()\") {\n   192\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, a destination with parentheses the association reader does not read whole; rename the ADR or the link\", rm.Slug, dest))\n   193\t\t\t\tcontinue\n   194\t\t\t}\n   195\t\t\tif filepath.Dir(target) != filepath.Clean(s.adrDir()) || !strings.HasSuffix(target, \".md\") {\n   196\t\t\t\tcontinue\n   197\t\t\t}\n   198\t\t\tname := filepath.Base(target)\n   199\t\t\tif err := s.regularADR(name); err != nil {\n   200\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, which cannot be read: %v\", rm.Slug, dest, err))\n   201\t\t\t\tcontinue\n   202\t\t\t}\n   203\t\t\tfound[name] = true\n   204\t\t}\n   205\t\tentries, err := s.fsys().ReadDir(s.adrDir())\n   206\t\tif err != nil && !os.IsNotExist(err) {\n   207\t\t\tdiagnostics = append(diagnostics, \"the ADR inventory could not be read: \"+err.Error())\n   208\t\t}\n   209\t\tif len(entries) > closeoutADRInventoryLimit {\n   210\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"the ADR inventory has %d entries, above the limit of %d\", len(entries), closeoutADRInventoryLimit))\n   211\t\t\tentries = nil\n   212\t\t}\n   213\t\troadmapPath := filepath.Clean(filepath.Join(s.roadmapsDir(), rm.Slug+\".md\"))\n   214\t\tfor _, entry := range entries {\n   215\t\t\tname := entry.Name()\n   216\t\t\t// Every candidate is read, the associated ones included: its size,\n   217\t\t\t// its readability and its own declaration are inputs. One that\n   218\t\t\t// cannot be read could hold a backlink, so it is unknown.\n   219\t\t\tif entry.IsDir() || !strings.HasSuffix(name, \".md\") {\n   220\t\t\t\tcontinue\n   221\t\t\t}\n   222\t\t\tif err := s.regularADR(name); err != nil {\n   223\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is not a regular file of .pose/adr: \"+err.Error())\n   224\t\t\t\tcontinue\n   225\t\t\t}\n   226\t\t\tpath := filepath.Join(s.adrDir(), name)\n   227\t\t\tif info, err := s.fsys().Lstat(path); err != nil || info.Size() > closeoutADRSizeLimit {\n   228\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is unreadable or above the size limit\")\n   229\t\t\t\tcontinue\n   230\t\t\t}\n   231\t\t\traw, err := s.fsys().ReadFile(path)\n   232\t\t\tif err != nil {\n   233\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" could not be read: \"+err.Error())\n   234\t\t\t\tcontinue\n   235\t\t\t}\n   236\t\t\t_, adrBody := SplitFrontmatter(string(raw))\n   237\t\t\tbackward, _, backwardProblem := associationList(string(raw), \"roadmaps\", \"ADR \"+name)\n   238\t\t\tif backwardProblem != \"\" {\n   239\t\t\t\tdiagnostics = append(diagnostics, backwardProblem)\n   240\t\t\t}\n   241\t\t\tfor _, item := range backward {\n   242\t\t\t\tref, err := ParseArtifactRef(item)\n   243\t\t\t\tif err != nil || ref.Kind != \"roadmap\" || ref.Milestone != \"\" {\n   244\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %q, not roadmap:<slug>\", name, item))\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif ref.Project != \"\" && ref.Project != project {\n   248\t\t\t\t\tcontinue // a roadmap of another project: not this association\n   249\t\t\t\t}\n   250\t\t\t\tif _, err := s.GetRoadmap(ref.Slug); err != nil {\n   251\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %s, which names no roadmap of this project\", name, item))\n   252\t\t\t\t\tcontinue\n   253\t\t\t\t}\n   254\t\t\t\tif ref.Slug == rm.Slug {\n   255\t\t\t\t\tfound[name] = true\n   256\t\t\t\t}\n   257\t\t\t}\n   258\t\t\tbacklinks, undecodableBacklinks := markdownLinkDestinations(adrBody)\n   259\t\t\tfor _, dest := range undecodableBacklinks {\n   260\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", whose escapes do not decode; the association reader cannot tell where it points\")\n   261\t\t\t}\n   262\t\t\tfor _, dest := range backlinks {\n   263\t\t\t\ttarget := filepath.Clean(filepath.Join(s.adrDir(), filepath.FromSlash(dest)))\n   264\t\t\t\t// A destination the reader may have cut short is unknown, never an\n   265\t\t\t\t// absent association (review round 14, N47).\n   266\t\t\t\tif filepath.Dir(target) == filepath.Clean(s.roadmapsDir()) && strings.ContainsAny(dest, \"()\") {\n   267\t\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", a destination with parentheses the association reader does not read whole; rename the roadmap or the link\")\n   268\t\t\t\t\tcontinue\n   269\t\t\t\t}\n   270\t\t\t\tif filepath.Dir(target) != filepath.Clean(s.roadmapsDir()) || !strings.HasSuffix(target, \".md\") {\n   271\t\t\t\t\tcontinue\n   272\t\t\t\t}\n   273\t\t\t\t// A link into the roadmaps namespace is an association input: one\n   274\t\t\t\t// that does not resolve to a roadmap leaves the answer unknown.\n   275\t\t\t\tif info, err := s.fsys().Lstat(target); err != nil || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, target) {\n   276\t\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which is not a roadmap of this project\")\n   277\t\t\t\t\tcontinue\n   278\t\t\t\t}\n   279\t\t\t\t// The target is read as the roadmap it names, as a roadmaps:\n   280\t\t\t\t// declaration is: a regular entry that cannot be read or parsed\n   281\t\t\t\t// leaves the answer unknown, never an absence. The roadmaps README\n   282\t\t\t\t// is no roadmap, as ListRoadmaps reads the namespace.\n   283\t\t\t\tif strings.EqualFold(filepath.Base(target), \"README.md\") {\n   284\t\t\t\t\tcontinue\n   285\t\t\t\t}\n   286\t\t\t\tif _, err := s.GetRoadmap(strings.TrimSuffix(filepath.Base(target), \".md\")); err != nil {\n   287\t\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which could not be read as a roadmap of this project\")\n   288\t\t\t\t\tcontinue\n   289\t\t\t\t}\n   290\t\t\t\tif target == roadmapPath {\n   291\t\t\t\t\tfound[name] = true\n   292\t\t\t\t}\n   293\t\t\t}\n   294\t\t}\n   295\t\tadrs := make([]string, 0, len(found))\n   296\t\tfor name := range found {\n   297\t\t\tadrs = append(adrs, name)\n   298\t\t}\n   299\t\tsort.Strings(adrs)\n   300\t\tsort.Strings(diagnostics)\n   301\t\treturn adrs, diagnostics\n   302\t}\n","exit_code":0,"status":"completed"}}
