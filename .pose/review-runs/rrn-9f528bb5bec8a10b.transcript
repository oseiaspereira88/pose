e := range rm.Milestones {\n \t\t\tif milestone.ID == scope.Milestone {\n \t\t\t\tfor _, raw := range milestone.Specs {\n-\t\t\t\t\tslug, external := s.milestoneMember(raw)\n+\t\t\t\t\tslug, external := s.canonicalMember(raw)\n \t\t\t\t\tif external {\n \t\t\t\t\t\tif !s.externalMemberDone(raw) {\n \t\t\t\t\t\t\treturn false, nil\n@@ -2647,6 +2715,8 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\tif err != nil {\n \t\t\treturn state, err\n \t\t}\n+\t\tcloseoutAdopted, adoptErr := s.closeoutReviewPolicyAdopted()\n+\t\tcloseoutAdopted = closeoutAdopted || adoptErr != nil\n \t\tvar found bool\n \t\tfor _, milestone := range rm.Milestones {\n \t\t\tif milestone.ID != scope.Milestone {\n@@ -2654,7 +2724,11 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t}\n \t\t\tfound = true\n \t\t\tfor _, raw := range milestone.Specs {\n-\t\t\t\tslug, external := s.milestoneMember(raw)\n+\t\t\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n+\t\t\t\tif unresolved != \"\" {\n+\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", unresolved, raw))\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n \t\t\t\tif external {\n \t\t\t\t\tif s.FederatedResolver == nil {\n \t\t\t\t\t\tblock(NewDiagnostic(\"external-member-unaccepted\", \"external member \"+raw+\" needs federated acceptance\", raw))\n@@ -2666,11 +2740,22 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t\t\treturn state, err\n \t\t\t\t}\n \t\t\t\tstate.Children = append(state.Children, child)\n-\t\t\t\t// A roadmap may declare why a terminal member owes this milestone nothing.\n-\t\t\t\tif !child.Terminal && !(review.Approved && s.declaredUnreviewed(scope) != \"\") {\n+\t\t\t\t// A roadmap may declare why a terminal member owes this milestone\n+\t\t\t\t// nothing, under the legacy rule only: under an adopted closeout\n+\t\t\t\t// review policy a child that is not terminal always blocks\n+\t\t\t\t// (review round 12, N38).\n+\t\t\t\tif !child.Terminal && !(review.Approved && !closeoutAdopted && s.declaredUnreviewed(scope) != \"\") {\n \t\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\n \t\t\t\t}\n \t\t\t}\n+\t\t\t// An exempt milestone has no review of its own to judge its exit\n+\t\t\t// gate: an approved member review must have judged it as it reads\n+\t\t\t// now, or the close is blocked; the review stays dispensed. This\n+\t\t\t// holds for one member too: a done spec sealed before the gate\n+\t\t\t// existed never gains it (review round 6, N21).\n+\t\t\tif decision := review.CloseoutReview; decision != nil && !decision.Required && strings.TrimSpace(milestone.ExitGate) != \"\" && !review.Approved && !s.exitGateJudgedByMember(rm.Slug, milestone, state.Children) {\n+\t\t\t\tblock(NewDiagnostic(\"milestone-exit-gate-unjudged\", \"the exit gate of \"+ref+\" is judged by no approved review: seal and review the member that carries it (the only member, or the last one once every other member is closed), or review the milestone itself (`pose review bundle \"+ref+\" --seal`)\", ref))\n+\t\t\t}\n \t\t\tbreak\n \t\t}\n \t\tif !found {\n@@ -2725,7 +2810,38 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t}\n \t\t}\n \t}\n-\tif !review.Required {\n+\tcloseOwed := false\n+\tif scope.Kind == \"milestone\" || scope.Kind == \"roadmap\" {\n+\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil && policy.CloseoutReviewAdopted() {\n+\t\t\treceipt, receiptErr := s.ReadCloseoutReceipt(ref)\n+\t\t\tif receiptErr != nil {\n+\t\t\t\tblock(OpaqueDiagnostic(\"closeout-receipt-invalid\", DiagnosticCloseout, receiptErr.Error()))\n+\t\t\t}\n+\t\t\tstate.CloseoutReceipt = receipt\n+\t\t\tif decision := review.CloseoutReview; decision != nil && receipt == nil && receiptErr == nil {\n+\t\t\t\t// Terminal members make the scope eligible, never closed: the\n+\t\t\t\t// explicit close publishes the receipt that makes it terminal.\n+\t\t\t\tcloseOwed = true\n+\t\t\t\tfor _, diagnostic := range decision.Diagnostics {\n+\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", diagnostic, ref))\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif review.CloseoutReview == nil && receipt == nil && scope.Kind == \"roadmap\" && state.LifecycleDone && review.Required && !review.Approved {\n+\t\t\t\tdiagnostics = append(diagnostics, NewDiagnostic(\"closeout-receipt-incomplete\", \"roadmap \"+scope.Slug+\" is done with neither an approved review nor a closeout receipt; `pose close \"+ref+\"` verifies its inputs again and publishes the receipt\", ref))\n+\t\t\t}\n+\t\t}\n+\t}\n+\tstate.CloseRequired = closeOwed\n+\tif scope.Kind == \"roadmap\" && state.CloseoutReceipt != nil {\n+\t\t// A receipt stands for its cut criteria only while they still hold:\n+\t\t// the shared terminal path checks them, as the roadmap gate does.\n+\t\tfor _, blocker := range s.roadmapCriteriaBlockers(scope.Slug) {\n+\t\t\tblock(NewDiagnostic(\"closeout-receipt-gate-failed\", blocker, ref))\n+\t\t}\n+\t}\n+\t// An exemption under the adopted policy leaves the review no blockers to\n+\t// remove; only the legacy path strips review-only messages, by text.\n+\tif !review.Required && review.CloseoutReview == nil {\n \t\tstate.Blockers = removeReviewOnlyBlockers(state.Blockers)\n \t\tkept := diagnostics[:0]\n \t\tfor _, d := range diagnostics {\n@@ -2757,7 +2873,7 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t}\n \t}\n \tstate.Blockers = uniqueSorted(state.Blockers)\n-\tstate.Terminal = len(state.Blockers) == 0 && (review.Approved || !review.Required) && state.LifecycleDone\n+\tstate.Terminal = len(state.Blockers) == 0 && (review.Approved || !review.Required) && state.LifecycleDone && !closeOwed\n \tif state.Terminal {\n \t\tstate.NextAction = \"none\"\n \t} else if len(state.Children) > 0 {\n@@ -2781,6 +2897,9 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \tif state.NextAction == \"\" && scope.Kind == \"spec\" && state.FederatedAcceptance != nil && !state.FederatedAcceptance.Ready {\n \t\tstate.NextAction = \"resolve federated dependency blockers for \" + ref\n \t}\n+\tif state.NextAction == \"\" && closeOwed && len(state.Blockers) == 0 {\n+\t\tstate.NextAction = \"close \" + ref + \" with `pose close \" + ref + \"`, which publishes its closeout receipt\"\n+\t}\n \tif state.NextAction == \"\" {\n \t\tstate.NextAction = \"resolve closeout blockers for \" + ref\n \t}\n@@ -2815,6 +2934,9 @@ func closeoutNextStep(state CloseoutState, review ReviewEvaluation, ref string)\n \t\t\t\treturn step(\"continue-child\", child.Scope)\n \t\t\t}\n \t\t}\n+\t\tif state.CloseRequired && len(state.Blockers) == 0 {\n+\t\t\treturn step(\"close-scope\", ref)\n+\t\t}\n \t\treturn step(\"resolve-federated-blockers\", ref)\n \tcase !review.Approved && review.Required:\n \t\treturn step(\"record-fresh-review\", ref)\n@@ -2822,6 +2944,8 @@ func closeoutNextStep(state CloseoutState, review ReviewEvaluation, ref string)\n \t\treturn step(\"apply-lifecycle-transition\", ref)\n \tcase state.FederatedAcceptance != nil && !state.FederatedAcceptance.Ready:\n \t\treturn step(\"resolve-federated-blockers\", ref)\n+\tcase state.CloseRequired && len(state.Blockers) == 0:\n+\t\treturn step(\"close-scope\", ref)\n \t}\n \treturn step(\"resolve-closeout-blockers\", ref)\n }\n@@ -2856,6 +2980,10 @@ func (s Store) GetCloseoutStateWithFederatedAcceptance(ref, projectID string, re\n // a federated resolver must fail closed on an external member.\n func (s Store) milestoneMember(raw string) (string, bool) {\n \tref, err := ParseArtifactRef(raw)\n+\tif err == nil && ref.Project == \"\" && ref.Kind == \"spec\" && ref.Milestone == \"\" {\n+\t\t// `spec:<slug>` and `<slug>` name the same local member.\n+\t\treturn ref.Slug, false\n+\t}\n \tif err != nil || ref.Project == \"\" {\n \t\treturn raw, false\n \t}\n","exit_code":0,"statu