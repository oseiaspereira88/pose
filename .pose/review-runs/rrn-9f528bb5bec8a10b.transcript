or_version\": {\"const\": \"closeout-review@1\"},\n        \"policy_key\": {\"enum\": [\"milestone_review_required\", \"roadmap_review_required\"]},\n        \"policy_value\": {\"enum\": [\"never\", \"when-justified\", \"always\"]},\n        \"required\": {\"type\": \"boolean\"},\n        \"known\": {\"type\": \"boolean\"},\n        \"reason\": {\"type\": \"string\"},\n        \"members\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"pattern\": \"^xref:[^/]+/spec:[a-z0-9][a-z0-9._-]*$\"}},\n        \"adr_associations\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"pattern\": \"^[^/\\\\\\\\]+\\\\.md$\"}},\n        \"diagnostics\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}\n      }\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
