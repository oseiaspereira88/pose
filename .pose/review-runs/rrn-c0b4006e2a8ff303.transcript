r := os.Remove(full); err != nil {\n   179\t\t\t\t\tt.Fatal(err)\n   180\t\t\t\t}\n   181\t\t\t\tif got, err := gitMaterializedChanges(root, \"HEAD\"); err != nil || len(got) != 1 {\n   305\tfunc aliasingSymlinkIn(root, repo, commit, prefix string, modules []validationModule, meta scopeMetadata) (string, error) {\n   306\t\tout, err := posemodel.RawGit(\"-C\", repo, \"ls-tree\", \"-r\", \"-z\", commit).Output()\n   307\t\tif err != nil {\n   308\t\t\treturn \"\", err\n   309\t\t}\n   310\t\tvar deps []string\n   311\t\tfor _, module := range meta.Modules {\n   312\t\t\tfor _, dep := range module.DependsOn {\n   313\t\t\t\tdeps = append(deps, filepath.ToSlash(filepath.Clean(dep)))\n   314\t\t\t}\n   315\t\t}\n   316\t\ttouches := func(p string) bool {\n   317\t\t\tfor _, m := range modules {\n   318\t\t\t\tif m.Rel != \".\" && (p == m.Rel || strings.HasPrefix(p, m.Rel+\"/\") || strings.HasPrefix(m.Rel, p+\"/\")) {\n   319\t\t\t\t\treturn true\n   320\t\t\t\t}\n   321\t\t\t}\n   322\t\t\tfor _, dep := range deps {\n   323\t\t\t\tif dep == \".\" || p == dep || strings.HasPrefix(p, dep+\"/\") || strings.HasPrefix(dep, p+\"/\") {\n   324\t\t\t\t\treturn true\n   325\t\t\t\t}\n   326\t\t\t}\n   474\t// casefoldedDirectory reports whether dir looks names up without case: an\n   475\t// entry spelled with its letters' case swapped names the same file.\n   476\tfunc casefoldedDirectory(dir string, readDir func(string) ([]os.DirEntry, error), stat func(string) (os.FileInfo, error)) bool {\n   477\t\t// An unreadable directory cannot be shown not to fold. Entries are probed\n   478\t\t// without following links, and an unusable one is skipped, not taken as\n   479\t\t// proof (review round 10, N27).\n   480\t\tentries, err := readDir(dir)\n   481\t\tif err != nil {\n   482\t\t\treturn true\n   483\t\t}\n   484\t\tfor _, entry := range entries {\n   485\t\t\tname := entry.Name()\n   486\t\t\tswapped := swapCase(name)\n   487\t\t\tif swapped == name {\n   488\t\t\t\tcontinue\n  