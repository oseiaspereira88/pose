{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/usr/bin/bash -lc \"date -u '+%Y-%m-%d %H:%M:%S'; sed -n '765,788p' pose-mcp/internal/cli/artifact_integrity.go; cat scripts/test-engine-go.sh | head -95; git status --short\"","aggregated_output":"2026-11-23 08:52:50\nfunc loadRecordedChangeSets(root string) []posemodel.ChangeSet {\n\treturn loadRecordedChangeSetsIn(posemodel.NativeFiles(), root)\n}\n\nfunc buildCurrentDeliveryGraphIn(files posemodel.Files, root string) (posemodel.DeliveryIntegrityGraph, error) {\n\tspecs, claims, sets, tracked, policy, gaps, err := collectArtifactGraphInputsWithGapsIn(files, root)\n\tif err != nil {\n\t\treturn posemodel.DeliveryIntegrityGraph{}, err\n\t}\n\tgraph := posemodel.BuildDeliveryIntegrityWithHistoryIn(files, specs, claims, sets, tracked, policy, posemodel.LoadArchivedFragmentsIn(files, root), artifactRemovalsIn(files, root, claims, sets, tracked, gaps))\n\tif err := applyArtifactAttributions(files, root, specs, &graph); err != nil {\n\t\treturn posemodel.DeliveryIntegrityGraph{}, err\n\t}\n\treturn extendCurrentDeliveryGraphIn(files, root, graph)\n}\n\n// buildCurrentDeliveryGraph reads and writes the filesystem directly; buildCurrentDeliveryGraphIn takes the\n// operation's files.\nfunc buildCurrentDeliveryGraph(root string) (posemodel.DeliveryIntegrityGraph, error) {\n\treturn buildCurrentDeliveryGraphIn(posemodel.NativeFiles(), root)\n}\n\nfunc cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar spec, from, to string\n#!/usr/bin/env bash\nset -euo pipefail\n\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd -P)\"\ncd \"$ROOT/pose-mcp\"\nexport LC_ALL=C\n\nmode=\"${1:-all}\"\nif [ \"$#\" -gt 1 ]; then\n  mode=invalid\nfi\ncase \"$mode\" in\n  all|other|pose-0|pose-1|inventory) ;;\n  *) printf '%s\\n' 'usage: test-engine-go.sh [all|other|pose-0|pose-1|inventory]' >&2; exit 2 ;;\nesac\n\nrun_other_packages() {\n  local heavy listed package\n  local -a other=()\n  heavy=\"$(go list ./internal/pose)\"\n  listed=\"$(go list ./...)\"\n  while IFS= read -r package; do\n    if [ \"$package\" != \"$heavy\" ]; then\n      other+=(\"$package\")\n    fi\n  done <<< \"$listed\"\n  if [ \"${#other[@]}\" -eq 0 ] || [ \"${#other[@]}\" -eq \"$(printf '%s\\n' \"$listed\" | wc -l)\" ]; then\n    printf '%s\\n' 'test-engine-go: the Go package inventory did not contain the expected package split' >&2\n    return 1\n  fi\n  go test -timeout 10m -count=1 \"${other[@]}\"\n}\n\nlist_names() {\n  go test -list \"$1\" ./internal/pose | sed -n -E '/^(Test|Fuzz|Example)[^[:space:]]*$/p' | sort\n}\n\nprepare_pose_shards() {\n  local all selected0 selected1 combined test_name\n  local i=0\n  local -a first=() second=()\n  all=\"$(list_names '^(Test|Fuzz|Example)')\"\n  while IFS= read -r test_name; do\n    if [ \"$((i % 2))\" -eq 0 ]; then\n      first+=(\"$test_name\")\n    else\n      second+=(\"$test_name\")\n    fi\n    i=$((i + 1))\n  done <<< \"$all\"\n  if [ -z \"$all\" ] || [ \"${#second[@]}\" -eq 0 ]; then\n    printf '%s\\n' 'test-engine-go: expected two nonempty Go test shards' >&2\n    return 1\n  fi\n  pose_pattern_0=\"^($(IFS='|'; printf '%s' \"${first[*]}\"))$\"\n  pose_pattern_1=\"^($(IFS='|'; printf '%s' \"${second[*]}\"))$\"\n  selected0=\"$(list_names \"$pose_pattern_0\")\"\n  selected1=\"$(list_names \"$pose_pattern_1\")\"\n  combined=\"$(printf '%s\\n%s\\n' \"$selected0\" \"$selected1\" | sort)\"\n  if [ \"$combined\" != \"$all\" ]; then\n    printf '%s\\n' 'test-engine-go: the Go-selected shards overlap or omit a test' >&2\n    return 1\n  fi\n  printf 'internal/pose inventory: %d + %d = %d tests, fuzz targets and examples\\n'     \"${#first[@]}\" \"${#second[@]}\" \"$i\"\n}\n\nif [ \"$mode\" = other ]; then\n  run_other_packages\n  exit 0\nfi\n\nprepare_pose_shards\ncase \"$mode\" in\n  all)\n    run_other_packages\n    go test -timeout 10m -count=1 -run \"$pose_pattern_0\" ./internal/pose\n    go test -timeout 10m -count=1 -run \"$pose_pattern_1\" ./internal/pose\n    ;;\n  pose-0) go test -timeout 10m -count=1 -run \"$pose_pattern_0\" ./internal/pose ;;\n  pose-1) go test -timeout 10m -count=1 -run \"$pose_pattern_1\" ./internal/pose ;;\n  inventory) ;;\nesac\n","exit_code":0,"status":"completed"}}
