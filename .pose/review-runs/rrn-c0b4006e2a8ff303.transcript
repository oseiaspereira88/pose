{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/cli/validate_scope.go; git diff dec2e64c1395fafbf8e2a78171e5437c1720bbbf..392d81f70007476e8eb264ae86f954a7e6f879f8 -- pose-mcp/internal/cli/validate.go pose-mcp/internal/cli/validate_results.go pose-mcp/internal/pose/delivery_validation_run.go'","aggregated_output":"package cli\n\n// Explainable changed-scope validation (spec pose-changed-scope-validation):\n// select the minimum safe set of modules from explicit Git revisions,\n// declared dependency edges and policy. Selection is deterministic for the\n// same base/head/config; every decision carries a reason and every\n// unselected check is recorded as skipped with a machine-readable reason.\n// Uncertainty always widens toward safe execution.\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// safeGitRevRE rejects revisions that could be parsed as options or escape\n// expected forms (confinement: never pass untrusted flags to git).\nvar safeGitRevRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._/~^-]*$`)\n\ntype scopeModuleMeta struct {\n\tCriticality string   `json:\"criticality\"`\n\tDependsOn   []string `json:\"dependsOn\"`\n\t// SelfContained declares that the module's checks read only its own\n\t// directory and its declared dependencies, so a change outside every\n\t// module does not select it (spec pose-validate-carries-unchanged-checks R6).\n\tSelfContained bool `json:\"selfContained\"`\n}\n\ntype scopeMetadata struct {\n\tModules map[string]scopeModuleMeta `json:\"modules\"`\n}\n\n// loadScopeMetadata reads the module metadata. An absent file is empty\n// metadata; a file that does not decode is an error, never a partial\n// reading that could keep an exemption and drop a dependency (review round\n// 3, N6).\nfunc loadScopeMetadata(root string) (scopeMetadata, error) {\n\tvar meta scopeMetadata\n\traw, err := os.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"module-metadata.json\"))\n\tif errors.Is(err, os.ErrNotExist) {\n\t\treturn meta, nil\n\t}\n\tif err != nil {\n\t\treturn meta, fmt.Errorf(\"module metadata is unreadable: %v\", err)\n\t}\n\tif err := json.Unmarshal(raw, &meta); err != nil {\n\t\treturn scopeMetadata{}, fmt.Errorf(\"module metadata does not decode: %v\", err)\n\t}\n\treturn meta, nil\n}\n\n// scopeSelection maps selected module → deterministic selection reason.\ntype scopeSelection struct {\n\tBase, Head string\n\tChanged    []string\n\tSelected   map[string]string\n}\n\nfunc (s scopeSelection) rangeLabel() string {\n\tif s.Head == \"\" {\n\t\treturn s.Base + \"..worktree\"\n\t}\n\treturn s.Base + \"..\" + s.Head\n}\n\n// computeChangedScope resolves the selection. Modules are selected when they\n// contain changed files, depend (transitively) on a changed module, or policy\n// widens them (criticality high). A change outside every module selects\n// every module that does not declare itself self-contained — uncertainty\n// prefers safe execution. Excluded paths (the run's own canonical result) are\n// not changes.\nfunc computeChangedScope(root, base, head string, modules []validationModule, exclude ...string) (scopeSelection, error) {\n\tsel := scopeSelection{Base: base, Head: head, Selected: map[string]string{}}\n\tfor _, rev := range []string{base, head} {\n\t\tif rev != \"\" && !safeGitRevRE.MatchString(rev) {\n\t\t\treturn sel, fmt.Errorf(\"unsafe git revision: %q\", rev)\n\t\t}\n\t}\n\t// NUL-delimited and without rename pairing: a quoted or multi-line name\n\t// keeps its owner, and a rename names both its source and its destination\n\t// (review round 2, N1 and N3).\n\t// Configuration never hides a changed gitlink (review round 8, N23).\n\tgitArgs := []string{\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base}\n\tif head != \"\" {\n\t\tgitArgs = append(gitArgs, head)\n\t}\n\tgitArgs = append(gitArgs, \"--\")\n\tout, err := posemodel.RawGit(gitArgs...).Output()\n\tif err != nil {\n\t\treturn sel, fmt.Errorf(\"git diff %s failed (revision unknown?)\", sel.rangeLabel())\n\t}\n\tfor _, name := range strings.Split(string(out), \"\\x00\") {\n\t\tif name != \"\" {\n\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n\t\t}\n\t}\n\tif head == \"\" {\n\t\t// Worktree comparisons must also see untracked files — invisible new\n\t\t// code must never silently narrow validation (safe execution wins).\n\t\tif untracked, err := posemodel.RawHistoryGit(root, \"ls-files\", \"-z\", \"--others\", \"--exclude-standard\").Output(); err == nil {\n\t\t\tfor _, name := range strings.Split(string(untracked), \"\\x00\") {\n\t\t\t\tif name != \"\" {\n\t\t\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif len(exclude) > 0 {\n\t\texcluded := map[string]bool{}\n\t\tfor _, path := range exclude {\n\t\t\texcluded[filepath.ToSlash(filepath.Clean(path))] = true\n\t\t}\n\t\tkept := sel.Changed[:0]\n\t\tfor _, file := range sel.Changed {\n\t\t\tif !excluded[file] {\n\t\t\t\tkept = append(kept, file)\n\t\t\t}\n\t\t}\n\t\tsel.Changed = kept\n\t}\n\tsort.Strings(sel.Changed)\n\n\tmeta, err := loadScopeMetadata(root)\n\tif err != nil {\n\t\treturn sel, err\n\t}\n\tmoduleOf := func(file string) string {\n\t\tmatch := \"\"\n\t\tfor _, m := range modules {\n\t\t\tif file == m.Rel || strings.HasPrefix(file, m.Rel+\"/\") {\n\t\t\t\tif len(m.Rel) > len(match) {\n\t\t\t\t\tmatch = m.Rel\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn match\n\t}\n\t// Every changed file selects, independently of one another (review rounds\n\t// 2–4, N2, N5, N7, N8):\n\t//   - its most specific owning module;\n\t//   - every module under it (a gitlink or a replaced directory changes what\n\t//     lies beneath);\n\t//   - every module whose declared dependsOn contains it, lies under it, or\n\t//     is the project root \".\", whether or not the dependency is discovered;\n\t//   - when no module owns it: the root module and every module that does\n\t//     not declare itself self-contained (safe execution wins).\n\tselectModule := func(rel, reason string) {\n\t\tif _, ok := sel.Selected[rel]; !ok {\n\t\t\tsel.Selected[rel] = reason\n\t\t}\n\t}\n\tfor _, file := range sel.Changed {\n\t\towner := moduleOf(file)\n\t\tif owner != \"\" {\n\t\t\tselectModule(owner, \"contains changed file: \"+file)\n\t\t\t// An enclosing module's checks may read inside the modules nested\n\t\t\t// in its directory, and the root module encloses them all (review\n\t\t\t// round 9, N25).\n\t\t\tfor _, m := range modules {\n\t\t\t\tif m.Rel != owner && (m.Rel == \".\" || strings.HasPrefix(owner, m.Rel+\"/\")) {\n\t\t\t\t\tselectModule(m.Rel, \"changed file in nested module \"+owner+\": \"+file)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tfor _, m := range modules {\n\t\t\tif m.Rel != \".\" && strings.HasPrefix(m.Rel, file+\"/\") {\n\t\t\t\tselectModule(m.Rel, \"changed path above the module: \"+file)\n\t\t\t}\n\t\t\t// Every eligible dependency counts, whatever its order (review\n\t\t\t// round 5, N11).\n\t\t\t// A dependency that is the file's own owner reaches its dependents\n\t\t\t// through the transitive widening; any other one, discovered or not,\n\t\t\t// selects here (review round 6, N15).\n\t\t\tfor _, dep := range declaredDependencyHits(file, meta.Modules[m.Rel].DependsOn) {\n\t\t\t\tif dep != owner {\n\t\t\t\t\tselectModule(m.Rel, \"declared dependency \"+dep+\" changed: \"+file)\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif owner == \"\" && (m.Rel == \".\" || !meta.Modules[m.Rel].SelfContained) {\n\t\t\t\tselectModule(m.Rel, \"root-level change outside any module: \"+file)\n\t\t\t}\n\t\t}\n\t}\n\t// Policy widening: high-criticality modules always run.\n\tfor _, m := range modules {\n\t\tif meta.Modules[m.Rel].Criticality == \"high\" {\n\t\t\tif _, ok := sel.Selected[m.Rel]; !ok {\n\t\t\t\tsel.Selected[m.Rel] = \"policy: criticality high always runs\"\n\t\t\t}\n\t\t}\n\t}\n\t// Transitive dependents of selected modules (declared edges only).\n\tfor changed := true; changed; {\n\t\tchanged = false\n\t\tfor _, m := range modules {\n\t\t\tif _, ok := sel.Selected[m.Rel]; ok {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfor _, dep := range meta.Modules[m.Rel].DependsOn {\n\t\t\t\tif reason, ok := sel.Selected[filepath.ToSlash(filepath.Clean(dep))]; ok {\n\t\t\t\t\tsel.Selected[m.Rel] = \"depends on selected module \" + dep + \" (\" + firstScopeReason(reason) + \")\"\n\t\t\t\t\tchanged = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn sel, nil\n}\n\n// firstScopeReason keeps chained dependency reasons short and readable.\nfunc firstScopeReason(reason string) string {\n\tif i := strings.Index(reason, \" (\"); i > 0 {\n\t\treturn reason[:i]\n\t}\n\treturn reason\n}\n\n// declaredDependencyHits returns every declared dependency file changes: one\n// it lies in, one it lies above, or the project root \".\", which every file\n// changes.\nfunc declaredDependencyHits(file string, deps []string) []string {\n\tvar hits []string\n\tfor _, dep := range deps {\n\t\tdep = filepath.ToSlash(filepath.Clean(dep))\n\t\tif dep == \".\" || file == dep || strings.HasPrefix(file, dep+\"/\") || strings.HasPrefix(dep, file+\"/\") {\n\t\t\thits = append(hits, dep)\n\t\t}\n\t}\n\treturn hits\n}\ndiff --git a/pose-mcp/internal/cli/validate.go b/pose-mcp/internal/cli/validate.go\nindex 1ed4d9a5..6658e7a5 100644\n--- a/pose-mcp/internal/cli/validate.go\n+++ b/pose-mcp/internal/cli/validate.go\n@@ -65,7 +65,10 @@ type validationEntry struct {\n \tskip     string\n \tsilent   bool\n \tisolated bool\n-\tresult   checkResult\n+\t// carried marks a check whose result comes from the canonical base (spec\n+\t// pose-validate-carries-unchanged-checks R4); it is silent and never runs.\n+\tcarried bool\n+\tresult  checkResult\n \tdone     chan struct{}\n }\n \n@@ -905,6 +908,7 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \tverbose := false\n \tautoReport := false\n \trootOnly := false\n+\tcarry := false\n \tworkspaceFilter := \"\"\n \tjobs := 0\n \tvar isolationChecks []checkResult\n@@ -922,6 +926,10 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\t\t// A check's output is captured by default; --verbose streams it\n \t\t\t// (spec pose-cli-output-rendering-system R7).\n \t\t\tverbose = true\n+\t\tcase \"--carry\":\n+\t\t\t// Refresh the canonical result, carrying the checks a change\n+\t\t\t// cannot affect (spec pose-validate-carries-unchanged-checks).\n+\t\t\tcarry = true\n \t\tcase \"--root-only\":\n \t\t\t// Documented alias of --module . (spec\n \t\t\t// pose-monorepo-validation-advisory, R2) — sugar over the\n@@ -995,9 +1003,22 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\t}\n \t}\n \tcanonicalResultsPath := \"\"\n-\tif jsonOut != \"\" {\n+\tif jsonOut != \"\" || carry {\n \t\tcanonicalResultsPath = configuredDeliveryResultsPath(root)\n \t}\n+\tif carry {\n+\t\tswitch {\n+\t\tcase moduleFilter != \"\" || stackFilter != \"\" || workspaceFilter != \"\" || changedFrom != \"\" || changedTo != \"\":\n+\t\t\trender(stdout, stderr).Failure(cliText(locale, \"--carry refreshes the whole canonical result; it cannot be combined with --module, --stack, --workspace, --root-only, --changed-from or --changed-to\", \"--carry renova o resultado canônico inteiro; não combina com --module, --stack, --workspace, --root-only, --changed-from ou --changed-to\"))\n+\t\t\treturn 2\n+\t\tcase canonicalResultsPath == \"\":\n+\t\t\trender(stdout, stderr).Failure(cliText(locale, \"--carry needs results_path in .pose/policy/delivery.json\", \"--carry exige results_path em .pose/policy/delivery.json\"))\n+\t\t\treturn 2\n+\t\tcase normalizeValidationOutputPath(jsonOut) != canonicalResultsPath:\n+\t\t\trender(stdout, stderr).Failure(fmt.Sprintf(cliText(locale, \"--carry writes the canonical result: use --json-out %s\", \"--carry grava o resultado canônico: use --json-out %s\"), canonicalResultsPath))\n+\t\t\treturn 2\n+\t\t}\n+\t}\n \t// The report --report writes records this run, so it reads this run's own\n \t// output. It used to look for a pose-validate.latest.log that native\n \t// validation never writes, and every report said \"Fill manually\" and \"No\n@@ -1121,9 +1142,34 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t}\n \tmatrixDigest := sha256.Sum256(raw)\n \trun.MatrixSHA256 = \"sha256:\" + hex.EncodeToString(matrixDigest[:])\n+\trun.EngineVersion = validationEngineIdentity()\n+\t// The head is pinned before anything is planned: selection, carried\n+\t// results and the end-of-run comparison all name this one commit (review\n+\t// round 5, N14).\n \tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n \t\trun.GitHead = strings.TrimSpace(string(head))\n \t}\n+\tstartedClean := materialWorktreeClean(root)\n+\tvar carryState carryPlan\n+\tif carry {\n+\t\tcarryState = planCarry(root, canonicalResultsPath, mode, run.MatrixSHA256, run.GitHead, matrix, modules)\n+\t\trun.Carry = carryState.record\n+\t\tout := render(stdout, stderr)\n+\t\tif !carryState.record.Used {\n+\t\t\tout.ContractLine(\"[carry] full run: \" + carryState.record.Reason)\n+\t\t} else {\n+\t\t\tout.ContractLine(fmt.Sprintf(\"[carry] base %s: %d changed file(s), %d/%d module(s) run\", carryState.record.BaseHead, carryState.record.Changed, len(carryState.record.Selected), len(modules)))\n+\t\t\tif explain {\n+\t\t\t\tfor _, m := range modules {\n+\t\t\t\t\tif reason, ok := carryState.record.Selected[m.Rel]; ok {\n+\t\t\t\t\t\tout.ContractLine(\"  + \" + m.Rel + \": \" + reason)\n+\t\t\t\t\t} else {\n+\t\t\t\t\t\tout.ContractLine(\"  = \" + m.Rel + \": carried from \" + carryState.record.BaseHead)\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t}\n \tif graph, err := buildCurrentDeliveryGraph(root); err == nil {\n \t\trun.ProvenanceDigest = graph.ProvenanceDigest\n \t\trun.ScopeProvenance = map[string]string{}\n@@ -1171,6 +1217,9 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\t\t\tcontinue\n \t\t\t}\n \t\t}\n+\t\tif carryState.carried(module.Rel) {\n+\t\t\tcontinue\n+\t\t}\n \t\tfor _, check := range checks {\n \t\t\tif check.Program != \"\" {\n \t\t\t\tplanned++\n@@ -1214,6 +1263,16 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\t\t\tcontinue\n \t\t\t}\n \t\t}\n+\t\tif carryState.carried(module.Rel) {\n+\t\t\tfor _, check := range checks {\n+\t\t\t\tif check.Program == \"\" {\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n+\t\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n+\t\t\t\tentries = append(entries, &validationEntry{check: check, silent: true, carried: true, result: carryState.carriedResult(id)})\n+\t\t\t}\n+\t\t\tcontinue\n+\t\t}\n \t\tmoduleMode := mode\n \t\tif override.Mode != \"\" {\n \t\t\tmoduleMode = override.Mode\n@@ -1269,6 +1328,34 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\t\tsteps.Note(entry.note)\n \t\t\tcontinue\n \t\t}\n+\t\tif entry.carried {\n+\t\t\t// A carried result counts toward the outcome exactly as it did in\n+\t\t\t// its own run; a carried failure stays a failure (R4).\n+\t\t\trun.Counts.Carried++\n+\t\t\tswitch entry.result.Outcome {\n+\t\t\tcase \"pass\":\n+\t\t\t\trun.Counts.Passed++\n+\t\t\tcase \"fail\":\n+\t\t\t\tif entry.result.Severity == \"required\" {\n+\t\t\t\t\tfailures++\n+\t\t\t\t\trun.Counts.Failed++\n+\t\t\t\t} else {\n+\t\t\t\t\toptionalFailures++\n+\t\t\t\t\trun.Counts.OptionalFailed++\n+\t\t\t\t}\n+\t\t\tcase \"skipped\":\n+\t\t\t\trun.Counts.Skipped++\n+\t\t\tdefault:\n+\t\t\t\trun.Counts.Errored++\n+\t\t\t\tif entry.result.Severity == \"required\" {\n+\t\t\t\t\tfailures++\n+\t\t\t\t} else {\n+\t\t\t\t\toptionalFailures++\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\trun.Checks = append(run.Checks, entry.result)\n+\t\t\tcontinue\n+\t\t}\n \t\tif !entry.silent && !entry.isolated {\n \t\t\tif jobs > 1 {\n \t\t\t\t<-entry.done\n@@ -1335,7 +1422,21 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \trun.WallSeconds = time.Since(wallStart).Seconds()\n \t// A check that changed a tracked file changed the material it ran over: the\n \t// committed tree no longer describes what was validated.\n-\tif len(run.MaterialProvenance) > 0 && !materialTrackedUnchanged(root) {\n+\tendedClean := materialTrackedUnchanged(root)\n+\t// The run validated its recorded head only if HEAD never moved: a commit\n+\t// made while checks ran would let them observe code the record does not\n+\t// name (review round 4, N10).\n+\tendHead := \"\"\n+\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n+\t\tendHead = strings.TrimSpace(string(head))\n+\t}\n+\t// Untracked material created while checks ran counts too (review round 8,\n+\t// N21): only ignored files may differ from the recorded head.\n+\trun.MaterialClean = startedClean && endedClean && materialWorktreeClean(root) && run.GitHead != \"\" && endHead == run.GitHead\n+\t// A run that did not validate its recorded head binds no material: its\n+\t// bindings would let a later tree make a misattributed pass current again\n+\t// (review round 5, N12).\n+\tif len(run.MaterialProvenance) > 0 && !run.MaterialClean {\n \t\tfor spec := range run.MaterialProvenance {\n \t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n \t\t}\n@@ -1350,7 +1451,7 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\tsteps.Note(line)\n \t}\n \tsteps.Summary()\n-\tif executed == 0 {\n+\tif executed == 0 && run.Counts.Carried == 0 {\n \t\tfmt.Fprintln(stdout, \"No modules/checks matched the matrix and filters.\")\n \t}\n \tresult := \"pass\"\ndiff --git a/pose-mcp/internal/cli/validate_results.go b/pose-mcp/internal/cli/validate_results.go\nindex 6af16e09..c862a8af 100644\n--- a/pose-mcp/internal/cli/validate_results.go\n+++ b/pose-mcp/internal/cli/validate_results.go\n@@ -42,6 +42,10 @@ type checkResult struct {\n \t// Runtime guardrails (spec pose-validation-runtime-guardrails), additive:\n \tLimitState string `json:\"limit_state,omitempty\"` // timeout | output-limit | cancelled | no-tests\n \tIsolation  string `json:\"isolation,omitempty\"`   // required = delegated to Harness\n+\t// A carried result is the base's, run at CarriedFrom (spec\n+\t// pose-validate-carries-unchanged-checks R4).\n+\tCarriedFrom        string `json:\"carried_from,omitempty\"`\n+\tCarriedGeneratedAt string `json:\"carried_generated_at,omitempty\"`\n }\n \n // outputLimiter cancels the check when total output exceeds the limit —\n@@ -73,6 +77,14 @@ type validationRunResult struct {\n \tProvenanceDigest   string            `json:\"provenance_digest,omitempty\"`\n \tScopeProvenance    map[string]string `json:\"scope_provenance,omitempty\"`\n \tMaterialProvenance map[string]string `json:\"material_provenance,omitempty\"`\n+\t// EngineVersion and Carry let a later run judge this one as a base (spec\n+\t// pose-validate-carries-unchanged-checks R2, R5).\n+\tEngineVersion string       `json:\"engine_version,omitempty\"`\n+\tCarry         *carryRecord `json:\"carry,omitempty\"`\n+\t// MaterialClean says the working copy matched HEAD in material paths when\n+\t// the run started and still did when it ended, so the run validated the\n+\t// commit it records. Only such a run can be a carry base (R2).\n+\tMaterialClean bool `json:\"material_clean,omitempty\"`\n \t// Jobs is how many checks ran at once; WallSeconds the run's elapsed time\n \t// (spec pose-validate-concurrent-steps R3–R4).\n \tJobs        int     `json:\"jobs,omitempty\"`\n@@ -91,6 +103,7 @@ type runCounts struct {\n \tOptionalFailed int `json:\"optional_failed\"`\n \tErrored        int `json:\"errored\"`\n \tSkipped        int `json:\"skipped\"`\n+\tCarried        int `json:\"carried,omitempty\"`\n }\n \n // secretEnvKeyRE marks configured env keys whose values are redacted from\ndiff --git a/pose-mcp/internal/pose/delivery_validation_run.go b/pose-mcp/internal/pose/delivery_validation_run.go\nindex 07b52e0b..f78cddd7 100644\n--- a/pose-mcp/internal/pose/delivery_validation_run.go\n+++ b/pose-mcp/internal/pose/delivery_validation_run.go\n@@ -28,6 +28,10 @@ func ParseDeliveryValidationRun(raw []byte, relative string) ([]DeliveryValidati\n \t\t\tSeverity      string `json:\"severity\"`\n \t\t\tEvidenceClass string `json:\"evidence_class,omitempty\"`\n \t\t\tOutcome       string `json:\"outcome\"`\n+\t\t\t// A carried check ran at its own head (spec\n+\t\t\t// pose-validate-carries-unchanged-checks R7).\n+\t\t\tCarriedFrom        string `json:\"carried_from,omitempty\"`\n+\t\t\tCarriedGeneratedAt string `json:\"carried_generated_at,omitempty\"`\n \t\t} `json:\"checks\"`\n \t}\n \tif err := json.Unmarshal(raw, &run); err != nil || run.SchemaVersion != DeliveryValidationResultSchema {\n@@ -38,7 +42,11 @@ func ParseDeliveryValidationRun(raw []byte, relative string) ([]DeliveryValidati\n \t\tif check.EvidenceClass == \"\" {\n \t\t\tcontinue\n \t\t}\n-\t\tresults = append(results, DeliveryValidationResult{ID: check.ID, Module: check.Module, Check: check.Name, EvidenceClass: check.EvidenceClass, Severity: check.Severity, Outcome: check.Outcome, GitHead: run.GitHead, GeneratedAt: run.GeneratedAt, ProvenanceDigest: run.ProvenanceDigest, ScopeProvenance: run.ScopeProvenance, MaterialProvenance: run.MaterialProvenance, Report: relative})\n+\t\thead, generated := run.GitHead, run.GeneratedAt\n+\t\tif check.CarriedFrom != \"\" {\n+\t\t\thead, generated = check.CarriedFrom, check.CarriedGeneratedAt\n+\t\t}\n+\t\tresults = append(results, DeliveryValidationResult{ID: check.ID, Module: check.Module, Check: check.Name, EvidenceClass: check.EvidenceClass, Severity: check.Severity, Outcome: check.Outcome, GitHead: head, GeneratedAt: generated, ProvenanceDigest: run.ProvenanceDigest, ScopeProvenance: run.ScopeProvenance, MaterialProvenance: run.MaterialProvenance, Report: relative})\n \t}\n \tsort.Slice(results, func(i, j int) bool { return results[i].ID < results[j].ID })\n \treturn results, nil\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/specs/2026-11-22-pose-validate-carries-unchanged-checks.md .pose/rules/backend-go.md .pose/rules/security.md .pose/rules/documentation-style.md .pose/rules/delivery-evidence.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/specs/2026-11-22-pose-validate-carries-unchanged-checks.md .pose/rules/backend-go.md .pose/rules/security.md .pose/rules/documentation-style.md .pose/rules/delivery-evidence.md'","aggregated_output":"---\nslug: pose-validate-carries-unchanged-checks\nstatus: in-progress\ncreated_at: 2026-11-22\ncompleted_at:\nsupersedes:\ndepends_on: pose-changed-scope-validation, pose-validation-evidence-material-binding\nremediates:\npriority: 1\ncomponents: pose-mcp\ntask_type: feature\nsurface: standard\ndelivers:\n---\n\n# Spec: pose-validate-carries-unchanged-checks\n\n## 1. Intent\n\n### Goal\nLet `pose validate` refresh the canonical structured result by running only the checks a change can affect and carrying forward, unchanged and labelled, the results of the checks it cannot affect.\n\n### Business value\nIn the Harne8 batch of 2026-11-22, every material change to one module required the whole 72-check matrix again. Each run took about 35 minutes with three jobs. Intermittent failures in unrelated suites made roughly one run in three useless. A hooks change confined to `scripts/` needed four full runs in one review round. The canonical record is all-or-nothing today. `--changed-from` already selects the affected modules, but it writes a partial record that cannot replace the canonical one in `results_path`, so closeout still needs the full run.\n\n### Constraints\nA carried result must say where it ran. It never upgrades its outcome, so a carried failure stays a failure. Any doubt about eligibility widens to a full run, and the record states why. The selection reuses the changed-scope rules and widens them only by explicit declaration. Results and indexes written by earlier engines keep their meaning.\n\n### Non-goals\nCaching individual command outputs, hashing arbitrary inputs of a check, carrying across a matrix or engine change, and changing how review bundles seal evidence beyond reading the per-check head.\n\n## 2. Requirements\n\n### Functional\n- R1: `pose validate --carry --json-out <results_path>` shall read the canonical record at the configured `results_path` as its base. It shall be refused with exit 2 when no `results_path` is configured, when the output path is not that path, or when combined with `--module`, `--stack`, `--workspace`, `--changed-from` or `--changed-to`.\n- R2: The base shall be used only when every condition below holds. Otherwise the run shall execute every check and record `carry.used: false` with the first failing condition as `carry.reason`.\n  - Its schema, mode, `matrix_sha256` and `engine_version` equal the current run's. Neither engine build is modified from its recorded revision.\n  - Its `git_head` is an ancestor of, or equal to, `HEAD`.\n  - It was not cancelled.\n  - It recorded `material_clean`: its own working copy matched its head when it started and when it ended, HEAD did not move during the run, no untracked unignored material appeared, and none of its material bindings is unavailable. A run that did not validate its recorded head records every material binding as unavailable.\n  - The filesystem is case-sensitive, and no directory from the root to a module or a declared dependency folds case. An unreadable directory counts as folding.\n  - No declared dependency lies outside the repository. No module is reached through a symlink or shares its physical directory with another module. No tracked symlink has its path or target in a module other than the root or in a declared dependency, and no tracked target leaves the repository. This includes the tree of every submodule at its recorded commit. A submodule that cannot be scanned, because it is not checked out or has nested submodules, refuses.\n  - No check id occurs twice, in the matrix or in the base.\n  - The head is pinned before planning; selection and the end-of-run comparison use that commit.\n  - The working copy is clean in material paths.\n- R3: With a usable base, the run shall select modules with the changed-scope rules over `base.git_head..HEAD`, excluding the `results_path` file itself. It shall also exclude derived administrative records of the engine's closed list (`posemodel.IsAdministrativePath`, the classes material bindings ignore) that are regular files, or absent, at `HEAD`. Otherwise the index and state commits that follow every record would select every module. It shall execute every check of a selected module. Every check of an unselected module whose base result exists and was not skipped shall be carried. A module with any check lacking such a base result shall be selected with the reason `carry: no prior result for <check id>`.\n- R4: A carried check shall keep the base result's outcome, exit code, duration, limit state, output and evidence class. It shall add `carried_from`, the head the check actually ran at, preserved through chained carries, and `carried_generated_at`. Counts shall add `carried`. Carried failures and errors shall count toward the run outcome exactly like executed ones.\n- R5: The record shall add `engine_version` on every run: the engine version plus the VCS revision the binary was built from, when the build records it. With `--carry` it shall also add a `carry` object: `used`, `reason`, `base_head`, `changed` (the number of files) and `selected` (module to reason).\n- R6: The changed set shall show every gitlink change whatever the Git configuration, and shall read Git names NUL-delimited and without rename pairing, so a quoted or multi-line name keeps its owner and a rename names both its source and its destination. A root module `.` owns the files no other module owns, whatever it declares. Each changed file independently selects its most specific owner, every module enclosing that owner (the root module encloses them all), every module beneath it, and every module whose declared dependency contains it, lies beneath it or is the root `.`. Every eligible dependency counts, whatever its order. The dependency case applies to discovered and undiscovered dependencies alike. The exception is the file's own owner, which reaches its dependents through the transitive widening. A file no module owns also selects the root module and every module that is not self-contained. Module metadata that does not decode is an error, never a partial reading. A module declared `\"selfContained\": true` in `.pose/indexes/module-metadata.json` shall not be selected by a change outside every module. It is still selected by changes inside it, by its declared `dependsOn` and by policy. This shall hold for `--changed-from` and `--carry` alike, with the reason recorded for the modules it widens.\n- R7: Reading the record into the delivery index shall use a check's `carried_from` and `carried_generated_at` as that result's head and time. Every consumer of a result's head therefore judges the commit a carried check really ran at.\n\n### Non-functional\n- R8: A run where every module is carried shall execute no check and finish in the time of the selection and the record write.\n\n### Security\n- R9: Revisions read from the base record shall pass the same confinement as `--changed-from` revisions before any Git call.\n\n### Compatibility\n- R10: A base record without `engine_version` shall never be used. Records without the new fields shall be read exactly as before.\n\n## 3. Technical Plan\n\n### Affected areas\n`pose-mcp/internal/cli` (argument parsing, the run loop and record fields of `validate`, changed-scope selection), `pose-mcp/internal/pose` (reading the structured result into delivery results), the manual and the CLI help.\n\n### Artifacts\n- created: .pose/specs/2026-11-22-pose-validate-carries-unchanged-checks.md\n- created: .pose/adr/2026-11-22-validate-carries-unchanged-checks.md\n- modified: pose-mcp/internal/cli/validate.go\n- modified: pose-mcp/internal/cli/validate_scope.go\n- modified: pose-mcp/internal/cli/validate_results.go\n- created: pose-mcp/internal/cli/validate_carry.go\n- created: pose-mcp/internal/cli/validate_carry_test.go\n- created: pose-mcp/internal/cli/validate_engine_identity_test.go\n- modified: pose-mcp/internal/pose/delivery_validation_run.go\n- created: pose-mcp/internal/pose/delivery_validation_run_test.go\n- modified: POSE.md\n- modified: locales/pt-BR/POSE.md\n- modified: pose-mcp/internal/cli/help_catalog.go\n- modified: pose-mcp/internal/scaffold/dist/POSE.md\n- modified: pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n\n### Delivery targets\n\n### API/contract changes\nAdditive fields in the structured validation result: `engine_version`, `carry`, `counts.carried`, and per check `carried_from` and `carried_generated_at`. There is a new `validate --carry` flag and a new optional `selfContained` field in module metadata.\n\n### Data/storage changes\nNone beyond the additive record fields.\n\n### Technical risks\nAn instance that marks a module `selfContained` while its checks read root files would carry stale results. The declaration is explicit, documented and opt-in, and the default stays the full fallback.\n\n## 4. Tasks\n\n### Planning\n- [x] ADR for carrying results and the self-contained declaration.\n\n### Implementation\n- [x] Record fields and base eligibility.\n- [x] Selection excluding the results file, the self-contained declaration and the no-prior-result widening.\n- [x] Carried entries in the run loop and counts.\n- [x] Per-check head in the delivery reading.\n- [x] Manual and help.\n\n### Validation\n- [x] Unit and fixture tests for every requirement, each shown failing before its code.\n- [x] `pose validate --module pose-mcp` and `check --strict`.\n\n## 5. Decisions\n\n### Decision D1\nA carried result is the base's result, not a new observation. It keeps the head where it ran, and consumers judge that head. The run's material binding is still computed at `HEAD`. This holds only because the selection guarantees that a carried module's inputs did not change between the two heads, under the changed-scope rules and the instance's declarations. See ADR `2026-11-22-validate-carries-unchanged-checks`.\n\n### Decision D2\nEligibility compares the whole matrix digest and the engine version instead of per-check definitions. A matrix or engine change reruns everything. That is the existing rule for material bindings, and it keeps the comparison obviously sound.\n\n### Decision D3\nOut-of-module changes keep selecting every module unless a module declares itself self-contained. Instances opt in per module, so a repository that never declares anything gets today's behaviour.\n\n## 6. Validation\n\n### Strategy\nGo tests in `internal/cli` drive real Git fixtures through `validate --carry`. They cover:\n- the base conditions of R2, one fixture each;\n- a change in one module that carries the other;\n- chained carries;\n- a carried failure;\n- the self-contained declaration of R6, under both flags;\n- the refusals of R1;\n- the per-check head reading of R7.\n\nEach test is run against the code before its requirement and must fail there.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./internal/cli/ ./internal/pose/` (in `pose-mcp`), then `pose validate --module pose-mcp`.\n\n#### Lint\n- Command: `go vet ./...` (in `pose-mcp`).\n\n#### Typecheck\n- Command: compiled by the tests.\n\n#### Build\n- Command: `go build ./...` (in `pose-mcp`).\n\n#### Security / Contract\n- Command: `pose check --strict`.\n\n### Execution log\n- 2026-11-22: the new fixtures in `validate_carry_test.go` and `delivery_validation_run_test.go` drive real Git repositories through `validate --carry`. Each requirement's code was mutated out and its test failed: the per-check head reading, the self-contained declaration, the canonical-result exclusion and the derived-record exclusion.\n- 2026-11-22: `go test ./...` in `pose-mcp` first failed on `TestDirectPrintSitesOnlyShrink` and `TestEmbeddedDistMatchesPoseDist`; the carry lines now go through `cliout` and the embedded manual was regenerated. A full `pose validate` then failed the post-install gate because the manual cited derived-record directories absent from a fresh install; the text was rewritten without those paths.\n- 2026-11-22: `pose validate --json-out .pose/results/delivery-validation.json` with a binary built from `606a0fa8` passed 236 of 236 checks in 786 s.\n- 2026-11-22: dogfood: `validate --carry --explain` at `c4182727` used that record as base. The record and index commits counted as zero changed files. Five of six modules were carried, and `pose-mcp` ran because its criticality is high. The run passed with `counts.carried` 3, and the record is kept at `.pose/bin/batch-20261118/engine-a-dogfood-carried.json` in the Harne8 batch.\n\n- 2026-11-22: review round 1 (rrn-0dd98c4aab8b5918, Codex) found F1 (high). A base that validated a dirty working copy could be carried. The record now has `material_clean`, and a base without it, or with an unavailable material binding, is refused. `TestCarryRefusesABaseThatValidatedADirtyWorkingCopy` reproduces the sequence. It failed with the check mutated out and passes with it.\n- 2026-11-22: review round 2 (rrn-1c033e4c349d7794) confirmed R1-F1 fixed and found four new issues. N1: a rename's source path was missing from the changed set. N2: a self-contained root module was exempt from its own files. N3: quoted, newline-delimited Git names lost their owner. N4: modified engine builds at one revision shared an identity. All four are fixed, each with a regression test that failed when its fix was mutated out.\n- 2026-11-22: review round 3 (rrn-3461f6ff36909419) confirmed N1–N4 fixed and found two more issues. N5: a deleted dependency left its self-contained dependents carried. N6: module metadata that did not decode was ignored. Both are fixed, each with a regression test that failed when its fix was mutated out.\n- 2026-11-22: lead's own sweep before round 4: a gitlink above a declared dependency changed only the gitlink path, so the self-contained dependent stayed carried. A changed path now selects the modules and dependencies under it, tested through the shared selection; the test failed with the rule mutated out.\n- 2026-11-23: review round 4 (rrn-4b28f2ff95acf9c4) found N7–N10.\n  - N7: dependency and ancestor widening applied only to unowned files.\n  - N8: a root dependency `.` never matched.\n  - N9: modules aliased through symlinks.\n  - N10: `material_clean` ignored HEAD moving during the run.\n  The selection was rewritten so that each changed file applies every rule independently. Aliased modules refuse the carry, and a moved HEAD clears `material_clean`. Each regression test failed with its fix mutated out.\n- 2026-11-23: review round 5 (rrn-b07ee93779a65e40) found N11–N14.\n  - N11: the first matching dependency masked later ones.\n  - N12: a moved HEAD kept the material bindings.\n  - N13: case aliases on case-insensitive filesystems.\n  - N14: the head was captured after planning.\n  All four are fixed, each with a regression test that failed when its fix was mutated out.\n- 2026-11-23: review round 6 (rrn-88e0428bda9bc9c7) found N15 and N16. N15: a discovered ancestor dependency missed changes in nested modules. N16: declared dependencies reached through symlinks. Both are fixed, each with a regression test that failed when its fix was mutated out.\n- 2026-11-23: review round 7 (rrn-85704a129332a685) found N17–N19.\n  - N17: an absent dependency leaf beneath a symlink.\n  - N18: dependency case aliases.\n  - N19: duplicate check ids sharing one base result.\n  The per-path alias checks gave way to global rules: a case-insensitive filesystem refuses, and so does any tracked symlink whose path or target is in a non-root module or a declared dependency, or whose target leaves the repository. Symlinks between unowned paths are allowed, which covers both repositories' `.claude/skills` links. Duplicate check ids refuse. A mutation of the link-path rule first survived, which exposed a missing test for a module's outward link; that test was added. The matrix duplicate check is redundant with the base check under an equal matrix digest, so the two were mutated together.\n- 2026-11-23: review round 8 (rrn-0375009e985e6a3d) found N20–N23.\n  - N20: symlinks inside submodules.\n  - N21: untracked material created during the run.\n  - N22: case-folded directories within a case-sensitive filesystem.\n  - N23: `diff.ignoreSubmodules` hiding gitlink changes.\n  All four are fixed, each with a regression test that failed when its fix was mutated out.\n- 2026-11-23: review round 9 (rrn-dfc7e3348240ce19) found N24–N26.\n  - N24: gitlinks inside a module were not scanned.\n  - N25: an enclosing module was not selected when a nested module changed.\n  - N26: case folding in ancestor directories of a dependency.\n  All three are fixed, and the lead extended N25 so the root module encloses every module. Each regression test failed when its fix was mutated out.\n- 2026-11-23: review round 10 (rrn-29af03286365811e) found N27–N29. N27: the case probe failed open on an unusable first entry. N28: dependencies outside the repository were accepted. N29: the ADR and this summary misdescribed the self-contained fallback. All three are fixed; N27 and N28 have regression tests that failed when their fixes were mutated out.\n\n### Results summary\nAll new and existing tests pass, and the strict matrix is green. In this repository, `pose-mcp` holds 233 of the 236 checks and is high criticality, so carrying saves little here. In an instance with many modules, a change confined to one of them reruns that module, the modules enclosing it and its declared dependents. A changed file that no module owns also reruns every module that is not declared self-contained.\n\n### Requirement trace\n- R1 [satisfied] test:TestCarryRefusesIncompatibleFlags\n- R2 [satisfied] test:TestCarryFallsBackToAFullRun test:TestCarryRefusesAFilteredBase test:TestCarryRefusesABaseThatValidatedADirtyWorkingCopy test:TestEngineIdentityRefusesModifiedBuilds test:TestCarryRefusesModulesReachedThroughASymlink test:TestValidateHeadMovingDuringTheRunIsNotClean test:TestValidateHeadMovingDuringTheRunBindsNoMaterial test:TestCarryRefusesModulesSharingADirectory test:TestCarryPlansAgainstThePinnedHead test:TestCarryRefusesDependenciesReachedThroughASymlink test:TestCarryRefusesASymlinkInsideAModule test:TestCarryRefusesASymlinkFromAModuleToAnUnownedPath test:TestCarryAllowsSymlinksBetweenUnownedPaths test:TestCarryDetectsACaseInsensitiveFilesystem test:TestCarryRefusesDuplicateCheckIDs test:TestValidateUntrackedMaterialCreatedDuringTheRunIsNotClean test:TestCarryRefusesAnAliasingSymlinkInsideASubmodule test:TestCarryDetectsACaseFoldedDirectory test:TestCarryScansAGitlinkInsideAModule test:TestCarryRelevantDirsIncludeEveryAncestor test:TestCarryCaseProbeSkipsUnusableEntries test:TestCarryRefusesDependenciesOutsideTheRepository\n- R3 [satisfied] test:TestCarryRunsOnlyTheChangedModule test:TestCarryRecordFileIsNotAChange test:TestCarryIgnoresDerivedAdministrativeRecords test:TestCarrySelectsAModuleWithoutAPriorResult\n- R4 [satisfied] test:TestCarryKeepsTheOriginalHeadAcrossChainedCarries test:TestCarryKeepsACarriedFailureAFailure\n- R5 [satisfied] test:TestCarryRunsOnlyTheChangedModule\n- R6 [satisfied] test:TestCarryRootChangeRunsEverythingUnlessSelfContained test:TestChangedScopeHonoursSelfContainedModules test:TestCarrySelectsBothSidesOfARename test:TestCarryKeepsTheOwnerOfAQuotedName test:TestCarryRootModuleOwnsRootFiles test:TestCarryDeletedDependencySelectsItsDependents test:TestCarryRejectsUndecodableMetadata test:TestChangedScopeGitlinkAboveADependencySelectsItsDependents test:TestCarryDeletedNestedDependencySelectsItsDependents test:TestCarryRootDependencyIsChangedByRootFiles test:TestChangedScopeEvaluatesEveryDeclaredDependency test:TestChangedScopeDiscoveredAncestorDependencySelectsItsDependents test:TestChangedScopeIgnoresSubmoduleHidingConfiguration test:TestChangedScopeSelectsTheEnclosingModule test:TestChangedScopeRootModuleEnclosesEveryModule\n- R7 [satisfied] test:TestDeliveryValidationRunReadsTheCarriedHead\n- R8 [satisfied] test:TestCarryRecordFileIsNotAChange\n- R9 [satisfied] test:TestCarryFallsBackToAFullRun\n- R10 [satisfied] test:TestCarryFallsBackToAFullRun\n\nR9 is enforced by `safeGitRevRE` in `planCarry` before any Git call; the not-an-ancestor case drives a forged head through it. R10 is the `base without engine version` case.\n\n### Known gaps\nReview bundles and closeout consume the per-check head through the delivery index. No separate end-to-end test seals a bundle over a carried record.\n\n## 7. Final Report\n\n### Delivered scope\n`pose validate --carry` refreshes the canonical structured result. It runs the modules the changed-scope rules select since the canonical base and carries the other checks with their outcome and the head where they ran. The changed set ignores the result file and the derived administrative records that material bindings already ignore. Any doubt about the base runs everything, and the record says why. Modules can declare `selfContained` to stop being widened by changes outside every module. The delivery index reads a carried result as an observation of its own head. The record now names the engine version together with its build revision.\n\n### Files and modules changed\n`pose-mcp/internal/cli` (validate, its scope selection, its result fields and the help catalogue), `pose-mcp/internal/pose` (the delivery reading of the result), the manual in English and pt-BR with their embedded copies, this spec and its ADR.\n\n### Validation executed\nSee the execution log: the package tests with mutation checks, the full `go test ./...` and the strict matrix with 236 of 236 checks.\n\n### Residual risks\nAn instance that declares a module self-contained while its checks read files outside it would carry a stale result. The declaration is explicit and documented, and the default stays the full fallback.\n\n### Follow-ups\n- [open] F1: cover with an end-to-end test that a review bundle sealed over a carried record judges the carried head (seal, verify and closeout-check on a fixture). (owner:@pose-maintainers crit:low review:2026-12-15)\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Security\n\n## When to consult\n\nConsult this guide for authentication, authorization, sensitive data, external integrations, dependencies, and attack surfaces.\n\n## Required patterns\n\n- Apply least privilege to resource and credential access.\n- Store secrets only in appropriate secret-management mechanisms, never in code.\n- Validate and sanitize external input for its execution context.\n- Keep personal and confidential data out of plaintext logs and metrics.\n- Evaluate new dependencies for maintenance, licensing, and known vulnerabilities.\n- Test both positive and negative authentication and authorization cases.\n\n## Blocking anti-patterns\n\n- Committing credentials, tokens, keys, or secrets in any versioned artifact.\n- Disabling TLS or certificate verification without a formally documented mitigation.\n- Trusting client input for authorization decisions.\n- Executing dynamic commands without adequate validation and escaping.\n- Ignoring critical security alerts without an approved exception record.\n\n## Minimum checks\n\n- Run secret scanning on the changed diff or scope.\n- Run the module's applicable dependency vulnerability scanner.\n- Pass the relevant authentication and authorization tests.\n- Complete a review for sensitive-data exposure in logs and configuration.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Documentation Style\n\n## When to consult\n\nConsult this guide for process documentation, rules, specs, workflows, and operational instructions.\n\n## Required conventions\n\n- Write instructions in the imperative mood and begin them with action verbs.\n- Keep bullets short and limited to one idea.\n- Avoid duplicating sections with the same purpose across files.\n- Link to the single source of truth instead of copying its content.\n- Use `check`, `spec`, and `workflow` consistently.\n- State each instruction's scope explicitly to reduce ambiguity.\n\n## Examples: good and bad\n\n### Redundancy\n\n- **Good:** \"Update review criteria in `.pose/workflows/review.md` and reference that workflow from the root AGENTS file.\"\n- **Bad:** \"Repeat review criteria in AGENTS, the workflow, and every related spec.\"\n\n### Ambiguous reference\n\n- **Good:** \"Run the lint check described by the review workflow.\"\n- **Bad:** \"Run that standard validation before pushing.\"\n\n## Quick editorial checklist\n\n- Language is imperative and direct.\n- Bullets are short and non-overlapping.\n- Files do not duplicate sections.\n- `check`, `spec`, and `workflow` are used consistently.\n- References point to explicit files or paths.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Delivery Evidence\n\n## When to consult\n\nConsult this guide when writing or reviewing any document that **claims delivery,\ncompletion, or readiness**: status reports, handoffs, summaries, module READMEs,\ncurrent-state sections in specs or proposals, and messages that say something is complete.\n\n## Required conventions\n\n- Claim delivery only with attached, verifiable gate evidence: command and output\n  (`pose validate`, `go test`, `tsc`, `vitest`) or a link to the corresponding POSE report.\n- Use POSE lifecycle vocabulary: `draft`, `in-progress`, `done`, `blocked`,\n  `superseded`, or `abandoned`. Do not invent labels such as `completed` or `100% COMPLETE`.\n- Separate **implemented and verified** work from **planned or documented** work.\n  A plan describes intent; do not present that intent as current reality.\n- Reference the report or evidence that crossed the spec exit gate before using `done`.\n- Convert relative dates to absolute dates and stamp the verification date.\n- Declare exact source-tree artifact actions in the spec and reconcile them\n  against an immutable Git change set before claiming delivery.\n- Treat artifact declarations, Git observations and delivery verification as\n  separate evidence; none proves the others by itself.\n- For typed delivery targets, require a path from reconciled artifacts through\n  a production entrypoint to current structured validation results. A surface\n  requires reachability plus integration/e2e evidence; a composed capability\n  requires integration evidence.\n- Evidence answers for the component it ran in or for a component inside it: a\n  module-wide run covers its subtree, but a result from a directory inside a\n  component does not answer for the whole component. Coverage that rests only\n  on a containing module is reported as `inferred-coverage` — name it as such.\n\n## Blocking anti-patterns\n\n- Claiming `100% COMPLETE` or production readiness without a green\n  `pose validate --strict` for every affected module.\n- Publishing contradictory delivery documents for the same scope; reconcile them first.\n- Merging code with completion documentation before the applicable POSE checks pass.\n- Mixing aspiration and verified state in one paragraph without clear labels.\n\n## Minimum checks\n\n- Run `pose check --strict` for structure and spec status enums.\n- Run `pose validate --strict` for every module the document claims to deliver.\n- Run `pose lint-spec` when the document is a spec.\n- Run `pose artifact-check --strict` when the scope changes governed source-tree paths.\n- Run `pose surface-check --strict` for specs with `delivers` and `pose\n  roadmap-check --strict` before a roadmap claims completion.\n- `pose assess discover --if-stale --update-state` when closing specs to update completeness metrics, technical debt, and reports under `.pose/assessments/` and `.pose/state/`.\n\n## Precedence in multi-domain conflicts\n\n- Prefer verifiable check evidence over progress narratives when rules conflict.\n- When pressured to claim completion without a gate, record the real state\n  (`in-progress` or `blocked`) and the remaining exit conditions.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n","exit_code":0,"status":"completed"}}
