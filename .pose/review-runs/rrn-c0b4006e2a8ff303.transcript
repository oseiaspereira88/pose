H\u000fn�f\u000f`��\u000fp�\u0000fH\u000fn�f\u000ft�f\u000f��@\u000f����\bL�F��L!�H��t2L�C`��L\u000f��M\u000f��L\u0003CXN�\u0004\u0002I9�u�H�KpI\u000f��H\u0003KhH�\u0004\nbinary file matches (found \"\\0\" byte around offset 7)\npose-mcp/internal/cli/validate_concurrent_test.go:41:func TestValidateRunsChecksConcurrentlyWithinJobs(t *testing.T) {\npose-mcp/internal/cli/validate_concurrent_test.go:110:func TestValidateCancelStopsRunningChecks(t *testing.T) {\npose-mcp/internal/cli/validate_concurrent_test.go:292:func TestValidateCancelStopsThePreparatoryGoList(t *testing.T) {\npose-mcp/internal/cli/validate_concurrent_test.go:342:func TestACancelledRunIsNeverASuccess(t *testing.T) {\npose-mcp/internal/cli/validate_results_test.go:252:func TestGovernanceWriteGuardValidateCanonicalResultRefusesBeforePublish(t *testing.T) {\npose-mcp/internal/cli/validate_results_test.go:283:func TestValidateCanonicalResultReportsPublishedWhenDurabilityIsUnconfirmed(t *testing.T) {\npose-mcp/internal/pose/delivery_validation_run_test.go:7:func TestDeliveryValidationRunReadsTheCarriedHead(t *testing.T) {\n   145\t\t\t\tif filepath.IsAbs(dep) || path.IsAbs(clean) || clean == \"..\" || strings.HasPrefix(clean, \"../\") {\n   146\t\t\t\t\treturn unused(\"dependency %s of module %s lies outside the repository, so its changes cannot be seen\", dep, rel)\n   147\t\t\t\t}\n   148\t\t\t}\n   149\t\t}\n   150\t\tif caseInsensitiveFilesystem(root, os.Stat) {\n   151\t\t\treturn unused(\"the filesystem is case-insensitive, so changes cannot be attributed to modules\")\n   152\t\t}\n   153\t\t// A case-folded directory inside a case-sensitive filesystem is an alias\n   154\t\t// too (review round 8, N22).\n   155\t\tfor _, dir := range carryRelevantDirs(root, modules, meta) {\n   156\t\t\tif casefoldedDirectory(dir, os.ReadDir, os.Lstat) {\n   157\t\t\t\treturn unused(\"directory %s folds case, so changes cannot be attributed to modules\", dir)\n   158\t\t\t}\n   159\t\t}\n   160\t\t// Check ids must be unique: two checks sharing an id would share one base\n   161\t\t// result (review round 7, N19).\n   162\t\tif id := duplicateCheckID(matrix, modules); id != \"\" {\n   163\t\t\treturn unused(\"the matrix defines check %s more than once\", id)\n   164\t\t}\n   165\t\tbaseIDs := map[string]bool{}\n   166\t\tfor _, check := range base.Checks {\n   167\t\t\tif baseIDs[check.ID] {\n   168\t\t\t\treturn unused(\"the canonical result records check %s more than once\", check.ID)\n   169\t\t\t}\n   170\t\t\tbaseIDs[check.ID] = true\n   435\t\t\t}\n   436\t\t}\n   437\t\treturn \"\", nil\n   438\t}\n   439\t\n   440\t// carryRelevantDirs are the directories whose case behaviour decides whether\n   441\t// lexical selection is sound: every existing directory on the path from the\n   442\t// root to each module and to each declared dependency, ancestors included,\n   443\t// since any of them can fold a lookup (review round 9, N26).\n   444\tfunc carryRelevantDirs(root string, modules []validationModule, meta scopeMetadata) []string {\n   445\t\tseen := map[string]bool{}\n   446\t\tdirs := []string{}\n   447\t\tadd := func(p string) {\n   448\t\t\troot := filepath.Clean(root)\n   449\t\t\tfor p = filepath.Clean(p); ; p = filepath.Dir(p) {\n   450\t\t\t\tif p != root && !strings.HasPrefix(p, root+string(filepath.Separator)) {\n   451\t\t\t\t\treturn\n   452\t\t\t\t}\n   453\t\t\t\tif info, err := os.Stat(p); err == nil && info.IsDir() && !seen[p] {\n   454\t\t\t\t\tseen[p] = true\n   455\t\t\t\t\tdirs = append(dirs, p)\n   456\t\t\t\t}\n   457\t\t\t\tif p == root {\n   458\t\t\t\t\treturn\n   459\t\t\t\t}\n   460\t\t\t}\n   461\t\t}\n   462\t\tfor _, m := range modules {\n   463\t\t\tadd(m.Abs)\n   464\t\t}\n   465\t\tfor _, module := range meta.Modules {\n   466\t\t\tfor _, dep := range module.DependsOn {\n   467\t\t\t\tadd(filepath.Join(root, filepath.FromSlash(filepath.ToSlash(filepath.Clean(dep)))))\n   468\t\t\t}\n   469\t\t}\n   470\t\tsort.Strings(dirs)\n   471\t\treturn dirs\n   472\t}\n   473\t\n   474\t// casefoldedDirectory reports whether dir looks names up without case: an\n   475\t// entry spelled with its letters' case swapped names the same file.\n   476\tfunc casefoldedDirectory(dir string, readDir func(string) ([]os.DirEntry, error), stat func(string) (os.FileInfo, error)) bool {\n   477\t\t// An unreadable directory cannot be shown not to fold. Entries are probed\n   478\t\t// without following links, and an unusable one is skipped, not taken as\n   479\t\t// proof (review round 10, N27).\n   480\t\tentries, err := readDir(dir)\n   481\t\tif err != nil {\n   482\t\t\treturn true\n   483\t\t}\n   484\t\tfor _, entry := range entries {\n   485\t\t\tname := entry.Name()\n   486\t\t\tswapped := swapCase(name)\n   487\t\t\tif swapped == name {\n   488\t\t\t\tcontinue\n   489\t\t\t}\n   490\t\t\toriginal, err := stat(filepath.Join(dir, name))\n   491\t\t\tif err != nil {\n   492\t\t\t\tcontinue\n   493\t\t\t}\n   494\t\t\t// The first usable entry decides: its swapped spelling names the same\n   495\t\t\t// file only where lookups fold case.\n   496\t\t\tother, err := stat(filepath.Join(dir, swapped))\n   497\t\t\treturn err == nil && os.SameFile(original, other)\n   498\t\t}\n   499\t\treturn false\n   500\t}\n   501\t\n   502\tfunc swapCase(s string) string {\n   503\t\treturn strings.Map(func(r rune) rune {\n   504\t\t\tswitch {\n   505\t\t\tcase unicode.IsUpper(r):\n   506\t\t\t\treturn unicode.ToLower(r)\n   507\t\t\tcase unicode.IsLower(r):\n   508\t\t\t\treturn unicode.ToUpper(r)\n   509\t\t\t}\n   510\t\t\treturn r\n    20\t\n    21\tA module may declare `\"selfContained\": true` in its metadata. A change outside every module then stops selecting it. The declaration is the instance's statement that the module's checks read only its own directory and its declared dependencies, so it applies to `--changed-from` too. Without it, the existing safe fallback stays.\n    22\t\n    23\t## Consequences\n    24\t\n    25\tA change confined to one module reruns that module, the modules enclosing it (the root module included), the modules beneath the changed path and its declared dependents. Everything else is reused with its true origin visible. Only a changed file that no module owns widens the run to every module that does not declare itself self-contained. Consumers that compare a result's head with a subject head now see carried results as observations of the earlier head, which is accurate. An incorrect `selfContained` declaration can carry a stale result. That risk sits with the instance's explicit declaration and is documented next to it.\n    26\t\n    27\t## Alternatives considered\n    28\t\n","exit_code":0,"status":"completed"}}
