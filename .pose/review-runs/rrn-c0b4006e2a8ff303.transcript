{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc \"git ls-tree -z HEAD -- '.pose/*'; git ls-tree -z HEAD -- '.pose/indexes/validation-matrix.json'; git ls-tree -z HEAD -- ':(literal).pose/indexes/validation-matrix.json'; nl -ba pose-mcp/internal/cli/validate_carry.go | sed -n '305,370p'; sed -n '1,33p' pose-mcp/internal/pose/material_binding.go; git status --short\"","aggregated_output":"100644 blob 575ca5935e3ec4d9dfe95fe995807806e281c7d1\t.pose/indexes/validation-matrix.json\u0000100644 blob 575ca5935e3ec4d9dfe95fe995807806e281c7d1\t.pose/indexes/validation-matrix.json\u0000   305\tfunc aliasingSymlinkIn(root, repo, commit, prefix string, modules []validationModule, meta scopeMetadata) (string, error) {\n   306\t\tout, err := posemodel.RawGit(\"-C\", repo, \"ls-tree\", \"-r\", \"-z\", commit).Output()\n   307\t\tif err != nil {\n   308\t\t\treturn \"\", err\n   309\t\t}\n   310\t\tvar deps []string\n   311\t\tfor _, module := range meta.Modules {\n   312\t\t\tfor _, dep := range module.DependsOn {\n   313\t\t\t\tdeps = append(deps, filepath.ToSlash(filepath.Clean(dep)))\n   314\t\t\t}\n   315\t\t}\n   316\t\ttouches := func(p string) bool {\n   317\t\t\tfor _, m := range modules {\n   318\t\t\t\tif m.Rel != \".\" && (p == m.Rel || strings.HasPrefix(p, m.Rel+\"/\") || strings.HasPrefix(m.Rel, p+\"/\")) {\n   319\t\t\t\t\treturn true\n   320\t\t\t\t}\n   321\t\t\t}\n   322\t\t\tfor _, dep := range deps {\n   323\t\t\t\tif dep == \".\" || p == dep || strings.HasPrefix(p, dep+\"/\") || strings.HasPrefix(dep, p+\"/\") {\n   324\t\t\t\t\treturn true\n   325\t\t\t\t}\n   326\t\t\t}\n   327\t\t\treturn false\n   328\t\t}\n   329\t\tfor _, entry := range strings.Split(string(out), \"\\x00\") {\n   330\t\t\tif !strings.HasPrefix(entry, \"120000 \") {\n   331\t\t\t\tcontinue\n   332\t\t\t}\n   333\t\t\ttab := strings.IndexByte(entry, '\\t')\n   334\t\t\tif tab < 0 {\n   335\t\t\t\treturn \"\", fmt.Errorf(\"unexpected tree entry %q\", entry)\n   336\t\t\t}\n   337\t\t\tfields := strings.Fields(entry[:tab])\n   338\t\t\tif len(fields) != 3 {\n   339\t\t\t\treturn \"\", fmt.Errorf(\"unexpected tree entry %q\", entry)\n   340\t\t\t}\n   341\t\t\tlink := path.Join(prefix, entry[tab+1:])\n   342\t\t\tblob, err := posemodel.RawGit(\"-C\", repo, \"cat-file\", \"blob\", fields[2]).Output()\n   343\t\t\tif err != nil {\n   344\t\t\t\treturn \"\", err\n   345\t\t\t}\n   346\t\t\ttarget := string(blob)\n   347\t\t\tresolved := path.Clean(path.Join(path.Dir(link), target))\n   348\t\t\tif path.IsAbs(target) || resolved == \"..\" || strings.HasPrefix(resolved, \"../\") || touches(link) || touches(resolved) {\n   349\t\t\t\treturn link, nil\n   350\t\t\t}\n   351\t\t}\n   352\t\treturn \"\", nil\n   353\t}\n   354\t\n   355\t// caseInsensitiveFilesystem reports whether root's filesystem folds case: the\n   356\t// upper-case spelling of its .git entry names the same file.\n   357\tfunc caseInsensitiveFilesystem(root string, stat func(string) (os.FileInfo, error)) bool {\n   358\t\tlower, err := stat(filepath.Join(root, \".git\"))\n   359\t\tif err != nil {\n   360\t\t\treturn true\n   361\t\t}\n   362\t\tupper, err := stat(filepath.Join(root, \".GIT\"))\n   363\t\treturn err == nil && os.SameFile(lower, upper)\n   364\t}\n   365\t\n   366\t// duplicateCheckID returns a check id the matrix defines more than once.\n   367\tfunc duplicateCheckID(matrix validationMatrix, modules []validationModule) string {\n   368\t\tseen := map[string]bool{}\n   369\t\tfor _, module := range modules {\n   370\t\t\tstack, checks, _ := moduleValidationChecks(module, matrix, \"\", \"\")\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Validation evidence binds to the material it validated (spec\n// pose-validation-evidence-material-binding, ADR\n// validation-evidence-binds-to-validated-material). A commit whose every\n// changed path is a derived administrative record does not change what the\n// checks exercised, so it does not move the material digest.\n\n// engineVersion is the running engine, registered by the binaries (internal/pose\n// stays importable on its own). It is part of every material digest, so a new\n// engine never inherits evidence the previous one produced.\nvar engineVersion = \"unregistered\"\n\n// SetEngineVersion registers the running engine for material digests.\nfunc SetEngineVersion(v string) { engineVersion = v }\n\n// administrativeDirs is the closed list of derived-record directories. It is\n// owned by the engine; adding a class is a contract change that needs an ADR.\nvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n\n// materialIndexes are files inside an administrative directory that still\n// change what the checks demand.\nvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n","exit_code":0,"status":"completed"}}
