{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1435,1477p' pose-mcp/internal/cli/validate.go; rg -n 'WallSeconds|DurationSeconds' pose-mcp/internal/cli/validate_results.go | tail -12; sed -n '149,177p' pose-mcp/internal/pose/material_binding.go; git status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1435,1477p' pose-mcp/internal/cli/validate.go; rg -n 'WallSeconds|DurationSeconds' pose-mcp/internal/cli/validate_results.go | tail -12; sed -n '149,177p' pose-mcp/internal/pose/material_binding.go; git status --short\"","aggregated_output":"\trun.MaterialClean = startedClean && endedClean && materialWorktreeClean(root) && run.GitHead != \"\" && endHead == run.GitHead\n\t// A run that did not validate its recorded head binds no material: its\n\t// bindings would let a later tree make a misattributed pass current again\n\t// (review round 5, N12).\n\tif len(run.MaterialProvenance) > 0 && !run.MaterialClean {\n\t\tfor spec := range run.MaterialProvenance {\n\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n\t\t}\n\t}\n\t// A cancelled run never reads as a success, whatever the severity of the\n\t// checks it stopped (review round 1, B5).\n\tcancelled := false\n\tfor _, check := range run.Checks {\n\t\tcancelled = cancelled || check.LimitState == \"cancelled\"\n\t}\n\tfor _, line := range validationTimingNotes(run) {\n\t\tsteps.Note(line)\n\t}\n\tsteps.Summary()\n\tif executed == 0 && run.Counts.Carried == 0 {\n\t\tfmt.Fprintln(stdout, \"No modules/checks matched the matrix and filters.\")\n\t}\n\tresult := \"pass\"\n\tif cancelled {\n\t\tfailures++\n\t\tresult = \"fail\"\n\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"validation cancelled\", \"validação cancelada\")})\n\t} else if failures > 0 {\n\t\tresult = \"fail\"\n\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"required check failed\", \"check obrigatório falhou\")})\n\t} else {\n\t\tif optionalFailures > 0 {\n\t\t\tresult = \"partial\"\n\t\t\tr.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"optional-check\",\n\t\t\t\tMessage: fmt.Sprintf(cliText(locale, \"%d optional check(s) failed\", \"%d check(s) opcional(is) falharam\"), optionalFailures)})\n\t\t}\n\t\tr.Verdict(cliout.Verdict{State: cliout.StatePass})\n\t}\n\trun.Outcome = result\n\tusageFindings := make([]usageFinding, 0, run.Counts.Failed+run.Counts.OptionalFailed+run.Counts.Errored)\n\tfor _, check := range run.Checks {\n\t\tif check.Outcome != \"fail\" && check.Outcome != \"error\" {\n\t\t\tcontinue\n40:\tDurationSeconds float64           `json:\"duration_seconds\"`\n88:\t// Jobs is how many checks ran at once; WallSeconds the run's elapsed time\n91:\tWallSeconds float64 `json:\"wall_seconds,omitempty\"`\n312:\t\t\tTime:      fmt.Sprintf(\"%.3f\", c.DurationSeconds),\n// scoped digest, the unavailable marker when a change set's material could not\n// be read, or nothing when the spec has no material-bound change set.\nfunc MaterialBinding(graph DeliveryIntegrityGraph, spec string) (string, bool) {\n\tsets := 0\n\tfor _, set := range graph.ChangeSets {\n\t\tif set.Spec != spec {\n\t\t\tcontinue\n\t\t}\n\t\tsets++\n\t\t// A set read back from the report history carries no material digest, and\n\t\t// one that could not be read has the unreadable marker: either way the\n\t\t// scope's material cannot be established, so the run records the binding as\n\t\t// unavailable instead of silently falling back to the commit-bound rules.\n\t\tif set.MaterialDigest == \"\" || set.MaterialDigest == MaterialDigestUnreadable {\n\t\t\treturn MaterialBindingUnavailable, true\n\t\t}\n\t}\n\tif sets == 0 {\n\t\treturn \"\", false\n\t}\n\tif digest := ScopedMaterialDigest(graph, spec); digest != \"\" {\n\t\treturn digest, true\n\t}\n\treturn \"\", false\n}\n\n// ScopedMaterialDigest binds evidence to the claims and material of one spec's\n// change sets and to the engine. It is empty when any change set has no\n// material digest, so no binding can be recorded for it.\n","exit_code":0,"status":"completed"}}
