{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'canonical|changedFrom' pose-mcp/internal/cli/validate.go | head -30; sed -n '335,370p' .pose/indexes/validation-matrix.json; sed -n '1,100p' pose-mcp/internal/pose/git_snapshot_integrity.go; rg -n 'func gitMaterializedChanges|func gitChangedPaths' pose-mcp/internal/pose/git_snapshot_integrity.go\"","aggregated_output":"68:\t// carried marks a check whose result comes from the canonical base (spec\n899:// Closeout already holds its root lease. Keep that Store through canonical\n906:\tchangedFrom, changedTo := \"\", \"\"\n930:\t\t\t// Refresh the canonical result, carrying the checks a change\n979:\t\t\t\tchangedFrom = args[i]\n1005:\tcanonicalResultsPath := \"\"\n1007:\t\tcanonicalResultsPath = configuredDeliveryResultsPath(root)\n1011:\t\tcase moduleFilter != \"\" || stackFilter != \"\" || workspaceFilter != \"\" || changedFrom != \"\" || changedTo != \"\":\n1012:\t\t\trender(stdout, stderr).Failure(cliText(locale, \"--carry refreshes the whole canonical result; it cannot be combined with --module, --stack, --workspace, --root-only, --changed-from or --changed-to\", \"--carry renova o resultado canônico inteiro; não combina com --module, --stack, --workspace, --root-only, --changed-from ou --changed-to\"))\n1014:\t\tcase canonicalResultsPath == \"\":\n1017:\t\tcase normalizeValidationOutputPath(jsonOut) != canonicalResultsPath:\n1018:\t\t\trender(stdout, stderr).Failure(fmt.Sprintf(cliText(locale, \"--carry writes the canonical result: use --json-out %s\", \"--carry grava o resultado canônico: use --json-out %s\"), canonicalResultsPath))\n1113:\tif changedTo != \"\" && changedFrom == \"\" {\n1117:\tif changedFrom != \"\" {\n1118:\t\tsel, err := computeChangedScope(root, changedFrom, changedTo, modules)\n1155:\t\tcarryState = planCarry(root, canonicalResultsPath, mode, run.MatrixSHA256, run.GitHead, matrix, modules)\n1498:\t\tif name == \"json\" && canonicalResultsPath != \"\" && normalizeValidationOutputPath(writer.path) == canonicalResultsPath {\n1499:\t\t\terr := publishCanonicalValidationJSONIn(store, writer.path, canonicalResultsPath, run)\n        {\n          \"name\": \"delegated-output-redaction-diagnostics-integration\",\n          \"program\": \"go\",\n          \"args\": [\"test\", \"./internal/pose\", \"./internal/cli\", \"-run\", \"TestDelegateTaskExplainsTheLegacyClaudeSessionCaptureFailure|TestDelegateTaskDiagnosesRedactionGrowth|TestDelegationCaptureFailureWithholdsPrivateErrorDetails\", \"-count=1\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"integration\"\n        },\n        {\n          \"name\": \"build\",\n          \"program\": \"go\",\n          \"args\": [\"build\", \"./...\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"build\"\n        },\n        {\n          \"name\": \"test\",\n          \"program\": \"bash\",\n          \"args\": [\"../scripts/test-engine-go.sh\"],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"unit\",\n          \"timeoutSeconds\": 1800\n        },\n        {\n          \"name\": \"vet\",\n          \"program\": \"go\",\n          \"args\": [\"vet\", \"./...\"],\n          \"severity\": \"optional\",\n          \"evidenceClass\": \"lint\"\n        },\n        {\n          \"name\": \"governance-read-view-integration\",\n          \"program\": \"go\",\n          \"args\": [\n            \"test\",\n            \"-race\",\n            \"./internal/pose\",\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha1\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"fmt\"\n\t\"hash\"\n\t\"io\"\n\t\"io/fs\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n)\n\n// The bytes a snapshot reads are bounded by the committed tree it compares\n// against plus a margin, never less than the margin alone and never more than\n// the ceiling: a fixed bound stopped every closeout once a repository's\n// committed tree outgrew it (spec pose-git-snapshot-budget-scales-with-the-tree).\nvar (\n\tgitSnapshotMarginBytes  int64 = 256 << 20\n\tgitSnapshotCeilingBytes int64 = 4 << 30\n)\n\nfunc gitSnapshotBudget(committedBytes int64) int64 {\n\tif committedBytes < 0 {\n\t\tcommittedBytes = 0\n\t}\n\tif committedBytes > gitSnapshotCeilingBytes-gitSnapshotMarginBytes {\n\t\treturn gitSnapshotCeilingBytes\n\t}\n\treturn committedBytes + gitSnapshotMarginBytes\n}\n\n// A committed tree listing is read through a bounded buffer under a\n// deadline: 100,000 entries of ordinary paths fit well inside it, and a\n// listing past it fails closed before it is retained (review N2).\nvar (\n\tgitTreeListingMaxBytes int64 = 64 << 20\n\tgitTreeListingTimeout        = 2 * time.Minute\n)\n\n// listCommittedTree returns `ls-tree -r -l -z commit` of root, bounded.\nfunc listCommittedTree(root, commit string) ([]byte, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), gitTreeListingTimeout)\n\tdefer cancel()\n\treturn runGovernanceGitCommandContext(ctx, NativeFiles(), root, []string{\"ls-tree\", \"-r\", \"-l\", \"-z\", commit}, gitTreeListingMaxBytes)\n}\n\n// gitCommittedTreeBytes sums the blob sizes of an `ls-tree -r -l -z` listing.\nfunc gitCommittedTreeBytes(listing []byte) int64 {\n\tvar total int64\n\tfor _, record := range bytes.Split(listing, []byte{0}) {\n\t\ti := bytes.IndexByte(record, '\\t')\n\t\tif i < 0 {\n\t\t\tcontinue\n\t\t}\n\t\tfields := strings.Fields(string(record[:i]))\n\t\tif len(fields) == 4 {\n\t\t\tif size, err := strconv.ParseInt(fields[3], 10, 64); err == nil && size > 0 {\n\t\t\t\ttotal += size\n\t\t\t}\n\t\t}\n\t}\n\treturn total\n}\n\n// Snapshot disk, including ignored files. Git status alone cannot witness\n// creation of an ignored output. WalkDir never follows a directory symlink.\nfunc dispatchDiskSnapshot(root string, committedGitlinks ...int64) (map[string]string, error) {\n\tentries := map[string]string{}\n\tvar total int64\n\tcommitted := int64(0)\n\tif listing, err := listCommittedTree(root, \"HEAD\"); err == nil {\n\t\tcommitted = gitCommittedTreeBytes(listing)\n\t}\n\tfor _, size := range committedGitlinks {\n\t\tcommitted += size\n\t}\n\tbudget := gitSnapshotBudget(committed)\n\terr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\trel, err := filepath.Rel(root, path)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif rel == \".\" {\n\t\t\treturn nil\n\t\t}\n184:func gitChangedPaths(root string) ([]string, error) {\n229:func gitMaterializedChanges(root, commit string) ([]string, error) {\n232:func gitMaterializedChangesFor(root, commit string, matters func(string) bool) ([]string, error) {\n236:func gitMaterializedChangesForIn(files Files, root, commit string, matters func(string) bool, producer string) ([]string, error) {\n","exit_code":0,"status":"completed"}}
