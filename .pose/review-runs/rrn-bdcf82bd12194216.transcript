{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VwDMu3cJ13U26muV6g1kqo","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"container/list\"\n5\t\t\"fmt\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\t\"sync\"\n10\t\t\"sync/atomic\"\n11\t)\n12\t\n13\t// ResidentGitMemo keeps, in a process that outlives one operation, the output of the Git reads\n14\t// that are pure functions of object ids or of the commit HEAD named when they ran (see\n15\t// governancePureGitRead). It is off unless a process turns it on, so nothing changes for a\n16\t// command that runs once; the optional worktree runtime turns it on (spec\n17\t// pose-worktree-runtime-resident-cache). A hit is the answer Git would give: the key\n18\t// holds the commit and the shallow state, and the output of such a read cannot differ for them.\n19\ttype ResidentGitMemo struct {\n20\t\tmu      sync.Mutex\n21\t\tmax     int64\n22\t\tbytes   int64\n23\t\tentries map[string]*list.Element\n24\t\torder   *list.List // front is the most recently used\n25\t\thits    atomic.Int64\n26\t\tmisses  atomic.Int64\n27\t}\n28\t\n29\ttype residentGitEntry struct {\n30\t\tkey    string\n31\t\tstdout []byte\n32\t}\n33\t\n34\tvar residentGit atomic.Pointer[ResidentGitMemo]\n35\t\n36\t// EnableResidentGitMemo turns the memo on with a byte budget for what it retains.\n37\tfunc EnableResidentGitMemo(maxBytes int64) *ResidentGitMemo {\n38\t\tm := &ResidentGitMemo{max: maxBytes, entries: map[string]*list.Element{}, order: list.New()}\n39\t\tresidentGit.Store(m)\n40\t\treturn m\n41\t}\n42\t\n43\t// DisableResidentGitMemo turns the memo off and drops what it held.\n44\tfunc DisableResidentGitMemo() { residentGit.Store(nil) }\n45\t\n46\t// ResidentGitMemoStats are the hits, misses, entries and retained bytes since it was enabled.\n47\tfunc ResidentGitMemoStats() (hits, misses int64, entries int, bytes int64) {\n48\t\tm := residentGit.Load()\n49\t\tif m == nil {\n50\t\t\treturn 0, 0, 0, 0\n51\t\t}\n52\t\tm.mu.Lock()\n53\t\tdefer m.mu.Unlock()\n54\t\treturn m.hits.Load(), m.misses.Load(), len(m.entries), m.bytes\n55\t}\n56\t\n57\t// residentGitKey names a read: the root, the commit it was made at (empty for a read by object\n58\t// id), the shallow state of the repository and the exact command. A root whose Git directory\n59\t// is not a plain .git directory is not memoized: its shallow state is not read here.\n60\tfunc residentGitKey(root, head string, args []string) (string, bool) {\n61\t\tgitDir := filepath.Join(root, \".git\")\n62\t\tinfo, err := os.Lstat(gitDir)\n63\t\tif err != nil || !info.IsDir() {\n64\t\t\treturn \"\", false\n65\t\t}\n66\t\tshallow := \"-\"\n67\t\tif s, err := os.Stat(filepath.Join(gitDir, \"shallow\")); err == nil {\n68\t\t\tshallow = fmt.Sprintf(\"%d:%d\", s.Size(), s.ModTime().UnixNano())\n69\t\t}\n70\t\t// The repository's own config can change what a read answers (log.follow, for one).\n71\t\tconfig := \"-\"\n72\t\tif c, err := os.Stat(filepath.Join(gitDir, \"config\")); err == nil {\n73\t\t\tconfig = fmt.Sprintf(\"%d:%d\", c.Size(), c.ModTime().UnixNano())\n74\t\t}\n75\t\treturn strings.Join([]string{filepath.Clean(root), head, shallow, config, strings.Join(args, \"\\x00\")}, \"\\x01\"), true\n76\t}\n77\t\n78\tfunc (m *ResidentGitMemo) get(key string) ([]byte, bool) {\n79\t\tm.mu.Lock()\n80\t\tdefer m.mu.Unlock()\n81\t\tel, ok := m.entries[key]\n82\t\tif !ok {\n83\t\t\tm.misses.Add(1)\n84\t\t\treturn nil, false\n85\t\t}\n86\t\tm.order.MoveToFront(el)\n87\t\tm.hits.Add(1)\n88\t\treturn append([]byte(nil), el.Value.(*residentGitEntry).stdout...), true\n89\t}\n90\t\n91\tfunc (m *ResidentGitMemo) put(key string, stdout []byte) {\n92\t\tsize := int64(len(key) + len(stdout))\n93\t\tm.mu.Lock()\n94\t\tdefer m.mu.Unlock()\n95\t\tif size > m.max {\n96\t\t\treturn\n97\t\t}\n98\t\tif el, ok := m.entries[key]; ok {\n99\t\t\tm.bytes -= int64(len(el.Value.(*residentGitEntry).key) + len(el.Value.(*residentGitEntry).stdout))\n100\t\t\tm.order.Remove(el)\n101\t\t\tdelete(m.entries, key)\n102\t\t}\n103\t\tfor m.bytes+size > m.max {\n104\t\t\tlast := m.order.Back()\n105\t\t\tif last == nil {\n106\t\t\t\tbreak\n107\t\t\t}\n108\t\t\te := last.Value.(*residentGitEntry)\n109\t\t\tm.bytes -= int64(len(e.key) + len(e.stdout))\n110\t\t\tm.order.Remove(last)\n111\t\t\tdelete(m.entries, e.key)\n112\t\t}\n113\t\tm.entries[key] = m.order.PushFront(&residentGitEntry{key: key, stdout: append([]byte(nil), stdout...)})\n114\t\tm.bytes += size\n115\t}\n116\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"ff4d88f9-2f57-4500-b812-037f8079d14f","timestamp":"2026-11-10T09:50:35.715Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3334883877/worktree/pose-mcp/internal/pose/resident_git_memo.go","content":"package pose\n\nimport (\n\t\"container/list\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n)\n\n// ResidentGitMemo keeps, in a process that outlives one operation, the output of the Git reads\n// that are pure functions of object ids or of the commit HEAD named when they ran (see\n// governancePureGitRead). It is off unless a process turns it on, so nothing changes for a\n// command that runs once; the optional worktree runtime turns it on (spec\n// pose-worktree-runtime-resident-cache). A hit is the answer Git would give: the key\n// holds the commit and the shallow state, and the output of such a read cannot differ for them.\ntype ResidentGitMemo struct {\n\tmu      sync.Mutex\n\tmax     int64\n\tbytes   int64\n\tentries map[string]*list.Element\n\torder   *list.List // front is the most recently used\n\thits    atomic.Int64\n\tmisses  atomic.Int64\n}\n\ntype residentGitEntry struct {\n\tkey    string\n\tstdout []byte\n}\n\nvar residentGit atomic.Pointer[ResidentGitMemo]\n\n// EnableResidentGitMemo turns the memo on with a byte budget for what it retains.\nfunc EnableResidentGitMemo(maxBytes int64) *ResidentGitMemo {\n\tm := &ResidentGitMemo{max: maxBytes, entries: map[string]*list.Element{}, order: list.New()}\n\tresidentGit.Store(m)\n\treturn m\n}\n\n// DisableResidentGitMemo turns the memo off and drops what it held.\nfunc DisableResidentGitMemo() { residentGit.Store(nil) }\n\n// ResidentGitMemoStats are the hits, misses, entries and retained bytes since it was enabled.\nfunc ResidentGitMemoStats() (hits, misses int64, entries int, bytes int64) {\n\tm := residentGit.Load()\n\tif m == nil {\n\t\treturn 0, 0, 0, 0\n\t}\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\treturn m.hits.Load(), m.misses.Load(), len(m.entries), m.bytes\n}\n\n// residentGitKey names a read: the root, the commit it was made at (empty for a read by object\n// id), the shallow state of the repository and the exact command. A root whose Git directory\n// is not a plain .git directory is not memoized: its shallow state is not read here.\nfunc residentGitKey(root, head string, args []string) (string, bool) {\n\tgitDir := filepath.Join(root, \".git\")\n\tinfo, err := os.Lstat(gitDir)\n\tif err != nil || !info.IsDir() {\n\t\treturn \"\", false\n\t}\n\tshallow := \"-\"\n\tif s, err := os.Stat(filepath.Join(gitDir, \"shallow\")); err == nil {\n\t\tshallow = fmt.Sprintf(\"%d:%d\", s.Size(), s.ModTime().UnixNano())\n\t}\n\t// The repository's own config can change what a read answers (log.follow, for one).\n\tconfig := \"-\"\n\tif c, err := os.Stat(filepath.Join(gitDir, \"config\")); err == nil {\n\t\tconfig = fmt.Sprintf(\"%d:%d\", c.Size(), c.ModTime().UnixNano())\n\t}\n\treturn strings.Join([]string{filepath.Clean(root), head, shallow, config, strings.Join(args, \"\\x00\")}, \"\\x01\"), true\n}\n\nfunc (m *ResidentGitMemo) get(key string) ([]byte, bool) {\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\tel, ok := m.entries[key]\n\tif !ok {\n\t\tm.misses.Add(1)\n\t\treturn nil, false\n\t}\n\tm.order.MoveToFront(el)\n\tm.hits.Add(1)\n\treturn append([]byte(nil), el.Value.(*residentGitEntry).stdout...), true\n}\n\nfunc (m *ResidentGitMemo) put(key string, stdout []byte) {\n\tsize := int64(len(key) + len(stdout))\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\tif size > m.max {\n\t\treturn\n\t}\n\tif el, ok := m.entries[key]; ok {\n\t\tm.bytes -= int64(len(el.Value.(*residentGitEntry).key) + len(el.Value.(*residentGitEntry).stdout))\n\t\tm.order.Remove(el)\n\t\tdelete(m.entries, key)\n\t}\n\tfor m.bytes+size > m.max {\n\t\tlast := m.order.Back()\n\t\tif last == nil {\n\t\t\tbreak\n\t\t}\n\t\te := last.Value.(*residentGitEntry)\n\t\tm.bytes -= int64(len(e.key) + len(e.stdout))\n\t\tm.order.Remove(last)\n\t\tdelete(m.entries, e.key)\n\t}\n\tm.entries[key] = m.order.PushFront(&residentGitEntry{key: key, stdout: append([]byte(nil), stdout...)})\n\tm.bytes += size\n}\n","numLines":116,"startLine":1,"totalLines":116}},"tool_result_meta":[{"id":"toolu_01VwDMu3cJ13U26muV6g1kqo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
