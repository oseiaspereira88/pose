{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H31fR6YwFCLtV6zERZajvJ","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"os\"\n10\t\t\"os/exec\"\n11\t\t\"os/signal\"\n12\t\t\"runtime/debug\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"sync/atomic\"\n17\t\t\"syscall\"\n18\t\t\"time\"\n19\t\n20\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n21\t\t\"github.com/harne8/pose-mcp/internal/version\"\n22\t\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n23\t)\n24\t\n25\t// Spec pose-optional-worktree-runtime. The runtime is opt-in: nothing here starts it unless\n26\t// asked, and every other command runs standalone whether it runs or not.\n27\t\n28\tconst runtimeStatusSchema = \"pose.runtime.status/1\"\n29\t\n30\t// runtimeSpawn starts the runtime of root detached; tests replace it.\n31\tvar runtimeSpawn = func(root string, serveArgs []string) error {\n32\t\tself, err := os.Executable()\n33\t\tif err != nil {\n34\t\t\treturn err\n35\t\t}\n36\t\tcmd := exec.Command(self, append([]string{\"runtime\", \"serve\"}, serveArgs...)...)\n37\t\tcmd.Dir = root\n38\t\tcmd.Env = os.Environ()\n39\t\tcmd.Stdin, cmd.Stdout, cmd.Stderr = nil, nil, nil\n40\t\tdetachProcess(cmd)\n41\t\tif err := cmd.Start(); err != nil {\n42\t\t\treturn err\n43\t\t}\n44\t\treturn cmd.Process.Release()\n45\t}\n46\t\n47\tfunc runtimeBuild() string {\n48\t\tif info, ok := debug.ReadBuildInfo(); ok {\n49\t\t\tfor _, s := range info.Settings {\n50\t\t\t\tif s.Key == \"vcs.revision\" && s.Value != \"\" {\n51\t\t\t\t\treturn s.Value\n52\t\t\t\t}\n53\t\t\t}\n54\t\t}\n55\t\treturn \"unknown\"\n56\t}\n57\t\n58\ttype runtimeFlags struct {\n59\t\tjsonOut   bool\n60\t\tidle      time.Duration\n61\t\tdrain     time.Duration\n62\t\tadmission runtimeAdmission\n63\t}\n64\t\n65\t// serveArgs are the flags `start` hands the detached `serve`.\n66\tfunc (f runtimeFlags) serveArgs() []string {\n67\t\ta := f.admission\n68\t\treturn []string{\"--idle\", f.idle.String(), \"--heavy-slots\", strconv.Itoa(a.HeavySlots), \"--short-slots\", strconv.Itoa(a.ShortSlots),\n69\t\t\t\"--heavy-queue\", strconv.Itoa(a.HeavyQueue), \"--short-queue\", strconv.Itoa(a.ShortQueue), \"--memo-mib\", strconv.Itoa(a.MemoMiB)}\n70\t}\n71\t\n72\tfunc parseRuntimeFlags(args []string) (runtimeFlags, string) {\n73\t\tf := runtimeFlags{idle: 30 * time.Minute, drain: 5 * time.Second, admission: defaultRuntimeAdmission()}\n74\t\tfor i := 0; i < len(args); i++ {\n75\t\t\tswitch args[i] {\n76\t\t\tcase \"--json\":\n77\t\t\t\tf.jsonOut = true\n78\t\t\tcase \"--heavy-slots\", \"--short-slots\", \"--heavy-queue\", \"--short-queue\", \"--memo-mib\":\n79\t\t\t\tif i+1 >= len(args) {\n80\t\t\t\t\treturn f, args[i] + \" needs a number\"\n81\t\t\t\t}\n82\t\t\t\tn, err := strconv.Atoi(args[i+1])\n83\t\t\t\tminimum := 0\n84\t\t\t\tif strings.HasSuffix(args[i], \"-slots\") || args[i] == \"--memo-mib\" {\n85\t\t\t\t\tminimum = 1\n86\t\t\t\t}\n87\t\t\t\tif err != nil || n < minimum || n > 1<<20 {\n88\t\t\t\t\treturn f, args[i] + \": \" + args[i+1] + \" is not a number from \" + strconv.Itoa(minimum) + \" to 1048576\"\n89\t\t\t\t}\n90\t\t\t\tswitch args[i] {\n91\t\t\t\tcase \"--heavy-slots\":\n92\t\t\t\t\tf.admission.HeavySlots = n\n93\t\t\t\tcase \"--short-slots\":\n94\t\t\t\t\tf.admission.ShortSlots = n\n95\t\t\t\tcase \"--heavy-queue\":\n96\t\t\t\t\tf.admission.HeavyQueue = n\n97\t\t\t\tcase \"--short-queue\":\n98\t\t\t\t\tf.admission.ShortQueue = n\n99\t\t\t\tdefault:\n100\t\t\t\t\tf.admission.MemoMiB = n\n101\t\t\t\t}\n102\t\t\t\ti++\n103\t\t\tcase \"--idle\", \"--drain\":\n104\t\t\t\tif i+1 >= len(args) {\n105\t\t\t\t\treturn f, args[i] + \" needs a duration\"\n106\t\t\t\t}\n107\t\t\t\td, err := time.ParseDuration(args[i+1])\n108\t\t\t\tif err != nil || d < 0 || args[i] == \"--drain\" && d < time.Millisecond {\n109\t\t\t\t\treturn f, args[i] + \": \" + args[i+1] + \" is not a duration\"\n110\t\t\t\t}\n111\t\t\t\tif args[i] == \"--idle\" {\n112\t\t\t\t\tf.idle = d\n113\t\t\t\t} else {\n114\t\t\t\t\tf.drain = d\n115\t\t\t\t}\n116\t\t\t\ti++\n117\t\t\tdefault:\n118\t\t\t\treturn f, \"unknown argument \" + args[i]\n119\t\t\t}\n120\t\t}\n121\t\treturn f, \"\"\n122\t}\n123\t\n124\t// cmdRuntime is `pose runtime serve|start|attach|status|stop|restart`.\n125\tfunc cmdRuntime(root string, args []string, stdout, stderr io.Writer) int {\n126\t\tout := render(stdout, stderr)\n127\t\tif len(args) == 0 {\n128\t\t\tout.Usage(tr(\"usage: pose runtime <serve|start|attach|status|stop|restart|run> [--idle <d>] [--drain <d>] [--json]\", \"uso: pose runtime <serve|start|attach|status|stop|restart|run> [--idle <d>] [--drain <d>] [--json]\"))\n129\t\t\treturn 2\n130\t\t}\n131\t\tsub := args[0]\n132\t\tif sub == \"run\" {\n133\t\t\treturn cmdRuntimeRun(root, args[1:], stdout, stderr)\n134\t\t}\n135\t\tf, problem := parseRuntimeFlags(args[1:])\n136\t\tif problem != \"\" {\n137\t\t\tout.Failure(\"pose runtime: \" + problem)\n138\t\t\treturn 2\n139\t\t}\n140\t\tid, err := worktreeruntime.ResolveIdentity(root, version.Version, runtimeBuild())\n141\t\tif err != nil {\n142\t\t\tout.Failure(\"pose runtime: \" + err.Error())\n143\t\t\treturn 2\n144\t\t}\n145\t\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n146\t\tctx := context.Background()\n147\t\tswitch sub {\n148\t\tcase \"serve\":\n149\t\t\tsigs := make(chan os.Signal, 1)\n150\t\t\tsignal.Notify(sigs, os.Interrupt, syscall.SIGTERM)\n151\t\t\tserveCtx, cancel := context.WithCancel(ctx)\n152\t\t\tdefer cancel()\n153\t\t\tgo func() { <-sigs; cancel() }()\n154\t\t\t// A resident process keeps the pure Git reads it makes between hosted commands.\n155\t\t\tposemodel.EnableResidentGitMemo(int64(f.admission.MemoMiB) << 20)\n156\t\t\tdefer posemodel.DisableResidentGitMemo()\n157\t\t\tvar busy atomic.Int64\n158\t\t\tlanes := newHostedLanes(f.admission)\n159\t\t\tif err := worktreeruntime.Serve(serveCtx, worktreeruntime.Options{Identity: id, Dir: client.Dir, Idle: f.idle, Busy: busy.Load, Metrics: lanes.metrics, Handler: runtimeHostedHandler(runtimeEnvDigest(os.Environ()), &busy, lanes)}); err != nil {\n160\t\t\t\treturn runtimeFailure(out, stdout, f, \"serve\", err)\n161\t\t\t}\n162\t\t\treturn 0\n163\t\tcase \"status\", \"attach\":\n164\t\t\treply, err := client.Handshake(ctx)\n165\t\t\treturn runtimeReport(out, stdout, f, sub, reply, err)\n166\t\tcase \"stop\":\n167\t\t\treply, err := client.Stop(ctx, f.drain)\n168\t\t\tif errors.Is(err, worktreeruntime.ErrNoRuntime) || errors.Is(err, worktreeruntime.ErrUnsupported) {\n169\t\t\t\treturn runtimeReport(out, stdout, f, sub, reply, err)\n170\t\t\t}\n171\t\t\tif err != nil {\n172\t\t\t\treturn runtimeFailure(out, stdout, f, sub, err)\n173\t\t\t}\n174\t\t\treturn runtimeReport(out, stdout, f, \"stopped\", reply, nil)\n175\t\tcase \"start\", \"restart\":\n176\t\t\tif sub == \"restart\" {\n177\t\t\t\tstopped, err := client.Stop(ctx, f.drain)\n178\t\t\t\tif err != nil && !errors.Is(err, worktreeruntime.ErrNoRuntime) {\n179\t\t\t\t\treturn runtimeReport(out, stdout, f, sub, stopped, err)\n180\t\t\t\t}\n181\t\t\t\tif stopped.Abandoned > 0 {\n182\t\t\t\t\t// The process is still ending what it abandoned and holds the endpoint: a new\n183\t\t\t\t\t// one would be refused, so the restart says so instead of starting it.\n184\t\t\t\t\treturn runtimeFailure(out, stdout, f, sub, fmt.Errorf(\"the runtime abandoned %d request(s) in flight and is still ending them (pid %d); start again when it has exited\", stopped.Abandoned, stopped.PID))\n185\t\t\t\t}\n186\t\t\t\twaitRuntimeGone(ctx, client)\n187\t\t\t}\n188\t\t\tif reply, err := client.Handshake(ctx); err == nil {\n189\t\t\t\treturn runtimeReport(out, stdout, f, \"already-running\", reply, nil)\n190\t\t\t} else if !errors.Is(err, worktreeruntime.ErrNoRuntime) {\n191\t\t\t\treturn runtimeReport(out, stdout, f, sub, worktreeruntime.Reply{}, err)\n192\t\t\t}\n193\t\t\tif !worktreeruntime.Supported() {\n194\t\t\t\treturn runtimeFailure(out, stdout, f, sub, worktreeruntime.ErrUnsupported)\n195\t\t\t}\n196\t\t\tif err := runtimeSpawn(root, f.serveArgs()); err != nil {\n197\t\t\t\treturn runtimeFailure(out, stdout, f, sub, err)\n198\t\t\t}\n199\t\t\tvar reply worktreeruntime.Reply\n200\t\t\tfor i := 0; i < 100; i++ {\n201\t\t\t\tif reply, err = client.Handshake(ctx); err == nil {\n202\t\t\t\t\treturn runtimeReport(out, stdout, f, \"started\", reply, nil)\n203\t\t\t\t}\n204\t\t\t\ttime.Sleep(50 * time.Millisecond)\n205\t\t\t}\n206\t\t\treturn runtimeFailure(out, stdout, f, sub, fmt.Errorf(\"the runtime did not answer after it was started: %w\", err))\n207\t\t}\n208\t\tout.Failure(\"pose runtime: \" + tr(\"unknown subcommand \", \"subcomando desconhecido \") + sub)\n209\t\treturn 2\n210\t}\n211\t\n212\t// waitRuntimeGone waits until the endpoint can be taken: nothing answers and the old process\n213\t// has released its lock, which happens after the socket is gone.\n214\tfunc waitRuntimeGone(ctx context.Context, client worktreeruntime.Client) {\n215\t\tclient.WaitReleased(ctx, 10*time.Second)\n216\t}\n217\t\n218\t// runtimeReport writes the state a subcommand ends in. Not running is a state, not a fault:\n219\t// every command runs standalone then; only a runtime that refuses the attach, or an attach\n220\t// that was asked for and cannot be had, is a failure.\n221\tfunc runtimeReport(out interface{ Field(string, string) }, stdout io.Writer, f runtimeFlags, sub string, reply worktreeruntime.Reply, err error) int {\n222\t\tstate, code, detail := \"running\", 0, \"\"\n223\t\tswitch {\n224\t\tcase errors.Is(err, worktreeruntime.ErrUnsupported):\n225\t\t\tstate, detail = \"unsupported\", err.Error()\n226\t\tcase errors.Is(err, worktreeruntime.ErrNoRuntime):\n227\t\t\tstate, detail = \"standalone\", tr(\"no runtime is running for this worktree: commands run standalone\", \"nenhum runtime está rodando para este worktree: os comandos rodam standalone\")\n228\t\tcase err != nil:\n229\t\t\tvar inc *worktreeruntime.IncompatibleError\n230\t\t\tif errors.As(err, &inc) {\n231\t\t\t\tstate, code, detail = \"incompatible\", 1, err.Error()+tr(\"; stop it with `pose runtime stop` (this engine can, whatever its version) or end process \", \"; pare-o com `pose runtime stop` (este engine consegue, qualquer que seja a versão) ou encerre o processo \")+fmt.Sprint(reply.PID)\n232\t\t\t} else {\n233\t\t\t\treturn runtimeFailureFields(out, stdout, f, sub, err)\n234\t\t\t}\n235\t\tdefault:\n236\t\t\tstate = sub\n237\t\t\tif sub == \"status\" {\n238\t\t\t\tstate = \"running\"\n239\t\t\t}\n240\t\t}\n241\t\tif sub == \"attach\" && (state == \"standalone\" || state == \"unsupported\") {\n242\t\t\tcode = 1\n243\t\t}\n244\t\tif f.jsonOut {\n245\t\t\tdoc := map[string]any{\"schema\": runtimeStatusSchema, \"state\": state, \"detail\": detail, \"supported\": worktreeruntime.Supported()}\n246\t\t\tif reply.Epoch != \"\" {\n247\t\t\t\tdoc[\"epoch\"], doc[\"pid\"], doc[\"started_at\"], doc[\"in_flight\"], doc[\"served\"] = reply.Epoch, reply.PID, reply.StartedAt, reply.InFlight, reply.Served\n248\t\t\t\tdoc[\"drained\"], doc[\"abandoned\"] = reply.Drained, reply.Abandoned\n249\t\t\t\tif len(reply.Metrics) > 0 {\n250\t\t\t\t\tdoc[\"metrics\"] = reply.Metrics\n251\t\t\t\t}\n252\t\t\t}\n253\t\t\tenc := json.NewEncoder(stdout)\n254\t\t\t_ = enc.Encode(doc)\n255\t\t\treturn code\n256\t\t}\n257\t\tout.Field(\"runtime.state\", state)\n258\t\tif detail != \"\" {\n259\t\t\tout.Field(\"runtime.detail\", detail)\n260\t\t}\n261\t\tif reply.Epoch != \"\" {\n262\t\t\tout.Field(\"runtime.epoch\", reply.Epoch)\n263\t\t\tout.Field(\"runtime.pid\", fmt.Sprint(reply.PID))\n264\t\t\tout.Field(\"runtime.started_at\", reply.StartedAt)\n265\t\t\tout.Field(\"runtime.in_flight\", fmt.Sprint(reply.InFlight))\n266\t\t\tnames := make([]string, 0, len(reply.Metrics))\n267\t\t\tfor name := range reply.Metrics {\n268\t\t\t\tnames = append(names, name)\n269\t\t\t}\n270\t\t\tsort.Strings(names)\n271\t\t\tfor _, name := range names {\n272\t\t\t\tout.Field(\"runtime.metrics.\"+name, fmt.Sprint(reply.Metrics[name]))\n273\t\t\t}\n274\t\t\tif state == \"stopped\" {\n275\t\t\t\tout.Field(\"runtime.drained\", fmt.Sprint(reply.Drained))\n276\t\t\t\tout.Field(\"runtime.abandoned\", fmt.Sprint(reply.Abandoned))\n277\t\t\t}\n278\t\t}\n279\t\treturn code\n280\t}\n281\t\n282\tfunc runtimeFailure(out interface {\n283\t\tField(string, string)\n284\t\tFailure(string)\n285\t}, stdout io.Writer, f runtimeFlags, sub string, err error) int {\n286\t\tif f.jsonOut {\n287\t\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeStatusSchema, \"state\": \"error\", \"detail\": err.Error(), \"supported\": worktreeruntime.Supported()})\n288\t\t\treturn 1\n289\t\t}\n290\t\tout.Failure(\"pose runtime \" + sub + \": \" + err.Error())\n291\t\treturn 1\n292\t}\n293\t\n294\tfunc runtimeFailureFields(out interface{ Field(string, string) }, stdout io.Writer, f runtimeFlags, sub string, err error) int {\n295\t\tif f.jsonOut {\n296\t\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeStatusSchema, \"state\": \"error\", \"detail\": strings.TrimSpace(err.Error()), \"supported\": worktreeruntime.Supported()})\n297\t\t\treturn 1\n298\t\t}\n299\t\tout.Field(\"runtime.error\", strings.TrimSpace(err.Error()))\n300\t\treturn 1\n301\t}\n302\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"a7fe5b88-31bc-4910-b4a8-a993bc140a8a","timestamp":"2026-11-10T09:50:18.613Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3334883877/worktree/pose-mcp/internal/cli/runtime_cmd.go","content":"package cli\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"os/signal\"\n\t\"runtime/debug\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"syscall\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n)\n\n// Spec pose-optional-worktree-runtime. The runtime is opt-in: nothing here starts it unless\n// asked, and every other command runs standalone whether it runs or not.\n\nconst runtimeStatusSchema = \"pose.runtime.status/1\"\n\n// runtimeSpawn starts the runtime of root detached; tests replace it.\nvar runtimeSpawn = func(root string, serveArgs []string) error {\n\tself, err := os.Executable()\n\tif err != nil {\n\t\treturn err\n\t}\n\tcmd := exec.Command(self, append([]string{\"runtime\", \"serve\"}, serveArgs...)...)\n\tcmd.Dir = root\n\tcmd.Env = os.Environ()\n\tcmd.Stdin, cmd.Stdout, cmd.Stderr = nil, nil, nil\n\tdetachProcess(cmd)\n\tif err := cmd.Start(); err != nil {\n\t\treturn err\n\t}\n\treturn cmd.Process.Release()\n}\n\nfunc runtimeBuild() string {\n\tif info, ok := debug.ReadBuildInfo(); ok {\n\t\tfor _, s := range info.Settings {\n\t\t\tif s.Key == \"vcs.revision\" && s.Value != \"\" {\n\t\t\t\treturn s.Value\n\t\t\t}\n\t\t}\n\t}\n\treturn \"unknown\"\n}\n\ntype runtimeFlags struct {\n\tjsonOut   bool\n\tidle      time.Duration\n\tdrain     time.Duration\n\tadmission runtimeAdmission\n}\n\n// serveArgs are the flags `start` hands the detached `serve`.\nfunc (f runtimeFlags) serveArgs() []string {\n\ta := f.admission\n\treturn []string{\"--idle\", f.idle.String(), \"--heavy-slots\", strconv.Itoa(a.HeavySlots), \"--short-slots\", strconv.Itoa(a.ShortSlots),\n\t\t\"--heavy-queue\", strconv.Itoa(a.HeavyQueue), \"--short-queue\", strconv.Itoa(a.ShortQueue), \"--memo-mib\", strconv.Itoa(a.MemoMiB)}\n}\n\nfunc parseRuntimeFlags(args []string) (runtimeFlags, string) {\n\tf := runtimeFlags{idle: 30 * time.Minute, drain: 5 * time.Second, admission: defaultRuntimeAdmission()}\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--json\":\n\t\t\tf.jsonOut = true\n\t\tcase \"--heavy-slots\", \"--short-slots\", \"--heavy-queue\", \"--short-queue\", \"--memo-mib\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn f, args[i] + \" needs a number\"\n\t\t\t}\n\t\t\tn, err := strconv.Atoi(args[i+1])\n\t\t\tminimum := 0\n\t\t\tif strings.HasSuffix(args[i], \"-slots\") || args[i] == \"--memo-mib\" {\n\t\t\t\tminimum = 1\n\t\t\t}\n\t\t\tif err != nil || n < minimum || n > 1<<20 {\n\t\t\t\treturn f, args[i] + \": \" + args[i+1] + \" is not a number from \" + strconv.Itoa(minimum) + \" to 1048576\"\n\t\t\t}\n\t\t\tswitch args[i] {\n\t\t\tcase \"--heavy-slots\":\n\t\t\t\tf.admission.HeavySlots = n\n\t\t\tcase \"--short-slots\":\n\t\t\t\tf.admission.ShortSlots = n\n\t\t\tcase \"--heavy-queue\":\n\t\t\t\tf.admission.HeavyQueue = n\n\t\t\tcase \"--short-queue\":\n\t\t\t\tf.admission.ShortQueue = n\n\t\t\tdefault:\n\t\t\t\tf.admission.MemoMiB = n\n\t\t\t}\n\t\t\ti++\n\t\tcase \"--idle\", \"--drain\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn f, args[i] + \" needs a duration\"\n\t\t\t}\n\t\t\td, err := time.ParseDuration(args[i+1])\n\t\t\tif err != nil || d < 0 || args[i] == \"--drain\" && d < time.Millisecond {\n\t\t\t\treturn f, args[i] + \": \" + args[i+1] + \" is not a duration\"\n\t\t\t}\n\t\t\tif args[i] == \"--idle\" {\n\t\t\t\tf.idle = d\n\t\t\t} else {\n\t\t\t\tf.drain = d\n\t\t\t}\n\t\t\ti++\n\t\tdefault:\n\t\t\treturn f, \"unknown argument \" + args[i]\n\t\t}\n\t}\n\treturn f, \"\"\n}\n\n// cmdRuntime is `pose runtime serve|start|attach|status|stop|restart`.\nfunc cmdRuntime(root string, args []string, stdout, stderr io.Writer) int {\n\tout := render(stdout, stderr)\n\tif len(args) == 0 {\n\t\tout.Usage(tr(\"usage: pose runtime <serve|start|attach|status|stop|restart|run> [--idle <d>] [--drain <d>] [--json]\", \"uso: pose runtime <serve|start|attach|status|stop|restart|run> [--idle <d>] [--drain <d>] [--json]\"))\n\t\treturn 2\n\t}\n\tsub := args[0]\n\tif sub == \"run\" {\n\t\treturn cmdRuntimeRun(root, args[1:], stdout, stderr)\n\t}\n\tf, problem := parseRuntimeFlags(args[1:])\n\tif problem != \"\" {\n\t\tout.Failure(\"pose runtime: \" + problem)\n\t\treturn 2\n\t}\n\tid, err := worktreeruntime.ResolveIdentity(root, version.Version, runtimeBuild())\n\tif err != nil {\n\t\tout.Failure(\"pose runtime: \" + err.Error())\n\t\treturn 2\n\t}\n\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n\tctx := context.Background()\n\tswitch sub {\n\tcase \"serve\":\n\t\tsigs := make(chan os.Signal, 1)\n\t\tsignal.Notify(sigs, os.Interrupt, syscall.SIGTERM)\n\t\tserveCtx, cancel := context.WithCancel(ctx)\n\t\tdefer cancel()\n\t\tgo func() { <-sigs; cancel() }()\n\t\t// A resident process keeps the pure Git reads it makes between hosted commands.\n\t\tposemodel.EnableResidentGitMemo(int64(f.admission.MemoMiB) << 20)\n\t\tdefer posemodel.DisableResidentGitMemo()\n\t\tvar busy atomic.Int64\n\t\tlanes := newHostedLanes(f.admission)\n\t\tif err := worktreeruntime.Serve(serveCtx, worktreeruntime.Options{Identity: id, Dir: client.Dir, Idle: f.idle, Busy: busy.Load, Metrics: lanes.metrics, Handler: runtimeHostedHandler(runtimeEnvDigest(os.Environ()), &busy, lanes)}); err != nil {\n\t\t\treturn runtimeFailure(out, stdout, f, \"serve\", err)\n\t\t}\n\t\treturn 0\n\tcase \"status\", \"attach\":\n\t\treply, err := client.Handshake(ctx)\n\t\treturn runtimeReport(out, stdout, f, sub, reply, err)\n\tcase \"stop\":\n\t\treply, err := client.Stop(ctx, f.drain)\n\t\tif errors.Is(err, worktreeruntime.ErrNoRuntime) || errors.Is(err, worktreeruntime.ErrUnsupported) {\n\t\t\treturn runtimeReport(out, stdout, f, sub, reply, err)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn runtimeFailure(out, stdout, f, sub, err)\n\t\t}\n\t\treturn runtimeReport(out, stdout, f, \"stopped\", reply, nil)\n\tcase \"start\", \"restart\":\n\t\tif sub == \"restart\" {\n\t\t\tstopped, err := client.Stop(ctx, f.drain)\n\t\t\tif err != nil && !errors.Is(err, worktreeruntime.ErrNoRuntime) {\n\t\t\t\treturn runtimeReport(out, stdout, f, sub, stopped, err)\n\t\t\t}\n\t\t\tif stopped.Abandoned > 0 {\n\t\t\t\t// The process is still ending what it abandoned and holds the endpoint: a new\n\t\t\t\t// one would be refused, so the restart says so instead of starting it.\n\t\t\t\treturn runtimeFailure(out, stdout, f, sub, fmt.Errorf(\"the runtime abandoned %d request(s) in flight and is still ending them (pid %d); start again when it has exited\", stopped.Abandoned, stopped.PID))\n\t\t\t}\n\t\t\twaitRuntimeGone(ctx, client)\n\t\t}\n\t\tif reply, err := client.Handshake(ctx); err == nil {\n\t\t\treturn runtimeReport(out, stdout, f, \"already-running\", reply, nil)\n\t\t} else if !errors.Is(err, worktreeruntime.ErrNoRuntime) {\n\t\t\treturn runtimeReport(out, stdout, f, sub, worktreeruntime.Reply{}, err)\n\t\t}\n\t\tif !worktreeruntime.Supported() {\n\t\t\treturn runtimeFailure(out, stdout, f, sub, worktreeruntime.ErrUnsupported)\n\t\t}\n\t\tif err := runtimeSpawn(root, f.serveArgs()); err != nil {\n\t\t\treturn runtimeFailure(out, stdout, f, sub, err)\n\t\t}\n\t\tvar reply worktreeruntime.Reply\n\t\tfor i := 0; i < 100; i++ {\n\t\t\tif reply, err = client.Handshake(ctx); err == nil {\n\t\t\t\treturn runtimeReport(out, stdout, f, \"started\", reply, nil)\n\t\t\t}\n\t\t\ttime.Sleep(50 * time.Millisecond)\n\t\t}\n\t\treturn runtimeFailure(out, stdout, f, sub, fmt.Errorf(\"the runtime did not answer after it was started: %w\", err))\n\t}\n\tout.Failure(\"pose runtime: \" + tr(\"unknown subcommand \", \"subcomando desconhecido \") + sub)\n\treturn 2\n}\n\n// waitRuntimeGone waits until the endpoint can be taken: nothing answers and the old process\n// has released its lock, which happens after the socket is gone.\nfunc waitRuntimeGone(ctx context.Context, client worktreeruntime.Client) {\n\tclient.WaitReleased(ctx, 10*time.Second)\n}\n\n// runtimeReport writes the state a subcommand ends in. Not running is a state, not a fault:\n// every command runs standalone then; only a runtime that refuses the attach, or an attach\n// that was asked for and cannot be had, is a failure.\nfunc runtimeReport(out interface{ Field(string, string) }, stdout io.Writer, f runtimeFlags, sub string, reply worktreeruntime.Reply, err error) int {\n\tstate, code, detail := \"running\", 0, \"\"\n\tswitch {\n\tcase errors.Is(err, worktreeruntime.ErrUnsupported):\n\t\tstate, detail = \"unsupported\", err.Error()\n\tcase errors.Is(err, worktreeruntime.ErrNoRuntime):\n\t\tstate, detail = \"standalone\", tr(\"no runtime is running for this worktree: commands run standalone\", \"nenhum runtime está rodando para este worktree: os comandos rodam standalone\")\n\tcase err != nil:\n\t\tvar inc *worktreeruntime.IncompatibleError\n\t\tif errors.As(err, &inc) {\n\t\t\tstate, code, detail = \"incompatible\", 1, err.Error()+tr(\"; stop it with `pose runtime stop` (this engine can, whatever its version) or end process \", \"; pare-o com `pose runtime stop` (este engine consegue, qualquer que seja a versão) ou encerre o processo \")+fmt.Sprint(reply.PID)\n\t\t} else {\n\t\t\treturn runtimeFailureFields(out, stdout, f, sub, err)\n\t\t}\n\tdefault:\n\t\tstate = sub\n\t\tif sub == \"status\" {\n\t\t\tstate = \"running\"\n\t\t}\n\t}\n\tif sub == \"attach\" && (state == \"standalone\" || state == \"unsupported\") {\n\t\tcode = 1\n\t}\n\tif f.jsonOut {\n\t\tdoc := map[string]any{\"schema\": runtimeStatusSchema, \"state\": state, \"detail\": detail, \"supported\": worktreeruntime.Supported()}\n\t\tif reply.Epoch != \"\" {\n\t\t\tdoc[\"epoch\"], doc[\"pid\"], doc[\"started_at\"], doc[\"in_flight\"], doc[\"served\"] = reply.Epoch, reply.PID, reply.StartedAt, reply.InFlight, reply.Served\n\t\t\tdoc[\"drained\"], doc[\"abandoned\"] = reply.Drained, reply.Abandoned\n\t\t\tif len(reply.Metrics) > 0 {\n\t\t\t\tdoc[\"metrics\"] = reply.Metrics\n\t\t\t}\n\t\t}\n\t\tenc := json.NewEncoder(stdout)\n\t\t_ = enc.Encode(doc)\n\t\treturn code\n\t}\n\tout.Field(\"runtime.state\", state)\n\tif detail != \"\" {\n\t\tout.Field(\"runtime.detail\", detail)\n\t}\n\tif reply.Epoch != \"\" {\n\t\tout.Field(\"runtime.epoch\", reply.Epoch)\n\t\tout.Field(\"runtime.pid\", fmt.Sprint(reply.PID))\n\t\tout.Field(\"runtime.started_at\", reply.StartedAt)\n\t\tout.Field(\"runtime.in_flight\", fmt.Sprint(reply.InFlight))\n\t\tnames := make([]string, 0, len(reply.Metrics))\n\t\tfor name := range reply.Metrics {\n\t\t\tnames = append(names, name)\n\t\t}\n\t\tsort.Strings(names)\n\t\tfor _, name := range names {\n\t\t\tout.Field(\"runtime.metrics.\"+name, fmt.Sprint(reply.Metrics[name]))\n\t\t}\n\t\tif state == \"stopped\" {\n\t\t\tout.Field(\"runtime.drained\", fmt.Sprint(reply.Drained))\n\t\t\tout.Field(\"runtime.abandoned\", fmt.Sprint(reply.Abandoned))\n\t\t}\n\t}\n\treturn code\n}\n\nfunc runtimeFailure(out interface {\n\tField(string, string)\n\tFailure(string)\n}, stdout io.Writer, f runtimeFlags, sub string, err error) int {\n\tif f.jsonOut {\n\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeStatusSchema, \"state\": \"error\", \"detail\": err.Error(), \"supported\": worktreeruntime.Supported()})\n\t\treturn 1\n\t}\n\tout.Failure(\"pose runtime \" + sub + \": \" + err.Error())\n\treturn 1\n}\n\nfunc runtimeFailureFields(out interface{ Field(string, string) }, stdout io.Writer, f runtimeFlags, sub string, err error) int {\n\tif f.jsonOut {\n\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeStatusSchema, \"state\": \"error\", \"detail\": strings.TrimSpace(err.Error()), \"supported\": worktreeruntime.Supported()})\n\t\treturn 1\n\t}\n\tout.Field(\"runtime.error\", strings.TrimSpace(err.Error()))\n\treturn 1\n}\n","numLines":302,"startLine":1,"totalLines":302}},"tool_result_meta":[{"id":"toolu_01H31fR6YwFCLtV6zERZajvJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
