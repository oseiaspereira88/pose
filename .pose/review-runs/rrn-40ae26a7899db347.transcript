{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc \"cat scripts/test-engine-go.sh | head -100; python3 - <<'PY'\nimport json\nm=json.load(open('.pose/indexes/validation-matrix.json'))\nfor c in m['moduleOverrides']['pose-mcp']['checks']:\n if c['program']\"'!='\"'go': print(c['name'],c['program'],c.get('args'))\nPY\nrg -n '\\\"material_clean\\\"|\\\"engine_version\\\"|\\\"outcome\\\"|\\\"carried\\\"' .pose/results/delivery-validation.json | head -10; rg -n 'unavailable' pose-mcp/internal/cli/validate_carry_test.go; sed -n '1,125p' pose-mcp/internal/cli/validate_carry_test.go\"","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd -P)\"\ncd \"$ROOT/pose-mcp\"\nexport LC_ALL=C\n\nmode=\"${1:-all}\"\nif [ \"$#\" -gt 1 ]; then\n  mode=invalid\nfi\ncase \"$mode\" in\n  all|other|pose-0|pose-1|inventory) ;;\n  *) printf '%s\\n' 'usage: test-engine-go.sh [all|other|pose-0|pose-1|inventory]' >&2; exit 2 ;;\nesac\n\nrun_other_packages() {\n  local heavy listed package\n  local -a other=()\n  heavy=\"$(go list ./internal/pose)\"\n  listed=\"$(go list ./...)\"\n  while IFS= read -r package; do\n    if [ \"$package\" != \"$heavy\" ]; then\n      other+=(\"$package\")\n    fi\n  done <<< \"$listed\"\n  if [ \"${#other[@]}\" -eq 0 ] || [ \"${#other[@]}\" -eq \"$(printf '%s\\n' \"$listed\" | wc -l)\" ]; then\n    printf '%s\\n' 'test-engine-go: the Go package inventory did not contain the expected package split' >&2\n    return 1\n  fi\n  go test -timeout 10m -count=1 \"${other[@]}\"\n}\n\nlist_names() {\n  go test -list \"$1\" ./internal/pose | sed -n -E '/^(Test|Fuzz|Example)[^[:space:]]*$/p' | sort\n}\n\nprepare_pose_shards() {\n  local all selected0 selected1 combined test_name\n  local i=0\n  local -a first=() second=()\n  all=\"$(list_names '^(Test|Fuzz|Example)')\"\n  while IFS= read -r test_name; do\n    if [ \"$((i % 2))\" -eq 0 ]; then\n      first+=(\"$test_name\")\n    else\n      second+=(\"$test_name\")\n    fi\n    i=$((i + 1))\n  done <<< \"$all\"\n  if [ -z \"$all\" ] || [ \"${#second[@]}\" -eq 0 ]; then\n    printf '%s\\n' 'test-engine-go: expected two nonempty Go test shards' >&2\n    return 1\n  fi\n  pose_pattern_0=\"^($(IFS='|'; printf '%s' \"${first[*]}\"))$\"\n  pose_pattern_1=\"^($(IFS='|'; printf '%s' \"${second[*]}\"))$\"\n  selected0=\"$(list_names \"$pose_pattern_0\")\"\n  selected1=\"$(list_names \"$pose_pattern_1\")\"\n  combined=\"$(printf '%s\\n%s\\n' \"$selected0\" \"$selected1\" | sort)\"\n  if [ \"$combined\" != \"$all\" ]; then\n    printf '%s\\n' 'test-engine-go: the Go-selected shards overlap or omit a test' >&2\n    return 1\n  fi\n  printf 'internal/pose inventory: %d + %d = %d tests, fuzz targets and examples\\n'     \"${#first[@]}\" \"${#second[@]}\" \"$i\"\n}\n\nif [ \"$mode\" = other ]; then\n  run_other_packages\n  exit 0\nfi\n\nprepare_pose_shards\ncase \"$mode\" in\n  all)\n    run_other_packages\n    go test -timeout 10m -count=1 -run \"$pose_pattern_0\" ./internal/pose\n    go test -timeout 10m -count=1 -run \"$pose_pattern_1\" ./internal/pose\n    ;;\n  pose-0) go test -timeout 10m -count=1 -run \"$pose_pattern_0\" ./internal/pose ;;\n  pose-1) go test -timeout 10m -count=1 -run \"$pose_pattern_1\" ./internal/pose ;;\n  inventory) ;;\nesac\ntest bash ['../scripts/test-engine-go.sh']\ntest-scripts-remove-their-temp-files-integration bash ['../tests/hygiene/temp-cleanup.sh']\ndemo-closes-a-delivery bash ['../examples/demo/record.sh', '--verify']\n972:  \"engine_version\": \"7.4.1-dev+5bc1baecb723e4c6be16fa39152a7aeac2e21e2f\",\n986:  \"material_clean\": true,\n989:  \"outcome\": \"pass\",\n1011:      \"outcome\": \"pass\",\n1026:      \"outcome\": \"pass\",\n1042:      \"outcome\": \"pass\",\n1061:      \"outcome\": \"pass\",\n1080:      \"outcome\": \"pass\",\n1100:      \"outcome\": \"pass\",\n1116:      \"outcome\": \"pass\",\n574:\t\t\tt.Fatalf(\"binding of %s = %s, want unavailable when HEAD moved\", spec, binding)\n1200:\t\tt.Fatalf(\"run = %+v, want a cancelled run unclean with unavailable bindings\", run)\npackage cli\n\n// Carried checks (spec pose-validate-carries-unchanged-checks): validate\n// --carry refreshes the canonical result by running only what a change can\n// affect and carrying the rest with the head it really ran at.\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"testing\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nconst carryResults = \".pose/results/delivery-validation.json\"\n\ntype carryFixture struct {\n\tt       *testing.T\n\troot    string\n\tcounter string\n}\n\n// newCarryFixture builds a committed repository with Go modules a and b and\n// a root file. Every check appends its module to a counter file outside the\n// tree, so a test can tell an executed check from a carried one.\nfunc newCarryFixture(t *testing.T, metadata string) *carryFixture {\n\tt.Helper()\n\tf := &carryFixture{t: t, root: t.TempDir(), counter: filepath.Join(t.TempDir(), \"runs\")}\n\tf.write(\"a/go.mod\", \"module a\\n\")\n\tf.write(\"b/go.mod\", \"module b\\n\")\n\tf.write(\"root.txt\", \"root\\n\")\n\tf.write(\".gitignore\", \".pose/transfers/.authority-transfer.lock\\n\")\n\tf.write(\".pose/policy/delivery.json\", `{\"schema_version\":1,\"enabled\":true,\"results_path\":\"`+carryResults+`\"}`)\n\tmatrix := `{\"defaults\":{\"mode\":\"strict\"},\"stacks\":{\"go\":{\"checks\":[` +\n\t\t`{\"name\":\"ok\",\"program\":\"sh\",\"args\":[\"-c\",\"basename \\\"$PWD\\\" >> ` + f.counter + `; test ! -f fail\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}}}`\n\tf.write(\".pose/indexes/validation-matrix.json\", matrix)\n\tif metadata != \"\" {\n\t\tf.write(\".pose/indexes/module-metadata.json\", metadata)\n\t}\n\tf.git(\"init\", \"-q\")\n\tf.commit(\"base\")\n\treturn f\n}\n\nfunc (f *carryFixture) write(rel, content string) {\n\tf.t.Helper()\n\tpath := filepath.Join(f.root, rel)\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\tf.t.Fatal(err)\n\t}\n}\n\nfunc (f *carryFixture) git(args ...string) string {\n\tf.t.Helper()\n\tcmd := exec.Command(\"git\", append([]string{\"-C\", f.root}, args...)...)\n\tcmd.Env = append(os.Environ(), \"GIT_AUTHOR_NAME=t\", \"GIT_AUTHOR_EMAIL=t@t\", \"GIT_COMMITTER_NAME=t\", \"GIT_COMMITTER_EMAIL=t@t\", \"GIT_CONFIG_GLOBAL=/dev/null\")\n\tout, err := cmd.CombinedOutput()\n\tif err != nil {\n\t\tf.t.Fatalf(\"git %v: %v %s\", args, err, out)\n\t}\n\treturn strings.TrimSpace(string(out))\n}\n\nfunc (f *carryFixture) commit(message string) string {\n\tf.t.Helper()\n\tf.git(\"add\", \"-A\")\n\tf.git(\"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-qm\", message, \"--allow-empty\")\n\treturn f.git(\"rev-parse\", \"HEAD\")\n}\n\n// validate runs pose validate and returns its exit code, output and the\n// canonical record it wrote. The counter is reset first.\nfunc (f *carryFixture) validate(args ...string) (int, string, validationRunResult) {\n\tf.t.Helper()\n\t_ = os.Remove(f.counter)\n\tcode, out := runValidate(f.t, f.root, append(args, \"--json-out\", carryResults)...)\n\tvar run validationRunResult\n\tif raw, err := os.ReadFile(filepath.Join(f.root, carryResults)); err == nil {\n\t\tif err := json.Unmarshal(raw, &run); err != nil {\n\t\t\tf.t.Fatal(err)\n\t\t}\n\t}\n\treturn code, out, run\n}\n\nfunc (f *carryFixture) ran() []string {\n\traw, err := os.ReadFile(f.counter)\n\tif err != nil {\n\t\treturn nil\n\t}\n\truns := strings.Fields(string(raw))\n\tsort.Strings(runs)\n\treturn runs\n}\n\nfunc checkOf(run validationRunResult, module string) checkResult {\n\tfor _, c := range run.Checks {\n\t\tif c.Module == module {\n\t\t\treturn c\n\t\t}\n\t}\n\treturn checkResult{}\n}\n\n// baseline runs the full matrix, commits the canonical record and returns the\n// head the record validated.\nfunc (f *carryFixture) baseline() string {\n\tf.t.Helper()\n\tvalidated := f.git(\"rev-parse\", \"HEAD\")\n\tcode, out, _ := f.validate()\n\tif code != 0 {\n\t\tf.t.Fatalf(\"baseline exit=%d %s\", code, out)\n\t}\n\tf.commit(\"record\")\n\treturn validated\n}\n","exit_code":0,"status":"completed"}}
