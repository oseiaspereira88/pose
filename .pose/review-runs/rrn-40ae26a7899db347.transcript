{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1030,1158p' pose-mcp/internal/cli/validate.go; sed -n '1190,1338p' pose-mcp/internal/cli/validate.go; sed -n '1190,1285p' pose-mcp/internal/cli/validate_carry_test.go; cat pose-mcp/internal/cli/validate_engine_identity_test.go; cat pose-mcp/internal/pose/delivery_validation_run_test.go; rg -n 'func .*Validation|runCtx|signal.' pose-mcp/internal/cli/validate.go\"","aggregated_output":"\t// contract.\n\tif stackFilter != \"\" && !map[string]bool{\"node\": true, \"go\": true, \"rust\": true, \"java\": true, \"python\": true, \"dotnet\": true, \"contract\": true}[stackFilter] {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid --stack: %s\\n\", \"Erro: --stack inválido: %s\\n\"), stackFilter)\n\t\treturn 2\n\t}\n\tif moduleFilter == \"..\" || strings.HasPrefix(moduleFilter, \"../\") || filepath.IsAbs(moduleFilter) {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --module must remain inside the project.\", \"Erro: --module deve permanecer dentro do projeto.\"))\n\t\treturn 2\n\t}\n\t// HEAD and its movement witness are pinned before any plan input is read:\n\t// the matrix and the module discovery then belong to this head, or the\n\t// end-of-run comparison sees the move (review round 13, N37).\n\tpinnedHead := \"\"\n\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n\t\tpinnedHead = strings.TrimSpace(string(head))\n\t}\n\tstartReflog := movementWitness(root, pinnedHead)\n\t// The working copy must match the pinned head before the plan inputs are\n\t// read, by the same full predicate checked at the end: status, hidden\n\t// index entries and submodule checkouts (review round 14, N40 and N41).\n\tstartedClean := pinnedHead != \"\" && validationMaterialClean(root, pinnedHead)\n\tmatrixPath := filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\")\n\traw, err := os.ReadFile(matrixPath)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: validation matrix not found at %s\\n\", \"Erro: matriz de validação não encontrada em %s\\n\"), matrixPath)\n\t\treturn 2\n\t}\n\tmatrix, err := parseValidationMatrix(raw)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid validation matrix: %v\\n\", \"Erro: matriz de validação inválida: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif err := validateStructuredMatrixPaths(matrix); err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid validation matrix path: %v\\n\", \"Erro: path inválido na matriz de validação: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif err := validateDeliveryMatrixContract(matrix); err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid delivery validation contract: %v\\n\", \"Erro: contrato de validação de delivery inválido: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif matrixHasLegacyChecks(matrix) {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: legacy shell 'command' checks are unsupported; migrate each check to program + args + env.\", \"Erro: checks shell legados em 'command' não são suportados; migre cada check para program + args + env.\"))\n\t\treturn 2\n\t}\n\tif mode == \"\" {\n\t\tmode = matrix.Defaults.Mode\n\t\tif mode == \"\" {\n\t\t\tmode = \"strict\"\n\t\t}\n\t}\n\tmodules, err := discoverValidationModules(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: discovering modules: %v\\n\", \"Erro: descobrir módulos: %v\\n\"), err)\n\t\treturn 1\n\t}\n\tif workspaceFilter != \"\" {\n\t\tresolved, ok := resolveWorkspaceModulePath(root, modules, workspaceFilter)\n\t\tif !ok {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: no module's manifest name matches --workspace %q.\\n\", \"Erro: nenhum module tem name de manifesto igual a --workspace %q.\\n\"), workspaceFilter)\n\t\t\treturn 2\n\t\t}\n\t\tmoduleFilter = resolved\n\t}\n\tknownModules := map[string]bool{}\n\tfor _, module := range modules {\n\t\tknownModules[module.Rel] = true\n\t}\n\tfor rel, override := range matrix.ModuleOverrides {\n\t\tclean := filepath.ToSlash(filepath.Clean(rel))\n\t\tif clean == \"..\" || strings.HasPrefix(clean, \"../\") || filepath.IsAbs(rel) {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: moduleOverrides contains a path outside the project: %s\\n\", \"Erro: moduleOverrides contém path fora do projeto: %s\\n\"), rel)\n\t\t\treturn 2\n\t\t}\n\t\tif knownModules[clean] {\n\t\t\tif override.Stack != \"\" {\n\t\t\t\tfor idx := range modules {\n\t\t\t\t\tif modules[idx].Rel == clean {\n\t\t\t\t\t\tmodules[idx].Stack = override.Stack\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tabs := filepath.Join(root, filepath.FromSlash(clean))\n\t\tif info, err := os.Stat(abs); err == nil && info.IsDir() {\n\t\t\tstack := override.Stack\n\t\t\tif stack == \"\" {\n\t\t\t\tstack = \"contract\"\n\t\t\t}\n\t\t\tmodules = append(modules, validationModule{Rel: clean, Abs: abs, Stack: stack})\n\t\t\tknownModules[clean] = true\n\t\t}\n\t}\n\tsort.Slice(modules, func(i, j int) bool { return modules[i].Rel < modules[j].Rel })\n\tvar scope *scopeSelection\n\tif changedTo != \"\" && changedFrom == \"\" {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --changed-to requires --changed-from.\", \"Erro: --changed-to exige --changed-from.\"))\n\t\treturn 2\n\t}\n\tif changedFrom != \"\" {\n\t\tsel, err := computeChangedScope(root, changedFrom, changedTo, modules)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: changed-scope selection: %v\\n\", \"Erro: seleção por escopo alterado: %v\\n\"), err)\n\t\t\treturn 2\n\t\t}\n\t\tscope = &sel\n\t\tif explain {\n\t\t\tfmt.Fprintf(stdout, \"[changed-scope] %s: %d changed file(s), %d/%d module(s) selected\\n\", sel.rangeLabel(), len(sel.Changed), len(sel.Selected), len(modules))\n\t\t\tfor _, m := range modules {\n\t\t\t\tif reason, ok := sel.Selected[m.Rel]; ok {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  + %s: %s\\n\", m.Rel, reason)\n\t\t\t\t} else {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  - %s: not affected by %s\\n\", m.Rel, sel.rangeLabel())\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\trun := validationRunResult{\n\t\tSchemaVersion: validationResultSchema,\n\t\tGeneratedAt:   time.Now().UTC().Format(time.RFC3339),\n\t\tMode:          mode,\n\t\tStackFilter:   stackFilter,\n\t\tModuleFilter:  moduleFilter,\n\t\tChecks:        []checkResult{},\n\t}\n\tmatrixDigest := sha256.Sum256(raw)\n\trun.MatrixSHA256 = \"sha256:\" + hex.EncodeToString(matrixDigest[:])\n\trun.EngineVersion = validationEngineIdentity()\n\t// The head is pinned before anything is planned: selection, carried\n\t\t}\n\t\t// The binding names the committed tree. Checks run on the working copy, so a\n\t\t// working copy that differs from it in any material path validated something\n\t\t// else: the run then records the binding as unavailable.\n\t\tclean := materialWorktreeClean(root)\n\t\tfor spec := range seenSpecs {\n\t\t\trun.ScopeProvenance[spec] = posemodel.ScopedDeliveryProvenanceDigest(graph, spec)\n\t\t\tif !clean {\n\t\t\t\tif run.MaterialProvenance == nil {\n\t\t\t\t\trun.MaterialProvenance = map[string]string{}\n\t\t\t\t}\n\t\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n\t\t\t} else if material, ok := posemodel.MaterialBinding(graph, spec); ok {\n\t\t\t\tif run.MaterialProvenance == nil {\n\t\t\t\t\trun.MaterialProvenance = map[string]string{}\n\t\t\t\t}\n\t\t\t\trun.MaterialProvenance[spec] = material\n\t\t\t}\n\t\t}\n\t}\n\tfailures := 0\n\toptionalFailures := 0\n\texecuted := 0\n\tr := render(stdout, stderr)\n\tr.SetVerbose(verbose)\n\t// The counter needs the whole plan up front, so the checks a module runs are\n\t// resolved by one helper called twice: counting here, executing below. A\n\t// second copy of the filter logic would drift from this one.\n\tplanned := 0\n\tfor _, module := range modules {\n\t\t_, checks, selected := moduleValidationChecks(module, matrix, stackFilter, moduleFilter)\n\t\tif !selected {\n\t\t\tcontinue\n\t\t}\n\t\tif scope != nil {\n\t\t\tif _, inScope := scope.Selected[module.Rel]; !inScope {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif carryState.carried(module.Rel) {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, check := range checks {\n\t\t\tif check.Program != \"\" {\n\t\t\t\tplanned++\n\t\t\t}\n\t\t}\n\t}\n\tsteps := r.Steps(planned)\n\tvar entries []*validationEntry\n\tfor _, module := range modules {\n\t\toverride := matrix.ModuleOverrides[module.Rel]\n\t\tstack := module.Stack\n\t\tif override.Stack != \"\" {\n\t\t\tstack = override.Stack\n\t\t}\n\t\tif stackFilter != \"\" && stack != stackFilter || moduleFilter != \"\" && module.Rel != moduleFilter {\n\t\t\tcontinue\n\t\t}\n\t\tchecks := append([]validationCheck(nil), matrix.Stacks[stack].Checks...)\n\t\tif override.ReplaceDefaultChecks {\n\t\t\tchecks = nil\n\t\t}\n\t\tchecks = append(checks, override.Checks...)\n\t\tif scope != nil {\n\t\t\tif _, selected := scope.Selected[module.Rel]; !selected {\n\t\t\t\t// R3: every unselected check keeps a machine-readable reason.\n\t\t\t\treason := \"changed-scope: module not affected by \" + scope.rangeLabel()\n\t\t\t\tfor _, check := range checks {\n\t\t\t\t\tif check.Program == \"\" {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tseverity := check.Severity\n\t\t\t\t\tif severity == \"\" {\n\t\t\t\t\t\tseverity = \"required\"\n\t\t\t\t\t}\n\t\t\t\t\tentries = append(entries, &validationEntry{check: check, severity: severity, skip: reason, silent: true, result: checkResult{\n\t\t\t\t\t\tID: module.Rel + \"/\" + stack + \"/\" + check.Name, Module: module.Rel,\n\t\t\t\t\t\tStack: stack, Name: check.Name, Program: check.Program,\n\t\t\t\t\t\tArgs: check.Args, Env: redactedEnv(check.Env), Severity: severity, EvidenceClass: check.EvidenceClass,\n\t\t\t\t\t}})\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif carryState.carried(module.Rel) {\n\t\t\tfor _, check := range checks {\n\t\t\t\tif check.Program == \"\" {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n\t\t\t\tentries = append(entries, &validationEntry{check: check, silent: true, carried: true, result: carryState.carriedResult(id)})\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tmoduleMode := mode\n\t\tif override.Mode != \"\" {\n\t\t\tmoduleMode = override.Mode\n\t\t}\n\t\tentries = append(entries, &validationEntry{note: fmt.Sprintf(\"[module] %s (%s, mode=%s)\", module.Rel, stack, moduleMode)})\n\t\tfor _, check := range checks {\n\t\t\tif check.Program == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseverity := check.Severity\n\t\t\tif severity == \"\" {\n\t\t\t\tseverity = \"required\"\n\t\t\t}\n\t\t\tentry := &validationEntry{check: check, moduleDir: module.Abs, severity: severity, done: make(chan struct{}), result: checkResult{\n\t\t\t\tID: module.Rel + \"/\" + stack + \"/\" + check.Name, Module: module.Rel,\n\t\t\t\tStack: stack, Name: check.Name, Program: check.Program,\n\t\t\t\tArgs: check.Args, Env: redactedEnv(check.Env), Severity: severity, EvidenceClass: check.EvidenceClass,\n\t\t\t}}\n\t\t\tif check.Isolation == \"required\" {\n\t\t\t\t// The local CLI never weakens its boundary: isolated\n\t\t\t\t// execution is delegated to the Harness via --emit-plan.\n\t\t\t\tentry.skip = \"requires isolated execution (harness) — include via --emit-plan\"\n\t\t\t\tentry.isolated = true\n\t\t\t}\n\t\t\tentries = append(entries, entry)\n\t\t}\n\t}\n\t// Checks run up to jobs at a time; results are shown and counted here,\n\t// in matrix order, whatever order they finish in (spec\n\t// pose-validate-concurrent-steps R1). --verbose streams a check's output,\n\t// so it runs them one at a time.\n\tif jobs == 0 {\n\t\tjobs = defaultValidationJobs(effectiveValidationResources(os.ReadFile, runtime.NumCPU()))\n\t}\n\tif verbose {\n\t\tjobs = 1\n\t}\n\trun.Jobs = jobs\n\trunCtx, stopSignals := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stopSignals()\n\t// The first signal cancels the run; a second one acts as it always did,\n\t// even while the run shuts down (review round 1, B4).\n\tgo func() {\n\t\t<-runCtx.Done()\n\t\tstopSignals()\n\t}()\n\twallStart := time.Now()\n\tif jobs > 1 {\n\t\tgo dispatchValidationEntries(runCtx, entries, jobs, matrix)\n\t}\n\tfor _, entry := range entries {\n\t\tif entry.note != \"\" {\n\t\t\tsteps.Note(entry.note)\n\t\t\tcontinue\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"module metadata differs\") {\n\t\tt.Fatalf(\"carry = %+v, want uncommitted metadata refused\", run.Carry)\n\t}\n}\n\n// A cancelled run binds no material (review round 16, N47).\nfunc TestCancellationMakesBindingsUnavailable(t *testing.T) {\n\trun := validationRunResult{MaterialClean: true, MaterialProvenance: map[string]string{\"s\": \"sha256:abc\"}}\n\tif !finalizeCancellation(&run) || run.MaterialClean || run.MaterialProvenance[\"s\"] != posemodel.MaterialBindingUnavailable {\n\t\tt.Fatalf(\"run = %+v, want a cancelled run unclean with unavailable bindings\", run)\n\t}\n}\n\n// A submodule with nested submodules makes the run unclean (review round 16,\n// N48).\nfunc TestValidateNestedSubmodulesAreNotClean(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tsub := filepath.Join(f.root, \"b\", \"sub\")\n\tif err := os.MkdirAll(sub, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit := func(dir string, args ...string) string {\n\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\t\tcmd.Env = append(os.Environ(), \"GIT_AUTHOR_NAME=t\", \"GIT_AUTHOR_EMAIL=t@t\", \"GIT_COMMITTER_NAME=t\", \"GIT_COMMITTER_EMAIL=t@t\", \"GIT_CONFIG_GLOBAL=/dev/null\")\n\t\tout, err := cmd.CombinedOutput()\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t\treturn strings.TrimSpace(string(out))\n\t}\n\tgit(sub, \"init\", \"-q\")\n\tgit(sub, \"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-q\", \"--allow-empty\", \"-m\", \"one\")\n\tinner := git(sub, \"rev-parse\", \"HEAD\")\n\tgit(sub, \"update-index\", \"--add\", \"--cacheinfo\", \"160000,\"+inner+\",nested\")\n\tgit(sub, \"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-q\", \"-m\", \"nested gitlink\")\n\tif err := os.MkdirAll(filepath.Join(sub, \"nested\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.commit(\"submodule with a nested submodule\")\n\thead := f.git(\"rev-parse\", \"HEAD\")\n\tif !materialWorktreeClean(f.root) || submodulesCheckedOut(f.root, head) != \"\" {\n\t\tt.Fatal(\"the fixture must pass every other condition for this test to mean anything\")\n\t}\n\tif validationMaterialClean(f.root, head) {\n\t\tt.Fatal(\"a submodule with nested submodules must not read as clean material\")\n\t}\n}\n\n// The carry selects with one metadata snapshot read from the pinned commit,\n// never rereading the working copy (review round 17, N50).\nfunc TestCarrySelectsWithThePinnedMetadataSnapshot(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"a\"]}}}`)\n\thead := f.git(\"rev-parse\", \"HEAD\")\n\tf.write(\".pose/indexes/module-metadata.json\", `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true}}}`)\n\tmeta, err := scopeMetadataAt(f.root, head)\n\tif err != nil || len(meta.Modules[\"b\"].DependsOn) != 1 {\n\t\tt.Fatalf(\"metadata at %s = %+v (%v), want the committed dependency\", head, meta, err)\n\t}\n\tmodules, err := discoverValidationModules(f.root)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tsel, err := computeChangedScopeWith(f.root, \"HEAD\", \"\", modules, meta)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, ok := sel.Selected[\"b\"]; !ok {\n\t\tt.Fatalf(\"selected = %v, want b selected through the snapshot's dependency despite the edited working metadata\", sel.Selected)\n\t}\n}\n\n// A committed metadata blob that cannot be read is an error, never an empty\n// policy (review round 18, N52).\nfunc TestCarryRefusesAnUnreadableMetadataBlob(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"a\"]}}}`)\n\thead := f.git(\"rev-parse\", \"HEAD\")\n\tblob := strings.Fields(f.git(\"ls-tree\", head, \"--\", \".pose/indexes/module-metadata.json\"))[2]\n\tobject := filepath.Join(f.root, \".git\", \"objects\", blob[:2], blob[2:])\n\tif err := os.Remove(object); err != nil {\n\t\tt.Fatalf(\"the fixture keeps the blob loose: %v\", err)\n\t}\n\tif _, err := scopeMetadataAt(f.root, head); err == nil {\n\t\tt.Fatal(\"an unreadable metadata blob must be an error\")\n\t}\n\tif err := os.Remove(filepath.Join(f.root, \".pose/indexes/module-metadata.json\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif differs, err := workingFileDiffersFromHead(f.root, head, \".pose/indexes/module-metadata.json\"); err == nil && !differs {\n\t\tt.Fatal(\"an absent working file over an unreadable committed blob must not read as equal\")\n\t}\n}\npackage cli\n\nimport (\n\t\"runtime/debug\"\n\t\"testing\"\n\n\t\"github.com/harne8/pose-mcp/internal/version\"\n)\n\n// A modified build is not a comparable engine identity (spec\n// pose-validate-carries-unchanged-checks, review round 2, N4).\nfunc TestEngineIdentityRefusesModifiedBuilds(t *testing.T) {\n\tinfo := func(settings ...debug.BuildSetting) *debug.BuildInfo { return &debug.BuildInfo{Settings: settings} }\n\tcases := []struct {\n\t\tname       string\n\t\tinfo       *debug.BuildInfo\n\t\twant       string\n\t\tverifiable bool\n\t}{\n\t\t{\"clean\", info(debug.BuildSetting{Key: \"vcs.revision\", Value: \"abc\"}, debug.BuildSetting{Key: \"vcs.modified\", Value: \"false\"}), version.Version + \"+abc\", true},\n\t\t{\"modified\", info(debug.BuildSetting{Key: \"vcs.revision\", Value: \"abc\"}, debug.BuildSetting{Key: \"vcs.modified\", Value: \"true\"}), version.Version + \"+abc.dirty\", false},\n\t\t{\"unstamped\", info(), version.Version, true},\n\t}\n\tfor _, tc := range cases {\n\t\tgot, verifiable := engineIdentityFrom(tc.info, true)\n\t\tif got != tc.want || verifiable != tc.verifiable {\n\t\t\tt.Fatalf(\"%s: identity %q verifiable %v, want %q %v\", tc.name, got, verifiable, tc.want, tc.verifiable)\n\t\t}\n\t}\n}\npackage pose\n\nimport \"testing\"\n\n// A carried check is read as an observation of the head it ran at (spec\n// pose-validate-carries-unchanged-checks R7); an executed one keeps the run's.\nfunc TestDeliveryValidationRunReadsTheCarriedHead(t *testing.T) {\n\traw := []byte(`{\"schema_version\":1,\"generated_at\":\"2026-11-22T10:00:00Z\",\"git_head\":\"bbbb\",\"checks\":[` +\n\t\t`{\"id\":\"a/go/ok\",\"module\":\"a\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\"},` +\n\t\t`{\"id\":\"b/go/ok\",\"module\":\"b\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\",\"carried_from\":\"aaaa\",\"carried_generated_at\":\"2026-11-21T09:00:00Z\"}]}`)\n\tresults, err := ParseDeliveryValidationRun(raw, \".pose/results/delivery-validation.json\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(results) != 2 {\n\t\tt.Fatalf(\"results = %+v\", results)\n\t}\n\tfor _, r := range results {\n\t\tswitch r.ID {\n\t\tcase \"a/go/ok\":\n\t\t\tif r.GitHead != \"bbbb\" || r.GeneratedAt != \"2026-11-22T10:00:00Z\" {\n\t\t\t\tt.Fatalf(\"executed check read as %s at %s\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\tcase \"b/go/ok\":\n\t\t\tif r.GitHead != \"aaaa\" || r.GeneratedAt != \"2026-11-21T09:00:00Z\" {\n\t\t\t\tt.Fatalf(\"carried check read as %s at %s, want the head it ran at\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\t}\n\t}\n}\n15:\t\"os/signal\"\n325:func dispatchValidationEntries(ctx context.Context, entries []*validationEntry, jobs int, matrix validationMatrix) {\n399:func defaultValidationJobs(available validationResources) int {\n479:func effectiveValidationResources(read func(string) ([]byte, error), cores int) validationResources {\n633:func parseValidationMatrix(raw []byte) (validationMatrix, error) {\n667:func discoverValidationModulesIn(files posemodel.Files, root string) ([]validationModule, error) {\n734:func discoverValidationModules(root string) ([]validationModule, error) {\n1323:\trunCtx, stopSignals := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n1325:\t// The first signal cancels the run; a second one acts as it always did,\n1328:\t\t<-runCtx.Done()\n1333:\t\tgo dispatchValidationEntries(runCtx, entries, jobs, matrix)\n1371:\t\t\t} else if runCtx.Err() != nil {\n1396:\t\t\tentry.execute(runCtx, matrix, verbose, stdout, stderr, steps.Release)\n1461:\t// A signal cancels the run even when no executed check saw it, as in an\n1463:\tcancelled := runCtx.Err() != nil\n1593:func moduleValidationChecks(module validationModule, matrix validationMatrix, stackFilter, moduleFilter string) (string, []validationCheck, bool) {\n","exit_code":0,"status":"completed"}}
