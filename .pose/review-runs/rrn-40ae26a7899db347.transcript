{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc \"git status --short; sed -n '787,900p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '325,385p' pose-mcp/internal/cli/validate.go; cat pose-mcp/internal/pose/delivery_validation_run.go\"","aggregated_output":"func cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar spec, from, to string\n\tstrict, jsonOutput := true, false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--spec\", \"--from\", \"--to\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t\t}\n\t\t\ti++\n\t\t\tswitch args[i-1] {\n\t\t\tcase \"--spec\":\n\t\t\t\tspec = args[i]\n\t\t\tcase \"--from\":\n\t\t\t\tfrom = args[i]\n\t\t\tcase \"--to\":\n\t\t\t\tto = args[i]\n\t\t\t}\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t}\n\t}\n\tstore := posemodel.Store{Root: root}\n\tfull, err := store.GetSpec(spec)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tpolicy, err := posemodel.LoadArtifactPolicy(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tclaims, found, err := posemodel.ParseArtifactClaims(*full, policy)\n\tif err != nil || !found || len(claims) == 0 {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: spec %s has no valid artifact declaration: %v\\n\", spec, err)\n\t\treturn 1\n\t}\n\tvar sets []posemodel.ChangeSet\n\tif from != \"\" || to != \"\" {\n\t\tset, err := resolveGitChangeSet(root, spec, from, to)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tsets = append(sets, set)\n\t} else {\n\t\tfor _, recorded := range loadRecordedChangeSets(root) {\n\t\t\tif recorded.Spec == spec {\n\t\t\t\tsets = append(sets, recorded)\n\t\t\t}\n\t\t}\n\t\tif set, err := resolveGitChangeSet(root, spec, \"\", \"\"); err == nil {\n\t\t\talreadyPresent := false\n\t\t\tfor _, existing := range sets {\n\t\t\t\tif existing.ID == set.ID {\n\t\t\t\t\talreadyPresent = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !alreadyPresent {\n\t\t\t\tsets = append(sets, set)\n\t\t\t}\n\t\t}\n\t\tif len(sets) == 0 {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: no commits carry POSE-Spec: %s\\n\", spec)\n\t\t\treturn 1\n\t\t}\n\t}\n\tset := sets[0]\n\ttracked, err := gitTrackedPaths(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\t// A later removal by another spec is read from every spec's claims and\n\t// change sets (spec pose-delivery-later-removal R4).\n\tvar removals []posemodel.ArtifactRemoval\n\tspecs := []posemodel.Spec{*full}\n\tif allSpecs, allClaims, allSets, _, _, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root); err == nil {\n\t\tspecs = allSpecs\n\t\tremovals = artifactRemovals(root, allClaims, allSets, tracked, gaps, sets...)\n\t}\n\tgraph := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), []posemodel.Spec{*full}, claims, sets, tracked, policy, posemodel.LoadArchivedFragments(root), removals)\n\tif err := applyArtifactAttributions(posemodel.NativeFiles(), root, specs, &graph); err != nil {\n\t\trender(stdout, stderr).Failure(\"pose artifact-check: \" + err.Error())\n\t\treturn 1\n\t}\n\tfor _, claim := range claims {\n\t\tif claim.Action == \"none\" {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{claim.Path}\n\t\tif claim.Action == \"renamed\" {\n\t\t\tpaths = []string{claim.OldPath, claim.NewPath}\n\t\t}\n\t\tfor _, path := range paths {\n\t\t\tif err := posemodel.ValidateArtifactPath(root, path, false); err != nil {\n\t\t\t\tseverity := policy.Severities[\"resolvability\"]\n\t\t\t\tif severity == \"\" {\n\t\t\t\t\tseverity = \"warning\"\n\t\t\t\t}\n\t\t\t\tgraph.Findings = append(graph.Findings, posemodel.NewDeliveryIntegrityFinding(\"resolvability\", severity, spec, path, set.ID, err.Error(), \"declare an exact confined tracked file path\"))\n\t\t\t}\n\t\t}\n\t}\n\tsort.Slice(graph.Findings, func(i, j int) bool { return graph.Findings[i].ID < graph.Findings[j].ID })\n\tif jsonOutput {\nfunc dispatchValidationEntries(ctx context.Context, entries []*validationEntry, jobs int, matrix validationMatrix) {\n\tslots := make(chan struct{}, jobs)\n\tvar running sync.WaitGroup\n\tcancelled := func(entry *validationEntry) bool {\n\t\tif ctx.Err() == nil {\n\t\t\treturn false\n\t\t}\n\t\tentry.markCancelled()\n\t\tclose(entry.done)\n\t\treturn true\n\t}\n\tfor _, entry := range entries {\n\t\tif entry.note != \"\" || entry.silent || entry.isolated {\n\t\t\tcontinue\n\t\t}\n\t\tif entry.check.Exclusive {\n\t\t\trunning.Wait()\n\t\t\tif cancelled(entry) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif entry.resolveWhen(); entry.skip == \"\" {\n\t\t\t\tentry.execute(ctx, matrix, false, nil, nil, nil)\n\t\t\t}\n\t\t\tclose(entry.done)\n\t\t\tcontinue\n\t\t}\n\t\tselect {\n\t\tcase slots <- struct{}{}:\n\t\tcase <-ctx.Done():\n\t\t\tcancelled(entry)\n\t\t\tcontinue\n\t\t}\n\t\tif cancelled(entry) {\n\t\t\t<-slots\n\t\t\tcontinue\n\t\t}\n\t\trunning.Add(1)\n\t\tgo func(entry *validationEntry) {\n\t\t\tdefer running.Done()\n\t\t\tdefer func() { <-slots }()\n\t\t\tif entry.resolveWhen(); entry.skip == \"\" {\n\t\t\t\tentry.execute(ctx, matrix, false, nil, nil, nil)\n\t\t\t}\n\t\t\tclose(entry.done)\n\t\t}(entry)\n\t}\n}\n\n// validationResources is what a run may use. memoryKnown separates an empty\n// reading from none; unresolved says a cgroup applies whose limits could not\n// be located.\ntype validationResources struct {\n\tcpus        float64\n\tmemory      uint64\n\tmemoryKnown bool\n\tunresolved  bool\n}\n\nfunc (r *validationResources) limitMemory(available uint64) {\n\tif !r.memoryKnown || available < r.memory {\n\t\tr.memory, r.memoryKnown = available, true\npackage pose\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"sort\"\n)\n\n// DeliveryValidationResultSchema is the schema of the structured result of `pose validate`.\nconst DeliveryValidationResultSchema = 1\n\n// ParseDeliveryValidationRun reads the structured result of a validation run into the results\n// the delivery index holds: one per check that declares an evidence class, with the run's head,\n// time, provenance and scope provenance. relative is the path the results were read from. It is\n// the one reading of that file: the index is built with it and checked against it.\nfunc ParseDeliveryValidationRun(raw []byte, relative string) ([]DeliveryValidationResult, error) {\n\tvar run struct {\n\t\tSchemaVersion      int               `json:\"schema_version\"`\n\t\tGeneratedAt        string            `json:\"generated_at\"`\n\t\tGitHead            string            `json:\"git_head,omitempty\"`\n\t\tProvenanceDigest   string            `json:\"provenance_digest,omitempty\"`\n\t\tScopeProvenance    map[string]string `json:\"scope_provenance,omitempty\"`\n\t\tMaterialProvenance map[string]string `json:\"material_provenance,omitempty\"`\n\t\tChecks             []struct {\n\t\t\tID            string `json:\"id\"`\n\t\t\tModule        string `json:\"module\"`\n\t\t\tName          string `json:\"name\"`\n\t\t\tSeverity      string `json:\"severity\"`\n\t\t\tEvidenceClass string `json:\"evidence_class,omitempty\"`\n\t\t\tOutcome       string `json:\"outcome\"`\n\t\t\t// A carried check ran at its own head (spec\n\t\t\t// pose-validate-carries-unchanged-checks R7).\n\t\t\tCarriedFrom        string `json:\"carried_from,omitempty\"`\n\t\t\tCarriedGeneratedAt string `json:\"carried_generated_at,omitempty\"`\n\t\t} `json:\"checks\"`\n\t}\n\tif err := json.Unmarshal(raw, &run); err != nil || run.SchemaVersion != DeliveryValidationResultSchema {\n\t\treturn nil, fmt.Errorf(\"invalid structured validation result\")\n\t}\n\tresults := make([]DeliveryValidationResult, 0, len(run.Checks))\n\tfor _, check := range run.Checks {\n\t\tif check.EvidenceClass == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\thead, generated := run.GitHead, run.GeneratedAt\n\t\tif check.CarriedFrom != \"\" {\n\t\t\thead, generated = check.CarriedFrom, check.CarriedGeneratedAt\n\t\t}\n\t\tresults = append(results, DeliveryValidationResult{ID: check.ID, Module: check.Module, Check: check.Name, EvidenceClass: check.EvidenceClass, Severity: check.Severity, Outcome: check.Outcome, GitHead: head, GeneratedAt: generated, ProvenanceDigest: run.ProvenanceDigest, ScopeProvenance: run.ScopeProvenance, MaterialProvenance: run.MaterialProvenance, Report: relative})\n\t}\n\tsort.Slice(results, func(i, j int) bool { return results[i].ID < results[j].ID })\n\treturn results, nil\n}\n","exit_code":0,"status":"completed"}}
