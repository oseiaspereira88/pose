{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/specs/pose-federated-source-proof-is-computed-once-per-operation.md; git diff 1d235badaf52611ae609146c26a7fb212ae3a2e8 24c7ad9ab4e86457dad72b2ca6372e2b2ef64be0 -- pose-mcp/internal/pose/federated_acceptance.go pose-mcp/internal/pose/federated_source_proof_memo_test.go .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md .pose/indexes/validation-matrix.json; rg --files -g AGENTS.md'","aggregated_output":"cat: .pose/specs/pose-federated-source-proof-is-computed-once-per-operation.md: No such file or directory\ndiff --git a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\nindex 20ed7079..874c6f7a 100644\n--- a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n+++ b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n@@ -361,3 +361,14 @@ wall time from about 197 s to 136 s. The rest is Git: 1,116\n filters takes each from 47 ms to 2 ms and the first call to 59 s; it is\n repository maintenance, not part of this decision.\n \n+## A federated dependency is proved once per operation (D15) — 2026-11-17\n+\n+Spec `pose-federated-source-proof-is-computed-once-per-operation`. After D14\n+the first closeout call on harne8 still spent about 37 s of CPU in\n+`federatedSourceProof`: 64 proofs in one call, 39 of them distinct, because\n+several roadmaps consume the same pose-dist dependency. The proof reads\n+through the operation's view, so within the operation it is a function of\n+those reads; it is now kept per source root, identity and pinned revision,\n+for each producer, by the same per-operation memo as the review ledger, and\n+callers receive deep copies. The first call fell from about 80 s to 60 s.\n+\ndiff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex d6c44230..1b7281c0 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2419,6 +2419,13 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"federated-source-proof-is-computed-once-per-operation-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestFederatedSourceProofIsComputedOncePerOperation\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"read-view-audit-repeats-a-read-under-its-own-time-integration\",\n           \"program\": \"go\",\ndiff --git a/pose-mcp/internal/pose/federated_acceptance.go b/pose-mcp/internal/pose/federated_acceptance.go\nindex c4171cfc..6ff8be7d 100644\n--- a/pose-mcp/internal/pose/federated_acceptance.go\n+++ b/pose-mcp/internal/pose/federated_acceptance.go\n@@ -703,7 +703,36 @@ func federatedGitlinkMatches(parent, child Store, revision string) bool {\n \treturn federatedGitlinkMatchesIn(NativeFiles(), parent, child, revision)\n }\n \n+// federatedSourceProofResult is what federatedSourceProof answers.\n+type federatedSourceProofResult struct {\n+\tBundleID, BundleDigest, SubjectDigest, PlanDigest string\n+\tContracts                                         []string\n+\tEvidence                                          []FederatedDependencyEvidence\n+\tBlockers                                          []string\n+}\n+\n+// federatedSourceProof proves one federated dependency from its source's\n+// review. A closeout asks it for the same dependency from several roadmaps\n+// (64 proofs, 39 distinct, in one harne8 closeout); within one read-view\n+// operation the answer is a function of that operation's reads, so it is\n+// computed once per operation and producer, like the review ledger (spec\n+// pose-federated-source-proof-is-computed-once-per-operation).\n func federatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\n+\tkey := \"federated-source-proof\\x00\" + filepath.Clean(source.Root) + \"\\x00\" + identity.Project + \"\\x00\" + identity.Kind + \"\\x00\" + identity.Slug + \"\\x00\" + pinnedRevision\n+\tresult, _, err := memoizedLedgerRead(files, key, func() (federatedSourceProofResult, error) {\n+\t\tbundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, blockers := computeFederatedSourceProof(files, source, identity, pinnedRevision)\n+\t\treturn federatedSourceProofResult{bundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, blockers}, nil\n+\t})\n+\tif err != nil {\n+\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{localFederatedScope(identity) + \":source-proof-unavailable\"}\n+\t}\n+\tresult = deepCopyValue(result)\n+\treturn result.BundleID, result.BundleDigest, result.SubjectDigest, result.PlanDigest, result.Contracts, result.Evidence, result.Blockers\n+}\n+\n+// computeFederatedSourceProof reads the source's closeout state and review\n+// and proves the dependency from them.\n+func computeFederatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\n \tscope := localFederatedScope(identity)\n \tstate, err := source.GetCloseoutState(scope)\n \tif err != nil || !state.Terminal {\ndiff --git a/pose-mcp/internal/pose/federated_source_proof_memo_test.go b/pose-mcp/internal/pose/federated_source_proof_memo_test.go\nnew file mode 100644\nindex 00000000..ad99670c\n--- /dev/null\n+++ b/pose-mcp/internal/pose/federated_source_proof_memo_test.go\n@@ -0,0 +1,40 @@\n+package pose\n+\n+import (\n+\t\"reflect\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-federated-source-proof-is-computed-once-per-operation, R1: a\n+// dependency proved several times in one operation is computed once, and\n+// every answer is the same as the first; R2: without an operation it is\n+// computed every time; R3: a caller that changes its answer does not change\n+// a later one.\n+func TestFederatedSourceProofIsComputedOncePerOperation(t *testing.T) {\n+\tf, _ := approvedByARunThenDone(t)\n+\tidentity := ArtifactRef{Project: \"proj.source\", Kind: \"spec\", Slug: \"not-a-spec-of-this-fixture\"}\n+\tcounts := countLedgerComputations(t)\n+\tscoped := ledgerOperation(t, f.store)\n+\tvar first []string\n+\tfor i := 0; i < 3; i++ {\n+\t\t_, _, _, _, _, _, blockers := federatedSourceProof(scoped.fsys(), scoped, identity, \"\")\n+\t\tif len(blockers) == 0 {\n+\t\t\tt.Fatal(\"a missing dependency was proved\")\n+\t\t}\n+\t\tif i == 0 {\n+\t\t\tfirst = append([]string(nil), blockers...)\n+\t\t} else if !reflect.DeepEqual(blockers, first) {\n+\t\t\tt.Fatalf(\"answer %d differs: %v, want %v\", i, blockers, first)\n+\t\t}\n+\t\tblockers[0] = \"changed by the caller\"\n+\t}\n+\tif got := counts()[\"federated-source-proof\"]; got != 1 {\n+\t\tt.Fatalf(\"three proofs in one operation computed %d times, want 1\", got)\n+\t}\n+\tfor i := 0; i < 2; i++ {\n+\t\tfederatedSourceProof(f.store.fsys(), f.store, identity, \"\")\n+\t}\n+\tif got := counts()[\"federated-source-proof\"]; got != 3 {\n+\t\tt.Fatalf(\"proofs without an operation: %d computations in total, want 3\", got)\n+\t}\n+}\nAGENTS.md\nlocales/pt-BR/AGENTS.md\npose-mcp/internal/scaffold/dist/AGENTS.md\npose-mcp/internal/scaffold/dist/locales/pt-BR/AGENTS.md\n","exit_code":0,"status":"completed"}}
