{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '300,540p' pose-mcp/internal/pose/federated_acceptance.go; sed -n '735,790p' pose-mcp/internal/pose/federated_acceptance.go; rg -n 'func withGovernanceReviewReadView|func deepCopyValue|func deepCopyReflect|func .*ProjectStore|func .*ForProject' pose-mcp/internal/pose; sed -n '1200,1270p' pose-mcp/internal/pose/governance_read_view.go; sed -n '2590,2660p' pose-mcp/internal/pose/governance_read_view.go\"","aggregated_output":"\tif !roadmapDependencies {\n\t\tselected.DependsOn = nil\n\t}\n\tfor _, candidate := range rm.Milestones {\n\t\tif candidate.ID == milestone {\n\t\t\tselected.Milestones = append(selected.Milestones, candidate)\n\t\t}\n\t}\n\tif len(selected.Milestones) == 0 {\n\t\treturn FederatedRoadmapAcceptanceReport{}, fmt.Errorf(\"pose: milestone %s not found in roadmap %s\", milestone, slug)\n\t}\n\tcoordinator := ArtifactRef{Project: projectID, Kind: \"milestone\", Slug: slug, Milestone: milestone}\n\treturn s.federatedAcceptance(projectID, coordinator, collectFederatedRoadmapEdges(projectID, &selected), resolver)\n}\n\n// FederatedSpecAcceptance applies roadmap acceptance to the external\n// dependencies of one spec. It reports applies=false for a spec whose\n// depends_on names no other project, so its review and closeout keep their\n// previous contract. Local dependencies stay governed by lifecycle checks.\nfunc (s Store) FederatedSpecAcceptance(projectID, slug string, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, bool, error) {\n\tsp, err := s.GetSpec(slug)\n\tif err != nil {\n\t\treturn FederatedRoadmapAcceptanceReport{}, false, err\n\t}\n\tedges := []federatedRoadmapEdge{}\n\tfor _, raw := range sp.DependsOn {\n\t\tref, err := ParseArtifactRef(raw)\n\t\tif err != nil || ref.Project == \"\" || ref.Project == projectID {\n\t\t\tcontinue\n\t\t}\n\t\tedges = append(edges, federatedRoadmapEdge{project: projectID, raw: raw, relationship: \"prerequisite\"})\n\t}\n\tif len(edges) == 0 {\n\t\treturn FederatedRoadmapAcceptanceReport{}, false, nil\n\t}\n\tcoordinator := ArtifactRef{Project: projectID, Kind: \"spec\", Slug: slug}\n\tif resolver.Roots == nil {\n\t\t// Fail closed without failing the command: a checkout with no roots\n\t\t// can still read the spec but can never close it.\n\t\treturn federatedBlockedReport(s.fsys(), s, coordinator, \"project-roots-unavailable\"), true, nil\n\t}\n\treport, err := s.federatedAcceptance(projectID, coordinator, edges, resolver)\n\treturn report, true, err\n}\n\nfunc federatedBlockedReport(files Files, s Store, coordinator ArtifactRef, blocker string) FederatedRoadmapAcceptanceReport {\n\tmanifest := FederatedRoadmapManifest{SchemaVersion: 1, Coordinator: coordinator, CoordinatorRevision: federatedArtifactLastChange(files, s, coordinator), Dependencies: []FederatedDependency{}, Blockers: []string{blocker}}\n\tmanifest.Digest = canonicalFederatedDigest(manifest)\n\treturn FederatedRoadmapAcceptanceReport{Manifest: manifest, Blockers: []string{blocker}}\n}\n\nfunc (s Store) federatedAcceptance(projectID string, coordinator ArtifactRef, edges []federatedRoadmapEdge, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, error) {\n\tpolicy, policyDigest, err := LoadFederatedRoadmapPolicyIn(s.fsys(), s.Root)\n\tif err != nil {\n\t\treturn FederatedRoadmapAcceptanceReport{}, err\n\t}\n\trevision := gitHeadAtRootIn(s.fsys(), s.Root, federatedAcceptanceProducer)\n\tcoordinatorRevision := revision\n\tif stable := federatedArtifactLastChange(s.fsys(), s, coordinator); stable != \"\" {\n\t\tcoordinatorRevision = stable\n\t}\n\treport := FederatedRoadmapAcceptanceReport{Manifest: FederatedRoadmapManifest{\n\t\tSchemaVersion: 1, Coordinator: coordinator, CoordinatorRevision: coordinatorRevision,\n\t\tTrustPolicyDigest: policyDigest, Dependencies: []FederatedDependency{},\n\t}, Blockers: []string{}}\n\tqueue := []federatedQueuedRef{}\n\tfor _, edge := range edges {\n\t\tqueue = append(queue, federatedQueuedRef{project: edge.project, parent: edge.project, raw: edge.raw, relationship: edge.relationship})\n\t}\n\tvisited := map[string]bool{}\n\tdependencyIndexes := map[string]int{}\n\tprojectRoots := map[string]Store{projectID: s}\n\tsnapshotRevisions := map[string]string{}\n\tif revision != \"\" {\n\t\tsnapshotRevisions[projectID] = revision\n\t}\n\tfor len(queue) > 0 {\n\t\titem := queue[0]\n\t\tqueue = queue[1:]\n\t\tresolved := resolver.Resolve(item.project, item.raw)\n\t\tidentity := resolved.Identity\n\t\tif identity.Project == \"\" {\n\t\t\tidentity.Project = item.project\n\t\t}\n\t\tkey := identity.String()\n\t\tif visited[key] {\n\t\t\tif index, ok := dependencyIndexes[key]; ok {\n\t\t\t\tentry := &report.Manifest.Dependencies[index]\n\t\t\t\tfound := item.relationship == entry.Relationship\n\t\t\t\tfor _, relationship := range entry.Relationships {\n\t\t\t\t\tfound = found || relationship == item.relationship\n\t\t\t\t}\n\t\t\t\tif !found {\n\t\t\t\t\tentry.Relationships = append(entry.Relationships, item.relationship)\n\t\t\t\t\tsort.Strings(entry.Relationships)\n\t\t\t\t\tentry.Relationship = entry.Relationships[0]\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif len(visited) >= 256 {\n\t\t\treport.Blockers = append(report.Blockers, \"resolution-limit\")\n\t\t\tbreak\n\t\t}\n\t\tvisited[key] = true\n\t\tentry := FederatedDependency{Ref: key, Relationship: item.relationship, Relationships: []string{item.relationship}, Identity: identity, ResolutionState: resolved.State, Status: resolved.Status, SourceRevision: resolved.Revision, SourceDigest: resolved.Digest}\n\t\t// The dependency keeps the identity it was named by, as the manifest\n\t\t// records it; a transferred artifact is proven at its canonical\n\t\t// destination: its store, revision, trust and closeout (review\n\t\t// round 7, N25). The resolver authorized the redirect chain.\n\t\tproven := identity\n\t\tif resolved.CanonicalIdentity != nil {\n\t\t\tproven = *resolved.CanonicalIdentity\n\t\t}\n\t\tdependencyIndexes[key] = len(report.Manifest.Dependencies)\n\t\tif !resolved.Resolved {\n\t\t\treport.Blockers = append(report.Blockers, key+\":\"+resolved.State)\n\t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n\t\t\tcontinue\n\t\t}\n\t\tif selected, exists := snapshotRevisions[proven.Project]; exists && selected != \"\" && resolved.Revision != selected {\n\t\t\treport.Blockers = append(report.Blockers, key+\":source-revision-changed-during-resolution\")\n\t\t} else if _, exists := snapshotRevisions[proven.Project]; !exists && resolved.Revision != \"\" {\n\t\t\tsnapshotRevisions[proven.Project] = resolved.Revision\n\t\t}\n\t\tgraphValid := true\n\t\tif reason := resolver.ValidateGraph(item.project, item.raw); reason != \"\" {\n\t\t\tgraphValid = false\n\t\t\tentry.ResolutionState = reason\n\t\t\treport.Blockers = append(report.Blockers, key+\":\"+reason)\n\t\t}\n\t\tstatusDone := resolved.Status == \"done\"\n\t\tif !statusDone {\n\t\t\treport.Blockers = append(report.Blockers, key+\":not-done\")\n\t\t}\n\t\tsource, sourceErr := resolver.Roots.StoreFor(proven.Project)\n\t\tif sourceErr != nil {\n\t\t\tentry.ResolutionState = projectResolutionState(sourceErr)\n\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n\t\t\tcontinue\n\t\t}\n\t\tsource = resolver.withSpecSnapshot(proven.Project, source)\n\t\tprojectRoots[proven.Project] = source\n\t\tsource.FederatedProjectID = proven.Project\n\t\tsource.FederatedResolver = &resolver\n\t\tartifactValid := true\n\t\tif err := verifyFederatedArtifactAtRevision(s.fsys(), source, proven, resolved); err != nil {\n\t\t\tartifactValid = false\n\t\t\tentry.ResolutionState = err.Error()\n\t\t\tblocker := key + \":\" + err.Error()\n\t\t\tif err.Error() == federatedSourceUncommitted {\n\t\t\t\tblocker += \": commit the artifact, its working file differs from its revision\"\n\t\t\t}\n\t\t\treport.Blockers = append(report.Blockers, blocker)\n\t\t}\n\t\t// Same-project dependencies need the revision of their own artifact.\n\t\t// Using repository HEAD makes every unrelated evidence commit stale a\n\t\t// sealed milestone or roadmap. External dependencies retain the explicit\n\t\t// whole-repository pin checked below.\n\t\tif proven.Project == projectID {\n\t\t\tif stable := federatedArtifactLastChange(s.fsys(), source, proven); stable != \"\" {\n\t\t\t\tentry.SourceRevision = stable\n\t\t\t}\n\t\t\t// Under an adopted closeout review policy a local milestone or\n\t\t\t// roadmap is closed by its explicit close, never by the status\n\t\t\t// its members give it: the edge asks the terminal projection,\n\t\t\t// along a chain that stops at a cycle (review round 6, N22).\n\t\t\tif statusDone && graphValid && !s.indexMaterial && (proven.Kind == \"milestone\" || proven.Kind == \"roadmap\") {\n\t\t\t\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || adopted && !s.localScopeClosed(localFederatedScope(proven)) {\n\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":closeout-not-terminal\")\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif proven.Project != projectID {\n\t\t\t// Do not recurse into source closeout when graph traversal has already\n\t\t\t// found a cycle or stale artifact. The blocker is conclusive, and\n\t\t\t// recursively asking each side of a cycle for its review would never\n\t\t\t// converge.\n\t\t\tgitlinkValid := true\n\t\t\tpin, pinErr := FederatedProjectTrustForIn(s.fsys(), source.Root, proven.Project)\n\t\t\tif pinErr != nil {\n\t\t\t\tentry.ResolutionState = pinErr.Error()\n\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t} else {\n\t\t\t\tentry.SourceContractDigest, entry.SourcePolicyDigest = pin.ContractDigest, pin.PolicyDigest\n\t\t\t}\n\t\t\tif !policy.Enabled {\n\t\t\t\tentry.ResolutionState = \"consumer-trust-not-adopted\"\n\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t} else {\n\t\t\t\taccepted, exists := policy.TrustedProjects[proven.Project]\n\t\t\t\tif pinErr != nil {\n\t\t\t\t\t// The pin error was recorded above; retain the stable state.\n\t\t\t\t} else if !exists {\n\t\t\t\t\tentry.ResolutionState = \"consumer-trust-not-adopted\"\n\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t\t} else if accepted != pin {\n\t\t\t\t\tentry.ResolutionState = \"consumer-trust-stale\"\n\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t\t} else {\n\t\t\t\t\tif proven.Project == item.parent {\n\t\t\t\t\t\t// This edge remains inside the selected source repository;\n\t\t\t\t\t\t// its local artifacts inherit that repository's pin.\n\t\t\t\t\t} else if parentStore, parentErr := resolver.Roots.StoreFor(item.parent); parentErr != nil || !federatedGitlinkMatchesIn(s.fsys(), parentStore, source, resolved.Revision) {\n\t\t\t\t\t\tgitlinkValid = false\n\t\t\t\t\t\tif parentErr != nil {\n\t\t\t\t\t\t\tentry.ResolutionState = projectResolutionState(parentErr)\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\tentry.ResolutionState = \"gitlink-revision-mismatch\"\n\t\t\t\t\t\t}\n\t\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\taccepted, trusted := policy.TrustedProjects[proven.Project]\n\t\t\tproofInputsReady := graphValid && statusDone && artifactValid && pinErr == nil && policy.Enabled && trusted && accepted == pin && gitlinkValid\n\t\t\tif proofInputsReady {\n\t\t\t\tbundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, proofBlockers := federatedSourceProof(s.fsys(), source, proven, resolved.Revision)\n\t\t\t\tentry.ReviewBundleID, entry.ReviewBundleDigest = bundleID, bundleDigest\n\t\t\t\tentry.ImplementationDigest, entry.PlanDigest = subjectDigest, planDigest\n\t\t\t\tentry.GoverningContracts, entry.Evidence = contracts, evidence\n\t\t\t\treport.Blockers = append(report.Blockers, proofBlockers...)\n\t\t\t\tif len(proofBlockers) > 0 {\n\t\t\t\t\tentry.ResolutionState = \"source-evidence-incomplete\"\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n\t\tfor _, dep := range resolved.Dependencies {\n\t\t\tqueue = append(queue, federatedQueuedRef{project: dep.Project, parent: proven.Project, raw: dep.String(), relationship: \"prerequisite\"})\n\t\t}\n\t}\n\tfor project, selected := range snapshotRevisions {\n\t\tif selected == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\troot, ok := projectRoots[project]\n\t\tif ok && gitHeadAtRootIn(s.fsys(), root.Root, federatedAcceptanceProducer) != selected {\n\t\t\treport.Blockers = append(report.Blockers, \"source-snapshot-changed-during-resolution:\"+project)\n\t\t}\nfunc computeFederatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\n\tscope := localFederatedScope(identity)\n\tstate, err := source.GetCloseoutState(scope)\n\tif err != nil || !state.Terminal {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-not-terminal\"}\n\t}\n\t// A milestone or roadmap the source closed without its own review, under\n\t// its adopted closeout review policy, is proven by the receipt of that\n\t// close: the source's policy decides, never the consumer's. Its members\n\t// are federated with their own reviews (spec\n\t// pose-closeout-review-policy-by-cost-benefit).\n\tif receipt := state.CloseoutReceipt; receipt != nil && !receipt.Decision.Required && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n\t\traw, err := json.Marshal(receipt)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-receipt-unreadable\"}\n\t\t}\n\t\treturn \"closeout-receipt:\" + scope, \"sha256:\" + digestHex(raw), receipt.SubjectDigest, receipt.PolicyDigest, nil, nil, nil\n\t}\n\tverification, err := source.VerifyReviewBundle(scope)\n\t// A milestone its roadmap declares has no review of its own: what a consumer can\n\t// hold is the review of that roadmap, which sealed the declaration.\n\tif err == nil && identity.Kind == \"milestone\" && strings.HasPrefix(verification.ApprovalOrigin, \"declared:\") {\n\t\tverification, err = source.VerifyReviewBundle(\"roadmap:\" + identity.Slug)\n\t}\n\tif err != nil || !verification.Fresh || !verification.Approved || verification.Bundle == nil || verification.Attestation == nil || !source.sealedDeclarationHolds(verification.Bundle) {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-review-not-approved\"}\n\t}\n\tbundle := verification.Bundle\n\teligible := federatedSourceEvidenceEligibilityIn(files, source.Root, pinnedRevision, bundle.Payload.Subject.Head)\n\tif identity.Kind == \"spec\" {\n\t\tspec, err := source.GetSpec(identity.Slug)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":unavailable-artifact\"}\n\t\t}\n\t\ttargets, _, err := ParseDeliveryTargets(*spec)\n\t\tif err != nil || len(targets) == 0 {\n\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-target-missing\"}\n\t\t}\n\t\tprofiles, err := loadFederatedDeliveryProfiles(files, source.Root)\n\t\tif err != nil {\n\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-profile-unavailable\"}\n\t\t}\n\t\tblockers := []string{}\n\t\tfor _, target := range targets {\n\t\t\tprofile, ok := profiles[target.Profile]\n\t\t\tif !ok || profile.Kind != target.Kind {\n\t\t\t\tblockers = append(blockers, scope+\":source-delivery-profile-unsupported\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseen := map[string]bool{}\n\t\t\tfor _, evidence := range bundle.Payload.Evidence {\n\t\t\t\tif eligible(evidence) && moduleMatchesTarget(evidence.Module, target.Module) {\n\t\t\t\t\tseen[evidence.EvidenceClass] = true\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor _, required := range profile.RequiredEvidenceClasses {\npose-mcp/internal/pose/governance_read_view.go:1198:func (v *governanceReadView) filesForProject(producer, project string) Files {\npose-mcp/internal/pose/governance_read_view.go:1281:func markGovernanceReadUnknownForProject(files Files, root, project, fallback, reason string) {\npose-mcp/internal/pose/cache_size.go:100:func deepCopyValue[T any](in T) T {\npose-mcp/internal/pose/governance_scoped_write.go:15:func (s Store) WithGovernanceWriteGuardForProjects(operation string, projectIDs []string, callback func(Store) error) error {\npose-mcp/internal/pose/review_closeout.go:477:func withGovernanceReviewReadView[T any](s Store, producer string, run func(Store) (T, error), attach func(*T, *ReadViewMetadata, governanceReadViewAudit)) (T, error) {\npose-mcp/internal/pose/review_closeout.go:486:func withGovernanceReviewReadViewAttempt[T any](s Store, producer string, attempt int, run func(Store) (T, error), attach func(*T, *ReadViewMetadata, governanceReadViewAudit)) (T, error) {\n}\n\nfunc (v *governanceReadView) route(name, producer, project string) *governanceReadView {\n\tif v.operation == nil {\n\t\treturn v\n\t}\n\tif target := v.operation.route(name, producer, project); target != nil {\n\t\treturn target\n\t}\n\tv.markUnknown(producer, \"input is outside the authorized root generation vector\")\n\treturn v\n}\n\nfunc (v *governanceReadView) pathKey(name string) string {\n\tpath, err := filepath.Abs(name)\n\tif err == nil {\n\t\treturn filepath.Clean(path)\n\t}\n\treturn filepath.Clean(name)\n}\n\nfunc (v *governanceReadView) begin() error {\n\tv.mu.Lock()\n\tdefer v.mu.Unlock()\n\tif v.closed {\n\t\treturn errGovernanceReadViewFinalized\n\t}\n\tv.active++\n\treturn nil\n}\n\nfunc (v *governanceReadView) end() {\n\tv.mu.Lock()\n\tv.active--\n\tif v.active == 0 && v.cond != nil {\n\t\tv.cond.Broadcast()\n\t}\n\tv.mu.Unlock()\n}\n\nfunc (v *governanceReadView) displayPath(path string) string {\n\trel, err := filepath.Rel(v.root, path)\n\tif err == nil && rel != \"..\" && !strings.HasPrefix(rel, \"..\"+string(filepath.Separator)) {\n\t\treturn filepath.ToSlash(rel)\n\t}\n\treturn \"external:\" + digestBytes([]byte(filepath.Clean(path)))\n}\n\nfunc (v *governanceReadView) markUnknownLocked(producer, reason string) {\n\tif producer == \"\" {\n\t\tproducer = \"projection\"\n\t}\n\tif v.unknown[producer] == nil {\n\t\tv.unknown[producer] = map[string]bool{}\n\t}\n\tv.unknown[producer][reason] = true\n}\n\nfunc (v *governanceReadView) markUnknown(producer, reason string) {\n\tv.mu.Lock()\n\tv.markUnknownLocked(producer, reason)\n\tv.mu.Unlock()\n}\n\nfunc markGovernanceReadUnknown(files Files, root, producer, reason string) {\n\tviewFiles, ok := FilesOrNative(files).(*governanceReadViewFiles)\n\tif !ok || viewFiles.view == nil {\n\t\treturn\n\t}\n\tview := viewFiles.view.route(root, producer, viewFiles.project)\n\tview.markUnknown(producer, reason)\n\t\tresolver.snapshots = nil\n\t\ts.FederatedResolver = &resolver\n\t}\n\ts.specs = nil\n\ts.reviewView = nil\n\ts.reviewReuse = nil\n\ts.indexPin = nil\n\treturn s\n}\n\nfunc unwrapGovernanceReadViewFiles(files Files) (Files, bool) {\n\tviewFiles, ok := FilesOrNative(files).(*governanceReadViewFiles)\n\tif !ok {\n\t\treturn files, false\n\t}\n\treturn viewFiles.view.base, true\n}\n\nfunc (s Store) withGovernanceReadView(view *governanceReadView, producer string) Store {\n\ts.FS = view.filesFor(producer)\n\ts.reviewView = nil\n\ts.reviewReuse = nil\n\tif s.FederatedResolver != nil {\n\t\tresolver := *s.FederatedResolver\n\t\tresolver.FS = s.FS\n\t\tif view.operation != nil {\n\t\t\tresolver.Roots = view.operation.rootsForProducer(resolver.Roots, s.FS, producer)\n\t\t} else {\n\t\t\tresolver.Roots = cloneRootsWithFiles(resolver.Roots, s.FS)\n\t\t}\n\t\tresolver.governanceDepthLimit = 8\n\t\tresolver.snapshots = nil\n\t\ts.FederatedResolver = &resolver\n\t}\n\treturn s\n}\n\nfunc cloneRootsWithFiles(roots *Roots, files Files) *Roots {\n\tif roots == nil {\n\t\treturn nil\n\t}\n\troots.mu.RLock()\n\tclone := &Roots{\n\t\tcfg:              roots.cfg,\n\t\tbyProject:        make(map[string]string, len(roots.byProject)),\n\t\tconflicts:        make(map[string]bool, len(roots.conflicts)),\n\t\tgovernanceStores: make(map[string]Store, len(roots.governanceStores)),\n\t\tlastScan:         roots.lastScan,\n\t\trescanWindow:     roots.rescanWindow,\n\t\tfs:               files,\n\t}\n\tfor project, root := range roots.byProject {\n\t\tclone.byProject[project] = root\n\t}\n\tfor project, conflict := range roots.conflicts {\n\t\tclone.conflicts[project] = conflict\n\t}\n\tfor project, store := range roots.governanceStores {\n\t\tclone.governanceStores[project] = store\n\t}\n\troots.mu.RUnlock()\n\treturn clone\n}\n\nfunc (op *governanceReadViewOperation) rootsForProducer(roots *Roots, files Files, producer string) *Roots {\n\tif roots == nil || op == nil {\n\t\treturn nil\n\t}\n\troots.mu.RLock()\n\tcfg := roots.cfg\n\troots.mu.RUnlock()\n","exit_code":0,"status":"completed"}}
