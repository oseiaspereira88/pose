-mcp/internal/pose/capabilities.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/doctor_commit_graph.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/onboarding.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/mcpserver/closeout_review_policy_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/validate_root_and_nodemodules_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/init_delegation.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/quickstart_script_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/doctor.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/pose/governance_operation_performance_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/help_catalog.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/pose/review_reuse_provenance.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/pose/review_plan.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/pose/b07_independent_probe_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/pose/review_subject_capabilities_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/pose/docs.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan .agents/skills/pose-release-closeout/SKILL.md\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/followups.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/pose/state.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/assessment_agnostic_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/pose/sshsig.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/pose/amendment_history_close_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/stacks_cmd.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/amend_flat_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/artifact_integrity_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/docs_sync_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\nsurface.spec=pose-federated-source-proof-is-computed-once-per-operation\nsurface.targets=1\nsurface.results=234\nsurface.findings=0\nsurface.provenance_digest=sha256:ce92ea42c69aed27a1dc742de1ba177b50cb9af4ae5bc279672a2311cce90240\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/specs/2026-11-17-pose-federated-source-proof-is-computed-once-per-operation.md .pose/rules/backend-go.md pose-mcp/internal/pose/review_ledger_memo.go; sed -n '1,100p' pose-mcp/internal/pose/federated_acceptance.go; sed -n '680,880p' pose-mcp/internal/pose/federated_acceptance.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/specs/2026-11-17-pose-federated-source-proof-is-computed-once-per-operation.md .pose/rules/backend-go.md pose-mcp/internal/pose/review_ledger_memo.go; sed -n '1,100p' pose-mcp/internal/pose/federated_acceptance.go; sed -n '680,880p' pose-mcp/internal/pose/federated_acceptance.go\"","aggregated_output":"---\nslug: pose-federated-source-proof-is-computed-once-per-operation\nstatus: in-progress\ncreated_at: 2026-11-17\ncompleted_at:        # stamped on the transition to status: done\nsupersedes:          # slug of the superseded spec (when applicable)\ndepends_on: pose-review-ledger-is-read-once-per-operation\nremediates:          # optional explicit links: spec:slug@defect-fix, finding:rva-<16hex>/F1@revert (never inferred from depends_on)\npriority:            # integer >= 0 (lower = higher priority); ordering preference, not a blocker\ncomponents: pose-mcp\ntask_type: refactor\nsurface:             # optional: minimal | standard | full (default) — minimal drops Tasks and derivable report sections; `pose specs facts <slug>` derives them\ndelivers: capability:federated-source-proof-is-computed-once-per-operation\n---\n\n# Spec: pose-federated-source-proof-is-computed-once-per-operation\n\n## 1. Intent\n\n### Goal\nFazer uma operação de read view provar cada dependência federada uma vez, e não a cada roadmap que a consome.\n\n### Business value\nCom o ledger lido uma vez por operação e o commit-graph do Git, a primeira chamada `pose_closeout_state` de um servidor MCP sobre o harne8 ainda leva cerca de 80 s, e o perfil de CPU põe cerca de 37 s em `federatedSourceProof`, que verifica a revisão da fonte de cada dependência. Numa só chamada há 64 provas e só 39 distintas: a mesma dependência do pose-dist é consumida por vários roadmaps do harne8, e cada consumo reabre o estado de fechamento e a verificação do bundle da fonte.\n\n### Constraints\n- Dentro de uma operação a read view devolve os mesmos bytes para a mesma leitura; a prova guardada é a que essas leituras dão e não muda resposta nenhuma.\n- As leituras da prova passam pela operação de fora (uma chamada usa duas operações de read view no total), de modo que a auditoria final as cobre como antes.\n\n### Non-goals\n- Reduzir o custo de cada prova distinta (verificação de filhos do bundle, grafo de integridade, política de delegação), que fica para outras specs.\n\n---\n\n## 2. Requirements\n\n### Functional\n- R1: Within a read-view operation, the engine shall compute the proof of a federated dependency once per source root, identity and pinned revision, for each producer, and shall answer every later request of that operation from it.\n- R2: Without a read-view operation, every request shall compute the proof.\n- R3: Each answer shall be a deep copy, so a caller that changes it does not change a later answer; a refused memo read shall be a blocker of the dependency, never a proof.\n\n### Non-functional\n- No harne8, a primeira chamada de fechamento cai de cerca de 80 s para cerca de 60 s, com o mesmo veredito.\n\n### Security\n- Nenhuma mudança de autorização: o memo guarda o que a operação já provou pelas raízes que ela autoriza.\n\n### Compatibility\n- Sem mudança de contrato, saída ou formato.\n\n---\n\n## 3. Technical Plan\n\n### Affected areas\n- `pose/federated_acceptance.go`: `federatedSourceProof` passa pelo memo da operação (`memoizedLedgerRead`), que já guarda por produtor, confere o ciclo de vida da view e computa uma vez sob concorrência; o corpo antigo vira `computeFederatedSourceProof`.\n\n### Artifacts\n- created: pose-mcp/internal/pose/federated_source_proof_memo_test.go\n- modified: pose-mcp/internal/pose/federated_acceptance.go\n- modified: .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n- modified: .pose/indexes/validation-matrix.json\n\n### Delivery targets\n\n- capability:federated-source-proof-is-computed-once-per-operation module:pose-mcp profile:composed-capability entrypoint:pose-mcp/cmd/pose/main.go\n\nComposto em produção por toda aceitação federada de roadmap e de spec, no índice, no fechamento e na revisão. Check permanente `federated-source-proof-is-computed-once-per-operation-integration`, evidenceClass `integration`, required: `go test ./internal/pose -run 'TestFederatedSourceProofIsComputedOncePerOperation' -count=1`.\n\n### API/contract changes\n- Nenhuma.\n\n### Data/storage changes\n- Nenhuma.\n\n### Technical risks\n- Uma leitura de prova feita numa operação aninhada nova não passaria pela operação de fora; a medição contou duas operações por chamada, e as leituras da prova entram na operação de fora.\n\n---\n\n## 4. Tasks\n\n### Implementation\n- [x] Memo da prova federada por operação (R1, R2, R3).\n- [x] Emenda D15 do ADR das leituras de governança.\n\n### Validation\n- [x] Teste de contagem e de isolamento das respostas, com prova de reprovação; medição no harne8.\n\n---\n\n## 5. Decisions\n\n### Decision D1\n- Date: 2026-11-17\n- Context: o perfil da primeira chamada depois da spec `pose-review-ledger-is-read-once-per-operation` pôs cerca de 37 s em `federatedSourceProof`, com 64 provas e 39 distintas.\n- Options considered: (a) memo da prova por operação; (b) reduzir o custo de cada prova; (c) guardar provas entre operações.\n- Decision: (a).\n- Basis: R1, R2, R3\n- Rationale: (a) reusa o mecanismo do ledger e não muda resposta; (b) fica para depois, com alvos já medidos; (c) exigiria reproduzir o fecho de cada prova a cada chamada.\n- Consequences: cada dependência distinta é provada uma vez por operação.\n\n---\n\n## 6. Validation\n\n### Strategy\nTeste com uma operação real: três provas da mesma dependência computam uma vez e dão respostas iguais e isoladas; fora de operação, cada uma computa. Medição da primeira chamada no harne8.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./internal/pose ./internal/cli ./internal/mcpserver ./internal/scaffold -count=1`\n- Scope: pose-mcp\n- Expected: verde\n\n### Execution log\n- Date: 2026-11-17\n- Environment: Linux, Go 1.26, Git 2.56; clone do harne8 em cc7780b1 com o pose-dist em 7e46b1e e commit-graph com filtros; `closeout-check spec:harne8-abm-governed-execution`.\n- Notes: uma build instrumentada contou 64 provas e 39 distintas numa chamada; com o memo, a chamada caiu de 80 s para 60 s, terminal nas duas. Sem o memo o teste conta três computações; sem a cópia profunda, a segunda resposta traz a mudança do chamador.\n\n### Results summary\n- Successes: a primeira chamada fica cerca de 25% mais rápida, com o mesmo veredito.\n- Failures: nenhuma.\n- Warnings: nenhum.\n\n### Requirement trace\n- R1 [satisfied] test:TestFederatedSourceProofIsComputedOncePerOperation check:federated-source-proof-is-computed-once-per-operation-integration\n- R2 [satisfied] test:TestFederatedSourceProofIsComputedOncePerOperation\n- R3 [satisfied] test:TestFederatedSourceProofIsComputedOncePerOperation\n\n### Known gaps\n- A recusa do memo numa view finalizada vira bloqueador pela mesma checagem de ciclo de vida do ledger, coberta por `TestReviewLedgerMemoIsNotServedAfterTheOperationEnds`, sem teste próprio aqui.\n\n---\n\n## 7. Final Report\n\n### Delivered scope\n\nNão concluída.\n\n### Residual risks\n\n### Follow-ups\n\n- [open] F1: reduzir o custo de cada prova distinta, medido no mesmo perfil: verificação dos filhos do bundle (cerca de 8,5 s), parse e cópia do grafo de integridade (cerca de 8 s e 5,5 s), carga e validação da política de delegação (cerca de 4,3 s) e a sonda de grupo de processos `verifyReviewProcessGroup` a cada verificação (cerca de 4,3 s). (owner:@pose-maintainers crit:medium review:2026-11-24)\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\npackage pose\n\nimport \"sync\"\n\n// The review ledger of a project is read by every bundle verification an\n// operation makes: a closeout that verifies 64 federated dependencies read\n// pose-dist's ledger 280 times and checked transcript digests 29,680 times.\n// Within a read-view operation the view already returns the same bytes for\n// the same read, so a value derived only from those reads is the same on\n// every request: it is computed once and kept for the life of the operation\n// (spec pose-review-ledger-is-read-once-per-operation, ADR\n// governance-reads-use-bounded-operation-scoped-views D14). The first\n// computation reads through the view, so the operation's closure and final\n// audit cover every input as before.\n\ntype reviewRunsRead struct {\n\truns []ReviewRun\n\tlost []string\n}\n\n// ledgerMemoCell computes its value once: concurrent requests for the same\n// key wait for the one computation.\ntype ledgerMemoCell[V any] struct {\n\tonce  sync.Once\n\tvalue V\n\terr   error\n}\n\n// ledgerMemoComputed sees each computation; tests count them.\nvar ledgerMemoComputed = func(key string) {}\n\n// memoizedLedgerRead returns compute's result, kept per key in the\n// read-view operation of files; without an operation it computes every\n// time. The bool reports whether the value came from the memo.\nfunc memoizedLedgerRead[V any](files Files, key string, compute func() (V, error)) (V, bool, error) {\n\tview, viewFiles := governanceReadViewFromFiles(files)\n\tif view == nil || view.operation == nil || viewFiles == nil {\n\t\t// Without an operation, or without the producer the reads are\n\t\t// attributed to, every request computes and reads for itself.\n\t\tledgerMemoComputed(key)\n\t\tvalue, err := compute()\n\t\treturn value, false, err\n\t}\n\t// A kept value is served only while the view is open, as a read is: a\n\t// finalized view rejects it (review F4).\n\tif err := view.begin(); err != nil {\n\t\tvar zero V\n\t\treturn zero, false, err\n\t}\n\tdefer view.end()\n\t// A kept value is the producer's own: each producer reads once through\n\t// the view, so the final audit attributes a changed input to every\n\t// producer that consumed it (review N3).\n\tkey += \"\\x00producer=\" + viewFiles.producer + \"\\x00project=\" + viewFiles.project\n\tkept, _ := view.operation.ledgerMemo.LoadOrStore(key, &ledgerMemoCell[V]{})\n\tcell := kept.(*ledgerMemoCell[V])\n\tcomputed := false\n\tcell.once.Do(func() {\n\t\tcomputed = true\n\t\tledgerMemoComputed(key)\n\t\tcell.value, cell.err = compute()\n\t})\n\treturn cell.value, !computed, cell.err\n}\n\n// copyReviewRuns gives a caller runs that share nothing with the kept ones:\n// deepCopyValue copies every exported field, and the unexported ones are\n// copied here (a reflection test holds this list to ReviewRun's fields).\nfunc copyReviewRuns(runs []ReviewRun) []ReviewRun {\n\tif runs == nil {\n\t\treturn nil\n\t}\n\tout := make([]ReviewRun, len(runs))\n\tfor i, run := range runs {\n\t\tout[i] = deepCopyValue(run)\n\t\tout[i].sessionForRedaction = run.sessionForRedaction\n\t\tout[i].eventsDir = run.eventsDir\n\t\tif run.eventsBytes != nil {\n\t\t\tout[i].eventsBytes = append(make([]byte, 0, len(run.eventsBytes)), run.eventsBytes...)\n\t\t}\n\t}\n\treturn out\n}\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n)\n\nconst FederatedRoadmapPolicySchemaVersion = 1\n\nconst (\n\tmaxFederatedPolicyBytes          = 256 << 10\n\tmaxFederatedGovernanceInputBytes = 2 << 20\n)\n\ntype FederatedProjectTrust struct {\n\tContractDigest string `json:\"contract_digest\"`\n\tPolicyDigest   string `json:\"policy_digest\"`\n\tRevision       string `json:\"revision\"`\n}\n\ntype FederatedRoadmapPolicy struct {\n\tSchemaVersion   int                              `json:\"schema_version\"`\n\tEnabled         bool                             `json:\"enabled\"`\n\tAdoptedAt       string                           `json:\"adopted_at,omitempty\"`\n\tTrustedProjects map[string]FederatedProjectTrust `json:\"trusted_projects,omitempty\"`\n}\n\ntype FederatedDependencyEvidence struct {\n\tID                 string `json:\"id\"`\n\tCheck              string `json:\"check\"`\n\tEvidenceClass      string `json:\"evidence_class\"`\n\tSubjectObservation string `json:\"subject_observation\"`\n}\n\ntype FederatedDependency struct {\n\tRef                  string                        `json:\"ref\"`\n\tRelationship         string                        `json:\"relationship\"`\n\tRelationships        []string                      `json:\"relationships,omitempty\"`\n\tIdentity             ArtifactRef                   `json:\"identity\"`\n\tResolutionState      string                        `json:\"resolution_state\"`\n\tStatus               string                        `json:\"status,omitempty\"`\n\tSourceRevision       string                        `json:\"source_revision,omitempty\"`\n\tSourceDigest         string                        `json:\"source_digest,omitempty\"`\n\tSourceContractDigest string                        `json:\"source_contract_digest,omitempty\"`\n\tSourcePolicyDigest   string                        `json:\"source_policy_digest,omitempty\"`\n\tReviewBundleID       string                        `json:\"review_bundle_id,omitempty\"`\n\tReviewBundleDigest   string                        `json:\"review_bundle_digest,omitempty\"`\n\tImplementationDigest string                        `json:\"implementation_digest,omitempty\"`\n\tPlanDigest           string                        `json:\"plan_digest,omitempty\"`\n\tGoverningContracts   []string                      `json:\"governing_contracts,omitempty\"`\n\tEvidence             []FederatedDependencyEvidence `json:\"evidence,omitempty\"`\n}\n\ntype FederatedRoadmapManifest struct {\n\tSchemaVersion       int                   `json:\"schema_version\"`\n\tCoordinator         ArtifactRef           `json:\"coordinator\"`\n\tCoordinatorRevision string                `json:\"coordinator_revision,omitempty\"`\n\tTrustPolicyDigest   string                `json:\"trust_policy_digest,omitempty\"`\n\tDependencies        []FederatedDependency `json:\"dependencies\"`\n\tReady               bool                  `json:\"ready\"`\n\tBlockers            []string              `json:\"blockers\"`\n\tDigest              string                `json:\"digest\"`\n}\n\ntype FederatedRoadmapAcceptanceReport struct {\n\tManifest FederatedRoadmapManifest `json:\"manifest\"`\n\tReady    bool                     `json:\"ready\"`\n\tBlockers []string                 `json:\"blockers\"`\n}\n\ntype federatedRoadmapEdge struct {\n\tproject      string\n\traw          string\n\trelationship string\n}\n\ntype federatedQueuedRef struct {\n\tproject      string\n\tparent       string\n\traw          string\n\trelationship string\n}\n\n// FederatedProjectTrustFor computes the exact governance inputs a consumer\n// must accept for one source project. It is read-only: callers still have to\n// record the returned digests in their own policy.\nfunc FederatedProjectTrustForIn(files Files, root, projectID string) (FederatedProjectTrust, error) {\n\tif ValidateSlug(projectID) != nil {\n\t\treturn FederatedProjectTrust{}, fmt.Errorf(\"pose: invalid federated project id\")\n\t}\n\tparentReal, err1 := files.EvalSymlinks(parent.Root)\n\tchildReal, err2 := files.EvalSymlinks(child.Root)\n\tif err1 != nil || err2 != nil {\n\t\treturn false\n\t}\n\trel, err := filepath.Rel(parentReal, childReal)\n\tif err != nil || rel == \"..\" || strings.HasPrefix(rel, \"..\"+string(filepath.Separator)) {\n\t\treturn true // sibling project, explicitly selected in Roots.\n\t}\n\tlisting, err := captureFederatedGit(files, parent.Root, \"ls-tree\", \"HEAD\", \"--\", filepath.ToSlash(rel))\n\tif err != nil {\n\t\treturn false\n\t}\n\tfields := strings.Fields(string(listing))\n\tif len(fields) < 3 || fields[0] != \"160000\" || fields[1] != \"commit\" {\n\t\treturn false\n\t}\n\treturn fields[2] == revision\n}\n\n// federatedGitlinkMatches reads the filesystem directly; federatedGitlinkMatchesIn reads the operation's files.\nfunc federatedGitlinkMatches(parent, child Store, revision string) bool {\n\treturn federatedGitlinkMatchesIn(NativeFiles(), parent, child, revision)\n}\n\n// federatedSourceProofResult is what federatedSourceProof answers.\ntype federatedSourceProofResult struct {\n\tBundleID, BundleDigest, SubjectDigest, PlanDigest string\n\tContracts                                         []string\n\tEvidence                                          []FederatedDependencyEvidence\n\tBlockers                                          []string\n}\n\n// federatedSourceProof proves one federated dependency from its source's\n// review. A closeout asks it for the same dependency from several roadmaps\n// (64 proofs, 39 distinct, in one harne8 closeout); within one read-view\n// operation the answer is a function of that operation's reads, so it is\n// computed once per operation and producer, like the review ledger (spec\n// pose-federated-source-proof-is-computed-once-per-operation).\nfunc federatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\n\tkey := \"federated-source-proof\\x00\" + filepath.Clean(source.Root) + \"\\x00\" + identity.Project + \"\\x00\" + identity.Kind + \"\\x00\" + identity.Slug + \"\\x00\" + pinnedRevision\n\tresult, _, err := memoizedLedgerRead(files, key, func() (federatedSourceProofResult, error) {\n\t\tbundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, blockers := computeFederatedSourceProof(files, source, identity, pinnedRevision)\n\t\treturn federatedSourceProofResult{bundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, blockers}, nil\n\t})\n\tif err != nil {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{localFederatedScope(identity) + \":source-proof-unavailable\"}\n\t}\n\tresult = deepCopyValue(result)\n\treturn result.BundleID, result.BundleDigest, result.SubjectDigest, result.PlanDigest, result.Contracts, result.Evidence, result.Blockers\n}\n\n// computeFederatedSourceProof reads the source's closeout state and review\n// and proves the dependency from them.\nfunc computeFederatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\n\tscope := localFederatedScope(identity)\n\tstate, err := source.GetCloseoutState(scope)\n\tif err != nil || !state.Terminal {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-not-terminal\"}\n\t}\n\t// A milestone or roadmap the source closed without its own review, under\n\t// its adopted closeout review policy, is proven by the receipt of that\n\t// close: the source's policy decides, never the consumer's. Its members\n\t// are federated with their own reviews (spec\n\t// pose-closeout-review-policy-by-cost-benefit).\n\tif receipt := state.CloseoutReceipt; receipt != nil && !receipt.Decision.Required && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n\t\traw, err := json.Marshal(receipt)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-receipt-unreadable\"}\n\t\t}\n\t\treturn \"closeout-receipt:\" + scope, \"sha256:\" + digestHex(raw), receipt.SubjectDigest, receipt.PolicyDigest, nil, nil, nil\n\t}\n\tverification, err := source.VerifyReviewBundle(scope)\n\t// A milestone its roadmap declares has no review of its own: what a consumer can\n\t// hold is the review of that roadmap, which sealed the declaration.\n\tif err == nil && identity.Kind == \"milestone\" && strings.HasPrefix(verification.ApprovalOrigin, \"declared:\") {\n\t\tverification, err = source.VerifyReviewBundle(\"roadmap:\" + identity.Slug)\n\t}\n\tif err != nil || !verification.Fresh || !verification.Approved || verification.Bundle == nil || verification.Attestation == nil || !source.sealedDeclarationHolds(verification.Bundle) {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-review-not-approved\"}\n\t}\n\tbundle := verification.Bundle\n\teligible := federatedSourceEvidenceEligibilityIn(files, source.Root, pinnedRevision, bundle.Payload.Subject.Head)\n\tif identity.Kind == \"spec\" {\n\t\tspec, err := source.GetSpec(identity.Slug)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":unavailable-artifact\"}\n\t\t}\n\t\ttargets, _, err := ParseDeliveryTargets(*spec)\n\t\tif err != nil || len(targets) == 0 {\n\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-target-missing\"}\n\t\t}\n\t\tprofiles, err := loadFederatedDeliveryProfiles(files, source.Root)\n\t\tif err != nil {\n\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-profile-unavailable\"}\n\t\t}\n\t\tblockers := []string{}\n\t\tfor _, target := range targets {\n\t\t\tprofile, ok := profiles[target.Profile]\n\t\t\tif !ok || profile.Kind != target.Kind {\n\t\t\t\tblockers = append(blockers, scope+\":source-delivery-profile-unsupported\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseen := map[string]bool{}\n\t\t\tfor _, evidence := range bundle.Payload.Evidence {\n\t\t\t\tif eligible(evidence) && moduleMatchesTarget(evidence.Module, target.Module) {\n\t\t\t\t\tseen[evidence.EvidenceClass] = true\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor _, required := range profile.RequiredEvidenceClasses {\n\t\t\t\tif !seen[required] {\n\t\t\t\t\tblockers = append(blockers, scope+\":source-delivery-evidence-missing:\"+target.Ref+\":\"+required)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif len(profile.AnyEvidenceClasses) > 0 {\n\t\t\t\tfound := false\n\t\t\t\tfor _, class := range profile.AnyEvidenceClasses {\n\t\t\t\t\tfound = found || seen[class]\n\t\t\t\t}\n\t\t\t\tif !found {\n\t\t\t\t\tblockers = append(blockers, scope+\":source-delivery-evidence-missing:\"+target.Ref+\":one-of\")\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tproof := federatedBundleEvidence(files, bundle, eligible)\n\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, proof, uniqueSorted(blockers)\n\t}\n\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, federatedBundleEvidence(files, bundle, eligible), nil\n}\n\n// A fresh approved source bundle already checked provenance. A carried result\n// can additionally prove delivery only if it ran after the reviewed subject\n// and belongs to the pinned source history. An earlier or unknown result never\n// observed the implementation being federated.\nfunc federatedSourceEvidenceEligibility(root, pinnedHead, subjectHead string) func(ReviewBundleEvidence) bool {\n\treturn federatedSourceEvidenceEligibilityIn(NativeFiles(), root, pinnedHead, subjectHead)\n}\n\nfunc federatedSourceEvidenceEligibilityIn(files Files, root, pinnedHead, subjectHead string) func(ReviewBundleEvidence) bool {\n\tancestry := map[string]bool{}\n\treturn func(evidence ReviewBundleEvidence) bool {\n\t\tif evidence.Outcome != \"pass\" {\n\t\t\treturn false\n\t\t}\n\t\tif evidence.SubjectObservation == \"observed\" {\n\t\t\treturn true\n\t\t}\n\t\tif evidence.SubjectObservation != \"carried-forward\" || evidence.SubjectDigest != \"\" || evidence.ProvenanceDigest == \"\" ||\n\t\t\t!isGitRevision(subjectHead) || !isGitRevision(evidence.GitHead) || !isGitRevision(pinnedHead) {\n\t\t\treturn false\n\t\t}\n\t\tif allowed, ok := ancestry[evidence.GitHead]; ok {\n\t\t\treturn allowed\n\t\t}\n\t\tallowed := federatedGitAncestorIn(files, root, subjectHead, evidence.GitHead) &&\n\t\t\tfederatedGitAncestorIn(files, root, evidence.GitHead, pinnedHead)\n\t\tancestry[evidence.GitHead] = allowed\n\t\treturn allowed\n\t}\n}\n\nfunc localFederatedScope(identity ArtifactRef) string {\n\tif identity.Kind == \"milestone\" {\n\t\treturn \"milestone:\" + identity.Slug + \"/\" + identity.Milestone\n\t}\n\treturn identity.Kind + \":\" + identity.Slug\n}\n\nfunc federatedBundleEvidence(files Files, bundle *ReviewBundle, eligible func(ReviewBundleEvidence) bool) []FederatedDependencyEvidence {\n\tevidence := []FederatedDependencyEvidence{}\n\tfor _, item := range bundle.Payload.Evidence {\n\t\tif eligible(item) {\n\t\t\tevidence = append(evidence, FederatedDependencyEvidence{ID: item.ID, Check: item.Check, EvidenceClass: item.EvidenceClass, SubjectObservation: item.SubjectObservation})\n\t\t}\n\t}\n\tsort.Slice(evidence, func(i, j int) bool {\n\t\tif evidence[i].EvidenceClass != evidence[j].EvidenceClass {\n\t\t\treturn evidence[i].EvidenceClass < evidence[j].EvidenceClass\n\t\t}\n\t\treturn evidence[i].ID < evidence[j].ID\n\t})\n\treturn evidence\n}\n\nfunc loadFederatedDeliveryProfiles(files Files, root string) (map[string]DeliveryProfile, error) {\n\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\"))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar matrix struct {\n\t\tDeliveryProfiles map[string]DeliveryProfile `json:\"deliveryProfiles\"`\n\t}\n\tif err := json.Unmarshal(raw, &matrix); err != nil || len(matrix.DeliveryProfiles) == 0 {\n\t\treturn nil, fmt.Errorf(\"unsupported delivery profile contract\")\n\t}\n\treturn matrix.DeliveryProfiles, nil\n}\n\nfunc federatedOwnershipConflicts(files Files, projectRoots map[string]Store, resolver ArtifactResolver) []string {\n\towners := map[string]string{}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '2640,2765p' pose-mcp/internal/pose/review_closeout.go; sed -n '3430,3515p' pose-mcp/internal/pose/review_bundle.go; rg -n 'func deepCopy|federatedSourceProof\\\\(|WithGovernanceRead|withGovernanceRead|operationFiles' pose-mcp/internal/pose/{federated_acceptance.go,review_bundle.go,review_closeout.go,governance_read_view.go,operation_files.go}; cat pose-mcp/internal/pose/review_trust_time.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '2640,2765p' pose-mcp/internal/pose/review_closeout.go; sed -n '3430,3515p' pose-mcp/internal/pose/review_bundle.go; rg -n 'func deepCopy|federatedSourceProof\\\\(|WithGovernanceRead|withGovernanceRead|operationFiles' pose-mcp/internal/pose/{federated_acceptance.go,review_bundle.go,review_closeout.go,governance_read_view.go,operation_files.go}; cat pose-mcp/internal/pose/review_trust_time.go\"","aggregated_output":"\tif !strings.HasPrefix(filepath.ToSlash(rel), \".pose/reports/\") {\n\t\trel = filepath.Join(\".pose\", \"reports\", rel)\n\t}\n\tpath := filepath.Join(root, rel)\n\tif err := validateProjectPathIn(files, root, rel); err != nil {\n\t\treturn fmt.Errorf(\"review evidence path escapes project root: %q: %w\", ref, err)\n\t}\n\tif _, err := files.Stat(path); err != nil {\n\t\treturn fmt.Errorf(\"review evidence does not resolve: %q\", ref)\n\t}\n\treturn nil\n}\n\nfunc (s Store) GetCloseoutState(ref string) (CloseoutState, error) {\n\treturn withGovernanceReviewReadView(s, \"closeout\", func(store Store) (CloseoutState, error) {\n\t\treturn store.getCloseoutState(ref, true)\n\t}, func(state *CloseoutState, metadata *ReadViewMetadata, audit governanceReadViewAudit) {\n\t\tapplyCloseoutReadView(state, metadata, ref, audit)\n\t})\n}\n\nfunc (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutState, error) {\n\ts = s.reviewOperation()\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn CloseoutState{}, err\n\t}\n\treview, err := s.ReviewCheck(ref)\n\tif err != nil {\n\t\treturn CloseoutState{}, err\n\t}\n\tstate := CloseoutState{SchemaVersion: ReviewSchemaVersion, Scope: ref, ScopeDigest: review.ScopeDigest, Review: review, LifecycleDone: true, Blockers: append([]string{}, review.Blockers...)}\n\tstate.VerificationBasis = \"applicable-review-contract\"\n\tif review.BundleID != \"\" {\n\t\tstate.VerificationBasis = \"sealed-review-contract\"\n\t}\n\tif !review.Required {\n\t\tstate.VerificationBasis = \"review-not-required-under-applicable-policy\"\n\t\tstate.Limitations = []string{\"Review is not required under the applicable policy/cutoff; this does not establish a historical execution receipt.\"}\n\t}\n\tvar diagnostics []Diagnostic\n\tfor _, blocker := range review.Blockers {\n\t\tdiagnostics = append(diagnostics, OpaqueDiagnostic(\"review-blocker\", DiagnosticCloseout, blocker))\n\t}\n\tblock := func(d Diagnostic) {\n\t\tdiagnostics = append(diagnostics, d)\n\t\tstate.Blockers = append(state.Blockers, d.Message)\n\t}\n\tchildStore := s\n\t// includeFederated=false already suppresses recursive acceptance. Keep the\n\t// authorized binding: clearing it makes a child borrow its parent's active\n\t// read view under a different Store context.\n\tswitch scope.Kind {\n\tcase \"spec\":\n\t\tsp, err := s.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tstate.LifecycleDone = sp.Status == \"done\"\n\t\t// A question the current bundle's adjudication says does not hold\n\t\t// blocks the closeout as it fails the lint (spec\n\t\t// pose-delegated-verdict-destinations R1; review round 1, B05).\n\t\tfor _, message := range s.adjudicationBlockers(scope.Slug) {\n\t\t\tblock(OpaqueDiagnostic(AdjudicationDoesNotHoldCode, DiagnosticCloseout, message))\n\t\t}\n\t\tif _, findings, historyErr := s.InspectAmendmentHistory(*sp); historyErr != nil {\n\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+historyErr.Error()))\n\t\t\tstate.Limitations = append(state.Limitations, \"Amendment history could not be verified; inspect and repair it explicitly.\")\n\t\t} else {\n\t\t\tfor _, finding := range findings {\n\t\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+finding))\n\t\t\t}\n\t\t}\n\tcase \"milestone\":\n\t\trm, err := s.GetRoadmap(scope.Roadmap)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tcloseoutAdopted, adoptErr := s.closeoutReviewPolicyAdopted()\n\t\tcloseoutAdopted = closeoutAdopted || adoptErr != nil\n\t\tvar found bool\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tif milestone.ID != scope.Milestone {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfound = true\n\t\t\tfor _, raw := range milestone.Specs {\n\t\t\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n\t\t\t\tif unresolved != \"\" {\n\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", unresolved, raw))\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif external {\n\t\t\t\t\tif s.FederatedResolver == nil {\n\t\t\t\t\t\tblock(NewDiagnostic(\"external-member-unaccepted\", \"external member \"+raw+\" needs federated acceptance\", raw))\n\t\t\t\t\t}\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tchild, err := childStore.getCloseoutState(\"spec:\"+slug, false)\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn state, err\n\t\t\t\t}\n\t\t\t\tstate.Children = append(state.Children, child)\n\t\t\t\t// A roadmap may declare why a terminal member owes this milestone\n\t\t\t\t// nothing, under the legacy rule only: under an adopted closeout\n\t\t\t\t// review policy a child that is not terminal always blocks\n\t\t\t\t// (review round 12, N38).\n\t\t\t\tif !child.Terminal && !(review.Approved && !closeoutAdopted && s.declaredUnreviewed(scope) != \"\") {\n\t\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\n\t\t\t\t}\n\t\t\t}\n\t\t\t// An exempt milestone has no review of its own to judge its exit\n\t\t\t// gate: an approved member review must have judged it as it reads\n\t\t\t// now, or the close is blocked; the review stays dispensed. This\n\t\t\t// holds for one member too: a done spec sealed before the gate\n\t\t\t// existed never gains it (review round 6, N21).\n\t\t\tif decision := review.CloseoutReview; decision != nil && !decision.Required && strings.TrimSpace(milestone.ExitGate) != \"\" && !review.Approved && !s.exitGateJudgedByMember(rm.Slug, milestone, state.Children) {\n\t\t\t\tblock(NewDiagnostic(\"milestone-exit-gate-unjudged\", \"the exit gate of \"+ref+\" is judged by no approved review: seal and review the member that carries it (the only member, or the last one once every other member is closed), or review the milestone itself (`pose review bundle \"+ref+\" --seal`)\", ref))\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t\tif !found {\n\t\t\treturn state, fmt.Errorf(\"pose: milestone %s/%s not found\", scope.Roadmap, scope.Milestone)\n\t\t}\n\tcase \"roadmap\":\n\t\trm, err := s.GetRoadmap(scope.Slug)\n\n// futureSchema reports well-formed JSON whose schema_version is one this engine does not read.\nfunc futureSchema(raw []byte) bool {\n\tvar header struct {\n\t\tSchemaVersion int `json:\"schema_version\"`\n\t}\n\tif json.Unmarshal(raw, &header) != nil {\n\t\treturn false\n\t}\n\treturn header.SchemaVersion > ReviewBundleSchemaVersion\n}\n\nfunc (s Store) VerifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tverification, err := s.verifyReviewBundle(scope)\n\tif err == nil && verification.Bundle != nil {\n\t\tassurance := s.DescribeReviewAssurance(*verification.Bundle, verification.Attestation)\n\t\tverification.Assurance = &assurance\n\t}\n\tif err == nil {\n\t\tverification.DelegatedRuns, verification.DelegatedHistoryLosses = s.reviewRunSummaries(scope)\n\t}\n\tif err == nil && verification.Bundle != nil {\n\t\tif round, rerr := s.ReviewRoundOf(*verification.Bundle); rerr != nil {\n\t\t\tverification.DelegatedHistoryLosses = append(verification.DelegatedHistoryLosses, \"the round cannot be derived: \"+rerr.Error())\n\t\t} else {\n\t\t\tverification.Round = round.Number\n\t\t\tpolicy, _, _, _ := s.LoadDelegationPolicy()\n\t\t\tif threshold := policy.Routing.RoundThresholdOf(); round.Number >= threshold {\n\t\t\t\tverification.Warnings = append(verification.Warnings, fmt.Sprintf(\"%s is in review round %d, at or past the round threshold %d: the rounds are not converging; consider a different agent or a human adjudication\", scope, round.Number, threshold))\n\t\t\t}\n\t\t}\n\t}\n\treturn verification, err\n}\n\n// verifyReviewBundle verifies scope once per operation of the same project and\n// resolver, and refuses a scope already being verified: sealed children are\n// data, and a cycle among them must end in a named refusal (spec\n// pose-review-approval-follows-children R6).\nfunc (s Store) verifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tstate := s.reviewReuse\n\tkey := fmt.Sprintf(\"%s\\x00%t\\x00%s\", s.Root, s.FederatedResolver != nil, scope)\n\tif result, ok := state.children[key]; ok {\n\t\treturn result.verification, result.err\n\t}\n\tif state.verifying[key] {\n\t\treturn ReviewBundleVerification{}, fmt.Errorf(\"pose: the sealed children of %s form a cycle\", scope)\n\t}\n\tstate.verifying[key] = true\n\tdefer delete(state.verifying, key)\n\tif s.onReviewVerify != nil {\n\t\ts.onReviewVerify(scope)\n\t}\n\tverification, err := s.proportionalReviewVerification(scope)\n\tstate.children[key] = childVerificationResult{verification, err}\n\treturn verification, err\n}\n\n// proportionalReviewVerification is the verification of a scope, and of a milestone that\n// owes no review of its own: one made of a single closed, approved spec, or one a roadmap\n// declares. Every reader of an approval comes through here, so they give one answer (ADR\n// a-milestone-of-one-member-is-that-member). A negative review recorded on it stands.\nfunc (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerification, error) {\n\tverification, err := s.proportionalReviewVerificationOf(scope)\n\tif err != nil || !verification.Approved || verification.State != \"closed\" {\n\t\treturn verification, err\n\t}\n\t// Under an adopted closeout review policy an aggregate scope is closed\n\t// only by its explicit close: an approval, its own, inherited or an\n\t// exemption, leaves it ready to close until its receipt stands. A scope\n\t// closed before adoption keeps its sealed reading (review round 9, N31).\n\tref, parseErr := ParseScopeRef(scope)\n\tif parseErr != nil || ref.Kind != \"milestone\" && ref.Kind != \"roadmap\" {\n\t\treturn verification, nil\n\t}\n\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || !adopted || s.closeoutScopeHistorical(ref) || s.milestoneClosedBeforeAdoption(ref) || s.receiptStandsFor(scope) {\n\t\treturn verification, nil\n\t}\n\tverification.State = \"ready-to-close\"\n\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope + \" (`pose close \" + scope + \"` publishes its closeout receipt)\"\n\treturn verification, nil\n}\n\nfunc (s Store) proportionalReviewVerificationOf(scope string) (ReviewBundleVerification, error) {\npose-mcp/internal/pose/federated_acceptance.go:518:\t\t\t\tbundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, proofBlockers := federatedSourceProof(s.fsys(), source, proven, resolved.Revision)\npose-mcp/internal/pose/federated_acceptance.go:720:func federatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\npose-mcp/internal/pose/governance_read_view.go:2608:func (s Store) withGovernanceReadView(view *governanceReadView, producer string) Store {\npose-mcp/internal/pose/review_closeout.go:488:\tstore := base.withGovernanceReadView(view, producer).PinIndexes()\npackage pose\n\nimport (\n\t\"strings\"\n\t\"time\"\n)\n\n// ReviewTrustTime separates an authenticated statement about historical time\n// from present trust and from the time admissibility of a new operation.\n// No local or issuer timestamp proves an observed historical authorization.\ntype ReviewTrustTime struct {\n\tTimeBasis               string   `json:\"time_basis\"`\n\tHistoricalAt            string   `json:\"historical_at,omitempty\"`\n\tCurrentBasis            string   `json:\"current_basis\"`\n\tHistoricalValidity      string   `json:\"historical_validity\"`\n\tCurrentValidity         string   `json:\"current_validity\"`\n\tCurrentTrust            string   `json:\"current_trust\"`\n\tHistoricalAuthorization string   `json:\"historical_authorization\"`\n\tHistoricalBlockers      []string `json:\"historical_blockers,omitempty\"`\n\tCurrentBlockers         []string `json:\"current_blockers,omitempty\"`\n}\n\nfunc (s Store) reviewClock() time.Time {\n\tif s.reviewTime != nil {\n\t\treturn *s.reviewTime\n\t}\n\treturn time.Now().UTC()\n}\n\nfunc (s Store) atReviewTime(now time.Time) Store {\n\tnow = now.UTC()\n\ts.reviewTime = &now\n\ts.reviewReuse = nil\n\treturn s\n}\n\n// VerifyReviewBundleAt supplies one explicit clock for all consumers of this\n// verification. It changes no stored record or authorization policy.\nfunc (s Store) VerifyReviewBundleAt(scope string, now time.Time) (ReviewBundleVerification, error) {\n\treturn s.atReviewTime(now).VerifyReviewBundle(scope)\n}\n\nfunc (s Store) reviewOperation() Store {\n\tif s.reviewTime == nil {\n\t\tnow := s.reviewClock()\n\t\ts.reviewTime = &now\n\t}\n\tif s.reviewReuse == nil {\n\t\ts.reviewReuse = newReviewReuseTraversal()\n\t}\n\treturn s\n}\n\n// A second-resolution historical timestamp represents [second, next-second).\n// Precision is not clock skew: fractional timestamps receive no tolerance.\nfunc reviewTimestampPrecision(raw string) time.Duration {\n\tif !strings.Contains(raw, \".\") && !strings.Contains(raw, \",\") {\n\t\treturn time.Second - time.Nanosecond\n\t}\n\treturn 0\n}\n\nfunc reviewClaimTimeBlockers(claim *ReviewAuthorityClaim, at time.Time, precision time.Duration) []string {\n\tif claim == nil {\n\t\treturn nil\n\t}\n\tblockers := []string{}\n\tissued, err := time.Parse(time.RFC3339Nano, claim.IssuedAt)\n\tif err != nil {\n\t\treturn []string{\"the authority claim has no valid issued_at\"}\n\t}\n\tif at.IsZero() {\n\t\treturn []string{\"authority time context is missing\"}\n\t}\n\tif issued.After(at.Add(precision)) {\n\t\tblockers = append(blockers, \"the authority claim issued_at is in the future of the applicable time context\")\n\t}\n\tif claim.ExpiresAt != \"\" {\n\t\texpiry, err := time.Parse(time.RFC3339Nano, claim.ExpiresAt)\n\t\tif err != nil {\n\t\t\tblockers = append(blockers, \"the authority claim has an unparseable expires_at\")\n\t\t} else {\n\t\t\tif expiry.Before(issued) {\n\t\t\t\tblockers = append(blockers, \"the authority claim expires before it was issued\")\n\t\t\t}\n\t\t\tif expiry.Before(at) {\n\t\t\t\tblockers = append(blockers, \"the authority claim expired at \"+claim.ExpiresAt)\n\t\t\t}\n\t\t}\n\t}\n\treturn blockers\n}\n\nfunc reviewNewOperationTimeBlockers(att ReviewAttestation, now time.Time) []string {\n\tblockers := reviewClaimTimeBlockers(att.Authority, now, 0)\n\tif att.Authority != nil {\n\t\tat, err := time.Parse(time.RFC3339Nano, att.AttestedAt)\n\t\tif err != nil {\n\t\t\tblockers = append(blockers, \"attested_at must be RFC3339\")\n\t\t} else if at.After(now) {\n\t\t\tblockers = append(blockers, \"attested_at is in the future of the operation\")\n\t\t}\n\t}\n\treturn blockers\n}\n\nfunc (s Store) reviewAuthorityTime(att ReviewAttestation) ReviewTrustTime {\n\tnow := s.reviewClock()\n\tout := ReviewTrustTime{TimeBasis: \"legacy-editable-attested-at\", HistoricalValidity: \"not-established\", CurrentValidity: \"not-evaluated\", CurrentTrust: \"not-verified\", HistoricalAuthorization: \"not-established\", HistoricalAt: att.AttestedAt, CurrentBasis: \"operation-clock\"}\n\tif att.Authority == nil && att.Envelope == nil {\n\t\treturn out\n\t}\n\tout.CurrentBlockers = reviewNewOperationTimeBlockers(att, now)\n\tif err := s.verifyStoredReviewAttestationSignature(att); err != nil || att.Envelope == nil {\n\t\tout.HistoricalBlockers = []string{\"historical claim lacks authenticated time under current issuer trust\"}\n\t\tout.CurrentBlockers = append(out.CurrentBlockers, out.HistoricalBlockers...)\n\t} else {\n\t\tout.CurrentTrust = \"trusted-under-current-pins\"\n\t\tout.TimeBasis = \"issuer-asserted-signed-attested-at\"\n\t\tat, err := time.Parse(time.RFC3339Nano, att.AttestedAt)\n\t\tif err != nil {\n\t\t\tout.HistoricalBlockers = []string{\"attested_at must be RFC3339\"}\n\t\t} else {\n\t\t\tif at.After(now) {\n\t\t\t\tout.HistoricalBlockers = append(out.HistoricalBlockers, \"signed attested_at is in the future of the verification context\")\n\t\t\t}\n\t\t\tout.HistoricalBlockers = append(out.HistoricalBlockers, reviewClaimTimeBlockers(att.Authority, at, reviewTimestampPrecision(att.AttestedAt))...)\n\t\t}\n\t\tif len(out.HistoricalBlockers) == 0 {\n\t\t\tout.HistoricalValidity = \"valid-claim\"\n\t\t} else {\n\t\t\tout.HistoricalValidity = \"invalid-claim\"\n\t\t}\n\t}\n\tif att.Authority == nil {\n\t\tout.CurrentValidity = \"not-evaluated\"\n\t} else if len(out.CurrentBlockers) == 0 {\n\t\tout.CurrentValidity = \"valid-claim\"\n\t} else {\n\t\tout.CurrentValidity = \"invalid-claim\"\n\t}\n\treturn out\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"The memo wrapper uses the existing lifecycle and concurrency controls. I’m checking whether its key covers every supported dependency and whether source verification stays inside the outer read view. Those are the main conditions for safely reusing a proof."}}
