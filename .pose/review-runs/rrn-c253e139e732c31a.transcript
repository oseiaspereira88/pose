{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'milestone|proven|source :=' pose-mcp/internal/pose/federated_acceptance.go; rg -n 'federated|D14|D15|ledger' .pose/knowledge --glob '*.md' --max-count 2; head -n 28 .pose/results/delivery-validation.json; tail -n 5 /var/tmp/closeout/ac-fp.out\"","aggregated_output":"277:// FederatedMilestoneAcceptance restricts roadmap acceptance to one milestone:\n278:// the roadmap's consumed outcomes, plus that milestone's predecessors, member\n279:// specs and consumed outcomes. Members of a later milestone do not gate an\n280:// earlier one, matching local milestone closeout, and the depends_on of the\n282:// a-milestone-answers-to-its-own-edges).\n283:func (s Store) FederatedMilestoneAcceptance(projectID, slug, milestone string, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, error) {\n284:\treturn s.milestoneAcceptance(projectID, slug, milestone, resolver, false)\n287:// milestoneAcceptance builds the acceptance of one milestone. roadmapDependencies\n290:func (s Store) milestoneAcceptance(projectID, slug, milestone string, resolver ArtifactResolver, roadmapDependencies bool) (FederatedRoadmapAcceptanceReport, error) {\n304:\t\tif candidate.ID == milestone {\n309:\t\treturn FederatedRoadmapAcceptanceReport{}, fmt.Errorf(\"pose: milestone %s not found in roadmap %s\", milestone, slug)\n311:\tcoordinator := ArtifactRef{Project: projectID, Kind: \"milestone\", Slug: slug, Milestone: milestone}\n407:\t\t// records it; a transferred artifact is proven at its canonical\n410:\t\tproven := identity\n412:\t\t\tproven = *resolved.CanonicalIdentity\n420:\t\tif selected, exists := snapshotRevisions[proven.Project]; exists && selected != \"\" && resolved.Revision != selected {\n422:\t\t} else if _, exists := snapshotRevisions[proven.Project]; !exists && resolved.Revision != \"\" {\n423:\t\t\tsnapshotRevisions[proven.Project] = resolved.Revision\n435:\t\tsource, sourceErr := resolver.Roots.StoreFor(proven.Project)\n442:\t\tsource = resolver.withSpecSnapshot(proven.Project, source)\n443:\t\tprojectRoots[proven.Project] = source\n444:\t\tsource.FederatedProjectID = proven.Project\n447:\t\tif err := verifyFederatedArtifactAtRevision(s.fsys(), source, proven, resolved); err != nil {\n458:\t\t// sealed milestone or roadmap. External dependencies retain the explicit\n460:\t\tif proven.Project == projectID {\n461:\t\t\tif stable := federatedArtifactLastChange(s.fsys(), source, proven); stable != \"\" {\n464:\t\t\t// Under an adopted closeout review policy a local milestone or\n468:\t\t\tif statusDone && graphValid && !s.indexMaterial && (proven.Kind == \"milestone\" || proven.Kind == \"roadmap\") {\n469:\t\t\t\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || adopted && !s.localScopeClosed(localFederatedScope(proven)) {\n474:\t\tif proven.Project != projectID {\n480:\t\t\tpin, pinErr := FederatedProjectTrustForIn(s.fsys(), source.Root, proven.Project)\n491:\t\t\t\taccepted, exists := policy.TrustedProjects[proven.Project]\n501:\t\t\t\t\tif proven.Project == item.parent {\n515:\t\t\taccepted, trusted := policy.TrustedProjects[proven.Project]\n518:\t\t\t\tbundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, proofBlockers := federatedSourceProof(s.fsys(), source, proven, resolved.Revision)\n530:\t\t\tqueue = append(queue, federatedQueuedRef{project: dep.Project, parent: proven.Project, raw: dep.String(), relationship: \"prerequisite\"})\n597:\t\t\tif kind == \"milestone\" {\n598:\t\t\t\traw = \"milestone:\" + rm.Slug + \"/\" + raw\n611:\tfor _, milestone := range rm.Milestones {\n612:\t\tfor _, ref := range milestone.After {\n613:\t\t\tadd(ref, \"milestone\", \"prerequisite\")\n615:\t\tfor _, ref := range milestone.Specs {\n618:\t\tfor _, ref := range milestone.Consumes {\n741:\t// A milestone or roadmap the source closed without its own review, under\n742:\t// its adopted closeout review policy, is proven by the receipt of that\n746:\tif receipt := state.CloseoutReceipt; receipt != nil && !receipt.Decision.Required && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n754:\t// A milestone its roadmap declares has no review of its own: what a consumer can\n756:\tif err == nil && identity.Kind == \"milestone\" && strings.HasPrefix(verification.ApprovalOrigin, \"declared:\") {\n811:// A fresh approved source bundle already checked provenance. A carried result\n843:\tif identity.Kind == \"milestone\" {\n844:\t\treturn \"milestone:\" + identity.Slug + \"/\" + identity.Milestone\n892:\t\t\tfor _, milestone := range roadmap.Milestones {\n893:\t\t\t\tfor _, raw := range milestone.Specs {\n.pose/knowledge/2026-10-27-handoff-delegation-mcp-round5.md:29:The attempt handle remains usable, continuation retains its attempt and ledger, and cancellation does not bypass budgets or create an approval. D4 defers starting tasks over MCP, while resume/handoff of existing tasks are delivered. D3 resolves an authorized unambiguous project using the common project-scope contract.\n.pose/knowledge/2026-10-27-handoff-delegation-mcp-round5.md:33:For F02, start or continue a synthetic run through MCP: observe attempt in the immediate response and run in wait. Align the public identity contract or allocate run identity at handback, with regressions for retries. For F03, cancel the invoking process after the active marker is visible and before handback; inspect ls/status, then wait for the same attempt to finish. Document recovery, correlation and checking the ledger before retrying. A transport cancellation is not delegate cancel. Re-review by 2026-11-26 or before changing handback identity/retry behavior.\n.pose/knowledge/archive/2026-09-24-handoff-multirepo-review-continuation.md:27:Qualified resolution, federated acceptance and authority transfer have fresh,\n.pose/knowledge/2026-10-27-handoff-delegated-rounds-legacy-status.md:37:Users of the deprecated status command miss round context; the deprecation hint already points to pose delegate ls. This does not turn partial output into a decision, alter the ledger, or bypass approval. Acceptance is limited to this low-severity presentation gap and its existing replacement.\n.pose/knowledge/2026-10-26-handoff-delegation-routing-round3.md:35:F08 may mislead a user choosing an agent, but does not establish a run proof or approval. F09 would enable fallbacks a caller explicitly disabled if a future writer used the helper on existing schema-2 policy. Neither requires changing the execution, ledger, containment or provenance contracts. R10 remains a shared detector delivery; actual task invocation belongs to pose-delegation-task and is not represented as executed here.\n.pose/knowledge/2026-10-26-handoff-delegation-observation-round4.md:31:- F-R3-09 (low): a reader racing back-to-back heartbeat rewrites can read \"ledger file changed while opening\" and list the marker as a loss (8 of 8 under 6 readers and 400 consecutive beats; 0 in 115k reads at a beat every 10ms; the real beat is every 10s).\n.pose/knowledge/2026-10-26-handoff-delegation-observation-round4.md:44:None of these changes dispatch, ledger, continuity, provenance or containment; each is either a disclosure gap, a test gap or a window of at most six minutes. F-R3-05 and F-R3-02 can leave an agent running after its supervisor died; the stalled state and `ls` name the run, and `pose delegate cancel` stops one that is still recorded.\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:44:2026-08-03, for #7; `pose-artifact-provenance-ledger`, 2026-08-03, for #8;\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md:73:  (as `pose-artifact-provenance-ledger` and `pose-delivery-surface-assurance`\n{\n  \"schema_version\": 1,\n  \"generated_at\": \"2026-11-17T04:57:22Z\",\n  \"mode\": \"strict\",\n  \"git_head\": \"728fa45ce8629b4df572fc76b71633301dbcb540\",\n  \"matrix_sha256\": \"sha256:03d5b4082f374b4bed497ea4b018076986e750b83b6695a0f917f0fcc7c0adaa\",\n  \"provenance_digest\": \"sha256:d4a24a8bb5530d75e22b4545914962851d08293c48a7c7600d90e0f245d4f22c\",\n  \"scope_provenance\": {\n    \"artifact-claims-stop-at-the-section-end\": \"sha256:c0083ea34012c3ec78814d53d3bdb83918132e90f23fee8ff51903aee8672622\",\n    \"calendar-dates-tolerate-utc-stamping\": \"sha256:36f9125ec27177733affb1bfac1d5dddc2a61a6e2bddbabca5207aad9946e5d6\",\n    \"check-builds-the-delivery-graph-once\": \"sha256:3174d521faa7402018e6ae4d4997e54e202161c3ecce5b4b201fe562d4f9aa62\",\n    \"check-strict-verdict-names-its-mode\": \"sha256:1d9cc42d870578aa5ff51c90731ae7223b3eb557274ea068c64cb0a52474dc56\",\n    \"check-worker-count-is-the-machines\": \"sha256:04c5a4dff210561c33a4962d03260fbe182590395502b6934e4c6706aa761737\",\n    \"parse-the-delivery-index-once-per-content\": \"sha256:ae5d8b0932f1af046d6e11de948b778462600aa90e4145c9d7ed1fdcffea1534\",\n    \"pose-abm-atomic-start\": \"sha256:e36e11646857b79bce10a0a54b0af05d244ff4df24180718e67459e5f0c10436\",\n    \"pose-abm-authority-fixture-clock\": \"sha256:793fc700f81bcdac8f31e00d63a0cf98e5dcebe6d72559a27fedf1cd260ce6c0\",\n    \"pose-abm-capability-adoption\": \"sha256:04e3cb5db413fc18b0baef48b3630f3c1257a8a903a2e36d57356070e60be103\",\n    \"pose-abm-causality-attestation\": \"sha256:7c5fdcb4edbc392f77c3de2b1f7eadad80504b114707eec6d7e44cc0f89b8bdc\",\n    \"pose-abm-contract-nodes\": \"sha256:88784d154e5604fd7bb149493eb3aafd5ac54613a141b4dc083de223a8100668\",\n    \"pose-abm-design-basis\": \"sha256:a5fa00e4dd51215ffb9fc26d873c711f8e6be339f35935d48c48576ff9aa9d3b\",\n    \"pose-abm-doctor-state-health\": \"sha256:faa9dc97bfd45df22f0fbc3574f4b9e686f7abe0b4c380a7eed898a946fdbabb\",\n    \"pose-abm-governance-outcomes\": \"sha256:c1703a642f5dd8690d56c218deb25a8ec2c0b5ab9c9c1fdb811375004a28e62e\",\n    \"pose-abm-progressive-review\": \"sha256:4b4472df2e2712be2cadc2712e61dc3c1199c344d487ca7471e0d4496728ce89\",\n    \"pose-abm-remediation-lineage\": \"sha256:34584ce713f0f22e450df9b82c61805ee77f5f037b2f73ad5355cc8b40ee5086\",\n    \"pose-abm-retrospective-replay\": \"sha256:ac184c3e0546d73bd586e003e98940814c19dad49928d7cefe05f3a04b67b56d\",\n    \"pose-abm-review-authority\": \"sha256:196496f3cfd6237384e9a68c224b91546e813e648966438b9c4bec19deae1708\",\n    \"pose-abm-review-soundness\": \"sha256:03523cce6221c7f8df0bb840103ad80fb991bf70155a9790eabc4a56e351146a\",\n    \"pose-abm-review-soundness-residuals\": \"sha256:75273c57646bca8a2f2d2d559263d65586f89b2cbde342b8bd5168ce0807ae31\",\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n[!] warning orphan pose-mcp/internal/cli/docs_sync_test.go\n    governed tracked path has no spec provenance claim\n    fix: backfill an explicit claim or add an exact reviewed exclusion\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '470,535p' pose-mcp/internal/pose/review_closeout.go; sed -n '95,175p' pose-mcp/internal/pose/cache_size.go; cat pose-mcp/internal/pose/review_ledger_memo_test.go; rg -n 'Milestone|milestone' pose-mcp/internal/pose/artifact_ref.go; rg -n 'func .*StoreFor|governanceStores' pose-mcp/internal/pose/roots.go; sed -n '2660,2715p' pose-mcp/internal/pose/governance_read_view.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '470,535p' pose-mcp/internal/pose/review_closeout.go; sed -n '95,175p' pose-mcp/internal/pose/cache_size.go; cat pose-mcp/internal/pose/review_ledger_memo_test.go; rg -n 'Milestone|milestone' pose-mcp/internal/pose/artifact_ref.go; rg -n 'func .*StoreFor|governanceStores' pose-mcp/internal/pose/roots.go; sed -n '2660,2715p' pose-mcp/internal/pose/governance_read_view.go\"","aggregated_output":"\t// adopted closeout review policy; CloseRequired says the scope is\n\t// eligible but still owes that close (spec\n\t// pose-closeout-review-policy-by-cost-benefit R4).\n\tCloseoutReceipt *CloseoutReceipt `json:\"closeout_receipt,omitempty\"`\n\tCloseRequired   bool             `json:\"close_required,omitempty\"`\n}\n\nfunc withGovernanceReviewReadView[T any](s Store, producer string, run func(Store) (T, error), attach func(*T, *ReadViewMetadata, governanceReadViewAudit)) (T, error) {\n\tif governanceReviewReadViewFromFiles(s.fsys()) != nil {\n\t\t// A closeout call may invoke ReviewCheck and child closeouts. They all\n\t\t// participate in the caller's active view; only its owner finalizes it.\n\t\treturn run(s)\n\t}\n\treturn withGovernanceReviewReadViewAttempt(s, producer, 0, run, attach)\n}\n\nfunc withGovernanceReviewReadViewAttempt[T any](s Store, producer string, attempt int, run func(Store) (T, error), attach func(*T, *ReadViewMetadata, governanceReadViewAudit)) (T, error) {\n\tbase, view := s.beginGovernanceReadView()\n\tstore := base.withGovernanceReadView(view, producer).PinIndexes()\n\t_, _ = captureGovernanceSourceRevision(store.fsys(), store.Root, producer)\n\tresult, operationErr := run(store)\n\taudit := view.audit()\n\tif attempt == 0 && governanceReviewAuditChanged(audit) {\n\t\t// Discard the complete mixed attempt. Re-run once from a new view;\n\t\t// the second attempt's changed or unknown closure remains visible.\n\t\treturn withGovernanceReviewReadViewAttempt(base.withoutGovernanceReadView(), producer, 1, run, attach)\n\t}\n\tmetadata := governanceReviewReadViewMetadata(store, view, audit)\n\tattach(&result, &metadata, audit)\n\treturn result, operationErr\n}\n\nfunc governanceReviewAuditChanged(audit governanceReadViewAudit) bool {\n\tif len(audit.ChangedPaths) > 0 {\n\t\treturn true\n\t}\n\tfor _, changed := range audit.ChangedProducers {\n\t\tif changed {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc governanceReviewReadViewFromFiles(files Files) *governanceReadView {\n\tfor depth := 0; depth < maxGovernanceFilesWrappers; depth++ {\n\t\tfiles = FilesOrNative(files)\n\t\tif provider, ok := files.(interface{ GovernanceReadView() *governanceReadView }); ok {\n\t\t\tif view := provider.GovernanceReadView(); view != nil {\n\t\t\t\tview.mu.Lock()\n\t\t\t\tactive := !view.closed\n\t\t\t\tview.mu.Unlock()\n\t\t\t\tif active {\n\t\t\t\t\treturn view\n\t\t\t\t}\n\t\t\t\t// A Store escaped its read-only callback. Its finalized bytes cannot\n\t\t\t\t// serve as this operation's current input; let the caller unwrap it\n\t\t\t\t// and start a fresh operation over the original Files binding.\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t\tunderlying, ok := files.(interface{ UnderlyingFiles() Files })\n\t\tif !ok {\n\t\t\treturn nil\n\t\t}\n\t\tfiles = underlying.UnderlyingFiles()\n\n// deepCopyValue copies a value so that the copy shares no slice, map or pointer with\n// the original. It covers every field by construction, so a field added later is\n// isolated without anyone remembering it; the graph keeps a hand-written copy only\n// because it is hot, and a reflection test holds that copy to the same standard.\nfunc deepCopyValue[T any](in T) T {\n\tout := reflect.New(reflect.TypeOf(in)).Elem()\n\tcopyInto(out, reflect.ValueOf(in))\n\treturn out.Interface().(T)\n}\n\nfunc copyInto(dst, src reflect.Value) {\n\tswitch src.Kind() {\n\tcase reflect.Struct:\n\t\tfor i := 0; i < src.NumField(); i++ {\n\t\t\tif dst.Field(i).CanSet() {\n\t\t\t\tcopyInto(dst.Field(i), src.Field(i))\n\t\t\t}\n\t\t}\n\tcase reflect.Slice:\n\t\tif src.IsNil() {\n\t\t\treturn\n\t\t}\n\t\ts := reflect.MakeSlice(src.Type(), src.Len(), src.Len())\n\t\tfor i := 0; i < src.Len(); i++ {\n\t\t\tcopyInto(s.Index(i), src.Index(i))\n\t\t}\n\t\tdst.Set(s)\n\tcase reflect.Map:\n\t\tif src.IsNil() {\n\t\t\treturn\n\t\t}\n\t\tm := reflect.MakeMapWithSize(src.Type(), src.Len())\n\t\titer := src.MapRange()\n\t\tfor iter.Next() {\n\t\t\tval := reflect.New(src.Type().Elem()).Elem()\n\t\t\tcopyInto(val, iter.Value())\n\t\t\tm.SetMapIndex(iter.Key(), val)\n\t\t}\n\t\tdst.Set(m)\n\tcase reflect.Ptr:\n\t\tif src.IsNil() {\n\t\t\treturn\n\t\t}\n\t\tp := reflect.New(src.Type().Elem())\n\t\tcopyInto(p.Elem(), src.Elem())\n\t\tdst.Set(p)\n\tcase reflect.Interface:\n\t\tif src.IsNil() {\n\t\t\treturn\n\t\t}\n\t\tinner := reflect.New(src.Elem().Type()).Elem()\n\t\tcopyInto(inner, src.Elem())\n\t\tdst.Set(inner)\n\tdefault:\n\t\tdst.Set(src)\n\t}\n}\npackage pose\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n)\n\n// countLedgerComputations counts every computation of a memoized ledger\n// value by the kind of value (the key's first field).\nfunc countLedgerComputations(t *testing.T) func() map[string]int {\n\tt.Helper()\n\tvar mu sync.Mutex\n\tcounts := map[string]int{}\n\tkeys := map[string]int{}\n\toriginal := ledgerMemoComputed\n\tledgerMemoComputed = func(key string) {\n\t\tmu.Lock()\n\t\tcounts[strings.SplitN(key, \"\\x00\", 2)[0]]++\n\t\tkeys[key]++\n\t\tmu.Unlock()\n\t}\n\tt.Cleanup(func() { ledgerMemoComputed = original })\n\treturn func() map[string]int {\n\t\tmu.Lock()\n\t\tdefer mu.Unlock()\n\t\tout := map[string]int{}\n\t\tfor kind, n := range counts {\n\t\t\tout[kind] = n\n\t\t}\n\t\tfor key, n := range keys {\n\t\t\tif n > out[\"max-per-key\"] {\n\t\t\t\tout[\"max-per-key\"] = n\n\t\t\t}\n\t\t\t_ = key\n\t\t}\n\t\treturn out\n\t}\n}\n\nfunc ledgerOperation(t *testing.T, store Store) Store {\n\tt.Helper()\n\tbase, view := store.beginGovernanceReadView()\n\tif view == nil || view.operation == nil {\n\t\tt.Fatal(\"no read-view operation\")\n\t}\n\treturn base.withGovernanceReadView(view, \"review\")\n}\n\n// Spec pose-review-ledger-is-read-once-per-operation, R1 and R2: every\n// verification of an operation after the first is answered without reading\n// or checking the ledger again.\nfunc TestReviewLedgerIsReadOncePerOperation(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tscope := f.bundle.Payload.Scope.Ref\n\tcounts := countLedgerComputations(t)\n\tscoped := ledgerOperation(t, f.store)\n\tfirst, err := scoped.VerifyReviewBundle(scope)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tafterFirst := counts()\n\tfor i := 0; i < 3; i++ {\n\t\tif _, err := scoped.VerifyReviewBundle(scope); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif _, _, err := scoped.ReadReviewRuns(run.BundleID); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tafter := counts()\n\tif afterFirst[\"review-runs\"] == 0 || afterFirst[\"transcript\"] == 0 || afterFirst[\"bundle-header\"] == 0 {\n\t\tt.Fatalf(\"the first verification read no ledger: %v\", afterFirst)\n\t}\n\tif after[\"max-per-key\"] != 1 || !reflect.DeepEqual(after, afterFirst) {\n\t\tt.Fatalf(\"later verifications read the ledger again: first %v, after %v\", afterFirst, after)\n\t}\n\tif !first.Approved {\n\t\tt.Fatalf(\"the fixture's verification is not approved: %v\", first.Blockers)\n\t}\n}\n\n// R3: a store with no read-view operation reads the ledger on every call.\nfunc TestReviewLedgerWithoutAnOperationIsReadEveryTime(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tcounts := countLedgerComputations(t)\n\tfor i := 0; i < 2; i++ {\n\t\tif _, _, err := f.store.ReadReviewRuns(run.BundleID); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif got := counts()[\"review-runs\"]; got != 2 {\n\t\tt.Fatalf(\"review runs read %d times without an operation, want 2\", got)\n\t}\n}\n\n// R4: the answers are the same with and without the memo, a lost record and\n// a caller that changes what it was given included.\nfunc TestReviewLedgerMemoAnswersAsAFreshRead(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tscope := f.bundle.Payload.Scope.Ref\n\tbroken := filepath.Join(f.store.Root, filepath.FromSlash(reviewRunsDir), \"rrn-0000000000000000.json\")\n\tif err := os.WriteFile(broken, []byte(\"{not json\"), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfreshRuns, freshLost, freshErr := f.store.ReadReviewRuns(run.BundleID)\n\tfreshAtt, freshAttErr := f.store.ReadReviewAttestations(run.BundleID)\n\tfresh, freshVerifyErr := f.store.VerifyReviewBundle(scope)\n\tscoped := ledgerOperation(t, f.store)\n\tfor i := 0; i < 2; i++ {\n\t\truns, lost, err := scoped.ReadReviewRuns(run.BundleID)\n\t\tif !reflect.DeepEqual(runs, freshRuns) || !reflect.DeepEqual(lost, freshLost) || (err == nil) != (freshErr == nil) {\n\t\t\tt.Fatalf(\"read %d: runs or losses differ from a fresh read: lost %v, want %v\", i, lost, freshLost)\n\t\t}\n\t\tif len(runs) > 0 {\n\t\t\truns[0].RunID = \"changed by the caller\"\n\t\t}\n\t\tatt, attErr := scoped.ReadReviewAttestations(run.BundleID)\n\t\tif !reflect.DeepEqual(att, freshAtt) || (attErr == nil) != (freshAttErr == nil) {\n\t\t\tt.Fatalf(\"read %d: attestations differ from a fresh read\", i)\n\t\t}\n\t\tif len(att.Attestations) > 0 {\n\t\t\tatt.Attestations[0].BundleID = \"changed by the caller\"\n\t\t}\n\t\tverification, err := scoped.VerifyReviewBundle(scope)\n\t\tif verification.Approved != fresh.Approved || verification.Fresh != fresh.Fresh || !reflect.DeepEqual(verification.Blockers, fresh.Blockers) || (err == nil) != (freshVerifyErr == nil) {\n\t\t\tt.Fatalf(\"read %d: verification differs from a fresh one: %v, want %v\", i, verification.Blockers, fresh.Blockers)\n\t\t}\n\t}\n\tif len(freshLost) == 0 {\n\t\tt.Fatal(\"the unreadable run was not reported as lost\")\n\t}\n}\n\n// Review F1: concurrent misses of one key in one operation compute once.\nfunc TestReviewLedgerMemoComputesOnceForConcurrentMisses(t *testing.T) {\n\tf, _ := approvedByARunThenDone(t)\n\tscoped := ledgerOperation(t, f.store)\n\tvar mu sync.Mutex\n\tcomputed := 0\n\trelease := make(chan struct{})\n\tvar wg sync.WaitGroup\n\tfor i := 0; i < 16; i++ {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tvalue, _, _ := memoizedLedgerRead(scoped.fsys(), \"concurrent\", func() (int, error) {\n\t\t\t\tmu.Lock()\n\t\t\t\tcomputed++\n\t\t\t\tmu.Unlock()\n\t\t\t\t<-release\n\t\t\t\treturn 7, nil\n\t\t\t})\n\t\t\tif value != 7 {\n\t\t\t\tt.Errorf(\"a waiter got %d\", value)\n\t\t\t}\n\t\t}()\n\t}\n\tclose(release)\n\twg.Wait()\n\tif computed != 1 {\n\t\tt.Fatalf(\"16 concurrent misses computed %d times, want 1\", computed)\n\t}\n}\n\n// Review F2 and F3: a caller that changes a nested field of what it was\n// given does not change a later answer, and an empty answer keeps its shape.\nfunc TestReviewLedgerMemoGivesIsolatedCopies(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tfreshAtt, _ := f.store.ReadReviewAttestations(run.BundleID)\n\tfreshNone, _ := f.store.ReadReviewAttestations(\"rvb-0000000000000000\")\n\tfreshRuns, _, _ := f.store.ReadReviewRuns(\"\")\n\tscoped := ledgerOperation(t, f.store)\n\tfor i := 0; i < 2; i++ {\n\t\tatt, _ := scoped.ReadReviewAttestations(run.BundleID)\n\t\tif !reflect.DeepEqual(att, freshAtt) {\n\t\t\tt.Fatalf(\"read %d: attestations differ from a fresh read\", i)\n\t\t}\n\t\tif len(att.Attestations) == 0 || len(att.Attestations[0].Criteria) == 0 {\n\t\t\tt.Fatal(\"the fixture's attestation has no criteria\")\n\t\t}\n\t\tatt.Attestations[0].Criteria[0].Disposition = \"changed by the caller\"\n\t\tnone, _ := scoped.ReadReviewAttestations(\"rvb-0000000000000000\")\n\t\tif !reflect.DeepEqual(none, freshNone) || (none.Attestations == nil) != (freshNone.Attestations == nil) {\n\t\t\tt.Fatalf(\"read %d: an empty answer changed shape: %#v, want %#v\", i, none.Attestations, freshNone.Attestations)\n\t\t}\n\t\truns, _, _ := scoped.ReadReviewRuns(\"\")\n\t\tif !reflect.DeepEqual(runs, freshRuns) {\n\t\t\tt.Fatalf(\"read %d: runs differ from a fresh read\", i)\n\t\t}\n\t\tif len(runs) > 0 {\n\t\t\truns[0].eventsBytes = append(runs[0].eventsBytes[:0:0], 'x')\n\t\t\truns[0].Argv = append(runs[0].Argv[:0:0], \"changed by the caller\")\n\t\t\tif len(runs[0].EnvRemoved) > 0 {\n\t\t\t\truns[0].EnvRemoved[0] = \"changed by the caller\"\n\t\t\t}\n\t\t\tif runs[0].Provenance != nil {\n\t\t\t\truns[0].Provenance.Project = \"changed by the caller\"\n\t\t\t}\n\t\t}\n\t}\n}\n\n// copyReviewRuns copies ReviewRun's unexported fields by name; a field added\n// later must be added there too.\nfunc TestCopyReviewRunsCoversEveryUnexportedField(t *testing.T) {\n\twant := map[string]bool{\"sessionForRedaction\": true, \"eventsBytes\": true, \"eventsDir\": true}\n\trunType := reflect.TypeOf(ReviewRun{})\n\tfor i := 0; i < runType.NumField(); i++ {\n\t\tfield := runType.Field(i)\n\t\tif !field.IsExported() && !want[field.Name] {\n\t\t\tt.Errorf(\"ReviewRun.%s is unexported and not copied by copyReviewRuns\", field.Name)\n\t\t}\n\t}\n}\n\n// Review F4: a kept value is not served once the operation's view is\n// finalized; the reader fails as a read through a finalized view does.\nfunc TestReviewLedgerMemoIsNotServedAfterTheOperationEnds(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tscoped := ledgerOperation(t, f.store)\n\tif _, _, err := scoped.ReadReviewRuns(run.BundleID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := scoped.ReadReviewAttestations(run.BundleID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tview, _ := governanceReadViewFromFiles(scoped.fsys())\n\tview.audit()\n\tif _, _, err := scoped.ReadReviewRuns(run.BundleID); !errors.Is(err, errGovernanceReadViewFinalized) {\n\t\tt.Fatalf(\"kept runs served after the operation ended: %v\", err)\n\t}\n\tif _, err := scoped.ReadReviewAttestations(run.BundleID); !errors.Is(err, errGovernanceReadViewFinalized) {\n\t\tt.Fatalf(\"kept attestations served after the operation ended: %v\", err)\n\t}\n}\n\n// Review N1 and N2: after the operation ends, a transcript check reports a\n// problem and a bundle header reports a read error, as reads would, instead\n// of an intact transcript or an unreported omission.\nfunc TestReviewLedgerMemoRefusalsStayVisible(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tscoped := ledgerOperation(t, f.store)\n\truns, _, err := scoped.ReadReviewRuns(run.BundleID)\n\tif err != nil || len(runs) == 0 {\n\t\tt.Fatalf(\"runs: %d %v\", len(runs), err)\n\t}\n\tif problem := scoped.reviewRunTranscriptIntact(runs[0]); problem != \"\" {\n\t\tt.Fatalf(\"the fixture's transcript is not intact: %s\", problem)\n\t}\n\tdir := filepath.Join(f.store.Root, \".pose\", \"review-bundles\")\n\tentries, err := os.ReadDir(dir)\n\tif err != nil || len(entries) == 0 {\n\t\tt.Fatalf(\"bundles: %v\", err)\n\t}\n\tif observation := readReviewBundleHeader(scoped.fsys(), dir, entries[0].Name()); observation.loss != nil {\n\t\tt.Fatalf(\"the fixture's bundle header has a loss: %+v\", observation.loss)\n\t}\n\tview, _ := governanceReadViewFromFiles(scoped.fsys())\n\tview.audit()\n\tif problem := scoped.reviewRunTranscriptIntact(runs[0]); problem == \"\" {\n\t\tt.Fatal(\"a transcript check after the operation ended reports an intact transcript\")\n\t}\n\tobservation := readReviewBundleHeader(scoped.fsys(), dir, entries[0].Name())\n\tif observation.loss == nil || observation.loss.Kind != LossReadError {\n\t\tt.Fatalf(\"a header read after the operation ended reports no read error: %+v\", observation)\n\t}\n}\n\n// Review N3: two producers that consume the ledger in one operation are both\n// attributed a change of it by the final audit.\nfunc TestReviewLedgerMemoAttributesEveryConsumingProducer(t *testing.T) {\n\tf, run := approvedByARunThenDone(t)\n\tbase, view := f.store.beginGovernanceReadView()\n\tfirst := base.withGovernanceReadView(view, \"producer-a\")\n\tsecond := base.withGovernanceReadView(view, \"producer-b\")\n\tfor _, s := range []Store{first, second} {\n\t\tif _, _, err := s.ReadReviewRuns(run.BundleID); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\trecord := filepath.Join(f.store.Root, filepath.FromSlash(run.Path))\n\traw, err := os.ReadFile(record)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(record, append(raw, ' '), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\taudit := view.audit()\n\tfor _, producer := range []string{\"producer-a\", \"producer-b\"} {\n\t\tif !audit.ChangedProducers[producer] {\n\t\t\tt.Errorf(\"the audit does not attribute the changed ledger to %s: %v\", producer, audit.ChangedProducers)\n\t\t}\n\t}\n}\n16:// local reference. Milestone identities retain their owning roadmap.\n21:\tMilestone string `json:\"milestone,omitempty\"`\n26:\tif r.Milestone != \"\" {\n27:\t\tlocal += \"/\" + r.Milestone\n60:\tcase \"milestone\":\n62:\t\tr.Slug, r.Milestone, ok = strings.Cut(raw, \"/\")\n63:\t\tif !ok || ValidateSlug(r.Milestone) != nil {\n278:\tcase \"roadmap\", \"milestone\":\n317:\t\t\tfor _, ms := range rm.Milestones {\n318:\t\t\t\tdeps = append(deps, \"milestone:\"+rm.Slug+\"/\"+ms.ID)\n321:\t\tif ref.Kind == \"milestone\" {\n323:\t\t\tfor _, ms := range rm.Milestones {\n324:\t\t\t\tif ms.ID != ref.Milestone {\n341:\t\t\t\t\t\tafter = \"milestone:\" + rm.Slug + \"/\" + after\n357:\t\t\t\tout.State = \"unknown-milestone\"\n63:\t// governanceStores is an operation-local overlay used when a multi-root\n65:\tgovernanceStores map[string]Store\n154:func (r *Roots) StoreFor(projectID string) (Store, error) {\n156:\tguarded, hasGuarded := r.governanceStores[projectID]\n\troots.mu.RUnlock()\n\top.mu.Lock()\n\trootMap, conflicts := op.initialRoots, op.initialConflicts\n\top.mu.Unlock()\n\treturn &Roots{\n\t\tcfg: cfg, byProject: rootMap, conflicts: conflicts, governanceStores: map[string]Store{},\n\t\tlastScan: time.Now(), rescanWindow: time.Duration(1 << 62), fs: files,\n\t}\n}\n\ntype readViewFile struct {\n\treader  *bytes.Reader\n\tinfo    fs.FileInfo\n\treadErr error\n}\n\nfunc newGovernanceReadFile(data []byte, info fs.FileInfo, readErrors ...error) *readViewFile {\n\tvar readErr error\n\tif len(readErrors) > 0 {\n\t\treadErr = readErrors[0]\n\t}\n\treturn &readViewFile{reader: bytes.NewReader(data), info: frozenInfo(info), readErr: readErr}\n}\nfunc (f *readViewFile) Stat() (fs.FileInfo, error) {\n\tif f.info == nil {\n\t\treturn nil, fs.ErrInvalid\n\t}\n\treturn f.info, nil\n}\nfunc (f *readViewFile) Read(p []byte) (int, error) {\n\tif f.reader.Len() == 0 && f.readErr != nil {\n\t\treturn 0, f.readErr\n\t}\n\tn, err := f.reader.Read(p)\n\tif err == nil && n > 0 && f.readErr != nil {\n\t\treturn n, f.readErr\n\t}\n\treturn n, err\n}\nfunc (*readViewFile) Close() error { return nil }\n\ntype readViewDirectoryFile struct {\n\tname     string\n\tproducer string\n\tentries  []fs.DirEntry\n\tinfo     fs.FileInfo\n\tcursor   int\n}\n\nfunc newGovernanceReadDirectoryFile(name, producer string, entries []fs.DirEntry, info fs.FileInfo) *readViewDirectoryFile {\n\treturn &readViewDirectoryFile{\n\t\tname: name, producer: producer, entries: cloneReadViewDirForProducer(entries, producer), info: frozenInfo(info),\n\t}\n}\n\nfunc (f *readViewDirectoryFile) Stat() (fs.FileInfo, error) {\n","exit_code":0,"status":"completed"}}
