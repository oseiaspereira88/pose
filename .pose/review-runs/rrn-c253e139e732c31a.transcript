{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '145,195p' pose-mcp/internal/pose/roots.go; sed -n '1,75p' pose-mcp/internal/pose/artifact_ref.go; rg -n 'milestone:.*[/]|Kind: \\\"milestone\\\"' pose-mcp/internal/pose/federated*test.go | head -n 30; rg -n '\\\"name\\\": \\\"(federated-source-proof|test|build)|\\\"status\\\"|\\\"outcome\\\"|\\\"exit_code\\\"' .pose/results/delivery-validation.json | tail -n 18; nl -ba pose-mcp/internal/pose/federated_acceptance.go | sed -n '716,733p'; git status --short\"","aggregated_output":"\t}\n}\n\n// StoreFor resolves the Store for a project_id. Empty -> default root (or a\n// distinct ProjectAmbiguousError when no default is configured, or, under\n// StrictSelection, when more than one project is registered). Known\n// project_id -> its root. An unknown id triggers one throttled rescan (a\n// project may have just been cloned) before returning ProjectUnknownError;\n// there is no silent fallback.\nfunc (r *Roots) StoreFor(projectID string) (Store, error) {\n\tr.mu.RLock()\n\tguarded, hasGuarded := r.governanceStores[projectID]\n\tr.mu.RUnlock()\n\tif hasGuarded {\n\t\treturn guarded, nil\n\t}\n\tif projectID == \"\" {\n\t\tif r.cfg.DefaultRoot == \"\" {\n\t\t\treturn Store{}, ProjectAmbiguousError{Reason: \"no-default\"}\n\t\t}\n\t\tif r.cfg.StrictSelection && r.registeredProjectCount() > 1 {\n\t\t\treturn Store{}, ProjectAmbiguousError{Reason: \"multi-project-implicit\"}\n\t\t}\n\t\treturn r.storeFor(r.cfg.DefaultProjectID, r.cfg.DefaultRoot), nil\n\t}\n\tr.mu.RLock()\n\troot, ok := r.byProject[projectID]\n\tconflict := r.conflicts[projectID]\n\tr.mu.RUnlock()\n\tif conflict {\n\t\treturn Store{}, ProjectBindingConflictError{ProjectID: projectID}\n\t}\n\tif !ok {\n\t\tr.maybeRescan()\n\t\tr.mu.RLock()\n\t\troot, ok = r.byProject[projectID]\n\t\tconflict = r.conflicts[projectID]\n\t\tr.mu.RUnlock()\n\t\tif conflict {\n\t\t\treturn Store{}, ProjectBindingConflictError{ProjectID: projectID}\n\t\t}\n\t}\n\tif !ok {\n\t\treturn Store{}, ProjectUnknownError{ProjectID: projectID}\n\t}\n\treturn r.storeFor(projectID, root), nil\n}\n\nfunc (r *Roots) registeredProjectCount() int {\n\tr.mu.RLock()\n\tdefer r.mu.RUnlock()\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n)\n\n// ArtifactRef is identity, not evidence. Project is empty only for an unbound\n// local reference. Milestone identities retain their owning roadmap.\ntype ArtifactRef struct {\n\tProject   string `json:\"project_id,omitempty\"`\n\tKind      string `json:\"kind\"`\n\tSlug      string `json:\"slug\"`\n\tMilestone string `json:\"milestone,omitempty\"`\n}\n\nfunc (r ArtifactRef) String() string {\n\tlocal := r.Kind + \":\" + r.Slug\n\tif r.Milestone != \"\" {\n\t\tlocal += \"/\" + r.Milestone\n\t}\n\tif r.Project != \"\" {\n\t\treturn \"xref:\" + r.Project + \"/\" + local\n\t}\n\treturn local\n}\n\n// ParseArtifactRef is the shared grammar for dependency and projection readers.\n// Never clean a path-like input: rejecting traversal is part of the contract.\nfunc ParseArtifactRef(raw string) (ArtifactRef, error) {\n\tr := ArtifactRef{Kind: \"spec\"}\n\tbad := func() (ArtifactRef, error) { return ArtifactRef{}, errors.New(\"invalid-artifact-reference\") }\n\tif len(raw) == 0 || len(raw) > 1024 || strings.TrimSpace(raw) != raw {\n\t\treturn bad()\n\t}\n\tif strings.HasPrefix(raw, \"xref:\") {\n\t\tvar ok bool\n\t\tr.Project, raw, ok = strings.Cut(strings.TrimPrefix(raw, \"xref:\"), \"/\")\n\t\tif !ok || ValidateSlug(r.Project) != nil {\n\t\t\treturn bad()\n\t\t}\n\t}\n\tif kind, rest, ok := strings.Cut(raw, \":\"); ok {\n\t\tr.Kind, raw = kind, rest\n\t}\n\tswitch r.Kind {\n\tcase \"spec\", \"roadmap\":\n\t\tr.Slug = raw\n\tcase \"project\":\n\t\t// The project itself, for obligations no spec owns (spec\n\t\t// pose-attention-projects-every-source).\n\t\tr.Slug = raw\n\tcase \"milestone\":\n\t\tvar ok bool\n\t\tr.Slug, r.Milestone, ok = strings.Cut(raw, \"/\")\n\t\tif !ok || ValidateSlug(r.Milestone) != nil {\n\t\t\treturn bad()\n\t\t}\n\tdefault:\n\t\treturn bad()\n\t}\n\tif ValidateSlug(r.Slug) != nil {\n\t\treturn bad()\n\t}\n\treturn r, nil\n}\n\n// ArtifactResolution intentionally contains no paths or artifact bodies. Digest\npose-mcp/internal/pose/federated_acceptance_test.go:154:\tfor _, scope := range []string{\"spec:backend\", \"milestone:component/core\", \"roadmap:component\"} {\npose-mcp/internal/pose/federated_acceptance_test.go:396:\tfor _, scope := range []string{\"spec:backend\", \"milestone:program/core\", \"roadmap:program\"} {\npose-mcp/internal/pose/federated_acceptance_test.go:834:\tif core.Manifest.Coordinator.String() != \"xref:coordinator/milestone:program/core\" {\npose-mcp/internal/pose/federated_acceptance_test.go:849:\tcloseout, err := store.GetCloseoutStateWithFederatedAcceptance(\"milestone:program/core\", \"coordinator\", resolver)\npose-mcp/internal/pose/federated_acceptance_test.go:853:\tlater, err := store.GetCloseoutStateWithFederatedAcceptance(\"milestone:program/later\", \"coordinator\", resolver)\npose-mcp/internal/pose/federated_acceptance_test.go:863:\trevoked, err := store.GetCloseoutStateWithFederatedAcceptance(\"milestone:program/core\", \"coordinator\", resolver)\npose-mcp/internal/pose/federated_acceptance_test.go:873:\tif _, err := store.PrepareReviewBundle(\"milestone:program/core\"); err != nil {\npose-mcp/internal/pose/federated_acceptance_test.go:882:\t\tif _, err := store.SealReviewBundleLead(\"milestone:program/core\", \"\", time.Now()); !errors.Is(err, ErrGovernanceWriteGuardBusy) {\npose-mcp/internal/pose/federated_acceptance_test.go:907:\tmilestone, err := store.SealReviewBundle(\"milestone:program/core\", now.Add(2*time.Minute))\npose-mcp/internal/pose/federated_acceptance_test.go:933:\tprojects, err := store.closeoutWriteProjectSet(\"milestone:program/core\")\npose-mcp/internal/pose/federated_acceptance_test.go:955:\t\treturn store.WithCloseoutWriteGuard(\"test.closeout\", \"milestone:program/core\", func(Store) error {\npose-mcp/internal/pose/federated_acceptance_test.go:967:\tleaseErr := store.WithCloseoutWriteGuard(\"test.closeout\", \"milestone:program/core\", func(guarded Store) error {\npose-mcp/internal/pose/federated_acceptance_test.go:1000:\tlegacy, err := store.prepareReviewBundle(\"milestone:program/core\", true)\npose-mcp/internal/pose/federated_acceptance_test.go:1022:\tfresh, err := store.VerifyReviewBundle(\"milestone:program/core\")\npose-mcp/internal/pose/federated_acceptance_test.go:1026:\tif current, err := store.CurrentReviewBundle(\"milestone:program/core\"); err != nil || current == nil || current.BundleID != legacy.BundleID {\npose-mcp/internal/pose/federated_acceptance_test.go:1030:\tif revoked, err := store.VerifyReviewBundle(\"milestone:program/core\"); err != nil || revoked.Fresh || revoked.Approved {\npose-mcp/internal/pose/federated_acceptance_test.go:1036:\tsealed, err := store.SealReviewBundle(\"milestone:program/core\", now)\npose-mcp/internal/pose/federated_acceptance_test.go:1044:\trenewed, err := store.VerifyReviewBundle(\"milestone:program/core\")\npose-mcp/internal/pose/federated_acceptance_test.go:1049:\tif revoked, err := store.VerifyReviewBundle(\"milestone:program/core\"); err != nil || revoked.Fresh || revoked.Approved {\npose-mcp/internal/pose/federated_acceptance_test.go:1062:\tplain, err := store.GetCloseoutState(\"milestone:program/core\")\npose-mcp/internal/pose/federated_acceptance_test.go:1073:\tfederated, err := store.GetCloseoutStateWithFederatedAcceptance(\"milestone:program/core\", \"coordinator\", resolver)\npose-mcp/internal/pose/federated_acceptance_test.go:1081:\tbundle, err := store.PrepareReviewBundle(\"milestone:program/core\")\npose-mcp/internal/pose/federated_acceptance_test.go:1090:\trevoked, err := store.GetCloseoutStateWithFederatedAcceptance(\"milestone:program/core\", \"coordinator\", resolver)\n5199:      \"outcome\": \"pass\",\n5218:      \"outcome\": \"pass\",\n5237:      \"outcome\": \"pass\",\n5257:      \"outcome\": \"pass\",\n5277:      \"outcome\": \"pass\",\n5299:      \"outcome\": \"pass\",\n5318:      \"outcome\": \"pass\",\n5337:      \"outcome\": \"pass\",\n5358:      \"outcome\": \"pass\",\n5379:      \"outcome\": \"pass\",\n5399:      \"outcome\": \"pass\",\n5419:      \"outcome\": \"pass\",\n5439:      \"outcome\": \"pass\",\n5459:      \"outcome\": \"pass\",\n5479:      \"outcome\": \"pass\",\n5500:      \"outcome\": \"pass\",\n5522:      \"outcome\": \"pass\",\n5542:      \"outcome\": \"pass\",\n   716\t// (64 proofs, 39 distinct, in one harne8 closeout); within one read-view\n   717\t// operation the answer is a function of that operation's reads, so it is\n   718\t// computed once per operation and producer, like the review ledger (spec\n   719\t// pose-federated-source-proof-is-computed-once-per-operation).\n   720\tfunc federatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\n   721\t\tkey := \"federated-source-proof\\x00\" + filepath.Clean(source.Root) + \"\\x00\" + identity.Project + \"\\x00\" + identity.Kind + \"\\x00\" + identity.Slug + \"\\x00\" + pinnedRevision\n   722\t\tresult, _, err := memoizedLedgerRead(files, key, func() (federatedSourceProofResult, error) {\n   723\t\t\tbundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, blockers := computeFederatedSourceProof(files, source, identity, pinnedRevision)\n   724\t\t\treturn federatedSourceProofResult{bundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, blockers}, nil\n   725\t\t})\n   726\t\tif err != nil {\n   727\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{localFederatedScope(identity) + \":source-proof-unavailable\"}\n   728\t\t}\n   729\t\tresult = deepCopyValue(result)\n   730\t\treturn result.BundleID, result.BundleDigest, result.SubjectDigest, result.PlanDigest, result.Contracts, result.Evidence, result.Blockers\n   731\t}\n   732\t\n   733\t// computeFederatedSourceProof reads the source's closeout state and review\n","exit_code":0,"status":"completed"}}
