{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016kvRfXWRXEwixRuSF2CcJY","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"os\"\n8\t\t\"os/exec\"\n9\t\t\"path/filepath\"\n10\t\t\"runtime\"\n11\t\t\"sort\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\t\"sync\"\n15\t\t\"testing\"\n16\t\t\"time\"\n17\t)\n18\t\n19\t// Spec pose-worktree-runtime-qos-and-measurement R8.\n20\t//\n21\t// The measurement of the optional runtime on a real repository. It runs only when\n22\t// POSE_RUNTIME_MEASURE names the output file, because it takes minutes and measures the\n23\t// repository it runs in. The samples, scenarios and thresholds below are fixed here and in the\n24\t// spec before any number is read; the test fails when a threshold is not met, and writes the\n25\t// figures either way.\n26\tconst (\n27\t\tmeasureColdSamples  = 3\n28\t\tmeasureWarmSamples  = 5\n29\t\tmeasureChurnSamples = 3\n30\t\tmeasureShortSamples = 10\n31\t\t// Thresholds (fixed before the first run).\n32\t\tthresholdWarmOverCold    = 0.60 // median warm run <= 0.6 x median cold run\n33\t\tthresholdChurnOverCold   = 0.80 // a restarted runtime inherits nothing: median >= 0.8 x cold\n34\t\tthresholdShortUnderHeavy = 3.0  // p95 of a short query under heavy load <= 3 x idle p95 ...\n35\t\tthresholdShortFloorMS    = 250  // ... or 250 ms, whichever is more\n36\t\tthresholdRSSMiB          = 1536 // resident set of the runtime after the warm runs\n37\t\tthresholdFallbackExtraMS = 500  // trying a runtime that is not there costs at most this\n38\t)\n39\t\n40\ttype measureReport struct {\n41\t\tEnvironment map[string]any     `json:\"environment\"`\n42\t\tScenarios   map[string][]int64 `json:\"scenarios_ms\"`\n43\t\tFigures     map[string]float64 `json:\"figures\"`\n44\t\tMetrics     map[string]int64   `json:\"runtime_metrics\"`\n45\t\tVerdicts    map[string]string  `json:\"verdicts\"`\n46\t}\n47\t\n48\tfunc measureMedian(v []int64) int64 {\n49\t\ts := append([]int64(nil), v...)\n50\t\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n51\t\treturn s[len(s)/2]\n52\t}\n53\t\n54\tfunc measureP95(v []int64) int64 {\n55\t\ts := append([]int64(nil), v...)\n56\t\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n57\t\ti := (len(s)*95 + 99) / 100\n58\t\tif i >= len(s) {\n59\t\t\ti = len(s) - 1\n60\t\t}\n61\t\treturn s[i]\n62\t}\n63\t\n64\tfunc TestMeasureTheRuntimeOnTheRealRepository(t *testing.T) {\n65\t\tout := os.Getenv(\"POSE_RUNTIME_MEASURE\")\n66\t\tif out == \"\" {\n67\t\t\tt.Skip(\"set POSE_RUNTIME_MEASURE=<output file> to measure the runtime on this repository\")\n68\t\t}\n69\t\trepo, err := filepath.Abs(\"../../..\")\n70\t\tif err != nil {\n71\t\t\tt.Fatal(err)\n72\t\t}\n73\t\tspec := os.Getenv(\"POSE_RUNTIME_MEASURE_SPEC\")\n74\t\tif spec == \"\" {\n75\t\t\tspec = \"spec:pose-governance-audit-skips-pure-git-reads\"\n76\t\t}\n77\t\tbin := filepath.Join(t.TempDir(), \"pose\")\n78\t\tif b, err := exec.Command(\"go\", \"build\", \"-o\", bin, \"../../cmd/pose\").CombinedOutput(); err != nil {\n79\t\t\tt.Fatalf(\"build: %v %s\", err, b)\n80\t\t}\n81\t\trtDir, _ := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rtm\")\n82\t\tdefer os.RemoveAll(rtDir)\n83\t\tenv := append(os.Environ(), \"POSE_RUNTIME_DIR=\"+rtDir+\"/r\")\n84\t\tfor _, drop := range []string{\"POSE_PROJECT_ROOT\", \"POSE_PROJECT_ROOTS\", \"POSE_DEFAULT_PROJECT_ID\", \"CLAUDECODE\"} {\n85\t\t\tenv = append(env, drop+\"=\")\n86\t\t}\n87\t\trun := func(args ...string) (string, int64, int) {\n88\t\t\tcmd := exec.Command(bin, args...)\n89\t\t\tcmd.Dir, cmd.Env = repo, env\n90\t\t\tvar o, e bytes.Buffer\n91\t\t\tcmd.Stdout, cmd.Stderr = &o, &e\n92\t\t\tstart := time.Now()\n93\t\t\terr := cmd.Run()\n94\t\t\tcode := 0\n95\t\t\tif ee, ok := err.(*exec.ExitError); ok {\n96\t\t\t\tcode = ee.ExitCode()\n97\t\t\t}\n98\t\t\treturn o.String() + \"\\x00\" + e.String(), time.Since(start).Milliseconds(), code\n99\t\t}\n100\t\truntimeRun := func(args ...string) (stdout string, ms int64, via string) {\n101\t\t\to, ms, _ := run(append([]string{\"runtime\", \"run\", \"--envelope\"}, args...)...)\n102\t\t\tvar doc struct {\n103\t\t\t\tVia, Stdout, Stderr string\n104\t\t\t}\n105\t\t\tdoc.Via = \"\"\n106\t\t\tvar raw map[string]any\n107\t\t\tif err := json.Unmarshal([]byte(strings.SplitN(o, \"\\x00\", 2)[0]), &raw); err != nil {\n108\t\t\t\tt.Fatalf(\"not an envelope: %q\", o)\n109\t\t\t}\n110\t\t\tvia, _ = raw[\"via\"].(string)\n111\t\t\tso, _ := raw[\"stdout\"].(string)\n112\t\t\tse, _ := raw[\"stderr\"].(string)\n113\t\t\treturn so + \"\\x00\" + se, ms, via\n114\t\t}\n115\t\trep := measureReport{Scenarios: map[string][]int64{}, Figures: map[string]float64{}, Verdicts: map[string]string{}}\n116\t\thead, _ := exec.Command(\"git\", \"-C\", repo, \"rev-parse\", \"HEAD\").Output()\n117\t\tcommits, _ := exec.Command(\"git\", \"-C\", repo, \"rev-list\", \"--count\", \"HEAD\").Output()\n118\t\tgitv, _ := exec.Command(\"git\", \"--version\").Output()\n119\t\tkernel, _ := os.ReadFile(\"/proc/sys/kernel/osrelease\")\n120\t\trep.Environment = map[string]any{\"cpus\": runtime.NumCPU(), \"gomaxprocs\": runtime.GOMAXPROCS(0), \"goos\": runtime.GOOS, \"goarch\": runtime.GOARCH,\n121\t\t\t\"go\": runtime.Version(), \"git\": strings.TrimSpace(string(gitv)), \"kernel\": strings.TrimSpace(string(kernel)), \"repo_head\": strings.TrimSpace(string(head)),\n122\t\t\t\"repo_commits\": strings.TrimSpace(string(commits)), \"check\": \"review-check \" + spec, \"short_query\": \"surface-check \" + spec,\n123\t\t\t\"samples\": map[string]int{\"cold\": measureColdSamples, \"warm\": measureWarmSamples, \"churn\": measureChurnSamples, \"short\": measureShortSamples}}\n124\t\n125\t\tfail := func(name, format string, a ...any) {\n126\t\t\trep.Verdicts[name] = \"FAIL: \" + fmt.Sprintf(format, a...)\n127\t\t\tt.Errorf(\"%s: \"+format, append([]any{name}, a...)...)\n128\t\t}\n129\t\tpass := func(name, format string, a ...any) { rep.Verdicts[name] = \"pass: \" + fmt.Sprintf(format, a...) }\n130\t\n131\t\t// S1: cold, standalone, a new process each time.\n132\t\tvar coldOut string\n133\t\tfor i := 0; i < measureColdSamples; i++ {\n134\t\t\to, ms, _ := run(\"review-check\", spec)\n135\t\t\tif i == 0 {\n136\t\t\t\tcoldOut = o\n137\t\t\t}\n138\t\t\trep.Scenarios[\"cold_standalone\"] = append(rep.Scenarios[\"cold_standalone\"], ms)\n139\t\t\tif o != coldOut {\n140\t\t\t\tt.Fatalf(\"standalone output changed between samples %d and 0\", i)\n141\t\t\t}\n142\t\t}\n143\t\tcold := measureMedian(rep.Scenarios[\"cold_standalone\"])\n144\t\n145\t\t// S2: asking for a runtime that is not there.\n146\t\tfor i := 0; i < measureColdSamples; i++ {\n147\t\t\to, ms, via := runtimeRun(\"review-check\", spec)\n148\t\t\trep.Scenarios[\"fallback_no_runtime\"] = append(rep.Scenarios[\"fallback_no_runtime\"], ms)\n149\t\t\tif via != \"standalone\" || o != coldOut {\n150\t\t\t\tt.Fatalf(\"a run with no runtime: via %q, same output %v\", via, o == coldOut)\n151\t\t\t}\n152\t\t}\n153\t\textra := measureMedian(rep.Scenarios[\"fallback_no_runtime\"]) - cold\n154\t\trep.Figures[\"fallback_extra_ms\"] = float64(extra)\n155\t\tif extra <= thresholdFallbackExtraMS {\n156\t\t\tpass(\"T6 fallback overhead\", \"%d ms <= %d ms\", extra, thresholdFallbackExtraMS)\n157\t\t} else {\n158\t\t\tfail(\"T6 fallback overhead\", \"%d ms > %d ms\", extra, thresholdFallbackExtraMS)\n159\t\t}\n160\t\n161\t\t// S3: resident, warm. The first run is the cold one inside the runtime; it is recorded apart.\n162\t\tif o, _, _ := run(\"runtime\", \"start\"); !strings.Contains(o, \"started\") {\n163\t\t\tt.Fatalf(\"start: %s\", o)\n164\t\t}\n165\t\tdefer run(\"runtime\", \"stop\")\n166\t\tfor i := 0; i < measureWarmSamples+1; i++ {\n167\t\t\to, ms, via := runtimeRun(\"review-check\", spec)\n168\t\t\tif via != \"runtime\" || o != coldOut {\n169\t\t\t\tt.Fatalf(\"a hosted run: via %q, same output as standalone %v\", via, o == coldOut)\n170\t\t\t}\n171\t\t\tif i == 0 {\n172\t\t\t\trep.Scenarios[\"resident_first\"] = []int64{ms}\n173\t\t\t} else {\n174\t\t\t\trep.Scenarios[\"resident_warm\"] = append(rep.Scenarios[\"resident_warm\"], ms)\n175\t\t\t}\n176\t\t}\n177\t\twarm := measureMedian(rep.Scenarios[\"resident_warm\"])\n178\t\trep.Figures[\"warm_over_cold\"] = float64(warm) / float64(cold)\n179\t\tif float64(warm) <= thresholdWarmOverCold*float64(cold) {\n180\t\t\tpass(\"T1 warm over cold\", \"%d ms / %d ms = %.2f <= %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n181\t\t} else {\n182\t\t\tfail(\"T1 warm over cold\", \"%d ms / %d ms = %.2f > %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n183\t\t}\n184\t\t// S5: short queries, idle then under a heavy check.\n185\t\tshortArgs := []string{\"surface-check\", spec}\n186\t\tshortStandalone, _, _ := run(shortArgs...)\n187\t\tfor i := 0; i < measureShortSamples; i++ {\n188\t\t\tso, ms, via := runtimeRun(shortArgs...)\n189\t\t\tif via != \"runtime\" || so != shortStandalone {\n190\t\t\t\tt.Fatalf(\"a short query went %s, same output as standalone %v\", via, so == shortStandalone)\n191\t\t\t}\n192\t\t\trep.Scenarios[\"short_idle\"] = append(rep.Scenarios[\"short_idle\"], ms)\n193\t\t}\n194\t\tvar wg sync.WaitGroup\n195\t\twg.Add(1)\n196\t\tgo func() { defer wg.Done(); runtimeRun(\"review-check\", spec) }()\n197\t\ttime.Sleep(1500 * time.Millisecond)\n198\t\tfor i := 0; i < measureShortSamples; i++ {\n199\t\t\tso, ms, via := runtimeRun(shortArgs...)\n200\t\t\tif via != \"runtime\" || so != shortStandalone {\n201\t\t\t\tt.Fatalf(\"a short query under load went %s, same output as standalone %v\", via, so == shortStandalone)\n202\t\t\t}\n203\t\t\trep.Scenarios[\"short_under_heavy\"] = append(rep.Scenarios[\"short_under_heavy\"], ms)\n204\t\t}\n205\t\twg.Wait()\n206\t\tidle, loaded := measureP95(rep.Scenarios[\"short_idle\"]), measureP95(rep.Scenarios[\"short_under_heavy\"])\n207\t\tbound := int64(thresholdShortUnderHeavy * float64(idle))\n208\t\tif bound < thresholdShortFloorMS {\n209\t\t\tbound = thresholdShortFloorMS\n210\t\t}\n211\t\trep.Figures[\"short_p95_idle_ms\"], rep.Figures[\"short_p95_under_heavy_ms\"] = float64(idle), float64(loaded)\n212\t\tif loaded <= bound {\n213\t\t\tpass(\"T3 short under heavy\", \"p95 %d ms <= %d ms (idle p95 %d ms)\", loaded, bound, idle)\n214\t\t} else {\n215\t\t\tfail(\"T3 short under heavy\", \"p95 %d ms > %d ms (idle p95 %d ms)\", loaded, bound, idle)\n216\t\t}\n217\t\t// Memory of the runtime after the warm runs and the concurrent phase.\n218\t\tstatus, _, _ := run(\"runtime\", \"status\", \"--json\")\n219\t\tvar st struct {\n220\t\t\tPID int `json:\"pid\"`\n221\t\t}\n222\t\t_ = json.Unmarshal([]byte(strings.SplitN(status, \"\\x00\", 2)[0]), &st)\n223\t\tif raw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(st.PID) + \"/status\"); err == nil {\n224\t\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n225\t\t\t\tif strings.HasPrefix(line, \"VmHWM:\") || strings.HasPrefix(line, \"VmRSS:\") {\n226\t\t\t\t\tf := strings.Fields(line)\n227\t\t\t\t\tkb, _ := strconv.ParseFloat(f[1], 64)\n228\t\t\t\t\trep.Figures[strings.TrimSuffix(f[0], \":\")+\"_mib\"] = kb / 1024\n229\t\t\t\t}\n230\t\t\t}\n231\t\t\tif mib := rep.Figures[\"VmHWM_mib\"]; mib <= thresholdRSSMiB {\n232\t\t\t\tpass(\"T4 runtime memory\", \"peak resident %.0f MiB <= %d MiB\", mib, thresholdRSSMiB)\n233\t\t\t} else {\n234\t\t\t\tfail(\"T4 runtime memory\", \"peak resident %.0f MiB > %d MiB\", mib, thresholdRSSMiB)\n235\t\t\t}\n236\t\t} else {\n237\t\t\trep.Verdicts[\"T4 runtime memory\"] = \"not measured: no /proc on this platform\"\n238\t\t}\n239\t\n240\t\tst2, _, _ := run(\"runtime\", \"status\", \"--json\")\n241\t\tvar full struct {\n242\t\t\tMetrics map[string]int64 `json:\"metrics\"`\n243\t\t}\n244\t\t_ = json.Unmarshal([]byte(strings.SplitN(st2, \"\\x00\", 2)[0]), &full)\n245\t\trep.Metrics = full.Metrics\n246\t\tif len(rep.Metrics) == 0 {\n247\t\t\tt.Fatalf(\"the runtime status carries no lane metrics: %s\", st2)\n248\t\t}\n249\t\n250\t\t// S4: a restart inherits nothing.\n251\t\tfor i := 0; i < measureChurnSamples; i++ {\n252\t\t\trun(\"runtime\", \"stop\")\n253\t\t\trun(\"runtime\", \"start\")\n254\t\t\to, ms, via := runtimeRun(\"review-check\", spec)\n255\t\t\tif via != \"runtime\" || o != coldOut {\n256\t\t\t\tt.Fatalf(\"a run after a restart: via %q, same output %v\", via, o == coldOut)\n257\t\t\t}\n258\t\t\trep.Scenarios[\"restart_then_run\"] = append(rep.Scenarios[\"restart_then_run\"], ms)\n259\t\t}\n260\t\tchurn := measureMedian(rep.Scenarios[\"restart_then_run\"])\n261\t\trep.Figures[\"churn_over_cold\"] = float64(churn) / float64(cold)\n262\t\tif float64(churn) >= thresholdChurnOverCold*float64(cold) {\n263\t\t\tpass(\"T2 restart inherits nothing\", \"%d ms / %d ms = %.2f >= %.2f\", churn, cold, float64(churn)/float64(cold), thresholdChurnOverCold)\n264\t\t} else {\n265\t\t\tfail(\"T2 restart inherits nothing\", \"%d ms / %d ms = %.2f < %.2f\", churn, cold, float64(churn)/float64(cold), thresholdChurnOverCold)\n266\t\t}\n267\t\tpass(\"T5 output\", \"every hosted run, the review-check and the short query idle and under load, printed exactly what the standalone run printed (%d and %d bytes)\", len(coldOut), len(shortStandalone))\n268\t\n269\t\traw, _ := json.MarshalIndent(rep, \"\", \"  \")\n270\t\tif err := os.WriteFile(out, append(raw, '\\n'), 0o644); err != nil {\n271\t\t\tt.Fatal(err)\n272\t\t}\n273\t}\n274\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"8bcef437-e989-4806-aa90-ccb4691d033d","timestamp":"2026-11-10T09:16:40.651Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-4170863541/worktree/pose-mcp/internal/cli/runtime_measure_test.go","content":"package cli\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\n// Spec pose-worktree-runtime-qos-and-measurement R8.\n//\n// The measurement of the optional runtime on a real repository. It runs only when\n// POSE_RUNTIME_MEASURE names the output file, because it takes minutes and measures the\n// repository it runs in. The samples, scenarios and thresholds below are fixed here and in the\n// spec before any number is read; the test fails when a threshold is not met, and writes the\n// figures either way.\nconst (\n\tmeasureColdSamples  = 3\n\tmeasureWarmSamples  = 5\n\tmeasureChurnSamples = 3\n\tmeasureShortSamples = 10\n\t// Thresholds (fixed before the first run).\n\tthresholdWarmOverCold    = 0.60 // median warm run <= 0.6 x median cold run\n\tthresholdChurnOverCold   = 0.80 // a restarted runtime inherits nothing: median >= 0.8 x cold\n\tthresholdShortUnderHeavy = 3.0  // p95 of a short query under heavy load <= 3 x idle p95 ...\n\tthresholdShortFloorMS    = 250  // ... or 250 ms, whichever is more\n\tthresholdRSSMiB          = 1536 // resident set of the runtime after the warm runs\n\tthresholdFallbackExtraMS = 500  // trying a runtime that is not there costs at most this\n)\n\ntype measureReport struct {\n\tEnvironment map[string]any     `json:\"environment\"`\n\tScenarios   map[string][]int64 `json:\"scenarios_ms\"`\n\tFigures     map[string]float64 `json:\"figures\"`\n\tMetrics     map[string]int64   `json:\"runtime_metrics\"`\n\tVerdicts    map[string]string  `json:\"verdicts\"`\n}\n\nfunc measureMedian(v []int64) int64 {\n\ts := append([]int64(nil), v...)\n\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n\treturn s[len(s)/2]\n}\n\nfunc measureP95(v []int64) int64 {\n\ts := append([]int64(nil), v...)\n\tsort.Slice(s, func(i, j int) bool { return s[i] < s[j] })\n\ti := (len(s)*95 + 99) / 100\n\tif i >= len(s) {\n\t\ti = len(s) - 1\n\t}\n\treturn s[i]\n}\n\nfunc TestMeasureTheRuntimeOnTheRealRepository(t *testing.T) {\n\tout := os.Getenv(\"POSE_RUNTIME_MEASURE\")\n\tif out == \"\" {\n\t\tt.Skip(\"set POSE_RUNTIME_MEASURE=<output file> to measure the runtime on this repository\")\n\t}\n\trepo, err := filepath.Abs(\"../../..\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tspec := os.Getenv(\"POSE_RUNTIME_MEASURE_SPEC\")\n\tif spec == \"\" {\n\t\tspec = \"spec:pose-governance-audit-skips-pure-git-reads\"\n\t}\n\tbin := filepath.Join(t.TempDir(), \"pose\")\n\tif b, err := exec.Command(\"go\", \"build\", \"-o\", bin, \"../../cmd/pose\").CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"build: %v %s\", err, b)\n\t}\n\trtDir, _ := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rtm\")\n\tdefer os.RemoveAll(rtDir)\n\tenv := append(os.Environ(), \"POSE_RUNTIME_DIR=\"+rtDir+\"/r\")\n\tfor _, drop := range []string{\"POSE_PROJECT_ROOT\", \"POSE_PROJECT_ROOTS\", \"POSE_DEFAULT_PROJECT_ID\", \"CLAUDECODE\"} {\n\t\tenv = append(env, drop+\"=\")\n\t}\n\trun := func(args ...string) (string, int64, int) {\n\t\tcmd := exec.Command(bin, args...)\n\t\tcmd.Dir, cmd.Env = repo, env\n\t\tvar o, e bytes.Buffer\n\t\tcmd.Stdout, cmd.Stderr = &o, &e\n\t\tstart := time.Now()\n\t\terr := cmd.Run()\n\t\tcode := 0\n\t\tif ee, ok := err.(*exec.ExitError); ok {\n\t\t\tcode = ee.ExitCode()\n\t\t}\n\t\treturn o.String() + \"\\x00\" + e.String(), time.Since(start).Milliseconds(), code\n\t}\n\truntimeRun := func(args ...string) (stdout string, ms int64, via string) {\n\t\to, ms, _ := run(append([]string{\"runtime\", \"run\", \"--envelope\"}, args...)...)\n\t\tvar doc struct {\n\t\t\tVia, Stdout, Stderr string\n\t\t}\n\t\tdoc.Via = \"\"\n\t\tvar raw map[string]any\n\t\tif err := json.Unmarshal([]byte(strings.SplitN(o, \"\\x00\", 2)[0]), &raw); err != nil {\n\t\t\tt.Fatalf(\"not an envelope: %q\", o)\n\t\t}\n\t\tvia, _ = raw[\"via\"].(string)\n\t\tso, _ := raw[\"stdout\"].(string)\n\t\tse, _ := raw[\"stderr\"].(string)\n\t\treturn so + \"\\x00\" + se, ms, via\n\t}\n\trep := measureReport{Scenarios: map[string][]int64{}, Figures: map[string]float64{}, Verdicts: map[string]string{}}\n\thead, _ := exec.Command(\"git\", \"-C\", repo, \"rev-parse\", \"HEAD\").Output()\n\tcommits, _ := exec.Command(\"git\", \"-C\", repo, \"rev-list\", \"--count\", \"HEAD\").Output()\n\tgitv, _ := exec.Command(\"git\", \"--version\").Output()\n\tkernel, _ := os.ReadFile(\"/proc/sys/kernel/osrelease\")\n\trep.Environment = map[string]any{\"cpus\": runtime.NumCPU(), \"gomaxprocs\": runtime.GOMAXPROCS(0), \"goos\": runtime.GOOS, \"goarch\": runtime.GOARCH,\n\t\t\"go\": runtime.Version(), \"git\": strings.TrimSpace(string(gitv)), \"kernel\": strings.TrimSpace(string(kernel)), \"repo_head\": strings.TrimSpace(string(head)),\n\t\t\"repo_commits\": strings.TrimSpace(string(commits)), \"check\": \"review-check \" + spec, \"short_query\": \"surface-check \" + spec,\n\t\t\"samples\": map[string]int{\"cold\": measureColdSamples, \"warm\": measureWarmSamples, \"churn\": measureChurnSamples, \"short\": measureShortSamples}}\n\n\tfail := func(name, format string, a ...any) {\n\t\trep.Verdicts[name] = \"FAIL: \" + fmt.Sprintf(format, a...)\n\t\tt.Errorf(\"%s: \"+format, append([]any{name}, a...)...)\n\t}\n\tpass := func(name, format string, a ...any) { rep.Verdicts[name] = \"pass: \" + fmt.Sprintf(format, a...) }\n\n\t// S1: cold, standalone, a new process each time.\n\tvar coldOut string\n\tfor i := 0; i < measureColdSamples; i++ {\n\t\to, ms, _ := run(\"review-check\", spec)\n\t\tif i == 0 {\n\t\t\tcoldOut = o\n\t\t}\n\t\trep.Scenarios[\"cold_standalone\"] = append(rep.Scenarios[\"cold_standalone\"], ms)\n\t\tif o != coldOut {\n\t\t\tt.Fatalf(\"standalone output changed between samples %d and 0\", i)\n\t\t}\n\t}\n\tcold := measureMedian(rep.Scenarios[\"cold_standalone\"])\n\n\t// S2: asking for a runtime that is not there.\n\tfor i := 0; i < measureColdSamples; i++ {\n\t\to, ms, via := runtimeRun(\"review-check\", spec)\n\t\trep.Scenarios[\"fallback_no_runtime\"] = append(rep.Scenarios[\"fallback_no_runtime\"], ms)\n\t\tif via != \"standalone\" || o != coldOut {\n\t\t\tt.Fatalf(\"a run with no runtime: via %q, same output %v\", via, o == coldOut)\n\t\t}\n\t}\n\textra := measureMedian(rep.Scenarios[\"fallback_no_runtime\"]) - cold\n\trep.Figures[\"fallback_extra_ms\"] = float64(extra)\n\tif extra <= thresholdFallbackExtraMS {\n\t\tpass(\"T6 fallback overhead\", \"%d ms <= %d ms\", extra, thresholdFallbackExtraMS)\n\t} else {\n\t\tfail(\"T6 fallback overhead\", \"%d ms > %d ms\", extra, thresholdFallbackExtraMS)\n\t}\n\n\t// S3: resident, warm. The first run is the cold one inside the runtime; it is recorded apart.\n\tif o, _, _ := run(\"runtime\", \"start\"); !strings.Contains(o, \"started\") {\n\t\tt.Fatalf(\"start: %s\", o)\n\t}\n\tdefer run(\"runtime\", \"stop\")\n\tfor i := 0; i < measureWarmSamples+1; i++ {\n\t\to, ms, via := runtimeRun(\"review-check\", spec)\n\t\tif via != \"runtime\" || o != coldOut {\n\t\t\tt.Fatalf(\"a hosted run: via %q, same output as standalone %v\", via, o == coldOut)\n\t\t}\n\t\tif i == 0 {\n\t\t\trep.Scenarios[\"resident_first\"] = []int64{ms}\n\t\t} else {\n\t\t\trep.Scenarios[\"resident_warm\"] = append(rep.Scenarios[\"resident_warm\"], ms)\n\t\t}\n\t}\n\twarm := measureMedian(rep.Scenarios[\"resident_warm\"])\n\trep.Figures[\"warm_over_cold\"] = float64(warm) / float64(cold)\n\tif float64(warm) <= thresholdWarmOverCold*float64(cold) {\n\t\tpass(\"T1 warm over cold\", \"%d ms / %d ms = %.2f <= %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n\t} else {\n\t\tfail(\"T1 warm over cold\", \"%d ms / %d ms = %.2f > %.2f\", warm, cold, float64(warm)/float64(cold), thresholdWarmOverCold)\n\t}\n\t// S5: short queries, idle then under a heavy check.\n\tshortArgs := []string{\"surface-check\", spec}\n\tshortStandalone, _, _ := run(shortArgs...)\n\tfor i := 0; i < measureShortSamples; i++ {\n\t\tso, ms, via := runtimeRun(shortArgs...)\n\t\tif via != \"runtime\" || so != shortStandalone {\n\t\t\tt.Fatalf(\"a short query went %s, same output as standalone %v\", via, so == shortStandalone)\n\t\t}\n\t\trep.Scenarios[\"short_idle\"] = append(rep.Scenarios[\"short_idle\"], ms)\n\t}\n\tvar wg sync.WaitGroup\n\twg.Add(1)\n\tgo func() { defer wg.Done(); runtimeRun(\"review-check\", spec) }()\n\ttime.Sleep(1500 * time.Millisecond)\n\tfor i := 0; i < measureShortSamples; i++ {\n\t\tso, ms, via := runtimeRun(shortArgs...)\n\t\tif via != \"runtime\" || so != shortStandalone {\n\t\t\tt.Fatalf(\"a short query under load went %s, same output as standalone %v\", via, so == shortStandalone)\n\t\t}\n\t\trep.Scenarios[\"short_under_heavy\"] = append(rep.Scenarios[\"short_under_heavy\"], ms)\n\t}\n\twg.Wait()\n\tidle, loaded := measureP95(rep.Scenarios[\"short_idle\"]), measureP95(rep.Scenarios[\"short_under_heavy\"])\n\tbound := int64(thresholdShortUnderHeavy * float64(idle))\n\tif bound < thresholdShortFloorMS {\n\t\tbound = thresholdShortFloorMS\n\t}\n\trep.Figures[\"short_p95_idle_ms\"], rep.Figures[\"short_p95_under_heavy_ms\"] = float64(idle), float64(loaded)\n\tif loaded <= bound {\n\t\tpass(\"T3 short under heavy\", \"p95 %d ms <= %d ms (idle p95 %d ms)\", loaded, bound, idle)\n\t} else {\n\t\tfail(\"T3 short under heavy\", \"p95 %d ms > %d ms (idle p95 %d ms)\", loaded, bound, idle)\n\t}\n\t// Memory of the runtime after the warm runs and the concurrent phase.\n\tstatus, _, _ := run(\"runtime\", \"status\", \"--json\")\n\tvar st struct {\n\t\tPID int `json:\"pid\"`\n\t}\n\t_ = json.Unmarshal([]byte(strings.SplitN(status, \"\\x00\", 2)[0]), &st)\n\tif raw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(st.PID) + \"/status\"); err == nil {\n\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n\t\t\tif strings.HasPrefix(line, \"VmHWM:\") || strings.HasPrefix(line, \"VmRSS:\") {\n\t\t\t\tf := strings.Fields(line)\n\t\t\t\tkb, _ := strconv.ParseFloat(f[1], 64)\n\t\t\t\trep.Figures[strings.TrimSuffix(f[0], \":\")+\"_mib\"] = kb / 1024\n\t\t\t}\n\t\t}\n\t\tif mib := rep.Figures[\"VmHWM_mib\"]; mib <= thresholdRSSMiB {\n\t\t\tpass(\"T4 runtime memory\", \"peak resident %.0f MiB <= %d MiB\", mib, thresholdRSSMiB)\n\t\t} else {\n\t\t\tfail(\"T4 runtime memory\", \"peak resident %.0f MiB > %d MiB\", mib, thresholdRSSMiB)\n\t\t}\n\t} else {\n\t\trep.Verdicts[\"T4 runtime memory\"] = \"not measured: no /proc on this platform\"\n\t}\n\n\tst2, _, _ := run(\"runtime\", \"status\", \"--json\")\n\tvar full struct {\n\t\tMetrics map[string]int64 `json:\"metrics\"`\n\t}\n\t_ = json.Unmarshal([]byte(strings.SplitN(st2, \"\\x00\", 2)[0]), &full)\n\trep.Metrics = full.Metrics\n\tif len(rep.Metrics) == 0 {\n\t\tt.Fatalf(\"the runtime status carries no lane metrics: %s\", st2)\n\t}\n\n\t// S4: a restart inherits nothing.\n\tfor i := 0; i < measureChurnSamples; i++ {\n\t\trun(\"runtime\", \"stop\")\n\t\trun(\"runtime\", \"start\")\n\t\to, ms, via := runtimeRun(\"review-check\", spec)\n\t\tif via != \"runtime\" || o != coldOut {\n\t\t\tt.Fatalf(\"a run after a restart: via %q, same output %v\", via, o == coldOut)\n\t\t}\n\t\trep.Scenarios[\"restart_then_run\"] = append(rep.Scenarios[\"restart_then_run\"], ms)\n\t}\n\tchurn := measureMedian(rep.Scenarios[\"restart_then_run\"])\n\trep.Figures[\"churn_over_cold\"] = float64(churn) / float64(cold)\n\tif float64(churn) >= thresholdChurnOverCold*float64(cold) {\n\t\tpass(\"T2 restart inherits nothing\", \"%d ms / %d ms = %.2f >= %.2f\", churn, cold, float64(churn)/float64(cold), thresholdChurnOverCold)\n\t} else {\n\t\tfail(\"T2 restart inherits nothing\", \"%d ms / %d ms = %.2f < %.2f\", churn, cold, float64(churn)/float64(cold), thresholdChurnOverCold)\n\t}\n\tpass(\"T5 output\", \"every hosted run, the review-check and the short query idle and under load, printed exactly what the standalone run printed (%d and %d bytes)\", len(coldOut), len(shortStandalone))\n\n\traw, _ := json.MarshalIndent(rep, \"\", \"  \")\n\tif err := os.WriteFile(out, append(raw, '\\n'), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n","numLines":274,"startLine":1,"totalLines":274}},"tool_result_meta":[{"id":"toolu_016kvRfXWRXEwixRuSF2CcJY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
