{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BXLMmivQpfDBBtZuppbknM","type":"tool_result","content":"18:func TestReadOnlyIndexDiffAnswersAsThePlainDiff(t *testing.T) {\n109:\t\t\tt.Fatalf(\"%v rewrote .git/index\", args)\n133:\t\tt.Fatal(\"the review history diff rewrote .git/index\")\n149:func TestReadOnlyIndexDiffSeesARacilyCleanEntry(t *testing.T) {\n190:func TestReadOnlyIndexRefusesAFIFOIndex(t *testing.T) {\n249:func TestReadOnlyIndexToleratesAnAtomicallyReplacedIndex(t *testing.T) {\n281:func TestReadOnlyIndexFindsTheIndexFromASubdirectory(t *testing.T) {\n291:\t\tt.Fatal(\"a read from a subdirectory rewrote .git/index\")\n297:func TestThePrivateIndexCopyLeavesTheIndexAlone(t *testing.T) {\n319:\t\tt.Fatal(\"the private copy read rewrote .git/index\")\n326:func TestReadOnlyIndexDiffCoversConflictsRangesAndDirtySubmodules(t *testing.T) {\n371:\t\tbefore, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n377:\t\t\tt.Fatalf(\"%v rewrote .git/index\", args)\n384:\tbefore, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n398:\t\tt.Fatal(\"concurrent review history reads changed .git/index\")"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"ccdcd523-8518-43dc-9e22-351e246432db","timestamp":"2026-11-26T23:53:49.702Z","tool_use_result":{"mode":"content","numFiles":0,"filenames":[],"content":"18:func TestReadOnlyIndexDiffAnswersAsThePlainDiff(t *testing.T) {\n109:\t\t\tt.Fatalf(\"%v rewrote .git/index\", args)\n133:\t\tt.Fatal(\"the review history diff rewrote .git/index\")\n149:func TestReadOnlyIndexDiffSeesARacilyCleanEntry(t *testing.T) {\n190:func TestReadOnlyIndexRefusesAFIFOIndex(t *testing.T) {\n249:func TestReadOnlyIndexToleratesAnAtomicallyReplacedIndex(t *testing.T) {\n281:func TestReadOnlyIndexFindsTheIndexFromASubdirectory(t *testing.T) {\n291:\t\tt.Fatal(\"a read from a subdirectory rewrote .git/index\")\n297:func TestThePrivateIndexCopyLeavesTheIndexAlone(t *testing.T) {\n319:\t\tt.Fatal(\"the private copy read rewrote .git/index\")\n326:func TestReadOnlyIndexDiffCoversConflictsRangesAndDirtySubmodules(t *testing.T) {\n371:\t\tbefore, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n377:\t\t\tt.Fatalf(\"%v rewrote .git/index\", args)\n384:\tbefore, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n398:\t\tt.Fatal(\"concurrent review history reads changed .git/index\")","numLines":15,"totalLines":15},"tool_result_meta":[{"id":"toolu_01BXLMmivQpfDBBtZuppbknM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
