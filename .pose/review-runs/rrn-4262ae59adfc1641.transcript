= findSpecFilesIn(checker.fsys(), checker.root)\n1079\t\tfor _, path := range specPaths {\n1080\t\t\tfields := simpleFrontmatterIn(checker.fsys(), path)\n1081\t\t\tslug := fields[\"slug\"]\n1082\t\t\tif slug == \"\" {\n1083\t\t\t\tslug = filepath.Base(filepath.Dir(path))\n1084\t\t\t}\n1085\t\t\tif fields[\"status\"] == \"done\" && fields[\"changelog\"] != \"none\" && fields[\"completed_at\"] >= policy.AdoptedAt && !covered[slug] {\n1086\t\t\t\tchecker.issue(cliout.StateWarning, checker.message(\"changelog: done spec without a changelog fragment: \", \"changelog: spec done sem changelog fragment: \")+slug)\n1087\t\t\t}\n1088\t\t}\n1089\t}\n1090\t\n1091\tfunc frontmatterBodyIn(files pose.Files, path string) string {\n1092\t\traw, err := files.ReadFile(path)\n1093\t\tif err != nil {\n1094\t\t\treturn \"\"\n1095\t\t}\n1096\t\tlines := strings.Split(string(raw), \"\\n\")\n1097\t\tif len(lines) == 0 || strings.TrimSpace(lines[0]) != \"---\" {\n1098\t\t\treturn string(raw)\n1099\t\t}\n1100\t\tfor index, line := range lines[1:] {\n1101\t\t\tif strings.TrimSpace(line) == \"---\" {\n1102\t\t\t\treturn strings.Join(lines[index+2:], \"\\n\")\n1103\t\t\t}\n1104\t\t}\n1105\t\treturn string(raw)\n1106\t}\n1107\t\n1108\t// frontmatterBody reads and writes the filesystem directly; frontmatterBodyIn takes the\n1109\t// operation's files.\n1110\tfunc frontmatterBody(path string) string {\n1111\t\treturn frontmatterBodyIn(pose.NativeFiles(), path)\n1112\t}\n1113\t\n1114\tfunc stripHTMLComments(value string) string {\n1115\t\treturn regexp.MustCompile(`(?s)<!--.*?-->`).ReplaceAllString(value, \"\")\n1116\t}\n1117\t\n1118\tfunc (checker *nativeChecker) checkReadyTransitions() {\n1119\t\tfor _, rel := range checker.readyTransitionCandidates() {\n1120\t\t\tchecker.checkReadyTransition(rel)\n1121\t\t}\n1122\t}\n1123\t\n1124\t// readyTransitionCandidates lists the spec files that differ from HEAD or are new.\n1125\tfunc (checker *nativeChecker) readyTransitionCandidates() []string {\n1126\t\