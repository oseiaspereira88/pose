{\n\t\t\t\tslug = filepath.Base(filepath.Dir(specPath))\n\t\t\t}\n\t\t\tif strings.Contains(text, slug) {\n\t\t\t\tcovered[slug] = true\n\t\t\t}\n\t\t}\n\t}\n\tpolicyPath := filepath.Join(checker.root, \".pose\", \"policy\", \"changelog.json\")\n\tpolicyRaw, err := checker.fsys().ReadFile(policyPath)\n\tif err != nil {\n\t\tif _, releaseErr := checker.fsys().Stat(filepath.Join(checker.root, \".pose\", \"release-policy.json\")); releaseErr == nil {\n\t\t\tchecker.failOrWarn(\"changelog: adopted repository is missing .pose/policy/changelog.json\")\n\t\t}\n\t\treturn\n\t}\n\tvar policy struct {\n\t\tAdoptedAt string `json:\"adopted_at\"`\n\t}\n\tif json.Unmarshal(policyRaw, &policy) != nil {\n\t\tchecker.failOrWarn(\"changelog: invalid policy\")\n\t\treturn\n\t}\n\t// An empty date is a decision, not a malformed file: the contract is not\n\t// adopted, and no spec is held to it. `pose install` and `pose update` stamp\n\t// the day this instance received the policy, so this is reached only where\n\t// someone deliberately cleared it (spec pose-changelog-adoption-is-the-instances).\n\tif strings.TrimSpace(policy.AdoptedAt) == \"\" {\n\t\treturn\n\t}\n\tspecPaths := findSpecFilesIn(checker.fsys(), checker.root)\n\tfor _, path := range specPaths {\n\t\tfields := simpleFrontmatterIn(checker.fsys(), path)\n\t\tslug := fields[\"slug\"]\n\t\tif slug == \"\" {\n\t\t\tslug = filepath.Base(filepath.Dir(path))\n\t\t}\n\t\tif fields[\"status\"] == \"done\" && fields[\"changelog\"] != \"none\" && fields[\"completed_at\"] >= policy.AdoptedAt && !covered[slug] {\n\t\t\tchecker.issue(cliout.StateWarning, checker.message(\"changelog: done spec without a changelog fragment: \", \"changelog: spec done sem changelog fragment: \")+slug)\n\t\t}\n\t}\n}\n\nfunc frontmatterBodyIn(files pose.Files, path string) string {\n\traw, err := files.ReadFile(path)\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\tlines := strings.Split(string(raw), \"\\n\")\n\tif len(lines) == 0 || strings.TrimSpace(lines[0]) != \"---\" {\n\t\treturn string(raw)\n\t}\n\tfor index, line := range lines[1:] {\n\t\tif strings.TrimSpace(line) == \"---\" {\n\t\t\treturn strings.Join(lines[index+2:], \"\\n\")\n\t\t}\n\t}\n\treturn string(raw)\n}\n\n// frontmatterBody reads and writes the filesystem directly; frontmatterBodyIn takes the\n// operation's files.\nfunc frontmatterBody(path string) string {\n\treturn frontmatterBodyIn(pose.NativeFiles(), path)\n}\n\nfunc stripHTMLComments(value string) string {\n\treturn regexp.MustCompile(`(?s)<!--.*?-->`).ReplaceAllString(value, \"\")\n}\n\nfunc (checker *nativeChecker) checkReadyTransitions() {\n\tfor _, rel := range checker.readyTransitionCandidates() {\n\t\tchecker.checkReadyTransition(rel)\n\t}\n}\n\n// readyTransitionCandidates lists the spec files that differ from HEAD or are new.\nfunc (checker *nativeChecker) readyTransitionCandidates() []string {\n\tif _, err := pose.RawHistoryGit(checker.root, \"rev-parse\", \"--verify\", \"HEAD\").Output(); err != nil {\n\t\treturn nil\n\t}\n\tchanged := map[string]bool{}\n\tfor _, command := range [][]string{\n\t\t{\"diff\", \"--name-only\", \"HEAD\", \"--\", \".pose/specs\"},\n\t\t{\"ls-files\", \"--others\", \"--exclude-standard\", \"--\", \".pose/specs\"},\n\t} {\n\t\t// The diff reads the index without writing it (spec\n\t\t// pose-validate-reads-leave-the-index-alone R1).\n\t\tcmd := pose.RawHistoryGit(checker.root, command...)\n\t\tdone := func() {}\n\t\tif command[0] == \"diff\" {\n\t\t\tvar err error\n\t\t\tif done, err = pose.ReadOnlyIndex(cmd, checker.root); err != nil {\n\t\t\t\tdone()\n\t\t\t\t// The specs this read would name go unchecked: say so\n\t\t\t\t// (review round 5, N23).\n\t\t\t\tchecker.failOrWarn(fmt.Sprintf(\"ready transitions: the changed specs cannot be listed: %v\", err))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\toutput, err := cmd.Output()\n\t\tdone()\n\t\tif err != nil {\n\t\t\tchecker.failOrWarn(fmt.Sprintf(\"ready transitions: git %s failed: %v\", command[0], err))\n\t\t\tcontinue\n\t\t}\n\t\tfor _, rel := range strings.Fields(string(output)) {\n\t\t\trelNorm := filepath.ToSlash(rel)\n\t\t\tif strings.HasPrefix(relNorm, \".pose/specs/\") && (strings.HasSuffix(relNorm, \"/spec.md\") || (strings.HasSuffix(relNorm, \".md\") && !strings.EqualFold(filepath.Base(relNorm), \"README.md\"))) {\n\t\t\t\tchanged[relNorm] = true\n\t\t\t}\n\t\t}\n\t}\n\tfound := make([]string, 0, len(changed))\n\tfor rel := range changed {\n\t\tfound = append(found, rel)\n\t}\n\tsort.Strings(found)\n\treturn found\n}\n\nfunc (checker *nativeChecker) checkReadyTransition(rel string) {\n\tpath := filepath.Join(checker.root, filepath.FromSlash(rel))\n\tif simpleFrontmatterIn(checker.fsys(), path)[\"status\"] != \"in-progress\" {\n\t\treturn\n\t}\n\told, _ := pose.RawHistoryGit(checker.root, \"show\", \"HEAD:\"+rel).Output()\n\tif frontmatterFromText(string(old))[\"status\"] == \"in-progress\" {\n\t\treturn\n\t}\n\tif !specReadyIn(checker.fsys(), checker.root, path) {\n\t\tslug := simpleFrontmatterIn(checker.fsys(), path)[\"slug\"]\n\t\tif slug == \"\" {\n\t\t\tslug = filepath.Base(filepath.Dir(path))\n\t\t}\n\t\tchecker.failOrWarn(checker.message(\"DoR: transition to in-progress without Definition of Ready: \", \"DoR: transição para in-progress sem Definition of Ready: \") + slug + checker.message(\" (details: pose lint-spec \", \" (detalhes: pose lint-spec \") + slug + \" --ready-check)\")\n\t}\n}\n\nfunc specReadyIn(files pose.Files, root, path string) bool {\n\traw, err := files.ReadFile(path)\n\tif err != nil {\n\t\treturn false\n\t}\n\tfields := frontmatterFromText(string(raw))\n\ttaskType := fields[\"task_type\"]\n\tif taskType == \"\" {\n\t\ttaskType = \"feature\"\n\t}\n\trequired := []string{\"Intent\", \"Requirements\", \"Technical Plan\"}\n\t// The second half of the file, read through the same type as the first\n\t// (spec pose-changelog-and-dor-policy-types). It used to be an anonymous","numLines":200,"startLine":1000,"totalLines":1389}},"tool_result_met