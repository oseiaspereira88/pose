 append(env, \"GIT_NO_REPLACE_OBJECTS=1\", \"GIT_GRAFT_FILE=\"+os.DevNull, \"GIT_OPTIONAL_LOCKS=0\")\n663\t\treturn cmd\n664\t}\n665\t\n666\tconst (\n667\t\tgitEmptyTreeSHA1   = \"4b825dc642cb6eb9a060e54bf8d69288fbee4904\"\n668\t\tgitEmptyTreeSHA256 = \"6ef19b41225c5369f1c104d45d8d85efa9b057b53b14b4b9b939dd74decc5321\"\n669\t)\n670\t\n671\t// GitEmptyTree is the empty tree in commit's object format: the base of a change\n672\t// set that starts at a repository's first commit (spec\n673\t// pose-history-readers-read-raw R2, D2).\n674\tfunc GitEmptyTree(commit string) string {\n675\t\tif len(commit) == len(gitEmptyTreeSHA256) {\n676\t\t\treturn gitEmptyTreeSHA256\n677\t\t}\n678\t\treturn gitEmptyTreeSHA1\n679\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"2a23cdb1-9f0f-4f3a-b0cf-246113ac668e","timestamp":"2026-11-26T23:05:43.375Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-7696bc3a33/worktree/pose-mcp/internal/pose/git_snapshot_integrity.go","content":"\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfor _, path := range bytes.Split(out, []byte{0}) {\n\t\t\ttracked[string(path)] = true\n\t\t}\n\t}\n\tseen := map[string]bool{}\n\tresult := []string{}\n\tfor _, path := range changed {\n\t\t_, regularErr := dispatchRegularInputPath(root, path)\n\t\tif seen[path] || (allowed != nil && allowed(path, tracked[path]) && regularErr == nil) {\n\t\t\tcontinue\n\t\t}\n\t\tseen[path] = true\n\t\tresult = append(result, path)\n\t}\n\tsort.Strings(result)\n\treturn result, nil\n}\n\nfunc gitCommand(args ...string) *exec.Cmd {\n\treturn gitCommandContext(context.Background(), args...)\n}\n\n// gitCommandContext is gitCommand under ctx. Both read raw object history: a\n// replace ref or a graft changes what a commit is, and every gate has to judge\n// the same commit (spec pose-history-readers-read-raw R1, D1).\nfunc gitCommandContext(ctx context.Context, args ...string) *exec.Cmd {\n\t// The graft file below is the null device, and Git hints at any graft file on\n\t// stderr, which a caller that reads stderr as uncertainty would take for a failure.\n\tcmd := exec.CommandContext(ctx, \"git\", append([]string{\"-c\", \"advice.graftFileDeprecated=false\"}, args...)...)\n\tenv := make([]string, 0, len(os.Environ())+2)\n\tfor _, kv := range os.Environ() {\n\t\tname, _, _ := strings.Cut(kv, \"=\")\n\t\tif !gitRedirectingEnv[name] {\n\t\t\tenv = append(env, kv)\n\t\t}\n\t}\n\t// An engine read never takes the optional index lock nor rewrites the\n\t// index's stat cache: a concurrent reader would see .git change under\n\t// it (spec pose-validate-reads-leave-the-index-alone R1).\n\tcmd.Env = append(env, \"GIT_NO_REPLACE_OBJECTS=1\", \"GIT_GRAFT_FILE=\"+os.DevNull, \"GIT_OPTIONAL_LOCKS=0\")\n\treturn cmd\n}\n\nconst (\n\tgitEmptyTreeSHA1   = \"4b825dc642cb6eb9a060e54bf8d69288fbee4904\"\n\tgitEmptyTreeSHA256 = \"6ef19b41225c5369f1c104d45d8d85efa9b057b53b14b4b9b939dd74decc5321\"\n)\n\n// GitEmptyTree is the empty tree in commit's object format: the base of a change\n// set that starts at a repository's first commit (spec\n// pose-history-readers-read-raw R2, D2).\nfunc GitEmptyTree(commit string) string {\n\tif len(commit) == len(gitEmptyTreeSHA256) {\n\t\treturn gitEmptyTreeSHA256\n\t}\n\treturn gitEmptyTreeSHA1\n}","numLines":60,"startLine":620,"totalLines":764}},"tool_result_meta":[{"id":"toolu_0118QJWSMaN6cjTTWFGbwWD9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
