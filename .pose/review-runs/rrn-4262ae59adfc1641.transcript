r.root, filepath.FromSlash(rel))\n1171\t\tif simpleFrontmatterIn(checker.fsys(), path)[\"status\"] != \"in-progress\" {\n1172\t\t\treturn\n1173\t\t}\n1174\t\told, _ := pose.RawHistoryGit(checker.root, \"show\", \"HEAD:\"+rel).Output()\n1175\t\tif frontmatterFromText(string(old))[\"status\"] == \"in-progress\" {\n1176\t\t\treturn\n1177\t\t}\n1178\t\tif !specReadyIn(checker.fsys(), checker.root, path) {\n1179\t\t\tslug := simpleFrontmatterIn(checker.fsys(), path)[\"slug\"]\n1180\t\t\tif slug == \"\" {\n1181\t\t\t\tslug = filepath.Base(filepath.Dir(path))\n1182\t\t\t}\n1183\t\t\tchecker.failOrWarn(checker.message(\"DoR: transition to in-progress without Definition of Ready: \", \"DoR: transição para in-progress sem Definition of Ready: \") + slug + checker.message(\" (details: pose lint-spec \", \" (detalhes: pose lint-spec \") + slug + \" --ready-check)\")\n1184\t\t}\n1185\t}\n1186\t\n1187\tfunc specReadyIn(files pose.Files, root, path string) bool {\n1188\t\traw, err := files.ReadFile(path)\n1189\t\tif err != nil {\n1190\t\t\treturn false\n1191\t\t}\n1192\t\tfields := frontmatterFromText(string(raw))\n1193\t\ttaskType := fields[\"task_type\"]\n1194\t\tif taskType == \"\" {\n1195\t\t\ttaskType = \"feature\"\n1196\t\t}\n1197\t\trequired := []string{\"Intent\", \"Requirements\", \"Technical Plan\"}\n1198\t\t// The second half of the file, read through the same type as the first\n1199\t\t// (spec pose-changelog-and-dor-policy-types). It used to be an anonymous"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"a58641be-84ea-444b-86e8-ca45b6eceac1","timestamp":"2026-11-26T23:05:39.002Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-7696bc3a33/worktree/pose-mcp/internal/cli/check.go","content":"\t}\n\tfor node := range edges {\n\t\tif visit(node) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc (checker *nativeChecker) checkChangelogs() {\n\tpaths, _ := pose.GlobIn(checker.fsys(), filepath.Join(che