{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc \"rg --files .pose | rg 'review-guard-reads|backend-go|design-39eb'; rg --files -g AGENTS.md pose-mcp; cat pose-mcp/internal/pose/review_guard_in_place_test.go pose-mcp/internal/pose/review_guard_probe_unix_test.go; sed -n '1,260p' pose-mcp/internal/pose/review_dispatch_unix.go\"","aggregated_output":".pose/rules/backend-go.md\n.pose/specs/2026-11-17-pose-review-guard-reads-the-integrity-graph-in-place.md\n.pose/reports/2026-08-15-standard-migrate-backend-go-frontend-react-rules-to-extensions.md\n.pose/reports/history/standard-migrate-backend-go-frontend-react-rules-to-extensions.jsonl\n.pose/starts/pose-review-guard-reads-the-integrity-graph-in-place.json\npose-mcp/internal/scaffold/dist/AGENTS.md\npose-mcp/internal/scaffold/dist/locales/pt-BR/AGENTS.md\npackage pose\n\nimport (\n\t\"reflect\"\n\t\"sort\"\n\t\"testing\"\n)\n\n// guardFromACopy is the guard's change-set part computed from a deep copy of\n// the graph, as it was before the guard read the graph in place.\nfunc guardFromACopy(t *testing.T, s Store, wanted map[string]bool) ([]string, string) {\n\tt.Helper()\n\tgraph, err := s.GetDeliveryIntegrity(\"\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsets := []ChangeSet{}\n\tfor _, set := range graph.ChangeSets {\n\t\tif wanted[set.Spec] {\n\t\t\tsets = append(sets, set)\n\t\t}\n\t}\n\tsort.Slice(sets, func(i, j int) bool { return sets[i].ID < sets[j].ID })\n\tpaths, revision := []string{}, \"\"\n\tfor _, set := range sets {\n\t\tfor _, observed := range set.Paths {\n\t\t\tfor _, path := range []string{observed.Path, observed.OldPath, observed.NewPath} {\n\t\t\t\tif path != \"\" && reviewGovernanceContractPath(path) {\n\t\t\t\t\tpaths = append(paths, path)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif revision == \"\" {\n\t\t\trevision = set.ResolvedBase\n\t\t}\n\t}\n\treturn uniqueSorted(paths), revision\n}\n\n// Spec pose-review-guard-reads-the-integrity-graph-in-place, R1 and R2: the\n// guard of a scope that changes the review contract is what a copy of the\n// graph gives, twice, and reading in place leaves the retained graph intact.\nfunc TestReviewGuardReadsTheIntegrityGraphInPlace(t *testing.T) {\n\t_, store := protectedBaselineFixture(t)\n\tretained := func() DeliveryIntegrityGraph {\n\t\tvar copied DeliveryIntegrityGraph\n\t\tif err := store.viewDeliveryIntegrity(func(graph DeliveryIntegrityGraph) { copied = copyDeliveryIntegrityGraph(graph) }); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\treturn copied\n\t}\n\tbefore := retained()\n\tfor i := 0; i < 2; i++ {\n\t\tguard := store.resolveReviewGovernanceGuard(ScopeRef{Kind: \"spec\", Slug: \"governance\"})\n\t\tpaths, revision := guardFromACopy(t, store, map[string]bool{\"governance\": true})\n\t\tif len(guard.Paths) == 0 || guard.Revision == \"\" {\n\t\t\tt.Fatalf(\"the fixture's guard has no contract change: %+v\", guard)\n\t\t}\n\t\tif !reflect.DeepEqual(guard.Paths, paths) || guard.Revision != revision {\n\t\t\tt.Fatalf(\"read %d: guard %v@%s, a copy gives %v@%s\", i, guard.Paths, guard.Revision, paths, revision)\n\t\t}\n\t}\n\tif after := retained(); !reflect.DeepEqual(before, after) {\n\t\tt.Fatal(\"reading the graph in place changed the retained graph\")\n\t}\n}\n//go:build !windows\n\npackage pose\n\nimport (\n\t\"errors\"\n\t\"testing\"\n\t\"time\"\n)\n\nvar errProbeFixture = errors.New(\"probe fixture failure\")\n\n// R3: a successful process-group probe holds for its TTL; a failed one is\n// not kept.\nfunc TestProcessGroupProbeKeepsASuccessForItsTTL(t *testing.T) {\n\toriginal := processGroupVerify\n\tt.Cleanup(func() {\n\t\tprocessGroupVerify = original\n\t\tprocessGroupProbe.Lock()\n\t\tprocessGroupProbe.ok = time.Time{}\n\t\tprocessGroupProbe.Unlock()\n\t})\n\tprocessGroupProbe.Lock()\n\tprocessGroupProbe.ok = time.Time{}\n\tprocessGroupProbe.Unlock()\n\tprobes, fail := 0, true\n\tprocessGroupVerify = func(int) error {\n\t\tprobes++\n\t\tif fail {\n\t\t\treturn errProbeFixture\n\t\t}\n\t\treturn nil\n\t}\n\tif reviewProcessGroupAvailable() == nil || reviewProcessGroupAvailable() == nil || probes != 2 {\n\t\tt.Fatalf(\"a failed probe was kept: probes=%d\", probes)\n\t}\n\tfail = false\n\tfor i := 0; i < 3; i++ {\n\t\tif err := reviewProcessGroupAvailable(); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif probes != 3 {\n\t\tt.Fatalf(\"a successful probe was not kept: probes=%d, want 3\", probes)\n\t}\n\tprocessGroupProbe.Lock()\n\tprocessGroupProbe.ok = time.Now().Add(-2 * processGroupProbeTTL)\n\tprocessGroupProbe.Unlock()\n\treviewProcessGroupAvailable()\n\tif probes != 4 {\n\t\tt.Fatalf(\"an expired probe was not repeated: probes=%d, want 4\", probes)\n\t}\n}\n//go:build !windows\n\npackage pose\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"runtime\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"syscall\"\n\t\"time\"\n)\n\n// isolateProcessGroup starts the adapter in its own process group, and makes\n// the context's cancellation kill that whole group.\nfunc isolateProcessGroup(cmd *exec.Cmd) {\n\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n\tcmd.Cancel = func() error {\n\t\treturn syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\n\t}\n}\n\n// killProcessGroup ends whatever the adapter left running.\nfunc killProcessGroup(cmd *exec.Cmd) error {\n\tif cmd.Process == nil {\n\t\treturn nil\n\t}\n\terr := syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\n\tif errors.Is(err, syscall.ESRCH) {\n\t\treturn nil\n\t}\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn verifyReviewProcessGroup(cmd.Process.Pid)\n}\nfunc openReviewAdapterFile(path string) (*os.File, error) {\n\tfd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn os.NewFile(uintptr(fd), path), nil\n}\nfunc reviewSetupCommand(ctx context.Context, source *exec.Cmd) *exec.Cmd {\n\tcmd := exec.CommandContext(ctx, source.Path, source.Args[1:]...)\n\tcmd.Env = source.Env\n\tisolateProcessGroup(cmd)\n\tcmd.WaitDelay = time.Second\n\treturn cmd\n}\n\n// Verify the covered Linux group after SIGKILL. Zombies have terminated and\n// cannot hold pipes; reaping is their parent's duty. Other Unix ports currently\n// report signal delivery only and cannot require verified group termination.\nfunc verifyReviewProcessGroup(pid int) error {\n\tif runtime.GOOS != \"linux\" {\n\t\treturn nil\n\t}\n\tdeadline := time.Now().Add(time.Second)\n\tfor {\n\t\tentries, err := os.ReadDir(\"/proc\")\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"process-group termination could not be observed\")\n\t\t}\n\t\tif len(entries) > 100000 {\n\t\t\treturn fmt.Errorf(\"process inventory exceeds coverage\")\n\t\t}\n\t\talive := false\n\t\tfor _, entry := range entries {\n\t\t\tif _, err := strconv.Atoi(entry.Name()); err != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\traw, err := os.ReadFile(\"/proc/\" + entry.Name() + \"/stat\")\n\t\t\tif processGone(err) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif err != nil {\n\t\t\t\treturn fmt.Errorf(\"process inventory incomplete\")\n\t\t\t}\n\t\t\tend := strings.LastIndex(string(raw), \")\")\n\t\t\tif end < 0 {\n\t\t\t\treturn fmt.Errorf(\"process inventory malformed\")\n\t\t\t}\n\t\t\tfields := strings.Fields(string(raw[end+1:]))\n\t\t\tif len(fields) < 3 {\n\t\t\t\treturn fmt.Errorf(\"process inventory malformed\")\n\t\t\t}\n\t\t\tgroup, err := strconv.Atoi(fields[2])\n\t\t\tif err != nil {\n\t\t\t\treturn fmt.Errorf(\"process group malformed\")\n\t\t\t}\n\t\t\tif group == pid && fields[0] != \"Z\" && fields[0] != \"X\" {\n\t\t\t\talive = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !alive {\n\t\t\treturn nil\n\t\t}\n\t\tif time.Now().After(deadline) {\n\t\t\treturn fmt.Errorf(\"process group remained alive after termination\")\n\t\t}\n\t\ttime.Sleep(10 * time.Millisecond)\n\t}\n}\n\n// processGone reports the two ways a process exiting during the walk answers:\n// the open finds no entry, or the read of an open entry finds no process.\nfunc processGone(err error) bool {\n\treturn errors.Is(err, os.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n}\n\n// processGroupProbe keeps when the process inventory was last observed in\n// full. The probe asks whether this system lets the engine observe a process\n// group's termination; that does not change between two verifications of a\n// closeout, and the walk reads every /proc/<pid>/stat. A success holds for\n// processGroupProbeTTL; a failure is never kept (spec\n// pose-review-guard-reads-the-integrity-graph-in-place).\nvar processGroupProbe struct {\n\tsync.Mutex\n\tok time.Time\n}\n\nconst processGroupProbeTTL = time.Minute\n\n// processGroupVerify is the walk the probe runs; tests count it.\nvar processGroupVerify = verifyReviewProcessGroup\n\nfunc reviewProcessGroupAvailable() error {\n\tprocessGroupProbe.Lock()\n\tdefer processGroupProbe.Unlock()\n\tif !processGroupProbe.ok.IsZero() && time.Since(processGroupProbe.ok) < processGroupProbeTTL {\n\t\treturn nil\n\t}\n\tif err := processGroupVerify(-1); err != nil {\n\t\treturn err\n\t}\n\tprocessGroupProbe.ok = time.Now()\n\treturn nil\n}\nfunc openReviewRootFile(root *os.Root, path string) (*os.File, error) {\n\treturn root.OpenFile(path, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)\n}\n","exit_code":0,"status":"completed"}}
