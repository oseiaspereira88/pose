{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 680799274ea014a44cb54808669ddf9ebcea0971 4e77589037bff10a20d223d7882a3c9d85bee533 -- pose-mcp/internal/pose .pose/indexes/validation-matrix.json'","aggregated_output":"diff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex 68d0bc64..b541d745 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2420,6 +2420,13 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"review-guard-reads-the-integrity-graph-in-place-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestReviewGuardReadsTheIntegrityGraphInPlace|TestProcessGroupProbeKeepsASuccessForItsTTL|TestABMProtectedBaseline\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"federated-source-proof-is-computed-once-per-operation-integration\",\n           \"program\": \"go\",\ndiff --git a/pose-mcp/internal/pose/delivery_integrity.go b/pose-mcp/internal/pose/delivery_integrity.go\nindex 5d4fccfe..9233d4fd 100644\n--- a/pose-mcp/internal/pose/delivery_integrity.go\n+++ b/pose-mcp/internal/pose/delivery_integrity.go\n@@ -543,6 +543,23 @@ func BuildDeliveryIntegrityWithReleases(specs []Spec, claims []ArtifactClaim, ch\n \treturn BuildDeliveryIntegrityWithReleasesIn(NativeFiles(), specs, claims, changeSets, tracked, policy, archived)\n }\n \n+// viewDeliveryIntegrity hands fn the index's retained graph without copying\n+// it, for callers that only read it: fn must neither modify nor keep the graph\n+// or anything it reaches (spec pose-review-guard-reads-the-integrity-graph-in-place).\n+func (s Store) viewDeliveryIntegrity(fn func(DeliveryIntegrityGraph)) error {\n+\traw, _, err := s.ReadIndex(\"delivery-integrity.json\")\n+\tif errors.Is(err, ErrIndexGenerationUnavailable) {\n+\t\treturn err\n+\t}\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"pose: delivery-integrity index not found; run `pose index`\")\n+\t}\n+\tif err := viewDeliveryIntegrityGraphErr(s.Root, raw, fn); err != nil {\n+\t\treturn deliveryIndexError(err)\n+\t}\n+\treturn nil\n+}\n+\n func (s Store) GetDeliveryIntegrity(path string) (DeliveryIntegrityGraph, error) {\n \traw, _, err := s.ReadIndex(\"delivery-integrity.json\")\n \tif errors.Is(err, ErrIndexGenerationUnavailable) {\ndiff --git a/pose-mcp/internal/pose/review_dispatch_unix.go b/pose-mcp/internal/pose/review_dispatch_unix.go\nindex f69e904d..ad0e3ef0 100644\n--- a/pose-mcp/internal/pose/review_dispatch_unix.go\n+++ b/pose-mcp/internal/pose/review_dispatch_unix.go\n@@ -11,6 +11,7 @@ import (\n \t\"runtime\"\n \t\"strconv\"\n \t\"strings\"\n+\t\"sync\"\n \t\"syscall\"\n \t\"time\"\n )\n@@ -114,7 +115,34 @@ func processGone(err error) bool {\n \treturn errors.Is(err, os.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n }\n \n-func reviewProcessGroupAvailable() error { return verifyReviewProcessGroup(-1) }\n+// processGroupProbe keeps when the process inventory was last observed in\n+// full. The probe asks whether this system lets the engine observe a process\n+// group's termination; that does not change between two verifications of a\n+// closeout, and the walk reads every /proc/<pid>/stat. A success holds for\n+// processGroupProbeTTL; a failure is never kept (spec\n+// pose-review-guard-reads-the-integrity-graph-in-place).\n+var processGroupProbe struct {\n+\tsync.Mutex\n+\tok time.Time\n+}\n+\n+const processGroupProbeTTL = time.Minute\n+\n+// processGroupVerify is the walk the probe runs; tests count it.\n+var processGroupVerify = verifyReviewProcessGroup\n+\n+func reviewProcessGroupAvailable() error {\n+\tprocessGroupProbe.Lock()\n+\tdefer processGroupProbe.Unlock()\n+\tif !processGroupProbe.ok.IsZero() && time.Since(processGroupProbe.ok) < processGroupProbeTTL {\n+\t\treturn nil\n+\t}\n+\tif err := processGroupVerify(-1); err != nil {\n+\t\treturn err\n+\t}\n+\tprocessGroupProbe.ok = time.Now()\n+\treturn nil\n+}\n func openReviewRootFile(root *os.Root, path string) (*os.File, error) {\n \treturn root.OpenFile(path, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)\n }\ndiff --git a/pose-mcp/internal/pose/review_guard_in_place_test.go b/pose-mcp/internal/pose/review_guard_in_place_test.go\nnew file mode 100644\nindex 00000000..498c41ed\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_guard_in_place_test.go\n@@ -0,0 +1,66 @@\n+package pose\n+\n+import (\n+\t\"reflect\"\n+\t\"sort\"\n+\t\"testing\"\n+)\n+\n+// guardFromACopy is the guard's change-set part computed from a deep copy of\n+// the graph, as it was before the guard read the graph in place.\n+func guardFromACopy(t *testing.T, s Store, wanted map[string]bool) ([]string, string) {\n+\tt.Helper()\n+\tgraph, err := s.GetDeliveryIntegrity(\"\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tsets := []ChangeSet{}\n+\tfor _, set := range graph.ChangeSets {\n+\t\tif wanted[set.Spec] {\n+\t\t\tsets = append(sets, set)\n+\t\t}\n+\t}\n+\tsort.Slice(sets, func(i, j int) bool { return sets[i].ID < sets[j].ID })\n+\tpaths, revision := []string{}, \"\"\n+\tfor _, set := range sets {\n+\t\tfor _, observed := range set.Paths {\n+\t\t\tfor _, path := range []string{observed.Path, observed.OldPath, observed.NewPath} {\n+\t\t\t\tif path != \"\" && reviewGovernanceContractPath(path) {\n+\t\t\t\t\tpaths = append(paths, path)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\tif revision == \"\" {\n+\t\t\trevision = set.ResolvedBase\n+\t\t}\n+\t}\n+\treturn uniqueSorted(paths), revision\n+}\n+\n+// Spec pose-review-guard-reads-the-integrity-graph-in-place, R1 and R2: the\n+// guard of a scope that changes the review contract is what a copy of the\n+// graph gives, twice, and reading in place leaves the retained graph intact.\n+func TestReviewGuardReadsTheIntegrityGraphInPlace(t *testing.T) {\n+\t_, store := protectedBaselineFixture(t)\n+\tretained := func() DeliveryIntegrityGraph {\n+\t\tvar copied DeliveryIntegrityGraph\n+\t\tif err := store.viewDeliveryIntegrity(func(graph DeliveryIntegrityGraph) { copied = copyDeliveryIntegrityGraph(graph) }); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\treturn copied\n+\t}\n+\tbefore := retained()\n+\tfor i := 0; i < 2; i++ {\n+\t\tguard := store.resolveReviewGovernanceGuard(ScopeRef{Kind: \"spec\", Slug: \"governance\"})\n+\t\tpaths, revision := guardFromACopy(t, store, map[string]bool{\"governance\": true})\n+\t\tif len(guard.Paths) == 0 || guard.Revision == \"\" {\n+\t\t\tt.Fatalf(\"the fixture's guard has no contract change: %+v\", guard)\n+\t\t}\n+\t\tif !reflect.DeepEqual(guard.Paths, paths) || guard.Revision != revision {\n+\t\t\tt.Fatalf(\"read %d: guard %v@%s, a copy gives %v@%s\", i, guard.Paths, guard.Revision, paths, revision)\n+\t\t}\n+\t}\n+\tif after := retained(); !reflect.DeepEqual(before, after) {\n+\t\tt.Fatal(\"reading the graph in place changed the retained graph\")\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_guard_probe_unix_test.go b/pose-mcp/internal/pose/review_guard_probe_unix_test.go\nnew file mode 100644\nindex 00000000..a4cf6673\n--- /dev/null\n+++ b/pose-mcp/internal/pose/review_guard_probe_unix_test.go\n@@ -0,0 +1,53 @@\n+//go:build !windows\n+\n+package pose\n+\n+import (\n+\t\"errors\"\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+var errProbeFixture = errors.New(\"probe fixture failure\")\n+\n+// R3: a successful process-group probe holds for its TTL; a failed one is\n+// not kept.\n+func TestProcessGroupProbeKeepsASuccessForItsTTL(t *testing.T) {\n+\toriginal := processGroupVerify\n+\tt.Cleanup(func() {\n+\t\tprocessGroupVerify = original\n+\t\tprocessGroupProbe.Lock()\n+\t\tprocessGroupProbe.ok = time.Time{}\n+\t\tprocessGroupProbe.Unlock()\n+\t})\n+\tprocessGroupProbe.Lock()\n+\tprocessGroupProbe.ok = time.Time{}\n+\tprocessGroupProbe.Unlock()\n+\tprobes, fail := 0, true\n+\tprocessGroupVerify = func(int) error {\n+\t\tprobes++\n+\t\tif fail {\n+\t\t\treturn errProbeFixture\n+\t\t}\n+\t\treturn nil\n+\t}\n+\tif reviewProcessGroupAvailable() == nil || reviewProcessGroupAvailable() == nil || probes != 2 {\n+\t\tt.Fatalf(\"a failed probe was kept: probes=%d\", probes)\n+\t}\n+\tfail = false\n+\tfor i := 0; i < 3; i++ {\n+\t\tif err := reviewProcessGroupAvailable(); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tif probes != 3 {\n+\t\tt.Fatalf(\"a successful probe was not kept: probes=%d, want 3\", probes)\n+\t}\n+\tprocessGroupProbe.Lock()\n+\tprocessGroupProbe.ok = time.Now().Add(-2 * processGroupProbeTTL)\n+\tprocessGroupProbe.Unlock()\n+\treviewProcessGroupAvailable()\n+\tif probes != 4 {\n+\t\tt.Fatalf(\"an expired probe was not repeated: probes=%d, want 4\", probes)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_policy_baseline.go b/pose-mcp/internal/pose/review_policy_baseline.go\nindex c006a0b8..20d4fd25 100644\n--- a/pose-mcp/internal/pose/review_policy_baseline.go\n+++ b/pose-mcp/internal/pose/review_policy_baseline.go\n@@ -87,34 +87,37 @@ func (s Store) resolveReviewGovernanceGuard(scope ScopeRef) reviewGovernanceGuar\n \t\t\t}\n \t\t}\n \t}\n-\tgraph, err := s.GetDeliveryIntegrity(\"\")\n-\tif err != nil {\n-\t\tif len(guard.Paths) > 0 {\n-\t\t\tguard.Reason = \"delivery-integrity index is unavailable, so no base revision is attributable; run `pose index`\"\n-\t\t}\n-\t\treturn guard\n-\t}\n-\tsets := []ChangeSet{}\n-\tfor _, set := range graph.ChangeSets {\n-\t\tif wanted[set.Spec] {\n-\t\t\tsets = append(sets, set)\n+\t// The guard only reads the graph: it reads the retained one in place and\n+\t// keeps nothing it reaches, only the strings it derives.\n+\terr = s.viewDeliveryIntegrity(func(graph DeliveryIntegrityGraph) {\n+\t\tsets := []*ChangeSet{}\n+\t\tfor i := range graph.ChangeSets {\n+\t\t\tif wanted[graph.ChangeSets[i].Spec] {\n+\t\t\t\tsets = append(sets, &