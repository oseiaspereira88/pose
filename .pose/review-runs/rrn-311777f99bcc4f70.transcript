ng]string, []string) {\n\t\tout, keys := map[string]string{}, []string{}\n\t\tfor _, v := range items {\n\t\t\traw, _ := json.Marshal(v)\n\t\t\tvar m struct {\n\t\t\t\tID        string `json:\"id\"`\n\t\t\t\tComponent string `json:\"component\"`\n\t\t\t}\n\t\t\t_ = json.Unmarshal(raw, &m)\n\t\t\tkey := m.ID\n\t\t\tif m.Component != \"\" {\n\t\t\t\tkey += \" (component \" + m.Component + \")\"\n\t\t\t}\n\t\t\tif _, seen := out[key]; !seen {\n\t\t\t\tkeys = append(keys, key)\n\t\t\t}\n\t\t\tout[key] += string(raw)\n\t\t}\n\t\treturn out, keys\n\t}\n\tg, gk := index(got)\n\tw, wk := index(want)\npose-mcp/internal/pose/review_rounds.go:72:\tMappings []ReviewCriterionMapping `json:\"mappings,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:345:\tMappings []ReviewCriterionMapping `json:\"mappings,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:387:type ReviewToolDisposition struct {\n","exit_code":0,"status":"completed"}}
