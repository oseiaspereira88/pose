{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,65p' pose-mcp/internal/pose/review_adapter_containment.go; sed -n '35,130p' pose-mcp/internal/pose/release_manifest_integrity.go; sed -n '270,340p' pose-mcp/internal/cli/review_request.go; sed -n '565,640p' pose-mcp/internal/cli/release_lifecycle.go; rg -n 'strict-json|design-a21e|\\\"passed\\\"|\\\"head\\\"|\\\"command\\\"|\\\"commit\\\"' .pose/results/delivery-validation.json | head -35; rg -n 'func cmdArtifactCheck|func cmdSurfaceCheck|func cmdReviewBundle' pose-mcp/internal/cli; nl -ba pose-mcp/internal/pose/strict_json_test.go | sed -n '65,117p'\"","aggregated_output":"package pose\n\n// The trusted-process backend bounds engine capture, not the adapter's address\n// space or filesystem. Capabilities describe enforcement, never configuration.\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\t\"unicode/utf8\"\n)\n\nconst ReviewNotesMaxBytes = 16 << 10\n\n// ReviewerContainment is optional schema-1 adapter policy. Pointers distinguish\n// omitted finite defaults from explicit zero, which is invalid for byte limits.\ntype ReviewerContainment struct {\n\tSchemaVersion       int      `json:\"schema_version\"`\n\tProfile             string   `json:\"profile\"`\n\tRequired            []string `json:\"required,omitempty\"`\n\tEnvironment         []string `json:\"environment,omitempty\"`\n\tCredentials         []string `json:\"credentials,omitempty\"`\n\tStreamBytes         *int64   `json:\"stream_bytes,omitempty\"`\n\tOutputBytes         *int64   `json:\"output_bytes,omitempty\"`\n\tRetainedBytes       *int64   `json:\"retained_bytes,omitempty\"`\n\tRetentionTTLSeconds int64    `json:\"retention_ttl_seconds\"`\n\tMemoryBytes         *int64   `json:\"memory_bytes,omitempty\"`\n\tCPUTimeMS           *int64   `json:\"cpu_time_ms,omitempty\"`\n}\n\n// UnmarshalJSON refuses misspelled enforcement fields instead of dropping them.\nfunc (p *ReviewerContainment) UnmarshalJSON(raw []byte) error {\n\tvar fields map[string]json.RawMessage\n\tif err := json.Unmarshal(raw, &fields); err != nil {\n\t\treturn err\n\t}\n\tfor name, value := range fields {\n\t\tif bytes.Equal(bytes.TrimSpace(value), []byte(\"null\")) {\n\t\t\treturn fmt.Errorf(\"containment field %s cannot be null; omit optional fields for defaults\", name)\n\t\t}\n\t}\n\ttype plain ReviewerContainment\n\tvar decoded plain\n\td := json.NewDecoder(bytes.NewReader(raw))\n\td.DisallowUnknownFields()\n\tif err := d.Decode(&decoded); err != nil {\n\t\treturn err\n\t}\n\t*p = ReviewerContainment(decoded)\n\treturn nil\n}\n\n// ReviewExecutionSafety is retained with the exact run and covered by its hash,\n// witness and optional native signature. No environment values are exported.\n// releaseManifestFields are the exact names of the manifest schema.\nvar releaseManifestFields = map[string]bool{\n\t\"schema_version\": true, \"version\": true, \"previous_version\": true, \"prepared_at\": true, \"specs\": true,\n\t\"categories\": true, \"fragments\": true, \"breaking\": true, \"notes_digest\": true, \"release_input_digest\": true,\n\t\"policy_digest\": true, \"version_evidence\": true,\n}\n\n// releaseFragmentFields are the exact names of a frozen fragment.\nvar releaseFragmentFields = map[string]bool{\n\t\"spec\": true, \"category\": true, \"breaking\": true, \"refs\": true, \"body\": true, \"path\": true, \"digest\": true,\n}\n\nvar releaseDigestRE = regexp.MustCompile(`^sha256:[0-9a-f]{64}$`)\n\n// ValidateReleaseManifestBytes decodes raw as the manifest of version and checks what can be\n// checked from the manifest and nothing else: the schema and its shapes, unknown fields,\n// the version, the paths, and the projections (specs, categories, breaking) and the input digest it\n// repeats, recomposed from the fragments it freezes. A parseable JSON object is not a manifest.\nfunc ValidateReleaseManifestBytes(raw []byte, version string) (*ReleaseManifest, []ReleaseManifestIssue) {\n\tvar issues []ReleaseManifestIssue\n\tadd := func(field, msg string) { issues = append(issues, ReleaseManifestIssue{Field: field, Message: msg}) }\n\t// One JSON document, no repeated key, the exact names of the schema, and every field the\n\t// schema requires present: a struct decoder alone accepts a second object after the first,\n\t// the last of two repeated keys, `VERSION` for `version` and an absent `breaking`.\n\tif err := rejectDuplicateJSONKeys(raw, false, true); err != nil {\n\t\tadd(\"manifest\", \"is not an unambiguous JSON document: \"+err.Error())\n\t\treturn nil, issues\n\t}\n\tvar fields map[string]json.RawMessage\n\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n\tif err := decoder.Decode(&fields); err != nil || fields == nil {\n\t\tadd(\"manifest\", \"does not decode as a JSON object\")\n\t\treturn nil, issues\n\t}\n\tif err := decoder.Decode(&struct{}{}); err != io.EOF {\n\t\tadd(\"manifest\", \"has content after the manifest object\")\n\t\treturn nil, issues\n\t}\n\tfor name, value := range fields {\n\t\tif !releaseManifestFields[name] {\n\t\t\tadd(name, \"is not a field of the release manifest schema (field names are exact)\")\n\t\t} else if string(bytes.TrimSpace(value)) == \"null\" {\n\t\t\tadd(name, \"is null\")\n\t\t}\n\t}\n\tfor name := range releaseManifestFields {\n\t\tif _, ok := fields[name]; !ok && name != \"previous_version\" {\n\t\t\tadd(name, \"is required and absent\")\n\t\t}\n\t}\n\tif len(issues) > 0 {\n\t\treturn nil, issues\n\t}\n\t// The objects inside are held to the same contract as the root: exact names, every\n\t// required field, no null (refs is the one optional field).\n\tvar rawFragments []map[string]json.RawMessage\n\tif err := json.Unmarshal(fields[\"fragments\"], &rawFragments); err != nil {\n\t\tadd(\"fragments\", \"is not a list of objects\")\n\t\treturn nil, issues\n\t}\n\tfor i, obj := range rawFragments {\n\t\tif obj == nil {\n\t\t\tadd(fmt.Sprintf(\"fragments[%d]\", i), \"is null\")\n\t\t\tcontinue\n\t\t}\n\t\t// Free text (body, refs) may span lines; the names a fragment is addressed by may not.\n\t\tfor _, name := range []string{\"spec\", \"category\", \"path\", \"digest\"} {\n\t\t\tvar value string\n\t\t\tif json.Unmarshal(obj[name], &value) == nil && strings.ContainsFunc(value, unicode.IsControl) {\n\t\t\t\tadd(fmt.Sprintf(\"fragments[%d].%s\", i, name), \"holds a control character\")\n\t\t\t}\n\t\t}\n\t\tfor name, value := range obj {\n\t\t\tswitch {\n\t\t\tcase !releaseFragmentFields[name]:\n\t\t\t\tadd(fmt.Sprintf(\"fragments[%d].%s\", i, name), \"is not a field of a frozen fragment (field names are exact)\")\n\t\t\tcase string(bytes.TrimSpace(value)) == \"null\":\n\t\t\t\tadd(fmt.Sprintf(\"fragments[%d].%s\", i, name), \"is null\")\n\t\t\t}\n\t\t}\n\t\tfor name := range releaseFragmentFields {\n\t\t\tif _, ok := obj[name]; !ok && name != \"refs\" {\n\t\t\t\tadd(fmt.Sprintf(\"fragments[%d].%s\", i, name), \"is required and absent\")\n\t\t\t}\n\t\t}\n\t}\n\tif len(issues) > 0 {\n\t\treturn nil, issues\n\t}\n\tvar manifest ReleaseManifest\n\tstrict := json.NewDecoder(bytes.NewReader(raw))\n\tstrict.DisallowUnknownFields()\n\tif err := strict.Decode(&manifest); err != nil {\n\t\tadd(\"manifest\", \"does not decode as a release manifest: \"+err.Error())\n\t\treturn nil, issues\n\t}\n\t\t\tcontinue\n\t\t}\n\t\tif i+1 >= len(args) {\n\t\t\treturn usageError(stderr, actionFulfilUsage)\n\t\t}\n\t\ti++\n\t\tvalue := args[i]\n\t\tswitch flag {\n\t\tcase \"--run\":\n\t\t\tenv.RunID = value\n\t\tcase \"--runner\":\n\t\t\tenv.Runner = value\n\t\tcase \"--idempotency-key\":\n\t\t\tenv.IdempotencyKey = value\n\t\tcase \"--expected-revision\":\n\t\t\tn, err := strconv.Atoi(value)\n\t\t\tif err != nil {\n\t\t\t\treturn usageError(stderr, actionFulfilUsage)\n\t\t\t}\n\t\t\tenv.ExpectedRevision = n\n\t\tcase \"--request-digest\":\n\t\t\tenv.RequestDigest = value\n\t\tcase \"--channel\":\n\t\t\tenv.Channel = value\n\t\tcase \"--envelope\":\n\t\t\tenvelopeFile = value\n\t\tdefault:\n\t\t\treturn usageError(stderr, actionFulfilUsage)\n\t\t}\n\t}\n\tif envelopeFile != \"\" {\n\t\traw, err := os.ReadFile(envelopeFile)\n\t\tif err != nil || posemodel.DecodeStrictJSON(raw, &env) != nil {\n\t\t\treturn usageError(stderr, \"pose action fulfil: the envelope is not a fulfilment envelope\")\n\t\t}\n\t}\n\tstore := posemodel.Store{Root: root}\n\tout := render(stdout, stderr)\n\tif env.RequestID == \"\" || env.RunID == \"\" {\n\t\treturn usageError(stderr, actionFulfilUsage)\n\t}\n\tif env.RequestDigest == \"\" {\n\t\t// The digest the runner read; without it the current one is named,\n\t\t// which a revision check still binds.\n\t\tview, err := store.LoadActionRequest(env.RequestID)\n\t\tif err != nil {\n\t\t\tout.Failure(\"pose action fulfil: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tenv.RequestDigest = view.Request.RequestDigest\n\t}\n\tnow := time.Now()\n\tif !apply {\n\t\t_, event, err := store.PreflightFulfillment(env, now)\n\t\tif err != nil {\n\t\t\tout.Failure(\"pose action fulfil: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tif jsonOutput {\n\t\t\treturn writeJSON(stdout, event)\n\t\t}\n\t\tout.Field(\"action.fulfil.preview\", \"true\")\n\t\tout.Field(\"action.fulfil.run\", event.Fulfillment.RunID)\n\t\tout.Field(\"action.fulfil.decision\", event.Fulfillment.Decision)\n\t\tout.Field(\"action.fulfil.recorded\", event.Fulfillment.Recorded)\n\t\tout.Field(\"action.fulfil.apply\", \"false (rerun with --apply to record it)\")\n\t\treturn 0\n\t}\n\tview, err := store.FulfilActionRequest(env, now)\n\tif err != nil {\n\t\tout.Failure(\"pose action fulfil: \" + err.Error())\n\t}\n\treturn nil\n}\n\nfunc cmdReleaseRecord(root string, args []string, stdout, stderr io.Writer) int {\n\tif err := rejectReleaseArgs(args, map[string]bool{\"--version\": true, \"--event\": true, \"--evidence\": true}, nil); err != nil {\n\t\treturn usageError(stderr, err.Error())\n\t}\n\ttarget, ok, _ := releaseArg(args, \"--version\")\n\tif !ok {\n\t\treturn usageError(stderr, \"pose release record: --version required\")\n\t}\n\tstate, ok, _ := releaseArg(args, \"--event\")\n\tif !ok || !map[string]bool{\"tagged\": true, \"published\": true, \"verified\": true, \"failed\": true, \"yanked\": true}[state] {\n\t\treturn usageError(stderr, \"pose release record: legal --event required\")\n\t}\n\tevidencePath, ok, _ := releaseArg(args, \"--evidence\")\n\tif !ok {\n\t\treturn usageError(stderr, \"pose release record: --evidence required\")\n\t}\n\tfull, err := confinedProjectPath(root, evidencePath)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, \"pose release record: evidence path must remain inside project\")\n\t\treturn 2\n\t}\n\traw, err := os.ReadFile(full)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tvar evidence posemodel.ReleaseEvidence\n\tif err := posemodel.DecodeStrictJSON(raw, &evidence); err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tif err := validateReleaseEvidence(state, target, evidence); err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tif commit, tagged := resolveReleaseTag(root, target); (state == \"tagged\" || state == \"published\" || state == \"verified\") && (!tagged || commit != evidence.Commit) {\n\t\tfmt.Fprintln(stderr, \"evidence commit does not match the immutable Git tag\")\n\t\treturn 1\n\t}\n\tmanifest, err := posemodel.LoadReleaseManifest(root, target)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, \"prepared manifest required\")\n\t\treturn 1\n\t}\n\tif state == \"tagged\" || state == \"published\" || state == \"verified\" {\n\t\t// The event states that the tag is the release: the tag's own tree must hold an intact\n\t\t// snapshot, and the working tree's copy must be that same cut.\n\t\tif gaps, _ := releaseTagState(root, target); len(gaps) > 0 {\n\t\t\trender(io.Discard, stderr).Failure(\"the tag does not hold an intact release snapshot: \" + strings.Join(gaps, \"; \"))\n\t\t\treturn 1\n\t\t}\n\t\tif gaps := taggedReleaseWorktreeGaps(root, target, manifest); len(gaps) > 0 {\n\t\t\trender(io.Discard, stderr).Failure(\"the working tree is not the cut the tag holds: \" + strings.Join(gaps, \"; \"))\n\t\t\treturn 1\n\t\t}\n\t}\n\tevents, err := posemodel.LoadReleaseEvents(root, target)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tcandidate := posemodel.NewReleaseEvent(target, state, evidence, time.Now())\n\tfor _, event := range events {\n\t\tif event.State == state && event.EvidenceDigest == candidate.EvidenceDigest {\n\t\t\tfmt.Fprintln(stdout, \"Release event already recorded (idempotent).\")\n\t\t\treturn 0\n\t\t}\n\t\tif event.State == state && event.EvidenceDigest != candidate.EvidenceDigest {\n\t\t\tfmt.Fprintln(stderr, \"conflicting event evidence\")\n\t\t\treturn 1\n\t\t}\n\t}\n406:    \"pose-strict-json-readers-require-the-end\": \"sha256:cbcc8077d2871ce924f60268cea9173d8479b6ed7b0d65db6b41a1e6575a7118\",\n868:    \"pose-strict-json-readers-require-the-end\": \"sha256:83052932f62c195d3b944b59beddc5ee66b2ca1674caee0b1d868778b2a24950\",\n937:    \"passed\": 224,\n4240:      \"id\": \"pose-mcp/go/strict-json-readers-require-the-end-integration\",\n4243:      \"name\": \"strict-json-readers-require-the-end-integration\",\npose-mcp/internal/cli/surface_check.go:189:func cmdSurfaceCheck(root string, args []string, stdout, stderr io.Writer) int {\npose-mcp/internal/cli/artifact_integrity.go:783:func cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\npose-mcp/internal/cli/review_closeout.go:540:func cmdReviewBundle(root string, args []string, stdout, stderr io.Writer) int {\n    65\t\t\trel, _ := filepath.Rel(base, path)\n    66\t\t\trel = filepath.ToSlash(rel)\n    67\t\t\tfor _, decl := range file.Decls {\n    68\t\t\t\tfn, ok := decl.(*ast.FuncDecl)\n    69\t\t\t\tif !ok || fn.Body == nil {\n    70\t\t\t\t\tcontinue\n    71\t\t\t\t}\n    72\t\t\t\tstrict, ends := false, false\n    73\t\t\t\tast.Inspect(fn.Body, func(n ast.Node) bool {\n    74\t\t\t\t\t// io.EOF compared after a decode, or json.Unmarshal of the\n    75\t\t\t\t\t// same input, which refuses anything after the value.\n    76\t\t\t\t\tif sel, ok := n.(*ast.SelectorExpr); ok {\n    77\t\t\t\t\t\tif pkg, ok := sel.X.(*ast.Ident); ok && ((pkg.Name == \"io\" && sel.Sel.Name == \"EOF\") || (pkg.Name == \"json\" && sel.Sel.Name == \"Unmarshal\")) {\n    78\t\t\t\t\t\t\tends = true\n    79\t\t\t\t\t\t}\n    80\t\t\t\t\t}\n    81\t\t\t\t\tcall, ok := n.(*ast.CallExpr)\n    82\t\t\t\t\tif !ok {\n    83\t\t\t\t\t\treturn true\n    84\t\t\t\t\t}\n    85\t\t\t\t\tswitch sel := call.Fun.(type) {\n    86\t\t\t\t\tcase *ast.SelectorExpr:\n    87\t\t\t\t\t\tswitch sel.Sel.Name {\n    88\t\t\t\t\t\tcase \"DisallowUnknownFields\":\n    89\t\t\t\t\t\t\tstrict = true\n    90\t\t\t\t\t\tcase \"Token\", \"More\", \"DecodeStrictJSON\":\n    91\t\t\t\t\t\t\tends = true\n    92\t\t\t\t\t\tcase \"Decode\":\n    93\t\t\t\t\t\t\tif len(call.Args) == 1 {\n    94\t\t\t\t\t\t\t\tif inner, ok := call.Args[0].(*ast.CallExpr); ok {\n    95\t\t\t\t\t\t\t\t\tif id, ok := inner.Fun.(*ast.Ident); ok && id.Name == \"new\" {\n    96\t\t\t\t\t\t\t\t\t\tends = true\n    97\t\t\t\t\t\t\t\t\t}\n    98\t\t\t\t\t\t\t\t}\n    99\t\t\t\t\t\t\t}\n   100\t\t\t\t\t\t}\n   101\t\t\t\t\tcase *ast.Ident:\n   102\t\t\t\t\t\tif sel.Name == \"DecodeStrictJSON\" {\n   103\t\t\t\t\t\t\tends = true\n   104\t\t\t\t\t\t}\n   105\t\t\t\t\t}\n   106\t\t\t\t\treturn true\n   107\t\t\t\t})\n   108\t\t\t\tif !strict {\n   109\t\t\t\t\tcontinue\n   110\t\t\t\t}\n   111\t\t\t\tsite := rel + \"#\" + fn.Name.Name\n   112\t\t\t\tseen[site] = true\n   113\t\t\t\tif !ends && strictJSONWithoutTheEnd[site] == \"\" {\n   114\t\t\t\t\tt.Errorf(\"%s refuses unknown fields but reads past the value: use DecodeStrictJSON, or name here why the end need not be required\", site)\n   115\t\t\t\t}\n   116\t\t\t}\n   117\t\t\treturn nil\n","exit_code":0,"status":"completed"}}
