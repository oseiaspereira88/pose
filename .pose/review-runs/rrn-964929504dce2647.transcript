:178:\tdecoder.DisallowUnknownFields()\npose-mcp/internal/pose/index_generation.go:318:\tdec.DisallowUnknownFields()\npose-mcp/internal/pose/strict_json.go:17:\tdecoder.DisallowUnknownFields()\npose-mcp/internal/pose/delegation_policy.go:348:\tdec.DisallowUnknownFields()\npose-mcp/internal/pose/review_bundle.go:2369:\tdecoder.DisallowUnknownFields()\npose-mcp/internal/pose/delegated_verdicts_test.go:27:func dispatchKind(t *testing.T, f runProvenanceFixture, kind, reason string) ReviewRun {\npose-mcp/internal/pose/release_manifest_integrity.go:126:\tstrict.DisallowUnknownFields()\npose-mcp/internal/pose/closeout_receipt.go:102:\tdecoder.DisallowUnknownFields()\npose-mcp/internal/pose/review_adapter_containment.go:56:\td.DisallowUnknownFields()\npose-mcp/internal/pose/journal_integrity.go:123:\tdecoder.DisallowUnknownFields()\npose-mcp/internal/pose/review_conclusions_test.go:44:func dispatchConclusion(t *testing.T, f runProvenanceFixture, reason string) ReviewRun {\npose-mcp/internal/pose/git_snapshot_integrity.go:25:func dispatchDiskSnapshot(root string) (map[string]string, error) {\npose-mcp/internal/pose/contract_release_note_test.go:5:// whole review policy: its decoder used DisallowUnknownFields, so one key it did\npose-mcp/internal/pose/strict_json_test.go:88:\t\t\t\t\tcase \"DisallowUnknownFields\":\npose-mcp/internal/pose/review_dispatch.go:1245:func dispatchWorktreeIdentity(root string) (string, error) {\npose-mcp/internal/pose/review_dispatch.go:1316:func dispatchInputPath(root, path string) (string, error) {\npose-mcp/internal/pose/review_dispatch.go:1367:func dispatchRegularInputPath(root, path string) (string, error) {\npose-mcp/internal/pose/spec_transfer.go:1270:\tdecoder.DisallowUnknownFields()\npose-mcp/internal/pose/spec_transfer.go:1319:\tdecoder.DisallowUnknownFields()\npose-mcp/internal/pose/review_closeout.go:760:\t\t// decoder.DisallowUnknownFields() intentionally omitted.\npose-mcp/internal/pose/review_closeout.go:915:\t\tdecoder.DisallowUnknownFields()\npose-mcp/internal/pose/action_scoping.go:29:\tdec.DisallowUnknownFields()\nbcf51113 chore: regenerate indexes after the validation record\n9f2878a7 chore: record strict validation after final closeout pass\nfaadf40c chore: regenerate indexes after the strict JSON readers spec\ne2f9ccab chore: regenerate indexes after the strict JSON readers spec\n{\n  \"schema_version\": 1,\n  \"selected_project_id\": \"proj.pose-dist\",\n  \"selected_revision\": \"bcf51113728e99ff87971b18e5bf0eebf8c1ecd8\",\n  \"task_ref\": \"xref:proj.pose-dist/spec:pose-strict-json-readers-require-the-end\",\n  \"authority\": {\n    \"project_id\": \"proj.pose-dist\",\n    \"kind\": \"spec\",\n    \"slug\": \"pose-strict-json-readers-require-the-end\"\n  },\n  \"coordinator_relation\": \"same-project-authority\",\n  \"task_resolution\": {\n    \"schema_version\": 1,\n    \"identity\": {\n      \"project_id\": \"proj.pose-dist\",\n      \"kind\": \"spec\",\n      \"slug\": \"pose-strict-json-readers-require-the-end\"\n    },\n    \"resolved\": true,\n    \"resolution_state\": \"resolved\",\n    \"status\": \"in-progress\",\n    \"source_revision\": \"bcf51113728e99ff87971b18e5bf0eebf8c1ecd8\",\n    \"source_digest\": \"1c298b6d5197119569aadb751021e08c1615d0cba74f58f4f5b1be3fe37cc0cb\"\n  },\n  \"authority_revision\": \"bcf51113728e99ff87971b18e5bf0eebf8c1ecd8\",\n  \"supported_contracts\": [\n    \"qualified-artifact-refs@1\",\n    \"spec-authority-transfer@1\",\n    \"federated-roadmap-acceptance@1\"\n  ],\n  \"context_revision\": \"d1f4e3775fd661c1353caa9f723b9adff92bad064b5777dd13990710c0aafb36\"\n}\n","exit_code":0,"status":"completed"}}
