{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AQmMKNhxH3KKfrsWk6r87z","type":"tool_result","content":"1760\t}\n1761\t\n1762\tfunc (s Store) reviewBundleChildRefs(scope ScopeRef) ([]string, error) {\n1763\t\trefs := []string{}\n1764\t\tif scope.Kind == \"milestone\" {\n1765\t\t\trm, err := s.GetRoadmap(scope.Roadmap)\n1766\t\t\tif err != nil {\n1767\t\t\t\treturn nil, err\n1768\t\t\t}\n1769\t\t\tfor _, milestone := range rm.Milestones {\n1770\t\t\t\tif milestone.ID == scope.Milestone {\n1771\t\t\t\t\tfor _, raw := range milestone.Specs {\n1772\t\t\t\t\t\t// External members are sealed through the federated\n1773\t\t\t\t\t\t// manifest, not as local child bundles.\n1774\t\t\t\t\t\tif slug, external := s.milestoneMember(raw); !external {\n1775\t\t\t\t\t\t\trefs = append(refs, \"spec:\"+slug)\n1776\t\t\t\t\t\t}\n1777\t\t\t\t\t}\n1778\t\t\t\t}\n1779\t\t\t}\n1780\t\t} else if scope.Kind == \"roadmap\" {\n1781\t\t\trm, err := s.GetRoadmap(scope.Slug)\n1782\t\t\tif err != nil {\n1783\t\t\t\treturn nil, err\n1784\t\t\t}\n1785\t\t\tfor _, milestone := range rm.Milestones {\n1786\t\t\t\trefs = append(refs, \"milestone:\"+rm.Slug+\"/\"+milestone.ID)\n1787\t\t\t}\n1788\t\t}\n1789\t\treturn refs, nil\n1790\t}\n1791\t\n1792\tfunc (s Store) reviewBundleChildren(scope ScopeRef) ([]ReviewBundleChild, []string, error) {\n1793\t\trefs, err := s.reviewBundleChildRefs(scope)\n1794\t\tif err != nil {\n1795\t\t\treturn nil, nil, err\n1796\t\t}\n1797\t\ts = s.reviewOperation()\n1798\t\tparentDone, _ := s.scopeLifecycleDone(scope)\n1799\t\tchildren, blockers := []ReviewBundleChild{}, []string{}\n1800\t\tfor _, ref := range refs {\n1801\t\t\tif verification, err := s.verifyReviewBundle(ref); err == nil && verification.inherited {\n1802\t\t\t\t// A declared milestone has no bundle to seal over: the reason is in the\n1803\t\t\t\t// roadmap, which this bundle seals.\n1804\t\t\t\tif verification.Bundle != nil {\n1805\t\t\t\t\tchildren = append(children, ReviewBundleChild{Scope: ref, BundleID: verification.Bundle.BundleID, BundleDigest: verification.Bundle.BundleDigest})\n1806\t\t\t\t}\n1807\t\t\t\tcontinue\n1808\t\t\t}\n1809\t\t\tsealed, err := s.CurrentReviewBundle(ref)\n1810\t\t\tif err != nil {\n1811\t\t\t\treturn nil, nil, err\n1812\t\t\t}\n1813\t\t\tif sealed == nil {\n1814\t\t\t\tretained, why := s.retainedChildReviewBundle(ref)\n1815\t\t\t\tif retained == nil {\n1816\t\t\t\t\tblockers = append(blockers, \"child \"+ref+\" has no sealed review bundle\"+why)\n1817\t\t\t\t\tcontinue\n1818\t\t\t\t}\n1819\t\t\t\tsealed = retained\n1820\t\t\t} else if why := s.childReviewStanding(ref, parentDone); why != \"\" {\n1821\t\t\t\tblockers = append(blockers, reviewChildPrefix+ref+\" does not stand: \"+why)\n1822\t\t\t}\n1823\t\t\tchildren = append(children, ReviewBundleChild{Scope: ref, BundleID: sealed.BundleID, BundleDigest: sealed.BundleDigest})\n1824\t\t}\n1825\t\treturn children, blockers, nil\n1826\t}\n1827\t\n1828\t// retainedChildReviewBundle is the approved review a done child keeps after\n1829\t// later commits changed what is prepared for it: the bundle the child's own\n1830\t// verification retains, with every condition that verification applies —\n1831\t// lost attestation history, a later negative review, a changed federated\n1832\t// manifest — or nil and why not (spec pose-review-subject-later-removal R3).\n1833\tfunc (s Store) retainedChildReviewBundle(ref string) (*ReviewBundle, string) {\n1834\t\tverification, err := s.reviewOperation().verifyReviewBundle(ref)\n1835\t\tif err != nil {\n1836\t\t\treturn nil, \": its review could not be verified: \" + err.Error()\n1837\t\t}\n1838\t\tif verification.State != \"closed\" || !verification.Fresh || !verification.Approved || verification.Bundle == nil {\n1839\t\t\tif len(verification.Blockers) > 0 {\n1840\t\t\t\treturn nil, \": \" + strings.Join(uniqueSorted(verification.Blockers), \"; \")\n1841\t\t\t}\n1842\t\t\treturn nil, \"\"\n1843\t\t}\n1844\t\treturn verification.Bundle, \"\"\n1845\t}\n1846\t\n1847\t// reviewChildPrefix opens every blocker that names a child of the scope.\n1848\tconst reviewChildPrefix = \"child \"\n1849\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"f4c88b84-45f4-418b-81b4-3b5f2668acc9","timestamp":"2026-11-10T17:25:45.835Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3468190200/worktree/pose-mcp/internal/pose/review_bundle.go","content":"}\n\nfunc (s Store) reviewBundleChildRefs(scope ScopeRef) ([]string, error) {\n\trefs := []string{}\n\tif scope.Kind == \"milestone\" {\n\t\trm, err := s.GetRoadmap(scope.Roadmap)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tif milestone.ID == scope.Milestone {\n\t\t\t\tfor _, raw := range milestone.Specs {\n\t\t\t\t\t// External members are sealed through the federated\n\t\t\t\t\t// manifest, not as local child bundles.\n\t\t\t\t\tif slug, external := s.milestoneMember(raw); !external {\n\t\t\t\t\t\trefs = append(refs, \"spec:\"+slug)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t} else if scope.Kind == \"roadmap\" {\n\t\trm, err := s.GetRoadmap(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\trefs = append(refs, \"milestone:\"+rm.Slug+\"/\"+milestone.ID)\n\t\t}\n\t}\n\treturn refs, nil\n}\n\nfunc (s Store) reviewBundleChildren(scope ScopeRef) ([]ReviewBundleChild, []string, error) {\n\trefs, err := s.reviewBundleChildRefs(scope)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\ts = s.reviewOperation()\n\tparentDone, _ := s.scopeLifecycleDone(scope)\n\tchildren, blockers := []ReviewBundleChild{}, []string{}\n\tfor _, ref := range refs {\n\t\tif verification, err := s.verifyReviewBundle(ref); err == nil && verification.inherited {\n\t\t\t// A declared milestone has no bundle to seal over: the reason is in the\n\t\t\t// roadmap, which this bundle seals.\n\t\t\tif verification.Bundle != nil {\n\t\t\t\tchildren = append(children, ReviewBundleChild{Scope: ref, BundleID: verification.Bundle.BundleID, BundleDigest: verification.Bundle.BundleDigest})\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tsealed, err := s.CurrentReviewBundle(ref)\n\t\tif err != nil {\n\t\t\treturn nil, nil, err\n\t\t}\n\t\tif sealed == nil {\n\t\t\tretained, why := s.retainedChildReviewBundle(ref)\n\t\t\tif retained == nil {\n\t\t\t\tblockers = append(blockers, \"child \"+ref+\" has no sealed review bundle\"+why)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tsealed = retained\n\t\t} else if why := s.childReviewStanding(ref, parentDone); why != \"\" {\n\t\t\tblockers = append(blockers, reviewChildPrefix+ref+\" does not stand: \"+why)\n\t\t}\n\t\tchildren = append(children, ReviewBundleChild{Scope: ref, BundleID: sealed.BundleID, BundleDigest: sealed.BundleDigest})\n\t}\n\treturn children, blockers, nil\n}\n\n// retainedChildReviewBundle is the approved review a done child keeps after\n// later commits changed what is prepared for it: the bundle the child's own\n// verification retains, with every condition that verification applies —\n// lost attestation history, a later negative review, a changed federated\n// manifest — or nil and why not (spec pose-review-subject-later-removal R3).\nfunc (s Store) retainedChildReviewBundle(ref string) (*ReviewBundle, string) {\n\tverification, err := s.reviewOperation().verifyReviewBundle(ref)\n\tif err != nil {\n\t\treturn nil, \": its review could not be verified: \" + err.Error()\n\t}\n\tif verification.State != \"closed\" || !verification.Fresh || !verification.Approved || verification.Bundle == nil {\n\t\tif len(verification.Blockers) > 0 {\n\t\t\treturn nil, \": \" + strings.Join(uniqueSorted(verification.Blockers), \"; \")\n\t\t}\n\t\treturn nil, \"\"\n\t}\n\treturn verification.Bundle, \"\"\n}\n\n// reviewChildPrefix opens every blocker that names a child of the scope.\nconst reviewChildPrefix = \"child \"\n","numLines":90,"startLine":1760,"totalLines"