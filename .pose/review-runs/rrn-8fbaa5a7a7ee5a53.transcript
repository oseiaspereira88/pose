{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PPHDUH14WkoYh789fxDdC6","type":"tool_result","content":"1850\t// childReviewStanding says why a child's review no longer stands under its\n1851\t// parent, or nothing when it does: the child's own verification decides, so\n1852\t// every way a review stops standing counts (spec\n1853\t// pose-review-approval-follows-children R1-R3, D1).\n1854\tfunc (s Store) childReviewStanding(ref string, parentDone bool) string {\n1855\t\tverification, err := s.reviewOperation().verifyReviewBundle(ref)\n1856\t\tif err != nil {\n1857\t\t\treturn \"its review could not be verified: \" + err.Error()\n1858\t\t}\n1859\t\tif !verification.Fresh || !verification.Approved {\n1860\t\t\tif len(verification.Blockers) > 0 {\n1861\t\t\t\treturn strings.Join(uniqueSorted(verification.Blockers), \"; \")\n1862\t\t\t}\n1863\t\t\treturn \"its review is \" + verification.State\n1864\t\t}\n1865\t\tif parentDone && verification.State != \"closed\" {\n1866\t\t\treturn \"it is not closed: \" + verification.State\n1867\t\t}\n1868\t\treturn \"\"\n1869\t}\n1870\t\n1871\t// reviewChildBlockers are the children a retained bundle integrated that no\n1872\t// longer stand. Only a done scope retains, so its children must be closed.\n1873\tfunc (s Store) reviewChildBlockers(children []ReviewBundleChild) []string {\n1874\t\tblockers := []string{}\n1875\t\tfor _, child := range children {\n1876\t\t\tif why := s.childReviewStanding(child.Scope, true); why != \"\" {\n1877\t\t\t\tblockers = append(blockers, reviewChildPrefix+child.Scope+\" does not stand: \"+why)\n1878\t\t\t}\n1879\t\t}\n1880\t\treturn blockers\n1881\t}\n1882\t\n1883\tfunc blockedByAChild(blockers []string) bool {\n1884\t\tfor _, blocker := range blockers {\n1885\t\t\tif strings.HasPrefix(blocker, reviewChildPrefix) {\n1886\t\t\t\treturn true\n1887\t\t\t}\n1888\t\t}\n1889\t\treturn false\n1890\t}\n1891\t\n1892\tfunc (s Store) reviewBundleConsumedInputs(plan ReviewPlan) []ReviewBundleInput {\n1893\t\tplanDigest, _ := reviewBundlePlanDigest(plan)\n1894\t\tinputs := []ReviewBundleInput{"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"4d9263fb-5d89-4f3b-a841-8bcb65ccbec1","timestamp":"2026-11-10T17:25:55.431Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3468190200/worktree/pose-mcp/internal/pose/review_bundle.go","content":"// childReviewStanding says why a child's review no longer stands under its\n// parent, or nothing when it does: the child's own verification decides, so\n// every way a review stops standing counts (spec\n// pose-review-approval-follows-children R1-R3, D1).\nfunc (s Store) childReviewStanding(ref string, parentDone bool) string {\n\tverification, err := s.reviewOperation().verifyReviewBundle(ref)\n\tif err != nil {\n\t\treturn \"its review could not be verified: \" + err.Error()\n\t}\n\tif !verification.Fresh || !verification.Approved {\n\t\tif len(verification.Blockers) > 0 {\n\t\t\treturn strings.Join(uniqueSorted(verification.Blockers), \"; \")\n\t\t}\n\t\treturn \"its review is \" + verification.State\n\t}\n\tif parentDone && verification.State != \"closed\" {\n\t\treturn \"it is not closed: \" + verification.State\n\t}\n\treturn \"\"\n}\n\n// reviewChildBlockers are the children a retained bundle integrated that no\n// longer stand. Only a done scope retains, so its children must be closed.\nfunc (s Store) reviewChildBlockers(children []ReviewBundleChild) []string {\n\tblockers := []string{}\n\tfor _, child := range children {\n\t\tif why := s.childReviewStanding(child.Scope, true); why != \"\" {\n\t\t\tblockers = append(blockers, reviewChildPrefix+child.Scope+\" does not stand: \"+why)\n\t\t}\n\t}\n\treturn blockers\n}\n\nfunc blockedByAChild(blockers []string) bool {\n\tfor _, blocker := range blockers {\n\t\tif strings.HasPrefix(blocker, reviewChildPrefix) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc (s Store) reviewBundleConsume