{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R4KsbbaydQYbjgSCrXZPiL","type":"tool_result","content":"241\tfunc validateReviewDraft(d ReviewDraft) error {\n242\t\tif d.Schema != ReviewDraftSchema {\n243\t\t\treturn fmt.Errorf(\"the draft's schema is %q, not %s\", d.Schema, ReviewDraftSchema)\n244\t\t}\n245\t\tswitch d.Decision {\n246\t\tcase \"approved\", \"changes-requested\", \"rejected\":\n247\t\tdefault:\n248\t\t\treturn fmt.Errorf(\"the draft's decision %q is not approved, changes-requested or rejected\", d.Decision)\n249\t\t}\n250\t\tif len(d.Findings) > reviewDraftMaxFindings || len(d.PriorFindings) > reviewDraftMaxFindings || len(d.Sweep) > reviewDraftMaxText {\n251\t\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n252\t\t}\n253\t\tseen := map[string]bool{}\n254\t\tfor _, f := range d.Findings {\n255\t\t\tswitch {\n256\t\t\tcase !reviewFindingID.MatchString(f.ID) || reviewRoundPrefix.MatchString(f.ID) || seen[f.ID]:\n257\t\t\t\treturn fmt.Errorf(\"finding id %q is not a unique identifier without a round prefix\", f.ID)\n258\t\t\tcase f.Severity != \"high\" && f.Severity != \"medium\" && f.Severity != \"low\":\n259\t\t\t\treturn fmt.Errorf(\"finding %s: severity %q is not high, medium or low\", f.ID, f.Severity)\n260\t\t\tcase f.Disposition != \"blocker\" && f.Disposition != \"follow-up\":\n261\t\t\t\treturn fmt.Errorf(\"finding %s: disposition %q is not blocker or follow-up\", f.ID, f.Disposition)\n262\t\t\tcase strings.TrimSpace(f.Summary) == \"\" || len(f.Summary) > reviewDraftMaxText || len(f.File) > 1024 || f.Line < 0:\n263\t\t\t\treturn fmt.Errorf(\"finding %s needs a bounded summary and location\", f.ID)\n264\t\t\t}\n265\t\t\tseen[f.ID] = true\n266\t\t}\n267\t\tanswered := map[string]bool{}\n268\t\tfor _, c := range d.Criteria {\n269\t\t\tswitch {\n270\t\t\tcase ValidateSlug(c.ID) != nil || answered[c.ID]:\n271\t\t\t\treturn fmt.Errorf(\"criterion %q is not a unique criterion id\", c.ID)\n272\t\t\tcase c.Disposition != \"passed\" && c.Disposition != \"finding\" && c.Disposition != \"not-applicable\":\n273\t\t\t\treturn fmt.Errorf(\"criterion %s: disposition %q is not passed, finding or not-applicable\", c.ID, c.Disposition)\n274\t\t\tcase len(c.Evidence) > reviewDraftMaxText || len(c.Rationale) > reviewDraftMaxText || len(c.Mappings) > reviewDraftMaxFindings:\n275\t\t\t\treturn fmt.Errorf(\"criterion %s exceeds its bounds\", c.ID)\n276\t\t\t}\n277\t\t\tfor _, m := range c.Mappings {\n278\t\t\t\tif strings.TrimSpace(m.Delta) == \"\" || len(m.Delta) > 256 || len(m.Basis) > 256 || len(m.Disposition) > 64 || len(m.Rationale) > reviewDraftMaxText || len(m.Owner) > 256 || len(m.ReviewBy) > 64 {\n279\t\t\t\t\treturn fmt.Errorf(\"criterion %s: a mapping needs a delta and bounded text\", c.ID)\n280\t\t\t\t}\n281\t\t\t}\n282\t\t\tanswered[c.ID] = true\n283\t\t}\n284\t\tfor _, t := range d.Tools {\n285\t\t\tif ValidateSlug(t.ID) != nil || strings.TrimSpace(t.Disposition) == \"\" || len(t.Evidence) > reviewDraftMaxText || len(t.Rationale) > reviewDraftMaxText || len(t.Component) > 256 {\n286\t\t\t\treturn fmt.Errorf(\"tool %q needs an id, a disposition and bounded text\", t.ID)\n287\t\t\t}\n288\t\t}\n289\t\tfor _, f := range d.Findings {\n290\t\t\tif len(f.Action) > reviewDraftMaxText || len(f.Owner) > 256 || len(f.ReviewBy) > 64 {\n291\t\t\t\treturn fmt.Errorf(\"finding %s exceeds its bounds\", f.ID)\n292\t\t\t}\n293\t\t}\n294\t\tif len(d.Criteria) > reviewDraftMaxFindings || len(d.Tools) > reviewDraftMaxFindings || len(d.Questions) > reviewDraftMaxFindings || len(d.Surfaces) > reviewDraftMaxFindings {\n295\t\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n296\t\t}\n297\t\tif b := d.BusinessDecision; b != nil {\n298\t\t\tif strings.TrimSpace(b.Question) == \"\" || len(b.Question) > reviewDraftMaxText || len(b.Options) < 2 || len(b.Options) > 8 {\n299\t\t\t\treturn fmt.Errorf(\"a business decision needs a bounded question and two to eight options\")\n300\t\t\t}\n301\t\t\tseen := map[string]bool{}\n302\t\t\tfor _, o := range b.Options {\n303\t\t\t\tif ValidateSlug(o.ID) != nil || seen[o.ID] || strings.TrimSpace(o.Consequence) == \"\" || len(o.Consequence) > reviewDraftMaxText {\n304\t\t\t\t\treturn fmt.Errorf(\"business decision option %q needs a unique slug and its consequence\", o.ID)\n305\t\t\t\t}\n306\t\t\t\tseen[o.ID] = true\n307\t\t\t}\n308\t\t}\n309\t\tasked := map[string]bool{}\n310\t\tfor _, q := range d.Questions {\n311\t\t\tswitch {\n312\t\t\tcase !adjudicationQuestionID.MatchString(q.ID) || asked[q.ID]:\n313\t\t\t\treturn fmt.Errorf(\"question %q is not a unique decision or requirement id\", q.ID)\n314\t\t\tcase q.Verdict != AdjudicationHolds && q.Verdict != AdjudicationDoesNotHold && q.Verdict != AdjudicationCannotDetermine:\n315\t\t\t\treturn fmt.Errorf(\"question %s: verdict %q is not holds, does-not-hold or cannot-determine\", q.ID, q.Verdict)\n316\t\t\tcase strings.TrimSpace(q.Rationale) == \"\" || len(q.Rationale) > reviewDraftMaxText || len(q.Evidence) > reviewDraftMaxText:\n317\t\t\t\treturn fmt.Errorf(\"question %s needs a bounded rationale\", q.ID)\n318\t\t\t}\n319\t\t\tasked[q.ID] = true\n320\t\t}\n321\t\tobserved := map[string]bool{}\n322\t\tfor _, sf := range d.Surfaces {\n323\t\t\tswitch {\n324\t\t\tcase !deliveryRefRE.MatchString(sf.Ref) || observed[sf.Ref]:\n325\t\t\t\treturn fmt.Errorf(\"surface %q is not a unique delivery target\", sf.Ref)\n326\t\t\tcase sf.Outcome != SmokeObserved && sf.Outcome != SmokeNotObserved && sf.Outcome != SmokeNotReachable:\n327\t\t\t\treturn fmt.Errorf(\"surface %s: outcome %q is not observed, not-observed or not-reachable\", sf.Ref, sf.Outcome)\n328\t\t\tcase len(sf.Commands) == 0 || len(sf.Commands) > 64 || strings.TrimSpace(sf.Observed) == \"\" || len(sf.Observed) > reviewDraftMaxText:\n329\t\t\t\treturn fmt.Errorf(\"surface %s needs the commands run and what was observed\", sf.Ref)\n330\t\t\t}\n331\t\t\tfor _, c := range sf.Commands {\n332\t\t\t\tif strings.TrimSpace(c) == \"\" || len(c) > 1024 {\n333\t\t\t\t\treturn fmt.Errorf(\"surface %s: a command must be non-empty and bounded\", sf.Ref)\n334\t\t\t\t}\n335\t\t\t}\n336\t\t\tobserved[sf.Ref] = true\n337\t\t}\n338\t\taccounted := map[string]bool{}\n339\t\tfor _, p := range d.PriorFindings {\n340\t\t\tswitch {\n341\t\t\tcase !reviewCarriedID.MatchString(p.ID) || accounted[p.ID]:\n342\t\t\t\treturn fmt.Errorf(\"prior finding id %q is not a unique carried identifier\", p.ID)\n343\t\t\tcase p.Status != PriorFindingFixed && p.Status != PriorFindingPartial && p.Status != PriorFindingNotFixed && p.Status != PriorFindingSuperseded:\n344\t\t\t\treturn fmt.Errorf(\"prior finding %s: status %q is not fixed, partial, not-fixed or superseded\", p.ID, p.Status)\n345\t\t\tcase len(p.Evidence) > reviewDraftMaxText:\n346\t\t\t\treturn fmt.Errorf(\"prior finding %s: evidence exceeds its bound\", p.ID)\n347\t\t\t}\n348\t\t\taccounted[p.ID] = true\n349\t\t}\n350\t\treturn nil\n351\t}\n352\t\n353\t// ReviewOpenFinding is a finding a round must account for: its identity\n354\t// across rounds, the round it was first reported in, its details and, when it\n355\t// was carried, the account the last round gave it (R2, R5).\n356\ttype ReviewOpenFinding struct {\n357\t\tID          string\n358\t\tRound       int\n359\t\tSeverity    string\n360\t\tDisposition string\n361\t\tFile        string\n362\t\tLine        int\n363\t\tSummary     string\n364\t\tCarried     string\n365\t}\n366\t\n367\t// ReviewRound is the round a bundle is in and what it must account for.\n368\ttype ReviewRound struct {\n369\t\tNumber int\n370\t\t// Prior is the run that concluded the round before, nil in round 1.\n371\t\tPrior       *ReviewRun\n372\t\tPriorBundle *ReviewBundle\n373\t\t// Open are the findings this round must account for.\n374\t\tOpen []ReviewOpenFinding\n375\t\t// Broken names the drafts of the chain that could not be read: a round\n376\t\t// after one opens a new session; its open findings stay open.\n377\t\tBroken string\n378\t}\n379\t\n380\t// roundFindingID is the identity a finding gets when first reported in round.\n381\tfunc roundFindingID(round int, id string) string {\n382\t\treturn fmt.Sprintf(\"R%d-%s\", round, id)\n383\t}\n384\t\n385\t// concludingReviewRun is the run a round concluded with on bundle: of the\n386\t// completed review runs of it that no run supersedes, the one that ended\n387\t// last, the run id breaking a tie (review round 2, R2-F1).\n388\tfunc concludingReviewRun(runs []ReviewRun, bundleID string) *ReviewRun {\n389\t\tvar out *ReviewRun\n390\t\tvar outEnded time.Time\n391\t\tfor i := range runs {\n392\t\t\tr := &runs[i]\n393\t\t\tif r.BundleID != bundleID || r.Kind != ReviewBriefKindReview || r.Status != ReviewRunCompleted || r.SupersededBy != \"\" {\n394\t\t\t\tcontinue\n395\t\t\t}\n396\t\t\tended, _ := time.Parse(time.RFC3339Nano, r.EndedAt)\n397\t\t\tif out == nil || ended.After(outEnded) || ended.Equal(outEnded) && r.RunID > out.RunID {\n398\t\t\t\tout, outEnded = r, ended\n399\t\t\t}\n400\t\t}\n401\t\treturn out\n402\t}\n403\t\n404\t// ReviewRoundOf derives the round of bundle from the sealed bundles of its\n405\t// scope and the run history (R1). A history or a bundle inventory with a loss\n406\t// that may concern the scope, a previous round whose record is not intact,\n407\t// or a run of the scope whose bundle is missing make it fail: a round is\n408\t// never silently lowered (security; review round 1, B9).\n409\tfunc (s Store) ReviewRoundOf(bundle ReviewBundle) (ReviewRound, error) {\n410\t\truns, lost, err := s.ReadReviewRuns(\"\")\n411\t\tif err != nil {\n412\t\t\treturn ReviewRound{}, err\n413\t\t}\n414\t\tif len(lost) > 0 {\n415\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: the review run history is incomplete, so the round of %s cannot be derived: %v\", bundle.BundleID, lost)\n416\t\t}\n417\t\tscope := bundle.Payload.Scope.Ref\n418\t\tread, err := s.ReadReviewBundles(scope)\n419\t\tif err != nil {\n420\t\t\treturn ReviewRound{}, err\n421\t\t}\n422\t\tfor _, loss := range read.Coverage.Losses {\n423\t\t\tif loss.Scope == \"\" || loss.Scope == scope || loss.Scope == bundle.Payload.Scope.Slug {\n424\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: a sealed bundle that may belong to %s could not be read (%s), so its round cannot be derived\", scope, loss.Artifact)\n425\t\t\t}\n426\t\t}\n427\t\tpresent := map[string]bool{}\n428\t\tfor _, b := range read.Bundles {\n429\t\t\tpresent[b.BundleID] = true\n430\t\t}\n431\t\tfor _, r := range runs {\n432\t\t\tif r.Scope == scope && r.Kind == ReviewBriefKindReview && r.Status == ReviewRunCompleted && !present[r.BundleID] && r.BundleID != bundle.BundleID {\n433\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s reviewed bundle %s of %s, which is missing, so the round cannot be derived\", r.RunID, r.BundleID, scope)\n434\t\t\t}\n435\t\t}\n436\t\treturn reviewRoundFrom(bundle, read.Bundles, runs, s.reviewRunTranscriptIntact)\n437\t}\n438\t\n439\t// reviewRoundFrom derives the round of bundle from bundles and runs; intact\n440\t// says why a run's record is not intact, or \"\".\n441\tfunc reviewRoundFrom(bundle ReviewBundle, bundles []ReviewBundle, runs []ReviewRun, intact func(ReviewRun) string) (ReviewRound, error) {\n442\t\ttype concluded struct {\n443\t\t\tbundle ReviewBundle\n444\t\t\trun    *ReviewRun\n445\t\t\tended  time.Time\n446\t\t}\n447\t\t// A round precedes bundle when its concluding run ended no later than the\n448\t\t// second bundle was sealed in: a bundle is sealed after the rejection it\n449\t\t// answers. Seals have second precision, runs nanoseconds, so the runs, as\n450\t\t// instants, order the chain (D4; review round 1, B3).\n451\t\tsealed, sealErr := time.Parse(time.RFC3339, bundle.SealedAt)\n452\t\tvar chain []concluded\n453\t\tfor _, b := range bundles {\n454\t\t\tif b.BundleID == bundle.BundleID || b.BundleDigest == bundle.BundleDigest {\n455\t\t\t\tcontinue\n456\t\t\t}\n457\t\t\trun := concludingReviewRun(runs, b.BundleID)\n458\t\t\tif run == nil {\n459\t\t\t\tcontinue\n460\t\t\t}\n461\t\t\tended, err := time.Parse(time.RFC3339Nano, run.EndedAt)\n462\t\t\tif err != nil {\n463\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s records no valid end, so the order of the rounds cannot be derived\", run.RunID)\n464\t\t\t}\n465\t\t\tif bundle.SealedAt != \"\" && sealErr == nil && ended.Truncate(time.Second).After(sealed) {\n466\t\t\t\tcontinue\n467\t\t\t}\n468\t\t\tchain = append(chain, concluded{b, run, ended})\n469\t\t}\n470\t\tsort.SliceStable(chain, func(i, j int) bool {\n471\t\t\tif !chain[i].ended.Equal(chain[j].ended) {\n472\t\t\t\treturn chain[i].ended.Before(chain[j].ended)\n473\t\t\t}\n474\t\t\treturn chain[i].run.RunID < chain[j].run.RunID\n475\t\t})\n476\t\tround := ReviewRound{Number: len(chain) + 1}\n477\t\tvar open []ReviewOpenFinding\n478\t\tvar broken []string\n479\t\tfor i, c := range chain {\n480\t\t\tnumber := i + 1\n481\t\t\tif why := intact(*c.run); why != \"\" {\n482\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: the run of round %d (%s) is not intact, so its findings cannot be carried: %s\", number, c.run.RunID, why)\n483\t\t\t}\n484\t\t\tdraft, err := ParseReviewDraft(c.run.Output)\n485\t\t\tif draft == nil || err != nil {\n486\t\t\t\twhy := \"it carries no pose-draft block\"\n487\t\t\t\tif err != nil {\n488\t\t\t\t\twhy = err.Error()\n489\t\t\t\t}\n490\t\t\t\t// What this round said cannot be read: nothing is added, and\n491\t\t\t\t// nothing open is closed (review round 1, B1).\n492\t\t\t\tbroken = append(broken, fmt.Sprintf(\"the draft of round %d (%s) cannot be read: %s\", number, c.run.RunID, why))\n493\t\t\t\tcontinue\n494\t\t\t}\n495\t\t\taccounted := map[string]ReviewDraftPrior{}\n496\t\t\tfor _, p := range draft.PriorFindings {\n497\t\t\t\taccounted[p.ID] = p\n498\t\t\t}\n499\t\t\t// A finding leaves the open set only when this round reported it\n500\t\t\t// fixed with evidence, or superseded; unaccounted or unevidenced, it\n501\t\t\t// stays open, so an invalid account never closes it (B1).\n502\t\t\tvar next []ReviewOpenFinding\n503\t\t\tfor _, f := range open {\n504\t\t\t\tp, ok := accounted[f.ID]\n505\t\t\t\tswitch {\n506\t\t\t\tcase !ok:\n507\t\t\t\t\tf.Carried = \"unaccounted\"\n508\t\t\t\tcase p.Status == PriorFindingFixed && strings.TrimSpace(p.Evidence) == \"\":\n509\t\t\t\t\tf.Carried = \"fixed-without-evidence\"\n510\t\t\t\tcase p.Status == PriorFindingFixed || p.Status == PriorFindingSuperseded:\n511\t\t\t\t\tcontinue\n512\t\t\t\tdefault:\n513\t\t\t\t\tf.Carried = p.Status\n514\t\t\t\t}\n515\t\t\t\tnext = append(next, f)\n516\t\t\t}\n517\t\t\tfor _, f := range draft.Findings {\n518\t\t\t\tnext = append(next, ReviewOpenFinding{ID: roundFindingID(number, f.ID), Round: number, Severity: f.Severity, Disposition: f.Disposition, File: f.File, Line: f.Line, Summary: f.Summary})\n519\t\t\t}\n520\t\t\topen = next\n521\t\t}\n522\t\tif len(chain) > 0 {\n523\t\t\tlast := chain[len(chain)-1]\n524\t\t\tround.Prior, round.PriorBundle = last.run, &last.bundle\n525\t\t}\n526\t\tround.Open, round.Broken = open, strings.Join(broken, \"; \")\n527\t\treturn round, nil\n528\t}\n529\t\n530\t// ValidateRoundDraft judges a draft of round against R3 and R4: from round 2\n531\t// on, every open finding is accounted for, a fixed one with evidence, and the\n532\t// sweep is stated. It returns the problems; none means valid.\n533\tfunc ValidateRoundDraft(round ReviewRound, output string) []string {\n534\t\tdraft, err := ParseReviewDraft(output)\n535\t\tif err != nil {\n536\t\t\treturn []string{err.Error()}\n537\t\t}\n538\t\tvar problems []string\n539\t\topen := map[string]bool{}\n540\t\tfor _, f := range round.Open {\n541\t\t\topen[f.ID] = true\n542\t\t}\n543\t\tif draft != nil {\n544\t\t\t// An account of a finding no round reported is not an account: it\n545\t\t\t// would count as convergence without a defect (review round 2, R2-B3).\n546\t\t\tfor _, p := range draft.PriorFindings {\n547\t\t\t\tif !open[p.ID] {\n548\t\t\t\t\tproblems = append(problems, \"prior finding \"+p.ID+\" is not an open finding of the scope's rounds\")\n549\t\t\t\t}\n550\t\t\t}\n551\t\t}\n552\t\tif round.Number < 2 {\n553\t\t\treturn problems\n554\t\t}\n555\t\tif draft == nil {\n556\t\t\treturn []string{\"a draft of round \" + fmt.Sprint(round.Number) + \" needs a pose-draft block\"}\n557\t\t}\n558\t\taccounted := map[string]ReviewDraftPrior{}\n559\t\tfor _, p := range draft.PriorFindings {\n560\t\t\taccounted[p.ID] = p\n561\t\t}\n562\t\tfor _, f := range round.Open {\n563\t\t\tp, ok := accounted[f.ID]\n564\t\t\tswitch {\n565\t\t\tcase !ok:\n566\t\t\t\tproblems = append(problems, \"prior finding \"+f.ID+\" is not accounted for\")\n567\t\t\tcase p.Status == PriorFindingFixed && strings.TrimSpace(p.Evidence) == \"\":\n568\t\t\t\tproblems = append(problems, \"prior finding \"+f.ID+\" is reported fixed with no evidence\")\n569\t\t\t}\n570\t\t}\n571\t\tif strings.TrimSpace(draft.Sweep) == \"\" {\n572\t\t\tproblems = append(problems, \"the draft does not state what it swept\")\n573\t\t}\n574\t\treturn problems\n575\t}\n576\t\n577\t// quoteLedgerText renders text an earlier reviewer wrote as one quoted line:\n578\t// whitespace collapsed, backticks neutralized, so it can open no section and\n579\t// carry no instruction of its own (review round 1, B4).\n580\tfunc quoteLedgerText(text string) string {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"f0a87f64-d36b-44c8-bbf6-68807866b835","timestamp":"2026-11-26T01:58:52.356Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2569977521/worktree/pose-mcp/internal/pose/review_rounds.go","content":"func validateReviewDraft(d ReviewDraft) error {\n\tif d.Schema != ReviewDraftSchema {\n\t\treturn fmt.Errorf(\"the draft's schema is %q, not %s\", d.Schema, ReviewDraftSchema)\n\t}\n\tswitch d.Decision {\n\tcase \"approved\", \"changes-requested\", \"rejected\":\n\tdefault:\n\t\treturn fmt.Errorf(\"the draft's decision %q is not approved, changes-requested or rejected\", d.Decision)\n\t}\n\tif len(d.Findings) > reviewDraftMaxFindings || len(d.PriorFindings) > reviewDraftMaxFindings || len(d.Sweep) > reviewDraftMaxText {\n\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n\t}\n\tseen := map[string]bool{}\n\tfor _, f := range d.Findings {\n\t\tswitch {\n\t\tcase !reviewFindingID.MatchString(f.ID) || reviewRoundPrefix.MatchString(f.ID) || seen[f.ID]:\n\t\t\treturn fmt.Errorf(\"finding id %q is not a unique identifier without a round prefix\", f.ID)\n\t\tcase f.Severity != \"high\" && f.Severity != \"medium\" && f.Severity != \"low\":\n\t\t\treturn fmt.Errorf(\"finding %s: severity %q is not high, medium or low\", f.ID, f.Severity)\n\t\tcase f.Disposition != \"blocker\" && f.Disposition != \"follow-up\":\n\t\t\treturn fmt.Errorf(\"finding %s: disposition %q is not blocker or follow-up\", f.ID, f.Disposition)\n\t\tcase strings.TrimSpace(f.Summary) == \"\" || len(f.Summary) > reviewDraftMaxText || len(f.File) > 1024 || f.Line < 0:\n\t\t\treturn fmt.Errorf(\"finding %s needs a bounded summary and location\", f.ID)\n\t\t}\n\t\tseen[f.ID] = true\n\t}\n\tanswered := map[string]bool{}\n\tfor _, c := range d.Criteria {\n\t\tswitch {\n\t\tcase ValidateSlug(c.ID) != nil || answered[c.ID]:\n\t\t\treturn fmt.Errorf(\"criterion %q is not a unique criterion id\", c.ID)\n\t\tcase c.Disposition != \"passed\" && c.Disposition != \"finding\" && c.Disposition != \"not-applicable\":\n\t\t\treturn fmt.Errorf(\"criterion %s: disposition %q is not passed, finding or not-applicable\", c.ID, c.Disposition)\n\t\tcase len(c.Evidence) > reviewDraftMaxText || len(c.Rationale) > reviewDraftMaxText || len(c.Mappings) > reviewDraftMaxFindings:\n\t\t\treturn fmt.Errorf(\"criterion %s exceeds its bounds\", c.ID)\n\t\t}\n\t\tfor _, m := range c.Mappings {\n\t\t\tif strings.TrimSpace(m.Delta) == \"\" || len(m.Delta) > 256 || len(m.Basis) > 256 || len(m.Disposition) > 64 || len(m.Rationale) > reviewDraftMaxText || len(m.Owner) > 256 || len(m.ReviewBy) > 64 {\n\t\t\t\treturn fmt.Errorf(\"criterion %s: a mapping needs a delta and bounded text\", c.ID)\n\t\t\t}\n\t\t}\n\t\tanswered[c.ID] = true\n\t}\n\tfor _, t := range d.Tools {\n\t\tif ValidateSlug(t.ID) != nil || strings.TrimSpace(t.Disposition) == \"\" || len(t.Evidence) > reviewDraftMaxText || len(t.Rationale) > reviewDraftMaxText || len(t.Component) > 256 {\n\t\t\treturn fmt.Errorf(\"tool %q needs an id, a disposition and bounded text\", t.ID)\n\t\t}\n\t}\n\tfor _, f := range d.Findings {\n\t\tif len(f.Action) > reviewDraftMaxText || len(f.Owner) > 256 || len(f.ReviewBy) > 64 {\n\t\t\treturn fmt.Errorf(\"finding %s exceeds its bounds\", f.ID)\n\t\t}\n\t}\n\tif len(d.Criteria) > reviewDraftMaxFindings || len(d.Tools) > reviewDraftMaxFindings || len(d.Questions) > reviewDraftMaxFindings || len(d.Surfaces) > reviewDraftMaxFindings {\n\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n\t}\n\tif b := d.BusinessDecision; b != nil {\n\t\tif strings.TrimSpace(b.Question) == \"\" || len(b.Question) > reviewDraftMaxText || len(b.Options) < 2 || len(b.Options) > 8 {\n\t\t\treturn fmt.Errorf(\"a business decision needs a bounded question and two to eight options\")\n\t\t}\n\t\tseen := map[string]bool{}\n\t\tfor _, o := range b.Options {\n\t\t\tif ValidateSlug(o.ID) != nil || seen[o.ID] || strings.TrimSpace(o.Consequence) == \"\" || len(o.Consequence) > reviewDraftMaxText {\n\t\t\t\treturn fmt.Errorf(\"business decision option %q needs a unique slug and its consequence\", o.ID)\n\t\t\t}\n\t\t\tseen[o.ID] = true\n\t\t}\n\t}\n\tasked := map[string]bool{}\n\tfor _, q := range d.Questions {\n\t\tswitch {\n\t\tcase !adjudicationQuestionID.MatchString(q.ID) || asked[q.ID]:\n\t\t\treturn fmt.Errorf(\"question %q is not a unique decision or requirement id\", q.ID)\n\t\tcase q.Verdict != AdjudicationHolds && q.Verdict != AdjudicationDoesNotHold && q.Verdict != AdjudicationCannotDetermine:\n\t\t\treturn fmt.Errorf(\"question %s: verdict %q is not holds, does-not-hold or cannot-determine\", q.ID, q.Verdict)\n\t\tcase strings.TrimSpace(q.Rationale) == \"\" || len(q.Rationale) > reviewDraftMaxText || len(q.Evidence) > reviewDraftMaxText:\n\t\t\treturn fmt.Errorf(\"question %s needs a bounded rationale\", q.ID)\n\t\t}\n\t\tasked[q.ID] = true\n\t}\n\tobserved := map[string]bool{}\n\tfor _, sf := range d.Surfaces {\n\t\tswitch {\n\t\tcase !deliveryRefRE.MatchString(sf.Ref) || observed[sf.Ref]:\n\t\t\treturn fmt.Errorf(\"surface %q is not a unique delivery target\", sf.Ref)\n\t\tcase sf.Outcome != SmokeObserved && sf.Outcome != SmokeNotObserved && sf.Outcome != SmokeNotReachable:\n\t\t\treturn fmt.Errorf(\"surface %s: outcome %q is not observed, not-observed or not-reachable\", sf.Ref, sf.Outcome)\n\t\tcase len(sf.Commands) == 0 || len(sf.Commands) > 64 || strings.TrimSpace(sf.Observed) == \"\" || len(sf.Observed) > reviewDraftMaxText:\n\t\t\treturn fmt.Errorf(\"surface %s needs the commands run and what was observed\", sf.Ref)\n\t\t}\n\t\tfor _, c := range sf.Commands {\n\t\t\tif strings.TrimSpace(c) == \"\" || len(c) > 1024 {\n\t\t\t\treturn fmt.Errorf(\"surface %s: a command must be non-empty and bounded\", sf.Ref)\n\t\t\t}\n\t\t}\n\t\tobserved[sf.Ref] = true\n\t}\n\taccounted := map[string]bool{}\n\tfor _, p := range d.PriorFindings {\n\t\tswitch {\n\t\tcase !reviewCarriedID.MatchString(p.ID) || accounted[p.ID]:\n\t\t\treturn fmt.Errorf(\"prior finding id %q is not a unique carried identifier\", p.ID)\n\t\tcase p.Status != PriorFindingFixed && p.Status != PriorFindingPartial && p.Status != PriorFindingNotFixed && p.Status != PriorFindingSuperseded:\n\t\t\treturn fmt.Errorf(\"prior finding %s: status %q is not fixed, partial, not-fixed or superseded\", p.ID, p.Status)\n\t\tcase len(p.Evidence) > reviewDraftMaxText:\n\t\t\treturn fmt.Errorf(\"prior finding %s: evidence exceeds its bound\", p.ID)\n\t\t}\n\t\taccounted[p.ID] = true\n\t}\n\treturn nil\n}\n\n// ReviewOpenFinding is a finding a round must account for: its identity\n// across rounds, the round it was first reported in, its details and, when it\n// was carried, the account the last round gave it (R2, R5).\ntype ReviewOpenFinding struct {\n\tID          string\n\tRound       int\n\tSeverity    string\n\tDisposition string\n\tFile        string\n\tLine        int\n\tSummary     string\n\tCarried     string\n}\n\n// ReviewRound is the round a bundle is in and what it must account for.\ntype ReviewRound struct {\n\tNumber int\n\t// Prior is the run that concluded the round before, nil in round 1.\n\tPrior       *ReviewRun\n\tPriorBundle *ReviewBundle\n\t// Open are the findings this round must account for.\n\tOpen []ReviewOpenFinding\n\t// Broken names the drafts of the chain that could not be read: a round\n\t// after one opens a new session; its open findings stay open.\n\tBroken string\n}\n\n// roundFindingID is the identity a finding gets when first reported in round.\nfunc roundFindingID(round int, id string) string {\n\treturn fmt.Sprintf(\"R%d-%s\", round, id)\n}\n\n// concludingReviewRun is the run a round concluded with on bundle: of the\n// completed review runs of it that no run supersedes, the one that ended\n// last, the run id breaking a tie (review round 2, R2-F1).\nfunc concludingReviewRun(runs []ReviewRun, bundleID string) *ReviewRun {\n\tvar out *ReviewRun\n\tvar outEnded time.Time\n\tfor i := range runs {\n\t\tr := &runs[i]\n\t\tif r.BundleID != bundleID || r.Kind != ReviewBriefKindReview || r.Status != ReviewRunCompleted || r.SupersededBy != \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tended, _ := time.Parse(time.RFC3339Nano, r.EndedAt)\n\t\tif out == nil || ended.After(outEnded) || ended.Equal(outEnded) && r.RunID > out.RunID {\n\t\t\tout, outEnded = r, ended\n\t\t}\n\t}\n\treturn out\n}\n\n// ReviewRoundOf derives the round of bundle from the sealed bundles of its\n// scope and the run history (R1). A history or a bundle inventory with a loss\n// that may concern the scope, a previous round whose record is not intact,\n// or a run of the scope whose bundle is missing make it fail: a round is\n// never silently lowered (security; review round 1, B9).\nfunc (s Store) ReviewRoundOf(bundle ReviewBundle) (ReviewRound, error) {\n\truns, lost, err := s.ReadReviewRuns(\"\")\n\tif err != nil {\n\t\treturn ReviewRound{}, err\n\t}\n\tif len(lost) > 0 {\n\t\treturn ReviewRound{}, fmt.Errorf(\"pose: the review run history is incomplete, so the round of %s cannot be derived: %v\", bundle.BundleID, lost)\n\t}\n\tscope := bundle.Payload.Scope.Ref\n\tread, err := s.ReadReviewBundles(scope)\n\tif err != nil {\n\t\treturn ReviewRound{}, err\n\t}\n\tfor _, loss := range read.Coverage.Losses {\n\t\tif loss.Scope == \"\" || loss.Scope == scope || loss.Scope == bundle.Payload.Scope.Slug {\n\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: a sealed bundle that may belong to %s could not be read (%s), so its round cannot be derived\", scope, loss.Artifact)\n\t\t}\n\t}\n\tpresent := map[string]bool{}\n\tfor _, b := range read.Bundles {\n\t\tpresent[b.BundleID] = true\n\t}\n\tfor _, r := range runs {\n\t\tif r.Scope == scope && r.Kind == ReviewBriefKindReview && r.Status == ReviewRunCompleted && !present[r.BundleID] && r.BundleID != bundle.BundleID {\n\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s reviewed bundle %s of %s, which is missing, so the round cannot be derived\", r.RunID, r.BundleID, scope)\n\t\t}\n\t}\n\treturn reviewRoundFrom(bundle, read.Bundles, runs, s.reviewRunTranscriptIntact)\n}\n\n// reviewRoundFrom derives the round of bundle from bundles and runs; intact\n// says why a run's record is not intact, or \"\".\nfunc reviewRoundFrom(bundle ReviewBundle, bundles []ReviewBundle, runs []ReviewRun, intact func(ReviewRun) string) (ReviewRound, error) {\n\ttype concluded struct {\n\t\tbundle ReviewBundle\n\t\trun    *ReviewRun\n\t\tended  time.Time\n\t}\n\t// A round precedes bundle when its concluding run ended no later than the\n\t// second bundle was sealed in: a bundle is sealed after the rejection it\n\t// answers. Seals have second precision, runs nanoseconds, so the runs, as\n\t// instants, order the chain (D4; review round 1, B3).\n\tsealed, sealErr := time.Parse(time.RFC3339, bundle.SealedAt)\n\tvar chain []concluded\n\tfor _, b := range bundles {\n\t\tif b.BundleID == bundle.BundleID || b.BundleDigest == bundle.BundleDigest {\n\t\t\tcontinue\n\t\t}\n\t\trun := concludingReviewRun(runs, b.BundleID)\n\t\tif run == nil {\n\t\t\tcontinue\n\t\t}\n\t\tended, err := time.Parse(time.RFC3339Nano, run.EndedAt)\n\t\tif err != nil {\n\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s records no valid end, so the order of the rounds cannot be derived\", run.RunID)\n\t\t}\n\t\tif bundle.SealedAt != \"\" && sealErr == nil && ended.Truncate(time.Second).After(sealed) {\n\t\t\tcontinue\n\t\t}\n\t\tchain = append(chain, concluded{b, run, ended})\n\t}\n\tsort.SliceStable(chain, func(i, j int) bool {\n\t\tif !chain[i].ended.Equal(chain[j].ended) {\n\t\t\treturn chain[i].ended.Before(chain[j].ended)\n\t\t}\n\t\treturn chain[i].run.RunID < chain[j].run.RunID\n\t})\n\tround := ReviewRound{Number: len(chain) + 1}\n\tvar open []ReviewOpenFinding\n\tvar broken []string\n\tfor i, c := range chain {\n\t\tnumber := i + 1\n\t\tif why := intact(*c.run); why != \"\" {\n\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: the run of round %d (%s) is not intact, so its findings cannot be carried: %s\", number, c.run.RunID, why)\n\t\t}\n\t\tdraft, err := ParseReviewDraft(c.run.Output)\n\t\tif draft == nil || err != nil {\n\t\t\twhy := \"it carries no pose-draft block\"\n\t\t\tif err != nil {\n\t\t\t\twhy = err.Error()\n\t\t\t}\n\t\t\t// What this round said cannot be read: nothing is added, and\n\t\t\t// nothing open is closed (review round 1, B1).\n\t\t\tbroken = append(broken, fmt.Sprintf(\"the draft of round %d (%s) cannot be read: %s\", number, c.run.RunID, why))\n\t\t\tcontinue\n\t\t}\n\t\taccounted := map[string]ReviewDraftPrior{}\n\t\tfor _, p := range draft.PriorFindings {\n\t\t\taccounted[p.ID] = p\n\t\t}\n\t\t// A finding leaves the open set only when this round reported it\n\t\t// fixed with evidence, or superseded; unaccounted or unevidenced, it\n\t\t// stays open, so an invalid account never closes it (B1).\n\t\tvar next []ReviewOpenFinding\n\t\tfor _, f := range open {\n\t\t\tp, ok := accounted[f.ID]\n\t\t\tswitch {\n\t\t\tcase !ok:\n\t\t\t\tf.Carried = \"unaccounted\"\n\t\t\tcase p.Status == PriorFindingFixed && strings.TrimSpace(p.Evidence) == \"\":\n\t\t\t\tf.Carried = \"fixed-without-evidence\"\n\t\t\tcase p.Status == PriorFindingFixed || p.Status == PriorFindingSuperseded:\n\t\t\t\tcontinue\n\t\t\tdefault:\n\t\t\t\tf.Carried = p.Status\n\t\t\t}\n\t\t\tnext = append(next, f)\n\t\t}\n\t\tfor _, f := range draft.Findings {\n\t\t\tnext = append(next, ReviewOpenFinding{ID: roundFindingID(number, f.ID), Round: number, Severity: f.Severity, Disposition: f.Disposition, File: f.File, Line: f.Line, Summary: f.Summary})\n\t\t}\n\t\topen = next\n\t}\n\tif len(chain) > 0 {\n\t\tlast := chain[len(chain)-1]\n\t\tround.Prior, round.PriorBundle = last.run, &last.bundle\n\t}\n\tround.Open, round.Broken = open, strings.Join(broken, \"; \")\n\treturn round, nil\n}\n\n// ValidateRoundDraft judges a draft of round against R3 and R4: from round 2\n// on, every open finding is accounted for, a fixed one with evidence, and the\n// sweep is stated. It returns the problems; none means valid.\nfunc ValidateRoundDraft(round ReviewRound, output string) []string {\n\tdraft, err := ParseReviewDraft(output)\n\tif err != nil {\n\t\treturn []string{err.Error()}\n\t}\n\tvar problems []string\n\topen := map[string]bool{}\n\tfor _, f := range round.Open {\n\t\topen[f.ID] = true\n\t}\n\tif draft != nil {\n\t\t// An account of a finding no round reported is not an account: it\n\t\t// would count as convergence without a defect (review round 2, R2-B3).\n\t\tfor _, p := range draft.PriorFindings {\n\t\t\tif !open[p.ID] {\n\t\t\t\tproblems = append(problems, \"prior finding \"+p.ID+\" is not an open finding of the scope's rounds\")\n\t\t\t}\n\t\t}\n\t}\n\tif round.Number < 2 {\n\t\treturn problems\n\t}\n\tif draft == nil {\n\t\treturn []string{\"a draft of round \" + fmt.Sprint(round.Number) + \" needs a pose-draft block\"}\n\t}\n\taccounted := map[string]ReviewDraftPrior{}\n\tfor _, p := range draft.PriorFindings {\n\t\taccounted[p.ID] = p\n\t}\n\tfor _, f := range round.Open {\n\t\tp, ok := accounted[f.ID]\n\t\tswitch {\n\t\tcase !ok:\n\t\t\tproblems = append(problems, \"prior finding \"+f.ID+\" is not accounted for\")\n\t\tcase p.Status == PriorFindingFixed && strings.TrimSpace(p.Evidence) == \"\":\n\t\t\tproblems = append(problems, \"prior finding \"+f.ID+\" is reported fixed with no evidence\")\n\t\t}\n\t}\n\tif strings.TrimSpace(draft.Sweep) == \"\" {\n\t\tproblems = append(problems, \"the draft does not state what it swept\")\n\t}\n\treturn problems\n}\n\n// quoteLedgerText renders text an earlier reviewer wrote as one quoted line:\n// whitespace collapsed, backticks neutralized, so it can open no section and\n// carry no instruction of its own (review round 1, B4).\nfunc quoteLedgerText(text string) string {","numLines":340,"startLine":241,"totalLines":895}},"tool_result_meta":[{"id":"toolu_01R4KsbbaydQYbjgSCrXZPiL","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
