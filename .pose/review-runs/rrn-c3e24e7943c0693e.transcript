{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KPDJnDGWXPi5ohnPKxSCeV","type":"tool_result","content":"1\tpackage pose\n2\t\n3\t// Accepted limits (spec pose-review-declared-threat-model): a spec declares\n4\t// the residual limits of a guarantee it makes, each with a stable id and why\n5\t// it is accepted. The review plan seals them; the brief lists them; a\n6\t// reviewer classifies a finding that falls inside one as within that limit,\n7\t// or disputes the limit as a finding of its own. A declared limit never\n8\t// hides a defect inside the declared scope: it is visible in the bundle, the\n9\t// brief and the attestation.\n10\t\n11\timport (\n12\t\t\"regexp\"\n13\t\t\"strings\"\n14\t)\n15\t\n16\t// ReviewAcceptedLimit is one declared residual limit.\n17\ttype ReviewAcceptedLimit struct {\n18\t\tID   string `json:\"id\"`\n19\t\tText string `json:\"text\"`\n20\t\t// Spec names the spec that declared the limit when the scope holds more\n21\t\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n22\t\tSpec string `json:\"spec,omitempty\"`\n23\t}\n24\t\n25\tvar acceptedLimitRE = regexp.MustCompile(`^-\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n26\t\n27\t// acceptedLimitMarkerRE finds the marker where a sentence opens, after the\n28\t// assumption: \"<assumption>. Accepted because <reason>.\" A marker inside a\n29\t// sentence (\"Not accepted because\") is not one (review round 3, N1).\n30\tvar acceptedLimitMarkerRE = regexp.MustCompile(`[.;:!?]\\s+(?:Accepted because|Aceito porque)\\s+`)\n31\t\n32\t// acceptedLimitReasonWordRE is a word with at least one letter.\n33\tvar acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n34\t\n35\t// hasAcceptedLimitReason reads an entry as written: an assumption of at\n36\t// least two words, then the marker opening a sentence, then a reason of at\n37\t// least two words in that same sentence. A marker alone, punctuation, a\n38\t// missing assumption or a reason borrowed from a later sentence does not say\n39\t// why a limit is accepted (review rounds 1–4).\n40\tfunc hasAcceptedLimitReason(text string) bool {\n41\t\tloc := acceptedLimitMarkerRE.FindStringIndex(text)\n42\t\tif loc == nil {\n43\t\t\treturn false\n44\t\t}\n45\t\tassumption, rest := text[:loc[0]], text[loc[1]:]\n46\t\tif end := strings.IndexAny(rest, \".;!?\"); end >= 0 {\n47\t\t\trest = rest[:end]\n48\t\t}\n49\t\treturn len(acceptedLimitReasonWordRE.FindAllString(assumption, -1)) >= 2 && len(acceptedLimitReasonWordRE.FindAllString(rest, -1)) >= 2\n50\t}\n51\t\n52\t// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n53\t// It returns the limits and the problems that keep the section from being\n54\t// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n55\t// limit that does not say why it is accepted (\"Accepted because ...\" or\n56\t// \"Aceito porque ...\").\n57\tfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n58\t\tvar limits []ReviewAcceptedLimit\n59\t\tvar problems []string\n60\t\tin := false\n61\t\tseen := map[string]bool{}\n62\t\t// An entry may wrap over several lines: an indented or plain line that\n63\t\t// follows it continues it (review round 8, N1). Fenced blocks and HTML\n64\t\t// comments are not the spec's declarations, so examples there are never\n65\t\t// sealed (N2).\n66\t\ttype entry struct{ id, text string }\n67\t\tvar entries []entry\n68\t\tmalformed := func(line string) {\n69\t\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(line)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n70\t\t}\n71\t\tfenced := false\n72\t\tfor _, line := range strings.Split(stripHTMLComments(body), \"\\n\") {\n73\t\t\ttrimmed := strings.TrimSpace(line)\n74\t\t\tif strings.HasPrefix(trimmed, \"```\") || strings.HasPrefix(trimmed, \"~~~\") {\n75\t\t\t\tfenced = !fenced\n76\t\t\t\tcontinue\n77\t\t\t}\n78\t\t\tif fenced {\n79\t\t\t\tcontinue\n80\t\t\t}\n81\t\t\tif strings.HasPrefix(trimmed, \"#\") {\n82\t\t\t\theading := strings.TrimSpace(strings.TrimLeft(trimmed, \"#\"))\n83\t\t\t\tin = strings.EqualFold(heading, \"Accepted limits\") || strings.EqualFold(heading, \"Limites aceitos\")\n84\t\t\t\tcontinue\n85\t\t\t}\n86\t\t\tif !in || trimmed == \"\" {\n87\t\t\t\tcontinue\n88\t\t\t}\n89\t\t\tif strings.HasPrefix(trimmed, \"- \") {\n90\t\t\t\tm := acceptedLimitRE.FindStringSubmatch(trimmed)\n91\t\t\t\tif m == nil {\n92\t\t\t\t\tmalformed(trimmed)\n93\t\t\t\t\tentries = append(entries, entry{})\n94\t\t\t\t\tcontinue\n95\t\t\t\t}\n96\t\t\t\tentries = append(entries, entry{id: m[1], text: strings.TrimSpace(m[2])})\n97\t\t\t\tcontinue\n98\t\t\t}\n99\t\t\tif len(entries) > 0 && entries[len(entries)-1].id != \"\" {\n100\t\t\t\tentries[len(entries)-1].text += \" \" + trimmed\n101\t\t\t}\n102\t\t}\n103\t\tfor _, e := range entries {\n104\t\t\tif e.id == \"\" {\n105\t\t\t\tcontinue\n106\t\t\t}\n107\t\t\tif seen[e.id] {\n108\t\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is declared twice\")\n109\t\t\t\tcontinue\n110\t\t\t}\n111\t\t\tseen[e.id] = true\n112\t\t\tif !hasAcceptedLimitReason(e.text) {\n113\t\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" does not say why it is accepted ('Accepted because ...')\")\n114\t\t\t}\n115\t\t\tlimits = append(limits, ReviewAcceptedLimit{ID: e.id, Text: e.text})\n116\t\t}\n117\t\treturn limits, problems\n118\t}\n119\t\n120\t// acceptedLimitsOf collects the limits the scope's specs declare.\n121\tfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n122\t\tspecs, err := s.reviewScopeSpecs(scope)\n123\t\tif err != nil {\n124\t\t\treturn nil\n125\t\t}\n126\t\treturn acceptedLimitsOfSpecs(specs)\n127\t}\n128\t\n129\t// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n130\t// by its spec when there is more than one spec.\n131\tfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n132\t\tvar out []ReviewAcceptedLimit\n133\t\tfor _, spec := range specs {\n134\t\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n135\t\t\tfor _, l := range limits {\n136\t\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n137\t\t\t\t// so a finding names exactly one sealed limit.\n138\t\t\t\tif len(specs) > 1 {\n139\t\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n140\t\t\t\t}\n141\t\t\t\tout = append(out, l)\n142\t\t\t}\n143\t\t}\n144\t\treturn out\n145\t}\n146\t\n147\t// sealedAcceptedLimit reports whether the bundle sealed limit id.\n148\tfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n149\t\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n150\t\t\tif l.ID == id {\n151\t\t\t\treturn true\n152\t\t\t}\n153\t\t}\n154\t\treturn false\n155\t}\n156\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"77a67e43-b3e8-471c-a717-23a1557c34e0","timestamp":"2026-11-26T01:58:18.196Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2569977521/worktree/pose-mcp/internal/pose/accepted_limits.go","content":"package pose\n\n// Accepted limits (spec pose-review-declared-threat-model): a spec declares\n// the residual limits of a guarantee it makes, each with a stable id and why\n// it is accepted. The review plan seals them; the brief lists them; a\n// reviewer classifies a finding that falls inside one as within that limit,\n// or disputes the limit as a finding of its own. A declared limit never\n// hides a defect inside the declared scope: it is visible in the bundle, the\n// brief and the attestation.\n\nimport (\n\t\"regexp\"\n\t\"strings\"\n)\n\n// ReviewAcceptedLimit is one declared residual limit.\ntype ReviewAcceptedLimit struct {\n\tID   string `json:\"id\"`\n\tText string `json:\"text\"`\n\t// Spec names the spec that declared the limit when the scope holds more\n\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n\tSpec string `json:\"spec,omitempty\"`\n}\n\nvar acceptedLimitRE = regexp.MustCompile(`^-\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n\n// acceptedLimitMarkerRE finds the marker where a sentence opens, after the\n// assumption: \"<assumption>. Accepted because <reason>.\" A marker inside a\n// sentence (\"Not accepted because\") is not one (review round 3, N1).\nvar acceptedLimitMarkerRE = regexp.MustCompile(`[.;:!?]\\s+(?:Accepted because|Aceito porque)\\s+`)\n\n// acceptedLimitReasonWordRE is a word with at least one letter.\nvar acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n\n// hasAcceptedLimitReason reads an entry as written: an assumption of at\n// least two words, then the marker opening a sentence, then a reason of at\n// least two words in that same sentence. A marker alone, punctuation, a\n// missing assumption or a reason borrowed from a later sentence does not say\n// why a limit is accepted (review rounds 1–4).\nfunc hasAcceptedLimitReason(text string) bool {\n\tloc := acceptedLimitMarkerRE.FindStringIndex(text)\n\tif loc == nil {\n\t\treturn false\n\t}\n\tassumption, rest := text[:loc[0]], text[loc[1]:]\n\tif end := strings.IndexAny(rest, \".;!?\"); end >= 0 {\n\t\trest = rest[:end]\n\t}\n\treturn len(acceptedLimitReasonWordRE.FindAllString(assumption, -1)) >= 2 && len(acceptedLimitReasonWordRE.FindAllString(rest, -1)) >= 2\n}\n\n// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n// It returns the limits and the problems that keep the section from being\n// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n// limit that does not say why it is accepted (\"Accepted because ...\" or\n// \"Aceito porque ...\").\nfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n\tvar limits []ReviewAcceptedLimit\n\tvar problems []string\n\tin := false\n\tseen := map[string]bool{}\n\t// An entry may wrap over several lines: an indented or plain line that\n\t// follows it continues it (review round 8, N1). Fenced blocks and HTML\n\t// comments are not the spec's declarations, so examples there are never\n\t// sealed (N2).\n\ttype entry struct{ id, text string }\n\tvar entries []entry\n\tmalformed := func(line string) {\n\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(line)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n\t}\n\tfenced := false\n\tfor _, line := range strings.Split(stripHTMLComments(body), \"\\n\") {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif strings.HasPrefix(trimmed, \"```\") || strings.HasPrefix(trimmed, \"~~~\") {\n\t\t\tfenced = !fenced\n\t\t\tcontinue\n\t\t}\n\t\tif fenced {\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(trimmed, \"#\") {\n\t\t\theading := strings.TrimSpace(strings.TrimLeft(trimmed, \"#\"))\n\t\t\tin = strings.EqualFold(heading, \"Accepted limits\") || strings.EqualFold(heading, \"Limites aceitos\")\n\t\t\tcontinue\n\t\t}\n\t\tif !in || trimmed == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(trimmed, \"- \") {\n\t\t\tm := acceptedLimitRE.FindStringSubmatch(trimmed)\n\t\t\tif m == nil {\n\t\t\t\tmalformed(trimmed)\n\t\t\t\tentries = append(entries, entry{})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tentries = append(entries, entry{id: m[1], text: strings.TrimSpace(m[2])})\n\t\t\tcontinue\n\t\t}\n\t\tif len(entries) > 0 && entries[len(entries)-1].id != \"\" {\n\t\t\tentries[len(entries)-1].text += \" \" + trimmed\n\t\t}\n\t}\n\tfor _, e := range entries {\n\t\tif e.id == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif seen[e.id] {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" is declared twice\")\n\t\t\tcontinue\n\t\t}\n\t\tseen[e.id] = true\n\t\tif !hasAcceptedLimitReason(e.text) {\n\t\t\tproblems = append(problems, \"accepted limit \"+e.id+\" does not say why it is accepted ('Accepted because ...')\")\n\t\t}\n\t\tlimits = append(limits, ReviewAcceptedLimit{ID: e.id, Text: e.text})\n\t}\n\treturn limits, problems\n}\n\n// acceptedLimitsOf collects the limits the scope's specs declare.\nfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n\tspecs, err := s.reviewScopeSpecs(scope)\n\tif err != nil {\n\t\treturn nil\n\t}\n\treturn acceptedLimitsOfSpecs(specs)\n}\n\n// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n// by its spec when there is more than one spec.\nfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n\tvar out []ReviewAcceptedLimit\n\tfor _, spec := range specs {\n\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n\t\tfor _, l := range limits {\n\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n\t\t\t// so a finding names exactly one sealed limit.\n\t\t\tif len(specs) > 1 {\n\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n\t\t\t}\n\t\t\tout = append(out, l)\n\t\t}\n\t}\n\treturn out\n}\n\n// sealedAcceptedLimit reports whether the bundle sealed limit id.\nfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n\t\tif l.ID == id {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n","numLines":156,"startLine":1,"totalLines":156}},"tool_result_meta":[{"id":"toolu_01KPDJnDGWXPi5ohnPKxSCeV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
