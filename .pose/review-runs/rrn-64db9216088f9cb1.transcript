{\npose-mcp/internal/cli/artifact_integrity.go:227:\treturn resolveGitChangeSetWithTrailersAndFiles(nil, root, spec, base, head, captured)\npose-mcp/internal/cli/artifact_integrity.go:230:func resolveGitChangeSetWithTrailersIn(files posemodel.Files, root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\npose-mcp/internal/cli/artifact_integrity.go:231:\treturn resolveGitChangeSetWithTrailersAndFiles(files, root, spec, base, head, captured)\npose-mcp/internal/cli/artifact_integrity.go:256:func resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\npose-mcp/internal/cli/artifact_integrity.go:257:\treturn resolveGitChangeSetWithPatchDigest(files, root, spec, base, head, captured, nil)\npose-mcp/internal/cli/artifact_integrity.go:260:// resolveGitChangeSetWithPatchDigest resolves a change set; a non-nil\npose-mcp/internal/cli/artifact_integrity.go:263:func resolveGitChangeSetWithPatchDigest(files posemodel.Files, root, spec, base, head string, captured []string, patchDigest []byte) (posemodel.ChangeSet, error) {\npose-mcp/internal/cli/artifact_integrity.go:275:\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"a valid spec slug is required\")\npose-mcp/internal/cli/artifact_integrity.go:282:\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"no commits carry POSE-Spec: %s\", spec)\npose-mcp/internal/cli/artifact_integrity.go:289:\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"--from and --to must be supplied together\")\npose-mcp/internal/cli/artifact_integrity.go:303:\t\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"%w; %v\", err, headerErr)\npose-mcp/internal/cli/artifact_integrity.go:310:\t\t\treturn posemodel.ChangeSet{}, err\npose-mcp/internal/cli/artifact_integrity.go:315:\t\treturn posemodel.ChangeSet{}, err\npose-mcp/internal/cli/artifact_integrity.go:317:\tcommitsRaw, err := gitOutput(4*1024*1024, \"rev-list\", \"--reverse\", posemodel.ChangeSetRange(resolvedBase, resolvedHead), \"--\")\npose-mcp/internal/cli/artifact_integrity.go:319:\t\treturn posemodel.ChangeSet{}, err\npose-mcp/internal/cli/artifact_integrity.go:335:\t\t\t\treturn posemodel.ChangeSet{}, err\npose-mcp/internal/cli/artifact_integrity.go:339:\t\t\t\treturn posemodel.ChangeSet{}, err\npose-mcp/internal/cli/artifact_integrity.go:350:\t\t\t\treturn posemodel.ChangeSet{}, err\npose-mcp/internal/cli/artifact_integrity.go:357:\t\t\treturn posemodel.ChangeSet{}, err\npose-mcp/internal/cli/artifact_integrity.go:361:\t\t\treturn posemodel.ChangeSet{}, err\nPOSE - artifact-check\n\nReconcile declared spec artifacts with immutable Git changesets\n\nUsage:\n  pose artifact-check --spec <slug> [--from <rev> --to <rev>] [--strict|--tolerant] [--json]\n\nDescription:\n  Verifies that all files declared in section 3 (Technical Plan -> Artifacts) match the actual Git change set attributed to the spec trailer (POSE-Spec: <slug>).\n\nOptions / Flags:\n  --spec <slug>            Specification slug to reconcile\n  --from <rev>             Starting git revision for change set comparison\n  --to <rev>               Ending git revision for change set comparison\n  --strict                 Fail on any undeclared or missing artifact mismatch\n  --json                   Output reconciliation results in JSON format\n\nExamples:\n  $ pose artifact-check --spec user-auth --strict\n\n","exit_code":0,"status":"completed"}}
