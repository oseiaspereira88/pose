t, err := captureGovernanceGit(files, s.Root, producer, append([]string{\"rev-list\", \"--topo-order\", \"-n\", \"1\"}, heads...)...)\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\tif first, _, _ := strings.Cut(strings.TrimSpace(string(out)), \"\\n\"); governanceFullObjectID.MatchString(first) {\n\t\treturn first\n\t}\n\treturn \"\"\n}\n\nfunc retainedManifestChanged(bundle *ReviewBundle, scope string) string {\n\treturn \"the approval of bundle \" + bundle.BundleID + \" is not retained: the federated manifest of \" + scope + \" changed in a way that bears on its authority\"\n}\n\n// federatedManifestStands reports whether a closed scope's sealed manifest still\n// holds against the current one. It is sameFederatedManifest, less the one thing a\n// guarded close itself changes: the lifecycle of a roadmap of this project, and the\n// not-done blocker of a dependency that reached done. Anything not proved to be that\n// is a difference (spec pose-roadmap-close-keeps-its-approvals R1-R3).\nfunc (s Store) federatedManifestStands(sealed, current *FederatedRoadmapManifest) bool {\n\tif s.manifestStandsOver(sealed, current) {\n\t\treturn true\n\t}\n\twider := s.milestoneManifestWithItsRoadmapDependencies(sealed)\n\treturn wider != nil && s.manifestStandsOver(sealed, wider)\n}\n\n// milestoneManifestWithItsRoadmapDependencies is the manifest a milestone sealed\n// before the depends_on of its roadmap stopped binding it (ADR\n// a-milestone-answers-to-its-own-edges) would hold now. The edge moved by rule, so\n// it is judged where it was sealed, for as long as the roadmap still declares it.\nfunc (s Store) milestoneManifestWithItsRoadmapDependencies(sealed *FederatedRoadmapManifest) *FederatedRoadmapManifest {\n\tif sealed == nil || sealed.Coordinator.Kind != \"milestone\" || s.FederatedResolver == nil {\n\t\treturn nil\n\t}\n\trm, err := s.GetRoadmap(sealed.Coordinator.Slug)\n\tif err != nil || len(rm.DependsOn) == 0 {\n\t\treturn nil\n\t}\n\treport, err := s.milestoneAcceptance(s.FederatedProjectID, rm.Slug, sealed.Coordinator.Milestone, *s.FederatedResolver, true)\n\tif err != nil {\n\t\treturn nil\n\t}\n\treturn &report.Manifest\n}\n\nfunc (s Store) manifestStandsOver(sealed, current *FederatedRoadmapManifest) bool {\n\tif sameFederatedManifest(sealed, current) {\n\t\treturn true\n\t}\n\tif sealed == nil || current == nil || len(sealed.Dependencies) != len(current.Dependencies) {\n\t\treturn false\n\t}\n\twas := *sealed\n\tif was.CoordinatorRevision != current.CoordinatorRevision {\n\t\tif !s.sameRoadmapApartFromLifecycle(was.Coordinator, was.CoordinatorRevision, current.CoordinatorRevision) {\n\t\t\treturn false\n\t\t}\n\t\twas.CoordinatorRevision = current.CoordinatorRevision\n\t}\n\twas.Dependencies = append([]FederatedDependency{}, sealed.Dependencies...)\n\tmet := map[string]bool{}\n\tpinMoved := false\n\tfor i := range was.Dependencies {\n\t\tthen, now := &was.Dependencies[i], current.Dependencies[i]\n\t\tif then.SourceRevision == now.SourceRevision && then.SourceDigest == now.SourceDigest && then.Status == now.Status {\n\t\t\tcontinue\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n)\n\nconst FederatedRoadmapPolicySchemaVersion = 1\n\nconst (\n\tmaxFederatedPolicyBytes          = 256 << 10\n\tmaxFederatedGovernanceInputBytes = 2 << 20\n)\n\ntype FederatedProjectTrust struct {\n\tContractDigest string `json:\"contract_digest\"`\n\tPolicyDigest   string `json:\"policy_digest\"`\n\tRevision       string `json:\"revision\"`\n}\n\ntype FederatedRoadmapPolicy struct {\n\tSchemaVersion   int                              `json:\"schema_version\"`\n\tEnabled         bool                             `json:\"enabled\"`\n\tAdoptedAt       string                           `json:\"adopted_at,omitempty\"`\n\tTrustedProjects map[string]FederatedProjectTrust `json:\"trusted