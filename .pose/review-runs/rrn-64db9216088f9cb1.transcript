{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'func CaptureGovernanceRawHistoryGitIn|func .*RawHistory|CommandContext|WithTimeout' pose-mcp/internal/pose/governance* pose-mcp/internal/pose/git* | head -45; sed -n '80,142p' pose-mcp/internal/pose/roadmap_close_keeps_approvals_test.go; sed -n '1,70p' .pose/knowledge/2026-08-13-decision-log-adr-sealed-review-bundles-review.md; git diff --check edcf5f28ca775b32d3ec1ee3dc078ad27ba86887 8bce6b7f0d70f415cf2634dbf03521600457acdd -- pose-mcp/internal/pose/review_bundle.go pose-mcp/internal/pose/federated_pin_move_test.go\"","aggregated_output":"pose-mcp/internal/pose/governance_read_view_git.go:95:func CaptureGovernanceRawHistoryGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\npose-mcp/internal/pose/governance_read_view_git.go:110:func CaptureGovernanceRawHistoryGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\npose-mcp/internal/pose/governance_read_view_git.go:122:\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:126:\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:282:\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:332:\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:610:func runGovernanceGitCommandContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, error) {\npose-mcp/internal/pose/governance_read_view_git.go:647:\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\npose-mcp/internal/pose/git_snapshot_integrity.go:566:\treturn gitCommandContext(context.Background(), args...)\npose-mcp/internal/pose/git_snapshot_integrity.go:569:// gitCommandContext is gitCommand under ctx. Both read raw object history: a\npose-mcp/internal/pose/git_snapshot_integrity.go:572:func gitCommandContext(ctx context.Context, args ...string) *exec.Cmd {\npose-mcp/internal/pose/git_snapshot_integrity.go:575:\tcmd := exec.CommandContext(ctx, \"git\", append([]string{\"-c\", \"advice.graftFileDeprecated=false\"}, args...)...)\npose-mcp/internal/pose/governance_read_view_stream.go:56:func StreamGovernanceRawHistoryGitIn(files Files, ctx context.Context, root, producer string, maxBytes int64, sink io.Writer, args ...string) error {\npose-mcp/internal/pose/governance_read_view_stream.go:228:\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\npose-mcp/internal/pose/git_batch.go:35:\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\npose-mcp/internal/pose/git_batch.go:36:\tcmd := gitCommandContext(ctx, \"-C\", r.root, \"cat-file\", \"--batch\")\n\t\treturn FederatedDependency{Ref: \"xref:coordinator/roadmap:program\", Identity: ArtifactRef{Project: \"coordinator\", Kind: \"roadmap\", Slug: \"program\"}, Status: status, SourceRevision: revision, SourceDigest: digest}\n\t}\n\tsealed := FederatedRoadmapManifest{SchemaVersion: 1, Coordinator: coordinator, CoordinatorRevision: before, TrustPolicyDigest: \"trust\",\n\t\tDependencies: []FederatedDependency{dependency(before, \"old\", \"done\")}, Ready: true, Blockers: []string{}, Digest: \"sealed\"}\n\tcurrent := sealed\n\tcurrent.CoordinatorRevision, current.Digest = after, \"current\"\n\tcurrent.Dependencies = []FederatedDependency{dependency(after, \"new\", \"done\")}\n\treturn s, before, sealed, current\n}\n\nfunc TestManifestStandsOverALifecycleChange(t *testing.T) {\n\ts, _, sealed, current := lifecycleManifests(t)\n\tif !s.federatedManifestStands(&sealed, &current) {\n\t\tt.Fatal(\"a lifecycle change of the roadmap staled the manifest\")\n\t}\n\tif !s.federatedManifestStands(&sealed, &sealed) || !s.federatedManifestStands(nil, nil) {\n\t\tt.Fatal(\"identical manifests must stand\")\n\t}\n}\n\nfunc TestManifestStandsOverACompletedDependency(t *testing.T) {\n\ts, _, sealed, current := lifecycleManifests(t)\n\tsealed.Dependencies[0].Status = \"active\"\n\tsealed.Blockers, sealed.Ready = []string{\"xref:coordinator/roadmap:program:not-done\"}, false\n\tif !s.federatedManifestStands(&sealed, &current) {\n\t\tt.Fatal(\"a dependency reaching done staled the manifest\")\n\t}\n\tkept := sealed\n\tkept.Blockers = []string{\"xref:coordinator/roadmap:program:not-done\", \"xref:source/roadmap:component:consumer-trust-stale\"}\n\tif s.federatedManifestStands(&kept, &current) {\n\t\tt.Fatal(\"a blocker the dependency did not clear was excused\")\n\t}\n}\n\nfunc TestManifestDifferencesThatStale(t *testing.T) {\n\ts, before, sealed, base := lifecycleManifests(t)\n\tcopied := func() FederatedRoadmapManifest {\n\t\tcurrent := base\n\t\tcurrent.Dependencies = append([]FederatedDependency{}, base.Dependencies...)\n\t\treturn current\n\t}\n\tfor name, change := range map[string]func(*FederatedRoadmapManifest){\n\t\t\"trust\": func(m *FederatedRoadmapManifest) { m.TrustPolicyDigest = \"other\" },\n\t\t\"new blocker\": func(m *FederatedRoadmapManifest) {\n\t\t\tm.Blockers = []string{\"xref:source/roadmap:component:consumer-trust-stale\"}\n\t\t},\n\t\t\"coordinator\":        func(m *FederatedRoadmapManifest) { m.Coordinator.Milestone = \"later\" },\n\t\t\"unknown revision\":   func(m *FederatedRoadmapManifest) { m.CoordinatorRevision = strings.Repeat(\"0\", len(before)) },\n\t\t\"status left done\":   func(m *FederatedRoadmapManifest) { m.Dependencies[0].Status = \"active\" },\n\t\t\"another project\":    func(m *FederatedRoadmapManifest) { m.Dependencies[0].Identity.Project = \"source\" },\n\t\t\"a spec\":             func(m *FederatedRoadmapManifest) { m.Dependencies[0].Identity.Kind = \"spec\" },\n\t\t\"another evidence\":   func(m *FederatedRoadmapManifest) { m.Dependencies[0].ReviewBundleID = \"other\" },\n\t\t\"fewer dependencies\": func(m *FederatedRoadmapManifest) { m.Dependencies = nil },\n\t} {\n\t\tcurrent := copied()\n\t\tchange(&current)\n\t\tif s.federatedManifestStands(&sealed, &current) {\n\t\t\tt.Errorf(\"%s: the manifest stood over the difference\", name)\n\t\t}\n\t}\n}\n\nfunc TestRoadmapClosedBetweenIsTheBytesOfTheClose(t *testing.T) {\n---\ntype: decision-log\nslug: adr-sealed-review-bundles-review\nowner: @pose-maintainers\nsensitivity: public-internal\ncreated_at: 2026-08-13\nlast_reviewed_at: 2026-08-13\nexpires_at: 2026-11-11\nsource_refs:\n  spec: \"pose-review-bundle-convergence\"\n  workflow: \"feature\"\n  commands: [\"pose lint-spec pose-review-bundle-convergence --ready-check\", \"pose validate --strict --module pose-mcp --report --report-task review-bundle-convergence\"]\n  external_sources: []\n---\n\n# decision-log: adr-sealed-review-bundles-review\n\n## Context\n\nThe current full-body review scope digest lets closeout bookkeeping alter the\nsubject that was just approved. Component-aware review also exposed transient\nprovider merge provenance and excessive full-plan rereview. The proposed ADR\nseparates a canonical sealed bundle from its attestation and makes POSE the\noffline verifier while an optional Conductor workflow owns orchestration.\n\n## Current state\n\nADR `2026-08-13-sealed-review-bundles-and-attestations` is accepted. The core,\nCLI, read-only MCP, schemas, opt-in migration, scoped provenance bridge,\nEnglish/pt-BR distribution and fresh-repository convergence smoke are\nimplemented under `pose-review-bundle-convergence`.\n\n## Next checks\n\n- Prove `prepare -> validate -> seal -> review -> attest -> close` converges\n  without a second bundle or review.\n- Prove lifecycle, state, assessment, report and attestation mutations do not\n  change the sealed bundle.\n- Prove every governed semantic, source, policy and required-evidence mutation\n  supersedes the affected bundle.\n- Verify synthetic merge/squash subjects by patch and tree/content digests.\n- Verify policy-bounded targeted criterion reuse and complete final projection.\n- Verify a new delivery target cannot stale unrelated closed specs and that no\n  historical evidence must be regenerated to recover the strict gate.\n- Verify repeated mapping warnings and inactive completion tools are grouped in\n  human output while canonical JSON retains complete provenance.\n- Verify offline flow, installed-binary parity and schema-v1/v2 migration before\n  promoting the feature from preview.\n\n## Risks\n\nSemantic projection may omit a meaningful input or retain an operational input,\ncausing false freshness or false staleness. Keep unknown paths fail-closed,\nrequire include/exclude golden fixtures and review production deltas after the\nfirst opt-in release. Criterion reuse may miss cross-cutting effects; disable it\nfor high-criticality profiles until sliced-input evidence proves safe.\n\n## Next owner\n\n`@pose-maintainers`.\n\n## References\n\n- `spec:pose-review-bundle-convergence`\n- `adr:2026-08-13-sealed-review-bundles-and-attestations`\n- `adr:2026-08-12-component-aware-effective-review-plans`\n- `knowledge:pr15-component-aware-review-provenance`\n","exit_code":0,"status":"completed"}}
