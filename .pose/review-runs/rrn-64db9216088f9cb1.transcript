ha256:985515cc29d94aba4f944aa12d4b3e0ee53442de35faab7cfa6bb9e547270458\",\n    \"pose-attestation-evidence-must-be-in-the-bundle\": \"sha256:e11dfd0ef52e3854fbf691e241632bfb22b5493bf3a02c69807e286bfc88669a\",\n    \"pose-authority-claim-project-is-not-the-audience\": \"sha256:a34796d71314ed983e3f663d6fe0197665266ed460259d4dddb9cdaaaef6b63c\",\n    \"pose-blocked-semantics-alignment\": \"sha256:f6d9bce05c35fa421fc448109d45c21396c85c9ff5192285b21ca76b28d2222e\",\n    \"pose-bounded-isolated-graph-caches\": \"sha256:f6f5b1b354a412cfbfaa38e11ee8d4886041ee6ccbd04e5abfd7a40fb30e085d\",\n    \"pose-bundle-findings-take-the-contract-the-legacy-path-had\": \"sha256:e1955a8d82fd3c75d937bab5bd919eb16374fd6e916b8d1c141243e70d8b7e68\",\n    \"pose-bundles-seal-the-contracts-that-govern-them\": \"sha256:d184f545bb3714bfdde6ad25a173183b732178a7a9f51d49be18d761f19bb29f\",\n    \"pose-canonical-positioning\": \"sha256:4fa359f83c0c4c1e6d0887e497bb92aae3b208177bad632cc5005715efe8084f\",\n    \"pose-capability-catalog\": \"sha256:051ce4c333f5ef5f0937c5ac28607f7a041573f4814dd1c67db6e331397bfdc3\",\n    \"pose-causality-closeout-adoption-cutoff\": \"sha256:79666e663f0198e474819c2a5d0511d1b01f18bb72a3fb5a8f795904edc2c21d\",\n    \"pose-changelog-adoption-is-the-instances\": \"sha256:2831c946fcba44ca47c26e5c9a3391c9fc472d900dde2fe7b30007549e7760a2\",\n    \"pose-changelog-and-dor-policy-types\": \"sha256:6854e7b87f657a46d917ed261f9e4ebd6f5f6348b6a27ab0aa098c6b05ebb0e6\",\n    \"pose-check-dor-accepts-qualified-refs\": \"sha256:58f7fac5ec9bf37cb5424af2e3684adb284c6e39c6676d608a9484d5a976d4ab\",\n    \"pose-check-qualified-roadmap-members\": \"sha256:d7e28cd4ced43351c51b10ba3fcd63dec9f3b58e7be69ee31e79da130b869644\",\n    \"pose-check-shares-the-federated-material\": \"sha256:c396dfa36d2a77e7efa22f07b94856c7da1b2cf4765433f34b2d5f560a2e7694\",\n    \"pose-check-spawns-fewer-git-processes\": \"sha256:cfbb828b99f14d7a5c9989585b8be25b1019ba74a4595ad5f02bd204e6c163df\",\n    \"pose-ci-avoids-anon