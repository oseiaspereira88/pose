{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '263,296p' pose-mcp/internal/cli/artifact_integrity.go; rg -n 'allCommitsWithSpecTrailers|--all' pose-mcp/internal/cli/artifact_integrity.go; rg -n '\\\"plan_digest\\\"|\\\"bundle_id\\\"' .pose/review-bundles/rvb-225025f3114dbcae.json | head -5; git status --short\"","aggregated_output":"func resolveGitChangeSetWithPatchDigest(files posemodel.Files, root, spec, base, head string, captured []string, patchDigest []byte) (posemodel.ChangeSet, error) {\n\tgitOutput := func(limit int, args ...string) ([]byte, error) {\n\t\tif files == nil {\n\t\t\treturn gitOutputBounded(root, limit, args...)\n\t\t}\n\t\treturn gitOutputBoundedIn(files, root, limit, args...)\n\t}\n\tgitStream := changeSetGitStream(files, root)\n\tresolveRevision := func(revision string) (string, error) {\n\t\treturn resolveGitRevisionWithFiles(files, root, revision)\n\t}\n\tif spec == \"\" || posemodel.ValidateSlug(spec) != nil {\n\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"a valid spec slug is required\")\n\t}\n\tselector := \"range:\" + base + \"..\" + head\n\tvar trailerCommits []string\n\tif base == \"\" && head == \"\" {\n\t\tcommits := append([]string(nil), captured...)\n\t\tif len(commits) == 0 {\n\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"no commits carry POSE-Spec: %s\", spec)\n\t\t}\n\t\ttrailerCommits = commits\n\t\thead = commits[len(commits)-1]\n\t\tbase = commits[0] + \"^\"\n\t\tselector = \"trailers:\" + spec\n\t} else if base == \"\" || head == \"\" {\n\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"--from and --to must be supplied together\")\n\t}\n\tresolvedBase := base\n\tif !posemodel.IsGitEmptyTree(base) {\n\t\tvar err error\n\t\tif resolvedBase, err = resolveRevision(base); err != nil && len(trailerCommits) > 0 {\n\t\t\tvar isRoot bool\n\t\t\tvar headerErr error\n402:func allCommitsWithSpecTrailers(root string) (map[string][]string, error) {\n414:func allCommitsWithSpecTrailersIn(files posemodel.Files, root string) (map[string][]string, error) {\n415:\tspecs, _, err := allCommitsWithSpecTrailersOrderedIn(files, root)\n419:// allCommitsWithSpecTrailersOrderedIn reads the trailer log once and returns\n421:func allCommitsWithSpecTrailersOrderedIn(files posemodel.Files, root string) (map[string][]string, []posemodel.SpecTrailerLogEntry, error) {\n482:\tspecCommits, err := allCommitsWithSpecTrailers(root)\n490:\tspecCommits, err := allCommitsWithSpecTrailersIn(files, root)\n658:\tspecTrailers, trailerOrder, err := allCommitsWithSpecTrailersOrderedIn(files, root)\n3:  \"bundle_id\": \"rvb-225025f3114dbcae\",\n149:      \"plan_digest\": \"sha256:296ce29cb30e0abdb84edbf46fbabbcd3b4ff51d7ab11a22561c9c49ed8de9a8\",\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '402,445p' pose-mcp/internal/cli/artifact_integrity.go; git show -s --format='%h %s%n%b' 8c0b85215f6e4f5e46a9fdf41676863cf3573014; sed -n '640,708p' pose-mcp/internal/cli/artifact_integrity.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '402,445p' pose-mcp/internal/cli/artifact_integrity.go; git show -s --format='%h %s%n%b' 8c0b85215f6e4f5e46a9fdf41676863cf3573014; sed -n '640,708p' pose-mcp/internal/cli/artifact_integrity.go\"","aggregated_output":"func allCommitsWithSpecTrailers(root string) (map[string][]string, error) {\n\t// A rolling commit limit changes historical attribution whenever an unrelated\n\t// commit pushes a tagged commit out of the window. Filter in Git and scan the\n\t// full matching history; the output bound still fails closed for huge inputs.\n\tout, err := gitOutputBounded(root, 32*1024*1024, posemodel.SpecTrailerLogArgs...)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tspecCommits := posemodel.ParseSpecTrailerLog(out)\n\treturn specCommits, nil\n}\n\nfunc allCommitsWithSpecTrailersIn(files posemodel.Files, root string) (map[string][]string, error) {\n\tspecs, _, err := allCommitsWithSpecTrailersOrderedIn(files, root)\n\treturn specs, err\n}\n\n// allCommitsWithSpecTrailersOrderedIn reads the trailer log once and returns\n// it both per spec and in log order.\nfunc allCommitsWithSpecTrailersOrderedIn(files posemodel.Files, root string) (map[string][]string, []posemodel.SpecTrailerLogEntry, error) {\n\tout, err := gitOutputBoundedIn(files, root, 32*1024*1024, posemodel.SpecTrailerLogArgs...)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn posemodel.ParseSpecTrailerLog(out), posemodel.ParseSpecTrailerLogOrdered(out), nil\n}\n\n// trailerPatchDigests streams the patch of each attributed commit once, in\n// log order, into the digest of every spec that holds it, so a commit carrying\n// several specs' trailers is read once instead of once per spec (spec\n// pose-index-streams-each-commit-once). Each spec's digest is the SHA-256 of\n// its commits' patches concatenated in its own order, exactly as resolving\n// its change set alone computes it. A spec naming the same commit twice is\n// left to that per-spec path, since one stream cannot feed it twice in order.\n// A failed read fails every spec that holds the commit.\nfunc trailerPatchDigests(files posemodel.Files, root string, order []posemodel.SpecTrailerLogEntry, wanted map[string]bool) (map[string][]byte, map[string]error) {\n\trepeated := map[string]bool{}\n\tfor _, entry := range order {\n\t\tseen := map[string]bool{}\n\t\tfor _, spec := range entry.Specs {\n\t\t\tif seen[spec] {\n\t\t\t\trepeated[spec] = true\n\t\t\t}\n\t\t\tseen[spec] = true\n8c0b8521 chore: seal the review bundle on a current index\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_018BdzfqwBXh8UdZwnt129jD\nPOSE-Spec: pose-closed-scope-stands-over-a-moved-federated-pin\n\n\t\t}\n\t\tspecs = []posemodel.Spec{}\n\t}\n\tgaps := map[string]string{}\n\trefsBefore, refsErr := gitOutputBoundedIn(files, root, 8*1024*1024, \"show-ref\", \"--head\", \"--dereference\")\n\ttracked, err := gitTrackedPathsIn(files, root)\n\tif err != nil {\n\t\ttracked = []string{}\n\t\tgaps[\"\"] = \"the tracked paths could not be read: \" + err.Error()\n\t}\n\tchangeSetsMap := map[string]posemodel.ChangeSet{}\n\trecordedSets, recordedGap := loadRecordedChangeSetsWithGapIn(files, root)\n\tif recordedGap != \"\" && gaps[\"\"] == \"\" {\n\t\tgaps[\"\"] = recordedGap\n\t}\n\tfor _, recorded := range recordedSets {\n\t\tchangeSetsMap[recorded.ID] = recorded\n\t}\n\tspecTrailers, trailerOrder, err := allCommitsWithSpecTrailersOrderedIn(files, root)\n\tif err != nil && gaps[\"\"] == \"\" {\n\t\tgaps[\"\"] = \"the commits carrying POSE-Spec trailers could not be read: \" + err.Error()\n\t}\n\t// A shallow repository may hide commits carrying a trailer, and nothing\n\t// read from it can show which (LR-R3-02).\n\tif out, err := gitOutputBoundedIn(files, root, 4096, \"rev-parse\", \"--is-shallow-repository\"); err != nil || strings.TrimSpace(string(out)) != \"false\" {\n\t\tif gaps[\"\"] == \"\" {\n\t\t\tgaps[\"\"] = \"the repository's history is shallow or its depth could not be read\"\n\t\t}\n\t}\n\twanted := map[string]bool{}\n\tfor _, spec := range specs {\n\t\twanted[spec.Slug] = len(specTrailers[spec.Slug]) > 0\n\t}\n\tpatchDigests, patchFailures := trailerPatchDigests(files, root, trailerOrder, wanted)\n\tfor _, spec := range specs {\n\t\tif len(specTrailers[spec.Slug]) > 0 {\n\t\t\tif err := patchFailures[spec.Slug]; err != nil {\n\t\t\t\tgaps[spec.Slug] = \"its trailer change set could not be read: \" + err.Error()\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif set, err := resolveGitChangeSetWithPatchDigest(files, root, spec.Slug, \"\", \"\", specTrailers[spec.Slug], patchDigests[spec.Slug]); err == nil {\n\t\t\t\tchangeSetsMap[set.ID] = set\n\t\t\t} else {\n\t\t\t\tgaps[spec.Slug] = \"its trailer change set could not be read: \" + err.Error()\n\t\t\t}\n\t\t}\n\t}\n\trefsAfter, afterErr := gitOutputBoundedIn(files, root, 8*1024*1024, \"show-ref\", \"--head\", \"--dereference\")\n\tif refsErr == nil && afterErr == nil && !bytes.Equal(refsBefore, refsAfter) {\n\t\treturn nil, nil, nil, nil, policy, nil, fmt.Errorf(\"Git inputs changed during artifact collection: refs or HEAD moved; retry the operation\")\n\t}\n\tif (refsErr != nil || afterErr != nil) && gaps[\"\"] == \"\" {\n\t\tgaps[\"\"] = \"the repository refs or HEAD could not be bound to this artifact collection\"\n\t}\n\tchangeSets := make([]posemodel.ChangeSet, 0, len(changeSetsMap))\n\tfor _, set := range changeSetsMap {\n\t\tchangeSets = append(changeSets, set)\n\t}\n\tsort.Slice(changeSets, func(i, j int) bool { return changeSets[i].ID < changeSets[j].ID })\n\treturn specs, claims, changeSets, tracked, policy, gaps, nil\n}\n\n// collectArtifactGraphInputs reads and writes the filesystem directly; collectArtifactGraphInputsIn takes the\n// operation's files.\nfunc collectArtifactGraphInputs(root string) ([]posemodel.Spec, []posemodel.ArtifactClaim, []posemodel.ChangeSet, []string, posemodel.ArtifactPolicy, error) {\n\treturn collectArtifactGraphInputsIn(posemodel.NativeFiles(), root)\n}\n\n// collectArtifactGraphInputsIn drops what it could not read; a later removal,\n","exit_code":0,"status":"completed"}}
