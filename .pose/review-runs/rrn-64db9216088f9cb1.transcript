{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '160,205p' pose-mcp/internal/pose/spec.go; sed -n '440,520p' pose-mcp/internal/pose/spec.go; sed -n '390,555p' pose-mcp/internal/pose/federated_acceptance.go; sed -n '710,745p' pose-mcp/internal/pose/federated_acceptance.go; sed -n '900,945p' pose-mcp/internal/pose/federated_acceptance.go; sed -n '4539,4568p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"func (s Store) GetSpec(slug string) (*Spec, error) {\n\tif err := ValidateSlug(slug); err != nil {\n\t\treturn nil, err\n\t}\n\tvar err error\n\ts, err = s.prepareReviewOperationRead()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif sp, handled, err := s.reviewViewSpec(slug); handled {\n\t\treturn sp, err\n\t}\n\tspecs, err := s.ListSpecs(\"\", \"\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar match *Spec\n\tfor i := range specs {\n\t\tif specs[i].Slug != slug {\n\t\t\tcontinue\n\t\t}\n\t\tif match != nil {\n\t\t\treturn nil, SpecIdentityConflictError{Slug: slug}\n\t\t}\n\t\tmatch = &specs[i]\n\t}\n\tif match == nil {\n\t\treturn nil, fmt.Errorf(\"pose: spec %q not found\", slug)\n\t}\n\treturn s.readListedSpec(*match)\n}\n\nfunc (s Store) readListedSpec(match Spec) (*Spec, error) {\n\tif within, err := artifactPathWithinObserved(s.fsys(), s.Root, match.Path); err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: spec containment unavailable: %s: %w\", match.Slug, err)\n\t} else if !within {\n\t\treturn nil, fmt.Errorf(\"pose: spec path escapes project: %s\", match.Slug)\n\t}\n\tvar full *Spec\n\tvar err error\n\tif info, statErr := s.fsys().Stat(match.Path); statErr == nil && info.IsDir() {\n\t\tpaths := splitSpecFiles(s.fsys(), match.Path)\n\t\tfor _, path := range paths {\n\t\t\tif within, err := artifactPathWithinObserved(s.fsys(), s.Root, path); err != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"pose: split spec containment unavailable: %s: %w\", match.Slug, err)\n\t\t\t} else if !within {\n\tfor _, w := range wanted {\n\t\tif strings.EqualFold(value, w) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// statusMatchesAny reports whether specStatus case-insensitively equals any\n// of the wanted values.\nfunc statusMatchesAny(specStatus string, wanted []string) bool {\n\treturn caseInsensitiveMatchesAny(specStatus, wanted)\n}\n\n// componentsMatchAny reports whether specComponents shares at least one tag,\n// case-insensitively, with wanted (OR semantics).\nfunc componentsMatchAny(specComponents []string, wanted []string) bool {\n\tfor _, c := range specComponents {\n\t\tif caseInsensitiveMatchesAny(c, wanted) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nvar splitSpecSectionFiles = []string{\n\t\"intent.md\",\n\t\"requirements.md\",\n\t\"technical-plan.md\",\n\t\"tasks.md\",\n\t\"decisions.md\",\n\t\"validation.md\",\n\t\"final-report.md\",\n\t\"STATUS.md\",\n}\n\nfunc splitSpecFiles(fsys Files, dir string) []string {\n\tvar files []string\n\tfor _, name := range splitSpecSectionFiles {\n\t\tpath := filepath.Join(dir, name)\n\t\tif fi, err := fsys.Stat(path); err == nil && !fi.IsDir() {\n\t\t\tfiles = append(files, path)\n\t\t}\n\t}\n\treturn files\n}\n\nfunc parseSplitSpec(fsys Files, dir, slug string, files []string, includeBody bool) (*Spec, error) {\n\tbody, err := readSplitSpecBody(fsys, files)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tsp := &Spec{\n\t\tSlug:   slug,\n\t\tStatus: splitSpecStatus(fsys, files),\n\t\tTitle:  firstHeading(body),\n\t\tPath:   dir,\n\t}\n\tif includeBody {\n\t\tsp.Body = body\n\t}\n\treturn sp, nil\n}\n\nfunc readSplitSpecBody(fsys Files, files []string) (string, error) {\n\tsections := make([]string, 0, len(files))\n\tfor _, path := range files {\n\t\traw, err := fsys.ReadFile(path)\n\t\tif err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"pose: reading split spec section: %w\", err)\n\t\t}\n\t\tsection := strings.TrimSpace(string(raw))\n\t\tif section != \"\" {\n\t\t\tsections = append(sections, section)\n\t\t}\n\t}\n\treturn strings.Join(sections, \"\\n\\n\"), nil\n}\n\nfunc splitSpecStatus(fsys Files, files []string) string {\n\tfor _, path := range files {\n\t\t\t\t\tfound = found || relationship == item.relationship\n\t\t\t\t}\n\t\t\t\tif !found {\n\t\t\t\t\tentry.Relationships = append(entry.Relationships, item.relationship)\n\t\t\t\t\tsort.Strings(entry.Relationships)\n\t\t\t\t\tentry.Relationship = entry.Relationships[0]\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif len(visited) >= 256 {\n\t\t\treport.Blockers = append(report.Blockers, \"resolution-limit\")\n\t\t\tbreak\n\t\t}\n\t\tvisited[key] = true\n\t\tentry := FederatedDependency{Ref: key, Relationship: item.relationship, Relationships: []string{item.relationship}, Identity: identity, ResolutionState: resolved.State, Status: resolved.Status, SourceRevision: resolved.Revision, SourceDigest: resolved.Digest}\n\t\t// The dependency keeps the identity it was named by, as the manifest\n\t\t// records it; a transferred artifact is proven at its canonical\n\t\t// destination: its store, revision, trust and closeout (review\n\t\t// round 7, N25). The resolver authorized the redirect chain.\n\t\tproven := identity\n\t\tif resolved.CanonicalIdentity != nil {\n\t\t\tproven = *resolved.CanonicalIdentity\n\t\t}\n\t\tdependencyIndexes[key] = len(report.Manifest.Dependencies)\n\t\tif !resolved.Resolved {\n\t\t\treport.Blockers = append(report.Blockers, key+\":\"+resolved.State)\n\t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n\t\t\tcontinue\n\t\t}\n\t\tif selected, exists := snapshotRevisions[proven.Project]; exists && selected != \"\" && resolved.Revision != selected {\n\t\t\treport.Blockers = append(report.Blockers, key+\":source-revision-changed-during-resolution\")\n\t\t} else if _, exists := snapshotRevisions[proven.Project]; !exists && resolved.Revision != \"\" {\n\t\t\tsnapshotRevisions[proven.Project] = resolved.Revision\n\t\t}\n\t\tgraphValid := true\n\t\tif reason := resolver.ValidateGraph(item.project, item.raw); reason != \"\" {\n\t\t\tgraphValid = false\n\t\t\tentry.ResolutionState = reason\n\t\t\treport.Blockers = append(report.Blockers, key+\":\"+reason)\n\t\t}\n\t\tstatusDone := resolved.Status == \"done\"\n\t\tif !statusDone {\n\t\t\treport.Blockers = append(report.Blockers, key+\":not-done\")\n\t\t}\n\t\tsource, sourceErr := resolver.Roots.StoreFor(proven.Project)\n\t\tif sourceErr != nil {\n\t\t\tentry.ResolutionState = projectResolutionState(sourceErr)\n\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n\t\t\tcontinue\n\t\t}\n\t\tsource = resolver.withSpecSnapshot(proven.Project, source)\n\t\tprojectRoots[proven.Project] = source\n\t\tsource.FederatedProjectID = proven.Project\n\t\tsource.FederatedResolver = &resolver\n\t\tartifactValid := true\n\t\tif err := verifyFederatedArtifactAtRevision(s.fsys(), source, proven, resolved); err != nil {\n\t\t\tartifactValid = false\n\t\t\tentry.ResolutionState = err.Error()\n\t\t\tblocker := key + \":\" + err.Error()\n\t\t\tif err.Error() == federatedSourceUncommitted {\n\t\t\t\tblocker += \": commit the artifact, its working file differs from its revision\"\n\t\t\t}\n\t\t\treport.Blockers = append(report.Blockers, blocker)\n\t\t}\n\t\t// Same-project dependencies need the revision of their own artifact.\n\t\t// Using repository HEAD makes every unrelated evidence commit stale a\n\t\t// sealed milestone or roadmap. External dependencies retain the explicit\n\t\t// whole-repository pin checked below.\n\t\tif proven.Project == projectID {\n\t\t\tif stable := federatedArtifactLastChange(s.fsys(), source, proven); stable != \"\" {\n\t\t\t\tentry.SourceRevision = stable\n\t\t\t}\n\t\t\t// Under an adopted closeout review policy a local milestone or\n\t\t\t// roadmap is closed by its explicit close, never by the status\n\t\t\t// its members give it: the edge asks the terminal projection,\n\t\t\t// along a chain that stops at a cycle (review round 6, N22).\n\t\t\tif statusDone && graphValid && !s.indexMaterial && (proven.Kind == \"milestone\" || proven.Kind == \"roadmap\") {\n\t\t\t\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || adopted && !s.localScopeClosed(localFederatedScope(proven)) {\n\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":closeout-not-terminal\")\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif proven.Project != projectID {\n\t\t\t// Do not recurse into source closeout when graph traversal has already\n\t\t\t// found a cycle or stale artifact. The blocker is conclusive, and\n\t\t\t// recursively asking each side of a cycle for its review would never\n\t\t\t// converge.\n\t\t\tgitlinkValid := true\n\t\t\tpin, pinErr := FederatedProjectTrustForIn(s.fsys(), source.Root, proven.Project)\n\t\t\tif pinErr != nil {\n\t\t\t\tentry.ResolutionState = pinErr.Error()\n\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t} else {\n\t\t\t\tentry.SourceContractDigest, entry.SourcePolicyDigest = pin.ContractDigest, pin.PolicyDigest\n\t\t\t}\n\t\t\tif !policy.Enabled {\n\t\t\t\tentry.ResolutionState = \"consumer-trust-not-adopted\"\n\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t} else {\n\t\t\t\taccepted, exists := policy.TrustedProjects[proven.Project]\n\t\t\t\tif pinErr != nil {\n\t\t\t\t\t// The pin error was recorded above; retain the stable state.\n\t\t\t\t} else if !exists {\n\t\t\t\t\tentry.ResolutionState = \"consumer-trust-not-adopted\"\n\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t\t} else if accepted != pin {\n\t\t\t\t\tentry.ResolutionState = \"consumer-trust-stale\"\n\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t\t} else {\n\t\t\t\t\tif proven.Project == item.parent {\n\t\t\t\t\t\t// This edge remains inside the selected source repository;\n\t\t\t\t\t\t// its local artifacts inherit that repository's pin.\n\t\t\t\t\t} else if parentStore, parentErr := resolver.Roots.StoreFor(item.parent); parentErr != nil || !federatedGitlinkMatchesIn(s.fsys(), parentStore, source, resolved.Revision) {\n\t\t\t\t\t\tgitlinkValid = false\n\t\t\t\t\t\tif parentErr != nil {\n\t\t\t\t\t\t\tentry.ResolutionState = projectResolutionState(parentErr)\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\tentry.ResolutionState = \"gitlink-revision-mismatch\"\n\t\t\t\t\t\t}\n\t\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\taccepted, trusted := policy.TrustedProjects[proven.Project]\n\t\t\tproofInputsReady := graphValid && statusDone && artifactValid && pinErr == nil && policy.Enabled && trusted && accepted == pin && gitlinkValid\n\t\t\tif proofInputsReady {\n\t\t\t\tbundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, proofBlockers := federatedSourceProof(s.fsys(), source, proven, resolved.Revision)\n\t\t\t\tentry.ReviewBundleID, entry.ReviewBundleDigest = bundleID, bundleDigest\n\t\t\t\tentry.ImplementationDigest, entry.PlanDigest = subjectDigest, planDigest\n\t\t\t\tentry.GoverningContracts, entry.Evidence = contracts, evidence\n\t\t\t\treport.Blockers = append(report.Blockers, proofBlockers...)\n\t\t\t\tif len(proofBlockers) > 0 {\n\t\t\t\t\tentry.ResolutionState = \"source-evidence-incomplete\"\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n\t\tfor _, dep := range resolved.Dependencies {\n\t\t\tqueue = append(queue, federatedQueuedRef{project: dep.Project, parent: proven.Project, raw: dep.String(), relationship: \"prerequisite\"})\n\t\t}\n\t}\n\tfor project, selected := range snapshotRevisions {\n\t\tif selected == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\troot, ok := projectRoots[project]\n\t\tif ok && gitHeadAtRootIn(s.fsys(), root.Root, federatedAcceptanceProducer) != selected {\n\t\t\treport.Blockers = append(report.Blockers, \"source-snapshot-changed-during-resolution:\"+project)\n\t\t}\n\t}\n\treport.Blockers = append(report.Blockers, federatedOwnershipConflicts(s.fsys(), projectRoots, resolver)...)\n\tsort.Slice(report.Manifest.Dependencies, func(i, j int) bool {\n\t\tleft, right := report.Manifest.Dependencies[i], report.Manifest.Dependencies[j]\n\t\tif left.Identity.String() != right.Identity.String() {\n\t\t\treturn left.Identity.String() < right.Identity.String()\n\t\t}\n\t\treturn left.Relationship < right.Relationship\n\t})\n\treport.Blockers = uniqueSorted(report.Blockers)\n\treport.Manifest.Ready = len(report.Blockers) == 0\n\treport.Manifest.Blockers = append([]string{}, report.Blockers...)\n\treport.Manifest.Digest = \"\"\n\treport.Manifest.Digest = canonicalFederatedDigest(report.Manifest)\n\treport.Ready = report.Manifest.Ready\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-not-terminal\"}\n\t}\n\t// A milestone or roadmap the source closed without its own review, under\n\t// its adopted closeout review policy, is proven by the receipt of that\n\t// close: the source's policy decides, never the consumer's. Its members\n\t// are federated with their own reviews (spec\n\t// pose-closeout-review-policy-by-cost-benefit).\n\tif receipt := state.CloseoutReceipt; receipt != nil && !receipt.Decision.Required && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n\t\traw, err := json.Marshal(receipt)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-receipt-unreadable\"}\n\t\t}\n\t\treturn \"closeout-receipt:\" + scope, \"sha256:\" + digestHex(raw), receipt.SubjectDigest, receipt.PolicyDigest, nil, nil, nil\n\t}\n\tverification, err := source.VerifyReviewBundle(scope)\n\t// A milestone its roadmap declares has no review of its own: what a consumer can\n\t// hold is the review of that roadmap, which sealed the declaration.\n\tif err == nil && identity.Kind == \"milestone\" && strings.HasPrefix(verification.ApprovalOrigin, \"declared:\") {\n\t\tverification, err = source.VerifyReviewBundle(\"roadmap:\" + identity.Slug)\n\t}\n\tif err != nil || !verification.Fresh || !verification.Approved || verification.Bundle == nil || verification.Attestation == nil || !source.sealedDeclarationHolds(verification.Bundle) {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-review-not-approved\"}\n\t}\n\tbundle := verification.Bundle\n\teligible := federatedSourceEvidenceEligibilityIn(files, source.Root, pinnedRevision, bundle.Payload.Subject.Head)\n\tif identity.Kind == \"spec\" {\n\t\tspec, err := source.GetSpec(identity.Slug)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":unavailable-artifact\"}\n\t\t}\n\t\ttargets, _, err := ParseDeliveryTargets(*spec)\n\t\tif err != nil || len(targets) == 0 {\n\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-target-missing\"}\n\t\t}\n\t\tprofiles, err := loadFederatedDeliveryProfiles(files, source.Root)\n\t\tif err != nil {\n\t}\n\treturn \"\"\n}\n\nconst federatedAcceptanceProducer = \"federated-acceptance\"\n\nfunc captureFederatedGit(files Files, root string, args ...string) ([]byte, error) {\n\treturn captureFederatedGitAs(files, root, federatedAcceptanceProducer, args...)\n}\n\nfunc captureFederatedGitAs(files Files, root, fallbackProducer string, args ...string) ([]byte, error) {\n\tproducer := governanceProducerFromFiles(files, fallbackProducer)\n\treturn CaptureGovernanceRawHistoryGitIn(files, root, producer, maxFederatedGovernanceInputBytes, args...)\n}\n\nfunc markFederatedGitReadUnknown(files Files, root, reason string) {\n\tview, _ := governanceReadViewFromFiles(files)\n\tif view == nil || !hasGitMetadataIn(FilesOrNative(files), root) {\n\t\treturn\n\t}\n\tif view.operation != nil && view.operation.mayOmitPrimaryRevision(root) {\n\t\treturn\n\t}\n\tproducer := governanceProducerFromFiles(files, federatedAcceptanceProducer)\n\tmarkGovernanceReadUnknownForProject(files, root, \"\", producer, reason)\n}\n\nfunc federatedGitAncestorIn(files Files, root, older, newer string) bool {\n\tproducer := governanceProducerFromFiles(files, federatedAcceptanceProducer)\n\t_, err := CaptureGovernanceRawHistoryGitIn(files, root, producer, maxFederatedGovernanceInputBytes, \"merge-base\", \"--is-ancestor\", older, newer)\n\tif err == nil {\n\t\treturn true\n\t}\n\tvar exit *exec.ExitError\n\tif errors.As(err, &exit) && exit.ExitCode() == 1 {\n\t\treturn false\n\t}\n\tmarkFederatedGitReadUnknown(files, root, \"federated evidence ancestry could not be verified\")\n\treturn false\n}\n\nfunc projectResolutionState(err error) string {\n\tvar conflict ProjectBindingConflictError\n\tvar ambiguous ProjectAmbiguousError\n\tif strings.Contains(err.Error(), \"unknown project\") {\n\t\treturn \"unknown-project\"\nfunc sameFederatedManifest(a, b *FederatedRoadmapManifest) bool {\n\tif a == nil || b == nil {\n\t\treturn a == nil && b == nil\n\t}\n\tleft, errA := json.Marshal(a)\n\tright, errB := json.Marshal(b)\n\treturn errA == nil && errB == nil && bytes.Equal(left, right)\n}\n\n// retainedApprovalStands reports whether a bundle retained for a closed scope holds\n// against the manifest the scope resolves to now. It is the one judgment of that, so\n// that `review verify` and closeout give the same answer (spec\n// pose-closeout-judges-the-manifest R1, R2). Without a resolver no manifest can be\n// judged.\nfunc (s Store) retainedApprovalStands(bundle *ReviewBundle, current *FederatedRoadmapManifest) bool {\n\tif !s.sealedDeclarationHolds(bundle) {\n\t\treturn false\n\t}\n\treturn s.FederatedResolver == nil || s.federatedManifestStands(bundle.Payload.FederatedManifest, current)\n}\n\n// sealedDeclarationHolds reports that a bundle of a roadmap sealed the reason the roadmap\n// gives now for unreviewed milestones: an approval is no authority for an exception its\n// reviewer never read.\nfunc (s Store) sealedDeclarationHolds(bundle *ReviewBundle) bool {\n\tif bundle.Payload.Scope.Kind != \"roadmap\" {\n\t\treturn true\n\t}\n\trm, err := s.GetRoadmap(bundle.Payload.Scope.Slug)\n\tif err != nil {\n","exit_code":0,"status":"completed"}}
