{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YYb72CgZoy21ESkZtK3BFg","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"crypto/sha256\"\n7\t\t\"encoding/hex\"\n8\t\t\"encoding/json\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"os/exec\"\n12\t\t\"path/filepath\"\n13\t\t\"sort\"\n14\t\t\"strings\"\n15\t\t\"sync\"\n16\t\t\"time\"\n17\t)\n18\t\n19\tconst governanceReadViewGitParserVersion = \"pose-governance-git-inputs-v1\"\n20\t\n21\ttype governanceReadViewGitObservation struct {\n22\t\troot           string\n23\t\targs           []string\n24\t\tfiles          Files\n25\t\tctx            context.Context\n26\t\tdeadline       time.Time\n27\t\thasDeadline    bool\n28\t\tmaxOutputBytes int64\n29\t\tstdout         []byte\n30\t\tstderr         []byte\n31\t\terr            error\n32\t\terrText        string\n33\t\tproducers      map[string]bool\n34\t\t// pure is set when the output cannot change while the commit it was read at stands: it is a\n35\t\t// function of object ids, or of headAt, the commit HEAD named before and after the command.\n36\t\t// The final audit then reruns it only if HEAD moved.\n37\t\tpure   bool\n38\t\theadAt string\n39\t}\n40\t\n41\t// governanceReadViewGitState captures exact, bounded Git command results for\n42\t// one read-view operation. Repeated commands replay the first result; audit\n43\t// reruns each exact command and reports any changed or unprovable result.\n44\ttype governanceReadViewGitState struct {\n45\t\top            *governanceReadViewOperation\n46\t\tmu            sync.Mutex\n47\t\tobservations  map[string]*governanceReadViewGitObservation\n48\t\tconfigMu      sync.Mutex\n49\t\tconfigDigests map[string]string\n50\t}\n51\t\n52\t// effectiveGitConfig is the digest of `git config --list` of a root (every scope, includes\n53\t// followed), read once per operation and kept apart from the command observations: it is a key\n54\t// of the resident memo, not an input the audit replays. Empty when it could not be read.\n55\tfunc (state *governanceReadViewGitState) effectiveGitConfig(ctx context.Context, files Files, root string) string {\n56\t\tstate.configMu.Lock()\n57\t\tdefer state.configMu.Unlock()\n58\t\tif digest, ok := state.configDigests[root]; ok {\n59\t\t\treturn digest\n60\t\t}\n61\t\tdigest := \"\"\n62\t\tif out, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, []string{\"config\", \"--list\", \"-z\", \"--includes\"}, 1<<20); err == nil {\n63\t\t\tsum := sha256.Sum256(out)\n64\t\t\tdigest = hex.EncodeToString(sum[:8])\n65\t\t}\n66\t\tstate.configDigests[root] = digest\n67\t\treturn digest\n68\t}\n69\t\n70\tfunc newGovernanceReadViewGitState(op *governanceReadViewOperation) *governanceReadViewGitState {\n71\t\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}, configDigests: map[string]string{}}\n72\t}\n73\t\n74\t// captureGovernanceGit runs a Git command through the read-view generation\n75\t// when Files belongs to one. Native and preview operations retain their\n76\t// existing behavior when there is no governance view.\n77\tfunc captureGovernanceGit(files Files, root, producer string, args ...string) ([]byte, error) {\n78\t\treturn captureGovernanceGitBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n79\t}\n80\t\n81\t// CaptureGovernanceGitIn executes one bounded raw-history Git command through\n82\t// the operation's captured read view when Files carries one. maxOutputBytes\n83\t// bounds combined stdout and stderr before bytes are retained. Git commands\n84\t// use gitCommand, which disables replacement refs and grafts.\n85\tfunc CaptureGovernanceGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n86\t\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n87\t\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n88\t\t}\n89\t\treturn captureGovernanceGitBounded(files, root, producer, maxOutputBytes, args...)\n90\t}\n91\t\n92\t// CaptureGovernanceRawHistoryGitIn names the history semantics explicitly for\n93\t// callers whose result depends on raw commit ancestry or object contents.\n94\tfunc CaptureGovernanceRawHistoryGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n95\t\treturn CaptureGovernanceGitIn(files, root, producer, maxOutputBytes, args...)\n96\t}\n97\t\n98\t// CaptureGovernanceGitContextIn is CaptureGovernanceGitIn under ctx. The same\n99\t// context is retained for the final audit rerun.\n100\tfunc CaptureGovernanceGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n101\t\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n102\t\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n103\t\t}\n104\t\treturn captureGovernanceGitBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n105\t}\n106\t\n107\t// CaptureGovernanceRawHistoryGitContextIn names raw history semantics for\n108\t// context-bound callers that inspect commit ancestry or object contents.\n109\tfunc CaptureGovernanceRawHistoryGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n110\t\treturn CaptureGovernanceGitContextIn(files, ctx, root, producer, maxOutputBytes, args...)"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"69d7cc15-62e4-4fef-b506-aee1f3bc19de","timestamp":"2026-11-10T21:35:19.125Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-1183365784/worktree/pose-mcp/internal/pose/governance_read_view_git.go","content":"package pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n)\n\nconst governanceReadViewGitParserVersion = \"pose-governance-git-inputs-v1\"\n\ntype governanceReadViewGitObservation struct {\n\troot           string\n\targs           []string\n\tfiles          Files\n\tctx            context.Context\n\tdeadline       time.Time\n\thasDeadline    bool\n\tmaxOutputBytes int64\n\tstdout         []byte\n\tstderr         []byte\n\terr            error\n\terrText        string\n\tproducers      map[string]bool\n\t// pure is set when the output cannot change while the commit it was read at stands: it is a\n\t// function of object ids, or of headAt, the commit HEAD named before and after the command.\n\t// The final audit then reruns it only if HEAD moved.\n\tpure   bool\n\theadAt string\n}\n\n// governanceReadViewGitState captures exact, bounded Git command results for\n// one read-view operation. Repeated commands replay the first result; audit\n// reruns each exact command and reports any changed or unprovable result.\ntype governanceReadViewGitState struct {\n\top            *governanceReadViewOperation\n\tmu            sync.Mutex\n\tobservations  map[string]*governanceReadViewGitObservation\n\tconfigMu      sync.Mutex\n\tconfigDigests map[string]string\n}\n\n// effectiveGitConfig is the digest of `git config --list` of a root (every scope, includes\n// followed), read once per operation and kept apart from the command observations: it is a key\n// of the resident memo, not an input the audit replays. Empty when it could not be read.\nfunc (state *governanceReadViewGitState) effectiveGitConfig(ctx context.Context, files Files, root string) string {\n\tstate.configMu.Lock()\n\tdefer state.configMu.Unlock()\n\tif digest, ok := state.configDigests[root]; ok {\n\t\treturn digest\n\t}\n\tdigest := \"\"\n\tif out, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, []string{\"config\", \"--list\", \"-z\", \"--includes\"}, 1<<20); err == nil {\n\t\tsum := sha256.Sum256(out)\n\t\tdigest = hex.EncodeToString(sum[:8])\n\t}\n\tstate.configDigests[root] = digest\n\treturn digest\n}\n\nfunc newGovernanceReadViewGitState(op *governanceReadViewOperation) *governanceReadViewGitState {\n\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}, configDigests: map[string]string{}}\n}\n\n// captureGovernanceGit runs a Git command through the read-view generation\n// when Files belongs to one. Native and preview operations retain their\n// existing behavior when there is no governance view.\nfunc captureGovernanceGit(files Files, root, producer string, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n}\n\n// CaptureGovernanceGitIn executes one bounded raw-history Git command through\n// the operation's captured read view when Files carries one. maxOutputBytes\n// bounds combined stdout and stderr before bytes are retained. Git commands\n// use gitCommand, which disables replacement refs and grafts.\nfunc CaptureGovernanceGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBounded(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitIn names the history semantics explicitly for\n// callers whose result depends on raw commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitIn(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceGitContextIn is CaptureGovernanceGitIn under ctx. The same\n// context is retained for the final audit rerun.\nfunc CaptureGovernanceGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitContextIn names raw history semantics for\n// context-bound callers that inspect commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitContextIn(files, ctx, root, producer, maxOutputBytes, args...)","numLines":110,"startLine":1,"totalLines":690}},"tool_result_meta":[{"id":"toolu_01YYb72CgZoy21ESkZtK3BFg","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
