append(lost, \"the active run marker \"+e.Name()+\" is not one this engine reads\")\n   268\t\t\t\tcontinue\n   269\t\t\t}\n   270\t\t\tmarker.Liveness, marker.Detail = probeStartLockOwner(marker.Owner)\n   271\t\t\tmarker.StalledAt = readDelegationStall(dir, marker)\n   272\t\t\tif marker.StalledAt == \"\" && delegationMarkerSilent(marker, time.Now()) && marker.Liveness == LockOwnerDead {\n   273\t\t\t\tmarker.StalledAt = recordDelegationStall(dir, marker)\n   274\t\t\t}\n   275\t\t\tif _, err := os.Lstat(cancelRequestPath(dir, marker)); err == nil {\n   276\t\t\t\tmarker.CancelRequested = true\n   277\t\t\t}\n   278\t\t\tout = append(out, marker)\n   279\t\t}\n   280\t\tsort.Slice(out, func(i, j int) bool {\n   281\t\t\treturn out[i].StartedAt < out[j].StartedAt || out[i].StartedAt == out[j].StartedAt && out[i].AttemptID < out[j].AttemptID\n   282\t\t})\n   283\t\treturn out, lost, nil\n   284\t}\n   285\t\n   286\t// ErrDelegationNotActive means no running run matches.\n   287\tvar ErrDelegationNotActive = errors.New(\"pose: the run is not running\")\n   288\t\n   289\t// RequestDelegationCancel asks the process running attempt to stop. A marker\n   290\t// whose owner is proven dead is not cancelled: nothing runs to stop.\n   291\tfunc (s Store) RequestDelegationCancel(attempt string) (DelegationActiveRun, error) {\n   292\t\tactive, _, err := s.ListDelegationActive()\n   293\t\tif err != nil {\n   294\t\t\treturn DelegationActiveRun{}, err\n   295\t\t}\n   296\t\tfor _, marker := range active {\n   297\t\t\tif marker.AttemptID != attempt {\n   298\t\t\t\tcontinue\n   299\t\t\t}\n   300\t\t\tif marker.Liveness == LockOwnerDead {\n   301\t\t\t\treturn marker, fmt.Errorf(\"pose: the process of attempt %s is gone (%s); nothing runs to cancel\", attempt, marker.Detail)\n   302\t\t\t}\n   303\t\t\tdir, err := s.delegationActiveDir(false)\n   304\t\t\tif err != nil {\n   305\t\t\t\treturn marker, err\n   306\t\t\t}\n   307\t\t\trequest := cancelRequestPath(dir, marker)\n   308\t\t\tif err := PublishFile(request, []byte(time.Now().UTC().Format(time.RFC3339Nano)+\"\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil && !errors.Is(err, os.ErrExist) {\n   309\t\t\t\tif _, statErr := os.Lstat(request); statErr != nil {\n   310\t\t\t\t\treturn marker, err\n   311\t\t\t\t}\n   312\t\t\t}\n   313\t\t\t// The run may have ended between the read and the request: a request\n   314\t\t\t// that names no running run is withdrawn, never left for a successor.\n   315\t\t\tif !s.DelegationRunActive(marker) {\n   316\t\t\t\t_ = os.Remove(request)\n   317\t\t\t\treturn marker, ErrDelegationNotActive\n   318\t\t\t}\n   319\t\t\tmarker.CancelRequested = true\n   320\t\t\treturn marker, nil\n   321\t\t}\n   322\t\treturn DelegationActiveRun{}, ErrDelegationNotActive\n   323\t}\n   324\t\n   325\t// DelegationRunActive reports whether the run marker names is still the\n   326\t// running run of its attempt.\n   327\tfunc (s Store) DelegationRunActive(marker DelegationActiveRun) bool {\n   328\t\tdir, err := s.delegationActiveDir(false)\n   329\t\tif err != nil {\n   330\t\t\treturn false\n   331\t\t}\n   332\t\traw, err := readLedgerRaw(filepath.Join(dir, marker.AttemptID+\".json\"))\n   333\t\tif err != nil {\n   334\t\t\treturn false\n   335\t\t}\n   336\t\tvar now DelegationActiveRun\n   337\t\treturn json.Unmarshal(raw, &now) == nil && now.RunToken == marker.RunToken\n   338\t}\n   339\t\n   340\t// DelegationPrivateDir is a directory of the engine's private delegation\n   341\t// state, created without following a link; Git ignores the whole private tree.\n   342\tfunc (s Store) DelegationPrivateDir(name string) (string, error) {\n   343\t\tif _, err := s.delegationActiveDir(true); err != nil {\n   344\t\t\treturn \"\", err\n   345\t\t}\n   346\t\treturn ensureReviewArtifactDir(s.Root, reviewPrivateDir+\"/\"+name, true)\n   347\t}\n   348\t\n   349\t// DelegationActiveMarkerExists reports, without reading the run history,\n   350\t// whether attempt still has a marker: a waiter checks this cheaply and reads\n   351\t// the history only when it is gone (spec\n   352\t// pose-delegated-review-completion-signal R3).\n   353\tfunc (s Store) DelegationActiveMarkerExists(attempt string) bool {\n   354\t\tif !validAttemptFileName(attempt) {\n   355\t\t\treturn false\n   356\t\t}\n   357\t\tdir, err := s.delegationActiveDir(false)\n   358\t\tif err != nil {\n   359\t\t\treturn false\n   360\t\t}\n   361\t\t_, err = os.Lstat(filepath.Join(dir, attempt+\".json\"))\n   362\t\treturn err == nil\n   363\t}\n    48\t\tRunID            string `json:\"run_id\"`\n    49\t\tBundleID         string `json:\"bundle_id\"`\n    50\t\tScope            string `json:\"scope\"`\n    51\t\tRecordDigest     string `json:\"record_digest\"`\n    52\t\tTranscriptDigest string `json:\"transcript_digest\"`\n    53\t}\n    54\t\n    55\tfunc reviewAttemptKey(bundle string) string {\n    56\t\treturn strings.TrimPrefix(digestBytes([]byte(bundle)), \"sha256:\")[:24]\n    57\t}\n    58\tfunc reviewAttemptPath(root string, a DelegatedReviewAttempt) string {\n    59\t\treturn filepath.Join(root, reviewAttemptDir, reviewAttemptKey(a.BundleID), fmt.Sprintf(\"%06d.json\", a.Ordinal))\n    60\t}\n    61\tfunc attemptReceiptPath(root string, a DelegatedReviewAttempt) string {\n    62\t\treturn strings.TrimSuffix(reviewAttemptPath(root, a), \".json\") + \".result.json\"\n    63\t}\n    64\tfunc attemptIdentity(a DelegatedReviewAttempt) string {\n    65\t\ta.AttemptID = \"\"\n    66\t\traw, _ := json.Marshal(a)\n    67\t\treturn \"rat-\" + strings.TrimPrefix(digestBytes(raw), \"sha256:\")\n    68\t}\n    69\t\n    70\tfunc readLedgerRaw(path string) ([]byte, error) {\n    71\t\treturn readBoundedRegular(path, reviewLedgerMaxBytes)\n    72\t}\n   190\t\t}\n   191\t}\n   192\t\n   193\t// Review round 2, N4 (R6): a real dispatch interrupted after its reservation\n   194\t// and before its run record blocks the next dispatch; once released, the\n   195\t// next dispatch runs.\n   196\tfunc TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns(t *testing.T) {\n   197\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   198\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   199\t\tif err != nil {\n   200\t\t\tt.Fatal(err)\n   201\t\t}\n   202\t\tattempt := \"\"\n   203\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   204\t\tfunc() {\n   205\t\t\tdefer func() { _ = recover() }()\n   206\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   207\t\t}()\n   208\t\tif attempt == \"\" {\n   209\t\t\tt.Fatal(\"the dispatch never reached its start\")\n   210\t\t}\n   211\t\twriteDeadMarker(t, f.store, attempt)\n   212\t\tif _, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after interruption\"); err == nil || !strings.Contains(err.Error(), \"pose delegate cancel \"+attempt) {\n   213\t\t\tt.Fatalf(\"the interrupted attempt did not block the bundle with its release command: %v\", err)\n   214\t\t}\n   215\t\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil {\n   216\t\t\tt.Fatal(err)\n   217\t\t}\n   218\t\tnext, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\")\n   219\t\tif err != nil {\n   220\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n   221\t\t}\n   222\t\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n   223\t\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n   224\t\t}\n   225\t}\n   226\t\n   227\t// Review round 2, N3: a release already claimed is not run again.\n   228\tfunc TestAClaimedReleaseIsNotRunTwice(t *testing.T) {\n   229\t\troot := t.TempDir()\n   230\t\ts := Store{Root: root}\n   231\t\tattempt := \"rat-\" + strings.Repeat(\"9\", 64)\n   232\t\tdir, _ := s.delegationActiveDir(true)\n   233\t\tclaim := filepath.Join(dir, attempt+\".release\")\n   234\t\tlive := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"release:x\", Operation: \"pose delegate cancel\", PID: os.Getpid()}\n   235\t\tlive.Host, _ = os.Hostname()\n   236\t\tidentifyStartLockProcess(&live)\n   237\t\traw, _ := json.Marshal(live)\n   238\t\tif err := os.WriteFile(claim, raw, 0o600); err != nil {\n   239\t\t\tt.Fatal(err)\n   240\t\t}\n   241\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\n   242\t\t\tt.Fatalf(\"a claimed release ran again: %v\", err)\n   243\t\t}\n   244\t\t// Review round 3, N1: a claim whose owner is gone is an interrupted\n   245\t\t// release, taken over.\n   246\t\tdead := exec.Command(\"true\")\n   247\t\tif err := dead.Run(); err != nil {\n   248\t\t\tt.Fatal(err)\n   249\t\t}\n   250\t\tgone := live\n   251\t\tgone.PID = dead.Process.Pid\n   252\t\traw, _ = json.Marshal(gone)\n   253\t\tif err := os.WriteFile(claim, raw, 0o600); err != nil {\n   254\t\t\tt.Fatal(err)\n   255\t\t}\n   256\t\tif err := claimAttemptRelease(claim, time.Now()); err != nil {\n   257\t\t\tt.Fatalf(\"an interrupted release's claim was not taken over: %v\", err)\n   258\t\t}\n   259\t}\n   260\t\n   261\t// Review round 3, N1: a release interrupted after it recorded the run, and\n   262\t// before the receipt, completes with that run instead of recording another.\n   263\tfunc TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n   264\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   265\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   266\t\tif err != nil {\n   267\t\t\tt.Fatal(err)\n   268\t\t}\n   269\t\tattempt := \"\"\n   270\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   271\t\tfunc() {\n   272\t\t\tdefer func() { _ = recover() }()\n   273\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   274\t\t}()\n   275\t\twriteDeadMarker(t, f.store, attempt)\n   276\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   277\t\tmarkerPath := filepath.Join(activeDir, attempt+\".json\")\n   278\t\tmarkerBytes, err := os.ReadFile(markerPath)\n   279\t\tif err != nil {\n   280\t\t\tt.Fatal(err)\n   281\t\t}\n   282\t\tfirst, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   283\t\tif err != nil {\n   284\t\t\tt.Fatal(err)\n   285\t\t}\n   286\t\t// Undo the receipt and keep the marker, as a release stopped between\n   287\t\t// the run and the receipt leaves them.\n   288\t\tattempts, _ := f.store.readDelegatedReviewAttempts(f.bundle.BundleID)\n   289\t\tfor _, a := range attempts {\n   290\t\t\tif a.AttemptID == attempt {\n   291\t\t\t\tif err := os.Remove(attemptReceiptPath(f.store.Root, a)); err != nil {\n   292\t\t\t\t\tt.Fatal(err)\n   293\t\t\t\t}\n   294\t\t\t}\n   295\t\t}\n   296\t\tif err := os.WriteFile(markerPath, markerBytes, 0o600); err != nil {\n   297\t\t\tt.Fatal(err)\n   298\t\t}\n   299\t\tsecond, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   300\t\tif err != nil || second.RunID != first.RunID {\n   301\t\t\tt.Fatalf(\"the interrupted release recorded another run: %s then %s (%v)\", first.RunID, second.RunID, err)\n   302\t\t}\n   303\t}\n   304\t\n   305\t// Review round 2, N1: a reservation an earlier engine left with no marker is\n   306\t// listed and released once it is old enough, never while it is young.\n   307\tfunc TestAMarkerlessReservationOfAnEarlierEngineIsReleased(t *testing.T) {\n   308\t\troot := t.TempDir()\n   309\t\ts := Store{Root: root}\n   310\t\treserve := func(age time.Duration, nonce string) DelegatedReviewAttempt {\n   311\t\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000b\" + nonce[:1], BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   312\t\t\t\tReservedAt: time.Now().Add(-age).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(nonce[:1], 32)}\n   313\t\t\ta.AttemptID = attemptIdentity(a)\n   314\t\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   315\t\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   316\t\t\t\tt.Fatal(err)\n   317\t\t\t}\n   318\t\t\treturn a\n   319\t\t}\n   320\t\told, young := reserve(time.Hour, \"1\"), reserve(time.Minute, \"2\")\n   321\t\tattempts, _, err := s.ListDelegationAttempts()\n   322\t\tif err != nil {\n   323\t\t\tt.Fatal(err)\n   324\t\t}\n   325\t\tlisted := map[string]DelegationAttempt{}\n   326\t\tfor _, a := range attempts {\n   327\t\t\tlisted[a.AttemptID] = a\n   328\t\t}\n   329\t\tif a, ok := listed[old.AttemptID]; !ok || a.State != DelegationStalled || !strings.Contains(a.Failure, \"pose delegate cancel \"+old.AttemptID+\" --confirm-abandoned\") {\n   330\t\t\tt.Fatalf(\"the old markerless reservation is not listed with its release: %+v\", attempts)\n   331\t\t}\n   332\t\tif _, ok := listed[young.AttemptID]; ok {\n   333\t\t\tt.Fatal(\"a young reservation was listed as abandoned\")\n   334\t\t}\n   335\t\tif _, err := s.ReleaseAbandonedAttempt(young.AttemptID, time.Now(), true); !errors.Is(err, ErrAttemptNotAbandoned) {\n   336\t\t\tt.Fatalf(\"a young reservation was released: %v\", err)\n   337\t\t}\n   338\t\t// Review round 3, N2: nothing proves a markerless reservation abandoned,\n   339\t\t// so it is released only on the operator's confirmation.\n   340\t\tif _, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"--confirm-abandoned\") {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '340,470p' && nl -ba pose-mcp/internal/pose/delegation_active.go | sed -n '80,180p' && nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '77,120p;145,185p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '340,470p' && nl -ba pose-mcp/internal/pose/delegation_active.go | sed -n '80,180p' && nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '77,120p;145,185p'\"","aggregated_output":"   340\t\tif _, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"--confirm-abandoned\") {\n   341\t\t\tt.Fatalf(\"a markerless reservation was released without confirmation: %v\", err)\n   342\t\t}\n   343\t\trun, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n   344\t\tif err != nil || run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"operator's confirmation\") {\n   345\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   346\t\t}\n   347\t\tif _, err := s.readAttemptReceipt(old); err != nil {\n   348\t\t\tt.Fatalf(\"the released reservation still blocks its bundle: %v\", err)\n   349\t\t}\n   350\t\t// Review round 4, N1: a release stopped between its run and its receipt\n   351\t\t// leaves the attempt with a run; it is still released, with that run.\n   352\t\tif err := os.Remove(attemptReceiptPath(root, old)); err != nil {\n   353\t\t\tt.Fatal(err)\n   354\t\t}\n   355\t\tagain, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n   356\t\tif err != nil || again.RunID != run.RunID {\n   357\t\t\tt.Fatalf(\"the interrupted release did not complete with its run: %s then %s (%v)\", run.RunID, again.RunID, err)\n   358\t\t}\n   359\t}\n   360\t\n   361\t// Review round 3, N3: an unreadable reservation is reported, not skipped.\n   362\tfunc TestAnUnreadableReservationIsReportedAsALoss(t *testing.T) {\n   363\t\troot := t.TempDir()\n   364\t\ts := Store{Root: root}\n   365\t\tdir := filepath.Join(root, reviewAttemptDir, \"broken\")\n   366\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n   367\t\t\tt.Fatal(err)\n   368\t\t}\n   369\t\tif err := os.WriteFile(filepath.Join(dir, \"000001.json\"), []byte(\"{not json\"), 0o644); err != nil {\n   370\t\t\tt.Fatal(err)\n   371\t\t}\n   372\t\t_, lost, err := s.ListDelegationAttempts()\n   373\t\tif err != nil || !strings.Contains(strings.Join(lost, \"\\n\"), \"broken/000001.json could not be read\") {\n   374\t\t\tt.Fatalf(\"an unreadable reservation was skipped silently: %v %v\", lost, err)\n   375\t\t}\n   376\t}\n   377\t\n   378\t// Review round 4, N2: two takers of one stale claim never both win.\n   379\tfunc TestAStaleClaimHasOneTaker(t *testing.T) {\n   380\t\tdir := t.TempDir()\n   381\t\tclaim := filepath.Join(dir, \"rat-x.release\")\n   382\t\tdead := exec.Command(\"true\")\n   383\t\tif err := dead.Run(); err != nil {\n   384\t\t\tt.Fatal(err)\n   385\t\t}\n   386\t\tgone := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"release:x\", Operation: \"pose delegate cancel\", PID: os.Getpid()}\n   387\t\tgone.Host, _ = os.Hostname()\n   388\t\tidentifyStartLockProcess(&gone)\n   389\t\tgone.PID = dead.Process.Pid\n   390\t\traw, _ := json.Marshal(gone)\n   391\t\tfor round := 0; round < 20; round++ {\n   392\t\t\tif err := os.WriteFile(claim, raw, 0o600); err != nil {\n   393\t\t\t\tt.Fatal(err)\n   394\t\t\t}\n   395\t\t\tresults := make(chan error, 2)\n   396\t\t\tstart := make(chan struct{})\n   397\t\t\tfor i := 0; i < 2; i++ {\n   398\t\t\t\tgo func() { <-start; results <- claimAttemptRelease(claim, time.Now()) }()\n   399\t\t\t}\n   400\t\t\tclose(start)\n   401\t\t\twon := 0\n   402\t\t\tfor i := 0; i < 2; i++ {\n   403\t\t\t\tif <-results == nil {\n   404\t\t\t\t\twon++\n   405\t\t\t\t}\n   406\t\t\t}\n   407\t\t\tif won != 1 {\n   408\t\t\t\tt.Fatalf(\"round %d: %d takers won the stale claim\", round, won)\n   409\t\t\t}\n   410\t\t\t_ = os.Remove(claim)\n   411\t\t}\n   412\t}\n   413\t\n   414\t// Review round 4, N3: with the run history incomplete, no reservation is\n   415\t// taken as runless, and the loss is reported.\n   416\tfunc TestAnIncompleteRunHistoryRulesNothingOut(t *testing.T) {\n   417\t\troot := t.TempDir()\n   418\t\ts := Store{Root: root}\n   419\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000c1\", BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   420\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"3\", 32)}\n   421\t\ta.AttemptID = attemptIdentity(a)\n   422\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   423\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   424\t\t\tt.Fatal(err)\n   425\t\t}\n   426\t\tif err := os.MkdirAll(filepath.Join(root, reviewRunsDir), 0o755); err != nil {\n   427\t\t\tt.Fatal(err)\n   428\t\t}\n   429\t\tif err := os.WriteFile(filepath.Join(root, reviewRunsDir, \"rrn-0000000000000bad.json\"), []byte(\"{broken\"), 0o644); err != nil {\n   430\t\t\tt.Fatal(err)\n   431\t\t}\n   432\t\tif _, runLost, err := s.ReadReviewRuns(\"\"); err != nil || len(runLost) == 0 {\n   433\t\t\tt.Skipf(\"the fixture does not make the run history incomplete: %v %v\", runLost, err)\n   434\t\t}\n   435\t\torphans, lost, err := s.orphanReservations(time.Now())\n   436\t\tif err != nil || len(orphans) != 0 || !strings.Contains(strings.Join(lost, \"\\n\"), \"run history is incomplete\") {\n   437\t\t\tt.Fatalf(\"an incomplete history ruled a run out: %v %v %v\", orphans, lost, err)\n   438\t\t}\n   439\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n   440\t\t\tt.Fatal(\"a reservation was released over an incomplete run history\")\n   441\t\t}\n   442\t}\n    80\tfunc validAttemptFileName(attempt string) bool {\n    81\t\treturn attempt != \"\" && len(attempt) <= 128 && !strings.ContainsAny(attempt, `/\\.`+\"\\x00\")\n    82\t}\n    83\t\n    84\t// markDelegationActive writes the marker and starts the cancellation watcher.\n    85\t// The returned stop removes both; cancelled reports whether a cancellation\n    86\t// request stopped the run.\n    87\t//\n    88\t// stop(true) stops the watcher and the heartbeat but keeps the marker: a run\n    89\t// whose record was not published leaves it, and it turns stalled once its\n    90\t// process is gone (spec pose-delegated-review-completion-signal R4, R5).\n    91\tfunc (s Store) markDelegationActive(run ReviewRun, cancel context.CancelFunc) (stop func(keepMarker ...bool), cancelled *atomic.Bool, err error) {\n    92\t\tcancelled = &atomic.Bool{}\n    93\t\tif !validAttemptFileName(run.AttemptID) {\n    94\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: attempt %q cannot name an active marker\", run.AttemptID)\n    95\t\t}\n    96\t\tdir, err := s.delegationActiveDir(true)\n    97\t\tif err != nil {\n    98\t\t\treturn func(...bool) {}, cancelled, err\n    99\t\t}\n   100\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + run.AttemptID, Worktree: s.Root, Operation: \"pose delegate \" + run.Purpose, PID: os.Getpid(), AcquiredAt: run.StartedAt}\n   101\t\towner.Host, _ = os.Hostname()\n   102\t\tidentifyStartLockProcess(&owner)\n   103\t\ttoken := make([]byte, 16)\n   104\t\tif _, err := rand.Read(token); err != nil {\n   105\t\t\treturn func(...bool) {}, cancelled, err\n   106\t\t}\n   107\t\tevery := delegationHeartbeatEvery\n   108\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: run.AttemptID, RunToken: hex.EncodeToString(token), Resumes: run.Resumes, Label: run.Label, Purpose: run.Purpose, Agent: run.Adapter, Scope: run.Scope, BundleID: run.BundleID, StartedAt: run.StartedAt, Owner: owner, Round: run.Round,\n   109\t\t\tHeartbeatAt: time.Now().UTC().Format(time.RFC3339Nano), HeartbeatEvery: int(every / time.Second)}\n   110\t\traw, _ := json.MarshalIndent(marker, \"\", \"  \")\n   111\t\tpath := filepath.Join(dir, run.AttemptID+\".json\")\n   112\t\trequest := cancelRequestPath(dir, marker)\n   113\t\tif err := PublishFile(path, append(raw, '\\n'), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n   114\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: another run of attempt %s is active: %w\", run.AttemptID, err)\n   115\t\t}\n   116\t\tdone, exited := make(chan struct{}), make(chan struct{})\n   117\t\tgo func() {\n   118\t\t\tdefer close(exited)\n   119\t\t\tticker := time.NewTicker(250 * time.Millisecond)\n   120\t\t\tdefer ticker.Stop()\n   121\t\t\theartbeat := time.NewTicker(every)\n   122\t\t\tdefer heartbeat.Stop()\n   123\t\t\tfor {\n   124\t\t\t\tselect {\n   125\t\t\t\tcase <-done:\n   126\t\t\t\t\treturn\n   127\t\t\t\tcase <-heartbeat.C:\n   128\t\t\t\t\t// Select picks among ready cases at random: once stop has\n   129\t\t\t\t\t// asked, no further heartbeat starts, so it waits for at\n   130\t\t\t\t\t// most the one in flight (review round 1, HB01).\n   131\t\t\t\t\tselect {\n   132\t\t\t\t\tcase <-done:\n   133\t\t\t\t\t\treturn\n   134\t\t\t\t\tdefault:\n   135\t\t\t\t\t}\n   136\t\t\t\t\tbeatDelegationMarker(path, marker.RunToken)\n   137\t\t\t\tcase <-ticker.C:\n   138\t\t\t\t\tif _, err := os.Lstat(request); err == nil {\n   139\t\t\t\t\t\tcancelled.Store(true)\n   140\t\t\t\t\t\tcancel()\n   141\t\t\t\t\t\treturn\n   142\t\t\t\t\t}\n   143\t\t\t\t}\n   144\t\t\t}\n   145\t\t}()\n   146\t\tvar once sync.Once\n   147\t\tstop = func(keepMarker ...bool) {\n   148\t\t\tonce.Do(func() {\n   149\t\t\t\tclose(done)\n   150\t\t\t\tdelegationStopRequested()\n   151\t\t\t\t// A heartbeat in flight finishes before the marker goes, so it\n   152\t\t\t\t// cannot rename a new one into place after the removal (spec\n   153\t\t\t\t// pose-delegation-marker-stop-joins-heartbeat R1).\n   154\t\t\t\t<-exited\n   155\t\t\t\t_ = os.Remove(request)\n   156\t\t\t\tif len(keepMarker) == 0 || !keepMarker[0] {\n   157\t\t\t\t\t_ = os.Remove(path)\n   158\t\t\t\t}\n   159\t\t\t})\n   160\t\t}\n   161\t\treturn stop, cancelled, nil\n   162\t}\n   163\t\n   164\t// delegationStopRequested is a test seam called once stop has asked the\n   165\t// watcher to end, before it waits for it.\n   166\tvar delegationStopRequested = func() {}\n   167\t\n   168\t// delegationHeartbeatEvery is the interval a running attempt declares.\n   169\tvar delegationHeartbeatEvery = 10 * time.Second\n   170\t\n   171\t// beatDelegationMarker rewrites the heartbeat of the marker run token names,\n   172\t// by compare-and-swap: a marker already recorded stalled, or replaced by\n   173\t// another run, is left as it is.\n   174\tfunc beatDelegationMarker(path, token string) {\n   175\t\traw, err := readLedgerRaw(path)\n   176\t\tif err != nil {\n   177\t\t\treturn\n   178\t\t}\n   179\t\tvar marker DelegationActiveRun\n   180\t\tif json.Unmarshal(raw, &marker) != nil || marker.RunToken != token {\n    77\t// claimAttemptRelease publishes the release claim with its owner. A claim\n    78\t// whose owner is proven gone is an interrupted release and is taken over.\n    79\tfunc claimAttemptRelease(claim string, now time.Time) error {\n    80\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"release:\" + filepath.Base(claim), Operation: \"pose delegate cancel\", PID: os.Getpid(), AcquiredAt: now.UTC().Format(time.RFC3339Nano)}\n    81\t\towner.Host, _ = os.Hostname()\n    82\t\tidentifyStartLockProcess(&owner)\n    83\t\traw, _ := json.Marshal(owner)\n    84\t\tpublish := func() error {\n    85\t\t\treturn PublishFile(claim, append(raw, '\\n'), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n    86\t\t}\n    87\t\tif publish() == nil {\n    88\t\t\treturn nil\n    89\t\t}\n    90\t\theld, err := os.ReadFile(claim)\n    91\t\tif err != nil {\n    92\t\t\treturn fmt.Errorf(\"%w: the release claim %s cannot be read: %v\", ErrAttemptNotAbandoned, claim, err)\n    93\t\t}\n    94\t\tvar previous StartLockOwner\n    95\t\tif json.Unmarshal(held, &previous) != nil {\n    96\t\t\treturn fmt.Errorf(\"%w: the release claim %s is not one this engine reads\", ErrAttemptNotAbandoned, claim)\n    97\t\t}\n    98\t\tif liveness, detail := probeStartLockOwner(previous); liveness != LockOwnerDead {\n    99\t\t\treturn fmt.Errorf(\"%w: another release of it is in progress (%s)\", ErrAttemptNotAbandoned, detail)\n   100\t\t}\n   101\t\t// Taking over is a rename of the stale claim to a name of this process,\n   102\t\t// which only one taker can win, then an exclusive publish: two takers\n   103\t\t// never both enter the release (review round 4, N2).\n   104\t\tstale := fmt.Sprintf(\"%s.stale.%d.%d\", claim, os.Getpid(), now.UnixNano())\n   105\t\tif err := os.Rename(claim, stale); err != nil {\n   106\t\t\treturn fmt.Errorf(\"%w: another release took over the claim %s\", ErrAttemptNotAbandoned, claim)\n   107\t\t}\n   108\t\tif after, err := os.ReadFile(stale); err != nil || !bytes.Equal(after, held) {\n   109\t\t\treturn fmt.Errorf(\"%w: the claim %s changed while it was taken over\", ErrAttemptNotAbandoned, claim)\n   110\t\t}\n   111\t\tif err := publish(); err != nil {\n   112\t\t\treturn fmt.Errorf(\"%w: another release took over the claim %s\", ErrAttemptNotAbandoned, claim)\n   113\t\t}\n   114\t\t_ = os.Remove(stale)\n   115\t\treturn nil\n   116\t}\n   117\t\n   118\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n   119\t\tvar reserved *DelegatedReviewAttempt\n   120\t\tif marker != nil {\n   145\t\t\t\t\treserved = &orphans[i]\n   146\t\t\t\t}\n   147\t\t\t}\n   148\t\t\tif reserved == nil {\n   149\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   150\t\t\t}\n   151\t\t}\n   152\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   153\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   154\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   155\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   156\t\t}\n   157\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   158\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   159\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   160\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   161\t\tif marker != nil {\n   162\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   163\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   164\t\t} else {\n   165\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   166\t\t}\n   167\t\t// A release interrupted after recording the run completes with that run.\n   168\t\trecorded, found, err := s.recordedAbandonmentRun(*reserved)\n   169\t\tif err != nil {\n   170\t\t\treturn ReviewRun{}, err\n   171\t\t}\n   172\t\tif !found {\n   173\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   174\t\t\t\treturn ReviewRun{}, err\n   175\t\t\t}\n   176\t\t}\n   177\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   178\t\t\treturn recorded, err\n   179\t\t}\n   180\t\tif marker != nil {\n   181\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   182\t\t}\n   183\t\treturn recorded, nil\n   184\t}\n   185\t\n","exit_code":0,"status":"completed"}}
