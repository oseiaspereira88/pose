talledAt != \"\" {\n \t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n \t\t\t}\n+\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n+\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n+\t\t\t}\n \t\t\tif a.HookFailure != \"\" {\n \t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n \t\t\t}\n@@ -1105,9 +1110,9 @@ func cmdDelegateResume(root string, args []string, stdout, stderr io.Writer) int\n }\n \n func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n-\tf, problem := parseDelegateFlags(args)\n+\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n \tif problem != \"\" {\n-\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--dry-run] [--json]\")\n+\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n \t}\n \tstore := posemodel.Store{Root: root}\n \tattempts, lost, err := store.ListDelegationAttempts()\n@@ -1118,6 +1123,33 @@ func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int\n \tif err != nil {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n \t}\n+\tif !attempt.Active && !f.dryRun {\n+\t\t// An attempt whose dispatch, or whose earlier release, ended before\n+\t\t// its receipt is released with a failed run and its receipt, so it\n+\t\t// stops blocking the bundle; the release proves the abandonment\n+\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n+\t\t// review round 4, N1).\n+\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n+\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n+\t\t}\n+\t\tif err != nil {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n+\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n+\t\t}\n+\t\tif f.jsonOut {\n+\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n+\t\t\treturn 0\n+\t\t}\n+\t\tout := render(stdout, stderr)\n+\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n+\t\tif run.RunID == \"\" {\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n+\t\t} else {\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n+\t\t}\n+\t\treturn 0\n+\t}\n \tif !attempt.Active {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n \t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc 'git diff ddb770352f35f2f55c740e9a8479686de3a251e5..5cce293ea260c96e4661258aaa25c9d5c990f58c -- pose-mcp/internal/pose/review_dispatch.go'","aggregated_output":"diff --git a/pose-mcp/internal/pose/review_dispatch.go b/pose-mcp/internal/pose/review_dispatch.go\nindex 88a753fa..192679a2 100644\n--- a/pose-mcp/internal/pose/review_dispatch.go\n+++ b/pose-mcp/internal/pose/review_dispatch.go\n@@ -713,7 +713,7 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \tvar attempt DelegatedReviewAttempt\n \tif plan.predecessor == nil {\n \t\tvar err error\n-\t\tattempt, err = s.reserveDelegatedReviewAttempt(plan, now())\n+\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n \t\tif err != nil {\n \t\t\treturn ReviewRun{}, err\n \t\t}\n@@ -749,8 +749,9 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t// when the run was marked, at return otherwise (spec\n \t// pose-delegation-result-before-marker R1–R2).\n \tresultPublished := false\n+\treserved := plan.predecessor != nil\n \tpublishResult := func() {\n-\t\tif resultPublished || result.RunID == \"\" {\n+\t\tif resultPublished || result.RunID == \"\" || !reserved {\n \t\t\treturn\n \t\t}\n \t\tresultPublished = true\n@@ -768,8 +769,26 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \tdefer publishResult()\n \tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n \tif err != nil {\n+\t\tif plan.predecessor == nil {\n+\t\t\t// The attempt is reserved anyway, so the failed run and its\n+\t\t\t// receipt are recorded against it, as before the marker moved\n+\t\t\t// ahead of the reservation (spec\n+\t\t\t// pose-delegation-result-before-marker R1–R2).\n+\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n+\t\t\t\treturn ReviewRun{}, perr\n+\t\t\t}\n+\t\t\treserved = true\n+\t\t}\n \t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n \t}\n+\tif plan.predecessor == nil {\n+\t\tbeforeAttemptPublished(s, attempt)\n+\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n+\t\t\tstopActive()\n+\t\t\treturn ReviewRun{}, err\n+\t\t}\n+\t\treserved = true\n+\t}\n \t// The marker goes only once the record and the attempt result are\n \t// published: without them it is the one trace of the reserved attempt,\n \t// and a waiter that sees it gone must find the receipt.\n@@ -1002,6 +1021,7 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t// (found in review). The run gets its own process group, the whole group\n \t// is killed on timeout and after the run, and pipes are released at most\n \t// a few seconds after the kill.\n+\topaqueBaseline := reviewOpaqueProcessBaseline()\n \tisolateProcessGroup(cmd)\n \tcmd.WaitDelay = AdapterPipeGrace\n \tvar runErr error\n@@ -1016,6 +1036,20 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t\t}\n \t}\n \tterminationErr = killProcessGroup(cmd)\n+\t// A command the reviewer left running in a session of its own escapes the\n+\t// group kill; it is ended here, before the cleanup inventory reads the\n+\t// directories it may still write (spec\n+\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n+\treaped, opaque, reapErr := reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n+\tif reapErr != nil {\n+\t\tterminationErr = errors.Join(terminationErr, reapErr)\n+\t}\n+\tif len(reaped) > 0 && safety != nil {\n+\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n+\t}\n+\tif opaque > 0 && safety != nil {\n+\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n+\t}\n \tterminationFailed = terminationErr != nil\n \t// The adapter exited and a child it left still held the output when\n \t// WaitDelay expired: the run finished, its leftover is killed above, and\n@@ -1459,6 +1493,10 @@ func tail(s string, n int) string {\n \treturn s[len(s)-n:]\n }\n \n+// beforeAttemptPublished runs between the active marker and the reservation;\n+// tests use it to stop a dispatch there.\n+var beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {}\n+\n func (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\n \t// Identity covers only persisted content, never fields derived by a reader\n \t// or a previous write of a copied record.\n","exit_code":0,"status":"completed"}}
