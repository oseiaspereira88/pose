{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_reap_linux_test.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os/exec\"\n     7\t\t\"strings\"\n     8\t\t\"testing\"\n     9\t\t\"time\"\n    10\t)\n    11\t\n    12\t// Review round 1, N3: a pid that no longer names a process of the run, as\n    13\t// after reuse by an unrelated process, is never signalled.\n    14\tfunc TestAPidThatLostTheRunsEntryIsNotKilled(t *testing.T) {\n    15\t\tother := exec.Command(\"sleep\", \"30\")\n    16\t\tif err := other.Start(); err != nil {\n    17\t\t\tt.Fatal(err)\n    18\t\t}\n    19\t\tfor i := 0; i < 200 && reviewProcessName(other.Process.Pid) != \"sleep\"; i++ {\n    20\t\t\ttime.Sleep(10 * time.Millisecond)\n    21\t\t}\n    22\t\tt.Cleanup(func() { _ = other.Process.Kill(); _ = other.Wait() })\n    23\t\tentry := []byte(SealedCheckoutEnv + \"=/nonexistent/run-checkout\")\n    24\t\tif err := killPinnedMarkedProcess(other.Process.Pid, entry); err != nil {\n    25\t\t\tt.Fatal(err)\n    26\t\t}\n    27\t\ttime.Sleep(100 * time.Millisecond)\n    28\t\tif zombie, err := reviewProcessZombie(other.Process.Pid); err != nil || zombie {\n    29\t\t\tt.Fatalf(\"a process without the run's entry was killed: zombie=%t %v\", zombie, err)\n    30\t\t}\n    31\t\t// The same process carrying the entry is ended.\n    32\t\tmarked := exec.Command(\"sleep\", \"30\")\n    33\t\tmarked.Env = append(marked.Environ(), string(entry))\n    34\t\tif err := marked.Start(); err != nil {\n    35\t\t\tt.Fatal(err)\n    36\t\t}\n    37\t\t// Until exec, /proc shows the parent's environment.\n    38\t\tfor i := 0; i < 200; i++ {\n    39\t\t\tif ok, _ := reviewProcessMarked(marked.Process.Pid, entry); ok {\n    40\t\t\t\tbreak\n    41\t\t\t}\n    42\t\t\ttime.Sleep(10 * time.Millisecond)\n    43\t\t}\n    44\t\tif err := killPinnedMarkedProcess(marked.Process.Pid, entry); err != nil {\n    45\t\t\tt.Fatal(err)\n    46\t\t}\n    47\t\tif err := marked.Wait(); err == nil {\n    48\t\t\tt.Fatal(\"the marked process was not ended\")\n    49\t\t}\n    50\t}\n    51\t\n    52\t// opaqueProcess starts a process of this user whose environment cannot be\n    53\t// read (it makes itself non-dumpable), or skips without python3.\n    54\tfunc opaqueProcess(t *testing.T) *exec.Cmd {\n    55\t\tt.Helper()\n    56\t\tif _, err := exec.LookPath(\"python3\"); err != nil {\n    57\t\t\tt.Skip(\"python3 is not available\")\n    58\t\t}\n    59\t\tcmd := exec.Command(\"python3\", \"-c\", \"import ctypes,time; ctypes.CDLL(None).prctl(4,0,0,0,0); time.sleep(30)\")\n    60\t\tif err := cmd.Start(); err != nil {\n    61\t\t\tt.Fatal(err)\n    62\t\t}\n    63\t\tt.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })\n    64\t\tfor i := 0; i < 300; i++ {\n    65\t\t\tif _, err := reviewProcessMarked(cmd.Process.Pid, []byte(\"x\")); err != nil && !reviewProcessGoneErr(err) {\n    66\t\t\t\treturn cmd\n    67\t\t\t}\n    68\t\t\ttime.Sleep(10 * time.Millisecond)\n    69\t\t}\n    70\t\tt.Skip(\"the process never became non-inspectable\")\n    71\t\treturn nil\n    72\t}\n    73\t\n    74\t// Review round 2, N2: a non-inspectable process that existed before the run\n    75\t// is not the run's; one that started during it may be, and the scan fails\n    76\t// instead of reporting the run's processes ended.\n    77\tfunc TestANonInspectableProcessStartedDuringTheRunFailsTheScan(t *testing.T) {\n    78\t\tbefore := opaqueProcess(t)\n    79\t\tbaseline := reviewOpaqueProcessBaseline()\n    80\t\tif _, ok := baseline[before.Process.Pid]; !ok {\n    81\t\t\tt.Fatalf(\"the baseline misses process %d\", before.Process.Pid)\n    82\t\t}\n    83\t\tif _, opaque, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err != nil || opaque == 0 {\n    84\t\t\tt.Fatalf(\"a process that predates the run failed the scan or was not counted: %d %v\", opaque, err)\n    85\t\t}\n    86\t\tduring := opaqueProcess(t)\n    87\t\tif _, _, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err == nil || !strings.Contains(err.Error(), \"started during the run\") {\n    88\t\t\tt.Fatalf(\"process %d, started during the run, did not fail the scan: %v\", during.Process.Pid, err)\n    89\t\t}\n    90\t}\n","exit_code":0,"status":"completed"}}
