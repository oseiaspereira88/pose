out a marker or a run is\n+\t// listed too, so it can be named and released (review round 2, N1).\n+\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n+\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n+\t} else {\n+\t\tlost = append(lost, orphanLost...)\n+\t\tfor _, a := range orphans {\n+\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n+\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n+\t\t\torder = append(order, a.AttemptID)\n+\t\t}\n+\t}\n \tout := make([]DelegationAttempt, 0, len(order))\n \tfor _, key := range order {\n \t\tout = append(out, *byAttempt[key])\ndiff --git a/pose-mcp/internal/pose/review_attempt_ledger.go b/pose-mcp/internal/pose/review_attempt_ledger.go\nindex 31f33c6d..8cd9edb4 100644\n--- a/pose-mcp/internal/pose/review_attempt_ledger.go\n+++ b/pose-mcp/internal/pose/review_attempt_ledger.go\n@@ -354,7 +354,7 @@ func (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (\n \tbudget := reviewReadBudget(budgets)\n \tvar r reviewAttemptReceipt\n \tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n-\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly: %w\", a.AttemptID, err)\n+\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n \t}\n \tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n \t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n@@ -416,7 +416,10 @@ func (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttem\n \t}\n \treturn attempts, count, nil\n }\n-func (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n+\n+// prepareDelegatedReviewAttempt admits and builds the next reservation of\n+// the bundle without publishing it.\n+func (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n \tattempts, _, err := s.reviewAttemptAdmission(plan)\n \tif err != nil {\n \t\treturn DelegatedReviewAttempt{}, err\n@@ -427,11 +430,20 @@ func (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (D\n \t}\n \ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n \ta.AttemptID = attemptIdentity(a)\n+\treturn a, nil\n+}\n+\n+// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n+// marks the attempt active first, so a dispatch that ends after this point\n+// always leaves a marker that turns stalled and that `pose delegate cancel`\n+// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n+// review round 1, N1).\n+func (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n \trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n \tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n-\t\treturn DelegatedReviewAttempt{}, fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n+\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n \t}\n-\treturn a, nil\n+\treturn nil\n }\n func (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n \traw, _ := json.Marshal(run)\n@@ -862,3 +874,13 @@ func (s Store) delegatedReviewInsights(sinceDays int) *DelegatedReviewInsights {\n \tresult.ByAdapter = finish(adapters)\n \treturn result\n }\n+\n+// reserveDelegatedReviewAttempt prepares and publishes a reservation at once,\n+// for callers that hold no active marker.\n+func (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n+\ta, err := s.prepareDelegatedReviewAttempt(plan, at)\n+\tif err != nil {\n+\t\treturn DelegatedReviewAttempt{}, err\n+\t}\n+\treturn a, s.publishDelegatedReviewAttempt(a)\n+}\n","exit_code":0,"status":"completed"}}
