cess set. Cleanup has its own bounded context and never respawns the adapter.\n   617\tfunc (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPlan, now func() time.Time) (result ReviewRun, resultErr error) {\n   618\t\tif err := parent.Err(); err != nil {\n   619\t\t\treturn ReviewRun{}, err\n   620\t\t}\n   621\t\tif why := routingAgainstAnotherBundle(plan); why != \"\" {\n   622\t\t\treturn ReviewRun{}, errors.New(\"pose: \" + why)\n   623\t\t}\n   624\t\t// pose delegate cancel stops the run through this context (R13).\n   625\t\tparent, cancelRun := context.WithCancel(parent)\n524:func (s Store) PlanReviewDispatch(target, kind, notes, adapter string, reason ...string) (DispatchPlan, error) {\n","exit_code":0,"status":"completed"}}
