{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/usr/bin/bash -lc 'git diff ddb770352f35f2f55c740e9a8479686de3a251e5..5cce293ea260c96e4661258aaa25c9d5c990f58c -- pose-mcp/internal/pose/review_adapter_containment.go pose-mcp/internal/pose/review_adapter_containment_regression_test.go'","aggregated_output":"diff --git a/pose-mcp/internal/pose/review_adapter_containment.go b/pose-mcp/internal/pose/review_adapter_containment.go\nindex dccd15d5..788bc3ec 100644\n--- a/pose-mcp/internal/pose/review_adapter_containment.go\n+++ b/pose-mcp/internal/pose/review_adapter_containment.go\n@@ -131,6 +131,16 @@ func resolveReviewerContainment(a ReviewerAdapter) (*ReviewExecutionSafety, erro\n \tif runtime.GOOS == \"linux\" {\n \t\tif err := reviewProcessGroupAvailable(); err == nil {\n \t\t\tr.Capabilities[\"process-group-termination\"] = \"available\"\n+\t\t\t// A descendant that left the group is still ended while its\n+\t\t\t// environment keeps the run's sealed-checkout entry; one that\n+\t\t\t// clears it is not, so the guarantee is not \"available\" (spec\n+\t\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, L1).\n+\t\t\tr.Capabilities[\"escaped-descendant-termination\"] = \"environment-marked\"\n+\t\t\tfor i, limit := range r.Limitations {\n+\t\t\t\tif limit == \"no memory/CPU quota or control of descendants escaping the process group\" {\n+\t\t\t\t\tr.Limitations[i] = \"no memory/CPU quota; descendants escaping the process group are ended only while they keep the run's sealed-checkout environment entry\"\n+\t\t\t\t}\n+\t\t\t}\n \t\t} else {\n \t\t\tr.Capabilities[\"process-group-termination\"] = \"unavailable\"\n \t\t\tr.Limitations = append(r.Limitations, \"process inventory not observable on this host\")\ndiff --git a/pose-mcp/internal/pose/review_adapter_containment_regression_test.go b/pose-mcp/internal/pose/review_adapter_containment_regression_test.go\nindex b2223b75..caefb8a1 100644\n--- a/pose-mcp/internal/pose/review_adapter_containment_regression_test.go\n+++ b/pose-mcp/internal/pose/review_adapter_containment_regression_test.go\n@@ -294,7 +294,10 @@ func TestAdapterContainmentFailedCleanupContinuationRemainsFailed(t *testing.T)\n \t}\n }\n \n-func TestAdapterContainmentEscapedFiniteChildIsDisclosedNotContained(t *testing.T) {\n+// A child that escaped the process group but keeps the run's environment is\n+// ended with the run, and the guarantee is disclosed as environment-marked,\n+// never as available (spec pose-review-run-reaps-lingering-reviewer-processes).\n+func TestAdapterContainmentEscapedChildIsEndedWhileEnvironmentMarked(t *testing.T) {\n \tif runtime.GOOS != \"linux\" {\n \t\tt.Skip(\"Linux setsid limitation fixture\")\n \t}\n@@ -310,8 +313,8 @@ func TestAdapterContainmentEscapedFiniteChildIsDisclosedNotContained(t *testing.\n \t\ta.Containment = containmentPolicy()\n \t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid sh -c 'printf ready > \"$3\"; n=0; while test \"$n\" -lt 200; do if test -e \"$1\"; then printf escaped > \"$2\"; exit 0; fi; n=$((n+1)); sleep 0.01; done' sh \"$1\" \"$2\" \"$3\" >/dev/null 2>&1 & n=0; while ! test -e \"$3\"; do n=$((n+1)); test \"$n\" -lt 100 || exit 2; sleep 0.01; done; printf 'decision: approved\\n'`, \"sh\", trigger, escaped, ready}\n \t})\n-\tif f.run.Status != ReviewRunCompleted || f.run.Safety.Capabilities[\"escaped-descendant-termination\"] != \"unavailable\" {\n-\t\tt.Fatal(\"escaped process was claimed contained\", f.run.Failure, f.run.Safety)\n+\tif f.run.Status != ReviewRunCompleted || f.run.Safety.Capabilities[\"escaped-descendant-termination\"] != \"environment-marked\" {\n+\t\tt.Fatal(\"escaped-process termination was not disclosed as environment-marked\", f.run.Failure, f.run.Safety)\n \t}\n \tif _, err := os.Stat(escaped); !os.IsNotExist(err) {\n \t\tt.Fatal(\"escape fixture ran before dispatch returned\", err)\n@@ -319,14 +322,10 @@ func TestAdapterContainmentEscapedFiniteChildIsDisclosedNotContained(t *testing.\n \tif err := os.WriteFile(trigger, []byte(\"release finite child\"), 0600); err != nil {\n \t\tt.Fatal(err)\n \t}\n-\tdeadline := time.Now().Add(time.Second)\n-\tfor time.Now().Before(deadline) {\n-\t\tif raw, err := os.ReadFile(escaped); err == nil && string(raw) == \"escaped\" {\n-\t\t\treturn\n-\t\t}\n-\t\ttime.Sleep(10 * time.Millisecond)\n+\ttime.Sleep(500 * time.Millisecond)\n+\tif _, err := os.Stat(escaped); !os.IsNotExist(err) {\n+\t\tt.Fatal(\"the escaped child outlived the run\", err)\n \t}\n-\tt.Fatal(\"escape fixture did not exercise the disclosed limitation\")\n }\n \n // Spec pose-review-cleanup-removes-go-build-leftovers: the Go build directory\n","exit_code":0,"status":"completed"}}
