{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/cli/review_reap_test.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage cli\n     4\t\n     5\timport (\n     6\t\t\"os\"\n     7\t\t\"os/exec\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strconv\"\n    10\t\t\"strings\"\n    11\t\t\"syscall\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t\n    15\t\t\"github.com/harne8/pose-mcp/internal/pose\"\n    16\t)\n    17\t\n    18\t// Spec pose-review-run-reaps-lingering-reviewer-processes R1, R2, R4: a\n    19\t// reviewer that ends while a command it started in a session of its own is\n    20\t// still running leaves a run that completes, with that command ended before\n    21\t// the cleanup and named in the run record.\n    22\tfunc TestDispatchEndsWhatTheReviewerLeftRunning(t *testing.T) {\n    23\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n    24\t\t\tt.Skip(\"setsid is not available\")\n    25\t\t}\n    26\t\troot := dispatchInstance(t)\n    27\t\tpidFile := filepath.Join(t.TempDir(), \"leftover.pid\")\n    28\t\tscript := `cat >/dev/null; setsid sh -c 'echo $$ > \"` + pidFile + `\"; while :; do touch \"$TMPDIR/leftover\" 2>/dev/null; sleep 0.05; done' </dev/null >/dev/null 2>&1 & ` +\n    29\t\t\t`i=0; while [ ! -s \"` + pidFile + `\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`\n    30\t\twriteReviewers(t, root, map[string]pose.ReviewerAdapter{\"fake\": {Command: []string{\"sh\", \"-c\", script}, Vendor: \"fixture\", Model: \"fixture\", Containment: &pose.ReviewerContainment{SchemaVersion: 1, Profile: \"trusted-process\"}}})\n    31\t\tcode, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\")\n    32\t\traw, err := os.ReadFile(pidFile)\n    33\t\tif err != nil {\n    34\t\t\tt.Fatalf(\"the leftover never started: %v (%d %s)\", err, code, out)\n    35\t\t}\n    36\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n    37\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n    38\t\tdeadline := time.Now().Add(2 * time.Second)\n    39\t\tfor syscall.Kill(pid, 0) == nil && time.Now().Before(deadline) {\n    40\t\t\tif stat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\"); err == nil && strings.Contains(string(stat), \") Z \") {\n    41\t\t\t\tbreak\n    42\t\t\t}\n    43\t\t\ttime.Sleep(50 * time.Millisecond)\n    44\t\t}\n    45\t\tif stat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\"); err == nil && !strings.Contains(string(stat), \") Z \") {\n    46\t\t\tt.Fatalf(\"the process the reviewer left running survived the run: %s\", stat)\n    47\t\t}\n    48\t\truns, _, _ := (pose.Store{Root: root}).ReadReviewRuns(\"\")\n    49\t\tif len(runs) != 1 {\n    50\t\t\tt.Fatalf(\"runs: %d (%d %s)\", len(runs), code, out)\n    51\t\t}\n    52\t\trun := runs[0]\n    53\t\tif run.Status != pose.ReviewRunCompleted || run.Safety == nil || run.Safety.Operation.Outcome != pose.OutcomeCompleted {\n    54\t\t\tt.Fatalf(\"the run did not complete with its cleanup: status=%s failure=%s safety=%+v\", run.Status, run.Failure, run.Safety)\n    55\t\t}\n    56\t\tif !strings.Contains(strings.Join(run.Safety.Limitations, \"\\n\"), \"process(es) the run left running\") {\n    57\t\t\tt.Fatalf(\"the run record does not name the ended process: %v\", run.Safety.Limitations)\n    58\t\t}\n    59\t}\n","exit_code":0,"status":"completed"}}
