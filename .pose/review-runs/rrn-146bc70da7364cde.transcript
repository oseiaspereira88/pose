{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '690,850p;995,1095p'\"","aggregated_output":"   690\t\t\t}\n   691\t\t}()\n   692\t\ttranscript := []byte{}\n   693\t\tfinish := func(status, failure string) (ReviewRun, error) {\n   694\t\t\tdoCleanup()\n   695\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n   696\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n   697\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n   698\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n   699\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n   700\t\t\t}\n   701\t\t\trun.sessionForRedaction = \"\"\n   702\t\t\trun.Status, run.Failure = status, failure\n   703\t\t\tif status != ReviewRunInterrupted {\n   704\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n   705\t\t\t}\n   706\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n   707\t\t\treturn s.recordReviewRun(run, transcript)\n   708\t\t}\n   709\t\t// Recompute semantic freshness at execution time, not just preview time.\n   710\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n   711\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   712\t\t}\n   713\t\tvar attempt DelegatedReviewAttempt\n   714\t\tif plan.predecessor == nil {\n   715\t\t\tvar err error\n   716\t\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n   717\t\t\tif err != nil {\n   718\t\t\t\treturn ReviewRun{}, err\n   719\t\t\t}\n   720\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n   721\t\t} else {\n   722\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n   723\t\t\tfresh, err := s.replanContinuation(plan)\n   724\t\t\tif err != nil {\n   725\t\t\t\treturn ReviewRun{}, err\n   726\t\t\t}\n   727\t\t\tif fresh.PendingContinuation != nil {\n   728\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n   729\t\t\t}\n   730\t\t\tif fresh.Existing != nil {\n   731\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   732\t\t\t}\n   733\t\t\tplan = fresh\n   734\t\t\trun.Provenance = fresh.provenance\n   735\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n   736\t\t\tif fresh.handoff {\n   737\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n   738\t\t\t} else {\n   739\t\t\t\trun.Resumes = fresh.predecessor.RunID\n   740\t\t\t}\n   741\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n   742\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n   743\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n   744\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n   745\t\t\t\treturn ReviewRun{}, err\n   746\t\t\t}\n   747\t\t}\n   748\t\t// The attempt result is published once: before the active marker goes\n   749\t\t// when the run was marked, at return otherwise (spec\n   750\t\t// pose-delegation-result-before-marker R1–R2).\n   751\t\tresultPublished := false\n   752\t\treserved := plan.predecessor != nil\n   753\t\tpublishResult := func() {\n   754\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n   755\t\t\t\treturn\n   756\t\t\t}\n   757\t\t\tresultPublished = true\n   758\t\t\tbeforeRunResultPublished(result)\n   759\t\t\tvar err error\n   760\t\t\tif plan.predecessor == nil {\n   761\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   762\t\t\t} else {\n   763\t\t\t\terr = s.finishReviewContinuation(result)\n   764\t\t\t}\n   765\t\t\tif err != nil {\n   766\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n   767\t\t\t}\n   768\t\t}\n   769\t\tdefer publishResult()\n   770\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n   771\t\tif err != nil {\n   772\t\t\tif plan.predecessor == nil {\n   773\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n   774\t\t\t\t// receipt are recorded against it, as before the marker moved\n   775\t\t\t\t// ahead of the reservation (spec\n   776\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n   777\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n   778\t\t\t\t\treturn ReviewRun{}, perr\n   779\t\t\t\t}\n   780\t\t\t\treserved = true\n   781\t\t\t}\n   782\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   783\t\t}\n   784\t\tif plan.predecessor == nil {\n   785\t\t\tbeforeAttemptPublished(s, attempt)\n   786\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n   787\t\t\t\tstopActive()\n   788\t\t\t\treturn ReviewRun{}, err\n   789\t\t\t}\n   790\t\t\treserved = true\n   791\t\t}\n   792\t\t// The marker goes only once the record and the attempt result are\n   793\t\t// published: without them it is the one trace of the reserved attempt,\n   794\t\t// and a waiter that sees it gone must find the receipt.\n   795\t\tdefer func() {\n   796\t\t\tpublishResult()\n   797\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n   798\t\t}()\n   799\t\tcancelled = cancelFlag\n   800\t\t// A detached run that cannot hand its attempt back stops here: nobody\n   801\t\t// would know which attempt runs (R1).\n   802\t\tif plan.OnStart != nil {\n   803\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n   804\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n   805\t\t\t}\n   806\t\t}\n   807\t\ttmp, err := os.MkdirTemp(\"\", \"pose-review-run-*\")\n   808\t\tif err != nil {\n   809\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n   810\t\t}\n   811\t\tsafety.RuntimeID = filepath.Base(tmp)\n   812\t\towned, err := os.Lstat(tmp)\n   813\t\tif err != nil {\n   814\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n   815\t\t}\n   816\t\truntimeRoot, err := os.OpenRoot(tmp)\n   817\t\tif err != nil {\n   818\t\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n   819\t\t}\n   820\t\tdefer runtimeRoot.Close()\n   821\t\tvar worktreeOwned os.FileInfo\n   822\t\tvar gitMarker []byte\n   823\t\tvar ownership *reviewCleanupOwnership\n   824\t\tworktree := filepath.Join(tmp, \"worktree\")\n   825\t\tcleanup = func() error {\n   826\t\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n   827\t\t}\n   828\t\thooks := filepath.Join(tmp, \"empty-hooks\")\n   829\t\tif err := os.Mkdir(hooks, 0700); err != nil {\n   830\t\t\treturn finish(ReviewRunFailed, \"private hook directory setup failed\")\n   831\t\t}\n   832\t\tsetupCtx, stopSetup := context.WithTimeout(parent, 2*time.Minute)\n   833\t\tdefer stopSetup()\n   834\t\tsetup := reviewSetupCommand(setupCtx, gitCommand(\"-C\", s.Root, \"-c\", \"core.hooksPath=\"+hooks, \"worktree\", \"add\", \"--detach\", worktree, plan.SealedCommit))\n   835\t\tsetupOutput := &reviewBoundedCapture{limit: 64 << 10, cancel: stopSetup}\n   836\t\tsetup.Stdout, setup.Stderr = setupOutput, setupOutput\n   837\t\tsetupErr := setup.Run()\n   838\t\t_, setupOverflow := setupOutput.result()\n   839\t\tterminationErr := killProcessGroup(setup)\n   840\t\tif terminationErr != nil {\n   841\t\t\tterminationFailed = true\n   842\t\t}\n   843\t\tsetupCause := executionCause(setupCtx)\n   844\t\tif setupErr != nil || terminationErr != nil || setupOverflow {\n   845\t\t\tsafety.ExecutionCause = setupCause\n   846\t\t\tif setupOverflow {\n   847\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   848\t\t\t}\n   849\t\t\treturn finish(ReviewRunFailed, \"review worktree setup failed or termination incomplete\")\n   850\t\t}\n   995\t\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n   996\t\t\t\t\t// engine that dispatched the run is the one that checks it.\n   997\t\t\t\t\tif self, err := os.Executable(); err == nil {\n   998\t\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n   999\t\t\t\t\t}\n  1000\t\t\t\t}\n  1001\t\t\t}\n  1002\t\t}\n  1003\t\tcmd.Env = env\n  1004\t\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n  1005\t\tcmd.Stdout, cmd.Stderr = combined, combined\n  1006\t\t// pose delegate watch follows the normalized, redacted events as they come\n  1007\t\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n  1008\t\t// the record is published.\n  1009\t\tsessionPattern := \"\"\n  1010\t\tif plan.Config.Session != nil {\n  1011\t\t\tsessionPattern = plan.Config.Session.Pattern\n  1012\t\t}\n  1013\t\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n  1014\t\t\ttee := io.MultiWriter(combined, live)\n  1015\t\t\tcmd.Stdout, cmd.Stderr = tee, tee\n  1016\t\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n  1017\t\t\tdefer live.Close()\n  1018\t\t}\n  1019\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n  1020\t\t// only the parent left a child holding stdout, so the timeout never fired\n  1021\t\t// (found in review). The run gets its own process group, the whole group\n  1022\t\t// is killed on timeout and after the run, and pipes are released at most\n  1023\t\t// a few seconds after the kill.\n  1024\t\topaqueBaseline := reviewOpaqueProcessBaseline()\n  1025\t\tisolateProcessGroup(cmd)\n  1026\t\tcmd.WaitDelay = AdapterPipeGrace\n  1027\t\tvar runErr error\n  1028\t\tif run.Provenance == nil {\n  1029\t\t\trunErr = cmd.Run()\n  1030\t\t} else {\n  1031\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1032\t\t\trunErr = err\n  1033\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1034\t\t\tif started {\n  1035\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1036\t\t\t}\n  1037\t\t}\n  1038\t\tterminationErr = killProcessGroup(cmd)\n  1039\t\t// A command the reviewer left running in a session of its own escapes the\n  1040\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1041\t\t// directories it may still write (spec\n  1042\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1043\t\treaped, opaque, reapErr := reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n  1044\t\tif reapErr != nil {\n  1045\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1046\t\t}\n  1047\t\tif len(reaped) > 0 && safety != nil {\n  1048\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n  1049\t\t}\n  1050\t\tif opaque > 0 && safety != nil {\n  1051\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1052\t\t}\n  1053\t\tterminationFailed = terminationErr != nil\n  1054\t\t// The adapter exited and a child it left still held the output when\n  1055\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1056\t\t// the exit status decides (found in review).\n  1057\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1058\t\t\trunErr = nil\n  1059\t\t}\n  1060\t\ttranscript, overflow := combined.result()\n  1061\t\tsafety.CaptureComplete = !overflow\n  1062\t\tif cmd.ProcessState != nil {\n  1063\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1064\t\t}\n  1065\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n  1066\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n  1067\t\t\tsafety.CaptureComplete = false\n  1068\t\t}\n  1069\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1070\t\t\trun.Output = string(raw)\n  1071\t\t\tif run.Provenance != nil {\n  1072\t\t\t\trun.Provenance.OutputComplete = true\n  1073\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1074\t\t\t}\n  1075\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1076\t\t\t// The agent writes no output file; its stream names its final message.\n  1077\t\t\trun.Output = final\n  1078\t\t\tif run.Provenance != nil {\n  1079\t\t\t\trun.Provenance.OutputComplete = true\n  1080\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1081\t\t\t}\n  1082\t\t} else {\n  1083\t\t\trun.Output = tail(string(transcript), 20000)\n  1084\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1085\t\t\t\tsafety.CaptureComplete = false\n  1086\t\t\t}\n  1087\t\t\tif run.Provenance != nil {\n  1088\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1089\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1090\t\t\t}\n  1091\t\t}\n  1092\t\tif run.Provenance != nil {\n  1093\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n  1094\t\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n  1095\t\t}\n","exit_code":0,"status":"completed"}}
