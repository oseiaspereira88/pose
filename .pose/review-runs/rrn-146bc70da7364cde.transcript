{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/delegation_release.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under an exclusive claim that records its owner; a claim\n    19\t// whose owner is gone is taken over, and a release interrupted after it\n    20\t// recorded the run completes it instead of recording another (N1).\n    21\t\n    22\timport (\n    23\t\t\"bytes\"\n    24\t\t\"encoding/json\"\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"os\"\n    28\t\t\"path/filepath\"\n    29\t\t\"strings\"\n    30\t\t\"time\"\n    31\t)\n    32\t\n    33\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    34\t// proven abandoned.\n    35\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    36\t\n    37\t// reviewOrphanReservationAge is how old a reservation without any marker\n    38\t// must be to count as abandoned.\n    39\tconst reviewOrphanReservationAge = 10 * time.Minute\n    40\t\n    41\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    42\t// dispatch ended before recording it, and removes its stalled marker. A\n    43\t// stalled marker whose reservation was never published is only removed; the\n    44\t// returned run is then empty.\n    45\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    46\t\tif !validAttemptFileName(attemptID) {\n    47\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    48\t\t}\n    49\t\tmarkers, _, err := s.ListDelegationActive()\n    50\t\tif err != nil {\n    51\t\t\treturn ReviewRun{}, err\n    52\t\t}\n    53\t\tvar marker *DelegationActiveRun\n    54\t\tfor i := range markers {\n    55\t\t\tif markers[i].AttemptID == attemptID {\n    56\t\t\t\tmarker = &markers[i]\n    57\t\t\t}\n    58\t\t}\n    59\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    60\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    61\t\t}\n    62\t\tdir, err := s.delegationActiveDir(true)\n    63\t\tif err != nil {\n    64\t\t\treturn ReviewRun{}, err\n    65\t\t}\n    66\t\tclaim := filepath.Join(dir, attemptID+\".release\")\n    67\t\tif err := claimAttemptRelease(claim, now); err != nil {\n    68\t\t\treturn ReviewRun{}, err\n    69\t\t}\n    70\t\trun, err := s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    71\t\tif rerr := os.Remove(claim); rerr != nil && !errors.Is(rerr, os.ErrNotExist) && err == nil {\n    72\t\t\terr = rerr\n    73\t\t}\n    74\t\treturn run, err\n    75\t}\n    76\t\n    77\t// claimAttemptRelease publishes the release claim with its owner. A claim\n    78\t// whose owner is proven gone is an interrupted release and is taken over.\n    79\tfunc claimAttemptRelease(claim string, now time.Time) error {\n    80\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"release:\" + filepath.Base(claim), Operation: \"pose delegate cancel\", PID: os.Getpid(), AcquiredAt: now.UTC().Format(time.RFC3339Nano)}\n    81\t\towner.Host, _ = os.Hostname()\n    82\t\tidentifyStartLockProcess(&owner)\n    83\t\traw, _ := json.Marshal(owner)\n    84\t\tpublish := func() error {\n    85\t\t\treturn PublishFile(claim, append(raw, '\\n'), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n    86\t\t}\n    87\t\tif publish() == nil {\n    88\t\t\treturn nil\n    89\t\t}\n    90\t\theld, err := os.ReadFile(claim)\n    91\t\tif err != nil {\n    92\t\t\treturn fmt.Errorf(\"%w: the release claim %s cannot be read: %v\", ErrAttemptNotAbandoned, claim, err)\n    93\t\t}\n    94\t\tvar previous StartLockOwner\n    95\t\tif json.Unmarshal(held, &previous) != nil {\n    96\t\t\treturn fmt.Errorf(\"%w: the release claim %s is not one this engine reads\", ErrAttemptNotAbandoned, claim)\n    97\t\t}\n    98\t\tif liveness, detail := probeStartLockOwner(previous); liveness != LockOwnerDead {\n    99\t\t\treturn fmt.Errorf(\"%w: another release of it is in progress (%s)\", ErrAttemptNotAbandoned, detail)\n   100\t\t}\n   101\t\t// Taking over is a rename of the stale claim to a name of this process,\n   102\t\t// which only one taker can win, then an exclusive publish: two takers\n   103\t\t// never both enter the release (review round 4, N2).\n   104\t\tstale := fmt.Sprintf(\"%s.stale.%d.%d\", claim, os.Getpid(), now.UnixNano())\n   105\t\tif err := os.Rename(claim, stale); err != nil {\n   106\t\t\treturn fmt.Errorf(\"%w: another release took over the claim %s\", ErrAttemptNotAbandoned, claim)\n   107\t\t}\n   108\t\tif after, err := os.ReadFile(stale); err != nil || !bytes.Equal(after, held) {\n   109\t\t\treturn fmt.Errorf(\"%w: the claim %s changed while it was taken over\", ErrAttemptNotAbandoned, claim)\n   110\t\t}\n   111\t\tif err := publish(); err != nil {\n   112\t\t\treturn fmt.Errorf(\"%w: another release took over the claim %s\", ErrAttemptNotAbandoned, claim)\n   113\t\t}\n   114\t\t_ = os.Remove(stale)\n   115\t\treturn nil\n   116\t}\n   117\t\n   118\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n   119\t\tvar reserved *DelegatedReviewAttempt\n   120\t\tif marker != nil {\n   121\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n   122\t\t\tif err != nil {\n   123\t\t\t\treturn ReviewRun{}, err\n   124\t\t\t}\n   125\t\t\tfor i := range attempts {\n   126\t\t\t\tif attempts[i].AttemptID == attemptID {\n   127\t\t\t\t\treserved = &attempts[i]\n   128\t\t\t\t}\n   129\t\t\t}\n   130\t\t\tif reserved == nil {\n   131\t\t\t\t// The dispatch ended between its marker and its reservation:\n   132\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n   133\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n   134\t\t\t}\n   135\t\t} else {\n   136\t\t\tif !operatorConfirmed {\n   137\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n   138\t\t\t}\n   139\t\t\torphans, _, err := s.orphanReservations(now)\n   140\t\t\tif err != nil {\n   141\t\t\t\treturn ReviewRun{}, err\n   142\t\t\t}\n   143\t\t\tfor i := range orphans {\n   144\t\t\t\tif orphans[i].AttemptID == attemptID {\n   145\t\t\t\t\treserved = &orphans[i]\n   146\t\t\t\t}\n   147\t\t\t}\n   148\t\t\tif reserved == nil {\n   149\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   150\t\t\t}\n   151\t\t}\n   152\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   153\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   154\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   155\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   156\t\t}\n   157\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   158\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   159\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   160\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   161\t\tif marker != nil {\n   162\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   163\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   164\t\t} else {\n   165\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   166\t\t}\n   167\t\t// A release interrupted after recording the run completes with that run.\n   168\t\trecorded, found, err := s.recordedAbandonmentRun(*reserved)\n   169\t\tif err != nil {\n   170\t\t\treturn ReviewRun{}, err\n   171\t\t}\n   172\t\tif !found {\n   173\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   174\t\t\t\treturn ReviewRun{}, err\n   175\t\t\t}\n   176\t\t}\n   177\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   178\t\t\treturn recorded, err\n   179\t\t}\n   180\t\tif marker != nil {\n   181\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   182\t\t}\n   183\t\treturn recorded, nil\n   184\t}\n   185\t\n   186\t// recordedAbandonmentRun finds the failed run an interrupted release of a\n   187\t// recorded for it.\n   188\tfunc (s Store) recordedAbandonmentRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   189\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   190\t\tif err != nil {\n   191\t\t\treturn ReviewRun{}, false, err\n   192\t\t}\n   193\t\tif len(lost) > 0 {\n   194\t\t\t// An unreadable run may be this release's: the history is unknown,\n   195\t\t\t// and the release does not write another (review round 4, N3).\n   196\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   197\t\t}\n   198\t\tfor _, r := range runs {\n   199\t\t\tif r.AttemptID == a.AttemptID && r.Status == ReviewRunFailed && strings.HasPrefix(r.Failure, DelegationAbandonedCause) {\n   200\t\t\t\treturn r, true, nil\n   201\t\t\t}\n   202\t\t}\n   203\t\treturn ReviewRun{}, false, nil\n   204\t}\n   205\t\n   206\t// orphanReservations lists the reservations an earlier engine left without\n   207\t// a receipt, a marker or a run, older than reviewOrphanReservationAge, and\n   208\t// says which reservations or receipts it could not read (review round 3, N3).\n   209\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   210\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   211\t\tdirs, err := os.ReadDir(base)\n   212\t\tif errors.Is(err, os.ErrNotExist) {\n   213\t\t\treturn nil, nil, nil\n   214\t\t}\n   215\t\tif err != nil {\n   216\t\t\treturn nil, nil, err\n   217\t\t}\n   218\t\tmarkers, _, err := s.ListDelegationActive()\n   219\t\tif err != nil {\n   220\t\t\treturn nil, nil, err\n   221\t\t}\n   222\t\tmarked := map[string]bool{}\n   223\t\tfor _, m := range markers {\n   224\t\t\tmarked[m.AttemptID] = true\n   225\t\t}\n   226\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   227\t\tif err != nil {\n   228\t\t\treturn nil, nil, err\n   229\t\t}\n   230\t\tif len(runLost) > 0 {\n   231\t\t\t// Without the whole run history nothing is known to have no run.\n   232\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   233\t\t}\n   234\t\tran := map[string]bool{}\n   235\t\tfor _, r := range runs {\n   236\t\t\t// The run an interrupted release recorded leaves the reservation\n   237\t\t\t// abandoned until its receipt is written (review round 4, N1).\n   238\t\t\tif r.Status == ReviewRunFailed && strings.HasPrefix(r.Failure, DelegationAbandonedCause) {\n   239\t\t\t\tcontinue\n   240\t\t\t}\n   241\t\t\tran[r.AttemptID] = true\n   242\t\t}\n   243\t\tvar out []DelegatedReviewAttempt\n   244\t\tvar lost []string\n   245\t\tbudget := reviewReadBudget(nil)\n   246\t\tfor _, d := range dirs {\n   247\t\t\tif !d.IsDir() {\n   248\t\t\t\tcontinue\n   249\t\t\t}\n   250\t\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n   251\t\t\tif err != nil {\n   252\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   253\t\t\t\tcontinue\n   254\t\t\t}\n   255\t\t\tfor _, e := range entries {\n   256\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   257\t\t\t\t\tcontinue\n   258\t\t\t\t}\n   259\t\t\t\tvar a DelegatedReviewAttempt\n   260\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   261\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   262\t\t\t\t\tcontinue\n   263\t\t\t\t}\n   264\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   265\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   266\t\t\t\t\tcontinue\n   267\t\t\t\t}\n   268\t\t\t\tif marked[a.AttemptID] || ran[a.AttemptID] {\n   269\t\t\t\t\tcontinue\n   270\t\t\t\t}\n   271\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   272\t\t\t\t\tcontinue\n   273\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   274\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   275\t\t\t\t\tcontinue\n   276\t\t\t\t}\n   277\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   278\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   279\t\t\t\t\tcontinue\n   280\t\t\t\t}\n   281\t\t\t\tout = append(out, a)\n   282\t\t\t}\n   283\t\t}\n   284\t\treturn out, lost, nil\n   285\t}\n   286\t\n   287\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   288\t\tdir, err := s.delegationActiveDir(false)\n   289\t\tif err != nil {\n   290\t\t\treturn err\n   291\t\t}\n   292\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   293\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   294\t\t\t\treturn err\n   295\t\t\t}\n   296\t\t}\n   297\t\treturn nil\n   298\t}\n","exit_code":0,"status":"completed"}}
