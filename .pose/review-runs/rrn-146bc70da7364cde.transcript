{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n -C 5 'Test(AnInterruptedRelease|AStaleClaim|AnAbandonedAttempt|AnIncompleteRunHistory|Receipt|Release)' pose-mcp/internal/pose/delegation_release_test.go\"","aggregated_output":"16-\n17-// Spec pose-review-run-reaps-lingering-reviewer-processes R5, R6: a dispatch\n18-// that ended between its reservation and its run record leaves an attempt\n19-// that blocks the bundle; once its owner is proven gone, cancel releases it\n20-// with a failed run and its receipt, and the ledger reads again.\n21:func TestAnAbandonedAttemptIsReleasedWithARecord(t *testing.T) {\n22-\troot := t.TempDir()\n23-\ts := Store{Root: root}\n24-\tbundle := \"rvb-00000000000000a1\"\n25-\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n26-\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"0\", 32)}\n--\n258-\t}\n259-}\n260-\n261-// Review round 3, N1: a release interrupted after it recorded the run, and\n262-// before the receipt, completes with that run instead of recording another.\n263:func TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n264-\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n265-\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n266-\tif err != nil {\n267-\t\tt.Fatal(err)\n268-\t}\n--\n374-\t\tt.Fatalf(\"an unreadable reservation was skipped silently: %v %v\", lost, err)\n375-\t}\n376-}\n377-\n378-// Review round 4, N2: two takers of one stale claim never both win.\n379:func TestAStaleClaimHasOneTaker(t *testing.T) {\n380-\tdir := t.TempDir()\n381-\tclaim := filepath.Join(dir, \"rat-x.release\")\n382-\tdead := exec.Command(\"true\")\n383-\tif err := dead.Run(); err != nil {\n384-\t\tt.Fatal(err)\n--\n411-\t}\n412-}\n413-\n414-// Review round 4, N3: with the run history incomplete, no reservation is\n415-// taken as runless, and the loss is reported.\n416:func TestAnIncompleteRunHistoryRulesNothingOut(t *testing.T) {\n417-\troot := t.TempDir()\n418-\ts := Store{Root: root}\n419-\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000c1\", BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n420-\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"3\", 32)}\n421-\ta.AttemptID = attemptIdentity(a)\n","exit_code":0,"status":"completed"}}
