ado de review\"},\n \t\t},\n \t\tExamples: []string{\ndiff --git a/pose-mcp/internal/pose/delegation_list.go b/pose-mcp/internal/pose/delegation_list.go\nindex 94358115..16545c02 100644\n--- a/pose-mcp/internal/pose/delegation_list.go\n+++ b/pose-mcp/internal/pose/delegation_list.go\n@@ -63,6 +63,9 @@ func (a DelegationAttempt) Latest() *ReviewRun { return a.latest }\n const (\n \tDelegationRunning = \"running\"\n \tDelegationStalled = \"stalled\"\n+\t// DelegationAbandonedCause is the failure of a stalled attempt whose\n+\t// dispatch ended before recording its run.\n+\tDelegationAbandonedCause = \"abandoned: the dispatching process ended before the run was recorded\"\n )\n \n // ListDelegationAttempts groups every recorded run by attempt, adds the runs\n@@ -167,6 +170,12 @@ func (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n \t\t}\n \t\tif marker.StalledAt != \"\" {\n \t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n+\t\t\tif row.LatestRun == \"\" {\n+\t\t\t\t// The dispatch ended before recording its run: the cause and\n+\t\t\t\t// the release are said, not left to inspection (review round\n+\t\t\t\t// 1, N2).\n+\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n+\t\t\t}\n \t\t}\n \t\t// A running run's progress comes from its live events (R12).\n \t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n@@ -178,6 +187,21 @@ func (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n \t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n \t\t}\n \t}\n+\t// A reservation an earlier engine left without a marker or a run is\n+\t// listed too, so it can be named and released (review round 2, N1).\n+\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n+\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n+\t} else {\n+\t\tlost = append(lost, orphanLost...)\n+\t\tfor _, a := range orphans {\n+\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n+\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n+\t\t\torder = append(order, a.AttemptID)\n+\t\t}\n+\t}\n \tout := make([]DelegationAttempt, 0, len(order))\n \tfor _, key := range order {\n \t\tout = append(out, *byAttempt[key])\ndiff --git a/pose-mcp/internal/pose/review_attempt_ledger.go b/pose-mcp/internal/pose/review_attempt_ledger.go\nindex 31f33c6d..8cd9edb4 100644\n--- a/pose-mcp/internal/pose/review_attempt_ledger.go\n+++ b/pose-mcp/internal/pose/review_attempt_ledger.go\n@@ -354,7 +354,7 @@ func (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (\n \tbudget := reviewReadBudget(budgets)\n \tvar r reviewAttemptReceipt\n \tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n-\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly: %w\", a.AttemptID, err)\n+\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n \t}\n \tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n \t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n@@ -416,7 +416,10 @@ func (s Store) reviewAttemptAdm