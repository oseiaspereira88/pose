// pose-delegation-result-before-marker R1–R2).\n   751\t\tresultPublished := false\n   752\t\treserved := plan.predecessor != nil\n   753\t\tpublishResult := func() {\n   754\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n   755\t\t\t\treturn\n   756\t\t\t}\n   757\t\t\tresultPublished = true\n   758\t\t\tbeforeRunResultPublished(result)\n   759\t\t\tvar err error\n   760\t\t\tif plan.predecessor == nil {\n   761\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   762\t\t\t} else {\n   763\t\t\t\terr = s.finishReviewContinuation(result)\n   764\t\t\t}\n   765\t\t\tif err != nil {\n   766\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n   767\t\t\t}\n   768\t\t}\n   769\t\tdefer publishResult()\n   770\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n   771\t\tif err != nil {\n   772\t\t\tif plan.predecessor == nil {\n   773\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n   774\t\t\t\t// receipt are recorded against it, as before the marker moved\n   775\t\t\t\t// ahead of the reservation (spec\n   776\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n   777\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n   778\t\t\t\t\treturn ReviewRun{}, perr\n   779\t\t\t\t}\n   780\t\t\t\treserved = true\n   781\t\t\t}\n   782\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   783\t\t}\n   784\t\tif plan.predecessor == nil {\n   785\t\t\tbeforeAttemptPublished(s, attempt)\n   786\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n   787\t\t\t\tstopActive()\n   788\t\t\t\treturn ReviewRun{}, err\n   789\t\t\t}\n   790\t\t\treserved = true\n   791\t\t}\n   792\t\t// The marker goes only once the record and the attempt result are\n   793\t\t// published: without them it is the one trace of the reserved attempt,\n   794\t\t// and a waiter that sees it gone must find the receipt.\n   795\t\tdefer func() {\n   796\t\t\tpublishResult()\n   797\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n   798\t\t}()\n   799\t\tcancelled = cancelFlag\n   800\t\t// A detached run that cannot hand its attempt back stops here: nobody\n   801\t\t// would know which attempt runs (R1).\n   802\t\tif plan.OnStart != nil {\n   803\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n   804\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n   805\t\t\t}\n   806\t\t}\n   807\t\ttmp, err := os.MkdirTemp(\"\", \"pose-review-run-*\")\n   808\t\tif err != nil {\n   809\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n   810\t\t}\n    74\t// readBoundedRegular reads a regular file of at most limit bytes, refusing a\n    75\t// link or a file replaced while it was opened.\n    76\tfunc readBoundedRegular(path string, limit int64) ([]byte, error) {\n    77\t\tinfo, err := os.Lstat(path)\n    78\t\tif err != nil {\n    79\t\t\treturn nil, err\n    80\t\t}\n    81\t\tif !info.Mode().IsRegular() || info.Size() > limit {\n    82\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n    83\t\t}\n    84\t\tf, err := os.Open(path)\n    85\t\tif err != nil {\n    86\t\t\treturn nil, err\n    87\t\t}\n    88\t\topened, statErr := f.Stat()\n    89\t\tif statErr != nil || !opened.Mode().IsRegular() || !os.SameFile(info, opened) {\n    90\t\t\tf.Close()\n    91\t\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n    92\t\t}\n    93\t\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n    94\t\tcloseErr := f.Close()\n    95\t\tif err != nil {\n    96\t\t\treturn nil, err\n    97\t\t}\n    98\t\tif closeErr != nil {\n    99\t\t\treturn nil, closeErr\n   100\t\t}\n   101\t\tif int64(len(raw)) > limit {\n   102\t\t\treturn nil, fmt.Errorf(\"ledger record exceeds bound\")\n   103\t\t}\n   104\t\treturn raw, nil\n   105\t}\n   106\t\n   107\t// readBoundedRegularIn is the operation-Files form of readBoundedRegular. It\n   108\t// keeps the same regular-file and replacement checks while making the bytes\n   109\t// part of an active governance read view.\n   110\tfunc readBoundedRegularIn(files Files, path string, limit int64) ([]byte, error) {\n   111\t\tfiles = FilesOrNative(files)\n   112\t\tinfo, err := files.Lstat(path)\n   113\t\tif err != nil {\n   114\t\t\treturn nil, err\n   115\t\t}\n   116\t\tif !info.Mode().IsRegular() || limit < 0 || info.Size() < 0 || info.Size() > limit {\n   117\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n   118\t\t}\n   119\t\tf, err := files.Open(path)\n   120\t\tif err != nil {\n   121\t\t\treturn nil, err\n   122\t\t}\n   123\t\topened, statErr := f.Stat()\n   124\t\tif statErr != nil || !opened.Mode().IsRegular() || !sameObservedFile(info, opened) {\n   125\t\t\t_ = f.Close()\n   126\t\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n   127\t\t}\n   128\t\traw, readErr := readLimited(f, limit)\n   129\t\tcloseErr := f.Close()\n   130\t\tif readErr != nil {\n","exit_code":0,"status":"completed"}}
