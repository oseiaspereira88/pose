per := strings.ToUpper(name)\n   205\t\t\tfor _, mark := range []string{\"TOKEN\", \"SECRET\", \"PASSWORD\", \"CREDENTIAL\", \"API_KEY\", \"PRIVATE_KEY\"} {\n   206\t\t\t\tif strings.Contains(upper, mark) {\n   207\t\t\t\t\treturn nil, fmt.Errorf(\"sensitive environment variable %s requires credentials authorization\", name)\n   208\t\t\t\t}\n   209\t\t\t}\n   210\t\t}\n   211\t\treturn r, nil\n   212\t}\n   213\t\n   214\tfunc validateExplicitReviewBudget(raw []byte) error {\n   215\t\tvar policy struct {\n   216\t\t\tAdapters map[string]map[string]json.RawMessage `json:\"adapters\"`\n   217\t\t}\n   218\t\tif err := json.Unmarshal(raw, &policy); err != nil {\n   219\t\t\treturn err\n   220\t\t}\n   221\t\tfor name, a := range policy.Adapters {\n   222\t\t\tif value, ok := a[\"max_runs_per_bundle\"]; ok {\n   223\t\t\t\tvar n int\n   224\t\t\t\tif bytes.Equal(bytes.TrimSpace(value), []byte(\"null\")) || json.Unmarshal(value, &n) != nil || n <= 0 || n > 100 {\n   225\t\t\t\t\treturn fmt.Errorf(\"adapter %s: explicit max_runs_per_bundle must be 1..100; omit for default 3\", name)\n   226\t\t\t\t}\n   227\t\t\t}\n   228\t\t}\n   229\t\treturn nil\n   230\t}\n   231\t\n   232\tfunc reviewAdapterEnvironment(a ReviewerAdapter, tmp, brief, notes string) ([]string, []string, error) {\n   233\t\tnames := []string{\"PATH\", \"LANG\", \"LC_ALL\", \"LC_CTYPE\", \"SYSTEMROOT\", \"WINDIR\"}\n   234\t\tif a.Containment == nil {\n   235\t\t\tnames = append(names, \"HOME\", \"USERPROFILE\")\npose-mcp/internal/pose/review_adapter_containment.go:129:\t\t\"bounded-capture\": \"available\", \"environment-allowlist\": \"available\", \"parent-termination\": \"available\", \"process-group-termination\": \"unsupported\", \"filesystem-isolation\": \"unavailable\", \"origin-isolation\": \"unavailable\", \"shared-git-isolation\": \"unavailable\", \"network-isolation\": \"unavailable\", \"credential-filesystem-isolation\": \"unavailable\", \"escaped-descendant-termination\": \"unavailable\", \"memory-limit\": \"unavailable\", \"cpu-limit\": \"unavailable\", \"automatic-expiry\": \"unavailable\",\npose-mcp/internal/pose/review_adapter_containment.go:133:\t\t\tr.Capabilities[\"process-group-termination\"] = \"available\"\npose-mcp/internal/pose/review_adapter_containment.go:138:\t\t\tr.Capabilities[\"escaped-descendant-termination\"] = \"environment-marked\"\npose-mcp/internal/pose/review_adapter_containment.go:145:\t\t\tr.Capabilities[\"process-group-termination\"] = \"unavailable\"\npose-mcp/internal/pose/review_adapter_containment.go:183:\t\tstate, ok := r.Capabilities[capability]\n","exit_code":0,"status":"completed"}}
