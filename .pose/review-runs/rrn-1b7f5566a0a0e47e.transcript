\"Uso: \")+\"pose delegate cancel <run> [--dry-run] [--json]\")\n+\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n \t}\n \tstore := posemodel.Store{Root: root}\n \tattempts, lost, err := store.ListDelegationAttempts()\n@@ -1118,6 +1123,38 @@ func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int\n \tif err != nil {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n \t}\n+\tif !attempt.Active && !f.dryRun {\n+\t\t// An attempt whose dispatch, or whose earlier release, ended before\n+\t\t// its receipt is released with a failed run and its receipt, so it\n+\t\t// stops blocking the bundle; the release proves the abandonment\n+\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n+\t\t// review round 4, N1).\n+\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n+\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n+\t\t}\n+\t\tif err != nil {\n+\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n+\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n+\t\t}\n+\t\tif f.jsonOut {\n+\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n+\t\t\treturn 0\n+\t\t}\n+\t\tout := render(stdout, stderr)\n+\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n+\t\tswitch {\n+\t\tcase run.RunID == \"\":\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n+\t\tcase run.Status == posemodel.ReviewRunFailed && strings.HasPrefix(run.Failure, posemodel.DelegationAbandonedCause):\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n+\t\tdefault:\n+\t\t\t// The attempt had a run already: its receipt was completed with\n+\t\t\t// it (review round 11, N3).\n+\t\t\tout.Field(\"delegate.released\", tr(\"true: completed with run \"+run.RunID+\", already recorded as \"+run.Status, \"true: concluída com o run \"+run.RunID+\", já registrado como \"+run.Status))\n+\t\t}\n+\t\treturn 0\n+\t}\n \tif !attempt.Active {\n \t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n \t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\ndiff --git a/pose-mcp/internal/cli/help_catalog.go b/pose-mcp/internal/cli/help_catalog.go\nindex 6df8f572..2055220f 100644\n--- a/pose-mcp/internal/cli/help_catalog.go\n+++ b/pose-mcp/internal/cli/help_catalog.go\n@@ -362,7 +362,7 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"wait\", \"pose delegate wait <run> [--timeout <d>] [--json]\", \"Block until a run ends; exit 0 approved, 10 changes requested or rejected, 20 failed, 30 interrupted, 40 stalled, 50 timed out\", \"Bloqueia até um run terminar; sai com 0 aprovado, 10 mudanças pedidas ou rejeitado, 20 falhou, 30 interrompido, 40 travado, 50 tempo esgotado\"},\n \t\t\t{\"resume\", \"pose delegate resume <run> [--wait-until-reset[=<max>]] [--prompt <file|->] [--detach] [--dry-run] [--json]\", \"Continue an interrupted run with the same agent and session, under its original attempt; repeating 