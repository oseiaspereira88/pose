{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_shim.go && nl -ba pose-mcp/internal/pose/review_shim_linux.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"encoding/json\"\n     5\t\t\"time\"\n     6\t)\n     7\t\n     8\t// The review run shim (spec pose-review-run-reaps-lingering-reviewer-processes,\n     9\t// review rounds 6 and 8): a descendant of the reviewer that leaves the\n    10\t// adapter's process group, starts its own session and clears its environment\n    11\t// matches neither the group kill nor the sealed-checkout entry. Making the\n    12\t// dispatcher a child subreaper caught it, but a subreaper is process-wide:\n    13\t// in the dispatching process it also adopted and ended children other code\n    14\t// started there (a detached delegation), and reaped processes another\n    15\t// goroutine was waiting for. The dispatcher therefore starts the adapter\n    16\t// through a shim, the same executable re-entered with ReviewShimArg, which\n    17\t// makes itself the subreaper, runs the adapter, and, once it exits, ends\n    18\t// every process left in its subtree. The shim has no other children, so\n    19\t// everything it adopts is the run's. A timeout asks the shim to stop with\n    20\t// SIGTERM, and the death of the dispatcher delivers it the same signal: in\n    21\t// both cases it ends the subtree before it exits (review round 8, N3, N4).\n    22\t\n    23\t// reviewReapWait bounds how long ending the run's leftover processes takes.\n    24\tconst reviewReapWait = 5 * time.Second\n    25\t\n    26\t// ReviewShimArg is the first argument that runs the executable as a review\n    27\t// run shim instead of the CLI.\n    28\tconst ReviewShimArg = \"__pose-review-run-shim\"\n    29\t\n    30\t// ReviewShimReportEnv tells the shim that the dispatcher passed it a report\n    31\t// pipe as file descriptor 3, and names the dispatcher's pid. The report never\n    32\t// goes to a path the reviewer can write (review round 8, N2).\n    33\tconst ReviewShimReportEnv = \"POSE_REVIEW_SHIM_REPORT\"\n    34\t\n    35\t// ReviewShimAvailable says the running executable handles ReviewShimArg. It\n    36\t// is set by the pose command and by the test binaries that dispatch; any\n    37\t// other embedder starts the adapter directly, without the shim.\n    38\tvar ReviewShimAvailable = false\n    39\t\n    40\t// reviewShimReport is what the shim found after the adapter exited.\n    41\ttype reviewShimReport struct {\n    42\t\tEnded      []string `json:\"ended\"`\n    43\t\tEndedTotal int      `json:\"ended_total\"`\n    44\t\tError      string   `json:\"error,omitempty\"`\n    45\t}\n    46\t\n    47\t// reviewShimReportMaxPids bounds the pids a report lists; EndedTotal counts\n    48\t// them all. A full report stays far below the dispatcher's read bound.\n    49\tconst reviewShimReportMaxPids = 1000\n    50\t\n    51\t// boundedReviewShimReport encodes r within the dispatcher's read bound, so\n    52\t// the dispatcher always reads it whole (review round 9, N2).\n    53\tfunc boundedReviewShimReport(r reviewShimReport) []byte {\n    54\t\tr.EndedTotal = len(r.Ended)\n    55\t\tif len(r.Ended) > reviewShimReportMaxPids {\n    56\t\t\tr.Ended = r.Ended[:reviewShimReportMaxPids]\n    57\t\t}\n    58\t\tif len(r.Error) > 4096 {\n    59\t\t\tr.Error = r.Error[:4096]\n    60\t\t}\n    61\t\traw, _ := json.Marshal(r)\n    62\t\treturn raw\n    63\t}\n     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"os/signal\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"golang.org/x/sys/unix\"\n    18\t)\n    19\t\n    20\t// RunReviewShim runs args (the adapter's path, then its argv) as the shim's\n    21\t// only child, waits for it or for SIGTERM, ends every process left in the\n    22\t// shim's subtree and returns the adapter's exit status.\n    23\tfunc RunReviewShim(args []string) int {\n    24\t\treport := reviewShimReport{}\n    25\t\tvar reportFile *os.File\n    26\t\tparent := 0\n    27\t\tif value := os.Getenv(ReviewShimReportEnv); value != \"\" {\n    28\t\t\tparent, _ = strconv.Atoi(value)\n    29\t\t\t// The report pipe is the shim's alone: the adapter never inherits it.\n    30\t\t\tsyscall.CloseOnExec(3)\n    31\t\t\treportFile = os.NewFile(3, \"pose-review-shim-report\")\n    32\t\t}\n    33\t\t_ = os.Unsetenv(ReviewShimReportEnv)\n    34\t\twrite := func() {\n    35\t\t\tif reportFile == nil {\n    36\t\t\t\treturn\n    37\t\t\t}\n    38\t\t\traw := boundedReviewShimReport(report)\n    39\t\t\t_, _ = reportFile.Write(raw)\n    40\t\t\t_ = reportFile.Close()\n    41\t\t}\n    42\t\tif len(args) < 2 {\n    43\t\t\treport.Error = \"the review shim was given no adapter\"\n    44\t\t\twrite()\n    45\t\t\treturn 125\n    46\t\t}\n    47\t\tstop := make(chan os.Signal, 1)\n    48\t\tsignal.Notify(stop, syscall.SIGTERM)\n    49\t\t// The dispatcher's death stops the shim the same way as a timeout.\n    50\t\tif err := unix.Prctl(unix.PR_SET_PDEATHSIG, uintptr(syscall.SIGTERM), 0, 0, 0); err != nil {\n    51\t\t\treport.Error = \"the shim could not follow its dispatcher: \" + err.Error()\n    52\t\t\twrite()\n    53\t\t\treturn 125\n    54\t\t}\n    55\t\tif parent != 0 && os.Getppid() != parent {\n    56\t\t\treport.Error = \"the dispatcher ended before the shim started\"\n    57\t\t\twrite()\n    58\t\t\treturn 125\n    59\t\t}\n    60\t\tif err := unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0); err != nil {\n    61\t\t\treport.Error = \"the shim could not become the subreaper of the run: \" + err.Error()\n    62\t\t\twrite()\n    63\t\t\treturn 125\n    64\t\t}\n    65\t\tcmd := &exec.Cmd{Path: args[0], Args: args[1:], Stdin: os.Stdin, Stdout: os.Stdout, Stderr: os.Stderr, Env: os.Environ()}\n    66\t\tif err := cmd.Start(); err != nil {\n    67\t\t\treport.Error = \"the adapter could not run: \" + err.Error()\n    68\t\t\twrite()\n    69\t\t\treturn 127\n    70\t\t}\n    71\t\tdone := make(chan error, 1)\n    72\t\tgo func() { done <- cmd.Wait() }()\n    73\t\tcode, stopped := 0, false\n    74\t\tvar signaled syscall.Signal\n    75\t\tselect {\n    76\t\tcase err := <-done:\n    77\t\t\tvar exit *exec.ExitError\n    78\t\t\tif errors.As(err, &exit) {\n    79\t\t\t\tif status, ok := exit.Sys().(syscall.WaitStatus); ok && status.Signaled() {\n    80\t\t\t\t\tsignaled, code = status.Signal(), 128+int(status.Signal())\n    81\t\t\t\t} else {\n    82\t\t\t\t\tcode = exit.ExitCode()\n    83\t\t\t\t}\n    84\t\t\t} else if err != nil {\n    85\t\t\t\treport.Error = \"the adapter's end could not be read: \" + err.Error()\n    86\t\t\t}\n    87\t\tcase <-stop:\n    88\t\t\tstopped, code = true, 128+int(syscall.SIGTERM)\n    89\t\t}\n    90\t\tended, err := reapShimSubtree()\n    91\t\treport.Ended = ended\n    92\t\tif err != nil && report.Error == \"\" {\n    93\t\t\treport.Error = err.Error()\n    94\t\t}\n    95\t\twrite()\n    96\t\tif stopped {\n    97\t\t\treturn code\n    98\t\t}\n    99\t\t// An adapter ended by a signal is reported as ended by it: the shim ends\n   100\t\t// itself the same way, so the dispatcher reads what it would have read\n   101\t\t// without the shim.\n   102\t\tif signaled != 0 {\n   103\t\t\tsignal.Reset(signaled)\n   104\t\t\t_ = syscall.Kill(os.Getpid(), signaled)\n   105\t\t\ttime.Sleep(time.Second)\n   106\t\t}\n   107\t\treturn code\n   108\t}\n   109\t\n   110\t// stopReviewShim asks a running shim to end its subtree and exit.\n   111\tfunc stopReviewShim(cmd *exec.Cmd) func() error {\n   112\t\treturn func() error { return cmd.Process.Signal(syscall.SIGTERM) }\n   113\t}\n   114\t\n   115\t// reapShimSubtree ends and reaps every child of the shim, including the\n   116\t// orphans its subreaper status adopted, until none is left.\n   117\tfunc reapShimSubtree() ([]string, error) {\n   118\t\tself := os.Getpid()\n   119\t\tvar ended []string\n   120\t\tseen := map[int]bool{}\n   121\t\tdeadline := time.Now().Add(reviewReapWait)\n   122\t\t// A process that cannot be inspected or ended is not a reason to stop:\n   123\t\t// the others are still ended, and the problem is reported at the end\n   124\t\t// (review round 9, N3).\n   125\t\tvar problems []string\n   126\t\tnote := func(err error) {\n   127\t\t\tif len(problems) < 8 {\n   128\t\t\t\tproblems = append(problems, err.Error())\n   129\t\t\t}\n   130\t\t}\n   131\t\tfor {\n   132\t\t\tchildren := 0\n   133\t\t\tproblems = problems[:0]\n   134\t\t\tdirs, err := os.ReadDir(\"/proc\")\n   135\t\t\tif err != nil {\n   136\t\t\t\tnote(fmt.Errorf(\"the run's processes could not be listed: %w\", err))\n   137\t\t\t}\n   138\t\t\tfor _, d := range dirs {\n   139\t\t\t\tpid, err := strconv.Atoi(d.Name())\n   140\t\t\t\tif err != nil || pid == self {\n   141\t\t\t\t\tcontinue\n   142\t\t\t\t}\n   143\t\t\t\tst, err := readShimProcStat(pid)\n   144\t\t\t\tif reviewProcessGoneErr(err) {\n   145\t\t\t\t\tcontinue\n   146\t\t\t\t}\n   147\t\t\t\tif err != nil {\n   148\t\t\t\t\t// A process of another user is never the run's: with procfs\n   149\t\t\t\t\t// mounted hidepid it is visible and unreadable (review round 10,\n   150\t\t\t\t\t// N1). Only one of this user is an unknown that may be the run's.\n   151\t\t\t\t\tif owner, oerr := reviewProcessOwner(pid); reviewProcessGoneErr(oerr) || oerr == nil && owner != os.Getuid() {\n   152\t\t\t\t\t\tcontinue\n   153\t\t\t\t\t}\n   154\t\t\t\t\tchildren++\n   155\t\t\t\t\tnote(fmt.Errorf(\"process %d could not be inspected: %w\", pid, err))\n   156\t\t\t\t\tcontinue\n   157\t\t\t\t}\n   158\t\t\t\tif st.ppid != self {\n   159\t\t\t\t\tcontinue\n   160\t\t\t\t}\n   161\t\t\t\tchildren++\n   162\t\t\t\tif !st.zombie {\n   163\t\t\t\t\t// A pid is reported ended only once its signal was delivered\n   164\t\t\t\t\t// (review round 10, N3).\n   165\t\t\t\t\tif delivered, err := killPinnedChild(pid, self); err != nil {\n   166\t\t\t\t\t\tnote(err)\n   167\t\t\t\t\t} else if delivered && !seen[pid] {\n   168\t\t\t\t\t\tseen[pid] = true\n   169\t\t\t\t\t\tended = append(ended, strconv.Itoa(pid))\n   170\t\t\t\t\t}\n   171\t\t\t\t}\n   172\t\t\t}\n   173\t\t\tfor {\n   174\t\t\t\tpid, err := unix.Wait4(-1, nil, unix.WNOHANG, nil)\n   175\t\t\t\tif pid <= 0 || err != nil {\n   176\t\t\t\t\tbreak\n   177\t\t\t\t}\n   178\t\t\t}\n   179\t\t\tif children == 0 && len(problems) == 0 {\n   180\t\t\t\treturn ended, nil\n   181\t\t\t}\n   182\t\t\tif time.Now().After(deadline) {\n   183\t\t\t\treturn ended, fmt.Errorf(\"%d process(es) of the run could not be ended: %s\", children, strings.Join(problems, \"; \"))\n   184\t\t\t}\n   185\t\t\ttime.Sleep(20 * time.Millisecond)\n   186\t\t}\n   187\t}\n   188\t\n   189\ttype shimProcStat struct {\n   190\t\tppid   int\n   191\t\tzombie bool\n   192\t}\n   193\t\n   194\tfunc readShimProcStat(pid int) (shimProcStat, error) {\n   195\t\traw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n   196\t\tif err != nil {\n   197\t\t\treturn shimProcStat{}, err\n   198\t\t}\n   199\t\ttext := string(raw)\n   200\t\tend := strings.LastIndexByte(text, ')')\n   201\t\tif end < 0 {\n   202\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   203\t\t}\n   204\t\tf := strings.Fields(text[end+1:])\n   205\t\tif len(f) < 2 {\n   206\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   207\t\t}\n   208\t\tppid, err := strconv.Atoi(f[1])\n   209\t\tif err != nil {\n   210\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   211\t\t}\n   212\t\treturn shimProcStat{ppid: ppid, zombie: f[0] == \"Z\"}, nil\n   213\t}\n   214\t\n   215\t// killPinnedChild signals pid through a pidfd while it is still a child of\n   216\t// parent: a pid reused by an unrelated process is never signalled. It says\n   217\t// whether the signal reached the process; one that already ended was not\n   218\t// ended by the shim and is not reported (review round 11, N2).\n   219\tfunc killPinnedChild(pid, parent int) (bool, error) {\n   220\t\tfd, err := unix.PidfdOpen(pid, 0)\n   221\t\tif errors.Is(err, unix.ESRCH) {\n   222\t\t\treturn false, nil\n   223\t\t}\n   224\t\tif err != nil {\n   225\t\t\treturn false, fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   226\t\t}\n   227\t\tdefer unix.Close(fd)\n   228\t\tst, err := readShimProcStat(pid)\n   229\t\tif reviewProcessGoneErr(err) || err == nil && (st.ppid != parent || st.zombie) {\n   230\t\t\treturn false, nil\n   231\t\t}\n   232\t\tif err != nil {\n   233\t\t\treturn false, fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   234\t\t}\n   235\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil {\n   236\t\t\tif errors.Is(err, unix.ESRCH) {\n   237\t\t\t\treturn false, nil\n   238\t\t\t}\n   239\t\t\treturn false, fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   240\t\t}\n   241\t\treturn true, nil\n   242\t}\n   243\t\n   244\t// parseReviewShimReport reads the report the shim wrote to its pipe.\n   245\tfunc parseReviewShimReport(raw []byte) (reviewShimReport, error) {\n   246\t\tvar r reviewShimReport\n   247\t\tif len(raw) == 0 {\n   248\t\t\treturn r, fmt.Errorf(\"the review shim left no report\")\n   249\t\t}\n   250\t\tif err := json.Unmarshal(raw, &r); err != nil {\n   251\t\t\treturn r, fmt.Errorf(\"the review shim report is unreadable: %w\", err)\n   252\t\t}\n   253\t\treturn r, nil\n   254\t}\n","exit_code":0,"status":"completed"}}
