lpha\", \"--agent\", \"ok\", \"--dry-run\"); code != 0 || !strings.Contains(out, \"delegate.dry_run=true\") {\n    92\t\t\tt.Fatalf(\"preview: %s\", out)\n    93\t\t}\n    94\t\tbefore, _ := hashTree(root, true)\n    95\t\n    96\t\tcode, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"ok\", \"--reason\", \"regression control\")\n    97\t\tif code != 0 || !strings.Contains(out, \"delegate.status=completed\") || !strings.Contains(out, \"attestation=not recorded\") {\n    98\t\t\tt.Fatalf(\"ok run: %d %s\", code, out)\n    99\t\t}\n   100\t\truns, _ := posemodel.Store{Root: root}.ListReviewRuns(\"\")\n   101\t\tif len(runs) != 1 || runs[0].Vendor != \"test\" || runs[0].Model != \"ok-1\" || !strings.HasPrefix(runs[0].BriefDigest, \"sha256:\") || !strings.HasPrefix(runs[0].TranscriptDigest, \"sha256:\") {\n   102\t\t\tt.Fatalf(\"run record: %+v\", runs)\n   103\t\t}\n   104\t\tif !strings.Contains(runs[0].Output, runs[0].SealedCommit) || !strings.Contains(runs[0].Output, \"decision: approved\") {\n   105\t\t\tt.Fatalf(\"the reviewer did not run at the sealed commit with the brief: %q\", runs[0].Output)\n   106\t\t}\n   107\t\n   108\t\tif code, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"tools\", \"--reason\", \"regression control\"); code == 0 || !strings.Contains(out, \"delegate.status=failed\") {\n   109\t\t\tt.Fatalf(\"an unauthenticated derived writer was accepted: %d %s\", code, out)\n   110\t\t}\n   111\t\tfor adapter, want := range map[string]string{\"fail\": \"the reviewer command failed\", \"slow\": \"timeout\", \"editor\": \"changed files in the sealed worktree\"} {\n   112\t\t\tcode, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", adapter, \"--reason\", \"regression control\")\n   113\t\t\tstatus := \"failed\"\n   114\t\t\tif adapter == \"slow\" {\n   115\t\t\t\tstatus = \"interrupted\"\n   116\t\t\t}\n   117\t\t\tif code == 0 || !strings.Contains(out, \"delegate.status=\"+status) || !strings.Contains(out, want) {\n   118\t\t\t\tt.Fatalf(\"%s: %d %s\", adapter, code, out)\n   119\t\t\t}\n   120\t\t}\n   121\t\t// Budget: ok allows two runs on this bundle.\n   122\t\trunPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"ok\", \"--reason\", \"regression control\")\n   123\t\tif code, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"ok\", \"--reason\", \"regression control\"); code == 0 || !strings.Contains(out, \"budget exhausted\") {\n   124\t\t\tt.Fatalf(\"budget: %d %s\", code, out)\n   125\t\t}\n   126\t\n   127\t\tafter, _ := hashTree(root, true)\n   128\t\tfor path := range after {\n   129\t\t\t// .pose/review-private holds the git-ignored runtime marker of a run in progress.\n   130\t\t\tif strings.HasPrefix(path, \".pose/review-runs/\") || strings.HasPrefix(path, \".pose/review-attempts/\") || strings.HasPrefix(path, \".pose/review-run-ledger/\") || strings.HasPrefix(path, \".pose/review-private/\") {\n   131\t\t\t\tdelete(after, path)\n   132\t\t\t}\n   133\t\t}\n   134\t\tif changes := diffTrees(before, after); len(changes) != 0 {\n   135\t\t\tt.Fatalf(\"dispatch touched the working tree: %+v\", changes)\n   136\t\t}\n   137\t\tif atts, _ := (posemodel.Store{Root: root}).ListReviewAttestations(\"\"); len(atts) != 0 {\n   138\t\t\tt.Fatal(\"dispatch recorded an attestation\")\n   139\t\t}\n   140\t\tif out, _ := exec.Command(\"git\", \"-C\", root, \"worktree\", \"list\").Output(); strings.Count(string(out), \"\\n\") != 1 {\n   141\t\t\tt.Fatalf(\"a review worktree was left behind: %s\", out)\n   142\t\t}\n   143\t\tif entries, _ := os.ReadDir(filepath.Join(root, \".pose\", \"review-runs\")); len(entries) != 12 {\n   144\t\t\tt.Fatalf(\"expected 6 actual runs with transcripts (quota refusal did not launch), found %d files\", len(entries))\n   145\t\t}\n","exit_code":0,"status":"completed"}}
