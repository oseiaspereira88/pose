{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '1,520p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"context\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"fmt\"\n    10\t\t\"os\"\n    11\t\t\"os/exec\"\n    12\t\t\"path/filepath\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"testing\"\n    16\t\t\"time\"\n    17\t)\n    18\t\n    19\t// Spec pose-review-run-reaps-lingering-reviewer-processes R5, R6: a dispatch\n    20\t// that ended between its reservation and its run record leaves an attempt\n    21\t// that blocks the bundle; once its owner is proven gone, cancel releases it\n    22\t// with a failed run and its receipt, and the ledger reads again.\n    23\tfunc TestAnAbandonedAttemptIsReleasedWithARecord(t *testing.T) {\n    24\t\troot := t.TempDir()\n    25\t\ts := Store{Root: root}\n    26\t\tbundle := \"rvb-00000000000000a1\"\n    27\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n    28\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"0\", 32)}\n    29\t\ta.AttemptID = attemptIdentity(a)\n    30\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    31\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    32\t\t\tt.Fatal(err)\n    33\t\t}\n    34\t\t// The ledger refuses the bundle while the reservation has no receipt.\n    35\t\tif _, err := s.readAttemptReceipt(a); err == nil || !strings.Contains(err.Error(), \"incomplete or unreadable\") {\n    36\t\t\tt.Fatalf(\"an unfinished reservation read as finished: %v\", err)\n    37\t\t}\n    38\t\n    39\t\t// The marker the interrupted dispatch left: its owner is a process that\n    40\t\t// has exited.\n    41\t\tdead := exec.Command(\"true\")\n    42\t\tif err := dead.Run(); err != nil {\n    43\t\t\tt.Fatal(err)\n    44\t\t}\n    45\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    46\t\towner.Host, _ = os.Hostname()\n    47\t\tidentifyStartLockProcess(&owner)\n    48\t\towner.PID = dead.Process.Pid\n    49\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"b\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: a.Scope, BundleID: bundle,\n    50\t\t\tStartedAt: a.ReservedAt, Owner: owner, HeartbeatAt: a.ReservedAt, HeartbeatEvery: 10}\n    51\t\tdir, err := s.delegationActiveDir(true)\n    52\t\tif err != nil {\n    53\t\t\tt.Fatal(err)\n    54\t\t}\n    55\t\traw, _ := json.Marshal(marker)\n    56\t\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), raw, 0o600); err != nil {\n    57\t\t\tt.Fatal(err)\n    58\t\t}\n    59\t\n    60\t\trun, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false)\n    61\t\tif err != nil {\n    62\t\t\tt.Fatal(err)\n    63\t\t}\n    64\t\tif run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"abandoned\") {\n    65\t\t\tt.Fatalf(\"the release recorded %s: %s\", run.Status, run.Failure)\n    66\t\t}\n    67\t\tif _, err := s.readAttemptReceipt(a); err != nil {\n    68\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n    69\t\t}\n    70\t\tif left, _ := filepath.Glob(filepath.Join(dir, a.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n    71\t\t\tt.Fatalf(\"the marker or its stall claim stayed: %v\", left)\n    72\t\t}\n    73\t\t// Released once: a second release finds nothing abandoned.\n    74\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n    75\t\t\tt.Fatalf(\"a released attempt was released again: %v\", err)\n    76\t\t}\n    77\t}\n    78\t\n    79\t// An attempt whose owner is alive is never released.\n    80\tfunc TestARunningAttemptIsNotReleased(t *testing.T) {\n    81\t\troot := t.TempDir()\n    82\t\ts := Store{Root: root}\n    83\t\tbundle := \"rvb-00000000000000a2\"\n    84\t\t// Silent for an hour, so only the owner's liveness keeps it running.\n    85\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n    86\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1, ReservedAt: old, Nonce: strings.Repeat(\"0\", 32)}\n    87\t\ta.AttemptID = attemptIdentity(a)\n    88\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    89\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    90\t\t\tt.Fatal(err)\n    91\t\t}\n    92\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    93\t\towner.Host, _ = os.Hostname()\n    94\t\tidentifyStartLockProcess(&owner)\n    95\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"d\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: bundle, StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n    96\t\tdir, _ := s.delegationActiveDir(true)\n    97\t\traw, _ := json.Marshal(marker)\n    98\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n    99\t\t\tt.Fatal(err)\n   100\t\t}\n   101\t\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n   102\t\t\tt.Fatalf(\"a running attempt was released: %v\", err)\n   103\t\t}\n   104\t}\n   105\t\n   106\t// Review round 1, N1: the dispatch marks the attempt active before it\n   107\t// publishes the reservation, so no instant leaves a reservation without a\n   108\t// marker that turns stalled.\n   109\tfunc TestTheAttemptIsMarkedActiveBeforeItIsReserved(t *testing.T) {\n   110\t\tvar checked bool\n   111\t\tbeforeAttemptPublished = func(store Store, a DelegatedReviewAttempt) {\n   112\t\t\tchecked = true\n   113\t\t\tmarkers, _, err := store.ListDelegationActive()\n   114\t\t\tfound := false\n   115\t\t\tfor _, m := range markers {\n   116\t\t\t\tfound = found || m.AttemptID == a.AttemptID\n   117\t\t\t}\n   118\t\t\tif err != nil || !found {\n   119\t\t\t\tt.Errorf(\"the reservation of %s is published with no active marker: %v\", a.AttemptID, err)\n   120\t\t\t}\n   121\t\t\tif _, err := os.Lstat(reviewAttemptPath(store.Root, a)); !errors.Is(err, os.ErrNotExist) {\n   122\t\t\t\tt.Errorf(\"the reservation was published before the marker: %v\", err)\n   123\t\t\t}\n   124\t\t}\n   125\t\tt.Cleanup(func() { beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {} })\n   126\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\")\n   127\t\tif !checked {\n   128\t\t\tt.Fatal(\"the dispatch never reached the reservation\")\n   129\t\t}\n   130\t}\n   131\t\n   132\t// A marker whose dispatch ended before publishing the reservation is removed\n   133\t// by the release; ls names the cause and the release command (N2).\n   134\tfunc TestAStalledMarkerWithoutReservationIsListedAndRemoved(t *testing.T) {\n   135\t\troot := t.TempDir()\n   136\t\ts := Store{Root: root}\n   137\t\tdead := exec.Command(\"true\")\n   138\t\tif err := dead.Run(); err != nil {\n   139\t\t\tt.Fatal(err)\n   140\t\t}\n   141\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:x\", Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n   142\t\towner.Host, _ = os.Hostname()\n   143\t\tidentifyStartLockProcess(&owner)\n   144\t\towner.PID = dead.Process.Pid\n   145\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   146\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: \"rat-\" + strings.Repeat(\"e\", 64), RunToken: strings.Repeat(\"f\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: \"rvb-00000000000000a3\", StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n   147\t\tdir, _ := s.delegationActiveDir(true)\n   148\t\traw, _ := json.Marshal(marker)\n   149\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n   150\t\t\tt.Fatal(err)\n   151\t\t}\n   152\t\tattempts, _, err := s.ListDelegationAttempts()\n   153\t\tif err != nil || len(attempts) != 1 || attempts[0].State != DelegationStalled || !strings.Contains(attempts[0].Failure, DelegationAbandonedCause) || !strings.Contains(attempts[0].Failure, \"pose delegate cancel \"+marker.AttemptID) {\n   154\t\t\tt.Fatalf(\"the abandoned attempt is not listed with its cause: %+v %v\", attempts, err)\n   155\t\t}\n   156\t\trun, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false)\n   157\t\tif err != nil || run.RunID != \"\" {\n   158\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   159\t\t}\n   160\t\tif left, _ := filepath.Glob(filepath.Join(dir, marker.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n   161\t\t\tt.Fatalf(\"the marker stayed: %v\", left)\n   162\t\t}\n   163\t}\n   164\t\n   165\t// writeDeadMarker rewrites the marker of attempt so its owner is a process\n   166\t// that has exited and its heartbeat is an hour old, as a dispatch killed\n   167\t// mid-run leaves it.\n   168\tfunc writeDeadMarker(t *testing.T, s Store, attempt string) {\n   169\t\tt.Helper()\n   170\t\tdir, err := s.delegationActiveDir(false)\n   171\t\tif err != nil {\n   172\t\t\tt.Fatal(err)\n   173\t\t}\n   174\t\tpath := filepath.Join(dir, attempt+\".json\")\n   175\t\traw, err := os.ReadFile(path)\n   176\t\tif err != nil {\n   177\t\t\tt.Fatal(err)\n   178\t\t}\n   179\t\tvar marker DelegationActiveRun\n   180\t\tif err := json.Unmarshal(raw, &marker); err != nil {\n   181\t\t\tt.Fatal(err)\n   182\t\t}\n   183\t\tdead := exec.Command(\"true\")\n   184\t\tif err := dead.Run(); err != nil {\n   185\t\t\tt.Fatal(err)\n   186\t\t}\n   187\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   188\t\tmarker.Owner.PID, marker.HeartbeatAt, marker.StartedAt = dead.Process.Pid, old, old\n   189\t\traw, _ = json.Marshal(marker)\n   190\t\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n   191\t\t\tt.Fatal(err)\n   192\t\t}\n   193\t}\n   194\t\n   195\t// Review round 2, N4 (R6): a real dispatch interrupted after its reservation\n   196\t// and before its run record blocks the next dispatch; once released, the\n   197\t// next dispatch runs.\n   198\tfunc TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns(t *testing.T) {\n   199\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   200\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   201\t\tif err != nil {\n   202\t\t\tt.Fatal(err)\n   203\t\t}\n   204\t\tattempt := \"\"\n   205\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   206\t\tfunc() {\n   207\t\t\tdefer func() { _ = recover() }()\n   208\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   209\t\t}()\n   210\t\tif attempt == \"\" {\n   211\t\t\tt.Fatal(\"the dispatch never reached its start\")\n   212\t\t}\n   213\t\twriteDeadMarker(t, f.store, attempt)\n   214\t\tif _, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after interruption\"); err == nil || !strings.Contains(err.Error(), \"pose delegate cancel \"+attempt) {\n   215\t\t\tt.Fatalf(\"the interrupted attempt did not block the bundle with its release command: %v\", err)\n   216\t\t}\n   217\t\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil {\n   218\t\t\tt.Fatal(err)\n   219\t\t}\n   220\t\tnext, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\")\n   221\t\tif err != nil {\n   222\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n   223\t\t}\n   224\t\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n   225\t\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n   226\t\t}\n   227\t}\n   228\t\n   229\t// Review rounds 2 and 5 (N3, N1): one release runs at a time, under a lock\n   230\t// the operating system releases when its holder ends.\n   231\tfunc TestOneReleaseRunsAtATime(t *testing.T) {\n   232\t\troot := t.TempDir()\n   233\t\ts := Store{Root: root}\n   234\t\tattempt := \"rat-\" + strings.Repeat(\"9\", 64)\n   235\t\tdir, _ := s.delegationActiveDir(true)\n   236\t\tlockPath := filepath.Join(dir, attempt+\".release.lock\")\n   237\t\theld, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0o600)\n   238\t\tif err != nil {\n   239\t\t\tt.Fatal(err)\n   240\t\t}\n   241\t\tunlock, err := lockSpecTransferFile(held)\n   242\t\tif err != nil {\n   243\t\t\tt.Fatal(err)\n   244\t\t}\n   245\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\n   246\t\t\tt.Fatalf(\"a release ran while another held the lock: %v\", err)\n   247\t\t}\n   248\t\tunlock()\n   249\t\theld.Close()\n   250\t\t// A holder that ends releases the lock with it: nothing is left to take over.\n   251\t\tif _, err := exec.LookPath(\"flock\"); err == nil {\n   252\t\t\tholder := exec.Command(\"flock\", lockPath, \"sleep\", \"30\")\n   253\t\t\tholder.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n   254\t\t\tif err := holder.Start(); err != nil {\n   255\t\t\t\tt.Fatal(err)\n   256\t\t\t}\n   257\t\t\ttime.Sleep(200 * time.Millisecond)\n   258\t\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err == nil || !strings.Contains(err.Error(), \"in progress\") {\n   259\t\t\t\tt.Fatalf(\"the other process's lock was not seen: %v\", err)\n   260\t\t\t}\n   261\t\t\t_ = syscall.Kill(-holder.Process.Pid, syscall.SIGKILL)\n   262\t\t\t_ = holder.Wait()\n   263\t\t}\n   264\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil && strings.Contains(err.Error(), \"in progress\") {\n   265\t\t\tt.Fatalf(\"an ended holder's lock still blocks the release: %v\", err)\n   266\t\t}\n   267\t}\n   268\t\n   269\t// Review round 3, N1: a release interrupted after it recorded the run, and\n   270\t// before the receipt, completes with that run instead of recording another.\n   271\tfunc TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n   272\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   273\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   274\t\tif err != nil {\n   275\t\t\tt.Fatal(err)\n   276\t\t}\n   277\t\tattempt := \"\"\n   278\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   279\t\tfunc() {\n   280\t\t\tdefer func() { _ = recover() }()\n   281\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   282\t\t}()\n   283\t\twriteDeadMarker(t, f.store, attempt)\n   284\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   285\t\tmarkerPath := filepath.Join(activeDir, attempt+\".json\")\n   286\t\tmarkerBytes, err := os.ReadFile(markerPath)\n   287\t\tif err != nil {\n   288\t\t\tt.Fatal(err)\n   289\t\t}\n   290\t\tfirst, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   291\t\tif err != nil {\n   292\t\t\tt.Fatal(err)\n   293\t\t}\n   294\t\t// Undo the receipt and keep the marker, as a release stopped between\n   295\t\t// the run and the receipt leaves them.\n   296\t\tattempts, _ := f.store.readDelegatedReviewAttempts(f.bundle.BundleID)\n   297\t\tfor _, a := range attempts {\n   298\t\t\tif a.AttemptID == attempt {\n   299\t\t\t\tif err := os.Remove(attemptReceiptPath(f.store.Root, a)); err != nil {\n   300\t\t\t\t\tt.Fatal(err)\n   301\t\t\t\t}\n   302\t\t\t}\n   303\t\t}\n   304\t\tif err := os.WriteFile(markerPath, markerBytes, 0o600); err != nil {\n   305\t\t\tt.Fatal(err)\n   306\t\t}\n   307\t\tsecond, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   308\t\tif err != nil || second.RunID != first.RunID {\n   309\t\t\tt.Fatalf(\"the interrupted release recorded another run: %s then %s (%v)\", first.RunID, second.RunID, err)\n   310\t\t}\n   311\t}\n   312\t\n   313\t// Review round 2, N1: a reservation an earlier engine left with no marker is\n   314\t// listed and released once it is old enough, never while it is young.\n   315\tfunc TestAMarkerlessReservationOfAnEarlierEngineIsReleased(t *testing.T) {\n   316\t\troot := t.TempDir()\n   317\t\ts := Store{Root: root}\n   318\t\treserve := func(age time.Duration, nonce string) DelegatedReviewAttempt {\n   319\t\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000b\" + nonce[:1], BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   320\t\t\t\tReservedAt: time.Now().Add(-age).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(nonce[:1], 32)}\n   321\t\t\ta.AttemptID = attemptIdentity(a)\n   322\t\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   323\t\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   324\t\t\t\tt.Fatal(err)\n   325\t\t\t}\n   326\t\t\treturn a\n   327\t\t}\n   328\t\told, young := reserve(time.Hour, \"1\"), reserve(time.Minute, \"2\")\n   329\t\tattempts, _, err := s.ListDelegationAttempts()\n   330\t\tif err != nil {\n   331\t\t\tt.Fatal(err)\n   332\t\t}\n   333\t\tlisted := map[string]DelegationAttempt{}\n   334\t\tfor _, a := range attempts {\n   335\t\t\tlisted[a.AttemptID] = a\n   336\t\t}\n   337\t\tif a, ok := listed[old.AttemptID]; !ok || a.State != DelegationStalled || !strings.Contains(a.Failure, \"pose delegate cancel \"+old.AttemptID+\" --confirm-abandoned\") {\n   338\t\t\tt.Fatalf(\"the old markerless reservation is not listed with its release: %+v\", attempts)\n   339\t\t}\n   340\t\tif _, ok := listed[young.AttemptID]; ok {\n   341\t\t\tt.Fatal(\"a young reservation was listed as abandoned\")\n   342\t\t}\n   343\t\tif _, err := s.ReleaseAbandonedAttempt(young.AttemptID, time.Now(), true); !errors.Is(err, ErrAttemptNotAbandoned) {\n   344\t\t\tt.Fatalf(\"a young reservation was released: %v\", err)\n   345\t\t}\n   346\t\t// Review round 3, N2: nothing proves a markerless reservation abandoned,\n   347\t\t// so it is released only on the operator's confirmation.\n   348\t\tif _, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"--confirm-abandoned\") {\n   349\t\t\tt.Fatalf(\"a markerless reservation was released without confirmation: %v\", err)\n   350\t\t}\n   351\t\trun, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n   352\t\tif err != nil || run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"operator's confirmation\") {\n   353\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   354\t\t}\n   355\t\tif _, err := s.readAttemptReceipt(old); err != nil {\n   356\t\t\tt.Fatalf(\"the released reservation still blocks its bundle: %v\", err)\n   357\t\t}\n   358\t\t// Review round 4, N1: a release stopped between its run and its receipt\n   359\t\t// leaves the attempt with a run; it is still released, with that run.\n   360\t\tif err := os.Remove(attemptReceiptPath(root, old)); err != nil {\n   361\t\t\tt.Fatal(err)\n   362\t\t}\n   363\t\tagain, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n   364\t\tif err != nil || again.RunID != run.RunID {\n   365\t\t\tt.Fatalf(\"the interrupted release did not complete with its run: %s then %s (%v)\", run.RunID, again.RunID, err)\n   366\t\t}\n   367\t}\n   368\t\n   369\t// Review round 3, N3: an unreadable reservation is reported, not skipped.\n   370\tfunc TestAnUnreadableReservationIsReportedAsALoss(t *testing.T) {\n   371\t\troot := t.TempDir()\n   372\t\ts := Store{Root: root}\n   373\t\tdir := filepath.Join(root, reviewAttemptDir, \"broken\")\n   374\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n   375\t\t\tt.Fatal(err)\n   376\t\t}\n   377\t\tif err := os.WriteFile(filepath.Join(dir, \"000001.json\"), []byte(\"{not json\"), 0o644); err != nil {\n   378\t\t\tt.Fatal(err)\n   379\t\t}\n   380\t\t_, lost, err := s.ListDelegationAttempts()\n   381\t\tif err != nil || !strings.Contains(strings.Join(lost, \"\\n\"), \"broken/000001.json could not be read\") {\n   382\t\t\tt.Fatalf(\"an unreadable reservation was skipped silently: %v %v\", lost, err)\n   383\t\t}\n   384\t}\n   385\t\n   386\t// Review round 4, N3: with the run history incomplete, no reservation is\n   387\t// taken as runless, and the loss is reported.\n   388\tfunc TestAnIncompleteRunHistoryRulesNothingOut(t *testing.T) {\n   389\t\troot := t.TempDir()\n   390\t\ts := Store{Root: root}\n   391\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000c1\", BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   392\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"3\", 32)}\n   393\t\ta.AttemptID = attemptIdentity(a)\n   394\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   395\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   396\t\t\tt.Fatal(err)\n   397\t\t}\n   398\t\tif err := os.MkdirAll(filepath.Join(root, reviewRunsDir), 0o755); err != nil {\n   399\t\t\tt.Fatal(err)\n   400\t\t}\n   401\t\tif err := os.WriteFile(filepath.Join(root, reviewRunsDir, \"rrn-0000000000000bad.json\"), []byte(\"{broken\"), 0o644); err != nil {\n   402\t\t\tt.Fatal(err)\n   403\t\t}\n   404\t\tif _, runLost, err := s.ReadReviewRuns(\"\"); err != nil || len(runLost) == 0 {\n   405\t\t\tt.Skipf(\"the fixture does not make the run history incomplete: %v %v\", runLost, err)\n   406\t\t}\n   407\t\torphans, lost, err := s.orphanReservations(time.Now())\n   408\t\tif err != nil || len(orphans) != 0 || !strings.Contains(strings.Join(lost, \"\\n\"), \"run history is incomplete\") {\n   409\t\t\tt.Fatalf(\"an incomplete history ruled a run out: %v %v %v\", orphans, lost, err)\n   410\t\t}\n   411\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n   412\t\t\tt.Fatal(\"a reservation was released over an incomplete run history\")\n   413\t\t}\n   414\t}\n   415\t\n   416\t// Review round 5, N3: a dispatch that recorded its run and stopped before\n   417\t// the receipt is completed with that run, not with a second one; N2: a\n   418\t// release that stopped after the receipt only removes the marker.\n   419\tfunc TestARecordedRunCompletesItsAttempt(t *testing.T) {\n   420\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   421\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"receipt lost\")\n   422\t\tif err != nil {\n   423\t\t\tt.Fatal(err)\n   424\t\t}\n   425\t\tsaved := beforeRunResultPublished\n   426\t\tt.Cleanup(func() { beforeRunResultPublished = saved })\n   427\t\trecorded := \"\"\n   428\t\tbeforeRunResultPublished = func(r ReviewRun) { recorded = r.RunID; panic(\"the dispatching process ends before the receipt\") }\n   429\t\tfunc() {\n   430\t\t\tdefer func() { _ = recover() }()\n   431\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   432\t\t}()\n   433\t\tbeforeRunResultPublished = saved\n   434\t\truns, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID)\n   435\t\tif recorded == \"\" || len(runs) == 0 {\n   436\t\t\tt.Fatalf(\"the dispatch recorded no run: %q %d\", recorded, len(runs))\n   437\t\t}\n   438\t\tattempt := runs[len(runs)-1].AttemptID\n   439\t\twriteDeadMarker(t, f.store, attempt)\n   440\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   441\t\tmarkerBytes, _ := os.ReadFile(filepath.Join(activeDir, attempt+\".json\"))\n   442\t\treleased, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   443\t\tif err != nil || released.RunID != recorded {\n   444\t\t\tt.Fatalf(\"the release did not complete with the recorded run %s: %s %v\", recorded, released.RunID, err)\n   445\t\t}\n   446\t\tif after, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID); len(after) != len(runs) {\n   447\t\t\tt.Fatalf(\"the release recorded another run: %d then %d\", len(runs), len(after))\n   448\t\t}\n   449\t\t// The marker comes back, as a release stopped after the receipt leaves it.\n   450\t\tif err := os.WriteFile(filepath.Join(activeDir, attempt+\".json\"), markerBytes, 0o600); err != nil {\n   451\t\t\tt.Fatal(err)\n   452\t\t}\n   453\t\tagain, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   454\t\tif err != nil || again.RunID != recorded {\n   455\t\t\tt.Fatalf(\"a release after the receipt did not complete: %s %v\", again.RunID, err)\n   456\t\t}\n   457\t\tif left, _ := filepath.Glob(filepath.Join(activeDir, attempt+\".json\")); len(left) != 0 {\n   458\t\t\tt.Fatal(\"the stalled marker stayed after the receipt\")\n   459\t\t}\n   460\t}\n   461\t\n   462\t// Review round 6, N1: an unreadable active marker may be a live attempt's,\n   463\t// so no reservation is taken as markerless.\n   464\tfunc TestAnUnreadableMarkerRulesNothingOut(t *testing.T) {\n   465\t\troot := t.TempDir()\n   466\t\ts := Store{Root: root}\n   467\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000d1\", BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   468\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"4\", 32)}\n   469\t\ta.AttemptID = attemptIdentity(a)\n   470\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   471\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   472\t\t\tt.Fatal(err)\n   473\t\t}\n   474\t\tdir, _ := s.delegationActiveDir(true)\n   475\t\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), []byte(\"{damaged\"), 0o600); err != nil {\n   476\t\t\tt.Fatal(err)\n   477\t\t}\n   478\t\torphans, lost, err := s.orphanReservations(time.Now())\n   479\t\tif err != nil || len(orphans) != 0 || !strings.Contains(strings.Join(lost, \"\\n\"), \"active marker is unreadable\") {\n   480\t\t\tt.Fatalf(\"an unreadable marker let a reservation pass as markerless: %v %v %v\", orphans, lost, err)\n   481\t\t}\n   482\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n   483\t\t\tt.Fatal(\"a reservation with an unreadable marker was released\")\n   484\t\t}\n   485\t}\n   486\t\n   487\t// Review round 10, N2: a directory listing of the orphan scan is bounded and\n   488\t// says when it was cut.\n   489\tfunc TestTheOrphanScanListsBoundedDirectories(t *testing.T) {\n   490\t\tdir := t.TempDir()\n   491\t\tfor i := 0; i < 12; i++ {\n   492\t\t\tif err := os.WriteFile(filepath.Join(dir, fmt.Sprintf(\"%06d.json\", i)), []byte(\"{}\"), 0o644); err != nil {\n   493\t\t\t\tt.Fatal(err)\n   494\t\t\t}\n   495\t\t}\n   496\t\tentries, truncated, err := readDirBounded(dir, 10)\n   497\t\tif err != nil || len(entries) != 10 || !truncated {\n   498\t\t\tt.Fatalf(\"listing: %d entries, truncated=%t, %v\", len(entries), truncated, err)\n   499\t\t}\n   500\t\tentries, truncated, err = readDirBounded(dir, 20)\n   501\t\tif err != nil || len(entries) != 12 || truncated {\n   502\t\t\tt.Fatalf(\"listing: %d entries, truncated=%t, %v\", len(entries), truncated, err)\n   503\t\t}\n   504\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba .pose/specs/2026-11-23-pose-review-run-reaps-lingering-reviewer-processes.md | sed -n '65,195p'\"","aggregated_output":"    65\t- modified: pose-mcp/internal/pose/engine_reads_raw_history_test.go\n    66\t- modified: pose-mcp/internal/cli/cli.go\n    67\t- modified: pose-mcp/internal/cli/cli_test.go\n    68\t- modified: pose-mcp/cmd/pose/main.go\n    69\t- modified: pose-mcp/internal/pose/delegation_list.go\n    70\t- created: pose-mcp/internal/pose/delegation_release.go\n    71\t- created: pose-mcp/internal/pose/delegation_release_test.go\n    72\t- modified: pose-mcp/internal/pose/review_dispatch.go\n    73\t- modified: pose-mcp/internal/pose/review_attempt_ledger.go\n    74\t- modified: pose-mcp/internal/pose/review_adapter_containment.go\n    75\t- modified: pose-mcp/internal/pose/review_adapter_containment_regression_test.go\n    76\t- modified: pose-mcp/internal/pose/review_brief.go\n    77\t- modified: pose-mcp/internal/pose/review_brief_test.go\n    78\t- modified: pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\n    79\t- modified: pose-mcp/internal/pose/testdata/review_brief_template_digests.json\n    80\t- modified: pose-mcp/internal/cli/delegate.go\n    81\t- modified: pose-mcp/internal/cli/help_catalog.go\n    82\t- created: pose-mcp/internal/cli/review_reap_test.go\n    83\t- modified: POSE.md\n    84\t- modified: locales/pt-BR/POSE.md\n    85\t- modified: pose-mcp/internal/scaffold/dist/POSE.md\n    86\t- modified: pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n    87\t\n    88\t\n    89\t### Delivery targets\n    90\t\n    91\t- capability:review-run-reaps-lingering-reviewer-processes module:pose-mcp profile:composed-capability entrypoint:pose-mcp/internal/cli/delegate.go\n    92\t\n    93\t\n    94\t### API/contract changes\n    95\t`pose delegate cancel` releases a stalled attempt that has no run, recording a failed run and its receipt. Brief template `review-brief/10`. The run record's `safety.limitations` names the processes the dispatch ended after the adapter.\n    96\t\n    97\t\n    98\t### Data/storage changes\n    99\tA released attempt gets an ordinary failed run record and attempt receipt; no schema changes.\n   100\t\n   101\t\n   102\t### Technical risks\n   103\tOn Linux the pose command runs the adapter under the review run shim, which is the subreaper of the run's subtree and ends what the run leaves in it after the adapter exits, on a timeout and when the dispatcher ends; the subtree is the run's by construction. An embedder that does not enable the shim falls back to the search by the sealed-checkout environment entry, which a reviewer process can clear or set (L6). Outside Linux only the process-group kill applies (L2).\n   104\t\n   105\t## 4. Tasks\n   106\t\n   107\t### Planning\n   108\t- [ ] Confirm the cause against the current engine before starting.\n   109\t\n   110\t### Implementation\n   111\t- [ ] Implement each requirement with a test that fails before it.\n   112\t\n   113\t### Validation\n   114\t- [ ] `pose validate --carry` and `pose check --strict`.\n   115\t\n   116\t## 5. Decisions\n   117\t\n   118\t### Decision D1\n   119\t- Basis: R1, R2\n   120\tThe run's leftovers are identified by the process tree, not by the environment: on Linux the adapter runs under a shim that is the subreaper of the run's subtree, so every process the run starts, including one that opens its own session or clears its environment, stays the shim's to end. A subreaper in the dispatcher itself was rejected because it is process-wide there and adopted children other code started in the same process. The sealed-checkout entry the dispatch already sets remains a fallback for an embedder without the shim.\n   121\t\n   122\t### Decision D2\n   123\t- Basis: R5\n   124\tAn abandoned attempt is closed by the records a failed run writes (a run record and its receipt), released only when its marker is stalled and its owner proven dead. Nothing is deleted from the ledger, and older engines read the result as an ordinary failed run.\n   125\t\n   126\t## 6. Validation\n   127\t\n   128\t### Strategy\n   129\tEach requirement gets a regression test shown failing before its code.\n   130\t\n   131\t### Deterministic checks\n   132\t\n   133\t#### Test\n   134\t- Command: `go test ./...` (in `pose-mcp`), then `pose validate --carry`.\n   135\t\n   136\t### Execution log\n   137\t- 2026-11-24: implemented R1–R6. Each has a test that fails with its fix mutated out: the dispatch ends a process the adapter left in a session of its own (the test's leftover keeps writing into the runtime directory), the release records the failed run and receipt and removes the marker and its stall claim, a live owner is never released, and `review-brief/10` asks commands to finish while `/9` stays unchanged.\n   138\t- 2026-11-24: the containment record disclosed escaped-descendant termination as `unavailable`, and a regression test pinned that limitation. On Linux it is now `environment-marked` (ended while the descendant keeps the run's sealed-checkout entry, never `available`, so a profile that requires the full guarantee is still refused), the limitation text says so, and the test now proves the escaped child is ended with the run.\n   139\t- 2026-11-24: review round 1 (rrn-c5c082703d83c834) requested changes. N1: the reservation was published before the active marker, so a dispatch ended in between left an attempt nothing could release; the dispatch now marks the attempt active first and publishes the reservation after, and a stalled marker without a reservation is removed by the release. When marking itself fails, the dispatch still publishes the reservation and records the failed run and its receipt, keeping the contract of `pose-delegation-result-before-marker`. N2: `delegate ls` now names the abandonment cause and the release command, in text and JSON. N3: each process is pinned by a pidfd and its environment read again through it before SIGKILL, so a reused pid is never signalled. N4: a scan that cannot list `/proc` or read a process state fails; a process of this user whose environment cannot be read is counted and disclosed in the run record rather than skipped (L3). N5: the manual says the reaping is Linux-only. Each fix has a test that fails with it mutated out (N4's disclosure is not reproducible in a test: it needs a non-inspectable process).\n   140\t- 2026-11-24: review round 2 (rrn-2c9fa8ac47c2fbab) requested changes. N1: a reservation an earlier engine left without any marker is now listed by `delegate ls` and released by `cancel` once it has no marker, receipt or run and is older than ten minutes (an earlier engine marked within moments of reserving). N2: a non-inspectable process of this user that did not exist before the adapter started may be the run's, so the scan fails and the run stays unconcludable; ones that predate the run are skipped and disclosed. N3: a release claims the attempt exclusively, so two cancels never record two runs. N4: `TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns` interrupts a real dispatch after its reservation, sees the next dispatch refused with the release command, releases it and dispatches again. N5: a receipt that cannot be inspected is reported with its error. Each fix has a test that fails with it mutated out, except N5.\n   141\t- 2026-11-24: review round 3 (rrn-667b69e8c01c345c) requested changes. N1: the release claim records its owner; a claim whose owner is gone is taken over, and a release interrupted after recording its run completes with that run instead of recording another. N2: age proves nothing about a markerless reservation, so it is released only with `--confirm-abandoned`, the operator's assertion that no dispatch of it runs, which the recorded run states. N3: reservations and receipts that cannot be read are reported as losses by `delegate ls`. Each fix has a test that fails with it mutated out.\n   142\t- 2026-11-24: review round 4 (rrn-97acfcc2809e32c2) requested changes. N1: `pose delegate cancel` now asks the release for every attempt that is not running, so a release interrupted after recording its run is completed even when the attempt already shows that run; an abandonment run no longer counts as the attempt's run when looking for orphans. N2: a stale claim is taken over by renaming it, which only one taker wins, then an exclusive publish. N3: with the run history incomplete, the release refuses to rule a run out and the listing reports why. Each fix has a test that fails with it mutated out.\n   143\t- 2026-11-24: review round 5 (rrn-146bc70da7364cde) requested changes. N1: the published claim and its takeover protocol are replaced by an operating-system lock (`flock`) on a per-attempt lock file, which the kernel releases when its holder ends, so there is nothing to take over and no window between two takers. N2: a release that finds the receipt already published and the marker still stalled completes by removing the marker. N3: the release completes with any run the attempt already recorded (by its dispatch or by an earlier release), never writing a second one. Each fix has a test that fails with it mutated out.\n   144\t- 2026-11-24: review round 6 (rrn-adf91bb46841bd66) requested changes. N1: an unreadable active marker may be a live attempt's, so no reservation is then taken as markerless. N2: a descendant that leaves the group, starts its own session and clears its environment is now ended too on Linux: the dispatcher makes itself a child subreaper, and after the adapter exits it ends every child reparented to it in another session, started after the adapter, that does not name another run's checkout, pinning each by pidfd and reaping it. N3: the disclosed count holds only processes that predate the run. Each fix has a test that fails with it mutated out.\n   145\t- 2026-11-24: review round 7 (rrn-9abc2fe5dedc7478) requested changes. N1, N2: a subreaper that cannot be enabled or a run start that cannot be read now fails the cleanup instead of skipping the orphan scan. N3: a process start that cannot be read, in the baseline or the orphan scan, is an error, and a process absent from the baseline is never taken as preexisting. N4: the run record names the ended processes by pid only; their names, which the reviewer chooses, are not recorded. N4 has a test; N1–N3 are error paths the host cannot be made to produce in a test.\n   146\t- 2026-11-24: the matrix of round 8 failed `TestReviewDispatchRunsAndRecordsAdapters`, and the cause was the design, not the test: a subreaper is process-wide, so the dispatcher also adopted and ended children other code started in the same process (a detached delegation) and could reap a process another goroutine waited for. The subreaper moved into a review run shim: the dispatcher starts the adapter as `<pose> __pose-review-run-shim <adapter path> <argv>`, the shim makes itself the subreaper, runs the adapter as its only child, ends and reaps everything left in its subtree, reports the ended pids in a file the dispatcher reads, and returns the adapter's status, re-raising its signal so a lost process still reads as lost. The shim has no other children, so all it adopts is the run's. The pose command and the test binaries that dispatch enable it; another embedder starts the adapter directly. `TestAnOrphanThatClearedItsEnvironmentIsEnded` fails with the shim's reaping removed.\n   147\t- 2026-11-24: review round 8 (rrn-f19179878d867e9a) requested changes. N1: the environment entry is the reviewer's to set, so with the shim the dispatcher no longer searches by it; the shim's subtree is the run's by construction, and the search remains only for an embedder without the shim (L6). N2: the shim's report goes through a pipe passed as file descriptor 3, which the shim closes on exec, never through a path the reviewer can write. N3: a timeout sends the shim SIGTERM, and the shim ends the run's subtree before it exits; the group kill after the run stays the backstop. N4: the shim receives SIGTERM when its dispatcher ends (`PR_SET_PDEATHSIG`, checked against the dispatcher's pid at start) and ends the run, so a dead dispatcher never leaves a reviewer running. Each fix has a test that fails with it mutated out.\n   148\t- 2026-11-24: review round 9 (rrn-5bbd458c7701af31) requested changes. N1 (follow-up): the manual and the recorded limitation now describe the shim as the Linux path and the environment search as the fallback of an embedder without it. N2: the shim's report is bounded (at most 1000 pids, with the total counted, and a bounded error) and the dispatcher drains whatever exceeds its read, so a large report never blocks the shim. N3: a process the shim cannot inspect or end no longer stops the reaping of the others; the problems are reported when the bound expires. N1 and N2 have tests that fail with them mutated out; N3 needs an uninspectable child, which the test host cannot produce.\n   149\t- 2026-11-24: review round 10 (rrn-ecfc61a1c2b009f6) requested changes. N1: the shim no longer counts a process of another user whose stat it cannot read (procfs mounted hidepid) as a possible run child; only an unreadable process of this user is. N2 (follow-up): the orphan scan lists each directory with a bound and reports a cut listing as a loss. N3 (follow-up): the shim reports a pid only once its signal was delivered, and its error is recorded in the run's limitations. N4 (follow-up): Technical risks, D1 and the fallback helper's comment describe the shim as the Linux path. N2 has a test; N1 and N3 need a hidepid procfs or an unkillable child.\n   150\t- 2026-11-25: round 11 first hit the Codex usage limit; its resume pointed the reviewer at the removed checkout of the first attempt, so a new run reviewed the same bundle (rrn-2b8c0f5ecc1b6196) and requested changes. N1: a shim that cannot be set up now fails the run instead of falling back to the environment search. N2 (follow-up): a child that already ended is not reported as ended by the shim. N3 (follow-up): `cancel` says when it completed an attempt with a run already recorded, with that run's status. N2 has a test that fails with it mutated out; N1 needs `os.Executable` or `pipe` to fail, and N3 is a message of the CLI branch stated untested in Known gaps.\n   151\t\n   152\t\n   153\t### Results summary\n   154\tThe full `pose-mcp` suite passes; the canonical result is refreshed with `pose validate --carry`.\n   155\t\n   156\t\n   157\t### Requirement trace\n   158\t- R1 [satisfied] test:TestDispatchEndsWhatTheReviewerLeftRunning, test:TestATimeoutEndsTheRunsOrphans, test:TestTheShimEndsTheRunWhenItsDispatcherEnds, test:TestTheAdapterDoesNotInheritTheShimReport, test:TestTheShimReportIsBounded, test:TestAChildThatAlreadyEndedIsNotReportedEnded, test:TestAnOrphanThatClearedItsEnvironmentIsEnded, test:TestAPidThatLostTheRunsEntryIsNotKilled, test:TestANonInspectableProcessStartedDuringTheRunFailsTheScan\n   159\t- R2 [satisfied] test:TestDispatchEndsWhatTheReviewerLeftRunning\n   160\t- R3 [satisfied] test:TestTheCurrentBriefAsksCommandsToFinish\n   161\t- R4 [satisfied] test:TestDispatchEndsWhatTheReviewerLeftRunning\n   162\t- R5 [satisfied] test:TestAnAbandonedAttemptIsReleasedWithARecord, test:TestTheAttemptIsMarkedActiveBeforeItIsReserved, test:TestAStalledMarkerWithoutReservationIsListedAndRemoved\n   163\t- R6 [satisfied] test:TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns, test:TestAMarkerlessReservationOfAnEarlierEngineIsReleased, test:TestOneReleaseRunsAtATime, test:TestARecordedRunCompletesItsAttempt, test:TestAnInterruptedReleaseCompletesWithItsRun, test:TestAnUnreadableReservationIsReportedAsALoss, test:TestAnIncompleteRunHistoryRulesNothingOut, test:TestAnUnreadableMarkerRulesNothingOut, test:TestTheOrphanScanListsBoundedDirectories\n   164\t\n   165\t\n   166\t### Known gaps\n   167\tThe release is driven through the Store, including after a real interrupted dispatch; the thin `pose delegate cancel` branch that calls it is not driven through the CLI, because a stalled marker there needs a dispatch process killed and three silent heartbeat intervals. N5 (the receipt inspection error) has no test: making the receipt path uninspectable also makes the reservation unreadable first.\n   168\t\n   169\t\n   170\t## 7. Final Report\n   171\t\n   172\t### Delivered scope\n   173\tThe dispatch ends the processes a run left running before its cleanup and names them in the run record; `pose delegate cancel` releases an attempt abandoned before its run was recorded; `review-brief/10` asks the reviewer to let its commands finish.\n   174\t\n   175\t\n   176\t### Files and modules changed\n   177\t`pose-mcp` (review dispatch, attempt ledger, delegation CLI, brief), the manual in both locales and its embedded copies.\n   178\t\n   179\t\n   180\t### Validation executed\n   181\t`go test ./...` in `pose-mcp`; `pose check --strict`; `pose validate --carry --json-out .pose/results/delivery-validation.json`.\n   182\t\n   183\t\n   184\t### Residual risks\n   185\tL1: on Linux a run's process escapes only while it keeps a live parent outside the run and neither the run's group nor its environment entry, for example one handed to a service manager; the cleanup inventory still fails a run whose files it keeps changing. L2: outside Linux only the process-group kill applies. L6: an embedder that does not enable the shim falls back to the search by the sealed-checkout entry, which a reviewer process can set. L4: a reservation an earlier engine left without a marker records no owner, so its release rests on the operator's confirmation, not on proof. L3: a process of this user that made itself non-inspectable cannot be matched: one that predates the run is skipped and counted in the run record, and one started during the run fails the cleanup, so such a run is not concludable.\n   186\t\n   187\t\n   188\t### Follow-ups\n   189\tNone.\n   190\t\n   191\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/delegate.go | sed -n '1100,1208p'; nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '150,220p'\"","aggregated_output":"  1100\t\thandBackExisting(run, err)\n  1101\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n  1102\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"resume\")\n  1103\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"resume\", run, err, delegateRunNextActions(store, run, err)...)\n  1104\t\tif err == nil && !f.jsonOut {\n  1105\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n  1106\t\t\t\treturn next\n  1107\t\t\t}\n  1108\t\t}\n  1109\t\treturn code\n  1110\t}\n  1111\t\n  1112\tfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n  1113\t\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n  1114\t\tif problem != \"\" {\n  1115\t\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n  1116\t\t}\n  1117\t\tstore := posemodel.Store{Root: root}\n  1118\t\tattempts, lost, err := store.ListDelegationAttempts()\n  1119\t\tif err != nil {\n  1120\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1121\t\t}\n  1122\t\tattempt, code, err := namedAttempt(attempts, f)\n  1123\t\tif err != nil {\n  1124\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n  1125\t\t}\n  1126\t\tif !attempt.Active && !f.dryRun {\n  1127\t\t\t// An attempt whose dispatch, or whose earlier release, ended before\n  1128\t\t\t// its receipt is released with a failed run and its receipt, so it\n  1129\t\t\t// stops blocking the bundle; the release proves the abandonment\n  1130\t\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n  1131\t\t\t// review round 4, N1).\n  1132\t\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n  1133\t\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n  1134\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1135\t\t\t}\n  1136\t\t\tif err != nil {\n  1137\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1138\t\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1139\t\t\t}\n  1140\t\t\tif f.jsonOut {\n  1141\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n  1142\t\t\t\treturn 0\n  1143\t\t\t}\n  1144\t\t\tout := render(stdout, stderr)\n  1145\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1146\t\t\tswitch {\n  1147\t\t\tcase run.RunID == \"\":\n  1148\t\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n  1149\t\t\tcase run.Status == posemodel.ReviewRunFailed && strings.HasPrefix(run.Failure, posemodel.DelegationAbandonedCause):\n  1150\t\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n  1151\t\t\tdefault:\n  1152\t\t\t\t// The attempt had a run already: its receipt was completed with\n  1153\t\t\t\t// it (review round 11, N3).\n  1154\t\t\t\tout.Field(\"delegate.released\", tr(\"true: completed with run \"+run.RunID+\", already recorded as \"+run.Status, \"true: concluída com o run \"+run.RunID+\", já registrado como \"+run.Status))\n  1155\t\t\t}\n  1156\t\t\treturn 0\n  1157\t\t}\n  1158\t\tif !attempt.Active {\n  1159\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1160\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1161\t\t}\n  1162\t\tif f.dryRun {\n  1163\t\t\tif f.jsonOut {\n  1164\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": false, \"dry_run\": true, \"owner\": attempt.Liveness})\n  1165\t\t\t\treturn 0\n  1166\t\t\t}\n  1167\t\t\tout := render(stdout, stderr)\n  1168\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1169\t\t\tout.Field(\"delegate.owner\", attempt.Liveness)\n  1170\t\t\tout.Field(\"delegate.dry_run\", tr(\"true (no cancellation requested)\", \"true (nenhum cancelamento pedido)\"))\n  1171\t\t\treturn 0\n  1172\t\t}\n  1173\t\tmarker, err := store.RequestDelegationCancel(attempt.AttemptID)\n  1174\t\tif err != nil {\n  1175\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1176\t\t}\n  1177\t\tdeadline := time.Now().Add(60 * time.Second)\n  1178\t\tfor store.DelegationRunActive(marker) && time.Now().Before(deadline) {\n  1179\t\t\ttime.Sleep(200 * time.Millisecond)\n  1180\t\t}\n  1181\t\tstopped := !store.DelegationRunActive(marker)\n  1182\t\tstatus, run := \"\", \"\"\n  1183\t\tif after, _, err := store.ListDelegationAttempts(); err == nil {\n  1184\t\t\tfor _, a := range after {\n  1185\t\t\t\tif a.AttemptID == attempt.AttemptID && a.Latest() != nil {\n  1186\t\t\t\t\tstatus, run = a.Latest().Status, a.Latest().RunID\n  1187\t\t\t\t}\n  1188\t\t\t}\n  1189\t\t}\n  1190\t\tif f.jsonOut {\n  1191\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": true, \"stopped\": stopped, \"run\": run, \"status\": status})\n  1192\t\t} else {\n  1193\t\t\tout := render(stdout, stderr)\n  1194\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1195\t\t\tout.Field(\"delegate.cancel\", tr(\"requested\", \"pedido\"))\n  1196\t\t\tout.Field(\"delegate.stopped\", fmt.Sprint(stopped))\n  1197\t\t\tif run != \"\" {\n  1198\t\t\t\tout.Field(\"delegate.run\", run)\n  1199\t\t\t\tout.Field(\"delegate.status\", status)\n  1200\t\t\t}\n  1201\t\t}\n  1202\t\tif !stopped {\n  1203\t\t\treturn 1\n  1204\t\t}\n  1205\t\treturn 0\n  1206\t}\n  1207\t\n  1208\t// withDelegationLosses names what the listing could not read beside a run it\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n   206\t\tfor _, key := range order {\n   207\t\t\tout = append(out, *byAttempt[key])\n   208\t\t}\n   209\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   210\t\treturn out, lost, nil\n   211\t}\n   212\t\n   213\tfunc delegationStepText(e DelegationEvent) string {\n   214\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   215\t\tif len(text) > 80 {\n   216\t\t\tcut := 77\n   217\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   218\t\t\t\tcut--\n   219\t\t\t}\n   220\t\t\ttext = text[:cut] + \"...\"\n","exit_code":0,"status":"completed"}}
