{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_reap_linux.go && nl -ba pose-mcp/internal/pose/review_reap_other.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Leftover reviewer processes, the fallback of an embedder that does not run\n     6\t// the adapter under the review run shim (review_shim.go), which is the Linux\n     7\t// path of the pose command (spec\n     8\t// pose-review-run-reaps-lingering-reviewer-processes R1, L6): an adapter such as\n     9\t// `codex exec` runs each command in a session of its own, so killing the\n    10\t// adapter's process group misses a command the reviewer left running, and\n    11\t// that command keeps writing into the run's runtime directory while the\n    12\t// cleanup inventory reads it. Every process of the run inherits\n    13\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n    14\t// that entry, ends them and waits for them before the inventory.\n    15\t//\n    16\t// Each process is pinned by a pidfd before it is signalled, and its\n    17\t// environment is read again through the pinned process, so a pid reused by\n    18\t// an unrelated process between the scan and the signal is never killed\n    19\t// (review round 1, N3). A scan that cannot list or read the state of the\n    20\t// processes fails. A process of this user whose environment cannot be read\n    21\t// (one that made itself non-inspectable) cannot be matched: one that already\n    22\t// existed before the adapter started is not the run's and is skipped; any\n    23\t// other may be the run's, so the scan fails and the run stays unconcludable\n    24\t// (review round 2, N2).\n    25\t\n    26\timport (\n    27\t\t\"bytes\"\n    28\t\t\"errors\"\n    29\t\t\"fmt\"\n    30\t\t\"io/fs\"\n    31\t\t\"os\"\n    32\t\t\"path/filepath\"\n    33\t\t\"strconv\"\n    34\t\t\"strings\"\n    35\t\t\"syscall\"\n    36\t\t\"time\"\n    37\t\n    38\t\t\"golang.org/x/sys/unix\"\n    39\t)\n    40\t\n    41\t// reapSealedCheckoutProcesses ends every process whose environment names\n    42\t// worktree as its sealed checkout and returns a description of each. An\n    43\t// error means the run's processes could not be proven ended within the bound.\n    44\tfunc reapSealedCheckoutProcesses(worktree string, baseline map[int]string) ([]string, int, error) {\n    45\t\tif worktree == \"\" {\n    46\t\t\treturn nil, 0, nil\n    47\t\t}\n    48\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n    49\t\tvar reaped []string\n    50\t\tseen := map[int]bool{}\n    51\t\tdeadline := time.Now().Add(reviewReapWait)\n    52\t\tunreadable := 0\n    53\t\tfor {\n    54\t\t\talive, opaque, err := reviewMarkedProcesses(entry)\n    55\t\t\tif err != nil {\n    56\t\t\t\treturn reaped, unreadable, err\n    57\t\t\t}\n    58\t\t\tunreadable = 0\n    59\t\t\tfor pid, start := range opaque {\n    60\t\t\t\tif prior, ok := baseline[pid]; !ok || prior != start {\n    61\t\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"process %d of this user started during the run and cannot be inspected; it may be the run's and was not ended\", pid)\n    62\t\t\t\t}\n    63\t\t\t\tunreadable++\n    64\t\t\t}\n    65\t\t\tfor _, pid := range alive {\n    66\t\t\t\tif !seen[pid] {\n    67\t\t\t\t\tseen[pid] = true\n    68\t\t\t\t\t// Only the pid: the name is the reviewer's to choose and is not\n    69\t\t\t\t\t// recorded (review round 7, N4).\n    70\t\t\t\t\treaped = append(reaped, strconv.Itoa(pid))\n    71\t\t\t\t}\n    72\t\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n    73\t\t\t\t\treturn reaped, unreadable, err\n    74\t\t\t\t}\n    75\t\t\t}\n    76\t\t\tif len(alive) == 0 {\n    77\t\t\t\treturn reaped, unreadable, nil\n    78\t\t\t}\n    79\t\t\tif time.Now().After(deadline) {\n    80\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n    81\t\t\t}\n    82\t\t\ttime.Sleep(50 * time.Millisecond)\n    83\t\t}\n    84\t}\n    85\t\n    86\t// reviewMarkedProcesses lists the live processes whose environment holds\n    87\t// entry, and counts this user's processes whose environment could not be\n    88\t// read. A process that is gone is skipped.\n    89\tfunc reviewMarkedProcesses(entry []byte) ([]int, map[int]string, error) {\n    90\t\tdirs, err := os.ReadDir(\"/proc\")\n    91\t\tif err != nil {\n    92\t\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    93\t\t}\n    94\t\tunreadable := map[int]string{}\n    95\t\tself, uid := os.Getpid(), os.Getuid()\n    96\t\tvar out []int\n    97\t\tfor _, d := range dirs {\n    98\t\t\tpid, err := strconv.Atoi(d.Name())\n    99\t\t\tif err != nil || pid == self {\n   100\t\t\t\tcontinue\n   101\t\t\t}\n   102\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n   103\t\t\tswitch {\n   104\t\t\tcase reviewProcessGoneErr(err):\n   105\t\t\t\tcontinue\n   106\t\t\tcase err != nil:\n   107\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n   108\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n   109\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   110\t\t\t\t\tcontinue\n   111\t\t\t\t}\n   112\t\t\t\tstart, serr := processStartTime(pid)\n   113\t\t\t\tif reviewProcessGoneErr(serr) {\n   114\t\t\t\t\tcontinue\n   115\t\t\t\t}\n   116\t\t\t\tif serr != nil || start == \"\" {\n   117\t\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d start could not be read: %v\", pid, serr)\n   118\t\t\t\t}\n   119\t\t\t\tunreadable[pid] = start\n   120\t\t\t\tcontinue\n   121\t\t\tcase !marked:\n   122\t\t\t\tcontinue\n   123\t\t\t}\n   124\t\t\tzombie, err := reviewProcessZombie(pid)\n   125\t\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n   126\t\t\t\tcontinue\n   127\t\t\t}\n   128\t\t\tif err != nil {\n   129\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n   130\t\t\t}\n   131\t\t\tout = append(out, pid)\n   132\t\t}\n   133\t\treturn out, unreadable, nil\n   134\t}\n   135\t\n   136\t// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n   137\t// after the environment read through that same pinned process still holds\n   138\t// entry.\n   139\tfunc killPinnedMarkedProcess(pid int, entry []byte) error {\n   140\t\tfd, err := unix.PidfdOpen(pid, 0)\n   141\t\tif errors.Is(err, unix.ESRCH) {\n   142\t\t\treturn nil\n   143\t\t}\n   144\t\tif err != nil {\n   145\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   146\t\t}\n   147\t\tdefer unix.Close(fd)\n   148\t\t// The pidfd names one process for its lifetime; if pid was reused before\n   149\t\t// it was opened, the new process does not carry this run's entry.\n   150\t\tmarked, err := reviewProcessMarked(pid, entry)\n   151\t\tif reviewProcessGoneErr(err) || err == nil && !marked {\n   152\t\t\treturn nil\n   153\t\t}\n   154\t\tif err != nil {\n   155\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   156\t\t}\n   157\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   158\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   159\t\t}\n   160\t\treturn nil\n   161\t}\n   162\t\n   163\tfunc reviewProcessMarked(pid int, entry []byte) (bool, error) {\n   164\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   165\t\tif err != nil {\n   166\t\t\treturn false, err\n   167\t\t}\n   168\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n   169\t\t\tif bytes.Equal(kv, entry) {\n   170\t\t\t\treturn true, nil\n   171\t\t\t}\n   172\t\t}\n   173\t\treturn false, nil\n   174\t}\n   175\t\n   176\tfunc reviewProcessOwner(pid int) (int, error) {\n   177\t\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n   178\t\tif err != nil {\n   179\t\t\treturn 0, err\n   180\t\t}\n   181\t\tst, ok := info.Sys().(*syscall.Stat_t)\n   182\t\tif !ok {\n   183\t\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n   184\t\t}\n   185\t\treturn int(st.Uid), nil\n   186\t}\n   187\t\n   188\tfunc reviewProcessGoneErr(err error) bool {\n   189\t\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n   190\t}\n   191\t\n   192\tfunc reviewProcessName(pid int) string {\n   193\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n   194\t\tif err != nil {\n   195\t\t\treturn \"?\"\n   196\t\t}\n   197\t\treturn strings.TrimSpace(string(raw))\n   198\t}\n   199\t\n   200\tfunc reviewProcessZombie(pid int) (bool, error) {\n   201\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n   202\t\tif err != nil {\n   203\t\t\treturn false, err\n   204\t\t}\n   205\t\t// The state follows the parenthesised command name.\n   206\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   207\t\t\treturn raw[i+2] == 'Z', nil\n   208\t\t}\n   209\t\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n   210\t}\n   211\t\n   212\t// reviewOpaqueProcessBaseline records, before the adapter starts, the\n   213\t// processes of this user whose environment cannot be read, by pid and start\n   214\t// time: they cannot be the run's.\n   215\tfunc reviewOpaqueProcessBaseline() map[int]string {\n   216\t\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv + \"=\\x00\"))\n   217\t\treturn opaque\n   218\t}\n     1\t//go:build !linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport \"os/exec\"\n     6\t\n     7\t// reapSealedCheckoutProcesses has no portable way to read another process's\n     8\t// environment; outside Linux the process-group kill is the only termination.\n     9\tfunc reapSealedCheckoutProcesses(string, map[int]string) ([]string, int, error) { return nil, 0, nil }\n    10\t\n    11\tfunc reviewOpaqueProcessBaseline() map[int]string { return nil }\n    12\t\n    13\t// RunReviewShim is the Linux review run shim; elsewhere it is not used.\n    14\tfunc RunReviewShim(args []string) int { return 125 }\n    15\t\n    16\tfunc parseReviewShimReport([]byte) (reviewShimReport, error) { return reviewShimReport{}, nil }\n    17\t\n    18\tfunc stopReviewShim(cmd *exec.Cmd) func() error { return cmd.Cancel }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go && rg -n 'releaseAbandoned|ReleaseAbandoned|orphanReservations|recordedAttemptRun|recordedAbandonmentRun|releaseLock|cancel' pose-mcp/internal/cli/delegate.go pose-mcp/internal/pose/delegation_list.go pose-mcp/internal/pose/review_attempt_ledger.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go && rg -n 'releaseAbandoned|ReleaseAbandoned|orphanReservations|recordedAttemptRun|recordedAbandonmentRun|releaseLock|cancel' pose-mcp/internal/cli/delegate.go pose-mcp/internal/pose/delegation_list.go pose-mcp/internal/pose/review_attempt_ledger.go\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"io\"\n    28\t\t\"os\"\n    29\t\t\"path/filepath\"\n    30\t\t\"strings\"\n    31\t\t\"time\"\n    32\t)\n    33\t\n    34\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    35\t// proven abandoned.\n    36\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    37\t\n    38\t// reviewOrphanReservationAge is how old a reservation without any marker\n    39\t// must be to count as abandoned.\n    40\tconst reviewOrphanReservationAge = 10 * time.Minute\n    41\t\n    42\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    43\t// dispatch ended before recording it, and removes its stalled marker. A\n    44\t// stalled marker whose reservation was never published is only removed; the\n    45\t// returned run is then empty.\n    46\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    47\t\tif !validAttemptFileName(attemptID) {\n    48\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    49\t\t}\n    50\t\tmarkers, _, err := s.ListDelegationActive()\n    51\t\tif err != nil {\n    52\t\t\treturn ReviewRun{}, err\n    53\t\t}\n    54\t\tvar marker *DelegationActiveRun\n    55\t\tfor i := range markers {\n    56\t\t\tif markers[i].AttemptID == attemptID {\n    57\t\t\t\tmarker = &markers[i]\n    58\t\t\t}\n    59\t\t}\n    60\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    61\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    62\t\t}\n    63\t\tdir, err := s.delegationActiveDir(true)\n    64\t\tif err != nil {\n    65\t\t\treturn ReviewRun{}, err\n    66\t\t}\n    67\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    68\t\tif err != nil {\n    69\t\t\treturn ReviewRun{}, err\n    70\t\t}\n    71\t\tdefer lock.Close()\n    72\t\tunlock, err := lockSpecTransferFile(lock)\n    73\t\tif err != nil {\n    74\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    75\t\t}\n    76\t\tdefer unlock()\n    77\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    78\t}\n    79\t\n    80\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    81\t\tvar reserved *DelegatedReviewAttempt\n    82\t\tif marker != nil {\n    83\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    84\t\t\tif err != nil {\n    85\t\t\t\treturn ReviewRun{}, err\n    86\t\t\t}\n    87\t\t\tfor i := range attempts {\n    88\t\t\t\tif attempts[i].AttemptID == attemptID {\n    89\t\t\t\t\treserved = &attempts[i]\n    90\t\t\t\t}\n    91\t\t\t}\n    92\t\t\tif reserved == nil {\n    93\t\t\t\t// The dispatch ended between its marker and its reservation:\n    94\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    95\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    96\t\t\t}\n    97\t\t} else {\n    98\t\t\tif !operatorConfirmed {\n    99\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n   100\t\t\t}\n   101\t\t\torphans, _, err := s.orphanReservations(now)\n   102\t\t\tif err != nil {\n   103\t\t\t\treturn ReviewRun{}, err\n   104\t\t\t}\n   105\t\t\tfor i := range orphans {\n   106\t\t\t\tif orphans[i].AttemptID == attemptID {\n   107\t\t\t\t\treserved = &orphans[i]\n   108\t\t\t\t}\n   109\t\t\t}\n   110\t\t\tif reserved == nil {\n   111\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   112\t\t\t}\n   113\t\t}\n   114\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   115\t\t\t// A release that stopped after the receipt completes by removing\n   116\t\t\t// the stalled marker; with no marker there is nothing to release.\n   117\t\t\tif marker != nil {\n   118\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   119\t\t\t\tif err != nil {\n   120\t\t\t\t\treturn ReviewRun{}, err\n   121\t\t\t\t}\n   122\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   123\t\t\t\tif err != nil {\n   124\t\t\t\t\treturn ReviewRun{}, err\n   125\t\t\t\t}\n   126\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   127\t\t\t}\n   128\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   129\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   130\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   131\t\t}\n   132\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   133\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   134\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   135\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   136\t\tif marker != nil {\n   137\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   138\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   139\t\t} else {\n   140\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   141\t\t}\n   142\t\t// A run the attempt already recorded, by its dispatch or by a release\n   143\t\t// interrupted before the receipt, completes the attempt; no second run\n   144\t\t// is written for it.\n   145\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   146\t\tif err != nil {\n   147\t\t\treturn ReviewRun{}, err\n   148\t\t}\n   149\t\tif !found {\n   150\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   151\t\t\t\treturn ReviewRun{}, err\n   152\t\t\t}\n   153\t\t}\n   154\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   155\t\t\treturn recorded, err\n   156\t\t}\n   157\t\tif marker != nil {\n   158\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   159\t\t}\n   160\t\treturn recorded, nil\n   161\t}\n   162\t\n   163\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   164\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   165\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   166\t\tif err != nil {\n   167\t\t\treturn ReviewRun{}, false, err\n   168\t\t}\n   169\t\tif len(lost) > 0 {\n   170\t\t\t// An unreadable run may be this release's: the history is unknown,\n   171\t\t\t// and the release does not write another (review round 4, N3).\n   172\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   173\t\t}\n   174\t\tvar latest *ReviewRun\n   175\t\tfor i := range runs {\n   176\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   177\t\t\t\tlatest = &runs[i]\n   178\t\t\t}\n   179\t\t}\n   180\t\tif latest == nil {\n   181\t\t\treturn ReviewRun{}, false, nil\n   182\t\t}\n   183\t\treturn *latest, true, nil\n   184\t}\n   185\t\n   186\t// orphanReservations lists the reservations left without a receipt or a\n   187\t// marker, older than reviewOrphanReservationAge, and\n   188\t// says which reservations or receipts it could not read (review round 3, N3).\n   189\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   190\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   191\t\tdirs, dirsTruncated, err := readDirBounded(base, reviewOrphanScanMaxEntries)\n   192\t\tif errors.Is(err, os.ErrNotExist) {\n   193\t\t\treturn nil, nil, nil\n   194\t\t}\n   195\t\tif err != nil {\n   196\t\t\treturn nil, nil, err\n   197\t\t}\n   198\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   199\t\tif err != nil {\n   200\t\t\treturn nil, nil, err\n   201\t\t}\n   202\t\tif len(markerLost) > 0 {\n   203\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   204\t\t\t// have no marker (review round 6, N1).\n   205\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   206\t\t}\n   207\t\tmarked := map[string]bool{}\n   208\t\tfor _, m := range markers {\n   209\t\t\tmarked[m.AttemptID] = true\n   210\t\t}\n   211\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   212\t\tif err != nil {\n   213\t\t\treturn nil, nil, err\n   214\t\t}\n   215\t\tif len(runLost) > 0 {\n   216\t\t\t// Without the whole run history nothing is known to have no run.\n   217\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   218\t\t}\n   219\t\t// A recorded run does not finish an attempt, its receipt does: a\n   220\t\t// reservation whose run was recorded without a receipt still blocks and\n   221\t\t// is released with that run (review round 5, N3).\n   222\t\t_ = runs\n   223\t\tvar out []DelegatedReviewAttempt\n   224\t\tvar lost []string\n   225\t\tbudget := reviewReadBudget(nil)\n   226\t\tfor _, d := range dirs {\n   227\t\t\tif !d.IsDir() {\n   228\t\t\t\tcontinue\n   229\t\t\t}\n   230\t\t\tentries, truncated, err := readDirBounded(filepath.Join(base, d.Name()), reviewOrphanScanMaxEntries)\n   231\t\t\tif err != nil {\n   232\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   233\t\t\t\tcontinue\n   234\t\t\t}\n   235\t\t\tif truncated {\n   236\t\t\t\tlost = append(lost, fmt.Sprintf(\"the reservations in %s exceed %d entries; the rest were not read\", d.Name(), reviewOrphanScanMaxEntries))\n   237\t\t\t}\n   238\t\t\tfor _, e := range entries {\n   239\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   240\t\t\t\t\tcontinue\n   241\t\t\t\t}\n   242\t\t\t\tvar a DelegatedReviewAttempt\n   243\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   248\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   249\t\t\t\t\tcontinue\n   250\t\t\t\t}\n   251\t\t\t\tif marked[a.AttemptID] {\n   252\t\t\t\t\tcontinue\n   253\t\t\t\t}\n   254\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   255\t\t\t\t\tcontinue\n   256\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   257\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   258\t\t\t\t\tcontinue\n   259\t\t\t\t}\n   260\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   261\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   262\t\t\t\t\tcontinue\n   263\t\t\t\t}\n   264\t\t\t\tout = append(out, a)\n   265\t\t\t}\n   266\t\t}\n   267\t\tif dirsTruncated {\n   268\t\t\tlost = append(lost, fmt.Sprintf(\"the attempt directories exceed %d entries; the rest were not read\", reviewOrphanScanMaxEntries))\n   269\t\t}\n   270\t\treturn out, lost, nil\n   271\t}\n   272\t\n   273\t// reviewOrphanScanMaxEntries bounds each directory the orphan scan lists\n   274\t// (review round 10, N2).\n   275\tconst reviewOrphanScanMaxEntries = 10000\n   276\t\n   277\t// readDirBounded lists at most max entries of dir and says whether more exist.\n   278\tfunc readDirBounded(dir string, max int) ([]os.DirEntry, bool, error) {\n   279\t\tf, err := os.Open(dir)\n   280\t\tif err != nil {\n   281\t\t\treturn nil, false, err\n   282\t\t}\n   283\t\tdefer f.Close()\n   284\t\tentries, err := f.ReadDir(max + 1)\n   285\t\tif err != nil && !errors.Is(err, io.EOF) {\n   286\t\t\treturn nil, false, err\n   287\t\t}\n   288\t\tif len(entries) > max {\n   289\t\t\treturn entries[:max], true, nil\n   290\t\t}\n   291\t\treturn entries, false, nil\n   292\t}\n   293\t\n   294\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   295\t\tdir, err := s.delegationActiveDir(false)\n   296\t\tif err != nil {\n   297\t\t\treturn err\n   298\t\t}\n   299\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   300\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   301\t\t\t\treturn err\n   302\t\t\t}\n   303\t\t}\n   304\t\treturn nil\n   305\t}\npose-mcp/internal/pose/review_attempt_ledger.go:357:\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\npose-mcp/internal/pose/review_attempt_ledger.go:438:// always leaves a marker that turns stalled and that `pose delegate cancel`\npose-mcp/internal/pose/review_attempt_ledger.go:528:\tctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)\npose-mcp/internal/pose/review_attempt_ledger.go:529:\tdefer cancel()\npose-mcp/internal/pose/delegation_list.go:44:\tCancelRequested bool   `json:\"cancel_requested,omitempty\"`\npose-mcp/internal/pose/delegation_list.go:177:\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\npose-mcp/internal/pose/delegation_list.go:192:\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\npose-mcp/internal/pose/delegation_list.go:201:\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\npose-mcp/internal/cli/delegate.go:36:const delegateUsageText = \"pose delegate <review|adjudicate|smoke|task|ls|watch|wait|resume|handoff|cancel|agents> [args] [--agent auto|<name>] [--access read|sandboxed|write|full] [--label <name>] [--lead <vendor>] [--dry-run] [--json]\"\npose-mcp/internal/cli/delegate.go:43:\tdelegateCancelSchema = \"pose.delegate.cancel/v1\"\npose-mcp/internal/cli/delegate.go:219:\tcase \"cancel\":\npose-mcp/internal/cli/delegate.go:1115:\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\npose-mcp/internal/cli/delegate.go:1120:\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\npose-mcp/internal/cli/delegate.go:1124:\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\npose-mcp/internal/cli/delegate.go:1132:\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\npose-mcp/internal/cli/delegate.go:1134:\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\npose-mcp/internal/cli/delegate.go:1137:\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\npose-mcp/internal/cli/delegate.go:1159:\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\npose-mcp/internal/cli/delegate.go:1170:\t\tout.Field(\"delegate.dry_run\", tr(\"true (no cancellation requested)\", \"true (nenhum cancelamento pedido)\"))\npose-mcp/internal/cli/delegate.go:1175:\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\npose-mcp/internal/cli/delegate.go:1195:\t\tout.Field(\"delegate.cancel\", tr(\"requested\", \"pedido\"))\n","exit_code":0,"status":"completed"}}
