{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux_test.go | sed -n '1,275p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os\"\n     7\t\t\"os/exec\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strconv\"\n    10\t\t\"strings\"\n    11\t\t\"syscall\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\t// Review round 1, N3: a pid that no longer names a process of the run, as\n    17\t// after reuse by an unrelated process, is never signalled.\n    18\tfunc TestAPidThatLostTheRunsEntryIsNotKilled(t *testing.T) {\n    19\t\tother := exec.Command(\"sleep\", \"30\")\n    20\t\tif err := other.Start(); err != nil {\n    21\t\t\tt.Fatal(err)\n    22\t\t}\n    23\t\tfor i := 0; i < 200 && reviewProcessName(other.Process.Pid) != \"sleep\"; i++ {\n    24\t\t\ttime.Sleep(10 * time.Millisecond)\n    25\t\t}\n    26\t\tt.Cleanup(func() { _ = other.Process.Kill(); _ = other.Wait() })\n    27\t\tentry := []byte(SealedCheckoutEnv + \"=/nonexistent/run-checkout\")\n    28\t\tif err := killPinnedMarkedProcess(other.Process.Pid, entry); err != nil {\n    29\t\t\tt.Fatal(err)\n    30\t\t}\n    31\t\ttime.Sleep(100 * time.Millisecond)\n    32\t\tif zombie, err := reviewProcessZombie(other.Process.Pid); err != nil || zombie {\n    33\t\t\tt.Fatalf(\"a process without the run's entry was killed: zombie=%t %v\", zombie, err)\n    34\t\t}\n    35\t\t// The same process carrying the entry is ended.\n    36\t\tmarked := exec.Command(\"sleep\", \"30\")\n    37\t\tmarked.Env = append(marked.Environ(), string(entry))\n    38\t\tif err := marked.Start(); err != nil {\n    39\t\t\tt.Fatal(err)\n    40\t\t}\n    41\t\t// Until exec, /proc shows the parent's environment.\n    42\t\tfor i := 0; i < 200; i++ {\n    43\t\t\tif ok, _ := reviewProcessMarked(marked.Process.Pid, entry); ok {\n    44\t\t\t\tbreak\n    45\t\t\t}\n    46\t\t\ttime.Sleep(10 * time.Millisecond)\n    47\t\t}\n    48\t\tif err := killPinnedMarkedProcess(marked.Process.Pid, entry); err != nil {\n    49\t\t\tt.Fatal(err)\n    50\t\t}\n    51\t\tif err := marked.Wait(); err == nil {\n    52\t\t\tt.Fatal(\"the marked process was not ended\")\n    53\t\t}\n    54\t}\n    55\t\n    56\t// opaqueProcess starts a process of this user whose environment cannot be\n    57\t// read (it makes itself non-dumpable), or skips without python3.\n    58\tfunc opaqueProcess(t *testing.T) *exec.Cmd {\n    59\t\tt.Helper()\n    60\t\tif _, err := exec.LookPath(\"python3\"); err != nil {\n    61\t\t\tt.Skip(\"python3 is not available\")\n    62\t\t}\n    63\t\tcmd := exec.Command(\"python3\", \"-c\", \"import ctypes,time; ctypes.CDLL(None).prctl(4,0,0,0,0); time.sleep(30)\")\n    64\t\tif err := cmd.Start(); err != nil {\n    65\t\t\tt.Fatal(err)\n    66\t\t}\n    67\t\tt.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })\n    68\t\tfor i := 0; i < 300; i++ {\n    69\t\t\tif _, err := reviewProcessMarked(cmd.Process.Pid, []byte(\"x\")); err != nil && !reviewProcessGoneErr(err) {\n    70\t\t\t\treturn cmd\n    71\t\t\t}\n    72\t\t\ttime.Sleep(10 * time.Millisecond)\n    73\t\t}\n    74\t\tt.Skip(\"the process never became non-inspectable\")\n    75\t\treturn nil\n    76\t}\n    77\t\n    78\t// Review round 2, N2: a non-inspectable process that existed before the run\n    79\t// is not the run's; one that started during it may be, and the scan fails\n    80\t// instead of reporting the run's processes ended.\n    81\tfunc TestANonInspectableProcessStartedDuringTheRunFailsTheScan(t *testing.T) {\n    82\t\tbefore := opaqueProcess(t)\n    83\t\tbaseline := reviewOpaqueProcessBaseline()\n    84\t\tif _, ok := baseline[before.Process.Pid]; !ok {\n    85\t\t\tt.Fatalf(\"the baseline misses process %d\", before.Process.Pid)\n    86\t\t}\n    87\t\tif _, opaque, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err != nil || opaque == 0 {\n    88\t\t\tt.Fatalf(\"a process that predates the run failed the scan or was not counted: %d %v\", opaque, err)\n    89\t\t}\n    90\t\tduring := opaqueProcess(t)\n    91\t\tif _, _, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err == nil || !strings.Contains(err.Error(), \"started during the run\") {\n    92\t\t\tt.Fatalf(\"process %d, started during the run, did not fail the scan: %v\", during.Process.Pid, err)\n    93\t\t}\n    94\t}\n    95\t\n    96\t// Review round 6, N2: a descendant that leaves the group, starts its own\n    97\t// session and clears its environment is still ended with the run.\n    98\tfunc TestAnOrphanThatClearedItsEnvironmentIsEnded(t *testing.T) {\n    99\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   100\t\t\tt.Skip(\"setsid is not available\")\n   101\t\t}\n   102\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   103\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   104\t\t\ta.Containment = containmentPolicy()\n   105\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & ` +\n   106\t\t\t\t`i=0; while [ ! -s \"$1\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`, \"sh\", pidFile}\n   107\t\t})\n   108\t\traw, err := os.ReadFile(pidFile)\n   109\t\tif err != nil {\n   110\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   111\t\t}\n   112\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   113\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   114\t\tif zombie, err := reviewProcessZombie(pid); err == nil && !zombie {\n   115\t\t\tt.Fatalf(\"the orphan that cleared its environment survived the run (status %s: %s)\", f.run.Status, f.run.Failure)\n   116\t\t}\n   117\t\tif f.run.Status != ReviewRunCompleted || !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), \"(orphaned)\") {\n   118\t\t\tt.Fatalf(\"the run did not complete naming the orphan: %s %s %v\", f.run.Status, f.run.Failure, f.run.Safety.Limitations)\n   119\t\t}\n   120\t\t// Review round 9, N1: the recorded limitation describes the shim, not an\n   121\t\t// environment match.\n   122\t\tif !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), \"the review run shim ends every process left in the run's subtree\") {\n   123\t\t\tt.Fatalf(\"the limitation does not describe the shim: %v\", f.run.Safety.Limitations)\n   124\t\t}\n   125\t\t// Review round 7, N4: the record names the pid, never the process name\n   126\t\t// the reviewer chose.\n   127\t\tfor _, limit := range f.run.Safety.Limitations {\n   128\t\t\tif strings.Contains(limit, \"(orphaned)\") && strings.Contains(limit, \" sh \") {\n   129\t\t\t\tt.Fatalf(\"the recorded limitation carries a process name: %q\", limit)\n   130\t\t\t}\n   131\t\t}\n   132\t\tif !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), strconv.Itoa(pid)+\" (orphaned)\") {\n   133\t\t\tt.Fatalf(\"the recorded limitation does not name the pid: %v\", f.run.Safety.Limitations)\n   134\t\t}\n   135\t}\n   136\t\n   137\t// waitGone waits for pid to end (or be a zombie) and reports whether it did.\n   138\tfunc waitGone(pid int, within time.Duration) bool {\n   139\t\tdeadline := time.Now().Add(within)\n   140\t\tfor time.Now().Before(deadline) {\n   141\t\t\tif zombie, err := reviewProcessZombie(pid); err != nil || zombie {\n   142\t\t\t\treturn true\n   143\t\t\t}\n   144\t\t\ttime.Sleep(50 * time.Millisecond)\n   145\t\t}\n   146\t\treturn false\n   147\t}\n   148\t\n   149\t// Review round 8, N2: the shim's report never goes through a path the\n   150\t// reviewer can write, and the reviewer does not inherit the report pipe.\n   151\tfunc TestTheAdapterDoesNotInheritTheShimReport(t *testing.T) {\n   152\t\tfds := filepath.Join(t.TempDir(), \"fds\")\n   153\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   154\t\t\ta.Containment = containmentPolicy()\n   155\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; ls /proc/$$/fd > \"$1\"; env | grep -c POSE_REVIEW_SHIM_REPORT >> \"$1\"; ls \"$TMPDIR\" >> \"$1\"; printf 'decision: approved\\n'`, \"sh\", fds}\n   156\t\t})\n   157\t\traw, err := os.ReadFile(fds)\n   158\t\tif err != nil || f.run.Status != ReviewRunCompleted {\n   159\t\t\tt.Fatalf(\"the probe did not run: %v %s %s\", err, f.run.Status, f.run.Failure)\n   160\t\t}\n   161\t\tlines := strings.Fields(string(raw))\n   162\t\tfor _, l := range lines {\n   163\t\t\tif l == \"3\" || strings.Contains(l, \"shim-report\") {\n   164\t\t\t\tt.Fatalf(\"the adapter sees the shim's report (%q): %s\", l, raw)\n   165\t\t\t}\n   166\t\t}\n   167\t}\n   168\t\n   169\t// Review round 8, N3: a timeout asks the shim to end the run's subtree, so an\n   170\t// orphan that cleared its environment does not outlive it.\n   171\tfunc TestATimeoutEndsTheRunsOrphans(t *testing.T) {\n   172\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   173\t\t\tt.Skip(\"setsid is not available\")\n   174\t\t}\n   175\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   176\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   177\t\t\ta.Containment = containmentPolicy()\n   178\t\t\ta.Timeout = \"2s\"\n   179\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & sleep 30`, \"sh\", pidFile}\n   180\t\t})\n   181\t\traw, err := os.ReadFile(pidFile)\n   182\t\tif err != nil {\n   183\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   184\t\t}\n   185\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   186\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   187\t\tif !waitGone(pid, 2*time.Second) {\n   188\t\t\tt.Fatal(\"an orphan outlived the run's timeout\")\n   189\t\t}\n   190\t}\n   191\t\n   192\t// Review round 8, N4: when the dispatcher ends, the shim ends the run's\n   193\t// subtree instead of leaving the reviewer running behind a dead owner.\n   194\tfunc TestTheShimEndsTheRunWhenItsDispatcherEnds(t *testing.T) {\n   195\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   196\t\t\tt.Skip(\"setsid is not available\")\n   197\t\t}\n   198\t\tself, err := os.Executable()\n   199\t\tif err != nil {\n   200\t\t\tt.Fatal(err)\n   201\t\t}\n   202\t\tdir := t.TempDir()\n   203\t\torphanPid, shimPid := filepath.Join(dir, \"orphan.pid\"), filepath.Join(dir, \"shim.pid\")\n   204\t\tadapter := filepath.Join(dir, \"adapter.sh\")\n   205\t\tif err := os.WriteFile(adapter, []byte(\"#!/bin/sh\\nsetsid env -i /bin/sh -c 'echo $$ > \\\"$1\\\"; while :; do sleep 0.05; done' sh \\\"$1\\\" </dev/null >/dev/null 2>&1 &\\nsleep 30\\n\"), 0o755); err != nil {\n   206\t\t\tt.Fatal(err)\n   207\t\t}\n   208\t\t// A stand-in dispatcher starts the shim and ends once the run is going.\n   209\t\tscript := `export ` + ReviewShimReportEnv + `=$$; \"$1\" ` + ReviewShimArg + ` /bin/sh sh \"$4\" \"$2\" & echo $! > \"$3\"; ` +\n   210\t\t\t`i=0; while [ ! -s \"$2\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; exit 0`\n   211\t\t// No output pipe: waiting for one would wait for the shim that inherits it.\n   212\t\tdispatcher := exec.Command(\"sh\", \"-c\", script, \"sh\", self, orphanPid, shimPid, adapter)\n   213\t\tstarted := time.Now()\n   214\t\tif err := dispatcher.Run(); err != nil {\n   215\t\t\tt.Fatalf(\"the stand-in dispatcher failed: %v\", err)\n   216\t\t}\n   217\t\tif time.Since(started) > 10*time.Second {\n   218\t\t\tt.Fatal(\"the stand-in dispatcher waited for the run\")\n   219\t\t}\n   220\t\traw, err := os.ReadFile(orphanPid)\n   221\t\tif err != nil {\n   222\t\t\tt.Fatalf(\"the run never started: %v\", err)\n   223\t\t}\n   224\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   225\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   226\t\tif !waitGone(pid, 5*time.Second) {\n   227\t\t\tt.Fatal(\"the run outlived its dispatcher\")\n   228\t\t}\n   229\t}\n   230\t\n   231\t// Review round 11, N2: a child that already ended was not ended by the shim,\n   232\t// and killPinnedChild says so.\n   233\tfunc TestAChildThatAlreadyEndedIsNotReportedEnded(t *testing.T) {\n   234\t\tchild := exec.Command(\"true\")\n   235\t\tif err := child.Start(); err != nil {\n   236\t\t\tt.Fatal(err)\n   237\t\t}\n   238\t\tpid := child.Process.Pid\n   239\t\tfor i := 0; i < 200; i++ {\n   240\t\t\tif zombie, _ := reviewProcessZombie(pid); zombie {\n   241\t\t\t\tbreak\n   242\t\t\t}\n   243\t\t\ttime.Sleep(10 * time.Millisecond)\n   244\t\t}\n   245\t\tdelivered, err := killPinnedChild(pid, os.Getpid())\n   246\t\t_ = child.Wait()\n   247\t\tif err != nil || delivered {\n   248\t\t\tt.Fatalf(\"an ended child was reported as ended by the shim: delivered=%t %v\", delivered, err)\n   249\t\t}\n   250\t\tlive := exec.Command(\"sleep\", \"30\")\n   251\t\tif err := live.Start(); err != nil {\n   252\t\t\tt.Fatal(err)\n   253\t\t}\n   254\t\tdefer func() { _ = live.Process.Kill(); _ = live.Wait() }()\n   255\t\tif delivered, err := killPinnedChild(live.Process.Pid, os.Getpid()); err != nil || !delivered {\n   256\t\t\tt.Fatalf(\"a live child was not ended: delivered=%t %v\", delivered, err)\n   257\t\t}\n   258\t}\n","exit_code":0,"status":"completed"}}
