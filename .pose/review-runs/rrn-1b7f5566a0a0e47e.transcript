se-mcp/internal/pose/review_plan.go              |   6 +-\n pose-mcp/internal/pose/review_reap_linux.go        | 218 +++++++++\n pose-mcp/internal/pose/review_reap_linux_test.go   | 258 +++++++++++\n pose-mcp/internal/pose/review_reap_other.go        |  18 +\n pose-mcp/internal/pose/review_shim.go              |  63 +++\n pose-mcp/internal/pose/review_shim_linux.go        | 254 +++++++++++\n pose-mcp/internal/pose/review_shim_test.go         |  25 +\n pose-mcp/internal/pose/techdebt.go                 |   3 +\n .../testdata/review_brief_template_digests.json    |   4 +-\n pose-mcp/internal/scaffold/dist/POSE.md            |   8 +-\n .../internal/scaffold/dist/locales/pt-BR/POSE.md   |   8 +-\n 37 files changed, 2314 insertions(+), 65 deletions(-)\n","exit_code":0,"status":"completed"}}
