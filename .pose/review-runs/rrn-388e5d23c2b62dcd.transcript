{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D3r82pfUkqcJjoj4jEMzxu","type":"tool_result","content":"340\t}\n341\t\n342\t// roadmapReachedApartFrom leaves out one milestone: the close of its only member has\n343\t// just run and is not committed, so its verification cannot answer yet.\n344\tfunc (s Store) roadmapReachedApartFrom(slug, closing string) bool {\n345\t\trm, err := s.GetRoadmap(slug)\n346\t\tif err != nil || rm.Status == \"done\" || len(rm.Milestones) == 0 {\n347\t\t\treturn false\n348\t\t}\n349\t\tadopted, err := s.closeoutReviewPolicyAdopted()\n350\t\tif err != nil {\n351\t\t\treturn false\n352\t\t}\n353\t\tfor _, milestone := range rm.Milestones {\n354\t\t\tif milestone.ID == closing {\n355\t\t\t\tcontinue\n356\t\t\t}\n357\t\t\tif adopted {\n358\t\t\t\tif closed, err := s.closedByReceipt(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !closed {\n359\t\t\t\t\treturn false\n360\t\t\t\t}\n361\t\t\t\tcontinue\n362\t\t\t}\n363\t\t\tif approved, err := s.scopeApproved(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !approved {\n364\t\t\t\treturn false\n365\t\t\t}\n366\t\t}\n367\t\treturn true\n368\t}\n369\t\n370\t// startWarnings reports the milestones named in the after: of the milestones a spec\n371\t// belongs to that hold no approval. Other forms of after: are not milestones of this\n372\t// roadmap, and readiness answers for them. A warning never refuses, so what cannot be\n373\t// read is a warning too.\n374\tfunc (s Store) startWarnings(spec string) []string {\n375\t\troadmaps, err := s.ListRoadmaps()\n376\t\tif err != nil {\n377\t\t\treturn []string{\"the milestones before this spec could not be read: \" + err.Error()}\n378\t\t}\n379\t\tfound := map[string]string{}\n380\t\tfor _, rm := range roadmaps {\n381\t\t\tfor _, milestone := range rm.Milestones {\n382\t\t\t\tmember := false\n383\t\t\t\tfor _, raw := range milestone.Specs {\n384\t\t\t\t\tslug, external := s.canonicalMember(raw)\n385\t\t\t\t\tmember = member || !external && strings.TrimPrefix(slug, \"spec:\") == spec\n386\t\t\t\t}\n387\t\t\t\tif !member {\n388\t\t\t\t\tcontinue\n389\t\t\t\t}\n390\t\t\t\tfor _, after := range milestone.After {\n391\t\t\t\t\tif !strings.Contains(after, \":\") {\n392\t\t\t\t\t\tafter = \"milestone:\" + rm.Slug + \"/\" + after\n393\t\t\t\t\t}\n394\t\t\t\t\tref, err := ParseArtifactRef(after)\n395\t\t\t\t\tif err != nil || ref.Kind != \"milestone\" || ref.Project != \"\" {\n396\t\t\t\t\t\tcontinue\n397\t\t\t\t\t}\n398\t\t\t\t\tapproved, err := s.scopeApproved(after)\n399\t\t\t\t\t// Under an adopted closeout review policy a predecessor is\n400\t\t\t\t\t// closed by its explicit close, not by its approval or its\n401\t\t\t\t\t// exemption (review round 10, N35).\n402\t\t\t\t\tif adopted, adoptErr := s.closeoutReviewPolicyAdopted(); err == nil && adoptErr == nil && adopted {\n403\t\t\t\t\t\tapproved, err = s.closedByReceipt(after)\n404\t\t\t\t\t}\n405\t\t\t\t\tif err != nil {\n406\t\t\t\t\t\tfound[after] = after + \" comes before this spec and its approval could not be read: \" + err.Error()\n407\t\t\t\t\t} else if !approved {\n408\t\t\t\t\t\tfound[after] = after + \" comes before this spec and is not closed: pose close \" + after\n409\t\t\t\t\t}\n410\t\t\t\t}\n411\t\t\t}\n412\t\t}\n413\t\tout := make([]string, 0, len(found))\n414\t\tfor _, warning := range found {\n415\t\t\tout = append(out, warning)\n416\t\t}\n417\t\tsort.Strings(out)\n418\t\treturn out\n419\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"80cfd8a2-d724-424e-961a-193e3eb8c422","timestamp":"2026-11-18T04:00:11.554Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/p5.72rW0j/pose-review-run-3323286775/worktree/pose-mcp/internal/pose/roadmaps.go","content":"}\n\n// roadmapReachedApartFrom leaves out one milestone: the close of its only member has\n// just run and is not committed, so its verification cannot answer yet.\nfunc (s Store) roadmapReachedApartFrom(slug, closing string) bool {\n\trm, err := s.GetRoadmap(slug)\n\tif err != nil || rm.Status == \"done\" || len(rm.Milestones) == 0 {\n\t\treturn false\n\t}\n\tadopted, err := s.closeoutReviewPolicyAdopted()\n\tif err != nil {\n\t\treturn false\n\t}\n\tfor _, milestone := range rm.Milestones {\n\t\tif milestone.ID == closing {\n\t\t\tcontinue\n\t\t}\n\t\tif adopted {\n\t\t\tif closed, err := s.closedByReceipt(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !closed {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif approved, err := s.scopeApproved(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !approved {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// startWarnings reports the milestones named in the after: of the milestones a spec\n// belongs to that hold no approval. Other forms of after: are not milestones of this\n// roadmap, and readiness answers for them. A warning never refuses, so what cannot be\n// read is a warning too.\nfunc (s Store) startWarnings(spec string) []string {\n\troadmaps, err := s.ListRoadmaps()\n\tif err != nil {\n\t\treturn []string{\"the milestones before this spec could not be read: \" + err.Error()}\n\t}\n\tfound := map[string]string{}\n\tfor _, rm := range roadmaps {\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tmember := false\n\t\t\tfor _, raw := range milestone.Specs {\n\t\t\t\tslug, external := s.canonicalMember(raw)\n\t\t\t\tmember = member || !external && strings.TrimPrefix(slug, \"spec:\") == spec\n\t\t\t}\n\t\t\tif !member {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfor _, after := range milestone.After {\n\t\t\t\tif !strings.Contains(after, \":\") {\n\t\t\t\t\tafter = \"milestone:\" + rm.Slug + \"/\" + after\n\t\t\t\t}\n\t\t\t\tref, err := ParseArtifactRef(after)\n\t\t\t\tif err != nil || ref.Kind != \"milestone\" || ref.Project != \"\" {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tapproved, err := s.scopeApproved(after)\n\t\t\t\t// Under an adopted closeout review policy a predecessor is\n\t\t\t\t// closed by its explicit close, not by its approval or its\n\t\t\t\t// exemption (review round 10, N35).\n\t\t\t\tif adopted, adoptErr := s.closeoutReviewPolicyAdopted(); err == nil && adoptErr == nil && adopted {\n\t\t\t\t\tapproved, err = s.closedByReceipt(after)\n\t\t\t\t}\n\t\t\t\tif err != nil {\n\t\t\t\t\tfound[after] = after + \" comes before this spec and its approval could not be read: \" + err.Error()\n\t\t\t\t} else if !approved {\n\t\t\t\t\tfound[after] = after + \" comes before this spec and is not closed: pose close \" + after\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tout := make([]string, 0, len(found))\n\tfor _, warning := range found {\n\t\tout = append(out, warning)\n\t}\n\tsort.Strings(out)\n\treturn out\n}","numLines":80,"startLine":340,"totalLines":544}},"tool_result_meta":[{"id":"toolu_01D3r82pfUkqcJjoj4jEMzxu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
