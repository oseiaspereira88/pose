{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NbzkyqiK2otcA43LfE3Bge","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"sync\"\n5\t\t\"time\"\n6\t)\n7\t\n8\tconst (\n9\t\tdoctorMemoMaxEntries      = 2048\n10\t\tdoctorMemoMaxVisited      = 256\n11\t\tdoctorMemoMaxTotalVisited = 32768\n12\t)\n13\t\n14\t// This memo belongs only to CloseoutReviewsOwed's callback, not to the Store\n15\t// or even to the surrounding review operation. It retains only approvals:\n16\t// terminal verification also turns some errors into false, so false is never\n17\t// cached. An incomplete trace, a cycle or a project crossing disqualifies all\n18\t// enclosing computations. Limits fall back to the original verifier.\n19\ttype doctorCloseoutMemo struct {\n20\t\tmu      sync.Mutex\n21\t\tview    *reviewOperationView\n22\t\tat      time.Time\n23\t\tclosed  bool\n24\t\tentries map[string]doctorCloseoutEntry\n25\t\tvisited int\n26\t\t// Test observation of real verifier invocations; never substitutes a result.\n27\t\tonCompute func(string)\n28\t}\n29\t\n30\ttype doctorCloseoutEntry struct{ visited []string }\n31\t\n32\ttype doctorCloseoutTrace struct {\n33\t\tmu      sync.Mutex\n34\t\tvisited map[string]bool\n35\t\tcut     bool\n36\t}\n37\t\n38\t// AggregateDependencyClosed traces aggregate crossings. Remote spec proofs\n39\t// also use source stores, with their own clocks; exclude them before retaining\n40\t// an approval. The manifest keeps the named identity, so resolve its canonical\n41\t// destination too (a local name can redirect to another project). This reads\n42\t// through the same bound resolver snapshots and capture as the verifier.\n43\tfunc (s Store) traceDoctorCloseoutSources(state CloseoutState) {\n44\t\tif s.closeoutTrace == nil || !state.Terminal || state.FederatedAcceptance == nil {\n45\t\t\treturn\n46\t\t}\n47\t\tfor _, dep := range state.FederatedAcceptance.Manifest.Dependencies {\n48\t\t\tresolved := s.FederatedResolver.Resolve(s.FederatedProjectID, dep.Ref)\n49\t\t\tidentity := resolved.Identity\n50\t\t\tif resolved.CanonicalIdentity != nil {\n51\t\t\t\tidentity = *resolved.CanonicalIdentity\n52\t\t\t}\n53\t\t\tif !resolved.Resolved || identity.Project != s.FederatedProjectID {\n54\t\t\t\ts.closeoutTrace.visit(\"\", true)\n55\t\t\t\treturn\n56\t\t\t}\n57\t\t}\n58\t}\n59\t\n60\tfunc (t *doctorCloseoutTrace) visit(scope string, cut bool) {\n61\t\tif t == nil {\n62\t\t\treturn\n63\t\t}\n64\t\tt.mu.Lock()\n65\t\tdefer t.mu.Unlock()\n66\t\tt.cut = t.cut || cut\n67\t\tif scope == \"\" || t.visited[scope] {\n68\t\t\treturn\n69\t\t}\n70\t\tif len(t.visited) >= doctorMemoMaxVisited {\n71\t\t\tt.cut = true\n72\t\t\treturn\n73\t\t}\n74\t\tt.visited[scope] = true\n75\t}\n76\t\n77\tfunc (t *doctorCloseoutTrace) snapshot() ([]string, bool) {\n78\t\tt.mu.Lock()\n79\t\tdefer t.mu.Unlock()\n80\t\tvisited := make([]string, 0, len(t.visited))\n81\t\tfor scope := range t.visited {\n82\t\t\tvisited = append(visited, scope)\n83\t\t}\n84\t\treturn visited, t.cut\n85\t}\n86\t\n87\tfunc (t *doctorCloseoutTrace) merge(visited []string, cut bool) {\n88\t\tt.visit(\"\", cut)\n89\t\tfor _, scope := range visited {\n90\t\t\tt.visit(scope, false)\n91\t\t}\n92\t}\n93\t\n94\tfunc (s Store) withDoctorCloseoutMemo(run func(Store)) {\n95\t\t// Local review expiry/trust checks in this diagnostic observe the instant\n96\t\t// the query starts (or its explicitly supplied review clock). They still\n97\t\t// use current authority and the normal final input audit. The next query\n98\t\t// gets a fresh clock and capture; this is no extension of a review budget.\n99\t\t// Remote proofs keep their original clock handling and are not memoized.\n100\t\ts.doctorCloseoutMemo, s.closeoutTrace = nil, nil\n101\t\tif s.reviewView == nil || !s.reviewView.boundTo(s) ||\n102\t\t\ts.FederatedResolver == nil || s.FederatedResolver.Roots == nil ||\n103\t\t\ts.FederatedResolver.Authorize != nil {\n104\t\t\t// A dynamic authorization callback must be asked on every traversal.\n105\t\t\trun(s)\n106\t\t\treturn\n107\t\t}\n108\t\t// Fallback retains its existing clock semantics, including a live clock.\n109\t\ts = s.atReviewTime(s.reviewClock())\n110\t\tm := &doctorCloseoutMemo{view: s.reviewView, at: s.reviewClock(), entries: map[string]doctorCloseoutEntry{}}\n111\t\ts.doctorCloseoutMemo = m\n112\t\tdefer func() {\n113\t\t\tm.mu.Lock()\n114\t\t\tdefer m.mu.Unlock()\n115\t\t\tm.closed, m.entries, m.visited = true, nil, 0\n116\t\t}()\n117\t\trun(s)\n118\t}\n119\t\n120\tfunc (s Store) doctorMemoClosedByReceipt(ref string) (bool, error) {\n121\t\tm := s.doctorCloseoutMemo\n122\t\tif m == nil || s.reviewView != m.view || !m.view.boundTo(s) ||\n123\t\t\ts.reviewTime == nil || !s.reviewTime.Equal(m.at) || s.indexMaterial || s.planWithoutCloseoutGate ||\n124\t\t\ts.FederatedResolver == nil || s.FederatedResolver.Authorize != nil {\n125\t\t\t// A child under an incompatible context cannot leave a reusable parent.\n126\t\t\ts.closeoutTrace.visit(\"\", true)\n127\t\t\treturn s.computeClosedByReceipt(ref)\n128\t\t}\n129\t\treadView, _ := governanceReadViewFromFiles(s.fsys())\n130\t\tif readView == nil {\n131\t\t\ts.closeoutTrace.visit(\"\", true)\n132\t\t\treturn s.computeClosedByReceipt(ref)\n133\t\t}\n134\t\treadView.mu.Lock()\n135\t\tfinalized := readView.closed\n136\t\treadView.mu.Unlock()\n137\t\tif finalized {\n138\t\t\ts.closeoutTrace.visit(\"\", true)\n139\t\t\treturn s.computeClosedByReceipt(ref)\n140\t\t}\n141\t\tkey := m.view.root + \"\\x00\" + m.view.project + \"\\x00\" + ref\n142\t\tm.mu.Lock()\n143\t\tif m.closed {\n144\t\t\tm.mu.Unlock()\n145\t\t\treturn s.computeClosedByReceipt(ref)\n146\t\t}\n147\t\tentry, hit := m.entries[key]\n148\t\tif hit {\n149\t\t\tfor _, ancestor := range s.closeoutChain {\n150\t\t\t\tfor _, visited := range entry.visited {\n151\t\t\t\t\tif ancestor == visited {\n152\t\t\t\t\t\thit = false\n153\t\t\t\t\t\tbreak\n154\t\t\t\t\t}\n155\t\t\t\t}\n156\t\t\t\tif !hit {\n157\t\t\t\t\tbreak\n158\t\t\t\t}\n159\t\t\t}\n160\t\t}\n161\t\tm.mu.Unlock()\n162\t\tif hit {\n163\t\t\ts.closeoutTrace.merge(entry.visited, false)\n164\t\t\treturn true, nil\n165\t\t}\n166\t\tparent := s.closeoutTrace\n167\t\ttrace := &doctorCloseoutTrace{visited: map[string]bool{}}\n168\t\ttrace.visit(ref, false)\n169\t\ts.closeoutTrace = trace\n170\t\t// Never hold a memo/trace lock (or Once) over recursive verification.\n171\t\tif m.onCompute != nil {\n172\t\t\tm.onCompute(ref)\n173\t\t}\n174\t\tclosed, err := s.computeClosedByReceipt(ref)\n175\t\tvisited, cut := trace.snapshot()\n176\t\tparent.merge(visited, cut || err != nil)\n177\t\tif closed && err == nil && !cut {\n178\t\t\tm.mu.Lock()\n179\t\t\tif _, exists := m.entries[key]; !m.closed && !exists &&\n180\t\t\t\tlen(m.entries) < doctorMemoMaxEntries && m.visited+len(visited) <= doctorMemoMaxTotalVisited {\n181\t\t\t\tm.entries[key] = doctorCloseoutEntry{visited: visited}\n182\t\t\t\tm.visited += len(visited)\n183\t\t\t}\n184\t\t\tm.mu.Unlock()\n185\t\t}\n186\t\treturn closed, err\n187\t}\n188\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"c2f6a356-ac5c-4193-a121-d2791ad2f5ea","timestamp":"2026-11-18T03:59:35.329Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/p5.72rW0j/pose-review-run-3323286775/worktree/pose-mcp/internal/pose/doctor_closeout_memo.go","content":"package pose\n\nimport (\n\t\"sync\"\n\t\"time\"\n)\n\nconst (\n\tdoctorMemoMaxEntries      = 2048\n\tdoctorMemoMaxVisited      = 256\n\tdoctorMemoMaxTotalVisited = 32768\n)\n\n// This memo belongs only to CloseoutReviewsOwed's callback, not to the Store\n// or even to the surrounding review operation. It retains only approvals:\n// terminal verification also turns some errors into false, so false is never\n// cached. An incomplete trace, a cycle or a project crossing disqualifies all\n// enclosing computations. Limits fall back to the original verifier.\ntype doctorCloseoutMemo struct {\n\tmu      sync.Mutex\n\tview    *reviewOperationView\n\tat      time.Time\n\tclosed  bool\n\tentries map[string]doctorCloseoutEntry\n\tvisited int\n\t// Test observation of real verifier invocations; never substitutes a result.\n\tonCompute func(string)\n}\n\ntype doctorCloseoutEntry struct{ visited []string }\n\ntype doctorCloseoutTrace struct {\n\tmu      sync.Mutex\n\tvisited map[string]bool\n\tcut     bool\n}\n\n// AggregateDependencyClosed traces aggregate crossings. Remote spec proofs\n// also use source stores, with their own clocks; exclude them before retaining\n// an approval. The manifest keeps the named identity, so resolve its canonical\n// destination too (a local name can redirect to another project). This reads\n// through the same bound resolver snapshots and capture as the verifier.\nfunc (s Store) traceDoctorCloseoutSources(state CloseoutState) {\n\tif s.closeoutTrace == nil || !state.Terminal || state.FederatedAcceptance == nil {\n\t\treturn\n\t}\n\tfor _, dep := range state.FederatedAcceptance.Manifest.Dependencies {\n\t\tresolved := s.FederatedResolver.Resolve(s.FederatedProjectID, dep.Ref)\n\t\tidentity := resolved.Identity\n\t\tif resolved.CanonicalIdentity != nil {\n\t\t\tidentity = *resolved.CanonicalIdentity\n\t\t}\n\t\tif !resolved.Resolved || identity.Project != s.FederatedProjectID {\n\t\t\ts.closeoutTrace.visit(\"\", true)\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc (t *doctorCloseoutTrace) visit(scope string, cut bool) {\n\tif t == nil {\n\t\treturn\n\t}\n\tt.mu.Lock()\n\tdefer t.mu.Unlock()\n\tt.cut = t.cut || cut\n\tif scope == \"\" || t.visited[scope] {\n\t\treturn\n\t}\n\tif len(t.visited) >= doctorMemoMaxVisited {\n\t\tt.cut = true\n\t\treturn\n\t}\n\tt.visited[scope] = true\n}\n\nfunc (t *doctorCloseoutTrace) snapshot() ([]string, bool) {\n\tt.mu.Lock()\n\tdefer t.mu.Unlock()\n\tvisited := make([]string, 0, len(t.visited))\n\tfor scope := range t.visited {\n\t\tvisited = append(visited, scope)\n\t}\n\treturn visited, t.cut\n}\n\nfunc (t *doctorCloseoutTrace) merge(visited []string, cut bool) {\n\tt.visit(\"\", cut)\n\tfor _, scope := range visited {\n\t\tt.visit(scope, false)\n\t}\n}\n\nfunc (s Store) withDoctorCloseoutMemo(run func(Store)) {\n\t// Local review expiry/trust checks in this diagnostic observe the instant\n\t// the query starts (or its explicitly supplied review clock). They still\n\t// use current authority and the normal final input audit. The next query\n\t// gets a fresh clock and capture; this is no extension of a review budget.\n\t// Remote proofs keep their original clock handling and are not memoized.\n\ts.doctorCloseoutMemo, s.closeoutTrace = nil, nil\n\tif s.reviewView == nil || !s.reviewView.boundTo(s) ||\n\t\ts.FederatedResolver == nil || s.FederatedResolver.Roots == nil ||\n\t\ts.FederatedResolver.Authorize != nil {\n\t\t// A dynamic authorization callback must be asked on every traversal.\n\t\trun(s)\n\t\treturn\n\t}\n\t// Fallback retains its existing clock semantics, including a live clock.\n\ts = s.atReviewTime(s.reviewClock())\n\tm := &doctorCloseoutMemo{view: s.reviewView, at: s.reviewClock(), entries: map[string]doctorCloseoutEntry{}}\n\ts.doctorCloseoutMemo = m\n\tdefer func() {\n\t\tm.mu.Lock()\n\t\tdefer m.mu.Unlock()\n\t\tm.closed, m.entries, m.visited = true, nil, 0\n\t}()\n\trun(s)\n}\n\nfunc (s Store) doctorMemoClosedByReceipt(ref string) (bool, error) {\n\tm := s.doctorCloseoutMemo\n\tif m == nil || s.reviewView != m.view || !m.view.boundTo(s) ||\n\t\ts.reviewTime == nil || !s.reviewTime.Equal(m.at) || s.indexMaterial || s.planWithoutCloseoutGate ||\n\t\ts.FederatedResolver == nil || s.FederatedResolver.Authorize != nil {\n\t\t// A child under an incompatible context cannot leave a reusable parent.\n\t\ts.closeoutTrace.visit(\"\", true)\n\t\treturn s.computeClosedByReceipt(ref)\n\t}\n\treadView, _ := governanceReadViewFromFiles(s.fsys())\n\tif readView == nil {\n\t\ts.closeoutTrace.visit(\"\", true)\n\t\treturn s.computeClosedByReceipt(ref)\n\t}\n\treadView.mu.Lock()\n\tfinalized := readView.closed\n\treadView.mu.Unlock()\n\tif finalized {\n\t\ts.closeoutTrace.visit(\"\", true)\n\t\treturn s.computeClosedByReceipt(ref)\n\t}\n\tkey := m.view.root + \"\\x00\" + m.view.project + \"\\x00\" + ref\n\tm.mu.Lock()\n\tif m.closed {\n\t\tm.mu.Unlock()\n\t\treturn s.computeClosedByReceipt(ref)\n\t}\n\tentry, hit := m.entries[key]\n\tif hit {\n\t\tfor _, ancestor := range s.closeoutChain {\n\t\t\tfor _, visited := range entry.visited {\n\t\t\t\tif ancestor == visited {\n\t\t\t\t\thit = false\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !hit {\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\tm.mu.Unlock()\n\tif hit {\n\t\ts.closeoutTrace.merge(entry.visited, false)\n\t\treturn true, nil\n\t}\n\tparent := s.closeoutTrace\n\ttrace := &doctorCloseoutTrace{visited: map[string]bool{}}\n\ttrace.visit(ref, false)\n\ts.closeoutTrace = trace\n\t// Never hold a memo/trace lock (or Once) over recursive verification.\n\tif m.onCompute != nil {\n\t\tm.onCompute(ref)\n\t}\n\tclosed, err := s.computeClosedByReceipt(ref)\n\tvisited, cut := trace.snapshot()\n\tparent.merge(visited, cut || err != nil)\n\tif closed && err == nil && !cut {\n\t\tm.mu.Lock()\n\t\tif _, exists := m.entries[key]; !m.closed && !exists &&\n\t\t\tlen(m.entries) < doctorMemoMaxEntries && m.visited+len(visited) <= doctorMemoMaxTotalVisited {\n\t\t\tm.entries[key] = doctorCloseoutEntry{visited: visited}\n\t\t\tm.visited += len(visited)\n\t\t}\n\t\tm.mu.Unlock()\n\t}\n\treturn closed, err\n}\n","numLines":188,"startLine":1,"totalLines":188}},"tool_result_meta":[{"id":"toolu_01NbzkyqiK2otcA43LfE3Bge","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
