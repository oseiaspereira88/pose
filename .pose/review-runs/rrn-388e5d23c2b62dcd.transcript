{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kw6CJkra6rEvcvhTLEbBES","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"fmt\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"reflect\"\n9\t\t\"strings\"\n10\t\t\"sync\"\n11\t\t\"testing\"\n12\t)\n13\t\n14\tfunc doctorResolverFixture(t *testing.T) (Store, string, string) {\n15\t\tt.Helper()\n16\t\tmain, source := t.TempDir(), t.TempDir()\n17\t\tfor _, root := range []string{main, source} {\n18\t\t\tfor i := 0; i < 6; i++ {\n19\t\t\t\tqualifiedFile(t, root, fmt.Sprintf(\"specs/member-%d.md\", i), fmt.Sprintf(\"---\\nslug: member-%d\\nstatus: done\\n---\\n\", i))\n20\t\t\t}\n21\t\t}\n22\t\tfederatedTestProject(t, main, \"proj.main\")\n23\t\tfederatedTestProject(t, source, \"proj.source\")\n24\t\tresolver := federatedTestResolver(\"proj.main\", \"proj.source\", main, source)\n25\t\treturn Store{Root: main, FederatedProjectID: \"proj.main\", FederatedResolver: &resolver}, main, source\n26\t}\n27\t\n28\tfunc TestDoctorResolverCatalogueIsSharedAndFresh(t *testing.T) {\n29\t\tstore, main, source := doctorResolverFixture(t)\n30\t\tcounts := map[string]int{}\n31\t\tvar mu sync.Mutex\n32\t\tprevious := specCatalogueListed\n33\t\tspecCatalogueListed = func(root string) { mu.Lock(); counts[filepath.Clean(root)]++; mu.Unlock() }\n34\t\tt.Cleanup(func() { specCatalogueListed = previous })\n35\t\trun := func(want string) {\n36\t\t\tt.Helper()\n37\t\t\tbefore := map[string]int{main: counts[main], source: counts[source]}\n38\t\t\tif err := store.WithReviewOperationView(func(shared Store) {\n39\t\t\t\tfor n := 0; n < 20; n++ {\n40\t\t\t\t\tfor _, project := range []string{\"proj.main\", \"proj.source\"} {\n41\t\t\t\t\t\tgot := shared.FederatedResolver.Resolve(\"proj.main\", \"xref:\"+project+\"/spec:member-0\")\n42\t\t\t\t\t\texpected := \"done\"\n43\t\t\t\t\t\tif project == \"proj.source\" {\n44\t\t\t\t\t\t\texpected = want\n45\t\t\t\t\t\t}\n46\t\t\t\t\t\tif !got.Resolved || got.Status != expected {\n47\t\t\t\t\t\t\tt.Fatalf(\"%s: %+v\", project, got)\n48\t\t\t\t\t\t}\n49\t\t\t\t\t}\n50\t\t\t\t}\n51\t\t\t}); err != nil {\n52\t\t\t\tt.Fatal(err)\n53\t\t\t}\n54\t\t\tfor _, root := range []string{main, source} {\n55\t\t\t\tif got := counts[root] - before[root]; got != 1 {\n56\t\t\t\t\tt.Fatalf(\"catalogue parses for %s = %d, want 1 per operation\", root, got)\n57\t\t\t\t}\n58\t\t\t}\n59\t\t}\n60\t\trun(\"done\")\n61\t\tpath := filepath.Join(source, \".pose/specs/member-0.md\")\n62\t\traw, err := os.ReadFile(path)\n63\t\tif err != nil {\n64\t\t\tt.Fatal(err)\n65\t\t}\n66\t\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"done\", \"draft\", 1)), 0600); err != nil {\n67\t\t\tt.Fatal(err)\n68\t\t}\n69\t\trun(\"draft\")\n70\t}\n71\t\n72\tfunc TestDoctorResolverCatalogueChangeFailsFinalAudit(t *testing.T) {\n73\t\tstore, _, source := doctorResolverFixture(t)\n74\t\terr := store.WithReviewOperationView(func(shared Store) {\n75\t\t\tref := \"xref:proj.source/spec:member-0\"\n76\t\t\tfirst := shared.FederatedResolver.Resolve(\"proj.main\", ref)\n77\t\t\tif !first.Resolved || first.Status != \"done\" {\n78\t\t\t\tt.Fatalf(\"first=%+v\", first)\n79\t\t\t}\n80\t\t\tpath := filepath.Join(source, \".pose/specs/member-0.md\")\n81\t\t\traw, e := os.ReadFile(path)\n82\t\t\tif e != nil {\n83\t\t\t\tt.Fatal(e)\n84\t\t\t}\n85\t\t\tinfo, e := os.Stat(path)\n86\t\t\tif e != nil {\n87\t\t\t\tt.Fatal(e)\n88\t\t\t}\n89\t\t\tif e = os.WriteFile(path, []byte(strings.Replace(string(raw), \"done\", \"open\", 1)), 0600); e != nil {\n90\t\t\t\tt.Fatal(e)\n91\t\t\t}\n92\t\t\tif e = os.Chtimes(path, info.ModTime(), info.ModTime()); e != nil {\n93\t\t\t\tt.Fatal(e)\n94\t\t\t}\n95\t\t\tshared.FederatedResolver.Resolve(\"proj.main\", ref)\n96\t\t})\n97\t\tif !errors.Is(err, ErrGovernanceReadViewChanged) {\n98\t\t\tt.Fatalf(\"same-size/mtime change accepted: %v\", err)\n99\t\t}\n100\t}\n101\t\n102\t// A shared parse must not select a missing or conflicting identity, or bypass\n103\t// the resolver's authorization; compare the entire answer with the live path.\n104\tfunc TestDoctorResolverCataloguePreservesResolution(t *testing.T) {\n105\t\tfor _, mode := range []string{\"ordinary\", \"duplicate\", \"unauthorized\"} {\n106\t\t\tt.Run(mode, func(t *testing.T) {\n107\t\t\t\tstore, _, source := doctorResolverFixture(t)\n108\t\t\t\tif mode == \"duplicate\" {\n109\t\t\t\t\tqualifiedFile(t, source, \"specs/2026-11-17-member-0.md\", \"---\\nslug: member-0\\nstatus: done\\n---\\n\")\n110\t\t\t\t}\n111\t\t\t\tif mode == \"unauthorized\" {\n112\t\t\t\t\tstore.FederatedResolver.Authorize = func(project string) bool { return project != \"proj.source\" }\n113\t\t\t\t}\n114\t\t\t\trefs := []string{\"xref:proj.source/spec:member-0\", \"xref:proj.main/spec:member-1\", \"xref:proj.source/spec:missing\", \"xref:proj.absent/spec:member-0\"}\n115\t\t\t\twant := make([]ArtifactResolution, len(refs))\n116\t\t\t\tfor i, ref := range refs {\n117\t\t\t\t\twant[i] = store.FederatedResolver.Resolve(\"proj.main\", ref)\n118\t\t\t\t}\n119\t\t\t\terr := store.WithReviewOperationView(func(shared Store) {\n120\t\t\t\t\tfor round := 0; round < 2; round++ {\n121\t\t\t\t\t\tfor i, ref := range refs {\n122\t\t\t\t\t\t\tgot := shared.FederatedResolver.Resolve(\"proj.main\", ref)\n123\t\t\t\t\t\t\tif !reflect.DeepEqual(got, want[i]) {\n124\t\t\t\t\t\t\t\tt.Fatalf(\"%s: shared=%+v live=%+v\", ref, got, want[i])\n125\t\t\t\t\t\t\t}\n126\t\t\t\t\t\t}\n127\t\t\t\t\t}\n128\t\t\t\t})\n129\t\t\t\tif err != nil {\n130\t\t\t\t\tt.Fatal(err)\n131\t\t\t\t}\n132\t\t\t})\n133\t\t}\n134\t}\n135\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"614ed41d-9217-44ad-b508-8f19c11952ab","timestamp":"2026-11-18T04:08:41.431Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/p5.72rW0j/pose-review-run-3323286775/worktree/pose-mcp/internal/pose/doctor_resolver_specs_test.go","content":"package pose\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t