{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018dHeV8VqasS67pnXKiHe3A","type":"tool_result","content":"320\t\treturn canonical, true, \"\"\n321\t}\n322\t\n323\t// AggregateDependencyClosed reports whether a resolved dependency on a\n324\t// milestone or roadmap is closed, beyond the status its members give it:\n325\t// under the closeout review policy its owning project adopted, only the\n326\t// terminal projection closes it (an explicit close with its receipt, or a\n327\t// verified closure from before adoption). A spec, or an aggregate scope of a\n328\t// project still on the legacy rule, keeps its status contract. A transferred\n329\t// artifact is judged at its canonical destination; a project whose store or\n330\t// policy cannot be read is not proven closed (review round 7, N27).\n331\tfunc (s Store) AggregateDependencyClosed(resolver ArtifactResolver, localProject string, resolved ArtifactResolution) (bool, string) {\n332\t\tidentity := resolved.Identity\n333\t\tif resolved.CanonicalIdentity != nil {\n334\t\t\tidentity = *resolved.CanonicalIdentity\n335\t\t}\n336\t\tif identity.Kind != \"milestone\" && identity.Kind != \"roadmap\" || s.indexMaterial {\n337\t\t\treturn true, \"\"\n338\t\t}\n339\t\tif identity.Project == \"\" {\n340\t\t\tidentity.Project = localProject\n341\t\t}\n342\t\tscope := localFederatedScope(identity)\n343\t\towner := s\n344\t\tif identity.Project != localProject {\n345\t\t\ts.closeoutTrace.visit(\"\", true)\n346\t\t\tif resolver.Roots == nil {\n347\t\t\t\treturn false, scope + \" of \" + identity.Project + \" cannot be checked for its close: project roots are unavailable\"\n348\t\t\t}\n349\t\t\tsource, err := resolver.Roots.StoreFor(identity.Project)\n350\t\t\tif err != nil {\n351\t\t\t\treturn false, scope + \" of \" + identity.Project + \" cannot be checked for its close: \" + projectResolutionState(err)\n352\t\t\t}\n353\t\t\tsource = resolver.withSpecSnapshot(identity.Project, source)\n354\t\t\t// Crossing roots is deliberately not memoized: the local trace's scopes\n355\t\t\t// use the existing unqualified cycle semantics. A remote cut must also\n356\t\t\t// invalidate every enclosing local computation, including on errors.\n357\t\t\tsource.closeoutTrace = s.closeoutTrace\n358\t\t\tsource.closeoutChain = s.closeoutChain\n359\t\t\towner = source\n360\t\t}\n361\t\tif owner.FederatedResolver == nil {\n362\t\t\towner.FederatedProjectID, owner.FederatedResolver = identity.Project, &resolver\n363\t\t}\n364\t\tadopted, err := owner.closeoutReviewPolicyAdopted()\n365\t\tif err != nil {\n366\t\t\treturn false, scope + \" cannot be checked for its close: \" + err.Error()\n367\t\t}\n368\t\tif !adopted || owner.localScopeClosed(scope) {\n369\t\t\treturn true, \"\"\n370\t\t}\n371\t\treturn false, scope + \" is reached but not closed: `pose close \" + scope + \"` publishes its closeout receipt\"\n372\t}\n373\t\n374\t// canonicalMember is milestoneMember after transfer redirects: a local member\n375\t// a transfer moved is its canonical destination, local or external. A\n376\t// redirect that cannot be followed reads as external, so no local consumer\n377\t// judges the redirect stub and federated proof fails closed on it (review\n378\t// round 9, N33).\n379\tfunc (s Store) canonicalMember(raw string) (string, bool) {\n380\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n381\t\tif unresolved != \"\" {\n382\t\t\treturn raw, true\n383\t\t}\n384\t\treturn slug, external\n385\t}\n386\t\n387\t// localScopeClosed reports a local milestone or roadmap a dependency edge\n388\t// names as closed by the terminal projection, under an adopted closeout\n389\t// review policy where status alone never closes it. A scope already asking\n390\t// along the chain is a cycle and is not proven closed.\n391\tfunc (s Store) localScopeClosed(scope string) bool {\n392\t\ts.closeoutTrace.visit(scope, false)\n393\t\tfor _, asking := range s.closeoutChain {\n394\t\t\tif asking == scope {\n395\t\t\t\ts.closeoutTrace.visit(scope, true)\n396\t\t\t\treturn false\n397\t\t\t}\n398\t\t}\n399\t\tclosed, err := s.closedByReceipt(scope)\n400\t\treturn err == nil && closed\n401\t}\n402\t\n403\t// CurrentCloseoutDecision is the decision for an open aggregate scope now:\n404\t// the evaluator, then every protection that can only make it stronger. It is\n405\t// what close judges before publishing and again inside the protected region.\n406\tfunc (s Store) CurrentCloseoutDecision(ref string) (CloseoutReviewDecision, error) {\n407\t\tpolicy, _, err := s.loadReviewPolicy()\n408\t\tif err != nil {\n409\t\t\treturn CloseoutReviewDecision{}, err"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"e309cea2-3d77-4be8-81ec-d7000129506c","timestamp":"2026-11-18T03:59:54.456Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/p5.72rW0j/pose-review-run-3323286775/worktree/pose-mcp/internal/pose/closeout_review_policy.go","content":"\treturn canonical, true, \"\"\n}\n\n// AggregateDependencyClosed reports whether a resolved dependency on a\n// milestone or roadmap is closed, beyond the status its members give it:\n// under the closeout review policy its owning project adopted, only the\n// terminal projection closes it (an explicit close with its receipt, or a\n// verified closure from before adoption). A spec, or an aggregate scope of a\n// project still on the legacy rule, keeps its status contract. A transferred\n// artifact is judged at its canonical destination; a project whose store or\n// policy cannot be read is not proven closed (review round 7, N27).\nfunc (s Store) AggregateDependencyClosed(resolver ArtifactResolver, localProject string, resolved ArtifactResolution) (bool, string) {\n\tidentity := resolved.Identity\n\tif resolved.CanonicalIdentity != nil {\n\t\tidentity = *resolved.CanonicalIdentity\n\t}\n\tif identity.Kind != \"milestone\" && identity.Kind != \"roadmap\" || s.indexMaterial {\n\t\treturn true, \"\"\n\t}\n\tif identity.Project == \"\" {\n\t\tidentity.Project = localProject\n\t}\n\tscope := localFederatedScope(identity)\n\towner := s\n\tif identity.Project != localProject {\n\t\ts.closeoutTrace.visit(\"\", true)\n\t\tif resolver.Roots == nil {\n\t\t\treturn false, scope + \" of \" + identity.Project + \" cannot be checked for its close: project roots are unavailable\"\n\t\t}\n\t\tsource, err := resolver.Roots.StoreFor(identity.Project)\n\t\tif err != nil {\n\t\t\treturn false, scope + \" of \" + identity.Project + \" cannot be checked for its close: \" + projectResolutionState(err)\n\t\t}\n\t\tsource = resolver.withSpecSnapshot(identity.Project, source)\n\t\t// Crossing roots is deliberately not memoized: the local trace's scopes\n\t\t// use the existing unqualified cycle semantics. A remote cut must also\n\t\t// invalidate every enclosing local computation, including on errors.\n\t\tsource.closeoutTrace = s.closeoutTrace\n\t\tsource.closeoutChain = s.closeoutChain\n\t\towner = source\n\t}\n\tif owner.FederatedResolver == nil {\n\t\towner.FederatedProjectID, owner.FederatedResolver = identity.Project, &resolver\n\t}\n\tadopted, err := owner.closeoutReviewPolicyAdopted()\n\tif err != nil {\n\t\treturn false, scope + \" cannot be checked for its close: \" + err.Error()\n\t}\n\tif !adopted || owner.localScopeClosed(scope) {\n\t\treturn true, \"\"\n\t}\n\treturn false, scope + \" is reached but not closed: `pose close \" + scope + \"` publishes its closeout receipt\"\n}\n\n// canonicalMember is milestoneMember after transfer redirects: a local member\n// a transfer moved is its canonical destination, local or external. A\n// redirect that cannot be followed reads as external, so no local consumer\n// judges the redirect stub and federated proof fails closed on it (review\n// round 9, N33).\nfunc (s Store) canonicalMember(raw string) (string, bool) {\n\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n\tif unresolved != \"\" {\n\t\treturn raw, true\n\t}\n\treturn slug, external\n}\n\n// localScopeClosed reports a local milestone or roadmap a dependency edge\n// names as closed by the terminal projection, under an adopted closeout\n// review policy where status alone never closes it. A scope already asking\n// along the chain is a cycle and is not proven closed.\nfunc (s Store) localScopeClosed(scope string) bool {\n\ts.closeoutTrace.visit(scope, false)\n\tfor _, asking := range s.closeoutChain {\n\t\tif asking == scope {\n\t\t\ts.closeoutTrace.visit(scope, true)\n\t\t\treturn false\n\t\t}\n\t}\n\tclosed, err := s.closedByReceipt(scope)\n\treturn err == nil && closed\n}\n\n// CurrentCloseoutDecision is the decision for an open aggregate scope now:\n// the evaluator, then every protection that can only make it stronger. It is\n// what close judges before publishing and again inside the protected region.\nfunc (s Store) CurrentCloseoutDecision(ref string) (CloseoutReviewDecision, error) {\n\tpolicy, _, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn CloseoutReviewDecision{}, err","numLines":90,"startLine":320,"totalLines":970}},"tool_result_meta":[{"id":"toolu_018dHeV8VqasS67pnXKiHe3A","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch9izwNwkFnDVSrbefcTy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YHN9psEMNQgCwtZBse16r1","name":"Read","input":{"file_path":"/var/tmp/p5.72rW0j/pose-review-run-3323286775/worktree/pose-mcp/internal/pose/closeout_review_policy.go","offset":770,"limit":170},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2950,"cache_read_input_tokens":31281,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2950},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"65c15574-c7ef-41d7-aeb7-fe6f51e8d6e4","timestamp":"2026-11-18T03:59:55.301Z","request_id":"req_011Ch9izwBYkT61iv6zWxA1T","wire_tool_inputs":{"toolu_01YHN9psEMNQgCwtZBse16r1":{"file_path":"/var/tmp/p5.72rW0j/pose-review-run-3323286775/worktree/pose-mcp/internal/pose/closeout_review_policy.go","offset":770,"limit":170}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YHN9psEMNQgCwtZBse16r1","type":"tool_result","content":"770\t// approved under a plan without a closeout decision), never backfilled with a\n771\t// receipt. Either way the scope must pass the whole terminal verifier closeout\n772\t// applies: its review, a refusal recorded later, its children, its gates, and\n773\t// the acceptance of its dependency edges (predecessors, consumed outcomes,\n774\t// members), local and remote. It is the one terminal projection reached,\n775\t// roadmap-reached, attention and doctor ask.\n776\tfunc (s Store) closedByReceipt(ref string) (bool, error) {\n777\t\treturn s.doctorMemoClosedByReceipt(ref)\n778\t}\n779\t\n780\tfunc (s Store) computeClosedByReceipt(ref string) (bool, error) {\n781\t\tif len(s.closeoutChain) == 0 || s.closeoutChain[len(s.closeoutChain)-1] != ref {\n782\t\t\ts.closeoutChain = append(append([]string{}, s.closeoutChain...), ref)\n783\t\t}\n784\t\treceipt, err := s.ReadCloseoutReceipt(ref)\n785\t\tif err != nil {\n786\t\t\treturn false, err\n787\t\t}\n788\t\tif receipt != nil {\n789\t\t\tpolicy, _, err := s.loadReviewPolicy()\n790\t\t\tif err != nil {\n791\t\t\t\treturn false, err\n792\t\t\t}\n793\t\t\tif s.closeoutReceiptStands(*receipt, policy) != nil {\n794\t\t\t\treturn false, nil\n795\t\t\t}\n796\t\t} else {\n797\t\t\tscope, err := ParseScopeRef(ref)\n798\t\t\tif err != nil {\n799\t\t\t\treturn false, err\n800\t\t\t}\n801\t\t\tif !s.closeoutScopeHistorical(scope) && !s.milestoneClosedBeforeAdoption(scope) {\n802\t\t\t\treturn false, nil\n803\t\t\t}\n804\t\t}\n805\t\treturn s.closeoutTerminalWithDependencies(ref), nil\n806\t}\n807\t\n808\t// closeoutTerminalWithDependencies runs the terminal verifier with dependency\n809\t// acceptance, through the store's bound resolver or, without one, the\n810\t// resolver the environment binds to this root, as `pose close` does. A\n811\t// resolver that cannot be built leaves the edges unjudged, so the scope does\n812\t// not read closed. Same-project edges are judged by their lifecycle and\n813\t// revision, without recursion into their closeout, and remote recursion stops\n814\t// at a cycle, so the projection converges.\n815\tfunc (s Store) closeoutTerminalWithDependencies(ref string) bool {\n816\t\tif s.FederatedResolver == nil || s.FederatedResolver.Roots == nil {\n817\t\t\tresolver, project, err := EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n818\t\t\tif err != nil {\n819\t\t\t\treturn false\n820\t\t\t}\n821\t\t\ts.FederatedProjectID, s.FederatedResolver = project, &resolver\n822\t\t}\n823\t\tstate, err := s.getCloseoutState(ref, true)\n824\t\ts.traceDoctorCloseoutSources(state)\n825\t\treturn err == nil && state.Terminal\n826\t}\n827\t\n828\t// receiptStandsFor reports a closeout receipt on file that still stands for\n829\t// the scope as it is. It reads no terminal state, so the review verification\n830\t// can ask it without recursing into closeout.\n831\tfunc (s Store) receiptStandsFor(ref string) bool {\n832\t\treceipt, err := s.ReadCloseoutReceipt(ref)\n833\t\tif err != nil || receipt == nil {\n834\t\t\treturn false\n835\t\t}\n836\t\tpolicy, _, err := s.loadReviewPolicy()\n837\t\treturn err == nil && s.closeoutReceiptStands(*receipt, policy) == nil\n838\t}\n839\t\n840\t// scopeReviewRecorded reports a review of the scope on file: a bundle or a\n841\t// legacy attempt. A record that cannot be read counts as recorded, so an\n842\t// unreadable rejection never turns into an exemption.\n843\tfunc (s Store) scopeReviewRecorded(ref string) bool {\n844\t\tbundles, err := s.ReadReviewBundles(ref)\n845\t\tif err != nil || len(bundles.Bundles) > 0 || !bundles.Coverage.CompleteFor(ref) {\n846\t\t\treturn true\n847\t\t}\n848\t\tattempts, err := s.ReadReviewAttempts(ref)\n849\t\treturn err != nil || len(attempts.Attempts) > 0 || !attempts.Coverage.CompleteFor(ref)\n850\t}\n851\t\n852\t// closeoutApprovalOrigin is the origin an exempt scope's approval reports.\n853\tfunc closeoutApprovalOrigin(decision CloseoutReviewDecision) string {\n854\t\treturn \"not-required:\" + decision.PolicyKey + \"=\" + decision.PolicyValue\n855\t}\n856\t\n857\tfunc closeoutExemptionWarning(ref string, decision CloseoutReviewDecision) string {\n858\t\treturn \"review: not-required for \" + ref + \" (\" + decision.PolicyKey + \"=\" + decision.PolicyValue + \", \" + decision.Reason + \"); `pose close \" + ref + \"` is still required\"\n859\t}\n860\t\n861\t// CloseoutReviewOwing is an open aggregate scope that owes its own review under\n862\t// the adopted policy and holds no recorded approval yet, for `pose doctor`.\n863\ttype CloseoutReviewOwing struct {\n864\t\tScope    string                 `json:\"scope\"`\n865\t\tDecision CloseoutReviewDecision `json:\"decision\"`\n866\t\t// Previous is the rule that applied before, when a recorded input shows\n867\t\t// it; with no snapshot it says the comparison is unknown.\n868\t\tPrevious string `json:\"previous\"`\n869\t\tAction   string `json:\"action\"`\n870\t}\n871\t\n872\t// CloseoutReviewsOwed lists the open milestones and roadmaps that, under the\n873\t// adopted closeout review policy, owe a review they do not have. A legacy\n874\t// policy returns nothing. Close remains the authoritative gate.\n875\tfunc (s Store) CloseoutReviewsOwed() ([]CloseoutReviewOwing, error) {\n876\t\t// Legacy instances have no generation to certify. Preserve their existing\n877\t\t// advisory diagnostic path instead of turning every owed review into an\n878\t\t// operation error merely because the index is unversioned.\n879\t\tif s.ReadIndexGeneration().Status == IndexGenerationLegacy {\n880\t\t\treturn s.closeoutReviewsOwed()\n881\t\t}\n882\t\t// Every open milestone and roadmap is asked in one read-view operation:\n883\t\t// apart, each scope opened its own and the ledger, the federated proofs\n884\t\t// and the spec listing were read again for every one of them (spec\n885\t\t// pose-doctor-asks-every-closeout-in-one-operation).\n886\t\tvar owing []CloseoutReviewOwing\n887\t\tvar err error\n888\t\tviewErr := s.WithReviewOperationView(func(shared Store) {\n889\t\t\tshared.withDoctorCloseoutMemo(func(query Store) {\n890\t\t\t\towing, err = query.closeoutReviewsOwed()\n891\t\t\t})\n892\t\t})\n893\t\tif err != nil {\n894\t\t\treturn nil, err\n895\t\t}\n896\t\tif viewErr != nil {\n897\t\t\treturn nil, viewErr\n898\t\t}\n899\t\treturn owing, nil\n900\t}\n901\t\n902\tfunc (s Store) closeoutReviewsOwed() ([]CloseoutReviewOwing, error) {\n903\t\tpolicy, _, err := s.loadReviewPolicy()\n904\t\tif err != nil || !policy.CloseoutReviewAdopted() {\n905\t\t\treturn nil, err\n906\t\t}\n907\t\troadmaps, err := s.ListRoadmaps()\n908\t\tif err != nil {\n909\t\t\treturn nil, err\n910\t\t}\n911\t\trefs := []string{}\n912\t\tfor _, rm := range roadmaps {\n913\t\t\tfor _, milestone := range rm.Milestones {\n914\t\t\t\trefs = append(refs, \"milestone:\"+rm.Slug+\"/\"+milestone.ID)\n915\t\t\t}\n916\t\t\trefs = append(refs, \"roadmap:\"+rm.Slug)\n917\t\t}\n918\t\towing := []CloseoutReviewOwing{}\n919\t\tfor _, ref := range refs {\n920\t\t\tclosed, err := s.closedByReceipt(ref)\n921\t\t\tif err != nil {\n922\t\t\t\treturn nil, err\n923\t\t\t}\n924\t\t\tif closed {\n925\t\t\t\tcontinue\n926\t\t\t}\n927\t\t\t// A scope closed before adoption is never re-decided under the\n928\t\t\t// current policy, but its terminal evidence must still stand: one\n929\t\t\t// that no longer verifies is listed with the check that says why\n930\t\t\t// (review round 6, N23).\n931\t\t\tif scope, err := ParseScopeRef(ref); err == nil && (s.closeoutScopeHistorical(scope) || s.milestoneClosedBeforeAdoption(scope)) {\n932\t\t\t\towing = append(owing, CloseoutReviewOwing{\n933\t\t\t\t\tScope:    ref,\n934\t\t\t\t\tDecision: CloseoutReviewDecision{Scope: ref, Adopted: true, Known: true, Required: true, Reason: \"closed before adoption; its sealed closure no longer verifies\"},\n935\t\t\t\t\tPrevious: \"closed before adoption under the legacy rule\",\n936\t\t\t\t\tAction:   \"run `pose closeout-check \" + ref + \"` and remediate the review or child it names; the closure is verified by the contract it was sealed under\",\n937\t\t\t\t})\n938\t\t\t\tcontinue\n939\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"1b593620-d464-464f-9f0f-be6c2428520d","timestamp":"2026-11-18T03:59:55.308Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/p5.72rW0j/pose-review-run-3323286775/worktree/pose-mcp/internal/pose/closeout_review_policy.go","content":"// approved under a plan without a closeout decision), never backfilled with a\n// receipt. Either way the scope must pass the whole terminal verifier closeout\n// applies: its review, a refusal recorded later, its children, its gates, and\n// the acceptance of its dependency edges (predecessors, consumed outcomes,\n// members), local and remote. It is the one terminal projection reached,\n// roadmap-reached, attention and doctor ask.\nfunc (s Store) closedByReceipt(ref string) (bool, error) {\n\treturn s.doctorMemoClosedByReceipt(ref)\n}\n\nfunc (s Store) computeClosedByReceipt(ref string) (bool, error) {\n\tif len(s.closeoutChain) == 0 || s.closeoutChain[len(s.closeoutChain)-1] != ref {\n\t\ts.closeoutChain = append(append([]string{}, s.closeoutChain...), ref)\n\t}\n\treceipt, err := s.ReadCloseoutReceipt(ref)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif receipt != nil {\n\t\tpolicy, _, err := s.loadReviewPolicy()\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tif s.closeoutReceiptStands(*receipt, policy) != nil {\n\t\t\treturn false, nil\n\t\t}\n\t} else {\n\t\tscope, err := ParseScopeRef(ref)\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tif !s.closeoutScopeHistorical(scope) && !s.milestoneClosedBeforeAdoption(scope) {\n\t\t\treturn false, nil\n\t\t}\n\t}\n\treturn s.closeoutTerminalWithDependencies(ref), nil\n}\n\n// closeoutTerminalWithDependencies runs the terminal verifier with dependency\n// acceptance, through the store's bound resolver or, without one, the\n// resolver the environment binds to this root, as `pose close` does. A\n// resolver that cannot be built leaves the edges unjudged, so the scope does\n// not read closed. Same-project edges are judged by their lifecycle and\n// revision, without recursion into their closeout, and remote recursion stops\n// at a cycle, so the projection converges.\nfunc (s Store) closeoutTerminalWithDependencies(ref string) bool {\n\tif s.FederatedResolver == nil || s.FederatedResolver.Roots == nil {\n\t\tresolver, project, err := EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n\t\tif err != nil {\n\t\t\treturn false\n\t\t}\n\t\ts.FederatedProjectID, s.FederatedResolver = project, &resolver\n\t}\n\tstate, err := s.getCloseoutState(ref, true)\n\ts.traceDoctorCloseoutSources(state)\n\treturn err == nil && state.Terminal\n}\n\n// receiptStandsFor reports a closeout receipt on file that still stands for\n// the scope as it is. It reads no terminal state, so the review verification\n// can ask it without recursing into closeout.\nfunc (s Store) receiptStandsFor(ref string) bool {\n\treceipt, err := s.ReadCloseoutReceipt(ref)\n\tif err != nil || receipt == nil {\n\t\treturn false\n\t}\n\tpolicy, _, err := s.loadReviewPolicy()\n\treturn err == nil && s.closeoutReceiptStands(*receipt, policy) == nil\n}\n\n// scopeReviewRecorded reports a review of the scope on file: a bundle or a\n// legacy attempt. A record that cannot be read counts as recorded, so an\n// unreadable rejection never turns into an exemption.\nfunc (s Store) scopeReviewRecorded(ref string) bool {\n\tbundles, err := s.ReadReviewBundles(ref)\n\tif err != nil || len(bundles.Bundles) > 0 || !bundles.Coverage.CompleteFor(ref) {\n\t\treturn true\n\t}\n\tattempts, err := s.ReadReviewAttempts(ref)\n\treturn err != nil || len(attempts.Attempts) > 0 || !attempts.Coverage.CompleteFor(ref)\n}\n\n// closeoutApprovalOrigin is the origin an exempt scope's approval reports.\nfunc closeoutApprovalOrigin(decision CloseoutReviewDecision) string {\n\treturn \"not-required:\" + decision.PolicyKey + \"=\" + decision.PolicyValue\n}\n\nfunc closeoutExemptionWarning(ref string, decision CloseoutReviewDecision) string {\n\treturn \"review: not-required for \" + ref + \" (\" + decision.PolicyKey + \"=\" + decision.PolicyValue + \", \" + decision.Reason + \"); `pose close \" + ref + \"` is still required\"\n}\n\n// CloseoutReviewOwing is an open aggregate scope that owes its own review under\n// the adopted policy and holds no recorded approval yet, for `pose doctor`.\ntype CloseoutReviewOwing struct {\n\tScope    string                 `json:\"scope\"`\n\tDecision CloseoutReviewDecision `json:\"decision\"`\n\t// Previous is the rule that applied before, when a recorded input shows\n\t// it; with no snapshot it says the comparison is unknown.\n\tPrevious string `json:\"previous\"`\n\tAction   string `json:\"action\"`\n}\n\n// CloseoutReviewsOwed lists the open milestones and roadmaps that, under the\n// adopted closeout review policy, owe a review they do not have. A legacy\n// policy returns nothing. Close remains the authoritative gate.\nfunc (s Store) CloseoutReviewsOwed() ([]CloseoutReviewOwing, error) {\n\t// Legacy instances have no generation to certify. Preserve their existing\n\t// advisory diagnostic path instead of turning every owed review into an\n\t// operation error merely because the index is unversioned.\n\tif s.ReadIndexGeneration().Status == IndexGenerationLegacy {\n\t\treturn s.closeoutReviewsOwed()\n\t}\n\t// Every open milestone and roadmap is asked in one read-view operation:\n\t// apart, each scope opened its own and the ledger, the federated proofs\n\t// and the spec listing were read again for every one of them (spec\n\t// pose-doctor-asks-every-closeout-in-one-operation).\n\tvar owing []CloseoutReviewOwing\n\tvar err error\n\tviewErr := s.WithReviewOperationView(func(shared Store) {\n\t\tshared.withDoctorCloseoutMemo(func(query Store) {\n\t\t\towing, err = query.closeoutReviewsOwed()\n\t\t})\n\t})\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif viewErr != nil {\n\t\treturn nil, viewErr\n\t}\n\treturn owing, nil\n}\n\nfunc (s Store) closeoutReviewsOwed() ([]CloseoutReviewOwing, error) {\n\tpolicy, _, err := s.loadReviewPolicy()\n\tif err != nil || !policy.CloseoutReviewAdopted() {\n\t\treturn nil, err\n\t}\n\troadmaps, err := s.ListRoadmaps()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\trefs := []string{}\n\tfor _, rm := range roadmaps {\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\trefs = append(refs, \"milestone:\"+rm.Slug+\"/\"+milestone.ID)\n\t\t}\n\t\trefs = append(refs, \"roadmap:\"+rm.Slug)\n\t}\n\towing := []CloseoutReviewOwing{}\n\tfor _, ref := range refs {\n\t\tclosed, err := s.closedByReceipt(ref)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif closed {\n\t\t\tcontinue\n\t\t}\n\t\t// A scope closed before adoption is never re-decided under the\n\t\t// current policy, but its terminal evidence must still stand: one\n\t\t// that no longer verifies is listed with the check that says why\n\t\t// (review round 6, N23).\n\t\tif scope, err := ParseScopeRef(ref); err == nil && (s.closeoutScopeHistorical(scope) || s.milestoneClosedBeforeAdoption(scope)) {\n\t\t\towing = append(owing, CloseoutReviewOwing{\n\t\t\t\tScope:    ref,\n\t\t\t\tDecision: CloseoutReviewDecision{Scope: ref, Adopted: true, Known: true, Required: true, Reason: \"closed before adoption; its sealed closure no longer verifies\"},\n\t\t\t\tPrevious: \"closed before adoption under the legacy rule\",\n\t\t\t\tAction:   \"run `pose closeout-check \" + ref + \"` and remediate the review or child it names; the closure is verified by the contract it was sealed under\",\n\t\t\t})\n\t\t\tcontinue\n\t\t}","numLines":170,"startLine":770,"totalLines":970}},"tool_result_meta":[{"id":"toolu_01YHN9psEMNQgCwtZBse16r1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
