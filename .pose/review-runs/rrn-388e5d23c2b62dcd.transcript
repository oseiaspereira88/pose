{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NtqED4ygWDGgjBvkYdZ7YS","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"fmt\"\n6\t\t\"path/filepath\"\n7\t\t\"reflect\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t\t\"time\"\n11\t)\n12\t\n13\t// Real sealed member review and published receipts; only the topology is\n14\t// synthetic. Reusing one approved member in the same roadmap isolates the\n15\t// predecessor cost from member-review cost; it is not a production doctor\n16\t// benchmark. These existing fixtures have a legacy index: their outer audit\n17\t// may refuse currentness. Equivalence below concerns the diagnostic evaluation\n18\t// inside one capture, never an assertion that a legacy audit was certified.\n19\tfunc doctorMemoFixture(t *testing.T, n int) (Store, []string) {\n20\t\tt.Helper()\n21\t\troot, s := closeoutReviewedFixture(t, \"never\", \"never\")\n22\t\tresolver := *s.FederatedResolver\n23\t\tresolver.Authorize = nil // exercise the trusted CLI boundary\n24\t\ts.FederatedResolver = &resolver\n25\t\ttext := \"---\\nslug: program\\nstatus: active\\n---\\n\"\n26\t\trefs := make([]string, n)\n27\t\tfor i := range refs {\n28\t\t\tname := \"core\"\n29\t\t\tif i > 0 {\n30\t\t\t\tname = fmt.Sprintf(\"step%d\", i)\n31\t\t\t}\n32\t\t\trefs[i] = \"milestone:program/\" + name\n33\t\t\ttext += \"\\n## Milestone: \" + name + \"\\n\"\n34\t\t\tif i > 0 {\n35\t\t\t\ttext += \"- after: \" + strings.TrimPrefix(refs[i-1], \"milestone:program/\") + \"\\n\"\n36\t\t\t}\n37\t\t\ttext += \"- specs: backend\\n\"\n38\t\t}\n39\t\tfederatedTestWrite(t, root, \".pose/roadmaps/program.md\", text)\n40\t\tfederatedTestGit(t, root, \"add\", \"--all\")\n41\t\tfederatedTestGit(t, root, \"commit\", \"-q\", \"-m\", \"local predecessor fixture\")\n42\t\tapproveMember(t, s, reviewFixtureNow.Add(10*time.Minute))\n43\t\ts = s.atReviewTime(reviewFixtureNow.Add(24 * time.Hour))\n44\t\tfor _, ref := range refs {\n45\t\t\tstate, err := s.GetCloseoutState(ref)\n46\t\t\tif err != nil || state.Review.CloseoutReview == nil {\n47\t\t\t\tt.Fatalf(\"receipt fixture %s: %+v %v\", ref, state, err)\n48\t\t\t}\n49\t\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n50\t\t\tif err != nil {\n51\t\t\t\tt.Fatal(err)\n52\t\t\t}\n53\t\t\tif err := s.PublishCloseoutReceipt(receipt); err != nil {\n54\t\t\t\tt.Fatal(err)\n55\t\t\t}\n56\t\t}\n57\t\treturn s, refs\n58\t}\n59\t\n60\tfunc doctorMemoOperation(t *testing.T, s Store, run func(Store)) {\n61\t\tt.Helper()\n62\t\terr := s.WithReviewOperationView(func(shared Store) { shared.withDoctorCloseoutMemo(run) })\n63\t\tif err != nil && !errors.Is(err, ErrGovernanceReadViewUnknown) {\n64\t\t\tt.Fatal(err)\n65\t\t}\n66\t}\n67\t\n68\tfunc TestDoctorCloseoutMemoLinearEquivalenceAndCount(t *testing.T) {\n69\t\ts, refs := doctorMemoFixture(t, 6)\n70\t\tdoctorMemoOperation(t, s, func(query Store) {\n71\t\t\tif query.doctorCloseoutMemo == nil {\n72\t\t\t\tt.Fatal(\"memo not active\")\n73\t\t\t}\n74\t\t\tcomputes := 0\n75\t\t\tquery.doctorCloseoutMemo.onCompute = func(string) { computes++ }\n76\t\t\t// Ask in reverse order so the first evaluation must traverse the chain.\n77\t\t\tfor i := len(refs) - 1; i >= 0; i-- {\n78\t\t\t\tref := refs[i]\n79\t\t\t\tplain := query\n80\t\t\t\tplain.doctorCloseoutMemo = nil\n81\t\t\t\twant, wantErr := plain.closedByReceipt(ref)\n82\t\t\t\tgot, err := query.closedByReceipt(ref)\n83\t\t\t\tif wantErr != nil || err != nil || !want || got != want {\n84\t\t\t\t\tstate, _ := plain.getCloseoutState(ref, true)\n85\t\t\t\t\tt.Fatalf(\"%s: memo=%v/%v plain=%v/%v blockers=%v\", ref, got, err, want, wantErr, state.Blockers)\n86\t\t\t\t}\n87\t\t\t}\n88\t\t\tif computes != len(refs) {\n89\t\t\t\tt.Fatalf(\"real verifier calls=%d, want %d\", computes, len(refs))\n90\t\t\t}\n91\t\t\tplain := query\n92\t\t\tplain.doctorCloseoutMemo = nil\n93\t\t\twant, wantErr := plain.closeoutReviewsOwed()\n94\t\t\tgot, err := query.closeoutReviewsOwed()\n95\t\t\tif !reflect.DeepEqual(got, want) || fmt.Sprint(err) != fmt.Sprint(wantErr) {\n96\t\t\t\tt.Fatalf(\"owed differs: memo=%+v/%v plain=%+v/%v\", got, err, want, wantErr)\n97\t\t\t}\n98\t\t})\n99\t}\n100\t\n101\tfunc TestDoctorCloseoutMemoAncestorIntersection(t *testing.T) {\n102\t\ts, refs := doctorMemoFixture(t, 3)\n103\t\tdoctorMemoOperation(t, s, func(query Store) {\n104\t\t\tif closed, err := query.closedByReceipt(refs[2]); err != nil || !closed {\n105\t\t\t\tt.Fatalf(\"uncut X must close: %v %v\", closed, err)\n106\t\t\t}\n107\t\t\tcomputes := 0\n108\t\t\tquery.doctorCloseoutMemo.onCompute = func(string) { computes++ }\n109\t\t\tquery.closeoutChain = []string{refs[0]}\n110\t\t\tplain := query\n111\t\t\tplain.doctorCloseoutMemo = nil\n112\t\t\twant, wantErr := plain.closedByReceipt(refs[2])\n113\t\t\tgot, err := query.closedByReceipt(refs[2])\n114\t\t\tif want || got != want || err != nil || wantErr != nil || computes == 0 {\n115\t\t\t\tt.Fatalf(\"ancestor through cached child: memo=%v/%v plain=%v/%v computes=%d\", got, err, want, wantErr, computes)\n116\t\t\t}\n117\t\t\t// A cut evaluation must not replace the independent, uncut approval.\n118\t\t\tquery.closeoutChain = nil\n119\t\t\tif closed, err := query.closedByReceipt(refs[2]); err != nil || !closed {\n120\t\t\t\tt.Fatalf(\"cut poisoned uncut result: %v %v\", closed, err)\n121\t\t\t}\n122\t\t})\n123\t}\n124\t\n125\tfunc TestDoctorCloseoutMemoLocalCycle(t *testing.T) {\n126\t\ts, refs := doctorMemoFixture(t, 2)\n127\t\teditFile(t, filepath.Join(s.Root, \".pose/roadmaps/program.md\"), \"## Milestone: core\\n\", \"## Milestone: core\\n- after: step1\\n\")\n128\t\tdoctorMemoOperation(t, s, func(query Store) {\n129\t\t\tfor _, ref := range refs {\n130\t\t\t\tplain := query\n131\t\t\t\tplain.doctorCloseoutMemo = nil\n132\t\t\t\twant, wantErr := plain.closedByReceipt(ref)\n133\t\t\t\tgot, err := query.closedByReceipt(ref)\n134\t\t\t\tif want || got != want || fmt.Sprint(err) != fmt.Sprint(wantErr) {\n135\t\t\t\t\tt.Fatalf(\"cycle %s: memo=%v/%v plain=%v/%v\", ref, got, err, want, wantErr)\n136\t\t\t\t}\n137\t\t\t}\n138\t\t\tif len(query.doctorCloseoutMemo.entries) != 0 {\n139\t\t\t\tt.Fatal(\"cycle retained an approval\")\n140\t\t\t}\n141\t\t})\n142\t}\n143\t\n144\tfunc TestDoctorCloseoutMemoLifetimeClockAndBinding(t *testing.T) {\n145\t\ts, refs := doctorMemoFixture(t, 1)\n146\t\tvar escaped Store\n147\t\tdoctorMemoOperation(t, s, func(query Store) {\n148\t\t\tescaped = query\n149\t\t\tif closed, err := query.closedByReceipt(refs[0]); err != nil || !closed {\n150\t\t\t\tt.Fatal(closed, err)\n151\t\t\t}\n152\t\t\tcomputes := 0\n153\t\t\tquery.doctorCloseoutMemo.onCompute = func(string) { computes++ }\n154\t\t\tother := query.atReviewTime(query.reviewClock().Add(time.Second))\n155\t\t\tif closed, err := other.closedByReceipt(refs[0]); err != nil || !closed {\n156\t\t\t\tt.Fatal(closed, err)\n157\t\t\t}\n158\t\t\tif computes != 0 {\n159\t\t\t\tt.Fatal(\"different clock entered memo\")\n160\t\t\t}\n161\t\t\tif fresh := query.withoutGovernanceReadView(); fresh.doctorCloseoutMemo != nil || fresh.closeoutTrace != nil {\n162\t\t\t\tt.Fatal(\"new view retained memo\")\n163\t\t\t}\n164\t\t\t_, view := query.beginGovernanceReadView()\n165\t\t\tif fresh := query.withGovernanceReadView(view, \"test\"); fresh.doctorCloseoutMemo != nil || fresh.closeoutTrace != nil {\n166\t\t\t\tt.Fatal(\"rebound view retained memo\")\n167\t\t\t}\n168\t\n169\t\t})\n170\t\tif !escaped.doctorCloseoutMemo.closed || len(escaped.doctorCloseoutMemo.entries) != 0 {\n171\t\t\tt.Fatal(\"query retained memo after callback\")\n172\t\t}\n173\t\tdoctorMemoOperation(t, s, func(query Store) {\n174\t\t\tif query.doctorCloseoutMemo == escaped.doctorCloseoutMemo || len(query.doctorCloseoutMemo.entries) != 0 {\n175\t\t\t\tt.Fatal(\"new query borrowed memo\")\n176\t\t\t}\n177\t\t})\n178\t}\n179\t\n180\tfunc TestDoctorCloseoutMemoBoundsAndDynamicAuthorization(t *testing.T) {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"6b0891d6-9553-46ce-84ce-f9485afdb8d9","timestamp":"2026-11-18T04:08:48.500Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/p5.72rW0j/pose-review-run-3323286775/worktree/pose-mcp/internal/pose/doctor_closeout_memo_test.go","content":"package pose\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// Real sealed member review and published receipts; only the topology is\n// synthetic. Reusing one approved member in the same roadmap isolates the\n// predecessor cost from member-review cost; it is not a production doctor\n// benchmark. These existing fixtures have a legacy index: their outer audit\n// may refuse currentness. Equivalence below concerns the diagnostic evaluation\n// inside one capture, never an assertion that a legacy audit was certified.\nfunc doctorMemoFixture(t *testing.T, n int) (Store, []string) {\n\tt.Helper()\n\troot, s := closeoutReviewedFixture(t, \"never\", \"never\")\n\tresolver := *s.FederatedResolver\n\tresolver.Authorize = nil // exercise the trusted CLI boundary\n\ts.FederatedResolver = &resolver\n\ttext := \"---\\nslug: program\\nstatus: active\\n---\\n\"\n\trefs := make([]string, n)\n\tfor i := range refs {\n\t\tname := \"core\"\n\t\tif i > 0 {\n\t\t\tname = fmt.Sprintf(\"step%d\", i)\n\t\t}\n\t\trefs[i] = \"milestone:program/\" + name\n\t\ttext += \"\\n## Milestone: \" + name + \"\\n\"\n\t\tif i > 0 {\n\t\t\ttext += \"- after: \" + strings.TrimPrefix(refs[i-1], \"milestone:program/\") + \"\\n\"\n\t\t}\n\t\ttext += \"- specs: backend\\n\"\n\t}\n\tfederatedTestWrite(t, root, \".pose/roadmaps/program.md\", text)\n\tfederatedTestGit(t, root, \"add\", \"--all\")\n\tfederatedTestGit(t, root, \"commit\", \"-q\", \"-m\", \"local predecessor fixture\")\n\tapproveMember(t, s, reviewFixtureNow.Add(10*time.Minute))\n\ts = s.atReviewTime(reviewFixtureNow.Add(24 * time.Hour))\n\tfor _, ref := range refs {\n\t\tstate, err := s.GetCloseoutState(ref)\n\t\tif err != nil || state.Review.CloseoutReview == nil {\n\t\t\tt.Fatalf(\"receipt fixture %s: %+v %v\", ref, state, err)\n\t\t}\n\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := s.PublishCloseoutReceipt(receipt); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\treturn s, refs\n}\n\nfunc doctorMemoOperation(t *testing.T, s Store, run func(Store)) {\n\tt.Helper()\n\terr := s.WithReviewOperationView(func(shared Store) { shared.withDoctorCloseoutMemo(run) })\n\tif err != nil && !errors.Is(err, ErrGovernanceReadViewUnknown) {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc TestDoctorCloseoutMemoLinearEquivalenceAndCount(t *testing.T) {\n\ts, refs := doctorMemoFixture(t, 6)\n\tdoctorMemoOperation(t, s, func(query Store) {\n\t\tif query.doctorCloseoutMemo == nil {\n\t\t\tt.Fatal(\"memo not active\")\n\t\t}\n\t\tcomputes := 0\n\t\tquery.doctorCloseoutMemo.onCompute = func(string) { computes++ }\n\t\t// Ask in reverse order so the first evaluation must traverse the chain.\n\t\tfor i := len(refs) - 1; i >= 0; i-- {\n\t\t\tref := refs[i]\n\t\t\tplain := query\n\t\t\tplain.doctorCloseoutMemo = nil\n\t\t\twant, wantErr := plain.closedByReceipt(ref)\n\t\t\tgot, err := query.closedByReceipt(ref)\n\t\t\tif wantErr != nil || err != nil || !want || got != want {\n\t\t\t\tstate, _ := plain.getCloseoutState(ref, true)\n\t\t\t\tt.Fatalf(\"%s: memo=%v/%v plain=%v/%v blockers=%v\", ref, got, err, want, wantErr, state.Blockers)\n\t\t\t}\n\t\t}\n\t\tif computes != len(refs) {\n\t\t\tt.Fatalf(\"real verifier calls=%d, want %d\", computes, len(refs))\n\t\t}\n\t\tplain := query\n\t\tplain.doctorCloseoutMemo = nil\n\t\twant, wantErr := plain.closeoutReviewsOwed()\n\t\tgot, err := query.closeoutReviewsOwed()\n\t\tif !reflect.DeepEqual(got, want) || fmt.Sprint(err) != fmt.Sprint(wantErr) {\n\t\t\tt.Fatalf(\"owed differs: memo=%+v/%v plain=%+v/%v\", got, err, want, wantErr)\n\t\t}\n\t})\n}\n\nfunc TestDoctorCloseoutMemoAncestorIntersection(t *testing.T) {\n\ts, refs := doctorMemoFixture(t, 3)\n\tdoctorMemoOperation(t, s, func(query Store) {\n\t\tif closed, err := query.closedByReceipt(refs[2]); err != nil || !closed {\n\t\t\tt.Fatalf(\"uncut X must close: %v %v\", closed, err)\n\t\t}\n\t\tcomputes := 0\n\t\tquery.doctorCloseoutMemo.onCompute = func(string) { computes++ }\n\t\tquery.closeoutChain = []string{refs[0]}\n\t\tplain := query\n\t\tplain.doctorCloseoutMemo = nil\n\t\twant, wantErr := plain.closedByReceipt(refs[2])\n\t\tgot, err := query.closedByReceipt(refs[2])\n\t\tif want || got != want || err != nil || wantErr != nil || computes == 0 {\n\t\t\tt.Fatalf(\"ancestor through cached child: memo=%v/%v plain=%v/%v computes=%d\", got, err, want, wantErr, computes)\n\t\t}\n\t\t// A cut evaluation must not replace the independent, uncut approval.\n\t\tquery.closeoutChain = nil\n\t\tif closed, err := query.closedByReceipt(refs[2]); err != nil || !closed {\n\t\t\tt.Fatalf(\"cut poisoned uncut result: %v %v\", closed, err)\n\t\t}\n\t})\n}\n\nfunc TestDoctorCloseoutMemoLocalCycle(t *testing.T) {\n\ts, refs := doctorMemoFixture(t, 2)\n\teditFile(t, filepath.Join(s.Root, \".pose/roadmaps/program.md\"), \"## Milestone: core\\n\", \"## Milestone: core\\n- after: step1\\n\")\n\tdoctorMemoOperation(t, s, func(query Store) {\n\t\tfor _, ref := range refs {\n\t\t\tplain := query\n\t\t\tplain.doctorCloseoutMemo = nil\n\t\t\twant, wantErr := plain.closedByReceipt(ref)\n\t\t\tgot, err := query.closedByReceipt(ref)\n\t\t\tif want || got != want || fmt.Sprint(err) != fmt.Sprint(wantErr) {\n\t\t\t\tt.Fatalf(\"cycle %s: memo=%v/%v plain=%v/%v\", ref, got, err, want, wantErr)\n\t\t\t}\n\t\t}\n\t\tif len(query.doctorCloseoutMemo.entries) != 0 {\n\t\t\tt.Fatal(\"cycle retained an approval\")\n\t\t}\n\t})\n}\n\nfunc TestDoctorCloseoutMemoLifetimeClockAndBinding(t *testing.T) {\n\ts, refs := doctorMemoFixture(t, 1)\n\tvar escaped Store\n\tdoctorMemoOperation(t, s, func(query Store) {\n\t\tescaped = query\n\t\tif closed, err := query.closedByReceipt(refs[0]); err != nil || !closed {\n\t\t\tt.Fatal(closed, err)\n\t\t}\n\t\tcomputes := 0\n\t\tquery.doctorCloseoutMemo.onCompute = func(string) { computes++ }\n\t\tother := query.atReviewTime(query.reviewClock().Add(time.Second))\n\t\tif closed, err := other.closedByReceipt(refs[0]); err != nil || !closed {\n\t\t\tt.Fatal(closed, err)\n\t\t}\n\t\tif computes != 0 {\n\t\t\tt.Fatal(\"different clock entered memo\")\n\t\t}\n\t\tif fresh := query.withoutGovernanceReadView(); fresh.doctorCloseoutMemo != nil || fresh.closeoutTrace != nil {\n\t\t\tt.Fatal(\"new view retained memo\")\n\t\t}\n\t\t_, view := query.beginGovernanceReadView()\n\t\tif fresh := query.withGovernanceReadView(view, \"test\"); fresh.doctorCloseoutMemo != nil || fresh.closeoutTrace != nil {\n\t\t\tt.Fatal(\"rebound view retained memo\")\n\t\t}\n\n\t})\n\tif !escaped.doctorCloseoutMemo.closed || len(escaped.doctorCloseoutMemo.entries) != 0 {\n\t\tt.Fatal(\"query retained memo after callback\")\n\t}\n\tdoctorMemoOperation(t, s, func(query Store) {\n\t\tif query.doctorCloseoutMemo == escaped.doctorCloseoutMemo || len(query.doctorCloseoutMemo.entries) != 0 {\n\t\t\tt.Fatal(\"new query borrowed memo\")\n\t\t}\n\t})\n}\n\nfunc TestDoctorCloseoutMemoBoundsAndDynamicAuthorization(t *testing.T) {","numLines":180,"startLine":1,"totalLines":341}},"tool_result_meta":[{"id":"toolu_01NtqED4ygWDGgjBvkYdZ7YS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
