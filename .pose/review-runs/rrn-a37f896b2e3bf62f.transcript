{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '320,345p' pose-mcp/internal/pose/release_manifest_integrity.go; sed -n '439,570p' pose-mcp/internal/pose/release_manifest_integrity.go; rg -n 'func gitOutputBounded|GIT_NO_REPLACE|replace-objects|GIT_CONFIG' pose-mcp/internal/cli/git* pose-mcp/internal/pose/git*; nl -ba pose-mcp/internal/pose/kept_cache.go; sed -n '1,140p' .pose/knowledge/2026-10-14-decision-log-adr-shared-worktree-runtime-review.md; git status --short\"","aggregated_output":"\treturn tags, nil\n}\n\n// ReleaseSnapshot is what the tree a tag points at says about its release.\ntype ReleaseSnapshot struct {\n\tTag string `json:\"tag\"`\n\t// ManifestDigest is the digest of the manifest as the tagged tree holds it, which the\n\t// working tree's manifest is bound to.\n\tManifestDigest string                 `json:\"manifest_digest,omitempty\"`\n\tCommit         string                 `json:\"commit\"`\n\tAnnotated      bool                   `json:\"annotated\"`\n\tManifest       *ReleaseManifest       `json:\"manifest,omitempty\"`\n\tIssues         []ReleaseManifestIssue `json:\"issues,omitempty\"`\n\tGaps           []string               `json:\"gaps,omitempty\"`\n\t// Limits say what could not be re-verified from the snapshot, which is not a failure.\n\tLimits []string `json:\"limits,omitempty\"`\n}\n\n// Intact reports a snapshot with a valid manifest and nothing contradicting it.\nfunc (s ReleaseSnapshot) Intact() bool {\n\treturn s.Manifest != nil && len(s.Issues) == 0 && len(s.Gaps) == 0\n}\n\n// ErrReleaseTagNotCommit means a tag exists and does not lead to a commit.\nvar ErrReleaseTagNotCommit = errors.New(\"pose: the release tag does not point at a commit\")\n\nfunc gitOutput(root string, args ...string) (string, error) {\n\treturn gitOutputIn(root, nil, args...)\n}\n\n// gitOutputUntranslated runs git in the C locale, for the callers that read what git says: a\n// translated git words the same answer differently.\nfunc gitOutputUntranslated(root string, args ...string) (string, error) {\n\treturn gitOutputIn(root, []string{\"LC_ALL=C\"}, args...)\n}\n\nfunc gitOutputIn(root string, env []string, args ...string) (string, error) {\n\tcmd := RawHistoryGit(root, args...)\n\tif env != nil {\n\t\tcmd.Env = append(cmd.Env, env...)\n\t}\n\tvar stderr bytes.Buffer\n\tcmd.Stderr = &stderr\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\treturn \"\", &gitCommandError{Op: args[0], Stderr: strings.TrimSpace(stderr.String()), Err: err}\n\t}\n\tif strings.TrimSpace(stderr.String()) != \"\" {\n\t\treturn \"\", &gitCommandError{Op: args[0], Stderr: strings.TrimSpace(stderr.String()), Err: errors.New(\"Git reported an incomplete or uncertain result\")}\n\t}\n\treturn string(out), nil\n}\n\n// ListReleaseTags preserves warnings about broken refs as incomplete inventory.\n// Git may omit a broken loose tag while returning success; absence cannot be inferred.\nfunc ListReleaseTags(root string) (string, error) {\n\treturn gitOutput(root, \"tag\", \"--list\", \"v*\")\n}\n\n// gitTreeEntry looks one path up in a commit's tree. found=false with a nil error is the tree\n// proving the path is not there; any failure to read the tree is an error, never absence.\nfunc gitTreeEntry(root, commit, rel string) (mode, kind, object string, found bool, err error) {\n\tout, err := gitOutput(root, \"ls-tree\", \"-z\", commit, \"--\", rel)\n\tif err != nil {\n\t\treturn \"\", \"\", \"\", false, err\n\t}\n\tmeta, name, ok := strings.Cut(strings.TrimSuffix(out, \"\\x00\"), \"\\t\")\n\tfields := strings.Fields(meta)\n\tif !ok || len(fields) != 3 || name != rel {\n\t\tif strings.TrimSpace(out) != \"\" {\n\t\t\treturn \"\", \"\", \"\", false, fmt.Errorf(\"pose: the tree entry of %s could not be read\", rel)\n\t\t}\n\t\t// Nothing at the path. That is absence only when every directory above it is a tree: a link,\n\t\t// a file or a submodule in the place of an ancestor hides what is below it, and Git then\n\t\t// answers with nothing for the whole path.\n\t\tfor dir := path.Dir(rel); dir != \".\" && dir != \"/\" && dir != \"\"; dir = path.Dir(dir) {\n\t\t\tparentOut, perr := gitOutput(root, \"ls-tree\", \"-z\", commit, \"--\", dir)\n\t\t\tif perr != nil {\n\t\t\t\treturn \"\", \"\", \"\", false, perr\n\t\t\t}\n\t\t\tparentMeta, parentName, parentOK := strings.Cut(strings.TrimSuffix(parentOut, \"\\x00\"), \"\\t\")\n\t\t\tparentFields := strings.Fields(parentMeta)\n\t\t\tif strings.TrimSpace(parentOut) == \"\" {\n\t\t\t\tcontinue // this level is not there either: keep climbing to the first that is\n\t\t\t}\n\t\t\tif !parentOK || len(parentFields) != 3 || parentName != dir {\n\t\t\t\treturn \"\", \"\", \"\", false, fmt.Errorf(\"pose: the tree entry of %s could not be read\", dir)\n\t\t\t}\n\t\t\tif parentFields[1] != \"tree\" {\n\t\t\t\treturn \"\", \"\", \"\", false, fmt.Errorf(\"pose: %s of the tagged tree is not a directory (mode %s), so %s cannot be proven absent\", dir, parentFields[0], rel)\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t\treturn \"\", \"\", \"\", false, nil\n\t}\n\treturn fields[0], fields[1], fields[2], true, nil\n}\n\n// gitBlobAt reads one regular file of a commit's tree; a path the tree proves is not there is\n// os.ErrNotExist, and a link, a submodule or a directory in its place is an error: the bytes of a\n// link are not the content of a file.\nfunc gitBlobAt(root, commit, rel string) ([]byte, error) {\n\tmode, kind, object, found, err := gitTreeEntry(root, commit, rel)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif !found {\n\t\treturn nil, os.ErrNotExist\n\t}\n\tif kind != \"blob\" || (mode != \"100644\" && mode != \"100755\") {\n\t\treturn nil, fmt.Errorf(\"pose: %s of the tagged tree is not a regular file (mode %s)\", rel, mode)\n\t}\n\tout, err := gitOutput(root, \"cat-file\", \"blob\", object)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: git cat-file %s: %w\", rel, err)\n\t}\n\treturn []byte(out), nil\n}\n\n// gitTreeNames lists the entries of one directory of a commit's tree. A directory the tree proves is\n// not there is exists=false, which is not an error: a release with no fragments leaves no\n// directory, and Git cannot version an empty one. A tree that cannot be read, and an entry that is\n// not a directory, are errors.\nfunc gitTreeNames(root, commit, dir string) (names []string, exists bool, err error) {\n\t_, kind, _, found, err := gitTreeEntry(root, commit, dir)\n\tif err != nil {\n\t\treturn nil, false, err\n\t}\n\tif !found {\n\t\treturn nil, false, nil\n\t}\n\tif kind != \"tree\" {\n\t\treturn nil, true, fmt.Errorf(\"pose: %s of the tagged tree is a %s, not a directory\", dir, kind)\n\t}\n\tout, err := gitOutput(root, \"ls-tree\", \"--name-only\", \"-z\", commit+\":\"+dir)\n\tif err != nil {\n\t\treturn nil, true, err\n\t}\n\tfor _, name := range strings.Split(out, \"\\x00\") {\n\t\tif name != \"\" {\n\t\t\tnames = append(names, name)\n\t\t}\n\t}\n\treturn names, true, nil\n}\n\n// releasePolicyAt reads the release policy the tagged tree held: the policy the cut was made\n// under, not the one the project has today.\nfunc releasePolicyAt(root, commit string) (ReleasePolicy, string, error) {\n\tfor _, rel := range []string{\".pose/policy/release.json\", \".pose/release-policy.json\"} {\n\t\traw, err := gitBlobAt(root, commit, rel)\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\tcontinue\n\t\t}\n\t\tif err != nil {\n\t\t\treturn ReleasePolicy{}, rel, err\n\t\t}\n\t\tvar policy ReleasePolicy\npose-mcp/internal/pose/git_snapshot_integrity.go:583:\tcmd.Env = append(env, \"GIT_NO_REPLACE_OBJECTS=1\", \"GIT_GRAFT_FILE=\"+os.DevNull)\n     1\tpackage pose\n     2\t\n     3\timport \"sync\"\n     4\t\n     5\t// keptCache holds values computed from content-addressed inputs for the\n     6\t// process (spec pose-federated-proof-reads-each-input-once). A key is\n     7\t// computed once even when several callers miss it together: the first\n     8\t// computes, the others wait for it. A result the computation declines to\n     9\t// keep (a failed read) is not shared: each waiter then computes its own.\n    10\t// Past its bound the cache is dropped, for a long-running process.\n    11\ttype keptCache[V any] struct {\n    12\t\tmu      sync.Mutex\n    13\t\tentries map[string]*keptEntry[V]\n    14\t\tbound   int\n    15\t}\n    16\t\n    17\ttype keptEntry[V any] struct {\n    18\t\tready chan struct{}\n    19\t\tvalue V\n    20\t\tkept  bool\n    21\t}\n    22\t\n    23\tfunc newKeptCache[V any](bound int) *keptCache[V] {\n    24\t\treturn &keptCache[V]{entries: map[string]*keptEntry[V]{}, bound: bound}\n    25\t}\n    26\t\n    27\t// get returns the kept value of key, or computes it; compute reports whether\n    28\t// its result may be kept.\n    29\tfunc (c *keptCache[V]) get(key string, compute func() (V, bool)) V {\n    30\t\tc.mu.Lock()\n    31\t\tif entry, ok := c.entries[key]; ok {\n    32\t\t\tc.mu.Unlock()\n    33\t\t\t<-entry.ready\n    34\t\t\tif entry.kept {\n    35\t\t\t\treturn entry.value\n    36\t\t\t}\n    37\t\t\tvalue, _ := compute()\n    38\t\t\treturn value\n    39\t\t}\n    40\t\tif len(c.entries) >= c.bound {\n    41\t\t\tc.entries = map[string]*keptEntry[V]{}\n    42\t\t}\n    43\t\tentry := &keptEntry[V]{ready: make(chan struct{})}\n    44\t\tc.entries[key] = entry\n    45\t\tc.mu.Unlock()\n    46\t\tvalue, keep := compute()\n    47\t\tc.mu.Lock()\n    48\t\tentry.value, entry.kept = value, keep\n    49\t\tif !keep && c.entries[key] == entry {\n    50\t\t\tdelete(c.entries, key)\n    51\t\t}\n    52\t\tc.mu.Unlock()\n    53\t\tclose(entry.ready)\n    54\t\treturn value\n    55\t}\n    56\t\n    57\tfunc (c *keptCache[V]) clear() {\n    58\t\tc.mu.Lock()\n    59\t\tc.entries = map[string]*keptEntry[V]{}\n    60\t\tc.mu.Unlock()\n    61\t}\n    62\t\n    63\tfunc (c *keptCache[V]) len() int {\n    64\t\tc.mu.Lock()\n    65\t\tdefer c.mu.Unlock()\n    66\t\treturn len(c.entries)\n    67\t}\n---\ntype: decision-log\nslug: adr-shared-worktree-runtime-review\nowner: @pose-maintainers\nsensitivity: public-internal\ncreated_at: 2026-10-14\nlast_reviewed_at: 2026-10-14\nexpires_at: 2027-01-12\nsource_refs:\n  spec: \"pose-consolidation-batch-14-authoring\"\n  workflow: \"documentation-update\"\n  commands: [\"pose lint-spec pose-consolidation-batch-14-authoring --strict\"]\n  external_sources: []  # [{url: \"\", accessed_at: \"YYYY-MM-DD\"}]\n---\n\n# decision-log: adr-shared-worktree-runtime-review\n\n## Context\n\nReview the [domain/runtime proposal](../adr/2026-10-14-shared-domain-and-optional-worktree-runtime.md)\nfor B31/B33/B35 before functional start, preserving the accepted trust, disclosure\nand scoped-reader boundaries.\n\n## Current state\n\nLast reviewed: 2026-10-14. Proposal is Proposed; specs draft, no IPC/cache/runtime\nor adoption implemented. TTL of 90 days covers staged documentary authoring and\nthe contract review before functional execution; reassess when design/scope changes.\nThe durable rationale stays in the ADR, not in this expiring operational note.\n\n## Next checks\n\nResolve interface/envelope/version compatibility, route/producer inventory, local\nIPC identity/permissions/platforms, cache accounting/view ownership and measured\nQoS thresholds. Execute planned mutation/race/parity/attach/fallback cases only\nwhen the implementation scope is authorized. Lint/merge do not qualify runtime.\n\n## Risks\n\nShared mutable fields can contaminate reads; entry counts do not bound RAM. MCP\nstdio/UID/cache hits are not authority; watch hints are not current generation.\nAmbiguous effects cannot be retried in fallback without receipt/reconciliation.\n\n## Next owner\n\n@pose-maintainers under the existing contract authority, without a new universal\nhuman confirmation or default runtime adoption.\n\n## References\n\n- [Authoring spec](../specs/2026-10-14-pose-consolidation-batch-14-authoring.md)\n- [B31](../specs/2026-10-14-pose-common-domain-and-cli-mcp-handoff.md)\n- [B33](../specs/2026-10-14-pose-bounded-isolated-graph-caches.md)\n- [B35](../specs/2026-10-14-pose-optional-worktree-runtime.md)\n","exit_code":0,"status":"completed"}}
