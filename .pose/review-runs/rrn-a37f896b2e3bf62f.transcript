{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc \"pose suggest review --path pose-mcp; cat pose-mcp/internal/pose/kept_cache_test.go pose-mcp/internal/pose/current_material_cache_test.go pose-mcp/internal/pose/release_snapshot_cache_test.go pose-mcp/internal/pose/review_bundle_header_cache_test.go; rg -n 'materialSetDigestAt|repositoryIsShallow' pose-mcp/internal/cli; rg --files .pose/knowledge | head -30\"","aggregated_output":"# POSE trail — review\n\nAvaliação técnica de PR/diff: escopo, contratos, segurança, validação.\n- Path:      pose-mcp → domain: backend-go (repo-map)\n- Workflow:  .pose/workflows/review.md\n- Skill:     pose-review\n- Rules:     .pose/rules/security.md, .pose/rules/documentation-style.md, .pose/rules/backend-go.md\n- Spec:      false\n- ADR:       false\n- Knowledge: consume=true, produce=handoff (quando aceitar risco residual ou condicionar merge)\n- Validation: exigir evidência de pose validate do implementador\npackage pose\n\nimport (\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n)\n\n// Review round 1 (F4): callers that miss the same key together compute it\n// once; the others wait for the first.\nfunc TestAKeptValueIsComputedOnceForConcurrentMisses(t *testing.T) {\n\tcache := newKeptCache[int](10)\n\tvar computed atomic.Int32\n\trelease := make(chan struct{})\n\tvar started sync.WaitGroup\n\tstarted.Add(1)\n\tvar wg sync.WaitGroup\n\tresults := make([]int, 8)\n\tfor i := range results {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tresults[i] = cache.get(\"k\", func() (int, bool) {\n\t\t\t\tif computed.Add(1) == 1 {\n\t\t\t\t\tstarted.Done()\n\t\t\t\t}\n\t\t\t\t<-release\n\t\t\t\treturn 42, true\n\t\t\t})\n\t\t}()\n\t}\n\tstarted.Wait()\n\tclose(release)\n\twg.Wait()\n\tif computed.Load() != 1 {\n\t\tt.Fatalf(\"eight concurrent misses computed %d times\", computed.Load())\n\t}\n\tfor i, v := range results {\n\t\tif v != 42 {\n\t\t\tt.Fatalf(\"caller %d got %d\", i, v)\n\t\t}\n\t}\n}\n\n// F4: a result the computation declines to keep is not shared; the next\n// caller computes again, and a later success is kept.\nfunc TestADeclinedKeptValueIsComputedAgain(t *testing.T) {\n\tcache := newKeptCache[int](10)\n\tcalls := 0\n\tcompute := func() (int, bool) {\n\t\tcalls++\n\t\treturn calls, calls >= 2\n\t}\n\tif v := cache.get(\"k\", compute); v != 1 {\n\t\tt.Fatalf(\"first %d\", v)\n\t}\n\tif v := cache.get(\"k\", compute); v != 2 {\n\t\tt.Fatalf(\"a declined result was reused: %d\", v)\n\t}\n\tif v := cache.get(\"k\", compute); v != 2 || calls != 2 {\n\t\tt.Fatalf(\"a kept result was computed again: %d after %d calls\", v, calls)\n\t}\n}\n\n// Review round 1 (F1): an unreadable material is asked again, and a\n// shallow checkout, which resolves no HEAD, is never kept.\nfunc TestAnUnreadableMaterialIsAskedAgain(t *testing.T) {\n\treads := 0\n\tanswer := MaterialDigestUnreadable\n\twithMaterialHooks(t, func(string) string { return \"0123456789012345678901234567890123456789\" }, func(string, string, MaterialInputs) string {\n\t\treads++\n\t\treturn answer\n\t})\n\tsets := materialSets(1)\n\tif got := withCurrentMaterial(\"/r\", sets)[0].MaterialDigest; got != MaterialDigestUnreadable {\n\t\tt.Fatalf(\"first %q\", got)\n\t}\n\tanswer = \"sha256:recovered\"\n\tif got := withCurrentMaterial(\"/r\", sets)[0].MaterialDigest; got != \"sha256:recovered\" || reads != 2 {\n\t\tt.Fatalf(\"the unreadable answer was kept: %q after %d reads\", got, reads)\n\t}\n}\npackage pose\n\nimport (\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc withMaterialHooks(t *testing.T, head func(string) string, at func(string, string, MaterialInputs) string) {\n\tt.Helper()\n\toldDigests, oldHead, oldAt := CurrentMaterialDigests, currentMaterialHead, currentMaterialAt\n\tCurrentMaterialDigests = nil\n\tSetCurrentMaterialAt(head, at)\n\tcurrentMaterialKept.clear()\n\tt.Cleanup(func() {\n\t\tCurrentMaterialDigests, currentMaterialHead, currentMaterialAt = oldDigests, oldHead, oldAt\n\t\tcurrentMaterialKept.clear()\n\t})\n}\n\nfunc materialSets(n int) []ChangeSet {\n\tsets := make([]ChangeSet, n)\n\tfor i := range sets {\n\t\tin := MaterialInputs{Names: []string{strings.Repeat(\"a\", i+1) + \".go\"}}\n\t\tsets[i] = ChangeSet{Spec: \"s\", MaterialDigest: \"sha256:indexed\", MaterialInputs: &in}\n\t}\n\treturn sets\n}\n\n// Spec pose-federated-proof-reads-each-input-once, R1: HEAD is resolved\n// once per graph, and the material of the same inputs at the same commit is\n// read from the tree once per process.\nfunc TestCurrentMaterialIsReadOncePerCommit(t *testing.T) {\n\theads, reads := 0, 0\n\twithMaterialHooks(t, func(string) string { heads++; return strings.Repeat(\"a\", 40) }, func(_, head string, in MaterialInputs) string {\n\t\treads++\n\t\treturn \"sha256:\" + head[:4] + in.Names[0]\n\t})\n\tsets := materialSets(5)\n\tfirst := withCurrentMaterial(\"/r\", sets)\n\tsecond := withCurrentMaterial(\"/r\", sets)\n\tif heads != 2 || reads != 5 {\n\t\tt.Fatalf(\"heads=%d reads=%d, want 2 and 5\", heads, reads)\n\t}\n\tfor i := range first {\n\t\tif first[i].MaterialDigest != second[i].MaterialDigest || first[i].MaterialDigest == \"sha256:indexed\" {\n\t\t\tt.Fatalf(\"set %d: %q then %q\", i, first[i].MaterialDigest, second[i].MaterialDigest)\n\t\t}\n\t}\n}\n\n// R2: a HEAD that moved is read at its new commit.\nfunc TestCurrentMaterialFollowsAMovedHead(t *testing.T) {\n\thead := strings.Repeat(\"a\", 40)\n\twithMaterialHooks(t, func(string) string { return head }, func(_, at string, in MaterialInputs) string { return \"sha256:\" + at[:1] })\n\tsets := materialSets(1)\n\tbefore := withCurrentMaterial(\"/r\", sets)[0].MaterialDigest\n\thead = strings.Repeat(\"b\", 40)\n\tafter := withCurrentMaterial(\"/r\", sets)[0].MaterialDigest\n\tif before != \"sha256:a\" || after != \"sha256:b\" {\n\t\tt.Fatalf(\"before %q after %q\", before, after)\n\t}\n}\n\n// R3: an unresolvable HEAD reads the tree of HEAD for each set and keeps\n// nothing.\nfunc TestCurrentMaterialWithoutAHeadIsNotKept(t *testing.T) {\n\treads := 0\n\twithMaterialHooks(t, func(string) string { return \"\" }, func(_, at string, in MaterialInputs) string {\n\t\treads++\n\t\tif at != \"HEAD\" {\n\t\t\tt.Fatalf(\"read at %q, want HEAD\", at)\n\t\t}\n\t\treturn \"sha256:head\"\n\t})\n\tsets := materialSets(2)\n\twithCurrentMaterial(\"/r\", sets)\n\twithCurrentMaterial(\"/r\", sets)\n\tif reads != 4 {\n\t\tt.Fatalf(\"reads=%d, want 4\", reads)\n\t}\n}\n\n// R4: the kept digests of a long-running process are bounded.\nfunc TestCurrentMaterialKeptDigestsAreBounded(t *testing.T) {\n\thead := 0\n\twithMaterialHooks(t, func(string) string { head++; return strings.Repeat(string(rune('a'+head%6)), 40) }, func(string, string, MaterialInputs) string { return \"sha256:x\" })\n\told := currentMaterialKept.bound\n\tcurrentMaterialKept.bound = 3\n\tt.Cleanup(func() { currentMaterialKept.bound = old })\n\tfor i := 0; i < 10; i++ {\n\t\twithCurrentMaterial(\"/r\", materialSets(1))\n\t}\n\tkept := currentMaterialKept.len()\n\tif kept > 3 {\n\t\tt.Fatalf(\"%d digests kept past a bound of 3\", kept)\n\t}\n}\npackage pose\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\n// Spec pose-federated-proof-reads-each-input-once, R5: the snapshot of a\n// tag at a commit is read from git once per process; a second read of that\n// commit needs no git.\nfunc TestAReleaseSnapshotIsReadOncePerCommit(t *testing.T) {\n\tr := newReleaseRepo(t, \"v1.0.0\")\n\trelGit(t, r.root, \"tag\", \"v1.0.0\")\n\tcommit, annotated, err := ResolveReleaseTag(r.root, \"v1.0.0\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfirst, err := readReleaseSnapshotAtCommit(r.root, \"v1.0.0\", commit, annotated)\n\tif err != nil || !first.Intact() {\n\t\tt.Fatalf(\"first read: %+v %v\", first, err)\n\t}\n\t// Without the repository's objects, only the kept snapshot can answer.\n\tgit := filepath.Join(r.root, \".git\")\n\tif err := os.Rename(git, git+\".away\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer os.Rename(git+\".away\", git)\n\tsecond, err := readReleaseSnapshotAtCommit(r.root, \"v1.0.0\", commit, annotated)\n\tif err != nil || !second.Intact() || second.ManifestDigest != first.ManifestDigest {\n\t\tt.Fatalf(\"the second read of the same commit went back to git: %+v %v\", second, err)\n\t}\n}\n\n// R5: each reader receives its own copy; changing one does not change what\n// the next reader receives.\nfunc TestAKeptReleaseSnapshotIsCopiedToEachReader(t *testing.T) {\n\tr := newReleaseRepo(t, \"v1.0.0\")\n\trelGit(t, r.root, \"tag\", \"v1.0.0\")\n\tfirst, err := ReadReleaseSnapshot(r.root, \"v1.0.0\")\n\tif err != nil || first.Manifest == nil || len(first.Manifest.Fragments) == 0 {\n\t\tt.Fatalf(\"first read: %+v %v\", first, err)\n\t}\n\tfirst.Gaps = append(first.Gaps, \"changed by a reader\")\n\tfirst.Manifest.Fragments[0].Spec = \"changed\"\n\tsecond, err := ReadReleaseSnapshot(r.root, \"v1.0.0\")\n\tif err != nil || len(second.Gaps) != 0 || second.Manifest.Fragments[0].Spec != \"alpha\" {\n\t\tt.Fatalf(\"a reader's change reached the next reader: %+v %v\", second, err)\n\t}\n}\n\n// R5: a tag moved to another commit is read at that commit.\nfunc TestAMovedReleaseTagIsReadAtItsNewCommit(t *testing.T) {\n\tr := newReleaseRepo(t, \"v1.0.0\")\n\trelGit(t, r.root, \"tag\", \"v1.0.0\")\n\tbefore, err := ReadReleaseSnapshot(r.root, \"v1.0.0\")\n\tif err != nil || !before.Intact() {\n\t\tt.Fatalf(\"before: %+v %v\", before, err)\n\t}\n\trelWrite(t, r.root, \".pose/releases/v1.0.0/manifest.json\", \"{}\\n\")\n\tr.commit(t, \"break the manifest\")\n\trelGit(t, r.root, \"tag\", \"-f\", \"v1.0.0\")\n\tafter, err := ReadReleaseSnapshot(r.root, \"v1.0.0\")\n\tif after.Commit == before.Commit || after.Intact() {\n\t\tt.Fatalf(\"the moved tag was read from the old commit's snapshot: %+v %v\", after, err)\n\t}\n}\n\n// R5: a git read that fails is asked again, not kept as the commit's answer.\nfunc TestAFailedReleaseSnapshotReadIsNotKept(t *testing.T) {\n\tr := newReleaseRepo(t, \"v1.0.0\")\n\trelGit(t, r.root, \"tag\", \"v1.0.0\")\n\tcommit, annotated, err := ResolveReleaseTag(r.root, \"v1.0.0\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit := filepath.Join(r.root, \".git\")\n\tif err := os.Rename(git, git+\".away\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := readReleaseSnapshotAtCommit(r.root, \"v1.0.0\", commit, annotated); err == nil {\n\t\tt.Fatal(\"a read without the repository succeeded\")\n\t}\n\tif err := os.Rename(git+\".away\", git); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif snap, err := readReleaseSnapshotAtCommit(r.root, \"v1.0.0\", commit, annotated); err != nil || !snap.Intact() {\n\t\tt.Fatalf(\"the failed read was kept: %+v %v\", snap, err)\n\t}\n}\n\n// R6: a tag naming something that is not a commit is refused the same way\n// on every read, and a tag recreated as annotated reads as annotated.\nfunc TestAReleaseTagPeelIsKeptPerObject(t *testing.T) {\n\tr := newReleaseRepo(t, \"v1.0.0\")\n\ttree := relGit(t, r.root, \"rev-parse\", \"HEAD^{tree}\")\n\trelGit(t, r.root, \"tag\", \"v1.0.0\", tree)\n\tfor i := 0; i < 2; i++ {\n\t\tif _, _, err := ResolveReleaseTag(r.root, \"v1.0.0\"); !errors.Is(err, ErrReleaseTagNotCommit) {\n\t\t\tt.Fatalf(\"read %d: a tag of a tree resolved: %v\", i, err)\n\t\t}\n\t}\n\trelGit(t, r.root, \"tag\", \"-d\", \"v1.0.0\")\n\trelGit(t, r.root, \"tag\", \"v1.0.0\")\n\tif _, annotated, err := ResolveReleaseTag(r.root, \"v1.0.0\"); err != nil || annotated {\n\t\tt.Fatalf(\"lightweight: %v %v\", annotated, err)\n\t}\n\trelGit(t, r.root, \"tag\", \"-d\", \"v1.0.0\")\n\trelGit(t, r.root, \"tag\", \"-a\", \"v1.0.0\", \"-m\", \"release\")\n\tif _, annotated, err := ResolveReleaseTag(r.root, \"v1.0.0\"); err != nil || !annotated {\n\t\tt.Fatalf(\"annotated: %v %v\", annotated, err)\n\t}\n}\n\n// R7: a tag resolved from the one listing of the tags' refs answers as\n// ResolveReleaseTag answers it alone: lightweight, annotated, missing, and\n// not a commit.\nfunc TestAListedReleaseTagResolvesAsAloneOne(t *testing.T) {\n\tr := newReleaseRepo(t, \"v1.0.0\")\n\tr.addVersion(t, \"v1.1.0\")\n\tr.addVersion(t, \"v1.2.0\")\n\trelGit(t, r.root, \"tag\", \"v1.0.0\")\n\trelGit(t, r.root, \"tag\", \"-a\", \"v1.1.0\", \"-m\", \"release\")\n\trelGit(t, r.root, \"tag\", \"v1.2.0\", relGit(t, r.root, \"rev-parse\", \"HEAD^{tree}\"))\n\trefs, ok := releaseTagRefs(r.root)\n\tif !ok {\n\t\tt.Fatal(\"the tags could not be listed\")\n\t}\n\tfor _, tag := range []string{\"v1.0.0\", \"v1.1.0\", \"v1.2.0\", \"v9.9.9\"} {\n\t\taloneCommit, aloneAnnotated, aloneErr := ResolveReleaseTag(r.root, tag)\n\t\tcommit, annotated, err := resolveListedReleaseTag(r.root, tag, refs)\n\t\tif commit != aloneCommit || annotated != aloneAnnotated || errors.Is(err, ErrReleaseTagMissing) != errors.Is(aloneErr, ErrReleaseTagMissing) || errors.Is(err, ErrReleaseTagNotCommit) != errors.Is(aloneErr, ErrReleaseTagNotCommit) || (err == nil) != (aloneErr == nil) {\n\t\t\tt.Fatalf(\"%s: listed %q %v %v, alone %q %v %v\", tag, commit, annotated, err, aloneCommit, aloneAnnotated, aloneErr)\n\t\t}\n\t}\n}\n\n// Review round 1 (F3): a peel that failed is asked again once the object it\n// needs is available.\nfunc TestAFailedReleaseTagPeelIsAskedAgain(t *testing.T) {\n\tr := newReleaseRepo(t, \"v1.0.0\")\n\trelGit(t, r.root, \"tag\", \"v1.0.0\")\n\tobject := relGit(t, r.root, \"rev-parse\", \"refs/tags/v1.0.0\")\n\tgit := filepath.Join(r.root, \".git\")\n\tif err := os.Rename(git, git+\".away\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, _, err := peelReleaseTagObject(r.root, \"v1.0.0\", object); err == nil {\n\t\tt.Fatal(\"a peel without the repository succeeded\")\n\t}\n\tif err := os.Rename(git+\".away\", git); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif commit, _, err := peelReleaseTagObject(r.root, \"v1.0.0\", object); err != nil || commit != object {\n\t\tt.Fatalf(\"the failed peel was kept: %q %v\", commit, err)\n\t}\n}\n\n// Review round 1 (F2): a snapshot with gaps is read again, not kept.\nfunc TestASnapshotWithGapsIsReadAgain(t *testing.T) {\n\tr := newReleaseRepo(t, \"v1.0.0\")\n\trelWrite(t, r.root, \".pose/policy/release.json\", \"{}\\n\")\n\tr.commit(t, \"a release policy that does not satisfy its contract\")\n\trelGit(t, r.root, \"tag\", \"v1.0.0\")\n\tcommit, annotated, err := ResolveReleaseTag(r.root, \"v1.0.0\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfirst, _ := readReleaseSnapshotAtCommit(r.root, \"v1.0.0\", commit, annotated)\n\tif len(first.Gaps) == 0 {\n\t\tt.Fatalf(\"the fixture has no gap: %+v\", first)\n\t}\n\tgit := filepath.Join(r.root, \".git\")\n\tif err := os.Rename(git, git+\".away\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer os.Rename(git+\".away\", git)\n\tif _, err := readReleaseSnapshotAtCommit(r.root, \"v1.0.0\", commit, annotated); err == nil {\n\t\tt.Fatal(\"a snapshot with gaps was answered from the cache\")\n\t}\n}\npackage pose\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\n// Spec pose-federated-proof-reads-each-input-once, R8: what a bundle's bytes\n// say about their scope is parsed once per content; each file keeps its own\n// artifact path, and a changed content is parsed again.\nfunc TestABundleHeaderIsParsedOncePerContent(t *testing.T) {\n\tdir := t.TempDir()\n\twrite := func(name, body string) {\n\t\tt.Helper()\n\t\tif err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o600); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tgood := `{\"payload\":{\"scope\":{\"ref\":\"spec:alpha\"}}}`\n\twrite(\"rvb-1.json\", good)\n\twrite(\"rvb-2.json\", good)\n\tfiles := NativeFiles()\n\tfirst := readReviewBundleHeader(files, dir, \"rvb-1.json\")\n\tsecond := readReviewBundleHeader(files, dir, \"rvb-2.json\")\n\tif first.owner != \"spec:alpha\" || second.owner != \"spec:alpha\" || first.loss != nil || second.loss != nil {\n\t\tt.Fatalf(\"owners %q %q losses %v %v\", first.owner, second.owner, first.loss, second.loss)\n\t}\n\twrite(\"rvb-1.json\", `{\"payload\":{\"scope\":{\"ref\":\"spec:beta\"}}}`)\n\tif changed := readReviewBundleHeader(files, dir, \"rvb-1.json\"); changed.owner != \"spec:beta\" {\n\t\tt.Fatalf(\"a changed content kept the old scope: %q\", changed.owner)\n\t}\n\tbad := `{\"payload\":{\"scope\":{\"ref\":\"spec:alpha\"}},\"payload\":{\"scope\":{\"ref\":\"spec:beta\"}}}`\n\twrite(\"rvb-3.json\", bad)\n\twrite(\"rvb-4.json\", bad)\n\ta := readReviewBundleHeader(files, dir, \"rvb-3.json\")\n\tb := readReviewBundleHeader(files, dir, \"rvb-4.json\")\n\tif a.loss == nil || b.loss == nil || a.loss.Kind != b.loss.Kind || a.loss.Detail != b.loss.Detail {\n\t\tt.Fatalf(\"the loss was not kept whole: %+v %+v\", a.loss, b.loss)\n\t}\n\tif a.loss.Artifact != \".pose/review-bundles/rvb-3.json\" || b.loss.Artifact != \".pose/review-bundles/rvb-4.json\" {\n\t\tt.Fatalf(\"a kept loss named another file: %q %q\", a.loss.Artifact, b.loss.Artifact)\n\t}\n}\npose-mcp/internal/cli/artifact_integrity.go:398:\tmaterialDigest := materialSetDigestAt(gitOutput, root, materialHead, materialInputs)\npose-mcp/internal/cli/artifact_integrity.go:1470:// materialSetDigestAt reads the head tree entries of every path a change set\npose-mcp/internal/cli/artifact_integrity.go:1475:func materialSetDigestAt(gitOutput func(int, ...string) ([]byte, error), root, head string, in posemodel.MaterialInputs) string {\npose-mcp/internal/cli/artifact_integrity.go:1477:\tif shallow, err := repositoryIsShallow(gitOutput, root); err != nil || shallow {\npose-mcp/internal/cli/artifact_integrity.go:1536:// repositoryIsShallow reports whether the checkout lacks history. A shallow\npose-mcp/internal/cli/artifact_integrity.go:1540:func repositoryIsShallow(gitOutput func(int, ...string) ([]byte, error), root string) (bool, error) {\npose-mcp/internal/cli/material_engine.go:16:\t\tif shallow, err := repositoryIsShallow(git, root); err != nil || shallow {\npose-mcp/internal/cli/material_engine.go:26:\t\treturn materialSetDigestAt(git, root, head, in)\npose-mcp/internal/cli/change_set_root_test.go:255:\tif got := materialSetDigestAt(git, shallow, \"HEAD\", posemodel.MaterialInputsOf(paths)); got != posemodel.MaterialDigestUnreadable {\npose-mcp/internal/cli/change_set_root_test.go:259:\tif got := materialSetDigestAt(whole, origin, \"HEAD\", posemodel.MaterialInputsOf(paths)); got == \"\" || got == posemodel.MaterialDigestUnreadable {\npose-mcp/internal/cli/change_set_root_test.go:279:\tif shallow, err := repositoryIsShallow(git, clone); err != nil || !shallow {\npose-mcp/internal/cli/change_set_root_test.go:283:\tif shallow, err := repositoryIsShallow(git, clone); err != nil || shallow {\n.pose/knowledge/2026-10-27-handoff-delegation-mcp-round5.md\n.pose/knowledge/2026-08-15-decision-log-github-issue-closing-keyword-format.md\n.pose/knowledge/2026-10-14-decision-log-adr-release-temporal-evidence-review.md\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md\n.pose/knowledge/2026-10-18-handoff-pose-b06-source-coverage-closeout.md\n.pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md\n.pose/knowledge/2026-10-20-handoff-pose-b07-implementation.md\n.pose/knowledge/2026-10-27-handoff-delegated-rounds-legacy-status.md\n.pose/knowledge/2026-10-28-handoff-delegated-conclusions-round4.md\n.pose/knowledge/archive/2026-09-24-handoff-multirepo-review-continuation.md\n.pose/knowledge/2026-10-14-decision-log-adr-shared-worktree-runtime-review.md\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md\n.pose/knowledge/archive/2026-08-13-decision-log-install-one-liner-safe-form.md\n.pose/knowledge/2026-10-13-decision-log-review-assurance-requires-cryptographic-proof.md\n.pose/knowledge/archive/2026-08-03-decision-log-project-agnostic-assessment-evidence.md\n.pose/knowledge/README.md\n.pose/knowledge/2026-08-13-decision-log-adr-component-aware-review-plans-review.md\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md\n.pose/knowledge/archive/2026-08-13-handoff-pr15-component-aware-review-provenance.md\n.pose/knowledge/2026-08-14-decision-log-escalation-validate-native.md\n.pose/knowledge/2026-10-26-handoff-delegation-observation-round4.md\n.pose/knowledge/2026-10-24-decision-log-action-recovery-intent-and-refusal.md\n.pose/knowledge/2026-10-13-decision-log-action-answer-proof-and-historical-time.md\n.pose/knowledge/2026-10-26-handoff-delegation-routing-round3.md\n.pose/knowledge/2026-11-02-handoff-roadmap-v7-independent-outcomes-20261102.md\n.pose/knowledge/2026-08-13-decision-log-adr-sealed-review-bundles-review.md\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md\n","exit_code":0,"status":"completed"}}
