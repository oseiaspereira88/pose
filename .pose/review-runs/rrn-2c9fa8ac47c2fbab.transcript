{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '40,95p' && rg -n 'func validateReviewDraft|reviewDraftLine' pose-mcp/internal/pose/review_rounds.go\"","aggregated_output":"    40\t\treviewRoundPrefix = regexp.MustCompile(`^R[0-9]+-`)\n    41\t\treviewCarriedID   = regexp.MustCompile(`^R[0-9]{1,6}-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n    42\t\t// reviewDraftOpening is any fence line that names pose-draft.\n    43\t\treviewDraftOpening = regexp.MustCompile(\"^(`{3,}|~{3,})\\\\s*pose-draft\")\n    44\t)\n    45\t\n    46\t// ReviewDraftFinding is one finding a draft reports.\n    47\ttype ReviewDraftFinding struct {\n    48\t\tID          string `json:\"id\"`\n    49\t\tSeverity    string `json:\"severity\"`\n    50\t\tDisposition string `json:\"disposition\"`\n    51\t\tFile        string `json:\"file,omitempty\"`\n    52\t\tLine        int    `json:\"line,omitempty\"`\n    53\t\tSummary     string `json:\"summary\"`\n    54\t\t// Action, Owner and ReviewBy let a follow-up become an accepted risk in\n    55\t\t// the attestation the engine records (spec\n    56\t\t// pose-delegated-review-conclusions R1).\n    57\t\tAction   string `json:\"action,omitempty\"`\n    58\t\tOwner    string `json:\"owner,omitempty\"`\n    59\t\tReviewBy string `json:\"review_by,omitempty\"`\n    60\t}\n    61\t\n    62\t// ReviewDraftCriterion answers one criterion of the plan, as the reviewer of\n    63\t// a recorded attestation does (spec pose-delegated-review-conclusions R1).\n    64\ttype ReviewDraftCriterion struct {\n    65\t\tID          string `json:\"id\"`\n    66\t\tDisposition string `json:\"disposition\"`\n    67\t\tEvidence    string `json:\"evidence,omitempty\"`\n    68\t\tRationale   string `json:\"rationale,omitempty\"`\n    69\t\t// Mappings answer the structural facts the criterion is responsible for,\n    70\t\t// as `--criterion` mappings do; the writer's gate judges them (review\n    71\t\t// round 1, B4).\n    72\t\tMappings []ReviewCriterionMapping `json:\"mappings,omitempty\"`\n    73\t}\n    74\t\n    75\t// ReviewDraftTool is the disposition of one tool the plan requires.\n    76\ttype ReviewDraftTool struct {\n    77\t\tID          string `json:\"id\"`\n    78\t\tComponent   string `json:\"component,omitempty\"`\n    79\t\tDisposition string `json:\"disposition\"`\n    80\t\tEvidence    string `json:\"evidence,omitempty\"`\n    81\t\tRationale   string `json:\"rationale,omitempty\"`\n    82\t}\n    83\t\n    84\t// ReviewDraftPrior is a draft's account of one prior finding (R3, R4).\n    85\ttype ReviewDraftPrior struct {\n    86\t\tID       string `json:\"id\"`\n    87\t\tStatus   string `json:\"status\"`\n    88\t\tEvidence string `json:\"evidence\"`\n    89\t}\n    90\t\n    91\t// ReviewDraft is the pose-draft block of a reviewer's final message.\n    92\ttype ReviewDraft struct {\n    93\t\tSchema        string               `json:\"schema\"`\n    94\t\tDecision      string               `json:\"decision\"`\n    95\t\tFindings      []ReviewDraftFinding `json:\"findings\"`\n238:func validateReviewDraft(d ReviewDraft) error {\n","exit_code":0,"status":"completed"}}
