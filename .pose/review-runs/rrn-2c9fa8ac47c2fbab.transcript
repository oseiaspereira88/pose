{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_draft_check.go | sed -n '1,115p' && rg -n 'draft-context|ReviewDraftContextEnv' pose-mcp/internal/cli/review_draft_check.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_draft_check.go | sed -n '1,115p' && rg -n 'draft-context|ReviewDraftContextEnv' pose-mcp/internal/cli/review_draft_check.go\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Draft check (spec pose-review-readiness-before-seal R3): the reasons the\n     4\t// conclusion step and the attestation preflight would refuse a reviewer's\n     5\t// draft, computed before the run ends and without writing anything. It\n     6\t// reuses the same parsers and content checks; only the run's own proof,\n     7\t// signature and identity, which do not exist yet, are left out.\n     8\t//\n     9\t// A sealed checkout holds the subject, not the bundle sealed over it nor the\n    10\t// run ledger, so the dispatch writes both to the run's private directory and\n    11\t// names it in ReviewDraftContextEnv.\n    12\t\n    13\timport (\n    14\t\t\"encoding/json\"\n    15\t\t\"fmt\"\n    16\t\t\"os\"\n    17\t\t\"path/filepath\"\n    18\t\t\"strings\"\n    19\t\t\"time\"\n    20\t)\n    21\t\n    22\t// ReviewDraftContextEnv names the file holding the bundle and round a draft\n    23\t// is checked against inside a delegated review.\n    24\tconst ReviewDraftContextEnv = \"POSE_REVIEW_DRAFT_CONTEXT\"\n    25\t\n    26\t// ReviewCLIEnv names the executable of the engine that dispatched a review,\n    27\t// so the reviewer checks its draft with it and not with another installed\n    28\t// `pose` (review round 1).\n    29\tconst ReviewCLIEnv = \"POSE_REVIEW_CLI\"\n    30\t\n    31\tconst reviewDraftContextSchema = \"pose.review-draft-context/v1\"\n    32\t\n    33\t// ReviewDraftContext is what a draft is judged against: the sealed bundle and\n    34\t// the findings its round must account for.\n    35\ttype ReviewDraftContext struct {\n    36\t\tSchema string              `json:\"schema\"`\n    37\t\tBundle ReviewBundle        `json:\"bundle\"`\n    38\t\tRound  int                 `json:\"round\"`\n    39\t\tOpen   []ReviewOpenFinding `json:\"open,omitempty\"`\n    40\t}\n    41\t\n    42\t// ReviewDraftContextFor builds the context of bundle from the run ledger.\n    43\tfunc (s Store) ReviewDraftContextFor(bundle ReviewBundle) (ReviewDraftContext, error) {\n    44\t\tround, err := s.ReviewRoundOf(bundle)\n    45\t\tif err != nil {\n    46\t\t\treturn ReviewDraftContext{}, err\n    47\t\t}\n    48\t\treturn ReviewDraftContext{Schema: reviewDraftContextSchema, Bundle: bundle, Round: round.Number, Open: round.Open}, nil\n    49\t}\n    50\t\n    51\t// writeReviewDraftContext writes ctx under dir and returns its path.\n    52\tfunc writeReviewDraftContext(dir string, ctx ReviewDraftContext) (string, error) {\n    53\t\traw, err := json.Marshal(ctx)\n    54\t\tif err != nil {\n    55\t\t\treturn \"\", err\n    56\t\t}\n    57\t\tpath := filepath.Join(dir, \"pose-review-draft-context.json\")\n    58\t\treturn path, os.WriteFile(path, raw, 0o600)\n    59\t}\n    60\t\n    61\t// ReadReviewDraftContext reads a context file a dispatch wrote.\n    62\tfunc ReadReviewDraftContext(path string) (ReviewDraftContext, error) {\n    63\t\tvar ctx ReviewDraftContext\n    64\t\traw, err := os.ReadFile(path)\n    65\t\tif err != nil {\n    66\t\t\treturn ctx, err\n    67\t\t}\n    68\t\tif err := json.Unmarshal(raw, &ctx); err != nil {\n    69\t\t\treturn ctx, fmt.Errorf(\"pose: reading draft context %s: %w\", path, err)\n    70\t\t}\n    71\t\tif ctx.Schema != reviewDraftContextSchema || ctx.Bundle.BundleID == \"\" {\n    72\t\t\treturn ctx, fmt.Errorf(\"pose: %s is not a review draft context\", path)\n    73\t\t}\n    74\t\treturn ctx, nil\n    75\t}\n    76\t\n    77\t// CheckReviewDraft returns every reason a draft for ref would be refused at\n    78\t// conclusion, or nil when none applies. ref is a bundle id, or a run id whose\n    79\t// bundle is used.\n    80\tfunc (s Store) CheckReviewDraft(ref, output string, now time.Time) ([]string, error) {\n    81\t\tbundleID := ref\n    82\t\tif strings.HasPrefix(ref, \"rrn-\") {\n    83\t\t\trun, err := s.LoadProvenanceReviewRun(ref)\n    84\t\t\tif err != nil {\n    85\t\t\t\treturn nil, err\n    86\t\t\t}\n    87\t\t\tbundleID = run.BundleID\n    88\t\t}\n    89\t\tbundle, err := s.LoadReviewBundle(bundleID)\n    90\t\tif err != nil {\n    91\t\t\treturn nil, err\n    92\t\t}\n    93\t\tctx, err := s.ReviewDraftContextFor(bundle)\n    94\t\tif err != nil {\n    95\t\t\treturn nil, err\n    96\t\t}\n    97\t\treturn s.CheckReviewDraftIn(ctx, output, now), nil\n    98\t}\n    99\t\n   100\t// CheckReviewDraftIn judges output against ctx.\n   101\tfunc (s Store) CheckReviewDraftIn(ctx ReviewDraftContext, output string, now time.Time) []string {\n   102\t\tvar reasons []string\n   103\t\tdraft, err := ParseReviewDraft(output)\n   104\t\tswitch {\n   105\t\tcase err != nil:\n   106\t\t\treasons = append(reasons, \"the conclusion cannot be read: \"+err.Error())\n   107\t\tcase draft == nil:\n   108\t\t\treasons = append(reasons, \"the final message carries no pose-draft block\")\n   109\t\t}\n   110\t\tif err == nil {\n   111\t\t\tround := ReviewRound{Number: ctx.Round, Open: ctx.Open}\n   112\t\t\tif problems := ValidateRoundDraft(round, output); len(problems) > 0 {\n   113\t\t\t\treasons = append(reasons, \"the draft does not account for its round: \"+strings.Join(problems, \"; \"))\n   114\t\t\t}\n   115\t\t}\n48:\tif contextPath := os.Getenv(posemodel.ReviewDraftContextEnv); contextPath != \"\" {\n","exit_code":0,"status":"completed"}}
