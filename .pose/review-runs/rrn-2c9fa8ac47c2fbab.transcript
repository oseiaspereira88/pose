 entries {\n   315\t\t\tif IsPublisherStaging(e.Name()) {\n   316\t\t\t\tcontinue\n   317\t\t\t}\n   318\t\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n   319\t\t\t\tcontinue\n   320\t\t\t}\n   321\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   322\t\t\t\treturn nil, fmt.Errorf(\"unknown attempt artifact %s\", e.Name())\n   323\t\t\t}\n   324\t\t\tvar a DelegatedReviewAttempt\n   325\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, rel, e.Name()), &a, budget); err != nil {\n   326\t\t\t\treturn nil, err\n   327\t\t\t}\n   328\t\t\tif a.SchemaVersion != 1 || a.BundleID != bundle || a.Ordinal != len(out)+1 || a.AttemptID != attemptIdentity(a) || e.Name() != fmt.Sprintf(\"%06d.json\", a.Ordinal) {\n   329\t\t\t\treturn nil, fmt.Errorf(\"invalid attempt reservation %s\", e.Name())\n   330\t\t\t}\n   331\t\t\tif _, err := time.Parse(time.RFC3339Nano, a.ReservedAt); err != nil {\n   332\t\t\t\treturn nil, err\n   333\t\t\t}\n   334\t\t\tout = append(out, a)\n   335\t\t}\n   336\t\t// Orphan receipts are an unknown history, never ignored.\n   337\t\tfor _, e := range entries {\n   338\t\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n   339\t\t\t\tfound := false\n   340\t\t\t\tfor _, a := range out {\n    25\t\t\"sync/atomic\"\n    26\t\t\"time\"\n    27\t)\n    28\t\n    29\tconst delegationActiveDir = reviewPrivateDir + \"/active\"\n    30\t\n    31\t// DelegationActiveRun is the marker of a run in progress.\n    32\ttype DelegationActiveRun struct {\n    33\t\tSchemaVersion int    `json:\"schema_version\"`\n    34\t\tAttemptID     string `json:\"attempt_id\"`\n    35\t\t// RunToken names this run of the attempt: a cancellation request carries\n    36\t\t// it, so a request meant for one run never stops another.\n    37\t\tRunToken  string         `json:\"run_token\"`\n    38\t\tResumes   string         `json:\"resumes,omitempty\"`\n    39\t\tLabel     string         `json:\"label,omitempty\"`\n    40\t\tPurpose   string         `json:\"purpose\"`\n    41\t\tAgent     string         `json:\"agent\"`\n    42\t\tScope     string         `json:\"scope\"`\n    43\t\tBundleID  string         `json:\"bundle_id\"`\n    44\t\tStartedAt string         `json:\"started_at\"`\n    45\t\tOwner     StartLockOwner `json:\"owner\"`\n    46\t\t// HeartbeatAt is rewritten every HeartbeatEvery seconds by the process\n    47\t\t// that runs the attempt (spec pose-delegated-review-completion-signal R4,\n    48\t\t// D2).\n    49\t\tHeartbeatAt    string `json:\"heartbeat_at,omitempty\"`\n    50\t\tHeartbeatEvery int    `json:\"heartbeat_every,omitempty\"`\n    51\t\t// StalledAt is computed by the reader from the stall claim the first\n    52\t\t// reader that found the run stalled published.\n    53\t\tStalledAt string `json:\"stalled_at,omitempty\"`\n    54\t\t// Liveness is computed by the reader: owner-active, owner-dead or owner-unknown.\n    55\t\tLiveness string `json:\"liveness,omitempty\"`\n    56\t\tDetail   string `json:\"detail,omitempty\"`\n    57\t\t// CancelRequested is computed by the reader.\n    58\t\tCancelRequested bool `json:\"cancel_requested,omitempty\"`\n    59\t\t// Round is the review round the run reviews (spec\n    60\t\t// pose-delegated-review-round-protocol R1).\n    61\t\tRound int `json:\"round,omitempty\"`\n    62\t}\n    63\t\n    64\tfunc (s Store) delegationActiveDir(create bool) (string, error) {\n    65\t\tif create {\n    66\t\t\tif _, err := ensureReviewArtifactDir(s.Root, reviewPrivateDir, true); err != nil {\n    67\t\t\t\treturn \"\", err\n    68\t\t\t}\n    69\t\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewPrivateDir))\n    70\t\t\tignore := filepath.Join(dir, \".gitignore\")\n    71\t\t\tif _, err := os.Lstat(ignore); errors.Is(err, os.ErrNotExist) {\n    72\t\t\t\tif err := PublishFile(ignore, []byte(\"*\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil && !errors.Is(err, os.ErrExist) {\n    73\t\t\t\t\treturn \"\", err\n    74\t\t\t\t}\n    75\t\t\t}\n    76\t\t}\n    77\t\treturn ensureReviewArtifactDir(s.Root, delegationActiveDir, create)\n    78\t}\n    79\t\n    80\tfunc validAttemptFileName(attempt string) bool {\n    81\t\treturn attempt != \"\" && len(attempt) <= 128 && !strings.ContainsAny(attempt, `/\\.`+\"\\x00\")\n    82\t}\n    83\t\n    84\t// markDelegationActive writes the marker and starts the cancellation watcher.\n    85\t// The returned stop removes both; cancelled reports whether a cancellation\n    86\t// request stopped the run.\n    87\t//\n    88\t// stop(true) stops the watcher and the heartbeat but keeps the marker: a run\n    89\t// whose record was not published leaves it, and it turns stalled once its\n    90\t// process is gone (spec pose-delegated-review-completion-signal R4, R5).\n    91\tfunc (s Store) markDelegationActive(run ReviewRun, cancel context.CancelFunc) (stop func(keepMarker ...bool), cancelled *atomic.Bool, err error) {\n    92\t\tcancelled = &atomic.Bool{}\n    93\t\tif !validAttemptFileName(run.AttemptID) {\n    94\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: attempt %q cannot name an active marker\", run.AttemptID)\n    95\t\t}\n    96\t\tdir, err := s.delegationActiveDir(true)\n    97\t\tif err != nil {\n    98\t\t\treturn func(...bool) {}, cancelled, err\n    99\t\t}\n   100\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + run.AttemptID, Worktree: s.Root, Operation: \"pose delegate \" + run.Purpose, PID: os.Getpid(), AcquiredAt: run.StartedAt}\n   101\t\towner.Host, _ = os.Hostname()\n   102\t\tidentifyStartLockProcess(&owner)\n   103\t\ttoken := make([]byte, 16)\n   104\t\tif _, err := rand.Read(token); err != nil {\n   105\t\t\treturn func(...bool) {}, cancelled, err\n   106\t\t}\n   107\t\tevery := delegationHeartbeatEvery\n   108\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: run.AttemptID, RunToken: hex.EncodeToString(token), Resumes: run.Resumes, Label: run.Label, Purpose: run.Purpose, Agent: run.Adapter, Scope: run.Scope, BundleID: run.BundleID, StartedAt: run.StartedAt, Owner: owner, Round: run.Round,\n   109\t\t\tHeartbeatAt: time.Now().UTC().Format(time.RFC3339Nano), HeartbeatEvery: int(every / time.Second)}\n   110\t\traw, _ := json.MarshalIndent(marker, \"\", \"  \")\n   111\t\tpath := filepath.Join(dir, run.AttemptID+\".json\")\n   112\t\trequest := cancelRequestPath(dir, marker)\n   113\t\tif err := PublishFile(path, append(raw, '\\n'), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n   114\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: another run of attempt %s is active: %w\", run.AttemptID, err)\n   115\t\t}\n   116\t\tdone, exited := make(chan struct{}), make(chan struct{})\n   117\t\tgo func() {\n   118\t\t\tdefer close(exited)\n   119\t\t\tticker := time.NewTicker(250 * time.Millisecond)\n   120\t\t\tdefer ticker.Stop()\n   121\t\t\theartbeat := time.NewTicker(every)\n   122\t\t\tdefer heartbeat.Stop()\n   123\t\t\tfor {\n   124\t\t\t\tselect {\n   125\t\t\t\tcase <-done:\n   126\t\t\t\t\treturn\n   127\t\t\t\tcase <-heartbeat.C:\n   128\t\t\t\t\t// Select picks among ready cases at random: once stop has\n   129\t\t\t\t\t// asked, no further heartbeat starts, so it waits for at\n   130\t\t\t\t\t// most the one in flight (review round 1, HB01).\n   131\t\t\t\t\tselect {\n   132\t\t\t\t\tcase <-done:\n   133\t\t\t\t\t\treturn\n   134\t\t\t\t\tdefault:\n   135\t\t\t\t\t}\n   230\t\t\treturn false\n   231\t\t}\n   232\t\t_, err := hex.DecodeString(token)\n   233\t\treturn err == nil\n   234\t}\n   235\t\n   236\t// ListDelegationActive reads the markers with the liveness of their owners,\n   237\t// and returns as losses the markers it cannot read: a run it cannot observe is\n   238\t// reported, never listed as running nor left out in silence.\n   239\tfunc (s Store) ListDelegationActive() ([]DelegationActiveRun, []string, error) {\n   240\t\tdir, err := s.delegationActiveDir(false)\n   241\t\tif errors.Is(err, os.ErrNotExist) {\n   242\t\t\treturn []DelegationActiveRun{}, nil, nil\n   243\t\t}\n   244\t\tif err != nil {\n   245\t\t\treturn nil, nil, err\n   246\t\t}\n   247\t\tentries, err := os.ReadDir(dir)\n   248\t\tif err != nil {\n   249\t\t\treturn nil, nil, err\n   250\t\t}\n   251\t\tout := []DelegationActiveRun{}\n   252\t\tvar lost []string\n   253\t\tfor _, e := range entries {\n   254\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   255\t\t\t\tcontinue\n   256\t\t\t}\n   257\t\t\traw, err := readLedgerRaw(filepath.Join(dir, e.Name()))\n   258\t\t\tif errors.Is(err, os.ErrNotExist) {\n   259\t\t\t\tcontinue // the run ended between the listing and the read\n   260\t\t\t}\n   261\t\t\tif err != nil {\n   262\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" could not be read: \"+err.Error())\n   263\t\t\t\tcontinue\n   264\t\t\t}\n   265\t\t\tvar marker DelegationActiveRun\n   266\t\t\tif json.Unmarshal(raw, &marker) != nil || marker.SchemaVersion != 1 || marker.AttemptID+\".json\" != e.Name() || !validRunToken(marker.RunToken) {\n   267\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" is not one this engine reads\")\n   268\t\t\t\tcontinue\n   269\t\t\t}\n   270\t\t\tmarker.Liveness, marker.Detail = probeStartLockOwner(marker.Owner)\n   271\t\t\tmarker.StalledAt = readDelegationStall(dir, marker)\n   272\t\t\tif marker.StalledAt == \"\" && delegationMarkerSilent(marker, time.Now()) && marker.Liveness == LockOwnerDead {\n   273\t\t\t\tmarker.StalledAt = recordDelegationStall(dir, marker)\n   274\t\t\t}\n   275\t\t\tif _, err := os.Lstat(cancelRequestPath(dir, marker)); err == nil {\n   276\t\t\t\tmarker.CancelRequested = true\n   277\t\t\t}\n   278\t\t\tout = append(out, marker)\n   279\t\t}\n   280\t\tsort.Slice(out, func(i, j int) bool {\n   281\t\t\treturn out[i].StartedAt < out[j].StartedAt || out[i].StartedAt == out[j].StartedAt && out[i].AttemptID < ou