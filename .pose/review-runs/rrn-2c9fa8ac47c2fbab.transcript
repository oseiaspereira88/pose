the digest the run names; it returns the problem, or \"\".\n  1745\tfunc (s Store) checkReviewRunTranscript(run ReviewRun) string {\n   330\t\t\t\t\treturn fmt.Errorf(\"surface %s: a command must be non-empty and bounded\", sf.Ref)\n   331\t\t\t\t}\n   332\t\t\t}\n   333\t\t\tobserved[sf.Ref] = true\n   334\t\t}\n   335\t\taccounted := map[string]bool{}\n   336\t\tfor _, p := range d.PriorFindings {\n   337\t\t\tswitch {\n   338\t\t\tcase !reviewCarriedID.MatchString(p.ID) || accounted[p.ID]:\n   339\t\t\t\treturn fmt.Errorf(\"prior finding id %q is not a unique carried identifier\", p.ID)\n   340\t\t\tcase p.Status != PriorFindingFixed && p.Status != PriorFindingPartial && p.Status != PriorFindingNotFixed && p.Status != PriorFindingSuperseded:\n   341\t\t\t\treturn fmt.Errorf(\"prior finding %s: status %q is not fixed, partial, not-fixed or superseded\", p.ID, p.Status)\n   342\t\t\tcase len(p.Evidence) > reviewDraftMaxText:\n   343\t\t\t\treturn fmt.Errorf(\"prior finding %s: evidence exceeds its bound\", p.ID)\n   344\t\t\t}\n   345\t\t\taccounted[p.ID] = true\n   346\t\t}\n   347\t\treturn nil\n   348\t}\n   349\t\n   350\t// ReviewOpenFinding is a finding a round must account for: its identity\n   351\t// across rounds, the round it was first reported in, its details and, when it\n   352\t// was carried, the account the last round gave it (R2, R5).\n   353\ttype ReviewOpenFinding struct {\n   354\t\tID          string\n   355\t\tRound       int\n   380\t}\n   381\t\n   382\t// concludingReviewRun is the run a round concluded with on bundle: of the\n   383\t// completed review runs of it that no run supersedes, the one that ended\n   384\t// last, the run id breaking a tie (review round 2, R2-F1).\n   385\tfunc concludingReviewRun(runs []ReviewRun, bundleID string) *ReviewRun {\n   386\t\tvar out *ReviewRun\n   387\t\tvar outEnded time.Time\n   388\t\tfor i := range runs {\n   389\t\t\tr := &runs[i]\n   390\t\t\tif r.BundleID != bundleID || r.Kind != ReviewBriefKindReview || r.Status != ReviewRunCompleted || r.SupersededBy != \"\" {\n   391\t\t\t\tcontinue\n   392\t\t\t}\n   393\t\t\tended, _ := time.Parse(time.RFC3339Nano, r.EndedAt)\n   394\t\t\tif out == nil || ended.After(outEnded) || ended.Equal(outEnded) && r.RunID > out.RunID {\n   395\t\t\t\tout, outEnded = r, ended\n   396\t\t\t}\n   397\t\t}\n   398\t\treturn out\n","exit_code":0,"status":"completed"}}
