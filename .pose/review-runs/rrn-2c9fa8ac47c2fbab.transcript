{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '91,110p;238,282p' && rg -n 'PriorFindings|Sweep' pose-mcp/internal/pose/review_rounds.go\"","aggregated_output":"    91\t// ReviewDraft is the pose-draft block of a reviewer's final message.\n    92\ttype ReviewDraft struct {\n    93\t\tSchema        string               `json:\"schema\"`\n    94\t\tDecision      string               `json:\"decision\"`\n    95\t\tFindings      []ReviewDraftFinding `json:\"findings\"`\n    96\t\tPriorFindings []ReviewDraftPrior   `json:\"prior_findings,omitempty\"`\n    97\t\tSweep         string               `json:\"sweep,omitempty\"`\n    98\t\t// Criteria and Tools are the typed conclusion the engine records as an\n    99\t\t// attestation (spec pose-delegated-review-conclusions R1).\n   100\t\tCriteria []ReviewDraftCriterion `json:\"criteria,omitempty\"`\n   101\t\tTools    []ReviewDraftTool      `json:\"tools,omitempty\"`\n   102\t\t// Questions and Surfaces are the typed verdict of an adjudication and of\n   103\t\t// a smoke run, recorded where their origin reads them (spec\n   104\t\t// pose-delegated-verdict-destinations R1, R2).\n   105\t\tQuestions []ReviewDraftQuestion `json:\"questions,omitempty\"`\n   106\t\tSurfaces  []ReviewDraftSurface  `json:\"surfaces,omitempty\"`\n   107\t\t// BusinessDecision is a question the reviewer cannot answer from the\n   108\t\t// code, for a person to decide (spec\n   109\t\t// pose-delegated-review-action-fulfillment R7).\n   110\t\tBusinessDecision *ReviewDraftBusinessDecision `json:\"business_decision,omitempty\"`\n   238\tfunc validateReviewDraft(d ReviewDraft) error {\n   239\t\tif d.Schema != ReviewDraftSchema {\n   240\t\t\treturn fmt.Errorf(\"the draft's schema is %q, not %s\", d.Schema, ReviewDraftSchema)\n   241\t\t}\n   242\t\tswitch d.Decision {\n   243\t\tcase \"approved\", \"changes-requested\", \"rejected\":\n   244\t\tdefault:\n   245\t\t\treturn fmt.Errorf(\"the draft's decision %q is not approved, changes-requested or rejected\", d.Decision)\n   246\t\t}\n   247\t\tif len(d.Findings) > reviewDraftMaxFindings || len(d.PriorFindings) > reviewDraftMaxFindings || len(d.Sweep) > reviewDraftMaxText {\n   248\t\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n   249\t\t}\n   250\t\tseen := map[string]bool{}\n   251\t\tfor _, f := range d.Findings {\n   252\t\t\tswitch {\n   253\t\t\tcase !reviewFindingID.MatchString(f.ID) || reviewRoundPrefix.MatchString(f.ID) || seen[f.ID]:\n   254\t\t\t\treturn fmt.Errorf(\"finding id %q is not a unique identifier without a round prefix\", f.ID)\n   255\t\t\tcase f.Severity != \"high\" && f.Severity != \"medium\" && f.Severity != \"low\":\n   256\t\t\t\treturn fmt.Errorf(\"finding %s: severity %q is not high, medium or low\", f.ID, f.Severity)\n   257\t\t\tcase f.Disposition != \"blocker\" && f.Disposition != \"follow-up\":\n   258\t\t\t\treturn fmt.Errorf(\"finding %s: disposition %q is not blocker or follow-up\", f.ID, f.Disposition)\n   259\t\t\tcase strings.TrimSpace(f.Summary) == \"\" || len(f.Summary) > reviewDraftMaxText || len(f.File) > 1024 || f.Line < 0:\n   260\t\t\t\treturn fmt.Errorf(\"finding %s needs a bounded summary and location\", f.ID)\n   261\t\t\t}\n   262\t\t\tseen[f.ID] = true\n   263\t\t}\n   264\t\tanswered := map[string]bool{}\n   265\t\tfor _, c := range d.Criteria {\n   266\t\t\tswitch {\n   267\t\t\tcase ValidateSlug(c.ID) != nil || answered[c.ID]:\n   268\t\t\t\treturn fmt.Errorf(\"criterion %q is not a unique criterion id\", c.ID)\n   269\t\t\tcase c.Disposition != \"passed\" && c.Disposition != \"finding\" && c.Disposition != \"not-applicable\":\n   270\t\t\t\treturn fmt.Errorf(\"criterion %s: disposition %q is not passed, finding or not-applicable\", c.ID, c.Disposition)\n   271\t\t\tcase len(c.Evidence) > reviewDraftMaxText || len(c.Rationale) > reviewDraftMaxText || len(c.Mappings) > reviewDraftMaxFindings:\n   272\t\t\t\treturn fmt.Errorf(\"criterion %s exceeds its bounds\", c.ID)\n   273\t\t\t}\n   274\t\t\tfor _, m := range c.Mappings {\n   275\t\t\t\tif strings.TrimSpace(m.Delta) == \"\" || len(m.Delta) > 256 || len(m.Basis) > 256 || len(m.Disposition) > 64 || len(m.Rationale) > reviewDraftMaxText || len(m.Owner) > 256 || len(m.ReviewBy) > 64 {\n   276\t\t\t\t\treturn fmt.Errorf(\"criterion %s: a mapping needs a delta and bounded text\", c.ID)\n   277\t\t\t\t}\n   278\t\t\t}\n   279\t\t\tanswered[c.ID] = true\n   280\t\t}\n   281\t\tfor _, t := range d.Tools {\n   282\t\t\tif ValidateSlug(t.ID) != nil || strings.TrimSpace(t.Disposition) == \"\" || len(t.Evidence) > reviewDraftMaxText || len(t.Rationale) > reviewDraftMaxText || len(t.Component) > 256 {\n96:\tPriorFindings []ReviewDraftPrior   `json:\"prior_findings,omitempty\"`\n97:\tSweep         string               `json:\"sweep,omitempty\"`\n247:\tif len(d.Findings) > reviewDraftMaxFindings || len(d.PriorFindings) > reviewDraftMaxFindings || len(d.Sweep) > reviewDraftMaxText {\n336:\tfor _, p := range d.PriorFindings {\n493:\t\tfor _, p := range draft.PriorFindings {\n543:\t\tfor _, p := range draft.PriorFindings {\n556:\tfor _, p := range draft.PriorFindings {\n568:\tif strings.TrimSpace(draft.Sweep) == \"\" {\n870:\t\t\tfor _, p := range draft.PriorFindings {\n","exit_code":0,"status":"completed"}}
