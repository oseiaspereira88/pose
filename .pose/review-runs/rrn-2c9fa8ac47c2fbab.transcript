{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '280,325p;530,575p' && rg -n 'type ReviewPlanTool' pose-mcp/internal/pose\"","aggregated_output":"   280\t\t}\n   281\t\tfor _, t := range d.Tools {\n   282\t\t\tif ValidateSlug(t.ID) != nil || strings.TrimSpace(t.Disposition) == \"\" || len(t.Evidence) > reviewDraftMaxText || len(t.Rationale) > reviewDraftMaxText || len(t.Component) > 256 {\n   283\t\t\t\treturn fmt.Errorf(\"tool %q needs an id, a disposition and bounded text\", t.ID)\n   284\t\t\t}\n   285\t\t}\n   286\t\tfor _, f := range d.Findings {\n   287\t\t\tif len(f.Action) > reviewDraftMaxText || len(f.Owner) > 256 || len(f.ReviewBy) > 64 {\n   288\t\t\t\treturn fmt.Errorf(\"finding %s exceeds its bounds\", f.ID)\n   289\t\t\t}\n   290\t\t}\n   291\t\tif len(d.Criteria) > reviewDraftMaxFindings || len(d.Tools) > reviewDraftMaxFindings || len(d.Questions) > reviewDraftMaxFindings || len(d.Surfaces) > reviewDraftMaxFindings {\n   292\t\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n   293\t\t}\n   294\t\tif b := d.BusinessDecision; b != nil {\n   295\t\t\tif strings.TrimSpace(b.Question) == \"\" || len(b.Question) > reviewDraftMaxText || len(b.Options) < 2 || len(b.Options) > 8 {\n   296\t\t\t\treturn fmt.Errorf(\"a business decision needs a bounded question and two to eight options\")\n   297\t\t\t}\n   298\t\t\tseen := map[string]bool{}\n   299\t\t\tfor _, o := range b.Options {\n   300\t\t\t\tif ValidateSlug(o.ID) != nil || seen[o.ID] || strings.TrimSpace(o.Consequence) == \"\" || len(o.Consequence) > reviewDraftMaxText {\n   301\t\t\t\t\treturn fmt.Errorf(\"business decision option %q needs a unique slug and its consequence\", o.ID)\n   302\t\t\t\t}\n   303\t\t\t\tseen[o.ID] = true\n   304\t\t\t}\n   305\t\t}\n   306\t\tasked := map[string]bool{}\n   307\t\tfor _, q := range d.Questions {\n   308\t\t\tswitch {\n   309\t\t\tcase !adjudicationQuestionID.MatchString(q.ID) || asked[q.ID]:\n   310\t\t\t\treturn fmt.Errorf(\"question %q is not a unique decision or requirement id\", q.ID)\n   311\t\t\tcase q.Verdict != AdjudicationHolds && q.Verdict != AdjudicationDoesNotHold && q.Verdict != AdjudicationCannotDetermine:\n   312\t\t\t\treturn fmt.Errorf(\"question %s: verdict %q is not holds, does-not-hold or cannot-determine\", q.ID, q.Verdict)\n   313\t\t\tcase strings.TrimSpace(q.Rationale) == \"\" || len(q.Rationale) > reviewDraftMaxText || len(q.Evidence) > reviewDraftMaxText:\n   314\t\t\t\treturn fmt.Errorf(\"question %s needs a bounded rationale\", q.ID)\n   315\t\t\t}\n   316\t\t\tasked[q.ID] = true\n   317\t\t}\n   318\t\tobserved := map[string]bool{}\n   319\t\tfor _, sf := range d.Surfaces {\n   320\t\t\tswitch {\n   321\t\t\tcase !deliveryRefRE.MatchString(sf.Ref) || observed[sf.Ref]:\n   322\t\t\t\treturn fmt.Errorf(\"surface %q is not a unique delivery target\", sf.Ref)\n   323\t\t\tcase sf.Outcome != SmokeObserved && sf.Outcome != SmokeNotObserved && sf.Outcome != SmokeNotReachable:\n   324\t\t\t\treturn fmt.Errorf(\"surface %s: outcome %q is not observed, not-observed or not-reachable\", sf.Ref, sf.Outcome)\n   325\t\t\tcase len(sf.Commands) == 0 || len(sf.Commands) > 64 || strings.TrimSpace(sf.Observed) == \"\" || len(sf.Observed) > reviewDraftMaxText:\n   530\tfunc ValidateRoundDraft(round ReviewRound, output string) []string {\n   531\t\tdraft, err := ParseReviewDraft(output)\n   532\t\tif err != nil {\n   533\t\t\treturn []string{err.Error()}\n   534\t\t}\n   535\t\tvar problems []string\n   536\t\topen := map[string]bool{}\n   537\t\tfor _, f := range round.Open {\n   538\t\t\topen[f.ID] = true\n   539\t\t}\n   540\t\tif draft != nil {\n   541\t\t\t// An account of a finding no round reported is not an account: it\n   542\t\t\t// would count as convergence without a defect (review round 2, R2-B3).\n   543\t\t\tfor _, p := range draft.PriorFindings {\n   544\t\t\t\tif !open[p.ID] {\n   545\t\t\t\t\tproblems = append(problems, \"prior finding \"+p.ID+\" is not an open finding of the scope's rounds\")\n   546\t\t\t\t}\n   547\t\t\t}\n   548\t\t}\n   549\t\tif round.Number < 2 {\n   550\t\t\treturn problems\n   551\t\t}\n   552\t\tif draft == nil {\n   553\t\t\treturn []string{\"a draft of round \" + fmt.Sprint(round.Number) + \" needs a pose-draft block\"}\n   554\t\t}\n   555\t\taccounted := map[string]ReviewDraftPrior{}\n   556\t\tfor _, p := range draft.PriorFindings {\n   557\t\t\taccounted[p.ID] = p\n   558\t\t}\n   559\t\tfor _, f := range round.Open {\n   560\t\t\tp, ok := accounted[f.ID]\n   561\t\t\tswitch {\n   562\t\t\tcase !ok:\n   563\t\t\t\tproblems = append(problems, \"prior finding \"+f.ID+\" is not accounted for\")\n   564\t\t\tcase p.Status == PriorFindingFixed && strings.TrimSpace(p.Evidence) == \"\":\n   565\t\t\t\tproblems = append(problems, \"prior finding \"+f.ID+\" is reported fixed with no evidence\")\n   566\t\t\t}\n   567\t\t}\n   568\t\tif strings.TrimSpace(draft.Sweep) == \"\" {\n   569\t\t\tproblems = append(problems, \"the draft does not state what it swept\")\n   570\t\t}\n   571\t\treturn problems\n   572\t}\n   573\t\n   574\t// quoteLedgerText renders text an earlier reviewer wrote as one quoted line:\n   575\t// whitespace collapsed, backticks neutralized, so it can open no section and\npose-mcp/internal/pose/review_plan.go:73:type ReviewPlanTool struct {\n","exit_code":0,"status":"completed"}}
