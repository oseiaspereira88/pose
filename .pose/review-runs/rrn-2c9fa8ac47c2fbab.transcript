kMetadata = gitlinks.metadataOwned\n   881\t\townership.gitlinkMetadataBytes = gitSnapshotBudget(gitlinks.committedBytes)\n   882\t\tif gitlinkErr != nil {\n   883\t\t\tterminationFailed = gitlinks.terminationFailure\n   884\t\t\tsafety.ExecutionCause = executionCause(setupCtx)\n   885\t\t\tif gitlinks.captureOverflow {\n   886\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   887\t\t\t}\n   888\t\t\treturn finish(ReviewRunFailed, \"sealed gitlink setup failed: \"+gitlinkErr.Error())\n   889\t\t}\n   890\t\tstopSetup()\n   891\t\tcheckout := s\n   892\t\tcheckout.Root, checkout.indexPin = worktree, nil\n   893\t\tif prepared, err := checkout.PrepareReviewBundle(plan.Brief.Scope); err != nil {\n   894\t\t\treturn finish(ReviewRunFailed, \"sealed checkout inputs unavailable: \"+err.Error())\n   895\t\t} else if blockers := checkoutBlockers(prepared.Blockers); len(blockers) > 0 {\n   896\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout blocked: %v\", blockers))\n   897\t\t} else if differing := sealedInputsThatDiffer(plan.Bundle, prepared, worktree); len(differing) > 0 {\n   898\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout inputs differ: %v\", differing))\n   899\t\t}\n   900\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n   901\t\t\treturn finish(ReviewRunFailed, err.Error())\n   902\t\t}\n   903\t\tif err := verifyBundleMaterialization(worktree, plan.Bundle); err != nil {\n   904\t\t\treturn finish(ReviewRunFailed, err.Error())\n   905\t\t}\n   906\t\tif plan.Purpose == DelegationPurposeReview && plan.Config.Events == DelegationEventsClaudeStreamJSON {\n   907\t\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n   908\t\t\tif err != nil {\n   909\t\t\t\treturn finish(ReviewRunFailed, \"review staging policy unavailable\")\n   910\t\t\t}\n   660\t// is opened, reviewGoBuildAfterContents after the directory is emptied and\n   661\t// before its name is checked again, and reviewGoBuildBeforeRemove between that\n   662\t// check and the removal; tests use them to change the name there.\n   663\tvar (\n   664\t\treviewGoBuildBeforeOpen    = func(string) {}\n   665\t\treviewGoBuildAfterContents = func(string) {}\n   666\t\treviewGoBuildBeforeRemove  = func(string) {}\n   667\t)\n   668\t\n   669\t// removeReviewGoBuildLeftovers removes the Go build directories a reviewer's\n   670\t// interrupted `go test` or `go build` left at the top of the run's runtime\n   671\t// directory, each under its own bounded inventory, before the runtime's own\n   672\t// inventory, which a single test binary can exceed (spec\n   673\t// pose-review-cleanup-removes-go-build-leftovers). Only a real directory is\n   674\t// removed; the platform implementation opens it without blocking and only as\n   675\t// a directory, so a link, a FIFO or any other entry stays for the runtime\n   676\t// inventory to judge.\n   677\tfunc removeReviewGoBuildLeftovers(root *os.Root) error {\n   678\t\t// The top level is read in bounded batches and each go-build directory\n   679\t\t// is removed as it is read, so nothing accumulates; only the other\n   680\t\t// entries, which the runtime inventory will judge, count against its\n   681\t\t// bound (review rounds 5 and 6, N6 and N10).\n   682\t\tdir, err := root.Open(\".\")\n   683\t\tif err != nil {\n   684\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n   685\t\t}\n   686\t\tdefer dir.Close()\n   687\t\tothers := 0\n   688\t\tfor {\n   689\t\t\tbatch, err := dir.Readdirnames(256)\n   690\t\t\tfor _, name := range batch {\n   691\t\t\t\tif !reviewGoBuildDir.MatchString(name) {\n   692\t\t\t\t\tothers++\n   693\t\t\t\t\tif others > reviewRuntimeMaxEntries {\n   694\t\t\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n   695\t\t\t\t\t}\n   696\t\t\t\t\tcontinue\n   697\t\t\t\t}\n   698\t\t\t\tif err := removeReviewGoBuildDir(root, name); err != nil {\n   699\t\t\t\t\treturn err\n   700\t\t\t\t}\n   701\t\t\t}\n   702\t\t\tif len(batch) == 0 {\n   703\t\t\t\tif err == nil || errors.Is(err, io.EOF) {\n   704\t\t\t\t\treturn nil\n   705\t\t\t\t}\n   706\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n   707\t\t\t}\n   708\t\t}\n   709\t}\n   710\t\n   711\t// reviewRuntimeMaxEntries is the runtime inventory's own entry bound.\n   712\tconst reviewRuntimeMaxEntries = 4096\n   713\t\n   714\tfunc removeReviewOwnedContents(root *os.Root, maxFiles int, maxBytes int64) error {\n   715\t\tpaths := []string{}\n   716\t\tvar total int64\n   717\t\terr := fs.WalkDir(root.FS(), \".\", func(path string, d fs.DirEntry, err error) error {\n   718\t\t\tif err != nil {\n   719\t\t\t\treturn err\n   720\t\t\t}\n   721\t\t\tif path == \".\" {\n   722\t\t\t\treturn nil\n   723\t\t\t}\n   724\t\t\tif len(paths) >= maxFiles || strings.Count(path, \"/\") > 128 {\n   725\t\t\t\treturn fmt.Errorf(\"cleanup inventory exceeds coverage\")\n   726\t\t\t}\n   727\t\t\tinfo, err := d.Info()\n   728\t\t\tif err != nil {\n   729\t\t\t\treturn err\n   730\t\t\t}\n   731\t\t\tif info.Mode().IsRegular() {\n   732\t\t\t\ttotal += info.Size()\n   733\t\t\t\tif total > maxBytes {\n   734\t\t\t\t\treturn fmt.Errorf(\"cleanup inventory exceeds bytes\")\n   735\t\t\t\t}\n   736\t\t\t}\n   737\t\t\tpaths = append(paths, path)\n   738\t\t\treturn nil\n   739\t\t})\n   740\t\tif err != nil {\n   741\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n   742\t\t}\n   743\t\tfor i := len(paths) - 1; i >= 0; i-- {\n   744\t\t\tif err := root.Remove(paths[i]); err != nil && !errors.Is(err, os.ErrNotExist) {\n   745\t\t\t\treturn fmt.Errorf(\"runtime cleanup incomplete; resources retained\")\n   746\t\t\t}\n   747\t\t}\n   748\t\treturn nil\n   749\t}\n   750\t\n","exit_code":0,"status":"completed"}}
