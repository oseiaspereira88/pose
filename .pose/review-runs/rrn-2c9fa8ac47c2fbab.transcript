nue\n   479\t\t\t}\n   480\t\t\tif w.SchemaVersion != 1 || e.Name() != w.RunID+\".json\" || strings.ContainsAny(w.RunID, \"/\\\\\") {\n   481\t\t\t\tfindings = append(findings, \"invalid run witness \"+e.Name())\n   482\t\t\t\tcontinue\n   483\t\t\t}\n   484\t\t\tvar run ReviewRun\n   485\t\t\traw, readErr := readLedgerRawBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, w.RunID+\".json\"), budget)\n   486\t\t\tif readErr != nil {\n   487\t\t\t\tfindings = append(findings, \"witnessed run \"+w.RunID+\": \"+readErr.Error())\n   488\t\t\t\tif errors.Is(readErr, errReviewLedgerBudget) {\n   489\t\t\t\t\tbreak\n   490\t\t\t\t}\n   491\t\t\t\tcontinue\n   492\t\t\t}\n   493\t\t\tif err := strictJSONBytes(raw, &run); err != nil {\n   494\t\t\t\tfindings = append(findings, \"unreadable witnessed run \"+w.RunID)\n   495\t\t\t\tcontinue\n   496\t\t\t}\n   497\t\t\tif validateReviewRunRecord(w.RunID+\".json\", run) != nil || digestBytes(raw) != w.RecordDigest || run.TranscriptDigest != w.TranscriptDigest || run.BundleID != w.BundleID || run.Scope != w.Scope {\n   498\t\t\t\tfindings = append(findings, \"rewritten witnessed run \"+w.RunID)\n   499\t\t\t\tcontinue\n   500\t\t\t}\n   501\t\t\tif bundle != \"\" && run.BundleID != bundle {\n   502\t\t\t\tcontinue\n   503\t\t\t}\n   504\t\t\tinfo, statErr := s.fsys().Lstat(filepath.Join(s.Root, run.TranscriptPath))\n   505\t\t\tif statErr == nil {\npose-mcp/internal/pose/delegation_routing_review_test.go:69:\t\tif _, err := s.recordReviewRun(run, nil); err != nil {\npose-mcp/internal/pose/delegation_routing_review_test.go:86:\tif _, err := s.recordReviewRun(run, nil); err != nil {\npose-mcp/internal/pose/delegation_release.go:64:\trecorded, err := s.recordReviewRun(run, nil)\npose-mcp/internal/pose/review_attempt_ledger_test.go:19:\trun, err := s.recordReviewRun(ReviewRun{SchemaVersion: 1, AttemptID: a.AttemptID, Reason: a.Reason, Scope: \"spec:alpha\", BundleID: \"rvb-ledger\", BundleDigest: \"sha256:bundle\", Adapter: \"fak