se/review-attribution-supplements\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/review-bundles\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/review-conclusions\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/review-profiles\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/review-run-ledger\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/review-run-proofs\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/review-runs\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/reviews\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/roadmaps\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/rules\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/specs\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/starts\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/state\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/templates\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/transfers\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/.pose/workflows\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/docs-site\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/docs-site/docs\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/examples\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/examples/brownfield-kits\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/examples/demo\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-backend-dotnet\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-backend-go\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-backend-java\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-backend-python\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-backend-rust\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-cicd-github-actions\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-frontend-react\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-frontend-svelte\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-frontend-vue\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-infra-docker\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-infra-terraform\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-kubernetes\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/extensions/pose-rule-serverless-cloudflare\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/locales\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/locales/pt-BR\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/mcp-enforce\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/mcp-enforce/cmd\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/mcp-enforce/sidecar\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/mcp-enforce/testdata\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/pose-action\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/pose-mcp\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/pose-mcp/.pose\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/pose-mcp/cmd\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/pose-mcp/internal\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/pose-mcp/schemas\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/scripts\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/tests\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/tests/e2e\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/tests/hygiene\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/tests/import\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/tests/install\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/tests/journeys\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/tests/lib\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/tests/quickstart\n/var/tmp/pose-work-go/pose-review-run-4029560095/worktree/tests/release\ntotal 608\ndrwx------    5 go go   4096 Nov 24 09:36 .\ndrwxr-xr-x 9834 go go 458752 Nov 24 09:35 ..\ndrwxr-xr-x    2 go go   4096 Nov 24 09:36 codex-bwrap-synthetic-mount-targets-1000\ndrwx------    2 go go   4096 Nov 24 09:35 empty-hooks\n-rw-r--r--    1 go go      0 Nov 24 09:35 output.txt\n-rw-------    1 go go 139783 Nov 24 09:35 pose-review-draft-context.json\ndrwxr-xr-x   16 go go   4096 Nov 24 09:35 worktree\n","exit_code":0,"status":"completed"}}
