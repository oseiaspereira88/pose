{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux.go && nl -ba pose-mcp/internal/pose/delegation_release.go && nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '145,200p' && nl -ba pose-mcp/internal/cli/delegate.go | sed -n '850,960p;1105,1175p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_reap_linux_test.go && nl -ba pose-mcp/internal/pose/delegation_release_test.go && nl -ba pose-mcp/internal/cli/review_reap_test.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os/exec\"\n     7\t\t\"testing\"\n     8\t\t\"time\"\n     9\t)\n    10\t\n    11\t// Review round 1, N3: a pid that no longer names a process of the run, as\n    12\t// after reuse by an unrelated process, is never signalled.\n    13\tfunc TestAPidThatLostTheRunsEntryIsNotKilled(t *testing.T) {\n    14\t\tother := exec.Command(\"sleep\", \"30\")\n    15\t\tif err := other.Start(); err != nil {\n    16\t\t\tt.Fatal(err)\n    17\t\t}\n    18\t\tfor i := 0; i < 200 && reviewProcessName(other.Process.Pid) != \"sleep\"; i++ {\n    19\t\t\ttime.Sleep(10 * time.Millisecond)\n    20\t\t}\n    21\t\tt.Cleanup(func() { _ = other.Process.Kill(); _ = other.Wait() })\n    22\t\tentry := []byte(SealedCheckoutEnv + \"=/nonexistent/run-checkout\")\n    23\t\tif err := killPinnedMarkedProcess(other.Process.Pid, entry); err != nil {\n    24\t\t\tt.Fatal(err)\n    25\t\t}\n    26\t\ttime.Sleep(100 * time.Millisecond)\n    27\t\tif zombie, err := reviewProcessZombie(other.Process.Pid); err != nil || zombie {\n    28\t\t\tt.Fatalf(\"a process without the run's entry was killed: zombie=%t %v\", zombie, err)\n    29\t\t}\n    30\t\t// The same process carrying the entry is ended.\n    31\t\tmarked := exec.Command(\"sleep\", \"30\")\n    32\t\tmarked.Env = append(marked.Environ(), string(entry))\n    33\t\tif err := marked.Start(); err != nil {\n    34\t\t\tt.Fatal(err)\n    35\t\t}\n    36\t\t// Until exec, /proc shows the parent's environment.\n    37\t\tfor i := 0; i < 200; i++ {\n    38\t\t\tif ok, _ := reviewProcessMarked(marked.Process.Pid, entry); ok {\n    39\t\t\t\tbreak\n    40\t\t\t}\n    41\t\t\ttime.Sleep(10 * time.Millisecond)\n    42\t\t}\n    43\t\tif err := killPinnedMarkedProcess(marked.Process.Pid, entry); err != nil {\n    44\t\t\tt.Fatal(err)\n    45\t\t}\n    46\t\tif err := marked.Wait(); err == nil {\n    47\t\t\tt.Fatal(\"the marked process was not ended\")\n    48\t\t}\n    49\t}\n     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"os\"\n     9\t\t\"os/exec\"\n    10\t\t\"path/filepath\"\n    11\t\t\"strings\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\t// Spec pose-review-run-reaps-lingering-reviewer-processes R5, R6: a dispatch\n    17\t// that ended between its reservation and its run record leaves an attempt\n    18\t// that blocks the bundle; once its owner is proven gone, cancel releases it\n    19\t// with a failed run and its receipt, and the ledger reads again.\n    20\tfunc TestAnAbandonedAttemptIsReleasedWithARecord(t *testing.T) {\n    21\t\troot := t.TempDir()\n    22\t\ts := Store{Root: root}\n    23\t\tbundle := \"rvb-00000000000000a1\"\n    24\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n    25\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"0\", 32)}\n    26\t\ta.AttemptID = attemptIdentity(a)\n    27\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    28\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    29\t\t\tt.Fatal(err)\n    30\t\t}\n    31\t\t// The ledger refuses the bundle while the reservation has no receipt.\n    32\t\tif _, err := s.readAttemptReceipt(a); err == nil || !strings.Contains(err.Error(), \"incomplete or unreadable\") {\n    33\t\t\tt.Fatalf(\"an unfinished reservation read as finished: %v\", err)\n    34\t\t}\n    35\t\n    36\t\t// The marker the interrupted dispatch left: its owner is a process that\n    37\t\t// has exited.\n    38\t\tdead := exec.Command(\"true\")\n    39\t\tif err := dead.Run(); err != nil {\n    40\t\t\tt.Fatal(err)\n    41\t\t}\n    42\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    43\t\towner.Host, _ = os.Hostname()\n    44\t\tidentifyStartLockProcess(&owner)\n    45\t\towner.PID = dead.Process.Pid\n    46\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"b\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: a.Scope, BundleID: bundle,\n    47\t\t\tStartedAt: a.ReservedAt, Owner: owner, HeartbeatAt: a.ReservedAt, HeartbeatEvery: 10}\n    48\t\tdir, err := s.delegationActiveDir(true)\n    49\t\tif err != nil {\n    50\t\t\tt.Fatal(err)\n    51\t\t}\n    52\t\traw, _ := json.Marshal(marker)\n    53\t\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), raw, 0o600); err != nil {\n    54\t\t\tt.Fatal(err)\n    55\t\t}\n    56\t\n    57\t\trun, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now())\n    58\t\tif err != nil {\n    59\t\t\tt.Fatal(err)\n    60\t\t}\n    61\t\tif run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"abandoned\") {\n    62\t\t\tt.Fatalf(\"the release recorded %s: %s\", run.Status, run.Failure)\n    63\t\t}\n    64\t\tif _, err := s.readAttemptReceipt(a); err != nil {\n    65\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n    66\t\t}\n    67\t\tif left, _ := filepath.Glob(filepath.Join(dir, a.AttemptID+\"*\")); len(left) != 0 {\n    68\t\t\tt.Fatalf(\"the marker or its stall claim stayed: %v\", left)\n    69\t\t}\n    70\t\t// Released once: a second release finds nothing abandoned.\n    71\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now()); !errors.Is(err, ErrAttemptNotAbandoned) {\n    72\t\t\tt.Fatalf(\"a released attempt was released again: %v\", err)\n    73\t\t}\n    74\t}\n    75\t\n    76\t// An attempt whose owner is alive is never released.\n    77\tfunc TestARunningAttemptIsNotReleased(t *testing.T) {\n    78\t\troot := t.TempDir()\n    79\t\ts := Store{Root: root}\n    80\t\tbundle := \"rvb-00000000000000a2\"\n    81\t\t// Silent for an hour, so only the owner's liveness keeps it running.\n    82\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n    83\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1, ReservedAt: old, Nonce: strings.Repeat(\"0\", 32)}\n    84\t\ta.AttemptID = attemptIdentity(a)\n    85\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    86\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    87\t\t\tt.Fatal(err)\n    88\t\t}\n    89\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    90\t\towner.Host, _ = os.Hostname()\n    91\t\tidentifyStartLockProcess(&owner)\n    92\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"d\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: bundle, StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n    93\t\tdir, _ := s.delegationActiveDir(true)\n    94\t\traw, _ := json.Marshal(marker)\n    95\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n    96\t\t\tt.Fatal(err)\n    97\t\t}\n    98\t\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now()); !errors.Is(err, ErrAttemptNotAbandoned) {\n    99\t\t\tt.Fatalf(\"a running attempt was released: %v\", err)\n   100\t\t}\n   101\t}\n   102\t\n   103\t// Review round 1, N1: the dispatch marks the attempt active before it\n   104\t// publishes the reservation, so no instant leaves a reservation without a\n   105\t// marker that turns stalled.\n   106\tfunc TestTheAttemptIsMarkedActiveBeforeItIsReserved(t *testing.T) {\n   107\t\tvar checked bool\n   108\t\tbeforeAttemptPublished = func(store Store, a DelegatedReviewAttempt) {\n   109\t\t\tchecked = true\n   110\t\t\tmarkers, _, err := store.ListDelegationActive()\n   111\t\t\tfound := false\n   112\t\t\tfor _, m := range markers {\n   113\t\t\t\tfound = found || m.AttemptID == a.AttemptID\n   114\t\t\t}\n   115\t\t\tif err != nil || !found {\n   116\t\t\t\tt.Errorf(\"the reservation of %s is published with no active marker: %v\", a.AttemptID, err)\n   117\t\t\t}\n   118\t\t\tif _, err := os.Lstat(reviewAttemptPath(store.Root, a)); !errors.Is(err, os.ErrNotExist) {\n   119\t\t\t\tt.Errorf(\"the reservation was published before the marker: %v\", err)\n   120\t\t\t}\n   121\t\t}\n   122\t\tt.Cleanup(func() { beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {} })\n   123\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\")\n   124\t\tif !checked {\n   125\t\t\tt.Fatal(\"the dispatch never reached the reservation\")\n   126\t\t}\n   127\t}\n   128\t\n   129\t// A marker whose dispatch ended before publishing the reservation is removed\n   130\t// by the release; ls names the cause and the release command (N2).\n   131\tfunc TestAStalledMarkerWithoutReservationIsListedAndRemoved(t *testing.T) {\n   132\t\troot := t.TempDir()\n   133\t\ts := Store{Root: root}\n   134\t\tdead := exec.Command(\"true\")\n   135\t\tif err := dead.Run(); err != nil {\n   136\t\t\tt.Fatal(err)\n   137\t\t}\n   138\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:x\", Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n   139\t\towner.Host, _ = os.Hostname()\n   140\t\tidentifyStartLockProcess(&owner)\n   141\t\towner.PID = dead.Process.Pid\n   142\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   143\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: \"rat-\" + strings.Repeat(\"e\", 64), RunToken: strings.Repeat(\"f\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: \"rvb-00000000000000a3\", StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n   144\t\tdir, _ := s.delegationActiveDir(true)\n   145\t\traw, _ := json.Marshal(marker)\n   146\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n   147\t\t\tt.Fatal(err)\n   148\t\t}\n   149\t\tattempts, _, err := s.ListDelegationAttempts()\n   150\t\tif err != nil || len(attempts) != 1 || attempts[0].State != DelegationStalled || !strings.Contains(attempts[0].Failure, DelegationAbandonedCause) || !strings.Contains(attempts[0].Failure, \"pose delegate cancel \"+marker.AttemptID) {\n   151\t\t\tt.Fatalf(\"the abandoned attempt is not listed with its cause: %+v %v\", attempts, err)\n   152\t\t}\n   153\t\trun, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now())\n   154\t\tif err != nil || run.RunID != \"\" {\n   155\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   156\t\t}\n   157\t\tif left, _ := filepath.Glob(filepath.Join(dir, marker.AttemptID+\"*\")); len(left) != 0 {\n   158\t\t\tt.Fatalf(\"the marker stayed: %v\", left)\n   159\t\t}\n   160\t}\n     1\t//go:build linux\n     2\t\n     3\tpackage cli\n     4\t\n     5\timport (\n     6\t\t\"os\"\n     7\t\t\"os/exec\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strconv\"\n    10\t\t\"strings\"\n    11\t\t\"syscall\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t\n    15\t\t\"github.com/harne8/pose-mcp/internal/pose\"\n    16\t)\n    17\t\n    18\t// Spec pose-review-run-reaps-lingering-reviewer-processes R1, R2, R4: a\n    19\t// reviewer that ends while a command it started in a session of its own is\n    20\t// still running leaves a run that completes, with that command ended before\n    21\t// the cleanup and named in the run record.\n    22\tfunc TestDispatchEndsWhatTheReviewerLeftRunning(t *testing.T) {\n    23\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n    24\t\t\tt.Skip(\"setsid is not available\")\n    25\t\t}\n    26\t\troot := dispatchInstance(t)\n    27\t\tpidFile := filepath.Join(t.TempDir(), \"leftover.pid\")\n    28\t\tscript := `cat >/dev/null; setsid sh -c 'echo $$ > \"` + pidFile + `\"; while :; do touch \"$TMPDIR/leftover\" 2>/dev/null; sleep 0.05; done' </dev/null >/dev/null 2>&1 & ` +\n    29\t\t\t`i=0; while [ ! -s \"` + pidFile + `\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`\n    30\t\twriteReviewers(t, root, map[string]pose.ReviewerAdapter{\"fake\": {Command: []string{\"sh\", \"-c\", script}, Vendor: \"fixture\", Model: \"fixture\", Containment: &pose.ReviewerContainment{SchemaVersion: 1, Profile: \"trusted-process\"}}})\n    31\t\tcode, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\")\n    32\t\traw, err := os.ReadFile(pidFile)\n    33\t\tif err != nil {\n    34\t\t\tt.Fatalf(\"the leftover never started: %v (%d %s)\", err, code, out)\n    35\t\t}\n    36\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n    37\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n    38\t\tdeadline := time.Now().Add(2 * time.Second)\n    39\t\tfor syscall.Kill(pid, 0) == nil && time.Now().Before(deadline) {\n    40\t\t\tif stat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\"); err == nil && strings.Contains(string(stat), \") Z \") {\n    41\t\t\t\tbreak\n    42\t\t\t}\n    43\t\t\ttime.Sleep(50 * time.Millisecond)\n    44\t\t}\n    45\t\tif stat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\"); err == nil && !strings.Contains(string(stat), \") Z \") {\n    46\t\t\tt.Fatalf(\"the process the reviewer left running survived the run: %s\", stat)\n    47\t\t}\n    48\t\truns, _, _ := (pose.Store{Root: root}).ReadReviewRuns(\"\")\n    49\t\tif len(runs) != 1 {\n    50\t\t\tt.Fatalf(\"runs: %d (%d %s)\", len(runs), code, out)\n    51\t\t}\n    52\t\trun := runs[0]\n    53\t\tif run.Status != pose.ReviewRunCompleted || run.Safety == nil || run.Safety.Operation.Outcome != pose.OutcomeCompleted {\n    54\t\t\tt.Fatalf(\"the run did not complete with its cleanup: status=%s failure=%s safety=%+v\", run.Status, run.Failure, run.Safety)\n    55\t\t}\n    56\t\tif !strings.Contains(strings.Join(run.Safety.Limitations, \"\\n\"), \"process(es) the run left running\") {\n    57\t\t\tt.Fatalf(\"the run record does not name the ended process: %v\", run.Safety.Limitations)\n    58\t\t}\n    59\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux.go && nl -ba pose-mcp/internal/pose/delegation_release.go && nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '145,200p' && nl -ba pose-mcp/internal/cli/delegate.go | sed -n '850,960p;1105,1175p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Leftover reviewer processes (spec\n     6\t// pose-review-run-reaps-lingering-reviewer-processes R1): an adapter such as\n     7\t// `codex exec` runs each command in a session of its own, so killing the\n     8\t// adapter's process group misses a command the reviewer left running, and\n     9\t// that command keeps writing into the run's runtime directory while the\n    10\t// cleanup inventory reads it. Every process of the run inherits\n    11\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n    12\t// that entry, ends them and waits for them before the inventory.\n    13\t//\n    14\t// Each process is pinned by a pidfd before it is signalled, and its\n    15\t// environment is read again through the pinned process, so a pid reused by\n    16\t// an unrelated process between the scan and the signal is never killed\n    17\t// (review round 1, N3). A scan that cannot list or read the state of the\n    18\t// processes fails; a process of this user whose environment cannot be read\n    19\t// (one that made itself non-inspectable) is counted and disclosed in the run\n    20\t// record, never skipped silently (N4).\n    21\t\n    22\timport (\n    23\t\t\"bytes\"\n    24\t\t\"errors\"\n    25\t\t\"fmt\"\n    26\t\t\"io/fs\"\n    27\t\t\"os\"\n    28\t\t\"path/filepath\"\n    29\t\t\"strconv\"\n    30\t\t\"strings\"\n    31\t\t\"syscall\"\n    32\t\t\"time\"\n    33\t\n    34\t\t\"golang.org/x/sys/unix\"\n    35\t)\n    36\t\n    37\tconst reviewReapWait = 5 * time.Second\n    38\t\n    39\t// reapSealedCheckoutProcesses ends every process whose environment names\n    40\t// worktree as its sealed checkout and returns a description of each. An\n    41\t// error means the run's processes could not be proven ended within the bound.\n    42\tfunc reapSealedCheckoutProcesses(worktree string) ([]string, int, error) {\n    43\t\tif worktree == \"\" {\n    44\t\t\treturn nil, 0, nil\n    45\t\t}\n    46\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n    47\t\tvar reaped []string\n    48\t\tseen := map[int]bool{}\n    49\t\tdeadline := time.Now().Add(reviewReapWait)\n    50\t\tunreadable := 0\n    51\t\tfor {\n    52\t\t\talive, opaque, err := reviewMarkedProcesses(entry)\n    53\t\t\tif err != nil {\n    54\t\t\t\treturn reaped, opaque, err\n    55\t\t\t}\n    56\t\t\tunreadable = opaque\n    57\t\t\tfor _, pid := range alive {\n    58\t\t\t\tif !seen[pid] {\n    59\t\t\t\t\tseen[pid] = true\n    60\t\t\t\t\treaped = append(reaped, fmt.Sprintf(\"%d %s\", pid, reviewProcessName(pid)))\n    61\t\t\t\t}\n    62\t\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n    63\t\t\t\t\treturn reaped, unreadable, err\n    64\t\t\t\t}\n    65\t\t\t}\n    66\t\t\tif len(alive) == 0 {\n    67\t\t\t\treturn reaped, unreadable, nil\n    68\t\t\t}\n    69\t\t\tif time.Now().After(deadline) {\n    70\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n    71\t\t\t}\n    72\t\t\ttime.Sleep(50 * time.Millisecond)\n    73\t\t}\n    74\t}\n    75\t\n    76\t// reviewMarkedProcesses lists the live processes whose environment holds\n    77\t// entry, and counts this user's processes whose environment could not be\n    78\t// read. A process that is gone is skipped.\n    79\tfunc reviewMarkedProcesses(entry []byte) ([]int, int, error) {\n    80\t\tdirs, err := os.ReadDir(\"/proc\")\n    81\t\tif err != nil {\n    82\t\t\treturn nil, 0, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    83\t\t}\n    84\t\tunreadable := 0\n    85\t\tself, uid := os.Getpid(), os.Getuid()\n    86\t\tvar out []int\n    87\t\tfor _, d := range dirs {\n    88\t\t\tpid, err := strconv.Atoi(d.Name())\n    89\t\t\tif err != nil || pid == self {\n    90\t\t\t\tcontinue\n    91\t\t\t}\n    92\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n    93\t\t\tswitch {\n    94\t\t\tcase reviewProcessGoneErr(err):\n    95\t\t\t\tcontinue\n    96\t\t\tcase err != nil:\n    97\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n    98\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n    99\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   100\t\t\t\t\tcontinue\n   101\t\t\t\t}\n   102\t\t\t\tunreadable++\n   103\t\t\t\tcontinue\n   104\t\t\tcase !marked:\n   105\t\t\t\tcontinue\n   106\t\t\t}\n   107\t\t\tzombie, err := reviewProcessZombie(pid)\n   108\t\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n   109\t\t\t\tcontinue\n   110\t\t\t}\n   111\t\t\tif err != nil {\n   112\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n   113\t\t\t}\n   114\t\t\tout = append(out, pid)\n   115\t\t}\n   116\t\treturn out, unreadable, nil\n   117\t}\n   118\t\n   119\t// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n   120\t// after the environment read through that same pinned process still holds\n   121\t// entry.\n   122\tfunc killPinnedMarkedProcess(pid int, entry []byte) error {\n   123\t\tfd, err := unix.PidfdOpen(pid, 0)\n   124\t\tif errors.Is(err, unix.ESRCH) {\n   125\t\t\treturn nil\n   126\t\t}\n   127\t\tif err != nil {\n   128\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   129\t\t}\n   130\t\tdefer unix.Close(fd)\n   131\t\t// The pidfd names one process for its lifetime; if pid was reused before\n   132\t\t// it was opened, the new process does not carry this run's entry.\n   133\t\tmarked, err := reviewProcessMarked(pid, entry)\n   134\t\tif reviewProcessGoneErr(err) || err == nil && !marked {\n   135\t\t\treturn nil\n   136\t\t}\n   137\t\tif err != nil {\n   138\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   139\t\t}\n   140\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   141\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   142\t\t}\n   143\t\treturn nil\n   144\t}\n   145\t\n   146\tfunc reviewProcessMarked(pid int, entry []byte) (bool, error) {\n   147\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   148\t\tif err != nil {\n   149\t\t\treturn false, err\n   150\t\t}\n   151\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n   152\t\t\tif bytes.Equal(kv, entry) {\n   153\t\t\t\treturn true, nil\n   154\t\t\t}\n   155\t\t}\n   156\t\treturn false, nil\n   157\t}\n   158\t\n   159\tfunc reviewProcessOwner(pid int) (int, error) {\n   160\t\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n   161\t\tif err != nil {\n   162\t\t\treturn 0, err\n   163\t\t}\n   164\t\tst, ok := info.Sys().(*syscall.Stat_t)\n   165\t\tif !ok {\n   166\t\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n   167\t\t}\n   168\t\treturn int(st.Uid), nil\n   169\t}\n   170\t\n   171\tfunc reviewProcessGoneErr(err error) bool {\n   172\t\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n   173\t}\n   174\t\n   175\tfunc reviewProcessName(pid int) string {\n   176\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n   177\t\tif err != nil {\n   178\t\t\treturn \"?\"\n   179\t\t}\n   180\t\treturn strings.TrimSpace(string(raw))\n   181\t}\n   182\t\n   183\tfunc reviewProcessZombie(pid int) (bool, error) {\n   184\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n   185\t\tif err != nil {\n   186\t\t\treturn false, err\n   187\t\t}\n   188\t\t// The state follows the parenthesised command name.\n   189\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   190\t\t\treturn raw[i+2] == 'Z', nil\n   191\t\t}\n   192\t\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n   193\t}\n     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt and marking it active, but before\n     6\t// recording its run, leaves a reservation without a receipt. Every later\n     7\t// dispatch of the bundle refuses on it, and cancellation refused it because\n     8\t// nothing runs. Once its owner is proven dead (the marker is stalled), the\n     9\t// attempt is closed by the same records a run that failed writes: a failed\n    10\t// run naming the abandonment, its receipt, and the marker's removal. Nothing\n    11\t// is deleted from the ledger.\n    12\t\n    13\timport (\n    14\t\t\"errors\"\n    15\t\t\"fmt\"\n    16\t\t\"os\"\n    17\t\t\"path/filepath\"\n    18\t\t\"time\"\n    19\t)\n    20\t\n    21\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    22\t// proven abandoned.\n    23\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    24\t\n    25\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    26\t// dispatch ended before recording it, and removes its stalled marker.\n    27\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time) (ReviewRun, error) {\n    28\t\tmarkers, _, err := s.ListDelegationActive()\n    29\t\tif err != nil {\n    30\t\t\treturn ReviewRun{}, err\n    31\t\t}\n    32\t\tvar marker *DelegationActiveRun\n    33\t\tfor i := range markers {\n    34\t\t\tif markers[i].AttemptID == attemptID {\n    35\t\t\t\tmarker = &markers[i]\n    36\t\t\t}\n    37\t\t}\n    38\t\tif marker == nil || marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead {\n    39\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    40\t\t}\n    41\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    42\t\tif err != nil {\n    43\t\t\treturn ReviewRun{}, err\n    44\t\t}\n    45\t\tvar reserved *DelegatedReviewAttempt\n    46\t\tfor i := range attempts {\n    47\t\t\tif attempts[i].AttemptID == attemptID {\n    48\t\t\t\treserved = &attempts[i]\n    49\t\t\t}\n    50\t\t}\n    51\t\tif reserved == nil {\n    52\t\t\t// The dispatch ended between its marker and its reservation: nothing\n    53\t\t\t// blocks the bundle, and the marker alone is removed.\n    54\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    55\t\t}\n    56\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); !errors.Is(err, os.ErrNotExist) {\n    57\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n    58\t\t}\n    59\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n    60\t\t\tKind: DelegationKindForPurpose(marker.Purpose), Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n    61\t\t\tStartedAt: marker.StartedAt, ExitCode: -1, Label: marker.Label, Purpose: marker.Purpose, Round: marker.Round,\n    62\t\t\tStatus: ReviewRunFailed, Failure: DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\",\n    63\t\t\tEndedAt: now.UTC().Format(time.RFC3339Nano)}\n    64\t\trecorded, err := s.recordReviewRun(run, nil)\n    65\t\tif err != nil {\n    66\t\t\treturn ReviewRun{}, err\n    67\t\t}\n    68\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n    69\t\t\treturn recorded, err\n    70\t\t}\n    71\t\treturn recorded, s.removeDelegationMarker(*marker)\n    72\t}\n    73\t\n    74\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n    75\t\tdir, err := s.delegationActiveDir(false)\n    76\t\tif err != nil {\n    77\t\t\treturn err\n    78\t\t}\n    79\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n    80\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n    81\t\t\t\treturn err\n    82\t\t\t}\n    83\t\t}\n    84\t\treturn nil\n    85\t}\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\tout := make([]DelegationAttempt, 0, len(order))\n   191\t\tfor _, key := range order {\n   192\t\t\tout = append(out, *byAttempt[key])\n   193\t\t}\n   194\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   195\t\treturn out, lost, nil\n   196\t}\n   197\t\n   198\tfunc delegationStepText(e DelegationEvent) string {\n   199\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   200\t\tif len(text) > 80 {\n   850\t\tswitch {\n   851\t\tcase d < time.Minute:\n   852\t\t\treturn fmt.Sprintf(\"%ds\", int(d.Seconds()))\n   853\t\tcase d < time.Hour:\n   854\t\t\treturn fmt.Sprintf(\"%dm\", int(d.Minutes()))\n   855\t\tcase d < 48*time.Hour:\n   856\t\t\treturn fmt.Sprintf(\"%dh\", int(d.Hours()))\n   857\t\t}\n   858\t\treturn fmt.Sprintf(\"%dd\", int(d.Hours()/24))\n   859\t}\n   860\t\n   861\tfunc cmdDelegateLs(root string, args []string, stdout, stderr io.Writer) int {\n   862\t\tf, problem := parseDelegateFlags(args, \"--active\")\n   863\t\tif problem == \"\" && len(f.positional) > 1 {\n   864\t\t\tproblem = tr(\"one reference at most\", \"no máximo uma referência\")\n   865\t\t}\n   866\t\tif problem != \"\" {\n   867\t\t\treturn delegateUsage(stdout, stderr, args, \"ls\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate ls [<run>|<bundle-id>] [--active] [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>] [--json]\")\n   868\t\t}\n   869\t\tstore := posemodel.Store{Root: root}\n   870\t\tattempts, lost, err := store.ListDelegationAttempts()\n   871\t\tif err != nil {\n   872\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 1, err)\n   873\t\t}\n   874\t\tif len(f.positional) == 1 && !strings.HasPrefix(f.positional[0], \"rvb-\") {\n   875\t\t\tone, err := posemodel.ResolveDelegationRef(attempts, f.positional[0])\n   876\t\t\tif err != nil {\n   877\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, withDelegationLosses(refError(err), lost))\n   878\t\t\t}\n   879\t\t\t// A named run is refused when a selecting flag does not match it, as on\n   880\t\t\t// every other lifecycle command (D8); without a reference they filter.\n   881\t\t\tif flag := f.mismatch(one); flag != \"\" {\n   882\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, errors.New(tr(\"attempt \"+one.AttemptID+\" does not match \"+flag, \"a tentativa \"+one.AttemptID+\" não corresponde a \"+flag)))\n   883\t\t\t}\n   884\t\t\tattempts = []posemodel.DelegationAttempt{one}\n   885\t\t}\n   886\t\tselected := []posemodel.DelegationAttempt{}\n   887\t\tfor _, a := range attempts {\n   888\t\t\tif len(f.positional) == 1 && strings.HasPrefix(f.positional[0], \"rvb-\") && a.BundleID != f.positional[0] {\n   889\t\t\t\tcontinue\n   890\t\t\t}\n   891\t\t\tif f.active && !a.Active || f.mismatch(a) != \"\" {\n   892\t\t\t\tcontinue\n   893\t\t\t}\n   894\t\t\tselected = append(selected, a)\n   895\t\t}\n   896\t\tif lost == nil {\n   897\t\t\tlost = []string{}\n   898\t\t}\n   899\t\tif f.jsonOut {\n   900\t\t\t// R9: a stopped attempt carries the ways forward it has now.\n   901\t\t\ttype listed struct {\n   902\t\t\t\tposemodel.DelegationAttempt\n   903\t\t\t\tNextActions []delegateNextAction `json:\"next_actions,omitempty\"`\n   904\t\t\t}\n   905\t\t\trows := make([]listed, 0, len(selected))\n   906\t\t\tfor _, a := range selected {\n   907\t\t\t\trows = append(rows, listed{a, delegateNextActions(store, a)})\n   908\t\t\t}\n   909\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateListSchema, \"attempts\": rows, \"losses\": lost})\n   910\t\t} else {\n   911\t\t\tout := render(stdout, stderr)\n   912\t\t\tif len(selected) == 0 {\n   913\t\t\t\tout.Field(\"delegate.runs\", tr(\"none\", \"nenhum\"))\n   914\t\t\t}\n   915\t\t\tfor _, a := range selected {\n   916\t\t\t\tvalue := fmt.Sprintf(\"state=%s purpose=%s agent=%s turns=%d age=%s\", a.State, a.Purpose, a.Agent, a.Turns, delegateAge(a.StartedAt))\n   917\t\t\t\tif a.Round > 0 {\n   918\t\t\t\t\tvalue += fmt.Sprintf(\" round=%d\", a.Round)\n   919\t\t\t\t}\n   920\t\t\t\tif a.Label != \"\" {\n   921\t\t\t\t\tvalue += \" label=\" + a.Label\n   922\t\t\t\t}\n   923\t\t\t\tif a.Active && a.Liveness != \"\" {\n   924\t\t\t\t\tvalue += \" owner=\" + a.Liveness\n   925\t\t\t\t}\n   926\t\t\t\tif a.HeartbeatAge != \"\" {\n   927\t\t\t\t\tvalue += \" heartbeat=\" + a.HeartbeatAge\n   928\t\t\t\t}\n   929\t\t\t\tif a.StalledAt != \"\" {\n   930\t\t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n   931\t\t\t\t}\n   932\t\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n   933\t\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n   934\t\t\t\t}\n   935\t\t\t\tif a.HookFailure != \"\" {\n   936\t\t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n   937\t\t\t\t}\n   938\t\t\t\tif a.Interruption != nil {\n   939\t\t\t\t\tvalue += fmt.Sprintf(\" cause=%s resumable=%t partial=%t\", a.Interruption.Cause, a.Interruption.Resumable, a.Partial)\n   940\t\t\t\t\tif a.Interruption.ResetAt != \"\" {\n   941\t\t\t\t\t\tvalue += \" rese