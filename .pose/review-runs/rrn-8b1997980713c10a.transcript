{"type":"item.completed","item":{"id":"item_77","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,175p' pose-mcp/internal/cli/surface_check.go\"","aggregated_output":"package cli\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nfunc loadDeliveryProfilesIn(files posemodel.Files, root string) (map[string]posemodel.DeliveryProfile, error) {\n\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\"))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmatrix, err := parseValidationMatrix(raw)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif err := validateDeliveryMatrixContract(matrix); err != nil {\n\t\treturn nil, err\n\t}\n\treturn matrix.DeliveryProfiles, nil\n}\n\n// loadDeliveryProfiles reads and writes the filesystem directly; loadDeliveryProfilesIn takes the\n// operation's files.\nfunc loadDeliveryProfiles(root string) (map[string]posemodel.DeliveryProfile, error) {\n\treturn loadDeliveryProfilesIn(posemodel.NativeFiles(), root)\n}\n\nfunc collectDeliveryTargetsIn(files posemodel.Files, root string, specs []posemodel.Spec, profiles map[string]posemodel.DeliveryProfile) ([]posemodel.Spec, []posemodel.DeliveryTarget, error) {\n\tstore := posemodel.Store{Root: root, FS: files}\n\tfullSpecs := make([]posemodel.Spec, 0, len(specs))\n\ttargets := []posemodel.DeliveryTarget{}\n\tfor _, summary := range specs {\n\t\tfull, err := store.GetSpec(summary.Slug)\n\t\tif err != nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"spec:%s: %w\", summary.Slug, err)\n\t\t}\n\t\tparsed, _, err := posemodel.ParseDeliveryTargets(*full)\n\t\tif err != nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"spec:%s: %w\", summary.Slug, err)\n\t\t}\n\t\tif err := posemodel.ValidateDeliveryTargetsIn(files, root, parsed, profiles); err != nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"spec:%s: %w\", summary.Slug, err)\n\t\t}\n\t\tfullSpecs = append(fullSpecs, *full)\n\t\ttargets = append(targets, parsed...)\n\t}\n\treturn fullSpecs, targets, nil\n}\n\n// collectDeliveryTargets reads and writes the filesystem directly; collectDeliveryTargetsIn takes the\n// operation's files.\nfunc collectDeliveryTargets(root string, specs []posemodel.Spec, profiles map[string]posemodel.DeliveryProfile) ([]posemodel.Spec, []posemodel.DeliveryTarget, error) {\n\treturn collectDeliveryTargetsIn(posemodel.NativeFiles(), root, specs, profiles)\n}\n\nfunc loadDeliveryValidationResultsIn(files posemodel.Files, root, relative string) ([]posemodel.DeliveryValidationResult, error) {\n\tif relative == \"\" {\n\t\treturn []posemodel.DeliveryValidationResult{}, nil\n\t}\n\tif !confinedRelativePath(relative) {\n\t\treturn nil, fmt.Errorf(\"validation result path must remain inside project\")\n\t}\n\traw, err := files.ReadFile(filepath.Join(root, filepath.FromSlash(relative)))\n\tif os.IsNotExist(err) {\n\t\treturn []posemodel.DeliveryValidationResult{}, nil\n\t}\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn posemodel.ParseDeliveryValidationRun(raw, relative)\n}\n\n// loadSmokeResults reads the verified smoke documents of root; tests replace\n// it to exercise the surface check over results they choose.\nvar loadSmokeResults = func(root string) ([]posemodel.SmokeResult, error) {\n\treturn posemodel.Store{Root: root}.SmokeResults()\n}\n\n// withSmokeResults adds the results of every verified smoke observation a\n// delegated smoke run recorded: evidence of class smoke for the delivery\n// targets it exercised (spec pose-delegated-verdict-destinations R2). A\n// document that does not verify yields nothing.\nfunc withSmokeResults(root string, results []posemodel.DeliveryValidationResult) []posemodel.DeliveryValidationResult {\n\tsmoke, err := loadSmokeResults(root)\n\tif err != nil {\n\t\treturn results\n\t}\n\treturn appendVerifiedSmokeResults(results, smoke)\n}\n\n// withSmokeResultsIn keeps delegated smoke evidence on the same operation\n// filesystem as the rest of the delivery projection.\nfunc withSmokeResultsIn(files posemodel.Files, root string, results []posemodel.DeliveryValidationResult) []posemodel.DeliveryValidationResult {\n\tsmoke, err := posemodel.LoadSmokeResultsIn(posemodel.Store{Root: root, FS: files}, root)\n\tif err != nil {\n\t\treturn results\n\t}\n\treturn appendVerifiedSmokeResults(results, smoke)\n}\n\nfunc appendVerifiedSmokeResults(results []posemodel.DeliveryValidationResult, smoke []posemodel.SmokeResult) []posemodel.DeliveryValidationResult {\n\tfor _, doc := range smoke {\n\t\tif doc.Verified {\n\t\t\tresults = append(results, doc.Results...)\n\t\t}\n\t}\n\treturn results\n}\n\n// loadDeliveryValidationResults reads and writes the filesystem directly; loadDeliveryValidationResultsIn takes the\n// operation's files.\nfunc loadDeliveryValidationResults(root, relative string) ([]posemodel.DeliveryValidationResult, error) {\n\treturn loadDeliveryValidationResultsIn(posemodel.NativeFiles(), root, relative)\n}\n\nfunc extendCurrentDeliveryGraphIn(files posemodel.Files, root string, base posemodel.DeliveryIntegrityGraph) (posemodel.DeliveryIntegrityGraph, error) {\n\tpolicy, err := posemodel.LoadDeliveryPolicyIn(files, root)\n\tif err != nil {\n\t\treturn base, err\n\t}\n\t// An absent profile index or specs directory used to return here, before a\n\t// single roadmap was loaded — so `pose roadmap-check` reported zero cut\n\t// criteria and exited 0 on a repository whose roadmap declared several. A\n\t// gate that cannot evaluate its criteria was reading as a gate that passed\n\t// them (spec pose-roadmap-check-reaches-its-gate).\n\t//\n\t// Neither absence is a reason to skip the evaluation. Without profiles there\n\t// are no delivery targets, so a criterion naming one is unresolved — which\n\t// the criteria loop already reports as `unknown delivery ref`, and which is\n\t// the honest answer. `check:` and `manual-review:` refs need neither.\n\tprofiles, err := loadDeliveryProfilesIn(files, root)\n\tif err != nil {\n\t\tif !errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn base, err\n\t\t}\n\t\tprofiles = map[string]posemodel.DeliveryProfile{}\n\t}\n\tstore := posemodel.Store{Root: root, FS: files}\n\tspecs, err := store.ListSpecs(\"\", \"\")\n\tif err != nil {\n\t\t// errors.Is, not os.IsNotExist: the store wraps the cause, and\n\t\t// os.IsNotExist does not unwrap. Reaching this at all is new — the\n\t\t// profiles branch above used to return before it.\n\t\tif !errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn base, err\n\t\t}\n\t\tspecs = nil\n\t}\n\tfullSpecs, targets, err := collectDeliveryTargetsIn(files, root, specs, profiles)\n\tif err != nil {\n\t\treturn base, err\n\t}\n\tresults, err := loadDeliveryValidationResultsIn(files, root, policy.ResultsPath)\n\tresults = withSmokeResultsIn(files, root, results)\n\tif err != nil {\n\t\treturn base, err\n\t}\n\troadmapSummaries, err := store.ListRoadmaps()\n\tif err != nil {\n\t\treturn base, err\n\t}\n\troadmaps := []posemodel.Roadmap{}\n\tfor _, summary := range roadmapSummaries {\n\t\tfull, err := store.GetRoadmap(summary.Slug)\n\t\tif err != nil {\n","exit_code":0,"status":"completed"}}
