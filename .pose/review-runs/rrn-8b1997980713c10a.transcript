{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc 'git diff ffbc2a0f4bafd8066137883a89c9ad224c96972f 5a416eae575649b44cdcc4278b3f27866a967ad4 -- pose-mcp/internal/pose'","aggregated_output":"diff --git a/pose-mcp/internal/pose/closeout_review_policy.go b/pose-mcp/internal/pose/closeout_review_policy.go\nindex 2ae87cdf..6222221c 100644\n--- a/pose-mcp/internal/pose/closeout_review_policy.go\n+++ b/pose-mcp/internal/pose/closeout_review_policy.go\n@@ -366,6 +366,19 @@ func (s Store) AggregateDependencyClosed(resolver ArtifactResolver, localProject\n \treturn false, scope + \" is reached but not closed: `pose close \" + scope + \"` publishes its closeout receipt\"\n }\n \n+// canonicalMember is milestoneMember after transfer redirects: a local member\n+// a transfer moved is its canonical destination, local or external. A\n+// redirect that cannot be followed reads as external, so no local consumer\n+// judges the redirect stub and federated proof fails closed on it (review\n+// round 9, N33).\n+func (s Store) canonicalMember(raw string) (string, bool) {\n+\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n+\tif unresolved != \"\" {\n+\t\treturn raw, true\n+\t}\n+\treturn slug, external\n+}\n+\n // localScopeClosed reports a local milestone or roadmap a dependency edge\n // names as closed by the terminal projection, under an adopted closeout\n // review policy where status alone never closes it. A scope already asking\n@@ -456,7 +469,7 @@ func (s Store) lastOpenMemberOf(roadmap string, milestone Milestone, slug string\n \t}\n \tmember := false\n \tfor _, raw := range milestone.Specs {\n-\t\tother, external := s.milestoneMember(raw)\n+\t\tother, external := s.canonicalMember(raw)\n \t\tif external {\n \t\t\treturn false\n \t\t}\ndiff --git a/pose-mcp/internal/pose/closeout_review_policy_test.go b/pose-mcp/internal/pose/closeout_review_policy_test.go\nindex fa0432ba..eee67d02 100644\n--- a/pose-mcp/internal/pose/closeout_review_policy_test.go\n+++ b/pose-mcp/internal/pose/closeout_review_policy_test.go\n@@ -1267,7 +1267,7 @@ func TestCloseoutReviewPolicyRoundEight(t *testing.T) {\n \t\tif v := state(milestone); v.State == \"closed\" || !v.Approved || !strings.Contains(v.NextAction, \"pose close \"+milestone) {\n \t\t\tt.Fatalf(\"an exempt milestone read closed before its receipt: %+v\", v)\n \t\t}\n-\t\tif v := state(roadmap); v.State == \"closed\" || !strings.Contains(strings.Join(v.Blockers, \";\"), \"child \"+milestone+\" is not closed\") {\n+\t\tif v := state(roadmap); v.State == \"closed\" || !strings.Contains(strings.Join(v.Blockers, \";\"), \"child \"+milestone+\" does not stand\") {\n \t\t\tt.Fatalf(\"an exempt roadmap read closed over an open milestone: %+v\", v)\n \t\t}\n \t\tcloseCoreWithReceipt(t, s)\n@@ -1291,3 +1291,66 @@ func TestCloseoutReviewPolicyRoundEight(t *testing.T) {\n \t\t}\n \t})\n }\n+\n+func TestCloseoutReviewPolicyRoundNine(t *testing.T) {\n+\tt.Run(\"an aggregate's own approval is ready to close until its receipt\", func(t *testing.T) {\n+\t\t_, s := closeoutReviewedFixture(t, \"always\", \"always\")\n+\t\tref := \"milestone:program/core\"\n+\t\tapproveCore(t, s, reviewFixtureNow.Add(2*time.Minute))\n+\t\tv, err := s.VerifyReviewBundle(ref)\n+\t\tif err != nil || !v.Approved || v.State != \"ready-to-close\" {\n+\t\t\tt.Fatalf(\"an approved milestone read closed before its explicit close: %+v %v\", v, err)\n+\t\t}\n+\t\tstate, err := s.GetCloseoutState(ref)\n+\t\tif err != nil || state.Review.CloseoutReview == nil {\n+\t\t\tt.Fatalf(\"%+v %v\", state, err)\n+\t\t}\n+\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n+\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif v, err := s.VerifyReviewBundle(ref); err != nil || v.State != \"closed\" {\n+\t\t\tt.Fatalf(\"an approved milestone with its receipt is not closed: %+v %v\", v, err)\n+\t\t}\n+\t})\n+\tt.Run(\"an exempt milestone with a receipt falls with its member\", func(t *testing.T) {\n+\t\t_, s := closeoutReviewedFixture(t, \"never\", \"never\")\n+\t\tref := \"milestone:program/core\"\n+\t\tcloseCoreWithReceipt(t, s)\n+\t\tif v, err := s.VerifyReviewBundle(ref); err != nil || v.State != \"closed\" {\n+\t\t\tt.Fatalf(\"%+v %v\", v, err)\n+\t\t}\n+\t\tmember, err := s.SealReviewBundle(\"spec:backend\", reviewFixtureNow.Add(3*time.Hour))\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err, member.Blockers)\n+\t\t}\n+\t\tattestChildReview(t, s, member, reviewFixtureNow.Add(4*time.Hour), \"rejected\")\n+\t\tif v, err := s.VerifyReviewBundle(ref); err != nil || v.State == \"closed\" || v.Approved {\n+\t\t\tt.Fatalf(\"a receipt-closed exempt milestone stood over a rejected member: %+v %v\", v, err)\n+\t\t}\n+\t})\n+\tt.Run(\"planning and lifecycle read a transferred member at its destination\", func(t *testing.T) {\n+\t\tresolver := artifactGraphTransferFixture(t, map[string][]string{\"xref:a/spec:moved\": nil, \"xref:b/spec:dest\": nil, \"xref:a/spec:stays\": nil}, map[string]string{\"xref:a/spec:moved\": \"xref:b/spec:dest\"})\n+\t\tsource, err := resolver.Roots.StoreFor(\"a\")\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\twriteReviewFixture(t, source.Root, \".pose/roadmaps/moves.md\", \"---\\nslug: moves\\nstatus: active\\n---\\n\\n## Milestone: m\\n- specs: moved, stays\\n\\n## Milestone: away\\n- specs: spec:moved\\n\")\n+\t\ts := Store{Root: source.Root, FederatedProjectID: \"a\", FederatedResolver: &resolver}\n+\t\tspecs, err := s.reviewScopeSpecs(ScopeRef{Kind: \"milestone\", Roadmap: \"moves\", Milestone: \"m\"})\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tfor _, sp := range specs {\n+\t\t\tif sp.Slug == \"moved\" {\n+\t\t\t\tt.Fatal(\"review planning selected the redirect stub\")\n+\t\t\t}\n+\t\t}\n+\t\tif done, err := s.scopeLifecycleDone(ScopeRef{Kind: \"milestone\", Roadmap: \"moves\", Milestone: \"away\"}); err != nil || !done {\n+\t\t\tt.Fatalf(\"a milestone whose member moved to a done destination is not done: %v %v\", done, err)\n+\t\t}\n+\t\tif _, sole := s.soleMemberOf(ScopeRef{Kind: \"milestone\", Roadmap: \"moves\", Milestone: \"away\"}); sole {\n+\t\t\tt.Fatal(\"a milestone inherits the review of the redirect stub\")\n+\t\t}\n+\t})\n+}\ndiff --git a/pose-mcp/internal/pose/obligation_projection.go b/pose-mcp/internal/pose/obligation_projection.go\nindex 4d5b8497..42fa0ec4 100644\n--- a/pose-mcp/internal/pose/obligation_projection.go\n+++ b/pose-mcp/internal/pose/obligation_projection.go\n@@ -420,7 +420,7 @@ func (s Store) obligationScopeSpecs(scope string) ([]Spec, error) {\n \t\t\t}\n \t\t\tfound = true\n \t\t\tfor _, member := range milestone.Specs {\n-\t\t\t\tif local, external := s.milestoneMember(member); !external {\n+\t\t\t\tif local, external := s.canonicalMember(member); !external {\n \t\t\t\t\tmembers[local] = true\n \t\t\t\t}\n \t\t\t}\ndiff --git a/pose-mcp/internal/pose/readiness.go b/pose-mcp/internal/pose/readiness.go\nindex 98072941..301d6660 100644\n--- a/pose-mcp/internal/pose/readiness.go\n+++ b/pose-mcp/internal/pose/readiness.go\n@@ -32,7 +32,7 @@ func (s Store) milestoneWaitingReason(ref string) string {\n \t\t}\n \t\tvar pending []string\n \t\tfor _, raw := range ms.Specs {\n-\t\t\tspecSlug, external := s.milestoneMember(raw)\n+\t\t\tspecSlug, external := s.canonicalMember(raw)\n \t\t\tif external {\n \t\t\t\tif !s.externalMemberDone(raw) {\n \t\t\t\t\tpending = append(pending, raw+\" (external, unresolved or not done)\")\ndiff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex 93e9d929..1f76d9b7 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -3464,6 +3464,27 @@ func (s Store) verifyReviewBundle(scope string) (ReviewBundleVerification, error\n // declares. Every reader of an approval comes through here, so they give one answer (ADR\n // a-milestone-of-one-member-is-that-member). A negative review recorded on it stands.\n func (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerification, error) {\n+\tverification, err := s.proportionalReviewVerificationOf(scope)\n+\tif err != nil || !verification.Approved || verification.State != \"closed\" {\n+\t\treturn verification, err\n+\t}\n+\t// Under an adopted closeout review policy an aggregate scope is closed\n+\t// only by its explicit close: an approval, its own, inherited or an\n+\t// exemption, leaves it ready to close until its receipt stands. A scope\n+\t// closed before adoption keeps its sealed reading (review round 9, N31).\n+\tref, parseErr := ParseScopeRef(scope)\n+\tif parseErr != nil || ref.Kind != \"milestone\" && ref.Kind != \"roadmap\" {\n+\t\treturn verification, nil\n+\t}\n+\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || !adopted || s.closeoutScopeHistorical(ref) || s.milestoneClosedBeforeAdoption(ref) || s.receiptStandsFor(scope) {\n+\t\treturn verification, nil\n+\t}\n+\tverification.State = \"ready-to-close\"\n+\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope + \" (`pose close \" + scope + \"` publishes its closeout receipt)\"\n+\treturn verification, nil\n+}\n+\n+func (s Store) proportionalReviewVerificationOf(scope string) (ReviewBundleVerification, error) {\n \town, err := s.computeReviewVerification(scope)\n \tif err != nil || own.Approved {\n \t\treturn own, err\n@@ -3513,19 +3534,28 @@ func (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerific\n \t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n \t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n \t\t}\n-\t\tif ref.Kind == \"roadmap\" {\n-\t\t\tif rm, err := s.GetRoadmap(ref.Slug); err == nil {\n-\t\t\t\tfor _, milestone := range rm.Milestones {\n-\t\t\t\t\tchild := ScopeRef{Kind: \"milestone\", Roadmap: rm.Slug, Milestone: milestone.ID}\n-\t\t\t\t\tif !s.receiptStandsFor(child.String()) && !s.milestoneClosedBeforeAdoption(child) {\n-\t\t\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child.String()+\" is not closed\")\n-\t\t\t\t\t}\n-\t\t\t\t}\n-\t\t\t}\n-\t\t\tif len(verification.Blockers) > 0 {\n-\t\t\t\tverification.NextAction = \"close the milestones of \" + scope + \" first: \" + strings.Join(verification.Blockers, \"; \")\n+\t\t// Each child must still stand, as an approved review requires of\n+\t\t// its children: a milestone's local members by their review, a\n+\t\t// roadmap's milestones by their own verification, which is closed\n+\t\t// only once their receipt stands. Neither recurses into this scope\n+\t\t// (review round 9, N32).\n+\t\tchildren, childErr := s.reviewBundleChildRefs(ref)\n+\t\tif childErr != nil {\n+\t\t\tverification.Blockers = append(verification.Blockers, childErr.Error())\n+\t\t}\n+\t\tfor _, child := range children {\n+\t\t\tstanding, err := s.verifyReviewBundle(child)\n+\t\t\tswitch {\n+\t\t\tcase err != nil:\n+\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child+\" cannot be verified: \"+err.Error())\n+\t\t\tcase standing.State != \"closed\" || !standing.Approved || !standing.Fresh:\n+\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child+\" does not stand: \"+standing.State)\n \t\t\t}\n \t\t}\n+\t\tif len(verification.Blockers) > 0 {\n+\t\t\tverification.State, verification.Approved = \"needs-review\", false\n+\t\t\tverification.NextAction = \"restore or close the children of \" + scope + \" first: \" + strings.Join(verification.Blockers, \"; \")\n+\t\t}\n \t\tif len(verification.Blockers) == 0 && s.receiptStandsFor(scope) {\n \t\t\tverification.State, verification.NextAction = \"closed\", \"scope is closed by its closeout receipt\"\n \t\t}\ndiff --git a/pose-mcp/internal/pose/review_closeout.go b/pose-mcp/internal/pose/review_closeout.go\nindex 35efaed0..be1baaec 100644\n--- a/pose-mcp/internal/pose/review_closeout.go\n+++ b/pose-mcp/internal/pose/review_closeout.go\n@@ -1395,7 +1395,7 @@ func (s Store) ScopeDigest(ref string) (string, error) {\n \t\t}\n \t\tchildren := map[string]string{}\n \t\tfor _, raw := range target.Specs {\n-\t\t\tslug, external := s.milestoneMember(raw)\n+\t\t\tslug, external := s.canonicalMember(raw)\n \t\t\tif external {\n \t\t\t\t// Another project's member is sealed by the federated\n \t\t\t\t// manifest; its identity is what this scope depends on.\n@@ -2552,7 +2552,7 @@ func (s Store) scopeLifecycleDone(scope ScopeRef) (bool, error) {\n \t\tfor _, milestone := range rm.Milestones {\n \t\t\tif milestone.ID == scope.Milestone {\n \t\t\t\tfor _, raw := range milestone.Specs {\n-\t\t\t\t\tslug, external := s.milestoneMember(raw)\n+\t\t\t\t\tslug, external := s.canonicalMember(raw)\n \t\t\t\t\tif external {\n \t\t\t\t\t\tif !s.externalMemberDone(raw) {\n \t\t\t\t\t\t\treturn false, nil\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex 5d03f40d..7182af75 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -579,7 +579,7 @@ func (s Store) reviewScopeSpecs(scope ScopeRef) ([]Spec, error) {\n \t\t// Another project's member contributes no local components; its\n \t\t// review lives in its own project and reaches this scope through the\n \t\t// federated manifest.\n-\t\tslug, external := s.milestoneMember(raw)\n+\t\tslug, external := s.canonicalMember(raw)\n \t\tif external {\n \t\t\tcontinue\n \t\t}\ndiff --git a/pose-mcp/internal/pose/roadmaps.go b/pose-mcp/internal/pose/roadmaps.go\nindex 791b9b87..52db058e 100644\n--- a/pose-mcp/internal/pose/roadmaps.go\n+++ b/pose-mcp/internal/pose/roadmaps.go\n@@ -136,7 +136,7 @@ func (s Store) milestonesWithTerminalMembers(spec, scope string) ([]string, erro\n func (s Store) milestoneMembersTerminal(milestone Milestone, statuses map[string]string, spec string) bool {\