{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '3390,3650p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"\t\t}\n\t\tif bundleID == \"\" || att.BundleID == bundleID {\n\t\t\tresult = append(result, att)\n\t\t}\n\t}\n\tsort.Slice(result, func(i, j int) bool {\n\t\t// By instant: \"04:02-08:00\" is later than \"12:01Z\", whatever the text says.\n\t\treturn attestationLess(result[i], result[j])\n\t})\n\tcoverage.Normalize()\n\treturn ReviewAttestationsRead{Attestations: result, Coverage: coverage}, nil\n}\n\n// futureSchema reports well-formed JSON whose schema_version is one this engine does not read.\nfunc futureSchema(raw []byte) bool {\n\tvar header struct {\n\t\tSchemaVersion int `json:\"schema_version\"`\n\t}\n\tif json.Unmarshal(raw, &header) != nil {\n\t\treturn false\n\t}\n\treturn header.SchemaVersion > ReviewBundleSchemaVersion\n}\n\nfunc (s Store) VerifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tverification, err := s.verifyReviewBundle(scope)\n\tif err == nil && verification.Bundle != nil {\n\t\tassurance := s.DescribeReviewAssurance(*verification.Bundle, verification.Attestation)\n\t\tverification.Assurance = &assurance\n\t}\n\tif err == nil {\n\t\tverification.DelegatedRuns, verification.DelegatedHistoryLosses = s.reviewRunSummaries(scope)\n\t}\n\tif err == nil && verification.Bundle != nil {\n\t\tif round, rerr := s.ReviewRoundOf(*verification.Bundle); rerr != nil {\n\t\t\tverification.DelegatedHistoryLosses = append(verification.DelegatedHistoryLosses, \"the round cannot be derived: \"+rerr.Error())\n\t\t} else {\n\t\t\tverification.Round = round.Number\n\t\t\tpolicy, _, _, _ := s.LoadDelegationPolicy()\n\t\t\tif threshold := policy.Routing.RoundThresholdOf(); round.Number >= threshold {\n\t\t\t\tverification.Warnings = append(verification.Warnings, fmt.Sprintf(\"%s is in review round %d, at or past the round threshold %d: the rounds are not converging; consider a different agent or a human adjudication\", scope, round.Number, threshold))\n\t\t\t}\n\t\t}\n\t}\n\treturn verification, err\n}\n\n// verifyReviewBundle verifies scope once per operation of the same project and\n// resolver, and refuses a scope already being verified: sealed children are\n// data, and a cycle among them must end in a named refusal (spec\n// pose-review-approval-follows-children R6).\nfunc (s Store) verifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tstate := s.reviewReuse\n\tkey := fmt.Sprintf(\"%s\\x00%t\\x00%s\", s.Root, s.FederatedResolver != nil, scope)\n\tif result, ok := state.children[key]; ok {\n\t\treturn result.verification, result.err\n\t}\n\tif state.verifying[key] {\n\t\treturn ReviewBundleVerification{}, fmt.Errorf(\"pose: the sealed children of %s form a cycle\", scope)\n\t}\n\tstate.verifying[key] = true\n\tdefer delete(state.verifying, key)\n\tif s.onReviewVerify != nil {\n\t\ts.onReviewVerify(scope)\n\t}\n\tverification, err := s.proportionalReviewVerification(scope)\n\tstate.children[key] = childVerificationResult{verification, err}\n\treturn verification, err\n}\n\n// proportionalReviewVerification is the verification of a scope, and of a milestone that\n// owes no review of its own: one made of a single closed, approved spec, or one a roadmap\n// declares. Every reader of an approval comes through here, so they give one answer (ADR\n// a-milestone-of-one-member-is-that-member). A negative review recorded on it stands.\nfunc (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerification, error) {\n\tverification, err := s.proportionalReviewVerificationOf(scope)\n\tif err != nil || !verification.Approved || verification.State != \"closed\" {\n\t\treturn verification, err\n\t}\n\t// Under an adopted closeout review policy an aggregate scope is closed\n\t// only by its explicit close: an approval, its own, inherited or an\n\t// exemption, leaves it ready to close until its receipt stands. A scope\n\t// closed before adoption keeps its sealed reading (review round 9, N31).\n\tref, parseErr := ParseScopeRef(scope)\n\tif parseErr != nil || ref.Kind != \"milestone\" && ref.Kind != \"roadmap\" {\n\t\treturn verification, nil\n\t}\n\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || !adopted || s.closeoutScopeHistorical(ref) || s.milestoneClosedBeforeAdoption(ref) || s.receiptStandsFor(scope) {\n\t\treturn verification, nil\n\t}\n\tverification.State = \"ready-to-close\"\n\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope + \" (`pose close \" + scope + \"` publishes its closeout receipt)\"\n\treturn verification, nil\n}\n\nfunc (s Store) proportionalReviewVerificationOf(scope string) (ReviewBundleVerification, error) {\n\town, err := s.computeReviewVerification(scope)\n\tif err != nil || own.Approved {\n\t\treturn own, err\n\t}\n\tref, parseErr := ParseScopeRef(scope)\n\tif parseErr != nil || (ref.Kind != \"milestone\" && ref.Kind != \"roadmap\") {\n\t\treturn own, nil\n\t}\n\t// A policy without bundles answers through its review attempts alone, and has no\n\t// bundle of the spec to stand on.\n\tpolicy, err := s.GetReviewPolicy()\n\tif err != nil || !policy.ReviewBundles {\n\t\treturn own, nil\n\t}\n\tif s.milestoneReviewRefused(scope) {\n\t\treturn own, nil\n\t}\n\t// An adopted closeout review policy is the only rule for an open scope:\n\t// legacy inheritance and declared exemptions cannot weaken `always`, and\n\t// the policy's own exemption reads the same gate as reviewCheck. A roadmap\n\t// closed before adoption keeps the legacy reading below.\n\tadopted := policy.CloseoutReviewAdopted() && !s.closeoutScopeHistorical(ref)\n\tif adopted {\n\t\tdecision, exempt, gateErr := s.closeoutReviewGate(scope, policy)\n\t\tif gateErr != nil || decision == nil || !exempt || !decision.Known {\n\t\t\treturn own, nil\n\t\t}\n\t\tif s.FederatedResolver != nil {\n\t\t\tvar acceptance FederatedRoadmapAcceptanceReport\n\t\t\tvar err error\n\t\t\tif ref.Kind == \"milestone\" {\n\t\t\t\tacceptance, err = s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n\t\t\t} else {\n\t\t\t\tacceptance, err = s.FederatedRoadmapAcceptance(s.FederatedProjectID, ref.Slug, *s.FederatedResolver)\n\t\t\t}\n\t\t\tif err != nil || !acceptance.Ready {\n\t\t\t\treturn own, nil\n\t\t\t}\n\t\t}\n\t\t// The exemption satisfies the review, not the close: the scope is\n\t\t// closed only by its explicit close, whose receipt must stand, and a\n\t\t// roadmap only over closed milestones. The full terminal verifier\n\t\t// is closeout's (review round 8, N30).\n\t\tverification := ReviewBundleVerification{\n\t\t\tScope: scope, State: \"ready-to-close\", Fresh: true, Approved: true,\n\t\t\tNextAction:     \"apply the guarded lifecycle transition for \" + scope + \" (`pose close \" + scope + \"` publishes its closeout receipt)\",\n\t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n\t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n\t\t}\n\t\t// Each child must still stand, as an approved review requires of\n\t\t// its children: a milestone's local members by their review, a\n\t\t// roadmap's milestones by their own verification, which is closed\n\t\t// only once their receipt stands. Neither recurses into this scope\n\t\t// (review round 9, N32).\n\t\tchildren, childErr := s.reviewBundleChildRefs(ref)\n\t\tif childErr != nil {\n\t\t\tverification.Blockers = append(verification.Blockers, childErr.Error())\n\t\t}\n\t\tfor _, child := range children {\n\t\t\tstanding, err := s.verifyReviewBundle(child)\n\t\t\tswitch {\n\t\t\tcase err != nil:\n\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child+\" cannot be verified: \"+err.Error())\n\t\t\tcase standing.State != \"closed\" || !standing.Approved || !standing.Fresh:\n\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child+\" does not stand: \"+standing.State)\n\t\t\t}\n\t\t}\n\t\tif len(verification.Blockers) > 0 {\n\t\t\tverification.State, verification.Approved = \"needs-review\", false\n\t\t\tverification.NextAction = \"restore or close the children of \" + scope + \" first: \" + strings.Join(verification.Blockers, \"; \")\n\t\t}\n\t\tif len(verification.Blockers) == 0 && s.receiptStandsFor(scope) {\n\t\t\tverification.State, verification.NextAction = \"closed\", \"scope is closed by its closeout receipt\"\n\t\t}\n\t\treturn verification, nil\n\t}\n\tif ref.Kind != \"milestone\" {\n\t\treturn own, nil\n\t}\n\t// Edges still bind: a milestone inherits a review, not the acceptance of what it\n\t// depends on, and revoked trust or an open predecessor leaves it where it was.\n\tif s.FederatedResolver != nil {\n\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n\t\tif err != nil || !acceptance.Ready {\n\t\t\treturn own, nil\n\t\t}\n\t}\n\tif member, ok := s.soleMemberOf(ref); ok {\n\t\tchild, err := s.verifyReviewBundle(\"spec:\" + member)\n\t\tif err == nil && child.State == \"closed\" && child.Fresh && child.Approved {\n\t\t\treturn ReviewBundleVerification{\n\t\t\t\tScope: scope, State: \"closed\", Bundle: child.Bundle, Attestation: child.Attestation, Fresh: true, Approved: true,\n\t\t\t\tNextAction: \"none\", Warnings: []string{\"the approval of \" + scope + \" is inherited from spec:\" + member + \", its only member\"},\n\t\t\t\tApprovalOrigin: \"inherited:spec:\" + member, inherited: true,\n\t\t\t}, nil\n\t\t}\n\t}\n\tif reason := s.declaredUnreviewed(ref); reason != \"\" {\n\t\treturn ReviewBundleVerification{\n\t\t\tScope: scope, State: \"closed\", Fresh: true, Approved: true, NextAction: \"none\",\n\t\t\tWarnings:       []string{scope + \" stands without a review, as its roadmap declares: \" + reason},\n\t\t\tApprovalOrigin: \"declared:roadmap:\" + ref.Roadmap, inherited: true,\n\t\t}, nil\n\t}\n\treturn own, nil\n}\n\n// milestoneReviewRefused reports a refusal recorded on the milestone itself, in a bundle\n// or in a legacy attempt.\nfunc (s Store) milestoneReviewRefused(scope string) bool {\n\tif bundle, _ := s.latestNegativeReview(scope); bundle != nil {\n\t\treturn true\n\t}\n\tattempts, err := s.ReadReviewAttempts(scope)\n\tif err != nil || !attempts.Coverage.CompleteFor(scope) {\n\t\treturn true\n\t}\n\tif len(attempts.Attempts) == 0 {\n\t\treturn false\n\t}\n\tlatest := attempts.Attempts[len(attempts.Attempts)-1]\n\treturn latest.Decision == \"rejected\" || latest.Decision == \"changes-requested\"\n}\n\nfunc (s Store) computeReviewVerification(scope string) (ReviewBundleVerification, error) {\n\tpolicy, err := s.GetReviewPolicy()\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n\tscopeRef, scopeErr := ParseScopeRef(scope)\n\tif scopeErr != nil {\n\t\treturn ReviewBundleVerification{}, scopeErr\n\t}\n\n\tbundlesRead, err := s.ReadReviewBundles(scope)\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n\tbundles := bundlesRead.Bundles\n\n\tif (policy.SchemaVersion < ReviewPolicySchemaVersion || !policy.ReviewBundles) && len(bundles) == 0 {\n\t\teval, evalErr := s.ReviewCheck(scope)\n\t\tif evalErr != nil {\n\t\t\treturn ReviewBundleVerification{}, evalErr\n\t\t}\n\t\tverification := ReviewBundleVerification{\n\t\t\tScope:    scope,\n\t\t\tState:    \"needs-review\",\n\t\t\tFresh:    eval.Fresh,\n\t\t\tApproved: eval.Approved,\n\t\t\tWarnings: append([]string{}, eval.Warnings...),\n\t\t\tBlockers: append([]string{}, eval.Blockers...),\n\t\t}\n\t\tif eval.Current != nil {\n\t\t\tverification.NextAction = \"record fresh review for \" + scope\n\t\t\tif eval.Current.Decision == \"changes-requested\" || eval.Current.Decision == \"rejected\" {\n\t\t\t\tverification.State = eval.Current.Decision\n\t\t\t} else if !eval.Fresh {\n\t\t\t\tverification.State = \"superseded\"\n\t\t\t}\n\t\t} else {\n\t\t\tverification.NextAction = \"record review for \" + scope\n\t\t}\n","exit_code":0,"status":"completed"}}
