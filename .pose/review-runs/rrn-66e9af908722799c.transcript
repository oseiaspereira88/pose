ritor da geração não descreve (geração indisponível, ou arquivos que diferem da geração) como erro no modo estrito e aviso no tolerante, nomeando `pose index`, em vez de deixar a causa aparecer só como \"input closure is unknown\" em cada review closeout.\ndiff --git a/.pose/starts/pose-commit-gate-refuses-index-without-descriptor.json b/.pose/starts/pose-commit-gate-refuses-index-without-descriptor.json\nnew file mode 100644\nindex 00000000..105f5f5b\n--- /dev/null\n+++ b/.pose/starts/pose-commit-gate-refuses-index-without-descriptor.json\n@@ -0,0 +1,49 @@\n+{\n+  \"schema_version\": 1,\n+  \"spec\": \"pose-commit-gate-refuses-index-without-descriptor\",\n+  \"plan_digest\": \"2816a99aa8f2bfdf5cc5d592e1a7cc1a0940604e6577f187b3069dbc6e4dfd8f\",\n+  \"revision\": \"f28286f66dde1130265f0c0ab6bf0387504eb09a\",\n+  \"spec_digest_before\": \"c374e02cbbc6e7ff772eb959771f6c34b44f5ad4effacd329e75d1543ba5c663\",\n+  \"spec_digest_after\": \"97814fee734e67fbc16cdc8ad7f364d6109a89117d15c8919faad9221f3a7c15\",\n+  \"baseline\": {\n+    \"schema_version\": 1,\n+    \"namespace\": \"spec:pose-commit-gate-refuses-index-without-descriptor\",\n+    \"nodes\": [\n+      {\n+        \"id\": \"R1\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-commit-gate-refuses-index-without-descriptor\",\n+        \"hash\": \"b1760ca2eea3\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R2\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-commit-gate-refuses-index-without-descriptor\",\n+        \"hash\": \"da43bac315c5\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R3\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-commit-gate-refuses-index-without-descriptor\",\n+        \"hash\": \"f522dd87e161\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"D1\",\n+        \"kind\": \"decision\",\n+        \"namespace\": \"spec:pose-commit-gate-refuses-index-without-descriptor\",\n+        \"hash\": \"29028e548080\",\n+        \"state\": \"active\",\n+        \"relations\": [\n+          \"R1\",\n+          \"R2\"\n+        ]\n+      }\n+    ],\n+    \"digest\": \"sha256:6928660a58fcea9f27310b092bb388c1451d80393dd2f28c2a3c500f58a59f73\"\n+  },\n+  \"phase\": \"started\",\n+  \"recorded_at\": \"2026-11-10T23:35:56Z\"\n+}\ndiff --git a/pose-mcp/internal/cli/check.go b/pose-mcp/internal/cli/check.go\nindex efea9ed3..2265a1b6 100644\n--- a/pose-mcp/internal/cli/check.go\n+++ b/pose-mcp/internal/cli/check.go\n@@ -144,6 +144,7 @@ func cmdCheckWithLocaleIn(files pose.Files, root string, args []string, stdout,\n \tchecker.checkSchemaVersion()\n \tchecker.checkReferences()\n \tchecker.checkValidationMatrix()\n+\tchecker.checkIndexGeneration()\n \tchecker.checkTaskMap()\n \tchecker.checkSpecs()\n \tchecker.checkReviewCloseout()\n@@ -475,6 +476,22 @@ func isRuntimeReference(ref string) bool {\n \treturn false\n }\n \n+// checkIndexGeneration reports an index set that cannot be read as a whole: the descriptor names a\n+// generation whose files are gone or no longer match it, or files under .pose/indexes differ from\n+// the generation they belong to. It is the structural half of `pose index --verify` (no input is\n+// recomputed): a commit that regenerated indexes without their descriptor leaves the set exactly\n+// so, and every review closeout after it is unknown (spec\n+// pose-commit-gate-refuses-index-without-descriptor).\n+func (checker *nativeChecker) checkIndexGeneration() {\n+\tview := pose.Store{Root: checker.root, FS: checker.fsys()}.ReadIndexGeneration()\n+\tswitch {\n+\tcase view.Status == pose.IndexGenerationUnavailable:\n+\t\tchecker.failOrWarn(checker.message(\"index set unavailable: \", \"conjunto de índices indisponível: \") + view.Reason + checker.message(\"; run `pose index`\", \"; rode `pose index`\"))\n+\tcase view.Status == pose.IndexGenerationCurrent && len(view.Diverged) > 0:\n+\t\tchecker.failOrWarn(checker.message(\"index files differ from generation \", \"arquivos de índice diferem da geração \") + view.Descriptor.GenerationID + \": \" + strings.Join(view.Diverged, \", \") + checker.message(\"; run `pose index`\", \"; rode `pose index`\"))\n+\t}\n+}\n+\n func (checker *nativeChecker) checkValidationMatrix() {\n \tpath := filepath.Join(checker.root, \".pose\", \"indexes\", \"validation-matrix.json\")\n \traw, err := checker.fsys().ReadFile(path)\ndiff --git a/pose-mcp/internal/cli/check_index_generation_test.go b/pose-mcp/internal/cli/check_index_generation_test.go\nnew file mode 100644\nindex 00000000..f37a1564\n--- /dev/null\n+++ b/pose-mcp/internal/cli/check_index_generation_test.go\n@@ -0,0 +1,60 @@\n+package cli\n+\n+import (\n+\t\"bytes\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-commit-gate-refuses-index-without-descriptor.\n+\n+func checkOutput(t *testing.T, root string, args ...string) (int, string) {\n+\tt.Helper()\n+\tvar out, errb bytes.Buffer\n+\tcode := cmdCheck(root, args, &out, &errb)\n+\treturn code, out.String() + errb.String()\n+}\n+\n+// R1/R2/R3: an index set whose descriptor no longer describes its files is an error of the strict gate\n+// (a warning of the tolerant one) naming `pose index`; the repaired set and a repository with no\n+// generation pass that check.\n+func TestCheckRefusesAnIndexSetThatItsDescriptorDoesNotDescribe(t *testing.T) {\n+\troot, _, _ := artifactGitFixture(t)\n+\tif _, out := checkOutput(t, root); strings.Contains(out, \"index set unavailable\") || strings.Contains(out, \"differ from generation\") {\n+\t\tt.Fatalf(\"a repository with no generation is reported: %s\", out)\n+\t}\n+\tif code, _, errOut := runIndex(t, root); code != 0 {\n+\t\tt.Fatalf(\"index: %d %s\", code, errOut)\n+\t}\n+\tif _, out := checkOutput(t, root); strings.Contains(out, \"index set unavailable\") || strings.Contains(out, \"differ from generation\") {\n+\t\tt.Fatalf(\"a whole set is reported: %s\", out)\n+\t}\n+\t// What a commit of regenerated indexes without their descriptor leaves in a checkout: the\n+\t// generation directory is not committed and the legacy copy no longer matches.\n+\tif err := os.RemoveAll(filepath.Join(root, \".pose\", \"indexes\", \"generations\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.WriteFile(filepath.Join(root, \".pose\", \"indexes\", \"spec-graph.json\"), []byte(\"{\\\"edited\\\":true}\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tcode, out := checkOutput(t, root)\n+\tif !strings.Contains(out, \"index set unavailable\") || !strings.Contains(out, \"spec-graph.json\") || !strings.Contains(out, \"pose index\") {\n+\t\tt.Fatalf(\"strict check does not name the unavailable set: %s\", out)\n+\t}\n+\tif code == 0 {\n+\t\tt.Fatalf(\"strict check passed with an unavailable index set: %s\", out)\n+\t}\n+\t// The tolerant gate (a commit hook) warns and does not fail on this finding.\n+\t_, tolerant := checkOutput(t, root, \"--tolerant\")\n+\tif !strings.Contains(tolerant, \"index set unavailable\") {\n+\t\tt.Fatalf(\"the tolerant gate does not mention it: %s\", tolerant)\n+\t}\n+\tif code, _, errOut := runIndex(t, root); code != 0 {\n+\t\tt.Fatalf(\"pose index over the unavailable set: %d %s\", code, errOut)\n+\t}\n+\tif _, out := checkOutput(t, root); strings.Contains(out, \"index set unavailable\") {\n+\t\tt.Fatalf(\"the repaired set is still reported: %s\", out)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/governance_read_view_git.go b/pose-mcp/internal/pose/governance_read_view_git.go\nindex 090ed2f5..2d097182 100644\n--- a/pose-mcp/internal/pose/governance_read_view_git.go\n+++ b/pose-mcp/internal/pose/governance_read_view_git.go\n@@ -42,13 +42,33 @@ type governanceReadViewGitObservation struct {\n // one read-view operation. Repeated commands replay the first result; audit\n // reruns each exact command and reports any changed or unprovable result.\n type governanceReadViewGitState struct {\n-\top           *governanceReadViewOperation\n-\tmu           sync.Mutex\n-\tobservations map[string]*governanceReadViewGitObservation\n+\top            *governanceReadViewOperation\n+\tmu            sync.Mutex\n+\tobservations  map[string]*governanceReadViewGitObservation\n+\tconfigMu      sync.Mutex\n+\tconfigDigests map[string]string\n+}\n+\n+// effectiveGitConfig is the digest of `git config --list` of a root (every scope, includes\n+// followed), read once per operation and kept apart from the command observations: it is a key\n+// of the resident memo, not an input the audit replays. Empty when it could not be read.\n+func (state *governanceReadViewGitState) effectiveGitConfig(ctx context.Context, files Files, root string) string {\n+\tstate.configMu.Lock()\n+\tdefer state.configMu.Unlock()\n+\tif digest, ok := state.configDigests[root]; ok {\n+\t\treturn digest\n+\t}\n+\tdigest := \"\"\n+\tif out, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, []string{\"config\", \"--list\", \"-z\", \"--includes\"}, 1<<20); err == nil {\n+\t\tsum := sha256.Sum256(out)\n+\t\tdigest = hex.EncodeToString(sum[:8])\n+\t}\n+\tstate.configDigests[root] = digest\n+\treturn digest\n }\n \n func newGovernanceReadViewGitState(op *governanceReadViewOperation) *governanceReadViewGitState {\n-\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}}\n+\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}, configDigests: map[string]string{}}\n }\n \n // captureGovernanceGit runs a Git command through the read-view generation\n@@ -340,7 +360,7 @@ func (state *governanceReadViewGitState) capture(files Files, ctx context.Contex\n \tmemoKey, memoized := \"\", false\n \tmemo := residentGit.Load()\n \tif memo != nil && (byObject || byHead && headBefore != \"\") {\n-\t\tif key, ok := residentGitKey(root, headBefore, args); ok {\n+\t\tif key, ok := residentGitKey(root, headBefore, s