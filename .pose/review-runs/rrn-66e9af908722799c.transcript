 \"id\": \"R1\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-commit-gate-refuses-index-without-descriptor\",\n+        \"hash\": \"b1760ca2eea3\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R2\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-commit-gate-refuses-index-without-descriptor\",\n+        \"hash\": \"da43bac315c5\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R3\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-commit-gate-refuses-index-without-descriptor\",\n+        \"hash\": \"f522dd87e161\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"D1\",\n+        \"kind\": \"decision\",\n+        \"namespace\": \"spec:pose-commit-gate-refuses-index-without-descriptor\",\n+        \"hash\": \"29028e548080\",\n+        \"state\": \"active\",\n+        \"relations\": [\n+          \"R1\",\n+          \"R2\"\n+        ]\n+      }\n+    ],\n+    \"digest\": \"sha256:6928660a58fcea9f27310b092bb388c1451d80393dd2f28c2a3c500f58a59f73\"\n+  },\n+  \"phase\": \"started\",\n+  \"recorded_at\": \"2026-11-10T23:35:56Z\"\n+}\ndiff --git a/pose-mcp/internal/cli/check.go b/pose-mcp/internal/cli/check.go\nindex efea9ed3..2265a1b6 100644\n--- a/pose-mcp/internal/cli/check.go\n+++ b/pose-mcp/internal/cli/check.go\n@@ -144,6 +144,7 @@ func cmdCheckWithLocaleIn(files pose.Files, root string, args []string, stdout,\n \tchecker.checkSchemaVersion()\n \tchecker.checkReferences()\n \tchecker.checkValidationMatrix()\n+\tchecker.checkIndexGeneration()\n \tchecker.checkTaskMap()\n \tchecker.checkSpecs()\n \tchecker.checkReviewCloseout()\n@@ -475,6 +476,22 @@ func isRuntimeReference(ref string) bool {\n \treturn false\n }\n \n+// checkIndexGeneration reports an index set that cannot be read as a whole: the descriptor names a\n+// generation whose files are gone or no longer match it, or files under .pose/indexes differ from\n+// the generation they belong to. It is the structural half of `pose index --verify` (no input is\n+// recomputed): a commit that regenerated indexes without their descriptor leaves the set exactly\n+// so, and every review closeout after it is unknown (spec\n+// pose-commit-gate-refuses-index-without-descriptor).\n+func (checker *nativeChecker) checkIndexGeneration() {\n+\tview := pose.Store{Root: checker.root, FS: checker.fsys()}.ReadIndexGeneration()\n+\tswitch {\n+\tcase view.Status == pose.IndexGenerationUnavailable:\n+\t\tchecker.failOrWarn(checker.message(\"index set unavailable: \", \"conjunto de índices indisponível: \") + view.Reason + checker.message(\"; run `pose index`\", \"; rode `pose index`\"))\n+\tcase view.Status == pose.IndexGenerationCurrent && len(view.Diverged) > 0:\n+\t\tchecker.failOrWarn(checker.message(\"index files differ from generation \", \"arquivos de índice diferem da geração \") + view.Descriptor.GenerationID + \": \" + strings.Join(view.Diverged, \", \") + checker.message(\"; run `pose index`\", \"; rode `pose index`\"))\n+\t}\n+}\n+\n func (checker *nativeChecker) checkValidationMatrix() {\n \tpath := filepath.Join(checker.root, \".pose\", \"indexes\", \"validation-matrix.json\")\n \traw, err := checker.fsys().ReadFile(path)\ndiff --git a/pose-mcp/internal/cli/check_index_generation_test.go b/pose-mcp/internal/cli/check_index_generation_test.go\nnew file mode 100644\nindex 00000000..f37a1564\n--- /dev/null\n+++ b/pose-mcp/internal/cli/check_index_generation_test.go\n@@ -0,0 +1,60 @@\n+package cli\n+\n+import (\n+\t\"bytes\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-commit-gate-refuses-index-without-descriptor.\n+\n+func checkOutput(t *testing.T, root string, args ...string) (int, string) {\n+\tt.Helper()\n+\tvar out, errb bytes.Buffer\n+\tcode := cmdCheck(root, args, &out, &errb)\n+\treturn code, out.String() + errb.String()\n+}\n+\n+// R1/R2/R3: an index set whose descriptor no longer describes its files is an error of the strict gate\n+// (a warning of the tolerant one) naming `pose index`; the repaired set and a repository with no\n+// generation pass that check.\n+func TestCheckRefusesAnIndexSetThatItsDescriptorDoesNotDescribe(t *testing.T) {\n+\troot, _, _ := artifactGitFixture(t)\n+\tif _, out := checkOutput(t, root); strings.Contains(out, \"index set unavailable\") || strings.Contains(out, \"differ from generation\") {\n+\t\tt.Fatalf(\"a repository with no generation is reported: %s\", out)\n+\t}\n+\tif code, _, errOut := runIndex(t, root); code != 0 {\n+\t\tt.Fatalf(\"index: %d %s\", code, errOut)\n+\t}\n+\tif _, out := checkOutput(t, root); strings.Contains(out, \"index set unavailable\") || strings.Contains(out, \"differ from generation\") {\n+\t\tt.Fatalf(\"a whole set is reported: %s\", out)\n+\t}\n+\t// What a commit of regenerated indexes without their descriptor leaves in a checkout: the\n+\t// generation directory is not committed and the legacy copy no longer matches.\n+\tif err := os.RemoveAll(filepath.Join(root, \".pose\", \"indexes\", \"generations\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.WriteFile(filepath.Join(root, \".pose\", \"indexes\", \"spec-graph.json\"), []byte(\"{\\\"edited\\\":true}\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tcode, out := checkOutput(t, root)\n+\tif !strings.Contains(out, \"index set unavailable\") || !strings.Contains(out, \"spec-graph.json\") || !strings.Contains(out, \"pose index\") {\n+\t\tt.Fatalf(\"strict check does not name the unavailable set: %s\", out)\n+\t}\n+\tif code == 0 {\n+\t\tt.Fatalf(\"strict check passed with an unavailable index set: %s\", out)\n+\t}\n+\t// The tolerant gate (a commit hook) warns and does not fail on this finding.\n+\t_, tolerant := checkOutput(t, root, \"--tolerant\")\n+\tif !strings.Contains(tolerant, \"index set unavailable\") {\n+\t\tt.Fatalf(\"the tolerant gate does not mention it: %s\", tolerant)\n+\t}\n+\tif code, _, errOut := runIndex(t, root); code != 0 {\n+\t\tt.Fatalf(\"pose index over the unavailable set: %d %s\", code, errOut)\n+\t}\n+\tif _, out := checkOutput(t, root); strings.Contains(out, \"index set unavailable\") {\n+\t\tt.Fatalf(\"the repaired set is still reported: %s\", out)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/governance_read_view_git.go b/pose-mcp/internal/pose/governance_read_view_git.go\nindex 090ed2f5..2d097182 100644\n--- a/pose-mcp/internal/pose/governance_read_view_git.go\n+++ b/pose-mcp/internal/pose/governance_read_view_git.go\n@@ -42,13 +42,33 @@ type governanceReadViewGitObservation struct {\n // one read-view operation. Repeated commands replay the first result; audit\n // reruns each exact command and reports any changed or unprovable result.\n type governanceReadViewGitState struct {\n-\top           *governanceReadViewOperation\n-\tmu           sync.Mutex\n-\tobservations map[string]*governanceReadViewGitObservation\n+\top            *governanceReadViewOperation\n+\tmu            sync.Mutex\n+\tobservations  map[string]*governanceReadViewGitObservation\n+\tconfigMu      sync.Mutex\n+\tconfigDigests map[string]string\n+}\n+\n+// effectiveGitConfig is the digest of `git config --list` of a root (every scope, includes\n+// followed), read once per operation and kept apart from the command observations: it is a key\n+// of the resident memo, not an input the audit replays. Empty when it could not be read.\n+func (state *governanceReadViewGitState) effectiveGitConfig(ctx context.Context, files Files, root string) string {\n+\tstate.configMu.Lock()\n+\tdefer state.configMu.Unlock()\n+\tif digest, ok := state.configDigests[root]; ok {\n+\t\treturn digest\n+\t}\n+\tdigest := \"\"\n+\tif out, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, []string{\"config\", \"--list\", \"-z\", \"--includes\"}, 1<<20); err == nil {\n+\t\tsum := sha256.Sum256(out)\n+\t\tdigest = hex.EncodeToString(sum[:8])\n+\t}\n+\tstate.configDigests[root] = digest\n+\treturn digest\n }\n \n func newGovernanceReadViewGitState(op *governanceReadViewOperation) *governanceReadViewGitState {\n-\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}}\n+\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}, configDigests: map[string]string{}}\n }\n \n // captureGovernanceGit runs a Git command through the read-view generation\n@@ -340,7 +360,7 @@ func (state *governanceReadViewGitState) capture(files Files, ctx context.Contex\n \tmemoKey, memoized := \"\", false\n \tmemo := residentGit.Load()\n \tif memo != nil && (byObject || byHead && headBefore != \"\") {\n-\t\tif key, ok := residentGitKey(root, headBefore, args); ok {\n+\t\tif key, ok := residentGitKey(root, headBefore, state.effectiveGitConfig(ctx, files, root), args); ok {\n \t\t\tmemoKey = key\n \t\t\tif hit, found := memo.get(key); found {\n \t\t\t\tif int64(len(hit)) > limit || !state.op.reserveInput(int64(len(hit))) {\ndiff --git a/pose-mcp/internal/pose/resident_git_memo.go b/pose-mcp/internal/pose/resident_git_memo.go\nindex fdab1685..aaab8ddc 100644\n--- a/pose-mcp/internal/pose/resident_git_memo.go\n+++ b/pose-mcp/internal/pose/resident_git_memo.go\n@@ -57,8 +57,13 @@ func ResidentGitMemoStats() (hits, misses int64, entries int, bytes int64) {\n \n // residentGitKey names a read: the root, the commit it was made at (empty for a read by object\n // id), the shallow state of the repository and the exact command. A root whose Git directory\n-// is not a plain .git directory is not memoized: its shallow state is not read here.\n-func residentGitKey(root, head string, args []string) (string, bool) {\n+// is not a plain .git directory is not memoized: its shallow state is not read here. The key\n+// also holds the digest of the effective Git configuration of the root.\n+func residentGitKey(root, head, config string, args []string) (string, bool) {\n+\tif config == \"\" {\n+\t\t// The effective Git configuration could not be read: nothing is memoized.\n+\t\treturn \"\", false\n+\t}\n \tgitDir := filepath.Join(root, \".git\")\n \tinfo, err := os.Lstat(gitDir)\n \tif err != nil || !info.IsDir() {\n@@ -75,8 +80,9 @@ func residentGitKey(root, head string, args []string) (string, bool) {\n \t\treturn hex.EncodeToString(sum[:8])\n \t}\n \tshallow := digestOf(\"shallow\")\n-\t// The repository's own config can change what a read answers (log.follow, for one).\n-\tconfig := digestOf(\"config\")\n+\t// config is the digest of the effective Git configuration of the root (system, global, user,\n+\t// repository, worktree and command-line scopes, includes followed): any of them can change\n+\t// what a read answers (log.follow, for one), and the digest is taken once per operation.\n \treturn strings.Join([]string{filepath.Clean(root), head, shallow, config, strings.Join(args, \"\\x00\")}, \"\\x01\"), true\n }\n \ndiff --git a/pose-mcp/internal/pose/resident_git_memo_test.go b/pose-mcp/internal/pose/resident_git_memo_test.go\nindex 7d39a011..c492cfe3 100644\n--- a/pose-mcp/internal/pose/resident_git_memo_test.go\n+++ b/pose-mcp/internal/pose/resident_git_memo_test.go\n@@ -1,6 +1,7 @@\n package pose\n \n import (\n+\t\"context\"\n \t\"os\"\n \t\"path/filepath\"\n \t\"strings\"\n@@ -19,18 +20,18 @@ func TestTheResidentGitMemoIsOffByDefaultBoundedAndKeyedByTheCommit(t *testing.T\n \tm := EnableResidentGitMemo(400)\n \tdefer DisableResidentGitMemo()\n \targs := []string{\"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\"}\n-\tk1, ok := residentGitKey(root, \"head1\", args)\n+\tk1, ok := residentGitKey(root, \"head1\", \"cfg\", args)\n \tif !ok {\n \t\tt.Fatal(\"a plain .git directory is not memoizable\")\n \t}\n-\tk2, _ := residentGitKey(root, \"head2\", args)\n+\tk2, _ := residentGitKey(root, \"head2\", \"cfg\", args)\n \tif k1 == k2 {\n \t\tt.Fatal(\"two commits share a key\")\n \t}\n \tif err := os.WriteFile(filepath.Join(root, \".git\", \"shallow\"), []byte(\"x\\n\"), 0o644); err != nil {\n \t\tt.Fatal(err)\n \t}\n-\tif k3, _ := residentGitKey(root, \"head1\", args); k3 == k1 {\n+\tif k3, _ := residentGitKey(root, \"head1\", \"cfg\", args); k3 == k1 {\n \t\tt.Fatal(\"a shallow repository shares the key of a full one\")\n \t}\n \tm.put(\"a\", []byte(strings.Repeat(\"x\", 150)))\n@@ -52,12 +53,24 @@ func TestTheResidentGitMemoIsOffByDefaultBoundedAndKeyedByTheCommit(t *testing.T\n \tif _, hit := m.get(\"huge\"); hit {\n \t\tt.Fatal(\"an entry larger than the budget was retained\")\n \t}\n+\t// The effective Git configuration is part of the key, and an unreadable one memoizes nothing.\n+\tif os.Remove(filepath.Join(root, \".git\", \"shallow\")) != nil {\n+\t\tt.Fatal(\"the shallow file the test wrote is gone\")\n+\t}\n+\tkc1, _ := residentGitKey(root, \"head1\", \"cfgA\", args)\n+\tkc2, _ := residentGitKey(root, \"head1\", \"cfgB\", args)\n+\tif kc1 == kc2 {\n+\t\tt.Fatal(\"two configurations share a key\")\n+\t}\n+\tif _, ok := residentGitKey(root, \"head1\", \"\", args); ok {\n+\t\tt.Fatal(\"an unreadable configuration was memoized\")\n+\t}\n \t// A linked worktree (.git is a file) is not memoized.\n \tlinked := t.TempDir()\n \tif err := os.WriteFile(filepath.Join(linked, \".git\"), []byte(\"gitdir: elsewhere\\n\"), 0o644); err != nil {\n \t\tt.Fatal(err)\n \t}\n-\tif _, ok := residentGitKey(linked, \"h\", args); ok {\n+\tif _, ok := residentGitKey(linked, \"h\", \"cfg\", args); ok {\n \t\tt.Fatal(\"a linked worktree was memoized\")\n \t}\n }\n@@ -101,3 +114,40 @@ func TestASecondOperationIsAnsweredFromTheMemoAndANewCommitMissesIt(t *testing.T\n \t\tt.Fatalf(\"after the new commit hits %d misses %d, want 1 and 2\", hits, misses)\n \t}\n }\n+\n+// A global Git configuration that changes what a read answers must change the key: the digest of\n+// the effective configuration follows a change of the user's own configuration file.\n+func TestTheEffectiveGitConfigurationFollowsTheUsersConfigurationFile(t *testing.T) {\n+\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\"})\n+\thome := t.TempDir()\n+\tt.Setenv(\"HOME\", home)\n+\tt.Setenv(\"XDG_CONFIG_HOME\", filepath.Join(home, \"xdg\"))\n+\tt.Setenv(\"GIT_CONFIG_NOSYSTEM\", \"1\")\n+\t_, view := (Store{Root: root}).beginGovernanceReadView()\n+\tstate := view.operation.git\n+\tctx := context.Background()\n+\tbefore := state.effectiveGitConfig(ctx, NativeFiles(), root)\n+\tif before == \"\" {\n+\t\tt.Skip(\"the effective Git configuration cannot be read here\")\n+\t}\n+\t// The test process points GIT_CONFIG_GLOBAL at a file of its own (testgit.Isolate): that is the\n+\t// user's configuration here.\n+\tuserConfig := os.Getenv(\"GIT_CONFIG_GLOBAL\")\n+\tif userConfig == \"\" {\n+\t\tuserConfig = filepath.Join(home, \".gitconfig\")\n+\t}\n+\toriginal, _ := os.ReadFile(userConfig)\n+\tt.Cleanup(func() { _ = os.WriteFile(userConfig, original, 0o644) })\n+\tif err := os.WriteFile(userConfig, append(append([]byte(nil), original...), []byte(\"\\n[log]\\n\\tfollow = true\\n\")...), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t// A new operation reads it again; the same operation keeps the digest it took.\n+\tif same := state.effectiveGitConfig(ctx, NativeFiles(), root); same != before {\n+\t\tt.Fatal(\"the digest changed inside one operation\")\n+\t}\n+\t_, next := (Store{Root: root}).beginGovernanceReadView()\n+\tafter := next.operation.git.effectiveGitConfig(ctx, NativeFiles(), root)\n+\tif after == before {\n+\t\tt.Fatal(\"a change of the user's Git configuration did not change the key\")\n+\t}\n+}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01MJdAbb36frxPrBqiNuxc63","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
