eadFile(userConfig)\n+\tt.Cleanup(func() { _ = os.WriteFile(userConfig, original, 0o644) })\n+\tif err := os.WriteFile(userConfig, append(append([]byte(nil), original...), []byte(\"\\n[log]\\n\\tfollow = true\\n\")...), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t// A new operation reads it again; the same operation keeps the digest it took.\n+\tif same := state.effectiveGitConfig(ctx, NativeFiles(), root); same != before {\n+\t\tt.Fatal(\"the digest changed inside one operation\")\n+\t}\n+\t_, next := (Store{Root: root}).beginGovernanceReadView()\n+\tafter := next.operation.git.effectiveGitConfig(ctx, NativeFiles(), root)\n+\tif after == before {\n+\t\tt.Fatal(\"a change of the user's Git configuration did not change the key\")\n+\t}\n+}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"5e7ad054-b90e-4e29-b460-54d78e01de9e","timestamp":"2026-11-10T23:47:26.723Z","tool_use_result":{"stdout":" ...-shared-domain-and-optional-worktree-runtime.md |    15 +-\n ...commit-gate-refuses-index-without-descriptor.md |     6 +\n .pose/indexes/delivery-integrity.json              | 10759 ++++++++++---------\n .pose/indexes/generation.json                      |    30 +-\n .pose/indexes/releases.json                        |     8 +\n .pose/indexes/roadmaps.json                        |    44 +-\n .pose/indexes/spec-graph.json                      |  1178 +-\n .pose/indexes/validation-matrix.json               |    13 +\n .pose/results/delivery-validation.json             |  1593 +--\n .../6b2bb4a132437035a300c767/000001.json           |    11 +\n .../6b2bb4a132437035a300c767/000001.result.json    |     6 +\n .../6b2bb4a132437035a300c767/000002.json           |    12 +\n .../6b2bb4a132437035a300c767/000002.result.json    |     6 +\n .../6b2bb4a132437035a300c767/000003.json           |    12 +\n .../6b2bb4a132437035a300c767/000003.result.json    |     6 +\n .../823d4dd1514eeb7797192171/000001.json           |    11 +\n .../823d4dd1514eeb