te.label\", run.Label)\n   807\t\t\t}\n   808\t\t\tout.Field(\"delegate.attempt\", run.AttemptID)\n   809\t\t\tif run.Resumes != \"\" {\n   810\t\t\t\tout.Field(\"delegate.resumes\", run.Resumes)\n   811\t\t\t}\n   812\t\t\tif run.HandsOffFrom != \"\" {\n   813\t\t\t\tout.Field(\"delegate.hands_off_from\", run.HandsOffFrom)\n   814\t\t\t}\n   815\t\t\tout.Field(\"delegate.run\", run.RunID)\n   816\t\t\t// R9 outside a terminal: the ways forward of a stopped run.\n   817\t\t\tfor _, action := range next {\n   818\t\t\t\tvalue := action.Command\n   819\t\t\t\tif !action.Available {\n   820\t\t\t\t\tvalue = tr(\"unavailable: \", \"indisponível: \") + action.Why\n   821\t\t\t\t} else if value == \"\" {\n   822\t\t\t\t\tvalue = action.Why\n   823\t\t\t\t}\n   824\t\t\t\tout.Field(\"delegate.next.\"+action.Action, value)\n   825\t\t\t}\n   826\t\t\tout.Field(\"delegate.status\", run.Status)\n   827\t\t\tif run.Failure != \"\" {\n   828\t\t\t\tout.Field(\"delegate.failure\", run.Failure)\n   829\t\t\t}\n   830\t\t\tif run.Interruption != nil {\n   831\t\t\t\tout.Field(\"delegate.interruption\", fmt.Sprintf(\"cause=%s resumable=%t reset_at=%s\", run.Interruption.Cause, run.Interruption.Resumable, run.Interruption.ResetAt))\n   832\t\t\t}\n   833\t\t\tif run.Safety != nil {\n   834\t\t\t\traw, _ := json.Marshal(run.Safety)\n   835\t\t\t\tout.Field(\"delegate.safety\", string(raw))\n   836\t\t\t}\n   837\t\t\tout.Field(\"delegate.record\", run.Path)\n   838\t\t\tout.Field(\"delegate.attestation\", attestation)\n   839\t\t}\n   840\t\tif err != nil {\n   841\t\t\tout.Failure(\"pose delegate \" + command + \": \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   842\t\t}\n   843\t\treturn code\n   844\t}\n   845\t\n   846\tfunc delegateAge(at string) string {\n   847\t\tt, err := time.Parse(time.RFC3339Nano, at)\n   848\t\tif err != nil {\n   849\t\t\treturn \"unknown\"\n   850\t\t}\n   851\t\td := time.Since(t)\n   852\t\tswitch {\n   853\t\tcase d < time.Minute:\n   854\t\t\treturn fmt.Sprintf(\"%ds\", int(d.Seconds()))\n   855\t\tcase d < time.Hour:\n   856\t\t\treturn fmt.Sprintf(\"%dm\", int(d.Minutes()))\n   857\t\tcase d < 48*time.Hour:\n   858\t\t\treturn fmt.Sprintf(\"%dh\", int(d.Hours()))\n   859\t\t}\n   860\t\treturn fmt.Sprintf(\"%dd\", int(d.Hours()/24))\n   861\t}\n   862\t\n   863\tfunc cmdDelegateLs(root string, args []string, stdout, stderr io.Writer) int {\n   864\t\tf, problem := parseDelegateFlags(args, \"--active\")\n   865\t\tif problem == \"\" && len(f.positional) > 1 {\n   866\t\t\tproblem = tr(\"one reference at most\", \"no máximo uma referência\")\n   867\t\t}\n   868\t\tif problem != \"\" {\n   869\t\t\treturn delegateUsage(stdout, stderr, args, \"ls\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate ls [<run>|<bundle-id>] [--active] [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>] [--json]\")\n   870\t\t}\n   871\t\tstore := posemodel.Store{Root: root}\n   872\t\tattempts, lost, err := store.ListDelegationAttempts()\n   873\t\tif err != nil {\n   874\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 1, err)\n   875\t\t}\n   876\t\tif len(f.positional) == 1 && !strings.HasPrefix(f.positional[0], \"rvb-\") {\n   877\t\t\tone, err := posemodel.ResolveDelegationRef(attempts, f.positional[0])\n   878\t\t\tif err != nil {\n   879\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, withDelegationLosses(refError(err), lost))\n   880\t\t\t}\n   881\t\t\t// A named run is refused when a selecting flag does not match it, as on\n   882\t\t\t// every other lifecycle command (D8); without a reference they filter.\n   883\t\t\tif flag := f.mismatch(one); flag != \"\" {\n   884\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, errors.New(tr(\"attempt \"+one.AttemptID+\" does not match \"+flag, \"a tentativa \"+one.AttemptID+\" não corresponde a \"+flag)))\n   885\t\t\t}\n   886\t\t\tattempts = []posemodel.DelegationAttempt{one}\n   887\t\t}\n   888\t\tselected := []posemodel.DelegationAttempt{}\n   889\t\tfor _, a := range attempts {\n   890\t\t\tif len(f.positional) == 1 && strings.HasPrefix(f.positional[0], \"rvb-\") && a.BundleID != f.positional[0] {\n   891\t\t\t\tcontinue\n   892\t\t\t}\n   893\t\t\tif f.active && !a.Active || f.mismatch(a) != \"\" {\n   894\t\t\t\tcontinue\n   895\t\t\t}\n   896\t\t\tselected = append(selected, a)\n   897\t\t}\n   898\t\tif lost == nil {\n   899\t\t\tlost = []string{}\n   900\t\t}\n   901\t\tif f.jsonOut {\n   902\t\t\t// R9: a stopped attempt carries the ways forward it has now.\n   903\t\t\ttype listed struct {\n   904\t\t\t\tposemodel.DelegationAttempt\n   905\t\t\t\tNextActions []delegateNextAction `json:\"next_actions,omitempty\"`\n   906\t\t\t}\n   907\t\t\trows := make([]listed, 0, len(selected))\n   908\t\t\tfor _, a := range selected {\n   909\t\t\t\trows = append(rows, listed{a, delegateNextActions(store, a)})\n   910\t\t\t}\n   120\t\t\t\t}\n   121\t\t\t}\n   122\t\t}\n   123\t\tfor _, key := range order {\n   124\t\t\trow := byAttempt[key]\n   125\t\t\tlatest := row.latest\n   126\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   127\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   128\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   129\t\t\tif latest.Access != \"\" {\n   130\t\t\t\trow.Access = latest.Access\n   131\t\t\t}\n   132\t\t\trow.Round = latest.Round\n   133\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   134\t\t\t\trow.HookFailure = hook.Failure\n   135\t\t\t}\n   136\t\t\tif row.Purpose == \"\" {\n   137\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   138\t\t\t}\n   139\t\t\tif latest.Status == ReviewRunInterrupted {\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n   206\t\tfor _, key := range order {\n   207\t\t\tout = append(out, *byAttempt[key])\n   208\t\t}\n   209\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   210\t\treturn out, lost, nil\n   211\t}\n   212\t\n   213\tfunc delegationStepText(e DelegationEvent) string {\n   214\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   215\t\tif len(text) > 80 {\n   216\t\t\tcut := 77\n   217\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   218\t\t\t\tcut--\n   219\t\t\t}\n   220\t\t\ttext = text[:cut] + \"...\"\n   221\t\t}\n   222\t\tswitch e.Kind {\n   223\t\tcase DelegationEventToolCall:\n   224\t\t\treturn \"▶ \" + text\n   225\t\tcase DelegationEventToolOutput:\n   226\t\t\tif e.ExitCode != nil && *e.ExitCode != 0 {\n   227\t\t\t\treturn fmt.Sprintf(\"✗ exit %d\", *e.ExitCode)\n   228\t\t\t}\n   229\t\t\treturn \"✓ exit 0\"\n   230\t\tcase DelegationEventTurn:\n   231\t\t\treturn \"turn\"\n   232\t\t}\n   233\t\tif text == \"\" {\n   234\t\t\treturn e.Kind\n   235\t\t}\n   236\t\treturn e.Kind + \": \" + text\n   237\t}\n   238\t\n   239\t// ErrDelegationRefAmbiguous carries the candidates of an ambiguous reference.\n   240\t// Neither reference error carries the reference: it may be a session, which\n   241\t// no output names.\n   242\ttype ErrDelegationRefAmbiguous struct {\n   243\t\tCandidates []string\n   244\t}\n   245\t\n   246\tfunc (e *ErrDelegationRefAmbiguous) Error() string {\n   247\t\treturn \"pose: the reference names more than one delegated run: \" + strings.Join(e.Candidates, \", \")\n   248\t}\n   249\t\n   250\t// ErrDelegationRefUnknown means no attempt matches.\n   251\ttype ErrDelegationRefUnknown struct{}\n   252\t\n   253\tfunc (e *ErrDelegationRefUnknown) Error() string {\n   254\t\treturn \"pose: no delegated run matches the reference (a run id, an attempt id, a label or a session prefix of six characters or more)\"\n   255\t}\n   256\t\n   257\t// ResolveDelegationRef finds the one attempt ref names (R11).\n   258\tfunc ResolveDelegationRef(attempts []DelegationAttempt, ref string) (DelegationAttempt, error) {\n   259\t\tref = strings.TrimSpace(ref)\n   260\t\tif ref == \"\" {\n   261\t\t\treturn DelegationAttempt{}, &ErrDelegationRefUnknown{}\n   262\t\t}\n   263\t\t// An identifier is exact and wins over a label or a session prefix.\n   264\t\tfor _, a := range attempts {\n   265\t\t\tif a.AttemptID == ref || containsString(a.Runs, ref) {\n   266\t\t\t\treturn a, nil\n   267\t\t\t}\n   268\t\t}\n   269\t\tvar matched []DelegationAttempt\n   270\t\tfor _, a := range attempts {\n   271\t\t\thit := a.Label == ref\n   272\t\t\tif !hit && len(ref) >= 6 {\n   273\t\t\t\tfor _, session := range a.sessions {\n   274\t\t\t\t\tif strings.HasPrefix(session, ref) {\n   275\t\t\t\t\t\thit = true\n   276\t\t\t\t\t}\n   277\t\t\t\t}\n   278\t\t\t}\n   279\t\t\tif hit {\n   280\t\t\t\tmatched = append(matched, a)\n   281\t\t\t}\n   282\t\t}\n   283\t\tswitch len(matched) {\n   284\t\tcase 0:\n   285\t\t\treturn DelegationAttempt{}, &ErrDelegationRefUnknown{}\n   286\t\tcase 1:\n   287\t\t\treturn matched[0], nil\n   288\t\t}\n   289\t\tcandidates := make([]string, 0, len(matched))\n   290\t\tfor _, a := range matched {\n   291\t\t\tname := a.AttemptID\n   292\t\t\tif a.Label != \"\" {\n   293\t\t\t\tname += \" (\" + a.Label + \", \" + a.State + \")\"\n   294\t\t\t}\n   295\t\t\tcandidates = append(candidates, name)\n   296\t\t}\n   297\t\treturn DelegationAttempt{}, &ErrDelegationRefAmbiguous{Candidates: candidates}\n   298\t}\n   720\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n   721\t\t} else {\n   722\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n   723\t\t\tfresh, err := s.replanContinuation(plan)\n   724\t\t\tif err != nil {\n   725\t\t\t\treturn ReviewRun{}, err\n   726\t\t\t}\n   727\t\t\tif fresh.PendingContinuation != nil {\n   728\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n   729\t\t\t}\n   730\t\t\tif fresh.Existing != nil {\n   731\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   732\t\t\t}\n   733\t\t\tplan = fresh\n   734\t\t\trun.Provenance = fresh.provenance\n   735\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n   736\t\t\tif fresh.handoff {\n   737\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n   738\t\t\t} else {\n   739\t\t\t\trun.Resumes = fresh.predecessor.RunID\n   740\t\t\t}\n   741\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n   742\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n   743\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n   744\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n   745\t\t\t\treturn ReviewRun{}, err\n   746\t\t\t}\n   747\t\t}\n   748\t\t// The attempt result is published once: before the active marker goes\n   749\t\t// when the run was marked, at return otherwise (spec\n   750\t\t// pose-delegation-result-before-marker R1–R2).\n   751\t\tresultPublished := false\n   752\t\treserved := plan.predecessor != nil\n   753\t\tpublishResult := func() {\n   754\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n   755\t\t\t\treturn\n   756\t\t\t}\n   757\t\t\tresultPublished = true\n   758\t\t\tbeforeRunResultPublished(result)\n   759\t\t\tvar err error\n   760\t\t\tif plan.predecessor == nil {\n   761\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   762\t\t\t} else {\n   763\t\t\t\terr = s.finishReviewContinuation(result)\n   764\t\t\t}\n   765\t\t\tif err != nil {\n   766\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n   767\t\t\t}\n   768\t\t}\n   769\t\tdefer publishResult()\n   770\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n   771\t\tif err != nil {\n   772\t\t\tif plan.predecessor == nil {\n   773\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n   774\t\t\t\t// receipt are recorded against it, as before the marker moved\n   775\t\t\t\t// ahead of the reservation (spec\n   776\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n   777\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n   778\t\t\t\t\treturn ReviewRun{}, perr\n   779\t\t\t\t}\n   780\t\t\t\treserved = true\n   781\t\t\t}\n   782\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   783\t\t}\n   784\t\tif plan.predecessor == nil {\n   785\t\t\tbeforeAttemptPublished(s, attempt)\n   786\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n   787\t\t\t\tstopActive()\n   788\t\t\t\treturn ReviewRun{}, err\n   789\t\t\t}\n   790\t\t\treserved = true\n   791\t\t}\n   792\t\t// The marker goes only once the record and the attempt result are\n   793\t\t// published: without them it is the one trace of the reserved attempt,\n   794\t\t// and a waiter that sees it gone must find the receipt.\n   795\t\tdefer func() {\n   796\t\t\tpublishResult()\n   797\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n   798\t\t}()\n   799\t\tcancelled = cancelFlag\n   800\t\t// A detached run that cannot hand its attempt back stops here: nobody\n   801\t\t// would know which attempt runs (R1).\n   802\t\tif plan.OnStart != nil {\n   803\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n   804\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n   805\t\t\t}\n   806\t\t}\n   807\t\ttmp, err := os.MkdirTemp(\"\", \"pose-review-run-*\")\n   808\t\tif err != nil {\n   809\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n   810\t\t}\n   811\t\tsafety.RuntimeID = filepath.Base(tmp)\n   812\t\towned, err := os.Lstat(tmp)\n   813\t\tif err != nil {\n   814\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n   815\t\t}\n   816\t\truntimeRoot, err := os.OpenRoot(tmp)\n   817\t\tif err != nil {\n   818\t\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n   819\t\t}\n   820\t\tdefer runtimeRoot.Close()\n   821\t\tvar worktreeOwned os.FileInfo\n   822\t\tvar gitMarker []byte\n   823\t\tvar ownership *reviewCleanupOwnership\n   824\t\tworktree := filepath.Join(tmp, \"worktree\")\n   825\t\tcleanup = func() error {\n   826\t\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n   827\t\t}\n   828\t\thooks := filepath.Join(tmp, \"empty-hooks\")\n   829\t\tif err := os.Mkdir(hooks, 0700); err != nil {\n   830\t\t\treturn finish(ReviewRunFailed, \"private hook directory setup failed\")\n   831\t\t}\n   832\t\tsetupCtx, stopSetup := context.WithTimeout(parent, 2*time.Minute)\n   833\t\tdefer stopSetup()\n   834\t\tsetup := reviewSetupCommand(setupCtx, gitCommand(\"-C\", s.Root, \"-c\", \"core.hooksPath=\"+hooks, \"worktree\", \"add\", \"--detach\", worktree, plan.SealedCommit))\n   835\t\tsetupOutput := &reviewBoundedCapture{limit: 64 << 10, cancel: stopSetup}\n   836\t\tsetup.Stdout, setup.Stderr = setupOutput, setupOutput\n   837\t\tsetupErr := setup.Run()\n   838\t\t_, setupOverflow := setupOutput.result()\n   839\t\tterminationErr := killProcessGroup(setup)\n   840\t\tif terminationErr != nil {\n   841\t\t\tterminationFailed = true\n   842\t\t}\n   843\t\tsetupCause := executionCause(setupCtx)\n   844\t\tif setupErr != nil || terminationErr != nil || setupOverflow {\n   845\t\t\tsafety.ExecutionCause = setupCause\n   846\t\t\tif setupOverflow {\n   847\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   848\t\t\t}\n   849\t\t\treturn finish(ReviewRunFailed, \"review worktree setup failed or termination incomplete\")\n   850\t\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/delegate.go | sed -n '910,970p'; nl -ba pose-mcp/internal/cli/delegate.go | sed -n '1110,1235p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '400,475p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '520,575p'; rg -n \\\"func \\\\(s Store\\\\) ListDelegationActive|func \\\\(s Store\\\\) StopDelegation|Owner\\\" pose-mcp/internal/pose\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/delegate.go | sed -n '910,970p'; nl -ba pose-mcp/internal/cli/delegate.go | sed -n '1110,1235p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '400,475p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '520,575p'; rg -n \\\"func \\\\(s Store\\\\) ListDelegationActive|func \\\\(s Store\\\\) StopDelegation|Owner\\\" pose-mcp/internal/pose\"","aggregated_output":"   910\t\t\t}\n   911\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateListSchema, \"attempts\": rows, \"losses\": lost})\n   912\t\t} else {\n   913\t\t\tout := render(stdout, stderr)\n   914\t\t\tif len(selected) == 0 {\n   915\t\t\t\tout.Field(\"delegate.runs\", tr(\"none\", \"nenhum\"))\n   916\t\t\t}\n   917\t\t\tfor _, a := range selected {\n   918\t\t\t\tvalue := fmt.Sprintf(\"state=%s purpose=%s agent=%s turns=%d age=%s\", a.State, a.Purpose, a.Agent, a.Turns, delegateAge(a.StartedAt))\n   919\t\t\t\tif a.Round > 0 {\n   920\t\t\t\t\tvalue += fmt.Sprintf(\" round=%d\", a.Round)\n   921\t\t\t\t}\n   922\t\t\t\tif a.Label != \"\" {\n   923\t\t\t\t\tvalue += \" label=\" + a.Label\n   924\t\t\t\t}\n   925\t\t\t\tif a.Active && a.Liveness != \"\" {\n   926\t\t\t\t\tvalue += \" owner=\" + a.Liveness\n   927\t\t\t\t}\n   928\t\t\t\tif a.HeartbeatAge != \"\" {\n   929\t\t\t\t\tvalue += \" heartbeat=\" + a.HeartbeatAge\n   930\t\t\t\t}\n   931\t\t\t\tif a.StalledAt != \"\" {\n   932\t\t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n   933\t\t\t\t}\n   934\t\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n   935\t\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n   936\t\t\t\t}\n   937\t\t\t\tif a.HookFailure != \"\" {\n   938\t\t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n   939\t\t\t\t}\n   940\t\t\t\tif a.Interruption != nil {\n   941\t\t\t\t\tvalue += fmt.Sprintf(\" cause=%s resumable=%t partial=%t\", a.Interruption.Cause, a.Interruption.Resumable, a.Partial)\n   942\t\t\t\t\tif a.Interruption.ResetAt != \"\" {\n   943\t\t\t\t\t\tvalue += \" reset_at=\" + a.Interruption.ResetAt + \" time_left=\" + a.TimeLeft\n   944\t\t\t\t\t}\n   945\t\t\t\t}\n   946\t\t\t\tif a.LatestRun != \"\" {\n   947\t\t\t\t\tvalue += \" run=\" + a.LatestRun\n   948\t\t\t\t}\n   949\t\t\t\tif a.LastStep != \"\" {\n   950\t\t\t\t\tvalue += \" last=\" + a.LastStep\n   951\t\t\t\t}\n   952\t\t\t\tout.Field(\"delegate.\"+a.AttemptID, value)\n   953\t\t\t}\n   954\t\t\tfor _, loss := range lost {\n   955\t\t\t\tout.Failure(tr(\"delegated run history incomplete: \", \"histórico de runs delegados incompleto: \") + loss)\n   956\t\t\t}\n   957\t\t}\n   958\t\tif len(lost) > 0 {\n   959\t\t\treturn 1\n   960\t\t}\n   961\t\treturn 0\n   962\t}\n   963\t\n   964\t// resumeTarget is the run a resume continues (R11 with the delivered\n   965\t// continuity): the run named by its id, or the attempt's latest run when it\n   966\t// is interrupted, or the interrupted run the latest one continued, whose\n   967\t// recorded continuation is then returned instead of a new run.\n   968\tfunc resumeTarget(attempt posemodel.DelegationAttempt, ref string) (string, error) {\n   969\t\tif containsString(attempt.Runs, ref) {\n   970\t\t\treturn ref, nil\n  1110\t}\n  1111\t\n  1112\tfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n  1113\t\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n  1114\t\tif problem != \"\" {\n  1115\t\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n  1116\t\t}\n  1117\t\tstore := posemodel.Store{Root: root}\n  1118\t\tattempts, lost, err := store.ListDelegationAttempts()\n  1119\t\tif err != nil {\n  1120\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1121\t\t}\n  1122\t\tattempt, code, err := namedAttempt(attempts, f)\n  1123\t\tif err != nil {\n  1124\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n  1125\t\t}\n  1126\t\tif !attempt.Active && !f.dryRun {\n  1127\t\t\t// An attempt whose dispatch, or whose earlier release, ended before\n  1128\t\t\t// its receipt is released with a failed run and its receipt, so it\n  1129\t\t\t// stops blocking the bundle; the release proves the abandonment\n  1130\t\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n  1131\t\t\t// review round 4, N1).\n  1132\t\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n  1133\t\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n  1134\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1135\t\t\t}\n  1136\t\t\tif err != nil {\n  1137\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1138\t\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1139\t\t\t}\n  1140\t\t\tif f.jsonOut {\n  1141\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n  1142\t\t\t\treturn 0\n  1143\t\t\t}\n  1144\t\t\tout := render(stdout, stderr)\n  1145\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1146\t\t\tswitch {\n  1147\t\t\tcase run.RunID == \"\":\n  1148\t\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n  1149\t\t\tcase run.Status == posemodel.ReviewRunFailed && strings.HasPrefix(run.