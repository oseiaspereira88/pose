eck unavailable, never the\n  1013\t\t// review.\n  1014\t\tif plan.Purpose == DelegationPurposeReview {\n  1015\t\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n  1016\t\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n  1017\t\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n  1018\t\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n  1019\t\t\t\t\t// engine that dispatched the run is the one that checks it.\n  1020\t\t\t\t\tif self, err := os.Executable(); err == nil {\n  1021\t\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n  1022\t\t\t\t\t}\n  1023\t\t\t\t}\n  1024\t\t\t}\n  1025\t\t}\n  1026\t\tcmd.Env = env\n  1027\t\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n  1028\t\tcmd.Stdout, cmd.Stderr = combined, combined\n  1029\t\t// pose delegate watch follows the normalized, redacted events as they come\n  1030\t\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n  1031\t\t// the record is published.\n  1032\t\tsessionPattern := \"\"\n  1033\t\tif plan.Config.Session != nil {\n  1034\t\t\tsessionPattern = plan.Config.Session.Pattern\n  1035\t\t}\n  1036\t\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n  1037\t\t\ttee := io.MultiWriter(combined, live)\n  1038\t\t\tcmd.Stdout, cmd.Stderr = tee, tee\n  1039\t\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n  1040\t\t\tdefer live.Close()\n  1041\t\t}\n  1042\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n  1043\t\t// only the parent left a child holding stdout, so the timeout never fired\n  1044\t\t// (found in review). The run gets its own process group, the whole group\n  1045\t\t// is killed on timeout and after the run, and pipes are released at most\n  1046\t\t// a few seconds after the kill.\n  1047\t\topaqueBaseline := reviewOpaqueProcessBaseline()\n  1048\t\t// Orphans of the run are reparented to this process, so one that left\n  1049\t\t// the group and cleared its environment is still found (review round 6, N2).\n  1050\t\tisolateProcessGroup(cmd)\n  1051\t\tcmd.WaitDelay = AdapterPipeGrace\n  1052\t\tvar shimReport []byte\n  1053\t\tshimReportDone := make(chan struct{})\n  1054\t\tif useShim {\n  1055\t\t\t// A timeout asks the shim to end the run's subtree first; the group\n  1056\t\t\t// kill after Wait remains the backstop (review round 8, N3).\n  1057\t\t\tcmd.Cancel = stopReviewShim(cmd)\n  1058\t\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n  1059\t\t\tgo func() {\n  1060\t\t\t\tdefer close(shimReportDone)\n  1061\t\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n  1062\t\t\t\t// Whatever exceeds the bound is drained, so the shim never blocks.\n  1063\t\t\t\t_, _ = io.Copy(io.Discard, shimRead)\n  1064\t\t\t}()\n  1065\t\t} else {\n  1066\t\t\tclose(shimReportDone)\n  1067\t\t}\n  1068\t\tvar runErr error\n  1069\t\tif run.Provenance == nil {\n  1070\t\t\trunErr = cmd.Run()\n  1071\t\t} else {\n  1072\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1073\t\t\trunErr = err\n  1074\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1075\t\t\tif started {\n  1076\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1077\t\t\t}\n  1078\t\t}\n  1079\t\tif useShim && safety != nil {\n  1080\t\t\t// With the shim the run's leftovers are its subtree, not an\n  1081\t\t\t// environment match (review round 9, N1).\n  1082\t\t\tfor i, limit := range safety.Limitations {\n  1083\t\t\t\tif strings.HasPrefix(limit, \"no memory/CPU quota;\") {\n  1084\t\t\t\t\tsafety.Limitations[i] = \"no memory/CPU quota; the review run shim ends every process left in the run's subtree, including one in its own session\"\n  1085\t\t\t\t}\n  1086\t\t\t}\n  1087\t\t}\n  1088\t\tif useShim {\n  1089\t\t\t_ = shimWrite.Close()\n  1090\t\t\t<-shimReportDone\n  1091\t\t\t_ = shimRead.Close()\n  1092\t\t}\n  1093\t\tterminationErr = killProcessGroup(cmd)\n  1094\t\t// A command the reviewer left running in a session of its own escapes the\n  1095\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1096\t\t// directories it may still write (spec\n  1097\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1098\t\t// The environment entry is the reviewer's to set, so it is searched only\n  1099\t\t// without the shim, whose subtree is the run's by construction (review\n  1100\t\t// round 8, N1).\n  1101\t\tvar reaped []string\n  1102\t\tshimMore := 0\n  1103\t\tvar opaque int\n  1104\t\tvar reapErr error\n  1105\t\tif !useShim {\n  1106\t\t\treaped, opaque, reapErr = reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n  1107\t\t\tif reapErr != nil {\n  1108\t\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1109\t\t\t}\n  1110\t\t}\n  1111\t\tif useShim && cmd.ProcessState != nil {\n  1112\t\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n  1113\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1114\t\t\t} else {\n  1115\t\t\t\tfor _, pid := range report.Ended {\n  1116\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1117\t\t\t\t}\n  1118\t\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n  1119\t\t\t\t\t// Counted from the total, not from the listed pids (review\n  1120\t\t\t\t\t// round 12, N3).\n  1121\t\t\t\t\tshimMore = more\n  1122\t\t\t\t}\n  1123\t\t\t\tif report.Error != \"\" {\n  1124\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1125\t\t\t\t\t// The shim's own words go into the record, not only the\n  1126\t\t\t\t\t// generic failure (review round 10, N3).\n  1127\t\t\t\t\tif safety != nil {\n  1128\t\t\t\t\t\tsafety.Limitations = append(safety.Limitations, \"the review run shim could not end the whole subtree: \"+report.Error)\n  1129\t\t\t\t\t}\n  1130\t\t\t\t}\n  1131\t\t\t}\n  1132\t\t}\n  1133\t\tif endedCount := len(reaped) + shimMore; endedCount > 0 && safety != nil {\n  1134\t\t\tlisted := strings.Join(reaped, \", \")\n  1135\t\t\tif shimMore > 0 {\n  1136\t\t\t\tlisted += fmt.Sprintf(\" and %d more (orphaned)\", shimMore)\n  1137\t\t\t}\n  1138\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(endedCount)+\" process(es) the run left running: \"+listed)\n  1139\t\t}\n  1140\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1141\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1142\t\t}\n  1143\t\tterminationFailed = terminationErr != nil\n  1144\t\t// The adapter exited and a child it left still held the output when\n  1145\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1146\t\t// the exit status decides (found in review).\n  1147\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1148\t\t\trunErr = nil\n  1149\t\t}\n  1150\t\ttranscript, overflow := combined.result()\n  1151\t\tsafety.CaptureComplete = !overflow\n  1152\t\tif cmd.ProcessState != nil {\n  1153\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1154\t\t}\n  1155\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n  1156\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n  1157\t\t\tsafety.CaptureComplete = false\n  1158\t\t}\n  1159\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1160\t\t\trun.Output = string(raw)\n  1161\t\t\tif run.Provenance != nil {\n  1162\t\t\t\trun.Provenance.OutputComplete = true\n  1163\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1164\t\t\t}\n  1165\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1166\t\t\t// The agent writes no output file; its stream names its final message.\n  1167\t\t\trun.Output = final\n  1168\t\t\tif run.Provenance != nil {\n  1169\t\t\t\trun.Provenance.OutputComplete = true\n  1170\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1171\t\t\t}\n  1172\t\t} else {\n  1173\t\t\trun.Output = tail(string(transcript), 20000)\n  1174\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1175\t\t\t\tsafety.CaptureComplete = false\n  1176\t\t\t}\n  1177\t\t\tif run.Provenance != nil {\n  1178\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1179\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1180\t\t\t}\n  1181\t\t}\n  1182\t\tif run.Provenance != nil {\n  1183\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n  1184\t\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n  1185\t\t}\n  1186\t\tif runErr != nil && cmd.ProcessState == nil {\n  1187\t\t\trun.Output, transcript = \"\", nil\n  1188\t\t\tif run.Provenance != nil {\n  1189\t\t\t\trun.Provenance.OutputComplete = false\n  1190\t\t\t}\n  1191\t\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n  1192\t\t}\n  1193\t\t// Raw provenance hashes above precede redaction; only complete, bounded\n  1194\t\t// redacted channels can be retained. Partial boundaries can expose a secret.\n  1195\t\tsafety.ExecutionCause = executionCause(ctx)\n  1196\t\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n  1197\t\t\tsafety.CaptureComplete = false\n  1198\t\t}\n  1199\t\tif !safety.CaptureComplete {\n  1200\t\t\ttranscript = nil\n  1201\t\t\trun.Output = \"\"\n  1202\t\t\tif run.Provenance != nil {\n  1203\t\t\t\trun.Provenance.OutputComplete = false\n  1204\t\t\t}\n  1205\t\t\tif terminationErr != nil {\n  1206\t\t\t\treturn finish(ReviewRunFailed, \"process group termination failed; descendants may remain\")\n  1207\t\t\t}\n  1208\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1209\t\t\treturn finish(ReviewRunFailed, \"adapter capture incomplete: stream/output limit or unsafe output file\")\n  1210\t\t}\n  1211\t\tcaptureStage := \"session/interrupt recognition\"\n  1212\t\tstatus, failure, captureErr := s.classifyReviewInterruption(&run, plan, transcript, runErr, ctx.Err())\n  1213\t\tif captureErr == nil {\n  1214\t\t\tvar redactErr error\n  1215\t\t\traw := transcript\n  1216\t\t\tcaptureStage = \"stdout\"\n  1217\t\t\ttranscript, redactErr = redactReviewCapture(transcript, secrets, run.sessionForRedaction, safety.StreamBytes)\n  1218\t\t\tvar output []byte\n  1219\t\t\tif redactErr == nil {\n  1220\t\t\t\tcaptureStage = \"final output\"\n  1221\t\t\t\toutput, redactErr = redactReviewCapture([]byte(run.Output), secrets, run.sessionForRedaction, safety.OutputBytes)\n  1222\t\t\t}\n  1223\t\t\trun.Output = string(output)\n  1224\t\t\tif redactErr == nil && run.Events != \"\" {\n  1225\t\t\t\tcaptureStage = \"normalized events\"\n   105\t\t}\n   106\t\tif len(a.Command) == 0 || strings.TrimSpace(a.Command[0]) == \"\" || strings.TrimSpace(a.Command[0]) != a.Command[0] {\n   107\t\t\treturn nil, fmt.Errorf(\"adapter argv requires a nonempty executable\")\n   108\t\t}\n   109\t\tfor _, arg := range a.Command {\n   110\t\t\tif strings.ContainsRune(arg, 0) {\n   111\t\t\t\treturn nil, fmt.Errorf(\"adapter argv contains NUL\")\n   112\t\t\t}\n   113\t\t}\n   114\t\tif a.Executor != \"\" && (strings.TrimSpace(a.Executor) != a.Executor || !strings.HasPrefix(a.Executor, \"agent:\") || strings.TrimSpace(strings.TrimPrefix(a.Executor, \"agent:\")) == \"\") {\n   115\t\t\treturn nil, fmt.Errorf(\"adapter executor identity is invalid\")\n   116\t\t}\n   117\t\tif a.MaxRunsPerBundle < 0 || a.MaxRunsPerBundle > 100 {\n   118\t\t\treturn nil, fmt.Errorf(\"max_runs_per_bundle must be 1..100 when present (omitted defaults to 3)\")\n   119\t\t}\n   120\t\ttimeout := time.Hour\n   121\t\tif a.Timeout != \"\" {\n   122\t\t\tvar err error\n   123\t\t\ttimeout, err = time.ParseDuration(a.Timeout)\n   124\t\t\tif err != nil || timeout < time.Millisecond || timeout > 24*time.Hour || strings.TrimSpace(a.Timeout) != a.Timeout {\n   125\t\t\t\treturn nil, fmt.Errorf(\"adapter timeout must be a positive duration up to 24h\")\n   126\t\t\t}\n   127\t\t}\n   128\t\tr := &ReviewExecutionSafety{SchemaVersion: 1, Profile: \"legacy-trusted\", Platform: runtime.GOOS + \"/\" + runtime.GOARCH, StreamBytes: 8 << 20, OutputBytes: 64 << 10, RetainedBytes: 16 << 20, TimeoutMS: timeout.Milliseconds(), MaxRuns: effectiveReviewMaxRuns(a), Retention: \"retain-evidence; ttl=0; no automatic deletion\", Capabilities: map[string]string{\n   129\t\t\t\"bounded-capture\": \"available\", \"environment-allowlist\": \"available\", \"parent-termination\": \"available\", \"process-group-termination\": \"unsupported\", \"filesystem-isolation\": \"unavailable\", \"origin-isolation\": \"unavailable\", \"shared-git-isolation\": \"unavailable\", \"network-isolation\": \"unavailable\", \"credential-filesystem-isolation\": \"unavailable\", \"escaped-descendant-termination\": \"unavailable\", \"memory-limit\": \"unavailable\", \"cpu-limit\": \"unavailable\", \"automatic-expiry\": \"unavailable\",\n   130\t\t}, Limitations: []string{\"trusted local executable required; worktree is not a sandbox\", \"outside writes, transient writes, shared Git and credential files are not isolated\", \"no memory/CPU quota or control of descendants escaping the process group\", \"cleanup filesystem calls remain subject to operating-system I/O latency\"}}\n   131\t\tif runtime.GOOS == \"linux\" {\n   132\t\t\tif err := reviewProcessGroupAvailable(); err == nil {\n   133\t\t\t\tr.Capabilities[\"process-group-termination\"] = \"available\"\n   134\t\t\t\t// A descendant that left the group is still ended while its\n   135\t\t\t\t// environment keeps the run's sealed-checkout entry; one that\n   136\t\t\t\t// clears it is not, so the guarantee is not \"available\" (spec\n   137\t\t\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, L1).\n   138\t\t\t\tr.Capabilities[\"escaped-descendant-termination\"] = \"environment-marked\"\n   139\t\t\t\tfor i, limit := range r.Limitations {\n   140\t\t\t\t\tif limit == \"no memory/CPU quota or control of descendants escaping the process group\" {\n   141\t\t\t\t\t\tr.Limitations[i] = \"no memory/CPU quota; descendants escaping the process group are ended only while they keep the run's sealed-checkout environment entry\"\n   142\t\t\t\t\t}\n   143\t\t\t\t}\n   144\t\t\t} else {\n   145\t\t\t\tr.Capabilities[\"process-group-termination\"] = \"unavailable\"\n   146\t\t\t\tr.Limitations = append(r.Limitations, \"process inventory not observable on this host\")\n   147\t\t\t}\n   148\t\t} else {\n   149\t\t\tr.Limitations = append(r.Limitations, \"process-group termination not qualified on this platform\")\n   150\t\t\tif runtime.GOOS == \"windows\" {\n   151\t\t\t\t// On Windows the dispatch does not end the adapter's descendants\n   152\t\t\t\t// at all (review round 12, N1).\n   153\t\t\t\tr.Limitations = append(r.Limitations, \"the adapter's descendants are not ended on Windows: a process the reviewer leaves running survives the run\")\n   154\t\t\t}\n   155\t\t}\n   156\t\tp := a.Containment\n   157\t\tif p == nil {\n   158\t\t\tr.Limitations = append(r.Limitations, \"legacy compatibility: HOME retained; other ambient credentials excluded\")\n   159\t\t\treturn r, nil\n   160\t\t}\n   161\t\tif p.SchemaVersion != 1 || p.Profile != \"trusted-process\" {\n   162\t\t\treturn nil, fmt.Errorf(\"unsupported containment schema/profile; use schema_version 1 and trusted-process\")\n   163\t\t}\n   164\t\tr.Profile = p.Profile\n   165\t\tfor _, limit := range []struct {\n   166\t\t\tname   string\n   167\t\t\tvalue  *int64\n   168\t\t\ttarget *int64\n   169\t\t\tmax    int64\n   170\t\t}{{\"stream_bytes\", p.StreamBytes, &r.StreamBytes, 64 << 20}, {\"output_bytes\", p.OutputBytes, &r.OutputBytes, 128 << 10}, {\"retained_bytes\", p.RetainedBytes, &r.RetainedBytes, 128 << 20}} {\n   171\t\t\tif limit.value != nil {\n   172\t\t\t\tif *limit.value <= 0 || *limit.value > limit.max {\n   173\t\t\t\t\treturn nil, fmt.Errorf(\"%s must be 1..%d bytes\", limit.name, limit.max)\n   174\t\t\t\t}\n   175\t\t\t\t*limit.target = *limit.value\npose-mcp/internal/pose/delegation_release.go:191:\tdirs, dirsTruncated, err := readDirBounded(base, reviewOrphanScanMaxEntries)\npose-mcp/internal/pose/delegation_release.go:230:\t\tentries, truncated, err := readDirBounded(filepath.Join(base, d.Name()), reviewOrphanScanMaxEntries)\npose-mcp/internal/pose/delegation_release.go:278:func readDirBounded(dir string, max int) ([]os.DirEntry, bool, error) {\npose-mcp/internal/pose/delegation_release_test.go:496:\tentries, truncated, err := readDirBounded(dir, 10)\npose-mcp/internal/pose/delegation_release_test.go:500:\tentries, truncated, err = readDirBounded(dir, 20)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '1,360p'; nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '1,260p'; nl -ba pose-mcp/internal/cli/delegate.go | sed -n '1,340p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '1,300p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '1,360p'; nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '1,260p'; nl -ba pose-mcp/internal/cli/delegate.go | sed -n '1,340p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '1,300p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"io\"\n    28\t\t\"os\"\n    29\t\t\"path/filepath\"\n    30\t\t\"strings\"\n    31\t\t\"time\"\n    32\t)\n    33\t\n    34\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    35\t// proven abandoned.\n    36\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    37\t\n    38\t// reviewOrphanReservationAge is how old a reservation without any marker\n    39\t// must be to count as abandoned.\n    40\tconst reviewOrphanReservationAge = 10 * time.Minute\n    41\t\n    42\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    43\t// dispatch ended before recording it, and removes its stalled marker. A\n    44\t// stalled marker whose reservation was never published is only removed; the\n    45\t// returned run is then empty.\n    46\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    47\t\tif !validAttemptFileName(attemptID) {\n    48\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    49\t\t}\n    50\t\tmarkers, _, err := s.ListDelegationActive()\n    51\t\tif err != nil {\n    52\t\t\treturn ReviewRun{}, err\n    53\t\t}\n    54\t\tvar marker *DelegationActiveRun\n    55\t\tfor i := range markers {\n    56\t\t\tif markers[i].AttemptID == attemptID {\n    57\t\t\t\tmarker = &markers[i]\n    58\t\t\t}\n    59\t\t}\n    60\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    61\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    62\t\t}\n    63\t\tdir, err := s.delegationActiveDir(true)\n    64\t\tif err != nil {\n    65\t\t\treturn ReviewRun{}, err\n    66\t\t}\n    67\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    68\t\tif err != nil {\n    69\t\t\treturn ReviewRun{}, err\n    70\t\t}\n    71\t\tdefer lock.Close()\n    72\t\tunlock, err := lockSpecTransferFile(lock)\n    73\t\tif err != nil {\n    74\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    75\t\t}\n    76\t\tdefer unlock()\n    77\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    78\t}\n    79\t\n    80\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    81\t\tvar reserved *DelegatedReviewAttempt\n    82\t\tif marker != nil {\n    83\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    84\t\t\tif err != nil {\n    85\t\t\t\treturn ReviewRun{}, err\n    86\t\t\t}\n    87\t\t\tfor i := range attempts {\n    88\t\t\t\tif attempts[i].AttemptID == attemptID {\n    89\t\t\t\t\treserved = &attempts[i]\n    90\t\t\t\t}\n    91\t\t\t}\n    92\t\t\tif reserved == nil {\n    93\t\t\t\t// The dispatch ended between its marker and its reservation:\n    94\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    95\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    96\t\t\t}\n    97\t\t} else {\n    98\t\t\tif !operatorConfirmed {\n    99\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n   100\t\t\t}\n   101\t\t\torphans, _, err := s.orphanReservations(now)\n   102\t\t\tif err != nil {\n   103\t\t\t\treturn ReviewRun{}, err\n   104\t\t\t}\n   105\t\t\tfor i := range orphans {\n   106\t\t\t\tif orphans[i].AttemptID == attemptID {\n   107\t\t\t\t\treserved = &orphans[i]\n   108\t\t\t\t}\n   109\t\t\t}\n   110\t\t\tif reserved == nil {\n   111\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   112\t\t\t}\n   113\t\t}\n   114\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   115\t\t\t// A release that stopped after the receipt completes by removing\n   116\t\t\t// the stalled marker; with no marker there is nothing to release.\n   117\t\t\tif marker != nil {\n   118\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   119\t\t\t\tif err != nil {\n   120\t\t\t\t\treturn ReviewRun{}, err\n   121\t\t\t\t}\n   122\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   123\t\t\t\tif err != nil {\n   124\t\t\t\t\treturn ReviewRun{}, err\n   125\t\t\t\t}\n   126\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   127\t\t\t}\n   128\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   129\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   130\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   131\t\t}\n   132\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   133\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   134\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   135\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   136\t\tif marker != nil {\n   137\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   138\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   139\t\t} else {\n   140\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   141\t\t}\n   142\t\t// A run the attempt already recorded, by its dispatch or by a release\n   143\t\t// interrupted before the receipt, completes the attempt; no second run\n   144\t\t// is written for it.\n   145\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   146\t\tif err != nil {\n   147\t\t\treturn ReviewRun{}, err\n   148\t\t}\n   149\t\tif !found {\n   150\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   151\t\t\t\treturn ReviewRun{}, err\n   152\t\t\t}\n   153\t\t}\n   154\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   155\t\t\treturn recorded, err\n   156\t\t}\n   157\t\tif marker != nil {\n   158\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   159\t\t}\n   160\t\treturn recorded, nil\n   161\t}\n   162\t\n   163\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   164\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   165\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   166\t\tif err != nil {\n   167\t\t\treturn ReviewRun{}, false, err\n   168\t\t}\n   169\t\tif len(lost) > 0 {\n   170\t\t\t// An unreadable run may be this release's: the history is unknown,\n   171\t\t\t// and the release does not write another (review round 4, N3).\n   172\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   173\t\t}\n   174\t\tvar latest *ReviewRun\n   175\t\tfor i := range runs {\n   176\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   177\t\t\t\tlatest = &runs[i]\n   178\t\t\t}\n   179\t\t}\n   180\t\tif latest == nil {\n   181\t\t\treturn ReviewRun{}, false, nil\n   182\t\t}\n   183\t\treturn *latest, true, nil\n   184\t}\n   185\t\n   186\t// orphanReservations lists the reservations left without a receipt or a\n   187\t// marker, older than reviewOrphanReservationAge, and\n   188\t// says which reservations or receipts it could not read (review round 3, N3).\n   189\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   190\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   191\t\tdirs, dirsTruncated, err := readDirBounded(base, reviewOrphanScanMaxEntries)\n   192\t\tif errors.Is(err, os.ErrNotExist) {\n   193\t\t\treturn nil, nil, nil\n   194\t\t}\n   195\t\tif err != nil {\n   196\t\t\treturn nil, nil, err\n   197\t\t}\n   198\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   199\t\tif err != nil {\n   200\t\t\treturn nil, nil, err\n   201\t\t}\n   202\t\tif len(markerLost) > 0 {\n   203\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   204\t\t\t// have no marker (review round 6, N1).\n   205\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   206\t\t}\n   207\t\tmarked := map[string]bool{}\n   208\t\tfor _, m := range markers {\n   209\t\t\tmarked[m.AttemptID] = true\n   210\t\t}\n   211\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   212\t\tif err != nil {\n   213\t\t\treturn nil, nil, err\n   214\t\t}\n   215\t\tif len(runLost) > 0 {\n   216\t\t\t// Without the whole run history nothing is known to have no run.\n   217\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   218\t\t}\n   219\t\t// A recorded run does not finish an attempt, its receipt does: a\n   220\t\t// reservation whose run was recorded without a receipt still blocks and\n   221\t\t// is released with that run (review round 5, N3).\n   222\t\t_ = runs\n   223\t\tvar out []DelegatedReviewAttempt\n   224\t\tvar lost []string\n   225\t\tbudget := reviewReadBudget(nil)\n   226\t\tfor _, d := range dirs {\n   227\t\t\tif !d.IsDir() {\n   228\t\t\t\tcontinue\n   229\t\t\t}\n   230\t\t\tentries, truncated, err := readDirBounded(filepath.Join(base, d.Name()), reviewOrphanScanMaxEntries)\n   231\t\t\tif err != nil {\n   232\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   233\t\t\t\tcontinue\n   234\t\t\t}\n   235\t\t\tif truncated {\n   236\t\t\t\tlost = append(lost, fmt.Sprintf(\"the reservations in %s exceed %d entries; the rest were not read\", d.Name(), reviewOrphanScanMaxEntries))\n   237\t\t\t}\n   238\t\t\tfor _, e := range entries {\n   239\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   240\t\t\t\t\tcontinue\n   241\t\t\t\t}\n   242\t\t\t\tvar a DelegatedReviewAttempt\n   243\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   248\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   249\t\t\t\t\tcontinue\n   250\t\t\t\t}\n   251\t\t\t\tif marked[a.AttemptID] {\n   252\t\t\t\t\tcontinue\n   253\t\t\t\t}\n   254\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   255\t\t\t\t\tcontinue\n   256\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   257\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   258\t\t\t\t\tcontinue\n   259\t\t\t\t}\n   260\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   261\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   262\t\t\t\t\tcontinue\n   263\t\t\t\t}\n   264\t\t\t\tout = append(out, a)\n   265\t\t\t}\n   266\t\t}\n   267\t\tif dirsTruncated {\n   268\t\t\tlost = append(lost, fmt.Sprintf(\"the attempt directories exceed %d entries; the rest were not read\", reviewOrphanScanMaxEntries))\n   269\t\t}\n   270\t\treturn out, lost, nil\n   271\t}\n   272\t\n   273\t// reviewOrphanScanMaxEntries bounds each directory the orphan scan lists\n   274\t// (review round 10, N2).\n   275\tconst reviewOrphanScanMaxEntries = 10000\n   276\t\n   277\t// readDirBounded lists at most max entries of dir and says whether more exist.\n   278\tfunc readDirBounded(dir string, max int) ([]os.DirEntry, bool, error) {\n   279\t\tf, err := os.Open(dir)\n   280\t\tif err != nil {\n   281\t\t\treturn nil, false, err\n   282\t\t}\n   283\t\tdefer f.Close()\n   284\t\tentries, err := f.ReadDir(max + 1)\n   285\t\tif err != nil && !errors.Is(err, io.EOF) {\n   286\t\t\treturn nil, false, err\n   287\t\t}\n   288\t\tif len(entries) > max {\n   289\t\t\treturn entries[:max], true, nil\n   290\t\t}\n   291\t\treturn entries, false, nil\n   292\t}\n   293\t\n   294\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   295\t\tdir, err := s.delegationActiveDir(false)\n   296\t\tif err != nil {\n   297\t\t\treturn err\n   298\t\t}\n   299\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   300\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   301\t\t\t\treturn err\n   302\t\t\t}\n   303\t\t}\n   304\t\treturn nil\n   305\t}\n     1\tpackage pose\n     2\t\n     3\t// Listing and naming delegated runs (spec pose-delegation-surface R11, and the\n     4\t// listing pose-delegated-review-completion-signal extends).\n     5\t//\n     6\t// A person and an agent follow a task, not a process: an attempt and its\n     7\t// continuations are one row, shown by their latest run. A reference names a\n     8\t// row by attempt, by any of its runs, by label or by a prefix of its session.\n     9\t\n    10\timport (\n    11\t\t\"fmt\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t)\n    16\t\n    17\t// DelegationAttempt is one attempt and its continuations.\n    18\ttype DelegationAttempt struct {\n    19\t\tAttemptID    string              `json:\"attempt_id\"`\n    20\t\tRuns         []string            `json:\"runs\"`\n    21\t\tLatestRun    string              `json:\"latest_run,omitempty\"`\n    22\t\tState        string              `json:\"state\"`\n    23\t\tPurpose      string              `json:\"purpose\"`\n    24\t\tAgent        string              `json:\"agent\"`\n    25\t\tVendor       string              `json:\"vendor,omitempty\"`\n    26\t\tModel        string              `json:\"model,omitempty\"`\n    27\t\tLabel        string              `json:\"label,omitempty\"`\n    28\t\tLead         string              `json:\"lead,omitempty\"`\n    29\t\tAccess       string              `json:\"access\"`\n    30\t\tScope        string              `json:\"scope\"`\n    31\t\tBundleID     string              `json:\"bundle_id\"`\n    32\t\tStartedAt    string              `json:\"started_at\"`\n    33\t\tEndedAt      string              `json:\"ended_at,omitempty\"`\n    34\t\tTurns        int                 `json:\"turns\"`\n    35\t\tLastStep     string              `json:\"last_step,omitempty\"`\n    36\t\tFailure      string              `json:\"failure,omitempty\"`\n    37\t\tInterruption *ReviewInterruption `json:\"interruption,omitempty\"`\n    38\t\t// Partial says an interrupted run kept a partial draft; TimeLeft is the\n    39\t\t// wait until its recorded reset, when there is one.\n    40\t\tPartial         bool   `json:\"partial,omitempty\"`\n    41\t\tTimeLeft        string `json:\"time_left,omitempty\"`\n    42\t\tActive          bool   `json:\"active\"`\n    43\t\tLiveness        string `json:\"liveness,omitempty\"`\n    44\t\tCancelRequested bool   `json:\"cancel_requested,omitempty\"`\n    45\t\t// HeartbeatAge is how long ago the running process last beat; a stalled\n    46\t\t// run is not active (spec pose-delegated-review-completion-signal R4, R6).\n    47\t\tHeartbeatAge string `json:\"heartbeat_age,omitempty\"`\n    48\t\tStalledAt    string `json:\"stalled_at,omitempty\"`\n    49\t\t// HookFailure is why the latest run's on_terminal hook failed (R7).\n    50\t\tHookFailure string `json:\"hook_failure,omitempty\"`\n    51\t\t// Round is the review round of the scope the latest run reviewed (spec\n    52\t\t// pose-delegated-review-round-protocol R1).\n    53\t\tRound    int `json:\"round,omitempty\"`\n    54\t\tsessions []string\n    55\t\tlatest   *ReviewRun\n    56\t}\n    57\t\n    58\t// Latest is the latest recorded run of the attempt, if any.\n    59\tfunc (a DelegationAttempt) Latest() *ReviewRun { return a.latest }\n    60\t\n    61\t// DelegationRunning is the state of an attempt whose process is still there;\n    62\t// DelegationStalled, of one whose process is gone without a record.\n    63\tconst (\n    64\t\tDelegationRunning = \"running\"\n    65\t\tDelegationStalled = \"stalled\"\n    66\t\t// DelegationAbandonedCause is the failure of a stalled attempt whose\n    67\t\t// dispatch ended before recording its run.\n    68\t\tDelegationAbandonedCause = \"abandoned: the dispatching process ended before the run was recorded\"\n    69\t)\n    70\t\n    71\t// ListDelegationAttempts groups every recorded run by attempt, adds the runs\n    72\t// in progress, and returns the losses the run history reports.\n    73\tfunc (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n    74\t\t// The markers are read before the runs: a run publishes its record before\n    75\t\t// it removes its marker, so a reader that finds no marker for an attempt\n    76\t\t// it saw running finds its record (spec\n    77\t\t// pose-delegated-review-completion-signal R5).\n    78\t\tactive, activeLost, activeErr := s.ListDelegationActive()\n    79\t\truns, lost, err := s.ReadReviewRuns(\"\")\n    80\t\tif err != nil {\n    81\t\t\treturn nil, nil, err\n    82\t\t}\n    83\t\t// Task runs share the lifecycle, never the review history (spec\n    84\t\t// pose-delegation-task R7, R8).\n    85\t\ttasks, taskLost := s.ReadDelegationTaskRuns()\n    86\t\truns, lost = append(runs, tasks...), append(lost, taskLost...)\n    87\t\tbyAttempt := map[string]*DelegationAttempt{}\n    88\t\torder := []string{}\n    89\t\tfor i := range runs {\n    90\t\t\trun := runs[i]\n    91\t\t\tkey := run.AttemptID\n    92\t\t\tif key == \"\" {\n    93\t\t\t\tkey = run.RunID // a run recorded before attempts existed is its own attempt\n    94\t\t\t}\n    95\t\t\trow, ok := byAttempt[key]\n    96\t\t\tif !ok {\n    97\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    98\t\t\t\tbyAttempt[key] = row\n    99\t\t\t\torder = append(order, key)\n   100\t\t\t}\n   101\t\t\trow.Runs = append(row.Runs, run.RunID)\n   102\t\t\trow.latest = &runs[i]\n   103\t\t\tif run.SessionDigest != \"\" {\n   104\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   105\t\t\t\t\trow.sessions = append(row.sessions, value)\n   106\t\t\t\t}\n   107\t\t\t}\n   108\t\t\tevents, err := s.ReadDelegationEvents(run)\n   109\t\t\tif err != nil {\n   110\t\t\t\t// A turn count read from nothing would report a whole history.\n   111\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   112\t\t\t} else {\n   113\t\t\t\tfor _, e := range events {\n   114\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   115\t\t\t\t\t\trow.Turns++\n   116\t\t\t\t\t}\n   117\t\t\t\t}\n   118\t\t\t\tif len(events) > 0 {\n   119\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   120\t\t\t\t}\n   121\t\t\t}\n   122\t\t}\n   123\t\tfor _, key := range order {\n   124\t\t\trow := byAttempt[key]\n   125\t\t\tlatest := row.latest\n   126\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   127\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   128\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   129\t\t\tif latest.Access != \"\" {\n   130\t\t\t\trow.Access = latest.Access\n   131\t\t\t}\n   132\t\t\trow.Round = latest.Round\n   133\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   134\t\t\t\trow.HookFailure = hook.Failure\n   135\t\t\t}\n   136\t\t\tif row.Purpose == \"\" {\n   137\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   138\t\t\t}\n   139\t\t\tif latest.Status == ReviewRunInterrupted {\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n   206\t\tfor _, key := range order {\n   207\t\t\tout = append(out, *byAttempt[key])\n   208\t\t}\n   209\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   210\t\treturn out, lost, nil\n   211\t}\n   212\t\n   213\tfunc delegationStepText(e DelegationEvent) string {\n   214\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   215\t\tif len(text) > 80 {\n   216\t\t\tcut := 77\n   217\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   218\t\t\t\tcut--\n   219\t\t\t}\n   220\t\t\ttext = text[:cut] + \"...\"\n   221\t\t}\n   222\t\tswitch e.Kind {\n   223\t\tcase DelegationEventToolCall:\n   224\t\t\treturn \"▶ \" + text\n   225\t\tcase DelegationEventToolOutput:\n   226\t\t\tif e.ExitCode != nil && *e.ExitCode != 0 {\n   227\t\t\t\treturn fmt.Sprintf(\"✗ exit %d\", *e.ExitCode)\n   228\t\t\t}\n   229\t\t\treturn \"✓ exit 0\"\n   230\t\tcase DelegationEventTurn:\n   231\t\t\treturn \"turn\"\n   232\t\t}\n   233\t\tif text == \"\" {\n   234\t\t\treturn e.Kind\n   235\t\t}\n   236\t\treturn e.Kind + \": \" + text\n   237\t}\n   238\t\n   239\t// ErrDelegationRefAmbiguous carries the candidates of an ambiguous reference.\n   240\t// Neither reference error carries the reference: it may be a session, which\n   241\t// no output names.\n   242\ttype ErrDelegationRefAmbiguous struct {\n   243\t\tCandidates []string\n   244\t}\n   245\t\n   246\tfunc (e *ErrDelegationRefAmbiguous) Error() string {\n   247\t\treturn \"pose: the reference names more than one delegated run: \" + strings.Join(e.Candidates, \", \")\n   248\t}\n   249\t\n   250\t// ErrDelegationRefUnknown means no attempt matches.\n   251\ttype ErrDelegationRefUnknown struct{}\n   252\t\n   253\tfunc (e *ErrDelegationRefUnknown) Error() string {\n   254\t\treturn \"pose: no delegated run matches the reference (a run id, an attempt id, a label or a session prefix of six characters or more)\"\n   255\t}\n   256\t\n   257\t// ResolveDelegationRef finds the one attempt ref names (R11).\n   258\tfunc ResolveDelegationRef(attempts []DelegationAttempt, ref string) (DelegationAttempt, error) {\n   259\t\tref = strings.TrimSpace(ref)\n   260\t\tif ref == \"\" {\n     1\tpackage cli\n     2\t\n     3\t// pose delegate: the one surface for delegated executions (spec\n     4\t// pose-delegation-surface; ADR 2026-10-26-delegation-is-a-first-class-execution-surface).\n     5\t//\n     6\t// pose review governs the subject (bundle, brief, attestation, verify);\n     7\t// pose delegate governs executions: who runs, with which access, and what\n     8\t// happened. review, adjudicate and smoke run through the delivered dispatch\n     9\t// path; the lifecycle commands read the same run records.\n    10\t//\n    11\t// Every subcommand takes the common flags with one meaning (R2): where a\n    12\t// command starts a run they set it (--agent, --access, --label, --lead);\n    13\t// where it names or lists runs they select them, and a run that does not\n    14\t// match is not the one named; --dry-run changes nothing anywhere.\n    15\t\n    16\timport (\n    17\t\t\"context\"\n    18\t\t\"crypto/rand\"\n    19\t\t\"encoding/json\"\n    20\t\t\"errors\"\n    21\t\t\"fmt\"\n    22\t\t\"io\"\n    23\t\t\"os\"\n    24\t\t\"os/signal\"\n    25\t\t\"path/filepath\"\n    26\t\t\"regexp\"\n    27\t\t\"sort\"\n    28\t\t\"strconv\"\n    29\t\t\"strings\"\n    30\t\t\"syscall\"\n    31\t\t\"time\"\n    32\t\n    33\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    34\t)\n    35\t\n    36\tconst delegateUsageText = \"pose delegate <review|adjudicate|smoke|task|ls|watch|wait|resume|handoff|cancel|agents> [args] [--agent auto|<name>] [--access read|sandboxed|write|full] [--label <name>] [--lead <vendor>] [--dry-run] [--json]\"\n    37\t\n    38\t// Versioned JSON documents of pose delegate (R10).\n    39\tconst (\n    40\t\tdelegateRunSchema    = \"pose.delegate.run/v1\"\n    41\t\tdelegatePlanSchema   = \"pose.delegate.plan/v1\"\n    42\t\tdelegateListSchema   = \"pose.delegate.ls/v1\"\n    43\t\tdelegateCancelSchema = \"pose.delegate.cancel/v1\"\n    44\t\tdelegateAgentsSchema = \"pose.delegate.agents/v1\"\n    45\t\tdelegateErrorSchema  = \"pose.delegate.error/v1\"\n    46\t)\n    47\t\n    48\t// Subcommands named by the ADR whose behaviour a later spec delivers.\n    49\tvar delegatePlanned = map[string]string{}\n    50\t\n    51\tvar (\n    52\t\tdelegateLabelRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n    53\t)\n    54\t\n    55\t// commonDelegateFlags are taken by every subcommand.\n    56\tvar commonDelegateFlags = []string{\"--agent\", \"--access\", \"--label\", \"--lead\", \"--dry-run\", \"--json\"}\n    57\t\n    58\t// tr picks the message for the session's locale.\n    59\tfunc tr(english, portuguese string) string { return cliText(cliLocaleValue(), english, portuguese) }\n    60\t\n    61\ttype delegateFlags struct {\n    62\t\tagent, access, label, lead, reason, noteFile string\n    63\t\trequest                                      string\n    64\t\tto, cd, effort, promptFile, session          string\n    65\t\taddDirs                                      []string\n    66\t\tnoNetwork, record, confirmAbandoned          bool\n    67\t\tdryRun, jsonOut, active, wait, detach        bool\n    68\t\tverbose, noFollow                            bool\n    69\t\tlines                                        int\n    70\t\twaitMax, timeout, refresh                    time.Duration\n    71\t\tpositional                                   []string\n    72\t}\n    73\t\n    74\t// parseDelegateFlags reads the common flags and the extra ones a subcommand\n    75\t// takes; problem is a message for the person, in their locale.\n    76\tfunc parseDelegateFlags(args []string, extra ...string) (delegateFlags, string) {\n    77\t\tf := delegateFlags{waitMax: 24 * time.Hour}\n    78\t\tpermit := map[string]bool{}\n    79\t\tfor _, name := range append(append([]string(nil), commonDelegateFlags...), extra...) {\n    80\t\t\tpermit[name] = true\n    81\t\t}\n    82\t\tfor i := 0; i < len(args); i++ {\n    83\t\t\targ := args[i]\n    84\t\t\tname, inline, hasInline := strings.Cut(arg, \"=\")\n    85\t\t\t// A lone - names stdin (spec pose-delegation-task R1).\n    86\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n    87\t\t\t\tf.positional = append(f.positional, arg)\n    88\t\t\t\tcontinue\n    89\t\t\t}\n    90\t\t\tif !permit[name] {\n    91\t\t\t\treturn f, tr(\"unknown or inapplicable flag \"+name, \"flag desconhecida ou inaplicável \"+name)\n    92\t\t\t}\n    93\t\t\tswitch name {\n    94\t\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\", \"--confirm-abandoned\":\n    95\t\t\t\tif hasInline {\n    96\t\t\t\t\treturn f, tr(name+\" takes no value\", name+\" não recebe valor\")\n    97\t\t\t\t}\n    98\t\t\t\tswitch name {\n    99\t\t\t\tcase \"--dry-run\":\n   100\t\t\t\t\tf.dryRun = true\n   101\t\t\t\tcase \"--json\":\n   102\t\t\t\t\tf.jsonOut = true\n   103\t\t\t\tcase \"--detach\":\n   104\t\t\t\t\tf.detach = true\n   105\t\t\t\tcase \"-v\":\n   106\t\t\t\t\tf.verbose = true\n   107\t\t\t\tcase \"--no-network\":\n   108\t\t\t\t\tf.noNetwork = true\n   109\t\t\t\tcase \"--record\":\n   110\t\t\t\t\tf.record = true\n   111\t\t\t\tcase \"--confirm-abandoned\":\n   112\t\t\t\t\tf.confirmAbandoned = true\n   113\t\t\t\tcase \"--no-follow\":\n   114\t\t\t\t\tf.noFollow = true\n   115\t\t\t\tdefault:\n   116\t\t\t\t\tf.active = true\n   117\t\t\t\t}\n   118\t\t\tcase \"--wait-until-reset\":\n   119\t\t\t\tf.wait = true\n   120\t\t\t\tif hasInline {\n   121\t\t\t\t\td, err := time.ParseDuration(inline)\n   122\t\t\t\t\tif err != nil || d <= 0 || d > 24*time.Hour {\n   123\t\t\t\t\t\treturn f, tr(\"--wait-until-reset takes a duration up to 24h\", \"--wait-until-reset recebe uma duração de até 24h\")\n   124\t\t\t\t\t}\n   125\t\t\t\t\tf.waitMax = d\n   126\t\t\t\t}\n   127\t\t\tdefault:\n   128\t\t\t\tvalue := inline\n   129\t\t\t\tif !hasInline {\n   130\t\t\t\t\t// --prompt - reads stdin (spec pose-delegation-task R8).\n   131\t\t\t\t\tif i+1 >= len(args) || strings.HasPrefix(args[i+1], \"-\") && !(name == \"--prompt\" && args[i+1] == \"-\") {\n   132\t\t\t\t\t\treturn f, tr(name+\" needs a value\", name+\" precisa de um valor\")\n   133\t\t\t\t\t}\n   134\t\t\t\t\tvalue = args[i+1]\n   135\t\t\t\t\ti++\n   136\t\t\t\t}\n   137\t\t\t\tswitch name {\n   138\t\t\t\tcase \"--agent\":\n   139\t\t\t\t\tf.agent = value\n   140\t\t\t\tcase \"--access\":\n   141\t\t\t\t\tif !containsString([]string{posemodel.DelegationAccessRead, posemodel.DelegationAccessSandboxed, posemodel.DelegationAccessWrite, posemodel.DelegationAccessFull}, value) {\n   142\t\t\t\t\t\treturn f, tr(\"--access takes read, sandboxed, write or full\", \"--access recebe read, sandboxed, write ou full\")\n   143\t\t\t\t\t}\n   144\t\t\t\t\tf.access = value\n   145\t\t\t\tcase \"--label\":\n   146\t\t\t\t\tif !delegateLabelRE.MatchString(value) {\n   147\t\t\t\t\t\treturn f, tr(\"--label takes letters, digits, '.', '_' and '-' (64 at most)\", \"--label aceita letras, dígitos, '.', '_' e '-' (no máximo 64)\")\n   148\t\t\t\t\t}\n   149\t\t\t\t\tf.label = value\n   150\t\t\t\tcase \"--lead\":\n   151\t\t\t\t\tvendor, model, err := posemodel.ParseLead(value)\n   152\t\t\t\t\tif err != nil {\n   153\t\t\t\t\t\treturn f, tr(\"--lead takes <vendor>[/<model>], such as openai or anthropic/claude-opus-5-5\", \"--lead recebe <vendor>[/<modelo>], como openai ou anthropic/claude-opus-5-5\")\n   154\t\t\t\t\t}\n   155\t\t\t\t\tf.lead = vendor\n   156\t\t\t\t\tif model != \"\" {\n   157\t\t\t\t\t\tf.lead += \"/\" + model\n   158\t\t\t\t\t}\n   159\t\t\t\tcase \"--reason\":\n   160\t\t\t\t\tf.reason = value\n   161\t\t\t\tcase \"--session\":\n   162\t\t\t\t\tf.session = value\n   163\t\t\t\tcase \"--request\":\n   164\t\t\t\t\tf.request = value\n   165\t\t\t\tcase \"--lines\":\n   166\t\t\t\t\tn, err := strconv.Atoi(value)\n   167\t\t\t\t\tif err != nil || n < 1 || n > 1000 {\n   168\t\t\t\t\t\treturn f, tr(\"--lines takes a number from 1 to 1000\", \"--lines recebe um número de 1 a 1000\")\n   169\t\t\t\t\t}\n   170\t\t\t\t\tf.lines = n\n   171\t\t\t\tcase \"--refresh\":\n   172\t\t\t\t\td, err := time.ParseDuration(value)\n   173\t\t\t\t\tif err != nil || d < 0 || d > time.Hour {\n   174\t\t\t\t\t\treturn f, tr(\"--refresh takes a duration from 0 to 1h (0 turns the preview's refresh off)\", \"--refresh recebe uma duração de 0 a 1h (0 desliga a atualização do preview)\")\n   175\t\t\t\t\t}\n   176\t\t\t\t\tf.refresh = d\n   177\t\t\t\tcase \"--timeout\":\n   178\t\t\t\t\td, err := time.ParseDuration(value)\n   179\t\t\t\t\tif err != nil || d <= 0 {\n   180\t\t\t\t\t\treturn f, tr(\"--timeout takes a positive duration\", \"--timeout recebe uma duração positiva\")\n   181\t\t\t\t\t}\n   182\t\t\t\t\tf.timeout = d\n   183\t\t\t\tcase \"--to\":\n   184\t\t\t\t\tf.to = value\n   185\t\t\t\tcase \"--cd\":\n   186\t\t\t\t\tf.cd = value\n   187\t\t\t\tcase \"--add-dir\":\n   188\t\t\t\t\tf.addDirs = append(f.addDirs, value)\n   189\t\t\t\tcase \"--effort\":\n   190\t\t\t\t\tf.effort = value\n   191\t\t\t\tcase \"--prompt\":\n   192\t\t\t\t\tf.promptFile = value\n   193\t\t\t\tcase \"--note-file\":\n   194\t\t\t\t\tf.noteFile = value\n   195\t\t\t\t}\n   196\t\t\t}\n   197\t\t}\n   198\t\treturn f, \"\"\n   199\t}\n   200\t\n   201\tfunc cmdDelegate(root string, args []string, stdout, stderr io.Writer) int {\n   202\t\tif len(args) == 0 {\n   203\t\t\tdispatchCommandHelp(\"delegate\", nil, stdout, cliLocaleValue())\n   204\t\t\treturn 0\n   205\t\t}\n   206\t\tsub, rest := args[0], args[1:]\n   207\t\tif spec, planned := delegatePlanned[sub]; planned {\n   208\t\t\treturn delegateUsage(stdout, stderr, rest, sub, tr(\"not available yet; it is delivered by spec \"+spec, \"ainda não está disponível; é entregue pela spec \"+spec))\n   209\t\t}\n   210\t\tswitch sub {\n   211\t\tcase posemodel.DelegationPurposeReview, posemodel.DelegationPurposeAdjudicate, posemodel.DelegationPurposeSmoke:\n   212\t\t\treturn cmdDelegatePurpose(root, sub, rest, stdout, stderr)\n   213\t\tcase posemodel.DelegationPurposeTask:\n   214\t\t\treturn cmdDelegateTask(root, rest, stdout, stderr)\n   215\t\tcase \"ls\":\n   216\t\t\treturn cmdDelegateLs(root, rest, stdout, stderr)\n   217\t\tcase \"resume\":\n   218\t\t\treturn cmdDelegateResume(root, rest, stdout, stderr)\n   219\t\tcase \"cancel\":\n   220\t\t\treturn cmdDelegateCancel(root, rest, stdout, stderr)\n   221\t\tcase \"agents\":\n   222\t\t\treturn cmdDelegateAgents(root, rest, stdout, stderr)\n   223\t\tcase \"wait\":\n   224\t\t\treturn cmdDelegateWait(root, rest, stdout, stderr)\n   225\t\tcase \"watch\":\n   226\t\t\treturn cmdDelegateWatch(root, rest, stdout, stderr)\n   227\t\tcase \"handoff\":\n   228\t\t\treturn cmdDelegateHandoff(root, rest, stdout, stderr)\n   229\t\t}\n   230\t\treturn delegateUsage(stdout, stderr, rest, sub, tr(\"unknown subcommand\", \"subcomando desconhecido\")+\"\\n\"+tr(\"Usage: \", \"Uso: \")+delegateUsageText)\n   231\t}\n   232\t\n   233\t// delegateUsage reports a usage error: exit 2, as text, or as the error\n   234\t// document when the caller asked for --json (R10).\n   235\tfunc delegateUsage(stdout, stderr io.Writer, args []string, command, msg string) int {\n   236\t\tfor _, arg := range args {\n   237\t\t\tif arg == \"--json\" {\n   238\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg, \"usage\": true})\n   239\t\t\t\treturn 2\n   240\t\t\t}\n   241\t\t}\n   242\t\thandBackRefusal(map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg, \"usage\": true}, 2)\n   243\t\treturn usageError(stderr, \"pose delegate \"+command+\": \"+msg)\n   244\t}\n   245\t\n   246\tfunc writeDelegateJSON(stdout io.Writer, doc any) {\n   247\t\t// Every error document a detached run writes is handed back (B03); a\n   248\t\t// caller that knows its exit code hands it back first.\n   249\t\tif m, ok := doc.(map[string]any); ok && m[\"schema\"] == delegateErrorSchema {\n   250\t\t\tcode := 1\n   251\t\t\tif m[\"usage\"] == true {\n   252\t\t\t\tcode = 2\n   253\t\t\t}\n   254\t\t\thandBackRefusal(m, code)\n   255\t\t}\n   256\t\tenc := json.NewEncoder(stdout)\n   257\t\tenc.SetIndent(\"\", \"  \")\n   258\t\t_ = enc.Encode(doc)\n   259\t}\n   260\t\n   261\t// delegateFail reports a failure as text or as the error document.\n   262\tfunc delegateFail(stdout, stderr io.Writer, jsonOut bool, command string, code int, err error) int {\n   263\t\tmsg := strings.TrimPrefix(err.Error(), \"pose: \")\n   264\t\tdoc := map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg}\n   265\t\t// The reason code of a refusal is the same over MCP (spec\n   266\t\t// pose-delegation-mcp R5).\n   267\t\tif code := posemodel.DelegationReasonCode(err); code != \"\" {\n   268\t\t\tdoc[\"reason_code\"] = code\n   269\t\t}\n   270\t\tvar ambiguous *posemodel.ErrDelegationRefAmbiguous\n   271\t\tif errors.As(err, &ambiguous) {\n   272\t\t\tdoc[\"candidates\"] = ambiguous.Candidates\n   273\t\t}\n   274\t\thandBackRefusal(doc, code)\n   275\t\tif jsonOut {\n   276\t\t\twriteDelegateJSON(stdout, doc)\n   277\t\t\treturn code\n   278\t\t}\n   279\t\tif code == 2 {\n   280\t\t\treturn usageError(stderr, \"pose delegate \"+command+\": \"+msg)\n   281\t\t}\n   282\t\trender(stdout, stderr).Failure(\"pose delegate \" + command + \": \" + msg)\n   283\t\treturn code\n   284\t}\n   285\t\n   286\t// refError renders a reference error in the person's locale.\n   287\tfunc refError(err error) error {\n   288\t\tvar ambiguous *posemodel.ErrDelegationRefAmbiguous\n   289\t\tif errors.As(err, &ambiguous) {\n   290\t\t\treturn localizedRefError{err: ambiguous, msg: tr(err.Error(), \"a referência nomeia mais de um run delegado: \"+strings.Join(ambiguous.Candidates, \", \"))}\n   291\t\t}\n   292\t\tvar unknown *posemodel.ErrDelegationRefUnknown\n   293\t\tif errors.As(err, &unknown) {\n   294\t\t\treturn errors.New(tr(err.Error(), \"nenhum run delegado corresponde à referência (um id de run, um id de tentativa, um label ou um prefixo de sessão de seis caracteres ou mais)\"))\n   295\t\t}\n   296\t\treturn err\n   297\t}\n   298\t\n   299\t// localizedRefError words a reference error in the person's locale and keeps\n   300\t// the engine's error, so the error document still carries its candidates.\n   301\ttype localizedRefError struct {\n   302\t\terr error\n   303\t\tmsg string\n   304\t}\n   305\t\n   306\tfunc (e localizedRefError) Error() string { return e.msg }\n   307\tfunc (e localizedRefError) Unwrap() error { return e.err }\n   308\t\n   309\t// mismatch names the first selecting flag an attempt does not match.\n   310\tfunc (f delegateFlags) mismatch(a posemodel.DelegationAttempt) string {\n   311\t\tswitch {\n   312\t\tcase f.agent != \"\" && f.agent != \"auto\" && f.agent != a.Agent:\n   313\t\t\treturn \"--agent \" + f.agent\n   314\t\tcase f.access != \"\" && f.access != a.Access:\n   315\t\t\treturn \"--access \" + f.access\n   316\t\tcase f.label != \"\" && f.label != a.Label:\n   317\t\t\treturn \"--label \" + f.label\n   318\t\tcase f.lead != \"\" && f.lead != a.Lead && leadVendor(f.lead) != a.Lead:\n   319\t\t\treturn \"--lead \" + f.lead\n   320\t\t}\n   321\t\treturn \"\"\n   322\t}\n   323\t\n   324\t// namedAttempt resolves the one reference a lifecycle command takes: the\n   325\t// positional reference, or --label when there is none; the other common\n   326\t// flags then select, and a run that does not match is refused.\n   327\tfunc namedAttempt(attempts []posemodel.DelegationAttempt, f delegateFlags) (posemodel.DelegationAttempt, int, error) {\n   328\t\tref := \"\"\n   329\t\tswitch len(f.positional) {\n   330\t\tcase 0:\n   331\t\t\tref = f.label\n   332\t\tcase 1:\n   333\t\t\tref = f.positional[0]\n   334\t\tdefault:\n   335\t\t\treturn posemodel.DelegationAttempt{}, 2, errors.New(tr(\"one run reference at most\", \"no máximo uma referência de run\"))\n   336\t\t}\n   337\t\tif ref == \"\" {\n   338\t\t\treturn posemodel.DelegationAttempt{}, 2, errors.New(tr(\"name a run (a run id, an attempt id, a label or a session prefix)\", \"nomeie um run (id de run, id de tentativa, label ou prefixo de sessão)\"))\n   339\t\t}\n   340\t\tattempt, err := posemodel.ResolveDelegationRef(attempts, ref)\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"context\"\n     6\t\t\"crypto/rand\"\n     7\t\t\"encoding/hex\"\n     8\t\t\"encoding/json\"\n     9\t\t\"errors\"\n    10\t\t\"fmt\"\n    11\t\t\"io\"\n    12\t\t\"io/fs\"\n    13\t\t\"os\"\n    14\t\t\"os/exec\"\n    15\t\t\"path/filepath\"\n    16\t\t\"sort\"\n    17\t\t\"strings\"\n    18\t\t\"time\"\n    19\t)\n    20\t\n    21\tconst reviewAttemptDir = \".pose/review-attempts\"\n    22\tconst reviewRunLedgerDir = \".pose/review-run-ledger\"\n    23\tconst reviewLedgerMaxRecords = 10000\n    24\tconst reviewLedgerMaxBytes = 1 << 20\n    25\t\n    26\t// DelegatedReviewAttempt is an immutable reservation, published before any adapter starts.\n    27\t// Its ordinal path coordinates contenders; its ID binds its complete content.\n    28\ttype DelegatedReviewAttempt struct {\n    29\t\tSchemaVersion int    `json:\"schema_version\"`\n    30\t\tAttemptID     string `json:\"attempt_id\"`\n    31\t\tBundleID      string `json:\"bundle_id\"`\n    32\t\tBundleDigest  string `json:\"bundle_digest\"`\n    33\t\tScope         string `json:\"scope\"`\n    34\t\tAdapter       string `json:\"adapter\"`\n    35\t\tReason        string `json:\"reason,omitempty\"`\n    36\t\tOrdinal       int    `json:\"ordinal\"`\n    37\t\tReservedAt    string `json:\"reserved_at\"`\n    38\t\tNonce         string `json:\"nonce\"`\n    39\t}\n    40\ttype reviewAttemptReceipt struct {\n    41\t\tSchemaVersion int    `json:\"schema_version\"`\n    42\t\tAttemptID     string `json:\"attempt_id\"`\n    43\t\tRunID         string `json:\"run_id\"`\n    44\t\tRunDigest     string `json:\"run_digest\"`\n    45\t}\n    46\ttype reviewRunWitness struct {\n    47\t\tSchemaVersion    int    `json:\"schema_version\"`\n    48\t\tRunID            string `json:\"run_id\"`\n    49\t\tBundleID         string `json:\"bundle_id\"`\n    50\t\tScope            string `json:\"scope\"`\n    51\t\tRecordDigest     string `json:\"record_digest\"`\n    52\t\tTranscriptDigest string `json:\"transcript_digest\"`\n    53\t}\n    54\t\n    55\tfunc reviewAttemptKey(bundle string) string {\n    56\t\treturn strings.TrimPrefix(digestBytes([]byte(bundle)), \"sha256:\")[:24]\n    57\t}\n    58\tfunc reviewAttemptPath(root string, a DelegatedReviewAttempt) string {\n    59\t\treturn filepath.Join(root, reviewAttemptDir, reviewAttemptKey(a.BundleID), fmt.Sprintf(\"%06d.json\", a.Ordinal))\n    60\t}\n    61\tfunc attemptReceiptPath(root string, a DelegatedReviewAttempt) string {\n    62\t\treturn strings.TrimSuffix(reviewAttemptPath(root, a), \".json\") + \".result.json\"\n    63\t}\n    64\tfunc attemptIdentity(a DelegatedReviewAttempt) string {\n    65\t\ta.AttemptID = \"\"\n    66\t\traw, _ := json.Marshal(a)\n    67\t\treturn \"rat-\" + strings.TrimPrefix(digestBytes(raw), \"sha256:\")\n    68\t}\n    69\t\n    70\tfunc readLedgerRaw(path string) ([]byte, error) {\n    71\t\treturn readBoundedRegular(path, reviewLedgerMaxBytes)\n    72\t}\n    73\t\n    74\t// readBoundedRegular reads a regular file of at most limit bytes, refusing a\n    75\t// link or a file replaced while it was opened.\n    76\tfunc readBoundedRegular(path string, limit int64) ([]byte, error) {\n    77\t\tinfo, err := os.Lstat(path)\n    78\t\tif err != nil {\n    79\t\t\treturn nil, err\n    80\t\t}\n    81\t\tif !info.Mode().IsRegular() || info.Size() > limit {\n    82\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n    83\t\t}\n    84\t\tf, err := os.Open(path)\n    85\t\tif err != nil {\n    86\t\t\treturn nil, err\n    87\t\t}\n    88\t\topened, statErr := f.Stat()\n    89\t\tif statErr != nil || !opened.Mode().IsRegular() || !os.SameFile(info, opened) {\n    90\t\t\tf.Close()\n    91\t\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n    92\t\t}\n    93\t\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n    94\t\tcloseErr := f.Close()\n    95\t\tif err != nil {\n    96\t\t\treturn nil, err\n    97\t\t}\n    98\t\tif closeErr != nil {\n    99\t\t\treturn nil, closeErr\n   100\t\t}\n   101\t\tif int64(len(raw)) > limit {\n   102\t\t\treturn nil, fmt.Errorf(\"ledger record exceeds bound\")\n   103\t\t}\n   104\t\treturn raw, nil\n   105\t}\n   106\t\n   107\t// readBoundedRegularIn is the operation-Files form of readBoundedRegular. It\n   108\t// keeps the same regular-file and replacement checks while making the bytes\n   109\t// part of an active governance read view.\n   110\tfunc readBoundedRegularIn(files Files, path string, limit int64) ([]byte, error) {\n   111\t\tfiles = FilesOrNative(files)\n   112\t\tinfo, err := files.Lstat(path)\n   113\t\tif err != nil {\n   114\t\t\treturn nil, err\n   115\t\t}\n   116\t\tif !info.Mode().IsRegular() || limit < 0 || info.Size() < 0 || info.Size() > limit {\n   117\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n   118\t\t}\n   119\t\tf, err := files.Open(path)\n   120\t\tif err != nil {\n   121\t\t\treturn nil, err\n   122\t\t}\n   123\t\topened, statErr := f.Stat()\n   124\t\tif statErr != nil || !opened.Mode().IsRegular() || !sameObservedFile(info, opened) {\n   125\t\t\t_ = f.Close()\n   126\t\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n   127\t\t}\n   128\t\traw, readErr := readLimited(f, limit)\n   129\t\tcloseErr := f.Close()\n   130\t\tif readErr != nil {\n   131\t\t\treturn nil, readErr\n   132\t\t}\n   133\t\tif closeErr != nil {\n   134\t\t\treturn nil, closeErr\n   135\t\t}\n   136\t\treturn raw, nil\n   137\t}\n   138\t\n   139\tvar errReviewLedgerBudget = errors.New(\"review ledger exceeds 32 MiB inventory read budget\")\n   140\t\n   141\tfunc readLedgerRawBudget(path string, remaining *int64) ([]byte, error) {\n   142\t\tinfo, err := os.Lstat(path)\n   143\t\tif err != nil {\n   144\t\t\treturn nil, err\n   145\t\t}\n   146\t\tif info.Size() < 0 || info.Size() > *remaining {\n   147\t\t\treturn nil, errReviewLedgerBudget\n   148\t\t}\n   149\t\t*remaining -= info.Size()\n   150\t\traw, err := readLedgerRaw(path)\n   151\t\tif err != nil {\n   152\t\t\treturn nil, err\n   153\t\t}\n   154\t\tif extra := int64(len(raw)) - info.Size(); extra > 0 {\n   155\t\t\t*remaining -= extra\n   156\t\t\tif *remaining < 0 {\n   157\t\t\t\treturn nil, errReviewLedgerBudget\n   158\t\t\t}\n   159\t\t}\n   160\t\treturn raw, nil\n   161\t}\n   162\t\n   163\tfunc readLedgerRawBudgetIn(files Files, path string, remaining *int64) ([]byte, error) {\n   164\t\tfiles = FilesOrNative(files)\n   165\t\tinfo, err := files.Lstat(path)\n   166\t\tif err != nil {\n   167\t\t\treturn nil, err\n   168\t\t}\n   169\t\tif info.Size() < 0 || info.Size() > *remaining {\n   170\t\t\treturn nil, errReviewLedgerBudget\n   171\t\t}\n   172\t\t*remaining -= info.Size()\n   173\t\traw, err := readBoundedRegularIn(files, path, reviewLedgerMaxBytes)\n   174\t\tif err != nil {\n   175\t\t\treturn nil, err\n   176\t\t}\n   177\t\tif extra := int64(len(raw)) - info.Size(); extra > 0 {\n   178\t\t\t*remaining -= extra\n   179\t\t\tif *remaining < 0 {\n   180\t\t\t\treturn nil, errReviewLedgerBudget\n   181\t\t\t}\n   182\t\t}\n   183\t\treturn raw, nil\n   184\t}\n   185\tfunc readLedgerJSONBudget(path string, v any, remaining *int64) error {\n   186\t\traw, err := readLedgerRawBudget(path, remaining)\n   187\t\tif err != nil {\n   188\t\t\treturn err\n   189\t\t}\n   190\t\treturn strictJSONBytes(raw, v)\n   191\t}\n   192\t\n   193\tfunc readLedgerJSONBudgetIn(files Files, path string, v any, remaining *int64) error {\n   194\t\traw, err := readLedgerRawBudgetIn(files, path, remaining)\n   195\t\tif err != nil {\n   196\t\t\treturn err\n   197\t\t}\n   198\t\treturn strictJSONBytes(raw, v)\n   199\t}\n   200\tfunc reviewReadBudget(provided []*int64) *int64 {\n   201\t\tif len(provided) > 0 {\n   202\t\t\treturn provided[0]\n   203\t\t}\n   204\t\tbudget := int64(32 << 20)\n   205\t\treturn &budget\n   206\t}\n   207\t\n   208\tfunc readLedgerJSON(path string, v any) error {\n   209\t\traw, err := readLedgerRaw(path)\n   210\t\tif err != nil {\n   211\t\t\treturn err\n   212\t\t}\n   213\t\tif err := strictJSONBytes(raw, v); err != nil {\n   214\t\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n   215\t\t}\n   216\t\treturn nil\n   217\t}\n   218\t\n   219\tfunc readLedgerJSONIn(files Files, path string, v any) error {\n   220\t\traw, err := readBoundedRegularIn(files, path, reviewLedgerMaxBytes)\n   221\t\tif err != nil {\n   222\t\t\treturn err\n   223\t\t}\n   224\t\tif err := strictJSONBytes(raw, v); err != nil {\n   225\t\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n   226\t\t}\n   227\t\treturn nil\n   228\t}\n   229\t\n   230\tfunc ledgerEntries(root, rel string) ([]os.DirEntry, error) {\n   231\t\tpath, err := ensureReviewArtifactDir(root, rel, false)\n   232\t\tif os.IsNotExist(err) {\n   233\t\t\treturn nil, nil\n   234\t\t}\n   235\t\tif err != nil {\n   236\t\t\treturn nil, err\n   237\t\t}\n   238\t\tf, err := os.Open(path)\n   239\t\tif err != nil {\n   240\t\t\treturn nil, err\n   241\t\t}\n   242\t\tentries, err := f.ReadDir(reviewLedgerMaxRecords + 1)\n   243\t\tcloseErr := f.Close()\n   244\t\tif err != nil && !errors.Is(err, io.EOF) {\n   245\t\t\treturn nil, err\n   246\t\t}\n   247\t\tif closeErr != nil {\n   248\t\t\treturn nil, closeErr\n   249\t\t}\n   250\t\tif len(entries) > reviewLedgerMaxRecords {\n   251\t\t\treturn nil, fmt.Errorf(\"ledger inventory exceeds %d records\", reviewLedgerMaxRecords)\n   252\t\t}\n   253\t\tsort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })\n   254\t\treturn entries, nil\n   255\t}\n   256\t\n   257\tfunc ledgerEntriesIn(files Files, root, rel string) ([]fs.DirEntry, error) {\n   258\t\tfiles = FilesOrNative(files)\n   259\t\tpath, err := ensureReviewArtifactDirIn(files, root, rel, false)\n   260\t\tif os.IsNotExist(err) {\n   261\t\t\treturn nil, nil\n   262\t\t}\n   263\t\tif err != nil {\n   264\t\t\treturn nil, err\n   265\t\t}\n   266\t\tf, err := files.Open(path)\n   267\t\tif err != nil {\n   268\t\t\treturn nil, err\n   269\t\t}\n   270\t\treader, ok := f.(interface {\n   271\t\t\tReadDir(int) ([]fs.DirEntry, error)\n   272\t\t})\n   273\t\tif !ok {\n   274\t\t\t_ = f.Close()\n   275\t\t\treturn nil, fmt.Errorf(\"ledger directory does not support bounded reads\")\n   276\t\t}\n   277\t\tentries, err := reader.ReadDir(reviewLedgerMaxRecords + 1)\n   278\t\tcloseErr := f.Close()\n   279\t\tif err != nil && !errors.Is(err, io.EOF) {\n   280\t\t\treturn nil, err\n   281\t\t}\n   282\t\tif closeErr != nil {\n   283\t\t\treturn nil, closeErr\n   284\t\t}\n   285\t\tif len(entries) > reviewLedgerMaxRecords {\n   286\t\t\treturn nil, fmt.Errorf(\"ledger inventory exceeds %d records\", reviewLedgerMaxRecords)\n   287\t\t}\n   288\t\tsort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })\n   289\t\treturn entries, nil\n   290\t}\n   291\tfunc publishLedgerJSON(root, rel string, v any) error {\n   292\t\tdir, err := ensureReviewArtifactDir(root, filepath.ToSlash(filepath.Dir(rel)), true)\n   293\t\tif err != nil {\n   294\t\t\treturn err\n   295\t\t}\n   296\t\traw, err := json.MarshalIndent(v, \"\", \"  \")\n   297\t\tif err != nil {\n   298\t\t\treturn err\n   299\t\t}\n   300\t\tif len(raw) > reviewLedgerMaxBytes {\n","exit_code":0,"status":"completed"}}
