lse); err != nil {\n   218\t\t\tt.Fatal(err)\n   219\t\t}\n   220\t\tnext, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\")\n   221\t\tif err != nil {\n   222\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n   223\t\t}\n   224\t\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n   225\t\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n   226\t\t}\n   227\t}\n   228\t\n   229\t// Review rounds 2 and 5 (N3, N1): one release runs at a time, under a lock\n   230\t// the operating system releases when its holder ends.\n   330\t\tcase ReviewBriefKindSmoke:\n   331\t\t\tline(\"Exercise each delivered surface of the scope from its entrypoint, as a user of it would, and report what you observe against what the spec says should happen. Do not review the code beyond what you need to run it.\")\n   332\t\t}\n   333\t\tline(\"\")\n   334\t\n   335\t\tline(\"## Boundaries\")\n   336\t\tline(\"\")\n   337\t\tline(\"- Report every defect with file, line and severity (high, medium, low). Do not fix it.\")\n   338\t\tline(\"- Do not change the repository: no edits, commits, pushes, tags or releases.\")\n   339\t\tline(\"- Do not record an attestation: POSE records the conclusion of a verified run.\")\n   340\t\tline(\"- Do not reveal secrets or key material you come across.\")\n   341\t\tline(\"- If something you need is missing, say what and stop, rather than assuming it.\")\n   342\t\tif template == reviewBriefTemplateFinishCommands {\n   343\t\t\tline(\"- Let every command you start finish before you end, and do not leave anything running in the background: POSE ends what is left and records it, and a long run left behind costs time you could have used.\")\n   344\t\t}\n   345\t\tline(\"\")\n   346\t\n   347\t\tline(\"## Change\")\n   348\t\tline(\"\")\n   349\t\tline(\"- range: %s..%s\", orNone(subject.Base), orNone(subject.Head))\n   350\t\tline(\"- change sets: %s\", orNone(strings.Join(subject.ChangeSets, \", \")))\n   351\t\tentries := append([]ReviewBundleSubjectEntry(nil), subject.Entries...)\n   352\t\tsort.Slice(entries, func(i, j int) bool { return entryPath(entries[i]) < entryPath(entries[j]) })\npose-mcp/internal/pose/delegation_release_test.go:60:\trun, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false)\npose-mcp/internal/pose/delegation_release_test.go:74:\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\npose-mcp/internal/pose/delegation_release_test.go:101:\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\npose-mcp/internal/pose/delegation_release_test.go:153:\tif err != nil || len(attempts) != 1 || attempts[0].State != DelegationStalled || !strings.Contains(attempts[0].Failure, DelegationAbandonedCause) || !strings.Contains(attempts[0].Failure, \"pose delegate cancel \"+marker.AttemptID) {\npose-mcp/internal/pose/delegation_release_test.go:156:\trun, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false)\npose-mcp/internal/pose/delegation_release_test.go:214:\tif _, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after interruption\"); err == nil || !strings.Contains(err.Error(), \"pose delegate cancel \"+attempt) {\npose-mcp/internal/pose/delegation_release_test.go:217:\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil {\npose-mcp/internal/pose/delegation_release_test.go:245:\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\npose-mcp/internal/pose/delegation_release_test.go:258:\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err 