CKOUT`); on other Unix platforms only the process group is ended, and on Windows the adapter's descendants are not ended at all, which the run record states. The brief of template `review-brief/10` asks the reviewer to let its commands finish. The dispatch marks an attempt active before it publishes its reservation, so a dispatch that ends before recording its run always leaves a stalled attempt, which `pose delegate ls` lists with its cause, and `pose delegate cancel <attempt>` releases it once its owner is proven gone, recording a failed run and its receipt; one release runs at a time, under a lock the system releases with its holder, and a release completes with any run the attempt already recorded instead of writing another. A reservation an earlier engine left without a marker records no owner: `pose delegate ls` lists it once it is ten minutes old, and `pose delegate cancel <attempt> --confirm-abandoned` releases it on the operator's confirmation that no dispatch of it runs.\n    10\t)\n    11\t\n    12\t// On Windows the context kills the adapter's process; WaitDelay releases the\n    13\t// pipes its children may still hold.\n    14\tfunc isolateProcessGroup(cmd *exec.Cmd) {}\n    15\t\n    16\tfunc killProcessGroup(cmd *exec.Cmd) error                { return nil }\n    17\tfunc openReviewAdapterFile(path string) (*os.File, error) { return os.Open(path) }\n    18\tfunc reviewSetupCommand(ctx context.Context, source *exec.Cmd) *exec.Cmd {\n    19\t\tcmd := exec.CommandContext(ctx, source.Path, source.Args[1:]...)\n    20\t\tcmd.Env = source.Env\n    21\t\treturn cmd\n    22\t}\n    23\t\n    24\tfunc reviewProcessGroupAvailable() error                              { return fmt.Errorf(\"process-group termination unsupported\") }\n    25\tfunc openReviewRootFile(root *os.Root, path string) (*os.File, error) { return root.Open(path) }\n   150\t\t\t\t\t// N1). Only one of this user is an unknown that may be the run's.\n   151\t\t\t\t\tif owner, oerr := reviewProcessOwner(pid); reviewProcessGoneErr(oerr) || oerr == nil && owner != os.Getuid() {\n   152\t\t\t\t\t\tcontinue\n   153\t\t\t\t\t}\n   154\t\t\t\t\tchildren++\n   155\t\t\t\t\tnote(fmt.Errorf(\"process %d could not be inspected: %w\", pid, err))\n   156\t\t\t\t\tcontinue\n   157\t\t\t\t}\n   158\t\t\t\tif st.ppid != self {\n   159\t\t\t\t\tcontinue\n   160\t\t\t\t}\n   161\t\t\t\tchildren++\n   162\t\t\t\tif !st.zombie {\n   163\t\t\t\t\t// A pid is reported ended only once its signal was delivered\n   164\t\t\t\t\t// (review round 10, N3).\n   165\t\t\t\t\tif delivered, err := killPinnedChild(pid, self); err != nil {\n   166\t\t\t\t\t\tnote(err)\n   167\t\t\t\t\t} else if delivered {\n   168\t\t\t\t\t\tseen[pid] = true\n   169\t\t\t\t\t}\n   170\t\t\t\t}\n   171\t\t\t}\n   172\t\t\tfor {\n   173\t\t\t\tpid, err := unix.Wait4(-1, nil, unix.WNOHANG, nil)\n   174\t\t\t\tif pid <= 0 || err != nil {\n   175\t\t\t\t\tbreak\n   176\t\t\t\t}\n   177\t\t\t\t// A pid is reported ended once it was signalled and reaped\n   178\t\t\t\t// (review round 12, N2).\n   179\t\t\t\tif seen[pid] {\n   180\t\t\t\t\tdelete(seen, pid)\n   181\t\t\t\t\tended = append(ended, strconv.Itoa(pid))\n   182\t\t\t\t}\n   183\t\t\t}\n   184\t\t\tif children == 0 && len(problems) == 0 {\n   185\t\t\t\treturn ended, nil\n   186\t\t\t}\n   187\t\t\tif time.Now().After(deadline) {\n   188\t\t\t\treturn ended, fmt.Errorf(\"%d process(es) of the run could not be ended: %s\", children, strings.Join(problems, \"; \"))\n   189\t\t\t}\n   190\t\t\ttime.Sleep(20 * time.Millisecond)\n    48\t// them all. A full report stays far below the dispatcher's read bound.\n    49\tconst reviewShimReportMaxPids = 1000\n    50\t\n    51\t// boundedReviewShimReport encodes r within the dispatcher's read bound, so\n    52\t// the dispatcher always reads it whole (review round 9, N2).\n    53\tfunc boundedReviewShimReport(r reviewShimReport) []byte {\n    54\t\tr.EndedTotal = len(r.Ended)\n    55\t\tif len(r.Ended) > reviewShimReportMaxPids {\n    56\t\t\tr.Ended = r.Ended[:reviewShimReportMaxPids]\n    57\t\t}\n    58\t\tif len(r.Error) > 4096 {\n    59\t\t\tr.Error = r.Error[:4096]\n    60\t\t}\n    61\t\traw, _ := json.Marshal(r)\n    62\t\treturn raw\n    63\t}\n  1111\t\tif useShim && cmd.ProcessState != nil {\n  1112\t\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n  1113\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1114\t\t\t} else {\n  1115\t\t\t\tfor _, pid := range report.Ended {\n  1116\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1117\t\t\t\t}\n  1118\t\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n  1119\t\t\t\t\t// Counted from the total, not from the listed pids (review\n  1120\t\t\t\t\t// round 12, N3).\n  1121\t\t\t\t\tshimMore = more\n  1122\t\t\t\t}\n  1123\t\t\t\tif report.Error != \"\" {\n  1124\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1125\t\t\t\t\t// The shim's own words go into the record, not only the\n  1126\t\t\t\t\t// generic failure (review round 10, N3).\n  1127\t\t\t\t\tif safety != nil {\n  1128\t\t\t\t\t\tsafety.Limitations = append(safety.Limitations, \"the review run shim could not end the whole subtree: \"+report.Error)\n  1129\t\t\t\t\t}\n  1130\t\t\t\t}\n  1131\t\t\t}\n  1132\t\t}\n  1133\t\tif endedCount := len(reaped) + shimMore; endedCount > 0 && safety != nil {\n  1134\t\t\tlisted := strings.Join(reaped, \", \")\n  1135\t\t\tif shimMore > 0 {\n  1136\t\t\t\tlisted += fmt.Sprintf(\" and %d more (orphaned)\", shimMore)\n  1137\t\t\t}\n  1138\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(endedCount)+\" process(es) the run left running: \"+listed)\n  1139\t\t}\n  1140\t\tif opaque > 0 && reapErr == nil && safety != nil {\ncommit\n","exit_code":0,"status":"completed"}}
