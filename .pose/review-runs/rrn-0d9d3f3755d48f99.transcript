me.Time) (DelegatedReviewAttempt, error) {\n   423\t\tattempts, _, err := s.reviewAttemptAdmission(plan)\n   424\t\tif err != nil {\n   425\t\t\treturn DelegatedReviewAttempt{}, err\n   426\t\t}\n   427\t\tnonce := make([]byte, 16)\n   428\t\tif _, err := rand.Read(nonce); err != nil {\n   429\t\t\treturn DelegatedReviewAttempt{}, err\n   430\t\t}\n   431\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n   432\t\ta.AttemptID = attemptIdentity(a)\n   433\t\treturn a, nil\n   434\t}\n   435\t\n   436\t// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n   437\t// marks the attempt active first, so a dispatch that ends after this point\n   438\t// always leaves a marker that turns stalled and that `pose delegate cancel`\n   439\t// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n   440\t// review round 1, N1).\n   441\tfunc (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n   442\t\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n   443\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n   444\t\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n   445\t\t}\n   446\t\treturn nil\n   447\t}\n   448\tfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n   449\t\traw, _ := json.Marshal(run)\n   450\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n   451\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n   452\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n   453\t}\n   454\t\n   455\t// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n   456\t// exists for legacy records; their content identity remains independently checked.\n   457\tfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n   458\t\tbudget := int64(32 << 20)\n   459\t\treturn s.reviewRunLedgerFindings(bundle, &budget)\n   460\t}\n   461\tfunc (s Store) reviewRunLedgerFindings(bundle string, budget *int64) ([]string, error) {\n   462\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, reviewRunLedgerDir)\n   463\t\tif err != nil {\n   464\t\t\treturn nil, err\n   465\t\t}\n   466\t\tfindings := []string{}\n   467\t\tvar checkedBytes int64\n   468\t\tfor _, e := range entries {\n   469\t\t\tif IsPublisherStaging(e.Name()) {\n   470\t\t\t\tcontinue\n   471\t\t\t}\n   472\t\t\tvar w reviewRunWitness\n   473\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunLedgerDir, e.Name()), &w, budget); err != nil {\n   474\t\t\t\tfindings = append(findings, err.Error())\n   475\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   520\t\n   521\tfunc (b *reviewHistoryBuffer) Write(p []byte) (int, error) {\n   522\t\tif b.Len()+len(p) > 8<<20 {\n   523\t\t\treturn 0, fmt.Errorf(\"review history Git output exceeds 8 MiB\")\n   524\t\t}\n   525\t\treturn b.Buffer.Write(p)\n   526\t}\n   527\tfunc reviewHistoryGit(root string, args ...string) ([]byte, error) {\n   528\t\tctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)\n   529\t\tdefer cancel()\n   530\t\tbase := gitCommand(append([]string{\"-C\", root}, args...)...)\n   531\t\tcmd := exec.CommandContext(ctx, \"git\", base.Args[1:]...)\n   532\t\tcmd.Env = base.Env\n   533\t\tvar out reviewHistoryBuffer\n   534\t\tcmd.Stdout = &out\n   535\t\tif err := cmd.Run(); err != nil {\n   536\t\t\treturn nil, fmt.Errorf(\"review history Git observation unavailable: %w\", err)\n   537\t\t}\n   538\t\treturn out.Bytes(), nil\n   539\t}\n   540\t\n   541\t// ReviewRunHistoryFindings adds the Git anchor: edits and deletions of tracked\n   542\t// immutable evidence are violations even when staged or committed.\n   543\tfunc (s Store) ReviewRunHistoryFindings() ([]string, error) {\n   544\t\truns, losses, err := s.ReadReviewRuns(\"\")\n   545\t\tfindings := append(losses, s.reviewContinuationFindings(runs)...)\n   546\t\tif err != nil {\n   547\t\t\treturn nil, err\n   548\t\t}\n   549\t\troots := []string{reviewRunsDir, reviewRunLedgerDir, reviewAttemptDir, reviewContinuationsDir, reviewRunProofDir}\n   550\t\tif _, headErr := snapshotGit(s.Root, \"rev-parse\", \"--verify\", \"HEAD\"); headErr != nil {\n   551\t\t\t// An unborn repository without delegated data has no delegated history\n   552\t\t\t// contract to verify. Preserve the report-history gate's existing behavior.\n   553\t\t\tpresent := false\n   554\t\t\tfor _, root := range roots {\n   555\t\t\t\tif _, err := os.Lstat(filepath.Join(s.Root, root)); !os.IsNotExist(err) {\n   556\t\t\t\t\tpresent = true\n   557\t\t\t\t\tbreak\n   558\t\t\t\t}\n   559\t\t\t}\n   560\t\t\ttracked, trackedErr := reviewHistoryGit(s.Root, append([]string{\"ls-files\", \"--\"}, roots...)...)\n   561\t\t\tif !present && trackedErr == nil && len(bytes.TrimSpace(tracked)) == 0 {\n   562\t\t\t\treturn uniqueSorted(findings), nil\n   563\t\t\t}\n   564\t\t\treturn findings, fmt.Errorf(\"delegated history Git anchor unavailable: %w\", headErr)\n   565\t\t}\n   566\t\n   567\t\targs := append([]string{\"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\"}, roots...)\n   568\t\tpending, err := reviewHistoryGit(s.Root, args...)\n   569\t\tif err != nil {\n   570\t\t\treturn nil, err\n   571\t\t}\n   572\t\targs = append([]string{\"log\", \"--format=\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\"}, roots...)\n   573\t\tcommitted, err := reviewHistoryGit(s.Root, args...)\n   574\t\tif err != nil {\n   575\t\t\treturn nil, err\npose-mcp/internal/pose/bundle_fin