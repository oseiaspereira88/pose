{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/review_reap_test.go; nl -ba pose-mcp/internal/pose/review_reap_linux_test.go | sed -n '1,285p'; nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '1,130p'; nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '220,340p'; nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '400,490p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage cli\n     4\t\n     5\timport (\n     6\t\t\"os\"\n     7\t\t\"os/exec\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strconv\"\n    10\t\t\"strings\"\n    11\t\t\"syscall\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t\n    15\t\t\"github.com/harne8/pose-mcp/internal/pose\"\n    16\t)\n    17\t\n    18\t// Spec pose-review-run-reaps-lingering-reviewer-processes R1, R2, R4: a\n    19\t// reviewer that ends while a command it started in a session of its own is\n    20\t// still running leaves a run that completes, with that command ended before\n    21\t// the cleanup and named in the run record.\n    22\tfunc TestDispatchEndsWhatTheReviewerLeftRunning(t *testing.T) {\n    23\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n    24\t\t\tt.Skip(\"setsid is not available\")\n    25\t\t}\n    26\t\troot := dispatchInstance(t)\n    27\t\tpidFile := filepath.Join(t.TempDir(), \"leftover.pid\")\n    28\t\tscript := `cat >/dev/null; setsid sh -c 'echo $$ > \"` + pidFile + `\"; while :; do touch \"$TMPDIR/leftover\" 2>/dev/null; sleep 0.05; done' </dev/null >/dev/null 2>&1 & ` +\n    29\t\t\t`i=0; while [ ! -s \"` + pidFile + `\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`\n    30\t\twriteReviewers(t, root, map[string]pose.ReviewerAdapter{\"fake\": {Command: []string{\"sh\", \"-c\", script}, Vendor: \"fixture\", Model: \"fixture\", Containment: &pose.ReviewerContainment{SchemaVersion: 1, Profile: \"trusted-process\"}}})\n    31\t\tcode, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\")\n    32\t\traw, err := os.ReadFile(pidFile)\n    33\t\tif err != nil {\n    34\t\t\tt.Fatalf(\"the leftover never started: %v (%d %s)\", err, code, out)\n    35\t\t}\n    36\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n    37\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n    38\t\tdeadline := time.Now().Add(2 * time.Second)\n    39\t\tfor syscall.Kill(pid, 0) == nil && time.Now().Before(deadline) {\n    40\t\t\tif stat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\"); err == nil && strings.Contains(string(stat), \") Z \") {\n    41\t\t\t\tbreak\n    42\t\t\t}\n    43\t\t\ttime.Sleep(50 * time.Millisecond)\n    44\t\t}\n    45\t\tif stat, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\"); err == nil && !strings.Contains(string(stat), \") Z \") {\n    46\t\t\tt.Fatalf(\"the process the reviewer left running survived the run: %s\", stat)\n    47\t\t}\n    48\t\truns, _, _ := (pose.Store{Root: root}).ReadReviewRuns(\"\")\n    49\t\tif len(runs) != 1 {\n    50\t\t\tt.Fatalf(\"runs: %d (%d %s)\", len(runs), code, out)\n    51\t\t}\n    52\t\trun := runs[0]\n    53\t\tif run.Status != pose.ReviewRunCompleted || run.Safety == nil || run.Safety.Operation.Outcome != pose.OutcomeCompleted {\n    54\t\t\tt.Fatalf(\"the run did not complete with its cleanup: status=%s failure=%s safety=%+v\", run.Status, run.Failure, run.Safety)\n    55\t\t}\n    56\t\tif !strings.Contains(strings.Join(run.Safety.Limitations, \"\\n\"), \"process(es) the run left running\") {\n    57\t\t\tt.Fatalf(\"the run record does not name the ended process: %v\", run.Safety.Limitations)\n    58\t\t}\n    59\t}\n     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os\"\n     7\t\t\"os/exec\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strconv\"\n    10\t\t\"strings\"\n    11\t\t\"syscall\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\t// Review round 1, N3: a pid that no longer names a process of the run, as\n    17\t// after reuse by an unrelated process, is never signalled.\n    18\tfunc TestAPidThatLostTheRunsEntryIsNotKilled(t *testing.T) {\n    19\t\tother := exec.Command(\"sleep\", \"30\")\n    20\t\tif err := other.Start(); err != nil {\n    21\t\t\tt.Fatal(err)\n    22\t\t}\n    23\t\tfor i := 0; i < 200 && reviewProcessName(other.Process.Pid) != \"sleep\"; i++ {\n    24\t\t\ttime.Sleep(10 * time.Millisecond)\n    25\t\t}\n    26\t\tt.Cleanup(func() { _ = other.Process.Kill(); _ = other.Wait() })\n    27\t\tentry := []byte(SealedCheckoutEnv + \"=/nonexistent/run-checkout\")\n    28\t\tif err := killPinnedMarkedProcess(other.Process.Pid, entry); err != nil {\n    29\t\t\tt.Fatal(err)\n    30\t\t}\n    31\t\ttime.Sleep(100 * time.Millisecond)\n    32\t\tif zombie, err := reviewProcessZombie(other.Process.Pid); err != nil || zombie {\n    33\t\t\tt.Fatalf(\"a process without the run's entry was killed: zombie=%t %v\", zombie, err)\n    34\t\t}\n    35\t\t// The same process carrying the entry is ended.\n    36\t\tmarked := exec.Command(\"sleep\", \"30\")\n    37\t\tmarked.Env = append(marked.Environ(), string(entry))\n    38\t\tif err := marked.Start(); err != nil {\n    39\t\t\tt.Fatal(err)\n    40\t\t}\n    41\t\t// Until exec, /proc shows the parent's environment.\n    42\t\tfor i := 0; i < 200; i++ {\n    43\t\t\tif ok, _ := reviewProcessMarked(marked.Process.Pid, entry); ok {\n    44\t\t\t\tbreak\n    45\t\t\t}\n    46\t\t\ttime.Sleep(10 * time.Millisecond)\n    47\t\t}\n    48\t\tif err := killPinnedMarkedProcess(marked.Process.Pid, entry); err != nil {\n    49\t\t\tt.Fatal(err)\n    50\t\t}\n    51\t\tif err := marked.Wait(); err == nil {\n    52\t\t\tt.Fatal(\"the marked process was not ended\")\n    53\t\t}\n    54\t}\n    55\t\n    56\t// opaqueProcess starts a process of this user whose environment cannot be\n    57\t// read (it makes itself non-dumpable), or skips without python3.\n    58\tfunc opaqueProcess(t *testing.T) *exec.Cmd {\n    59\t\tt.Helper()\n    60\t\tif _, err := exec.LookPath(\"python3\"); err != nil {\n    61\t\t\tt.Skip(\"python3 is not available\")\n    62\t\t}\n    63\t\tcmd := exec.Command(\"python3\", \"-c\", \"import ctypes,time; ctypes.CDLL(None).prctl(4,0,0,0,0); time.sleep(30)\")\n    64\t\tif err := cmd.Start(); err != nil {\n    65\t\t\tt.Fatal(err)\n    66\t\t}\n    67\t\tt.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })\n    68\t\tfor i := 0; i < 300; i++ {\n    69\t\t\tif _, err := reviewProcessMarked(cmd.Process.Pid, []byte(\"x\")); err != nil && !reviewProcessGoneErr(err) {\n    70\t\t\t\treturn cmd\n    71\t\t\t}\n    72\t\t\ttime.Sleep(10 * time.Millisecond)\n    73\t\t}\n    74\t\tt.Skip(\"the process never became non-inspectable\")\n    75\t\treturn nil\n    76\t}\n    77\t\n    78\t// Review round 2, N2: a non-inspectable process that existed before the run\n    79\t// is not the run's; one that started during it may be, and the scan fails\n    80\t// instead of reporting the run's processes ended.\n    81\tfunc TestANonInspectableProcessStartedDuringTheRunFailsTheScan(t *testing.T) {\n    82\t\tbefore := opaqueProcess(t)\n    83\t\tbaseline := reviewOpaqueProcessBaseline()\n    84\t\tif _, ok := baseline[before.Process.Pid]; !ok {\n    85\t\t\tt.Fatalf(\"the baseline misses process %d\", before.Process.Pid)\n    86\t\t}\n    87\t\tif _, opaque, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err != nil || opaque == 0 {\n    88\t\t\tt.Fatalf(\"a process that predates the run failed the scan or was not counted: %d %v\", opaque, err)\n    89\t\t}\n    90\t\tduring := opaqueProcess(t)\n    91\t\tif _, _, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err == nil || !strings.Contains(err.Error(), \"started during the run\") {\n    92\t\t\tt.Fatalf(\"process %d, started during the run, did not fail the scan: %v\", during.Process.Pid, err)\n    93\t\t}\n    94\t}\n    95\t\n    96\t// Review round 6, N2: a descendant that leaves the group, starts its own\n    97\t// session and clears its environment is still ended with the run.\n    98\tfunc TestAnOrphanThatClearedItsEnvironmentIsEnded(t *testing.T) {\n    99\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   100\t\t\tt.Skip(\"setsid is not available\")\n   101\t\t}\n   102\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   103\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   104\t\t\ta.Containment = containmentPolicy()\n   105\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & ` +\n   106\t\t\t\t`i=0; while [ ! -s \"$1\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`, \"sh\", pidFile}\n   107\t\t})\n   108\t\traw, err := os.ReadFile(pidFile)\n   109\t\tif err != nil {\n   110\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   111\t\t}\n   112\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   113\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   114\t\tif zombie, err := reviewProcessZombie(pid); err == nil && !zombie {\n   115\t\t\tt.Fatalf(\"the orphan that cleared its environment survived the run (status %s: %s)\", f.run.Status, f.run.Failure)\n   116\t\t}\n   117\t\tif f.run.Status != ReviewRunCompleted || !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), \"(orphaned)\") {\n   118\t\t\tt.Fatalf(\"the run did not complete naming the orphan: %s %s %v\", f.run.Status, f.run.Failure, f.run.Safety.Limitations)\n   119\t\t}\n   120\t\t// Review round 9, N1: the recorded limitation describes the shim, not an\n   121\t\t// environment match.\n   122\t\tif !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), \"the review run shim ends every process left in the run's subtree\") {\n   123\t\t\tt.Fatalf(\"the limitation does not describe the shim: %v\", f.run.Safety.Limitations)\n   124\t\t}\n   125\t\t// Review round 7, N4: the record names the pid, never the process name\n   126\t\t// the reviewer chose.\n   127\t\tfor _, limit := range f.run.Safety.Limitations {\n   128\t\t\tif strings.Contains(limit, \"(orphaned)\") && strings.Contains(limit, \" sh \") {\n   129\t\t\t\tt.Fatalf(\"the recorded limitation carries a process name: %q\", limit)\n   130\t\t\t}\n   131\t\t}\n   132\t\tif !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), strconv.Itoa(pid)+\" (orphaned)\") {\n   133\t\t\tt.Fatalf(\"the recorded limitation does not name the pid: %v\", f.run.Safety.Limitations)\n   134\t\t}\n   135\t}\n   136\t\n   137\t// waitGone waits for pid to end (or be a zombie) and reports whether it did.\n   138\tfunc waitGone(pid int, within time.Duration) bool {\n   139\t\tdeadline := time.Now().Add(within)\n   140\t\tfor time.Now().Before(deadline) {\n   141\t\t\tif zombie, err := reviewProcessZombie(pid); err != nil || zombie {\n   142\t\t\t\treturn true\n   143\t\t\t}\n   144\t\t\ttime.Sleep(50 * time.Millisecond)\n   145\t\t}\n   146\t\treturn false\n   147\t}\n   148\t\n   149\t// Review round 8, N2: the shim's report never goes through a path the\n   150\t// reviewer can write, and the reviewer does not inherit the report pipe.\n   151\tfunc TestTheAdapterDoesNotInheritTheShimReport(t *testing.T) {\n   152\t\tfds := filepath.Join(t.TempDir(), \"fds\")\n   153\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   154\t\t\ta.Containment = containmentPolicy()\n   155\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; ls /proc/$$/fd > \"$1\"; env | grep -c POSE_REVIEW_SHIM_REPORT >> \"$1\"; ls \"$TMPDIR\" >> \"$1\"; printf 'decision: approved\\n'`, \"sh\", fds}\n   156\t\t})\n   157\t\traw, err := os.ReadFile(fds)\n   158\t\tif err != nil || f.run.Status != ReviewRunCompleted {\n   159\t\t\tt.Fatalf(\"the probe did not run: %v %s %s\", err, f.run.Status, f.run.Failure)\n   160\t\t}\n   161\t\tlines := strings.Fields(string(raw))\n   162\t\tfor _, l := range lines {\n   163\t\t\tif l == \"3\" || strings.Contains(l, \"shim-report\") {\n   164\t\t\t\tt.Fatalf(\"the adapter sees the shim's report (%q): %s\", l, raw)\n   165\t\t\t}\n   166\t\t}\n   167\t}\n   168\t\n   169\t// Review round 8, N3: a timeout asks the shim to end the run's subtree, so an\n   170\t// orphan that cleared its environment does not outlive it.\n   171\tfunc TestATimeoutEndsTheRunsOrphans(t *testing.T) {\n   172\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   173\t\t\tt.Skip(\"setsid is not available\")\n   174\t\t}\n   175\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   176\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   177\t\t\ta.Containment = containmentPolicy()\n   178\t\t\ta.Timeout = \"2s\"\n   179\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & sleep 30`, \"sh\", pidFile}\n   180\t\t})\n   181\t\traw, err := os.ReadFile(pidFile)\n   182\t\tif err != nil {\n   183\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   184\t\t}\n   185\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   186\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   187\t\tif !waitGone(pid, 2*time.Second) {\n   188\t\t\tt.Fatal(\"an orphan outlived the run's timeout\")\n   189\t\t}\n   190\t}\n   191\t\n   192\t// Review round 8, N4: when the dispatcher ends, the shim ends the run's\n   193\t// subtree instead of leaving the reviewer running behind a dead owner.\n   194\tfunc TestTheShimEndsTheRunWhenItsDispatcherEnds(t *testing.T) {\n   195\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   196\t\t\tt.Skip(\"setsid is not available\")\n   197\t\t}\n   198\t\tself, err := os.Executable()\n   199\t\tif err != nil {\n   200\t\t\tt.Fatal(err)\n   201\t\t}\n   202\t\tdir := t.TempDir()\n   203\t\torphanPid, shimPid := filepath.Join(dir, \"orphan.pid\"), filepath.Join(dir, \"shim.pid\")\n   204\t\tadapter := filepath.Join(dir, \"adapter.sh\")\n   205\t\tif err := os.WriteFile(adapter, []byte(\"#!/bin/sh\\nsetsid env -i /bin/sh -c 'echo $$ > \\\"$1\\\"; while :; do sleep 0.05; done' sh \\\"$1\\\" </dev/null >/dev/null 2>&1 &\\nsleep 30\\n\"), 0o755); err != nil {\n   206\t\t\tt.Fatal(err)\n   207\t\t}\n   208\t\t// A stand-in dispatcher starts the shim and ends once the run is going.\n   209\t\tscript := `export ` + ReviewShimReportEnv + `=$$; \"$1\" ` + ReviewShimArg + ` /bin/sh sh \"$4\" \"$2\" & echo $! > \"$3\"; ` +\n   210\t\t\t`i=0; while [ ! -s \"$2\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; exit 0`\n   211\t\t// No output pipe: waiting for one would wait for the shim that inherits it.\n   212\t\tdispatcher := exec.Command(\"sh\", \"-c\", script, \"sh\", self, orphanPid, shimPid, adapter)\n   213\t\tstarted := time.Now()\n   214\t\tif err := dispatcher.Run(); err != nil {\n   215\t\t\tt.Fatalf(\"the stand-in dispatcher failed: %v\", err)\n   216\t\t}\n   217\t\tif time.Since(started) > 10*time.Second {\n   218\t\t\tt.Fatal(\"the stand-in dispatcher waited for the run\")\n   219\t\t}\n   220\t\traw, err := os.ReadFile(orphanPid)\n   221\t\tif err != nil {\n   222\t\t\tt.Fatalf(\"the run never started: %v\", err)\n   223\t\t}\n   224\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   225\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   226\t\tif !waitGone(pid, 5*time.Second) {\n   227\t\t\tt.Fatal(\"the run outlived its dispatcher\")\n   228\t\t}\n   229\t}\n   230\t\n   231\t// Review round 11, N2: a child that already ended was not ended by the shim,\n   232\t// and killPinnedChild says so.\n   233\tfunc TestAChildThatAlreadyEndedIsNotReportedEnded(t *testing.T) {\n   234\t\tchild := exec.Command(\"true\")\n   235\t\tif err := child.Start(); err != nil {\n   236\t\t\tt.Fatal(err)\n   237\t\t}\n   238\t\tpid := child.Process.Pid\n   239\t\tfor i := 0; i < 200; i++ {\n   240\t\t\tif zombie, _ := reviewProcessZombie(pid); zombie {\n   241\t\t\t\tbreak\n   242\t\t\t}\n   243\t\t\ttime.Sleep(10 * time.Millisecond)\n   244\t\t}\n   245\t\tdelivered, err := killPinnedChild(pid, os.Getpid())\n   246\t\t_ = child.Wait()\n   247\t\tif err != nil || delivered {\n   248\t\t\tt.Fatalf(\"an ended child was reported as ended by the shim: delivered=%t %v\", delivered, err)\n   249\t\t}\n   250\t\tlive := exec.Command(\"sleep\", \"30\")\n   251\t\tif err := live.Start(); err != nil {\n   252\t\t\tt.Fatal(err)\n   253\t\t}\n   254\t\tdefer func() { _ = live.Process.Kill(); _ = live.Wait() }()\n   255\t\tif delivered, err := killPinnedChild(live.Process.Pid, os.Getpid()); err != nil || !delivered {\n   256\t\t\tt.Fatalf(\"a live child was not ended: delivered=%t %v\", delivered, err)\n   257\t\t}\n   258\t}\n     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"context\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"fmt\"\n    10\t\t\"os\"\n    11\t\t\"os/exec\"\n    12\t\t\"path/filepath\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"testing\"\n    16\t\t\"time\"\n    17\t)\n    18\t\n    19\t// Spec pose-review-run-reaps-lingering-reviewer-processes R5, R6: a dispatch\n    20\t// that ended between its reservation and its run record leaves an attempt\n    21\t// that blocks the bundle; once its owner is proven gone, cancel releases it\n    22\t// with a failed run and its receipt, and the ledger reads again.\n    23\tfunc TestAnAbandonedAttemptIsReleasedWithARecord(t *testing.T) {\n    24\t\troot := t.TempDir()\n    25\t\ts := Store{Root: root}\n    26\t\tbundle := \"rvb-00000000000000a1\"\n    27\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n    28\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"0\", 32)}\n    29\t\ta.AttemptID = attemptIdentity(a)\n    30\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    31\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    32\t\t\tt.Fatal(err)\n    33\t\t}\n    34\t\t// The ledger refuses the bundle while the reservation has no receipt.\n    35\t\tif _, err := s.readAttemptReceipt(a); err == nil || !strings.Contains(err.Error(), \"incomplete or unreadable\") {\n    36\t\t\tt.Fatalf(\"an unfinished reservation read as finished: %v\", err)\n    37\t\t}\n    38\t\n    39\t\t// The marker the interrupted dispatch left: its owner is a process that\n    40\t\t// has exited.\n    41\t\tdead := exec.Command(\"true\")\n    42\t\tif err := dead.Run(); err != nil {\n    43\t\t\tt.Fatal(err)\n    44\t\t}\n    45\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    46\t\towner.Host, _ = os.Hostname()\n    47\t\tidentifyStartLockProcess(&owner)\n    48\t\towner.PID = dead.Process.Pid\n    49\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"b\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: a.Scope, BundleID: bundle,\n    50\t\t\tStartedAt: a.ReservedAt, Owner: owner, HeartbeatAt: a.ReservedAt, HeartbeatEvery: 10}\n    51\t\tdir, err := s.delegationActiveDir(true)\n    52\t\tif err != nil {\n    53\t\t\tt.Fatal(err)\n    54\t\t}\n    55\t\traw, _ := json.Marshal(marker)\n    56\t\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), raw, 0o600); err != nil {\n    57\t\t\tt.Fatal(err)\n    58\t\t}\n    59\t\n    60\t\trun, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false)\n    61\t\tif err != nil {\n    62\t\t\tt.Fatal(err)\n    63\t\t}\n    64\t\tif run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"abandoned\") {\n    65\t\t\tt.Fatalf(\"the release recorded %s: %s\", run.Status, run.Failure)\n    66\t\t}\n    67\t\tif _, err := s.readAttemptReceipt(a); err != nil {\n    68\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n    69\t\t}\n    70\t\tif left, _ := filepath.Glob(filepath.Join(dir, a.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n    71\t\t\tt.Fatalf(\"the marker or its stall claim stayed: %v\", left)\n    72\t\t}\n    73\t\t// Released once: a second release finds nothing abandoned.\n    74\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n    75\t\t\tt.Fatalf(\"a released attempt was released again: %v\", err)\n    76\t\t}\n    77\t}\n    78\t\n    79\t// An attempt whose owner is alive is never released.\n    80\tfunc TestARunningAttemptIsNotReleased(t *testing.T) {\n    81\t\troot := t.TempDir()\n    82\t\ts := Store{Root: root}\n    83\t\tbundle := \"rvb-00000000000000a2\"\n    84\t\t// Silent for an hour, so only the owner's liveness keeps it running.\n    85\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n    86\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1, ReservedAt: old, Nonce: strings.Repeat(\"0\", 32)}\n    87\t\ta.AttemptID = attemptIdentity(a)\n    88\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    89\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    90\t\t\tt.Fatal(err)\n    91\t\t}\n    92\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    93\t\towner.Host, _ = os.Hostname()\n    94\t\tidentifyStartLockProcess(&owner)\n    95\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"d\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: bundle, StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n    96\t\tdir, _ := s.delegationActiveDir(true)\n    97\t\traw, _ := json.Marshal(marker)\n    98\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n    99\t\t\tt.Fatal(err)\n   100\t\t}\n   101\t\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n   102\t\t\tt.Fatalf(\"a running attempt was released: %v\", err)\n   103\t\t}\n   104\t}\n   105\t\n   106\t// Review round 1, N1: the dispatch marks the attempt active before it\n   107\t// publishes the reservation, so no instant leaves a reservation without a\n   108\t// marker that turns stalled.\n   109\tfunc TestTheAttemptIsMarkedActiveBeforeItIsReserved(t *testing.T) {\n   110\t\tvar checked bool\n   111\t\tbeforeAttemptPublished = func(store Store, a DelegatedReviewAttempt) {\n   112\t\t\tchecked = true\n   113\t\t\tmarkers, _, err := store.ListDelegationActive()\n   114\t\t\tfound := false\n   115\t\t\tfor _, m := range markers {\n   116\t\t\t\tfound = found || m.AttemptID == a.AttemptID\n   117\t\t\t}\n   118\t\t\tif err != nil || !found {\n   119\t\t\t\tt.Errorf(\"the reservation of %s is published with no active marker: %v\", a.AttemptID, err)\n   120\t\t\t}\n   121\t\t\tif _, err := os.Lstat(reviewAttemptPath(store.Root, a)); !errors.Is(err, os.ErrNotExist) {\n   122\t\t\t\tt.Errorf(\"the reservation was published before the marker: %v\", err)\n   123\t\t\t}\n   124\t\t}\n   125\t\tt.Cleanup(func() { beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {} })\n   126\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\")\n   127\t\tif !checked {\n   128\t\t\tt.Fatal(\"the dispatch never reached the reservation\")\n   129\t\t}\n   130\t}\n   220\t\tnext, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\")\n   221\t\tif err != nil {\n   222\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n   223\t\t}\n   224\t\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n   225\t\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n   226\t\t}\n   227\t}\n   228\t\n   229\t// Review rounds 2 and 5 (N3, N1): one release runs at a time, under a lock\n   230\t// the operating system releases when its holder ends.\n   231\tfunc TestOneReleaseRunsAtATime(t *testing.T) {\n   232\t\troot := t.TempDir()\n   233\t\ts := Store{Root: root}\n   234\t\tattempt := \"rat-\" + strings.Repeat(\"9\", 64)\n   235\t\tdir, _ := s.delegationActiveDir(true)\n   236\t\tlockPath := filepath.Join(dir, attempt+\".release.lock\")\n   237\t\theld, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0o600)\n   238\t\tif err != nil {\n   239\t\t\tt.Fatal(err)\n   240\t\t}\n   241\t\tunlock, err := lockSpecTransferFile(held)\n   242\t\tif err != nil {\n   243\t\t\tt.Fatal(err)\n   244\t\t}\n   245\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\n   246\t\t\tt.Fatalf(\"a release ran while another held the lock: %v\", err)\n   247\t\t}\n   248\t\tunlock()\n   249\t\theld.Close()\n   250\t\t// A holder that ends releases the lock with it: nothing is left to take over.\n   251\t\tif _, err := exec.LookPath(\"flock\"); err == nil {\n   252\t\t\tholder := exec.Command(\"flock\", lockPath, \"sleep\", \"30\")\n   253\t\t\tholder.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n   254\t\t\tif err := holder.Start(); err != nil {\n   255\t\t\t\tt.Fatal(err)\n   256\t\t\t}\n   257\t\t\ttime.Sleep(200 * time.Millisecond)\n   258\t\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err == nil || !strings.Contains(err.Error(), \"in progress\") {\n   259\t\t\t\tt.Fatalf(\"the other process's lock was not seen: %v\", err)\n   260\t\t\t}\n   261\t\t\t_ = syscall.Kill(-holder.Process.Pid, syscall.SIGKILL)\n   262\t\t\t_ = holder.Wait()\n   263\t\t}\n   264\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil && strings.Contains(err.Error(), \"in progress\") {\n   265\t\t\tt.Fatalf(\"an ended holder's lock still blocks the release: %v\", err)\n   266\t\t}\n   267\t}\n   268\t\n   269\t// Review round 3, N1: a release interrupted after it recorded the run, and\n   270\t// before the receipt, completes with that run instead of recording another.\n   271\tfunc TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n   272\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   273\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   274\t\tif err != nil {\n   275\t\t\tt.Fatal(err)\n   276\t\t}\n   277\t\tattempt := \"\"\n   278\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   279\t\tfunc() {\n   280\t\t\tdefer func() { _ = recover() }()\n   281\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   282\t\t}()\n   283\t\twriteDeadMarker(t, f.store, attempt)\n   284\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   285\t\tmarkerPath := filepath.Join(activeDir, attempt+\".json\")\n   286\t\tmarkerBytes, err := os.ReadFile(markerPath)\n   287\t\tif err != nil {\n   288\t\t\tt.Fatal(err)\n   289\t\t}\n   290\t\tfirst, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   291\t\tif err != nil {\n   292\t\t\tt.Fatal(err)\n   293\t\t}\n   294\t\t// Undo the receipt and keep the marker, as a release stopped between\n   295\t\t// the run and the receipt leaves them.\n   296\t\tattempts, _ := f.store.readDelegatedReviewAttempts(f.bundle.BundleID)\n   297\t\tfor _, a := range attempts {\n   298\t\t\tif a.AttemptID == attempt {\n   299\t\t\t\tif err := os.Remove(attemptReceiptPath(f.store.Root, a)); err != nil {\n   300\t\t\t\t\tt.Fatal(err)\n   301\t\t\t\t}\n   302\t\t\t}\n   303\t\t}\n   304\t\tif err := os.WriteFile(markerPath, markerBytes, 0o600); err != nil {\n   305\t\t\tt.Fatal(err)\n   306\t\t}\n   307\t\tsecond, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   308\t\tif err != nil || second.RunID != first.RunID {\n   309\t\t\tt.Fatalf(\"the interrupted release recorded another run: %s then %s (%v)\", first.RunID, second.RunID, err)\n   310\t\t}\n   311\t}\n   312\t\n   313\t// Review round 2, N1: a reservation an earlier engine left with no marker is\n   314\t// listed and released once it is old enough, never while it is young.\n   315\tfunc TestAMarkerlessReservationOfAnEarlierEngineIsReleased(t *testing.T) {\n   316\t\troot := t.TempDir()\n   317\t\ts := Store{Root: root}\n   318\t\treserve := func(age time.Duration, nonce string) DelegatedReviewAttempt {\n   319\t\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000b\" + nonce[:1], BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   320\t\t\t\tReservedAt: time.Now().Add(-age).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(nonce[:1], 32)}\n   321\t\t\ta.AttemptID = attemptIdentity(a)\n   322\t\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   323\t\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   324\t\t\t\tt.Fatal(err)\n   325\t\t\t}\n   326\t\t\treturn a\n   327\t\t}\n   328\t\told, young := reserve(time.Hour, \"1\"), reserve(time.Minute, \"2\")\n   329\t\tattempts, _, err := s.ListDelegationAttempts()\n   330\t\tif err != nil {\n   331\t\t\tt.Fatal(err)\n   332\t\t}\n   333\t\tlisted := map[string]DelegationAttempt{}\n   334\t\tfor _, a := range attempts {\n   335\t\t\tlisted[a.AttemptID] = a\n   336\t\t}\n   337\t\tif a, ok := listed[old.AttemptID]; !ok || a.State != DelegationStalled || !strings.Contains(a.Failure, \"pose delegate cancel \"+old.AttemptID+\" --confirm-abandoned\") {\n   338\t\t\tt.Fatalf(\"the old markerless reservation is not listed with its release: %+v\", attempts)\n   339\t\t}\n   340\t\tif _, ok := listed[young.AttemptID]; ok {\n   400\t\t}\n   401\t\tif err := os.WriteFile(filepath.Join(root, reviewRunsDir, \"rrn-0000000000000bad.json\"), []byte(\"{broken\"), 0o644); err != nil {\n   402\t\t\tt.Fatal(err)\n   403\t\t}\n   404\t\tif _, runLost, err := s.ReadReviewRuns(\"\"); err != nil || len(runLost) == 0 {\n   405\t\t\tt.Skipf(\"the fixture does not make the run history incomplete: %v %v\", runLost, err)\n   406\t\t}\n   407\t\torphans, lost, err := s.orphanReservations(time.Now())\n   408\t\tif err != nil || len(orphans) != 0 || !strings.Contains(strings.Join(lost, \"\\n\"), \"run history is incomplete\") {\n   409\t\t\tt.Fatalf(\"an incomplete history ruled a run out: %v %v %v\", orphans, lost, err)\n   410\t\t}\n   411\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n   412\t\t\tt.Fatal(\"a reservation was released over an incomplete run history\")\n   413\t\t}\n   414\t}\n   415\t\n   416\t// Review round 5, N3: a dispatch that recorded its run and stopped before\n   417\t// the receipt is completed with that run, not with a second one; N2: a\n   418\t// release that stopped after the receipt only removes the marker.\n   419\tfunc TestARecordedRunCompletesItsAttempt(t *testing.T) {\n   420\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   421\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"receipt lost\")\n   422\t\tif err != nil {\n   423\t\t\tt.Fatal(err)\n   424\t\t}\n   425\t\tsaved := beforeRunResultPublished\n   426\t\tt.Cleanup(func() { beforeRunResultPublished = saved })\n   427\t\trecorded := \"\"\n   428\t\tbeforeRunResultPublished = func(r ReviewRun) { recorded = r.RunID; panic(\"the dispatching process ends before the receipt\") }\n   429\t\tfunc() {\n   430\t\t\tdefer func() { _ = recover() }()\n   431\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   432\t\t}()\n   433\t\tbeforeRunResultPublished = saved\n   434\t\truns, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID)\n   435\t\tif recorded == \"\" || len(runs) == 0 {\n   436\t\t\tt.Fatalf(\"the dispatch recorded no run: %q %d\", recorded, len(runs))\n   437\t\t}\n   438\t\tattempt := runs[len(runs)-1].AttemptID\n   439\t\twriteDeadMarker(t, f.store, attempt)\n   440\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   441\t\tmarkerBytes, _ := os.ReadFile(filepath.Join(activeDir, attempt+\".json\"))\n   442\t\treleased, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   443\t\tif err != nil || released.RunID != recorded {\n   444\t\t\tt.Fatalf(\"the release did not complete with the recorded run %s: %s %v\", recorded, released.RunID, err)\n   445\t\t}\n   446\t\tif after, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID); len(after) != len(runs) {\n   447\t\t\tt.Fatalf(\"the release recorded another run: %d then %d\", len(runs), len(after))\n   448\t\t}\n   449\t\t// The marker comes back, as a release stopped after the receipt leaves it.\n   450\t\tif err := os.WriteFile(filepath.Join(activeDir, attempt+\".json\"), markerBytes, 0o600); err != nil {\n   451\t\t\tt.Fatal(err)\n   452\t\t}\n   453\t\tagain, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   454\t\tif err != nil || again.RunID != recorded {\n   455\t\t\tt.Fatalf(\"a release after the receipt did not complete: %s %v\", again.RunID, err)\n   456\t\t}\n   457\t\tif left, _ := filepath.Glob(filepath.Join(activeDir, attempt+\".json\")); len(left) != 0 {\n   458\t\t\tt.Fatal(\"the stalled marker stayed after the receipt\")\n   459\t\t}\n   460\t}\n   461\t\n   462\t// Review round 6, N1: an unreadable active marker may be a live attempt's,\n   463\t// so no reservation is taken as markerless.\n   464\tfunc TestAnUnreadableMarkerRulesNothingOut(t *testing.T) {\n   465\t\troot := t.TempDir()\n   466\t\ts := Store{Root: root}\n   467\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000d1\", BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   468\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"4\", 32)}\n   469\t\ta.AttemptID = attemptIdentity(a)\n   470\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   471\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   472\t\t\tt.Fatal(err)\n   473\t\t}\n   474\t\tdir, _ := s.delegationActiveDir(true)\n   475\t\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), []byte(\"{damaged\"), 0o600); err != nil {\n   476\t\t\tt.Fatal(err)\n   477\t\t}\n   478\t\torphans, lost, err := s.orphanReservations(time.Now())\n   479\t\tif err != nil || len(orphans) != 0 || !strings.Contains(strings.Join(lost, \"\\n\"), \"active marker is unreadable\") {\n   480\t\t\tt.Fatalf(\"an unreadable marker let a reservation pass as markerless: %v %v %v\", orphans, lost, err)\n   481\t\t}\n   482\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n   483\t\t\tt.Fatal(\"a reservation with an unreadable marker was released\")\n   484\t\t}\n   485\t}\n   486\t\n   487\t// Review round 10, N2: a directory listing of the orphan scan is bounded and\n   488\t// says when it was cut.\n   489\tfunc TestTheOrphanScanListsBoundedDirectories(t *testing.T) {\n   490\t\tdir := t.TempDir()\n","exit_code":0,"status":"completed"}}
