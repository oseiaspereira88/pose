d, err.Error())\n  1252\t\t}\n  1253\t\tif !reflect.DeepEqual(diskBefore, diskAfter) {\n  1254\t\t\tchanged := []string{}\n  1255\t\t\tfor path, digest := range diskBefore {\n  1256\t\t\t\tif diskAfter[path] != digest {\n  1257\t\t\t\t\tchanged = append(changed, path)\n  1258\t\t\t\t}\n  1259\t\t\t}\n  1260\t\t\tfor path := range diskAfter {\n  1261\t\t\t\tif _, exists := diskBefore[path]; !exists {\n  1262\t\t\t\t\tchanged = append(changed, path)\n  1263\t\t\t\t}\n  1264\t\t\t}\n  1265\t\t\tsort.Strings(changed)\n  1266\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"the run changed files in the sealed worktree (including ignored materialization): %q\", changed))\n  1267\t\t}\n  1268\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n  1269\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1270\t\t}\n  1271\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n  1272\t\t\treturn finish(ReviewRunFailed, \"origin or policy changed: \"+err.Error())\n  1273\t\t}\n  1274\t\n  1275\t\tevents := run.eventsBytes\n  1276\t\tif run.Kind == ReviewBriefKindReview {\n  1277\t\t\t// The round and the draft's account of it are judged when the run\n  1278\t\t\t// completes, against the rounds before it (R1, R4).\n  1279\t\t\tround, err := s.ReviewRoundOf(plan.Bundle)\n  1280\t\t\tif err != nil {\n  1281\t\t\t\treturn finish(ReviewRunFailed, \"the round of the bundle cannot be derived: \"+err.Error())\n  1282\t\t\t}\n  1283\t\t\trun.Round, run.DraftProblems = round.Number, ValidateRoundDraft(round, run.Output)\n  1284\t\t}\n  1285\t\tpublished, err := finish(ReviewRunCompleted, \"\")\n  1286\t\tif err != nil {\n  1287\t\t\treturn published, err\n  1288\t\t}\n  1289\t\tif why := s.checkDispatchOrigin(plan); why != nil {\n  1290\t\t\tlate := published\n  1291\t\t\tlate.RunID, late.Path, late.TranscriptDigest, late.TranscriptPath = \"\", \"\", \"\", \"\"\n  1292\t\t\tlate.Status, late.Failure, late.Supersedes = ReviewRunFailed, why.Error(), published.RunID\n  1293\t\t\tlate.eventsBytes = events\n  1294\t\t\tlate.EndedAt = now().UTC().Format(time.RFC3339Nano)\n  1295\t\t\treturn s.recordReviewRun(late, transcript)\n  1296\t\t}\n  1297\t\treturn published, nil\n  1298\t}\n  1299\t\n  1300\t// Materialize only empty vendor staging directories in the disposable checkout,\n  1301\t// before its integrity snapshot. Files created there remain visible as mutations.\n  1302\t// The source repository and the legacy read profile are untouched.\n  1303\tfunc prepareClaudeReviewStaging(runtime *os.Root, components []ReviewPlanComponent) error {\n  1304\t\troot, err := runtime.OpenRoot(\"worktree\")\n  1305\t\tif err != nil {\n  1306\t\t\treturn err\n  1307\t\t}\n  1308\t\tdefer root.Close()\n  1309\t\tpaths := []string{\".\"}\n  1310\t\tfor _, component := range components {\n  1311\t\t\tif !filepath.IsLocal(component.Path) {\n  1312\t\t\t\treturn fmt.Errorf(\"review staging component is not confined\")\n  1313\t\t\t}\n  1314\t\t\tpaths = append(paths, component.Path)\n  1315\t\t}\n  1316\t\tfor _, path := range paths {\n  1317\t\t\tif err := root.MkdirAll(filepath.Join(path, \".claude\", \".cc-writes\"), 0o700); err != nil {\n  1318\t\t\t\treturn err\n  1319\t\t\t}\n  1320\t\t}\n  1321\t\treturn nil\n  1322\t}\n  1323\t\n  1324\t// The adapter has no authenticated producer/output declaration. Until such a\n  1325\t// declaration exists, a directory name cannot authorize regenerated evidence.\n  1326\tfunc verifyDispatchWorktree(root, commit string) error {\n  1327\t\treturn verifyDispatchWorktreeFor(root, commit, nil)\n  1328\t}\n  1329\tfunc verifyDispatchWorktreeFor(root, commit string, submodules map[string]bool) error {\n  1330\t\thead, err := snapshotGit(root, \"rev-parse\", \"--verify\", \"HEAD\")\n  1331\t\tif err != nil {\n  1332\t\t\treturn err\n  1333\t\t}\n  1334\t\tif strings.TrimSpace(string(head)) != commit {\n  1335\t\t\treturn fmt.Errorf(\"the run moved the worktree off the sealed commit\")\n  1336\t\t}\n  1337\t\tpaths, err := WorktreeDivergenceFor(root, commit, nil, func(p string) bool { return submodules == nil || submodules[p] })\n  1338\t\tif err != nil {\n  1339\t\t\treturn err\n  1340\t\t}\n  1341\t\n  1342\t\tif len(paths) > 0 {\n  1343\t\t\treturn fmt.Errorf(\"the run changed files in the sealed worktree: %q\", paths)\n  1344\t\t}\n  1345\t\treturn nil\n  1346\t}\n  1347\t\n  1348\tfunc (s Store) checkDispatchOrigin(plan DispatchPlan) error {\n  1349\t\torigin, err := dispatchWorktreeIdentity(s.Root)\n  1350\t\tif err != nil {\n  1351\t\t\treturn err\n  1352\t\t}\n  1353\t\tif plan.OriginWorktree == \"\" || origin != plan.OriginWorktree {\n  1354\t\t\treturn fmt.Errorf(\"dispatch origin conflict: worktree identity changed\")\n  1355\t\t}\n  1356\t\tif _, err := dispatchRegularInputPath(s.Root, s.activeDelegationPolicyPath()); err != nil {\n  1357\t\t\treturn err\n  1358\t\t}\n  1359\t\tpolicy, found, err := s.LoadReviewersPolicyFor(plan.Brief.Kind)\n  1360\t\tif err != nil {\n  1361\t\t\treturn fmt.Errorf(\"dispatch adapter policy unavailable: %w\", err)\n  1362\t\t}\n  1363\t\tif !found || !reflect.DeepEqual(policy.Adapters[plan.Adapter], plan.Config) {\n  1364\t\t\treturn fmt.Errorf(\"dispatch origin stale: reviewer adapter policy changed\")\n  1365\t\t}\n  1366\t\tif plan.SealedCommit != plan.Bundle.Payload.Subject.Head || plan.Brief.BundleID != plan.Bundle.BundleID || plan.Brief.BundleDigest != plan.Bundle.BundleDigest {\n  1367\t\t\treturn fmt.Errorf(\"dispatch input conflict: plan does not identify its sealed bundle\")\n  1368\t\t}\n  1369\t\t// A handoff brief is the generated brief followed by its section; the\n  1370\t\t// generated part keeps its own digest (spec pose-delegation-handoff R4).\n  1371\t\ttext := plan.Brief.Text\n  1372\t\tif plan.handoff {\n  1373\t\t\tgenerated, ok := strings.CutSuffix(text, plan.handoffSection)\n  1374\t\t\tif !ok || plan.handoffSection == \"\" {\n  1375\t\t\t\treturn fmt.Errorf(\"dispatch input conflict: handoff section changed\")\n  1376\t\t\t}\n  1377\t\t\ttext = generated\n  1378\t\t}\n  1379\t\tbody, ok := strings.CutSuffix(text, \"\\n<!-- brief-digest: \"+plan.Brief.Digest+\" -->\\n\")\n  1380\t\tif !ok || digestBytes([]byte(body)) != plan.Brief.Digest {\n  1381\t\t\treturn fmt.Errorf(\"dispatch input conflict: brief digest changed\")\n  1382\t\t}\n  1383\t\tif _, err := snapshotGit(s.Root, \"rev-parse\", \"--verify\", \"HEAD\"); err != nil {\n  1384\t\t\treturn err\n  1385\t\t}\n  1386\t\tif _, err := gitChangedPaths(s.Root); err != nil {\n  1387\t\t\treturn err\n  1388\t\t}\n  1389\t\tdigest, err := reviewBundlePayloadDigest(plan.Bundle.Payload)\n  1390\t\tif err != nil || digest != plan.Bundle.BundleDigest {\n","exit_code":0,"status":"completed"}}
