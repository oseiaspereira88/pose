= DispatchPlan{predecessor: prior, notes: prior.BriefNotes, Reason: prior.Reason, PolicyDigest: prior.PolicyDigest, OriginWorktree: origin, Adapter: prior.Adapter, Config: config, Brief: brief, Bundle: bundle, SealedCommit: prior.SealedCommit}\n   409\t\tcontinuationRound(&plan, *prior, false)\n   410\t\tif e = s.checkDispatchOrigin(plan); e != nil {\n","exit_code":0,"status":"completed"}}
