{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '1,240p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"context\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"fmt\"\n    10\t\t\"os\"\n    11\t\t\"os/exec\"\n    12\t\t\"path/filepath\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"testing\"\n    16\t\t\"time\"\n    17\t)\n    18\t\n    19\t// Spec pose-review-run-reaps-lingering-reviewer-processes R5, R6: a dispatch\n    20\t// that ended between its reservation and its run record leaves an attempt\n    21\t// that blocks the bundle; once its owner is proven gone, cancel releases it\n    22\t// with a failed run and its receipt, and the ledger reads again.\n    23\tfunc TestAnAbandonedAttemptIsReleasedWithARecord(t *testing.T) {\n    24\t\troot := t.TempDir()\n    25\t\ts := Store{Root: root}\n    26\t\tbundle := \"rvb-00000000000000a1\"\n    27\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n    28\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"0\", 32)}\n    29\t\ta.AttemptID = attemptIdentity(a)\n    30\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    31\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    32\t\t\tt.Fatal(err)\n    33\t\t}\n    34\t\t// The ledger refuses the bundle while the reservation has no receipt.\n    35\t\tif _, err := s.readAttemptReceipt(a); err == nil || !strings.Contains(err.Error(), \"incomplete or unreadable\") {\n    36\t\t\tt.Fatalf(\"an unfinished reservation read as finished: %v\", err)\n    37\t\t}\n    38\t\n    39\t\t// The marker the interrupted dispatch left: its owner is a process that\n    40\t\t// has exited.\n    41\t\tdead := exec.Command(\"true\")\n    42\t\tif err := dead.Run(); err != nil {\n    43\t\t\tt.Fatal(err)\n    44\t\t}\n    45\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    46\t\towner.Host, _ = os.Hostname()\n    47\t\tidentifyStartLockProcess(&owner)\n    48\t\towner.PID = dead.Process.Pid\n    49\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"b\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: a.Scope, BundleID: bundle,\n    50\t\t\tStartedAt: a.ReservedAt, Owner: owner, HeartbeatAt: a.ReservedAt, HeartbeatEvery: 10}\n    51\t\tdir, err := s.delegationActiveDir(true)\n    52\t\tif err != nil {\n    53\t\t\tt.Fatal(err)\n    54\t\t}\n    55\t\traw, _ := json.Marshal(marker)\n    56\t\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), raw, 0o600); err != nil {\n    57\t\t\tt.Fatal(err)\n    58\t\t}\n    59\t\n    60\t\trun, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false)\n    61\t\tif err != nil {\n    62\t\t\tt.Fatal(err)\n    63\t\t}\n    64\t\tif run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"abandoned\") {\n    65\t\t\tt.Fatalf(\"the release recorded %s: %s\", run.Status, run.Failure)\n    66\t\t}\n    67\t\tif _, err := s.readAttemptReceipt(a); err != nil {\n    68\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n    69\t\t}\n    70\t\tif left, _ := filepath.Glob(filepath.Join(dir, a.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n    71\t\t\tt.Fatalf(\"the marker or its stall claim stayed: %v\", left)\n    72\t\t}\n    73\t\t// Released once: a second release finds nothing abandoned.\n    74\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n    75\t\t\tt.Fatalf(\"a released attempt was released again: %v\", err)\n    76\t\t}\n    77\t}\n    78\t\n    79\t// An attempt whose owner is alive is never released.\n    80\tfunc TestARunningAttemptIsNotReleased(t *testing.T) {\n    81\t\troot := t.TempDir()\n    82\t\ts := Store{Root: root}\n    83\t\tbundle := \"rvb-00000000000000a2\"\n    84\t\t// Silent for an hour, so only the owner's liveness keeps it running.\n    85\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n    86\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1, ReservedAt: old, Nonce: strings.Repeat(\"0\", 32)}\n    87\t\ta.AttemptID = attemptIdentity(a)\n    88\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    89\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    90\t\t\tt.Fatal(err)\n    91\t\t}\n    92\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    93\t\towner.Host, _ = os.Hostname()\n    94\t\tidentifyStartLockProcess(&owner)\n    95\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"d\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: bundle, StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n    96\t\tdir, _ := s.delegationActiveDir(true)\n    97\t\traw, _ := json.Marshal(marker)\n    98\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n    99\t\t\tt.Fatal(err)\n   100\t\t}\n   101\t\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n   102\t\t\tt.Fatalf(\"a running attempt was released: %v\", err)\n   103\t\t}\n   104\t}\n   105\t\n   106\t// Review round 1, N1: the dispatch marks the attempt active before it\n   107\t// publishes the reservation, so no instant leaves a reservation without a\n   108\t// marker that turns stalled.\n   109\tfunc TestTheAttemptIsMarkedActiveBeforeItIsReserved(t *testing.T) {\n   110\t\tvar checked bool\n   111\t\tbeforeAttemptPublished = func(store Store, a DelegatedReviewAttempt) {\n   112\t\t\tchecked = true\n   113\t\t\tmarkers, _, err := store.ListDelegationActive()\n   114\t\t\tfound := false\n   115\t\t\tfor _, m := range markers {\n   116\t\t\t\tfound = found || m.AttemptID == a.AttemptID\n   117\t\t\t}\n   118\t\t\tif err != nil || !found {\n   119\t\t\t\tt.Errorf(\"the reservation of %s is published with no active marker: %v\", a.AttemptID, err)\n   120\t\t\t}\n   121\t\t\tif _, err := os.Lstat(reviewAttemptPath(store.Root, a)); !errors.Is(err, os.ErrNotExist) {\n   122\t\t\t\tt.Errorf(\"the reservation was published before the marker: %v\", err)\n   123\t\t\t}\n   124\t\t}\n   125\t\tt.Cleanup(func() { beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {} })\n   126\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\")\n   127\t\tif !checked {\n   128\t\t\tt.Fatal(\"the dispatch never reached the reservation\")\n   129\t\t}\n   130\t}\n   131\t\n   132\t// A marker whose dispatch ended before publishing the reservation is removed\n   133\t// by the release; ls names the cause and the release command (N2).\n   134\tfunc TestAStalledMarkerWithoutReservationIsListedAndRemoved(t *testing.T) {\n   135\t\troot := t.TempDir()\n   136\t\ts := Store{Root: root}\n   137\t\tdead := exec.Command(\"true\")\n   138\t\tif err := dead.Run(); err != nil {\n   139\t\t\tt.Fatal(err)\n   140\t\t}\n   141\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:x\", Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n   142\t\towner.Host, _ = os.Hostname()\n   143\t\tidentifyStartLockProcess(&owner)\n   144\t\towner.PID = dead.Process.Pid\n   145\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   146\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: \"rat-\" + strings.Repeat(\"e\", 64), RunToken: strings.Repeat(\"f\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: \"rvb-00000000000000a3\", StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n   147\t\tdir, _ := s.delegationActiveDir(true)\n   148\t\traw, _ := json.Marshal(marker)\n   149\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n   150\t\t\tt.Fatal(err)\n   151\t\t}\n   152\t\tattempts, _, err := s.ListDelegationAttempts()\n   153\t\tif err != nil || len(attempts) != 1 || attempts[0].State != DelegationStalled || !strings.Contains(attempts[0].Failure, DelegationAbandonedCause) || !strings.Contains(attempts[0].Failure, \"pose delegate cancel \"+marker.AttemptID) {\n   154\t\t\tt.Fatalf(\"the abandoned attempt is not listed with its cause: %+v %v\", attempts, err)\n   155\t\t}\n   156\t\trun, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false)\n   157\t\tif err != nil || run.RunID != \"\" {\n   158\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   159\t\t}\n   160\t\tif left, _ := filepath.Glob(filepath.Join(dir, marker.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n   161\t\t\tt.Fatalf(\"the marker stayed: %v\", left)\n   162\t\t}\n   163\t}\n   164\t\n   165\t// writeDeadMarker rewrites the marker of attempt so its owner is a process\n   166\t// that has exited and its heartbeat is an hour old, as a dispatch killed\n   167\t// mid-run leaves it.\n   168\tfunc writeDeadMarker(t *testing.T, s Store, attempt string) {\n   169\t\tt.Helper()\n   170\t\tdir, err := s.delegationActiveDir(false)\n   171\t\tif err != nil {\n   172\t\t\tt.Fatal(err)\n   173\t\t}\n   174\t\tpath := filepath.Join(dir, attempt+\".json\")\n   175\t\traw, err := os.ReadFile(path)\n   176\t\tif err != nil {\n   177\t\t\tt.Fatal(err)\n   178\t\t}\n   179\t\tvar marker DelegationActiveRun\n   180\t\tif err := json.Unmarshal(raw, &marker); err != nil {\n   181\t\t\tt.Fatal(err)\n   182\t\t}\n   183\t\tdead := exec.Command(\"true\")\n   184\t\tif err := dead.Run(); err != nil {\n   185\t\t\tt.Fatal(err)\n   186\t\t}\n   187\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n   188\t\tmarker.Owner.PID, marker.HeartbeatAt, marker.StartedAt = dead.Process.Pid, old, old\n   189\t\traw, _ = json.Marshal(marker)\n   190\t\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n   191\t\t\tt.Fatal(err)\n   192\t\t}\n   193\t}\n   194\t\n   195\t// Review round 2, N4 (R6): a real dispatch interrupted after its reservation\n   196\t// and before its run record blocks the next dispatch; once released, the\n   197\t// next dispatch runs.\n   198\tfunc TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns(t *testing.T) {\n   199\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   200\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   201\t\tif err != nil {\n   202\t\t\tt.Fatal(err)\n   203\t\t}\n   204\t\tattempt := \"\"\n   205\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   206\t\tfunc() {\n   207\t\t\tdefer func() { _ = recover() }()\n   208\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   209\t\t}()\n   210\t\tif attempt == \"\" {\n   211\t\t\tt.Fatal(\"the dispatch never reached its start\")\n   212\t\t}\n   213\t\twriteDeadMarker(t, f.store, attempt)\n   214\t\tif _, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after interruption\"); err == nil || !strings.Contains(err.Error(), \"pose delegate cancel \"+attempt) {\n   215\t\t\tt.Fatalf(\"the interrupted attempt did not block the bundle with its release command: %v\", err)\n   216\t\t}\n   217\t\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil {\n   218\t\t\tt.Fatal(err)\n   219\t\t}\n   220\t\tnext, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\")\n   221\t\tif err != nil {\n   222\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n   223\t\t}\n   224\t\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n   225\t\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n   226\t\t}\n   227\t}\n   228\t\n   229\t// Review rounds 2 and 5 (N3, N1): one release runs at a time, under a lock\n   230\t// the operating system releases when its holder ends.\n   231\tfunc TestOneReleaseRunsAtATime(t *testing.T) {\n   232\t\troot := t.TempDir()\n   233\t\ts := Store{Root: root}\n   234\t\tattempt := \"rat-\" + strings.Repeat(\"9\", 64)\n   235\t\tdir, _ := s.delegationActiveDir(true)\n   236\t\tlockPath := filepath.Join(dir, attempt+\".release.lock\")\n   237\t\theld, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0o600)\n   238\t\tif err != nil {\n   239\t\t\tt.Fatal(err)\n   240\t\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux_test.go | sed -n '1,260p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os\"\n     7\t\t\"os/exec\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strconv\"\n    10\t\t\"strings\"\n    11\t\t\"syscall\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\t// Review round 1, N3: a pid that no longer names a process of the run, as\n    17\t// after reuse by an unrelated process, is never signalled.\n    18\tfunc TestAPidThatLostTheRunsEntryIsNotKilled(t *testing.T) {\n    19\t\tother := exec.Command(\"sleep\", \"30\")\n    20\t\tif err := other.Start(); err != nil {\n    21\t\t\tt.Fatal(err)\n    22\t\t}\n    23\t\tfor i := 0; i < 200 && reviewProcessName(other.Process.Pid) != \"sleep\"; i++ {\n    24\t\t\ttime.Sleep(10 * time.Millisecond)\n    25\t\t}\n    26\t\tt.Cleanup(func() { _ = other.Process.Kill(); _ = other.Wait() })\n    27\t\tentry := []byte(SealedCheckoutEnv + \"=/nonexistent/run-checkout\")\n    28\t\tif err := killPinnedMarkedProcess(other.Process.Pid, entry); err != nil {\n    29\t\t\tt.Fatal(err)\n    30\t\t}\n    31\t\ttime.Sleep(100 * time.Millisecond)\n    32\t\tif zombie, err := reviewProcessZombie(other.Process.Pid); err != nil || zombie {\n    33\t\t\tt.Fatalf(\"a process without the run's entry was killed: zombie=%t %v\", zombie, err)\n    34\t\t}\n    35\t\t// The same process carrying the entry is ended.\n    36\t\tmarked := exec.Command(\"sleep\", \"30\")\n    37\t\tmarked.Env = append(marked.Environ(), string(entry))\n    38\t\tif err := marked.Start(); err != nil {\n    39\t\t\tt.Fatal(err)\n    40\t\t}\n    41\t\t// Until exec, /proc shows the parent's environment.\n    42\t\tfor i := 0; i < 200; i++ {\n    43\t\t\tif ok, _ := reviewProcessMarked(marked.Process.Pid, entry); ok {\n    44\t\t\t\tbreak\n    45\t\t\t}\n    46\t\t\ttime.Sleep(10 * time.Millisecond)\n    47\t\t}\n    48\t\tif err := killPinnedMarkedProcess(marked.Process.Pid, entry); err != nil {\n    49\t\t\tt.Fatal(err)\n    50\t\t}\n    51\t\tif err := marked.Wait(); err == nil {\n    52\t\t\tt.Fatal(\"the marked process was not ended\")\n    53\t\t}\n    54\t}\n    55\t\n    56\t// opaqueProcess starts a process of this user whose environment cannot be\n    57\t// read (it makes itself non-dumpable), or skips without python3.\n    58\tfunc opaqueProcess(t *testing.T) *exec.Cmd {\n    59\t\tt.Helper()\n    60\t\tif _, err := exec.LookPath(\"python3\"); err != nil {\n    61\t\t\tt.Skip(\"python3 is not available\")\n    62\t\t}\n    63\t\tcmd := exec.Command(\"python3\", \"-c\", \"import ctypes,time; ctypes.CDLL(None).prctl(4,0,0,0,0); time.sleep(30)\")\n    64\t\tif err := cmd.Start(); err != nil {\n    65\t\t\tt.Fatal(err)\n    66\t\t}\n    67\t\tt.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })\n    68\t\tfor i := 0; i < 300; i++ {\n    69\t\t\tif _, err := reviewProcessMarked(cmd.Process.Pid, []byte(\"x\")); err != nil && !reviewProcessGoneErr(err) {\n    70\t\t\t\treturn cmd\n    71\t\t\t}\n    72\t\t\ttime.Sleep(10 * time.Millisecond)\n    73\t\t}\n    74\t\tt.Skip(\"the process never became non-inspectable\")\n    75\t\treturn nil\n    76\t}\n    77\t\n    78\t// Review round 2, N2: a non-inspectable process that existed before the run\n    79\t// is not the run's; one that started during it may be, and the scan fails\n    80\t// instead of reporting the run's processes ended.\n    81\tfunc TestANonInspectableProcessStartedDuringTheRunFailsTheScan(t *testing.T) {\n    82\t\tbefore := opaqueProcess(t)\n    83\t\tbaseline := reviewOpaqueProcessBaseline()\n    84\t\tif _, ok := baseline[before.Process.Pid]; !ok {\n    85\t\t\tt.Fatalf(\"the baseline misses process %d\", before.Process.Pid)\n    86\t\t}\n    87\t\tif _, opaque, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err != nil || opaque == 0 {\n    88\t\t\tt.Fatalf(\"a process that predates the run failed the scan or was not counted: %d %v\", opaque, err)\n    89\t\t}\n    90\t\tduring := opaqueProcess(t)\n    91\t\tif _, _, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err == nil || !strings.Contains(err.Error(), \"started during the run\") {\n    92\t\t\tt.Fatalf(\"process %d, started during the run, did not fail the scan: %v\", during.Process.Pid, err)\n    93\t\t}\n    94\t}\n    95\t\n    96\t// Review round 6, N2: a descendant that leaves the group, starts its own\n    97\t// session and clears its environment is still ended with the run.\n    98\tfunc TestAnOrphanThatClearedItsEnvironmentIsEnded(t *testing.T) {\n    99\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   100\t\t\tt.Skip(\"setsid is not available\")\n   101\t\t}\n   102\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   103\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   104\t\t\ta.Containment = containmentPolicy()\n   105\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & ` +\n   106\t\t\t\t`i=0; while [ ! -s \"$1\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`, \"sh\", pidFile}\n   107\t\t})\n   108\t\traw, err := os.ReadFile(pidFile)\n   109\t\tif err != nil {\n   110\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   111\t\t}\n   112\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   113\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   114\t\tif zombie, err := reviewProcessZombie(pid); err == nil && !zombie {\n   115\t\t\tt.Fatalf(\"the orphan that cleared its environment survived the run (status %s: %s)\", f.run.Status, f.run.Failure)\n   116\t\t}\n   117\t\tif f.run.Status != ReviewRunCompleted || !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), \"(orphaned)\") {\n   118\t\t\tt.Fatalf(\"the run did not complete naming the orphan: %s %s %v\", f.run.Status, f.run.Failure, f.run.Safety.Limitations)\n   119\t\t}\n   120\t\t// Review round 9, N1: the recorded limitation describes the shim, not an\n   121\t\t// environment match.\n   122\t\tif !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), \"the review run shim ends every process left in the run's subtree\") {\n   123\t\t\tt.Fatalf(\"the limitation does not describe the shim: %v\", f.run.Safety.Limitations)\n   124\t\t}\n   125\t\t// Review round 7, N4: the record names the pid, never the process name\n   126\t\t// the reviewer chose.\n   127\t\tfor _, limit := range f.run.Safety.Limitations {\n   128\t\t\tif strings.Contains(limit, \"(orphaned)\") && strings.Contains(limit, \" sh \") {\n   129\t\t\t\tt.Fatalf(\"the recorded limitation carries a process name: %q\", limit)\n   130\t\t\t}\n   131\t\t}\n   132\t\tif !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), strconv.Itoa(pid)+\" (orphaned)\") {\n   133\t\t\tt.Fatalf(\"the recorded limitation does not name the pid: %v\", f.run.Safety.Limitations)\n   134\t\t}\n   135\t}\n   136\t\n   137\t// waitGone waits for pid to end (or be a zombie) and reports whether it did.\n   138\tfunc waitGone(pid int, within time.Duration) bool {\n   139\t\tdeadline := time.Now().Add(within)\n   140\t\tfor time.Now().Before(deadline) {\n   141\t\t\tif zombie, err := reviewProcessZombie(pid); err != nil || zombie {\n   142\t\t\t\treturn true\n   143\t\t\t}\n   144\t\t\ttime.Sleep(50 * time.Millisecond)\n   145\t\t}\n   146\t\treturn false\n   147\t}\n   148\t\n   149\t// Review round 8, N2: the shim's report never goes through a path the\n   150\t// reviewer can write, and the reviewer does not inherit the report pipe.\n   151\tfunc TestTheAdapterDoesNotInheritTheShimReport(t *testing.T) {\n   152\t\tfds := filepath.Join(t.TempDir(), \"fds\")\n   153\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   154\t\t\ta.Containment = containmentPolicy()\n   155\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; ls /proc/$$/fd > \"$1\"; env | grep -c POSE_REVIEW_SHIM_REPORT >> \"$1\"; ls \"$TMPDIR\" >> \"$1\"; printf 'decision: approved\\n'`, \"sh\", fds}\n   156\t\t})\n   157\t\traw, err := os.ReadFile(fds)\n   158\t\tif err != nil || f.run.Status != ReviewRunCompleted {\n   159\t\t\tt.Fatalf(\"the probe did not run: %v %s %s\", err, f.run.Status, f.run.Failure)\n   160\t\t}\n   161\t\tlines := strings.Fields(string(raw))\n   162\t\tfor _, l := range lines {\n   163\t\t\tif l == \"3\" || strings.Contains(l, \"shim-report\") {\n   164\t\t\t\tt.Fatalf(\"the adapter sees the shim's report (%q): %s\", l, raw)\n   165\t\t\t}\n   166\t\t}\n   167\t}\n   168\t\n   169\t// Review round 8, N3: a timeout asks the shim to end the run's subtree, so an\n   170\t// orphan that cleared its environment does not outlive it.\n   171\tfunc TestATimeoutEndsTheRunsOrphans(t *testing.T) {\n   172\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   173\t\t\tt.Skip(\"setsid is not available\")\n   174\t\t}\n   175\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   176\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   177\t\t\ta.Containment = containmentPolicy()\n   178\t\t\ta.Timeout = \"2s\"\n   179\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & sleep 30`, \"sh\", pidFile}\n   180\t\t})\n   181\t\traw, err := os.ReadFile(pidFile)\n   182\t\tif err != nil {\n   183\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   184\t\t}\n   185\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   186\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   187\t\tif !waitGone(pid, 2*time.Second) {\n   188\t\t\tt.Fatal(\"an orphan outlived the run's timeout\")\n   189\t\t}\n   190\t}\n   191\t\n   192\t// Review round 8, N4: when the dispatcher ends, the shim ends the run's\n   193\t// subtree instead of leaving the reviewer running behind a dead owner.\n   194\tfunc TestTheShimEndsTheRunWhenItsDispatcherEnds(t *testing.T) {\n   195\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   196\t\t\tt.Skip(\"setsid is not available\")\n   197\t\t}\n   198\t\tself, err := os.Executable()\n   199\t\tif err != nil {\n   200\t\t\tt.Fatal(err)\n   201\t\t}\n   202\t\tdir := t.TempDir()\n   203\t\torphanPid, shimPid := filepath.Join(dir, \"orphan.pid\"), filepath.Join(dir, \"shim.pid\")\n   204\t\tadapter := filepath.Join(dir, \"adapter.sh\")\n   205\t\tif err := os.WriteFile(adapter, []byte(\"#!/bin/sh\\nsetsid env -i /bin/sh -c 'echo $$ > \\\"$1\\\"; while :; do sleep 0.05; done' sh \\\"$1\\\" </dev/null >/dev/null 2>&1 &\\nsleep 30\\n\"), 0o755); err != nil {\n   206\t\t\tt.Fatal(err)\n   207\t\t}\n   208\t\t// A stand-in dispatcher starts the shim and ends once the run is going.\n   209\t\tscript := `export ` + ReviewShimReportEnv + `=$$; \"$1\" ` + ReviewShimArg + ` /bin/sh sh \"$4\" \"$2\" & echo $! > \"$3\"; ` +\n   210\t\t\t`i=0; while [ ! -s \"$2\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; exit 0`\n   211\t\t// No output pipe: waiting for one would wait for the shim that inherits it.\n   212\t\tdispatcher := exec.Command(\"sh\", \"-c\", script, \"sh\", self, orphanPid, shimPid, adapter)\n   213\t\tstarted := time.Now()\n   214\t\tif err := dispatcher.Run(); err != nil {\n   215\t\t\tt.Fatalf(\"the stand-in dispatcher failed: %v\", err)\n   216\t\t}\n   217\t\tif time.Since(started) > 10*time.Second {\n   218\t\t\tt.Fatal(\"the stand-in dispatcher waited for the run\")\n   219\t\t}\n   220\t\traw, err := os.ReadFile(orphanPid)\n   221\t\tif err != nil {\n   222\t\t\tt.Fatalf(\"the run never started: %v\", err)\n   223\t\t}\n   224\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   225\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   226\t\tif !waitGone(pid, 5*time.Second) {\n   227\t\t\tt.Fatal(\"the run outlived its dispatcher\")\n   228\t\t}\n   229\t}\n","exit_code":0,"status":"completed"}}
