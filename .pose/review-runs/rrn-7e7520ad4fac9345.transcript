{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/cmd/pose/main.go | sed -n '1,70p'; nl -ba pose-mcp/internal/pose/review_shim_test.go; nl -ba pose-mcp/internal/pose/review_reap_other.go\"","aggregated_output":"     1\t// pose is the native-only unified POSE CLI and MCP server.\n     2\tpackage main\n     3\t\n     4\timport (\n     5\t\t\"os\"\n     6\t\t\"path/filepath\"\n     7\t\n     8\t\t\"github.com/harne8/pose-mcp/internal/cli\"\n     9\t\t\"github.com/harne8/pose-mcp/internal/pose\"\n    10\t)\n    11\t\n    12\tfunc main() {\n    13\t\tpose.ReviewShimAvailable = true\n    14\t\tif base := filepath.Base(os.Args[0]); base == \"pre-commit\" || base == \"post-merge\" {\n    15\t\t\tos.Exit(cli.HookMain(base, os.Stdout, os.Stderr))\n    16\t\t}\n    17\t\tos.Exit(cli.Main(os.Args[1:], os.Stdout, os.Stderr))\n    18\t}\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"encoding/json\"\n     5\t\t\"strconv\"\n     6\t\t\"strings\"\n     7\t\t\"testing\"\n     8\t)\n     9\t\n    10\t// Review round 9, N2: however many processes the shim ended, its report fits\n    11\t// the dispatcher's read bound and still counts them all.\n    12\tfunc TestTheShimReportIsBounded(t *testing.T) {\n    13\t\tr := reviewShimReport{Error: strings.Repeat(\"e\", 100000)}\n    14\t\tfor i := 0; i < 50000; i++ {\n    15\t\t\tr.Ended = append(r.Ended, strconv.Itoa(4000000+i))\n    16\t\t}\n    17\t\traw := boundedReviewShimReport(r)\n    18\t\tif len(raw) >= 64<<10 {\n    19\t\t\tt.Fatalf(\"the report is %d bytes, beyond the dispatcher's 64 KiB read\", len(raw))\n    20\t\t}\n    21\t\tvar got reviewShimReport\n    22\t\tif err := json.Unmarshal(raw, &got); err != nil || got.EndedTotal != 50000 || len(got.Ended) != reviewShimReportMaxPids {\n    23\t\t\tt.Fatalf(\"the bounded report lost its count: %d of %d, %v\", len(got.Ended), got.EndedTotal, err)\n    24\t\t}\n    25\t}\n     1\t//go:build !linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport \"os/exec\"\n     6\t\n     7\t// reapSealedCheckoutProcesses has no portable way to read another process's\n     8\t// environment; outside Linux the process-group kill is the only termination.\n     9\tfunc reapSealedCheckoutProcesses(string, map[int]string) ([]string, int, error) { return nil, 0, nil }\n    10\t\n    11\tfunc reviewOpaqueProcessBaseline() map[int]string { return nil }\n    12\t\n    13\t// RunReviewShim is the Linux review run shim; elsewhere it is not used.\n    14\tfunc RunReviewShim(args []string) int { return 125 }\n    15\t\n    16\tfunc parseReviewShimReport([]byte) (reviewShimReport, error) { return reviewShimReport{}, nil }\n    17\t\n    18\tfunc stopReviewShim(cmd *exec.Cmd) func() error { return cmd.Cancel }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '401,475p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '20,100p;180,310p'\"","aggregated_output":"   401\t// ReviewRoundOf derives the round of bundle from the sealed bundles of its\n   402\t// scope and the run history (R1). A history or a bundle inventory with a loss\n   403\t// that may concern the scope, a previous round whose record is not intact,\n   404\t// or a run of the scope whose bundle is missing make it fail: a round is\n   405\t// never silently lowered (security; review round 1, B9).\n   406\tfunc (s Store) ReviewRoundOf(bundle ReviewBundle) (ReviewRound, error) {\n   407\t\truns, lost, err := s.ReadReviewRuns(\"\")\n   408\t\tif err != nil {\n   409\t\t\treturn ReviewRound{}, err\n   410\t\t}\n   411\t\tif len(lost) > 0 {\n   412\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: the review run history is incomplete, so the round of %s cannot be derived: %v\", bundle.BundleID, lost)\n   413\t\t}\n   414\t\tscope := bundle.Payload.Scope.Ref\n   415\t\tread, err := s.ReadReviewBundles(scope)\n   416\t\tif err != nil {\n   417\t\t\treturn ReviewRound{}, err\n   418\t\t}\n   419\t\tfor _, loss := range read.Coverage.Losses {\n   420\t\t\tif loss.Scope == \"\" || loss.Scope == scope || loss.Scope == bundle.Payload.Scope.Slug {\n   421\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: a sealed bundle that may belong to %s could not be read (%s), so its round cannot be derived\", scope, loss.Artifact)\n   422\t\t\t}\n   423\t\t}\n   424\t\tpresent := map[string]bool{}\n   425\t\tfor _, b := range read.Bundles {\n   426\t\t\tpresent[b.BundleID] = true\n   427\t\t}\n   428\t\tfor _, r := range runs {\n   429\t\t\tif r.Scope == scope && r.Kind == ReviewBriefKindReview && r.Status == ReviewRunCompleted && !present[r.BundleID] && r.BundleID != bundle.BundleID {\n   430\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s reviewed bundle %s of %s, which is missing, so the round cannot be derived\", r.RunID, r.BundleID, scope)\n   431\t\t\t}\n   432\t\t}\n   433\t\treturn reviewRoundFrom(bundle, read.Bundles, runs, s.reviewRunTranscriptIntact)\n   434\t}\n   435\t\n   436\t// reviewRoundFrom derives the round of bundle from bundles and runs; intact\n   437\t// says why a run's record is not intact, or \"\".\n   438\tfunc reviewRoundFrom(bundle ReviewBundle, bundles []ReviewBundle, runs []ReviewRun, intact func(ReviewRun) string) (ReviewRound, error) {\n   439\t\ttype concluded struct {\n   440\t\t\tbundle ReviewBundle\n   441\t\t\trun    *ReviewRun\n   442\t\t\tended  time.Time\n   443\t\t}\n   444\t\t// A round precedes bundle when its concluding run ended no later than the\n   445\t\t// second bundle was sealed in: a bundle is sealed after the rejection it\n   446\t\t// answers. Seals have second precision, runs nanoseconds, so the runs, as\n   447\t\t// instants, order the chain (D4; review round 1, B3).\n   448\t\tsealed, sealErr := time.Parse(time.RFC3339, bundle.SealedAt)\n   449\t\tvar chain []concluded\n   450\t\tfor _, b := range bundles {\n   451\t\t\tif b.BundleID == bundle.BundleID || b.BundleDigest == bundle.BundleDigest {\n   452\t\t\t\tcontinue\n   453\t\t\t}\n   454\t\t\trun := concludingReviewRun(runs, b.BundleID)\n   455\t\t\tif run == nil {\n   456\t\t\t\tcontinue\n   457\t\t\t}\n   458\t\t\tended, err := time.Parse(time.RFC3339Nano, run.EndedAt)\n   459\t\t\tif err != nil {\n   460\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s records no valid end, so the order of the rounds cannot be derived\", run.RunID)\n   461\t\t\t}\n   462\t\t\tif bundle.SealedAt != \"\" && sealErr == nil && ended.Truncate(time.Second).After(sealed) {\n   463\t\t\t\tcontinue\n   464\t\t\t}\n   465\t\t\tchain = append(chain, concluded{b, run, ended})\n   466\t\t}\n   467\t\tsort.SliceStable(chain, func(i, j int) bool {\n   468\t\t\tif !chain[i].ended.Equal(chain[j].ended) {\n   469\t\t\t\treturn chain[i].ended.Before(chain[j].ended)\n   470\t\t\t}\n   471\t\t\treturn chain[i].run.RunID < chain[j].run.RunID\n   472\t\t})\n   473\t\tround := ReviewRound{Number: len(chain) + 1}\n   474\t\tvar open []ReviewOpenFinding\n   475\t\tvar broken []string\n    20\t\n    21\tconst reviewAttemptDir = \".pose/review-attempts\"\n    22\tconst reviewRunLedgerDir = \".pose/review-run-ledger\"\n    23\tconst reviewLedgerMaxRecords = 10000\n    24\tconst reviewLedgerMaxBytes = 1 << 20\n    25\t\n    26\t// DelegatedReviewAttempt is an immutable reservation, published before any adapter starts.\n    27\t// Its ordinal path coordinates contenders; its ID binds its complete content.\n    28\ttype DelegatedReviewAttempt struct {\n    29\t\tSchemaVersion int    `json:\"schema_version\"`\n    30\t\tAttemptID     string `json:\"attempt_id\"`\n    31\t\tBundleID      string `json:\"bundle_id\"`\n    32\t\tBundleDigest  string `json:\"bundle_digest\"`\n    33\t\tScope         string `json:\"scope\"`\n    34\t\tAdapter       string `json:\"adapter\"`\n    35\t\tReason        string `json:\"reason,omitempty\"`\n    36\t\tOrdinal       int    `json:\"ordinal\"`\n    37\t\tReservedAt    string `json:\"reserved_at\"`\n    38\t\tNonce         string `json:\"nonce\"`\n    39\t}\n    40\ttype reviewAttemptReceipt struct {\n    41\t\tSchemaVersion int    `json:\"schema_version\"`\n    42\t\tAttemptID     string `json:\"attempt_id\"`\n    43\t\tRunID         string `json:\"run_id\"`\n    44\t\tRunDigest     string `json:\"run_digest\"`\n    45\t}\n    46\ttype reviewRunWitness struct {\n    47\t\tSchemaVersion    int    `json:\"schema_version\"`\n    48\t\tRunID            string `json:\"run_id\"`\n    49\t\tBundleID         string `json:\"bundle_id\"`\n    50\t\tScope            string `json:\"scope\"`\n    51\t\tRecordDigest     string `json:\"record_digest\"`\n    52\t\tTranscriptDigest string `json:\"transcript_digest\"`\n    53\t}\n    54\t\n    55\tfunc reviewAttemptKey(bundle string) string {\n    56\t\treturn strings.TrimPrefix(digestBytes([]byte(bundle)), \"sha256:\")[:24]\n    57\t}\n    58\tfunc reviewAttemptPath(root string, a DelegatedReviewAttempt) string {\n    59\t\treturn filepath.Join(root, reviewAttemptDir, reviewAttemptKey(a.BundleID), fmt.Sprintf(\"%06d.json\", a.Ordinal))\n    60\t}\n    61\tfunc attemptReceiptPath(root string, a DelegatedReviewAttempt) string {\n    62\t\treturn strings.TrimSuffix(reviewAttemptPath(root, a), \".json\") + \".result.json\"\n    63\t}\n    64\tfunc attemptIdentity(a DelegatedReviewAttempt) string {\n    65\t\ta.AttemptID = \"\"\n    66\t\traw, _ := json.Marshal(a)\n    67\t\treturn \"rat-\" + strings.TrimPrefix(digestBytes(raw), \"sha256:\")\n    68\t}\n    69\t\n    70\tfunc readLedgerRaw(path string) ([]byte, error) {\n    71\t\treturn readBoundedRegular(path, reviewLedgerMaxBytes)\n    72\t}\n    73\t\n    74\t// readBoundedRegular reads a regular file of at most limit bytes, refusing a\n    75\t// link or a file replaced while it was opened.\n    76\tfunc readBoundedRegular(path string, limit int64) ([]byte, error) {\n    77\t\tinfo, err := os.Lstat(path)\n    78\t\tif err != nil {\n    79\t\t\treturn nil, err\n    80\t\t}\n    81\t\tif !info.Mode().IsRegular() || info.Size() > limit {\n    82\t\t\treturn nil, fmt.Errorf(\"ledger record is not a bounded regular file: %s\", path)\n    83\t\t}\n    84\t\tf, err := os.Open(path)\n    85\t\tif err != nil {\n    86\t\t\treturn nil, err\n    87\t\t}\n    88\t\topened, statErr := f.Stat()\n    89\t\tif statErr != nil || !opened.Mode().IsRegular() || !os.SameFile(info, opened) {\n    90\t\t\tf.Close()\n    91\t\t\treturn nil, fmt.Errorf(\"ledger file changed while opening %s\", path)\n    92\t\t}\n    93\t\traw, err := io.ReadAll(io.LimitReader(f, limit+1))\n    94\t\tcloseErr := f.Close()\n    95\t\tif err != nil {\n    96\t\t\treturn nil, err\n    97\t\t}\n    98\t\tif closeErr != nil {\n    99\t\t\treturn nil, closeErr\n   100\t\t}\n   180\t\t\t\treturn nil, errReviewLedgerBudget\n   181\t\t\t}\n   182\t\t}\n   183\t\treturn raw, nil\n   184\t}\n   185\tfunc readLedgerJSONBudget(path string, v any, remaining *int64) error {\n   186\t\traw, err := readLedgerRawBudget(path, remaining)\n   187\t\tif err != nil {\n   188\t\t\treturn err\n   189\t\t}\n   190\t\treturn strictJSONBytes(raw, v)\n   191\t}\n   192\t\n   193\tfunc readLedgerJSONBudgetIn(files Files, path string, v any, remaining *int64) error {\n   194\t\traw, err := readLedgerRawBudgetIn(files, path, remaining)\n   195\t\tif err != nil {\n   196\t\t\treturn err\n   197\t\t}\n   198\t\treturn strictJSONBytes(raw, v)\n   199\t}\n   200\tfunc reviewReadBudget(provided []*int64) *int64 {\n   201\t\tif len(provided) > 0 {\n   202\t\t\treturn provided[0]\n   203\t\t}\n   204\t\tbudget := int64(32 << 20)\n   205\t\treturn &budget\n   206\t}\n   207\t\n   208\tfunc readLedgerJSON(path string, v any) error {\n   209\t\traw, err := readLedgerRaw(path)\n   210\t\tif err != nil {\n   211\t\t\treturn err\n   212\t\t}\n   213\t\tif err := strictJSONBytes(raw, v); err != nil {\n   214\t\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n   215\t\t}\n   216\t\treturn nil\n   217\t}\n   218\t\n   219\tfunc readLedgerJSONIn(files Files, path string, v any) error {\n   220\t\traw, err := readBoundedRegularIn(files, path, reviewLedgerMaxBytes)\n   221\t\tif err != nil {\n   222\t\t\treturn err\n   223\t\t}\n   224\t\tif err := strictJSONBytes(raw, v); err != nil {\n   225\t\t\treturn fmt.Errorf(\"ledger record %s: %w\", path, err)\n   226\t\t}\n   227\t\treturn nil\n   228\t}\n   229\t\n   230\tfunc ledgerEntries(root, rel string) ([]os.DirEntry, error) {\n   231\t\tpath, err := ensureReviewArtifactDir(root, rel, false)\n   232\t\tif os.IsNotExist(err) {\n   233\t\t\treturn nil, nil\n   234\t\t}\n   235\t\tif err != nil {\n   236\t\t\treturn nil, err\n   237\t\t}\n   238\t\tf, err := os.Open(path)\n   239\t\tif err != nil {\n   240\t\t\treturn nil, err\n   241\t\t}\n   242\t\tentries, err := f.ReadDir(reviewLedgerMaxRecords + 1)\n   243\t\tcloseErr := f.Close()\n   244\t\tif err != nil && !errors.Is(err, io.EOF) {\n   245\t\t\treturn nil, err\n   246\t\t}\n   247\t\tif closeErr != nil {\n   248\t\t\treturn nil, closeErr\n   249\t\t}\n   250\t\tif len(entries) > reviewLedgerMaxRecords {\n   251\t\t\treturn nil, fmt.Errorf(\"ledger inventory exceeds %d records\", reviewLedgerMaxRecords)\n   252\t\t}\n   253\t\tsort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })\n   254\t\treturn entries, nil\n   255\t}\n   256\t\n   257\tfunc ledgerEntriesIn(files Files, root, rel string) ([]fs.DirEntry, error) {\n   258\t\tfiles = FilesOrNative(files)\n   259\t\tpath, err := ensureReviewArtifactDirIn(files, root, rel, false)\n   260\t\tif os.IsNotExist(err) {\n   261\t\t\treturn nil, nil\n   262\t\t}\n   263\t\tif err != nil {\n   264\t\t\treturn nil, err\n   265\t\t}\n   266\t\tf, err := files.Open(path)\n   267\t\tif err != nil {\n   268\t\t\treturn nil, err\n   269\t\t}\n   270\t\treader, ok := f.(interface {\n   271\t\t\tReadDir(int) ([]fs.DirEntry, error)\n   272\t\t})\n   273\t\tif !ok {\n   274\t\t\t_ = f.Close()\n   275\t\t\treturn nil, fmt.Errorf(\"ledger directory does not support bounded reads\")\n   276\t\t}\n   277\t\tentries, err := reader.ReadDir(reviewLedgerMaxRecords + 1)\n   278\t\tcloseErr := f.Close()\n   279\t\tif err != nil && !errors.Is(err, io.EOF) {\n   280\t\t\treturn nil, err\n   281\t\t}\n   282\t\tif closeErr != nil {\n   283\t\t\treturn nil, closeErr\n   284\t\t}\n   285\t\tif len(entries) > reviewLedgerMaxRecords {\n   286\t\t\treturn nil, fmt.Errorf(\"ledger inventory exceeds %d records\", reviewLedgerMaxRecords)\n   287\t\t}\n   288\t\tsort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })\n   289\t\treturn entries, nil\n   290\t}\n   291\tfunc publishLedgerJSON(root, rel string, v any) error {\