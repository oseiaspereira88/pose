{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_shim_linux.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"os/signal\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"golang.org/x/sys/unix\"\n    18\t)\n    19\t\n    20\t// RunReviewShim runs args (the adapter's path, then its argv) as the shim's\n    21\t// only child, waits for it or for SIGTERM, ends every process left in the\n    22\t// shim's subtree and returns the adapter's exit status.\n    23\tfunc RunReviewShim(args []string) int {\n    24\t\treport := reviewShimReport{}\n    25\t\tvar reportFile *os.File\n    26\t\tparent := 0\n    27\t\tif value := os.Getenv(ReviewShimReportEnv); value != \"\" {\n    28\t\t\tparent, _ = strconv.Atoi(value)\n    29\t\t\t// The report pipe is the shim's alone: the adapter never inherits it.\n    30\t\t\tsyscall.CloseOnExec(3)\n    31\t\t\treportFile = os.NewFile(3, \"pose-review-shim-report\")\n    32\t\t}\n    33\t\t_ = os.Unsetenv(ReviewShimReportEnv)\n    34\t\twrite := func() {\n    35\t\t\tif reportFile == nil {\n    36\t\t\t\treturn\n    37\t\t\t}\n    38\t\t\traw := boundedReviewShimReport(report)\n    39\t\t\t_, _ = reportFile.Write(raw)\n    40\t\t\t_ = reportFile.Close()\n    41\t\t}\n    42\t\tif len(args) < 2 {\n    43\t\t\treport.Error = \"the review shim was given no adapter\"\n    44\t\t\twrite()\n    45\t\t\treturn 125\n    46\t\t}\n    47\t\tstop := make(chan os.Signal, 1)\n    48\t\tsignal.Notify(stop, syscall.SIGTERM)\n    49\t\t// The dispatcher's death stops the shim the same way as a timeout.\n    50\t\tif err := unix.Prctl(unix.PR_SET_PDEATHSIG, uintptr(syscall.SIGTERM), 0, 0, 0); err != nil {\n    51\t\t\treport.Error = \"the shim could not follow its dispatcher: \" + err.Error()\n    52\t\t\twrite()\n    53\t\t\treturn 125\n    54\t\t}\n    55\t\tif parent != 0 && os.Getppid() != parent {\n    56\t\t\treport.Error = \"the dispatcher ended before the shim started\"\n    57\t\t\twrite()\n    58\t\t\treturn 125\n    59\t\t}\n    60\t\tif err := unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0); err != nil {\n    61\t\t\treport.Error = \"the shim could not become the subreaper of the run: \" + err.Error()\n    62\t\t\twrite()\n    63\t\t\treturn 125\n    64\t\t}\n    65\t\tcmd := &exec.Cmd{Path: args[0], Args: args[1:], Stdin: os.Stdin, Stdout: os.Stdout, Stderr: os.Stderr, Env: os.Environ()}\n    66\t\tif err := cmd.Start(); err != nil {\n    67\t\t\treport.Error = \"the adapter could not run: \" + err.Error()\n    68\t\t\twrite()\n    69\t\t\treturn 127\n    70\t\t}\n    71\t\tdone := make(chan error, 1)\n    72\t\tgo func() { done <- cmd.Wait() }()\n    73\t\tcode, stopped := 0, false\n    74\t\tvar signaled syscall.Signal\n    75\t\tselect {\n    76\t\tcase err := <-done:\n    77\t\t\tvar exit *exec.ExitError\n    78\t\t\tif errors.As(err, &exit) {\n    79\t\t\t\tif status, ok := exit.Sys().(syscall.WaitStatus); ok && status.Signaled() {\n    80\t\t\t\t\tsignaled, code = status.Signal(), 128+int(status.Signal())\n    81\t\t\t\t} else {\n    82\t\t\t\t\tcode = exit.ExitCode()\n    83\t\t\t\t}\n    84\t\t\t} else if err != nil {\n    85\t\t\t\treport.Error = \"the adapter's end could not be read: \" + err.Error()\n    86\t\t\t}\n    87\t\tcase <-stop:\n    88\t\t\tstopped, code = true, 128+int(syscall.SIGTERM)\n    89\t\t}\n    90\t\tended, err := reapShimSubtree()\n    91\t\treport.Ended = ended\n    92\t\tif err != nil && report.Error == \"\" {\n    93\t\t\treport.Error = err.Error()\n    94\t\t}\n    95\t\twrite()\n    96\t\tif stopped {\n    97\t\t\treturn code\n    98\t\t}\n    99\t\t// An adapter ended by a signal is reported as ended by it: the shim ends\n   100\t\t// itself the same way, so the dispatcher reads what it would have read\n   101\t\t// without the shim.\n   102\t\tif signaled != 0 {\n   103\t\t\tsignal.Reset(signaled)\n   104\t\t\t_ = syscall.Kill(os.Getpid(), signaled)\n   105\t\t\ttime.Sleep(time.Second)\n   106\t\t}\n   107\t\treturn code\n   108\t}\n   109\t\n   110\t// stopReviewShim asks a running shim to end its subtree and exit.\n   111\tfunc stopReviewShim(cmd *exec.Cmd) func() error {\n   112\t\treturn func() error { return cmd.Process.Signal(syscall.SIGTERM) }\n   113\t}\n   114\t\n   115\t// reapShimSubtree ends and reaps every child of the shim, including the\n   116\t// orphans its subreaper status adopted, until none is left.\n   117\tfunc reapShimSubtree() ([]string, error) {\n   118\t\tself := os.Getpid()\n   119\t\tvar ended []string\n   120\t\tseen := map[int]bool{}\n   121\t\tdeadline := time.Now().Add(reviewReapWait)\n   122\t\t// A process that cannot be inspected or ended is not a reason to stop:\n   123\t\t// the others are still ended, and the problem is reported at the end\n   124\t\t// (review round 9, N3).\n   125\t\tvar problems []string\n   126\t\tnote := func(err error) {\n   127\t\t\tif len(problems) < 8 {\n   128\t\t\t\tproblems = append(problems, err.Error())\n   129\t\t\t}\n   130\t\t}\n   131\t\tfor {\n   132\t\t\tchildren := 0\n   133\t\t\tproblems = problems[:0]\n   134\t\t\tdirs, err := os.ReadDir(\"/proc\")\n   135\t\t\tif err != nil {\n   136\t\t\t\tnote(fmt.Errorf(\"the run's processes could not be listed: %w\", err))\n   137\t\t\t}\n   138\t\t\tfor _, d := range dirs {\n   139\t\t\t\tpid, err := strconv.Atoi(d.Name())\n   140\t\t\t\tif err != nil || pid == self {\n   141\t\t\t\t\tcontinue\n   142\t\t\t\t}\n   143\t\t\t\tst, err := readShimProcStat(pid)\n   144\t\t\t\tif reviewProcessGoneErr(err) {\n   145\t\t\t\t\tcontinue\n   146\t\t\t\t}\n   147\t\t\t\tif err != nil {\n   148\t\t\t\t\t// A process of another user is never the run's: with procfs\n   149\t\t\t\t\t// mounted hidepid it is visible and unreadable (review round 10,\n   150\t\t\t\t\t// N1). Only one of this user is an unknown that may be the run's.\n   151\t\t\t\t\tif owner, oerr := reviewProcessOwner(pid); reviewProcessGoneErr(oerr) || oerr == nil && owner != os.Getuid() {\n   152\t\t\t\t\t\tcontinue\n   153\t\t\t\t\t}\n   154\t\t\t\t\tchildren++\n   155\t\t\t\t\tnote(fmt.Errorf(\"process %d could not be inspected: %w\", pid, err))\n   156\t\t\t\t\tcontinue\n   157\t\t\t\t}\n   158\t\t\t\tif st.ppid != self {\n   159\t\t\t\t\tcontinue\n   160\t\t\t\t}\n   161\t\t\t\tchildren++\n   162\t\t\t\tif !st.zombie {\n   163\t\t\t\t\t// A pid is reported ended only once its signal was delivered\n   164\t\t\t\t\t// (review round 10, N3).\n   165\t\t\t\t\tif err := killPinnedChild(pid, self); err != nil {\n   166\t\t\t\t\t\tnote(err)\n   167\t\t\t\t\t} else if !seen[pid] {\n   168\t\t\t\t\t\tseen[pid] = true\n   169\t\t\t\t\t\tended = append(ended, strconv.Itoa(pid))\n   170\t\t\t\t\t}\n   171\t\t\t\t}\n   172\t\t\t}\n   173\t\t\tfor {\n   174\t\t\t\tpid, err := unix.Wait4(-1, nil, unix.WNOHANG, nil)\n   175\t\t\t\tif pid <= 0 || err != nil {\n   176\t\t\t\t\tbreak\n   177\t\t\t\t}\n   178\t\t\t}\n   179\t\t\tif children == 0 && len(problems) == 0 {\n   180\t\t\t\treturn ended, nil\n   181\t\t\t}\n   182\t\t\tif time.Now().After(deadline) {\n   183\t\t\t\treturn ended, fmt.Errorf(\"%d process(es) of the run could not be ended: %s\", children, strings.Join(problems, \"; \"))\n   184\t\t\t}\n   185\t\t\ttime.Sleep(20 * time.Millisecond)\n   186\t\t}\n   187\t}\n   188\t\n   189\ttype shimProcStat struct {\n   190\t\tppid   int\n   191\t\tzombie bool\n   192\t}\n   193\t\n   194\tfunc readShimProcStat(pid int) (shimProcStat, error) {\n   195\t\traw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n   196\t\tif err != nil {\n   197\t\t\treturn shimProcStat{}, err\n   198\t\t}\n   199\t\ttext := string(raw)\n   200\t\tend := strings.LastIndexByte(text, ')')\n   201\t\tif end < 0 {\n   202\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   203\t\t}\n   204\t\tf := strings.Fields(text[end+1:])\n   205\t\tif len(f) < 2 {\n   206\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   207\t\t}\n   208\t\tppid, err := strconv.Atoi(f[1])\n   209\t\tif err != nil {\n   210\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   211\t\t}\n   212\t\treturn shimProcStat{ppid: ppid, zombie: f[0] == \"Z\"}, nil\n   213\t}\n   214\t\n   215\t// killPinnedChild signals pid through a pidfd while it is still a child of\n   216\t// parent: a pid reused by an unrelated process is never signalled.\n   217\tfunc killPinnedChild(pid, parent int) error {\n   218\t\tfd, err := unix.PidfdOpen(pid, 0)\n   219\t\tif errors.Is(err, unix.ESRCH) {\n   220\t\t\treturn nil\n   221\t\t}\n   222\t\tif err != nil {\n   223\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   224\t\t}\n   225\t\tdefer unix.Close(fd)\n   226\t\tst, err := readShimProcStat(pid)\n   227\t\tif reviewProcessGoneErr(err) || err == nil && st.ppid != parent {\n   228\t\t\treturn nil\n   229\t\t}\n   230\t\tif err != nil {\n   231\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   232\t\t}\n   233\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   234\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   235\t\t}\n   236\t\treturn nil\n   237\t}\n   238\t\n   239\t// parseReviewShimReport reads the report the shim wrote to its pipe.\n   240\tfunc parseReviewShimReport(raw []byte) (reviewShimReport, error) {\n   241\t\tvar r reviewShimReport\n   242\t\tif len(raw) == 0 {\n   243\t\t\treturn r, fmt.Errorf(\"the review shim left no report\")\n   244\t\t}\n   245\t\tif err := json.Unmarshal(raw, &r); err != nil {\n   246\t\t\treturn r, fmt.Errorf(\"the review shim report is unreadable: %w\", err)\n   247\t\t}\n   248\t\treturn r, nil\n   249\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '1,260p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Listing and naming delegated runs (spec pose-delegation-surface R11, and the\n     4\t// listing pose-delegated-review-completion-signal extends).\n     5\t//\n     6\t// A person and an agent follow a task, not a process: an attempt and its\n     7\t// continuations are one row, shown by their latest run. A reference names a\n     8\t// row by attempt, by any of its runs, by label or by a prefix of its session.\n     9\t\n    10\timport (\n    11\t\t\"fmt\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t)\n    16\t\n    17\t// DelegationAttempt is one attempt and its continuations.\n    18\ttype DelegationAttempt struct {\n    19\t\tAttemptID    string              `json:\"attempt_id\"`\n    20\t\tRuns         []string            `json:\"runs\"`\n    21\t\tLatestRun    string              `json:\"latest_run,omitempty\"`\n    22\t\tState        string              `json:\"state\"`\n    23\t\tPurpose      string              `json:\"purpose\"`\n    24\t\tAgent        string              `json:\"agent\"`\n    25\t\tVendor       string              `json:\"vendor,omitempty\"`\n    26\t\tModel        string              `json:\"model,omitempty\"`\n    27\t\tLabel        string              `json:\"label,omitempty\"`\n    28\t\tLead         string              `json:\"lead,omitempty\"`\n    29\t\tAccess       string              `json:\"access\"`\n    30\t\tScope        string              `json:\"scope\"`\n    31\t\tBundleID     string              `json:\"bundle_id\"`\n    32\t\tStartedAt    string              `json:\"started_at\"`\n    33\t\tEndedAt      string              `json:\"ended_at,omitempty\"`\n    34\t\tTurns        int                 `json:\"turns\"`\n    35\t\tLastStep     string              `json:\"last_step,omitempty\"`\n    36\t\tFailure      string              `json:\"failure,omitempty\"`\n    37\t\tInterruption *ReviewInterruption `json:\"interruption,omitempty\"`\n    38\t\t// Partial says an interrupted run kept a partial draft; TimeLeft is the\n    39\t\t// wait until its recorded reset, when there is one.\n    40\t\tPartial         bool   `json:\"partial,omitempty\"`\n    41\t\tTimeLeft        string `json:\"time_left,omitempty\"`\n    42\t\tActive          bool   `json:\"active\"`\n    43\t\tLiveness        string `json:\"liveness,omitempty\"`\n    44\t\tCancelRequested bool   `json:\"cancel_requested,omitempty\"`\n    45\t\t// HeartbeatAge is how long ago the running process last beat; a stalled\n    46\t\t// run is not active (spec pose-delegated-review-completion-signal R4, R6).\n    47\t\tHeartbeatAge string `json:\"heartbeat_age,omitempty\"`\n    48\t\tStalledAt    string `json:\"stalled_at,omitempty\"`\n    49\t\t// HookFailure is why the latest run's on_terminal hook failed (R7).\n    50\t\tHookFailure string `json:\"hook_failure,omitempty\"`\n    51\t\t// Round is the review round of the scope the latest run reviewed (spec\n    52\t\t// pose-delegated-review-round-protocol R1).\n    53\t\tRound    int `json:\"round,omitempty\"`\n    54\t\tsessions []string\n    55\t\tlatest   *ReviewRun\n    56\t}\n    57\t\n    58\t// Latest is the latest recorded run of the attempt, if any.\n    59\tfunc (a DelegationAttempt) Latest() *ReviewRun { return a.latest }\n    60\t\n    61\t// DelegationRunning is the state of an attempt whose process is still there;\n    62\t// DelegationStalled, of one whose process is gone without a record.\n    63\tconst (\n    64\t\tDelegationRunning = \"running\"\n    65\t\tDelegationStalled = \"stalled\"\n    66\t\t// DelegationAbandonedCause is the failure of a stalled attempt whose\n    67\t\t// dispatch ended before recording its run.\n    68\t\tDelegationAbandonedCause = \"abandoned: the dispatching process ended before the run was recorded\"\n    69\t)\n    70\t\n    71\t// ListDelegationAttempts groups every recorded run by attempt, adds the runs\n    72\t// in progress, and returns the losses the run history reports.\n    73\tfunc (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n    74\t\t// The markers are read before the runs: a run publishes its record before\n    75\t\t// it removes its marker, so a reader that finds no marker for an attempt\n    76\t\t// it saw running finds its record (spec\n    77\t\t// pose-delegated-review-completion-signal R5).\n    78\t\tactive, activeLost, activeErr := s.ListDelegationActive()\n    79\t\truns, lost, err := s.ReadReviewRuns(\"\")\n    80\t\tif err != nil {\n    81\t\t\treturn nil, nil, err\n    82\t\t}\n    83\t\t// Task runs share the lifecycle, never the review history (spec\n    84\t\t// pose-delegation-task R7, R8).\n    85\t\ttasks, taskLost := s.ReadDelegationTaskRuns()\n    86\t\truns, lost = append(runs, tasks...), append(lost, taskLost...)\n    87\t\tbyAttempt := map[string]*DelegationAttempt{}\n    88\t\torder := []string{}\n    89\t\tfor i := range runs {\n    90\t\t\trun := runs[i]\n    91\t\t\tkey := run.AttemptID\n    92\t\t\tif key == \"\" {\n    93\t\t\t\tkey = run.RunID // a run recorded before attempts existed is its own attempt\n    94\t\t\t}\n    95\t\t\trow, ok := byAttempt[key]\n    96\t\t\tif !ok {\n    97\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    98\t\t\t\tbyAttempt[key] = row\n    99\t\t\t\torder = append(order, key)\n   100\t\t\t}\n   101\t\t\trow.Runs = append(row.Runs, run.RunID)\n   102\t\t\trow.latest = &runs[i]\n   103\t\t\tif run.SessionDigest != \"\" {\n   104\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   105\t\t\t\t\trow.sessions = append(row.sessions, value)\n   106\t\t\t\t}\n   107\t\t\t}\n   108\t\t\tevents, err := s.ReadDelegationEvents(run)\n   109\t\t\tif err != nil {\n   110\t\t\t\t// A turn count read from nothing would report a whole history.\n   111\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   112\t\t\t} else {\n   113\t\t\t\tfor _, e := range events {\n   114\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   115\t\t\t\t\t\trow.Turns++\n   116\t\t\t\t\t}\n   117\t\t\t\t}\n   118\t\t\t\tif len(events) > 0 {\n   119\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   120\t\t\t\t}\n   121\t\t\t}\n   122\t\t}\n   123\t\tfor _, key := range order {\n   124\t\t\trow := byAttempt[key]\n   125\t\t\tlatest := row.latest\n   126\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   127\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   128\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   129\t\t\tif latest.Access != \"\" {\n   130\t\t\t\trow.Access = latest.Access\n   131\t\t\t}\n   132\t\t\trow.Round = latest.Round\n   133\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   134\t\t\t\trow.HookFailure = hook.Failure\n   135\t\t\t}\n   136\t\t\tif row.Purpose == \"\" {\n   137\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   138\t\t\t}\n   139\t\t\tif latest.Status == ReviewRunInterrupted {\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n   206\t\tfor _, key := range order {\n   207\t\t\tout = append(out, *byAttempt[key])\n   208\t\t}\n   209\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   210\t\treturn out, lost, nil\n   211\t}\n   212\t\n   213\tfunc delegationStepText(e DelegationEvent) string {\n   214\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   215\t\tif len(text) > 80 {\n   216\t\t\tcut := 77\n   217\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   218\t\t\t\tcut--\n   219\t\t\t}\n   220\t\t\ttext = text[:cut] + \"...\"\n   221\t\t}\n   222\t\tswitch e.Kind {\n   223\t\tcase DelegationEventToolCall:\n   224\t\t\treturn \"▶ \" + text\n   225\t\tcase DelegationEventToolOutput:\n   226\t\t\tif e.ExitCode != nil && *e.ExitCode != 0 {\n   227\t\t\t\treturn fmt.Sprintf(\"✗ exit %d\", *e.ExitCode)\n   228\t\t\t}\n   229\t\t\treturn \"✓ exit 0\"\n   230\t\tcase DelegationEventTurn:\n   231\t\t\treturn \"turn\"\n   232\t\t}\n   233\t\tif text == \"\" {\n   234\t\t\treturn e.Kind\n   235\t\t}\n   236\t\treturn e.Kind + \": \" + text\n   237\t}\n   238\t\n   239\t// ErrDelegationRefAmbiguous carries the candidates of an ambiguous reference.\n   240\t// Neither reference error carries the reference: it may be a session, which\n   241\t// no output names.\n   242\ttype ErrDelegationRefAmbiguous struct {\n   243\t\tCandidates []string\n   244\t}\n   245\t\n   246\tfunc (e *ErrDelegationRefAmbiguous) Error() string {\n   247\t\treturn \"pose: the reference names more than one delegated run: \" + strings.Join(e.Candidates, \", \")\n   248\t}\n   249\t\n   250\t// ErrDelegationRefUnknown means no attempt matches.\n   251\ttype ErrDelegationRefUnknown struct{}\n   252\t\n   253\tfunc (e *ErrDelegationRefUnknown) Error() string {\n   254\t\treturn \"pose: no delegated run matches the reference (a run id, an attempt id, a label or a session prefix of six characters or more)\"\n   255\t}\n   256\t\n   257\t// ResolveDelegationRef finds the one attempt ref names (R11).\n   258\tfunc ResolveDelegationRef(attempts []DelegationAttempt, ref string) (DelegationAttempt, error) {\n   259\t\tref = strings.TrimSpace(ref)\n   260\t\tif ref == \"\" {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '850,1240p'\"","aggregated_output":"   850\t\t}\n   851\t\n   852\t\tworktreeOwned, err = os.Lstat(worktree)\n   853\t\tif err != nil {\n   854\t\t\treturn finish(ReviewRunFailed, \"worktree identity unavailable\")\n   855\t\t}\n   856\t\tgitMarker, err = ReadReviewAdapterFile(filepath.Join(worktree, \".git\"), 4096)\n   857\t\tif err != nil {\n   858\t\t\treturn finish(ReviewRunFailed, \"worktree marker unavailable\")\n   859\t\t}\n   860\t\townership, err = s.captureReviewCleanupOwnership(runtimeRoot, worktree, gitMarker)\n   861\t\tif err != nil {\n   862\t\t\treturn finish(ReviewRunFailed, \"worktree registration ownership unavailable\")\n   863\t\t}\n   864\t\tdefer ownership.registry.Close()\n   865\t\n   866\t\tsubmodules := map[string]bool{}\n   867\t\tfor _, entry := range plan.Bundle.Payload.Subject.Entries {\n   868\t\t\tif entry.Class == \"submodule\" {\n   869\t\t\t\tsubmodules[reviewBundleEntryPath(entry)] = true\n   870\t\t\t}\n   871\t\t}\n   872\t\tcommittedWorktreeBytes := ownership.inventoryBytes - gitSnapshotMarginBytes\n   873\t\tgitlinks := reviewGitlinkSetup{\n   874\t\t\tctx: setupCtx, cancel: stopSetup, hooks: hooks,\n   875\t\t\tmetadata:          filepath.Join(tmp, reviewGitlinkMetadataDir),\n   876\t\t\tmaxCommittedBytes: gitSnapshotCeilingBytes - committedWorktreeBytes,\n   877\t\t}\n   878\t\tgitlinkErr := gitlinks.materialize(s.Root, worktree, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries)\n   879\t\townership.inventoryBytes = gitSnapshotBudget(committedWorktreeBytes + gitlinks.committedBytes)\n   880\t\townership.gitlinkMetadata = gitlinks.metadataOwned\n   881\t\townership.gitlinkMetadataBytes = gitSnapshotBudget(gitlinks.committedBytes)\n   882\t\tif gitlinkErr != nil {\n   883\t\t\tterminationFailed = gitlinks.terminationFailure\n   884\t\t\tsafety.ExecutionCause = executionCause(setupCtx)\n   885\t\t\tif gitlinks.captureOverflow {\n   886\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   887\t\t\t}\n   888\t\t\treturn finish(ReviewRunFailed, \"sealed gitlink setup failed: \"+gitlinkErr.Error())\n   889\t\t}\n   890\t\tstopSetup()\n   891\t\tcheckout := s\n   892\t\tcheckout.Root, checkout.indexPin = worktree, nil\n   893\t\tif prepared, err := checkout.PrepareReviewBundle(plan.Brief.Scope); err != nil {\n   894\t\t\treturn finish(ReviewRunFailed, \"sealed checkout inputs unavailable: \"+err.Error())\n   895\t\t} else if blockers := checkoutBlockers(prepared.Blockers); len(blockers) > 0 {\n   896\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout blocked: %v\", blockers))\n   897\t\t} else if differing := sealedInputsThatDiffer(plan.Bundle, prepared, worktree); len(differing) > 0 {\n   898\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout inputs differ: %v\", differing))\n   899\t\t}\n   900\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n   901\t\t\treturn finish(ReviewRunFailed, err.Error())\n   902\t\t}\n   903\t\tif err := verifyBundleMaterialization(worktree, plan.Bundle); err != nil {\n   904\t\t\treturn finish(ReviewRunFailed, err.Error())\n   905\t\t}\n   906\t\tif plan.Purpose == DelegationPurposeReview && plan.Config.Events == DelegationEventsClaudeStreamJSON {\n   907\t\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n   908\t\t\tif err != nil {\n   909\t\t\t\treturn finish(ReviewRunFailed, \"review staging policy unavailable\")\n   910\t\t\t}\n   911\t\t\tif found && policy.Agents[plan.Adapter].ReviewProfile != nil {\n   912\t\t\t\tif err := prepareClaudeReviewStaging(runtimeRoot, plan.Bundle.Payload.Plan.Components); err != nil {\n   913\t\t\t\t\treturn finish(ReviewRunFailed, \"review staging directories unavailable\")\n   914\t\t\t\t}\n   915\t\t\t}\n   916\t\t}\n   917\t\tdiskBefore, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n   918\t\tif err != nil {\n   919\t\t\treturn finish(ReviewRunFailed, err.Error())\n   920\t\t}\n   921\t\n   922\t\trawTree, err := json.Marshal(diskBefore)\n   923\t\tif err != nil {\n   924\t\t\treturn finish(ReviewRunFailed, err.Error())\n   925\t\t}\n   926\t\tif plan.predecessor != nil && (!plan.handoff || plan.predecessor.TreeDigest != \"\") && digestBytes(rawTree) != plan.predecessor.TreeDigest {\n   927\t\t\treturn finish(ReviewRunFailed, \"recreated worktree tree digest differs\")\n   928\t\t}\n   929\t\trun.TreeDigest = digestBytes(rawTree)\n   930\t\toutputFile := filepath.Join(tmp, \"output.txt\")\n   931\t\tcommand := plan.Config.Command\n   932\t\tif plan.predecessor != nil && !plan.handoff || plan.thread.continued() {\n   933\t\t\tcommand = plan.Config.Resume.Command\n   934\t\t}\n   935\t\targv := ReviewerArgv(command, outputFile, plan.session, plan.Effort, plan.Config.Effort)\n   936\t\ttimeout := time.Duration(safety.TimeoutMS) * time.Millisecond\n   937\t\texecPath := argv[0]\n   938\t\tif run.Provenance != nil {\n   939\t\t\tcopy := *run.Provenance\n   940\t\t\trun.Provenance = &copy\n   941\t\t\tselected, resolved, err := provenanceExecutableSelection(argv[0], worktree)\n   942\t\t\tif err != nil {\n   943\t\t\t\treturn finish(ReviewRunFailed, \"provenance executable could not be resolved\")\n   944\t\t\t}\n   945\t\t\tdigest, err := reviewExecutableDigest(resolved)\n   946\t\t\tif err != nil {\n   947\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n   948\t\t\t}\n   949\t\t\trun.Provenance.ExecutableDigest = digest\n   950\t\t\texecPath = selected\n   951\t\t\traw, _ := json.Marshal(argv)\n   952\t\t\trun.Provenance.ArgvDigest = digestBytes(raw)\n   953\t\t}\n   954\t\tif plan.processTimeout > 0 {\n   955\t\t\tstarted, err := time.Parse(time.RFC3339Nano, run.StartedAt)\n   956\t\t\tif err != nil {\n   957\t\t\t\treturn finish(ReviewRunFailed, \"invalid execution start\")\n   958\t\t\t}\n   959\t\t\tsetup := now().Sub(started)\n   960\t\t\tremaining := plan.processTimeout - setup\n   961\t\t\tif setup < 0 || remaining <= 0 {\n   962\t\t\t\treturn finish(ReviewRunFailed, \"accumulated wall-clock budget spent before adapter launch\")\n   963\t\t\t}\n   964\t\t\tif remaining < timeout {\n   965\t\t\t\ttimeout = remaining\n   966\t\t\t}\n   967\t\t}\n   968\t\tctx, cancel := context.WithTimeout(parent, timeout)\n   969\t\tdefer cancel()\n   970\t\tcmd := exec.CommandContext(ctx, execPath, argv[1:]...)\n   971\t\tcmd.Args[0] = argv[0]\n   972\t\t// The adapter runs under the review run shim, which ends what the run\n   973\t\t// leaves in its subtree (review_shim.go).\n   974\t\tuseShim := false\n   975\t\tvar shimRead, shimWrite *os.File\n   976\t\tif ReviewShimAvailable && runtime.GOOS == \"linux\" && cmd.Err == nil {\n   977\t\t\t// The adapter's path as resolved here, in the dispatcher's PATH.\n   978\t\t\tif self, err := os.Executable(); err == nil {\n   979\t\t\t\tif r, w, err := os.Pipe(); err == nil {\n   980\t\t\t\t\tuseShim, shimRead, shimWrite = true, r, w\n   981\t\t\t\t\tcmd = exec.CommandContext(ctx, self, append([]string{ReviewShimArg, cmd.Path}, argv...)...)\n   982\t\t\t\t\tcmd.ExtraFiles = []*os.File{w}\n   983\t\t\t\t}\n   984\t\t\t}\n   985\t\t}\n   986\t\tcmd.Dir = worktree\n   987\t\tcmd.Stdin = strings.NewReader(plan.Brief.Text)\n   988\t\tenv, secrets, err := reviewAdapterEnvironment(plan.Config, tmp, plan.Brief.Text, plan.notes)\n   989\t\tif err != nil {\n   990\t\t\trun.BriefNotes = \"\"\n   991\t\t\treturn finish(ReviewRunFailed, err.Error())\n   992\t\t}\n   993\t\tunset := []string{}\n   994\t\tif policy, _, found, perr := s.LoadDelegationPolicy(); perr == nil && found {\n   995\t\t\tunset = policy.EnvUnset\n   996\t\t}\n   997\t\tenv, run.EnvRemoved = withoutParentSession(env, unset)\n   998\t\t// The reviewer works in a sealed checkout: diagnostics it runs must not\n   999\t\t// publish derived records into it (SealedCheckoutEnv).\n  1000\t\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n  1001\t\tif useShim {\n  1002\t\t\tenv = append(env, ReviewShimReportEnv+\"=\"+fmt.Sprint(os.Getpid()))\n  1003\t\t}\n  1004\t\t// The reviewer checks its draft against the sealed bundle and the round\n  1005\t\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n  1006\t\t// context that cannot be built leaves the check unavailable, never the\n  1007\t\t// review.\n  1008\t\tif plan.Purpose == DelegationPurposeReview {\n  1009\t\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n  1010\t\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n  1011\t\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n  1012\t\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n  1013\t\t\t\t\t// engine that dispatched the run is the one that checks it.\n  1014\t\t\t\t\tif self, err := os.Executable(); err == nil {\n  1015\t\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n  1016\t\t\t\t\t}\n  1017\t\t\t\t}\n  1018\t\t\t}\n  1019\t\t}\n  1020\t\tcmd.Env = env\n  1021\t\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n  1022\t\tcmd.Stdout, cmd.Stderr = combined, combined\n  1023\t\t// pose delegate watch follows the normalized, redacted events as they come\n  1024\t\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n  1025\t\t// the record is published.\n  1026\t\tsessionPattern := \"\"\n  1027\t\tif plan.Config.Session != nil {\n  1028\t\t\tsessionPattern = plan.Config.Session.Pattern\n  1029\t\t}\n  1030\t\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n  1031\t\t\ttee := io.MultiWriter(combined, live)\n  1032\t\t\tcmd.Stdout, cmd.Stderr = tee, tee\n  1033\t\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n  1034\t\t\tdefer live.Close()\n  1035\t\t}\n  1036\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n  1037\t\t// only the parent left a child holding stdout, so the timeout never fired\n  1038\t\t// (found in review). The run gets its own process group, the whole group\n  1039\t\t// is killed on timeout and after the run, and pipes are released at most\n  1040\t\t// a few seconds after the kill.\n  1041\t\topaqueBaseline := reviewOpaqueProcessBaseline()\n  1042\t\t// Orphans of the run are reparented to this process, so one that left\n  1043\t\t// the group and cleared its environment is still found (review round 6, N2).\n  1044\t\tisolateProcessGroup(cmd)\n  1045\t\tcmd.WaitDelay = AdapterPipeGrace\n  1046\t\tvar shimReport []byte\n  1047\t\tshimReportDone := make(chan struct{})\n  1048\t\tif useShim {\n  1049\t\t\t// A timeout asks the shim to end the run's subtree first; the group\n  1050\t\t\t// kill after Wait remains the backstop (review round 8, N3).\n  1051\t\t\tcmd.Cancel = stopReviewShim(cmd)\n  1052\t\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n  1053\t\t\tgo func() {\n  1054\t\t\t\tdefer close(shimReportDone)\n  1055\t\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n  1056\t\t\t\t// Whatever exceeds the bound is drained, so the shim never blocks.\n  1057\t\t\t\t_, _ = io.Copy(io.Discard, shimRead)\n  1058\t\t\t}()\n  1059\t\t} else {\n  1060\t\t\tclose(shimReportDone)\n  1061\t\t}\n  1062\t\tvar runErr error\n  1063\t\tif run.Provenance == nil {\n  1064\t\t\trunErr = cmd.Run()\n  1065\t\t} else {\n  1066\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1067\t\t\trunErr = err\n  1068\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1069\t\t\tif started {\n  1070\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1071\t\t\t}\n  1072\t\t}\n  1073\t\tif useShim && safety != nil {\n  1074\t\t\t// With the shim the run's leftovers are its subtree, not an\n  1075\t\t\t// environment match (review round 9, N1).\n  1076\t\t\tfor i, limit := range safety.Limitations {\n  1077\t\t\t\tif strings.HasPrefix(limit, \"no memory/CPU quota;\") {\n  1078\t\t\t\t\tsafety.Limitations[i] = \"no memory/CPU quota; the review run shim ends every process left in the run's subtree, including one in its own session\"\n  1079\t\t\t\t}\n  1080\t\t\t}\n  1081\t\t}\n  1082\t\tif useShim {\n  1083\t\t\t_ = shimWrite.Close()\n  1084\t\t\t<-shimReportDone\n  1085\t\t\t_ = shimRead.Close()\n  1086\t\t}\n  1087\t\tterminationErr = killProcessGroup(cmd)\n  1088\t\t// A command the reviewer left running in a session of its own escapes the\n  1089\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1090\t\t// directories it may still write (spec\n  1091\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1092\t\t// The environment entry is the reviewer's to set, so it is searched only\n  1093\t\t// without the shim, whose subtree is the run's by construction (review\n  1094\t\t// round 8, N1).\n  1095\t\tvar reaped []string\n  1096\t\tvar opaque int\n  1097\t\tvar reapErr error\n  1098\t\tif !useShim {\n  1099\t\t\treaped, opaque, reapErr = reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n  1100\t\t\tif reapErr != nil {\n  1101\t\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1102\t\t\t}\n  1103\t\t}\n  1104\t\tif useShim && cmd.ProcessState != nil {\n  1105\t\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n  1106\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1107\t\t\t} else {\n  1108\t\t\t\tfor _, pid := range report.Ended {\n  1109\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1110\t\t\t\t}\n  1111\t\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n  1112\t\t\t\t\treaped = append(reaped, fmt.Sprintf(\"and %d more (orphaned)\", more))\n  1113\t\t\t\t}\n  1114\t\t\t\tif report.Error != \"\" {\n  1115\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1116\t\t\t\t\t// The shim's own words go into the record, not only the\n  1117\t\t\t\t\t// generic failure (review round 10, N3).\n  1118\t\t\t\t\tif safety != nil {\n  1119\t\t\t\t\t\tsafety.Limitations = append(safety.Limitations, \"the review run shim could not end the whole subtree: \"+report.Error)\n  1120\t\t\t\t\t}\n  1121\t\t\t\t}\n  1122\t\t\t}\n  1123\t\t}\n  1124\t\tif len(reaped) > 0 && safety != nil {\n  1125\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n  1126\t\t}\n  1127\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1128\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1129\t\t}\n  1130\t\tterminationFailed = terminationErr != nil\n  1131\t\t// The adapter exited and a child it left still held the output when\n  1132\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1133\t\t// the exit status decides (found in review).\n  1134\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1135\t\t\trunErr = nil\n  1136\t\t}\n  1137\t\ttranscript, overflow := combined.result()\n  1138\t\tsafety.CaptureComplete = !overflow\n  1139\t\tif cmd.ProcessState != nil {\n  1140\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1141\t\t}\n  1142\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n  1143\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n  1144\t\t\tsafety.CaptureComplete = false\n  1145\t\t}\n  1146\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1147\t\t\trun.Output = string(raw)\n  1148\t\t\tif run.Provenance != nil {\n  1149\t\t\t\trun.Provenance.OutputComplete = true\n  1150\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1151\t\t\t}\n  1152\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1153\t\t\t// The agent writes no output file; its stream names its final message.\n  1154\t\t\trun.Output = final\n  1155\t\t\tif run.Provenance != nil {\n  1156\t\t\t\trun.Provenance.OutputComplete = true\n  1157\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1158\t\t\t}\n  1159\t\t} else {\n  1160\t\t\trun.Output = tail(string(transcript), 20000)\n  1161\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1162\t\t\t\tsafety.CaptureComplete = false\n  1163\t\t\t}\n  1164\t\t\tif run.Provenance != nil {\n  1165\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1166\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1167\t\t\t}\n  1168\t\t}\n  1169\t\tif run.Provenance != nil {\n  1170\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n  1171\t\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n  1172\t\t}\n  1173\t\tif runErr != nil && cmd.ProcessState == nil {\n  1174\t\t\trun.Output, transcript = \"\", nil\n  1175\t\t\tif run.Provenance != nil {\n  1176\t\t\t\trun.Provenance.OutputComplete = false\n  1177\t\t\t}\n  1178\t\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n  1179\t\t}\n  1180\t\t// Raw provenance hashes above precede redaction; only complete, bounded\n  1181\t\t// redacted channels can be retained. Partial boundaries can expose a secret.\n  1182\t\tsafety.ExecutionCause = executionCause(ctx)\n  1183\t\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n  1184\t\t\tsafety.CaptureComplete = false\n  1185\t\t}\n  1186\t\tif !safety.CaptureComplete {\n  1187\t\t\ttranscript = nil\n  1188\t\t\trun.Output = \"\"\n  1189\t\t\tif run.Provenance != nil {\n  1190\t\t\t\trun.Provenance.OutputComplete = false\n  1191\t\t\t}\n  1192\t\t\tif terminationErr != nil {\n  1193\t\t\t\treturn finish(ReviewRunFailed, \"process group termination failed; descendants may remain\")\n  1194\t\t\t}\n  1195\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1196\t\t\treturn finish(ReviewRunFailed, \"adapter capture incomplete: stream/output limit or unsafe output file\")\n  1197\t\t}\n  1198\t\tcaptureStage := \"session/interrupt recognition\"\n  1199\t\tstatus, failure, captureErr := s.classifyReviewInterruption(&run, plan, transcript, runErr, ctx.Err())\n  1200\t\tif captureErr == nil {\n  1201\t\t\tvar redactErr error\n  1202\t\t\traw := transcript\n  1203\t\t\tcaptureStage = \"stdout\"\n  1204\t\t\ttranscript, redactErr = redactReviewCapture(transcript, secrets, run.sessionForRedaction, safety.StreamBytes)\n  1205\t\t\tvar output []byte\n  1206\t\t\tif redactErr == nil {\n  1207\t\t\t\tcaptureStage = \"final output\"\n  1208\t\t\t\toutput, redactErr = redactReviewCapture([]byte(run.Output), secrets, run.sessionForRedaction, safety.OutputBytes)\n  1209\t\t\t}\n  1210\t\t\trun.Output = string(output)\n  1211\t\t\tif redactErr == nil && run.Events != \"\" {\n  1212\t\t\t\tcaptureStage = \"normalized events\"\n  1213\t\t\t\t// Events are parsed from the decoded stream, where a JSON escape no longer\n  1214\t\t\t\t// hides a value: each text is redacted again after decoding.\n  1215\t\t\t\trun.eventsBytes, redactErr = redactedDelegationEvents(run.Events, raw, run.Output, secrets, run.sessionForRedaction)\n  1216\t\t\t}\n  1217\t\t\tif redactErr != nil {\n  1218\t\t\t\tcaptureErr = redactErr\n  1219\t\t\t}\n  1220\t\t}\n  1221\t\tif captureErr != nil {\n  1222\t\t\trun.Output, transcript = \"\", nil\n  1223\t\t\tsafety.CaptureComplete = false\n  1224\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1225\t\t\tif run.Provenance != nil {\n  1226\t\t\t\trun.Provenance.OutputComplete = false\n  1227\t\t\t}\n  1228\t\t\treturn finish(ReviewRunFailed, \"adapter capture failed; unredacted output withheld; \"+delegationCaptureFailure(run.Adapter, run.Events, captureStage, captureErr))\n  1229\t\t}\n  1230\t\trun.sessionForRedaction = \"\"\n  1231\t\n  1232\t\tif status != \"\" {\n  1233\t\t\t// Partial drafts are evidence only after the same containment checks.\n  1234\t\t\tafter, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n  1235\t\t\tif err != nil || !reflect.DeepEqual(diskBefore, after) {\n  1236\t\t\t\treturn finish(ReviewRunFailed, \"interrupted adapter changed or obscured the sealed worktree\")\n  1237\t\t\t}\n  1238\t\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n  1239\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1240\t\t\t}\n","exit_code":0,"status":"completed"}}
