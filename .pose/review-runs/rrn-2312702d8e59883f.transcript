{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1784,1818p' pose-mcp/internal/cli/validate.go; rg -n 'func refreshDeliveryIndex' pose-mcp/internal/cli; cat .pose/policy/delivery.json\"","aggregated_output":"func administrativeRecordsAreRegular(root string, paths []string) bool {\n\tif len(paths) == 0 {\n\t\treturn true\n\t}\n\targs := []string{\"ls-tree\", \"-z\", \"HEAD\", \"--\"}\n\tfor _, p := range paths {\n\t\tif strings.ContainsAny(p, \"\\n\\x00\") {\n\t\t\treturn false\n\t\t}\n\t\t// The working copy as well as HEAD: a regular record replaced by a link, or\n\t\t// a new link, is not a record.\n\t\tif info, err := os.Lstat(filepath.Join(root, filepath.FromSlash(p))); err == nil && !info.Mode().IsRegular() {\n\t\t\treturn false\n\t\t}\n\t\targs = append(args, \":(literal)\"+p)\n\t}\n\tout, err := gitOutputBounded(root, 8*1024*1024, args...)\n\tif err != nil {\n\t\treturn false\n\t}\n\tfor _, record := range strings.Split(string(out), \"\\x00\") {\n\t\tmeta, _, ok := strings.Cut(record, \"\\t\")\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif fields := strings.Fields(meta); len(fields) == 3 && fields[0] != \"100644\" && fields[0] != \"100755\" {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\npose-mcp/internal/cli/index.go:260:func refreshDeliveryIndex(root string, data []byte, stderr io.Writer) {\n{\n  \"schema_version\": 1,\n  \"enabled\": true,\n  \"adopted_at\": \"2026-08-04\",\n  \"results_path\": \".pose/results/delivery-validation.json\",\n  \"roots\": [\n    {\n      \"path\": \"pose-mcp/internal/cli\",\n      \"kind\": \"surface\",\n      \"profile\": \"cli-surface\",\n      \"entrypoint\": \"pose-mcp/cmd/pose/main.go\"\n    },\n    {\n      \"path\": \"pose-mcp/internal/mcpserver\",\n      \"kind\": \"contract\",\n      \"profile\": \"api-contract\",\n      \"entrypoint\": \"pose-mcp/cmd/pose/main.go\"\n    },\n    {\n      \"path\": \"pose-mcp/internal/pose\",\n      \"kind\": \"capability\",\n      \"profile\": \"composed-capability\",\n      \"entrypoint\": \"pose-mcp/cmd/pose/main.go\"\n    }\n  ],\n  \"severities\": {\n    \"unconnected-artifact\": \"error\",\n    \"unconsumed-capability\": \"error\",\n    \"surface-without-provenance\": \"error\",\n    \"surface-without-reachability\": \"error\",\n    \"undeclared-delivery\": \"error\",\n    \"stale-evidence\": \"error\",\n    \"roadmap-criterion\": \"error\"\n  }\n}\n","exit_code":0,"status":"completed"}}
