{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\nimport subprocess,json\nargs=['pose','artifact-check','--spec','pose-validate-carries-unchanged-checks','--strict','--from','dec2e64c1395fafbf8e2a78171e5437c1720bbbf','--to','481d36dfd2ea673b5f5dc58a76d3e4213dac35bf','--json']\np=subprocess.run(args,capture_output=True,text=True)\nprint('exit',p.returncode)\ntry:\n d=json.loads(p.stdout)\n print(json.dumps({k:v for k,v in d.items() if k not in ['findings','claims','observed','changesets','change_sets','tracked']})[:2500])\n print('findings',len(d.get('findings',[])))\n print('nonwarnings',json.dumps([x for x in d.get('findings',[]) if x.get('severity')\"'!='\"'warning'])[:2500])\nexcept Exception:\n print(p.stdout[-2500:])\nprint(p.stderr[-1500:])\nPY\"","aggregated_output":"exit 0\n{\"schema_version\": 1, \"input_digest\": \"sha256:e752ca50d4fd7ccfb9a047b1c0d4886763bb10cb7ceb3912ff3427d4c7856177\", \"provenance_digest\": \"sha256:02af6e247d54c2a5327d7b469a1868a063342bcd3751701d33a1c9c4af43a4c1\", \"nodes\": [{\"id\": \"artifact:.pose/adr/2026-11-22-validate-carries-unchanged-checks.md\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/adr/2026-11-22-validate-carries-unchanged-checks.md\"}}, {\"id\": \"artifact:.pose/indexes/delivery-integrity.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/indexes/delivery-integrity.json\"}}, {\"id\": \"artifact:.pose/indexes/generation.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/indexes/generation.json\"}}, {\"id\": \"artifact:.pose/indexes/spec-graph.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/indexes/spec-graph.json\"}}, {\"id\": \"artifact:.pose/results/delivery-validation.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/results/delivery-validation.json\"}}, {\"id\": \"artifact:.pose/results/pose-validate-carries-unchanged-checks-matrix.md\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/results/pose-validate-carries-unchanged-checks-matrix.md\"}}, {\"id\": \"artifact:.pose/review-attempts/0769bac216aaab18a687be1b/000001.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/review-attempts/0769bac216aaab18a687be1b/000001.json\"}}, {\"id\": \"artifact:.pose/review-attempts/0769bac216aaab18a687be1b/000001.result.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/review-attempts/0769bac216aaab18a687be1b/000001.result.json\"}}, {\"id\": \"artifact:.pose/review-attempts/13d5ae223457a0cc3cebfb52/000001.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/review-attempts/13d5ae223457a0cc3cebfb52/000001.json\"}}, {\"id\": \"artifact:.pose/review-attempts/13d5ae223457a0cc3cebfb52/000001.result.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/review-attempts/13d5ae223457a0cc3cebfb52/000001.result.json\"}}, {\"id\": \"artifact:.pose/review-attempts/16c2f198ef2daa4bc886b81b/000001.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/review-attempts/16c2f198ef2daa4bc886b81b/000001.json\"}}, {\"id\": \"artifact:.pose/review-attempts/16c2f198ef2daa4bc886b81b/000001.result.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/review-attempts/16c2f198ef2daa4bc886b81b/000001.result.json\"}}, {\"id\": \"artifact:.pose/review-attempts/1c024e388d325dc56d77af3c/000001.json\", \"type\": \"artifact\", \"attributes\": {\"path\": \".pose/review-attempts/1c024e388d325dc56d77af3c/000001.json\"}}, {\"id\": \"artifact:.pose/rev\nfindings 985\nnonwarnings []\n\n","exit_code":0,"status":"completed"}}
