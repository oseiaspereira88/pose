{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '540,628p' pose-mcp/internal/cli/validate_carry_test.go; sed -n '1110,1282p' pose-mcp/internal/cli/validate_carry_test.go; sed -n '1045,1090p' pose-mcp/internal/cli/validate.go\"","aggregated_output":"\tfor _, deps := range []string{`[\"a\",\".\"]`, `[\".\",\"a\"]`} {\n\t\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":`+deps+`}}}`)\n\t\tf.write(\"a/nested/go.mod\", \"module nested\\n\")\n\t\tf.commit(\"nested module\")\n\t\tf.write(\"a/nested/changed.go\", \"package nested\\n\")\n\t\tf.commit(\"change nested\")\n\t\t_, out := runValidate(t, f.root, \"--changed-from\", \"HEAD~1\", \"--changed-to\", \"HEAD\", \"--explain\")\n\t\tif !strings.Contains(out, \"+ b: declared dependency \") {\n\t\t\tt.Fatalf(\"dependsOn %s: b must be selected whatever the order: %s\", deps, out)\n\t\t}\n\t}\n}\n\n// A run whose HEAD moved binds no material (review round 5, N12).\nfunc TestValidateHeadMovingDuringTheRunBindsNoMaterial(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.write(\".pose/specs/2026-11-23-carry-fixture.md\", \"---\\nslug: carry-fixture\\nstatus: in-progress\\ncreated_at: 2026-11-23\\n---\\n\\n# Spec: carry-fixture\\n\\n## 3. Technical Plan\\n\\n### Artifacts\\n- created: a/feature.go\\n\")\n\tf.write(\"a/feature.go\", \"package a\\n\")\n\tf.git(\"add\", \"-A\")\n\tf.git(\"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-qm\", \"feature\\n\\nPOSE-Spec: carry-fixture\")\n\tif _, out, run := f.validate(); len(run.MaterialProvenance) == 0 {\n\t\tt.Fatalf(\"the fixture must bind material for this test to mean anything: %s\", out)\n\t}\n\tf.commit(\"record\")\n\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\tcommit := `git -C .. -c user.name=t -c user.email=t@t -c core.hooksPath=/dev/null commit -q --allow-empty -m moved`\n\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\":{\"go\":{\"checks\":[`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"moves\",\"program\":\"sh\",\"args\":[\"-c\",\"`+commit+`\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\":{\"go\":{\"checks\":[`, 1))\n\tf.commit(\"a check that commits\")\n\t_, _, run := f.validate()\n\tif run.MaterialClean {\n\t\tt.Fatal(\"material_clean must be false\")\n\t}\n\tfor spec, binding := range run.MaterialProvenance {\n\t\tif binding != posemodel.MaterialBindingUnavailable {\n\t\t\tt.Fatalf(\"binding of %s = %s, want unavailable when HEAD moved\", spec, binding)\n\t\t}\n\t}\n}\n\n// Two modules on one physical directory alias each other (review round 5,\n// N13); a case alias cannot be made on this filesystem, so stat is faked.\nfunc TestCarryRefusesModulesSharingADirectory(t *testing.T) {\n\tdir := t.TempDir()\n\tinfo, err := os.Stat(dir)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tmodules := []validationModule{{Rel: \"a\", Abs: \"/repo/a\"}, {Rel: \"A\", Abs: \"/repo/A\"}}\n\tsame := func(string) (os.FileInfo, error) { return info, nil }\n\tidentity := func(p string) (string, error) { return p, nil }\n\tif reason := aliasedModule(modules, identity, same); !strings.Contains(reason, \"shares its directory\") {\n\t\tt.Fatalf(\"reason = %q, want modules sharing a directory refused\", reason)\n\t}\n\tdistinct := func(p string) (os.FileInfo, error) { return os.Stat(map[string]string{\"/repo/a\": dir, \"/repo/A\": t.TempDir()}[p]) }\n\tif reason := aliasedModule(modules, identity, distinct); reason != \"\" {\n\t\tt.Fatalf(\"distinct directories refused: %q\", reason)\n\t}\n}\n\n// Selection uses the head pinned before planning, not whatever HEAD is later\n// (review round 5, N14).\nfunc TestCarryPlansAgainstThePinnedHead(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.baseline()\n\tpinned := f.git(\"rev-parse\", \"HEAD\")\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"a change after the pin\")\n\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\tmatrix, err := parseValidationMatrix(raw)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tmodules, err := discoverValidationModules(f.root)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdigest := sha256.Sum256(raw)\n\tplan := planCarry(f.root, carryResults, \"strict\", \"sha256:\"+hex.EncodeToString(digest[:]), pinned, matrix, modules)\n\tif plan.record.Used && len(plan.record.Selected) != 0 {\n\t\tt.Fatalf(\"selected = %v, want nothing changed up to the pinned head\", plan.record.Selected)\n\t}\n\tif !plan.record.Used && !strings.Contains(plan.record.Reason, \"engine\") {\n\t\tt.Fatalf(\"carry unused for an unexpected reason: %q\", plan.record.Reason)\n\t}\n}\n\n// A discovered dependency above the changed module selects its dependents\n// (review round 6, N15), and so does a discovered root dependency.\nfunc TestChangedScopeDiscoveredAncestorDependencySelectsItsDependents(t *testing.T) {\n\t}\n\tif sub := submodulesCheckedOut(f.root, \"HEAD\"); sub != \"b/data\" {\n\t\tt.Fatalf(\"submodulesCheckedOut = %q, want b/data\", sub)\n\t}\n}\n\n// A condition that holds only at the end of the run does not make it clean:\n// a hidden index entry cleared during the run (review round 14, N40).\nfunc TestValidateConditionClearedDuringTheRunIsNotClean(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.write(\"b/input\", \"x\\n\")\n\tf.commit(\"b input\")\n\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\tscript := `git -C .. update-index --no-skip-worktree b/input`\n\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\"`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"clears\",\"program\":\"sh\",\"args\":[\"-c\",\"`+script+`\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\"`, 1))\n\tf.commit(\"a check that clears the flag\")\n\tf.git(\"update-index\", \"--skip-worktree\", \"b/input\")\n\t_, out, run := f.validate()\n\tif run.MaterialClean {\n\t\tt.Fatalf(\"material_clean = true although the run started with a hidden index entry: %s\", out)\n\t}\n}\n\n// A submodule moved away and back while checks ran is movement (review round\n// 15, N43).\nfunc TestValidateSubmoduleMovingAndReturningIsNotClean(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tsub := filepath.Join(f.root, \"b\", \"sub\")\n\tif err := os.MkdirAll(sub, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit := func(dir string, args ...string) {\n\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\t\tcmd.Env = append(os.Environ(), \"GIT_AUTHOR_NAME=t\", \"GIT_AUTHOR_EMAIL=t@t\", \"GIT_COMMITTER_NAME=t\", \"GIT_COMMITTER_EMAIL=t@t\", \"GIT_CONFIG_GLOBAL=/dev/null\")\n\t\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t}\n\tgit(sub, \"init\", \"-q\")\n\tgit(sub, \"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-q\", \"--allow-empty\", \"-m\", \"one\")\n\tgit(sub, \"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-q\", \"--allow-empty\", \"-m\", \"two\")\n\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\tscript := `git -C ../b/sub checkout -q HEAD~1 && git -C ../b/sub checkout -q -`\n\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\"`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"moves\",\"program\":\"sh\",\"args\":[\"-c\",\"`+script+`\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\"`, 1))\n\tf.commit(\"submodule and a check that moves it\")\n\tif !validationMaterialClean(f.root, f.git(\"rev-parse\", \"HEAD\")) {\n\t\tt.Fatal(\"the fixture must start clean for this test to mean anything\")\n\t}\n\t_, out, run := f.validate()\n\tif run.MaterialClean {\n\t\tt.Fatalf(\"material_clean = true although the submodule moved and came back: %s\", out)\n\t}\n}\n\n// A run-level cancellation refuses the base even when no check recorded it\n// (review round 15, N45).\nfunc TestCarryRefusesABaseCancelledAtRunLevel(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.baseline()\n\traw, _ := os.ReadFile(filepath.Join(f.root, carryResults))\n\tvar run map[string]any\n\t_ = json.Unmarshal(raw, &run)\n\trun[\"cancelled\"] = true\n\tout, _ := json.Marshal(run)\n\tf.write(carryResults, string(out))\n\tf.commit(\"cancelled base\")\n\t_, _, result := f.validate(\"--carry\")\n\tif result.Carry == nil || result.Carry.Used || !strings.Contains(result.Carry.Reason, \"cancelled\") {\n\t\tt.Fatalf(\"carry = %+v, want a run-level cancelled base refused\", result.Carry)\n\t}\n}\n\n// Working module metadata that differs from HEAD's refuses the carry (review\n// round 16, N46).\nfunc TestCarryRefusesWorkingMetadataThatDiffersFromHead(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"a\"]}}}`)\n\tf.baseline()\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"change a\")\n\tf.write(\".pose/indexes/module-metadata.json\", `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true}}}`)\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"module metadata differs\") {\n\t\tt.Fatalf(\"carry = %+v, want uncommitted metadata refused\", run.Carry)\n\t}\n}\n\n// A cancelled run binds no material (review round 16, N47).\nfunc TestCancellationMakesBindingsUnavailable(t *testing.T) {\n\trun := validationRunResult{MaterialClean: true, MaterialProvenance: map[string]string{\"s\": \"sha256:abc\"}}\n\tif !finalizeCancellation(&run) || run.MaterialClean || run.MaterialProvenance[\"s\"] != posemodel.MaterialBindingUnavailable {\n\t\tt.Fatalf(\"run = %+v, want a cancelled run unclean with unavailable bindings\", run)\n\t}\n}\n\n// A submodule with nested submodules makes the run unclean (review round 16,\n// N48).\nfunc TestValidateNestedSubmodulesAreNotClean(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tsub := filepath.Join(f.root, \"b\", \"sub\")\n\tif err := os.MkdirAll(sub, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit := func(dir string, args ...string) string {\n\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\t\tcmd.Env = append(os.Environ(), \"GIT_AUTHOR_NAME=t\", \"GIT_AUTHOR_EMAIL=t@t\", \"GIT_COMMITTER_NAME=t\", \"GIT_COMMITTER_EMAIL=t@t\", \"GIT_CONFIG_GLOBAL=/dev/null\")\n\t\tout, err := cmd.CombinedOutput()\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t\treturn strings.TrimSpace(string(out))\n\t}\n\tgit(sub, \"init\", \"-q\")\n\tgit(sub, \"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-q\", \"--allow-empty\", \"-m\", \"one\")\n\tinner := git(sub, \"rev-parse\", \"HEAD\")\n\tgit(sub, \"update-index\", \"--add\", \"--cacheinfo\", \"160000,\"+inner+\",nested\")\n\tgit(sub, \"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-q\", \"-m\", \"nested gitlink\")\n\tif err := os.MkdirAll(filepath.Join(sub, \"nested\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.commit(\"submodule with a nested submodule\")\n\thead := f.git(\"rev-parse\", \"HEAD\")\n\tif !materialWorktreeClean(f.root) || submodulesCheckedOut(f.root, head) != \"\" {\n\t\tt.Fatal(\"the fixture must pass every other condition for this test to mean anything\")\n\t}\n\tif validationMaterialClean(f.root, head) {\n\t\tt.Fatal(\"a submodule with nested submodules must not read as clean material\")\n\t}\n}\n\n// The carry selects with one metadata snapshot read from the pinned commit,\n// never rereading the working copy (review round 17, N50).\nfunc TestCarrySelectsWithThePinnedMetadataSnapshot(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"a\"]}}}`)\n\thead := f.git(\"rev-parse\", \"HEAD\")\n\tf.write(\".pose/indexes/module-metadata.json\", `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true}}}`)\n\tmeta, err := scopeMetadataAt(f.root, head)\n\tif err != nil || len(meta.Modules[\"b\"].DependsOn) != 1 {\n\t\tt.Fatalf(\"metadata at %s = %+v (%v), want the committed dependency\", head, meta, err)\n\t}\n\tmodules, err := discoverValidationModules(f.root)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tsel, err := computeChangedScopeWith(f.root, \"HEAD\", \"\", modules, meta)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, ok := sel.Selected[\"b\"]; !ok {\n\t\tt.Fatalf(\"selected = %v, want b selected through the snapshot's dependency despite the edited working metadata\", sel.Selected)\n\t}\n}\n\n// A committed metadata blob that cannot be read is an error, never an empty\n// policy (review round 18, N52).\nfunc TestCarryRefusesAnUnreadableMetadataBlob(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"a\"]}}}`)\n\thead := f.git(\"rev-parse\", \"HEAD\")\n\tblob := strings.Fields(f.git(\"ls-tree\", head, \"--\", \".pose/indexes/module-metadata.json\"))[2]\n\tobject := filepath.Join(f.root, \".git\", \"objects\", blob[:2], blob[2:])\n\tif err := os.Remove(object); err != nil {\n\t\tt.Fatalf(\"the fixture keeps the blob loose: %v\", err)\n\t}\n\tif _, err := scopeMetadataAt(f.root, head); err == nil {\n\t\tt.Fatal(\"an unreadable metadata blob must be an error\")\n\t}\n\tif err := os.Remove(filepath.Join(f.root, \".pose/indexes/module-metadata.json\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif differs, err := workingFileDiffersFromHead(f.root, head, \".pose/indexes/module-metadata.json\"); err == nil && !differs {\n\t\tt.Fatal(\"an absent working file over an unreadable committed blob must not read as equal\")\n\t}\n}\n\t}\n\tstartReflog := movementWitness(root, pinnedHead)\n\t// The working copy must match the pinned head before the plan inputs are\n\t// read, by the same full predicate checked at the end: status, hidden\n\t// index entries and submodule checkouts (review round 14, N40 and N41).\n\tstartedClean := pinnedHead != \"\" && validationMaterialClean(root, pinnedHead)\n\tmatrixPath := filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\")\n\traw, err := os.ReadFile(matrixPath)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: validation matrix not found at %s\\n\", \"Erro: matriz de validação não encontrada em %s\\n\"), matrixPath)\n\t\treturn 2\n\t}\n\tmatrix, err := parseValidationMatrix(raw)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid validation matrix: %v\\n\", \"Erro: matriz de validação inválida: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif err := validateStructuredMatrixPaths(matrix); err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid validation matrix path: %v\\n\", \"Erro: path inválido na matriz de validação: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif err := validateDeliveryMatrixContract(matrix); err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid delivery validation contract: %v\\n\", \"Erro: contrato de validação de delivery inválido: %v\\n\"), err)\n\t\treturn 2\n\t}\n\tif matrixHasLegacyChecks(matrix) {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: legacy shell 'command' checks are unsupported; migrate each check to program + args + env.\", \"Erro: checks shell legados em 'command' não são suportados; migre cada check para program + args + env.\"))\n\t\treturn 2\n\t}\n\tif mode == \"\" {\n\t\tmode = matrix.Defaults.Mode\n\t\tif mode == \"\" {\n\t\t\tmode = \"strict\"\n\t\t}\n\t}\n\tmodules, err := discoverValidationModules(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: discovering modules: %v\\n\", \"Erro: descobrir módulos: %v\\n\"), err)\n\t\treturn 1\n\t}\n\tif workspaceFilter != \"\" {\n\t\tresolved, ok := resolveWorkspaceModulePath(root, modules, workspaceFilter)\n\t\tif !ok {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: no module's manifest name matches --workspace %q.\\n\", \"Erro: nenhum module tem name de manifesto igual a --workspace %q.\\n\"), workspaceFilter)\n\t\t\treturn 2\n\t\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_28","type":"agent_message","text":"The carried-head parser test and selected race tests also passed. The artifact check resolved a range wider than the sealed subject, so I’ve started a second reconciliation pinned to the requested base and head. The surface check is still running, and the checkout remains clean."}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '875,955p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '270,292p' pose-mcp/internal/cli/surface_check.go; rg -n 'func artifactFindingsFail|strict.*finding|finding.Severity' pose-mcp/internal/cli/artifact_integrity.go | tail -8; rg -n 'func administrativeRecordsAreRegular' pose-mcp/internal/cli/validate.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '875,955p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '270,292p' pose-mcp/internal/cli/surface_check.go; rg -n 'func artifactFindingsFail|strict.*finding|finding.Severity' pose-mcp/internal/cli/artifact_integrity.go | tail -8; rg -n 'func administrativeRecordsAreRegular' pose-mcp/internal/cli/validate.go\"","aggregated_output":"\t}\n\tgraph := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), []posemodel.Spec{*full}, claims, sets, tracked, policy, posemodel.LoadArchivedFragments(root), removals)\n\tif err := applyArtifactAttributions(posemodel.NativeFiles(), root, specs, &graph); err != nil {\n\t\trender(stdout, stderr).Failure(\"pose artifact-check: \" + err.Error())\n\t\treturn 1\n\t}\n\tfor _, claim := range claims {\n\t\tif claim.Action == \"none\" {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{claim.Path}\n\t\tif claim.Action == \"renamed\" {\n\t\t\tpaths = []string{claim.OldPath, claim.NewPath}\n\t\t}\n\t\tfor _, path := range paths {\n\t\t\tif err := posemodel.ValidateArtifactPath(root, path, false); err != nil {\n\t\t\t\tseverity := policy.Severities[\"resolvability\"]\n\t\t\t\tif severity == \"\" {\n\t\t\t\t\tseverity = \"warning\"\n\t\t\t\t}\n\t\t\t\tgraph.Findings = append(graph.Findings, posemodel.NewDeliveryIntegrityFinding(\"resolvability\", severity, spec, path, set.ID, err.Error(), \"declare an exact confined tracked file path\"))\n\t\t\t}\n\t\t}\n\t}\n\tsort.Slice(graph.Findings, func(i, j int) bool { return graph.Findings[i].ID < graph.Findings[j].ID })\n\tif jsonOutput {\n\t\t_ = writeJSON(stdout, graph)\n\t} else {\n\t\t// The change set's provenance is what an operator needs first when\n\t\t// `observed` exceeds `claims`: which revisions were attributed, and how\n\t\t// many commits they span. Hiding it behind --json leaves the default\n\t\t// output advising \"narrow the attributed change set\" without saying what\n\t\t// the change set is (spec pose-diagnose-invisible-governance-failures).\n\t\tfmt.Fprintf(stdout, \"artifact.spec=%s\\nartifact.change_set=%s\\nartifact.change_set.base=%s\\nartifact.change_set.head=%s\\nartifact.change_set.commits=%d\\nartifact.diff_digest=%s\\nartifact.claims=%d\\nartifact.observed=%d\\nartifact.findings=%d\\n\",\n\t\t\tspec, set.ID, set.ResolvedBase, set.ResolvedHead, len(set.Commits), set.DiffDigest, len(claims), len(set.Paths), len(graph.Findings))\n\t\t// A claim resolved through a release names a path that is no longer\n\t\t// there; say where it went, or the pass reads as magic (spec\n\t\t// pose-release-archival-attested-by-the-ledger).\n\t\tfor _, a := range graph.Archivals {\n\t\t\tfmt.Fprintf(stdout, \"artifact.archived=%s -> %s (release %s)\\n\", a.Pending, a.Archived, a.Version)\n\t\t}\n\t\tfor _, finding := range graph.Findings {\n\t\t\trender(stdout, stderr).Finding(cliout.Finding{\n\t\t\t\tState: cliout.StateFromKey(finding.Severity), Code: finding.Code, Path: finding.Path,\n\t\t\t\tMessage: finding.Message, Remediation: finding.Remediation,\n\t\t\t})\n\t\t}\n\t}\n\tif strict {\n\t\tfor _, finding := range graph.Findings {\n\t\t\tif finding.Severity == \"error\" || finding.Severity == \"critical\" {\n\t\t\t\tif !jsonOutput {\n\t\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\t}\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t}\n\tif deliveryGraph, err := buildCurrentDeliveryGraph(root); err == nil {\n\t\tif raw, err := deliveryGraph.IndexJSON(); err == nil {\n\t\t\trefreshDeliveryIndex(root, append(raw, '\\n'), stderr)\n\t\t}\n\t}\n\treturn 0\n}\n\ntype artifactBackfillProposal struct {\n\tSchemaVersion int                                 `json:\"schema_version\"`\n\tDryRun        bool                                `json:\"dry_run\"`\n\tSpecs         map[string][]posemodel.ObservedPath `json:\"specs\"`\n\tConfidence    map[string]string                   `json:\"confidence\"`\n\tConflicts     map[string][]string                 `json:\"conflicts\"`\n}\n\nfunc cmdArtifactBackfill(root string, args []string, stdout, stderr io.Writer) int {\n\tapply, confirm, fromGit := false, false, false\n\tfor _, arg := range args {\n\t\tswitch arg {\n\t\tcase \"--from-git\":\n\t\t\tfromGit = true\n\t\tcase \"--apply\":\n\t}\n\treturn deliveryFindingExit(graph.Findings, strict)\n}\n\nfunc cmdRoadmapCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tif len(args) == 0 {\n\t\treturn usageError(stderr, \"Usage: pose roadmap-check <slug> [--strict|--tolerant] [--json]\")\n\t}\n\tslug := args[0]\n\tstrict, jsonOutput := true, false\n\tfor _, arg := range args[1:] {\n\t\tswitch arg {\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose roadmap-check <slug> [--strict|--tolerant] [--json]\")\n\t\t}\n\t}\n\tif posemodel.ValidateSlug(slug) != nil {\n918:\t\t\t\tState: cliout.StateFromKey(finding.Severity), Code: finding.Code, Path: finding.Path,\n925:\t\t\tif finding.Severity == \"error\" || finding.Severity == \"critical\" {\n1784:func administrativeRecordsAreRegular(root string, paths []string) bool {\n","exit_code":0,"status":"completed"}}
