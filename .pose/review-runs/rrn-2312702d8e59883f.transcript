{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '215,315p' pose-mcp/internal/cli/validate_carry.go; sed -n '1090,1170p' pose-mcp/internal/cli/validate.go; sed -n '1455,1505p' pose-mcp/internal/cli/validate.go; sed -n '1610,1648p' pose-mcp/internal/cli/validate.go; sed -n '1710,1752p' pose-mcp/internal/cli/validate.go; sed -n '185,228p' pose-mcp/internal/cli/validate_scope.go\"","aggregated_output":"\t}\n\tselection, err := computeChangedScopeWith(root, base.GitHead, head, modules, meta, carryExclusions(root, base.GitHead, head, resultsPath)...)\n\tif err != nil {\n\t\treturn unused(\"changed-scope selection failed: %v\", err)\n\t}\n\tplan.base = map[string]checkResult{}\n\tfor _, check := range base.Checks {\n\t\tplan.base[check.ID] = check\n\t}\n\t// A module whose checks are not all in the base runs (R3).\n\tfor _, module := range modules {\n\t\tif _, selected := selection.Selected[module.Rel]; selected {\n\t\t\tcontinue\n\t\t}\n\t\tstack, checks, _ := moduleValidationChecks(module, matrix, \"\", \"\")\n\t\tfor _, check := range checks {\n\t\t\tif check.Program == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n\t\t\tif prior, ok := plan.base[id]; !ok || prior.Outcome == \"skipped\" || prior.Outcome == \"\" {\n\t\t\t\tselection.Selected[module.Rel] = \"carry: no prior result for \" + id\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\tplan.selection, plan.baseHead, plan.baseTime = &selection, base.GitHead, base.GeneratedAt\n\tplan.record.Used, plan.record.BaseHead, plan.record.Changed, plan.record.Selected = true, base.GitHead, len(selection.Changed), selection.Selected\n\treturn plan\n}\n\n// carryExclusions are the changed paths that are not changes for the carry\n// selection (R3): the canonical result itself and the derived administrative\n// records of the engine's closed list (the same classes material bindings\n// ignore) that are still regular files, or gone, at HEAD. A symlink,\n// submodule or directory in a class stays a change.\nfunc carryExclusions(root, base, head, resultsPath string) []string {\n\texclude := []string{resultsPath}\n\tout, err := posemodel.RawGit(\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base, head, \"--\").Output()\n\tif err != nil {\n\t\treturn exclude\n\t}\n\tfor _, file := range strings.Split(string(out), \"\\x00\") {\n\t\tfile = filepath.ToSlash(file)\n\t\tif file == \"\" || !posemodel.IsAdministrativePath(file) {\n\t\t\tcontinue\n\t\t}\n\t\tentry, err := posemodel.RawGit(\"-C\", root, \"ls-tree\", \"-z\", head, \"--\", file).Output()\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tfields := strings.Fields(string(entry))\n\t\tif len(fields) == 0 || fields[0] == \"100644\" || fields[0] == \"100755\" {\n\t\t\texclude = append(exclude, file)\n\t\t}\n\t}\n\treturn exclude\n}\n\n// validationEngineIdentity names the engine that ran a validation: its version\n// plus, when the binary records it, the VCS revision it was built from, marked\n// when the build tree was modified. Development builds share a version string,\n// so the revision is what tells two of them apart (R2).\nfunc validationEngineIdentity() string {\n\tidentity, _ := engineIdentityFrom(debug.ReadBuildInfo())\n\treturn identity\n}\n\n// engineIdentityFrom builds the identity from build information. A build of a\n// modified tree is not verifiable: two such builds at one revision share an\n// identity while their code differs (review round 2, N4).\nfunc engineIdentityFrom(info *debug.BuildInfo, ok bool) (string, bool) {\n\tidentity := version.Version\n\tif !ok || info == nil {\n\t\treturn identity, true\n\t}\n\trevision, modified := \"\", false\n\tfor _, setting := range info.Settings {\n\t\tswitch setting.Key {\n\t\tcase \"vcs.revision\":\n\t\t\trevision = setting.Value\n\t\tcase \"vcs.modified\":\n\t\t\tmodified = setting.Value == \"true\"\n\t\t}\n\t}\n\tif revision != \"\" {\n\t\tidentity += \"+\" + revision\n\t\tif modified {\n\t\t\tidentity += \".dirty\"\n\t\t}\n\t}\n\treturn identity, !modified\n}\n\n// aliasedModule names a module whose changes cannot be attributed lexically:\n// one reached through a symlink, or one sharing its physical directory with\n// another module, as a case alias does on a case-insensitive filesystem\n// (review rounds 4–5, N9 and N13).\nfunc aliasedModule(modules []validationModule, resolve func(string) (string, error), stat func(string) (os.FileInfo, error)) string {\n\tseen := make([]os.FileInfo, 0, len(modules))\n\tfor _, module := range modules {\n\t\t}\n\t\tmoduleFilter = resolved\n\t}\n\tknownModules := map[string]bool{}\n\tfor _, module := range modules {\n\t\tknownModules[module.Rel] = true\n\t}\n\tfor rel, override := range matrix.ModuleOverrides {\n\t\tclean := filepath.ToSlash(filepath.Clean(rel))\n\t\tif clean == \"..\" || strings.HasPrefix(clean, \"../\") || filepath.IsAbs(rel) {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: moduleOverrides contains a path outside the project: %s\\n\", \"Erro: moduleOverrides contém path fora do projeto: %s\\n\"), rel)\n\t\t\treturn 2\n\t\t}\n\t\tif knownModules[clean] {\n\t\t\tif override.Stack != \"\" {\n\t\t\t\tfor idx := range modules {\n\t\t\t\t\tif modules[idx].Rel == clean {\n\t\t\t\t\t\tmodules[idx].Stack = override.Stack\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tabs := filepath.Join(root, filepath.FromSlash(clean))\n\t\tif info, err := os.Stat(abs); err == nil && info.IsDir() {\n\t\t\tstack := override.Stack\n\t\t\tif stack == \"\" {\n\t\t\t\tstack = \"contract\"\n\t\t\t}\n\t\t\tmodules = append(modules, validationModule{Rel: clean, Abs: abs, Stack: stack})\n\t\t\tknownModules[clean] = true\n\t\t}\n\t}\n\tsort.Slice(modules, func(i, j int) bool { return modules[i].Rel < modules[j].Rel })\n\tvar scope *scopeSelection\n\tif changedTo != \"\" && changedFrom == \"\" {\n\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --changed-to requires --changed-from.\", \"Erro: --changed-to exige --changed-from.\"))\n\t\treturn 2\n\t}\n\tif changedFrom != \"\" {\n\t\tsel, err := computeChangedScope(root, changedFrom, changedTo, modules)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: changed-scope selection: %v\\n\", \"Erro: seleção por escopo alterado: %v\\n\"), err)\n\t\t\treturn 2\n\t\t}\n\t\tscope = &sel\n\t\tif explain {\n\t\t\tfmt.Fprintf(stdout, \"[changed-scope] %s: %d changed file(s), %d/%d module(s) selected\\n\", sel.rangeLabel(), len(sel.Changed), len(sel.Selected), len(modules))\n\t\t\tfor _, m := range modules {\n\t\t\t\tif reason, ok := sel.Selected[m.Rel]; ok {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  + %s: %s\\n\", m.Rel, reason)\n\t\t\t\t} else {\n\t\t\t\t\tfmt.Fprintf(stdout, \"  - %s: not affected by %s\\n\", m.Rel, sel.rangeLabel())\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\trun := validationRunResult{\n\t\tSchemaVersion: validationResultSchema,\n\t\tGeneratedAt:   time.Now().UTC().Format(time.RFC3339),\n\t\tMode:          mode,\n\t\tStackFilter:   stackFilter,\n\t\tModuleFilter:  moduleFilter,\n\t\tChecks:        []checkResult{},\n\t}\n\tmatrixDigest := sha256.Sum256(raw)\n\trun.MatrixSHA256 = \"sha256:\" + hex.EncodeToString(matrixDigest[:])\n\trun.EngineVersion = validationEngineIdentity()\n\t// The head is pinned before anything is planned: selection, carried\n\t// results and the end-of-run comparison all name this one commit (review\n\t// round 5, N14).\n\trun.GitHead = pinnedHead\n\tvar carryState carryPlan\n\tif carry {\n\t\tcarryState = planCarry(root, canonicalResultsPath, mode, run.MatrixSHA256, run.GitHead, matrix, modules)\n\t\trun.Carry = carryState.record\n\t\tout := render(stdout, stderr)\n\t\tif !carryState.record.Used {\n\t\t\tout.ContractLine(\"[carry] full run: \" + carryState.record.Reason)\n\t\t} else {\n\t\t\tout.ContractLine(fmt.Sprintf(\"[carry] base %s: %d changed file(s), %d/%d module(s) run\", carryState.record.BaseHead, carryState.record.Changed, len(carryState.record.Selected), len(modules)))\n\t\tfor spec := range run.MaterialProvenance {\n\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n\t\t}\n\t}\n\t// A cancelled run never reads as a success, whatever the severity of the\n\t// checks it stopped (review round 1, B5).\n\t// A signal cancels the run even when no executed check saw it, as in an\n\t// all-carried run (review round 15, N45).\n\tcancelled := runCtx.Err() != nil\n\tfor _, check := range run.Checks {\n\t\tcancelled = cancelled || check.LimitState == \"cancelled\"\n\t}\n\tif cancelled {\n\t\trun.Cancelled = finalizeCancellation(&run)\n\t}\n\tfor _, line := range validationTimingNotes(run) {\n\t\tsteps.Note(line)\n\t}\n\tsteps.Summary()\n\tif executed == 0 && run.Counts.Carried == 0 {\n\t\tfmt.Fprintln(stdout, \"No modules/checks matched the matrix and filters.\")\n\t}\n\tresult := \"pass\"\n\tif cancelled {\n\t\tfailures++\n\t\tresult = \"fail\"\n\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"validation cancelled\", \"validação cancelada\")})\n\t} else if failures > 0 {\n\t\tresult = \"fail\"\n\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"required check failed\", \"check obrigatório falhou\")})\n\t} else {\n\t\tif optionalFailures > 0 {\n\t\t\tresult = \"partial\"\n\t\t\tr.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"optional-check\",\n\t\t\t\tMessage: fmt.Sprintf(cliText(locale, \"%d optional check(s) failed\", \"%d check(s) opcional(is) falharam\"), optionalFailures)})\n\t\t}\n\t\tr.Verdict(cliout.Verdict{State: cliout.StatePass})\n\t}\n\trun.Outcome = result\n\tusageFindings := make([]usageFinding, 0, run.Counts.Failed+run.Counts.OptionalFailed+run.Counts.Errored)\n\tfor _, check := range run.Checks {\n\t\tif check.Outcome != \"fail\" && check.Outcome != \"error\" {\n\t\t\tcontinue\n\t\t}\n\t\tseverity := check.Severity\n\t\tif check.Outcome == \"error\" {\n\t\t\tseverity = \"error\"\n\t\t}\n\t\tusageFindings = append(usageFindings, usageFinding{ID: check.ID, Severity: severity})\n\t}\n\tnoteUsageFindings(stdout, result, usageFindings, true)\n// why it failed, with the full output one path away.\nfunc tailLines(text string, n int) string {\n\tlines := strings.Split(strings.TrimRight(text, \"\\n\"), \"\\n\")\n\tif len(lines) <= n {\n\t\treturn strings.Join(lines, \"\\n\")\n\t}\n\treturn strings.Join(lines[len(lines)-n:], \"\\n\")\n}\n\nfunc validationSummaryOf(run validationRunResult) *validationSummary {\n\tsummary := &validationSummary{Outcome: run.Outcome}\n\tfor _, check := range run.Checks {\n\t\tcommand := strings.TrimSpace(check.Program + \" \" + strings.Join(check.Args, \" \"))\n\t\tif check.Outcome != \"skipped\" && command != \"\" {\n\t\t\tsummary.Commands = append(summary.Commands, command)\n\t\t}\n\t\tline := \"- [\" + check.Outcome + \"] \" + check.ID\n\t\tswitch {\n\t\tcase check.SkipReason != \"\":\n\t\t\tline += \" (\" + check.SkipReason + \")\"\n\t\tcase check.DurationSeconds > 0:\n\t\t\tline += fmt.Sprintf(\" (%.1fs)\", check.DurationSeconds)\n\t\t}\n\t\tif check.ExitCode != nil {\n\t\t\tline += fmt.Sprintf(\" exit=%d\", *check.ExitCode)\n\t\t}\n\t\tsummary.Results = append(summary.Results, line)\n\t}\n\t// The report records the run's verdict too, built from the outcome rather\n\t// than copied from the printed line, so the recorded evidence keeps its\n\t// shape while the terminal is free to change.\n\tif run.Counts.OptionalFailed > 0 {\n\t\tsummary.Results = append(summary.Results, fmt.Sprintf(\"Warning: %d optional check(s) failed.\", run.Counts.OptionalFailed))\n\t}\n\tswitch run.Outcome {\n\tcase \"fail\":\n\t\tsummary.Results = append(summary.Results, \"Result: FAILURE (required check failed)\")\n\tdefault:\n\t\tsummary.Results = append(summary.Results, \"Result: SUCCESS\")\n\t\t}\n\t}\n\treturn newArgs\n}\n\n// materialWorktreeClean reports whether the working copy equals HEAD in every\n// path outside the administrative classes, untracked files included. A status\n// that cannot be read is not clean.\nfunc materialWorktreeClean(root string) bool {\n\t// Mode changes count whatever core.fileMode says (review round 13, N36).\n\tout, err := gitOutputBounded(root, 16*1024*1024, \"-c\", \"core.fileMode=true\", \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n\tif err != nil {\n\t\treturn false\n\t}\n\trecords := strings.Split(string(out), \"\\x00\")\n\tvar administrative []string\n\tfor i := 0; i < len(records); i++ {\n\t\trecord := records[i]\n\t\tif len(record) < 4 {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{record[3:]}\n\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n\t\t\t// A rename or copy carries its source as the next record.\n\t\t\tif i+1 < len(records) {\n\t\t\t\ti++\n\t\t\t\tpaths = append(paths, records[i])\n\t\t\t}\n\t\t}\n\t\tfor _, p := range paths {\n\t\t\tif !posemodel.IsAdministrativePath(p) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tadministrative = append(administrative, p)\n\t\t}\n\t}\n\treturn administrativeRecordsAreRegular(root, administrative)\n}\n\n// materialTrackedUnchanged reports whether no tracked file differs from HEAD\n// outside the administrative records. Untracked files are not counted: checks\n// leave build products behind, and those are not the material they ran over.\nfunc materialTrackedUnchanged(root string) bool {\n\t\t\t// through the transitive widening; any other one, discovered or not,\n\t\t\t// selects here (review round 6, N15).\n\t\t\tfor _, dep := range declaredDependencyHits(file, meta.Modules[m.Rel].DependsOn) {\n\t\t\t\tif dep != owner {\n\t\t\t\t\tselectModule(m.Rel, \"declared dependency \"+dep+\" changed: \"+file)\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif owner == \"\" && (m.Rel == \".\" || !meta.Modules[m.Rel].SelfContained) {\n\t\t\t\tselectModule(m.Rel, \"root-level change outside any module: \"+file)\n\t\t\t}\n\t\t}\n\t}\n\t// Policy widening: high-criticality modules always run.\n\tfor _, m := range modules {\n\t\tif meta.Modules[m.Rel].Criticality == \"high\" {\n\t\t\tif _, ok := sel.Selected[m.Rel]; !ok {\n\t\t\t\tsel.Selected[m.Rel] = \"policy: criticality high always runs\"\n\t\t\t}\n\t\t}\n\t}\n\t// Transitive dependents of selected modules (declared edges only).\n\tfor changed := true; changed; {\n\t\tchanged = false\n\t\tfor _, m := range modules {\n\t\t\tif _, ok := sel.Selected[m.Rel]; ok {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfor _, dep := range meta.Modules[m.Rel].DependsOn {\n\t\t\t\tif reason, ok := sel.Selected[filepath.ToSlash(filepath.Clean(dep))]; ok {\n\t\t\t\t\tsel.Selected[m.Rel] = \"depends on selected module \" + dep + \" (\" + firstScopeReason(reason) + \")\"\n\t\t\t\t\tchanged = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn sel, nil\n}\n\n// firstScopeReason keeps chained dependency reasons short and readable.\nfunc firstScopeReason(reason string) string {\n\tif i := strings.Index(reason, \" (\"); i > 0 {\n\t\treturn reason[:i]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'carry|selfContained' POSE.md locales/pt-BR/POSE.md pose-mcp/internal/cli/testdata/adversarial/README.md; rg -n 'carry|unchanged-checks' .pose/knowledge --glob '*.md'; cat pose-mcp/internal/pose/delivery_validation_run_test.go; rg -n '\"'^func Test'\"' pose-mcp/internal/cli/validate_carry_test.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'carry|selfContained' POSE.md locales/pt-BR/POSE.md pose-mcp/internal/cli/testdata/adversarial/README.md; rg -n 'carry|unchanged-checks' .pose/knowledge --glob '*.md'; cat pose-mcp/internal/pose/delivery_validation_run_test.go; rg -n '\"'^func Test'\"' pose-mcp/internal/cli/validate_carry_test.go\"","aggregated_output":"POSE.md:218:              [--changed-from rev [--changed-to rev] | --carry] [--jobs n] [--explain] [--emit-plan f]\nPOSE.md:353:  **Changed scope:** `--changed-from <rev> [--changed-to <rev>]` selects the minimum safe module set deterministically — modules containing changed files (tracked and untracked), transitive dependents via `dependsOn` edges in [`module-metadata.json`](.pose/indexes/module-metadata.json), and policy widening (criticality `high` always runs). Changed names are read NUL-delimited and a rename names both its source and its destination. Each changed file selects its most specific owning module, every module enclosing that owner (the root module encloses them all), every module beneath it (a gitlink or replaced directory changes what lies under it), and every module whose declared `dependsOn` contains it, lies beneath it or is the root `.`, even after that dependency is deleted. A file no module owns selects the root module. Module metadata that does not decode stops the selection (a full run under `--carry`, an error under `--changed-from`). A change outside every module runs every module that does not declare `\"selfContained\": true` in its metadata (uncertainty prefers safe execution; the declaration states that the module's checks read only its own directory and its `dependsOn` modules); unselected checks are recorded as skipped with the selection reason and `--explain` prints every decision. Revisions are confined to a safe grammar; without the flags, full validation is unchanged.\nPOSE.md:355:  **Carried checks:** `--carry --json-out <results_path>` refreshes the canonical result instead of rerunning the whole matrix. It uses the current canonical result as its base when the base is comparable: same schema, mode, matrix digest and `engine_version` (the engine version plus the VCS revision the binary was built from; a build of a modified tree never carries), unfiltered, not cancelled (a signal cancels the whole run, even an all-carried one), recorded `material_clean` (it validated an unchanged working copy of its own head: no tracked or untracked unignored material changed and HEAD did not move while it ran, as its reflog and every submodule's reflog show; mode changes count whatever `core.fileMode` says, and every submodule must hold its recorded commit with no nested submodule, checked both before the plan is read and when the run ends; a spec whose material the engine cannot compute stays unavailable in any clean run and does not refuse the base), with its `git_head` an ancestor of `HEAD`, a clean material working copy now, a case-sensitive filesystem with no case-folded directory on the path to a module or a dependency, no module reached through a symlink or sharing its directory with another module, no tracked symlink whose path or target lies in a module other than the root or in a declared `dependsOn` (or whose target leaves the repository), every submodule's tree included (a submodule that is not checked out or has nested submodules refuses), no declared dependency outside the repository or written as an unclean path or resolving through a symlink (tracked or ignored), only ASCII module and dependency paths, no index entry marked assume-unchanged or skip-worktree, and no check id defined twice, and working module metadata equal to HEAD's. Changed names are read with every gitlink shown, whatever the Git configuration. The head is pinned before planning, and a run whose HEAD moved records its material bindings as unavailable. It runs the modules the changed-scope rules select between the base head and `HEAD`; the canonical result file and the derived administrative records that material bindings ignore (data files that are still regular files in the derived-record directories under `.pose/`: indexes, results, state, assessments and review records; the validation matrix stays material) are not changes. A module whose checks are not all in the base also runs. Every other check keeps the base result, its outcome included, and records `carried_from` (the head it ran at, kept through chained carries) and `carried_generated_at`; the delivery index reads that head for the result, so evidence freshness judges the commit a carried check really observed. A carried failure still fails the run. Any unmet condition runs everything, and `carry.reason` says why. `carry` records the base, the number of changed files and each selected module's reason, and `counts.carried` the reused checks. `--carry` does not combine with `--module`, `--stack`, `--workspace`, `--root-only`, `--changed-from` or `--changed-to`.\nPOSE.md:371:- `review-plan` / `review-check` / `closeout-check` — resolve a deterministic component-aware plan from governed metadata, typed overlays and a closed native-tool catalog, then validate immutable attempts against both scope and plan digests. Opt in explicitly with review-policy schema v2, `component_aware: true` and `component_aware_adopted_at`; preview the migration read-only with `pose review-plan <scope> --explain` before committing the policy. Completed attempts older than that component adoption date remain auditable, while open scopes require the new plan. `pose review record` is dry-run by default, accepts `--plan-digest` to reject drift and appends with `--apply`; recommended tools are never executed implicitly. Hierarchical closeout rolls approvals through `spec:`, `milestone:` and `roadmap:` scopes. Read-only MCP: `pose_review_plan`, `pose_closeout_state`. The JSON of `closeout-check` and `pose_closeout_state` types its blockers in `diagnostics` (code, domain, refs, satisfaction condition; text blockers the engine cannot type yet are carried as `opaque`) and its next action in `next_step`; readiness `waiting_on` entries carry a `code`, and auto-attest pendencies a `code`, `source` and `condition` (spec `pose-typed-producer-diagnostics`). The prose fields stay for people; consumers read the codes.\nPOSE.md:380:- `artifact-check` — parses exact `### Artifacts` actions, resolves an explicit base/head range or `POSE-Spec: <slug>` commit trailers with safe structured Git arguments, and reports resolvability, existence, action mismatch, undeclared and orphan findings. A claim on a changelog fragment that `pose release prepare` archived resolves through the release manifest, which records the fragment's spec and digest; prepare never edits a spec. A file a later spec removes needs no longer exist for the earlier specs that declare it `created` or `modified`: their claim is satisfied — an edge `removed-by` in `delivery-integrity.json` — when the later spec declares `removed:` for the path, its attributed change sets contain a commit that deleted it (a rename is not a deletion), and every change the earlier spec made to the path — a merge, a root creation, a type change or a deletion included — is a Git ancestor of that commit; a change after the removal, a removal its spec never performed, a change set naming something other than an immutable commit, or history Git cannot read — a shallow clone included; replace refs and grafts are ignored — keeps the existence finding, and the finding says why. Commits modifying artifacts declared by a spec must carry a `POSE-Spec: <slug>` trailer in their commit message for `artifact-check` and `pose close` to attribute the changes. `pose report --change-from/--change-to` persists immutable change-set evidence; `pose index` projects claims, observations, reverse provenance and findings into `delivery-integrity.json`. The seven files `pose index` writes are one generation (spec `pose-index-generation-integrity`): their bytes are written under `generations/<id>/` in the indexes directory, the legacy names are published from the same bytes, and the descriptor `generation.json` there — SHA-256 of each file plus the digests of the inputs they were computed from — is published last and is the commit. A reader fixes the generation the descriptor names and checks each file against it: a set that does not verify (a file missing, replaced, from another generation, or a descriptor it cannot read) is `unavailable`, with the reason, never an empty or mixed result; a repository that never ran `pose index` since this contract keeps working and is reported `legacy-unversioned`, with no claim of coherence. A generated index edited by hand has no effect while the generation's copy exists (readers read the generation), and in a clone without the copy it makes the set unavailable; either way `pose index --verify` names the file. `pose index --verify` reads without writing and exits 1 unless the set is current, the legacy names are those of the generation and its inputs (specs, roadmaps, policy, module metadata, validation matrix) still hold. A failed publication leaves the previous generation in force and a retry converges on the same identity; publishers hold a generation lock in the indexes directory (it never waits: a second `pose index` is refused with `index-generation-busy` and writes nothing, and a lock whose holder is proven dead is recovered), the first publication of a repository is marked pending so one that did not commit reads as `unavailable` and not as a mixture of two runs, an operation that reads several indexes (the review plan) fixes one generation for all of them, and a commit whose durability could not be confirmed is reported as committed; retention keeps the current generation and the newest others up to three, never anything younger than ten minutes, and a retention failure is a warning, not a failed publication. Limits: Git history is read by the delivery graph but not pinned by the descriptor, and a clone without the git-ignored `generations/` directory verifies the legacy names against the descriptor. MCP: `pose_delivery_integrity`.\nPOSE.md:385:- `state --attention` (specs `pose-obligation-projection`, `pose-state-attention`) — live, read-only answer to \"what is still owed, by whom, restricting which phase?\". Obligations are projected from the subsystems that own them — readiness (unmet `depends_on`, Definition of Ready, unexplained `blocked`), closeout and review of in-progress specs (an unapproved review, each judgment criterion a sealed bundle still owes, text blockers carried as `legacy-opaque`), start reconciliation when atomic start is adopted, and open follow-ups as advisory residual debt — never stored a second time. Project-level sources are projected too (spec `pose-attention-projects-every-source`), originating on `xref:<project>/project:<project>`: an open docs review mark (owed by the doc's owner until `pose docs-review resolve`), a capability mechanism with a stale trigger, a release newer than the newest verified one that is not yet verified, and an accepted-risk or follow-up finding past its review date in the latest legacy review record. Free-form investigation notes carry no state and are not a source. The render shows coverage first: a producer that failed, or action requests until adopted, makes the answer `INCOMPLETE`, so an empty group never reads as nothing owed, and a fresh install, once committed, reads `complete`. Then what needs `--actor` (or any person or role), then what restricts each phase (`start`, `execution`, `review`, `closeout`, `release`), then residual debt. `--json` returns the report — stable `obl-` ids, qualified refs, reason codes, conditions, recipients, effects, satisfaction, knowledge, waiting, a snapshot of revision/dirty tree/policy/contract/index digests, per-producer coverage — plus the `attention` grouping. MCP: `pose_obligations` returns the same ids from the same function. Attention is not a gate.\nPOSE.md:650:names the matrix did not carry is reported as one `validation-check` fact per\nPOSE.md:660:trailers also name other specs cannot be split by commit; its facts carry\nPOSE.md:739:two directories are the contract — policy and profiles carry their own schema\nPOSE.md:760:`agent:`/`human:` prefixes remain labels only. The attestation must carry a\nPOSE.md:778:`closeout-check` print one assurance line and carry an `assurance` object in\nPOSE.md:792:claim names that human. Records written before this carry no block and render\nPOSE.md:821:An answer proof authorizes its answer only. New waiver, cancellation and supersession events carry `lifecycle_version: 1`. Under verified action policy they require an operation-bound SSHSIG (`pose-action-lifecycle`) or a trusted issuer's schema-2 action claim. MCP always requires this proof. Both supplied emitters must verify; human presence follows the current explicit channel scope.\nPOSE.md:909:`pose delegate ls` lists attempts by their latest run with state, purpose, agent, label, turns, age and last step — for an interrupted run also its cause, whether a partial draft exists, the reset instant and the time left — and the runs in progress with the liveness of their process. `pose delegate cancel <run>` stops a run in progress; it is recorded `failed` with the cause `cancelled`, and its attempt stays consumed. `pose delegate agents` lists each agent with vendor, model, whether its CLI is on the path, the reset instant of its last recorded usage limit and the state routing reads: `available`, `limited until <instant>` (its last run hit a usage limit whose reset is ahead), `missing` (its CLI is not on the path), `unknown` (the run history could not be read whole) or `probe-failed` (its optional `probe` failed within its bound). Availability is read from the path and the recorded runs; only a configured probe runs anything. `pose delegate review|adjudicate|smoke --detach` starts the run as a process of its own, in a session of its own that survives the caller's terminal, and returns at once with the attempt (a run reference) and the path of its log; a run whose route must first wait for a usage-limit reset is not detached. `pose delegate wait <run> [--timeout <d>] [--json]` is a plain foreground process that ends when the run does and prints one line — run, state, decision, resumable flag, reset instant — with the exit code `0` approved, `10` changes requested or rejected, `20` failed (a completed run with no decision too), `30` interrupted, `40` stalled, `50` the wait timed out, and `2` for a usage error; every waiter is released, a run already ended returns at once, and killing a wait leaves the run running. The process running an attempt rewrites a heartbeat in its marker every 10 seconds; a run whose heartbeat is older than three intervals and whose process is provably gone is recorded `stalled` by the first reader, through an exclusive claim every reader then agrees on, and `ls` shows each running run's heartbeat age. `pose delegate watch [<run>|<label>]` shows an attempt as one task: the runs it recorded are replayed with a marker where a run resumed another and the interrupted run naming the run that continued it, then a running attempt is followed through the normalized, redacted events its process writes as they come, until the record is published; `--no-follow` prints what exists and exits, `-v` adds the tail of each tool's output (`--lines <n>`, default 12) and `--json` prints NDJSON. With no reference it follows the only running run; at a terminal it otherwise opens fzf with a preview of the run under the cursor refreshed every `--refresh <d>` (default 2s, 0 turns it off), or a numbered menu without fzf; outside a terminal an absent reference exits 2 and lists the candidates. Colours appear only on a terminal and follow `NO_COLOR`. A live event is redacted with the credentials and the session references the stream has declared so far; the events bound to the record are derived again from the whole transcript. `on_terminal` on an agent (or else on a purpose) is a command run once after a run ends, with only `POSE_DELEGATE_RUN` and `POSE_DELEGATE_STATE` in its environment, the run directory as working directory, its own process group and a bound (`timeout`, default 30s, at most 5m); its failure is recorded beside the run, shown by `ls`, and never changes the run's state. `pose delegate handoff <run> --to <agent|auto>` continues a run that stopped interrupted or failed, short of a conclusion, with another agent under the same attempt and its continuation budget, which is the `resume.max_resumes` and `max_wall_time` of the agent that opened the attempt (3 and 60 minutes by default) whichever agent continues it, so changing agents never widens it; a completed run, the same agent and a run already continued are refused, and a run handed off is no longer resumed. Its brief is the predecessor's generated brief followed by a labelled section: the predecessor's partial final message and the commands it ran with their exit status, paired by the call identifier the agent's stream records and otherwise left unknown rather than guessed, each with its digest, quoted so no line of it reads as a decision, bounded at 16 KiB with the cut disclosed, and an instruction to re-verify. Only the handoff run concludes. The record binds the base brief digest and the section digest in `handoff_digest`, names its predecessor in `hands_off_from`, and a signed proof verifies the section against the predecessor's record. `--to auto` routes as the purpose does, the stopped agent excluded and unavailable ones skipped. A foreground run or handoff that stops interrupted in a terminal offers waiting for its reset and resuming, handing off, or cancelling, which is offered even alone, and does nothing until answered; the stopping command's result, `ls --json` and `wait --json` carry the same ways forward as `next_actions`, each with its command, whether it is available now — judged by the planning its command runs, budget and wait bound included — and why not, and a `cancel` that leaves the run stopped. `watch` marks a handoff with `⇄` beside the `↻` of a resume. `pose delegate task <prompt-file|->` hands any task to another agent: the prompt goes on stdin in `--cd` (default: the current directory) with the agent's command for `--access read|sandboxed|write|full`; the default is `purposes.task.default_access` (read when unset), `full` is never a default and prints a warning naming what it disables. A task's template places `{add_dirs}`, `{no_network}` and `{outside_git}`, filled from the agent's `add_dir_args` (with `{dir}`), `no_network_args` and `outside_git_args`; `--add-dir`, `--no-network` and `--effort` that the agent's template cannot carry are refused with exit 2, and `--no-network` with `write` or `full` too. The final message goes to stdout and the agent's exit code is returned; `--json` replaces both with one document. A task runs in the real directory: containment bounds its time and output, not its filesystem. Its record (prompt, stream, error stream, normalized events, argv, removed variable names, exit code, label) is owner-only under the user's state directory (`$XDG_STATE_HOME/pose/delegate/`, where `XDG_STATE_HOME` counts only as an absolute path and `~/.local/state` is the default), or, with `--record`, in the `delegate-runs` directory of `.pose`. The state directory may be reached through a link of the user's own; resolved, it and every directory above it must belong to the user or to root and be writable by no group or other user unless sticky, and `pose`, `pose/delegate` and the project's directory below it must be real directories of the user's that no group or other user can write; a task refuses to record or read anywhere else and names the directory (on Windows only links are refused). `--detach` starts a task as the review purposes start a detached run and returns its attempt, its log and the place of its record; a prompt piped to `task -` or `resume --prompt -` is read before detaching and written to the detached run through a pipe, never a file, and a refusal before the attempt is reserved returns the foreground's document and exit code. A detached call keeps its log and hand-back in `.pose/review-private/supervisors`, which, with every directory up to the project root, must be the user's and writable by no group or other user, and whose root's ancestors must belong to the user or root and be writable by no one else unless sticky; the root is resolved once and only that resolved root is used, a caller whose current directory is gone is refused, and a project's private task history is keyed by its resolved root (records an earlier engine kept under a linked spelling are still read). A detached call believes a hand-back only once a piped prompt is through and a run reserved the attempt it names. A checkout that fails this can still run in the foreground; on Windows only links and non-directories are refused, and ACLs are not checked. A task is never evidence: no review reader reads it, `pose review attest --run` refuses it by name, and `wait` returns 0 when the agent succeeded, with no decision. `ls`, `watch`, `wait`, `cancel`, `resume` and `handoff` work on tasks; `resume` without `--prompt` sends a default continuation message, with the agent's `resume.commands` for the task's access, and `--agent auto` routes against the launching session. A task can also continue a session POSE never recorded, such as one a personal launcher opened, with `--session <id> --agent <name>`: the agent's resume command for the access runs with that session, the prompt optional, and the record says it continued a session without keeping it. `pose review dispatch`, `resume` and `status`, the aliases this surface deprecated, were removed: each exits 2 and names its `pose delegate` replacement.\nPOSE.md:948:Reservations live in `.pose/review-attempts/`, final receipts link the run, and `.pose/review-run-ledger/` witnesses exact run bytes and transcript digests. Every publication uses the exclusive synced publisher. New runs carry `ledger_version: 1`, `attempt_id` and the optional reason; legacy schema-1 runs retain their original identities, with no invented reservation or signature. An incomplete reservation, missing witness/run/transcript, inconsistent receipt, unknown record or exhausted read budget is explicitly incomplete. Inspect it; no automatic deletion, truncation, repair or retry occurs. Upgrade writers sharing these directories together. Run continuity and authenticated provenance remain separate deliveries.\nPOSE.md:956:**Hosted checks and the resident Git memo.** `pose runtime run [--envelope] [--timeout <d>] <command> [args...]` runs `review-check`, `closeout-check`, `artifact-check`, `surface-check` or `roadmap-check` in the runtime of the worktree when one is running, compatible and willing, and standalone in this process otherwise; the exit code and the output are the command's, and `--envelope` prints one document (`pose.runtime.run/1`) with them and with `via` (`runtime` or `standalone`), the `fallback_reason`, the typed `outcome` (`completed`; `error` when the command ran and ended but its output (over 2 MiB) is not sent back, with the command's exit code; or `unknown` for a deadline or a lost answer), the epoch and the memo hits. The runtime refuses, before the command starts, one it does not host and a caller whose environment digest (the `POSE_`, `HARNE8_`, `GIT_`, `CLAUDE` and `CODEX` variables, `XDG_STATE_HOME`, `XDG_CONFIG_HOME` and `XDG_RUNTIME_DIR`, the locale, `HOME`, `NO_COLOR` and the user) differs from its own, so the caller runs standalone; a command that reached the runtime and whose answer did not come back whole, or whose `--timeout` passed, may have run and is never repeated standalone unasked: it exits 1 and says so. The runtime runs hosted commands as the user that started it, in its worktree, with the output of a non-terminal, in the admission lanes described below; a command still waiting for its slot when its `--timeout` passes is refused, not started, so the caller runs it standalone. A runtime also keeps, between commands, the output of the Git reads that are pure functions of object ids or of the commit HEAD named when they ran, keyed by that commit and the shallow state (256 MiB, least recently used first; not for a linked worktree): the second `review-check` of this repository took about 10 s against about 25 s standalone, with the same output. The runtime admits hosted commands in two lanes, each with its own slots and a bounded queue: `short` (`surface-check`, about 10 ms on this repository) and `heavy` (the other hosted commands; `roadmap-check <slug>` takes minutes here), 2 and 1 slots by default and queues of 16 and 4; `pose runtime start|serve` take `--short-slots`, `--heavy-slots`, `--short-queue`, `--heavy-queue` and `--memo-mib` (default 256). A short query is not queued behind a heavy check, and a command that finds every slot of its lane busy and the queue full is refused before it waits and runs standalone. `status` and the handshake carry, per lane, `<lane>_slots`, `_queue_limit`, `_queued`, `_running`, `_admitted`, `_refused`, `_wait_ms_total` and `_wait_ms_max` in `metrics`. A measurement of the runtime on a real repository, with its thresholds fixed before the numbers, is `POSE_RUNTIME_MEASURE=<file> go test ./internal/cli -run TestMeasureTheRuntimeOnTheRealRepository`; its report is under `.pose/reports/`.\\n\\n**Review rounds.** The rounds of a scope are its sealed bundles that a completed delegated review concluded on, in the order those runs ended; `pose review verify`, `pose delegate ls` and `pose insights` show the round. From round 2, the generated brief (template `review-brief/2`; runs briefed with `review-brief/1` still verify) carries a `Previous round` section built from the ledger: every open finding with the identifier it keeps across rounds (`R<round>-<id>`), its severity, disposition and location, the previous run and its draft digest. The reviewer's draft is the fenced code block whose info string is `pose-draft`: JSON with `schema` `pose.review.draft/v1`, `decision` and `findings` (`id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line`, `summary`), and from round 2 `prior_findings` (`id`, `status` fixed|partial|not-fixed|superseded, `evidence`) and `sweep`. A finding reported `partial` or `not-fixed` keeps its identifier in the next brief. A round-2-or-later draft that leaves an open finding unaccounted, calls one `fixed` without evidence or states no sweep is recorded with `draft_problems`, `wait` reports it as `invalid`, and it is never accepted as an approval. With `routing.rounds` `continue-thread` (the default) a round resumes the session the previous round ended with, through the agent's resume command; it opens a new session, recording why, when the agent or its vendor changes, the chain of drafts is broken, that session cannot be resumed, or the round reaches `routing.round_threshold` (5 by default), where `verify` also warns that the rounds are not converging. `cold-session` opens a new session every round. Each run records its `round` and `thread`; `pose insights` reports, per scope, findings per round, rounds to approval, and how prior findings were accounted for in continued and in cold rounds. A previous round whose record is not intact makes the brief refuse.\nPOSE.md:958:**Delegated runs over MCP.** `pose_delegate_start` (review, adjudicate or smoke), `pose_delegate_status`, `pose_delegate_wait`, `pose_delegate_resume` and `pose_delegate_handoff` run `pose delegate … --json` in the project the server resolved for the call, so every plan, refusal and run is the CLI's: a start, resume or handoff is always detached and returns once the run has reserved its attempt (without `apply` it previews), a status never blocks, and a wait blocks at most its `timeout_seconds` (300 at most), returning `still-running` when the bound passes. Refusals carry the same `reason_code` as the CLI's error document (`rerun-without-reason`, `budget-exhausted`, `containment-incompatible`, `agent-unavailable`, `no-agent`), and results carry the normalized summary only: no transcript, prompt, session reference or environment value. `pose delegate resume` and `handoff` take `--detach` as the purposes do. A task is not started over MCP.\nlocales/pt-BR/POSE.md:222:              [--changed-from rev [--changed-to rev] | --carry] [--jobs n] [--explain] [--emit-plan f]\nlocales/pt-BR/POSE.md:357:  **Escopo por mudança:** `--changed-from <rev> [--changed-to <rev>]` seleciona deterministicamente o conjunto mínimo seguro de módulos — módulos com arquivos alterados (rastreados e não rastreados), dependentes transitivos via arestas `dependsOn` em [`module-metadata.json`](.pose/indexes/module-metadata.json) e alargamento por política (criticidade `high` sempre roda). Os nomes alterados são lidos delimitados por NUL, e um rename nomeia a origem e o destino. Cada arquivo alterado seleciona o módulo dono mais específico, todo módulo que envolve esse dono (o módulo raiz envolve todos), todo módulo abaixo dele (um gitlink ou diretório substituído altera o que está abaixo) e todo módulo cujo `dependsOn` declarado o contém, está abaixo dele ou é a raiz `.`, mesmo depois que essa dependência é apagada. Um arquivo que nenhum módulo possui seleciona o módulo raiz. Metadados de módulo que não decodificam interrompem a seleção (execução completa com `--carry`, erro com `--changed-from`). Uma mudança fora de todos os módulos roda todo módulo que não declara `\"selfContained\": true` nos seus metadados (na incerteza, prefere-se execução segura; a declaração afirma que os checks do módulo só leem o próprio diretório e os módulos de `dependsOn`); checks não selecionados são registrados como skipped com o motivo da seleção e `--explain` imprime cada decisão. Revisões ficam confinadas a uma gramática segura; sem as flags, a validação completa é inalterada.\nlocales/pt-BR/POSE.md:359:  **Checks carregados:** `--carry --json-out <results_path>` renova o resultado canônico em vez de rodar a matriz inteira de novo. Ele usa o resultado canônico atual como base quando a base é comparável: mesmo schema, modo, digest da matriz e `engine_version` (a versão do motor mais a revisão VCS da qual o binário foi compilado; um build de árvore modificada nunca carrega), sem filtro, não cancelada (um sinal cancela o run inteiro, mesmo um só com checks carregados), com `material_clean` registrado (validou uma cópia de trabalho inalterada do próprio head: nenhum material rastreado ou não rastreado e não ignorado mudou, e o HEAD não se moveu durante o run, segundo o reflog dele e de todo submódulo; mudanças de modo contam qualquer que seja `core.fileMode`, e todo submódulo precisa estar no commit registrado, sem submódulo aninhado, verificado antes da leitura do plano e no fim do run; uma spec cujo material o motor não consegue calcular continua indisponível em qualquer run limpo e não recusa a base), com `git_head` ancestral de `HEAD`, cópia de trabalho limpa agora nos paths materiais sistema de arquivos que diferencia maiúsculas, sem diretório com casefold no caminho até um módulo ou uma dependência, nenhum módulo alcançado por symlink ou compartilhando diretório com outro módulo, nenhum symlink rastreado cujo path ou alvo esteja num módulo que não seja a raiz ou num `dependsOn` declarado (ou cujo alvo saia do repositório), inclusive na árvore de todo submódulo (um submódulo sem checkout ou com submódulos aninhados recusa), nenhuma dependência declarada fora do repositório ou escrita como path não limpo ou que resolve por symlink (rastreado ou ignorado), apenas paths ASCII de módulo e dependência, nenhuma entrada de índice marcada assume-unchanged ou skip-worktree, e nenhum id de check definido duas vezes e metadados de módulo da cópia de trabalho iguais aos do HEAD. Os nomes alterados são lidos com todo gitlink visível, qualquer que seja a configuração do Git. O head é fixado antes do planejamento, e um run cujo HEAD se moveu registra seus bindings de material como indisponíveis. Roda os módulos que as regras de escopo por mudança selecionam entre o head da base e `HEAD`; o arquivo do resultado canônico e os registros administrativos derivados que o binding de material ignora (arquivos de dados ainda regulares nos diretórios de registros derivados sob `.pose/`: índices, resultados, estado, assessments e registros de revisão; a matriz de validação continua material) não contam como mudança. Um módulo cujos checks não estão todos na base também roda. Todo outro check mantém o resultado da base, inclusive o desfecho, e registra `carried_from` (o head em que rodou, mantido em carregamentos encadeados) e `carried_generated_at`; o índice de entrega lê esse head no resultado, então o frescor da evidência julga o commit que um check carregado realmente observou. Uma falha carregada continua reprovando o run. Qualquer condição não atendida roda tudo, e `carry.reason` diz por quê. `carry` registra a base, o número de arquivos alterados e o motivo de cada módulo selecionado, e `counts.carried` os checks reaproveitados. `--carry` não combina com `--module`, `--stack`, `--workspace`, `--root-only`, `--changed-from` ou `--changed-to`.\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:45:separate mechanism carrying separate self-referential data (JSON policy\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:32:when the spec closes, and retired when the ADR and `docs-site/docs/cli.md` carry\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:113:Three persistence paths exist, and they carry different things — worth keeping\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:419:- `pose-mcp/internal/pose/delivery_integrity.go` — findings already carry\npackage pose\n\nimport \"testing\"\n\n// A carried check is read as an observation of the head it ran at (spec\n// pose-validate-carries-unchanged-checks R7); an executed one keeps the run's.\nfunc TestDeliveryValidationRunReadsTheCarriedHead(t *testing.T) {\n\traw := []byte(`{\"schema_version\":1,\"generated_at\":\"2026-11-22T10:00:00Z\",\"git_head\":\"bbbb\",\"checks\":[` +\n\t\t`{\"id\":\"a/go/ok\",\"module\":\"a\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\"},` +\n\t\t`{\"id\":\"b/go/ok\",\"module\":\"b\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\",\"carried_from\":\"aaaa\",\"carried_generated_at\":\"2026-11-21T09:00:00Z\"}]}`)\n\tresults, err := ParseDeliveryValidationRun(raw, \".pose/results/delivery-validation.json\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(results) != 2 {\n\t\tt.Fatalf(\"results = %+v\", results)\n\t}\n\tfor _, r := range results {\n\t\tswitch r.ID {\n\t\tcase \"a/go/ok\":\n\t\t\tif r.GitHead != \"bbbb\" || r.GeneratedAt != \"2026-11-22T10:00:00Z\" {\n\t\t\t\tt.Fatalf(\"executed check read as %s at %s\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\tcase \"b/go/ok\":\n\t\t\tif r.GitHead != \"aaaa\" || r.GeneratedAt != \"2026-11-21T09:00:00Z\" {\n\t\t\t\tt.Fatalf(\"carried check read as %s at %s, want the head it ran at\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\t}\n\t}\n}\n127:func TestCarryRunsOnlyTheChangedModule(t *testing.T) {\n156:func TestCarryKeepsTheOriginalHeadAcrossChainedCarries(t *testing.T) {\n173:func TestCarryKeepsACarriedFailureAFailure(t *testing.T) {\n189:func TestCarryFallsBackToAFullRun(t *testing.T) {\n242:func TestCarryRootChangeRunsEverythingUnlessSelfContained(t *testing.T) {\n265:func TestChangedScopeHonoursSelfContainedModules(t *testing.T) {\n274:func TestCarryRecordFileIsNotAChange(t *testing.T) {\n283:func TestCarrySelectsAModuleWithoutAPriorResult(t *testing.T) {\n309:func TestCarryRefusesAFilteredBase(t *testing.T) {\n321:func TestCarryRefusesIncompatibleFlags(t *testing.T) {\n334:func TestCarryIgnoresDerivedAdministrativeRecords(t *testing.T) {\n355:func TestCarryRefusesABaseThatValidatedADirtyWorkingCopy(t *testing.T) {\n378:func TestCarrySelectsBothSidesOfARename(t *testing.T) {\n395:func TestCarryKeepsTheOwnerOfAQuotedName(t *testing.T) {\n411:func TestCarryRootModuleOwnsRootFiles(t *testing.T) {\n429:func TestCarryDeletedDependencySelectsItsDependents(t *testing.T) {\n445:func TestCarryRejectsUndecodableMetadata(t *testing.T) {\n461:func TestChangedScopeGitlinkAboveADependencySelectsItsDependents(t *testing.T) {\n477:func TestCarryDeletedNestedDependencySelectsItsDependents(t *testing.T) {\n492:func TestCarryRootDependencyIsChangedByRootFiles(t *testing.T) {\n507:func TestCarryRefusesModulesReachedThroughASymlink(t *testing.T) {\n526:func TestValidateHeadMovingDuringTheRunIsNotClean(t *testing.T) {\n539:func TestChangedScopeEvaluatesEveryDeclaredDependency(t *testing.T) {\n554:func TestValidateHeadMovingDuringTheRunBindsNoMaterial(t *testing.T) {\n581:func TestCarryRefusesModulesSharingADirectory(t *testing.T) {\n601:func TestCarryPlansAgainstThePinnedHead(t *testing.T) {\n628:func TestChangedScopeDiscoveredAncestorDependencySelectsItsDependents(t *testing.T) {\n652:func TestCarryRefusesDependenciesReachedThroughASymlink(t *testing.T) {\n669:func TestCarryRefusesASymlinkInsideAModule(t *testing.T) {\n686:func TestCarryAllowsSymlinksBetweenUnownedPaths(t *testing.T) {\n707:func TestCarryDetectsACaseInsensitiveFilesystem(t *testing.T) {\n729:func TestCarryRefusesDuplicateCheckIDs(t *testing.T) {\n746:func TestCarryRefusesASymlinkFromAModuleToAnUnownedPath(t *testing.T) {\n763:func TestChangedScopeIgnoresSubmoduleHidingConfiguration(t *testing.T) {\n772:func TestValidateUntrackedMaterialCreatedDuringTheRunIsNotClean(t *testing.T) {\n785:func TestCarryRefusesAnAliasingSymlinkInsideASubmodule(t *testing.T) {\n819:func TestCarryDetectsACaseFoldedDirectory(t *testing.T) {\n844:func TestChangedScopeSelectsTheEnclosingModule(t *testing.T) {\n857:func TestCarryScansAGitlinkInsideAModule(t *testing.T) {\n888:func TestCarryRelevantDirsIncludeEveryAncestor(t *testing.T) {\n909:func TestChangedScopeRootModuleEnclosesEveryModule(t *testing.T) {\n922:func TestCarryCaseProbeSkipsUnusableEntries(t *testing.T) {\n955:func TestCarryRefusesDependenciesOutsideTheRepository(t *testing.T) {\n970:func TestCarryRefusesUncleanDependencies(t *testing.T) {\n983:func TestCarryRefusesNonASCIIPaths(t *testing.T) {\n996:func TestCarryRefusesHiddenIndexEntries(t *testing.T) {\n1018:func TestCarryRefusesDependenciesThroughAnIgnoredSymlink(t *testing.T) {\n1036:func TestValidateHeadMovingAndReturningIsNotClean(t *testing.T) {\n1050:func TestCarryCaseProbeUsesOnlyASCIILetters(t *testing.T) {\n1078:func TestValidateModeChangeHiddenByConfigurationIsNotClean(t *testing.T) {\n1094:func TestValidateUninitializedSubmoduleIsNotClean(t *testing.T) {\n1118:func TestValidateConditionClearedDuringTheRunIsNotClean(t *testing.T) {\n1135:func TestValidateSubmoduleMovingAndReturningIsNotClean(t *testing.T) {\n1166:func TestCarryRefusesABaseCancelledAtRunLevel(t *testing.T) {\n1184:func TestCarryRefusesWorkingMetadataThatDiffersFromHead(t *testing.T) {\n1197:func TestCancellationMakesBindingsUnavailable(t *testing.T) {\n1206:func TestValidateNestedSubmodulesAreNotClean(t *testing.T) {\n1241:func TestCarrySelectsWithThePinnedMetadataSnapshot(t *testing.T) {\n1265:func TestCarryRefusesAnUnreadableMetadataBlob(t *testing.T) {\n","exit_code":0,"status":"completed"}}
