{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SfBgH1t6u6xfT22y9v9Jii","type":"tool_result","content":"80\t// processes do) in the lanes of the admission policy, and answers with a typed result. Anything it does not host or will not run is refused before it\n81\t// starts.\n82\tfunc runtimeHostedHandler(envDigest string, busy *atomic.Int64, lanes *hostedLanes) func(context.Context, worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n83\t\treturn func(ctx context.Context, req worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n84\t\t\tif req.Op != \"run\" {\n85\t\t\t\treturn worktreeruntime.Reply{}, false\n86\t\t\t}\n87\t\t\trefuse := func(why string) (worktreeruntime.Reply, bool) {\n88\t\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeRefused, Reason: why}, true\n89\t\t\t}\n90\t\t\tswitch {\n91\t\t\tcase len(req.Args) == 0 || !hostedCommands[req.Args[0]]:\n92\t\t\t\treturn refuse(\"the runtime does not host this command\")\n93\t\t\tcase req.Env != envDigest:\n94\t\t\t\treturn refuse(\"the caller's environment differs from the one the runtime started in\")\n95\t\t\t}\n96\t\t\tstarted := time.Now()\n97\t\t\t// One hosted command at a time. The deadline covers the wait for its turn: a command\n98\t\t\t// that has not started by then is withdrawn and refused, so its caller may run it\n99\t\t\t// standalone without the runtime running it later as well.\n100\t\t\tlimit := time.Duration(req.DeadlineMS) * time.Millisecond\n101\t\t\tif limit <= 0 || limit > worktreeruntime.MaxHostedDuration {\n102\t\t\t\tlimit = worktreeruntime.MaxHostedDuration\n103\t\t\t}\n104\t\t\ttimer := time.NewTimer(limit)\n105\t\t\tdefer timer.Stop()\n106\t\t\tlane := lanes.of(req.Args[0])\n107\t\t\tif !lane.enter() {\n108\t\t\t\treturn refuse(\"the \" + lane.name + \" lane of the runtime is full: this command did not start\")\n109\t\t\t}\n110\t\t\twaitStart := time.Now()\n111\t\t\tselect {\n112\t\t\tcase lane.slots <- struct{}{}:\n113\t\t\t\tlane.admit(time.Since(waitStart))\n114\t\t\tcase <-timer.C:\n115\t\t\t\tlane.withdrawn()\n116\t\t\t\treturn refuse(\"the runtime was busy with another command until the deadline: this one did not start\")\n117\t\t\tcase <-ctx.Done():\n118\t\t\t\tlane.withdrawn()\n119\t\t\t\treturn refuse(\"the runtime is stopping: this command did not start\")\n120\t\t\t}\n121\t\t\tdone := make(chan worktreeruntime.Reply, 1)\n122\t\t\t// While its caller waits, the command is the caller's open connection and counts as in\n123\t\t\t// flight through it. Only when the caller is answered at a deadline with the command still\n124\t\t\t// running does it become busy work: orphaned is 0 while the caller waits, 1 once the\n125\t\t\t// deadline left it running, 2 once it ended, so it is counted once, by one of the two.\n126\t\t\tvar orphaned atomic.Int32\n127\t\t\tgo func() {\n128\t\t\t\tdefer func() {\n129\t\t\t\t\tif !orphaned.CompareAndSwap(0, 2) {\n130\t\t\t\t\t\tbusy.Add(-1)\n131\t\t\t\t\t}\n132\t\t\t\t}()\n133\t\t\t\tdefer func() { <-lane.slots; lane.running.Add(-1) }()\n134\t\t\t\thitsBefore, _, _, _ := posemodel.ResidentGitMemoStats()\n135\t\t\t\tvar out, errb bytes.Buffer\n136\t\t\t\tcode := 1\n137\t\t\t\tfunc() {\n138\t\t\t\t\tdefer func() {\n139\t\t\t\t\t\tif r := recover(); r != nil {\n140\t\t\t\t\t\t\terrb.WriteString(\"pose: the command panicked: \" + fmt.Sprint(r) + \"\\n\")\n141\t\t\t\t\t\t}\n142\t\t\t\t\t}()\n143\t\t\t\t\tcode = (*runtimeHostedRun.Load())(req.Args, &out, &errb)\n144\t\t\t\t}()\n145\t\t\t\thitsAfter, _, _, _ := posemodel.ResidentGitMemoStats()\n146\t\t\t\tif out.Len()+errb.Len() > maxHostedOutput {\n147\t\t\t\t\t// The command ran; its output is too large to send whole.\n148\t\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeError, Reason: \"the command's output exceeds what the runtime sends back\", ExitCode: code, ElapsedMS: time.Since(started).Milliseconds()}\n149\t\t\t\t\treturn\n150\t\t\t\t}\n151\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(),\n152\t\t\t\t\tElapsedMS: time.Since(started).Milliseconds(), MemoHits: hitsAfter - hitsBefore}\n153\t\t\t}()\n154\t\t\tselect {\n155\t\t\tcase reply := <-done:\n156\t\t\t\treturn reply, true\n157\t\t\tcase <-timer.C:\n158\t\t\t\t// The command is read-only apart from refreshing derived files and cannot be\n159\t\t\t\t// cancelled; it ends on its own and the next one waits for it.\n160\t\t\t\tif orphaned.CompareAndSwap(0, 1) {\n161\t\t\t\t\tbusy.Add(1)\n162\t\t\t\t}\n163\t\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeDeadline, Reason: \"the deadline passed while the command ran; it was not stopped\", ElapsedMS: time.Since(started).Milliseconds()}, true\n164\t\t\t}\n165\t\t}\n166\t}\n167\t\n168\t// cmdRuntimeRun is `pose runtime run [--envelope] [--timeout <d>] <command> [args...]`: the\n169\t// command runs in the runtime when one is running, compatible and willing, and standalone in\n170\t// this process otherwise. The exit code and the output are the command's; --envelope prints\n171\t// one document with them and with where it ran. A command that reached the runtime and whose\n172\t// answer did not come back whole is never rerun here: it may have run.\n173\tfunc cmdRuntimeRun(root string, args []string, stdout, stderr io.Writer) int {\n174\t\tenvelope, timeout := false, time.Duration(0)\n175\t\tfor len(args) > 0 && strings.HasPrefix(args[0], \"--\") {\n176\t\t\tswitch args[0] {\n177\t\t\tcase \"--envelope\":\n178\t\t\t\tenvelope = true\n179\t\t\t\targs = args[1:]\n180\t\t\tcase \"--timeout\":\n181\t\t\t\tif len(args) < 2 {\n182\t\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: --timeout needs a duration\")\n183\t\t\t\t\treturn 2\n184\t\t\t\t}\n185\t\t\t\td, err := time.ParseDuration(args[1])\n186\t\t\t\tif err != nil || d <= 0 {\n187\t\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: \" + args[1] + \" is not a duration\")\n188\t\t\t\t\treturn 2\n189\t\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"d687a631-59b6-4f9d-ac2c-a375f742fe44","timestamp":"2026-11-10T18:40:40.715Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2613152345/worktree/pose-mcp/internal/cli/runtime_host.go","content":"// processes do) in the lanes of the admission policy, and answers with a typed result. Anything it does not host or will not run is refused before it\n// starts.\nfunc runtimeHostedHandler(envDigest string, busy *atomic.Int64, lanes *hostedLanes) func(context.Context, worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n\treturn func(ctx context.Context, req worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n\t\tif req.Op != \"run\" {\n\t\t\treturn worktreeruntime.Reply{}, false\n\t\t}\n\t\trefuse := func(why string) (worktreeruntime.Reply, bool) {\n\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeRefused, Reason: why}, true\n\t\t}\n\t\tswitch {\n\t\tcase len(req.Args) == 0 || !hostedCommands[req.Args[0]]:\n\t\t\treturn refuse(\"the runtime does not host this command\")\n\t\tcase req.Env != envDigest:\n\t\t\treturn refuse(\"the caller's environment differs from the one the runtime started in\")\n\t\t}\n\t\tstarted := time.Now()\n\t\t// One hosted command at a time. The deadline covers the wait for its turn: a command\n\t\t// that has not started by then is withdrawn and refused, so its caller may run it\n\t\t// standalone without the runtime running it later as well.\n\t\tlimit := time.Duration(req.DeadlineMS) * time.Millisecond\n\t\tif limit <= 0 || limit > worktreeruntime.MaxHostedDuration {\n\t\t\tlimit = worktreeruntime.MaxHostedDuration\n\t\t}\n\t\ttimer := time.NewTimer(limit)\n\t\tdefer timer.Stop()\n\t\tlane := lanes.of(req.Args[0])\n\t\tif !lane.enter() {\n\t\t\treturn refuse(\"the \" + lane.name + \" lane of the runtime is full: this command did not start\")\n\t\t}\n\t\twaitStart := time.Now()\n\t\tselect {\n\t\tcase lane.slots <- struct{}{}:\n\t\t\tlane.admit(time.Since(waitStart))\n\t\tcase <-timer.C:\n\t\t\tlane.withdrawn()\n\t\t\treturn refuse(\"the runtime was busy with another command until the deadline: this one did not start\")\n\t\tcase <-ctx.Done():\n\t\t\tlane.withdrawn()\n\t\t\treturn refuse(\"the runtime is stopping: this command did not start\")\n\t\t}\n\t\tdone := make(chan worktreeruntime.Reply, 1)\n\t\t// While its caller waits, the command is the caller's open connection and counts as in\n\t\t// flight through it. Only when the caller is answered at a deadline with the command still\n\t\t// running does it become busy work: orphaned is 0 while the caller waits, 1 once the\n\t\t// deadline left it running, 2 once it ended, so it is counted once, by one of the two.\n\t\tvar orphaned atomic.Int32\n\t\tgo func() {\n\t\t\tdefer func() {\n\t\t\t\tif !orphaned.CompareAndSwap(0, 2) {\n\t\t\t\t\tbusy.Add(-1)\n\t\t\t\t}\n\t\t\t}()\n\t\t\tdefer func() { <-lane.slots; lane.running.Add(-1) }()\n\t\t\thitsBefore, _, _, _ := posemodel.ResidentGitMemoStats()\n\t\t\tvar out, errb bytes.Buffer\n\t\t\tcode := 1\n\t\t\tfunc() {\n\t\t\t\tdefer func() {\n\t\t\t\t\tif r := recover(); r != nil {\n\t\t\t\t\t\terrb.WriteString(\"pose: the command panicked: \" + fmt.Sprint(r) + \"\\n\")\n\t\t\t\t\t}\n\t\t\t\t}()\n\t\t\t\tcode = (*runtimeHostedRun.Load())(req.Args, &out, &errb)\n\t\t\t}()\n\t\t\thitsAfter, _, _, _ := posemodel.ResidentGitMemoStats()\n\t\t\tif out.Len()+errb.Len() > maxHostedOutput {\n\t\t\t\t// The command ran; its output is too large to send whole.\n\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeError, Reason: \"the command's output exceeds what the runtime sends back\", ExitCode: code, ElapsedMS: time.Since(started).Milliseconds()}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(),\n\t\t\t\tElapsedMS: time.Since(started).Milliseconds(), MemoHits: hitsAfter - hitsBefore}\n\t\t}()\n\t\tselect {\n\t\tcase reply := <-done:\n\t\t\treturn reply, true\n\t\tcase <-timer.C:\n\t\t\t// The command is read-only apart from refreshing derived files and cannot be\n\t\t\t// cancelled; it ends on its own and the next one waits for it.\n\t\t\tif orphaned.CompareAndSwap(0, 1) {\n\t\t\t\tbusy.Add(1)\n\t\t\t}\n\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeDeadline, Reason: \"the deadline passed while the command ran; it was not stopped\", ElapsedMS: time.Since(started).Milliseconds()}, true\n\t\t}\n\t}\n}\n\n// cmdRuntimeRun is `pose runtime run [--envelope] [--timeout <d>] <command> [args...]`: the\n// command runs in the runtime when one is running, compatible and willing, and standalone in\n// this process otherwise. The exit code and the output are the command's; --envelope prints\n// one document with them and with where it ran. A command that reached the runtime and whose\n// answer did not come back whole is never rerun here: it may have run.\nfunc cmdRuntimeRun(root string, args []string, stdout, stderr io.Writer) int {\n\tenvelope, timeout := false, time.Duration(0)\n\tfor len(args) > 0 && strings.HasPrefix(args[0], \"--\") {\n\t\tswitch args[0] {\n\t\tcase \"--envelope\":\n\t\t\tenvelope = true\n\t\t\targs = args[1:]\n\t\tcase \"--timeout\":\n\t\t\tif len(args) < 2 {\n\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: --timeout needs a duration\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\td, err := time.ParseDuration(args[1])\n\t\t\tif err != nil || d <= 0 {\n\t\t\t\trender(stdout, stderr).Failure(\"pose runtime run: \" + args[1] + \" is not a duration\")\n\t\t\t\treturn 2\n\t\t\t}","numLines":110,"startLine":80,"totalLines":265}},"tool_result_meta":[{"id":"toolu_01SfBgH1t6u6xfT22y9v9Jii","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
