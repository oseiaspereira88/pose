{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/validate.go | sed -n '1141,1175p'; sed -n '1550,1592p' pose-mcp/internal/cli/validate.go; git status --porcelain=v1; git diff --exit-code\"","aggregated_output":"  1141\t\t\tChecks:        []checkResult{},\n  1142\t\t}\n  1143\t\tmatrixDigest := sha256.Sum256(raw)\n  1144\t\trun.MatrixSHA256 = \"sha256:\" + hex.EncodeToString(matrixDigest[:])\n  1145\t\trun.EngineVersion = validationEngineIdentity()\n  1146\t\tstartedClean := materialWorktreeClean(root)\n  1147\t\tvar carryState carryPlan\n  1148\t\tif carry {\n  1149\t\t\tcarryState = planCarry(root, canonicalResultsPath, mode, run.MatrixSHA256, matrix, modules)\n  1150\t\t\trun.Carry = carryState.record\n  1151\t\t\tout := render(stdout, stderr)\n  1152\t\t\tif !carryState.record.Used {\n  1153\t\t\t\tout.ContractLine(\"[carry] full run: \" + carryState.record.Reason)\n  1154\t\t\t} else {\n  1155\t\t\t\tout.ContractLine(fmt.Sprintf(\"[carry] base %s: %d changed file(s), %d/%d module(s) run\", carryState.record.BaseHead, carryState.record.Changed, len(carryState.record.Selected), len(modules)))\n  1156\t\t\t\tif explain {\n  1157\t\t\t\t\tfor _, m := range modules {\n  1158\t\t\t\t\t\tif reason, ok := carryState.record.Selected[m.Rel]; ok {\n  1159\t\t\t\t\t\t\tout.ContractLine(\"  + \" + m.Rel + \": \" + reason)\n  1160\t\t\t\t\t\t} else {\n  1161\t\t\t\t\t\t\tout.ContractLine(\"  = \" + m.Rel + \": carried from \" + carryState.record.BaseHead)\n  1162\t\t\t\t\t\t}\n  1163\t\t\t\t\t}\n  1164\t\t\t\t}\n  1165\t\t\t}\n  1166\t\t}\n  1167\t\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n  1168\t\t\trun.GitHead = strings.TrimSpace(string(head))\n  1169\t\t}\n  1170\t\tif graph, err := buildCurrentDeliveryGraph(root); err == nil {\n  1171\t\t\trun.ProvenanceDigest = graph.ProvenanceDigest\n  1172\t\t\trun.ScopeProvenance = map[string]string{}\n  1173\t\t\tseenSpecs := map[string]bool{}\n  1174\t\t\tfor _, set := range graph.ChangeSets {\n  1175\t\t\t\tif set.Spec != \"\" {\n\t}\n\tif failures > 0 {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\n// validationSummaryOf projects a finished run for `pose report`: the commands\n// it executed and one line per check, with the outcome the run reached. It is\n// the structured replacement for parsing the printed output (spec\n// pose-cli-output-rendering-system R5).\n// moduleValidationChecks resolves the stack and checks one module runs after\n// overrides, and whether the stack/module filters select it at all. The counting\n// pass and the executing pass share it so a filter can never mean two things\n// (spec pose-cli-output-rendering-system R6).\nfunc moduleValidationChecks(module validationModule, matrix validationMatrix, stackFilter, moduleFilter string) (string, []validationCheck, bool) {\n\toverride := matrix.ModuleOverrides[module.Rel]\n\tstack := module.Stack\n\tif override.Stack != \"\" {\n\t\tstack = override.Stack\n\t}\n\tif stackFilter != \"\" && stack != stackFilter || moduleFilter != \"\" && module.Rel != moduleFilter {\n\t\treturn stack, nil, false\n\t}\n\tchecks := append([]validationCheck(nil), matrix.Stacks[stack].Checks...)\n\tif override.ReplaceDefaultChecks {\n\t\tchecks = nil\n\t}\n\treturn stack, append(checks, override.Checks...), true\n}\n\n// tailLines keeps the last n lines of a check's captured output: enough to see\n// why it failed, with the full output one path away.\nfunc tailLines(text string, n int) string {\n\tlines := strings.Split(strings.TrimRight(text, \"\\n\"), \"\\n\")\n\tif len(lines) <= n {\n\t\treturn strings.Join(lines, \"\\n\")\n\t}\n\treturn strings.Join(lines[len(lines)-n:], \"\\n\")\n}\n\nfunc validationSummaryOf(run validationRunResult) *validationSummary {\n\tsummary := &validationSummary{Outcome: run.Outcome}\n","exit_code":0,"status":"completed"}}
