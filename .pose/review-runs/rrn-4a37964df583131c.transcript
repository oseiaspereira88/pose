al/pose/readiness.go\nindex 86378e9e..301d6660 100644\n--- a/pose-mcp/internal/pose/readiness.go\n+++ b/pose-mcp/internal/pose/readiness.go\n@@ -32,7 +32,7 @@ func (s Store) milestoneWaitingReason(ref string) string {\n \t\t}\n \t\tvar pending []string\n \t\tfor _, raw := range ms.Specs {\n-\t\t\tspecSlug, external := s.milestoneMember(raw)\n+\t\t\tspecSlug, external := s.canonicalMember(raw)\n \t\t\tif external {\n \t\t\t\tif !s.externalMemberDone(raw) {\n \t\t\t\t\tpending = append(pending, raw+\" (external, unresolved or not done)\")\n@@ -187,6 +187,8 @@ func (s Store) SpecReadinessWithResolver(slug, project string, resolver Artifact\n \t\t\t\tif ref.Kind == \"milestone\" && ref.Project == \"\" {\n \t\t\t\t\treason = s.milestoneWaitingReason(ref.Slug + \"/\" + ref.Milestone)\n \t\t\t\t}\n+\t\t\t} else if closed, why := s.AggregateDependencyClosed(resolver, project, resolved); !closed {\n+\t\t\t\tnotDone, reason = true, why\n \t\t\t}\n \t\t}\n \t\tif reason != \"\" {\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex 0782e239..7182af75 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -131,6 +131,10 @@ type ReviewPlan struct {\n \tWarnings                  []string `json:\"warnings,omitempty\"`\n \tBlockers                  []string `json:\"blockers,omitempty\"`\n \tExplain                   []string `json:\"explain\"`\n+\t// CloseoutReview is the closeout-review@1 decision for a milestone or a\n+\t// roadmap under an adopted policy. Like Band it is a projection: it stays\n+\t// out of the plan digest (spec pose-closeout-review-policy-by-cost-benefit).\n+\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n }\n \n type reviewRepoEntry struct {\n@@ -397,6 +401,16 @@ func (s Store) ReviewPlan(ref string) (ReviewPlan, error) {\n \tif err != nil {\n \t\treturn ReviewPlan{}, err\n \t}\n+\t// Warnings and Explain enter the digest; the decision does not, so it is\n+\t// attached only as its own field. A gate that cannot answer (a corrupt or\n+\t// drifted receipt) fails the plan as it fails closeout-check.\n+\tif !s.planWithoutCloseoutGate {\n+\t\tdecision, _, gateErr := s.closeoutReviewGate(ref, policy)\n+\t\tif gateErr != nil {\n+\t\t\treturn ReviewPlan{}, gateErr\n+\t\t}\n+\t\tplan.CloseoutReview = decision\n+\t}\n \treturn plan, nil\n }\n \n@@ -565,7 +579,7 @@ func (s Store) reviewScopeSpecs(scope ScopeRef) ([]Spec, error) {\n \t\t// Another project's member contributes no local components; its\n \t\t// review lives in its own project and reaches this scope through the\n \t\t// federated manifest.\n-\t\tslug, external := s.milestoneMember(raw)\n+\t\tslug, external := s.canonicalMember(raw)\n \t\tif external {\n \t\t\tcontinue\n \t\t}\n@@ -1085,6 +1099,7 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \tif err != nil {\n \t\treturn criteria, blockers\n \t}\n+\tadopted, _ := s.closeoutReviewPolicyAdopted()\n \tfor _, rm := range roadmaps {\n \t\tif terminalStatuses[rm.Status] {\n \t\t\tcontinue\n@@ -1094,10 +1109,19 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\tref := ScopeRef{Kind: \"milestone\", Roadmap: rm.Slug, Milestone: milestone.ID}\n-\t\t\tif member, ok := s.soleMemberOf(ref); !ok || member != scope.Slug {\n+\t\t\tmember, ok := s.soleMemberOf(ref)\n+\t\t\tcarries := ok && member == scope.Slug\n+\t\t\t// Under an adopted closeout review policy a milestone of more\n+\t\t\t// members may close without its own review; its gate is then\n+\t\t\t// judged in the review of its last member (spec\n+\t\t\t// pose-closeout-review-policy-by-cost-benefit, review round 5 N19).\n+\t\t\tif !carries && adopted {\n+\t\t\t\tcarries = s.lastOpenMemberOf(rm.Slug, milestone, scope.Slug)\n+\t\t\t}\n+\t\t\tif !carries {\n \t\t\t\tcontinue\n \t\t\t}\n-\t\t\tif done && !sealedCarries(\"milestone-exit-gate-\"+rm.Slug+\"-\"+milestone.ID) {\n+\t\t\tif done && !sealedCarries(milestoneExitGateCriterionID(rm.Slug, milestone.ID)) {\n \t\t\t\tif historyUnknown != \"\" {\n \t\t\t\t\t// Absent history is not unreadable history: the plan says it cannot\n \t\t\t\t\t// tell whether the gate was sealed, instead of silently dropping it.\n@@ -1106,8 +1130,8 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\tcriteria, blockers = addReviewCriterion(criteria, ReviewPlanCriterion{\n-\t\t\t\tID:          \"milestone-exit-gate-\" + rm.Slug + \"-\" + milestone.ID,\n-\t\t\t\tDescription: \"The exit gate of milestone:\" + rm.Slug + \"/\" + milestone.ID + \" holds: \" + milestone.ExitGate,\n+\t\t\t\tID:          milestoneExitGateCriterionID(rm.Slug, milestone.ID),\n+\t\t\t\tDescription: milestoneExitGateCriterionDescription(rm.Slug, milestone.ID, milestone.ExitGate),\n \t\t\t\tRequired:    true,\n \t\t\t\tKind:        ReviewCriterionKindJudgment,\n \t\t\t\tProfiles:    []string{\"milestone-exit-gate\"},\ndiff --git a/pose-mcp/internal/pose/roadmaps.go b/pose-mcp/internal/pose/roadmaps.go\nindex 54366f7e..44bc2c13 100644\n--- a/pose-mcp/internal/pose/roadmaps.go\n+++ b/pose-mcp/internal/pose/roadmaps.go\n@@ -22,10 +22,14 @@ type Roadmap struct {\n \tConsumes  []string `json:\"consumes,omitempty\"`\n \t// UnreviewedMilestones is the reason a roadmap gives for its reached milestones\n \t// standing without a review (ADR a-milestone-of-one-member-is-that-member).\n-\tUnreviewedMilestones string      `json:\"-\"`\n-\tMilestones           []Milestone `json:\"milestones\"`\n-\tPath                 string      `json:\"path\"`\n-\tBody                 string      `json:\"body,omitempty\"`\n+\tUnreviewedMilestones string `json:\"-\"`\n+\t// ADRs is the raw `adrs:` declaration, `[adr:<file>.md, …]`, read by the\n+\t// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n+\t// Raw so that a malformed declaration is unknown, not absent.\n+\tADRs       string      `json:\"-\"`\n+\tMilestones []Milestone `json:\"milestones\"`\n+\tPath       string      `json:\"path\"`\n+\tBody       string      `json:\"body,omitempty\"`\n }\n \n type Milestone struct {\n@@ -52,6 +56,22 @@ func (s Store) ReachedMilestones(spec string) ([]string, error) {\n \t\treturn nil, err\n \t}\n \treached := []string{}\n+\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil {\n+\t\treturn reached, err\n+\t} else if adopted {\n+\t\t// Under an adopted closeout review policy, only the explicit close\n+\t\t// makes a milestone terminal: reached means no receipt yet.\n+\t\tfor _, ref := range candidates {\n+\t\t\tclosed, err := s.closedByReceipt(ref)\n+\t\t\tif err != nil {\n+\t\t\t\treturn reached, err\n+\t\t\t}\n+\t\t\tif !closed {\n+\t\t\t\treached = append(reached, ref)\n+\t\t\t}\n+\t\t}\n+\t\treturn reached, nil\n+\t}\n \tfor _, ref := range candidates {\n \t\t// Its only member has just closed, uncommitted, so its verification cannot\n \t\t// answer yet: only a refusal recorded on the milestone says it will not stand.\n@@ -87,9 +107,15 @@ func (s Store) milestonesWithTerminalMembers(spec, scope string) ([]string, erro\n \tfor _, sp := range specs {\n \t\tstatuses[sp.Slug] = sp.Status\n \t}\n+\tadopted, _ := s.closeoutReviewPolicyAdopted()\n \tfound := []string{}\n \tfor _, rm := range roadmaps {\n-\t\tif rm.Status == \"done\" {\n+\t\t// Under an adopted closeout review policy a done roadmap closed by\n+\t\t// its receipt keeps its milestones as candidates: they leave only\n+\t\t// when the terminal projection stands. A roadmap closed before\n+\t\t// adoption keeps the contract it was sealed under (review round 7,\n+\t\t// N28); doctor reports one whose closure no longer verifies.\n+\t\tif rm.Status == \"done\" && (!adopted || s.closeoutScopeHistorical(ScopeRef{Kind: \"roadmap\", Slug: rm.Slug})) {\n \t\t\tcontinue\n \t\t}\n \t\tfor _, milestone := range rm.Milestones {\n@@ -110,7 +136,7 @@ func (s Store) milestonesWithTerminalMembers(spec, scope string) ([]string, erro\n func (s Store) milestoneMembersTerminal(milestone Milestone, statuses map[string]string, spec string) bool {\n \tmember := spec == \"\"\n \tfor _, raw := range milestone.Specs {\n-\t\tslug, external := s.milestoneMember(raw)\n+\t\tslug, external := s.canonicalMember(raw)\n \t\tif external && !s.externalMemberDone(raw) {\n \t\t\treturn false\n \t\t}\n@@ -138,7 +164,7 @@ func (s Store) soleMemberOf(scope ScopeRef) (string, bool) {\n \t\tif milestone.ID != scope.Milestone || len(milestone.Specs) != 1 {\n \t\t\tcontinue\n \t\t}\n-\t\tif slug, external := s.milestoneMember(milestone.Specs[0]); !external {\n+\t\tif slug, external := s.canonicalMember(milestone.Specs[0]); !external {\n \t\t\treturn strings.TrimPrefix(slug, \"spec:\"), true\n \t\t}\n \t}\n@@ -290,6 +316,10 @@ func (s Store) RoadmapsReachedBy(spec string) ([]string, error) {\n \t\treturn nil, err\n \t}\n \tfound := []string{}\n+\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || adopted {\n+\t\t// Adopted: a member's close leaves its milestone reached, never closed.\n+\t\treturn found, err\n+\t}\n \tfor _, rm := range roadmaps {\n \t\tfor _, milestone := range rm.Milestones {\n \t\t\tif member, ok := s.soleMemberOf(ScopeRef{Kind: \"milestone\", Roadmap: rm.Slug, Milestone: milestone.ID}); ok && member == spec {\n@@ -316,10 +346,20 @@ func (s Store) roadmapReachedApartFrom(slug, closing string) bool {\n \tif err != nil || rm.Status == \"done\" || len(rm.Milestones) == 0 {\n \t\treturn false\n \t}\n+\tadopted, err := s.closeoutReviewPolicyAdopted()\n+\tif err != nil {\n+\t\treturn false\n+\t}\n \tfor _, milestone := range rm.Milestones {\n \t\tif milestone.ID == closing {\n \t\t\tcontinue\n \t\t}\n+\t\tif adopted {\n+\t\t\tif closed, err := s.closedByReceipt(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !closed {\n+\t\t\t\treturn false\n+\t\t\t}\n+\t\t\tcontinue\n+\t\t}\n \t\tif approved, err := s.scopeApproved(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !approved {\n \t\t\treturn false\n \t\t}\n@@ -341,7 +381,7 @@ func (s Store) startWarnings(spec string) []string {\n \t\tfor _, milestone := range rm.Milestones {\n \t\t\tmember := false\n \t\t\tfor _, raw := range milestone.Specs {\n-\t\t\t\tslug, external := s.milestoneMember(raw)\n+\t\t\t\tslug, external := s.canonicalMember(raw)\n \t\t\t\tmember = member || !external && strings.TrimPrefix(slug, \"spec:\") == spec\n \t\t\t}\n \t\t\tif !member {\n@@ -355,7 +395,14 @@ func (s Store) startWarnings(spec string) []string {\n \t\t\t\tif err != nil || ref.Kind != \"milestone\" || ref.Project != \"\" {\n \t\t\t\t\tcontinue\n \t\t\t\t}\n-\t\t\t\tif approved, err := s.scopeApproved(after); err != nil {\n+\t\t\t\tapproved, err := s.scopeApproved(after)\n+\t\t\t\t// Under an adopted closeout review policy a predecessor is\n+\t\t\t\t// closed by its explicit close, not by its approval or its\n+\t\t\t\t// exemption (review round 10, N35).\n+\t\t\t\tif adopted, adoptErr := s.closeoutReviewPolicyAdopted(); err == nil && adoptErr == nil && adopted {\n+\t\t\t\t\tapproved, err = s.closedByReceipt(after)\n+\t\t\t\t}\n+\t\t\t\tif err != nil {\n \t\t\t\t\tfound[after] = after + \" comes before this spec and its approval could not be read: \" + err.Error()\n \t\t\t\t} else if !approved {\n \t\t\t\t\tfound[after] = after + \" comes before this spec and is not closed: pose close \" + after\n@@ -434,6 +481,8 @@ func parseRoadmapFile(files Files, path, slug string, includeBody bool) (*Roadma\n \t\t\trm.Consumes = parseInlineList(value)\n \t\tcase \"unreviewed_milestones\":\n \t\t\trm.UnreviewedMilestones = cleanValue(value)\n+\t\tcase \"adrs\":\n+\t\t\trm.ADRs = strings.TrimSpace(value)\n \t\t}\n \t}\n \tvar current *Milestone\n@@ -487,3 +536,8 @@ func parseRoadmapFile(files Files, path, slug string, includeBody bool) (*Roadma\n \t}\n \treturn rm, nil\n }\n+\n+func (s Store) closeoutReviewPolicyAdopted() (bool, error) {\n+\tpolicy, _, err := s.loadReviewPolicy()\n+\treturn policy.CloseoutReviewAdopted(), err\n+}\n","exit_code":0,"status":"completed"}}
