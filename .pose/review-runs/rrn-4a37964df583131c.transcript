{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '2060,2510p' pose-mcp/internal/cli/review_closeout.go\"","aggregated_output":"\tif closeGatesJudged != nil {\n\t\tcloseGatesJudged()\n\t}\n\t// Start, close and transfer of a spec share its lifecycle lock (R3).\n\tif scope.Kind == \"spec\" {\n\t\tunlock, err := posemodel.LockSpecLifecycle(root, scope.Slug, \"close.transition\")\n\t\tif err != nil {\n\t\t\tvar held *posemodel.StartLockError\n\t\t\tif errors.As(err, &held) {\n\t\t\t\trenderStartLock(render(stdout, stderr), scope.Slug, held)\n\t\t\t}\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tdefer unlock()\n\t}\n\t// The authorization is judged again inside the protected region: a\n\t// review that stopped being approved, or an action request that now\n\t// restricts closeout, while the gates ran does not govern this\n\t// publication (spec pose-writer-coordination-and-atomic-publication R4).\n\tif current, err := cliCloseoutStateForStore(store, ref); err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\treturn 1\n\t} else if !(closeReviewSatisfied(current) || receiptClose != nil && !receiptClose.Required) || hasActionRequestPending(current.Diagnostics) || hasDiagnostic(current.Diagnostics, posemodel.AdjudicationDoesNotHoldCode) {\n\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout authorization changed while its gates ran; next action: \" + current.NextAction)\n\t\treturn 1\n\t}\n\tif guard != nil {\n\t\tif err := guard(); err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t}\n\tif scope.Kind == \"spec\" {\n\t\tsp, err := store.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tif _, findings, err := store.InspectAmendmentHistory(*sp); err != nil || len(findings) > 0 {\n\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: amendment history gate failed: %v %s\", err, strings.Join(findings, \"; \")))\n\t\t\treturn 1\n\t\t}\n\t}\n\tvar receiptState posemodel.CloseoutState\n\tif receiptClose != nil {\n\t\t// Judged before the status is published: afterwards the index no\n\t\t// longer matches the tree until it is regenerated.\n\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, nil, stderr)\n\t\tif code != 0 {\n\t\t\treturn code\n\t\t}\n\t\treceiptState = judgedState\n\t\t// The intent stands from before the status until the receipt: an\n\t\t// interruption between them reads as an incomplete close, never as\n\t\t// a roadmap closed before adoption.\n\t\tif err := store.PublishCloseoutIntent(ref, *receiptClose, time.Now()); err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: closeout intent not recorded: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t}\n\tvar unsynced error\n\tif err := applyLifecycleDoneIn(store.FS, path, scope.Kind == \"spec\", judged); err != nil {\n\t\tif errors.Is(err, posemodel.ErrPublishConflict) {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error() + \"; the gates judged other bytes, so run `pose close \" + ref + \"` again to judge the current ones\")\n\t\t\treturn 1\n\t\t}\n\t\t// The transition took effect and only its durability is unconfirmed: the\n\t\t// scope is closed, and refusing here would say otherwise.\n\t\tif !errors.Is(err, posemodel.ErrPublishUnsynced) {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tunsynced = err\n\t\trender(stdout, stderr).Field(\"close.unsynced\", err.Error())\n\t}\n\tif receiptClose != nil {\n\t\t// The status is published; the receipt is the terminal marker and\n\t\t// comes after it. A failure here leaves the roadmap explicitly\n\t\t// incomplete, and the next `pose close` verifies again and publishes.\n\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, receiptState, stdout, stderr); code != 0 {\n\t\t\treturn code\n\t\t}\n\t}\n\tif transitioned != nil {\n\t\ttransitioned(unsynced)\n\t}\n\tfmt.Fprintf(stdout, \"Closed: %s\\n\", ref)\n\trenderCloseNext(render(stdout, stderr), nextCloses(store, ref))\n\treturn 0\n}\n\n// nextCloses names what the close of a scope leaves reachable: the milestones a\n// spec finished, or the roadmap a milestone finished (spec\n// pose-milestone-closes-when-reached R3). A failed read is reported in its place,\n// since the close itself stands.\nfunc nextCloses(store posemodel.Store, ref string) []string {\n\tscope, err := posemodel.ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn nil\n\t}\n\tnext := []string{}\n\tswitch scope.Kind {\n\tcase \"spec\":\n\t\treached, err := store.ReachedMilestones(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn []string{\"unavailable: \" + err.Error()}\n\t\t}\n\t\tfor _, milestone := range reached {\n\t\t\tnext = append(next, \"pose close \"+milestone)\n\t\t}\n\t\troadmaps, err := store.RoadmapsReachedBy(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn []string{\"unavailable: \" + err.Error()}\n\t\t}\n\t\tfor _, roadmap := range roadmaps {\n\t\t\tnext = append(next, \"pose close roadmap:\"+roadmap)\n\t\t}\n\tcase \"milestone\":\n\t\tif store.RoadmapReached(scope.Roadmap) {\n\t\t\tnext = append(next, \"pose close roadmap:\"+scope.Roadmap)\n\t\t}\n\t}\n\treturn next\n}\n\nfunc renderCloseNext(out *cliout.Renderer, next []string) {\n\tfor _, step := range next {\n\t\tout.Field(\"close.next\", step)\n\t}\n}\n\ntype continuousCloseoutSelection struct {\n\tSchemaVersion int    `json:\"schema_version\"`\n\tScope         string `json:\"scope\"`\n\tStartedAt     string `json:\"started_at\"`\n\tStatus        string `json:\"status\"`\n}\n\n// continuousStatusData is the payload of `continuous-closeout status`.\ntype continuousStatusData struct {\n\tActive   bool `json:\"active\"`\n\tTerminal bool `json:\"terminal\"`\n}\n\n// continuousCloseoutStatus reads the persisted selection and its closeout\n// state into one result for both renderers.\nfunc continuousCloseoutStatus(root, path string) posemodel.OperationResult {\n\tresult := posemodel.NewOperationResult(\"continuous-closeout.status\", \"\")\n\tdata := &continuousStatusData{}\n\tresult.Data = data\n\traw, err := os.ReadFile(path)\n\tif os.IsNotExist(err) {\n\t\tresult.Outcome = posemodel.OutcomeCompleted\n\t\treturn result\n\t}\n\tif err != nil {\n\t\tresult.Fail(posemodel.OutcomeFailed, \"\", \"selection-unreadable\", err.Error())\n\t\treturn result\n\t}\n\tvar selection continuousCloseoutSelection\n\tif err := json.Unmarshal(raw, &selection); err != nil || selection.SchemaVersion != 1 || selection.Status != \"active\" {\n\t\tresult.Fail(posemodel.OutcomeFailed, \"\", \"selection-invalid\", \"invalid persisted selection\")\n\t\treturn result\n\t}\n\tresult.Scope = selection.Scope\n\tstate, err := cliCloseoutState(root, selection.Scope)\n\tif err != nil {\n\t\tresult.Fail(posemodel.OutcomeFailed, \"\", \"closeout-state-unavailable\", err.Error())\n\t\treturn result\n\t}\n\tdata.Active, data.Terminal = true, state.Terminal\n\tresult.Outcome, result.NextAction = posemodel.OutcomeCompleted, state.NextAction\n\treturn result\n}\n\nfunc cmdContinuousCloseout(root string, args []string, stdout, stderr io.Writer) int {\n\tif len(args) == 0 {\n\t\targs = []string{\"status\"}\n\t}\n\tpath := filepath.Join(root, \".pose\", \"continuous-closeout.json\")\n\tswitch args[0] {\n\tcase \"start\":\n\t\tif len(args) < 2 || len(args) > 3 || len(args) == 3 && args[2] != \"--apply\" {\n\t\t\tfmt.Fprintln(stderr, \"Usage: pose continuous-closeout start <scope> [--apply]\")\n\t\t\treturn 2\n\t\t}\n\t\tref := args[1]\n\t\tstore := cliGovernedStore(root)\n\t\tpolicy, err := store.GetReviewPolicy()\n\t\tif err != nil || !policy.Enabled || !policy.ContinuousCloseout {\n\t\t\tfmt.Fprintln(stderr, \"pose continuous-closeout: continuous mode is not enabled by review policy\")\n\t\t\treturn 1\n\t\t}\n\t\tif _, err := cliCloseoutState(root, ref); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tselection := continuousCloseoutSelection{SchemaVersion: 1, Scope: ref, StartedAt: time.Now().UTC().Truncate(time.Second).Format(time.RFC3339), Status: \"active\"}\n\t\tif len(args) == 2 {\n\t\t\tfmt.Fprintf(stdout, \"continuous.scope=%s\\ncontinuous.apply=false\\n\", ref)\n\t\t\treturn 0\n\t\t}\n\t\traw, _ := json.MarshalIndent(selection, \"\", \"  \")\n\t\traw = append(raw, '\\n')\n\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tif _, err := os.Stat(path); err == nil {\n\t\t\tfmt.Fprintln(stderr, \"pose continuous-closeout: an active terminal scope already exists\")\n\t\t\treturn 1\n\t\t}\n\t\tif err := writeFileExclusive(path, raw); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"Continuous closeout started: %s\\n\", ref)\n\t\treturn 0\n\tcase \"status\":\n\t\t// status takes only --json (spec pose-cli-mcp-operation-results R3):\n\t\t// any other argument is refused rather than ignored.\n\t\tjsonOutput := false\n\t\tfor _, arg := range args[1:] {\n\t\t\tif arg != \"--json\" {\n\t\t\t\tfmt.Fprintln(stderr, \"Usage: pose continuous-closeout status [--json]\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\tjsonOutput = true\n\t\t}\n\t\tresult := continuousCloseoutStatus(root, path)\n\t\tdata, _ := result.Data.(*continuousStatusData)\n\t\tif jsonOutput {\n\t\t\tif writeJSON(stdout, result) != 0 {\n\t\t\t\treturn 1\n\t\t\t}\n\t\t} else if result.Outcome != posemodel.OutcomeCompleted {\n\t\t\tfmt.Fprintln(stderr, \"pose continuous-closeout: \"+result.Error.Message)\n\t\t} else if !data.Active {\n\t\t\tfmt.Fprintln(stdout, \"continuous.active=false\")\n\t\t} else {\n\t\t\tfmt.Fprintf(stdout, \"continuous.active=true\\ncontinuous.scope=%s\\ncontinuous.terminal=%t\\ncontinuous.next_action=%s\\n\", result.Scope, data.Terminal, result.NextAction)\n\t\t}\n\t\t// The exit keeps its documented meaning: 1 while an active scope is\n\t\t// not terminal. The query itself completed; readiness is in the data.\n\t\tif result.Outcome != posemodel.OutcomeCompleted || data.Active && !data.Terminal {\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\tcase \"complete\":\n\t\tif len(args) != 2 || args[1] != \"--apply\" {\n\t\t\tfmt.Fprintln(stderr, \"Usage: pose continuous-closeout complete --apply\")\n\t\t\treturn 2\n\t\t}\n\t\traw, err := os.ReadFile(path)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tvar selection continuousCloseoutSelection\n\t\tif json.Unmarshal(raw, &selection) != nil {\n\t\t\tfmt.Fprintln(stderr, \"pose continuous-closeout: invalid persisted selection\")\n\t\t\treturn 1\n\t\t}\n\t\tstate, err := cliCloseoutState(root, selection.Scope)\n\t\tif err != nil || !state.Terminal {\n\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: terminal success is not satisfied; next action: %s\\n\", state.NextAction)\n\t\t\treturn 1\n\t\t}\n\t\tif err := os.Remove(path); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"Continuous closeout completed: %s\\n\", selection.Scope)\n\t\treturn 0\n\tdefault:\n\t\tfmt.Fprintln(stderr, \"Usage: pose continuous-closeout <start|status|complete> [...]\")\n\t\treturn 2\n\t}\n}\n\nfunc hasOpenChild(children []posemodel.CloseoutState) bool {\n\tfor _, child := range children {\n\t\tif !child.Terminal {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// applyLifecycleDone marks the artifact done. It is published only over the\n// bytes with digest judged, the ones the gates read, so an edit made while the\n// gates ran is a conflict, never overwritten (spec\n// pose-writer-coordination-and-atomic-publication R2/R4).\nfunc applyLifecycleDone(path string, spec bool, judged string) error {\n\treturn applyLifecycleDoneIn(posemodel.NativeFiles(), path, spec, judged)\n}\n\nfunc applyLifecycleDoneIn(files posemodel.Files, path string, spec bool, judged string) error {\n\traw, err := files.ReadFile(path)\n\tif err != nil {\n\t\treturn err\n\t}\n\ttext := string(raw)\n\tif !strings.HasPrefix(text, \"---\\n\") {\n\t\treturn fmt.Errorf(\"artifact has no flat frontmatter\")\n\t}\n\ttext = posemodel.ReplaceFrontmatterValue(text, \"status\", \"done\")\n\tif spec {\n\t\ttext = posemodel.ReplaceFrontmatterValue(text, \"completed_at\", time.Now().UTC().Format(\"2006-01-02\"))\n\t}\n\texpect := posemodel.ExpectBytes(raw, true)\n\tif judged != \"\" {\n\t\texpect.Digest = judged\n\t}\n\treturn files.Publish(path, []byte(text), 0o644, posemodel.PublishAuthoritative, expect)\n}\n\n// closeTargetDigest is the SHA-256 of the spec or roadmap a close judges, or\n// \"\" when it cannot be resolved here (the gates report why).\nfunc closeTargetDigest(root string, store posemodel.Store, ref string) string {\n\tscope, err := posemodel.ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\tpath := \"\"\n\tswitch scope.Kind {\n\tcase \"spec\":\n\t\tsp, err := store.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn \"\"\n\t\t}\n\t\tpath = sp.Path\n\tcase \"roadmap\":\n\t\tpath = filepath.Join(root, \".pose\", \"roadmaps\", scope.Slug+\".md\")\n\tdefault:\n\t\treturn \"\"\n\t}\n\traw, err := posemodel.FilesOrNative(store.FS).ReadFile(path)\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\treturn posemodel.ExpectBytes(raw, true).Digest\n}\n\n// hasActionRequestPending reports a governed action request that restricts\n// the closeout.\n// hasDiagnostic reports whether diagnostics carry code.\nfunc hasDiagnostic(diagnostics []posemodel.Diagnostic, code string) bool {\n\tfor _, d := range diagnostics {\n\t\tif d.Code == code {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc hasActionRequestPending(diagnostics []posemodel.Diagnostic) bool {\n\tfor _, d := range diagnostics {\n\t\tif d.Code == \"action-request-pending\" {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// closeGatesJudged, when set, runs after the close gates judged the scope and\n// before the protected region. Only tests set it, to change the repository\n// at that point.\nvar closeGatesJudged func()\n\n// closeReviewSatisfied is the review half of close eligibility: an approval,\n// or a review the adopted closeout review policy does not require.\nfunc closeReviewSatisfied(state posemodel.CloseoutState) bool {\n\treturn state.Review.Approved || state.Review.CloseoutReview != nil && !state.Review.Required\n}\n\n// closeoutReceiptPreflight decides whether this close publishes a receipt.\n// It returns the decision to record (nil: legacy close) and an exit code, or\n// -1 to go on. A receipt already there makes the close a verification of the\n// current terminal contract. A done roadmap with no receipt is the incomplete\n// case: its decision is taken again over the current inputs, under the same\n// rules as an open scope, so a recorded rejection is never closed over.\nfunc closeoutReceiptPreflight(store posemodel.Store, ref string, scope posemodel.ScopeRef, state *posemodel.CloseoutState, stdout, stderr io.Writer) (*posemodel.CloseoutReviewDecision, int) {\n\tif scope.Kind != \"milestone\" && scope.Kind != \"roadmap\" {\n\t\treturn nil, -1\n\t}\n\tpolicy, err := store.GetReviewPolicy()\n\tif err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\treturn nil, 1\n\t}\n\tif !policy.CloseoutReviewAdopted() {\n\t\treturn nil, -1\n\t}\n\tif state.CloseoutReceipt != nil {\n\t\tif !state.Terminal {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n\t\t\treturn nil, 1\n\t\t}\n\t\t// The gates the close passed are verified again, independently of the\n\t\t// policy: a receipt does not stand for a gate that no longer holds.\n\t\tif blocker := closeGateBlocker(store.Root, scope); blocker != \"\" {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + blocker)\n\t\t\treturn nil, 1\n\t\t}\n\t\treceipt := state.CloseoutReceipt\n\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; closeout receipt of \"+receipt.ClosedAt+\" stands (review: \"+receipt.Review+\"); applicable terminal verifier passed; no transition executed\")\n\t\treturn nil, 0\n\t}\n\tdecision := state.Review.CloseoutReview\n\tif decision == nil {\n\t\t// No decision: a scope of a roadmap closed before adoption, verified by\n\t\t// the contract it was sealed under. It never gets a receipt; for a done\n\t\t// roadmap the close is a read-only verification.\n\t\tif scope.Kind == \"roadmap\" && state.LifecycleDone {\n\t\t\tif !state.Terminal {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n\t\t\t\treturn nil, 1\n\t\t\t}\n\t\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; closed before the closeout review policy was adopted; its sealed contract verifies; no transition executed\")\n\t\t\treturn nil, 0\n\t\t}\n\t\treturn nil, -1\n\t}\n\tif !decision.Known {\n\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout review of \" + ref + \" cannot be decided: \" + strings.Join(decision.Diagnostics, \"; \"))\n\t\treturn nil, 1\n\t}\n\t// An exemption replaces the review's approval, not the other gates: a\n\t// scope with any blocker, an unknown read view included, does not close.\n\tif !decision.Required && len(state.Blockers) > 0 && !onlyLifecycleBlockers(state.Blockers) {\n\t\trender(io.Discard, stderr).Failure(\"pose close: \" + ref + \" is not eligible: \" + strings.Join(state.Blockers, \"; \"))\n\t\treturn nil, 1\n\t}\n\trender(stdout, stderr).Field(\"close.review\", decision.Review()+\" (\"+decision.PolicyKey+\"=\"+decision.PolicyValue+\", \"+decision.Reason+\")\")\n\treturn decision, -1\n}\n\n// verifyCloseoutPublication judges the whole authorization once more inside\n// the protected region: the same protected decision, the same members and\n// associations, and a closeout state still eligible. It returns that state,\n// which the receipt is built from.\nfunc verifyCloseoutPublication(store posemodel.Store, ref string, decision posemodel.CloseoutReviewDecision, guard func() error, stderr io.Writer) (posemodel.CloseoutState, int) {\n\tif guard != nil {\n\t\tif err := guard(); err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn posemodel.CloseoutState{}, 1\n\t\t}\n\t}\n\tchanged := func(why string) (posemodel.CloseoutState, int) {\n","exit_code":0,"status":"completed"}}
