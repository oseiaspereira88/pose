tt.Fatalf(\"a link shown as code was dropped: %+v\", d)\n1544:func TestCloseoutReviewPolicyRoundThirteen(t *testing.T) {\n1590:\t\t\t\"comment-only value\":   \"adrs:   # optional\\n\",\n1591:\t\t\t\"value with a comment\": \"adrs: [adr:decision.md] # the governing ADR\\n\",\n1604:func TestCloseoutReviewPolicyRoundFourteen(t *testing.T) {\n1605:\tt.Run(\"code and comment context never drops a real link\", func(t *testing.T) {\n1608:\t\t\t\"comment opener in code\": \"~~~\\n<!--\\n~~~\\n\\n[real](../roadmaps/pair.md)\\n\\n<!-- -->\\n\",\n","exit_code":0,"status":"completed"}}
