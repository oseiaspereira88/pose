ofiles...), Structure: plan.Structure}\n+\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview}\n \n \tscopeProjection, excluded, err := s.reviewBundleScopeProjection(scope)\n \tif err != nil {\n@@ -1066,7 +1071,9 @@ func (s Store) reviewBundleScopeSpecs(scope ScopeRef) (map[string]bool, error) {\n \t\tfor _, milestone := range rm.Milestones {\n \t\t\tif milestone.ID == scope.Milestone {\n \t\t\t\tfor _, raw := range milestone.Specs {\n-\t\t\t\t\tif slug, external := s.milestoneMember(raw); !external {\n+\t\t\t\t\t// The member as closeout counts it: a transferred one at its\n+\t\t\t\t\t// canonical destination (review round 8, N29).\n+\t\t\t\t\tif slug, external, unresolved := s.CloseoutMemberTarget(raw); unresolved == \"\" && !external {\n \t\t\t\t\t\tresult[slug] = true\n \t\t\t\t\t}\n \t\t\t\t}\n@@ -1081,7 +1088,7 @@ func (s Store) reviewBundleScopeSpecs(scope ScopeRef) (map[string]bool, error) {\n \t\t}\n \t\tfor _, milestone := range rm.Milestones {\n \t\t\tfor _, raw := range milestone.Specs {\n-\t\t\t\tif slug, external := s.milestoneMember(raw); !external {\n+\t\t\t\tif slug, external, unresolved := s.CloseoutMemberTarget(raw); unresolved == \"\" && !external {\n \t\t\t\t\tresult[slug] = true\n \t\t\t\t}\n \t\t\t}\n@@ -1196,7 +1203,7 @@ func reviewBundlePathClass(path string, scope ScopeRef, components []ReviewPlanC\n \t\t// like the repository's own LICENSE and NOTICE (found in review).\n \t\treturn \"documentation\", true\n \t}\n-\tfor _, prefix := range []string{\".pose/state/\", \".pose/assessments/\", \".pose/reports/\", \".pose/results/\", \".pose/reviews/\", \".pose/review-bundles/\", \".pose/review-attestations/\", \".pose/review-attribution-supplements/\", \".pose/closeout-plans/\", \".pose/contributions/\", \".pose/feedback/\", \".pose/review-runs/\", \".pose/review-attempts/\", \".pose/review-run-ledger/\", \".pose/review-continuations/\", \".pose/review-private/\", \".pose/review-run-proofs/\", \".pose/delegate-runs/\", \".pose/review-conclusions/\", \".pose/adjudications/\", \".pose/events/\", \".pose/investigations/\"} {\n+\tfor _, prefix := range []string{\".pose/state/\", \".pose/assessments/\", \".pose/reports/\", \".pose/results/\", \".pose/reviews/\", \".pose/review-bundles/\", \".pose/review-attestations/\", \".pose/review-attribution-supplements/\", \".pose/closeout-plans/\", \".pose/contributions/\", \".pose/feedback/\", \".pose/review-runs/\", \".pose/review-attempts/\", \".pose/review-run-ledger/\", \".pose/review-continuations/\", \".pose/review-private/\", \".pose/review-run-proofs/\", \".pose/delegate-runs/\", \".pose/review-conclusions/\", \".pose/review-closeouts/\", \".pose/adjudications/\", \".pose/events/\", \".pose/investigations/\"} {\n \t\tif strings.HasPrefix(path, prefix) {\n \t\t\treturn \"derived-evidence\", false\n \t\t}\n@@ -1756,7 +1763,7 @@ func (s Store) milestoneOnlyExternal(scope ScopeRef) bool {\n \t\t\tcontinue\n \t\t}\n \t\tfor _, raw := range milestone.Specs {\n-\t\t\tif _, external := s.milestoneMember(raw); !external {\n+\t\t\tif _, external, unresolved := s.CloseoutMemberTarget(raw); unresolved != \"\" || !external {\n \t\t\t\treturn false\n \t\t\t}\n \t\t}\n@@ -1776,8 +1783,14 @@ func (s Store) reviewBundleChildRefs(scope ScopeRef) ([]string, error) {\n \t\t\tif milestone.ID == scope.Milestone {\n \t\t\t\tfor _, raw := range milestone.Specs {\n \t\t\t\t\t// External members are sealed through the federated\n-\t\t\t\t\t// manifest, not as local child bundles.\n-\t\t\t\t\tif slug, external := s.milestoneMember(raw); !external {\n+\t\t\t\t\t// manifest, not as local child bundles; a member a\n+\t\t\t\t\t// transfer moved is the destination it resolves to,\n+\t\t\t\t\t// never the redirect stub (review round 8, N29).\n+\t\t\t\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n+\t\t\t\t\tif unresolved != \"\" {\n+\t\t\t\t\t\treturn nil, fmt.Errorf(\"pose: %s\", unresolved)\n+\t\t\t\t\t}\n+\t\t\t\t\tif !external {\n \t\t\t\t\t\trefs = append(refs, \"spec:\"+slug)\n \t\t\t\t\t}\n \t\t\t\t}\n@@ -1805,6 +1818,17 @@ func (s Store) reviewBundleChildren(scope ScopeRef) ([]ReviewBundleChild, []stri\n \tchildren, blockers := []ReviewBundleChild{}, []string{}\n \tfor _, ref := range refs {\n \t\tif verification, err := s.verifyReviewBundle(ref); err == nil && verification.inherited {\n+\t\t\t// An inherited or exempt child stands only while it is approved:\n+\t\t\t// one whose member fell is a live obligation of this scope, never\n+\t\t\t// skipped (review round 10, N36).\n+\t\t\tif !verification.Approved {\n+\t\t\t\treason := verification.State\n+\t\t\t\tif len(verification.Blockers) > 0 {\n+\t\t\t\t\treason += \": \" + strings.Join(verification.Blockers, \"; \")\n+\t\t\t\t}\n+\t\t\t\tblockers = append(blockers, \"child \"+ref+\" does not stand: \"+reason)\n+\t\t\t\tcontinue\n+\t\t\t}\n \t\t\t// A declared milestone has no bundle to seal over: the reason is in the\n \t\t\t// roadmap, which this bundle seals.\n \t\t\tif verification.Bundle != nil {\n@@ -3451,22 +3475,110 @@ func (s Store) verifyReviewBundle(scope string) (ReviewBundleVerification, error\n // declares. Every reader of an approval comes through here, so they give one answer (ADR\n // a-milestone-of-one-member-is-that-member). A negative review recorded on it stands.\n func (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerification, error) {\n+\tverification, err := s.proportionalReviewVerificationOf(scope)\n+\tif err != nil || !verification.Approved || verification.State != \"closed\" {\n+\t\treturn verification, err\n+\t}\n+\t// Under an adopted closeout review policy an aggregate scope is closed\n+\t// only by its explicit close: an approval, its own, inherited or an\n+\t// exemption, leaves it ready to close until its receipt stands. A scope\n+\t// closed before adoption keeps its sealed reading (review round 9, N31).\n+\tref, parseErr := ParseScopeRef(scope)\n+\tif parseErr != nil || ref.Kind != \"milestone\" && ref.Kind != \"roadmap\" {\n+\t\treturn verification, nil\n+\t}\n+\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || !adopted || s.closeoutScopeHistorical(ref) || s.milestoneClosedBeforeAdoption(ref) || s.receiptStandsFor(scope) {\n+\t\treturn verification, nil\n+\t}\n+\tverification.State = \"ready-to-close\"\n+\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope + \" (`pose close \" + scope + \"` publishes its closeout receipt)\"\n+\treturn verification, nil\n+}\n+\n+func (s Store) proportionalReviewVerificationOf(scope string) (ReviewBundleVerification, error) {\n \town, err := s.computeReviewVerification(scope)\n \tif err != nil || own.Approved {\n \t\treturn own, err\n \t}\n \tref, parseErr := ParseScopeRef(scope)\n-\tif parseErr != nil || ref.Kind != \"milestone\" {\n+\tif parseErr != nil || (ref.Kind != \"milestone\" && ref.Kind != \"roadmap\") {\n \t\treturn own, nil\n \t}\n-\t// A policy without bundles answers through its review attempts alone, and has no\n-\t// bundle of the spec to stand on.\n-\tif policy, err := s.GetReviewPolicy(); err != nil || !policy.ReviewBundles {\n+\tpolicy, err := s.GetReviewPolicy()\n+\tif err != nil {\n \t\treturn own, nil\n \t}\n \tif s.milestoneReviewRefused(scope) {\n \t\treturn own, nil\n \t}\n+\t// An adopted closeout review policy is the only rule for an open scope:\n+\t// legacy inheritance and declared exemptions cannot weaken `always`, and\n+\t// the policy's own exemption reads the same gate as reviewCheck. A roadmap\n+\t// closed before adoption keeps the legacy reading below.\n+\tadopted := policy.CloseoutReviewAdopted() && !s.closeoutScopeHistorical(ref)\n+\tif adopted {\n+\t\tdecision, exempt, gateErr := s.closeoutReviewGate(scope, policy)\n+\t\tif gateErr != nil || decision == nil || !exempt || !decision.Known {\n+\t\t\treturn own, nil\n+\t\t}\n+\t\tif s.FederatedResolver != nil {\n+\t\t\tvar acceptance FederatedRoadmapAcceptanceReport\n+\t\t\tvar err error\n+\t\t\tif ref.Kind == \"milestone\" {\n+\t\t\t\tacceptance, err = s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n+\t\t\t} else {\n+\t\t\t\tacceptance, err = s.FederatedRoadmapAcceptance(s.FederatedProjectID, ref.Slug, *s.FederatedResolver)\n+\t\t\t}\n+\t\t\tif err != nil || !acceptance.Ready {\n+\t\t\t\treturn own, nil\n+\t\t\t}\n+\t\t}\n+\t\t// The exemption satisfies the review, not the close: the scope is\n+\t\t// closed only by its explicit close, whose receipt must stand, and a\n+\t\t// roadmap only over closed milestones. The full terminal verifier\n+\t\t// is closeout's (review round 8, N30).\n+\t\tverification := ReviewBundleVerification{\n+\t\t\tScope: scope, State: \"ready-to-close\", Fresh: true, Approved: true,\n+\t\t\tNextAction:     \"apply the guarded lifecycle transition for \" + scope + \" (`pose close \" + scope + \"` publishes its closeout receipt)\",\n+\t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n+\t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n+\t\t}\n+\t\t// Each child must still stand, as an approved review requires of\n+\t\t// its children: a milestone's local members by their review, a\n+\t\t// roadmap's milestones by their own verification, which is closed\n+\t\t// only once their receipt stands. Neither recurses into this scope\n+\t\t// (review round 9, N32).\n+\t\tchildren, childErr := s.reviewBundleChildRefs(ref)\n+\t\tif childErr != nil {\n+\t\t\tverification.Blockers = append(verification.Blockers, childErr.Error())\n+\t\t}\n+\t\tfor _, child := range children {\n+\t\t\tstanding, err := s.verifyReviewBundle(child)\n+\t\t\tswitch {\n+\t\t\tcase err != nil:\n+\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child+\" cannot be verified: \"+err.Error())\n+\t\t\tcase standing.State != \"closed\" || !standing.Approved || !standing.Fresh:\n+\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child+\" does not stand: \"+standing.State)\n+\t\t\t}\n+\t\t}\n+\t\tif len(verification.Blockers) > 0 {\n+\t\t\tverification.State, verification.Approved = \"needs-review\", false\n+\t\t\tverification.NextAction = \"restore or close the children of \" + scope + \" first: \" + strings.Join(verification.Blockers, \"; \")\n+\t\t}\n+\t\tif len(verification.Blockers) == 0 && s.receiptStandsFor(scope) {\n+\t\t\tverification.State, verification.NextAction = \"closed\", \"scope is closed by its closeout receipt\"\n+\t\t}\n+\t\treturn verification, nil\n+\t}\n+\t// A policy without bundles answers through its review attempts alone, and has no\n+\t// bundle of the spec to stand on. An adopted exemption is projected above\n+\t// whether bundles are enabled or not (review round 10, N34).\n+\tif !policy.ReviewBundles {\n+\t\treturn own, nil\n+\t}\n+\tif ref.Kind != \"milestone\" {\n+\t\treturn own, nil\n+\t}\n \t// Edges still bind: a milestone inherits a review, not the acceptance of what it\n \t// depends on, and revoked trust or an open predecessor leaves it where it was.\n \tif s.FederatedResolver != nil {\ndiff --git a/pose-mcp/internal/pose/review_closeout.go b/pose-mcp/internal/pose/review_closeout.go\nindex 8c4bfe79..c298ec5e 100644\n--- a/pose-mcp/internal/pose/review_closeout.go\n+++ b/pose-mcp/internal/pose/review_closeout.go\n@@ -29,6 +29,13 @@ const QualifiedArtifactPolicySchemaVersion = 3\n // refused by older engines so they cannot silently operate on transfer state.\n const SpecAuthorityTransferPolicySchemaVersion = 4\n \n+// CloseoutReviewPolicySchemaVersion carries milestone_review_required and\n+// roadmap_review_required (spec pose-closeout-review-policy-by-cost-benefit).\n+// Older engines refuse it, so none of them reads an adopted exemption as the\n+// legacy rule. It decouples the schema number from qualified references and\n+// authority transfer: both stay optional under it.\n+const CloseoutReviewPolicySchemaVersion = 5\n+\n // ScopeRef is the canonical address of a reviewable POSE scope.\n type ScopeRef struct {\n \tKind      string `json:\"kind\"`\n@@ -247,6 +254,13 @@ type ReviewPolicy struct {\n \t// pose-authority-claim-project-is-not-the-audience). Like the audience it is\n \t// read from the protected policy, never from the environment.\n \tAuthorityProject string `json:\"authority_project,omitempty\"`\n+\t// MilestoneReviewRequired and RoadmapReviewRequired decide whether the close\n+\t// of an aggregate scope owes its own independent review: never,\n+\t// when-justified or always. Both are present exactly under schema 5; an\n+\t// older schema keeps the legacy rule (ADR\n+\t// closeout-review-policy-by-cost-and-benefit).\n+\tMilestoneReviewRequired string `json:\"milestone_review_required,omitempty\"`\n+\tRoadmapReviewRequired   string `json:\"roadmap_review_required,omitempty\"`\n }\n \n // ReviewIdentityAssurance resolves the assurance a scope kind requires,\n@@ -412,6 +426,13 @@ type ReviewEvaluation struct {\n \tBundleDigest  string         `json:\"bundle_digest,omitempty\"`\n \tAttestationID string         `json:\"attestation_id,omitempty\"`\n \tBundleState   string         `json:\"bundle_state,omitempty\"`\n+\t// ApprovalOrigin names where an approval not attested on the scope itself\n+\t// came from: an inherited member, a roadmap declaration, or\n+\t// not-required:<key>=<value> under an adopted closeout review policy.\n+\tApprovalOrigin string `json:\"approval_origin,omitempty\"`\n+\t// CloseoutReview is the closeout-review@1 decision for an aggregate