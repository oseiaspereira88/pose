  134 +-\n pose-mcp/internal/pose/review_closeout.go          |   156 +-\n pose-mcp/internal/pose/review_dispatch.go          |    41 +-\n pose-mcp/internal/pose/review_plan.go              |    34 +-\n pose-mcp/internal/pose/review_run_continuity.go    |    10 +-\n pose-mcp/internal/pose/roadmaps.go                 |    72 +-\n pose-mcp/internal/pose/spec.go                     |     8 +\n pose-mcp/internal/pose/spec_transfer.go            |     2 +-\n .../scaffold/dist/.pose/templates/roadmap.md       |     1 +\n pose-mcp/internal/scaffold/dist/POSE.md            |     7 +-\n .../internal/scaffold/dist/locales/pt-BR/POSE.md   |     7 +-\n pose-mcp/schemas/v1/closeout-receipt.schema.json   |    43 +\n pose-mcp/schemas/v1/review-plan.schema.json        |     1 +\n 260 files changed, 106782 insertions(+), 5241 deletions(-)\n","exit_code":0,"status":"completed"}}
