{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_adr_associations.go'","aggregated_output":"package pose\n\n// ADR associations of a roadmap, for the when-justified roadmap rule of the\n// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n//\n// An association is explicit, never inferred from prose:\n//   - forward: the roadmap's `adrs: [adr:<file>.md]` frontmatter, or a local\n//     Markdown link from its body to a file in .pose/adr/;\n//   - backward: an ADR's `roadmaps: [roadmap:<slug>]` (or the qualified\n//     `xref:<project>/roadmap:<slug>`) frontmatter, or a local Markdown link\n//     from the ADR to .pose/roadmaps/<slug>.md.\n//\n// Only the owning project's .pose/adr/ is inventoried; nothing searches other\n// projects. A malformed declaration, a link to a missing file or an\n// incomplete inventory is unknown, which can never prove absence.\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n)\n\nconst (\n\tcloseoutADRInventoryLimit = 4096\n\tcloseoutADRSizeLimit      = 1 << 20\n)\n\nvar (\n\t// [text](dest \"title\") and [text](<dest>) inline links.\n\tmarkdownInlineLinkRE = regexp.MustCompile(`\\]\\(\\s*(<[^>\\n]*>|[^)\\s]+)(?:\\s+(?:\"[^\"]*\"|'[^']*'|\\([^)]*\\)))?\\s*\\)`)\n\t// [label]: dest \"title\" reference definitions.\n\tmarkdownReferenceLinkRE = regexp.MustCompile(`(?m)^\\s{0,3}\\[[^\\]\\n]+\\]:\\s*(<[^>\\n]*>|\\S+)`)\n)\n\nfunc (s Store) adrDir() string { return filepath.Join(s.Root, \".pose\", \"adr\") }\n\n// markdownLinkDestinations lists the link destinations of a Markdown body,\n// angle brackets and fragments removed. External URLs are kept out.\nfunc markdownLinkDestinations(body string) []string {\n\t// Code and comments are read like prose: a link shown as an example\n\t// still counts, so the reader over-enforces rather than dropping a real\n\t// link it misparsed (review round 14, N46; follow-up F6).\n\tout := []string{}\n\tadd := func(dest string) {\n\t\tdest = strings.TrimSpace(dest)\n\t\tdest = strings.TrimSuffix(strings.TrimPrefix(dest, \"<\"), \">\")\n\t\tif i := strings.IndexAny(dest, \"#?\"); i >= 0 {\n\t\t\tdest = dest[:i]\n\t\t}\n\t\tif dest == \"\" || strings.Contains(dest, \"://\") || strings.HasPrefix(dest, \"mailto:\") || strings.HasPrefix(dest, \"/\") {\n\t\t\treturn\n\t\t}\n\t\tout = append(out, dest)\n\t}\n\tfor _, m := range markdownInlineLinkRE.FindAllStringSubmatch(body, -1) {\n\t\tadd(m[1])\n\t}\n\tfor _, m := range markdownReferenceLinkRE.FindAllStringSubmatch(body, -1) {\n\t\tadd(m[1])\n\t}\n\treturn out\n}\n\n// associationList reads one association key (adrs: on a roadmap, roadmaps: on\n// an ADR) from the raw frontmatter of a governance file, strictly: a key\n// declared more than once, declared with no value, outside a [list], or with\n// an empty item is reported, never read as an absent or empty association. An\n// explicit [] declares none (review round 12, N39).\nfunc associationList(raw, key, owner string) ([]string, bool, string) {\n\tlines := strings.Split(strings.ReplaceAll(raw, \"\\r\\n\", \"\\n\"), \"\\n\")\n\tif len(lines) == 0 || strings.TrimSpace(lines[0]) != \"---\" {\n\t\treturn nil, false, \"\"\n\t}\n\tvalues := []string{}\n\tfor _, line := range lines[1:] {\n\t\tif strings.TrimSpace(line) == \"---\" {\n\t\t\tbreak\n\t\t}\n\t\t// The key and value as SplitFrontmatter reads them: the key trimmed,\n\t\t// a template comment removed (review round 13, N45).\n\t\tif name, value, ok := strings.Cut(line, \":\"); ok && strings.TrimSpace(name) == key {\n\t\t\tvalues = append(values, cleanValue(value))\n\t\t}\n\t}\n\tswitch {\n\tcase len(values) == 0:\n\t\treturn nil, false, \"\"\n\tcase len(values) > 1:\n\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: %d times; one declaration is required\", owner, key, len(values))\n\t}\n\tvalue := values[0]\n\tif value == \"\" {\n\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with no value; declare [] for none\", owner, key)\n\t}\n\tif !strings.HasPrefix(value, \"[\") || !strings.HasSuffix(value, \"]\") {\n\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: outside a [list]\", owner, key)\n\t}\n\tinner := strings.TrimSpace(value[1 : len(value)-1])\n\tif inner == \"\" {\n\t\treturn []string{}, true, \"\"\n\t}\n\titems := []string{}\n\tfor _, item := range strings.Split(inner, \",\") {\n\t\titem = strings.TrimSpace(item)\n\t\tif item == \"\" {\n\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with an empty item\", owner, key)\n\t\t}\n\t\titems = append(items, item)\n\t}\n\treturn items, true, \"\"\n}\n\n// validADRBasename accepts exactly a file name ending in .md directly inside\n// .pose/adr/: no directory, traversal, hidden file or URI.\nfunc validADRBasename(name string) bool {\n\treturn name != \"\" && filepath.Base(name) == name && !strings.ContainsAny(name, `/\\:`) &&\n\t\t!strings.HasPrefix(name, \".\") && strings.HasSuffix(name, \".md\") && name != \".md\"\n}\n\n// regularADR reports a regular, non-symlinked file of .pose/adr/ within the root.\nfunc (s Store) regularADR(name string) error {\n\tpath := filepath.Join(s.adrDir(), name)\n\tinfo, err := s.fsys().Lstat(path)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\treturn fmt.Errorf(\"not a regular file inside .pose/adr\")\n\t}\n\treturn nil\n}\n\n// closeoutADRAssociations returns the sorted ADR basenames associated with a\n// roadmap, and the diagnostics that make the answer unknown.\nfunc (s Store) closeoutADRAssociations(rm *Roadmap, project string) ([]string, []string) {\n\tfound := map[string]bool{}\n\tdiagnostics := []string{}\n\trawRoadmap, readErr := s.fsys().ReadFile(rm.Path)\n\tif readErr != nil {\n\t\tdiagnostics = append(diagnostics, \"roadmap \"+rm.Slug+\" could not be read for its adrs: \"+readErr.Error())\n\t}\n\tdeclared, _, declarationProblem := associationList(string(rawRoadmap), \"adrs\", \"roadmap \"+rm.Slug)\n\tif declarationProblem != \"\" {\n\t\tdiagnostics = append(diagnostics, declarationProblem)\n\t}\n\tfor _, item := range declared {\n\t\tname, ok := strings.CutPrefix(item, \"adr:\")\n\t\tif !ok || !validADRBasename(name) {\n\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares %q, not adr:<file>.md\", rm.Slug, item))\n\t\t\tcontinue\n\t\t}\n\t\tif err := s.regularADR(name); err != nil {\n\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares adr:%s, which cannot be read: %v\", rm.Slug, name, err))\n\t\t\tcontinue\n\t\t}\n\t\tfound[name] = true\n\t}\n\tbody := rm.Body\n\tif body == \"\" {\n\t\tif full, err := s.GetRoadmap(rm.Slug); err == nil {\n\t\t\tbody = full.Body\n\t\t}\n\t}\n\troadmapDir := filepath.Dir(rm.Path)\n\tfor _, dest := range markdownLinkDestinations(body) {\n\t\ttarget := filepath.Clean(filepath.Join(roadmapDir, filepath.FromSlash(dest)))\n\t\tif filepath.Dir(target) == filepath.Clean(s.adrDir()) && strings.ContainsAny(dest, \"()\") {\n\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, a destination with parentheses the association reader does not read whole; rename the ADR or the link\", rm.Slug, dest))\n\t\t\tcontinue\n\t\t}\n\t\tif filepath.Dir(target) != filepath.Clean(s.adrDir()) || !strings.HasSuffix(target, \".md\") {\n\t\t\tcontinue\n\t\t}\n\t\tname := filepath.Base(target)\n\t\tif err := s.regularADR(name); err != nil {\n\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, which cannot be read: %v\", rm.Slug, dest, err))\n\t\t\tcontinue\n\t\t}\n\t\tfound[name] = true\n\t}\n\tentries, err := s.fsys().ReadDir(s.adrDir())\n\tif err != nil && !os.IsNotExist(err) {\n\t\tdiagnostics = append(diagnostics, \"the ADR inventory could not be read: \"+err.Error())\n\t}\n\tif len(entries) > closeoutADRInventoryLimit {\n\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"the ADR inventory has %d entries, above the limit of %d\", len(entries), closeoutADRInventoryLimit))\n\t\tentries = nil\n\t}\n\troadmapPath := filepath.Clean(filepath.Join(s.roadmapsDir(), rm.Slug+\".md\"))\n\tfor _, entry := range entries {\n\t\tname := entry.Name()\n\t\t// Every candidate is read, the associated ones included: its size,\n\t\t// its readability and its own declaration are inputs. One that\n\t\t// cannot be read could hold a backlink, so it is unknown.\n\t\tif entry.IsDir() || !strings.HasSuffix(name, \".md\") {\n\t\t\tcontinue\n\t\t}\n\t\tif err := s.regularADR(name); err != nil {\n\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is not a regular file of .pose/adr: \"+err.Error())\n\t\t\tcontinue\n\t\t}\n\t\tpath := filepath.Join(s.adrDir(), name)\n\t\tif info, err := s.fsys().Lstat(path); err != nil || info.Size() > closeoutADRSizeLimit {\n\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is unreadable or above the size limit\")\n\t\t\tcontinue\n\t\t}\n\t\traw, err := s.fsys().ReadFile(path)\n\t\tif err != nil {\n\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" could not be read: \"+err.Error())\n\t\t\tcontinue\n\t\t}\n\t\t_, adrBody := SplitFrontmatter(string(raw))\n\t\tbackward, _, backwardProblem := associationList(string(raw), \"roadmaps\", \"ADR \"+name)\n\t\tif backwardProblem != \"\" {\n\t\t\tdiagnostics = append(diagnostics, backwardProblem)\n\t\t}\n\t\tfor _, item := range backward {\n\t\t\tref, err := ParseArtifactRef(item)\n\t\t\tif err != nil || ref.Kind != \"roadmap\" || ref.Milestone != \"\" {\n\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %q, not roadmap:<slug>\", name, item))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif ref.Project != \"\" && ref.Project != project {\n\t\t\t\tcontinue // a roadmap of another project: not this association\n\t\t\t}\n\t\t\tif _, err := s.GetRoadmap(ref.Slug); err != nil {\n\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %s, which names no roadmap of this project\", name, item))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif ref.Slug == rm.Slug {\n\t\t\t\tfound[name] = true\n\t\t\t}\n\t\t}\n\t\tfor _, dest := range markdownLinkDestinations(adrBody) {\n\t\t\ttarget := filepath.Clean(filepath.Join(s.adrDir(), filepath.FromSlash(dest)))\n\t\t\t// A destination the reader may have cut short is unknown, never an\n\t\t\t// absent association (review round 14, N47).\n\t\t\tif filepath.Dir(target) == filepath.Clean(s.roadmapsDir()) && strings.ContainsAny(dest, \"()\") {\n\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", a destination with parentheses the association reader does not read whole; rename the roadmap or the link\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif filepath.Dir(target) != filepath.Clean(s.roadmapsDir()) || !strings.HasSuffix(target, \".md\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// A link into the roadmaps namespace is an association input: one\n\t\t\t// that does not resolve to a roadmap leaves the answer unknown.\n\t\t\tif info, err := s.fsys().Lstat(target); err != nil || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, target) {\n\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which is not a roadmap of this project\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// The target is read as the roadmap it names, as a roadmaps:\n\t\t\t// declaration is: a regular entry that cannot be read or parsed\n\t\t\t// leaves the answer unknown, never an absence. The roadmaps README\n\t\t\t// is no roadmap, as ListRoadmaps reads the namespace.\n\t\t\tif strings.EqualFold(filepath.Base(target), \"README.md\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, err := s.GetRoadmap(strings.TrimSuffix(filepath.Base(target), \".md\")); err != nil {\n\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which could not be read as a roadmap of this project\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif target == roadmapPath {\n\t\t\t\tfound[name] = true\n\t\t\t}\n\t\t}\n\t}\n\tadrs := make([]string, 0, len(found))\n\tfor name := range found {\n\t\tadrs = append(adrs, name)\n\t}\n\tsort.Strings(adrs)\n\tsort.Strings(diagnostics)\n\treturn adrs, diagnostics\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_receipt.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_receipt.go'","aggregated_output":"package pose\n\n// Closeout receipts (spec pose-closeout-review-policy-by-cost-benefit R4, R7).\n// Under an adopted closeout review policy, the explicit `pose close` of a\n// milestone or a roadmap publishes a receipt: the terminal marker of that\n// close, with the evaluator's decision and the policy it was made under. A\n// receipt is written once and never reinterpreted: a later policy change does\n// not re-evaluate it, and a different or corrupt receipt is never overwritten.\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n)\n\nconst CloseoutReceiptSchemaVersion = 1\n\ntype CloseoutReceipt struct {\n\tSchemaVersion int    `json:\"schema_version\"`\n\tScope         string `json:\"scope\"`\n\tClosedAt      string `json:\"closed_at\"`\n\t// Review is the literal `required` or `not-required`.\n\tReview        string                 `json:\"review\"`\n\tDecision      CloseoutReviewDecision `json:\"decision\"`\n\tPolicyDigest  string                 `json:\"policy_digest\"`\n\tSubjectDigest string                 `json:\"subject_digest\"`\n\t// ExitGateDigest binds a milestone's exit gate as it was closed.\n\tExitGateDigest string `json:\"exit_gate_digest,omitempty\"`\n\t// ReviewBundle and ReviewAttestation name the verified review the close\n\t// stood on: required, or made by choice when not required.\n\tReviewBundle      string `json:\"review_bundle,omitempty\"`\n\tReviewAttestation string `json:\"review_attestation,omitempty\"`\n\tApprovalOrigin    string `json:\"approval_origin,omitempty\"`\n}\n\n// CloseoutReceiptPath is where the receipt of an aggregate scope lives.\nfunc (s Store) CloseoutReceiptPath(ref string) (string, error) {\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tbase := filepath.Join(s.Root, \".pose\", \"review-closeouts\")\n\tswitch scope.Kind {\n\tcase \"milestone\":\n\t\tif ValidateSlug(scope.Roadmap) != nil || !filepath.IsLocal(scope.Milestone) || filepath.Base(scope.Milestone) != scope.Milestone {\n\t\t\treturn \"\", fmt.Errorf(\"pose: invalid milestone scope %s\", ref)\n\t\t}\n\t\treturn filepath.Join(base, \"milestone\", scope.Roadmap, scope.Milestone+\".json\"), nil\n\tcase \"roadmap\":\n\t\tif ValidateSlug(scope.Slug) != nil {\n\t\t\treturn \"\", fmt.Errorf(\"pose: invalid roadmap scope %s\", ref)\n\t\t}\n\t\treturn filepath.Join(base, \"roadmap\", scope.Slug+\".json\"), nil\n\t}\n\treturn \"\", fmt.Errorf(\"pose: %s has no closeout receipt; only milestones and roadmaps do\", ref)\n}\n\n// ReadCloseoutReceipt returns the receipt of a scope, nil when there is none.\n// A receipt that cannot be read or does not validate is an error, never an\n// absence: it would otherwise reopen a closed scope or hide a corruption.\nfunc (s Store) ReadCloseoutReceipt(ref string) (*CloseoutReceipt, error) {\n\tpath, err := s.CloseoutReceiptPath(ref)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tinfo, err := s.fsys().Lstat(path)\n\tif os.IsNotExist(err) {\n\t\treturn nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\tif !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s is not a regular file of this project\", ref)\n\t}\n\traw, err := s.fsys().ReadFile(path)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\treceipt, err := parseCloseoutReceipt(raw)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\tif receipt.Scope != ref || receipt.Decision.Scope != ref {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt at %s names %s, not %s\", path, receipt.Scope, ref)\n\t}\n\treturn &receipt, nil\n}\n\nfunc parseCloseoutReceipt(raw []byte) (CloseoutReceipt, error) {\n\tvar receipt CloseoutReceipt\n\tif err := rejectDuplicateJSONKeysAndControls(raw); err != nil {\n\t\treturn receipt, err\n\t}\n\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n\tdecoder.DisallowUnknownFields()\n\tif err := decoder.Decode(&receipt); err != nil {\n\t\treturn receipt, err\n\t}\n\tif err := decoder.Decode(new(any)); err != io.EOF {\n\t\treturn receipt, errors.New(\"trailing content\")\n\t}\n\tif receipt.SchemaVersion != CloseoutReceiptSchemaVersion {\n\t\treturn receipt, fmt.Errorf(\"unsupported schema_version %d\", receipt.SchemaVersion)\n\t}\n\tif _, valid := reviewInstant(receipt.ClosedAt); !valid {\n\t\treturn receipt, fmt.Errorf(\"closed_at %q is not an instant\", receipt.ClosedAt)\n\t}\n\td := receipt.Decision\n\tif !d.Adopted || d.EvaluatorVersion != CloseoutReviewEvaluatorVersion || !validCloseoutReviewValue(d.PolicyValue) || d.Reason == \"\" {\n\t\treturn receipt, errors.New(\"decision is not one of \" + CloseoutReviewEvaluatorVersion)\n\t}\n\tif d.PolicyValue == CloseoutReviewNever && d.Required && d.Reason == \"\" || d.PolicyValue == CloseoutReviewAlways && !d.Required {\n\t\treturn receipt, fmt.Errorf(\"a %s decision cannot be required=%v\", d.PolicyValue, d.Required)\n\t}\n\tif receipt.Review != d.Review() {\n\t\treturn receipt, fmt.Errorf(\"review %q contradicts the recorded decision (%s)\", receipt.Review, d.Review())\n\t}\n\tif d.Required && receipt.ReviewBundle == \"\" && receipt.ApprovalOrigin == \"\" {\n\t\treturn receipt, errors.New(\"a required review names no verified review\")\n\t}\n\tif !d.Known {\n\t\treturn receipt, errors.New(\"a close cannot stand on unknown members or associations\")\n\t}\n\tif receipt.PolicyDigest == \"\" || receipt.SubjectDigest == \"\" {\n\t\treturn receipt, errors.New(\"policy_digest and subject_digest are required\")\n\t}\n\treturn receipt, nil\n}\n\n// NewCloseoutReceipt builds the receipt of a close from the evaluator's\n// decision and the verification it stood on. It writes nothing.\nfunc (s Store) NewCloseoutReceipt(ref string, decision CloseoutReviewDecision, verification ReviewEvaluation, subjectDigest string, now time.Time) (CloseoutReceipt, error) {\n\t_, raw, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn CloseoutReceipt{}, err\n\t}\n\t_, gate, _, err := s.closeoutSubject(ref)\n\tif err != nil {\n\t\treturn CloseoutReceipt{}, err\n\t}\n\treceipt := CloseoutReceipt{\n\t\tExitGateDigest: gate,\n\t\tSchemaVersion:  CloseoutReceiptSchemaVersion, Scope: ref, ClosedAt: now.UTC().Format(time.RFC3339),\n\t\tReview: decision.Review(), Decision: decision, PolicyDigest: \"sha256:\" + digestHex(raw), SubjectDigest: subjectDigest,\n\t\tReviewBundle: verification.BundleID, ReviewAttestation: verification.AttestationID,\n\t}\n\tif receipt.ReviewBundle == \"\" && verification.Current != nil {\n\t\treceipt.ApprovalOrigin = \"review:\" + verification.Current.ReviewID\n\t}\n\tif receipt.ReviewBundle == \"\" && receipt.ApprovalOrigin == \"\" {\n\t\treceipt.ApprovalOrigin = verification.ApprovalOrigin\n\t}\n\tif _, err := parseCloseoutReceipt(CanonicalJSON(receipt)); err != nil {\n\t\treturn CloseoutReceipt{}, fmt.Errorf(\"pose: the closeout receipt of %s would be refused: %w\", ref, err)\n\t}\n\treturn receipt, nil\n}\n\n// ErrCloseoutReceiptExists reports a receipt already published for the scope.\nvar ErrCloseoutReceiptExists = errors.New(\"pose: a closeout receipt already exists\")\n\n// PublishCloseoutReceipt publishes a receipt where none exists. It never\n// replaces one: an equal receipt is the caller's to verify, a different one\n// stays as it is.\nfunc (s Store) PublishCloseoutReceipt(receipt CloseoutReceipt) error {\n\tpath, err := s.CloseoutReceiptPath(receipt.Scope)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif existing, err := s.ReadCloseoutReceipt(receipt.Scope); err != nil {\n\t\treturn err\n\t} else if existing != nil {\n\t\treturn ErrCloseoutReceiptExists\n\t}\n\traw, err := json.MarshalIndent(receipt, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\terr = s.fsys().Publish(path, append(raw, '\\n'), 0o644, PublishDerived, PublishExpectation{Mode: ExpectAbsent})\n\tif errors.Is(err, ErrPublishConflict) {\n\t\treturn ErrCloseoutReceiptExists\n\t}\n\treturn err\n}\n\n// A roadmap's close publishes its status and then its receipt. Between the\n// two an intent stands, so a close interrupted there reads as incomplete,\n// never as a roadmap closed before adoption (spec\n// pose-closeout-review-policy-by-cost-benefit R4, R7).\nfunc (s Store) closeoutIntentPath(ref string) (string, error) {\n\tpath, err := s.CloseoutReceiptPath(ref)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn strings.TrimSuffix(path, \".json\") + \".intent.json\", nil\n}\n\n// closeoutIntentPending reports an intent on file. What cannot be read is an\n// error, which the caller treats as pending: it never proves history.\nfunc (s Store) closeoutIntentPending(ref string) (bool, error) {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif _, err := s.fsys().Lstat(path); err == nil {\n\t\treturn true, nil\n\t} else if os.IsNotExist(err) {\n\t\treturn false, nil\n\t} else {\n\t\treturn false, err\n\t}\n}\n\n// PublishCloseoutIntent records that this engine is closing ref under the\n// adopted policy, before the roadmap's status is published.\nfunc (s Store) PublishCloseoutIntent(ref string, decision CloseoutReviewDecision, now time.Time) error {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn err\n\t}\n\traw, err := json.MarshalIndent(map[string]any{\"schema_version\": 1, \"scope\": ref, \"started_at\": now.UTC().Format(time.RFC3339), \"review\": decision.Review()}, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\treturn s.fsys().Publish(path, append(raw, '\\n'), 0o644, PublishDerived, PublishExpectation{Mode: ExpectAny})\n}\n\n// ClearCloseoutIntent removes the intent once the receipt stands.\nfunc (s Store) ClearCloseoutIntent(ref string) error {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().Remove(path); err != nil && !os.IsNotExist(err) {\n\t\treturn err\n\t}\n\treturn nil\n}\n\n// roadmapCriteriaBlockers evaluates a roadmap's cut criteria from the indexed\n// delivery graph, as the roadmap gate does: a criterion that does not pass,\n// or a manual review that does not resolve inside the project. A graph that\n// cannot be read is a blocker, never a pass.\nfunc (s Store) roadmapCriteriaBlockers(slug string) []string {\n\tgraph, err := s.GetDeliveryIntegrity(\"\")\n\tif err != nil {\n\t\treturn []string{\"the cut criteria of roadmap \" + slug + \" cannot be evaluated: \" + err.Error()}\n\t}\n\tblockers := []string{}\n\tfor _, criterion := range graph.RoadmapCriteria {\n\t\tif criterion.Roadmap != slug {\n\t\t\tcontinue\n\t\t}\n\t\tif !criterion.Passed {\n\t\t\tblockers = append(blockers, criterion.ID+\": \"+strings.Join(criterion.Reasons, \"; \"))\n\t\t}\n\t\tfor _, ref := range criterion.Refs {\n\t\t\trelative, manual := strings.CutPrefix(ref, \"manual-review:\")\n\t\t\tif !manual {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tpath := filepath.Join(s.Root, filepath.FromSlash(relative))\n\t\t\tif !filepath.IsLocal(filepath.FromSlash(relative)) || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\t\t\tblockers = append(blockers, criterion.ID+\": manual review escapes project\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif info, err := s.fsys().Stat(path); err != nil || info.IsDir() {\n\t\t\t\tblockers = append(blockers, criterion.ID+\": manual review does not resolve: \"+relative)\n\t\t\t}\n\t\t}\n\t}\n\treturn blockers\n}\n","exit_code":0,"status":"completed"}}
