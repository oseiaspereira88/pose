{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UZWgBjZqu8sntvmgT6M1Qk","type":"tool_result","content":"140\t}\n141\t\n142\t// IndexGenerationView is what a reader got: the status, the descriptor it\n143\t// fixed and, for a current set, the bytes it read.\n144\ttype IndexGenerationView struct {\n145\t\tStatus     IndexGenerationStatus\n146\t\tReason     string\n147\t\tDescriptor IndexGenerationDescriptor\n148\t\tFiles      map[string][]byte\n149\t\t// DescriptorBytes are the exact bytes of the descriptor this view was built\n150\t\t// from; a replacement commits over them, not over whatever it reads later.\n151\t\tDescriptorBytes []byte\n152\t\t// Diverged lists the legacy names (.pose/indexes/<file>) whose bytes are not\n153\t\t// those of the generation although the generation is whole: the file was\n154\t\t// edited by hand, or a publication is running and has not committed yet.\n155\t\t// Engine readers read the generation, so they do not see the difference;\n156\t\t// `pose index --verify` does, and fails on it.\n157\t\tDiverged []string\n158\t}\n159\t\n160\t// IndexGenerationReceipt is the outcome of one publication.\n161\ttype IndexGenerationReceipt struct {\n162\t\tGenerationID string\n163\t\tPrevious     string\n164\t\t// Committed: the descriptor now names GenerationID, even when the call\n165\t\t// returned an error (a commit whose durability could not be confirmed).\n166\t\tCommitted bool\n167\t\t// Unchanged: the descriptor already named this generation and every file,\n168\t\t// under its legacy name too, matched it, so nothing was written. A legacy\n169\t\t// name that diverged (edited by hand, a publication that stopped before the\n170\t\t// commit) is written again.\n171\t\tUnchanged bool\n172\t\t// CleanupError is the retention step failing after the generation was\n173\t\t// committed; it never makes the publication a failure.\n174\t\tCleanupError error\n175\t}\n176\t\n177\t// IndexPublishFault and IndexPublishPhase let tests stop a publication between\n178\t// phases. They are unset in production.\n179\tvar IndexPublishFault func(phase string) error\n180\t\n181\t// IndexReadFault lets tests run something between a reader's read of the\n182\t// descriptor and its read of the files. It is unset in production.\n183\tvar IndexReadFault func(phase string)\n184\t\n185\tfunc indexFault(phase string) error {\n186\t\tif IndexPublishFault != nil {\n187\t\t\treturn IndexPublishFault(phase)\n188\t\t}\n189\t\treturn nil\n190\t}\n191\t\n192\tfunc indexDir(root string) string { return filepath.Join(root, \".pose\", \"indexes\") }\n193\t\n194\t// indexPendingName marks a first publication in progress: written before the\n195\t// legacy names change in a repository that has no descriptor yet, removed once\n196\t// the descriptor is committed. While it exists without a descriptor the legacy\n197\t// files may be a mixture of two runs, and readers say so.\n198\tconst indexPendingName = \".generation-pending\"\n199\t\n200\tfunc indexLockPath(root string) string { return filepath.Join(indexDir(root), \".generation.lock\") }\n201\t\n202\tfunc indexGenerationDir(root, id string) string {\n203\t\treturn filepath.Join(indexDir(root), indexGenerationsDir, id)\n204\t}\n205\t\n206\tvar indexGenerationIDRE = regexp.MustCompile(`^gen-[0-9a-f]{16}$`)\n207\t\n208\tfunc sha256Prefixed(raw []byte) string {\n209\t\tsum := sha256.Sum256(raw)\n210\t\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n211\t}\n212\t\n213\t// NewIndexGenerationDescriptor builds the descriptor for these outputs. The\n214\t// identity is a digest of the file digests and the bindings, so two runs over\n215\t// the same inputs name the same generation and a retry converges on it.\n216\tfunc NewIndexGenerationDescriptor(outputs map[string][]byte, inputs map[string]string) (IndexGenerationDescriptor, error) {\n217\t\tif len(outputs) != len(IndexGenerationFiles) {\n218\t\t\treturn IndexGenerationDescriptor{}, fmt.Errorf(\"pose: an index generation has exactly %d files, got %d\", len(IndexGenerationFiles), len(outputs))\n219\t\t}\n220\t\tfiles := make([]IndexGenerationFile, 0, len(IndexGenerationFiles))\n221\t\tfor _, name := range IndexGenerationFiles {\n222\t\t\traw, ok := outputs[name]\n223\t\t\tif !ok {\n224\t\t\t\treturn IndexGenerationDescriptor{}, fmt.Errorf(\"pose: index generation is missing %s\", name)\n225\t\t\t}\n226\t\t\tfiles = append(files, IndexGenerationFile{Name: name, SHA256: sha256Prefixed(raw), Bytes: len(raw)})\n227\t\t}\n228\t\tbound := map[string]string{}\n229\t\tfor key, value := range inputs {\n230\t\t\tbound[key] = value\n231\t\t}\n232\t\tidentity, err := json.Marshal(struct {\n233\t\t\tFiles  []IndexGenerationFile `json:\"files\"`\n234\t\t\tInputs map[string]string     `json:\"inputs\"`\n235\t\t}{files, bound})\n236\t\tif err != nil {\n237\t\t\treturn IndexGenerationDescriptor{}, err\n238\t\t}\n239\t\tsum := sha256.Sum256(identity)\n240\t\treturn IndexGenerationDescriptor{\n241\t\t\tSchemaVersion: IndexGenerationSchemaVersion,\n242\t\t\tGenerationID:  indexGenerationPrefix + hex.EncodeToString(sum[:8]),\n243\t\t\tFiles:         files,\n244\t\t\tInputs:        bound,\n245\t\t}, nil\n246\t}\n247\t\n248\tfunc (d IndexGenerationDescriptor) bytes() ([]byte, error) {\n249\t\traw, err := json.MarshalIndent(d, \"\", \"  \")\n250\t\tif err != nil {\n251\t\t\treturn nil, err\n252\t\t}\n253\t\treturn append(raw, '\\n'), nil\n254\t}\n255\t\n256\tfunc (d IndexGenerationDescriptor) file(name string) (IndexGenerationFile, bool) {\n257\t\tfor _, f := range d.Files {\n258\t\t\tif f.Name == name {\n259\t\t\t\treturn f, true\n260\t\t\t}\n261\t\t}\n262\t\treturn IndexGenerationFile{}, false\n263\t}\n264\t\n265\t// validate refuses a descriptor that is not the one this engine writes: another\n266\t// schema, another file set, a digest that is not a SHA-256, an id that is not\n267\t// the digest of the content.\n268\tfunc (d IndexGenerationDescriptor) validate() error {\n269\t\tif d.SchemaVersion != IndexGenerationSchemaVersion {\n270\t\t\treturn fmt.Errorf(\"schema_version %d is not supported (this engine reads %d)\", d.SchemaVersion, IndexGenerationSchemaVersion)\n271\t\t}\n272\t\tif len(d.Files) != len(IndexGenerationFiles) {\n273\t\t\treturn fmt.Errorf(\"the descriptor lists %d files, a generation has %d\", len(d.Files), len(IndexGenerationFiles))\n274\t\t}\n275\t\tfor i, name := range IndexGenerationFiles {\n276\t\t\tf := d.Files[i]\n277\t\t\tif f.Name != name {\n278\t\t\t\treturn fmt.Errorf(\"file %d is %q, expected %q\", i, f.Name, name)\n279\t\t\t}\n280\t\t\tif !strings.HasPrefix(f.SHA256, \"sha256:\") || len(f.SHA256) != len(\"sha256:\")+64 {\n281\t\t\t\treturn fmt.Errorf(\"%s has no SHA-256 digest\", name)\n282\t\t\t}\n283\t\t}\n284\t\tif !indexGenerationIDRE.MatchString(d.GenerationID) {\n285\t\t\treturn fmt.Errorf(\"generation_id %q is malformed\", d.GenerationID)\n286\t\t}\n287\t\tidentity, err := json.Marshal(struct {\n288\t\t\tFiles  []IndexGenerationFile `json:\"files\"`\n289\t\t\tInputs map[string]string     `json:\"inputs\"`\n290\t\t}{d.Files, nilToEmpty(d.Inputs)})\n291\t\tif err != nil {\n292\t\t\treturn err\n293\t\t}\n294\t\tsum := sha256.Sum256(identity)\n295\t\tif want := indexGenerationPrefix + hex.EncodeToString(sum[:8]); want != d.GenerationID {\n296\t\t\treturn fmt.Errorf(\"generation_id %s does not match the descriptor content (%s)\", d.GenerationID, want)\n297\t\t}\n298\t\treturn nil\n299\t}\n300\t\n301\tfunc nilToEmpty(m map[string]string) map[string]string {\n302\t\tif m == nil {\n303\t\t\treturn map[string]string{}\n304\t\t}\n305\t\treturn m\n306\t}\n307\t\n308\t// readDescriptor reads the commit record. exists is false when there is none.\n309\tfunc readIndexDescriptor(files Files, root string) (desc IndexGenerationDescriptor, raw []byte, exists bool, err error) {\n310\t\traw, readErr := files.ReadFile(filepath.Join(indexDir(root), indexDescriptorName))\n311\t\tif errors.Is(readErr, os.ErrNotExist) {\n312\t\t\treturn IndexGenerationDescriptor{}, nil, false, nil\n313\t\t}\n314\t\tif readErr != nil {\n315\t\t\treturn IndexGenerationDescriptor{}, nil, true, fmt.Errorf(\"the generation descriptor cannot be read: %w\", readErr)\n316\t\t}\n317\t\tdec := json.NewDecoder(strings.NewReader(string(raw)))\n318\t\tdec.DisallowUnknownFields()\n319\t\tif err := dec.Decode(&desc); err != nil {\n320\t\t\treturn IndexGenerationDescriptor{}, raw, true, fmt.Errorf(\"the generation descriptor is not valid JSON of the expected shape: %w\", err)\n321\t\t}\n322\t\tif _, err := dec.Token(); err != io.EOF {\n323\t\t\treturn IndexGenerationDescriptor{}, raw, true, errors.New(\"the generation descriptor has data after its value\")\n324\t\t}\n325\t\tif err := desc.validate(); err != nil {\n326\t\t\treturn IndexGenerationDescriptor{}, raw, true, fmt.Errorf(\"the generation descriptor is invalid: %w\", err)\n327\t\t}\n328\t\treturn desc, raw, true, nil\n329\t}\n330\t\n331\t// readGenerationFile returns the bytes of one file of the generation that match\n332\t// its digest: the immutable copy when it exists and matches, the legacy name\n333\t// when that matches. When neither matches it returns the bytes it found, so the\n334\t// caller can say what differed, and ok false.\n335\tfunc readGenerationFile(files Files, root, id, name, want string) (data []byte, ok bool, err error) {\n336\t\tvar lastErr error\n337\t\tfor _, path := range []string{filepath.Join(indexGenerationDir(root, id), name), filepath.Join(indexDir(root), name)} {\n338\t\t\traw, readErr := files.ReadFile(path)\n339\t\t\tif readErr != nil {\n340\t\t\t\tif lastErr == nil || !errors.Is(readErr, os.ErrNotExist) {\n341\t\t\t\t\tlastErr = readErr\n342\t\t\t\t}\n343\t\t\t\tcontinue\n344\t\t\t}\n345\t\t\tif sha256Prefixed(raw) == want {\n346\t\t\t\treturn raw, true, nil\n347\t\t\t}\n348\t\t\tdata, lastErr = raw, nil\n349\t\t}\n350\t\treturn data, false, lastErr\n351\t}\n352\t\n353\t// ReadIndexGeneration fixes the generation named by the descriptor and returns\n354\t// every file of it, each checked against the descriptor. It starts again if the\n355\t// descriptor is replaced while it reads, a bounded number of times.\n356\tfunc (s Store) ReadIndexGeneration() IndexGenerationView {\n357\t\tfor attempt := 0; attempt < indexReadAttempts; attempt++ {\n358\t\t\tdesc, raw, exists, err := readIndexDescriptor(s.fsys(), s.Root)\n359\t\t\tif err != nil {\n360\t\t\t\treturn IndexGenerationView{Status: IndexGenerationUnavailable, Reason: err.Error()}\n361\t\t\t}\n362\t\t\tif !exists {\n363\t\t\t\tif indexPendingIn(s.fsys(), s.Root) {\n364\t\t\t\t\treturn IndexGenerationView{Status: IndexGenerationUnavailable, Reason: \"a first index generation was being published and did not commit: the index files may mix two runs; run `pose index`\"}\n365\t\t\t\t}\n366\t\t\t\treturn IndexGenerationView{Status: IndexGenerationLegacy, Reason: \"no generation descriptor: the indexes were not published as a set\"}\n367\t\t\t}\n368\t\t\tif IndexReadFault != nil {\n369\t\t\t\tIndexReadFault(\"after-descriptor\")\n370\t\t\t}\n371\t\t\tfiles := map[string][]byte{}\n372\t\t\tdiverged := []string{}\n373\t\t\tvar problem string\n374\t\t\tfor _, f := range desc.Files {\n375\t\t\t\tdata, matched, readErr := readGenerationFile(s.fsys(), s.Root, desc.GenerationID, f.Name, f.SHA256)\n376\t\t\t\tif readErr != nil {\n377\t\t\t\t\tproblem = fmt.Sprintf(\"%s of generation %s cannot be read: %v\", f.Name, desc.GenerationID, readErr)\n378\t\t\t\t\tbreak\n379\t\t\t\t}\n380\t\t\t\tif !matched {\n381\t\t\t\t\tproblem = fmt.Sprintf(\"%s does not match generation %s (descriptor %s, file %s)\", f.Name, desc.GenerationID, f.SHA256, sha256Prefixed(data))\n382\t\t\t\t\tbreak\n383\t\t\t\t}\n384\t\t\t\tfiles[f.Name] = data\n385\t\t\t\tif legacy, legacyErr := s.fsys().ReadFile(filepath.Join(indexDir(s.Root), f.Name)); legacyErr != nil || sha256Prefixed(legacy) != f.SHA256 {\n386\t\t\t\t\tdiverged = append(diverged, f.Name)\n387\t\t\t\t}\n388\t\t\t}\n389\t\t\tagain, againRaw, _, againErr := readIndexDescriptor(s.fsys(), s.Root)\n390\t\t\tif againErr == nil && again.GenerationID == desc.GenerationID && string(againRaw) == string(raw) {\n391\t\t\t\tif problem != \"\" {\n392\t\t\t\t\treturn IndexGenerationView{Status: IndexGenerationUnavailable, Reason: problem, Descriptor: desc}\n393\t\t\t\t}\n394\t\t\t\treturn IndexGenerationView{Status: IndexGenerationCurrent, Descriptor: desc, Files: files, Diverged: diverged, DescriptorBytes: raw}\n395\t\t\t}\n396\t\t}\n397\t\treturn IndexGenerationView{Status: IndexGenerationUnavailable, Reason: \"the generation descriptor kept changing while it was read\"}\n398\t}\n399\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"0f70ac26-1558-486e-bf4e-40ba3d42868a","timestamp":"2026-11-11T00:20:39.153Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-239315660/worktree/pose-mcp/internal/pose/index_generation.go","content":"}\n\n// IndexGenerationView is what a reader got: the status, the descriptor it\n// fixed and, for a current set, the bytes it read.\ntype IndexGenerationView struct {\n\tStatus     IndexGenerationStatus\n\tReason     string\n\tDescriptor IndexGenerationDescriptor\n\tFiles      map[string][]byte\n\t// DescriptorBytes are the exact bytes of the descriptor this view was built\n\t// from; a replacement commits over them, not over whatever it reads later.\n\tDescriptorBytes []byte\n\t// Diverged lists the legacy names (.pose/indexes/<file>) whose bytes are not\n\t// those of the generation although the generation is whole: the file was\n\t// edited by hand, or a publication is running and has not committed yet.\n\t// Engine readers read the generation, so they do not see the difference;\n\t// `pose index --verify` does, and fails on it.\n\tDiverged []string\n}\n\n// IndexGenerationReceipt is the outcome of one publication.\ntype IndexGenerationReceipt struct {\n\tGenerationID string\n\tPrevious     string\n\t// Committed: the descriptor now names GenerationID, even when the call\n\t// returned an error (a commit whose durability could not be confirmed).\n\tCommitted bool\n\t// Unchanged: the descriptor already named this generation and every file,\n\t// under its legacy name too, matched it, so nothing was written. A legacy\n\t// name that diverged (edited by hand, a publication that stopped before the\n\t// commit) is written again.\n\tUnchanged bool\n\t// CleanupError is the retention step failing after the generation was\n\t// committed; it never makes the publication a failure.\n\tCleanupError error\n}\n\n// IndexPublishFault and IndexPublishPhase let tests stop a publication between\n// phases. They are unset in production.\nvar IndexPublishFault func(phase string) error\n\n// IndexReadFault lets tests run something between a reader's read of the\n// descriptor and its read of the files. It is unset in production.\nvar IndexReadFault func(phase string)\n\nfunc indexFault(phase string) error {\n\tif IndexPublishFault != nil {\n\t\treturn IndexPublishFault(phase)\n\t}\n\treturn nil\n}\n\nfunc indexDir(root string) string { return filepath.Join(root, \".pose\", \"indexes\") }\n\n// indexPendingName marks a first publication in progress: written before the\n// legacy names change in a repository that has no descriptor yet, removed once\n// the descriptor is committed. While it exists without a descriptor the legacy\n// files may be a mixture of two runs, and readers say so.\nconst indexPendingName = \".generation-pending\"\n\nfunc indexLockPath(root string) string { return filepath.Join(indexDir(root), \".generation.lock\") }\n\nfunc indexGenerationDir(root, id string) string {\n\treturn filepath.Join(indexDir(root), indexGenerationsDir, id)\n}\n\nvar indexGenerationIDRE = regexp.MustCompile(`^gen-[0-9a-f]{16}$`)\n\nfunc sha256Prefixed(raw []byte) string {\n\tsum := sha256.Sum256(raw)\n\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n}\n\n// NewIndexGenerationDescriptor builds the descriptor for these outputs. The\n// identity is a digest of the file digests and the bindings, so two runs over\n// the same inputs name the same generation and a retry converges on it.\nfunc NewIndexGenerationDescriptor(outputs map[string][]byte, inputs map[string]string) (IndexGenerationDescriptor, error) {\n\tif len(outputs) != len(IndexGenerationFiles) {\n\t\treturn IndexGenerationDescriptor{}, fmt.Errorf(\"pose: an index generation has exactly %d files, got %d\", len(IndexGenerationFiles), len(outputs))\n\t}\n\tfiles := make([]IndexGenerationFile, 0, len(IndexGenerationFiles))\n\tfor _, name := range IndexGenerationFiles {\n\t\traw, ok := outputs[name]\n\t\tif !ok {\n\t\t\treturn IndexGenerationDescriptor{}, fmt.Errorf(\"pose: index generation is missing %s\", name)\n\t\t}\n\t\tfiles = append(files, IndexGenerationFile{Name: name, SHA256: sha256Prefixed(raw), Bytes: len(raw)})\n\t}\n\tbound := map[string]string{}\n\tfor key, value := range inputs {\n\t\tbound[key] = value\n\t}\n\tidentity, err := json.Marshal(struct {\n\t\tFiles  []IndexGenerationFile `json:\"files\"`\n\t\tInputs map[string]string     `json:\"inputs\"`\n\t}{files, bound})\n\tif err != nil {\n\t\treturn IndexGenerationDescriptor{}, err\n\t}\n\tsum := sha256.Sum256(identity)\n\treturn IndexGenerationDescriptor{\n\t\tSchemaVersion: IndexGenerationSchemaVersion,\n\t\tGenerationID:  indexGenerationPrefix + hex.EncodeToString(sum[:8]),\n\t\tFiles:         files,\n\t\tInputs:        bound,\n\t}, nil\n}\n\nfunc (d IndexGenerationDescriptor) bytes() ([]byte, error) {\n\traw, err := json.MarshalIndent(d, \"\", \"  \")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn append(raw, '\\n'), nil\n}\n\nfunc (d IndexGenerationDescriptor) file(name string) (IndexGenerationFile, bool) {\n\tfor _, f := range d.Files {\n\t\tif f.Name == name {\n\t\t\treturn f, true\n\t\t}\n\t}\n\treturn IndexGenerationFile{}, false\n}\n\n// validate refuses a descriptor that is not the one this engine writes: another\n// schema, another file set, a digest that is not a SHA-256, an id that is not\n// the digest of the content.\nfunc (d IndexGenerationDescriptor) validate() error {\n\tif d.SchemaVersion != IndexGenerationSchemaVersion {\n\t\treturn fmt.Errorf(\"schema_version %d is not supported (this engine reads %d)\", d.SchemaVersion, IndexGenerationSchemaVersion)\n\t}\n\tif len(d.Files) != len(IndexGenerationFiles) {\n\t\treturn fmt.Errorf(\"the descriptor lists %d files, a generation has %d\", len(d.Files), len(IndexGenerationFiles))\n\t}\n\tfor i, name := range IndexGenerationFiles {\n\t\tf := d.Files[i]\n\t\tif f.Name != name {\n\t\t\treturn fmt.Errorf(\"file %d is %q, expected %q\", i, f.Name, name)\n\t\t}\n\t\tif !strings.HasPrefix(f.SHA256, \"sha256:\") || len(f.SHA256) != len(\"sha256:\")+64 {\n\t\t\treturn fmt.Errorf(\"%s has no SHA-256 digest\", name)\n\t\t}\n\t}\n\tif !indexGenerationIDRE.MatchString(d.GenerationID) {\n\t\treturn fmt.Errorf(\"generation_id %q is malformed\", d.GenerationID)\n\t}\n\tidentity, err := json.Marshal(struct {\n\t\tFiles  []IndexGenerationFile `json:\"files\"`\n\t\tInputs map[string]string     `json:\"inputs\"`\n\t}{d.Files, nilToEmpty(d.Inputs)})\n\tif err != nil {\n\t\treturn err\n\t}\n\tsum := sha256.Sum256(identity)\n\tif want := indexGenerationPrefix + hex.EncodeToString(sum[:8]); want != d.GenerationID {\n\t\treturn fmt.Errorf(\"generation_id %s does not match the descriptor content (%s)\", d.GenerationID, want)\n\t}\n\treturn nil\n}\n\nfunc nilToEmpty(m map[string]string) map[string]string {\n\tif m == nil {\n\t\treturn map[string]string{}\n\t}\n\treturn m\n}\n\n// readDescriptor reads the commit record. exists is false when there is none.\nfunc readIndexDescriptor(files Files, root string) (desc IndexGenerationDescriptor, raw []byte, exists bool, err error) {\n\traw, readErr := files.ReadFile(filepath.Join(indexDir(root), indexDescriptorName))\n\tif errors.Is(readErr, os.ErrNotExist) {\n\t\treturn IndexGenerationDescriptor{}, nil, false, nil\n\t}\n\tif readErr != nil {\n\t\treturn IndexGenerationDescriptor{}, nil, true, fmt.Errorf(\"the generation descriptor cannot be read: %w\", readErr)\n\t}\n\tdec := json.NewDecoder(strings.NewReader(string(raw)))\n\tdec.DisallowUnknownFields()\n\tif err := dec.Decode(&desc); err != nil {\n\t\treturn IndexGenerationDescriptor{}, raw, true, fmt.Errorf(\"the generation descriptor is not valid JSON of the expected shape: %w\", err)\n\t}\n\tif _, err := dec.Token(); err != io.EOF {\n\t\treturn IndexGenerationDescriptor{}, raw, true, errors.New(\"the generation descriptor has data after its value\")\n\t}\n\tif err := desc.validate(); err != nil {\n\t\treturn IndexGenerationDescriptor{}, raw, true, fmt.Errorf(\"the generation descriptor is invalid: %w\", err)\n\t}\n\treturn desc, raw, true, nil\n}\n\n// readGenerationFile returns the bytes of one file of the generation that match\n// its digest: the immutable copy when it exists and matches, the legacy name\n// when that matches. When neither matches it returns the bytes it found, so the\n// caller can say what differed, and ok false.\nfunc readGenerationFile(files Files, root, id, name, want string) (data []byte, ok bool, err error) {\n\tvar lastErr error\n\tfor _, path := range []string{filepath.Join(indexGenerationDir(root, id), name), filepath.Join(indexDir(root), name)} {\n\t\traw, readErr := files.ReadFile(path)\n\t\tif readErr != nil {\n\t\t\tif lastErr == nil || !errors.Is(readErr, os.ErrNotExist) {\n\t\t\t\tlastErr = readErr\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif sha256Prefixed(raw) == want {\n\t\t\treturn raw, true, nil\n\t\t}\n\t\tdata, lastErr = raw, nil\n\t}\n\treturn data, false, lastErr\n}\n\n// ReadIndexGeneration fixes the generation named by the descriptor and returns\n// every file of it, each checked against the descriptor. It starts again if the\n// descriptor is replaced while it reads, a bounded number of times.\nfunc (s Store) ReadIndexGeneration() IndexGenerationView {\n\tfor attempt := 0; attempt < indexReadAttempts; attempt++ {\n\t\tdesc, raw, exists, err := readIndexDescriptor(s.fsys(), s.Root)\n\t\tif err != nil {\n\t\t\treturn IndexGenerationView{Status: IndexGenerationUnavailable, Reason: err.Error()}\n\t\t}\n\t\tif !exists {\n\t\t\tif indexPendingIn(s.fsys(), s.Root) {\n\t\t\t\treturn IndexGenerationView{Status: IndexGenerationUnavailable, Reason: \"a first index generation was being published and did not commit: the index files may mix two runs; run `pose index`\"}\n\t\t\t}\n\t\t\treturn IndexGenerationView{Status: IndexGenerationLegacy, Reason: \"no generation descriptor: the indexes were not published as a set\"}\n\t\t}\n\t\tif IndexReadFault != nil {\n\t\t\tIndexReadFault(\"after-descriptor\")\n\t\t}\n\t\tfiles := map[string][]byte{}\n\t\tdiverged := []string{}\n\t\tvar problem string\n\t\tfor _, f := range desc.Files {\n\t\t\tdata, matched, readErr := readGenerationFile(s.fsys(), s.Root, desc.GenerationID, f.Name, f.SHA256)\n\t\t\tif readErr != nil {\n\t\t\t\tproblem = fmt.Sprintf(\"%s of generation %s cannot be read: %v\", f.Name, desc.GenerationID, readErr)\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif !matched {\n\t\t\t\tproblem = fmt.Sprintf(\"%s does not match generation %s (descriptor %s, file %s)\", f.Name, desc.GenerationID, f.SHA256, sha256Prefixed(data))\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tfiles[f.Name] = data\n\t\t\tif legacy, legacyErr := s.fsys().ReadFile(filepath.Join(indexDir(s.Root), f.Name)); legacyErr != nil || sha256Prefixed(legacy) != f.SHA256 {\n\t\t\t\tdiverged = append(diverged, f.Name)\n\t\t\t}\n\t\t}\n\t\tagain, againRaw, _, againErr := readIndexDescriptor(s.fsys(), s.Root)\n\t\tif againErr == nil && again.GenerationID == desc.GenerationID && string(againRaw) == string(raw) {\n\t\t\tif problem != \"\" {\n\t\t\t\treturn IndexGenerationView{Status: IndexGenerationUnavailable, Reason: problem, Descriptor: desc}\n\t\t\t}\n\t\t\treturn IndexGenerationView{Status: IndexGenerationCurrent, Descriptor: desc, Files: files, Diverged: diverged, DescriptorBytes: raw}\n\t\t}\n\t}\n\treturn IndexGenerationView{Status: IndexGenerationUnavailable, Reason: \"the generation descriptor kept changing while it was read\"}\n}\n","numLines":260,"startLine":140,"totalLines":1133}},"tool_result_meta":[{"id":"toolu_01UZWgBjZqu8sntvmgT6M1Qk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
