fault:\n\t\treturn \"[i]\"\n\t}\n}\n\n// SGR codes stay in the 4-bit range: CI log viewers and plain terminals render\n// them, and 256-colour would buy nothing a gate needs.\nconst (\n\tsgrReset  = \"\\x1b[0m\"\n\tsgrRed    = \"\\x1b[31m\"\n\tsgrGreen  = \"\\x1b[32m\"\n\tsgrYellow = \"\\x1b[33m\"\n\tsgrBlue   = \"\\x1b[34m\"\n\tsgrCyan   = \"\\x1b[36m\"","numLines":40,"startLine":100,"totalLines":188}},"tool_result_meta":[{"id":"toolu_0186cSddJVBehZXrP7JroxrB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
