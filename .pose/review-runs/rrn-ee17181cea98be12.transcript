without their descriptor leaves the set exactly\n// so, and every review closeout after it is unknown (spec\n// pose-commit-gate-refuses-index-without-descriptor).\nfunc (checker *nativeChecker) checkIndexGeneration() {\n\tview := pose.Store{Root: checker.root, FS: checker.fsys()}.ReadIndexGeneration()\n\tswitch {\n\tcase view.Status == pose.IndexGenerationUnavailable:\n\t\tremedy := checker.message(\"; run `pose index`\", \"; rode `pose index`\")\n\t\tif strings.Contains(view.Reason, \"pose index\") {\n\t\t\t// Some reasons already name the remedy.\n\t\t\tremedy = \"\"\n\t\t}\n\t\tchecker.failOrWarn(checker.message(\"index set unavailable: \", \"conjunto de índices indisponível: \") + view.Reason + remedy)\n\tcase view.Status == pose.IndexGenerationCurrent && len(view.Diverged) > 0:\n\t\tchecker.failOrWarn(checker.message(\"index files differ from generation \", \"arquivos de índice diferem da geração \") + view.Descriptor.GenerationID + \": \" + strings.Join(view.Diverged, \", \") + checker.message(\"; run `pose index`\", \"; rode `pose index`\"))\n\t}\n}\n\nfunc (checker *nativeChecker) checkValidationMatrix() {\n\tpath := filepath.Join(checker.root, \".pose\", \"indexes\", \"validation-matrix.json\")\n\traw, err := checker.fsys().ReadFile(path)\n\tif err != nil {\n\t\treturn\n\t}\n\tvar document map[string]any\n\tif err := json.Unmarshal(raw, &document); err != nil {\n\t\tchecker.failOrWarn(checker.message(\"validation-matrix.json: invalid JSON: \", \"validation-matrix.json: JSON inválido: \") + err.Error())\n\t\treturn","numLines":70,"startLine":440,"totalLines":1373}},"tool_result_meta":[{"id":"toolu_01AtBWCHwAErAHas9pfEdYst","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
