e-mcp/internal/pose/review_closeout.go:2816:\t\t\tif decision := review.CloseoutReview; decision != nil && receipt == nil && receiptErr == nil {\npose-mcp/internal/pose/review_closeout.go:2824:\t\t\tif review.CloseoutReview == nil && receipt == nil && scope.Kind == \"roadmap\" && state.LifecycleDone && review.Required && !review.Approved {\npose-mcp/internal/pose/review_closeout.go:2839:\tif !review.Required && review.CloseoutReview == nil {\npose-mcp/internal/pose/review_plan.go:134:\t// CloseoutReview is the closeout-review@1 decision for a milestone or a\npose-mcp/internal/pose/review_plan.go:137:\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\npose-mcp/internal/pose/review_plan.go:408:\t\tdecision, _, gateErr := s.closeoutReviewGate(ref, policy)\npose-mcp/internal/pose/review_plan.go:412:\t\tplan.CloseoutReview = decision\npose-mcp/internal/pose/review_plan.go:549:func (s Store) reviewScopeSpecs(scope ScopeRef) ([]Spec, error) {\npose-mcp/internal/pose/roadmaps.go:174:// declaredUnreviewed returns the reason a roadmap gives for a milestone standing with no\npose-mcp/internal/pose/roadmaps.go:176:func (s Store) declaredUnreviewed(scope ScopeRef) string {\npose-mcp/internal/pose/roadmaps.go:542:\treturn policy.CloseoutReviewAdopted(), err\n","exit_code":0,"status":"completed"}}
