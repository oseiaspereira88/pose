.go:1295:func TestCloseoutReviewPolicyRoundNine(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:1296:\tt.Run(\"an aggregate's own approval is ready to close until its receipt\", func(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:1316:\tt.Run(\"an exempt milestone with a receipt falls with its member\", func(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:1332:\tt.Run(\"planning and lifecycle read a transferred member at its destination\", func(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:1358:func TestCloseoutReviewPolicyRoundTen(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:1359:\tt.Run(\"an exempt milestone without review bundles closes by its receipt\", func(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:1394:\tt.Run(\"a roadmap's own approval does not stand over a fallen exempt milestone\", func(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:1415:\tt.Run(\"start warnings name an approved but unclosed predecessor\", func(t *testing.T) {\n","exit_code":2,"status":"failed"}}
