{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '226,278p' pose-mcp/internal/pose/closeout_review_policy_test.go\"","aggregated_output":"func TestCloseoutReviewPolicyAssociations(t *testing.T) {\n\tcases := []struct {\n\t\tname, roadmapFrontmatter, roadmapBody, adr string\n\t\tadrs                                       int\n\t\tknown                                      bool\n\t}{\n\t\t{\"forward metadata\", \"adrs: [adr:decision.md]\\n\", \"\", \"# ADR\\n\", 1, true},\n\t\t{\"backward metadata\", \"\", \"\", \"---\\nroadmaps: [roadmap:pair]\\n---\\n# ADR\\n\", 1, true},\n\t\t{\"qualified backward metadata\", \"\", \"\", \"---\\nroadmaps: [xref:proj.fixture/roadmap:pair]\\n---\\n# ADR\\n\", 1, true},\n\t\t{\"backward metadata for another project\", \"\", \"\", \"---\\nroadmaps: [xref:proj.other/roadmap:pair]\\n---\\n# ADR\\n\", 0, true},\n\t\t{\"inline link from the roadmap\", \"\", \"See [the ADR](../adr/decision.md#context).\\n\", \"# ADR\\n\", 1, true},\n\t\t{\"angle bracket link\", \"\", \"See [the ADR](<../adr/decision.md>).\\n\", \"# ADR\\n\", 1, true},\n\t\t{\"reference-style link\", \"\", \"See [the ADR][d].\\n\\n[d]: ../adr/decision.md \\\"title\\\"\\n\", \"# ADR\\n\", 1, true},\n\t\t{\"link back from the ADR\", \"\", \"\", \"Governs [the roadmap](../roadmaps/pair.md).\\n\", 1, true},\n\t\t{\"both directions count once\", \"adrs: [adr:decision.md]\\n\", \"\", \"---\\nroadmaps: [roadmap:pair]\\n---\\n\", 1, true},\n\t\t{\"word in prose\", \"\", \"This follows decision.md and the decision ADR.\\n\", \"Mentions pair and roadmap pair.\\n\", 0, true},\n\t\t{\"external URL\", \"\", \"See [x](https://example.invalid/.pose/adr/decision.md).\\n\", \"# ADR\\n\", 0, true},\n\t\t{\"traversal declaration\", \"adrs: [adr:../decision.md]\\n\", \"\", \"# ADR\\n\", 0, false},\n\t\t{\"missing declared ADR\", \"adrs: [adr:absent.md]\\n\", \"\", \"# ADR\\n\", 0, false},\n\t\t{\"link to a missing ADR\", \"\", \"See [x](../adr/absent.md).\\n\", \"# ADR\\n\", 0, false},\n\t\t{\"malformed declaration\", \"adrs: adr:decision.md\\n\", \"\", \"# ADR\\n\", 0, false},\n\t\t{\"malformed backward declaration\", \"\", \"\", \"---\\nroadmaps: [spec:pair]\\n---\\n\", 0, false},\n\t\t{\"forward association does not hide a malformed ADR\", \"adrs: [adr:decision.md]\\n\", \"\", \"---\\nroadmaps: [spec:pair]\\n---\\n\", 1, false},\n\t}\n\tfor _, tc := range cases {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\troot, s := closeoutMembersFixture(t, \"when-justified\", \"when-justified\")\n\t\t\tos.WriteFile(filepath.Join(root, \".pose/roadmaps/pair.md\"), []byte(\"---\\nslug: pair\\nstatus: active\\n\"+tc.roadmapFrontmatter+\"---\\n\\n\"+tc.roadmapBody+\"\\n## Milestone: m1\\n- specs: d\\n\\n## Milestone: m2\\n- specs: e\\n\"), 0o644)\n\t\t\tos.WriteFile(filepath.Join(root, \".pose/adr/decision.md\"), []byte(tc.adr), 0o644)\n\t\t\td := evaluate(t, s, \"roadmap:pair\")\n\t\t\tif len(d.ADRs) != tc.adrs || d.Known != tc.known {\n\t\t\t\tt.Fatalf(\"adrs=%v known=%v diagnostics=%v\", d.ADRs, d.Known, d.Diagnostics)\n\t\t\t}\n\t\t\tif d.Required != (tc.adrs > 0 || !tc.known) {\n\t\t\t\tt.Fatalf(\"required=%v for %+v\", d.Required, d)\n\t\t\t}\n\t\t})\n\t}\n\tt.Run(\"symlinked ADR is not an association\", func(t *testing.T) {\n\t\troot, s := closeoutMembersFixture(t, \"when-justified\", \"when-justified\")\n\t\toutside := filepath.Join(t.TempDir(), \"outside.md\")\n\t\tos.WriteFile(outside, []byte(\"# outside\\n\"), 0o644)\n\t\tif err := os.Symlink(outside, filepath.Join(root, \".pose/adr/linked.md\")); err != nil {\n\t\t\tt.Skip(err)\n\t\t}\n\t\teditFile(t, filepath.Join(root, \".pose/roadmaps/pair.md\"), \"status: active\\n\", \"status: active\\nadrs: [adr:linked.md]\\n\")\n\t\tif d := evaluate(t, s, \"roadmap:pair\"); d.Known || len(d.ADRs) != 0 {\n\t\t\tt.Fatalf(\"%+v\", d)\n\t\t}\n\t})\n\tt.Run(\"the shared runtime roadmap link form survives\", func(t *testing.T) {\n\t\troot, s := closeoutMembersFixture(t, \"when-justified\", \"when-justified\")\n\t\tos.WriteFile(filepath.Join(root, \".pose/adr/2026-10-14-shared-domain.md\"), []byte(\"# ADR\\n\"), 0o644)\n","exit_code":0,"status":"completed"}}
