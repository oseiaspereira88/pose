{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1900,2105p' pose-mcp/internal/cli/review_closeout.go\"","aggregated_output":"}\n\nfunc cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref string, guard func() error, stdout, stderr io.Writer, transitioned func(unsynced error)) int {\n\t// The gates below judge the artifact as it is now; the transition is\n\t// published only over those same bytes (spec\n\t// pose-writer-coordination-and-atomic-publication R4).\n\tjudged := closeTargetDigest(root, store, ref)\n\tstate, err := cliCloseoutStateForStore(store, ref)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\treturn 1\n\t}\n\t// Repeating close on an already-done spec is a readonly terminal check,\n\t// bounded by the same historical contract as closeout-check and the plan.\n\tif scope, parseErr := posemodel.ParseScopeRef(ref); parseErr == nil && scope.Kind == \"spec\" && state.LifecycleDone {\n\t\tif !state.Terminal {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n\t\t\treturn 1\n\t\t}\n\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; applicable terminal verifier passed; no transition executed\")\n\t\treturn 0\n\t}\n\t// Governed effects (spec pose-governed-effect-enforcement): this is the\n\t// write point of the closeout transition, so an adopted, unsatisfied\n\t// action request restricting closeout refuses here with its typed cause,\n\t// whatever else the scope's review says.\n\tgoverned := []string{}\n\tfor _, d := range state.Diagnostics {\n\t\tif d.Code == \"action-request-pending\" {\n\t\t\tgoverned = append(governed, d.Message)\n\t\t}\n\t}\n\t// A current adjudication that says a question does not hold refuses the\n\t// closeout (spec pose-delegated-verdict-destinations R1).\n\tadjudicated := []string{}\n\tfor _, d := range state.Diagnostics {\n\t\tif d.Code == posemodel.AdjudicationDoesNotHoldCode {\n\t\t\tadjudicated = append(adjudicated, d.Message)\n\t\t}\n\t}\n\tif len(adjudicated) > 0 {\n\t\tout := render(stdout, stderr)\n\t\tfor _, message := range adjudicated {\n\t\t\tout.Field(\"close.refused.adjudication\", message)\n\t\t}\n\t\tout.Failure(fmt.Sprintf(\"pose close: %d adjudicated question(s) of %s do not hold\", len(adjudicated), ref))\n\t\treturn 1\n\t}\n\tif len(governed) > 0 {\n\t\tout := render(stdout, stderr)\n\t\tfor _, message := range governed {\n\t\t\tout.Field(\"close.refused.action-request-pending\", message)\n\t\t}\n\t\tout.Failure(fmt.Sprintf(\"pose close: %d action request(s) restrict closeout of %s\", len(governed), ref))\n\t\treturn 1\n\t}\n\tscope, _ := posemodel.ParseScopeRef(ref)\n\t// Under an adopted closeout review policy (spec\n\t// pose-closeout-review-policy-by-cost-benefit) the close of a milestone or a\n\t// roadmap publishes a receipt. A receipt already there makes the close a\n\t// read-only verification; a scope the evaluator cannot decide is refused.\n\treceiptClose, code := closeoutReceiptPreflight(store, ref, scope, &state, stdout, stderr)\n\tif code >= 0 {\n\t\treturn code\n\t}\n\tif !closeReviewSatisfied(state) || len(state.Children) > 0 && hasOpenChild(state.Children) {\n\t\tfmt.Fprintf(stderr, \"pose close: scope is not eligible; next action: %s\\n\", state.NextAction)\n\t\treturn 1\n\t}\n\tif scope.Kind == \"milestone\" {\n\t\tgate, err := roadmapGate(root, scope.Roadmap, scope.Milestone)\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tif blockers := uniqueCLIStrings(gate.blockers); len(blockers) > 0 {\n\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + strings.Join(blockers, \"; \"))\n\t\t\treturn 1\n\t\t}\n\t\tlabel := \"Milestone closeout verified\"\n\t\tif receiptClose != nil {\n\t\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, guard, stderr)\n\t\t\tif code != 0 {\n\t\t\t\treturn code\n\t\t\t}\n\t\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, judgedState, stdout, stderr); code != 0 {\n\t\t\t\treturn code\n\t\t\t}\n\t\t\tlabel = \"Closed\"\n\t\t}\n\t\tfmt.Fprintf(stdout, \"%s: %s\\n\", label, ref)\n\t\trenderCloseNext(render(stdout, stderr), nextCloses(store, ref))\n\t\treturn 0\n\t}\n\tvar path string\n\tif scope.Kind == \"spec\" {\n\t\tsp, err := store.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tif policy, err := posemodel.LoadArtifactPolicyIn(store.FS, root); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t} else if policy.Enabled && sp.CreatedAt >= policy.AdoptedAt {\n\t\t\tclaims, found, err := posemodel.ParseArtifactClaims(*sp, policy)\n\t\t\tif err != nil || !found || len(claims) == 0 {\n\t\t\t\tfmt.Fprintf(stderr, \"pose close: artifact declaration gate failed: %v\\n\", err)\n\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t\tif policy, err := posemodel.LoadDeliveryPolicyIn(store.FS, root); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t} else if policy.Enabled && sp.CreatedAt >= policy.AdoptedAt {\n\t\t\tif graph, graphErr := buildCurrentDeliveryGraphIn(store.FS, root); graphErr != nil {\n\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: delivery assurance gate failed: %s\", graphErr))\n\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\treturn 1\n\t\t\t} else if blockers := deliverySpecBlockersFromGraph(graph, sp.Slug); len(blockers) > 0 {\n\t\t\t\tfmt.Fprintf(stderr, \"pose close: delivery assurance gate failed: %s\\n\", strings.Join(blockers, \"; \"))\n\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t\tif _, findings, err := store.InspectAmendmentHistory(*sp); err != nil || len(findings) > 0 {\n\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: amendment history gate failed: %v %s\", err, strings.Join(findings, \"; \")))\n\t\t\treturn 1\n\t\t}\n\t\t// The exit gate of a spec is its requirement trace: closing marks it\n\t\t// done, and a done spec whose promises point at no evidence fails\n\t\t// lint. Refusing here keeps `pose close` from producing what the\n\t\t// next lint rejects (spec pose-quickstart-real-lifecycle).\n\t\tif raw, err := store.FS.ReadFile(sp.Path); err == nil {\n\t\t\tif blockers := posemodel.RequirementTraceCloseoutBlockers(string(raw)); len(blockers) > 0 {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate failed: \" + strings.Join(blockers, \"; \") + \" — declare each under `### Requirement trace`, e.g. `- R1 [satisfied] test:<TestName>`, or [waived: <reason>] / [withdrawn: <reason>]\")\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\t// A test: ref must name a test that exists, or the trace points a\n\t\t\t// promise at nothing (spec pose-trace-test-refs-resolve).\n\t\t\tcatalog, catalogErr := posemodel.LoadTestCatalogChecked(root)\n\t\t\tif catalogErr != nil {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate incomplete: \" + catalogErr.Error())\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\tif unresolved := posemodel.UnresolvedTestRefs(posemodel.ParseRequirementTrace(string(raw)), catalog); len(unresolved) > 0 {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate failed: \" + strings.Join(unresolved, \"; \") + \" names no test in this repository or its submodules — cite the test function, subtest, test title or test file\")\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t\tpath = sp.Path\n\t} else {\n\t\tvar gateOut, gateErr bytes.Buffer\n\t\tif code := cmdRoadmapCheck(root, []string{scope.Slug, \"--strict\"}, &gateOut, &gateErr); code != 0 {\n\t\t\tfmt.Fprintf(stderr, \"pose close: roadmap gate failed: %s%s\", gateErr.String(), gateOut.String())\n\t\t\treturn 1\n\t\t}\n\t\tpath = filepath.Join(root, \".pose\", \"roadmaps\", scope.Slug+\".md\")\n\t}\n\tif closeGatesJudged != nil {\n\t\tcloseGatesJudged()\n\t}\n\t// Start, close and transfer of a spec share its lifecycle lock (R3).\n\tif scope.Kind == \"spec\" {\n\t\tunlock, err := posemodel.LockSpecLifecycle(root, scope.Slug, \"close.transition\")\n\t\tif err != nil {\n\t\t\tvar held *posemodel.StartLockError\n\t\t\tif errors.As(err, &held) {\n\t\t\t\trenderStartLock(render(stdout, stderr), scope.Slug, held)\n\t\t\t}\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tdefer unlock()\n\t}\n\t// The authorization is judged again inside the protected region: a\n\t// review that stopped being approved, or an action request that now\n\t// restricts closeout, while the gates ran does not govern this\n\t// publication (spec pose-writer-coordination-and-atomic-publication R4).\n\tif current, err := cliCloseoutStateForStore(store, ref); err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\treturn 1\n\t} else if !(closeReviewSatisfied(current) || receiptClose != nil && !receiptClose.Required) || hasActionRequestPending(current.Diagnostics) || hasDiagnostic(current.Diagnostics, posemodel.AdjudicationDoesNotHoldCode) {\n\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout authorization changed while its gates ran; next action: \" + current.NextAction)\n\t\treturn 1\n\t}\n\tif guard != nil {\n\t\tif err := guard(); err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t}\n\tif scope.Kind == \"spec\" {\n\t\tsp, err := store.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tif _, findings, err := store.InspectAmendmentHistory(*sp); err != nil || len(findings) > 0 {\n\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: amendment history gate failed: %v %s\", err, strings.Join(findings, \"; \")))\n\t\t\treturn 1\n\t\t}\n\t}\n\tvar receiptState posemodel.CloseoutState\n\tif receiptClose != nil {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,100p' pose-mcp/internal/mcpserver/closeout_review_policy_test.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,100p' pose-mcp/internal/mcpserver/closeout_review_policy_test.go\"","aggregated_output":"package mcpserver\n\nimport (\n\t\"encoding/json\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n\n\t\"github.com/harne8/pose-mcp/internal/pose\"\n)\n\n// MCP parity of spec pose-closeout-review-policy-by-cost-benefit: the MCP\n// closeout state renders the same closeout-review@1 decision as the store the\n// CLI reads, and reading writes nothing.\nfunc TestCloseoutReviewPolicyParity(t *testing.T) {\n\troot := t.TempDir()\n\twrite := func(rel, content string) {\n\t\tt.Helper()\n\t\tpath := filepath.Join(root, rel)\n\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\twrite(\".pose/project.json\", `{\"schema_version\":1,\"project_id\":\"proj.fixture\",\"name\":\"fixture\"}`)\n\twrite(\".pose/policy/review.json\", `{\"schema_version\":5,\"enabled\":true,\"profiles\":{\"spec\":\"spec-closeout@1\",\"milestone\":\"milestone-integration@1\",\"roadmap\":\"roadmap-outcome@1\"},\"milestone_review_required\":\"when-justified\",\"roadmap_review_required\":\"when-justified\"}`)\n\twrite(\".pose/review-profiles/milestone-integration.json\", `{\"schema_version\":1,\"id\":\"milestone-integration\",\"version\":1,\"scope\":\"milestone\",\"criteria\":[{\"id\":\"integration\",\"description\":\"The milestone is integrated.\",\"kind\":\"judgment\",\"evidence_classes\":[\"integration\"]}]}`)\n\twrite(\".pose/review-profiles/roadmap-outcome.json\", `{\"schema_version\":1,\"id\":\"roadmap-outcome\",\"version\":1,\"scope\":\"roadmap\",\"criteria\":[{\"id\":\"outcome\",\"description\":\"The roadmap outcome is verified.\",\"kind\":\"judgment\",\"evidence_classes\":[\"integration\"]}]}`)\n\twrite(\".pose/review-profiles/spec-closeout.json\", `{\"schema_version\":1,\"id\":\"spec-closeout\",\"version\":1,\"scope\":\"spec\",\"criteria\":[{\"id\":\"correctness\",\"description\":\"The spec is correct.\",\"kind\":\"judgment\",\"evidence_classes\":[\"integration\"]}]}`)\n\tfor _, slug := range []string{\"a\", \"b\", \"c\"} {\n\t\twrite(\".pose/specs/\"+slug+\".md\", \"---\\nslug: \"+slug+\"\\nstatus: done\\ncreated_at: 2026-11-01\\n---\\n\\n# Spec: \"+slug+\"\\n\")\n\t}\n\twrite(\".pose/roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\n---\\n\\n## Milestone: small\\n- specs: a, spec:a\\n\\n## Milestone: large\\n- specs: a, b, c\\n\")\n\tstore := pose.Store{Root: root}\n\tserver := New(store)\n\tts := httptest.NewServer(server.Handler(\"\", \"\"))\n\tt.Cleanup(ts.Close)\n\tfor _, ref := range []string{\"milestone:program/small\", \"milestone:program/large\", \"roadmap:program\"} {\n\t\tt.Run(ref, func(t *testing.T) {\n\t\t\twant, err := store.EvaluateCloseoutReview(ref)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\t_, response := post(t, ts, `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_closeout_state\",\"arguments\":{\"scope\":\"`+ref+`\"}}}`)\n\t\t\tif response.Error != nil || response.Result[\"isError\"] == true {\n\t\t\t\tt.Fatalf(\"error=%+v result=%v\", response.Error, response.Result)\n\t\t\t}\n\t\t\tstructured, _ := response.Result[\"structuredContent\"].(map[string]any)\n\t\t\treview, _ := structured[\"review\"].(map[string]any)\n\t\t\traw, _ := json.Marshal(review[\"closeout_review\"])\n\t\t\tvar got pose.CloseoutReviewDecision\n\t\t\tif err := json.Unmarshal(raw, &got); err != nil {\n\t\t\t\tt.Fatalf(\"no decision in %v\", review)\n\t\t\t}\n\t\t\tgotJSON, _ := json.Marshal(got)\n\t\t\twantJSON, _ := json.Marshal(want)\n\t\t\tif string(gotJSON) != string(wantJSON) {\n\t\t\t\tt.Fatalf(\"MCP decision %+v differs from the store's %+v\", got, want)\n\t\t\t}\n\t\t\tif review[\"required\"] != want.Required {\n\t\t\t\tt.Fatalf(\"required %v, want %v\", review[\"required\"], want.Required)\n\t\t\t}\n\t\t\tif structured[\"terminal\"] == true {\n\t\t\t\tt.Fatalf(\"an unclosed scope reads as terminal over MCP: %v\", structured)\n\t\t\t}\n\t\t})\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".pose\", \"review-closeouts\")); !os.IsNotExist(err) {\n\t\tt.Fatalf(\"an MCP read wrote closeout records: %v\", err)\n\t}\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,90p' pose-mcp/internal/cli/testdata/adversarial/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,90p' pose-mcp/internal/cli/testdata/adversarial/README.md\"","aggregated_output":"# Adversarial corpus\n\nSpec: `pose-mechanization-adversarial-corpus`. Test: `adversarial_corpus_test.go`.\n\nEvery gate POSE adds against mechanical compliance can itself be satisfied\nmechanically. Each row is the cheapest formal satisfaction of one gate. An\n`enforced` case fails the build when the shortcut works again; a `known-gap`\ncase fails the build when the gap closes, so it cannot close or reopen\nsilently; a `planned` case belongs to a spec not yet delivered and gains code\nbefore that spec closes; a `delegated` case is enforced by a test in another\npackage, named in the row, whose existence the corpus checks.\n\nThis corpus belongs to developing POSE's governance. It adds no checklist to an\nadopting project's features.\n\n| Case | Status | Shortcut it refuses | Owner |\n|---|---|---|---|\n| `human-label-without-confirmation` | enforced | An agent writes and applies a review under `human:<name>`; the record reads as a human review | pose-review-attribution-roles |\n| `declared-independent-prefix` | enforced | `agent:independent-*` under declared assurance reads as authenticated separation | pose-review-assurance-disclosure |\n| `confirmation-reused-for-edited-content` | enforced | A confirmation recorded for one set of conclusions is kept after they change | pose-review-attribution-roles |\n| `unknown-recorded-as-satisfied` | enforced | An obligation the engine could not observe is reported as satisfied | pose-obligation-contract |\n| `legacy-blocker-gains-an-actor` | enforced | A blocker known only as text is given an invented recipient | pose-obligation-contract |\n| `blocked-counted-as-resolved` | enforced | Operational waiting counts as a resolved outcome in success metrics | pose-blocked-semantics-alignment |\n| `flat-specs-share-one-journal` | enforced | Two flat specs record amendments in one shared journal | pose-flat-spec-amendments |\n| `local-metadata-read-as-published` | enforced | A locally read version is presented as a proven publication | pose-public-claims-publication-provenance |\n| `invented-trace-test-ref` | known-gap | A requirement trace cites a test that does not exist and `lint-spec --strict` passes (follow-up 097 of pose-abm-design-basis) | pose-mechanization-adversarial-corpus |\n| `unavailable-producer-reads-as-empty` | enforced | A producer fails and Attention reports zero obligations as a complete answer | pose-obligation-projection |\n| `trivial-change-raises-a-request` | enforced | A trivial change or an already-authorized instruction produces an ActionRequest | pose-action-requests |\n| `declined-approval-satisfies` | enforced | A declined approval, or a cancellation without authority, releases a gate | pose-action-request-resolution |\n| `closeout-plan-fills-judgment` | enforced | The recoverable closeout plan answers a judgment criterion to finish | pose-recoverable-closeout-plan |\n| `ready-from-absent-blockers` | enforced | Absence of a known blocker is presented as proven independence | pose-phase-scoped-readiness |\n| `stale-preview-authorizes-apply` | enforced | A start previewed before a restricting request is applied after it | pose-governed-effect-enforcement |\n| `code-change-keeps-judgment` | enforced | The reviewed code changes and every criterion still reads as equivalent, so the old judgment is reused | pose-material-equivalence-reuse |\n| `minimal-surface-skips-trace` | enforced | A done spec declares the minimal surface to drop its requirement trace | pose-progressive-spec-surface |\n| `stale-assessment-reused` | enforced | The assessed component changes and the old assessment still reads as fresh | pose-adaptive-assessment-freshness |\n| `unpinned-premise-trigger-reads-current` | enforced | A premise trigger without a pin can never go stale and nothing says so | pose-assumption-validity-scope |\n| `calendar-ttl-as-premise-trigger` | enforced | An arbitrary expiry date is accepted as the material trigger of a premise | pose-assumption-validity-scope |\n| `unobserved-falsifier-reads-uncontradicted` | enforced | An unbound legacy index cannot prove that a falsifier check was never observed | pose-falsifier-reconsideration |\n| `parity-row-cites-an-unrelated-test` | known-gap | A launcher parity row names a real but unrelated `pose delegate` command and an existing test that does not exercise the capability, and the parity check passes; the check proves existence, review of the cited tests proves coverage | pose-delegation-parity-gate |\n| `imported-fragment-completes-a-replaced-command` | known-gap | A usage or error string assembles a removed command from a constant of another package of the module, which the active-document check reads as a gap; review of assembled messages is the defence | pose-delegation-parity-gate |\n| `cgo-preamble-text-reaches-usage` | known-gap | Operator text written as a C string in a cgo preamble reaches a usage surface; the Go reader sees a comment, not a string | pose-delegation-parity-gate |\n| `later-removal-hides-a-later-touch` | delegated | A later removal satisfies an earlier spec's claim because the history it is judged on omits that spec's change after the removal — change sets in ID order, a merge, root or type-change touch, a failed or shallow read, a recorded report too wide to read whole or a history directory that cannot be listed, a replace ref or graft (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_gaps_test.go:TestLaterRemovalReviewRoundTwo`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundFive`) | pose-delivery-later-removal |\n| `rename-read-as-removal` | delegated | A rename, or a path spelled as a pathspec, is taken for the declared deletion (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`) | pose-delivery-later-removal |\n| `recorded-commit-is-an-option` | delegated | A change set read from a recorded report names a Git option or a tag where a commit belongs (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`) | pose-delivery-later-removal |\n| `peer-removal-stands-for-a-member` | delegated | A review subject digests a removed path from a peer's accepted removal while another observing member — sorted later, sharing a commit, or reduced into the peer's set — has none, whatever action or rename it observed the path with (`pose/review_subject_later_removal_test.go:TestReviewSubjectReadsALaterRemovalFromItsWitness`, `pose/review_subject_later_removal_test.go:TestMilestoneSubjectRemovalHoldsForEveryMember`) | pose-review-subject-later-removal |\n| `retained-child-skips-its-verification` | delegated | A milestone seals over a done member whose own review verification no longer retains its approval — revoked federated trust, lost history, a later negative review (`pose/review_subject_later_removal_test.go:TestRetainedChildFollowsItsVerification`, `pose/review_subject_later_removal_test.go:TestMilestoneSealRetainsADoneChildsApprovedReview`) | pose-review-subject-later-removal |\n| `run-pattern-names-no-test` | delegated | A validation check's `-run` alternative names a test that no longer exists, or never did, and the check passes on Go's exit 0 — through `-run=`, a build-excluded or ignored file, a vendored or nested-module declaration, a benchmark or a name Go does not run (`cli/validation_matrix_patterns_test.go:TestDeadRunPatternGuardFollowsGoSelection`, `cli/validation_matrix_patterns_test.go:TestValidationMatrixRunPatternsNameExistingTests`); a non-plain pattern passes only when listed with its reason | pose-validation-matrix-dead-test-patterns |\n| `removal-witness-outlives-its-history` | delegated | A stale index keeps counting a removal after a later touch, through a merge, a rewritten history or a shallow clone that lost the touch (`pose/removal_witness_freshness_test.go:TestLaterTouchRefusesTheWitness`, `pose/removal_witness_freshness_test.go:TestShallowHistoryRefusesTheWitness`) | pose-removal-witness-freshness |\n| `parent-outlives-a-rejected-child` | delegated | A milestone or roadmap stays approved over a child's later rejection, through retention, a sealed cycle, a replaced approval or a forged `replaces` (`pose/review_approval_follows_children_test.go:TestParentApprovalFollowsAChildsRejection`, `pose/review_approval_follows_children_test.go:TestChildCycleEndsInARefusal`, `pose/review_approval_follows_children_test.go:TestForgedReplacementRetiresNothing`, `pose/review_approval_follows_children_test.go:TestLegacyCoordinatedMatchingFollowsLineage`) | pose-review-approval-follows-children |\n| `go-check-ran-no-test` | delegated | A `go test` check selects nothing and passes on Go's exit 0, through a flag spelling, a flag's value read as a flag, or a package without test files (`cli/validate_empty_go_checks_test.go:TestValidateRefusesAGoCheckThatRanNoTest`, `cli/validate_empty_go_checks_test.go:TestGoTestSelection`); a check outside the plain grammar passes unjudged, and a test printing a result line can still mislead it | pose-validate-refuses-empty-go-checks |\n| `request-opened-after-preview-transfers` | delegated | A request opened after a transfer preview is moved with the spec (`pose/spec_transfer_actions_test.go:TestTransferRefusesARequestOpenedAfterThePreview`) | pose-transfer-preserves-obligations |\n\n| `deleted-reservation-resets-quota` | delegated | Deleting a reservation and receipt makes a surviving run stop consuming quota | pose-delegated-review-attempt-ledger |\n| `witness-bundle-filter-hides-loss` | delegated | Editing a witness bundle makes scoped readers skip its corruption | pose-delegated-review-attempt-ledger |\n| `window-erases-rerun` | delegated | Moving a prior run outside the time window turns a rerun into a first attempt | pose-delegated-review-attempt-ledger |\n| `canned-executor-approval-proves-cognition` | delegated | A complete canned approval from a trusted local command is presented as proof of review cognition or a vendor receipt (`cli/delegated_review_capability_test.go:TestDelegatedReviewCapabilityCannedApprovalDisclosesItsLimits` guards disclosure; the engine cannot detect canned judgments) | pose-delegated-review-capability |\n| `oversized-writer-publishes-unreadable-run` | delegated | A writer reports completion for a run its bounded reader immediately refuses | pose-delegated-review-attempt-ledger |\n","exit_code":0,"status":"completed"}}
