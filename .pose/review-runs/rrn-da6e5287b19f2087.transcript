{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '3450,3630p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"// resolver, and refuses a scope already being verified: sealed children are\n// data, and a cycle among them must end in a named refusal (spec\n// pose-review-approval-follows-children R6).\nfunc (s Store) verifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tstate := s.reviewReuse\n\tkey := fmt.Sprintf(\"%s\\x00%t\\x00%s\", s.Root, s.FederatedResolver != nil, scope)\n\tif result, ok := state.children[key]; ok {\n\t\treturn result.verification, result.err\n\t}\n\tif state.verifying[key] {\n\t\treturn ReviewBundleVerification{}, fmt.Errorf(\"pose: the sealed children of %s form a cycle\", scope)\n\t}\n\tstate.verifying[key] = true\n\tdefer delete(state.verifying, key)\n\tif s.onReviewVerify != nil {\n\t\ts.onReviewVerify(scope)\n\t}\n\tverification, err := s.proportionalReviewVerification(scope)\n\tstate.children[key] = childVerificationResult{verification, err}\n\treturn verification, err\n}\n\n// proportionalReviewVerification is the verification of a scope, and of a milestone that\n// owes no review of its own: one made of a single closed, approved spec, or one a roadmap\n// declares. Every reader of an approval comes through here, so they give one answer (ADR\n// a-milestone-of-one-member-is-that-member). A negative review recorded on it stands.\nfunc (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerification, error) {\n\tverification, err := s.proportionalReviewVerificationOf(scope)\n\tif err != nil || !verification.Approved || verification.State != \"closed\" {\n\t\treturn verification, err\n\t}\n\t// Under an adopted closeout review policy an aggregate scope is closed\n\t// only by its explicit close: an approval, its own, inherited or an\n\t// exemption, leaves it ready to close until its receipt stands. A scope\n\t// closed before adoption keeps its sealed reading (review round 9, N31).\n\tref, parseErr := ParseScopeRef(scope)\n\tif parseErr != nil || ref.Kind != \"milestone\" && ref.Kind != \"roadmap\" {\n\t\treturn verification, nil\n\t}\n\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || !adopted || s.closeoutScopeHistorical(ref) || s.milestoneClosedBeforeAdoption(ref) || s.receiptStandsFor(scope) {\n\t\treturn verification, nil\n\t}\n\tverification.State = \"ready-to-close\"\n\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope + \" (`pose close \" + scope + \"` publishes its closeout receipt)\"\n\treturn verification, nil\n}\n\nfunc (s Store) proportionalReviewVerificationOf(scope string) (ReviewBundleVerification, error) {\n\town, err := s.computeReviewVerification(scope)\n\tif err != nil || own.Approved {\n\t\treturn own, err\n\t}\n\tref, parseErr := ParseScopeRef(scope)\n\tif parseErr != nil || (ref.Kind != \"milestone\" && ref.Kind != \"roadmap\") {\n\t\treturn own, nil\n\t}\n\tpolicy, err := s.GetReviewPolicy()\n\tif err != nil {\n\t\treturn own, nil\n\t}\n\tif s.milestoneReviewRefused(scope) {\n\t\treturn own, nil\n\t}\n\t// An adopted closeout review policy is the only rule for an open scope:\n\t// legacy inheritance and declared exemptions cannot weaken `always`, and\n\t// the policy's own exemption reads the same gate as reviewCheck. A roadmap\n\t// closed before adoption keeps the legacy reading below.\n\tadopted := policy.CloseoutReviewAdopted() && !s.closeoutScopeHistorical(ref)\n\tif adopted {\n\t\tdecision, exempt, gateErr := s.closeoutReviewGate(scope, policy)\n\t\tif gateErr != nil || decision == nil || !exempt || !decision.Known {\n\t\t\treturn own, nil\n\t\t}\n\t\tif s.FederatedResolver != nil {\n\t\t\tvar acceptance FederatedRoadmapAcceptanceReport\n\t\t\tvar err error\n\t\t\tif ref.Kind == \"milestone\" {\n\t\t\t\tacceptance, err = s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n\t\t\t} else {\n\t\t\t\tacceptance, err = s.FederatedRoadmapAcceptance(s.FederatedProjectID, ref.Slug, *s.FederatedResolver)\n\t\t\t}\n\t\t\tif err != nil || !acceptance.Ready {\n\t\t\t\treturn own, nil\n\t\t\t}\n\t\t}\n\t\t// The exemption satisfies the review, not the close: the scope is\n\t\t// closed only by its explicit close, whose receipt must stand, and a\n\t\t// roadmap only over closed milestones. The full terminal verifier\n\t\t// is closeout's (review round 8, N30).\n\t\tverification := ReviewBundleVerification{\n\t\t\tScope: scope, State: \"ready-to-close\", Fresh: true, Approved: true,\n\t\t\tNextAction:     \"apply the guarded lifecycle transition for \" + scope + \" (`pose close \" + scope + \"` publishes its closeout receipt)\",\n\t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n\t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n\t\t}\n\t\t// Each child must still stand, as an approved review requires of\n\t\t// its children: a milestone's local members by their review, a\n\t\t// roadmap's milestones by their own verification, which is closed\n\t\t// only once their receipt stands. Neither recurses into this scope\n\t\t// (review round 9, N32).\n\t\tchildren, childErr := s.reviewBundleChildRefs(ref)\n\t\tif childErr != nil {\n\t\t\tverification.Blockers = append(verification.Blockers, childErr.Error())\n\t\t}\n\t\tfor _, child := range children {\n\t\t\tstanding, err := s.verifyReviewBundle(child)\n\t\t\tswitch {\n\t\t\tcase err != nil:\n\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child+\" cannot be verified: \"+err.Error())\n\t\t\tcase standing.State != \"closed\" || !standing.Approved || !standing.Fresh:\n\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child+\" does not stand: \"+standing.State)\n\t\t\t}\n\t\t}\n\t\tif len(verification.Blockers) > 0 {\n\t\t\tverification.State, verification.Approved = \"needs-review\", false\n\t\t\tverification.NextAction = \"restore or close the children of \" + scope + \" first: \" + strings.Join(verification.Blockers, \"; \")\n\t\t}\n\t\tif len(verification.Blockers) == 0 && s.receiptStandsFor(scope) {\n\t\t\tverification.State, verification.NextAction = \"closed\", \"scope is closed by its closeout receipt\"\n\t\t}\n\t\treturn verification, nil\n\t}\n\t// A policy without bundles answers through its review attempts alone, and has no\n\t// bundle of the spec to stand on. An adopted exemption is projected above\n\t// whether bundles are enabled or not (review round 10, N34).\n\tif !policy.ReviewBundles {\n\t\treturn own, nil\n\t}\n\tif ref.Kind != \"milestone\" {\n\t\treturn own, nil\n\t}\n\t// Edges still bind: a milestone inherits a review, not the acceptance of what it\n\t// depends on, and revoked trust or an open predecessor leaves it where it was.\n\tif s.FederatedResolver != nil {\n\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n\t\tif err != nil || !acceptance.Ready {\n\t\t\treturn own, nil\n\t\t}\n\t}\n\tif member, ok := s.soleMemberOf(ref); ok {\n\t\tchild, err := s.verifyReviewBundle(\"spec:\" + member)\n\t\tif err == nil && child.State == \"closed\" && child.Fresh && child.Approved {\n\t\t\treturn ReviewBundleVerification{\n\t\t\t\tScope: scope, State: \"closed\", Bundle: child.Bundle, Attestation: child.Attestation, Fresh: true, Approved: true,\n\t\t\t\tNextAction: \"none\", Warnings: []string{\"the approval of \" + scope + \" is inherited from spec:\" + member + \", its only member\"},\n\t\t\t\tApprovalOrigin: \"inherited:spec:\" + member, inherited: true,\n\t\t\t}, nil\n\t\t}\n\t}\n\tif reason := s.declaredUnreviewed(ref); reason != \"\" {\n\t\treturn ReviewBundleVerification{\n\t\t\tScope: scope, State: \"closed\", Fresh: true, Approved: true, NextAction: \"none\",\n\t\t\tWarnings:       []string{scope + \" stands without a review, as its roadmap declares: \" + reason},\n\t\t\tApprovalOrigin: \"declared:roadmap:\" + ref.Roadmap, inherited: true,\n\t\t}, nil\n\t}\n\treturn own, nil\n}\n\n// milestoneReviewRefused reports a refusal recorded on the milestone itself, in a bundle\n// or in a legacy attempt.\nfunc (s Store) milestoneReviewRefused(scope string) bool {\n\tif bundle, _ := s.latestNegativeReview(scope); bundle != nil {\n\t\treturn true\n\t}\n\tattempts, err := s.ReadReviewAttempts(scope)\n\tif err != nil || !attempts.Coverage.CompleteFor(scope) {\n\t\treturn true\n\t}\n\tif len(attempts.Attempts) == 0 {\n\t\treturn false\n\t}\n\tlatest := attempts.Attempts[len(attempts.Attempts)-1]\n\treturn latest.Decision == \"rejected\" || latest.Decision == \"changes-requested\"\n}\n\nfunc (s Store) computeReviewVerification(scope string) (ReviewBundleVerification, error) {\n\tpolicy, err := s.GetReviewPolicy()\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_receipt.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_receipt.go'","aggregated_output":"package pose\n\n// Closeout receipts (spec pose-closeout-review-policy-by-cost-benefit R4, R7).\n// Under an adopted closeout review policy, the explicit `pose close` of a\n// milestone or a roadmap publishes a receipt: the terminal marker of that\n// close, with the evaluator's decision and the policy it was made under. A\n// receipt is written once and never reinterpreted: a later policy change does\n// not re-evaluate it, and a different or corrupt receipt is never overwritten.\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n)\n\nconst CloseoutReceiptSchemaVersion = 1\n\ntype CloseoutReceipt struct {\n\tSchemaVersion int    `json:\"schema_version\"`\n\tScope         string `json:\"scope\"`\n\tClosedAt      string `json:\"closed_at\"`\n\t// Review is the literal `required` or `not-required`.\n\tReview        string                 `json:\"review\"`\n\tDecision      CloseoutReviewDecision `json:\"decision\"`\n\tPolicyDigest  string                 `json:\"policy_digest\"`\n\tSubjectDigest string                 `json:\"subject_digest\"`\n\t// ExitGateDigest binds a milestone's exit gate as it was closed.\n\tExitGateDigest string `json:\"exit_gate_digest,omitempty\"`\n\t// ReviewBundle and ReviewAttestation name the verified review the close\n\t// stood on: required, or made by choice when not required.\n\tReviewBundle      string `json:\"review_bundle,omitempty\"`\n\tReviewAttestation string `json:\"review_attestation,omitempty\"`\n\tApprovalOrigin    string `json:\"approval_origin,omitempty\"`\n}\n\n// CloseoutReceiptPath is where the receipt of an aggregate scope lives.\nfunc (s Store) CloseoutReceiptPath(ref string) (string, error) {\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tbase := filepath.Join(s.Root, \".pose\", \"review-closeouts\")\n\tswitch scope.Kind {\n\tcase \"milestone\":\n\t\tif ValidateSlug(scope.Roadmap) != nil || !filepath.IsLocal(scope.Milestone) || filepath.Base(scope.Milestone) != scope.Milestone {\n\t\t\treturn \"\", fmt.Errorf(\"pose: invalid milestone scope %s\", ref)\n\t\t}\n\t\treturn filepath.Join(base, \"milestone\", scope.Roadmap, scope.Milestone+\".json\"), nil\n\tcase \"roadmap\":\n\t\tif ValidateSlug(scope.Slug) != nil {\n\t\t\treturn \"\", fmt.Errorf(\"pose: invalid roadmap scope %s\", ref)\n\t\t}\n\t\treturn filepath.Join(base, \"roadmap\", scope.Slug+\".json\"), nil\n\t}\n\treturn \"\", fmt.Errorf(\"pose: %s has no closeout receipt; only milestones and roadmaps do\", ref)\n}\n\n// ReadCloseoutReceipt returns the receipt of a scope, nil when there is none.\n// A receipt that cannot be read or does not validate is an error, never an\n// absence: it would otherwise reopen a closed scope or hide a corruption.\nfunc (s Store) ReadCloseoutReceipt(ref string) (*CloseoutReceipt, error) {\n\tpath, err := s.CloseoutReceiptPath(ref)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tinfo, err := s.fsys().Lstat(path)\n\tif os.IsNotExist(err) {\n\t\treturn nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\tif !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s is not a regular file of this project\", ref)\n\t}\n\traw, err := s.fsys().ReadFile(path)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\treceipt, err := parseCloseoutReceipt(raw)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\tif receipt.Scope != ref || receipt.Decision.Scope != ref {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt at %s names %s, not %s\", path, receipt.Scope, ref)\n\t}\n\treturn &receipt, nil\n}\n\nfunc parseCloseoutReceipt(raw []byte) (CloseoutReceipt, error) {\n\tvar receipt CloseoutReceipt\n\tif err := rejectDuplicateJSONKeysAndControls(raw); err != nil {\n\t\treturn receipt, err\n\t}\n\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n\tdecoder.DisallowUnknownFields()\n\tif err := decoder.Decode(&receipt); err != nil {\n\t\treturn receipt, err\n\t}\n\tif err := decoder.Decode(new(any)); err != io.EOF {\n\t\treturn receipt, errors.New(\"trailing content\")\n\t}\n\tif receipt.SchemaVersion != CloseoutReceiptSchemaVersion {\n\t\treturn receipt, fmt.Errorf(\"unsupported schema_version %d\", receipt.SchemaVersion)\n\t}\n\tif _, valid := reviewInstant(receipt.ClosedAt); !valid {\n\t\treturn receipt, fmt.Errorf(\"closed_at %q is not an instant\", receipt.ClosedAt)\n\t}\n\td := receipt.Decision\n\tif !d.Adopted || d.EvaluatorVersion != CloseoutReviewEvaluatorVersion || !validCloseoutReviewValue(d.PolicyValue) || d.Reason == \"\" {\n\t\treturn receipt, errors.New(\"decision is not one of \" + CloseoutReviewEvaluatorVersion)\n\t}\n\tif d.PolicyValue == CloseoutReviewNever && d.Required && d.Reason == \"\" || d.PolicyValue == CloseoutReviewAlways && !d.Required {\n\t\treturn receipt, fmt.Errorf(\"a %s decision cannot be required=%v\", d.PolicyValue, d.Required)\n\t}\n\tif receipt.Review != d.Review() {\n\t\treturn receipt, fmt.Errorf(\"review %q contradicts the recorded decision (%s)\", receipt.Review, d.Review())\n\t}\n\tif d.Required && receipt.ReviewBundle == \"\" && receipt.ApprovalOrigin == \"\" {\n\t\treturn receipt, errors.New(\"a required review names no verified review\")\n\t}\n\tif !d.Known {\n\t\treturn receipt, errors.New(\"a close cannot stand on unknown members or associations\")\n\t}\n\tif receipt.PolicyDigest == \"\" || receipt.SubjectDigest == \"\" {\n\t\treturn receipt, errors.New(\"policy_digest and subject_digest are required\")\n\t}\n\treturn receipt, nil\n}\n\n// NewCloseoutReceipt builds the receipt of a close from the evaluator's\n// decision and the verification it stood on. It writes nothing.\nfunc (s Store) NewCloseoutReceipt(ref string, decision CloseoutReviewDecision, verification ReviewEvaluation, subjectDigest string, now time.Time) (CloseoutReceipt, error) {\n\t_, raw, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn CloseoutReceipt{}, err\n\t}\n\t_, gate, _, err := s.closeoutSubject(ref)\n\tif err != nil {\n\t\treturn CloseoutReceipt{}, err\n\t}\n\treceipt := CloseoutReceipt{\n\t\tExitGateDigest: gate,\n\t\tSchemaVersion:  CloseoutReceiptSchemaVersion, Scope: ref, ClosedAt: now.UTC().Format(time.RFC3339),\n\t\tReview: decision.Review(), Decision: decision, PolicyDigest: \"sha256:\" + digestHex(raw), SubjectDigest: subjectDigest,\n\t\tReviewBundle: verification.BundleID, ReviewAttestation: verification.AttestationID,\n\t}\n\tif receipt.ReviewBundle == \"\" && verification.Current != nil {\n\t\treceipt.ApprovalOrigin = \"review:\" + verification.Current.ReviewID\n\t}\n\tif receipt.ReviewBundle == \"\" && receipt.ApprovalOrigin == \"\" {\n\t\treceipt.ApprovalOrigin = verification.ApprovalOrigin\n\t}\n\tif _, err := parseCloseoutReceipt(CanonicalJSON(receipt)); err != nil {\n\t\treturn CloseoutReceipt{}, fmt.Errorf(\"pose: the closeout receipt of %s would be refused: %w\", ref, err)\n\t}\n\treturn receipt, nil\n}\n\n// ErrCloseoutReceiptExists reports a receipt already published for the scope.\nvar ErrCloseoutReceiptExists = errors.New(\"pose: a closeout receipt already exists\")\n\n// PublishCloseoutReceipt publishes a receipt where none exists. It never\n// replaces one: an equal receipt is the caller's to verify, a different one\n// stays as it is.\nfunc (s Store) PublishCloseoutReceipt(receipt CloseoutReceipt) error {\n\tpath, err := s.CloseoutReceiptPath(receipt.Scope)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif existing, err := s.ReadCloseoutReceipt(receipt.Scope); err != nil {\n\t\treturn err\n\t} else if existing != nil {\n\t\treturn ErrCloseoutReceiptExists\n\t}\n\traw, err := json.MarshalIndent(receipt, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\terr = s.fsys().Publish(path, append(raw, '\\n'), 0o644, PublishDerived, PublishExpectation{Mode: ExpectAbsent})\n\tif errors.Is(err, ErrPublishConflict) {\n\t\treturn ErrCloseoutReceiptExists\n\t}\n\treturn err\n}\n\n// A roadmap's close publishes its status and then its receipt. Between the\n// two an intent stands, so a close interrupted there reads as incomplete,\n// never as a roadmap closed before adoption (spec\n// pose-closeout-review-policy-by-cost-benefit R4, R7).\nfunc (s Store) closeoutIntentPath(ref string) (string, error) {\n\tpath, err := s.CloseoutReceiptPath(ref)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn strings.TrimSuffix(path, \".json\") + \".intent.json\", nil\n}\n\n// closeoutIntentPending reports an intent on file. What cannot be read is an\n// error, which the caller treats as pending: it never proves history.\nfunc (s Store) closeoutIntentPending(ref string) (bool, error) {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif _, err := s.fsys().Lstat(path); err == nil {\n\t\treturn true, nil\n\t} else if os.IsNotExist(err) {\n\t\treturn false, nil\n\t} else {\n\t\treturn false, err\n\t}\n}\n\n// PublishCloseoutIntent records that this engine is closing ref under the\n// adopted policy, before the roadmap's status is published.\nfunc (s Store) PublishCloseoutIntent(ref string, decision CloseoutReviewDecision, now time.Time) error {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn err\n\t}\n\traw, err := json.MarshalIndent(map[string]any{\"schema_version\": 1, \"scope\": ref, \"started_at\": now.UTC().Format(time.RFC3339), \"review\": decision.Review()}, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\treturn s.fsys().Publish(path, append(raw, '\\n'), 0o644, PublishDerived, PublishExpectation{Mode: ExpectAny})\n}\n\n// ClearCloseoutIntent removes the intent once the receipt stands.\nfunc (s Store) ClearCloseoutIntent(ref string) error {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().Remove(path); err != nil && !os.IsNotExist(err) {\n\t\treturn err\n\t}\n\treturn nil\n}\n\n// roadmapCriteriaBlockers evaluates a roadmap's cut criteria from the indexed\n// delivery graph, as the roadmap gate does: a criterion that does not pass,\n// or a manual review that does not resolve inside the project. A graph that\n// cannot be read is a blocker, never a pass.\nfunc (s Store) roadmapCriteriaBlockers(slug string) []string {\n\tgraph, err := s.GetDeliveryIntegrity(\"\")\n\tif err != nil {\n\t\treturn []string{\"the cut criteria of roadmap \" + slug + \" cannot be evaluated: \" + err.Error()}\n\t}\n\tblockers := []string{}\n\tfor _, criterion := range graph.RoadmapCriteria {\n\t\tif criterion.Roadmap != slug {\n\t\t\tcontinue\n\t\t}\n\t\tif !criterion.Passed {\n\t\t\tblockers = append(blockers, criterion.ID+\": \"+strings.Join(criterion.Reasons, \"; \"))\n\t\t}\n\t\tfor _, ref := range criterion.Refs {\n\t\t\trelative, manual := strings.CutPrefix(ref, \"manual-review:\")\n\t\t\tif !manual {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tpath := filepath.Join(s.Root, filepath.FromSlash(relative))\n\t\t\tif !filepath.IsLocal(filepath.FromSlash(relative)) || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\t\t\tblockers = append(blockers, criterion.ID+\": manual review escapes project\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif info, err := s.fsys().Stat(path); err != nil || info.IsDir() {\n\t\t\t\tblockers = append(blockers, criterion.ID+\": manual review does not resolve: \"+relative)\n\t\t\t}\n\t\t}\n\t}\n\treturn blockers\n}\n","exit_code":0,"status":"completed"}}
