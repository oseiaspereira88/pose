{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1780,1850p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"\t\t\treturn nil, err\n\t\t}\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tif milestone.ID == scope.Milestone {\n\t\t\t\tfor _, raw := range milestone.Specs {\n\t\t\t\t\t// External members are sealed through the federated\n\t\t\t\t\t// manifest, not as local child bundles; a member a\n\t\t\t\t\t// transfer moved is the destination it resolves to,\n\t\t\t\t\t// never the redirect stub (review round 8, N29).\n\t\t\t\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n\t\t\t\t\tif unresolved != \"\" {\n\t\t\t\t\t\treturn nil, fmt.Errorf(\"pose: %s\", unresolved)\n\t\t\t\t\t}\n\t\t\t\t\tif !external {\n\t\t\t\t\t\trefs = append(refs, \"spec:\"+slug)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t} else if scope.Kind == \"roadmap\" {\n\t\trm, err := s.GetRoadmap(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\trefs = append(refs, \"milestone:\"+rm.Slug+\"/\"+milestone.ID)\n\t\t}\n\t}\n\treturn refs, nil\n}\n\nfunc (s Store) reviewBundleChildren(scope ScopeRef) ([]ReviewBundleChild, []string, error) {\n\trefs, err := s.reviewBundleChildRefs(scope)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\ts = s.reviewOperation()\n\tparentDone, _ := s.scopeLifecycleDone(scope)\n\tchildren, blockers := []ReviewBundleChild{}, []string{}\n\tfor _, ref := range refs {\n\t\tif verification, err := s.verifyReviewBundle(ref); err == nil && verification.inherited {\n\t\t\t// An inherited or exempt child stands only while it is approved:\n\t\t\t// one whose member fell is a live obligation of this scope, never\n\t\t\t// skipped (review round 10, N36).\n\t\t\tif !verification.Approved {\n\t\t\t\treason := verification.State\n\t\t\t\tif len(verification.Blockers) > 0 {\n\t\t\t\t\treason += \": \" + strings.Join(verification.Blockers, \"; \")\n\t\t\t\t}\n\t\t\t\tblockers = append(blockers, \"child \"+ref+\" does not stand: \"+reason)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// A declared milestone has no bundle to seal over: the reason is in the\n\t\t\t// roadmap, which this bundle seals.\n\t\t\tif verification.Bundle != nil {\n\t\t\t\tchildren = append(children, ReviewBundleChild{Scope: ref, BundleID: verification.Bundle.BundleID, BundleDigest: verification.Bundle.BundleDigest})\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tsealed, err := s.CurrentReviewBundle(ref)\n\t\tif err != nil {\n\t\t\treturn nil, nil, err\n\t\t}\n\t\tif sealed == nil {\n\t\t\tretained, why := s.retainedChildReviewBundle(ref)\n\t\t\tif retained == nil {\n\t\t\t\tblockers = append(blockers, \"child \"+ref+\" has no sealed review bundle\"+why)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tsealed = retained\n\t\t} else if why := s.childReviewStanding(ref, parentDone); why != \"\" {\n","exit_code":0,"status":"completed"}}
