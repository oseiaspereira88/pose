{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2..71cd6aea -- pose-mcp/internal/pose/roadmaps.go pose-mcp/internal/pose/federated_acceptance.go pose-mcp/internal/cli/doctor.go pose-mcp/internal/pose/governance_read_view.go .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md'","aggregated_output":"diff --git a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\nindex 6e369a55..979a235c 100644\n--- a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n+++ b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n@@ -229,3 +229,25 @@ uses Read/Grep/Glob/Bash without Edit/Write/Agent tools or plan approval mode.\n This changes neither independence nor stream/output/run limits; the actual\n working tree remains checked for mutation. No vendor profile becomes a scaffold\n default.\n+\n+\n+## Capacity recalibration of captured input bytes (D10) — 2026-11-13\n+\n+Closing spec `pose-closeout-review-policy-by-cost-benefit`, `pose index` in a\n+fresh clone and then in the maintainer checkout refused the pose-dist corpus:\n+`index.delivery-integrity` exceeded the captured-input budget and\n+`index.generate` was left without a complete observation. Measured with a Git\n+shim on the real builder: the change sets of every spec read `git show\n+--binary` for 2,451 distinct trailer commits, 492 MB of Git output in the\n+capture (the final audit reads it again under its own budget), plus the file\n+inputs of the generation, so the operation needed more than 512 MiB. Nothing\n+was truncated; the refusal was correct. Raise the captured-input budget to\n+1 GiB, for capture and audit alike, and keep every other limit, including the\n+512 MiB executable-hash bound of D9. Observations retain their bytes, so the\n+operation may now hold up to 1 GiB of captured input in memory. This\n+recalibration buys headroom, not a scaling property: the corpus grows with\n+every attributed commit. The structural fix, retaining only a digest for pure\n+reads of immutable Git objects whose bytes a producer only hashes, is a\n+follow-up of that spec, and a further raise again requires a measured\n+reassessment.\n+\ndiff --git a/pose-mcp/internal/cli/doctor.go b/pose-mcp/internal/cli/doctor.go\nindex 8944a53d..d091206a 100644\n--- a/pose-mcp/internal/cli/doctor.go\n+++ b/pose-mcp/internal/cli/doctor.go\n@@ -262,6 +262,7 @@ func runDoctorDiagnostics(locale cliLocale) (root string, findings []doctorFindi\n \t}\n \tadd(\"instance.pose-dir\", \"ok\", text(\".pose/ present\", \".pose/ presente\"), \"\")\n \tdiagnoseProjectState(root, add, text)\n+\tdiagnoseCloseoutReviewPolicy(root, add, text)\n \tdiagnoseReviewContinuity(root, add)\n \n \t// 3. Native engine contract.\n@@ -1574,3 +1575,30 @@ func declaredMCPProjectID(raw []byte) string {\n \tid, _ := doc.MCPServers[\"pose\"].Env[\"POSE_DEFAULT_PROJECT_ID\"].(string)\n \treturn id\n }\n+\n+// diagnoseCloseoutReviewPolicy reports open milestones and roadmaps that owe\n+// their own review under the adopted closeout review policy, because of the\n+// policy or of their composition (spec pose-closeout-review-policy-by-cost-benefit\n+// R6). It only reports: `pose close` remains the gate.\n+func diagnoseCloseoutReviewPolicy(root string, add func(string, string, string, string), text func(string, string) string) {\n+\t// The store `pose close` uses, with the resolver the environment binds,\n+\t// so an external or transferred member resolves here as it does there\n+\t// (review round 11, N37).\n+\tstore := cliGovernedStore(root)\n+\tpolicy, err := store.GetReviewPolicy()\n+\tif err != nil || !policy.CloseoutReviewAdopted() {\n+\t\treturn\n+\t}\n+\towing, err := store.CloseoutReviewsOwed()\n+\tif err != nil {\n+\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"open scopes owing a closeout review could not be listed: %v\", \"escopos abertos que devem revisão de fechamento não puderam ser listados: %v\"), err), text(\"run `pose closeout-check <scope>` for each open milestone and roadmap\", \"rode `pose closeout-check <escopo>` para cada milestone e roadmap aberto\"))\n+\t\treturn\n+\t}\n+\tif len(owing) == 0 {\n+\t\tadd(\"closeout-review.owed\", \"ok\", fmt.Sprintf(text(\"no open scope owes a review it lacks (milestone_review_required=%s, roadmap_review_required=%s)\", \"nenhum escopo aberto deve uma revisão que não tem (milestone_review_required=%s, roadmap_review_required=%s)\"), policy.MilestoneReviewRequired, policy.RoadmapReviewRequired), \"\")\n+\t\treturn\n+\t}\n+\tfor _, item := range owing {\n+\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"%s owes its own review: %s=%s, %s; previous rule %s\", \"%s deve revisão própria: %s=%s, %s; regra anterior %s\"), item.Scope, item.Decision.PolicyKey, item.Decision.PolicyValue, item.Decision.Reason, item.Previous), item.Action)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/federated_acceptance.go b/pose-mcp/internal/pose/federated_acceptance.go\nindex 93ff8452..48f2cd22 100644\n--- a/pose-mcp/internal/pose/federated_acceptance.go\n+++ b/pose-mcp/internal/pose/federated_acceptance.go\n@@ -403,16 +403,24 @@ func (s Store) federatedAcceptance(projectID string, coordinator ArtifactRef, ed\n \t\t}\n \t\tvisited[key] = true\n \t\tentry := FederatedDependency{Ref: key, Relationship: item.relationship, Relationships: []string{item.relationship}, Identity: identity, ResolutionState: resolved.State, Status: resolved.Status, SourceRevision: resolved.Revision, SourceDigest: resolved.Digest}\n+\t\t// The dependency keeps the identity it was named by, as the manifest\n+\t\t// records it; a transferred artifact is proven at its canonical\n+\t\t// destination: its store, revision, trust and closeout (review\n+\t\t// round 7, N25). The resolver authorized the redirect chain.\n+\t\tproven := identity\n+\t\tif resolved.CanonicalIdentity != nil {\n+\t\t\tproven = *resolved.CanonicalIdentity\n+\t\t}\n \t\tdependencyIndexes[key] = len(report.Manifest.Dependencies)\n \t\tif !resolved.Resolved {\n \t\t\treport.Blockers = append(report.Blockers, key+\":\"+resolved.State)\n \t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n \t\t\tcontinue\n \t\t}\n-\t\tif selected, exists := snapshotRevisions[identity.Project]; exists && selected != \"\" && resolved.Revision != selected {\n+\t\tif selected, exists := snapshotRevisions[proven.Project]; exists && selected != \"\" && resolved.Revision != selected {\n \t\t\treport.Blockers = append(report.Blockers, key+\":source-revision-changed-during-resolution\")\n-\t\t} else if _, exists := snapshotRevisions[identity.Project]; !exists && resolved.Revision != \"\" {\n-\t\t\tsnapshotRevisions[identity.Project] = resolved.Revision\n+\t\t} else if _, exists := snapshotRevisions[proven.Project]; !exists && resolved.Revision != \"\" {\n+\t\t\tsnapshotRevisions[proven.Project] = resolved.Revision\n \t\t}\n \t\tgraphValid := true\n \t\tif reason := resolver.ValidateGraph(item.project, item.raw); reason != \"\" {\n@@ -424,19 +432,19 @@ func (s Store) federatedAcceptance(projectID string, coordinator ArtifactRef, ed\n \t\tif !statusDone {\n \t\t\treport.Blockers = append(report.Blockers, key+\":not-done\")\n \t\t}\n-\t\tsource, sourceErr := resolver.Roots.StoreFor(identity.Project)\n+\t\tsource, sourceErr := resolver.Roots.StoreFor(proven.Project)\n \t\tif sourceErr != nil {\n \t\t\tentry.ResolutionState = projectResolutionState(sourceErr)\n \t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n \t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n \t\t\tcontinue\n \t\t}\n-\t\tsource = resolver.withSpecSnapshot(identity.Project, source)\n-\t\tprojectRoots[identity.Project] = source\n-\t\tsource.FederatedProjectID = identity.Project\n+\t\tsource = resolver.withSpecSnapshot(proven.Project, source)\n+\t\tprojectRoots[proven.Project] = source\n+\t\tsource.FederatedProjectID = proven.Project\n \t\tsource.FederatedResolver = &resolver\n \t\tartifactValid := true\n-\t\tif err := verifyFederatedArtifactAtRevision(s.fsys(), source, identity, resolved); err != nil {\n+\t\tif err := verifyFederatedArtifactAtRevision(s.fsys(), source, proven, resolved); err != nil {\n \t\t\tartifactValid = false\n \t\t\tentry.ResolutionState = err.Error()\n \t\t\tblocker := key + \":\" + err.Error()\n@@ -449,18 +457,27 @@ func (s Store) federatedAcceptance(projectID string, coordinator ArtifactRef, ed\n \t\t// Using repository HEAD makes every unrelated evidence commit stale a\n \t\t// sealed milestone or roadmap. External dependencies retain the explicit\n \t\t// whole-repository pin checked below.\n-\t\tif identity.Project == projectID {\n-\t\t\tif stable := federatedArtifactLastChange(s.fsys(), source, identity); stable != \"\" {\n+\t\tif proven.Project == projectID {\n+\t\t\tif stable := federatedArtifactLastChange(s.fsys(), source, proven); stable != \"\" {\n \t\t\t\tentry.SourceRevision = stable\n \t\t\t}\n+\t\t\t// Under an adopted closeout review policy a local milestone or\n+\t\t\t// roadmap is closed by its explicit close, never by the status\n+\t\t\t// its members give it: the edge asks the terminal projection,\n+\t\t\t// along a chain that stops at a cycle (review round 6, N22).\n+\t\t\tif statusDone && graphValid && (proven.Kind == \"milestone\" || proven.Kind == \"roadmap\") {\n+\t\t\t\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || adopted && !s.localScopeClosed(localFederatedScope(proven)) {\n+\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":closeout-not-terminal\")\n+\t\t\t\t}\n+\t\t\t}\n \t\t}\n-\t\tif identity.Project != projectID {\n+\t\tif proven.Project != projectID {\n \t\t\t// Do not recurse into source closeout when graph traversal has already\n \t\t\t// found a cycle or stale artifact.