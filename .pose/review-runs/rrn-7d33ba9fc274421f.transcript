-mcp/internal/cli/validate_results.go          |   13 +\n pose-mcp/internal/cli/validate_scope.go            |  131 +-\n pose-mcp/internal/pose/delivery_validation_run.go  |   10 +-\n .../internal/pose/delivery_validation_run_test.go  |   30 +\n pose-mcp/internal/scaffold/dist/POSE.md            |    6 +-\n .../internal/scaffold/dist/locales/pt-BR/POSE.md   |    6 +-\n 124 files changed, 59632 insertions(+), 2541 deletions(-)\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"os/signal\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"syscall\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\ntype validationWhen struct {\n\tFileExists    string `json:\"fileExists\"`\n\tFileNotExists string `json:\"fileNotExists\"`\n\t// FileNotExistsAny (spec pose-stack-catalog-expansion): skip when ANY of\n\t// these files exist — expresses manager-priority exclusion (e.g. a pip\n\t// check yields to poetry/pipenv when their lockfiles are present)\n\t// without needing repeated single-field checks.\n\tFileNotExistsAny []string `json:\"fileNotExistsAny\"`\n}\n\ntype validationCheck struct {\n\tName          string            `json:\"name\"`\n\tCommand       string            `json:\"command\"`\n\tProgram       string            `json:\"program\"`\n\tArgs          []string          `json:\"args\"`\n\tEnv           map[string]string `json:\"env\"`\n\tSeverity      string            `json:\"severity\"`\n\tEvidenceClass string            `json:\"evidenceClass,omitempty\"`\n\tWhen          validationWhen    `json:\"when\"`\n\t// Runtime guardrails (spec pose-validation-runtime-guardrails).\n\tTimeoutSeconds int    `json:\"timeoutSeconds\"` // 0 = defaults.timeoutSeconds (600)\n\tIsolation      string `json:\"isolation\"`      // \"\" | \"required\" — required never runs locally\n\t// Exclusive runs the check with no other check running (spec\n\t// pose-validate-concurrent-steps R2).\n\tExclusive bool `json:\"exclusive,omitempty\"`\n}\n\n// validationEntry is one line of a validation run, in matrix order: a module\n// note, a skipped check or a check to execute.\ntype validationEntry struct {\n\tnote      string\n\tcheck     validationCheck\n\tmoduleDir string\n\tseverity  string\n\t// skip is why the check does not run. silent marks a changed-scope skip,\n\t// recorded in order without a step line.\n\tskip     string\n\tsilent   bool\n\tisolated bool\n\t// carried marks a check whose result comes from the canonical base (spec\n\t// pose-validate-carries-unchanged-checks R4); it is silent and never runs.\n\tcarried bool\n\tresult  checkResult\n\tdone     chan struct{}\n}\n\n// resolveWhen evaluates the check's condition at the moment it would start,\n// so an earlier check, finished by then, can decide it (review round 1, B1).\nfunc (e *validationEntry) resolveWhen() {\n\tif e.skip == \"\" {\n\t\te.skip = validationSkipReason(e.moduleDir, e.check.When)\n\t}\n}\n\n// execute runs the check and records its outcome in the entry's result. It\n// touches nothing else, so entries can run concurrently; the caller counts.\nfunc (e *validationEntry) execute(parent context.Context, matrix validationMatrix, verbose bool, stdout, stderr io.Writer, beforeStream func()) {\n\tcheck, result := e.check, &e.result\n\ttimeout := check.TimeoutSeconds\n\tif timeout <= 0 {\n\t\ttimeout = matrix.Defaults.TimeoutSeconds\n\t}\n\tif timeout <= 0 {\n\t\ttimeout = 600 // documented safe default\n\t}\n\tmaxOutput := matrix.Defaults.MaxOutputBytes\n\tif maxOutput <= 0 {\n\t\tmaxOutput = 1 << 20 // 1 MiB documented safe default\n\t}\n\tctx, cancel := context.WithTimeout(parent, time.Duration(timeout)*time.Second)\n\tcapture := &tailBuffer{capacity: 4096}\n\tlimiter := &outputLimiter{limit: maxOutput, cancel: cancel}\n\tpackages := &goTestPackages{}\n\texecArgs := sanitizeGoCheckArgs(ctx, e.moduleDir, check.Program, check.Args)\n\tif parent.Err() != nil {\n\t\tcancel()\n\t\te.markCancelled()\n\t\treturn\n\t}\n\tcmd := exec.CommandContext(ctx, check.Program, execArgs...)\n\tsetProcessGroup(cmd)\n\tcmd.Cancel = func() error { return killProcessGroup(cmd) }\n\tcmd.Dir = e.moduleDir\n\t// The renderer owns the terminal while a step is active: a child\n\t// writing to it would fight the status line, and streaming every\n\t// check's output is what buried the run's own verdict. The output is\n\t// captured and shown when the check fails; --verbose streams it\n\t// (spec pose-cli-output-rendering-system R7).\n\tif verbose {\n\t\tbeforeStream()\n\t\tcmd.Stdout = io.MultiWriter(stdout, capture, limiter, packages)\n\t\tcmd.Stderr = io.MultiWriter(stderr, capture, limiter)\n\t// as clean.\n\tif err := os.MkdirAll(filepath.Join(f.root, \"b\", \"data\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !materialWorktreeClean(f.root) {\n\t\tt.Fatal(\"the fixture must look clean to status for this test to mean anything\")\n\t}\n\t_, out, run := f.validate()\n\tif run.MaterialClean {\n\t\tt.Fatalf(\"material_clean = true with an uninitialized submodule: %s\", out)\n\t}\n\tif sub := submodulesCheckedOut(f.root, \"HEAD\"); sub != \"b/data\" {\n\t\tt.Fatalf(\"submodulesCheckedOut = %q, want b/data\", sub)\n\t}\n}\n\n// A condition that holds only at the end of the run does not make it clean:\n// a hidden index entry cleared during the run (review round 14, N40).\nfunc TestValidateConditionClearedDuringTheRunIsNotClean(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.write(\"b/input\", \"x\\n\")\n\tf.commit(\"b input\")\n\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\tscript := `git -C .. update-index --no-skip-worktree b/input`\n\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\"`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"clears\",\"program\":\"sh\",\"args\":[\"-c\",\"`+script+`\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\"`, 1))\n\tf.commit(\"a check that clears the flag\")\n\tf.git(\"update-index\", \"--skip-worktree\", \"b/input\")\n\t_, out, run := f.validate()\n\tif run.MaterialClean {\n\t\tt.Fatalf(\"material_clean = true although the run started with a hidden index entry: %s\", out)\n\t}\n}\n21:| `unknown-recorded-as-satisfied` | enforced | An obligation the engine could not observe is reported as satisfied | pose-obligation-contract |\n56:| `canned-executor-approval-proves-cognition` | delegated | A complete canned approval from a trusted local command is presented as proof of review cognition or a vendor receipt (`cli/delegated_review_capability_test.go:TestDelegatedReviewCapabilityCannedApprovalDisclosesItsLimits` guards disclosure; the engine cannot detect canned judgments) | pose-delegated-review-capability |\n","exit_code":0,"status":"completed"}}
