{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/validate_carry.go | sed -n '490,780p'; nl -ba pose-mcp/internal/cli/validate.go | sed -n '1000,1105p;1425,1535p;1600,1660p;1700,1805p'; rg -n 'func discoverValidation|moduleOverrides|func writeValidation|IsAdministrativePath|validationMaterialClean' pose-mcp/internal/cli/validate* pose-mcp/internal/pose/*material* pose-mcp/internal/pose/*admin*\"","aggregated_output":"   490\t\t}\n   491\t\tfor _, m := range modules {\n   492\t\t\tadd(m.Abs)\n   493\t\t}\n   494\t\tfor _, module := range meta.Modules {\n   495\t\t\tfor _, dep := range module.DependsOn {\n   496\t\t\t\tadd(filepath.Join(root, filepath.FromSlash(filepath.ToSlash(filepath.Clean(dep)))))\n   497\t\t\t}\n   498\t\t}\n   499\t\tsort.Strings(dirs)\n   500\t\treturn dirs\n   501\t}\n   502\t\n   503\t// casefoldedDirectory reports whether dir looks names up without case: an\n   504\t// entry spelled with its letters' case swapped names the same file.\n   505\tfunc casefoldedDirectory(dir string, readDir func(string) ([]os.DirEntry, error), stat func(string) (os.FileInfo, error)) bool {\n   506\t\t// An unreadable directory cannot be shown not to fold. Entries are probed\n   507\t\t// without following links, and an unusable one is skipped, not taken as\n   508\t\t// proof (review round 10, N27).\n   509\t\tentries, err := readDir(dir)\n   510\t\tif err != nil {\n   511\t\t\treturn true\n   512\t\t}\n   513\t\t// Only ASCII letters swap case without Unicode folding subtleties, such\n   514\t\t// as dotless i (review round 12, N35); a directory with no such entry\n   515\t\t// cannot be shown not to fold.\n   516\t\tfor _, entry := range entries {\n   517\t\t\tname := entry.Name()\n   518\t\t\tif !asciiPath(name) || !strings.ContainsAny(name, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") {\n   519\t\t\t\tcontinue\n   520\t\t\t}\n   521\t\t\tswapped := swapCase(name)\n   522\t\t\toriginal, err := stat(filepath.Join(dir, name))\n   523\t\t\tif err != nil {\n   524\t\t\t\tcontinue\n   525\t\t\t}\n   526\t\t\t// The first usable entry decides: its swapped spelling names the same\n   527\t\t\t// file only where lookups fold case.\n   528\t\t\tother, err := stat(filepath.Join(dir, swapped))\n   529\t\t\treturn err == nil && os.SameFile(original, other)\n   530\t\t}\n   531\t\treturn true\n   532\t}\n   533\t\n   534\tfunc swapCase(s string) string {\n   535\t\treturn strings.Map(func(r rune) rune {\n   536\t\t\tswitch {\n   537\t\t\tcase unicode.IsUpper(r):\n   538\t\t\t\treturn unicode.ToLower(r)\n   539\t\t\tcase unicode.IsLower(r):\n   540\t\t\t\treturn unicode.ToUpper(r)\n   541\t\t\t}\n   542\t\t\treturn r\n   543\t\t}, s)\n   544\t}\n   545\t\n   546\t// asciiPath reports whether p is plain ASCII.\n   547\tfunc asciiPath(p string) bool {\n   548\t\tfor i := 0; i < len(p); i++ {\n   549\t\t\tif p[i] >= 0x80 {\n   550\t\t\t\treturn false\n   551\t\t\t}\n   552\t\t}\n   553\t\treturn true\n   554\t}\n   555\t\n   556\t// hiddenIndexEntries returns a tracked path, in the repository or in one of\n   557\t// its checked-out submodules, whose index entry is marked assume-unchanged or\n   558\t// skip-worktree: status cannot see edits to it.\n   559\tfunc hiddenIndexEntries(root, head string) (string, error) {\n   560\t\tcheck := func(repo, prefix string) (string, error) {\n   561\t\t\tout, err := posemodel.RawGit(\"-C\", repo, \"ls-files\", \"-v\", \"-z\").Output()\n   562\t\t\tif err != nil {\n   563\t\t\t\treturn \"\", err\n   564\t\t\t}\n   565\t\t\tfor _, entry := range strings.Split(string(out), \"\\x00\") {\n   566\t\t\t\tif len(entry) < 3 {\n   567\t\t\t\t\tcontinue\n   568\t\t\t\t}\n   569\t\t\t\ttag := entry[0]\n   570\t\t\t\tif (tag >= 'a' && tag <= 'z') || tag == 'S' {\n   571\t\t\t\t\treturn path.Join(prefix, entry[2:]), nil\n   572\t\t\t\t}\n   573\t\t\t}\n   574\t\t\treturn \"\", nil\n   575\t\t}\n   576\t\tif hidden, err := check(root, \"\"); err != nil || hidden != \"\" {\n   577\t\t\treturn hidden, err\n   578\t\t}\n   579\t\tlinks, err := gitlinks(root, head)\n   580\t\tif err != nil {\n   581\t\t\treturn \"\", err\n   582\t\t}\n   583\t\tfor sub := range links {\n   584\t\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n   585\t\t\tif _, err := os.Stat(filepath.Join(repo, \".git\")); err != nil {\n   586\t\t\t\tcontinue\n   587\t\t\t}\n   588\t\t\tif hidden, err := check(repo, sub); err != nil || hidden != \"\" {\n   589\t\t\t\treturn hidden, err\n   590\t\t\t}\n   591\t\t}\n   592\t\treturn \"\", nil\n   593\t}\n   594\t\n   595\t// physicallyLexical reports whether rel, and every existing ancestor of it,\n   596\t// resolves to its own spelling: no symlink, tracked or not, on the way.\n   597\tfunc physicallyLexical(root, rel string) bool {\n   598\t\troot = filepath.Clean(root)\n   599\t\tresolvedRoot, err := filepath.EvalSymlinks(root)\n   600\t\tif err != nil {\n   601\t\t\treturn false\n   602\t\t}\n   603\t\tp := filepath.Join(root, filepath.FromSlash(rel))\n   604\t\tfor ; p != root && strings.HasPrefix(p, root+string(filepath.Separator)); p = filepath.Dir(p) {\n   605\t\t\tif _, err := os.Lstat(p); err != nil {\n   606\t\t\t\tcontinue\n   607\t\t\t}\n   608\t\t\tresolved, err := filepath.EvalSymlinks(p)\n   609\t\t\tif err != nil {\n   610\t\t\t\treturn false\n   611\t\t\t}\n   612\t\t\twant := filepath.Join(resolvedRoot, strings.TrimPrefix(p, root+string(filepath.Separator)))\n   613\t\t\tif filepath.Clean(resolved) != filepath.Clean(want) {\n   614\t\t\t\treturn false\n   615\t\t\t}\n   616\t\t}\n   617\t\treturn true\n   618\t}\n   619\t\n   620\t// headReflogLength counts the entries of HEAD's reflog; -1 when it cannot be\n   621\t// read or reflogs are disabled.\n   622\tfunc headReflogLength(root string) int {\n   623\t\tout, err := posemodel.RawGit(\"-C\", root, \"reflog\", \"show\", \"--format=%H\", \"HEAD\", \"--\").Output()\n   624\t\tif err != nil {\n   625\t\t\treturn -1\n   626\t\t}\n   627\t\tlines := strings.Count(string(out), \"\\n\")\n   628\t\tif lines == 0 {\n   629\t\t\treturn -1\n   630\t\t}\n   631\t\treturn lines\n   632\t}\n   633\t\n   634\t// submodulesCheckedOut returns a gitlink of head whose working repository is\n   635\t// missing or not at the recorded commit; \"\" when every one is.\n   636\tfunc submodulesCheckedOut(root, head string) string {\n   637\t\tlinks, err := gitlinks(root, head)\n   638\t\tif err != nil {\n   639\t\t\treturn \"(gitlinks unreadable)\"\n   640\t\t}\n   641\t\tfor sub, commit := range links {\n   642\t\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n   643\t\t\tif _, err := os.Stat(filepath.Join(repo, \".git\")); err != nil {\n   644\t\t\t\treturn sub\n   645\t\t\t}\n   646\t\t\tout, err := posemodel.RawGit(\"-C\", repo, \"rev-parse\", \"HEAD\").Output()\n   647\t\t\tif err != nil || strings.TrimSpace(string(out)) != commit {\n   648\t\t\t\treturn sub\n   649\t\t\t}\n   650\t\t}\n   651\t\treturn \"\"\n   652\t}\n   653\t\n   654\t// validationMaterialClean is the full predicate a run must satisfy at its\n   655\t// start and at its end to validate head (review rounds 8–14): no tracked or\n   656\t// untracked unignored difference in status (mode changes included), no index\n   657\t// entry hiding edits, and every submodule checked out at its recorded commit\n   658\t// (an uninitialized one reads as clean to status).\n   659\tfunc validationMaterialClean(root, head string) bool {\n   660\t\tif !materialWorktreeClean(root) {\n   661\t\t\treturn false\n   662\t\t}\n   663\t\tif hidden, err := hiddenIndexEntries(root, head); err != nil || hidden != \"\" {\n   664\t\t\treturn false\n   665\t\t}\n   666\t\treturn submodulesCheckedOut(root, head) == \"\"\n   667\t}\n  1000\t\t\tif out != \"\" && !confinedRelativePath(out) {\n  1001\t\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: result output paths must remain inside the project.\", \"Erro: paths de saída de resultado devem permanecer dentro do projeto.\"))\n  1002\t\t\t\treturn 2\n  1003\t\t\t}\n  1004\t\t}\n  1005\t\tcanonicalResultsPath := \"\"\n  1006\t\tif jsonOut != \"\" || carry {\n  1007\t\t\tcanonicalResultsPath = configuredDeliveryResultsPath(root)\n  1008\t\t}\n  1009\t\tif carry {\n  1010\t\t\tswitch {\n  1011\t\t\tcase moduleFilter != \"\" || stackFilter != \"\" || workspaceFilter != \"\" || changedFrom != \"\" || changedTo != \"\":\n  1012\t\t\t\trender(stdout, stderr).Failure(cliText(locale, \"--carry refreshes the whole canonical result; it cannot be combined with --module, --stack, --workspace, --root-only, --changed-from or --changed-to\", \"--carry renova o resultado canônico inteiro; não combina com --module, --stack, --workspace, --root-only, --changed-from ou --changed-to\"))\n  1013\t\t\t\treturn 2\n  1014\t\t\tcase canonicalResultsPath == \"\":\n  1015\t\t\t\trender(stdout, stderr).Failure(cliText(locale, \"--carry needs results_path in .pose/policy/delivery.json\", \"--carry exige results_path em .pose/policy/delivery.json\"))\n  1016\t\t\t\treturn 2\n  1017\t\t\tcase normalizeValidationOutputPath(jsonOut) != canonicalResultsPath:\n  1018\t\t\t\trender(stdout, stderr).Failure(fmt.Sprintf(cliText(locale, \"--carry writes the canonical result: use --json-out %s\", \"--carry grava o resultado canônico: use --json-out %s\"), canonicalResultsPath))\n  1019\t\t\t\treturn 2\n  1020\t\t\t}\n  1021\t\t}\n  1022\t\t// The report --report writes records this run, so it reads this run's own\n  1023\t\t// output. It used to look for a pose-validate.latest.log that native\n  1024\t\t// validation never writes, and every report said \"Fill manually\" and \"No\n  1025\t\t// validation output detected\" under an outcome it could not support (spec\n  1026\t\t// pose-validate-report-carries-its-run).\n  1027\t\t// The report records this run from the run's own structured result, not\n  1028\t\t// from its printed output (spec pose-cli-output-rendering-system R5).\n  1029\t\t// Capturing stdout to re-parse it is what made every printed line a\n  1030\t\t// contract.\n  1031\t\tif stackFilter != \"\" && !map[string]bool{\"node\": true, \"go\": true, \"rust\": true, \"java\": true, \"python\": true, \"dotnet\": true, \"contract\": true}[stackFilter] {\n  1032\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid --stack: %s\\n\", \"Erro: --stack inválido: %s\\n\"), stackFilter)\n  1033\t\t\treturn 2\n  1034\t\t}\n  1035\t\tif moduleFilter == \"..\" || strings.HasPrefix(moduleFilter, \"../\") || filepath.IsAbs(moduleFilter) {\n  1036\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --module must remain inside the project.\", \"Erro: --module deve permanecer dentro do projeto.\"))\n  1037\t\t\treturn 2\n  1038\t\t}\n  1039\t\t// HEAD and its movement witness are pinned before any plan input is read:\n  1040\t\t// the matrix and the module discovery then belong to this head, or the\n  1041\t\t// end-of-run comparison sees the move (review round 13, N37).\n  1042\t\tpinnedHead := \"\"\n  1043\t\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n  1044\t\t\tpinnedHead = strings.TrimSpace(string(head))\n  1045\t\t}\n  1046\t\tstartReflog := headReflogLength(root)\n  1047\t\t// The working copy must match the pinned head before the plan inputs are\n  1048\t\t// read, by the same full predicate checked at the end: status, hidden\n  1049\t\t// index entries and submodule checkouts (review round 14, N40 and N41).\n  1050\t\tstartedClean := pinnedHead != \"\" && validationMaterialClean(root, pinnedHead)\n  1051\t\tmatrixPath := filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\")\n  1052\t\traw, err := os.ReadFile(matrixPath)\n  1053\t\tif err != nil {\n  1054\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: validation matrix not found at %s\\n\", \"Erro: matriz de validação não encontrada em %s\\n\"), matrixPath)\n  1055\t\t\treturn 2\n  1056\t\t}\n  1057\t\tmatrix, err := parseValidationMatrix(raw)\n  1058\t\tif err != nil {\n  1059\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid validation matrix: %v\\n\", \"Erro: matriz de validação inválida: %v\\n\"), err)\n  1060\t\t\treturn 2\n  1061\t\t}\n  1062\t\tif err := validateStructuredMatrixPaths(matrix); err != nil {\n  1063\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid validation matrix path: %v\\n\", \"Erro: path inválido na matriz de validação: %v\\n\"), err)\n  1064\t\t\treturn 2\n  1065\t\t}\n  1066\t\tif err := validateDeliveryMatrixContract(matrix); err != nil {\n  1067\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid delivery validation contract: %v\\n\", \"Erro: contrato de validação de delivery inválido: %v\\n\"), err)\n  1068\t\t\treturn 2\n  1069\t\t}\n  1070\t\tif matrixHasLegacyChecks(matrix) {\n  1071\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: legacy shell 'command' checks are unsupported; migrate each check to program + args + env.\", \"Erro: checks shell legados em 'command' não são suportados; migre cada check para program + args + env.\"))\n  1072\t\t\treturn 2\n  1073\t\t}\n  1074\t\tif mode == \"\" {\n  1075\t\t\tmode = matrix.Defaults.Mode\n  1076\t\t\tif mode == \"\" {\n  1077\t\t\t\tmode = \"strict\"\n  1078\t\t\t}\n  1079\t\t}\n  1080\t\tmodules, err := discoverValidationModules(root)\n  1081\t\tif err != nil {\n  1082\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: discovering modules: %v\\n\", \"Erro: descobrir módulos: %v\\n\"), err)\n  1083\t\t\treturn 1\n  1084\t\t}\n  1085\t\tif workspaceFilter != \"\" {\n  1086\t\t\tresolved, ok := resolveWorkspaceModulePath(root, modules, workspaceFilter)\n  1087\t\t\tif !ok {\n  1088\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: no module's manifest name matches --workspace %q.\\n\", \"Erro: nenhum module tem name de manifesto igual a --workspace %q.\\n\"), workspaceFilter)\n  1089\t\t\t\treturn 2\n  1090\t\t\t}\n  1091\t\t\tmoduleFilter = resolved\n  1092\t\t}\n  1093\t\tknownModules := map[string]bool{}\n  1094\t\tfor _, module := range modules {\n  1095\t\t\tknownModules[module.Rel] = true\n  1096\t\t}\n  1097\t\tfor rel, override := range matrix.ModuleOverrides {\n  1098\t\t\tclean := filepath.ToSlash(filepath.Clean(rel))\n  1099\t\t\tif clean == \"..\" || strings.HasPrefix(clean, \"../\") || filepath.IsAbs(rel) {\n  1100\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: moduleOverrides contains a path outside the project: %s\\n\", \"Erro: moduleOverrides contém path fora do projeto: %s\\n\"), rel)\n  1101\t\t\t\treturn 2\n  1102\t\t\t}\n  1103\t\t\tif knownModules[clean] {\n  1104\t\t\t\tif override.Stack != \"\" {\n  1105\t\t\t\t\tfor idx := range modules {\n  1425\t\t\tstep.Resolve(cliout.StateFromKey(result.Outcome), note)\n  1426\t\t\tif !verbose && (result.Outcome == \"fail\" || result.Outcome == \"error\") {\n  1427\t\t\t\tstep.Detail(tailLines(result.Output, 10), jsonOut)\n  1428\t\t\t}\n  1429\t\t\trun.Checks = append(run.Checks, *result)\n  1430\t\t}\n  1431\t\trun.WallSeconds = time.Since(wallStart).Seconds()\n  1432\t\t// A check that changed a tracked file changed the material it ran over: the\n  1433\t\t// committed tree no longer describes what was validated.\n  1434\t\tendedClean := materialTrackedUnchanged(root)\n  1435\t\t// The run validated its recorded head only if HEAD never moved: a commit\n  1436\t\t// made while checks ran would let them observe code the record does not\n  1437\t\t// name (review round 4, N10).\n  1438\t\tendHead := \"\"\n  1439\t\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n  1440\t\t\tendHead = strings.TrimSpace(string(head))\n  1441\t\t}\n  1442\t\t// Untracked material created while checks ran counts too (review round 8,\n  1443\t\t// N21): only ignored files may differ from the recorded head.\n  1444\t\n  1445\t\t// Equal endpoints do not show HEAD never moved: H -> H' -> H leaves them\n  1446\t\t// equal. The reflog must not have grown (review round 12, N34).\n  1447\t\tendReflog := headReflogLength(root)\n  1448\t\trun.MaterialClean = startedClean && endedClean && run.GitHead != \"\" && endHead == run.GitHead && validationMaterialClean(root, run.GitHead) && startReflog >= 0 && endReflog == startReflog\n  1449\t\t// A run that did not validate its recorded head binds no material: its\n  1450\t\t// bindings would let a later tree make a misattributed pass current again\n  1451\t\t// (review round 5, N12).\n  1452\t\tif len(run.MaterialProvenance) > 0 && !run.MaterialClean {\n  1453\t\t\tfor spec := range run.MaterialProvenance {\n  1454\t\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n  1455\t\t\t}\n  1456\t\t}\n  1457\t\t// A cancelled run never reads as a success, whatever the severity of the\n  1458\t\t// checks it stopped (review round 1, B5).\n  1459\t\tcancelled := false\n  1460\t\tfor _, check := range run.Checks {\n  1461\t\t\tcancelled = cancelled || check.LimitState == \"cancelled\"\n  1462\t\t}\n  1463\t\tfor _, line := range validationTimingNotes(run) {\n  1464\t\t\tsteps.Note(line)\n  1465\t\t}\n  1466\t\tsteps.Summary()\n  1467\t\tif executed == 0 && run.Counts.Carried == 0 {\n  1468\t\t\tfmt.Fprintln(stdout, \"No modules/checks matched the matrix and filters.\")\n  1469\t\t}\n  1470\t\tresult := \"pass\"\n  1471\t\tif cancelled {\n  1472\t\t\tfailures++\n  1473\t\t\tresult = \"fail\"\n  1474\t\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"validation cancelled\", \"validação cancelada\")})\n  1475\t\t} else if failures > 0 {\n  1476\t\t\tresult = \"fail\"\n  1477\t\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"required check failed\", \"check obrigatório falhou\")})\n  1478\t\t} else {\n  1479\t\t\tif optionalFailures > 0 {\n  1480\t\t\t\tresult = \"partial\"\n  1481\t\t\t\tr.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"optional-check\",\n  1482\t\t\t\t\tMessage: fmt.Sprintf(cliText(locale, \"%d optional check(s) failed\", \"%d check(s) opcional(is) falharam\"), optionalFailures)})\n  1483\t\t\t}\n  1484\t\t\tr.Verdict(cliout.Verdict{State: cliout.StatePass})\n  1485\t\t}\n  1486\t\trun.Outcome = result\n  1487\t\tusageFindings := make([]usageFinding, 0, run.Counts.Failed+run.Counts.OptionalFailed+run.Counts.Errored)\n  1488\t\tfor _, check := range run.Checks {\n  1489\t\t\tif check.Outcome != \"fail\" && check.Outcome != \"error\" {\n  1490\t\t\t\tcontinue\n  1491\t\t\t}\n  1492\t\t\tseverity := check.Severity\n  1493\t\t\tif check.Outcome == \"error\" {\n  1494\t\t\t\tseverity = \"error\"\n  1495\t\t\t}\n  1496\t\t\tusageFindings = append(usageFindings, usageFinding{ID: check.ID, Severity: severity})\n  1497\t\t}\n  1498\t\tnoteUsageFindings(stdout, result, usageFindings, true)\n  1499\t\tfor name, writer := range map[string]struct {\n  1500\t\t\tpath  string\n  1501\t\t\twrite func(string, validationRunResult) error\n  1502\t\t}{\n  1503\t\t\t\"json\":  {jsonOut, writeValidationJSON},\n  1504\t\t\t\"junit\": {junitOut, writeValidationJUnit},\n  1505\t\t\t\"sarif\": {sarifOut, writeValidationSARIF},\n  1506\t\t} {\n  1507\t\t\tif writer.path == \"\" {\n  1508\t\t\t\tcontinue\n  1509\t\t\t}\n  1510\t\t\ttarget := filepath.Join(root, filepath.FromSlash(writer.path))\n  1511\t\t\tif name == \"json\" && canonicalResultsPath != \"\" && normalizeValidationOutputPath(writer.path) == canonicalResultsPath {\n  1512\t\t\t\terr := publishCanonicalValidationJSONIn(store, writer.path, canonicalResultsPath, run)\n  1513\t\t\t\tif err != nil {\n  1514\t\t\t\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n  1515\t\t\t\t\t\tout := render(stdout, stderr)\n  1516\t\t\t\t\t\tout.ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n  1517\t\t\t\t\t\tout.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"validation-result-durability\",\n  1518\t\t\t\t\t\t\tMessage: fmt.Sprintf(\"%s result was published but durability is unconfirmed: %v\", name, err)})\n  1519\t\t\t\t\t\treturn 1\n  1520\t\t\t\t\t}\n  1521\t\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(cliText(locale, \"writing %s result: %v\", \"escrevendo resultado %s: %v\"), name, err))\n  1522\t\t\t\t\treturn 1\n  1523\t\t\t\t}\n  1524\t\t\t\trender(stdout, stderr).ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n  1525\t\t\t\tcontinue\n  1526\t\t\t}\n  1527\t\t\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n  1528\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: creating %s result directory: %v\\n\", \"Erro: criando diretório do resultado %s: %v\\n\"), name, err)\n  1529\t\t\t\treturn 1\n  1530\t\t\t}\n  1531\t\t\tif err := writer.write(target, run); err != nil {\n  1532\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: writing %s result: %v\\n\", \"Erro: escrevendo resultado %s: %v\\n\"), name, err)\n  1533\t\t\t\treturn 1\n  1534\t\t\t}\n  1535\t\t\tfmt.Fprintf(stdout, \"%s: %s\\n\", name, target)\n  1600\t}\n  1601\t\n  1602\t// tailLines keeps the last n lines of a check's captured output: enough to see\n  1603\t// why it failed, with the full output one path away.\n  1604\tfunc tailLines(text string, n int) string {\n  1605\t\tlines := strings.Split(strings.TrimRight(text, \"\\n\"), \"\\n\")\n  1606\t\tif len(lines) <= n {\n  1607\t\t\treturn strings.Join(lines, \"\\n\")\n  1608\t\t}\n  1609\t\treturn strings.Join(lines[len(lines)-n:], \"\\n\")\n  1610\t}\n  1611\t\n  1612\tfunc validationSummaryOf(run validationRunResult) *validationSummary {\n  1613\t\tsummary := &validationSummary{Outcome: run.Outcome}\n  1614\t\tfor _, check := range run.Checks {\n  1615\t\t\tcommand := strings.TrimSpace(check.Program + \" \" + strings.Join(check.Args, \" \"))\n  1616\t\t\tif check.Outcome != \"skipped\" && command != \"\" {\n  1617\t\t\t\tsummary.Commands = append(summary.Commands, command)\n  1618\t\t\t}\n  1619\t\t\tline := \"- [\" + check.Outcome + \"] \" + check.ID\n  1620\t\t\tswitch {\n  1621\t\t\tcase check.SkipReason != \"\":\n  1622\t\t\t\tline += \" (\" + check.SkipReason + \")\"\n  1623\t\t\tcase check.DurationSeconds > 0:\n  1624\t\t\t\tline += fmt.Sprintf(\" (%.1fs)\", check.DurationSeconds)\n  1625\t\t\t}\n  1626\t\t\tif check.ExitCode != nil {\n  1627\t\t\t\tline += fmt.Sprintf(\" exit=%d\", *check.ExitCode)\n  1628\t\t\t}\n  1629\t\t\tsummary.Results = append(summary.Results, line)\n  1630\t\t}\n  1631\t\t// The report records the run's verdict too, built from the outcome rather\n  1632\t\t// than copied from the printed line, so the recorded evidence keeps its\n  1633\t\t// shape while the terminal is free to change.\n  1634\t\tif run.Counts.OptionalFailed > 0 {\n  1635\t\t\tsummary.Results = append(summary.Results, fmt.Sprintf(\"Warning: %d optional check(s) failed.\", run.Counts.OptionalFailed))\n  1636\t\t}\n  1637\t\tswitch run.Outcome {\n  1638\t\tcase \"fail\":\n  1639\t\t\tsummary.Results = append(summary.Results, \"Result: FAILURE (required check failed)\")\n  1640\t\tdefault:\n  1641\t\t\tsummary.Results = append(summary.Results, \"Result: SUCCESS\")\n  1642\t\t}\n  1643\t\treturn summary\n  1644\t}\n  1645\t\n  1646\tfunc sanitizeGoCheckArgs(ctx context.Context, dir, program string, args []string) []string {\n  1647\t\tif program != \"go\" || len(args) == 0 {\n  1648\t\t\treturn args\n  1649\t\t}\n  1650\t\n  1651\t\thasWildcard := false\n  1652\t\tfor _, a := range args {\n  1653\t\t\tif a == \"./...\" || strings.HasSuffix(a, \"/...\") {\n  1654\t\t\t\thasWildcard = true\n  1655\t\t\t\tbreak\n  1656\t\t\t}\n  1657\t\t}\n  1658\t\tif !hasWildcard {\n  1659\t\t\treturn args\n  1660\t\t}\n  1700\t\t\t\tnewArgs = append(newArgs, filteredPkgs...)\n  1701\t\t\t} else {\n  1702\t\t\t\tnewArgs = append(newArgs, a)\n  1703\t\t\t}\n  1704\t\t}\n  1705\t\treturn newArgs\n  1706\t}\n  1707\t\n  1708\t// materialWorktreeClean reports whether the working copy equals HEAD in every\n  1709\t// path outside the administrative classes, untracked files included. A status\n  1710\t// that cannot be read is not clean.\n  1711\tfunc materialWorktreeClean(root string) bool {\n  1712\t\t// Mode changes count whatever core.fileMode says (review round 13, N36).\n  1713\t\tout, err := gitOutputBounded(root, 16*1024*1024, \"-c\", \"core.fileMode=true\", \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n  1714\t\tif err != nil {\n  1715\t\t\treturn false\n  1716\t\t}\n  1717\t\trecords := strings.Split(string(out), \"\\x00\")\n  1718\t\tvar administrative []string\n  1719\t\tfor i := 0; i < len(records); i++ {\n  1720\t\t\trecord := records[i]\n  1721\t\t\tif len(record) < 4 {\n  1722\t\t\t\tcontinue\n  1723\t\t\t}\n  1724\t\t\tpaths := []string{record[3:]}\n  1725\t\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n  1726\t\t\t\t// A rename or copy carries its source as the next record.\n  1727\t\t\t\tif i+1 < len(records) {\n  1728\t\t\t\t\ti++\n  1729\t\t\t\t\tpaths = append(paths, records[i])\n  1730\t\t\t\t}\n  1731\t\t\t}\n  1732\t\t\tfor _, p := range paths {\n  1733\t\t\t\tif !posemodel.IsAdministrativePath(p) {\n  1734\t\t\t\t\treturn false\n  1735\t\t\t\t}\n  1736\t\t\t\tadministrative = append(administrative, p)\n  1737\t\t\t}\n  1738\t\t}\n  1739\t\treturn administrativeRecordsAreRegular(root, administrative)\n  1740\t}\n  1741\t\n  1742\t// materialTrackedUnchanged reports whether no tracked file differs from HEAD\n  1743\t// outside the administrative records. Untracked files are not counted: checks\n  1744\t// leave build products behind, and those are not the material they ran over.\n  1745\tfunc materialTrackedUnchanged(root string) bool {\n  1746\t\tout, err := gitOutputBounded(root, 16*1024*1024, \"-c\", \"core.fileMode=true\", \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=no\")\n  1747\t\tif err != nil {\n  1748\t\t\treturn false\n  1749\t\t}\n  1750\t\trecords := strings.Split(string(out), \"\\x00\")\n  1751\t\tvar administrative []string\n  1752\t\tfor i := 0; i < len(records); i++ {\n  1753\t\t\trecord := records[i]\n  1754\t\t\tif len(record) < 4 {\n  1755\t\t\t\tcontinue\n  1756\t\t\t}\n  1757\t\t\tpaths := []string{record[3:]}\n  1758\t\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n  1759\t\t\t\tif i+1 < len(records) {\n  1760\t\t\t\t\ti++\n  1761\t\t\t\t\tpaths = append(paths, records[i])\n  1762\t\t\t\t}\n  1763\t\t\t}\n  1764\t\t\tfor _, p := range paths {\n  1765\t\t\t\tif !posemodel.IsAdministrativePath(p) {\n  1766\t\t\t\t\treturn false\n  1767\t\t\t\t}\n  1768\t\t\t\tadministrative = append(administrative, p)\n  1769\t\t\t}\n  1770\t\t}\n  1771\t\treturn administrativeRecordsAreRegular(root, administrative)\n  1772\t}\n  1773\t\n  1774\t// administrativeRecordsAreRegular reports whether every changed administrative\n  1775\t// path is a regular file at HEAD (or new): editing a committed symlink or\n  1776\t// submodule inside a class is a material change, as in MaterialSetDigest.\n  1777\tfunc administrativeRecordsAreRegular(root string, paths []string) bool {\n  1778\t\tif len(paths) == 0 {\n  1779\t\t\treturn true\n  1780\t\t}\n  1781\t\targs := []string{\"ls-tree\", \"-z\", \"HEAD\", \"--\"}\n  1782\t\tfor _, p := range paths {\n  1783\t\t\tif strings.ContainsAny(p, \"\\n\\x00\") {\n  1784\t\t\t\treturn false\n  1785\t\t\t}\n  1786\t\t\t// The working copy as well as HEAD: a regular record replaced by a link, or\n  1787\t\t\t// a new link, is not a record.\n  1788\t\t\tif info, err := os.Lstat(filepath.Join(root, filepath.FromSlash(p))); err == nil && !info.Mode().IsRegular() {\n  1789\t\t\t\treturn false\n  1790\t\t\t}\n  1791\t\t\targs = append(args, \":(literal)\"+p)\n  1792\t\t}\n  1793\t\tout, err := gitOutputBounded(root, 8*1024*1024, args...)\n  1794\t\tif err != nil {\n  1795\t\t\treturn false\n  1796\t\t}\n  1797\t\tfor _, record := range strings.Split(string(out), \"\\x00\") {\n  1798\t\t\tmeta, _, ok := strings.Cut(record, \"\\t\")\n  1799\t\t\tif !ok {\n  1800\t\t\t\tcontinue\n  1801\t\t\t}\n  1802\t\t\tif fields := strings.Fields(meta); len(fields) == 3 && fields[0] != \"100644\" && fields[0] != \"100755\" {\n  1803\t\t\t\treturn false\n  1804\t\t\t}\n  1805\t\t}\nrg: pose-mcp/internal/pose/*admin*: No such file or directory (os error 2)\npose-mcp/internal/cli/validate_progress_test.go:40:\t]}},\"moduleOverrides\":{}}`, shell, shell)\npose-mcp/internal/pose/material_binding_test.go:8:func TestIsAdministrativePathIsClosedAndPathExact(t *testing.T) {\npose-mcp/internal/pose/material_binding_test.go:26:\t\tif got := IsAdministrativePath(p); got != want {\npose-mcp/internal/pose/material_binding_test.go:188:\t\tif got := IsAdministrativePath(p); got != want {\npose-mcp/internal/pose/material_binding.go:35:// IsAdministrativePath reports whether p is a derived administrative record.\npose-mcp/internal/pose/material_binding.go:36:func IsAdministrativePath(p string) bool {\npose-mcp/internal/pose/material_binding.go:126:\t\tif IsAdministrativePath(name) && !moved[name] && (!present || regularMode(entry.Mode)) {\npose-mcp/internal/cli/validate_carry_test.go:513:\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\"`, `\"moduleOverrides\":{\"alias\":{\"stack\":\"go\"}},\"stacks\"`, 1))\npose-mcp/internal/cli/validate_carry_test.go:530:\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\":{\"go\":{\"checks\":[`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"moves\",\"program\":\"sh\",\"args\":[\"-c\",\"`+commit+`\"],\"severity\":\"required\",\"evidenceClass\":\"unit\"}]}},\"stacks\":{\"go\":{\"checks\":[`, 1))\npose-mcp/internal/cli/validate_carry_test.go:566:\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"stacks\":{\"go\":{\"checks\":[`, `\"moduleOverrides\":{\"a\":{\"checks\":[{\"name\":\"moves\",\"program\":\"sh\",\"args\":[\"-c\",\"`+commit+`\"],\