{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/rules/backend-go.md; sed -n '430,503p' pose-mcp/internal/cli/validate_carry.go; git diff --check dec2e64c..55ac2a9 -- pose-mcp POSE.md locales/pt-BR/POSE.md; git status --short; go version -m /home/go/.local/bin/pose\"","aggregated_output":"# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n\t\tlinks[entry[tab+1:]] = fields[2]\n\t}\n\treturn links, nil\n}\n\n// submoduleAliases names a submodule that could hide an alias: one that is\n// not checked out at its recorded commit, or that itself has gitlinks, or\n// whose tree tracks an aliasing symlink.\nfunc submoduleAliases(root, head string, modules []validationModule, meta scopeMetadata) (string, error) {\n\tlinks, err := gitlinks(root, head)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\t// Every gitlink is scanned, not only those holding a module or a\n\t// dependency: one inside a module aliases its paths too (review round 9,\n\t// N24).\n\tfor sub, commit := range links {\n\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n\t\tif err := posemodel.RawGit(\"-C\", repo, \"cat-file\", \"-e\", commit+\"^{commit}\").Run(); err != nil {\n\t\t\treturn fmt.Sprintf(\"submodule %s is not checked out at its recorded commit, so aliases in it cannot be ruled out\", sub), nil\n\t\t}\n\t\tnested, err := gitlinks(repo, commit)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tif len(nested) > 0 {\n\t\t\treturn fmt.Sprintf(\"submodule %s has nested submodules, so aliases in it cannot be ruled out\", sub), nil\n\t\t}\n\t\tlink, err := aliasingSymlinkIn(root, repo, commit, sub, modules, meta)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tif link != \"\" {\n\t\t\treturn fmt.Sprintf(\"the tree tracks symlink %s into or out of a module or a declared dependency, so changes cannot be attributed\", link), nil\n\t\t}\n\t}\n\treturn \"\", nil\n}\n\n// carryRelevantDirs are the directories whose case behaviour decides whether\n// lexical selection is sound: every existing directory on the path from the\n// root to each module and to each declared dependency, ancestors included,\n// since any of them can fold a lookup (review round 9, N26).\nfunc carryRelevantDirs(root string, modules []validationModule, meta scopeMetadata) []string {\n\tseen := map[string]bool{}\n\tdirs := []string{}\n\tadd := func(p string) {\n\t\troot := filepath.Clean(root)\n\t\tfor p = filepath.Clean(p); ; p = filepath.Dir(p) {\n\t\t\tif p != root && !strings.HasPrefix(p, root+string(filepath.Separator)) {\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif info, err := os.Stat(p); err == nil && info.IsDir() && !seen[p] {\n\t\t\t\tseen[p] = true\n\t\t\t\tdirs = append(dirs, p)\n\t\t\t}\n\t\t\tif p == root {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n\tfor _, m := range modules {\n\t\tadd(m.Abs)\n\t}\n\tfor _, module := range meta.Modules {\n\t\tfor _, dep := range module.DependsOn {\n\t\t\tadd(filepath.Join(root, filepath.FromSlash(filepath.ToSlash(filepath.Clean(dep)))))\n\t\t}\n\t}\n\tsort.Strings(dirs)\n\treturn dirs\n}\n\n// casefoldedDirectory reports whether dir looks names up without case: an\n/home/go/.local/bin/pose: go1.27.3-X:nodwarf5\n\tpath\tgithub.com/harne8/pose-mcp/cmd/pose\n\tmod\tgithub.com/harne8/pose-mcp\t(devel)\t\n\tdep\tgithub.com/cenkalti/backoff/v5\tv5.0.3\th1:ZN+IMa753KfX5hd8vVaMixjnqRZ3y8CuJKRKj1xcsSM=\n\tdep\tgithub.com/cespare/xxhash/v2\tv2.3.0\th1:UL815xU9SqsFlibzuggzjXhog7bL6oX9BbNZnL2UFvs=\n\tdep\tgithub.com/go-logr/logr\tv1.4.4\th1:tG4xh9yMsRCAiodLVTxyrkzSZ9+o0L1Kg/+cPVcbP/8=\n\tdep\tgithub.com/go-logr/stdr\tv1.2.2\th1:hSWxHoqTgW2S2qGc0LTAI563KZ5YKYRhT3MFKZMbjag=\n\tdep\tgithub.com/google/uuid\tv1.6.0\th1:NIvaJDMOsjHA8n1jAhLSgzrAzy1Hgr+hNrb57e+94F0=\n\tdep\tgithub.com/grpc-ecosystem/grpc-gateway/v2\tv2.30.0\th1:/Tnpcb2E0Pz/tN9s3bfEY2Q8ePCEX9iuS+cneUwncnw=\n\tdep\tgithub.com/harne8/mcp-enforce\tv0.0.0\n\t=>\t../mcp-enforce\t(devel)\t\n\t\n\tdep\tgithub.com/redis/go-redis/v9\tv9.22.0\th1:laDvpYXTJtZLloinw1fA5Kqd6HAEH2XKxOkG/PDq2F0=\n\tdep\tgithub.com/yuin/goldmark\tv1.8.4\th1:oat/nd3U6NeQqFEL3xpEJq7d7c86NI+DbSNGAs4xnjA=\n\tdep\tgo.opentelemetry.io/auto/sdk\tv1.2.1\th1:jXsnJ4Lmnqd11kwkBV2LgLoFMZKizbCi5fNZ/ipaZ64=\n\tdep\tgo.opentelemetry.io/otel\tv1.47.0\th1:j7ALJ/zgkS7Z6aeJW09p8VC9804bC+PpeTfCD4XPnOM=\n\tdep\tgo.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetrichttp\tv1.47.0\th1:7kszRN4Ze5GeAkUnBjBSUIunVBMA+mZIG04auueqguM=\n\tdep\tgo.opentelemetry.io/otel/exporters/otlp/otlptrace\tv1.47.0\th1:julhjPeUH/q/7hinbSdDdqt5h7Zw9YWmRlWRhI0jd54=\n\tdep\tgo.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp\tv1.47.0\th1:aXZXsZ012wOgVkqaiQv+Z/d8V0xKjmg70F6m4CE94lc=\n\tdep\tgo.opentelemetry.io/otel/log\tv1.47.0\th1:cOTS1CcLbSQeZKanGJ+0JpF/+t4PELi3O3bbl2lqCcI=\n\tdep\tgo.opentelemetry.io/otel/metric\tv1.47.0\th1:4PptaldXx3Eat1XjMZ68pPJEs5wrhlemctZE9a3UdWY=\n\tdep\tgo.opentelemetry.io/otel/sdk\tv1.47.0\th1:zWXEr4j2lFefG87TU6Yg8a7ngfohIKFZHKp0Hf5hC6I=\n\tdep\tgo.opentelemetry.io/otel/sdk/metric\tv1.47.0\th1:lfISg2j93VT6yqdk9OfUaZmw/GfcZqCCV3jdXtsPnKw=\n\tdep\tgo.opentelemetry.io/otel/trace\tv1.47.0\th1:JOjX/Oci8K94QHddo+bbfya/Ai/nf6/dt9ZfrFNWSrM=\n\tdep\tgo.opentelemetry.io/proto/otlp\tv1.11.0\th1:5rrYs0Ykyj50sdU/JU0x8etU+LubXWb+gED6TbEdMIk=\n\tdep\tgo.uber.org/atomic\tv1.11.0\th1:ZvwS0R+56ePWxUNi+Atn9dWONBPp/AUETXlHW0DxSjE=\n\tdep\tgolang.org/x/net\tv0.60.0\th1:79p50tfZlm0J9YfoDsSi639qSXNGVwEzOPLCxM2FsYU=\n\tdep\tgolang.org/x/sys\tv0.48.0\th1:bbX/i/6MgT9BVLM9RT1thmxL04yeTAhbEz4SyadbXoo=\n\tdep\tgolang.org/x/text\tv0.42.0\th1:JbOZXgfeCPU9gacVtYliJqOhD+zhrEqK4LfdpmlUZqI=\n\tdep\tgoogle.golang.org/genproto/googleapis/api\tv0.0.0-20260928230214-8a89bd6388cc\th1:rZHRz0ogq4Pid1IKtA/ivHi8XONVF5tqUQXA2TtgpkE=\n\tdep\tgoogle.golang.org/genproto/googleapis/rpc\tv0.0.0-20260928230214-8a89bd6388cc\th1:4bNTbnb44EqGVy9HaQxSY2jnafSUdgV3qHtedvNpDKg=\n\tdep\tgoogle.golang.org/grpc\tv1.83.2\th1:EManeRomTObA0BU7I8vXgg/78uE5MJ9M8B39EX2WscU=\n\tdep\tgoogle.golang.org/protobuf\tv1.36.12\th1:pJOKDDOyeXErUroCihFAd5LQuwXBSpVnKGrj5o/fwxc=\n\tbuild\t-buildmode=exe\n\tbuild\t-compiler=gc\n\tbuild\tDefaultGODEBUG=tracebacklabels=0,x509sslcertoverrideplatform=0\n\tbuild\tCGO_ENABLED=1\n\tbuild\tCGO_CFLAGS=\n\tbuild\tCGO_CPPFLAGS=\n\tbuild\tCGO_CXXFLAGS=\n\tbuild\tCGO_LDFLAGS=\n\tbuild\tGOARCH=amd64\n\tbuild\tGOEXPERIMENT=nodwarf5\n\tbuild\tGOOS=linux\n\tbuild\tGOAMD64=v1\n\tbuild\tvcs=git\n\tbuild\tvcs.revision=40019024deed61f74466cf49d64b2994b4b4f7c5\n\tbuild\tvcs.time=2026-11-17T09:23:29Z\n\tbuild\tvcs.modified=false\n","exit_code":0,"status":"completed"}}
