{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N1vozHMtsNhqfLL3BVNr3a","type":"tool_result","content":"40\t\n41\t// governanceReadViewGitState captures exact, bounded Git command results for\n42\t// one read-view operation. Repeated commands replay the first result; audit\n43\t// reruns each exact command and reports any changed or unprovable result.\n44\ttype governanceReadViewGitState struct {\n45\t\top            *governanceReadViewOperation\n46\t\tmu            sync.Mutex\n47\t\tobservations  map[string]*governanceReadViewGitObservation\n48\t\tconfigMu      sync.Mutex\n49\t\tconfigDigests map[string]string\n50\t}\n51\t\n52\t// effectiveGitConfig is the digest of `git config --list` of a root (every scope, includes\n53\t// followed), read once per operation and kept apart from the command observations: it is a key\n54\t// of the resident memo, not an input the audit replays. Empty when it could not be read.\n55\tfunc (state *governanceReadViewGitState) effectiveGitConfig(ctx context.Context, files Files, root string) string {\n56\t\tstate.configMu.Lock()\n57\t\tdefer state.configMu.Unlock()\n58\t\tif digest, ok := state.configDigests[root]; ok {\n59\t\t\treturn digest\n60\t\t}\n61\t\tdigest := \"\"\n62\t\tif out, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, []string{\"config\", \"--list\", \"-z\", \"--includes\"}, 1<<20); err == nil {\n63\t\t\tsum := sha256.Sum256(out)\n64\t\t\tdigest = hex.EncodeToString(sum[:8])\n65\t\t}\n66\t\tstate.configDigests[root] = digest\n67\t\treturn digest\n68\t}\n69\t\n70\tfunc newGovernanceReadViewGitState(op *governanceReadViewOperation) *governanceReadViewGitState {\n71\t\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}, configDigests: map[string]string{}}\n72\t}\n73\t\n74\t// captureGovernanceGit runs a Git command through the read-view generation\n75\t// when Files belongs to one. Native and preview operations retain their\n76\t// existing behavior when there is no governance view.\n77\tfunc captureGovernanceGit(files Files, root, producer string, args ...string) ([]byte, error) {\n78\t\treturn captureGovernanceGitBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n79\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"5402a783-9b03-41b4-b876-db39394d1487","timestamp":"2026-11-10T20:14:31.431Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-788625154/worktree/pose-mcp/internal/pose/governance_read_view_git.go","content":"\n// governanceReadViewGitState captures exact, bounded Git command results for\n// one read-view operation. Repeated commands replay the first result; audit\n// reruns each exact command and reports any changed or unprovable result.\ntype governanceReadViewGitState struct {\n\top            *governanceReadViewOperation\n\tmu            sync.Mutex\n\tobservations  map[string]*governanceReadViewGitObservation\n\tconfigMu      sync.Mutex\n\tconfigDigests map[string]string\n}\n\n// effectiveGitConfig is the digest of `git config --list` of a root (every scope, includes\n// followed), read once per operation and kept apart from the command observations: it is a key\n// of the resident memo, not an input the audit replays. Empty when it could not be read.\nfunc (state *governanceReadViewGitState) effectiveGitConfig(ctx context.Context, files Files, root string) string {\n\tstate.configMu.Lock()\n\tdefer state.configMu.Unlock()\n\tif digest, ok := state.configDigests[root]; ok {\n\t\treturn digest\n\t}\n\tdigest := \"\"\n\tif out, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, []string{\"config\", \"--list\", \"-z\", \"--includes\"}, 1<<20); err == nil {\n\t\tsum := sha256.Sum256(out)\n\t\tdigest = hex.EncodeToString(sum[:8])\n\t}\n\tstate.configDigests[root] = digest\n\treturn digest\n}\n\nfunc newGovernanceReadViewGitState(op *governanceReadViewOperation) *governanceReadViewGitState {\n\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}, configDigests: map[string]string{}}\n}\n\n// captureGovernanceGit runs a Git command through the read-view generation\n// when Files belongs to one. Native and preview operations retain their\n// existing behavior when there is no governance view.\nfunc captureGovernanceGit(files Files, root, producer string, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n}","numLines":40,"startLine":40,"totalLines":690}},"tool_result_meta":[{"id":"toolu_01N1vozHMtsNhqfLL3BVNr3a","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
