{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TKetpyrkhB63tJJmdAT9VB","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t\t\"testing\"\n9\t)\n10\t\n11\t// Spec pose-worktree-runtime-resident-cache.\n12\t\n13\t// R1: the memo is off by default, bounded in bytes, least recently used first, and keyed by the\n14\t// commit, the shallow state and the exact command.\n15\tfunc TestTheResidentGitMemoIsOffByDefaultBoundedAndKeyedByTheCommit(t *testing.T) {\n16\t\tif residentGit.Load() != nil {\n17\t\t\tt.Fatal(\"the resident memo is on without being asked\")\n18\t\t}\n19\t\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\"})\n20\t\tm := EnableResidentGitMemo(400)\n21\t\tdefer DisableResidentGitMemo()\n22\t\targs := []string{\"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\"}\n23\t\tk1, ok := residentGitKey(root, \"head1\", \"cfg\", args)\n24\t\tif !ok {\n25\t\t\tt.Fatal(\"a plain .git directory is not memoizable\")\n26\t\t}\n27\t\tk2, _ := residentGitKey(root, \"head2\", \"cfg\", args)\n28\t\tif k1 == k2 {\n29\t\t\tt.Fatal(\"two commits share a key\")\n30\t\t}\n31\t\tif err := os.WriteFile(filepath.Join(root, \".git\", \"shallow\"), []byte(\"x\\n\"), 0o644); err != nil {\n32\t\t\tt.Fatal(err)\n33\t\t}\n34\t\tif k3, _ := residentGitKey(root, \"head1\", \"cfg\", args); k3 == k1 {\n35\t\t\tt.Fatal(\"a shallow repository shares the key of a full one\")\n36\t\t}\n37\t\tm.put(\"a\", []byte(strings.Repeat(\"x\", 150)))\n38\t\tm.put(\"b\", []byte(strings.Repeat(\"y\", 150)))\n39\t\tif _, hit := m.get(\"a\"); !hit {\n40\t\t\tt.Fatal(\"a fresh entry missed\")\n41\t\t}\n42\t\tm.put(\"c\", []byte(strings.Repeat(\"z\", 150))) // evicts b, the least recently used\n43\t\tif _, hit := m.get(\"b\"); hit {\n44\t\t\tt.Fatal(\"the least recently used entry was kept over the budget\")\n45\t\t}\n46\t\tif _, hit := m.get(\"a\"); !hit {\n47\t\t\tt.Fatal(\"the recently used entry was evicted\")\n48\t\t}\n49\t\tif _, _, _, bytes := ResidentGitMemoStats(); bytes > 400 {\n50\t\t\tt.Fatalf(\"the memo retains %d bytes over its budget of 400\", bytes)\n51\t\t}\n52\t\tm.put(\"huge\", []byte(strings.Repeat(\"h\", 1000)))\n53\t\tif _, hit := m.get(\"huge\"); hit {\n54\t\t\tt.Fatal(\"an entry larger than the budget was retained\")\n55\t\t}\n56\t\t// The effective Git configuration is part of the key, and an unreadable one memoizes nothing.\n57\t\tif os.Remove(filepath.Join(root, \".git\", \"shallow\")) != nil {\n58\t\t\tt.Fatal(\"the shallow file the test wrote is gone\")\n59\t\t}\n60\t\tkc1, _ := residentGitKey(root, \"head1\", \"cfgA\", args)\n61\t\tkc2, _ := residentGitKey(root, \"head1\", \"cfgB\", args)\n62\t\tif kc1 == kc2 {\n63\t\t\tt.Fatal(\"two configurations share a key\")\n64\t\t}\n65\t\tif _, ok := residentGitKey(root, \"head1\", \"\", args); ok {\n66\t\t\tt.Fatal(\"an unreadable configuration was memoized\")\n67\t\t}\n68\t\t// A linked worktree (.git is a file) is not memoized.\n69\t\tlinked := t.TempDir()\n70\t\tif err := os.WriteFile(filepath.Join(linked, \".git\"), []byte(\"gitdir: elsewhere\\n\"), 0o644); err != nil {\n71\t\t\tt.Fatal(err)\n72\t\t}\n73\t\tif _, ok := residentGitKey(linked, \"h\", \"cfg\", args); ok {\n74\t\t\tt.Fatal(\"a linked worktree was memoized\")\n75\t\t}\n76\t}\n77\t\n78\t// R2: a second operation of a process with the memo on is answered from it, with the answer\n79\t// Git gives, and a new commit is a miss; the answers equal those of a process without it.\n80\tfunc TestASecondOperationIsAnsweredFromTheMemoAndANewCommitMissesIt(t *testing.T) {\n81\t\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\", \"b.md\": \"two\\n\"})\n82\t\tcapture := func() string {\n83\t\t\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n84\t\t\tstore := base.withGovernanceReadView(view, \"memo-test\")\n85\t\t\tout, err := captureGovernanceGit(store.fsys(), root, \"memo-test\", \"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\")\n86\t\t\tif err != nil {\n87\t\t\t\tt.Fatal(err)\n88\t\t\t}\n89\t\t\tif audit := view.audit(); len(audit.ChangedPaths) != 0 || audit.ChangedProducers[\"memo-test\"] {\n90\t\t\t\tt.Fatalf(\"a memoized read made the audit report a change: %+v\", audit)\n91\t\t\t}\n92\t\t\treturn strings.TrimSpace(string(out))\n93\t\t}\n94\t\twithout := capture()\n95\t\tEnableResidentGitMemo(1 << 20)\n96\t\tdefer DisableResidentGitMemo()\n97\t\tfirst, second := capture(), capture()\n98\t\tif first != without || second != without {\n99\t\t\tt.Fatalf(\"answers differ: without=%s first=%s second=%s\", without, first, second)\n100\t\t}\n101\t\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 1 {\n102\t\t\tt.Fatalf(\"hits %d misses %d, want 1 and 1\", hits, misses)\n103\t\t}\n104\t\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"one changed\\n\"), 0o644); err != nil {\n105\t\t\tt.Fatal(err)\n106\t\t}\n107\t\tsnapshotTestGit(t, root, \"add\", \"a.md\")\n108\t\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-m\", \"change a\")\n109\t\tthird := capture()\n110\t\tif third == without {\n111\t\t\tt.Fatalf(\"a new commit that changed the path returned the memoized commit %s\", third)\n112\t\t}\n113\t\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 2 {\n114\t\t\tt.Fatalf(\"after the new commit hits %d misses %d, want 1 and 2\", hits, misses)\n115\t\t}\n116\t}\n117\t\n118\t// A global Git configuration that changes what a read answers must change the key: the digest of\n119\t// the effective configuration follows a change of the user's own configuration file.\n120\tfunc TestTheEffectiveGitConfigurationFollowsTheUsersConfigurationFile(t *testing.T) {\n121\t\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\"})\n122\t\thome := t.TempDir()\n123\t\tt.Setenv(\"HOME\", home)\n124\t\tt.Setenv(\"XDG_CONFIG_HOME\", filepath.Join(home, \"xdg\"))\n125\t\tt.Setenv(\"GIT_CONFIG_NOSYSTEM\", \"1\")\n126\t\t_, view := (Store{Root: root}).beginGovernanceReadView()\n127\t\tstate := view.operation.git\n128\t\tctx := context.Background()\n129\t\tbefore := state.effectiveGitConfig(ctx, NativeFiles(), root)\n130\t\tif before == \"\" {\n131\t\t\tt.Skip(\"the effective Git configuration cannot be read here\")\n132\t\t}\n133\t\t// The test process points GIT_CONFIG_GLOBAL at a file of its own (testgit.Isolate): that is the\n134\t\t// user's configuration here.\n135\t\tuserConfig := os.Getenv(\"GIT_CONFIG_GLOBAL\")\n136\t\tif userConfig == \"\" {\n137\t\t\tuserConfig = filepath.Join(home, \".gitconfig\")\n138\t\t}\n139\t\toriginal, _ := os.ReadFile(userConfig)\n140\t\tt.Cleanup(func() { _ = os.WriteFile(userConfig, original, 0o644) })\n141\t\tif err := os.WriteFile(userConfig, append(append([]byte(nil), original...), []byte(\"\\n[log]\\n\\tfollow = true\\n\")...), 0o644); err != nil {\n142\t\t\tt.Fatal(err)\n143\t\t}\n144\t\t// A new operation reads it again; the same operation keeps the digest it took.\n145\t\tif same := state.effectiveGitConfig(ctx, NativeFiles(), root); same != before {\n146\t\t\tt.Fatal(\"the digest changed inside one operation\")\n147\t\t}\n148\t\t_, next := (Store{Root: root}).beginGovernanceReadView()\n149\t\tafter := next.operation.git.effectiveGitConfig(ctx, NativeFiles(), root)\n150\t\tif after == before {\n151\t\t\tt.Fatal(\"a change of the user's Git configuration did not change the key\")\n152\t\t}\n153\t}\n154\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"0eadb783-696a-4b6e-8c90-dd82ba62a16c","timestamp":"2026-11-10T20:14:59.929Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-788625154/worktree/pose-mcp/internal/pose/resident_git_memo_test.go","content":"package pose\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// Spec pose-worktree-runtime-resident-cache.\n\n// R1: the memo is off by default, bounded in bytes, least recently used first, and keyed by the\n// commit, the shallow state and the exact command.\nfunc TestTheResidentGitMemoIsOffByDefaultBoundedAndKeyedByTheCommit(t *testing.T) {\n\tif residentGit.Load() != nil {\n\t\tt.Fatal(\"the resident memo is on without being asked\")\n\t}\n\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\"})\n\tm := EnableResidentGitMemo(400)\n\tdefer DisableResidentGitMemo()\n\targs := []string{\"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\"}\n\tk1, ok := residentGitKey(root, \"head1\", \"cfg\", args)\n\tif !ok {\n\t\tt.Fatal(\"a plain .git directory is not memoizable\")\n\t}\n\tk2, _ := residentGitKey(root, \"head2\", \"cfg\", args)\n\tif k1 == k2 {\n\t\tt.Fatal(\"two commits share a key\")\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \".git\", \"shallow\"), []byte(\"x\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif k3, _ := residentGitKey(root, \"head1\", \"cfg\", args); k3 == k1 {\n\t\tt.Fatal(\"a shallow repository shares the key of a full one\")\n\t}\n\tm.put(\"a\", []byte(strings.Repeat(\"x\", 150)))\n\tm.put(\"b\", []byte(strings.Repeat(\"y\", 150)))\n\tif _, hit := m.get(\"a\"); !hit {\n\t\tt.Fatal(\"a fresh entry missed\")\n\t}\n\tm.put(\"c\", []byte(strings.Repeat(\"z\", 150))) // evicts b, the least recently used\n\tif _, hit := m.get(\"b\"); hit {\n\t\tt.Fatal(\"the least recently used entry was kept over the budget\")\n\t}\n\tif _, hit := m.get(\"a\"); !hit {\n\t\tt.Fatal(\"the recently used entry was evicted\")\n\t}\n\tif _, _, _, bytes := ResidentGitMemoStats(); bytes > 400 {\n\t\tt.Fatalf(\"the memo retains %d bytes over its budget of 400\", bytes)\n\t}\n\tm.put(\"huge\", []byte(strings.Repeat(\"h\", 1000)))\n\tif _, hit := m.get(\"huge\"); hit {\n\t\tt.Fatal(\"an entry larger than the budget was retained\")\n\t}\n\t// The effective Git configuration is part of the key, and an unreadable one memoizes nothing.\n\tif os.Remove(filepath.Join(root, \".git\", \"shallow\")) != nil {\n\t\tt.Fatal(\"the shallow file the test wrote is gone\")\n\t}\n\tkc1, _ := residentGitKey(root, \"head1\", \"cfgA\", args)\n\tkc2, _ := residentGitKey(root, \"head1\", \"cfgB\", args)\n\tif kc1 == kc2 {\n\t\tt.Fatal(\"two configurations share a key\")\n\t}\n\tif _, ok := residentGitKey(root, \"head1\", \"\", args); ok {\n\t\tt.Fatal(\"an unreadable configuration was memoized\")\n\t}\n\t// A linked worktree (.git is a file) is not memoized.\n\tlinked := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(linked, \".git\"), []byte(\"gitdir: elsewhere\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, ok := residentGitKey(linked, \"h\", \"cfg\", args); ok {\n\t\tt.Fatal(\"a linked worktree was memoized\")\n\t}\n}\n\n// R2: a second operation of a process with the memo on is answered from it, with the answer\n// Git gives, and a new commit is a miss; the answers equal those of a process without it.\nfunc TestASecondOperationIsAnsweredFromTheMemoAndANewCommitMissesIt(t *testing.T) {\n\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\", \"b.md\": \"two\\n\"})\n\tcapture := func() string {\n\t\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\t\tstore := base.withGovernanceReadView(view, \"memo-test\")\n\t\tout, err := captureGovernanceGit(store.fsys(), root, \"memo-test\", \"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\")\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif audit := view.audit(); len(audit.ChangedPaths) != 0 || audit.ChangedProducers[\"memo-test\"] {\n\t\t\tt.Fatalf(\"a memoized read made the audit report a change: %+v\", audit)\n\t\t}\n\t\treturn strings.TrimSpace(string(out))\n\t}\n\twithout := capture()\n\tEnableResidentGitMemo(1 << 20)\n\tdefer DisableResidentGitMemo()\n\tfirst, second := capture(), capture()\n\tif first != without || second != without {\n\t\tt.Fatalf(\"answers differ: without=%s first=%s second=%s\", without, first, second)\n\t}\n\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 1 {\n\t\tt.Fatalf(\"hits %d misses %d, want 1 and 1\", hits, misses)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"one changed\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsnapshotTestGit(t, root, \"add\", \"a.md\")\n\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-m\", \"change a\")\n\tthird := capture()\n\tif third == without {\n\t\tt.Fatalf(\"a new commit that changed the path returned the memoized commit %s\", third)\n\t}\n\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 2 {\n\t\tt.Fatalf(\"after the new commit hits %d misses %d, want 1 and 2\", hits, misses)\n\t}\n}\n\n// A global Git configuration that changes what a read answers must change the key: the digest of\n// the effective configuration follows a change of the user's own configuration file.\nfunc TestTheEffectiveGitConfigurationFollowsTheUsersConfigurationFile(t *testing.T) {\n\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\"})\n\thome := t.TempDir()\n\tt.Setenv(\"HOME\", home)\n\tt.Setenv(\"XDG_CONFIG_HOME\", filepath.Join(home, \"xdg\"))\n\tt.Setenv(\"GIT_CONFIG_NOSYSTEM\", \"1\")\n\t_, view := (Store{Root: root}).beginGovernanceReadView()\n\tstate := view.operation.git\n\tctx := context.Background()\n\tbefore := state.effectiveGitConfig(ctx, NativeFiles(), root)\n\tif before == \"\" {\n\t\tt.Skip(\"the effective Git configuration cannot be read here\")\n\t}\n\t// The test process points GIT_CONFIG_GLOBAL at a file of its own (testgit.Isolate): that is the\n\t// user's configuration here.\n\tuserConfig := os.Getenv(\"GIT_CONFIG_GLOBAL\")\n\tif userConfig == \"\" {\n\t\tuserConfig = filepath.Join(home, \".gitconfig\")\n\t}\n\toriginal, _ := os.ReadFile(userConfig)\n\tt.Cleanup(func() { _ = os.WriteFile(userConfig, original, 0o644) })\n\tif err := os.WriteFile(userConfig, append(append([]byte(nil), original...), []byte(\"\\n[log]\\n\\tfollow = true\\n\")...), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// A new operation reads it again; the same operation keeps the digest it took.\n\tif same := state.effectiveGitConfig(ctx, NativeFiles(), root); same != before {\n\t\tt.Fatal(\"the digest changed inside one operation\")\n\t}\n\t_, next := (Store{Root: root}).beginGovernanceReadView()\n\tafter := next.operation.git.effectiveGitConfig(ctx, NativeFiles(), root)\n\tif after == before {\n\t\tt.Fatal(\"a change of the user's Git configuration did not change the key\")\n\t}\n}\n","numLines":154,"startLine":1,"totalLines":154}},"tool_result_meta":[{"id":"toolu_01TKetpyrkhB63tJJmdAT9VB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
