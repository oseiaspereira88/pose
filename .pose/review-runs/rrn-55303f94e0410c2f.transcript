{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '80,120p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '215,255p' pose-mcp/internal/cli/artifact_integrity.go; rg -n 'runGovernanceGitCommandOutput|exec.Command|RawHistoryGit' pose-mcp/internal/pose/governance_read_view*.go -g '\"'!**/*test*'\"'; sed -n '660,705p' pose-mcp/internal/pose/release_lifecycle.go; rg -n 'func dedupEnv|last|duplicate' /usr/local/go/src/os/exec/exec.go\"","aggregated_output":"// streamThrough counts the bytes against the limit, keeping none, and\n// forwards them to sink.\ntype streamThrough struct {\n\tlimit   int\n\tsink    io.Writer\n\twritten int\n}\n\nfunc (w *streamThrough) Write(data []byte) (int, error) {\n\tif w.written+len(data) > w.limit {\n\t\treturn 0, fmt.Errorf(\"bounded Git output exceeded %d bytes\", w.limit)\n\t}\n\tw.written += len(data)\n\treturn w.sink.Write(data)\n}\n\n// gitOutputBoundedIn preserves the raw-history command policy while routing\n// the exact output through an operation read view when Files carries one.\nfunc gitOutputBoundedIn(files posemodel.Files, root string, limit int, args ...string) ([]byte, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n\tdefer cancel()\n\tout, err := posemodel.CaptureGovernanceRawHistoryGitContextIn(files, ctx, root, \"index.delivery-integrity\", int64(limit), args...)\n\t// The capture retains bounded stderr on ExitError. Keep that forensic cause\n\t// in collection gaps as well as the typed unknown error; never retry outside\n\t// the view or use partial stdout after a failed history read.\n\tvar exit *exec.ExitError\n\tif errors.As(err, &exit) {\n\t\tif detail := strings.TrimSpace(string(exit.Stderr)); detail != \"\" {\n\t\t\treturn nil, fmt.Errorf(\"%w: %s\", err, detail)\n\t\t}\n\t}\n\treturn out, err\n}\n\ntype limitedBuffer struct {\n\tbuf   *bytes.Buffer\n\tlimit int\n}\n\nfunc (w *limitedBuffer) Write(p []byte) (int, error) {\n\tif w.buf.Len()+len(p) > w.limit {\n\t\t}\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n\t}\n\treturn resolveGitChangeSetWithTrailersAndFiles(files, root, spec, base, head, captured)\n}\n\n// resolveGitChangeSetWithTrailers uses the operation's complete, bounded trailer\n// capture. Commit objects remain immutable inputs; no capture survives this\n// operation. Copy the slice because the returned change set belongs to its caller.\nfunc resolveGitChangeSetWithTrailers(root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\n\treturn resolveGitChangeSetWithTrailersAndFiles(nil, root, spec, base, head, captured)\n}\n\nfunc resolveGitChangeSetWithTrailersIn(files posemodel.Files, root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\n\treturn resolveGitChangeSetWithTrailersAndFiles(files, root, spec, base, head, captured)\n}\n\n// changeSetGitStream streams a raw-history read of root into a sink, through\n// the operation's read view when files carries one.\nfunc changeSetGitStream(files posemodel.Files, root string) func(limit int, sink io.Writer, args ...string) error {\n\treturn func(limit int, sink io.Writer, args ...string) error {\n\t\tif files == nil {\n\t\t\treturn gitStreamBounded(root, limit, sink, args...)\n\t\t}\n\t\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n\t\tdefer cancel()\n\t\terr := posemodel.StreamGovernanceRawHistoryGitIn(files, ctx, root, \"index.delivery-integrity\", int64(limit), sink, args...)\n\t\t// As gitOutputBoundedIn does: keep the bounded stderr as the\n\t\t// forensic cause of a failed history read.\n\t\tvar exit *exec.ExitError\n\t\tif errors.As(err, &exit) {\n\t\t\tif detail := strings.TrimSpace(string(exit.Stderr)); detail != \"\" {\n\t\t\t\treturn fmt.Errorf(\"%w: %s\", err, detail)\n\t\t\t}\n\t\t}\n\t\treturn err\n\t}\n}\n\npose-mcp/internal/pose/governance_read_view_stream_test.go:25:\tout, err := exec.Command(\"