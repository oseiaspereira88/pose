{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '260,295p' pose-mcp/internal/cli/index.go; sed -n '108,140p' pose-mcp/internal/pose/git_snapshot_integrity.go; sed -n '20,48p' pose-mcp/internal/pose/operation_git.go; sed -n '178,222p' pose-mcp/internal/pose/operation_git.go\"","aggregated_output":"func refreshDeliveryIndex(root string, data []byte, stderr io.Writer) {\n\tif posepkg.IsSealedCheckout(root) {\n\t\treturn\n\t}\n\t_ = os.MkdirAll(filepath.Join(root, \".pose\", \"indexes\"), 0o755)\n\treceipt, _, err := posepkg.Store{Root: root}.ReplaceIndexOrLegacy(\"delivery-integrity.json\", data)\n\tswitch {\n\tcase err == nil:\n\t\tif receipt.CleanupError != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose: retention of old index generations failed: \" + receipt.CleanupError.Error())\n\t\t}\n\tcase receipt.Committed:\n\t\trender(io.Discard, stderr).Failure(\"pose: the delivery index was published as generation \" + receipt.GenerationID + \", but its durability could not be confirmed: \" + err.Error() + \"; run `pose index --verify`\")\n\tdefault:\n\t\trender(io.Discard, stderr).Failure(\"pose: the delivery index was not refreshed: \" + err.Error() + \"; run `pose index`\")\n\t}\n}\nfunc snapshotGit(root string, args ...string) ([]byte, error) {\n\tcmd := gitCommand(append([]string{\"-C\", root}, args...)...)\n\t// Asking about the worktree writes nothing under .git: without this `git status` refreshes\n\t// and rewrites the index, which a governed read view that watches .git reads as an input that\n\t// changed during the operation (spec pose-git-status-leaves-the-git-directory-alone).\n\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\treturn nil, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n\t}\n\treturn out, nil\n}\n\n// gitChangedPaths uses the NUL protocol; porcelain's quoted display is not a path.\nfunc gitChangedPaths(root string) ([]string, error) {\n\tout, err := snapshotGit(root, \"status\", \"--porcelain=v1\", \"-z\", \"--untracked-files=all\", \"--ignore-submodules=none\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tentries, err := parseGitStatusEntries(out)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tpaths := make([]string, 0, len(entries)*2)\n\tfor _, entry := range entries {\n\t\tif untrackedAuthorityTransferLock(entry) {\n\t\t\tcontinue\n\t\t}\n\t\tpaths = append(paths, entry.Path)\n\t\tif entry.OrigPath != \"\" {\n\t\t\tpaths = append(paths, entry.OrigPath)\n\t\t}\n\t}\n\t\"strings\"\n)\n\n// previewGit runs a read-only git query for a preview.\nfunc previewGit(root string, args ...string) ([]byte, error) {\n\tcmd := gitCommand(append([]string{\"-C\", root}, args...)...)\n\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\treturn nil, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n\t}\n\treturn out, nil\n}\n\n// pathspecCovers reports whether a literal pathspec list selects path.\nfunc pathspecCovers(pathspecs []string, path string) bool {\n\tif len(pathspecs) == 0 {\n\t\treturn true\n\t}\n\tfor _, spec := range pathspecs {\n\t\tspec = strings.TrimSuffix(filepath.ToSlash(spec), \"/\")\n\t\tif spec == \"\" || spec == \".\" || path == spec || strings.HasPrefix(path, spec+\"/\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\ntype indexEntry struct{ mode, object string }\nfunc gitCheckIgnore(root string, paths []string) (map[string]bool, error) {\n\tcmd := gitCommand(\"-C\", root, \"check-ignore\", \"-z\", \"--stdin\")\n\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n\tcmd.Stdin = bytes.NewReader([]byte(strings.Join(paths, \"\\x00\") + \"\\x00\"))\n\tout, err := cmd.Output()\n\tignored := map[string]bool{}\n\tif err != nil {\n\t\t// Exit status 1 means none is ignored.\n\t\tif exit, ok := err.(interface{ ExitCode() int }); ok && exit.ExitCode() == 1 {\n\t\t\treturn ignored, nil\n\t\t}\n\t\treturn nil, &GitSnapshotError{Operation: \"check-ignore\", Cause: err}\n\t}\n\tfor _, path := range strings.Split(string(out), \"\\x00\") {\n\t\tif path != \"\" {\n\t\t\tignored[filepath.ToSlash(path)] = true\n\t\t}\n\t}\n\treturn ignored, nil\n}\n\n// projectGitIgnored adds the staged entries the repository's ignore rules\n// exclude to what `git ls-files --others --ignored --directory` reported for\n// the original tree: the update creates them, and git then lists them.\nfunc projectGitIgnored(p *PreviewFiles, root string, ignored map[string]bool) {\n\tcandidates := []string{}\n\tfor _, change := range p.Changes(root) {\n\t\tif !change.Outside && strings.HasPrefix(change.Verb, \"create\") {\n\t\t\tcandidates = append(candidates, change.Path)\n\t\t}\n\t}\n\tif len(candidates) == 0 {\n\t\treturn\n\t}\n\texcluded, err := gitCheckIgnore(root, candidates)\n\tif err != nil {\n\t\tp.Incomplete(\"the ignore rules for paths the update creates could not be read: \" + err.Error())\n\t\treturn\n\t}\n\tfor path := range excluded {\n\t\tignored[path] = true\n\t\tignored[path+\"/\"] = true\n\t}\n}\n","exit_code":0,"status":"completed"}}
