95\t\t\t}\n  1196\t\t}\n  1197\t\tif !stopped {\n  1198\t\t\treturn 1\n  1199\t\t}\n  1200\t\treturn 0\n  1201\t}\n  1202\t\n  1203\t// withDelegationLosses names what the listing could not read beside a run it\n  1204\t// did not find running: the run may be the one an unreadable marker hides.\n  1205\tfunc withDelegationLosses(err error, lost []string) error {\n  1206\t\tif len(lost) == 0 {\n  1207\t\t\treturn err\n  1208\t\t}\n  1209\t\treturn fmt.Errorf(\"%w (%s %s)\", err, tr(\"unread:\", \"não lido:\"), strings.Join(lost, \"; \"))\n  1210\t}\n  1211\t\n  1212\t// delegateAgentRow is one line of pose delegate agents (R14).\n  1213\ttype delegateAgentRow struct {\n  1214\t\tName              string   `json:\"name\"`\n  1215\t\tVendor            string   `json:\"vendor\"`\n  1216\t\tModel             string   `json:\"model\"`\n  1217\t\tCLI               string   `json:\"cli\"`\n  1218\t\tOnPath            bool     `json:\"on_path\"`\n  1219\t\tAccess            []string `json:\"access\"`\n  1220\t\tEvents            string   `json:\"events\"`\n  1221\t\tLimitResetAt      string   `json:\"limit_reset_at,omitempty\"`\n  1222\t\tLimited           bool     `json:\"limited\"`\n  1223\t\tState             string   `json:\"state\"`\n  1224\t\tLimitedUntil      string   `json:\"limited_until,omitempty\"`\n  1225\t\tDetail            string   `json:\"detail,omitempty\"`\n     1\tpackage pose\n     2\t\n     3\t// The trusted-process backend bounds engine capture, not the adapter's address\n     4\t// space or filesystem. Capabilities describe enforcement, never configuration.\n     5\timport (\n     6\t\t\"bytes\"\n     7\t\t\"context\"\n     8\t\t\"encoding/json\"\n     9\t\t\"errors\"\n    10\t\t\"fmt\"\n    11\t\t\"io\"\n    12\t\t\"io/fs\"\n    13\t\t\"os\"\n    14\t\t\"path/filepath\"\n    15\t\t\"regexp\"\n    16\t\t\"runtime\"\n    17\t\t\"sort\"\n    18\t\t\"strings\"\n    19\t\t\"sync\"\n    20\t\t\"time\"\n    21\t\t\"unicode/utf8\"\n    22\t)\n    23\t\n    24\tconst ReviewNotesMaxBytes = 16 << 10\n    25\t\n    26\t// ReviewerContainment is optional schema-1 adapter policy. Pointers distinguish\n    27\t// omitted finite defaults from explicit zero, which is invalid for byte limits.\n    28\ttype ReviewerContainment struct {\n    29\t\tSchemaVersion       int      `json:\"schema_version\"`\n    30\t\tProfile             string   `json:\"profile\"`\n    31\t\tRequired            []string `json:\"required,omitempty\"`\n    32\t\tEnvironment         []string `json:\"environment,omitempty\"`\n    33\t\tCredentials         []string `json:\"credentials,omitempty\"`\n    34\t\tStreamBytes         *int64   `json:\"stream_bytes,omitempty\"`\n    35\t\tOutputBytes         *int64   `json:\"output_bytes,omitempty\"`\n    36\t\tRetainedBytes       *int64   `json:\"retained_bytes,omitempty\"`\n    37\t\tRetentionTTLSeconds int64    `json:\"retention_ttl_seconds\"`\n    38\t\tMemoryBytes         *int64   `json:\"memory_bytes,omitempty\"`\n    39\t\tCPUTimeMS           *int64   `json:\"cpu_time_ms,omitempty\"`\n    40\t}\n    41\t\n    42\t// UnmarshalJSON refuses misspelled enforcement fields instead of dropping them.\n    43\tfunc (p *ReviewerContainment) UnmarshalJSON(raw []byte) error {\n    44\t\tvar fields map[string]json.RawMessage\n    45\t\tif err := json.Unmarshal(raw, &fields); err != nil {\n    46\t\t\treturn err\n    47\t\t}\n    48\t\tfor name, value := range fields {\n    49\t\t\tif bytes.Equal(bytes.TrimSpace(value), []byte(\"null\")) {\n    50\t\t\t\treturn fmt.Errorf(\"containment field %s cannot be null; omit optional fields for defaults\", name)\n    51\t\t\t}\n    52\t\t}\n    53\t\ttype plain ReviewerContainment\n    54\t\tvar decoded plain\n    55\t\td := json.NewDecoder(bytes.NewReader(raw))\n    56\t\td.DisallowUnknownFields()\n    57\t\tif err := d.Decode(&decoded); err != nil {\n    58\t\t\treturn err\n    59\t\t}\n    60\t\t*p = ReviewerContainment(decoded)\n    61\t\treturn nil\n    62\t}\n    63\t\n    64\t// ReviewExecutionSafety is retained with the exact run and covered by its hash,\n    65\t// witness and optional native signature. No environment values are exported.\n    66\ttype ReviewExecutionSafety struct {\n    67\t\tSchemaVersion   int               `json:\"schema_version\"`\n    68\t\tProfile         string            `json:\"profile\"`\n    69\t\tPlatform        string            `json:\"platform\"`\n    70\t\tCapabilities    map[string]string `json:\"capabilities\"`\n    71\t\tLimitations     []string          `json:\"limitations\"`\n    72\t\tStreamBytes     int64             `json:\"stream_bytes\"`\n    73\t\tOutputBytes     int64             `json:\"output_bytes\"`\n    74\t\tRetainedBytes   int64             `json:\"retained_bytes\"`\n    75\t\tTimeoutMS       int64             `json:\"timeout_ms\"`\n    76\t\tMaxRuns         int               `json:\"max_runs_per_bundle\"`\n    77\t\tRetention       string            `json:\"retention\"`\n    78\t\tCaptureComplete bool              `json:\"capture_complete\"`\n    79\t\tRuntimeID       string            `json:\"runtime_id,omitempty\"`\n    80\t\tExecutionCause  string            `json:\"execution_cause,omitempty\"`\n    81\t\tOperation       OperationResult   `json:\"operation\"`\n    82\t}\n    83\t\n    84\tvar adapterEnvironmentName = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\n    85\t\n    86\tfunc effectiveReviewMaxRuns(a ReviewerAdapter) int {\n    87\t\tif a.MaxRunsPerBundle == 0 {\n    88\t\t\treturn 3\n    89\t\t}\n    90\t\treturn a.MaxRunsPerBundle\n    91\t}\n    92\t\n    93\t// ResolveReviewerContainment is shared by preview, execution and consumers.\n    94\t// It makes no changes, including attempt reservations.\n    95\tfunc ResolveReviewerContainment(a ReviewerAdapter) (*ReviewExecutionSafety, error) {\n    96\t\tsafety, err := resolveReviewerContainment(a)\n    97\t\treturn safety, refusal(DelegationReasonContainment, err)\n    98\t}\n    99\t\n   100\tfunc resolveReviewerContainment(a ReviewerAdapter) (*ReviewExecutionSafety, error) {\n   101\t\tfor _, identity := range []string{a.Vendor, a.Model} {\n   102\t\t\tif strings.TrimSpace(identity) == \"\" || strings.ContainsAny(identity, \"\\x00\\r\\n\") {\n   103\t\t\t\treturn nil, fmt.Errorf(\"adapter identity must be nonempty without surrounding whitespace\")\n   104\t\t\t}\n   105\t\t}\n   106\t\tif len(a.Command) == 0 || strings.TrimSpace(a.Command[0]) == \"\" || strings.TrimSpace(a.Command[0]) != a.Command[0] {\n   107\t\t\treturn nil, fmt.Errorf(\"adapter argv requires a nonempty executable\")\n   108\t\t}\n   109\t\tfor _, arg := range a.Command {\n   110\t\t\tif strings.ContainsRune(arg, 0) {\n   111\t\t\t\treturn nil, fmt.Errorf(\"adapter argv contains NUL\")\n   112\t\t\t}\n   113\t\t}\n   114\t\tif a.Executor != \"\" && (strings.TrimSpace(a.Executor) != a.Executor || !strings.HasPrefix(a.Executor, \"agent:\") || strings.TrimSpace(strings.TrimPrefix(a.Executor, \"agent:\")) == \"\") {\n   115\t\t\treturn nil, fmt.Errorf(\"adapter executor identity is invalid\")\n   116\t\t}\n   117\t\tif a.MaxRunsPerBundle < 0 || a.MaxRunsPerBundle > 100 {\n   118\t\t\treturn nil, fmt.Errorf(\"max_runs_per_bundle must be 1..100 when present (omitted defaults to 3)\")\n   119\t\t}\n   120\t\ttimeout := time.Hour\n   121\t\tif a.Timeout != \"\" {\n   122\t\t\tvar err error\n   123\t\t\ttimeout, err = time.ParseDuration(a.Timeout)\n   124\t\t\tif err != nil || timeout < time.Millisecond || timeout > 24*time.Hour || strings.TrimSpace(a.Timeout) != a.Timeout {\n   125\t\t\t\treturn nil, fmt.Errorf(\"adapter timeout must be a positive duration up to 24h\")\n   126\t\t\t}\n   127\t\t}\n   128\t\tr := &ReviewExecutionSafety{SchemaVersion: 1, Profile: \"legacy-trusted\", Platform: runtime.GOOS + \"/\" + runtime.GOARCH, StreamBytes: 8 << 20, OutputBytes: 64 << 10, RetainedBytes: 16 << 20, TimeoutMS: timeout.Milliseconds(), MaxRuns: effectiveReviewMaxRuns(a), Retention: \"retain-evidence; ttl=0; no automatic deletion\", Capabilities: map[string]string{\n   129\t\t\t\"bounded-capture\": \"available\", \"environment-allowlist\": \"available\", \"parent-termination\": \"available\", \"process-group-termination\": \"unsupported\", \"filesystem-isolation\": \"unavailable\", \"origin-isolation\": \"unavailable\", \"shared-git-isolation\": \"unavailable\", \"network-isolation\": \"unavailable\", \"credential-filesystem-isolation\": \"unavailable\", \"escaped-descendant-termination\": \"unavailable\", \"memory-limit\": \"unavailable\", \"cpu-limit\": \"unavailable\", \"automatic-expiry\": \"unavailable\",\n   130\t\t}, Limitations: []string{\"trusted local executable required; worktree is not a sandbox\", \"outside writes, transient writes, shared Git and credential files are not isolated\", \"no memory/CPU quota or control of descendants escaping the process group\", \"cleanup filesystem calls remain subject to operating-system I/O latency\"}}\n   131\t\tif runtime.GOOS == \"linux\" {\n   132\t\t\tif err := reviewProcessGroupAvailable(); err == nil {\n   133\t\t\t\tr.Capabilities[\"process-group-termination\"] = \"available\"\n   134\t\t\t\t// A descendant that left the group is still ended while its\n   135\t\t\t\t// environment keeps the run's sealed-checkout entry; one that\n   136\t\t\t\t// clears it is not, so the guarantee is not \"available\" (spec\n   137\t\t\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, L1).\n   138\t\t\t\tr.Capabilities[\"escaped-descendant-termination\"] = \"environment-marked\"\n   139\t\t\t\tfor i, limit := range r.Limitations {\n   140\t\t\t\t\tif limit == \"no memory/CPU quota or control of descendants escaping the process group\" {\n   141\t\t\t\t\t\tr.Limitations[i] = \"no memory/CPU quota; descendants escaping the process group are ended only while they keep the run's sealed-checkout environment entry\"\n   142\t\t\t\t\t}\n   143\t\t\t\t}\n   144\t\t\t} else {\n   145\t\t\t\tr.Capabilities[\"process-group-termination\"] = \"unavailable\"\n   146\t\t\t\tr.Limitations = append(r.Limitations, \"process inventory not observable on this host\")\n   147\t\t\t}\n   148\t\t} else {\n   149\t\t\tr.Limitations = append(r.Limitations, \"process-group termination not qualified on this platform\")\n   150\t\t}\nnl: pose-mcp/internal/pose/review_adapter_containment_linux.go: No such file or directory\n","exit_code":0,"status":"completed"}}
