 limit.value != nil {\n   167\t\t\t\tif *limit.value <= 0 || *limit.value > limit.max {\n   168\t\t\t\t\treturn nil, fmt.Errorf(\"%s must be 1..%d bytes\", limit.name, limit.max)\n   169\t\t\t\t}\n   170\t\t\t\t*limit.target = *limit.value\n   171\t\t\t}\n   172\t\t}\n   173\t\tif r.RetainedBytes < r.StreamBytes+6*r.OutputBytes+(1<<20) {\n   174\t\t\treturn nil, fmt.Errorf(\"retained_bytes must cover stream_bytes + 6*output_bytes + 1048576 bytes of record overhead\")\n   175\t\t}\n   176\t\tif p.RetentionTTLSeconds != 0 {\n   177\t\t\treturn nil, fmt.Errorf(\"automatic retention expiry unavailable; retention_ttl_seconds must be 0 (retain evidence)\")\n   178\t\t}\n   179\t\tif p.MemoryBytes != nil || p.CPUTimeMS != nil {\n   180\t\t\treturn nil, fmt.Errorf(\"memory/CPU enforcement unavailable in trusted-process; omit memory_bytes/cpu_time_ms\")\n   181\t\t}\n   182\t\tfor _, capability := range p.Required {\n   183\t\t\tstate, ok := r.Capabilities[capability]\n   184\t\t\tif !ok || state != \"available\" {\n   185\t\t\t\treturn nil, fmt.Errorf(\"required capability %q unsupported/unavailable on %s; select a qualified backend or remove that requirement\", capability, r.Platform)\n   186\t\t\t}\n   187\t\t}\n   188\t\tif len(p.Environment) > 128 || len(p.Credentials) > 32 {\n   189\t\t\treturn nil, fmt.Errorf(\"environment allowlist exceeds 128 names or 32 credential names\")\n   190\t\t}\n   191\t\tseen := map[string]bool{}\n   192\t\tfor _, name := range append(append([]string{}, p.Environment...), p.Credentials...) {\n   193\t\t\tif len(name) > 128 || !adapterEnvironmentName.MatchString(name) || seen[strings.ToUpper(name)] {\n   194\t\t\t\treturn nil, fmt.Errorf(\"environment/credentials require unique valid variable names\")\n   195\t\t\t}\n   196\t\t\tupper := strings.ToUpper(name)\n   197\t\t\tseen[upper] = true\n   198\t\t\t// Loader hooks can turn a trusted binary into an unrelated executable.\n   199\t\t\tif strings.HasPrefix(upper, \"LD_\") || strings.HasPrefix(upper, \"DYLD_\") || strings.HasPrefix(upper, \"GIT_\") || upper == \"BASH_ENV\" || upper == \"ENV\" || upper == \"SHELLOPTS\" || upper == \"HOME\" || upper == \"USERPROFILE\" || upper == \"TMPDIR\" || upper == \"TMP\" || upper == \"TEMP\" {\n   200\t\t\t\treturn nil, fmt.Errorf(\"environment variable %s is reserved or unsafe\", name)\n   201\t\t\t}\n   202\t\t}\n   203\t\tfor _, name := range p.Environment {\n   204\t\t\tupper := strings.ToUpper(name)\n   205\t\t\tfor _, mark := range []string{\"TOKEN\", \"SECRET\", \"PASSWORD\", \"CREDENTIAL\", \"API_KEY\", \"PRIVATE_KEY\"} {\n   206\t\t\t\tif strings.Contains(upper, mark) {\n   207\t\t\t\t\treturn nil, fmt.Errorf(\"sensitive environment variable %s requires credentials authorization\", name)\n   208\t\t\t\t}\n   209\t\t\t}\n   210\t\t}\n   211\t\treturn r, nil\n   212\t}\n   213\t\n   214\tfunc validateExplicitReviewBudget(raw []byte) error {\n   215\t\tvar policy struct {\n   216\t\t\tAdapters map[string]map[string]json.RawMessage `json:\"adapters\"`\n   217\t\t}\n   218\t\tif err := json.Unmarshal(raw, &policy); err != nil {\n   219\t\t\treturn err\n   220\t\t}\n   221\t\tfor name, a := range policy.Adapters {\n   222\t\t\tif value, ok := a[\"max_runs_per_bundle\"]; ok {\n   223\t\t\t\tvar n int\n   224\t\t\t\tif bytes.Equal(bytes.TrimSpace(value), []byte(\"null\")) || json.Unmarshal(value, &n) != nil || n <= 0 || n > 100 {\n   225\t\t\t\t\treturn fmt.Errorf(\"adapter %s: explicit max_runs_per_bundle must be 1..100; omit for default 3\", name)\n   226\t\t\t\t}\n   227\t\t\t}\n   228\t\t}\n   229\t\treturn nil\n   230\t}\npose-mcp/internal/pose/review_adapter_containment_regression_test.go:298:// ended with the run, and the guarantee is disclosed as environment-marked,\npose-mcp/internal/pose/review_adapter_containment_regression_test.go:316:\tif f.run.Status != ReviewRunCompleted || f.run.Safety.Capabilities[\"escaped-descendant-termination\"] != \"environment-marked\" {\npose-mcp/internal/pose/review_adapter_containment_regression_test.go:317:\t\tt.Fatal(\"escaped-process termination was not disclosed as environment-marked\", f.run.Failure, f.run.Safety)\npose-mcp/internal/pose/review_adapter_containment.go:129:\t\t\"bounded-capture\": \"available\", \"environment-allowlist\": \"available\", \"parent-termination\": \"available\", \"process-group-termination\": \"unsupported\", \"filesystem-isolation\": \"unavailable\", \"origin-isolation\": \"unavailable\", \"shared-git-isolation\": \"unavailable\", \"network-isolation\": \"unavailable\", \"credential-filesystem-isolation\": \"unavailable\", \"escaped-descendant-termination\": \"unavailable\", \"memory-limit\": \"unavailable\", \"cpu-limit\": \"unavailable\", \"automatic-expiry\": \"unavailable\",\npose-mcp/internal/pose/review_adapter_containment.go:138:\t\t\tr.Capabilities[\"escaped-descendant-termination\"] = \"environment-marked\"\npose-mcp/internal/pose/review_adapter_containment_test.go:45:\tfor _, capability := range []string{\"filesystem-isolation\", \"origin-isolation\", \"shared-git-isolation\", \"network-isolation\", \"credential-filesystem-isolation\", \"escaped-descendant-termination\", \"memory-limit\", \"cpu-limit\", \"automatic-expiry\"} {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_36","type":"agent_message","text":"The shim keeps cleanup inside a dedicated child process, and the release path refuses a live owner and records failed runs idempotently. I found two areas to resolve: the manual still describes environment matching as part of the normal Linux cleanup, and the shim caps its report reader at 64 KiB while the reaper can report an unbounded PID list. I’m validating those against the tests and the rest of the dispatch flow."}}
