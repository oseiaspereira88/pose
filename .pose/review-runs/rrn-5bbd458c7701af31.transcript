{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_active.go | sed -n '1,340p' && rg -n 'delegationMarkerSilent|HeartbeatInterval|heartbeat' pose-mcp/internal/pose/delegation_active.go pose-mcp/internal/pose\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Active delegated runs and cancellation (spec pose-delegation-surface R13).\n     4\t//\n     5\t// A run's record is written when it ends, so a running run is known only by a\n     6\t// private marker its process writes when the attempt starts and removes when\n     7\t// the record is published. The marker names the process the way a start lock\n     8\t// does, so a reader can tell a running owner from a dead one. Cancelling\n     9\t// writes a request beside the marker; the running process watches for it,\n    10\t// stops the agent and records the run failed with the cause cancelled. The\n    11\t// attempt stays consumed: cancelling never returns budget.\n    12\t\n    13\timport (\n    14\t\t\"context\"\n    15\t\t\"crypto/rand\"\n    16\t\t\"encoding/hex\"\n    17\t\t\"encoding/json\"\n    18\t\t\"errors\"\n    19\t\t\"fmt\"\n    20\t\t\"os\"\n    21\t\t\"path/filepath\"\n    22\t\t\"sort\"\n    23\t\t\"strings\"\n    24\t\t\"sync\"\n    25\t\t\"sync/atomic\"\n    26\t\t\"time\"\n    27\t)\n    28\t\n    29\tconst delegationActiveDir = reviewPrivateDir + \"/active\"\n    30\t\n    31\t// DelegationActiveRun is the marker of a run in progress.\n    32\ttype DelegationActiveRun struct {\n    33\t\tSchemaVersion int    `json:\"schema_version\"`\n    34\t\tAttemptID     string `json:\"attempt_id\"`\n    35\t\t// RunToken names this run of the attempt: a cancellation request carries\n    36\t\t// it, so a request meant for one run never stops another.\n    37\t\tRunToken  string         `json:\"run_token\"`\n    38\t\tResumes   string         `json:\"resumes,omitempty\"`\n    39\t\tLabel     string         `json:\"label,omitempty\"`\n    40\t\tPurpose   string         `json:\"purpose\"`\n    41\t\tAgent     string         `json:\"agent\"`\n    42\t\tScope     string         `json:\"scope\"`\n    43\t\tBundleID  string         `json:\"bundle_id\"`\n    44\t\tStartedAt string         `json:\"started_at\"`\n    45\t\tOwner     StartLockOwner `json:\"owner\"`\n    46\t\t// HeartbeatAt is rewritten every HeartbeatEvery seconds by the process\n    47\t\t// that runs the attempt (spec pose-delegated-review-completion-signal R4,\n    48\t\t// D2).\n    49\t\tHeartbeatAt    string `json:\"heartbeat_at,omitempty\"`\n    50\t\tHeartbeatEvery int    `json:\"heartbeat_every,omitempty\"`\n    51\t\t// StalledAt is computed by the reader from the stall claim the first\n    52\t\t// reader that found the run stalled published.\n    53\t\tStalledAt string `json:\"stalled_at,omitempty\"`\n    54\t\t// Liveness is computed by the reader: owner-active, owner-dead or owner-unknown.\n    55\t\tLiveness string `json:\"liveness,omitempty\"`\n    56\t\tDetail   string `json:\"detail,omitempty\"`\n    57\t\t// CancelRequested is computed by the reader.\n    58\t\tCancelRequested bool `json:\"cancel_requested,omitempty\"`\n    59\t\t// Round is the review round the run reviews (spec\n    60\t\t// pose-delegated-review-round-protocol R1).\n    61\t\tRound int `json:\"round,omitempty\"`\n    62\t}\n    63\t\n    64\tfunc (s Store) delegationActiveDir(create bool) (string, error) {\n    65\t\tif create {\n    66\t\t\tif _, err := ensureReviewArtifactDir(s.Root, reviewPrivateDir, true); err != nil {\n    67\t\t\t\treturn \"\", err\n    68\t\t\t}\n    69\t\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewPrivateDir))\n    70\t\t\tignore := filepath.Join(dir, \".gitignore\")\n    71\t\t\tif _, err := os.Lstat(ignore); errors.Is(err, os.ErrNotExist) {\n    72\t\t\t\tif err := PublishFile(ignore, []byte(\"*\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil && !errors.Is(err, os.ErrExist) {\n    73\t\t\t\t\treturn \"\", err\n    74\t\t\t\t}\n    75\t\t\t}\n    76\t\t}\n    77\t\treturn ensureReviewArtifactDir(s.Root, delegationActiveDir, create)\n    78\t}\n    79\t\n    80\tfunc validAttemptFileName(attempt string) bool {\n    81\t\treturn attempt != \"\" && len(attempt) <= 128 && !strings.ContainsAny(attempt, `/\\.`+\"\\x00\")\n    82\t}\n    83\t\n    84\t// markDelegationActive writes the marker and starts the cancellation watcher.\n    85\t// The returned stop removes both; cancelled reports whether a cancellation\n    86\t// request stopped the run.\n    87\t//\n    88\t// stop(true) stops the watcher and the heartbeat but keeps the marker: a run\n    89\t// whose record was not published leaves it, and it turns stalled once its\n    90\t// process is gone (spec pose-delegated-review-completion-signal R4, R5).\n    91\tfunc (s Store) markDelegationActive(run ReviewRun, cancel context.CancelFunc) (stop func(keepMarker ...bool), cancelled *atomic.Bool, err error) {\n    92\t\tcancelled = &atomic.Bool{}\n    93\t\tif !validAttemptFileName(run.AttemptID) {\n    94\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: attempt %q cannot name an active marker\", run.AttemptID)\n    95\t\t}\n    96\t\tdir, err := s.delegationActiveDir(true)\n    97\t\tif err != nil {\n    98\t\t\treturn func(...bool) {}, cancelled, err\n    99\t\t}\n   100\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + run.AttemptID, Worktree: s.Root, Operation: \"pose delegate \" + run.Purpose, PID: os.Getpid(), AcquiredAt: run.StartedAt}\n   101\t\towner.Host, _ = os.Hostname()\n   102\t\tidentifyStartLockProcess(&owner)\n   103\t\ttoken := make([]byte, 16)\n   104\t\tif _, err := rand.Read(token); err != nil {\n   105\t\t\treturn func(...bool) {}, cancelled, err\n   106\t\t}\n   107\t\tevery := delegationHeartbeatEvery\n   108\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: run.AttemptID, RunToken: hex.EncodeToString(token), Resumes: run.Resumes, Label: run.Label, Purpose: run.Purpose, Agent: run.Adapter, Scope: run.Scope, BundleID: run.BundleID, StartedAt: run.StartedAt, Owner: owner, Round: run.Round,\n   109\t\t\tHeartbeatAt: time.Now().UTC().Format(time.RFC3339Nano), HeartbeatEvery: int(every / time.Second)}\n   110\t\traw, _ := json.MarshalIndent(marker, \"\", \"  \")\n   111\t\tpath := filepath.Join(dir, run.AttemptID+\".json\")\n   112\t\trequest := cancelRequestPath(dir, marker)\n   113\t\tif err := PublishFile(path, append(raw, '\\n'), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n   114\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: another run of attempt %s is active: %w\", run.AttemptID, err)\n   115\t\t}\n   116\t\tdone, exited := make(chan struct{}), make(chan struct{})\n   117\t\tgo func() {\n   118\t\t\tdefer close(exited)\n   119\t\t\tticker := time.NewTicker(250 * time.Millisecond)\n   120\t\t\tdefer ticker.Stop()\n   121\t\t\theartbeat := time.NewTicker(every)\n   122\t\t\tdefer heartbeat.Stop()\n   123\t\t\tfor {\n   124\t\t\t\tselect {\n   125\t\t\t\tcase <-done:\n   126\t\t\t\t\treturn\n   127\t\t\t\tcase <-heartbeat.C:\n   128\t\t\t\t\t// Select picks among ready cases at random: once stop has\n   129\t\t\t\t\t// asked, no further heartbeat starts, so it waits for at\n   130\t\t\t\t\t// most the one in flight (review round 1, HB01).\n   131\t\t\t\t\tselect {\n   132\t\t\t\t\tcase <-done:\n   133\t\t\t\t\t\treturn\n   134\t\t\t\t\tdefault:\n   135\t\t\t\t\t}\n   136\t\t\t\t\tbeatDelegationMarker(path, marker.RunToken)\n   137\t\t\t\tcase <-ticker.C:\n   138\t\t\t\t\tif _, err := os.Lstat(request); err == nil {\n   139\t\t\t\t\t\tcancelled.Store(true)\n   140\t\t\t\t\t\tcancel()\n   141\t\t\t\t\t\treturn\n   142\t\t\t\t\t}\n   143\t\t\t\t}\n   144\t\t\t}\n   145\t\t}()\n   146\t\tvar once sync.Once\n   147\t\tstop = func(keepMarker ...bool) {\n   148\t\t\tonce.Do(func() {\n   149\t\t\t\tclose(done)\n   150\t\t\t\tdelegationStopRequested()\n   151\t\t\t\t// A heartbeat in flight finishes before the marker goes, so it\n   152\t\t\t\t// cannot rename a new one into place after the removal (spec\n   153\t\t\t\t// pose-delegation-marker-stop-joins-heartbeat R1).\n   154\t\t\t\t<-exited\n   155\t\t\t\t_ = os.Remove(request)\n   156\t\t\t\tif len(keepMarker) == 0 || !keepMarker[0] {\n   157\t\t\t\t\t_ = os.Remove(path)\n   158\t\t\t\t}\n   159\t\t\t})\n   160\t\t}\n   161\t\treturn stop, cancelled, nil\n   162\t}\n   163\t\n   164\t// delegationStopRequested is a test seam called once stop has asked the\n   165\t// watcher to end, before it waits for it.\n   166\tvar delegationStopRequested = func() {}\n   167\t\n   168\t// delegationHeartbeatEvery is the interval a running attempt declares.\n   169\tvar delegationHeartbeatEvery = 10 * time.Second\n   170\t\n   171\t// beatDelegationMarker rewrites the heartbeat of the marker run token names,\n   172\t// by compare-and-swap: a marker already recorded stalled, or replaced by\n   173\t// another run, is left as it is.\n   174\tfunc beatDelegationMarker(path, token string) {\n   175\t\traw, err := readLedgerRaw(path)\n   176\t\tif err != nil {\n   177\t\t\treturn\n   178\t\t}\n   179\t\tvar marker DelegationActiveRun\n   180\t\tif json.Unmarshal(raw, &marker) != nil || marker.RunToken != token {\n   181\t\t\treturn\n   182\t\t}\n   183\t\tmarker.HeartbeatAt = time.Now().UTC().Format(time.RFC3339Nano)\n   184\t\tnext, _ := json.MarshalIndent(marker, \"\", \"  \")\n   185\t\t_ = PublishFile(path, append(next, '\\n'), 0600, PublishAuthoritative, ExpectBytes(raw, true))\n   186\t}\n   187\t\n   188\t// delegationMarkerSilent reports a heartbeat older than three intervals.\n   189\tfunc delegationMarkerSilent(marker DelegationActiveRun, now time.Time) bool {\n   190\t\tevery := time.Duration(marker.HeartbeatEvery) * time.Second\n   191\t\tif every <= 0 {\n   192\t\t\tevery = delegationHeartbeatEvery\n   193\t\t}\n   194\t\tlast := marker.HeartbeatAt\n   195\t\tif last == \"\" {\n   196\t\t\tlast = marker.StartedAt\n   197\t\t}\n   198\t\tat, err := time.Parse(time.RFC3339Nano, last)\n   199\t\treturn err == nil && now.Sub(at) > 3*every\n   200\t}\n   201\t\n   202\t// stallClaimPath names the claim that records a run stalled.\n   203\tfunc stallClaimPath(dir string, marker DelegationActiveRun) string {\n   204\t\treturn filepath.Join(dir, marker.AttemptID+\".\"+marker.RunToken+\".stalled\")\n   205\t}\n   206\t\n   207\tfunc readDelegationStall(dir string, marker DelegationActiveRun) string {\n   208\t\traw, err := readLedgerRaw(stallClaimPath(dir, marker))\n   209\t\tif err != nil {\n   210\t\t\treturn \"\"\n   211\t\t}\n   212\t\treturn strings.TrimSpace(string(raw))\n   213\t}\n   214\t\n   215\t// recordDelegationStall publishes the stall claim exclusively: the first\n   216\t// reader's instant is the one every reader returns, so concurrent readers\n   217\t// agree (R4).\n   218\tfunc recordDelegationStall(dir string, marker DelegationActiveRun) string {\n   219\t\tat := time.Now().UTC().Format(time.RFC3339Nano)\n   220\t\t_ = PublishFile(stallClaimPath(dir, marker), []byte(at+\"\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n   221\t\treturn readDelegationStall(dir, marker)\n   222\t}\n   223\t\n   224\tfunc cancelRequestPath(dir string, marker DelegationActiveRun) string {\n   225\t\treturn filepath.Join(dir, marker.AttemptID+\".\"+marker.RunToken+\".cancel\")\n   226\t}\n   227\t\n   228\tfunc validRunToken(token string) bool {\n   229\t\tif len(token) != 32 {\n   230\t\t\treturn false\n   231\t\t}\n   232\t\t_, err := hex.DecodeString(token)\n   233\t\treturn err == nil\n   234\t}\n   235\t\n   236\t// ListDelegationActive reads the markers with the liveness of their owners,\n   237\t// and returns as losses the markers it cannot read: a run it cannot observe is\n   238\t// reported, never listed as running nor left out in silence.\n   239\tfunc (s Store) ListDelegationActive() ([]DelegationActiveRun, []string, error) {\n   240\t\tdir, err := s.delegationActiveDir(false)\n   241\t\tif errors.Is(err, os.ErrNotExist) {\n   242\t\t\treturn []DelegationActiveRun{}, nil, nil\n   243\t\t}\n   244\t\tif err != nil {\n   245\t\t\treturn nil, nil, err\n   246\t\t}\n   247\t\tentries, err := os.ReadDir(dir)\n   248\t\tif err != nil {\n   249\t\t\treturn nil, nil, err\n   250\t\t}\n   251\t\tout := []DelegationActiveRun{}\n   252\t\tvar lost []string\n   253\t\tfor _, e := range entries {\n   254\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   255\t\t\t\tcontinue\n   256\t\t\t}\n   257\t\t\traw, err := readLedgerRaw(filepath.Join(dir, e.Name()))\n   258\t\t\tif errors.Is(err, os.ErrNotExist) {\n   259\t\t\t\tcontinue // the run ended between the listing and the read\n   260\t\t\t}\n   261\t\t\tif err != nil {\n   262\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" could not be read: \"+err.Error())\n   263\t\t\t\tcontinue\n   264\t\t\t}\n   265\t\t\tvar marker DelegationActiveRun\n   266\t\t\tif json.Unmarshal(raw, &marker) != nil || marker.SchemaVersion != 1 || marker.AttemptID+\".json\" != e.Name() || !validRunToken(marker.RunToken) {\n   267\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" is not one this engine reads\")\n   268\t\t\t\tcontinue\n   269\t\t\t}\n   270\t\t\tmarker.Liveness, marker.Detail = probeStartLockOwner(marker.Owner)\n   271\t\t\tmarker.StalledAt = readDelegationStall(dir, marker)\n   272\t\t\tif marker.StalledAt == \"\" && delegationMarkerSilent(marker, time.Now()) && marker.Liveness == LockOwnerDead {\n   273\t\t\t\tmarker.StalledAt = recordDelegationStall(dir, marker)\n   274\t\t\t}\n   275\t\t\tif _, err := os.Lstat(cancelRequestPath(dir, marker)); err == nil {\n   276\t\t\t\tmarker.CancelRequested = true\n   277\t\t\t}\n   278\t\t\tout = append(out, marker)\n   279\t\t}\n   280\t\tsort.Slice(out, func(i, j int) bool {\n   281\t\t\treturn out[i].StartedAt < out[j].StartedAt || out[i].StartedAt == out[j].StartedAt && out[i].AttemptID < out[j].AttemptID\n   282\t\t})\n   283\t\treturn out, lost, nil\n   284\t}\n   285\t\n   286\t// ErrDelegationNotActive means no running run matches.\n   287\tvar ErrDelegationNotActive = errors.New(\"pose: the run is not running\")\n   288\t\n   289\t// RequestDelegationCancel asks the process running attempt to stop. A marker\n   290\t// whose owner is proven dead is not cancelled: nothing runs to stop.\n   291\tfunc (s Store) RequestDelegationCancel(attempt string) (DelegationActiveRun, error) {\n   292\t\tactive, _, err := s.ListDelegationActive()\n   293\t\tif err != nil {\n   294\t\t\treturn DelegationActiveRun{}, err\n   295\t\t}\n   296\t\tfor _, marker := range active {\n   297\t\t\tif marker.AttemptID != attempt {\n   298\t\t\t\tcontinue\n   299\t\t\t}\n   300\t\t\tif marker.Liveness == LockOwnerDead {\n   301\t\t\t\treturn marker, fmt.Errorf(\"pose: the process of attempt %s is gone (%s); nothing runs to cancel\", attempt, marker.Detail)\n   302\t\t\t}\n   303\t\t\tdir, err := s.delegationActiveDir(false)\n   304\t\t\tif err != nil {\n   305\t\t\t\treturn marker, err\n   306\t\t\t}\n   307\t\t\trequest := cancelRequestPath(dir, marker)\n   308\t\t\tif err := PublishFile(request, []byte(time.Now().UTC().Format(time.RFC3339Nano)+\"\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil && !errors.Is(err, os.ErrExist) {\n   309\t\t\t\tif _, statErr := os.Lstat(request); statErr != nil {\n   310\t\t\t\t\treturn marker, err\n   311\t\t\t\t}\n   312\t\t\t}\n   313\t\t\t// The run may have ended between the read and the request: a request\n   314\t\t\t// that names no running run is withdrawn, never left for a successor.\n   315\t\t\tif !s.DelegationRunActive(marker) {\n   316\t\t\t\t_ = os.Remove(request)\n   317\t\t\t\treturn marker, ErrDelegationNotActive\n   318\t\t\t}\n   319\t\t\tmarker.CancelRequested = true\n   320\t\t\treturn marker, nil\n   321\t\t}\n   322\t\treturn DelegationActiveRun{}, ErrDelegationNotActive\n   323\t}\n   324\t\n   325\t// DelegationRunActive reports whether the run marker names is still the\n   326\t// running run of its attempt.\n   327\tfunc (s Store) DelegationRunActive(marker DelegationActiveRun) bool {\n   328\t\tdir, err := s.delegationActiveDir(false)\n   329\t\tif err != nil {\n   330\t\t\treturn false\n   331\t\t}\n   332\t\traw, err := readLedgerRaw(filepath.Join(dir, marker.AttemptID+\".json\"))\n   333\t\tif err != nil {\n   334\t\t\treturn false\n   335\t\t}\n   336\t\tvar now DelegationActiveRun\n   337\t\treturn json.Unmarshal(raw, &now) == nil && now.RunToken == marker.RunToken\n   338\t}\n   339\t\n   340\t// DelegationPrivateDir is a directory of the engine's private delegation\npose-mcp/internal/pose/delegation_active.go:49:\tHeartbeatAt    string `json:\"heartbeat_at,omitempty\"`\npose-mcp/internal/pose/delegation_active.go:50:\tHeartbeatEvery int    `json:\"heartbeat_every,omitempty\"`\npose-mcp/internal/pose/delegation_active.go:88:// stop(true) stops the watcher and the heartbeat but keeps the marker: a run\npose-mcp/internal/pose/delegation_active.go:121:\t\theartbeat := time.NewTicker(every)\npose-mcp/internal/pose/delegation_active.go:122:\t\tdefer heartbeat.Stop()\npose-mcp/internal/pose/delegation_active.go:127:\t\t\tcase <-heartbeat.C:\npose-mcp/internal/pose/delegation_active.go:129:\t\t\t\t// asked, no further heartbeat starts, so it waits for at\npose-mcp/internal/pose/delegation_active.go:151:\t\t\t// A heartbeat in flight finishes before the marker goes, so it\npose-mcp/internal/pose/delegation_active.go:153:\t\t\t// pose-delegation-marker-stop-joins-heartbeat R1).\npose-mcp/internal/pose/delegation_active.go:171:// beatDelegationMarker rewrites the heartbeat of the marker run token names,\npose-mcp/internal/pose/delegation_active.go:188:// delegationMarkerSilent reports a heartbeat older than three interval