{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_reap_linux.go && nl -ba pose-mcp/internal/pose/review_reap_other.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Leftover reviewer processes (spec\n     6\t// pose-review-run-reaps-lingering-reviewer-processes R1): an adapter such as\n     7\t// `codex exec` runs each command in a session of its own, so killing the\n     8\t// adapter's process group misses a command the reviewer left running, and\n     9\t// that command keeps writing into the run's runtime directory while the\n    10\t// cleanup inventory reads it. Every process of the run inherits\n    11\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n    12\t// that entry, ends them and waits for them before the inventory.\n    13\t//\n    14\t// Each process is pinned by a pidfd before it is signalled, and its\n    15\t// environment is read again through the pinned process, so a pid reused by\n    16\t// an unrelated process between the scan and the signal is never killed\n    17\t// (review round 1, N3). A scan that cannot list or read the state of the\n    18\t// processes fails. A process of this user whose environment cannot be read\n    19\t// (one that made itself non-inspectable) cannot be matched: one that already\n    20\t// existed before the adapter started is not the run's and is skipped; any\n    21\t// other may be the run's, so the scan fails and the run stays unconcludable\n    22\t// (review round 2, N2).\n    23\t\n    24\timport (\n    25\t\t\"bytes\"\n    26\t\t\"errors\"\n    27\t\t\"fmt\"\n    28\t\t\"io/fs\"\n    29\t\t\"os\"\n    30\t\t\"path/filepath\"\n    31\t\t\"strconv\"\n    32\t\t\"strings\"\n    33\t\t\"syscall\"\n    34\t\t\"time\"\n    35\t\n    36\t\t\"golang.org/x/sys/unix\"\n    37\t)\n    38\t\n    39\t// reapSealedCheckoutProcesses ends every process whose environment names\n    40\t// worktree as its sealed checkout and returns a description of each. An\n    41\t// error means the run's processes could not be proven ended within the bound.\n    42\tfunc reapSealedCheckoutProcesses(worktree string, baseline map[int]string) ([]string, int, error) {\n    43\t\tif worktree == \"\" {\n    44\t\t\treturn nil, 0, nil\n    45\t\t}\n    46\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n    47\t\tvar reaped []string\n    48\t\tseen := map[int]bool{}\n    49\t\tdeadline := time.Now().Add(reviewReapWait)\n    50\t\tunreadable := 0\n    51\t\tfor {\n    52\t\t\talive, opaque, err := reviewMarkedProcesses(entry)\n    53\t\t\tif err != nil {\n    54\t\t\t\treturn reaped, unreadable, err\n    55\t\t\t}\n    56\t\t\tunreadable = 0\n    57\t\t\tfor pid, start := range opaque {\n    58\t\t\t\tif prior, ok := baseline[pid]; !ok || prior != start {\n    59\t\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"process %d of this user started during the run and cannot be inspected; it may be the run's and was not ended\", pid)\n    60\t\t\t\t}\n    61\t\t\t\tunreadable++\n    62\t\t\t}\n    63\t\t\tfor _, pid := range alive {\n    64\t\t\t\tif !seen[pid] {\n    65\t\t\t\t\tseen[pid] = true\n    66\t\t\t\t\t// Only the pid: the name is the reviewer's to choose and is not\n    67\t\t\t\t\t// recorded (review round 7, N4).\n    68\t\t\t\t\treaped = append(reaped, strconv.Itoa(pid))\n    69\t\t\t\t}\n    70\t\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n    71\t\t\t\t\treturn reaped, unreadable, err\n    72\t\t\t\t}\n    73\t\t\t}\n    74\t\t\tif len(alive) == 0 {\n    75\t\t\t\treturn reaped, unreadable, nil\n    76\t\t\t}\n    77\t\t\tif time.Now().After(deadline) {\n    78\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n    79\t\t\t}\n    80\t\t\ttime.Sleep(50 * time.Millisecond)\n    81\t\t}\n    82\t}\n    83\t\n    84\t// reviewMarkedProcesses lists the live processes whose environment holds\n    85\t// entry, and counts this user's processes whose environment could not be\n    86\t// read. A process that is gone is skipped.\n    87\tfunc reviewMarkedProcesses(entry []byte) ([]int, map[int]string, error) {\n    88\t\tdirs, err := os.ReadDir(\"/proc\")\n    89\t\tif err != nil {\n    90\t\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    91\t\t}\n    92\t\tunreadable := map[int]string{}\n    93\t\tself, uid := os.Getpid(), os.Getuid()\n    94\t\tvar out []int\n    95\t\tfor _, d := range dirs {\n    96\t\t\tpid, err := strconv.Atoi(d.Name())\n    97\t\t\tif err != nil || pid == self {\n    98\t\t\t\tcontinue\n    99\t\t\t}\n   100\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n   101\t\t\tswitch {\n   102\t\t\tcase reviewProcessGoneErr(err):\n   103\t\t\t\tcontinue\n   104\t\t\tcase err != nil:\n   105\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n   106\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n   107\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   108\t\t\t\t\tcontinue\n   109\t\t\t\t}\n   110\t\t\t\tstart, serr := processStartTime(pid)\n   111\t\t\t\tif reviewProcessGoneErr(serr) {\n   112\t\t\t\t\tcontinue\n   113\t\t\t\t}\n   114\t\t\t\tif serr != nil || start == \"\" {\n   115\t\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d start could not be read: %v\", pid, serr)\n   116\t\t\t\t}\n   117\t\t\t\tunreadable[pid] = start\n   118\t\t\t\tcontinue\n   119\t\t\tcase !marked:\n   120\t\t\t\tcontinue\n   121\t\t\t}\n   122\t\t\tzombie, err := reviewProcessZombie(pid)\n   123\t\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n   124\t\t\t\tcontinue\n   125\t\t\t}\n   126\t\t\tif err != nil {\n   127\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n   128\t\t\t}\n   129\t\t\tout = append(out, pid)\n   130\t\t}\n   131\t\treturn out, unreadable, nil\n   132\t}\n   133\t\n   134\t// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n   135\t// after the environment read through that same pinned process still holds\n   136\t// entry.\n   137\tfunc killPinnedMarkedProcess(pid int, entry []byte) error {\n   138\t\tfd, err := unix.PidfdOpen(pid, 0)\n   139\t\tif errors.Is(err, unix.ESRCH) {\n   140\t\t\treturn nil\n   141\t\t}\n   142\t\tif err != nil {\n   143\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   144\t\t}\n   145\t\tdefer unix.Close(fd)\n   146\t\t// The pidfd names one process for its lifetime; if pid was reused before\n   147\t\t// it was opened, the new process does not carry this run's entry.\n   148\t\tmarked, err := reviewProcessMarked(pid, entry)\n   149\t\tif reviewProcessGoneErr(err) || err == nil && !marked {\n   150\t\t\treturn nil\n   151\t\t}\n   152\t\tif err != nil {\n   153\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   154\t\t}\n   155\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   156\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   157\t\t}\n   158\t\treturn nil\n   159\t}\n   160\t\n   161\tfunc reviewProcessMarked(pid int, entry []byte) (bool, error) {\n   162\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   163\t\tif err != nil {\n   164\t\t\treturn false, err\n   165\t\t}\n   166\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n   167\t\t\tif bytes.Equal(kv, entry) {\n   168\t\t\t\treturn true, nil\n   169\t\t\t}\n   170\t\t}\n   171\t\treturn false, nil\n   172\t}\n   173\t\n   174\tfunc reviewProcessOwner(pid int) (int, error) {\n   175\t\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n   176\t\tif err != nil {\n   177\t\t\treturn 0, err\n   178\t\t}\n   179\t\tst, ok := info.Sys().(*syscall.Stat_t)\n   180\t\tif !ok {\n   181\t\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n   182\t\t}\n   183\t\treturn int(st.Uid), nil\n   184\t}\n   185\t\n   186\tfunc reviewProcessGoneErr(err error) bool {\n   187\t\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n   188\t}\n   189\t\n   190\tfunc reviewProcessName(pid int) string {\n   191\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n   192\t\tif err != nil {\n   193\t\t\treturn \"?\"\n   194\t\t}\n   195\t\treturn strings.TrimSpace(string(raw))\n   196\t}\n   197\t\n   198\tfunc reviewProcessZombie(pid int) (bool, error) {\n   199\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n   200\t\tif err != nil {\n   201\t\t\treturn false, err\n   202\t\t}\n   203\t\t// The state follows the parenthesised command name.\n   204\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   205\t\t\treturn raw[i+2] == 'Z', nil\n   206\t\t}\n   207\t\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n   208\t}\n   209\t\n   210\t// reviewOpaqueProcessBaseline records, before the adapter starts, the\n   211\t// processes of this user whose environment cannot be read, by pid and start\n   212\t// time: they cannot be the run's.\n   213\tfunc reviewOpaqueProcessBaseline() map[int]string {\n   214\t\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv + \"=\\x00\"))\n   215\t\treturn opaque\n   216\t}\n     1\t//go:build !linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport \"os/exec\"\n     6\t\n     7\t// reapSealedCheckoutProcesses has no portable way to read another process's\n     8\t// environment; outside Linux the process-group kill is the only termination.\n     9\tfunc reapSealedCheckoutProcesses(string, map[int]string) ([]string, int, error) { return nil, 0, nil }\n    10\t\n    11\tfunc reviewOpaqueProcessBaseline() map[int]string { return nil }\n    12\t\n    13\t// RunReviewShim is the Linux review run shim; elsewhere it is not used.\n    14\tfunc RunReviewShim(args []string) int { return 125 }\n    15\t\n    16\tfunc parseReviewShimReport([]byte) (reviewShimReport, error) { return reviewShimReport{}, nil }\n    17\t\n    18\tfunc stopReviewShim(cmd *exec.Cmd) func() error { return cmd.Cancel }\n","exit_code":0,"status":"completed"}}
