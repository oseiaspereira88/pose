{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/delegation_release.go && nl -ba pose-mcp/internal/pose/delegation_list.go && nl -ba pose-mcp/internal/cli/delegate.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"os\"\n    28\t\t\"path/filepath\"\n    29\t\t\"strings\"\n    30\t\t\"time\"\n    31\t)\n    32\t\n    33\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    34\t// proven abandoned.\n    35\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    36\t\n    37\t// reviewOrphanReservationAge is how old a reservation without any marker\n    38\t// must be to count as abandoned.\n    39\tconst reviewOrphanReservationAge = 10 * time.Minute\n    40\t\n    41\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    42\t// dispatch ended before recording it, and removes its stalled marker. A\n    43\t// stalled marker whose reservation was never published is only removed; the\n    44\t// returned run is then empty.\n    45\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    46\t\tif !validAttemptFileName(attemptID) {\n    47\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    48\t\t}\n    49\t\tmarkers, _, err := s.ListDelegationActive()\n    50\t\tif err != nil {\n    51\t\t\treturn ReviewRun{}, err\n    52\t\t}\n    53\t\tvar marker *DelegationActiveRun\n    54\t\tfor i := range markers {\n    55\t\t\tif markers[i].AttemptID == attemptID {\n    56\t\t\t\tmarker = &markers[i]\n    57\t\t\t}\n    58\t\t}\n    59\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    60\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    61\t\t}\n    62\t\tdir, err := s.delegationActiveDir(true)\n    63\t\tif err != nil {\n    64\t\t\treturn ReviewRun{}, err\n    65\t\t}\n    66\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    67\t\tif err != nil {\n    68\t\t\treturn ReviewRun{}, err\n    69\t\t}\n    70\t\tdefer lock.Close()\n    71\t\tunlock, err := lockSpecTransferFile(lock)\n    72\t\tif err != nil {\n    73\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    74\t\t}\n    75\t\tdefer unlock()\n    76\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    77\t}\n    78\t\n    79\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    80\t\tvar reserved *DelegatedReviewAttempt\n    81\t\tif marker != nil {\n    82\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    83\t\t\tif err != nil {\n    84\t\t\t\treturn ReviewRun{}, err\n    85\t\t\t}\n    86\t\t\tfor i := range attempts {\n    87\t\t\t\tif attempts[i].AttemptID == attemptID {\n    88\t\t\t\t\treserved = &attempts[i]\n    89\t\t\t\t}\n    90\t\t\t}\n    91\t\t\tif reserved == nil {\n    92\t\t\t\t// The dispatch ended between its marker and its reservation:\n    93\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    94\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    95\t\t\t}\n    96\t\t} else {\n    97\t\t\tif !operatorConfirmed {\n    98\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n    99\t\t\t}\n   100\t\t\torphans, _, err := s.orphanReservations(now)\n   101\t\t\tif err != nil {\n   102\t\t\t\treturn ReviewRun{}, err\n   103\t\t\t}\n   104\t\t\tfor i := range orphans {\n   105\t\t\t\tif orphans[i].AttemptID == attemptID {\n   106\t\t\t\t\treserved = &orphans[i]\n   107\t\t\t\t}\n   108\t\t\t}\n   109\t\t\tif reserved == nil {\n   110\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   111\t\t\t}\n   112\t\t}\n   113\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   114\t\t\t// A release that stopped after the receipt completes by removing\n   115\t\t\t// the stalled marker; with no marker there is nothing to release.\n   116\t\t\tif marker != nil {\n   117\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   118\t\t\t\tif err != nil {\n   119\t\t\t\t\treturn ReviewRun{}, err\n   120\t\t\t\t}\n   121\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   122\t\t\t\tif err != nil {\n   123\t\t\t\t\treturn ReviewRun{}, err\n   124\t\t\t\t}\n   125\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   126\t\t\t}\n   127\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   128\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   129\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   130\t\t}\n   131\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   132\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   133\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   134\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   135\t\tif marker != nil {\n   136\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   137\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   138\t\t} else {\n   139\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   140\t\t}\n   141\t\t// A run the attempt already recorded, by its dispatch or by a release\n   142\t\t// interrupted before the receipt, completes the attempt; no second run\n   143\t\t// is written for it.\n   144\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   145\t\tif err != nil {\n   146\t\t\treturn ReviewRun{}, err\n   147\t\t}\n   148\t\tif !found {\n   149\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   150\t\t\t\treturn ReviewRun{}, err\n   151\t\t\t}\n   152\t\t}\n   153\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   154\t\t\treturn recorded, err\n   155\t\t}\n   156\t\tif marker != nil {\n   157\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   158\t\t}\n   159\t\treturn recorded, nil\n   160\t}\n   161\t\n   162\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   163\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   164\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   165\t\tif err != nil {\n   166\t\t\treturn ReviewRun{}, false, err\n   167\t\t}\n   168\t\tif len(lost) > 0 {\n   169\t\t\t// An unreadable run may be this release's: the history is unknown,\n   170\t\t\t// and the release does not write another (review round 4, N3).\n   171\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   172\t\t}\n   173\t\tvar latest *ReviewRun\n   174\t\tfor i := range runs {\n   175\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   176\t\t\t\tlatest = &runs[i]\n   177\t\t\t}\n   178\t\t}\n   179\t\tif latest == nil {\n   180\t\t\treturn ReviewRun{}, false, nil\n   181\t\t}\n   182\t\treturn *latest, true, nil\n   183\t}\n   184\t\n   185\t// orphanReservations lists the reservations left without a receipt or a\n   186\t// marker, older than reviewOrphanReservationAge, and\n   187\t// says which reservations or receipts it could not read (review round 3, N3).\n   188\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   189\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   190\t\tdirs, err := os.ReadDir(base)\n   191\t\tif errors.Is(err, os.ErrNotExist) {\n   192\t\t\treturn nil, nil, nil\n   193\t\t}\n   194\t\tif err != nil {\n   195\t\t\treturn nil, nil, err\n   196\t\t}\n   197\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   198\t\tif err != nil {\n   199\t\t\treturn nil, nil, err\n   200\t\t}\n   201\t\tif len(markerLost) > 0 {\n   202\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   203\t\t\t// have no marker (review round 6, N1).\n   204\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   205\t\t}\n   206\t\tmarked := map[string]bool{}\n   207\t\tfor _, m := range markers {\n   208\t\t\tmarked[m.AttemptID] = true\n   209\t\t}\n   210\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   211\t\tif err != nil {\n   212\t\t\treturn nil, nil, err\n   213\t\t}\n   214\t\tif len(runLost) > 0 {\n   215\t\t\t// Without the whole run history nothing is known to have no run.\n   216\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   217\t\t}\n   218\t\t// A recorded run does not finish an attempt, its receipt does: a\n   219\t\t// reservation whose run was recorded without a receipt still blocks and\n   220\t\t// is released with that run (review round 5, N3).\n   221\t\t_ = runs\n   222\t\tvar out []DelegatedReviewAttempt\n   223\t\tvar lost []string\n   224\t\tbudget := reviewReadBudget(nil)\n   225\t\tfor _, d := range dirs {\n   226\t\t\tif !d.IsDir() {\n   227\t\t\t\tcontinue\n   228\t\t\t}\n   229\t\t\tentries, err := os.ReadDir(filepath.Join(base, d.Name()))\n   230\t\t\tif err != nil {\n   231\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   232\t\t\t\tcontinue\n   233\t\t\t}\n   234\t\t\tfor _, e := range entries {\n   235\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   236\t\t\t\t\tcontinue\n   237\t\t\t\t}\n   238\t\t\t\tvar a DelegatedReviewAttempt\n   239\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   240\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   241\t\t\t\t\tcontinue\n   242\t\t\t\t}\n   243\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif marked[a.AttemptID] {\n   248\t\t\t\t\tcontinue\n   249\t\t\t\t}\n   250\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   251\t\t\t\t\tcontinue\n   252\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   253\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   254\t\t\t\t\tcontinue\n   255\t\t\t\t}\n   256\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   257\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   258\t\t\t\t\tcontinue\n   259\t\t\t\t}\n   260\t\t\t\tout = append(out, a)\n   261\t\t\t}\n   262\t\t}\n   263\t\treturn out, lost, nil\n   264\t}\n   265\t\n   266\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   267\t\tdir, err := s.delegationActiveDir(false)\n   268\t\tif err != nil {\n   269\t\t\treturn err\n   270\t\t}\n   271\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   272\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   273\t\t\t\treturn err\n   274\t\t\t}\n   275\t\t}\n   276\t\treturn nil\n   277\t}\n     1\tpackage pose\n     2\t\n     3\t// Listing and naming delegated runs (spec pose-delegation-surface R11, and the\n     4\t// listing pose-delegated-review-completion-signal extends).\n     5\t//\n     6\t// A person and an agent follow a task, not a process: an attempt and its\n     7\t// continuations are one row, shown by their latest run. A reference names a\n     8\t// row by attempt, by any of its runs, by label or by a prefix of its session.\n     9\t\n    10\timport (\n    11\t\t\"fmt\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t)\n    16\t\n    17\t// DelegationAttempt is one attempt and its continuations.\n    18\ttype DelegationAttempt struct {\n    19\t\tAttemptID    string              `json:\"attempt_id\"`\n    20\t\tRuns         []string            `json:\"runs\"`\n    21\t\tLatestRun    string              `json:\"latest_run,omitempty\"`\n    22\t\tState        string              `json:\"state\"`\n    23\t\tPurpose      string              `json:\"purpose\"`\n    24\t\tAgent        string              `json:\"agent\"`\n    25\t\tVendor       string              `json:\"vendor,omitempty\"`\n    26\t\tModel        string              `json:\"model,omitempty\"`\n    27\t\tLabel        string              `json:\"label,omitempty\"`\n    28\t\tLead         string              `json:\"lead,omitempty\"`\n    29\t\tAccess       string              `json:\"access\"`\n    30\t\tScope        string              `json:\"scope\"`\n    31\t\tBundleID     string              `json:\"bundle_id\"`\n    32\t\tStartedAt    string              `json:\"started_at\"`\n    33\t\tEndedAt      string              `json:\"ended_at,omitempty\"`\n    34\t\tTurns        int                 `json:\"turns\"`\n    35\t\tLastStep     string              `json:\"last_step,omitempty\"`\n    36\t\tFailure      string              `json:\"failure,omitempty\"`\n    37\t\tInterruption *ReviewInterruption `json:\"interruption,omitempty\"`\n    38\t\t// Partial says an interrupted run kept a partial draft; TimeLeft is the\n    39\t\t// wait until its recorded reset, when there is one.\n    40\t\tPartial         bool   `json:\"partial,omitempty\"`\n    41\t\tTimeLeft        string `json:\"time_left,omitempty\"`\n    42\t\tActive          bool   `json:\"active\"`\n    43\t\tLiveness        string `json:\"liveness,omitempty\"`\n    44\t\tCancelRequested bool   `json:\"cancel_requested,omitempty\"`\n    45\t\t// HeartbeatAge is how long ago the running process last beat; a stalled\n    46\t\t// run is not active (spec pose-delegated-review-completion-signal R4, R6).\n    47\t\tHeartbeatAge string `json:\"heartbeat_age,omitempty\"`\n    48\t\tStalledAt    string `json:\"stalled_at,omitempty\"`\n    49\t\t// HookFailure is why the latest run's on_terminal hook failed (R7).\n    50\t\tHookFailure string `json:\"hook_failure,omitempty\"`\n    51\t\t// Round is the review round of the scope the latest run reviewed (spec\n    52\t\t// pose-delegated-review-round-protocol R1).\n    53\t\tRound    int `json:\"round,omitempty\"`\n    54\t\tsessions []string\n    55\t\tlatest   *ReviewRun\n    56\t}\n    57\t\n    58\t// Latest is the latest recorded run of the attempt, if any.\n    59\tfunc (a DelegationAttempt) Latest() *ReviewRun { return a.latest }\n    60\t\n    61\t// DelegationRunning is the state of an attempt whose process is still there;\n    62\t// DelegationStalled, of one whose process is gone without a record.\n    63\tconst (\n    64\t\tDelegationRunning = \"running\"\n    65\t\tDelegationStalled = \"stalled\"\n    66\t\t// DelegationAbandonedCause is the failure of a stalled attempt whose\n    67\t\t// dispatch ended before recording its run.\n    68\t\tDelegationAbandonedCause = \"abandoned: the dispatching process ended before the run was recorded\"\n    69\t)\n    70\t\n    71\t// ListDelegationAttempts groups every recorded run by attempt, adds the runs\n    72\t// in progress, and returns the losses the run history reports.\n    73\tfunc (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n    74\t\t// The markers are read before the runs: a run publishes its record before\n    75\t\t// it removes its marker, so a reader that finds no marker for an attempt\n    76\t\t// it saw running finds its record (spec\n    77\t\t// pose-delegated-review-completion-signal R5).\n    78\t\tactive, activeLost, activeErr := s.ListDelegationActive()\n    79\t\truns, lost, err := s.ReadReviewRuns(\"\")\n    80\t\tif err != nil {\n    81\t\t\treturn nil, nil, err\n    82\t\t}\n    83\t\t// Task runs share the lifecycle, never the review history (spec\n    84\t\t// pose-delegation-task R7, R8).\n    85\t\ttasks, taskLost := s.ReadDelegationTaskRuns()\n    86\t\truns, lost = append(runs, tasks...), append(lost, taskLost...)\n    87\t\tbyAttempt := map[string]*DelegationAttempt{}\n    88\t\torder := []string{}\n    89\t\tfor i := range runs {\n    90\t\t\trun := runs[i]\n    91\t\t\tkey := run.AttemptID\n    92\t\t\tif key == \"\" {\n    93\t\t\t\tkey = run.RunID // a run recorded before attempts existed is its own attempt\n    94\t\t\t}\n    95\t\t\trow, ok := byAttempt[key]\n    96\t\t\tif !ok {\n    97\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    98\t\t\t\tbyAttempt[key] = row\n    99\t\t\t\torder = append(order, key)\n   100\t\t\t}\n   101\t\t\trow.Runs = append(row.Runs, run.RunID)\n   102\t\t\trow.latest = &runs[i]\n   103\t\t\tif run.SessionDigest != \"\" {\n   104\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   105\t\t\t\t\trow.sessions = append(row.sessions, value)\n   106\t\t\t\t}\n   107\t\t\t}\n   108\t\t\tevents, err := s.ReadDelegationEvents(run)\n   109\t\t\tif err != nil {\n   110\t\t\t\t// A turn count read from nothing would report a whole history.\n   111\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   112\t\t\t} else {\n   113\t\t\t\tfor _, e := range events {\n   114\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   115\t\t\t\t\t\trow.Turns++\n   116\t\t\t\t\t}\n   117\t\t\t\t}\n   118\t\t\t\tif len(events) > 0 {\n   119\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   120\t\t\t\t}\n   121\t\t\t}\n   122\t\t}\n   123\t\tfor _, key := range order {\n   124\t\t\trow := byAttempt[key]\n   125\t\t\tlatest := row.latest\n   126\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   127\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   128\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   129\t\t\tif latest.Access != \"\" {\n   130\t\t\t\trow.Access = latest.Access\n   131\t\t\t}\n   132\t\t\trow.Round = latest.Round\n   133\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   134\t\t\t\trow.HookFailure = hook.Failure\n   135\t\t\t}\n   136\t\t\tif row.Purpose == \"\" {\n   137\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   138\t\t\t}\n   139\t\t\tif latest.Status == ReviewRunInterrupted {\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n   206\t\tfor _, key := range order {\n   207\t\t\tout = append(out, *byAttempt[key])\n   208\t\t}\n   209\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   210\t\treturn out, lost, nil\n   211\t}\n   212\t\n   213\tfunc delegationStepText(e DelegationEvent) string {\n   214\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   215\t\tif len(text) > 80 {\n   216\t\t\tcut := 77\n   217\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   218\t\t\t\tcut--\n   219\t\t\t}\n   220\t\t\ttext = text[:cut] + \"...\"\n   221\t\t}\n   222\t\tswitch e.Kind {\n   223\t\tcase DelegationEventToolCall:\n   224\t\t\treturn \"▶ \" + text\n   225\t\tcase DelegationEventToolOutput:\n   226\t\t\tif e.ExitCode != nil && *e.ExitCode != 0 {\n   227\t\t\t\treturn fmt.Sprintf(\"✗ exit %d\", *e.ExitCode)\n   228\t\t\t}\n   229\t\t\treturn \"✓ exit 0\"\n   230\t\tcase DelegationEventTurn:\n   231\t\t\treturn \"turn\"\n   232\t\t}\n   233\t\tif text == \"\" {\n   234\t\t\treturn e.Kind\n   235\t\t}\n   236\t\treturn e.Kind + \": \" + text\n   237\t}\n   238\t\n   239\t// ErrDelegationRefAmbiguous carries the candidates of an ambiguous reference.\n   240\t// Neither reference error carries the reference: it may be a session, which\n   241\t// no output names.\n   242\ttype ErrDelegationRefAmbiguous struct {\n   243\t\tCandidates []string\n   244\t}\n   245\t\n   246\tfunc (e *ErrDelegationRefAmbiguous) Error() string {\n   247\t\treturn \"pose: the reference names more than one delegated run: \" + strings.Join(e.Candidates, \", \")\n   248\t}\n   249\t\n   250\t// ErrDelegationRefUnknown means no attempt matches.\n   251\ttype ErrDelegationRefUnknown struct{}\n   252\t\n   253\tfunc (e *ErrDelegationRefUnknown) Error() string {\n   254\t\treturn \"pose: no delegated run matches the reference (a run id, an attempt id, a label or a session prefix of six characters or more)\"\n   255\t}\n   256\t\n   257\t// ResolveDelegationRef finds the one attempt ref names (R11).\n   258\tfunc ResolveDelegationRef(attempts []DelegationAttempt, ref string) (DelegationAttempt, error) {\n   259\t\tref = strings.TrimSpace(ref)\n   260\t\tif ref == \"\" {\n   261\t\t\treturn DelegationAttempt{}, &ErrDelegationRefUnknown{}\n   262\t\t}\n   263\t\t// An identifier is exact and wins over a label or a session prefix.\n   264\t\tfor _, a := range attempts {\n   265\t\t\tif a.AttemptID == ref || containsString(a.Runs, ref) {\n   266\t\t\t\treturn a, nil\n   267\t\t\t}\n   268\t\t}\n   269\t\tvar matched []DelegationAttempt\n   270\t\tfor _, a := range attempts {\n   271\t\t\thit := a.Label == ref\n   272\t\t\tif !hit && len(ref) >= 6 {\n   273\t\t\t\tfor _, session := range a.sessions {\n   274\t\t\t\t\tif strings.HasPrefix(session, ref) {\n   275\t\t\t\t\t\thit = true\n   276\t\t\t\t\t}\n   277\t\t\t\t}\n   278\t\t\t}\n   279\t\t\tif hit {\n   280\t\t\t\tmatched = append(matched, a)\n   281\t\t\t}\n   282\t\t}\n   283\t\tswitch len(matched) {\n   284\t\tcase 0:\n   285\t\t\treturn DelegationAttempt{}, &ErrDelegationRefUnknown{}\n   286\t\tcase 1:\n   287\t\t\treturn matched[0], nil\n   288\t\t}\n   289\t\tcandidates := make([]string, 0, len(matched))\n   290\t\tfor _, a := range matched {\n   291\t\t\tname := a.AttemptID\n   292\t\t\tif a.Label != \"\" {\n   293\t\t\t\tname += \" (\" + a.Label + \", \" + a.State + \")\"\n   294\t\t\t}\n   295\t\t\tcandidates = append(candidates, name)\n   296\t\t}\n   297\t\treturn DelegationAttempt{}, &ErrDelegationRefAmbiguous{Candidates: candidates}\n   298\t}\n     1\tpackage cli\n     2\t\n     3\t// pose delegate: the one surface for delegated executions (spec\n     4\t// pose-delegation-surface; ADR 2026-10-26-delegation-is-a-first-class-execution-surface).\n     5\t//\n     6\t// pose review governs the subject (bundle, brief, attestation, verify);\n     7\t// pose delegate governs executions: who runs, with which access, and what\n     8\t// happened. review, adjudicate and smoke run through the delivered dispatch\n     9\t// path; the lifecycle commands read the same run records.\n    10\t//\n    11\t// Every subcommand takes the common flags with one meaning (R2): where a\n    12\t// command starts a run they set it (--agent, --access, --label, --lead);\n    13\t// where it names or lists runs they select them, and a run that does not\n    14\t// match is not the one named; --dry-run changes nothing anywhere.\n    15\t\n    16\timport (\n    17\t\t\"context\"\n    18\t\t\"crypto/rand\"\n    19\t\t\"encoding/json\"\n    20\t\t\"errors\"\n    21\t\t\"fmt\"\n    22\t\t\"io\"\n    23\t\t\"os\"\n    24\t\t\"os/signal\"\n    25\t\t\"path/filepath\"\n    26\t\t\"regexp\"\n    27\t\t\"sort\"\n    28\t\t\"strconv\"\n    29\t\t\"strings\"\n    30\t\t\"syscall\"\n    31\t\t\"time\"\n    32\t\n    33\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    34\t)\n    35\t\n    36\tconst delegateUsageText = \"pose delegate <review|adjudicate|smoke|task|ls|watch|wait|resume|handoff|cancel|agents> [args] [--agent auto|<name>] [--access read|sandboxed|write|full] [--label <name>] [--lead <vendor>] [--dry-run] [--json]\"\n    37\t\n    38\t// Versioned JSON documents of pose delegate (R10).\n    39\tconst (\n    40\t\tdelegateRunSchema    = \"pose.delegate.run/v1\"\n    41\t\tdelegatePlanSchema   = \"pose.delegate.plan/v1\"\n    42\t\tdelegateListSchema   = \"pose.delegate.ls/v1\"\n    43\t\tdelegateCancelSchema = \"pose.delegate.cancel/v1\"\n    44\t\tdelegateAgentsSchema = \"pose.delegate.agents/v1\"\n    45\t\tdelegateErrorSchema  = \"pose.delegate.error/v1\"\n    46\t)\n    47\t\n    48\t// Subcommands named by the ADR whose behaviour a later spec delivers.\n    49\tvar delegatePlanned = map[string]string{}\n    50\t\n    51\tvar (\n    52\t\tdelegateLabelRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n    53\t)\n    54\t\n    55\t// commonDelegateFlags are taken by every subcommand.\n    56\tvar commonDelegateFlags = []string{\"--agent\", \"--access\", \"--label\", \"--lead\", \"--dry-run\", \"--json\"}\n    57\t\n    58\t// tr picks the message for the session's locale.\n    59\tfunc tr(english, portuguese string) string { return cliText(cliLocaleValue(), english, portuguese) }\n    60\t\n    61\ttype delegateFlags struct {\n    62\t\tagent, access, label, lead, reason, noteFile string\n    63\t\trequest                                      string\n    64\t\tto, cd, effort, promptFile, session          string\n    65\t\taddDirs                                      []string\n    66\t\tnoNetwork, record, confirmAbandoned          bool\n    67\t\tdryRun, jsonOut, active, wait, detach        bool\n    68\t\tverbose, noFollow                            bool\n    69\t\tlines                                        int\n    70\t\twaitMax, timeout, refresh                    time.Duration\n    71\t\tpositional                                   []string\n    72\t}\n    73\t\n    74\t// parseDelegateFlags reads the common flags and the extra ones a subcommand\n    75\t// takes; problem is a message for the person, in their locale.\n    76\tfunc parseDelegateFlags(args []string, extra ...string) (delegateFlags, string) {\n    77\t\tf := delegateFlags{waitMax: 24 * time.Hour}\n    78\t\tpermit := map[string]bool{}\n    79\t\tfor _, name := range append(append([]string(nil), commonDelegateFlags...), extra...) {\n    80\t\t\tpermit[name] = true\n    81\t\t}\n    82\t\tfor i := 0; i < len(args); i++ {\n    83\t\t\targ := args[i]\n    84\t\t\tname, inline, hasInline := strings.Cut(arg, \"=\")\n    85\t\t\t// A lone - names stdin (spec pose-delegation-task R1).\n    86\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n    87\t\t\t\tf.positional = append(f.positional, arg)\n    88\t\t\t\tcontinue\n    89\t\t\t}\n    90\t\t\tif !permit[name] {\n    91\t\t\t\treturn f, tr(\"unknown or inapplicable flag \"+name, \"flag desconhecida ou inaplicável \"+name)\n    92\t\t\t}\n    93\t\t\tswitch name {\n    94\t\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\", \"--confirm-abandoned\":\n    95\t\t\t\tif hasInline {\n    96\t\t\t\t\treturn f, tr(name+\" takes no value\", name+\" não recebe valor\")\n    97\t\t\t\t}\n    98\t\t\t\tswitch name {\n    99\t\t\t\tcase \"--dry-run\":\n   100\t\t\t\t\tf.dryRun = true\n   101\t\t\t\tcase \"--json\":\n   102\t\t\t\t\tf.jsonOut = true\n   103\t\t\t\tcase \"--detach\":\n   104\t\t\t\t\tf.detach = true\n   105\t\t\t\tcase \"-v\":\n   106\t\t\t\t\tf.verbose = true\n   107\t\t\t\tcase \"--no-network\":\n   108\t\t\t\t\tf.noNetwork = true\n   109\t\t\t\tcase \"--record\":\n   110\t\t\t\t\tf.record = true\n   111\t\t\t\tcase \"--confirm-abandoned\":\n   112\t\t\t\t\tf.confirmAbandoned = true\n   113\t\t\t\tcase \"--no-follow\":\n   114\t\t\t\t\tf.noFollow = true\n   115\t\t\t\tdefault:\n   116\t\t\t\t\tf.active = true\n   117\t\t\t\t}\n   118\t\t\tcase \"--wait-until-reset\":\n   119\t\t\t\tf.wait = true\n   120\t\t\t\tif hasInline {\n   121\t\t\t\t\td, err := time.ParseDuration(inline)\n   122\t\t\t\t\tif err != nil || d <= 0 || d > 24*time.Hour {\n   123\t\t\t\t\t\treturn f, tr(\"--wait-until-reset takes a duration up to 24h\", \"--wait-until-reset recebe uma duração de até 24h\")\n   124\t\t\t\t\t}\n   125\t\t\t\t\tf.waitMax = d\n   126\t\t\t\t}\n   127\t\t\tdefault:\n   128\t\t\t\tvalue := inline\n   129\t\t\t\tif !hasInline {\n   130\t\t\t\t\t// --prompt - reads stdin (spec pose-delegation-task R8).\n   131\t\t\t\t\tif i+1 >= len(args) || strings.HasPrefix(args[i+1], \"-\") && !(name == \"--prompt\" && args[i+1] == \"-\") {\n   132\t\t\t\t\t\treturn f, tr(name+\" needs a value\", name+\" precisa de um valor\")\n   133\t\t\t\t\t}\n   134\t\t\t\t\tvalue = args[i+1]\n   135\t\t\t\t\ti++\n   136\t\t\t\t}\n   137\t\t\t\tswitch name {\n   138\t\t\t\tcase \"--agent\":\n   139\t\t\t\t\tf.agent = value\n   140\t\t\t\tcase \"--access\":\n   141\t\t\t\t\tif !containsString([]string{posemodel.DelegationAccessRead, posemodel.DelegationAccessSandboxed, posemodel.DelegationAccessWrite, posemodel.DelegationAccessFull}, value) {\n   142\t\t\t\t\t\treturn f, tr(\"--access takes read, sandboxed, write or full\", \"--access recebe read, sandboxed, write ou full\")\n   143\t\t\t\t\t}\n   144\t\t\t\t\tf.access = value\n   145\t\t\t\tcase \"--label\":\n   146\t\t\t\t\tif !delegateLabelRE.MatchString(value) {\n   147\t\t\t\t\t\treturn f, tr(\"--label takes letters, digits, '.', '_' and '-' (64 at most)\", \"--label aceita letras, dígitos, '.', '_' e '-' (no máximo 64)\")\n   148\t\t\t\t\t}\n   149\t\t\t\t\tf.label = value\n   150\t\t\t\tcase \"--lead\":\n   151\t\t\t\t\tvendor, model, err := posemodel.ParseLead(value)\n   152\t\t\t\t\tif err != nil {\n   153\t\t\t\t\t\treturn f, tr(\"--lead takes <vendor>[/<model>], such as openai or anthropic/claude-opus-5-5\", \"--lead recebe <vendor>[/<modelo>], como openai ou anthropic/claude-opus-5-5\")\n   154\t\t\t\t\t}\n   155\t\t\t\t\tf.lead = vendor\n   156\t\t\t\t\tif model != \"\" {\n   157\t\t\t\t\t\tf.lead += \"/\" + model\n   158\t\t\t\t\t}\n   159\t\t\t\tcase \"--reason\":\n   160\t\t\t\t\tf.reason = value\n   161\t\t\t\tcase \"--session\":\n   162\t\t\t\t\tf.session = value\n   163\t\t\t\tcase \"--request\":\n   164\t\t\t\t\tf.request = value\n   165\t\t\t\tcase \"--lines\":\n   166\t\t\t\t\tn, err := strconv.Atoi(value)\n   167\t\t\t\t\tif err != nil || n < 1 || n > 1000 {\n   168\t\t\t\t\t\treturn f, tr(\"--lines takes a number from 1 to 1000\", \"--lines recebe um número de 1 a 1000\")\n   169\t\t\t\t\t}\n   170\t\t\t\t\tf.lines = n\n   171\t\t\t\tcase \"--refresh\":\n   172\t\t\t\t\td, err := time.ParseDuration(value)\n   173\t\t\t\t\tif err != nil || d < 0 || d > time.Hour {\n   174\t\t\t\t\t\treturn f, tr(\"--refresh takes a duration from 0 to 1h (0 turns the preview's refresh off)\", \"--refresh recebe uma duração de 0 a 1h (0 desliga a atualização do preview)\")\n   175\t\t\t\t\t}\n   176\t\t\t\t\tf.refresh = d\n   177\t\t\t\tcase \"--timeout\":\n   178\t\t\t\t\td, err := time.ParseDuration(value)\n   179\t\t\t\t\tif err != nil || d <= 0 {\n   180\t\t\t\t\t\treturn f, tr(\"--timeout takes a positive duration\", \"--timeout recebe uma duração positiva\")\n   181\t\t\t\t\t}\n   182\t\t\t\t\tf.timeout = d\n   183\t\t\t\tcase \"--to\":\n   184\t\t\t\t\tf.to = value\n   185\t\t\t\tcase \"--cd\":\n   186\t\t\t\t\tf.cd = value\n   187\t\t\t\tcase \"--add-dir\":\n   188\t\t\t\t\tf.addDirs = append(f.addDirs, value)\n   189\t\t\t\tcase \"--effort\":\n   190\t\t\t\t\tf.effort = value\n   191\t\t\t\tcase \"--prompt\":\n   192\t\t\t\t\tf.promptFile = value\n   193\t\t\t\tcase \"--note-file\":\n   194\t\t\t\t\tf.noteFile = value\n   195\t\t\t\t}\n   196\t\t\t}\n   197\t\t}\n   198\t\treturn f, \"\"\n   199\t}\n   200\t\n   201\tfunc cmdDelegate(root string, args []string, stdout, stderr io.Writer) int {\n   202\t\tif len(args) == 0 {\n   203\t\t\tdispatchCommandHelp(\"delegate\", nil, stdout, cliLocaleValue())\n   204\t\t\treturn 0\n   205\t\t}\n   206\t\tsub, rest := args[0], args[1:]\n   207\t\tif spec, planned := delegatePlanned[sub]; planned {\n   208\t\t\treturn delegateUsage(stdout, stderr, rest, sub, tr(\"not available yet; it is delivered by spec \"+spec, \"ainda não está disponível; é entregue pela spec \"+spec))\n   209\t\t}\n   210\t\tswitch sub {\n   211\t\tcase posemodel.DelegationPurposeReview, posemodel.DelegationPurposeAdjudicate, posemodel.DelegationPurposeSmoke:\n   212\t\t\treturn cmdDelegatePurpose(root, sub, rest, stdout, stderr)\n   213\t\tcase posemodel.DelegationPurposeTask:\n   214\t\t\treturn cmdDelegateTask(root, rest, stdout, stderr)\n   215\t\tcase \"ls\":\n   216\t\t\treturn cmdDelegateLs(root, rest, stdout, stderr)\n   217\t\tcase \"resume\":\n   218\t\t\treturn cmdDelegateResume(root, rest, stdout, stderr)\n   219\t\tcase \"cancel\":\n   220\t\t\treturn cmdDelegateCancel(root, rest, stdout, stderr)\n   221\t\tcase \"agents\":\n   222\t\t\treturn cmdDelegateAgents(root, rest, stdout, stderr)\n   223\t\tcase \"wait\":\n   224\t\t\treturn cmdDelegateWait(root, rest, stdout, stderr)\n   225\t\tcase \"watch\":\n   226\t\t\treturn cmdDelegateWatch(root, rest, stdout, stderr)\n   227\t\tcase \"handoff\":\n   228\t\t\treturn cmdDelegateHandoff(root, rest, stdout, stderr)\n   229\t\t}\n   230\t\treturn delegateUsage(stdout, stderr, rest, sub, tr(\"unknown subcommand\", \"subcomando desconhecido\")+\"\\n\"+tr(\"Usage: \", \"Uso: \")+delegateUsageText)\n   231\t}\n   232\t\n   233\t// delegateUsage reports a usage error: exit 2, as text, or as the error\n   234\t// document when the caller asked for --json (R10).\n   235\tfunc delegateUsage(stdout, stderr io.Writer, args []string, command, msg string) int {\n   236\t\tfor _, arg := range args {\n   237\t\t\tif arg == \"--json\" {\n   238\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg, \"usage\": true})\n   239\t\t\t\treturn 2\n   240\t\t\t}\n   241\t\t}\n   242\t\thandBackRefusal(map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg, \"usage\": true}, 2)\n   243\t\treturn usageError(stderr, \"pose delegate \"+command+\": \"+msg)\n   244\t}\n   245\t\n   246\tfunc writeDelegateJSON(stdout io.Writer, doc any) {\n   247\t\t// Every error document a detached run writes is handed back (B03); a\n   248\t\t// caller that knows its exit code hands it back first.\n   249\t\tif m, ok := doc.(map[string]any); ok && m[\"schema\"] == delegateErrorSchema {\n   250\t\t\tcode := 1\n   251\t\t\tif m[\"usage\"] == true {\n   252\t\t\t\tcode = 2\n   253\t\t\t}\n   254\t\t\thandBackRefusal(m, code)\n   255\t\t}\n   256\t\tenc := json.NewEncoder(stdout)\n   257\t\tenc.SetIndent(\"\", \"  \")\n   258\t\t_ = enc.Encode(doc)\n   259\t}\n   260\t\n   261\t// delegateFail reports a failure as text or as the error document.\n   262\tfunc delegateFail(stdout, stderr io.Writer, jsonOut bool, command string, code int, err error) int {\n   263\t\tmsg := strings.TrimPrefix(err.Error(), \"pose: \")\n   264\t\tdoc := map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg}\n   265\t\t// The reason code of a refusal is the same over MCP (spec\n   266\t\t// pose-delegation-mcp R5).\n   267\t\tif code := posemodel.DelegationReasonCode(err); code != \"\" {\n   268\t\t\tdoc[\"reason_code\"] = code\n   269\t\t}\n   270\t\tvar ambiguous *posemodel.ErrDelegationRefAmbiguous\n   271\t\tif errors.As(err, &ambiguous) {\n   272\t\t\tdoc[\"candidates\"] = ambiguous.Candidates\n   273\t\t}\n   274\t\thandBackRefusal(doc, code)\n   275\t\tif jsonOut {\n   276\t\t\twriteDelegateJSON(stdout, doc)\n   277\t\t\treturn code\n   278\t\t}\n   279\t\tif code == 2 {\n   280\t\t\treturn usageError(stderr, \"pose delegate \"+command+\": \"+msg)\n   281\t\t}\n   282\t\trender(stdout, stderr).Failure(\"pose delegate \" + command + \": \" + msg)\n   283\t\treturn code\n   284\t}\n   285\t\n   286\t// refError renders a reference error in the person's locale.\n   287\tfunc refError(err error) error {\n   288\t\tvar ambiguous *posemodel.ErrDelegationRefAmbiguous\n   289\t\tif errors.As(err, &ambiguous) {\n   290\t\t\treturn localizedRefError{err: ambiguous, msg: tr(err.Error(), \"a referência nomeia mais de um run delegado: \"+strings.Join(ambiguous.Candidates, \", \"))}\n   291\t\t}\n   292\t\tvar unknown *posemodel.ErrDelegationRefUnknown\n   293\t\tif errors.As(err, &unknown) {\n   294\t\t\treturn errors.New(tr(err.Error(), \"nenhum run delegado corresponde à referência (um id de run, um id de tentativa, um label ou um prefixo de sessão de seis caracteres ou mais)\"))\n   295\t\t}\n   296\t\treturn err\n   297\t}\n   298\t\n   299\t// localizedRefError words a reference error in the person's locale and keeps\n   300\t// the engine's error, so the error document still carries its candidates.\n   301\ttype localizedRefError struct {\n   302\t\terr error\n   303\t\tmsg string\n   304\t}\n   305\t\n   306\tfunc (e localizedRefError) Error() string { return e.msg }\n   307\tfunc (e localizedRefError) Unwrap() error { return e.err }\n   308\t\n   309\t// mismatch names the first selecting flag an attempt does not match.\n   310\tfunc (f delegateFlags) mismatch(a posemodel.DelegationAttempt) string {\n   311\t\tswitch {\n   312\t\tcase f.agent != \"\" && f.agent != \"auto\" && f.agent != a.Agent:\n   313\t\t\treturn \"--agent \" + f.agent\n   314\t\tcase f.access != \"\" && f.access != a.Access:\n   315\t\t\treturn \"--access \" + f.access\n   316\t\tcase f.label != \"\" && f.label != a.Label:\n   317\t\t\treturn \"--label \" + f.label\n   318\t\tcase f.lead != \"\" && f.lead != a.Lead && leadVendor(f.lead) != a.Lead:\n   319\t\t\treturn \"--lead \" + f.lead\n   320\t\t}\n   321\t\treturn \"\"\n   322\t}\n   323\t\n   324\t// namedAttempt resolves the one reference a lifecycle command takes: the\n   325\t// positional reference, or --label when there is none; the other common\n   326\t// flags then select, and a run that does not match is refused.\n   327\tfunc namedAttempt(attempts []posemodel.DelegationAttempt, f delegateFlags) (posemodel.DelegationAttempt, int, error) {\n   328\t\tref := \"\"\n   329\t\tswitch len(f.positional) {\n   330\t\tcase 0:\n   331\t\t\tref = f.label\n   332\t\tcase 1:\n   333\t\t\tref = f.positional[0]\n   334\t\tdefault:\n   335\t\t\treturn posemodel.DelegationAttempt{}, 2, errors.New(tr(\"one run reference at most\", \"no máximo uma referência de run\"))\n   336\t\t}\n   337\t\tif ref == \"\" {\n   338\t\t\treturn posemodel.DelegationAttempt{}, 2, errors.New(tr(\"name a run (a run id, an attempt id, a label or a session prefix)\", \"nomeie um run (id de run, id de tentativa, label ou prefixo de sessão)\"))\n   339\t\t}\n   340\t\tattempt, err := posemodel.ResolveDelegationRef(attempts, ref)\n   341\t\tif err != nil {\n   342\t\t\treturn attempt, 2, refError(err)\n   343\t\t}\n   344\t\tif flag := f.mismatch(attempt); flag != \"\" {\n   345\t\t\treturn attempt, 2, errors.New(tr(\"attempt \"+attempt.AttemptID+\" does not match \"+flag, \"a tentativa \"+attempt.AttemptID+\" não corresponde a \"+flag))\n   346\t\t}\n   347\t\treturn attempt, 0, nil\n   348\t}\n   349\t\n   350\t// routeDelegateAgent applies --agent (spec pose-delegation-routing R5–R9): a\n   351\t// name is taken as given and the run still records the independence it\n   352\t// achieves; auto (or no flag) routes among the agents that can run the\n   353\t// purpose. The returned warnings go to stderr.\n   354\tfunc routeDelegateAgent(store posemodel.Store, kind, ref, notes string, f delegateFlags, now time.Time) (string, *posemodel.DelegationRoutingRecord, string, int, error) {\n   355\t\treaders, found, err := store.LoadReviewersPolicyFor(kind)\n   356\t\tif err != nil {\n   357\t\t\treturn \"\", nil, \"\", 1, err\n   358\t\t}\n   359\t\tif !found || len(readers.Adapters) == 0 {\n   360\t\t\treturn \"\", nil, \"\", 1, posemodel.ErrNoReviewerAdapter\n   361\t\t}\n   362\t\tpolicy, _, _, err := store.LoadDelegationPolicy()\n   363\t\tif err != nil {\n   364\t\t\treturn \"\", nil, \"\", 1, err\n   365\t\t}\n   366\t\tbrief, err := store.RenderReviewBrief(ref, kind, notes)\n   367\t\tif err != nil {\n   368\t\t\treturn \"\", nil, \"\", 1, err\n   369\t\t}\n   370\t\tbundle, err := store.LoadReviewBundle(brief.BundleID)\n   371\t\tif err != nil {\n   372\t\t\treturn \"\", nil, \"\", 1, err\n   373\t\t}\n   374\t\treviewPolicy, err := store.GetReviewPolicy()\n   375\t\tif err != nil {\n   376\t\t\treturn \"\", nil, bundle.BundleID, 1, err\n   377\t\t}\n   378\t\texecutionRequired := reviewPolicy.DelegatedReview || bundle.Payload.Plan.DelegatedRunProofRequired\n   379\t\tif executionRequired && bundle.Payload.Plan.Independence == \"mandatory-human\" {\n   380\t\t\treturn \"\", nil, bundle.BundleID, 1, &posemodel.ErrNoDelegationAgentAvailable{}\n   381\t\t}\n   382\t\tif f.agent != \"\" && f.agent != \"auto\" {\n   383\t\t\t// A named agent is recorded by the plan itself (R9).\n   384\t\t\treturn f.agent, nil, bundle.BundleID, 0, nil\n   385\t\t}\n   386\t\timpl, from, err := store.RoutingImplementation(bundle, policy, f.lead)\n   387\t\tif err != nil {\n   388\t\t\treturn \"\", nil, \"\", 2, err\n   389\t\t}\n   390\t\teligible := make([]string, 0, len(readers.Adapters))\n   391\t\tfor name := range readers.Adapters {\n   392\t\t\teligible = append(eligible, name)\n   393\t\t}\n   394\t\tavail := store.DelegationAvailabilityOf(policy, now, true)\n   395\t\tif executionRequired && bundle.Payload.Plan.Independence == \"different-actor\" {\n   396\t\t\tfor name, candidate := range policy.Agents {\n   397\t\t\t\tachieved := posemodel.AchievedIndependence(impl.Vendor, impl.Model, candidate.Vendor, candidate.Model)\n   398\t\t\t\tif achieved != \"different-vendor\" && achieved != \"different-model\" {\n   399\t\t\t\t\ta := avail[name]\n   400\t\t\t\t\ta.State, a.Detail = posemodel.DelegationAgentIneligible, \"cannot establish required vendor/model independence\"\n   401\t\t\t\t\tavail[name] = a\n   402\t\t\t\t}\n   403\t\t\t}\n   404\t\t}\n   405\t\tagent, record, err := posemodel.RouteDelegation(policy, eligible, impl, from, avail, now)\n   406\t\tif err != nil {\n   407\t\t\treturn \"\", &record, bundle.BundleID, 1, err\n   408\t\t}\n   409\t\treturn agent, &record, bundle.BundleID, 0, nil\n   410\t}\n   411\t\n   412\t// leadVendor is the vendor part of a --lead value.\n   413\tfunc leadVendor(lead string) string {\n   414\t\tvendor, _, _ := strings.Cut(lead, \"/\")\n   415\t\treturn vendor\n   416\t}\n   417\t\n   418\t// waitForRoute sleeps until the reset the wait step chose, without polling,\n   419\t// or until ctx ends (R7).\n   420\tfunc waitForRoute(ctx context.Context, stderr io.Writer, record *posemodel.DelegationRoutingRecord, agent string) error {\n   421\t\tif record == nil || record.Step != posemodel.DelegationStepWait {\n   422\t\t\treturn nil\n   423\t\t}\n   424\t\tuntil, err := time.Parse(time.RFC3339Nano, record.WaitUntil)\n   425\t\tif err != nil {\n   426\t\t\treturn err\n   427\t\t}\n   428\t\trender(io.Discard, stderr).Hint(tr(\"pose delegate: every earlier agent is limited; waiting until \"+record.WaitUntil+\" to start \"+agent,\n   429\t\t\t\"pose delegate: todos os agentes anteriores estão limitados; esperando até \"+record.WaitUntil+\" para iniciar \"+agent))\n   430\t\ttimer := time.NewTimer(time.Until(until))\n   431\t\tdefer timer.Stop()\n   432\t\tselect {\n   433\t\tcase <-ctx.Done():\n   434\t\t\treturn ctx.Err()\n   435\t\tcase <-timer.C:\n   436\t\t\treturn nil\n   437\t\t}\n   438\t}\n   439\t\n   440\tfunc cmdDelegatePurpose(root, purpose string, args []string, stdout, stderr io.Writer) int {\n   441\t\tf, problem := parseDelegateFlags(args, \"--reason\", \"--note-file\", \"--detach\", \"--request\")\n   442\t\tif problem != \"\" {\n   443\t\t\treturn delegateUsage(stdout, stderr, args, purpose, problem)\n   444\t\t}\n   445\t\tif len(f.positional) != 1 {\n   446\t\t\treturn delegateUsage(stdout, stderr, args, purpose, tr(\"Usage: \", \"Uso: \")+\"pose delegate \"+purpose+\" <scope|bundle-id> [--agent auto|<name>] [--label <name>] [--lead <vendor>] [--reason <text>] [--note-file <path>] [--dry-run] [--json]\")\n   447\t\t}\n   448\t\t// A detached run is this command run again in its own session (R1).\n   449\t\tif f.detach && !f.dryRun && !delegateSupervised() {\n   450\t\t\treturn detachDelegateRun(root, purpose, args, f, stdout, stderr)\n   451\t\t}\n   452\t\t// R3: the review-path purposes read only.\n   453\t\tif f.access != \"\" && f.access != posemodel.DelegationAccessRead {\n   454\t\t\treturn delegateUsage(stdout, stderr, args, purpose, tr(\"runs with read access only; --access \"+f.access+\" is for pose delegate task\",\n   455\t\t\t\t\"roda só com acesso de leitura; --access \"+f.access+\" é para pose delegate task\"))\n   456\t\t}\n   457\t\tnotes := \"\"\n   458\t\tif f.noteFile != \"\" {\n   459\t\t\t// R5 of spec pose-review-readiness-before-seal: an oversized note is\n   460\t\t\t// named with its size and the limit, not as a generic adapter file.\n   461\t\t\tif info, err := os.Lstat(f.noteFile); err == nil && info.Mode().IsRegular() && info.Size() > posemodel.ReviewNotesMaxBytes {\n   462\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, fmt.Errorf(\"the note file %s has %d bytes; implementer notes must be at most %d bytes: shorten it\", f.noteFile, info.Size(), posemodel.ReviewNotesMaxBytes))\n   463\t\t\t}\n   464\t\t\traw, err := posemodel.ReadReviewAdapterFile(f.noteFile, posemodel.ReviewNotesMaxBytes)\n   465\t\t\tif err != nil {\n   466\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n   467\t\t\t}\n   468\t\t\tnotes = string(raw)\n   469\t\t}\n   470\t\tstore := cliGovernedStore(root)\n   471\t\ttarget := f.positional[0]\n   472\t\tref := target\n   473\t\tif !strings.HasPrefix(target, \"rvb-\") {\n   474\t\t\tresolved, err := resolveReviewBundleScope(store, target)\n   475\t\t\tif err != nil {\n   476\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n   477\t\t\t}\n   478\t\t\tref = resolved\n   479\t\t}\n   480\t\t// A run asked for by a delegated-review request runs the request's brief\n   481\t\t// with an agent it accepts, and fulfils it (spec\n   482\t\t// pose-delegated-review-action-fulfillment R3).\n   483\t\tvar request *posemodel.ActionRequestView\n   484\t\tif f.request != \"\" {\n   485\t\t\tview, err := delegateRequestFor(store, &f, purpose, ref, notes)\n   486\t\t\tif err != nil {\n   487\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n   488\t\t\t}\n   489\t\t\trequest = &view\n   490\t\t}\n   491\t\tkind := posemodel.DelegationKindForPurpose(purpose)\n   492\t\tagent, route, routedBundle, code, err := routeDelegateAgent(store, kind, ref, notes, f, time.Now())\n   493\t\tvar unavailable *posemodel.ErrNoDelegationAgentAvailable\n   494\t\tif f.dryRun && f.jsonOut && (errors.Is(err, posemodel.ErrNoReviewerAdapter) || errors.As(err, &unavailable)) {\n   495\t\t\trequired, policyErr := store.DelegatedReviewExecutionRequired(ref)\n   496\t\t\tif policyErr != nil {\n   497\t\t\t\treturn delegateFail(stdout, stderr, true, purpose, 1, policyErr)\n   498\t\t\t}\n   499\t\t\tif required {\n   500\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": purpose, \"error\": err.Error(), \"routing\": route, \"reason_code\": posemodel.DelegationReasonAgentUnavailable, \"escalation_required\": true})\n   501\t\t\t\treturn 1\n   502\t\t\t}\n   503\t\t}\n   504\t\tif !f.dryRun && (errors.Is(err, posemodel.ErrNoReviewerAdapter) || errors.As(err, &unavailable)) {\n   505\t\t\tid, escalationErr := store.EscalateUnavailableDelegation(ref, purpose, err.Error(), time.Now())\n   506\t\t\tif escalationErr != nil {\n   507\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, fmt.Errorf(\"%w; escalation could not be recorded: %v\", err, escalationErr))\n   508\t\t\t}\n   509\t\t\tif id != \"\" {\n   510\t\t\t\tif f.jsonOut {\n   511\t\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": purpose, \"error\": err.Error(), \"escalation\": id, \"routing\": route})\n   512\t\t\t\t\treturn 1\n   513\t\t\t\t}\n   514\t\t\t\treturn delegateFail(stdout, stderr, false, purpose, 1, fmt.Errorf(\"%w; decision request %s asks the maintainer how to proceed\", err, id))\n   515\t\t\t}\n   516\t\t}\n   517\t\tif errors.Is(err, posemodel.ErrNoReviewerAdapter) {\n   518\t\t\treturn delegateNoAgentWithBrief(store, ref, kind, notes, f, purpose, stdout, stderr)\n   519\t\t}\n   520\t\tif err != nil {\n   521\t\t\tvar none *posemodel.ErrNoDelegationAgentAvailable\n   522\t\t\tif errors.As(err, &none) && f.jsonOut {\n   523\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": purpose, \"error\": strings.TrimPrefix(err.Error(), \"pose: \"), \"routing\": none.Record, \"reason_code\": posemodel.DelegationReasonCode(err)})\n   524\t\t\t\treturn code\n   525\t\t\t}\n   526\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, code, err)\n   527\t\t}\n   528\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n   529\t\tdefer stop()\n   530\t\tif !f.dryRun && route != nil && route.Step == posemodel.DelegationStepWait {\n   531\t\t\t// A detached run hands its attempt back when it starts; one that would\n   532\t\t\t// first wait hours for a reset has none to hand back (D3).\n   533\t\t\tif delegateSupervised() {\n   534\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, errors.New(tr(\"every agent is limited until \"+route.WaitUntil+\"; a detached run does not wait for a reset: run it without --detach, or after the reset\",\n   535\t\t\t\t\t\"todos os agentes estão limitados até \"+route.WaitUntil+\"; um run destacado não espera um reset: rode sem --detach, ou depois do reset\")))\n   536\t\t\t}\n   537\t\t\tif err := waitForRoute(ctx, stderr, route, agent); err != nil {\n   538\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n   539\t\t\t}\n   540\t\t\t// The bundle or the policy may have changed during the wait: route\n   541\t\t\t// again against what the run will read, and start only the same agent\n   542\t\t\t// (R7, R8).\n   543\t\t\tagain, rerouted, rebundle, code, err := routeDelegateAgent(store, kind, ref, notes, f, time.Now())\n   544\t\t\tif err != nil {\n   545\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, code, err)\n   546\t\t\t}\n   547\t\t\tif again != agent || rebundle != routedBundle || rerouted.Step == posemodel.DelegationStepWait {\n   548\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, errors.New(tr(\"the bundle, the policy or the agents changed while waiting; run pose delegate again\",\n   549\t\t\t\t\t\"o bundle, a policy ou os agentes mudaram durante a espera; rode pose delegate de novo\")))\n   550\t\t\t}\n   551\t\t\troute.Implementation, route.ImplementationFrom = rerouted.Implementation, rerouted.ImplementationFrom\n   552\t\t}\n   553\t\tplan, err := store.PlanReviewDispatch(ref, kind, notes, agent, f.reason)\n   554\t\tif errors.Is(err, posemodel.ErrNoReviewerAdapter) {\n   555\t\t\treturn delegateNoAgentWithBrief(store, ref, kind, notes, f, purpose, stdout, stderr)\n   556\t\t}\n   557\t\tif err != nil {\n   558\t\t\tdelegateEscalateRefusal(store, request, err, f.dryRun, stdout, stderr)\n   559\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, err)\n   560\t\t}\n   561\t\tif request != nil && plan.Brief.Digest != request.Request.Review.BriefDigest {\n   562\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, errors.New(tr(\"the brief changed since request \"+request.Request.ID+\" was asked; ask it again\",\n   563\t\t\t\t\"o brief mudou desde que o request \"+request.Request.ID+\" foi pedido; peça de novo\")))\n   564\t\t}\n   565\t\tif plan.Bundle.BundleID != routedBundle {\n   566\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, purpose, 1, errors.New(tr(\"the bundle of the scope changed while the run was being routed; run pose delegate again\",\n   567\t\t\t\t\"o bundle do escopo mudou enquanto o run era roteado; rode pose delegate de novo\")))\n   568\t\t}\n   569\t\tplan.Label, plan.Purpose, plan.Lead = f.label, purpose, f.lead\n   570\t\twarnings := plan.Warnings\n   571\t\tif route == nil {\n   572\t\t\tstore.PlanImplementationWithLead(&plan, f.lead)\n   573\t\t\twarnings = plan.Warnings\n   574\t\t\tif plan.SameVendorWarning != \"\" {\n   575\t\t\t\twarnings = append(warnings, plan.SameVendorWarning)\n   576\t\t\t}\n   577\t\t} else {\n   578\t\t\tplan.Routing = route\n   579\t\t}\n   580\t\tfor _, warning := range warnings {\n   581\t\t\trender(stdout, stderr).Hint(\"pose delegate \" + purpose + \": \" + warning)\n   582\t\t}\n   583\t\timpl := plan.Implementation()\n   584\t\tindependence := posemodel.AchievedIndependence(impl.Vendor, impl.Model, plan.Config.Vendor, plan.Config.Model)\n   585\t\tif f.dryRun {\n   586\t\t\targv := redactArgv(posemodel.ReviewerArgv(plan.Config.Command, \"{output}\", \"\", plan.Effort, plan.Config.Effort), plan.Config)\n   587\t\t\treturn delegatePrintPlan(stdout, stderr, f.jsonOut, plan, argv, map[string]any{\"scope\": plan.Brief.Scope, \"bundle\": plan.Bundle.BundleID,\n   588\t\t\t\t\"brief_digest\": plan.Brief.Digest, \"prior_runs\": plan.PriorRuns, \"label\": plan.Label, \"lead\": plan.Lead,\n   589\t\t\t\t\"routing\": plan.Routing, \"independence\": independence, \"implementation\": posemodel.DescribeImplementation(impl)})\n   590\t\t}\n   591\t\tif delegateSupervised() {\n   592\t\t\tplan.OnStart = supervisorHandback()\n   593\t\t}\n   594\t\t// The containment the run will run under is disclosed before it runs, as\n   595\t\t// pose review dispatch disclosed it (spec pose-delegation-parity-gate R6;\n   596\t\t// review round 1, PG-R1-08); the JSON document carries it with the run.\n   597\t\tif safety, _ := posemodel.ResolveReviewerContainment(plan.Config); safety != nil && !f.jsonOut {\n   598\t\t\traw, _ := json.Marshal(safety)\n   599\t\t\trender(stdout, stderr).Field(\"delegate.safety\", string(raw))\n   600\t\t}\n   601\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n   602\t\thandBackExisting(run, err)\n   603\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n   604\t\tif request != nil {\n   605\t\t\tdelegateFulfilRequest(store, *request, run, err, stdout, stderr)\n   606\t\t}\n   607\t\tdelegateTerminalHook(store, run, err, stdout, stderr, purpose)\n   608\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, purpose, run, err, delegateRunNextActions(store, run, err)...)\n   609\t\tif err == nil && !f.jsonOut && !delegateSupervised() {\n   610\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n   611\t\t\t\treturn next\n   612\t\t\t}\n   613\t\t}\n   614\t\treturn code\n   615\t}\n   616\t\n   617\t// delegateNoAgentWithBrief refuses a review-path run no agent can take and\n   618\t// hands over the brief a reviewer would receive, so the review can still be\n   619\t// run by hand, as pose review dispatch did (spec pose-delegation-parity-gate\n   620\t// R6; review round 1, PG-R1-06).\n   621\tfunc delegateNoAgentWithBrief(store posemodel.Store, ref, kind, notes string, f delegateFlags, command string, stdout, stderr io.Writer) int {\n   622\t\tplan, _ := store.PlanReviewDispatch(ref, kind, notes, \"\", f.reason)\n   623\t\tbrief := plan.Brief.Text\n   624\t\tif brief == \"\" {\n   625\t\t\treturn delegateNoAgent(stdout, stderr, f.jsonOut, command)\n   626\t\t}\n   627\t\tif f.jsonOut {\n   628\t\t\tdoc := map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": strings.TrimPrefix(posemodel.ErrNoReviewerAdapter.Error(), \"pose: \"),\n   629\t\t\t\t\"brief\": brief, \"brief_digest\": plan.Brief.Digest}\n   630\t\t\tif code := posemodel.DelegationReasonCode(posemodel.ErrNoReviewerAdapter); code != \"\" {\n   631\t\t\t\tdoc[\"reason_code\"] = code\n   632\t\t\t}\n   633\t\t\thandBackRefusal(doc, 1)\n   634\t\t\twriteDelegateJSON(stdout, doc)\n   635\t\t\treturn 1\n   636\t\t}\n   637\t\tcode := delegateNoAgent(stdout, stderr, false, command)\n   638\t\tout := render(stdout, stderr)\n   639\t\tout.Hint(tr(\"The brief a reviewer would receive follows.\", \"O brief que um revisor receberia vem a seguir.\"))\n   640\t\tout.ContractLine(strings.TrimRight(brief, \"\\n\"))\n   641\t\treturn code\n   642\t}\n   643\t\n   644\tfunc delegateNoAgent(stdout, stderr io.Writer, jsonOut bool, command string) int {\n   645\t\t// The document keeps the typed refusal and no example: the example is\n   646\t\t// for a person reading the terminal (spec pose-delegation-mcp R5, R7).\n   647\t\tif jsonOut {\n   648\t\t\treturn delegateFail(stdout, stderr, true, command, 1, posemodel.ErrNoReviewerAdapter)\n   649\t\t}\n   650\t\texample, _ := posemodel.CanonicalDelegationPolicy(posemodel.ExampleDelegationPolicy())\n   651\t\terr := errors.New(tr(\"no agent is configured; add .pose/policy/delegation.json, for example:\\n\", \"nenhum agente configurado; adicione .pose/policy/delegation.json, por exemplo:\\n\") + string(example))\n   652\t\treturn delegateFail(stdout, stderr, jsonOut, command, 1, err)\n   653\t}\n   654\t\n   655\t// delegateGivenRoot checks the root a caller names: an absolute directory\n   656\t// holding a POSE instance.\n   657\tfunc delegateGivenRoot(root string) (string, error) {\n   658\t\tif !filepath.IsAbs(root) {\n   659\t\t\treturn \"\", errors.New(posemodel.DelegateRootEnv + \" must be an absolute path\")\n   660\t\t}\n   661\t\tif info, err := os.Stat(filepath.Join(root, \".pose\")); err != nil || !info.IsDir() {\n   662\t\t\treturn \"\", errors.New(posemodel.DelegateRootEnv + \" names no POSE instance\")\n   663\t\t}\n   664\t\treturn filepath.Clean(root), nil\n   665\t}\n   666\t\n   667\t// delegateTerminalHook runs the policy's on_terminal hook once the run is\n   668\t// recorded, and says so when it failed; the run's state does not change (R7).\n   669\tfunc delegateTerminalHook(store posemodel.Store, run posemodel.ReviewRun, err error, stdout, stderr io.Writer, command string) {\n   670\t\tif err != nil || run.RunID == \"\" {\n   671\t\t\treturn\n   672\t\t}\n   673\t\tif outcome := store.RunDelegationTerminalHook(run); outcome != nil && outcome.Failure != \"\" {\n   674\t\t\trender(stdout, stderr).Hint(\"pose delegate \" + command + \": on_terminal: \" + outcome.Failure)\n   675\t\t}\n   676\t}\n   677\t\n   678\t// routeSummary renders a routing decision for a person: the step chosen and\n   679\t// each agent skipped with its reason.\n   680\tfunc routeSummary(route *posemodel.DelegationRoutingRecord) string {\n   681\t\ttext := \"step=\" + route.Step\n   682\t\tif route.WaitUntil != \"\" {\n   683\t\t\ttext += \" wait_until=\" + route.WaitUntil\n   684\t\t}\n   685\t\tfor _, c := range route.Candidates {\n   686\t\t\tif c.Skipped != \"\" {\n   687\t\t\t\ttext += \"; \" + c.Agent + \" \" + tr(\"skipped\", \"ignorado\") + \": \" + c.Skipped\n   688\t\t\t}\n   689\t\t}\n   690\t\treturn text\n   691\t}\n   692\t\n   693\t// redactArgv hides the values of the credentials an agent is authorized to\n   694\t// receive, wherever a template carries them (security of R12).\n   695\tfunc redactArgv(argv []string, config posemodel.ReviewerAdapter) []string {\n   696\t\tout := append([]string(nil), argv...)\n   697\t\tif config.Containment == nil {\n   698\t\t\treturn out\n   699\t\t}\n   700\t\t// One pass, the longest value first: a credential that contains another\n   701\t\t// is replaced whole, whatever order the policy lists them in, and a\n   702\t\t// replacement is never scanned again (review round 3 of\n   703\t\t// pose-delegation-task, R3-B1).\n   704\t\tvar values []string\n   705\t\tfor _, name := range config.Containment.Credentials {\n   706\t\t\tif value := os.Getenv(name); len(value) >= 4 {\n   707\t\t\t\tvalues = append(values, value)\n   708\t\t\t}\n   709\t\t}\n   710\t\tsort.Slice(values, func(i, j int) bool { return len(values[i]) > len(values[j]) })\n   711\t\tpairs := make([]string, 0, 2*len(values))\n   712\t\tfor _, value := range values {\n   713\t\t\tpairs = append(pairs, value, \"[credential]\")\n   714\t\t}\n   715\t\tif len(pairs) == 0 {\n   716\t\t\treturn out\n   717\t\t}\n   718\t\treplacer := strings.NewReplacer(pairs...)\n   719\t\tfor i := range out {\n   720\t\t\tout[i] = replacer.Replace(out[i])\n   721\t\t}\n   722\t\treturn out\n   723\t}\n   724\t\n   725\t// delegatePrintPlan prints what a run would do (R12): agent, purpose, access,\n   726\t// working directory and argv, plus the fields of the command at hand.\n   727\tfunc delegatePrintPlan(stdout, stderr io.Writer, jsonOut bool, plan posemodel.DispatchPlan, argv []string, extra map[string]any) int {\n   728\t\tworkdir := tr(\"a disposable worktree at \", \"um worktree descartável em \") + plan.SealedCommit\n   729\t\tdoc := map[string]any{\"schema\": delegatePlanSchema, \"purpose\": plan.Purpose, \"agent\": plan.Adapter, \"vendor\": plan.Config.Vendor, \"model\": plan.Config.Model,\n   730\t\t\t\"access\": posemodel.DelegationAccessRead, \"workdir\": workdir, \"argv\": argv, \"reserves_attempt\": false}\n   731\t\tfor k, v := range extra {\n   732\t\t\tdoc[k] = v\n   733\t\t}\n   734\t\t// The containment a run would run under is disclosed before it runs, as\n   735\t\t// pose review dispatch did (spec pose-delegated-adapter-containment;\n   736\t\t// pose-delegation-parity-gate R6).\n   737\t\tsafety, _ := posemodel.ResolveReviewerContainment(plan.Config)\n   738\t\tif safety != nil {\n   739\t\t\tdoc[\"safety\"] = safety\n   740\t\t}\n   741\t\tif jsonOut {\n   742\t\t\twriteDelegateJSON(stdout, doc)\n   743\t\t\treturn 0\n   744\t\t}\n   745\t\tout := render(stdout, stderr)\n   746\t\tout.Field(\"delegate.purpose\", plan.Purpose)\n   747\t\tout.Field(\"delegate.agent\", fmt.Sprintf(\"%s (%s %s)\", plan.Adapter, plan.Config.Vendor, plan.Config.Model))\n   748\t\tout.Field(\"delegate.access\", posemodel.DelegationAccessRead)\n   749\t\tout.Field(\"delegate.workdir\", workdir)\n   750\t\traw, _ := json.Marshal(argv)\n   751\t\tout.Field(\"delegate.argv\", string(raw))\n   752\t\tif safety != nil {\n   753\t\t\traw, _ := json.Marshal(safety)\n   754\t\t\tout.Field(\"delegate.safety\", string(raw))\n   755\t\t}\n   756\t\tkeys := make([]string, 0, len(extra))\n   757\t\tfor k := range extra {\n   758\t\t\tkeys = append(keys, k)\n   759\t\t}\n   760\t\tsort.Strings(keys)\n   761\t\tfor _, k := range keys {\n   762\t\t\tif route, ok := extra[k].(*posemodel.DelegationRoutingRecord); ok {\n   763\t\t\t\tif route != nil {\n   764\t\t\t\t\tout.Field(\"delegate.routing\", routeSummary(route))\n   765\t\t\t\t}\n   766\t\t\t\tcontinue\n   767\t\t\t}\n   768\t\t\tif value := fmt.Sprint(extra[k]); value != \"\" {\n   769\t\t\t\tout.Field(\"delegate.\"+k, value)\n   770\t\t\t}\n   771\t\t}\n   772\t\tout.Field(\"delegate.dry_run\", tr(\"true (nothing reserved or claimed)\", \"true (nada reservado nem reivindicado)\"))\n   773\t\treturn 0\n   774\t}\n   775\t\n   776\tfunc delegatePrintRun(stdout, stderr io.Writer, jsonOut bool, command string, run posemodel.ReviewRun, err error, next ...delegateNextAction) int {\n   777\t\tcode := 0\n   778\t\tif err != nil || run.Status != posemodel.ReviewRunCompleted {\n   779\t\t\tcode = 1\n   780\t\t}\n   781\t\tattestation := tr(\"not recorded: a run's conclusion is recorded only by the engine's verified step\", \"não registrada: a conclusão de um run só é registrada pelo passo verificado do motor\")\n   782\t\tif jsonOut {\n   783\t\t\tdoc := map[string]any{\"schema\": delegateRunSchema, \"purpose\": run.Purpose, \"agent\": run.Adapter, \"vendor\": run.Vendor, \"model\": run.Model,\n   784\t\t\t\t\"label\": run.Label, \"lead\": run.Lead, \"scope\": run.Scope, \"bundle\": run.BundleID, \"attempt\": run.AttemptID, \"run\": run.RunID, \"resumes\": run.Resumes, \"hands_off_from\": run.HandsOffFrom,\n   785\t\t\t\t\"status\": run.Status, \"failure\": run.Failure, \"record\": run.Path, \"events\": run.EventsDigest != \"\", \"env_removed\": run.EnvRemoved, \"attestation\": attestation}\n   786\t\t\tif run.Interruption != nil {\n   787\t\t\t\tdoc[\"interruption\"] = run.Interruption\n   788\t\t\t}\n   789\t\t\tif run.Safety != nil {\n   790\t\t\t\tdoc[\"safety\"] = run.Safety\n   791\t\t\t}\n   792\t\t\tif len(next) > 0 {\n   793\t\t\t\tdoc[\"next_actions\"] = next\n   794\t\t\t}\n   795\t\t\tif err != nil {\n   796\t\t\t\tdoc[\"error\"] = strings.TrimPrefix(err.Error(), \"pose: \")\n   797\t\t\t}\n   798\t\t\twriteDelegateJSON(stdout, doc)\n   799\t\t\treturn code\n   800\t\t}\n   801\t\tout := render(stdout, stderr)\n   802\t\tif run.RunID != \"\" {\n   803\t\t\tout.Field(\"delegate.purpose\", run.Purpose)\n   804\t\t\tout.Field(\"delegate.agent\", fmt.Sprintf(\"%s (%s %s)\", run.Adapter, run.Vendor, run.Model))\n   805\t\t\tif run.Label != \"\" {\n   806\t\t\t\tout.Field(\"delegate.label\", run.Label)\n   807\t\t\t}\n   808\t\t\tout.Field(\"delegate.attempt\", run.AttemptID)\n   809\t\t\tif run.Resumes != \"\" {\n   810\t\t\t\tout.Field(\"delegate.resumes\", run.Resumes)\n   811\t\t\t}\n   812\t\t\tif run.HandsOffFrom != \"\" {\n   813\t\t\t\tout.Field(\"delegate.hands_off_from\", run.HandsOffFrom)\n   814\t\t\t}\n   815\t\t\tout.Field(\"delegate.run\", run.RunID)\n   816\t\t\t// R9 outside a terminal: the ways forward of a stopped run.\n   817\t\t\tfor _, action := range next {\n   818\t\t\t\tvalue := action.Command\n   819\t\t\t\tif !action.Available {\n   820\t\t\t\t\tvalue = tr(\"unavailable: \", \"indisponível: \") + action.Why\n   821\t\t\t\t} else if value == \"\" {\n   822\t\t\t\t\tvalue = action.Why\n   823\t\t\t\t}\n   824\t\t\t\tout.Field(\"delegate.next.\"+action.Action, value)\n   825\t\t\t}\n   826\t\t\tout.Field(\"delegate.status\", run.Status)\n   827\t\t\tif run.Failure != \"\" {\n   828\t\t\t\tout.Field(\"delegate.failure\", run.Failure)\n   829\t\t\t}\n   830\t\t\tif run.Interruption != nil {\n   831\t\t\t\tout.Field(\"delegate.interruption\", fmt.Sprintf(\"cause=%s resumable=%t reset_at=%s\", run.Interruption.Cause, run.Interruption.Resumable, run.Interruption.ResetAt))\n   832\t\t\t}\n   833\t\t\tif run.Safety != nil {\n   834\t\t\t\traw, _ := json.Marshal(run.Safety)\n   835\t\t\t\tout.Field(\"delegate.safety\", string(raw))\n   836\t\t\t}\n   837\t\t\tout.Field(\"delegate.record\", run.Path)\n   838\t\t\tout.Field(\"delegate.attestation\", attestation)\n   839\t\t}\n   840\t\tif err != nil {\n   841\t\t\tout.Failure(\"pose delegate \" + command + \": \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   842\t\t}\n   843\t\treturn code\n   844\t}\n   845\t\n   846\tfunc delegateAge(at string) string {\n   847\t\tt, err := time.Parse(time.RFC3339Nano, at)\n   848\t\tif err != nil {\n   849\t\t\treturn \"unknown\"\n   850\t\t}\n   851\t\td := time.Since(t)\n   852\t\tswitch {\n   853\t\tcase d < time.Minute:\n   854\t\t\treturn fmt.Sprintf(\"%ds\", int(d.Seconds()))\n   855\t\tcase d < time.Hour:\n   856\t\t\treturn fmt.Sprintf(\"%dm\", int(d.Minutes()))\n   857\t\tcase d < 48*time.Hour:\n   858\t\t\treturn fmt.Sprintf(\"%dh\", int(d.Hours()))\n   859\t\t}\n   860\t\treturn fmt.Sprintf(\"%dd\", int(d.Hours()/24))\n   861\t}\n   862\t\n   863\tfunc cmdDelegateLs(root string, args []string, stdout, stderr io.Writer) int {\n   864\t\tf, problem := parseDelegateFlags(args, \"--active\")\n   865\t\tif problem == \"\" && len(f.positional) > 1 {\n   866\t\t\tproblem = tr(\"one reference at most\", \"no máximo uma referência\")\n   867\t\t}\n   868\t\tif problem != \"\" {\n   869\t\t\treturn delegateUsage(stdout, stderr, args, \"ls\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate ls [<run>|<bundle-id>] [--active] [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>] [--json]\")\n   870\t\t}\n   871\t\tstore := posemodel.Store{Root: root}\n   872\t\tattempts, lost, err := store.ListDelegationAttempts()\n   873\t\tif err != nil {\n   874\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 1, err)\n   875\t\t}\n   876\t\tif len(f.positional) == 1 && !strings.HasPrefix(f.positional[0], \"rvb-\") {\n   877\t\t\tone, err := posemodel.ResolveDelegationRef(attempts, f.positional[0])\n   878\t\t\tif err != nil {\n   879\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, withDelegationLosses(refError(err), lost))\n   880\t\t\t}\n   881\t\t\t// A named run is refused when a selecting flag does not match it, as on\n   882\t\t\t// every other lifecycle command (D8); without a reference they filter.\n   883\t\t\tif flag := f.mismatch(one); flag != \"\" {\n   884\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, errors.New(tr(\"attempt \"+one.AttemptID+\" does not match \"+flag, \"a tentativa \"+one.AttemptID+\" não corresponde a \"+flag)))\n   885\t\t\t}\n   886\t\t\tattempts = []posemodel.DelegationAttempt{one}\n   887\t\t}\n   888\t\tselected := []posemodel.DelegationAttempt{}\n   889\t\tfor _, a := range attempts {\n   890\t\t\tif len(f.positional) == 1 && strings.HasPrefix(f.positional[0], \"rvb-\") && a.BundleID != f.positional[0] {\n   891\t\t\t\tcontinue\n   892\t\t\t}\n   893\t\t\tif f.active && !a.Active || f.mismatch(a) != \"\" {\n   894\t\t\t\tcontinue\n   895\t\t\t}\n   896\t\t\tselected = append(selected, a)\n   897\t\t}\n   898\t\tif lost == nil {\n   899\t\t\tlost = []string{}\n   900\t\t}\n   901\t\tif f.jsonOut {\n   902\t\t\t// R9: a stopped attempt carries the ways forward it has now.\n   903\t\t\ttype listed struct {\n   904\t\t\t\tposemodel.DelegationAttempt\n   905\t\t\t\tNextActions []delegateNextAction `json:\"next_actions,omitempty\"`\n   906\t\t\t}\n   907\t\t\trows := make([]listed, 0, len(selected))\n   908\t\t\tfor _, a := range selected {\n   909\t\t\t\trows = append(rows, listed{a, delegateNextActions(store, a)})\n   910\t\t\t}\n   911\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateListSchema, \"attempts\": rows, \"losses\": lost})\n   912\t\t} else {\n   913\t\t\tout := render(stdout, stderr)\n   914\t\t\tif len(selected) == 0 {\n   915\t\t\t\tout.Field(\"delegate.runs\", tr(\"none\", \"nenhum\"))\n   916\t\t\t}\n   917\t\t\tfor _, a := range selected {\n   918\t\t\t\tvalue := fmt.Sprintf(\"state=%s purpose=%s agent=%s turns=%d age=%s\", a.State, a.Purpose, a.Agent, a.Turns, delegateAge(a.StartedAt))\n   919\t\t\t\tif a.Round > 0 {\n   920\t\t\t\t\tvalue += fmt.Sprintf(\" round=%d\", a.Round)\n   921\t\t\t\t}\n   922\t\t\t\tif a.Label != \"\" {\n   923\t\t\t\t\tvalue += \" label=\" + a.Label\n   924\t\t\t\t}\n   925\t\t\t\tif a.Active && a.Liveness != \"\" {\n   926\t\t\t\t\tvalue += \" owner=\" + a.Liveness\n   927\t\t\t\t}\n   928\t\t\t\tif a.HeartbeatAge != \"\" {\n   929\t\t\t\t\tvalue += \" heartbeat=\" + a.HeartbeatAge\n   930\t\t\t\t}\n   931\t\t\t\tif a.StalledAt != \"\" {\n   932\t\t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n   933\t\t\t\t}\n   934\t\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n   935\t\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n   936\t\t\t\t}\n   937\t\t\t\tif a.HookFailure != \"\" {\n   938\t\t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n   939\t\t\t\t}\n   940\t\t\t\tif a.Interruption != nil {\n   941\t\t\t\t\tvalue += fmt.Sprintf(\" cause=%s resumable=%t partial=%t\", a.Interruption.Cause, a.Interruption.Resumable, a.Partial)\n   942\t\t\t\t\tif a.Interruption.ResetAt != \"\" {\n   943\t\t\t\t\t\tvalue += \" reset_at=\" + a.Interruption.ResetAt + \" time_left=\" + a.TimeLeft\n   944\t\t\t\t\t}\n   945\t\t\t\t}\n   946\t\t\t\tif a.LatestRun != \"\" {\n   947\t\t\t\t\tvalue += \" run=\" + a.LatestRun\n   948\t\t\t\t}\n   949\t\t\t\tif a.LastStep != \"\" {\n   950\t\t\t\t\tvalue += \" last=\" + a.LastStep\n   951\t\t\t\t}\n   952\t\t\t\tout.Field(\"delegate.\"+a.AttemptID, value)\n   953\t\t\t}\n   954\t\t\tfor _, loss := range lost {\n   955\t\t\t\tout.Failure(tr(\"delegated run history incomplete: \", \"histórico de runs delegados incompleto: \") + loss)\n   956\t\t\t}\n   957\t\t}\n   958\t\tif len(lost) > 0 {\n   959\t\t\treturn 1\n   960\t\t}\n   961\t\treturn 0\n   962\t}\n   963\t\n   964\t// resumeTarget is the run a resume continues (R11 with the delivered\n   965\t// continuity): the run named by its id, or the attempt's latest run when it\n   966\t// is interrupted, or the interrupted run the latest one continued, whose\n   967\t// recorded continuation is then returned instead of a new run.\n   968\tfunc resumeTarget(attempt posemodel.DelegationAttempt, ref string) (string, error) {\n   969\t\tif containsString(attempt.Runs, ref) {\n   970\t\t\treturn ref, nil\n   971\t\t}\n   972\t\tlatest := attempt.Latest()\n   973\t\tswitch {\n   974\t\tcase latest == nil:\n   975\t\t\treturn \"\", errors.New(tr(\"attempt \"+attempt.AttemptID+\" has no recorded run\", \"a tentativa \"+attempt.AttemptID+\" não tem run registrado\"))\n   976\t\tcase latest.Status == posemodel.ReviewRunInterrupted:\n   977\t\t\treturn latest.RunID, nil\n   978\t\tcase latest.Resumes != \"\":\n   979\t\t\treturn latest.Resumes, nil\n   980\t\t}\n   981\t\treturn \"\", errors.New(tr(\"the latest run of attempt \"+attempt.AttemptID+\" is \"+latest.Status+\", not interrupted\",\n   982\t\t\t\"o run mais recente da tentativa \"+attempt.AttemptID+\" está \"+latest.Status+\", não interrompido\"))\n   983\t}\n   984\t\n   985\tfunc cmdDelegateResume(root string, args []string, stdout, stderr io.Writer) int {\n   986\t\tf, problem := parseDelegateFlags(args, \"--wait-until-reset\", \"--prompt\", \"--detach\")\n   987\t\tif problem != \"\" {\n   988\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate resume <run> [--wait-until-reset[=<max>]] [--prompt <file|->] [--detach] [--dry-run] [--json]\")\n   989\t\t}\n   990\t\t// A detached resume is this command run again in its own session (spec\n   991\t\t// pose-delegation-mcp R4); it hands its attempt back once it starts.\n   992\t\tif f.detach && !f.dryRun && !delegateSupervised() {\n   993\t\t\tif f.wait {\n   994\t\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", tr(\"--detach does not wait for a reset: resume after it, or without --detach\", \"--detach não espera um reset: retome depois dele, ou sem --detach\"))\n   995\t\t\t}\n   996\t\t\treturn detachDelegateRun(root, \"resume\", args, f, stdout, stderr)\n   997\t\t}\n   998\t\tstore := cliGovernedStore(root)\n   999\t\tattempts, _, err := store.ListDelegationAttempts()\n  1000\t\tif err != nil {\n  1001\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1002\t\t}\n  1003\t\tattempt, code, err := namedAttempt(attempts, f)\n  1004\t\tif err != nil {\n  1005\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", code, err)\n  1006\t\t}\n  1007\t\tif attempt.Active {\n  1008\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, errors.New(tr(\"attempt \"+attempt.AttemptID+\" is still running\", \"a tentativa \"+attempt.AttemptID+\" ainda está rodando\")))\n  1009\t\t}\n  1010\t\tref := attempt.AttemptID\n  1011\t\tif len(f.positional) == 1 {\n  1012\t\t\tref = f.positional[0]\n  1013\t\t}\n  1014\t\ttarget, err := resumeTarget(attempt, ref)\n  1015\t\tif err != nil {\n  1016\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1017\t\t}\n  1018\t\tif attempt.Purpose == posemodel.DelegationPurposeTask {\n  1019\t\t\treturn cmdDelegateTaskResume(root, store, f, attempt, target, stdout, stderr)\n  1020\t\t}\n  1021\t\tif f.promptFile != \"\" {\n  1022\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", tr(\"--prompt is for a task; a review is resumed with its own brief\", \"--prompt é para uma task; uma review é retomada com o próprio brief\"))\n  1023\t\t}\n  1024\t\tplan, err := store.PlanReviewResume(target)\n  1025\t\tif err != nil {\n  1026\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1027\t\t}\n  1028\t\tif pending := plan.PendingContinuation; pending != nil {\n  1029\t\t\t// A continuation already reserved is answered, as pose review resume\n  1030\t\t\t// answered it: pending, with its ids, and no second process (spec\n  1031\t\t\t// pose-delegation-parity-gate R6; review round 1, PG-R1-07).\n  1032\t\t\thandBackAttempt(pending.AttemptID)\n  1033\t\t\tif f.jsonOut {\n  1034\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateRunSchema, \"purpose\": attempt.Purpose, \"attempt\": pending.AttemptID, \"resumes\": pending.Predecessor,\n  1035\t\t\t\t\t\"continuation\": pending.ID, \"status\": \"pending\"})\n  1036\t\t\t\treturn 0\n  1037\t\t\t}\n  1038\t\t\tout := render(stdout, stderr)\n  1039\t\t\tout.Field(\"delegate.resumes\", pending.Predecessor)\n  1040\t\t\tout.Field(\"delegate.continuation\", pending.ID)\n  1041\t\t\tout.Field(\"delegate.attempt\", pending.AttemptID)\n  1042\t\t\tout.Field(\"delegate.status\", \"pending\")\n  1043\t\t\treturn 0\n  1044\t\t}\n  1045\t\tvar delay time.Duration\n  1046\t\tif f.wait && plan.Existing == nil {\n  1047\t\t\tvar seed [1]byte\n  1048\t\t\tif _, err := rand.Read(seed[:]); err != nil {\n  1049\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1050\t\t\t}\n  1051\t\t\tvar prior posemodel.ReviewRun\n  1052\t\t\tif latest := attempt.Latest(); latest != nil && latest.RunID == target {\n  1053\t\t\t\tprior = *latest\n  1054\t\t\t} else if runs, rerr := store.ListReviewRuns(\"\"); rerr == nil {\n  1055\t\t\t\tfor _, r := range runs {\n  1056\t\t\t\t\tif r.RunID == target {\n  1057\t\t\t\t\t\tprior = r\n  1058\t\t\t\t\t}\n  1059\t\t\t\t}\n  1060\t\t\t}\n  1061\t\t\tdelay, err = posemodel.ReviewResumeDelay(prior, time.Now(), f.waitMax, time.Duration(seed[0])*time.Second/255)\n  1062\t\t\tif err != nil {\n  1063\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1064\t\t\t}\n  1065\t\t}\n  1066\t\tif f.dryRun {\n  1067\t\t\textra := map[string]any{\"resumes\": target, \"attempt\": attempt.AttemptID, \"label\": attempt.Label}\n  1068\t\t\tif plan.Existing != nil {\n  1069\t\t\t\textra[\"recorded_continuation\"] = plan.Existing.RunID\n  1070\t\t\t}\n  1071\t\t\tif f.wait {\n  1072\t\t\t\textra[\"wait\"] = delay.String()\n  1073\t\t\t}\n  1074\t\t\tplan.Purpose = attempt.Purpose\n  1075\t\t\targv := redactArgv(posemodel.ReviewerArgv(plan.Config.Resume.Command, \"{output}\", \"{session}\", plan.Effort, plan.Config.Effort), plan.Config)\n  1076\t\t\treturn delegatePrintPlan(stdout, stderr, f.jsonOut, plan, argv, extra)\n  1077\t\t}\n  1078\t\tif delay > 0 {\n  1079\t\t\tif !f.jsonOut {\n  1080\t\t\t\trender(stdout, stderr).Field(\"delegate.wait\", delay.String())\n  1081\t\t\t}\n  1082\t\t\ttime.Sleep(delay)\n  1083\t\t\tif plan, err = store.PlanReviewResume(target); err != nil {\n  1084\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1085\t\t\t}\n  1086\t\t}\n  1087\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n  1088\t\tdefer stop()\n  1089\t\tif delegateSupervised() {\n  1090\t\t\tplan.OnStart = supervisorHandback()\n  1091\t\t}\n  1092\t\t// The containment the run will run under is disclosed before it runs, as\n  1093\t\t// pose review dispatch disclosed it (spec pose-delegation-parity-gate R6;\n  1094\t\t// review round 1, PG-R1-08); the JSON document carries it with the run.\n  1095\t\tif safety, _ := posemodel.ResolveReviewerContainment(plan.Config); safety != nil && !f.jsonOut {\n  1096\t\t\traw, _ := json.Marshal(safety)\n  1097\t\t\trender(stdout, stderr).Field(\"delegate.safety\", string(raw))\n  1098\t\t}\n  1099\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n  1100\t\thandBackExisting(run, err)\n  1101\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n  1102\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"resume\")\n  1103\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"resume\", run, err, delegateRunNextActions(store, run, err)...)\n  1104\t\tif err == nil && !f.jsonOut {\n  1105\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n  1106\t\t\t\treturn next\n  1107\t\t\t}\n  1108\t\t}\n  1109\t\treturn code\n  1110\t}\n  1111\t\n  1112\tfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n  1113\t\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n  1114\t\tif problem != \"\" {\n  1115\t\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n  1116\t\t}\n  1117\t\tstore := posemodel.Store{Root: root}\n  1118\t\tattempts, lost, err := store.ListDelegationAttempts()\n  1119\t\tif err != nil {\n  1120\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1121\t\t}\n  1122\t\tattempt, code, err := namedAttempt(attempts, f)\n  1123\t\tif err != nil {\n  1124\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n  1125\t\t}\n  1126\t\tif !attempt.Active && !f.dryRun {\n  1127\t\t\t// An attempt whose dispatch, or whose earlier release, ended before\n  1128\t\t\t// its receipt is released with a failed run and its receipt, so it\n  1129\t\t\t// stops blocking the bundle; the release proves the abandonment\n  1130\t\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n  1131\t\t\t// review round 4, N1).\n  1132\t\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n  1133\t\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n  1134\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1135\t\t\t}\n  1136\t\t\tif err != nil {\n  1137\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1138\t\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1139\t\t\t}\n  1140\t\t\tif f.jsonOut {\n  1141\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n  1142\t\t\t\treturn 0\n  1143\t\t\t}\n  1144\t\t\tout := render(stdout, stderr)\n  1145\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1146\t\t\tif run.RunID == \"\" {\n  1147\t\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n  1148\t\t\t} else {\n  1149\t\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n  1150\t\t\t}\n  1151\t\t\treturn 0\n  1152\t\t}\n  1153\t\tif !attempt.Active {\n  1154\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1155\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1156\t\t}\n  1157\t\tif f.dryRun {\n  1158\t\t\tif f.jsonOut {\n  1159\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": false, \"dry_run\": true, \"owner\": attempt.Liveness})\n  1160\t\t\t\treturn 0\n  1161\t\t\t}\n  1162\t\t\tout := render(stdout, stderr)\n  1163\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1164\t\t\tout.Field(\"delegate.owner\", attempt.Liveness)\n  1165\t\t\tout.Field(\"delegate.dry_run\", tr(\"true (no cancellation requested)\", \"true (nenhum cancelamento pedido)\"))\n  1166\t\t\treturn 0\n  1167\t\t}\n  1168\t\tmarker, err := store.RequestDelegationCancel(attempt.AttemptID)\n  1169\t\tif err != nil {\n  1170\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1171\t\t}\n  1172\t\tdeadline := time.Now().Add(60 * time.Second)\n  1173\t\tfor store.DelegationRunActive(marker) && time.Now().Before(deadline) {\n  1174\t\t\ttime.Sleep(200 * time.Millisecond)\n  1175\t\t}\n  1176\t\tstopped := !store.DelegationRunActive(marker)\n  1177\t\tstatus, run := \"\", \"\"\n  1178\t\tif after, _, err := store.ListDelegationAttempts(); err == nil {\n  1179\t\t\tfor _, a := range after {\n  1180\t\t\t\tif a.AttemptID == attempt.AttemptID && a.Latest() != nil {\n  1181\t\t\t\t\tstatus, run = a.Latest().Status, a.Latest().RunID\n  1182\t\t\t\t}\n  1183\t\t\t}\n  1184\t\t}\n  1185\t\tif f.jsonOut {\n  1186\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": true, \"stopped\": stopped, \"run\": run, \"status\": status})\n  1187\t\t} else {\n  1188\t\t\tout := render(stdout, stderr)\n  1189\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1190\t\t\tout.Field(\"delegate.cancel\", tr(\"requested\", \"pedido\"))\n  1191\t\t\tout.Field(\"delegate.stopped\", fmt.Sprint(stopped))\n  1192\t\t\tif run != \"\" {\n  1193\t\t\t\tout.Field(\"delegate.run\", run)\n  1194\t\t\t\tout.Field(\"delegate.status\", status)\n  1195\t\t\t}\n  1196\t\t}\n  1197\t\tif !stopped {\n  1198\t\t\treturn 1\n  1199\t\t}\n  1200\t\treturn 0\n  1201\t}\n  1202\t\n  1203\t// withDelegationLosses names what the listing could not read beside a run it\n  1204\t// did not find running: the run may be the one an unreadable marker hides.\n  1205\tfunc withDelegationLosses(err error, lost []string) error {\n  1206\t\tif len(lost) == 0 {\n  1207\t\t\treturn err\n  1208\t\t}\n  1209\t\treturn fmt.Errorf(\"%w (%s %s)\", err, tr(\"unread:\", \"não lido:\"), strings.Join(lost, \"; \"))\n  1210\t}\n  1211\t\n  1212\t// delegateAgentRow is one line of pose delegate agents (R14).\n  1213\ttype delegateAgentRow struct {\n  1214\t\tName              string   `json:\"name\"`\n  1215\t\tVendor            string   `json:\"vendor\"`\n  1216\t\tModel             string   `json:\"model\"`\n  1217\t\tCLI               string   `json:\"cli\"`\n  1218\t\tOnPath            bool     `json:\"on_path\"`\n  1219\t\tAccess            []string `json:\"access\"`\n  1220\t\tEvents            string   `json:\"events\"`\n  1221\t\tLimitResetAt      string   `json:\"limit_reset_at,omitempty\"`\n  1222\t\tLimited           bool     `json:\"limited\"`\n  1223\t\tState             string   `json:\"state\"`\n  1224\t\tLimitedUntil      string   `json:\"limited_until,omitempty\"`\n  1225\t\tDetail            string   `json:\"detail,omitempty\"`\n  1226\t\tIndependentOfLead *bool    `json:\"independent_of_lead,omitempty\"`\n  1227\t\t// Unavailable names the access profiles whose dependencies are missing, with what is\n  1228\t\t// missing and how to install it.\n  1229\t\tUnavailable map[string]string `json:\"unavailable_access,omitempty\"`\n  1230\t}\n  1231\t\n  1232\tfunc cmdDelegateAgents(root string, args []string, stdout, stderr io.Writer) int {\n  1233\t\tf, problem := parseDelegateFlags(args)\n  1234\t\tif problem == \"\" && len(f.positional) > 0 {\n  1235\t\t\tproblem = tr(\"no arguments\", \"sem argumentos\")\n  1236\t\t}\n  1237\t\tif problem != \"\" {\n  1238\t\t\treturn delegateUsage(stdout, stderr, args, \"agents\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate agents [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>] [--json]\")\n  1239\t\t}\n  1240\t\tstore := posemodel.Store{Root: root}\n  1241\t\tpolicy, path, found, err := store.LoadDelegationPolicy()\n  1242\t\tif err != nil {\n  1243\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"agents\", 1, err)\n  1244\t\t}\n  1245\t\tlabelled := map[string]bool{}\n  1246\t\tif runs, _, err := store.ReadReviewRuns(\"\"); err == nil {\n  1247\t\t\tfor _, run := range runs {\n  1248\t\t\t\tif f.label != \"\" && run.Label == f.label {\n  1249\t\t\t\t\tlabelled[run.Adapter] = true\n  1250\t\t\t\t}\n  1251\t\t\t}\n  1252\t\t}\n  1253\t\t// Availability as routing reads it (spec pose-delegation-routing R6).\n  1254\t\tavail := store.DelegationAvailabilityOf(policy, time.Now(), true)\n  1255\t\trows := []delegateAgentRow{}\n  1256\t\tfor _, name := range policy.DeclaredAgentNames() {\n  1257\t\t\tagent := policy.Agents[name]\n  1258\t\t\taccess := make([]string, 0, len(agent.Commands))\n  1259\t\t\tfor level := range agent.Commands {\n  1260\t\t\t\taccess = append(access, level)\n  1261\t\t\t}\n  1262\t\t\tsort.Strings(access)\n  1263\t\t\tif f.agent != \"\" && f.agent != \"auto\" && f.agent != name || f.access != \"\" && !containsString(access, f.access) || f.label != \"\" && !labelled[name] {\n  1264\t\t\t\tcontinue\n  1265\t\t\t}\n  1266\t\t\tevents := agent.Events\n  1267\t\t\tif events == \"\" {\n  1268\t\t\t\tevents = posemodel.DelegationEventsPlain\n  1269\t\t\t}\n  1270\t\t\ta := avail[name]\n  1271\t\t\trow := delegateAgentRow{Name: name, Vendor: agent.Vendor, Model: agent.Model, CLI: a.CLI, OnPath: a.OnPath, Access: access, Events: events, LimitResetAt: a.LimitResetAt,\n  1272\t\t\t\tState: a.State, LimitedUntil: a.LimitedUntil, Detail: a.Detail}\n  1273\t\t\t// limited is the state routing reads now; limit_reset_at stays the\n  1274\t\t\t// reset of the last limit ever recorded.\n  1275\t\t\trow.Limited = a.State == posemodel.DelegationAgentLimited\n  1276\t\t\tfor access, missing := range agent.MissingRequirements() {\n  1277\t\t\t\tif row.Unavailable == nil {\n  1278\t\t\t\t\trow.Unavailable = map[string]string{}\n  1279\t\t\t\t}\n  1280\t\t\t\trow.Unavailable[access] = tr(\"missing \", \"falta \") + strings.Join(missing, \", \") + installHint(agent, access)\n  1281\t\t\t}\n  1282\t\t\tif f.lead != \"\" {\n  1283\t\t\t\tindependent := !strings.EqualFold(strings.TrimSpace(agent.Vendor), leadVendor(f.lead))\n  1284\t\t\t\trow.IndependentOfLead = &independent\n  1285\t\t\t}\n  1286\t\t\trows = append(rows, row)\n  1287\t\t}\n  1288\t\tif f.jsonOut {\n  1289\t\t\tdoc := map[string]any{\"schema\": delegateAgentsSchema, \"configured\": found, \"agents\": rows}\n  1290\t\t\tif found {\n  1291\t\t\t\tdoc[\"policy\"] = path\n  1292\t\t\t}\n  1293\t\t\twriteDelegateJSON(stdout, doc)\n  1294\t\t\treturn 0\n  1295\t\t}\n  1296\t\tout := render(stdout, stderr)\n  1297\t\tif !found {\n  1298\t\t\tout.Field(\"delegate.agents\", tr(\"none configured (.pose/policy/delegation.json)\", \"nenhum configurado (.pose/policy/delegation.json)\"))\n  1299\t\t\treturn 0\n  1300\t\t}\n  1301\t\tout.Field(\"delegate.policy\", path)\n  1302\t\tfor _, row := range rows {\n  1303\t\t\tstate := row.State\n  1304\t\t\tswitch {\n  1305\t\t\tcase row.State == posemodel.DelegationAgentLimited && row.LimitedUntil != \"\":\n  1306\t\t\t\tstate = tr(\"limited until \", \"limitado até \") + row.LimitedUntil\n  1307\t\t\tcase row.State == posemodel.DelegationAgentAvailable:\n  1308\t\t\t\tstate = tr(\"available\", \"disponível\")\n  1309\t\t\tcase row.State == posemodel.DelegationAgentMissing:\n  1310\t\t\t\tstate = tr(\"missing\", \"ausente\")\n  1311\t\t\tcase row.Detail != \"\":\n  1312\t\t\t\tstate += \" (\" + row.Detail + \")\"\n  1313\t\t\t}\n  1314\t\t\tvalue := fmt.Sprintf(\"%s · vendor=%s model=%s cli=%s on_path=%t access=%s events=%s\", state, row.Vendor, row.Model, row.CLI, row.OnPath, strings.Join(row.Access, \",\"), row.Events)\n  1315\t\t\tif row.LimitResetAt != \"\" {\n  1316\t\t\t\tvalue += \" last_limit_reset=\" + row.LimitResetAt\n  1317\t\t\t\tif row.Limited {\n  1318\t\t\t\t\tvalue += tr(\" (limited now)\", \" (limitado agora)\")\n  1319\t\t\t\t}\n  1320\t\t\t}\n  1321\t\t\tif row.IndependentOfLead != nil {\n  1322\t\t\t\tvalue += fmt.Sprintf(\" independent_of_lead=%t\", *row.IndependentOfLead)\n  1323\t\t\t}\n  1324\t\t\taccesses := make([]string, 0, len(row.Unavailable))\n  1325\t\t\tfor access := range row.Unavailable {\n  1326\t\t\t\taccesses = append(accesses, access)\n  1327\t\t\t}\n  1328\t\t\tsort.Strings(accesses)\n  1329\t\t\tfor _, access := range accesses {\n  1330\t\t\t\tvalue += \" unavailable_access=\" + access + \"(\" + row.Unavailable[access] + \")\"\n  1331\t\t\t}\n  1332\t\t\tout.Field(\"delegate.agent.\"+row.Name, value)\n  1333\t\t}\n  1334\t\treturn 0\n  1335\t}\n  1336\t\n  1337\t// installHint is how to install what an access profile needs, when the policy says.\n  1338\tfunc installHint(agent posemodel.DelegationAgent, access string) string {\n  1339\t\tif install := agent.Requires[access].Install; install != \"\" {\n  1340\t\t\treturn tr(\"; install: \", \"; instale: \") + install\n  1341\t\t}\n  1342\t\treturn \"\"\n  1343\t}\n  1344\t\n  1345\tfunc containsString(values []string, wanted string) bool {\n  1346\t\tfor _, value := range values {\n  1347\t\t\tif value == wanted {\n  1348\t\t\t\treturn true\n  1349\t\t\t}\n  1350\t\t}\n  1351\t\treturn false\n  1352\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_shim_linux.go && nl -ba pose-mcp/internal/pose/review_shim.go && nl -ba pose-mcp/internal/pose/review_dispatch.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"os/signal\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"golang.org/x/sys/unix\"\n    18\t)\n    19\t\n    20\t// RunReviewShim runs args (the adapter's path, then its argv) as the shim's\n    21\t// only child, waits for it or for SIGTERM, ends every process left in the\n    22\t// shim's subtree and returns the adapter's exit status.\n    23\tfunc RunReviewShim(args []string) int {\n    24\t\treport := reviewShimReport{}\n    25\t\tvar reportFile *os.File\n    26\t\tparent := 0\n    27\t\tif value := os.Getenv(ReviewShimReportEnv); value != \"\" {\n    28\t\t\tparent, _ = strconv.Atoi(value)\n    29\t\t\t// The report pipe is the shim's alone: the adapter never inherits it.\n    30\t\t\tsyscall.CloseOnExec(3)\n    31\t\t\treportFile = os.NewFile(3, \"pose-review-shim-report\")\n    32\t\t}\n    33\t\t_ = os.Unsetenv(ReviewShimReportEnv)\n    34\t\twrite := func() {\n    35\t\t\tif reportFile == nil {\n    36\t\t\t\treturn\n    37\t\t\t}\n    38\t\t\traw, _ := json.Marshal(report)\n    39\t\t\t_, _ = reportFile.Write(raw)\n    40\t\t\t_ = reportFile.Close()\n    41\t\t}\n    42\t\tif len(args) < 2 {\n    43\t\t\treport.Error = \"the review shim was given no adapter\"\n    44\t\t\twrite()\n    45\t\t\treturn 125\n    46\t\t}\n    47\t\tstop := make(chan os.Signal, 1)\n    48\t\tsignal.Notify(stop, syscall.SIGTERM)\n    49\t\t// The dispatcher's death stops the shim the same way as a timeout.\n    50\t\tif err := unix.Prctl(unix.PR_SET_PDEATHSIG, uintptr(syscall.SIGTERM), 0, 0, 0); err != nil {\n    51\t\t\treport.Error = \"the shim could not follow its dispatcher: \" + err.Error()\n    52\t\t\twrite()\n    53\t\t\treturn 125\n    54\t\t}\n    55\t\tif parent != 0 && os.Getppid() != parent {\n    56\t\t\treport.Error = \"the dispatcher ended before the shim started\"\n    57\t\t\twrite()\n    58\t\t\treturn 125\n    59\t\t}\n    60\t\tif err := unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0); err != nil {\n    61\t\t\treport.Error = \"the shim could not become the subreaper of the run: \" + err.Error()\n    62\t\t\twrite()\n    63\t\t\treturn 125\n    64\t\t}\n    65\t\tcmd := &exec.Cmd{Path: args[0], Args: args[1:], Stdin: os.Stdin, Stdout: os.Stdout, Stderr: os.Stderr, Env: os.Environ()}\n    66\t\tif err := cmd.Start(); err != nil {\n    67\t\t\treport.Error = \"the adapter could not run: \" + err.Error()\n    68\t\t\twrite()\n    69\t\t\treturn 127\n    70\t\t}\n    71\t\tdone := make(chan error, 1)\n    72\t\tgo func() { done <- cmd.Wait() }()\n    73\t\tcode, stopped := 0, false\n    74\t\tvar signaled syscall.Signal\n    75\t\tselect {\n    76\t\tcase err := <-done:\n    77\t\t\tvar exit *exec.ExitError\n    78\t\t\tif errors.As(err, &exit) {\n    79\t\t\t\tif status, ok := exit.Sys().(syscall.WaitStatus); ok && status.Signaled() {\n    80\t\t\t\t\tsignaled, code = status.Signal(), 128+int(status.Signal())\n    81\t\t\t\t} else {\n    82\t\t\t\t\tcode = exit.ExitCode()\n    83\t\t\t\t}\n    84\t\t\t} else if err != nil {\n    85\t\t\t\treport.Error = \"the adapter's end could not be read: \" + err.Error()\n    86\t\t\t}\n    87\t\tcase <-stop:\n    88\t\t\tstopped, code = true, 128+int(syscall.SIGTERM)\n    89\t\t}\n    90\t\tended, err := reapShimSubtree()\n    91\t\treport.Ended = ended\n    92\t\tif err != nil && report.Error == \"\" {\n    93\t\t\treport.Error = err.Error()\n    94\t\t}\n    95\t\twrite()\n    96\t\tif stopped {\n    97\t\t\treturn code\n    98\t\t}\n    99\t\t// An adapter ended by a signal is reported as ended by it: the shim ends\n   100\t\t// itself the same way, so the dispatcher reads what it would have read\n   101\t\t// without the shim.\n   102\t\tif signaled != 0 {\n   103\t\t\tsignal.Reset(signaled)\n   104\t\t\t_ = syscall.Kill(os.Getpid(), signaled)\n   105\t\t\ttime.Sleep(time.Second)\n   106\t\t}\n   107\t\treturn code\n   108\t}\n   109\t\n   110\t// stopReviewShim asks a running shim to end its subtree and exit.\n   111\tfunc stopReviewShim(cmd *exec.Cmd) func() error {\n   112\t\treturn func() error { return cmd.Process.Signal(syscall.SIGTERM) }\n   113\t}\n   114\t\n   115\t// reapShimSubtree ends and reaps every child of the shim, including the\n   116\t// orphans its subreaper status adopted, until none is left.\n   117\tfunc reapShimSubtree() ([]string, error) {\n   118\t\tself := os.Getpid()\n   119\t\tvar ended []string\n   120\t\tseen := map[int]bool{}\n   121\t\tdeadline := time.Now().Add(reviewReapWait)\n   122\t\tfor {\n   123\t\t\tdirs, err := os.ReadDir(\"/proc\")\n   124\t\t\tif err != nil {\n   125\t\t\t\treturn ended, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n   126\t\t\t}\n   127\t\t\tchildren := 0\n   128\t\t\tfor _, d := range dirs {\n   129\t\t\t\tpid, err := strconv.Atoi(d.Name())\n   130\t\t\t\tif err != nil || pid == self {\n   131\t\t\t\t\tcontinue\n   132\t\t\t\t}\n   133\t\t\t\tst, err := readShimProcStat(pid)\n   134\t\t\t\tif reviewProcessGoneErr(err) {\n   135\t\t\t\t\tcontinue\n   136\t\t\t\t}\n   137\t\t\t\tif err != nil {\n   138\t\t\t\t\treturn ended, fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   139\t\t\t\t}\n   140\t\t\t\tif st.ppid != self {\n   141\t\t\t\t\tcontinue\n   142\t\t\t\t}\n   143\t\t\t\tchildren++\n   144\t\t\t\tif !st.zombie {\n   145\t\t\t\t\tif !seen[pid] {\n   146\t\t\t\t\t\tseen[pid] = true\n   147\t\t\t\t\t\tended = append(ended, strconv.Itoa(pid))\n   148\t\t\t\t\t}\n   149\t\t\t\t\tif err := killPinnedChild(pid, self); err != nil {\n   150\t\t\t\t\t\treturn ended, err\n   151\t\t\t\t\t}\n   152\t\t\t\t}\n   153\t\t\t}\n   154\t\t\tfor {\n   155\t\t\t\tpid, err := unix.Wait4(-1, nil, unix.WNOHANG, nil)\n   156\t\t\t\tif pid <= 0 || err != nil {\n   157\t\t\t\t\tbreak\n   158\t\t\t\t}\n   159\t\t\t}\n   160\t\t\tif children == 0 {\n   161\t\t\t\treturn ended, nil\n   162\t\t\t}\n   163\t\t\tif time.Now().After(deadline) {\n   164\t\t\t\treturn ended, fmt.Errorf(\"%d process(es) of the run could not be ended\", children)\n   165\t\t\t}\n   166\t\t\ttime.Sleep(20 * time.Millisecond)\n   167\t\t}\n   168\t}\n   169\t\n   170\ttype shimProcStat struct {\n   171\t\tppid   int\n   172\t\tzombie bool\n   173\t}\n   174\t\n   175\tfunc readShimProcStat(pid int) (shimProcStat, error) {\n   176\t\traw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n   177\t\tif err != nil {\n   178\t\t\treturn shimProcStat{}, err\n   179\t\t}\n   180\t\ttext := string(raw)\n   181\t\tend := strings.LastIndexByte(text, ')')\n   182\t\tif end < 0 {\n   183\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   184\t\t}\n   185\t\tf := strings.Fields(text[end+1:])\n   186\t\tif len(f) < 2 {\n   187\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   188\t\t}\n   189\t\tppid, err := strconv.Atoi(f[1])\n   190\t\tif err != nil {\n   191\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   192\t\t}\n   193\t\treturn shimProcStat{ppid: ppid, zombie: f[0] == \"Z\"}, nil\n   194\t}\n   195\t\n   196\t// killPinnedChild signals pid through a pidfd while it is still a child of\n   197\t// parent: a pid reused by an unrelated process is never signalled.\n   198\tfunc killPinnedChild(pid, parent int) error {\n   199\t\tfd, err := unix.PidfdOpen(pid, 0)\n   200\t\tif errors.Is(err, unix.ESRCH) {\n   201\t\t\treturn nil\n   202\t\t}\n   203\t\tif err != nil {\n   204\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   205\t\t}\n   206\t\tdefer unix.Close(fd)\n   207\t\tst, err := readShimProcStat(pid)\n   208\t\tif reviewProcessGoneErr(err) || err == nil && st.ppid != parent {\n   209\t\t\treturn nil\n   210\t\t}\n   211\t\tif err != nil {\n   212\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   213\t\t}\n   214\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   215\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   216\t\t}\n   217\t\treturn nil\n   218\t}\n   219\t\n   220\t// parseReviewShimReport reads the report the shim wrote to its pipe.\n   221\tfunc parseReviewShimReport(raw []byte) (reviewShimReport, error) {\n   222\t\tvar r reviewShimReport\n   223\t\tif len(raw) == 0 {\n   224\t\t\treturn r, fmt.Errorf(\"the review shim left no report\")\n   225\t\t}\n   226\t\tif err := json.Unmarshal(raw, &r); err != nil {\n   227\t\t\treturn r, fmt.Errorf(\"the review shim report is unreadable: %w\", err)\n   228\t\t}\n   229\t\treturn r, nil\n   230\t}\n     1\tpackage pose\n     2\t\n     3\timport \"time\"\n     4\t\n     5\t// The review run shim (spec pose-review-run-reaps-lingering-reviewer-processes,\n     6\t// review rounds 6 and 8): a descendant of the reviewer that leaves the\n     7\t// adapter's process group, starts its own session and clears its environment\n     8\t// matches neither the group kill nor the sealed-checkout entry. Making the\n     9\t// dispatcher a child subreaper caught it, but a subreaper is process-wide:\n    10\t// in the dispatching process it also adopted and ended children other code\n    11\t// started there (a detached delegation), and reaped processes another\n    12\t// goroutine was waiting for. The dispatcher therefore starts the adapter\n    13\t// through a shim, the same executable re-entered with ReviewShimArg, which\n    14\t// makes itself the subreaper, runs the adapter, and, once it exits, ends\n    15\t// every process left in its subtree. The shim has no other children, so\n    16\t// everything it adopts is the run's. A timeout asks the shim to stop with\n    17\t// SIGTERM, and the death of the dispatcher delivers it the same signal: in\n    18\t// both cases it ends the subtree before it exits (review round 8, N3, N4).\n    19\t\n    20\t// reviewReapWait bounds how long ending the run's leftover processes takes.\n    21\tconst reviewReapWait = 5 * time.Second\n    22\t\n    23\t// ReviewShimArg is the first argument that runs the executable as a review\n    24\t// run shim instead of the CLI.\n    25\tconst ReviewShimArg = \"__pose-review-run-shim\"\n    26\t\n    27\t// ReviewShimReportEnv tells the shim that the dispatcher passed it a report\n    28\t// pipe as file descriptor 3, and names the dispatcher's pid. The report never\n    29\t// goes to a path the reviewer can write (review round 8, N2).\n    30\tconst ReviewShimReportEnv = \"POSE_REVIEW_SHIM_REPORT\"\n    31\t\n    32\t// ReviewShimAvailable says the running executable handles ReviewShimArg. It\n    33\t// is set by the pose command and by the test binaries that dispatch; any\n    34\t// other embedder starts the adapter directly, without the shim.\n    35\tvar ReviewShimAvailable = false\n    36\t\n    37\t// reviewShimReport is what the shim found after the adapter exited.\n    38\ttype reviewShimReport struct {\n    39\t\tEnded []string `json:\"ended\"`\n    40\t\tError string   `json:\"error,omitempty\"`\n    41\t}\n     1\tpackage pose\n     2\t\n     3\t// Delegated review dispatch (spec pose-delegated-review-dispatch, roadmap\n     4\t// delegated-review).\n     5\t//\n     6\t// A run hands the brief of a sealed bundle to a configured reviewer command —\n     7\t// another vendor's agent, typically — on a disposable worktree at the sealed\n     8\t// commit, and records what happened. It never records an attestation: turning\n     9\t// a run's conclusion into one is the engine's verified step (spec\n    10\t// pose-delegated-review-capability). A run that changed files, exceeded its\n    11\t// time or budget, or failed is recorded as failed, never as a review.\n    12\t\n    13\timport (\n    14\t\t\"bytes\"\n    15\t\t\"context\"\n    16\t\t\"crypto/sha256\"\n    17\t\t\"encoding/hex\"\n    18\t\t\"encoding/json\"\n    19\t\t\"errors\"\n    20\t\t\"fmt\"\n    21\t\t\"io\"\n    22\t\t\"os\"\n    23\t\t\"os/exec\"\n    24\t\t\"path/filepath\"\n    25\t\t\"reflect\"\n    26\t\t\"runtime\"\n    27\t\t\"sort\"\n    28\t\t\"strings\"\n    29\t\t\"sync/atomic\"\n    30\t\t\"time\"\n    31\t\t\"unicode/utf8\"\n    32\t)\n    33\t\n    34\t// beforeRunResultPublished is a test seam called with a run just before its\n    35\t// attempt result is published (spec pose-delegation-result-before-marker).\n    36\tvar beforeRunResultPublished = func(ReviewRun) {}\n    37\t\n    38\t// AdapterPipeGrace is how long a finished or killed adapter's children may\n    39\t// hold its pipes before they are released. Tests that exercise a lingering\n    40\t// child shorten it (spec pose-cli-test-wall-time R1).\n    41\tvar AdapterPipeGrace = 5 * time.Second\n    42\t\n    43\t// ReviewersPolicySchemaVersion versions .pose/policy/reviewers.json.\n    44\tconst ReviewersPolicySchemaVersion = 1\n    45\t\n    46\tconst reviewRunsDir = \".pose/review-runs\"\n    47\t\n    48\t// ReviewerAdapter is one configured reviewer command.\n    49\ttype ReviewerAdapter struct {\n    50\t\tContainment *ReviewerContainment `json:\"containment,omitempty\"`\n    51\t\t// Command is the argv; \"{output}\" is replaced by a file the reviewer may\n    52\t\t// write its final message to. The brief arrives on stdin and the working\n    53\t\t// directory is the disposable worktree.\n    54\t\tExecutor         string           `json:\"executor,omitempty\"`\n    55\t\tCommand          []string         `json:\"command\"`\n    56\t\tVendor           string           `json:\"vendor\"`\n    57\t\tModel            string           `json:\"model\"`\n    58\t\tTimeout          string           `json:\"timeout,omitempty\"`\n    59\t\tMaxRunsPerBundle int              `json:\"max_runs_per_bundle,omitempty\"`\n    60\t\tLimit            *ReviewerLimit   `json:\"limit,omitempty\"`\n    61\t\tSession          *ReviewerSession `json:\"session,omitempty\"`\n    62\t\tResume           *ReviewerResume  `json:\"resume,omitempty\"`\n    63\t\t// Events and Effort come from a delegation.json agent (schema 2); a\n    64\t\t// schema 1 adapter has neither, so its projection is unchanged.\n    65\t\tEvents string          `json:\"events,omitempty\"`\n    66\t\tEffort *ReviewerEffort `json:\"effort,omitempty\"`\n    67\t}\n    68\t\n    69\t// ReviewersPolicy is .pose/policy/reviewers.json.\n    70\ttype ReviewersPolicy struct {\n    71\t\tProvenance    *ReviewRunProvenancePolicy `json:\"provenance,omitempty\"`\n    72\t\tSchemaVersion int                        `json:\"schema_version\"`\n    73\t\tAdapters      map[string]ReviewerAdapter `json:\"adapters\"`\n    74\t}\n    75\t\n    76\t// ExampleReviewersPolicy is what POSE suggests and never enables by itself.\n    77\tfunc ExampleReviewersPolicy() ReviewersPolicy {\n    78\t\treturn ReviewersPolicy{SchemaVersion: ReviewersPolicySchemaVersion, Adapters: map[string]ReviewerAdapter{\n    79\t\t\t\"codex\": {Command: []string{\"codex\", \"exec\", \"-m\", \"gpt-6.1-sol\", \"-c\", `model_reasoning_effort=\"medium\"`, \"-s\", \"read-only\", \"--skip-git-repo-check\", \"-o\", \"{output}\", \"-\"},\n    80\t\t\t\tVendor: \"openai\", Model: \"gpt-6.1-sol\", Timeout: \"60m\", MaxRunsPerBundle: 3},\n    81\t\t\t\"claude\": {Command: []string{\"claude\", \"-p\", \"--model\", \"claude-opus-5-5\", \"--permission-mode\", \"plan\"},\n    82\t\t\t\tVendor: \"anthropic\", Model: \"claude-opus-5-5\", Timeout: \"60m\", MaxRunsPerBundle: 3},\n    83\t\t}}\n    84\t}\n    85\t\n    86\t// LoadReviewersPolicy reads the adapters of the review purpose; an absent\n    87\t// policy means none.\n    88\tfunc (s Store) LoadReviewersPolicy() (ReviewersPolicy, bool, error) {\n    89\t\treturn s.LoadReviewersPolicyFor(\"review\")\n    90\t}\n    91\t\n    92\t// LoadReviewersPolicyFor reads the adapters for the purpose that runs a brief\n    93\t// of kind: delegation.json (schema 2) projected for that purpose, or\n    94\t// reviewers.json (schema 1) through the same conversion.\n    95\tfunc (s Store) LoadReviewersPolicyFor(kind string) (ReviewersPolicy, bool, error) {\n    96\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n    97\t\tif err != nil || !found {\n    98\t\t\treturn ReviewersPolicy{}, false, err\n    99\t\t}\n   100\t\treturn policy.reviewersView(DelegationPurposeForKind(kind)), true, nil\n   101\t}\n   102\t\n   103\t// activeDelegationPolicyPath is the policy file the engine reads now.\n   104\tfunc (s Store) activeDelegationPolicyPath() string {\n   105\t\tif _, err := os.Lstat(filepath.Join(s.Root, filepath.FromSlash(delegationPolicyPath))); err == nil {\n   106\t\t\treturn delegationPolicyPath\n   107\t\t}\n   108\t\treturn reviewersPolicyPath\n   109\t}\n   110\t\n   111\tfunc parseReviewersPolicy(raw []byte) (ReviewersPolicy, error) {\n   112\t\tvar policy ReviewersPolicy\n   113\t\tif err := json.Unmarshal(raw, &policy); err != nil {\n   114\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: invalid .pose/policy/reviewers.json: %w\", err)\n   115\t\t}\n   116\t\tif policy.SchemaVersion != ReviewersPolicySchemaVersion {\n   117\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: .pose/policy/reviewers.json schema_version %d is not supported\", policy.SchemaVersion)\n   118\t\t}\n   119\t\tif err := validateExplicitReviewBudget(raw); err != nil {\n   120\t\t\treturn ReviewersPolicy{}, err\n   121\t\t}\n   122\t\tif err := validateRunProvenancePolicy(policy); err != nil {\n   123\t\t\treturn ReviewersPolicy{}, err\n   124\t\t}\n   125\t\tfor name, adapter := range policy.Adapters {\n   126\t\t\tif adapter.Events != \"\" || adapter.Effort != nil {\n   127\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s: events and effort are delegation.json fields\", name)\n   128\t\t\t}\n   129\t\t\tif _, err := ResolveReviewerContainment(adapter); err != nil {\n   130\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"adapter %s: %w\", name, err)\n   131\t\t\t}\n   132\t\t\tif err := validateContinuityAdapter(adapter); err != nil {\n   133\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s: %w\", name, err)\n   134\t\t\t}\n   135\t\t\tif len(adapter.Command) == 0 || adapter.Vendor == \"\" || adapter.Model == \"\" {\n   136\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s needs command, vendor and model\", name)\n   137\t\t\t}\n   138\t\t\tif adapter.Timeout != \"\" {\n   139\t\t\t\tif _, err := time.ParseDuration(adapter.Timeout); err != nil {\n   140\t\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s timeout: %w\", name, err)\n   141\t\t\t\t}\n   142\t\t\t}\n   143\t\t}\n   144\t\treturn policy, nil\n   145\t}\n   146\t\n   147\t// ReviewRun is one recorded dispatch.\n   148\ttype ReviewRun struct {\n   149\t\tSafety              *ReviewExecutionSafety `json:\"safety,omitempty\"`\n   150\t\tProvenance          *ReviewRunProvenance   `json:\"provenance,omitempty\"`\n   151\t\tsessionForRedaction string\n   152\t\teventsBytes         []byte\n   153\t\tResumes             string `json:\"resumes,omitempty\"`\n   154\t\t// ResumesSession marks a task that continued a session POSE never\n   155\t\t// recorded, named by its caller (spec pose-delegation-parity-gate SA-07).\n   156\t\tResumesSession bool `json:\"resumes_session,omitempty\"`\n   157\t\t// HandsOffFrom names the run this one continues with another agent, and\n   158\t\t// HandoffDigest the section its brief added (spec\n   159\t\t// pose-delegation-handoff R4, R5).\n   160\t\tHandsOffFrom  string `json:\"hands_off_from,omitempty\"`\n   161\t\tHandoffDigest string `json:\"handoff_digest,omitempty\"`\n   162\t\t// HandoffRenderer is the version of the renderer that listed the\n   163\t\t// predecessor's commands in the section; absent on runs recorded before it.\n   164\t\tHandoffRenderer  int                 `json:\"handoff_renderer,omitempty\"`\n   165\t\tInterruption     *ReviewInterruption `json:\"interruption,omitempty\"`\n   166\t\tSessionDigest    string              `json:\"session_digest,omitempty\"`\n   167\t\tTreeDigest       string              `json:\"tree_digest,omitempty\"`\n   168\t\tBriefNotes       string              `json:\"brief_notes,omitempty\"`\n   169\t\tPartialDigest    string              `json:\"partial_digest,omitempty\"`\n   170\t\tLimitOf          string              `json:\"limit_of,omitempty\"`\n   171\t\tLedgerVersion    int                 `json:\"ledger_version,omitempty\"`\n   172\t\tAttemptID        string              `json:\"attempt_id,omitempty\"`\n   173\t\tReason           string              `json:\"reason,omitempty\"`\n   174\t\tSchemaVersion    int                 `json:\"schema_version\"`\n   175\t\tRunID            string              `json:\"run_id\"`\n   176\t\tScope            string              `json:\"scope\"`\n   177\t\tBundleID         string              `json:\"bundle_id\"`\n   178\t\tBundleDigest     string              `json:\"bundle_digest\"`\n   179\t\tSealedCommit     string              `json:\"sealed_commit\"`\n   180\t\tKind             string              `json:\"kind\"`\n   181\t\tBriefDigest      string              `json:\"brief_digest\"`\n   182\t\tAdapter          string              `json:\"adapter\"`\n   183\t\tVendor           string              `json:\"vendor\"`\n   184\t\tModel            string              `json:\"model\"`\n   185\t\tStartedAt        string              `json:\"started_at\"`\n   186\t\tEndedAt          string              `json:\"ended_at\"`\n   187\t\tExitCode         int                 `json:\"exit_code\"`\n   188\t\tStatus           string              `json:\"status\"`\n   189\t\tFailure          string              `json:\"failure,omitempty\"`\n   190\t\tTranscriptDigest string              `json:\"transcript_digest\"`\n   191\t\tTranscriptPath   string              `json:\"transcript_path\"`\n   192\t\tOutput           string              `json:\"output\"`\n   193\t\tPolicyDigest     string              `json:\"policy_digest,omitempty\"`\n   194\t\tSupersedes       string              `json:\"supersedes,omitempty\"`\n   195\t\t// Label, Purpose and Lead are given by pose delegate; EnvRemoved names the\n   196\t\t// parent session variables the child did not receive (never their values);\n   197\t\t// Events and EventsDigest bind the normalized event stream kept beside\n   198\t\t// the transcript (spec pose-delegation-surface R8, R9, R11).\n   199\t\tLabel        string   `json:\"label,omitempty\"`\n   200\t\tPurpose      string   `json:\"purpose,omitempty\"`\n   201\t\tLead         string   `json:\"lead,omitempty\"`\n   202\t\tEnvRemoved   []string `json:\"env_removed,omitempty\"`\n   203\t\tEvents       string   `json:\"events,omitempty\"`\n   204\t\tEventsDigest string   `json:\"events_digest,omitempty\"`\n   205\t\tSupersededBy string   `json:\"superseded_by,omitempty\"`\n   206\t\t// Routing is how the run's agent was chosen and IndependenceAchieved what\n   207\t\t// it achieved against the implementation (spec pose-delegation-routing R8).\n   208\t\tRouting              *DelegationRoutingRecord `json:\"routing,omitempty\"`\n   209\t\tIndependenceAchieved string                   `json:\"independence_achieved,omitempty\"`\n   210\t\t// A task run (spec pose-delegation-task) records the access it ran with,\n   211\t\t// its directory and flags, the argv it ran, and the digests of the prompt\n   212\t\t// and the error stream kept beside its record; Recorded is --record.\n   213\t\tAccess       string   `json:\"access,omitempty\"`\n   214\t\tDir          string   `json:\"dir,omitempty\"`\n   215\t\tAddDirs      []string `json:\"add_dirs,omitempty\"`\n   216\t\tNoNetwork    bool     `json:\"no_network,omitempty\"`\n   217\t\tRecorded     bool     `json:\"recorded,omitempty\"`\n   218\t\tArgv         []string `json:\"argv,omitempty\"`\n   219\t\tPromptDigest string   `json:\"prompt_digest,omitempty\"`\n   220\t\tEffort       string   `json:\"effort,omitempty\"`\n   221\t\tStderrDigest string   `json:\"stderr_digest,omitempty\"`\n   222\t\t// Round is the round of the scope the run reviewed, DraftProblems what\n   223\t\t// keeps its draft from counting for that round, and Thread how its session\n   224\t\t// relates to the previous round's (spec\n   225\t\t// pose-delegated-review-round-protocol R1, R4, R6).\n   226\t\tRound         int           `json:\"round,omitempty\"`\n   227\t\tDraftProblems []string      `json:\"draft_problems,omitempty\"`\n   228\t\tThread        *ReviewThread `json:\"thread,omitempty\"`\n   229\t\tPath          string        `json:\"-\"`\n   230\t\t// eventsDir is where a task run's files are; a review run's are in\n   231\t\t// reviewRunsDir.\n   232\t\teventsDir string\n   233\t}\n   234\t\n   235\t// Review run states.\n   236\tconst (\n   237\t\tReviewRunCompleted   = \"completed\"\n   238\t\tReviewRunFailed      = \"failed\"\n   239\t\tReviewRunInterrupted = \"interrupted\"\n   240\t\tReviewRunStale       = \"stale\"\n   241\t)\n   242\t\n   243\t// ListReviewRuns returns the recorded runs for bundleID (\"\" for all).\n   244\tfunc (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n   245\t\truns, _, err := s.ReadReviewRuns(bundleID)\n   246\t\treturn runs, err\n   247\t}\n   248\t\n   249\tfunc (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n   250\t\t// Within a read-view operation the ledger is read and checked once per\n   251\t\t// root; every request of the operation is answered from that read,\n   252\t\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n   253\t\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n   254\t\t\truns, lost, err := s.readAllReviewRuns()\n   255\t\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n   256\t\t})\n   257\t\tif err != nil {\n   258\t\t\treturn nil, nil, err\n   259\t\t}\n   260\t\tout := copyReviewRuns(all.runs)\n   261\t\tif bundleID != \"\" {\n   262\t\t\tfiltered := []ReviewRun{}\n   263\t\t\tfor _, run := range out {\n   264\t\t\t\tif run.BundleID == bundleID {\n   265\t\t\t\t\tfiltered = append(filtered, run)\n   266\t\t\t\t}\n   267\t\t\t}\n   268\t\t\tout = filtered\n   269\t\t}\n   270\t\treturn out, deepCopyValue(all.lost), nil\n   271\t}\n   272\t\n   273\t// readAllReviewRuns reads, checks and orders every review run of the store.\n   274\tfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n   275\t\tfiles := s.fsys()\n   276\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n   277\t\t// The storage is read where the writer writes it: a link in its place is another place.\n   278\t\tif info, lerr := files.Lstat(dir); lerr == nil {\n   279\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n   280\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n   281\t\t\t}\n   282\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   283\t\t\treturn nil, nil, lerr\n   284\t\t}\n   285\t\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n   286\t\tif errors.Is(err, os.ErrNotExist) {\n   287\t\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n   288\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n   289\t\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   290\t\t\t\treturn nil, nil, lerr\n   291\t\t\t}\n   292\t\t\treturn []ReviewRun{}, nil, nil\n   293\t\t}\n   294\t\tif err != nil {\n   295\t\t\treturn nil, nil, err\n   296\t\t}\n   297\t\tout := []ReviewRun{}\n   298\t\tvar lost []string\n   299\t\treadBudget := int64(32 << 20)\n   300\t\tfor _, e := range entries {\n   301\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   302\t\t\t\tcontinue\n   303\t\t\t}\n   304\t\t\tfull := filepath.Join(dir, e.Name())\n   305\t\t\tinfo, infoErr := files.Lstat(full)\n   306\t\t\tif infoErr != nil || !info.Mode().IsRegular() {\n   307\t\t\t\tlost = append(lost, e.Name()+\" (not a regular file)\")\n   308\t\t\t\tcontinue\n   309\t\t\t}\n   310\t\t\tif info.Size() < 0 || info.Size() > reviewLedgerMaxBytes {\n   311\t\t\t\tlost = append(lost, e.Name()+\" (record exceeds bound or is unreadable)\")\n   312\t\t\t\tcontinue\n   313\t\t\t}\n   314\t\t\traw, err := readLedgerRawBudgetIn(files, full, &readBudget)\n   315\t\t\tif err != nil {\n   316\t\t\t\tlost = append(lost, e.Name()+\" (\"+err.Error()+\")\")\n   317\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   318\t\t\t\t\tbreak\n   319\t\t\t\t}\n   320\t\t\t\tcontinue\n   321\t\t\t}\n   322\t\t\tvar run ReviewRun\n   323\t\t\tif json.Unmarshal(raw, &run) != nil || run.RunID == \"\" {\n   324\t\t\t\tlost = append(lost, e.Name()+\" (not a review run)\")\n   325\t\t\t\tcontinue\n   326\t\t\t}\n   327\t\t\tif verr := validateReviewRunRecord(e.Name(), run); verr != nil {\n   328\t\t\t\tlost = append(lost, e.Name()+\" (\"+verr.Error()+\")\")\n   329\t\t\t\tcontinue\n   330\t\t\t}\n   331\t\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, e.Name()))\n   332\t\t\tout = append(out, run)\n   333\t\t}\n   334\t\tsort.Slice(out, func(i, j int) bool {\n   335\t\t\ta, _ := time.Parse(time.RFC3339Nano, out[i].StartedAt)\n   336\t\t\tb, _ := time.Parse(time.RFC3339Nano, out[j].StartedAt)\n   337\t\t\tif !a.Equal(b) {\n   338\t\t\t\treturn a.Before(b)\n   339\t\t\t}\n   340\t\t\treturn out[i].RunID < out[j].RunID\n   341\t\t})\n   342\t\tsuperseded := map[string]string{}\n   343\t\tfor _, run := range out {\n   344\t\t\tif run.Supersedes != \"\" {\n   345\t\t\t\tsuperseded[run.Supersedes] = run.RunID\n   346\t\t\t}\n   347\t\t}\n   348\t\tfor i := range out {\n   349\t\t\tout[i].SupersededBy = superseded[out[i].RunID]\n   350\t\t}\n   351\t\tchecked := map[string][]DelegatedReviewAttempt{}\n   352\t\tfor _, run := range out {\n   353\t\t\tif run.LedgerVersion == 1 {\n   354\t\t\t\tif _, err := files.Lstat(filepath.Join(s.Root, reviewRunLedgerDir, run.RunID+\".json\")); err != nil {\n   355\t\t\t\t\tlost = append(lost, \"missing run witness \"+run.RunID)\n   356\t\t\t\t}\n   357\t\t\t}\n   358\t\t\tif run.AttemptID != \"\" {\n   359\t\t\t\tattempts, ok := checked[run.BundleID]\n   360\t\t\t\tif !ok {\n   361\t\t\t\t\tvar aerr error\n   362\t\t\t\t\tattempts, aerr = s.readDelegatedReviewAttempts(run.BundleID, &readBudget)\n   363\t\t\t\t\tif aerr != nil {\n   364\t\t\t\t\t\tlost = append(lost, aerr.Error())\n   365\t\t\t\t\t}\n   366\t\t\t\t\tchecked[run.BundleID] = attempts\n   367\t\t\t\t}\n   368\t\t\t\t// The reservation names the attempt's first agent; a continuation's\n   369\t\t\t\t// agent is checked against its own predecessor by the continuation\n   370\t\t\t\t// chain (a resume keeps it, a handoff changes it).\n   371\t\t\t\tfound := false\n   372\t\t\t\tfor _, a := range attempts {\n   373\t\t\t\t\tif a.AttemptID == run.AttemptID && a.BundleDigest == run.BundleDigest && a.Scope == run.Scope && (a.Adapter == run.Adapter || run.continues() != \"\") && a.Reason == run.Reason {\n   374\t\t\t\t\t\tfound = true\n   375\t\t\t\t\t\tbreak\n   376\t\t\t\t\t}\n   377\t\t\t\t}\n   378\t\t\t\tif !found {\n   379\t\t\t\t\tlost = append(lost, \"missing or conflicting attempt reservation \"+run.AttemptID)\n   380\t\t\t\t}\n   381\t\t\t}\n   382\t\t}\n   383\t\tfindings, ledgerErr := s.reviewRunLedgerFindings(\"\", &readBudget)\n   384\t\tif ledgerErr != nil {\n   385\t\t\tlost = append(lost, ledgerErr.Error())\n   386\t\t}\n   387\t\tlost = append(lost, findings...)\n   388\t\tlost = append(lost, s.reviewContinuationFindings(out)...)\n   389\t\treturn out, uniqueSorted(lost), nil\n   390\t}\n   391\t\n   392\t// DispatchPlan is what a dispatch will do.\n   393\ttype DispatchPlan struct {\n   394\t\tprovenance          *ReviewRunProvenance\n   395\t\tPendingContinuation *PendingReviewContinuation\n   396\t\tprocessTimeout      time.Duration\n   397\t\tpredecessor         *ReviewRun\n   398\t\t// handoff makes the continuation another agent's, with handoffSection\n   399\t\t// appended to the brief (spec pose-delegation-handoff).\n   400\t\thandoff        bool\n   401\t\thandoffSection string\n   402\t\tsession        string\n   403\t\t// round is the round of the scope the run reviews, and thread how a\n   404\t\t// round after the first relates to the previous round's session.\n   405\t\tround  int\n   406\t\tthread *ReviewThread\n   407\t\t// extraChannels are outputs the interruption classifier reads beside the\n   408\t\t// transcript and the output, each on its own: a task's stderr.\n   409\t\textraChannels  []string\n   410\t\tnotes          string\n   411\t\tExisting       *ReviewRun\n   412\t\tLimitOf        string\n   413\t\tReason         string\n   414\t\tPolicyDigest   string\n   415\t\tOriginWorktree string\n   416\t\tAdapter        string\n   417\t\tConfig         ReviewerAdapter\n   418\t\tBrief          ReviewBrief\n   419\t\tBundle         ReviewBundle\n   420\t\tSealedCommit   string\n   421\t\tPriorRuns      int\n   422\t\t// Effort is the requested effort level; \"\" means the agent's default.\n   423\t\tEffort string\n   424\t\t// Label, Purpose and Lead are recorded on the run (pose delegate).\n   425\t\tLabel   string\n   426\t\tPurpose string\n   427\t\tLead    string\n   428\t\t// Routing is set by pose delegate; without it the run is compared with\n   429\t\t// the implementation the plan read (spec pose-delegation-routing R8).\n   430\t\tRouting        *DelegationRoutingRecord\n   431\t\timplementation *ReviewBundleImplementation\n   432\t\t// Warnings are printed before the run starts. SameVendorWarning is set\n   433\t\t// when the plan's agent shares the implementation's vendor; a caller that\n   434\t\t// named the agent prints it, routing does not (R9).\n   435\t\tWarnings          []string\n   436\t\tSameVendorWarning string\n   437\t\t// OnStart is called once the attempt is reserved and its marker written,\n   438\t\t// so a detached run can hand its reference back (spec\n   439\t\t// pose-delegated-review-completion-signal R1).\n   440\t\tOnStart func(attempt string) error\n   441\t}\n   442\t\n   443\t// Implementation is the identity the plan compares its agent with.\n   444\tfunc (p DispatchPlan) Implementation() ReviewBundleImplementation {\n   445\t\tswitch {\n   446\t\tcase p.Routing != nil:\n   447\t\t\treturn p.Routing.Implementation\n   448\t\tcase p.implementation != nil:\n   449\t\t\treturn *p.implementation\n   450\t\t}\n   451\t\treturn ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n   452\t}\n   453\t\n   454\t// replanContinuation plans a continuation again at execution, as a resume or\n   455\t// as a handoff to the same agent.\n   456\tfunc (s Store) replanContinuation(plan DispatchPlan) (DispatchPlan, error) {\n   457\t\tvar fresh DispatchPlan\n   458\t\tvar err error\n   459\t\tif plan.handoff {\n   460\t\t\tfresh, err = s.PlanReviewHandoff(plan.predecessor.RunID, plan.Adapter)\n   461\t\t} else {\n   462\t\t\tfresh, err = s.PlanReviewResume(plan.predecessor.RunID)\n   463\t\t}\n   464\t\tif err != nil {\n   465\t\t\treturn fresh, err\n   466\t\t}\n   467\t\t// What the caller set on the plan is kept: the hand-back of a detached run\n   468\t\t// and the routing that chose its agent (spec pose-delegation-mcp R4).\n   469\t\tfresh.OnStart, fresh.Purpose = plan.OnStart, plan.Purpose\n   470\t\tif fresh.Routing == nil {\n   471\t\t\tfresh.Routing = plan.Routing\n   472\t\t}\n   473\t\treturn fresh, nil\n   474\t}\n   475\t\n   476\t// PlanImplementationWithLead reads the plan's implementation again with the\n   477\t// --lead the caller declared, for a bundle that records none (R4), and records\n   478\t// the agent as named.\n   479\tfunc (s Store) PlanImplementationWithLead(plan *DispatchPlan, lead string) {\n   480\t\tplan.Routing, plan.Warnings, plan.SameVendorWarning = nil, nil, \"\"\n   481\t\ts.planImplementation(plan, lead)\n   482\t}\n   483\t\n   484\t// routingAgainstAnotherBundle refuses a routing decision made against an\n   485\t// implementation the plan's bundle does not record: the run would record an\n   486\t// identity and an independence it did not have (spec pose-delegation-routing\n   487\t// R8).\n   488\tfunc routingAgainstAnotherBundle(plan DispatchPlan) string {\n   489\t\tif plan.Routing == nil || plan.Routing.ImplementationFrom != ImplementationFromBundle {\n   490\t\t\treturn \"\"\n   491\t\t}\n   492\t\tsealed := plan.Bundle.Payload.Implementation\n   493\t\tif sealed == nil || !sameImplementation(*sealed, plan.Routing.Implementation) {\n   494\t\t\treturn \"the run was routed against another implementation than bundle \" + plan.Bundle.BundleID + \" records; route it again\"\n   495\t\t}\n   496\t\treturn \"\"\n   497\t}\n   498\t\n   499\t// planImplementation reads the identity a run of bundle is compared with,\n   500\t// records the agent as named unless routing chose it (R8, R9), and warns when\n   501\t// the policy still declares an identity the bundle overrides (R4).\n   502\tfunc (s Store) planImplementation(plan *DispatchPlan, lead string) {\n   503\t\timpl := ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n   504\t\tfrom := ImplementationFromNone\n   505\t\tif policy, _, found, err := s.LoadDelegationPolicy(); err == nil && found {\n   506\t\t\tif read, readFrom, err := s.RoutingImplementation(plan.Bundle, policy, lead); err == nil {\n   507\t\t\t\timpl, from = read, readFrom\n   508\t\t\t}\n   509\t\t\tif plan.Bundle.Payload.Implementation != nil && policy.Provenance != nil && policy.Provenance.Implementation != (ModelIdentity{}) {\n   510\t\t\t\tplan.Warnings = append(plan.Warnings, \"provenance.implementation in the delegation policy is ignored: bundle \"+plan.Bundle.BundleID+\" records the implementation it was sealed by; remove the policy entry\")\n   511\t\t\t}\n   512\t\t}\n   513\t\tplan.implementation = &impl\n   514\t\tif plan.Routing == nil {\n   515\t\t\trecord := ExplicitDelegationRoute(plan.Adapter, impl, from)\n   516\t\t\tplan.Routing = &record\n   517\t\t}\n   518\t\tif knownIdentityPart(impl.Vendor) && normalizeIdentityPart(plan.Config.Vendor) == impl.Vendor {\n   519\t\t\tplan.SameVendorWarning = \"agent \" + plan.Adapter + \" shares the implementation's vendor (\" + impl.Vendor + \"); the run cannot achieve vendor independence\"\n   520\t\t}\n   521\t}\n   522\t\n   523\t// PlanReviewDispatch resolves the bundle, brief and adapter without running.\n   524\tfunc (s Store) PlanReviewDispatch(target, kind, notes, adapter string, reason ...string) (DispatchPlan, error) {\n   525\t\tif err := validateReviewNotes(notes); err != nil {\n   526\t\t\treturn DispatchPlan{}, err\n   527\t\t}\n   528\t\tif len(reason) > 1 {\n   529\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: one rerun reason is accepted\")\n   530\t\t}\n   531\t\twhy := \"\"\n   532\t\tif len(reason) == 1 {\n   533\t\t\twhy = strings.TrimSpace(reason[0])\n   534\t\t}\n   535\t\tbrief, err := s.RenderReviewBrief(target, kind, notes)\n   536\t\tif err != nil {\n   537\t\t\treturn DispatchPlan{}, err\n   538\t\t}\n   539\t\tbundle, err := s.LoadReviewBundle(brief.BundleID)\n   540\t\tif err != nil {\n   541\t\t\treturn DispatchPlan{}, err\n   542\t\t}\n   543\t\tpolicy, found, err := s.LoadReviewersPolicyFor(brief.Kind)\n   544\t\tif err != nil {\n   545\t\t\treturn DispatchPlan{}, err\n   546\t\t}\n   547\t\tif !found || len(policy.Adapters) == 0 {\n   548\t\t\treturn DispatchPlan{Brief: brief, Bundle: bundle}, ErrNoReviewerAdapter\n   549\t\t}\n   550\t\tconfig, ok := policy.Adapters[adapter]\n   551\t\tif !ok {\n   552\t\t\tnames := make([]string, 0, len(policy.Adapters))\n   553\t\t\tfor name := range policy.Adapters {\n   554\t\t\t\tnames = append(names, name)\n   555\t\t\t}\n   556\t\t\tsort.Strings(names)\n   557\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: no reviewer adapter %q; configured: %s\", adapter, strings.Join(names, \", \"))\n   558\t\t}\n   559\t\tcommit := bundle.Payload.Subject.Head\n   560\t\tif commit == \"\" || RawHistoryGit(s.Root, \"cat-file\", \"-e\", commit+\"^{commit}\").Run() != nil {\n   561\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: the bundle's sealed commit %q is not in this repository\", commit)\n   562\t\t}\n   563\t\torigin, err := dispatchWorktreeIdentity(s.Root)\n   564\t\tif err != nil {\n   565\t\t\treturn DispatchPlan{}, err\n   566\t\t}\n   567\t\tplan := DispatchPlan{notes: notes, Reason: why, PolicyDigest: directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")), OriginWorktree: origin, Adapter: adapter, Config: config, Brief: brief, Bundle: bundle, SealedCommit: commit, PriorRuns: 0}\n   568\t\truns, losses, err := s.ReadReviewRuns(bundle.BundleID)\n   569\t\tif err != nil {\n   570\t\t\treturn DispatchPlan{}, err\n   571\t\t}\n   572\t\tif len(losses) > 0 {\n   573\t\t\treturn DispatchPlan{}, fmt.Errorf(\"review history incomplete: %v\", losses)\n   574\t\t}\n   575\t\tcontinued := map[string]bool{}\n   576\t\tfor _, r := range runs {\n   577\t\t\tif r.continues() != \"\" {\n   578\t\t\t\tcontinued[r.continues()] = true\n   579\t\t\t}\n   580\t\t}\n   581\t\tfor _, prior := range runs {\n   582\t\t\tif prior.Status == ReviewRunInterrupted && prior.SupersededBy == \"\" && !continued[prior.RunID] && prior.Interruption != nil && prior.Interruption.Cause == \"usage-limit\" && prior.Adapter != adapter {\n   583\t\t\t\tplan.LimitOf, plan.Reason = prior.RunID, \"limit-of:\"+prior.RunID\n   584\t\t\t}\n   585\t\t}\n   586\t\t_, currentCount, err := s.reviewAttemptAdmission(plan)\n   587\t\tif err != nil {\n   588\t\t\treturn DispatchPlan{}, err\n   589\t\t}\n   590\t\tif _, _, err := reviewAdapterEnvironment(config, \"\", brief.Text, notes); err != nil {\n   591\t\t\treturn DispatchPlan{}, err\n   592\t\t}\n   593\t\tplan.PriorRuns = currentCount\n   594\t\tif brief.Kind == ReviewBriefKindReview {\n   595\t\t\tif err := s.planReviewThread(&plan); err != nil {\n   596\t\t\t\treturn DispatchPlan{}, err\n   597\t\t\t}\n   598\t\t}\n   599\t\ts.planImplementation(&plan, \"\")\n   600\t\tplan.provenance, err = s.prepareRunProvenance(plan, policy)\n   601\t\tif err != nil {\n   602\t\t\treturn DispatchPlan{}, err\n   603\t\t}\n   604\t\treturn plan, nil\n   605\t}\n   606\t\n   607\t// ErrNoReviewerAdapter means the project configured no reviewer.\n   608\tvar ErrNoReviewerAdapter = errors.New(\"pose: no agent is configured in .pose/policy/delegation.json\")\n   609\t\n   610\t// RunReviewDispatch executes plan and records the run, failed or completed.\n   611\tfunc (s Store) RunReviewDispatch(plan DispatchPlan, now func() time.Time) (ReviewRun, error) {\n   612\t\treturn s.RunReviewDispatchContext(context.Background(), plan, now)\n   613\t}\n   614\t\n   615\t// RunReviewDispatchContext also propagates caller cancellation to the covered\n   616\t// process set. Cleanup has its own bounded context and never respawns the adapter.\n   617\tfunc (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPlan, now func() time.Time) (result ReviewRun, resultErr error) {\n   618\t\tif err := parent.Err(); err != nil {\n   619\t\t\treturn ReviewRun{}, err\n   620\t\t}\n   621\t\tif why := routingAgainstAnotherBundle(plan); why != \"\" {\n   622\t\t\treturn ReviewRun{}, errors.New(\"pose: \" + why)\n   623\t\t}\n   624\t\t// pose delegate cancel stops the run through this context (R13).\n   625\t\tparent, cancelRun := context.WithCancel(parent)\n   626\t\tdefer cancelRun()\n   627\t\tvar cancelled *atomic.Bool\n   628\t\tif plan.PendingContinuation != nil {\n   629\t\t\treturn ReviewRun{}, plan.PendingContinuation\n   630\t\t}\n   631\t\tif plan.Existing != nil {\n   632\t\t\tif plan.predecessor == nil {\n   633\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation lacks predecessor\")\n   634\t\t\t}\n   635\t\t\tfresh, err := s.replanContinuation(plan)\n   636\t\t\tif err != nil {\n   637\t\t\t\treturn ReviewRun{}, err\n   638\t\t\t}\n   639\t\t\tif fresh.Existing == nil {\n   640\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation disappeared\")\n   641\t\t\t}\n   642\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   643\t\t}\n   644\t\tif _, _, err := reviewAdapterEnvironment(plan.Config, \"\", plan.Brief.Text, plan.notes); err != nil {\n   645\t\t\treturn ReviewRun{}, err\n   646\t\t}\n   647\t\trun := ReviewRun{Provenance: plan.provenance, BriefNotes: plan.notes, LimitOf: plan.LimitOf, SchemaVersion: 1, Scope: plan.Brief.Scope, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest,\n   648\t\t\tSealedCommit: plan.SealedCommit, Kind: plan.Brief.Kind, BriefDigest: plan.Brief.Digest, Adapter: plan.Adapter,\n   649\t\t\tVendor: plan.Config.Vendor, Model: plan.Config.Model, Reason: plan.Reason, PolicyDigest: plan.PolicyDigest, StartedAt: now().UTC().Format(time.RFC3339Nano), ExitCode: -1,\n   650\t\t\tLabel: plan.Label, Purpose: plan.Purpose, Lead: plan.Lead, Events: plan.Config.Events, Routing: plan.Routing, Round: plan.round, Thread: plan.thread}\n   651\t\timpl := plan.Implementation()\n   652\t\trun.IndependenceAchieved = AchievedIndependence(impl.Vendor, impl.Model, plan.Config.Vendor, plan.Config.Model)\n   653\t\tsafety, err := ResolveReviewerContainment(plan.Config)\n   654\t\tif err != nil {\n   655\t\t\treturn ReviewRun{}, err\n   656\t\t}\n   657\t\tif err := validateReviewNotes(plan.notes); err != nil {\n   658\t\t\treturn ReviewRun{}, err\n   659\t\t}\n   660\t\trun.Safety = safety\n   661\t\tvar cleanup func() error\n   662\t\tvar cleanupErr error\n   663\t\tvar terminationFailed bool\n   664\t\tcleaned := false\n   665\t\tdoCleanup := func() {\n   666\t\t\tif cleaned {\n   667\t\t\t\treturn\n   668\t\t\t}\n   669\t\t\tcleaned = true\n   670\t\t\toutcome := NewOperationResult(\"review.dispatch.cleanup\", run.Scope)\n   671\t\t\toutcome.StepsRun = append(outcome.StepsRun, OperationStep{ID: \"cleanup\", Result: \"done\"})\n   672\t\t\tif terminationFailed {\n   673\t\t\t\tcleanupErr = fmt.Errorf(\"process termination incomplete; runtime resources retained\")\n   674\t\t\t} else if cleanup != nil {\n   675\t\t\t\tcleanupErr = cleanup()\n   676\t\t\t}\n   677\t\t\tif cleanupErr != nil {\n   678\t\t\t\toutcome.StepsRun[0].Result = \"failed\"\n   679\t\t\t\toutcome.Fail(OutcomeFailed, \"cleanup\", \"cleanup-incomplete\", cleanupErr.Error())\n   680\t\t\t\toutcome.Unconfirmed = []OperationUncertain{{Step: \"cleanup\", Reason: \"owned resources may remain; no automatic respawn\"}}\n   681\t\t\t} else {\n   682\t\t\t\toutcome.Outcome = OutcomeCompleted\n   683\t\t\t}\n   684\t\t\trun.Safety.Operation = outcome\n   685\t\t}\n   686\t\tdefer func() {\n   687\t\t\tdoCleanup()\n   688\t\t\tif cleanupErr != nil {\n   689\t\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n   690\t\t\t}\n   691\t\t}()\n   692\t\ttranscript := []byte{}\n   693\t\tfinish := func(status, failure string) (ReviewRun, error) {\n   694\t\t\tdoCleanup()\n   695\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n   696\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n   697\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n   698\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n   699\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n   700\t\t\t}\n   701\t\t\trun.sessionForRedaction = \"\"\n   702\t\t\trun.Status, run.Failure = status, failure\n   703\t\t\tif status != ReviewRunInterrupted {\n   704\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n   705\t\t\t}\n   706\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n   707\t\t\treturn s.recordReviewRun(run, transcript)\n   708\t\t}\n   709\t\t// Recompute semantic freshness at execution time, not just preview time.\n   710\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n   711\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   712\t\t}\n   713\t\tvar attempt DelegatedReviewAttempt\n   714\t\tif plan.predecessor == nil {\n   715\t\t\tvar err error\n   716\t\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n   717\t\t\tif err != nil {\n   718\t\t\t\treturn ReviewRun{}, err\n   719\t\t\t}\n   720\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n   721\t\t} else {\n   722\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n   723\t\t\tfresh, err := s.replanContinuation(plan)\n   724\t\t\tif err != nil {\n   725\t\t\t\treturn ReviewRun{}, err\n   726\t\t\t}\n   727\t\t\tif fresh.PendingContinuation != nil {\n   728\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n   729\t\t\t}\n   730\t\t\tif fresh.Existing != nil {\n   731\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   732\t\t\t}\n   733\t\t\tplan = fresh\n   734\t\t\trun.Provenance = fresh.provenance\n   735\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n   736\t\t\tif fresh.handoff {\n   737\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n   738\t\t\t} else {\n   739\t\t\t\trun.Resumes = fresh.predecessor.RunID\n   740\t\t\t}\n   741\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n   742\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n   743\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n   744\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n   745\t\t\t\treturn ReviewRun{}, err\n   746\t\t\t}\n   747\t\t}\n   748\t\t// The attempt result is published once: before the active marker goes\n   749\t\t// when the run was marked, at return otherwise (spec\n   750\t\t// pose-delegation-result-before-marker R1–R2).\n   751\t\tresultPublished := false\n   752\t\treserved := plan.predecessor != nil\n   753\t\tpublishResult := func() {\n   754\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n   755\t\t\t\treturn\n   756\t\t\t}\n   757\t\t\tresultPublished = true\n   758\t\t\tbeforeRunResultPublished(result)\n   759\t\t\tvar err error\n   760\t\t\tif plan.predecessor == nil {\n   761\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   762\t\t\t} else {\n   763\t\t\t\terr = s.finishReviewContinuation(result)\n   764\t\t\t}\n   765\t\t\tif err != nil {\n   766\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n   767\t\t\t}\n   768\t\t}\n   769\t\tdefer publishResult()\n   770\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n   771\t\tif err != nil {\n   772\t\t\tif plan.predecessor == nil {\n   773\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n   774\t\t\t\t// receipt are recorded against it, as before the marker moved\n   775\t\t\t\t// ahead of the reservation (spec\n   776\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n   777\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n   778\t\t\t\t\treturn ReviewRun{}, perr\n   779\t\t\t\t}\n   780\t\t\t\treserved = true\n   781\t\t\t}\n   782\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   783\t\t}\n   784\t\tif plan.predecessor == nil {\n   785\t\t\tbeforeAttemptPublished(s, attempt)\n   786\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n   787\t\t\t\tstopActive()\n   788\t\t\t\treturn ReviewRun{}, err\n   789\t\t\t}\n   790\t\t\treserved = true\n   791\t\t}\n   792\t\t// The marker goes only once the record and the attempt result are\n   793\t\t// published: without them it is the one trace of the reserved attempt,\n   794\t\t// and a waiter that sees it gone must find the receipt.\n   795\t\tdefer func() {\n   796\t\t\tpublishResult()\n   797\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n   798\t\t}()\n   799\t\tcancelled = cancelFlag\n   800\t\t// A detached run that cannot hand its attempt back stops here: nobody\n   801\t\t// would know which attempt runs (R1).\n   802\t\tif plan.OnStart != nil {\n   803\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n   804\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n   805\t\t\t}\n   806\t\t}\n   807\t\ttmp, err := os.MkdirTemp(\"\", \"pose-review-run-*\")\n   808\t\tif err != nil {\n   809\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n   810\t\t}\n   811\t\tsafety.RuntimeID = filepath.Base(tmp)\n   812\t\towned, err := os.Lstat(tmp)\n   813\t\tif err != nil {\n   814\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n   815\t\t}\n   816\t\truntimeRoot, err := os.OpenRoot(tmp)\n   817\t\tif err != nil {\n   818\t\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n   819\t\t}\n   820\t\tdefer runtimeRoot.Close()\n   821\t\tvar worktreeOwned os.FileInfo\n   822\t\tvar gitMarker []byte\n   823\t\tvar ownership *reviewCleanupOwnership\n   824\t\tworktree := filepath.Join(tmp, \"worktree\")\n   825\t\tcleanup = func() error {\n   826\t\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n   827\t\t}\n   828\t\thooks := filepath.Join(tmp, \"empty-hooks\")\n   829\t\tif err := os.Mkdir(hooks, 0700); err != nil {\n   830\t\t\treturn finish(ReviewRunFailed, \"private hook directory setup failed\")\n   831\t\t}\n   832\t\tsetupCtx, stopSetup := context.WithTimeout(parent, 2*time.Minute)\n   833\t\tdefer stopSetup()\n   834\t\tsetup := reviewSetupCommand(setupCtx, gitCommand(\"-C\", s.Root, \"-c\", \"core.hooksPath=\"+hooks, \"worktree\", \"add\", \"--detach\", worktree, plan.SealedCommit))\n   835\t\tsetupOutput := &reviewBoundedCapture{limit: 64 << 10, cancel: stopSetup}\n   836\t\tsetup.Stdout, setup.Stderr = setupOutput, setupOutput\n   837\t\tsetupErr := setup.Run()\n   838\t\t_, setupOverflow := setupOutput.result()\n   839\t\tterminationErr := killProcessGroup(setup)\n   840\t\tif terminationErr != nil {\n   841\t\t\tterminationFailed = true\n   842\t\t}\n   843\t\tsetupCause := executionCause(setupCtx)\n   844\t\tif setupErr != nil || terminationErr != nil || setupOverflow {\n   845\t\t\tsafety.ExecutionCause = setupCause\n   846\t\t\tif setupOverflow {\n   847\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   848\t\t\t}\n   849\t\t\treturn finish(ReviewRunFailed, \"review worktree setup failed or termination incomplete\")\n   850\t\t}\n   851\t\n   852\t\tworktreeOwned, err = os.Lstat(worktree)\n   853\t\tif err != nil {\n   854\t\t\treturn finish(ReviewRunFailed, \"worktree identity unavailable\")\n   855\t\t}\n   856\t\tgitMarker, err = ReadReviewAdapterFile(filepath.Join(worktree, \".git\"), 4096)\n   857\t\tif err != nil {\n   858\t\t\treturn finish(ReviewRunFailed, \"worktree marker unavailable\")\n   859\t\t}\n   860\t\townership, err = s.captureReviewCleanupOwnership(runtimeRoot, worktree, gitMarker)\n   861\t\tif err != nil {\n   862\t\t\treturn finish(ReviewRunFailed, \"worktree registration ownership unavailable\")\n   863\t\t}\n   864\t\tdefer ownership.registry.Close()\n   865\t\n   866\t\tsubmodules := map[string]bool{}\n   867\t\tfor _, entry := range plan.Bundle.Payload.Subject.Entries {\n   868\t\t\tif entry.Class == \"submodule\" {\n   869\t\t\t\tsubmodules[reviewBundleEntryPath(entry)] = true\n   870\t\t\t}\n   871\t\t}\n   872\t\tcommittedWorktreeBytes := ownership.inventoryBytes - gitSnapshotMarginBytes\n   873\t\tgitlinks := reviewGitlinkSetup{\n   874\t\t\tctx: setupCtx, cancel: stopSetup, hooks: hooks,\n   875\t\t\tmetadata:          filepath.Join(tmp, reviewGitlinkMetadataDir),\n   876\t\t\tmaxCommittedBytes: gitSnapshotCeilingBytes - committedWorktreeBytes,\n   877\t\t}\n   878\t\tgitlinkErr := gitlinks.materialize(s.Root, worktree, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries)\n   879\t\townership.inventoryBytes = gitSnapshotBudget(committedWorktreeBytes + gitlinks.committedBytes)\n   880\t\townership.gitlinkMetadata = gitlinks.metadataOwned\n   881\t\townership.gitlinkMetadataBytes = gitSnapshotBudget(gitlinks.committedBytes)\n   882\t\tif gitlinkErr != nil {\n   883\t\t\tterminationFailed = gitlinks.terminationFailure\n   884\t\t\tsafety.ExecutionCause = executionCause(setupCtx)\n   885\t\t\tif gitlinks.captureOverflow {\n   886\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   887\t\t\t}\n   888\t\t\treturn finish(ReviewRunFailed, \"sealed gitlink setup failed: \"+gitlinkErr.Error())\n   889\t\t}\n   890\t\tstopSetup()\n   891\t\tcheckout := s\n   892\t\tcheckout.Root, checkout.indexPin = worktree, nil\n   893\t\tif prepared, err := checkout.PrepareReviewBundle(plan.Brief.Scope); err != nil {\n   894\t\t\treturn finish(ReviewRunFailed, \"sealed checkout inputs unavailable: \"+err.Error())\n   895\t\t} else if blockers := checkoutBlockers(prepared.Blockers); len(blockers) > 0 {\n   896\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout blocked: %v\", blockers))\n   897\t\t} else if differing := sealedInputsThatDiffer(plan.Bundle, prepared, worktree); len(differing) > 0 {\n   898\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout inputs differ: %v\", differing))\n   899\t\t}\n   900\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n   901\t\t\treturn finish(ReviewRunFailed, err.Error())\n   902\t\t}\n   903\t\tif err := verifyBundleMaterialization(worktree, plan.Bundle); err != nil {\n   904\t\t\treturn finish(ReviewRunFailed, err.Error())\n   905\t\t}\n   906\t\tif plan.Purpose == DelegationPurposeReview && plan.Config.Events == DelegationEventsClaudeStreamJSON {\n   907\t\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n   908\t\t\tif err != nil {\n   909\t\t\t\treturn finish(ReviewRunFailed, \"review staging policy unavailable\")\n   910\t\t\t}\n   911\t\t\tif found && policy.Agents[plan.Adapter].ReviewProfile != nil {\n   912\t\t\t\tif err := prepareClaudeReviewStaging(runtimeRoot, plan.Bundle.Payload.Plan.Components); err != nil {\n   913\t\t\t\t\treturn finish(ReviewRunFailed, \"review staging directories unavailable\")\n   914\t\t\t\t}\n   915\t\t\t}\n   916\t\t}\n   917\t\tdiskBefore, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n   918\t\tif err != nil {\n   919\t\t\treturn finish(ReviewRunFailed, err.Error())\n   920\t\t}\n   921\t\n   922\t\trawTree, err := json.Marshal(diskBefore)\n   923\t\tif err != nil {\n   924\t\t\treturn finish(ReviewRunFailed, err.Error())\n   925\t\t}\n   926\t\tif plan.predecessor != nil && (!plan.handoff || plan.predecessor.TreeDigest != \"\") && digestBytes(rawTree) != plan.predecessor.TreeDigest {\n   927\t\t\treturn finish(ReviewRunFailed, \"recreated worktree tree digest differs\")\n   928\t\t}\n   929\t\trun.TreeDigest = digestBytes(rawTree)\n   930\t\toutputFile := filepath.Join(tmp, \"output.txt\")\n   931\t\tcommand := plan.Config.Command\n   932\t\tif plan.predecessor != nil && !plan.handoff || plan.thread.continued() {\n   933\t\t\tcommand = plan.Config.Resume.Command\n   934\t\t}\n   935\t\targv := ReviewerArgv(command, outputFile, plan.session, plan.Effort, plan.Config.Effort)\n   936\t\ttimeout := time.Duration(safety.TimeoutMS) * time.Millisecond\n   937\t\texecPath := argv[0]\n   938\t\tif run.Provenance != nil {\n   939\t\t\tcopy := *run.Provenance\n   940\t\t\trun.Provenance = &copy\n   941\t\t\tselected, resolved, err := provenanceExecutableSelection(argv[0], worktree)\n   942\t\t\tif err != nil {\n   943\t\t\t\treturn finish(ReviewRunFailed, \"provenance executable could not be resolved\")\n   944\t\t\t}\n   945\t\t\tdigest, err := reviewExecutableDigest(resolved)\n   946\t\t\tif err != nil {\n   947\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n   948\t\t\t}\n   949\t\t\trun.Provenance.ExecutableDigest = digest\n   950\t\t\texecPath = selected\n   951\t\t\traw, _ := json.Marshal(argv)\n   952\t\t\trun.Provenance.ArgvDigest = digestBytes(raw)\n   953\t\t}\n   954\t\tif plan.processTimeout > 0 {\n   955\t\t\tstarted, err := time.Parse(time.RFC3339Nano, run.StartedAt)\n   956\t\t\tif err != nil {\n   957\t\t\t\treturn finish(ReviewRunFailed, \"invalid execution start\")\n   958\t\t\t}\n   959\t\t\tsetup := now().Sub(started)\n   960\t\t\tremaining := plan.processTimeout - setup\n   961\t\t\tif setup < 0 || remaining <= 0 {\n   962\t\t\t\treturn finish(ReviewRunFailed, \"accumulated wall-clock budget spent before adapter launch\")\n   963\t\t\t}\n   964\t\t\tif remaining < timeout {\n   965\t\t\t\ttimeout = remaining\n   966\t\t\t}\n   967\t\t}\n   968\t\tctx, cancel := context.WithTimeout(parent, timeout)\n   969\t\tdefer cancel()\n   970\t\tcmd := exec.CommandContext(ctx, execPath, argv[1:]...)\n   971\t\tcmd.Args[0] = argv[0]\n   972\t\t// The adapter runs under the review run shim, which ends what the run\n   973\t\t// leaves in its subtree (review_shim.go).\n   974\t\tuseShim := false\n   975\t\tvar shimRead, shimWrite *os.File\n   976\t\tif ReviewShimAvailable && runtime.GOOS == \"linux\" && cmd.Err == nil {\n   977\t\t\t// The adapter's path as resolved here, in the dispatcher's PATH.\n   978\t\t\tif self, err := os.Executable(); err == nil {\n   979\t\t\t\tif r, w, err := os.Pipe(); err == nil {\n   980\t\t\t\t\tuseShim, shimRead, shimWrite = true, r, w\n   981\t\t\t\t\tcmd = exec.CommandContext(ctx, self, append([]string{ReviewShimArg, cmd.Path}, argv...)...)\n   982\t\t\t\t\tcmd.ExtraFiles = []*os.File{w}\n   983\t\t\t\t}\n   984\t\t\t}\n   985\t\t}\n   986\t\tcmd.Dir = worktree\n   987\t\tcmd.Stdin = strings.NewReader(plan.Brief.Text)\n   988\t\tenv, secrets, err := reviewAdapterEnvironment(plan.Config, tmp, plan.Brief.Text, plan.notes)\n   989\t\tif err != nil {\n   990\t\t\trun.BriefNotes = \"\"\n   991\t\t\treturn finish(ReviewRunFailed, err.Error())\n   992\t\t}\n   993\t\tunset := []string{}\n   994\t\tif policy, _, found, perr := s.LoadDelegationPolicy(); perr == nil && found {\n   995\t\t\tunset = policy.EnvUnset\n   996\t\t}\n   997\t\tenv, run.EnvRemoved = withoutParentSession(env, unset)\n   998\t\t// The reviewer works in a sealed checkout: diagnostics it runs must not\n   999\t\t// publish derived records into it (SealedCheckoutEnv).\n  1000\t\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n  1001\t\tif useShim {\n  1002\t\t\tenv = append(env, ReviewShimReportEnv+\"=\"+fmt.Sprint(os.Getpid()))\n  1003\t\t}\n  1004\t\t// The reviewer checks its draft against the sealed bundle and the round\n  1005\t\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n  1006\t\t// context that cannot be built leaves the check unavailable, never the\n  1007\t\t// review.\n  1008\t\tif plan.Purpose == DelegationPurposeReview {\n  1009\t\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n  1010\t\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n  1011\t\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n  1012\t\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n  1013\t\t\t\t\t// engine that dispatched the run is the one that checks it.\n  1014\t\t\t\t\tif self, err := os.Executable(); err == nil {\n  1015\t\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n  1016\t\t\t\t\t}\n  1017\t\t\t\t}\n  1018\t\t\t}\n  1019\t\t}\n  1020\t\tcmd.Env = env\n  1021\t\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n  1022\t\tcmd.Stdout, cmd.Stderr = combined, combined\n  1023\t\t// pose delegate watch follows the normalized, redacted events as they come\n  1024\t\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n  1025\t\t// the record is published.\n  1026\t\tsessionPattern := \"\"\n  1027\t\tif plan.Config.Session != nil {\n  1028\t\t\tsessionPattern = plan.Config.Session.Pattern\n  1029\t\t}\n  1030\t\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n  1031\t\t\ttee := io.MultiWriter(combined, live)\n  1032\t\t\tcmd.Stdout, cmd.Stderr = tee, tee\n  1033\t\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n  1034\t\t\tdefer live.Close()\n  1035\t\t}\n  1036\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n  1037\t\t// only the parent left a child holding stdout, so the timeout never fired\n  1038\t\t// (found in review). The run gets its own process group, the whole group\n  1039\t\t// is killed on timeout and after the run, and pipes are released at most\n  1040\t\t// a few seconds after the kill.\n  1041\t\topaqueBaseline := reviewOpaqueProcessBaseline()\n  1042\t\t// Orphans of the run are reparented to this process, so one that left\n  1043\t\t// the group and cleared its environment is still found (review round 6, N2).\n  1044\t\tisolateProcessGroup(cmd)\n  1045\t\tcmd.WaitDelay = AdapterPipeGrace\n  1046\t\tvar shimReport []byte\n  1047\t\tshimReportDone := make(chan struct{})\n  1048\t\tif useShim {\n  1049\t\t\t// A timeout asks the shim to end the run's subtree first; the group\n  1050\t\t\t// kill after Wait remains the backstop (review round 8, N3).\n  1051\t\t\tcmd.Cancel = stopReviewShim(cmd)\n  1052\t\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n  1053\t\t\tgo func() {\n  1054\t\t\t\tdefer close(shimReportDone)\n  1055\t\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n  1056\t\t\t}()\n  1057\t\t} else {\n  1058\t\t\tclose(shimReportDone)\n  1059\t\t}\n  1060\t\tvar runErr error\n  1061\t\tif run.Provenance == nil {\n  1062\t\t\trunErr = cmd.Run()\n  1063\t\t} else {\n  1064\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1065\t\t\trunErr = err\n  1066\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1067\t\t\tif started {\n  1068\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1069\t\t\t}\n  1070\t\t}\n  1071\t\tif useShim {\n  1072\t\t\t_ = shimWrite.Close()\n  1073\t\t\t<-shimReportDone\n  1074\t\t\t_ = shimRead.Close()\n  1075\t\t}\n  1076\t\tterminationErr = killProcessGroup(cmd)\n  1077\t\t// A command the reviewer left running in a session of its own escapes the\n  1078\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1079\t\t// directories it may still write (spec\n  1080\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1081\t\t// The environment entry is the reviewer's to set, so it is searched only\n  1082\t\t// without the shim, whose subtree is the run's by construction (review\n  1083\t\t// round 8, N1).\n  1084\t\tvar reaped []string\n  1085\t\tvar opaque int\n  1086\t\tvar reapErr error\n  1087\t\tif !useShim {\n  1088\t\t\treaped, opaque, reapErr = reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n  1089\t\t\tif reapErr != nil {\n  1090\t\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1091\t\t\t}\n  1092\t\t}\n  1093\t\tif useShim && cmd.ProcessState != nil {\n  1094\t\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n  1095\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1096\t\t\t} else {\n  1097\t\t\t\tfor _, pid := range report.Ended {\n  1098\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1099\t\t\t\t}\n  1100\t\t\t\tif report.Error != \"\" {\n  1101\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1102\t\t\t\t}\n  1103\t\t\t}\n  1104\t\t}\n  1105\t\tif len(reaped) > 0 && safety != nil {\n  1106\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n  1107\t\t}\n  1108\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1109\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1110\t\t}\n  1111\t\tterminationFailed = terminationErr != nil\n  1112\t\t// The adapter exited and a child it left still held the output when\n  1113\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1114\t\t// the exit status decides (found in review).\n  1115\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1116\t\t\trunErr = nil\n  1117\t\t}\n  1118\t\ttranscript, overflow := combined.result()\n  1119\t\tsafety.CaptureComplete = !overflow\n  1120\t\tif cmd.ProcessState != nil {\n  1121\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1122\t\t}\n  1123\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n  1124\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n  1125\t\t\tsafety.CaptureComplete = false\n  1126\t\t}\n  1127\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1128\t\t\trun.Output = string(raw)\n  1129\t\t\tif run.Provenance != nil {\n  1130\t\t\t\trun.Provenance.OutputComplete = true\n  1131\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1132\t\t\t}\n  1133\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1134\t\t\t// The agent writes no output file; its stream names its final message.\n  1135\t\t\trun.Output = final\n  1136\t\t\tif run.Provenance != nil {\n  1137\t\t\t\trun.Provenance.OutputComplete = true\n  1138\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1139\t\t\t}\n  1140\t\t} else {\n  1141\t\t\trun.Output = tail(string(transcript), 20000)\n  1142\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1143\t\t\t\tsafety.CaptureComplete = false\n  1144\t\t\t}\n  1145\t\t\tif run.Provenance != nil {\n  1146\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1147\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1148\t\t\t}\n  1149\t\t}\n  1150\t\tif run.Provenance != nil {\n  1151\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n  1152\t\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n  1153\t\t}\n  1154\t\tif runErr != nil && cmd.ProcessState == nil {\n  1155\t\t\trun.Output, transcript = \"\", nil\n  1156\t\t\tif run.Provenance != nil {\n  1157\t\t\t\trun.Provenance.OutputComplete = false\n  1158\t\t\t}\n  1159\t\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n  1160\t\t}\n  1161\t\t// Raw provenance hashes above precede redaction; only complete, bounded\n  1162\t\t// redacted channels can be retained. Partial boundaries can expose a secret.\n  1163\t\tsafety.ExecutionCause = executionCause(ctx)\n  1164\t\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n  1165\t\t\tsafety.CaptureComplete = false\n  1166\t\t}\n  1167\t\tif !safety.CaptureComplete {\n  1168\t\t\ttranscript = nil\n  1169\t\t\trun.Output = \"\"\n  1170\t\t\tif run.Provenance != nil {\n  1171\t\t\t\trun.Provenance.OutputComplete = false\n  1172\t\t\t}\n  1173\t\t\tif terminationErr != nil {\n  1174\t\t\t\treturn finish(ReviewRunFailed, \"process group termination failed; descendants may remain\")\n  1175\t\t\t}\n  1176\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1177\t\t\treturn finish(ReviewRunFailed, \"adapter capture incomplete: stream/output limit or unsafe output file\")\n  1178\t\t}\n  1179\t\tcaptureStage := \"session/interrupt recognition\"\n  1180\t\tstatus, failure, captureErr := s.classifyReviewInterruption(&run, plan, transcript, runErr, ctx.Err())\n  1181\t\tif captureErr == nil {\n  1182\t\t\tvar redactErr error\n  1183\t\t\traw := transcript\n  1184\t\t\tcaptureStage = \"stdout\"\n  1185\t\t\ttranscript, redactErr = redactReviewCapture(transcript, secrets, run.sessionForRedaction, safety.StreamBytes)\n  1186\t\t\tvar output []byte\n  1187\t\t\tif redactErr == nil {\n  1188\t\t\t\tcaptureStage = \"final output\"\n  1189\t\t\t\toutput, redactErr = redactReviewCapture([]byte(run.Output), secrets, run.sessionForRedaction, safety.OutputBytes)\n  1190\t\t\t}\n  1191\t\t\trun.Output = string(output)\n  1192\t\t\tif redactErr == nil && run.Events != \"\" {\n  1193\t\t\t\tcaptureStage = \"normalized events\"\n  1194\t\t\t\t// Events are parsed from the decoded stream, where a JSON escape no longer\n  1195\t\t\t\t// hides a value: each text is redacted again after decoding.\n  1196\t\t\t\trun.eventsBytes, redactErr = redactedDelegationEvents(run.Events, raw, run.Output, secrets, run.sessionForRedaction)\n  1197\t\t\t}\n  1198\t\t\tif redactErr != nil {\n  1199\t\t\t\tcaptureErr = redactErr\n  1200\t\t\t}\n  1201\t\t}\n  1202\t\tif captureErr != nil {\n  1203\t\t\trun.Output, transcript = \"\", nil\n  1204\t\t\tsafety.CaptureComplete = false\n  1205\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1206\t\t\tif run.Provenance != nil {\n  1207\t\t\t\trun.Provenance.OutputComplete = false\n  1208\t\t\t}\n  1209\t\t\treturn finish(ReviewRunFailed, \"adapter capture failed; unredacted output withheld; \"+delegationCaptureFailure(run.Adapter, run.Events, captureStage, captureErr))\n  1210\t\t}\n  1211\t\trun.sessionForRedaction = \"\"\n  1212\t\n  1213\t\tif status != \"\" {\n  1214\t\t\t// Partial drafts are evidence only after the same containment checks.\n  1215\t\t\tafter, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n  1216\t\t\tif err != nil || !reflect.DeepEqual(diskBefore, after) {\n  1217\t\t\t\treturn finish(ReviewRunFailed, \"interrupted adapter changed or obscured the sealed worktree\")\n  1218\t\t\t}\n  1219\t\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n  1220\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1221\t\t\t}\n  1222\t\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n  1223\t\t\t\treturn finish(ReviewRunFailed, \"origin changed during interruption: \"+err.Error())\n  1224\t\t\t}\n  1225\t\t\tif status == ReviewRunInterrupted {\n  1226\t\t\t\trun.PartialDigest = digestBytes([]byte(run.Output))\n  1227\t\t\t}\n  1228\t\t\treturn finish(status, failure)\n  1229\t\t}\n  1230\t\tdiskAfter, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n  1231\t\tif err != nil {\n  1232\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1233\t\t}\n  1234\t\tif !reflect.DeepEqual(diskBefore, diskAfter) {\n  1235\t\t\tchanged := []string{}\n  1236\t\t\tfor path, digest := range diskBefore {\n  1237\t\t\t\tif diskAfter[path] != digest {\n  1238\t\t\t\t\tchanged = append(changed, path)\n  1239\t\t\t\t}\n  1240\t\t\t}\n  1241\t\t\tfor path := range diskAfter {\n  1242\t\t\t\tif _, exists := diskBefore[path]; !exists {\n  1243\t\t\t\t\tchanged = append(changed, path)\n  1244\t\t\t\t}\n  1245\t\t\t}\n  1246\t\t\tsort.Strings(changed)\n  1247\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"the run changed files in the sealed worktree (including ignored materialization): %q\", changed))\n  1248\t\t}\n  1249\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n  1250\t\t\treturn finish(ReviewRunFailed, err.Error())\n  1251\t\t}\n  1252\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n  1253\t\t\treturn finish(ReviewRunFailed, \"origin or policy changed: \"+err.Error())\n  1254\t\t}\n  1255\t\n  1256\t\tevents := run.eventsBytes\n  1257\t\tif run.Kind == ReviewBriefKindReview {\n  1258\t\t\t// The round and the draft's account of it are judged when the run\n  1259\t\t\t// completes, against the rounds before it (R1, R4).\n  1260\t\t\tround, err := s.ReviewRoundOf(plan.Bundle)\n  1261\t\t\tif err != nil {\n  1262\t\t\t\treturn finish(ReviewRunFailed, \"the round of the bundle cannot be derived: \"+err.Error())\n  1263\t\t\t}\n  1264\t\t\trun.Round, run.DraftProblems = round.Number, ValidateRoundDraft(round, run.Output)\n  1265\t\t}\n  1266\t\tpublished, err := finish(ReviewRunCompleted, \"\")\n  1267\t\tif err != nil {\n  1268\t\t\treturn published, err\n  1269\t\t}\n  1270\t\tif why := s.checkDispatchOrigin(plan); why != nil {\n  1271\t\t\tlate := published\n  1272\t\t\tlate.RunID, late.Path, late.TranscriptDigest, late.TranscriptPath = \"\", \"\", \"\", \"\"\n  1273\t\t\tlate.Status, late.Failure, late.Supersedes = ReviewRunFailed, why.Error(), published.RunID\n  1274\t\t\tlate.eventsBytes = events\n  1275\t\t\tlate.EndedAt = now().UTC().Format(time.RFC3339Nano)\n  1276\t\t\treturn s.recordReviewRun(late, transcript)\n  1277\t\t}\n  1278\t\treturn published, nil\n  1279\t}\n  1280\t\n  1281\t// Materialize only empty vendor staging directories in the disposable checkout,\n  1282\t// before its integrity snapshot. Files created there remain visible as mutations.\n  1283\t// The source repository and the legacy read profile are untouched.\n  1284\tfunc prepareClaudeReviewStaging(runtime *os.Root, components []ReviewPlanComponent) error {\n  1285\t\troot, err := runtime.OpenRoot(\"worktree\")\n  1286\t\tif err != nil {\n  1287\t\t\treturn err\n  1288\t\t}\n  1289\t\tdefer root.Close()\n  1290\t\tpaths := []string{\".\"}\n  1291\t\tfor _, component := range components {\n  1292\t\t\tif !filepath.IsLocal(component.Path) {\n  1293\t\t\t\treturn fmt.Errorf(\"review staging component is not confined\")\n  1294\t\t\t}\n  1295\t\t\tpaths = append(paths, component.Path)\n  1296\t\t}\n  1297\t\tfor _, path := range paths {\n  1298\t\t\tif err := root.MkdirAll(filepath.Join(path, \".claude\", \".cc-writes\"), 0o700); err != nil {\n  1299\t\t\t\treturn err\n  1300\t\t\t}\n  1301\t\t}\n  1302\t\treturn nil\n  1303\t}\n  1304\t\n  1305\t// The adapter has no authenticated producer/output declaration. Until such a\n  1306\t// declaration exists, a directory name cannot authorize regenerated evidence.\n  1307\tfunc verifyDispatchWorktree(root, commit string) error {\n  1308\t\treturn verifyDispatchWorktreeFor(root, commit, nil)\n  1309\t}\n  1310\tfunc verifyDispatchWorktreeFor(root, commit string, submodules map[string]bool) error {\n  1311\t\thead, err := snapshotGit(root, \"rev-parse\", \"--verify\", \"HEAD\")\n  1312\t\tif err != nil {\n  1313\t\t\treturn err\n  1314\t\t}\n  1315\t\tif strings.TrimSpace(string(head)) != commit {\n  1316\t\t\treturn fmt.Errorf(\"the run moved the worktree off the sealed commit\")\n  1317\t\t}\n  1318\t\tpaths, err := WorktreeDivergenceFor(root, commit, nil, func(p string) bool { return submodules == nil || submodules[p] })\n  1319\t\tif err != nil {\n  1320\t\t\treturn err\n  1321\t\t}\n  1322\t\n  1323\t\tif len(paths) > 0 {\n  1324\t\t\treturn fmt.Errorf(\"the run changed files in the sealed worktree: %q\", paths)\n  1325\t\t}\n  1326\t\treturn nil\n  1327\t}\n  1328\t\n  1329\tfunc (s Store) checkDispatchOrigin(plan DispatchPlan) error {\n  1330\t\torigin, err := dispatchWorktreeIdentity(s.Root)\n  1331\t\tif err != nil {\n  1332\t\t\treturn err\n  1333\t\t}\n  1334\t\tif plan.OriginWorktree == \"\" || origin != plan.OriginWorktree {\n  1335\t\t\treturn fmt.Errorf(\"dispatch origin conflict: worktree identity changed\")\n  1336\t\t}\n  1337\t\tif _, err := dispatchRegularInputPath(s.Root, s.activeDelegationPolicyPath()); err != nil {\n  1338\t\t\treturn err\n  1339\t\t}\n  1340\t\tpolicy, found, err := s.LoadReviewersPolicyFor(plan.Brief.Kind)\n  1341\t\tif err != nil {\n  1342\t\t\treturn fmt.Errorf(\"dispatch adapter policy unavailable: %w\", err)\n  1343\t\t}\n  1344\t\tif !found || !reflect.DeepEqual(policy.Adapters[plan.Adapter], plan.Config) {\n  1345\t\t\treturn fmt.Errorf(\"dispatch origin stale: reviewer adapter policy changed\")\n  1346\t\t}\n  1347\t\tif plan.SealedCommit != plan.Bundle.Payload.Subject.Head || plan.Brief.BundleID != plan.Bundle.BundleID || plan.Brief.BundleDigest != plan.Bundle.BundleDigest {\n  1348\t\t\treturn fmt.Errorf(\"dispatch input conflict: plan does not identify its sealed bundle\")\n  1349\t\t}\n  1350\t\t// A handoff brief is the generated brief followed by its section; the\n  1351\t\t// generated part keeps its own digest (spec pose-delegation-handoff R4).\n  1352\t\ttext := plan.Brief.Text\n  1353\t\tif plan.handoff {\n  1354\t\t\tgenerated, ok := strings.CutSuffix(text, plan.handoffSection)\n  1355\t\t\tif !ok || plan.handoffSection == \"\" {\n  1356\t\t\t\treturn fmt.Errorf(\"dispatch input conflict: handoff section changed\")\n  1357\t\t\t}\n  1358\t\t\ttext = generated\n  1359\t\t}\n  1360\t\tbody, ok := strings.CutSuffix(text, \"\\n<!-- brief-digest: \"+plan.Brief.Digest+\" -->\\n\")\n  1361\t\tif !ok || digestBytes([]byte(body)) != plan.Brief.Digest {\n  1362\t\t\treturn fmt.Errorf(\"dispatch input conflict: brief digest changed\")\n  1363\t\t}\n  1364\t\tif _, err := snapshotGit(s.Root, \"rev-parse\", \"--verify\", \"HEAD\"); err != nil {\n  1365\t\t\treturn err\n  1366\t\t}\n  1367\t\tif _, err := gitChangedPaths(s.Root); err != nil {\n  1368\t\t\treturn err\n  1369\t\t}\n  1370\t\tdigest, err := reviewBundlePayloadDigest(plan.Bundle.Payload)\n  1371\t\tif err != nil || digest != plan.Bundle.BundleDigest {\n  1372\t\t\treturn fmt.Errorf(\"dispatch input conflict: bundle payload no longer matches its sealed digest\")\n  1373\t\t}\n  1374\t\t// Inspect types and bytes before a freshness reader can follow an input.\n  1375\t\tif err := verifyBundleMaterialization(s.Root, plan.Bundle); err != nil {\n  1376\t\t\treturn err\n  1377\t\t}\n  1378\t\tif mismatch := sourceMaterializationDiffers(s.Root, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries); mismatch != \"\" {\n  1379\t\t\treturn fmt.Errorf(\"source materialization differs: %s\", mismatch)\n  1380\t\t}\n  1381\t\tif reason := s.dispatchNoLongerGoverns(plan); reason != \"\" {\n  1382\t\t\treturn fmt.Errorf(\"%s\", reason)\n  1383\t\t}\n  1384\t\n  1385\t\treturn nil\n  1386\t}\n  1387\t\n  1388\tfunc dispatchWorktreeIdentity(root string) (string, error) {\n  1389\t\ttop, err := snapshotGit(root, \"rev-parse\", \"--show-toplevel\")\n  1390\t\tif err != nil {\n  1391\t\t\treturn \"\", err\n  1392\t\t}\n  1393\t\tabs, err := filepath.Abs(root)\n  1394\t\tif err != nil {\n  1395\t\t\treturn \"\", err\n  1396\t\t}\n  1397\t\tabs, err = filepath.EvalSymlinks(abs)\n  1398\t\tif err != nil {\n  1399\t\t\treturn \"\", err\n  1400\t\t}\n  1401\t\ttopPath, err := filepath.EvalSymlinks(strings.TrimSpace(string(top)))\n  1402\t\tif err != nil || abs != topPath {\n  1403\t\t\treturn \"\", fmt.Errorf(\"dispatch origin conflict: Git selected a different worktree\")\n  1404\t\t}\n  1405\t\tdir, err := snapshotGit(root, \"rev-parse\", \"--absolute-git-dir\")\n  1406\t\tif err != nil {\n  1407\t\t\treturn \"\", err\n  1408\t\t}\n  1409\t\treturn string(top) + \"\\x00\" + string(dir), nil\n  1410\t}\n  1411\t\n  1412\tfunc verifyBundleMaterialization(root string, bundle ReviewBundle) error {\n  1413\t\tfor _, entry := range bundle.Payload.Subject.Entries {\n  1414\t\t\tpath := entry.Path\n  1415\t\t\tif entry.NewPath != \"\" {\n  1416\t\t\t\tpath = entry.NewPath\n  1417\t\t\t}\n  1418\t\t\tif entry.Class == \"submodule\" {\n  1419\t\t\t\tfull, err := dispatchInputPath(root, path)\n  1420\t\t\t\tif err != nil {\n  1421\t\t\t\t\treturn err\n  1422\t\t\t\t}\n  1423\t\t\t\tif _, err := dispatchWorktreeIdentity(full); err != nil {\n  1424\t\t\t\t\treturn err\n  1425\t\t\t\t}\n  1426\t\t\t\thead, err := snapshotGit(full, \"rev-parse\", \"--verify\", \"HEAD\")\n  1427\t\t\t\tif err != nil {\n  1428\t\t\t\t\treturn err\n  1429\t\t\t\t}\n  1430\t\t\t\tif digestBytes([]byte(strings.TrimSpace(string(head)))) != entry.Digest {\n  1431\t\t\t\t\treturn fmt.Errorf(\"dispatch input conflict: submodule %q moved\", path)\n  1432\t\t\t\t}\n  1433\t\t\t\tif err := verifyDispatchWorktree(full, strings.TrimSpace(string(head))); err != nil {\n  1434\t\t\t\t\treturn err\n  1435\t\t\t\t}\n  1436\t\t\t\tcontinue\n  1437\t\t\t}\n  1438\t\t\tif entry.Action == \"removed\" {\n  1439\t\t\t\tif _, err := os.Lstat(filepath.Join(root, filepath.FromSlash(path))); !errors.Is(err, os.ErrNotExist) {\n  1440\t\t\t\t\treturn fmt.Errorf(\"dispatch input conflict: removed path %q exists or is unreadable\", path)\n  1441\t\t\t\t}\n  1442\t\t\t\tcontinue\n  1443\t\t\t}\n  1444\t\t\tif err := verifyDispatchInput(root, path, entry.Digest, true); err != nil {\n  1445\t\t\t\treturn err\n  1446\t\t\t}\n  1447\t\t}\n  1448\t\tfor _, input := range bundle.Payload.ConsumedInputs {\n  1449\t\t\tswitch input.Kind {\n  1450\t\t\tcase \"governed-config\", \"review-profile\", \"rule\":\n  1451\t\t\t\tif err := verifyDispatchInput(root, input.Path, input.Digest, false); err != nil {\n  1452\t\t\t\t\treturn err\n  1453\t\t\t\t}\n  1454\t\t\t}\n  1455\t\t}\n  1456\t\treturn nil\n  1457\t}\n  1458\t\n  1459\tfunc dispatchInputPath(root, path string) (string, error) {\n  1460\t\tvar err error\n  1461\t\troot, err = filepath.Abs(root)\n  1462\t\tif err != nil {\n  1463\t\t\treturn \"\", &GitSnapshotError{\"root\", err}\n  1464\t\t}\n  1465\t\tif path == \"\" || filepath.IsAbs(path) || filepath.ToSlash(filepath.Clean(path)) != path || path == \"..\" || strings.HasPrefix(path, \"../\") {\n  1466\t\t\treturn \"\", fmt.Errorf(\"dispatch input conflict: unsafe path %q\", path)\n  1467\t\t}\n  1468\t\tfull := filepath.Join(root, filepath.FromSlash(path))\n  1469\t\tfor parent := full; parent != root; parent = filepath.Dir(parent) {\n  1470\t\t\tinfo, err := os.Lstat(parent)\n  1471\t\t\tif err != nil {\n  1472\t\t\t\treturn \"\", &GitSnapshotError{\"input \" + path, err}\n  1473\t\t\t}\n  1474\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n  1475\t\t\t\treturn \"\", fmt.Errorf(\"dispatch input conflict: symlink %q\", path)\n  1476\t\t\t}\n  1477\t\t}\n  1478\t\treturn full, nil\n  1479\t}\n  1480\t\n  1481\tfunc verifyDispatchInput(root, path, digest string, normalize bool) error {\n  1482\t\tfull, err := dispatchRegularInputPath(root, path)\n  1483\t\tif err != nil {\n  1484\t\t\treturn err\n  1485\t\t}\n  1486\t\tfile, err := os.Open(full)\n  1487\t\tif err != nil {\n  1488\t\t\treturn &GitSnapshotError{\"input \" + path, err}\n  1489\t\t}\n  1490\t\traw, readErr := io.ReadAll(io.LimitReader(file, (256<<20)+1))\n  1491\t\tcloseErr := file.Close()\n  1492\t\tif readErr != nil {\n  1493\t\t\treturn &GitSnapshotError{\"input \" + path, readErr}\n  1494\t\t}\n  1495\t\tif closeErr != nil {\n  1496\t\t\treturn &GitSnapshotError{\"input \" + path, closeErr}\n  1497\t\t}\n  1498\t\tif len(raw) > 256<<20 {\n  1499\t\t\treturn &GitSnapshotError{\"input \" + path, fmt.Errorf(\"input exceeds 256 MiB\")}\n  1500\t\t}\n  1501\t\tif normalize {\n  1502\t\t\traw = bytes.ReplaceAll(raw, []byte(\"\\r\\n\"), []byte(\"\\n\"))\n  1503\t\t}\n  1504\t\tif digest == \"\" || digestBytes(raw) != digest {\n  1505\t\t\treturn fmt.Errorf(\"dispatch input conflict: sealed bytes changed for %q\", path)\n  1506\t\t}\n  1507\t\treturn nil\n  1508\t}\n  1509\t\n  1510\tfunc dispatchRegularInputPath(root, path string) (string, error) {\n  1511\t\tfull, err := dispatchInputPath(root, path)\n  1512\t\tif err != nil {\n  1513\t\t\treturn \"\", err\n  1514\t\t}\n  1515\t\tinfo, err := os.Lstat(full)\n  1516\t\tif err != nil {\n  1517\t\t\treturn \"\", &GitSnapshotError{\"input \" + path, err}\n  1518\t\t}\n  1519\t\tif !info.Mode().IsRegular() {\n  1520\t\t\treturn \"\", fmt.Errorf(\"dispatch input conflict: %q is not a regular file\", path)\n  1521\t\t}\n  1522\t\treturn full, nil\n  1523\t}\n  1524\t\n  1525\t// ReviewerArgv expands a command template: \"{effort}\" becomes the argv\n  1526\t// fragment of the effort level (the agent's default when level is \"\"), and\n  1527\t// \"{output}\" and \"{session}\" become their values. Schema 2 templates hold\n  1528\t// placeholders only as whole elements; schema 1 templates keep their\n  1529\t// in-element replacement.\n  1530\tfunc ReviewerArgv(command []string, output, session, level string, effort *ReviewerEffort) []string {\n  1531\t\targv := make([]string, 0, len(command))\n  1532\t\tfor _, arg := range command {\n  1533\t\t\tif arg == \"{effort}\" {\n  1534\t\t\t\tif effort != nil {\n  1535\t\t\t\t\tif level == \"\" {\n  1536\t\t\t\t\t\tlevel = effort.Default\n  1537\t\t\t\t\t}\n  1538\t\t\t\t\targv = append(argv, effort.Levels[level]...)\n  1539\t\t\t\t}\n  1540\t\t\t\tcontinue\n  1541\t\t\t}\n  1542\t\t\targv = append(argv, strings.ReplaceAll(strings.ReplaceAll(arg, \"{output}\", output), \"{session}\", session))\n  1543\t\t}\n  1544\t\treturn argv\n  1545\t}\n  1546\t\n  1547\tfunc tail(s string, n int) string {\n  1548\t\tif len(s) <= n {\n  1549\t\t\treturn s\n  1550\t\t}\n  1551\t\treturn s[len(s)-n:]\n  1552\t}\n  1553\t\n  1554\t// beforeAttemptPublished runs between the active marker and the reservation;\n  1555\t// tests use it to stop a dispatch there.\n  1556\tvar beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {}\n  1557\t\n  1558\tfunc (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\n  1559\t\t// Identity covers only persisted content, never fields derived by a reader\n  1560\t\t// or a previous write of a copied record.\n  1561\t\trun.RunID, run.Path, run.TranscriptPath, run.SupersededBy = \"\", \"\", \"\", \"\"\n  1562\t\trun.LedgerVersion = 1\n  1563\t\tsum := sha256.Sum256(transcript)\n  1564\t\trun.TranscriptDigest = \"sha256:\" + hex.EncodeToString(sum[:])\n  1565\t\tvar events []byte\n  1566\t\trun.EventsDigest = \"\"\n  1567\t\tif run.Events != \"\" {\n  1568\t\t\tevents = run.eventsBytes\n  1569\t\t\trun.EventsDigest = digestBytes(events)\n  1570\t\t}\n  1571\t\trun.eventsBytes = nil // never part of the record or of a copy compared with it\n  1572\t\tidentity, _ := json.Marshal(run)\n  1573\t\tidSum := sha256.Sum256(identity)\n  1574\t\trun.RunID = \"rrn-\" + hex.EncodeToString(idSum[:])[:16]\n  1575\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, reviewRunsDir, true)\n  1576\t\tif err != nil {\n  1577\t\t\treturn ReviewRun{}, err\n  1578\t\t}\n  1579\t\trun.TranscriptPath = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\"))\n  1580\t\tpretty, err := json.MarshalIndent(run, \"\", \"  \")\n  1581\t\tif err != nil {\n  1582\t\t\treturn ReviewRun{}, err\n  1583\t\t}\n  1584\t\tpretty = append(pretty, '\\n')\n  1585\t\tif len(pretty) > reviewLedgerMaxBytes {\n  1586\t\t\treturn ReviewRun{}, fmt.Errorf(\"review run record exceeds %d-byte bound; nothing published\", reviewLedgerMaxBytes)\n  1587\t\t}\n  1588\t\tif len(transcript) > reviewTranscriptMaxBytes {\n  1589\t\t\treturn ReviewRun{}, fmt.Errorf(\"review transcript exceeds %d-byte bound; nothing published\", reviewTranscriptMaxBytes)\n  1590\t\t}\n  1591\t\n  1592\t\twitness := reviewRunWitness{SchemaVersion: 1, RunID: run.RunID, BundleID: run.BundleID, Scope: run.Scope, RecordDigest: digestBytes(pretty), TranscriptDigest: run.TranscriptDigest}\n  1593\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(filepath.Join(reviewRunLedgerDir, run.RunID+\".json\")), witness); err != nil {\n  1594\t\t\treturn ReviewRun{}, err\n  1595\t\t}\n  1596\t\tif run.Safety != nil && int64(len(pretty)+len(transcript)+len(events)) > run.Safety.RetainedBytes {\n  1597\t\t\treturn ReviewRun{}, fmt.Errorf(\"retained run exceeds containment byte budget; attempt remains incomplete\")\n  1598\t\t}\n  1599\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".transcript\"), transcript, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1600\t\t\treturn ReviewRun{}, err\n  1601\t\t}\n  1602\t\tif run.EventsDigest != \"\" {\n  1603\t\t\tif err := publishDelegationEvents(dir, run.RunID, events); err != nil {\n  1604\t\t\t\treturn ReviewRun{}, err\n  1605\t\t\t}\n  1606\t\t}\n  1607\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".json\"), pretty, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1608\t\t\treturn ReviewRun{}, err\n  1609\t\t}\n  1610\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".json\"))\n  1611\t\treturn run, nil\n  1612\t}\n  1613\t\n  1614\tfunc (s Store) dispatchNoLongerGoverns(plan DispatchPlan) string {\n  1615\t\tcurrent, err := s.LoadReviewBundle(plan.Bundle.BundleID)\n  1616\t\tif err != nil {\n  1617\t\t\treturn \"stale: the bundle the run reviewed can no longer be read: \" + err.Error()\n  1618\t\t}\n  1619\t\tif current.BundleDigest != plan.Bundle.BundleDigest {\n  1620\t\t\treturn \"stale: the bundle the run reviewed changed while it ran\"\n  1621\t\t}\n  1622\t\t// The baseline is a digest of a policy that was read whole, and the policy must still\n  1623\t\t// read whole and unchanged: a policy that cannot be read now is not an unchanged one.\n  1624\t\tif !directoryDigestKnown(plan.PolicyDigest) {\n  1625\t\t\treturn \"stale: the dispatch has no readable policy baseline (\" + plan.PolicyDigest + \")\"\n  1626\t\t}\n  1627\t\tif now := directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")); now != plan.PolicyDigest {\n  1628\t\t\t// A run recorded before pose update converted reviewers.json keeps its\n  1629\t\t\t// baseline while delegation.json is exactly that conversion (D7).\n  1630\t\t\tif before, ok := s.migratedPolicyBaseline(); !ok || before != plan.PolicyDigest {\n  1631\t\t\t\treturn \"stale: the policy changed or can no longer be read whole while the run was going (\" + now + \")\"\n  1632\t\t\t}\n  1633\t\t}\n  1634\t\t// Every sealed bundle of the scope must have been read: one that cannot be read may be\n  1635\t\t// the one that superseded this.\n  1636\t\tread, readErr := s.ReadReviewBundles(plan.Brief.Scope)\n  1637\t\tif readErr != nil {\n  1638\t\t\treturn \"stale: the bundles of the scope could not be read: \" + readErr.Error()\n  1639\t\t}\n  1640\t\tif !read.Coverage.CompleteFor(plan.Brief.Scope) {\n  1641\t\t\treturn \"stale: a sealed bundle of the scope could not be read, so the run cannot be tied to the one that governs it\"\n  1642\t\t}\n  1643\t\t// The bundle governs while the inputs it sealed are the ones the repository has now:\n  1644\t\t// the semantic digest of today's preparation, not the order of identifiers.\n  1645\t\tprepared, prepErr := s.PrepareReviewBundle(plan.Brief.Scope)\n  1646\t\tif prepErr != nil {\n  1647\t\t\treturn \"stale: the inputs of the scope could not be prepared again: \" + prepErr.Error()\n  1648\t\t}\n  1649\t\tif !sealedBundleMatches(plan.Bundle, prepared) {\n  1650\t\t\treturn \"stale: the bundle was superseded or its inputs changed while the run was going (the scope now prepares \" + prepared.BundleDigest + \")\"\n  1651\t\t}\n  1652\t\t// Equal content is not the governing bundle: a later seal may have replaced\n  1653\t\t// the implementation identity this run was compared with.\n  1654\t\tif governing := governingSealedBundle(read.Bundles, prepared); governing == nil || governing.BundleID != plan.Bundle.BundleID {\n  1655\t\t\treturn \"stale: another sealed bundle of the same content now governs the scope (its implementation identity was sealed again)\"\n  1656\t\t}\n  1657\t\t// An equal digest is not an eligible preparation: a preparation that carries blockers\n  1658\t\t// (an unreadable Git status among them) did not read what it says it read.\n  1659\t\tif len(prepared.Blockers) > 0 {\n  1660\t\t\treturn \"stale: the scope cannot be prepared for review without blockers: \" + strings.Join(prepared.Blockers, \"; \")\n  1661\t\t}\n  1662\t\t// The digest of a file is its bytes; the mode the commit recorded is part of what was\n  1663\t\t// sealed, and a status that is told to ignore modes cannot be the witness of it.\n  1664\t\t// The revision of the source must be readable: an unreadable HEAD is not a HEAD that did not move.\n  1665\t\tif hasGitMetadata(s.Root) {\n  1666\t\t\tif _, headErr := ReadGitHead(s.Root); headErr != nil && !errors.Is(headErr, ErrGitUnavailable) {\n  1667\t\t\t\treturn \"stale: the revision of the source could not be read: \" + headErr.Error()\n  1668\t\t\t}\n  1669\t\t}\n  1670\t\tif mismatch := sourceMaterializationDiffers(s.Root, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries); mismatch != \"\" {\n  1671\t\t\treturn \"stale: the source file \" + mismatch + \" differs from what the sealed commit records\"\n  1672\t\t}\n  1673\t\treturn \"\"\n  1674\t}\n  1675\t\n  1676\t// ReviewRunRecordStands says why the record of a completed run no longer stands, or \"\": the\n  1677\t// run completed with a safe record, no other run superseded it, the persisted record is the\n  1678\t// copy in hand, its transcript is intact and the bundle it names reads with the digest, scope\n  1679\t// and sealed commit it recorded. It asks nothing of the repository as it is now.\n  1680\tfunc (s Store) ReviewRunRecordStands(run ReviewRun) string {\n  1681\t\tif why := reviewSafetyConflict(run); why != \"\" {\n  1682\t\t\treturn why\n  1683\t\t}\n  1684\t\tif run.Status != ReviewRunCompleted {\n  1685\t\t\treturn \"the run is \" + run.Status + \", not completed\"\n  1686\t\t}\n  1687\t\truns, lost, err := s.ReadReviewRuns(\"\")\n  1688\t\tif err != nil {\n  1689\t\t\treturn \"the runs of the bundle could not be read: \" + err.Error()\n  1690\t\t}\n  1691\t\tif len(lost) > 0 {\n  1692\t\t\treturn \"a run record could not be read and may supersede this run: \" + strings.Join(lost, \", \")\n  1693\t\t}\n  1694\t\tvar persisted *ReviewRun\n  1695\t\tfor i, other := range runs {\n  1696\t\t\tif other.Supersedes == run.RunID {\n  1697\t\t\t\treturn \"the run was superseded by \" + other.RunID\n  1698\t\t\t}\n  1699\t\t\tif other.RunID == run.RunID {\n  1700\t\t\t\tpersisted = &runs[i]\n  1701\t\t\t}\n  1702\t\t}\n  1703\t\t// The copy in hand is not the run: the record is, and it must be there and say the same.\n  1704\t\tif persisted == nil {\n  1705\t\t\treturn \"the record of the run is not in the review runs\"\n  1706\t\t}\n  1707\t\ta, b := *persisted, run\n  1708\t\ta.Path, a.SupersededBy, b.Path, b.SupersededBy = \"\", \"\", \"\", \"\"\n  1709\t\tif !reflect.DeepEqual(a, b) {\n  1710\t\t\treturn \"the record of the run differs from the copy that is being consulted\"\n  1711\t\t}\n  1712\t\tif why := s.reviewRunTranscriptIntact(*persisted); why != \"\" {\n  1713\t\t\treturn why\n  1714\t\t}\n  1715\t\tbundle, err := s.LoadReviewBundle(run.BundleID)\n  1716\t\tif err != nil {\n  1717\t\t\treturn \"the bundle of the run can no longer be read: \" + err.Error()\n  1718\t\t}\n  1719\t\t// The record says what it reviewed; what it says must be what the bundle is.\n  1720\t\tif run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.SealedCommit != bundle.Payload.Subject.Head {\n  1721\t\t\treturn \"the run record does not describe the bundle it names (bundle digest, scope or sealed commit differ)\"\n  1722\t\t}\n  1723\t\treturn \"\"\n  1724\t}\n  1725\t\n  1726\t// ReviewRunStillGoverns says why a run no longer governs its scope as the repository is now,\n  1727\t// or \"\": its record stands, Git answers, the persisted review inputs still materialize and the\n  1728\t// bundle it reviewed is still what the scope prepares.\n  1729\tfunc (s Store) ReviewRunStillGoverns(run ReviewRun) string {\n  1730\t\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n  1731\t\t\treturn why\n  1732\t\t}\n  1733\t\tif _, err := dispatchWorktreeIdentity(s.Root); err != nil {\n  1734\t\t\treturn \"origin Git identity unknown: \" + err.Error()\n  1735\t\t}\n  1736\t\tif _, err := ReadGitHead(s.Root); err != nil {\n  1737\t\t\treturn \"origin HEAD unknown: \" + err.Error()\n  1738\t\t}\n  1739\t\tbundle, err := s.LoadReviewBundle(run.BundleID)\n  1740\t\tif err != nil {\n  1741\t\t\treturn \"the bundle of the run can no longer be read: \" + err.Error()\n  1742\t\t}\n  1743\t\tif err := verifyBundleMaterialization(s.Root, bundle); err != nil {\n  1744\t\t\treturn \"persisted review inputs no longer materialize: \" + err.Error()\n  1745\t\t}\n  1746\t\treturn s.dispatchNoLongerGoverns(DispatchPlan{Bundle: bundle, Brief: ReviewBrief{Scope: run.Scope}, SealedCommit: run.SealedCommit,\n  1747\t\t\tPolicyDigest: run.PolicyDigest})\n  1748\t}\n  1749\t\n  1750\tfunc validateReviewRunRecord(name string, run ReviewRun) error {\n  1751\t\tif name != run.RunID+\".json\" {\n  1752\t\t\treturn fmt.Errorf(\"the file is not named after the run it holds\")\n  1753\t\t}\n  1754\t\tif run.LedgerVersion != 0 && run.LedgerVersion != 1 {\n  1755\t\t\treturn fmt.Errorf(\"unknown ledger version %d\", run.LedgerVersion)\n  1756\t\t}\n  1757\t\tif run.SchemaVersion != 1 {\n  1758\t\t\treturn fmt.Errorf(\"schema_version %d is not read by this engine\", run.SchemaVersion)\n  1759\t\t}\n  1760\t\tswitch run.Status {\n  1761\t\tcase ReviewRunCompleted, ReviewRunFailed, ReviewRunStale, ReviewRunInterrupted:\n  1762\t\tdefault:\n  1763\t\t\treturn fmt.Errorf(\"status %q is not a state of a run\", run.Status)\n  1764\t\t}\n  1765\t\tif err := validateContinuityRun(run); err != nil {\n  1766\t\t\treturn err\n  1767\t\t}\n  1768\t\tif run.BundleID == \"\" || run.Scope == \"\" {\n  1769\t\t\treturn fmt.Errorf(\"the bundle or scope is missing\")\n  1770\t\t}\n  1771\t\tfor _, at := range []string{run.StartedAt, run.EndedAt} {\n  1772\t\t\tif _, err := time.Parse(time.RFC3339Nano, at); err != nil {\n  1773\t\t\t\treturn fmt.Errorf(\"an instant of the run is not RFC3339: %q\", at)\n  1774\t\t\t}\n  1775\t\t}\n  1776\t\tif run.TranscriptPath != filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\")) {\n  1777\t\t\treturn fmt.Errorf(\"the transcript path is not the one the run is written with\")\n  1778\t\t}\n  1779\t\tunsealed := run\n  1780\t\tunsealed.RunID, unsealed.TranscriptPath, unsealed.SupersededBy, unsealed.Path = \"\", \"\", \"\", \"\"\n  1781\t\tidentity, _ := json.Marshal(unsealed)\n  1782\t\tsum := sha256.Sum256(identity)\n  1783\t\tif run.RunID != \"rrn-\"+hex.EncodeToString(sum[:])[:16] {\n  1784\t\t\treturn fmt.Errorf(\"the identity of the run is not derived from its content\")\n  1785\t\t}\n  1786\t\treturn nil\n  1787\t}\n  1788\t\n  1789\tconst reviewTranscriptMaxBytes = 256 << 20\n  1790\t\n  1791\tfunc (s Store) reviewRunTranscriptIntact(run ReviewRun) string {\n  1792\t\tproblem, _, err := memoizedLedgerRead(s.fsys(), \"transcript\\x00\"+filepath.Clean(s.Root)+\"\\x00\"+run.TranscriptPath+\"\\x00\"+run.TranscriptDigest, func() (string, error) {\n  1793\t\t\treturn s.checkReviewRunTranscript(run), nil\n  1794\t\t})\n  1795\t\tif err != nil {\n  1796\t\t\t// A refused read is not an intact transcript (review N1).\n  1797\t\t\treturn \"the transcript of the run cannot be inspected: \" + err.Error()\n  1798\t\t}\n  1799\t\treturn problem\n  1800\t}\n  1801\t\n  1802\t// checkReviewRunTranscript reads a run's transcript and checks it against\n  1803\t// the digest the run names; it returns the problem, or \"\".\n  1804\tfunc (s Store) checkReviewRunTranscript(run ReviewRun) string {\n  1805\t\tfull := filepath.Join(s.Root, filepath.FromSlash(run.TranscriptPath))\n  1806\t\tfiles := s.fsys()\n  1807\t\tinfo, err := files.Lstat(full)\n  1808\t\tif err != nil {\n  1809\t\t\treturn \"the transcript of the run cannot be inspected: \" + err.Error()\n  1810\t\t}\n  1811\t\tif !info.Mode().IsRegular() {\n  1812\t\t\treturn \"the transcript of the run is not a regular file\"\n  1813\t\t}\n  1814\t\tif info.Size() > reviewTranscriptMaxBytes {\n  1815\t\t\treturn \"the transcript exceeds the 256 MiB verification bound\"\n  1816\t\t}\n  1817\t\tfile, err := files.Open(full)\n  1818\t\tif err != nil {\n  1819\t\t\treturn \"the transcript of the run cannot be read: \" + err.Error()\n  1820\t\t}\n  1821\t\topened, statErr := file.Stat()\n  1822\t\tif statErr != nil || !opened.Mode().IsRegular() || !sameObservedFile(info, opened) {\n  1823\t\t\tfile.Close()\n  1824\t\t\treturn \"the transcript changed while opening\"\n  1825\t\t}\n  1826\t\thash := sha256.New()\n  1827\t\tn, readErr := io.Copy(hash, io.LimitReader(file, reviewTranscriptMaxBytes+1))\n  1828\t\tcloseErr := file.Close()\n  1829\t\tif readErr != nil || closeErr != nil {\n  1830\t\t\treturn fmt.Sprintf(\"the transcript could not be verified: %v %v\", readErr, closeErr)\n  1831\t\t}\n  1832\t\tif n > reviewTranscriptMaxBytes {\n  1833\t\t\treturn \"the transcript exceeds the 256 MiB verification bound\"\n  1834\t\t}\n  1835\t\tif \"sha256:\"+hex.EncodeToString(hash.Sum(nil)) != run.TranscriptDigest {\n  1836\t\t\treturn \"the transcript of the run is not the one its digest names\"\n  1837\t\t}\n  1838\t\treturn \"\"\n  1839\t}\n  1840\t\n  1841\tfunc removedSides(entry ReviewBundleSubjectEntry) []string {\n  1842\t\tswitch entry.Action {\n  1843\t\tcase \"removed\":\n  1844\t\t\tif p := reviewBundleEntryPath(entry); p != \"\" {\n  1845\t\t\t\treturn []string{p}\n  1846\t\t\t}\n  1847\t\tcase \"renamed\":\n  1848\t\t\tif entry.OldPath != \"\" {\n  1849\t\t\t\treturn []string{entry.OldPath}\n  1850\t\t\t}\n  1851\t\t}\n  1852\t\treturn nil\n  1853\t}\n  1854\t\n  1855\tfunc sealedInputsThatDiffer(sealed, other ReviewBundle, checkout string) []string {\n  1856\t\tkey := func(kind, p string) string { return kind + \" \" + p }\n  1857\t\tcollect := func(b ReviewBundle) map[string]string {\n  1858\t\t\tout := map[string]string{}\n  1859\t\t\tfor _, in := range b.Payload.Scope.Sections {\n  1860\t\t\t\tout[key(in.Kind, in.Path)] = in.Digest\n  1861\t\t\t}\n  1862\t\t\tfor _, in := range b.Payload.ConsumedInputs {\n  1863\t\t\t\tswitch in.Kind {\n  1864\t\t\t\tcase \"governed-config\", \"review-profile\", \"rule\":\n  1865\t\t\t\t\tout[key(in.Kind, in.Path)] = in.Digest\n  1866\t\t\t\t}\n  1867\t\t\t}\n  1868\t\t\treturn out\n  1869\t\t}\n  1870\t\twant, got := collect(sealed), collect(other)\n  1871\t\tvar differing []string\n  1872\t\tfor k, digest := range want {\n  1873\t\t\tif got[k] != digest {\n  1874\t\t\t\tdiffering = append(differing, k)\n  1875\t\t\t}\n  1876\t\t}\n  1877\t\t// The implementation the bundle sealed: each file of its subject, as the checkout holds it.\n  1878\t\tfor _, entry := range sealed.Payload.Subject.Entries {\n  1879\t\t\tif entry.Digest == \"\" || entry.Action == \"removed\" || entry.Class == \"submodule\" {\n  1880\t\t\t\tcontinue\n  1881\t\t\t}\n  1882\t\t\trel := reviewBundleEntryPath(entry)\n  1883\t\t\tif strings.HasPrefix(filepath.ToSlash(rel), pendingFragmentDir) {\n  1884\t\t\t\tcontinue // archived since: the ledger, not the path, holds it\n  1885\t\t\t}\n  1886\t\t\traw, err := os.ReadFile(filepath.Join(checkout, filepath.FromSlash(rel)))\n  1887\t\t\tif err != nil || digestBytes(bytes.ReplaceAll(raw, []byte(\"\\r\\n\"), []byte(\"\\n\"))) != entry.Digest {\n  1888\t\t\t\tdiffering = append(differing, \"subject \"+rel)\n  1889\t\t\t}\n  1890\t\t}\n  1891\t\tsort.Strings(differing)\n  1892\t\treturn differing\n  1893\t}\n  1894\t\n  1895\t// checkoutBlockers are the blockers of the sealed checkout that hold there. Two kinds do not,\n  1896\t// because they concern evidence that is not part of the sealed subject and that a checkout of\n  1897\t// the sealed commit cannot hold: the delivery integrity index (derived, not checked out) and the\n  1898\t// sealed review bundles of the children of a roadmap or milestone. The children are reviewed and\n  1899\t// committed before the roadmap bundle is sealed, but the subject's head is the last commit that\n  1900\t// changed a subject path, which is older than their records; the bundle sealed at the real head\n  1901\t// already judged them, and closing the scope judges them again (spec\n  1902\t// pose-sealed-checkout-does-not-require-later-child-evidence).\n  1903\tfunc checkoutBlockers(blockers []string) []string {\n  1904\t\tvar out []string\n  1905\t\tfor _, blocker := range blockers {\n  1906\t\t\tif strings.Contains(blocker, \"delivery integrity is unavailable\") || isChildReviewEvidenceBlocker(blocker) {\n  1907\t\t\t\tcontinue\n  1908\t\t\t}\n  1909\t\t\tout = append(out, blocker)\n  1910\t\t}\n  1911\t\treturn out\n  1912\t}\n  1913\t\n  1914\t// isChildReviewEvidenceBlocker recognises \"child <scope> has no sealed review bundle[: why]\".\n  1915\tfunc isChildReviewEvidenceBlocker(blocker string) bool {\n  1916\t\treturn strings.HasPrefix(blocker, \"child \") && strings.Contains(blocker, \" has no sealed review bundle\")\n  1917\t}\n  1918\t\n  1919\tfunc sourceMaterializationDiffers(root, commit string, entries []ReviewBundleSubjectEntry) string {\n  1920\t\tif commit == \"\" || !hasGitMetadata(root) {\n  1921\t\t\t// No sealed commit, or no repository at all: nothing to compare with (a dispatch has both).\n  1922\t\t\treturn \"\"\n  1923\t\t}\n  1924\t\tcheckedDirs := map[string]bool{}\n  1925\t\tfor _, entry := range entries {\n  1926\t\t\tif entry.Class == \"submodule\" {\n  1927\t\t\t\tcontinue\n  1928\t\t\t}\n  1929\t\t\t// The absence the bundle sealed is part of what it reviewed: a removed path, and the old\n  1930\t\t\t// side of a rename, must still be absent, whatever Git was told to ignore.\n  1931\t\t\tfor _, gone := range removedSides(entry) {\n  1932\t\t\t\tif _, err := os.Lstat(filepath.Join(root, filepath.FromSlash(gone))); err == nil {\n  1933\t\t\t\t\treturn gone + \" (the bundle sealed it as removed, and it is there)\"\n  1934\t\t\t\t}\n  1935\t\t\t}\n  1936\t\t\tif entry.Action == \"removed\" {\n  1937\t\t\t\tcontinue\n  1938\t\t\t}\n  1939\t\t\trel := reviewBundleEntryPath(entry)\n  1940\t\t\tif linkAbove(root, rel, checkedDirs) {\n  1941\t\t\t\treturn rel + \" (a directory above it is a link, or not a directory)\"\n  1942\t\t\t}\n  1943\t\t\tout, err := gitCommand(\"-C\", root, \"ls-tree\", \"-z\", commit, \"--\", rel).Output()\n  1944\t\t\tif err != nil {\n  1945\t\t\t\treturn rel + \" (its record in the sealed commit could not be read: \" + err.Error() + \")\"\n  1946\t\t\t}\n  1947\t\t\tmeta, _, ok := strings.Cut(strings.TrimSuffix(string(out), \"\\x00\"), \"\\t\")\n  1948\t\t\tfields := strings.Fields(meta)\n  1949\t\t\tif !ok || len(fields) < 3 {\n  1950\t\t\t\tcontinue // not in the sealed commit\n  1951\t\t\t}\n  1952\t\t\tmode, object := fields[0], fields[2]\n  1953\t\t\tinfo, lerr := os.Lstat(filepath.Join(root, filepath.FromSlash(rel)))\n  1954\t\t\tif lerr != nil {\n  1955\t\t\t\treturn rel + \" (it cannot be inspected: \" + lerr.Error() + \")\"\n  1956\t\t\t}\n  1957\t\t\tswitch mode {\n  1958\t\t\tcase \"120000\":\n  1959\t\t\t\ttarget, rerr := os.Readlink(filepath.Join(root, filepath.FromSlash(rel)))\n  1960\t\t\t\tif info.Mode()&os.ModeSymlink == 0 || rerr != nil || gitBlobID(\"sha1\", []byte(target)) != object && gitBlobID(\"sha256\", []byte(target)) != object {\n  1961\t\t\t\t\treturn rel + \" (it is not the link the sealed commit records)\"\n  1962\t\t\t\t}\n  1963\t\t\tdefault:\n  1964\t\t\t\tif !info.Mode().IsRegular() {\n  1965\t\t\t\t\treturn rel + \" (it is not a regular file, and the sealed commit records one)\"\n  1966\t\t\t\t}\n  1967\t\t\t\tif runtime.GOOS != \"windows\" && (info.Mode().Perm()&0o111 != 0) != (mode == \"100755\") {\n  1968\t\t\t\t\treturn rel + \" (its executable bit differs)\"\n  1969\t\t\t\t}\n  1970\t\t\t}\n  1971\t\t}\n  1972\t\treturn \"\"\n  1973\t}\n","exit_code":0,"status":"completed"}}
