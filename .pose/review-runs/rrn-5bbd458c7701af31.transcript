{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_shim_linux.go | sed -n '1,250p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"os/signal\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"golang.org/x/sys/unix\"\n    18\t)\n    19\t\n    20\t// RunReviewShim runs args (the adapter's path, then its argv) as the shim's\n    21\t// only child, waits for it or for SIGTERM, ends every process left in the\n    22\t// shim's subtree and returns the adapter's exit status.\n    23\tfunc RunReviewShim(args []string) int {\n    24\t\treport := reviewShimReport{}\n    25\t\tvar reportFile *os.File\n    26\t\tparent := 0\n    27\t\tif value := os.Getenv(ReviewShimReportEnv); value != \"\" {\n    28\t\t\tparent, _ = strconv.Atoi(value)\n    29\t\t\t// The report pipe is the shim's alone: the adapter never inherits it.\n    30\t\t\tsyscall.CloseOnExec(3)\n    31\t\t\treportFile = os.NewFile(3, \"pose-review-shim-report\")\n    32\t\t}\n    33\t\t_ = os.Unsetenv(ReviewShimReportEnv)\n    34\t\twrite := func() {\n    35\t\t\tif reportFile == nil {\n    36\t\t\t\treturn\n    37\t\t\t}\n    38\t\t\traw, _ := json.Marshal(report)\n    39\t\t\t_, _ = reportFile.Write(raw)\n    40\t\t\t_ = reportFile.Close()\n    41\t\t}\n    42\t\tif len(args) < 2 {\n    43\t\t\treport.Error = \"the review shim was given no adapter\"\n    44\t\t\twrite()\n    45\t\t\treturn 125\n    46\t\t}\n    47\t\tstop := make(chan os.Signal, 1)\n    48\t\tsignal.Notify(stop, syscall.SIGTERM)\n    49\t\t// The dispatcher's death stops the shim the same way as a timeout.\n    50\t\tif err := unix.Prctl(unix.PR_SET_PDEATHSIG, uintptr(syscall.SIGTERM), 0, 0, 0); err != nil {\n    51\t\t\treport.Error = \"the shim could not follow its dispatcher: \" + err.Error()\n    52\t\t\twrite()\n    53\t\t\treturn 125\n    54\t\t}\n    55\t\tif parent != 0 && os.Getppid() != parent {\n    56\t\t\treport.Error = \"the dispatcher ended before the shim started\"\n    57\t\t\twrite()\n    58\t\t\treturn 125\n    59\t\t}\n    60\t\tif err := unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0); err != nil {\n    61\t\t\treport.Error = \"the shim could not become the subreaper of the run: \" + err.Error()\n    62\t\t\twrite()\n    63\t\t\treturn 125\n    64\t\t}\n    65\t\tcmd := &exec.Cmd{Path: args[0], Args: args[1:], Stdin: os.Stdin, Stdout: os.Stdout, Stderr: os.Stderr, Env: os.Environ()}\n    66\t\tif err := cmd.Start(); err != nil {\n    67\t\t\treport.Error = \"the adapter could not run: \" + err.Error()\n    68\t\t\twrite()\n    69\t\t\treturn 127\n    70\t\t}\n    71\t\tdone := make(chan error, 1)\n    72\t\tgo func() { done <- cmd.Wait() }()\n    73\t\tcode, stopped := 0, false\n    74\t\tvar signaled syscall.Signal\n    75\t\tselect {\n    76\t\tcase err := <-done:\n    77\t\t\tvar exit *exec.ExitError\n    78\t\t\tif errors.As(err, &exit) {\n    79\t\t\t\tif status, ok := exit.Sys().(syscall.WaitStatus); ok && status.Signaled() {\n    80\t\t\t\t\tsignaled, code = status.Signal(), 128+int(status.Signal())\n    81\t\t\t\t} else {\n    82\t\t\t\t\tcode = exit.ExitCode()\n    83\t\t\t\t}\n    84\t\t\t} else if err != nil {\n    85\t\t\t\treport.Error = \"the adapter's end could not be read: \" + err.Error()\n    86\t\t\t}\n    87\t\tcase <-stop:\n    88\t\t\tstopped, code = true, 128+int(syscall.SIGTERM)\n    89\t\t}\n    90\t\tended, err := reapShimSubtree()\n    91\t\treport.Ended = ended\n    92\t\tif err != nil && report.Error == \"\" {\n    93\t\t\treport.Error = err.Error()\n    94\t\t}\n    95\t\twrite()\n    96\t\tif stopped {\n    97\t\t\treturn code\n    98\t\t}\n    99\t\t// An adapter ended by a signal is reported as ended by it: the shim ends\n   100\t\t// itself the same way, so the dispatcher reads what it would have read\n   101\t\t// without the shim.\n   102\t\tif signaled != 0 {\n   103\t\t\tsignal.Reset(signaled)\n   104\t\t\t_ = syscall.Kill(os.Getpid(), signaled)\n   105\t\t\ttime.Sleep(time.Second)\n   106\t\t}\n   107\t\treturn code\n   108\t}\n   109\t\n   110\t// stopReviewShim asks a running shim to end its subtree and exit.\n   111\tfunc stopReviewShim(cmd *exec.Cmd) func() error {\n   112\t\treturn func() error { return cmd.Process.Signal(syscall.SIGTERM) }\n   113\t}\n   114\t\n   115\t// reapShimSubtree ends and reaps every child of the shim, including the\n   116\t// orphans its subreaper status adopted, until none is left.\n   117\tfunc reapShimSubtree() ([]string, error) {\n   118\t\tself := os.Getpid()\n   119\t\tvar ended []string\n   120\t\tseen := map[int]bool{}\n   121\t\tdeadline := time.Now().Add(reviewReapWait)\n   122\t\tfor {\n   123\t\t\tdirs, err := os.ReadDir(\"/proc\")\n   124\t\t\tif err != nil {\n   125\t\t\t\treturn ended, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n   126\t\t\t}\n   127\t\t\tchildren := 0\n   128\t\t\tfor _, d := range dirs {\n   129\t\t\t\tpid, err := strconv.Atoi(d.Name())\n   130\t\t\t\tif err != nil || pid == self {\n   131\t\t\t\t\tcontinue\n   132\t\t\t\t}\n   133\t\t\t\tst, err := readShimProcStat(pid)\n   134\t\t\t\tif reviewProcessGoneErr(err) {\n   135\t\t\t\t\tcontinue\n   136\t\t\t\t}\n   137\t\t\t\tif err != nil {\n   138\t\t\t\t\treturn ended, fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   139\t\t\t\t}\n   140\t\t\t\tif st.ppid != self {\n   141\t\t\t\t\tcontinue\n   142\t\t\t\t}\n   143\t\t\t\tchildren++\n   144\t\t\t\tif !st.zombie {\n   145\t\t\t\t\tif !seen[pid] {\n   146\t\t\t\t\t\tseen[pid] = true\n   147\t\t\t\t\t\tended = append(ended, strconv.Itoa(pid))\n   148\t\t\t\t\t}\n   149\t\t\t\t\tif err := killPinnedChild(pid, self); err != nil {\n   150\t\t\t\t\t\treturn ended, err\n   151\t\t\t\t\t}\n   152\t\t\t\t}\n   153\t\t\t}\n   154\t\t\tfor {\n   155\t\t\t\tpid, err := unix.Wait4(-1, nil, unix.WNOHANG, nil)\n   156\t\t\t\tif pid <= 0 || err != nil {\n   157\t\t\t\t\tbreak\n   158\t\t\t\t}\n   159\t\t\t}\n   160\t\t\tif children == 0 {\n   161\t\t\t\treturn ended, nil\n   162\t\t\t}\n   163\t\t\tif time.Now().After(deadline) {\n   164\t\t\t\treturn ended, fmt.Errorf(\"%d process(es) of the run could not be ended\", children)\n   165\t\t\t}\n   166\t\t\ttime.Sleep(20 * time.Millisecond)\n   167\t\t}\n   168\t}\n   169\t\n   170\ttype shimProcStat struct {\n   171\t\tppid   int\n   172\t\tzombie bool\n   173\t}\n   174\t\n   175\tfunc readShimProcStat(pid int) (shimProcStat, error) {\n   176\t\traw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n   177\t\tif err != nil {\n   178\t\t\treturn shimProcStat{}, err\n   179\t\t}\n   180\t\ttext := string(raw)\n   181\t\tend := strings.LastIndexByte(text, ')')\n   182\t\tif end < 0 {\n   183\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   184\t\t}\n   185\t\tf := strings.Fields(text[end+1:])\n   186\t\tif len(f) < 2 {\n   187\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   188\t\t}\n   189\t\tppid, err := strconv.Atoi(f[1])\n   190\t\tif err != nil {\n   191\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   192\t\t}\n   193\t\treturn shimProcStat{ppid: ppid, zombie: f[0] == \"Z\"}, nil\n   194\t}\n   195\t\n   196\t// killPinnedChild signals pid through a pidfd while it is still a child of\n   197\t// parent: a pid reused by an unrelated process is never signalled.\n   198\tfunc killPinnedChild(pid, parent int) error {\n   199\t\tfd, err := unix.PidfdOpen(pid, 0)\n   200\t\tif errors.Is(err, unix.ESRCH) {\n   201\t\t\treturn nil\n   202\t\t}\n   203\t\tif err != nil {\n   204\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   205\t\t}\n   206\t\tdefer unix.Close(fd)\n   207\t\tst, err := readShimProcStat(pid)\n   208\t\tif reviewProcessGoneErr(err) || err == nil && st.ppid != parent {\n   209\t\t\treturn nil\n   210\t\t}\n   211\t\tif err != nil {\n   212\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   213\t\t}\n   214\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   215\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   216\t\t}\n   217\t\treturn nil\n   218\t}\n   219\t\n   220\t// parseReviewShimReport reads the report the shim wrote to its pipe.\n   221\tfunc parseReviewShimReport(raw []byte) (reviewShimReport, error) {\n   222\t\tvar r reviewShimReport\n   223\t\tif len(raw) == 0 {\n   224\t\t\treturn r, fmt.Errorf(\"the review shim left no report\")\n   225\t\t}\n   226\t\tif err := json.Unmarshal(raw, &r); err != nil {\n   227\t\t\treturn r, fmt.Errorf(\"the review shim report is unreadable: %w\", err)\n   228\t\t}\n   229\t\treturn r, nil\n   230\t}\n","exit_code":0,"status":"completed"}}
