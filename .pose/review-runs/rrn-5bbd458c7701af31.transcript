)\n  1103\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"resume\", run, err, delegateRunNextActions(store, run, err)...)\n  1104\t\tif err == nil && !f.jsonOut {\n  1105\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n  1106\t\t\t\treturn next\n  1107\t\t\t}\n  1108\t\t}\n  1109\t\treturn code\n  1110\t}\n  1111\t\n  1112\tfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n  1113\t\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n  1114\t\tif problem != \"\" {\n  1115\t\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n  1116\t\t}\n  1117\t\tstore := posemodel.Store{Root: root}\n  1118\t\tattempts, lost, err := store.ListDelegationAttempts()\n  1119\t\tif err != nil {\n  1120\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1121\t\t}\n  1122\t\tattempt, code, err := namedAttempt(attempts, f)\n  1123\t\tif err != nil {\n  1124\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n  1125\t\t}\n  1126\t\tif !attempt.Active && !f.dryRun {\n  1127\t\t\t// An attempt whose dispatch, or whose earlier release, ended before\n  1128\t\t\t// its receipt is released with a failed run and its receipt, so it\n  1129\t\t\t// stops blocking the bundle; the release proves the abandonment\n  1130\t\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n  1131\t\t\t// review round 4, N1).\n  1132\t\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n  1133\t\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n  1134\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1135\t\t\t}\n  1136\t\t\tif err != nil {\n  1137\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1138\t\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1139\t\t\t}\n  1140\t\t\tif f.jsonOut {\n  1141\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n  1142\t\t\t\treturn 0\n  1143\t\t\t}\n  1144\t\t\tout := render(stdout, stderr)\n  1145\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1146\t\t\tif run.RunID == \"\" {\n  1147\t\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n  1148\t\t\t} else {\n  1149\t\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n  1150\t\t\t}\n  1151\t\t\treturn 0\n  1152\t\t}\n  1153\t\tif !attempt.Active {\n  1154\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1155\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1156\t\t}\n  1157\t\tif f.dryRun {\n  1158\t\t\tif f.jsonOut {\n  1159\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": false, \"dry_run\": true, \"owner\": attempt.Liveness})\n  1160\t\t\t\treturn 0\n  1161\t\t\t}\n  1162\t\t\tout := render(stdout, stderr)\n  1163\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1164\t\t\tout.Field(\"delegate.owner\", attempt.Liveness)\n  1165\t\t\tout.Field(\"delegate.dry_run\", tr(\"true (no cancellation requested)\", \"true (nenhum cancelamento pedido)\"))\n  1166\t\t\treturn 0\n  1167\t\t}\n  1168\t\tmarker, err := store.RequestDelegationCancel(attempt.AttemptID)\n  1169\t\tif err != nil {\n  1170\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1171\t\t}\n  1172\t\tdeadline := time.Now().Add(60 * time.Second)\n  1173\t\tfor store.DelegationRunActive(marker) && time.Now().Before(deadline) {\n  1174\t\t\ttime.Sleep(200 * time.Millisecond)\n  1175\t\t}\n   690\t\t\t}\n   691\t\t}()\n   692\t\ttranscript := []byte{}\n   693\t\tfinish := func(status, failure string) (ReviewRun, error) {\n   694\t\t\tdoCleanup()\n   695\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n   696\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n   697\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n   698\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n   699\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n   700\t\t\t}\n   701\t\t\trun.sessionForRedaction = \"\"\n   702\t\t\trun.Status, run.Failure = status, failure\n   703\t\t\tif status != ReviewRunInterrupted {\n   704\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n   705\t\t\t}\n   706\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n   707\t\t\treturn s.recordReviewRun(run, transcript)\n   708\t\t}\n   709\t\t// Recompute semantic freshness at execution time, not just preview time.\n   710\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n   711\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   712\t\t}\n   713\t\tvar attempt DelegatedReviewAttempt\n   714\t\tif plan.predecessor == nil {\n   715\t\t\tvar err error\n   716\t\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n   717\t\t\tif err != nil {\n   718\t\t\t\treturn ReviewRun{}, err\n   719\t\t\t}\n   720\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n   721\t\t} else {\n   722\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n   723\t\t\tfresh, err := s.replanContinuation(plan)\n   724\t\t\tif err != nil {\n   725\t\t\t\treturn ReviewRun{}, err\n   726\t\t\t}\n   727\t\t\tif fresh.PendingContinuation != nil {\n   728\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n   729\t\t\t}\n   730\t\t\tif fresh.Existing != nil {\n   731\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   732\t\t\t}\n   733\t\t\tplan = fresh\n   734\t\t\trun.Provenance = fresh.provenance\n   735\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n   736\t\t\tif fresh.handoff {\n   737\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n   738\t\t\t} else {\n   739\t\t\t\trun.Resumes = fresh.predecessor.RunID\n   740\t\t\t}\n   741\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n   742\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n   743\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n   744\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n   745\t\t\t\treturn ReviewRun{}, err\n   746\t\t\t}\n   747\t\t}\n   748\t\t// The attempt result is published once: before the active marker goes\n   749\t\t// when the run was marked, at return otherwise (spec\n   750\t\t// pose-delegation-result-before-marker R1–R2).\n   751\t\tresultPublished := false\n   752\t\treserved := plan.predecessor != nil\n   753\t\tpublishResult := func() {\n   754\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n   755\t\t\t\treturn\n   756\t\t\t}\n   757\t\t\tresultPublished = true\n   758\t\t\tbeforeRunResultPublished(result)\n   759\t\t\tvar err error\n   760\t\t\tif plan.predecessor == nil {\n   761\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   762\t\t\t} else {\n   763\t\t\t\terr = s.finishReviewContinuation(result)\n   764\t\t\t}\n   765\t\t\tif err != nil {\n   766\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n   767\t\t\t}\n   768\t\t}\n   769\t\tdefer publishResult()\n   770\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n   771\t\tif err != nil {\n   772\t\t\tif plan.predecessor == nil {\n   773\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n   774\t\t\t\t// receipt are recorded against it, as before the marker moved\n   775\t\t\t\t// ahead of the reservation (spec\n   776\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n   777\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n   778\t\t\t\t\treturn ReviewRun{}, perr\n   779\t\t\t\t}\n   780\t\t\t\treserved = true\n   781\t\t\t}\n   782\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   783\t\t}\n   784\t\tif plan.predecessor == nil {\n   785\t\t\tbeforeAttemptPublished(s, attempt)\n   786\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n   787\t\t\t\tstopActive()\n   788\t\t\t\treturn ReviewRun{}, err\n   789\t\t\t}\n   790\t\t\treserved = true\n   791\t\t}\n   792\t\t// The marker goes only once the record and the attempt result are\n   793\t\t// published: without them it is the one trace of the reserved attempt,\n   794\t\t// and a waiter that sees it gone must find the receipt.\n   795\t\tdefer func() {\n   796\t\t\tpublishResult()\n   797\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n   798\t\t}()\n   799\t\tcancelled = cancelFlag\n   800\t\t// A detached run that cannot hand its attempt back stops here: nobody\n   801\t\t// would know which attempt runs (R1).\n   802\t\tif plan.OnStart != nil {\n   803\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n   804\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n   805\t\t\t}\n   806\t\t}\n   807\t\ttmp, err := os.MkdirTemp(\"\", \"pose-review-run-*\")\n   808\t\tif err != nil {\n   809\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n   810\t\t}\n   811\t\tsafety.RuntimeID = filepath.Base(tmp)\n   812\t\towned, err := os.Lstat(tmp)\n   813\t\tif err != nil {\n   814\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n   815\t\t}\n   816\t\truntimeRoot, err := os.OpenRoot(tmp)\n   817\t\tif err != nil {\n   818\t\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n   819\t\t}\n   820\t\tdefer runtimeRoot.Close()\n   821\t\tvar worktreeOwned os.FileInfo\n   822\t\tvar gitMarker []byte\n   823\t\tvar ownership *reviewCleanupOwnership\n   824\t\tworktree := filepath.Join(tmp, \"worktree\")\n   825\t\tcleanup = func() error {\n   826\t\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n   827\t\t}\n   828\t\thooks := filepath.Join(tmp, \"empty-hooks\")\n   829\t\tif err := os.Mkdir(hooks, 0700); err != nil {\n   830\t\t\treturn finish(ReviewRunFailed, \"private hook directory setup failed\")\n   831\t\t}\n   832\t\tsetupCtx, stopSetup := context.WithTimeout(parent, 2*time.Minute)\n   833\t\tdefer stopSetup()\n   834\t\tsetup := reviewSetupCommand(setupCtx, gitCommand(\"-C\", s.Root, \"-c\", \"core.hooksPath=\"+hooks, \"worktree\", \"add\", \"--detach\", worktree, plan.SealedCommit))\n   835\t\tsetupOutput := &reviewBoundedCapture{limit: 64 << 10, cancel: stopSetup}\n   836\t\tsetup.Stdout, setup.Stderr = setupOutput, setupOutput\n   837\t\tsetupErr := setup.Run()\n   838\t\t_, setupOverflow := setupOutput.result()\n   839\t\tterminationErr := killProcessGroup(setup)\n   840\t\tif terminationErr != nil {\n   841\t\t\tterminationFailed = true\n   842\t\t}\n   843\t\tsetupCause := executionCause(setupCtx)\n   844\t\tif setupErr != nil || terminationErr != nil || setupOverflow {\n   845\t\t\tsafety.ExecutionCause = setupCause\n   846\t\t\tif setupOverflow {\n   847\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   848\t\t\t}\n   849\t\t\treturn finish(ReviewRunFailed, \"review worktree setup failed or termination incomplete\")\n   850\t\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'Runs that leave work behind|Lingering review processes|POSE_SEALED_CHECKOUT|POSE_REVIEW_SHIM|review-brief/10' POSE.md locales/pt-BR/POSE.md pose-mcp/internal/scaffold/dist/POSE.md pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md pose-mcp/internal/pose/review_brief.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'Runs that leave work behind|Lingering review processes|POSE_SEALED_CHECKOUT|POSE_REVIEW_SHIM|review-brief/10' POSE.md locales/pt-BR/POSE.md pose-mcp/internal/scaffold/dist/POSE.md pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md pose-mcp/internal/pose/review_brief.go\"","aggregated_output":"pose-mcp/internal/pose/review_brief.go:81:\treviewBriefTemplateFinishCommands = \"review-brief/10\"\nPOSE.md:423:- `assess discover|integrate|tech-debt|stale|request|snapshot` — native assessment engines for LOC, technical debt markers, component structures, inter-module contract integrity checks, and capability mechanism reassessment lifecycle. `discover`, `integrate` and `tech-debt` take `--no-persist` to print their result without writing `.pose/assessments/` or `.pose/state/`; in the sealed checkout of a delegated review (`POSE_SEALED_CHECKOUT`) they never persist, `init`, `snapshot` and `request` refuse, and the review plan runs them with `--no-persist`, so a reviewer running a planned assessment does not fail its own run.\nPOSE.md:1074:**Conclusions of delegated reviews.** `pose review conclude <run> [--issuer <name>] [--apply] [--json]` records the conclusion of a completed review run: the run's final message carries its typed conclusion in the pose-draft block — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>`, `rationale`, and `mappings` where the plan asks for structural mappings) and `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), the brief of template `review-brief/10` (the text a template version renders is frozen by a golden digest, so a change to it takes a new version) asks for them and states the rules the engine checks before it records one (a judgment criterion passed carries a rationale, its evidence is a ref the bundle sealed, a finding criterion names a finding of the draft, structural facts are answered as `mappings`; a draft that breaks one is refused whole; a round after the first also names the findings it accounts for by the identifiers the brief lists, with their round, never a bare F1) — and the engine signs the run's proof and the attestation with the native issuer, `--issuer` or `conclusions.issuer` in `.pose/policy/delegation.json` (the key stays outside the project), and records it through the same domain writer and preflight as `pose review attest --run --run-proof --sign`. A follow-up finding with `action`, `owner` and `review_by` becomes an accepted risk when its severity is one the sealed review policy accepts (low by default); any other finding stays open. A rejecting conclusion is recorded too and blocks the scope until the bundle changes. A run that is not a completed review, is superseded, captured no provenance, has an incomplete cleanup or record, carries no valid draft for its round, or whose bundle no longer governs, records no attestation: its conclusion record, in the `review-conclusions` directory of `.pose`, keeps the reasons. A run concludes once: a lock the system releases when the process ends is held from the first read to the last write, concluding it again returns its record, and a reservation an interrupted conclusion left is completed from the attestation it recorded only if that attestation verifies as the run's conclusion, otherwise the run is concluded in its place. Whoever signs it, an attestation of a run briefed with `review-brief/3` to `/10` states that run's conclusion: criteria, tools or findings its draft did not declare are refused. With review policy `delegated_review: true` and `conclusions.issuer` set, `pose delegate review` records the conclusion the moment the run completes; otherwise nothing is automatic. An adjudication or a smoke run concludes the same way, under the same checks, lock and refusals, and never as an approval. The brief of template `adjudication-brief/2` lists the questions the scope's spec records — each decision `D<n>` and requirement `R<n>` — and the pose-draft block answers each in `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); the verdict is recorded as an adjudication record of the spec in the `adjudications` directory of `.pose`, and `lint-spec` fails, and `close` refuses, on a question the current bundle's adjudication says does not hold and warns on one it cannot determine or on a record that does not verify. The brief of template `smoke-brief/2` asks for `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), one per delivery target; the observations are recorded as validation results of evidence class `smoke`, one required check per target that passes when it was observed and is evidence of that target of that spec only, its head, time and provenance taken from the run and the current index, in the `results/smoke` directory of `.pose`, which `surface-check` reads beside the results path, so a delivery profile may demand `smoke`. A verdict that does not answer exactly what its brief asked records nothing; every record is verified on read — its run's proof verifies and it is what the run's draft concludes — and one that does not yields nothing. Runs briefed with `adjudication-brief/1` and `smoke-brief/1` keep verifying with their template.\nPOSE.md:1078:**Runs that leave work behind.** On Linux, after the adapter exits, the dispatch also ends every process whose environment names the run's sealed checkout (`POSE_SEALED_CHECKOUT`), which catches commands a reviewer started in a session of its own, and it runs the adapter under a review run shim, the same executable re-entered, which is the subreaper of the run's subtree and ends whatever the run leaves in it, even a process that started its own session and cleared its environment; the shim also does so on a timeout and when its dispatcher ends, and reports through a pipe the reviewer does not inherit; each is pinned by a pidfd and checked again before it is signalled. It waits for them and lists them in the run's `safety.limitations` before the cleanup inventory, and discloses there the processes of the same user that predate the run and whose environment could not be read (one started during the run that cannot be read fails the cleanup); on other platforms only the process group is ended; the brief of template `review-brief/10` asks the reviewer to let its commands finish. The dispatch marks an attempt active before it publishes its reservation, so a dispatch that ends before recording its run always leaves a stalled attempt, which `pose delegate ls` lists with its cause, and `pose delegate cancel <attempt>` releases it once its owner is proven gone, recording a failed run and its receipt; one release runs at a time, under a lock the system releases with its holder, and a release completes with any run the attempt already recorded instead of writing another. A reservation an earlier engine left without a marker records no owner: `pose delegate ls` lists it once it is ten minutes old, and `pose delegate cancel <attempt> --confirm-abandoned` releases it on the operator's confirmation that no dispatch of it runs.\npose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md:427:- `assess discover|integrate|tech-debt|stale|request|snapshot` — motores nativos de assessment para LOC, marcadores de débito técnico, estruturas de componentes, checagens de integridade de contrato entre módulos e ciclo de vida de reavaliação de capabilities. `discover`, `integrate` e `tech-debt` aceitam `--no-persist` para imprimir o resultado sem gravar `.pose/assessments/` nem `.pose/state/`; no checkout selado de uma review delegada (`POSE_SEALED_CHECKOUT`) eles nunca gravam, `init`, `snapshot` e `request` recusam, e o plano de review os roda com `--no-persist`, para que um revisor que roda um assessment planejado não derrube o próprio run.\npose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md:1071:**Conclusões de reviews delegadas.** `pose review conclude <run> [--issuer <nome>] [--apply] [--json]` registra a conclusão de um run de review concluído: a mensagem final do run traz a conclusão tipada no bloco pose-draft — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` como `<classe>:<ref>`, `rationale` e, quando o plano pede mapeamentos estruturais, `mappings`) e `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), que o brief do template `review-brief/10` (o texto que uma versão de template renderiza é congelado por um digest de referência, então mudá-lo exige uma nova versão) pede e para o qual declara as regras que o motor confere antes de registrar (um critério de julgamento aprovado traz uma justificativa, sua evidência é uma ref que o bundle selou, um critério com finding nomeia um finding do draft, fatos estruturais são respondidos como `mappings`; um draft que quebra uma delas é recusado inteiro; uma rodada depois da primeira também nomeia os findings pelos quais responde com os identificadores que o brief lista, com a rodada, nunca um F1 solto) — e o motor assina a prova do run e a atestação com o issuer nativo, `--issuer` ou `conclusions.issuer` em `.pose/policy/delegation.json` (a chave fica fora do projeto), e a registra pelo mesmo writer de domínio e preflight de `pose review attest --run --run-proof --sign`. Um finding de follow-up com `action`, `owner` e `review_by` vira um risco aceito quando sua severidade é uma que a política de review selada aceita (low por padrão); qualquer outro finding fica aberto. Uma conclusão que rejeita também é registrada e bloqueia o escopo até o bundle mudar. Um run que não é uma review concluída, foi substituído, não capturou proveniência, tem limpeza ou registro incompletos, não traz draft válido para sua rodada, ou cujo bundle não governa mais, não registra atestação: seu registro de conclusão, no diretório `review-conclusions` de `.pose`, guarda os motivos. Um run conclui uma vez: um lock que o sistema libera quando o processo termina é mantido da primeira leitura à última escrita, concluí-lo de novo devolve seu registro, e uma reserva deixada por uma conclusão interrompida só é completada pela atestação que ela registrou se essa atestação verificar como a conclusão do run; caso contrário o run é concluído no lugar dela. Quem quer que a assine, uma atestação de um run com brief `review-brief/3` a `/10` declara a conclusão daquele run: critérios, ferramentas ou findings que o draft não declarou são recusados. Com `delegated_review: true` na policy de review e `conclusions.issuer` definido, `pose delegate review` registra a conclusão no momento em que o run termina; caso contrário nada é automático. Um run de adjudicação ou de smoke conclui do mesmo jeito, sob os mesmos checks, lock e recusas, e nunca como aprovação. O brief do template `adjudication-brief/2` lista as questões que a spec do escopo registra — cada decisão `D<n>` e requisito `R<n>` — e o bloco pose-draft responde cada uma em `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); o veredito é registrado como registro de adjudicação da spec no diretório `adjudications` de `.pose`, e o `lint-spec` reprova, e o `close` recusa, uma questão que a adjudicação do bundle atual diz não se sustentar e avisa sobre uma que ela não pôde determinar ou sobre um registro que não verifica. O brief do template `smoke-brief/2` pede `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), uma por delivery target; as observações são registradas como resultados de validação da classe de evidência `smoke`, um check obrigatório por alvo que passa quando foi observado e é evidência só daquele alvo daquela spec, com head, data e proveniência tirados do run e do índice atual, no diretório `results/smoke` de `.pose`, que o `surface-check` lê ao lado do results path, de modo que um delivery profile pode exigir `smoke`. Um veredito que não responde exatamente o que seu brief pediu não registra nada; todo registro é verificado na leitura — a prova do run verifica e ele é o que o draft do run conclui — e um que não verifica não produz nada. Runs com brief `adjudication-brief/1` e `smoke-brief/1` continuam verificando com o próprio template.\npose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md:1075:**Runs que deixam trabalho para trás.** No Linux, depois que o adaptador termina, o envio também encerra todo processo cujo ambiente nomeia o checkout selado do run (`POSE_SEALED_CHECKOUT`), o que pega comandos que o revisor iniciou em sessão própria e roda o adaptador sob um shim de run de review, o mesmo executável reentrado, que é o subreaper da subárvore do run e encerra o que o run deixa nela, mesmo um processo que abriu sessão própria e limpou o ambiente; o shim faz o mesmo num timeout e quando o envio termina, e relata por um pipe que o revisor não herda; cada um é fixado por um pidfd e conferido de novo antes do sinal. Ele espera que terminem e os lista em `safety.limitations` do run antes do inventário de limpeza, declarando ali os processos do mesmo usuário anteriores ao run cujo ambiente não pôde ser lido (um iniciado durante o run que não pode ser lido derruba a limpeza); nas outras plataformas só o grupo de processos é encerrado; o brief do template `review-brief/10` pede ao revisor que deixe seus comandos terminarem. O envio marca a tentativa como ativa antes de publicar a reserva, então um envio que termina antes de registrar o run sempre deixa uma tentativa parada, que `pose delegate ls` lista com a causa, e `pose delegate cancel <tentativa>` a libera quando o dono está comprovadamente encerrado, registrando um run com falha e o seu recibo; uma liberação roda por vez, sob um lock que o sistema libera junto com quem o detém, e uma liberação conclui com qualquer run que a tentativa já registrou em vez de gravar outro. Uma reserva que um motor anterior deixou sem marcador não registra dono: `pose delegate ls` a lista depois de dez minutos, e `pose delegate cancel <tentativa> --confirm-abandoned` a libera com a confirmação do operador de que nenhum envio dela está rodando.\npose-mcp/internal/scaffold/dist/POSE.md:423:- `assess discover|integrate|tech-debt|stale|request|snapshot` — native assessment engines for LOC, technical debt markers, component structures, inter-module contract integrity checks, and capability mechanism reassessment lifecycle. `discover`, `integrate` and `tech-debt` take `--no-persist` to print their result without writing `.pose/assessments/` or `.pose/state/`; in the sealed checkout of a delegated review (`POSE_SEALED_CHECKOUT`) they never persist, `init`, `snapshot` and `request` refuse, and the review plan runs them with `--no-persist`, so a reviewer running a planned assessment does not fail its own run.\npose-mcp/internal/scaffold/dist/POSE.md:1061:**Conclusions of delegated reviews.** `pose review conclude <run> [--issuer <name>] [--apply] [--json]` records the conclusion of a completed review run: the run's final message carries its typed conclusion in the pose-draft block — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>`, `rationale`, and `mappings` where the plan asks for structural mappings) and `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), the brief of template `review-brief/10` (the text a template version renders is frozen by a golden digest, so a change to it takes a new version) asks for them and states the rules the engine checks before it records one (a judgment criterion passed carries a rationale, its evidence is a ref the bundle sealed, a finding criterion names a finding of the draft, structural facts are answered as `mappings`; a draft that breaks one is refused whole; a round after the first also names the findings it accounts for by the identifiers the brief lists, with their round, never a bare F1) — and the engine sign