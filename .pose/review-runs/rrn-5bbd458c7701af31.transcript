iewShimReport(shimReport); err != nil {\n  1095\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1096\t\t\t} else {\n  1097\t\t\t\tfor _, pid := range report.Ended {\n  1098\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1099\t\t\t\t}\n  1100\t\t\t\tif report.Error != \"\" {\n  1101\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1102\t\t\t\t}\n  1103\t\t\t}\n  1104\t\t}\n  1105\t\tif len(reaped) > 0 && safety != nil {\n  1106\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n  1107\t\t}\n  1108\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1109\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1110\t\t}\n  1111\t\tterminationFailed = terminationErr != nil\n  1112\t\t// The adapter exited and a child it left still held the output when\n  1113\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1114\t\t// the exit status decides (found in review).\n  1115\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1116\t\t\trunErr = nil\n  1117\t\t}\n  1118\t\ttranscript, overflow := combined.result()\n  1119\t\tsafety.CaptureComplete = !overflow\n  1120\t\tif cmd.ProcessState != nil {\n     1\t//go:build !windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"context\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"runtime\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"sync\"\n    15\t\t\"syscall\"\n    16\t\t\"time\"\n    17\t)\n    18\t\n    19\t// isolateProcessGroup starts the adapter in its own process group, and makes\n    20\t// the context's cancellation kill that whole group.\n    21\tfunc isolateProcessGroup(cmd *exec.Cmd) {\n    22\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n    23\t\tcmd.Cancel = func() error {\n    24\t\t\treturn syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\n    25\t\t}\n    26\t}\n    27\t\n    28\t// killProcessGroup ends whatever the adapter left running.\n    29\tfunc killProcessGroup(cmd *exec.Cmd) error {\n    30\t\tif cmd.Process == nil {\n    31\t\t\treturn nil\n    32\t\t}\n    33\t\terr := syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\n    34\t\tif errors.Is(err, syscall.ESRCH) {\n    35\t\t\treturn nil\n    36\t\t}\n    37\t\tif err != nil {\n    38\t\t\treturn err\n    39\t\t}\n    40\t\treturn verifyReviewProcessGroup(cmd.Process.Pid)\n    41\t}\n    42\tfunc openReviewAdapterFile(path string) (*os.File, error) {\n    43\t\tfd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)\n    44\t\tif err != nil {\n    45\t\t\treturn nil, err\n    46\t\t}\n    47\t\treturn os.NewFile(uintptr(fd), path), nil\n    48\t}\n    49\tfunc reviewSetupCommand(ctx context.Context, source *exec.Cmd) *exec.Cmd {\n    50\t\tcmd := exec.CommandContext(ctx, source.Path, source.Args[1:]...)\n    51\t\tcmd.Env = source.Env\n    52\t\tisolateProcessGroup(cmd)\n    53\t\tcmd.WaitDelay = time.Second\n    54\t\treturn cmd\n    55\t}\n    56\t\n    57\t// Verify the covered Linux group after SIGKILL. Zombies have terminated and\n    58\t// cannot hold pipes; reaping is their parent's duty. Other Unix ports currently\n    59\t// report signal delivery only and cannot require verified group termination.\n    60\tfunc verifyReviewProcessGroup(pid int) error {\n    61\t\tif runtime.GOOS != \"linux\" {\n    62\t\t\treturn nil\n    63\t\t}\n    64\t\tdeadline := time.Now().Add(time.Second)\n    65\t\tfor {\n    66\t\t\tentries, err := os.ReadDir(\"/proc\")\n    67\t\t\tif err != nil {\n    68\t\t\t\treturn fmt.Errorf(\"process-group termination could not be observed\")\n    69\t\t\t}\n    70\t\t\tif len(entries) > 100000 {\n    71\t\t\t\treturn fmt.Errorf(\"process inventory exceeds coverage\")\n    72\t\t\t}\n    73\t\t\talive := false\n    74\t\t\tfor _, entry := range entries {\n    75\t\t\t\tif _, err := strconv.Atoi(entry.Name()); err != nil {\n    76\t\t\t\t\tcontinue\n    77\t\t\t\t}\n    78\t\t\t\traw, err := os.ReadFile(\"/proc/\" + entry.Name() + \"/stat\")\n    79\t\t\t\tif processGone(err) {\n    80\t\t\t\t\tcontinue\n    81\t\t\t\t}\n    82\t\t\t\tif err != nil {\n    83\t\t\t\t\treturn fmt.Errorf(\"process inventory incomplete\")\n    84\t\t\t\t}\n    85\t\t\t\tend := strings.LastIndex(string(raw), \")\")\n    86\t\t\t\tif end < 0 {\n    87\t\t\t\t\treturn fmt.Errorf(\"process inventory malformed\")\n    88\t\t\t\t}\n    89\t\t\t\tfields := strings.Fields(string(raw[end+1:]))\n    90\t\t\t\tif len(fields) < 3 {\n    91\t\t\t\t\treturn fmt.Errorf(\"process inventory malformed\")\n    92\t\t\t\t}\n    93\t\t\t\tgroup, err := strconv.Atoi(fields[2])\n    94\t\t\t\tif err != nil {\n    95\t\t\t\t\treturn fmt.Errorf(\"process group malformed\")\n    96\t\t\t\t}\n    97\t\t\t\tif group == pid && fields[0] != \"Z\" && fields[0] != \"X\" {\n    98\t\t\t\t\talive = true\n    99\t\t\t\t\tbreak\n   100\t\t\t\t}\n   101\t\t\t}\n   102\t\t\tif !alive {\n   103\t\t\t\treturn nil\n   104\t\t\t}\n   105\t\t\tif time.Now().After(deadline) {\n   106\t\t\t\treturn fmt.Errorf(\"process group remained alive after termination\")\n   107\t\t\t}\n   108\t\t\ttime.Sleep(10 * time.Millisecond)\n   109\t\t}\n   110\t}\n","exit_code":0,"status":"completed"}}
