{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'terminationFailed|terminationErr|shimReport' pose-mcp/internal/pose/review_dispatch.go\"","aggregated_output":"663:\tvar terminationFailed bool\n672:\t\tif terminationFailed {\n839:\tterminationErr := killProcessGroup(setup)\n840:\tif terminationErr != nil {\n841:\t\tterminationFailed = true\n844:\tif setupErr != nil || terminationErr != nil || setupOverflow {\n883:\t\tterminationFailed = gitlinks.terminationFailure\n1046:\tvar shimReport []byte\n1047:\tshimReportDone := make(chan struct{})\n1054:\t\t\tdefer close(shimReportDone)\n1055:\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n1058:\t\tclose(shimReportDone)\n1073:\t\t<-shimReportDone\n1076:\tterminationErr = killProcessGroup(cmd)\n1090:\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n1094:\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n1095:\t\t\tterminationErr = errors.Join(terminationErr, err)\n1101:\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n1111:\tterminationFailed = terminationErr != nil\n1164:\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n1173:\t\tif terminationErr != nil {\n","exit_code":0,"status":"completed"}}
