{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux_test.go | sed -n '130,235p' && rg -n 'OwnerPID|OwnerPid|Owner|ownerPID|Pid|PID|marker.*owner|LockOwnerDead|DelegationRunActive|markDelegationActive' pose-mcp/internal/pose/delegation_active.go pose-mcp/internal/pose/review_dispatch.go\"","aggregated_output":"   130\t}\n   131\t\n   132\t// waitGone waits for pid to end (or be a zombie) and reports whether it did.\n   133\tfunc waitGone(pid int, within time.Duration) bool {\n   134\t\tdeadline := time.Now().Add(within)\n   135\t\tfor time.Now().Before(deadline) {\n   136\t\t\tif zombie, err := reviewProcessZombie(pid); err != nil || zombie {\n   137\t\t\t\treturn true\n   138\t\t\t}\n   139\t\t\ttime.Sleep(50 * time.Millisecond)\n   140\t\t}\n   141\t\treturn false\n   142\t}\n   143\t\n   144\t// Review round 8, N2: the shim's report never goes through a path the\n   145\t// reviewer can write, and the reviewer does not inherit the report pipe.\n   146\tfunc TestTheAdapterDoesNotInheritTheShimReport(t *testing.T) {\n   147\t\tfds := filepath.Join(t.TempDir(), \"fds\")\n   148\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   149\t\t\ta.Containment = containmentPolicy()\n   150\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; ls /proc/$$/fd > \"$1\"; env | grep -c POSE_REVIEW_SHIM_REPORT >> \"$1\"; ls \"$TMPDIR\" >> \"$1\"; printf 'decision: approved\\n'`, \"sh\", fds}\n   151\t\t})\n   152\t\traw, err := os.ReadFile(fds)\n   153\t\tif err != nil || f.run.Status != ReviewRunCompleted {\n   154\t\t\tt.Fatalf(\"the probe did not run: %v %s %s\", err, f.run.Status, f.run.Failure)\n   155\t\t}\n   156\t\tlines := strings.Fields(string(raw))\n   157\t\tfor _, l := range lines {\n   158\t\t\tif l == \"3\" || strings.Contains(l, \"shim-report\") {\n   159\t\t\t\tt.Fatalf(\"the adapter sees the shim's report (%q): %s\", l, raw)\n   160\t\t\t}\n   161\t\t}\n   162\t}\n   163\t\n   164\t// Review round 8, N3: a timeout asks the shim to end the run's subtree, so an\n   165\t// orphan that cleared its environment does not outlive it.\n   166\tfunc TestATimeoutEndsTheRunsOrphans(t *testing.T) {\n   167\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   168\t\t\tt.Skip(\"setsid is not available\")\n   169\t\t}\n   170\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   171\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   172\t\t\ta.Containment = containmentPolicy()\n   173\t\t\ta.Timeout = \"2s\"\n   174\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & sleep 30`, \"sh\", pidFile}\n   175\t\t})\n   176\t\traw, err := os.ReadFile(pidFile)\n   177\t\tif err != nil {\n   178\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   179\t\t}\n   180\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   181\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   182\t\tif !waitGone(pid, 2*time.Second) {\n   183\t\t\tt.Fatal(\"an orphan outlived the run's timeout\")\n   184\t\t}\n   185\t}\n   186\t\n   187\t// Review round 8, N4: when the dispatcher ends, the shim ends the run's\n   188\t// subtree instead of leaving the reviewer running behind a dead owner.\n   189\tfunc TestTheShimEndsTheRunWhenItsDispatcherEnds(t *testing.T) {\n   190\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   191\t\t\tt.Skip(\"setsid is not available\")\n   192\t\t}\n   193\t\tself, err := os.Executable()\n   194\t\tif err != nil {\n   195\t\t\tt.Fatal(err)\n   196\t\t}\n   197\t\tdir := t.TempDir()\n   198\t\torphanPid, shimPid := filepath.Join(dir, \"orphan.pid\"), filepath.Join(dir, \"shim.pid\")\n   199\t\tadapter := filepath.Join(dir, \"adapter.sh\")\n   200\t\tif err := os.WriteFile(adapter, []byte(\"#!/bin/sh\\nsetsid env -i /bin/sh -c 'echo $$ > \\\"$1\\\"; while :; do sleep 0.05; done' sh \\\"$1\\\" </dev/null >/dev/null 2>&1 &\\nsleep 30\\n\"), 0o755); err != nil {\n   201\t\t\tt.Fatal(err)\n   202\t\t}\n   203\t\t// A stand-in dispatcher starts the shim and ends once the run is going.\n   204\t\tscript := `export ` + ReviewShimReportEnv + `=$$; \"$1\" ` + ReviewShimArg + ` /bin/sh sh \"$4\" \"$2\" & echo $! > \"$3\"; ` +\n   205\t\t\t`i=0; while [ ! -s \"$2\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; exit 0`\n   206\t\t// No output pipe: waiting for one would wait for the shim that inherits it.\n   207\t\tdispatcher := exec.Command(\"sh\", \"-c\", script, \"sh\", self, orphanPid, shimPid, adapter)\n   208\t\tstarted := time.Now()\n   209\t\tif err := dispatcher.Run(); err != nil {\n   210\t\t\tt.Fatalf(\"the stand-in dispatcher failed: %v\", err)\n   211\t\t}\n   212\t\tif time.Since(started) > 10*time.Second {\n   213\t\t\tt.Fatal(\"the stand-in dispatcher waited for the run\")\n   214\t\t}\n   215\t\traw, err := os.ReadFile(orphanPid)\n   216\t\tif err != nil {\n   217\t\t\tt.Fatalf(\"the run never started: %v\", err)\n   218\t\t}\n   219\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   220\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   221\t\tif !waitGone(pid, 5*time.Second) {\n   222\t\t\tt.Fatal(\"the run outlived its dispatcher\")\n   223\t\t}\n   224\t}\npose-mcp/internal/pose/review_dispatch.go:770:\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\npose-mcp/internal/pose/review_dispatch.go:823:\tvar ownership *reviewCleanupOwnership\npose-mcp/internal/pose/review_dispatch.go:860:\townership, err = s.captureReviewCleanupOwnership(runtimeRoot, worktree, gitMarker)\npose-mcp/internal/pose/delegation_active.go:45:\tOwner     StartLockOwner `json:\"owner\"`\npose-mcp/internal/pose/delegation_active.go:84:// markDelegationActive writes the marker and starts the cancellation watcher.\npose-mcp/internal/pose/delegation_active.go:91:func (s Store) markDelegationActive(run ReviewRun, cancel context.CancelFunc) (stop func(keepMarker ...bool), cancelled *atomic.Bool, err error) {\npose-mcp/internal/pose/delegation_active.go:100:\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + run.AttemptID, Worktree: s.Root, Operation: \"pose delegate \" + run.Purpose, PID: os.Getpid(), AcquiredAt: run.StartedAt}\npose-mcp/internal/pose/delegation_active.go:108:\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: run.AttemptID, RunToken: hex.EncodeToString(token), Resumes: run.Resumes, Label: run.Label, Purpose: run.Purpose, Agent: run.Adapter, Scope: run.Scope, BundleID: run.BundleID, StartedAt: run.StartedAt, Owner: owner, Round: run.Round,\npose-mcp/internal/pose/delegation_active.go:236:// ListDelegationActive reads the markers with the liveness of their owners,\npose-mcp/internal/pose/delegation_active.go:270:\t\tmarker.Liveness, marker.Detail = probeStartLockOwner(marker.Owner)\npose-mcp/internal/pose/delegation_active.go:272:\t\tif marker.StalledAt == \"\" && delegationMarkerSilent(marker, time.Now()) && marker.Liveness == LockOwnerDead {\npose-mcp/internal/pose/delegation_active.go:300:\t\tif marker.Liveness == LockOwnerDead {\npose-mcp/internal/pose/delegation_active.go:315:\t\tif !s.DelegationRunActive(marker) {\npose-mcp/internal/pose/delegation_active.go:325:// DelegationRunActive reports whether the run marker names is still the\npose-mcp/internal/pose/delegation_active.go:327:func (s Store) DelegationRunActive(marker DelegationActiveRun) bool {\n","exit_code":0,"status":"completed"}}
