{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2c7305cd94500009875ddc1b7880d8331 5111f0f175499644c6a2c6cc6c5af2f13f527989 -- pose-mcp/internal/pose/review_closeout.go pose-mcp/internal/pose/roadmaps.go pose-mcp/internal/pose/review_bundle.go pose-mcp/internal/pose/review_plan.go'","aggregated_output":"diff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex 355f8f37..3d4e761b 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -127,6 +127,11 @@ type ReviewBundlePlan struct {\n \t// would judge an immutable bundle by today's selection, which is the whole\n \t// thing sealing exists to prevent.\n \tSelectedProfiles []ReviewPlanProfile `json:\"selected_profiles,omitempty\"`\n+\t// CloseoutReview seals the closeout-review@1 decision an aggregate scope\n+\t// was reviewed under (spec pose-closeout-review-policy-by-cost-benefit).\n+\t// Nil on every bundle sealed before adoption, which is how such a bundle\n+\t// proves a closure from before the policy.\n+\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n \t// Structure seals the material structural facts the plan observed, so the\n \t// mapping obligation is fixed at seal time. Recomputing it at verification\n \t// would let a later detector improvement retroactively block an approved\n@@ -505,7 +510,7 @@ func (s Store) prepareReviewBundle(ref string, legacyMilestoneManifest bool) (Re\n \tif err != nil {\n \t\treturn ReviewBundle{}, err\n \t}\n-\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure}\n+\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview}\n \n \tscopeProjection, excluded, err := s.reviewBundleScopeProjection(scope)\n \tif err != nil {\n@@ -1196,7 +1201,7 @@ func reviewBundlePathClass(path string, scope ScopeRef, components []ReviewPlanC\n \t\t// like the repository's own LICENSE and NOTICE (found in review).\n \t\treturn \"documentation\", true\n \t}\n-\tfor _, prefix := range []string{\".pose/state/\", \".pose/assessments/\", \".pose/reports/\", \".pose/results/\", \".pose/reviews/\", \".pose/review-bundles/\", \".pose/review-attestations/\", \".pose/review-attribution-supplements/\", \".pose/closeout-plans/\", \".pose/contributions/\", \".pose/feedback/\", \".pose/review-runs/\", \".pose/review-attempts/\", \".pose/review-run-ledger/\", \".pose/review-continuations/\", \".pose/review-private/\", \".pose/review-run-proofs/\", \".pose/delegate-runs/\", \".pose/review-conclusions/\", \".pose/adjudications/\", \".pose/events/\", \".pose/investigations/\"} {\n+\tfor _, prefix := range []string{\".pose/state/\", \".pose/assessments/\", \".pose/reports/\", \".pose/results/\", \".pose/reviews/\", \".pose/review-bundles/\", \".pose/review-attestations/\", \".pose/review-attribution-supplements/\", \".pose/closeout-plans/\", \".pose/contributions/\", \".pose/feedback/\", \".pose/review-runs/\", \".pose/review-attempts/\", \".pose/review-run-ledger/\", \".pose/review-continuations/\", \".pose/review-private/\", \".pose/review-run-proofs/\", \".pose/delegate-runs/\", \".pose/review-conclusions/\", \".pose/review-closeouts/\", \".pose/adjudications/\", \".pose/events/\", \".pose/investigations/\"} {\n \t\tif strings.HasPrefix(path, prefix) {\n \t\t\treturn \"derived-evidence\", false\n \t\t}\n@@ -3456,17 +3461,43 @@ func (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerific\n \t\treturn own, err\n \t}\n \tref, parseErr := ParseScopeRef(scope)\n-\tif parseErr != nil || ref.Kind != \"milestone\" {\n+\tif parseErr != nil || (ref.Kind != \"milestone\" && ref.Kind != \"roadmap\") {\n \t\treturn own, nil\n \t}\n \t// A policy without bundles answers through its review attempts alone, and has no\n \t// bundle of the spec to stand on.\n-\tif policy, err := s.GetReviewPolicy(); err != nil || !policy.ReviewBundles {\n+\tpolicy, err := s.GetReviewPolicy()\n+\tif err != nil || !policy.ReviewBundles {\n \t\treturn own, nil\n \t}\n \tif s.milestoneReviewRefused(scope) {\n \t\treturn own, nil\n \t}\n+\t// An adopted closeout review policy is the only rule for an open scope:\n+\t// legacy inheritance and declared exemptions cannot weaken `always`, and\n+\t// the policy's own exemption reads the same gate as reviewCheck. A roadmap\n+\t// closed before adoption keeps the legacy reading below.\n+\tadopted := policy.CloseoutReviewAdopted() && !s.closeoutScopeHistorical(ref)\n+\tif adopted {\n+\t\tdecision, exempt, gateErr := s.closeoutReviewGate(scope, policy)\n+\t\tif gateErr != nil || decision == nil || !exempt || !decision.Known {\n+\t\t\treturn own, nil\n+\t\t}\n+\t\tif ref.Kind == \"milestone\" && s.FederatedResolver != nil {\n+\t\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n+\t\t\tif err != nil || !acceptance.Ready {\n+\t\t\t\treturn own, nil\n+\t\t\t}\n+\t\t}\n+\t\treturn ReviewBundleVerification{\n+\t\t\tScope: scope, State: \"closed\", Fresh: true, Approved: true, NextAction: \"none\",\n+\t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n+\t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n+\t\t}, nil\n+\t}\n+\tif ref.Kind != \"milestone\" {\n+\t\treturn own, nil\n+\t}\n \t// Edges still bind: a milestone inherits a review, not the acceptance of what it\n \t// depends on, and revoked trust or an open predecessor leaves it where it was.\n \tif s.FederatedResolver != nil {\ndiff --git a/pose-mcp/internal/pose/review_closeout.go b/pose-mcp/internal/pose/review_closeout.go\nindex 8c4bfe79..ec59c88a 100644\n--- a/pose-mcp/internal/pose/review_closeout.go\n+++ b/pose-mcp/internal/pose/review_closeout.go\n@@ -29,6 +29,13 @@ const QualifiedArtifactPolicySchemaVersion = 3\n // refused by older engines so they cannot silently operate on transfer state.\n const SpecAuthorityTransferPolicySchemaVersion = 4\n \n+// CloseoutReviewPolicySchemaVersion carries milestone_review_required and\n+// roadmap_review_required (spec pose-closeout-review-policy-by-cost-benefit).\n+// Older engines refuse it, so none of them reads an adopted exemption as the\n+// legacy rule. It decouples the schema number from qualified references and\n+// authority transfer: both stay optional under it.\n+const CloseoutReviewPolicySchemaVersion = 5\n+\n // ScopeRef is the canonical address of a reviewable POSE scope.\n type ScopeRef struct {\n \tKind      string `json:\"kind\"`\n@@ -247,6 +254,13 @@ type ReviewPolicy struct {\n \t// pose-authority-claim-project-is-not-the-audience). Like the audience it is\n \t// read from the protected policy, never from the environment.\n \tAuthorityProject string `json:\"authority_project,omitempty\"`\n+\t// MilestoneReviewRequired and RoadmapReviewRequired decide whether the close\n+\t// of an aggregate scope owes its own independent review: never,\n+\t// when-justified or always. Both are present exactly under schema 5; an\n+\t// older schema keeps the legacy rule (ADR\n+\t// closeout-review-policy-by-cost-and-benefit).\n+\tMilestoneReviewRequired string `json:\"milestone_review_required,omitempty\"`\n+\tRoadmapReviewRequired   string `json:\"roadmap_review_required,omitempty\"`\n }\n \n // ReviewIdentityAssurance resolves the assurance a scope kind requires,\n@@ -412,6 +426,13 @@ type ReviewEvaluation struct {\n \tBundleDigest  string         `json:\"bundle_digest,omitempty\"`\n \tAttestationID string         `json:\"attestation_id,omitempty\"`\n \tBundleState   string         `json:\"bundle_state,omitempty\"`\n+\t// ApprovalOrigin names where an approval not attested on the scope itself\n+\t// came from: an inherited member, a roadmap declaration, or\n+\t// not-required:<key>=<value> under an adopted closeout review policy.\n+\tApprovalOrigin string `json:\"approval_origin,omitempty\"`\n+\t// CloseoutReview is the closeout-review@1 decision for an aggregate scope\n+\t// under an adopted policy (spec pose-closeout-review-policy-by-cost-benefit).\n+\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n \t// Assurance discloses what the current review record proves about its\n \t// reviewer (spec pose-review-assurance-disclosure).\n \tAssurance *ReviewAssurance `json:\"assurance,omitempty\"`\n@@ -445,6 +466,12 @@ type CloseoutState struct {\n \t// NextStep is NextAction as a code and refs, for a consumer that must not\n \t// parse the sentence.\n \tNextStep *Diagnostic `json:\"next_step,omitempty\"`\n+\t// CloseoutReceipt is the receipt an explicit close published under an\n+\t// adopted closeout review policy; CloseRequired says the scope is\n+\t// eligible but still owes that close (spec\n+\t// pose-closeout-review-policy-by-cost-benefit R4).\n+\tCloseoutReceipt *CloseoutReceipt `json:\"closeout_receipt,omitempty\"`\n+\tCloseRequired   bool             `json:\"close_required,omitempty\"`\n }\n \n func withGovernanceReviewReadView[T any](s Store, producer string, run func(Store) (T, error), attach func(*T, *ReadViewMetadata, governanceReadViewAudit)) (T, error) {\n@@ -667,8 +694,17 @@ func (s Store) parseReviewPolicy(raw []byte) (ReviewPolicy, error) {\n \tif err := ValidateDelegationAdoptionDate(p.DelegatedReviewDisabledAt); err != nil {\n \t\treturn ReviewPolicy{}, err\n \t}\n+\tif err := validateCloseoutReviewPolicyKeys(raw, fields, p.SchemaVersion); err != nil {\n+\t\treturn ReviewPolicy{}, err\n+\t}\n \tqualifiedRefsRequired := p.SchemaVersion == QualifiedArtifactPolicySchemaVersion || p.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion\n-\tif (qualifiedRefsRequired && p.QualifiedArtifactRefsVersion != 1) || (!qualifiedRefsRequired && p.QualifiedArtifactRefsVersion != 0) {\n+\tif p.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n+\t\t// Schema 5 recognizes the closeout pair without adopting references or\n+\t\t// transfer: each stays at 0, or 1 as the earlier schemas define it.\n+\t\tif p.QualifiedArtifactRefsVersion != 0 && p.QualifiedArtifactRefsVersion != 1 {\n+\t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: unsupported qualified_artifact_refs_version %d\", p.QualifiedArtifactRefsVersion)\n+\t\t}\n+\t} else if (qualifiedRefsRequired && p.QualifiedArtifactRefsVersion != 1) || (!qualifiedRefsRequired && p.QualifiedArtifactRefsVersion != 0) {\n \t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: qualified artifact references require review policy schema 3 and qualified_artifact_refs_version 1\")\n \t}\n \tif p.CausalityCloseoutVersion != 0 && p.CausalityCloseoutVersion != CausalityCloseoutPolicyVersion {\n@@ -705,7 +741,14 @@ func (s Store) parseReviewPolicy(raw []byte) (ReviewPolicy, error) {\n \tif p.ContractNodesVersion != 0 && p.ContractNodesVersion != ContractNodesPolicyVersion {\n \t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: unsupported contract_nodes_version %d (engine supports %d)\", p.ContractNodesVersion, ContractNodesPolicyVersion)\n \t}\n-\tif (p.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion && p.SpecAuthorityTransferVersion != 1) || (p.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && p.SpecAuthorityTransferVersion != 0) {\n+\tif p.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n+\t\tif p.SpecAuthorityTransferVersion != 0 && p.SpecAuthorityTransferVersion != 1 {\n+\t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: unsupported spec_authority_transfer_version %d\", p.SpecAuthorityTransferVersion)\n+\t\t}\n+\t\tif p.SpecAuthorityTransferVersion == 1 && p.QualifiedArtifactRefsVersion != 1 {\n+\t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: spec authority transfer requires qualified_artifact_refs_version 1\")\n+\t\t}\n+\t} else if (p.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion && p.SpecAuthorityTransferVersion != 1) || (p.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && p.SpecAuthorityTransferVersion != 0) {\n \t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: spec authority transfer requires review policy schema 4 and spec_authority_transfer_version 1\")\n \t}\n \tif p.SchemaVersion >= ReviewPolicySchemaVersion {\n@@ -719,7 +762,7 @@ func (s Store) parseReviewPolicy(raw []byte) (ReviewPolicy, error) {\n \t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: invalid schema-v2 review policy: %w\", err)\n \t\t}\n \t}\n-\tif p.SchemaVersion != ReviewSchemaVersion && p.SchemaVersion != ReviewPolicySchemaVersion && p.SchemaVersion != QualifiedArtifactPolicySchemaVersion && p.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion {\n+\tif p.SchemaVersion != ReviewSchemaVersion && p.SchemaVersion != ReviewPolicySchemaVersion && p.SchemaVersion != QualifiedArtifactPolicySchemaVersion && p.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && p.SchemaVersion != CloseoutReviewPolicySchemaVersion {\n \t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: unsupported review policy schema %d\", p.SchemaVersion)\n \t}\n \tif err := validateReviewPolicyScopes(\"identity_assurance\", p.IdentityAssurance); err != nil {\n@@ -1477,15 +1520,40 @@ func (s Store) reviewCheck(ref string) (ReviewEvaluation, error) {\n \t\treturn ReviewEvaluation{}, err\n \t}\n \teval := ReviewEvaluation{Scope: ref, ScopeDigest: digest, PolicyEnabled: policy.Enabled, Required: policy.Enabled, Fresh: false, Approved: false, Blockers: []string{}}\n-\tif !policy.Enabled {\n+\t// An adopted closeout review policy decides an aggregate scope before the\n+\t// legacy shortcuts: neither enabled=false nor an adoption cutoff weakens\n+\t// what it requires (spec pose-closeout-review-policy-by-cost-benefit).\n+\tdecision, exempt, err := s.closeoutReviewGate(ref, policy)\n+\tif err != nil {\n+\t\treturn eval, err\n+\t}\n+\teval.CloseoutReview = decision\n+\tif decision != nil {\n+\t\tif exempt {\n+\t\t\teval.Required = false\n+\t\t\teval.Fresh = true\n+\t\t\teval.ApprovalOrigin = closeoutApprovalOrigin(*decision)\n+\t\t\teval.Warnings = append(eval.Warnings, closeoutExemptionWarning(ref, *decision))\n+\t\t\treturn eval, nil\n+\t\t}\n+\t\teval.Required = true\n+\t\tif !decision.Known {\n+\t\t\teval.Blockers = append(eval.Blockers, decision.Diagnostics...)\n+\t\t\treturn eval, nil\n+\t\t}\n+\t}\n+\tif !policy.Enabled && decision == nil {\n \t\teval.Warnings = append(eval.Warnings, \"review policy is absent or disabled; closeout review is not enforced\")\n \t\treturn eval, nil\n \t}\n \tprofileRef := policy.Profiles[scope.Kind]\n \teval.Profile = profileRef\n-\trequired, err := s.reviewRequiredForScope(scope, policy)\n-\tif err != nil {\n-\t\treturn eval, err\n+\trequired := true\n+\tif decision == nil {\n+\t\trequired, err = s.reviewRequiredForScope(scope, policy)\n+\t\tif err != nil {\n+\t\t\treturn eval, err\n+\t\t}\n \t}\n \teval.Required = required\n \tif !required {\n@@ -2725,7 +2793,38 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t}\n \t\t}\n \t}\n-\tif !review.Required {\n+\tcloseOwed := false\n+\tif scope.Kind == \"milestone\" || scope.Kind == \"roadmap\" {\n+\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil && policy.CloseoutReviewAdopted() {\n+\t\t\treceipt, receiptErr := s.ReadCloseoutReceipt(ref)\n+\t\t\tif receiptErr != nil {\n+\t\t\t\tblock(OpaqueDiagnostic(\"closeout-receipt-invalid\", DiagnosticCloseout, receiptErr.Error()))\n+\t\t\t}\n+\t\t\tstate.CloseoutReceipt = receipt\n+\t\t\tif decision := review.CloseoutReview; decision != nil && receipt == nil && receiptErr == nil {\n+\t\t\t\t// Terminal members make the scope eligible, never closed: the\n+\t\t\t\t// explicit close publishes the receipt that makes it terminal.\n+\t\t\t\tcloseOwed = true\n+\t\t\t\tfor _, diagnostic := range decision.Diagnostics {\n+\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", diagnostic, ref))\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif review.CloseoutReview == nil && receipt == nil && scope.Kind == \"roadmap\" && state.LifecycleDone && review.Required && !review.Approved {\n+\t\t\t\tdiagnostics = append(diagnostics, NewDiagnostic(\"closeout-receipt-incomplete\", \"roadmap \"+scope.Slug+\" is done with neither an approved review nor a closeout receipt; `pose close \"+ref+\"` verifies its inputs again and publishes the receipt\", ref))\n+\t\t\t}\n+\t\t}\n+\t}\n+\tstate.CloseRequired = closeOwed\n+\tif scope.Kind == \"roadmap\" && state.CloseoutReceipt != nil {\n+\t\t// A receipt stands for its cut criteria only while they still hold:\n+\t\t// the shared terminal path checks them, as the roadmap gate does.\n+\t\tfor _, blocker := range s.roadmapCriteriaBlockers(scope.Slug) {\n+\t\t\tblock(NewDiagnostic(\"closeout-receipt-gate-failed\", blocker, ref))\n+\t\t}\n+\t}\n+\t// An exemption under the adopted policy leaves the review no blockers to\n+\t// remove; only the legacy path strips review-only messages, by text.\n+\tif !review.Required && review.CloseoutReview == nil {\n \t\tstate.Blockers = removeReviewOnlyBlockers(state.Blockers)\n \t\tkept := diagnostics[:0]\n \t\tfor _, d := range diagnostics {\n@@ -2757,7 +2856,7 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t}\n \t}\n \tstate.Blockers = uniqueSorted(state.Blockers)\n-\tstate.Terminal = len(state.Blockers) == 0 && (review.Approved || !review.Required) && state.LifecycleDone\n+\tstate.Terminal = len(state.Blockers) == 0 && (review.Approved || !review.Required) && state.LifecycleDone && !closeOwed\n \tif state.Terminal {\n \t\tstate.NextAction = \"none\"\n \t} else if len(state.Children) > 0 {\n@@ -2781,6 +2880,9 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \tif state.NextAction == \"\" && scope.Kind == \"spec\" && state.FederatedAcceptance != nil && !state.FederatedAcceptance.Ready {\n \t\tstate.NextAction = \"resolve federated dependency blockers for \" + ref\n \t}\n+\tif state.NextAction == \"\" && closeOwed && len(state.Blockers) == 0 {\n+\t\tstate.NextAction = \"close \" + ref + \" with `pose close \" + ref + \"`, which publishes its closeout receipt\"\n+\t}\n \tif state.NextAction == \"\" {\n \t\tstate.NextAction = \"resolve closeout blockers for \" + ref\n \t}\n@@ -2815,6 +2917,9 @@ func closeoutNextStep(state CloseoutState, review ReviewEvaluation, ref string)\n \t\t\t\treturn step(\"continue-child\", child.Scope)\n \t\t\t}\n \t\t}\n+\t\tif state.CloseRequired && len(state.Blockers) == 0 {\n+\t\t\treturn step(\"close-scope\", ref)\n+\t\t}\n \t\treturn step(\"resolve-federated-blockers\", ref)\n \tcase !review.Approved && review.Required:\n \t\treturn step(\"record-fresh-review\", ref)\n@@ -2822,6 +2927,8 @@ func closeoutNextStep(state CloseoutState, review ReviewEvaluation, ref string)\n \t\treturn step(\"apply-lifecycle-transition\", ref)\n \tcase state.FederatedAcceptance != nil && !state.FederatedAcceptance.Ready:\n \t\treturn step(\"resolve-federated-blockers\", ref)\n+\tcase state.CloseRequired && len(state.Blockers) == 0:\n+\t\treturn step(\"close-scope\", ref)\n \t}\n \treturn step(\"resolve-closeout-blockers\", ref)\n }\n@@ -2856,6 +2963,10 @@ func (s Store) GetCloseoutStateWithFederatedAcceptance(ref, projectID string, re\n // a federated resolver must fail closed on an external member.\n func (s Store) milestoneMember(raw string) (string, bool) {\n \tref, err := ParseArtifactRef(raw)\n+\tif err == nil && ref.Project == \"\" && ref.Kind == \"spec\" && ref.Milestone == \"\" {\n+\t\t// `spec:<slug>` and `<slug>` name the same local member.\n+\t\treturn ref.Slug, false\n+\t}\n \tif err != nil || ref.Project == \"\" {\n \t\treturn raw, false\n \t}\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex 0782e239..b598a9e1 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -131,6 +131,10 @@ type ReviewPlan struct {\n \tWarnings                  []string `json:\"warnings,omitempty\"`\n \tBlockers                  []string `json:\"blockers,omitempty\"`\n \tExplain                   []string `json:\"explain\"`\n+\t// CloseoutReview is the closeout-review@1 decision for a milestone or a\n+\t// roadmap under an adopted policy. Like Band it is a projection: it stays\n+\t// out of the plan digest (spec pose-closeout-review-policy-by-cost-benefit).\n+\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n }\n \n type reviewRepoEntry struct {\n@@ -397,6 +401,16 @@ func (s Store) ReviewPlan(ref string) (ReviewPlan, error) {\n \tif err != nil {\n \t\treturn ReviewPlan{}, err\n \t}\n+\t// Warnings and Explain enter the digest; the decision does not, so it is\n+\t// attached only as its own field. A gate that cannot answer (a corrupt or\n+\t// drifted receipt) fails the plan as it fails closeout-check.\n+\tif !s.planWithoutCloseoutGate {\n+\t\tdecision, _, gateErr := s.closeoutReviewGate(ref, policy)\n+\t\tif gateErr != nil {\n+\t\t\treturn ReviewPlan{}, gateErr\n+\t\t}\n+\t\tplan.CloseoutReview = decision\n+\t}\n \treturn plan, nil\n }\n \ndiff --git a/pose-mcp/internal/pose/roadmaps.go b/pose-mcp/internal/pose/roadmaps.go\nindex 54366f7e..dbc2c3ce 100644\n--- a/pose-mcp/internal/pose/roadmaps.go\n+++ b/pose-mcp/internal/pose/roadmaps.go\n@@ -22,10 +22,14 @@ type Roadmap struct {\n \tConsumes  []string `json:\"consumes,omitempty\"`\n \t// UnreviewedMilestones is the reason a roadmap gives for its reached milestones\n \t// standing without a review (ADR a-milestone-of-one-member-is-that-member).\n-\tUnreviewedMilestones string      `json:\"-\"`\n-\tMilestones           []Milestone `json:\"milestones\"`\n-\tPath                 string      `json:\"path\"`\n-\tBody                 string      `json:\"body,omitempty\"`\n+\tUnreviewedMilestones string `json:\"-\"`\n+\t// ADRs is the raw `adrs:` declaration, `[adr:<file>.md, …]`, read by the\n+\t// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n+\t// Raw so that a malformed declaration is unknown, not absent.\n+\tADRs       string      `json:\"-\"`\n+\tMilestones []Milestone `json:\"milestones\"`\n+\tPath       string      `json:\"path\"`\n+\tBody       string      `json:\"body,omitempty\"`\n }\n \n type Milestone struct {\n@@ -52,6 +56,22 @@ func (s Store) ReachedMilestones(spec string) ([]string, error) {\n \t\treturn nil, err\n \t}\n \treached := []string{}\n+\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil {\n+\t\treturn reached, err\n+\t} else if adopted {\n+\t\t// Under an adopted closeout review policy, only the explicit close\n+\t\t// makes a milestone terminal: reached means no receipt yet.\n+\t\tfor _, ref := range candidates {\n+\t\t\tclosed, err := s.closedByReceipt(ref)\n+\t\t\tif err != nil {\n+\t\t\t\treturn reached, err\n+\t\t\t}\n+\t\t\tif !closed {\n+\t\t\t\treached = append(reached, ref)\n+\t\t\t}\n+\t\t}\n+\t\treturn reached, nil\n+\t}\n \tfor _, ref := range candidates {\n \t\t// Its only member has just closed, uncommitted, so its verification cannot\n \t\t// answer yet: only a refusal recorded on the milestone says it will not stand.\n@@ -290,6 +310,10 @@ func (s Store) RoadmapsReachedBy(spec string) ([]string, error) {\n \t\treturn nil, err\n \t}\n \tfound := []string{}\n+\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || adopted {\n+\t\t// Adopted: a member's close leaves its milestone reached, never closed.\n+\t\treturn found, err\n+\t}\n \tfor _, rm := range roadmaps {\n \t\tfor _, milestone := range rm.Milestones {\n \t\t\tif member, ok := s.soleMemberOf(ScopeRef{Kind: \"milestone\", Roadmap: rm.Slug, Milestone: milestone.ID}); ok && member == spec {\n@@ -316,10 +340,20 @@ func (s Store) roadmapReachedApartFrom(slug, closing string) bool {\n \tif err != nil || rm.Status == \"done\" || len(rm.Milestones) == 0 {\n \t\treturn false\n \t}\n+\tadopted, err := s.closeoutReviewPolicyAdopted()\n+\tif err != nil {\n+\t\treturn false\n+\t}\n \tfor _, milestone := range rm.Milestones {\n \t\tif milestone.ID == closing {\n \t\t\tcontinue\n \t\t}\n+\t\tif adopted {\n+\t\t\tif closed, err := s.closedByReceipt(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !closed {\n+\t\t\t\treturn false\n+\t\t\t}\n+\t\t\tcontinue\n+\t\t}\n \t\tif approved, err := s.scopeApproved(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !approved {\n \t\t\treturn false\n \t\t}\n@@ -434,6 +468,8 @@ func parseRoadmapFile(files Files, path, slug string, includeBody bool) (*Roadma\n \t\t\trm.Consumes = parseInlineList(value)\n \t\tcase \"unreviewed_milestones\":\n \t\t\trm.UnreviewedMilestones = cleanValue(value)\n+\t\tcase \"adrs\":\n+\t\t\trm.ADRs = strings.TrimSpace(value)\n \t\t}\n \t}\n \tvar current *Milestone\n@@ -487,3 +523,8 @@ func parseRoadmapFile(files Files, path, slug string, includeBody bool) (*Roadma\n \t}\n \treturn rm, nil\n }\n+\n+func (s Store) closeoutReviewPolicyAdopted() (bool, error) {\n+\tpolicy, _, err := s.loadReviewPolicy()\n+\treturn policy.CloseoutReviewAdopted(), err\n+}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"agent_message","text":"The new code addresses several prior findings directly: protected baseline overlays, multi-member exit gates, child blockers, and receipt-backed terminal checks. I’m now checking historical closures and whether every reader applies the same result. The two strict reconciliation commands are still running."}}
