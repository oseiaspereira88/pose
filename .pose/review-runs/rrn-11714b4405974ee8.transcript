{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '654,700p' pose-mcp/internal/pose/federated_acceptance.go\"","aggregated_output":"\t\treturn true // sibling checkouts have no consumer gitlink to compare.\n\t}\n\tparentTop, err := captureFederatedGit(files, parent.Root, \"rev-parse\", \"--show-toplevel\")\n\tif err != nil {\n\t\tmarkFederatedGitReadUnknown(files, parent.Root, \"federated parent Git root could not be identified\")\n\t\treturn true\n\t}\n\tif !sameProjectRoot(files, parent.Root, strings.TrimSpace(string(parentTop))) {\n\t\treturn true\n\t}\n\tparentReal, err1 := files.EvalSymlinks(parent.Root)\n\tchildReal, err2 := files.EvalSymlinks(child.Root)\n\tif err1 != nil || err2 != nil {\n\t\treturn false\n\t}\n\trel, err := filepath.Rel(parentReal, childReal)\n\tif err != nil || rel == \"..\" || strings.HasPrefix(rel, \"..\"+string(filepath.Separator)) {\n\t\treturn true // sibling project, explicitly selected in Roots.\n\t}\n\tlisting, err := captureFederatedGit(files, parent.Root, \"ls-tree\", \"HEAD\", \"--\", filepath.ToSlash(rel))\n\tif err != nil {\n\t\treturn false\n\t}\n\tfields := strings.Fields(string(listing))\n\tif len(fields) < 3 || fields[0] != \"160000\" || fields[1] != \"commit\" {\n\t\treturn false\n\t}\n\treturn fields[2] == revision\n}\n\n// federatedGitlinkMatches reads the filesystem directly; federatedGitlinkMatchesIn reads the operation's files.\nfunc federatedGitlinkMatches(parent, child Store, revision string) bool {\n\treturn federatedGitlinkMatchesIn(NativeFiles(), parent, child, revision)\n}\n\nfunc federatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\n\tscope := localFederatedScope(identity)\n\tstate, err := source.GetCloseoutState(scope)\n\tif err != nil || !state.Terminal {\n\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-not-terminal\"}\n\t}\n\t// A milestone or roadmap the source closed without its own review, under\n\t// its adopted closeout review policy, is proven by the receipt of that\n\t// close: the source's policy decides, never the consumer's. Its members\n\t// are federated with their own reviews (spec\n\t// pose-closeout-review-policy-by-cost-benefit).\n\tif receipt := state.CloseoutReceipt; receipt != nil && !receipt.Decision.Required && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n","exit_code":0,"status":"completed"}}
