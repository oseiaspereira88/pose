"probe_test.go\\\").write_text(source)\n overlay={\\\"Replace\\\":{str(root/\\\"internal/pose/independent_review_probe_test.go\\\"):str(p/\\\"probe_test.go\\\")}}\n (p/\\\"overlay.json\\\").write_text(json.dumps(overlay))\n r=subprocess.run([\\\"go\\\",\\\"test\\\",\\\"-overlay\\\",str(p/\\\"overlay.json\\\"),\\\"./internal/pose\\\",\\\"-run\\\",\\\"\"'^TestIndependent\",\"-count=1\",\"-v\"],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)\n print(r.stdout)\n print(\"probe_exit=\"+str(r.returncode))\n'\"'\"","aggregated_output":"Traceback (most recent call last):\n  File \"<string>\", line 34, in <module>\n    with tempfile.TemporaryDirectory(prefix=\"pose-independent-review-\") as d:\n         ~~~~~~~~~~~~~~~~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/usr/lib/python3.14/tempfile.py\", line 961, in __init__\n    self.name = mkdtemp(suffix, prefix, dir)\n                ~~~~~~~^^^^^^^^^^^^^^^^^^^^^\n  File \"/usr/lib/python3.14/tempfile.py\", line 424, in mkdtemp\n    prefix, suffix, dir, output_type = _sanitize_params(prefix, suffix, dir)\n                                       ~~~~~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^\n  File \"/usr/lib/python3.14/tempfile.py\", line 128, in _sanitize_params\n    dir = gettempdir()\n  File \"/usr/lib/python3.14/tempfile.py\", line 366, in gettempdir\n    return _os.fsdecode(_gettempdir())\n                        ~~~~~~~~~~~^^\n  File \"/usr/lib/python3.14/tempfile.py\", line 359, in _gettempdir\n    tempdir = _get_default_tempdir()\n  File \"/usr/lib/python3.14/tempfile.py\", line 223, in _get_default_tempdir\n    raise FileNotFoundError(_errno.ENOENT,\n                            \"No usable temporary directory found in %s\" %\n                            dirlist)\nFileNotFoundError: [Errno 2] No usable temporary directory found in ['/var/tmp/pose-work-go/pose-review-run-2131422183', '/var/tmp/pose-work-go/pose-review-run-2131422183', '/var/tmp/pose-work-go/pose-review-run-2131422183', '/tmp', '/var/tmp', '/u