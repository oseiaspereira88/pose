{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/closeout_review_policy.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Closeout review policy by cost and benefit (spec\n     4\t// pose-closeout-review-policy-by-cost-benefit, ADR\n     5\t// closeout-review-policy-by-cost-and-benefit). An instance that adopts review\n     6\t// policy schema 5 decides, per aggregate scope kind, whether the close of a\n     7\t// milestone or a roadmap owes its own independent review. Closing stays\n     8\t// explicit in every mode; what changes is only the review of the aggregate.\n     9\t// One evaluator answers for every reader, so plan, verification, state,\n    10\t// doctor and close cannot disagree about the threshold.\n    11\t\n    12\timport (\n    13\t\t\"encoding/json\"\n    14\t\t\"fmt\"\n    15\t\t\"sort\"\n    16\t\t\"strings\"\n    17\t)\n    18\t\n    19\tconst (\n    20\t\tCloseoutReviewNever         = \"never\"\n    21\t\tCloseoutReviewWhenJustified = \"when-justified\"\n    22\t\tCloseoutReviewAlways        = \"always\"\n    23\t\n    24\t\tCloseoutReviewEvaluatorVersion = \"closeout-review@1\"\n    25\t\n    26\t\tMilestoneReviewRequiredKey = \"milestone_review_required\"\n    27\t\tRoadmapReviewRequiredKey   = \"roadmap_review_required\"\n    28\t\n    29\t\t// The when-justified thresholds the maintainer chose: a milestone owes a\n    30\t\t// review with more than two distinct specs; a roadmap with more than one\n    31\t\t// distinct spec and at least one ADR association.\n    32\t\tcloseoutMilestoneMemberThreshold = 2\n    33\t\tcloseoutRoadmapMemberThreshold   = 1\n    34\t)\n    35\t\n    36\tfunc validCloseoutReviewValue(value string) bool {\n    37\t\tswitch value {\n    38\t\tcase CloseoutReviewNever, CloseoutReviewWhenJustified, CloseoutReviewAlways:\n    39\t\t\treturn true\n    40\t\t}\n    41\t\treturn false\n    42\t}\n    43\t\n    44\t// validateCloseoutReviewPolicyKeys refuses the pair outside schema 5, and\n    45\t// under schema 5 refuses a missing, null, mistyped, duplicated or unknown value\n    46\t// before anything plans or writes against it.\n    47\tfunc validateCloseoutReviewPolicyKeys(raw []byte, fields map[string]json.RawMessage, schema int) error {\n    48\t\t_, hasMilestone := fields[MilestoneReviewRequiredKey]\n    49\t\t_, hasRoadmap := fields[RoadmapReviewRequiredKey]\n    50\t\tif schema != CloseoutReviewPolicySchemaVersion {\n    51\t\t\tif hasMilestone || hasRoadmap {\n    52\t\t\t\treturn fmt.Errorf(\"pose: %s and %s require review policy schema %d\", MilestoneReviewRequiredKey, RoadmapReviewRequiredKey, CloseoutReviewPolicySchemaVersion)\n    53\t\t\t}\n    54\t\t\treturn nil\n    55\t\t}\n    56\t\tif err := rejectDuplicateJSONKeys(raw, false, true); err != nil {\n    57\t\t\treturn fmt.Errorf(\"pose: invalid schema-%d review policy: %w\", CloseoutReviewPolicySchemaVersion, err)\n    58\t\t}\n    59\t\tif !hasMilestone || !hasRoadmap {\n    60\t\t\treturn fmt.Errorf(\"pose: review policy schema %d requires both %s and %s\", CloseoutReviewPolicySchemaVersion, MilestoneReviewRequiredKey, RoadmapReviewRequiredKey)\n    61\t\t}\n    62\t\tfor _, key := range []string{MilestoneReviewRequiredKey, RoadmapReviewRequiredKey} {\n    63\t\t\tvar value string\n    64\t\t\tif string(fields[key]) == \"null\" || json.Unmarshal(fields[key], &value) != nil || !validCloseoutReviewValue(value) {\n    65\t\t\t\treturn fmt.Errorf(\"pose: %s must be one of never, when-justified, always (got %s)\", key, string(fields[key]))\n    66\t\t\t}\n    67\t\t}\n    68\t\treturn nil\n    69\t}\n    70\t\n    71\t// CloseoutReviewAdopted reports a policy that decides aggregate reviews by the\n    72\t// closeout pair. Every other policy keeps the legacy rule unchanged.\n    73\tfunc (p ReviewPolicy) CloseoutReviewAdopted() bool {\n    74\t\treturn p.SchemaVersion == CloseoutReviewPolicySchemaVersion\n    75\t}\n    76\t\n    77\t// CloseoutReviewSetting names the policy key and value that govern a scope kind.\n    78\tfunc (p ReviewPolicy) CloseoutReviewSetting(kind string) (string, string) {\n    79\t\tswitch kind {\n    80\t\tcase \"milestone\":\n    81\t\t\treturn MilestoneReviewRequiredKey, p.MilestoneReviewRequired\n    82\t\tcase \"roadmap\":\n    83\t\t\treturn RoadmapReviewRequiredKey, p.RoadmapReviewRequired\n    84\t\t}\n    85\t\treturn \"\", \"\"\n    86\t}\n    87\t\n    88\t// CloseoutReviewDecision is the evaluator's answer for one aggregate scope.\n    89\t// Projections render it; none of them recomputes a threshold.\n    90\ttype CloseoutReviewDecision struct {\n    91\t\tScope            string `json:\"scope\"`\n    92\t\tAdopted          bool   `json:\"adopted\"`\n    93\t\tEvaluatorVersion string `json:\"evaluator_version,omitempty\"`\n    94\t\tPolicyKey        string `json:\"policy_key,omitempty\"`\n    95\t\tPolicyValue      string `json:\"policy_value,omitempty\"`\n    96\t\t// Required is true when the scope owes its own independent review. An\n    97\t\t// unknown input never yields false.\n    98\t\tRequired bool `json:\"required\"`\n    99\t\t// Known is false when a member or an association could not be resolved:\n   100\t\t// the decision then requires the review and says what is missing.\n   101\t\tKnown       bool     `json:\"known\"`\n   102\t\tReason      string   `json:\"reason,omitempty\"`\n   103\t\tMembers     []string `json:\"members,omitempty\"`\n   104\t\tADRs        []string `json:\"adr_associations,omitempty\"`\n   105\t\tDiagnostics []string `json:\"diagnostics,omitempty\"`\n   106\t}\n   107\t\n   108\t// Review is the literal the closeout receipt records: required or not-required.\n   109\tfunc (d CloseoutReviewDecision) Review() string {\n   110\t\tif d.Required {\n   111\t\t\treturn \"required\"\n   112\t\t}\n   113\t\treturn \"not-required\"\n   114\t}\n   115\t\n   116\t// EvaluateCloseoutReview answers whether an aggregate scope owes its own\n   117\t// review under the adopted policy. A legacy policy returns Adopted=false and\n   118\t// the caller keeps the legacy rule.\n   119\tfunc (s Store) EvaluateCloseoutReview(ref string) (CloseoutReviewDecision, error) {\n   120\t\tpolicy, _, err := s.loadReviewPolicy()\n   121\t\tif err != nil {\n   122\t\t\treturn CloseoutReviewDecision{}, err\n   123\t\t}\n   124\t\treturn s.evaluateCloseoutReview(ref, policy)\n   125\t}\n   126\t\n   127\tfunc (s Store) evaluateCloseoutReview(ref string, policy ReviewPolicy) (CloseoutReviewDecision, error) {\n   128\t\tdecision := CloseoutReviewDecision{Scope: ref, Known: true}\n   129\t\tscope, err := ParseScopeRef(ref)\n   130\t\tif err != nil {\n   131\t\t\treturn decision, err\n   132\t\t}\n   133\t\tif !policy.CloseoutReviewAdopted() || (scope.Kind != \"milestone\" && scope.Kind != \"roadmap\") {\n   134\t\t\treturn decision, nil\n   135\t\t}\n   136\t\tdecision.Adopted = true\n   137\t\tdecision.EvaluatorVersion = CloseoutReviewEvaluatorVersion\n   138\t\tdecision.PolicyKey, decision.PolicyValue = policy.CloseoutReviewSetting(scope.Kind)\n   139\t\tslug := scope.Roadmap\n   140\t\tif scope.Kind == \"roadmap\" {\n   141\t\t\tslug = scope.Slug\n   142\t\t}\n   143\t\trm, err := s.GetRoadmap(slug)\n   144\t\tif err != nil {\n   145\t\t\treturn decision, err\n   146\t\t}\n   147\t\tproject, projectErr := s.WriteProjectID()\n   148\t\tvar raws []string\n   149\t\tif scope.Kind == \"milestone\" {\n   150\t\t\tfound := false\n   151\t\t\tfor _, milestone := range rm.Milestones {\n   152\t\t\t\tif milestone.ID == scope.Milestone {\n   153\t\t\t\t\traws, found = milestone.Specs, true\n   154\t\t\t\t}\n   155\t\t\t}\n   156\t\t\tif !found {\n   157\t\t\t\treturn decision, fmt.Errorf(\"pose: milestone %s not found in roadmap %s\", scope.Milestone, scope.Roadmap)\n   158\t\t\t}\n   159\t\t} else {\n   160\t\t\tfor _, milestone := range rm.Milestones {\n   161\t\t\t\traws = append(raws, milestone.Specs...)\n   162\t\t\t}\n   163\t\t}\n   164\t\tif projectErr != nil {\n   165\t\t\tdecision.Diagnostics = append(decision.Diagnostics, \"the project identity that qualifies local members is unknown: \"+projectErr.Error())\n   166\t\t} else {\n   167\t\t\tdecision.Members, decision.Diagnostics = s.closeoutCanonicalMembers(raws, project)\n   168\t\t}\n   169\t\tif len(decision.Diagnostics) > 0 {\n   170\t\t\tdecision.Known = false\n   171\t\t}\n   172\t\tmembers := len(decision.Members)\n   173\t\tswitch decision.PolicyValue {\n   174\t\tcase CloseoutReviewNever:\n   175\t\t\tdecision.Required = false\n   176\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, never required\", members)\n   177\t\t\t// never decides without counting, but a member it cannot resolve is\n   178\t\t\t// still a scope it cannot close.\n   179\t\t\treturn decision, nil\n   180\t\tcase CloseoutReviewAlways:\n   181\t\t\tdecision.Required = true\n   182\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, always required\", members)\n   183\t\t\treturn decision, nil\n   184\t\t}\n   185\t\tif !decision.Known {\n   186\t\t\tdecision.Required = true\n   187\t\t\tdecision.Reason = \"members unknown; an exemption needs every member resolved\"\n   188\t\t\treturn decision, nil\n   189\t\t}\n   190\t\tif scope.Kind == \"milestone\" {\n   191\t\t\tdecision.Required = members > closeoutMilestoneMemberThreshold\n   192\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d\", members, closeoutMilestoneMemberThreshold)\n   193\t\t\treturn decision, nil\n   194\t\t}\n   195\t\t// The associations are resolved even below the member threshold: an\n   196\t\t// association input that cannot be read never proves an exemption.\n   197\t\tadrs, diagnostics := s.closeoutADRAssociations(rm, project)\n   198\t\tdecision.ADRs = adrs\n   199\t\tif len(diagnostics) > 0 {\n   200\t\t\tdecision.Diagnostics = append(decision.Diagnostics, diagnostics...)\n   201\t\t\tdecision.Known = false\n   202\t\t\tdecision.Required = true\n   203\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d, adr associations unknown\", members, closeoutRoadmapMemberThreshold)\n   204\t\t\treturn decision, nil\n   205\t\t}\n   206\t\tdecision.Required = members > closeoutRoadmapMemberThreshold && len(adrs) > 0\n   207\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d, adrs=%d\", members, closeoutRoadmapMemberThreshold, len(adrs))\n   208\t\treturn decision, nil\n   209\t}\n   210\t\n   211\t// closeoutCanonicalMembers resolves milestone members to their final\n   212\t// identities, xref:<project>/spec:<slug>, sorted and deduplicated. A local\n   213\t// member follows only a verified transfer redirect; an external one is\n   214\t// resolved by the federated resolver or stays unknown. Unknown members are\n   215\t// diagnostics, never a count of zero.\n   216\tfunc (s Store) closeoutCanonicalMembers(raws []string, project string) ([]string, []string) {\n   217\t\tseen := map[string]bool{}\n   218\t\tmembers, diagnostics := []string{}, []string{}\n   219\t\tfor _, raw := range raws {\n   220\t\t\tidentity, diagnostic := s.closeoutCanonicalMember(strings.TrimSpace(raw), project)\n   221\t\t\tif diagnostic != \"\" {\n   222\t\t\t\tdiagnostics = append(diagnostics, diagnostic)\n   223\t\t\t\tcontinue\n   224\t\t\t}\n   225\t\t\tif !seen[identity] {\n   226\t\t\t\tseen[identity] = true\n   227\t\t\t\tmembers = append(members, identity)\n   228\t\t\t}\n   229\t\t}\n   230\t\tsort.Strings(members)\n   231\t\treturn members, diagnostics\n   232\t}\n   233\t\n   234\tfunc (s Store) closeoutCanonicalMember(raw, project string) (string, string) {\n   235\t\tref, err := ParseArtifactRef(raw)\n   236\t\tif err != nil || ref.Kind != \"spec\" || ref.Milestone != \"\" {\n   237\t\t\treturn \"\", fmt.Sprintf(\"member %q is not a spec reference\", raw)\n   238\t\t}\n   239\t\tif ref.Project == \"\" {\n   240\t\t\tref.Project = project\n   241\t\t}\n   242\t\tresolve := func(why string) (string, string) {\n   243\t\t\tif s.FederatedResolver == nil {\n   244\t\t\t\treturn \"\", fmt.Sprintf(\"member %s %s and no federated resolver is bound to follow it\", ref.String(), why)\n   245\t\t\t}\n   246\t\t\tresolved := s.FederatedResolver.Resolve(project, ref.String())\n   247\t\t\tif !resolved.Resolved {\n   248\t\t\t\treturn \"\", fmt.Sprintf(\"member %s did not resolve: %s\", ref.String(), resolved.State)\n   249\t\t\t}\n   250\t\t\tif resolved.CanonicalIdentity != nil {\n   251\t\t\t\treturn resolved.CanonicalIdentity.String(), \"\"\n   252\t\t\t}\n   253\t\t\treturn resolved.Identity.String(), \"\"\n   254\t\t}\n   255\t\tif ref.Project != project {\n   256\t\t\treturn resolve(\"belongs to another project\")\n   257\t\t}\n   258\t\t_, found, err := readSpecTransferRedirect(s.fsys(), s, ref)\n   259\t\tif err != nil {\n   260\t\t\treturn \"\", fmt.Sprintf(\"member %s has an unverifiable redirect: %v\", ref.String(), err)\n   261\t\t}\n   262\t\tif found {\n   263\t\t\t// The resolver follows the whole chain, with its cycle and depth\n   264\t\t\t// limits and the destination's authorization: the immediate\n   265\t\t\t// destination may itself have moved.\n   266\t\t\treturn resolve(\"was transferred\")\n   267\t\t}\n   268\t\tif _, err := s.GetSpec(ref.Slug); err != nil {\n   269\t\t\treturn \"\", fmt.Sprintf(\"member %s names no spec of this project\", ref.String())\n   270\t\t}\n   271\t\treturn ref.String(), \"\"\n   272\t}\n   273\t\n   274\t// CurrentCloseoutDecision is the decision for an open aggregate scope now:\n   275\t// the evaluator, then every protection that can only make it stronger. It is\n   276\t// what close judges before publishing and again inside the protected region.\n   277\tfunc (s Store) CurrentCloseoutDecision(ref string) (CloseoutReviewDecision, error) {\n   278\t\tpolicy, _, err := s.loadReviewPolicy()\n   279\t\tif err != nil {\n   280\t\t\treturn CloseoutReviewDecision{}, err\n   281\t\t}\n   282\t\treturn s.currentCloseoutDecision(ref, policy)\n   283\t}\n   284\t\n   285\tfunc (s Store) currentCloseoutDecision(ref string, policy ReviewPolicy) (CloseoutReviewDecision, error) {\n   286\t\tdecision, err := s.evaluateCloseoutReview(ref, policy)\n   287\t\tif err != nil || !decision.Adopted || decision.Required {\n   288\t\t\treturn decision, err\n   289\t\t}\n   290\t\tscope, _ := ParseScopeRef(ref)\n   291\t\ts.protectCloseoutDecision(scope, &decision)\n   292\t\tif !decision.Required && s.mandatoryHumanReview(ref, scope.Kind, policy) {\n   293\t\t\tdecision.Required = true\n   294\t\t\tdecision.Reason += \"; a mandatory-human review is never dispensed\"\n   295\t\t}\n   296\t\tif !decision.Required && scope.Kind == \"milestone\" && len(decision.Members) > 1 && s.milestoneExitGate(scope) != \"\" {\n   297\t\t\t// A one-member milestone's exit gate is judged in its member's review\n   298\t\t\t// (addMilestoneGateCriterion); with more members only the aggregate\n   299\t\t\t// review judges it, so that review cannot be dispensed.\n   300\t\t\tdecision.Required = true\n   301\t\t\tdecision.Reason += \"; its exit gate is judged only by the milestone's own review\"\n   302\t\t}\n   303\t\treturn decision, nil\n   304\t}\n   305\t\n   306\t// mandatoryHumanReview reports a scope whose effective review plan asks for a\n   307\t// human reviewer: the base profile, the overlays the plan selects for it with\n   308\t// their cutoffs, and the protected baseline when the scope changes the review\n   309\t// contract, exactly as the plan composes them. No setting dispenses that\n   310\t// review. A plan that cannot be built is treated as asking for one, unless the\n   311\t// policy names no profile for the kind, where no review can be asked at all.\n   312\tfunc (s Store) mandatoryHumanReview(ref, kind string, policy ReviewPolicy) bool {\n   313\t\tif policy.ReviewerIndependence[kind] == \"mandatory-human\" {\n   314\t\t\treturn true\n   315\t\t}\n   316\t\tif policy.Profiles[kind] == \"\" {\n   317\t\t\t// No profile, no review to ask for, unless the scope itself removed\n   318\t\t\t// the profile: then the contract it changes cannot exempt it.\n   319\t\t\tscope, err := ParseScopeRef(ref)\n   320\t\t\treturn err != nil || len(s.resolveReviewGovernanceGuard(scope).Paths) > 0\n   321\t\t}\n   322\t\tplanner := s\n   323\t\tplanner.planWithoutCloseoutGate = true\n   324\t\tplan, err := planner.ReviewPlan(ref)\n   325\t\tif err != nil || plan.Independence == \"mandatory-human\" {\n   326\t\t\treturn true\n   327\t\t}\n   328\t\t// The plan composes the overlays' independence; the base profile's own is\n   329\t\t// read from the profile the plan named.\n   330\t\tbase, _, err := s.loadReviewProfile(plan.BaseProfile)\n   331\t\treturn err != nil || base.Independence == \"mandatory-human\"\n   332\t}\n   333\t\n   334\tfunc (s Store) milestoneExitGate(scope ScopeRef) string {\n   335\t\trm, err := s.GetRoadmap(scope.Roadmap)\n   336\t\tif err != nil {\n   337\t\t\treturn \"unknown\"\n   338\t\t}\n   339\t\tfor _, milestone := range rm.Milestones {\n   340\t\t\tif milestone.ID == scope.Milestone {\n   341\t\t\t\treturn strings.TrimSpace(milestone.ExitGate)\n   342\t\t\t}\n   343\t\t}\n   344\t\treturn \"unknown\"\n   345\t}\n   346\t\n   347\t// closeoutReviewGate is the one place the readers of an approval ask whether\n   348\t// an aggregate scope owes its own review under an adopted policy. It returns\n   349\t// the decision that governs the scope and whether its own review is dispensed.\n   350\t//\n   351\t// Order (spec pose-closeout-review-policy-by-cost-benefit, \"One evaluator and\n   352\t// precedence\"): a receipt already published decides by what it recorded, as\n   353\t// long as the scope it closed is still the scope; a roadmap closed before\n   354\t// adoption keeps its sealed contract (nil decision); an open scope is decided\n   355\t// now. A review recorded on the scope, required or not, is never bypassed: it\n   356\t// is verified as before and its veto stands. An unknown input never exempts.\n   357\tfunc (s Store) closeoutReviewGate(ref string, policy ReviewPolicy) (*CloseoutReviewDecision, bool, error) {\n   358\t\tif !policy.CloseoutReviewAdopted() {\n   359\t\t\treturn nil, false, nil\n   360\t\t}\n   361\t\tscope, err := ParseScopeRef(ref)\n   362\t\tif err != nil || (scope.Kind != \"milestone\" && scope.Kind != \"roadmap\") {\n   363\t\t\treturn nil, false, err\n   364\t\t}\n   365\t\treceipt, err := s.ReadCloseoutReceipt(ref)\n   366\t\tif err != nil {\n   367\t\t\treturn nil, false, err\n   368\t\t}\n   369\t\tif receipt != nil {\n   370\t\t\tif err := s.closeoutReceiptStands(*receipt, policy); err != nil {\n   371\t\t\t\treturn nil, false, err\n   372\t\t\t}\n   373\t\t\tdecision := receipt.Decision\n   374\t\t\treturn &decision, !decision.Required && !s.scopeReviewRecorded(ref), nil\n   375\t\t}\n   376\t\tif s.closeoutScopeHistorical(scope) || s.milestoneClosedBeforeAdoption(scope) {\n   377\t\t\treturn nil, false, nil\n   378\t\t}\n   379\t\tdecision, err := s.currentCloseoutDecision(ref, policy)\n   380\t\tif err != nil {\n   381\t\t\treturn nil, false, err\n   382\t\t}\n   383\t\treturn &decision, !decision.Required && decision.Known && !s.scopeReviewRecorded(ref), nil\n   384\t}\n   385\t\n   386\t// closeoutReceiptStands checks a receipt against the scope it closed: the\n   387\t// same canonical members. A receipt is never re-decided under a later policy,\n   388\t// but it does not carry over to a scope whose composition changed.\n   389\tfunc (s Store) closeoutReceiptStands(receipt CloseoutReceipt, policy ReviewPolicy) error {\n   390\t\t// The closed contract, read without the current policy: a later policy\n   391\t\t// never re-decides a receipt, but a scope whose composition or exit gate\n   392\t\t// changed is no longer the scope it closed.\n   393\t\tmembers, gate, diagnostics, err := s.closeoutSubject(receipt.Scope)\n   394\t\tif err != nil {\n   395\t\t\treturn fmt.Errorf(\"pose: closeout receipt of %s cannot be checked against its scope: %w\", receipt.Scope, err)\n   396\t\t}\n   397\t\tif len(diagnostics) > 0 {\n   398\t\t\treturn fmt.Errorf(\"pose: closeout receipt of %s cannot be checked against its scope: %s\", receipt.Scope, strings.Join(diagnostics, \"; \"))\n   399\t\t}\n   400\t\tdrift := func(what string) error {\n   401\t\t\treturn fmt.Errorf(\"pose: closeout receipt of %s no longer matches its scope: its %s changed since the close; a receipt is never rewritten, so restore it or record the change in a new scope\", receipt.Scope, what)\n   402\t\t}\n   403\t\tif strings.Join(members, \",\") != strings.Join(receipt.Decision.Members, \",\") {\n   404\t\t\treturn drift(fmt.Sprintf(\"members (closed with %v, now %v)\", receipt.Decision.Members, members))\n   405\t\t}\n   406\t\tif receipt.ExitGateDigest != gate {\n   407\t\t\treturn drift(\"exit gate\")\n   408\t\t}\n   409\t\treturn nil\n   410\t}\n   411\t\n   412\t// protectCloseoutDecision restores the review when the scope itself changes\n   413\t// the review contract: an exemption the diff introduced cannot exempt the diff.\n   414\t// The decision is made a second time under the policy at the change set's base\n   415\t// revision, and a stronger answer there wins. Protection that cannot be\n   416\t// established keeps the review required.\n   417\tfunc (s Store) protectCloseoutDecision(scope ScopeRef, decision *CloseoutReviewDecision) {\n   418\t\tguard := s.resolveReviewGovernanceGuard(scope)\n   419\t\tif len(guard.Paths) == 0 {\n   420\t\t\treturn\n   421\t\t}\n   422\t\trestore := func(reason string) {\n   423\t\t\tdecision.Required = true\n   424\t\t\tdecision.Reason += \"; \" + reason\n   425\t\t}\n   426\t\tif guard.Revision == \"\" {\n   427\t\t\trestore(\"the scope changes the review contract and no protected baseline resolves: \" + guard.Reason)\n   428\t\t\treturn\n   429\t\t}\n   430\t\tbase, err := s.parseReviewPolicyAt(guard.Revision)\n   431\t\tif err != nil {\n   432\t\t\trestore(\"the protected baseline policy cannot be read: \" + err.Error())\n   433\t\t\treturn\n   434\t\t}\n   435\t\tif !base.Enabled && !base.CloseoutReviewAdopted() {\n   436\t\t\treturn\n   437\t\t}\n   438\t\tif base.ReviewerIndependence[scope.Kind] == \"mandatory-human\" {\n   439\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires a mandatory-human review\")\n   440\t\t\treturn\n   441\t\t}\n   442\t\t// The baseline's base profile and every overlay it adopted for this kind,\n   443\t\t// selected or not: protection is the conservative reading.\n   444\t\trefs := append([]string{}, base.OverlayProfiles...)\n   445\t\tif ref := base.Profiles[scope.Kind]; ref != \"\" {\n   446\t\t\trefs = append(refs, ref)\n   447\t\t}\n   448\t\tfor _, ref := range refs {\n   449\t\t\tprofile, err := s.parseReviewProfileAt(guard.Revision, ref)\n   450\t\t\tif err != nil || (profile.Scope == scope.Kind || ref == base.Profiles[scope.Kind]) && profile.Independence == \"mandatory-human\" {\n   451\t\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires a mandatory-human review or a profile of it cannot be read\")\n   452\t\t\t\treturn\n   453\t\t\t}\n   454\t\t}\n   455\t\tif !base.CloseoutReviewAdopted() {\n   456\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" keeps the legacy rule, under which this scope owes its review\")\n   457\t\t\treturn\n   458\t\t}\n   459\t\tprotected, err := s.evaluateCloseoutReview(decision.Scope, base)\n   460\t\tif err != nil || protected.Required {\n   461\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires the review (\" + protected.PolicyKey + \"=\" + protected.PolicyValue + \")\")\n   462\t\t}\n   463\t}\n   464\t\n   465\t// closeoutSubject is what a closeout receipt binds: the canonical members of\n   466\t// the scope and, for a milestone, the digest of its exit gate (a roadmap's is\n   467\t// the gates of its milestones, which their own receipts bind).\n   468\tfunc (s Store) closeoutSubject(ref string) ([]string, string, []string, error) {\n   469\t\tscope, err := ParseScopeRef(ref)\n   470\t\tif err != nil {\n   471\t\t\treturn nil, \"\", nil, err\n   472\t\t}\n   473\t\tslug := scope.Roadmap\n   474\t\tif scope.Kind == \"roadmap\" {\n   475\t\t\tslug = scope.Slug\n   476\t\t}\n   477\t\trm, err := s.GetRoadmap(slug)\n   478\t\tif err != nil {\n   479\t\t\treturn nil, \"\", nil, err\n   480\t\t}\n   481\t\tproject, err := s.WriteProjectID()\n   482\t\tif err != nil {\n   483\t\t\treturn nil, \"\", []string{\"the project identity is unknown: \" + err.Error()}, nil\n   484\t\t}\n   485\t\tvar raws []string\n   486\t\tgate := \"\"\n   487\t\tfor _, milestone := range rm.Milestones {\n   488\t\t\tif scope.Kind == \"milestone\" && milestone.ID != scope.Milestone {\n   489\t\t\t\tcontinue\n   490\t\t\t}\n   491\t\t\traws = append(raws, milestone.Specs...)\n   492\t\t\tif scope.Kind == \"milestone\" {\n   493\t\t\t\tgate = digestText(milestone.ExitGate)\n   494\t\t\t}\n   495\t\t}\n   496\t\tif scope.Kind == \"roadmap\" {\n   497\t\t\t// A roadmap's gate is its cut criteria; its milestones' gates are\n   498\t\t\t// bound by their own receipts.\n   499\t\t\tcriteria, problems := ParseRoadmapCriteria(*rm)\n   500\t\t\traw, _ := json.Marshal(struct {\n   501\t\t\t\tCriteria []RoadmapCriterion\n   502\t\t\t\tProblems []string\n   503\t\t\t}{criteria, problems})\n   504\t\t\tgate = \"sha256:\" + digestHex(raw)\n   505\t\t}\n   506\t\tmembers, diagnostics := s.closeoutCanonicalMembers(raws, project)\n   507\t\treturn members, gate, diagnostics, nil\n   508\t}\n   509\t\n   510\t// closeoutScopeHistorical reports a scope whose roadmap was closed before\n   511\t// adoption: done, with no receipt and no close of this engine in progress,\n   512\t// and with positive evidence of its legacy closure: an approval recorded on\n   513\t// the roadmap, or the legacy rule exempting it as done before review\n   514\t// adoption. Status alone proves nothing.\n   515\t// Its milestones and itself are verified by the contract they were sealed\n   516\t// under, never re-evaluated, and no receipt is backfilled for them. A close\n   517\t// interrupted between its status and its receipt left an intent, so it stays\n   518\t// incomplete instead of reading as history.\n   519\tfunc (s Store) closeoutScopeHistorical(scope ScopeRef) bool {\n   520\t\tslug := scope.Slug\n   521\t\tif scope.Kind == \"milestone\" {\n   522\t\t\tslug = scope.Roadmap\n   523\t\t}\n   524\t\trm, err := s.GetRoadmap(slug)\n   525\t\tif err != nil || rm.Status != \"done\" {\n   526\t\t\treturn false\n   527\t\t}\n   528\t\tref := \"roadmap:\" + slug\n   529\t\tif receipt, err := s.ReadCloseoutReceipt(ref); err != nil || receipt != nil {\n   530\t\t\treturn false\n   531\t\t}\n   532\t\tpending, err := s.closeoutIntentPending(ref)\n   533\t\tif err != nil || pending {\n   534\t\t\treturn false\n   535\t\t}\n   536\t\tpolicy, _, err := s.loadReviewPolicy()\n   537\t\tif err != nil {\n   538\t\t\treturn false\n   539\t\t}\n   540\t\tif required, err := s.reviewRequiredForScope(ScopeRef{Kind: \"roadmap\", Slug: slug}, policy); err == nil && !required {\n   541\t\t\treturn true\n   542\t\t}\n   543\t\trecorded, refused, err := s.milestonesWithRecordedApproval([]string{ref})\n   544\t\treturn err == nil && recorded[ref] && !refused[ref]\n   545\t}\n   546\t\n   547\t// milestoneClosedBeforeAdoption reports a milestone with positive terminal\n   548\t// evidence from before adoption: its own approved review, sealed under a\n   549\t// policy that had not adopted the closeout pair. A milestone merely reached\n   550\t// has no such record and owes its close.\n   551\tfunc (s Store) milestoneClosedBeforeAdoption(scope ScopeRef) bool {\n   552\t\tif scope.Kind != \"milestone\" {\n   553\t\t\treturn false\n   554\t\t}\n   555\t\tref := scope.String()\n   556\t\trecorded, refused, err := s.milestonesWithRecordedApproval([]string{ref})\n   557\t\tif err != nil || !recorded[ref] || refused[ref] {\n   558\t\t\treturn false\n   559\t\t}\n   560\t\tlatest, err := s.latestBundlesOf([]string{ref})\n   561\t\tif err != nil || len(latest[ref]) == 0 {\n   562\t\t\treturn false\n   563\t\t}\n   564\t\tfor _, id := range latest[ref] {\n   565\t\t\tbundle, err := s.LoadReviewBundle(id)\n   566\t\t\tif err != nil || bundle.Payload.Plan.CloseoutReview != nil {\n   567\t\t\t\treturn false\n   568\t\t\t}\n   569\t\t}\n   570\t\treturn true\n   571\t}\n   572\t\n   573\t// closedByReceipt reports an aggregate scope its receipt still closes: the\n   574\t// receipt stands for the scope as it is, and no refusal was recorded on the\n   575\t// scope after it. It is what reached, attention and doctor ask, instead of\n   576\t// the mere presence of a receipt.\n   577\tfunc (s Store) closedByReceipt(ref string) (bool, error) {\n   578\t\treceipt, err := s.ReadCloseoutReceipt(ref)\n   579\t\tif err != nil || receipt == nil {\n   580\t\t\treturn false, err\n   581\t\t}\n   582\t\tpolicy, _, err := s.loadReviewPolicy()\n   583\t\tif err != nil {\n   584\t\t\treturn false, err\n   585\t\t}\n   586\t\tif s.closeoutReceiptStands(*receipt, policy) != nil {\n   587\t\t\treturn false, nil\n   588\t\t}\n   589\t\t// The applicable terminal verifier, as closeout asks it: the review, a\n   590\t\t// review recorded after the receipt included, the children and the gates.\n   591\t\tstate, err := s.getCloseoutState(ref, false)\n   592\t\tif err != nil {\n   593\t\t\treturn false, nil\n   594\t\t}\n   595\t\treturn state.Terminal, nil\n   596\t}\n   597\t\n   598\t// scopeReviewRecorded reports a review of the scope on file: a bundle or a\n   599\t// legacy attempt. A record that cannot be read counts as recorded, so an\n   600\t// unreadable rejection never turns into an exemption.\n   601\tfunc (s Store) scopeReviewRecorded(ref string) bool {\n   602\t\tbundles, err := s.ReadReviewBundles(ref)\n   603\t\tif err != nil || len(bundles.Bundles) > 0 || !bundles.Coverage.CompleteFor(ref) {\n   604\t\t\treturn true\n   605\t\t}\n   606\t\tattempts, err := s.ReadReviewAttempts(ref)\n   607\t\treturn err != nil || len(attempts.Attempts) > 0 || !attempts.Coverage.CompleteFor(ref)\n   608\t}\n   609\t\n   610\t// closeoutApprovalOrigin is the origin an exempt scope's approval reports.\n   611\tfunc closeoutApprovalOrigin(decision CloseoutReviewDecision) string {\n   612\t\treturn \"not-required:\" + decision.PolicyKey + \"=\" + decision.PolicyValue\n   613\t}\n   614\t\n   615\tfunc closeoutExemptionWarning(ref string, decision CloseoutReviewDecision) string {\n   616\t\treturn \"review: not-required for \" + ref + \" (\" + decision.PolicyKey + \"=\" + decision.PolicyValue + \", \" + decision.Reason + \"); `pose close \" + ref + \"` is still required\"\n   617\t}\n   618\t\n   619\t// CloseoutReviewOwing is an open aggregate scope that owes its own review under\n   620\t// the adopted policy and holds no recorded approval yet, for `pose doctor`.\n   621\ttype CloseoutReviewOwing struct {\n   622\t\tScope    string                 `json:\"scope\"`\n   623\t\tDecision CloseoutReviewDecision `json:\"decision\"`\n   624\t\t// Previous is the rule that applied before, when a recorded input shows\n   625\t\t// it; with no snapshot it says the comparison is unknown.\n   626\t\tPrevious string `json:\"previous\"`\n   627\t\tAction   string `json:\"action\"`\n   628\t}\n   629\t\n   630\t// CloseoutReviewsOwed lists the open milestones and roadmaps that, under the\n   631\t// adopted closeout review policy, owe a review they do not have. A legacy\n   632\t// policy returns nothing. Close remains the authoritative gate.\n   633\tfunc (s Store) CloseoutReviewsOwed() ([]CloseoutReviewOwing, error) {\n   634\t\tpolicy, _, err := s.loadReviewPolicy()\n   635\t\tif err != nil || !policy.CloseoutReviewAdopted() {\n   636\t\t\treturn nil, err\n   637\t\t}\n   638\t\troadmaps, err := s.ListRoadmaps()\n   639\t\tif err != nil {\n   640\t\t\treturn nil, err\n   641\t\t}\n   642\t\trefs := []string{}\n   643\t\tfor _, rm := range roadmaps {\n   644\t\t\tif s.closeoutScopeHistorical(ScopeRef{Kind: \"roadmap\", Slug: rm.Slug}) {\n   645\t\t\t\tcontinue\n   646\t\t\t}\n   647\t\t\tfor _, milestone := range rm.Milestones {\n   648\t\t\t\trefs = append(refs, \"milestone:\"+rm.Slug+\"/\"+milestone.ID)\n   649\t\t\t}\n   650\t\t\trefs = append(refs, \"roadmap:\"+rm.Slug)\n   651\t\t}\n   652\t\towing := []CloseoutReviewOwing{}\n   653\t\tfor _, ref := range refs {\n   654\t\t\tclosed, err := s.closedByReceipt(ref)\n   655\t\t\tif err != nil {\n   656\t\t\t\treturn nil, err\n   657\t\t\t}\n   658\t\t\tif closed {\n   659\t\t\t\tcontinue\n   660\t\t\t}\n   661\t\t\tdecision, err := s.currentCloseoutDecision(ref, policy)\n   662\t\t\tif err != nil {\n   663\t\t\t\treturn nil, err\n   664\t\t\t}\n   665\t\t\tif !decision.Required {\n   666\t\t\t\tcontinue\n   667\t\t\t}\n   668\t\t\t// A recorded approval counts only while it satisfies the current\n   669\t\t\t// obligation: fresh, for the scope as it is now.\n   670\t\t\tif eval, err := s.ReviewCheck(ref); err == nil && eval.Approved && eval.Fresh {\n   671\t\t\t\tcontinue\n   672\t\t\t}\n   673\t\t\taction := \"seal and review \" + ref + \" (`pose review bundle \" + ref + \" --seal`), then `pose close \" + ref + \"`\"\n   674\t\t\tif !decision.Known {\n   675\t\t\t\taction = \"resolve \" + strings.Join(decision.Diagnostics, \"; \")\n   676\t\t\t}\n   677\t\t\towing = append(owing, CloseoutReviewOwing{Scope: ref, Decision: decision, Previous: \"unknown: no snapshot of the earlier policy or composition is recorded\", Action: action})\n   678\t\t}\n   679\t\treturn owing, nil\n   680\t}\n   681\t\n   682\tfunc mustScope(ref string) ScopeRef {\n   683\t\tscope, _ := ParseScopeRef(ref)\n   684\t\treturn scope\n   685\t}\n","exit_code":0,"status":"completed"}}
