robe_test.go\\\").write_text(source)\n overlay={\\\"Replace\\\":{str(root/\\\"internal/pose/independent_review_probe_test.go\\\"):str(p/\\\"probe_test.go\\\")}}\n (p/\\\"overlay.json\\\").write_text(json.dumps(overlay))\n r=subprocess.run([\\\"go\\\",\\\"test\\\",\\\"-overlay\\\",str(p/\\\"overlay.json\\\"),\\\"./internal/pose\\\",\\\"-run\\\",\\\"\"'^TestIndependent\",\"-count=1\",\"-v\"],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)\n print(r.stdout)\n print(\"probe_exit=\"+str(r.returncode))\n'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
