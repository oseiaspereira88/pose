n_run_test.go:10:\t\t`{\"id\":\"b/go/ok\",\"module\":\"b\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\",\"carried_from\":\"aaaa\",\"carried_generated_at\":\"2026-11-21T09:00:00Z\"}]}`)\npose-mcp/internal/pose/delivery_validation_run_test.go:11:\tresults, err := ParseDeliveryValidationRun(raw, \".pose/results/delivery-validation.json\")\npose-mcp/internal/pose/delivery_surface.go:87:\t// MaterialProvenance binds the result to the material of each scope (ADR\npose-mcp/internal/pose/delivery_surface.go:89:\tMaterialProvenance map[string]string `json:\"material_provenance,omitempty\"`\npose-mcp/internal/pose/delivery_surface.go:625:\tif bound := result.MaterialProvenance[spec]; bound != \"\" {\npose-mcp/internal/pose/delivery_integrity_compact.go:46:\tMaterialProvenance map[string]string `json:\"material_provenance,omitempty\"`\npose-mcp/internal/pose/delivery_integrity_compact.go:165:\t\trun := compactValidationRun{GitHead: result.GitHead, GeneratedAt: result.GeneratedAt, ProvenanceDigest: result.ProvenanceDigest, Report: result.Report, ScopeProvenance: result.ScopeProvenance, MaterialProvenance: result.MaterialProvenance}\npose-mcp/internal/pose/delivery_integrity_compact.go:166:\t\tif run.GitHead != \"\" || run.GeneratedAt != \"\" || run.ProvenanceDigest != \"\" || run.Report != \"\" || len(run.ScopeProvenance) > 0 || len(run.MaterialProvenance) > 0 {\npose-mcp/internal/pose/delivery_integrity_compact.go:268:\t\t\tif len(run.MaterialProvenance) > 0 {\npose-mcp/internal/pose/delivery_integrity_compact.go:269:\t\t\t\texpanded.MaterialProvenance = make(map[string]string, len(run.MaterialProvenance))\npose-mcp/internal/pose/delivery_integrity_compact.go:270:\t\t\t\tfor spec, digest := range run.MaterialProvenance {\npose-mcp/internal/pose/delivery_integrity_compact.go:271:\t\t\t\t\texpanded.MaterialProvenance[spec] = digest\npose-mcp/internal/pose/delivery_integrity_cache_test.go:232:\t\tID: \"r\", ScopeProvenance: map[string]string{\"s\": \"a\"}, MaterialProvenance: map[string]string{\"s\": \"m\"},\npose-mcp/internal/pose/delivery_integrity_cache_test.go:236:\tout.ValidationResults[0].MaterialProvenance[\"s\"] = \"changed\"\npose-mcp/internal/pose/delivery_integrity_cache_test.go:237:\tif in.ValidationResults[0].ScopeProvenance[\"s\"] != \"a\" || in.ValidationResults[0].MaterialProvenance[\"s\"] != \"m\" {\npose-mcp/internal/pose/delivery_integrity_cache.go:189:\t\tresult.MaterialProvenance = copyStringMap(result.MaterialProvenance)\npose-mcp/internal/pose/delivery_surface_test.go:104:\tresults := []DeliveryValidationResult{{ID: \"alpha-integration\", Module: \"svc\", Check: \"integration\", EvidenceClass: \"integration\", Severity: \"required\", Outcome: \"pass\", GitHead: \"alpha-head\", ScopeProvenance: map[string]string{\"alpha\": alphaScoped}}}\npose-mcp/internal/pose/delivery_surface_test.go:148:\tresultRoot := DeliveryValidationResult{ID: \"val-root\", Module: \".\", Check: \"go-test\", EvidenceClass: \"integration\", Severity: \"required\", Outcome: \"pass\", GitHead: \"root-head\", ScopeProvenance: map[string]string{\"root-spec\": ScopedDeliveryProvenanceDigest(base, \"root-spec\")}}\npose-mcp/internal/pose/delivery_surface.go:82:\tGitHead          string            `json:\"git_head,omitempty\"`\npose-mcp/internal/pose/delivery_surface.go:652:\tif result.GitHead == \"\" {\npose-mcp/internal/pose/delivery_surface.go:656:\t\tif result.GitHead == set.Head || result.GitHead == set.ResolvedHead {\npose-mcp/internal/pose/delivery_surface.go:660:\t\t\tif result.GitHead == commit {\npose-mcp/internal/pose/delivery_integrity_compact_test.go:90:\t\tif result.ScopeProvenance[\"spec-03\"] == \"\" || result.GitHead != \"abc123\" || result.Report == \"\" {\npose-mcp/internal/pose/delivery_integrity_compact.go:41:\tGitHead            string            `json:\"git_head,omitempty\"`\npose-mcp/internal/pose/delivery_integrity_compact.go:165:\t\trun := compactValidationRun{GitHead: result.GitHead, GeneratedAt: result.GeneratedAt, ProvenanceDigest: result.ProvenanceDigest, Report: result.Report, ScopeProvenance: result.ScopeProvenance, MaterialProvenance: result.MaterialProvenance}\npose-mcp/internal/pose/delivery_integrity_compact.go:259:\t\t\texpanded.GitHead, expanded.GeneratedAt, expanded.ProvenanceDigest, expanded.Report = run.GitHead, run.GeneratedAt, run.ProvenanceDigest, run.Report\npose-mcp/internal/pose/delivery_validation_run_test.go:21:\t\t\tif r.GitHead != \"bbbb\" || r.GeneratedAt != \"2026-11-22T10:00:00Z\" {\npose-mcp/internal/pose/delivery_validation_run_test.go:22:\t\t\t\tt.Fatalf(\"executed check read as %s at %s\", r.GitHead, r.GeneratedAt)\npose-mcp/internal/pose/delivery_validation_run_test.go:25:\t\t\tif r.GitHead != \"aaaa\" || r.GeneratedAt != \"2026-11-21T09:00:00Z\" {\npose-mcp/internal/pose/delivery_validation_run_test.go:26:\t\t\t\tt.Fatalf(\"carried check read as %s at %s, want the head it ran at\", r.GitHead, r.GeneratedAt)\npose-mcp/internal/pose/delivery_validation_run.go:20:\t\tGitHead            string            `json:\"git_head,omitempty\"`\npose-mcp/internal/pose/delivery_validation_run.go:49:\t\tresults = append(results, DeliveryValidationResult{ID: check.ID, Module: check.Module, Check: check.Name, EvidenceClass: check.EvidenceClass, Severity: check.Severity, Outcome: check.Outcome, GitHead: head, GeneratedAt: generated, ProvenanceDigest: run.ProvenanceDigest, ScopeProvenance: run.ScopeProvenance, MaterialProvenance: run.MaterialProvenance, Report: relative})\n# Adversarial corpus\n\nSpec: `pose-mechanization-adversarial-corpus`. Test: `adversarial_corpus_test.go`.\n\nEvery gate POSE adds against mechanical compliance can itself be satisfied\nmechanically. Each row is the cheapest formal satisfaction of one gate. An\n`enforced` case fails the build when the shortcut works again; a `known-gap`\ncase fails the build when the gap closes, so it cannot close or reopen\nsilently; a `planned` case belongs to a spec not yet delivered and gains code\nbefore that spec closes; a `delegated` case is enforced by a test in another\npackage, named in the row, whose existence the corpus checks.\n\nThis corpus belongs to developing POSE's governance. It adds no checklist to an\nadopting project's features.\n\n| Case | Status | Shortcut it refuses | Owner |\n|---|---|---|---|\n| `human-label-without-confirmation` | enforced | An agent writes and applies a review under `human:<name>`; the record reads as a human review | pose-review-attribution-roles |\n| `declared-independent-prefix` | enforced | `agent:independent-*` under declared assurance reads as authenticated separation | pose-review-assurance-disclosure |\n| `confirmation-reused-for-edited-content` | enforced | A confirmation recorded for one set of conclusions is kept after they change | pose-review-attribution-roles |\n| `unknown-recorded-as-satisfied` | enforced | An obligation the engine could not observe is reported as satisfied | pose-obligation-contract |\n| `legacy-blocker-gains-an-actor` | enforced | A blocker known only as text is given an invented recipient | pose-obligation-contract |\n| `blocked-counted-as-resolved` | enforced | Operational waiting counts as a resolved outcome in success metrics | pose-blocked-semantics-alignment |\n| `flat-specs-share-one-journal` | enforced | Two flat specs record amendments in one shared journal | pose-flat-spec-amendments |\n| `local-metadata-read-as-published` | enforced | A locally read version is presented as a proven publication | pose-public-claims-publication-provenance |\n| `invented-trace-test-ref` | known-gap | A requirement trace cites a test that does not exist and `lint-spec --strict` passes (follow-up 097 of pose-abm-design-basis) | pose-mechanization-adversarial-corpus |\n| `unavailable-producer-reads-as-empty` | enforced | A producer fails and Attention reports zero obligations as a complete answer | pose-obligation-projection |\n| `trivial-change-raises-a-request` | enforced | A trivial change or an already-authorized instruction produces an ActionRequest | pose-action-requests |\n| `declined-approval-satisfies` | enforced | A declined approval, or a cancellation without authority, releases a gate | pose-action-request-resolution |\n| `closeout-plan-fills-judgment` | enforced | The recoverable closeout plan answers a judgment criterion to finish | pose-recoverable-closeout-plan |\n| `ready-from-absent-blockers` | enforced | Absence of a known blocker is presented as proven independence | pose-phase-scoped-readiness |\n| `stale-preview-authorizes-apply` | enforced | A start previewed before a restricting request is applied after it | pose-governed-effect-enforcement |\n| `code-change-keeps-judgment` | enforced | The reviewed code changes and every criterion still reads as equivalent, so the old judgment is reused | pose-material-equivalence-reuse |\n| `minimal-surface-skips-trace` | enforced | A done spec declares the minimal surface to drop its requirement trace | pose-progressive-spec-surface |\n| `stale-assessment-reused` | enforced | The assessed component changes and the old assessment still reads as fresh | pose-adaptive-assessment-freshness |\n| `unpinned-premise-trigger-reads-current` | enforced | A premise trigger without a pin can never go stale and nothing says so | pose-assumption-validity-scope |\n| `calendar-ttl-as-premise-trigger` | enforced | An arbitrary expiry date is accepted as the material trigger of a premise | pose-assumption-validity-scope |\n| `unobserved-falsifier-reads-uncontradicted` | enforced | An unbound legacy index cannot prove that a falsifier check was never observed | pose-falsifier-reconsideration |\n| `parity-row-cites-an-unrelated-test` | known-gap | A launcher parity row names a real but unrelated `pose delegate` command and an existing test that does not exercise the capability, and the parity check passes; the check proves existence, review of the cited tests proves coverage | pose-delegation-parity-gate |\n| `imported-fragment-completes-a-replaced-command` | known-gap | A usage or error string assembles a removed command from a constant of another package of the module, which the active-document check reads as a gap; review of assembled messages is the defence | pose-delegation-parity-gate |\n| `cgo-preamble-text-reaches-usage` | known-gap | Operator text written as a C string in a cgo preamble reaches a usage surface; the Go reader sees a comment, not a string | pose-delegation-parity-gate |\n| `later-removal-hides-a-later-touch` | delegated | A later removal satisfies an earlier spec's claim because the history it is judged on omits that spec's change after the removal — change sets in ID order, a merge, root or type-change touch, a failed or shallow read, a recorded report too wide to read whole or a history directory that cannot be listed, a replace ref or graft (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_gaps_test.go:TestLaterRemovalReviewRoundTwo`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundFive`) | pose-delivery-later-removal |\n| `rename-read-as-removal` | delegated | A rename, or a path spelled as a pathspec, is taken for the declared deletion (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`) | pose-delivery-later-removal |\n| `recorded-commit-is-an-option` | delegated | A change set read from a recorded report names a Git option or a tag where a commit belongs (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`) | pose-delivery-later-removal |\n| `peer-removal-stands-for-a-member` | delegated | A review subject digests a removed path from a peer's accepted removal while another observing member — sorted later, sharing a commit, or reduced into the peer's set — has none, whatever action or rename it observed the path with (`pose/review_subject_later_removal_test.go:TestReviewSubjectReadsALaterRemovalFromItsWitness`, `pose/review_subject_later_removal_test.go:TestMilestoneSubjectRemovalHoldsForEveryMember`) | pose-review-subject-later-removal |\n| `retained-child-skips-its-verification` | delegated | A milestone seals over a done member whose own review verification no longer retains its approval — revoked federated trust, lost history, a later negative review (`pose/review_subject_later_removal_test.go:TestRetainedChildFollowsItsVerification`, `pose/review_subject_later_removal_test.go:TestMilestoneSealRetainsADoneChildsApprovedReview`) | pose-review-subject-later-removal |\n| `run-pattern-names-no-test` | delegated | A validation check's `-run` alternative names a test that no longer exists, or never did, and the check passes on Go's exit 0 — through `-run=`, a build-excluded or ignored file, a vendored or nested-module declaration, a benchmark or a name Go does not run (`cli/validation_matrix_patterns_test.go:TestDeadRunPatternGuardFollowsGoSelection`, `cli/validation_matrix_patterns_test.go:TestValidationMatrixRunPatternsNameExistingTests`); a non-plain pattern passes only when listed with its reason | pose-validation-matrix-dead-test-patterns |\n| `removal-witness-outlives-its-history` | delegated | A stale index keeps counting a removal after a later touch, through a merge, a rewritten history or a shallow clone that lost the touch (`pose/removal_witness_freshness_test.go:TestLaterTouchRefusesTheWitness`, `pose/removal_witness_freshness_test.go:TestShallowHistoryRefusesTheWitness`) | pose-removal-witness-freshness |\n| `parent-outlives-a-rejected-child` | delegated | A milestone or roadmap stays approved over a child's later rejection, through retention, a sealed cycle, a replaced approval or a forged `replaces` (`pose/review_approval_follows_children_test.go:TestParentApprovalFollowsAChildsRejection`, `pose/review_approval_follows_children_test.go:TestChildCycleEndsInARefusal`, `pose/review_approval_follows_children_test.go:TestForgedReplacementRetiresNothing`, `pose/review_approval_follows_children_test.go:TestLegacyCoordinatedMatchingFollowsLineage`) | pose-review-approval-follows-children |\n| `go-check-ran-no-test` | delegated | A `go test` check selects nothing and passes on Go's exit 0, through a flag spelling, a flag's value read as a flag, or a package without test files (`cli/validate_empty_go_checks_test.go:TestValidateRefusesAGoCheckThatRanNoTest`, `cli/validate_empty_go_checks_test.go:TestGoTestSelection`); a check outside the plain grammar passes unjudged, and a test printing a result line can still mislead it | pose-validate-refuses-empty-go-checks |\n| `request-opened-after-preview-transfers` | delegated | A request opened after a transfer preview is moved with the spec (`pose/spec_transfer_actions_test.go:TestTransferRefusesARequestOpenedAfterThePreview`) | pose-transfer-preserves-obligations |\n\n| `deleted-reservation-resets-quota` | delegated | Deleting a reservation and receipt makes a surviving run stop consuming quota | pose-delegated-review-attempt-ledger |\n| `witness-bundle-filter-hides-loss` | delegated | Editing a witness bundle makes scoped readers skip its corruption | pose-delegated-review-attempt-ledger |\n| `window-erases-rerun` | delegated | Moving a prior run outside the time window turns a rerun into a first attempt | pose-delegated-review-attempt-ledger |\n| `canned-executor-approval-proves-cognition` | delegated | A complete canned approval from a trusted local command is presented as proof of review cognition or a vendor receipt (`cli/delegated_review_capability_test.go:TestDelegatedReviewCapabilityCannedApprovalDisclosesItsLimits` guards disclosure; the engine cannot detect canned judgments) | pose-delegated-review-capability |\n| `oversized-writer-publishes-unreadable-run` | delegated | A writer reports completion for a run its bounded reader immediately refuses | pose-delegated-review-attempt-ledger |\n11199ce4 chore(pose): index the round-10 review binding\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,245p' pose-mcp/internal/cli/validate_carry.go; git diff dec2e64..97e70de -- pose-mcp/internal/cli/validate.go pose-mcp/internal/cli/validate_results.go pose-mcp/internal/pose/delivery_validation_run.go; pose artifact-check --spec pose-validate-carries-unchanged-checks --strict\"","aggregated_output":"package cli\n\n// Carried checks (spec pose-validate-carries-unchanged-checks): with a\n// comparable canonical result as base, validate --carry runs the modules the\n// changed scope selects between the base head and HEAD and carries the base\n// results of every other module, each stating the head it ran at. Any doubt\n// about the base runs everything and records why (R2).\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"runtime/debug\"\n\t\"sort\"\n\t\"strings\"\n\t\"unicode\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n)\n\n// carryRecord is the run's account of its base (R5).\ntype carryRecord struct {\n\tUsed     bool              `json:\"used\"`\n\tReason   string            `json:\"reason,omitempty\"`\n\tBaseHead string            `json:\"base_head,omitempty\"`\n\tChanged  int               `json:\"changed\"`\n\tSelected map[string]string `json:\"selected,omitempty\"`\n}\n\n// carryPlan is what a usable base lets the run reuse.\ntype carryPlan struct {\n\trecord    *carryRecord\n\tselection *scopeSelection\n\tbase      map[string]checkResult\n\tbaseHead  string\n\tbaseTime  string\n}\n\n// carried reports whether module's checks come from the base.\nfunc (p carryPlan) carried(module string) bool {\n\tif p.selection == nil {\n\t\treturn false\n\t}\n\t_, selected := p.selection.Selected[module]\n\treturn !selected\n}\n\n// carriedResult is the base result of a check as this run records it (R4):\n// unchanged, plus where and when it really ran, kept through chained carries.\nfunc (p carryPlan) carriedResult(id string) checkResult {\n\tresult := p.base[id]\n\tif result.CarriedFrom == \"\" {\n\t\tresult.CarriedFrom, result.CarriedGeneratedAt = p.baseHead, p.baseTime\n\t}\n\treturn result\n}\n\n// planCarry judges the canonical result at resultsPath as a base. A nil\n// selection means every check runs; the record says why.\nfunc planCarry(root, resultsPath, mode, matrixSHA, head string, matrix validationMatrix, modules []validationModule) carryPlan {\n\tplan := carryPlan{record: &carryRecord{}}\n\tengine, engineVerifiable := engineIdentityFrom(debug.ReadBuildInfo())\n\tunused := func(format string, args ...any) carryPlan {\n\t\tplan.record.Reason = fmt.Sprintf(format, args...)\n\t\treturn plan\n\t}\n\traw, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(resultsPath)))\n\tif err != nil {\n\t\treturn unused(\"no canonical result at %s\", resultsPath)\n\t}\n\tvar base validationRunResult\n\tif err := json.Unmarshal(raw, &base); err != nil || base.SchemaVersion != validationResultSchema {\n\t\treturn unused(\"the canonical result is unreadable or has another schema\")\n\t}\n\tswitch {\n\tcase base.ModuleFilter != \"\" || base.StackFilter != \"\":\n\t\treturn unused(\"the canonical result was filtered by module or stack, so it is not comparable\")\n\tcase base.Mode != mode:\n\t\treturn unused(\"the canonical result ran in mode %q, this run is %q\", base.Mode, mode)\n\tcase base.MatrixSHA256 != matrixSHA:\n\t\treturn unused(\"the validation matrix changed since the canonical result\")\n\tcase !engineVerifiable:\n\t\treturn unused(\"this engine build was modified from its recorded revision, so its identity cannot be compared\")\n\tcase base.EngineVersion == \"\" || base.EngineVersion != engine || strings.HasSuffix(base.EngineVersion, \".dirty\"):\n\t\treturn unused(\"the engine version differs from the canonical result's or was not recorded\")\n\tcase base.GitHead == \"\" || !safeGitRevRE.MatchString(base.GitHead):\n\t\treturn unused(\"the canonical result records no usable head\")\n\tcase head == \"\" || !safeGitRevRE.MatchString(head):\n\t\treturn unused(\"the current head cannot be read\")\n\t}\n\tfor _, check := range base.Checks {\n\t\tif check.LimitState == \"cancelled\" {\n\t\t\treturn unused(\"the canonical result was cancelled\")\n\t\t}\n\t}\n\t// The base must have validated the commit it records: a run over a working\n\t// copy that differed from its head proves nothing about that head.\n\tif !base.MaterialClean {\n\t\treturn unused(\"the canonical result did not validate a clean working copy of its head\")\n\t}\n\tfor _, binding := range base.MaterialProvenance {\n\t\tif binding == posemodel.MaterialBindingUnavailable {\n\t\t\treturn unused(\"the canonical result records an unavailable material binding\")\n\t\t}\n\t}\n\tif !materialWorktreeClean(root) {\n\t\treturn unused(\"the working copy differs from HEAD in material paths\")\n\t}\n\t// Selection is lexical: a module reached through a symlink aliases another\n\t// path, so its inputs cannot be told apart (review round 4, N9).\n\t// Two modules sharing one physical directory (a case alias on a\n\t// case-insensitive filesystem) alias each other too (review round 5, N13).\n\tif reason := aliasedModule(modules, filepath.EvalSymlinks, os.Stat); reason != \"\" {\n\t\treturn unused(\"%s\", reason)\n\t}\n\t// Lexical selection cannot see through aliases. Rather than chase every\n\t// alias form (review rounds 4–7, N9, N13, N16–N18), a carry needs a\n\t// case-sensitive filesystem and no tracked symlink that links a module\n\t// (other than the root) or a declared dependency with any other path.\n\tmeta, err := loadScopeMetadata(root)\n\tif err != nil {\n\t\treturn unused(\"changed-scope selection failed: %v\", err)\n\t}\n\t// Symlinks inside a submodule hide behind its gitlink (review round 8,\n\t// N20): scan each checked-out submodule at its recorded commit, and refuse\n\t// when a module or a dependency lies in one that cannot be scanned.\n\tif reason, err := submoduleAliases(root, head, modules, meta); err != nil {\n\t\treturn unused(\"submodules cannot be read: %v\", err)\n\t} else if reason != \"\" {\n\t\treturn unused(\"%s\", reason)\n\t}\n\tif link, err := aliasingSymlink(root, head, modules, meta); err != nil {\n\t\treturn unused(\"tracked symlinks cannot be read: %v\", err)\n\t} else if link != \"\" {\n\t\treturn unused(\"the tree tracks symlink %s into or out of a module or a declared dependency, so changes cannot be attributed\", link)\n\t}\n\tif caseInsensitiveFilesystem(root, os.Stat) {\n\t\treturn unused(\"the filesystem is case-insensitive, so changes cannot be attributed to modules\")\n\t}\n\t// A case-folded directory inside a case-sensitive filesystem is an alias\n\t// too (review round 8, N22).\n\tfor _, dir := range carryRelevantDirs(root, modules, meta) {\n\t\tif casefoldedDirectory(dir, os.ReadDir, os.Stat) {\n\t\t\treturn unused(\"directory %s folds case, so changes cannot be attributed to modules\", dir)\n\t\t}\n\t}\n\t// Check ids must be unique: two checks sharing an id would share one base\n\t// result (review round 7, N19).\n\tif id := duplicateCheckID(matrix, modules); id != \"\" {\n\t\treturn unused(\"the matrix defines check %s more than once\", id)\n\t}\n\tbaseIDs := map[string]bool{}\n\tfor _, check := range base.Checks {\n\t\tif baseIDs[check.ID] {\n\t\t\treturn unused(\"the canonical result records check %s more than once\", check.ID)\n\t\t}\n\t\tbaseIDs[check.ID] = true\n\t}\n\tif err := posemodel.RawGit(\"-C\", root, \"merge-base\", \"--is-ancestor\", base.GitHead, head).Run(); err != nil {\n\t\treturn unused(\"the canonical result's head %s is not an ancestor of HEAD\", base.GitHead)\n\t}\n\tselection, err := computeChangedScope(root, base.GitHead, head, modules, carryExclusions(root, base.GitHead, head, resultsPath)...)\n\tif err != nil {\n\t\treturn unused(\"changed-scope selection failed: %v\", err)\n\t}\n\tplan.base = map[string]checkResult{}\n\tfor _, check := range base.Checks {\n\t\tplan.base[check.ID] = check\n\t}\n\t// A module whose checks are not all in the base runs (R3).\n\tfor _, module := range modules {\n\t\tif _, selected := selection.Selected[module.Rel]; selected {\n\t\t\tcontinue\n\t\t}\n\t\tstack, checks, _ := moduleValidationChecks(module, matrix, \"\", \"\")\n\t\tfor _, check := range checks {\n\t\t\tif check.Program == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n\t\t\tif prior, ok := plan.base[id]; !ok || prior.Outcome == \"skipped\" || prior.Outcome == \"\" {\n\t\t\t\tselection.Selected[module.Rel] = \"carry: no prior result for \" + id\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\tplan.selection, plan.baseHead, plan.baseTime = &selection, base.GitHead, base.GeneratedAt\n\tplan.record.Used, plan.record.BaseHead, plan.record.Changed, plan.record.Selected = true, base.GitHead, len(selection.Changed), selection.Selected\n\treturn plan\n}\n\n// carryExclusions are the changed paths that are not changes for the carry\n// selection (R3): the canonical result itself and the derived administrative\n// records of the engine's closed list (the same classes material bindings\n// ignore) that are still regular files, or gone, at HEAD. A symlink,\n// submodule or directory in a class stays a change.\nfunc carryExclusions(root, base, head, resultsPath string) []string {\n\texclude := []string{resultsPath}\n\tout, err := posemodel.RawGit(\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base, head, \"--\").Output()\n\tif err != nil {\n\t\treturn exclude\n\t}\n\tfor _, file := range strings.Split(string(out), \"\\x00\") {\n\t\tfile = filepath.ToSlash(file)\n\t\tif file == \"\" || !posemodel.IsAdministrativePath(file) {\n\t\t\tcontinue\n\t\t}\n\t\tentry, err := posemodel.RawGit(\"-C\", root, \"ls-tree\", \"-z\", head, \"--\", file).Output()\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tfields := strings.Fields(string(entry))\n\t\tif len(fields) == 0 || fields[0] == \"100644\" || fields[0] == \"100755\" {\n\t\t\texclude = append(exclude, file)\n\t\t}\n\t}\n\treturn exclude\n}\n\n// validationEngineIdentity names the engine that ran a validation: its version\n// plus, when the binary records it, the VCS revision it was built from, marked\n// when the build tree was modified. Development builds share a version string,\n// so the revision is what tells two of them apart (R2).\nfunc validationEngineIdentity() string {\n\tidentity, _ := engineIdentityFrom(debug.ReadBuildInfo())\n\treturn identity\n}\n\n// engineIdentityFrom builds the identity from build information. A build of a\n// modified tree is not verifiable: two such builds at one revision share an\n// identity while their code differs (review round 2, N4).\nfunc engineIdentityFrom(info *debug.BuildInfo, ok bool) (string, bool) {\n\tidentity := version.Version\n\tif !ok || info == nil {\n\t\treturn identity, true\n\t}\n\trevision, modified := \"\", false\n\tfor _, setting := range info.Settings {\n\t\tswitch setting.Key {\n\t\tcase \"vcs.revision\":\n\t\t\trevision = setting.Value\n\t\tcase \"vcs.modified\":\ndiff --git a/pose-mcp/internal/cli/validate.go b/pose-mcp/internal/cli/validate.go\nindex 1ed4d9a5..6658e7a5 100644\n--- a/pose-mcp/internal/cli/validate.go\n+++ b/pose-mcp/internal/cli/validate.go\n@@ -65,7 +65,10 @@ type validationEntry struct {\n \tskip     string\n \tsilent   bool\n \tisolated bool\n-\tresult   checkResult\n+\t// carried marks a check whose result comes from the canonical base (spec\n+\t// pose-validate-carries-unchanged-checks R4); it is silent and never runs.\n+\tcarried bool\n+\tresult  checkResult\n \tdone     chan struct{}\n }\n \n@@ -905,6 +908,7 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \tverbose := false\n \tautoReport := false\n \trootOnly := false\n+\tcarry := false\n \tworkspac