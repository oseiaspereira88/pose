{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\n# In-memory probe of the early-return branch in casefoldedDirectory.\n# shared is case-folded, shared/a is case-sensitive; a dangling\n# unowned link sorts before a. This is not a filesystem integration test.\nentries = ['0-dangling', 'a']\nlookups = []\ndef stat(name):\n    lookups.append(name)\n    if name.lower() == '0-dangling':\n        raise FileNotFoundError(name)\n    if name.lower() == 'a':\n        return 'same-directory'\n    raise FileNotFoundError(name)\ndef probe():\n    for name in entries:\n        swapped = name.swapcase()\n        if swapped == name:\n            continue\n        try:\n            original = stat(name)\n        except FileNotFoundError:\n            return False\n        try:\n            other = stat(swapped)\n        except FileNotFoundError:\n            return False\n        return original == other\n    return False\nprint({'detected_casefold': probe(), 'lookups': lookups, 'actual_casefold': stat('a') == stat('A')})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\n# In-memory probe of the early-return branch in casefoldedDirectory.\n# shared is case-folded, shared/a is case-sensitive; a dangling\n# unowned link sorts before a. This is not a filesystem integration test.\nentries = ['0-dangling', 'a']\nlookups = []\ndef stat(name):\n    lookups.append(name)\n    if name.lower() == '0-dangling':\n        raise FileNotFoundError(name)\n    if name.lower() == 'a':\n        return 'same-directory'\n    raise FileNotFoundError(name)\ndef probe():\n    for name in entries:\n        swapped = name.swapcase()\n        if swapped == name:\n            continue\n        try:\n            original = stat(name)\n        except FileNotFoundError:\n            return False\n        try:\n            other = stat(swapped)\n        except FileNotFoundError:\n            return False\n        return original == other\n    return False\nprint({'detected_casefold': probe(), 'lookups': lookups, 'actual_casefold': stat('a') == stat('A')})\nPY\"","aggregated_output":"{'detected_casefold': False, 'lookups': ['0-dangling', 'a', 'A'], 'actual_casefold': True}\n","exit_code":0,"status":"completed"}}
