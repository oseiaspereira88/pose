{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'func IsAdministrativePath|module-metadata|moduleChecks|Mode.*advisory|Mode.*strict' pose-mcp/internal/pose/material* pose-mcp/internal/cli/validate.go; sed -n '235,325p' pose-mcp/internal/cli/validate_results.go; sed -n '1190,1335p' pose-mcp/internal/cli/validate.go; sed -n '780,940p' pose-mcp/internal/cli/validate_carry_test.go; git status --short\"","aggregated_output":"pose-mcp/internal/pose/material_binding.go:36:func IsAdministrativePath(p string) bool {\nfunc publishCanonicalValidationJSON(root, relative, expectedPolicyPath string, run validationRunResult) error {\n\treturn publishCanonicalValidationJSONIn(cliGovernedStore(root), relative, expectedPolicyPath, run)\n}\n\nfunc publishCanonicalValidationJSONIn(store posemodel.Store, relative, expectedPolicyPath string, run validationRunResult) error {\n\treturn store.WithGovernanceWriteGuardForProjects(\"validate.publish-results\", nil, func(store posemodel.Store) error {\n\t\tpolicy, err := posemodel.LoadDeliveryPolicyIn(store.FS, store.Root)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tcurrentPath := normalizeValidationOutputPath(policy.ResultsPath)\n\t\tif currentPath == \"\" || currentPath != expectedPolicyPath || currentPath != normalizeValidationOutputPath(relative) {\n\t\t\treturn fmt.Errorf(\"configured delivery results path changed before publication; nothing was written\")\n\t\t}\n\t\tpayload, err := marshalValidationJSON(run)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\ttarget := filepath.Join(store.Root, filepath.FromSlash(currentPath))\n\t\tif err := store.FS.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn store.FS.Publish(target, payload, 0o644, posemodel.PublishAuthoritative, posemodel.PublishExpectation{Mode: posemodel.ExpectAny})\n\t})\n}\n\n// --- JUnit projection -------------------------------------------------------\n// Mapping: one <testsuite> per module, one <testcase> per check. POSE\n// \"error\" maps to <error> (infrastructure), \"fail\" to <failure>, \"skipped\"\n// to <skipped> with the deterministic reason. Optional-severity failures are\n// still <failure> — JUnit has no tolerated level, so the POSE severity is\n// preserved in the testcase classname suffix (documented lossy edge).\n\ntype junitTestCase struct {\n\tXMLName   xml.Name      `xml:\"testcase\"`\n\tName      string        `xml:\"name,attr\"`\n\tClassName string        `xml:\"classname,attr\"`\n\tTime      string        `xml:\"time,attr\"`\n\tFailure   *junitMessage `xml:\"failure,omitempty\"`\n\tError     *junitMessage `xml:\"error,omitempty\"`\n\tSkipped   *junitMessage `xml:\"skipped,omitempty\"`\n}\n\ntype junitMessage struct {\n\tMessage string `xml:\"message,attr\"`\n\tBody    string `xml:\",chardata\"`\n}\n\ntype junitSuite struct {\n\tXMLName  xml.Name        `xml:\"testsuite\"`\n\tName     string          `xml:\"name,attr\"`\n\tTests    int             `xml:\"tests,attr\"`\n\tFailures int             `xml:\"failures,attr\"`\n\tErrors   int             `xml:\"errors,attr\"`\n\tSkipped  int             `xml:\"skipped,attr\"`\n\tCases    []junitTestCase `xml:\"testcase\"`\n}\n\ntype junitSuites struct {\n\tXMLName xml.Name     `xml:\"testsuites\"`\n\tName    string       `xml:\"name,attr\"`\n\tSuites  []junitSuite `xml:\"testsuite\"`\n}\n\nfunc writeValidationJUnit(path string, run validationRunResult) error {\n\tbyModule := map[string]*junitSuite{}\n\tvar order []string\n\tfor _, c := range run.Checks {\n\t\tsuite, ok := byModule[c.Module]\n\t\tif !ok {\n\t\t\tsuite = &junitSuite{Name: c.Module}\n\t\t\tbyModule[c.Module] = suite\n\t\t\torder = append(order, c.Module)\n\t\t}\n\t\ttc := junitTestCase{\n\t\t\tName:      c.Name,\n\t\t\tClassName: \"pose-validate.\" + c.Stack + \".\" + c.Severity,\n\t\t\tTime:      fmt.Sprintf(\"%.3f\", c.DurationSeconds),\n\t\t}\n\t\tswitch c.Outcome {\n\t\tcase \"fail\":\n\t\t\tsuite.Failures++\n\t\t\ttc.Failure = &junitMessage{Message: c.Program + \" exited non-zero\", Body: c.Output}\n\t\tcase \"error\":\n\t\t\tsuite.Errors++\n\t\t\ttc.Error = &junitMessage{Message: c.Program + \" could not run\", Body: c.Output}\n\t\tcase \"skipped\":\n\t\t\tsuite.Skipped++\n\t\t\ttc.Skipped = &junitMessage{Message: c.SkipReason}\n\t\t}\n\t\tsuite.Tests++\n\t\t\t\t\trun.MaterialProvenance = map[string]string{}\n\t\t\t\t}\n\t\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n\t\t\t} else if material, ok := posemodel.MaterialBinding(graph, spec); ok {\n\t\t\t\tif run.MaterialProvenance == nil {\n\t\t\t\t\trun.MaterialProvenance = map[string]string{}\n\t\t\t\t}\n\t\t\t\trun.MaterialProvenance[spec] = material\n\t\t\t}\n\t\t}\n\t}\n\tfailures := 0\n\toptionalFailures := 0\n\texecuted := 0\n\tr := render(stdout, stderr)\n\tr.SetVerbose(verbose)\n\t// The counter needs the whole plan up front, so the checks a module runs are\n\t// resolved by one helper called twice: counting here, executing below. A\n\t// second copy of the filter logic would drift from this one.\n\tplanned := 0\n\tfor _, module := range modules {\n\t\t_, checks, selected := moduleValidationChecks(module, matrix, stackFilter, moduleFilter)\n\t\tif !selected {\n\t\t\tcontinue\n\t\t}\n\t\tif scope != nil {\n\t\t\tif _, inScope := scope.Selected[module.Rel]; !inScope {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif carryState.carried(module.Rel) {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, check := range checks {\n\t\t\tif check.Program != \"\" {\n\t\t\t\tplanned++\n\t\t\t}\n\t\t}\n\t}\n\tsteps := r.Steps(planned)\n\tvar entries []*validationEntry\n\tfor _, module := range modules {\n\t\toverride := matrix.ModuleOverrides[module.Rel]\n\t\tstack := module.Stack\n\t\tif override.Stack != \"\" {\n\t\t\tstack = override.Stack\n\t\t}\n\t\tif stackFilter != \"\" && stack != stackFilter || moduleFilter != \"\" && module.Rel != moduleFilter {\n\t\t\tcontinue\n\t\t}\n\t\tchecks := append([]validationCheck(nil), matrix.Stacks[stack].Checks...)\n\t\tif override.ReplaceDefaultChecks {\n\t\t\tchecks = nil\n\t\t}\n\t\tchecks = append(checks, override.Checks...)\n\t\tif scope != nil {\n\t\t\tif _, selected := scope.Selected[module.Rel]; !selected {\n\t\t\t\t// R3: every unselected check keeps a machine-readable reason.\n\t\t\t\treason := \"changed-scope: module not affected by \" + scope.rangeLabel()\n\t\t\t\tfor _, check := range checks {\n\t\t\t\t\tif check.Program == \"\" {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tseverity := check.Severity\n\t\t\t\t\tif severity == \"\" {\n\t\t\t\t\t\tseverity = \"required\"\n\t\t\t\t\t}\n\t\t\t\t\tentries = append(entries, &validationEntry{check: check, severity: severity, skip: reason, silent: true, result: checkResult{\n\t\t\t\t\t\tID: module.Rel + \"/\" + stack + \"/\" + check.Name, Module: module.Rel,\n\t\t\t\t\t\tStack: stack, Name: check.Name, Program: check.Program,\n\t\t\t\t\t\tArgs: check.Args, Env: redactedEnv(check.Env), Severity: severity, EvidenceClass: check.EvidenceClass,\n\t\t\t\t\t}})\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif carryState.carried(module.Rel) {\n\t\t\tfor _, check := range checks {\n\t\t\t\tif check.Program == \"\" {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n\t\t\t\tentries = append(entries, &validationEntry{check: check, silent: true, carried: true, result: carryState.carriedResult(id)})\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tmoduleMode := mode\n\t\tif override.Mode != \"\" {\n\t\t\tmoduleMode = override.Mode\n\t\t}\n\t\tentries = append(entries, &validationEntry{note: fmt.Sprintf(\"[module] %s (%s, mode=%s)\", module.Rel, stack, moduleMode)})\n\t\tfor _, check := range checks {\n\t\t\tif check.Program == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseverity := check.Severity\n\t\t\tif severity == \"\" {\n\t\t\t\tseverity = \"required\"\n\t\t\t}\n\t\t\tentry := &validationEntry{check: check, moduleDir: module.Abs, severity: severity, done: make(chan struct{}), result: checkResult{\n\t\t\t\tID: module.Rel + \"/\" + stack + \"/\" + check.Name, Module: module.Rel,\n\t\t\t\tStack: stack, Name: check.Name, Program: check.Program,\n\t\t\t\tArgs: check.Args, Env: redactedEnv(check.Env), Severity: severity, EvidenceClass: check.EvidenceClass,\n\t\t\t}}\n\t\t\tif check.Isolation == \"required\" {\n\t\t\t\t// The local CLI never weakens its boundary: isolated\n\t\t\t\t// execution is delegated to the Harness via --emit-plan.\n\t\t\t\tentry.skip = \"requires isolated execution (harness) — include via --emit-plan\"\n\t\t\t\tentry.isolated = true\n\t\t\t}\n\t\t\tentries = append(entries, entry)\n\t\t}\n\t}\n\t// Checks run up to jobs at a time; results are shown and counted here,\n\t// in matrix order, whatever order they finish in (spec\n\t// pose-validate-concurrent-steps R1). --verbose streams a check's output,\n\t// so it runs them one at a time.\n\tif jobs == 0 {\n\t\tjobs = defaultValidationJobs(effectiveValidationResources(os.ReadFile, runtime.NumCPU()))\n\t}\n\tif verbose {\n\t\tjobs = 1\n\t}\n\trun.Jobs = jobs\n\trunCtx, stopSignals := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stopSignals()\n\t// The first signal cancels the run; a second one acts as it always did,\n\t// even while the run shuts down (review round 1, B4).\n\tgo func() {\n\t\t<-runCtx.Done()\n\t\tstopSignals()\n\t}()\n\twallStart := time.Now()\n\tif jobs > 1 {\n\t\tgo dispatchValidationEntries(runCtx, entries, jobs, matrix)\n\t}\n\tfor _, entry := range entries {\n\t\tif entry.note != \"\" {\n\t\t\tsteps.Note(entry.note)\n\t\t\tcontinue\n\t\t}\n\t\tif entry.carried {\n\t\t\t// A carried result counts toward the outcome exactly as it did in\n\t\t\t// its own run; a carried failure stays a failure (R4).\n\t\t\trun.Counts.Carried++\n\t\t\tswitch entry.result.Outcome {\n\t}\n}\n\n// Symlinks inside a submodule are scanned at its recorded commit (review\n// round 8, N20).\nfunc TestCarryRefusesAnAliasingSymlinkInsideASubmodule(t *testing.T) {\n\tf := newCarryFixture(t, `{\"schemaVersion\":1,\"modules\":{\"b\":{\"selfContained\":true,\"dependsOn\":[\"sub/link/input\"]}}}`)\n\tsub := filepath.Join(f.root, \"sub\")\n\tif err := os.MkdirAll(sub, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trun := func(dir string, args ...string) {\n\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\t\tcmd.Env = append(os.Environ(), \"GIT_AUTHOR_NAME=t\", \"GIT_AUTHOR_EMAIL=t@t\", \"GIT_COMMITTER_NAME=t\", \"GIT_COMMITTER_EMAIL=t@t\", \"GIT_CONFIG_GLOBAL=/dev/null\")\n\t\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t}\n\trun(sub, \"init\", \"-q\")\n\tif err := os.Symlink(\"../a\", filepath.Join(sub, \"link\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trun(sub, \"add\", \"-A\")\n\trun(sub, \"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-qm\", \"link out of the submodule\")\n\tf.commit(\"sub as a gitlink\")\n\tif links, _ := gitlinks(f.root, \"HEAD\"); links[\"sub\"] == \"\" {\n\t\tt.Fatalf(\"the fixture must track sub as a gitlink: %v\", links)\n\t}\n\tf.baseline()\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"change a\")\n\t_, _, result := f.validate(\"--carry\")\n\tif result.Carry == nil || result.Carry.Used || !strings.Contains(result.Carry.Reason, \"symlink sub/link\") {\n\t\tt.Fatalf(\"carry = %+v, want the submodule's aliasing symlink refused\", result.Carry)\n\t}\n}\n\n// A case-folded directory is detected inside a case-sensitive filesystem\n// (review round 8, N22); faked, since this filesystem does not fold.\nfunc TestCarryDetectsACaseFoldedDirectory(t *testing.T) {\n\tdir := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(dir, \"input\"), []byte(\"x\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tinfo, err := os.Stat(filepath.Join(dir, \"input\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfolding := func(p string) (os.FileInfo, error) {\n\t\tif strings.EqualFold(filepath.Base(p), \"input\") {\n\t\t\treturn info, nil\n\t\t}\n\t\treturn os.Stat(p)\n\t}\n\tif !casefoldedDirectory(dir, os.ReadDir, folding) {\n\t\tt.Fatal(\"a directory where INPUT names input must read as case-folded\")\n\t}\n\tif casefoldedDirectory(dir, os.ReadDir, os.Stat) {\n\t\tt.Fatal(\"a case-sensitive directory read as case-folded\")\n\t}\n}\n\n// An enclosing module is selected when a module nested in it changes (review\n// round 9, N25).\nfunc TestChangedScopeSelectsTheEnclosingModule(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.write(\"b/n/go.mod\", \"module n\\n\")\n\tf.commit(\"nested module in b\")\n\tf.write(\"b/n/input\", \"x\\n\")\n\tf.commit(\"change inside the nested module\")\n\t_, out := runValidate(t, f.root, \"--changed-from\", \"HEAD~1\", \"--changed-to\", \"HEAD\", \"--explain\")\n\tif !strings.Contains(out, \"+ b/n: contains changed file: b/n/input\") || !strings.Contains(out, \"+ b: changed file in nested module b/n: b/n/input\") {\n\t\tt.Fatalf(\"both the owner and its enclosing module must be selected: %s\", out)\n\t}\n}\n\n// A gitlink inside a module is scanned too (review round 9, N24).\nfunc TestCarryScansAGitlinkInsideAModule(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tsub := filepath.Join(f.root, \"b\", \"sub\")\n\tif err := os.MkdirAll(sub, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit := func(dir string, args ...string) {\n\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\t\tcmd.Env = append(os.Environ(), \"GIT_AUTHOR_NAME=t\", \"GIT_AUTHOR_EMAIL=t@t\", \"GIT_COMMITTER_NAME=t\", \"GIT_COMMITTER_EMAIL=t@t\", \"GIT_CONFIG_GLOBAL=/dev/null\")\n\t\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t}\n\tgit(sub, \"init\", \"-q\")\n\tif err := os.Symlink(\"../../a\", filepath.Join(sub, \"link\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit(sub, \"add\", \"-A\")\n\tgit(sub, \"-c\", \"core.hooksPath=/dev/null\", \"commit\", \"-qm\", \"link out\")\n\tf.commit(\"gitlink inside b\")\n\tf.baseline()\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"change a\")\n\t_, _, run := f.validate(\"--carry\")\n\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, \"symlink b/sub/link\") {\n\t\tt.Fatalf(\"carry = %+v, want the aliasing symlink in the module's gitlink refused\", run.Carry)\n\t}\n}\n\n// Case behaviour is probed on every directory up to the root (review round 9,\n// N26).\nfunc TestCarryRelevantDirsIncludeEveryAncestor(t *testing.T) {\n\troot := t.TempDir()\n\tif err := os.MkdirAll(filepath.Join(root, \"shared\", \"a\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tmeta := scopeMetadata{Modules: map[string]scopeModuleMeta{\"b\": {DependsOn: []string{\"shared/A/input\"}}}}\n\tdirs := carryRelevantDirs(root, nil, meta)\n\twant := map[string]bool{root: false, filepath.Join(root, \"shared\"): false}\n\tfor _, d := range dirs {\n\t\tif _, ok := want[d]; ok {\n\t\t\twant[d] = true\n\t\t}\n\t}\n\tfor d, found := range want {\n\t\tif !found {\n\t\t\tt.Fatalf(\"dirs = %v, missing ancestor %s\", dirs, d)\n\t\t}\n\t}\n}\n\n// The root module encloses every other module.\nfunc TestChangedScopeRootModuleEnclosesEveryModule(t *testing.T) {\n\tf := newCarryFixture(t, \"\")\n\tf.write(\"go.mod\", \"module root\\n\")\n\tf.commit(\"root module\")\n\tf.write(\"a/changed.go\", \"package a\\n\")\n\tf.commit(\"change a\")\n\t_, out := runValidate(t, f.root, \"--changed-from\", \"HEAD~1\", \"--changed-to\", \"HEAD\", \"--explain\")\n\tif !strings.Contains(out, \"+ .: changed file in nested module a: a/changed.go\") || !strings.Contains(out, \"- b: not affected\") {\n\t\tt.Fatalf(\"the root module must be selected as the enclosing module, b left: %s\", out)\n\t}\n}\n","exit_code":0,"status":"completed"}}
