DE_SET_46}\" ]; then   if [ -z \"${npm_config_proxy+x}\" ] || [ \"${npm_config_proxy-}\" != \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_46}\" ]; then export npm_config_proxy=\"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_46}\"; else export npm_config_proxy; fi else builtin unset npm_config_proxy 2>/dev/null || command unset npm_config_proxy; fi builtin unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_46 __CODEX_SNAPSHOT_PROXY_OVERRIDE_46 2>/dev/null || command unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_46 __CODEX_SNAPSHOT_PROXY_OVERRIDE_46 if [ -n \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_47}\" ]; then   if [ -z \"${ws_proxy+x}\" ] || [ \"${ws_proxy-}\" != \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_47}\" ]; then export ws_proxy=\"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_47}\"; else export ws_proxy; fi else builtin unset ws_proxy 2>/dev/null || command unset ws_proxy; fi builtin unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_47 __CODEX_SNAPSHOT_PROXY_OVERRIDE_47 2>/dev/null || command unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_47 __CODEX_SNAPSHOT_PROXY_OVERRIDE_47 if [ -n \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_48}\" ]; then   if [ -z \"${wss_proxy+x}\" ] || [ \"${wss_proxy-}\" != \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_48}\" ]; then export wss_proxy=\"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_48}\"; else export wss_proxy; fi else builtin unset wss_proxy 2>/dev/null || command unset wss_proxy; fi builtin unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_48 __CODEX_SNAPSHOT_PROXY_OVERRIDE_48 2>/dev/null || command unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_48 __CODEX_SNAPSHOT_PROXY_OVERRIDE_48 fi if [ -n \"${PATH:-}\" ]; then export PATH='/usr/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/codex-path':\"$PATH\"; else export PATH='/usr/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/codex-path'; fi  exec '/usr/bin/bash' -c 'ps -eo pid,ppid,etime,args | rg '\"'\"'pose|go test'\"'\"' | head -50; sed -n '\"'\"'1,150p'\"'\"' pose-mcp/internal/pose/material_binding.go; sed -n '\"'\"'1,95p'\"'\"' pose-mcp/internal/cli/validate.go; sed -n '\"'\"'1,120p'\"'\"' .pose/rules/backend-go.md; rg -n -i '\"'\"'carry|unchanged.check'\"'\"' .pose/knowledge --glob '\"'\"'*.md'\"'\"' | head -25; cat .pose/indexes/validation-matrix.json | head -45'\n      2       1       00:00 /usr/bin/bash -c ps -eo pid,ppid,etime,args | rg 'pose|go test' | head -50; sed -n '1,150p' pose-mcp/internal/pose/material_binding.go; sed -n '1,95p' pose-mcp/internal/cli/validate.go; sed -n '1,120p' .pose/rules/backend-go.md; rg -n -i 'carry|unchanged.check' .pose/knowledge --glob '*.md' | head -25; cat .pose/indexes/validation-matrix.json | head -45\n      4       2       00:00 rg pose|go test\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Validation evidence binds to the material it validated (spec\n// pose-validation-evidence-material-binding, ADR\n// validation-evidence-binds-to-validated-material). A commit whose every\n// changed path is a derived administrative record does not change what the\n// checks exercised, so it does not move the material digest.\n\n// engineVersion is the running engine, registered by the binaries (internal/pose\n// stays importable on its own). It is part of every material digest, so a new\n// engine never inherits evidence the previous one produced.\nvar engineVersion = \"unregistered\"\n\n// SetEngineVersion registers the running engine for material digests.\nfunc SetEngineVersion(v string) { engineVersion = v }\n\n// administrativeDirs is the closed list of derived-record directories. It is\n// owned by the engine; adding a class is a contract change that needs an ADR.\nvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n\n// materialIndexes are files inside an administrative directory that still\n// change what the checks demand.\nvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\n// IsAdministrativePath reports whether p is a derived administrative record.\nfunc IsAdministrativePath(p string) bool {\n\tif p == \"\" || p != path.Clean(p) || strings.HasPrefix(p, \"/\") || strings.HasPrefix(p, \"../\") {\n\t\treturn false\n\t}\n\tif materialIndexes[p] {\n\t\treturn false\n\t}\n\tif !recordExtensions[strings.ToLower(path.Ext(p))] {\n\t\treturn false\n\t}\n\tfor _, dir := range administrativeDirs {\n\t\tif strings.HasPrefix(p, dir) {\n\t\t\treturn true\n\t\t}\n\t}\n\tif rest, ok := strings.CutPrefix(p, \".pose/\"); ok {\n\t\tif i := strings.Index(rest, \"/\"); i > 0 && strings.HasPrefix(rest[:i], \"review-\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// recordExtensions are the data formats a derived record is written in. Code or\n// a script stored in a class is material: that keeps a source file moved or\n// copied into a class from hiding its later edits. A copied data file stays\n// indistinguishable from a record; a check that reads data out of a derived-record\n// directory is outside this contract (ADR validation-evidence-binds-to-validated-material).\nvar recordExtensions = map[string]bool{\".json\": true, \".jsonl\": true, \".ndjson\": true, \".md\": true, \".txt\": true, \".log\": true, \".transcript\": true}\n\n// TreeEntry is one entry of the validated head's tree.\ntype TreeEntry struct{ Mode, Blob string }\n\nfunc regularMode(mode string) bool { return mode == \"100644\" || mode == \"100755\" }\n\n// MaterialInputs are what a material digest is computed from: the paths a change\n// set names (both sides of a rename, and the validation matrix) and the\n// destinations of renames. They are stored with the set so the digest can be\n// recomputed against the current tree without the commits' own records.\ntype MaterialInputs struct {\n\tNames []string `json:\"names\"`\n\tMoved []string `json:\"moved,omitempty\"`\n}\n\n// MaterialInputsOf derives the inputs from per-commit path records. They must\n// be unmerged: folding a create and a later rename into one creation would hide\n// that the file moved into a class.\nfunc MaterialInputsOf(paths []ObservedPath) MaterialInputs {\n\tnames := map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\tmoved := map[string]bool{}\n\tfor _, p := range paths {\n\t\tfor _, name := range []string{p.Path, p.OldPath, p.NewPath} {\n\t\t\tif name != \"\" {\n\t\t\t\tnames[name] = true\n\t\t\t}\n\t\t}\n\t\t// A rename destination is material whatever directory it lands in:\n\t\t// otherwise moving a source file into a class would hide its later edits.\n\t\tif p.OldPath != \"\" && p.NewPath != \"\" {\n\t\t\tmoved[p.NewPath] = true\n\t\t}\n\t}\n\tin := MaterialInputs{}\n\tfor name := range names {\n\t\tin.Names = append(in.Names, name)\n\t}\n\tfor name := range moved {\n\t\tin.Moved = append(in.Moved, name)\n\t}\n\tsort.Strings(in.Names)\n\tsort.Strings(in.Moved)\n\treturn in\n}\n\n// MaterialSetDigest digests the head state of the material a change set\n// touched: every path it names (both sides of a rename) with its mode and blob\n// at the validated head, minus the paths that are administrative records and\n// still regular files there, plus the validation matrix. A symlink, submodule\n// or directory in an administrative class is material; so is a path that left\n// a class. tree maps each named path (and the matrix) to its entry; a path\n// absent from the head tree is \"absent\".\nfunc MaterialSetDigest(in MaterialInputs, tree map[string]TreeEntry) string {\n\tmoved := map[string]bool{}\n\tfor _, name := range in.Moved {\n\t\tmoved[name] = true\n\t}\n\tsorted := in.Names\n\th := sha256.New()\n\tfor _, name := range sorted {\n\t\tentry, present := tree[name]\n\t\tif IsAdministrativePath(name) && !moved[name] && (!present || regularMode(entry.Mode)) {\n\t\t\tcontinue\n\t\t}\n\t\tif !present {\n\t\t\th.Write([]byte(name + \"\\x00absent\\n\"))\n\t\t\tcontinue\n\t\t}\n\t\th.Write([]byte(name + \"\\x00\" + entry.Mode + \"\\x00\" + entry.Blob + \"\\n\"))\n\t}\n\treturn \"sha256:\" + hex.EncodeToString(h.Sum(nil))\n}\n\n// MaterialDigestUnreadable marks a change set whose head tree could not be read\n// or whose checkout is not complete. It never binds evidence and never lets\n// evidence recorded without it pass as current.\nconst MaterialDigestUnreadable = \"unreadable\"\n\n// MaterialBindingUnavailable is recorded for a scope whose material cannot be\n// established, so the result is stale for it instead of falling back to the\n// commit-bound rules.\nconst MaterialBindingUnavailable = \"unavailable\"\n\n// MaterialBinding returns what a validation run should record for a spec: the\n// scoped digest, the unavailable marker when a change set's material could not\n// be read, or nothing when the spec has no material-bound change set.\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"os/signal\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"syscall\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\ntype validationWhen struct {\n\tFileExists    string `json:\"fileExists\"`\n\tFileNotExists string `json:\"fileNotExists\"`\n\t// FileNotExistsAny (spec pose-stack-catalog-expansion): skip when ANY of\n\t// these files exist — expresses manager-priority exclusion (e.g. a pip\n\t// check yields to poetry/pipenv when their lockfiles are present)\n\t// without needing repeated single-field checks.\n\tFileNotExistsAny []string `json:\"fileNotExistsAny\"`\n}\n\ntype validationCheck struct {\n\tName          string            `json:\"name\"`\n\tCommand       string            `json:\"command\"`\n\tProgram       string            `json:\"program\"`\n\tArgs          []string          `json:\"args\"`\n\tEnv           map[string]string `json:\"env\"`\n\tSeverity      string            `json:\"severity\"`\n\tEvidenceClass string            `json:\"evidenceClass,omitempty\"`\n\tWhen          validationWhen    `json:\"when\"`\n\t// Runtime guardrails (spec pose-validation-runtime-guardrails).\n\tTimeoutSeconds int    `json:\"timeoutSeconds\"` // 0 = defaults.timeoutSeconds (600)\n\tIsolation      string `json:\"isolation\"`      // \"\" | \"required\" — required never runs locally\n\t// Exclusive runs the check with no other check running (spec\n\t// pose-validate-concurrent-steps R2).\n\tExclusive bool `json:\"exclusive,omitempty\"`\n}\n\n// validationEntry is one line of a validation run, in matrix order: a module\n// note, a skipped check or a check to execute.\ntype validationEntry struct {\n\tnote      string\n\tcheck     validationCheck\n\tmoduleDir string\n\tseverity  string\n\t// skip is why the check does not run. silent marks a changed-scope skip,\n\t// recorded in order without a step line.\n\tskip     string\n\tsilent   bool\n\tisolated bool\n\t// carried marks a check whose result comes from the canonical base (spec\n\t// pose-validate-carries-unchanged-checks R4); it is silent and never runs.\n\tcarried bool\n\tresult  checkResult\n\tdone     chan struct{}\n}\n\n// resolveWhen evaluates the check's condition at the moment it would start,\n// so an earlier check, finished by then, can decide it (review round 1, B1).\nfunc (e *validationEntry) resolveWhen() {\n\tif e.skip == \"\" {\n\t\te.skip = validationSkipReason(e.moduleDir, e.check.When)\n\t}\n}\n\n// execute runs the check and records its outcome in the entry's result. It\n// touches nothing else, so entries can run concurrently; the caller counts.\nfunc (e *validationEntry) execute(parent context.Context, matrix validationMatrix, verbose bool, stdout, stderr io.Writer, beforeStream func()) {\n\tcheck, result := e.check, &e.result\n\ttimeout := check.TimeoutSeconds\n\tif timeout <= 0 {\n\t\ttimeout = matrix.Defaults.TimeoutSeconds\n\t}\n\tif timeout <= 0 {\n\t\ttimeout = 600 // documented safe default\n\t}\n\tmaxOutput := matrix.Defaults.MaxOutputBytes\n\tif maxOutput <= 0 {\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:32:when the spec closes, and retired when the ADR and `docs-site/docs/cli.md` carry\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:113:Three persistence paths exist, and they carry different things — worth keeping\n.pose/knowledge/2026-09-12-note-cli-output-design-taxonomy.md:419:- `pose-mcp/internal/pose/delivery_integrity.go` — findings already carry\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:45:separate mechanism carrying separate self-referential data (JSON policy\n{\n  \"defaults\": {\n    \"mode\": \"strict\"\n  },\n  \"deliveryProfiles\": {\n    \"cli-surface\": {\n      \"kind\": \"surface\",\n      \"requiredEvidenceClasses\": [\n        \"reachability\"\n      ],\n      \"anyEvidenceClasses\": [\n        \"integration\",\n        \"e2e\"\n      ]\n    },\n    \"composed-capability\": {\n      \"kind\": \"capability\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"api-contract\": {\n      \"kind\": \"contract\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"release-governance\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"backend-go\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"structural-delta\": {\n      \"kind\": \"governance\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'dispatchValidationEntries|entry.silent|entry.carried' pose-mcp/internal/cli/validate.go; sed -n '190,310p' pose-mcp/internal/cli/validate.go; pose version; pose help\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'dispatchValidationEntries|entry.silent|entry.carried' pose-mcp/internal/cli/validate.go; sed -n '190,310p' pose-mcp/internal/cli/validate.go; pose version; pose help\"","aggregated_output":"322:// dispatchValidationEntries starts the entries in matrix order, up to jobs at\n325:func dispatchValidationEntries(ctx context.Context, entries []*validationEntry, jobs int, matrix validationMatrix) {\n337:\t\tif entry.note != \"\" || entry.silent || entry.isolated {\n1324:\t\tgo dispatchValidationEntries(runCtx, entries, jobs, matrix)\n1331:\t\tif entry.carried {\n1359:\t\tif !entry.silent && !entry.isolated {\n1378:\t\t\tif !entry.silent {\n// other form — another flag, a missing value, -args, --, a positional argument\n// after the packages, quoted GOFLAGS — leaves the check unjudged: reading it\n// wrong would fail a good check (spec pose-validate-refuses-empty-go-checks\n// R1-R2).\nfunc goTestSelection(check validationCheck) (flag, pattern string, judged bool) {\n\tif check.Program != \"go\" || len(check.Args) == 0 || check.Args[0] != \"test\" {\n\t\treturn \"\", \"\", false\n\t}\n\tselected := false\n\tscan := func(args []string, packagesAllowed bool) bool {\n\t\tpackages, afterPackages := false, false\n\t\tfor i := 0; i < len(args); i++ {\n\t\t\targ := args[i]\n\t\t\tif !strings.HasPrefix(arg, \"-\") {\n\t\t\t\tif !packagesAllowed || afterPackages {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\t\tpackages = true\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tafterPackages = packages\n\t\t\tname, value, inline, ok := goFlagName(arg)\n\t\t\tif !ok {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\ttestName, testSpelling := strings.CutPrefix(name, \"test.\")\n\t\t\tswitch {\n\t\t\tcase testName == \"run\", testName == \"skip\":\n\t\t\t\tif !inline {\n\t\t\t\t\tif i+1 >= len(args) {\n\t\t\t\t\t\treturn false\n\t\t\t\t\t}\n\t\t\t\t\ti++\n\t\t\t\t\tvalue = args[i]\n\t\t\t\t}\n\t\t\t\tflag, pattern, selected = \"-\"+testName, value, true\n\t\t\tcase goTestFlagsWithValue[testName], !testSpelling && goBuildFlagsWithValue[name]:\n\t\t\t\tif !inline {\n\t\t\t\t\tif i+1 >= len(args) {\n\t\t\t\t\t\treturn false\n\t\t\t\t\t}\n\t\t\t\t\ti++\n\t\t\t\t}\n\t\t\tcase goTestFlagsWithoutValue[testName], !testSpelling && goBuildFlagsWithout[name]:\n\t\t\t\tif inline && value != \"true\" && value != \"false\" {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\tdefault:\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\treturn true\n\t}\n\tgoflags, set := check.Env[\"GOFLAGS\"]\n\tif !set {\n\t\tgoflags = os.Getenv(\"GOFLAGS\")\n\t}\n\tif strings.ContainsAny(goflags, `'\"`) || !scan(strings.Fields(goflags), false) || !scan(check.Args[1:], true) || !selected {\n\t\treturn \"\", \"\", false\n\t}\n\tif pattern == \"\" {\n\t\tpattern = `\"\"`\n\t}\n\treturn flag, pattern, true\n}\n\n// A package's result line of go test: the tab-separated forms Go prints, not\n// any line of a test's output that starts with ok (review round 1, B2, B3).\nvar (\n\tgoTestEmptyLine    = regexp.MustCompile(`^ok  \\t\\S+\\t(\\(cached\\)|[0-9.]+s)(\\tcoverage: [^\\t]*)? ?\\[no tests to run\\]$`)\n\tgoTestRanLine      = regexp.MustCompile(`^ok  \\t\\S+\\t(\\(cached\\)|[0-9.]+s)(\\tcoverage: .*)?$`)\n\tgoTestNoFiles      = regexp.MustCompile(`^\\?   \\t\\S+\\t\\[no test files\\]$`)\n\tgoTestNoFilesCover = regexp.MustCompile(`^\\s+\\S+\\t+coverage: [0-9.]+% of statements$`)\n)\n\n// goTestPackages reads go test's per-package result lines from a check's\n// standard output, a line at a time and in bounded memory.\ntype goTestPackages struct {\n\tpartial   []byte\n\toverflow  bool\n\twithTests int\n\tempty     int\n}\n\n// goTestLineLimit bounds a line kept across writes; a package result line is\n// far shorter, and a longer line is test output.\nconst goTestLineLimit = 4096\n\nfunc (p *goTestPackages) Write(data []byte) (int, error) {\n\tfor rest := data; len(rest) > 0; {\n\t\ti := bytes.IndexByte(rest, '\\n')\n\t\tif i < 0 {\n\t\t\tif len(p.partial)+len(rest) > goTestLineLimit {\n\t\t\t\tp.overflow = true\n\t\t\t\tp.partial = p.partial[:0]\n\t\t\t} else {\n\t\t\t\tp.partial = append(p.partial, rest...)\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t\tif !p.overflow && len(p.partial)+i <= goTestLineLimit {\n\t\t\tp.partial = append(p.partial, rest[:i]...)\n\t\t\tp.line(string(p.partial))\n\t\t}\n\t\tp.partial, p.overflow = p.partial[:0], false\n\t\trest = rest[i+1:]\n\t}\n\treturn len(data), nil\n}\n\nfunc (p *goTestPackages) line(line string) {\n\tline = strings.TrimSuffix(line, \"\\r\")\n\tswitch {\n\tcase goTestEmptyLine.MatchString(line), goTestNoFiles.MatchString(line), goTestNoFilesCover.MatchString(line):\n\t\tp.empty++\n\tcase goTestRanLine.MatchString(line):\n\t\tp.withTests++\n\t}\n}\n\n// ranNone reports that Go named packages and said of each that it ran no test.\npose 7.4.1-dev\nschema: 1\ninstance last updated by: pose 7.4.1-dev\nPOSE - Project Operating Standard for Engineering\n\nUsage: pose <command> [options]\n\nNative binary:\n  version                             Binary and instance schema versions\n  init                                Ensure the minimum POSE repository structure\n  serve-mcp [--stdio]                 Start the POSE MCP server (POSE_* environment)\n  doctor [--json]                     Diagnose installation and instance health\n  report-limitation --title \"...\"     Report an engine limitation, bug or proposal\n                                      [--kind limitation|bug|suggestion] [--submit]\n  install <dir> [--locale tag] [...]  Install embedded POSE without cloning\n  import <spec-kit|openspec> <path>   Import external specs [--dry-run]\n  telemetry <enable|disable|status>   Anonymous opt-in telemetry\n  setup [--json] [--no-input]         See what is in force, what is new and what is missing\n  context [--project-id <id>] [--task <ref>]  Resolve the selected project and qualified task context\n  identity <add|list|remove> [...]    Register the SSH keys a principal proves its answers with\n  issuer <init|pin|list|...>          Create and pin native issuers that sign review attestations\n  adopt <capability> | --list         Turn a governed capability on or off in this instance\n  migrate v7 --dry-run [--json]       Dry-run the legacy inventory a future major would convert\n\nScaffolds:\n  new-spec <slug>                     Create a feature spec scaffold\n  new-spec-qualified <slug>           Create via a qualified authority and fresh context\n  new-roadmap <slug>                  Create a governed roadmap\n  new-adr \"<title>\"                   Create an ADR\n  new-knowledge <type> <slug>         Create a handoff, note, or decision log\n  spec-transfer <preview|apply|resume|status> Transfer specification authority across projects\n  specs [--recent N] [--status S]     List and discover specifications\n  spec-format <migrate|status>        Inspect and migrate specs to the chronological layout\n  start spec:<slug> [--apply]         Preview or apply the atomic start of a draft spec\n\nDeterministic gates:\n  check | validate | knowledge-check | recurrence-check | lint-spec |\n  followups | amend | history-check | skills-check | review-check | closeout-check |\n  artifact-check | surface-check | roadmap-check | public-claims | docs-check\n\nDocumentation governance:\n  docs-init | docs-review | docs-sync Seed, review and export the docs contract of a project\n\nGoverned closeout:\n  review-plan <scope> [--explain]     Resolve component-aware criteria and tools\n  review bundle <scope> [--seal]      Prepare or seal an immutable review subject\n  review attest <bundle-id> [...]     Record/import a separate attestation\n  review verify <scope|bundle-id>     Verify freshness and closeout readiness\n  review record <scope> [...]         Compatibility entrypoint\n  action <open|list|show|resolve|...> Open, read and resolve material requests to a person or system\n  delegate review <scope> [--agent]   Run a delegated review; also adjudicate, smoke, ls, resume, cancel, agents\n  runtime <serve|start|attach|status|stop|restart|run>   Optional per-worktree runtime (opt-in); run hosts the checks in it; commands run standalone without it\n  close <scope>                         Apply a review-gated lifecycle transition\n  continuous-closeout <action>          Persist and project a terminal scope\n  artifact-backfill --from-git          Propose explicit historical provenance\n\nRelease lifecycle:\n  release <plan|prepare|check|notes|record|status|open-next|backfill>\n  release-notes --version vX.Y.Z        Compatibility alias for immutable notes\n  release-package-manifests --version X.Y.Z --checksums <file> --out <dir>\n                                        Package-manager manifests of a release\n\nProject state:\n  state [init|refresh|diff]           Native project-state artifact (bare = validate)\n\nDiscovery and metrics:\n  suggest | stats | insights | usage | recurrence-effect | stacks\n  record-deployment | record-incident | dora-metrics | adoption-metrics\n  semantic-suggest | suggest-feedback | portfolio-projection | reconcile-evidence\n  assess <discover|integrate|tech-debt|design>  Bounded local assessments of modules and contracts\n\nExtensions:\n  extension install <dir> [--target <dir>] [--dry-run] [--yes] [--force] [--allow-unsigned]\n  extension list [--json] | extension remove <id> [...] | extension verify <dir>\n\nContributions:\n  contribute <enable|disable|status|stage|list> [--target <dir>] [--json]\n\nArtifacts and maintenance:\n  index | report | update [--dry-run] | knowledge-housekeeping |\n  knowledge-usage | knowledge-suggest | reports-housekeeping | events-housekeeping | hooks\n\nAll commands execute in the Go binary without Bash or Python fallbacks.\n","exit_code":0,"status":"completed"}}
