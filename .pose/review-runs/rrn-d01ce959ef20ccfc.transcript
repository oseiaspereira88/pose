the release recorded %s: %s\", run.Status, run.Failure)\n66-\t}\n67:\tif _, err := s.readAttemptReceipt(a); err != nil {\n68-\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n69-\t}\n70-\tif left, _ := filepath.Glob(filepath.Join(dir, a.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n71-\t\tt.Fatalf(\"the marker or its stall claim stayed: %v\", left)\n72-\t}\n73-\t// Released once: a second release finds nothing abandoned.\n74-\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n75-\t\tt.Fatalf(\"a released attempt was released again: %v\", err)\n--\n262-\t\t_ = holder.Wait()\n263-\t}\n264-\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil && strings.Contains(err.Error(), \"in progress\") {\n265-\t\tt.Fatalf(\"an ended holder's lock still blocks the release: %v\", err)\n266-\t}\n267-}\n268-\n269-// Review round 3, N1: a release interrupted after it recorded the run, and\n270:// before the receipt, completes with that run instead of recording another.\n271-func TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n272-\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n273-\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n274-\tif err != nil {\n275-\t\tt.Fatal(err)\n276-\t}\n277-\tattempt := \"\"\n278-\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n--\n286-\tmarkerBytes, err := os.ReadFile(markerPath)\n287-\tif err != nil {\n288-\t\tt.Fatal(err)\n289-\t}\n290-\tfirst, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n291-\tif err != nil {\n292-\t\tt.Fatal(err)\n293-\t}\n294:\t// Undo the receipt and keep the marker, as a release stopped between\n295:\t// the run and the receipt leaves them.\n296-\tattempts, _ := f.store.readDelegatedReviewAttempts(f.bundle.BundleID)\n297-\tfor _, a := range attempts {\n298-\t\tif a.AttemptID == attempt {\n299:\t\t\tif err := os.Remove(attemptReceiptPath(f.store.Root, a)); err != nil {\n300-\t\t\t\tt.Fatal(err)\n301-\t\t\t}\n302-\t\t}\n303-\t}\n304-\tif err := os.WriteFile(markerPath, markerBytes, 0o600); err != nil {\n305-\t\tt.Fatal(err)\n306-\t}\n307-\tsecond, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n--\n347-\t// so it is released only on the operator's confirmation.\n348-\tif _, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"--confirm-abandoned\") {\n349-\t\tt.Fatalf(\"a markerless reservation was released without confirmation: %v\", err)\n350-\t}\n351-\trun, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n352-\tif err != nil || run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"operator's confirmation\") {\n353-\t\tt.Fatalf(\"release: %+v %v\", run, err)\n354-\t}\n355:\tif _, err := s.readAttemptReceipt(old); err != nil {\n356-\t\tt.Fatalf(\"the released reservation still blocks its bundle: %v\", err)\n357-\t}\n358:\t// Review round 4, N1: a release stopped between its run and its receipt\n359-\t// leaves the attempt with a run; it is still released, with that run.\n360:\tif err := os.Remove(attemptReceiptPath(root, old)); err != nil {\n361-\t\tt.Fatal(err)\n362-\t}\n363-\tagain, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n364-\tif err != nil || again.RunID != run.RunID {\n365-\t\tt.Fatalf(\"the interrupted release did not complete with its run: %s then %s (%v)\", run.RunID, again.RunID, err)\n366-\t}\n367-}\n368-\n369:// Review round 3, N3: an unreadable reservation is reported, not skipped.\n370:func TestAnUnreadableReservationIsReportedAsALoss(t *testing.T) {\n371-\troot := t.TempDir()\n372-\ts := Store{Root: root}\n373-\tdir := filepath.Join(root, reviewAttemptDir, \"broken\")\n374-\tif err := os.MkdirAll(dir, 0o755); err != nil {\n375-\t\tt.Fatal(err)\n376-\t}\n377-\tif err := os.WriteFile(filepath.Join(dir, \"000001.json\"), []byte(\"{not json\"), 0o644); err != nil {\n378-\t\tt.Fatal(err)\n379-\t}\n380-\t_, lost, err := s.ListDelegationAttempts()\n381-\tif err != nil || !strings.Contains(strings.Join(lost, \"\\n\"), \"broken/000001.json could not be read\") {\n382:\t\tt.Fatalf(\"an unreadable reservation was skipped silently: %v %v\", lost, err)\n383-\t}\n384-}\n385-\n386-// Review round 4, N3: with the run history incomplete, no reservation is\n387-// taken as runless, and the loss is reported.\n388-func TestAnIncompleteRunHistoryRulesNothingOut(t *testing.T) {\n389-\troot := t.TempDir()\n390-\ts := Store{Root: root}\n--\n409-\t\tt.Fatalf(\"an incomplete history ruled a run out: %v %v %v\", orphans, lost, err)\n410-\t}\n411-\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n412-\t\tt.Fatal(\"a reservation was released over an incomplete run history\")\n413-\t}\n414-}\n415-\n416-// Review round 5, N3: a dispatch that recorded its run and stopped before\n417:// the receipt is completed with that run, not with a second one; N2: a\n418:// release that stopped after the receipt only removes the marker.\n419-func TestARecordedRunCompletesItsAttempt(t *testing.T) {\n420-\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n421:\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"receipt lost\")\n422-\tif err != nil {\n423-\t\tt.Fatal(err)\n424-\t}\n425-\tsaved := beforeRunResultPublished\n426-\tt.Cleanup(func() { beforeRunResultPublished = saved })\n427-\trecorded := \"\"\n428:\tbeforeRunResultPublished = func(r ReviewRun) { recorded = r.RunID; panic(\"the dispatching process ends before the receipt\") }\n429-\tfunc() {\n430-\t\tdefer func() { _ = recover() }()\n431-\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n432-\t}()\n433-\tbeforeRunResultPublished = saved\n434-\truns, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID)\n435-\tif recorded == \"\" || len(runs) == 0 {\n436-\t\tt.Fatalf(\"the dispatch recorded no run: %q %d\", recorded, len(runs))\n--\n441-\tmarkerBytes, _ := os.ReadFile(filepath.Join(activeDir, attempt+\".json\"))\n442-\treleased, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n443-\tif err != nil || released.RunID != recorded {\n444-\t\tt.Fatalf(\"the release did not complete with the recorded run %s: %s %v\", recorded, released.RunID, err)\n445-\t}\n446-\tif after, _, _ := f.store.ReadReviewRuns(f.bundle.BundleID); len(after) != len(runs) {\n447-\t\tt.Fatalf(\"the release recorded another run: %d then %d\", len(runs), len(after))\n448-\t}\n449:\t// The marker comes back, as a release stopped after the receipt leaves it.\n450-\tif err := os.WriteFile(filepath.Join(activeDir, attempt+\".json\"), markerBytes, 0o600); err != nil {\n451-\t\tt.Fatal(err)\n452-\t}\n453-\tagain, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n454-\tif err != nil || again.RunID != recorded {\n455:\t\tt.Fatalf(\"a release after the receipt did not complete: %s %v\", again.RunID, err)\n456-\t}\n457-\tif left, _ := filepath.Glob(filepath.Join(activeDir, attempt+\".json\")); len(left) != 0 {\n458:\t\tt.Fatal(\"the stalled marker stayed after the receipt\")\n459-\t}\n460-}\n461-\n462:// Review round 6, N1: an unreadable active marker may be a live attempt's,\n463-// so no reservation is taken as markerless.\n464:func TestAnUnreadableMarkerRulesNothingOut(t *testing.T) {\n465-\troot := t.TempDir()\n466-\ts := Store{Root: root}\n467-\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000d1\", BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n468-\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"4\", 32)}\n469-\ta.AttemptID = attemptIdentity(a)\n470-\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n471-\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n472-\t\tt.Fatal(err)\n473-\t}\n474-\tdir, _ := s.delegationActiveDir(true)\n475-\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), []byte(\"{damaged\"), 0o600); err != nil {\n476-\t\tt.Fatal(err)\n477-\t}\n478-\torphans, lost, err := s.orphanReservations(time.Now())\n479:\tif err != nil || len(orphans) != 0 || !strings.Contains(strings.Join(lost, \"\\n\"), \"active marker is unreadable\") {\n480:\t\tt.Fatalf(\"an unreadable marker let a reservation pass as markerless: %v %v %v\", orphans, lost, err)\n481-\t}\n482-\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), true); err == nil {\n483:\t\tt.Fatal(\"a reservation with an unreadable marker was released\")\n484-\t}\n485-}\n486-\n487-// Review round 10, N2: a directory listing of the orphan scan is bounded and\n488-// says when it was cut.\n489-func TestTheOrphanScanListsBoundedDirectories(t *testing.T) {\n490-\tdir := t.TempDir()\n491-\tfor i := 0; i < 12; i++ {\n","exit_code":0,"status":"completed"}}
