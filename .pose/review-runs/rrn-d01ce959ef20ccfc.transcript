{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '770,870p' && nl -ba pose-mcp/internal/pose/review_rounds_test.go | sed -n '165,205p'\"","aggregated_output":"   770\t// ReviewRoundPoint is one round of a kind: its number, the findings its\n   771\t// draft reported, and whether its valid draft approved.\n   772\ttype ReviewRoundPoint struct {\n   773\t\tRound    int  `json:\"round\"`\n   774\t\tFindings int  `json:\"findings\"`\n   775\t\tApproved bool `json:\"approved\"`\n   776\t\tInvalid  bool `json:\"invalid\"`\n   777\t}\n   778\t\n   779\t// reviewRoundMetrics measures each scope's rounds. The number of rounds is\n   780\t// the highest any run of the scope recorded, whatever became of that run, so\n   781\t// a metric never lowers the rounds recorded (R8; review round 1, B5); a\n   782\t// round's figures come from the run that concluded it, and an invalid draft\n   783\t// counts as invalid, never as an approval or a convergence (B7).\n   784\tfunc reviewRoundMetrics(runs []ReviewRun) []ReviewRoundMetric {\n   785\t\thighest := map[string]int{}\n   786\t\tconcluding := map[string]map[int]ReviewRun{}\n   787\t\tfor _, r := range runs {\n   788\t\t\tif r.Round == 0 || r.Kind != ReviewBriefKindReview {\n   789\t\t\t\tcontinue\n   790\t\t\t}\n   791\t\t\tif r.Round > highest[r.Scope] {\n   792\t\t\t\thighest[r.Scope] = r.Round\n   793\t\t\t}\n   794\t\t\tif r.Status != ReviewRunCompleted || r.SupersededBy != \"\" {\n   795\t\t\t\tcontinue\n   796\t\t\t}\n   797\t\t\tif concluding[r.Scope] == nil {\n   798\t\t\t\tconcluding[r.Scope] = map[int]ReviewRun{}\n   799\t\t\t}\n   800\t\t\t// The run that ended last concludes the round, as concludingReviewRun\n   801\t\t\t// decides (review round 3, R3-F1).\n   802\t\t\tif prev, ok := concluding[r.Scope][r.Round]; ok {\n   803\t\t\t\tended, _ := time.Parse(time.RFC3339Nano, r.EndedAt)\n   804\t\t\t\tbefore, _ := time.Parse(time.RFC3339Nano, prev.EndedAt)\n   805\t\t\t\tif ended.Before(before) || ended.Equal(before) && r.RunID < prev.RunID {\n   806\t\t\t\t\tcontinue\n   807\t\t\t\t}\n   808\t\t\t}\n   809\t\t\tconcluding[r.Scope][r.Round] = r\n   810\t\t}\n   811\t\tscopes := make([]string, 0, len(highest))\n   812\t\tfor scope := range highest {\n   813\t\t\tscopes = append(scopes, scope)\n   814\t\t}\n   815\t\tsort.Strings(scopes)\n   816\t\tshare := func(n, total int) *float64 {\n   817\t\t\tif total == 0 {\n   818\t\t\t\treturn nil\n   819\t\t\t}\n   820\t\t\tv := float64(n) / float64(total)\n   821\t\t\treturn &v\n   822\t\t}\n   823\t\tvar out []ReviewRoundMetric\n   824\t\tfor _, scope := range scopes {\n   825\t\t\tm := ReviewRoundMetric{Scope: scope, Rounds: highest[scope], Continued: ReviewRoundConvergence{Trajectory: []ReviewRoundPoint{}}, Cold: ReviewRoundConvergence{Trajectory: []ReviewRoundPoint{}}}\n   826\t\t\tm.FindingsPerRound = make([]int, m.Rounds)\n   827\t\t\tfor n := 1; n <= m.Rounds; n++ {\n   828\t\t\t\tr, ok := concluding[scope][n]\n   829\t\t\t\tif !ok {\n   830\t\t\t\t\tcontinue\n   831\t\t\t\t}\n   832\t\t\t\tdraft, err := ParseReviewDraft(r.Output)\n   833\t\t\t\tinvalid := err != nil || len(r.DraftProblems) > 0\n   834\t\t\t\tif invalid {\n   835\t\t\t\t\tm.InvalidRounds++\n   836\t\t\t\t}\n   837\t\t\t\tif draft != nil {\n   838\t\t\t\t\tm.FindingsPerRound[n-1] = len(draft.Findings)\n   839\t\t\t\t}\n   840\t\t\t\tapproved := !invalid && draftReviewDecision(r.Output) == \"approved\"\n   841\t\t\t\tif m.RoundsToApproval == nil && approved {\n   842\t\t\t\t\tat := n\n   843\t\t\t\t\tm.RoundsToApproval = &at\n   844\t\t\t\t}\n   845\t\t\t\tif n < 2 {\n   846\t\t\t\t\tcontinue\n   847\t\t\t\t}\n   848\t\t\t\tkind := &m.Cold\n   849\t\t\t\tif r.Thread.continued() {\n   850\t\t\t\t\tkind = &m.Continued\n   851\t\t\t\t}\n   852\t\t\t\tkind.Rounds++\n   853\t\t\t\tpoint := ReviewRoundPoint{Round: n, Approved: approved, Invalid: invalid || draft == nil}\n   854\t\t\t\tif draft != nil {\n   855\t\t\t\t\tpoint.Findings = len(draft.Findings)\n   856\t\t\t\t}\n   857\t\t\t\tkind.Trajectory = append(kind.Trajectory, point)\n   858\t\t\t\tif invalid || draft == nil {\n   859\t\t\t\t\tkind.InvalidRounds++\n   860\t\t\t\t\tcontinue\n   861\t\t\t\t}\n   862\t\t\t\tkind.Findings += len(draft.Findings)\n   863\t\t\t\tif approved {\n   864\t\t\t\t\tkind.Approvals++\n   865\t\t\t\t\tif kind.RoundsToApproval == nil {\n   866\t\t\t\t\t\tat := n\n   867\t\t\t\t\t\tkind.RoundsToApproval = &at\n   868\t\t\t\t\t}\n   869\t\t\t\t}\n   870\t\t\t\tfor _, p := range draft.PriorFindings {\n   165\t\n   166\t// Review round 1, B5, B7, B8: the rounds recorded never drop when a run is\n   167\t// superseded; an invalid draft counts as invalid, never as an approval or a\n   168\t// convergence; continued and cold rounds report the same figures.\n   169\tfunc TestReviewRoundMetricsNeverLowerOrLaunder(t *testing.T) {\n   170\t\tapproved := draftOutput(\"approved\", `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"approved\",\"findings\":[],\"prior_findings\":[{\"id\":\"R1-B1\",\"status\":\"fixed\",\"evidence\":\"x\"}],\"sweep\":\"all\"}`)\n   171\t\truns := []ReviewRun{\n   172\t\t\t{RunID: \"a\", Scope: \"spec:s\", Kind: ReviewBriefKindReview, Status: ReviewRunCompleted, Round: 1, Output: draftOutput(\"changes-requested\", `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"changes-requested\",\"findings\":[{\"id\":\"B1\",\"severity\":\"low\",\"disposition\":\"blocker\",\"summary\":\"x\"}]}`)},\n   173\t\t\t{RunID: \"b\", Scope: \"spec:s\", Kind: ReviewBriefKindReview, Status: ReviewRunCompleted, Round: 2, Output: approved, SupersededBy: \"c\", Thread: &ReviewThread{Round: 2, Mode: ReviewThreadContinued}},\n   174\t\t\t{RunID: \"c\", Scope: \"spec:s\", Kind: ReviewBriefKindReview, Status: ReviewRunFailed, Round: 2},\n   175\t\t}\n   176\t\tif m := reviewRoundMetrics(runs); len(m) != 1 || m[0].Rounds != 2 {\n   177\t\t\tt.Fatalf(\"a superseded round lowered the rounds: %+v\", m)\n   178\t\t}\n   179\t\truns[1].SupersededBy, runs[1].DraftProblems = \"\", []string{\"prior finding R1-B2 is not accounted for\"}\n   180\t\tm := reviewRoundMetrics(runs)[0]\n   181\t\tif m.RoundsToApproval != nil || m.InvalidRounds != 1 || m.Continued.InvalidRounds != 1 || m.Continued.Fixed != 0 || m.Continued.FixedShare != nil {\n   182\t\t\tt.Fatalf(\"an invalid draft counted as convergence: %+v\", m)\n   183\t\t}\n   184\t\truns[1].DraftProblems = nil\n   185\t\tm = reviewRoundMetrics(runs)[0]\n   186\t\tif m.RoundsToApproval == nil || *m.RoundsToApproval != 2 || m.Continued.Approvals != 1 || m.Continued.Accounted != 1 || m.Continued.PartialShare == nil || m.Cold.Rounds != 0 {\n   187\t\t\tt.Fatalf(\"continued figures: %+v\", m.Continued)\n   188\t\t}\n   189\t}\n   190\t\n   191\t// Review round 2: a decision line that contradicts the block makes the draft\n   192\t// invalid however many there are (R2-B1); fences are whole lines, LF or\n   193\t// CRLF, and a malformed one is an error, not an absent block (R2-B2); an\n   194\t// account of a finding no round reported is a problem (R2-B3); the run that\n   195\t// ended last concludes a bundle (R2-F1); each kind has its own trajectory\n   196\t// and approval round (R2-B4).\n   197\tfunc TestReviewRoundsHoldAgainstTheSecondReview(t *testing.T) {\n   198\t\tblock := \"```pose-draft\\n\" + `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"approved\",\"findings\":[]}` + \"\\n```\\n\"\n   199\t\tfor name, out := range map[string]string{\n   200\t\t\t\"two contradicting lines\": \"decision: rejected\\ndecision: rejected\\n\" + block,\n   201\t\t\t\"invalid line\":            \"decision: maybe\\n\" + block,\n   202\t\t\t\"bad closing fence\":       \"```pose-draft\\n\" + `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"approved\",\"findings\":[]}` + \"\\n```not-a-closing-fence\\n\",\n   203\t\t\t\"indented opening\":        \"  ```pose-draft\\n\" + `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"approved\",\"findings\":[]}` + \"\\n```\\n\",\n   204\t\t\t\"crlf bad schema\":         \"decision: approved\\r\\n```pose-draft\\r\\n\" + `{\"schema\":\"bad\",\"decision\":\"approved\",\"findings\":[]}` + \"\\r\\n```\\r\\n\",\n   205\t\t} {\n","exit_code":0,"status":"completed"}}
