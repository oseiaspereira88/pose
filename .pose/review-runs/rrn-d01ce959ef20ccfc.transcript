{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch_unix.go | sed -n '1,90p' && nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '1040,1085p'\"","aggregated_output":"     1\t//go:build !windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"context\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"runtime\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"sync\"\n    15\t\t\"syscall\"\n    16\t\t\"time\"\n    17\t)\n    18\t\n    19\t// isolateProcessGroup starts the adapter in its own process group, and makes\n    20\t// the context's cancellation kill that whole group.\n    21\tfunc isolateProcessGroup(cmd *exec.Cmd) {\n    22\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n    23\t\tcmd.Cancel = func() error {\n    24\t\t\treturn syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\n    25\t\t}\n    26\t}\n    27\t\n    28\t// killProcessGroup ends whatever the adapter left running.\n    29\tfunc killProcessGroup(cmd *exec.Cmd) error {\n    30\t\tif cmd.Process == nil {\n    31\t\t\treturn nil\n    32\t\t}\n    33\t\terr := syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\n    34\t\tif errors.Is(err, syscall.ESRCH) {\n    35\t\t\treturn nil\n    36\t\t}\n    37\t\tif err != nil {\n    38\t\t\treturn err\n    39\t\t}\n    40\t\treturn verifyReviewProcessGroup(cmd.Process.Pid)\n    41\t}\n    42\tfunc openReviewAdapterFile(path string) (*os.File, error) {\n    43\t\tfd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)\n    44\t\tif err != nil {\n    45\t\t\treturn nil, err\n    46\t\t}\n    47\t\treturn os.NewFile(uintptr(fd), path), nil\n    48\t}\n    49\tfunc reviewSetupCommand(ctx context.Context, source *exec.Cmd) *exec.Cmd {\n    50\t\tcmd := exec.CommandContext(ctx, source.Path, source.Args[1:]...)\n    51\t\tcmd.Env = source.Env\n    52\t\tisolateProcessGroup(cmd)\n    53\t\tcmd.WaitDelay = time.Second\n    54\t\treturn cmd\n    55\t}\n    56\t\n    57\t// Verify the covered Linux group after SIGKILL. Zombies have terminated and\n    58\t// cannot hold pipes; reaping is their parent's duty. Other Unix ports currently\n    59\t// report signal delivery only and cannot require verified group termination.\n    60\tfunc verifyReviewProcessGroup(pid int) error {\n    61\t\tif runtime.GOOS != \"linux\" {\n    62\t\t\treturn nil\n    63\t\t}\n    64\t\tdeadline := time.Now().Add(time.Second)\n    65\t\tfor {\n    66\t\t\tentries, err := os.ReadDir(\"/proc\")\n    67\t\t\tif err != nil {\n    68\t\t\t\treturn fmt.Errorf(\"process-group termination could not be observed\")\n    69\t\t\t}\n    70\t\t\tif len(entries) > 100000 {\n    71\t\t\t\treturn fmt.Errorf(\"process inventory exceeds coverage\")\n    72\t\t\t}\n    73\t\t\talive := false\n    74\t\t\tfor _, entry := range entries {\n    75\t\t\t\tif _, err := strconv.Atoi(entry.Name()); err != nil {\n    76\t\t\t\t\tcontinue\n    77\t\t\t\t}\n    78\t\t\t\traw, err := os.ReadFile(\"/proc/\" + entry.Name() + \"/stat\")\n    79\t\t\t\tif processGone(err) {\n    80\t\t\t\t\tcontinue\n    81\t\t\t\t}\n    82\t\t\t\tif err != nil {\n    83\t\t\t\t\treturn fmt.Errorf(\"process inventory incomplete\")\n    84\t\t\t\t}\n    85\t\t\t\tend := strings.LastIndex(string(raw), \")\")\n    86\t\t\t\tif end < 0 {\n    87\t\t\t\t\treturn fmt.Errorf(\"process inventory malformed\")\n    88\t\t\t\t}\n    89\t\t\t\tfields := strings.Fields(string(raw[end+1:]))\n    90\t\t\t\tif len(fields) < 3 {\n  1040\t\t\tdefer live.Close()\n  1041\t\t}\n  1042\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n  1043\t\t// only the parent left a child holding stdout, so the timeout never fired\n  1044\t\t// (found in review). The run gets its own process group, the whole group\n  1045\t\t// is killed on timeout and after the run, and pipes are released at most\n  1046\t\t// a few seconds after the kill.\n  1047\t\topaqueBaseline := reviewOpaqueProcessBaseline()\n  1048\t\t// Orphans of the run are reparented to this process, so one that left\n  1049\t\t// the group and cleared its environment is still found (review round 6, N2).\n  1050\t\tisolateProcessGroup(cmd)\n  1051\t\tcmd.WaitDelay = AdapterPipeGrace\n  1052\t\tvar shimReport []byte\n  1053\t\tshimReportDone := make(chan struct{})\n  1054\t\tif useShim {\n  1055\t\t\t// A timeout asks the shim to end the run's subtree first; the group\n  1056\t\t\t// kill after Wait remains the backstop (review round 8, N3).\n  1057\t\t\tcmd.Cancel = stopReviewShim(cmd)\n  1058\t\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n  1059\t\t\tgo func() {\n  1060\t\t\t\tdefer close(shimReportDone)\n  1061\t\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n  1062\t\t\t\t// Whatever exceeds the bound is drained, so the shim never blocks.\n  1063\t\t\t\t_, _ = io.Copy(io.Discard, shimRead)\n  1064\t\t\t}()\n  1065\t\t} else {\n  1066\t\t\tclose(shimReportDone)\n  1067\t\t}\n  1068\t\tvar runErr error\n  1069\t\tprepareReviewProcessTree(cmd)\n  1070\t\tif run.Provenance == nil {\n  1071\t\t\tif runErr = cmd.Start(); runErr == nil {\n  1072\t\t\t\tif runErr = attachReviewProcessTree(cmd); runErr == nil {\n  1073\t\t\t\t\trunErr = cmd.Wait()\n  1074\t\t\t\t} else {\n  1075\t\t\t\t\t_ = cmd.Wait()\n  1076\t\t\t\t}\n  1077\t\t\t}\n  1078\t\t} else {\n  1079\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1080\t\t\trunErr = err\n  1081\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1082\t\t\tif started {\n  1083\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1084\t\t\t}\n  1085\t\t}\n","exit_code":0,"status":"completed"}}
