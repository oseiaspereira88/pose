{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_shim.go | sed -n '1,130p' && nl -ba pose-mcp/internal/pose/review_reap_other.go && nl -ba pose-mcp/internal/pose/review_tree_other.go && nl -ba pose-mcp/internal/pose/review_tree_windows_test.go | sed -n '1,100p' && nl -ba pose-mcp/internal/pose/review_shim_test.go | sed -n '1,140p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"encoding/json\"\n     5\t\t\"time\"\n     6\t)\n     7\t\n     8\t// The review run shim (spec pose-review-run-reaps-lingering-reviewer-processes,\n     9\t// review rounds 6 and 8): a descendant of the reviewer that leaves the\n    10\t// adapter's process group, starts its own session and clears its environment\n    11\t// matches neither the group kill nor the sealed-checkout entry. Making the\n    12\t// dispatcher a child subreaper caught it, but a subreaper is process-wide:\n    13\t// in the dispatching process it also adopted and ended children other code\n    14\t// started there (a detached delegation), and reaped processes another\n    15\t// goroutine was waiting for. The dispatcher therefore starts the adapter\n    16\t// through a shim, the same executable re-entered with ReviewShimArg, which\n    17\t// makes itself the subreaper, runs the adapter, and, once it exits, ends\n    18\t// every process left in its subtree. The shim has no other children, so\n    19\t// everything it adopts is the run's. A timeout asks the shim to stop with\n    20\t// SIGTERM, and the death of the dispatcher delivers it the same signal: in\n    21\t// both cases it ends the subtree before it exits (review round 8, N3, N4).\n    22\t\n    23\t// reviewReapWait bounds how long ending the run's leftover processes takes.\n    24\tconst reviewReapWait = 5 * time.Second\n    25\t\n    26\t// ReviewShimArg is the first argument that runs the executable as a review\n    27\t// run shim instead of the CLI.\n    28\tconst ReviewShimArg = \"__pose-review-run-shim\"\n    29\t\n    30\t// ReviewShimReportEnv tells the shim that the dispatcher passed it a report\n    31\t// pipe as file descriptor 3, and names the dispatcher's pid. The report never\n    32\t// goes to a path the reviewer can write (review round 8, N2).\n    33\tconst ReviewShimReportEnv = \"POSE_REVIEW_SHIM_REPORT\"\n    34\t\n    35\t// ReviewShimAvailable says the running executable handles ReviewShimArg. It\n    36\t// is set by the pose command and by the test binaries that dispatch; any\n    37\t// other embedder starts the adapter directly, without the shim.\n    38\tvar ReviewShimAvailable = false\n    39\t\n    40\t// reviewShimReport is what the shim found after the adapter exited.\n    41\ttype reviewShimReport struct {\n    42\t\tEnded      []string `json:\"ended\"`\n    43\t\tEndedTotal int      `json:\"ended_total\"`\n    44\t\tError      string   `json:\"error,omitempty\"`\n    45\t}\n    46\t\n    47\t// reviewShimReportMaxPids bounds the pids a report lists; EndedTotal counts\n    48\t// them all. A full report stays far below the dispatcher's read bound.\n    49\tconst reviewShimReportMaxPids = 1000\n    50\t\n    51\t// boundedReviewShimReport encodes r within the dispatcher's read bound, so\n    52\t// the dispatcher always reads it whole (review round 9, N2).\n    53\tfunc boundedReviewShimReport(r reviewShimReport) []byte {\n    54\t\tr.EndedTotal = len(r.Ended)\n    55\t\tif len(r.Ended) > reviewShimReportMaxPids {\n    56\t\t\tr.Ended = r.Ended[:reviewShimReportMaxPids]\n    57\t\t}\n    58\t\tif len(r.Error) > 4096 {\n    59\t\t\tr.Error = r.Error[:4096]\n    60\t\t}\n    61\t\traw, _ := json.Marshal(r)\n    62\t\treturn raw\n    63\t}\n     1\t//go:build !linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport \"os/exec\"\n     6\t\n     7\t// reapSealedCheckoutProcesses has no portable way to read another process's\n     8\t// environment; outside Linux the process-group kill is the only termination.\n     9\tfunc reapSealedCheckoutProcesses(string, map[int]string) ([]string, int, error) { return nil, 0, nil }\n    10\t\n    11\tfunc reviewOpaqueProcessBaseline() map[int]string { return nil }\n    12\t\n    13\t// RunReviewShim is the Linux review run shim; elsewhere it is not used.\n    14\tfunc RunReviewShim(args []string) int { return 125 }\n    15\t\n    16\tfunc parseReviewShimReport([]byte) (reviewShimReport, error) { return reviewShimReport{}, nil }\n    17\t\n    18\tfunc stopReviewShim(cmd *exec.Cmd) func() error { return cmd.Cancel }\n     1\t//go:build !windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport \"os/exec\"\n     6\t\n     7\t// On Unix the process group, and on Linux the review run shim, end the\n     8\t// reviewer's tree; these are the Windows job object's hooks.\n     9\tfunc prepareReviewProcessTree(*exec.Cmd)       {}\n    10\tfunc attachReviewProcessTree(*exec.Cmd) error  { return nil }\n    11\tfunc releaseReviewProcessTree(*exec.Cmd) error { return nil }\n     1\t//go:build windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os/exec\"\n     7\t\t\"testing\"\n     8\t\t\"time\"\n     9\t)\n    10\t\n    11\t// Spec pose-review-run-reaps-lingering-reviewer-processes, review round 13,\n    12\t// N1: on Windows the reviewer's tree runs in a job object, and releasing it\n    13\t// ends the descendants the reviewer started.\n    14\tfunc TestTheReviewersJobEndsItsDescendants(t *testing.T) {\n    15\t\t// cmd starts ping as a child and waits for it: both must end with the job.\n    16\t\tcmd := exec.Command(\"cmd\", \"/c\", \"ping -n 60 127.0.0.1 >NUL\")\n    17\t\tprepareReviewProcessTree(cmd)\n    18\t\tif err := cmd.Start(); err != nil {\n    19\t\t\tt.Fatal(err)\n    20\t\t}\n    21\t\tif err := attachReviewProcessTree(cmd); err != nil {\n    22\t\t\tt.Fatal(err)\n    23\t\t}\n    24\t\ttime.Sleep(500 * time.Millisecond)\n    25\t\tstarted := time.Now()\n    26\t\tif err := releaseReviewProcessTree(cmd); err != nil {\n    27\t\t\tt.Fatalf(\"the job did not end its processes: %v\", err)\n    28\t\t}\n    29\t\tdone := make(chan error, 1)\n    30\t\tgo func() { done <- cmd.Wait() }()\n    31\t\tselect {\n    32\t\tcase <-done:\n    33\t\tcase <-time.After(10 * time.Second):\n    34\t\t\tt.Fatal(\"the reviewer outlived its job\")\n    35\t\t}\n    36\t\tif time.Since(started) > 10*time.Second {\n    37\t\t\tt.Fatal(\"ending the job took too long\")\n    38\t\t}\n    39\t}\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"encoding/json\"\n     5\t\t\"strconv\"\n     6\t\t\"strings\"\n     7\t\t\"testing\"\n     8\t)\n     9\t\n    10\t// Review round 9, N2: however many processes the shim ended, its report fits\n    11\t// the dispatcher's read bound and still counts them all.\n    12\tfunc TestTheShimReportIsBounded(t *testing.T) {\n    13\t\tr := reviewShimReport{Error: strings.Repeat(\"e\", 100000)}\n    14\t\tfor i := 0; i < 50000; i++ {\n    15\t\t\tr.Ended = append(r.Ended, strconv.Itoa(4000000+i))\n    16\t\t}\n    17\t\traw := boundedReviewShimReport(r)\n    18\t\tif len(raw) >= 64<<10 {\n    19\t\t\tt.Fatalf(\"the report is %d bytes, beyond the dispatcher's 64 KiB read\", len(raw))\n    20\t\t}\n    21\t\tvar got reviewShimReport\n    22\t\tif err := json.Unmarshal(raw, &got); err != nil || got.EndedTotal != 50000 || len(got.Ended) != reviewShimReportMaxPids {\n    23\t\t\tt.Fatalf(\"the bounded report lost its count: %d of %d, %v\", len(got.Ended), got.EndedTotal, err)\n    24\t\t}\n    25\t}\n","exit_code":0,"status":"completed"}}
