err != nil {\n   332\t\t\t\treturn nil, err\n   333\t\t\t}\n   334\t\t\tout = append(out, a)\n   335\t\t}\n   336\t\t// Orphan receipts are an unknown history, never ignored.\n   337\t\tfor _, e := range entries {\n   338\t\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n   339\t\t\t\tfound := false\n   340\t\t\t\tfor _, a := range out {\n   341\t\t\t\t\tif filepath.Base(attemptReceiptPath(s.Root, a)) == e.Name() {\n   342\t\t\t\t\t\tfound = true\n   343\t\t\t\t\t\tbreak\n   344\t\t\t\t\t}\n   345\t\t\t\t}\n   346\t\t\t\tif !found {\n   347\t\t\t\t\treturn nil, fmt.Errorf(\"attempt receipt has no reservation: %s\", e.Name())\n   348\t\t\t\t}\n   349\t\t\t}\n   350\t\t}\n   351\t\treturn out, nil\n   352\t}\n   353\tfunc (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (reviewAttemptReceipt, error) {\n   354\t\tbudget := reviewReadBudget(budgets)\n   355\t\tvar r reviewAttemptReceipt\n   356\t\tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n   357\t\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n   358\t\t}\n   359\t\tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n   360\t\t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n   361\t\t}\n   362\t\tvar run ReviewRun\n   363\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, r.RunID+\".json\"), &run, budget); err != nil {\n   364\t\t\treturn r, err\n   365\t\t}\n   366\t\traw, _ := json.Marshal(run)\n   367\t\tif run.AttemptID != a.AttemptID || run.BundleID != a.BundleID || run.BundleDigest != a.BundleDigest || run.Adapter != a.Adapter || digestBytes(raw) != r.RunDigest {\n   368\t\t\treturn r, fmt.Errorf(\"attempt receipt does not bind