roup and cleared its environment is still found (review round 6, N2).\n  1050\t\tisolateProcessGroup(cmd)\n  1051\t\tcmd.WaitDelay = AdapterPipeGrace\n  1052\t\tvar shimReport []byte\n  1053\t\tshimReportDone := make(chan struct{})\n  1054\t\tif useShim {\n  1055\t\t\t// A timeout asks the shim to end the run's subtree first; the group\n  1056\t\t\t// kill after Wait remains the backstop (review round 8, N3).\n  1057\t\t\tcmd.Cancel = stopReviewShim(cmd)\n  1058\t\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n  1059\t\t\tgo func() {\n  1060\t\t\t\tdefer close(shimReportDone)\n  1061\t\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n  1062\t\t\t\t// Whatever exceeds the bound is drained, so the shim never blocks.\n  1063\t\t\t\t_, _ = io.Copy(io.Discard, shimRead)\n  1064\t\t\t}()\n  1065\t\t} else {\n  1066\t\t\tclose(shimReportDone)\n  1067\t\t}\n  1068\t\tvar runErr error\n  1069\t\tprepareReviewProcessTree(cmd)\n  1070\t\tif run.Provenance == nil {\n  1071\t\t\tif runErr = cmd.Start(); runErr == nil {\n  1072\t\t\t\tif runErr = attachReviewProcessTree(cmd); runErr == nil {\n  1073\t\t\t\t\trunErr = cmd.Wait()\n  1074\t\t\t\t} else {\n  1075\t\t\t\t\t_ = cmd.Wait()\n  1076\t\t\t\t}\n  1077\t\t\t}\n  1078\t\t} else {\n  1079\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1080\t\t\trunErr = err\n  1081\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1082\t\t\tif started {\n  1083\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1084\t\t\t}\n  1085\t\t}\n  1086\t\tif useShim && safety != nil {\n  1087\t\t\t// With the shim the run's leftovers are its subtree, not an\n  1088\t\t\t// environment match (review round 9, N1).\n  1089\t\t\tfor i, limit := range safety.Limitations {\n  1090\t\t\t\tif strings.HasPrefix(limit, \"no memory/CPU quota;\") {\n  1091\t\t\t\t\tsafety.Limitations[i] = \"no memory/CPU quota; the review run shim ends every process left in the run's subtree, including one in its own session\"\n  1092\t\t\t\t}\n  1093\t\t\t}\n  1094\t\t}\n  1095\t\tif useShim {\n  1096\t\t\t_ = shimWrite.Close()\n  1097\t\t\t<-shimReportDone\n  1098\t\t\t_ = shimRead.Close()\n  1099\t\t}\n  1100\t\tterminationErr = errors.Join(killProcessGroup(cmd), releaseReviewProcessTree(cmd))\n  1101\t\t// A command the reviewer left running in a session of its own escapes the\n  1102\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1103\t\t// directories it may still write (spec\n  1104\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1105\t\t// The environment entry is the reviewer's to set, so it is searched only\n  1106\t\t// without the shim, whose subtree is the run's by construction (review\n  1107\t\t// round 8, N1).\n  1108\t\tvar reaped []string\n  1109\t\tshimMore := 0\n  1110\t\tvar opaque int\n  1111\t\tvar reapErr error\n  1112\t\tif !useShim {\n  1113\t\t\treaped, opaque, reapErr = reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n  1114\t\t\tif reapErr != nil {\n  1115\t\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1116\t\t\t}\n  1117\t\t}\n  1118\t\tif useShim && cmd.ProcessState != nil {\n  1119\t\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n  1120\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1121\t\t\t} else {\n  1122\t\t\t\tfor _, pid := range report.Ended {\n  1123\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1124\t\t\t\t}\n  1125\t\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n  1126\t\t\t\t\t// Counted from the total, not from the listed pids (review\n  1127\t\t\t\t\t// round 12, N3).\n  1128\t\t\t\t\tshimMore = more\n  1129\t\t\t\t}\n  1130\t\t\t\tif report.Error != \"\" {\n  1131\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1132\t\t\t\t\t// The shim's own words go into the record, not only the\n  1133\t\t\t\t\t// generic failure (review round 10, N3).\n  1134\t\t\t\t\tif safety != nil {\n  1135\t\t\t\t\t\tsafety.Limitations = append(safety.Limitations, \"the review run shim could not end the whole subtree: \"+report.Error)\n  1136\t\t\t\t\t}\n  1137\t\t\t\t}\n  1138\t\t\t}\n  1139\t\t}\n  1140\t\tif endedCount := len(reaped) + shimMore; endedCount > 0 && safety != nil {\n  1141\t\t\tlisted := strings.Join(reaped, \", \")\n  1142\t\t\tif shimMore > 0 {\n  1143\t\t\t\tlisted += fmt.Sprintf(\" and %d more (orphaned)\", shimMore)\n  1144\t\t\t}\n  1145\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(endedCount)+\" process(es) the run left running: \"+listed)\n  1146\t\t}\n  1147\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1148\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1149\t\t}\n  1150\t\tterminationFailed = terminationErr != nil\n  1151\t\t// The adapter exited and a child it left still held the output when\n  1152\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1153\t\t// the exit status decides (found in review).\n  1154\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1155\t\t\trunErr = nil\n  1156\t\t}\n  1157\t\ttranscript, overflow := combined.result()\n  1158\t\tsafety.CaptureComplete = !overflow\n  1159\t\tif cmd.ProcessState != nil {\n  1160\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1161\t\t}\n  1162\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n  1163\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n  1164\t\t\tsafety.CaptureComplete = false\n  1165\t\t}\n  1166\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1167\t\t\trun.Output = string(raw)\n  1168\t\t\tif run.Provenance != nil {\n  1169\t\t\t\trun.Provenance.OutputComplete = true\n  1170\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1171\t\t\t}\n  1172\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1173\t\t\t// The agent writes no output file; its stream names its final message.\n  1174\t\t\trun.Output = final\n  1175\t\t\tif run.Provenance != nil {\n  1176\t\t\t\trun.Provenance.OutputComplete = true\n  1177\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1178\t\t\t}\n  1179\t\t} else {\n  1180\t\t\trun.Output = tail(string(transcript), 20000)\n  1181\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1182\t\t\t\tsafety.CaptureComplete = false\n  1183\t\t\t}\n  1184\t\t\tif run.Provenance != nil {\n  1185\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1186\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1187\t\t\t}\n  1188\t\t}\n  1189\t\tif run.Provenance != nil {\n  1190\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n  1191\t\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n  1192\t\t}\n  1193\t\tif runErr != nil && cmd.ProcessState == nil {\n  1194\t\t\trun.Output, transcript = \"\", nil\n  1195\t\t\tif run.Provenance != nil {\n  1196\t\t\t\trun.Provenance.OutputComplete = false\n  1197\t\t\t}\n  1198\t\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n  1199\t\t}\n  1200\t\t// Raw provenance hashes above precede redaction; only complete, bounded\n  1201\t\t// redacted channels can be retained. Partial boundaries can expose a secret.\n  1202\t\tsafety.ExecutionCause = executionCause(ctx)\n  1203\t\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n  1204\t\t\tsafety.CaptureComplete = false\n  1205\t\t}\n  1206\t\tif !safety.CaptureComplete {\n  1207\t\t\ttranscript = nil\n  1208\t\t\trun.Output = \"\"\n  1209\t\t\tif run.Provenance != nil {\n  1210\t\t\t\trun.Provenance.OutputComplete = false\n  1211\t\t\t}\n  1212\t\t\tif terminationErr != nil {\n  1213\t\t\t\treturn finish(ReviewRunFailed, \"process group termination failed; descendants may remain\")\n  1214\t\t\t}\n  1215\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1216\t\t\treturn finish(ReviewRunFailed, \"adapter capture incomplete: stream/output limit or unsafe output file\")\n  1217\t\t}\n  1218\t\tcaptureStage := \"session/interrupt recognition\"\n  1219\t\tstatus, failure, captureErr := s.classifyReviewInterruption(&run, plan, transcript, runErr, ctx.Err())\n  1220\t\tif captureErr == nil {\n  1221\t\t\tvar redactErr error\n  1222\t\t\traw := transcript\n  1223\t\t\tcaptureStage = \"stdout\"\n  1224\t\t\ttranscript, redactErr = redactReviewCapture(transcript, secrets, run.sessionForRedaction, safety.StreamBytes)\n  1225\t\t\tvar output []byte\n  1226\t\t\tif redactErr == nil {\n  1227\t\t\t\tcaptureStage = \"final output\"\n  1228\t\t\t\toutput, redactErr = redactReviewCapture([]byte(run.Output), secrets, run.sessionForRedaction, safety.OutputBytes)\n  1229\t\t\t}\n  1230\t\t\trun.Output = string(output)\n  1231\t\t\tif redactErr == nil && run.Events != \"\" {\n  1232\t\t\t\tcaptureStage = \"normalized events\"\n  1233\t\t\t\t// Events are parsed from the decoded stream, where a JSON escape no longer\n  1234\t\t\t\t// hides a value: each text is redacted again after decoding.\n  1235\t\t\t\trun.eventsBytes, redactErr = redactedDelegationEvents(run.Events, raw, run.Output, secrets, run.sessionForRedaction)\n  1236\t\t\t}\n  1237\t\t\tif redactErr != nil {\n  1238\t\t\t\tcaptureErr = redactErr\n  1239\t\t\t}\n  1240\t\t}\n  1460\t\t\t\t\treturn err\n  1461\t\t\t\t}\n  1462\t\t\t\tif _, err := dispatchWorktreeIdentity(full); err != nil {\n  1463\t\t\t\t\treturn err\n  1464\t\t\t\t}\n  1465\t\t\t\thead, err := snapshotGit(full, \"rev-parse\", \"--verify\", \"HEAD\")\n  1466\t\t\t\tif err != nil {\n  1467\t\t\t\t\treturn err\n  1468\t\t\t\t}\n  1469\t\t\t\tif digestBytes([]byte(strings.TrimSpace(string(head)))) != entry.Digest {\n  1470\t\t\t\t\treturn fmt.Errorf(\"dispatch input conflict: submodule %q moved\", path)\n  1471\t\t\t\t}\n  1472\t\t\t\tif err := verifyDispatchWorktree(full, strings.TrimSpace(string(head))); err != nil {\n  1473\t\t\t\t\treturn err\n  1474\t\t\t\t}\n  1475\t\t\t\tcontinue\n  1476\t\t\t}\n  1477\t\t\tif entry.Action == \"removed\" {\n  1478\t\t\t\tif _, err := os.Lstat(filepath.Join(root, filepath.FromSlash(path))); !errors.Is(err, os.ErrNotExist) {\n  1479\t\t\t\t\treturn fmt.Errorf(\"dispatch input conflict: removed path %q exists or is unreadable\", path)\n  1480\t\t\t\t}\n  1481\t\t\t\tcontinue\n  1482\t\t\t}\n  1483\t\t\tif err := verifyDispatchInput(root, path, entry.Digest, true); err != nil {\n  1484\t\t\t\treturn err\n  1485\t\t\t}\n  1486\t\t}\n  1487\t\tfor _, input := range bundle.Payload.ConsumedInputs {\n  1488\t\t\tswitch input.Kind {\n  1489\t\t\tcase \"governed-config\", \"review-profile\", \"rule\":\n  1490\t\t\t\tif err := verifyDispatchInput(root, input.Path, input.Digest, false); err != nil {\n  1491\t\t\t\t\treturn err\n  1492\t\t\t\t}\n  1493\t\t\t}\n  1494\t\t}\n  1495\t\treturn nil\n  1496\t}\n  1497\t\n  1498\tfunc dispatchInputPath(root, path string) (string, error) {\n  1499\t\tvar err error\n  1500\t\troot, err = filepath.Abs(root)\n  1501\t\tif err != nil {\n  1502\t\t\treturn \"\", &GitSnapshotError{\"root\", err}\n  1503\t\t}\n  1504\t\tif path == \"\" || filepath.IsAbs(path) || filepath.ToSlash(filepath.Clean(path)) != path || path == \"..\" || strings.HasPrefix(path, \"../\") {\n  1505\t\t\treturn \"\", fmt.Errorf(\"dispatch input conflict: unsafe path %q\", path)\n  1506\t\t}\n  1507\t\tfull := filepath.Join(root, filepath.FromSlash(path))\n  1508\t\tfor parent := full; parent != root; parent = filepath.Dir(parent) {\n  1509\t\t\tinfo, err := os.Lstat(parent)\n  1510\t\t\tif err != nil {\n  1511\t\t\t\treturn \"\", &GitSnapshotError{\"input \" + path, err}\n  1512\t\t\t}\n  1513\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n  1514\t\t\t\treturn \"\", fmt.Errorf(\"dispatch input conflict: symlink %q\", path)\n  1515\t\t\t}\n  1516\t\t}\n  1517\t\treturn full, nil\n  1518\t}\n  1519\t\n  1520\tfunc verifyDispatchInput(root, path, digest string, normalize bool) error {\n  1521\t\tfull, err := dispatchRegularInputPath(root, path)\n  1522\t\tif err != nil {\n  1523\t\t\treturn err\n  1524\t\t}\n  1525\t\tfile, err := os.Open(full)\n  1526\t\tif err != nil {\n  1527\t\t\treturn &GitSnapshotError{\"input \" + path, err}\n  1528\t\t}\n  1529\t\traw, readErr := io.ReadAll(io.LimitReader(file, (256<<20)+1))\n  1530\t\tcloseErr := file.Close()\n  1531\t\tif readErr != nil {\n  1532\t\t\treturn &GitSnapshotError{\"input \" + path, readErr}\n  1533\t\t}\n  1534\t\tif closeErr != nil {\n  1535\t\t\treturn &GitSnapshotError{\"input \" + path, closeErr}\n  1536\t\t}\n  1537\t\tif len(raw) > 256<<20 {\n  1538\t\t\treturn &GitSnapshotError{\"input \" + path, fmt.Errorf(\"input exceeds 256 MiB\")}\n  1539\t\t}\n  1540\t\tif normalize {\n  1541\t\t\traw = bytes.ReplaceAll(raw, []byte(\"\\r\\n\"), []byte(\"\\n\"))\n  1542\t\t}\n  1543\t\tif digest == \"\" || digestBytes(raw) != digest {\n  1544\t\t\treturn fmt.Errorf(\"dispatch input conflict: sealed bytes changed for %q\", path)\n  1545\t\t}\n  1546\t\treturn nil\n  1547\t}\n  1548\t\n  1549\tfunc dispatchRegularInputPath(root, path string) (string, error) {\n  1550\t\tfull, err := dispatchInputPath(root, path)\n  1551\t\tif err != nil {\n  1552\t\t\treturn \"\", err\n  1553\t\t}\n  1554\t\tinfo, err := os.Lstat(full)\n  1555\t\tif err != nil {\n  1556\t\t\treturn \"\", &GitSnapshotError{\"input \" + path, err}\n  1557\t\t}\n  1558\t\tif !info.Mode().IsRegular() {\n  1559\t\t\treturn \"\", fmt.Errorf(\"dispatch input conflict: %q is not a regular file\", path)\n  1560\t\t}\n  1561\t\treturn full, nil\n  1562\t}\n  1563\t\n  1564\t// ReviewerArgv expands a command template: \"{effort}\" becomes the argv\n  1565\t// fragment of the effort level (the agent's default when level is \"\"), and\n  1566\t// \"{output}\" and \"{session}\" become their values. Schema 2 templates hold\n  1567\t// placeholders only as whole elements; schema 1 templates keep their\n  1568\t// in-element replacement.\n  1569\tfunc ReviewerArgv(command []string, output, session, level string, effort *ReviewerEffort) []string {\n  1570\t\targv := make([]string, 0, len(command))\n  1571\t\tfor _, arg := range command {\n  1572\t\t\tif arg == \"{effort}\" {\n  1573\t\t\t\tif effort != nil {\n  1574\t\t\t\t\tif level == \"\" {\n  1575\t\t\t\t\t\tlevel = effort.Default\n  1576\t\t\t\t\t}\n  1577\t\t\t\t\targv = append(argv, effort.Levels[level]...)\n  1578\t\t\t\t}\n  1579\t\t\t\tcontinue\n  1580\t\t\t}\n  1581\t\t\targv = append(argv, strings.ReplaceAll(strings.ReplaceAll(arg, \"{output}\", output), \"{session}\", session))\n  1582\t\t}\n  1583\t\treturn argv\n  1584\t}\n  1585\t\n  1586\tfunc tail(s string, n int) string {\n  1587\t\tif len(s) <= n {\n  1588\t\t\treturn s\n  1589\t\t}\n  1590\t\treturn s[len(s)-n:]\n  1591\t}\n  1592\t\n  1593\t// afterRunWitnessPublished runs between a run's witness and its record;\n  1594\t// tests use it to stop a recording there.\n  1595\tvar afterRunWitnessPublished = func(ReviewRun) error { return nil }\n  1596\t\n  1597\t// beforeAttemptPublished runs between the active marker and the reservation;\n  1598\t// tests use it to stop a dispatch there.\n  1599\tvar beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {}\n  1600\t\n  1601\t// identifiedReviewRun is run as recordReviewRun persists it, with its\n  1602\t// content identity: the same content always yields the same run id.\n  1603\tfunc identifiedReviewRun(run ReviewRun, transcript []byte) (ReviewRun, []byte) {\n  1604\t\t// Identity covers only persisted content, never fields derived by a reader\n  1605\t\t// or a previous write of a copied record.\n  1606\t\trun.RunID, run.Path, run.TranscriptPath, run.SupersededBy = \"\", \"\", \"\", \"\"\n  1607\t\trun.LedgerVersion = 1\n  1608\t\tsum := sha256.Sum256(transcript)\n  1609\t\trun.TranscriptDigest = \"sha256:\" + hex.EncodeToString(sum[:])\n  1610\t\tvar events []byte\n  1611\t\trun.EventsDigest = \"\"\n  1612\t\tif run.Events != \"\" {\n  1613\t\t\tevents = run.eventsBytes\n  1614\t\t\trun.EventsDigest = digestBytes(events)\n  1615\t\t}\n  1616\t\trun.eventsBytes = nil // never part of the record or of a copy compared with it\n  1617\t\tidentity, _ := json.Marshal(run)\n  1618\t\tidSum := sha256.Sum256(identity)\n  1619\t\trun.RunID = \"rrn-\" + hex.EncodeToString(idSum[:])[:16]\n  1620\t\treturn run, events\n  1621\t}\n  1622\t\n  1623\tfunc (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\n  1624\t\trun, events := identifiedReviewRun(run, transcript)\n  1625\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, reviewRunsDir, true)\n  1626\t\tif err != nil {\n  1627\t\t\treturn ReviewRun{}, err\n  1628\t\t}\n  1629\t\trun.TranscriptPath = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\"))\n  1630\t\tpretty, err := json.MarshalIndent(run, \"\", \"  \")\n  1631\t\tif err != nil {\n  1632\t\t\treturn ReviewRun{}, err\n  1633\t\t}\n  1634\t\tpretty = append(pretty, '\\n')\n  1635\t\tif len(pretty) > reviewLedgerMaxBytes {\n  1636\t\t\treturn ReviewRun{}, fmt.Errorf(\"review run record exceeds %d-byte bound; nothing published\", reviewLedgerMaxBytes)\n  1637\t\t}\n  1638\t\tif len(transcript) > reviewTranscriptMaxBytes {\n  1639\t\t\treturn ReviewRun{}, fmt.Errorf(\"review transcript exceeds %d-byte bound; nothing published\", reviewTranscriptMaxBytes)\n  1640\t\t}\n  1641\t\n  1642\t\twitness := reviewRunWitness{SchemaVersion: 1, RunID: run.RunID, BundleID: run.BundleID, Scope: run.Scope, RecordDigest: digestBytes(pretty), TranscriptDigest: run.TranscriptDigest}\n  1643\t\t// A publication of identical bytes is accepted, so a recording interrupted\n  1644\t\t// after the witness completes when the same content is recorded again\n  1645\t\t// (spec pose-review-run-reaps-lingering-reviewer-processes, review round\n  1646\t\t// 14, N5).\n  1647\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(filepath.Join(reviewRunLedgerDir, run.RunID+\".json\")), witness); err != nil {\n  1648\t\t\treturn ReviewRun{}, err\n  1649\t\t}\n  1650\t\tif err := afterRunWitnessPublished(run); err != nil {\n  1651\t\t\treturn ReviewRun{}, err\n  1652\t\t}\n  1653\t\tif run.Safety != nil && int64(len(pretty)+len(transcript)+len(events)) > run.Safety.RetainedBytes {\n  1654\t\t\treturn ReviewRun{}, fmt.Errorf(\"retained run exceeds containment byte budget; attempt remains incomplete\")\n  1655\t\t}\n  1656\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".transcript\"), transcript, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1657\t\t\treturn ReviewRun{}, err\n  1658\t\t}\n  1659\t\tif run.EventsDigest != \"\" {\n  1660\t\t\tif err := publishDelegationEvents(dir, run.RunID, events); err != nil {\n  1661\t\t\t\treturn ReviewRun{}, err\n  1662\t\t\t}\n  1663\t\t}\n  1664\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".json\"), pretty, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1665\t\t\treturn ReviewRun{}, err\n  1666\t\t}\n  1667\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".json\"))\n  1668\t\treturn run, nil\n  1669\t}\n  1670\t\n  1671\tfunc (s Store) dispatchNoLongerGoverns(plan DispatchPlan) string {\n  1672\t\tcurrent, err := s.LoadReviewBundle(plan.Bundle.BundleID)\n  1673\t\tif err != nil {\n  1674\t\t\treturn \"stale: the bundle the run reviewed can no longer be read: \" + err.Error()\n  1675\t\t}\n  1676\t\tif current.BundleDigest != plan.Bundle.BundleDigest {\n  1677\t\t\treturn \"stale: the bundle the run reviewed changed while it ran\"\n  1678\t\t}\n  1679\t\t// The baseline is a digest of a policy that was read whole, and the policy must still\n  1680\t\t// read whole and unchanged: a policy that cannot be read now is not an unchanged one.\n  1681\t\tif !directoryDigestKnown(plan.PolicyDigest) {\n  1682\t\t\treturn \"stale: the dispatch has no readable policy baseline (\" + plan.PolicyDigest + \")\"\n  1683\t\t}\n  1684\t\tif now := directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")); now != plan.PolicyDigest {\n  1685\t\t\t// A run recorded before pose update converted reviewers.json keeps its\n  1686\t\t\t// baseline while delegation.json is exactly that conversion (D7).\n  1687\t\t\tif before, ok := s.migratedPolicyBaseline(); !ok || before != plan.PolicyDigest {\n  1688\t\t\t\treturn \"stale: the policy changed or can no longer be read whole while the run was going (\" + now + \")\"\n  1689\t\t\t}\n  1690\t\t}\n  1691\t\t// Every sealed bundle of the scope must have been read: one that cannot be read may be\n  1692\t\t// the one that superseded this.\n  1693\t\tread, readErr := s.ReadReviewBundles(plan.Brief.Scope)\n  1694\t\tif readErr != nil {\n  1695\t\t\treturn \"stale: the bundles of the scope could not be read: \" + readErr.Error()\n  1696\t\t}\n  1697\t\tif !read.Coverage.CompleteFor(plan.Brief.Scope) {\n  1698\t\t\treturn \"stale: a sealed bundle of the scope could not be read, so the run cannot be tied to the one that governs it\"\n  1699\t\t}\n  1700\t\t// The bundle governs while the inputs it sealed are the ones the repository has now:\n  1701\t\t// the semantic digest of today's preparation, not the order of identifiers.\n  1702\t\tprepared, prepErr := s.PrepareReviewBundle(plan.Brief.Scope)\n  1703\t\tif prepErr != nil {\n  1704\t\t\treturn \"stale: the inputs of the scope could not be prepared again: \" + prepErr.Error()\n  1705\t\t}\n  1706\t\tif !sealedBundleMatches(plan.Bundle, prepared) {\n  1707\t\t\treturn \"stale: the bundle was superseded or its inputs changed while the run was going (the scope now prepares \" + prepared.BundleDigest + \")\"\n  1708\t\t}\n  1709\t\t// Equal content is not the governing bundle: a later seal may have replaced\n  1710\t\t// the implementation identity this run was compared with.\n  1711\t\tif governing := governingSealedBundle(read.Bundles, prepared); governing == nil || governing.BundleID != plan.Bundle.BundleID {\n  1712\t\t\treturn \"stale: another sealed bundle of the same content now governs the scope (its implementation identity was sealed again)\"\n  1713\t\t}\n  1714\t\t// An equal digest is not an eligible preparation: a preparation that carries blockers\n  1715\t\t// (an unreadable Git status among them) did not read what it says it read.\n  1716\t\tif len(prepared.Blockers) > 0 {\n  1717\t\t\treturn \"stale: the scope cannot be prepared for review without blockers: \" + strings.Join(prepared.Blockers, \"; \")\n  1718\t\t}\n  1719\t\t// The digest of a file is its bytes; the mode the commit recorded is part of what was\n  1720\t\t// sealed, and a status that is told to ignore modes cannot be the witness of it.\n  1721\t\t// The revision of the source must be readable: an unreadable HEAD is not a HEAD that did not move.\n  1722\t\tif hasGitMetadata(s.Root) {\n  1723\t\t\tif _, headErr := ReadGitHead(s.Root); headErr != nil && !errors.Is(headErr, ErrGitUnavailable) {\n  1724\t\t\t\treturn \"stale: the revision of the source could not be read: \" + headErr.Error()\n  1725\t\t\t}\n  1726\t\t}\n  1727\t\tif mismatch := sourceMaterializationDiffers(s.Root, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries); mismatch != \"\" {\n  1728\t\t\treturn \"stale: the source file \" + mismatch + \" differs from what the sealed commit records\"\n  1729\t\t}\n  1730\t\treturn \"\"\n  1731\t}\n  1732\t\n  1733\t// ReviewRunRecordStands says why the record of a completed run no longer stands, or \"\": the\n  1734\t// run completed with a safe record, no other run superseded it, the persisted record is the\n  1735\t// copy in hand, its transcript is intact and the bundle it names reads with the digest, scope\n  1736\t// and sealed commit it recorded. It asks nothing of the repository as it is now.\n  1737\tfunc (s Store) ReviewRunRecordStands(run ReviewRun) string {\n  1738\t\tif why := reviewSafetyConflict(run); why != \"\" {\n  1739\t\t\treturn why\n  1740\t\t}\n","exit_code":0,"status":"completed"}}
