{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '42,175p' && rg -n 'func cmdDelegateCancel|ReleaseAbandonedAttempt|cancel' pose-mcp/internal/cli/delegate.go pose-mcp/internal/pose/delegation_list.go && nl -ba pose-mcp/internal/cli/delegate.go | sed -n '1000,1155p' && nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '1,240p'\"","aggregated_output":"    42\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    43\t// dispatch ended before recording it, and removes its stalled marker. A\n    44\t// stalled marker whose reservation was never published is only removed; the\n    45\t// returned run is then empty.\n    46\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    47\t\tif !validAttemptFileName(attemptID) {\n    48\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    49\t\t}\n    50\t\tmarkers, _, err := s.ListDelegationActive()\n    51\t\tif err != nil {\n    52\t\t\treturn ReviewRun{}, err\n    53\t\t}\n    54\t\tvar marker *DelegationActiveRun\n    55\t\tfor i := range markers {\n    56\t\t\tif markers[i].AttemptID == attemptID {\n    57\t\t\t\tmarker = &markers[i]\n    58\t\t\t}\n    59\t\t}\n    60\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    61\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    62\t\t}\n    63\t\tdir, err := s.delegationActiveDir(true)\n    64\t\tif err != nil {\n    65\t\t\treturn ReviewRun{}, err\n    66\t\t}\n    67\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    68\t\tif err != nil {\n    69\t\t\treturn ReviewRun{}, err\n    70\t\t}\n    71\t\tdefer lock.Close()\n    72\t\tunlock, err := lockSpecTransferFile(lock)\n    73\t\tif err != nil {\n    74\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    75\t\t}\n    76\t\tdefer unlock()\n    77\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    78\t}\n    79\t\n    80\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    81\t\tvar reserved *DelegatedReviewAttempt\n    82\t\tif marker != nil {\n    83\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    84\t\t\tif err != nil {\n    85\t\t\t\treturn ReviewRun{}, err\n    86\t\t\t}\n    87\t\t\tfor i := range attempts {\n    88\t\t\t\tif attempts[i].AttemptID == attemptID {\n    89\t\t\t\t\treserved = &attempts[i]\n    90\t\t\t\t}\n    91\t\t\t}\n    92\t\t\tif reserved == nil {\n    93\t\t\t\t// The dispatch ended between its marker and its reservation:\n    94\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    95\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    96\t\t\t}\n    97\t\t} else {\n    98\t\t\tif !operatorConfirmed {\n    99\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n   100\t\t\t}\n   101\t\t\torphans, _, err := s.orphanReservations(now)\n   102\t\t\tif err != nil {\n   103\t\t\t\treturn ReviewRun{}, err\n   104\t\t\t}\n   105\t\t\tfor i := range orphans {\n   106\t\t\t\tif orphans[i].AttemptID == attemptID {\n   107\t\t\t\t\treserved = &orphans[i]\n   108\t\t\t\t}\n   109\t\t\t}\n   110\t\t\tif reserved == nil {\n   111\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   112\t\t\t}\n   113\t\t}\n   114\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   115\t\t\t// A release that stopped after the receipt completes by removing\n   116\t\t\t// the stalled marker; with no marker there is nothing to release.\n   117\t\t\tif marker != nil {\n   118\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   119\t\t\t\tif err != nil {\n   120\t\t\t\t\treturn ReviewRun{}, err\n   121\t\t\t\t}\n   122\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   123\t\t\t\tif err != nil {\n   124\t\t\t\t\treturn ReviewRun{}, err\n   125\t\t\t\t}\n   126\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   127\t\t\t}\n   128\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   129\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   130\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   131\t\t}\n   132\t\trun := abandonmentRun(*reserved, marker)\n   133\t\tcandidate, _ := identifiedReviewRun(run, nil)\n   134\t\t// A run the attempt already recorded, by its dispatch or by a release\n   135\t\t// interrupted before the receipt, completes the attempt; no second run\n   136\t\t// is written for it.\n   137\t\trecorded, found, err := s.recordedAttemptRun(*reserved, candidate.RunID)\n   138\t\tif err != nil {\n   139\t\t\treturn ReviewRun{}, err\n   140\t\t}\n   141\t\tif !found {\n   142\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   143\t\t\t\treturn ReviewRun{}, err\n   144\t\t\t}\n   145\t\t}\n   146\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   147\t\t\treturn recorded, err\n   148\t\t}\n   149\t\tif marker != nil {\n   150\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   151\t\t}\n   152\t\treturn recorded, nil\n   153\t}\n   154\t\n   155\t// abandonmentRun is the failed run a release records for reserved. Its\n   156\t// content is deterministic (no reading of the clock), so a release\n   157\t// interrupted between the run's witness and its record records the same run\n   158\t// again and completes it (review round 14, N5).\n   159\tfunc abandonmentRun(reserved DelegatedReviewAttempt, marker *DelegationActiveRun) ReviewRun {\n   160\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   161\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   162\t\t\tStartedAt: reserved.ReservedAt, EndedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview, Status: ReviewRunFailed}\n   163\t\tif marker != nil {\n   164\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt, run.EndedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt, marker.StalledAt\n   165\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   166\t\t} else {\n   167\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   168\t\t}\n   169\t\treturn run\n   170\t}\n   171\t\n   172\t// withoutOwnWitness drops the loss of the release's own run, a witness whose\n   173\t// record an interrupted release did not publish yet: recording it again\n   174\t// completes it.\n   175\tfunc withoutOwnWitness(lost []string, runID string) []string {\npose-mcp/internal/pose/delegation_list.go:44:\tCancelRequested bool   `json:\"cancel_requested,omitempty\"`\npose-mcp/internal/pose/delegation_list.go:177:\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\npose-mcp/internal/pose/delegation_list.go:201:\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\npose-mcp/internal/cli/delegate.go:36:const delegateUsageText = \"pose delegate <review|adjudicate|smoke|task|ls|watch|wait|resume|handoff|cancel|agents> [args] [--agent auto|<name>] [--access read|sandboxed|write|full] [--label <name>] [--lead <vendor>] [--dry-run] [--json]\"\npose-mcp/internal/cli/delegate.go:43:\tdelegateCancelSchema = \"pose.delegate.cancel/v1\"\npose-mcp/internal/cli/delegate.go:219:\tcase \"cancel\":\npose-mcp/internal/cli/delegate.go:1112:func cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\npose-mcp/internal/cli/delegate.go:1115:\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\npose-mcp/internal/cli/delegate.go:1120:\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\npose-mcp/internal/cli/delegate.go:1124:\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\npose-mcp/internal/cli/delegate.go:1132:\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\npose-mcp/internal/cli/delegate.go:1134:\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\npose-mcp/internal/cli/delegate.go:1137:\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\npose-mcp/internal/cli/delegate.go:1159:\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\npose-mcp/internal/cli/delegate.go:1170:\t\tout.Field(\"delegate.dry_run\", tr(\"true (no cancellation requested)\", \"true (nenhum cancelamento pedido)\"))\npose-mcp/internal/cli/delegate.go:1175:\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\npose-mcp/internal/cli/delegate.go:1195:\t\tout.Field(\"delegate.cancel\", tr(\"requested\", \"pedido\"))\n  1000\t\tif err != nil {\n  1001\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1002\t\t}\n  1003\t\tattempt, code, err := namedAttempt(attempts, f)\n  1004\t\tif err != nil {\n  1005\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", code, err)\n  1006\t\t}\n  1007\t\tif attempt.Active {\n  1008\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, errors.New(tr(\"attempt \"+attempt.AttemptID+\" is still running\", \"a tentativa \"+attempt.AttemptID+\" ainda está rodando\")))\n  1009\t\t}\n  1010\t\tref := attempt.AttemptID\n  1011\t\tif len(f.positional) == 1 {\n  1012\t\t\tref = f.positional[0]\n  1013\t\t}\n  1014\t\ttarget, err := resumeTarget(attempt, ref)\n  1015\t\tif err != nil {\n  1016\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1017\t\t}\n  1018\t\tif attempt.Purpose == posemodel.DelegationPurposeTask {\n  1019\t\t\treturn cmdDelegateTaskResume(root, store, f, attempt, target, stdout, stderr)\n  1020\t\t}\n  1021\t\tif f.promptFile != \"\" {\n  1022\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", tr(\"--prompt is for a task; a review is resumed with its own brief\", \"--prompt é para uma task; uma review é retomada com o próprio brief\"))\n  1023\t\t}\n  1024\t\tplan, err := store.PlanReviewResume(target)\n  1025\t\tif err != nil {\n  1026\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1027\t\t}\n  1028\t\tif pending := plan.PendingContinuation; pending != nil {\n  1029\t\t\t// A continuation already reserved is answered, as pose review resume\n  1030\t\t\t// answered it: pending, with its ids, and no second process (spec\n  1031\t\t\t// pose-delegation-parity-gate R6; review round 1, PG-R1-07).\n  1032\t\t\thandBackAttempt(pending.AttemptID)\n  1033\t\t\tif f.jsonOut {\n  1034\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateRunSchema, \"purpose\": attempt.Purpose, \"attempt\": pending.AttemptID, \"resumes\": pending.Predecessor,\n  1035\t\t\t\t\t\"continuation\": pending.ID, \"status\": \"pending\"})\n  1036\t\t\t\treturn 0\n  1037\t\t\t}\n  1038\t\t\tout := render(stdout, stderr)\n  1039\t\t\tout.Field(\"delegate.resumes\", pending.Predecessor)\n  1040\t\t\tout.Field(\"delegate.continuation\", pending.ID)\n  1041\t\t\tout.Field(\"delegate.attempt\", pending.AttemptID)\n  1042\t\t\tout.Field(\"delegate.status\", \"pending\")\n  1043\t\t\treturn 0\n  1044\t\t}\n  1045\t\tvar delay time.Duration\n  1046\t\tif f.wait && plan.Existing == nil {\n  1047\t\t\tvar seed [1]byte\n  1048\t\t\tif _, err := rand.Read(seed[:]); err != nil {\n  1049\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1050\t\t\t}\n  1051\t\t\tvar prior posemodel.ReviewRun\n  1052\t\t\tif latest := attempt.Latest(); latest != nil && latest.RunID == target {\n  1053\t\t\t\tprior = *latest\n  1054\t\t\t} else if runs, rerr := store.ListReviewRuns(\"\"); rerr == nil {\n  1055\t\t\t\tfor _, r := range runs {\n  1056\t\t\t\t\tif r.RunID == target {\n  1057\t\t\t\t\t\tprior = r\n  1058\t\t\t\t\t}\n  1059\t\t\t\t}\n  1060\t\t\t}\n  1061\t\t\tdelay, err = posemodel.ReviewResumeDelay(prior, time.Now(), f.waitMax, time.Duration(seed[0])*time.Second/255)\n  1062\t\t\tif err != nil {\n  1063\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1064\t\t\t}\n  1065\t\t}\n  1066\t\tif f.dryRun {\n  1067\t\t\textra := map[string]any{\"resumes\": target, \"attempt\": attempt.AttemptID, \"label\": attempt.Label}\n  1068\t\t\tif plan.Existing != nil {\n  1069\t\t\t\textra[\"recorded_continuation\"] = plan.Existing.RunID\n  1070\t\t\t}\n  1071\t\t\tif f.wait {\n  1072\t\t\t\textra[\"wait\"] = delay.String()\n  1073\t\t\t}\n  1074\t\t\tplan.Purpose = attempt.Purpose\n  1075\t\t\targv := redactArgv(posemodel.ReviewerArgv(plan.Config.Resume.Command, \"{output}\", \"{session}\", plan.Effort, plan.Config.Effort), plan.Config)\n  1076\t\t\treturn delegatePrintPlan(stdout, stderr, f.jsonOut, plan, argv, extra)\n  1077\t\t}\n  1078\t\tif delay > 0 {\n  1079\t\t\tif !f.jsonOut {\n  1080\t\t\t\trender(stdout, stderr).Field(\"delegate.wait\", delay.String())\n  1081\t\t\t}\n  1082\t\t\ttime.Sleep(delay)\n  1083\t\t\tif plan, err = store.PlanReviewResume(target); err != nil {\n  1084\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1085\t\t\t}\n  1086\t\t}\n  1087\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n  1088\t\tdefer stop()\n  1089\t\tif delegateSupervised() {\n  1090\t\t\tplan.OnStart = supervisorHandback()\n  1091\t\t}\n  1092\t\t// The containment the run will run under is disclosed before it runs, as\n  1093\t\t// pose review dispatch disclosed it (spec pose-delegation-parity-gate R6;\n  1094\t\t// review round 1, PG-R1-08); the JSON document carries it with the run.\n  1095\t\tif safety, _ := posemodel.ResolveReviewerContainment(plan.Config); safety != nil && !f.jsonOut {\n  1096\t\t\traw, _ := json.Marshal(safety)\n  1097\t\t\trender(stdout, stderr).Field(\"delegate.safety\", string(raw))\n  1098\t\t}\n  1099\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n  1100\t\thandBackExisting(run, err)\n  1101\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n  1102\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"resume\")\n  1103\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"resume\", run, err, delegateRunNextActions(store, run, err)...)\n  1104\t\tif err == nil && !f.jsonOut {\n  1105\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n  1106\t\t\t\treturn next\n  1107\t\t\t}\n  1108\t\t}\n  1109\t\treturn code\n  1110\t}\n  1111\t\n  1112\tfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n  1113\t\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n  1114\t\tif problem != \"\" {\n  1115\t\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n  1116\t\t}\n  1117\t\tstore := posemodel.Store{Root: root}\n  1118\t\tattempts, lost, err := store.ListDelegationAttempts()\n  1119\t\tif err != nil {\n  1120\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1121\t\t}\n  1122\t\tattempt, code, err := namedAttempt(attempts, f)\n  1123\t\tif err != nil {\n  1124\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n  1125\t\t}\n  1126\t\tif !attempt.Active && !f.dryRun {\n  1127\t\t\t// An attempt whose dispatch, or whose earlier release, ended before\n  1128\t\t\t// its receipt is released with a failed run and its receipt, so it\n  1129\t\t\t// stops blocking the bundle; the release proves the abandonment\n  1130\t\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n  1131\t\t\t// review round 4, N1).\n  1132\t\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n  1133\t\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n  1134\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1135\t\t\t}\n  1136\t\t\tif err != nil {\n  1137\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1138\t\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1139\t\t\t}\n  1140\t\t\tif f.jsonOut {\n  1141\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n  1142\t\t\t\treturn 0\n  1143\t\t\t}\n  1144\t\t\tout := render(stdout, stderr)\n  1145\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1146\t\t\tswitch {\n  1147\t\t\tcase run.RunID == \"\":\n  1148\t\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n  1149\t\t\tcase run.Status == posemodel.ReviewRunFailed && strings.HasPrefix(run.Failure, posemodel.DelegationAbandonedCause):\n  1150\t\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n  1151\t\t\tdefault:\n  1152\t\t\t\t// The attempt had a run already: its receipt was completed with\n  1153\t\t\t\t// it (review round 11, N3).\n  1154\t\t\t\tout.Field(\"delegate.released\", tr(\"true: completed with run \"+run.RunID+\", already recorded as \"+run.Status, \"true: concluída com o run \"+run.RunID+\", já registrado como \"+run.Status))\n  1155\t\t\t}\n     1\tpackage pose\n     2\t\n     3\t// Listing and naming delegated runs (spec pose-delegation-surface R11, and the\n     4\t// listing pose-delegated-review-completion-signal extends).\n     5\t//\n     6\t// A person and an agent follow a task, not a process: an attempt and its\n     7\t// continuations are one row, shown by their latest run. A reference names a\n     8\t// row by attempt, by any of its runs, by label or by a prefix of its session.\n     9\t\n    10\timport (\n    11\t\t\"fmt\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t)\n    16\t\n    17\t// DelegationAttempt is one attempt and its continuations.\n    18\ttype DelegationAttempt struct {\n    19\t\tAttemptID    string              `json:\"attempt_id\"`\n    20\t\tRuns         []string            `json:\"runs\"`\n    21\t\tLatestRun    string              `json:\"latest_run,omitempty\"`\n    22\t\tState        string              `json:\"state\"`\n    23\t\tPurpose      string              `json:\"purpose\"`\n    24\t\tAgent        string              `json:\"agent\"`\n    25\t\tVendor       string              `json:\"vendor,omitempty\"`\n    26\t\tModel        string              `json:\"model,omitempty\"`\n    27\t\tLabel        string              `json:\"label,omitempty\"`\n    28\t\tLead         string              `json:\"lead,omitempty\"`\n    29\t\tAccess       string              `json:\"access\"`\n    30\t\tScope        string              `json:\"scope\"`\n    31\t\tBundleID     string              `json:\"bundle_id\"`\n    32\t\tStartedAt    string              `json:\"started_at\"`\n    33\t\tEndedAt      string              `json:\"ended_at,omitempty\"`\n    34\t\tTurns        int                 `json:\"turns\"`\n    35\t\tLastStep     string              `json:\"last_step,omitempty\"`\n    36\t\tFailure      string              `json:\"failure,omitempty\"`\n    37\t\tInterruption *ReviewInterruption `json:\"interruption,omitempty\"`\n    38\t\t// Partial says an interrupted run kept a partial draft; TimeLeft is the\n    39\t\t// wait until its recorded reset, when there is one.\n    40\t\tPartial         bool   `json:\"partial,omitempty\"`\n    41\t\tTimeLeft        string `json:\"time_left,omitempty\"`\n    42\t\tActive          bool   `json:\"active\"`\n    43\t\tLiveness        string `json:\"liveness,omitempty\"`\n    44\t\tCancelRequested bool   `json:\"cancel_requested,omitempty\"`\n    45\t\t// HeartbeatAge is how long ago the running process last beat; a stalled\n    46\t\t// run is not active (spec pose-delegated-review-completion-signal R4, R6).\n    47\t\tHeartbeatAge string `json:\"heartbeat_age,omitempty\"`\n    48\t\tStalledAt    string `json:\"stalled_at,omitempty\"`\n    49\t\t// HookFailure is why the latest run's on_terminal hook failed (R7).\n    50\t\tHookFailure string `json:\"hook_failure,omitempty\"`\n    51\t\t// Round is the review round of the scope the latest run reviewed (spec\n    52\t\t// pose-delegated-review-round-protocol R1).\n    53\t\tRound    int `json:\"round,omitempty\"`\n    54\t\tsessions []string\n    55\t\tlatest   *ReviewRun\n    56\t}\n    57\t\n    58\t// Latest is the latest recorded run of the attempt, if any.\n    59\tfunc (a DelegationAttempt) Latest() *ReviewRun { return a.latest }\n    60\t\n    61\t// DelegationRunning is the state of an attempt whose process is still there;\n    62\t// DelegationStalled, of one whose process is gone without a record.\n    63\tconst (\n    64\t\tDelegationRunning = \"running\"\n    65\t\tDelegationStalled = \"stalled\"\n    66\t\t// DelegationAbandonedCause is the failure of a stalled attempt whose\n    67\t\t// dispatch ended before recording its run.\n    68\t\tDelegationAbandonedCause = \"abandoned: the dispatching process ended before the run was recorded\"\n    69\t)\n    70\t\n    71\t// ListDelegationAttempts groups every recorded run by attempt, adds the runs\n    72\t// in progress, and returns the losses the run history reports.\n    73\tfunc (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n    74\t\t// The markers are read before the runs: a run publishes its record before\n    75\t\t// it removes its marker, so a reader that finds no marker for an attempt\n    76\t\t// it saw running finds its record (spec\n    77\t\t// pose-delegated-review-completion-signal R5).\n    78\t\tactive, activeLost, activeErr := s.ListDelegationActive()\n    79\t\truns, lost, err := s.ReadReviewRuns(\"\")\n    80\t\tif err != nil {\n    81\t\t\treturn nil, nil, err\n    82\t\t}\n    83\t\t// Task runs share the lifecycle, never the review history (spec\n    84\t\t// pose-delegation-task R7, R8).\n    85\t\ttasks, taskLost := s.ReadDelegationTaskRuns()\n    86\t\truns, lost = append(runs, tasks...), append(lost, taskLost...)\n    87\t\tbyAttempt := map[string]*DelegationAttempt{}\n    88\t\torder := []string{}\n    89\t\tfor i := range runs {\n    90\t\t\trun := runs[i]\n    91\t\t\tkey := run.AttemptID\n    92\t\t\tif key == \"\" {\n    93\t\t\t\tkey = run.RunID // a run recorded before attempts existed is its own attempt\n    94\t\t\t}\n    95\t\t\trow, ok := byAttempt[key]\n    96\t\t\tif !ok {\n    97\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    98\t\t\t\tbyAttempt[key] = row\n    99\t\t\t\torder = append(order, key)\n   100\t\t\t}\n   101\t\t\trow.Runs = append(row.Runs, run.RunID)\n   102\t\t\trow.latest = &runs[i]\n   103\t\t\tif run.SessionDigest != \"\" {\n   104\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   105\t\t\t\t\trow.sessions = append(row.sessions, value)\n   106\t\t\t\t}\n   107\t\t\t}\n   108\t\t\tevents, err := s.ReadDelegationEvents(run)\n   109\t\t\tif err != nil {\n   110\t\t\t\t// A turn count read from nothing would report a whole history.\n   111\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   112\t\t\t} else {\n   113\t\t\t\tfor _, e := range events {\n   114\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   115\t\t\t\t\t\trow.Turns++\n   116\t\t\t\t\t}\n   117\t\t\t\t}\n   118\t\t\t\tif len(events) > 0 {\n   119\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   120\t\t\t\t}\n   121\t\t\t}\n   122\t\t}\n   123\t\tfor _, key := range order {\n   124\t\t\trow := byAttempt[key]\n   125\t\t\tlatest := row.latest\n   126\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   127\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   128\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   129\t\t\tif latest.Access != \"\" {\n   130\t\t\t\trow.Access = latest.Access\n   131\t\t\t}\n   132\t\t\trow.Round = latest.Round\n   133\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   134\t\t\t\trow.HookFailure = hook.Failure\n   135\t\t\t}\n   136\t\t\tif row.Purpose == \"\" {\n   137\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   138\t\t\t}\n   139\t\t\tif latest.Status == ReviewRunInterrupted {\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n   206\t\tfor _, key := range order {\n   207\t\t\tout = append(out, *byAttempt[key])\n   208\t\t}\n   209\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   210\t\treturn out, lost, nil\n   211\t}\n   212\t\n   213\tfunc delegationStepText(e DelegationEvent) string {\n   214\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   215\t\tif len(text) > 80 {\n   216\t\t\tcut := 77\n   217\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   218\t\t\t\tcut--\n   219\t\t\t}\n   220\t\t\ttext = text[:cut] + \"...\"\n   221\t\t}\n   222\t\tswitch e.Kind {\n   223\t\tcase DelegationEventToolCall:\n   224\t\t\treturn \"▶ \" + text\n   225\t\tcase DelegationEventToolOutput:\n   226\t\t\tif e.ExitCode != nil && *e.ExitCode != 0 {\n   227\t\t\t\treturn fmt.Sprintf(\"✗ exit %d\", *e.ExitCode)\n   228\t\t\t}\n   229\t\t\treturn \"✓ exit 0\"\n   230\t\tcase DelegationEventTurn:\n   231\t\t\treturn \"turn\"\n   232\t\t}\n   233\t\tif text == \"\" {\n   234\t\t\treturn e.Kind\n   235\t\t}\n   236\t\treturn e.Kind + \": \" + text\n   237\t}\n   238\t\n   239\t// ErrDelegationRefAmbiguous carries the candidates of an ambiguous reference.\n   240\t// Neither reference error carries the reference: it may be a session, which\n","exit_code":0,"status":"completed"}}
