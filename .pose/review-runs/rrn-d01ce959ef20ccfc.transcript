{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_shim_linux.go | sed -n '1,340p' && nl -ba pose-mcp/internal/pose/review_shim.go | sed -n '1,120p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"os/signal\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"golang.org/x/sys/unix\"\n    18\t)\n    19\t\n    20\t// RunReviewShim runs args (the adapter's path, then its argv) as the shim's\n    21\t// only child, waits for it or for SIGTERM, ends every process left in the\n    22\t// shim's subtree and returns the adapter's exit status.\n    23\tfunc RunReviewShim(args []string) int {\n    24\t\treport := reviewShimReport{}\n    25\t\tvar reportFile *os.File\n    26\t\tparent := 0\n    27\t\tif value := os.Getenv(ReviewShimReportEnv); value != \"\" {\n    28\t\t\tparent, _ = strconv.Atoi(value)\n    29\t\t\t// The report pipe is the shim's alone: the adapter never inherits it.\n    30\t\t\tsyscall.CloseOnExec(3)\n    31\t\t\treportFile = os.NewFile(3, \"pose-review-shim-report\")\n    32\t\t}\n    33\t\t_ = os.Unsetenv(ReviewShimReportEnv)\n    34\t\twrite := func() {\n    35\t\t\tif reportFile == nil {\n    36\t\t\t\treturn\n    37\t\t\t}\n    38\t\t\traw := boundedReviewShimReport(report)\n    39\t\t\t_, _ = reportFile.Write(raw)\n    40\t\t\t_ = reportFile.Close()\n    41\t\t}\n    42\t\tif len(args) < 2 {\n    43\t\t\treport.Error = \"the review shim was given no adapter\"\n    44\t\t\twrite()\n    45\t\t\treturn 125\n    46\t\t}\n    47\t\tstop := make(chan os.Signal, 1)\n    48\t\tsignal.Notify(stop, syscall.SIGTERM)\n    49\t\t// The dispatcher's death stops the shim the same way as a timeout.\n    50\t\tif err := unix.Prctl(unix.PR_SET_PDEATHSIG, uintptr(syscall.SIGTERM), 0, 0, 0); err != nil {\n    51\t\t\treport.Error = \"the shim could not follow its dispatcher: \" + err.Error()\n    52\t\t\twrite()\n    53\t\t\treturn 125\n    54\t\t}\n    55\t\tif parent != 0 && os.Getppid() != parent {\n    56\t\t\treport.Error = \"the dispatcher ended before the shim started\"\n    57\t\t\twrite()\n    58\t\t\treturn 125\n    59\t\t}\n    60\t\tif err := unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0); err != nil {\n    61\t\t\treport.Error = \"the shim could not become the subreaper of the run: \" + err.Error()\n    62\t\t\twrite()\n    63\t\t\treturn 125\n    64\t\t}\n    65\t\tcmd := &exec.Cmd{Path: args[0], Args: args[1:], Stdin: os.Stdin, Stdout: os.Stdout, Stderr: os.Stderr, Env: os.Environ()}\n    66\t\tif err := cmd.Start(); err != nil {\n    67\t\t\treport.Error = \"the adapter could not run: \" + err.Error()\n    68\t\t\twrite()\n    69\t\t\treturn 127\n    70\t\t}\n    71\t\tdone := make(chan error, 1)\n    72\t\tgo func() { done <- cmd.Wait() }()\n    73\t\tcode, stopped := 0, false\n    74\t\tvar signaled syscall.Signal\n    75\t\tselect {\n    76\t\tcase err := <-done:\n    77\t\t\tvar exit *exec.ExitError\n    78\t\t\tif errors.As(err, &exit) {\n    79\t\t\t\tif status, ok := exit.Sys().(syscall.WaitStatus); ok && status.Signaled() {\n    80\t\t\t\t\tsignaled, code = status.Signal(), 128+int(status.Signal())\n    81\t\t\t\t} else {\n    82\t\t\t\t\tcode = exit.ExitCode()\n    83\t\t\t\t}\n    84\t\t\t} else if err != nil {\n    85\t\t\t\treport.Error = \"the adapter's end could not be read: \" + err.Error()\n    86\t\t\t}\n    87\t\tcase <-stop:\n    88\t\t\tstopped, code = true, 128+int(syscall.SIGTERM)\n    89\t\t}\n    90\t\tended, err := reapShimSubtree()\n    91\t\treport.Ended = ended\n    92\t\tif err != nil && report.Error == \"\" {\n    93\t\t\treport.Error = err.Error()\n    94\t\t}\n    95\t\twrite()\n    96\t\tif stopped {\n    97\t\t\treturn code\n    98\t\t}\n    99\t\t// An adapter ended by a signal is reported as ended by it: the shim ends\n   100\t\t// itself the same way, so the dispatcher reads what it would have read\n   101\t\t// without the shim.\n   102\t\tif signaled != 0 {\n   103\t\t\tsignal.Reset(signaled)\n   104\t\t\t_ = syscall.Kill(os.Getpid(), signaled)\n   105\t\t\ttime.Sleep(time.Second)\n   106\t\t}\n   107\t\treturn code\n   108\t}\n   109\t\n   110\t// stopReviewShim asks a running shim to end its subtree and exit.\n   111\tfunc stopReviewShim(cmd *exec.Cmd) func() error {\n   112\t\treturn func() error { return cmd.Process.Signal(syscall.SIGTERM) }\n   113\t}\n   114\t\n   115\t// reapShimSubtree ends and reaps every child of the shim, including the\n   116\t// orphans its subreaper status adopted, until none is left.\n   117\tfunc reapShimSubtree() ([]string, error) {\n   118\t\tself := os.Getpid()\n   119\t\tvar ended []string\n   120\t\tseen := map[int]bool{}\n   121\t\tdeadline := time.Now().Add(reviewReapWait)\n   122\t\t// A process that cannot be inspected or ended is not a reason to stop:\n   123\t\t// the others are still ended, and the problem is reported at the end\n   124\t\t// (review round 9, N3).\n   125\t\tvar problems []string\n   126\t\tnote := func(err error) {\n   127\t\t\tif len(problems) < 8 {\n   128\t\t\t\tproblems = append(problems, err.Error())\n   129\t\t\t}\n   130\t\t}\n   131\t\tfor {\n   132\t\t\tchildren := 0\n   133\t\t\tproblems = problems[:0]\n   134\t\t\t// /proc is read in batches under the deadline, never materialized\n   135\t\t\t// whole (review round 13, N3).\n   136\t\t\tdirs, err := readProcBatched(deadline)\n   137\t\t\tif err != nil {\n   138\t\t\t\tnote(err)\n   139\t\t\t}\n   140\t\t\tfor _, d := range dirs {\n   141\t\t\t\t// The bound holds per process, not only per listing (review round\n   142\t\t\t\t// 14, N4).\n   143\t\t\t\tif time.Now().After(deadline) {\n   144\t\t\t\t\tchildren++\n   145\t\t\t\t\tnote(fmt.Errorf(\"the run's processes could not be scanned within the bound\"))\n   146\t\t\t\t\tbreak\n   147\t\t\t\t}\n   148\t\t\t\tpid, err := strconv.Atoi(d.Name())\n   149\t\t\t\tif err != nil || pid == self {\n   150\t\t\t\t\tcontinue\n   151\t\t\t\t}\n   152\t\t\t\tst, err := readShimProcStat(pid)\n   153\t\t\t\tif reviewProcessGoneErr(err) {\n   154\t\t\t\t\tcontinue\n   155\t\t\t\t}\n   156\t\t\t\tif err != nil {\n   157\t\t\t\t\t// A process of another user is never the run's: with procfs\n   158\t\t\t\t\t// mounted hidepid it is visible and unreadable (review round 10,\n   159\t\t\t\t\t// N1). Only one of this user is an unknown that may be the run's.\n   160\t\t\t\t\tif owner, oerr := reviewProcessOwner(pid); reviewProcessGoneErr(oerr) || oerr == nil && owner != os.Getuid() {\n   161\t\t\t\t\t\tcontinue\n   162\t\t\t\t\t}\n   163\t\t\t\t\tchildren++\n   164\t\t\t\t\tnote(fmt.Errorf(\"process %d could not be inspected: %w\", pid, err))\n   165\t\t\t\t\tcontinue\n   166\t\t\t\t}\n   167\t\t\t\tif st.ppid != self {\n   168\t\t\t\t\tcontinue\n   169\t\t\t\t}\n   170\t\t\t\tchildren++\n   171\t\t\t\tif !st.zombie {\n   172\t\t\t\t\t// A pid is reported ended only once its signal was delivered\n   173\t\t\t\t\t// (review round 10, N3).\n   174\t\t\t\t\tif delivered, err := killPinnedChild(pid, self); err != nil {\n   175\t\t\t\t\t\tnote(err)\n   176\t\t\t\t\t} else if delivered {\n   177\t\t\t\t\t\tseen[pid] = true\n   178\t\t\t\t\t}\n   179\t\t\t\t}\n   180\t\t\t}\n   181\t\t\tfor {\n   182\t\t\t\tpid, err := unix.Wait4(-1, nil, unix.WNOHANG, nil)\n   183\t\t\t\tif pid <= 0 || err != nil {\n   184\t\t\t\t\tbreak\n   185\t\t\t\t}\n   186\t\t\t\t// A pid is reported ended once it was signalled and reaped\n   187\t\t\t\t// (review round 12, N2).\n   188\t\t\t\tif seen[pid] {\n   189\t\t\t\t\tdelete(seen, pid)\n   190\t\t\t\t\tended = append(ended, strconv.Itoa(pid))\n   191\t\t\t\t}\n   192\t\t\t}\n   193\t\t\tif children == 0 && len(problems) == 0 {\n   194\t\t\t\treturn ended, nil\n   195\t\t\t}\n   196\t\t\tif time.Now().After(deadline) {\n   197\t\t\t\treturn ended, fmt.Errorf(\"%d process(es) of the run could not be ended: %s\", children, strings.Join(problems, \"; \"))\n   198\t\t\t}\n   199\t\t\ttime.Sleep(20 * time.Millisecond)\n   200\t\t}\n   201\t}\n   202\t\n   203\ttype shimProcStat struct {\n   204\t\tppid   int\n   205\t\tzombie bool\n   206\t}\n   207\t\n   208\tfunc readShimProcStat(pid int) (shimProcStat, error) {\n   209\t\traw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n   210\t\tif err != nil {\n   211\t\t\treturn shimProcStat{}, err\n   212\t\t}\n   213\t\ttext := string(raw)\n   214\t\tend := strings.LastIndexByte(text, ')')\n   215\t\tif end < 0 {\n   216\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   217\t\t}\n   218\t\tf := strings.Fields(text[end+1:])\n   219\t\tif len(f) < 2 {\n   220\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   221\t\t}\n   222\t\tppid, err := strconv.Atoi(f[1])\n   223\t\tif err != nil {\n   224\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   225\t\t}\n   226\t\treturn shimProcStat{ppid: ppid, zombie: f[0] == \"Z\"}, nil\n   227\t}\n   228\t\n   229\t// killPinnedChild signals pid through a pidfd while it is still a child of\n   230\t// parent: a pid reused by an unrelated process is never signalled. It says\n   231\t// whether the signal reached the process; one that already ended was not\n   232\t// ended by the shim and is not reported (review round 11, N2).\n   233\tfunc killPinnedChild(pid, parent int) (bool, error) {\n   234\t\tfd, err := unix.PidfdOpen(pid, 0)\n   235\t\tif errors.Is(err, unix.ESRCH) {\n   236\t\t\treturn false, nil\n   237\t\t}\n   238\t\tif err != nil {\n   239\t\t\treturn false, fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   240\t\t}\n   241\t\tdefer unix.Close(fd)\n   242\t\tst, err := readShimProcStat(pid)\n   243\t\tif reviewProcessGoneErr(err) || err == nil && (st.ppid != parent || st.zombie) {\n   244\t\t\treturn false, nil\n   245\t\t}\n   246\t\tif err != nil {\n   247\t\t\treturn false, fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   248\t\t}\n   249\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil {\n   250\t\t\tif errors.Is(err, unix.ESRCH) {\n   251\t\t\t\treturn false, nil\n   252\t\t\t}\n   253\t\t\treturn false, fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   254\t\t}\n   255\t\treturn true, nil\n   256\t}\n   257\t\n   258\t// parseReviewShimReport reads the report the shim wrote to its pipe.\n   259\tfunc parseReviewShimReport(raw []byte) (reviewShimReport, error) {\n   260\t\tvar r reviewShimReport\n   261\t\tif len(raw) == 0 {\n   262\t\t\treturn r, fmt.Errorf(\"the review shim left no report\")\n   263\t\t}\n   264\t\tif err := json.Unmarshal(raw, &r); err != nil {\n   265\t\t\treturn r, fmt.Errorf(\"the review shim report is unreadable: %w\", err)\n   266\t\t}\n   267\t\treturn r, nil\n   268\t}\n   269\t\n   270\t// readProcBatched lists the numeric entries of /proc in batches, and stops\n   271\t// with an error once deadline passes.\n   272\tfunc readProcBatched(deadline time.Time) ([]os.DirEntry, error) {\n   273\t\tf, err := os.Open(\"/proc\")\n   274\t\tif err != nil {\n   275\t\t\treturn nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n   276\t\t}\n   277\t\tdefer f.Close()\n   278\t\tvar out []os.DirEntry\n   279\t\tfor {\n   280\t\t\tbatch, err := f.ReadDir(512)\n   281\t\t\tfor _, d := range batch {\n   282\t\t\t\tif d.Name()[0] >= '0' && d.Name()[0] <= '9' {\n   283\t\t\t\t\tout = append(out, d)\n   284\t\t\t\t}\n   285\t\t\t}\n   286\t\t\tif err != nil || len(batch) == 0 {\n   287\t\t\t\treturn out, nil\n   288\t\t\t}\n   289\t\t\tif time.Now().After(deadline) {\n   290\t\t\t\treturn out, fmt.Errorf(\"the run's processes could not be listed within the bound\")\n   291\t\t\t}\n   292\t\t}\n   293\t}\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"encoding/json\"\n     5\t\t\"time\"\n     6\t)\n     7\t\n     8\t// The review run shim (spec pose-review-run-reaps-lingering-reviewer-processes,\n     9\t// review rounds 6 and 8): a descendant of the reviewer that leaves the\n    10\t// adapter's process group, starts its own session and clears its environment\n    11\t// matches neither the group kill nor the sealed-checkout entry. Making the\n    12\t// dispatcher a child subreaper caught it, but a subreaper is process-wide:\n    13\t// in the dispatching process it also adopted and ended children other code\n    14\t// started there (a detached delegation), and reaped processes another\n    15\t// goroutine was waiting for. The dispatcher therefore starts the adapter\n    16\t// through a shim, the same executable re-entered with ReviewShimArg, which\n    17\t// makes itself the subreaper, runs the adapter, and, once it exits, ends\n    18\t// every process left in its subtree. The shim has no other children, so\n    19\t// everything it adopts is the run's. A timeout asks the shim to stop with\n    20\t// SIGTERM, and the death of the dispatcher delivers it the same signal: in\n    21\t// both cases it ends the subtree before it exits (review round 8, N3, N4).\n    22\t\n    23\t// reviewReapWait bounds how long ending the run's leftover processes takes.\n    24\tconst reviewReapWait = 5 * time.Second\n    25\t\n    26\t// ReviewShimArg is the first argument that runs the executable as a review\n    27\t// run shim instead of the CLI.\n    28\tconst ReviewShimArg = \"__pose-review-run-shim\"\n    29\t\n    30\t// ReviewShimReportEnv tells the shim that the dispatcher passed it a report\n    31\t// pipe as file descriptor 3, and names the dispatcher's pid. The report never\n    32\t// goes to a path the reviewer can write (review round 8, N2).\n    33\tconst ReviewShimReportEnv = \"POSE_REVIEW_SHIM_REPORT\"\n    34\t\n    35\t// ReviewShimAvailable says the running executable handles ReviewShimArg. It\n    36\t// is set by the pose command and by the test binaries that dispatch; any\n    37\t// other embedder starts the adapter directly, without the shim.\n    38\tvar ReviewShimAvailable = false\n    39\t\n    40\t// reviewShimReport is what the shim found after the adapter exited.\n    41\ttype reviewShimReport struct {\n    42\t\tEnded      []string `json:\"ended\"`\n    43\t\tEndedTotal int      `json:\"ended_total\"`\n    44\t\tError      string   `json:\"error,omitempty\"`\n    45\t}\n    46\t\n    47\t// reviewShimReportMaxPids bounds the pids a report lists; EndedTotal counts\n    48\t// them all. A full report stays far below the dispatcher's read bound.\n    49\tconst reviewShimReportMaxPids = 1000\n    50\t\n    51\t// boundedReviewShimReport encodes r within the dispatcher's read bound, so\n    52\t// the dispatcher always reads it whole (review round 9, N2).\n    53\tfunc boundedReviewShimReport(r reviewShimReport) []byte {\n    54\t\tr.EndedTotal = len(r.Ended)\n    55\t\tif len(r.Ended) > reviewShimReportMaxPids {\n    56\t\t\tr.Ended = r.Ended[:reviewShimReportMaxPids]\n    57\t\t}\n    58\t\tif len(r.Error) > 4096 {\n    59\t\t\tr.Error = r.Error[:4096]\n    60\t\t}\n    61\t\traw, _ := json.Marshal(r)\n    62\t\treturn raw\n    63\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_tree_windows.go | sed -n '1,240p' && nl -ba pose-mcp/internal/pose/review_reap_linux.go | sed -n '1,300p'\"","aggregated_output":"     1\t//go:build windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Ending the reviewer's process tree on Windows (spec\n     6\t// pose-review-run-reaps-lingering-reviewer-processes R1, review round 13,\n     7\t// N1): the adapter starts suspended, is assigned to a job object that kills\n     8\t// every process in it when the job is terminated or its last handle closes,\n     9\t// and only then resumes, so no descendant can start outside the job. The\n    10\t// dispatch terminates the job after the run, on a timeout, and, through the\n    11\t// kill-on-close limit, when the dispatching process ends.\n    12\t\n    13\timport (\n    14\t\t\"fmt\"\n    15\t\t\"os/exec\"\n    16\t\t\"sync\"\n    17\t\t\"syscall\"\n    18\t\t\"time\"\n    19\t\t\"unsafe\"\n    20\t\n    21\t\t\"golang.org/x/sys/windows\"\n    22\t)\n    23\t\n    24\tvar reviewJobs sync.Map // *exec.Cmd -> windows.Handle\n    25\t\n    26\t// jobBasicAccounting is JOBOBJECT_BASIC_ACCOUNTING_INFORMATION.\n    27\ttype jobBasicAccounting struct {\n    28\t\tTotalUserTime             int64\n    29\t\tTotalKernelTime           int64\n    30\t\tThisPeriodTotalUserTime   int64\n    31\t\tThisPeriodTotalKernelTime int64\n    32\t\tTotalPageFaultCount       uint32\n    33\t\tTotalProcesses            uint32\n    34\t\tActiveProcesses           uint32\n    35\t\tTotalTerminatedProcesses  uint32\n    36\t}\n    37\t\n    38\t// prepareReviewProcessTree makes cmd start suspended, so it can be placed in\n    39\t// its job before it runs.\n    40\tfunc prepareReviewProcessTree(cmd *exec.Cmd) {\n    41\t\tif cmd.SysProcAttr == nil {\n    42\t\t\tcmd.SysProcAttr = &syscall.SysProcAttr{}\n    43\t\t}\n    44\t\tcmd.SysProcAttr.CreationFlags |= windows.CREATE_SUSPENDED\n    45\t\tcmd.Cancel = func() error { return terminateReviewJob(cmd) }\n    46\t}\n    47\t\n    48\t// attachReviewProcessTree places the started, suspended process in a new\n    49\t// kill-on-close job and resumes it. A process that cannot be placed is\n    50\t// terminated: it never runs outside the job.\n    51\tfunc attachReviewProcessTree(cmd *exec.Cmd) error {\n    52\t\tjob, err := windows.CreateJobObject(nil, nil)\n    53\t\tif err != nil {\n    54\t\t\t_ = cmd.Process.Kill()\n    55\t\t\treturn fmt.Errorf(\"the reviewer's job object could not be created: %w\", err)\n    56\t\t}\n    57\t\tinfo := windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION{}\n    58\t\tinfo.BasicLimitInformation.LimitFlags = windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE\n    59\t\tif _, err := windows.SetInformationJobObject(job, windows.JobObjectExtendedLimitInformation, uintptr(unsafe.Pointer(&info)), uint32(unsafe.Sizeof(info))); err != nil {\n    60\t\t\t_ = windows.CloseHandle(job)\n    61\t\t\t_ = cmd.Process.Kill()\n    62\t\t\treturn fmt.Errorf(\"the reviewer's job object could not be limited: %w\", err)\n    63\t\t}\n    64\t\tprocess, err := windows.OpenProcess(windows.PROCESS_SET_QUOTA|windows.PROCESS_TERMINATE, false, uint32(cmd.Process.Pid))\n    65\t\tif err != nil {\n    66\t\t\t_ = windows.CloseHandle(job)\n    67\t\t\t_ = cmd.Process.Kill()\n    68\t\t\treturn fmt.Errorf(\"the reviewer's process could not be opened: %w\", err)\n    69\t\t}\n    70\t\tdefer windows.CloseHandle(process)\n    71\t\tif err := windows.AssignProcessToJobObject(job, process); err != nil {\n    72\t\t\t_ = windows.CloseHandle(job)\n    73\t\t\t_ = cmd.Process.Kill()\n    74\t\t\treturn fmt.Errorf(\"the reviewer's process could not join its job: %w\", err)\n    75\t\t}\n    76\t\treviewJobs.Store(cmd, job)\n    77\t\tif err := resumeProcessThreads(uint32(cmd.Process.Pid)); err != nil {\n    78\t\t\t_ = terminateReviewJob(cmd)\n    79\t\t\treturn fmt.Errorf(\"the reviewer's process could not be resumed: %w\", err)\n    80\t\t}\n    81\t\treturn nil\n    82\t}\n    83\t\n    84\t// resumeProcessThreads resumes every thread of pid; a suspended process has\n    85\t// only its main thread.\n    86\tfunc resumeProcessThreads(pid uint32) error {\n    87\t\tsnapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPTHREAD, 0)\n    88\t\tif err != nil {\n    89\t\t\treturn err\n    90\t\t}\n    91\t\tdefer windows.CloseHandle(snapshot)\n    92\t\tentry := windows.ThreadEntry32{Size: uint32(unsafe.Sizeof(windows.ThreadEntry32{}))}\n    93\t\tresumed := 0\n    94\t\tfor err = windows.Thread32First(snapshot, &entry); err == nil; err = windows.Thread32Next(snapshot, &entry) {\n    95\t\t\tif entry.OwnerProcessID != pid {\n    96\t\t\t\tcontinue\n    97\t\t\t}\n    98\t\t\tthread, err := windows.OpenThread(windows.THREAD_SUSPEND_RESUME, false, entry.ThreadID)\n    99\t\t\tif err != nil {\n   100\t\t\t\treturn err\n   101\t\t\t}\n   102\t\t\t_, rerr := windows.ResumeThread(thread)\n   103\t\t\t_ = windows.CloseHandle(thread)\n   104\t\t\tif rerr != nil {\n   105\t\t\t\treturn rerr\n   106\t\t\t}\n   107\t\t\tresumed++\n   108\t\t}\n   109\t\tif resumed == 0 {\n   110\t\t\treturn fmt.Errorf(\"no thread of process %d was found\", pid)\n   111\t\t}\n   112\t\treturn nil\n   113\t}\n   114\t\n   115\t// terminateReviewJob ends every process of cmd's job and waits until the job\n   116\t// is empty.\n   117\tfunc terminateReviewJob(cmd *exec.Cmd) error {\n   118\t\tvalue, ok := reviewJobs.Load(cmd)\n   119\t\tif !ok {\n   120\t\t\tif cmd.Process != nil {\n   121\t\t\t\treturn cmd.Process.Kill()\n   122\t\t\t}\n   123\t\t\treturn nil\n   124\t\t}\n   125\t\tjob := value.(windows.Handle)\n   126\t\tif err := windows.TerminateJobObject(job, 1); err != nil {\n   127\t\t\treturn fmt.Errorf(\"the reviewer's job could not be terminated: %w\", err)\n   128\t\t}\n   129\t\tdeadline := time.Now().Add(reviewReapWait)\n   130\t\tfor {\n   131\t\t\tvar acct jobBasicAccounting\n   132\t\t\tif err := windows.QueryInformationJobObject(job, windows.JobObjectBasicAccountingInformation, uintptr(unsafe.Pointer(&acct)), uint32(unsafe.Sizeof(acct)), nil); err != nil {\n   133\t\t\t\treturn fmt.Errorf(\"the reviewer's job could not be inspected: %w\", err)\n   134\t\t\t}\n   135\t\t\tif acct.ActiveProcesses == 0 {\n   136\t\t\t\treturn nil\n   137\t\t\t}\n   138\t\t\tif time.Now().After(deadline) {\n   139\t\t\t\treturn fmt.Errorf(\"%d process(es) of the reviewer's job could not be ended\", acct.ActiveProcesses)\n   140\t\t\t}\n   141\t\t\ttime.Sleep(20 * time.Millisecond)\n   142\t\t}\n   143\t}\n   144\t\n   145\t// releaseReviewProcessTree terminates the job and closes its handle.\n   146\tfunc releaseReviewProcessTree(cmd *exec.Cmd) error {\n   147\t\terr := terminateReviewJob(cmd)\n   148\t\tif value, ok := reviewJobs.LoadAndDelete(cmd); ok {\n   149\t\t\t_ = windows.CloseHandle(value.(windows.Handle))\n   150\t\t}\n   151\t\treturn err\n   152\t}\n     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Leftover reviewer processes, the fallback of an embedder that does not run\n     6\t// the adapter under the review run shim (review_shim.go), which is the Linux\n     7\t// path of the pose command (spec\n     8\t// pose-review-run-reaps-lingering-reviewer-processes R1, L6): an adapter such as\n     9\t// `codex exec` runs each command in a session of its own, so killing the\n    10\t// adapter's process group misses a command the reviewer left running, and\n    11\t// that command keeps writing into the run's runtime directory while the\n    12\t// cleanup inventory reads it. Every process of the run inherits\n    13\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n    14\t// that entry, ends them and waits for them before the inventory.\n    15\t//\n    16\t// Each process is pinned by a pidfd before it is signalled, and its\n    17\t// environment is read again through the pinned process, so a pid reused by\n    18\t// an unrelated process between the scan and the signal is never killed\n    19\t// (review round 1, N3). A scan that cannot list or read the state of the\n    20\t// processes fails. A process of this user whose environment cannot be read\n    21\t// (one that made itself non-inspectable) cannot be matched: one that already\n    22\t// existed before the adapter started is not the run's and is skipped; any\n    23\t// other may be the run's, so the scan fails and the run stays unconcludable\n    24\t// (review round 2, N2).\n    25\t\n    26\timport (\n    27\t\t\"bytes\"\n    28\t\t\"errors\"\n    29\t\t\"fmt\"\n    30\t\t\"io/fs\"\n    31\t\t\"os\"\n    32\t\t\"path/filepath\"\n    33\t\t\"strconv\"\n    34\t\t\"strings\"\n    35\t\t\"syscall\"\n    36\t\t\"time\"\n    37\t\n    38\t\t\"golang.org/x/sys/unix\"\n    39\t)\n    40\t\n    41\t// reapSealedCheckoutProcesses ends every process whose environment names\n    42\t// worktree as its sealed checkout and returns a description of each. An\n    43\t// error means the run's processes could not be proven ended within the bound.\n    44\tfunc reapSealedCheckoutProcesses(worktree string, baseline map[int]string) ([]string, int, error) {\n    45\t\tif worktree == \"\" {\n    46\t\t\treturn nil, 0, nil\n    47\t\t}\n    48\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n    49\t\tvar reaped []string\n    50\t\tseen := map[int]bool{}\n    51\t\tdeadline := time.Now().Add(reviewReapWait)\n    52\t\tunreadable := 0\n    53\t\tfor {\n    54\t\t\talive, opaque, err := reviewMarkedProcesses(entry, deadline)\n    55\t\t\tif err != nil {\n    56\t\t\t\treturn reaped, unreadable, err\n    57\t\t\t}\n    58\t\t\tunreadable = 0\n    59\t\t\tfor pid, start := range opaque {\n    60\t\t\t\tif prior, ok := baseline[pid]; !ok || prior != start {\n    61\t\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"process %d of this user started during the run and cannot be inspected; it may be the run's and was not ended\", pid)\n    62\t\t\t\t}\n    63\t\t\t\tunreadable++\n    64\t\t\t}\n    65\t\t\tfor _, pid := range alive {\n    66\t\t\t\tif !seen[pid] {\n    67\t\t\t\t\tseen[pid] = true\n    68\t\t\t\t\t// Only the pid: the name is the reviewer's to choose and is not\n    69\t\t\t\t\t// recorded (review round 7, N4).\n    70\t\t\t\t\treaped = append(reaped, strconv.Itoa(pid))\n    71\t\t\t\t}\n    72\t\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n    73\t\t\t\t\treturn reaped, unreadable, err\n    74\t\t\t\t}\n    75\t\t\t}\n    76\t\t\tif len(alive) == 0 {\n    77\t\t\t\treturn reaped, unreadable, nil\n    78\t\t\t}\n    79\t\t\tif time.Now().After(deadline) {\n    80\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n    81\t\t\t}\n    82\t\t\ttime.Sleep(50 * time.Millisecond)\n    83\t\t}\n    84\t}\n    85\t\n    86\t// reviewMarkedProcesses lists the live processes whose environment holds\n    87\t// entry, and counts this user's processes whose environment could not be\n    88\t// read. A process that is gone is skipped.\n    89\tfunc reviewMarkedProcesses(entry []byte, deadline time.Time) ([]int, map[int]string, error) {\n    90\t\tdirs, err := os.ReadDir(\"/proc\")\n    91\t\tif err != nil {\n    92\t\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    93\t\t}\n    94\t\tunreadable := map[int]string{}\n    95\t\tself, uid := os.Getpid(), os.Getuid()\n    96\t\tvar out []int\n    97\t\tfor _, d := range dirs {\n    98\t\t\tif !deadline.IsZero() && time.Now().After(deadline) {\n    99\t\t\t\treturn nil, unreadable, fmt.Errorf(\"the run's processes could not be scanned within the bound\")\n   100\t\t\t}\n   101\t\t\tpid, err := strconv.Atoi(d.Name())\n   102\t\t\tif err != nil || pid == self {\n   103\t\t\t\tcontinue\n   104\t\t\t}\n   105\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n   106\t\t\tswitch {\n   107\t\t\tcase reviewProcessGoneErr(err):\n   108\t\t\t\tcontinue\n   109\t\t\tcase err != nil:\n   110\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n   111\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n   112\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   113\t\t\t\t\tcontinue\n   114\t\t\t\t}\n   115\t\t\t\tstart, serr := processStartTime(pid)\n   116\t\t\t\tif reviewProcessGoneErr(serr) {\n   117\t\t\t\t\tcontinue\n   118\t\t\t\t}\n   119\t\t\t\tif serr != nil || start == \"\" {\n   120\t\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d start could not be read: %v\", pid, serr)\n   121\t\t\t\t}\n   122\t\t\t\tunreadable[pid] = start\n   123\t\t\t\tcontinue\n   124\t\t\tcase !marked:\n   125\t\t\t\tcontinue\n   126\t\t\t}\n   127\t\t\tzombie, err := reviewProcessZombie(pid)\n   128\t\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n   129\t\t\t\tcontinue\n   130\t\t\t}\n   131\t\t\tif err != nil {\n   132\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n   133\t\t\t}\n   134\t\t\tout = append(out, pid)\n   135\t\t}\n   136\t\treturn out, unreadable, nil\n   137\t}\n   138\t\n   139\t// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n   140\t// after the environment read through that same pinned process still holds\n   141\t// entry.\n   142\tfunc killPinnedMarkedProcess(pid int, entry []byte) error {\n   143\t\tfd, err := unix.PidfdOpen(pid, 0)\n   144\t\tif errors.Is(err, unix.ESRCH) {\n   145\t\t\treturn nil\n   146\t\t}\n   147\t\tif err != nil {\n   148\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   149\t\t}\n   150\t\tdefer unix.Close(fd)\n   151\t\t// The pidfd names one process for its lifetime; if pid was reused before\n   152\t\t// it was opened, the new process does not carry this run's entry.\n   153\t\tmarked, err := reviewProcessMarked(pid, entry)\n   154\t\tif reviewProcessGoneErr(err) || err == nil && !marked {\n   155\t\t\treturn nil\n   156\t\t}\n   157\t\tif err != nil {\n   158\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   159\t\t}\n   160\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   161\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   162\t\t}\n   163\t\treturn nil\n   164\t}\n   165\t\n   166\tfunc reviewProcessMarked(pid int, entry []byte) (bool, error) {\n   167\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   168\t\tif err != nil {\n   169\t\t\treturn false, err\n   170\t\t}\n   171\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n   172\t\t\tif bytes.Equal(kv, entry) {\n   173\t\t\t\treturn true, nil\n   174\t\t\t}\n   175\t\t}\n   176\t\treturn false, nil\n   177\t}\n   178\t\n   179\tfunc reviewProcessOwner(pid int) (int, error) {\n   180\t\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n   181\t\tif err != nil {\n   182\t\t\treturn 0, err\n   183\t\t}\n   184\t\tst, ok := info.Sys().(*syscall.Stat_t)\n   185\t\tif !ok {\n   186\t\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n   187\t\t}\n   188\t\treturn int(st.Uid), nil\n   189\t}\n   190\t\n   191\tfunc reviewProcessGoneErr(err error) bool {\n   192\t\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n   193\t}\n   194\t\n   195\tfunc reviewProcessName(pid int) string {\n   196\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n   197\t\tif err != nil {\n   198\t\t\treturn \"?\"\n   199\t\t}\n   200\t\treturn strings.TrimSpace(string(raw))\n   201\t}\n   202\t\n   203\tfunc reviewProcessZombie(pid int) (bool, error) {\n   204\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n   205\t\tif err != nil {\n   206\t\t\treturn false, err\n   207\t\t}\n   208\t\t// The state follows the parenthesised command name.\n   209\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   210\t\t\treturn raw[i+2] == 'Z', nil\n   211\t\t}\n   212\t\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n   213\t}\n   214\t\n   215\t// reviewOpaqueProcessBaseline records, before the adapter starts, the\n   216\t// processes of this user whose environment cannot be read, by pid and start\n   217\t// time: they cannot be the run's.\n   218\tfunc reviewOpaqueProcessBaseline() map[int]string {\n   219\t\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv+\"=\\x00\"), time.Time{})\n   220\t\treturn opaque\n   221\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '1,420p' && nl -ba pose-mcp/internal/cli/delegate.go | sed -n '1,270p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"io\"\n    28\t\t\"os\"\n    29\t\t\"path/filepath\"\n    30\t\t\"strings\"\n    31\t\t\"time\"\n    32\t)\n    33\t\n    34\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    35\t// proven abandoned.\n    36\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    37\t\n    38\t// reviewOrphanReservationAge is how old a reservation without any marker\n    39\t// must be to count as abandoned.\n    40\tconst reviewOrphanReservationAge = 10 * time.Minute\n    41\t\n    42\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    43\t// dispatch ended before recording it, and removes its stalled marker. A\n    44\t// stalled marker whose reservation was never published is only removed; the\n    45\t// returned run is then empty.\n    46\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    47\t\tif !validAttemptFileName(attemptID) {\n    48\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    49\t\t}\n    50\t\tmarkers, _, err := s.ListDelegationActive()\n    51\t\tif err != nil {\n    52\t\t\treturn ReviewRun{}, err\n    53\t\t}\n    54\t\tvar marker *DelegationActiveRun\n    55\t\tfor i := range markers {\n    56\t\t\tif markers[i].AttemptID == attemptID {\n    57\t\t\t\tmarker = &markers[i]\n    58\t\t\t}\n    59\t\t}\n    60\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    61\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    62\t\t}\n    63\t\tdir, err := s.delegationActiveDir(true)\n    64\t\tif err != nil {\n    65\t\t\treturn ReviewRun{}, err\n    66\t\t}\n    67\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    68\t\tif err != nil {\n    69\t\t\treturn ReviewRun{}, err\n    70\t\t}\n    71\t\tdefer lock.Close()\n    72\t\tunlock, err := lockSpecTransferFile(lock)\n    73\t\tif err != nil {\n    74\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    75\t\t}\n    76\t\tdefer unlock()\n    77\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    78\t}\n    79\t\n    80\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    81\t\tvar reserved *DelegatedReviewAttempt\n    82\t\tif marker != nil {\n    83\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    84\t\t\tif err != nil {\n    85\t\t\t\treturn ReviewRun{}, err\n    86\t\t\t}\n    87\t\t\tfor i := range attempts {\n    88\t\t\t\tif attempts[i].AttemptID == attemptID {\n    89\t\t\t\t\treserved = &attempts[i]\n    90\t\t\t\t}\n    91\t\t\t}\n    92\t\t\tif reserved == nil {\n    93\t\t\t\t// The dispatch ended between its marker and its reservation:\n    94\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    95\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    96\t\t\t}\n    97\t\t} else {\n    98\t\t\tif !operatorConfirmed {\n    99\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n   100\t\t\t}\n   101\t\t\torphans, _, err := s.orphanReservations(now)\n   102\t\t\tif err != nil {\n   103\t\t\t\treturn ReviewRun{}, err\n   104\t\t\t}\n   105\t\t\tfor i := range orphans {\n   106\t\t\t\tif orphans[i].AttemptID == attemptID {\n   107\t\t\t\t\treserved = &orphans[i]\n   108\t\t\t\t}\n   109\t\t\t}\n   110\t\t\tif reserved == nil {\n   111\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   112\t\t\t}\n   113\t\t}\n   114\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   115\t\t\t// A release that stopped after the receipt completes by removing\n   116\t\t\t// the stalled marker; with no marker there is nothing to release.\n   117\t\t\tif marker != nil {\n   118\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   119\t\t\t\tif err != nil {\n   120\t\t\t\t\treturn ReviewRun{}, err\n   121\t\t\t\t}\n   122\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   123\t\t\t\tif err != nil {\n   124\t\t\t\t\treturn ReviewRun{}, err\n   125\t\t\t\t}\n   126\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   127\t\t\t}\n   128\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   129\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   130\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   131\t\t}\n   132\t\trun := abandonmentRun(*reserved, marker)\n   133\t\tcandidate, _ := identifiedReviewRun(run, nil)\n   134\t\t// A run the attempt already recorded, by its dispatch or by a release\n   135\t\t// interrupted before the receipt, completes the attempt; no second run\n   136\t\t// is written for it.\n   137\t\trecorded, found, err := s.recordedAttemptRun(*reserved, candidate.RunID)\n   138\t\tif err != nil {\n   139\t\t\treturn ReviewRun{}, err\n   140\t\t}\n   141\t\tif !found {\n   142\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   143\t\t\t\treturn ReviewRun{}, err\n   144\t\t\t}\n   145\t\t}\n   146\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   147\t\t\treturn recorded, err\n   148\t\t}\n   149\t\tif marker != nil {\n   150\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   151\t\t}\n   152\t\treturn recorded, nil\n   153\t}\n   154\t\n   155\t// abandonmentRun is the failed run a release records for reserved. Its\n   156\t// content is deterministic (no reading of the clock), so a release\n   157\t// interrupted between the run's witness and its record records the same run\n   158\t// again and completes it (review round 14, N5).\n   159\tfunc abandonmentRun(reserved DelegatedReviewAttempt, marker *DelegationActiveRun) ReviewRun {\n   160\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   161\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   162\t\t\tStartedAt: reserved.ReservedAt, EndedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview, Status: ReviewRunFailed}\n   163\t\tif marker != nil {\n   164\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt, run.EndedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt, marker.StalledAt\n   165\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   166\t\t} else {\n   167\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   168\t\t}\n   169\t\treturn run\n   170\t}\n   171\t\n   172\t// withoutOwnWitness drops the loss of the release's own run, a witness whose\n   173\t// record an interrupted release did not publish yet: recording it again\n   174\t// completes it.\n   175\tfunc withoutOwnWitness(lost []string, runID string) []string {\n   176\t\tvar out []string\n   177\t\tfor _, l := range lost {\n   178\t\t\tif runID != \"\" && strings.HasPrefix(l, \"witnessed run \"+runID+\":\") {\n   179\t\t\t\tcontinue\n   180\t\t\t}\n   181\t\t\tout = append(out, l)\n   182\t\t}\n   183\t\treturn out\n   184\t}\n   185\t\n   186\t// recordedAttemptRun finds the latest run recorded for attempt a. own is the\n   187\t// run the release would record, whose own missing record is not an unknown.\n   188\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt, own string) (ReviewRun, bool, error) {\n   189\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   190\t\tif err != nil {\n   191\t\t\treturn ReviewRun{}, false, err\n   192\t\t}\n   193\t\tif lost = withoutOwnWitness(lost, own); len(lost) > 0 {\n   194\t\t\t// An unreadable run may be this release's: the history is unknown,\n   195\t\t\t// and the release does not write another (review round 4, N3).\n   196\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   197\t\t}\n   198\t\tvar latest *ReviewRun\n   199\t\tfor i := range runs {\n   200\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   201\t\t\t\tlatest = &runs[i]\n   202\t\t\t}\n   203\t\t}\n   204\t\tif latest == nil {\n   205\t\t\treturn ReviewRun{}, false, nil\n   206\t\t}\n   207\t\treturn *latest, true, nil\n   208\t}\n   209\t\n   210\t// orphanReservations lists the reservations left without a receipt or a\n   211\t// marker, older than reviewOrphanReservationAge, and\n   212\t// says which reservations or receipts it could not read (review round 3, N3).\n   213\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   214\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   215\t\tdirs, dirsTruncated, err := readDirBounded(base, reviewOrphanScanMaxEntries)\n   216\t\tif errors.Is(err, os.ErrNotExist) {\n   217\t\t\treturn nil, nil, nil\n   218\t\t}\n   219\t\tif err != nil {\n   220\t\t\treturn nil, nil, err\n   221\t\t}\n   222\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   223\t\tif err != nil {\n   224\t\t\treturn nil, nil, err\n   225\t\t}\n   226\t\tif len(markerLost) > 0 {\n   227\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   228\t\t\t// have no marker (review round 6, N1).\n   229\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   230\t\t}\n   231\t\tmarked := map[string]bool{}\n   232\t\tfor _, m := range markers {\n   233\t\t\tmarked[m.AttemptID] = true\n   234\t\t}\n   235\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   236\t\tif err != nil {\n   237\t\t\treturn nil, nil, err\n   238\t\t}\n   239\t\n   240\t\t// A recorded run does not finish an attempt, its receipt does: a\n   241\t\t// reservation whose run was recorded without a receipt still blocks and\n   242\t\t// is released with that run (review round 5, N3).\n   243\t\t_ = runs\n   244\t\tvar out []DelegatedReviewAttempt\n   245\t\tvar lost []string\n   246\t\tbudget := reviewReadBudget(nil)\n   247\t\tfor _, d := range dirs {\n   248\t\t\tif !d.IsDir() {\n   249\t\t\t\tcontinue\n   250\t\t\t}\n   251\t\t\tentries, truncated, err := readDirBounded(filepath.Join(base, d.Name()), reviewOrphanScanMaxEntries)\n   252\t\t\tif err != nil {\n   253\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   254\t\t\t\tcontinue\n   255\t\t\t}\n   256\t\t\tif truncated {\n   257\t\t\t\tlost = append(lost, fmt.Sprintf(\"the reservations in %s exceed %d entries; the rest were not read\", d.Name(), reviewOrphanScanMaxEntries))\n   258\t\t\t}\n   259\t\t\tfor _, e := range entries {\n   260\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   261\t\t\t\t\tcontinue\n   262\t\t\t\t}\n   263\t\t\t\tvar a DelegatedReviewAttempt\n   264\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   265\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   266\t\t\t\t\tcontinue\n   267\t\t\t\t}\n   268\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   269\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   270\t\t\t\t\tcontinue\n   271\t\t\t\t}\n   272\t\t\t\tif marked[a.AttemptID] {\n   273\t\t\t\t\tcontinue\n   274\t\t\t\t}\n   275\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   276\t\t\t\t\tcontinue\n   277\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   278\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   279\t\t\t\t\tcontinue\n   280\t\t\t\t}\n   281\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   282\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   283\t\t\t\t\tcontinue\n   284\t\t\t\t}\n   285\t\t\t\tout = append(out, a)\n   286\t\t\t}\n   287\t\t}\n   288\t\tif dirsTruncated {\n   289\t\t\tlost = append(lost, fmt.Sprintf(\"the attempt directories exceed %d entries; the rest were not read\", reviewOrphanScanMaxEntries))\n   290\t\t}\n   291\t\t// Without the whole run history nothing is known to have no run, except\n   292\t\t// the loss of an orphan's own abandonment run an interrupted release left\n   293\t\t// before its record (review round 14, N5).\n   294\t\tfor _, a := range out {\n   295\t\t\town, _ := identifiedReviewRun(abandonmentRun(a, nil), nil)\n   296\t\t\trunLost = withoutOwnWitness(runLost, own.RunID)\n   297\t\t}\n   298\t\tif len(runLost) > 0 {\n   299\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   300\t\t}\n   301\t\treturn out, lost, nil\n   302\t}\n   303\t\n   304\t// reviewOrphanScanMaxEntries bounds each directory the orphan scan lists\n   305\t// (review round 10, N2).\n   306\tconst reviewOrphanScanMaxEntries = 10000\n   307\t\n   308\t// readDirBounded lists at most max entries of dir and says whether more exist.\n   309\tfunc readDirBounded(dir string, max int) ([]os.DirEntry, bool, error) {\n   310\t\tf, err := os.Open(dir)\n   311\t\tif err != nil {\n   312\t\t\treturn nil, false, err\n   313\t\t}\n   314\t\tdefer f.Close()\n   315\t\tentries, err := f.ReadDir(max + 1)\n   316\t\tif err != nil && !errors.Is(err, io.EOF) {\n   317\t\t\treturn nil, false, err\n   318\t\t}\n   319\t\tif len(entries) > max {\n   320\t\t\treturn entries[:max], true, nil\n   321\t\t}\n   322\t\treturn entries, false, nil\n   323\t}\n   324\t\n   325\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   326\t\tdir, err := s.delegationActiveDir(false)\n   327\t\tif err != nil {\n   328\t\t\treturn err\n   329\t\t}\n   330\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   331\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   332\t\t\t\treturn err\n   333\t\t\t}\n   334\t\t}\n   335\t\treturn nil\n   336\t}\n     1\tpackage cli\n     2\t\n     3\t// pose delegate: the one surface for delegated executions (spec\n     4\t// pose-delegation-surface; ADR 2026-10-26-delegation-is-a-first-class-execution-surface).\n     5\t//\n     6\t// pose review governs the subject (bundle, brief, attestation, verify);\n     7\t// pose delegate governs executions: who runs, with which access, and what\n     8\t// happened. review, adjudicate and smoke run through the delivered dispatch\n     9\t// path; the lifecycle commands read the same run records.\n    10\t//\n    11\t// Every subcommand takes the common flags with one meaning (R2): where a\n    12\t// command starts a run they set it (--agent, --access, --label, --lead);\n    13\t// where it names or lists runs they select them, and a run that does not\n    14\t// match is not the one named; --dry-run changes nothing anywhere.\n    15\t\n    16\timport (\n    17\t\t\"context\"\n    18\t\t\"crypto/rand\"\n    19\t\t\"encoding/json\"\n    20\t\t\"errors\"\n    21\t\t\"fmt\"\n    22\t\t\"io\"\n    23\t\t\"os\"\n    24\t\t\"os/signal\"\n    25\t\t\"path/filepath\"\n    26\t\t\"regexp\"\n    27\t\t\"sort\"\n    28\t\t\"strconv\"\n    29\t\t\"strings\"\n    30\t\t\"syscall\"\n    31\t\t\"time\"\n    32\t\n    33\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    34\t)\n    35\t\n    36\tconst delegateUsageText = \"pose delegate <review|adjudicate|smoke|task|ls|watch|wait|resume|handoff|cancel|agents> [args] [--agent auto|<name>] [--access read|sandboxed|write|full] [--label <name>] [--lead <vendor>] [--dry-run] [--json]\"\n    37\t\n    38\t// Versioned JSON documents of pose delegate (R10).\n    39\tconst (\n    40\t\tdelegateRunSchema    = \"pose.delegate.run/v1\"\n    41\t\tdelegatePlanSchema   = \"pose.delegate.plan/v1\"\n    42\t\tdelegateListSchema   = \"pose.delegate.ls/v1\"\n    43\t\tdelegateCancelSchema = \"pose.delegate.cancel/v1\"\n    44\t\tdelegateAgentsSchema = \"pose.delegate.agents/v1\"\n    45\t\tdelegateErrorSchema  = \"pose.delegate.error/v1\"\n    46\t)\n    47\t\n    48\t// Subcommands named by the ADR whose behaviour a later spec delivers.\n    49\tvar delegatePlanned = map[string]string{}\n    50\t\n    51\tvar (\n    52\t\tdelegateLabelRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n    53\t)\n    54\t\n    55\t// commonDelegateFlags are taken by every subcommand.\n    56\tvar commonDelegateFlags = []string{\"--agent\", \"--access\", \"--label\", \"--lead\", \"--dry-run\", \"--json\"}\n    57\t\n    58\t// tr picks the message for the session's locale.\n    59\tfunc tr(english, portuguese string) string { return cliText(cliLocaleValue(), english, portuguese) }\n    60\t\n    61\ttype delegateFlags struct {\n    62\t\tagent, access, label, lead, reason, noteFile string\n    63\t\trequest                                      string\n    64\t\tto, cd, effort, promptFile, session          string\n    65\t\taddDirs                                      []string\n    66\t\tnoNetwork, record, confirmAbandoned          bool\n    67\t\tdryRun, jsonOut, active, wait, detach        bool\n    68\t\tverbose, noFollow                            bool\n    69\t\tlines                                        int\n    70\t\twaitMax, timeout, refresh                    time.Duration\n    71\t\tpositional                                   []string\n    72\t}\n    73\t\n    74\t// parseDelegateFlags reads the common flags and the extra ones a subcommand\n    75\t// takes; problem is a message for the person, in their locale.\n    76\tfunc parseDelegateFlags(args []string, extra ...string) (delegateFlags, string) {\n    77\t\tf := delegateFlags{waitMax: 24 * time.Hour}\n    78\t\tpermit := map[string]bool{}\n    79\t\tfor _, name := range append(append([]string(nil), commonDelegateFlags...), extra...) {\n    80\t\t\tpermit[name] = true\n    81\t\t}\n    82\t\tfor i := 0; i < len(args); i++ {\n    83\t\t\targ := args[i]\n    84\t\t\tname, inline, hasInline := strings.Cut(arg, \"=\")\n    85\t\t\t// A lone - names stdin (spec pose-delegation-task R1).\n    86\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n    87\t\t\t\tf.positional = append(f.positional, arg)\n    88\t\t\t\tcontinue\n    89\t\t\t}\n    90\t\t\tif !permit[name] {\n    91\t\t\t\treturn f, tr(\"unknown or inapplicable flag \"+name, \"flag desconhecida ou inaplicável \"+name)\n    92\t\t\t}\n    93\t\t\tswitch name {\n    94\t\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\", \"--confirm-abandoned\":\n    95\t\t\t\tif hasInline {\n    96\t\t\t\t\treturn f, tr(name+\" takes no value\", name+\" não recebe valor\")\n    97\t\t\t\t}\n    98\t\t\t\tswitch name {\n    99\t\t\t\tcase \"--dry-run\":\n   100\t\t\t\t\tf.dryRun = true\n   101\t\t\t\tcase \"--json\":\n   102\t\t\t\t\tf.jsonOut = true\n   103\t\t\t\tcase \"--detach\":\n   104\t\t\t\t\tf.detach = true\n   105\t\t\t\tcase \"-v\":\n   106\t\t\t\t\tf.verbose = true\n   107\t\t\t\tcase \"--no-network\":\n   108\t\t\t\t\tf.noNetwork = true\n   109\t\t\t\tcase \"--record\":\n   110\t\t\t\t\tf.record = true\n   111\t\t\t\tcase \"--confirm-abandoned\":\n   112\t\t\t\t\tf.confirmAbandoned = true\n   113\t\t\t\tcase \"--no-follow\":\n   114\t\t\t\t\tf.noFollow = true\n   115\t\t\t\tdefault:\n   116\t\t\t\t\tf.active = true\n   117\t\t\t\t}\n   118\t\t\tcase \"--wait-until-reset\":\n   119\t\t\t\tf.wait = true\n   120\t\t\t\tif hasInline {\n   121\t\t\t\t\td, err := time.ParseDuration(inline)\n   122\t\t\t\t\tif err != nil || d <= 0 || d > 24*time.Hour {\n   123\t\t\t\t\t\treturn f, tr(\"--wait-until-reset takes a duration up to 24h\", \"--wait-until-reset recebe uma duração de até 24h\")\n   124\t\t\t\t\t}\n   125\t\t\t\t\tf.waitMax = d\n   126\t\t\t\t}\n   127\t\t\tdefault:\n   128\t\t\t\tvalue := inline\n   129\t\t\t\tif !hasInline {\n   130\t\t\t\t\t// --prompt - reads stdin (spec pose-delegation-task R8).\n   131\t\t\t\t\tif i+1 >= len(args) || strings.HasPrefix(args[i+1], \"-\") && !(name == \"--prompt\" && args[i+1] == \"-\") {\n   132\t\t\t\t\t\treturn f, tr(name+\" needs a value\", name+\" precisa de um valor\")\n   133\t\t\t\t\t}\n   134\t\t\t\t\tvalue = args[i+1]\n   135\t\t\t\t\ti++\n   136\t\t\t\t}\n   137\t\t\t\tswitch name {\n   138\t\t\t\tcase \"--agent\":\n   139\t\t\t\t\tf.agent = value\n   140\t\t\t\tcase \"--access\":\n   141\t\t\t\t\tif !containsString([]string{posemodel.DelegationAccessRead, posemodel.DelegationAccessSandboxed, posemodel.DelegationAccessWrite, posemodel.DelegationAccessFull}, value) {\n   142\t\t\t\t\t\treturn f, tr(\"--access takes read, sandboxed, write or full\", \"--access recebe read, sandboxed, write ou full\")\n   143\t\t\t\t\t}\n   144\t\t\t\t\tf.access = value\n   145\t\t\t\tcase \"--label\":\n   146\t\t\t\t\tif !delegateLabelRE.MatchString(value) {\n   147\t\t\t\t\t\treturn f, tr(\"--label takes letters, digits, '.', '_' and '-' (64 at most)\", \"--label aceita letras, dígitos, '.', '_' e '-' (no máximo 64)\")\n   148\t\t\t\t\t}\n   149\t\t\t\t\tf.label = value\n   150\t\t\t\tcase \"--lead\":\n   151\t\t\t\t\tvendor, model, err := posemodel.ParseLead(value)\n   152\t\t\t\t\tif err != nil {\n   153\t\t\t\t\t\treturn f, tr(\"--lead takes <vendor>[/<model>], such as openai or anthropic/claude-opus-5-5\", \"--lead recebe <vendor>[/<modelo>], como openai ou anthropic/claude-opus-5-5\")\n   154\t\t\t\t\t}\n   155\t\t\t\t\tf.lead = vendor\n   156\t\t\t\t\tif model != \"\" {\n   157\t\t\t\t\t\tf.lead += \"/\" + model\n   158\t\t\t\t\t}\n   159\t\t\t\tcase \"--reason\":\n   160\t\t\t\t\tf.reason = value\n   161\t\t\t\tcase \"--session\":\n   162\t\t\t\t\tf.session = value\n   163\t\t\t\tcase \"--request\":\n   164\t\t\t\t\tf.request = value\n   165\t\t\t\tcase \"--lines\":\n   166\t\t\t\t\tn, err := strconv.Atoi(value)\n   167\t\t\t\t\tif err != nil || n < 1 || n > 1000 {\n   168\t\t\t\t\t\treturn f, tr(\"--lines takes a number from 1 to 1000\", \"--lines recebe um número de 1 a 1000\")\n   169\t\t\t\t\t}\n   170\t\t\t\t\tf.lines = n\n   171\t\t\t\tcase \"--refresh\":\n   172\t\t\t\t\td, err := time.ParseDuration(value)\n   173\t\t\t\t\tif err != nil || d < 0 || d > time.Hour {\n   174\t\t\t\t\t\treturn f, tr(\"--refresh takes a duration from 0 to 1h (0 turns the preview's refresh off)\", \"--refresh recebe uma duração de 0 a 1h (0 desliga a atualização do preview)\")\n   175\t\t\t\t\t}\n   176\t\t\t\t\tf.refresh = d\n   177\t\t\t\tcase \"--timeout\":\n   178\t\t\t\t\td, err := time.ParseDuration(value)\n   179\t\t\t\t\tif err != nil || d <= 0 {\n   180\t\t\t\t\t\treturn f, tr(\"--timeout takes a positive duration\", \"--timeout recebe uma duração positiva\")\n   181\t\t\t\t\t}\n   182\t\t\t\t\tf.timeout = d\n   183\t\t\t\tcase \"--to\":\n   184\t\t\t\t\tf.to = value\n   185\t\t\t\tcase \"--cd\":\n   186\t\t\t\t\tf.cd = value\n   187\t\t\t\tcase \"--add-dir\":\n   188\t\t\t\t\tf.addDirs = append(f.addDirs, value)\n   189\t\t\t\tcase \"--effort\":\n   190\t\t\t\t\tf.effort = value\n   191\t\t\t\tcase \"--prompt\":\n   192\t\t\t\t\tf.promptFile = value\n   193\t\t\t\tcase \"--note-file\":\n   194\t\t\t\t\tf.noteFile = value\n   195\t\t\t\t}\n   196\t\t\t}\n   197\t\t}\n   198\t\treturn f, \"\"\n   199\t}\n   200\t\n   201\tfunc cmdDelegate(root string, args []string, stdout, stderr io.Writer) int {\n   202\t\tif len(args) == 0 {\n   203\t\t\tdispatchCommandHelp(\"delegate\", nil, stdout, cliLocaleValue())\n   204\t\t\treturn 0\n   205\t\t}\n   206\t\tsub, rest := args[0], args[1:]\n   207\t\tif spec, planned := delegatePlanned[sub]; planned {\n   208\t\t\treturn delegateUsage(stdout, stderr, rest, sub, tr(\"not available yet; it is delivered by spec \"+spec, \"ainda não está disponível; é entregue pela spec \"+spec))\n   209\t\t}\n   210\t\tswitch sub {\n   211\t\tcase posemodel.DelegationPurposeReview, posemodel.DelegationPurposeAdjudicate, posemodel.DelegationPurposeSmoke:\n   212\t\t\treturn cmdDelegatePurpose(root, sub, rest, stdout, stderr)\n   213\t\tcase posemodel.DelegationPurposeTask:\n   214\t\t\treturn cmdDelegateTask(root, rest, stdout, stderr)\n   215\t\tcase \"ls\":\n   216\t\t\treturn cmdDelegateLs(root, rest, stdout, stderr)\n   217\t\tcase \"resume\":\n   218\t\t\treturn cmdDelegateResume(root, rest, stdout, stderr)\n   219\t\tcase \"cancel\":\n   220\t\t\treturn cmdDelegateCancel(root, rest, stdout, stderr)\n   221\t\tcase \"agents\":\n   222\t\t\treturn cmdDelegateAgents(root, rest, stdout, stderr)\n   223\t\tcase \"wait\":\n   224\t\t\treturn cmdDelegateWait(root, rest, stdout, stderr)\n   225\t\tcase \"watch\":\n   226\t\t\treturn cmdDelegateWatch(root, rest, stdout, stderr)\n   227\t\tcase \"handoff\":\n   228\t\t\treturn cmdDelegateHandoff(root, rest, stdout, stderr)\n   229\t\t}\n   230\t\treturn delegateUsage(stdout, stderr, rest, sub, tr(\"unknown subcommand\", \"subcomando desconhecido\")+\"\\n\"+tr(\"Usage: \", \"Uso: \")+delegateUsageText)\n   231\t}\n   232\t\n   233\t// delegateUsage reports a usage error: exit 2, as text, or as the error\n   234\t// document when the caller asked for --json (R10).\n   235\tfunc delegateUsage(stdout, stderr io.Writer, args []string, command, msg string) int {\n   236\t\tfor _, arg := range args {\n   237\t\t\tif arg == \"--json\" {\n   238\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg, \"usage\": true})\n   239\t\t\t\treturn 2\n   240\t\t\t}\n   241\t\t}\n   242\t\thandBackRefusal(map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg, \"usage\": true}, 2)\n   243\t\treturn usageError(stderr, \"pose delegate \"+command+\": \"+msg)\n   244\t}\n   245\t\n   246\tfunc writeDelegateJSON(stdout io.Writer, doc any) {\n   247\t\t// Every error document a detached run writes is handed back (B03); a\n   248\t\t// caller that knows its exit code hands it back first.\n   249\t\tif m, ok := doc.(map[string]any); ok && m[\"schema\"] == delegateErrorSchema {\n   250\t\t\tcode := 1\n   251\t\t\tif m[\"usage\"] == true {\n   252\t\t\t\tcode = 2\n   253\t\t\t}\n   254\t\t\thandBackRefusal(m, code)\n   255\t\t}\n   256\t\tenc := json.NewEncoder(stdout)\n   257\t\tenc.SetIndent(\"\", \"  \")\n   258\t\t_ = enc.Encode(doc)\n   259\t}\n   260\t\n   261\t// delegateFail reports a failure as text or as the error document.\n   262\tfunc delegateFail(stdout, stderr io.Writer, jsonOut bool, command string, code int, err error) int {\n   263\t\tmsg := strings.TrimPrefix(err.Error(), \"pose: \")\n   264\t\tdoc := map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg}\n   265\t\t// The reason code of a refusal is the same over MCP (spec\n   266\t\t// pose-delegation-mcp R5).\n   267\t\tif code := posemodel.DelegationReasonCode(err); code != \"\" {\n   268\t\t\tdoc[\"reason_code\"] = code\n   269\t\t}\n   270\t\tvar ambiguous *posemodel.ErrDelegationRefAmbiguous\n","exit_code":0,"status":"completed"}}
