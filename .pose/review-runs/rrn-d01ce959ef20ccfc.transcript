{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/delegate.go | sed -n '870,1030p'; nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '1,230p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_tree_windows.go | sed -n '1,220p' && nl -ba pose-mcp/internal/pose/review_reap_linux.go | sed -n '1,280p'\"","aggregated_output":"     1\t//go:build windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Ending the reviewer's process tree on Windows (spec\n     6\t// pose-review-run-reaps-lingering-reviewer-processes R1, review round 13,\n     7\t// N1): the adapter starts suspended, is assigned to a job object that kills\n     8\t// every process in it when the job is terminated or its last handle closes,\n     9\t// and only then resumes, so no descendant can start outside the job. The\n    10\t// dispatch terminates the job after the run, on a timeout, and, through the\n    11\t// kill-on-close limit, when the dispatching process ends.\n    12\t\n    13\timport (\n    14\t\t\"fmt\"\n    15\t\t\"os/exec\"\n    16\t\t\"sync\"\n    17\t\t\"syscall\"\n    18\t\t\"time\"\n    19\t\t\"unsafe\"\n    20\t\n    21\t\t\"golang.org/x/sys/windows\"\n    22\t)\n    23\t\n    24\tvar reviewJobs sync.Map // *exec.Cmd -> windows.Handle\n    25\t\n    26\t// jobBasicAccounting is JOBOBJECT_BASIC_ACCOUNTING_INFORMATION.\n    27\ttype jobBasicAccounting struct {\n    28\t\tTotalUserTime             int64\n    29\t\tTotalKernelTime           int64\n    30\t\tThisPeriodTotalUserTime   int64\n    31\t\tThisPeriodTotalKernelTime int64\n    32\t\tTotalPageFaultCount       uint32\n    33\t\tTotalProcesses            uint32\n    34\t\tActiveProcesses           uint32\n    35\t\tTotalTerminatedProcesses  uint32\n    36\t}\n    37\t\n    38\t// prepareReviewProcessTree makes cmd start suspended, so it can be placed in\n    39\t// its job before it runs.\n    40\tfunc prepareReviewProcessTree(cmd *exec.Cmd) {\n    41\t\tif cmd.SysProcAttr == nil {\n    42\t\t\tcmd.SysProcAttr = &syscall.SysProcAttr{}\n    43\t\t}\n    44\t\tcmd.SysProcAttr.CreationFlags |= windows.CREATE_SUSPENDED\n    45\t\tcmd.Cancel = func() error { return terminateReviewJob(cmd) }\n    46\t}\n    47\t\n    48\t// attachReviewProcessTree places the started, suspended process in a new\n    49\t// kill-on-close job and resumes it. A process that cannot be placed is\n    50\t// terminated: it never runs outside the job.\n    51\tfunc attachReviewProcessTree(cmd *exec.Cmd) error {\n    52\t\tjob, err := windows.CreateJobObject(nil, nil)\n    53\t\tif err != nil {\n    54\t\t\t_ = cmd.Process.Kill()\n    55\t\t\treturn fmt.Errorf(\"the reviewer's job object could not be created: %w\", err)\n    56\t\t}\n    57\t\tinfo := windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION{}\n    58\t\tinfo.BasicLimitInformation.LimitFlags = windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE\n    59\t\tif _, err := windows.SetInformationJobObject(job, windows.JobObjectExtendedLimitInformation, uintptr(unsafe.Pointer(&info)), uint32(unsafe.Sizeof(info))); err != nil {\n    60\t\t\t_ = windows.CloseHandle(job)\n    61\t\t\t_ = cmd.Process.Kill()\n    62\t\t\treturn fmt.Errorf(\"the reviewer's job object could not be limited: %w\", err)\n    63\t\t}\n    64\t\tprocess, err := windows.OpenProcess(windows.PROCESS_SET_QUOTA|windows.PROCESS_TERMINATE, false, uint32(cmd.Process.Pid))\n    65\t\tif err != nil {\n    66\t\t\t_ = windows.CloseHandle(job)\n    67\t\t\t_ = cmd.Process.Kill()\n    68\t\t\treturn fmt.Errorf(\"the reviewer's process could not be opened: %w\", err)\n    69\t\t}\n    70\t\tdefer windows.CloseHandle(process)\n    71\t\tif err := windows.AssignProcessToJobObject(job, process); err != nil {\n    72\t\t\t_ = windows.CloseHandle(job)\n    73\t\t\t_ = cmd.Process.Kill()\n    74\t\t\treturn fmt.Errorf(\"the reviewer's process could not join its job: %w\", err)\n    75\t\t}\n    76\t\treviewJobs.Store(cmd, job)\n    77\t\tif err := resumeProcessThreads(uint32(cmd.Process.Pid)); err != nil {\n    78\t\t\t_ = terminateReviewJob(cmd)\n    79\t\t\treturn fmt.Errorf(\"the reviewer's process could not be resumed: %w\", err)\n    80\t\t}\n    81\t\treturn nil\n    82\t}\n    83\t\n    84\t// resumeProcessThreads resumes every thread of pid; a suspended process has\n    85\t// only its main thread.\n    86\tfunc resumeProcessThreads(pid uint32) error {\n    87\t\tsnapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPTHREAD, 0)\n    88\t\tif err != nil {\n    89\t\t\treturn err\n    90\t\t}\n    91\t\tdefer windows.CloseHandle(snapshot)\n    92\t\tentry := windows.ThreadEntry32{Size: uint32(unsafe.Sizeof(windows.ThreadEntry32{}))}\n    93\t\tresumed := 0\n    94\t\tfor err = windows.Thread32First(snapshot, &entry); err == nil; err = windows.Thread32Next(snapshot, &entry) {\n    95\t\t\tif entry.OwnerProcessID != pid {\n    96\t\t\t\tcontinue\n    97\t\t\t}\n    98\t\t\tthread, err := windows.OpenThread(windows.THREAD_SUSPEND_RESUME, false, entry.ThreadID)\n    99\t\t\tif err != nil {\n   100\t\t\t\treturn err\n   101\t\t\t}\n   102\t\t\t_, rerr := windows.ResumeThread(thread)\n   103\t\t\t_ = windows.CloseHandle(thread)\n   104\t\t\tif rerr != nil {\n   105\t\t\t\treturn rerr\n   106\t\t\t}\n   107\t\t\tresumed++\n   108\t\t}\n   109\t\tif resumed == 0 {\n   110\t\t\treturn fmt.Errorf(\"no thread of process %d was found\", pid)\n   111\t\t}\n   112\t\treturn nil\n   113\t}\n   114\t\n   115\t// terminateReviewJob ends every process of cmd's job and waits until the job\n   116\t// is empty.\n   117\tfunc terminateReviewJob(cmd *exec.Cmd) error {\n   118\t\tvalue, ok := reviewJobs.Load(cmd)\n   119\t\tif !ok {\n   120\t\t\tif cmd.Process != nil {\n   121\t\t\t\treturn cmd.Process.Kill()\n   122\t\t\t}\n   123\t\t\treturn nil\n   124\t\t}\n   125\t\tjob := value.(windows.Handle)\n   126\t\tif err := windows.TerminateJobObject(job, 1); err != nil {\n   127\t\t\treturn fmt.Errorf(\"the reviewer's job could not be terminated: %w\", err)\n   128\t\t}\n   129\t\tdeadline := time.Now().Add(reviewReapWait)\n   130\t\tfor {\n   131\t\t\tvar acct jobBasicAccounting\n   132\t\t\tif err := windows.QueryInformationJobObject(job, windows.JobObjectBasicAccountingInformation, uintptr(unsafe.Pointer(&acct)), uint32(unsafe.Sizeof(acct)), nil); err != nil {\n   133\t\t\t\treturn fmt.Errorf(\"the reviewer's job could not be inspected: %w\", err)\n   134\t\t\t}\n   135\t\t\tif acct.ActiveProcesses == 0 {\n   136\t\t\t\treturn nil\n   137\t\t\t}\n   138\t\t\tif time.Now().After(deadline) {\n   139\t\t\t\treturn fmt.Errorf(\"%d process(es) of the reviewer's job could not be ended\", acct.ActiveProcesses)\n   140\t\t\t}\n   141\t\t\ttime.Sleep(20 * time.Millisecond)\n   142\t\t}\n   143\t}\n   144\t\n   145\t// releaseReviewProcessTree terminates the job and closes its handle.\n   146\tfunc releaseReviewProcessTree(cmd *exec.Cmd) error {\n   147\t\terr := terminateReviewJob(cmd)\n   148\t\tif value, ok := reviewJobs.LoadAndDelete(cmd); ok {\n   149\t\t\t_ = windows.CloseHandle(value.(windows.Handle))\n   150\t\t}\n   151\t\treturn err\n   152\t}\n     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Leftover reviewer processes, the fallback of an embedder that does not run\n     6\t// the adapter under the review run shim (review_shim.go), which is the Linux\n     7\t// path of the pose command (spec\n     8\t// pose-review-run-reaps-lingering-reviewer-processes R1, L6): an adapter such as\n     9\t// `codex exec` runs each command in a session of its own, so killing the\n    10\t// adapter's process group misses a command the reviewer left running, and\n    11\t// that command keeps writing into the run's runtime directory while the\n    12\t// cleanup inventory reads it. Every process of the run inherits\n    13\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n    14\t// that entry, ends them and waits for them before the inventory.\n    15\t//\n    16\t// Each process is pinned by a pidfd before it is signalled, and its\n    17\t// environment is read again through the pinned process, so a pid reused by\n    18\t// an unrelated process between the scan and the signal is never killed\n    19\t// (review round 1, N3). A scan that cannot list or read the state of the\n    20\t// processes fails. A process of this user whose environment cannot be read\n    21\t// (one that made itself non-inspectable) cannot be matched: one that already\n    22\t// existed before the adapter started is not the run's and is skipped; any\n    23\t// other may be the run's, so the scan fails and the run stays unconcludable\n    24\t// (review round 2, N2).\n    25\t\n    26\timport (\n    27\t\t\"bytes\"\n    28\t\t\"errors\"\n    29\t\t\"fmt\"\n    30\t\t\"io/fs\"\n    31\t\t\"os\"\n    32\t\t\"path/filepath\"\n    33\t\t\"strconv\"\n    34\t\t\"strings\"\n    35\t\t\"syscall\"\n    36\t\t\"time\"\n    37\t\n    38\t\t\"golang.org/x/sys/unix\"\n    39\t)\n    40\t\n    41\t// reapSealedCheckoutProcesses ends every process whose environment names\n    42\t// worktree as its sealed checkout and returns a description of each. An\n    43\t// error means the run's processes could not be proven ended within the bound.\n    44\tfunc reapSealedCheckoutProcesses(worktree string, baseline map[int]string) ([]string, int, error) {\n    45\t\tif worktree == \"\" {\n    46\t\t\treturn nil, 0, nil\n    47\t\t}\n    48\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n    49\t\tvar reaped []string\n    50\t\tseen := map[int]bool{}\n    51\t\tdeadline := time.Now().Add(reviewReapWait)\n    52\t\tunreadable := 0\n    53\t\tfor {\n    54\t\t\talive, opaque, err := reviewMarkedProcesses(entry, deadline)\n    55\t\t\tif err != nil {\n    56\t\t\t\treturn reaped, unreadable, err\n    57\t\t\t}\n    58\t\t\tunreadable = 0\n    59\t\t\tfor pid, start := range opaque {\n    60\t\t\t\tif prior, ok := baseline[pid]; !ok || prior != start {\n    61\t\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"process %d of this user started during the run and cannot be inspected; it may be the run's and was not ended\", pid)\n    62\t\t\t\t}\n    63\t\t\t\tunreadable++\n    64\t\t\t}\n    65\t\t\tfor _, pid := range alive {\n    66\t\t\t\tif !seen[pid] {\n    67\t\t\t\t\tseen[pid] = true\n    68\t\t\t\t\t// Only the pid: the name is the reviewer's to choose and is not\n    69\t\t\t\t\t// recorded (review round 7, N4).\n    70\t\t\t\t\treaped = append(reaped, strconv.Itoa(pid))\n    71\t\t\t\t}\n    72\t\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n    73\t\t\t\t\treturn reaped, unreadable, err\n    74\t\t\t\t}\n    75\t\t\t}\n    76\t\t\tif len(alive) == 0 {\n    77\t\t\t\treturn reaped, unreadable, nil\n    78\t\t\t}\n    79\t\t\tif time.Now().After(deadline) {\n    80\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n    81\t\t\t}\n    82\t\t\ttime.Sleep(50 * time.Millisecond)\n    83\t\t}\n    84\t}\n    85\t\n    86\t// reviewMarkedProcesses lists the live processes whose environment holds\n    87\t// entry, and counts this user's processes whose environment could not be\n    88\t// read. A process that is gone is skipped.\n    89\tfunc reviewMarkedProcesses(entry []byte, deadline time.Time) ([]int, map[int]string, error) {\n    90\t\tdirs, err := os.ReadDir(\"/proc\")\n    91\t\tif err != nil {\n    92\t\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    93\t\t}\n    94\t\tunreadable := map[int]string{}\n    95\t\tself, uid := os.Getpid(), os.Getuid()\n    96\t\tvar out []int\n    97\t\tfor _, d := range dirs {\n    98\t\t\tif !deadline.IsZero() && time.Now().After(deadline) {\n    99\t\t\t\treturn nil, unreadable, fmt.Errorf(\"the run's processes could not be scanned within the bound\")\n   100\t\t\t}\n   101\t\t\tpid, err := strconv.Atoi(d.Name())\n   102\t\t\tif err != nil || pid == self {\n   103\t\t\t\tcontinue\n   104\t\t\t}\n   105\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n   106\t\t\tswitch {\n   107\t\t\tcase reviewProcessGoneErr(err):\n   108\t\t\t\tcontinue\n   109\t\t\tcase err != nil:\n   110\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n   111\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n   112\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   113\t\t\t\t\tcontinue\n   114\t\t\t\t}\n   115\t\t\t\tstart, serr := processStartTime(pid)\n   116\t\t\t\tif reviewProcessGoneErr(serr) {\n   117\t\t\t\t\tcontinue\n   118\t\t\t\t}\n   119\t\t\t\tif serr != nil || start == \"\" {\n   120\t\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d start could not be read: %v\", pid, serr)\n   121\t\t\t\t}\n   122\t\t\t\tunreadable[pid] = start\n   123\t\t\t\tcontinue\n   124\t\t\tcase !marked:\n   125\t\t\t\tcontinue\n   126\t\t\t}\n   127\t\t\tzombie, err := reviewProcessZombie(pid)\n   128\t\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n   129\t\t\t\tcontinue\n   130\t\t\t}\n   131\t\t\tif err != nil {\n   132\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n   133\t\t\t}\n   134\t\t\tout = append(out, pid)\n   135\t\t}\n   136\t\treturn out, unreadable, nil\n   137\t}\n   138\t\n   139\t// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n   140\t// after the environment read through that same pinned process still holds\n   141\t// entry.\n   142\tfunc killPinnedMarkedProcess(pid int, entry []byte) error {\n   143\t\tfd, err := unix.PidfdOpen(pid, 0)\n   144\t\tif errors.Is(err, unix.ESRCH) {\n   145\t\t\treturn nil\n   146\t\t}\n   147\t\tif err != nil {\n   148\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   149\t\t}\n   150\t\tdefer unix.Close(fd)\n   151\t\t// The pidfd names one process for its lifetime; if pid was reused before\n   152\t\t// it was opened, the new process does not carry this run's entry.\n   153\t\tmarked, err := reviewProcessMarked(pid, entry)\n   154\t\tif reviewProcessGoneErr(err) || err == nil && !marked {\n   155\t\t\treturn nil\n   156\t\t}\n   157\t\tif err != nil {\n   158\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   159\t\t}\n   160\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   161\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   162\t\t}\n   163\t\treturn nil\n   164\t}\n   165\t\n   166\tfunc reviewProcessMarked(pid int, entry []byte) (bool, error) {\n   167\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   168\t\tif err != nil {\n   169\t\t\treturn false, err\n   170\t\t}\n   171\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n   172\t\t\tif bytes.Equal(kv, entry) {\n   173\t\t\t\treturn true, nil\n   174\t\t\t}\n   175\t\t}\n   176\t\treturn false, nil\n   177\t}\n   178\t\n   179\tfunc reviewProcessOwner(pid int) (int, error) {\n   180\t\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n   181\t\tif err != nil {\n   182\t\t\treturn 0, err\n   183\t\t}\n   184\t\tst, ok := info.Sys().(*syscall.Stat_t)\n   185\t\tif !ok {\n   186\t\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n   187\t\t}\n   188\t\treturn int(st.Uid), nil\n   189\t}\n   190\t\n   191\tfunc reviewProcessGoneErr(err error) bool {\n   192\t\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n   193\t}\n   194\t\n   195\tfunc reviewProcessName(pid int) string {\n   196\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n   197\t\tif err != nil {\n   198\t\t\treturn \"?\"\n   199\t\t}\n   200\t\treturn strings.TrimSpace(string(raw))\n   201\t}\n   202\t\n   203\tfunc reviewProcessZombie(pid int) (bool, error) {\n   204\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n   205\t\tif err != nil {\n   206\t\t\treturn false, err\n   207\t\t}\n   208\t\t// The state follows the parenthesised command name.\n   209\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   210\t\t\treturn raw[i+2] == 'Z', nil\n   211\t\t}\n   212\t\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n   213\t}\n   214\t\n   215\t// reviewOpaqueProcessBaseline records, before the adapter starts, the\n   216\t// processes of this user whose environment cannot be read, by pid and start\n   217\t// time: they cannot be the run's.\n   218\tfunc reviewOpaqueProcessBaseline() map[int]string {\n   219\t\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv+\"=\\x00\"), time.Time{})\n   220\t\treturn opaque\n   221\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '1,380p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"io\"\n    28\t\t\"os\"\n    29\t\t\"path/filepath\"\n    30\t\t\"strings\"\n    31\t\t\"time\"\n    32\t)\n    33\t\n    34\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    35\t// proven abandoned.\n    36\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    37\t\n    38\t// reviewOrphanReservationAge is how old a reservation without any marker\n    39\t// must be to count as abandoned.\n    40\tconst reviewOrphanReservationAge = 10 * time.Minute\n    41\t\n    42\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    43\t// dispatch ended before recording it, and removes its stalled marker. A\n    44\t// stalled marker whose reservation was never published is only removed; the\n    45\t// returned run is then empty.\n    46\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    47\t\tif !validAttemptFileName(attemptID) {\n    48\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    49\t\t}\n    50\t\tmarkers, _, err := s.ListDelegationActive()\n    51\t\tif err != nil {\n    52\t\t\treturn ReviewRun{}, err\n    53\t\t}\n    54\t\tvar marker *DelegationActiveRun\n    55\t\tfor i := range markers {\n    56\t\t\tif markers[i].AttemptID == attemptID {\n    57\t\t\t\tmarker = &markers[i]\n    58\t\t\t}\n    59\t\t}\n    60\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    61\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    62\t\t}\n    63\t\tdir, err := s.delegationActiveDir(true)\n    64\t\tif err != nil {\n    65\t\t\treturn ReviewRun{}, err\n    66\t\t}\n    67\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    68\t\tif err != nil {\n    69\t\t\treturn ReviewRun{}, err\n    70\t\t}\n    71\t\tdefer lock.Close()\n    72\t\tunlock, err := lockSpecTransferFile(lock)\n    73\t\tif err != nil {\n    74\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    75\t\t}\n    76\t\tdefer unlock()\n    77\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    78\t}\n    79\t\n    80\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    81\t\tvar reserved *DelegatedReviewAttempt\n    82\t\tif marker != nil {\n    83\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    84\t\t\tif err != nil {\n    85\t\t\t\treturn ReviewRun{}, err\n    86\t\t\t}\n    87\t\t\tfor i := range attempts {\n    88\t\t\t\tif attempts[i].AttemptID == attemptID {\n    89\t\t\t\t\treserved = &attempts[i]\n    90\t\t\t\t}\n    91\t\t\t}\n    92\t\t\tif reserved == nil {\n    93\t\t\t\t// The dispatch ended between its marker and its reservation:\n    94\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    95\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    96\t\t\t}\n    97\t\t} else {\n    98\t\t\tif !operatorConfirmed {\n    99\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n   100\t\t\t}\n   101\t\t\torphans, _, err := s.orphanReservations(now)\n   102\t\t\tif err != nil {\n   103\t\t\t\treturn ReviewRun{}, err\n   104\t\t\t}\n   105\t\t\tfor i := range orphans {\n   106\t\t\t\tif orphans[i].AttemptID == attemptID {\n   107\t\t\t\t\treserved = &orphans[i]\n   108\t\t\t\t}\n   109\t\t\t}\n   110\t\t\tif reserved == nil {\n   111\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   112\t\t\t}\n   113\t\t}\n   114\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   115\t\t\t// A release that stopped after the receipt completes by removing\n   116\t\t\t// the stalled marker; with no marker there is nothing to release.\n   117\t\t\tif marker != nil {\n   118\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   119\t\t\t\tif err != nil {\n   120\t\t\t\t\treturn ReviewRun{}, err\n   121\t\t\t\t}\n   122\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   123\t\t\t\tif err != nil {\n   124\t\t\t\t\treturn ReviewRun{}, err\n   125\t\t\t\t}\n   126\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   127\t\t\t}\n   128\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   129\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   130\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   131\t\t}\n   132\t\trun := abandonmentRun(*reserved, marker)\n   133\t\tcandidate, _ := identifiedReviewRun(run, nil)\n   134\t\t// A run the attempt already recorded, by its dispatch or by a release\n   135\t\t// interrupted before the receipt, completes the attempt; no second run\n   136\t\t// is written for it.\n   137\t\trecorded, found, err := s.recordedAttemptRun(*reserved, candidate.RunID)\n   138\t\tif err != nil {\n   139\t\t\treturn ReviewRun{}, err\n   140\t\t}\n   141\t\tif !found {\n   142\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   143\t\t\t\treturn ReviewRun{}, err\n   144\t\t\t}\n   145\t\t}\n   146\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   147\t\t\treturn recorded, err\n   148\t\t}\n   149\t\tif marker != nil {\n   150\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   151\t\t}\n   152\t\treturn recorded, nil\n   153\t}\n   154\t\n   155\t// abandonmentRun is the failed run a release records for reserved. Its\n   156\t// content is deterministic (no reading of the clock), so a release\n   157\t// interrupted between the run's witness and its record records the same run\n   158\t// again and completes it (review round 14, N5).\n   159\tfunc abandonmentRun(reserved DelegatedReviewAttempt, marker *DelegationActiveRun) ReviewRun {\n   160\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   161\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   162\t\t\tStartedAt: reserved.ReservedAt, EndedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview, Status: ReviewRunFailed}\n   163\t\tif marker != nil {\n   164\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt, run.EndedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt, marker.StalledAt\n   165\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   166\t\t} else {\n   167\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   168\t\t}\n   169\t\treturn run\n   170\t}\n   171\t\n   172\t// withoutOwnWitness drops the loss of the release's own run, a witness whose\n   173\t// record an interrupted release did not publish yet: recording it again\n   174\t// completes it.\n   175\tfunc withoutOwnWitness(lost []string, runID string) []string {\n   176\t\tvar out []string\n   177\t\tfor _, l := range lost {\n   178\t\t\tif runID != \"\" && strings.HasPrefix(l, \"witnessed run \"+runID+\":\") {\n   179\t\t\t\tcontinue\n   180\t\t\t}\n   181\t\t\tout = append(out, l)\n   182\t\t}\n   183\t\treturn out\n   184\t}\n   185\t\n   186\t// recordedAttemptRun finds the latest run recorded for attempt a. own is the\n   187\t// run the release would record, whose own missing record is not an unknown.\n   188\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt, own string) (ReviewRun, bool, error) {\n   189\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   190\t\tif err != nil {\n   191\t\t\treturn ReviewRun{}, false, err\n   192\t\t}\n   193\t\tif lost = withoutOwnWitness(lost, own); len(lost) > 0 {\n   194\t\t\t// An unreadable run may be this release's: the history is unknown,\n   195\t\t\t// and the release does not write another (review round 4, N3).\n   196\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   197\t\t}\n   198\t\tvar latest *ReviewRun\n   199\t\tfor i := range runs {\n   200\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   201\t\t\t\tlatest = &runs[i]\n   202\t\t\t}\n   203\t\t}\n   204\t\tif latest == nil {\n   205\t\t\treturn ReviewRun{}, false, nil\n   206\t\t}\n   207\t\treturn *latest, true, nil\n   208\t}\n   209\t\n   210\t// orphanReservations lists the reservations left without a receipt or a\n   211\t// marker, older than reviewOrphanReservationAge, and\n   212\t// says which reservations or receipts it could not read (review round 3, N3).\n   213\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   214\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   215\t\tdirs, dirsTruncated, err := readDirBounded(base, reviewOrphanScanMaxEntries)\n   216\t\tif errors.Is(err, os.ErrNotExist) {\n   217\t\t\treturn nil, nil, nil\n   218\t\t}\n   219\t\tif err != nil {\n   220\t\t\treturn nil, nil, err\n   221\t\t}\n   222\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   223\t\tif err != nil {\n   224\t\t\treturn nil, nil, err\n   225\t\t}\n   226\t\tif len(markerLost) > 0 {\n   227\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   228\t\t\t// have no marker (review round 6, N1).\n   229\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   230\t\t}\n   231\t\tmarked := map[string]bool{}\n   232\t\tfor _, m := range markers {\n   233\t\t\tmarked[m.AttemptID] = true\n   234\t\t}\n   235\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   236\t\tif err != nil {\n   237\t\t\treturn nil, nil, err\n   238\t\t}\n   239\t\n   240\t\t// A recorded run does not finish an attempt, its receipt does: a\n   241\t\t// reservation whose run was recorded without a receipt still blocks and\n   242\t\t// is released with that run (review round 5, N3).\n   243\t\t_ = runs\n   244\t\tvar out []DelegatedReviewAttempt\n   245\t\tvar lost []string\n   246\t\tbudget := reviewReadBudget(nil)\n   247\t\tfor _, d := range dirs {\n   248\t\t\tif !d.IsDir() {\n   249\t\t\t\tcontinue\n   250\t\t\t}\n   251\t\t\tentries, truncated, err := readDirBounded(filepath.Join(base, d.Name()), reviewOrphanScanMaxEntries)\n   252\t\t\tif err != nil {\n   253\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   254\t\t\t\tcontinue\n   255\t\t\t}\n   256\t\t\tif truncated {\n   257\t\t\t\tlost = append(lost, fmt.Sprintf(\"the reservations in %s exceed %d entries; the rest were not read\", d.Name(), reviewOrphanScanMaxEntries))\n   258\t\t\t}\n   259\t\t\tfor _, e := range entries {\n   260\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   261\t\t\t\t\tcontinue\n   262\t\t\t\t}\n   263\t\t\t\tvar a DelegatedReviewAttempt\n   264\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   265\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   266\t\t\t\t\tcontinue\n   267\t\t\t\t}\n   268\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   269\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   270\t\t\t\t\tcontinue\n   271\t\t\t\t}\n   272\t\t\t\tif marked[a.AttemptID] {\n   273\t\t\t\t\tcontinue\n   274\t\t\t\t}\n   275\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   276\t\t\t\t\tcontinue\n   277\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   278\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   279\t\t\t\t\tcontinue\n   280\t\t\t\t}\n   281\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   282\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   283\t\t\t\t\tcontinue\n   284\t\t\t\t}\n   285\t\t\t\tout = append(out, a)\n   286\t\t\t}\n   287\t\t}\n   288\t\tif dirsTruncated {\n   289\t\t\tlost = append(lost, fmt.Sprintf(\"the attempt directories exceed %d entries; the rest were not read\", reviewOrphanScanMaxEntries))\n   290\t\t}\n   291\t\t// Without the whole run history nothing is known to have no run, except\n   292\t\t// the loss of an orphan's own abandonment run an interrupted release left\n   293\t\t// before its record (review round 14, N5).\n   294\t\tfor _, a := range out {\n   295\t\t\town, _ := identifiedReviewRun(abandonmentRun(a, nil), nil)\n   296\t\t\trunLost = withoutOwnWitness(runLost, own.RunID)\n   297\t\t}\n   298\t\tif len(runLost) > 0 {\n   299\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   300\t\t}\n   301\t\treturn out, lost, nil\n   302\t}\n   303\t\n   304\t// reviewOrphanScanMaxEntries bounds each directory the orphan scan lists\n   305\t// (review round 10, N2).\n   306\tconst reviewOrphanScanMaxEntries = 10000\n   307\t\n   308\t// readDirBounded lists at most max entries of dir and says whether more exist.\n   309\tfunc readDirBounded(dir string, max int) ([]os.DirEntry, bool, error) {\n   310\t\tf, err := os.Open(dir)\n   311\t\tif err != nil {\n   312\t\t\treturn nil, false, err\n   313\t\t}\n   314\t\tdefer f.Close()\n   315\t\tentries, err := f.ReadDir(max + 1)\n   316\t\tif err != nil && !errors.Is(err, io.EOF) {\n   317\t\t\treturn nil, false, err\n   318\t\t}\n   319\t\tif len(entries) > max {\n   320\t\t\treturn entries[:max], true, nil\n   321\t\t}\n   322\t\treturn entries, false, nil\n   323\t}\n   324\t\n   325\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   326\t\tdir, err := s.delegationActiveDir(false)\n   327\t\tif err != nil {\n   328\t\t\treturn err\n   329\t\t}\n   330\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   331\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   332\t\t\t\treturn err\n   333\t\t\t}\n   334\t\t}\n   335\t\treturn nil\n   336\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/delegate.go | sed -n '870,1030p'; nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '1,230p'\"","aggregated_output":"   870\t\t}\n   871\t\tstore := posemodel.Store{Root: root}\n   872\t\tattempts, lost, err := store.ListDelegationAttempts()\n   873\t\tif err != nil {\n   874\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 1, err)\n   875\t\t}\n   876\t\tif len(f.positional) == 1 && !strings.HasPrefix(f.positional[0], \"rvb-\") {\n   877\t\t\tone, err := posemodel.ResolveDelegationRef(attempts, f.positional[0])\n   878\t\t\tif err != nil {\n   879\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, withDelegationLosses(refError(err), lost))\n   880\t\t\t}\n   881\t\t\t// A named run is refused when a selecting flag does not match it, as on\n   882\t\t\t// every other lifecycle command (D8); without a reference they filter.\n   883\t\t\tif flag := f.mismatch(one); flag != \"\" {\n   884\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, errors.New(tr(\"attempt \"+one.AttemptID+\" does not match \"+flag, \"a tentativa \"+one.AttemptID+\" não corresponde a \"+flag)))\n   885\t\t\t}\n   886\t\t\tattempts = []posemodel.DelegationAttempt{one}\n   887\t\t}\n   888\t\tselected := []posemodel.DelegationAttempt{}\n   889\t\tfor _, a := range attempts {\n   890\t\t\tif len(f.positional) == 1 && strings.HasPrefix(f.positional[0], \"rvb-\") && a.BundleID != f.positional[0] {\n   891\t\t\t\tcontinue\n   892\t\t\t}\n   893\t\t\tif f.active && !a.Active || f.mismatch(a) != \"\" {\n   894\t\t\t\tcontinue\n   895\t\t\t}\n   896\t\t\tselected = append(selected, a)\n   897\t\t}\n   898\t\tif lost == nil {\n   899\t\t\tlost = []string{}\n   900\t\t}\n   901\t\tif f.jsonOut {\n   902\t\t\t// R9: a stopped attempt carries the ways forward it has now.\n   903\t\t\ttype listed struct {\n   904\t\t\t\tposemodel.DelegationAttempt\n   905\t\t\t\tNextActions []delegateNextAction `json:\"next_actions,omitempty\"`\n   906\t\t\t}\n   907\t\t\trows := make([]listed, 0, len(selected))\n   908\t\t\tfor _, a := range selected {\n   909\t\t\t\trows = append(rows, listed{a, delegateNextActions(store, a)})\n   910\t\t\t}\n   911\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateListSchema, \"attempts\": rows, \"losses\": lost})\n   912\t\t} else {\n   913\t\t\tout := render(stdout, stderr)\n   914\t\t\tif len(selected) == 0 {\n   915\t\t\t\tout.Field(\"delegate.runs\", tr(\"none\", \"nenhum\"))\n   916\t\t\t}\n   917\t\t\tfor _, a := range selected {\n   918\t\t\t\tvalue := fmt.Sprintf(\"state=%s purpose=%s agent=%s turns=%d age=%s\", a.State, a.Purpose, a.Agent, a.Turns, delegateAge(a.StartedAt))\n   919\t\t\t\tif a.Round > 0 {\n   920\t\t\t\t\tvalue += fmt.Sprintf(\" round=%d\", a.Round)\n   921\t\t\t\t}\n   922\t\t\t\tif a.Label != \"\" {\n   923\t\t\t\t\tvalue += \" label=\" + a.Label\n   924\t\t\t\t}\n   925\t\t\t\tif a.Active && a.Liveness != \"\" {\n   926\t\t\t\t\tvalue += \" owner=\" + a.Liveness\n   927\t\t\t\t}\n   928\t\t\t\tif a.HeartbeatAge != \"\" {\n   929\t\t\t\t\tvalue += \" heartbeat=\" + a.HeartbeatAge\n   930\t\t\t\t}\n   931\t\t\t\tif a.StalledAt != \"\" {\n   932\t\t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n   933\t\t\t\t}\n   934\t\t\t\tif a.State == posemodel.DelegationStalled && a.Failure != \"\" {\n   935\t\t\t\t\tvalue += \" cause=\" + strconv.Quote(a.Failure)\n   936\t\t\t\t}\n   937\t\t\t\tif a.HookFailure != \"\" {\n   938\t\t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n   939\t\t\t\t}\n   940\t\t\t\tif a.Interruption != nil {\n   941\t\t\t\t\tvalue += fmt.Sprintf(\" cause=%s resumable=%t partial=%t\", a.Interruption.Cause, a.Interruption.Resumable, a.Partial)\n   942\t\t\t\t\tif a.Interruption.ResetAt != \"\" {\n   943\t\t\t\t\t\tvalue += \" reset_at=\" + a.Interruption.ResetAt + \" time_left=\" + a.TimeLeft\n   944\t\t\t\t\t}\n   945\t\t\t\t}\n   946\t\t\t\tif a.LatestRun != \"\" {\n   947\t\t\t\t\tvalue += \" run=\" + a.LatestRun\n   948\t\t\t\t}\n   949\t\t\t\tif a.LastStep != \"\" {\n   950\t\t\t\t\tvalue += \" last=\" + a.LastStep\n   951\t\t\t\t}\n   952\t\t\t\tout.Field(\"delegate.\"+a.AttemptID, value)\n   953\t\t\t}\n   954\t\t\tfor _, loss := range lost {\n   955\t\t\t\tout.Failure(tr(\"delegated run history incomplete: \", \"histórico de runs delegados incompleto: \") + loss)\n   956\t\t\t}\n   957\t\t}\n   958\t\tif len(lost) > 0 {\n   959\t\t\treturn 1\n   960\t\t}\n   961\t\treturn 0\n   962\t}\n   963\t\n   964\t// resumeTarget is the run a resume continues (R11 with the delivered\n   965\t// continuity): the run named by its id, or the attempt's latest run when it\n   966\t// is interrupted, or the interrupted run the latest one continued, whose\n   967\t// recorded continuation is then returned instead of a new run.\n   968\tfunc resumeTarget(attempt posemodel.DelegationAttempt, ref string) (string, error) {\n   969\t\tif containsString(attempt.Runs, ref) {\n   970\t\t\treturn ref, nil\n   971\t\t}\n   972\t\tlatest := attempt.Latest()\n   973\t\tswitch {\n   974\t\tcase latest == nil:\n   975\t\t\treturn \"\", errors.New(tr(\"attempt \"+attempt.AttemptID+\" has no recorded run\", \"a tentativa \"+attempt.AttemptID+\" não tem run registrado\"))\n   976\t\tcase latest.Status == posemodel.ReviewRunInterrupted:\n   977\t\t\treturn latest.RunID, nil\n   978\t\tcase latest.Resumes != \"\":\n   979\t\t\treturn latest.Resumes, nil\n   980\t\t}\n   981\t\treturn \"\", errors.New(tr(\"the latest run of attempt \"+attempt.AttemptID+\" is \"+latest.Status+\", not interrupted\",\n   982\t\t\t\"o run mais recente da tentativa \"+attempt.AttemptID+\" está \"+latest.Status+\", não interrompido\"))\n   983\t}\n   984\t\n   985\tfunc cmdDelegateResume(root string, args []string, stdout, stderr io.Writer) int {\n   986\t\tf, problem := parseDelegateFlags(args, \"--wait-until-reset\", \"--prompt\", \"--detach\")\n   987\t\tif problem != \"\" {\n   988\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate resume <run> [--wait-until-reset[=<max>]] [--prompt <file|->] [--detach] [--dry-run] [--json]\")\n   989\t\t}\n   990\t\t// A detached resume is this command run again in its own session (spec\n   991\t\t// pose-delegation-mcp R4); it hands its attempt back once it starts.\n   992\t\tif f.detach && !f.dryRun && !delegateSupervised() {\n   993\t\t\tif f.wait {\n   994\t\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", tr(\"--detach does not wait for a reset: resume after it, or without --detach\", \"--detach não espera um reset: retome depois dele, ou sem --detach\"))\n   995\t\t\t}\n   996\t\t\treturn detachDelegateRun(root, \"resume\", args, f, stdout, stderr)\n   997\t\t}\n   998\t\tstore := cliGovernedStore(root)\n   999\t\tattempts, _, err := store.ListDelegationAttempts()\n  1000\t\tif err != nil {\n  1001\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1002\t\t}\n  1003\t\tattempt, code, err := namedAttempt(attempts, f)\n  1004\t\tif err != nil {\n  1005\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", code, err)\n  1006\t\t}\n  1007\t\tif attempt.Active {\n  1008\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, errors.New(tr(\"attempt \"+attempt.AttemptID+\" is still running\", \"a tentativa \"+attempt.AttemptID+\" ainda está rodando\")))\n  1009\t\t}\n  1010\t\tref := attempt.AttemptID\n  1011\t\tif len(f.positional) == 1 {\n  1012\t\t\tref = f.positional[0]\n  1013\t\t}\n  1014\t\ttarget, err := resumeTarget(attempt, ref)\n  1015\t\tif err != nil {\n  1016\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1017\t\t}\n  1018\t\tif attempt.Purpose == posemodel.DelegationPurposeTask {\n  1019\t\t\treturn cmdDelegateTaskResume(root, store, f, attempt, target, stdout, stderr)\n  1020\t\t}\n  1021\t\tif f.promptFile != \"\" {\n  1022\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", tr(\"--prompt is for a task; a review is resumed with its own brief\", \"--prompt é para uma task; uma review é retomada com o próprio brief\"))\n  1023\t\t}\n  1024\t\tplan, err := store.PlanReviewResume(target)\n  1025\t\tif err != nil {\n  1026\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n  1027\t\t}\n  1028\t\tif pending := plan.PendingContinuation; pending != nil {\n  1029\t\t\t// A continuation already reserved is answered, as pose review resume\n  1030\t\t\t// answered it: pending, with its ids, and no second process (spec\n     1\tpackage pose\n     2\t\n     3\t// Listing and naming delegated runs (spec pose-delegation-surface R11, and the\n     4\t// listing pose-delegated-review-completion-signal extends).\n     5\t//\n     6\t// A person and an agent follow a task, not a process: an attempt and its\n     7\t// continuations are one row, shown by their latest run. A reference names a\n     8\t// row by attempt, by any of its runs, by label or by a prefix of its session.\n     9\t\n    10\timport (\n    11\t\t\"fmt\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t)\n    16\t\n    17\t// DelegationAttempt is one attempt and its continuations.\n    18\ttype DelegationAttempt struct {\n    19\t\tAttemptID    string              `json:\"attempt_id\"`\n    20\t\tRuns         []string            `json:\"runs\"`\n    21\t\tLatestRun    string              `json:\"latest_run,omitempty\"`\n    22\t\tState        string              `json:\"state\"`\n    23\t\tPurpose      string              `json:\"purpose\"`\n    24\t\tAgent        string              `json:\"agent\"`\n    25\t\tVendor       string              `json:\"vendor,omitempty\"`\n    26\t\tModel        string              `json:\"model,omitempty\"`\n    27\t\tLabel        string              `json:\"label,omitempty\"`\n    28\t\tLead         string              `json:\"lead,omitempty\"`\n    29\t\tAccess       string              `json:\"access\"`\n    30\t\tScope        string              `json:\"scope\"`\n    31\t\tBundleID     string              `json:\"bundle_id\"`\n    32\t\tStartedAt    string              `json:\"started_at\"`\n    33\t\tEndedAt      string              `json:\"ended_at,omitempty\"`\n    34\t\tTurns        int                 `json:\"turns\"`\n    35\t\tLastStep     string              `json:\"last_step,omitempty\"`\n    36\t\tFailure      string              `json:\"failure,omitempty\"`\n    37\t\tInterruption *ReviewInterruption `json:\"interruption,omitempty\"`\n    38\t\t// Partial says an interrupted run kept a partial draft; TimeLeft is the\n    39\t\t// wait until its recorded reset, when there is one.\n    40\t\tPartial         bool   `json:\"partial,omitempty\"`\n    41\t\tTimeLeft        string `json:\"time_left,omitempty\"`\n    42\t\tActive          bool   `json:\"active\"`\n    43\t\tLiveness        string `json:\"liveness,omitempty\"`\n    44\t\tCancelRequested bool   `json:\"cancel_requested,omitempty\"`\n    45\t\t// HeartbeatAge is how long ago the running process last beat; a stalled\n    46\t\t// run is not active (spec pose-delegated-review-completion-signal R4, R6).\n    47\t\tHeartbeatAge string `json:\"heartbeat_age,omitempty\"`\n    48\t\tStalledAt    string `json:\"stalled_at,omitempty\"`\n    49\t\t// HookFailure is why the latest run's on_terminal hook failed (R7).\n    50\t\tHookFailure string `json:\"hook_failure,omitempty\"`\n    51\t\t// Round is the review round of the scope the latest run reviewed (spec\n    52\t\t// pose-delegated-review-round-protocol R1).\n    53\t\tRound    int `json:\"round,omitempty\"`\n    54\t\tsessions []string\n    55\t\tlatest   *ReviewRun\n    56\t}\n    57\t\n    58\t// Latest is the latest recorded run of the attempt, if any.\n    59\tfunc (a DelegationAttempt) Latest() *ReviewRun { return a.latest }\n    60\t\n    61\t// DelegationRunning is the state of an attempt whose process is still there;\n    62\t// DelegationStalled, of one whose process is gone without a record.\n    63\tconst (\n    64\t\tDelegationRunning = \"running\"\n    65\t\tDelegationStalled = \"stalled\"\n    66\t\t// DelegationAbandonedCause is the failure of a stalled attempt whose\n    67\t\t// dispatch ended before recording its run.\n    68\t\tDelegationAbandonedCause = \"abandoned: the dispatching process ended before the run was recorded\"\n    69\t)\n    70\t\n    71\t// ListDelegationAttempts groups every recorded run by attempt, adds the runs\n    72\t// in progress, and returns the losses the run history reports.\n    73\tfunc (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n    74\t\t// The markers are read before the runs: a run publishes its record before\n    75\t\t// it removes its marker, so a reader that finds no marker for an attempt\n    76\t\t// it saw running finds its record (spec\n    77\t\t// pose-delegated-review-completion-signal R5).\n    78\t\tactive, activeLost, activeErr := s.ListDelegationActive()\n    79\t\truns, lost, err := s.ReadReviewRuns(\"\")\n    80\t\tif err != nil {\n    81\t\t\treturn nil, nil, err\n    82\t\t}\n    83\t\t// Task runs share the lifecycle, never the review history (spec\n    84\t\t// pose-delegation-task R7, R8).\n    85\t\ttasks, taskLost := s.ReadDelegationTaskRuns()\n    86\t\truns, lost = append(runs, tasks...), append(lost, taskLost...)\n    87\t\tbyAttempt := map[string]*DelegationAttempt{}\n    88\t\torder := []string{}\n    89\t\tfor i := range runs {\n    90\t\t\trun := runs[i]\n    91\t\t\tkey := run.AttemptID\n    92\t\t\tif key == \"\" {\n    93\t\t\t\tkey = run.RunID // a run recorded before attempts existed is its own attempt\n    94\t\t\t}\n    95\t\t\trow, ok := byAttempt[key]\n    96\t\t\tif !ok {\n    97\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    98\t\t\t\tbyAttempt[key] = row\n    99\t\t\t\torder = append(order, key)\n   100\t\t\t}\n   101\t\t\trow.Runs = append(row.Runs, run.RunID)\n   102\t\t\trow.latest = &runs[i]\n   103\t\t\tif run.SessionDigest != \"\" {\n   104\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   105\t\t\t\t\trow.sessions = append(row.sessions, value)\n   106\t\t\t\t}\n   107\t\t\t}\n   108\t\t\tevents, err := s.ReadDelegationEvents(run)\n   109\t\t\tif err != nil {\n   110\t\t\t\t// A turn count read from nothing would report a whole history.\n   111\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   112\t\t\t} else {\n   113\t\t\t\tfor _, e := range events {\n   114\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   115\t\t\t\t\t\trow.Turns++\n   116\t\t\t\t\t}\n   117\t\t\t\t}\n   118\t\t\t\tif len(events) > 0 {\n   119\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   120\t\t\t\t}\n   121\t\t\t}\n   122\t\t}\n   123\t\tfor _, key := range order {\n   124\t\t\trow := byAttempt[key]\n   125\t\t\tlatest := row.latest\n   126\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   127\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   128\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   129\t\t\tif latest.Access != \"\" {\n   130\t\t\t\trow.Access = latest.Access\n   131\t\t\t}\n   132\t\t\trow.Round = latest.Round\n   133\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   134\t\t\t\trow.HookFailure = hook.Failure\n   135\t\t\t}\n   136\t\t\tif row.Purpose == \"\" {\n   137\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   138\t\t\t}\n   139\t\t\tif latest.Status == ReviewRunInterrupted {\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n   206\t\tfor _, key := range order {\n   207\t\t\tout = append(out, *byAttempt[key])\n   208\t\t}\n   209\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   210\t\treturn out, lost, nil\n   211\t}\n   212\t\n   213\tfunc delegationStepText(e DelegationEvent) string {\n   214\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   215\t\tif len(text) > 80 {\n   216\t\t\tcut := 77\n   217\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   218\t\t\t\tcut--\n   219\t\t\t}\n   220\t\t\ttext = text[:cut] + \"...\"\n   221\t\t}\n   222\t\tswitch e.Kind {\n   223\t\tcase DelegationEventToolCall:\n   224\t\t\treturn \"▶ \" + text\n   225\t\tcase DelegationEventToolOutput:\n   226\t\t\tif e.ExitCode != nil && *e.ExitCode != 0 {\n   227\t\t\t\treturn fmt.Sprintf(\"✗ exit %d\", *e.ExitCode)\n   228\t\t\t}\n   229\t\t\treturn \"✓ exit 0\"\n   230\t\tcase DelegationEventTurn:\n","exit_code":0,"status":"completed"}}
