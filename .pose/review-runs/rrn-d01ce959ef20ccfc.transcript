{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_shim_linux.go | sed -n '1,330p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"os/signal\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"golang.org/x/sys/unix\"\n    18\t)\n    19\t\n    20\t// RunReviewShim runs args (the adapter's path, then its argv) as the shim's\n    21\t// only child, waits for it or for SIGTERM, ends every process left in the\n    22\t// shim's subtree and returns the adapter's exit status.\n    23\tfunc RunReviewShim(args []string) int {\n    24\t\treport := reviewShimReport{}\n    25\t\tvar reportFile *os.File\n    26\t\tparent := 0\n    27\t\tif value := os.Getenv(ReviewShimReportEnv); value != \"\" {\n    28\t\t\tparent, _ = strconv.Atoi(value)\n    29\t\t\t// The report pipe is the shim's alone: the adapter never inherits it.\n    30\t\t\tsyscall.CloseOnExec(3)\n    31\t\t\treportFile = os.NewFile(3, \"pose-review-shim-report\")\n    32\t\t}\n    33\t\t_ = os.Unsetenv(ReviewShimReportEnv)\n    34\t\twrite := func() {\n    35\t\t\tif reportFile == nil {\n    36\t\t\t\treturn\n    37\t\t\t}\n    38\t\t\traw := boundedReviewShimReport(report)\n    39\t\t\t_, _ = reportFile.Write(raw)\n    40\t\t\t_ = reportFile.Close()\n    41\t\t}\n    42\t\tif len(args) < 2 {\n    43\t\t\treport.Error = \"the review shim was given no adapter\"\n    44\t\t\twrite()\n    45\t\t\treturn 125\n    46\t\t}\n    47\t\tstop := make(chan os.Signal, 1)\n    48\t\tsignal.Notify(stop, syscall.SIGTERM)\n    49\t\t// The dispatcher's death stops the shim the same way as a timeout.\n    50\t\tif err := unix.Prctl(unix.PR_SET_PDEATHSIG, uintptr(syscall.SIGTERM), 0, 0, 0); err != nil {\n    51\t\t\treport.Error = \"the shim could not follow its dispatcher: \" + err.Error()\n    52\t\t\twrite()\n    53\t\t\treturn 125\n    54\t\t}\n    55\t\tif parent != 0 && os.Getppid() != parent {\n    56\t\t\treport.Error = \"the dispatcher ended before the shim started\"\n    57\t\t\twrite()\n    58\t\t\treturn 125\n    59\t\t}\n    60\t\tif err := unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0); err != nil {\n    61\t\t\treport.Error = \"the shim could not become the subreaper of the run: \" + err.Error()\n    62\t\t\twrite()\n    63\t\t\treturn 125\n    64\t\t}\n    65\t\tcmd := &exec.Cmd{Path: args[0], Args: args[1:], Stdin: os.Stdin, Stdout: os.Stdout, Stderr: os.Stderr, Env: os.Environ()}\n    66\t\tif err := cmd.Start(); err != nil {\n    67\t\t\treport.Error = \"the adapter could not run: \" + err.Error()\n    68\t\t\twrite()\n    69\t\t\treturn 127\n    70\t\t}\n    71\t\tdone := make(chan error, 1)\n    72\t\tgo func() { done <- cmd.Wait() }()\n    73\t\tcode, stopped := 0, false\n    74\t\tvar signaled syscall.Signal\n    75\t\tselect {\n    76\t\tcase err := <-done:\n    77\t\t\tvar exit *exec.ExitError\n    78\t\t\tif errors.As(err, &exit) {\n    79\t\t\t\tif status, ok := exit.Sys().(syscall.WaitStatus); ok && status.Signaled() {\n    80\t\t\t\t\tsignaled, code = status.Signal(), 128+int(status.Signal())\n    81\t\t\t\t} else {\n    82\t\t\t\t\tcode = exit.ExitCode()\n    83\t\t\t\t}\n    84\t\t\t} else if err != nil {\n    85\t\t\t\treport.Error = \"the adapter's end could not be read: \" + err.Error()\n    86\t\t\t}\n    87\t\tcase <-stop:\n    88\t\t\tstopped, code = true, 128+int(syscall.SIGTERM)\n    89\t\t}\n    90\t\tended, err := reapShimSubtree()\n    91\t\treport.Ended = ended\n    92\t\tif err != nil && report.Error == \"\" {\n    93\t\t\treport.Error = err.Error()\n    94\t\t}\n    95\t\twrite()\n    96\t\tif stopped {\n    97\t\t\treturn code\n    98\t\t}\n    99\t\t// An adapter ended by a signal is reported as ended by it: the shim ends\n   100\t\t// itself the same way, so the dispatcher reads what it would have read\n   101\t\t// without the shim.\n   102\t\tif signaled != 0 {\n   103\t\t\tsignal.Reset(signaled)\n   104\t\t\t_ = syscall.Kill(os.Getpid(), signaled)\n   105\t\t\ttime.Sleep(time.Second)\n   106\t\t}\n   107\t\treturn code\n   108\t}\n   109\t\n   110\t// stopReviewShim asks a running shim to end its subtree and exit.\n   111\tfunc stopReviewShim(cmd *exec.Cmd) func() error {\n   112\t\treturn func() error { return cmd.Process.Signal(syscall.SIGTERM) }\n   113\t}\n   114\t\n   115\t// reapShimSubtree ends and reaps every child of the shim, including the\n   116\t// orphans its subreaper status adopted, until none is left.\n   117\tfunc reapShimSubtree() ([]string, error) {\n   118\t\tself := os.Getpid()\n   119\t\tvar ended []string\n   120\t\tseen := map[int]bool{}\n   121\t\tdeadline := time.Now().Add(reviewReapWait)\n   122\t\t// A process that cannot be inspected or ended is not a reason to stop:\n   123\t\t// the others are still ended, and the problem is reported at the end\n   124\t\t// (review round 9, N3).\n   125\t\tvar problems []string\n   126\t\tnote := func(err error) {\n   127\t\t\tif len(problems) < 8 {\n   128\t\t\t\tproblems = append(problems, err.Error())\n   129\t\t\t}\n   130\t\t}\n   131\t\tfor {\n   132\t\t\tchildren := 0\n   133\t\t\tproblems = problems[:0]\n   134\t\t\t// /proc is read in batches under the deadline, never materialized\n   135\t\t\t// whole (review round 13, N3).\n   136\t\t\tdirs, err := readProcBatched(deadline)\n   137\t\t\tif err != nil {\n   138\t\t\t\tnote(err)\n   139\t\t\t}\n   140\t\t\tfor _, d := range dirs {\n   141\t\t\t\t// The bound holds per process, not only per listing (review round\n   142\t\t\t\t// 14, N4).\n   143\t\t\t\tif time.Now().After(deadline) {\n   144\t\t\t\t\tchildren++\n   145\t\t\t\t\tnote(fmt.Errorf(\"the run's processes could not be scanned within the bound\"))\n   146\t\t\t\t\tbreak\n   147\t\t\t\t}\n   148\t\t\t\tpid, err := strconv.Atoi(d.Name())\n   149\t\t\t\tif err != nil || pid == self {\n   150\t\t\t\t\tcontinue\n   151\t\t\t\t}\n   152\t\t\t\tst, err := readShimProcStat(pid)\n   153\t\t\t\tif reviewProcessGoneErr(err) {\n   154\t\t\t\t\tcontinue\n   155\t\t\t\t}\n   156\t\t\t\tif err != nil {\n   157\t\t\t\t\t// A process of another user is never the run's: with procfs\n   158\t\t\t\t\t// mounted hidepid it is visible and unreadable (review round 10,\n   159\t\t\t\t\t// N1). Only one of this user is an unknown that may be the run's.\n   160\t\t\t\t\tif owner, oerr := reviewProcessOwner(pid); reviewProcessGoneErr(oerr) || oerr == nil && owner != os.Getuid() {\n   161\t\t\t\t\t\tcontinue\n   162\t\t\t\t\t}\n   163\t\t\t\t\tchildren++\n   164\t\t\t\t\tnote(fmt.Errorf(\"process %d could not be inspected: %w\", pid, err))\n   165\t\t\t\t\tcontinue\n   166\t\t\t\t}\n   167\t\t\t\tif st.ppid != self {\n   168\t\t\t\t\tcontinue\n   169\t\t\t\t}\n   170\t\t\t\tchildren++\n   171\t\t\t\tif !st.zombie {\n   172\t\t\t\t\t// A pid is reported ended only once its signal was delivered\n   173\t\t\t\t\t// (review round 10, N3).\n   174\t\t\t\t\tif delivered, err := killPinnedChild(pid, self); err != nil {\n   175\t\t\t\t\t\tnote(err)\n   176\t\t\t\t\t} else if delivered {\n   177\t\t\t\t\t\tseen[pid] = true\n   178\t\t\t\t\t}\n   179\t\t\t\t}\n   180\t\t\t}\n   181\t\t\tfor {\n   182\t\t\t\tpid, err := unix.Wait4(-1, nil, unix.WNOHANG, nil)\n   183\t\t\t\tif pid <= 0 || err != nil {\n   184\t\t\t\t\tbreak\n   185\t\t\t\t}\n   186\t\t\t\t// A pid is reported ended once it was signalled and reaped\n   187\t\t\t\t// (review round 12, N2).\n   188\t\t\t\tif seen[pid] {\n   189\t\t\t\t\tdelete(seen, pid)\n   190\t\t\t\t\tended = append(ended, strconv.Itoa(pid))\n   191\t\t\t\t}\n   192\t\t\t}\n   193\t\t\tif children == 0 && len(problems) == 0 {\n   194\t\t\t\treturn ended, nil\n   195\t\t\t}\n   196\t\t\tif time.Now().After(deadline) {\n   197\t\t\t\treturn ended, fmt.Errorf(\"%d process(es) of the run could not be ended: %s\", children, strings.Join(problems, \"; \"))\n   198\t\t\t}\n   199\t\t\ttime.Sleep(20 * time.Millisecond)\n   200\t\t}\n   201\t}\n   202\t\n   203\ttype shimProcStat struct {\n   204\t\tppid   int\n   205\t\tzombie bool\n   206\t}\n   207\t\n   208\tfunc readShimProcStat(pid int) (shimProcStat, error) {\n   209\t\traw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n   210\t\tif err != nil {\n   211\t\t\treturn shimProcStat{}, err\n   212\t\t}\n   213\t\ttext := string(raw)\n   214\t\tend := strings.LastIndexByte(text, ')')\n   215\t\tif end < 0 {\n   216\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   217\t\t}\n   218\t\tf := strings.Fields(text[end+1:])\n   219\t\tif len(f) < 2 {\n   220\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   221\t\t}\n   222\t\tppid, err := strconv.Atoi(f[1])\n   223\t\tif err != nil {\n   224\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   225\t\t}\n   226\t\treturn shimProcStat{ppid: ppid, zombie: f[0] == \"Z\"}, nil\n   227\t}\n   228\t\n   229\t// killPinnedChild signals pid through a pidfd while it is still a child of\n   230\t// parent: a pid reused by an unrelated process is never signalled. It says\n   231\t// whether the signal reached the process; one that already ended was not\n   232\t// ended by the shim and is not reported (review round 11, N2).\n   233\tfunc killPinnedChild(pid, parent int) (bool, error) {\n   234\t\tfd, err := unix.PidfdOpen(pid, 0)\n   235\t\tif errors.Is(err, unix.ESRCH) {\n   236\t\t\treturn false, nil\n   237\t\t}\n   238\t\tif err != nil {\n   239\t\t\treturn false, fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   240\t\t}\n   241\t\tdefer unix.Close(fd)\n   242\t\tst, err := readShimProcStat(pid)\n   243\t\tif reviewProcessGoneErr(err) || err == nil && (st.ppid != parent || st.zombie) {\n   244\t\t\treturn false, nil\n   245\t\t}\n   246\t\tif err != nil {\n   247\t\t\treturn false, fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   248\t\t}\n   249\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil {\n   250\t\t\tif errors.Is(err, unix.ESRCH) {\n   251\t\t\t\treturn false, nil\n   252\t\t\t}\n   253\t\t\treturn false, fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   254\t\t}\n   255\t\treturn true, nil\n   256\t}\n   257\t\n   258\t// parseReviewShimReport reads the report the shim wrote to its pipe.\n   259\tfunc parseReviewShimReport(raw []byte) (reviewShimReport, error) {\n   260\t\tvar r reviewShimReport\n   261\t\tif len(raw) == 0 {\n   262\t\t\treturn r, fmt.Errorf(\"the review shim left no report\")\n   263\t\t}\n   264\t\tif err := json.Unmarshal(raw, &r); err != nil {\n   265\t\t\treturn r, fmt.Errorf(\"the review shim report is unreadable: %w\", err)\n   266\t\t}\n   267\t\treturn r, nil\n   268\t}\n   269\t\n   270\t// readProcBatched lists the numeric entries of /proc in batches, and stops\n   271\t// with an error once deadline passes.\n   272\tfunc readProcBatched(deadline time.Time) ([]os.DirEntry, error) {\n   273\t\tf, err := os.Open(\"/proc\")\n   274\t\tif err != nil {\n   275\t\t\treturn nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n   276\t\t}\n   277\t\tdefer f.Close()\n   278\t\tvar out []os.DirEntry\n   279\t\tfor {\n   280\t\t\tbatch, err := f.ReadDir(512)\n   281\t\t\tfor _, d := range batch {\n   282\t\t\t\tif d.Name()[0] >= '0' && d.Name()[0] <= '9' {\n   283\t\t\t\t\tout = append(out, d)\n   284\t\t\t\t}\n   285\t\t\t}\n   286\t\t\tif err != nil || len(batch) == 0 {\n   287\t\t\t\treturn out, nil\n   288\t\t\t}\n   289\t\t\tif time.Now().After(deadline) {\n   290\t\t\t\treturn out, fmt.Errorf(\"the run's processes could not be listed within the bound\")\n   291\t\t\t}\n   292\t\t}\n   293\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '930,1205p;1540,1710p'\"","aggregated_output":"   930\t\toutputFile := filepath.Join(tmp, \"output.txt\")\n   931\t\tcommand := plan.Config.Command\n   932\t\tif plan.predecessor != nil && !plan.handoff || plan.thread.continued() {\n   933\t\t\tcommand = plan.Config.Resume.Command\n   934\t\t}\n   935\t\targv := ReviewerArgv(command, outputFile, plan.session, plan.Effort, plan.Config.Effort)\n   936\t\ttimeout := time.Duration(safety.TimeoutMS) * time.Millisecond\n   937\t\texecPath := argv[0]\n   938\t\tif run.Provenance != nil {\n   939\t\t\tcopy := *run.Provenance\n   940\t\t\trun.Provenance = &copy\n   941\t\t\tselected, resolved, err := provenanceExecutableSelection(argv[0], worktree)\n   942\t\t\tif err != nil {\n   943\t\t\t\treturn finish(ReviewRunFailed, \"provenance executable could not be resolved\")\n   944\t\t\t}\n   945\t\t\tdigest, err := reviewExecutableDigest(resolved)\n   946\t\t\tif err != nil {\n   947\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n   948\t\t\t}\n   949\t\t\trun.Provenance.ExecutableDigest = digest\n   950\t\t\texecPath = selected\n   951\t\t\traw, _ := json.Marshal(argv)\n   952\t\t\trun.Provenance.ArgvDigest = digestBytes(raw)\n   953\t\t}\n   954\t\tif plan.processTimeout > 0 {\n   955\t\t\tstarted, err := time.Parse(time.RFC3339Nano, run.StartedAt)\n   956\t\t\tif err != nil {\n   957\t\t\t\treturn finish(ReviewRunFailed, \"invalid execution start\")\n   958\t\t\t}\n   959\t\t\tsetup := now().Sub(started)\n   960\t\t\tremaining := plan.processTimeout - setup\n   961\t\t\tif setup < 0 || remaining <= 0 {\n   962\t\t\t\treturn finish(ReviewRunFailed, \"accumulated wall-clock budget spent before adapter launch\")\n   963\t\t\t}\n   964\t\t\tif remaining < timeout {\n   965\t\t\t\ttimeout = remaining\n   966\t\t\t}\n   967\t\t}\n   968\t\tctx, cancel := context.WithTimeout(parent, timeout)\n   969\t\tdefer cancel()\n   970\t\tcmd := exec.CommandContext(ctx, execPath, argv[1:]...)\n   971\t\tcmd.Args[0] = argv[0]\n   972\t\t// The adapter runs under the review run shim, which ends what the run\n   973\t\t// leaves in its subtree (review_shim.go).\n   974\t\tuseShim := false\n   975\t\tvar shimRead, shimWrite *os.File\n   976\t\tif ReviewShimAvailable && runtime.GOOS == \"linux\" && cmd.Err == nil {\n   977\t\t\t// The adapter's path as resolved here, in the dispatcher's PATH. A\n   978\t\t\t// shim that cannot be set up fails the run: it never falls back to\n   979\t\t\t// the weaker environment search (review round 11, N1).\n   980\t\t\tself, err := os.Executable()\n   981\t\t\tif err != nil {\n   982\t\t\t\treturn finish(ReviewRunFailed, \"the review run shim could not be set up: \"+err.Error())\n   983\t\t\t}\n   984\t\t\tr, w, err := os.Pipe()\n   985\t\t\tif err != nil {\n   986\t\t\t\treturn finish(ReviewRunFailed, \"the review run shim could not be set up: \"+err.Error())\n   987\t\t\t}\n   988\t\t\tuseShim, shimRead, shimWrite = true, r, w\n   989\t\t\tcmd = exec.CommandContext(ctx, self, append([]string{ReviewShimArg, cmd.Path}, argv...)...)\n   990\t\t\tcmd.ExtraFiles = []*os.File{w}\n   991\t\t}\n   992\t\tcmd.Dir = worktree\n   993\t\tcmd.Stdin = strings.NewReader(plan.Brief.Text)\n   994\t\tenv, secrets, err := reviewAdapterEnvironment(plan.Config, tmp, plan.Brief.Text, plan.notes)\n   995\t\tif err != nil {\n   996\t\t\trun.BriefNotes = \"\"\n   997\t\t\treturn finish(ReviewRunFailed, err.Error())\n   998\t\t}\n   999\t\tunset := []string{}\n  1000\t\tif policy, _, found, perr := s.LoadDelegationPolicy(); perr == nil && found {\n  1001\t\t\tunset = policy.EnvUnset\n  1002\t\t}\n  1003\t\tenv, run.EnvRemoved = withoutParentSession(env, unset)\n  1004\t\t// The reviewer works in a sealed checkout: diagnostics it runs must not\n  1005\t\t// publish derived records into it (SealedCheckoutEnv).\n  1006\t\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n  1007\t\tif useShim {\n  1008\t\t\tenv = append(env, ReviewShimReportEnv+\"=\"+fmt.Sprint(os.Getpid()))\n  1009\t\t}\n  1010\t\t// The reviewer checks its draft against the sealed bundle and the round\n  1011\t\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n  1012\t\t// context that cannot be built leaves the check unavailable, never the\n  1013\t\t// review.\n  1014\t\tif plan.Purpose == DelegationPurposeReview {\n  1015\t\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n  1016\t\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n  1017\t\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n  1018\t\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n  1019\t\t\t\t\t// engine that dispatched the run is the one that checks it.\n  1020\t\t\t\t\tif self, err := os.Executable(); err == nil {\n  1021\t\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n  1022\t\t\t\t\t}\n  1023\t\t\t\t}\n  1024\t\t\t}\n  1025\t\t}\n  1026\t\tcmd.Env = env\n  1027\t\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n  1028\t\tcmd.Stdout, cmd.Stderr = combined, combined\n  1029\t\t// pose delegate watch follows the normalized, redacted events as they come\n  1030\t\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n  1031\t\t// the record is published.\n  1032\t\tsessionPattern := \"\"\n  1033\t\tif plan.Config.Session != nil {\n  1034\t\t\tsessionPattern = plan.Config.Session.Pattern\n  1035\t\t}\n  1036\t\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n  1037\t\t\ttee := io.MultiWriter(combined, live)\n  1038\t\t\tcmd.Stdout, cmd.Stderr = tee, tee\n  1039\t\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n  1040\t\t\tdefer live.Close()\n  1041\t\t}\n  1042\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n  1043\t\t// only the parent left a child holding stdout, so the timeout never fired\n  1044\t\t// (found in review). The run gets its own process group, the whole group\n  1045\t\t// is killed on timeout and after the run, and pipes are released at most\n  1046\t\t// a few seconds after the kill.\n  1047\t\topaqueBaseline := reviewOpaqueProcessBaseline()\n  1048\t\t// Orphans of the run are reparented to this process, so one that left\n  1049\t\t// the group and cleared its environment is still found (review round 6, N2).\n  1050\t\tisolateProcessGroup(cmd)\n  1051\t\tcmd.WaitDelay = AdapterPipeGrace\n  1052\t\tvar shimReport []byte\n  1053\t\tshimReportDone := make(chan struct{})\n  1054\t\tif useShim {\n  1055\t\t\t// A timeout asks the shim to end the run's subtree first; the group\n  1056\t\t\t// kill after Wait remains the backstop (review round 8, N3).\n  1057\t\t\tcmd.Cancel = stopReviewShim(cmd)\n  1058\t\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n  1059\t\t\tgo func() {\n  1060\t\t\t\tdefer close(shimReportDone)\n  1061\t\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n  1062\t\t\t\t// Whatever exceeds the bound is drained, so the shim never blocks.\n  1063\t\t\t\t_, _ = io.Copy(io.Discard, shimRead)\n  1064\t\t\t}()\n  1065\t\t} else {\n  1066\t\t\tclose(shimReportDone)\n  1067\t\t}\n  1068\t\tvar runErr error\n  1069\t\tprepareReviewProcessTree(cmd)\n  1070\t\tif run.Provenance == nil {\n  1071\t\t\tif runErr = cmd.Start(); runErr == nil {\n  1072\t\t\t\tif runErr = attachReviewProcessTree(cmd); runErr == nil {\n  1073\t\t\t\t\trunErr = cmd.Wait()\n  1074\t\t\t\t} else {\n  1075\t\t\t\t\t_ = cmd.Wait()\n  1076\t\t\t\t}\n  1077\t\t\t}\n  1078\t\t} else {\n  1079\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1080\t\t\trunErr = err\n  1081\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1082\t\t\tif started {\n  1083\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1084\t\t\t}\n  1085\t\t}\n  1086\t\tif useShim && safety != nil {\n  1087\t\t\t// With the shim the run's leftovers are its subtree, not an\n  1088\t\t\t// environment match (review round 9, N1).\n  1089\t\t\tfor i, limit := range safety.Limitations {\n  1090\t\t\t\tif strings.HasPrefix(limit, \"no memory/CPU quota;\") {\n  1091\t\t\t\t\tsafety.Limitations[i] = \"no memory/CPU quota; the review run shim ends every process left in the run's subtree, including one in its own session\"\n  1092\t\t\t\t}\n  1093\t\t\t}\n  1094\t\t}\n  1095\t\tif useShim {\n  1096\t\t\t_ = shimWrite.Close()\n  1097\t\t\t<-shimReportDone\n  1098\t\t\t_ = shimRead.Close()\n  1099\t\t}\n  1100\t\tterminationErr = errors.Join(killProcessGroup(cmd), releaseReviewProcessTree(cmd))\n  1101\t\t// A command the reviewer left running in a session of its own escapes the\n  1102\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1103\t\t// directories it may still write (spec\n  1104\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1105\t\t// The environment entry is the reviewer's to set, so it is searched only\n  1106\t\t// without the shim, whose subtree is the run's by construction (review\n  1107\t\t// round 8, N1).\n  1108\t\tvar reaped []string\n  1109\t\tshimMore := 0\n  1110\t\tvar opaque int\n  1111\t\tvar reapErr error\n  1112\t\tif !useShim {\n  1113\t\t\treaped, opaque, reapErr = reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n  1114\t\t\tif reapErr != nil {\n  1115\t\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1116\t\t\t}\n  1117\t\t}\n  1118\t\tif useShim && cmd.ProcessState != nil {\n  1119\t\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n  1120\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1121\t\t\t} else {\n  1122\t\t\t\tfor _, pid := range report.Ended {\n  1123\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1124\t\t\t\t}\n  1125\t\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n  1126\t\t\t\t\t// Counted from the total, not from the listed pids (review\n  1127\t\t\t\t\t// round 12, N3).\n  1128\t\t\t\t\tshimMore = more\n  1129\t\t\t\t}\n  1130\t\t\t\tif report.Error != \"\" {\n  1131\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1132\t\t\t\t\t// The shim's own words go into the record, not only the\n  1133\t\t\t\t\t// generic failure (review round 10, N3).\n  1134\t\t\t\t\tif safety != nil {\n  1135\t\t\t\t\t\tsafety.Limitations = append(safety.Limitations, \"the review run shim could not end the whole subtree: \"+report.Error)\n  1136\t\t\t\t\t}\n  1137\t\t\t\t}\n  1138\t\t\t}\n  1139\t\t}\n  1140\t\tif endedCount := len(reaped) + shimMore; endedCount > 0 && safety != nil {\n  1141\t\t\tlisted := strings.Join(reaped, \", \")\n  1142\t\t\tif shimMore > 0 {\n  1143\t\t\t\tlisted += fmt.Sprintf(\" and %d more (orphaned)\", shimMore)\n  1144\t\t\t}\n  1145\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(endedCount)+\" process(es) the run left running: \"+listed)\n  1146\t\t}\n  1147\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1148\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1149\t\t}\n  1150\t\tterminationFailed = terminationErr != nil\n  1151\t\t// The adapter exited and a child it left still held the output when\n  1152\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1153\t\t// the exit status decides (found in review).\n  1154\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1155\t\t\trunErr = nil\n  1156\t\t}\n  1157\t\ttranscript, overflow := combined.result()\n  1158\t\tsafety.CaptureComplete = !overflow\n  1159\t\tif cmd.ProcessState != nil {\n  1160\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1161\t\t}\n  1162\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n  1163\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n  1164\t\t\tsafety.CaptureComplete = false\n  1165\t\t}\n  1166\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1167\t\t\trun.Output = string(raw)\n  1168\t\t\tif run.Provenance != nil {\n  1169\t\t\t\trun.Provenance.OutputComplete = true\n  1170\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1171\t\t\t}\n  1172\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1173\t\t\t// The agent writes no output file; its stream names its final message.\n  1174\t\t\trun.Output = final\n  1175\t\t\tif run.Provenance != nil {\n  1176\t\t\t\trun.Provenance.OutputComplete = true\n  1177\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1178\t\t\t}\n  1179\t\t} else {\n  1180\t\t\trun.Output = tail(string(transcript), 20000)\n  1181\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1182\t\t\t\tsafety.CaptureComplete = false\n  1183\t\t\t}\n  1184\t\t\tif run.Provenance != nil {\n  1185\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1186\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1187\t\t\t}\n  1188\t\t}\n  1189\t\tif run.Provenance != nil {\n  1190\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n  1191\t\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n  1192\t\t}\n  1193\t\tif runErr != nil && cmd.ProcessState == nil {\n  1194\t\t\trun.Output, transcript = \"\", nil\n  1195\t\t\tif run.Provenance != nil {\n  1196\t\t\t\trun.Provenance.OutputComplete = false\n  1197\t\t\t}\n  1198\t\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n  1199\t\t}\n  1200\t\t// Raw provenance hashes above precede redaction; only complete, bounded\n  1201\t\t// redacted channels can be retained. Partial boundaries can expose a secret.\n  1202\t\tsafety.ExecutionCause = executionCause(ctx)\n  1203\t\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n  1204\t\t\tsafety.CaptureComplete = false\n  1205\t\t}\n  1540\t\tif normalize {\n  1541\t\t\traw = bytes.ReplaceAll(raw, []byte(\"\\r\\n\"), []byte(\"\\n\"))\n  1542\t\t}\n  1543\t\tif digest == \"\" || digestBytes(raw) != digest {\n  1544\t\t\treturn fmt.Errorf(\"dispatch input conflict: sealed bytes changed for %q\", path)\n  1545\t\t}\n  1546\t\treturn nil\n  1547\t}\n  1548\t\n  1549\tfunc dispatchRegularInputPath(root, path string) (string, error) {\n  1550\t\tfull, err := dispatchInputPath(root, path)\n  1551\t\tif err != nil {\n  1552\t\t\treturn \"\", err\n  1553\t\t}\n  1554\t\tinfo, err := os.Lstat(full)\n  1555\t\tif err != nil {\n  1556\t\t\treturn \"\", &GitSnapshotError{\"input \" + path, err}\n  1557\t\t}\n  1558\t\tif !info.Mode().IsRegular() {\n  1559\t\t\treturn \"\", fmt.Errorf(\"dispatch input conflict: %q is not a regular file\", path)\n  1560\t\t}\n  1561\t\treturn full, nil\n  1562\t}\n  1563\t\n  1564\t// ReviewerArgv expands a command template: \"{effort}\" becomes the argv\n  1565\t// fragment of the effort level (the agent's default when level is \"\"), and\n  1566\t// \"{output}\" and \"{session}\" become their values. Schema 2 templates hold\n  1567\t// placeholders only as whole elements; schema 1 templates keep their\n  1568\t// in-element replacement.\n  1569\tfunc ReviewerArgv(command []string, output, session, level string, effort *ReviewerEffort) []string {\n  1570\t\targv := make([]string, 0, len(command))\n  1571\t\tfor _, arg := range command {\n  1572\t\t\tif arg == \"{effort}\" {\n  1573\t\t\t\tif effort != nil {\n  1574\t\t\t\t\tif level == \"\" {\n  1575\t\t\t\t\t\tlevel = effort.Default\n  1576\t\t\t\t\t}\n  1577\t\t\t\t\targv = append(argv, effort.Levels[level]...)\n  1578\t\t\t\t}\n  1579\t\t\t\tcontinue\n  1580\t\t\t}\n  1581\t\t\targv = append(argv, strings.ReplaceAll(strings.ReplaceAll(arg, \"{output}\", output), \"{session}\", session))\n  1582\t\t}\n  1583\t\treturn argv\n  1584\t}\n  1585\t\n  1586\tfunc tail(s string, n int) string {\n  1587\t\tif len(s) <= n {\n  1588\t\t\treturn s\n  1589\t\t}\n  1590\t\treturn s[len(s)-n:]\n  1591\t}\n  1592\t\n  1593\t// afterRunWitnessPublished runs between a run's witness and its record;\n  1594\t// tests use it to stop a recording there.\n  1595\tvar afterRunWitnessPublished = func(ReviewRun) error { return nil }\n  1596\t\n  1597\t// beforeAttemptPublished runs between the active marker and the reservation;\n  1598\t// tests use it to stop a dispatch there.\n  1599\tvar beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {}\n  1600\t\n  1601\t// identifiedReviewRun is run as recordReviewRun persists it, with its\n  1602\t// content identity: the same content always yields the same run id.\n  1603\tfunc identifiedReviewRun(run ReviewRun, transcript []byte) (ReviewRun, []byte) {\n  1604\t\t// Identity covers only persisted content, never fields derived by a reader\n  1605\t\t// or a previous write of a copied record.\n  1606\t\trun.RunID, run.Path, run.TranscriptPath, run.SupersededBy = \"\", \"\", \"\", \"\"\n  1607\t\trun.LedgerVersion = 1\n  1608\t\tsum := sha256.Sum256(transcript)\n  1609\t\trun.TranscriptDigest = \"sha256:\" + hex.EncodeToString(sum[:])\n  1610\t\tvar events []byte\n  1611\t\trun.EventsDigest = \"\"\n  1612\t\tif run.Events != \"\" {\n  1613\t\t\tevents = run.eventsBytes\n  1614\t\t\trun.EventsDigest = digestBytes(events)\n  1615\t\t}\n  1616\t\trun.eventsBytes = nil // never part of the record or of a copy compared with it\n  1617\t\tidentity, _ := json.Marshal(run)\n  1618\t\tidSum := sha256.Sum256(identity)\n  1619\t\trun.RunID = \"rrn-\" + hex.EncodeToString(idSum[:])[:16]\n  1620\t\treturn run, events\n  1621\t}\n  1622\t\n  1623\tfunc (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\n  1624\t\trun, events := identifiedReviewRun(run, transcript)\n  1625\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, reviewRunsDir, true)\n  1626\t\tif err != nil {\n  1627\t\t\treturn ReviewRun{}, err\n  1628\t\t}\n  1629\t\trun.TranscriptPath = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\"))\n  1630\t\tpretty, err := json.MarshalIndent(run, \"\", \"  \")\n  1631\t\tif err != nil {\n  1632\t\t\treturn ReviewRun{}, err\n  1633\t\t}\n  1634\t\tpretty = append(pretty, '\\n')\n  1635\t\tif len(pretty) > reviewLedgerMaxBytes {\n  1636\t\t\treturn ReviewRun{}, fmt.Errorf(\"review run record exceeds %d-byte bound; nothing published\", reviewLedgerMaxBytes)\n  1637\t\t}\n  1638\t\tif len(transcript) > reviewTranscriptMaxBytes {\n  1639\t\t\treturn ReviewRun{}, fmt.Errorf(\"review transcript exceeds %d-byte bound; nothing published\", reviewTranscriptMaxBytes)\n  1640\t\t}\n  1641\t\n  1642\t\twitness := reviewRunWitness{SchemaVersion: 1, RunID: run.RunID, BundleID: run.BundleID, Scope: run.Scope, RecordDigest: digestBytes(pretty), TranscriptDigest: run.TranscriptDigest}\n  1643\t\t// A publication of identical bytes is accepted, so a recording interrupted\n  1644\t\t// after the witness completes when the same content is recorded again\n  1645\t\t// (spec pose-review-run-reaps-lingering-reviewer-processes, review round\n  1646\t\t// 14, N5).\n  1647\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(filepath.Join(reviewRunLedgerDir, run.RunID+\".json\")), witness); err != nil {\n  1648\t\t\treturn ReviewRun{}, err\n  1649\t\t}\n  1650\t\tif err := afterRunWitnessPublished(run); err != nil {\n  1651\t\t\treturn ReviewRun{}, err\n  1652\t\t}\n  1653\t\tif run.Safety != nil && int64(len(pretty)+len(transcript)+len(events)) > run.Safety.RetainedBytes {\n  1654\t\t\treturn ReviewRun{}, fmt.Errorf(\"retained run exceeds containment byte budget; attempt remains incomplete\")\n  1655\t\t}\n  1656\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".transcript\"), transcript, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1657\t\t\treturn ReviewRun{}, err\n  1658\t\t}\n  1659\t\tif run.EventsDigest != \"\" {\n  1660\t\t\tif err := publishDelegationEvents(dir, run.RunID, events); err != nil {\n  1661\t\t\t\treturn ReviewRun{}, err\n  1662\t\t\t}\n  1663\t\t}\n  1664\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".json\"), pretty, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1665\t\t\treturn ReviewRun{}, err\n  1666\t\t}\n  1667\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".json\"))\n  1668\t\treturn run, nil\n  1669\t}\n  1670\t\n  1671\tfunc (s Store) dispatchNoLongerGoverns(plan DispatchPlan) string {\n  1672\t\tcurrent, err := s.LoadReviewBundle(plan.Bundle.BundleID)\n  1673\t\tif err != nil {\n  1674\t\t\treturn \"stale: the bundle the run reviewed can no longer be read: \" + err.Error()\n  1675\t\t}\n  1676\t\tif current.BundleDigest != plan.Bundle.BundleDigest {\n  1677\t\t\treturn \"stale: the bundle the run reviewed changed while it ran\"\n  1678\t\t}\n  1679\t\t// The baseline is a digest of a policy that was read whole, and the policy must still\n  1680\t\t// read whole and unchanged: a policy that cannot be read now is not an unchanged one.\n  1681\t\tif !directoryDigestKnown(plan.PolicyDigest) {\n  1682\t\t\treturn \"stale: the dispatch has no readable policy baseline (\" + plan.PolicyDigest + \")\"\n  1683\t\t}\n  1684\t\tif now := directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")); now != plan.PolicyDigest {\n  1685\t\t\t// A run recorded before pose update converted reviewers.json keeps its\n  1686\t\t\t// baseline while delegation.json is exactly that conversion (D7).\n  1687\t\t\tif before, ok := s.migratedPolicyBaseline(); !ok || before != plan.PolicyDigest {\n  1688\t\t\t\treturn \"stale: the policy changed or can no longer be read whole while the run was going (\" + now + \")\"\n  1689\t\t\t}\n  1690\t\t}\n  1691\t\t// Every sealed bundle of the scope must have been read: one that cannot be read may be\n  1692\t\t// the one that superseded this.\n  1693\t\tread, readErr := s.ReadReviewBundles(plan.Brief.Scope)\n  1694\t\tif readErr != nil {\n  1695\t\t\treturn \"stale: the bundles of the scope could not be read: \" + readErr.Error()\n  1696\t\t}\n  1697\t\tif !read.Coverage.CompleteFor(plan.Brief.Scope) {\n  1698\t\t\treturn \"stale: a sealed bundle of the scope could not be read, so the run cannot be tied to the one that governs it\"\n  1699\t\t}\n  1700\t\t// The bundle governs while the inputs it sealed are the ones the repository has now:\n  1701\t\t// the semantic digest of today's preparation, not the order of identifiers.\n  1702\t\tprepared, prepErr := s.PrepareReviewBundle(plan.Brief.Scope)\n  1703\t\tif prepErr != nil {\n  1704\t\t\treturn \"stale: the inputs of the scope could not be prepared again: \" + prepErr.Error()\n  1705\t\t}\n  1706\t\tif !sealedBundleMatches(plan.Bundle, prepared) {\n  1707\t\t\treturn \"stale: the bundle was superseded or its inputs changed while the run was going (the scope now prepares \" + prepared.BundleDigest + \")\"\n  1708\t\t}\n  1709\t\t// Equal content is not the governing bundle: a later seal may have replaced\n  1710\t\t// the implementation identity this run was compared with.\n","exit_code":0,"status":"completed"}}
