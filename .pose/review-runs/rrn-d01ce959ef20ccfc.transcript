{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '1,240p' && nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '500,550p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Review rounds (spec pose-delegated-review-round-protocol).\n     4\t//\n     5\t// The rounds of a scope are the sealed bundles of that scope a completed\n     6\t// delegated review concluded on, in the order those runs ended. A round after\n     7\t// the first is briefed with the open findings of the round before, each with\n     8\t// the identity it was first given, and its draft must account for every one\n     9\t// of them and say what it swept (R1–R5, D2). The draft is the fenced\n    10\t// `pose-draft` block of the reviewer's final message: JSON, versioned, read\n    11\t// strictly; prose around it is the reviewer's and is not read.\n    12\t\n    13\timport (\n    14\t\t\"bytes\"\n    15\t\t\"encoding/json\"\n    16\t\t\"fmt\"\n    17\t\t\"io\"\n    18\t\t\"reflect\"\n    19\t\t\"regexp\"\n    20\t\t\"sort\"\n    21\t\t\"strings\"\n    22\t\t\"time\"\n    23\t)\n    24\t\n    25\t// ReviewDraftSchema is the schema of a pose-draft block.\n    26\tconst ReviewDraftSchema = \"pose.review.draft/v1\"\n    27\t\n    28\tconst (\n    29\t\treviewDraftFence            = \"```pose-draft\"\n    30\t\treviewDraftMaxFindings      = 500\n    31\t\treviewDraftMaxText          = 4000\n    32\t\tReviewRoundThresholdDefault = 5\n    33\t)\n    34\t\n    35\t// A finding's own identifier never carries a round prefix, which the engine\n    36\t// reserves; the identity it is carried under is that prefix and the\n    37\t// identifier, so the mapping is injective (review round 1, B2, B12).\n    38\tvar (\n    39\t\treviewFindingID   = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n    40\t\treviewRoundPrefix = regexp.MustCompile(`^R[0-9]+-`)\n    41\t\treviewCarriedID   = regexp.MustCompile(`^R[0-9]{1,6}-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n    42\t\t// reviewDraftOpening is any fence line that names pose-draft.\n    43\t\treviewDraftOpening = regexp.MustCompile(\"^(`{3,}|~{3,})\\\\s*pose-draft\")\n    44\t)\n    45\t\n    46\t// ReviewDraftFinding is one finding a draft reports.\n    47\ttype ReviewDraftFinding struct {\n    48\t\tID          string `json:\"id\"`\n    49\t\tSeverity    string `json:\"severity\"`\n    50\t\tDisposition string `json:\"disposition\"`\n    51\t\tFile        string `json:\"file,omitempty\"`\n    52\t\tLine        int    `json:\"line,omitempty\"`\n    53\t\tSummary     string `json:\"summary\"`\n    54\t\t// Action, Owner and ReviewBy let a follow-up become an accepted risk in\n    55\t\t// the attestation the engine records (spec\n    56\t\t// pose-delegated-review-conclusions R1).\n    57\t\tAction   string `json:\"action,omitempty\"`\n    58\t\tOwner    string `json:\"owner,omitempty\"`\n    59\t\tReviewBy string `json:\"review_by,omitempty\"`\n    60\t}\n    61\t\n    62\t// ReviewDraftCriterion answers one criterion of the plan, as the reviewer of\n    63\t// a recorded attestation does (spec pose-delegated-review-conclusions R1).\n    64\ttype ReviewDraftCriterion struct {\n    65\t\tID          string `json:\"id\"`\n    66\t\tDisposition string `json:\"disposition\"`\n    67\t\tEvidence    string `json:\"evidence,omitempty\"`\n    68\t\tRationale   string `json:\"rationale,omitempty\"`\n    69\t\t// Mappings answer the structural facts the criterion is responsible for,\n    70\t\t// as `--criterion` mappings do; the writer's gate judges them (review\n    71\t\t// round 1, B4).\n    72\t\tMappings []ReviewCriterionMapping `json:\"mappings,omitempty\"`\n    73\t}\n    74\t\n    75\t// ReviewDraftTool is the disposition of one tool the plan requires.\n    76\ttype ReviewDraftTool struct {\n    77\t\tID          string `json:\"id\"`\n    78\t\tComponent   string `json:\"component,omitempty\"`\n    79\t\tDisposition string `json:\"disposition\"`\n    80\t\tEvidence    string `json:\"evidence,omitempty\"`\n    81\t\tRationale   string `json:\"rationale,omitempty\"`\n    82\t}\n    83\t\n    84\t// ReviewDraftPrior is a draft's account of one prior finding (R3, R4).\n    85\ttype ReviewDraftPrior struct {\n    86\t\tID       string `json:\"id\"`\n    87\t\tStatus   string `json:\"status\"`\n    88\t\tEvidence string `json:\"evidence\"`\n    89\t}\n    90\t\n    91\t// ReviewDraft is the pose-draft block of a reviewer's final message.\n    92\ttype ReviewDraft struct {\n    93\t\tSchema        string               `json:\"schema\"`\n    94\t\tDecision      string               `json:\"decision\"`\n    95\t\tFindings      []ReviewDraftFinding `json:\"findings\"`\n    96\t\tPriorFindings []ReviewDraftPrior   `json:\"prior_findings,omitempty\"`\n    97\t\tSweep         string               `json:\"sweep,omitempty\"`\n    98\t\t// Criteria and Tools are the typed conclusion the engine records as an\n    99\t\t// attestation (spec pose-delegated-review-conclusions R1).\n   100\t\tCriteria []ReviewDraftCriterion `json:\"criteria,omitempty\"`\n   101\t\tTools    []ReviewDraftTool      `json:\"tools,omitempty\"`\n   102\t\t// Questions and Surfaces are the typed verdict of an adjudication and of\n   103\t\t// a smoke run, recorded where their origin reads them (spec\n   104\t\t// pose-delegated-verdict-destinations R1, R2).\n   105\t\tQuestions []ReviewDraftQuestion `json:\"questions,omitempty\"`\n   106\t\tSurfaces  []ReviewDraftSurface  `json:\"surfaces,omitempty\"`\n   107\t\t// BusinessDecision is a question the reviewer cannot answer from the\n   108\t\t// code, for a person to decide (spec\n   109\t\t// pose-delegated-review-action-fulfillment R7).\n   110\t\tBusinessDecision *ReviewDraftBusinessDecision `json:\"business_decision,omitempty\"`\n   111\t}\n   112\t\n   113\t// ReviewDraftBusinessDecision is a business question and its options.\n   114\ttype ReviewDraftBusinessDecision struct {\n   115\t\tQuestion string         `json:\"question\"`\n   116\t\tOptions  []ActionOption `json:\"options\"`\n   117\t}\n   118\t\n   119\t// ReviewDraftQuestion is an adjudication's verdict on one question the\n   120\t// scope records: a decision (D<n>) or a requirement (R<n>).\n   121\ttype ReviewDraftQuestion struct {\n   122\t\tID        string `json:\"id\"`\n   123\t\tVerdict   string `json:\"verdict\"`\n   124\t\tEvidence  string `json:\"evidence,omitempty\"`\n   125\t\tRationale string `json:\"rationale\"`\n   126\t}\n   127\t\n   128\t// ReviewDraftSurface is what a smoke run observed on one delivery target.\n   129\ttype ReviewDraftSurface struct {\n   130\t\tRef      string   `json:\"ref\"`\n   131\t\tOutcome  string   `json:\"outcome\"`\n   132\t\tCommands []string `json:\"commands\"`\n   133\t\tObserved string   `json:\"observed\"`\n   134\t}\n   135\t\n   136\t// Adjudication verdicts and smoke outcomes.\n   137\tconst (\n   138\t\tAdjudicationHolds           = \"holds\"\n   139\t\tAdjudicationDoesNotHold     = \"does-not-hold\"\n   140\t\tAdjudicationCannotDetermine = \"cannot-determine\"\n   141\t\tSmokeObserved               = \"observed\"\n   142\t\tSmokeNotObserved            = \"not-observed\"\n   143\t\tSmokeNotReachable           = \"not-reachable\"\n   144\t)\n   145\t\n   146\tvar adjudicationQuestionID = regexp.MustCompile(`^[DR][0-9]{1,4}$`)\n   147\t\n   148\t// Prior finding statuses (R3).\n   149\tconst (\n   150\t\tPriorFindingFixed      = \"fixed\"\n   151\t\tPriorFindingPartial    = \"partial\"\n   152\t\tPriorFindingNotFixed   = \"not-fixed\"\n   153\t\tPriorFindingSuperseded = \"superseded\"\n   154\t)\n   155\t\n   156\t// ParseReviewDraft reads the pose-draft block of output: nil when there is\n   157\t// none, an error when the block is not one valid draft. Fences are whole\n   158\t// lines, LF or CRLF: an opening line is exactly \"```pose-draft\", the block\n   159\t// closes at the first line that is exactly \"```\", and any other line that\n   160\t// starts a fence before it, or a second block, is an error, never a block\n   161\t// read as absent (review round 2, R2-B2). Every decision line outside the\n   162\t// block must agree with it (R2-B1).\n   163\tfunc ParseReviewDraft(output string) (*ReviewDraft, error) {\n   164\t\tlines := strings.Split(output, \"\\n\")\n   165\t\tfor i := range lines {\n   166\t\t\tlines[i] = strings.TrimSuffix(lines[i], \"\\r\")\n   167\t\t}\n   168\t\topen, close := -1, -1\n   169\t\tfor i, line := range lines {\n   170\t\t\ttrimmed := strings.TrimSpace(line)\n   171\t\t\t// Any fence that names pose-draft — indented, spaced, longer, or\n   172\t\t\t// with tildes — is an attempt at a block: only the exact form opens\n   173\t\t\t// one, and any other is an error (review round 3, R3-B1).\n   174\t\t\tattempt := reviewDraftOpening.MatchString(trimmed)\n   175\t\t\tswitch {\n   176\t\t\tcase attempt && (open >= 0 || line != reviewDraftFence):\n   177\t\t\t\tif close >= 0 || open >= 0 {\n   178\t\t\t\t\treturn nil, fmt.Errorf(\"the message carries more than one pose-draft block\")\n   179\t\t\t\t}\n   180\t\t\t\treturn nil, fmt.Errorf(\"line %d opens a pose-draft block in a form the engine does not read: %q\", i+1, quoteLedgerText(line))\n   181\t\t\tcase attempt:\n   182\t\t\t\topen = i\n   183\t\t\tcase open >= 0 && close < 0 && (strings.HasPrefix(trimmed, \"```\") || strings.HasPrefix(trimmed, \"~~~\")):\n   184\t\t\t\tif line != \"```\" {\n   185\t\t\t\t\treturn nil, fmt.Errorf(\"line %d inside the pose-draft block is not its closing fence: %q\", i+1, quoteLedgerText(line))\n   186\t\t\t\t}\n   187\t\t\t\tclose = i\n   188\t\t\t}\n   189\t\t}\n   190\t\tif open < 0 {\n   191\t\t\treturn nil, nil\n   192\t\t}\n   193\t\tif close < 0 {\n   194\t\t\treturn nil, fmt.Errorf(\"the pose-draft block is not closed\")\n   195\t\t}\n   196\t\traw := []byte(strings.Join(lines[open+1:close], \"\\n\"))\n   197\t\tvar draft ReviewDraft\n   198\t\tdec := json.NewDecoder(bytes.NewReader(raw))\n   199\t\tdec.DisallowUnknownFields()\n   200\t\tif err := dec.Decode(&draft); err != nil {\n   201\t\t\treturn nil, fmt.Errorf(\"the pose-draft block is not a draft: %v\", err)\n   202\t\t}\n   203\t\tif _, err := dec.Token(); err != io.EOF {\n   204\t\t\treturn nil, fmt.Errorf(\"the pose-draft block carries data after the draft\")\n   205\t\t}\n   206\t\tif err := exactJSONKeys(json.NewDecoder(bytes.NewReader(raw)), reflect.TypeOf(draft)); err != nil {\n   207\t\t\treturn nil, fmt.Errorf(\"the pose-draft block is ambiguous: %v\", err)\n   208\t\t}\n   209\t\tif err := validateReviewDraft(draft); err != nil {\n   210\t\t\treturn nil, err\n   211\t\t}\n   212\t\tfor i, line := range lines {\n   213\t\t\tif i > open && i <= close {\n   214\t\t\t\tcontinue\n   215\t\t\t}\n   216\t\t\tkey, value, ok := strings.Cut(strings.TrimSpace(line), \":\")\n   217\t\t\tif ok && key == \"decision\" && strings.TrimSpace(value) != draft.Decision {\n   218\t\t\t\treturn nil, fmt.Errorf(\"the draft's decision %s differs from the decision line %q\", draft.Decision, strings.TrimSpace(value))\n   219\t\t\t}\n   220\t\t}\n   221\t\treturn &draft, nil\n   222\t}\n   223\t\n   224\t// draftReviewDecision is the decision a run's final message declares: the\n   225\t// pose-draft block's when there is one, which a contradicting decision line\n   226\t// makes unknown, or else the legacy decision line (review round 1, B13).\n   227\tfunc draftReviewDecision(output string) string {\n   228\t\tdraft, err := ParseReviewDraft(output)\n   229\t\tswitch {\n   230\t\tcase err != nil:\n   231\t\t\treturn \"unknown\"\n   232\t\tcase draft != nil:\n   233\t\t\treturn draft.Decision\n   234\t\t}\n   235\t\treturn legacyReviewDecision(output)\n   236\t}\n   237\t\n   238\tfunc validateReviewDraft(d ReviewDraft) error {\n   239\t\tif d.Schema != ReviewDraftSchema {\n   240\t\t\treturn fmt.Errorf(\"the draft's schema is %q, not %s\", d.Schema, ReviewDraftSchema)\n   500\t\tentries, truncated, err = readDirBounded(dir, 20)\n   501\t\tif err != nil || len(entries) != 12 || truncated {\n   502\t\t\tt.Fatalf(\"listing: %d entries, truncated=%t, %v\", len(entries), truncated, err)\n   503\t\t}\n   504\t}\n   505\t\n   506\t// Review round 14, N5: a release interrupted after its run's witness and\n   507\t// before the run's record leaves an incomplete history; the next release\n   508\t// records the same run again, completes it and releases the attempt.\n   509\tfunc TestAReleaseInterruptedAfterTheWitnessCompletes(t *testing.T) {\n   510\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   511\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   512\t\tif err != nil {\n   513\t\t\tt.Fatal(err)\n   514\t\t}\n   515\t\tattempt := \"\"\n   516\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   517\t\tfunc() {\n   518\t\t\tdefer func() { _ = recover() }()\n   519\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   520\t\t}()\n   521\t\twriteDeadMarker(t, f.store, attempt)\n   522\t\tafterRunWitnessPublished = func(ReviewRun) error { return errors.New(\"the release ends between the witness and the record\") }\n   523\t\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false); err == nil {\n   524\t\t\tt.Fatal(\"the interrupted release reported success\")\n   525\t\t}\n   526\t\tafterRunWitnessPublished = func(ReviewRun) error { return nil }\n   527\t\tif _, lost, _ := f.store.ReadReviewRuns(f.bundle.BundleID); len(lost) == 0 {\n   528\t\t\tt.Fatal(\"the interruption left no incomplete history to recover from\")\n   529\t\t}\n   530\t\trun, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   531\t\tif err != nil {\n   532\t\t\tt.Fatalf(\"the release after the interruption was refused: %v\", err)\n   533\t\t}\n   534\t\tif _, lost, _ := f.store.ReadReviewRuns(f.bundle.BundleID); len(lost) != 0 {\n   535\t\t\tt.Fatalf(\"the history stays incomplete after the release: %v\", lost)\n   536\t\t}\n   537\t\tif next, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\"); err != nil || next.Bundle.BundleID == \"\" {\n   538\t\t\tt.Fatalf(\"the released attempt still blocks the bundle (%s): %v\", run.RunID, err)\n   539\t\t}\n   540\t}\n","exit_code":0,"status":"completed"}}
