n(s) <= n {\n  1588\t\t\treturn s\n  1589\t\t}\n  1590\t\treturn s[len(s)-n:]\n  1591\t}\n  1592\t\n  1593\t// afterRunWitnessPublished runs between a run's witness and its record;\n  1594\t// tests use it to stop a recording there.\n  1595\tvar afterRunWitnessPublished = func(ReviewRun) error { return nil }\n  1596\t\n  1597\t// beforeAttemptPublished runs between the active marker and the reservation;\n  1598\t// tests use it to stop a dispatch there.\n  1599\tvar beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {}\n  1600\t\n  1601\t// identifiedReviewRun is run as recordReviewRun persists it, with its\n  1602\t// content identity: the same content always yields the same run id.\n  1603\tfunc identifiedReviewRun(run ReviewRun, transcript []byte) (ReviewRun, []byte) {\n  1604\t\t// Identity covers only persisted content, never fields derived by a reader\n  1605\t\t// or a previous write of a copied record.\n  1606\t\trun.RunID, run.Path, run.TranscriptPath, run.SupersededBy = \"\", \"\", \"\", \"\"\n  1607\t\trun.LedgerVersion = 1\n  1608\t\tsum := sha256.Sum256(transcript)\n  1609\t\trun.TranscriptDigest = \"sha256:\" + hex.EncodeToString(sum[:])\n  1610\t\tvar events []byte\n  1611\t\trun.EventsDigest = \"\"\n  1612\t\tif run.Events != \"\" {\n  1613\t\t\tevents = run.eventsBytes\n  1614\t\t\trun.EventsDigest = digestBytes(events)\n  1615\t\t}\n  1616\t\trun.eventsBytes = nil // never part of the record or of a copy compared with it\n  1617\t\tidentity, _ := json.Marshal(run)\n  1618\t\tidSum := sha256.Sum256(identity)\n  1619\t\trun.RunID = \"rrn-\" + hex.EncodeToString(idSum[:])[:16]\n  1620\t\treturn run, events\n  1621\t}\n  1622\t\n  1623\tfunc (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\n  1624\t\trun, events := identifiedReviewRun(run, transcript)\n  1625\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, reviewRunsDir, true)\n  1626\t\tif err != nil {\n  1627\t\t\treturn ReviewRun{}, err\n  1628\t\t}\n  1629\t\trun.TranscriptPath = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\"))\n  1630\t\tpretty, err := json.MarshalIndent(run, \"\", \"  \")\n  1631\t\tif err != nil {\n  1632\t\t\treturn ReviewRun{}, err\n  1633\t\t}\n  1634\t\tpretty = append(pretty, '\\n')\n  1635\t\tif len(pretty) > reviewLedgerMaxBytes {\n  1636\t\t\treturn ReviewRun{}, fmt.Errorf(\"review run record exceeds %d-byte bound; nothing published\", reviewLedgerMaxBytes)\n  1637\t\t}\n  1638\t\tif len(transcript) > reviewTranscriptMaxBytes {\n  1639\t\t\treturn ReviewRun{}, fmt.Errorf(\"review transcript exceeds %d-byte bound; nothing published\", reviewTranscriptMaxBytes)\n  1640\t\t}\n  1641\t\n  1642\t\twitness := reviewRunWitness{SchemaVersion: 1, RunID: run.RunID, BundleID: run.BundleID, Scope: run.Scope, RecordDigest: digestBytes(pretty), TranscriptDigest: run.TranscriptDigest}\n  1643\t\t// A publication of identical bytes is accepted, so a recording interrupted\n  1644\t\t// after the witness completes when the same content is recorded again\n  1645\t\t// (spec pose-review-run-reaps-lingering-reviewer-processes, review round\n  1646\t\t// 14, N5).\n  1647\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(filepath.Join(reviewRunLedgerDir, run.RunID+\".json\")), witness); err != nil {\n  1648\t\t\treturn ReviewRun{}, err\n  1649\t\t}\n  1650\t\tif err := afterRunWitnessPublished(run); err != nil {\n  1651\t\t\treturn ReviewRun{}, err\n  1652\t\t}\n  1653\t\tif run.Safety != nil && int64(len(pretty)+len(transcript)+len(events)) > run.Safety.RetainedBytes {\n  1654\t\t\treturn ReviewRun{}, fmt.Errorf(\"retained run exceeds containment byte budget; attempt remains incomplete\")\n  1655\t\t}\n  1656\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".transcript\"), transcript, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1657\t\t\treturn ReviewRun{}, err\n  1658\t\t}\n  1659\t\tif run.EventsDigest != \"\" {\n  1660\t\t\tif err := publishDelegationEvents(dir, run.RunID, events); err != nil {\n  1661\t\t\t\treturn ReviewRun{}, err\n  1662\t\t\t}\n  1663\t\t}\n  1664\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".json\"), pretty, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1665\t\t\treturn ReviewRun{}, err\n  1666\t\t}\n  1667\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".json\"))\n  1668\t\treturn run, nil\n  1669\t}\n  1670\t\n  1671\tfunc (s Store) dispatchNoLongerGoverns(plan DispatchPlan) string {\n  1672\t\tcurrent, err := s.LoadReviewBundle(plan.Bundle.BundleID)\n  1673\t\tif err != nil {\n  1674\t\t\treturn \"stale: the bundle the run reviewed can no longer be read: \" + err.Error()\n  1675\t\t}\n  1676\t\tif current.BundleDigest != plan.Bundle.BundleDigest {\n  1677\t\t\treturn \"stale: the bundle the run reviewed changed while it ran\"\n  1678\t\t}\n  1679\t\t// The baseline is a digest of a policy that was read whole, and the policy must still\n  1680\t\t// read whole and unchanged: a policy that cannot be read now is not an unchanged one.\n  1681\t\tif !directoryDigestKnown(plan.PolicyDigest) {\n  1682\t\t\treturn \"stale: the dispatch has no readable policy baseline (\" + plan.PolicyDigest + \")\"\n  1683\t\t}\n  1684\t\tif now := directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")); now != plan.PolicyDigest {\n  1685\t\t\t// A run recorded before pose update converted reviewers.json keeps its\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_tree_windows.go | sed -n '1,220p'\"","aggregated_output":"     1\t//go:build windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Ending the reviewer's process tree on Windows (spec\n     6\t// pose-review-run-reaps-lingering-reviewer-processes R1, review round 13,\n     7\t// N1): the adapter starts suspended, is assigned to a job object that kills\n     8\t// every process in it when the job is terminated or its last handle closes,\n     9\t// and only then resumes, so no descendant can start outside the job. The\n    10\t// dispatch terminates the job after the run, on a timeout, and, through the\n    11\t// kill-on-close limit, when the dispatching process ends.\n    12\t\n    13\timport (\n    14\t\t\"fmt\"\n    15\t\t\"os/exec\"\n    16\t\t\"sync\"\n    17\t\t\"syscall\"\n    18\t\t\"time\"\n    19\t\t\"unsafe\"\n    20\t\n    21\t\t\"golang.org/x/sys/windows\"\n    22\t)\n    23\t\n    24\tvar reviewJobs sync.Map // *exec.Cmd -> windows.Handle\n    25\t\n    26\t// jobBasicAccounting is JOBOBJECT_BASIC_ACCOUNTING_INFORMATION.\n    27\ttype jobBasicAccounting struct {\n    28\t\tTotalUserTime             int64\n    29\t\tTotalKernelTime           int64\n    30\t\tThisPeriodTotalUserTime   int64\n    31\t\tThisPeriodTotalKernelTime int64\n    32\t\tTotalPageFaultCount       uint32\n    33\t\tTotalProcesses            uint32\n    34\t\tActiveProcesses           uint32\n    35\t\tTotalTerminatedProcesses  uint32\n    36\t}\n    37\t\n    38\t// prepareReviewProcessTree makes cmd start suspended, so it can be placed in\n    39\t// its job before it runs.\n    40\tfunc prepareReviewProcessTree(cmd *exec.Cmd) {\n    41\t\tif cmd.SysProcAttr == nil {\n    42\t\t\tcmd.SysProcAttr = &syscall.SysProcAttr{}\n    43\t\t}\n    44\t\tcmd.SysProcAttr.CreationFlags |= windows.CREATE_SUSPENDED\n    45\t\tcmd.Cancel = func() error { return terminateReviewJob(cmd) }\n    46\t}\n    47\t\n    48\t// attachReviewProcessTree places the started, suspended process in a new\n    49\t// kill-on-close job and resumes it. A process that cannot be placed is\n    50\t// terminated: it never runs outside the job.\n    51\tfunc attachReviewProcessTree(cmd *exec.Cmd) error {\n    52\t\tjob, err := windows.CreateJobObject(nil, nil)\n    53\t\tif err != nil {\n    54\t\t\t_ = cmd.Process.Kill()\n    55\t\t\treturn fmt.Errorf(\"the reviewer's job object could not be created: %w\", err)\n    56\t\t}\n    57\t\tinfo := windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION{}\n    58\t\tinfo.BasicLimitInformation.LimitFlags = windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE\n    59\t\tif _, err := windows.SetInformationJobObject(job, windows.JobObjectExtendedLimitInformation, uintptr(unsafe.Pointer(&info)), uint32(unsafe.Sizeof(info))); err != nil {\n    60\t\t\t_ = windows.CloseHandle(job)\n    61\t\t\t_ = cmd.Process.Kill()\n    62\t\t\treturn fmt.Errorf(\"the reviewer's job object could not be limited: %w\", err)\n    63\t\t}\n    64\t\tprocess, err := windows.OpenProcess(windows.PROCESS_SET_QUOTA|windows.PROCESS_TERMINATE, false, uint32(cmd.Process.Pid))\n    65\t\tif err != nil {\n    66\t\t\t_ = windows.CloseHandle(job)\n    67\t\t\t_ = cmd.Process.Kill()\n    68\t\t\treturn fmt.Errorf(\"the reviewer's process could not be opened: %w\", err)\n    69\t\t}\n    70\t\tdefer windows.CloseHandle(process)\n    71\t\tif err := windows.AssignProcessToJobObject(job, process); err != nil {\n    72\t\t\t_ = windows.CloseHandle(job)\n    73\t\t\t_ = cmd.Process.Kill()\n    74\t\t\treturn fmt.Errorf(\"the reviewer's process could not join its job: %w\", err)\n    75\t\t}\n    76\t\treviewJobs.Store(cmd, job)\n    77\t\tif err := resumeProcessThreads(uint32(cmd.Process.Pid)); err != nil {\n    78\t\t\t_ = terminateReviewJob(cmd)\n    79\t\t\treturn fmt.Errorf(\"the reviewer's process could not be resumed: %w\", err)\n    80\t\t}\n    81\t\treturn nil\n    82\t}\n    83\t\n    84\t// resumeProcessThreads resumes every thread of pid; a suspended process has\n    85\t// only its main thread.\n    86\tfunc resumeProcessThreads(pid uint32) error {\n    87\t\tsnapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPTHREAD, 0)\n    88\t\tif err != nil {\n    89\t\t\treturn err\n    90\t\t}\n    91\t\tdefer windows.CloseHandle(snapshot)\n    92\t\tentry := windows.ThreadEntry32{Size: uint32(unsafe.Sizeof(windows.ThreadEntry32{}))}\n    93\t\tresumed := 0\n    94\t\tfor err = windows.Thread32First(snapshot, &entry); err == nil; err = windows.Thread32Next(snapshot, &entry) {\n    95\t\t\tif entry.OwnerProcessID != pid {\n    96\t\t\t\tcontinue\n    97\t\t\t}\n    98\t\t\tthread, err := windows.OpenThread(windows.THREAD_SUSPEND_RESUME, false, entry.ThreadID)\n    99\t\t\tif err != nil {\n   100\t\t\t\treturn err\n   101\t\t\t}\n   102\t\t\t_, rerr := windows.ResumeThread(thread)\n   103\t\t\t_ = windows.CloseHandle(thread)\n   104\t\t\tif rerr != nil {\n   105\t\t\t\treturn rerr\n   106\t\t\t}\n   107\t\t\tresumed++\n   108\t\t}\n   109\t\tif resumed == 0 {\n   110\t\t\treturn fmt.Errorf(\"no thread of process %d was found\", pid)\n   111\t\t}\n   112\t\treturn nil\n   113\t}\n   114\t\n   115\t// terminateReviewJob ends every process of cmd's job and waits until the job\n   116\t// is empty.\n   117\tfunc terminateReviewJob(cmd *exec.Cmd) error {\n   118\t\tvalue, ok := reviewJobs.Load(cmd)\n   119\t\tif !ok {\n   120\t\t\tif cmd.Process != nil {\n   121\t\t\t\treturn cmd.Process.Kill()\n   122\t\t\t}\n   123\t\t\treturn nil\n   124\t\t}\n   125\t\tjob := value.(windows.Handle)\n   126\t\tif err := windows.TerminateJobObject(job, 1); err != nil {\n   127\t\t\treturn fmt.Errorf(\"the reviewer's job could not be terminated: %w\", err)\n   128\t\t}\n   129\t\tdeadline := time.Now().Add(reviewReapWait)\n   130\t\tfor {\n   131\t\t\tvar acct jobBasicAccounting\n   132\t\t\tif err := windows.QueryInformationJobObject(job, windows.JobObjectBasicAccountingInformation, uintptr(unsafe.Pointer(&acct)), uint32(unsafe.Sizeof(acct)), nil); err != nil {\n   133\t\t\t\treturn fmt.Errorf(\"the reviewer's job could not be inspected: %w\", err)\n   134\t\t\t}\n   135\t\t\tif acct.ActiveProcesses == 0 {\n   136\t\t\t\treturn nil\n   137\t\t\t}\n   138\t\t\tif time.Now().After(deadline) {\n   139\t\t\t\treturn fmt.Errorf(\"%d process(es) of the reviewer's job could not be ended\", acct.ActiveProcesses)\n   140\t\t\t}\n   141\t\t\ttime.Sleep(20 * time.Millisecond)\n   142\t\t}\n   143\t}\n   144\t\n   145\t// releaseReviewProcessTree terminates the job and closes its handle.\n   146\tfunc releaseReviewProcessTree(cmd *exec.Cmd) error {\n   147\t\terr := terminateReviewJob(cmd)\n   148\t\tif value, ok := reviewJobs.LoadAndDelete(cmd); ok {\n   149\t\t\t_ = windows.CloseHandle(value.(windows.Handle))\n   150\t\t}\n   151\t\treturn err\n   152\t}\n","exit_code":0,"status":"completed"}}
