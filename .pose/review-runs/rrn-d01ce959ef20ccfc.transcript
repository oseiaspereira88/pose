& strings.TrimSpace(plan.Reason) == \"\" {\n   415\t\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n   416\t\t}\n   417\t\treturn attempts, count, nil\n   418\t}\n   419\t\n   420\t// prepareDelegatedReviewAttempt admits and builds the next reservation of\n   440\t// review round 1, N1).\n   441\tfunc (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n   442\t\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n   443\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n   444\t\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n   445\t\t}\n   446\t\treturn nil\n   447\t}\n   448\tfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n   449\t\traw, _ := json.Marshal(run)\n   450\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n   451\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n   452\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n   453\t}\n   454\t\n   455\t// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n   456\t// exists for legacy records; their content identity remains independently checked.\n   457\tfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n   458\t\tbudget := int64(32 << 20)\n   459\t\treturn s.reviewRunLedgerFindings(bundle, &budget)\n   460\t}\n   461\tfunc (s Store) reviewRunLedgerFindings(bundle string, budget *int64) ([]string, error) {\n   462\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, reviewRunLedgerDir)\n   463\t\tif err != nil {\n   464\t\t\treturn nil, err\n   465\t\t}\n   466\t\tfindings := []string{}\n   467\t\tvar checkedBytes int64\n   468\t\tfor _, e := range entries {\n   469\t\t\tif IsPublisherStaging(e.Name()) {\n   470\t\t\t\tcontinue\n   471\t\t\t}\n   472\t\t\tvar w reviewRunWitness\n   473\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunLedgerDir, e.Name()), &w, budget); err != nil {\n   474\t\t\t\tfindings = append(findings, err.Error())\n   475\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   476\t\t\t\t\tbreak\n   477\t\t\t\t}\n   478\t\t\t\tcontinue\n   479\t\t\t}\n   480\t\t\tif w.SchemaVersion != 1 || e.Name() != w.RunID+\".json\" || strings.ContainsAny(w.RunID, \"/\\\\\") {\n   481\t\t\t\tfindings = append(findings, \"invalid run witness \"+e.Name())\n   482\t\t\t\tcontinue\n   483\t\t\t}\n   484\t\t\tvar run ReviewRun\n   485\t\t\traw, readErr := readLedgerRawBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, w.RunID+\".json\"), budget)\n   486\t\t\tif readErr != nil {\n   487\t\t\t\tfindings = append(findings, \"witnessed run \"+w.RunID+\": \"+readErr.Error())\n   488\t\t\t\tif errors.Is(readErr, errReviewLedgerBudget) {\n   489\t\t\t\t\tbreak\n   490\t\t\t\t}\n   570\t\t\treturn nil, err\n   571\t\t}\n   572\t\targs = append([]string{\"log\", \"--format=\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\"}, roots...)\n   573\t\tcommitted, err := reviewHistoryGit(s.Root, args...)\n   574\t\tif err != nil {\n   575\t\t\treturn nil, err\n   576\t\t}\n   577\t\tfor _, line := range strings.Split(string(append(pending, committed...)), \"\\n\") {\n   578\t\t\tif strings.TrimSpace(line) != \"\" {\n   579\t\t\t\tfindings = append(findings, \"immutable review evidence changed: \"+line)\n   580\t\t\t}\n   581\t\t}\n   582\t\truns, lost, err := s.ReadReviewRuns(\"\")\n   583\t\tif err != nil {\n   584\t\t\treturn nil, err\n   585\t\t}\n   586\t\t_ = runs\n   587\t\tfindings = append(findings, lost...)\n   588\t\tattempts, losses := s.allDelegatedReviewAttempts()\n   589\t\tfindings = append(findings, losses...)\n   590\t\treceiptBudget := int64(32 << 20)\n   591\t\tfor _, a := range attempts {\n   592\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   593\t\t\t\tfindings = append(findings, err.Error())\n   594\t\t\t}\n   595\t\t}\n   596\t\treturn uniqueSorted(findings), nil\n   597\t}\n   598\t\n   599\t// legacyReviewDecision reads the decision line of a final message; a\n   600\t// pose-draft block, when present, decides instead (draftReviewDecision).\n   601\t// DraftDecision is telemetry about an adapter's text, not verified authority.\n   602\tfunc legacyReviewDecision(output string) string {\n   603\t\tdecision := \"\"\n   604\t\tfor _, line := range strings.Split(output, \"\\n\") {\n   605\t\t\tkey, value, ok := strings.Cut(strings.TrimSpace(line), \":\")\n   606\t\t\tif !ok || key != \"decision\" {\n   607\t\t\t\tcontinue\n   608\t\t\t}\n   609\t\t\tvalue = strings.TrimSpace(value)\n   610\t\t\tif value != \"approved\" && value != \"changes-requested\" && value != \"rejected\" {\n   650\t\t\tlost = append(lost, err.Error())\n   651\t\t}\n   652\t\tout := []ReviewRunSummary{}\n   653\t\tfor _, run := range runs {\n   654\t\t\tif run.Scope == scope {\n   655\t\t\t\tdecision := \"unknown\"\n   656\t\t\t\tif run.Status == ReviewRunCompleted && reviewSafetyConflict(run) == \"\" {\n   657\t\t\t\t\tdecision = draftReviewDecision(run.Output)\n   658\t\t\t\t}\n   659\t\t\t\tif len(run.DraftProblems) > 0 && decision != \"unknown\" {\n   660\t\t\t\t\tdecision = \"invalid\"\n   661\t\t\t\t}\n   662\t\t\t\tout = append(out, ReviewRunSummary{Safety: run.Safety, Resumes: run.Resumes, LimitOf: run.LimitOf, Partial: run.Status == ReviewRunInterrupted, Interruption: run.Interruption, SupersededBy: run.SupersededBy, RunID: run.RunID, AttemptID: run.AttemptID, BundleID: run.BundleID, Adapter: run.Adapter, Status: run.Status, DraftDecision: decision, Reason: run.Reason, Assurance: \"declared-draft-not-attestation\", Round: run.Round, Thread: run.Thread, DraftProblems: run.DraftProblems})\n   663\t\t\t}\n   664\t\t}\n   665\t\tattempts, losses := s.allDelegatedReviewAttempts()\n   666\t\tlost = append(lost, losses...)\n   667\t\treceiptBudget := int64(32 << 20)\n   668\t\tfor _, a := range attempts {\n   669\t\t\tif a.Scope == scope {\n   670\t\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   671\t\t\t\t\tlost = append(lost, err.Error())\n   672\t\t\t\t}\n   673\t\t\t}\n   674\t\t}\n   675\t\treturn out, uniqueSorted(lost)\n   676\t}\n   677\t\n   678\ttype DelegatedReviewMetric struct {\n   679\t\tResumes         int    `json:\"resumes\"`\n   680\t\tKey             string `json:\"key\"`\n   681\t\tRuns            int    `json:\"runs\"`\n   682\t\tAttempts        int    `json:\"attempts\"`\n   683\t\tApprovedDrafts  int    `json:\"approved_drafts\"`\n   684\t\tRejectingDrafts int    `json:\"rejecting_drafts\"`\n   685\t\tUnknownDrafts   int    `json:\"unknown_drafts\"`\n   686\t\t// InvalidDrafts are drafts that do not account for their round (spec\n   687\t\t// pose-delegated-review-round-protocol R4): never approvals.\n   688\t\tInvalidDrafts       int      `json:\"invalid_drafts\"`\n   689\t\tReruns              int      `json:\"reruns_without_bundle_change\"`\n   690\t\tRerunsWithoutReason int      `json:\"reruns_without_reason\"`\n   750\t\t\tif reviewAttemptKey(bundle) != dir.Name() {\n   751\t\t\t\tlosses = append(losses, \"attempt bundle directory identity mismatch\")\n   752\t\t\t\tcontinue\n   753\t\t\t}\n   754\t\t\tattempts, err := s.readDelegatedReviewAttempts(bundle, &budget)\n   755\t\t\tif err != nil {\n   756\t\t\t\tlosses = append(losses, err.Error())\n   757\t\t\t\tcontinue\n   758\t\t\t}\n   759\t\t\tout = append(out, attempts...)\n   760\t\t}\n   761\t\treturn out, losses\n   762\t}\n   763\t\n   764\tfunc (s Store) delegatedReviewInsights(sinceDays int) *DelegatedReviewInsights {\n   765\t\truns, lost, err := s.ReadReviewRuns(\"\")\n   766\t\tif err != nil {\n   767\t\t\tlost = append(lost, err.Error())\n   768\t\t}\n   769\t\tattempts, attemptLoss := s.allDelegatedReviewAttempts()\n   770\t\tlost = append(lost, attemptLoss...)\n   771\t\treceiptBudget := int64(32 << 20)\n   772\t\tfor _, a := range attempts {\n   773\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   774\t\t\t\tlost = append(lost, err.Error())\n   775\t\t\t}\n   776\t\t}\n   777\t\tif len(runs) == 0 && len(attempts) == 0 && len(lost) == 0 {\n   778\t\t\treturn nil\n   779\t\t}\n   780\t\tresult := &DelegatedReviewInsights{CoverageComplete: len(lost) == 0, Losses: uniqueSorted(lost), Assurance: \"declared-draft-outcomes-not-verified-approvals\", Rounds: reviewRoundMetrics(runs)}\n   781\t\tbundles, adapters := map[string]*DelegatedReviewMetric{}, map[string]*DelegatedReviewMetric{}\n   782\t\trow := func(group map[string]*DelegatedReviewMetric, key string) *DelegatedReviewMetric {\n   783\t\t\tr := group[key]\n   784\t\t\tif r == nil {\n   785\t\t\t\tr = &DelegatedReviewMetric{Key: key}\n   786\t\t\t\tgroup[key] = r\n   787\t\t\t}\n   788\t\t\treturn r\n   789\t\t}\n   790\t\tinWindow := func(at string) bool {\n   220\t\t_ = PublishFile(stallClaimPath(dir, marker), []byte(at+\"\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n   221\t\treturn readDelegationStall(dir, marker)\n   222\t}\n   223\t\n   224\tfunc cancelRequestPath(dir string, marker DelegationActiveRun) string {\n   225\t\treturn filepath.Join(dir, marker.AttemptID+\".\"+marker.RunToken+\".cancel\")\n   226\t}\n   227\t\n   228\tfunc validRunToken(token string) bool {\n   229\t\tif len(token) != 32 {\n   230\t\t\treturn false\n   231\t\t}\n   232\t\t_, err := hex.DecodeString(token)\n   233\t\treturn err == nil\n   234\t}\n   235\t\n   236\t// ListDelegationActive reads the markers with the liveness of their owners,\n   237\t// and returns as losses the markers it cannot read: a run it cannot observe is\n   238\t// reported, never listed as running nor left out in silence.\n   239\tfunc (s Store) ListDelegationActive() ([]DelegationActiveRun, []string, error) {\n   240\t\tdir, err := s.delegationActiveDir(false)\n   241\t\tif errors.Is(err, os.ErrNotExist) {\n   242\t\t\treturn []DelegationActiveRun{}, nil, nil\n   243\t\t}\n   244\t\tif err != nil {\n   245\t\t\treturn nil, nil, err\n   246\t\t}\n   247\t\tentries, err := os.ReadDir(dir)\n   248\t\tif err != nil {\n   249\t\t\treturn nil, nil, err\n   250\t\t}\n   251\t\tout := []DelegationActiveRun{}\n   252\t\tvar lost []string\n   253\t\tfor _, e := range entries {\n   254\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   255\t\t\t\tcontinue\n   256\t\t\t}\n   257\t\t\traw, err := readLedgerRaw(filepath.Join(dir, e.Name()))\n   258\t\t\tif errors.Is(err, os.ErrNotExist) {\n   259\t\t\t\tcontinue // the run ended between the listing and the read\n   260\t\t\t}\n   261\t\t\tif err != nil {\n   262\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" could not be read: \"+err.Error())\n   263\t\t\t\tcontinue\n   264\t\t\t}\n   265\t\t\tvar marker DelegationActiveRun\n   266\t\t\tif json.Unmarshal(raw, &marker) != nil || marker.SchemaVersion != 1 || marker.AttemptID+\".json\" != e.Name() || !validRunToken(marker.RunToken) {\n   267\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" is not one this engine reads\")\n   268\t\t\t\tcontinue\n   269\t\t\t}\n   270\t\t\tmarker.Liveness, marker.Detail = probeStartLockOwner(marker.Owner)\n   271\t\t\tmarker.StalledAt = readDelegationStall(dir, marker)\n   272\t\t\tif marker.StalledAt == \"\" && delegationMarkerSilent(marker, time.Now()) && marker.Liveness == LockOwnerDead {\n   273\t\t\t\tmarker.StalledAt = recordDelegationStall(dir, marker)\n   274\t\t\t}\n   275\t\t\tif _, err := os.Lstat(cancelRequestPath(dir, marker)); err == nil {\n   276\t\t\t\tmarker.CancelRequested = true\n   277\t\t\t}\n   278\t\t\tout = append(out, marker)\n   279\t\t}\n   280\t\tsort.Slice(out, func(i, j int) bool {\n   281\t\t\treturn out[i].StartedAt < out[j].StartedAt || out[i].StartedAt == out[j].StartedAt && out[i].AttemptID < out[j].AttemptID\n   282\t\t})\n   283\t\treturn out, lost, nil\n   284\t}\n   285\t\n   286\t// ErrDelegationNotActive means no running run matches.\n   287\tvar ErrDelegationNotActive = errors.New(\"pose: the run is not running\")\n   288\t\n   289\t// RequestDelegationCancel asks the process running attempt to stop. A marker\n   290\t// whose owner is proven dead is not cancelled: nothing runs to stop.\n   291\tfunc (s Store) RequestDelegationCancel(attempt string) (DelegationActiveRun, error) {\n   292\t\tactive, _, err := s.ListDelegationActive()\n   293\t\tif err != nil {\n   294\t\t\treturn DelegationActiveRun{}, err\n   295\t\t}\n   296\t\tfor _, marker := range active {\n   297\t\t\tif marker.AttemptID != attempt {\n   298\t\t\t\tcontinue\n   299\t\t\t}\n   300\t\t\tif marker.Liveness == LockOwnerDead {\n   301\t\t\t\treturn marker, fmt.Errorf(\"pose: the process of attempt %s is gone (%s); nothing runs to cancel\", attempt, marker.Detail)\n   302\t\t\t}\n   303\t\t\tdir, err := s.delegationActiveDir(false)\n   304\t\t\tif err != nil {\n   305\t\t\t\treturn marker, err\n   306\t\t\t}\n   307\t\t\trequest := cancelRequestPath(dir, marker)\n   308\t\t\tif err := PublishFile(request, []byte(time.Now().UTC().Format(time.RFC3339Nano)+\"\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil && !errors.Is(err, os.ErrExist) {\n   309\t\t\t\tif _, statErr := os.Lstat(request); statErr != nil {\n   310\t\t\t\t\treturn marker, err\n   311\t\t\t\t}\n   312\t\t\t}\n   313\t\t\t// The run may have ended between the read and the request: a request\n   314\t\t\t// that names no running run is withdrawn, never left for a successor.\n   315\t\t\tif !s.DelegationRunActive(marker) {\n   316\t\t\t\t_ = os.Remove(request)\n   317\t\t\t\treturn marker, ErrDelegationNotActive\n   318\t\t\t}\n   319\t\t\tmarker.CancelRequested = true\n   320\t\t\treturn marker, nil\n   321\t\t}\n   322\t\treturn DelegationActiveRun{}, ErrDelegationNotActive\n   323\t}\n   324\t\n   325\t// DelegationRunActive reports whether the run marker names is still the\n   326\t// running run of its attempt.\n   327\tfunc (s Store) DelegationRunActive(marker DelegationActiveRun) bool {\n   328\t\tdir, err := s.delegationActiveDir(false)\n   329\t\tif err != nil {\n   330\t\t\treturn false\n","exit_code":0,"status":"completed"}}
