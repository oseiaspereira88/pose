nal/pose/delegation_release.go       |  336 ++\n pose-mcp/internal/pose/delegation_release_test.go  |  540 +++\n pose-mcp/internal/pose/discovery.go                |   12 +\n .../internal/pose/engine_reads_raw_history_test.go |    1 +\n pose-mcp/internal/pose/integration.go              |    3 +\n pose-mcp/internal/pose/main_test.go                |    5 +\n .../internal/pose/review_adapter_containment.go    |   15 +\n .../review_adapter_containment_regression_test.go  |   19 +-\n pose-mcp/internal/pose/review_attempt_ledger.go    |   30 +-\n pose-mcp/internal/pose/review_brief.go             |   35 +-\n .../pose/review_brief_conclusion_rules_test.go     |   34 +-\n pose-mcp/internal/pose/review_brief_test.go        |    2 +-\n pose-mcp/internal/pose/review_dispatch.go          |  163 +-\n pose-mcp/internal/pose/review_plan.go              |    6 +-\n pose-mcp/internal/pose/review_reap_linux.go        |  221 ++\n pose-mcp/internal/pose/review_reap_linux_test.go   |  258 ++\n pose-mcp/internal/pose/review_reap_other.go        |   18 +\n pose-mcp/internal/pose/review_run_provenance.go    |    5 +\n pose-mcp/internal/pose/review_shim.go              |   63 +\n pose-mcp/internal/pose/review_shim_linux.go        |  293 ++\n pose-mcp/internal/pose/review_shim_test.go         |   25 +\n pose-mcp/internal/pose/review_tree_other.go        |   11 +\n pose-mcp/internal/pose/review_tree_windows.go      |  152 +\n pose-mcp/internal/pose/review_tree_windows_test.go |   39 +\n pose-mcp/internal/pose/techdebt.go                 |    3 +\n .../testdata/review_brief_template_digests.json    |    4 +-\n pose-mcp/internal/scaffold/dist/POSE.md            |    8 +-\n .../internal/scaffold/dist/locales/pt-BR/POSE.md   |    8 +-\n 227 files changed, 78883 insertions(+), 2380 deletions(-)\nreview-cli-configured\n","exit_code":0,"status":"completed"}}
