:= \".\"\nfunc TestCarryFallsBackToAFullRun(t *testing.T) {\n\tcases := []struct {\n\t\tname   string\n\t\tmutate func(f *carryFixture)\n\t\treason string\n\t}{\n\t\t{\"no base\", func(f *carryFixture) {}, \"no canonical result\"},\n\t\t{\"matrix changed\", func(f *carryFixture) {\n\t\t\tf.baseline()\n\t\t\traw, _ := os.ReadFile(filepath.Join(f.root, \".pose/indexes/validation-matrix.json\"))\n\t\t\tf.write(\".pose/indexes/validation-matrix.json\", strings.Replace(string(raw), `\"strict\"`, `\"strict\" `, 1))\n\t\t\tf.commit(\"matrix\")\n\t\t}, \"matrix\"},\n\t\t{\"dirty worktree\", func(f *carryFixture) {\n\t\t\tf.baseline()\n\t\t\tf.write(\"a/dirty.go\", \"package a\\n\")\n\t\t}, \"working copy\"},\n\t\t{\"base not an ancestor\", func(f *carryFixture) {\n\t\t\tf.baseline()\n\t\t\traw, _ := os.ReadFile(filepath.Join(f.root, carryResults))\n\t\t\tvar run map[string]any\n\t\t\t_ = json.Unmarshal(raw, &run)\n\t\t\trun[\"git_head\"] = strings.Repeat(\"0\", 40)\n\t\t\tout, _ := json.Marshal(run)\n\t\t\tf.write(carryResults, string(out))\n\t\t\tf.commit(\"forged base\")\n\t\t}, \"ancestor\"},\n\t\t{\"base without engine version\", func(f *carryFixture) {\n\t\t\tf.baseline()\n\t\t\traw, _ := os.ReadFile(filepath.Join(f.root, carryResults))\n\t\t\tvar run map[string]any\n\t\t\t_ = json.Unmarshal(raw, &run)\n\t\t\tdelete(run, \"engine_version\")\n\t\t\tout, _ := json.Marshal(run)\n\t\t\tf.write(carryResults, string(out))\n\t\t\tf.commit(\"old base\")\n\t\t}, \"engine\"},\n\t}\n\tfor _, tc := range cases {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tf := newCarryFixture(t, \"\")\n\t\t\ttc.mutate(f)\n\t\t\t_, out, run := f.validate(\"--carry\")\n\t\t\tif got := strings.Join(f.ran(), \",\"); got != \"a,b\" {\n\t\t\t\tt.Fatalf(\"executed = %q, want a full run; out=%s\", got, out)\n\t\t\t}\n\t\t\tif run.Carry == nil || run.Carry.Used || !strings.Contains(run.Carry.Reason, tc.reason) {\n\t\t\t\tt.Fatalf(\"carry = %+v, want unused with a reason naming %q\", run.Carry, tc.reason)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestCarryRootChangeRunsEverythingUnlessSelfContained(t *testing.T) {\n   100\t\t\tif check.LimitState == \"cancelled\" {\n   101\t\t\t\treturn unused(\"the canonical result was cancelled\")\n   102\t\t\t}\n   103\t\t}\n   104\t\t// The base must have validated the commit it records: a run over a working\n   105\t\t// copy that differed from its head proves nothing about that head.\n   106\t\tif !base.MaterialClean {\n   107\t\t\treturn unused(\"the canonical result did not validate a clean working copy of its head\")\n   108\t\t}\n   109\t\t// material_clean is the witness that the base validated its head. A spec\n   110\t\t// whose material the engine cannot compute is recorded unavailable in any\n   111\t\t// clean run, so an unavailable binding is not, by itself, a reason to\n   112\t\t// refuse; a run that was not clean has every binding unavailable and\n   113\t\t// material_clean false.\n   114\t\tif !materialWorktreeClean(root) {\n   115\t\t\treturn unused(\"the working copy differs from HEAD in material paths\")\n   116\t\t}\n   117\t\t// Selection is lexical: a module reached through a symlink aliases another\n   118\t\t// path, so its inputs cannot be told apart (review round 4, N9).\n   119\t\t// Two modules sharing one physical directory (a case alias on a\n   120\t\t// case-insensitive filesystem) alias each other too (review round 5, N13).\n   121\t\tif reason := aliasedModule(modules, filepath.EvalSymlinks, os.Stat); reason != \"\" {\n   122\t\t\treturn unused(\"%s\", reason)\n   123\t\t}\n   124\t\t// Lexical selection cannot see through aliases. Rather than chase every\n   125\t\t// alias form (review rounds 4–7, N9, N13, N16–N18), a carry needs a\n   126\t\t// case-sensitive filesystem and no tracked symlink that links a module\n{\n  \"defaults\": {\n    \"mode\": \"strict\"\n  },\n  \"deliveryProfiles\": {\n    \"cli-surface\": {\n      \"kind\": \"surface\",\n      \"requiredEvidenceClasses\": [\n        \"reachability\"\n      ],\n      \"anyEvidenceClasses\": [\n        \"integration\",\n        \"e2e\"\n      ]\n    },\n    \"composed-capability\": {\n      \"kind\": \"capability\",\n      \"requiredEvidenceClasses\": [\n        \"integration\"\n      ]\n    },\n    \"api-contract\": {\n","exit_code":0,"status":"completed"}}
