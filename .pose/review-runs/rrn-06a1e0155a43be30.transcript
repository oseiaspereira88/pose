eadyPresent {\n\t\t\t\tsets = append(sets, set)\n\t\t\t}\n\t\t}\n\t\tif len(sets) == 0 {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: no commits carry POSE-Spec: %s\\n\", spec)\n\t\t\treturn 1\n\t\t}\n\t}\n\tset := sets[0]\n\ttracked, err := gitTrackedPaths(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\t// A later removal by another spec is read from every spec's claims and\n\t// change sets (spec pose-delivery-later-removal R4).\n\tvar removals []posemodel.ArtifactRemoval\n\tif _, allClaims, allSets, _, _, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root); err == nil {\n\t\tremovals = artifactRemovals(root, allClaims, allSets, tracked, gaps, sets...)\n\t}\n\tgraph := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), []posemodel.Spec{*full}, claims, sets, tracked, policy, posemodel.LoadArchivedFragments(root), removals)\n\tfor _, claim := range claims {\n\t\tif claim.Action == \"none\" {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{claim.Path}\n\t\tif claim.Action == \"renamed\" {\n\t\t\tpaths = []string{claim.OldPath, claim.NewPath}\n\t\t}\n\t\tfor _, path := range paths {\n\t\t\tif err := posemodel.ValidateArtifactPath(root, path, false); err != nil {\n\t\t\t\tseverity := policy.Severities[\"resolvability\"]\n\t\t\t\tif severity == \"\" {\n\t\t\t\t\tseverity = \"warning\"\n\t\t\t\t}\n\t\t\t\tgraph.Findings = append(graph.Findings, posemodel.NewDeliveryIntegrityFinding(\"resolvability\", severity, spec, path, set.ID, err.Error(), \"declare an exact confined tracked file path\"))\n\t\t\t}\n\t\t}\n\t}\n\tsort.Slice(graph.Findings, func(i, j int) bool { return graph.Findings[i].ID < graph.Findings[j].ID })\n\tif jsonOutput {\n081c9a7c chore: seal the review bundle on a current index\n\t\ttags[tag] = binding\n\t}\n\treturn tags, nil\n}\n\n// ReleaseSnapshot is what the tree a tag points at says about its release.\ntype ReleaseSnapshot struct {\n\tTag string `json:\"tag\"`\n\t// ManifestDigest is the digest of the manifest as the tagged tree holds it, which the\n\t// working tree's manifest is bound to.\n\tManifestDigest string                 `json:\"manifest_digest,omitempty\"`\n\tCommit         string                 `json:\"commit\"`\n\tAnnotated      bool                   `json:\"annotated\"`\n\tManifest       *ReleaseManifest       `json:\"manifest,omitempty\"`\n\tIssues         []ReleaseManifestIssue `json:\"issues,omitempty\"`\n\tGaps           []string               `json:\"gaps,omitempty\"`\n\t// Limits say what could not be re-verified from the snapshot, which is not a failure.\n\tLimits []string `json:\"limits,omitempty\"`\n}\n\n// Intact reports a snapshot with a valid manifest and nothing contradicting it.\nfunc (s ReleaseSnapshot) Intact() bool {\n\treturn s.Manifest != nil && len(s.Issues) == 0 && len(s.Gaps) == 0\n}\n\n// ErrReleaseTagNotCommit means a tag exists and does not lead to a commit.\nvar ErrReleaseTagNotCommit = errors.New(\"pose: the release tag does not point at a commit\")\n\npose-mcp/internal/cli/project_id_directory_name_test.go:33:\tfor _, key := range []string{\"POSE_PROJECT_ROOT\", \"POSE_PROJECT_ROOTS\", \"POSE_DEFAULT_PROJECT_ID\", \"HARNE8_PROJECTS_DIR\"} {\npose-mcp/internal/cli/project_context.go:38:\texplicit, err := posemodel.ParseRootsJSON(os.Getenv(\"POSE_PROJECT_ROOTS\"))\npose-mcp/internal/cli/project_file_cli_test.go:31:\tt.Setenv(\"POSE_PROJECT_ROOTS\", \"\")\npose-mcp/internal/cli/project_file_cli_test.go:74:\tt.Setenv(\"POSE_PROJECT_ROOTS\", \"\")\n","exit_code":1,"status":"failed"}}
