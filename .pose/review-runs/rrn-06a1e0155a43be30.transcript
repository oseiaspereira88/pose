{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1470,1585p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '435,482p' pose-mcp/internal/pose/release_manifest_integrity.go; sed -n '900,1000p' pose-mcp/internal/pose/git_tree.go; nl -ba pose-mcp/internal/pose/kept_cache.go; rg -n 'federated-proof-reads-each-input-once|\\\"id\\\": \\\"(artifact-check|surface-check|validate)\\\"|\\\"structural|\\\"delta\\\"' .pose/review-bundles/rvb-f53880462209d2b9.json | head -35; git status --short\"","aggregated_output":"// materialSetDigestAt reads the head tree entries of every path a change set\n// names, and the validation matrix, and digests them (ADR\n// validation-evidence-binds-to-validated-material). Empty when the tree cannot\n// be read or the checkout is shallow: the set then carries the unreadable\n// marker and evidence is refused for it.\nfunc materialSetDigestAt(gitOutput func(int, ...string) ([]byte, error), root, head string, in posemodel.MaterialInputs) string {\n\tunreadable := posemodel.MaterialDigestUnreadable\n\tif shallow, err := repositoryIsShallow(gitOutput, root); err != nil || shallow {\n\t\treturn unreadable\n\t}\n\tnames := in.Names\n\ttree := map[string]posemodel.TreeEntry{}\n\tfor start := 0; start < len(names); start += 256 {\n\t\tend := min(start+256, len(names))\n\t\targs := []string{\"ls-tree\", \"-z\", head, \"--\"}\n\t\tfor _, name := range names[start:end] {\n\t\t\tif strings.ContainsAny(name, \"\\n\\x00\") {\n\t\t\t\treturn unreadable\n\t\t\t}\n\t\t\targs = append(args, \":(literal)\"+name)\n\t\t}\n\t\tout, err := gitOutput(8*1024*1024, args...)\n\t\tif err != nil {\n\t\t\treturn unreadable\n\t\t}\n\t\tfor _, record := range strings.Split(string(out), \"\\x00\") {\n\t\t\tif record == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tmeta, name, ok := strings.Cut(record, \"\\t\")\n\t\t\tfields := strings.Fields(meta)\n\t\t\tif !ok || len(fields) != 3 {\n\t\t\t\treturn unreadable\n\t\t\t}\n\t\t\ttree[name] = posemodel.TreeEntry{Mode: fields[0], Blob: fields[2]}\n\t\t}\n\t}\n\treturn posemodel.MaterialSetDigest(in, tree)\n}\n\nvar (\n\tshallowMu    sync.Mutex\n\tshallowCache = map[string]shallowEntry{}\n)\n\ntype shallowEntry struct {\n\tshallow bool\n\tmarker  string\n}\n\n// shallowMarker identifies the state of the shallow file of a plain checkout, so\n// a cached answer is dropped when the checkout is unshallowed or becomes shallow.\n// It is empty for a checkout whose .git is not a directory (a linked worktree):\n// that one is asked every time.\nfunc shallowMarker(root string) string {\n\tdir := filepath.Join(root, \".git\")\n\tif info, err := os.Stat(dir); err != nil || !info.IsDir() {\n\t\treturn \"\"\n\t}\n\tinfo, err := os.Stat(filepath.Join(dir, \"shallow\"))\n\tif err != nil {\n\t\treturn \"none\"\n\t}\n\treturn fmt.Sprintf(\"%d:%d\", info.Size(), info.ModTime().UnixNano())\n}\n\n// repositoryIsShallow reports whether the checkout lacks history. A shallow\n// checkout cannot establish that the head tree and the attributed commits\n// describe the same material, so it never binds evidence. The answer is reused\n// per root only while the checkout's shallow file is unchanged.\nfunc repositoryIsShallow(gitOutput func(int, ...string) ([]byte, error), root string) (bool, error) {\n\tmarker := shallowMarker(root)\n\tshallowMu.Lock()\n\tdefer shallowMu.Unlock()\n\tif entry, ok := shallowCache[root]; ok && marker != \"\" && entry.marker == marker {\n\t\treturn entry.shallow, nil\n\t}\n\tout, err := gitOutput(64, \"rev-parse\", \"--is-shallow-repository\")\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tvalue := strings.TrimSpace(string(out)) != \"false\"\n\tif marker != \"\" {\n\t\tshallowCache[root] = shallowEntry{shallow: value, marker: marker}\n\t}\n\treturn value, nil\n}\n\tannotated bool\n\terr       error\n}\n\nfunc gitOutput(root string, args ...string) (string, error) {\n\treturn gitOutputIn(root, nil, args...)\n}\n\n// gitOutputUntranslated runs git in the C locale, for the callers that read what git says: a\n// translated git words the same answer differently.\nfunc gitOutputUntranslated(root string, args ...string) (string, error) {\n\treturn gitOutputIn(root, []string{\"LC_ALL=C\"}, args...)\n}\n\nfunc gitOutputIn(root string, env []string, args ...string) (string, error) {\n\tcmd := RawHistoryGit(root, args...)\n\tif env != nil {\n\t\tcmd.Env = append(cmd.Env, env...)\n\t}\n\tvar stderr bytes.Buffer\n\tcmd.Stderr = &stderr\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\treturn \"\", &gitCommandError{Op: args[0], Stderr: strings.TrimSpace(stderr.String()), Err: err}\n\t}\n\tif strings.TrimSpace(stderr.String()) != \"\" {\n\t\treturn \"\", &gitCommandError{Op: args[0], Stderr: strings.TrimSpace(stderr.String()), Err: errors.New(\"Git reported an incomplete or uncertain result\")}\n\t}\n\treturn string(out), nil\n}\n\n// ListReleaseTags preserves warnings about broken refs as incomplete inventory.\n// Git may omit a broken loose tag while returning success; absence cannot be inferred.\nfunc ListReleaseTags(root string) (string, error) {\n\treturn gitOutput(root, \"tag\", \"--list\", \"v*\")\n}\n\n// gitTreeEntry looks one path up in a commit's tree. found=false with a nil error is the tree\n// proving the path is not there; any failure to read the tree is an error, never absence.\nfunc gitTreeEntry(root, commit, rel string) (mode, kind, object string, found bool, err error) {\n\tout, err := gitOutput(root, \"ls-tree\", \"-z\", commit, \"--\", rel)\n\tif err != nil {\n\t\treturn \"\", \"\", \"\", false, err\n\t}\n\tmeta, name, ok := strings.Cut(strings.TrimSuffix(out, \"\\x00\"), \"\\t\")\n\tfields := strings.Fields(meta)\n\tif !ok || len(fields) != 3 || name != rel {\n\t\tif strings.TrimSpace(out) != \"\" {\nsed: can't read pose-mcp/internal/pose/git_tree.go: No such file or directory\n     1\tpackage pose\n     2\t\n     3\timport \"sync\"\n     4\t\n     5\t// keptCache holds values computed from content-addressed inputs for the\n     6\t// process (spec pose-federated-proof-reads-each-input-once). A key is\n     7\t// computed once even when several callers miss it together: the first\n     8\t// computes, the others wait for it. A result the computation declines to\n     9\t// keep (a failed read) is not shared: the waiters acquire the key again.\n    10\t// Past its bound the kept values are dropped, for a long-running process;\n    11\t// a key being computed keeps its entry.\n    12\ttype keptCache[V any] struct {\n    13\t\tmu      sync.Mutex\n    14\t\tentries map[string]*keptEntry[V]\n    15\t\tbound   int\n    16\t}\n    17\t\n    18\ttype keptEntry[V any] struct {\n    19\t\tready chan struct{}\n    20\t\tvalue V\n    21\t\tkept  bool\n    22\t\tdone  bool\n    23\t}\n    24\t\n    25\tfunc newKeptCache[V any](bound int) *keptCache[V] {\n    26\t\treturn &keptCache[V]{entries: map[string]*keptEntry[V]{}, bound: bound}\n    27\t}\n    28\t\n    29\t// get returns the kept value of key, or computes it; compute reports whether\n    30\t// its result may be kept. A caller that waited for a result that was not\n    31\t// kept acquires the key again, so a recovered read is computed once and\n    32\t// shared (review round 2, N1).\n    33\tfunc (c *keptCache[V]) get(key string, compute func() (V, bool)) V {\n    34\t\tfor {\n    35\t\t\tc.mu.Lock()\n    36\t\t\tif entry, ok := c.entries[key]; ok {\n    37\t\t\t\tc.mu.Unlock()\n    38\t\t\t\t<-entry.ready\n    39\t\t\t\tif entry.kept {\n    40\t\t\t\t\treturn entry.value\n    41\t\t\t\t}\n    42\t\t\t\tcontinue\n    43\t\t\t}\n    44\t\t\tc.evictLocked()\n    45\t\t\tentry := &keptEntry[V]{ready: make(chan struct{})}\n    46\t\t\tc.entries[key] = entry\n    47\t\t\tc.mu.Unlock()\n    48\t\t\tvalue, keep := compute()\n    49\t\t\tc.mu.Lock()\n    50\t\t\tentry.value, entry.kept, entry.done = value, keep, true\n    51\t\t\tif !keep && c.entries[key] == entry {\n    52\t\t\t\tdelete(c.entries, key)\n    53\t\t\t}\n    54\t\t\tc.mu.Unlock()\n    55\t\t\tclose(entry.ready)\n    56\t\t\treturn value\n    57\t\t}\n    58\t}\n    59\t\n    60\t// evictLocked drops the kept values once the bound is reached; a key still\n    61\t// being computed keeps its entry, so its waiters and a later caller never\n    62\t// compute it twice (review round 2, N2).\n    63\tfunc (c *keptCache[V]) evictLocked() {\n    64\t\tif len(c.entries) < c.bound {\n    65\t\t\treturn\n    66\t\t}\n    67\t\tfor key, entry := range c.entries {\n    68\t\t\tif entry.done {\n    69\t\t\t\tdelete(c.entries, key)\n    70\t\t\t}\n    71\t\t}\n    72\t}\n    73\t\n    74\tfunc (c *keptCache[V]) clear() {\n    75\t\tc.mu.Lock()\n    76\t\tc.entries = map[string]*keptEntry[V]{}\n    77\t\tc.mu.Unlock()\n    78\t}\n    79\t\n    80\tfunc (c *keptCache[V]) len() int {\n    81\t\tc.mu.Lock()\n    82\t\tdefer c.mu.Unlock()\n    83\t\treturn len(c.entries)\n    84\t}\n9:      \"ref\": \"spec:pose-federated-proof-reads-each-input-once\",\n11:      \"slug\": \"pose-federated-proof-reads-each-input-once\",\n16:        \"capability:federated-proof-reads-each-input-once\"\n57:          \"path\": \".pose/starts/pose-federated-proof-reads-each-input-once.json\",\n153:          \"path\": \".pose/starts/pose-federated-proof-reads-each-input-once.json\",\n281:            \"artifact:pose-federated-proof-reads-each-input-once:pose-mcp/internal/cli/material_engine.go\",\n282:            \"artifact:pose-federated-proof-reads-each-input-once:pose-mcp/internal/pose/current_material_cache_test.go\",\n283:            \"artifact:pose-federated-proof-reads-each-input-once:pose-mcp/internal/pose/kept_cache.go\",\n284:            \"artifact:pose-federated-proof-reads-each-input-once:pose-mcp/internal/pose/kept_cache_test.go\",\n285:            \"artifact:pose-federated-proof-reads-each-input-once:pose-mcp/internal/pose/material_binding.go\",\n286:            \"artifact:pose-federated-proof-reads-each-input-once:pose-mcp/int