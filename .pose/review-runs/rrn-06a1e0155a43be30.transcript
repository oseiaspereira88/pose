{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '255,279p' pose-mcp/internal/cli/index.go; cat pose-mcp/internal/cli/sealed_checkout_refresh_test.go; rg -n 'ReadOnly|SealedCheckout|sealedCheckout' pose-mcp/internal/pose pose-mcp/internal/cli/index.go | head -20; git status --short\"","aggregated_output":"// refreshDeliveryIndex publishes a recomputed delivery graph. When the indexes were\n// published as a generation it replaces that file in a new generation, so the\n// descriptor keeps describing the set; before the first `pose index` there is no\n// generation and the file is written as it always was. A set that cannot be\n// verified is not written over: the failure is said, not hidden.\nfunc refreshDeliveryIndex(root string, data []byte, stderr io.Writer) {\n\tif posepkg.IsSealedCheckout(root) {\n\t\treturn\n\t}\n\t_ = os.MkdirAll(filepath.Join(root, \".pose\", \"indexes\"), 0o755)\n\treceipt, _, err := posepkg.Store{Root: root}.ReplaceIndexOrLegacy(\"delivery-integrity.json\", data)\n\tswitch {\n\tcase err == nil:\n\t\tif receipt.CleanupError != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose: retention of old index generations failed: \" + receipt.CleanupError.Error())\n\t\t}\n\tcase receipt.Committed:\n\t\trender(io.Discard, stderr).Failure(\"pose: the delivery index was published as generation \" + receipt.GenerationID + \", but its durability could not be confirmed: \" + err.Error() + \"; run `pose index --verify`\")\n\tdefault:\n\t\trender(io.Discard, stderr).Failure(\"pose: the delivery index was not refreshed: \" + err.Error() + \"; run `pose index`\")\n\t}\n}\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n\n\tposepkg \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\n// A diagnostic run inside a sealed review checkout leaves the delivery index as\n// sealed; outside one it publishes as before (spec\n// pose-validation-evidence-material-binding R7).\nfunc TestRefreshDeliveryIndexLeavesASealedCheckoutAlone(t *testing.T) {\n\troot := t.TempDir()\n\tother := t.TempDir()\n\ttarget := filepath.Join(root, \".pose\", \"indexes\", \"delivery-integrity.json\")\n\tt.Setenv(posepkg.SealedCheckoutEnv, root)\n\tvar stderr bytes.Buffer\n\trefreshDeliveryIndex(root, []byte(\"{}\\n\"), &stderr)\n\tif _, err := os.Stat(target); err == nil {\n\t\tt.Fatal(\"a sealed checkout was written\")\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".pose\", \"indexes\")); err == nil {\n\t\tt.Fatal(\"a sealed checkout gained a directory\")\n\t}\n\t// Another project the same process works in is not the sealed checkout.\n\trefreshDeliveryIndex(other, []byte(\"{}\\n\"), &stderr)\n\tif _, err := os.Stat(filepath.Join(other, \".pose\", \"indexes\", \"delivery-integrity.json\")); err != nil {\n\t\tt.Fatalf(\"a fixture was mistaken for the sealed checkout: %v\", err)\n\t}\n\tt.Setenv(posepkg.SealedCheckoutEnv, \"\")\n\trefreshDeliveryIndex(root, []byte(\"{}\\n\"), &stderr)\n\tif _, err := os.Stat(target); err != nil {\n\t\tt.Fatalf(\"outside a sealed checkout the index is published as before: %v\", err)\n\t}\n}\npose-mcp/internal/cli/index.go:261:\tif posepkg.IsSealedCheckout(root) {\npose-mcp/internal/pose/review_brief_conclusion_rules_test.go:77:func TestTheClaudeReviewerProfileAllowsOnlyReadOnlyCommands(t *testing.T) {\npose-mcp/internal/pose/delegation_refusal.go:28:// SealedCheckoutEnv marks a process a delegated review launched in its sealed\npose-mcp/internal/pose/delegation_refusal.go:32:const SealedCheckoutEnv = \"POSE_SEALED_CHECKOUT\"\npose-mcp/internal/pose/delegation_refusal.go:34:// IsSealedCheckout reports whether root is the sealed checkout the environment\npose-mcp/internal/pose/delegation_refusal.go:37:func IsSealedCheckout(root string) bool {\npose-mcp/internal/pose/delegation_refusal.go:38:\tsealed := os.Getenv(SealedCheckoutEnv)\npose-mcp/internal/pose/review_plan_test.go:443:func TestReviewPlanSchemaV1RemainsGenericAndResolutionIsReadOnly(t *testing.T) {\npose-mcp/internal/pose/start_test.go:45:func TestABMAtomicStartPreviewIsReadOnlyAndDigestBound(t *testing.T) {\npose-mcp/internal/pose/spec_facts_binding_test.go:227:func TestFactsAreStableAndReadOnly(t *testing.T) {\npose-mcp/internal/pose/obligation_projection_test.go:62:func TestProjectionIsReadOnlyAndNavigableToItsSource(t *testing.T) {\npose-mcp/internal/pose/checkout_blockers_child_evidence_test.go:9:func TestTheSealedCheckoutIsNotBlockedByChildEvidenceItCannotHold(t *testing.T) {\npose-mcp/internal/pose/spec_transfer_test.go:104:func TestSpecTransferPreviewIsDeterministicAndReadOnly(t *testing.T) {\npose-mcp/internal/pose/review_dispatch.go:931:\t// publish derived records into it (SealedCheckoutEnv).\npose-mcp/internal/pose/review_dispatch.go:932:\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\npose-mcp/internal/pose/common_operation.go:40:\tRouteReadOnlyPlan    RouteClass = \"read-only-planning\"\npose-mcp/internal/pose/review_read_view_retention_test.go:119:func TestLegacyDoneCloseoutRemainsReadOnlyTerminalWhenHeadIsUnavailable(t *testing.T) {\n","exit_code":0,"status":"completed"}}
