{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_active.go | sed -n '1,330p' && nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '1,230p' && nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '300,500p' && nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '140,210p;930,1065p;1440,1525p' && nl -ba pose-mcp/internal/cli/delegate.go | sed -n '850,960p;1090,1175p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Active delegated runs and cancellation (spec pose-delegation-surface R13).\n     4\t//\n     5\t// A run's record is written when it ends, so a running run is known only by a\n     6\t// private marker its process writes when the attempt starts and removes when\n     7\t// the record is published. The marker names the process the way a start lock\n     8\t// does, so a reader can tell a running owner from a dead one. Cancelling\n     9\t// writes a request beside the marker; the running process watches for it,\n    10\t// stops the agent and records the run failed with the cause cancelled. The\n    11\t// attempt stays consumed: cancelling never returns budget.\n    12\t\n    13\timport (\n    14\t\t\"context\"\n    15\t\t\"crypto/rand\"\n    16\t\t\"encoding/hex\"\n    17\t\t\"encoding/json\"\n    18\t\t\"errors\"\n    19\t\t\"fmt\"\n    20\t\t\"os\"\n    21\t\t\"path/filepath\"\n    22\t\t\"sort\"\n    23\t\t\"strings\"\n    24\t\t\"sync\"\n    25\t\t\"sync/atomic\"\n    26\t\t\"time\"\n    27\t)\n    28\t\n    29\tconst delegationActiveDir = reviewPrivateDir + \"/active\"\n    30\t\n    31\t// DelegationActiveRun is the marker of a run in progress.\n    32\ttype DelegationActiveRun struct {\n    33\t\tSchemaVersion int    `json:\"schema_version\"`\n    34\t\tAttemptID     string `json:\"attempt_id\"`\n    35\t\t// RunToken names this run of the attempt: a cancellation request carries\n    36\t\t// it, so a request meant for one run never stops another.\n    37\t\tRunToken  string         `json:\"run_token\"`\n    38\t\tResumes   string         `json:\"resumes,omitempty\"`\n    39\t\tLabel     string         `json:\"label,omitempty\"`\n    40\t\tPurpose   string         `json:\"purpose\"`\n    41\t\tAgent     string         `json:\"agent\"`\n    42\t\tScope     string         `json:\"scope\"`\n    43\t\tBundleID  string         `json:\"bundle_id\"`\n    44\t\tStartedAt string         `json:\"started_at\"`\n    45\t\tOwner     StartLockOwner `json:\"owner\"`\n    46\t\t// HeartbeatAt is rewritten every HeartbeatEvery seconds by the process\n    47\t\t// that runs the attempt (spec pose-delegated-review-completion-signal R4,\n    48\t\t// D2).\n    49\t\tHeartbeatAt    string `json:\"heartbeat_at,omitempty\"`\n    50\t\tHeartbeatEvery int    `json:\"heartbeat_every,omitempty\"`\n    51\t\t// StalledAt is computed by the reader from the stall claim the first\n    52\t\t// reader that found the run stalled published.\n    53\t\tStalledAt string `json:\"stalled_at,omitempty\"`\n    54\t\t// Liveness is computed by the reader: owner-active, owner-dead or owner-unknown.\n    55\t\tLiveness string `json:\"liveness,omitempty\"`\n    56\t\tDetail   string `json:\"detail,omitempty\"`\n    57\t\t// CancelRequested is computed by the reader.\n    58\t\tCancelRequested bool `json:\"cancel_requested,omitempty\"`\n    59\t\t// Round is the review round the run reviews (spec\n    60\t\t// pose-delegated-review-round-protocol R1).\n    61\t\tRound int `json:\"round,omitempty\"`\n    62\t}\n    63\t\n    64\tfunc (s Store) delegationActiveDir(create bool) (string, error) {\n    65\t\tif create {\n    66\t\t\tif _, err := ensureReviewArtifactDir(s.Root, reviewPrivateDir, true); err != nil {\n    67\t\t\t\treturn \"\", err\n    68\t\t\t}\n    69\t\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewPrivateDir))\n    70\t\t\tignore := filepath.Join(dir, \".gitignore\")\n    71\t\t\tif _, err := os.Lstat(ignore); errors.Is(err, os.ErrNotExist) {\n    72\t\t\t\tif err := PublishFile(ignore, []byte(\"*\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil && !errors.Is(err, os.ErrExist) {\n    73\t\t\t\t\treturn \"\", err\n    74\t\t\t\t}\n    75\t\t\t}\n    76\t\t}\n    77\t\treturn ensureReviewArtifactDir(s.Root, delegationActiveDir, create)\n    78\t}\n    79\t\n    80\tfunc validAttemptFileName(attempt string) bool {\n    81\t\treturn attempt != \"\" && len(attempt) <= 128 && !strings.ContainsAny(attempt, `/\\.`+\"\\x00\")\n    82\t}\n    83\t\n    84\t// markDelegationActive writes the marker and starts the cancellation watcher.\n    85\t// The returned stop removes both; cancelled reports whether a cancellation\n    86\t// request stopped the run.\n    87\t//\n    88\t// stop(true) stops the watcher and the heartbeat but keeps the marker: a run\n    89\t// whose record was not published leaves it, and it turns stalled once its\n    90\t// process is gone (spec pose-delegated-review-completion-signal R4, R5).\n    91\tfunc (s Store) markDelegationActive(run ReviewRun, cancel context.CancelFunc) (stop func(keepMarker ...bool), cancelled *atomic.Bool, err error) {\n    92\t\tcancelled = &atomic.Bool{}\n    93\t\tif !validAttemptFileName(run.AttemptID) {\n    94\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: attempt %q cannot name an active marker\", run.AttemptID)\n    95\t\t}\n    96\t\tdir, err := s.delegationActiveDir(true)\n    97\t\tif err != nil {\n    98\t\t\treturn func(...bool) {}, cancelled, err\n    99\t\t}\n   100\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + run.AttemptID, Worktree: s.Root, Operation: \"pose delegate \" + run.Purpose, PID: os.Getpid(), AcquiredAt: run.StartedAt}\n   101\t\towner.Host, _ = os.Hostname()\n   102\t\tidentifyStartLockProcess(&owner)\n   103\t\ttoken := make([]byte, 16)\n   104\t\tif _, err := rand.Read(token); err != nil {\n   105\t\t\treturn func(...bool) {}, cancelled, err\n   106\t\t}\n   107\t\tevery := delegationHeartbeatEvery\n   108\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: run.AttemptID, RunToken: hex.EncodeToString(token), Resumes: run.Resumes, Label: run.Label, Purpose: run.Purpose, Agent: run.Adapter, Scope: run.Scope, BundleID: run.BundleID, StartedAt: run.StartedAt, Owner: owner, Round: run.Round,\n   109\t\t\tHeartbeatAt: time.Now().UTC().Format(time.RFC3339Nano), HeartbeatEvery: int(every / time.Second)}\n   110\t\traw, _ := json.MarshalIndent(marker, \"\", \"  \")\n   111\t\tpath := filepath.Join(dir, run.AttemptID+\".json\")\n   112\t\trequest := cancelRequestPath(dir, marker)\n   113\t\tif err := PublishFile(path, append(raw, '\\n'), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n   114\t\t\treturn func(...bool) {}, cancelled, fmt.Errorf(\"pose: another run of attempt %s is active: %w\", run.AttemptID, err)\n   115\t\t}\n   116\t\tdone, exited := make(chan struct{}), make(chan struct{})\n   117\t\tgo func() {\n   118\t\t\tdefer close(exited)\n   119\t\t\tticker := time.NewTicker(250 * time.Millisecond)\n   120\t\t\tdefer ticker.Stop()\n   121\t\t\theartbeat := time.NewTicker(every)\n   122\t\t\tdefer heartbeat.Stop()\n   123\t\t\tfor {\n   124\t\t\t\tselect {\n   125\t\t\t\tcase <-done:\n   126\t\t\t\t\treturn\n   127\t\t\t\tcase <-heartbeat.C:\n   128\t\t\t\t\t// Select picks among ready cases at random: once stop has\n   129\t\t\t\t\t// asked, no further heartbeat starts, so it waits for at\n   130\t\t\t\t\t// most the one in flight (review round 1, HB01).\n   131\t\t\t\t\tselect {\n   132\t\t\t\t\tcase <-done:\n   133\t\t\t\t\t\treturn\n   134\t\t\t\t\tdefault:\n   135\t\t\t\t\t}\n   136\t\t\t\t\tbeatDelegationMarker(path, marker.RunToken)\n   137\t\t\t\tcase <-ticker.C:\n   138\t\t\t\t\tif _, err := os.Lstat(request); err == nil {\n   139\t\t\t\t\t\tcancelled.Store(true)\n   140\t\t\t\t\t\tcancel()\n   141\t\t\t\t\t\treturn\n   142\t\t\t\t\t}\n   143\t\t\t\t}\n   144\t\t\t}\n   145\t\t}()\n   146\t\tvar once sync.Once\n   147\t\tstop = func(keepMarker ...bool) {\n   148\t\t\tonce.Do(func() {\n   149\t\t\t\tclose(done)\n   150\t\t\t\tdelegationStopRequested()\n   151\t\t\t\t// A heartbeat in flight finishes before the marker goes, so it\n   152\t\t\t\t// cannot rename a new one into place after the removal (spec\n   153\t\t\t\t// pose-delegation-marker-stop-joins-heartbeat R1).\n   154\t\t\t\t<-exited\n   155\t\t\t\t_ = os.Remove(request)\n   156\t\t\t\tif len(keepMarker) == 0 || !keepMarker[0] {\n   157\t\t\t\t\t_ = os.Remove(path)\n   158\t\t\t\t}\n   159\t\t\t})\n   160\t\t}\n   161\t\treturn stop, cancelled, nil\n   162\t}\n   163\t\n   164\t// delegationStopRequested is a test seam called once stop has asked the\n   165\t// watcher to end, before it waits for it.\n   166\tvar delegationStopRequested = func() {}\n   167\t\n   168\t// delegationHeartbeatEvery is the interval a running attempt declares.\n   169\tvar delegationHeartbeatEvery = 10 * time.Second\n   170\t\n   171\t// beatDelegationMarker rewrites the heartbeat of the marker run token names,\n   172\t// by compare-and-swap: a marker already recorded stalled, or replaced by\n   173\t// another run, is left as it is.\n   174\tfunc beatDelegationMarker(path, token string) {\n   175\t\traw, err := readLedgerRaw(path)\n   176\t\tif err != nil {\n   177\t\t\treturn\n   178\t\t}\n   179\t\tvar marker DelegationActiveRun\n   180\t\tif json.Unmarshal(raw, &marker) != nil || marker.RunToken != token {\n   181\t\t\treturn\n   182\t\t}\n   183\t\tmarker.HeartbeatAt = time.Now().UTC().Format(time.RFC3339Nano)\n   184\t\tnext, _ := json.MarshalIndent(marker, \"\", \"  \")\n   185\t\t_ = PublishFile(path, append(next, '\\n'), 0600, PublishAuthoritative, ExpectBytes(raw, true))\n   186\t}\n   187\t\n   188\t// delegationMarkerSilent reports a heartbeat older than three intervals.\n   189\tfunc delegationMarkerSilent(marker DelegationActiveRun, now time.Time) bool {\n   190\t\tevery := time.Duration(marker.HeartbeatEvery) * time.Second\n   191\t\tif every <= 0 {\n   192\t\t\tevery = delegationHeartbeatEvery\n   193\t\t}\n   194\t\tlast := marker.HeartbeatAt\n   195\t\tif last == \"\" {\n   196\t\t\tlast = marker.StartedAt\n   197\t\t}\n   198\t\tat, err := time.Parse(time.RFC3339Nano, last)\n   199\t\treturn err == nil && now.Sub(at) > 3*every\n   200\t}\n   201\t\n   202\t// stallClaimPath names the claim that records a run stalled.\n   203\tfunc stallClaimPath(dir string, marker DelegationActiveRun) string {\n   204\t\treturn filepath.Join(dir, marker.AttemptID+\".\"+marker.RunToken+\".stalled\")\n   205\t}\n   206\t\n   207\tfunc readDelegationStall(dir string, marker DelegationActiveRun) string {\n   208\t\traw, err := readLedgerRaw(stallClaimPath(dir, marker))\n   209\t\tif err != nil {\n   210\t\t\treturn \"\"\n   211\t\t}\n   212\t\treturn strings.TrimSpace(string(raw))\n   213\t}\n   214\t\n   215\t// recordDelegationStall publishes the stall claim exclusively: the first\n   216\t// reader's instant is the one every reader returns, so concurrent readers\n   217\t// agree (R4).\n   218\tfunc recordDelegationStall(dir string, marker DelegationActiveRun) string {\n   219\t\tat := time.Now().UTC().Format(time.RFC3339Nano)\n   220\t\t_ = PublishFile(stallClaimPath(dir, marker), []byte(at+\"\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n   221\t\treturn readDelegationStall(dir, marker)\n   222\t}\n   223\t\n   224\tfunc cancelRequestPath(dir string, marker DelegationActiveRun) string {\n   225\t\treturn filepath.Join(dir, marker.AttemptID+\".\"+marker.RunToken+\".cancel\")\n   226\t}\n   227\t\n   228\tfunc validRunToken(token string) bool {\n   229\t\tif len(token) != 32 {\n   230\t\t\treturn false\n   231\t\t}\n   232\t\t_, err := hex.DecodeString(token)\n   233\t\treturn err == nil\n   234\t}\n   235\t\n   236\t// ListDelegationActive reads the markers with the liveness of their owners,\n   237\t// and returns as losses the markers it cannot read: a run it cannot observe is\n   238\t// reported, never listed as running nor left out in silence.\n   239\tfunc (s Store) ListDelegationActive() ([]DelegationActiveRun, []string, error) {\n   240\t\tdir, err := s.delegationActiveDir(false)\n   241\t\tif errors.Is(err, os.ErrNotExist) {\n   242\t\t\treturn []DelegationActiveRun{}, nil, nil\n   243\t\t}\n   244\t\tif err != nil {\n   245\t\t\treturn nil, nil, err\n   246\t\t}\n   247\t\tentries, err := os.ReadDir(dir)\n   248\t\tif err != nil {\n   249\t\t\treturn nil, nil, err\n   250\t\t}\n   251\t\tout := []DelegationActiveRun{}\n   252\t\tvar lost []string\n   253\t\tfor _, e := range entries {\n   254\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   255\t\t\t\tcontinue\n   256\t\t\t}\n   257\t\t\traw, err := readLedgerRaw(filepath.Join(dir, e.Name()))\n   258\t\t\tif errors.Is(err, os.ErrNotExist) {\n   259\t\t\t\tcontinue // the run ended between the listing and the read\n   260\t\t\t}\n   261\t\t\tif err != nil {\n   262\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" could not be read: \"+err.Error())\n   263\t\t\t\tcontinue\n   264\t\t\t}\n   265\t\t\tvar marker DelegationActiveRun\n   266\t\t\tif json.Unmarshal(raw, &marker) != nil || marker.SchemaVersion != 1 || marker.AttemptID+\".json\" != e.Name() || !validRunToken(marker.RunToken) {\n   267\t\t\t\tlost = append(lost, \"the active run marker \"+e.Name()+\" is not one this engine reads\")\n   268\t\t\t\tcontinue\n   269\t\t\t}\n   270\t\t\tmarker.Liveness, marker.Detail = probeStartLockOwner(marker.Owner)\n   271\t\t\tmarker.StalledAt = readDelegationStall(dir, marker)\n   272\t\t\tif marker.StalledAt == \"\" && delegationMarkerSilent(marker, time.Now()) && marker.Liveness == LockOwnerDead {\n   273\t\t\t\tmarker.StalledAt = recordDelegationStall(dir, marker)\n   274\t\t\t}\n   275\t\t\tif _, err := os.Lstat(cancelRequestPath(dir, marker)); err == nil {\n   276\t\t\t\tmarker.CancelRequested = true\n   277\t\t\t}\n   278\t\t\tout = append(out, marker)\n   279\t\t}\n   280\t\tsort.Slice(out, func(i, j int) bool {\n   281\t\t\treturn out[i].StartedAt < out[j].StartedAt || out[i].StartedAt == out[j].StartedAt && out[i].AttemptID < out[j].AttemptID\n   282\t\t})\n   283\t\treturn out, lost, nil\n   284\t}\n   285\t\n   286\t// ErrDelegationNotActive means no running run matches.\n   287\tvar ErrDelegationNotActive = errors.New(\"pose: the run is not running\")\n   288\t\n   289\t// RequestDelegationCancel asks the process running attempt to stop. A marker\n   290\t// whose owner is proven dead is not cancelled: nothing runs to stop.\n   291\tfunc (s Store) RequestDelegationCancel(attempt string) (DelegationActiveRun, error) {\n   292\t\tactive, _, err := s.ListDelegationActive()\n   293\t\tif err != nil {\n   294\t\t\treturn DelegationActiveRun{}, err\n   295\t\t}\n   296\t\tfor _, marker := range active {\n   297\t\t\tif marker.AttemptID != attempt {\n   298\t\t\t\tcontinue\n   299\t\t\t}\n   300\t\t\tif marker.Liveness == LockOwnerDead {\n   301\t\t\t\treturn marker, fmt.Errorf(\"pose: the process of attempt %s is gone (%s); nothing runs to cancel\", attempt, marker.Detail)\n   302\t\t\t}\n   303\t\t\tdir, err := s.delegationActiveDir(false)\n   304\t\t\tif err != nil {\n   305\t\t\t\treturn marker, err\n   306\t\t\t}\n   307\t\t\trequest := cancelRequestPath(dir, marker)\n   308\t\t\tif err := PublishFile(request, []byte(time.Now().UTC().Format(time.RFC3339Nano)+\"\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil && !errors.Is(err, os.ErrExist) {\n   309\t\t\t\tif _, statErr := os.Lstat(request); statErr != nil {\n   310\t\t\t\t\treturn marker, err\n   311\t\t\t\t}\n   312\t\t\t}\n   313\t\t\t// The run may have ended between the read and the request: a request\n   314\t\t\t// that names no running run is withdrawn, never left for a successor.\n   315\t\t\tif !s.DelegationRunActive(marker) {\n   316\t\t\t\t_ = os.Remove(request)\n   317\t\t\t\treturn marker, ErrDelegationNotActive\n   318\t\t\t}\n   319\t\t\tmarker.CancelRequested = true\n   320\t\t\treturn marker, nil\n   321\t\t}\n   322\t\treturn DelegationActiveRun{}, ErrDelegationNotActive\n   323\t}\n   324\t\n   325\t// DelegationRunActive reports whether the run marker names is still the\n   326\t// running run of its attempt.\n   327\tfunc (s Store) DelegationRunActive(marker DelegationActiveRun) bool {\n   328\t\tdir, err := s.delegationActiveDir(false)\n   329\t\tif err != nil {\n   330\t\t\treturn false\n     1\tpackage pose\n     2\t\n     3\t// Listing and naming delegated runs (spec pose-delegation-surface R11, and the\n     4\t// listing pose-delegated-review-completion-signal extends).\n     5\t//\n     6\t// A person and an agent follow a task, not a process: an attempt and its\n     7\t// continuations are one row, shown by their latest run. A reference names a\n     8\t// row by attempt, by any of its runs, by label or by a prefix of its session.\n     9\t\n    10\timport (\n    11\t\t\"fmt\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t)\n    16\t\n    17\t// DelegationAttempt is one attempt and its continuations.\n    18\ttype DelegationAttempt struct {\n    19\t\tAttemptID    string              `json:\"attempt_id\"`\n    20\t\tRuns         []string            `json:\"runs\"`\n    21\t\tLatestRun    string              `json:\"latest_run,omitempty\"`\n    22\t\tState        string              `json:\"state\"`\n    23\t\tPurpose      string              `json:\"purpose\"`\n    24\t\tAgent        string              `json:\"agent\"`\n    25\t\tVendor       string              `json:\"vendor,omitempty\"`\n    26\t\tModel        string              `json:\"model,omitempty\"`\n    27\t\tLabel        string              `json:\"label,omitempty\"`\n    28\t\tLead         string              `json:\"lead,omitempty\"`\n    29\t\tAccess       string              `json:\"access\"`\n    30\t\tScope        string              `json:\"scope\"`\n    31\t\tBundleID     string              `json:\"bundle_id\"`\n    32\t\tStartedAt    string              `json:\"started_at\"`\n    33\t\tEndedAt      string              `json:\"ended_at,omitempty\"`\n    34\t\tTurns        int                 `json:\"turns\"`\n    35\t\tLastStep     string              `json:\"last_step,omitempty\"`\n    36\t\tFailure      string              `json:\"failure,omitempty\"`\n    37\t\tInterruption *ReviewInterruption `json:\"interruption,omitempty\"`\n    38\t\t// Partial says an interrupted run kept a partial draft; TimeLeft is the\n    39\t\t// wait until its recorded reset, when there is one.\n    40\t\tPartial         bool   `json:\"partial,omitempty\"`\n    41\t\tTimeLeft        string `json:\"time_left,omitempty\"`\n    42\t\tActive          bool   `json:\"active\"`\n    43\t\tLiveness        string `json:\"liveness,omitempty\"`\n    44\t\tCancelRequested bool   `json:\"cancel_requested,omitempty\"`\n    45\t\t// HeartbeatAge is how long ago the running process last beat; a stalled\n    46\t\t// run is not active (spec pose-delegated-review-completion-signal R4, R6).\n    47\t\tHeartbeatAge string `json:\"heartbeat_age,omitempty\"`\n    48\t\tStalledAt    string `json:\"stalled_at,omitempty\"`\n    49\t\t// HookFailure is why the latest run's on_terminal hook failed (R7).\n    50\t\tHookFailure string `json:\"hook_failure,omitempty\"`\n    51\t\t// Round is the review round of the scope the latest run reviewed (spec\n    52\t\t// pose-delegated-review-round-protocol R1).\n    53\t\tRound    int `json:\"round,omitempty\"`\n    54\t\tsessions []string\n    55\t\tlatest   *ReviewRun\n    56\t}\n    57\t\n    58\t// Latest is the latest recorded run of the attempt, if any.\n    59\tfunc (a DelegationAttempt) Latest() *ReviewRun { return a.latest }\n    60\t\n    61\t// DelegationRunning is the state of an attempt whose process is still there;\n    62\t// DelegationStalled, of one whose process is gone without a record.\n    63\tconst (\n    64\t\tDelegationRunning = \"running\"\n    65\t\tDelegationStalled = \"stalled\"\n    66\t)\n    67\t\n    68\t// ListDelegationAttempts groups every recorded run by attempt, adds the runs\n    69\t// in progress, and returns the losses the run history reports.\n    70\tfunc (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n    71\t\t// The markers are read before the runs: a run publishes its record before\n    72\t\t// it removes its marker, so a reader that finds no marker for an attempt\n    73\t\t// it saw running finds its record (spec\n    74\t\t// pose-delegated-review-completion-signal R5).\n    75\t\tactive, activeLost, activeErr := s.ListDelegationActive()\n    76\t\truns, lost, err := s.ReadReviewRuns(\"\")\n    77\t\tif err != nil {\n    78\t\t\treturn nil, nil, err\n    79\t\t}\n    80\t\t// Task runs share the lifecycle, never the review history (spec\n    81\t\t// pose-delegation-task R7, R8).\n    82\t\ttasks, taskLost := s.ReadDelegationTaskRuns()\n    83\t\truns, lost = append(runs, tasks...), append(lost, taskLost...)\n    84\t\tbyAttempt := map[string]*DelegationAttempt{}\n    85\t\torder := []string{}\n    86\t\tfor i := range runs {\n    87\t\t\trun := runs[i]\n    88\t\t\tkey := run.AttemptID\n    89\t\t\tif key == \"\" {\n    90\t\t\t\tkey = run.RunID // a run recorded before attempts existed is its own attempt\n    91\t\t\t}\n    92\t\t\trow, ok := byAttempt[key]\n    93\t\t\tif !ok {\n    94\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    95\t\t\t\tbyAttempt[key] = row\n    96\t\t\t\torder = append(order, key)\n    97\t\t\t}\n    98\t\t\trow.Runs = append(row.Runs, run.RunID)\n    99\t\t\trow.latest = &runs[i]\n   100\t\t\tif run.SessionDigest != \"\" {\n   101\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   102\t\t\t\t\trow.sessions = append(row.sessions, value)\n   103\t\t\t\t}\n   104\t\t\t}\n   105\t\t\tevents, err := s.ReadDelegationEvents(run)\n   106\t\t\tif err != nil {\n   107\t\t\t\t// A turn count read from nothing would report a whole history.\n   108\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   109\t\t\t} else {\n   110\t\t\t\tfor _, e := range events {\n   111\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   112\t\t\t\t\t\trow.Turns++\n   113\t\t\t\t\t}\n   114\t\t\t\t}\n   115\t\t\t\tif len(events) > 0 {\n   116\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   117\t\t\t\t}\n   118\t\t\t}\n   119\t\t}\n   120\t\tfor _, key := range order {\n   121\t\t\trow := byAttempt[key]\n   122\t\t\tlatest := row.latest\n   123\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   124\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   125\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   126\t\t\tif latest.Access != \"\" {\n   127\t\t\t\trow.Access = latest.Access\n   128\t\t\t}\n   129\t\t\trow.Round = latest.Round\n   130\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   131\t\t\t\trow.HookFailure = hook.Failure\n   132\t\t\t}\n   133\t\t\tif row.Purpose == \"\" {\n   134\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   135\t\t\t}\n   136\t\t\tif latest.Status == ReviewRunInterrupted {\n   137\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   138\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   139\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   140\t\t\t\t\t\tleft := time.Until(at)\n   141\t\t\t\t\t\tif left < 0 {\n   142\t\t\t\t\t\t\tleft = 0\n   143\t\t\t\t\t\t}\n   144\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   145\t\t\t\t\t}\n   146\t\t\t\t}\n   147\t\t\t}\n   148\t\t}\n   149\t\tif activeErr != nil {\n   150\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   151\t\t}\n   152\t\tlost = append(lost, activeLost...)\n   153\t\tfor _, marker := range active {\n   154\t\t\trow, ok := byAttempt[marker.AttemptID]\n   155\t\t\tif !ok {\n   156\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   157\t\t\t\tbyAttempt[marker.AttemptID] = row\n   158\t\t\t\torder = append(order, marker.AttemptID)\n   159\t\t\t}\n   160\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   161\t\t\tif marker.Round > 0 {\n   162\t\t\t\trow.Round = marker.Round\n   163\t\t\t}\n   164\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   165\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   166\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   167\t\t\t}\n   168\t\t\tif marker.StalledAt != \"\" {\n   169\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   170\t\t\t}\n   171\t\t\t// A running run's progress comes from its live events (R12).\n   172\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   173\t\t\t\tfor _, e := range live {\n   174\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   175\t\t\t\t\t\trow.Turns++\n   176\t\t\t\t\t}\n   177\t\t\t\t}\n   178\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   179\t\t\t}\n   180\t\t}\n   181\t\tout := make([]DelegationAttempt, 0, len(order))\n   182\t\tfor _, key := range order {\n   183\t\t\tout = append(out, *byAttempt[key])\n   184\t\t}\n   185\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   186\t\treturn out, lost, nil\n   187\t}\n   188\t\n   189\tfunc delegationStepText(e DelegationEvent) string {\n   190\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   191\t\tif len(text) > 80 {\n   192\t\t\tcut := 77\n   193\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   194\t\t\t\tcut--\n   195\t\t\t}\n   196\t\t\ttext = text[:cut] + \"...\"\n   197\t\t}\n   198\t\tswitch e.Kind {\n   199\t\tcase DelegationEventToolCall:\n   200\t\t\treturn \"▶ \" + text\n   201\t\tcase DelegationEventToolOutput:\n   202\t\t\tif e.ExitCode != nil && *e.ExitCode != 0 {\n   203\t\t\t\treturn fmt.Sprintf(\"✗ exit %d\", *e.ExitCode)\n   204\t\t\t}\n   205\t\t\treturn \"✓ exit 0\"\n   206\t\tcase DelegationEventTurn:\n   207\t\t\treturn \"turn\"\n   208\t\t}\n   209\t\tif text == \"\" {\n   210\t\t\treturn e.Kind\n   211\t\t}\n   212\t\treturn e.Kind + \": \" + text\n   213\t}\n   214\t\n   215\t// ErrDelegationRefAmbiguous carries the candidates of an ambiguous reference.\n   216\t// Neither reference error carries the reference: it may be a session, which\n   217\t// no output names.\n   218\ttype ErrDelegationRefAmbiguous struct {\n   219\t\tCandidates []string\n   220\t}\n   221\t\n   222\tfunc (e *ErrDelegationRefAmbiguous) Error() string {\n   223\t\treturn \"pose: the reference names more than one delegated run: \" + strings.Join(e.Candidates, \", \")\n   224\t}\n   225\t\n   226\t// ErrDelegationRefUnknown means no attempt matches.\n   227\ttype ErrDelegationRefUnknown struct{}\n   228\t\n   229\tfunc (e *ErrDelegationRefUnknown) Error() string {\n   230\t\treturn \"pose: no delegated run matches the reference (a run id, an attempt id, a label or a session prefix of six characters or more)\"\n   300\t\tif len(raw) > reviewLedgerMaxBytes {\n   301\t\t\treturn fmt.Errorf(\"ledger record exceeds bound\")\n   302\t\t}\n   303\t\treturn PublishFile(filepath.Join(dir, filepath.Base(rel)), append(raw, '\\n'), 0644, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n   304\t}\n   305\t\n   306\tfunc (s Store) readDelegatedReviewAttempts(bundle string, budgets ...*int64) ([]DelegatedReviewAttempt, error) {\n   307\t\tbudget := reviewReadBudget(budgets)\n   308\t\trel := filepath.ToSlash(filepath.Join(reviewAttemptDir, reviewAttemptKey(bundle)))\n   309\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, rel)\n   310\t\tif err != nil {\n   311\t\t\treturn nil, err\n   312\t\t}\n   313\t\tout := []DelegatedReviewAttempt{}\n   314\t\tfor _, e := range entries {\n   315\t\t\tif IsPublisherStaging(e.Name()) {\n   316\t\t\t\tcontinue\n   317\t\t\t}\n   318\t\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n   319\t\t\t\tcontinue\n   320\t\t\t}\n   321\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   322\t\t\t\treturn nil, fmt.Errorf(\"unknown attempt artifact %s\", e.Name())\n   323\t\t\t}\n   324\t\t\tvar a DelegatedReviewAttempt\n   325\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, rel, e.Name()), &a, budget); err != nil {\n   326\t\t\t\treturn nil, err\n   327\t\t\t}\n   328\t\t\tif a.SchemaVersion != 1 || a.BundleID != bundle || a.Ordinal != len(out)+1 || a.AttemptID != attemptIdentity(a) || e.Name() != fmt.Sprintf(\"%06d.json\", a.Ordinal) {\n   329\t\t\t\treturn nil, fmt.Errorf(\"invalid attempt reservation %s\", e.Name())\n   330\t\t\t}\n   331\t\t\tif _, err := time.Parse(time.RFC3339Nano, a.ReservedAt); err != nil {\n   332\t\t\t\treturn nil, err\n   333\t\t\t}\n   334\t\t\tout = append(out, a)\n   335\t\t}\n   336\t\t// Orphan receipts are an unknown history, never ignored.\n   337\t\tfor _, e := range entries {\n   338\t\t\tif strings.HasSuffix(e.Name(), \".result.json\") {\n   339\t\t\t\tfound := false\n   340\t\t\t\tfor _, a := range out {\n   341\t\t\t\t\tif filepath.Base(attemptReceiptPath(s.Root, a)) == e.Name() {\n   342\t\t\t\t\t\tfound = true\n   343\t\t\t\t\t\tbreak\n   344\t\t\t\t\t}\n   345\t\t\t\t}\n   346\t\t\t\tif !found {\n   347\t\t\t\t\treturn nil, fmt.Errorf(\"attempt receipt has no reservation: %s\", e.Name())\n   348\t\t\t\t}\n   349\t\t\t}\n   350\t\t}\n   351\t\treturn out, nil\n   352\t}\n   353\tfunc (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (reviewAttemptReceipt, error) {\n   354\t\tbudget := reviewReadBudget(budgets)\n   355\t\tvar r reviewAttemptReceipt\n   356\t\tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n   357\t\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n   358\t\t}\n   359\t\tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n   360\t\t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n   361\t\t}\n   362\t\tvar run ReviewRun\n   363\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, r.RunID+\".json\"), &run, budget); err != nil {\n   364\t\t\treturn r, err\n   365\t\t}\n   366\t\traw, _ := json.Marshal(run)\n   367\t\tif run.AttemptID != a.AttemptID || run.BundleID != a.BundleID || run.BundleDigest != a.BundleDigest || run.Adapter != a.Adapter || digestBytes(raw) != r.RunDigest {\n   368\t\t\treturn r, fmt.Errorf(\"attempt receipt does not bind its final run\")\n   369\t\t}\n   370\t\treturn r, nil\n   371\t}\n   372\tfunc (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttempt, int, error) {\n   373\t\tif len(plan.Reason) > 2048 || strings.ContainsAny(plan.Reason, \"\\x00\\r\\n\") {\n   374\t\t\treturn nil, 0, fmt.Errorf(\"rerun reason must be one line of at most 2048 bytes\")\n   375\t\t}\n   376\t\truns, lost, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n   377\t\tif err != nil {\n   378\t\t\treturn nil, 0, err\n   379\t\t}\n   380\t\tif len(lost) > 0 {\n   381\t\t\treturn nil, 0, fmt.Errorf(\"review run coverage is unknown: %v\", lost)\n   382\t\t}\n   383\t\tattempts, err := s.readDelegatedReviewAttempts(plan.Bundle.BundleID)\n   384\t\tif err != nil {\n   385\t\t\treturn nil, 0, err\n   386\t\t}\n   387\t\tknownAttempts := map[string]bool{}\n   388\t\tcount := 0\n   389\t\treceiptBudget := int64(32 << 20)\n   390\t\tfor _, a := range attempts {\n   391\t\t\tknownAttempts[a.AttemptID] = true\n   392\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   393\t\t\t\treturn nil, 0, err\n   394\t\t\t}\n   395\t\t\tif a.Adapter == plan.Adapter {\n   396\t\t\t\tcount++\n   397\t\t\t}\n   398\t\t}\n   399\t\tcompleted := false\n   400\t\tfor _, run := range runs {\n   401\t\t\tif run.AttemptID != \"\" && !knownAttempts[run.AttemptID] {\n   402\t\t\t\treturn nil, 0, fmt.Errorf(\"missing attempt reservation %s\", run.AttemptID)\n   403\t\t\t}\n   404\t\t\tif run.Status == ReviewRunCompleted {\n   405\t\t\t\tcompleted = true\n   406\t\t\t}\n   407\t\t\tif run.AttemptID == \"\" && run.Adapter == plan.Adapter {\n   408\t\t\t\tcount++\n   409\t\t\t}\n   410\t\t}\n   411\t\tif count >= effectiveReviewMaxRuns(plan.Config) {\n   412\t\t\treturn nil, count, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"budget exhausted: %d attempt(s) of %s on this bundle, at most %d\", count, plan.Adapter, effectiveReviewMaxRuns(plan.Config)))\n   413\t\t}\n   414\t\tif completed && strings.TrimSpace(plan.Reason) == \"\" {\n   415\t\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n   416\t\t}\n   417\t\treturn attempts, count, nil\n   418\t}\n   419\tfunc (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n   420\t\tattempts, _, err := s.reviewAttemptAdmission(plan)\n   421\t\tif err != nil {\n   422\t\t\treturn DelegatedReviewAttempt{}, err\n   423\t\t}\n   424\t\tnonce := make([]byte, 16)\n   425\t\tif _, err := rand.Read(nonce); err != nil {\n   426\t\t\treturn DelegatedReviewAttempt{}, err\n   427\t\t}\n   428\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n   429\t\ta.AttemptID = attemptIdentity(a)\n   430\t\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n   431\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n   432\t\t\treturn DelegatedReviewAttempt{}, fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n   433\t\t}\n   434\t\treturn a, nil\n   435\t}\n   436\tfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n   437\t\traw, _ := json.Marshal(run)\n   438\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n   439\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n   440\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n   441\t}\n   442\t\n   443\t// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n   444\t// exists for legacy records; their content identity remains independently checked.\n   445\tfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n   446\t\tbudget := int64(32 << 20)\n   447\t\treturn s.reviewRunLedgerFindings(bundle, &budget)\n   448\t}\n   449\tfunc (s Store) reviewRunLedgerFindings(bundle string, budget *int64) ([]string, error) {\n   450\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, reviewRunLedgerDir)\n   451\t\tif err != nil {\n   452\t\t\treturn nil, err\n   453\t\t}\n   454\t\tfindings := []string{}\n   455\t\tvar checkedBytes int64\n   456\t\tfor _, e := range entries {\n   457\t\t\tif IsPublisherStaging(e.Name()) {\n   458\t\t\t\tcontinue\n   459\t\t\t}\n   460\t\t\tvar w reviewRunWitness\n   461\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunLedgerDir, e.Name()), &w, budget); err != nil {\n   462\t\t\t\tfindings = append(findings, err.Error())\n   463\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   464\t\t\t\t\tbreak\n   465\t\t\t\t}\n   466\t\t\t\tcontinue\n   467\t\t\t}\n   468\t\t\tif w.SchemaVersion != 1 || e.Name() != w.RunID+\".json\" || strings.ContainsAny(w.RunID, \"/\\\\\") {\n   469\t\t\t\tfindings = append(findings, \"invalid run witness \"+e.Name())\n   470\t\t\t\tcontinue\n   471\t\t\t}\n   472\t\t\tvar run ReviewRun\n   473\t\t\traw, readErr := readLedgerRawBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, w.RunID+\".json\"), budget)\n   474\t\t\tif readErr != nil {\n   475\t\t\t\tfindings = append(findings, \"witnessed run \"+w.RunID+\": \"+readErr.Error())\n   476\t\t\t\tif errors.Is(readErr, errReviewLedgerBudget) {\n   477\t\t\t\t\tbreak\n   478\t\t\t\t}\n   479\t\t\t\tcontinue\n   480\t\t\t}\n   481\t\t\tif err := strictJSONBytes(raw, &run); err != nil {\n   482\t\t\t\tfindings = append(findings, \"unreadable witnessed run \"+w.RunID)\n   483\t\t\t\tcontinue\n   484\t\t\t}\n   485\t\t\tif validateReviewRunRecord(w.RunID+\".json\", run) != nil || digestBytes(raw) != w.RecordDigest || run.TranscriptDigest != w.TranscriptDigest || run.BundleID != w.BundleID || run.Scope != w.Scope {\n   486\t\t\t\tfindings = append(findings, \"rewritten witnessed run \"+w.RunID)\n   487\t\t\t\tcontinue\n   488\t\t\t}\n   489\t\t\tif bundle != \"\" && run.BundleID != bundle {\n   490\t\t\t\tcontinue\n   491\t\t\t}\n   492\t\t\tinfo, statErr := s.fsys().Lstat(filepath.Join(s.Root, run.TranscriptPath))\n   493\t\t\tif statErr == nil {\n   494\t\t\t\tcheckedBytes += info.Size()\n   495\t\t\t}\n   496\t\t\tif checkedBytes > 512<<20 {\n   497\t\t\t\tfindings = append(findings, \"run transcript verification exceeds 512 MiB operation budget\")\n   498\t\t\t\tbreak\n   499\t\t\t}\n   500\t\t\tif why := s.reviewRunTranscriptIntact(run); why != \"\" {\n   140\t\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s timeout: %w\", name, err)\n   141\t\t\t\t}\n   142\t\t\t}\n   143\t\t}\n   144\t\treturn policy, nil\n   145\t}\n   146\t\n   147\t// ReviewRun is one recorded dispatch.\n   148\ttype ReviewRun struct {\n   149\t\tSafety              *ReviewExecutionSafety `json:\"safety,omitempty\"`\n   150\t\tProvenance          *ReviewRunProvenance   `json:\"provenance,omitempty\"`\n   151\t\tsessionForRedaction string\n   152\t\teventsBytes         []byte\n   153\t\tResumes             string `json:\"resumes,omitempty\"`\n   154\t\t// ResumesSession marks a task that continued a session POSE never\n   155\t\t// recorded, named by its caller (spec pose-delegation-parity-gate SA-07).\n   156\t\tResumesSession bool `json:\"resumes_session,omitempty\"`\n   157\t\t// HandsOffFrom names the run this one continues with another agent, and\n   158\t\t// HandoffDigest the section its brief added (spec\n   159\t\t// pose-delegation-handoff R4, R5).\n   160\t\tHandsOffFrom  string `json:\"hands_off_from,omitempty\"`\n   161\t\tHandoffDigest string `json:\"handoff_digest,omitempty\"`\n   162\t\t// HandoffRenderer is the version of the renderer that listed the\n   163\t\t// predecessor's commands in the section; absent on runs recorded before it.\n   164\t\tHandoffRenderer  int                 `json:\"handoff_renderer,omitempty\"`\n   165\t\tInterruption     *ReviewInterruption `json:\"interruption,omitempty\"`\n   166\t\tSessionDigest    string              `json:\"session_digest,omitempty\"`\n   167\t\tTreeDigest       string              `json:\"tree_digest,omitempty\"`\n   168\t\tBriefNotes       string              `json:\"brief_notes,omitempty\"`\n   169\t\tPartialDigest    string              `json:\"partial_digest,omitempty\"`\n   170\t\tLimitOf          string              `json:\"limit_of,omitempty\"`\n   171\t\tLedgerVersion    int                 `json:\"ledger_version,omitempty\"`\n   172\t\tAttemptID        string              `json:\"attempt_id,omitempty\"`\n   173\t\tReason           string              `json:\"reason,omitempty\"`\n   174\t\tSchemaVersion    int                 `json:\"schema_version\"`\n   175\t\tRunID            string              `json:\"run_id\"`\n   176\t\tScope            string              `json:\"scope\"`\n   177\t\tBundleID         string              `json:\"bundle_id\"`\n   178\t\tBundleDigest     string              `json:\"bundle_digest\"`\n   179\t\tSealedCommit     string              `json:\"sealed_commit\"`\n   180\t\tKind             string              `json:\"kind\"`\n   181\t\tBriefDigest      string              `json:\"brief_digest\"`\n   182\t\tAdapter          string              `json:\"adapter\"`\n   183\t\tVendor           string              `json:\"vendor\"`\n   184\t\tModel            string              `json:\"model\"`\n   185\t\tStartedAt        string              `json:\"started_at\"`\n   186\t\tEndedAt          string              `json:\"ended_at\"`\n   187\t\tExitCode         int                 `json:\"exit_code\"`\n   188\t\tStatus           string              `json:\"status\"`\n   189\t\tFailure          string              `json:\"failure,omitempty\"`\n   190\t\tTranscriptDigest string              `json:\"transcript_digest\"`\n   191\t\tTranscriptPath   string              `json:\"transcript_path\"`\n   192\t\tOutput           string              `json:\"output\"`\n   193\t\tPolicyDigest     string              `json:\"policy_digest,omitempty\"`\n   194\t\tSupersedes       string              `json:\"supersedes,omitempty\"`\n   195\t\t// Label, Purpose and Lead are given by pose delegate; EnvRemoved names the\n   196\t\t// parent session variables the child did not receive (never their values);\n   197\t\t// Events and EventsDigest bind the normalized event stream kept beside\n   198\t\t// the transcript (spec pose-delegation-surface R8, R9, R11).\n   199\t\tLabel        string   `json:\"label,omitempty\"`\n   200\t\tPurpose      string   `json:\"purpose,omitempty\"`\n   201\t\tLead         string   `json:\"lead,omitempty\"`\n   202\t\tEnvRemoved   []string `json:\"env_removed,omitempty\"`\n   203\t\tEvents       string   `json:\"events,omitempty\"`\n   204\t\tEventsDigest string   `json:\"events_digest,omitempty\"`\n   205\t\tSupersededBy string   `json:\"superseded_by,omitempty\"`\n   206\t\t// Routing is how the run's agent was chosen and IndependenceAchieved what\n   207\t\t// it achieved against the implementation (spec pose-delegation-routing R8).\n   208\t\tRouting              *DelegationRoutingRecord `json:\"routing,omitempty\"`\n   209\t\tIndependenceAchieved string                   `json:\"independence_achieved,omitempty\"`\n   210\t\t// A task run (spec pose-delegation-task) records the access it ran with,\n   930\t\t\trun.Provenance.ExecutableDigest = digest\n   931\t\t\texecPath = selected\n   932\t\t\traw, _ := json.Marshal(argv)\n   933\t\t\trun.Provenance.ArgvDigest = digestBytes(raw)\n   934\t\t}\n   935\t\tif plan.processTimeout > 0 {\n   936\t\t\tstarted, err := time.Parse(time.RFC3339Nano, run.StartedAt)\n   937\t\t\tif err != nil {\n   938\t\t\t\treturn finish(ReviewRunFailed, \"invalid execution start\")\n   939\t\t\t}\n   940\t\t\tsetup := now().Sub(started)\n   941\t\t\tremaining := plan.processTimeout - setup\n   942\t\t\tif setup < 0 || remaining <= 0 {\n   943\t\t\t\treturn finish(ReviewRunFailed, \"accumulated wall-clock budget spent before adapter launch\")\n   944\t\t\t}\n   945\t\t\tif remaining < timeout {\n   946\t\t\t\ttimeout = remaining\n   947\t\t\t}\n   948\t\t}\n   949\t\tctx, cancel := context.WithTimeout(parent, timeout)\n   950\t\tdefer cancel()\n   951\t\tcmd := exec.CommandContext(ctx, execPath, argv[1:]...)\n   952\t\tcmd.Args[0] = argv[0]\n   953\t\tcmd.Dir = worktree\n   954\t\tcmd.Stdin = strings.NewReader(plan.Brief.Text)\n   955\t\tenv, secrets, err := reviewAdapterEnvironment(plan.Config, tmp, plan.Brief.Text, plan.notes)\n   956\t\tif err != nil {\n   957\t\t\trun.BriefNotes = \"\"\n   958\t\t\treturn finish(ReviewRunFailed, err.Error())\n   959\t\t}\n   960\t\tunset := []string{}\n   961\t\tif policy, _, found, perr := s.LoadDelegationPolicy(); perr == nil && found {\n   962\t\t\tunset = policy.EnvUnset\n   963\t\t}\n   964\t\tenv, run.EnvRemoved = withoutParentSession(env, unset)\n   965\t\t// The reviewer works in a sealed checkout: diagnostics it runs must not\n   966\t\t// publish derived records into it (SealedCheckoutEnv).\n   967\t\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n   968\t\t// The reviewer checks its draft against the sealed bundle and the round\n   969\t\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n   970\t\t// context that cannot be built leaves the check unavailable, never the\n   971\t\t// review.\n   972\t\tif plan.Purpose == DelegationPurposeReview {\n   973\t\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n   974\t\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n   975\t\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n   976\t\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n   977\t\t\t\t\t// engine that dispatched the run is the one that checks it.\n   978\t\t\t\t\tif self, err := os.Executable(); err == nil {\n   979\t\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n   980\t\t\t\t\t}\n   981\t\t\t\t}\n   982\t\t\t}\n   983\t\t}\n   984\t\tcmd.Env = env\n   985\t\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n   986\t\tcmd.Stdout, cmd.Stderr = combined, combined\n   987\t\t// pose delegate watch follows the normalized, redacted events as they come\n   988\t\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n   989\t\t// the record is published.\n   990\t\tsessionPattern := \"\"\n   991\t\tif plan.Config.Session != nil {\n   992\t\t\tsessionPattern = plan.Config.Session.Pattern\n   993\t\t}\n   994\t\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n   995\t\t\ttee := io.MultiWriter(combined, live)\n   996\t\t\tcmd.Stdout, cmd.Stderr = tee, tee\n   997\t\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n   998\t\t\tdefer live.Close()\n   999\t\t}\n  1000\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n  1001\t\t// only the parent left a child holding stdout, so the timeout never fired\n  1002\t\t// (found in review). The run gets its own process group, the whole group\n  1003\t\t// is killed on timeout and after the run, and pipes are released at most\n  1004\t\t// a few seconds after the kill.\n  1005\t\tisolateProcessGroup(cmd)\n  1006\t\tcmd.WaitDelay = AdapterPipeGrace\n  1007\t\tvar runErr error\n  1008\t\tif run.Provenance == nil {\n  1009\t\t\trunErr = cmd.Run()\n  1010\t\t} else {\n  1011\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1012\t\t\trunErr = err\n  1013\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1014\t\t\tif started {\n  1015\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1016\t\t\t}\n  1017\t\t}\n  1018\t\tterminationErr = killProcessGroup(cmd)\n  1019\t\t// A command the reviewer left running in a session of its own escapes the\n  1020\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1021\t\t// directories it may still write (spec\n  1022\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1023\t\tif reaped, reapErr := reapSealedCheckoutProcesses(worktree); reapErr != nil {\n  1024\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1025\t\t} else if len(reaped) > 0 && safety != nil {\n  1026\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(len(reaped))+\" process(es) the run left running: \"+strings.Join(reaped, \", \"))\n  1027\t\t}\n  1028\t\tterminationFailed = terminationErr != nil\n  1029\t\t// The adapter exited and a child it left still held the output when\n  1030\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1031\t\t// the exit status decides (found in review).\n  1032\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1033\t\t\trunErr = nil\n  1034\t\t}\n  1035\t\ttranscript, overflow := combined.result()\n  1036\t\tsafety.CaptureComplete = !overflow\n  1037\t\tif cmd.ProcessState != nil {\n  1038\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1039\t\t}\n  1040\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n  1041\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n  1042\t\t\tsafety.CaptureComplete = false\n  1043\t\t}\n  1044\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1045\t\t\trun.Output = string(raw)\n  1046\t\t\tif run.Provenance != nil {\n  1047\t\t\t\trun.Provenance.OutputComplete = true\n  1048\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1049\t\t\t}\n  1050\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1051\t\t\t// The agent writes no output file; its stream names its final message.\n  1052\t\t\trun.Output = final\n  1053\t\t\tif run.Provenance != nil {\n  1054\t\t\t\trun.Provenance.OutputComplete = true\n  1055\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1056\t\t\t}\n  1057\t\t} else {\n  1058\t\t\trun.Output = tail(string(transcript), 20000)\n  1059\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1060\t\t\t\tsafety.CaptureComplete = false\n  1061\t\t\t}\n  1062\t\t\tif run.Provenance != nil {\n  1063\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1064\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1065\t\t\t}\n  1440\t}\n  1441\t\n  1442\t// ReviewerArgv expands a command template: \"{effort}\" becomes the argv\n  1443\t// fragment of the effort level (the agent's default when level is \"\"), and\n  1444\t// \"{output}\" and \"{session}\" become their values. Schema 2 templates hold\n  1445\t// placeholders only as whole elements; schema 1 templates keep their\n  1446\t// in-element replacement.\n  1447\tfunc ReviewerArgv(command []string, output, session, level string, effort *ReviewerEffort) []string {\n  1448\t\targv := make([]string, 0, len(command))\n  1449\t\tfor _, arg := range command {\n  1450\t\t\tif arg == \"{effort}\" {\n  1451\t\t\t\tif effort != nil {\n  1452\t\t\t\t\tif level == \"\" {\n  1453\t\t\t\t\t\tlevel = effort.Default\n  1454\t\t\t\t\t}\n  1455\t\t\t\t\targv = append(argv, effort.Levels[level]...)\n  1456\t\t\t\t}\n  1457\t\t\t\tcontinue\n  1458\t\t\t}\n  1459\t\t\targv = append(argv, strings.ReplaceAll(strings.ReplaceAll(arg, \"{output}\", output), \"{session}\", session))\n  1460\t\t}\n  1461\t\treturn argv\n  1462\t}\n  1463\t\n  1464\tfunc tail(s string, n int) string {\n  1465\t\tif len(s) <= n {\n  1466\t\t\treturn s\n  1467\t\t}\n  1468\t\treturn s[len(s)-n:]\n  1469\t}\n  1470\t\n  1471\tfunc (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\n  1472\t\t// Identity covers only persisted content, never fields derived by a reader\n  1473\t\t// or a previous write of a copied record.\n  1474\t\trun.RunID, run.Path, run.TranscriptPath, run.SupersededBy = \"\", \"\", \"\", \"\"\n  1475\t\trun.LedgerVersion = 1\n  1476\t\tsum := sha256.Sum256(transcript)\n  1477\t\trun.TranscriptDigest = \"sha256:\" + hex.EncodeToString(sum[:])\n  1478\t\tvar events []byte\n  1479\t\trun.EventsDigest = \"\"\n  1480\t\tif run.Events != \"\" {\n  1481\t\t\tevents = run.eventsBytes\n  1482\t\t\trun.EventsDigest = digestBytes(events)\n  1483\t\t}\n  1484\t\trun.eventsBytes = nil // never part of the record or of a copy compared with it\n  1485\t\tidentity, _ := json.Marshal(run)\n  1486\t\tidSum := sha256.Sum256(identity)\n  1487\t\trun.RunID = \"rrn-\" + hex.EncodeToString(idSum[:])[:16]\n  1488\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, reviewRunsDir, true)\n  1489\t\tif err != nil {\n  1490\t\t\treturn ReviewRun{}, err\n  1491\t\t}\n  1492\t\trun.TranscriptPath = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\"))\n  1493\t\tpretty, err := json.MarshalIndent(run, \"\", \"  \")\n  1494\t\tif err != nil {\n  1495\t\t\treturn ReviewRun{}, err\n  1496\t\t}\n  1497\t\tpretty = append(pretty, '\\n')\n  1498\t\tif len(pretty) > reviewLedgerMaxBytes {\n  1499\t\t\treturn ReviewRun{}, fmt.Errorf(\"review run record exceeds %d-byte bound; nothing published\", reviewLedgerMaxBytes)\n  1500\t\t}\n  1501\t\tif len(transcript) > reviewTranscriptMaxBytes {\n  1502\t\t\treturn ReviewRun{}, fmt.Errorf(\"review transcript exceeds %d-byte bound; nothing published\", reviewTranscriptMaxBytes)\n  1503\t\t}\n  1504\t\n  1505\t\twitness := reviewRunWitness{SchemaVersion: 1, RunID: run.RunID, BundleID: run.BundleID, Scope: run.Scope, RecordDigest: digestBytes(pretty), TranscriptDigest: run.TranscriptDigest}\n  1506\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(filepath.Join(reviewRunLedgerDir, run.RunID+\".json\")), witness); err != nil {\n  1507\t\t\treturn ReviewRun{}, err\n  1508\t\t}\n  1509\t\tif run.Safety != nil && int64(len(pretty)+len(transcript)+len(events)) > run.Safety.RetainedBytes {\n  1510\t\t\treturn ReviewRun{}, fmt.Errorf(\"retained run exceeds containment byte budget; attempt remains incomplete\")\n  1511\t\t}\n  1512\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".transcript\"), transcript, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1513\t\t\treturn ReviewRun{}, err\n  1514\t\t}\n  1515\t\tif run.EventsDigest != \"\" {\n  1516\t\t\tif err := publishDelegationEvents(dir, run.RunID, events); err != nil {\n  1517\t\t\t\treturn ReviewRun{}, err\n  1518\t\t\t}\n  1519\t\t}\n  1520\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".json\"), pretty, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1521\t\t\treturn ReviewRun{}, err\n  1522\t\t}\n  1523\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".json\"))\n  1524\t\treturn run, nil\n  1525\t}\n   850\t\tswitch {\n   851\t\tcase d < time.Minute:\n   852\t\t\treturn fmt.Sprintf(\"%ds\", int(d.Seconds()))\n   853\t\tcase d < time.Hour:\n   854\t\t\treturn fmt.Sprintf(\"%dm\", int(d.Minutes()))\n   855\t\tcase d < 48*time.Hour:\n   856\t\t\treturn fmt.Sprintf(\"%dh\", int(d.Hours()))\n   857\t\t}\n   858\t\treturn fmt.Sprintf(\"%dd\", int(d.Hours()/24))\n   859\t}\n   860\t\n   861\tfunc cmdDelegateLs(root string, args []string, stdout, stderr io.Writer) int {\n   862\t\tf, problem := parseDelegateFlags(args, \"--active\")\n   863\t\tif problem == \"\" && len(f.positional) > 1 {\n   864\t\t\tproblem = tr(\"one reference at most\", \"no máximo uma referência\")\n   865\t\t}\n   866\t\tif problem != \"\" {\n   867\t\t\treturn delegateUsage(stdout, stderr, args, \"ls\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate ls [<run>|<bundle-id>] [--active] [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>] [--json]\")\n   868\t\t}\n   869\t\tstore := posemodel.Store{Root: root}\n   870\t\tattempts, lost, err := store.ListDelegationAttempts()\n   871\t\tif err != nil {\n   872\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 1, err)\n   873\t\t}\n   874\t\tif len(f.positional) == 1 && !strings.HasPrefix(f.positional[0], \"rvb-\") {\n   875\t\t\tone, err := posemodel.ResolveDelegationRef(attempts, f.positional[0])\n   876\t\t\tif err != nil {\n   877\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, withDelegationLosses(refError(err), lost))\n   878\t\t\t}\n   879\t\t\t// A named run is refused when a selecting flag does not match it, as on\n   880\t\t\t// every other lifecycle command (D8); without a reference they filter.\n   881\t\t\tif flag := f.mismatch(one); flag != \"\" {\n   882\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"ls\", 2, errors.New(tr(\"attempt \"+one.AttemptID+\" does not match \"+flag, \"a tentativa \"+one.AttemptID+\" não corresponde a \"+flag)))\n   883\t\t\t}\n   884\t\t\tattempts = []posemodel.DelegationAttempt{one}\n   885\t\t}\n   886\t\tselected := []posemodel.DelegationAttempt{}\n   887\t\tfor _, a := range attempts {\n   888\t\t\tif len(f.positional) == 1 && strings.HasPrefix(f.positional[0], \"rvb-\") && a.BundleID != f.positional[0] {\n   889\t\t\t\tcontinue\n   890\t\t\t}\n   891\t\t\tif f.active && !a.Active || f.mismatch(a) != \"\" {\n   892\t\t\t\tcontinue\n   893\t\t\t}\n   894\t\t\tselected = append(selected, a)\n   895\t\t}\n   896\t\tif lost == nil {\n   897\t\t\tlost = []string{}\n   898\t\t}\n   899\t\tif f.jsonOut {\n   900\t\t\t// R9: a stopped attempt carries the ways forward it has now.\n   901\t\t\ttype listed struct {\n   902\t\t\t\tposemodel.DelegationAttempt\n   903\t\t\t\tNextActions []delegateNextAction `json:\"next_actions,omitempty\"`\n   904\t\t\t}\n   905\t\t\trows := make([]listed, 0, len(selected))\n   906\t\t\tfor _, a := range selected {\n   907\t\t\t\trows = append(rows, listed{a, delegateNextActions(store, a)})\n   908\t\t\t}\n   909\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateListSchema, \"attempts\": rows, \"losses\": lost})\n   910\t\t} else {\n   911\t\t\tout := render(stdout, stderr)\n   912\t\t\tif len(selected) == 0 {\n   913\t\t\t\tout.Field(\"delegate.runs\", tr(\"none\", \"nenhum\"))\n   914\t\t\t}\n   915\t\t\tfor _, a := range selected {\n   916\t\t\t\tvalue := fmt.Sprintf(\"state=%s purpose=%s agent=%s turns=%d age=%s\", a.State, a.Purpose, a.Agent, a.Turns, delegateAge(a.StartedAt))\n   917\t\t\t\tif a.Round > 0 {\n   918\t\t\t\t\tvalue += fmt.Sprintf(\" round=%d\", a.Round)\n   919\t\t\t\t}\n   920\t\t\t\tif a.Label != \"\" {\n   921\t\t\t\t\tvalue += \" label=\" + a.Label\n   922\t\t\t\t}\n   923\t\t\t\tif a.Active && a.Liveness != \"\" {\n   924\t\t\t\t\tvalue += \" owner=\" + a.Liveness\n   925\t\t\t\t}\n   926\t\t\t\tif a.HeartbeatAge != \"\" {\n   927\t\t\t\t\tvalue += \" heartbeat=\" + a.HeartbeatAge\n   928\t\t\t\t}\n   929\t\t\t\tif a.StalledAt != \"\" {\n   930\t\t\t\t\tvalue += \" stalled_at=\" + a.StalledAt\n   931\t\t\t\t}\n   932\t\t\t\tif a.HookFailure != \"\" {\n   933\t\t\t\t\tvalue += \" on_terminal_failed=\" + strconv.Quote(a.HookFailure)\n   934\t\t\t\t}\n   935\t\t\t\tif a.Interruption != nil {\n   936\t\t\t\t\tvalue += fmt.Sprintf(\" cause=%s resumable=%t partial=%t\", a.Interruption.Cause, a.Interruption.Resumable, a.Partial)\n   937\t\t\t\t\tif a.Interruption.ResetAt != \"\" {\n   938\t\t\t\t\t\tvalue += \" reset_at=\" + a.Interruption.ResetAt + \" time_left=\" + a.TimeLeft\n   939\t\t\t\t\t}\n   940\t\t\t\t}\n   941\t\t\t\tif a.LatestRun != \"\" {\n   942\t\t\t\t\tvalue += \" run=\" + a.LatestRun\n   943\t\t\t\t}\n   944\t\t\t\tif a.LastStep != \"\" {\n   945\t\t\t\t\tvalue += \" last=\" + a.LastStep\n   946\t\t\t\t}\n   947\t\t\t\tout.Field(\"delegate.\"+a.AttemptID, value)\n   948\t\t\t}\n   949\t\t\tfor _, loss := range lost {\n   950\t\t\t\tout.Failure(tr(\"delegated run history incomplete: \", \"histórico de runs delegados incompleto: \") + loss)\n   951\t\t\t}\n   952\t\t}\n   953\t\tif len(lost) > 0 {\n   954\t\t\treturn 1\n   955\t\t}\n   956\t\treturn 0\n   957\t}\n   958\t\n   959\t// resumeTarget is the run a resume continues (R11 with the delivered\n   960\t// continuity): the run named by its id, or the attempt's latest run when it\n  1090\t\tif safety, _ := posemodel.ResolveReviewerContainment(plan.Config); safety != nil && !f.jsonOut {\n  1091\t\t\traw, _ := json.Marshal(safety)\n  1092\t\t\trender(stdout, stderr).Field(\"delegate.safety\", string(raw))\n  1093\t\t}\n  1094\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n  1095\t\thandBackExisting(run, err)\n  1096\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n  1097\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"resume\")\n  1098\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"resume\", run, err, delegateRunNextActions(store, run, err)...)\n  1099\t\tif err == nil && !f.jsonOut {\n  1100\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n  1101\t\t\t\treturn next\n  1102\t\t\t}\n  1103\t\t}\n  1104\t\treturn code\n  1105\t}\n  1106\t\n  1107\tfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n  1108\t\tf, problem := parseDelegateFlags(args)\n  1109\t\tif problem != \"\" {\n  1110\t\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--dry-run] [--json]\")\n  1111\t\t}\n  1112\t\tstore := posemodel.Store{Root: root}\n  1113\t\tattempts, lost, err := store.ListDelegationAttempts()\n  1114\t\tif err != nil {\n  1115\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1116\t\t}\n  1117\t\tattempt, code, err := namedAttempt(attempts, f)\n  1118\t\tif err != nil {\n  1119\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n  1120\t\t}\n  1121\t\tif attempt.State == posemodel.DelegationStalled && attempt.LatestRun == \"\" && !f.dryRun {\n  1122\t\t\t// An attempt whose dispatch ended before recording its run is\n  1123\t\t\t// released with a failed run and its receipt, so it stops blocking\n  1124\t\t\t// the bundle (spec pose-review-run-reaps-lingering-reviewer-processes R5).\n  1125\t\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now())\n  1126\t\t\tif err != nil {\n  1127\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1128\t\t\t}\n  1129\t\t\tif f.jsonOut {\n  1130\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n  1131\t\t\t\treturn 0\n  1132\t\t\t}\n  1133\t\t\tout := render(stdout, stderr)\n  1134\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1135\t\t\tout.Field(\"delegate.released\", tr(\"true: recorded as failed run \"+run.RunID+\" (abandoned before its run was recorded)\", \"true: registrada como run com falha \"+run.RunID+\" (abandonada antes de o run ser registrado)\"))\n  1136\t\t\treturn 0\n  1137\t\t}\n  1138\t\tif !attempt.Active {\n  1139\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n  1140\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n  1141\t\t}\n  1142\t\tif f.dryRun {\n  1143\t\t\tif f.jsonOut {\n  1144\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": false, \"dry_run\": true, \"owner\": attempt.Liveness})\n  1145\t\t\t\treturn 0\n  1146\t\t\t}\n  1147\t\t\tout := render(stdout, stderr)\n  1148\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1149\t\t\tout.Field(\"delegate.owner\", attempt.Liveness)\n  1150\t\t\tout.Field(\"delegate.dry_run\", tr(\"true (no cancellation requested)\", \"true (nenhum cancelamento pedido)\"))\n  1151\t\t\treturn 0\n  1152\t\t}\n  1153\t\tmarker, err := store.RequestDelegationCancel(attempt.AttemptID)\n  1154\t\tif err != nil {\n  1155\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n  1156\t\t}\n  1157\t\tdeadline := time.Now().Add(60 * time.Second)\n  1158\t\tfor store.DelegationRunActive(marker) && time.Now().Before(deadline) {\n  1159\t\t\ttime.Sleep(200 * time.Millisecond)\n  1160\t\t}\n  1161\t\tstopped := !store.DelegationRunActive(marker)\n  1162\t\tstatus, run := \"\", \"\"\n  1163\t\tif after, _, err := store.ListDelegationAttempts(); err == nil {\n  1164\t\t\tfor _, a := range after {\n  1165\t\t\t\tif a.AttemptID == attempt.AttemptID && a.Latest() != nil {\n  1166\t\t\t\t\tstatus, run = a.Latest().Status, a.Latest().RunID\n  1167\t\t\t\t}\n  1168\t\t\t}\n  1169\t\t}\n  1170\t\tif f.jsonOut {\n  1171\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"requested\": true, \"stopped\": stopped, \"run\": run, \"status\": status})\n  1172\t\t} else {\n  1173\t\t\tout := render(stdout, stderr)\n  1174\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n  1175\t\t\tout.Field(\"delegate.cancel\", tr(\"requested\", \"pedido\"))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '90,195p' && nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '350,475p' && nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '600,760p;790,930p;1470,1565p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '90,195p' && nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '350,475p' && nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '600,760p;790,930p;1470,1565p'\"","aggregated_output":"    90\t\t\t\tkey = run.RunID // a run recorded before attempts existed is its own attempt\n    91\t\t\t}\n    92\t\t\trow, ok := byAttempt[key]\n    93\t\t\tif !ok {\n    94\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    95\t\t\t\tbyAttempt[key] = row\n    96\t\t\t\torder = append(order, key)\n    97\t\t\t}\n    98\t\t\trow.Runs = append(row.Runs, run.RunID)\n    99\t\t\trow.latest = &runs[i]\n   100\t\t\tif run.SessionDigest != \"\" {\n   101\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   102\t\t\t\t\trow.sessions = append(row.sessions, value)\n   103\t\t\t\t}\n   104\t\t\t}\n   105\t\t\tevents, err := s.ReadDelegationEvents(run)\n   106\t\t\tif err != nil {\n   107\t\t\t\t// A turn count read from nothing would report a whole history.\n   108\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   109\t\t\t} else {\n   110\t\t\t\tfor _, e := range events {\n   111\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   112\t\t\t\t\t\trow.Turns++\n   113\t\t\t\t\t}\n   114\t\t\t\t}\n   115\t\t\t\tif len(events) > 0 {\n   116\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   117\t\t\t\t}\n   118\t\t\t}\n   119\t\t}\n   120\t\tfor _, key := range order {\n   121\t\t\trow := byAttempt[key]\n   122\t\t\tlatest := row.latest\n   123\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   124\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   125\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   126\t\t\tif latest.Access != \"\" {\n   127\t\t\t\trow.Access = latest.Access\n   128\t\t\t}\n   129\t\t\trow.Round = latest.Round\n   130\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   131\t\t\t\trow.HookFailure = hook.Failure\n   132\t\t\t}\n   133\t\t\tif row.Purpose == \"\" {\n   134\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   135\t\t\t}\n   136\t\t\tif latest.Status == ReviewRunInterrupted {\n   137\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   138\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   139\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   140\t\t\t\t\t\tleft := time.Until(at)\n   141\t\t\t\t\t\tif left < 0 {\n   142\t\t\t\t\t\t\tleft = 0\n   143\t\t\t\t\t\t}\n   144\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   145\t\t\t\t\t}\n   146\t\t\t\t}\n   147\t\t\t}\n   148\t\t}\n   149\t\tif activeErr != nil {\n   150\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   151\t\t}\n   152\t\tlost = append(lost, activeLost...)\n   153\t\tfor _, marker := range active {\n   154\t\t\trow, ok := byAttempt[marker.AttemptID]\n   155\t\t\tif !ok {\n   156\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   157\t\t\t\tbyAttempt[marker.AttemptID] = row\n   158\t\t\t\torder = append(order, marker.AttemptID)\n   159\t\t\t}\n   160\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   161\t\t\tif marker.Round > 0 {\n   162\t\t\t\trow.Round = marker.Round\n   163\t\t\t}\n   164\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   165\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   166\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   167\t\t\t}\n   168\t\t\tif marker.StalledAt != \"\" {\n   169\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   170\t\t\t}\n   171\t\t\t// A running run's progress comes from its live events (R12).\n   172\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   173\t\t\t\tfor _, e := range live {\n   174\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   175\t\t\t\t\t\trow.Turns++\n   176\t\t\t\t\t}\n   177\t\t\t\t}\n   178\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   179\t\t\t}\n   180\t\t}\n   181\t\tout := make([]DelegationAttempt, 0, len(order))\n   182\t\tfor _, key := range order {\n   183\t\t\tout = append(out, *byAttempt[key])\n   184\t\t}\n   185\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   186\t\treturn out, lost, nil\n   187\t}\n   188\t\n   189\tfunc delegationStepText(e DelegationEvent) string {\n   190\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   191\t\tif len(text) > 80 {\n   192\t\t\tcut := 77\n   193\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   194\t\t\t\tcut--\n   195\t\t\t}\n   350\t\t}\n   351\t\treturn out, nil\n   352\t}\n   353\tfunc (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (reviewAttemptReceipt, error) {\n   354\t\tbudget := reviewReadBudget(budgets)\n   355\t\tvar r reviewAttemptReceipt\n   356\t\tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n   357\t\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n   358\t\t}\n   359\t\tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n   360\t\t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n   361\t\t}\n   362\t\tvar run ReviewRun\n   363\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, r.RunID+\".json\"), &run, budget); err != nil {\n   364\t\t\treturn r, err\n   365\t\t}\n   366\t\traw, _ := json.Marshal(run)\n   367\t\tif run.AttemptID != a.AttemptID || run.BundleID != a.BundleID || run.BundleDigest != a.BundleDigest || run.Adapter != a.Adapter || digestBytes(raw) != r.RunDigest {\n   368\t\t\treturn r, fmt.Errorf(\"attempt receipt does not bind its final run\")\n   369\t\t}\n   370\t\treturn r, nil\n   371\t}\n   372\tfunc (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttempt, int, error) {\n   373\t\tif len(plan.Reason) > 2048 || strings.ContainsAny(plan.Reason, \"\\x00\\r\\n\") {\n   374\t\t\treturn nil, 0, fmt.Errorf(\"rerun reason must be one line of at most 2048 bytes\")\n   375\t\t}\n   376\t\truns, lost, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n   377\t\tif err != nil {\n   378\t\t\treturn nil, 0, err\n   379\t\t}\n   380\t\tif len(lost) > 0 {\n   381\t\t\treturn nil, 0, fmt.Errorf(\"review run coverage is unknown: %v\", lost)\n   382\t\t}\n   383\t\tattempts, err := s.readDelegatedReviewAttempts(plan.Bundle.BundleID)\n   384\t\tif err != nil {\n   385\t\t\treturn nil, 0, err\n   386\t\t}\n   387\t\tknownAttempts := map[string]bool{}\n   388\t\tcount := 0\n   389\t\treceiptBudget := int64(32 << 20)\n   390\t\tfor _, a := range attempts {\n   391\t\t\tknownAttempts[a.AttemptID] = true\n   392\t\t\tif _, err := s.readAttemptReceipt(a, &receiptBudget); err != nil {\n   393\t\t\t\treturn nil, 0, err\n   394\t\t\t}\n   395\t\t\tif a.Adapter == plan.Adapter {\n   396\t\t\t\tcount++\n   397\t\t\t}\n   398\t\t}\n   399\t\tcompleted := false\n   400\t\tfor _, run := range runs {\n   401\t\t\tif run.AttemptID != \"\" && !knownAttempts[run.AttemptID] {\n   402\t\t\t\treturn nil, 0, fmt.Errorf(\"missing attempt reservation %s\", run.AttemptID)\n   403\t\t\t}\n   404\t\t\tif run.Status == ReviewRunCompleted {\n   405\t\t\t\tcompleted = true\n   406\t\t\t}\n   407\t\t\tif run.AttemptID == \"\" && run.Adapter == plan.Adapter {\n   408\t\t\t\tcount++\n   409\t\t\t}\n   410\t\t}\n   411\t\tif count >= effectiveReviewMaxRuns(plan.Config) {\n   412\t\t\treturn nil, count, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"budget exhausted: %d attempt(s) of %s on this bundle, at most %d\", count, plan.Adapter, effectiveReviewMaxRuns(plan.Config)))\n   413\t\t}\n   414\t\tif completed && strings.TrimSpace(plan.Reason) == \"\" {\n   415\t\t\treturn nil, count, refusal(DelegationReasonRerunWithoutReason, fmt.Errorf(\"completed run exists on unchanged bundle; an explicit --reason is required\"))\n   416\t\t}\n   417\t\treturn attempts, count, nil\n   418\t}\n   419\tfunc (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n   420\t\tattempts, _, err := s.reviewAttemptAdmission(plan)\n   421\t\tif err != nil {\n   422\t\t\treturn DelegatedReviewAttempt{}, err\n   423\t\t}\n   424\t\tnonce := make([]byte, 16)\n   425\t\tif _, err := rand.Read(nonce); err != nil {\n   426\t\t\treturn DelegatedReviewAttempt{}, err\n   427\t\t}\n   428\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n   429\t\ta.AttemptID = attemptIdentity(a)\n   430\t\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n   431\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n   432\t\t\treturn DelegatedReviewAttempt{}, fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n   433\t\t}\n   434\t\treturn a, nil\n   435\t}\n   436\tfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n   437\t\traw, _ := json.Marshal(run)\n   438\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n   439\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n   440\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n   441\t}\n   442\t\n   443\t// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n   444\t// exists for legacy records; their content identity remains independently checked.\n   445\tfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n   446\t\tbudget := int64(32 << 20)\n   447\t\treturn s.reviewRunLedgerFindings(bundle, &budget)\n   448\t}\n   449\tfunc (s Store) reviewRunLedgerFindings(bundle string, budget *int64) ([]string, error) {\n   450\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, reviewRunLedgerDir)\n   451\t\tif err != nil {\n   452\t\t\treturn nil, err\n   453\t\t}\n   454\t\tfindings := []string{}\n   455\t\tvar checkedBytes int64\n   456\t\tfor _, e := range entries {\n   457\t\t\tif IsPublisherStaging(e.Name()) {\n   458\t\t\t\tcontinue\n   459\t\t\t}\n   460\t\t\tvar w reviewRunWitness\n   461\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunLedgerDir, e.Name()), &w, budget); err != nil {\n   462\t\t\t\tfindings = append(findings, err.Error())\n   463\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   464\t\t\t\t\tbreak\n   465\t\t\t\t}\n   466\t\t\t\tcontinue\n   467\t\t\t}\n   468\t\t\tif w.SchemaVersion != 1 || e.Name() != w.RunID+\".json\" || strings.ContainsAny(w.RunID, \"/\\\\\") {\n   469\t\t\t\tfindings = append(findings, \"invalid run witness \"+e.Name())\n   470\t\t\t\tcontinue\n   471\t\t\t}\n   472\t\t\tvar run ReviewRun\n   473\t\t\traw, readErr := readLedgerRawBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, w.RunID+\".json\"), budget)\n   474\t\t\tif readErr != nil {\n   475\t\t\t\tfindings = append(findings, \"witnessed run \"+w.RunID+\": \"+readErr.Error())\n   600\t\tplan.provenance, err = s.prepareRunProvenance(plan, policy)\n   601\t\tif err != nil {\n   602\t\t\treturn DispatchPlan{}, err\n   603\t\t}\n   604\t\treturn plan, nil\n   605\t}\n   606\t\n   607\t// ErrNoReviewerAdapter means the project configured no reviewer.\n   608\tvar ErrNoReviewerAdapter = errors.New(\"pose: no agent is configured in .pose/policy/delegation.json\")\n   609\t\n   610\t// RunReviewDispatch executes plan and records the run, failed or completed.\n   611\tfunc (s Store) RunReviewDispatch(plan DispatchPlan, now func() time.Time) (ReviewRun, error) {\n   612\t\treturn s.RunReviewDispatchContext(context.Background(), plan, now)\n   613\t}\n   614\t\n   615\t// RunReviewDispatchContext also propagates caller cancellation to the covered\n   616\t// process set. Cleanup has its own bounded context and never respawns the adapter.\n   617\tfunc (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPlan, now func() time.Time) (result ReviewRun, resultErr error) {\n   618\t\tif err := parent.Err(); err != nil {\n   619\t\t\treturn ReviewRun{}, err\n   620\t\t}\n   621\t\tif why := routingAgainstAnotherBundle(plan); why != \"\" {\n   622\t\t\treturn ReviewRun{}, errors.New(\"pose: \" + why)\n   623\t\t}\n   624\t\t// pose delegate cancel stops the run through this context (R13).\n   625\t\tparent, cancelRun := context.WithCancel(parent)\n   626\t\tdefer cancelRun()\n   627\t\tvar cancelled *atomic.Bool\n   628\t\tif plan.PendingContinuation != nil {\n   629\t\t\treturn ReviewRun{}, plan.PendingContinuation\n   630\t\t}\n   631\t\tif plan.Existing != nil {\n   632\t\t\tif plan.predecessor == nil {\n   633\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation lacks predecessor\")\n   634\t\t\t}\n   635\t\t\tfresh, err := s.replanContinuation(plan)\n   636\t\t\tif err != nil {\n   637\t\t\t\treturn ReviewRun{}, err\n   638\t\t\t}\n   639\t\t\tif fresh.Existing == nil {\n   640\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation disappeared\")\n   641\t\t\t}\n   642\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   643\t\t}\n   644\t\tif _, _, err := reviewAdapterEnvironment(plan.Config, \"\", plan.Brief.Text, plan.notes); err != nil {\n   645\t\t\treturn ReviewRun{}, err\n   646\t\t}\n   647\t\trun := ReviewRun{Provenance: plan.provenance, BriefNotes: plan.notes, LimitOf: plan.LimitOf, SchemaVersion: 1, Scope: plan.Brief.Scope, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest,\n   648\t\t\tSealedCommit: plan.SealedCommit, Kind: plan.Brief.Kind, BriefDigest: plan.Brief.Digest, Adapter: plan.Adapter,\n   649\t\t\tVendor: plan.Config.Vendor, Model: plan.Config.Model, Reason: plan.Reason, PolicyDigest: plan.PolicyDigest, StartedAt: now().UTC().Format(time.RFC3339Nano), ExitCode: -1,\n   650\t\t\tLabel: plan.Label, Purpose: plan.Purpose, Lead: plan.Lead, Events: plan.Config.Events, Routing: plan.Routing, Round: plan.round, Thread: plan.thread}\n   651\t\timpl := plan.Implementation()\n   652\t\trun.IndependenceAchieved = AchievedIndependence(impl.Vendor, impl.Model, plan.Config.Vendor, plan.Config.Model)\n   653\t\tsafety, err := ResolveReviewerContainment(plan.Config)\n   654\t\tif err != nil {\n   655\t\t\treturn ReviewRun{}, err\n   656\t\t}\n   657\t\tif err := validateReviewNotes(plan.notes); err != nil {\n   658\t\t\treturn ReviewRun{}, err\n   659\t\t}\n   660\t\trun.Safety = safety\n   661\t\tvar cleanup func() error\n   662\t\tvar cleanupErr error\n   663\t\tvar terminationFailed bool\n   664\t\tcleaned := false\n   665\t\tdoCleanup := func() {\n   666\t\t\tif cleaned {\n   667\t\t\t\treturn\n   668\t\t\t}\n   669\t\t\tcleaned = true\n   670\t\t\toutcome := NewOperationResult(\"review.dispatch.cleanup\", run.Scope)\n   671\t\t\toutcome.StepsRun = append(outcome.StepsRun, OperationStep{ID: \"cleanup\", Result: \"done\"})\n   672\t\t\tif terminationFailed {\n   673\t\t\t\tcleanupErr = fmt.Errorf(\"process termination incomplete; runtime resources retained\")\n   674\t\t\t} else if cleanup != nil {\n   675\t\t\t\tcleanupErr = cleanup()\n   676\t\t\t}\n   677\t\t\tif cleanupErr != nil {\n   678\t\t\t\toutcome.StepsRun[0].Result = \"failed\"\n   679\t\t\t\toutcome.Fail(OutcomeFailed, \"cleanup\", \"cleanup-incomplete\", cleanupErr.Error())\n   680\t\t\t\toutcome.Unconfirmed = []OperationUncertain{{Step: \"cleanup\", Reason: \"owned resources may remain; no automatic respawn\"}}\n   681\t\t\t} else {\n   682\t\t\t\toutcome.Outcome = OutcomeCompleted\n   683\t\t\t}\n   684\t\t\trun.Safety.Operation = outcome\n   685\t\t}\n   686\t\tdefer func() {\n   687\t\t\tdoCleanup()\n   688\t\t\tif cleanupErr != nil {\n   689\t\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n   690\t\t\t}\n   691\t\t}()\n   692\t\ttranscript := []byte{}\n   693\t\tfinish := func(status, failure string) (ReviewRun, error) {\n   694\t\t\tdoCleanup()\n   695\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n   696\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n   697\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n   698\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n   699\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n   700\t\t\t}\n   701\t\t\trun.sessionForRedaction = \"\"\n   702\t\t\trun.Status, run.Failure = status, failure\n   703\t\t\tif status != ReviewRunInterrupted {\n   704\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n   705\t\t\t}\n   706\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n   707\t\t\treturn s.recordReviewRun(run, transcript)\n   708\t\t}\n   709\t\t// Recompute semantic freshness at execution time, not just preview time.\n   710\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n   711\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   712\t\t}\n   713\t\tvar attempt DelegatedReviewAttempt\n   714\t\tif plan.predecessor == nil {\n   715\t\t\tvar err error\n   716\t\t\tattempt, err = s.reserveDelegatedReviewAttempt(plan, now())\n   717\t\t\tif err != nil {\n   718\t\t\t\treturn ReviewRun{}, err\n   719\t\t\t}\n   720\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n   721\t\t} else {\n   722\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n   723\t\t\tfresh, err := s.replanContinuation(plan)\n   724\t\t\tif err != nil {\n   725\t\t\t\treturn ReviewRun{}, err\n   726\t\t\t}\n   727\t\t\tif fresh.PendingContinuation != nil {\n   728\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n   729\t\t\t}\n   730\t\t\tif fresh.Existing != nil {\n   731\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   732\t\t\t}\n   733\t\t\tplan = fresh\n   734\t\t\trun.Provenance = fresh.provenance\n   735\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n   736\t\t\tif fresh.handoff {\n   737\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n   738\t\t\t} else {\n   739\t\t\t\trun.Resumes = fresh.predecessor.RunID\n   740\t\t\t}\n   741\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n   742\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n   743\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n   744\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n   745\t\t\t\treturn ReviewRun{}, err\n   746\t\t\t}\n   747\t\t}\n   748\t\t// The attempt result is published once: before the active marker goes\n   749\t\t// when the run was marked, at return otherwise (spec\n   750\t\t// pose-delegation-result-before-marker R1–R2).\n   751\t\tresultPublished := false\n   752\t\tpublishResult := func() {\n   753\t\t\tif resultPublished || result.RunID == \"\" {\n   754\t\t\t\treturn\n   755\t\t\t}\n   756\t\t\tresultPublished = true\n   757\t\t\tbeforeRunResultPublished(result)\n   758\t\t\tvar err error\n   759\t\t\tif plan.predecessor == nil {\n   760\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   790\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n   791\t\t}\n   792\t\tsafety.RuntimeID = filepath.Base(tmp)\n   793\t\towned, err := os.Lstat(tmp)\n   794\t\tif err != nil {\n   795\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n   796\t\t}\n   797\t\truntimeRoot, err := os.OpenRoot(tmp)\n   798\t\tif err != nil {\n   799\t\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n   800\t\t}\n   801\t\tdefer runtimeRoot.Close()\n   802\t\tvar worktreeOwned os.FileInfo\n   803\t\tvar gitMarker []byte\n   804\t\tvar ownership *reviewCleanupOwnership\n   805\t\tworktree := filepath.Join(tmp, \"worktree\")\n   806\t\tcleanup = func() error {\n   807\t\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n   808\t\t}\n   809\t\thooks := filepath.Join(tmp, \"empty-hooks\")\n   810\t\tif err := os.Mkdir(hooks, 0700); err != nil {\n   811\t\t\treturn finish(ReviewRunFailed, \"private hook directory setup failed\")\n   812\t\t}\n   813\t\tsetupCtx, stopSetup := context.WithTimeout(parent, 2*time.Minute)\n   814\t\tdefer stopSetup()\n   815\t\tsetup := reviewSetupCommand(setupCtx, gitCommand(\"-C\", s.Root, \"-c\", \"core.hooksPath=\"+hooks, \"worktree\", \"add\", \"--detach\", worktree, plan.SealedCommit))\n   816\t\tsetupOutput := &reviewBoundedCapture{limit: 64