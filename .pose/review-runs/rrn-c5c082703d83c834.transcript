ext(parent context.Context, plan DispatchPlan, now func() time.Time) (result ReviewRun, resultErr error) {\npose-mcp/internal/pose/review_dispatch.go:966:\t// publish derived records into it (SealedCheckoutEnv).\npose-mcp/internal/pose/review_dispatch.go:967:\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\npose-mcp/internal/pose/review_dispatch.go:1023:\tif reaped, reapErr := reapSealedCheckoutProcesses(worktree); reapErr != nil {\npose-mcp/internal/pose/review_dispatch.go:1471:func (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\npose-mcp/internal/pose/delegation_active.go:32:type DelegationActiveRun struct {\npose-mcp/internal/pose/delegation_active.go:239:func (s Store) ListDelegationActive() ([]DelegationActiveRun, []string, error) {\n\n--- reaper with line numbers ---\n     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Leftover reviewer processes (spec\n     6\t// pose-review-run-reaps-lingering-reviewer-processes R1): an adapter such as\n     7\t// `codex exec` runs each command in a session of its own, so killing the\n     8\t// adapter's process group misses a command the reviewer left running, and\n     9\t// that command keeps writing into the run's runtime directory while the\n    10\t// cleanup inventory reads it. Every process of the run inherits\n    11\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n    12\t// that entry, ends them and waits for them before the inventory.\n    13\t\n    14\timport (\n    15\t\t\"bytes\"\n    16\t\t\"fmt\"\n    17\t\t\"os\"\n    18\t\t\"path/filepath\"\n    19\t\t\"strconv\"\n    20\t\t\"strings\"\n    21\t\t\"syscall\"\n    22\t\t\"time\"\n    23\t)\n    24\t\n    25\tconst reviewReapWait = 5 * time.Second\n    26\t\n    27\t// reapSealedCheckoutProcesses ends every process whose environment names\n    28\t// worktree as its sealed checkout and returns a description of each. An\n    29\t// error means a process could not be ended within the bound.\n    30\tfunc reapSealedCheckoutProcesses(worktree string) ([]string, error) {\n    31\t\tif worktree == \"\" {\n    32\t\t\treturn nil, nil\n    33\t\t}\n    34\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n    35\t\tself := os.Getpid()\n    36\t\tfind := func() map[int]string {\n    37\t\t\tfound := map[int]string{}\n    38\t\t\tdirs, err := os.ReadDir(\"/proc\")\n    39\t\t\tif err != nil {\n    40\t\t\t\treturn found\n    41\t\t\t}\n    42\t\t\tfor _, d := range dirs {\n    43\t\t\t\tpid, err := strconv.Atoi(d.Name())\n    44\t\t\t\tif err != nil || pid == self {\n    45\t\t\t\t\tcontinue\n    46\t\t\t\t}\n    47\t\t\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", d.Name(), \"environ\"))\n    48\t\t\t\tif err != nil {\n    49\t\t\t\t\tcontinue\n    50\t\t\t\t}\n    51\t\t\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n    52\t\t\t\t\tif bytes.Equal(kv, entry) {\n    53\t\t\t\t\t\tfound[pid] = reviewProcessName(pid)\n    54\t\t\t\t\t\tbreak\n    55\t\t\t\t\t}\n    56\t\t\t\t}\n    57\t\t\t}\n    58\t\t\treturn found\n    59\t\t}\n    60\t\tvar reaped []string\n    61\t\tseen := map[int]bool{}\n    62\t\tdeadline := time.Now().Add(reviewReapWait)\n    63\t\tfor {\n    64\t\t\talive := find()\n    65\t\t\tfor pid, name := range alive {\n    66\t\t\t\tif reviewProcessZombie(pid) {\n    67\t\t\t\t\tdelete(alive, pid)\n    68\t\t\t\t\tcontinue\n    69\t\t\t\t}\n    70\t\t\t\tif !seen[pid] {\n    71\t\t\t\t\tseen[pid] = true\n    72\t\t\t\t\treaped = append(reaped, fmt.Sprintf(\"%d %s\", pid, name))\n    73\t\t\t\t}\n    74\t\t\t\t_ = syscall.Kill(pid, syscall.SIGKILL)\n    75\t\t\t}\n    76\t\t\tif len(alive) == 0 {\n    77\t\t\t\treturn reaped, nil\n    78\t\t\t}\n    79\t\t\tif time.Now().After(deadline) {\n    80\t\t\t\treturn reaped, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n    81\t\t\t}\n    82\t\t\ttime.Sleep(50 * time.Millisecond)\n    83\t\t}\n    84\t}\n    85\t\n    86\tfunc reviewProcessName(pid int) string {\n    87\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n    88\t\tif err != nil {\n    89\t\t\treturn \"?\"\n    90\t\t}\n    91\t\treturn strings.TrimSpace(string(raw))\n    92\t}\n    93\t\n    94\tfunc reviewProcessZombie(pid int) bool {\n    95\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n    96\t\tif err != nil {\n    97\t\t\treturn true // gone\n    98\t\t}\n    99\t\t// The state follows the parenthesised command name.\n   100\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   101\t\t\treturn raw[i+2] == 'Z'\n   102\t\t}\n   103\t\treturn false\n   104\t}\n\n--- release with line numbers ---\n     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt and marking it active, but before\n     6\t// recording its run, leaves a reservation without a receipt. Every later\n     7\t// dispatch of the bundle refuses on it, and cancellation refused it because\n     8\t// nothing runs. Once its owner is proven dead (the marker is stalled), the\n     9\t// attempt is closed by the same records a run that failed writes: a failed\n    10\t// run naming the abandonment, its receipt, and the marker's removal. Nothing\n    11\t// is deleted from the ledger.\n    12\t\n    13\timport (\n    14\t\t\"errors\"\n    15\t\t\"fmt\"\n    16\t\t\"os\"\n    17\t\t\"path/filepath\"\n    18\t\t\"time\"\n    19\t)\n    20\t\n    21\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    22\t// proven abandoned.\n    23\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    24\t\n    25\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    26\t// dispatch ended before recording it, and removes its stalled marker.\n    27\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time) (ReviewRun, error) {\n    28\t\tmarkers, _, err := s.ListDelegationActive()\n    29\t\tif err != nil {\n    30\t\t\treturn ReviewRun{}, err\n    31\t\t}\n    32\t\tvar marker *DelegationActiveRun\n    33\t\tfor i := range markers {\n    34\t\t\tif markers[i].AttemptID == attemptID {\n    35\t\t\t\tmarker = &markers[i]\n    36\t\t\t}\n    37\t\t}\n    38\t\tif marker == nil || marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead {\n    39\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    40\t\t}\n    41\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    42\t\tif err != nil {\n    43\t\t\treturn ReviewRun{}, err\n    44\t\t}\n    45\t\tvar reserved *DelegatedReviewAttempt\n    46\t\tfor i := range attempts {\n    47\t\t\tif attempts[i].AttemptID == attemptID {\n    48\t\t\t\treserved = &attempts[i]\n    49\t\t\t}\n    50\t\t}\n    51\t\tif reserved == nil {\n    52\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: bundle %s holds no reservation %s\", ErrAttemptNotAbandoned, marker.BundleID, attemptID)\n    53\t\t}\n    54\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); !errors.Is(err, os.ErrNotExist) {\n    55\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n    56\t\t}\n    57\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n    58\t\t\tKind: DelegationKindForPurpose(marker.Purpose), Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n    59\t\t\tStartedAt: marker.StartedAt, ExitCode: -1, Label: marker.Label, Purpose: marker.Purpose, Round: marker.Round,\n    60\t\t\tStatus: ReviewRunFailed, Failure: \"abandoned: the dispatching process ended before the run was recorded (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\",\n    61\t\t\tEndedAt: now.UTC().Format(time.RFC3339Nano)}\n    62\t\trecorded, err := s.recordReviewRun(run, nil)\n    63\t\tif err != nil {\n    64\t\t\treturn ReviewRun{}, err\n    65\t\t}\n    66\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n    67\t\t\treturn recorded, err\n    68\t\t}\n    69\t\tif dir, err := s.delegationActiveDir(false); err == nil {\n    70\t\t\tfor _, p := range []string{filepath.Join(dir, attemptID+\".json\"), stallClaimPath(dir, *marker), cancelRequestPath(dir, *marker)} {\n    71\t\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n    72\t\t\t\t\treturn recorded, err\n    73\t\t\t\t}\n    74\t\t\t}\n    75\t\t}\n    76\t\treturn recorded, nil\n    77\t}\n\n--- reap regression tests ---\npose-mcp/internal/pose/review_adapter_containment_regression_test.go-92-\tstore                Store\npose-mcp/internal/pose/review_adapter_containment_regression_test.go-93-\ttmp, worktree        string\npose-mcp/internal/pose/review_adapter_containment_regression_test.go-94-\towned, worktreeOwned os.FileInfo\npose-mcp/internal/pose/review_adapter_containment_regression_test.go-95-\tmarker               []byte\npose-mcp/internal/pose/review_adapter_containment_regression_test.go-96-\truntimeRoot          *os.Root\npose-mcp/internal/pose/review_adapter_containment_regression_test.go:97:\townership            *reviewCleanupOwnership\npose-mcp/internal/pose/review_adapter_containment_regression_test.go-98-}\npose-mcp/internal/pose/review_adapter_containment_regression_test.go-99-\npose-mcp/internal/pose/review_adapter_containment_regression_test.go-100-func makeContainmentCleanupFixture(t *testing.T) containmentCleanupFixture {\npose-mcp/internal/pose/review_adapter_containment_regression_test.go-101-\tt.Helper()\npose-mcp/internal/pose/review_adapter_containment_regression_test.go-102-\trepo := t.TempDir()\n--\npose-mcp/internal/pose/review_adapter_containment_regression_test.go-140-\tmarker, err 