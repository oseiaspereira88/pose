", \"outside writes, transient writes, shared Git and credential files are not isolated\", \"no memory/CPU quota or control of descendants escaping the process group\", \"cleanup filesystem calls remain subject to operating-system I/O latency\"}}\n   131\t\tif runtime.GOOS == \"linux\" {\n   132\t\t\tif err := reviewProcessGroupAvailable(); err == nil {\n   133\t\t\t\tr.Capabilities[\"process-group-termination\"] = \"available\"\n   134\t\t\t\t// A descendant that left the group is still ended while its\n   135\t\t\t\t// environment keeps the run's sealed-checkout entry; one that\n   136\t\t\t\t// clears it is not, so the guarantee is not \"available\" (spec\n   137\t\t\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, L1).\n   138\t\t\t\tr.Capabilities[\"escaped-descendant-termination\"] = \"environment-marked\"\n   139\t\t\t\tfor i, limit := range r.Limitations {\n   140\t\t\t\t\tif limit == \"no memory/CPU quota or control of descendants escaping the process group\" {\n   141\t\t\t\t\t\tr.Limitations[i] = \"no memory/CPU quota; descendants escaping the process group are ended only while they keep the run's sealed-checkout environment entry\"\n   142\t\t\t\t\t}\n   143\t\t\t\t}\n   144\t\t\t} else {\n   145\t\t\t\tr.Capabilities[\"process-group-termination\"] = \"unavailable\"\n   146\t\t\t\tr.Limitations = append(r.Limitations, \"process inventory not observable on this host\")\n   147\t\t\t}\n   148\t\t} else {\n   149\t\t\tr.Limitations = append(r.Limitations, \"process-group termination not qualified on this platform\")\n   150\t\t}\n   151\t\tp := a.Containment\n   152\t\tif p == nil {\n   153\t\t\tr.Limitations = append(r.Limitations, \"legacy compatibility: HOME retained; other ambient credentials excluded\")\n   154\t\t\treturn r, nil\n   155\t\t}\n   156\t\tif p.SchemaVersion != 1 || p.Profile != \"trusted-process\" {\n   157\t\t\treturn nil, fmt.Errorf(\"unsupported containment schema/profile; use schema_version 1 and trusted-process\")\n   158\t\t}\n   159\t\tr.Profile = p.Profile\n   160\t\tfor _, limit := range []struct {\npose-mcp/internal/scaffold/dist/POSE.md:1065:**Runs that leave work behind.** After the adapter exits, the dispatch also ends every process whose environment names the run's sealed checkout (`POSE_SEALED_CHECKOUT`), which catches commands a reviewer started in a session of its own, waits for them, and lists them in the run's `safety.limitations` before the cleanup inventory; the brief of template `review-brief/10` asks the reviewer to let its commands finish. A dispatch that ended between reserving its attempt and recording its run leaves the attempt stalled and every later dispatch of the bundle refused; `pose delegate cancel <attempt>` releases it once its owner is proven gone, recording a failed run and its receipt.\nPOSE.md:1078:**Runs that leave work behind.** After the adapter exits, the dispatch also ends every process whose environment names the run's sealed checkout (`POSE_SEALED_CHECKOUT`), which catches commands a reviewer started in a session of its own, waits for them, and lists them in the run's `safety.limitations` before the cleanup inventory; the brief of template `review-brief/10` asks the reviewer to let its commands finish. A dispatch that ended between reserving its attempt and recording its run leaves the attempt stalled and every later dispatch of the bundle refused; `pose delegate cancel <attempt>` releases it once its owner is proven gone, recording a failed run and its receipt.\nlocales/pt-BR/POSE.md:1075:**Runs que deixam trabalho para trás.** Depois que o adaptador termina, o envio também encerra todo processo cujo ambiente nomeia o checkout selado do run (`POSE_SEALED_CHECKOUT`), o que pega comandos que o revisor iniciou em sessão própria, espera que terminem e os lista em `safety.limitations` do run antes do inventário de limpeza; o brief do template `review-brief/10` pede ao revisor que deixe seus comandos terminarem. Um envio que terminou entre reservar a tentativa e registrar o run deixa a tentativa parada e todo envio seguinte do bundle recusado; `pose delegate cancel <tentativa>` a libera quando o dono está comprovadamente encerrado, registrando um run com falha e o seu recibo.\npose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md:1075:**Runs que deixam trabalho para trás.** Depois que o adaptador termina, o envio também encerra todo processo cujo ambiente nomeia o checkout selado do run (`POSE_SEALED_CHECKOUT`), o que pega comandos que o revisor iniciou em sessão própria, espera que terminem e os lista em `safety.limitations` do run antes do inventário de limpeza; o brief do template `review-brief/10` pede ao revisor que deixe seus comandos terminarem. Um envio que terminou entre reservar a tentativa e registrar o run deixa a tentativa parada e todo envio seguinte do bundle recusado; `pose delegate cancel <tentativa>` a libera quando o dono está comprovadamente encerrado, registrando um run com falha e o seu recibo.\n   149\t\tif activeErr != nil {\n   150\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   151\t\t}\n   152\t\tlost = append(lost, activeLost...)\n   153\t\tfor _, marker := range active {\n   154\t\t\trow, ok := byAttempt[marker.AttemptID]\n   155\t\t\tif !ok {\n   156\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   157\t\t\t\tbyAttempt[marker.AttemptID] = row\n   158\t\t\t\torder = append(order, marker.AttemptID)\n   159\t\t\t}\n   160\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   161\t\t\tif marker.Round > 0 {\n   162\t\t\t\trow.Round = marker.Round\n   163\t\t\t}\n   164\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   165\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   166\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   167\t\t\t}\n   168\t\t\tif marker.StalledAt != \"\" {\n   169\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   170\t\t\t}\n   171\t\t\t// A running run's progress comes from its live events (R12).\n   172\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   173\t\t\t\tfor _, e := range live {\n   710\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n   711\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   712\t\t}\n   713\t\tvar attempt DelegatedReviewAttempt\n   714\t\tif plan.predecessor == nil {\n   715\t\t\tvar err error\n   716\t\t\tattempt, err = s.reserveDelegatedReviewAttempt(plan, now())\n   717\t\t\tif err != nil {\n   718\t\t\t\treturn ReviewRun{}, err\n   719\t\t\t}\n   720\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n   721\t\t} else {\n   722\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n   723\t\t\tfresh, err := s.replanContinuation(plan)\n   724\t\t\tif err != nil {\n   725\t\t\t\treturn ReviewRun{}, err\n   726\t\t\t}\n   727\t\t\tif fresh.PendingContinuation != nil {\n   728\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n   729\t\t\t}\n   730\t\t\tif fresh.Existing != nil {\n   731\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   732\t\t\t}\n   733\t\t\tplan = fresh\n   734\t\t\trun.Provenance = fresh.provenance\n   735\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n   736\t\t\tif fresh.handoff {\n   737\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n   738\t\t\t} else {\n   739\t\t\t\trun.Resumes = fresh.predecessor.RunID\n   740\t\t\t}\n   741\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n   742\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n   743\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n   744\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n   745\t\t\t\treturn ReviewRun{}, err\n   746\t\t\t}\n   747\t\t}\n   748\t\t// The attempt result is published once: before the active marker goes\n   749\t\t// when the run was marked, at return otherwise (spec\n   750\t\t// pose-delegation-result-before-marker R1–R2).\n   751\t\tresultPublished := false\n   752\t\tpublishResult := func() {\n   753\t\t\tif resultPublished || result.RunID == \"\" {\n   754\t\t\t\treturn\n   755\t\t\t}\n   756\t\t\tresultPublished = true\n   757\t\t\tbeforeRunResultPublished(result)\n   758\t\t\tvar err error\n   759\t\t\tif plan.predecessor == nil {\n   760\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   761\t\t\t} else {\n   762\t\t\t\terr = s.finishReviewContinuation(result)\n   763\t\t\t}\n   764\t\t\tif err != nil {\n   765\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n   766\t\t\t}\n   767\t\t}\n   768\t\tdefer publishResult()\n   769\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n   770\t\tif err != nil {\n   771\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   772\t\t}\n   773\t\t// The marker goes only once the record and the attempt result are\n   774\t\t// published: without them it is the one trace of the reserved attempt,\n   775\t\t// and a waiter that sees it gone must find the receipt.\n   776\t\tdefer func() {\n   777\t\t\tpublishResult()\n   778\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n   779\t\t}()\n   780\t\tcancelled = cancelFlag\n   781\t\t// A detached run that cannot hand its attempt back stops here: nobody\n   782\t\t// would know which attempt runs (R1).\n   783\t\tif plan.OnStart != nil {\n   784\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n   785\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n","exit_code":0,"status":"completed"}}
