` followed by the command you ran; a bare command line is refused; (i) a draft that approves leaves no finding open: each finding is either a follow-up with `action`, `owner` and `review_by`, which is recorded as an accepted risk, or the draft requests changes; a finding without them is open and the approval is refused.\"\npose-mcp/internal/pose/causality_cutoff_test.go:81:  \"criteria\": [{\"id\": \"design-causality\", \"kind\": \"judgment\", \"requires_structural_mapping\": true, \"description\": \"Map each material fact.\"}]\npose-mcp/internal/pose/spec_transfer_test.go:75:\t\tout = append(out, SpecTransferRequirementMapping{SourceRequirement: id, DestinationRequirement: id, Disposition: \"equivalent\"})\npose-mcp/internal/pose/spec_transfer_test.go:265:\trequest.Mappings = []SpecTransferRequirementMapping{{SourceRequirement: \"R99\", DestinationRequirement: \"R1\", Disposition: \"equivalent\"}}\npose-mcp/internal/pose/review_structure_test.go:221:func causalityBlockers(t *testing.T, store Store, mappings []ReviewCriterionMapping, disposition string) []string {\npose-mcp/internal/pose/review_structure_test.go:243:\tblockers := causalityBlockers(t, store, []ReviewCriterionMapping{{Delta: \"SD-aaaa1111\", Basis: \"D1\"}}, \"\")\npose-mcp/internal/pose/review_structure_test.go:245:\tfull := causalityBlockers(t, store, []ReviewCriterionMapping{\npose-mcp/internal/pose/review_structure_test.go:250:\t\tt.Fatalf(\"a fully mapped judgment was blocked: %+v\", full)\npose-mcp/internal/pose/review_structure_test.go:258:\tassertBlocker(t, causalityBlockers(t, store, []ReviewCriterionMapping{\npose-mcp/internal/pose/review_structure_test.go:262:\tassertBlocker(t, causalityBlockers(t, store, []ReviewCriterionMapping{\npose-mcp/internal/pose/review_structure_test.go:281:\t\t{\"\", \"as mapped and names no basis\"},\npose-mcp/internal/pose/review_structure_test.go:284:\t\t\tmapping := ReviewCriterionMapping{Delta: \"SD-aaaa1111\", Basis: tc.basis}\npose-mcp/internal/pose/review_