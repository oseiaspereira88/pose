t\t}\n   859\t\tgitlinkErr := gitlinks.materialize(s.Root, worktree, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries)\n   860\t\townership.inventoryBytes = gitSnapshotBudget(committedWorktreeBytes + gitlinks.committedBytes)\n   861\t\townership.gitlinkMetadata = gitlinks.metadataOwned\n   862\t\townership.gitlinkMetadataBytes = gitSnapshotBudget(gitlinks.committedBytes)\n   863\t\tif gitlinkErr != nil {\n   864\t\t\tterminationFailed = gitlinks.terminationFailure\n   865\t\t\tsafety.ExecutionCause = executionCause(setupCtx)\n   866\t\t\tif gitlinks.captureOverflow {\n   867\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   868\t\t\t}\n   869\t\t\treturn finish(ReviewRunFailed, \"sealed gitlink setup failed: \"+gitlinkErr.Error())\n   870\t\t}\n   871\t\tstopSetup()\n   872\t\tcheckout := s\n   873\t\tcheckout.Root, checkout.indexPin = worktree, nil\n   874\t\tif prepared, err := checkout.PrepareReviewBundle(plan.Brief.Scope); err != nil {\n   875\t\t\treturn finish(ReviewRunFailed, \"sealed checkout inputs unavailable: \"+err.Error())\n   876\t\t} else if blockers := checkoutBlockers(prepared.Blockers); len(blockers) > 0 {\n   877\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout blocked: %v\", blockers))\n   878\t\t} else if differing := sealedInputsThatDiffer(plan.Bundle, prepared, worktree); len(differing) > 0 {\n   879\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout inputs differ: %v\", differing))\n   880\t\t}\n   881\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n   882\t\t\treturn finish(ReviewRunFailed, err.Error())\n   883\t\t}\n   884\t\tif err := verifyBundleMaterialization(worktree, plan.Bundle); err != nil {\n   885\t\t\treturn finish(ReviewRunFailed, err.Error())\n   886\t\t}\n   887\t\tif plan.Purpose == DelegationPurposeReview && plan.Config.Events == DelegationEventsClaudeStreamJSON {\n   888\t\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n   88