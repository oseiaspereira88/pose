{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch_unix.go | sed -n '125,165p' && nl -ba pose-mcp/internal/pose/review_adapter_containment.go | sed -n '180,210p' && rg -n 'reaper|/proc.*environ|reviewProcessZombie|reviewReapWait' pose-mcp/internal/pose/*test.go\"","aggregated_output":"   125\t\tsync.Mutex\n   126\t\tok time.Time\n   127\t}\n   128\t\n   129\tconst processGroupProbeTTL = time.Minute\n   130\t\n   131\t// processGroupVerify is the walk the probe runs; tests count it.\n   132\tvar processGroupVerify = verifyReviewProcessGroup\n   133\t\n   134\tfunc reviewProcessGroupAvailable() error {\n   135\t\tprocessGroupProbe.Lock()\n   136\t\tdefer processGroupProbe.Unlock()\n   137\t\tif !processGroupProbe.ok.IsZero() && time.Since(processGroupProbe.ok) < processGroupProbeTTL {\n   138\t\t\treturn nil\n   139\t\t}\n   140\t\tif err := processGroupVerify(-1); err != nil {\n   141\t\t\treturn err\n   142\t\t}\n   143\t\tprocessGroupProbe.ok = time.Now()\n   144\t\treturn nil\n   145\t}\n   146\tfunc openReviewRootFile(root *os.Root, path string) (*os.File, error) {\n   147\t\treturn root.OpenFile(path, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)\n   148\t}\n   180\t\t\treturn nil, fmt.Errorf(\"memory/CPU enforcement unavailable in trusted-process; omit memory_bytes/cpu_time_ms\")\n   181\t\t}\n   182\t\tfor _, capability := range p.Required {\n   183\t\t\tstate, ok := r.Capabilities[capability]\n   184\t\t\tif !ok || state != \"available\" {\n   185\t\t\t\treturn nil, fmt.Errorf(\"required capability %q unsupported/unavailable on %s; select a qualified backend or remove that requirement\", capability, r.Platform)\n   186\t\t\t}\n   187\t\t}\n   188\t\tif len(p.Environment) > 128 || len(p.Credentials) > 32 {\n   189\t\t\treturn nil, fmt.Errorf(\"environment allowlist exceeds 128 names or 32 credential names\")\n   190\t\t}\n   191\t\tseen := map[string]bool{}\n   192\t\tfor _, name := range append(append([]string{}, p.Environment...), p.Credentials...) {\n   193\t\t\tif len(name) > 128 || !adapterEnvironmentName.MatchString(name) || seen[strings.ToUpper(name)] {\n   194\t\t\t\treturn nil, fmt.Errorf(\"environment/credentials require unique valid variable names\")\n   195\t\t\t}\n   196\t\t\tupper := strings.ToUpper(name)\n   197\t\t\tseen[upper] = true\n   198\t\t\t// Loader hooks can turn a trusted binary into an unrelated executable.\n   199\t\t\tif strings.HasPrefix(upper, \"LD_\") || strings.HasPrefix(upper, \"DYLD_\") || strings.HasPrefix(upper, \"GIT_\") || upper == \"BASH_ENV\" || upper == \"ENV\" || upper == \"SHELLOPTS\" || upper == \"HOME\" || upper == \"USERPROFILE\" || upper == \"TMPDIR\" || upper == \"TMP\" || upper == \"TEMP\" {\n   200\t\t\t\treturn nil, fmt.Errorf(\"environment variable %s is reserved or unsafe\", name)\n   201\t\t\t}\n   202\t\t}\n   203\t\tfor _, name := range p.Environment {\n   204\t\t\tupper := strings.ToUpper(name)\n   205\t\t\tfor _, mark := range []string{\"TOKEN\", \"SECRET\", \"PASSWORD\", \"CREDENTIAL\", \"API_KEY\", \"PRIVATE_KEY\"} {\n   206\t\t\t\tif strings.Contains(upper, mark) {\n   207\t\t\t\t\treturn nil, fmt.Errorf(\"sensitive environment variable %s requires credentials authorization\", name)\n   208\t\t\t\t}\n   209\t\t\t}\n   210\t\t}\n","exit_code":1,"status":"failed"}}
