{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_adapter_containment.go | sed -n '120,160p' && rg -n -F 'Runs that leave work behind' POSE.md pose-mcp/internal/scaffold/dist/POSE.md && rg -n -F 'Runs que deixam trabalho para trás' locales/pt-BR/POSE.md pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md && nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '149,173p' && nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '710,785p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
