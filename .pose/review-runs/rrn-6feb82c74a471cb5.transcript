artifact_integrity.go:270:\tgitStream := changeSetGitStream(files, root)\npose-mcp/internal/cli/artifact_integrity.go:449:\tstream := changeSetGitStream(files, root)\npose-mcp/internal/pose/milestone_review_proportional_test.go:57:\tbundle, err := s.SealReviewBundle(\"milestone:program/core\", reviewFixtureNow.Add(2*time.Minute))\npose-mcp/internal/pose/milestone_review_proportional_test.go:73:\tapproveCore(t, s, reviewFixtureNow.Add(2*time.Minute))\npose-mcp/internal/pose/milestone_review_proportional_test.go:171:\tbundle, err := s.SealReviewBundle(\"roadmap:program\", reviewFixtureNow.Add(2*time.Minute))\npose-mcp/internal/pose/milestone_review_proportional_test.go:264:\tbundle, err := refused.SealReviewBundle(\"milestone:program/core\", reviewFixtureNow.Add(2*time.Minute))\npose-mcp/internal/pose/milestone_review_proportional_test.go:321:\troadmap, err := s.SealReviewBundle(\"roadmap:program\", reviewFixtureNow.Add(2*time.Minute))\npose-mcp/internal/pose/milestone_review_proportional_test.go:388:\tbundle, err := s.SealReviewBundle(\"roadmap:program\", reviewFixtureNow.Add(2*time.Minute))\npose-mcp/internal/pose/milestone_review_proportional_test.go:410:\t\t\troadmap, err := s.SealReviewBundle(\"roadmap:program\", reviewFixtureNow.Add(2*time.Minute))\npose-mcp/internal/pose/milestone_review_proportional_test.go:461:\tbundle, err := s.SealReviewBundle(\"milestone:program/core\", reviewFixtureNow.Add(2*time.Minute))\npose-mcp/internal/pose/issuer_key_test.go:131:\tif _, err := f.store.RecordReviewAttestation(f.attestation(t, \"agent:reviewer\", \"agent:implementer\", \"review-run-3\", \"implementation-run-1\"), f.now.Add(2*time.Minute)); err != nil {\npose-mcp/internal/pose/review_authority_test.go:106:\treturn recordAndVerifyOrRefusal(t, f.store, \"spec:backend\", att, f.now.Add(2*time.Minute))\npose-mcp/internal/pose/review_conclusions.go:320:const reviewConclusionLockWait = 2 * time.Minute\npose-mcp/internal/pose/completed_review_retention_test.go:89:\t\tsecond, err := store.SealReviewBundle(\"spec:backend\", now.Add(2*time.Minute))\npose-mcp/internal/pose/completed_review_retention_test.go:116:\t\tsecond, err := store.SealReviewBundle(\"spec:backend\", now.Add(2*time.Minute))\n310:    \"pose-read-view-audit-repeats-a-read-under-its-own-time\": \"sha256:e9d4ef8d1b01f16123f6f1b14e8ca568a07a77ac6a9312105d89727d64a4fa7f\",\n781:    \"pose-read-view-audit-repeats-a-read-under-its-own-time\": \"sha256:899bfa2f757712e9372f22e02e20be5e30631519b6f420f6a549cfe2e8b1f4ca\",\n4335:      \"id\": \"pose-mcp/go/read-view-audit-repeats-a-read-under-its-own-time-integration\",\n4338:      \"name\": \"read-view-audit-repeats-a-read-under-its-own-time-integration\",\n","exit_code":0,"status":"completed"}}
