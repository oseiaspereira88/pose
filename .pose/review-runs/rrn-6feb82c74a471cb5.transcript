{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/governance_read_view_git.go | sed -n '330,590p'; nl -ba pose-mcp/internal/pose/governance_read_view_stream.go | sed -n '1,260p'\"","aggregated_output":"   330\t}\n   331\t\n   332\t// A read's deadline bounds how long that read may take, not when the final\n   333\t// audit may repeat it: the audit gives the repeated read the same time the\n   334\t// read had, counted from when the audit runs. An absolute deadline expired\n   335\t// before the audit of any operation longer than it, and every such read was\n   336\t// reported as changed (spec pose-read-view-audit-repeats-a-read-under-its-own-time).\n   337\tfunc auditTimeout(deadline time.Time, captured time.Time) time.Duration {\n   338\t\tif timeout := deadline.Sub(captured); timeout > 0 {\n   339\t\t\treturn timeout\n   340\t\t}\n   341\t\treturn time.Millisecond\n   342\t}\n   343\t\n   344\tfunc (state *governanceReadViewGitState) capture(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n   345\t\tif state == nil || state.op == nil {\n   346\t\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n   347\t\t}\n   348\t\tif ctx == nil {\n   349\t\t\tctx = context.Background()\n   350\t\t}\n   351\t\tdeadline, hasDeadline := ctx.Deadline()\n   352\t\ttimeout := auditTimeout(deadline, time.Now())\n   353\t\tauditContext := context.WithoutCancel(ctx)\n   354\t\tkey := governanceGitObservationKey(root, args, maxOutputBytes)\n   355\t\tstate.mu.Lock()\n   356\t\tif prior := state.observations[key]; prior != nil {\n   357\t\t\tprior.producers[producer] = true\n   358\t\t\tstdout, err := append([]byte(nil), prior.stdout...), prior.err\n   359\t\t\tstate.mu.Unlock()\n   360\t\t\treturn stdout, err\n   361\t\t}\n   362\t\tmetadataCost := int64(len(root) + len(key) + len(producer) + 128)\n   363\t\tif !state.op.reserveRecord(metadataCost) {\n   364\t\t\tstate.mu.Unlock()\n   365\t\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its shared record or metadata budget while capturing Git\")\n   366\t\t\treturn nil, errGovernanceReadViewBudget\n   367\t\t}\n   368\t\tlimit := maxOutputBytes\n   369\t\tif state.op.remainingInput() < limit {\n   370\t\t\tlimit = state.op.remainingInput()\n   371\t\t}\n   372\t\tif limit <= 0 {\n   373\t\t\tstate.mu.Unlock()\n   374\t\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its Git input byte budget\")\n   375\t\t\treturn nil, errGovernanceReadViewBudget\n   376\t\t}\n   377\t\tbyObject, byHead := governancePureGitRead(args)\n   378\t\theadBefore := \"\"\n   379\t\tif byHead {\n   380\t\t\theadBefore = governanceHeadAt(ctx, files, root)\n   381\t\t}\n   382\t\t// A process that turned the resident memo on answers a pure read from it; the bytes are\n   383\t\t// admitted against the operation's budget as a fresh read's are.\n   384\t\tvar stdout, stderr []byte\n   385\t\tvar runErr error\n   386\t\tmemoKey, memoized := \"\", false\n   387\t\tmemo := residentGit.Load()\n   388\t\tif memo != nil && (byObject || byHead && headBefore != \"\") {\n   389\t\t\tif key, ok := residentGitKey(root, headBefore, state.effectiveGitConfig(ctx, files, root), args); ok {\n   390\t\t\t\tmemoKey = key\n   391\t\t\t\tif hit, found := memo.get(key); found {\n   392\t\t\t\t\tif int64(len(hit)) > limit || !state.op.reserveInput(int64(len(hit))) {\n   393\t\t\t\t\t\tstate.mu.Unlock()\n   394\t\t\t\t\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n   395\t\t\t\t\t\treturn nil, errGovernanceReadViewBudget\n   396\t\t\t\t\t}\n   397\t\t\t\t\tstdout, memoized = hit, true\n   398\t\t\t\t}\n   399\t\t\t}\n   400\t\t}\n   401\t\tif !memoized {\n   402\t\t\tstdout, stderr, runErr = runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, state.op.reserveInput)\n   403\t\t}\n   404\t\tif errors.Is(runErr, errGovernanceReadViewBudget) {\n   405\t\t\tstate.mu.Unlock()\n   406\t\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n   407\t\t\treturn nil, errGovernanceReadViewBudget\n   408\t\t}\n   409\t\tobservation := &governanceReadViewGitObservation{\n   410\t\t\troot: root, args: append([]string(nil), args...), files: files, ctx: auditContext, deadline: deadline, hasDeadline: hasDeadline, timeout: timeout, maxOutputBytes: maxOutputBytes,\n   411\t\t\tstdout: append([]byte(nil), stdout...), stderr: append([]byte(nil), stderr...), err: runErr, errText: errorText(runErr),\n   412\t\t\tproducers: map[string]bool{producer: true},\n   413\t\t}\n   414\t\tif runErr == nil && len(stderr) == 0 {\n   415\t\t\tswitch {\n   416\t\t\tcase byObject:\n   417\t\t\t\tobservation.pure = true\n   418\t\t\tcase memoized && byHead:\n   419\t\t\t\t// The commit is the one the memo's key names; nothing ran, so there is no second read.\n   420\t\t\t\tobservation.pure, observation.headAt = true, headBefore\n   421\t\t\tcase byHead && headBefore != \"\" && governanceHeadAt(ctx, files, root) == headBefore:\n   422\t\t\t\tobservation.pure, observation.headAt = true, headBefore\n   423\t\t\t}\n   424\t\t\tif memoKey != \"\" && !memoized && observation.pure {\n   425\t\t\t\tmemo.put(memoKey, stdout)\n   426\t\t\t}\n   427\t\t}\n   428\t\tstate.observations[key] = observation\n   429\t\tstate.mu.Unlock()\n   430\t\tif isGovernanceGitHeadCommand(args) {\n   431\t\t\tif runErr != nil {\n   432\t\t\t\tif !state.op.mayOmitPrimaryRevision(root) {\n   433\t\t\t\t\tstate.markUnknownForRoot(root, producer, \"source revision could not be read from Git\")\n   434\t\t\t\t}\n   435\t\t\t} else {\n   436\t\t\t\trevision := strings.TrimSpace(string(stdout))\n   437\t\t\t\tif revision == \"\" && state.op.mayOmitPrimaryRevision(root) {\n   438\t\t\t\t\treturn append([]byte(nil), stdout...), runErr\n   439\t\t\t\t}\n   440\t\t\t\tstate.bindRevision(root, revision)\n   441\t\t\t}\n   442\t\t}\n   443\t\treturn append([]byte(nil), stdout...), runErr\n   444\t}\n   445\t\n   446\tfunc isGovernanceGitHeadCommand(args []string) bool {\n   447\t\treturn len(args) == 3 && args[0] == \"rev-parse\" && args[1] == \"--verify\" && args[2] == \"HEAD\"\n   448\t}\n   449\t\n   450\tfunc governanceGitObservationKey(root string, args []string, maxOutputBytes int64) string {\n   451\t\tencoded, _ := json.Marshal(args)\n   452\t\treturn filepath.Clean(root) + \"\\x00\" + string(encoded) + \"\\x00\" + fmt.Sprint(maxOutputBytes)\n   453\t}\n   454\t\n   455\tfunc (state *governanceReadViewGitState) bindRevision(root, revision string) {\n   456\t\tif revision == \"\" || state == nil || state.op == nil {\n   457\t\t\tstate.markUnknownForRoot(root, \"projection\", \"source revision binding is unavailable\")\n   458\t\t\treturn\n   459\t\t}\n   460\t\tstate.op.mu.Lock()\n   461\t\tfor _, entry := range state.op.roots {\n   462\t\t\tif sameLexicalRoot(entry.root, root) {\n   463\t\t\t\tentry.revision = revision\n   464\t\t\t\tstate.op.mu.Unlock()\n   465\t\t\t\treturn\n   466\t\t\t}\n   467\t\t}\n   468\t\tstate.op.mu.Unlock()\n   469\t\tstate.markUnknownForRoot(root, \"projection\", \"source revision root is outside the authorized vector\")\n   470\t}\n   471\t\n   472\tfunc (state *governanceReadViewGitState) markUnknownForRoot(root, producer, reason string) {\n   473\t\tif state == nil || state.op == nil {\n   474\t\t\treturn\n   475\t\t}\n   476\t\tstate.op.mu.Lock()\n   477\t\tvar view *governanceReadView\n   478\t\tfor _, entry := range state.op.roots {\n   479\t\t\tif sameLexicalRoot(entry.root, root) {\n   480\t\t\t\tview = entry.view\n   481\t\t\t\tbreak\n   482\t\t\t}\n   483\t\t}\n   484\t\tstate.op.mu.Unlock()\n   485\t\tif view == nil {\n   486\t\t\tview = state.op.primary\n   487\t\t}\n   488\t\tview.markUnknown(producer, reason)\n   489\t}\n   490\t\n   491\tfunc (state *governanceReadViewGitState) audit() governanceReadViewAudit {\n   492\t\tresult := governanceReadViewAudit{ChangedProducers: map[string]bool{}, UnknownProducers: map[string][]string{}}\n   493\t\tif state == nil {\n   494\t\t\treturn result\n   495\t\t}\n   496\t\tstate.mu.Lock()\n   497\t\tobservations := make([]governanceReadViewGitObservation, 0, len(state.observations))\n   498\t\tfor _, item := range state.observations {\n   499\t\t\tcopy := *item\n   500\t\t\tcopy.args = append([]string(nil), item.args...)\n   501\t\t\tcopy.stdout = append([]byte(nil), item.stdout...)\n   502\t\t\tcopy.stderr = append([]byte(nil), item.stderr...)\n   503\t\t\tcopy.producers = cloneBoolMap(item.producers)\n   504\t\t\tobservations = append(observations, copy)\n   505\t\t}\n   506\t\tstate.mu.Unlock()\n   507\t\tsort.Slice(observations, func(i, j int) bool {\n   508\t\t\tleft := governanceGitObservationKey(observations[i].root, observations[i].args, observations[i].maxOutputBytes)\n   509\t\t\tright := governanceGitObservationKey(observations[j].root, observations[j].args, observations[j].maxOutputBytes)\n   510\t\t\treturn left < right\n   511\t\t})\n   512\t\tremaining := int64(governanceReadViewMaxInputBytes)\n   513\t\theads := map[string]string{}\n   514\t\tfor _, item := range observations {\n   515\t\t\tif item.pure {\n   516\t\t\t\tif item.headAt == \"\" {\n   517\t\t\t\t\tcontinue\n   518\t\t\t\t}\n   519\t\t\t\tnow, read := heads[item.root]\n   520\t\t\t\tif !read {\n   521\t\t\t\t\tnow = governanceHeadAt(item.ctx, item.files, item.root)\n   522\t\t\t\t\theads[item.root] = now\n   523\t\t\t\t}\n   524\t\t\t\tif now == item.headAt {\n   525\t\t\t\t\tcontinue\n   526\t\t\t\t}\n   527\t\t\t}\n   528\t\t\tif remaining <= 0 {\n   529\t\t\t\tfor producer := range item.producers {\n   530\t\t\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], \"Git final audit exceeded its shared byte budget\")\n   531\t\t\t\t}\n   532\t\t\t\tcontinue\n   533\t\t\t}\n   534\t\t\tlimit := item.maxOutputBytes\n   535\t\t\tif remaining < limit {\n   536\t\t\t\tlimit = remaining\n   537\t\t\t}\n   538\t\t\tauditContext := item.ctx\n   539\t\t\tcancelAuditContext := func() {}\n   540\t\t\tif item.hasDeadline {\n   541\t\t\t\tauditContext, cancelAuditContext = context.WithTimeout(auditContext, item.timeout)\n   542\t\t\t}\n   543\t\t\tstdout, stderr, err := governanceAuditGit(auditContext, item.files, item.root, item.args, limit)\n   544\t\t\tcancelAuditContext()\n   545\t\t\tif errors.Is(err, errGovernanceReadViewBudget) {\n   546\t\t\t\tcommand := \"unknown\"\n   547\t\t\t\tif len(item.args) > 0 {\n   548\t\t\t\t\tcommand = item.args[0]\n   549\t\t\t\t}\n   550\t\t\t\tfor producer := range item.producers {\n   551\t\t\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], \"Git command \"+command+\" exceeded its bounded final-audit budget\")\n   552\t\t\t\t}\n   553\t\t\t\tcontinue\n   554\t\t\t}\n   555\t\t\tremaining -= int64(len(stdout) + len(stderr) + 1)\n   556\t\t\tif errorText(err) != item.errText || !bytes.Equal(stdout, item.stdout) || !bytes.Equal(stderr, item.stderr) {\n   557\t\t\t\tfor producer := range item.producers {\n   558\t\t\t\t\tresult.ChangedProducers[producer] = true\n   559\t\t\t\t}\n   560\t\t\t\trootDigest := digestBytes([]byte(filepath.Clean(item.root)))\n   561\t\t\t\targsDigest := digestBytes([]byte(strings.Join(item.args, \"\\x00\")))\n   562\t\t\t\tresult.ChangedPaths = append(result.ChangedPaths, \"git:\"+strings.TrimPrefix(rootDigest, \"sha256:\")+\":\"+strings.TrimPrefix(argsDigest, \"sha256:\"))\n   563\t\t\t}\n   564\t\t}\n   565\t\tstate.auditStreams(&result)\n   566\t\tresult.ChangedPaths = uniqueSorted(result.ChangedPaths)\n   567\t\tfor producer := range result.UnknownProducers {\n   568\t\t\tresult.UnknownProducers[producer] = uniqueSorted(result.UnknownProducers[producer])\n   569\t\t}\n   570\t\treturn result\n   571\t}\n   572\t\n   573\tfunc (state *governanceReadViewGitState) identityDigest() string {\n   574\t\tif state == nil {\n   575\t\t\treturn \"\"\n   576\t\t}\n   577\t\ttype identity struct {\n   578\t\t\tRootDigest   string   `json:\"root_digest\"`\n   579\t\t\tArgsDigest   string   `json:\"args_digest\"`\n   580\t\t\tOutputLimit  int64    `json:\"output_limit\"`\n   581\t\t\tOutputDigest string   `json:\"output_digest\"`\n   582\t\t\tErrorDigest  string   `json:\"error_digest,omitempty\"`\n   583\t\t\tProducers    []string `json:\"producers\"`\n   584\t\t}\n   585\t\tstate.mu.Lock()\n   586\t\titems := make([]identity, 0, len(state.observations))\n   587\t\tfor _, item := range state.observations {\n   588\t\t\targs, _ := json.Marshal(item.args)\n   589\t\t\titems = append(items, identity{\n   590\t\t\t\tRootDigest: digestBytes([]byte(filepath.Clean(item.root))), ArgsDigest: digestBytes(args),\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"context\"\n     6\t\t\"crypto/sha256\"\n     7\t\t\"encoding/hex\"\n     8\t\t\"errors\"\n     9\t\t\"fmt\"\n    10\t\t\"hash\"\n    11\t\t\"io\"\n    12\t\t\"os/exec\"\n    13\t\t\"path/filepath\"\n    14\t\t\"sort\"\n    15\t\t\"strings\"\n    16\t\t\"sync\"\n    17\t\t\"time\"\n    18\t)\n    19\t\n    20\t// Streamed reads (spec pose-read-view-streamed-object-digests): a Git object\n    21\t// read whose bytes a producer only hashes is streamed into the producer and\n    22\t// the read view retains its digest and length, never its bytes. Streamed\n    23\t// bytes have their own budget, apart from the retained captured input.\n    24\tconst (\n    25\t\t// governanceReadViewMaxStreamedBytes bounds the bytes one operation\n    26\t\t// streams, and separately the bytes its final audit streams again.\n    27\t\tgovernanceReadViewMaxStreamedBytes = 8 * 1024 * 1024 * 1024\n    28\t\t// governanceReadViewMaxStreamedRead bounds one streamed read.\n    29\t\tgovernanceReadViewMaxStreamedRead = 256 * 1024 * 1024\n    30\t\tgovernanceStreamStderrLimit       = 64 * 1024\n    31\t)\n    32\t\n    33\ttype governanceReadViewStreamObservation struct {\n    34\t\troot        string\n    35\t\targs        []string\n    36\t\tfiles       Files\n    37\t\tctx         context.Context\n    38\t\tdeadline    time.Time\n    39\t\thasDeadline bool\n    40\t\t// timeout is the time the read had: its deadline less its start.\n    41\t\ttimeout  time.Duration\n    42\t\tmaxBytes int64\n    43\t\tdigest   string\n    44\t\tlength   int64\n    45\t\t// errText is the digest of the read's error text, never the text: a\n    46\t\t// warning on stderr can be up to the stderr bound, and a retained copy\n    47\t\t// per read would escape every budget (review round 2, N2).\n    48\t\terrText   string\n    49\t\tproducers map[string]bool\n    50\t}\n    51\t\n    52\t// StreamGovernanceRawHistoryGitIn runs a raw-history Git read of an immutable\n    53\t// object and streams its output into sink. Inside a governance read view the\n    54\t// view records the output's digest and length as the observation and keeps\n    55\t// no bytes; reading the same command again in the operation streams it again\n    56\t// and leaves the producer unknown if it differs. Outside a view it is a\n    57\t// bounded streaming run.\n    58\tfunc StreamGovernanceRawHistoryGitIn(files Files, ctx context.Context, root, producer string, maxBytes int64, sink io.Writer, args ...string) error {\n    59\t\tif maxBytes <= 0 || maxBytes > governanceReadViewMaxStreamedRead {\n    60\t\t\treturn fmt.Errorf(\"pose: streamed Git output limit must be between 1 and %d bytes\", governanceReadViewMaxStreamedRead)\n    61\t\t}\n    62\t\tif ctx == nil {\n    63\t\t\tctx = context.Background()\n    64\t\t}\n    65\t\tfiles = FilesOrNative(files)\n    66\t\tview, viewFiles := governanceReadViewFromFiles(files)\n    67\t\tif view == nil {\n    68\t\t\t_, _, _, err := runGovernanceGitStreamContext(ctx, files, root, args, maxBytes, nil, sink)\n    69\t\t\treturn err\n    70\t\t}\n    71\t\tif view.operation == nil {\n    72\t\t\tview.markUnknown(producer, \"Git input has no operation-scoped generation vector\")\n    73\t\t\t_, _, _, err := runGovernanceGitStreamContext(ctx, files, root, args, maxBytes, nil, sink)\n    74\t\t\treturn err\n    75\t\t}\n    76\t\tif viewFiles != nil {\n    77\t\t\tif target := view.route(root, producer, viewFiles.project); target == nil {\n    78\t\t\t\tview.markUnknown(producer, \"Git input is outside the authorized root generation vector\")\n    79\t\t\t\treturn errGovernanceReadViewOutsideRoot\n    80\t\t\t} else {\n    81\t\t\t\tview = target\n    82\t\t\t}\n    83\t\t}\n    84\t\top := view.operation\n    85\t\tabsolute, target, state, err := op.gitRoot(root, producer)\n    86\t\tif err != nil {\n    87\t\t\treturn err\n    88\t\t}\n    89\t\tif err := target.begin(); err != nil {\n    90\t\t\treturn err\n    91\t\t}\n    92\t\tdefer target.end()\n    93\t\treturn state.stream(files, ctx, absolute, producer, maxBytes, sink, args...)\n    94\t}\n    95\t\n    96\tfunc (op *governanceReadViewOperation) reserveStreamed(size int64) bool {\n    97\t\tif op == nil {\n    98\t\t\treturn size >= 0 && size <= governanceReadViewMaxStreamedBytes\n    99\t\t}\n   100\t\tif size < 0 {\n   101\t\t\treturn false\n   102\t\t}\n   103\t\top.budgetMu.Lock()\n   104\t\tdefer op.budgetMu.Unlock()\n   105\t\tif size > governanceReadViewMaxStreamedBytes-op.streamedBytes {\n   106\t\t\treturn false\n   107\t\t}\n   108\t\top.streamedBytes += size\n   109\t\treturn true\n   110\t}\n   111\t\n   112\tfunc (state *governanceReadViewGitState) stream(files Files, ctx context.Context, root, producer string, maxBytes int64, sink io.Writer, args ...string) error {\n   113\t\tdeadline, hasDeadline := ctx.Deadline()\n   114\t\ttimeout := auditTimeout(deadline, time.Now())\n   115\t\tkey := governanceGitObservationKey(root, args, maxBytes)\n   116\t\tstate.mu.Lock()\n   117\t\tif state.streams == nil {\n   118\t\t\tstate.streams = map[string]*governanceReadViewStreamObservation{}\n   119\t\t}\n   120\t\tprior := state.streams[key]\n   121\t\tif prior == nil {\n   122\t\t\tmetadataCost := int64(len(root) + len(key) + len(producer) + 128)\n   123\t\t\tif !state.op.reserveRecord(metadataCost) {\n   124\t\t\t\tstate.mu.Unlock()\n   125\t\t\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its shared record or metadata budget while streaming Git\")\n   126\t\t\t\treturn errGovernanceReadViewBudget\n   127\t\t\t}\n   128\t\t}\n   129\t\tstate.mu.Unlock()\n   130\t\tdigest, length, stderr, runErr := governanceStreamRun(ctx, files, root, args, maxBytes, state.op.reserveStreamed, sink)\n   131\t\tif errors.Is(runErr, errGovernanceReadViewBudget) {\n   132\t\t\tstate.markUnknownForRoot(root, producer, \"Git streamed output exceeded the read-view streamed byte budget\")\n   133\t\t\treturn errGovernanceReadViewBudget\n   134\t\t}\n   135\t\t_ = stderr\n   136\t\tstate.mu.Lock()\n   137\t\tif prior = state.streams[key]; prior != nil {\n   138\t\t\tprior.producers[producer] = true\n   139\t\t\tsame := prior.digest == digest && prior.length == length && prior.errText == streamErrorDigest(runErr)\n   140\t\t\tstate.mu.Unlock()\n   141\t\t\tif !same {\n   142\t\t\t\tstate.markUnknownForRoot(root, producer, \"a streamed Git object read differed within the operation\")\n   143\t\t\t\treturn errGovernanceReadViewBudget\n   144\t\t\t}\n   145\t\t\treturn runErr\n   146\t\t}\n   147\t\tstate.streams[key] = &governanceReadViewStreamObservation{\n   148\t\t\troot: root, args: append([]string(nil), args...), files: files, ctx: context.WithoutCancel(ctx), deadline: deadline, hasDeadline: hasDeadline, timeout: timeout,\n   149\t\t\tmaxBytes: maxBytes, digest: digest, length: length, errText: streamErrorDigest(runErr), producers: map[string]bool{producer: true},\n   150\t\t}\n   151\t\tstate.mu.Unlock()\n   152\t\treturn runErr\n   153\t}\n   154\t\n   155\t// auditStreams streams every observation again, under its own audit budget,\n   156\t// and reports a producer changed when the digest, length or error differs.\n   157\tfunc (state *governanceReadViewGitState) auditStreams(result *governanceReadViewAudit) {\n   158\t\tstate.mu.Lock()\n   159\t\tstreams := make([]governanceReadViewStreamObservation, 0, len(state.streams))\n   160\t\tfor _, item := range state.streams {\n   161\t\t\tcopy := *item\n   162\t\t\tcopy.args = append([]string(nil), item.args...)\n   163\t\t\tcopy.producers = cloneBoolMap(item.producers)\n   164\t\t\tstreams = append(streams, copy)\n   165\t\t}\n   166\t\tstate.mu.Unlock()\n   167\t\tsort.Slice(streams, func(i, j int) bool {\n   168\t\t\treturn governanceGitObservationKey(streams[i].root, streams[i].args, streams[i].maxBytes) < governanceGitObservationKey(streams[j].root, streams[j].args, streams[j].maxBytes)\n   169\t\t})\n   170\t\tvar budgetMu sync.Mutex\n   171\t\tremaining := int64(governanceReadViewMaxStreamedBytes)\n   172\t\tadmit := func(size int64) bool {\n   173\t\t\tbudgetMu.Lock()\n   174\t\t\tdefer budgetMu.Unlock()\n   175\t\t\tif size < 0 || size > remaining {\n   176\t\t\t\treturn false\n   177\t\t\t}\n   178\t\t\tremaining -= size\n   179\t\t\treturn true\n   180\t\t}\n   181\t\t// Every streamed read is streamed again: its rendering depends on Git\n   182\t\t// configuration and attributes the operation does not capture, so no\n   183\t\t// read is proven unchanged without it (review round 1, F1 and F3).\n   184\t\tfor _, item := range streams {\n   185\t\t\tauditContext := item.ctx\n   186\t\t\tcancel := func() {}\n   187\t\t\tif item.hasDeadline {\n   188\t\t\t\tauditContext, cancel = context.WithTimeout(auditContext, item.timeout)\n   189\t\t\t}\n   190\t\t\tdigest, length, _, err := governanceAuditGitStream(auditContext, item.files, item.root, item.args, item.maxBytes, admit, io.Discard)\n   191\t\t\tcancel()\n   192\t\t\tif errors.Is(err, errGovernanceReadViewBudget) {\n   193\t\t\t\tfor producer := range item.producers {\n   194\t\t\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], \"Git streamed final audit exceeded its byte budget\")\n   195\t\t\t\t}\n   196\t\t\t\tcontinue\n   197\t\t\t}\n   198\t\t\tif digest != item.digest || length != item.length || streamErrorDigest(err) != item.errText {\n   199\t\t\t\tfor producer := range item.producers {\n   200\t\t\t\t\tresult.ChangedProducers[producer] = true\n   201\t\t\t\t}\n   202\t\t\t\trootDigest := digestBytes([]byte(filepath.Clean(item.root)))\n   203\t\t\t\targsDigest := digestBytes([]byte(strings.Join(item.args, \"\\x00\")))\n   204\t\t\t\tresult.ChangedPaths = append(result.ChangedPaths, \"git:\"+strings.TrimPrefix(rootDigest, \"sha256:\")+\":\"+strings.TrimPrefix(argsDigest, \"sha256:\"))\n   205\t\t\t}\n   206\t\t}\n   207\t}\n   208\t\n   209\t// governanceStreamRun and governanceAuditGitStream run streamed reads during\n   210\t// the operation and in its final audit.\n   211\tvar (\n   212\t\tgovernanceStreamRun      = runGovernanceGitStreamContext\n   213\t\tgovernanceAuditGitStream = runGovernanceGitStreamContext\n   214\t)\n   215\t\n   216\t// runGovernanceGitStreamContext runs Git like the captured reads do and\n   217\t// writes its stdout to sink as it arrives, admitting each chunk before it is\n   218\t// written and hashing it; stderr is kept bounded. It returns the stdout's\n   219\t// digest and length. A non-empty stderr is an error, as for captured reads.\n   220\tfunc runGovernanceGitStreamContext(ctx context.Context, files Files, root string, args []string, limit int64, admit func(int64) bool, sink io.Writer) (string, int64, []byte, error) {\n   221\t\tif limit <= 0 {\n   222\t\t\treturn \"\", 0, nil, errGovernanceReadViewBudget\n   223\t\t}\n   224\t\t_ = FilesOrNative(files)\n   225\t\tif ctx == nil {\n   226\t\t\tctx = context.Background()\n   227\t\t}\n   228\t\tif sink == nil {\n   229\t\t\tsink = io.Discard\n   230\t\t}\n   231\t\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n   232\t\tcmd.WaitDelay = 2 * time.Second\n   233\t\tcmd.Env = append(cmd.Env, governanceGitEnv...)\n   234\t\tout := &governanceStreamWriter{limit: limit, admit: admit, sink: sink, hash: sha256.New()}\n   235\t\tvar stderr bytes.Buffer\n   236\t\tcmd.Stdout = out\n   237\t\tcmd.Stderr = &limitedStderr{buf: &stderr, limit: governanceStreamStderrLimit}\n   238\t\terr := cmd.Run()\n   239\t\tif out.exceeded {\n   240\t\t\treturn \"\", 0, nil, errGovernanceReadViewBudget\n   241\t\t}\n   242\t\tdigest := \"sha256:\" + hex.EncodeToString(out.hash.Sum(nil))\n   243\t\tif err != nil {\n   244\t\t\tif exit, ok := err.(*exec.ExitError); ok {\n   245\t\t\t\texit.Stderr = append([]byte(nil), stderr.Bytes()...)\n   246\t\t\t}\n   247\t\t\treturn digest, out.written, stderr.Bytes(), &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n   248\t\t}\n   249\t\tif stderr.Len() > 0 {\n   250\t\t\tdetail := strings.TrimSpace(stderr.String())\n   251\t\t\tif detail == \"\" {\n   252\t\t\t\tdetail = \"Git wrote unclassified stderr output\"\n   253\t\t\t}\n   254\t\t\treturn digest, out.written, stderr.Bytes(), &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: errors.New(detail)}\n   255\t\t}\n   256\t\treturn digest, out.written, nil, nil\n   257\t}\n   258\t\n   259\ttype governanceStreamWriter struct {\n   260\t\tmu       sync.Mutex\n","exit_code":0,"status":"completed"}}
