-clock\": \"sha256:50d7b3397b87224232c02bceae78869c91b2358b34fe239b4c7de13c57f4a3e9\",\n    \"pose-abm-capability-adoption\": \"sha256:7734ebb70290778f0a1db50384a232610d1cb27b4b2ab06fff6cdc90f72af205\",\n    \"pose-abm-causality-attestation\": \"sha256:fe9a574fb5eb50ff4c5a7dd4fbce53709b9240ab15f6c7938179c4134e40e909\",\n    \"pose-abm-contract-nodes\": \"sha256:79cf41cf4c492b4b2f8bb6b367cca1cd9ece9bdc466fea04f48e6b39153461b5\",\n    \"pose-abm-design-basis\": \"sha256:de13dd79c33e7fc81a40f0a1624b9d47cc64805a5f5f7bfd328888196d5f0c4d\",\n    \"pose-abm-doctor-state-health\": \"sha256:fbd0cdd70c96add604f5190b1a038ef3a1ed3df32f178f879efa10aa68a9f6e4\",\n    \"pose-abm-governance-outcomes\": \"sha256:2d404d8413d5c593359f6901c2c56af00b7859145c3b5426b41ae0ad8f2379b3\",\n    \"pose-abm-progressive-review\": \"sha256:eb85af9880dad72970365bd9a595d0d1507aecfe31f589b2135942dc83dbec0d\",\n    \"pose-abm-remediation-lineage\": \"sha256:9439efb1a2687e83e0c1e6279d2ef786f3994ec296bbfe7976711953b0bd57e0\",\n    \"pose-abm-retrospective-replay\": \"sha256:d79f33542d0c9d5e3589849d1482e2bf2e64a2ef016c33a1a238c48243b2ff4a\",\n    \"pose-abm-review-authority\": \"sha256:a115cf01e1c98651df8d672ac91f45c3a1497ff6c2442ae3d5d77ce717f0acb8\",\n    \"pose-abm-review-soundness\": \"sha256:d48e9b63b60a447af40059411bf3322691445edb09ded8af4f9a031912de4d39\",\n    \"pose-abm-review-soundness-residuals\": \"sha256:060fb5d0af02071c5d0b95b0c66b82a85a10f7f305d698a0c273316ef33b56e4\",\n    \"pose-abm-review-tool-deferred-without-delivery\": \"sha256:4b1dc87bc663d2604a297e2c9965a2cc44b53fa75b38cebd6d6e5aefa26dfe78\",\n    \"pose-abm-state-followup-origins\": \"sha256:30e0844db70f4cc9fd88ad7374217041708bc9196ea8a1d27bb9a036f46d42cf\",\n    \"pose-abm-structural-delta\": \"sha256:23b6b8886bb2c31eef948cdd492b69b58f1b3e5aead6185a265b7a8810a0defa\",\n    \"pose-abm-subject-evidence\": \"sha256:1b9c7e6c4d7bc29b54cc2036e087fc5786920544d5c695fd9a02fe0d765b3b50\",\n    \"pose-action-answers-reverify-on-read\": \"sha256:b91cd0aa0f8f66b02d8511f2aa3aa18a1410ace9ce3edf75d80dda320f8d4dad\",\n    \"pose-action-request-presentation\": \"sha256:e8aabc7f41897d7b32e3660bbcf53fed9d9a3dc17f5714bb32b155ce001f1495\",\n    \"pose-action-request-recovery-and-preflight\": \"sha256:05eec57c2d57f0fef26b357947074429c3491c03b4db388b341ec0e322e198ef\",\n    \"pose-action-request-resolution\": \"sha256:a97d2c8bbed6cd05209d7ead72c031333b612fa8e1ec274d19ff99bbe69d32ce\",\n    \"pose-action-requests\": \"sha256:37e1541b4d26e6f8922a5ff1f1f2849d7576c1318392f27acc6f9d198a8d6570\",\n    \"pose-action-runtime-currency-gate\": \"unavailable\",\n    \"pose-action-target-and-node-scoping\": \"sha256:82b502d5bec329eb3eb8f15d2d9ad34e70c090d0dd6044aecd9ec2d9a150ddac\",\n    \"pose-action-waiver-and-supersession-authority\": \"sha256:26cd35e56a3542ba322699be14effa3cbc3289c5fbe46205db593e68a42a3967\",\n    \"pose-actions-node24-bump\": \"unavailable\",\n    \"pose-adaptive-assessment-freshness\": \"sha256:d16199df8613b4104838ae7a5dcb53817152044461796e364f7a686379cc6a2e\",\n    \"pose-adaptive-rule-delivery\": \"unavailable\",\n    \"pose-adopt-request-keeps-the-reason\": \"sha256:b02b53d7f0a5f7b11c219d821e0e1de6d51a48d650982c04d31f3a1b7e1a16e1\",\n    \"pose-adopt-request-shows-what-it-sets\": \"sha256:dc7467851ca26483bf8910657154e7ca0aeba886d7db70a6948048f87fb4361a\",\n    \"pose-adoption-stamp-stays-readable\": \"unavailable\",\n    \"pose-agency-readiness-pil\n[]\nrecurrence.flapping_keys=0\nrecurrence.resolved_clusters=0\nrecurrence.window_days=14\nrecurrence.threshold=3\nrecurrence.records_scanned=432\nrecurrence.flagged_keys=0\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/internal/pose/governance_git_pure.go; rg -n 'changeSetGitStream' pose-mcp/internal/pose; rg --files .pose/review-bundles | tail -8; git status --short; git rev-parse HEAD\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/internal/pose/governance_git_pure.go; rg -n 'changeSetGitStream' pose-mcp/internal/pose; rg --files .pose/review-bundles | tail -8; git status --short; git rev-parse HEAD\"","aggregated_output":"package pose\n\nimport (\n\t\"context\"\n\t\"regexp\"\n\t\"strings\"\n)\n\n// A read-view operation reruns every Git command it captured when it ends, to prove the\n// output did not change while the operation ran. Some commands cannot change: their output is\n// a pure function of object ids, or of the commit HEAD named when they ran. For those the\n// rerun proves nothing the commit does not already prove, and it is the dearest part of a\n// check (spec pose-governance-audit-skips-pure-git-reads).\n\nvar governanceFullObjectID = regexp.MustCompile(`^[0-9a-f]{40}$`)\n\n// governancePureGitRead classifies a captured command. byObject means the output depends on\n// object ids alone; byHead means it depends on the commit HEAD named when it ran, which the\n// capture reads before and after the command. Anything not listed exactly is neither, and\n// keeps its rerun: a ref name, --all, a pretty format that names refs, or a flag the\n// classification does not know can all make the output depend on mutable state.\nfunc governancePureGitRead(args []string) (byObject, byHead bool) {\n\tif len(args) == 0 {\n\t\treturn false, false\n\t}\n\tswitch args[0] {\n\tcase \"show\":\n\t\t// show <40-hex>:<path>\n\t\tif len(args) == 2 {\n\t\t\tid, path, ok := strings.Cut(args[1], \":\")\n\t\t\treturn ok && governanceFullObjectID.MatchString(id) && path != \"\", false\n\t\t}\n\tcase \"cat-file\":\n\t\t// cat-file blob <40-hex>\n\t\treturn len(args) == 3 && args[1] == \"blob\" && governanceFullObjectID.MatchString(args[2]), false\n\tcase \"log\":\n\t\t// log -1 --format=%H -- <path...>: the last commit that changed the paths, from HEAD.\n\t\tif len(args) >= 5 && args[1] == \"-1\" && args[2] == \"--format=%H\" && args[3] == \"--\" {\n\t\t\treturn false, true\n\t\t}\n\tcase \"ls-tree\":\n\t\t// ls-tree [flags] <40-hex> [-- <path...>]\n\t\ti := 1\n\t\tfor i < len(args) && strings.HasPrefix(args[i], \"-\") && args[i] != \"--\" {\n\t\t\tswitch args[i] {\n\t\t\tcase \"-z\", \"-r\", \"-t\", \"-l\", \"--name-only\", \"--full-tree\":\n\t\t\tdefault:\n\t\t\t\treturn false, false\n\t\t\t}\n\t\t\ti++\n\t\t}\n\t\tif i >= len(args) {\n\t\t\treturn false, false\n\t\t}\n\t\ttree := args[i]\n\t\ti++\n\t\tif i < len(args) && args[i] != \"--\" {\n\t\t\treturn false, false\n\t\t}\n\t\t// ls-tree HEAD is cheap to rerun and dearer to qualify (two HEAD reads): it keeps its rerun.\n\t\treturn governanceFullObjectID.MatchString(tree), false\n\t}\n\treturn false, false\n}\n\n// governanceAuditGit runs a captured command again for the final audit; tests replace it to\n// count the reruns.\nvar governanceAuditGit = runGovernanceGitCommandOutputContext\n\n// governanceHeadAt reads HEAD of a root directly, outside any read view, so that no\n// observation is recorded and the answer is the repository's now.\nfunc governanceHeadAt(ctx context.Context, files Files, root string) string {\n\tstdout, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, []string{\"rev-parse\", \"--verify\", \"HEAD\"}, 4096)\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\treturn strings.TrimSpace(string(stdout))\n}\n.pose/review-bundles/rvb-284474808d4831fc.json\n.pose/review-bundles/rvb-d867f119aa3d939c.json\n.pose/review-bundles/rvb-3db19fb0ebab54d9.json\n.pose/review-bundles/rvb-65a5cf3ec8ef414f.json\n.pose/review-bundles/rvb-d6963f9757c3e587.json\n.pose/review-bundles/rvb-38cf6af8a69d7a1c.json\n.pose/review-bundles/rvb-8bf4dc1da432f891.json\n.pose/review-bundles/rvb-7ca789915a842b1b.json\nf72cf7e3adb4652acb432d1fa64192421db8a8e0\n","exit_code":0,"status":"completed"}}
