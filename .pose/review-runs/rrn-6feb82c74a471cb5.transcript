{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc 'git status --short; git diff d49d3aeb4ed8daa2b44b2c46d8ce5536d39dc199..f72cf7e3adb4652acb432d1fa64192421db8a8e0 -- pose-mcp/internal/pose/governance_read_view_git.go pose-mcp/internal/pose/governance_read_view_stream.go pose-mcp/internal/pose/governance_read_view_audit_timeout_test.go .pose/indexes/validation-matrix.json'","aggregated_output":"diff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex babee280..d6c44230 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2419,6 +2419,13 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"read-view-audit-repeats-a-read-under-its-own-time-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestReadViewAudit|TestAuditTimeoutIsTheTimeTheReadHad\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"git-snapshot-budget-scales-with-the-tree-integration\",\n           \"program\": \"go\",\ndiff --git a/pose-mcp/internal/pose/governance_read_view_audit_timeout_test.go b/pose-mcp/internal/pose/governance_read_view_audit_timeout_test.go\nnew file mode 100644\nindex 00000000..b0d2e977\n--- /dev/null\n+++ b/pose-mcp/internal/pose/governance_read_view_audit_timeout_test.go\n@@ -0,0 +1,86 @@\n+package pose\n+\n+import (\n+\t\"context\"\n+\t\"io\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+// auditAfterDeadline captures one read under a 2 s deadline through a real\n+// read view, lets the deadline pass, optionally changes the repository, and\n+// returns the final audit.\n+func auditAfterDeadline(t *testing.T, read func(Files, context.Context, string) error, change func(root string)) governanceReadViewAudit {\n+\tt.Helper()\n+\troot, _ := snapshotBudgetRepo(t)\n+\t_, view := Store{Root: root}.beginGovernanceReadView()\n+\tif view == nil {\n+\t\tt.Fatal(\"no read view\")\n+\t}\n+\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)\n+\tif err := read(view.filesFor(\"audit-timeout\"), ctx, root); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tcancel()\n+\ttime.Sleep(2500 * time.Millisecond)\n+\tif change != nil {\n+\t\tchange(root)\n+\t}\n+\treturn view.audit()\n+}\n+\n+// ls-tree of HEAD is not a pure read: the audit repeats it.\n+func captureHeadListing(files Files, ctx context.Context, root string) error {\n+\t_, err := CaptureGovernanceGitContextIn(files, ctx, root, \"audit-timeout\", 1<<20, \"ls-tree\", \"-r\", \"-z\", \"HEAD\")\n+\treturn err\n+}\n+\n+func streamHeadShow(files Files, ctx context.Context, root string) error {\n+\treturn StreamGovernanceRawHistoryGitIn(files, ctx, root, \"audit-timeout\", 1<<20, io.Discard, \"show\", \"--format=\", \"HEAD\", \"--\")\n+}\n+\n+// Spec pose-read-view-audit-repeats-a-read-under-its-own-time, R1 and R2: a\n+// captured command that the audit repeats, unchanged, is not reported after\n+// its own deadline.\n+func TestReadViewAuditRepeatsACommandUnderItsOwnTime(t *testing.T) {\n+\taudit := auditAfterDeadline(t, captureHeadListing, nil)\n+\tif len(audit.ChangedPaths) != 0 || len(audit.UnknownProducers) != 0 {\n+\t\tt.Fatalf(\"an unchanged command audited after its deadline: changed=%v unknown=%v\", audit.ChangedPaths, audit.UnknownProducers)\n+\t}\n+}\n+\n+// R1 and R2 for a streamed read.\n+func TestReadViewAuditRepeatsAStreamUnderItsOwnTime(t *testing.T) {\n+\taudit := auditAfterDeadline(t, streamHeadShow, nil)\n+\tif len(audit.ChangedPaths) != 0 || len(audit.UnknownProducers) != 0 {\n+\t\tt.Fatalf(\"an unchanged stream audited after its deadline: changed=%v unknown=%v\", audit.ChangedPaths, audit.UnknownProducers)\n+\t}\n+}\n+\n+// The command is really repeated: a HEAD that moved after the deadline is\n+// reported as a change.\n+func TestReadViewAuditStillSeesAChangeAfterTheDeadline(t *testing.T) {\n+\taudit := auditAfterDeadline(t, captureHeadListing, func(root string) {\n+\t\tif err := os.WriteFile(filepath.Join(root, \"data-new.txt\"), []byte(\"new\\n\"), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tfederatedTestGit(t, root, \"add\", \"-A\")\n+\t\tfederatedTestGit(t, root, \"commit\", \"-q\", \"-m\", \"moved\")\n+\t})\n+\tif len(audit.ChangedPaths) == 0 {\n+\t\tt.Fatal(\"a HEAD that moved after the deadline was not reported\")\n+\t}\n+}\n+\n+// R3: a repeated read still runs under a deadline, the time it had.\n+func TestAuditTimeoutIsTheTimeTheReadHad(t *testing.T) {\n+\tstart := time.Now()\n+\tif got := auditTimeout(start.Add(90*time.Second), start); got != 90*time.Second {\n+\t\tt.Fatalf(\"got %v, want 90s\", got)\n+\t}\n+\tif got := auditTimeout(start.Add(-time.Second), start); got <= 0 {\n+\t\tt.Fatalf(\"an expired deadline gave no time: %v\", got)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/governance_read_view_git.go b/pose-mcp/internal/pose/governance_read_view_git.go\nindex b9eef9f0..d5edf272 100644\n--- a/pose-mcp/internal/pose/governance_read_view_git.go\n+++ b/pose-mcp/internal/pose/governance_read_view_git.go\n@@ -19,12 +19,14 @@ import (\n const governanceReadViewGitParserVersion = \"pose-governance-git-inputs-v1\"\n \n type governanceReadViewGitObservation struct {\n-\troot           string\n-\targs           []string\n-\tfiles          Files\n-\tctx            context.Context\n-\tdeadline       time.Time\n-\thasDeadline    bool\n+\troot        string\n+\targs        []string\n+\tfiles       Files\n+\tctx         context.Context\n+\tdeadline    time.Time\n+\thasDeadline bool\n+\t// timeout is the time the read had: its deadline less its start.\n+\ttimeout        time.Duration\n \tmaxOutputBytes int64\n \tstdout         []byte\n \tstderr         []byte\n@@ -327,6 +329,18 @@ func (op *governanceReadViewOperation) gitRoot(root, producer string) (string, *\n \treturn absolute, target, state, nil\n }\n \n+// A read's deadline bounds how long that read may take, not when the final\n+// audit may repeat it: the audit gives the repeated read the same time the\n+// read had, counted from when the audit runs. An absolute deadline expired\n+// before the audit of any operation longer than it, and every such read was\n+// reported as changed (spec pose-read-view-audit-repeats-a-read-under-its-own-time).\n+func auditTimeout(deadline time.Time, captured time.Time) time.Duration {\n+\tif timeout := deadline.Sub(captured); timeout > 0 {\n+\t\treturn timeout\n+\t}\n+\treturn time.Millisecond\n+}\n+\n func (state *governanceReadViewGitState) capture(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n \tif state == nil || state.op == nil {\n \t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n@@ -335,6 +349,7 @@ func (state *governanceReadViewGitState) capture(files Files, ctx context.Contex\n \t\tctx = context.Background()\n \t}\n \tdeadline, hasDeadline := ctx.Deadline()\n+\ttimeout := auditTimeout(deadline, time.Now())\n \tauditContext := context.WithoutCancel(ctx)\n \tkey := governanceGitObservationKey(root, args, maxOutputBytes)\n \tstate.mu.Lock()\n@@ -392,7 +407,7 @@ func (state *governanceReadViewGitState) capture(files Files, ctx context.Contex\n \t\treturn nil, errGovernanceReadViewBudget\n \t}\n \tobservation := &governanceReadViewGitObservation{\n-\t\troot: root, args: append([]string(nil), args...), files: files, ctx: auditContext, deadline: deadline, hasDeadline: hasDeadline, maxOutputBytes: maxOutputBytes,\n+\t\troot: root, args: append([]string(nil), args...), files: files, ctx: auditContext, deadline: deadline, hasDeadline: hasDeadline, timeout: timeout, maxOutputBytes: maxOutputBytes,\n \t\tstdout: append([]byte(nil), stdout...), stderr: append([]byte(nil), stderr...), err: runErr, errText: errorText(runErr),\n \t\tproducers: map[string]bool{producer: true},\n \t}\n@@ -523,7 +538,7 @@ func (state *governanceReadViewGitState) audit() governanceReadViewAudit {\n \t\tauditContext := item.ctx\n \t\tcancelAuditContext := func() {}\n \t\tif item.hasDeadline {\n-\t\t\tauditContext, cancelAuditContext = context.WithDeadline(auditContext, item.deadline)\n+\t\t\tauditContext, cancelAuditContext = context.WithTimeout(auditContext, item.timeout)\n \t\t}\n \t\tstdout, stderr, err := governanceAuditGit(auditContext, item.files, item.root, item.args, limit)\n \t\tcancelAuditContext()\ndiff --git a/pose-mcp/internal/pose/governance_read_view_stream.go b/pose-mcp/internal/pose/governance_read_view_stream.go\nindex 1cb8e66d..af9ac4ad 100644\n--- a/pose-mcp/internal/pose/governance_read_view_stream.go\n+++ b/pose-mcp/internal/pose/governance_read_view_stream.go\n@@ -37,9 +37,11 @@ type governanceReadViewStreamObservation struct {\n \tctx         context.Context\n \tdeadline    time.Time\n \thasDeadline bool\n-\tmaxBytes    int64\n-\tdigest      string\n-\tlength      int64\n+\t// timeout is the time the read had: its deadline less its start.\n+\ttimeout  time.Duration\n+\tmaxBytes int64\n+\tdigest   string\n+\tlength   int64\n \t// errText is the digest of the read's error text, never the text: a\n \t// warning on stderr can be up to the stderr bound, and a retained copy\n \t// per read would escape every budget (review round 2, N2).\n@@ -109,6 +111,7 @@ func (op *governanceReadViewOperation) reserveStreamed(size int64) bool {\n \n func (state *governanceReadViewGitState) stream(files Files, ctx context.Context, root, producer string, maxBytes int64, sink io.Writer, args ...string) error {\n \tdeadline, hasDeadline := ctx.Deadline()\n+\ttimeout := auditTimeout(deadline, time.Now())\n \tkey := governanceGitObservationKey(root, args, maxBytes)\n \tstate.mu.Lock()\n \tif state.streams == nil {\n@@ -142,7 +145,7 @@ func (state *governanceReadViewGitState) stream(files Files, ctx context.Context\n \t\treturn runErr\n \t}\n \tstate.streams[key] = &governanceReadViewStreamObservation{\n-\t\troot: root, args: append([]string(nil), args...), files: files, ctx: context.WithoutCancel(ctx), deadline: deadline, hasDeadline: hasDeadline,\n+\t\troot: root, args: append([]string(nil), args...), files: files, ctx: context.WithoutCancel(ctx), deadline: deadline, hasDeadline: hasDeadline, timeout: timeout,\n \t\tmaxBytes: maxBytes, digest: digest, length: length, errText: streamErrorDigest(runErr), producers: map[string]bool{producer: true},\n \t}\n \tstate.mu.Unlock()\n@@ -182,7 +185,7 @@ func (state *governanceReadViewGitState) auditStreams(result *governanceReadView\n \t\tauditContext := item.ctx\n \t\tcancel := func() {}\n \t\tif item.hasDeadline {\n-\t\t\tauditContext, cancel = context.WithDeadline(auditContext, item.deadline)\n+\t\t\tauditContext, cancel = context.WithTimeout(auditContext, item.timeout)\n \t\t}\n \t\tdigest, length, _, err := governanceAuditGitStream(auditContext, item.files, item.root, item.args, item.maxBytes, admit, io.Discard)\n \t\tcancel()\n","exit_code":0,"status":"completed"}}
