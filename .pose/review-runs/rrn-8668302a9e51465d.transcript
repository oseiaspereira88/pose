lts = append(results, state)\n\t}\n\n\t// The consolidated view is repository-wide even when discovery is scoped to\n\t// one component. Rebuilding it from the scanned subset alone used to drop\n\t// every other component from README.md/consolidated.md while leaving its\n\t// per-component report and state file orphaned on disk.\n\tconsolidated := results\n\tif targetComp != \"\" {\n\t\tconsolidated = mergeWithPersistedComponentStates(store, results)\n\t}\n\tif err := store.GenerateConsolidatedAssessment(consolidated); err != nil {\n\t\tfmt.Fprintf(stderr, \"pose assess discover consolidate: %v\\n\", err)\nfunc assessIntegrate(root string, args []string, stdout, stderr io.Writer, locale cliLocale) int {\n\tvar asJSON bool\n\tvar updateState bool\n\n\tfor _, a := range args {\n\t\tswitch a {\n\t\tcase \"--json\":\n\t\t\tasJSON = true\n\t\tcase \"--update-state\":\n\t\t\tupdateState = true\n\t\t}\n\t}\n\n\tstore := pose.Store{Root: root}\n\tmatrix, err := store.AnalyzeIntegrations()\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose assess integrate: %v\\n\", err)\n\t\treturn 1\n\t}\n\n\tif err := store.SaveIntegrationMatrix(matrix); err != nil {\n\t\tfmt.Fprintf(stderr, \"pose assess integrate save: %v\\n\", err)\n\t\treturn 1\n\t}\n\n\tif updateState {\n\t\tif err := updateProjectStateArchitecture(root, nil); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose assess integrate update-state: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t}\n\n\tif asJSON {\n\t\tenc, _ := json.MarshalIndent(matrix, \"\", \"  \")\n\t\tfmt.Fprintln(stdout, string(enc))\n\t\treturn 0\n\t}\n\n\tfmt.Fprintf(stdout, \"Integration Assessment Results:\\n\")\n\tfmt.Fprintf(stdout, \"  - Contracts Evaluated: %d\\n\", matrix.Summary.TotalIntegrations)\n\tfmt.Fprintf(stdout, \"  - Active Contracts: %d\\n\", matrix.Summary.ActiveContracts)\n\tfmt.Fprintf(stdout, \"  - Integration Gaps Identified: %d\\n\\n\", matrix.Summary.IdentifiedGaps)\n\n\tfor _, g := range matrix.Gaps {\n\t\tfmt.Fprintf(stdout, \"  ⚠️ [%s] %s (%s)\\n     Provider: %s | Consumer: %s\\n     %s\\n\\n\",\n\t\t\tg.GapID, g.Title, g.Severity, g.Provider, g.Consumer, g.Description)\n\t}\n\n\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/integrations.md and .pose/state/integrations.json\\n\")\n\treturn 0\n}\n\nfunc assessTechDebt(root string, args []string, stdout, stderr io.Writer, locale cliLocale) int {\n\tvar asJSON bool\n\tvar updateState bool\n\n\tfor _, a := range args {\n\t\tswitch a {\n\t\tcase \"--json\":\n\t\t\tasJSON = true\n\t\tcase \"--update-state\":\n\t\t\tupdateState = true\n\t\t}\n\t}\n\n\tstore := pose.Store{Root: root}\n\treport, err := store.AnalyzeTechDebt()\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose assess tech-debt: %v\\n\", err)\n\t\treturn 1\n\t}\n\n\tif err := store.SaveTechDebtReport(report); err != nil {\n\t\tfmt.Fprintf(stderr, \"pose assess tech-debt save: %v\\n\", err)\n\t\treturn 1\n\t}\n\n\tif updateState {\n\t\tif err := updateProjectStateArchitecture(root, nil); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose assess tech-debt update-state: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t}\n\n\tif asJSON {\n\t\tenc, _ := json.MarshalIndent(report, \"\", \"  \")\n\t\tfmt.Fprintln(stdout, string(enc))\n\t\treturn 0\npackage cli\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nfunc loadDeliveryProfilesIn(files posemodel.Files, root string) (map[string]posemodel.DeliveryProfile, error) {\n\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\"))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmatrix, err := parseValidationMatrix(raw)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif err := validateDeliveryMatrixContract(matrix); err != nil {\n\t\treturn nil, err\n\t}\n\treturn matrix.DeliveryProfiles, nil\n}\n\n// loadDeliveryProfiles reads and writes the filesystem directly; loadDeliveryProfilesIn takes the\n// operation's files.\nfunc loadDeliveryProfiles(root string) (map[string]posemodel.DeliveryProfile, error) {\n\treturn loadDeliveryProfilesIn(posemodel.NativeFiles(), root)\n}\n\nfunc collectDeliveryTargetsIn(files posemodel.Files, root string, specs []posemodel.Spec, profiles map[string]posemodel.DeliveryProfile) ([]posemodel.Spec, []posemodel.DeliveryTarget, error) {\n\tstore := posemodel.Store{Root: root, FS: files}\n\tfullSpecs := make([]posemodel.Spec, 0, len(specs))\n\ttargets := []posemodel.DeliveryTarget{}\n\tfor _, summary := range specs {\n\t\tfull, err := store.GetSpec(summary.Slug)\n\t\tif err != nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"spec:%s: %w\", summary.Slug, err)\n\t\t}\n\t\tparsed, _, err := posemodel.ParseDeliveryTargets(*full)\n\t\tif err != nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"spec:%s: %w\", summary.Slug, err)\n\t\t}\n\t\tif err := posemodel.ValidateDeliveryTargetsIn(files, root, parsed, profiles); err != nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"spec:%s: %w\", summary.Slug, err)\n\t\t}\n\t\tfullSpecs = append(fullSpecs, *full)\n\t\ttargets = append(targets, parsed...)\n\t}\n\treturn fullSpecs, targets, nil\n}\n\n// collectDeliveryTargets reads and writes the filesystem directly; collectDeliveryTargetsIn takes the\n// operation's files.\nfunc collectDeliveryTargets(root string, specs []posemodel.Spec, profiles map[string]posemodel.DeliveryProfile) ([]posemodel.Spec, []posemodel.DeliveryTarget, error) {\n\treturn collectDeliveryTargetsIn(posemodel.NativeFiles(), root, specs, profiles)\n}\n\nfunc loadDeliveryValidationResultsIn(files posemodel.Files, root, relative string) ([]posemodel.DeliveryValidationResult, error) {\n\tif relative == \"\" {\n\t\treturn []posemodel.DeliveryValidationResult{}, nil\n\t}\n\tif !confinedRelativePath(relative) {\n\t\treturn nil, fmt.Errorf(\"validation result path must remain inside project\")\n\t}\n\traw, err := files.ReadFile(filepath.Join(root, filepath.FromSlash(relative)))\n\tif os.IsNotExist(err) {\n\t\treturn []posemodel.DeliveryValidationResult{}, nil\n\t}\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn posemodel.ParseDeliveryValidationRun(raw, relative)\n}\n\n// loadSmokeResults reads the verified smoke documents of root; tests replace\n// it to exercise the surface check over results they choose.\nvar loadSmokeResults = func(root string) ([]posemodel.SmokeResult, error) {\n\treturn posemodel.Store{Root: root}.SmokeResults()\n}\n\n// withSmokeResults adds the results of every verified smoke observation a\n// delegated smoke run recorded: evidence of class smoke for the delivery\n// targets it exercised (spec pose-delegated-verdict-destinations R2). A\n// document that does not verify yields nothing.\nfunc withSmokeResults(root string, results []posemodel.DeliveryValidationResult) []posemodel.DeliveryValidationResult {\n\tsmoke, err := loadSmokeResults(root)\n\tif err != nil {\n\t\treturn results\n\t}\n\treturn appendVerifiedSmokeResults(results, smoke)\n}\n\n// withSmokeResultsIn keeps delegated smoke evidence on the same operation\n// filesystem as the rest of the delivery projection.\nfunc withSmokeResultsIn(files posemodel.Files, root string, results []posemodel.DeliveryValidationResult) []posemodel.DeliveryValidationResult {\n\tsmoke, err := posemodel.LoadSmokeResultsIn(posemodel.Store{Root: root, FS: files}, root)\n\tif err != nil {\n\t\treturn results\n\t}\n\treturn appendVerifiedSmokeResults(results, smoke)\n}\n\nfunc appendVerifiedSmokeResults(results []posemodel.DeliveryValidationResult, smoke []posemodel.SmokeResult) []posemodel.DeliveryValidationResult {\n\tfor _, doc := range smoke {\n\t\tif doc.Verified {\n\t\t\tresults = append(results, doc.Results...)\n\t\t}\n\t}\n\treturn results\n}\n\n// loadDeliveryValidationResults reads and writes the filesystem directly; loadDeliveryValidationResultsIn takes the\n// operation's files.\nfunc loadDeliveryValidationResults(root, relative string) ([]posemodel.DeliveryValidationResult, error) {\n\treturn loadDeliveryValidationResultsIn(posemodel.NativeFiles(), root, relative)\n}\n\nfunc extendCurrentDeliveryGraphIn(files posemodel.Files, root string, base posemodel.DeliveryIntegrityGraph) (posemodel.DeliveryIntegrityGraph, error) {\n\tpolicy, err := posemodel.LoadDeliveryPolicyIn(files, root)\n\tif err != nil {\n\t\treturn base, err\n\t}\n{\n  \"schema_version\": 1,\n  \"spec\": \"pose-check-shares-the-federated-material\",\n  \"plan_digest\": \"c874444af007e24fd7bb4628cdeb21b7738ea8011d44f15ae9303db54f9cd267\",\n  \"revision\": \"6b574ed26dfbc32da5a89e42b442404409383f8a\",\n  \"spec_digest_before\": \"48604357d9941d5e655f3d33d1403085a6f1bc30134d32768c9519edfc09f453\",\n  \"spec_digest_after\": \"d468578e5f298eeb311fdc729156886e2cc5599977f09822cc6ce11fbc1f5d76\",\n  \"baseline\": {\n    \"schema_version\": 1,\n    \"namespace\": \"spec:pose-check-shares-the-federated-material\",\n    \"nodes\": [\n      {\n        \"id\": \"R1\",\n        \"kind\": \"requirement\",\n        \"namespace\": \"spec:pose-check-shares-the-federated-material\",\n        \"hash\": \"c42d716a28f5\",\n        \"state\": \"active\"\n      },\n      {\n        \"id\": \"R2\",\n        \"kind\": \"requirement\",\n        \"namespace\": \"spec:pose-check-shares-the-federated-material\",\n        \"hash\": \"658fafd61d1a\",\n        \"state\": \"active\"\n      },\n      {\n        \"id\": \"D1\",\n        \"kind\": \"decision\",\n        \"namespace\": \"spec:pose-check-shares-the-federated-material\",\n        \"hash\": \"c245ac82613b\",\n        \"state\": \"active\"\n      }\n    ],\n    \"diagnostics\": [\n      {\n        \"severity\": \"error\",\n        \"code\": \"missing-basis\",\n        \"id\": \"D1\",\n        \"line\": 81,\n        \"message\": \"decision requires Basis refs\"\n      }\n    ],\n    \"digest\": \"sha256:d8b2009c46fd68e9b1a7d792ea7643cb49d5f6fd0d7dd6c6a25792d9fb007249\"\n  },\n  \"phas