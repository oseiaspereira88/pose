text\", \"auto-validate\", \"--validation-profile\", mode}\npose-mcp/internal/cli/assessment_freshness_workflow_test.go:10:// Spec pose-adaptive-assessment-freshness R4: no workflow, skill or AGENTS\npose-mcp/internal/cli/assessment_freshness_workflow_test.go:14:\tunconditional := regexp.MustCompile(\"pose assess discover(?: --component <dir>| \\\\[--component <dir>\\\\]| --update-state)\")\npose-mcp/internal/cli/surface_check_test.go:105:\tif err := validateDeliveryMatrixContract(matrix); err == nil {\npose-mcp/internal/cli/surface_check.go:26:\tif err := validateDeliveryMatrixContract(matrix); err != nil {\npose-mcp/internal/cli/surface_check.go:196:\t\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\npose-mcp/internal/cli/surface_check.go:211:\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\npose-mcp/internal/cli/surface_check.go:215:\t\tfmt.Fprintln(stderr, \"pose surface-check: invalid spec slug\")\npose-mcp/internal/cli/surface_check.go:220:\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\npose-mcp/internal/cli/surface_check.go:225:\t\t\tfmt.Fprintln(stderr, \"pose surface-check: results path escapes project\")\npose-mcp/internal/cli/surface_check.go:232:\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\npose-mcp/internal/cli/surface_check.go:238:\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\npose-mcp/internal/cli/surface_check.go:243:\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\npose-mcp/internal/cli/surface_check.go:249:\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:32:em cascata. D7 e a emenda aceita no ADR definem coordenador auditado e views\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:37:os checkpoints anteriores e não qualificam a correção D7.\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:119:- [ADR aceito](../adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md)\n.pose/knowledge/2026-10-26-handoff-delegation-observation-round4.md:27:- F01 (low, disclosed under D7): the live view redacts with what the stream has declared so far, and the record is derived again from the whole transcript; a capture the record later withholds can still have been shown live.\npackage pose\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestGovernanceReadViewRoadmapChildrenKeepAuthorizedBinding(t *testing.T) {\n\tstore, _, _ := retentionFixture(t)\n\twriteReviewFixture(t, store.Root, \".pose/roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\n---\\n# Program\\n\\n## Milestone: core\\n- specs: backend\\n\")\n\tbindCurrentReviewFixture(t, store)\n\terr := store.WithReviewCoordinator(func(shared Store) error {\n\t\treturn shared.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\tstate, err := scope.GetCloseoutState(\"roadmap:program\")\n\t\t\tif err == nil && (len(state.Children) != 1 || len(state.Children[0].Children) != 1) {\n\t\t\t\tt.Fatalf(\"children were not evaluated: %+v\", state)\n\t\t\t}\n\t\t\treturn err\n\t\t})\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc TestGovernanceReadViewScopeCoordinatorRetainsCallbackAndAuditFailure(t *testing.T) {\n\troot, _ := d7ProbeCoordinatorRoot(t)\n\tpath := filepath.Join(root, \"policy.json\")\n\tif err := os.WriteFile(path, []byte(\"before\"), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcallbackFailure := errors.New(\"domain evaluation failed\")\n\terr := (Store{Root: root}).WithReviewCoordinator(func(shared Store) error {\n\t\tif _, err := shared.fsys().ReadFile(path); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := os.WriteFile(path, []byte(\"after!\"), 0600); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn callbackFailure\n\t})\n\tif !errors.Is(err, callbackFailure) || !errors.Is(err, ErrGovernanceReadViewChanged) {\n\t\tt.Fatalf(\"callback or audit cause was lost: %v\", err)\n\t}\n}\n\nfunc TestGovernanceReadViewScopeCoordinatorRefusesRetiredOrChangedBinding(t *testing.T) {\n\tfor _, kind := range []string{\"root\", \"project\", \"resolver\", \"files\", \"retired\"} {\n\t\tt.Run(kind, func(t *testing.T) {\n\t\t\troot, _ := d7ProbeCoordinatorRoot(t)\n\t\t\tvar retained Store\n\t\t\tvar scopeErr error\n\t\t\tcalled := false\n\t\t\touterErr := (Store{Root: root}).WithReviewCoordinator(func(shared Store) error {\n\t\t\t\tretained = shared\n\t\t\t\tif kind == \"retired\" {\n\t\t\t\t\treturn nil\n\t\t\t\t}\n\t\t\t\tbad := shared\n\t\t\t\tswitch kind {\n\t\t\t\tcase \"root\":\n\t\t\t\t\tbad.Root = t.TempDir()\n\t\t\t\tcase \"project\":\n\t\t\t\t\tbad.FederatedProjectID = \"proj.foreign\"\n\t\t\t\tcase \"resolver\":\n\t\t\t\t\tbad.FederatedResolver = &ArtifactResolver{}\n\t\t\t\tcase \"files\":\n\t\t\t\t\tbad.FS = NativeFiles()\n\t\t\t\t}\n\t\t\t\tscopeErr = bad.WithReviewScopeOperationView(func(Store) error { called = true; return nil })\n\t\t\t\treturn scopeErr\n\t\t\t})\n\t\t\tif kind == \"retired\" {\n\t\t\t\tif outerErr != nil {\n\t\t\t\t\tt.Fatal(outerErr)\n\t\t\t\t}\n\t\t\t\tscopeErr = retained.WithReviewScopeOperationView(func(Store) error { called = true; return nil })\n\t\t\t}\n\t\t\tif scopeErr == nil || called {\n\t\t\t\tt.Fatalf(\"scope borrowed an unauthorized binding: callback=%t err=%v\", called, scopeErr)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestGovernanceReadViewScopeCoordinatorParallelClosuresStayIndependent(t *testing.T) {\n\troot, path := d7ProbeCoordinatorRoot(t)\n\terr := (Store{Root: root}).WithReviewCoordinator(func(shared Store) error {\n\t\tconst count = 4\n\t\terrs := make(chan error, count)\n\t\tvar wg sync.WaitGroup\n\t\tfor i := 0; i < count; i++ {\n\t\t\twg.Add(1)\n\t\t\tgo func() {\n\t\t\t\tdefer wg.Done()\n\t\t\t\terrs <- shared.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\t\t\trv, _ := governanceReadViewFromFiles(scope.fsys())\n\t\t\t\t\trv.operation.budgetMu.Lock()\n\t\t\t\t\trv.operation.inputBytes = governanceReadViewMaxInputBytes - 40\n\t\t\t\t\trv.operation.budgetMu.Unlock()\n\t\t\t\t\t_, err := scope.fsys().ReadFile(path)\n\t\t\t\t\treturn err\n\t\t\t\t})\n\t\t\t}()\n\t\t}\n\t\twg.Wait()\n\t\tclose(errs)\n\t\tvar combined error\n\t\tfor err := range errs {\n\t\t\tcombined = errors.Join(combined, err)\n\t\t}\n\t\treturn combined\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"independently fitting parallel scopes shared consumption: %v\", err)\n\t}\n}\n\nfunc TestGovernanceReadViewScopeCoordinatorHistoricalApprovalAndLaterRejection(t *testing.T) {\n\tfor _, reject := range []bool{false, true} {\n\t\tlabel := \"retained\"\n\t\tif reject {\n\t\t\tlabel = \"later-rejection\"\n\t\t}\n\t\tt.Run(label, func(t *testing.T) {\n\t\t\tstore, _, now := retentionFixture(t)\n\t\t\tif reject {\n\t\t\t\taddMatrixCheck(t, store)\n\t\t\t\tnext, err := store.SealReviewBundle(\"spec:backend\", now.Add(2*time.Minute))\n\t\t\t\tif err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t\tatt := approvedBundleAttestation(next, \"agent:later\")\n\t\t\t\tatt.Decision = \"rejected\"\n\t\t\t\tif _, err := store.RecordReviewAttestation(att, now.Add(3*time.Minute)); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tcloseBackendSpec(t, store)\n\t\t\taddMatrixCheck(t, store)\n\t\t\tbindCurrentReviewFixture(t, store)\n\t\t\tvar state CloseoutState\n\t\t\terr := store.WithReviewCoordinator(func(shared Store) error {\n\t\t\t\treturn shared.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\t\t\tvar err error\n\t\t\t\t\tstate, err = scope.GetCloseoutState(\"spec:backend\")\n\t\t\t\t\treturn err\n\t\t\t\t})\n\t\t\t})\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif state.Terminal == reject || state.Review.Approved == reject {\n\t\t\t\tt.Fatalf(\"historical decision lost under scoped coordinator: reject=%t state=%+v\", reject, state)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestGovernanceReadViewScopeCoordinatorAuditsCatalogueAfterScopes(t *testing.T) {\n\troot, path := d7ProbeCoordinatorRoot(t)\n\tsp := filepath.Join(root, \".pose/specs/alpha.md\")\n\toriginal := \"---\\nslug: alpha\\nstatus: done\\ncreated_at: 2026-08-13\\ncompleted_at: 2026-08-13\\n---\\nbody\\n\"\n\tif err := os.WriteFile(sp, []byte(original), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\terr := (Store{Root: root}).WithReviewCoordinator(func(shared Store) error {\n\t\tif _, err := shared.ListSpecs(\"\", \"\"); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := shared.WithReviewScopeOperationView(func(scope Store) error { _, err := scope.fsys().ReadFile(path); return err }); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn os.WriteFile(sp, []byte(strings.Replace(original, \"status: done\", \"status: draft\", 1)), 0600)\n\t})\n\tif err == nil || !strings.Contains(err.Error(), \"changed\") {\n\t\tt.Fatalf(\"selection changed after successful scope and escaped coordinator audit: %v\", err)\n\t}\n}\n\nfunc TestGovernanceReadViewScopeAuditPreservesChangeAndIndependentUnknown(t *testing.T) {\n\taudit := governanceReadViewAudit{ChangedPaths: []string{\"changed.json\"}, ChangedProducers: map[string]bool{\"review-operation\": true}, UnknownProducers: map[string][]string{\"review-operation\": {\"a different input exceeded its final-audit budget\"}}}\n\terr := reviewOperationGovernanceAuditError(audit, nil, nil)\n\tif !errors.Is(err, ErrGovernanceReadViewChanged) || !errors.Is(err, ErrGovernanceReadViewUnknown) {\n\t\tt.Fatalf(\"independent changed/unknown causes were collapsed: %v\", err)\n\t}\n}\n\t\tt.Fatal(err)\n\t}\n\taudit := view.auditSingleWithBudget(&governanceReadViewAuditBudget{records: governanceReadViewMaxRecords})\n\tif len(audit.UnknownProducers[\"d7-probe\"]) == 0 {\n\t\tt.Fatalf(\"audit exhaustion was certified: %+v\", audit)\n\t}\n\tif len(audit.ChangedPaths) != 0 || audit.ChangedProducers[\"d7-probe\"] {\n\t\tt.Fatalf(\"unchanged input was labelled as an observed mutation: %+v\", audit)\n\t}\n}\n\nfunc d7ProbeCoordinatorRoot(t *testing.T) (string, string) {\n\tt.Helper()\n\troot := t.TempDir()\n\tfor _, rel := range []string{\".pose/specs\", \".pose/review-bundles\"} {\n\t\tif err := os.MkdirAll(filepath.Join(root, rel), 0700); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tpath := filepath.Join(root, \"scope-input.json\")\n\tif err := os.WriteFile(path, []byte(strings.Repeat(\"x\", 32)), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn root, path\n}\n\nfunc TestGovernanceReadViewD7ProbeSaturatedCoordinatorDoesNotConsumeScopeBudget(t *testing.T) {\n\troot, path := d7ProbeCoordinatorRoot(t)\n\tcount := 0\n\terr := (Store{Root: root}).WithReviewCoordinator(func(coordinator Store) error {\n\t\t// Warm the bounded catalog before admitting independent scopes. Simulate\n\t\t// previous coordinator consumption with counters, not huge allocations.\n\t\tif err := coordinator.WithReviewScopeOperationView(func(Store) error { return nil }); err != nil {\n\t\t\treturn err\n\t\t}\n\t\trv, _ := governanceReadViewFromFiles(coordinator.fsys())\n\t\trv.operation.budgetMu.Lock()\n\t\trv.operation.inputBytes = governanceReadViewMaxInputBytes - 8\n\t\trv.operation.metadataBytes = governanceReadViewMaxMetadata - 8\n\t\trv.operation.records = governanceReadViewMaxRecords - 1\n\t\trv.operation.budgetMu.Unlock()\n\t\tfor i := 0; i < 2; i++ {\n\t\t\tif err := coordinator.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\t\traw, err := scope.fsys().ReadFile(path)\n\t\t\t\tif err == nil && len(raw) != 32 {\n\t\t\t\t\treturn fmt.Errorf(\"scope returned %d bytes\", len(raw))\n\t\t\t\t}\n\t\t\t\tif err == nil {\n\t\t\t\t\tcount++\n\t\t\t\t}\n\t\t\t\treturn err\n\t\t\t}); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil || count != 2 {\n\t\tt.Fatalf(\"fitting scope reads inherited coordinator exhaustion: count=%d err=%v\", count, err)\n\t}\n}\n\nfunc TestGovernanceReadViewD7ProbeScopeLossDoesNotPoisonHealthySibling(t *testing.T) {\n\troot, path := d7ProbeCoordinatorRoot(t)\n\tvar scopeLoss error\n\thealthy := false\n\terr := (Store{Root: root}).WithReviewCoordinator(func(coordinator Store) error {\n\t\tscopeLoss = coordinator.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\trv, _ := governanceReadViewFromFiles(scope.fsys())\n\t\t\trv.operation.budgetMu.Lock()\n\t\t\trv.operation.records = governanceReadViewMaxRecords\n\t\t\trv.operation.budgetMu.Unlock()\n\t\t\t_, err := scope.fsys().ReadFile(path)\n\t\t\treturn err\n\t\t})\n\t\tsiblingErr := coordinator.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\t_, err := scope.fsys().ReadFile(path)\n\t\t\thealthy = err == nil\n\t\t\treturn err\n\t\t})\n\t\treturn errors.Join(scopeLoss, siblingErr)\n\t})\n\tif scopeLoss == nil || !healthy || !errors.Is(err, ErrGovernanceReadViewUnknown) {\n\t\tt.Fatalf(\"loss was suppressed or poisoned sibling: scope=%v healthy=%t coordinator=%v\", scopeLoss, healthy, err)\n\t}\n}\n\n// The registry is an operation input, not a file in any one root. Inject its\n// final observation at the same boundary used by the production wrappers.\nfunc injectGovernanceRegistryAudit(store Store, mode string) {\n\tview, _ := governanceReadViewFromFiles(store.fsys())\n\top := view.operation\n\top.mu.Lock()\n\troots := map[string]string{}\n\tfor project, root := range op.initialRoots {\n\t\troots[project] = root\n\t}\n\tconflicts := cloneBoolMap(op.initialConflicts)\n\top.currentRoots = func() (map[string]string, map[string]bool, bool) {\n\t\tif mode == \"changed\" {\n\t\t\troots[\"proj.added\"] = filepath.Join(store.Root, \"added-root\")\n\t\t}\n\t\tif mode == \"conflict\" {\n\t\t\tconflicts[op.mainProject] = true\n\t\t}\n\t\treturn roots, conflicts, mode == \"budget\"\n","exit_code":0,"status":"completed"}}
