2a4fb077dc7c41.events.ndjson |   52 +\n .pose/review-runs/rrn-162a4fb077dc7c41.json        |  136 +\n .pose/review-runs/rrn-162a4fb077dc7c41.transcript  |   53 +\n .../review-runs/rrn-d5d871d0c275983e.events.ndjson |   59 +\n .pose/review-runs/rrn-d5d871d0c275983e.json        |  143 +\n .pose/review-runs/rrn-d5d871d0c275983e.transcript  |  286 +\n ...-15-pose-check-shares-the-federated-material.md |  150 +\n .../pose-check-shares-the-federated-material.json  |   47 +\n pose-mcp/internal/pose/governance_read_view.go     |   15 +\n pose-mcp/internal/pose/review_operation_view.go    |    8 +\n .../pose/review_scope_index_inputs_test.go         |   95 +\n 38 files changed, 16441 insertions(+), 4172 deletions(-)\n","exit_code":0,"status":"completed"}}
