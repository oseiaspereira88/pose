{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '635,755p' pose-mcp/internal/pose/governance_read_view.go; sed -n '285,395p' pose-mcp/internal/cli/check.go; sed -n '30,120p' pose-mcp/internal/pose/review_operation_view.go; cat .pose/rules/backend-go.md\"","aggregated_output":"// checkIndexInputs verifies the declared source bindings only when a producer\n// actually consumes a derived index. Taking a pin for snapshot identity alone\n// does not make the projection depend on that index, so the projection producer\n// deliberately skips this check. The work is shared per root, generation and\n// producer; each producer still records its own observations and limitation.\nfunc (op *governanceReadViewOperation) checkIndexInputs(files Files, root, producer string, pin *IndexGenerationView) []string {\n\tif op == nil || pin == nil || pin.Status != IndexGenerationCurrent {\n\t\treturn nil\n\t}\n\tif from := op.indexInputsFrom; from != nil && from != op {\n\t\treturn from.checkIndexInputs(op.indexInputsFiles, root, producer, pin)\n\t}\n\tabs, err := filepath.Abs(root)\n\tif err != nil {\n\t\treturn []string{\"index input root could not be resolved\"}\n\t}\n\tkey := filepath.Clean(abs) + \"\\x00\" + pin.Descriptor.GenerationID + \"\\x00\" + producer\n\top.mu.Lock()\n\tif op.indexInputChecks == nil {\n\t\top.indexInputChecks = map[string]*governanceReadViewIndexInputCheck{}\n\t}\n\tif prior := op.indexInputChecks[key]; prior != nil {\n\t\tready := prior.ready\n\t\top.mu.Unlock()\n\t\t<-ready\n\t\treturn append([]string(nil), prior.reasons...)\n\t}\n\tcheck := &governanceReadViewIndexInputCheck{ready: make(chan struct{})}\n\top.indexInputChecks[key] = check\n\top.mu.Unlock()\n\n\treasons := []string{}\n\tfor _, name := range IndexInputNames {\n\t\tbound, exists := pin.Descriptor.Inputs[name]\n\t\tif !exists || strings.TrimSpace(bound) == \"\" {\n\t\t\treasons = append(reasons, \"index generation does not bind input \"+name)\n\t\t\tcontinue\n\t\t}\n\t\tcurrent, known := op.indexInputBinding(files, root, producer, name)\n\t\tif !known || current == \"\" {\n\t\t\treasons = append(reasons, \"current index input \"+name+\" could not be bounded\")\n\t\t\tcontinue\n\t\t}\n\t\tif current != bound {\n\t\t\treasons = append(reasons, \"index input \"+name+\" changed since generation \"+pin.Descriptor.GenerationID)\n\t\t}\n\t}\n\treasons = uniqueSorted(reasons)\n\top.mu.Lock()\n\tcheck.reasons = append([]string(nil), reasons...)\n\tclose(check.ready)\n\top.mu.Unlock()\n\treturn reasons\n}\n\n// governanceIndexInputBindingObserved sees each computation of an index\n// input's binding; tests count them.\nvar governanceIndexInputBindingObserved = func(root, name string) {}\n\n// Revalidation must use the same captured project/resolver context as the\n// generation consumer, including when that consumer is a foreign Store.\nfunc (op *governanceReadViewOperation) indexInputBinding(files Files, root, producer, name string) (string, bool) {\n\tgovernanceIndexInputBindingObserved(root, name)\n\tif name != \"federated-material\" {\n\t\treturn IndexInputBindingIn(files, root, name)\n\t}\n\top.mu.Lock()\n\tproject, selectedRoot := op.rootForPathLocked(governanceAbsoluteRoot(root), \"\")\n\tconflict := op.initialConflicts[project]\n\top.mu.Unlock()\n\tif project == \"\" || conflict || !sameLexicalRoot(root, selectedRoot) {\n\t\treturn \"\", false\n\t}\n\tresolver := op.resolver\n\tresolver.FS = files\n\tresolver.Roots = op.rootsForProducer(resolver.Roots, files, producer)\n\tresolver.snapshots = nil\n\tresolver.governanceDepthLimit = 8\n\treturn IndexInputBindingForStoreIn(Store{Root: root, FS: files, FederatedProjectID: project, FederatedResolver: &resolver}, name)\n}\n\nfunc (s Store) governanceIndexConsumed(status IndexGenerationStatus, err error, pin *IndexGenerationView) {\n\tif err != nil {\n\t\treturn\n\t}\n\tview, carrier := governanceReadViewFromFiles(s.fsys())\n\tif view == nil || carrier == nil || carrier.producer == \"\" || carrier.producer == \"projection\" {\n\t\treturn\n\t}\n\tproducer := carrier.producer\n\tproject := carrier.project\n\tswitch status {\n\tcase IndexGenerationLegacy:\n\t\tmarkGovernanceReadUnknownForProject(s.fsys(), s.Root, project, producer, \"a legacy index has no bound input generation\")\n\t\treturn\n\tcase IndexGenerationCurrent:\n\tdefault:\n\t\treturn\n\t}\n\tif pin == nil {\n\t\tpin = s.indexPin\n\t}\n\tif pin == nil {\n\t\tcaptured := s.ReadIndexGeneration()\n\t\tpin = &captured\n\t}\n\tif pin.Status != IndexGenerationCurrent {\n\t\tmarkGovernanceReadUnknownForProject(s.fsys(), s.Root, project, producer, \"the consumed index generation could not be fixed\")\n\t\treturn\n\t}\n\tif view.operation == nil {\n\t\tmarkGovernanceReadUnknownForProject(s.fsys(), s.Root, project, producer, \"the consumed index has no operation-scoped input bindings\")\n\t\treturn\n\t}\n\tfor _, reason := range view.operation.checkIndexInputs(s.fsys(), s.Root, producer, pin) {\n\t\tmarkGovernanceReadUnknownForProject(s.fsys(), s.Root, project, producer, reason)\n\t}\n}\n\n// adoptCapturedView charges the bounded index-generation read made while a\n// lazy root binding was being initialized. The view is not published to other\n\t\tif err != nil || !found || len(claims) == 0 {\n\t\t\tchecker.failOrWarn(fmt.Sprintf(\"artifact contract: spec:%s requires one structured claim or none reason: %v\", slug, err))\n\t\t}\n\t}\n}\n\nfunc (checker *nativeChecker) checkReviewCloseout() {\n\tpolicyPath := filepath.Join(checker.root, \".pose\", \"policy\", \"review.json\")\n\tstore := pose.Store{Root: checker.root, FS: checker.fsys()}\n\tvar findings []string\n\tviewErr := store.WithReviewCoordinator(func(store pose.Store) error {\n\t\tfiles := pose.FilesOrNative(store.FS)\n\t\traw, err := files.ReadFile(policyPath)\n\t\tif os.IsNotExist(err) {\n\t\t\treturn nil\n\t\t}\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"cannot read policy: %w\", err)\n\t\t}\n\t\tvar policy struct {\n\t\t\tEnabled   bool   `json:\"enabled\"`\n\t\t\tAdoptedAt string `json:\"adopted_at\"`\n\t\t}\n\t\tif err := json.Unmarshal(raw, &policy); err != nil || policy.AdoptedAt == \"\" {\n\t\t\treturn fmt.Errorf(\"invalid review policy\")\n\t\t}\n\t\tif !policy.Enabled {\n\t\t\treturn nil\n\t\t}\n\t\trefs := []string{}\n\t\tfor _, path := range findSpecFilesIn(files, checker.root) {\n\t\t\tfm := simpleFrontmatterIn(files, path)\n\t\t\tif fm[\"status\"] != \"done\" || fm[\"completed_at\"] < policy.AdoptedAt {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tslug := fm[\"slug\"]\n\t\t\tif slug == \"\" {\n\t\t\t\tslug = filepath.Base(filepath.Dir(path))\n\t\t\t}\n\t\t\trefs = append(refs, \"spec:\"+slug)\n\t\t}\n\t\troadmapPaths, err := pose.GlobIn(files, filepath.Join(checker.root, \".pose\", \"roadmaps\", \"*.md\"))\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"cannot enumerate roadmaps: %w\", err)\n\t\t}\n\t\tfor _, path := range roadmapPaths {\n\t\t\tfm := simpleFrontmatterIn(files, path)\n\t\t\tif fm[\"status\"] == \"done\" && fm[\"created_at\"] >= policy.AdoptedAt {\n\t\t\t\trefs = append(refs, \"roadmap:\"+strings.TrimSuffix(filepath.Base(path), \".md\"))\n\t\t\t}\n\t\t}\n\t\tresults := make([][]string, len(refs))\n\t\t// Bound live scope closures even when the worker override or host CPU count\n\t\t// is large. Retain only evaluated findings after each scope's final audit.\n\t\tslots := min(16, len(refs))\n\t\tchecker.failOrWarnPerItem(slots, func(slot int) []string {\n\t\t\tfor i := slot; i < len(refs); i += slots {\n\t\t\t\tref := refs[i]\n\t\t\t\tvar state pose.CloseoutState\n\t\t\t\terr := store.WithReviewScopeOperationView(func(scoped pose.Store) error {\n\t\t\t\t\tvar err error\n\t\t\t\t\tstate, err = scoped.GetCloseoutState(ref)\n\t\t\t\t\treturn err\n\t\t\t\t})\n\t\t\t\tif err != nil {\n\t\t\t\t\tresults[i] = []string{\"review closeout: \" + ref + \": \" + err.Error()}\n\t\t\t\t} else if !state.Terminal {\n\t\t\t\t\tresults[i] = []string{\"review closeout: \" + ref + \": \" + state.NextAction}\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn nil\n\t\t})\n\t\tfor _, messages := range results {\n\t\t\tfindings = append(findings, messages...)\n\t\t}\n\t\treturn nil\n\t})\n\t// A failed coordinator audit prevents a green gate, but does not erase\n\t// independently audited scope failures already buffered above.\n\tfor _, finding := range findings {\n\t\tchecker.failOrWarn(finding)\n\t}\n\tif viewErr != nil {\n\t\tchecker.failOrWarn(\"review closeout: \" + viewErr.Error())\n\t}\n}\n\nfunc (checker *nativeChecker) checkRequiredStructure() {\n\trequired := []string{\"AGENTS.md\", \"POSE.md\", \".pose\", \".pose/workflows\", \".pose/templates\", \".pose/rules\", \".pose/workflows/feature.md\", \".pose/workflows/review.md\", \".pose/workflows/bugfix.md\", \".pose/templates/spec.md\"}\n\tfor _, rel := range required {\n\t\tif _, err := checker.fsys().Stat(filepath.Join(checker.root, filepath.FromSlash(rel))); err != nil {\n\t\t\tchecker.issue(cliout.StateError, checker.message(\"Required path missing: \", \"Path obrigatório ausente: \")+filepath.Join(checker.root, filepath.FromSlash(rel)))\n\t\t}\n\t}\n}\n\nfunc (checker *nativeChecker) checkSchemaVersion() {\n\tpath := filepath.Join(checker.root, \".pose\", \"schema-version\")\n\tcontent, err := checker.fsys().ReadFile(path)\n\tif err != nil {\n\t\tchecker.failOrWarn(checker.message(\"schema: instance has no .pose/schema-version — run 'pose update'\", \"schema: instância sem .pose/schema-version — rode 'pose update'\"))\n\t\treturn\n\t}\n\tversion, err := strconv.Atoi(strings.TrimSpace(string(content)))\n\tif err != nil {\n\t\tchecker.issue(cliout.StateError, fmt.Sprintf(checker.message(\"schema: invalid .pose/schema-version (%q)\", \"schema: .pose/schema-version inválido (%q)\"), strings.TrimSpace(string(content))))\n\t\treturn\n\t}\n\tif version > nativeSchemaVersion {\n\t\tchecker.issue(cliout.StateError, fmt.Sprintf(checker.message(\"schema: instance v%d is newer than engine v%d\", \"schema: instância v%d é mais nova que o motor v%d\"), version, nativeSchemaVersion))\n\t}\n\t\tloss := SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossReadError, Detail: err.Error()}\n\t\treturn reviewHeaderObservation{loss: &loss, readError: err.Error()}\n\t}\n\tresult := reviewHeaderObservation{digest: sha256.Sum256(raw), inputBytes: len(raw)}\n\t// What a bundle's bytes say about their scope is a function of the\n\t// bytes: it is parsed once per content digest, so a governance check\n\t// that reads every bundle for every scope parses each content once\n\t// (spec pose-federated-proof-reads-each-input-once).\n\tparsed := reviewBundleHeaderParses.get(string(result.digest[:]), func() (reviewBundleHeaderParse, bool) {\n\t\treturn parseReviewBundleHeader(raw, rel), true\n\t})\n\tresult.owner = parsed.owner\n\tif parsed.loss != nil {\n\t\tloss := *parsed.loss\n\t\tloss.Artifact = rel\n\t\tresult.loss = &loss\n\t}\n\treturn result\n}\n\n// parseReviewBundleHeader reads the scope a bundle's bytes declare, or why\n// they declare none.\nfunc parseReviewBundleHeader(raw []byte, rel string) reviewBundleHeaderParse {\n\tvar header struct {\n\t\tPayload struct {\n\t\t\tScope struct {\n\t\t\t\tRef string `json:\"ref\"`\n\t\t\t} `json:\"scope\"`\n\t\t} `json:\"payload\"`\n\t}\n\tvar loss SourceLoss\n\tswitch {\n\tcase json.Unmarshal(raw, &header) != nil:\n\t\tloss = attributeLoss(SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossParseError, Detail: \"the record is not valid JSON\"}, raw, \"payload\", \"scope\", \"ref\")\n\tcase func() bool { _, _, ambiguous := sniffJSONString(raw, \"payload\", \"scope\", \"ref\"); return ambiguous }():\n\t\tloss = SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossInvalid, Detail: \"the record names its scope more than once\"}\n\tcase header.Payload.Scope.Ref == \"\":\n\t\tloss = SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossParseError, Detail: \"the record names no scope\"}\n\tdefault:\n\t\treturn reviewBundleHeaderParse{owner: header.Payload.Scope.Ref}\n\t}\n\treturn reviewBundleHeaderParse{loss: &loss}\n}\n\n// reviewBundleHeaderParses keeps, per content digest, the scope a bundle\n// names or why it names none; bounded for a long-running process.\nvar reviewBundleHeaderParses = newKeptCache[reviewBundleHeaderParse](50000)\n\ntype reviewBundleHeaderParse struct {\n\towner string\n\tloss  *SourceLoss\n}\n\ntype reviewOperationView struct {\n\tcoordinator      *reviewOperationView\n\tcoordinatorStore Store\n\tscopeBase        Store\n\tscopeRoots       map[string]string\n\tscopeConflicts   map[string]bool\n\tscopeInit        sync.Once\n\tscopeInitErr     error\n\n\tspecOnce        sync.Once\n\tspecUsed        bool\n\tspecErr         error\n\tspecFallback    bool\n\tspecEntries     []Spec\n\tspecBySlug      map[string]int\n\tspecBodyMu      sync.Mutex\n\tspecBodySeen    []bool\n\tspecBodyDigests [][32]byte\n\tspecConflict    bool\n\troot            string\n\tfiles           Files\n\tproject         string\n\tresolver        *ArtifactResolver\n\tonce            sync.Once\n\tclosed          atomic.Bool\n\tcontextConflict atomic.Bool\n\tused            bool // published by once; consumers call once before inspecting it\n\tdirectoryError  string\n\tinventory       [32]byte\n\theaders         map[string]reviewHeaderObservation\n\tfallback        bool\n\tmaxRecords      int\n\tmaxInputBytes   int\n\tmaxRetainedText int\n}\n\n// WithReviewOperationView shares immutable headers and spec metadata for this\n// callback. Strict loading, ordering, trust and each worker's traversal remain\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n","exit_code":0,"status":"completed"}}
