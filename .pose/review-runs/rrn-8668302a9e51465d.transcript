{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '120,210p' pose-mcp/internal/pose/review_operation_view.go; sed -n '250,410p' pose-mcp/internal/pose/review_operation_view.go; sed -n '390,480p' pose-mcp/internal/pose/index_generation.go; rg -n 'func .*beginGovernance|rootForPathLocked|rootsForProducer|baseStore|indexPin' pose-mcp/internal/pose/governance_read_view.go\"","aggregated_output":"// callback. Strict loading, ordering, trust and each worker's traversal remain\n// live. Finalization rereads observed bytes before the read can be green.\n// This is not an atomic filesystem snapshot or a write authorization cache.\nfunc (s Store) WithReviewOperationView(run func(Store)) error {\n\tbaseFiles := s.fsys()\n\tkeyable := reflect.ValueOf(baseFiles).Comparable()\n\tbase, readView := s.beginGovernanceReadView()\n\tshared := base.withGovernanceReadView(readView, \"review-operation\")\n\tview := &reviewOperationView{root: filepath.Clean(shared.Root), files: shared.fsys(),\n\t\tproject: shared.FederatedProjectID, resolver: shared.FederatedResolver,\n\t\tmaxRecords: 10000, maxInputBytes: 128 * 1024 * 1024, maxRetainedText: 8 * 1024 * 1024}\n\tvar operationErr error\n\tif !keyable {\n\t\t// Unknown identity cannot safely key the bounded optimization. The\n\t\t// operation still reads through the governance view and receives its\n\t\t// final closure audit; it simply falls back to live catalogue traversal.\n\t\tshared.reviewView = nil\n\t\tshared.specs = nil\n\t\tshared.reviewReuse = nil\n\t\trun(shared)\n\t} else {\n\t\toperationErr = shared.withReviewOperationView(view, run)\n\t}\n\taudit := readView.audit()\n\treturn errors.Join(operationErr, reviewOperationGovernanceAuditError(audit, readView, view))\n}\n\nfunc reviewOperationGovernanceAuditError(audit governanceReadViewAudit, readView *governanceReadView, operationView *reviewOperationView) error {\n\tvar result error\n\tchanged := audit.ChangedProducers[\"review-operation\"] || audit.ChangedProducers[\"projection\"]\n\tif changed {\n\t\tpaths := append([]string(nil), audit.ChangedPaths...)\n\t\tif len(paths) == 0 {\n\t\t\tpaths = []string{\"input closure\"}\n\t\t}\n\t\tresult = fmt.Errorf(\"pose: review inputs changed during operation: %s: %w\", strings.Join(uniqueSorted(paths), \", \"), ErrGovernanceReadViewChanged)\n\t}\n\t// The operation view certifies the bytes and metadata its review producers\n\t// consumed. Projection-only context such as an unavailable HEAD does not\n\t// become a write authorization or a current-generation claim here; any\n\t// unprovable read attributed to this operation still fails closed.\n\tif reasons := audit.UnknownProducers[\"review-operation\"]; len(reasons) > 0 && !reviewOperationReadLossIsCovered(audit, readView, operationView) {\n\t\tresult = errors.Join(result, fmt.Errorf(\"pose: review input closure is unknown: %s: %w\", strings.Join(uniqueSorted(reasons), \"; \"), ErrGovernanceReadViewUnknown))\n\t}\n\treturn result\n}\n\n// reviewOperationReadLossIsCovered keeps a stable, unreadable bundle in the\n// operation result as source-coverage loss. ReadReviewBundles reports that\n// loss to its caller, and validate() proves the same file remains unreadable;\n// this wrapper should not turn a localized record loss into a second API error.\n// Other unknown inputs still make the operation result unavailable.\nfunc reviewOperationReadLossIsCovered(audit governanceReadViewAudit, readView *governanceReadView, operationView *reviewOperationView) bool {\n\tif readView == nil || operationView == nil || !operationView.used || operationView.fallback {\n\t\treturn false\n\t}\n\tfor _, reason := range audit.UnknownProducers[\"review-operation\"] {\n\t\tif reason != \"input bytes could not be read\" {\n\t\t\treturn false\n\t\t}\n\t}\n\treadView.mu.Lock()\n\tdefer readView.mu.Unlock()\n\tcovered := map[string]string{}\n\tfor name, observation := range operationView.headers {\n\t\tif observation.readError == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif observation.loss == nil || observation.loss.Kind != LossReadError {\n\t\t\treturn false\n\t\t}\n\t\tcovered[filepath.Base(name)] = observation.readError\n\t}\n\tif len(covered) == 0 {\n\t\treturn false\n\t}\n\tmatched := 0\n\tfor path, observation := range readView.files {\n\t\tif !observation.producers[\"review-operation\"] || observation.err == nil || os.IsNotExist(observation.err) {\n\t\t\tcontinue\n\t\t}\n\t\trel, err := filepath.Rel(operationView.root, path)\n\t\tif err != nil || !strings.HasPrefix(filepath.ToSlash(rel), \".pose/review-bundles/\") {\n\t\t\treturn false\n\t\t}\n\t\tname := filepath.Base(path)\n\t\tif covered[name] == \"\" || covered[name] != observation.errText {\n\t\t\treturn false\n\t\t}\n\t\tdelete(covered, name)\n\t\tmatched++\n\t\t}\n\t\tif readView.operation == nil {\n\t\t\tif filepath.Clean(s.Root) != filepath.Clean(readView.root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t\t// A same-root advisory view may be attached directly to a local Store\n\t\t\t// without an operation coordinator. Keep that local read path usable,\n\t\t\t// but do not infer a federated identity or borrow a resolver binding.\n\t\t\tif s.FederatedProjectID != viewFiles.project || s.FederatedResolver != nil || viewFiles.project != \"\" {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t} else {\n\t\t\t// StoreFor(project) deliberately returns an unscoped Store whose Files\n\t\t\t// wrapper still carries the primary read view. Route by the captured\n\t\t\t// project/root vector first, then verify the selected root itself;\n\t\t\t// comparing against readView.root here would reject every valid child.\n\t\t\trouteProject := viewFiles.project\n\t\t\tif routeProject == \"\" {\n\t\t\t\trouteProject = s.FederatedProjectID\n\t\t\t}\n\t\t\tif routeProject == \"\" {\n\t\t\t\trouteProject = readView.operation.mainProject\n\t\t\t}\n\t\t\tif !sameLexicalRoot(readView.operation.initialRoots[routeProject], s.Root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t\ttarget := readView.operation.route(s.Root, viewFiles.producer, routeProject)\n\t\t\tif target == nil || !sameLexicalRoot(target.root, s.Root) {\n\t\t\t\treturn Store{}, s.refuseReviewOperationContext(readView, viewFiles)\n\t\t\t}\n\t\t}\n\t}\n\treturn s, nil\n}\n\nfunc (s Store) refuseReviewOperationContext(readView *governanceReadView, viewFiles *governanceReadViewFiles) error {\n\tif s.reviewView != nil && !s.reviewView.closed.Load() {\n\t\ts.reviewView.contextConflict.Store(true)\n\t}\n\tif readView != nil {\n\t\tproducer := \"review-operation\"\n\t\tif viewFiles != nil && viewFiles.producer != \"\" {\n\t\t\tproducer = viewFiles.producer\n\t\t}\n\t\treadView.markUnknown(producer, \"review Store context no longer matches the authorized operation binding\")\n\t}\n\treturn fmt.Errorf(\"pose: review Store context changed: %w\", errGovernanceReadViewOutsideRoot)\n}\n\nfunc (v *reviewOperationView) captureSpecs(s Store) {\n\tv.specOnce.Do(func() {\n\t\tv.specUsed = true\n\t\tentries, err := s.listSpecs(\"\", \"\")\n\t\tv.specErr = err\n\t\tif err != nil {\n\t\t\treturn\n\t\t}\n\t\tif len(entries) > v.maxRecords {\n\t\t\tv.specFallback = true\n\t\t\treturn\n\t\t}\n\t\tretained := 0\n\t\tfor _, sp := range entries {\n\t\t\traw, _ := json.Marshal(sp)\n\t\t\tretained += len(raw)\n\t\t\tif retained > v.maxRetainedText {\n\t\t\t\tv.specFallback = true\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\tv.specEntries = entries\n\t\tv.specBySlug = make(map[string]int, len(entries))\n\t\tfor i, sp := range entries {\n\t\t\tif _, exists := v.specBySlug[sp.Slug]; exists {\n\t\t\t\tv.specBySlug[sp.Slug] = -1\n\t\t\t} else {\n\t\t\t\tv.specBySlug[sp.Slug] = i\n\t\t\t}\n\t\t}\n\t\tv.specBodySeen = make([]bool, len(entries))\n\t\tv.specBodyDigests = make([][32]byte, len(entries))\n\t})\n}\n\nfunc (s Store) reviewViewSpec(slug string) (*Spec, bool, error) {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil, false, nil\n\t}\n\tv.captureSpecs(s)\n\tif v.specFallback {\n\t\treturn nil, false, nil\n\t}\n\tif v.specErr != nil {\n\t\treturn nil, true, v.specErr\n\t}\n\tindex, exists := v.specBySlug[slug]\n\tif !exists {\n\t\treturn nil, true, fmt.Errorf(\"pose: spec %q not found\", slug)\n\t}\n\tif index < 0 {\n\t\treturn nil, true, SpecIdentityConflictError{Slug: slug}\n\t}\n\tfull, err := s.readListedSpec(cloneSpec(v.specEntries[index]))\n\treturn full, true, err\n}\n\nfunc (s Store) reviewViewSpecs(status, components string) ([]Spec, bool, error) {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil, false, nil\n\t}\n\tv.captureSpecs(s)\n\tif v.specFallback {\n\t\treturn nil, false, nil\n\t}\n\tif v.specErr != nil {\n\t\treturn nil, true, v.specErr\n\t}\n\twantedStatus, wantedComponents := splitStatusFilter(status), splitCommaFilter(components)\n\tresult := []Spec{}\n\tfor _, sp := range v.specEntries {\n\t\tif len(wantedStatus) > 0 && !statusMatchesAny(sp.Status, wantedStatus) {\n\t\t\tcontinue\n\t\t}\n\t\tif len(wantedComponents) > 0 && !componentsMatchAny(sp.Components, wantedComponents) {\n\t\t\tcontinue\n\t\t}\n\t\tresult = append(result, cloneSpec(sp))\n\t}\n\treturn result, true, nil\n}\n\nfunc (s Store) observeReviewSpecBody(listed Spec, full *Spec) error {\n\tv := s.reviewView\n\tif v == nil || !v.boundTo(s) {\n\t\treturn nil\n\t}\n\tv.captureSpecs(s)\n\tif v.specFallback {\n\t\treturn nil\n\t}\n\tif v.specErr != nil {\n\t\treturn v.specErr\n\t}\n\tindex, exists := v.specBySlug[listed.Slug]\n\tmetadata := *full\n\tmetadata.Body = \"\"\n\tdigest := sha256.Sum256([]byte(full.Body))\n\tv.specBodyMu.Lock()\n\tdefer v.specBodyMu.Unlock()\n\tif !exists || index < 0 || !reflect.DeepEqual(metadata, v.specEntries[index]) || (v.specBodySeen[index] && v.specBodyDigests[index] != digest) {\n\t\tv.specConflict = true\n\t\treturn fmt.Errorf(\"pose: review inputs changed during operation: spec %s\", listed.Slug)\n\t}\n\tv.specBodySeen[index] = true\n\tv.specBodyDigests[index] = digest\n\treturn nil\n}\n\nfunc (v *reviewOperationView) validateSpecs() error {\n\t\tif againErr == nil && again.GenerationID == desc.GenerationID && string(againRaw) == string(raw) {\n\t\t\tif problem != \"\" {\n\t\t\t\treturn IndexGenerationView{Status: IndexGenerationUnavailable, Reason: problem, Descriptor: desc}\n\t\t\t}\n\t\t\treturn IndexGenerationView{Status: IndexGenerationCurrent, Descriptor: desc, Files: files, Diverged: diverged, DescriptorBytes: raw}\n\t\t}\n\t}\n\treturn IndexGenerationView{Status: IndexGenerationUnavailable, Reason: \"the generation descriptor kept changing while it was read\"}\n}\n\n// ReadIndex returns the bytes of one index and what may be concluded from them.\n// For a published set the file is checked against the descriptor, so a file that\n// belongs to another generation is an error that wraps ErrIndexGenerationUnavailable.\n// For a repository that never published a set the file is returned as before,\n// with status IndexGenerationLegacy and no claim of coherence. A missing file is\n// os.ErrNotExist in both cases.\nfunc (s Store) ReadIndex(name string) ([]byte, IndexGenerationStatus, error) {\n\tknown := false\n\tfor _, n := range IndexGenerationFiles {\n\t\tknown = known || n == name\n\t}\n\tif !known {\n\t\treturn nil, \"\", fmt.Errorf(\"pose: %s is not an index of a generation\", name)\n\t}\n\tif pin := s.indexPin; pin != nil {\n\t\tswitch pin.Status {\n\t\tcase IndexGenerationCurrent:\n\t\t\traw := pin.Files[name]\n\t\t\ts.governanceIndexConsumed(IndexGenerationCurrent, nil, pin)\n\t\t\treturn raw, IndexGenerationCurrent, nil\n\t\tcase IndexGenerationUnavailable:\n\t\t\treturn nil, IndexGenerationUnavailable, fmt.Errorf(\"pose: %w: %s\", ErrIndexGenerationUnavailable, pin.Reason)\n\t\t}\n\t\t// A pin taken while the repository had no descriptor does not keep the\n\t\t// bytes: if a first publication has started since, the files may mix two\n\t\t// runs, and the operation is told so instead of reading them.\n\t\tif indexPendingIn(s.fsys(), s.Root) || indexDescriptorExists(s.fsys(), s.Root) {\n\t\t\treturn nil, IndexGenerationUnavailable, fmt.Errorf(\"pose: %w: the indexes were published as a set while this operation was reading them; run it again\", ErrIndexGenerationUnavailable)\n\t\t}\n\t\traw, readErr := s.fsys().ReadFile(filepath.Join(indexDir(s.Root), name))\n\t\tif indexPendingIn(s.fsys(), s.Root) || indexDescriptorExists(s.fsys(), s.Root) {\n\t\t\treturn nil, IndexGenerationUnavailable, fmt.Errorf(\"pose: %w: the indexes were published as a set while %s was read; run the operation again\", ErrIndexGenerationUnavailable, name)\n\t\t}\n\t\ts.governanceIndexConsumed(IndexGenerationLegacy, readErr, pin)\n\t\treturn raw, IndexGenerationLegacy, readErr\n\t}\n\tfor attempt := 0; attempt < indexReadAttempts; attempt++ {\n\t\tdesc, descRaw, exists, err := readIndexDescriptor(s.fsys(), s.Root)\n\t\tif err != nil {\n\t\t\treturn nil, IndexGenerationUnavailable, fmt.Errorf(\"pose: %w: %s\", ErrIndexGenerationUnavailable, err)\n\t\t}\n\t\tif !exists {\n\t\t\tif indexPendingIn(s.fsys(), s.Root) {\n\t\t\t\treturn nil, IndexGenerationUnavailable, fmt.Errorf(\"pose: %w: a first index generation was being published and did not commit; run `pose index`\", ErrIndexGenerationUnavailable)\n\t\t\t}\n\t\t\traw, readErr := s.fsys().ReadFile(filepath.Join(indexDir(s.Root), name))\n\t\t\t// The repository may have moved to a first publication (pending marker or\n\t\t\t// descriptor) while the file was read: the bytes then may belong to a run\n\t\t\t// that is not the one before it, so start again and judge the new state.\n\t\t\tif indexPendingIn(s.fsys(), s.Root) || indexDescriptorExists(s.fsys(), s.Root) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\ts.governanceIndexConsumed(IndexGenerationLegacy, readErr, nil)\n\t\t\treturn raw, IndexGenerationLegacy, readErr\n\t\t}\n\t\tf, _ := desc.file(name)\n\t\tif IndexReadFault != nil {\n\t\t\tIndexReadFault(\"after-descriptor\")\n\t\t}\n\t\tdata, matched, readErr := readGenerationFile(s.fsys(), s.Root, desc.GenerationID, name, f.SHA256)\n\t\tagain, againRaw, _, againErr := readIndexDescriptor(s.fsys(), s.Root)\n\t\tif againErr != nil || again.GenerationID != desc.GenerationID || string(againRaw) != string(descRaw) {\n\t\t\tcontinue\n\t\t}\n\t\tif readErr != nil {\n\t\t\tif errors.Is(readErr, os.ErrNotExist) {\n\t\t\t\treturn nil, IndexGenerationUnavailable, fmt.Errorf(\"pose: %w: %s of generation %s is missing (%w)\", ErrIndexGenerationUnavailable, name, desc.GenerationID, readErr)\n\t\t\t}\n\t\t\treturn nil, IndexGenerationUnavailable, fmt.Errorf(\"pose: %w: %s: %v\", ErrIndexGenerationUnavailable, name, readErr)\n\t\t}\n\t\tif !matched {\n\t\t\treturn nil, IndexGenerationUnavailable, fmt.Errorf(\"pose: %w: %s does not match generation %s; run `pose index`\", ErrIndexGenerationUnavailable, name, desc.GenerationID)\n\t\t}\n\t\tcurrent := IndexGenerationView{Status: IndexGenerationCurrent, Descriptor: desc}\n\t\ts.governanceIndexConsumed(IndexGenerationCurrent, nil, &current)\n\t\treturn data, IndexGenerationCurrent, nil\n\t}\n\treturn nil, IndexGenerationUnavailable, fmt.Errorf(\"pose: %w: the generation descriptor kept changing while %s was read\", ErrIndexGenerationUnavailable, name)\n}\n\n// PublishIndexGeneration publishes the seven supplied outputs and input\n85:\tindexPin        *IndexGenerationView\n113:\tbaseStore        Store\n115:\tindexPins        map[string]*IndexGenerationView\n262:\trootID, rootPath := op.rootForPathLocked(path, project)\n297:\tslot := op.indexPins[rootID]\n300:\t\top.indexPins[rootID] = slot\n316:\tif pinned.indexPin != nil {\n317:\t\t*slot = *pinned.indexPin\n318:\t\tentry.indexPin = slot\n337:func (op *governanceReadViewOperation) rootForPathLocked(path, project string) (string, string) {\n702:\tproject, selectedRoot := op.rootForPathLocked(governanceAbsoluteRoot(root), \"\")\n710:\tresolver.Roots = op.rootsForProducer(resolver.Roots, files, producer)\n735:\t\tpin = s.indexPin\n828:func (s Store) beginGovernanceReadView(allowMissingPrimaryRevision ...bool) (Store, *governanceReadView) {\n911:\t\tprimary: primary, resolver: resolver, baseStore: base, mainProject: project,\n914:\t\tindexPins:                         map[string]*IndexGenerationView{}, indexInputChecks: map[string]*governanceReadViewIndexInputCheck{}, unknown: map[string]map[string]bool{},\n955:\t\top.indexPins[project] = primaryPin\n957:\top.roots = []*governanceReadViewRoot{{project: project, root: mainRoot, revision: \"\", indexGeneration: \"legacy\", indexPin: primaryPin, store: base, view: primary, producers: map[string]bool{\"projection\": true}}}\n1059:\t\tslot := op.indexPins[entry.project]\n1062:\t\t\top.indexPins[entry.project] = slot\n1065:\t\tentry.indexPin = slot\n2593:\ts.indexPin = nil\n2613:\t\t\tresolver.Roots = view.operation.rootsForProducer(resolver.Roots, s.FS, producer)\n2651:func (op *governanceReadViewOperation) rootsForProducer(roots *Roots, files Files, producer string) *Roots {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '828,965p' pose-mcp/internal/pose/governance_read_view.go; sed -n '2590,2705p' pose-mcp/internal/pose/governance_read_view.go; rg -n 'func .*boundTo|func .*GetCloseoutState|func .*IndexInputBinding' pose-mcp/internal/pose/{review_operation_view.go,closeout*.go,index_generation.go}; cat .pose/results/delivery-validation.json | head -55; sed -n '1,65p' .pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '828,965p' pose-mcp/internal/pose/governance_read_view.go; sed -n '2590,2705p' pose-mcp/internal/pose/governance_read_view.go; rg -n 'func .*boundTo|func .*GetCloseoutState|func .*IndexInputBinding' pose-mcp/internal/pose/{review_operation_view.go,closeout*.go,index_generation.go}; cat .pose/results/delivery-validation.json | head -55; sed -n '1,65p' .pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md\"","aggregated_output":"func (s Store) beginGovernanceReadView(allowMissingPrimaryRevision ...bool) (Store, *governanceReadView) {\n\tbase := s.withoutGovernanceReadView()\n\tresolver := ArtifactResolver{}\n\tproject := strings.TrimSpace(base.FederatedProjectID)\n\tconsumerHasResolver := base.FederatedResolver != nil\n\tconsumerHasRoots := consumerHasResolver && base.FederatedResolver.Roots != nil\n\tfromEnvironment := !consumerHasResolver\n\tvar resolverErr error\n\tprojectBindingAmbiguous := false\n\tprojectBindingOverflow := false\n\tif base.FederatedResolver != nil {\n\t\tresolver = *base.FederatedResolver\n\t\tif resolver.Roots == nil {\n\t\t\tresolverErr = errors.New(\"authorized project roots are unavailable\")\n\t\t} else if project == \"\" {\n\t\t\tvar found bool\n\t\t\tproject, found, projectBindingAmbiguous, projectBindingOverflow = uniqueProjectIDForRootIn(base.fsys(), resolver.Roots, base.Root, resolver.Authorize)\n\t\t\tif projectBindingAmbiguous {\n\t\t\t\tproject = \"\"\n\t\t\t\tresolverErr = errors.New(\"project root has multiple authorized project identities\")\n\t\t\t} else if projectBindingOverflow {\n\t\t\t\tproject = \"\"\n\t\t\t\tresolverErr = errors.New(\"authorized project root registry exceeds its bounded snapshot budget\")\n\t\t\t} else if !found {\n\t\t\t\tcandidate, identityErr := ResolveDefaultProjectIDIn(base.fsys(), base.Root)\n\t\t\t\tif identityErr != nil {\n\t\t\t\t\tproject = \"\"\n\t\t\t\t\tresolverErr = fmt.Errorf(\"primary project identity could not be resolved: %w\", identityErr)\n\t\t\t\t} else if ValidateSlug(candidate) != nil || resolver.Authorize != nil && !resolver.Authorize(candidate) {\n\t\t\t\t\tproject = \"\"\n\t\t\t\t\tresolverErr = errors.New(\"primary project identity is not authorized\")\n\t\t\t\t} else {\n\t\t\t\t\tselected, selectionErr := resolver.Roots.StoreFor(candidate)\n\t\t\t\t\tif selectionErr == nil && sameProjectRoot(base.fsys(), base.Root, selected.Root) {\n\t\t\t\t\t\tproject = candidate\n\t\t\t\t\t} else if isUnknownProjectSelection(selectionErr) && rootsHaveNoDefaultProjectID(resolver.Roots) {\n\t\t\t\t\t\timplicitDefault, defaultErr := resolver.Roots.StoreFor(\"\")\n\t\t\t\t\t\tif defaultErr == nil && sameProjectRoot(base.fsys(), base.Root, implicitDefault.Root) {\n\t\t\t\t\t\t\tproject = candidate\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\tproject = \"\"\n\t\t\t\t\t\t\tresolverErr = errors.New(\"primary root is not bound to its derived project identity\")\n\t\t\t\t\t\t}\n\t\t\t\t\t} else {\n\t\t\t\t\t\tproject = \"\"\n\t\t\t\t\t\tresolverErr = errors.New(\"primary root is not bound to its derived project identity\")\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t} else {\n\t\tresolver, project, resolverErr = EnvironmentArtifactResolverIn(base.fsys(), base.Root, \"\")\n\t}\n\tif project == \"\" && fromEnvironment && !projectBindingAmbiguous && !projectBindingOverflow {\n\t\tcandidate, identityErr := ResolveDefaultProjectIDIn(base.fsys(), base.Root)\n\t\tif identityErr == nil {\n\t\t\tproject = candidate\n\t\t} else if resolverErr == nil {\n\t\t\tresolverErr = identityErr\n\t\t}\n\t}\n\tif resolver.Roots == nil {\n\t\tresolver.Roots = NewRootsIn(base.fsys(), RootsConfig{DefaultRoot: base.Root, DefaultProjectID: project})\n\t}\n\tresolver.governanceDepthLimit = 8\n\tresolver.FS = base.fsys()\n\tbase.FederatedProjectID = project\n\tif consumerHasResolver {\n\t\tconsumerResolver := resolver\n\t\tif !consumerHasRoots {\n\t\t\t// An internal primary-root binding must not grant a caller a\n\t\t\t// federated root registry it did not supply.\n\t\t\tconsumerResolver.Roots = nil\n\t\t}\n\t\tbase.FederatedResolver = &consumerResolver\n\t} else {\n\t\t// The operation uses the environment resolver to bind its identity and\n\t\t// authorized root vector. Do not install that resolver on the consumer\n\t\t// Store: a plain local Store has not opted into federated semantics.\n\t\tbase.FederatedResolver = nil\n\t}\n\tprimary := newGovernanceReadView(base.Root, base.fsys())\n\top := &governanceReadViewOperation{\n\t\tprimary: primary, resolver: resolver, baseStore: base, mainProject: project,\n\t\tallowMissingPrimarySourceRevision: len(allowMissingPrimaryRevision) > 0 && allowMissingPrimaryRevision[0],\n\t\trebuildsIndex:                     len(allowMissingPrimaryRevision) > 0 && allowMissingPrimaryRevision[0],\n\t\tindexPins:                         map[string]*IndexGenerationView{}, indexInputChecks: map[string]*governanceReadViewIndexInputCheck{}, unknown: map[string]map[string]bool{},\n\t}\n\top.git = newGovernanceReadViewGitState(op)\n\tprimary.operation = op\n\tif resolverErr != nil {\n\t\tprimary.markUnknown(\"projection\", \"authorized roots could not be resolved: \"+resolverErr.Error())\n\t}\n\trootMap, rootConflicts, registryOverflow := authorizedRootRegistrySnapshot(resolver.Roots, base.Root, project, resolver.Authorize, op.reserveRecord)\n\top.initialRoots = rootMap\n\top.initialConflicts = rootConflicts\n\top.rootProjectByPath = governanceRootPathIndex(rootMap, project)\n\top.registryOverflow = registryOverflow\n\top.rootRegistryID = governanceRootRegistryDigest(rootMap, rootConflicts, registryOverflow)\n\tif project != \"\" && rootConflicts[project] {\n\t\tprimary.markUnknown(\"projection\", \"primary root conflicts with its authorized project identity\")\n\t}\n\tif registryOverflow {\n\t\tprimary.markUnknown(\"projection\", \"authorized root registry exceeded its bounded snapshot budget\")\n\t}\n\trootMapForAudit := func() (map[string]string, map[string]bool, bool) {\n\t\tcurrentResolver := resolver\n\t\tcurrentProject := project\n\t\tif fromEnvironment {\n\t\t\tvar err error\n\t\t\tcurrentResolver, currentProject, err = EnvironmentArtifactResolverIn(base.fsys(), base.Root, \"\")\n\t\t\tif err != nil {\n\t\t\t\treturn map[string]string{}, map[string]bool{}, true\n\t\t\t}\n\t\t\tcurrentResolver.governanceDepthLimit = 8\n\t\t}\n\t\treturn authorizedRootRegistrySnapshot(currentResolver.Roots, base.Root, currentProject, currentResolver.Authorize, nil)\n\t}\n\top.currentRoots = rootMapForAudit\n\tmainRoot, mainErr := filepath.Abs(base.Root)\n\tif mainErr == nil {\n\t\tmainRoot = filepath.Clean(mainRoot)\n\t} else {\n\t\tmainRoot = filepath.Clean(base.Root)\n\t}\n\tprimaryPin := &IndexGenerationView{}\n\tif project != \"\" {\n\t\top.indexPins[project] = primaryPin\n\t}\n\top.roots = []*governanceReadViewRoot{{project: project, root: mainRoot, revision: \"\", indexGeneration: \"legacy\", indexPin: primaryPin, store: base, view: primary, producers: map[string]bool{\"projection\": true}}}\n\tprimaryRevision, revisionErr := op.capture(mainRoot, \"projection\", \"rev-parse\", \"--verify\", \"HEAD\")\n\top.roots[0].revision = strings.TrimSpace(string(primaryRevision))\n\tif revisionErr != nil || op.roots[0].revision == \"\" {\n\t\tif op.allowMissingPrimarySourceRevision {\n\t\t\top.roots[0].revision = \"\"\n\t\t} else {\n\t\t\top.roots[0].revision = \"unknown\"\n\t\t\tprimary.markUnknown(\"projection\", \"source revision for the primary root is unavailable\")\n\ts.specs = nil\n\ts.reviewView = nil\n\ts.reviewReuse = nil\n\ts.indexPin = nil\n\treturn s\n}\n\nfunc unwrapGovernanceReadViewFiles(files Files) (Files, bool) {\n\tviewFiles, ok := FilesOrNative(files).(*governanceReadViewFiles)\n\tif !ok {\n\t\treturn files, false\n\t}\n\treturn viewFiles.view.base, true\n}\n\nfunc (s Store) withGovernanceReadView(view *governanceReadView, producer string) Store {\n\ts.FS = view.filesFor(producer)\n\ts.reviewView = nil\n\ts.reviewReuse = nil\n\tif s.FederatedResolver != nil {\n\t\tresolver := *s.FederatedResolver\n\t\tresolver.FS = s.FS\n\t\tif view.operation != nil {\n\t\t\tresolver.Roots = view.operation.rootsForProducer(resolver.Roots, s.FS, producer)\n\t\t} else {\n\t\t\tresolver.Roots = cloneRootsWithFiles(resolver.Roots, s.FS)\n\t\t}\n\t\tresolver.governanceDepthLimit = 8\n\t\tresolver.snapshots = nil\n\t\ts.FederatedResolver = &resolver\n\t}\n\treturn s\n}\n\nfunc cloneRootsWithFiles(roots *Roots, files Files) *Roots {\n\tif roots == nil {\n\t\treturn nil\n\t}\n\troots.mu.RLock()\n\tclone := &Roots{\n\t\tcfg:              roots.cfg,\n\t\tbyProject:        make(map[string]string, len(roots.byProject)),\n\t\tconflicts:        make(map[string]bool, len(roots.conflicts)),\n\t\tgovernanceStores: make(map[string]Store, len(roots.governanceStores)),\n\t\tlastScan:         roots.lastScan,\n\t\trescanWindow:     roots.rescanWindow,\n\t\tfs:               files,\n\t}\n\tfor project, root := range roots.byProject {\n\t\tclone.byProject[project] = root\n\t}\n\tfor project, conflict := range roots.conflicts {\n\t\tclone.conflicts[project] = conflict\n\t}\n\tfor project, store := range roots.governanceStores {\n\t\tclone.governanceStores[project] = store\n\t}\n\troots.mu.RUnlock()\n\treturn clone\n}\n\nfunc (op *governanceReadViewOperation) rootsForProducer(roots *Roots, files Files, producer string) *Roots {\n\tif roots == nil || op == nil {\n\t\treturn nil\n\t}\n\troots.mu.RLock()\n\tcfg := roots.cfg\n\troots.mu.RUnlock()\n\top.mu.Lock()\n\trootMap, conflicts := op.initialRoots, op.initialConflicts\n\top.mu.Unlock()\n\treturn &Roots{\n\t\tcfg: cfg, byProject: rootMap, conflicts: conflicts, governanceStores: map[string]Store{},\n\t\tlastScan: time.Now(), rescanWindow: time.Duration(1 << 62), fs: files,\n\t}\n}\n\ntype readViewFile struct {\n\treader  *bytes.Reader\n\tinfo    fs.FileInfo\n\treadErr error\n}\n\nfunc newGovernanceReadFile(data []byte, info fs.FileInfo, readErrors ...error) *readViewFile {\n\tvar readErr error\n\tif len(readErrors) > 0 {\n\t\treadErr = readErrors[0]\n\t}\n\treturn &readViewFile{reader: bytes.NewReader(data), info: frozenInfo(info), readErr: readErr}\n}\nfunc (f *readViewFile) Stat() (fs.FileInfo, error) {\n\tif f.info == nil {\n\t\treturn nil, fs.ErrInvalid\n\t}\n\treturn f.info, nil\n}\nfunc (f *readViewFile) Read(p []byte) (int, error) {\n\tif f.reader.Len() == 0 && f.readErr != nil {\n\t\treturn 0, f.readErr\n\t}\n\tn, err := f.reader.Read(p)\n\tif err == nil && n > 0 && f.readErr != nil {\n\t\treturn n, f.readErr\n\t}\n\treturn n, err\n}\nfunc (*readViewFile) Close() error { return nil }\n\ntype readViewDirectoryFile struct {\n\tname     string\n\tproducer string\n\tentries  []fs.DirEntry\n\tinfo     fs.FileInfo\n\tcursor   int\n}\n\npose-mcp/internal/pose/index_generation.go:919:func IndexInputBindingIn(files Files, root, name string) (string, bool) {\npose-mcp/internal/pose/index_generation.go:960:func IndexInputBindingForStoreIn(store Store, name string) (string, bool) {\npose-mcp/internal/pose/index_generation.go:974:func IndexInputBindingsForStoreIn(store Store) (map[string]string, []string, bool) {\npose-mcp/internal/pose/index_generation.go:990:func IndexInputBindingsForFederatedMaterialIn(files Files, root string, material IndexFederatedMaterialProjection) (map[string]string, []string) {\npose-mcp/internal/pose/index_generation.go:1014:func IndexInputBinding(root, name string) (string, bool) {\npose-mcp/internal/pose/index_generation.go:1019:func IndexInputBindingsIn(files Files, root string) map[string]string {\npose-mcp/internal/pose/index_generation.go:1053:func IndexInputBindings(root string) map[string]string {\npose-mcp/internal/pose/review_operation_view.go:463:func (v *reviewOperationView) boundTo(s Store) bool {\n{\n  \"schema_version\": 1,\n  \"generated_at\": \"2026-11-15T19:22:51Z\",\n  \"mode\": \"strict\",\n  \"git_head\": \"7a986207b09b573be7be088bec21c8ef16ceb138\"