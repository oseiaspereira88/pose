rict\"\n          ],\n          \"rationale\": \"run the registered deterministic checks for the affected module\",\n          \"evidence_classes\": [\n            \"build\",\n            \"e2e\",\n            \"integration\",\n            \"unit\"\n          ],\n          \"criteria\": [\n            \"backend-concurrency\",\n            \"backend-input-errors\",\n            \"backend-observability\",\n            \"correctness\",\n            \"requirements\"\n          ],\n          \"preconditions\": [\n            \"delivery-target-declared\"\n          ]\n        },\n        {\n          \"id\": \"validate\",\n          \"requiredness\": \"required\",\n          \"args\": [\n            \"pose\",\n            \"validate\",\n            \"--strict\",\n            \"--module\",\n            \"pose-mcp\"\n          ],\n          \"rationale\": \"run the registered deterministic checks for the affected module\",\n          \"evidence_classes\": [\n            \"build\",\n            \"e2e\",\n            \"integration\",\n            \"unit\"\n          ],\n          \"component\": \"pose-mcp\",\n          \"preconditions\": [\n            \"delivery-target-declared\"\n          ]\n        }\n      ],\n      \"selected_profiles\": [\n        {\n          \"ref\": \"spec-closeout@1\",\n          \"category\": \"base\",\n          \"order\": 0,\n          \"source\": \".pose/review-profiles/spec-closeout.json\",\n          \"rationale\": \"selected by terminal scope policy\"\n        },\n        {\n          \"ref\": \"backend-review@1\",\n19:| `declared-independent-prefix` | enforced | `agent:independent-*` under declared assurance reads as authenticated separation | pose-review-assurance-disclosure |\n38:| `unobserved-falsifier-reads-uncontradicted` | enforced | An unbound legacy index cannot prove that a falsifier check was never observed | pose-falsifier-reconsideration |\n48:| `removal-witness-outlives-its-history` | delegated | A stale index keeps counting a 