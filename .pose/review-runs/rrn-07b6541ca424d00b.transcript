/help_catalog.go\n@@ -383,6 +383,7 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"bundle\", \"pose review bundle <scope|xref> [--seal] [--explain] [--expect-context <digest>]\", \"Prepare or seal an immutable review subject bundle\", \"Prepara ou sela o bundle imutável de revisão\"},\n \t\t\t{\"brief\", \"pose review brief <bundle-id|scope> [--kind review|adjudication|smoke] [--note-file <path>] [--json]\", \"Render the request a delegated reviewer receives, from the sealed bundle and, from round 2, the previous round's open findings\", \"Gera o pedido que um revisor delegado recebe, a partir do bundle selado e, da rodada 2 em diante, dos findings abertos da rodada anterior\"},\n \t\t\t{\"run-sign\", \"pose review run-sign <run-id> --issuer <name> [--ttl <duration>] [--apply] [--json]\", \"Sign captured run provenance with a pinned native issuer\", \"Assina a proveniência capturada com issuer nativo fixado\"},\n+\t\t\t{\"draft-check\", \"pose review draft-check [<bundle-id|run-id>] --draft <file> [--json]\", \"Report every reason the conclusion step would refuse a review draft, without writing; inside a delegated review the bundle and round come from the run\", \"Relata todo motivo pelo qual a conclusão recusaria um rascunho de review, sem gravar; dentro de uma review delegada o bundle e a rodada vêm do run\"},\n \t\t\t{\"conclude\", \"pose review conclude <run> [--issuer <name>] [--apply] [--json]\", \"Record the typed conclusion of a completed delegated run: a review as its signed attestation, an adjudication on the spec, a smoke run as smoke evidence; or why it records none\", \"Registra a conclusão tipada de um run delegado concluído: uma review como atestação assinada, uma adjudicação na spec, um smoke como evidência smoke; ou por que não registra nenhuma\"},\n \t\t\t{\"request\", \"pose review request <scope|bundle-id> --kind delegated-review [--purpose review|adjudicate|smoke] [--agents <name,...>] [--note-file <path>] [--supersedes <act-id> [--authority <json>] [--role <role>] [--requested-at <time>]] [--apply] [--json]\", \"Open a delegated-review action request that a local run, a CI job or the Conductor fulfils\", \"Abre uma action request de review delegada que um run local, um job de CI ou o Conductor cumpre\"},\n \t\t\t{\"run-proof\", \"pose review run-proof <run-id> <proof-id> [--json]\", \"Verify current run proof and disclose executor assurance\", \"Verifica a prova atual e divulga assurance do executor\"},\ndiff --git a/pose-mcp/internal/cli/review_closeout.go b/pose-mcp/internal/cli/review_closeout.go\nindex 22bfa902..973059fc 100644\n--- a/pose-mcp/internal/cli/review_closeout.go\n+++ b/pose-mcp/internal/cli/review_closeout.go\n@@ -430,6 +430,8 @@ func cmdReview(root string, args []string, stdout, stderr io.Writer) int {\n \t\treturn cmdReviewRunProof(root, args[1:], stdout, stderr)\n \tcase \"conclude\":\n \t\treturn cmdReviewConclude(root, args[1:], stdout, stderr)\n+\tcase \"draft-check\":\n+\t\treturn cmdReviewDraftCheck(root, args[1:], stdout, stderr)\n \tcase \"request\":\n \t\treturn cmdReviewRequest(root, args[1:], stdout, stderr)\n \t// The aliases pose-delegation-surface deprecated are removed (spec\ndiff --git a/pose-mcp/internal/cli/review_conclude.go b/pose-mcp/internal/cli/review_conclude.go\nindex add10fc0..4fb97af5 100644\n--- a/pose-mcp/internal/cli/review_conclude.go\n+++ b/pose-mcp/internal/cli/review_conclude.go\n@@ -102,6 +102,11 @@ func delegateAutoConclude(store posemodel.Store, run posemodel.ReviewRun, err er\n \t\treturn\n \t}\n \tif conclusion == nil {\n+\t\t// R6 of spec pose-review-readiness-before-seal: a completed run that\n+\t\t// is not concluded automatically names the step that concludes it.\n+\t\tif next := delegateConcludeNextStep(store, run); next != \"\" {\n+\t\t\trender(stdout, stderr).Hint(next)\n+\t\t}\n \t\treturn\n \t}\n \tline := \"pose delegate: conclusion \" + conclusion.State\n@@ -113,3 +118,21 @@ func delegateAutoConclude(store posemodel.Store, run posemodel.ReviewRun, err er\n \t}\n \trender(stdout, stderr).Hint(line)\n }\n+\n+// delegateConcludeNextStep is the command that records the conclusion of a\n+// completed run nothing concluded, or \"\" when there is none to record.\n+func delegateConcludeNextStep(store posemodel.Store, run posemodel.ReviewRun) string {\n+\tif run.Status != posemodel.ReviewRunCompleted || run.RunID == \"\" {\n+\t\treturn \"\"\n+\t}\n+\tswitch run.Kind {\n+\tcase posemodel.ReviewBriefKindReview, posemodel.ReviewBriefKindAdjudication, posemodel.ReviewBriefKindSmoke:\n+\tdefault:\n+\t\treturn \"\"\n+\t}\n+\tcommand := \"pose review conclude \" + run.RunID\n+\tif policy, _, found, err := store.LoadDelegationPolicy(); err != nil || !found || policy.ConclusionsIssuer() == \"\" {\n+\t\tcommand += \" --issuer <name>\"\n+\t}\n+\treturn \"pose delegate: nothing concluded this run automatically; preview its conclusion with `\" + command + \"`, then record it with `\" + command + \" --apply`\"\n+}\n// Spec pose-review-readiness-before-seal R2: when the plan asks for\n// structural mappings, a decision basis that reaches no requirement is\n// refused at seal; the same scope without structural facts seals.\nfunc TestSealReadinessRefusesADecisionWithoutBasis(t *testing.T) {\n\tstore := causalityFixture(t)\n\tstructure, required := causalityInputs()\n\tvar bundle ReviewBundle\n\tbundle.Payload.Scope.Ref = \"spec:backend\"\n\tbundle.Payload.Plan.Structure = structure\n\t// Material facts with no criterion that asks for their mapping: nothing\n\t// is mapped, so nothing is refused (review round 1, N1).\n\tif blockers := store.sealReadinessBlockers(bundle); len(blockers) != 0 {\n\t\tt.Fatalf(\"a plan that asks for no mapping was refused: %v\", blockers)\n\t}\n\tbundle.Payload.Plan.Criteria = []ReviewPlanCriterion{required[\"design-causality\"], required[\"correctness\"]}\n\tblockers := store.sealReadinessBlockers(bundle)\n\tassertBlocker(t, blockers, \"decision basis D9 reaches no requirement or constraint\")\n\tassertBlocker(t, blockers, \"decision basis A9 reaches no requirement or constraint\")\n\tif strings.Contains(strings.Join(blockers, \"\\n\"), \"basis D1 \") || strings.Contains(strings.Join(blockers, \"\\n\"), \"basis A1 \") {\n\t\tt.Fatalf(\"a basis that reaches a requirement was refused: %v\", blockers)\n\t}\n\tbundle.Payload.Plan.Structure = nil\n\tif blockers := store.sealReadinessBlockers(bundle); len(blockers) != 0 {\n\t\tt.Fatalf(\"a plan without structural facts was refused: %v\", blockers)\n\t}\n}\n// Spec pose-review-readiness-before-seal R1: a spec scope whose change\n// touches a delivery root without a declaration is refused at seal, with the\n// rule `pose close` uses, instead of after an approved review.\nfunc TestSealRefusesAnUndeclaredDelivery(t *testing.T) {\n\t// The undeclared delivery, and the undeclared artifact of review round 1\n\t// (N3): both are refused by `pose close` and known before the review.\n\tfor _, finding := range []string{\"undeclared-delivery\", \"undeclared\"} {\n\t\troot := sealReadinessRoot(t, finding, \"error\")\n\t\tcode, out := runPose(t, root, \"review\", \"bundle\", \"spec:alpha\", \"--seal\")\n\t\tif code == 0 || !strings.Contains(out, finding+\" [pose-mcp/lib.go]\") || !strings.Contains(out, \"pose close refuses it\") {\n\t\t\tt.Fatalf(\"%s was sealed: %d %s\", finding, code, out)\n\t\t}\n\t}\n\t// A warning, as for a spec created before the delivery policy, seals;\n\t// so does an evidence finding, which stays at close.\n\troot := sealReadinessRoot(t, \"undeclared-delivery\", \"warning\")\n\tif code, out := runPose(t, root, \"review\", \"bundle\", \"spec:alpha\", \"--seal\"); code != 0 {\n\t\tt.Fatalf(\"a warning blocked the seal: %d %s\", code, out)\n\t}\n\troot = sealReadinessRoot(t, \"unconsumed-capability\", \"error\")\n\tif code, out := runPose(t, root, \"review\", \"bundle\", \"spec:alpha\", \"--seal\"); code != 0 {\n\t\tt.Fatalf(\"a warning blocked the seal: %d %s\", code, out)\n\t}\n}\n// conclusion step would refuse, before the run ends, and writes nothing.\nfunc TestReviewDraftCheckMatchesTheConclusionStep(t *testing.T) {\n\tcontextCopy := filepath.Join(t.TempDir(), \"context.json\")\n\troot, draftPath, bundleID := cliProvenanceInstance(t, func(root, draftPath string) {\n\t\treviewers := posemodel.ReviewersPolicy{SchemaVersion: 1, Provenance: &posemodel.ReviewRunProvenancePolicy{Trust: \"executor-attested\", Implementation: posemodel.ModelIdentity{Principal: \"agent:implementer\", Execution: \"implementation-fixture\", Vendor: \"openai\", Model: \"implementation-model\"}}, Adapters: map[string]posemodel.ReviewerAdapter{\"fake\": {Executor: \"agent:reviewer\", Command: []string{\"sh\", \"-c\", \"cat >/dev/null; cp \\\"$POSE_REVIEW_DRAFT_CONTEXT\\\" '\" + contextCopy + \"'; printf %s \\\"$POSE_REVIEW_CLI\\\" > '\" + contextCopy + \".cli'; cat '\" + draftPath + \"'\"}, Vendor: \"openai\", Model: \"review-model\"}}}\n\t\traw, _ := json.Marshal(reviewers)\n\t\twriteCloseoutCLIFile(t, root, \".pose/policy/reviewers.json\", string(raw))\n\t})\n\ts := posemodel.Store{Root: root}\n\twriteRunConclusion(t, s, bundleID, draftPath)\n\tif code, out := runPose(t, root, \"review\", \"draft-check\", bundleID, \"--draft\", draftPath); code != 0 || !strings.Contains(out, \"would accept\") {\n\t\tt.Fatalf(\"a draft the conclusion accepts was refused: %d %s\", code, out)\n\t}\n\n\t// A criterion citing evidence the bundle did not seal, and a new finding\n\t// carrying a round prefix: both refused, by the same words conclude uses.\n\tgood, _ := os.ReadFile(draftPath)\n\tbad := strings.Replace(string(good), \"integration:val-alpha\", \"integration:val-missing\", 1)\n\tbadPath := filepath.Join(t.TempDir(), \"bad.txt\")\n\tif err := os.WriteFile(badPath, []byte(bad), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcode, out := runPose(t, root, \"review\", \"draft-check\", bundleID, \"--draft\", badPath, \"--json\")\n\tvar report struct {\n\t\tOK      bool     `json:\"ok\"`\n\t\tReasons []string `json:\"reasons\"`\n\t}\n\tif code == 0 || json.Unmarshal([]byte(out), &report) != nil || report.OK || len(report.Reasons) == 0 || !strings.Contains(strings.Join(report.Reasons, \" \"), \"the attestation preflight refuses it\") {\n\t\tt.Fatalf(\"a draft the preflight refuses passed the draft check: %d %s\", code, out)\n\t}\n\n\t// Inside a delegated review, the run provides the bundle and the round.\n\tif code, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\"); code != 0 {\n\t\tt.Fatal(code, out)\n\t}\n\tif _, err := os.Stat(contextCopy); err != nil {\n\t\tt.Fatalf(\"the dispatch named no draft context: %v\", err)\n\t}\n\tif cli, _ := os.ReadFile(contextCopy + \".cli\"); len(cli) == 0 {\n\t\tt.Fatal(\"the dispatch named no review CLI\")\n\t}\n\t// A run id selects its bundle (review round 1, N2).\n\truns, _, _ := s.ReadReviewRuns(\"\")\n\tif code, out := runPose(t, root, \"review\", \"draft-check\", runs[0].RunID, \"--draft\", badPath); code == 0 || !strings.Contains(out, \"would refuse\") {\n\t\tt.Fatalf(\"a run id did not select its bundle: %d %s\", code, out)\n\t}\n\tt.Setenv(posemodel.ReviewDraftContextEnv, contextCopy)\n\tif code, out := runPose(t, root, \"review\", \"draft-check\", \"--draft\", badPath); code == 0 || !strings.Contains(out, \"would refuse\") {\n\t\tt.Fatalf(\"the run's context did not judge the draft: %d %s\", code, out)\n\t}\n\tif code, out := runPose(t, root, \"review\", \"draft-check\", \"--draft\", draftPath); code != 0 {\n\t\tt.Fatalf(\"the run's context refused a good draft: %d %s\", code, out)\n\t}\n\t// Naming the run's own bundle uses the context too, where the sealed\n\t// checkout holds no bundle file (review round 2, N5).\n\tempty := t.TempDir()\n\tif code, out := runPose(t, empty, \"review\", \"draft-check\", bundleID, \"--draft\", draftPath); code != 0 {\n\t\tt.Fatalf(\"naming the run's bundle ignored the context: %d %s\", code, out)\n\t}\n\tif code, out := runPose(t, empty, \"review\", \"draft-check\", \"rvb-ffffffffffffffff\", \"--draft\", draftPath); code == 0 || !strings.Contains(out, \"this run's draft context holds bundle \"+bundleID) {\n\t\tt.Fatalf(\"another bundle was not refused with the context named: %d %s\", code, out)\n\t}\n\t// A draft past the limit is refused, never judged by its prefix (N4).\n\thuge := filepath.Join(t.TempDir(), \"huge.txt\")\n\tif err := os.WriteFile(huge, append(good, make([]byte, 4<<20)...), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif code, out := runPose(t, root, \"review\", \"draft-check\", \"--draft\", huge); code == 0 || !strings.Contains(out, \"larger than\") {\n\t\tt.Fatalf(\"an oversized draft was judged: %d %s\", code, out)\n\t}\n\t// From standard input, as a read-only sandbox can only offer it.\n\tt.Setenv(posemodel.ReviewDraftContextEnv, \"\")\n\tstdin, _ := os.Open(badPath)\n\tdefer stdin.Close()\n\tsaved := os.Stdin\n\tos.Stdin = stdin\n\tcode, out = runPose(t, root, \"review\", \"draft-check\", bundleID, \"--draft\", \"-\")\n\tos.Stdin = saved\n\tif code == 0 || !strings.Contains(out, \"would refuse\") {\n\t\tt.Fatalf(\"a draft on standard input was not judged: %d %s\", code, out)\n\t}\n\t_ = time.Now\n}\n\n// The same refusal at the conclusion step, so the check cannot drift from it.\nfunc TestReviewDraftCheckRefusalIsTheConclusionRefusal(t *testing.T) {\n\troot, draftPath, bundleID := cliProvenanceInstance(t)\n\ts := posemodel.Store{Root: root}\n\twriteRunConclusion(t, s, bundleID, draftPath)\n\tgood, _ := os.ReadFile(draftPath)\n\tif err := os.WriteFile(draftPath, []byte(strings.Replace(string(good), \"integration:val-alpha\", \"integration:val-missing\", 1)), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, checked := runPose(t, root, \"review\", \"draft-check\", bundleID, \"--draft\", draftPath, \"--json\")\n.pose/knowledge/archive/2026-07-19-handoff-contract-baseline-handoff.md:66:byte-a-byte, avisos, readiness, rollback via git puro). `examples/`\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:3:slug: agency-readiness-outcome-review\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:10:  spec: \"spec:pose-agency-readiness-pilot\"\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:12:  commands: [\"pose review verify roadmap:agency-readiness\", \"pose knowledge-check --strict\"]\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:16:# Handoff: agency-readiness outcome review\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:20:Independent outcome review of roadmap:agency-readiness at d72b6abb, bundle\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:29:go vet passes. Registered phase-readiness, source-coverage, effective-governance,\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:49:- Verify roadmap:agency-readiness after recording the explicit attestation.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:68:- Roadmap: `.pose/roadmaps/agency-readiness.md`.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:69:- Pilot: `.pose/specs/2026-10-04-pose-agency-readiness-pilot.md`.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:71:- Full report: `/tmp/pose-roadmaps-evidence/reached/rm-agency-readiness/attest-report.md`.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:72:- Fresh argv/results: `/var/tmp/pose-work-go/review-reached/rm-agency-readiness/attest/round3/`.\n.pose/knowledge/2026-10-18-handoff-pose-b06-source-coverage-closeout.md:33:Aguardar merge do PR #194 pelo maintainer e reavaliar DAG/readiness. Nenhuma\n.pose/knowledge/2026-10-18-handoff-pose-b06-source-coverage-closeout.md:47:@pose-maintainers coordena merge e readiness; @core responde pelos dois follow-ups.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc \"printf '%s' 'decision: approved\n\nNo defects found in the resealed subject. Focused tests, vet and live input/context probes passed. Full validation conclusions rely on sealed canonical strict evidence under the sandbox fallback.\n\nApplied the review workflow and security, backend-go and documentation-style rules. No repository changes or attestation were made.\n\nBundle: rvb-d89a1063ed5e1278. Plan: sha256:94c5e8ed0db62ef3b181346f2d2219dc8a2adde13bf37aaf466973e6266f49c0.\n\n\"'```pose-draft\n{\n  \"schema\": \"pose.review.draft/v1\",\n  \"decision\": \"approved\",\n  \"findings\": [],\n  \"prior_findings\": [],\n  \"sweep\": \"Reviewed the complete base-to-head subject against R1-R6 and D1-D2: declaration and decision-basis seal gates, existing-seal reuse, shared attestation-content extraction, draft parsing and round accounting, bounded file/stdin reads, bundle/run/context selection, dispatch lifecycle/environment, note limits, conclude guidance, manuals/scaffolds and regressions. Rechecked earlier fixes with focused tests and live boundary/context probes. Inspected this resealed bundle'\"'\\\\''s declared implementation binding. No prior findings are listed for this round; no additional defects established.\\\",\n  \\\"criteria\\\": [\n    {\n      \\\"id\\\": \\\"assumption-integrity\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"structure:design-36ac800e7cdd7060\\\",\n      \\\"rationale\\\": \\\"Examined D1/D2 and ADR L1/L2. The context is advisory; final conclusion checks authority and identity. The committed index can miss newly discovered findings, with close remaining the final gate. The resealed bundle records a declared implementation execution digest; this review does not claim to authenticate it independently. Full validation uses sealed canonical evidence; focused tests/vet and sandbox probes were rerun.\\\"\n    },\n    {\n      \\\"id\\\": \\\"backend-concurrency\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/writer-coordination-and-atomic-publication-integration\\\",\n      \\\"rationale\\\": \\\"Inspected private context publication before child start and existing dispatch cancellation/cleanup. No new goroutines or shared mutable execution state were introduced.\\\"\n    },\n    {\n      \\\"id\\\": \\\"backend-contracts\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/review-brief-conclusion-rules-integration\\\",\n      \\\"rationale\\\": \\\"Inspected CLI routing/help, bundle/run resolution and dispatch-context contracts. Focused contract regressions passed; implicit and explicitly named own-bundle sandbox checks agree.\\\"\n    },\n    {\n      \\\"id\\\": \\\"backend-input-errors\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\",\n      \\\"rationale\\\": \\\"Focused regressions passed. Live checks accepted exactly 4194304 bytes, refused oversized stdin/file-reader input and returned actionable mismatched-bundle diagnostics.\\\"\n    },\n    {\n      \\\"id\\\": \\\"backend-integration-impact\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/delegated-review-capability-integration\\\",\n      \\\"rationale\\\": \\\"Reviewed CLI-to-Store routing, dispatch context/CLI environment and conclusion integration; focused dispatch and conclusion-comparison tests and live sandbox probes passed.\\\"\n    },\n    {\n      \\\"id\\\": \\\"backend-observability\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/delegated-output-redaction-diagnostics-integration\\\",\n      \\\"rationale\\\": \\\"Reviewed seal rule/path/remediation messages, overflow errors, bundle-context guidance, named note limits and conclude hints. Existing redaction remains unchanged.\\\"\n    },\n    {\n      \\\"id\\\": \\\"compatibility\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/review-brief-templates-are-immutable-integration\\\",\n      \\\"rationale\\\": \\\"Verified all preexisting template digests are retained and the extracted content-validation body is unchanged from the base. Existing sealed bundles return before new readiness checks. Added CLI/environment contracts and new-seal refusals are explicitly documented.\\\"\n    },\n    {\n      \\\"id\\\": \\\"correctness\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\",\n      \\\"rationale\\\": \\\"Focused readiness, draft-check, brief, sealed-gate and delegate regressions passed. Independently checked input boundaries, explicit/implicit bundle context, mismatch failures and unchanged validator extraction.\\\"\n    },\n    {\n      \\\"id\\\": \\\"design-causality\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"structure:design-36ac800e7cdd7060\\\",\n      \\\"rationale\\\": \\\"D1 addresses validation drift through shared parsing, round accounting and content checks. D2 moves only declaration/basis checks to new seals, requires mapping owners and preserves final evidence/authority gates.\\\",\n      \\\"mappings\\\": [\n        {\n          \\\"delta\\\": \\\"SD-e71849b4\\\",\n          \\\"basis\\\": \\\"D1\\\",\n          \\\"disposition\\\": \\\"mapped\\\",\n          \\\"rationale\\\": \\\"The ADR records the R3/R4 shared-validation/private-context design and D2'\\\\''s R1/R2 seal timing, alternatives and L1/L2 limits.\\\"\n        }\n      ]\n    },\n    {\n      \\\"id\\\": \\\"documentation\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/review-brief-conclusion-rules-integration\\\",\n      \\\"rationale\\\": \\\"Reviewed help, both manuals, /8 instructions and prior-findings guidance. Added manual text matches both scaffold copies exactly; existing template digests are retained. The dispatching CLI works in the sealed sandbox.\\\"\n    },\n    {\n      \\\"id\\\": \\\"operability\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/typed-diagnostics-integration\\\",\n      \\\"rationale\\\": \\\"Live probes verified actionable overflow and bundle-context diagnostics. Inspected seal remediation, note-size/limit messages and precise conclude commands; no new operational defect found.\\\"\n    },\n    {\n      \\\"id\\\": \\\"requirements\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\",\n      \\\"rationale\\\": \\\"Focused regressions cover R1 declarations, R2 mapping applicability, R3 shared checking/context/bounds, R4 brief instructions/prior findings and R5/R6 note/conclusion guidance. Live probes corroborate R3; sealed strict validation supplies module-wide evidence.\\\"\n    },\n    {\n      \\\"id\\\": \\\"scope\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"structure:design-36ac800e7cdd7060\\\",\n      \\\"rationale\\\": \\\"Reviewed the amended spec, artifact declarations and capability target. Changes remain within readiness, advisory draft checking and associated dispatch guidance/docs/tests. The checkout head matches the requested range; the new bundle changes implementation identity binding.\\\"\n    },\n    {\n      \\\"id\\\": \\\"security\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/delegated-adapter-containment-integration\\\",\n      \\\"rationale\\\": \\\"Inspected private 0600 context creation, bounded draft input, existing adapter confinement and final signature/identity enforcement. Advisory context cannot authorize an attestation. No new credential exposure or authority bypass established.\\\"\n    },\n    {\n      \\\"id\\\": \\\"solution-proportionality\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"structure:design-36ac800e7cdd7060\\\",\n      \\\"rationale\\\": \\\"Shared validation plus a private snapshot is smaller than a duplicate validator or premature full closeout. One bounded reader and a context-selection condition address the prior transport defects. Making the snapshot authoritative would invalidate this choice. Nominal Basis labels or edited advisory context can satisfy form; meaningful causality remains reviewer judgment and final revalidation protects authority. The adversarial corpus'\\\\''s canned-executor case documents cognition limits; dedicated readiness corpus coverage is absent, while focused negative tests and live input/context probes cover mechanical boundaries.\\\"\n    }\n  ],\n  \\\"tools\\\": [\n    {\n      \\\"id\\\": \\\"artifact-check\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"command:pose artifact-check --spec pose-review-readiness-before-seal --strict --json\\\",\n      \\\"rationale\\\": \\\"Independent read-only execution through POSE_REVIEW_CLI; final result reported after completion.\\\"\n    },\n    {\n      \\\"id\\\": \\\"assess-design\\\",\n      \\\"disposition\\\": \\\"not-used\\\",\n      \\\"rationale\\\": \\\"Assessment writers were excluded from the sealed checkout. Inspected sealed structure:design-36ac800e7cdd7060 and mapped its governance delta.\\\"\n    },\n    {\n      \\\"id\\\": \\\"assess-discover\\\",\n      \\\"component\\\": \\\"pose-mcp\\\",\n      \\\"disposition\\\": \\\"not-used\\\",\n      \\\"rationale\\\": \\\"Assessment publication was excluded; inspected component source and focused regressions directly.\\\"\n    },\n    {\n      \\\"id\\\": \\\"assess-integrate\\\",\n      \\\"disposition\\\": \\\"not-used\\\",\n      \\\"rationale\\\": \\\"Assessment writers were excluded. Inspected CLI/dispatch/conclusion boundaries and sealed integration evidence; ran live sandbox probes.\\\"\n    },\n    {\n      \\\"id\\\": \\\"assess-tech-debt\\\",\n      \\\"disposition\\\": \\\"not-used\\\",\n      \\\"rationale\\\": \\\"Assessment writers were excluded. Direct searches found no TODO, FIXME, stub or panic markers in the new readiness/draft-check files.\\\"\n    },\n    {\n      \\\"id\\\": \\\"closeout-check\\\",\n      \\\"disposition\\\": \\\"deferred\\\",\n      \\\"rationale\\\": \\\"Requires this review'\\\\''s recorded conclusion; the reviewer must not record an attestation.\\\"\n    },\n    {\n      \\\"id\\\": \\\"review-check\\\",\n      \\\"disposition\\\": \\\"deferred\\\",\n      \\\"rationale\\\": \\\"Requires this review'\\\\''s recorded conclusion; the reviewer must not record an attestation.\\\"\n    },\n    {\n      \\\"id\\\": \\\"suggest-review\\\",\n      \\\"component\\\": \\\"pose-mcp\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"command:pose suggest review --path pose-mcp\\\",\n      \\\"rationale\\\": \\\"Independently executed through POSE_REVIEW_CLI; applied security, backend-go and documentation-style rules and the review workflow.\\\"\n    },\n    {\n      \\\"id\\\": \\\"surface-check\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"integration:pose-mcp/go/spec-surface-integration\\\",\n      \\\"rationale\\\": \\\"Independent strict read-only execution through POSE_REVIEW_CLI; sealed component integration evidence inspected.\\\"\n    },\n    {\n      \\\"id\\\": \\\"validate\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\",\n      \\\"rationale\\\": \\\"Pass cites sealed canonical execution, not a fresh full rerun: delivery-validation.json records strict mode, 236 checks and no nonpassing required check. Independently reran focused regressions/vet under the brief'\\\\''s sandbox fallback.\\\"\n    },\n    {\n      \\\"id\\\": \\\"validate\\\",\n      \\\"component\\\": \\\"pose-mcp\\\",\n      \\\"disposition\\\": \\\"passed\\\",\n      \\\"evidence\\\": \\\"unit:pose-mcp/go/test\\\",\n      \\\"rationale\\\": \\\"Pass cites sealed pose-mcp canonical validation; full module validation was not rerun here. Independently passed go -C pose-mcp test ./internal/pose ./internal/cli -run '\\\\''DraftCheck|SealReadiness|SealRefuses|DelegateNamesTheNoteLimit|Brief|SealedGate|OnlyTheSigning'\\\\'' and go -C pose-mcp vet ./internal/pose ./internal/cli.\\\"\n    }\n  ]\n}\n\"'```'\"' | \\\"\"'$POSE_REVIEW_CLI\" review draft-check --draft -'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
