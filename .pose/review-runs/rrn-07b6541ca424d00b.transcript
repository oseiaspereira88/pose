{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\nimport os,json,subprocess\nc=json.load(open(os.environ['POSE_REVIEW_DRAFT_CONTEXT']))\np={'schema':'pose.review.draft/v1','decision':'changes-requested','findings':[],'prior_findings':[],'sweep':'synthetic read-only boundary/context probe'}\na='decision: changes-requested\\\\n\"'```pose-draft'\"\\\\n'+json.dumps(p)+'\\\\n\"'```'\"\\\\n'\nfor label,args,body,path in [('implicit',[],a,'-'),('explicit bundle',[c['bundle']['bundle_id']],a,'-'),('mismatch',['rvb-ffffffffffffffff'],a,'-'),('exact limit',[],a+' '*((4<<20)-len(a)),'-'),('oversized stdin',[],a+' '*(4<<20),' -'.strip()),('oversized file reader',[],a+' '*(4<<20),'/dev/stdin')]:\n r=subprocess.run([os.environ['POSE_REVIEW_CLI'],'review','draft-check']+args+['--draft',path],input=body,text=True,capture_output=True)\n print(label,'exit',r.returncode,(r.stdout+r.stderr).strip()[:450])\np='pose-mcp/internal/pose/review_bundle.go'; base=subprocess.check_output(['git','show','3f63a1bb:'+p],text=True); cur=open(p).read()\nx=base[base.index('\\\\trequired := map[string]ReviewPlanCriterion{}',base.index('func (s Store) validateBundleAttestationWith')):]\ny=cur[cur.index('\\\\trequired := map[string]ReviewPlanCriterion{}',cur.index('func (s Store) attestationContentBlockers')):]\nprint('Extracted content body unchanged:',x[:x.index('\\\\n// The same finding and decision gate')]==y[:y.index('\\\\n// The same finding and decision gate')])\np='pose-mcp/internal/pose/testdata/review_brief_template_digests.json'; x=json.loads(subprocess.check_output(['git','show','3f63a1bb:'+p],text=True)); y=json.load(open(p))\nprint('Preexisting template digests retained:',all(y.get(k)==v for k,v in x.items()))\nfor x,y in [('POSE.md','pose-mcp/internal/scaffold/dist/POSE.md'),('locales/pt-BR/POSE.md','pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md')]:\n def added(p): return [l for l in subprocess.check_output(['git','diff','3f63a1bb..2bd80b69','--',p],text=True).splitlines() if l.startswith('+') and not l.startswith('+++')]\n print(x,'additions match scaffold:',added(x)==added(y))\nr=json.load(open('.pose/results/delivery-validation.json'))\nprint('canonical strict validation:',r.get('mode'),'checks',len(r.get('checks',[])),'nonpassing required',len([x for x in r.get('checks',[]) if x.get('severity')=='required' and x.get('outcome',x.get('status')) not in ('pass','passed')]))\nPY\n\\\"\"'$POSE_REVIEW_CLI\" recurrence-check --tolerant --window-days 14 --json'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
