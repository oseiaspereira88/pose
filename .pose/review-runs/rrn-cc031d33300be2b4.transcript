{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MJrc3XxLq15sJk4MrDgiVP","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"reflect\"\n9\t\t\"strings\"\n10\t\t\"testing\"\n11\t\n12\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n13\t)\n14\t\n15\t// The same operation through the process and through the domain wrapper returns the\n16\t// same result (spec pose-common-domain-and-cli-mcp-handoff R1, R9): the wrapper no\n17\t// longer starts the binary for it, and nothing about the answer changes.\n18\tfunc TestAnInProcessWrapperReturnsWhatTheSpawnedCommandReturns(t *testing.T) {\n19\t\trepo, err := filepath.Abs(filepath.Join(\"..\", \"..\", \"..\"))\n20\t\tif err != nil {\n21\t\t\tt.Fatal(err)\n22\t\t}\n23\t\tfixture := followupFixture(t)\n24\t\tsuggestStore, followStore := posemodel.Store{Root: repo}, posemodel.Store{Root: fixture}\n25\t\tcases := []struct {\n26\t\t\troot string\n27\t\t\tname string\n28\t\t\tcli  []string\n29\t\t\trun  func() (any, error)\n30\t\t}{\n31\t\t\t{repo, \"suggest\", []string{\"suggest\", \"feature\", \"--json\"}, func() (any, error) { return suggestStore.Suggest(context.Background(), \"feature\", \"\", \"\") }},\n32\t\t\t{fixture, \"followups\", []string{\"followups\", \"--open\", \"--json\"}, func() (any, error) { return followStore.Followups(context.Background(), false) }},\n33\t\t}\n34\t\tfor _, tc := range cases {\n35\t\t\tt.Run(tc.name, func(t *testing.T) {\n36\t\t\t\tcode, spawned := runBuilt(t, tc.root, tc.cli...)\n37\t\t\t\tif code != 0 {\n38\t\t\t\t\tt.Fatalf(\"the spawned command exited %d: %s\", code, spawned)\n39\t\t\t\t}\n40\t\t\t\tvar want any\n41\t\t\t\tif err := json.Unmarshal([]byte(spawned), &want); err != nil {\n42\t\t\t\t\tt.Fatalf(\"the spawned command's output is not JSON: %v\", err)\n43\t\t\t\t}\n44\t\t\t\tbefore, runs := posemodel.CLISpawnAttempts(), posemodel.CLIInProcessRuns()\n45\t\t\t\tgot, err := tc.run()\n46\t\t\t\tif err != nil {\n47\t\t\t\t\tt.Fatal(err)\n48\t\t\t\t}\n49\t\t\t\tif posemodel.CLISpawnAttempts() != before || posemodel.CLIInProcessRuns()-runs != 1 {\n50\t\t\t\t\tt.Fatalf(\"the wrapper did not run in process (spawn attempts %d->%d, in-process runs +%d)\", before, posemodel.CLISpawnAttempts(), posemodel.CLIInProcessRuns()-runs)\n51\t\t\t\t}\n52\t\t\t\t// followups carries a generation time; compare the structure without it.\n53\t\t\t\tif m, ok := want.(map[string]any); ok {\n54\t\t\t\t\tdelete(m, \"generated_at\")\n55\t\t\t\t}\n56\t\t\t\tif m, ok := got.(map[string]any); ok {\n57\t\t\t\t\tdelete(m, \"generated_at\")\n58\t\t\t\t}\n59\t\t\t\tif !reflect.DeepEqual(got, want) {\n60\t\t\t\t\tg, _ := json.Marshal(got)\n61\t\t\t\t\tw, _ := json.Marshal(want)\n62\t\t\t\t\tt.Fatalf(\"the in-process result differs from the spawned one:\\n got  %.400s\\n want %.400s\", g, w)\n63\t\t\t\t}\n64\t\t\t})\n65\t\t}\n66\t}\n67\t\n68\t// followupFixture is a small project with one open follow-up, so the parity of the\n69\t// followups wrapper is measured on content instead of on this repository's size.\n70\tfunc followupFixture(t *testing.T) string {\n71\t\tt.Helper()\n72\t\troot := t.TempDir()\n73\t\tpath := filepath.Join(root, \".pose\", \"specs\", \"2026-06-01-alpha.md\")\n74\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n75\t\t\tt.Fatal(err)\n76\t\t}\n77\t\tbody := \"---\\nslug: alpha\\nstatus: done\\ncreated_at: 2026-06-01\\ncompleted_at: 2026-06-02\\n---\\n\\n# Spec: alpha\\n\\n## 7. Final Report\\n\\n### Follow-ups\\n\\n- [open] Look at the thing again. (owner:@team crit:low review:2099-01-01)\\n\"\n78\t\tif err := os.WriteFile(path, []byte(body), 0o644); err != nil {\n79\t\t\tt.Fatal(err)\n80\t\t}\n81\t\treturn root\n82\t}\n83\t\n84\t// Concurrent wrapper calls over the same root are independent: the in-process\n85\t// commands share no state the way two processes share none.\n86\tfunc TestInProcessWrappersAreSafeUnderConcurrency(t *testing.T) {\n87\t\troot := followupFixture(t)\n88\t\tstore := posemodel.Store{Root: root}\n89\t\terrs := make(chan error, 16)\n90\t\tfor i := 0; i < 8; i++ {\n91\t\t\tgo func() {\n92\t\t\t\t_, err := store.Suggest(context.Background(), \"feature\", \"\", \"\")\n93\t\t\t\terrs <- err\n94\t\t\t}()\n95\t\t\tgo func() {\n96\t\t\t\t_, err := store.Followups(context.Background(), false)\n97\t\t\t\terrs <- err\n98\t\t\t}()\n99\t\t}\n100\t\tfor i := 0; i < 16; i++ {\n101\t\t\t// A fixture without a task map answers suggest with the command's own error;\n102\t\t\t// what matters here is that no call deadlocks or races.\n103\t\t\tif err := <-errs; err != nil && !errAllowed(err) {\n104\t\t\t\tt.Fatal(err)\n105\t\t\t}\n106\t\t}\n107\t}\n108\t\n109\tfunc errAllowed(err error) bool {\n110\t\treturn err != nil && strings.Contains(err.Error(), \"task-map missing\")\n111\t}\n112\t\n113\t// The handoff's argv is consumed by the CLI that produced the plan: an unchanged\n114\t// repository must accept the digest it names (spec pose-common-domain-and-cli-mcp-handoff\n115\t// R4/R5), and a handoff is not offered for a plan the apply would refuse.\n116\tfunc TestTheDigestOfAHandoffIsTheDigestTheApplyChecks(t *testing.T) {\n117\t\troot := reviewBundleCLIFixture(t)\n118\t\t_, raw := runPose(t, root, \"close\", \"spec:bundle\", \"--plan\", \"--json\")\n119\t\tvar plan posemodel.CloseoutPlan\n120\t\tif err := json.Unmarshal([]byte(raw), &plan); err != nil {\n121\t\t\tt.Fatalf(\"plan: %v\\n%s\", err, raw)\n122\t\t}\n123\t\t// The consumer check is about the digest, so the plan is cleared of what would only\n124\t\t// withhold the handoff; the real plan of this fixture is covered by the blocked case below.\n125\t\tprobe := plan\n126\t\tprobe.Terminal, probe.Blockers = false, nil\n127\t\tprobe.Steps = []posemodel.CloseoutPlanStep{{ID: posemodel.CloseoutStepEvidence, State: posemodel.CloseoutStatePending}}\n128\t\th := posemodel.CloseoutHandoff(probe, posemodel.HandoffTarget{})\n129\t\tif h == nil {\n130\t\t\tt.Fatal(\"no handoff for a plan with a pending step\")\n131\t\t}\n132\t\tcode, out := runPose(t, root, h.Argv[1:]...)\n133\t\tif strings.Contains(out, \"plan-digest-mismatch\") || strings.Contains(out, \"the repository changed since the plan was computed\") {\n134\t\t\tt.Fatalf(\"the digest of a handoff for an unchanged repository was refused (%d): %s\", code, out)\n135\t\t}\n136\t}\n137\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"88952074-82bf-4736-ad7f-40cc2e0fcb4e","timestamp":"2026-11-09T06:51:45.839Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3984980499/worktree/pose-mcp/internal/cli/common_domain_handoff_test.go","content":"package cli\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"strings\"\n\t\"testing\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\n// The same operation through the process and through the domain wrapper returns the\n// same result (spec pose-common-domain-and-cli-mcp-handoff R1, R9): the wrapper no\n// longer starts the binary for it, and nothing about the answer changes.\nfunc TestAnInProcessWrapperReturnsWhatTheSpawnedCommandReturns(t *testing.T) {\n\trepo, err := filepath.Abs(filepath.Join(\"..\", \"..\", \"..\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfixture := followupFixture(t)\n\tsuggestStore, followStore := posemodel.Store{Root: repo}, posemodel.Store{Root: fixture}\n\tcases := []struct {\n\t\troot string\n\t\tname string\n\t\tcli  []string\n\t\trun  func() (any, error)\n\t}{\n\t\t{repo, \"suggest\", []string{\"suggest\", \"feature\", \"--json\"}, func() (any, error) { return suggestStore.Suggest(context.Background(), \"feature\", \"\", \"\") }},\n\t\t{fixture, \"followups\", []string{\"followups\", \"--open\", \"--json\"}, func() (any, error) { return followStore.Followups(context.Background(), false) }},\n\t}\n\tfor _, tc := range cases {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tcode, spawned := runBuilt(t, tc.root, tc.cli...)\n\t\t\tif code != 0 {\n\t\t\t\tt.Fatalf(\"the spawned command exited %d: %s\", code, spawned)\n\t\t\t}\n\t\t\tvar want any\n\t\t\tif err := json.Unmarshal([]byte(spawned), &want); err != nil {\n\t\t\t\tt.Fatalf(\"the spawned command's output is not JSON: %v\", err)\n\t\t\t}\n\t\t\tbefore, runs := posemodel.CLISpawnAttempts(), posemodel.CLIInProcessRuns()\n\t\t\tgot, err := tc.run()\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif posemodel.CLISpawnAttempts() != before || posemodel.CLIInProcessRuns()-runs != 1 {\n\t\t\t\tt.Fatalf(\"the wrapper did not run in process (spawn attempts %d->%d, in-process runs +%d)\", before, posemodel.CLISpawnAttempts(), posemodel.CLIInProcessRuns()-runs)\n\t\t\t}\n\t\t\t// followups carries a generation time; compare the structure without it.\n\t\t\tif m, ok := want.(map[string]any); ok {\n\t\t\t\tdelete(m, \"generated_at\")\n\t\t\t}\n\t\t\tif m, ok := got.(map[string]any); ok {\n\t\t\t\tdelete(m, \"generated_at\")\n\t\t\t}\n\t\t\tif !reflect.DeepEqual(got, want) {\n\t\t\t\tg, _ := json.Marshal(got)\n\t\t\t\tw, _ := json.Marshal(want)\n\t\t\t\tt.Fatalf(\"the in-process result differs from the spawned one:\\n got  %.400s\\n want %.400s\", g, w)\n\t\t\t}\n\t\t})\n\t}\n}\n\n// followupFixture is a small project with one open follow-up, so the parity of the\n// followups wrapper is measured on content instead of on this repository's size.\nfunc followupFixture(t *testing.T) string {\n\tt.Helper()\n\troot := t.TempDir()\n\tpath := filepath.Join(root, \".pose\", \"specs\", \"2026-06-01-alpha.md\")\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbody := \"---\\nslug: alpha\\nstatus: done\\ncreated_at: 2026-06-01\\ncompleted_at: 2026-06-02\\n---\\n\\n# Spec: alpha\\n\\n## 7. Final Report\\n\\n### Follow-ups\\n\\n- [open] Look at the thing again. (owner:@team crit:low review:2099-01-01)\\n\"\n\tif err := os.WriteFile(path, []byte(body), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn root\n}\n\n// Concurrent wrapper calls over the same root are independent: the in-process\n// commands share no state the way two processes share none.\nfunc TestInProcessWrappersAreSafeUnderConcurrency(t *testing.T) {\n\troot := followupFixture(t)\n\tstore := posemodel.Store{Root: root}\n\terrs := make(chan error, 16)\n\tfor i := 0; i < 8; i++ {\n\t\tgo func() {\n\t\t\t_, err := store.Suggest(context.Background(), \"feature\", \"\", \"\")\n\t\t\terrs <- err\n\t\t}()\n\t\tgo func() {\n\t\t\t_, err := store.Followups(context.Background(), false)\n\t\t\terrs <- err\n\t\t}()\n\t}\n\tfor i := 0; i < 16; i++ {\n\t\t// A fixture without a task map answers suggest with the command's own error;\n\t\t// what matters here is that no call deadlocks or races.\n\t\tif err := <-errs; err != nil && !errAllowed(err) {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n}\n\nfunc errAllowed(err error) bool {\n\treturn err != nil && strings.Contains(err.Error(), \"task-map missing\")\n}\n\n// The handoff's argv is consumed by the CLI that produced the plan: an unchanged\n// repository must accept the digest it names (spec pose-common-domain-and-cli-mcp-handoff\n// R4/R5), and a handoff is not offered for a plan the apply would refuse.\nfunc TestTheDigestOfAHandoffIsTheDigestTheApplyChecks(t *testing.T) {\n\troot := reviewBundleCLIFixture(t)\n\t_, raw := runPose(t, root, \"close\", \"spec:bundle\", \"--plan\", \"--json\")\n\tvar plan posemodel.CloseoutPlan\n\tif err := json.Unmarshal([]byte(raw), &plan); err != nil {\n\t\tt.Fatalf(\"plan: %v\\n%s\", err, raw)\n\t}\n\t// The consumer check is about the digest, so the plan is cleared of what would only\n\t// withhold the handoff; the real plan of this fixture is covered by the blocked case below.\n\tprobe := plan\n\tprobe.Terminal, probe.Blockers = false, nil\n\tprobe.Steps = []posemodel.CloseoutPlanStep{{ID: posemodel.CloseoutStepEvidence, State: posemodel.CloseoutStatePending}}\n\th := posemodel.CloseoutHandoff(probe, posemodel.HandoffTarget{})\n\tif h == nil {\n\t\tt.Fatal(\"no handoff for a plan with a pending step\")\n\t}\n\tcode, out := runPose(t, root, h.Argv[1:]...)\n\tif strings.Contains(out, \"plan-digest-mismatch\") || strings.Contains(out, \"the repository changed since the plan was computed\") {\n\t\tt.Fatalf(\"the digest of a handoff for an unchanged repository was refused (%d): %s\", code, out)\n\t}\n}\n","numLines":137,"startLine":1,"totalLines":137}},"tool_result_meta":[{"id":"toolu_01MJrc3XxLq15sJk4MrDgiVP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
