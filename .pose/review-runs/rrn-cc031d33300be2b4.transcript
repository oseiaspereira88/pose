{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F1n1EqSxxYGSoiUvjT1XV6","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"os\"\n9\t\t\"path\"\n10\t\t\"path/filepath\"\n11\t\t\"sort\"\n12\t\t\"strings\"\n13\t\n14\t\tposepkg \"github.com/harne8/pose-mcp/internal/pose\"\n15\t)\n16\t\n17\ttype taskMap struct {\n18\t\tTasks map[string]map[string]any `json:\"tasks\"`\n19\t}\n20\t\n21\tfunc cmdSuggest(root string, args []string, stdout, stderr io.Writer) int {\n22\t\treturn cmdSuggestIn(posepkg.NativeFiles(), root, args, stdout, stderr)\n23\t}\n24\t\n25\tfunc cmdSuggestIn(files posepkg.Files, root string, args []string, stdout, stderr io.Writer) int {\n26\t\ttask, domain, pathHint := \"\", \"\", \"\"\n27\t\tjsonOut := false\n28\t\tfor i := 0; i < len(args); i++ {\n29\t\t\tswitch args[i] {\n30\t\t\tcase \"--json\":\n31\t\t\t\tjsonOut = true\n32\t\t\tcase \"--domain\", \"--path\":\n33\t\t\t\tif i+1 >= len(args) {\n34\t\t\t\t\treturn usageError(stderr, \"pose suggest: value required\")\n35\t\t\t\t}\n36\t\t\t\ti++\n37\t\t\t\tif args[i-1] == \"--domain\" {\n38\t\t\t\t\tdomain = args[i]\n39\t\t\t\t} else {\n40\t\t\t\t\tpathHint = args[i]\n41\t\t\t\t}\n42\t\t\tdefault:\n43\t\t\t\tif strings.HasPrefix(args[i], \"-\") || task != \"\" {\n44\t\t\t\t\treturn usageError(stderr, \"Usage: pose suggest [type] [--domain d] [--path p] [--json]\")\n45\t\t\t\t}\n46\t\t\t\ttask = args[i]\n47\t\t\t}\n48\t\t}\n49\t\tif pathHint != \"\" && !confinedRelativePath(pathHint) {\n50\t\t\treturn usageError(stderr, \"pose suggest: --path must remain inside project\")\n51\t\t}\n52\t\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"task-map.json\"))\n53\t\tif err != nil {\n54\t\t\tfmt.Fprintln(stderr, \"pose suggest: task-map missing\")\n55\t\t\treturn 2\n56\t\t}\n57\t\tvar tm taskMap\n58\t\tvar document map[string]json.RawMessage\n59\t\tif json.Unmarshal(raw, &document) != nil || document == nil {\n60\t\t\treturn usageError(stderr, \"pose suggest: invalid task-map\")\n61\t\t}\n62\t\t// The decoder of a struct matches a field in any case (and by Unicode folding), so two keys\n63\t\t// that differ only in case would be one field and the later would win: the exact key is\n64\t\t// selected here and any other that folds to it is refused.\n65\t\tfor key := range document {\n66\t\t\tif key != \"tasks\" && strings.EqualFold(key, \"tasks\") {\n67\t\t\t\treturn usageError(stderr, fmt.Sprintf(\"pose suggest: invalid task-map: the key %q is ambiguous with \\\"tasks\\\"\", key))\n68\t\t\t}\n69\t\t}\n70\t\tif dupErr := posepkg.RejectDuplicateJSONKeys(raw); dupErr != nil {\n71\t\t\treturn usageError(stderr, fmt.Sprintf(\"pose suggest: invalid task-map: %v\", dupErr))\n72\t\t}\n73\t\tif tasks, present := document[\"tasks\"]; !present || json.Unmarshal(tasks, &tm.Tasks) != nil || tm.Tasks == nil {\n74\t\t\treturn usageError(stderr, \"pose suggest: invalid task-map\")\n75\t\t}\n76\t\tkeys := make([]string, 0, len(tm.Tasks))\n77\t\tfor k := range tm.Tasks {\n78\t\t\tkeys = append(keys, k)\n79\t\t}\n80\t\tsort.Strings(keys)\n81\t\tif task == \"\" {\n82\t\t\tif jsonOut {\n83\t\t\t\t_ = json.NewEncoder(stdout).Encode(keys)\n84\t\t\t} else {\n85\t\t\t\tfmt.Fprintln(stdout, \"Available task types:\")\n86\t\t\t\tfor _, k := range keys {\n87\t\t\t\t\tfmt.Fprintf(stdout, \"  - %s: %v\\n\", k, tm.Tasks[k][\"description\"])\n88\t\t\t\t}\n89\t\t\t}\n90\t\t\treturn 0\n91\t\t}\n92\t\tt, ok := tm.Tasks[task]\n93\t\tif ok && t == nil {\n94\t\t\treturn usageError(stderr, fmt.Sprintf(\"pose suggest: invalid task-map entry %q: the entry is null\", task))\n95\t\t}\n96\t\tif !ok {\n97\t\t\tfmt.Fprintf(stderr, \"pose suggest: unknown task type %q (available: %s)\\n\", task, strings.Join(keys, \", \"))\n98\t\t\treturn 2\n99\t\t}\n100\t\trules, byDomain, cfgErr := suggestTaskRules(t)\n101\t\tif cfgErr != nil {\n102\t\t\treturn usageError(stderr, fmt.Sprintf(\"pose suggest: invalid task-map entry %q: %v\", task, cfgErr))\n103\t\t}\n104\t\treferences, refErr := suggestTaskReferences(root, t, files)\n105\t\tif refErr != nil {\n106\t\t\treturn usageError(stderr, fmt.Sprintf(\"pose suggest: invalid task-map entry %q: %v\", task, refErr))\n107\t\t}\n108\t\tsource, domainProblem := \"explicit\", \"\"\n109\t\tif domain == \"\" && pathHint != \"\" {\n110\t\t\tdomain, source, domainProblem = inferSuggestDomain(root, pathHint, files)\n111\t\t\tif domainProblem != \"\" {\n112\t\t\t\t_ = usageError(stderr, \"pose suggest: \"+domainProblem+\"; the trail below has no domain rules\")\n113\t\t\t}\n114\t\t}\n115\t\tdomainInput := domain\n116\t\tdomain, aliased := normalizeSuggestDomain(domain)\n117\t\tif aliased && source == \"explicit\" {\n118\t\t\tsource = \"alias\"\n119\t\t}\n120\t\tdomainKnown := true\n121\t\tif domain != \"\" {\n122\t\t\textra, known := byDomain[domain]\n123\t\t\tif known {\n124\t\t\t\trules = append(rules, extra...)\n125\t\t\t}\n126\t\t\tdomainKnown = known\n127\t\t}\n128\t\tstatuses := suggestRuleStatuses(root, rules, files)\n129\t\tif jsonOut {\n130\t\t\tpayload := map[string]any{\"name\": task}\n131\t\t\tfor k, v := range t {\n132\t\t\t\tpayload[k] = v\n133\t\t\t}\n134\t\t\tif domain != \"\" {\n135\t\t\t\tpayload[\"domain_effective\"] = domain\n136\t\t\t\tpayload[\"domain_source\"] = source\n137\t\t\t\tpayload[\"rules_effective\"] = rules\n138\t\t\t\tif domainInput != domain {\n139\t\t\t\t\tpayload[\"domain_input\"] = domainInput\n140\t\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"9b22fc6d-ef10-4ee0-b233-3cf2a5744740","timestamp":"2026-11-09T06:36:48.960Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3984980499/worktree/pose-mcp/internal/cli/suggest.go","content":"package cli\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\n\tposepkg \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\ntype taskMap struct {\n\tTasks map[string]map[string]any `json:\"tasks\"`\n}\n\nfunc cmdSuggest(root string, args []string, stdout, stderr io.Writer) int {\n\treturn cmdSuggestIn(posepkg.NativeFiles(), root, args, stdout, stderr)\n}\n\nfunc cmdSuggestIn(files posepkg.Files, root string, args []string, stdout, stderr io.Writer) int {\n\ttask, domain, pathHint := \"\", \"\", \"\"\n\tjsonOut := false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--json\":\n\t\t\tjsonOut = true\n\t\tcase \"--domain\", \"--path\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"pose suggest: value required\")\n\t\t\t}\n\t\t\ti++\n\t\t\tif args[i-1] == \"--domain\" {\n\t\t\t\tdomain = args[i]\n\t\t\t} else {\n\t\t\t\tpathHint = args[i]\n\t\t\t}\n\t\tdefault:\n\t\t\tif strings.HasPrefix(args[i], \"-\") || task != \"\" {\n\t\t\t\treturn usageError(stderr, \"Usage: pose suggest [type] [--domain d] [--path p] [--json]\")\n\t\t\t}\n\t\t\ttask = args[i]\n\t\t}\n\t}\n\tif pathHint != \"\" && !confinedRelativePath(pathHint) {\n\t\treturn usageError(stderr, \"pose suggest: --path must remain inside project\")\n\t}\n\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"task-map.json\"))\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, \"pose suggest: task-map missing\")\n\t\treturn 2\n\t}\n\tvar tm taskMap\n\tvar document map[string]json.RawMessage\n\tif json.Unmarshal(raw, &document) != nil || document == nil {\n\t\treturn usageError(stderr, \"pose suggest: invalid task-map\")\n\t}\n\t// The decoder of a struct matches a field in any case (and by Unicode folding), so two keys\n\t// that differ only in case would be one field and the later would win: the exact key is\n\t// selected here and any other that folds to it is refused.\n\tfor key := range document {\n\t\tif key != \"tasks\" && strings.EqualFold(key, \"tasks\") {\n\t\t\treturn usageError(stderr, fmt.Sprintf(\"pose suggest: invalid task-map: the key %q is ambiguous with \\\"tasks\\\"\", key))\n\t\t}\n\t}\n\tif dupErr := posepkg.RejectDuplicateJSONKeys(raw); dupErr != nil {\n\t\treturn usageError(stderr, fmt.Sprintf(\"pose suggest: invalid task-map: %v\", dupErr))\n\t}\n\tif tasks, present := document[\"tasks\"]; !present || json.Unmarshal(tasks, &tm.Tasks) != nil || tm.Tasks == nil {\n\t\treturn usageError(stderr, \"pose suggest: invalid task-map\")\n\t}\n\tkeys := make([]string, 0, len(tm.Tasks))\n\tfor k := range tm.Tasks {\n\t\tkeys = append(keys, k)\n\t}\n\tsort.Strings(keys)\n\tif task == \"\" {\n\t\tif jsonOut {\n\t\t\t_ = json.NewEncoder(stdout).Encode(keys)\n\t\t} else {\n\t\t\tfmt.Fprintln(stdout, \"Available task types:\")\n\t\t\tfor _, k := range keys {\n\t\t\t\tfmt.Fprintf(stdout, \"  - %s: %v\\n\", k, tm.Tasks[k][\"description\"])\n\t\t\t}\n\t\t}\n\t\treturn 0\n\t}\n\tt, ok := tm.Tasks[task]\n\tif ok && t == nil {\n\t\treturn usageError(stderr, fmt.Sprintf(\"pose suggest: invalid task-map entry %q: the entry is null\", task))\n\t}\n\tif !ok {\n\t\tfmt.Fprintf(stderr, \"pose suggest: unknown task type %q (available: %s)\\n\", task, strings.Join(keys, \", \"))\n\t\treturn 2\n\t}\n\trules, byDomain, cfgErr := suggestTaskRules(t)\n\tif cfgErr != nil {\n\t\treturn usageError(stderr, fmt.Sprintf(\"pose suggest: invalid task-map entry %q: %v\", task, cfgErr))\n\t}\n\treferences, refErr := suggestTaskReferences(root, t, files)\n\tif refErr != nil {\n\t\treturn usageError(stderr, fmt.Sprintf(\"pose suggest: invalid task-map entry %q: %v\", task, refErr))\n\t}\n\tsource, domainProblem := \"explicit\", \"\"\n\tif domain == \"\" && pathHint != \"\" {\n\t\tdomain, source, domainProblem = inferSuggestDomain(root, pathHint, files)\n\t\tif domainProblem != \"\" {\n\t\t\t_ = usageError(stderr, \"pose suggest: \"+domainProblem+\"; the trail below has no domain rules\")\n\t\t}\n\t}\n\tdomainInput := domain\n\tdomain, aliased := normalizeSuggestDomain(domain)\n\tif aliased && source == \"explicit\" {\n\t\tsource = \"alias\"\n\t}\n\tdomainKnown := true\n\tif domain != \"\" {\n\t\textra, known := byDomain[domain]\n\t\tif known {\n\t\t\trules = append(rules, extra...)\n\t\t}\n\t\tdomainKnown = known\n\t}\n\tstatuses := suggestRuleStatuses(root, rules, files)\n\tif jsonOut {\n\t\tpayload := map[string]any{\"name\": task}\n\t\tfor k, v := range t {\n\t\t\tpayload[k] = v\n\t\t}\n\t\tif domain != \"\" {\n\t\t\tpayload[\"domain_effective\"] = domain\n\t\t\tpayload[\"domain_source\"] = source\n\t\t\tpayload[\"rules_effective\"] = rules\n\t\t\tif domainInput != domain {\n\t\t\t\tpayload[\"domain_input\"] = domainInput\n\t\t\t}","numLines":140,"startLine":1,"totalLines":622}},"tool_result_meta":[{"id":"toolu_01F1n1EqSxxYGSoiUvjT1XV6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
