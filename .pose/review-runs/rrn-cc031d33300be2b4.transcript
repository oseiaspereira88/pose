{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rur93NC4CUgaRP8o6a5BRu","type":"tool_result","content":"150\t\t\tt.Fatalf(\"a handoff returned over MCP must carry no filesystem path: %s\", raw)\n151\t\t}\n152\t}\n153\t\n154\tfunc TestACancelledCallerNeverStartsTheCommandAndNeverGetsAVerdict(t *testing.T) {\n155\t\tvar started atomic.Int64\n156\t\tRegisterInProcessCommand(\"t-count\", func(root string, args []string, stdout, stderr io.Writer) int {\n157\t\t\tstarted.Add(1)\n158\t\t\t_, _ = io.WriteString(stdout, \"ok\")\n159\t\t\treturn 0\n160\t\t})\n161\t\tctx, cancel := context.WithCancel(context.Background())\n162\t\tcancel()\n163\t\tfor i := 0; i < 50; i++ {\n164\t\t\tout, err := (Store{Root: \"/r\"}).runCLI(ctx, []string{\"t-count\"})\n165\t\t\tvar exec *GateExecutionError\n166\t\t\tif out != nil || !errors.As(err, &exec) || exec.Cause != ExecutionCauseCanceled {\n167\t\t\t\tt.Fatalf(\"a cancelled caller got a result (%q, %v) instead of an execution failure\", out, err)\n168\t\t\t}\n169\t\t}\n170\t\tif started.Load() != 0 {\n171\t\t\tt.Fatalf(\"the command started %d times for a caller that had already cancelled\", started.Load())\n172\t\t}\n173\t}\n174\t\n175\tfunc TestACompletionThatRacesACancellationIsDiscarded(t *testing.T) {\n176\t\tctx, cancel := context.WithCancel(context.Background())\n177\t\tRegisterInProcessCommand(\"t-race\", func(root string, args []string, stdout, stderr io.Writer) int {\n178\t\t\tcancel() // the caller cancels while the command finishes\n179\t\t\t_, _ = io.WriteString(stdout, \"late\")\n180\t\t\treturn 0\n181\t\t})\n182\t\tfor i := 0; i < 20; i++ {\n183\t\t\tc, cc := context.WithCancel(ctx)\n184\t\t\tout, err := (Store{Root: \"/r\"}).runCLI(c, []string{\"t-race\"})\n185\t\t\tcc()\n186\t\t\tvar exec *GateExecutionError\n187\t\t\tif out != nil || !errors.As(err, &exec) {\n188\t\t\t\tt.Fatalf(\"a result was returned after the cancellation: %q %v\", out, err)\n189\t\t\t}\n190\t\t}\n191\t}\n192\t\n193\tfunc TestAbandonedRunsDoNotAccumulateBeyondTheSlots(t *testing.T) {\n194\t\tblock := make(chan struct{})\n195\t\tvar alive atomic.Int64\n196\t\tRegisterInProcessCommand(\"t-hold\", func(root string, args []string, stdout, stderr io.Writer) int {\n197\t\t\talive.Add(1)\n198\t\t\t<-block\n199\t\t\talive.Add(-1)\n200\t\t\treturn 0\n201\t\t})\n202\t\tfor i := 0; i < 3*inProcessMaxRuns; i++ {\n203\t\t\tctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)\n204\t\t\t_, err := (Store{Root: \"/r\"}).runCLI(ctx, []string{\"t-hold\"})\n205\t\t\tcancel()\n206\t\t\tvar exec *GateExecutionError\n207\t\t\tif !errors.As(err, &exec) {\n208\t\t\t\tt.Fatalf(\"call %d: %v\", i, err)\n209\t\t\t}\n210\t\t}\n211\t\tif n := alive.Load(); n > inProcessMaxRuns {\n212\t\t\tt.Fatalf(\"%d abandoned runs are alive against %d slots\", n, inProcessMaxRuns)\n213\t\t}\n214\t\tclose(block)\n215\t\tdeadline := time.Now().Add(2 * time.Second)\n216\t\tfor len(inProcessSlots) != 0 && time.Now().Before(deadline) {\n217\t\t\ttime.Sleep(10 * time.Millisecond)\n218\t\t}\n219\t\tif len(inProcessSlots) != 0 {\n220\t\t\tt.Fatalf(\"slots were not given back: %d held\", len(inProcessSlots))\n221\t\t}\n222\t}\n223\t\n224\t// Spec pose-common-domain-and-cli-mcp-handoff R1 (and pose-mcp-server-survives-self-update R2):\n225\t// a command runs in process only when that answers as the spawn of the installed binary would.\n226\tfunc TestAnInProcessRunIsNotTakenWhenTheSpawnWouldRunAnotherEngine(t *testing.T) {\n227\t\tdir := t.TempDir()\n228\t\tfake := filepath.Join(dir, \"pose-fake\")\n229\t\twrite := func(body string) {\n230\t\t\tnext := fake + \".next\"\n231\t\t\tif err := os.WriteFile(next, []byte(body), 0o755); err != nil {\n232\t\t\t\tt.Fatal(err)\n233\t\t\t}\n234\t\t\tif err := os.Rename(next, fake); err != nil { // `pose update` writes the new engine at the same path\n235\t\t\t\tt.Fatal(err)\n236\t\t\t}\n237\t\t}\n238\t\twrite(\"#!/bin/sh\\necho '{\\\"engine\\\":\\\"old\\\"}'\\n\")\n239\t\toldPath, oldInfo, oldErr := executableAtStart, executableInfoAtStart, executableAtStartErr\n240\t\tdefer func() { executableAtStart, executableInfoAtStart, executableAtStartErr = oldPath, oldInfo, oldErr }()\n241\t\texecutableAtStart, executableAtStartErr = fake, nil\n242\t\texecutableInfoAtStart = statExecutableAtStart()\n243\t\tt.Setenv(\"POSE_EXECUTABLE\", \"\")\n244\t\n245\t\tif !inProcessRunsTheSpawnedEngine() {\n246\t\t\tt.Fatal(\"the installed binary is the one running: the command should run in process\")\n247\t\t}\n248\t\twrite(\"#!/bin/sh\\necho '{\\\"engine\\\":\\\"updated\\\"}'\\n\")\n249\t\tif inProcessRunsTheSpawnedEngine() {\n250\t\t\tt.Fatal(\"the installed binary was replaced by an update: the command must be spawned so it runs the updated engine\")\n251\t\t}\n252\t\tvar inProcess atomic.Int64\n253\t\tRegisterInProcessCommand(\"t-engine\", func(root string, args []string, stdout, stderr io.Writer) int {\n254\t\t\tinProcess.Add(1)\n255\t\t\t_, _ = io.WriteString(stdout, `{\"engine\":\"in-memory\"}`)\n256\t\t\treturn 0\n257\t\t})\n258\t\tout, err := (Store{Root: t.TempDir()}).runCLI(context.Background(), []string{\"t-engine\"})\n259\t\tif err != nil || !strings.Contains(string(out), \"updated\") || inProcess.Load() != 0 {\n260\t\t\tt.Fatalf(\"a replaced binary was not asked: %q %v (in-process runs %d)\", out, err, inProcess.Load())\n261\t\t}\n262\t\t// POSE_EXECUTABLE keeps its precedence over the in-process route.\n263\t\tother := filepath.Join(dir, \"pose-other\")\n264\t\tif err := os.WriteFile(other, []byte(\"#!/bin/sh\\necho '{\\\"engine\\\":\\\"configured\\\"}'\\n\"), 0o755); err != nil {\n265\t\t\tt.Fatal(err)\n266\t\t}\n267\t\tt.Setenv(\"POSE_EXECUTABLE\", other)\n268\t\tif inProcessRunsTheSpawnedEngine() {\n269\t\t\tt.Fatal(\"POSE_EXECUTABLE names another binary: it takes precedence\")\n270\t\t}\n271\t\tout, err = (Store{Root: t.TempDir()}).runCLI(context.Background(), []string{\"t-engine\"})\n272\t\tif err != nil || !strings.Contains(string(out), \"configured\") {\n273\t\t\tt.Fatalf(\"POSE_EXECUTABLE was ignored: %q %v\", out, err)\n274\t\t}\n275\t}\n276\t\n277\tfunc TestAPanicInAnInProcessCommandIsAFailedRunNotACrash(t *testing.T) {\n278\t\tRegisterInProcessCommand(\"t-panic\", func(root string, args []string, stdout, stderr io.Writer) int { panic(\"boom\") })\n279\t\t_, err := (Store{Root: \"/r\"}).runCLI(context.Background(), []string{\"t-panic\"})\n280\t\tif err == nil || !strings.Contains(err.Error(), \"panic: boom\") {\n281\t\t\tt.Fatalf(\"a panic must become an error carrying its message: %v\", err)\n282\t\t}\n283\t\tif len(inProcessSlots) != 0 {\n284\t\t\tt.Fatalf(\"the slot of a panicked run was not given back: %d held\", len(inProcessSlots))\n285\t\t}\n286\t}\n287\t\n288\t// The apply stops at the mechanical attestation without --reviewer; a handoff for a plan that\n289\t// has that step owes the performer's execution identity and says so (it never carries one).\n290\tfunc TestAHandoffForAPendingMechanicalStepNamesTheReviewerItDoesNotCarry(t *testing.T) {\n291\t\tplan := handoffPlan()\n292\t\tplan.Steps = append(plan.Steps, CloseoutPlanStep{ID: CloseoutStepMechanical, State: CloseoutStatePending})\n293\t\th := CloseoutHandoff(plan, HandoffTarget{})\n294\t\tif h == nil || len(h.RequiredInputs) != 1 || !strings.Contains(h.RequiredInputs[0], \"--reviewer\") {\n295\t\t\tt.Fatalf(\"a plan with a pending mechanical attestation must name the --reviewer it needs: %+v\", h)\n296\t\t}\n297\t\tfor _, arg := range h.Argv {\n298\t\t\tif strings.Contains(arg, \"reviewer\") {\n299\t\t\t\tt.Fatalf(\"the handoff must not carry a reviewer identity: %q\", h.Argv)\n300\t\t\t}\n301\t\t}\n302\t\tif without := CloseoutHandoff(handoffPlan(), HandoffTarget{}); without == nil || len(without.RequiredInputs) != 0 {\n303\t\t\tt.Fatalf(\"a plan without that step owes no reviewer: %+v\", without)\n304\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"01cb0b22-52d5-41ed-8251-d6d943395bfb","timestamp":"2026-11-09T06:52:23.353Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3984980499/worktree/pose-mcp/internal/pose/common_operation_test.go","content":"\t\tt.Fatalf(\"a handoff returned over MCP must carry no filesystem path: %s\", raw)\n\t}\n}\n\nfunc TestACancelledCallerNeverStartsTheCommandAndNeverGetsAVerdict(t *testing.T) {\n\tvar started atomic.Int64\n\tRegisterInProcessCommand(\"t-count\", func(root string, args []string, stdout, stderr io.Writer) int {\n\t\tstarted.Add(1)\n\t\t_, _ = io.WriteString(stdout, \"ok\")\n\t\treturn 0\n\t})\n\tctx, cancel := context.WithCancel(context.Background())\n\tcancel()\n\tfor i := 0; i < 50; i++ {\n\t\tout, err := (Store{Root: \"/r\"}).runCLI(ctx, []string{\"t-count\"})\n\t\tvar exec *GateExecutionError\n\t\tif out != nil || !errors.As(err, &exec) || exec.Cause != ExecutionCauseCanceled {\n\t\t\tt.Fatalf(\"a cancelled caller got a result (%q, %v) instead of an execution failure\", out, err)\n\t\t}\n\t}\n\tif started.Load() != 0 {\n\t\tt.Fatalf(\"the command started %d times for a caller that had already cancelled\", started.Load())\n\t}\n}\n\nfunc TestACompletionThatRacesACancellationIsDiscarded(t *testing.T) {\n\tctx, cancel := context.WithCancel(context.Background())\n\tRegisterInProcessCommand(\"t-race\", func(root string, args []string, stdout, stderr io.Writer) int {\n\t\tcancel() // the caller cancels while the command finishes\n\t\t_, _ = io.WriteString(stdout, \"late\")\n\t\treturn 0\n\t})\n\tfor i := 0; i < 20; i++ {\n\t\tc, cc := context.WithCancel(ctx)\n\t\tout, err := (Store{Root: \"/r\"}).runCLI(c, []string{\"t-race\"})\n\t\tcc()\n\t\tvar exec *GateExecutionError\n\t\tif out != nil || !errors.As(err, &exec) {\n\t\t\tt.Fatalf(\"a result was returned after the cancellation: %q %v\", out, err)\n\t\t}\n\t}\n}\n\nfunc TestAbandonedRunsDoNotAccumulateBeyondTheSlots(t *testing.T) {\n\tblock := make(chan struct{})\n\tvar alive atomic.Int64\n\tRegisterInProcessCommand(\"t-hold\", func(root string, args []string, stdout, stderr io.Writer) int {\n\t\talive.Add(1)\n\t\t<-block\n\t\talive.Add(-1)\n\t\treturn 0\n\t})\n\tfor i := 0; i < 3*inProcessMaxRuns; i++ {\n\t\tctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)\n\t\t_, err := (Store{Root: \"/r\"}).runCLI(ctx, []string{\"t-hold\"})\n\t\tcancel()\n\t\tvar exec *GateExecutionError\n\t\tif !errors.As(err, &exec) {\n\t\t\tt.Fatalf(\"call %d: %v\", i, err)\n\t\t}\n\t}\n\tif n := alive.Load(); n > inProcessMaxRuns {\n\t\tt.Fatalf(\"%d abandoned runs are alive against %d slots\", n, inProcessMaxRuns)\n\t}\n\tclose(block)\n\tdeadline := time.Now().Add(2 * time.Second)\n\tfor len(inProcessSlots) != 0 && time.Now().Before(deadline) {\n\t\ttime.Sleep(10 * time.Millisecond)\n\t}\n\tif len(inProcessSlots) != 0 {\n\t\tt.Fatalf(\"slots were not given back: %d held\", len(inProcessSlots))\n\t}\n}\n\n// Spec pose-common-domain-and-cli-mcp-handoff R1 (and pose-mcp-server-survives-self-update R2):\n// a command runs in process only when that answers as the spawn of the installed binary would.\nfunc TestAnInProcessRunIsNotTakenWhenTheSpawnWouldRunAnotherEngine(t *testing.T) {\n\tdir := t.TempDir()\n\tfake := filepath.Join(dir, \"pose-fake\")\n\twrite := func(body string) {\n\t\tnext := fake + \".next\"\n\t\tif err := os.WriteFile(next, []byte(body), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.Rename(next, fake); err != nil { // `pose update` writes the new engine at the same path\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\twrite(\"#!/bin/sh\\necho '{\\\"engine\\\":\\\"old\\\"}'\\n\")\n\toldPath, oldInfo, oldErr := executableAtStart, executableInfoAtStart, executableAtStartErr\n\tdefer func() { executableAtStart, executableInfoAtStart, executableAtStartErr = oldPath, oldInfo, oldErr }()\n\texecutableAtStart, executableAtStartErr = fake, nil\n\texecutableInfoAtStart = statExecutableAtStart()\n\tt.Setenv(\"POSE_EXECUTABLE\", \"\")\n\n\tif !inProcessRunsTheSpawnedEngine() {\n\t\tt.Fatal(\"the installed binary is the one running: the command should run in process\")\n\t}\n\twrite(\"#!/bin/sh\\necho '{\\\"engine\\\":\\\"updated\\\"}'\\n\")\n\tif inProcessRunsTheSpawnedEngine() {\n\t\tt.Fatal(\"the installed binary was replaced by an update: the command must be spawned so it runs the updated engine\")\n\t}\n\tvar inProcess atomic.Int64\n\tRegisterInProcessCommand(\"t-engine\", func(root string, args []string, stdout, stderr io.Writer) int {\n\t\tinProcess.Add(1)\n\t\t_, _ = io.WriteString(stdout, `{\"engine\":\"in-memory\"}`)\n\t\treturn 0\n\t})\n\tout, err := (Store{Root: t.TempDir()}).runCLI(context.Background(), []string{\"t-engine\"})\n\tif err != nil || !strings.Contains(string(out), \"updated\") || inProcess.Load() != 0 {\n\t\tt.Fatalf(\"a replaced binary was not asked: %q %v (in-process runs %d)\", out, err, inProcess.Load())\n\t}\n\t// POSE_EXECUTABLE keeps its precedence over the in-process route.\n\tother := filepath.Join(dir, \"pose-other\")\n\tif err := os.WriteFile(other, []byte(\"#!/bin/sh\\necho '{\\\"engine\\\":\\\"configured\\\"}'\\n\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"POSE_EXECUTABLE\", other)\n\tif inProcessRunsTheSpawnedEngine() {\n\t\tt.Fatal(\"POSE_EXECUTABLE names another binary: it takes precedence\")\n\t}\n\tout, err = (Store{Root: t.TempDir()}).runCLI(context.Background(), []string{\"t-engine\"})\n\tif err != nil || !strings.Contains(string(out), \"configured\") {\n\t\tt.Fatalf(\"POSE_EXECUTABLE was ignored: %q %v\", out, err)\n\t}\n}\n\nfunc TestAPanicInAnInProcessCommandIsAFailedRunNotACrash(t *testing.T) {\n\tRegisterInProcessCommand(\"t-panic\", func(root string, args []string, stdout, stderr io.Writer) int { panic(\"boom\") })\n\t_, err := (Store{Root: \"/r\"}).runCLI(context.Background(), []string{\"t-panic\"})\n\tif err == nil || !strings.Contains(err.Error(), \"panic: boom\") {\n\t\tt.Fatalf(\"a panic must become an error carrying its message: %v\", err)\n\t}\n\tif len(inProcessSlots) != 0 {\n\t\tt.Fatalf(\"the slot of a panicked run was not given back: %d held\", len(inProcessSlots))\n\t}\n}\n\n// The apply stops at the mechanical attestation without --reviewer; a handoff for a plan that\n// has that step owes the performer's execution identity and says so (it never carries one).\nfunc TestAHandoffForAPendingMechanicalStepNamesTheReviewerItDoesNotCarry(t *testing.T) {\n\tplan := handoffPlan()\n\tplan.Steps = append(plan.Steps, CloseoutPlanStep{ID: CloseoutStepMechanical, State: CloseoutStatePending})\n\th := CloseoutHandoff(plan, HandoffTarget{})\n\tif h == nil || len(h.RequiredInputs) != 1 || !strings.Contains(h.RequiredInputs[0], \"--reviewer\") {\n\t\tt.Fatalf(\"a plan with a pending mechanical attestation must name the --reviewer it needs: %+v\", h)\n\t}\n\tfor _, arg := range h.Argv {\n\t\tif strings.Contains(arg, \"reviewer\") {\n\t\t\tt.Fatalf(\"the handoff must not carry a reviewer identity: %q\", h.Argv)\n\t\t}\n\t}\n\tif without := CloseoutHandoff(handoffPlan(), HandoffTarget{}); without == nil || len(without.RequiredInputs) != 0 {\n\t\tt.Fatalf(\"a plan without that step owes no reviewer: %+v\", without)\n\t}","numLines":155,"startLine":150,"totalLines":306}},"tool_result_meta":[{"id":"toolu_01Rur93NC4CUgaRP8o6a5BRu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
