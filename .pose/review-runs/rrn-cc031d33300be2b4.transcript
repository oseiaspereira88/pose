{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0117w3oEzZFcnSKmvFzcrnFu","type":"tool_result","content":"30:\tconst usage = \"Usage: pose close spec:<slug> --plan [--json] | --apply|--resume [--digest <plan digest>] [--reviewer agent:<id>] [--skip-evidence] [--json]\"\n31:\tref, mode, digest, reviewer, jsonOutput, skipEvidence := \"\", \"\", \"\", \"\", false, false\n50:\t\tcase \"--digest\", \"--reviewer\":\n58:\t\t\t\treviewer = args[i]\n70:\tif mode == \"plan\" && (digest != \"\" || reviewer != \"\" || skipEvidence) {\n71:\t\treturn refuse(\"--digest, --reviewer and --skip-evidence are taken only by --apply and --resume\")\n105:\tresult := applyClosePlan(root, store, ref, mode, digest, reviewer, skipEvidence)\n185:// reviewer needs.\n261:func applyClosePlan(root string, store posemodel.Store, ref, mode, digest, reviewer string, skipEvidence bool) posemodel.OperationResult {\n266:\t\treturn applyClosePlanGuarded(root, store, ref, mode, digest, reviewer, skipEvidence)\n270:\t\tresult = applyClosePlanGuarded(guarded.Root, guarded, ref, mode, digest, reviewer, skipEvidence)\n306:func applyClosePlanGuarded(root string, store posemodel.Store, ref, mode, digest, reviewer string, skipEvidence bool) posemodel.OperationResult {\n424:\t\t\tresult.NextAction = \"answer the pending criteria with `pose review attest \" + plan.BundleID + \" --reviewer <id> --decision approved --evidence <ref> --criterion ID|passed|<evidence>|<conclusion> ... --apply`, then \" + resume\n426:\t\t\t// The reviewer should not have to discover the evidence refs and\n430:\t\t\trecord(next.ID, fmt.Errorf(\"waiting on a reviewer\"))\n485:\t\t\tif reviewer == \"\" {\n486:\t\t\t\tstepErr, cause, wrote = fmt.Errorf(\"--reviewer is required to record the mechanical attestation; it names the reviewing execution and is never invented\"), \"reviewer-required\", false\n490:\t\t\tattestation, stepErr = store.AutoAttestReviewBundle(plan.BundleID, reviewer, true, time.Now())\n601:\t\tout