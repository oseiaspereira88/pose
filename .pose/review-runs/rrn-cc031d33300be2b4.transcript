{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JNMKkuVWyeV7tVYdnfs3om","type":"tool_result","content":"1\tpackage mcpserver\n2\t\n3\t// Common domain and CLI/MCP handoff (spec pose-common-domain-and-cli-mcp-handoff).\n4\t\n5\timport (\n6\t\t\"encoding/json\"\n7\t\t\"fmt\"\n8\t\t\"net/http/httptest\"\n9\t\t\"os\"\n10\t\t\"os/exec\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"testing\"\n14\t\n15\t\t\"github.com/harne8/pose-mcp/internal/pose\"\n16\t)\n17\t\n18\tfunc TestEveryMCPRouteHasADeclaredClass(t *testing.T) {\n19\t\tadvertised := map[string]bool{}\n20\t\tfor _, def := range toolDefinitions() {\n21\t\t\tname, _ := def[\"name\"].(string)\n22\t\t\tadvertised[name] = true\n23\t\t\tif _, ok := mcpRouteInventory[name]; !ok {\n24\t\t\t\tt.Errorf(\"tool %q has no declared route class\", name)\n25\t\t\t}\n26\t\t}\n27\t\tfor _, name := range mcpRouteInventory.SortedTools() {\n28\t\t\tif !advertised[name] {\n29\t\t\t\tt.Errorf(\"the inventory names %q, which is not advertised\", name)\n30\t\t\t}\n31\t\t}\n32\t\tcounts := map[pose.RouteClass]int{}\n33\t\tfor _, class := range mcpRouteInventory {\n34\t\t\tcounts[class]++\n35\t\t}\n36\t\tt.Logf(\"route classes over %d tools: %v\", len(mcpRouteInventory), counts)\n37\t}\n38\t\n39\t// The tools that may write are exactly the admitted write points, and only the\n40\t// governance-write catalog entries are classified that way.\n41\tfunc TestOnlyAdmittedWritesAreGovernanceWrites(t *testing.T) {\n42\t\tfor name, class := range mcpRouteInventory {\n43\t\t\trisk := catalogGovernance[name].Risk\n44\t\t\tif risk == \"governance-write\" && class != pose.RouteAdmittedWrite {\n45\t\t\t\tt.Errorf(\"%s writes governance state but is classified %s\", name, class)\n46\t\t\t}\n47\t\t\tif class == pose.RouteAdmittedWrite && risk != \"governance-write\" {\n48\t\t\t\tt.Errorf(\"%s is classified an admitted write but its catalog risk is %s\", name, risk)\n49\t\t\t}\n50\t\t}\n51\t}\n52\t\n53\tfunc TestTheReadOnlyWrappersNoLongerStartTheBinary(t *testing.T) {\n54\t\tts := newTestServer(t, \"\")\n55\t\tfor _, tc := range []struct {\n56\t\t\ttool string\n57\t\t\targs string\n58\t\t}{{\"pose_suggest\", `{\"task_type\":\"feature\"}`}, {\"pose_get_followups\", `{}`}} {\n59\t\t\tbefore, runsBefore := pose.CLISpawnAttempts(), pose.CLIInProcessRuns()\n60\t\t\t_, out := post(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":%q,\"arguments\":%s}}`, tc.tool, tc.args))\n61\t\t\t// The fixture may lack what the command needs (a task map): then the CLI's own\n62\t\t\t// error comes back through the wrapper, which is the parity this proves too.\n63\t\t\tif out.Result[\"isError\"] == true {\n64\t\t\t\tcontent, _ := out.Result[\"content\"].([]any)\n65\t\t\t\ttext := \"\"\n66\t\t\t\tif len(content) > 0 {\n67\t\t\t\t\tm, _ := content[0].(map[string]any)\n68\t\t\t\t\ttext, _ = m[\"text\"].(string)\n69\t\t\t\t}\n70\t\t\t\tif !strings.Contains(text, \"pose \"+strings.TrimPrefix(tc.tool, \"pose_get_\")) && !strings.Contains(text, \"pose \"+strings.TrimPrefix(tc.tool, \"pose_\")) {\n71\t\t\t\t\tt.Errorf(\"%s failed with something that is not the command's own error: %q\", tc.tool, text)\n72\t\t\t\t}\n73\t\t\t}\n74\t\t\tif got := pose.CLISpawnAttempts() - before; got != 0 {\n75\t\t\t\tt.Errorf(\"%s tried to start the binary %d times\", tc.tool, got)\n76\t\t\t}\n77\t\t\tif pose.CLIInProcessRuns()-runsBefore != 1 {\n78\t\t\t\tt.Errorf(\"%s did not run in process\", tc.tool)\n79\t\t\t}\n80\t\t}\n81\t}\n82\t\n83\t// The gates keep their process boundary: a call is an attempt to start the binary\n84\t// (refused in a test process, which is an error, not a verdict).\n85\tfunc TestTheGatesKeepTheProcessBoundary(t *testing.T) {\n86\t\tts := newTestServer(t, \"\")\n87\t\tfor _, tc := range []struct{ tool, args string }{{\"pose_check\", `{}`}, {\"pose_skills_check\", `{}`}, {\"pose_lint_spec\", `{\"slug\":\"alpha\"}`}} {\n88\t\t\tbefore := pose.CLISpawnAttempts()\n89\t\t\tpost(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":%q,\"arguments\":%s}}`, tc.tool, tc.args))\n90\t\t\tif pose.CLISpawnAttempts()-before < 1 {\n91\t\t\t\tt.Errorf(\"%s no longer goes through the process boundary\", tc.tool)\n92\t\t\t}\n93\t\t}\n94\t}\n95\t\n96\t// planFixture is a committed repository with an open spec, so the closeout planner\n97\t// has a Git revision to read and steps left to apply.\n98\tfunc planFixture(t *testing.T) *httptest.Server {\n99\t\tts, _ := planFixtureRoot(t)\n100\t\treturn ts\n101\t}\n102\t\n103\tfunc planFixtureRoot(t *testing.T) (*httptest.Server, string) {\n104\t\tt.Helper()\n105\t\troot := t.TempDir()\n106\t\twrite := func(rel, content string) {\n107\t\t\tpath := filepath.Join(root, rel)\n108\t\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n109\t\t\t\tt.Fatal(err)\n110\t\t\t}\n111\t\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n112\t\t\t\tt.Fatal(err)\n113\t\t\t}\n114\t\t}\n115\t\twrite(\".pose/specs/alpha/spec.md\", \"---\\nslug: alpha\\nstatus: done\\ncreated_at: 2026-06-01\\ncompleted_at: 2026-06-02\\n---\\n\\n# Spec: alpha\\n\\nBody.\\n\")\n116\t\twrite(\".pose/specs/beta/spec.md\", \"---\\nslug: beta\\nstatus: in-progress\\ncreated_at: 2026-06-03\\n---\\n\\n# Spec: beta\\n\\n## 2. Requirements\\n\\n- R1: Something.\\n\\n## 6. Validation\\n\\n### Requirement trace\\n- R1 [waived: the fixture has no implementation]\\n\")\n117\t\twrite(\".pose/policy/review.json\", `{\"schema_version\":1,\"enabled\":true,\"adopted_at\":\"2026-08-02\",\"profiles\":{\"spec\":\"spec-closeout@1\"}}`)\n118\t\twrite(\".pose/review-profiles/spec-closeout.json\", `{\"schema_version\":1,\"id\":\"spec-closeout\",\"version\":1,\"scope\":\"spec\",\"criteria\":[{\"id\":\"correctness\",\"description\":\"reviewed\"}]}`)\n119\t\tfor _, args := range [][]string{{\"init\", \"-q\"}, {\"add\", \"-A\"}, {\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-q\", \"-m\", \"fixture\"}} {\n120\t\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...).CombinedOutput(); err != nil {\n121\t\t\t\tt.Fatalf(\"git %v: %v\\n%s\", args, err, out)\n122\t\t\t}\n123\t\t}\n124\t\tts := httptest.NewServer(New(pose.Store{Root: root}).Handler(\"\", \"\"))\n125\t\tt.Cleanup(ts.Close)\n126\t\treturn ts, root\n127\t}\n128\t\n129\tfunc TestACloseoutPlanWithStepsLeftCarriesATypedHandoffThatExecutesNothing(t *testing.T) {\n130\t\tts := planFixture(t)\n131\t\t_, out := post(t, ts, `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_closeout_state\",\"arguments\":{\"scope\":\"spec:beta\",\"include_plan\":true}}}`)\n132\t\tif out.Error != nil || out.Result[\"isError\"] != false {\n133\t\t\tt.Fatalf(\"closeout state failed: %+v %v\", out.Error, out.Result)\n134\t\t}\n135\t\tstructured, _ := out.Result[\"structuredContent\"].(map[string]any)\n136\t\thandoff, _ := structured[\"handoff\"].(map[string]any)\n137\t\tplan, _ := structured[\"execution_plan\"].(map[string]any)\n138\t\tif plan == nil {\n139\t\t\tt.Fatalf(\"no execution plan: %v\", structured)\n140\t\t}\n141\t\tif handoff == nil {\n142\t\t\tt.Fatalf(\"a plan with steps left carries no handoff: terminal=%v steps=%v\", plan[\"terminal\"], plan[\"steps\"])\n143\t\t}\n144\t\tif handoff[\"executes\"] != false || handoff[\"operation\"] != \"close\" || handoff[\"scope\"] != \"spec:beta\" {\n145\t\t\tt.Fatalf(\"handoff = %v\", handoff)\n146\t\t}\n147\t\targv, _ := handoff[\"argv\"].([]any)\n148\t\tif len(argv) < 4 || argv[0] != \"pose\" || argv[1] != \"close\" {\n149\t\t\tt.Fatalf(\"the handoff is not structured arguments: %v\", argv)\n150\t\t}\n151\t\tfor _, a := range argv {\n152\t\t\tif s, _ := a.(string); strings.ContainsAny(s, \" \\t\\n;|&$`\") {\n153\t\t\t\tt.Errorf(\"an argument is shell prose: %q\", s)\n154\t\t\t}\n155\t\t}\n156\t\tinputs, _ := handoff[\"inputs\"].(map[string]any)\n157\t\tif inputs[\"plan_digest\"] != plan[\"digest\"] {\n158\t\t\tt.Fatalf(\"the handoff is not bound to the plan it came from: %v vs %v\", inputs, plan[\"digest\"])\n159\t\t}\n160\t\traw, _ := json.Marshal(handoff)\n161\t\tif strings.Contains(strings.ToLower(string(raw)), \"token\") || strings.Contains(strings.ToLower(string(raw)), \"secret\") {\n162\t\t\tt.Fatalf(\"the handoff carries something secret-shaped: %s\", raw)\n163\t\t}\n164\t}\n165\t\n166\t// Planning is read-only and stable: asking twice for the same state returns the same\n167\t// terminal, next action and digest (P15), and a done spec yields no handoff.\n168\tfunc TestThePlanAndItsHandoffAreStableAndADoneSpecHasNone(t *testing.T) {\n169\t\tts := planFixture(t)\n170\t\tcall := func(scope string) map[string]any {\n171\t\t\t_, out := post(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_closeout_state\",\"arguments\":{\"scope\":%q,\"include_plan\":true}}}`, scope))\n172\t\t\tsc, _ := out.Result[\"structuredContent\"].(map[string]any)\n173\t\t\treturn sc\n174\t\t}\n175\t\ta, b := call(\"spec:beta\"), call(\"spec:beta\")\n176\t\tpa, _ := a[\"execution_plan\"].(map[string]any)\n177\t\tpb, _ := b[\"execution_plan\"].(map[string]any)\n178\t\tif pa == nil || pb == nil {\n179\t\t\tt.Fatalf(\"no plan to compare: %v %v\", a, b)\n180\t\t}\n181\t\tif pa[\"digest\"] != pb[\"digest\"] || pa[\"terminal\"] != pb[\"terminal\"] || pa[\"next_action\"] != pb[\"next_action\"] {\n182\t\t\tt.Fatalf(\"the same state planned twice differs: %v vs %v\", pa, pb)\n183\t\t}\n184\t\tif ha, hb := a[\"handoff\"], b[\"handoff\"]; fmt.Sprint(ha) != fmt.Sprint(hb) {\n185\t\t\tt.Fatalf(\"the handoff is not deterministic: %v vs %v\", ha, hb)\n186\t\t}\n187\t\tif done := call(\"spec:alpha\"); done[\"handoff\"] != nil {\n188\t\t\tt.Fatalf(\"a done spec has a handoff: %v\", done[\"handoff\"])\n189\t\t}\n190\t}\n191\t\n192\t// The MCP plan is the plan the CLI computes: both read PlanCloseout, so for one\n193\t// state they agree on digest, terminal, next action and steps (P15), and the\n194\t// handoff derived from it names that digest.\n195\tfunc TestTheMCPPlanIsTheDomainPlan(t *testing.T) {\n196\t\tts, root := planFixtureRoot(t)\n197\t\tdirect, err := (pose.Store{Root: root}).PlanCloseout(\"spec:beta\")\n198\t\tif err != nil {\n199\t\t\tt.Fatal(err)\n200\t\t}\n201\t\t_, out := post(t, ts, `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_closeout_state\",\"arguments\":{\"scope\":\"spec:beta\",\"include_plan\":true}}}`)\n202\t\tsc, _ := out.Result[\"structuredContent\"].(map[string]any)\n203\t\tplan, _ := sc[\"execution_plan\"].(map[string]any)\n204\t\tnext, _ := plan[\"next_action\"].(string)\n205\t\tif plan[\"digest\"] != direct.Digest || plan[\"terminal\"] != direct.Terminal || next != direct.NextAction {\n206\t\t\tt.Fatalf(\"the MCP plan differs from the domain plan: %v vs %+v\", plan, direct)\n207\t\t}\n208\t\tsteps, _ := plan[\"steps\"].([]any)\n209\t\tif len(steps) != len(direct.Steps) {\n210\t\t\tt.Fatalf(\"steps differ: %d vs %d\", len(steps), len(direct.Steps))\n211\t\t}\n212\t\tif h := pose.CloseoutHandoff(direct, pose.HandoffTarget{}); h == nil || h.Inputs.PlanDigest != direct.Digest {\n213\t\t\tt.Fatalf(\"the handoff is not bound to the domain plan: %+v\", h)\n214\t\t}\n215\t}\n216\t\n217\t// The handoff returned over MCP names the project by its logical id and carries no\n218\t// filesystem path: the MCP contract exposes no root (spec pose-common-domain-and-cli-mcp-handoff).\n219\tfunc TestTheHandoffOverMCPCarriesNoFilesystemPath(t *testing.T) {\n220\t\tts, root := planFixtureRoot(t)\n221\t\t_, out := post(t, ts, `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_closeout_state\",\"arguments\":{\"scope\":\"spec:beta\",\"include_plan\":true}}}`)\n222\t\traw, err := json.Marshal(out.Result)\n223\t\tif err != nil {\n224\t\t\tt.Fatal(err)\n225\t\t}\n226\t\tsc, _ := out.Result[\"structuredContent\"].(map[string]any)\n227\t\tif sc[\"handoff\"] == nil {\n228\t\t\tt.Fatalf(\"the fixture's plan has steps left and must carry a handoff: %s\", raw)\n229\t\t}\n230\t\tif strings.Contains(string(raw), root) {\n231\t\t\tt.Fatalf(\"the MCP response carries the filesystem root %q: %s\", root, raw)\n232\t\t}\n233\t}\n234\t\n235\t// The write points an MCP caller can reach are exactly the four admitted ones, and\n236\t// no tool is named for applying a closeout: the plan hands that operation off.\n237\tfunc TestTheAdmittedWritesAreExactlyTheKnownFour(t *testing.T) {\n238\t\tvar got []string\n239\t\tfor _, name := range mcpRouteInventory.SortedTools() {\n240\t\t\tif mcpRouteInventory[name] == pose.RouteAdmittedWrite {\n241\t\t\t\tgot = append(got, name)\n242\t\t\t}\n243\t\t\t// The Conductor reporter closes a run, not a spec: that is the external boundary.\n244\t\t\tif strings.Contains(name, \"close\") && !strings.HasPrefix(name, \"conductor_\") && mcpRouteInventory[name] != pose.RouteReadOnlyPlan {\n245\t\t\t\tt.Errorf(\"%s looks like a closeout operation but is %s\", name, mcpRouteInventory[name])\n246\t\t\t}\n247\t\t}\n248\t\twant := []string{\"pose_action_fulfil\", \"pose_action_open\", \"pose_action_resolve\", \"pose_review_attest\"}\n249\t\tif strings.Join(got, \",\") != strings.Join(want, \",\") {\n250\t\t\tt.Fatalf(\"admitted writes = %v, want %v\", got, want)\n251\t\t}\n252\t}\n253\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"044579c5-ddc2-437e-a6b1-46d4115761c9","timestamp":"2026-11-09T06:51:34.315Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3984980499/worktree/pose-mcp/internal/mcpserver/common_domain_handoff_test.go","content":"package mcpserver\n\n// Common domain and CLI/MCP handoff (spec pose-common-domain-and-cli-mcp-handoff).\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nfunc TestEveryMCPRouteHasADeclaredClass(t *testing.T) {\n\tadvertised := map[string]bool{}\n\tfor _, def := range toolDefinitions() {\n\t\tname, _ := def[\"name\"].(string)\n\t\tadvertised[name] = true\n\t\tif _, ok := mcpRouteInventory[name]; !ok {\n\t\t\tt.Errorf(\"tool %q has no declared route class\", name)\n\t\t}\n\t}\n\tfor _, name := range mcpRouteInventory.SortedTools() {\n\t\tif !advertised[name] {\n\t\t\tt.Errorf(\"the inventory names %q, which is not advertised\", name)\n\t\t}\n\t}\n\tcounts := map[pose.RouteClass]int{}\n\tfor _, class := range mcpRouteInventory {\n\t\tcounts[class]++\n\t}\n\tt.Logf(\"route classes over %d tools: %v\", len(mcpRouteInventory), counts)\n}\n\n// The tools that may write are exactly the admitted write points, and only the\n// governance-write catalog entries are classified that way.\nfunc TestOnlyAdmittedWritesAreGovernanceWrites(t *testing.T) {\n\tfor name, class := range mcpRouteInventory {\n\t\trisk := catalogGovernance[name].Risk\n\t\tif risk == \"governance-write\" && class != pose.RouteAdmittedWrite {\n\t\t\tt.Errorf(\"%s writes governance state but is classified %s\", name, class)\n\t\t}\n\t\tif class == pose.RouteAdmittedWrite && risk != \"governance-write\" {\n\t\t\tt.Errorf(\"%s is classified an admitted write but its catalog risk is %s\", name, risk)\n\t\t}\n\t}\n}\n\nfunc TestTheReadOnlyWrappersNoLongerStartTheBinary(t *testing.T) {\n\tts := newTestServer(t, \"\")\n\tfor _, tc := range []struct {\n\t\ttool string\n\t\targs string\n\t}{{\"pose_suggest\", `{\"task_type\":\"feature\"}`}, {\"pose_get_followups\", `{}`}} {\n\t\tbefore, runsBefore := pose.CLISpawnAttempts(), pose.CLIInProcessRuns()\n\t\t_, out := post(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":%q,\"arguments\":%s}}`, tc.tool, tc.args))\n\t\t// The fixture may lack what the command needs (a task map): then the CLI's own\n\t\t// error comes back through the wrapper, which is the parity this proves too.\n\t\tif out.Result[\"isError\"] == true {\n\t\t\tcontent, _ := out.Result[\"content\"].([]any)\n\t\t\ttext := \"\"\n\t\t\tif len(content) > 0 {\n\t\t\t\tm, _ := content[0].(map[string]any)\n\t\t\t\ttext, _ = m[\"text\"].(string)\n\t\t\t}\n\t\t\tif !strings.Contains(text, \"pose \"+strings.TrimPrefix(tc.tool, \"pose_get_\")) && !strings.Contains(text, \"pose \"+strings.TrimPrefix(tc.tool, \"pose_\")) {\n\t\t\t\tt.Errorf(\"%s failed with something that is not the command's own error: %q\", tc.tool, text)\n\t\t\t}\n\t\t}\n\t\tif got := pose.CLISpawnAttempts() - before; got != 0 {\n\t\t\tt.Errorf(\"%s tried to start the binary %d times\", tc.tool, got)\n\t\t}\n\t\tif pose.CLIInProcessRuns()-runsBefore != 1 {\n\t\t\tt.Errorf(\"%s did not run in process\", tc.tool)\n\t\t}\n\t}\n}\n\n// The gates keep their process boundary: a call is an attempt to start the binary\n// (refused in a test process, which is an error, not a verdict).\nfunc TestTheGatesKeepTheProcessBoundary(t *testing.T) {\n\tts := newTestServer(t, \"\")\n\tfor _, tc := range []struct{ tool, args string }{{\"pose_check\", `{}`}, {\"pose_skills_check\", `{}`}, {\"pose_lint_spec\", `{\"slug\":\"alpha\"}`}} {\n\t\tbefore := pose.CLISpawnAttempts()\n\t\tpost(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":%q,\"arguments\":%s}}`, tc.tool, tc.args))\n\t\tif pose.CLISpawnAttempts()-before < 1 {\n\t\t\tt.Errorf(\"%s no longer goes through the process boundary\", tc.tool)\n\t\t}\n\t}\n}\n\n// planFixture is a committed repository with an open spec, so the closeout planner\n// has a Git revision to read and steps left to apply.\nfunc planFixture(t *testing.T) *httptest.Server {\n\tts, _ := planFixtureRoot(t)\n\treturn ts\n}\n\nfunc planFixtureRoot(t *testing.T) (*httptest.Server, string) {\n\tt.Helper()\n\troot := t.TempDir()\n\twrite := func(rel, content string) {\n\t\tpath := filepath.Join(root, rel)\n\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\twrite(\".pose/specs/alpha/spec.md\", \"---\\nslug: alpha\\nstatus: done\\ncreated_at: 2026-06-01\\ncompleted_at: 2026-06-02\\n---\\n\\n# Spec: alpha\\n\\nBody.\\n\")\n\twrite(\".pose/specs/beta/spec.md\", \"---\\nslug: beta\\nstatus: in-progress\\ncreated_at: 2026-06-03\\n---\\n\\n# Spec: beta\\n\\n## 2. Requirements\\n\\n- R1: Something.\\n\\n## 6. Validation\\n\\n### Requirement trace\\n- R1 [waived: the fixture has no implementation]\\n\")\n\twrite(\".pose/policy/review.json\", `{\"schema_version\":1,\"enabled\":true,\"adopted_at\":\"2026-08-02\",\"profiles\":{\"spec\":\"spec-closeout@1\"}}`)\n\twrite(\".pose/review-profiles/spec-closeout.json\", `{\"schema_version\":1,\"id\":\"spec-closeout\",\"version\":1,\"scope\":\"spec\",\"criteria\":[{\"id\":\"correctness\",\"description\":\"reviewed\"}]}`)\n\tfor _, args := range [][]string{{\"init\", \"-q\"}, {\"add\", \"-A\"}, {\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-q\", \"-m\", \"fixture\"}} {\n\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...).CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %v\\n%s\", args, err, out)\n\t\t}\n\t}\n\tts := httptest.NewServer(New(pose.Store{Root: root}).Handler(\"\", \"\"))\n\tt.Cleanup(ts.Close)\n\treturn ts, root\n}\n\nfunc TestACloseoutPlanWithStepsLeftCarriesATypedHandoffThatExecutesNothing(t *testing.T) {\n\tts := planFixture(t)\n\t_, out := post(t, ts, `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_closeout_state\",\"arguments\":{\"scope\":\"spec:beta\",\"include_plan\":true}}}`)\n\tif out.Error != nil || out.Result[\"isError\"] != false {\n\t\tt.Fatalf(\"closeout state failed: %+v %v\", out.Error, out.Result)\n\t}\n\tstructured, _ := out.Result[\"structuredContent\"].(map[string]any)\n\thandoff, _ := structured[\"handoff\"].(map[string]any)\n\tplan, _ := structured[\"execution_plan\"].(map[string]any)\n\tif plan == nil {\n\t\tt.Fatalf(\"no execution plan: %v\", structured)\n\t}\n\tif handoff == nil {\n\t\tt.Fatalf(\"a plan with steps left carries no handoff: terminal=%v steps=%v\", plan[\"terminal\"], plan[\"steps\"])\n\t}\n\tif handoff[\"executes\"] != false || handoff[\"operation\"] != \"close\" || handoff[\"scope\"] != \"spec:beta\" {\n\t\tt.Fatalf(\"handoff = %v\", handoff)\n\t}\n\targv, _ := handoff[\"argv\"].([]any)\n\tif len(argv) < 4 || argv[0] != \"pose\" || argv[1] != \"close\" {\n\t\tt.Fatalf(\"the handoff is not structured arguments: %v\", argv)\n\t}\n\tfor _, a := range argv {\n\t\tif s, _ := a.(string); strings.ContainsAny(s, \" \\t\\n;|&$`\") {\n\t\t\tt.Errorf(\"an argument is shell prose: %q\", s)\n\t\t}\n\t}\n\tinputs, _ := handoff[\"inputs\"].(map[string]any)\n\tif inputs[\"plan_digest\"] != plan[\"digest\"] {\n\t\tt.Fatalf(\"the handoff is not bound to the plan it came from: %v vs %v\", inputs, plan[\"digest\"])\n\t}\n\traw, _ := json.Marshal(handoff)\n\tif strings.Contains(strings.ToLower(string(raw)), \"token\") || strings.Contains(strings.ToLower(string(raw)), \"secret\") {\n\t\tt.Fatalf(\"the handoff carries something secret-shaped: %s\", raw)\n\t}\n}\n\n// Planning is read-only and stable: asking twice for the same state returns the same\n// terminal, next action and digest (P15), and a done spec yields no handoff.\nfunc TestThePlanAndItsHandoffAreStableAndADoneSpecHasNone(t *testing.T) {\n\tts := planFixture(t)\n\tcall := func(scope string) map[string]any {\n\t\t_, out := post(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_closeout_state\",\"arguments\":{\"scope\":%q,\"include_plan\":true}}}`, scope))\n\t\tsc, _ := out.Result[\"structuredContent\"].(map[string]any)\n\t\treturn sc\n\t}\n\ta, b := call(\"spec:beta\"), call(\"spec:beta\")\n\tpa, _ := a[\"execution_plan\"].(map[string]any)\n\tpb, _ := b[\"execution_plan\"].(map[string]any)\n\tif pa == nil || pb == nil {\n\t\tt.Fatalf(\"no plan to compare: %v %v\", a, b)\n\t}\n\tif pa[\"digest\"] != pb[\"digest\"] || pa[\"terminal\"] != pb[\"terminal\"] || pa[\"next_action\"] != pb[\"next_action\"] {\n\t\tt.Fatalf(\"the same state planned twice differs: %v vs %v\", pa, pb)\n\t}\n\tif ha, hb := a[\"handoff\"], b[\"handoff\"]; fmt.Sprint(ha) != fmt.Sprint(hb) {\n\t\tt.Fatalf(\"the handoff is not deterministic: %v vs %v\", ha, hb)\n\t}\n\tif done := call(\"spec:alpha\"); done[\"handoff\"] != nil {\n\t\tt.Fatalf(\"a done spec has a handoff: %v\", done[\"handoff\"])\n\t}\n}\n\n// The MCP plan is the plan the CLI computes: both read PlanCloseout, so for one\n// state they agree on digest, terminal, next action and steps (P15), and the\n// handoff derived from it names that digest.\nfunc TestTheMCPPlanIsTheDomainPlan(t *testing.T) {\n\tts, root := planFixtureRoot(t)\n\tdirect, err := (pose.Store{Root: root}).PlanCloseout(\"spec:beta\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, out := post(t, ts, `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_closeout_state\",\"arguments\":{\"scope\":\"spec:beta\",\"include_plan\":true}}}`)\n\tsc, _ := out.Result[\"structuredContent\"].(map[string]any)\n\tplan, _ := sc[\"execution_plan\"].(map[string]any)\n\tnext, _ := plan[\"next_action\"].(string)\n\tif plan[\"digest\"] != direct.Digest || plan[\"terminal\"] != direct.Terminal || next != direct.NextAction {\n\t\tt.Fatalf(\"the MCP plan differs from the domain plan: %v vs %+v\", plan, direct)\n\t}\n\tsteps, _ := plan[\"steps\"].([]any)\n\tif len(steps) != len(direct.Steps) {\n\t\tt.Fatalf(\"steps differ: %d vs %d\", len(steps), len(direct.Steps))\n\t}\n\tif h := pose.CloseoutHandoff(direct, pose.HandoffTarget{}); h == nil || h.Inputs.PlanDigest != direct.Digest {\n\t\tt.Fatalf(\"the handoff is not bound to the domain plan: %+v\", h)\n\t}\n}\n\n// The handoff returned over MCP names the project by its logical id and carries no\n// filesystem path: the MCP contract exposes no root (spec pose-common-domain-and-cli-mcp-handoff).\nfunc TestTheHandoffOverMCPCarriesNoFilesystemPath(t *testing.T) {\n\tts, root := planFixtureRoot(t)\n\t_, out := post(t, ts, `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_closeout_state\",\"arguments\":{\"scope\":\"spec:beta\",\"include_plan\":true}}}`)\n\traw, err := json.Marshal(out.Result)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsc, _ := out.Result[\"structuredContent\"].(map[string]any)\n\tif sc[\"handoff\"] == nil {\n\t\tt.Fatalf(\"the fixture's plan has steps left and must carry a handoff: %s\", raw)\n\t}\n\tif strings.Contains(string(raw), root) {\n\t\tt.Fatalf(\"the MCP response carries the filesystem root %q: %s\", root, raw)\n\t}\n}\n\n// The write points an MCP caller can reach are exactly the four admitted ones, and\n// no tool is named for applying a closeout: the plan hands that operation off.\nfunc TestTheAdmittedWritesAreExactlyTheKnownFour(t *testing.T) {\n\tvar got []string\n\tfor _, name := range mcpRouteInventory.SortedTools() {\n\t\tif mcpRouteInventory[name] == pose.RouteAdmittedWrite {\n\t\t\tgot = append(got, name)\n\t\t}\n\t\t// The Conductor reporter closes a run, not a spec: that is the external boundary.\n\t\tif strings.Contains(name, \"close\") && !strings.HasPrefix(name, \"conductor_\") && mcpRouteInventory[name] != pose.RouteReadOnlyPlan {\n\t\t\tt.Errorf(\"%s looks like a closeout operation but is %s\", name, mcpRouteInventory[name])\n\t\t}\n\t}\n\twant := []string{\"pose_action_fulfil\", \"pose_action_open\", \"pose_action_resolve\", \"pose_review_attest\"}\n\tif strings.Join(got, \",\") != strings.Join(want, \",\") {\n\t\tt.Fatalf(\"admitted writes = %v, want %v\", got, want)\n\t}\n}\n","numLines":253,"startLine":1,"totalLines":253}},"tool_result_meta":[{"id":"toolu_01JNMKkuVWyeV7tVYdnfs3om","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
