.\"))\n101\t\t\t\t\treturn 2\n102\t\t\t\t}\n103\t\t\t\tall, scopeSet = true, true\n104\t\t\tcase \"--json\":\n105\t\t\t\tjsonOut = true\n106\t\t\tcase \"--similarity\":\n107\t\t\t\tif i+1 >= len(args) {\n108\t\t\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --similarity requires an integer from 0 to 100.\", \"Erro: --similarity exige inteiro 0..100.\"))\n109\t\t\t\t\treturn 2\n110\t\t\t\t}\n111\t\t\t\ti++\n112\t\t\t\tvalue, err := strconv.Atoi(args[i])\n113\t\t\t\tif err != nil || value < 0 || value > 100 {\n114\t\t\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --similarity requires an integer from 0 to 100.\", \"Erro: --similarity exige inteiro 0..100.\"))\n115\t\t\t\t\treturn 2\n116\t\t\t\t}\n117\t\t\t\tthreshold = value\n118\t\t\tdefault:\n119\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: unknown option: %s\\n\", \"Erro: opção desconhecida: %s\\n\"), args[i])\n120\t\t\t\treturn 2\n121\t\t\t}\n122\t\t}\n123\t\tif candidatesOnly {\n124\t\t\tif failOverdue {\n125\t\t\t\t// The gate belongs to the backlog; ignoring it here would let a caller believe\n126\t\t\t\t// the candidates were checked against it.\n127\t\t\t\trender(stdout, stderr).Failure(cliText(locale, \"Error: --fail-overdue applies to the backlog, not to --candidates.\", \"Erro: --fail-overdue vale para o backlog, não para --candidates.\"))\n128\t\t\t\treturn 2\n129\t\t\t}\n130\t\t\treturn cmdFollowupCandidates(root, jsonOut, threshold, stdout, stderr)\n131\t\t}\n132\t\tallEntries, coverage := collectFollowupsRead(root)\n133\t\ttoday := followupToday()\n134\t\topenEntries := make([]followup, 0, len(allEntries))\n135\t\toverdueEntries := make([]followup, 0)\n136\t\tunowned := 0\n137\t\tfor _, entry := range allEntries {\n138\t\t\tif followupUnresolved(entry) {\n139\t\t\t\topenEntries = append(openEntries, entry)\n140\t\t\t\tif entry.Owner == \"unowned\" {\n141\t\t\t\t\tunowned++\n142\t\t\t\t}\n143\t\t\t\tif entry.Review != \"\" && entry.Review < today {\n144\t\t\t\t\toverdueEntries = append(