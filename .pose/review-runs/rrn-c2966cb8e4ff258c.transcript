len(args) || strings.HasPrefix(args[i+1], \"--\") {\n\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: %s requires a value.\\n\", \"Erro: %s exige um valor.\\n\"), args[i])\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\ti++\n\t\t\tswitch args[i-1] {\n\t\t\tcase \"--jobs\":\n\t\t\t\tn, err := strconv.Atoi(args[i])\n\t\t\t\tif err != nil || n < 1 {\n\t\t\t\t\trender(stdout, stderr).Failure(cliText(locale, \"--jobs must be a positive integer\", \"--jobs deve ser um inteiro positivo\"))\n\t\t\t\t\treturn 2\n\t\t\t\t}\n\t\t\t\tjobs = n\n\t\t\tcase \"--stack\":\n\t\t\t\tstackFilter = args[i]\n\t\t\tcase \"--module\":\n\t\t\t\tmoduleFilter = filepath.ToSlash(filepath.Clean(args[i]))\n\t\t\tcase \"--workspace\":\n\t\t\t\t// Documented alias of --module <path> (R3) that resolves a\n\t\t\t\t// package/crate name to its module path, for the case\n\t\t\t\t// where the operator knows the workspace member's name but\n\t\t\t\t// not its relative directory.\n\t\t\t\tworkspaceFilter = args[i]\n\t\t\tcase \"--report-task\":\n\t\t\t\treportTask = args[i]\n\t\tif !verbose && (result.Outcome == \"fail\" || result.Outcome == \"error\") {\n\t\t\tstep.Detail(tailLines(result.Output, 10), jsonOut)\n\t\t}\n\t\trun.Checks = append(run.Checks, *result)\n\t}\n\trun.WallSeconds = time.Since(wallStart).Seconds()\n\t// A check that changed a tracked file changed the material it ran over: the\n\t// committed tree no longer describes what was validated.\n\tif len(run.MaterialProvenance) > 0 && !materialTrackedUnchanged(root) {\n\t\tfor spec := range run.MaterialProvenance {\n\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n\t\t}\n\t}\n\t// A cancelled run never reads as a success, whatever the severity of the\n\t// checks it stopped (review round 1, B5).\n\tcancelled := false\n\tfor _, check := range run.Checks {\n\t\tcancelled = cancelled || check.LimitState == \"cancelled\"\n\t}\n\tfor _, line := range validationTimingNotes(run) {\n\t\tsteps.Note(line)\n\t}\n\tsteps.Summary()\n\tif executed == 0 {\n\t\tfmt.Fprintln(stdout, \"No modules/checks matched the matrix and filters.\")\n\t}\n\tresult := \"pass\"\n\tif cancelled {\n\t\tfailures++\n\t\tresult = \"fail\"\n\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"validation cancelled\", \"validação cancelada\")})\n\t} else if failures > 0 {\n\t\tresult = \"fail\"\n\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"required check failed\", \"check obrigatório falhou\")})\n\t} else {\n\t\tif optionalFailures > 0 {\n\t\t\tresult = \"partial\"\n\t\t\tr.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"optional-check\",\n\t\t\t\tMessage: fmt.Sprintf(cliText(locale, \"%d optional check(s) failed\", \"%d check(s) opcional(is) falharam\"), optionalFailures)})\n\t\t}\n\t\tr.Verdict(cliout.Verdict{State: cliout.StatePass})\n\t}\n\trun.Outcome = result\n\tusageFindings := make([]usageFinding, 0, run.Counts.Failed+run.Counts.OptionalFailed+run.Counts.Errored)\n\tfor _, check := range run.Checks {\n\t\tif check.Outcome != \"fail\" && check.Outcome != \"error\" {\n\t\t\tcontinue\n\t\t}\n\t\tseverity := check.Severity\n\t\tif check.Outcome == \"error\" {\n\t\t\tseverity = \"error\"\n\t\t}\n\t\tusageFindings = append(usageFindings, usageFinding{ID: check.ID, Severity: severity})\n\t}\n\tnoteUsageFindings(stdout, result, usageFindings, true)\n\tfor name, writer := range map[string]struct {\n\t\tpath  string\n\t\twrite func(string, validationRunResult) error\n\t}{\n\t\t\"json\":  {jsonOut, writeValidationJSON},\n\t\t\"junit\": {junitOut, writeValidationJUnit},\n\t\t\"sarif\": {sarifOut, writeValidationSARIF},\n\t} {\n\t\tif writer.path == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\ttarget := filepath.Join(root, filepath.FromSlash(writer.path))\n\t\tif name == \"json\" && canonicalResultsPath != \"\" && normalizeValidationOutputPath(writer.path) == canonicalResultsPath {\n\t\t\terr := publishCanonicalValidationJSONIn(store, writer.path, canonicalResultsPath, run)\n\t\t\tif err != nil {\n\t\t\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n\t\t\t\t\tout := render(stdout, stderr)\n\t\t\t\t\tout.ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n\t\t\t\t\tout.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"validation-result-durability\",\n\t\t\t\t\t\tMessage: fmt.Sprintf(\"%s result was published but durability is unconfirmed: %v\", name, err)})\n\t\t\t\t\treturn 1\n\t\t\t\t}\n\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(cliText(locale, \"writing %s result: %v\", \"escrevendo resultado %s: %v\"), name, err))\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\trender(stdout, stderr).ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n\t\t\tcontinue\n\t\t}\n\t\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: creating %s result directory: %v\\n\", \"Erro: criando diretório do resultado %s: %v\\n\"), name, err)\n\t\t\treturn 1\n\t\t}\n\t\tif err := writer.write(target, run); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: writing %s result: %v\\n\", \"Erro: escrevendo resultado %s: %v\\n\"), name, err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"%s: %s\\n\", name, target)\n\t}\n\tif planOut != \"\" {\n\t\tdigest := sha256.Sum256(raw)\n\t\thead := \"\"\n\t\tif out, err := posemodel.RawHistoryGit(root, \"rev-parse\", \"HEAD\").Output(); err == nil {\n\t\t\thead = strings.TrimSpace(string(out))\n\t\t}\n\t\tplan := executionPlan{\n\t\t\tSchemaVersion: validationResultSchema,\nfunc cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar spec, from, to string\n\tstrict, jsonOutput := true, false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--spec\", \"--from\", \"--to\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t\t}\n\t\t\ti++\n\t\t\tswitch args[i-1] {\n\t\t\tcase \"--spec\":\n\t\t\t\tspec = args[i]\n\t\t\tcase \"--from\":\n\t\t\t\tfrom = args[i]\n\t\t\tcase \"--to\":\n\t\t\t\tto = args[i]\n\t\t\t}\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t}\n\t}\n\tstore := posemodel.Store{Root: root}\n\tfull, err := store.GetSpec(spec)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tpolicy, err := posemodel.LoadArtifactPolicy(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tclaims, found, err := posemodel.ParseArtifactClaims(*full, policy)\n\tif err != nil || !found || len(claims) == 0 {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: spec %s has no valid artifact declaration: %v\\n\", spec, err)\n\t\treturn 1\n\t}\n\tvar sets []posemodel.ChangeSet\n\tif from != \"\" || to != \"\" {\n\t\tset, err := resolveGitChangeSet(root, spec, from, to)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tsets = append(sets, set)\n\t} else {\n\t\tfor _, recorded := range loadRecordedChangeSets(root) {\n\t\t\tif recorded.Spec == spec {\n\t\t\t\tsets = append(sets, recorded)\n\t\t\t}\n\t\t}\n\t\tif set, err := resolveGitChangeSet(root, spec, \"\", \"\"); err == nil {\n\t\t\talreadyPresent := false\n\t\t\tfor _, existing := range sets {\n\t\t\t\tif existing.ID == set.ID {\n\t\t\t\t\talreadyPresent = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !alreadyPresent {\n\t\t\t\tsets = append(sets, set)\n\t\t\t}\n\t\t}\n\t\tif len(sets) == 0 {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: no commits carry POSE-Spec: %s\\n\", spec)\n\t\t\treturn 1\n\t\t}\n\t}\n\tset := sets[0]\n\ttracked, err := gitTrackedPaths(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\t// A later removal by another spec is read from every spec's claims and\n\t// change sets (spec pose-delivery-later-removal R4).\n\tvar removals []posemodel.ArtifactRemoval\n\tif _, allClaims, allSets, _, _, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root); err == nil {\n\t\tremovals = artifactRemovals(root, allClaims, allSets, tracked, gaps, sets...)\n\t}\n\tgraph := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), []posemodel.Spec{*full}, claims, sets, tracked, policy, posemodel.LoadArchivedFragments(root), removals)\n\tfor _, claim := range claims {\n\t\tif claim.Action == \"none\" {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{claim.Path}\n\t\tif claim.Action == \"renamed\" {\n\t\t\tpaths = []string{claim.OldPath, claim.NewPath}\n\t\t}\n\t\tfor _, path := range paths {\n\t\t\tif err := posemodel.ValidateArtifactPath(root, path, false); err != nil {\n\t\t\t\tseverity := policy.Severities[\"resolvability\"]\n\t\t\t\tif severity == \"\" {\n\t\t\t\t\tseverity = \"warning\"\n\t\t\t\t}\n\t\t\t\tgraph.Findings = append(graph.Findings, posemodel.NewDeliveryIntegrityFinding(\"resolvability\", severity, spec, path, set.ID, err.Error(), \"declare an exact confined tracked file path\"))\n\t\t\t}\n\t\t}\nfunc cmdSurfaceCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar spec, resultsPath string\n\tstrict, jsonOutput := true, false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--spec\", \"--results\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\n\t\t\t}\n\t\t\ti++\n\t\t\tif args[i-1] == \"--spec\" {\n\t\t\t\tspec = args[i]\n\t\t\t} else {\n\t\t\t\tresultsPath = args[i]\n\t\t\t}\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose surface-check [--spec slug] [--results path] [--strict|--tolerant] [--json]\")\n\t\t}\n\t}\n\tif spec != \"\" && posemodel.ValidateSlug(spec) != nil {\n\t\tfmt.Fprintln(stderr, \"pose surface-check: invalid spec slug\")\n\t\treturn 2\n\t}\n\tpolicy, err := posemodel.LoadDeliveryPolicy(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif resultsPath != \"\" {\n\t\tif !confinedRelativePath(resultsPath) {\n\t\t\tfmt.Fprintln(stderr, \"pose surface-check: results path escapes project\")\n\t\t\treturn 2\n\t\t}\n\t\tpolicy.ResultsPath = filepath.ToSlash(filepath.Clean(resultsPath))\n\t}\n\tbaseSpecs, claims, sets, tracked, artifactPolicy, gaps, err := collectArtifactGraphInputsWithGapsIn(posemodel.NativeFiles(), root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tbase := posemodel.BuildDeliveryIntegrityWithHistoryIn(posemodel.NativeFiles(), baseSpecs, claims, sets, tracked, artifactPolicy, posemodel.LoadArchivedFragments(root), artifactRemovals(root, claims, sets, tracked, gaps))\n\tprofiles, err := loadDeliveryProfiles(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tfullSpecs, targets, err := collectDeliveryTargets(root, baseSpecs, profiles)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose surface-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tresults, err := loadDeliveryValidationResults(root, policy.ResultsPath)\n\tresults = withSmokeResults(root, results)\n\tif err != nil {\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n)\n\n// Spec pose-spec-facts-evidence-binding: the facts and the attribution of change sets read the\n// trailers of the history in one way.\n\n// SpecTrailerLogArgs are the arguments of the `git log` whose output ParseSpecTrailerLog reads:\n// every ref, oldest first, the commits that mention a POSE-Spec trailer, hash and full body.\nvar SpecTrailerLogArgs = []string{\"log\", \"--all\", \"--reverse\", \"--grep=POSE-Spec:\", \"--format=%H%x00%B%x00\"}\n\n// ParseSpecTrailerLog maps each spec slug to the commits that carry its trailer. A trailer is a\n// line of the body that starts with `POSE-Spec:` after trimming; the slug is the rest of the\n// line, trimmed. It does not use Git's trailer parser.\nfunc ParseSpecTrailerLog(out []byte) map[string][]string {\n\tparts := bytes.Split(out, []byte{0})\n\tspecCommits := map[string][]string{}\n\tfor i := 0; i+1 < len(parts); i += 2 {\n\t\tsha, body := strings.TrimSpace(string(parts[i])), string(parts[i+1])\n\t\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif strings.HasPrefix(line, \"POSE-Spec:\") {\n\t\t\t\tspec := strings.TrimSpace(strings.TrimPrefix(line, \"POSE-Spec:\"))\n\t\t\t\tif spec != \"\" {\n\t\t\t\t\tspecCommits[spec] = append(specCommits[spec], sha)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn specCommits\n}\n\n// RawHistoryGit is a git command on root's raw object history: replace refs\n// (--no-replace-objects) and grafts (GIT_GRAFT_FILE at the always-empty null\n// device, which overrides both the repository's graft file and one the\n// environment names) never change which commits carry a trailer, what a change\n// set holds, or what a later removal is judged on (spec\n// pose-delivery-later-removal R3, review round 4 LR-R4-01).\nfunc RawHistoryGit(root string, args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// RawHistoryGitContext is RawHistoryGit under ctx.\nfunc RawHistoryGitContext(ctx context.Context, root string, args ...string) *exec.Cmd {\n\treturn gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// GitHooksDir is the directory git runs the hooks of root from: a linked worktree shares the\n// one of its common directory, and core.hooksPath moves it. Where git cannot answer it is\npose-mcp/internal/pose/git_snapshot_integrity.go:103:func (e *GitSnapshotError) Error() string {\npose-mcp/internal/pose/git_snapshot_integrity.go:106:func (e *GitSnapshotError) Unwrap() error { return e.Cause }\npose-mcp/internal/pose/git_snapshot_integrity.go:357:var ErrGitUnknown = errors.New(\"pose: git state is unknown\")\npose-mcp/internal/pose/git_snapshot_integrity.go:360:func (e *GitSnapshotError) Is(target error) bool { return target == ErrGitUnknown }\npose-mcp/internal/pose/git_snapshot_integrity_test.go:233:\tif _, err := ReadGitStatus(root); !errors.Is(err, ErrGitUnknown) {\npose-mcp/internal/pose/git_snapshot_integrity_test.go:236:\tif _, dirtyErr := (Store{Root: root}).ungeneratedChanges(\"alpha\", \"HEAD\"); !errors.Is(dirtyErr, ErrGitUnknown) {\npose-mcp/internal/pose/git_snapshot_integrity_test.go:242:\tif _, err := ReadGitHead(root); !errors.Is(err, ErrGitUnknown) {\npose-mcp/internal/pose/git_snapshot_integrity_test.go:246:\tif _, err := ReadGitStatus(plain); !errors.Is(err, ErrGitUnavailable) || errors.Is(err, ErrGitUnknown) {\n   145\t- Expected: verde\n   146\t\n   147\t### Execution log\n   148\t- Date: 2026-11-14\n   149\t- Environment: Linux, Go 1.26, corpus do pose-dist em `main` (567 change sets, 2.451 commits atribuídos).\n   150\t- Notes: com um shim de Git no PATH, o motor anterior lia 4.903 `git show --binary` (985 MB) por `pose index` e estourava 512 MiB. Com streaming, `pose index` do pose-dist publica sob 512 MiB. Medido com contadores temporários do read view (um `fprintf` por operação ligado por variável de ambiente, fora do commit): a primeira operação reteve 21.758.777 bytes e não fez streaming; a segunda reteve 32.163.095 bytes, fez streaming de 1.263.513.529 bytes em 2.511 leituras distintas e de novo 522.736.985 bytes na auditoria; 163 s no total. A diferença entre o streaming da operação e o da auditoria mostra que a mesma leitura é feita cerca de 2,4 vezes por operação (follow-up F1). O `delivery-integrity.json` gerado pelo motor anterior e pelo novo é idêntico byte a byte (567 change sets, mesmos IDs e digests). O shim altera o ambiente do Git que o read view observa e por isso faz a geração acusar entradas alteradas; a medição de sucesso foi feita sem ele.\n   151\t\n   152\t### Results summary\n   153\t- Successes: os testes do modo de streaming e o de equivalência do digest; `pose index` sob 512 MiB; índices idênticos.\n   154\t- Failures: nenhuma.\n   155\t- Warnings: o I/O de `pose index` continua proporcional ao histórico atribuído (follow-up).\n   156\t\n   157\t### Requirement trace\n   158\t- R1 [satisfied] test:TestAStreamedObjectReadRetainsOnlyItsDigest check:read-view-streamed-object-digests-integration\nchecks; índice real, artifact-check e surface-check passaram. O check estrito\nglobal seguinte falhou por agregação das closures de closeout e diagnósticos\nem cascata. D7 e a emenda aceita no ADR definem coordenador auditado e views\nlimitadas por escopo; a investigação nativa `trn-78de82fe660bb649` está concluída\ne o checkpoint da task `b34-d7-implementation` foi produzido com Sol medium. A task ficou interrompida por quota; a execução principal terminou os testes e ajustes. A seleção B34 ampliada passou com race (domínio 54,533 s, CLI 16,136 s, MCP 1,331 s), e scaffold/distpolicy passaram. A nova matriz completa e o check real ainda estão pendentes.\nConsultar `report:2026-11-06-pose-b34-global-review-view-budget.md`. Ainda não há\nbundle final, revisão Claude, atestação ou closeout. Os registros abaixo conservam\nos checkpoints anteriores e não qualificam a correção D7.\n\nÚltima revisão: 2026-11-06. Spec `in-progress`, clone persistente\n`/home/go/IdeaProjects/harne8/.worktrees/pose-b34-recovery`, branch\n`work/governance-read-view-recovery`, base publicada `7079eb86`.\n\nO clone temporário desapareceu. Patches e saídas literais das sessões permitiram\nrecuperar o código, o ADR e este handoff. O plano recuperado está em `22f777e9`;\no novo start prospectivo está em `b2eb2d34`. Ele não afirma precedência sobre o\ncódigo recuperado. Os recibos históricos completos de start/amendments e os\ncommits `56f5c150`, `3565be8a`, `dcffc886` não foram transportados ou fabricados.\nO protocolo D4 está no ADR aceito e na baseline do novo start.\n\nCompilação, `go vet` e seleção B34 com race detector passaram. A segunda suíte\ncompleta da recuperação aprovou domínio e MCP; a CLI teve duas negativas cuja\nfixture usava modo 0444 como barreira contra substituição atômica. A recusa foi\nmovida para a fronteira real do publisher, preservando bytes e asserções de efeito;\nos quatro controles positivos/negativos relacionados passaram depois da correção.\nA matriz completa passou 189/189 em `f54e9285`. Esse resultado é histórico para\nos patches posteriores, não aprovação atual. O índice real encontrou dois\nlimites que os testes anteriores não reproduziam: profundidade federada oito\naplicada a toda cadeia local e capacidade insuficiente para a operação completa.\nD5, commit `74f5762f`, separou as arestas locais dos cruzamentos federados e\nincluiu redirects e deduplicação na fronteira. D6 recalibrou os limites com\nmedição versionada; seus testes normais focados e a integração ampliada com race\npassaram. O novo índice real, a matriz atual e a revisão final continuam pendentes.\n\nAs correções integradas cobrem seleção do Store/resolver qualificado, lease\ncanônica dos resultados, diretórios staged por Open, separação de leases de\nseeding/indexação, identidade explícita das fontes federadas e diagnóstico Git.\nNada disso torna prova histórica em autorização atual.\n\nNotas locais de recuperação e logs estão em `recovery-notes/`, excluídos do Git.\nUse os resultados nativos atuais e os commits com trailer da spec como evidência\npublicável; não promova os relatos históricos deste handoff a testes atuais.\n\n## Next checks\n\n1. Registrar D6 e compilar seu CLI exato; repetir o índice real antes da matriz.\n2. Executar a matriz nativa completa, incluindo Go, integração com `-race`,\n   build, vet e checks de segurança aplicáveis.\n3. Reconciliar artifacts e trace, commitar a implementação com o trailer\n   `POSE-Spec`, compilar o CLI atual e gerar a evidência nativa da matriz.\n4. Passar artifact-check, surface-check e check estrito. Só então selar o bundle\n","exit_code":0,"status":"completed"}}
