/cli/validate.go:1627:// materialTrackedUnchanged reports whether no tracked file differs from HEAD\npose-mcp/internal/cli/validate.go:1659:// administrativeRecordsAreRegular reports whether every changed administrative\n   105\t}\n   106\t\n   107\tfunc (state *governanceReadViewGitState) stream(files Files, ctx context.Context, root, producer string, maxBytes int64, sink io.Writer, args ...string) error {\n   108\t\tdeadline, hasDeadline := ctx.Deadline()\n   109\t\tkey := governanceGitObservationKey(root, args, maxBytes)\n   110\t\tstate.mu.Lock()\n   111\t\tif state.streams == nil {\n   112\t\t\tstate.streams = map[string]*governanceReadViewStreamObservation{}\n   113\t\t}\n   114\t\tprior := state.streams[key]\n   115\t\tif prior == nil {\n   116\t\t\tmetadataCost := int64(len(root) + len(key) + len(producer) + 128)\n   117\t\t\tif !state.op.reserveRecord(metadataCost) {\n   118\t\t\t\tstate.mu.Unlock()\n   119\t\t\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its shared record or metadata budget while streaming Git\")\n   120\t\t\t\treturn errGovernanceReadViewBudget\n   121\t\t\t}\n   122\t\t}\n   123\t\tstate.mu.Unlock()\n   124\t\tdigest, length, stderr, runErr := governanceStreamRun(ctx, files, root, args, maxBytes, state.op.reserveStreamed, sink)\n   125\t\tif errors.Is(runErr, errGovernanceReadViewBudget) {\n   126\t\t\tstate.markUnknownForRoot(root, producer, \"Git streamed output exceeded the read-view streamed byte budget\")\n   127\t\t\treturn errGovernanceReadViewBudget\n   128\t\t}\n   129\t\t_ = stderr\n   130\t\tstate.mu.Lock()\n   131\t\tif prior = state.streams[key]; prior != nil {\n   132\t\t\tprior.producers[producer] = true\n   133\t\t\tsame := prior.digest == digest && prior.length == length && prior.errText == errorText(runErr)\n   134\t\t\tstate.mu.Unlock()\n   135\t\t\tif !same {\n   136\t\t\t\tstate.markUnknownForRoot(root, producer, \"a streamed Git object read differed within the operation\")\n   137\t\t\t\treturn errGovernanceReadViewBudget\n   138\t\t\t}\n   139\t\t\treturn runErr\n   140\t\t}\n   141\t\tstate.streams[key] = &governanceReadViewStreamObservation{\n   142\t\t\troot: root, args: append([]string(nil), args...), files: files, ctx: context.WithoutCancel(ctx), deadline: deadline, hasDeadline: hasDeadline,\n   143\t\t\tmaxBytes: maxBytes, digest: digest, length: length, errText: errorText(runErr), producers: map[string]bool{producer: true},\n   144\t\t}\n   145\t\tstate.mu.Unlock()\n   146\t\treturn runErr\n   147\t}\n   148\t\n   149\t// auditStreams streams every observation again, under its own audit budget,\n   150\t// and reports a producer changed when the digest, length or error differs.\n   215\t\tif limit <= 0 {\n   216\t\t\treturn \"\", 0, nil, errGovernanceReadViewBudget\n   217\t\t}\n   218\t\t_ = FilesOrNative(files)\n   219\t\tif ctx == nil {\n   220\t\t\tctx = context.Background()\n   221\t\t}\n   222\t\tif sink == nil {\n   223\t\t\tsink = io.Discard\n   224\t\t}\n   225\t\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n   226\t\tcmd.WaitDelay = 2 * time.Second\n   227\t\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n   228\t\tout := &governanceStreamWriter{limit: limit, admit: admit, sink: sink, hash: sha256.New()}\n   229\t\tvar stderr bytes.Buffer\n   230\t\tcmd.Stdout = out\n   231\t\tcmd.Stderr = &limitedStderr{buf: &stderr, limit: governanceStreamStderrLimit}\n   232\t\terr := cmd.Run()\n   233\t\tif out.exceeded {\n   234\t\t\treturn \"\", 0, nil, errGovernanceReadViewBudget\n   235\t\t}\n   236\t\tdigest := \"sha256:\" + hex.EncodeToString(out.hash.Sum(nil))\n   237\t\tif err != nil {\n   238\t\t\tif exit, ok := err.(*exec.ExitError); ok {\n   239\t\t\t\texit.Stderr = append([]byte(nil), stderr.Bytes()...)\n   240\t\t\t}\n   241\t\t\treturn digest, out.written, stderr.Bytes(), &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n   242\t\t}\n   243\t\tif stderr.Len() > 0 {\n   244\t\t\tdetail := strings.TrimSpace(stderr.String())\n   245\t\t\tif detail == \"\" {\n   246\t\t\t\tdetail = \"Git wrote unclassified stderr output\"\n   247\t\t\t}\n   248\t\t\treturn digest, out.written, stderr.Bytes(), &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: errors.New(detail)}\n   249\t\t}\n   250\t\treturn digest, out.written, nil, nil\n   251\t}\n   252\t\n   253\ttype governanceStreamWriter struct {\n   254\t\tmu       sync.Mutex\n   255\t\tlimit    int64\n   256\t\twritten  int64\n   257\t\tadmit    func(int64) bool\n   258\t\tsink     io.Writer\n   259\t\thash     hash.Hash\n   260\t\texceeded bool\n   261\t}\n   262\t\n   263\tfunc (w *governanceStreamWriter) Write(data []byte) (int, error) {\n   264\t\tw.mu.Lock()\n   265\t\tdefer w.mu.Unlock()\n   266\t\tif w.exceeded || int64(len(data)) > w.limit-w.written || w.admit != nil && !w.admit(int64(len(data))) {\n   267\t\t\tw.exceeded = true\n   268\t\t\treturn 0, errGovernanceReadViewBudget\n   269\t\t}\n   270\t\tif _, err := w.sink.Write(data); err != nil {\n   271\t\t\treturn 0, err\n   272\t\t}\n   273\t\tw.hash.Write(data)\n   274\t\tw.written += int64(len(data))\n   275\t\treturn len(data), nil\n   276\t}\n   277\t\n   278\ttype limitedStderr struct {\n   279\t\tbuf   *bytes.Buffer\n   280\t\tlimit int\n   281\t}\n   282\t\n   283\tfunc (w *limitedStderr) Write(data []byte) (int, error) {\n   284\t\tif room := w.limit - w.buf.Len(); room > 0 {\n   285\t\t\tif len(data) > room {\n   286\t\t\t\tw.buf.Write(data[:room])\n   287\t\t\t} else {\n   288\t\t\t\tw.buf.Write(data)\n   289\t\t\t}\n   290\t\t}\n   291\t\treturn len(data), nil\n   292\t}\n   230\t\treturn resolveGitChangeSetWithTrailersAndFiles(files, root, spec, base, head, captured)\n   231\t}\n   232\t\n   233\tfunc resolveGitChangeSetWithTrailersAndFiles(files posemodel.Files, root, spec, base, head string, captured []string) (posemodel.ChangeSet, error) {\n   234\t\tgitOutput := func(limit int, args ...string) ([]byte, error) {\n   235\t\t\tif files == nil {\n   236\t\t\t\treturn gitOutputBounded(root, limit, args...)\n   237\t\t\t}\n   238\t\t\treturn gitOutputBoundedIn(files, root, limit, args...)\n   239\t\t}\n   240\t\tgitStream := func(limit int, sink io.Writer, args ...string) error {\n   241\t\t\tif files == nil {\n   242\t\t\t\treturn gitStreamBounded(root, limit, sink, args...)\n   243\t\t\t}\n   244\t\t\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n   245\t\t\tdefer cancel()\n   246\t\t\treturn posemodel.StreamGovernanceRawHistoryGitIn(files, ctx, root, \"index.delivery-integrity\", int64(limit), sink, args...)\n   247\t\t}\n   248\t\tresolveRevision := func(revision string) (string, error) {\n   249\t\t\treturn resolveGitRevisionWithFiles(files, root, revision)\n   250\t\t}\n   251\t\tif spec == \"\" || posemodel.ValidateSlug(spec) != nil {\n   252\t\t\treturn posemodel.ChangeSet{}, fmt.Errorf(\"a valid spec slug is required\")\n   305\t\tdiffHash := sha256.New()\n   306\t\tif len(trailerCommits) > 0 {\n   307\t\t\tcommits = trailerCommits\n   308\t\t\tcommitPathLists := make([][]posemodel.ObservedPath, 0, len(commits))\n   309\t\t\tfor _, sha := range commits {\n   310\t\t\t\tnameStatus, err := gitOutput(4*1024*1024, \"diff-tree\", \"--root\", \"--no-commit-id\", \"--name-status\", \"-z\", \"-M\", \"-r\", sha, \"--\")\n   311\t\t\t\tif err != nil {\n   312\t\t\t\t\treturn posemodel.ChangeSet{}, err\n   313\t\t\t\t}\n   314\t\t\t\tparsed, err := parseGitNameStatusNUL(nameStatus)\n   315\t\t\t\tif err != nil {\n   316\t\t\t\t\treturn posemodel.ChangeSet{}, err\n   317\t\t\t\t}\n   318\t\t\t\tcommitPathLists = append(commitPathLists, parsed)\n   319\t\t\t\tobserved = append(observed, parsed...)\n   320\t\t\t\t// The commit's patch only feeds the digest: it is streamed into\n   321\t\t\t\t// it, the same bytes in the same order, and the read view keeps\n   322\t\t\t\t// its digest, not its bytes (spec pose-read-view-streamed-object-digests).\n   323\t\t\t\tif err := gitStream(16*1024*1024, diffHash, \"show\", \"--binary\", \"--no-ext-diff\", \"--format=\", sha, \"--\"); err != nil {\n   324\t\t\t\t\treturn posemodel.ChangeSet{}, err\n   325\t\t\t\t}\n   326\t\t\t}\n   327\t\t\tpaths = mergeObservedPaths(commitPathLists)\n   328\t\t} else {\n   329\t\t\tnameStatus, err := gitOutput(8*1024*1024, \"diff\", \"--name-status\", \"-z\", \"-M\", \"--no-ext-diff\", resolvedBase, resolvedHead, \"--\")\n   330\t\t\tif err != nil {\n   331\t\t\t\treturn posemodel.ChangeSet{}, err\n   332\t\t\t}\n   333\t\t\tpaths, err = parseGitNameStatusNUL(nameStatus)\n   334\t\t\tif err != nil {\n   335\t\t\t\treturn posemodel.ChangeSet{}, err\n   336\t\t\t}\n   337\t\t\tdiff, err := gitOutput(32*1024*1024, \"diff\", \"--binary\", \"--no-ext-diff\", resolvedBase, resolvedHead, \"--\")\n   338\t\t\tif err != nil {\n","exit_code":0,"status":"completed"}}
