{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JNmGHDJPmNwJVD69y7eFSR","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t\t\"sync/atomic\"\n9\t\t\"testing\"\n10\t)\n11\t\n12\t// Spec pose-governance-audit-skips-pure-git-reads.\n13\t\n14\tconst pureTestID = \"0123456789abcdef0123456789abcdef01234567\"\n15\t\n16\t// R1: only the exact forms that cannot depend on mutable state are pure.\n17\tfunc TestOnlyReadsThatCannotDependOnMutableStateAreClassifiedPure(t *testing.T) {\n18\t\ttype want struct{ object, head bool }\n19\t\tfor _, tc := range []struct {\n20\t\t\targs []string\n21\t\t\twant want\n22\t\t}{\n23\t\t\t{[]string{\"show\", pureTestID + \":.pose/a.md\"}, want{true, false}},\n24\t\t\t{[]string{\"show\", \"HEAD:.pose/a.md\"}, want{}},\n25\t\t\t{[]string{\"show\", \"main:.pose/a.md\"}, want{}},\n26\t\t\t{[]string{\"show\", pureTestID}, want{}},\n27\t\t\t{[]string{\"cat-file\", \"blob\", pureTestID}, want{true, false}},\n28\t\t\t{[]string{\"cat-file\", \"blob\", \"HEAD\"}, want{}},\n29\t\t\t{[]string{\"cat-file\", \"-e\", pureTestID}, want{}},\n30\t\t\t{[]string{\"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\"}, want{false, true}},\n31\t\t\t{[]string{\"log\", \"-1\", \"--format=%H\", \"--\"}, want{}},\n32\t\t\t{[]string{\"log\", \"-1\", \"--format=%d\", \"--\", \"a.md\"}, want{}},\n33\t\t\t{[]string{\"log\", \"-1\", \"--all\", \"--format=%H\", \"--\", \"a.md\"}, want{}},\n34\t\t\t{[]string{\"log\", \"--all\", \"-1\", \"--format=%H\", \"--\", \"a.md\"}, want{}},\n35\t\t\t{[]string{\"ls-tree\", \"-z\", pureTestID, \"--\", \"a\"}, want{true, false}},\n36\t\t\t{[]string{\"ls-tree\", pureTestID}, want{true, false}},\n37\t\t\t{[]string{\"ls-tree\", \"-z\", \"HEAD\", \"--\", \"a\"}, want{}},\n38\t\t\t{[]string{\"ls-tree\", \"-z\", \"refs/heads/main\"}, want{}},\n39\t\t\t{[]string{\"ls-tree\", \"--abbrev\", pureTestID}, want{}},\n40\t\t\t{[]string{\"ls-tree\", \"-z\", pureTestID, \"extra\"}, want{}},\n41\t\t\t{[]string{\"rev-parse\", \"--verify\", \"HEAD\"}, want{}},\n42\t\t\t{[]string{\"merge-base\", \"--is-ancestor\", pureTestID, pureTestID}, want{}},\n43\t\t\t{nil, want{}},\n44\t\t} {\n45\t\t\tobject, head := governancePureGitRead(tc.args)\n46\t\t\tif object != tc.want.object || head != tc.want.head {\n47\t\t\t\tt.Errorf(\"%v classified (%v, %v), want (%v, %v)\", tc.args, object, head, tc.want.object, tc.want.head)\n48\t\t\t}\n49\t\t}\n50\t}\n51\t\n52\t// R2/R3: the final audit does not rerun a pure read while its commit stands, reruns every\n53\t// other command, and reruns a head-relative read, and finds the change, when HEAD moved.\n54\tfunc TestTheFinalAuditSkipsPureReadsWhileTheirCommitStandsAndOnlyThen(t *testing.T) {\n55\t\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\", \"b.md\": \"two\\n\"})\n56\t\treruns := map[string]*atomic.Int64{}\n57\t\toriginal := governanceAuditGit\n58\t\tgovernanceAuditGit = func(ctx context.Context, files Files, r string, args []string, limit int64) ([]byte, []byte, error) {\n59\t\t\tkey := strings.Join(args, \" \")\n60\t\t\tif reruns[key] == nil {\n61\t\t\t\treruns[key] = &atomic.Int64{}\n62\t\t\t}\n63\t\t\treruns[key].Add(1)\n64\t\t\treturn original(ctx, files, r, args, limit)\n65\t\t}\n66\t\tdefer func() { governanceAuditGit = original }()\n67\t\n68\t\tcapture := func() (*governanceReadView, Store, string) {\n69\t\t\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n70\t\t\tstore := base.withGovernanceReadView(view, \"pure-test\")\n71\t\t\thead, err := captureGovernanceGit(store.fsys(), root, \"pure-test\", \"rev-parse\", \"--verify\", \"HEAD\")\n72\t\t\tif err != nil {\n73\t\t\t\tt.Fatal(err)\n74\t\t\t}\n75\t\t\tid := strings.TrimSpace(string(head))\n76\t\t\tfor _, args := range [][]string{\n77\t\t\t\t{\"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\"},\n78\t\t\t\t{\"show\", id + \":a.md\"},\n79\t\t\t\t{\"ls-tree\", \"-z\", \"HEAD\", \"--\", \"a.md\"},\n80\t\t\t} {\n81\t\t\t\tif _, err := captureGovernanceGit(store.fsys(), root, \"pure-test\", args...); err != nil {\n82\t\t\t\t\tt.Fatalf(\"%v: %v\", args, err)\n83\t\t\t\t}\n84\t\t\t}\n85\t\t\treturn view, store, id\n86\t\t}\n87\t\tcount := func(prefix string) int64 {\n88\t\t\tvar n int64\n89\t\t\tfor key, c := range reruns {\n90\t\t\t\tif strings.HasPrefix(key, prefix) {\n91\t\t\t\t\tn += c.Load()\n92\t\t\t\t}\n93\t\t\t}\n94\t\t\treturn n\n95\t\t}\n96\t\n97\t\tview, _, _ := capture()\n98\t\tif audit := view.audit(); len(audit.ChangedPaths) != 0 || audit.ChangedProducers[\"pure-test\"] {\n99\t\t\tt.Fatalf(\"nothing changed, the audit reports it did: %+v\", audit)\n100\t\t}\n101\t\tif got := count(\"log -1\"); got != 0 {\n102\t\t\tt.Fatalf(\"the head-relative log was rerun %d times with HEAD where it was\", got)\n103\t\t}\n104\t\tif got := count(\"show \"); got != 0 {\n105\t\t\tt.Fatalf(\"the object-id show was rerun %d times\", got)\n106\t\t}\n107\t\tif count(\"rev-parse\") == 0 || count(\"ls-tree\") == 0 {\n108\t\t\tt.Fatalf(\"a command that is not pure was not rerun: %v\", reruns)\n109\t\t}\n110\t\n111\t\t// HEAD moves, a.md changes: the log, rerun, shows a different last commit.\n112\t\tview, _, _ = capture()\n113\t\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"one changed\\n\"), 0o644); err != nil {\n114\t\t\tt.Fatal(err)\n115\t\t}\n116\t\tsnapshotTestGit(t, root, \"add\", \"a.md\")\n117\t\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-m\", \"change a\")\n118\t\tbefore := count(\"log -1\")\n119\t\taudit := view.audit()\n120\t\tif count(\"log -1\") != before+1 {\n121\t\t\tt.Fatalf(\"the head-relative log was not rerun after HEAD moved\")\n122\t\t}\n123\t\tif !audit.ChangedProducers[\"pure-test\"] || len(audit.ChangedPaths) == 0 {\n124\t\t\tt.Fatalf(\"the change after HEAD moved was not found: %+v\", audit)\n125\t\t}\n126\t}\n127\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"ea03d285-5eae-4596-b7ae-b9e4d9542174","timestamp":"2026-11-10T05:40:30.532Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-4116910441/worktree/pose-mcp/internal/pose/governance_git_pure_test.go","content":"package pose\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"testing\"\n)\n\n// Spec pose-governance-audit-skips-pure-git-reads.\n\nconst pureTestID = \"0123456789abcdef0123456789abcdef01234567\"\n\n// R1: only the exact forms that cannot depend on mutable state are pure.\nfunc TestOnlyReadsThatCannotDependOnMutableStateAreClassifiedPure(t *testing.T) {\n\ttype want struct{ object, head bool }\n\tfor _, tc := range []struct {\n\t\targs []string\n\t\twant want\n\t}{\n\t\t{[]string{\"show\", pureTestID + \":.pose/a.md\"}, want{true, false}},\n\t\t{[]string{\"show\", \"HEAD:.pose/a.md\"}, want{}},\n\t\t{[]string{\"show\", \"main:.pose/a.md\"}, want{}},\n\t\t{[]string{\"show\", pureTestID}, want{}},\n\t\t{[]string{\"cat-file\", \"blob\", pureTestID}, want{true, false}},\n\t\t{[]string{\"cat-file\", \"blob\", \"HEAD\"}, want{}},\n\t\t{[]string{\"cat-file\", \"-e\", pureTestID}, want{}},\n\t\t{[]string{\"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\"}, want{false, true}},\n\t\t{[]string{\"log\", \"-1\", \"--format=%H\", \"--\"}, want{}},\n\t\t{[]string{\"log\", \"-1\", \"--format=%d\", \"--\", \"a.md\"}, want{}},\n\t\t{[]string{\"log\", \"-1\", \"--all\", \"--format=%H\", \"--\", \"a.md\"}, want{}},\n\t\t{[]string{\"log\", \"--all\", \"-1\", \"--format=%H\", \"--\", \"a.md\"}, want{}},\n\t\t{[]string{\"ls-tree\", \"-z\", pureTestID, \"--\", \"a\"}, want{true, false}},\n\t\t{[]string{\"ls-tree\", pureTestID}, want{true, false}},\n\t\t{[]string{\"ls-tree\", \"-z\", \"HEAD\", \"--\", \"a\"}, want{}},\n\t\t{[]string{\"ls-tree\", \"-z\", \"refs/heads/main\"}, want{}},\n\t\t{[]string{\"ls-tree\", \"--abbrev\", pureTestID}, want{}},\n\t\t{[]string{\"ls-tree\", \"-z\", pureTestID, \"extra\"}, want{}},\n\t\t{[]string{\"rev-parse\", \"--verify\", \"HEAD\"}, want{}},\n\t\t{[]string{\"merge-base\", \"--is-ancestor\", pureTestID, pureTestID}, want{}},\n\t\t{nil, want{}},\n\t} {\n\t\tobject, head := governancePureGitRead(tc.args)\n\t\tif object != tc.want.object || head != tc.want.head {\n\t\t\tt.Errorf(\"%v classified (%v, %v), want (%v, %v)\", tc.args, object, head, tc.want.object, tc.want.head)\n\t\t}\n\t}\n}\n\n// R2/R3: the final audit does not rerun a pure read while its commit stands, reruns every\n// other command, and reruns a head-relative read, and finds the change, when HEAD moved.\nfunc TestTheFinalAuditSkipsPureReadsWhileTheirCommitStandsAndOnlyThen(t *testing.T) {\n\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\", \"b.md\": \"two\\n\"})\n\treruns := map[string]*atomic.Int64{}\n\toriginal := governanceAuditGit\n\tgovernanceAuditGit = func(ctx context.Context, files Files, r string, args []string, limit int64) ([]byte, []byte, error) {\n\t\tkey := strings.Join(args, \" \")\n\t\tif reruns[key] == nil {\n\t\t\treruns[key] = &atomic.Int64{}\n\t\t}\n\t\treruns[key].Add(1)\n\t\treturn original(ctx, files, r, args, limit)\n\t}\n\tdefer func() { governanceAuditGit = original }()\n\n\tcapture := func() (*governanceReadView, Store, string) {\n\t\tbase, view := (Store{Root: root}).beginGovernanceReadView()\n\t\tstore := base.withGovernanceReadView(view, \"pure-test\")\n\t\thead, err := captureGovernanceGit(store.fsys(), root, \"pure-test\", \"rev-parse\", \"--verify\", \"HEAD\")\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tid := strings.TrimSpace(string(head))\n\t\tfor _, args := range [][]string{\n\t\t\t{\"log\", \"-1\", \"--format=%H\", \"--\", \"a.md\"},\n\t\t\t{\"show\", id + \":a.md\"},\n\t\t\t{\"ls-tree\", \"-z\", \"HEAD\", \"--\", \"a.md\"},\n\t\t} {\n\t\t\tif _, err := captureGovernanceGit(store.fsys(), root, \"pure-test\", args...); err != nil {\n\t\t\t\tt.Fatalf(\"%v: %v\", args, err)\n\t\t\t}\n\t\t}\n\t\treturn view, store, id\n\t}\n\tcount := func(prefix string) int64 {\n\t\tvar n int64\n\t\tfor key, c := range reruns {\n\t\t\tif strings.HasPrefix(key, prefix) {\n\t\t\t\tn += c.Load()\n\t\t\t}\n\t\t}\n\t\treturn n\n\t}\n\n\tview, _, _ := capture()\n\tif audit := view.audit(); len(audit.ChangedPaths) != 0 || audit.ChangedProducers[\"pure-test\"] {\n\t\tt.Fatalf(\"nothing changed, the audit reports it did: %+v\", audit)\n\t}\n\tif got := count(\"log -1\"); got != 0 {\n\t\tt.Fatalf(\"the head-relative log was rerun %d times with HEAD where it was\", got)\n\t}\n\tif got := count(\"show \"); got != 0 {\n\t\tt.Fatalf(\"the object-id show was rerun %d times\", got)\n\t}\n\tif count(\"rev-parse\") == 0 || count(\"ls-tree\") == 0 {\n\t\tt.Fatalf(\"a command that is not pure was not rerun: %v\", reruns)\n\t}\n\n\t// HEAD moves, a.md changes: the log, rerun, shows a different last commit.\n\tview, _, _ = capture()\n\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"one changed\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsnapshotTestGit(t, root, \"add\", \"a.md\")\n\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-m\", \"change a\")\n\tbefore := count(\"log -1\")\n\taudit := view.audit()\n\tif count(\"log -1\") != before+1 {\n\t\tt.Fatalf(\"the head-relative log was not rerun after HEAD moved\")\n\t}\n\tif !audit.ChangedProducers[\"pure-test\"] || len(audit.ChangedPaths) == 0 {\n\t\tt.Fatalf(\"the change after HEAD moved was not found: %+v\", audit)\n\t}\n}\n","numLines":127,"startLine":1,"totalLines":127}},"tool_result_meta":[{"id":"toolu_01JNmGHDJPmNwJVD69y7eFSR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
