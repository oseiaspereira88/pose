{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GVye4J8tw3DHX1dCwrD8UU","type":"tool_result","content":"280\t\tif state == nil {\n281\t\t\tstate = newGovernanceReadViewGitState(op)\n282\t\t\top.git = state\n283\t\t}\n284\t\top.mu.Unlock()\n285\t\tif !authorized {\n286\t\t\top.primary.markUnknown(producer, \"Git command root is outside the authorized root generation vector\")\n287\t\t\treturn nil, errGovernanceReadViewOutsideRoot\n288\t\t}\n289\t\tif target == nil {\n290\t\t\ttarget = op.primary\n291\t\t}\n292\t\tif err := target.begin(); err != nil {\n293\t\t\treturn nil, err\n294\t\t}\n295\t\tdefer target.end()\n296\t\treturn state.capture(files, ctx, absolute, producer, maxOutputBytes, args...)\n297\t}\n298\t\n299\tfunc (state *governanceReadViewGitState) capture(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n300\t\tif state == nil || state.op == nil {\n301\t\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n302\t\t}\n303\t\tif ctx == nil {\n304\t\t\tctx = context.Background()\n305\t\t}\n306\t\tdeadline, hasDeadline := ctx.Deadline()\n307\t\tauditContext := context.WithoutCancel(ctx)\n308\t\tkey := governanceGitObservationKey(root, args, maxOutputBytes)\n309\t\tstate.mu.Lock()\n310\t\tif prior := state.observations[key]; prior != nil {\n311\t\t\tprior.producers[producer] = true\n312\t\t\tstdout, err := append([]byte(nil), prior.stdout...), prior.err\n313\t\t\tstate.mu.Unlock()\n314\t\t\treturn stdout, err\n315\t\t}\n316\t\tmetadataCost := int64(len(root) + len(key) + len(producer) + 128)\n317\t\tif !state.op.reserveRecord(metadataCost) {\n318\t\t\tstate.mu.Unlock()\n319\t\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its shared record or metadata budget while capturing Git\")\n320\t\t\treturn nil, errGovernanceReadViewBudget\n321\t\t}\n322\t\tlimit := maxOutputBytes\n323\t\tif state.op.remainingInput() < limit {\n324\t\t\tlimit = state.op.remainingInput()\n325\t\t}\n326\t\tif limit <= 0 {\n327\t\t\tstate.mu.Unlock()\n328\t\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its Git input byte budget\")\n329\t\t\treturn nil, errGovernanceReadViewBudget\n330\t\t}\n331\t\tbyObject, byHead := governancePureGitRead(args)\n332\t\theadBefore := \"\"\n333\t\tif byHead {\n334\t\t\theadBefore = governanceHeadAt(ctx, files, root)\n335\t\t}\n336\t\tstdout, stderr, runErr := runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, state.op.reserveInput)\n337\t\tif errors.Is(runErr, errGovernanceReadViewBudget) {\n338\t\t\tstate.mu.Unlock()\n339\t\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n340\t\t\treturn nil, errGovernanceReadViewBudget\n341\t\t}\n342\t\tobservation := &governanceReadViewGitObservation{\n343\t\t\troot: root, args: append([]string(nil), args...), files: files, ctx: auditContext, deadline: deadline, hasDeadline: hasDeadline, maxOutputBytes: maxOutputBytes,\n344\t\t\tstdout: append([]byte(nil), stdout...), stderr: append([]byte(nil), stderr...), err: runErr, errText: errorText(runErr),\n345\t\t\tproducers: map[string]bool{producer: true},\n346\t\t}\n347\t\tif runErr == nil && len(stderr) == 0 {\n348\t\t\tswitch {\n349\t\t\tcase byObject:\n350\t\t\t\tobservation.pure = true\n351\t\t\tcase byHead && headBefore != \"\" && governanceHeadAt(ctx, files, root) == headBefore:\n352\t\t\t\tobservation.pure, observation.headAt = true, headBefore\n353\t\t\t}\n354\t\t}\n355\t\tstate.observations[key] = observation\n356\t\tstate.mu.Unlock()\n357\t\tif isGovernanceGitHeadCommand(args) {\n358\t\t\tif runErr != nil {\n359\t\t\t\tif !state.op.mayOmitPrimaryRevision(root) {\n360\t\t\t\t\tstate.markUnknownForRoot(root, producer, \"source revision could not be read from Git\")\n361\t\t\t\t}\n362\t\t\t} else {\n363\t\t\t\trevision := strings.TrimSpace(string(stdout))\n364\t\t\t\tif revision == \"\" && state.op.mayOmitPrimaryRevision(root) {\n365\t\t\t\t\treturn append([]byte(nil), stdout...), runErr\n366\t\t\t\t}\n367\t\t\t\tstate.bindRevision(root, revision)\n368\t\t\t}\n369\t\t}\n370\t\treturn append([]byte(nil), stdout...), runErr\n371\t}\n372\t\n373\tfunc isGovernanceGitHeadCommand(args []string) bool {\n374\t\treturn len(args) == 3 && args[0] == \"rev-parse\" && args[1] == \"--verify\" && args[2] == \"HEAD\"\n375\t}\n376\t\n377\tfunc governanceGitObservationKey(root string, args []string, maxOutputBytes int64) string {\n378\t\tencoded, _ := json.Marshal(args)\n379\t\treturn filepath.Clean(root) + \"\\x00\" + string(encoded) + \"\\x00\" + fmt.Sprint(maxOutputBytes)\n380\t}\n381\t\n382\tfunc (state *governanceReadViewGitState) bindRevision(root, revision string) {\n383\t\tif revision == \"\" || state == nil || state.op == nil {\n384\t\t\tstate.markUnknownForRoot(root, \"projection\", \"source revision binding is unavailable\")\n385\t\t\treturn\n386\t\t}\n387\t\tstate.op.mu.Lock()\n388\t\tfor _, entry := range state.op.roots {\n389\t\t\tif sameLexicalRoot(entry.root, root) {\n390\t\t\t\tentry.revision = revision\n391\t\t\t\tstate.op.mu.Unlock()\n392\t\t\t\treturn\n393\t\t\t}\n394\t\t}\n395\t\tstate.op.mu.Unlock()\n396\t\tstate.markUnknownForRoot(root, \"projection\", \"source revision root is outside the authorized vector\")\n397\t}\n398\t\n399\tfunc (state *governanceReadViewGitState) markUnknownForRoot(root, producer, reason string) {\n400\t\tif state == nil || state.op == nil {\n401\t\t\treturn\n402\t\t}\n403\t\tstate.op.mu.Lock()\n404\t\tvar view *governanceReadView\n405\t\tfor _, entry := range state.op.roots {\n406\t\t\tif sameLexicalRoot(entry.root, root) {\n407\t\t\t\tview = entry.view\n408\t\t\t\tbreak\n409\t\t\t}\n410\t\t}\n411\t\tstate.op.mu.Unlock()\n412\t\tif view == nil {\n413\t\t\tview = state.op.primary\n414\t\t}\n415\t\tview.markUnknown(producer, reason)\n416\t}\n417\t\n418\tfunc (state *governanceReadViewGitState) audit() governanceReadViewAudit {\n419\t\tresult := governanceReadViewAudit{ChangedProducers: map[string]bool{}, UnknownProducers: map[string][]string{}}\n420\t\tif state == nil {\n421\t\t\treturn result\n422\t\t}\n423\t\tstate.mu.Lock()\n424\t\tobservations := make([]governanceReadViewGitObservation, 0, len(state.observations))\n425\t\tfor _, item := range state.observations {\n426\t\t\tcopy := *item\n427\t\t\tcopy.args = append([]string(nil), item.args...)\n428\t\t\tcopy.stdout = append([]byte(nil), item.stdout...)\n429\t\t\tcopy.stderr = append([]byte(nil), item.stderr...)\n430\t\t\tcopy.producers = cloneBoolMap(item.producers)\n431\t\t\tobservations = append(observations, copy)\n432\t\t}\n433\t\tstate.mu.Unlock()\n434\t\tsort.Slice(observations, func(i, j int) bool {\n435\t\t\tleft := governanceGitObservationKey(observations[i].root, observations[i].args, observations[i].maxOutputBytes)\n436\t\t\tright := governanceGitObservationKey(observations[j].root, observations[j].args, observations[j].maxOutputBytes)\n437\t\t\treturn left < right\n438\t\t})\n439\t\tremaining := int64(governanceReadViewMaxInputBytes)\n440\t\theads := map[string]string{}\n441\t\tfor _, item := range observations {\n442\t\t\tif item.pure {\n443\t\t\t\tif item.headAt == \"\" {\n444\t\t\t\t\tcontinue\n445\t\t\t\t}\n446\t\t\t\tnow, read := heads[item.root]\n447\t\t\t\tif !read {\n448\t\t\t\t\tnow = governanceHeadAt(item.ctx, item.files, item.root)\n449\t\t\t\t\theads[item.root] = now\n450\t\t\t\t}\n451\t\t\t\tif now == item.headAt {\n452\t\t\t\t\tcontinue\n453\t\t\t\t}\n454\t\t\t}\n455\t\t\tif remaining <= 0 {\n456\t\t\t\tfor producer := range item.producers {\n457\t\t\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], \"Git final audit exceeded its shared byte budget\")\n458\t\t\t\t}\n459\t\t\t\tcontinue\n460\t\t\t}\n461\t\t\tlimit := item.maxOutputBytes\n462\t\t\tif remaining < limit {\n463\t\t\t\tlimit = remaining\n464\t\t\t}\n465\t\t\tauditContext := item.ctx\n466\t\t\tcancelAuditContext := func() {}\n467\t\t\tif item.hasDeadline {\n468\t\t\t\tauditContext, cancelAuditContext = context.WithDeadline(auditContext, item.deadline)\n469\t\t\t}\n470\t\t\tstdout, stderr, err := governanceAuditGit(auditContext, item.files, item.root, item.args, limit)\n471\t\t\tcancelAuditContext()\n472\t\t\tif errors.Is(err, errGovernanceReadViewBudget) {\n473\t\t\t\tcommand := \"unknown\"\n474\t\t\t\tif len(item.args) > 0 {\n475\t\t\t\t\tcommand = item.args[0]\n476\t\t\t\t}\n477\t\t\t\tfor producer := range item.producers {\n478\t\t\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], \"Git command \"+command+\" exceeded its bounded final-audit budget\")\n479\t\t\t\t}\n480\t\t\t\tcontinue\n481\t\t\t}\n482\t\t\tremaining -= int64(len(stdout) + len(stderr) + 1)\n483\t\t\tif errorText(err) != item.errText || !bytes.Equal(stdout, item.stdout) || !bytes.Equal(stderr, item.stderr) {\n484\t\t\t\tfor producer := range item.producers {\n485\t\t\t\t\tresult.ChangedProducers[producer] = true\n486\t\t\t\t}\n487\t\t\t\trootDigest := digestBytes([]byte(filepath.Clean(item.root)))\n488\t\t\t\targsDigest := digestBytes([]byte(strings.Join(item.args, \"\\x00\")))\n489\t\t\t\tresult.ChangedPaths = append(result.ChangedPaths, \"git:\"+strings.TrimPrefix(rootDigest, \"sha256:\")+\":\"+strings.TrimPrefix(argsDigest, \"sha256:\"))\n490\t\t\t}\n491\t\t}\n492\t\tresult.ChangedPaths = uniqueSorted(result.ChangedPaths)\n493\t\tfor producer := range result.UnknownProducers {\n494\t\t\tresult.UnknownProducers[producer] = uniqueSorted(result.UnknownProducers[producer])\n495\t\t}\n496\t\treturn result\n497\t}\n498\t\n499\tfunc (state *governanceReadViewGitState) identityDigest() string {\n500\t\tif state == nil {\n501\t\t\treturn \"\"\n502\t\t}\n503\t\ttype identity struct {\n504\t\t\tRootDigest   string   `json:\"root_digest\"`\n505\t\t\tArgsDigest   string   `json:\"args_digest\"`\n506\t\t\tOutputLimit  int64    `json:\"output_limit\"`\n507\t\t\tOutputDigest string   `json:\"output_digest\"`\n508\t\t\tErrorDigest  string   `json:\"error_digest,omitempty\"`\n509\t\t\tProducers    []string `json:\"producers\"`\n510\t\t}\n511\t\tstate.mu.Lock()\n512\t\titems := make([]identity, 0, len(state.observations))\n513\t\tfor _, item := range state.observations {\n514\t\t\targs, _ := json.Marshal(item.args)\n515\t\t\titems = append(items, identity{\n516\t\t\t\tRootDigest: digestBytes([]byte(filepath.Clean(item.root))), ArgsDigest: digestBytes(args),\n517\t\t\t\tOutputLimit:  item.maxOutputBytes,\n518\t\t\t\tOutputDigest: digestBytes(append(append([]byte(nil), item.stdout...), item.stderr...)),\n519\t\t\t\tErrorDigest:  errorDigest(item.errText), Producers: sortedBoolKeys(item.producers),\n520\t\t\t})\n521\t\t}\n522\t\tstate.mu.Unlock()\n523\t\tsort.Slice(items, func(i, j int) bool {\n524\t\t\tif items[i].RootDigest != items[j].RootDigest {\n525\t\t\t\treturn items[i].RootDigest < items[j].RootDigest\n526\t\t\t}\n527\t\t\tif items[i].ArgsDigest != items[j].ArgsDigest {\n528\t\t\t\treturn items[i].ArgsDigest < items[j].ArgsDigest\n529\t\t\t}\n530\t\t\treturn items[i].OutputLimit < items[j].OutputLimit\n531\t\t})\n532\t\traw, _ := json.Marshal(items)\n533\t\tsum := sha256.Sum256(raw)\n534\t\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n535\t}\n536\t\n537\tfunc runGovernanceGitCommand(files Files, root string, args []string, limit int64) ([]byte, error) {\n538\t\tstdout, _, err := runGovernanceGitCommandOutput(files, root, args, limit)\n539\t\treturn stdout, err\n540\t}\n541\t\n542\tfunc runGovernanceGitCommandContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, error) {\n543\t\tstdout, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, args, limit)\n544\t\treturn stdout, err\n545\t}\n546\t\n547\tfunc runGovernanceGitCommandOutput(files Files, root string, args []string, limit int64) ([]byte, []byte, error) {\n548\t\treturn runGovernanceGitCommandOutputAdmitted(files, root, args, limit, nil)\n549\t}\n550\t\n551\tfunc runGovernanceGitCommandOutputContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, []byte, error) {\n552\t\treturn runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, nil)\n553\t}\n554\t\n555\t// runGovernanceGitCommandOutputAdmitted admits each stream chunk before the\n556\t// bounded output buffer retains it. The operation callback is shared with\n557\t// Files reads, so concurrent producers cannot spend the same remaining bytes.\n558\tfunc runGovernanceGitCommandOutputAdmitted(files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n559\t\treturn runGovernanceGitCommandOutputAdmittedContext(context.Background(), files, root, args, limit, admit)\n560\t}\n561\t\n562\t// runGovernanceGitCommandOutputAdmittedContext admits each stream chunk before\n563\t// the bounded output buffer retains it and executes Git under ctx.\n564\tfunc runGovernanceGitCommandOutputAdmittedContext(ctx context.Context, files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n565\t\tif limit < 0 {\n566\t\t\treturn nil, nil, errGovernanceReadViewBudget\n567\t\t}\n568\t\tfiles = FilesOrNative(files)\n569\t\tif ctx == nil {\n570\t\t\tctx = context.Background()\n571\t\t}\n572\t\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n573\t\tcmd.WaitDelay = 2 * time.Second\n574\t\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n575\t\toutput := &boundedGovernanceGitOutput{limit: limit, admit: admit}\n576\t\tcmd.Stdout = governanceGitStream{output: output, stderr: false}\n577\t\tcmd.Stderr = governanceGitStream{output: output, stderr: true}\n578\t\terr := cmd.Run()\n579\t\tstdout, stderr, exceeded := output.values()\n580\t\tif exceeded {\n581\t\t\treturn nil, nil, errGovernanceReadViewBudget\n582\t\t}\n583\t\tif err != nil {\n584\t\t\tif exit, ok := err.(*exec.ExitError); ok {\n585\t\t\t\texit.Stderr = append([]byte(nil), stderr...)\n586\t\t\t}\n587\t\t\treturn stdout, stderr, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n588\t\t}\n589\t\tif len(stderr) > 0 {\n590\t\t\tdetail := strings.TrimSpace(string(stderr))\n591\t\t\tif detail == \"\" {\n592\t\t\t\tdetail = \"Git wrote unclassified stderr output\"\n593\t\t\t}\n594\t\t\treturn stdout, stderr, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: errors.New(detail)}\n595\t\t}\n596\t\treturn stdout, stderr, nil\n597\t}\n598\t\n599\ttype boundedGovernanceGitOutput struct {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"0572a6f5-dd3d-481d-9a2a-9dd0c7ecc36c","timestamp":"2026-11-10T05:40:34.310Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-4116910441/worktree/pose-mcp/internal/pose/governance_read_view_git.go","content":"\tif state == nil {\n\t\tstate = newGovernanceReadViewGitState(op)\n\t\top.git = state\n\t}\n\top.mu.Unlock()\n\tif !authorized {\n\t\top.primary.markUnknown(producer, \"Git command root is outside the authorized root generation vector\")\n\t\treturn nil, errGovernanceReadViewOutsideRoot\n\t}\n\tif target == nil {\n\t\ttarget = op.primary\n\t}\n\tif err := target.begin(); err != nil {\n\t\treturn nil, err\n\t}\n\tdefer target.end()\n\treturn state.capture(files, ctx, absolute, producer, maxOutputBytes, args...)\n}\n\nfunc (state *governanceReadViewGitState) capture(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif state == nil || state.op == nil {\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif ctx == nil {\n\t\tctx = context.Background()\n\t}\n\tdeadline, hasDeadline := ctx.Deadline()\n\tauditContext := context.WithoutCancel(ctx)\n\tkey := governanceGitObservationKey(root, args, maxOutputBytes)\n\tstate.mu.Lock()\n\tif prior := state.observations[key]; prior != nil {\n\t\tprior.producers[producer] = true\n\t\tstdout, err := append([]byte(nil), prior.stdout...), prior.err\n\t\tstate.mu.Unlock()\n\t\treturn stdout, err\n\t}\n\tmetadataCost := int64(len(root) + len(key) + len(producer) + 128)\n\tif !state.op.reserveRecord(metadataCost) {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its shared record or metadata budget while capturing Git\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tlimit := maxOutputBytes\n\tif state.op.remainingInput() < limit {\n\t\tlimit = state.op.remainingInput()\n\t}\n\tif limit <= 0 {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"read view exceeded its Git input byte budget\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tbyObject, byHead := governancePureGitRead(args)\n\theadBefore := \"\"\n\tif byHead {\n\t\theadBefore = governanceHeadAt(ctx, files, root)\n\t}\n\tstdout, stderr, runErr := runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, state.op.reserveInput)\n\tif errors.Is(runErr, errGovernanceReadViewBudget) {\n\t\tstate.mu.Unlock()\n\t\tstate.markUnknownForRoot(root, producer, \"Git command output exceeded the read-view input byte budget\")\n\t\treturn nil, errGovernanceReadViewBudget\n\t}\n\tobservation := &governanceReadViewGitObservation{\n\t\troot: root, args: append([]string(nil), args...), files: files, ctx: auditContext, deadline: deadline, hasDeadline: hasDeadline, maxOutputBytes: maxOutputBytes,\n\t\tstdout: append([]byte(nil), stdout...), stderr: append([]byte(nil), stderr...), err: runErr, errText: errorText(runErr),\n\t\tproducers: map[string]bool{producer: true},\n\t}\n\tif runErr == nil && len(stderr) == 0 {\n\t\tswitch {\n\t\tcase byObject:\n\t\t\tobservation.pure = true\n\t\tcase byHead && headBefore != \"\" && governanceHeadAt(ctx, files, root) == headBefore:\n\t\t\tobservation.pure, observation.headAt = true, headBefore\n\t\t}\n\t}\n\tstate.observations[key] = observation\n\tstate.mu.Unlock()\n\tif isGovernanceGitHeadCommand(args) {\n\t\tif runErr != nil {\n\t\t\tif !state.op.mayOmitPrimaryRevision(root) {\n\t\t\t\tstate.markUnknownForRoot(root, producer, \"source revision could not be read from Git\")\n\t\t\t}\n\t\t} else {\n\t\t\trevision := strings.TrimSpace(string(stdout))\n\t\t\tif revision == \"\" && state.op.mayOmitPrimaryRevision(root) {\n\t\t\t\treturn append([]byte(nil), stdout...), runErr\n\t\t\t}\n\t\t\tstate.bindRevision(root, revision)\n\t\t}\n\t}\n\treturn append([]byte(nil), stdout...), runErr\n}\n\nfunc isGovernanceGitHeadCommand(args []string) bool {\n\treturn len(args) == 3 && args[0] == \"rev-parse\" && args[1] == \"--verify\" && args[2] == \"HEAD\"\n}\n\nfunc governanceGitObservationKey(root string, args []string, maxOutputBytes int64) string {\n\tencoded, _ := json.Marshal(args)\n\treturn filepath.Clean(root) + \"\\x00\" + string(encoded) + \"\\x00\" + fmt.Sprint(maxOutputBytes)\n}\n\nfunc (state *governanceReadViewGitState) bindRevision(root, revision string) {\n\tif revision == \"\" || state == nil || state.op == nil {\n\t\tstate.markUnknownForRoot(root, \"projection\", \"source revision binding is unavailable\")\n\t\treturn\n\t}\n\tstate.op.mu.Lock()\n\tfor _, entry := range state.op.roots {\n\t\tif sameLexicalRoot(entry.root, root) {\n\t\t\tentry.revision = revision\n\t\t\tstate.op.mu.Unlock()\n\t\t\treturn\n\t\t}\n\t}\n\tstate.op.mu.Unlock()\n\tstate.markUnknownForRoot(root, \"projection\", \"source revision root is outside the authorized vector\")\n}\n\nfunc (state *governanceReadViewGitState) markUnknownForRoot(root, producer, reason string) {\n\tif state == nil || state.op == nil {\n\t\treturn\n\t}\n\tstate.op.mu.Lock()\n\tvar view *governanceReadView\n\tfor _, entry := range state.op.roots {\n\t\tif sameLexicalRoot(entry.root, root) {\n\t\t\tview = entry.view\n\t\t\tbreak\n\t\t}\n\t}\n\tstate.op.mu.Unlock()\n\tif view == nil {\n\t\tview = state.op.primary\n\t}\n\tview.markUnknown(producer, reason)\n}\n\nfunc (state *governanceReadViewGitState) audit() governanceReadViewAudit {\n\tresult := governanceReadViewAudit{ChangedProducers: map[string]bool{}, UnknownProducers: map[string][]string{}}\n\tif state == nil {\n\t\treturn result\n\t}\n\tstate.mu.Lock()\n\tobservations := make([]governanceReadViewGitObservation, 0, len(state.observations))\n\tfor _, item := range state.observations {\n\t\tcopy := *item\n\t\tcopy.args = append([]string(nil), item.args...)\n\t\tcopy.stdout = append([]byte(nil), item.stdout...)\n\t\tcopy.stderr = append([]byte(nil), item.stderr...)\n\t\tcopy.producers = cloneBoolMap(item.producers)\n\t\tobservations = append(observations, copy)\n\t}\n\tstate.mu.Unlock()\n\tsort.Slice(observations, func(i, j int) bool {\n\t\tleft := governanceGitObservationKey(observations[i].root, observations[i].args, observations[i].maxOutputBytes)\n\t\tright := governanceGitObservationKey(observations[j].root, observations[j].args, observations[j].maxOutputBytes)\n\t\treturn left < right\n\t})\n\tremaining := int64(governanceReadViewMaxInputBytes)\n\theads := map[string]string{}\n\tfor _, item := range observations {\n\t\tif item.pure {\n\t\t\tif item.headAt == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tnow, read := heads[item.root]\n\t\t\tif !read {\n\t\t\t\tnow = governanceHeadAt(item.ctx, item.files, item.root)\n\t\t\t\theads[item.root] = now\n\t\t\t}\n\t\t\tif now == item.headAt {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif remaining <= 0 {\n\t\t\tfor producer := range item.producers {\n\t\t\t\tresult.UnknownProducers[producer] = appendUnique(result.UnknownProducers[producer], \"Git final audit exceeded its shared byte budget\")\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tlimit := item.maxOutputBytes\n\t\tif remaining < limit {\n\t\t\tlimit = remaining\n\t\t}\n\t\tauditContext := item.ctx\n\t\tcancelAuditContext := func() {}\n\t\tif item.hasDeadline {\n\t\t\tauditContext, cancelAuditContext = context.WithDeadline(auditContext, item.deadline