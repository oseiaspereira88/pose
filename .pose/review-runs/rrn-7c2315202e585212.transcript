{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2..25743a09 -- pose-mcp/internal/cli/setup.go pose-mcp/internal/cli/adopt.go'","aggregated_output":"diff --git a/pose-mcp/internal/cli/adopt.go b/pose-mcp/internal/cli/adopt.go\nindex ef6fa10f..c133ce96 100644\n--- a/pose-mcp/internal/cli/adopt.go\n+++ b/pose-mcp/internal/cli/adopt.go\n@@ -19,10 +19,11 @@ import (\n \t\"github.com/harne8/pose-mcp/internal/version\"\n )\n \n-const adoptUsage = \"Usage: pose adopt --list [--json] | pose adopt <capability> [--off | --decline --reason <text> | --defer --reason <text>] [--date YYYY-MM-DD] [--issuer <name>] [--apply] | pose adopt --request <act-id> [--issuer <name>] [--reason <text>] [--apply]\"\n+const adoptUsage = \"Usage: pose adopt --list [--json] | pose adopt <capability> [--off | --decline --reason <text> | --defer --reason <text>] [--date YYYY-MM-DD] [--issuer <name>] [--apply] | pose adopt closeout-review-policy --milestone-review-required <never|when-justified|always> --roadmap-review-required <never|when-justified|always> [--apply] | pose adopt --request <act-id> [--issuer <name>] [--reason <text>] [--apply]\"\n \n func cmdAdopt(root string, args []string, stdout, stderr io.Writer) int {\n \tid, mode, reason, apply, list, jsonOutput, requestID, issuer := \"\", \"on\", \"\", false, false, false, \"\", \"\"\n+\tmilestoneReview, roadmapReview, closeoutPairGiven := \"\", \"\", false\n \tdate := time.Now().UTC().Format(time.DateOnly)\n \tfor i := 0; i < len(args); i++ {\n \t\tswitch args[i] {\n@@ -38,6 +39,17 @@ func cmdAdopt(root string, args []string, stdout, stderr io.Writer) int {\n \t\t\tmode = posemodel.AdoptionDeferred\n \t\tcase \"--apply\":\n \t\t\tapply = true\n+\t\tcase \"--milestone-review-required\", \"--roadmap-review-required\":\n+\t\t\tif i+1 >= len(args) {\n+\t\t\t\treturn usageError(stderr, adoptUsage)\n+\t\t\t}\n+\t\t\tif args[i] == \"--milestone-review-required\" {\n+\t\t\t\tmilestoneReview = args[i+1]\n+\t\t\t} else {\n+\t\t\t\troadmapReview = args[i+1]\n+\t\t\t}\n+\t\t\tcloseoutPairGiven = true\n+\t\t\ti++\n \t\tcase \"--date\", \"--reason\", \"--request\", \"--issuer\":\n \t\t\tif i+1 >= len(args) {\n \t\t\t\treturn usageError(stderr, adoptUsage)\n@@ -132,6 +144,13 @@ func cmdAdopt(root string, args []string, stdout, stderr io.Writer) int {\n \tif id == \"\" {\n \t\treturn usageError(stderr, adoptUsage)\n \t}\n+\t// The closeout review pair is set together, only for its own capability,\n+\t// and only to turn it on or change it (spec\n+\t// pose-closeout-review-policy-by-cost-benefit R6).\n+\tif closeoutPairGiven && (id != \"closeout-review-policy\" || mode != \"on\" || milestoneReview == \"\" || roadmapReview == \"\") {\n+\t\tout.Failure(\"pose adopt: --milestone-review-required and --roadmap-review-required go together, with closeout-review-policy, without --off, --decline or --defer\")\n+\t\treturn 2\n+\t}\n \tentry, known := posemodel.LookupCatalogEntry(id)\n \tif !known {\n \t\tout.Failure(\"pose adopt: unknown capability \" + id + \"; governed capabilities: \" + strings.Join(posemodel.CatalogIDs(), \", \"))\n@@ -186,7 +205,21 @@ func cmdAdopt(root string, args []string, stdout, stderr io.Writer) int {\n \t\t\t\treturn 1\n \t\t\t}\n \t\t}\n-\t\tchanges = entry.Adopt(docs, date)\n+\t\tif id == \"closeout-review-policy\" {\n+\t\t\t// Preview shows the rule applied today next to the one proposed.\n+\t\t\t_, milestoneNow, roadmapNow := posemodel.CloseoutReviewPolicyEffective(docs)\n+\t\t\tout.Field(\"adopt.current\", posemodel.MilestoneReviewRequiredKey+\"=\"+milestoneNow+\"; \"+posemodel.RoadmapReviewRequiredKey+\"=\"+roadmapNow)\n+\t\t}\n+\t\tif closeoutPairGiven {\n+\t\t\tpair, err := posemodel.SetCloseoutReviewPolicy(docs, milestoneReview, roadmapReview)\n+\t\t\tif err != nil {\n+\t\t\t\tout.Failure(\"pose adopt: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n+\t\t\t\treturn 2\n+\t\t\t}\n+\t\t\tchanges = pair\n+\t\t} else {\n+\t\t\tchanges = entry.Adopt(docs, date)\n+\t\t}\n \t}\n \tvar effects []posemodel.AdoptionEffect\n \tif mode == \"on\" && len(changes) > 0 {\ndiff --git a/pose-mcp/internal/cli/setup.go b/pose-mcp/internal/cli/setup.go\nindex 9d48840c..501849ed 100644\n--- a/pose-mcp/internal/cli/setup.go\n+++ b/pose-mcp/internal/cli/setup.go\n@@ -65,10 +65,22 @@ type setupPlan struct {\n \tNeedsSetup      []posemodel.CapabilityState `json:\"needs_setup\"`\n \tAvailable       []string                    `json:\"available\"`\n \tOnboarding      string                      `json:\"onboarding_spec,omitempty\"`\n+\tCloseoutReview  setupCloseoutReview         `json:\"closeout_review\"`\n \tSteps           []setupStep                 `json:\"steps\"`\n \tNext            *setupStep                  `json:\"next,omitempty\"`\n }\n \n+// setupCloseoutReview shows the closeout review rule in force and the pair an\n+// adoption would write (spec pose-closeout-review-policy-by-cost-benefit R6).\n+type setupCloseoutReview struct {\n+\tAdopted           bool   `json:\"adopted\"`\n+\tMilestone         string `json:\"milestone_review_required\"`\n+\tRoadmap           string `json:\"roadmap_review_required\"`\n+\tProposedMilestone string `json:\"proposed_milestone_review_required,omitempty\"`\n+\tProposedRoadmap   string `json:\"proposed_roadmap_review_required,omitempty\"`\n+\tCommand           string `json:\"command\"`\n+}\n+\n // candidateKeyFile returns the user's public key POSE would suggest\n // registering, preferring a security key.\n func candidateKeyFile() string {\n@@ -135,6 +147,14 @@ func buildSetupPlan(root string) (setupPlan, error) {\n \tif err != nil {\n \t\treturn plan, err\n \t}\n+\tif docs, err := posemodel.LoadPolicyDocs(root); err == nil {\n+\t\tadopted, milestone, roadmap := posemodel.CloseoutReviewPolicyEffective(docs)\n+\t\tplan.CloseoutReview = setupCloseoutReview{Adopted: adopted, Milestone: milestone, Roadmap: roadmap,\n+\t\t\tCommand: \"pose adopt closeout-review-policy --milestone-review-required <never|when-justified|always> --roadmap-review-required <never|when-justified|always> --apply\"}\n+\t\tif !adopted {\n+\t\t\tplan.CloseoutReview.ProposedMilestone, plan.CloseoutReview.ProposedRoadmap = posemodel.CloseoutReviewNever, posemodel.CloseoutReviewNever\n+\t\t}\n+\t}\n \tisNew := map[string]bool{}\n \tfor _, state := range review {\n \t\tisNew[state.ID] = true\n@@ -396,6 +416,14 @@ func renderSetupPlan(rawField func(string, string), section func(string), plan s\n \tfor _, state := range plan.NeedsSetup {\n \t\tfield(\"setup.needs_setup.\"+state.ID, state.Missing)\n \t}\n+\tif closeout := plan.CloseoutReview; closeout.Milestone != \"\" {\n+\t\tline := \"milestone_review_required=\" + closeout.Milestone + \"; roadmap_review_required=\" + closeout.Roadmap\n+\t\tif !closeout.Adopted {\n+\t\t\tline += \" — adopting proposes milestone_review_required=\" + closeout.ProposedMilestone + \", roadmap_review_required=\" + closeout.ProposedRoadmap\n+\t\t}\n+\t\trawField(\"setup.closeout_review\", line)\n+\t\trawField(\"setup.closeout_review.command\", closeout.Command)\n+\t}\n \tif len(plan.Available) > 0 {\n \t\tsort.Strings(plan.Available)\n \t\tfield(\"setup.available\", strings.Join(plan.Available, \", \")+\" — off; `pose adopt --list` explains each\")\n@@ -489,7 +517,19 @@ func runSetupInteractive(root string, plan setupPlan, in *bufio.Reader, stdout,\n \t\t\tanswer := strings.ToLower(ask(step.Summary + \"\\n  [a]dopt, [d]ecline, [l]ater (defer), [s]kip? \"))\n \t\t\tswitch answer {\n \t\t\tcase \"a\", \"adopt\":\n-\t\t\t\tif code := cmdAdopt(root, []string{step.capability, \"--apply\"}, stdout, stderr); code != 0 {\n+\t\t\t\targs := []string{step.capability, \"--apply\"}\n+\t\t\t\tif step.capability == \"closeout-review-policy\" {\n+\t\t\t\t\t// The pair is chosen here and written by the same operation.\n+\t\t\t\t\tchoose := func(key string) string {\n+\t\t\t\t\t\tvalue := strings.TrimSpace(ask(\"  \" + key + \" [never|when-justified|always] (never)? \"))\n+\t\t\t\t\t\tif value == \"\" {\n+\t\t\t\t\t\t\tvalue = posemodel.CloseoutReviewNever\n+\t\t\t\t\t\t}\n+\t\t\t\t\t\treturn value\n+\t\t\t\t\t}\n+\t\t\t\t\targs = []string{step.capability, \"--milestone-review-required\", choose(\"milestone_review_required\"), \"--roadmap-review-required\", choose(\"roadmap_review_required\"), \"--apply\"}\n+\t\t\t\t}\n+\t\t\t\tif code := cmdAdopt(root, args, stdout, stderr); code != 0 {\n \t\t\t\t\treturn code\n \t\t\t\t}\n \t\t\t\tdecided = true\n","exit_code":0,"status":"completed"}}
