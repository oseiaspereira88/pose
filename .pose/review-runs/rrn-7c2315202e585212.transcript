{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/cli/review_closeout.go'","aggregated_output":"     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"crypto/sha256\"\n     6\t\t\"encoding/hex\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"fmt\"\n    10\t\t\"io\"\n    11\t\t\"net/url\"\n    12\t\t\"os\"\n    13\t\t\"path/filepath\"\n    14\t\t\"slices\"\n    15\t\t\"sort\"\n    16\t\t\"strings\"\n    17\t\t\"time\"\n    18\t\n    19\t\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n    20\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    21\t)\n    22\t\n    23\tfunc cliGovernedStore(root string) posemodel.Store {\n    24\t\tstore := posemodel.Store{Root: root}\n    25\t\tresolver, project, err := posemodel.EnvironmentArtifactResolver(root, \"\")\n    26\t\tif err != nil {\n    27\t\t\tstore.FederatedResolver = &posemodel.ArtifactResolver{}\n    28\t\t\treturn store\n    29\t\t}\n    30\t\tstore.FederatedProjectID = project\n    31\t\tstore.FederatedResolver = &resolver\n    32\t\treturn store\n    33\t}\n    34\t\n    35\t// cliReviewStore keeps the authority resolver selected from the caller's root.\n    36\t// Reconstructing it at a foreign root would apply the caller's default project\n    37\t// identity to that root and lose the authorized federation context.\n    38\tfunc cliReviewStore(root, ref string) (posemodel.Store, string, error) {\n    39\t\tcontext, resolver, _, err := cliAgentContext(root, ref)\n    40\t\tqualified := strings.HasPrefix(ref, \"xref:\")\n    41\t\tif err != nil {\n    42\t\t\tif qualified {\n    43\t\t\t\treturn posemodel.Store{}, \"\", err\n    44\t\t\t}\n    45\t\t\treturn cliGovernedStore(root), ref, nil\n    46\t\t}\n    47\t\tif context.TaskResolution != nil && context.TaskResolution.State == \"transfer-in-progress\" {\n    48\t\t\treturn posemodel.Store{}, \"\", fmt.Errorf(\"transfer-in-progress\")\n    49\t\t}\n    50\t\tif context.TaskResolution == nil || !context.TaskResolution.Resolved || context.Authority == nil {\n    51\t\t\tif qualified {\n    52\t\t\t\tstate := \"unknown-artifact\"\n    53\t\t\t\tif context.TaskResolution != nil {\n    54\t\t\t\t\tstate = context.TaskResolution.State\n    55\t\t\t\t}\n    56\t\t\t\treturn posemodel.Store{}, \"\", fmt.Errorf(\"task-authority-unavailable: %s\", state)\n    57\t\t\t}\n    58\t\t\treturn cliGovernedStore(root), ref, nil\n    59\t\t}\n    60\t\tif !qualified && !context.TaskResolution.Redirected {\n    61\t\t\treturn cliGovernedStore(root), ref, nil\n    62\t\t}\n    63\t\tstore, err := resolver.Roots.StoreFor(context.Authority.Project)\n    64\t\tif err != nil {\n    65\t\t\treturn posemodel.Store{}, \"\", fmt.Errorf(\"task-authority-unavailable\")\n    66\t\t}\n    67\t\tstore.FederatedProjectID, store.FederatedResolver = context.Authority.Project, &resolver\n    68\t\treturn store, scopeRefForArtifact(*context.Authority), nil\n    69\t}\n    70\t\n    71\tfunc cmdReviewCheck(root string, args []string, stdout, stderr io.Writer) int {\n    72\t\tref, jsonOutput, ok := parseScopeCheckArgs(\"review-check\", args, stderr)\n    73\t\tif !ok {\n    74\t\t\treturn 2\n    75\t\t}\n    76\t\tstore, localRef, err := cliReviewStore(root, ref)\n    77\t\tif err != nil {\n    78\t\t\trender(io.Discard, stderr).Failure(\"pose review-check: \" + err.Error())\n    79\t\t\treturn 1\n    80\t\t}\n    81\t\troot, ref = store.Root, localRef\n    82\t\teval, err := store.ReviewCheck(ref)\n    83\t\tif err != nil {\n    84\t\t\tfmt.Fprintf(stderr, \"pose review-check: %v\\n\", err)\n    85\t\t\treturn 1\n    86\t\t}\n    87\t\tif jsonOutput {\n    88\t\t\tif code := writeJSON(stdout, eval); code != 0 {\n    89\t\t\t\treturn code\n    90\t\t\t}\n    91\t\t\tif eval.Required && !eval.Approved {\n    92\t\t\t\treturn 1\n    93\t\t\t}\n    94\t\t\treturn 0\n    95\t\t}\n    96\t\tfmt.Fprintf(stdout, \"review.scope=%s\\nreview.required=%t\\nreview.profile=%s\\nreview.digest=%s\\nreview.fresh=%t\\nreview.approved=%t\\n\", eval.Scope, eval.Required, eval.Profile, eval.ScopeDigest, eval.Fresh, eval.Approved)\n    97\t\tif eval.ReadView != nil {\n    98\t\t\trender(stdout, stderr).Field(\"review.read_view\", fmt.Sprintf(\"id:%s freshness:%s roots:%d inputs:%d bytes:%d\",\n    99\t\t\t\teval.ReadView.ID, eval.ReadView.Freshness, len(eval.ReadView.Bindings), eval.ReadView.ObservedInputs, eval.ReadView.InputBytes))\n   100\t\t}\n   101\t\tif eval.Assurance != nil {\n   102\t\t\trender(stdout, stderr).Field(\"review.assurance\", posemodel.RenderReviewAssurance(*eval.Assurance))\n   103\t\t}\n   104\t\tfor _, warning := range eval.Warnings {\n   105\t\t\tfmt.Fprintf(stdout, \"[WARN] %s\\n\", warning)\n   106\t\t}\n   107\t\tfor _, blocker := range eval.Blockers {\n   108\t\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n   109\t\t}\n   110\t\tif eval.Required && !eval.Approved {\n   111\t\t\treturn 1\n   112\t\t}\n   113\t\treturn 0\n   114\t}\n   115\t\n   116\tfunc cmdReviewPlan(root string, args []string, stdout, stderr io.Writer) int {\n   117\t\tref, jsonOutput, explain := \"\", false, false\n   118\t\tfor _, arg := range args {\n   119\t\t\tswitch arg {\n   120\t\t\tcase \"--json\":\n   121\t\t\t\tjsonOutput = true\n   122\t\t\tcase \"--explain\":\n   123\t\t\t\texplain = true\n   124\t\t\tdefault:\n   125\t\t\t\tif strings.HasPrefix(arg, \"-\") || ref != \"\" {\n   126\t\t\t\t\tfmt.Fprintln(stderr, \"Usage: pose review-plan <spec:slug|milestone:roadmap/id|roadmap:slug> [--json] [--explain]\")\n   127\t\t\t\t\treturn 2\n   128\t\t\t\t}\n   129\t\t\t\tref = arg\n   130\t\t\t}\n   131\t\t}\n   132\t\tif ref == \"\" {\n   133\t\t\tfmt.Fprintln(stderr, \"Usage: pose review-plan <spec:slug|milestone:roadmap/id|roadmap:slug> [--json] [--explain]\")\n   134\t\t\treturn 2\n   135\t\t}\n   136\t\tstore, localRef, err := cliReviewStore(root, ref)\n   137\t\tif err != nil {\n   138\t\t\trender(io.Discard, stderr).Failure(\"pose review-plan: \" + err.Error())\n   139\t\t\treturn 1\n   140\t\t}\n   141\t\troot, ref = store.Root, localRef\n   142\t\tplan, err := store.ReviewPlan(ref)\n   143\t\tif err != nil {\n   144\t\t\tfmt.Fprintf(stderr, \"pose review-plan: %v\\n\", err)\n   145\t\t\treturn 1\n   146\t\t}\n   147\t\tif jsonOutput {\n   148\t\t\tif code := writeJSON(stdout, plan); code != 0 {\n   149\t\t\t\treturn code\n   150\t\t\t}\n   151\t\t\tif len(plan.Blockers) > 0 {\n   152\t\t\t\treturn 1\n   153\t\t\t}\n   154\t\t\treturn 0\n   155\t\t}\n   156\t\tfmt.Fprintf(stdout, \"review_plan.scope=%s\\nreview_plan.scope_digest=%s\\nreview_plan.plan_digest=%s\\nreview_plan.base_profile=%s\\nreview_plan.independence=%s\\nreview_plan.band=%s\\nreview_plan.components=%d\\nreview_plan.criteria=%d\\nreview_plan.tools=%d\\n\", plan.Scope, plan.ScopeDigest, plan.PlanDigest, plan.BaseProfile, plan.Independence, plan.Band, len(plan.Components), len(plan.Criteria), len(plan.Tools))\n   157\t\t// The plan states the separation it requires; whether that separation can\n   158\t\t// be authenticated depends on the identity assurance in force, which the\n   159\t\t// plan digest deliberately does not include (spec\n   160\t\t// pose-review-assurance-disclosure).\n   161\t\tif scope, scopeErr := posemodel.ParseScopeRef(plan.Scope); scopeErr == nil {\n   162\t\t\tif policy, policyErr := (posemodel.Store{Root: root}).GetReviewPolicy(); policyErr == nil {\n   163\t\t\t\tassurance := policy.ReviewIdentityAssurance(scope.Kind)\n   164\t\t\t\tmeaning := \"the reviewer identity is the string the reviewer writes; the required separation will be declared, not authenticated\"\n   165\t\t\t\tif assurance == posemodel.ReviewIdentityAssuranceVerified {\n   166\t\t\t\t\tmeaning = \"the reviewer identity and separation must be established by a signed authority claim bound to the bundle\"\n   167\t\t\t\t}\n   168\t\t\t\trender(stdout, stderr).Field(\"review_plan.identity_assurance\", assurance+\" (\"+meaning+\")\")\n   169\t\t\t}\n   170\t\t}\n   171\t\t// The forecast and the observed expansion print without --explain: a\n   172\t\t// reviewer who never asks for the long form still has to see that the\n   173\t\t// obligations in front of them came from scope nobody declared. These lines\n   174\t\t// go through the renderer, which is also what the output ratchet requires.\n   175\t\tout := render(stdout, stderr)\n   176\t\tout.Field(\"projection.basis\", fmt.Sprintf(\"%s band=%s independence=%s scope_expanded=%t\", plan.Projection.Basis, plan.Projection.Band, plan.Projection.Independence, plan.Projection.ScopeExpanded))\n   177\t\tif plan.Projection.ScopeExpanded || plan.Projection.RaisedIndependence != \"\" || plan.Projection.RaisedBand != \"\" {\n   178\t\t\tout.Field(\"projection.expansion\", fmt.Sprintf(\"observed_components:%s added_profiles:%s added_criteria:%s added_tools:%s raised_independence:%s raised_band:%s\",\n   179\t\t\t\tstrings.Join(plan.Projection.ObservedComponents, \",\"), strings.Join(plan.Projection.AddedProfiles, \",\"),\n   180\t\t\t\tstrings.Join(plan.Projection.AddedCriteria, \",\"), strings.Join(plan.Projection.AddedTools, \",\"),\n   181\t\t\t\tplan.Projection.RaisedIndependence, plan.Projection.RaisedBand))\n   182\t\t}\n   183\t\tfor _, band := range plan.Bands {\n   184\t\t\tif band.Band == posemodel.ReviewBandUnknown {\n   185\t\t\t\tout.Field(\"projection.undecided\", fmt.Sprintf(\"trigger:%s source:%s policy:%s\", band.Trigger, band.Source, band.Policy))\n   186\t\t\t}\n   187\t\t}\n   188\t\t// The material facts are what a criterion answering for observed structure\n   189\t\t// owes an answer for, so their ids are printed, not just counted: they are\n   190\t\t// the values the reviewer passes back to `review attest --mapping`.\n   191\t\tif plan.Structure != nil {\n   192\t\t\tout.Field(\"structure\", fmt.Sprintf(\"observed:%t status:%s kinds:%s material:%d unknown:%d reason:%s\",\n   193\t\t\t\tplan.Structure.Observed, plan.Structure.Status, strings.Join(plan.Structure.Kinds, \",\"),\n   194\t\t\t\tlen(plan.Structure.Material), len(plan.Structure.Unknown), plan.Structure.Reason))\n   195\t\t\tfor _, fact := range plan.Structure.Material {\n   196\t\t\t\tout.Field(\"structure.\"+fact.ID, fmt.Sprintf(\"kind:%s action:%s subject:%s path:%s runtime:%s\", fact.Kind, fact.Action, fact.Subject, fact.Path, fact.Runtime))\n   197\t\t\t}\n   198\t\t\tfor _, unknown := range plan.Structure.Unknown {\n   199\t\t\t\tout.Field(\"structure.unknown\", unknown)\n   200\t\t\t}\n   201\t\t}\n   202\t\t// A contract change governed by its own weakened contract is the one thing a\n   203\t\t// reviewer must not have to ask for.\n   204\t\tif len(plan.PolicyBaseline.Paths) > 0 {\n   205\t\t\tout.Field(\"policy_baseline\", fmt.Sprintf(\"protected:%t revision:%s paths:%s reason:%s\", plan.PolicyBaseline.Protected, plan.PolicyBaseline.Revision, strings.Join(plan.PolicyBaseline.Paths, \",\"), plan.PolicyBaseline.Reason))\n   206\t\t\tif len(plan.PolicyBaseline.Weakened) > 0 || len(plan.PolicyBaseline.Restored) > 0 {\n   207\t\t\t\tout.Field(\"policy_baseline.contract\", fmt.Sprintf(\"weakened:%s restored:%s\", strings.Join(plan.PolicyBaseline.Weakened, \",\"), strings.Join(plan.PolicyBaseline.Restored, \",\")))\n   208\t\t\t}\n   209\t\t}\n   210\t\tfor _, warning := range groupedReviewPlanWarnings(plan.Warnings) {\n   211\t\t\tfmt.Fprintf(stdout, \"[WARN] %s\\n\", warning)\n   212\t\t}\n   213\t\tfor _, blocker := range plan.Blockers {\n   214\t\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n   215\t\t}\n   216\t\tif explain {\n   217\t\t\tfor _, event := range plan.Explain {\n   218\t\t\t\tfmt.Fprintf(stdout, \"explain=%s\\n\", event)\n   219\t\t\t}\n   220\t\t\tfor _, band := range plan.Bands {\n   221\t\t\t\tout.Field(\"band.\"+band.Band, fmt.Sprintf(\"trigger:%s basis:%s source:%s policy:%s obligations:%s\", band.Trigger, band.Basis, band.Source, band.Policy, strings.Join(band.Obligations, \",\")))\n   222\t\t\t}\n   223\t\t\tfor _, component := range plan.Components {\n   224\t\t\t\tout.Field(\"component.\"+component.Path, fmt.Sprintf(\"origin:%s criticality:%s metadata:%s sources:%s\", component.Origin, component.Criticality, component.MetadataStatus, strings.Join(component.Sources, \",\")))\n   225\t\t\t}\n   226\t\t\tfor _, profile := range plan.SelectedProfiles {\n   227\t\t\t\tfmt.Fprintf(stdout, \"profile.%s=order:%d category:%s source:%s components:%s rationale:%s\\n\", profile.Ref, profile.Order, profile.Category, profile.Source, strings.Join(profile.Components, \",\"), profile.Rationale)\n   228\t\t\t}\n   229\t\t\tfor _, criterion := range plan.Criteria {\n   230\t\t\t\tfmt.Fprintf(stdout, \"criterion.%s=required:%t structural_mapping:%t profiles:%s rules:%s evidence:%s\\n\", criterion.ID, criterion.Required, criterion.RequiresStructuralMapping, strings.Join(criterion.Profiles, \",\"), strings.Join(criterion.Rules, \",\"), strings.Join(criterion.EvidenceClasses, \",\"))\n   231\t\t\t}\n   232\t\t\tfor _, item := range actionableReviewPlanTools(plan.Tools) {\n   233\t\t\t\ttool := item.Tool\n   234\t\t\t\tfmt.Fprintf(stdout, \"tool.%s.%s=requiredness:%s args:%s preconditions:%s criteria:%s evidence:%s rationale:%s\\n\", item.Phase, tool.ID, tool.Requiredness, strings.Join(tool.Args, \" \"), strings.Join(tool.Preconditions, \",\"), strings.Join(tool.Criteria, \",\"), strings.Join(tool.EvidenceClasses, \",\"), tool.Rationale)\n   235\t\t\t}\n   236\t\t}\n   237\t\tif len(plan.Blockers) > 0 {\n   238\t\t\treturn 1\n   239\t\t}\n   240\t\treturn 0\n   241\t}\n   242\t\n   243\tfunc groupedReviewPlanWarnings(warnings []string) []string {\n   244\t\tgroups := map[string][]string{}\n   245\t\tplain := []string{}\n   246\t\tfor _, warning := range warnings {\n   247\t\t\tif strings.HasPrefix(warning, \"unmapped review component \") {\n   248\t\t\t\tgroups[\"unmapped-review-component\"] = append(groups[\"unmapped-review-component\"], strings.TrimPrefix(warning, \"unmapped review component \"))\n   249\t\t\t} else {\n   250\t\t\t\tplain = append(plain, warning)\n   251\t\t\t}\n   252\t\t}\n   253\t\tresult := append([]string{}, plain...)\n   254\t\tfor code, values := range groups {\n   255\t\t\tsort.Strings(values)\n   256\t\t\trepresentative := values\n   257\t\t\tif len(representative) > 3 {\n   258\t\t\t\trepresentative = representative[:3]\n   259\t\t\t}\n   260\t\t\tresult = append(result, fmt.Sprintf(\"%s count=%d examples=%s\", code, len(values), strings.Join(representative, \",\")))\n   261\t\t}\n   262\t\tsort.Strings(result)\n   263\t\treturn result\n   264\t}\n   265\t\n   266\ttype actionableReviewTool struct {\n   267\t\tPhase string\n   268\t\tTool  posemodel.ReviewPlanTool\n   269\t}\n   270\t\n   271\tfunc actionableReviewPlanTools(tools []posemodel.ReviewPlanTool) []actionableReviewTool {\n   272\t\tresult := []actionableReviewTool{}\n   273\t\tseen := map[string]bool{}\n   274\t\tfor _, tool := range tools {\n   275\t\t\tphase := \"recommended\"\n   276\t\t\tif containsCLIReviewValue(tool.Preconditions, \"review-complete\") {\n   277\t\t\t\tphase = \"completion-deferred\"\n   278\t\t\t} else if tool.Requiredness == \"required\" {\n   279\t\t\t\tphase = \"required\"\n   280\t\t\t}\n   281\t\t\tkey := phase + \"\\x00\" + strings.Join(tool.Args, \"\\x00\")\n   282\t\t\tif seen[key] {\n   283\t\t\t\tcontinue\n   284\t\t\t}\n   285\t\t\tseen[key] = true\n   286\t\t\tresult = append(result, actionableReviewTool{Phase: phase, Tool: tool})\n   287\t\t}\n   288\t\torder := map[string]int{\"required\": 0, \"recommended\": 1, \"completion-deferred\": 2}\n   289\t\tsort.SliceStable(result, func(i, j int) bool {\n   290\t\t\tif order[result[i].Phase] != order[result[j].Phase] {\n   291\t\t\t\treturn order[result[i].Phase] < order[result[j].Phase]\n   292\t\t\t}\n   293\t\t\treturn result[i].Tool.ID < result[j].Tool.ID\n   294\t\t})\n   295\t\treturn result\n   296\t}\n   297\t\n   298\tfunc cmdCloseoutCheck(root string, args []string, stdout, stderr io.Writer) int {\n   299\t\tref, jsonOutput, ok := parseScopeCheckArgs(\"closeout-check\", args, stderr)\n   300\t\tif !ok {\n   301\t\t\treturn 2\n   302\t\t}\n   303\t\tstore, localRef, err := cliReviewStore(root, ref)\n   304\t\tif err != nil {\n   305\t\t\trender(io.Discard, stderr).Failure(\"pose closeout-check: \" + err.Error())\n   306\t\t\treturn 1\n   307\t\t}\n   308\t\troot, ref = store.Root, localRef\n   309\t\tstate, err := cliCloseoutStateForStore(store, ref)\n   310\t\tif err != nil {\n   311\t\t\tfmt.Fprintf(stderr, \"pose closeout-check: %v\\n\", err)\n   312\t\t\treturn 1\n   313\t\t}\n   314\t\tif jsonOutput {\n   315\t\t\tif code := writeJSON(stdout, state); code != 0 {\n   316\t\t\t\treturn code\n   317\t\t\t}\n   318\t\t\tif !state.Terminal {\n   319\t\t\t\treturn 1\n   320\t\t\t}\n   321\t\t\treturn 0\n   322\t\t}\n   323\t\tfmt.Fprintf(stdout, \"closeout.scope=%s\\ncloseout.digest=%s\\ncloseout.lifecycle_done=%t\\ncloseout.review_approved=%t\\ncloseout.terminal=%t\\ncloseout.next_action=%s\\n\", state.Scope, state.ScopeDigest, state.LifecycleDone, state.Review.Approved, state.Terminal, state.NextAction)\n   324\t\tif state.Review.Assurance != nil {\n   325\t\t\trender(stdout, stderr).Field(\"closeout.review_assurance\", posemodel.RenderReviewAssurance(*state.Review.Assurance))\n   326\t\t}\n   327\t\tfor _, blocker := range state.Blockers {\n   328\t\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n   329\t\t}\n   330\t\tif !state.Terminal {\n   331\t\t\treturn 1\n   332\t\t}\n   333\t\treturn 0\n   334\t}\n   335\t\n   336\tfunc cliCloseoutState(root, ref string) (posemodel.CloseoutState, error) {\n   337\t\treturn cliCloseoutStateIn(root, ref, posemodel.NativeFiles())\n   338\t}\n   339\t\n   340\tfunc cliCloseoutStateIn(root, ref string, files posemodel.Files) (posemodel.CloseoutState, error) {\n   341\t\tfiles = posemodel.FilesOrNative(files)\n   342\t\tresolver, project, err := posemodel.EnvironmentArtifactResolverIn(files, root, \"\")\n   343\t\tif err != nil {\n   344\t\t\treturn posemodel.CloseoutState{}, fmt.Errorf(\"invalid project configuration\")\n   345\t\t}\n   346\t\tstore := posemodel.Store{Root: root, FS: files, FederatedProjectID: project, FederatedResolver: &resolver}\n   347\t\treturn cliCloseoutStateForStore(store, ref)\n   348\t}\n   349\t\n   350\t// cliCloseoutStateForStore evaluates through the selected Store binding. A\n   351\t// guarded close must keep its project resolver and guarded root overlay; only\n   352\t// the root-only compatibility helper above reconstructs a CLI resolver.\n   353\tfunc cliCloseoutStateForStore(store posemodel.Store, ref string) (posemodel.CloseoutState, error) {\n   354\t\tscope, err := posemodel.ParseScopeRef(ref)\n   355\t\tif err != nil {\n   356\t\t\treturn posemodel.CloseoutState{}, err\n   357\t\t}\n   358\t\tif scope.Kind != \"roadmap\" && scope.Kind != \"milestone\" {\n   359\t\t\treturn store.GetCloseoutState(ref)\n   360\t\t}\n   361\t\tproject := store.FederatedProjectID\n   362\t\tif project == \"\" {\n   363\t\t\tproject, err = store.WriteProjectID()\n   364\t\t\tif err != nil {\n   365\t\t\t\treturn posemodel.CloseoutState{}, fmt.Errorf(\"invalid project configuration\")\n   366\t\t\t}\n   367\t\t}\n   368\t\tresolver := store.FederatedResolver\n   369\t\tif resolver == nil {\n   370\t\t\tvalue, _, resolverErr := posemodel.EnvironmentArtifactResolverIn(store.FS, store.Root, \"\")\n   371\t\t\tif resolverErr != nil {\n   372\t\t\t\treturn posemodel.CloseoutState{}, fmt.Errorf(\"invalid project configuration\")\n   373\t\t\t}\n   374\t\t\tresolver = &value\n   375\t\t}\n   376\t\treturn store.GetCloseoutStateWithFederatedAcceptance(ref, project, *resolver)\n   377\t}\n   378\t\n   379\tfunc parseScopeCheckArgs(command string, args []string, stderr io.Writer) (string, bool, bool) {\n   380\t\tjsonFlag := \" [--json]\"\n   381\t\tif command == \"close\" {\n   382\t\t\tjsonFlag = \"\"\n   383\t\t}\n   384\t\tjsonOutput := false\n   385\t\tref := \"\"\n   386\t\tfor _, arg := range args {\n   387\t\t\tswitch arg {\n   388\t\t\tcase \"--json\":\n   389\t\t\t\tjsonOutput = true\n   390\t\t\tdefault:\n   391\t\t\t\tif strings.HasPrefix(arg, \"-\") || ref != \"\" {\n   392\t\t\t\t\tfmt.Fprintf(stderr, \"Usage: pose %s <spec:slug|milestone:roadmap/id|roadmap:slug>%s\\n\", command, jsonFlag)\n   393\t\t\t\t\treturn \"\", false, false\n   394\t\t\t\t}\n   395\t\t\t\tref = arg\n   396\t\t\t}\n   397\t\t}\n   398\t\tif ref == \"\" {\n   399\t\t\tfmt.Fprintf(stderr, \"Usage: pose %s <spec:slug|milestone:roadmap/id|roadmap:slug>%s\\n\", command, jsonFlag)\n   400\t\t\treturn \"\", false, false\n   401\t\t}\n   402\t\treturn ref, jsonOutput, true\n   403\t}\n   404\t\n   405\tfunc writeJSON(w io.Writer, value any) int {\n   406\t\tenc := json.NewEncoder(w)\n   407\t\tenc.SetIndent(\"\", \"  \")\n   408\t\tif err := enc.Encode(value); err != nil {\n   409\t\t\treturn 1\n   410\t\t}\n   411\t\treturn 0\n   412\t}\n   413\t\n   414\tfunc cmdReview(root string, args []string, stdout, stderr io.Writer) int {\n   415\t\tif len(args) == 0 {\n   416\t\t\tfmt.Fprintln(stderr, \"Usage: pose review <bundle|brief|attest|auto-attest|verify|record|attribution-supplement> ...\")\n   417\t\t\treturn 2\n   418\t\t}\n   419\t\tif code, handled := routeQualifiedReviewScope(root, args, stdout, stderr); handled {\n   420\t\t\treturn code\n   421\t\t}\n   422\t\tswitch args[0] {\n   423\t\tcase \"bundle\":\n   424\t\t\treturn cmdReviewBundle(root, args[1:], stdout, stderr)\n   425\t\tcase \"brief\":\n   426\t\t\treturn cmdReviewBrief(root, args[1:], stdout, stderr)\n   427\t\tcase \"run-sign\":\n   428\t\t\treturn cmdReviewRunSign(root, args[1:], stdout, stderr)\n   429\t\tcase \"run-proof\":\n   430\t\t\treturn cmdReviewRunProof(root, args[1:], stdout, stderr)\n   431\t\tcase \"conclude\":\n   432\t\t\treturn cmdReviewConclude(root, args[1:], stdout, stderr)\n   433\t\tcase \"request\":\n   434\t\t\treturn cmdReviewRequest(root, args[1:], stdout, stderr)\n   435\t\t// The aliases pose-delegation-surface deprecated are removed (spec\n   436\t\t// pose-delegation-parity-gate R6, D2): each names its replacement and runs\n   437\t\t// nothing.\n   438\t\tcase \"resume\", \"status\", \"dispatch\":\n   439\t\t\treplacement := map[string]string{\"dispatch\": \"pose delegate review|adjudicate|smoke <scope|bundle-id>\", \"resume\": \"pose delegate resume <run>\", \"status\": \"pose delegate ls\"}[args[0]]\n   440\t\t\treturn usageError(stderr, tr(\"pose review \"+args[0]+\" was removed; use \"+replacement, \"pose review \"+args[0]+\" foi removido; use \"+replacement))\n   441\t\tcase \"attest\":\n   442\t\t\treturn cmdReviewAttest(root, args[1:], stdout, stderr)\n   443\t\tcase \"auto-attest\":\n   444\t\t\treturn cmdReviewAutoAttest(root, args[1:], stdout, stderr)\n   445\t\tcase \"verify\":\n   446\t\t\treturn cmdReviewVerify(root, args[1:], stdout, stderr)\n   447\t\tcase \"record\":\n   448\t\t\treturn cmdReviewRecord(root, args[1:], stdout, stderr)\n   449\t\tcase \"attribution-supplement\":\n   450\t\t\treturn cmdReviewAttributionSupplement(root, args[1:], stdout, stderr)\n   451\t\tdefault:\n   452\t\t\tfmt.Fprintln(stderr, \"Usage: pose review <bundle|brief|attest|auto-attest|verify|record|attribution-supplement> ...\")\n   453\t\t\treturn 2\n   454\t\t}\n   455\t}\n   456\t\n   457\tfunc routeQualifiedReviewScope(root string, args []string, stdout, stderr io.Writer) (int, bool) {\n   458\t\tif len(args) < 2 || args[0] == \"auto-attest\" {\n   459\t\t\treturn 0, false\n   460\t\t}\n   461\t\tref := args[1]\n   462\t\tif strings.HasPrefix(ref, \"-\") {\n   463\t\t\treturn 0, false\n   464\t\t}\n   465\t\tparsed, err := posemodel.ParseArtifactRef(ref)\n   466\t\tif err != nil || !strings.Contains(ref, \":\") {\n   467\t\t\treturn 0, false\n   468\t\t}\n   469\t\troute, err := cliResolveArtifactRoute(root, ref)\n   470\t\tif err != nil {\n   471\t\t\tif strings.HasPrefix(ref, \"xref:\") {\n   472\t\t\t\trender(io.Discard, stderr).Failure(\"pose review: \" + err.Error())\n   473\t\t\t\treturn 1, true\n   474\t\t\t}\n   475\t\t\treturn 0, false\n   476\t\t}\n   477\t\tif parsed.Project == \"\" && !route.Context.TaskResolution.Redirected {\n   478\t\t\treturn 0, false\n   479\t\t}\n   480\t\texpectedContext := \"\"\n   481\t\tfiltered := make([]string, 0, len(args)-1)\n   482\t\tfiltered = append(filtered, args[0])\n   483\t\tfor i := 1; i < len(args); i++ {\n   484\t\t\tif args[i] == \"--expect-context\" {\n   485\t\t\t\tif expectedContext != \"\" || i+1 >= len(args) || args[i+1] == \"\" || strings.HasPrefix(args[i+1], \"--\") {\n   486\t\t\t\t\trender(io.Discard, stderr).Failure(\"pose review: --expect-context requires one digest\")\n   487\t\t\t\t\treturn 2, true\n   488\t\t\t\t}\n   489\t\t\t\ti++\n   490\t\t\t\texpectedContext = args[i]\n   491\t\t\t\tcontinue\n   492\t\t\t}\n   493\t\t\tif args[i] == ref {\n   494\t\t\t\tfiltered = append(filtered, route.LocalRef)\n   495\t\t\t} else {\n   496\t\t\t\tfiltered = append(filtered, args[i])\n   497\t\t\t}\n   498\t\t}\n   499\t\tmutating := args[0] == \"bundle\"\n   500\t\tif args[0] == \"record\" || args[0] == \"attest\" {\n   501\t\t\tmutating = slices.Contains(args, \"--apply\")\n   502\t\t}\n   503\t\tif mutating {\n   504\t\t\tif _, cross, err := cliAuthorizedWriteStore(root, route.Context.Authority.Project, route.Resolver, route.CurrentProject); err != nil {\n   505\t\t\t\trender(io.Discard, stderr).Failure(\"pose review: \" + err.Error())\n   506\t\t\t\treturn 1, true\n   507\t\t\t} else if cross && expectedContext == \"\" {\n   508\t\t\t\trender(io.Discard, stderr).Failure(\"pose review: cross-project write requires --expect-context from pose context\")\n   509\t\t\t\treturn 1, true\n   510\t\t\t}\n   511\t\t}\n   512\t\tif expectedContext != \"\" {\n   513\t\t\tif route.Context.ContextRevision != expectedContext {\n   514\t\t\t\trender(io.Discard, stderr).Failure(\"pose review: stale-context; rerun pose context and retry\")\n   515\t\t\t\treturn 1, true\n   516\t\t\t}\n   517\t\t\tlatest, err := posemodel.ResolveAgentProjectContext(route.Resolver, route.CurrentProject, ref)\n   518\t\t\tif err != nil || latest.ContextRevision != expectedContext || latest.Authority == nil || latest.Authority.String() != route.Context.Authority.String() {\n   519\t\t\t\trender(io.Discard, stderr).Failure(\"pose review: stale-context; rerun pose context and retry\")\n   520\t\t\t\treturn 1, true\n   521\t\t\t}\n   522\t\t}\n   523\t\ttargetRoot := route.Store.Root\n   524\t\tswitch args[0] {\n   525\t\tcase \"bundle\":\n   526\t\t\treturn cmdReviewBundle(targetRoot, filtered[1:], stdout, stderr), true\n   527\t\tcase \"verify\":\n   528\t\t\treturn cmdReviewVerify(targetRoot, filtered[1:], stdout, stderr), true\n   529\t\tcase \"record\":\n   530\t\t\treturn cmdReviewRecord(targetRoot, filtered[1:], stdout, stderr), true\n   531\t\tcase \"attest\":\n   532\t\t\treturn cmdReviewAttest(targetRoot, filtered[1:], stdout, stderr), true\n   533\t\tdefault:\n   534\t\t\treturn 0, false\n   535\t\t}\n   536\t}\n   537\t\n   538\tconst reviewBundleUsage = \"Usage: pose review bundle <scope> [--json] [--explain] [--seal [--lead <vendor>[/<model>]]]\"\n   539\t\n   540\tfunc cmdReviewBundle(root string, args []string, stdout, stderr io.Writer) int {\n   541\t\tref, jsonOutput, explain, seal, lead, leadGiven := \"\", false, false, false, \"\", false\n   542\t\tfor i := 0; i < len(args); i++ {\n   543\t\t\targ := args[i]\n   544\t\t\tswitch {\n   545\t\t\tcase arg == \"--json\":\n   546\t\t\t\tjsonOutput = true\n   547\t\t\tcase arg == \"--explain\":\n   548\t\t\t\texplain = true\n   549\t\t\tcase arg == \"--seal\":\n   550\t\t\t\tseal = true\n   551\t\t\tcase arg == \"--lead\" || strings.HasPrefix(arg, \"--lead=\"):\n   552\t\t\t\t// The implementation identity the seal records, declared instead of\n   553\t\t\t\t// detected from the session (spec pose-delegation-routing R3).\n   554\t\t\t\tvalue, inline := strings.CutPrefix(arg, \"--lead=\")\n   555\t\t\t\tif !inline {\n   556\t\t\t\t\tif i+1 >= len(args) {\n   557\t\t\t\t\t\trender(stdout, stderr).Usage(reviewBundleUsage)\n   558\t\t\t\t\t\treturn 2\n   559\t\t\t\t\t}\n   560\t\t\t\t\ti++\n   561\t\t\t\t\tvalue = args[i]\n   562\t\t\t\t}\n   563\t\t\t\tif _, _, err := posemodel.ParseLead(value); err != nil {\n   564\t\t\t\t\trender(stdout, stderr).Failure(\"pose review bundle: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n   565\t\t\t\t\treturn 2\n   566\t\t\t\t}\n   567\t\t\t\tlead, leadGiven = value, true\n   568\t\t\tdefault:\n   569\t\t\t\tif strings.HasPrefix(arg, \"-\") || ref != \"\" {\n   570\t\t\t\t\trender(stdout, stderr).Usage(reviewBundleUsage)\n   571\t\t\t\t\treturn 2\n   572\t\t\t\t}\n   573\t\t\t\tref = arg\n   574\t\t\t}\n   575\t\t}\n   576\t\tif ref == \"\" || leadGiven && !seal {\n   577\t\t\trender(stdout, stderr).Usage(reviewBundleUsage)\n   578\t\t\treturn 2\n   579\t\t}\n   580\t\tindexPath := filepath.Join(root, \".pose\", \"indexes\", \"delivery-integrity.json\")\n   581\t\tif _, statErr := os.Stat(indexPath); statErr != nil {\n   582\t\t\tif deliveryGraph, err := buildCurrentDeliveryGraph(root); err == nil {\n   583\t\t\t\tif raw, err := deliveryGraph.IndexJSON(); err == nil {\n   584\t\t\t\t\trefreshDeliveryIndex(root, append(raw, '\\n'), stderr)\n   585\t\t\t\t}\n   586\t\t\t}\n   587\t\t}\n   588\t\tstore := cliGovernedStore(root)\n   589\t\tvar bundle posemodel.ReviewBundle\n   590\t\tvar err error\n   591\t\tif seal {\n   592\t\t\tbundle, err = store.SealReviewBundleLead(ref, lead, time.Now())\n   593\t\t} else {\n   594\t\t\tbundle, err = store.PrepareReviewBundle(ref)\n   595\t\t}\n   596\t\tif err != nil {\n   597\t\t\tfmt.Fprintf(stderr, \"pose review bundle: %v\\n\", err)\n   598\t\t\tif bundle.BundleID == \"\" {\n   599\t\t\t\treturn 1\n   600\t\t\t}\n   601\t\t}\n   602\t\tif jsonOutput {\n   603\t\t\tif code := writeJSON(stdout, bundle); code != 0 {\n   604\t\t\t\treturn code\n   605\t\t\t}\n   606\t\t} else {\n   607\t\t\tfmt.Fprintf(stdout, \"review_bundle.id=%s\\nreview_bundle.digest=%s\\nreview_bundle.scope=%s\\nreview_bundle.state=%s\\nreview_bundle.subject.patch_digest=%s\\nreview_bundle.subject.tree_digest=%s\\nreview_bundle.criteria=%d\\nreview_bundle.tools=%d\\nreview_bundle.evidence=%d\\n\", bundle.BundleID, bundle.BundleDigest, bundle.Payload.Scope.Ref, bundle.State, bundle.Payload.Subject.PatchDigest, bundle.Payload.Subject.TreeDigest, len(bundle.Payload.Plan.Criteria), len(bundle.Payload.Plan.Tools), len(bundle.Payload.Evidence))\n   608\t\t\tif impl := bundle.Payload.Implementation; impl != nil {\n   609\t\t\t\tfmt.Fprintf(stdout, \"review_bundle.implementation=%s\\n\", posemodel.DescribeImplementation(*impl))\n   610\t\t\t}\n   611\t\t\tif explain {\n   612\t\t\t\tfor _, input := range bundle.Payload.Scope.Sections {\n   613\t\t\t\t\tfmt.Fprintf(stdout, \"include.%s=%s reason:%s\\n\", input.Kind, input.Path, input.Reason)\n   614\t\t\t\t}\n   615\t\t\t\tfor _, entry := range bundle.Payload.Subject.Entries {\n   616\t\t\t\t\tpath := entry.Path\n   617\t\t\t\t\tif entry.NewPath != \"\" {\n   618\t\t\t\t\t\tpath = entry.NewPath\n   619\t\t\t\t\t}\n   620\t\t\t\t\tfmt.Fprintf(stdout, \"include.subject=%s class:%s digest:%s reason:%s\\n\", path, entry.Class, entry.Digest, entry.Reason)\n   621\t\t\t\t}\n   622\t\t\t\tfor _, input := range bundle.Payload.ConsumedInputs {\n   623\t\t\t\t\tfmt.Fprintf(stdout, \"include.%s=%s reason:%s\\n\", input.Kind, input.Path, input.Reason)\n   624\t\t\t\t}\n   625\t\t\t\tfor _, input := range bundle.ExcludedInputs {\n   626\t\t\t\t\tfmt.Fprintf(stdout, \"exclude.%s=%s reason:%s\\n\", input.Kind, input.Path, input.Reason)\n   627\t\t\t\t}\n   628\t\t\t}\n   629\t\t\tfor _, warning := range bundle.Warnings {\n   630\t\t\t\tfmt.Fprintf(stdout, \"[WARN] %s\\n\", warning)\n   631\t\t\t}\n   632\t\t\tfor _, blocker := range bundle.Blockers {\n   633\t\t\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n   634\t\t\t}\n   635\t\t}\n   636\t\tif err != nil || len(bundle.Blockers) > 0 {\n   637\t\t\treturn 1\n   638\t\t}\n   639\t\tfor _, input := range bundle.ExcludedInputs {\n   640\t\t\tif input.Kind == \"derived\" || input.Kind == \"derived-section\" || input.Kind == \"lifecycle\" {\n   641\t\t\t\tnoteUsageSignals(stdout, \"false-staleness-avoided\")\n   642\t\t\t\tbreak\n   643\t\t\t}\n   644\t\t}\n   645\t\treturn 0\n   646\t}\n   647\t\n   648\tfunc cmdReviewVerify(root string, args []string, stdout, stderr io.Writer) int {\n   649\t\tjsonOutput, target := false, \"\"\n   650\t\tfor _, arg := range args {\n   651\t\t\tif arg == \"--json\" {\n   652\t\t\t\tjsonOutput = true\n   653\t\t\t} else if strings.HasPrefix(arg, \"-\") || target != \"\" {\n   654\t\t\t\tfmt.Fprintln(stderr, \"Usage: pose review verify <scope|bundle-id|bundle-path> [--json]\")\n   655\t\t\t\treturn 2\n   656\t\t\t} else {\n   657\t\t\t\ttarget = arg\n   658\t\t\t}\n   659\t\t}\n   660\t\tif target == \"\" {\n   661\t\t\tfmt.Fprintln(stderr, \"Usage: pose review verify <scope|bundle-id|bundle-path> [--json]\")\n   662\t\t\treturn 2\n   663\t\t}\n   664\t\tstore := cliGovernedStore(root)\n   665\t\tref, err := resolveReviewBundleScope(store, target)\n   666\t\tif err != nil {\n   667\t\t\tfmt.Fprintf(stderr, \"pose review verify: %v\\n\", err)\n   668\t\t\treturn 1\n   669\t\t}\n   670\t\tverification, err := store.VerifyReviewBundle(ref)\n   671\t\tif err != nil {\n   672\t\t\tfmt.Fprintf(stderr, \"pose review verify: %v\\n\", err)\n   673\t\t\treturn 1\n   674\t\t}\n   675\t\tif jsonOutput {\n   676\t\t\tif code := writeJSON(stdout, verification); code != 0 {\n   677\t\t\t\treturn code\n   678\t\t\t}\n   679\t\t} else {\n   680\t\t\tfmt.Fprintf(stdout, \"review_verify.scope=%s\\nreview_verify.state=%s\\nreview_verify.fresh=%t\\nreview_verify.approved=%t\\nreview_verify.next_action=%s\\n\", verification.Scope, verification.State, verification.Fresh, verification.Approved, verification.NextAction)\n   681\t\t\tif verification.Round > 0 {\n   682\t\t\t\trender(stdout, stderr).Field(\"review_verify.round\", fmt.Sprint(verification.Round))\n   683\t\t\t}\n   684\t\t\tif verification.Assurance != nil {\n   685\t\t\t\trender(stdout, stderr).Field(\"review_verify.assurance\", posemodel.RenderReviewAssurance(*verification.Assurance))\n   686\t\t\t}\n   687\t\t\t// Why each criterion can or cannot be carried forward (spec\n   688\t\t\t// pose-material-equivalence-reuse), and where reused answers came from.\n   689\t\t\tif verification.Delta != nil {\n   690\t\t\t\tfor _, e := range verification.Delta.CriterionReuse {\n   691\t\t\t\t\tline := e.Decision\n   692\t\t\t\t\tif len(e.ChangedInputs) > 0 {\n   693\t\t\t\t\t\tline += \": \" + strings.Join(e.ChangedInputs, \"; \")\n   694\t\t\t\t\t}\n   695\t\t\t\t\trender(stdout, stderr).Field(\"review_verify.reuse.\"+e.Criterion, line)\n   696\t\t\t\t}\n   697\t\t\t}\n   698\t\t\tif verification.Assurance != nil {\n   699\t\t\t\tfor _, reuse := range verification.Assurance.Reuse {\n   700\t\t\t\t\trender(stdout, stderr).Field(\"review_verify.reused.\"+reuse.Criterion, \"from \"+reuse.FromAttestation+\"; \"+reuse.Mode+\"; \"+reuse.State)\n   701\t\t\t\t}\n   702\t\t\t}\n   703\t\t\tfor _, run := range verification.DelegatedRuns {\n   704\t\t\t\tif run.Safety != nil {\n   705\t\t\t\t\traw, _ := json.Marshal(run.Safety)\n   706\t\t\t\t\trender(stdout, stderr).Field(\"review_verify.safety.\"+run.RunID, string(raw))\n   707\t\t\t\t}\n   708\t\t\t\trender(stdout, stderr).Field(\"review_verify.run.\"+run.RunID, run.Adapter+\" \"+run.Status+\" draft=\"+run.DraftDecision+\" bundle=\"+run.BundleID+\" reason=\"+run.Reason+fmt.Sprintf(\" partial=%t resumes=%s limit_of=%s; \", run.Partial, run.Resumes, run.LimitOf)+run.Assurance)\n   709\t\t\t\t// The session lineage of a round (R6) and why a draft does not count (R4).\n   710\t\t\t\tif run.Thread != nil {\n   711\t\t\t\t\tlineage := fmt.Sprintf(\"round %d: %s session\", run.Thread.Round, run.Thread.Mode)\n   712\t\t\t\t\tif run.Thread.Mode == posemodel.ReviewThreadContinued {\n   713\t\t\t\t\t\tlineage += \" from \" + run.Thread.From\n   714\t\t\t\t\t} else if run.Thread.Reason != \"\" {\n   715\t\t\t\t\t\tlineage += \": \" + run.Thread.Reason\n   716\t\t\t\t\t}\n   717\t\t\t\t\trender(stdout, stderr).Field(\"review_verify.thread.\"+run.RunID, lineage)\n   718\t\t\t\t}\n   719\t\t\t\tfor _, problem := range run.DraftProblems {\n   720\t\t\t\t\trender(stdout, stderr).Field(\"review_verify.draft_problem.\"+run.RunID, problem)\n   721\t\t\t\t}\n   722\t\t\t}\n   723\t\t\tfor _, loss := range verification.DelegatedHistoryLosses {\n   724\t\t\t\trender(stdout, stderr).Field(\"review_verify.delegated_history_loss\", loss)\n   725\t\t\t}\n   726\t\t\tfor _, warning := range verification.Warnings {\n   727\t\t\t\tfmt.Fprintf(stdout, \"[WARN] %s\\n\", warning)\n   728\t\t\t}\n   729\t\t\tfor _, blocker := range verification.Blockers {\n   730\t\t\t\tfmt.Fprintf(stderr, \"[ERROR] %s\\n\", blocker)\n   731\t\t\t}\n   732\t\t}\n   733\t\tif verification.State == \"superseded\" {\n   734\t\t\tnoteUsageSignals(stdout, \"supersession\")\n   735\t\t}\n   736\t\tif verification.Attestation != nil && len(verification.Attestation.ReusedFrom) > 0 {\n   737\t\t\tnoteUsageSignals(stdout, \"criterion-reuse\")\n   738\t\t}\n   739\t\tif !verification.Approved {\n   740\t\t\treturn 1\n   741\t\t}\n   742\t\treturn 0\n   743\t}\n   744\t\n   745\tfunc resolveReviewBundleScope(store posemodel.Store, target string) (string, error) {\n   746\t\tif _, err := posemodel.ParseScopeRef(target); err == nil {\n   747\t\t\treturn target, nil\n   748\t\t}\n   749\t\tid := target\n   750\t\tif strings.HasSuffix(target, \".json\") {\n   751\t\t\tclean := filepath.Clean(filepath.FromSlash(target))\n   752\t\t\tif filepath.IsAbs(clean) || clean == \"..\" || strings.HasPrefix(clean, \"..\"+string(os.PathSeparator)) {\n   753\t\t\t\treturn \"\", fmt.Errorf(\"bundle path escapes project root\")\n   754\t\t\t}\n   755\t\t\tid = strings.TrimSuffix(filepath.Base(clean), \".json\")\n   756\t\t}\n   757\t\tbundle, err := store.LoadReviewBundle(id)\n   758\t\tif err != nil {\n   759\t\t\treturn \"\", err\n   760\t\t}\n   761\t\treturn bundle.Payload.Scope.Ref, nil\n   762\t}\n   763\t\n   764\t// resolveReviewAttestBundle names the bundle an attestation is about. A scope\n   765\t// ref means its current sealed bundle; an explicit bundle id or path means\n   766\t// that bundle, as named. Whether a named bundle is still the current subject\n   767\t// is not decided here: the domain writer refuses the approval of a superseded\n   768\t// or stale bundle among its other blockers, and records a legitimate negative\n   769\t// about it, exactly as it does for the Store and a signed import (spec\n   770\t// pose-review-approval-domain-preflight R4, R5, R7).\n   771\tfunc resolveReviewAttestBundle(store posemodel.Store, target string) (*posemodel.ReviewBundle, error) {\n   772\t\tif _, err := posemodel.ParseScopeRef(target); err == nil {\n   773\t\t\tbundle, err := store.CurrentReviewBundle(target)\n   774\t\t\tif err != nil {\n   775\t\t\t\treturn nil, err\n   776\t\t\t}\n   777\t\t\tif bundle == nil {\n   778\t\t\t\treturn nil, fmt.Errorf(\"scope has no current sealed bundle\")\n   779\t\t\t}\n   780\t\t\treturn bundle, nil\n   781\t\t}\n   782\t\tid := target\n   783\t\tif strings.HasSuffix(target, \".json\") {\n   784\t\t\tclean := filepath.Clean(filepath.FromSlash(target))\n   785\t\t\tif filepath.IsAbs(clean) || clean == \"..\" || strings.HasPrefix(clean, \"..\"+string(os.PathSeparator)) {\n   786\t\t\t\treturn nil, fmt.Errorf(\"bundle path escapes project root\")\n   787\t\t\t}\n   788\t\t\tid = strings.TrimSuffix(filepath.Base(clean), \".json\")\n   789\t\t}\n   790\t\tbundle, err := store.LoadReviewBundle(id)\n   791\t\tif err != nil {\n   792\t\t\treturn nil, err\n   793\t\t}\n   794\t\treturn &bundle, nil\n   795\t}\n   796\t\n   797\tfunc cmdReviewAttest(root string, args []string, stdout, stderr io.Writer) int {\n   798\t\tif len(args) >= 2 && args[0] == \"--envelope\" {\n   799\t\t\tapply := false\n   800\t\t\tif len(args) == 3 && args[2] == \"--apply\" {\n   801\t\t\t\tapply = true\n   802\t\t\t} else if len(args) != 2 {\n   803\t\t\t\tfmt.Fprintln(stderr, \"Usage: pose review attest --envelope <project-relative-path> [--apply]\")\n   804\t\t\t\treturn 2\n   805\t\t\t}\n   806\t\t\tstore := cliGovernedStore(root)\n   807\t\t\tattestation, err := store.ImportReviewAttestationEnvelope(args[1], apply)\n   808\t\t\tif reportApprovalRefusal(stdout, stderr, \"pose review attest\", err) {\n   809\t\t\t\treturn 1\n   810\t\t\t}\n   811\t\t\tif reportCommittedAttestation(store, stdout, stderr, \"pose review attest\", attestation, err) {\n   812\t\t\t\treturn 0\n   813\t\t\t}\n   814\t\t\tif err != nil {\n   815\t\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n   816\t\t\t\treturn 1\n   817\t\t\t}\n   818\t\t\t// A verified signature is not an admissible approval: the preview\n   819\t\t\t// reports what the domain writer would refuse (spec\n   820\t\t\t// pose-review-approval-domain-preflight R6).\n   821\t\t\tif refusals := store.PreflightReviewAttestation(attestation, time.Now()); !apply && len(refusals) > 0 {\n   822\t\t\t\treportAttestPreflight(stdout, stderr, \"pose review attest\", refusals)\n   823\t\t\t\treturn 1\n   824\t\t\t}\n   825\t\t\tfmt.Fprintf(stdout, \"review_attestation.envelope=verified\\nreview_attestation.id=%s\\nreview_attestation.bundle_id=%s\\nreview_attestation.apply=%t\\n\", attestation.AttestationID, attestation.BundleID, apply)\n   826\t\t\treturn 0\n   827\t\t}\n   828\t\tvar target, reviewer, decision, expectedPlanDigest string\n   829\t\tvar evidence, findings, rawTools, rawCriteria, rawMappings []string\n   830\t\t// Attribution roles are explicit flags and never derived from --reviewer\n   831\t\t// (spec pose-review-attribution-roles).\n   832\t\tvar attribution posemodel.ReviewAttribution\n   833\t\tattributed := false\n   834\t\tapply := false\n   835\t\t// A native issuer signs the attestation in place of recording it unsigned\n   836\t\t// (spec pose-native-attestation-issuer).\n   837\t\tvar signWith, reviewExecution, implementationPrincipal, implementationExecution, claimTTL, runID, runProof string\n   838\t\tclaimAuthority := false\n   839\t\tfor i := 0; i < len(args); i++ {\n   840\t\t\tswitch args[i] {\n   841\t\t\tcase \"--authority\":\n   842\t\t\t\tclaimAuthority = true\n   843\t\t\tcase \"--run\", \"--run-proof\", \"--sign\", \"--review-execution\", \"--implementation-principal\", \"--implementation-execution\", \"--claim-ttl\":\n   844\t\t\t\tif i+1 >= len(args) {\n   845\t\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: missing option value\")\n   846\t\t\t\t\treturn 2\n   847\t\t\t\t}\n   848\t\t\t\ti++\n   849\t\t\t\tswitch args[i-1] {\n   850\t\t\t\tcase \"--run\":\n   851\t\t\t\t\trunID = args[i]\n   852\t\t\t\tcase \"--run-proof\":\n   853\t\t\t\t\trunProof = args[i]\n   854\t\t\t\tcase \"--sign\":\n   855\t\t\t\t\tsignWith = args[i]\n   856\t\t\t\tcase \"--review-execution\":\n   857\t\t\t\t\treviewExecution = args[i]\n   858\t\t\t\tcase \"--implementation-principal\":\n   859\t\t\t\t\timplementationPrincipal = args[i]\n   860\t\t\t\tcase \"--implementation-execution\":\n   861\t\t\t\t\timplementationExecution = args[i]\n   862\t\t\t\tcase \"--claim-ttl\":\n   863\t\t\t\t\tclaimTTL = args[i]\n   864\t\t\t\t}\n   865\t\t\tcase \"--prepared-by\", \"--concluded-by\", \"--confirmed-by\", \"--applied-by\", \"--confirmation-mode\":\n   866\t\t\t\tif i+1 >= len(args) {\n   867\t\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: missing option value\")\n   868\t\t\t\t\treturn 2\n   869\t\t\t\t}\n   870\t\t\t\ti++\n   871\t\t\t\tattributed = true\n   872\t\t\t\tswitch args[i-1] {\n   873\t\t\t\tcase \"--prepared-by\":\n   874\t\t\t\t\tattribution.PreparedBy = args[i]\n   875\t\t\t\tcase \"--concluded-by\":\n   876\t\t\t\t\tattribution.ConcludedBy = args[i]\n   877\t\t\t\tcase \"--confirmed-by\":\n   878\t\t\t\t\tattribution.ConfirmedBy = args[i]\n   879\t\t\t\tcase \"--applied-by\":\n   880\t\t\t\t\tattribution.AppliedBy = args[i]\n   881\t\t\t\tcase \"--confirmation-mode\":\n   882\t\t\t\t\tattribution.ConfirmationMode = args[i]\n   883\t\t\t\t}\n   884\t\t\tcase \"--reviewer\", \"--decision\", \"--evidence\", \"--finding\", \"--tool\", \"--criterion\", \"--mapping\", \"--plan-digest\":\n   885\t\t\t\tif i+1 >= len(args) {\n   886\t\t\t\t\tfmt.Fprintln(stderr, \"pose review attest: missing option value\")\n   887\t\t\t\t\treturn 2\n   888\t\t\t\t}\n   889\t\t\t\ti++\n   890\t\t\t\tswitch args[i-1] {\n   891\t\t\t\tcase \"--reviewer\":\n   892\t\t\t\t\treviewer = args[i]\n   893\t\t\t\tcase \"--decision\":\n   894\t\t\t\t\tdecision = args[i]\n   895\t\t\t\tcase \"--evidence\":\n   896\t\t\t\t\tevidence = append(evidence, args[i])\n   897\t\t\t\tcase \"--finding\":\n   898\t\t\t\t\tfindings = append(findings, args[i])\n   899\t\t\t\tcase \"--criterion\":\n   900\t\t\t\t\trawCriteria = append(rawCriteria, args[i])\n   901\t\t\t\tcase \"--mapping\":\n   902\t\t\t\t\trawMappings = append(rawMappings, args[i])\n   903\t\t\t\tcase \"--tool\":\n   904\t\t\t\t\trawTools = append(rawTools, args[i])\n   905\t\t\t\tcase \"--plan-digest\":\n   906\t\t\t\t\texpectedPlanDigest = args[i]\n   907\t\t\t\t}\n   908\t\t\tcase \"--apply\":\n   909\t\t\t\tapply = true\n   910\t\t\tdefault:\n   911\t\t\t\tif strings.HasPrefix(args[i], \"-\") || target != \"\" {\n   912\t\t\t\t\tfmt.Fprintf(stderr, \"pose review attest: unexpected argument %q\\n\", args[i])\n   913\t\t\t\t\treturn 2\n   914\t\t\t\t}\n   915\t\t\t\ttarget = args[i]\n   916\t\t\t}\n   917\t\t}\n   918\t\tif target == \"\" || reviewer == \"\" || decision == \"\" || len(evidence) == 0 {\n   919\t\t\tfmt.Fprintln(stderr, \"pose review attest: bundle, reviewer, decision and at least one evidence ref are required\")\n   920\t\t\treturn 2\n   921\t\t}\n   922\t\tstore := cliGovernedStore(root)\n   923\t\tif runID != \"\" && store.IsDelegationTaskRun(runID) {\n   924\t\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(posemodel.ErrDelegationTaskRun(runID).Error(), \"pose: \"))\n   925\t\t\treturn 1\n   926\t\t}\n   927\t\tbundle, err := resolveReviewAttestBundle(store, target)\n   928\t\tif err != nil {\n   929\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n   930\t\t\treturn 1\n   931\t\t}\n   932\t\tif expectedPlanDigest != \"\" && expectedPlanDigest != bundle.Payload.Plan.PlanDigest {\n   933\t\t\tfmt.Fprintf(stderr, \"pose review attest: expected plan digest %s, current is %s\\n\", expectedPlanDigest, bundle.Payload.Plan.PlanDigest)\n   934\t\t\treturn 1\n   935\t\t}\n   936\t\tplan := posemodel.ReviewPlan{Criteria: bundle.Payload.Plan.Criteria, Tools: bundle.Payload.Plan.Tools, Structure: bundle.Payload.Plan.Structure}\n   937\t\t// The flags are decoded here; their admissibility is judged once, by the\n   938\t\t// domain writer every channel shares (spec pose-review-approval-domain-preflight R7).\n   939\t\ttools, err := decodeReviewToolDispositions(plan, rawTools)\n   940\t\tif err != nil {\n   941\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n   942\t\t\treturn 2\n   943\t\t}\n   944\t\tparsedFindings, err := parseCLIReviewFindings(findings)\n   945\t\tif err != nil {\n   946\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n   947\t\t\treturn 2\n   948\t\t}\n   949\t\tsort.Strings(evidence)\n   950\t\tcriteria, err := reviewCriterionDispositions(plan, evidence, rawCriteria)\n   951\t\tif err != nil {\n   952\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n   953\t\t\treturn 2\n   954\t\t}\n   955\t\tcriteria, err = applyReviewCriterionMappings(plan, criteria, rawMappings)\n   956\t\tif err != nil {\n   957\t\t\trender(stdout, stderr).Failure(fmt.Sprintf(\"pose review attest: %v\", err))\n   958\t\t\treturn 2\n   959\t\t}\n   960\t\tatt := posemodel.ReviewAttestation{BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest, Reviewer: reviewer, Decision: decision, Criteria: criteria, Tools: tools, EvidenceRefs: evidence, Findings: parsedFindings}\n   961\t\tif runID != \"\" || runProof != \"\" {\n   962\t\t\tif runID == \"\" || runProof == \"\" || signWith == \"\" {\n   963\t\t\t\treturn usageError(stderr, \"pose review attest: --run and --run-proof require each other and --sign\")\n   964\t\t\t}\n   965\t\t\tatt.Run = &posemodel.ReviewRunReference{RunID: runID, ProofID: runProof}\n   966\t\t}\n   967\t\tif attributed {\n   968\t\t\tattribution.SchemaVersion = posemodel.ReviewAttributionSchemaVersion\n   969\t\t\tatt.Attribution = &attribution\n   970\t\t\tif attribution.ConfirmedBy != \"\" {\n   971\t\t\t\t// The confirmation is bound to exactly what this command writes.\n   972\t\t\t\tattribution.ConfirmationDigest = posemodel.ReviewConfirmationDigest(att)\n   973\t\t\t}\n   974\t\t\tif err := posemodel.ValidateReviewAttribution(att); err != nil {\n   975\t\t\t\trender(stdout, stderr).Failure(fmt.Sprintf(\"pose review attest: %v\", err))\n   976\t\t\t\treturn 2\n   977\t\t\t}\n   978\t\t}\n   979\t\tif claimAuthority && signWith == \"\" {\n   980\t\t\trender(stdout, stderr).Failure(\"pose review attest: --authority needs --sign <issuer>: a claim is only as good as its signature\")\n   981\t\t\treturn 2\n   982\t\t}\n   983\t\tif signWith != \"\" {\n   984\t\t\treturn signAndRecordAttestation(store, att, signWith, claimAuthority, reviewExecution, implementationPrincipal, implementationExecution, claimTTL, apply, stdout, stderr)\n   985\t\t}\n   986\t\tif !apply {\n   987\t\t\t// The preview runs the domain writer's own admission; apply gets the\n   988\t\t\t// same answer from the writer itself.\n   989\t\t\tif refusals := store.PreflightReviewAttestation(att, time.Now()); len(refusals) > 0 {\n   990\t\t\t\treportAttestPreflight(stdout, stderr, \"pose review attest\", refusals)\n   991\t\t\t\treturn 1\n   992\t\t\t}\n   993\t\t\tfmt.Fprintf(stdout, \"review_attestation.plan=record\\nreview_attestation.bundle_id=%s\\nreview_attestation.bundle_digest=%s\\nreview_attestation.plan_digest=%s\\nreview_attestation.apply=false\\n\", bundle.BundleID, bundle.BundleDigest, bundle.Payload.Plan.PlanDigest)\n   994\t\t\treturn 0\n   995\t\t}\n   996\t\tatt, err = store.RecordReviewAttestation(att, time.Now())\n   997\t\tif reportApprovalRefusal(stdout, stderr, \"pose review attest\", err) {\n   998\t\t\treturn 1\n   999\t\t}\n  1000\t\tif reportCommittedAttestation(store, stdout, stderr, \"pose review attest\", att, err) {\n  1001\t\t\treturn 0\n  1002\t\t}\n  1003\t\tif err != nil {\n  1004\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n  1005\t\t\treturn 1\n  1006\t\t}\n  1007\t\tfmt.Fprintf(stdout, \"Review attestation recorded: %s\\n\", filepath.Join(root, filepath.FromSlash(att.Path)))\n  1008\t\treturn 0\n  1009\t}\n  1010\t\n  1011\t// signAndRecordAttestation signs att with a native issuer key and records it\n  1012\t// through the same envelope verification an external issuer's envelope takes,\n  1013\t// so a natively signed attestation is held to exactly the same proof.\n  1014\tfunc signAndRecordAttestation(store posemodel.Store, att posemodel.ReviewAttestation, issuer string, claimAuthority bool, reviewExecution, implementationPrincipal, implementationExecution, claimTTL string, apply bool, stdout, stderr io.Writer) int {\n  1015\t\tkey, err := posemodel.LoadIssuerKey(store.Root, issuer)\n  1016\t\tif err != nil {\n  1017\t\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n  1018\t\t\treturn 1\n  1019\t\t}\n  1020\t\tvar authority *posemodel.NativeAuthority\n  1021\t\tif claimAuthority {\n  1022\t\t\tif reviewExecution == \"\" {\n  1023\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: --authority needs --review-execution <id> naming this review's run\")\n  1024\t\t\t\treturn 2\n  1025\t\t\t}\n  1026\t\t\tauthority = &posemodel.NativeAuthority{ReviewExecution: reviewExecution, ImplementationPrincipal: implementationPrincipal, ImplementationExecution: implementationExecution}\n  1027\t\t\tif claimTTL != \"\" {\n  1028\t\t\t\tttl, err := time.ParseDuration(claimTTL)\n  1029\t\t\t\tif err != nil || ttl <= 0 {\n  1030\t\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: --claim-ttl must be a positive duration such as 720h\")\n  1031\t\t\t\t\treturn 2\n  1032\t\t\t\t}\n  1033\t\t\t\tauthority.TTL = ttl\n  1034\t\t\t}\n  1035\t\t}\n  1036\t\tnow := time.Now()\n  1037\t\tenvelope, err := store.SignReviewAttestation(att, key, authority, now)\n  1038\t\tif err != nil {\n  1039\t\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n  1040\t\t\treturn 1\n  1041\t\t}\n  1042\t\t// Verify the envelope first: the preflight has to see the attestation as\n  1043\t\t// it will be recorded, signature included.\n  1044\t\tverified, err := store.RecordReviewAttestationEnvelope(envelope, false)\n  1045\t\tif err != nil {\n  1046\t\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n  1047\t\t\treturn 1\n  1048\t\t}\n  1049\t\tif refusals := store.PreflightReviewAttestation(verified, now); !apply && len(refusals) > 0 {\n  1050\t\t\treportAttestPreflight(stdout, stderr, \"pose review attest\", refusals)\n  1051\t\t\treturn 1\n  1052\t\t}\n  1053\t\trecorded := verified\n  1054\t\tif apply {\n  1055\t\t\trecorded, err = store.RecordReviewAttestationEnvelope(envelope, true)\n  1056\t\t\tif reportApprovalRefusal(stdout, stderr, \"pose review attest\", err) {\n  1057\t\t\t\treturn 1\n  1058\t\t\t}\n  1059\t\t\tif reportCommittedAttestation(store, stdout, stderr, \"pose review attest\", recorded, err) {\n  1060\t\t\t\treturn 0\n  1061\t\t\t}\n  1062\t\t\tif err != nil {\n  1063\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n  1064\t\t\t\treturn 1\n  1065\t\t\t}\n  1066\t\t}\n  1067\t\tout := render(stdout, stderr)\n  1068\t\tout.Field(\"review_attestation.envelope\", \"verified\")\n  1069\t\tout.Field(\"review_attestation.issuer\", key.Name)\n  1070\t\tout.Field(\"review_attestation.pin\", key.Pin())\n  1071\t\tout.Field(\"review_attestation.authority\", fmt.Sprint(authority != nil))\n  1072\t\tout.Field(\"review_attestation.bundle_id\", recorded.BundleID)\n  1073\t\tout.Field(\"review_attestation.apply\", fmt.Sprint(apply))\n  1074\t\tif apply {\n  1075\t\t\tout.ContractLine(\"Review attestation recorded: \" + recorded.Path)\n  1076\t\t}\n  1077\t\treturn 0\n  1078\t}\n  1079\t\n  1080\t// reportAttestPreflight names every reason the verifier would give, so one\n  1081\t// corrected command replaces the attestation that would otherwise have been\n  1082\t// written and then rejected.\n  1083\tfunc reportAttestPreflight(stdout, stderr io.Writer, command string, refusals []string) {\n  1084\t\trender(stdout, stderr).Failure(command + \": verify would reject this attestation, so nothing was written:\\n  - \" + strings.Join(refusals, \"\\n  - \"))\n  1085\t}\n  1086\t\n  1087\t// reportApprovalRefusal renders the domain writer's typed approval refusal\n  1088\t// the same way as the preview, and reports whether err was one. The CLI keeps\n  1089\t// no approval policy of its own (spec pose-review-approval-domain-preflight).\n  1090\tfunc reportApprovalRefusal(stdout, stderr io.Writer, command string, err error) bool {\n  1091\t\tvar refusal *posemodel.ReviewApprovalRefusal\n  1092\t\tif !errors.As(err, &refusal) {\n  1093\t\t\treturn false\n  1094\t\t}\n  1095\t\treportAttestPreflight(stdout, stderr, command, refusal.Blockers)\n  1096\t\treturn true\n  1097\t}\n  1098\t\n  1099\tfunc reportCommittedAttestation(store posemodel.Store, stdout, stderr io.Writer, command string, att posemodel.ReviewAttestation, err error) bool {\n  1100\t\tvar durability *posemodel.PublishDurabilityError\n  1101\t\tif err == nil || !errors.As(err, &durability) || att.AttestationID == \"\" {\n  1102\t\t\treturn false\n  1103\t\t}\n  1104\t\tpersisted, readErr := store.LoadReviewAttestation(att.AttestationID)\n  1105\t\tif readErr != nil || persisted.BundleDigest != att.BundleDigest {\n  1106\t\t\treturn false\n  1107\t\t}\n  1108\t\tout := render(stdout, stderr)\n  1109\t\tout.Field(\"review_attestation.recorded\", persisted.AttestationID)\n  1110\t\tout.Field(\"review_attestation.durability\", \"unconfirmed\")\n  1111\t\tout.Field(\"review_attestation.warning\", command+\": \"+durability.Error())\n  1112\t\treturn true\n  1113\t}\n  1114\t\n  1115\t// applyReviewCriterionMappings attaches the reviewer's answers about observed\n  1116\t// structure to the criterion that carries the obligation.\n  1117\t//\n  1118\t// It is a separate flag rather than more pipe-delimited fields on --criterion\n  1119\t// because a mapping is per structural fact, not per criterion: a scope with six\n  1120\t// material facts needs six answers for one criterion, and packing them into one\n  1121\t// value would make the shape of the obligation invisible at the call site.\n  1122\t//\n  1123\t// The failures it refuses here are the ones a reviewer can fix by editing the\n  1124\t// command. Sealing refuses them again, over the artifact the reviewer cannot see.\n  1125\tfunc applyReviewCriterionMappings(plan posemodel.ReviewPlan, criteria []posemodel.ReviewCriterion, raw []string) ([]posemodel.ReviewCriterion, error) {\n  1126\t\tif len(raw) == 0 {\n  1127\t\t\treturn criteria, nil\n  1128\t\t}\n  1129\t\towners := map[string]bool{}\n  1130\t\tfor _, criterion := range plan.Criteria {\n  1131\t\t\tif criterion.RequiresStructuralMapping {\n  1132\t\t\t\towners[criterion.ID] = true\n  1133\t\t\t}\n  1134\t\t}\n  1135\t\tfacts := map[string]bool{}\n  1136\t\tif plan.Structure != nil {\n  1137\t\t\tfor _, fact := range plan.Structure.Material {\n  1138\t\t\t\tfacts[fact.ID] = true\n  1139\t\t\t}\n  1140\t\t}\n  1141\t\tbyCriterion := map[string][]posemodel.ReviewCriterionMapping{}\n  1142\t\tfor _, value := range raw {\n  1143\t\t\tparts := strings.Split(value, \"|\")\n  1144\t\t\tif len(parts) < 3 || len(parts) > 6 || len(parts) == 5 {\n  1145\t\t\t\treturn nil, fmt.Errorf(\"mapping must be CRITERION|DELTA|basis-or-disposition|rationale, or CRITERION|DELTA|accepted-risk|rationale|@owner|YYYY-MM-DD\")\n  1146\t\t\t}\n  1147\t\t\tid, delta, answer := parts[0], parts[1], parts[2]\n  1148\t\t\tif !owners[id] {\n  1149\t\t\t\treturn nil, fmt.Errorf(\"mapping names %s, which the sealed plan does not make answerable for observed structure\", id)\n  1150\t\t\t}\n  1151\t\t\tif !facts[delta] {\n  1152\t\t\t\treturn nil, fmt.Errorf(\"mapping names structural fact %q, which the sealed plan does not observe as material\", delta)\n  1153\t\t\t}\n  1154\t\t\tmapping := posemodel.ReviewCriterionMapping{Delta: delta}\n  1155\t\t\tif len(parts) >= 4 {\n  1156\t\t\t\tmapping.Rationale = parts[3]\n  1157\t\t\t}\n  1158\t\t\tif len(parts) == 6 {\n  1159\t\t\t\tif answer != posemodel.ReviewMappingAcceptedRisk {\n  1160\t\t\t\t\treturn nil, fmt.Errorf(\"mapping %s for %s names an owner and review date, which only an accepted-risk disposition carries\", delta, id)\n  1161\t\t\t\t}\n  1162\t\t\t\tmapping.Owner, mapping.ReviewBy = parts[4], parts[5]\n  1163\t\t\t}\n  1164\t\t\tswitch answer {\n  1165\t\t\tcase posemodel.ReviewMappingMissingEvidence, posemodel.ReviewMappingNotApplicable, posemodel.ReviewMappingAcceptedRisk:\n  1166\t\t\t\t// An empty rationale is kept: the domain requires one for an\n  1167\t\t\t\t// approval and not for a negative (spec\n  1168\t\t\t\t// pose-review-approval-domain-preflight R4, R7).\n  1169\t\t\t\tmapping.Disposition = answer\n  1170\t\t\tcase posemodel.ReviewMappingMapped:\n  1171\t\t\t\treturn nil, fmt.Errorf(\"mapping %s for %s must name the basis ref instead of %q\", delta, id, answer)\n  1172\t\t\tdefault:\n  1173\t\t\t\tmapping.Disposition, mapping.Basis = posemodel.ReviewMappingMapped, answer\n  1174\t\t\t}\n  1175\t\t\tbyCriterion[id] = append(byCriterion[id], mapping)\n  1176\t\t}\n  1177\t\tfor i := range criteria {\n  1178\t\t\tif mappings, ok := byCriterion[criteria[i].ID]; ok {\n  1179\t\t\t\tcriteria[i].Mappings = mappings\n  1180\t\t\t}\n  1181\t\t}\n  1182\t\treturn criteria, nil\n  1183\t}\n  1184\t\n  1185\tfunc cmdReviewAutoAttest(root string, args []string, stdout, stderr io.Writer) int {\n  1186\t\tvar target, reviewer string\n  1187\t\tapply := false\n  1188\t\tfor i := 0; i < len(args); i++ {\n  1189\t\t\tswitch args[i] {\n  1190\t\t\tcase \"--reviewer\":\n  1191\t\t\t\tif i+1 >= len(args) {\n  1192\t\t\t\t\tfmt.Fprintln(stderr, \"pose review auto-attest: missing option value for --reviewer\")\n  1193\t\t\t\t\treturn 2\n  1194\t\t\t\t}\n  1195\t\t\t\ti++\n  1196\t\t\t\treviewer = args[i]\n  1197\t\t\tcase \"--apply\":\n  1198\t\t\t\tapply = true\n  1199\t\t\tdefault:\n  1200\t\t\t\tif strings.HasPrefix(args[i], \"-\") || target != \"\" {\n  1201\t\t\t\t\tfmt.Fprintf(stderr, \"pose review auto-attest: unexpected argument %q\\n\", args[i])\n  1202\t\t\t\t\treturn 2\n  1203\t\t\t\t}\n  1204\t\t\t\ttarget = args[i]\n  1205\t\t\t}\n  1206\t\t}\n  1207\t\tif target == \"\" {\n  1208\t\t\tfmt.Fprintln(stderr, \"Usage: pose review auto-attest <bundle-id|scope-ref> [--reviewer <id>] [--apply]\")\n  1209\t\t\treturn 2\n  1210\t\t}\n  1211\t\tif reviewer == \"\" {\n  1212\t\t\treviewer = \"agent:auto-attest\"\n  1213\t\t}\n  1214\t\tstore := cliGovernedStore(root)\n  1215\t\t// The bundle as named, like `attest`: supersession is the domain's verdict,\n  1216\t\t// reported with every other blocker (spec pose-review-approval-domain-preflight R7).\n  1217\t\tbundle, err := resolveReviewAttestBundle(store, target)\n  1218\t\tif err != nil {\n  1219\t\t\tfmt.Fprintf(stderr, \"pose review auto-attest: %v\\n\", err)\n  1220\t\t\treturn 1\n  1221\t\t}\n  1222\t\tprepared, err := store.PrepareReviewAttestation(bundle.BundleID, reviewer, time.Now())\n  1223\t\tatt := prepared.Attestation\n  1224\t\t// A complete draft is an approval the writer will judge, so the preview\n  1225\t\t// projects that same admission instead of reporting a preparation success\n  1226\t\t// the apply would refuse on unchanged inputs (spec\n  1227\t\t// pose-review-approval-domain-preflight R5, R7).\n  1228\t\tif err == nil && !apply && prepared.Complete {\n  1229\t\t\tif refusals := store.PreflightReviewAttestation(att, time.Now()); len(refusals) > 0 {\n  1230\t\t\t\treportAttestPreflight(stdout, stderr, \"pose review auto-attest\", refusals)\n  1231\t\t\t\treturn 1\n  1232\t\t\t}\n  1233\t\t}\n  1234\t\tif err == nil && !apply {\n  1235\t\t\tpendingLines := \"\"\n  1236\t\t\tfor _, item := range prepared.Pending {\n  1237\t\t\t\tpendingLines += fmt.Sprintf(\"review_attestation.pending=%s|%s|%s\\n\", item.Criterion, item.Kind, item.Reason)\n  1238\t\t\t}\n  1239\t\t\tfmt.Fprintf(stdout, \"review_attestation.plan=auto-attest\\nreview_attestation.bundle_id=%s\\nreview_attestation.bundle_digest=%s\\nreview_attestation.reviewer=%s\\nreview_attestation.criteria_count=%d\\nreview_attestation.tools_count=%d\\nreview_attestation.pending_count=%d\\nreview_attestation.complete=%t\\nreview_attestation.apply=false\\n%s\", bundle.BundleID, bundle.BundleDigest, reviewer, len(att.Criteria), len(att.Tools), len(prepared.Pending), prepared.Complete, pendingLines)\n  1240\t\t\treturn 0\n  1241\t\t}\n  1242\t\tif err != nil {\n  1243\t\t\t// Fall through to the single reporting site below.\n  1244\t\t} else if prepared.Complete {\n  1245\t\t\tatt, err = store.RecordReviewAttestation(att, time.Now())\n  1246\t\t\tif reportApprovalRefusal(stdout, stderr, \"pose review auto-attest\", err) {\n  1247\t\t\t\treturn 1\n  1248\t\t\t}\n  1249\t\t\tif reportCommittedAttestation(store, stdout, stderr, \"pose review auto-attest\", att, err) {\n  1250\t\t\t\treturn 0\n  1251\t\t\t}\n  1252\t\t} else {\n  1253\t\t\t// Verdict first, then the cause, then the action — and exit 1, because\n  1254\t\t\t// nothing is recorded. Reporting success here is what let a scope look\n  1255\t\t\t// attested while every judged criterion was still unanswered.\n  1256\t\t\tdetail := \"\"\n  1257\t\t\tfor _, item := range prepared.Pending {\n  1258\t\t\t\tdetail += fmt.Sprintf(\"\\n  %s: %s\", item.Criterion, item.Reason)\n  1259\t\t\t}\n  1260\t\t\terr = fmt.Errorf(\"%s%s\", posemodel.ReviewPendencySummary(bundle.BundleID, prepared.Pending), detail)\n  1261\t\t}\n  1262\t\tif err != nil {\n  1263\t\t\tfmt.Fprintf(stderr, \"pose review auto-attest: %v\\n\", err)\n  1264\t\t\treturn 1\n  1265\t\t}\n  1266\t\tfmt.Fprintf(stdout, \"Review attestation auto-recorded: %s\\n\", filepath.Join(root, filepath.FromSlash(att.Path)))\n  1267\t\treturn 0\n  1268\t}\n  1269\t\n  1270\tfunc parseCLIReviewFindings(values []string) ([]posemodel.ReviewFinding, error) {\n  1271\t\tresult := make([]posemodel.ReviewFinding, 0, len(values))\n  1272\t\tfor _, raw := range values {\n  1273\t\t\tparts := strings.Split(raw, \"|\")\n  1274\t\t\tif len(parts) < 5 || posemodel.ValidateSlug(parts[0]) != nil {\n  1275\t\t\t\treturn nil, fmt.Errorf(\"finding must be ID|severity|disposition|action|evidence[|owner|rationale|review-by]\")\n  1276\t\t\t}\n  1277\t\t\tfinding := posemodel.ReviewFinding{ID: parts[0], Severity: parts[1], Disposition: parts[2], Action: parts[3], Evidence: parts[4]}\n  1278\t\t\tif len(parts) > 5 {\n  1279\t\t\t\tfinding.Owner = parts[5]\n  1280\t\t\t}\n  1281\t\t\tif len(parts) > 6 {\n  1282\t\t\t\tfinding.Rationale = parts[6]\n  1283\t\t\t}\n  1284\t\t\tif len(parts) > 7 {\n  1285\t\t\t\tfinding.ReviewBy = parts[7]\n  1286\t\t\t}\n  1287\t\t\tresult = append(result, finding)\n  1288\t\t}\n  1289\t\treturn result, nil\n  1290\t}\n  1291\t\n  1292\tfunc cmdReviewRecord(root string, args []string, stdout, stderr io.Writer) int {\n  1293\t\tvar ref, reviewer, decision, expectedPlanDigest string\n  1294\t\tvar evidence, findings, toolDispositions []string\n  1295\t\tapply := false\n  1296\t\tfor i := 0; i < len(args); i++ {\n  1297\t\t\tswitch args[i] {\n  1298\t\t\tcase \"--reviewer\", \"--decision\", \"--evidence\", \"--finding\", \"--plan-digest\", \"--tool\":\n  1299\t\t\t\tif i+1 >= len(args) {\n  1300\t\t\t\t\tfmt.Fprintln(stderr, \"pose review record: missing option value\")\n  1301\t\t\t\t\treturn 2\n  1302\t\t\t\t}\n  1303\t\t\t\ti++\n  1304\t\t\t\tswitch args[i-1] {\n  1305\t\t\t\tcase \"--reviewer\":\n  1306\t\t\t\t\treviewer = args[i]\n  1307\t\t\t\tcase \"--decision\":\n  1308\t\t\t\t\tdecision = args[i]\n  1309\t\t\t\tcase \"--evidence\":\n  1310\t\t\t\t\tevidence = append(evidence, args[i])\n  1311\t\t\t\tcase \"--finding\":\n  1312\t\t\t\t\tfindings = append(findings, args[i])\n  1313\t\t\t\tcase \"--plan-digest\":\n  1314\t\t\t\t\texpectedPlanDigest = args[i]\n  1315\t\t\t\tcase \"--tool\":\n  1316\t\t\t\t\ttoolDispositions = append(toolDispositions, args[i])\n  1317\t\t\t\t}\n  1318\t\t\tcase \"--apply\":\n  1319\t\t\t\tapply = true\n  1320\t\t\tdefault:\n  1321\t\t\t\tif strings.HasPrefix(args[i], \"-\") || ref != \"\" {\n  1322\t\t\t\t\tfmt.Fprintf(stderr, \"pose review record: unexpected argument %q\\n\", args[i])\n  1323\t\t\t\t\treturn 2\n  1324\t\t\t\t}\n  1325\t\t\t\tref = args[i]\n  1326\t\t\t}\n  1327\t\t}\n  1328\t\tif ref == \"\" || reviewer == \"\" || decision == \"\" || len(evidence) == 0 {\n  1329\t\t\tfmt.Fprintln(stderr, \"pose review record: scope, reviewer, decision and at least one evidence ref are required\")\n  1330\t\t\treturn 2\n  1331\t\t}\n  1332\t\tallowedDecision := map[string]bool{\"approved\": true, \"approved-with-reservations\": true, \"changes-requested\": true, \"rejected\": true}\n  1333\t\tif !allowedDecision[decision] || strings.ContainsAny(reviewer, \"\\r\\n\") {\n  1334\t\t\tfmt.Fprintln(stderr, \"pose review record: invalid decision or reviewer\")\n  1335\t\t\treturn 2\n  1336\t\t}\n  1337\t\tstore := cliGovernedStore(root)\n  1338\t\tpolicy, err := store.GetReviewPolicy()\n  1339\t\tif err != nil {\n  1340\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n  1341\t\t\treturn 1\n  1342\t\t}\n  1343\t\tif policy.ReviewBundles {\n  1344\t\t\tverification, verifyErr := store.VerifyReviewBundle(ref)\n  1345\t\t\tif verifyErr != nil {\n  1346\t\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", verifyErr)\n  1347\t\t\t\treturn 1\n  1348\t\t\t}\n  1349\t\t\tif verification.Bundle == nil || !verification.Fresh {\n  1350\t\t\t\tfmt.Fprintln(stderr, \"pose review record: bundle policy requires a current sealed bundle; run pose review bundle <scope> --seal\")\n  1351\t\t\t\treturn 1\n  1352\t\t\t}\n  1353\t\t\tadapted := append([]string{}, args...)\n  1354\t\t\tfor i, value := range adapted {\n  1355\t\t\t\tif value == ref {\n  1356\t\t\t\t\tadapted[i] = verification.Bundle.BundleID\n  1357\t\t\t\t\tbreak\n  1358\t\t\t\t}\n  1359\t\t\t}\n  1360\t\t\treturn cmdReviewAttest(root, adapted, stdout, stderr)\n  1361\t\t}\n  1362\t\tprofile, err := store.ReviewProfileForScope(ref)\n  1363\t\tif err != nil {\n  1364\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n  1365\t\t\treturn 1\n  1366\t\t}\n  1367\t\tdigest, err := store.ScopeDigest(ref)\n  1368\t\tif err != nil {\n  1369\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n  1370\t\t\treturn 1\n  1371\t\t}\n  1372\t\tplan, err := store.ReviewPlan(ref)\n  1373\t\tif err != nil {\n  1374\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n  1375\t\t\treturn 1\n  1376\t\t}\n  1377\t\tif len(plan.Blockers) > 0 {\n  1378\t\t\tfmt.Fprintf(stderr, \"pose review record: effective review plan is blocked: %s\\n\", strings.Join(plan.Blockers, \"; \"))\n  1379\t\t\treturn 1\n  1380\t\t}\n  1381\t\tif expectedPlanDigest != \"\" && expectedPlanDigest != plan.PlanDigest {\n  1382\t\t\tfmt.Fprintf(stderr, \"pose review record: expected plan digest %s, current is %s\\n\", expectedPlanDigest, plan.PlanDigest)\n  1383\t\t\treturn 1\n  1384\t\t}\n  1385\t\tattemptsRead, err := store.ReadReviewAttempts(ref)\n  1386\t\tattempts := attemptsRead.Attempts\n  1387\t\tlastAt, lastID := \"\", \"\"\n  1388\t\tif len(attempts) > 0 {\n  1389\t\t\tlastAt, lastID = attempts[len(attempts)-1].ReviewedAt, attempts[len(attempts)-1].ReviewID\n  1390\t\t}\n  1391\t\tif lost := attemptsRead.HistoryUncertainAfter(ref, lastAt, lastID); err == nil && len(lost) > 0 {\n  1392\t\t\t// The attempt this one supersedes would be chosen from a history with a hole.\n  1393\t\t\terr = fmt.Errorf(\"the review history for %s is incomplete (%s); restore or remove the unreadable record before recording\", ref, (posemodel.SourceCoverage{Losses: lost}).Describe(\"\"))\n  1394\t\t}\n  1395\t\tif err != nil {\n  1396\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n  1397\t\t\treturn 1\n  1398\t\t}\n  1399\t\tsupersedes := \"\"\n  1400\t\tif len(attempts) > 0 {\n  1401\t\t\tsupersedes = attempts[len(attempts)-1].ReviewID\n  1402\t\t}\n  1403\t\tnow := time.Now().UTC().Truncate(time.Second)\n  1404\t\tsum := sha256.Sum256([]byte(ref + digest + reviewer + now.Format(time.RFC3339)))\n  1405\t\treviewID := \"rvw-\" + now.Format(\"20060102T150405Z\") + \"-\" + hex.EncodeToString(sum[:4])\n  1406\t\tsort.Strings(evidence)\n  1407\t\tcontent, err := renderReviewAttempt(reviewID, ref, digest, plan, profile, reviewer, decision, now.Format(time.RFC3339), supersedes, evidence, toolDispositions, findings, policy.SchemaVersion >= 2 && policy.ComponentAware)\n  1408\t\tif err != nil {\n  1409\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n  1410\t\t\treturn 2\n  1411\t\t}\n  1412\t\tpath := filepath.Join(root, \".pose\", \"reviews\", reviewID+\".md\")\n  1413\t\tif !apply {\n  1414\t\t\tfmt.Fprintf(stdout, \"review.plan=record\\nreview.id=%s\\nreview.scope=%s\\nreview.digest=%s\\nreview.plan_digest=%s\\nreview.path=%s\\nreview.apply=false\\n\", reviewID, ref, digest, plan.PlanDigest, filepath.ToSlash(strings.TrimPrefix(path, root+string(os.PathSeparator))))\n  1415\t\t\treturn 0\n  1416\t\t}\n  1417\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n  1418\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n  1419\t\t\treturn 1\n  1420\t\t}\n  1421\t\tif err := writeFileExclusive(path, []byte(content)); err != nil {\n  1422\t\t\tfmt.Fprintf(stderr, \"pose review record: %v\\n\", err)\n  1423\t\t\treturn 1\n  1424\t\t}\n  1425\t\tfmt.Fprintf(stdout, \"Review recorded: %s\\n\", path)\n  1426\t\treturn 0\n  1427\t}\n  1428\t\n  1429\tfunc renderReviewAttempt(id, scope, digest string, plan posemodel.ReviewPlan, profile posemodel.ReviewProfile, reviewer, decision, reviewedAt, supersedes string, evidence, rawTools, findings []string, componentAware bool) (string, error) {\n  1430\t\ttools, err := reviewToolDispositions(plan, rawTools, componentAware)\n  1431\t\tif err != nil {\n  1432\t\t\treturn \"\", err\n  1433\t\t}\n  1434\t\tvar b strings.Builder\n  1435\t\tfmt.Fprintf(&b, \"---\\nschema_version: 1\\nreview_id: %s\\nscope: %s\\nscope_digest: %s\\nplan_digest: %s\\nprofile: %s\\nreviewer: %s\\ndecision: %s\\nreviewed_at: %s\\n\", id, scope, digest, plan.PlanDigest, profile.Ref(), reviewer, decision, reviewedAt)\n  1436\t\tif supersedes == \"\" {\n  1437\t\t\tb.WriteString(\"supersedes:\\n\")\n  1438\t\t} else {\n  1439\t\t\tfmt.Fprintf(&b, \"supersedes: %s\\n\", supersedes)\n  1440\t\t}\n  1441\t\tfmt.Fprintf(&b, \"evidence_refs: [%s]\\n---\\n\\n## Criteria\\n\", strings.Join(evidence, \", \"))\n  1442\t\tfor _, criterion := range plan.Criteria {\n  1443\t\t\tif !criterion.Required {\n  1444\t\t\t\tcontinue\n  1445\t\t\t}\n  1446\t\t\tfmt.Fprintf(&b, \"- %s [passed] evidence:%s\\n\", criterion.ID, reviewCriterionEvidence(criterion, evidence))\n  1447\t\t}\n  1448\t\tb.WriteString(\"\\n## Tools\\n\")\n  1449\t\tfor _, tool := range tools {\n  1450\t\t\tfmt.Fprintf(&b, \"- %s [%s]\", tool.ID, tool.Disposition)\n  1451\t\t\tif tool.Component != \"\" {\n  1452\t\t\t\tfmt.Fprintf(&b, \" component:%s\", url.QueryEscape(tool.Component))\n  1453\t\t\t}\n  1454\t\t\tif tool.Evidence != \"\" {\n  1455\t\t\t\tfmt.Fprintf(&b, \" evidence:%s\", tool.Evidence)\n  1456\t\t\t}\n  1457\t\t\tif tool.Rationale != \"\" {\n  1458\t\t\t\tfmt.Fprintf(&b, \" rationale:%s\", strings.ReplaceAll(tool.Rationale, \" \", \"_\"))\n  1459\t\t\t}\n  1460\t\t\tb.WriteByte('\\n')\n  1461\t\t}\n  1462\t\tb.WriteString(\"\\n## Findings\\n\")\n  1463\t\tfor _, raw := range findings {\n  1464\t\t\tparts := strings.Split(raw, \"|\")\n  1465\t\t\tif len(parts) < 5 || posemodel.ValidateSlug(parts[0]) != nil {\n  1466\t\t\t\treturn \"\", fmt.Errorf(\"finding must be ID|severity|disposition|action|evidence\")\n  1467\t\t\t}\n  1468\t\t\tfmt.Fprintf(&b, \"- %s [%s] severity:%s action:%s evidence:%s\", parts[0], parts[2], parts[1], strings.ReplaceAll(parts[3], \" \", \"_\"), strings.ReplaceAll(parts[4], \" \", \"_\"))\n  1469\t\t\tif len(parts) > 5 && parts[5] != \"\" {\n  1470\t\t\t\tfmt.Fprintf(&b, \" owner:%s\", parts[5])\n  1471\t\t\t}\n  1472\t\t\tif len(parts) > 6 && parts[6] != \"\" {\n  1473\t\t\t\tfmt.Fprintf(&b, \" rationale:%s\", strings.ReplaceAll(parts[6], \" \", \"_\"))\n  1474\t\t\t}\n  1475\t\t\tif len(parts) > 7 && parts[7] != \"\" {\n  1476\t\t\t\tfmt.Fprintf(&b, \" review_by:%s\", parts[7])\n  1477\t\t\t}\n  1478\t\t\tb.WriteByte('\\n')\n  1479\t\t}\n  1480\t\treturn b.String(), nil\n  1481\t}\n  1482\t\n  1483\t// reviewCriterionDispositions builds the attestation's criteria, defaulting each\n  1484\t// required one to `passed` with evidence picked from the refs the reviewer\n  1485\t// supplied, and letting --criterion override that.\n  1486\t//\n  1487\t// The override exists because the engine has always modelled three dispositions\n  1488\t// and this command could only write one. A criterion that genuinely does not\n  1489\t// apply — an accessibility criterion on a change with no user-visible surface —\n  1490\t// had no honest expression here: the reviewer's choices were to claim it passed\n  1491\t// on evidence that does not support it, or to leave the closeout blocked.\n  1492\t// `auto-attest` gained the ability to record `not-applicable` with a rationale;\n  1493\t// a human reviewer should not have fewer options than the automated path.\n  1494\t//\n  1495\t// It decodes the flags and nothing more. Whether an answer is admissible — a\n  1496\t// criterion the plan does not require, a duplicate, an unknown disposition, a\n  1497\t// not-applicable without a reason, a finding the attestation does not record,\n  1498\t// a judgment left unanswered — is the domain writer's verdict, so this command\n  1499\t// reports the same blockers as Store, signed import and MCP, all of them at\n  1500\t// once, and does not hold a negative decision to the approval bar (spec\n  1501\t// pose-review-approval-domain-preflight R4, R7).\n  1502\tfunc reviewCriterionDispositions(plan posemodel.ReviewPlan, evidence, raw []string) ([]posemodel.ReviewCriterion, error) {\n  1503\t\toverrides := map[string][]posemodel.ReviewCriterion{}\n  1504\t\torder := []string{}\n  1505\t\tfor _, value := range raw {\n  1506\t\t\tparts := strings.Split(value, \"|\")\n  1507\t\t\tif len(parts) < 3 || len(parts) > 4 || posemodel.ValidateSlug(parts[0]) != nil {\n  1508\t\t\t\treturn nil, fmt.Errorf(\"criterion must be ID|disposition|evidence|rationale\")\n  1509\t\t\t}\n  1510\t\t\tdisposition := posemodel.ReviewCriterion{ID: parts[0], Disposition: parts[1], Evidence: parts[2]}\n  1511\t\t\tif len(parts) == 4 {\n  1512\t\t\t\tdisposition.Rationale = parts[3]\n  1513\t\t\t}\n  1514\t\t\tif _, seen := overrides[disposition.ID]; !seen {\n  1515\t\t\t\torder = append(order, disposition.ID)\n  1516\t\t\t}\n  1517\t\t\toverrides[disposition.ID] = append(overrides[disposition.ID], disposition)\n  1518\t\t}\n  1519\t\tcriteria := make([]posemodel.ReviewCriterion, 0, len(plan.Criteria)+len(raw))\n  1520\t\tplaced := map[string]bool{}\n  1521\t\tfor _, criterion := range plan.Criteria {\n  1522\t\t\tif !criterion.Required {\n  1523\t\t\t\tcontinue\n  1524\t\t\t}\n  1525\t\t\tif answers, ok := overrides[criterion.ID]; ok {\n  1526\t\t\t\tcriteria = append(criteria, answers...)\n  1527\t\t\t\tplaced[criterion.ID] = true\n  1528\t\t\t\tcontinue\n  1529\t\t\t}\n  1530\t\t\t// Defaulting to `passed` was this command's other half of the same\n  1531\t\t\t// problem auto-attest had: a criterion the reviewer never mentioned\n  1532\t\t\t// came out approved, citing whichever supplied reference matched. For a\n  1533\t\t\t// criterion a check answers that is a defensible shortcut. For one only\n  1534\t\t\t// a reviewer can answer it states a conclusion nobody reached, so it\n  1535\t\t\t// stays unanswered and the domain names it missing for an approval\n  1536\t\t\t// (spec pose-abm-review-soundness).\n  1537\t\t\tif posemodel.ReviewCriterionKind(criterion) == posemodel.ReviewCriterionKindJudgment {\n  1538\t\t\t\tcontinue\n  1539\t\t\t}\n  1540\t\t\tcriteria = append(criteria, posemodel.ReviewCriterion{ID: criterion.ID, Disposition: \"passed\", Evidence: reviewCriterionEvidence(criterion, evidence)})\n  1541\t\t}\n  1542\t\t// An answer to a criterion the plan does not require is kept, so the domain\n  1543\t\t// names it rather than the command silently dropping it.\n  1544\t\tfor _, id := range order {\n  1545\t\t\tif !placed[id] {\n  1546\t\t\t\tcriteria = append(criteria, overrides[id]...)\n  1547\t\t\t}\n  1548\t\t}\n  1549\t\treturn criteria, nil\n  1550\t}\n  1551\t\n  1552\tfunc reviewToolDispositions(plan posemodel.ReviewPlan, raw []string, componentAware bool) ([]posemodel.ReviewToolDisposition, error) {\n  1553\t\tif !componentAware {\n  1554\t\t\tif len(raw) > 0 {\n  1555\t\t\t\treturn nil, fmt.Errorf(\"tool dispositions require component-aware review policy\")\n  1556\t\t\t}\n  1557\t\t\treturn nil, nil\n  1558\t\t}\n  1559\t\tplanned := map[string]posemodel.ReviewPlanTool{}\n  1560\t\tfor _, tool := range plan.Tools {\n  1561\t\t\tplanned[cliReviewToolKey(tool.ID, tool.Component)] = tool\n  1562\t\t}\n  1563\t\tprovided := map[string]posemodel.ReviewToolDisposition{}\n  1564\t\tfor _, value := range raw {\n  1565\t\t\tdisposition, err := parseCLIReviewToolDisposition(value)\n  1566\t\t\tif err != nil {\n  1567\t\t\t\treturn nil, err\n  1568\t\t\t}\n  1569\t\t\tkey := cliReviewToolKey(disposition.ID, disposition.Component)\n  1570\t\t\ttool, ok := planned[key]\n  1571\t\t\tif !ok {\n  1572\t\t\t\treturn nil, fmt.Errorf(\"tool disposition does not match effective plan: %s\", cliReviewToolLabel(disposition.ID, disposition.Component))\n  1573\t\t\t}\n  1574\t\t\tif _, duplicate := provided[key]; duplicate {\n  1575\t\t\t\treturn nil, fmt.Errorf(\"duplicate tool disposition: %s\", cliReviewToolLabel(disposition.ID, disposition.Component))\n  1576\t\t\t}\n  1577\t\t\tif err := validateCLIReviewToolDisposition(tool, disposition); err != nil {\n  1578\t\t\t\treturn nil, err\n  1579\t\t\t}\n  1580\t\t\tprovided[key] = disposition\n  1581\t\t}\n  1582\t\n  1583\t\tresult := make([]posemodel.ReviewToolDisposition, 0, len(plan.Tools))\n  1584\t\tfor _, tool := range plan.Tools {\n  1585\t\t\tkey := cliReviewToolKey(tool.ID, tool.Component)\n  1586\t\t\tif disposition, ok := provided[key]; ok {\n  1587\t\t\t\tresult = append(result, disposition)\n  1588\t\t\t\tcontinue\n  1589\t\t\t}\n  1590\t\t\tif cliReviewToolHasPrecondition(tool, \"review-complete\") {\n  1591\t\t\t\tresult = append(result, posemodel.ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"deferred\", Rationale: \"post-review gate\"})\n  1592\t\t\t\tcontinue\n  1593\t\t\t}\n  1594\t\t\tif tool.Requiredness == \"recommended\" {\n  1595\t\t\t\tresult = append(result, posemodel.ReviewToolDisposition{ID: tool.ID, Component: tool.Component, Disposition: \"not-used\", Rationale: \"not used during review\"})\n  1596\t\t\t\tcontinue\n  1597\t\t\t}\n  1598\t\t\treturn nil, fmt.Errorf(\"required review tool %s needs --tool evidence\", cliReviewToolLabel(tool.ID, tool.Component))\n  1599\t\t}\n  1600\t\treturn result, nil\n  1601\t}\n  1602\t\n  1603\t// decodeReviewToolDispositions is the attestation's counterpart of\n  1604\t// reviewToolDispositions, which the legacy `review record` path keeps because\n  1605\t// no domain writer judges what it writes. It decodes the flags, keeps every\n  1606\t// one in order — unknown and duplicate included, so the domain can name them\n  1607\t// — and fills only the defaults that state no conclusion: a post-review gate\n  1608\t// deferred, a recommended tool not used. A required tool left out stays out,\n  1609\t// and the domain writer names it for an approval (spec\n  1610\t// pose-review-approval-domain-preflight R4, R7).\n  1611\tfunc decodeReviewToolDispositions(plan posemodel.ReviewPlan, raw []string) ([]posemodel.ReviewToolDisposition, error) {\n  1612\t\tresult := make([]posemodel.ReviewToolDisposition, 0, len(plan.Tools)+len(raw))\n  1613\t\tfor _, value := range raw {\n  1614\t\t\tdisposition, err := parseCLIReviewToolDisposition(value)\n  1615\t\t\tif err != nil {\n  1616\t\t\t\treturn nil, err\n  1617\t\t\t}\n  1618\t\t\tresult = append(result, disposition)\n  1619\t\t}\n  1620\t\treturn posemodel.ReviewToolDefaults(plan.Tools, result), nil\n  1621\t}\n  1622\t\n  1623\tfunc parseCLIReviewToolDisposition(value string) (posemodel.ReviewToolDisposition, error) {\n  1624\t\tparts := strings.Split(value, \"|\")\n  1625\t\tif len(parts) < 4 || len(parts) > 5 || posemodel.ValidateSlug(parts[0]) != nil {\n  1626\t\t\treturn posemodel.ReviewToolDisposition{}, fmt.Errorf(\"tool must be ID|component|disposition|evidence|rationale\")\n  1627\t\t}\n  1628\t\tcomponent := parts[1]\n  1629\t\tif component == \"-\" {\n  1630\t\t\tcomponent = \"\"\n  1631\t\t} else if decoded, err := url.QueryUnescape(component); err == nil {\n  1632\t\t\tcomponent = decoded\n  1633\t\t}\n  1634\t\tdisposition := posemodel.ReviewToolDisposition{ID: parts[0], Component: component, Disposition: parts[2], Evidence: parts[3]}\n  1635\t\tif len(parts) == 5 {\n  1636\t\t\tdisposition.Rationale = parts[4]\n  1637\t\t}\n  1638\t\treturn disposition, nil\n  1639\t}\n  1640\t\n  1641\tfunc validateCLIReviewToolDisposition(tool posemodel.ReviewPlanTool, disposition posemodel.ReviewToolDisposition) error {\n  1642\t\tlabel := cliReviewToolLabel(tool.ID, tool.Component)\n  1643\t\tcompletion := cliReviewToolHasPrecondition(tool, \"review-complete\")\n  1644\t\tswitch disposition.Disposition {\n  1645\t\tcase \"passed\", \"failed\":\n  1646\t\t\tparts := strings.SplitN(disposition.Evidence, \":\", 2)\n  1647\t\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\n  1648\t\t\t\treturn fmt.Errorf(\"%s review tool %s requires an evidence ref\", disposition.Disposition, label)\n  1649\t\t\t}\n  1650\t\t\tif len(tool.EvidenceClasses) > 0 && !containsCLIReviewValue(tool.EvidenceClasses, parts[0]) {\n  1651\t\t\t\treturn fmt.Errorf(\"review tool %s requires evidence class %s\", label, strings.Join(tool.EvidenceClasses, \",\"))\n  1652\t\t\t}\n  1653\t\tcase \"not-used\":\n  1654\t\t\tif tool.Requiredness == \"required\" && tool.ProducerCoverage != \"none\" {\n  1655\t\t\t\treturn fmt.Errorf(\"required review tool %s cannot be not-used\", label)\n  1656\t\t\t}\n  1657\t\t\tif disposition.Rationale == \"\" {\n  1658\t\t\t\tif tool.Requiredness == \"required\" {\n  1659\t\t\t\t\treturn fmt.Errorf(\"review tool %s has no registered producer and still needs a not-used rationale: ID|component|not-used||<why>\", label)\n  1660\t\t\t\t}\n  1661\t\t\t\treturn fmt.Errorf(\"recommended review tool %s needs a not-used rationale\", label)\n  1662\t\t\t}\n  1663\t\tcase \"deferred\":\n  1664\t\t\t// Delivery-gated tools are legitimately deferred when the reviewed\n  1665\t\t\t// scope has no delivery target. The final coverage evaluator receives\n  1666\t\t\t// that scope fact and rejects the same disposition for a target-bearing\n  1667\t\t\t// scope; the CLI must therefore allow the recorded disposition to reach\n  1668\t\t\t// that evaluator instead of requiring fabricated validation evidence.\n  1669\t\t\tdeliveryScoped := cliReviewToolHasPrecondition(tool, \"delivery-target-declared\")\n  1670\t\t\tif !(completion || deliveryScoped) || disposition.Rationale == \"\" {\n  1671\t\t\t\treturn fmt.Errorf(\"review tool %s cannot be deferred without a post-review rationale\", label)\n  1672\t\t\t}\n  1673\t\tdefault:\n  1674\t\t\treturn fmt.Errorf(\"review tool %s has invalid disposition %q\", label, disposition.Disposition)\n  1675\t\t}\n  1676\t\treturn nil\n  1677\t}\n  1678\t\n  1679\tfunc cliReviewToolHasPrecondition(tool posemodel.ReviewPlanTool, expected string) bool {\n  1680\t\treturn containsCLIReviewValue(tool.Preconditions, expected)\n  1681\t}\n  1682\t\n  1683\tfunc containsCLIReviewValue(values []string, expected string) bool {\n  1684\t\tfor _, value := range values {\n  1685\t\t\tif value == expected {\n  1686\t\t\t\treturn true\n  1687\t\t\t}\n  1688\t\t}\n  1689\t\treturn false\n  1690\t}\n  1691\t\n  1692\tfunc cliReviewToolKey(id, component string) string {\n  1693\t\treturn id + \"\\x00\" + component\n  1694\t}\n  1695\t\n  1696\tfunc cliReviewToolLabel(id, component string) string {\n  1697\t\tif component == \"\" {\n  1698\t\t\treturn id\n  1699\t\t}\n  1700\t\treturn id + \" (component \" + component + \")\"\n  1701\t}\n  1702\t\n  1703\tfunc reviewCriterionEvidence(criterion posemodel.ReviewPlanCriterion, evidence []string) string {\n  1704\t\tfor _, class := range criterion.EvidenceClasses {\n  1705\t\t\tprefix := class + \":\"\n  1706\t\t\tfor _, ref := range evidence {\n  1707\t\t\t\tif strings.HasPrefix(ref, prefix) {\n  1708\t\t\t\t\treturn ref\n  1709\t\t\t\t}\n  1710\t\t\t}\n  1711\t\t}\n  1712\t\treturn evidence[0]\n  1713\t}\n  1714\t\n  1715\tfunc writeFileExclusive(path string, content []byte) error {\n  1716\t\tf, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o644)\n  1717\t\tif err != nil {\n  1718\t\t\treturn err\n  1719\t\t}\n  1720\t\tif _, err := f.Write(content); err != nil {\n  1721\t\t\t_ = f.Close()\n  1722\t\t\treturn err\n  1723\t\t}\n  1724\t\treturn f.Close()\n  1725\t}\n  1726\t\n  1727\tfunc cmdClose(root string, args []string, stdout, stderr io.Writer) int {\n  1728\t\tfor _, arg := range args {\n  1729\t\t\tif arg == \"--plan\" || arg == \"--apply\" || arg == \"--resume\" {\n  1730\t\t\t\treturn cmdClosePlan(root, args, stdout, stderr)\n  1731\t\t\t}\n  1732\t\t}\n  1733\t\texpectedContext := \"\"\n  1734\t\tremaining := make([]string, 0, len(args))\n  1735\t\tfor i := 0; i < len(args); i++ {\n  1736\t\t\tif args[i] != \"--expect-context\" {\n  1737\t\t\t\tremaining = append(remaining, args[i])\n  1738\t\t\t\tcontinue\n  1739\t\t\t}\n  1740\t\t\tif expectedContext != \"\" || i+1 >= len(args) || strings.HasPrefix(args[i+1], \"--\") {\n  1741\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: --expect-context requires one digest\")\n  1742\t\t\t\treturn 2\n  1743\t\t\t}\n  1744\t\t\ti++\n  1745\t\t\texpectedContext = args[i]\n  1746\t\t}\n  1747\t\tref, jsonFlag, ok := parseScopeCheckArgs(\"close\", remaining, stderr)\n  1748\t\tif !ok {\n  1749\t\t\treturn 2\n  1750\t\t}\n  1751\t\t// The guarded transition has no JSON result; the flag is refused before\n  1752\t\t// anything is read instead of being dropped (spec\n  1753\t\t// pose-cli-mcp-operation-results R3).\n  1754\t\tif jsonFlag {\n  1755\t\t\trender(io.Discard, stderr).Failure(\"pose close: --json is taken only by --plan, --apply and --resume; use `pose closeout-check \" + ref + \" --json` to read the state\")\n  1756\t\t\treturn 2\n  1757\t\t}\n  1758\t\ttaskRef := ref\n  1759\t\tvar requested posemodel.ArtifactRef\n  1760\t\tif strings.HasPrefix(ref, \"xref:\") {\n  1761\t\t\tparsed, err := posemodel.ParseArtifactRef(ref)\n  1762\t\t\tif err != nil {\n  1763\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: invalid qualified task reference\")\n  1764\t\t\t\treturn 2\n  1765\t\t\t}\n  1766\t\t\trequested = parsed\n  1767\t\t\ttaskRef = parsed.String()\n  1768\t\t} else {\n  1769\t\t\tparsed, err := posemodel.ParseArtifactRef(ref)\n  1770\t\t\tif err != nil {\n  1771\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: invalid task reference\")\n  1772\t\t\t\treturn 2\n  1773\t\t\t}\n  1774\t\t\trequested = parsed\n  1775\t\t}\n  1776\t\tcontext, resolver, currentProject, err := cliAgentContext(root, taskRef)\n  1777\t\tif err != nil {\n  1778\t\t\trender(io.Discard, stderr).Failure(\"pose close: project context unavailable: \" + err.Error())\n  1779\t\t\treturn 1\n  1780\t\t}\n  1781\t\tif context.TaskResolution == nil || !context.TaskResolution.Resolved {\n  1782\t\t\tstate := \"unknown-artifact\"\n  1783\t\t\tif context.TaskResolution != nil {\n  1784\t\t\t\tstate = context.TaskResolution.State\n  1785\t\t\t}\n  1786\t\t\trender(io.Discard, stderr).Failure(\"pose close: task authority cannot close: \" + state)\n  1787\t\t\treturn 1\n  1788\t\t}\n  1789\t\tif context.Authority == nil || context.Authority.Kind != requested.Kind {\n  1790\t\t\trender(io.Discard, stderr).Failure(\"pose close: canonical authority changed\")\n  1791\t\t\treturn 1\n  1792\t\t}\n  1793\t\tstore, crossProject, err := cliAuthorizedWriteStore(root, context.Authority.Project, resolver, currentProject)\n  1794\t\tif err != nil {\n  1795\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n  1796\t\t\treturn 1\n  1797\t\t}\n  1798\t\tstore.FederatedProjectID = context.Authority.Project\n  1799\t\tstore.FederatedResolver = &resolver\n  1800\t\tif crossProject && expectedContext == \"\" {\n  1801\t\t\trender(io.Discard, stderr).Failure(\"pose close: cross-project write requires --expect-context from pose context\")\n  1802\t\t\treturn 1\n  1803\t\t}\n  1804\t\tif expectedContext != \"\" && context.ContextRevision != expectedContext {\n  1805\t\t\trender(io.Discard, stderr).Failure(\"pose close: stale-context; rerun pose context and retry\")\n  1806\t\t\treturn 1\n  1807\t\t}\n  1808\t\tlocalRef := scopeRefForArtifact(*context.Authority)\n  1809\t\tvar guard func() error\n  1810\t\tif expectedContext != \"\" {\n  1811\t\t\tguard = func() error {\n  1812\t\t\t\tlatest, err := posemodel.ResolveAgentProjectContext(resolver, currentProject, taskRef)\n  1813\t\t\t\tif err != nil || latest.ContextRevision != expectedContext || latest.Authority == nil || latest.Authority.String() != context.Authority.String() {\n  1814\t\t\t\t\treturn fmt.Errorf(\"stale-context\")\n  1815\t\t\t\t}\n  1816\t\t\t\treturn nil\n  1817\t\t\t}\n  1818\t\t}\n  1819\t\treturn cmdCloseLocalWithStoreEffect(store, localRef, guard, stdout, stderr, nil)\n  1820\t}\n  1821\t\n  1822\tfunc scopeRefForArtifact(ref posemodel.ArtifactRef) string {\n  1823\t\tif ref.Kind == \"milestone\" {\n  1824\t\t\treturn \"milestone:\" + ref.Slug + \"/\" + ref.Milestone\n  1825\t\t}\n  1826\t\treturn ref.Kind + \":\" + ref.Slug\n  1827\t}\n  1828\t\n  1829\tfunc cmdCloseLocal(root, ref string, guard func() error, stdout, stderr io.Writer) int {\n  1830\t\treturn cmdCloseLocalWithEffect(root, ref, guard, stdout, stderr, nil)\n  1831\t}\n  1832\t\n  1833\t// The pipeline confirms a transition only from the write point, never exit 0\n  1834\t// alone: another execution may have closed the scope since it planned.\n  1835\tfunc cmdCloseLocalWithEffect(root, ref string, guard func() error, stdout, stderr io.Writer, transitioned func(unsynced error)) int {\n  1836\t\treturn cmdCloseLocalWithStoreEffect(cliGovernedStore(root), ref, guard, stdout, stderr, transitioned)\n  1837\t}\n  1838\t\n  1839\tfunc cmdCloseLocalWithStoreEffect(store posemodel.Store, ref string, guard func() error, stdout, stderr io.Writer, transitioned func(unsynced error)) int {\n  1840\t\tif scope, parseErr := posemodel.ParseScopeRef(ref); parseErr == nil && scope.Kind == \"spec\" {\n  1841\t\t\tstate, err := cliCloseoutStateForStore(store, ref)\n  1842\t\t\tif err != nil {\n  1843\t\t\t\tif refusal := cliCloseGovernedPreflightRefusal(store, ref); refusal != nil {\n  1844\t\t\t\t\terr = refusal\n  1845\t\t\t\t}\n  1846\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n  1847\t\t\t\treturn 1\n  1848\t\t\t}\n  1849\t\t\tif state.LifecycleDone {\n  1850\t\t\t\tif !state.Terminal {\n  1851\t\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n  1852\t\t\t\t\treturn 1\n  1853\t\t\t\t}\n  1854\t\t\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; applicable terminal verifier passed; no transition executed\")\n  1855\t\t\t\treturn 0\n  1856\t\t\t}\n  1857\t\t}\n  1858\t\tvar result int\n  1859\t\terr := store.WithCloseoutWriteGuard(\"close.transition\", ref, func(guarded posemodel.Store) error {\n  1860\t\t\tresult = cmdCloseLocalWithGuardedStore(guarded.Root, guarded, ref, guard, stdout, stderr, transitioned)\n  1861\t\t\treturn nil\n  1862\t\t})\n  1863\t\tif err != nil {\n  1864\t\t\tif refusal := cliCloseGovernedPreflightRefusal(store, ref); refusal != nil {\n  1865\t\t\t\terr = refusal\n  1866\t\t\t}\n  1867\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n  1868\t\t\treturn 1\n  1869\t\t}\n  1870\t\treturn result\n  1871\t}\n  1872\t\n  1873\t// A disabled review bundle policy must not hide an adopted action restriction\n  1874\t// when closeout preflight fails. This local lease permits only a\n  1875\t// refusal: it never substitutes for full root discovery, the guarded closeout\n  1876\t// evaluation, lifecycle lock or CAS required for a successful transition.\n  1877\tfunc cliCloseGovernedPreflightRefusal(store posemodel.Store, ref string) error {\n  1878\t\tscope, err := posemodel.ParseScopeRef(ref)\n  1879\t\tif err != nil || scope.Kind != \"spec\" {\n  1880\t\t\treturn nil\n  1881\t\t}\n  1882\t\treturn store.WithGovernanceWriteGuardForProjects(\"close.restriction-refusal\", nil, func(guarded posemodel.Store) error {\n  1883\t\t\tpolicy, err := guarded.GetReviewPolicy()\n  1884\t\t\tif err != nil || policy.Enabled || policy.AgencyReadinessVersion != posemodel.AgencyReadinessPolicyVersion {\n  1885\t\t\t\treturn err\n  1886\t\t\t}\n  1887\t\t\trestrictions, err := guarded.GovernedEffectRestrictions(posemodel.PhaseCloseout, []string{scope.Slug})\n  1888\t\t\tif err != nil {\n  1889\t\t\t\treturn err\n  1890\t\t\t}\n  1891\t\t\tmessages := make([]string, 0, len(restrictions))\n  1892\t\t\tfor _, restriction := range restrictions {\n  1893\t\t\t\tmessages = append(messages, fmt.Sprintf(\"%s restricts closeout: %s\", restriction.Source.Detail, restriction.Message))\n  1894\t\t\t}\n  1895\t\t\tif len(messages) > 0 {\n  1896\t\t\t\treturn fmt.Errorf(\"action-request-pending: %s\", strings.Join(messages, \"; \"))\n  1897\t\t\t}\n  1898\t\t\treturn nil\n  1899\t\t})\n  1900\t}\n  1901\t\n  1902\tfunc cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref string, guard func() error, stdout, stderr io.Writer, transitioned func(unsynced error)) int {\n  1903\t\t// The gates below judge the artifact as it is now; the transition is\n  1904\t\t// published only over those same bytes (spec\n  1905\t\t// pose-writer-coordination-and-atomic-publication R4).\n  1906\t\tjudged := closeTargetDigest(root, store, ref)\n  1907\t\tstate, err := cliCloseoutStateForStore(store, ref)\n  1908\t\tif err != nil {\n  1909\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n  1910\t\t\treturn 1\n  1911\t\t}\n  1912\t\t// Repeating close on an already-done spec is a readonly terminal check,\n  1913\t\t// bounded by the same historical contract as closeout-check and the plan.\n  1914\t\tif scope, parseErr := posemodel.ParseScopeRef(ref); parseErr == nil && scope.Kind == \"spec\" && state.LifecycleDone {\n  1915\t\t\tif !state.Terminal {\n  1916\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n  1917\t\t\t\treturn 1\n  1918\t\t\t}\n  1919\t\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; applicable terminal verifier passed; no transition executed\")\n  1920\t\t\treturn 0\n  1921\t\t}\n  1922\t\t// Governed effects (spec pose-governed-effect-enforcement): this is the\n  1923\t\t// write point of the closeout transition, so an adopted, unsatisfied\n  1924\t\t// action request restricting closeout refuses here with its typed cause,\n  1925\t\t// whatever else the scope's review says.\n  1926\t\tgoverned := []string{}\n  1927\t\tfor _, d := range state.Diagnostics {\n  1928\t\t\tif d.Code == \"action-request-pending\" {\n  1929\t\t\t\tgoverned = append(governed, d.Message)\n  1930\t\t\t}\n  1931\t\t}\n  1932\t\t// A current adjudication that says a question does not hold refuses the\n  1933\t\t// closeout (spec pose-delegated-verdict-destinations R1).\n  1934\t\tadjudicated := []string{}\n  1935\t\tfor _, d := range state.Diagnostics {\n  1936\t\t\tif d.Code == posemodel.AdjudicationDoesNotHoldCode {\n  1937\t\t\t\tadjudicated = append(adjudicated, d.Message)\n  1938\t\t\t}\n  1939\t\t}\n  1940\t\tif len(adjudicated) > 0 {\n  1941\t\t\tout := render(stdout, stderr)\n  1942\t\t\tfor _, message := range adjudicated {\n  1943\t\t\t\tout.Field(\"close.refused.adjudication\", message)\n  1944\t\t\t}\n  1945\t\t\tout.Failure(fmt.Sprintf(\"pose close: %d adjudicated question(s) of %s do not hold\", len(adjudicated), ref))\n  1946\t\t\treturn 1\n  1947\t\t}\n  1948\t\tif len(governed) > 0 {\n  1949\t\t\tout := render(stdout, stderr)\n  1950\t\t\tfor _, message := range governed {\n  1951\t\t\t\tout.Field(\"close.refused.action-request-pending\", message)\n  1952\t\t\t}\n  1953\t\t\tout.Failure(fmt.Sprintf(\"pose close: %d action request(s) restrict closeout of %s\", len(governed), ref))\n  1954\t\t\treturn 1\n  1955\t\t}\n  1956\t\tscope, _ := posemodel.ParseScopeRef(ref)\n  1957\t\t// Under an adopted closeout review policy (spec\n  1958\t\t// pose-closeout-review-policy-by-cost-benefit) the close of a milestone or a\n  1959\t\t// roadmap publishes a receipt. A receipt already there makes the close a\n  1960\t\t// read-only verification; a scope the evaluator cannot decide is refused.\n  1961\t\treceiptClose, code := closeoutReceiptPreflight(store, ref, scope, &state, stdout, stderr)\n  1962\t\tif code >= 0 {\n  1963\t\t\treturn code\n  1964\t\t}\n  1965\t\tif !closeReviewSatisfied(state) || len(state.Children) > 0 && hasOpenChild(state.Children) {\n  1966\t\t\tfmt.Fprintf(stderr, \"pose close: scope is not eligible; next action: %s\\n\", state.NextAction)\n  1967\t\t\treturn 1\n  1968\t\t}\n  1969\t\tif scope.Kind == \"milestone\" {\n  1970\t\t\tgate, err := roadmapGate(root, scope.Roadmap, scope.Milestone)\n  1971\t\t\tif err != nil {\n  1972\t\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + err.Error())\n  1973\t\t\t\treturn 1\n  1974\t\t\t}\n  1975\t\t\tif blockers := uniqueCLIStrings(gate.blockers); len(blockers) > 0 {\n  1976\t\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + strings.Join(blockers, \"; \"))\n  1977\t\t\t\treturn 1\n  1978\t\t\t}\n  1979\t\t\tlabel := \"Milestone closeout verified\"\n  1980\t\t\tif receiptClose != nil {\n  1981\t\t\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, state, guard, stdout, stderr); code != 0 {\n  1982\t\t\t\t\treturn code\n  1983\t\t\t\t}\n  1984\t\t\t\tlabel = \"Closed\"\n  1985\t\t\t}\n  1986\t\t\tfmt.Fprintf(stdout, \"%s: %s\\n\", label, ref)\n  1987\t\t\trenderCloseNext(render(stdout, stderr), nextCloses(store, ref))\n  1988\t\t\treturn 0\n  1989\t\t}\n  1990\t\tvar path string\n  1991\t\tif scope.Kind == \"spec\" {\n  1992\t\t\tsp, err := store.GetSpec(scope.Slug)\n  1993\t\t\tif err != nil {\n  1994\t\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n  1995\t\t\t\treturn 1\n  1996\t\t\t}\n  1997\t\t\tif policy, err := posemodel.LoadArtifactPolicyIn(store.FS, root); err != nil {\n  1998\t\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n  1999\t\t\t\treturn 1\n  2000\t\t\t} else if policy.Enabled && sp.CreatedAt >= policy.AdoptedAt {\n  2001\t\t\t\tclaims, found, err := posemodel.ParseArtifactClaims(*sp, policy)\n  2002\t\t\t\tif err != nil || !found || len(claims) == 0 {\n  2003\t\t\t\t\tfmt.Fprintf(stderr, \"pose close: artifact declaration gate failed: %v\\n\", err)\n  2004\t\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n  2005\t\t\t\t\treturn 1\n  2006\t\t\t\t}\n  2007\t\t\t}\n  2008\t\t\tif policy, err := posemodel.LoadDeliveryPolicyIn(store.FS, root); err != nil {\n  2009\t\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n  2010\t\t\t\treturn 1\n  2011\t\t\t} else if policy.Enabled && sp.CreatedAt >= policy.AdoptedAt {\n  2012\t\t\t\tif graph, graphErr := buildCurrentDeliveryGraphIn(store.FS, root); graphErr != nil {\n  2013\t\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: delivery assurance gate failed: %s\", graphErr))\n  2014\t\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n  2015\t\t\t\t\treturn 1\n  2016\t\t\t\t} else if blockers := deliverySpecBlockersFromGraph(graph, sp.Slug); len(blockers) > 0 {\n  2017\t\t\t\t\tfmt.Fprintf(stderr, \"pose close: delivery assurance gate failed: %s\\n\", strings.Join(blockers, \"; \"))\n  2018\t\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n  2019\t\t\t\t\treturn 1\n  2020\t\t\t\t}\n  2021\t\t\t}\n  2022\t\t\tif _, findings, err := store.InspectAmendmentHistory(*sp); err != nil || len(findings) > 0 {\n  2023\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: amendment history gate failed: %v %s\", err, strings.Join(findings, \"; \")))\n  2024\t\t\t\treturn 1\n  2025\t\t\t}\n  2026\t\t\t// The exit gate of a spec is its requirement trace: closing marks it\n  2027\t\t\t// done, and a done spec whose promises point at no evidence fails\n  2028\t\t\t// lint. Refusing here keeps `pose close` from producing what the\n  2029\t\t\t// next lint rejects (spec pose-quickstart-real-lifecycle).\n  2030\t\t\tif raw, err := store.FS.ReadFile(sp.Path); err == nil {\n  2031\t\t\t\tif blockers := posemodel.RequirementTraceCloseoutBlockers(string(raw)); len(blockers) > 0 {\n  2032\t\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate failed: \" + strings.Join(blockers, \"; \") + \" — declare each under `### Requirement trace`, e.g. `- R1 [satisfied] test:<TestName>`, or [waived: <reason>] / [withdrawn: <reason>]\")\n  2033\t\t\t\t\treturn 1\n  2034\t\t\t\t}\n  2035\t\t\t\t// A test: ref must name a test that exists, or the trace points a\n  2036\t\t\t\t// promise at nothing (spec pose-trace-test-refs-resolve).\n  2037\t\t\t\tcatalog, catalogErr := posemodel.LoadTestCatalogChecked(root)\n  2038\t\t\t\tif catalogErr != nil {\n  2039\t\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate incomplete: \" + catalogErr.Error())\n  2040\t\t\t\t\treturn 1\n  2041\t\t\t\t}\n  2042\t\t\t\tif unresolved := posemodel.UnresolvedTestRefs(posemodel.ParseRequirementTrace(string(raw)), catalog); len(unresolved) > 0 {\n  2043\t\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate failed: \" + strings.Join(unresolved, \"; \") + \" names no test in this repository or its submodules — cite the test function, subtest, test title or test file\")\n  2044\t\t\t\t\treturn 1\n  2045\t\t\t\t}\n  2046\t\t\t}\n  2047\t\t\tpath = sp.Path\n  2048\t\t} else {\n  2049\t\t\tvar gateOut, gateErr bytes.Buffer\n  2050\t\t\tif code := cmdRoadmapCheck(root, []string{scope.Slug, \"--strict\"}, &gateOut, &gateErr); code != 0 {\n  2051\t\t\t\tfmt.Fprintf(stderr, \"pose close: roadmap gate failed: %s%s\", gateErr.String(), gateOut.String())\n  2052\t\t\t\treturn 1\n  2053\t\t\t}\n  2054\t\t\tpath = filepath.Join(root, \".pose\", \"roadmaps\", scope.Slug+\".md\")\n  2055\t\t}\n  2056\t\tif closeGatesJudged != nil {\n  2057\t\t\tcloseGatesJudged()\n  2058\t\t}\n  2059\t\t// Start, close and transfer of a spec share its lifecycle lock (R3).\n  2060\t\tif scope.Kind == \"spec\" {\n  2061\t\t\tunlock, err := posemodel.LockSpecLifecycle(root, scope.Slug, \"close.transition\")\n  2062\t\t\tif err != nil {\n  2063\t\t\t\tvar held *posemodel.StartLockError\n  2064\t\t\t\tif errors.As(err, &held) {\n  2065\t\t\t\t\trenderStartLock(render(stdout, stderr), scope.Slug, held)\n  2066\t\t\t\t}\n  2067\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n  2068\t\t\t\treturn 1\n  2069\t\t\t}\n  2070\t\t\tdefer unlock()\n  2071\t\t}\n  2072\t\t// The authorization is judged again inside the protected region: a\n  2073\t\t// review that stopped being approved, or an action request that now\n  2074\t\t// restricts closeout, while the gates ran does not govern this\n  2075\t\t// publication (spec pose-writer-coordination-and-atomic-publication R4).\n  2076\t\tif current, err := cliCloseoutStateForStore(store, ref); err != nil {\n  2077\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n  2078\t\t\treturn 1\n  2079\t\t} else if !(closeReviewSatisfied(current) || receiptClose != nil && !receiptClose.Required) || hasActionRequestPending(current.Diagnostics) || hasDiagnostic(current.Diagnostics, posemodel.AdjudicationDoesNotHoldCode) {\n  2080\t\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout authorization changed while its gates ran; next action: \" + current.NextAction)\n  2081\t\t\treturn 1\n  2082\t\t}\n  2083\t\tif guard != nil {\n  2084\t\t\tif err := guard(); err != nil {\n  2085\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n  2086\t\t\t\treturn 1\n  2087\t\t\t}\n  2088\t\t}\n  2089\t\tif scope.Kind == \"spec\" {\n  2090\t\t\tsp, err := store.GetSpec(scope.Slug)\n  2091\t\t\tif err != nil {\n  2092\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n  2093\t\t\t\treturn 1\n  2094\t\t\t}\n  2095\t\t\tif _, findings, err := store.InspectAmendmentHistory(*sp); err != nil || len(findings) > 0 {\n  2096\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: amendment history gate failed: %v %s\", err, strings.Join(findings, \"; \")))\n  2097\t\t\t\treturn 1\n  2098\t\t\t}\n  2099\t\t}\n  2100\t\tvar unsynced error\n  2101\t\tif err := applyLifecycleDoneIn(store.FS, path, scope.Kind == \"spec\", judged); err != nil {\n  2102\t\t\tif errors.Is(err, posemodel.ErrPublishConflict) {\n  2103\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error() + \"; the gates judged other bytes, so run `pose close \" + ref + \"` again to judge the current ones\")\n  2104\t\t\t\treturn 1\n  2105\t\t\t}\n  2106\t\t\t// The transition took effect and only its durability is unconfirmed: the\n  2107\t\t\t// scope is closed, and refusing here would say otherwise.\n  2108\t\t\tif !errors.Is(err, posemodel.ErrPublishUnsynced) {\n  2109\t\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n  2110\t\t\t\treturn 1\n  2111\t\t\t}\n  2112\t\t\tunsynced = err\n  2113\t\t\trender(stdout, stderr).Field(\"close.unsynced\", err.Error())\n  2114\t\t}\n  2115\t\tif receiptClose != nil {\n  2116\t\t\t// The status is published; the receipt is the terminal marker and\n  2117\t\t\t// comes after it. A failure here leaves the roadmap explicitly\n  2118\t\t\t// incomplete, and the next `pose close` verifies again and publishes.\n  2119\t\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, state, nil, stdout, stderr); code != 0 {\n  2120\t\t\t\treturn code\n  2121\t\t\t}\n  2122\t\t}\n  2123\t\tif transitioned != nil {\n  2124\t\t\ttransitioned(unsynced)\n  2125\t\t}\n  2126\t\tfmt.Fprintf(stdout, \"Closed: %s\\n\", ref)\n  2127\t\trenderCloseNext(render(stdout, stderr), nextCloses(store, ref))\n  2128\t\treturn 0\n  2129\t}\n  2130\t\n  2131\t// nextCloses names what the close of a scope leaves reachable: the milestones a\n  2132\t// spec finished, or the roadmap a milestone finished (spec\n  2133\t// pose-milestone-closes-when-reached R3). A failed read is reported in its place,\n  2134\t// since the close itself stands.\n  2135\tfunc nextCloses(store posemodel.Store, ref string) []string {\n  2136\t\tscope, err := posemodel.ParseScopeRef(ref)\n  2137\t\tif err != nil {\n  2138\t\t\treturn nil\n  2139\t\t}\n  2140\t\tnext := []string{}\n  2141\t\tswitch scope.Kind {\n  2142\t\tcase \"spec\":\n  2143\t\t\treached, err := store.ReachedMilestones(scope.Slug)\n  2144\t\t\tif err != nil {\n  2145\t\t\t\treturn []string{\"unavailable: \" + err.Error()}\n  2146\t\t\t}\n  2147\t\t\tfor _, milestone := range reached {\n  2148\t\t\t\tnext = append(next, \"pose close \"+milestone)\n  2149\t\t\t}\n  2150\t\t\troadmaps, err := store.RoadmapsReachedBy(scope.Slug)\n  2151\t\t\tif err != nil {\n  2152\t\t\t\treturn []string{\"unavailable: \" + err.Error()}\n  2153\t\t\t}\n  2154\t\t\tfor _, roadmap := range roadmaps {\n  2155\t\t\t\tnext = append(next, \"pose close roadmap:\"+roadmap)\n  2156\t\t\t}\n  2157\t\tcase \"milestone\":\n  2158\t\t\tif store.RoadmapReached(scope.Roadmap) {\n  2159\t\t\t\tnext = append(next, \"pose close roadmap:\"+scope.Roadmap)\n  2160\t\t\t}\n  2161\t\t}\n  2162\t\treturn next\n  2163\t}\n  2164\t\n  2165\tfunc renderCloseNext(out *cliout.Renderer, next []string) {\n  2166\t\tfor _, step := range next {\n  2167\t\t\tout.Field(\"close.next\", step)\n  2168\t\t}\n  2169\t}\n  2170\t\n  2171\ttype continuousCloseoutSelection struct {\n  2172\t\tSchemaVersion int    `json:\"schema_version\"`\n  2173\t\tScope         string `json:\"scope\"`\n  2174\t\tStartedAt     string `json:\"started_at\"`\n  2175\t\tStatus        string `json:\"status\"`\n  2176\t}\n  2177\t\n  2178\t// continuousStatusData is the payload of `continuous-closeout status`.\n  2179\ttype continuousStatusData struct {\n  2180\t\tActive   bool `json:\"active\"`\n  2181\t\tTerminal bool `json:\"terminal\"`\n  2182\t}\n  2183\t\n  2184\t// continuousCloseoutStatus reads the persisted selection and its closeout\n  2185\t// state into one result for both renderers.\n  2186\tfunc continuousCloseoutStatus(root, path string) posemodel.OperationResult {\n  2187\t\tresult := posemodel.NewOperationResult(\"continuous-closeout.status\", \"\")\n  2188\t\tdata := &continuousStatusData{}\n  2189\t\tresult.Data = data\n  2190\t\traw, err := os.ReadFile(path)\n  2191\t\tif os.IsNotExist(err) {\n  2192\t\t\tresult.Outcome = posemodel.OutcomeCompleted\n  2193\t\t\treturn result\n  2194\t\t}\n  2195\t\tif err != nil {\n  2196\t\t\tresult.Fail(posemodel.OutcomeFailed, \"\", \"selection-unreadable\", err.Error())\n  2197\t\t\treturn result\n  2198\t\t}\n  2199\t\tvar selection continuousCloseoutSelection\n  2200\t\tif err := json.Unmarshal(raw, &selection); err != nil || selection.SchemaVersion != 1 || selection.Status != \"active\" {\n  2201\t\t\tresult.Fail(posemodel.OutcomeFailed, \"\", \"selection-invalid\", \"invalid persisted selection\")\n  2202\t\t\treturn result\n  2203\t\t}\n  2204\t\tresult.Scope = selection.Scope\n  2205\t\tstate, err := cliCloseoutState(root, selection.Scope)\n  2206\t\tif err != nil {\n  2207\t\t\tresult.Fail(posemodel.OutcomeFailed, \"\", \"closeout-state-unavailable\", err.Error())\n  2208\t\t\treturn result\n  2209\t\t}\n  2210\t\tdata.Active, data.Terminal = true, state.Terminal\n  2211\t\tresult.Outcome, result.NextAction = posemodel.OutcomeCompleted, state.NextAction\n  2212\t\treturn result\n  2213\t}\n  2214\t\n  2215\tfunc cmdContinuousCloseout(root string, args []string, stdout, stderr io.Writer) int {\n  2216\t\tif len(args) == 0 {\n  2217\t\t\targs = []string{\"status\"}\n  2218\t\t}\n  2219\t\tpath := filepath.Join(root, \".pose\", \"continuous-closeout.json\")\n  2220\t\tswitch args[0] {\n  2221\t\tcase \"start\":\n  2222\t\t\tif len(args) < 2 || len(args) > 3 || len(args) == 3 && args[2] != \"--apply\" {\n  2223\t\t\t\tfmt.Fprintln(stderr, \"Usage: pose continuous-closeout start <scope> [--apply]\")\n  2224\t\t\t\treturn 2\n  2225\t\t\t}\n  2226\t\t\tref := args[1]\n  2227\t\t\tstore := cliGovernedStore(root)\n  2228\t\t\tpolicy, err := store.GetReviewPolicy()\n  2229\t\t\tif err != nil || !policy.Enabled || !policy.ContinuousCloseout {\n  2230\t\t\t\tfmt.Fprintln(stderr, \"pose continuous-closeout: continuous mode is not enabled by review policy\")\n  2231\t\t\t\treturn 1\n  2232\t\t\t}\n  2233\t\t\tif _, err := cliCloseoutState(root, ref); err != nil {\n  2234\t\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n  2235\t\t\t\treturn 1\n  2236\t\t\t}\n  2237\t\t\tselection := continuousCloseoutSelection{SchemaVersion: 1, Scope: ref, StartedAt: time.Now().UTC().Truncate(time.Second).Format(time.RFC3339), Status: \"active\"}\n  2238\t\t\tif len(args) == 2 {\n  2239\t\t\t\tfmt.Fprintf(stdout, \"continuous.scope=%s\\ncontinuous.apply=false\\n\", ref)\n  2240\t\t\t\treturn 0\n  2241\t\t\t}\n  2242\t\t\traw, _ := json.MarshalIndent(selection, \"\", \"  \")\n  2243\t\t\traw = append(raw, '\\n')\n  2244\t\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n  2245\t\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n  2246\t\t\t\treturn 1\n  2247\t\t\t}\n  2248\t\t\tif _, err := os.Stat(path); err == nil {\n  2249\t\t\t\tfmt.Fprintln(stderr, \"pose continuous-closeout: an active terminal scope already exists\")\n  2250\t\t\t\treturn 1\n  2251\t\t\t}\n  2252\t\t\tif err := writeFileExclusive(path, raw); err != nil {\n  2253\t\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n  2254\t\t\t\treturn 1\n  2255\t\t\t}\n  2256\t\t\tfmt.Fprintf(stdout, \"Continuous closeout started: %s\\n\", ref)\n  2257\t\t\treturn 0\n  2258\t\tcase \"status\":\n  2259\t\t\t// status takes only --json (spec pose-cli-mcp-operation-results R3):\n  2260\t\t\t// any other argument is refused rather than ignored.\n  2261\t\t\tjsonOutput := false\n  2262\t\t\tfor _, arg := range args[1:] {\n  2263\t\t\t\tif arg != \"--json\" {\n  2264\t\t\t\t\tfmt.Fprintln(stderr, \"Usage: pose continuous-closeout status [--json]\")\n  2265\t\t\t\t\treturn 2\n  2266\t\t\t\t}\n  2267\t\t\t\tjsonOutput = true\n  2268\t\t\t}\n  2269\t\t\tresult := continuousCloseoutStatus(root, path)\n  2270\t\t\tdata, _ := result.Data.(*continuousStatusData)\n  2271\t\t\tif jsonOutput {\n  2272\t\t\t\tif writeJSON(stdout, result) != 0 {\n  2273\t\t\t\t\treturn 1\n  2274\t\t\t\t}\n  2275\t\t\t} else if result.Outcome != posemodel.OutcomeCompleted {\n  2276\t\t\t\tfmt.Fprintln(stderr, \"pose continuous-closeout: \"+result.Error.Message)\n  2277\t\t\t} else if !data.Active {\n  2278\t\t\t\tfmt.Fprintln(stdout, \"continuous.active=false\")\n  2279\t\t\t} else {\n  2280\t\t\t\tfmt.Fprintf(stdout, \"continuous.active=true\\ncontinuous.scope=%s\\ncontinuous.terminal=%t\\ncontinuous.next_action=%s\\n\", result.Scope, data.Terminal, result.NextAction)\n  2281\t\t\t}\n  2282\t\t\t// The exit keeps its documented meaning: 1 while an active scope is\n  2283\t\t\t// not terminal. The query itself completed; readiness is in the data.\n  2284\t\t\tif result.Outcome != posemodel.OutcomeCompleted || data.Active && !data.Terminal {\n  2285\t\t\t\treturn 1\n  2286\t\t\t}\n  2287\t\t\treturn 0\n  2288\t\tcase \"complete\":\n  2289\t\t\tif len(args) != 2 || args[1] != \"--apply\" {\n  2290\t\t\t\tfmt.Fprintln(stderr, \"Usage: pose continuous-closeout complete --apply\")\n  2291\t\t\t\treturn 2\n  2292\t\t\t}\n  2293\t\t\traw, err := os.ReadFile(path)\n  2294\t\t\tif err != nil {\n  2295\t\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n  2296\t\t\t\treturn 1\n  2297\t\t\t}\n  2298\t\t\tvar selection continuousCloseoutSelection\n  2299\t\t\tif json.Unmarshal(raw, &selection) != nil {\n  2300\t\t\t\tfmt.Fprintln(stderr, \"pose continuous-closeout: invalid persisted selection\")\n  2301\t\t\t\treturn 1\n  2302\t\t\t}\n  2303\t\t\tstate, err := cliCloseoutState(root, selection.Scope)\n  2304\t\t\tif err != nil || !state.Terminal {\n  2305\t\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: terminal success is not satisfied; next action: %s\\n\", state.NextAction)\n  2306\t\t\t\treturn 1\n  2307\t\t\t}\n  2308\t\t\tif err := os.Remove(path); err != nil {\n  2309\t\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n  2310\t\t\t\treturn 1\n  2311\t\t\t}\n  2312\t\t\tfmt.Fprintf(stdout, \"Continuous closeout completed: %s\\n\", selection.Scope)\n  2313\t\t\treturn 0\n  2314\t\tdefault:\n  2315\t\t\tfmt.Fprintln(stderr, \"Usage: pose continuous-closeout <start|status|complete> [...]\")\n  2316\t\t\treturn 2\n  2317\t\t}\n  2318\t}\n  2319\t\n  2320\tfunc hasOpenChild(children []posemodel.CloseoutState) bool {\n  2321\t\tfor _, child := range children {\n  2322\t\t\tif !child.Terminal {\n  2323\t\t\t\treturn true\n  2324\t\t\t}\n  2325\t\t}\n  2326\t\treturn false\n  2327\t}\n  2328\t\n  2329\t// applyLifecycleDone marks the artifact done. It is published only over the\n  2330\t// bytes with digest judged, the ones the gates read, so an edit made while the\n  2331\t// gates ran is a conflict, never overwritten (spec\n  2332\t// pose-writer-coordination-and-atomic-publication R2/R4).\n  2333\tfunc applyLifecycleDone(path string, spec bool, judged string) error {\n  2334\t\treturn applyLifecycleDoneIn(posemodel.NativeFiles(), path, spec, judged)\n  2335\t}\n  2336\t\n  2337\tfunc applyLifecycleDoneIn(files posemodel.Files, path string, spec bool, judged string) error {\n  2338\t\traw, err := files.ReadFile(path)\n  2339\t\tif err != nil {\n  2340\t\t\treturn err\n  2341\t\t}\n  2342\t\ttext := string(raw)\n  2343\t\tif !strings.HasPrefix(text, \"---\\n\") {\n  2344\t\t\treturn fmt.Errorf(\"artifact has no flat frontmatter\")\n  2345\t\t}\n  2346\t\ttext = posemodel.ReplaceFrontmatterValue(text, \"status\", \"done\")\n  2347\t\tif spec {\n  2348\t\t\ttext = posemodel.ReplaceFrontmatterValue(text, \"completed_at\", time.Now().UTC().Format(\"2006-01-02\"))\n  2349\t\t}\n  2350\t\texpect := posemodel.ExpectBytes(raw, true)\n  2351\t\tif judged != \"\" {\n  2352\t\t\texpect.Digest = judged\n  2353\t\t}\n  2354\t\treturn files.Publish(path, []byte(text), 0o644, posemodel.PublishAuthoritative, expect)\n  2355\t}\n  2356\t\n  2357\t// closeTargetDigest is the SHA-256 of the spec or roadmap a close judges, or\n  2358\t// \"\" when it cannot be resolved here (the gates report why).\n  2359\tfunc closeTargetDigest(root string, store posemodel.Store, ref string) string {\n  2360\t\tscope, err := posemodel.ParseScopeRef(ref)\n  2361\t\tif err != nil {\n  2362\t\t\treturn \"\"\n  2363\t\t}\n  2364\t\tpath := \"\"\n  2365\t\tswitch scope.Kind {\n  2366\t\tcase \"spec\":\n  2367\t\t\tsp, err := store.GetSpec(scope.Slug)\n  2368\t\t\tif err != nil {\n  2369\t\t\t\treturn \"\"\n  2370\t\t\t}\n  2371\t\t\tpath = sp.Path\n  2372\t\tcase \"roadmap\":\n  2373\t\t\tpath = filepath.Join(root, \".pose\", \"roadmaps\", scope.Slug+\".md\")\n  2374\t\tdefault:\n  2375\t\t\treturn \"\"\n  2376\t\t}\n  2377\t\traw, err := posemodel.FilesOrNative(store.FS).ReadFile(path)\n  2378\t\tif err != nil {\n  2379\t\t\treturn \"\"\n  2380\t\t}\n  2381\t\treturn posemodel.ExpectBytes(raw, true).Digest\n  2382\t}\n  2383\t\n  2384\t// hasActionRequestPending reports a governed action request that restricts\n  2385\t// the closeout.\n  2386\t// hasDiagnostic reports whether diagnostics carry code.\n  2387\tfunc hasDiagnostic(diagnostics []posemodel.Diagnostic, code string) bool {\n  2388\t\tfor _, d := range diagnostics {\n  2389\t\t\tif d.Code == code {\n  2390\t\t\t\treturn true\n  2391\t\t\t}\n  2392\t\t}\n  2393\t\treturn false\n  2394\t}\n  2395\t\n  2396\tfunc hasActionRequestPending(diagnostics []posemodel.Diagnostic) bool {\n  2397\t\tfor _, d := range diagnostics {\n  2398\t\t\tif d.Code == \"action-request-pending\" {\n  2399\t\t\t\treturn true\n  2400\t\t\t}\n  2401\t\t}\n  2402\t\treturn false\n  2403\t}\n  2404\t\n  2405\t// closeGatesJudged, when set, runs after the close gates judged the scope and\n  2406\t// before the protected region. Only tests set it, to change the repository\n  2407\t// at that point.\n  2408\tvar closeGatesJudged func()\n  2409\t\n  2410\t// closeReviewSatisfied is the review half of close eligibility: an approval,\n  2411\t// or a review the adopted closeout review policy does not require.\n  2412\tfunc closeReviewSatisfied(state posemodel.CloseoutState) bool {\n  2413\t\treturn state.Review.Approved || state.Review.CloseoutReview != nil && !state.Review.Required\n  2414\t}\n  2415\t\n  2416\t// closeoutReceiptPreflight decides whether this close publishes a receipt.\n  2417\t// It returns the decision to record (nil: legacy close) and an exit code, or\n  2418\t// -1 to go on. A done roadmap with no receipt is the incomplete case: its\n  2419\t// decision is evaluated again over the current inputs.\n  2420\tfunc closeoutReceiptPreflight(store posemodel.Store, ref string, scope posemodel.ScopeRef, state *posemodel.CloseoutState, stdout, stderr io.Writer) (*posemodel.CloseoutReviewDecision, int) {\n  2421\t\tif scope.Kind != \"milestone\" && scope.Kind != \"roadmap\" {\n  2422\t\t\treturn nil, -1\n  2423\t\t}\n  2424\t\tpolicy, err := store.GetReviewPolicy()\n  2425\t\tif err != nil {\n  2426\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n  2427\t\t\treturn nil, 1\n  2428\t\t}\n  2429\t\tif !policy.CloseoutReviewAdopted() {\n  2430\t\t\treturn nil, -1\n  2431\t\t}\n  2432\t\tif state.CloseoutReceipt != nil {\n  2433\t\t\treceipt := state.CloseoutReceipt\n  2434\t\t\tout := render(stdout, stderr)\n  2435\t\t\tout.Field(\"close.already-satisfied\", ref+\"; closeout receipt of \"+receipt.ClosedAt+\" stands (review: \"+receipt.Review+\"); no transition executed\")\n  2436\t\t\treturn nil, 0\n  2437\t\t}\n  2438\t\tdecision := state.Review.CloseoutReview\n  2439\t\tif decision == nil {\n  2440\t\t\tif scope.Kind != \"roadmap\" || !state.LifecycleDone {\n  2441\t\t\t\treturn nil, -1\n  2442\t\t\t}\n  2443\t\t\tevaluated, err := store.EvaluateCloseoutReview(ref)\n  2444\t\t\tif err != nil {\n  2445\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n  2446\t\t\t\treturn nil, 1\n  2447\t\t\t}\n  2448\t\t\tdecision = &evaluated\n  2449\t\t\tif !evaluated.Required && !state.Review.Approved {\n  2450\t\t\t\tstate.Review.CloseoutReview = decision\n  2451\t\t\t\tstate.Review.Required = false\n  2452\t\t\t}\n  2453\t\t}\n  2454\t\tif !decision.Known {\n  2455\t\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout review of \" + ref + \" cannot be decided: \" + strings.Join(decision.Diagnostics, \"; \"))\n  2456\t\t\treturn nil, 1\n  2457\t\t}\n  2458\t\trender(stdout, stderr).Field(\"close.review\", decision.Review()+\" (\"+decision.PolicyKey+\"=\"+decision.PolicyValue+\", \"+decision.Reason+\")\")\n  2459\t\treturn decision, -1\n  2460\t}\n  2461\t\n  2462\t// publishCloseoutReceipt publishes the receipt of a close after judging the\n  2463\t// authorization once more inside the protected region.\n  2464\tfunc publishCloseoutReceipt(store posemodel.Store, ref string, decision posemodel.CloseoutReviewDecision, judged posemodel.CloseoutState, guard func() error, stdout, stderr io.Writer) int {\n  2465\t\tif guard != nil {\n  2466\t\t\tif err := guard(); err != nil {\n  2467\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n  2468\t\t\t\treturn 1\n  2469\t\t\t}\n  2470\t\t}\n  2471\t\tif current, err := store.EvaluateCloseoutReview(ref); err != nil {\n  2472\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n  2473\t\t\treturn 1\n  2474\t\t} else if current.Required != decision.Required || strings.Join(current.Members, \",\") != strings.Join(decision.Members, \",\") || current.PolicyValue != decision.PolicyValue {\n  2475\t\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout review decision of \" + ref + \" changed while its gates ran; run `pose close \" + ref + \"` again\")\n  2476\t\t\treturn 1\n  2477\t\t}\n  2478\t\treceipt, err := store.NewCloseoutReceipt(ref, decision, judged.Review, judged.ScopeDigest, time.Now())\n  2479\t\tif err != nil {\n  2480\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n  2481\t\t\treturn 1\n  2482\t\t}\n  2483\t\tif err := store.PublishCloseoutReceipt(receipt); err != nil {\n  2484\t\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n  2485\t\t\t\trender(stdout, stderr).Field(\"close.unsynced\", err.Error())\n  2486\t\t\t} else {\n  2487\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: closeout receipt not published: \" + err.Error() + \"; `pose close \" + ref + \"` verifies again and publishes it\")\n  2488\t\t\t\treturn 1\n  2489\t\t\t}\n  2490\t\t}\n  2491\t\trender(stdout, stderr).Field(\"close.receipt\", \"review: \"+receipt.Review+\"; \"+decision.PolicyKey+\"=\"+decision.PolicyValue+\"; \"+decision.Reason)\n  2492\t\treturn 0\n  2493\t}\n","exit_code":0,"status":"completed"}}
