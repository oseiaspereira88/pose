{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '3400,3510p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"\nfunc (s Store) VerifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tverification, err := s.verifyReviewBundle(scope)\n\tif err == nil && verification.Bundle != nil {\n\t\tassurance := s.DescribeReviewAssurance(*verification.Bundle, verification.Attestation)\n\t\tverification.Assurance = &assurance\n\t}\n\tif err == nil {\n\t\tverification.DelegatedRuns, verification.DelegatedHistoryLosses = s.reviewRunSummaries(scope)\n\t}\n\tif err == nil && verification.Bundle != nil {\n\t\tif round, rerr := s.ReviewRoundOf(*verification.Bundle); rerr != nil {\n\t\t\tverification.DelegatedHistoryLosses = append(verification.DelegatedHistoryLosses, \"the round cannot be derived: \"+rerr.Error())\n\t\t} else {\n\t\t\tverification.Round = round.Number\n\t\t\tpolicy, _, _, _ := s.LoadDelegationPolicy()\n\t\t\tif threshold := policy.Routing.RoundThresholdOf(); round.Number >= threshold {\n\t\t\t\tverification.Warnings = append(verification.Warnings, fmt.Sprintf(\"%s is in review round %d, at or past the round threshold %d: the rounds are not converging; consider a different agent or a human adjudication\", scope, round.Number, threshold))\n\t\t\t}\n\t\t}\n\t}\n\treturn verification, err\n}\n\n// verifyReviewBundle verifies scope once per operation of the same project and\n// resolver, and refuses a scope already being verified: sealed children are\n// data, and a cycle among them must end in a named refusal (spec\n// pose-review-approval-follows-children R6).\nfunc (s Store) verifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tstate := s.reviewReuse\n\tkey := fmt.Sprintf(\"%s\\x00%t\\x00%s\", s.Root, s.FederatedResolver != nil, scope)\n\tif result, ok := state.children[key]; ok {\n\t\treturn result.verification, result.err\n\t}\n\tif state.verifying[key] {\n\t\treturn ReviewBundleVerification{}, fmt.Errorf(\"pose: the sealed children of %s form a cycle\", scope)\n\t}\n\tstate.verifying[key] = true\n\tdefer delete(state.verifying, key)\n\tif s.onReviewVerify != nil {\n\t\ts.onReviewVerify(scope)\n\t}\n\tverification, err := s.proportionalReviewVerification(scope)\n\tstate.children[key] = childVerificationResult{verification, err}\n\treturn verification, err\n}\n\n// proportionalReviewVerification is the verification of a scope, and of a milestone that\n// owes no review of its own: one made of a single closed, approved spec, or one a roadmap\n// declares. Every reader of an approval comes through here, so they give one answer (ADR\n// a-milestone-of-one-member-is-that-member). A negative review recorded on it stands.\nfunc (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerification, error) {\n\town, err := s.computeReviewVerification(scope)\n\tif err != nil || own.Approved {\n\t\treturn own, err\n\t}\n\tref, parseErr := ParseScopeRef(scope)\n\tif parseErr != nil || (ref.Kind != \"milestone\" && ref.Kind != \"roadmap\") {\n\t\treturn own, nil\n\t}\n\t// A policy without bundles answers through its review attempts alone, and has no\n\t// bundle of the spec to stand on.\n\tpolicy, err := s.GetReviewPolicy()\n\tif err != nil || !policy.ReviewBundles {\n\t\treturn own, nil\n\t}\n\tif s.milestoneReviewRefused(scope) {\n\t\treturn own, nil\n\t}\n\t// An adopted closeout review policy is the only rule for an open scope:\n\t// legacy inheritance and declared exemptions cannot weaken `always`, and\n\t// the policy's own exemption reads the same gate as reviewCheck. A roadmap\n\t// closed before adoption keeps the legacy reading below.\n\tadopted := policy.CloseoutReviewAdopted() && !s.closeoutScopeHistorical(ref)\n\tif adopted {\n\t\tdecision, exempt, gateErr := s.closeoutReviewGate(scope, policy)\n\t\tif gateErr != nil || decision == nil || !exempt || !decision.Known {\n\t\t\treturn own, nil\n\t\t}\n\t\tif ref.Kind == \"milestone\" && s.FederatedResolver != nil {\n\t\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n\t\t\tif err != nil || !acceptance.Ready {\n\t\t\t\treturn own, nil\n\t\t\t}\n\t\t}\n\t\treturn ReviewBundleVerification{\n\t\t\tScope: scope, State: \"closed\", Fresh: true, Approved: true, NextAction: \"none\",\n\t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n\t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n\t\t}, nil\n\t}\n\tif ref.Kind != \"milestone\" {\n\t\treturn own, nil\n\t}\n\t// Edges still bind: a milestone inherits a review, not the acceptance of what it\n\t// depends on, and revoked trust or an open predecessor leaves it where it was.\n\tif s.FederatedResolver != nil {\n\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n\t\tif err != nil || !acceptance.Ready {\n\t\t\treturn own, nil\n\t\t}\n\t}\n\tif member, ok := s.soleMemberOf(ref); ok {\n\t\tchild, err := s.verifyReviewBundle(\"spec:\" + member)\n\t\tif err == nil && child.State == \"closed\" && child.Fresh && child.Approved {\n\t\t\treturn ReviewBundleVerification{\n\t\t\t\tScope: scope, State: \"closed\", Bundle: child.Bundle, Attestation: child.Attestation, Fresh: true, Approved: true,\n\t\t\t\tNextAction: \"none\", Warnings: []string{\"the approval of \" + scope + \" is inherited from spec:\" + member + \", its only member\"},\n\t\t\t\tApprovalOrigin: \"inherited:spec:\" + member, inherited: true,\n","exit_code":0,"status":"completed"}}
