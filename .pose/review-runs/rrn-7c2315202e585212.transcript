hemaVersion == SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 1 || policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 0\n\t\trefsCompatible := policy.RefsVersion == 0 || policy.RefsVersion == 1 && refsRequired\n\t\tif policy.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n\t\t\t// Schema 5 (closeout review pair) keeps references and transfer\n\t\t\t// optional: 0, or 1 as schemas 3 and 4 define them.\n\t\t\trefsCompatible = policy.RefsVersion == 0 || policy.RefsVersion == 1\n\t\t\ttransferValid = policy.TransferVersion == 0 || policy.TransferVersion == 1 && policy.RefsVersion == 1\n\t\t}\n\t\tif !refsCompatible || refsRequired && policy.RefsVersion != 1 || policy.SchemaVersion > CloseoutReviewPolicySchemaVersion || !transferValid {\n\t\t\tout.State = \"unsupported-artifact-contract\"\n\t\t\treturn out\n\t\t}\n\t} else if !os.IsNotExist(err) {\n\t\tout.State = \"unavailable-project\"\n\t\treturn out\n\t}\n\tvar body string\n\tvar deps []string\n\tswitch ref.Kind {\n\tcase \"spec\":\n\t\tredirect, found, err := readSpecTransferRedirect(r.fsys(), s, ref)\n\t\tif err != nil {\n\t\t\tout.State = \"invalid-spec-redirect\"\n\t\t\treturn out\n\t\t}\n\t\tif found {\n\t\t\tkey := ref.String()\n\t\t\tmaxDepth := 16\n\t\t\tif r.governanceDepthLimit > 0 {\n\t\t\t\tmaxDepth = r.governanceDepthLimit\n\t\t\t}\n\t\t\tif redirectPath[key] {\n\t\t\t\tout.State = \"redirect-cycle\"\n\t\t\t\treturn out\n\t\t\t}\n\t\t\tif redirectDepth >= maxDepth {\n\t\t\t\tr.markResolutionBudgetUnknown(ref.Project, \"artifact redirect chain exceeded its depth budget\")\n\t\t\t\tout.State = \"resolution-limit\"\n\t\t\t\treturn out\n\t\t\t}\n\t\t\tredirectPath[key] = true\n\t\t\ttarget := r.resolve(redirect.Destination.Project, redirect.Destination.String(), redirectPath, redirectDepth+1)\n\t\t\tdelete(redirectPath, key)\n\t\t\tif !target.Resolved {\n","exit_code":0,"status":"completed"}}
