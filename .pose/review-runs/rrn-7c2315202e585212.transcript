{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,130p' pose-mcp/cmd/pose/main.go\"","aggregated_output":"// pose is the native-only unified POSE CLI and MCP server.\npackage main\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/harne8/pose-mcp/internal/cli\"\n)\n\nfunc main() {\n\tif base := filepath.Base(os.Args[0]); base == \"pre-commit\" || base == \"post-merge\" {\n\t\tos.Exit(cli.HookMain(base, os.Stdout, os.Stderr))\n\t}\n\tos.Exit(cli.Main(os.Args[1:], os.Stdout, os.Stderr))\n}\n","exit_code":0,"status":"completed"}}
