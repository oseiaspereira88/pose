pported schema_version %d\", receipt.SchemaVersion)\n108 \t}\n109 \tif _, valid := reviewInstant(receipt.ClosedAt); !valid {\n110 \t\treturn receipt, fmt.Errorf(\"closed_at %q is not an instant\", receipt.ClosedAt)\n111 \t}\n112 \td := receipt.Decision\n113 \tif !d.Adopted || d.EvaluatorVersion != CloseoutReviewEvaluatorVersion || !validCloseoutReviewValue(d.PolicyValue) || d.Reason == \"\" {\n114 \t\treturn receipt, errors.New(\"decision is not one of \" + CloseoutReviewEvaluatorVersion)\n115 \t}\n116 \tif receipt.Review != d.Review() {\n117 \t\treturn receipt, fmt.Errorf(\"review %q contradicts the recorded decision (%s)\", receipt.Review, d.Review())\n118 \t}\n119 \tif d.Required && receipt.ReviewBundle == \"\" && receipt.ApprovalOrigin == \"\" {\n120 \t\treturn receipt, errors.New(\"a required review names no verified review\")\n121 \t}\n122 \tif !d.Known {\n123 \t\treturn receipt, errors.New(\"a close cannot stand on unknown members or associations\")\n124 \t}\n125 \tif receipt.PolicyDigest == \"\" || receipt.SubjectDigest == \"\" {\n126 \t\treturn receipt, errors.New(\"policy_digest and subject_digest are required\")\n127 \t}\n128 \treturn receipt, nil\n129 }\n130 \n131 // NewCloseoutReceipt builds the receipt of a close from the evaluator's\n","exit_code":0,"status":"completed"}}
