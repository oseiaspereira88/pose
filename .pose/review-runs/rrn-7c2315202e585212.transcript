re_test.go:120:\t\tt.Skip(\"set POSE_RUNTIME_MEASURE=<output file> to measure the runtime on this repository\")\npose-mcp/internal/cli/runtime_measure_test.go:126:\tspec := os.Getenv(\"POSE_RUNTIME_MEASURE_SPEC\")\npose-mcp/internal/cli/runtime_measure_test.go:136:\tenv := append(os.Environ(), \"POSE_RUNTIME_DIR=\"+rtDir+\"/r\")\npose-mcp/internal/cli/runtime_measure_test.go:184:\t// S1: cold, standalone, a new process each time.\npose-mcp/internal/cli/runtime_measure_test.go:191:\t\trep.Scenarios[\"cold_standalone\"] = append(rep.Scenarios[\"cold_standalone\"], ms)\npose-mcp/internal/cli/runtime_measure_test.go:193:\t\t\tt.Fatalf(\"standalone output changed between samples %d and 0\", i)\npose-mcp/internal/cli/runtime_measure_test.go:196:\tcold := measureMedian(rep.Scenarios[\"cold_standalone\"])\npose-mcp/internal/cli/runtime_measure_test.go:202:\t\tif via != \"standalone\" || o != coldOut {\npose-mcp/internal/cli/runtime_measure_test.go:249:\t\t\tt.Fatalf(\"a hosted run: via %q, same output as standalone %v\", via, o == coldOut)\npose-mcp/internal/cli/runtime_measure_test.go:273:\t\t\tt.Fatalf(\"a short query went %s, same output as standalone %v\", via, so == shortStandalone)\npose-mcp/internal/cli/runtime_measure_test.go:285:\t\t\tt.Fatalf(\"a short query under load went %s, same output as standalone %v\", via, so == shortStandalone)\npose-mcp/internal/cli/runtime_measure_test.go:307:\t\tfail(\"T7 two simultaneous heavy checks\", \"via %v, outputs equal to standalone %v %v\", twoVia, two[0] == coldOut, two[1] == coldOut)\npose-mcp/internal/cli/runtime_measure_test.go:309:\t\tpass(\"T7 two simultaneous heavy checks\", \"both through the runtime with the standalone output; wall %d ms <= %.1f x %d ms\", twoWall, thresholdTwoHeavyOverOne, warm)\npose-mcp/internal/cli/runtime_measure_test.go:378:\tpass(\"T5 output\", \"every hosted run, the review-check and the short query idle and under load, printed exactly what the standalone run printed (%d and %d bytes)\", len(