mmandRunningPast -count=1\n  <- resident-cache-integration pass 0.0s\n  -> audit-pure-git-integration go test ./internal/pose -run TestOnlyReadsThatCannotDependOnMutableStateAreClassifiedPure|TestTheFinalAuditSkipsPureReads|GovernanceReadViewGit -count=1\n  <- audit-pure-git-integration pass 0.0s\n  -> index-input-binding-integration go test ./internal/pose -run TestAnOperationReadsTheTransferPlans -count=1\n  <- index-input-binding-integration pass 0.0s\n  -> optional-worktree-runtime-integration go test -race ./internal/worktreeruntime ./internal/cli -run TheIdentityNamesTheWorktree|TheEndpointIsProtected|TheLifecycleDrains|WithNoRuntimeTheClient|TestRuntimeCommands|ConcurrentStartsLeaveOne|AStopAcceptsNothing|RuntimeThatOutlives|AStopReports -count=1\n  <- optional-worktree-runtime-integration pass 0.0s\n  -> claude-sandboxed-profile-integration go test -race ./internal/pose ./internal/cli -run TestTheClaudeAgentDeclaresASandboxedProfile|TestTheSandboxedProfile|TestTheDelegationPolicyReports|TestDelegateAgentsAndDoctorSay -count=1\n  <- claude-sandboxed-profile-integration pass 0.0s\n  -> delegate-picker-integration go test -race ./internal/cli -run TestThePickerPreview|TestTheStateGlyph|TestDelegateWatchPicksARun -count=1\n  <- delegate-picker-integration pass 0.0s\n  -> review-brief-templates-are-immutable-integration go test -race ./internal/pose -run TestEveryReviewBriefTemplateVersion|TestTheDigestSeesEverySectionOfEveryVariant -count=1\n  <- review-brief-templates-are-immutable-integration pass 0.0s\n  -> delegated-approval-survives-routine-drift-integration go test -race ./internal/pose -run ADelegatedApproval|ARetainedDelegatedApproval|TheAssuranceOfARetained|ConcludeReviewRunRecordsTheAttestation -count=1\n  <- delegated-approval-survives-routine-drift-integration pass 0.0s\n  -> help-lists-every-command-integration go test -race ./internal/cli -run TestPoseHelp|TestTheManualsDocumentEveryCommand|TestTheHelpReaderIgnores -count=1\n  <- help-lists-every-c