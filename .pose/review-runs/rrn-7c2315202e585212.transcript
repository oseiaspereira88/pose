{"type":"item.completed","item":{"id":"item_99","type":"command_execution","command":"/usr/bin/bash -lc \"python3 -c 'from pathlib import Path; blocks={\\\"pose-mcp/internal/cli/review_closeout.go\\\":[(2424,2493)],\\\"pose-mcp/internal/pose/closeout_adr_associations.go\\\":[(80,154)],\\\"pose-mcp/internal/cli/surface_check.go\\\":[(410,432)],\\\"pose-mcp/internal/pose/review_plan.go\\\":[(395,413)]}; [(print(\\\"FILE \\\"+p),[print(str(i)+\\\" \\\"+lines[i-1]) for a,b in ranges for i in range(a,b+1)]) for p,ranges in blocks.items() for lines in [Path(p).read_text().splitlines()]]'\"","aggregated_output":"FILE pose-mcp/internal/cli/review_closeout.go\n2424 \tpolicy, err := store.GetReviewPolicy()\n2425 \tif err != nil {\n2426 \t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n2427 \t\treturn nil, 1\n2428 \t}\n2429 \tif !policy.CloseoutReviewAdopted() {\n2430 \t\treturn nil, -1\n2431 \t}\n2432 \tif state.CloseoutReceipt != nil {\n2433 \t\treceipt := state.CloseoutReceipt\n2434 \t\tout := render(stdout, stderr)\n2435 \t\tout.Field(\"close.already-satisfied\", ref+\"; closeout receipt of \"+receipt.ClosedAt+\" stands (review: \"+receipt.Review+\"); no transition executed\")\n2436 \t\treturn nil, 0\n2437 \t}\n2438 \tdecision := state.Review.CloseoutReview\n2439 \tif decision == nil {\n2440 \t\tif scope.Kind != \"roadmap\" || !state.LifecycleDone {\n2441 \t\t\treturn nil, -1\n2442 \t\t}\n2443 \t\tevaluated, err := store.EvaluateCloseoutReview(ref)\n2444 \t\tif err != nil {\n2445 \t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n2446 \t\t\treturn nil, 1\n2447 \t\t}\n2448 \t\tdecision = &evaluated\n2449 \t\tif !evaluated.Required && !state.Review.Approved {\n2450 \t\t\tstate.Review.CloseoutReview = decision\n2451 \t\t\tstate.Review.Required = false\n2452 \t\t}\n2453 \t}\n2454 \tif !decision.Known {\n2455 \t\trender(io.Discard, stderr).Failure(\"pose close: the closeout review of \" + ref + \" cannot be decided: \" + strings.Join(decision.Diagnostics, \"; \"))\n2456 \t\treturn nil, 1\n2457 \t}\n2458 \trender(stdout, stderr).Field(\"close.review\", decision.Review()+\" (\"+decision.PolicyKey+\"=\"+decision.PolicyValue+\", \"+decision.Reason+\")\")\n2459 \treturn decision, -1\n2460 }\n2461 \n2462 // publishCloseoutReceipt publishes the receipt of a close after judging the\n2463 // authorization once more inside the protected region.\n2464 func publishCloseoutReceipt(store posemodel.Store, ref string, decision posemodel.CloseoutReviewDecision, judged posemodel.CloseoutState, guard func() error, stdout, stderr io.Writer) int {\n2465 \tif guard != nil {\n2466 \t\tif err := guard(); err != nil {\n2467 \t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n2468 \t\t\treturn 1\n2469 \t\t}\n2470 \t}\n2471 \tif current, err := store.EvaluateCloseoutReview(ref); err != nil {\n2472 \t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n2473 \t\treturn 1\n2474 \t} else if current.Required != decision.Required || strings.Join(current.Members, \",\") != strings.Join(decision.Members, \",\") || current.PolicyValue != decision.PolicyValue {\n2475 \t\trender(io.Discard, stderr).Failure(\"pose close: the closeout review decision of \" + ref + \" changed while its gates ran; run `pose close \" + ref + \"` again\")\n2476 \t\treturn 1\n2477 \t}\n2478 \treceipt, err := store.NewCloseoutReceipt(ref, decision, judged.Review, judged.ScopeDigest, time.Now())\n2479 \tif err != nil {\n2480 \t\trender(io.Discard, stderr).Failure(\"pose close: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n2481 \t\treturn 1\n2482 \t}\n2483 \tif err := store.PublishCloseoutReceipt(receipt); err != nil {\n2484 \t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n2485 \t\t\trender(stdout, stderr).Field(\"close.unsynced\", err.Error())\n2486 \t\t} else {\n2487 \t\t\trender(io.Discard, stderr).Failure(\"pose close: closeout receipt not published: \" + err.Error() + \"; `pose close \" + ref + \"` verifies again and publishes it\")\n2488 \t\t\treturn 1\n2489 \t\t}\n2490 \t}\n2491 \trender(stdout, stderr).Field(\"close.receipt\", \"review: \"+receipt.Review+\"; \"+decision.PolicyKey+\"=\"+decision.PolicyValue+\"; \"+decision.Reason)\n2492 \treturn 0\n2493 }\nFILE pose-mcp/internal/pose/closeout_adr_associations.go\n80 \t}\n81 \treturn nil\n82 }\n83 \n84 // closeoutADRAssociations returns the sorted ADR basenames associated with a\n85 // roadmap, and the diagnostics that make the answer unknown.\n86 func (s Store) closeoutADRAssociations(rm *Roadmap, project string) ([]string, []string) {\n87 \tfound := map[string]bool{}\n88 \tdiagnostics := []string{}\n89 \tif rm.ADRs != \"\" {\n90 \t\tvalue := strings.TrimSpace(rm.ADRs)\n91 \t\tif !strings.HasPrefix(value, \"[\") || !strings.HasSuffix(value, \"]\") {\n92 \t\t\tdiagnostics = append(diagnostics, \"roadmap \"+rm.Slug+\" declares adrs: outside a [list]\")\n93 \t\t} else {\n94 \t\t\tfor _, item := range parseInlineList(value) {\n95 \t\t\t\tname, ok := strings.CutPrefix(item, \"adr:\")\n96 \t\t\t\tif !ok || !validADRBasename(name) {\n97 \t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares %q, not adr:<file>.md\", rm.Slug, item))\n98 \t\t\t\t\tcontinue\n99 \t\t\t\t}\n100 \t\t\t\tif err := s.regularADR(name); err != nil {\n101 \t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares adr:%s, which cannot be read: %v\", rm.Slug, name, err))\n102 \t\t\t\t\tcontinue\n103 \t\t\t\t}\n104 \t\t\t\tfound[name] = true\n105 \t\t\t}\n106 \t\t}\n107 \t}\n108 \tbody := rm.Body\n109 \tif body == \"\" {\n110 \t\tif full, err := s.GetRoadmap(rm.Slug); err == nil {\n111 \t\t\tbody = full.Body\n112 \t\t}\n113 \t}\n114 \troadmapDir := filepath.Dir(rm.Path)\n115 \tfor _, dest := range markdownLinkDestinations(body) {\n116 \t\ttarget := filepath.Clean(filepath.Join(roadmapDir, filepath.FromSlash(dest)))\n117 \t\tif filepath.Dir(target) != filepath.Clean(s.adrDir()) || !strings.HasSuffix(target, \".md\") {\n118 \t\t\tcontinue\n119 \t\t}\n120 \t\tname := filepath.Base(target)\n121 \t\tif err := s.regularADR(name); err != nil {\n122 \t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, which cannot be read: %v\", rm.Slug, dest, err))\n123 \t\t\tcontinue\n124 \t\t}\n125 \t\tfound[name] = true\n126 \t}\n127 \tentries, err := s.fsys().ReadDir(s.adrDir())\n128 \tif err != nil && !os.IsNotExist(err) {\n129 \t\tdiagnostics = append(diagnostics, \"the ADR inventory could not be read: \"+err.Error())\n130 \t}\n131 \tif len(entries) > closeoutADRInventoryLimit {\n132 \t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"the ADR inventory has %d entries, above the limit of %d\", len(entries), closeoutADRInventoryLimit))\n133 \t\tentries = nil\n134 \t}\n135 \troadmapPath := filepath.Clean(filepath.Join(s.roadmapsDir(), rm.Slug+\".md\"))\n136 \tfor _, entry := range entries {\n137 \t\tname := entry.Name()\n138 \t\tif entry.IsDir() || !strings.HasSuffix(name, \".md\") || strings.EqualFold(name, \"README.md\") || found[name] {\n139 \t\t\tcontinue\n140 \t\t}\n141 \t\tif err := s.regularADR(name); err != nil {\n142 \t\t\tcontinue // not an ADR record this inventory reads; a link to it is judged above\n143 \t\t}\n144 \t\tpath := filepath.Join(s.adrDir(), name)\n145 \t\tif info, err := s.fsys().Lstat(path); err != nil || info.Size() > closeoutADRSizeLimit {\n146 \t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is unreadable or above the size limit\")\n147 \t\t\tcontinue\n148 \t\t}\n149 \t\traw, err := s.fsys().ReadFile(path)\n150 \t\tif err != nil {\n151 \t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" could not be read: \"+err.Error())\n152 \t\t\tcontinue\n153 \t\t}\n154 \t\tfm, adrBody := SplitFrontmatter(string(raw))\nFILE pose-mcp/internal/cli/surface_check.go\n410 \t\t\t}\n411 \t\t}\n412 \t}\n413 \tif !found {\n414 \t\treturn result, fmt.Errorf(\"milestone %s not found in roadmap %s\", milestone, slug)\n415 \t}\n416 \tresult.roadmap, result.criteria, result.federated, result.blockers, result.graph = roadmap, criteria, federated, blockers, graph\n417 \treturn result, nil\n418 }\n419 \n420 // focusSurfaceGraph narrows a graph to one spec without consuming it.\n421 //\n422 // It used to filter into `graph.Deliveries[:0]` and `graph.Findings[:0]`. The graph\n423 // arrives by value, which reads as a copy and is not one for a slice: those writes\n424 // went through the caller's backing array, so focusing truncated the graph the\n425 // caller still held and a second focus saw the residue of the first. That is why\n426 // the graph could only ever be built for one spec at a time, and rebuilding it per\n427 // spec is what made `check --strict` spend 600 of its 635 seconds in\n428 // checkDeliveryContracts on this repository.\n429 func focusSurfaceGraph(graph posemodel.DeliveryIntegrityGraph, spec string) posemodel.DeliveryIntegrityGraph {\n430 \tdeliveries := []posemodel.DeliveryTarget{}\n431 \trefs := map[string]bool{}\n432 \tfor _, target := range graph.Deliveries {\nFILE pose-mcp/internal/pose/review_plan.go\n395 \t\tif reviewBandRank[band.Band] > reviewBandRank[plan.Band] {\n396 \t\t\tplan.Band = band.Band\n397 \t\t}\n398 \t}\n399 \tplan.Projection = projectDeclaredReviewObligations(plan, scope, base, floor, overlays, context)\n400 \tplan.PlanDigest, err = digestReviewPlan(plan)\n401 \tif err != nil {\n402 \t\treturn ReviewPlan{}, err\n403 \t}\n404 \tif decision, _, gateErr := s.closeoutReviewGate(ref, policy); gateErr == nil && decision != nil {\n405 \t\t// Warnings and Explain enter the digest; the decision does not, so it\n406 \t\t// is attached only as its own field.\n407 \t\tplan.CloseoutReview = decision\n408 \t}\n409 \treturn plan, nil\n410 }\n411 \n412 func (s Store) resolveReviewPlanContext(scope ScopeRef) (reviewPlanContext, error) {\n413 \t// One generation for the whole plan: the component map and the observed\n","exit_code":0,"status":"completed"}}
