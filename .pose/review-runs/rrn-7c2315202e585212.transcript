{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/closeout_review_policy.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Closeout review policy by cost and benefit (spec\n     4\t// pose-closeout-review-policy-by-cost-benefit, ADR\n     5\t// closeout-review-policy-by-cost-and-benefit). An instance that adopts review\n     6\t// policy schema 5 decides, per aggregate scope kind, whether the close of a\n     7\t// milestone or a roadmap owes its own independent review. Closing stays\n     8\t// explicit in every mode; what changes is only the review of the aggregate.\n     9\t// One evaluator answers for every reader, so plan, verification, state,\n    10\t// doctor and close cannot disagree about the threshold.\n    11\t\n    12\timport (\n    13\t\t\"encoding/json\"\n    14\t\t\"fmt\"\n    15\t\t\"sort\"\n    16\t\t\"strings\"\n    17\t)\n    18\t\n    19\tconst (\n    20\t\tCloseoutReviewNever         = \"never\"\n    21\t\tCloseoutReviewWhenJustified = \"when-justified\"\n    22\t\tCloseoutReviewAlways        = \"always\"\n    23\t\n    24\t\tCloseoutReviewEvaluatorVersion = \"closeout-review@1\"\n    25\t\n    26\t\tMilestoneReviewRequiredKey = \"milestone_review_required\"\n    27\t\tRoadmapReviewRequiredKey   = \"roadmap_review_required\"\n    28\t\n    29\t\t// The when-justified thresholds the maintainer chose: a milestone owes a\n    30\t\t// review with more than two distinct specs; a roadmap with more than one\n    31\t\t// distinct spec and at least one ADR association.\n    32\t\tcloseoutMilestoneMemberThreshold = 2\n    33\t\tcloseoutRoadmapMemberThreshold   = 1\n    34\t)\n    35\t\n    36\tfunc validCloseoutReviewValue(value string) bool {\n    37\t\tswitch value {\n    38\t\tcase CloseoutReviewNever, CloseoutReviewWhenJustified, CloseoutReviewAlways:\n    39\t\t\treturn true\n    40\t\t}\n    41\t\treturn false\n    42\t}\n    43\t\n    44\t// validateCloseoutReviewPolicyKeys refuses the pair outside schema 5, and\n    45\t// under schema 5 refuses a missing, null, mistyped, duplicated or unknown value\n    46\t// before anything plans or writes against it.\n    47\tfunc validateCloseoutReviewPolicyKeys(raw []byte, fields map[string]json.RawMessage, schema int) error {\n    48\t\t_, hasMilestone := fields[MilestoneReviewRequiredKey]\n    49\t\t_, hasRoadmap := fields[RoadmapReviewRequiredKey]\n    50\t\tif schema != CloseoutReviewPolicySchemaVersion {\n    51\t\t\tif hasMilestone || hasRoadmap {\n    52\t\t\t\treturn fmt.Errorf(\"pose: %s and %s require review policy schema %d\", MilestoneReviewRequiredKey, RoadmapReviewRequiredKey, CloseoutReviewPolicySchemaVersion)\n    53\t\t\t}\n    54\t\t\treturn nil\n    55\t\t}\n    56\t\tif err := rejectDuplicateJSONKeys(raw, false, true); err != nil {\n    57\t\t\treturn fmt.Errorf(\"pose: invalid schema-%d review policy: %w\", CloseoutReviewPolicySchemaVersion, err)\n    58\t\t}\n    59\t\tif !hasMilestone || !hasRoadmap {\n    60\t\t\treturn fmt.Errorf(\"pose: review policy schema %d requires both %s and %s\", CloseoutReviewPolicySchemaVersion, MilestoneReviewRequiredKey, RoadmapReviewRequiredKey)\n    61\t\t}\n    62\t\tfor _, key := range []string{MilestoneReviewRequiredKey, RoadmapReviewRequiredKey} {\n    63\t\t\tvar value string\n    64\t\t\tif string(fields[key]) == \"null\" || json.Unmarshal(fields[key], &value) != nil || !validCloseoutReviewValue(value) {\n    65\t\t\t\treturn fmt.Errorf(\"pose: %s must be one of never, when-justified, always (got %s)\", key, string(fields[key]))\n    66\t\t\t}\n    67\t\t}\n    68\t\treturn nil\n    69\t}\n    70\t\n    71\t// CloseoutReviewAdopted reports a policy that decides aggregate reviews by the\n    72\t// closeout pair. Every other policy keeps the legacy rule unchanged.\n    73\tfunc (p ReviewPolicy) CloseoutReviewAdopted() bool {\n    74\t\treturn p.SchemaVersion == CloseoutReviewPolicySchemaVersion\n    75\t}\n    76\t\n    77\t// CloseoutReviewSetting names the policy key and value that govern a scope kind.\n    78\tfunc (p ReviewPolicy) CloseoutReviewSetting(kind string) (string, string) {\n    79\t\tswitch kind {\n    80\t\tcase \"milestone\":\n    81\t\t\treturn MilestoneReviewRequiredKey, p.MilestoneReviewRequired\n    82\t\tcase \"roadmap\":\n    83\t\t\treturn RoadmapReviewRequiredKey, p.RoadmapReviewRequired\n    84\t\t}\n    85\t\treturn \"\", \"\"\n    86\t}\n    87\t\n    88\t// CloseoutReviewDecision is the evaluator's answer for one aggregate scope.\n    89\t// Projections render it; none of them recomputes a threshold.\n    90\ttype CloseoutReviewDecision struct {\n    91\t\tScope            string `json:\"scope\"`\n    92\t\tAdopted          bool   `json:\"adopted\"`\n    93\t\tEvaluatorVersion string `json:\"evaluator_version,omitempty\"`\n    94\t\tPolicyKey        string `json:\"policy_key,omitempty\"`\n    95\t\tPolicyValue      string `json:\"policy_value,omitempty\"`\n    96\t\t// Required is true when the scope owes its own independent review. An\n    97\t\t// unknown input never yields false.\n    98\t\tRequired bool `json:\"required\"`\n    99\t\t// Known is false when a member or an association could not be resolved:\n   100\t\t// the decision then requires the review and says what is missing.\n   101\t\tKnown       bool     `json:\"known\"`\n   102\t\tReason      string   `json:\"reason,omitempty\"`\n   103\t\tMembers     []string `json:\"members,omitempty\"`\n   104\t\tADRs        []string `json:\"adr_associations,omitempty\"`\n   105\t\tDiagnostics []string `json:\"diagnostics,omitempty\"`\n   106\t}\n   107\t\n   108\t// Review is the literal the closeout receipt records: required or not-required.\n   109\tfunc (d CloseoutReviewDecision) Review() string {\n   110\t\tif d.Required {\n   111\t\t\treturn \"required\"\n   112\t\t}\n   113\t\treturn \"not-required\"\n   114\t}\n   115\t\n   116\t// EvaluateCloseoutReview answers whether an aggregate scope owes its own\n   117\t// review under the adopted policy. A legacy policy returns Adopted=false and\n   118\t// the caller keeps the legacy rule.\n   119\tfunc (s Store) EvaluateCloseoutReview(ref string) (CloseoutReviewDecision, error) {\n   120\t\tpolicy, _, err := s.loadReviewPolicy()\n   121\t\tif err != nil {\n   122\t\t\treturn CloseoutReviewDecision{}, err\n   123\t\t}\n   124\t\treturn s.evaluateCloseoutReview(ref, policy)\n   125\t}\n   126\t\n   127\tfunc (s Store) evaluateCloseoutReview(ref string, policy ReviewPolicy) (CloseoutReviewDecision, error) {\n   128\t\tdecision := CloseoutReviewDecision{Scope: ref, Known: true}\n   129\t\tscope, err := ParseScopeRef(ref)\n   130\t\tif err != nil {\n   131\t\t\treturn decision, err\n   132\t\t}\n   133\t\tif !policy.CloseoutReviewAdopted() || (scope.Kind != \"milestone\" && scope.Kind != \"roadmap\") {\n   134\t\t\treturn decision, nil\n   135\t\t}\n   136\t\tdecision.Adopted = true\n   137\t\tdecision.EvaluatorVersion = CloseoutReviewEvaluatorVersion\n   138\t\tdecision.PolicyKey, decision.PolicyValue = policy.CloseoutReviewSetting(scope.Kind)\n   139\t\tslug := scope.Roadmap\n   140\t\tif scope.Kind == \"roadmap\" {\n   141\t\t\tslug = scope.Slug\n   142\t\t}\n   143\t\trm, err := s.GetRoadmap(slug)\n   144\t\tif err != nil {\n   145\t\t\treturn decision, err\n   146\t\t}\n   147\t\tproject, projectErr := s.WriteProjectID()\n   148\t\tvar raws []string\n   149\t\tif scope.Kind == \"milestone\" {\n   150\t\t\tfound := false\n   151\t\t\tfor _, milestone := range rm.Milestones {\n   152\t\t\t\tif milestone.ID == scope.Milestone {\n   153\t\t\t\t\traws, found = milestone.Specs, true\n   154\t\t\t\t}\n   155\t\t\t}\n   156\t\t\tif !found {\n   157\t\t\t\treturn decision, fmt.Errorf(\"pose: milestone %s not found in roadmap %s\", scope.Milestone, scope.Roadmap)\n   158\t\t\t}\n   159\t\t} else {\n   160\t\t\tfor _, milestone := range rm.Milestones {\n   161\t\t\t\traws = append(raws, milestone.Specs...)\n   162\t\t\t}\n   163\t\t}\n   164\t\tif projectErr != nil {\n   165\t\t\tdecision.Diagnostics = append(decision.Diagnostics, \"the project identity that qualifies local members is unknown: \"+projectErr.Error())\n   166\t\t} else {\n   167\t\t\tdecision.Members, decision.Diagnostics = s.closeoutCanonicalMembers(raws, project)\n   168\t\t}\n   169\t\tif len(decision.Diagnostics) > 0 {\n   170\t\t\tdecision.Known = false\n   171\t\t}\n   172\t\tmembers := len(decision.Members)\n   173\t\tswitch decision.PolicyValue {\n   174\t\tcase CloseoutReviewNever:\n   175\t\t\tdecision.Required = false\n   176\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, never required\", members)\n   177\t\t\t// never decides without counting, but a member it cannot resolve is\n   178\t\t\t// still a scope it cannot close.\n   179\t\t\treturn decision, nil\n   180\t\tcase CloseoutReviewAlways:\n   181\t\t\tdecision.Required = true\n   182\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, always required\", members)\n   183\t\t\treturn decision, nil\n   184\t\t}\n   185\t\tif !decision.Known {\n   186\t\t\tdecision.Required = true\n   187\t\t\tdecision.Reason = \"members unknown; an exemption needs every member resolved\"\n   188\t\t\treturn decision, nil\n   189\t\t}\n   190\t\tif scope.Kind == \"milestone\" {\n   191\t\t\tdecision.Required = members > closeoutMilestoneMemberThreshold\n   192\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d\", members, closeoutMilestoneMemberThreshold)\n   193\t\t\treturn decision, nil\n   194\t\t}\n   195\t\tif members <= closeoutRoadmapMemberThreshold {\n   196\t\t\tdecision.Required = false\n   197\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d\", members, closeoutRoadmapMemberThreshold)\n   198\t\t\treturn decision, nil\n   199\t\t}\n   200\t\tadrs, diagnostics := s.closeoutADRAssociations(rm, project)\n   201\t\tdecision.ADRs = adrs\n   202\t\tif len(diagnostics) > 0 {\n   203\t\t\tdecision.Diagnostics = append(decision.Diagnostics, diagnostics...)\n   204\t\t\tdecision.Known = false\n   205\t\t\tdecision.Required = true\n   206\t\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d, adr associations unknown\", members, closeoutRoadmapMemberThreshold)\n   207\t\t\treturn decision, nil\n   208\t\t}\n   209\t\tdecision.Required = len(adrs) > 0\n   210\t\tdecision.Reason = fmt.Sprintf(\"members=%d, threshold>%d, adrs=%d\", members, closeoutRoadmapMemberThreshold, len(adrs))\n   211\t\treturn decision, nil\n   212\t}\n   213\t\n   214\t// closeoutCanonicalMembers resolves milestone members to their final\n   215\t// identities, xref:<project>/spec:<slug>, sorted and deduplicated. A local\n   216\t// member follows only a verified transfer redirect; an external one is\n   217\t// resolved by the federated resolver or stays unknown. Unknown members are\n   218\t// diagnostics, never a count of zero.\n   219\tfunc (s Store) closeoutCanonicalMembers(raws []string, project string) ([]string, []string) {\n   220\t\tseen := map[string]bool{}\n   221\t\tmembers, diagnostics := []string{}, []string{}\n   222\t\tfor _, raw := range raws {\n   223\t\t\tidentity, diagnostic := s.closeoutCanonicalMember(strings.TrimSpace(raw), project)\n   224\t\t\tif diagnostic != \"\" {\n   225\t\t\t\tdiagnostics = append(diagnostics, diagnostic)\n   226\t\t\t\tcontinue\n   227\t\t\t}\n   228\t\t\tif !seen[identity] {\n   229\t\t\t\tseen[identity] = true\n   230\t\t\t\tmembers = append(members, identity)\n   231\t\t\t}\n   232\t\t}\n   233\t\tsort.Strings(members)\n   234\t\treturn members, diagnostics\n   235\t}\n   236\t\n   237\tfunc (s Store) closeoutCanonicalMember(raw, project string) (string, string) {\n   238\t\tref, err := ParseArtifactRef(raw)\n   239\t\tif err != nil || ref.Kind != \"spec\" || ref.Milestone != \"\" {\n   240\t\t\treturn \"\", fmt.Sprintf(\"member %q is not a spec reference\", raw)\n   241\t\t}\n   242\t\tif ref.Project == \"\" {\n   243\t\t\tref.Project = project\n   244\t\t}\n   245\t\tif ref.Project != project {\n   246\t\t\tif s.FederatedResolver == nil {\n   247\t\t\t\treturn \"\", fmt.Sprintf(\"member %s belongs to another project and no federated resolver is bound\", ref.String())\n   248\t\t\t}\n   249\t\t\tresolved := s.FederatedResolver.Resolve(project, ref.String())\n   250\t\t\tif !resolved.Resolved {\n   251\t\t\t\treturn \"\", fmt.Sprintf(\"member %s did not resolve: %s\", ref.String(), resolved.State)\n   252\t\t\t}\n   253\t\t\tif resolved.CanonicalIdentity != nil {\n   254\t\t\t\treturn resolved.CanonicalIdentity.String(), \"\"\n   255\t\t\t}\n   256\t\t\treturn resolved.Identity.String(), \"\"\n   257\t\t}\n   258\t\tredirect, found, err := readSpecTransferRedirect(s.fsys(), s, ref)\n   259\t\tif err != nil {\n   260\t\t\treturn \"\", fmt.Sprintf(\"member %s has an unverifiable redirect: %v\", ref.String(), err)\n   261\t\t}\n   262\t\tif found {\n   263\t\t\treturn redirect.Destination.String(), \"\"\n   264\t\t}\n   265\t\tif _, err := s.GetSpec(ref.Slug); err != nil {\n   266\t\t\treturn \"\", fmt.Sprintf(\"member %s names no spec of this project\", ref.String())\n   267\t\t}\n   268\t\treturn ref.String(), \"\"\n   269\t}\n   270\t\n   271\t// closeoutReviewGate is the one place the readers of an approval ask whether\n   272\t// an aggregate scope owes its own review under an adopted policy. It returns\n   273\t// the decision that governs the scope and whether its own review is dispensed.\n   274\t//\n   275\t// Order (spec pose-closeout-review-policy-by-cost-benefit, \"One evaluator and\n   276\t// precedence\"): a receipt already published decides by what it recorded; a\n   277\t// roadmap closed before adoption keeps its sealed contract (nil decision);\n   278\t// an open scope is evaluated now. A review recorded on the scope, required or\n   279\t// not, is never bypassed: it is verified as before and its veto stands.\n   280\tfunc (s Store) closeoutReviewGate(ref string, policy ReviewPolicy) (*CloseoutReviewDecision, bool, error) {\n   281\t\tif !policy.CloseoutReviewAdopted() {\n   282\t\t\treturn nil, false, nil\n   283\t\t}\n   284\t\tscope, err := ParseScopeRef(ref)\n   285\t\tif err != nil || (scope.Kind != \"milestone\" && scope.Kind != \"roadmap\") {\n   286\t\t\treturn nil, false, err\n   287\t\t}\n   288\t\treceipt, err := s.ReadCloseoutReceipt(ref)\n   289\t\tif err != nil {\n   290\t\t\treturn nil, false, err\n   291\t\t}\n   292\t\tif receipt != nil {\n   293\t\t\tdecision := receipt.Decision\n   294\t\t\treturn &decision, !decision.Required && !s.scopeReviewRecorded(ref), nil\n   295\t\t}\n   296\t\tif s.closeoutScopeHistorical(scope) {\n   297\t\t\treturn nil, false, nil\n   298\t\t}\n   299\t\tdecision, err := s.evaluateCloseoutReview(ref, policy)\n   300\t\tif err != nil {\n   301\t\t\treturn nil, false, err\n   302\t\t}\n   303\t\tif !decision.Required {\n   304\t\t\ts.protectCloseoutDecision(scope, &decision)\n   305\t\t}\n   306\t\treturn &decision, !decision.Required && !s.scopeReviewRecorded(ref), nil\n   307\t}\n   308\t\n   309\t// protectCloseoutDecision restores the review when the scope itself changes\n   310\t// the review contract: an exemption the diff introduced cannot exempt the diff.\n   311\t// The decision is made a second time under the policy at the change set's base\n   312\t// revision, and a stronger answer there wins. Protection that cannot be\n   313\t// established keeps the review required.\n   314\tfunc (s Store) protectCloseoutDecision(scope ScopeRef, decision *CloseoutReviewDecision) {\n   315\t\tguard := s.resolveReviewGovernanceGuard(scope)\n   316\t\tif len(guard.Paths) == 0 {\n   317\t\t\treturn\n   318\t\t}\n   319\t\trestore := func(reason string) {\n   320\t\t\tdecision.Required = true\n   321\t\t\tdecision.Reason += \"; \" + reason\n   322\t\t}\n   323\t\tif guard.Revision == \"\" {\n   324\t\t\trestore(\"the scope changes the review contract and no protected baseline resolves: \" + guard.Reason)\n   325\t\t\treturn\n   326\t\t}\n   327\t\tbase, err := s.parseReviewPolicyAt(guard.Revision)\n   328\t\tif err != nil {\n   329\t\t\trestore(\"the protected baseline policy cannot be read: \" + err.Error())\n   330\t\t\treturn\n   331\t\t}\n   332\t\tif !base.Enabled {\n   333\t\t\treturn\n   334\t\t}\n   335\t\tif !base.CloseoutReviewAdopted() {\n   336\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" keeps the legacy rule, under which this scope owes its review\")\n   337\t\t\treturn\n   338\t\t}\n   339\t\tprotected, err := s.evaluateCloseoutReview(decision.Scope, base)\n   340\t\tif err != nil || protected.Required {\n   341\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires the review (\" + protected.PolicyKey + \"=\" + protected.PolicyValue + \")\")\n   342\t\t}\n   343\t}\n   344\t\n   345\t// closeoutScopeHistorical reports a scope whose roadmap was closed: its\n   346\t// milestones and itself are verified by the contract they were sealed under,\n   347\t// never re-evaluated, and no receipt is backfilled for them.\n   348\tfunc (s Store) closeoutScopeHistorical(scope ScopeRef) bool {\n   349\t\tslug := scope.Slug\n   350\t\tif scope.Kind == \"milestone\" {\n   351\t\t\tslug = scope.Roadmap\n   352\t\t}\n   353\t\trm, err := s.GetRoadmap(slug)\n   354\t\treturn err == nil && rm.Status == \"done\"\n   355\t}\n   356\t\n   357\t// scopeReviewRecorded reports a review of the scope on file: a bundle or a\n   358\t// legacy attempt. A record that cannot be read counts as recorded, so an\n   359\t// unreadable rejection never turns into an exemption.\n   360\tfunc (s Store) scopeReviewRecorded(ref string) bool {\n   361\t\tbundles, err := s.ReadReviewBundles(ref)\n   362\t\tif err != nil || len(bundles.Bundles) > 0 || !bundles.Coverage.CompleteFor(ref) {\n   363\t\t\treturn true\n   364\t\t}\n   365\t\tattempts, err := s.ReadReviewAttempts(ref)\n   366\t\treturn err != nil || len(attempts.Attempts) > 0 || !attempts.Coverage.CompleteFor(ref)\n   367\t}\n   368\t\n   369\t// closeoutApprovalOrigin is the origin an exempt scope's approval reports.\n   370\tfunc closeoutApprovalOrigin(decision CloseoutReviewDecision) string {\n   371\t\treturn \"not-required:\" + decision.PolicyKey + \"=\" + decision.PolicyValue\n   372\t}\n   373\t\n   374\tfunc closeoutExemptionWarning(ref string, decision CloseoutReviewDecision) string {\n   375\t\treturn \"review: not-required for \" + ref + \" (\" + decision.PolicyKey + \"=\" + decision.PolicyValue + \", \" + decision.Reason + \"); `pose close \" + ref + \"` is still required\"\n   376\t}\n   377\t\n   378\t// CloseoutReviewOwing is an open aggregate scope that owes its own review under\n   379\t// the adopted policy and holds no recorded approval yet, for `pose doctor`.\n   380\ttype CloseoutReviewOwing struct {\n   381\t\tScope    string                 `json:\"scope\"`\n   382\t\tDecision CloseoutReviewDecision `json:\"decision\"`\n   383\t\t// Previous is the rule that applied before, when a recorded input shows\n   384\t\t// it; with no snapshot it says the comparison is unknown.\n   385\t\tPrevious string `json:\"previous\"`\n   386\t\tAction   string `json:\"action\"`\n   387\t}\n   388\t\n   389\t// CloseoutReviewsOwed lists the open milestones and roadmaps that, under the\n   390\t// adopted closeout review policy, owe a review they do not have. A legacy\n   391\t// policy returns nothing. Close remains the authoritative gate.\n   392\tfunc (s Store) CloseoutReviewsOwed() ([]CloseoutReviewOwing, error) {\n   393\t\tpolicy, _, err := s.loadReviewPolicy()\n   394\t\tif err != nil || !policy.CloseoutReviewAdopted() || !policy.Enabled {\n   395\t\t\treturn nil, err\n   396\t\t}\n   397\t\troadmaps, err := s.ListRoadmaps()\n   398\t\tif err != nil {\n   399\t\t\treturn nil, err\n   400\t\t}\n   401\t\trefs := []string{}\n   402\t\tfor _, rm := range roadmaps {\n   403\t\t\tif rm.Status == \"done\" {\n   404\t\t\t\tcontinue\n   405\t\t\t}\n   406\t\t\tfor _, milestone := range rm.Milestones {\n   407\t\t\t\trefs = append(refs, \"milestone:\"+rm.Slug+\"/\"+milestone.ID)\n   408\t\t\t}\n   409\t\t\trefs = append(refs, \"roadmap:\"+rm.Slug)\n   410\t\t}\n   411\t\trecorded, _, err := s.milestonesWithRecordedApproval(refs)\n   412\t\tif err != nil {\n   413\t\t\treturn nil, err\n   414\t\t}\n   415\t\towing := []CloseoutReviewOwing{}\n   416\t\tfor _, ref := range refs {\n   417\t\t\treceipt, err := s.ReadCloseoutReceipt(ref)\n   418\t\t\tif err != nil {\n   419\t\t\t\treturn nil, err\n   420\t\t\t}\n   421\t\t\tif receipt != nil || recorded[ref] {\n   422\t\t\t\tcontinue\n   423\t\t\t}\n   424\t\t\tdecision, err := s.evaluateCloseoutReview(ref, policy)\n   425\t\t\tif err != nil {\n   426\t\t\t\treturn nil, err\n   427\t\t\t}\n   428\t\t\tif !decision.Required {\n   429\t\t\t\ts.protectCloseoutDecision(mustScope(ref), &decision)\n   430\t\t\t}\n   431\t\t\tif !decision.Required {\n   432\t\t\t\tcontinue\n   433\t\t\t}\n   434\t\t\taction := \"seal and review \" + ref + \" (`pose review bundle \" + ref + \" --seal`), then `pose close \" + ref + \"`\"\n   435\t\t\tif !decision.Known {\n   436\t\t\t\taction = \"resolve \" + strings.Join(decision.Diagnostics, \"; \")\n   437\t\t\t}\n   438\t\t\towing = append(owing, CloseoutReviewOwing{Scope: ref, Decision: decision, Previous: \"unknown: no snapshot of the earlier policy or composition is recorded\", Action: action})\n   439\t\t}\n   440\t\treturn owing, nil\n   441\t}\n   442\t\n   443\tfunc mustScope(ref string) ScopeRef {\n   444\t\tscope, _ := ParseScopeRef(ref)\n   445\t\treturn scope\n   446\t}\n","exit_code":0,"status":"completed"}}
