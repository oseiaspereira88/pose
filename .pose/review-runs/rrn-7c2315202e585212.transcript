not overwritten\", func(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:403:\t\t\tt.Fatalf(\"a corrupt receipt read as closed: %+v\", state)\npose-mcp/internal/pose/closeout_review_policy_test.go:405:\t\tif err := s.PublishCloseoutReceipt(receipt); err == nil {\npose-mcp/internal/pose/closeout_review_policy_test.go:406:\t\t\tt.Fatal(\"a corrupt receipt was overwritten\")\npose-mcp/internal/pose/closeout_review_policy_test.go:411:func TestCloseoutReviewPolicyHistory(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:419:\t// after adoption, under any value, and gets no backfilled receipt.\npose-mcp/internal/pose/closeout_review_policy_test.go:427:\t\tif receipt, err := s.ReadCloseoutReceipt(ref); err != nil || receipt != nil {\npose-mcp/internal/pose/closeout_review_policy_test.go:428:\t\t\tt.Fatalf(\"a receipt appeared: %+v %v\", receipt, err)\npose-mcp/internal/pose/closeout_review_policy_test.go:430:\t\tif eval, err := s.ReviewCheck(ref); err != nil || eval.CloseoutReview != nil {\npose-mcp/internal/pose/closeout_review_policy_test.go:436:func TestCloseoutReviewPolicyUnavailable(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:463:\t\tif _, err := s.EvaluateCloseoutReview(\"milestone:program/one\"); err == nil {\npose-mcp/internal/pose/closeout_review_policy_test.go:469:func TestCloseoutReviewPolicyFederation(t *testing.T) {\npose-mcp/internal/cli/testdata/adversarial/README.md:53:| `deleted-reservation-resets-quota` | delegated | Deleting a reservation and receipt makes a surviving run stop consuming quota | pose-delegated-review-attempt-ledger |\npose-mcp/internal/cli/testdata/adversarial/README.md:56:| `canned-executor-approval-proves-cognition` | delegated | A complete canned approval from a trusted local command is presented as proof of review cognition or a vendor receipt (`cli/delegated_review_capability_test.go:TestDelegatedReviewCapabilityCannedApprovalDisclosesItsLimits` guards disclosure; 