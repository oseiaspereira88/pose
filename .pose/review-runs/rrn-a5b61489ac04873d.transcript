atedBefore(scope, date) {\n   322\t\t\t\t\tplan.Explain = append(plan.Explain, overlayRef+\" not selected: adopted on \"+date+\", after every spec in \"+ref+\" was created\")\n   323\t\t\t\t\tcontinue\n   324\t\t\t\t}\n   325\t\t\t\toverlays = append(overlays, overlay)\n   326\t\t\t}\n   327\t\t\t// Resolved only when something selects on it. A repository that adopted\n   328\t\t\t// no structural profile pays nothing here, not even the Git reads, which\n   329\t\t\t// is what keeps an opt-in contract opt-in in cost as well as in effect.\n   330\t\t\tfor _, overlay := range overlays {\npose-mcp/internal/pose/review_plan.go:429:\tspecs, err := s.reviewScopeSpecs(scope)\npose-mcp/internal/pose/review_plan.go:554:func (s Store) reviewScopeSpecs(scope ScopeRef) ([]Spec, error) {\npose-mcp/internal/pose/review_structure.go:191:\tspecs, err := s.reviewScopeSpecs(scope)\npose-mcp/internal/pose/causality_closeout.go:72:\tspecs, err := s.reviewScopeSpecs(scope)\npose-mcp/internal/pose/causality_closeout.go:87:\tspecs, err := s.reviewScopeSpecs(scope)\npose-mcp/internal/pose/causality_closeout.go:102:\tspecs, err := s.reviewScopeSpecs(scope)\npose-mcp/internal/pose/obligation_projection.go:42:\tscopeSpecs      []Spec                     `json:\"-\"`\npose-mcp/internal/pose/obligation_projection.go:171:\treport.scopeSpecs = specs\npose-mcp/internal/pose/review_plan.go:429:\tspecs, err := s.reviewScopeSpecs(scope)\npose-mcp/internal/pose/review_plan.go:554:func (s Store) reviewScopeSpecs(scope ScopeRef) ([]Spec, error) {\npose-mcp/internal/pose/review_policy_baseline.go:71:\tspecs, err := s.reviewScopeSpecs(scope)\npose-mcp/internal/pose/closeout_review_policy_test.go:1343:\t\tspecs, err := s.reviewScopeSpecs(ScopeRef{Kind: \"milestone\", Roadmap: \"moves\", Milestone: \"m\"})\npose-mcp/internal/pose/accepted_limits.go:91:\tspecs, err := s.reviewScopeSpecs(scope)\n","exit_code":0,"status":"completed"}}
