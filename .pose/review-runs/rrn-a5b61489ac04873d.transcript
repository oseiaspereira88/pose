ame, so it governs whatever the seal instants\n  2132\t\t// say, and a historical identity declared again is a new seal, never the\n  2133\t\t// historical bundle handed back (spec pose-delegation-routing D3).\n  2134\t\tif governing := governingSealedBundle(sealed, bundle); governing != nil {\n  2135\t\t\tif !declared || identity == nil || governing.Payload.Implementation != nil && sameImplementation(*governing.Payload.Implementation, *identity) {\n  2136\t\t\t\treturn *governing, nil\n  2137\t\t\t}\n  2138\t\t\treplaced := *identity\n  2139\t\t\treplaced.Replaces = governing.BundleID\n  2140\t\t\tidentity = &replaced\n  2141\t\t}\n  2142\t\tif blockers := s.sealReadinessBlockers(bundle); len(blockers) > 0 {\n  2143\t\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", strings.Join(blockers, \"; \"))\n  2144\t\t}\n  2145\t\t// A bundle already sealed reads as it was; a new seal holds a validation result,\n  2146\t\t// whatever the lifecycle of the scope says.\n  2147\t\tif !holdsValidationResult(bundle.Payload.Evidence) {\n  2148\t\t\tscope, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n  2149\t\t\tif err != nil {\n  2150\t\t\t\treturn ReviewBundle{}, err\n  2151\t\t\t}\n  2152\t\t\tgraph, err := s.GetDeliveryIntegrity(\"\")\n  2153\t\t\tif err != nil {\n  2154\t\t\t\treturn ReviewBundle{}, err\n  2155\t\t\t}\n  2156\t\t\tif s.reviewScopeRequiresValidationEvidence(scope, bundle.Payload.Plan, graph) {\n  2157\t\t\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", noValidationEvidenceBlocker)\n  2158\t\t\t}\n  2159\t\t}\n  2160\t\tif identity != nil {\n  2161\t\t\tbundle.Payload.Implementation = identity\n  2162\t\t\tdigest, err := reviewBundlePayloadDigest(bundle.Payload)\n  2163\t\t\tif err != nil {\n  2164\t\t\t\treturn ReviewBundle{}, err\n  2165\t\t\t}\n  2166\t\t\tbundle.BundleDigest = digest\n  2167\t\t\tbundle.BundleID = \"rvb-\" + strings.TrimPrefix(digest, \"sha256:\")[:16]\n  2168\t\t}\n  2169\t\tif warning != \"\" {\n  2170\t\t\tbundle.Warnings = uniqueSorted(append(bundle.Warnings, warning))\n  2171\t\t}\n  2172\t\tbundle.State = \"sealed\"\n","exit_code":1,"status":"failed"}}
