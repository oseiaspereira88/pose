{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/usr/bin/bash -lc 'git diff --unified=4 3f63a1bb432801957ddb35354961f1825658531a..d667705571f80251e94c33c8dcdd4fd4438be34e -- pose-mcp/internal/pose/accepted_limits.go pose-mcp/internal/pose/accepted_limits_test.go pose-mcp/internal/pose/review_plan.go pose-mcp/internal/pose/review_bundle.go pose-mcp/internal/pose/review_rounds.go pose-mcp/internal/pose/review_closeout.go pose-mcp/internal/pose/review_conclusions.go pose-mcp/internal/pose/review_brief.go pose-mcp/internal/cli/lintspec.go pose-mcp/internal/cli/accepted_limits_lint_test.go'","aggregated_output":"diff --git a/pose-mcp/internal/cli/accepted_limits_lint_test.go b/pose-mcp/internal/cli/accepted_limits_lint_test.go\nnew file mode 100644\nindex 00000000..47a837ea\n--- /dev/null\n+++ b/pose-mcp/internal/cli/accepted_limits_lint_test.go\n@@ -0,0 +1,62 @@\n+package cli\n+\n+import (\n+\t\"bytes\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-review-declared-threat-model R4: the ready check refuses an\n+// accepted limit without its reason, and one an ADR citing the spec omits.\n+func TestReadyCheckJudgesAcceptedLimits(t *testing.T) {\n+\troot := t.TempDir()\n+\twrite := func(rel, body string) {\n+\t\tp := filepath.Join(root, rel)\n+\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tspec := func(limits string) string {\n+\t\treturn \"---\\nslug: limited\\nstatus: draft\\ncreated_at: 2026-11-25\\n---\\n\\n# Spec: limited\\n\\n## 1. Intent\\n\\n### Goal\\nA goal worth stating.\\n\\n## 2. Requirements\\n\\n### Functional\\n- R1: It works.\\n\\n## 3. Technical Plan\\n\\n### Affected areas\\nThe engine.\\n\" + limits + \"\\n## 4. Tasks\\n- [ ] Do it.\\n\"\n+\t}\n+\tpath := filepath.Join(root, \".pose/specs/limited/spec.md\")\n+\trun := func() (int, string) {\n+\t\tvar out, errOut bytes.Buffer\n+\t\tcode := lintOneSpec(path, false, true, &out, &errOut)\n+\t\treturn code, out.String() + errOut.String()\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n\"))\n+\tif code, out := run(); code != 0 {\n+\t\tt.Fatalf(\"a justified limit failed the ready check: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape with no reason.\\n\"))\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"does not say why it is accepted\") {\n+\t\tt.Fatalf(\"an unjustified limit passed: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n- L2: another. Accepted because it is rarer.\\n\"))\n+\t// Review round 1, N3: L10 does not name L1.\n+\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited`. L10 and L2 are accepted.\\n\")\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"accepted limit L1 is not named by the ADR\") {\n+\t\tt.Fatalf(\"L10 was taken as naming L1: %d %s\", code, out)\n+\t}\n+\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited`. L1 is accepted.\\n\")\n+\tif code, out := run(); code == 0 || !strings.Contains(out, \"accepted limit L2 is not named by the ADR\") {\n+\t\tt.Fatalf(\"a limit the ADR omits passed: %d %s\", code, out)\n+\t}\n+\t// Review round 5, N2: an ADR that cannot be read fails the check closed.\n+\tif os.Geteuid() != 0 {\n+\t\tadr := filepath.Join(root, \".pose/adr/2026-11-25-limited.md\")\n+\t\tif err := os.Chmod(adr, 0o000); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tdefer os.Chmod(adr, 0o644)\n+\t\tif code, out := run(); code == 0 || !strings.Contains(out, \"cannot be read to check the accepted limits\") {\n+\t\t\tt.Fatalf(\"an unreadable ADR was read as absent: %d %s\", code, out)\n+\t\t}\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/lintspec.go b/pose-mcp/internal/cli/lintspec.go\nindex 6b9ce779..8f260736 100644\n--- a/pose-mcp/internal/cli/lintspec.go\n+++ b/pose-mcp/internal/cli/lintspec.go\n@@ -3,8 +3,9 @@ package cli\n // Native lint-spec gate. It preserves the published lifecycle verdicts and\n // stable machine metrics without an external runtime.\n \n import (\n+\t\"errors\"\n \t\"fmt\"\n \t\"io\"\n \t\"os\"\n \t\"path/filepath\"\n@@ -565,8 +566,23 @@ func lintOneSpecWith(r *cliout.Renderer, fields bool, specPath string, requiredO\n \t\t\t}\n \t\t\tlint.finding(cliout.StateError, \"dor\", fmt.Sprintf(cliText(locale, \"DoR: invalid depends_on reference: '%s'\", \"DoR: ref inválida em depends_on: '%s'\"), ref))\n \t\t\tfailures++\n \t\t}\n+\t\t// Accepted limits (spec pose-review-declared-threat-model R4): each\n+\t\t// says why it is accepted, and an ADR that names the spec names each\n+\t\t// limit, so the decision record carries what the review will treat as\n+\t\t// out of scope.\n+\t\tlimits, limitProblems := posepkg.ParseAcceptedLimits(text)\n+\t\tfor _, problem := range limitProblems {\n+\t\t\tlint.finding(cliout.StateError, \"dor\", \"DoR: \"+problem)\n+\t\t\tfailures++\n+\t\t}\n+\t\tif len(limits) > 0 {\n+\t\t\tfor _, missing := range acceptedLimitsMissingFromADRs(lintProjectRoot(specPath), slug, limits) {\n+\t\t\t\tlint.finding(cliout.StateError, \"dor\", missing)\n+\t\t\t\tfailures++\n+\t\t\t}\n+\t\t}\n \t\temitDesignBasis()\n \t\tfailures += designFailures + lineageFailures\n \t\tready := \"true\"\n \t\tif failures > 0 {\n@@ -1167,4 +1183,53 @@ func containsSection(names []string, name string) bool {\n \t\t}\n \t}\n \treturn false\n }\n+\n+// acceptedLimitsMissingFromADRs names each declared limit an ADR that cites\n+// the spec does not mention. With no ADR citing the spec nothing is required.\n+func acceptedLimitsMissingFromADRs(root, slug string, limits []posepkg.ReviewAcceptedLimit) []string {\n+\tentries, err := os.ReadDir(filepath.Join(root, \".pose\", \"adr\"))\n+\tif errors.Is(err, os.ErrNotExist) {\n+\t\treturn nil\n+\t}\n+\t// An ADR that cannot be read may be the one that cites the spec: the\n+\t// check fails closed instead of reading it as absent (review round 5, N2).\n+\tif err != nil {\n+\t\treturn []string{\"DoR: the ADRs cannot be read to check the accepted limits: \" + err.Error()}\n+\t}\n+\tvar citing []string\n+\tvar unreadable []string\n+\tfor _, e := range entries {\n+\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".md\") {\n+\t\t\tcontinue\n+\t\t}\n+\t\traw, err := os.ReadFile(filepath.Join(root, \".pose\", \"adr\", e.Name()))\n+\t\tif err != nil {\n+\t\t\tunreadable = append(unreadable, \"DoR: ADR \"+e.Name()+\" cannot be read to check the accepted limits: \"+err.Error())\n+\t\t\tcontinue\n+\t\t}\n+\t\tif !strings.Contains(string(raw), slug) {\n+\t\t\tcontinue\n+\t\t}\n+\t\tciting = append(citing, string(raw))\n+\t}\n+\tif len(unreadable) > 0 {\n+\t\treturn unreadable\n+\t}\n+\tif len(citing) == 0 {\n+\t\treturn nil\n+\t}\n+\tvar missing []string\n+\tfor _, l := range limits {\n+\t\tfound := false\n+\t\t// The id as a word: L10 does not name L1 (review round 1, N3).\n+\t\tnamed := regexp.MustCompile(`\\b` + regexp.QuoteMeta(l.ID) + `\\b`)\n+\t\tfor _, adr := range citing {\n+\t\t\tfound = found || named.MatchString(adr)\n+\t\t}\n+\t\tif !found {\n+\t\t\tmissing = append(missing, \"DoR: accepted limit \"+l.ID+\" is not named by the ADR that cites \"+slug)\n+\t\t}\n+\t}\n+\treturn missing\n+}\ndiff --git a/pose-mcp/internal/pose/accepted_limits.go b/pose-mcp/internal/pose/accepted_limits.go\nnew file mode 100644\nindex 00000000..ace87a99\n--- /dev/null\n+++ b/pose-mcp/internal/pose/accepted_limits.go\n@@ -0,0 +1,124 @@\n+package pose\n+\n+// Accepted limits (spec pose-review-declared-threat-model): a spec declares\n+// the residual limits of a guarantee it makes, each with a stable id and why\n+// it is accepted. The review plan seals them; the brief lists them; a\n+// reviewer classifies a finding that falls inside one as within that limit,\n+// or disputes the limit as a finding of its own. A declared limit never\n+// hides a defect inside the declared scope: it is visible in the bundle, the\n+// brief and the attestation.\n+\n+import (\n+\t\"regexp\"\n+\t\"strings\"\n+)\n+\n+// ReviewAcceptedLimit is one declared residual limit.\n+type ReviewAcceptedLimit struct {\n+\tID   string `json:\"id\"`\n+\tText string `json:\"text\"`\n+\t// Spec names the spec that declared the limit when the scope holds more\n+\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n+\tSpec string `json:\"spec,omitempty\"`\n+}\n+\n+var acceptedLimitRE = regexp.MustCompile(`^-\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n+\n+// acceptedLimitMarkerRE finds the marker where a sentence opens, after the\n+// assumption: \"<assumption>. Accepted because <reason>.\" A marker inside a\n+// sentence (\"Not accepted because\") is not one (review round 3, N1).\n+var acceptedLimitMarkerRE = regexp.MustCompile(`[.;:!?]\\s+(?:Accepted because|Aceito porque)\\s+`)\n+\n+// acceptedLimitReasonWordRE is a word with at least one letter.\n+var acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n+\n+// hasAcceptedLimitReason reads an entry as written: an assumption of at\n+// least two words, then the marker opening a sentence, then a reason of at\n+// least two words in that same sentence. A marker alone, punctuation, a\n+// missing assumption or a reason borrowed from a later sentence does not say\n+// why a limit is accepted (review rounds 1–4).\n+func hasAcceptedLimitReason(text string) bool {\n+\tloc := acceptedLimitMarkerRE.FindStringIndex(text)\n+\tif loc == nil {\n+\t\treturn false\n+\t}\n+\tassumption, rest := text[:loc[0]], text[loc[1]:]\n+\tif end := strings.IndexAny(rest, \".;!?\"); end >= 0 {\n+\t\trest = rest[:end]\n+\t}\n+\treturn len(acceptedLimitReasonWordRE.FindAllString(assumption, -1)) >= 2 && len(acceptedLimitReasonWordRE.FindAllString(rest, -1)) >= 2\n+}\n+\n+// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n+// It returns the limits and the problems that keep the section from being\n+// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n+// limit that does not say why it is accepted (\"Accepted because ...\" or\n+// \"Aceito porque ...\").\n+func ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n+\tvar limits []ReviewAcceptedLimit\n+\tvar problems []string\n+\tin := false\n+\tseen := map[string]bool{}\n+\tfor _, line := range strings.Split(body, \"\\n\") {\n+\t\ttrimmed := strings.TrimSpace(line)\n+\t\tif strings.HasPrefix(trimmed, \"#\") {\n+\t\t\tin = strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Accepted limits\") || strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Limites aceitos\")\n+\t\t\tcontinue\n+\t\t}\n+\t\tif !in || !strings.HasPrefix(trimmed, \"- \") {\n+\t\t\tcontinue\n+\t\t}\n+\t\tm := acceptedLimitRE.FindStringSubmatch(trimmed)\n+\t\tif m == nil {\n+\t\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(trimmed)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n+\t\t\tcontinue\n+\t\t}\n+\t\tif seen[m[1]] {\n+\t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" is declared twice\")\n+\t\t\tcontinue\n+\t\t}\n+\t\tseen[m[1]] = true\n+\t\tif !hasAcceptedLimitReason(m[2]) {\n+\t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" does not say why it is accepted ('Accepted because ...')\")\n+\t\t}\n+\t\tlimits = append(limits, ReviewAcceptedLimit{ID: m[1], Text: strings.TrimSpace(m[2])})\n+\t}\n+\treturn limits, problems\n+}\n+\n+// acceptedLimitsOf collects the limits the scope's specs declare.\n+func (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n+\tspecs, err := s.reviewScopeSpecs(scope)\n+\tif err != nil {\n+\t\treturn nil\n+\t}\n+\treturn acceptedLimitsOfSpecs(specs)\n+}\n+\n+// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n+// by its spec when there is more than one spec.\n+func acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n+\tvar out []ReviewAcceptedLimit\n+\tfor _, spec := range specs {\n+\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n+\t\tfor _, l := range limits {\n+\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n+\t\t\t// so a finding names exactly one sealed limit.\n+\t\t\tif len(specs) > 1 {\n+\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n+\t\t\t}\n+\t\t\tout = append(out, l)\n+\t\t}\n+\t}\n+\treturn out\n+}\n+\n+// sealedAcceptedLimit reports whether the bundle sealed limit id.\n+func sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n+\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n+\t\tif l.ID == id {\n+\t\t\treturn true\n+\t\t}\n+\t}\n+\treturn false\n+}\ndiff --git a/pose-mcp/internal/pose/accepted_limits_test.go b/pose-mcp/internal/pose/accepted_limits_test.go\nnew file mode 100644\nindex 00000000..a6f802cd\n--- /dev/null\n+++ b/pose-mcp/internal/pose/accepted_limits_test.go\n@@ -0,0 +1,118 @@\n+package pose\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+const limitsSection = `\n+### Accepted limits\n+- L1: A process that clears its environment escapes. Accepted because the shim covers it.\n+- L2: Windows is untested here. Accepted because the host is Linux.\n+`\n+\n+// Spec pose-review-declared-threat-model R1: the section is read as\n+// written, and what does not say why it is accepted is reported.\n+func TestAcceptedLimitsAreParsed(t *testing.T) {\n+\tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n+\tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n+\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n+\t}\n+\t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n- L3: a marker with nothing after it. Accepted because\\n\")\n+\tjoined := strings.Join(problems, \"\\n\")\n+\tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\", \"L3 does not say why it is accepted\"} {\n+\t\tif !strings.Contains(joined, want) {\n+\t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n+\t\t}\n+\t}\n+}\n+\n+// R1: the review plan seals the limits the spec declares, and they enter the\n+// plan digest; a spec without limits keeps its digest.\n+func TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n+\troot, store := reviewBundleFixture(t)\n+\tbefore, err := store.ReviewPlan(\"spec:backend\")\n+\tif err != nil || len(before.AcceptedLimits) != 0 {\n+\t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n+\t}\n+\tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n+\traw, _ := os.ReadFile(path)\n+\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tafter, err := store.ReviewPlan(\"spec:backend\")\n+\tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n+\t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n+\t}\n+\twithout := after\n+\twithout.AcceptedLimits = nil\n+\tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n+\t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n+\t}\n+}\n+\n+// R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n+// recorded within-limit, naming it, and does not block an approval whatever\n+// its severity; a limit the bundle did not seal accepts nothing.\n+func TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n+\tvar bundle ReviewBundle\n+\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n+\tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n+\t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n+\t}}\n+\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n+\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n+\t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n+\t}\n+\tatt.Decision = \"approved\"\n+\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n+\t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n+\t}\n+\tatt.Findings[0].Limit = \"L9\"\n+\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n+\t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n+\t}\n+\tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"  \\t \"\n+\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n+\t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n+\t}\n+}\n+\n+// Review round 1, N1: across the specs of a composite scope each limit is\n+// qualified by its spec, so a finding names exactly one.\n+func TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n+\tbody := \"### Accepted limits\\n- L1: one. Accepted because it is rare.\\n\"\n+\tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n+\tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n+\t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n+\t}\n+\tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n+\tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n+\t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n+\t}\n+}\n+\n+// Review round 2, N1: punctuation is not a reason, and a reason may start\n+// with a one-letter word.\n+func TestAnAcceptedLimitNeedsWordsAsItsReason(t *testing.T) {\n+\tfor text, want := range map[string]bool{\n+\t\t\"x. Accepted because ..\":                                          false,\n+\t\t\"x. Accepted because -- !\":                                        false,\n+\t\t\"x. Accepted because rare\":                                        false,\n+\t\t\"An escape. Accepted because a shim covers it.\":                   true,\n+\t\t\"Uma fuga. Aceito porque o shim cobre o caso.\":                    true,\n+\t\t\"Not accepted because this would violate scope.\":                  false,\n+\t\t\"Accepted because it is rare.\":                                    false,\n+\t\t\"An escape. Accepted because. Then unrelated prose follows here.\": false,\n+\t\t\"An escape. Accepted because a shim covers it. More context.\":     true,\n+\t\t\"An escape. Accepted because ; later prose has words.\":            false,\n+\t\t\"X. Accepted because a shim covers it.\":                           false,\n+\t\t\"x, accepted because it is rare.\":                                 false,\n+\t} {\n+\t\tif got := hasAcceptedLimitReason(text); got != want {\n+\t\t\tt.Errorf(\"%q: reason=%t, want %t\", text, got, want)\n+\t\t}\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_brief.go b/pose-mcp/internal/pose/review_brief.go\nindex 8b66ef79..ce828902 100644\n--- a/pose-mcp/internal/pose/review_brief.go\n+++ b/pose-mcp/internal/pose/review_brief.go\n@@ -26,9 +26,9 @@ const (\n \tReviewBriefKindSmoke        = \"smoke\"\n )\n \n var reviewBriefTemplates = map[string]string{\n-\tRevi