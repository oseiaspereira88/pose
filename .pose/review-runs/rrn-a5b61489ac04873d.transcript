sked for the typed conclusion and stated the rules\n \t// the engine checks before it records one (spec pose-review-brief-states-the-conclusion-rules).\n@@ -76,11 +94,32 @@ const (\n \treviewBriefTemplateRounds          = \"review-brief/2\"\n \treviewBriefTemplateFirst           = \"review-brief/1\"\n )\n \n+// reviewBriefFromAllNotApplicable reports /7 and the templates that keep its\n+// text and add to it.\n+func reviewBriefFromAllNotApplicable(template string) bool {\n+\treturn template == reviewBriefTemplateAllNotApplicable || reviewBriefFromDraftCheck(template)\n+}\n+\n+// reviewBriefFromDraftCheck reports /8 and the templates that keep its text.\n+func reviewBriefFromDraftCheck(template string) bool {\n+\treturn template == reviewBriefTemplateDraftCheck || reviewBriefFromEngineTools(template)\n+}\n+\n+// reviewBriefFromEngineTools reports /9 and the templates that keep its text.\n+func reviewBriefFromEngineTools(template string) bool {\n+\treturn template == reviewBriefTemplateEngineTools || reviewBriefFromFinishCommands(template)\n+}\n+\n+// reviewBriefFromFinishCommands reports /10 and the templates that keep its text.\n+func reviewBriefFromFinishCommands(template string) bool {\n+\treturn template == reviewBriefTemplateFinishCommands || template == reviewBriefTemplateAcceptedLimits\n+}\n+\n // reviewBriefAsksConclusion reports a template that asks for the typed conclusion.\n func reviewBriefAsksConclusion(template string) bool {\n-\treturn template == reviewBriefTemplateAllNotApplicable || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions || template == reviewBriefTemplateTypedConclusion\n+\treturn reviewBriefFromAllNotApplicable(template) || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions || template == reviewBriefTemplateTypedConclusion\n }\n \n // briefRulesTextV5 is the statement of the rules 