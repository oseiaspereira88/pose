  string                `json:\"plan_digest\"`\n   128\t\tIndependence   string                `json:\"independence\"`\n   129\t\tComponents     []ReviewPlanComponent `json:\"components\"`\n   130\t\tCriteria       []ReviewPlanCriterion `json:\"criteria\"`\n   131\t\tTools          []ReviewPlanTool      `json:\"tools\"`\n   132\t\t// SelectedProfiles records which components each profile was selected for.\n   133\t\t// A criterion names the profiles it came from, and without this mapping the\n   134\t\t// sealed subject cannot say which components that criterion answers for —\n   135\t\t// so evidence could only be matched by reference and class, never by where\n   136\t\t// it came from. Re-reading it from the current policy at verification time\n   137\t\t// would judge an immutable bundle by today's selection, which is the whole\n   138\t\t// thing sealing exists to prevent.\n   139\t\tSelectedProfiles []ReviewPlanProfile `json:\"selected_profiles,omitempty\"`\n   140\t\t// CloseoutReview seals the closeout-review@1 decision an aggregate scope\n   141\t\t// was reviewed under (spec pose-closeout-review-policy-by-cost-benefit).\n   142\t\t// Nil on every bundle sealed before adoption, which is how such a bundle\n   143\t\t// proves a closure from before the policy.\n   144\t\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n   145\t\t// Structure seals the material structural facts the plan observed, so the\n   370\t// something no local evidence can show.\n   371\ttype ReviewAuthorityClaim struct {\n   372\t\tSchemaVersion int    `json:\"schema_version\"`\n   373\t\tProject       string `json:\"project\"`\n   374\t\tBundleDigest  string `json:\"bundle_digest\"`\n   375\t\t// Principal and Role describe the reviewer. Role is `agent` or `human`.\n   376\t\tPrincipal string `json:\"principal\"`\n   377\t\tRole      string `json:\"role\"`\n   378\t\t// ReviewExecution and ImplementationExecution are the two runs the\n   379\t\t// separation is about; ImplementationPrincipal is who produced the change.\n   380\t\tReviewExecution         string `json:\"review_execution\"`\n   381\t\tImplementationPrincipal string `json:\"implementation_principal\"`\n   382\t\tImplementationExecution string `json:\"implementation_execution\"`\n   383\t\tIssuer                  string `json:\"issuer\"`\n   384\t\tIssuedAt                string `json:\"issued_at\"`\n   385\t\tExpiresAt               string `json:\"expires_at,omitempty\"`\n   386\t\t// Audience is the project this claim was issued for. A claim replayed from\n   387\t\t// another project names that project here and stops being satisfied.\n   388\t\tAudience string `json:\"audience\"`\n   389\t}\n   390\t\n   391\ttype ReviewAttestation struct {\n   392\t\tRun           *ReviewRunReference     `json:\"run,omitempty\"`\n   393\t\tSchemaVersion int                     `json:\"schema_version\"`\n   394\t\tAttestationID string                  `json:\"attestation_id\"`\n   395\t\tBundleID      string                  `json:\"bundle_id\"`\n   396\t\tBundleDigest  string                  `json:\"bundle_digest\"`\n   397\t\tReviewer      string                  `json:\"reviewer\"`\n   398\t\tDecision      string                  `json:\"decision\"`\n   399\t\tLimitations   []string                `json:\"limitations,omitempty\"`\n   400\t\tCriteria      []ReviewCriterion       `json:\"criteria\"`\n   401\t\tTools         []ReviewToolDisposition `json:\"tools,omitempty\"`\n   402\t\tEvidenceRefs  []string                `json:\"evidence_refs,omitempty\"`\n   403\t\tFindings      []ReviewFinding         `json:\"findings\"`\n   404\t\tAuthority     *ReviewAuthorityClaim   `json:\"authority,omitempty\"`\n   405\t\t// Attribution separates who prepared, concluded, confirmed and applied\n   406\t\t// the review (spec pose-review-attribution-roles). Absent on every record\n   407\t\t// written before it, which renders as legacy-undifferentiated.\n   408\t\tAttribution *ReviewAttribution          `json:\"attribution,omitempty\"`\n   409\t\tReusedFrom  []ReviewAttestationReuse    `json:\"reused_from,omitempty\"`\n   410\t\tSupersedes  string                      `json:\"supersedes,omitempty\"`\n   505\tfunc (s Store) prepareReviewBundle(ref string, legacyMilestoneManifest bool) (ReviewBundle, error) {\n   506\t\t// One index generation for the plan and for the evidence read after it.\n   507\t\tif s.indexPin == nil {\n   508\t\t\ts = s.PinIndexes()\n   509\t\t}\n   510\t\tscope, err := ParseScopeRef(ref)\n   511\t\tif err != nil {\n   512\t\t\treturn ReviewBundle{}, err\n   513\t\t}\n   514\t\tplan, err := s.ReviewPlan(ref)\n   515\t\tif err != nil {\n   516\t\t\treturn ReviewBundle{}, err\n   517\t\t}\n   518\t\tbundle := ReviewBundle{SchemaVersion: ReviewBundleSchemaVersion, State: \"prepared\", Warnings: uniqueSorted(append([]string{}, plan.Warnings...)), Blockers: uniqueSorted(append([]string{}, plan.Blockers...))}\n   519\t\tbundlePlanDigest, err := reviewBundlePlanDigest(plan)\n   520\t\tif err != nil {\n   521\t\t\treturn ReviewBundle{}, err\n   522\t\t}\n   523\t\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview, AcceptedLimits: append([]ReviewAcceptedLimit(nil), plan.AcceptedLimits...)}\n   524\t\n   525\t\tscopeProjection, excluded, err := s.reviewBundleScopeProjection(scope)\n   526\t\tif err != nil {\n   527\t\t\treturn ReviewBundle{}, err\n   528\t\t}\n   529\t\tbundle.Payload.Scope = scopeProjection\n   530\t\tbundle.ExcludedInputs = excluded\n  1955\t\t}\n  1956\t\tfor rule := range rules {\n  1957\t\t\trel := \".pose/rules/\" + rule + \".md\"\n  1958\t\t\tif raw, err := s.fsys().ReadFile(filepath.Join(s.Root, filepath.FromSlash(rel))); err == nil {\n  1959\t\t\t\tinputs = append(inputs, ReviewBundleInput{Kind: \"rule\", Path: rel, Digest: digestBytes(raw), Reason: \"selected by effective review criterion\"})\n  1960\t\t\t}\n  1961\t\t}\n  1962\t\treturn sortedBundleInputs(inputs)\n  1963\t}\n  1964\t\n  1965\tfunc reviewBundlePlanDigest(plan ReviewPlan) (string, error) {\n  1966\t\tcontract := struct {\n  1967\t\t\tSchemaVersion             int                   `json:\"schema_version\"`\n  1968\t\t\tPolicySchemaVersion       int                   `json:\"policy_schema_version\"`\n  1969\t\t\tBaseProfile               string                `json:\"base_profile\"`\n  1970\t\t\tIndependence              string                `json:\"independence\"`\n  1971\t\t\tComponents                []ReviewPlanComponent `json:\"components\"`\n  1972\t\t\tSelectedProfiles          []ReviewPlanProfile   `json:\"selected_profiles\"`\n  1973\t\t\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n  1974\t\t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n  1975\t\t\tLimitations               []string              `json:\"limitations,omitempty\"`\n  1976\t\t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n  1977\t\t}{plan.SchemaVersion, plan.PolicySchemaVersion, plan.BaseProfile, plan.Independence, append([]ReviewPlanComponent{}, plan.Components...), append([]ReviewPlanProfile{}, plan.SelectedProfiles...), append([]ReviewPlanCriterion{}, plan.Criteria...), append([]ReviewPlanTool{}, plan.Tools...), plan.Limitations, plan.DelegatedRunProofRequired}\n  1978\t\treturn digestJSON(contract)\n  1979\t}\n  1980\t\n  1981\tfunc normalizeReviewBundlePayload(payload *ReviewBundlePayload) {\n  1982\t\tsort.Slice(payload.Scope.Sections, func(i, j int) bool { return payload.Scope.Sections[i].Path < payload.Scope.Sections[j].Path })\n  1983\t\tsort.Slice(payload.Plan.Components, func(i, j int) bool { return payload.Plan.Components[i].ID < payload.Plan.Components[j].ID })\n  1984\t\tsort.Slice(payload.Plan.Criteria, func(i, j int) bool { return payload.Plan.Criteria[i].ID < payload.Plan.Criteria[j].ID })\n  1985\t\tsort.Slice(payload.Plan.Tools, func(i, j int) bool {\n  1986\t\t\treturn reviewToolKey(payload.Plan.Tools[i].ID, payload.Plan.Tools[i].Component) < reviewToolKey(payload.Plan.Tools[j].ID, payload.Plan.Tools[j].Component)\n  1987\t\t})\n  1988\t\tpayload.ConsumedInputs = sortedBundleInputs(payload.ConsumedInputs)\n  1989\t}\n  1990\t\n   535\t\t\tcomponent.ValidationProfile = \"\"\n   536\t\t\treturn\n   537\t\t}\n   538\t\tfor _, field := range component.MetadataMissing {\n   539\t\t\tswitch strings.ToLower(field) {\n   540\t\t\tcase \"language\":\n   541\t\t\t\tcomponent.Language = \"\"\n   542\t\t\tcase \"owner\":\n   543\t\t\t\tcomponent.Owner = \"\"\n   544\t\t\tcase \"domain\":\n   545\t\t\t\tcomponent.Domain = \"\"\n   546\t\t\tcase \"criticality\":\n   547\t\t\t\tcomponent.Criticality = \"\"\n   548\t\t\tcase \"validationprofile\", \"validation_profile\":\n   549\t\t\t\tcomponent.ValidationProfile = \"\"\n   550\t\t\t}\n   551\t\t}\n   552\t}\n   553\t\n   554\tfunc (s Store) reviewScopeSpecs(scope ScopeRef) ([]Spec, error) {\n   555\t\tslugs := []string{}\n   556\t\tswitch scope.Kind {\n   557\t\tcase \"spec\":\n   558\t\t\tslugs = append(slugs, scope.Slug)\n   559\t\tcase \"milestone\":\n   560\t\t\trm, err := s.GetRoadmap(scope.Roadmap)\n   561\t\t\tif err != nil {\n   562\t\t\t\treturn nil, err\n   563\t\t\t}\n   564\t\t\tfound := false\n   565\t\t\tfor _, milestone := range rm.Milestones {\n   566\t\t\t\tif milestone.ID == scope.Milestone {\n   567\t\t\t\t\tslugs, found = append(slugs, milestone.Specs...), true\n   568\t\t\t\t}\n   569\t\t\t}\n   570\t\t\tif !found {\n   571\t\t\t\treturn nil, fmt.Errorf(\"pose: milestone %s/%s not found\", scope.Roadmap, scope.Milestone)\n   572\t\t\t}\n   573\t\tcase \"roadmap\":\n   574\t\t\trm, err := s.GetRoadmap(scope.Slug)\n   575\t\t\tif err != nil {\n   576\t\t\t\treturn nil, err\n   577\t\t\t}\n   578\t\t\tfor _, milestone := range rm.Milestones {\n   579\t\t\t\tslugs = append(slugs, milestone.Specs...)\n   580\t\t\t}\n   581\t\t}\n   582\t\tspecs := []Spec{}\n   583\t\tfor _, raw := range uniqueSorted(slugs) {\n   584\t\t\t// Another project's member contributes no local components; its\n   585\t\t\t// review lives in its own project and reaches this scope through the\n   586\t\t\t// federated manifest.\n   587\t\t\tslug, external := s.canonicalMember(raw)\n   588\t\t\tif external {\n   589\t\t\t\tcontinue\n   590\t\t\t}\n   570\t\t}\n   571\t\tif strings.TrimSpace(draft.Sweep) == \"\" {\n   572\t\t\tproblems = append(problems, \"the draft does not state what it swept\")\n   573\t\t}\n   574\t\treturn problems\n   575\t}\n   576\t\n   577\t// quoteLedgerText renders text an earlier reviewer wrote as one quoted line:\n   578\t// whitespace collapsed, backticks neutralized, so it can open no section and\n   579\t// carry no instruction of its own (review round 1, B4).\n   580\tfunc quoteLedgerText(text string) string {\n   581\t\treturn strings.ReplaceAll(strings.Join(strings.Fields(text), \" \"), \"`\", \"'\")\n   582\t}\n   583\t\n   584\t// renderPriorRound is the brief's section of round 2 and later, built only\n   585\t// from the ledger, byte-stable for the same ledger state (R2, R3).\n   586\tfunc renderPriorRound(round ReviewRound) string {\n   587\t\tvar b strings.Builder\n   588\t\tline := func(format string, a ...any) { fmt.Fprintf(&b, format+\"\\n\", a...) }\n   589\t\tline(\"## Previous round\")\n   590\t\tline(\"\")\n   591\t\tline(\"This is round %d of the scope.\", round.Number)\n   592\t\tif round.Prior != nil {\n   593\t\t\thead := \"\"\n   594\t\t\tif round.PriorBundle != nil {\n   595\t\t\t\thead = round.PriorBundle.Payload.Subject.Head\n   596\t\t\t}\n   597\t\t\tline(\"The previous round is run %s on bundle %s (commit %s); its draft digest is %s.\", round.Prior.RunID, round.Prior.BundleID, orNone(head), digestBytes([]byte(round.Prior.Output)))\n   598\t\t}\n   599\t\tif round.Broken != \"\" {\n   600\t\t\tline(\"Some drafts of earlier rounds could not be read; the findings open before them stay open: %s.\", quoteLedgerText(round.Broken))\n     1\tpackage pose\n     2\t\n     3\t// Draft check (spec pose-review-readiness-before-seal R3): the reasons the\n     4\t// conclusion step and the attestation preflight would refuse a reviewer's\n     5\t// draft, computed before the run ends and without writing anything. It\n     6\t// reuses the same parsers and content checks; only the run's own proof,\n     7\t// signature and identity, which do not exist yet, are left out.\n     8\t//\n     9\t// A sealed checkout holds the subject, not the bundle sealed over it nor the\n    10\t// run ledger, so the dispatch writes both to the run's private directory and\n    11\t// names it in ReviewDraftContextEnv.\n    12\t\n    13\timport (\n    14\t\t\"encoding/json\"\n    15\t\t\"fmt\"\n    16\t\t\"os\"\n    17\t\t\"path/filepath\"\n    18\t\t\"strings\"\n    19\t\t\"time\"\n    20\t)\n    21\t\n    22\t// ReviewDraftContextEnv names the file holding the bundle and round a draft\n    23\t// is checked against inside a delegated review.\n    24\tconst ReviewDraftContextEnv = \"POSE_REVIEW_DRAFT_CONTEXT\"\n    25\t\n    26\t// ReviewCLIEnv names the executable of the engine that dispatched a review,\n    27\t// so the reviewer checks its draft with it and not with another installed\n    28\t// `pose` (review round 1).\n    29\tconst ReviewCLIEnv = \"POSE_REVIEW_CLI\"\n    30\t\n    31\tconst reviewDraftContextSchema = \"pose.review-draft-context/v1\"\n    32\t\n    33\t// ReviewDraftContext is what a draft is judged against: the sealed bundle and\n    34\t// the findings its round must account for.\n    35\ttype ReviewDraftContext struct {\n    36\t\tSchema string              `json:\"schema\"`\n    37\t\tBundle ReviewBundle        `json:\"bundle\"`\n    38\t\tRound  int                 `json:\"round\"`\n    39\t\tOpen   []ReviewOpenFinding `json:\"open,omitempty\"`\n    40\t}\n    41\t\n    42\t// ReviewDraftContextFor builds the context of bundle from the run ledger.\n    43\tfunc (s Store) ReviewDraftContextFor(bundle ReviewBundle) (ReviewDraftContext, error) {\n    44\t\tround, err := s.ReviewRoundOf(bundle)\n    45\t\tif err != nil {\n    46\t\t\treturn ReviewDraftContext{}, err\n    47\t\t}\n    48\t\treturn ReviewDraftContext{Schema: reviewDraftContextSchema, Bundle: bundle, Round: round.Number, Open: round.Open}, nil\n    49\t}\n    50\t\n    51\t// writeReviewDraftContext writes ctx under dir and returns its path.\n    52\tfunc writeReviewDraftContext(dir string, ctx ReviewDraftContext) (string, error) {\n    53\t\traw, err := json.Marshal(ctx)\n    54\t\tif err != nil {\n    55\t\t\treturn \"\", err\n    56\t\t}\n    57\t\tpath := filepath.Join(dir, \"pose-review-draft-context.json\")\n    58\t\treturn path, os.WriteFile(path, raw, 0o600)\n    59\t}\n    60\t\n    61\t// ReadReviewDraftContext reads a context file a dispatch wrote.\n    62\tfunc ReadReviewDraftContext(path string) (ReviewDraftContext, error) {\n    63\t\tvar ctx ReviewDraftContext\n    64\t\traw, err := os.ReadFile(path)\n    65\t\tif err != nil {\n    66\t\t\treturn ctx, err\n    67\t\t}\n    68\t\tif err := json.Unmarshal(raw, &ctx); err != nil {\n    69\t\t\treturn ctx, fmt.Errorf(\"pose: reading draft context %s: %w\", path, err)\n    70\t\t}\n    71\t\tif ctx.Schema != reviewDraftContextSchema || ctx.Bundle.BundleID == \"\" {\n    72\t\t\treturn ctx, fmt.Errorf(\"pose: %s is not a review draft context\", path)\n    73\t\t}\n    74\t\treturn ctx, nil\n    75\t}\n    76\t\n    77\t// CheckReviewDraft returns every reason a draft for ref would be refused at\n    78\t// conclusion, or nil when none applies. ref is a bundle id, or a run id whose\n    79\t// bundle is used.\n    80\tfunc (s Store) CheckReviewDraft(ref, output string, now time.Time) ([]string, error) {\n    81\t\tbundleID := ref\n    82\t\tif strings.HasPrefix(ref, \"rrn-\") {\n    83\t\t\trun, err := s.LoadProvenanceReviewRun(ref)\n    84\t\t\tif err != nil {\n    85\t\t\t\treturn nil, err\n    86\t\t\t}\n    87\t\t\tbundleID = run.BundleID\n    88\t\t}\n    89\t\tbundle, err := s.LoadReviewBundle(bundleID)\n    90\t\tif err != nil {\n    91\t\t\treturn nil, err\n    92\t\t}\n    93\t\tctx, err := s.ReviewDraftContextFor(bundle)\n    94\t\tif err != nil {\n    95\t\t\treturn nil, err\n    96\t\t}\n    97\t\treturn s.CheckReviewDraftIn(ctx, output, now), nil\n    98\t}\n    99\t\n   100\t// CheckReviewDraftIn judges output against ctx.\n   101\tfunc (s Store) CheckReviewDraftIn(ctx ReviewDraftContext, output string, now time.Time) []string {\n   102\t\tvar reasons []string\n   103\t\tdraft, err := ParseReviewDraft(output)\n   104\t\tswitch {\n   105\t\tcase err != nil:\n   106\t\t\treasons = append(reasons, \"the conclusion cannot be read: \"+err.Error())\n   107\t\tcase draft == nil:\n   108\t\t\treasons = append(reasons, \"the final message carries no pose-draft block\")\n   109\t\t}\n   110\t\tif err == nil {\n   111\t\t\tround := ReviewRound{Number: ctx.Round, Open: ctx.Open}\n   112\t\t\tif problems := ValidateRoundDraft(round, output); len(problems) > 0 {\n   113\t\t\t\treasons = append(reasons, \"the draft does not account for its round: \"+strings.Join(problems, \"; \"))\n   114\t\t\t}\n   115\t\t}\n   116\t\tif draft != nil && reviewDecisionApproves(draft.Decision) {\n   117\t\t\tbundle := ctx.Bundle\n   118\t\t\trun := ReviewRun{RunID: \"draft-check\", BundleID: bundle.BundleID, Kind: ReviewBriefKindReview}\n   119\t\t\tatt := reviewAttestationFromDraft(run, bundle, *draft, \"agent:draft-check/unknown\")\n   120\t\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\n   121\t\t\tif err != nil {\n   122\t\t\t\treasons = append(reasons, \"the attestation preflight refuses it: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n   123\t\t\t} else if blockers := s.attestationContentBlockers(bundle, completed, false); len(blockers) > 0 {\n   124\t\t\t\treasons = append(reasons, \"the attestation preflight refuses it: \"+strings.Join(uniqueSorted(blockers), \"; \"))\n   125\t\t\t}\n   126\t\t}\n   127\t\treturn reasons\n   128\t}\n","exit_code":0,"status":"completed"}}
