n   595\t\t\tspecs = append(specs, *sp)\n   596\t\t}\n   597\t\treturn specs, nil\n   598\t}\n   599\t\n   600\tfunc (s Store) loadReviewRepoEntries() ([]reviewRepoEntry, error) {\n   601\t\tentries := []reviewRepoEntry{}\n   602\t\tseen := map[string]bool{}\n   603\t\n   604\t\t// 1. Try .pose/indexes/repo-map.json if present\n   605\t\traw, _, mapErr := s.ReadIndex(\"repo-map.json\")\n   606\t\tif errors.Is(mapErr, ErrIndexGenerationUnavailable) {\n   607\t\t\treturn nil, fmt.Errorf(\"review component map is unavailable: %w\", mapErr)\n   608\t\t}\n   609\t\tif mapErr == nil {\n   610\t\t\tvar repo struct {\n   611\t\t\t\tApps     []reviewRepoEntry `json:\"apps\"`\n   612\t\t\t\tServices []reviewRepoEntry `json:\"services\"`\n   613\t\t\t\tPackages []reviewRepoEntry `json:\"packages\"`\n   614\t\t\t}\n   615\t\t\tif err := json.Unmarshal(raw, &repo); err != nil {\n   616\t\t\t\treturn nil, fmt.Errorf(\"review component map is invalid: %w\", err)\n   617\t\t\t}\n   618\t\t\tfor kind, values := range map[string][]reviewRepoEntry{\"app\": repo.Apps, \"service\": repo.Services, \"package\": repo.Packages} {\n   619\t\t\t\tfor _, entry := range values {\n   620\t\t\t\t\tentry.Kind = kind\n   621\t\t\t\t\tif entry.Name == \"\" || entry.Path == \"\" {\n   622\t\t\t\t\t\tcontinue\n   623\t\t\t\t\t}\n   624\t\t\t\t\tentry.Path = filepath.ToSlash(filepath.Clean(entry.Path))\n   625\t\t\t\t\tif err := validateReviewPath(s.fsys(), s.Root, entry.Path); err != nil {\n   626\t\t\t\t\t\treturn nil, fmt.Errorf(\"review component map path %q is unsafe: %w\", entry.Path, err)\n   627\t\t\t\t\t}\n   628\t\t\t\t\tif !seen[entry.Path] {\n   629\t\t\t\t\t\tseen[entry.Path] = true\n   630\t\t\t\t\t\tentries = append(entries, entry)\n  1920\t\treturn blockers\n  1921\t}\n  1922\t\n  1923\tfunc blockedByAChild(blockers []string) bool {\n  1924\t\tfor _, blocker := range blockers {\n  1925\t\t\tif strings.HasPrefix(blocker, reviewChildPrefix) {\n  1926\t\t\t\treturn true\n  1927\t\t\t}\n  1