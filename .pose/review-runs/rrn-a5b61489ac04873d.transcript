s from the indexes, unless the\n   211\t\t// operation that asks for the plan already fixed one.\n   212\t\tif s.indexPin == nil {\n   213\t\t\ts = s.PinIndexes()\n   214\t\t}\n   215\t\tscope, err := ParseScopeRef(ref)\n   216\t\tif err != nil {\n   217\t\t\treturn ReviewPlan{}, err\n   218\t\t}\n   219\t\tdigest, err := s.ScopeDigest(ref)\n   220\t\tif err != nil {\n   221\t\t\treturn ReviewPlan{}, err\n   222\t\t}\n   223\t\tpolicy, _, err := s.loadReviewPolicy()\n   224\t\tif err != nil {\n   225\t\t\treturn ReviewPlan{}, err\n   226\t\t}\n   227\t\t// Resolved before the policy below is trusted. A diff that disables review\n   228\t\t// while changing the contract would otherwise be unreviewable: the plan\n   229\t\t// would refuse to exist, and the change would land unreviewed.\n   230\t\tguard := s.resolveReviewGovernanceGuard(scope)\n   420\t}\n   421\t\n   422\tfunc (s Store) resolveReviewPlanContext(scope ScopeRef) (reviewPlanContext, error) {\n   423\t\t// One generation for the whole plan: the component map and the observed\n   424\t\t// paths are read from the same set, even if a publication commits meanwhile.\n   425\t\tif s.indexPin == nil {\n   426\t\t\ts = s.PinIndexes()\n   427\t\t}\n   428\t\tcontext := reviewPlanContext{Components: []ReviewPlanComponent{}, DeliveryKinds: []string{}, ArtifactPaths: []string{}, SpecSlugs: []string{}}\n   429\t\tspecs, err := s.reviewScopeSpecs(scope)\n   430\t\tif err != nil {\n   431\t\t\treturn context, err\n   432\t\t}\n   433\t\tentries, err := s.loadReviewRepoEntries()\n   434\t\tif err != nil {\n   435\t\t\tcontext.Blockers = append(context.Blockers, err.Error())\n   436\t\t}\n   437\t\tbyPath := map[string]ReviewPlanComponent{}\n   438\t\tunmapped := map[string]bool{}\n   185\t\tKnown        map[string]bool\n   186\t\tHasSection   bool\n   187\t}\n   188\t\n   189\tfunc (s Store) reviewDesignBasisNamespace(scope ScopeRef) reviewDesignBasisNamespace {\n   190\t\tns := reviewDesignBasisNamespace{Requirements: map[string]bool{}, Reaches: map[string]bool{}, Known: map[string]bool{}}\n   191\t\tspecs, err := s.reviewScopeSpecs(scope)\n   192\t\tif err != nil {\n   193\t\t\treturn ns\n   194\t\t}\n   195\t\tfor _, spec := range specs {\n   196\t\t\trequirements, constraints := declaredDesignRequirements(spec.Body)\n   197\t\t\tfor id := range requirements {\n   198\t\t\t\tns.Requirements[id], ns.Known[id], ns.Reaches[id] = true, true, true\n   199\t\t\t}\n   200\t\t\tfor id := range constraints {\n   201\t\t\t\tns.Requirements[id], ns.Known[id], ns.Reaches[id] = true, true, true\n   202\t\t\t}\n   203\t\t\treport := ValidateDesignBasisIn(s.fsys(), spec.Body, s.Root)\n   204\t\t\tif !report.HasSection {\n   205\t\t\t\tcontinue\n   206\t\t\t}\n   207\t\t\tns.HasSection = true\n   208\t\t\tassumptionReaches := map[string]bool{}\n   209\t\t\tfor _, assumption := range report.Assumptions {\n   210\t\t\t\tns.Known[assumption.ID] = true\n   211\t\t\t\tfor _, affected := range assumption.Affects {\n   212\t\t\t\t\tif ns.Requirements[affected] {\n   213\t\t\t\t\t\tassumptionReaches[assumption.ID] = true\n   214\t\t\t\t\t}\n   215\t\t\t\t}\n   216\t\t\t\tif assumptionReaches[assumption.ID] {\n   217\t\t\t\t\tns.Reaches[assumption.ID] = true\n   218\t\t\t\t}\n   219\t\t\t}\n   220\t\t\tfor _, decision := range report.Decisions {\npose-mcp/internal/pose/review_bundle.go:1722:func (s Store) reviewScopeRequiresValidationEvidence(scope ScopeRef, plan ReviewBundlePlan, graph DeliveryIntegrityGraph) bool {\npose-mcp/internal/pose/causality_closeout.go:68:func (s Store) reviewScopeCreatedBefore(scope ScopeRef, date string) bool {\npose-mcp/internal/pose/causality_closeout.go:86:func (s Store) reviewScopeBasis(scope ScopeRef) map[string]string {\npose-mcp/internal/pose/causality_closeout.go:100:func (s Store) reviewScopeNodeStates(scope ScopeRef) map[string]ContractNode {\npose-mcp/internal/pose/review_plan.go:554:func (s Store) reviewScopeSpecs(scope ScopeRef) ([]Spec, error) {\n","exit_code"