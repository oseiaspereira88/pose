{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EinHrX6pXnnLhM4UPyrjos","type":"tool_result","content":"130\t\treturn \"\"\n131\t}\n132\tfunc resetPattern(a ReviewerAdapter) string {\n133\t\tif a.Limit != nil {\n134\t\t\treturn a.Limit.ResetPattern\n135\t\t}\n136\t\treturn \"\"\n137\t}\n138\tfunc captureReviewValue(pattern, text string) (string, error) {\n139\t\tif pattern == \"\" {\n140\t\t\treturn \"\", nil\n141\t\t}\n142\t\tr, e := regexp.Compile(pattern)\n143\t\tif e != nil {\n144\t\t\treturn \"\", e\n145\t\t}\n146\t\tmatches := r.FindAllStringSubmatch(text, 3)\n147\t\tif len(matches) == 0 {\n148\t\t\treturn \"\", nil\n149\t\t}\n150\t\tif len(matches) != 1 || len(matches[0]) != 2 {\n151\t\t\treturn \"\", fmt.Errorf(\"ambiguous adapter capture\")\n152\t\t}\n153\t\tvalue := matches[0][1]\n154\t\tif len(value) == 0 || len(value) > 2048 || strings.ContainsAny(value, \"\\x00\\r\\n\") {\n155\t\t\treturn \"\", fmt.Errorf(\"adapter capture is not a bounded reference\")\n156\t\t}\n157\t\treturn value, nil\n158\t}\n159\tfunc (s Store) saveReviewSession(value string) (string, error) {\n160\t\tdigest := digestBytes([]byte(value))\n161\t\tdir, e := ensureReviewArtifactDir(s.Root, reviewPrivateDir, true)\n162\t\tif e != nil {\n163\t\t\treturn \"\", e\n164\t\t}\n165\t\tif e = os.Chmod(dir, 0700); e != nil {\n166\t\t\treturn \"\", e\n167\t\t}\n168\t\t// Private session files are runtime state, never published evidence.\n169\t\tignore := filepath.Join(dir, \".gitignore\")\n170\t\tif e = PublishFile(ignore, []byte(\"*\\n\"), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); e != nil {\n171\t\t\treturn \"\", e\n172\t\t}\n173\t\te = PublishFile(filepath.Join(dir, strings.TrimPrefix(digest, \"sha256:\")+\".session\"), []byte(value), 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent})\n174\t\treturn digest, e\n175\t}\n176\tfunc (s Store) readReviewSession(digest string) (string, error) {\n177\t\tif len(digest) != 71 || !strings.HasPrefix(digest, \"sha256:\") || strings.ContainsAny(digest, \"/\\\\\") {\n178\t\t\treturn \"\", fmt.Errorf(\"invalid session digest\")\n179\t\t}\n180\t\tdir, e := ensureReviewArtifactDir(s.Root, reviewPrivateDir, false)\n181\t\tif e != nil {\n182\t\t\treturn \"\", e\n183\t\t}\n184\t\traw, e := readLedgerRaw(filepath.Join(dir, strings.TrimPrefix(digest, \"sha256:\")+\".session\"))\n185\t\tif e != nil {\n186\t\t\treturn \"\", e\n187\t\t}\n188\t\tif digestBytes(raw) != digest || len(raw) == 0 || len(raw) > 2048 {\n189\t\t\treturn \"\", fmt.Errorf(\"private session digest differs\")\n190\t\t}\n191\t\treturn string(raw), nil\n192\t}\n193\tfunc (s Store) classifyReviewInterruption(run *ReviewRun, plan DispatchPlan, transcript []byte, runErr, ctxErr error) (string, string, error) {\n194\t\t// Inspect both supported output channels before any public publication.\n195\t\tchannels := append([]string{string(transcript), run.Output}, plan.extraChannels...)\n196\t\tvalue, e := captureReviewChannels(sessionPattern(plan.Config), channels...)\n197\t\tif e != nil {\n198\t\t\treturn \"\", \"\", e\n199\t\t}\n200\t\tif value != \"\" && plan.session != \"\" && value != plan.session {\n201\t\t\treturn \"\", \"\", fmt.Errorf(\"adapter changed the captured session\")\n202\t\t}\n203\t\tif value == \"\" {\n204\t\t\tvalue = plan.session\n205\t\t}\n206\t\tif value != \"\" {\n207\t\t\trun.sessionForRedaction = value\n208\t\t\trun.SessionDigest, e = s.saveReviewSession(value)\n209\t\t\tif e != nil {\n210\t\t\t\treturn \"\", \"\", e\n211\t\t\t}\n212\t\t}\n213\t\tcause := \"\"\n214\t\tif ctxErr != nil {\n215\t\t\tcause = \"timeout\"\n216\t\t\tif errors.Is(ctxErr, context.Canceled) {\n217\t\t\t\tcause = \"cancelled\"\n218\t\t\t}\n219\t\t} else if runErr != nil && run.ExitCode < 0 {\n220\t\t\tcause = \"process-lost\"\n221\t\t}\n222\t\tlimit := false\n223\t\tif p := plan.Config.Limit; p != nil {\n224\t\t\tfor _, code := range p.ExitCodes {\n225\t\t\t\tif code == run.ExitCode {\n226\t\t\t\t\tlimit = true\n227\t\t\t\t}\n228\t\t\t}\n229\t\t\tfor _, pattern := range p.OutputPatterns {\n230\t\t\t\tfor _, channel := range channels {\n231\t\t\t\t\tif regexp.MustCompile(pattern).MatchString(channel) {\n232\t\t\t\t\t\tlimit = true\n233\t\t\t\t\t}\n234\t\t\t\t}\n235\t\t\t}\n236\t\t}\n237\t\tif limit {\n238\t\t\tcause = \"usage-limit\"\n239\t\t}\n240\t\tsupervisorCause := cause\n241\t\tif cause == \"\" {\n242\t\t\tif runErr != nil {\n243\t\t\t\treturn ReviewRunFailed, \"the reviewer command failed: \" + runErr.Error(), nil\n244\t\t\t}\n245\t\t\treturn \"\", \"\", nil\n246\t\t}\n247\t\t// Without any continuity declaration, interruption classification is unknown.\n248\t\tif plan.Config.Limit == nil && plan.Config.Session == nil && plan.Config.Resume == nil {\n249\t\t\tcause = \"unknown\"\n250\t\t}\n251\t\tinterruption := &ReviewInterruption{Cause: cause, Resumable: run.SessionDigest != \"\" && plan.Config.Resume != nil && len(plan.Config.Resume.Command) > 0}\n252\t\tif cause == \"usage-limit\" {\n253\t\t\treset, e := captureReviewChannels(resetPattern(plan.Config), channels...)\n254\t\t\tif e != nil {\n255\t\t\t\treturn \"\", \"\", e\n256\t\t\t}\n257\t\t\tif reset != \"\" {\n258\t\t\t\tt, e := time.Parse(time.RFC3339Nano, reset)\n259\t\t\t\tif e != nil {\n260\t\t\t\t\treturn \"\", \"\", fmt.Errorf(\"adapter reset instant is not RFC3339\")\n261\t\t\t\t}\n262\t\t\t\tinterruption.ResetAt = t.UTC().Format(time.RFC3339Nano)\n263\t\t\t}\n264\t\t}\n265\t\trun.Interruption = interruption\n266\t\treturn ReviewRunInterrupted, \"review interrupted: \" + cause + \" (supervisor: \" + supervisorCause + \")\", nil\n267\t}\n268\tfunc validateContinuityRun(r ReviewRun) error {\n269\t\tif r.Status == ReviewRunInterrupted {\n270\t\t\tif r.Interruption == nil {\n271\t\t\t\treturn fmt.Errorf(\"interrupted run has no cause\")\n272\t\t\t}\n273\t\t\tswitch r.Interruption.Cause {\n274\t\t\tcase \"usage-limit\", \"timeout\", \"process-lost\", \"cancelled\", \"unknown\":\n275\t\t\tdefault:\n