{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016JofT8KVafwGnRoA4t4neH","type":"tool_result","content":"diff --git a/.pose/changelogs/unreleased/pose-delegated-output-redaction-root-cause.md b/.pose/changelogs/unreleased/pose-delegated-output-redaction-root-cause.md\nnew file mode 100644\nindex 00000000..b047fc95\n--- /dev/null\n+++ b/.pose/changelogs/unreleased/pose-delegated-output-redaction-root-cause.md\n@@ -0,0 +1,7 @@\n+---\n+spec: pose-delegated-output-redaction-root-cause\n+category: fixed\n+breaking: false\n+---\n+\n+Delegated task capture failures now identify the agent, event format, failing stage and a safe reason. Ambiguous Claude session capture suggests restricting the pattern to system/init; unsafe output remains withheld.\ndiff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex b4250b9a..61fba617 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -311,6 +311,13 @@\n       \"stack\": \"go\",\n       \"replaceDefaultChecks\": true,\n       \"checks\": [\n+        {\n+          \"name\": \"delegated-output-redaction-diagnostics-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"./internal/cli\", \"-run\", \"TestDelegateTaskExplainsTheLegacyClaudeSessionCaptureFailure|TestDelegateTaskDiagnosesRedactionGrowth|TestDelegationCaptureFailureWithholdsPrivateErrorDetails\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"build\",\n           \"program\": \"go\",\ndiff --git a/.pose/starts/pose-delegated-output-redaction-root-cause.json b/.pose/starts/pose-delegated-output-redaction-root-cause.json\nnew file mode 100644\nindex 00000000..d7593aa9\n--- /dev/null\n+++ b/.pose/starts/pose-delegated-output-redaction-root-cause.json\n@@ -0,0 +1,38 @@\n+{\n+  \"schema_version\": 1,\n+  \"spec\": \"pose-delegated-output-redaction-root-cause\",\n+  \"plan_digest\": \"85086c68d7746cb9c7290b94f78217644fb3cf838990a0372626695c2ea291a8\",\n+  \"revision\": \"fec94995cd423898b912ed90c20d19e1c9d77b8e\",\n+  \"spec_digest_before\": \"68a65b836e1d9dfa49a4322c56cd9687e738e01776327c9f86d0197cf0833cf0\",\n+  \"spec_digest_after\": \"3d3ade73b563b7e2912ba7a2e49cf43f64f22d9f4100e1c899c37096e75e75ce\",\n+  \"baseline\": {\n+    \"schema_version\": 1,\n+    \"namespace\": \"spec:pose-delegated-output-redaction-root-cause\",\n+    \"nodes\": [\n+      {\n+        \"id\": \"R1\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-delegated-output-redaction-root-cause\",\n+        \"hash\": \"29ee7925c86c\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R2\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-delegated-output-redaction-root-cause\",\n+        \"hash\": \"9fb25c7c3344\",\n+        \"state\": \"active\"\n+      },\n+      {\n+        \"id\": \"R3\",\n+        \"kind\": \"requirement\",\n+        \"namespace\": \"spec:pose-delegated-output-redaction-root-cause\",\n+        \"hash\": \"4a5d78c32507\",\n+        \"state\": \"active\"\n+      }\n+    ],\n+    \"digest\": \"sha256:10db851cd681474fde2397ae8af120dbd99cafb52f7513b901f6ffba0eb9f0cc\"\n+  },\n+  \"phase\": \"started\",\n+  \"recorded_at\": \"2026-11-12T08:06:14Z\"\n+}\ndiff --git a/pose-mcp/internal/cli/delegate_redaction_failure_test.go b/pose-mcp/internal/cli/delegate_redaction_failure_test.go\nnew file mode 100644\nindex 00000000..4c163049\n--- /dev/null\n+++ b/pose-mcp/internal/cli/delegate_redaction_failure_test.go\n@@ -0,0 +1,123 @@\n+package cli\n+\n+import (\n+\t\"encoding/json\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+func TestDelegateTaskExplainsTheLegacyClaudeSessionCaptureFailure(t *testing.T) {\n+\tconst session = \"synthetic-private-session-001\"\n+\tstream := `{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"` + session + `\"}` + \"\\n\" +\n+\t\t`{\"type\":\"result\",\"session_id\":\"` + session + `\",\"result\":\"task finished\"}` + \"\\n\"\n+\tfor _, tc := range []struct {\n+\t\tname, pattern string\n+\t\tok            bool\n+\t}{\n+\t\t{\"legacy\", `\"session_id\"\\s*:\\s*\"([^\"]+)\"`, false},\n+\t\t{\"init-only\", `(?m)^\\{\"type\"\\s*:\\s*\"system\"\\s*,\\s*\"subtype\"\\s*:\\s*\"init\"[^\\n]*\"session_id\"\\s*:\\s*\"([^\"\\r\\n]+)\"`, true},\n+\t} {\n+\t\tt.Run(tc.name, func(t *testing.T) {\n+\t\t\troot, _, prompt := taskInstance(t)\n+\t\t\tagent := map[string]any{\"vendor\": \"test\", \"model\": \"synthetic\", \"events\": \"claude-stream-json\", \"commands\": map[string][]string{\"read\": {\"sh\", \"-c\", \"cat >/dev/null; printf '%s' \\\"$1\\\"\", \"worker\", stream}}, \"session\": map[string]string{\"pattern\": tc.pattern}}\n+\t\t\traw, err := json.Marshal(agent)\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\twriteDelegation(t, root, taskPolicy(`\"default_access\":\"read\"`, `\"legacy-claude\":`+string(raw)))\n+\t\t\tcode, out, errOut := runPoseSplit(t, root, \"delegate\", \"task\", prompt, \"--agent\", \"legacy-claude\", \"--record\", \"--json\")\n+\t\t\tfiles, _ := filepath.Glob(filepath.Join(root, \".pose\", \"delegate-runs\", \"trn-*.json\"))\n+\t\t\tif len(files) != 1 {\n+\t\t\t\tt.Fatalf(\"record: %v; %d %s %s\", files, code, out, errOut)\n+\t\t\t}\n+\t\t\tvar record struct{ Status, Failure, Output string }\n+\t\t\tdata, err := os.ReadFile(files[0])\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif err := json.Unmarshal(data, &record); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif tc.ok {\n+\t\t\t\tif code != 0 || record.Status != \"completed\" || record.Output != \"task finished\" {\n+\t\t\t\t\tt.Fatalf(\"init-only: %d %s %s\", code, out, errOut)\n+\t\t\t\t}\n+\t\t\t} else {\n+\t\t\t\tif code == 0 || record.Status != \"failed\" || record.Output != \"\" {\n+\t\t\t\t\tt.Fatalf(\"ambiguous capture accepted: %d %s\", code, out)\n+\t\t\t\t}\n+\t\t\t\tfor _, want := range []string{\"legacy-claude\", \"claude-stream-json\", \"session/interrupt recognition\", \"ambiguous adapter capture\", \"system/init\"} {\n+\t\t\t\t\tif !strings.Contains(record.Failure, want) {\n+\t\t\t\t\t\tt.Errorf(\"failure lacks %q: %s\", want, record.Failure)\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t\tfor _, suffix := range []string{\".transcript\", \".stderr\"} {\n+\t\t\t\t\tretained, err := os.ReadFile(strings.TrimSuffix(files[0], \".json\") + suffix)\n+\t\t\t\t\tif err != nil || len(retained) != 0 {\n+\t\t\t\t\t\tt.Fatalf(\"unsafe capture retained: %v\", err)\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif strings.Contains(string(data)+out+errOut, session) {\n+\t\t\t\tt.Fatal(\"private session leaked\")\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestDelegateTaskDiagnosesRedactionGrowthWithoutKeepingTheCapture(t *testing.T) {\n+\troot, _, prompt := taskInstance(t)\n+\tstream := \"session: X\\n\" + strings.Repeat(\"X\", 80)\n+\tagent := map[string]any{\n+\t\t\"vendor\": \"test\", \"model\": \"synthetic\", \"events\": \"plain\",\n+\t\t\"commands\":    map[string][]string{\"read\": {\"sh\", \"-c\", \"cat >/dev/null; printf '%s' \\\"$1\\\"\", \"worker\", stream}},\n+\t\t\"session\":     map[string]string{\"pattern\": \"session: (X)\"},\n+\t\t\"containment\": map[string]any{\"schema_version\": 1, \"profile\": \"trusted-process\", \"stream_bytes\": 128},\n+\t}\n+\traw, err := json.Marshal(agent)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\twriteDelegation(t, root, taskPolicy(`\"default_access\":\"read\"`, `\"budget-profile\":`+string(raw)))\n+\tcode, out, errOut := runPoseSplit(t, root, \"delegate\", \"task\", prompt, \"--agent\", \"budget-profile\", \"--record\", \"--json\")\n+\tif code == 0 {\n+\t\tt.Fatalf(\"capture growth accepted: %s %s\", out, errOut)\n+\t}\n+\tfiles, _ := filepath.Glob(filepath.Join(root, \".pose\", \"delegate-runs\", \"trn-*.json\"))\n+\tif len(files) != 1 {\n+\t\tt.Fatalf(\"record: %v; %s %s\", files, out, errOut)\n+\t}\n+\tdata, err := os.ReadFile(files[0])\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tvar record struct {\n+\t\tStatus, Failure, Output string\n+\t\tSafety                  struct {\n+\t\t\tCaptureComplete bool `json:\"capture_complete\"`\n+\t\t}\n+\t}\n+\tif err := json.Unmarshal(data, &record); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif record.Status != \"failed\" || record.Output != \"\" || record.Safety.CaptureComplete {\n+\t\tt.Fatalf(\"unsafe capture promoted: %s\", data)\n+\t}\n+\tfor _, want := range []string{\"budget-profile\", `events=\"plain\"`, `stage=\"stdout\"`, \"redacted capture exceeds byte budget\"} {\n+\t\tif !strings.Contains(record.Failure, want) {\n+\t\t\tt.Errorf(\"failure lacks %q: %s\", want, record.Failure)\n+\t\t}\n+\t}\n+\tbase := strings.TrimSuffix(files[0], \".json\")\n+\tfor _, suffix := range []string{\".transcript\", \".stderr\"} {\n+\t\tretained, err := os.ReadFile(base + suffix)\n+\t\tif err != nil || len(retained) != 0 {\n+\t\t\tt.Fatalf(\"unsafe %s retained: %v\", suffix, err)\n+\t\t}\n+\t}\n+\tif _, err := os.Stat(base + \".events.ndjson\"); !os.IsNotExist(err) {\n+\t\tt.Fatalf(\"unsafe events retained: %v\", err)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/delegation_capture_failure.go b/pose-mcp/internal/pose/delegation_capture_failure.go\nnew file mode 100644\nindex 00000000..7eb6fd68\n--- /dev/null\n+++ b/pose-mcp/internal/pose/delegation_capture_failure.go\n@@ -0,0 +1,23 @@\n+package pose\n+\n+import \"fmt\"\n+\n+// Never interpolate an arbitrary capture error: session persistence errors may\n+// carry private paths, and future adapters may include raw output in errors.\n+func delegationCaptureFailure(agent, events, stage string, err error) string {\n+\treason := \"capture failed (private error details withheld)\"\n+\tswitch err.Error() {\n+\tcase \"ambiguous adapter capture\", \"adapter capture is not a bounded reference\",\n+\t\t\"conflicting adapter capture channels\", \"adapter changed the captured session\",\n+\t\t\"adapter reset instant is not RFC3339\", \"redacted capture exceeds byte budget\":\n+\t\treason = err.Error()\n+\t}\n+\tmessage := fmt.Sprintf(\"the agent's output could not be redacted; it was not kept (agent=%q events=%q stage=%q: %s)\", agent, events, stage, reason)\n+\tif reason == \"ambiguous adapter capture\" {\n+\t\tmessage += \"; the session/reset pattern must capture one reference per channel\"\n+\t\tif events == \"claude-stream-json\" {\n+\t\t\tmessage += \"; for a session_id repeated across events, restrict the session pattern to the system/init event\"\n+\t\t}\n+\t}\n+\treturn message\n+}\ndiff --git a/pose-mcp/internal/pose/delegation_capture_failure_test.go b/pose-mcp/internal/pose/delegation_capture_failure_test.go\nnew file mode 100644\nindex 00000000..cf213b98\n--- /dev/null\n+++ b/pose-mcp/internal/pose/delegation_capture_failure_test.go\n@@ -0,0 +1,23 @@\n+package pose\n+\n+import (\n+\t\"errors\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+func TestDelegationCaptureFailureWithholdsPrivateErrorDetails(t *testing.T) {\n+\tconst private = \"/private/synthetic-session/credential-value\"\n+\tfor _, stage := range []string{\"session/interrupt recognition\", \"argv\", \"stdout\", \"final output\", \"normalized events\", \"stderr\"} {\n+\t\tgot := delegationCaptureFailure(\"worker\", \"claude-stream-json\", stage, errors.New(\"open \"+private+\": denied\"))\n+\t\tif strings.Contains(got, private) || !strings.Contains(got, \"private error details withheld\") || !strings.Contains(got, stage) {\n+\t\t\tt.Fatalf(\"unsafe or unhelpful error: %s\", got)\n+\t\t}\n+\t}\n+\tfor _, reason := range []string{\"conflicting adapter capture channels\", \"adapter changed the captured session\", \"redacted capture exceeds byte budget\"} {\n+\t\tgot := delegationCaptureFailure(\"worker\", \"codex-jsonl\", \"stdout\", errors.New(reason))\n+\t\tif !strings.Contains(got, reason) || strings.Contains(got, \"system/init\") {\n+\t\t\tt.Fatalf(\"wrong diagnostic: %s\", got)\n+\t\t}\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/delegation_task.go b/pose-mcp/internal/pose/delegation_task.go\nindex 03bf2a24..a016c8c7 100644\n--- a/pose-mcp/internal/pose/delegation_task.go\n+++ b/pose-mcp/internal/pose/delegation_task.go\n@@ -783,6 +783,7 @@ func (s Store) RunDelegationTask(parent context.Context, plan DelegationTaskPlan\n \t// The session, the limit and the reset are recognized on stdout and\n \t// stderr, each as written; a session both print is one session, two\n \t// different ones are refused (B2; review round 3, B2 and B3).\n+\tcaptureStage := \"session/interrupt recognition\"\n \tstatus, failure, captureErr := s.classifyReviewInterruption(&run, DispatchPlan{Config: plan.adapter, session: plan.session, extraChannels: []string{string(errText)}}, transcript, runErr, ctx.Err())\n \tif run.Interruption != nil {\n \t\t// A task resumes with its access's command, not the review's.\n@@ -793,6 +794,7 @@ func (s Store) RunDelegationTask(parent context.Context, plan DelegationTaskPlan\n \t// The recorded argv is redacted again once the session is known: a\n \t// template may carry it literally.\n \tfor i := 0; captureErr == nil && session != \"\" && i < len(run.Argv); i++ {\n+\t\tcaptureStage = \"argv\"\n \t\tvar red []byte\n \t\tif red, captureErr = redactReviewCapture([]byte(run.Argv[i]), secrets, session, 17*int64(len(run.Argv[i]))+1); captureErr == nil {\n \t\t\trun.Argv[i] = string(red)\n@@ -800,6 +802,7 @@ func (s Store) RunDelegationTask(parent context.Context, plan DelegationTaskPlan\n \t}\n \targvSafe = captureErr == nil\n \tif captureErr == nil {\n+\t\tcaptureStage = \"stdout\"\n \t\tstdout, captureErr = redactReviewCapture(transcript, secrets, session, safety.StreamBytes)\n \t}\n \tif captureErr == nil && tailed {\n@@ -810,21 +813,24 @@ func (s Store) RunDelegationTask(parent context.Context, plan DelegationTaskPlan\n \t\trun.Output = tail(string(stdout), limit)\n \t}\n \tif captureErr == nil {\n+\t\tcaptureStage = \"final output\"\n \t\tvar redacted []byte\n \t\tif redacted, captureErr = redactReviewCapture([]byte(run.Output), secrets, session, safety.OutputBytes); captureErr == nil {\n \t\t\trun.Output = string(redacted)\n \t\t}\n \t}\n \tif captureErr == nil && run.Events != \"\" {\n+\t\tcaptureStage = \"normalized events\"\n \t\trun.eventsBytes, captureErr = redactedDelegationEvents(run.Events, transcript, run.Output, secrets, session)\n \t}\n \tif captureErr == nil {\n+\t\tcaptureStage = \"stderr\"\n \t\tstderr, captureErr = redactReviewCapture(errText, secrets, session, safety.StreamBytes)\n \t}\n \tif captureErr != nil {\n \t\trun.Output, stdout, stderr, run.eventsBytes = \"\", nil, nil, nil\n \t\tsafety.CaptureComplete = false\n-\t\treturn finish(ReviewRunFailed, \"the agent's output could not be redacted; it was not kept\")\n+\t\treturn finish(ReviewRunFailed, delegationCaptureFailure(run.Adapter, run.Events, captureStage, captureErr))\n \t}\n \tif status == \"\" {\n \t\tstatus = ReviewRunCompleted","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"67363ab0-abd4-4210-9d3a-a4a01424661c","timestamp":"2026-11-12T17:30:06.517Z","tool_use_result":{"stdout":"diff --git a/.pose/changelogs/unreleased/pose-delegated-output-redaction-root-cause.md b/.pose/changelogs/unreleased/pose-delegated-output-redaction-root-cause.md\nnew file mode 100644\nindex 00000000..b047fc95\n--- /dev/null\n+++ b/.pose/changelogs/unreleased/pose-delegated-output-redaction-root-cause.md\n@@ -0,0 +1,7 @@\n+---\n+spec: pose-delegated-output-redaction-root-cause\n+category: fixed\n+breaking: false\n+---\n+\n+Delegated task capture failures now identify the agent, event format, failing stage and a safe reason. Ambiguous Claude session capture suggests restricting the pattern to system/init; unsafe output remains withheld.\ndiff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex b4250b9a..61