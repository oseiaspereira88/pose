ers crit:low review:2026-12-28)\n+- [open] Count a tab as indentation to the next multiple of four when deciding whether a line opens a fence (review round 1, N5). (owner:@pose-maintainers crit:low review:2026-12-28)\n+- [open] Read a fence nested in a list item at four spaces as a fence, or record the changed answer as a decision (review round 1, N6). (owner:@pose-maintainers crit:low review:2026-12-28)\n+- [open] Read an inline code span continued over lines as Markdown does, so a comment opener inside it hides nothing (review round 1, N7). (owner:@pose-maintainers crit:low review:2026-12-28)\ndiff --git a/pose-mcp/internal/pose/accepted_limits.go b/pose-mcp/internal/pose/accepted_limits.go\nindex d4b6e29c..2f8db5ee 100644\n--- a/pose-mcp/internal/pose/accepted_limits.go\n+++ b/pose-mcp/internal/pose/accepted_limits.go\n@@ -94,7 +94,11 @@ func ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n \t\tif in && marker {\n \t\t\t// The next section's heading closes the section, whatever\n \t\t\t// comment it holds (spec pose-review-declared-limits-residuals R4).\n-\t\t\tif vis, still := visibleOutsideComments(raw, inComment); fence == \"\" && headingLine(vis) && !isAcceptedLimitsHeading(vis) {\n+\t\t\t// Only a line that is an unindented heading as written, its '#'\n+\t\t\t// first, is the next heading; one that reads as a heading only\n+\t\t\t// once a comment is removed stays inside and refuses (review\n+\t\t\t// round 1, N1).\n+\t\t\tif vis, still := visibleOutsideComments(raw, inComment); fence == \"\" && !inComment && strings.HasPrefix(raw, \"#\") && headingLine(vis) && !isAcceptedLimitsHeading(vis) {\n \t\t\t\tin, inComment = false, still\n \t\t\t\tcontinue\n \t\t\t}\n@@ -204,11 +208,19 @@ func ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n \treturn limits, boundProblems(problems)\n }\n \n-// acceptedLimitProblemLimit bounds the problems one spec reports.\n-const acceptedLimitProblemLimit = 20\n+// acceptedLimitProblemLimit bounds the problems one spec reports, and\n+// acceptedLimitProblemBytes the size of each.\n+const (\n+\tacceptedLimitProblemLimit = 20\n+\tacceptedLimitProblemBytes = 300\n+)\n \n // boundProblems keeps the first problems and counts the rest (R4).\n func boundProblems(problems []string) []string {\n+\t// Each problem is bounded in size too (review round 1, N2).\n+\tfor i, p := range problems {\n+\t\tproblems[i] = TruncateUTF8(p, acceptedLimitProblemBytes)\n+\t}\n \tif len(problems) <= acceptedLimitProblemLimit {\n \t\treturn problems\n \t}\n@@ -253,7 +265,7 @@ func fenceMarker(trimmed string) string {\n \treturn \"\"\n }\n \n-// acceptedLimitsAndProblemsOf is acceptedLimitsOf with the problems that kept\n+// acceptedLimitsAndProblemsOf collects the limits the scope's specs declare, with the problems that kept\n // limits from being sealed, so the plan says so (review round 1, N1).\n func (s Store) acceptedLimitsAndProblemsOf(scope ScopeRef) ([]ReviewAcceptedLimit, []string) {\n \tspecs, err := s.reviewScopeSpecs(scope)\n@@ -298,10 +310,8 @@ func sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n }\n \n // htmlCommentStart returns the index in s, from from on, of the next \"<!--\"\n-// that opens an HTML comment, or -1. One written in inline code (an odd\n-// number of backticks before it on its line) opens nothing: Markdown shows\n-// it as text, as a spec that names the marker does (review of\n-// pose-review-declared-limits-followups: its own R2 named it).\n+// that opens an HTML comment, or -1. One inside an inline code span of its\n+// line opens nothing: Markdown shows it as text.\n func htmlCommentStart(s string, from int) int {\n \t// Inline code is read as Markdown reads it: a run of n backticks opens a\n \t// span that only a run of exactly n backticks on the line closes; an\ndiff --git a/pose-mcp/internal/pose/accepted_limits_residuals_test.go b/pose-mcp/internal/pose/accepted_limits_residuals_test.go\nindex 7ad2a92c..7637edf9 100644\n--- a/pose-mcp/internal/pose/accepted_limits_residuals_test.go\n+++ b/pose-mcp/internal/pose/accepted_limits_residuals_test.go\n@@ -59,3 +59,34 @@ func TestAnEarlierWithinLimitDerivationStillMatches(t *testing.T) {\n \t\tt.Fatalf(\"the current derivation differs: %s\", why)\n \t}\n }\n+\n+// Review round 1, N1: inside the section, a line that reads as a heading only\n+// once a comment is removed does not close it: the section is refused.\n+func TestAHeadingRevealedByACommentDoesNotCloseTheSection(t *testing.T) {\n+\tfor _, line := range []string{\"  # of cases on Linux <!-- note --> only.\", \"<!-- c --> # only on Linux.\"} {\n+\t\tbody := \"### Accepted limits\\n- L1: An escape is open. Accepted because a shim covers it\\n\" + line + \"\\n- L2: Another escape. Accepted because it is rarer.\\n\"\n+\t\tif limits, problems := ParseAcceptedLimits(body); len(limits) != 0 || len(problems) == 0 {\n+\t\t\tt.Fatalf(\"%q closed the section: %+v %v\", line, limits, problems)\n+\t\t}\n+\t}\n+}\n+\n+// Review round 1, N2: each problem is bounded in size.\n+func TestAcceptedLimitProblemsAreBoundedInSize(t *testing.T) {\n+\t_, problems := ParseAcceptedLimits(\"### Accepted limits\\n\" + strings.Repeat(strings.Repeat(\"x\", 100000)+\"\\n\", 3))\n+\tfor _, p := range problems {\n+\t\tif len(p) > acceptedLimitProblemBytes+3 {\n+\t\t\tt.Fatalf(\"a problem of %d bytes\", len(p))\n+\t\t}\n+\t}\n+}\n+\n+// Review round 1, N3: the preview refuses what the write refuses, for any\n+// decision.\n+func TestThePreviewRefusesAnUnsealedLimitForAnyDecision(t *testing.T) {\n+\tf := resumableRunFixture(t)\n+\tatt := ReviewAttestation{BundleID: f.run.BundleID, Decision: \"changes-requested\", Findings: []ReviewFinding{{ID: \"n1\", Severity: \"low\", Disposition: \"within-limit\", Limit: \"L9\", Action: \"x\", Rationale: \"y\"}}}\n+\tif got := strings.Join(f.store.PreflightReviewAttestation(att, time.Now()), \";\"); !strings.Contains(got, \"did not seal\") {\n+\t\tt.Fatalf(\"the preview of a non-approvi