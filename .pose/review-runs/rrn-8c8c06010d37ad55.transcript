{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019CsqBVoRTwQLEkNekpVgda","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"go/ast\"\n5\t\t\"go/parser\"\n6\t\t\"go/token\"\n7\t\t\"sort\"\n8\t\t\"strconv\"\n9\t\t\"strings\"\n10\t\t\"testing\"\n11\t)\n12\t\n13\t// Spec pose-review-brief-states-the-conclusion-rules R2.\n14\t//\n15\t// The messages the preflight can refuse a conclusion with are read from the source of the\n16\t// functions that raise them. Each fragment either names the sentence of the brief that states\n17\t// its rule, or is exempt with the reason a reviewer cannot break it. A fragment that is in\n18\t// neither fails the build: a blocker added to the preflight cannot ship without the brief\n19\t// saying so, or without someone writing down why it need not.\n20\t\n21\tvar preflightFunctions = map[string][]string{\n22\t\t\"review_bundle.go\":   {\"validateBundleAttestationWith\", \"reviewCriterionEvidenceBlockers\"},\n23\t\t\"review_closeout.go\": {\"evaluateReviewToolCoverageIn\", \"reviewToolEvidenceBlocker\"},\n24\t}\n25\t\n26\t// stated maps a fragment to the words of the current brief that state its rule.\n27\tvar stated = map[string]string{\n28\t\t\"unknown criterion\":              \"every required criterion and every tool above is answered\",\n29\t\t\"duplicate criterion\":            \"every required criterion and every tool above is answered\",\n30\t\t\"missing criterion\":              \"every required criterion and every tool above is answered\",\n31\t\t\"has invalid disposition\":        \"`passed`, `failed`, `not-used` or `deferred`\",\n32\t\t\"lacks not-applicable rationale\": \"a `not-applicable` carries a `rationale`\",\n33\t\t\"is not-applicable while the bundle seals evidence of class\":                                        \"refused when the bundle seals evidence of a class the criterion asks for\",\n34\t\t\"; missing judgment is a pendency, not inapplicability\":                                             \"refused when the bundle seals evidence of a class the criterion asks for\",\n35\t\t\"is disposed as a finding and names none\":                                                           \"disposed `finding` carries as its `evidence` the `id` of a finding\",\n36\t\t\", which this attestation does not record\":                                                          \"the `id` of a finding listed in `findings`\",\n37\t\t\"is a judgment criterion passed with no conclusion; record what was examined and what it concluded\": \"carries a `rationale` saying what you examined and what you concluded\",\n38\t\t\"is passed with no evidence\":                                                                        \"exactly one of the refs listed under Sealed evidence\",\n39\t\t\"cites evidence absent from the sealed bundle:\":                                                     \"exactly one of the refs listed under Sealed evidence\",\n40\t\t\"requires evidence class\":                                                                           \"of a class the criterion asks for\",\n41\t\t\"but cites evidence from\":                                                                           \"of that component\",\n42\t\t\"unknown review tool disposition\":                                                                   \"every required criterion and every tool above is answered\",\n43\t\t\"duplicate review tool disposition\":                                                                 \"every required criterion and every tool above is answered\",\n44\t\t\"has no registered producer and still needs a not-used rationale\":                                   \"`not-used` is accepted for a required tool only when the plan says no producer exists\",\n45\t\t\"lacks not-used rationale\":                                                                          \"a recommended tool you did not run is `not-used` with a `rationale`\",\n46\t\t\"has invalid deferred disposition\":                                                                  \"answer it `deferred` with a `rationale`\",\n47\t\t\"missing required review tool disposition\":                                                          \"every required criterion and every tool above is answered\",\n48\t\t\"has no disposition\":                                                                                \"every required criterion and every tool above is answered\",\n49\t\t\"has no evidence\":                                                                                   \"`command:` followed by the command you ran\",\n50\t\t\"lacks a required evidence class\":                                                                   \"when the tool lists evidence classes, a ref of one of them that the bundle sealed\",\n51\t\t\"cites evidence from\":                                                                               \"of that component\",\n52\t\t\"every required criterion is not-applicable; a scope where the whole plan is inapplicable is not reviewed by it\": \"dispenses with every required criterion as `not-applicable` is refused\",\n53\t}\n54\t\n55\t// exempt names fragments no reviewer's draft can break, and why.\n56\tvar exempt = map[string]string{\n57\t\t\"attestation does not retain the sealed review limitations\": \"engine-written for a run-backed attestation\",\n58\t\t\"attestation does not reference the exact sealed bundle\":    \"engine-written\",\n59\t\t\"attested_at must be RFC3339\":                               \"engine-written\",\n60\t\t\"reviewer execution identity is malformed\":                  \"the identity of the run, not of the draft\",\n61\t\t\"different-actor\": \"a policy value, not a message\",\n62\t\t\"delegated-review requires a signed run reference; reviewer prefix does not prove independence\": \"the run's proof, written by the engine\",\n63\t\t\"agent:independent-\": \"a prefix constant, not a message\",\n64\t\t\"review policy requires a different-actor reviewer identity; under declared assurance that is read from the reviewer prefix, not authenticated\": \"the identity of the run\",\n65\t\t\"mandatory-human\":                       \"a policy value, not a message\",\n66\t\t\"review policy requires human approval\": \"a policy refusal of a delegated run altogether\",\n67\t\t\"explicit-judgment\":                     \"a contract name, not a message\",\n68\t\t\"structural-causality\":                  \"a contract name, not a message\",\n69\t\t\"not-applicable\":                        \"a disposition name, not a message\",\n70\t\t\"review-complete\":                       \"a precondition name, not a message\",\n71\t\t\"delivery-target-declared\":              \"a precondition name, not a message\",\n72\t\t\"required review tool\":                  \"the prefix of a message whose rule is stated by its other fragment\",\n73\t\t\"recommended review tool\":               \"the prefix of a message whose rule is stated by its other fragment\",\n74\t}\n75\t\n76\tfunc preflightFragments(t *testing.T) []string {\n77\t\tt.Helper()\n78\t\tseen := map[string]bool{}\n79\t\tfor file, funcs := range preflightFunctions {\n80\t\t\tparsed, err := parser.ParseFile(token.NewFileSet(), file, nil, 0)\n81\t\t\tif err != nil {\n82\t\t\t\tt.Fatal(err)\n83\t\t\t}\n84\t\t\tfor _, decl := range parsed.Decls {\n85\t\t\t\tfn, ok := decl.(*ast.FuncDecl)\n86\t\t\t\tif !ok {\n87\t\t\t\t\tcontinue\n88\t\t\t\t}\n89\t\t\t\tnamed := false\n90\t\t\t\tfor _, name := range funcs {\n91\t\t\t\t\tnamed = named || fn.Name.Name == name\n92\t\t\t\t}\n93\t\t\t\tif !named {\n94\t\t\t\t\tcontinue\n95\t\t\t\t}\n96\t\t\t\tast.Inspect(fn.Body, func(node ast.Node) bool {\n97\t\t\t\t\tif lit, ok := node.(*ast.BasicLit); ok && lit.Kind == token.STRING {\n98\t\t\t\t\t\tif value, err := strconv.Unquote(lit.Value); err == nil && len(strings.TrimSpace(value)) >= 14 {\n99\t\t\t\t\t\t\tseen[strings.TrimSpace(value)] = true\n100\t\t\t\t\t\t}\n101\t\t\t\t\t}\n102\t\t\t\t\treturn true\n103\t\t\t\t})\n104\t\t\t}\n105\t\t}\n106\t\tout := make([]string, 0, len(seen))\n107\t\tfor fragment := range seen {\n108\t\t\tout = append(out, fragment)\n109\t\t}\n110\t\tsort.Strings(out)\n111\t\tif len(out) < 30 {\n112\t\t\tt.Fatalf(\"read only %d message fragments from the preflight: the extraction lost them\", len(out))\n113\t\t}\n114\t\treturn out\n115\t}\n116\t\n117\tfunc TestEveryMessageThePreflightCanRefuseWithIsStatedByTheBriefOrExempt(t *testing.T) {\n118\t\tbrief := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n119\t\tfor _, fragment := range preflightFragments(t) {\n120\t\t\tif phrase, ok := stated[fragment]; ok {\n121\t\t\t\tif !strings.Contains(brief, phrase) {\n122\t\t\t\t\tt.Errorf(\"the brief does not state the rule behind %q (%q)\", fragment, phrase)\n123\t\t\t\t}\n124\t\t\t\tcontinue\n125\t\t\t}\n126\t\t\tif _, ok := exempt[fragment]; ok {\n127\t\t\t\tcontinue\n128\t\t\t}\n129\t\t\tt.Errorf(\"the preflight can refuse a conclusion with %q and neither the brief states the rule nor is it exempt: add the sentence to the brief (a new template version) or record why a reviewer cannot break it\", fragment)\n130\t\t}\n131\t\tfor fragment := range stated {\n132\t\t\tfound := false\n133\t\t\tfor _, seen := range preflightFragments(t) {\n134\t\t\t\tfound = found || seen == fragment\n135\t\t\t}\n136\t\t\tif !found {\n137\t\t\t\tt.Errorf(\"the table names %q, which the preflight no longer raises: remove it\", fragment)\n138\t\t\t}\n139\t\t}\n140\t}\n141\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"2f1527d0-ce64-4371-9953-c1dd92f1a3f4","timestamp":"2026-11-09T15:29:33.552Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-1739780139/worktree/pose-mcp/internal/pose/review_brief_preflight_tie_test.go","content":"package pose\n\nimport (\n\t\"go/ast\"\n\t\"go/parser\"\n\t\"go/token\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// Spec pose-review-brief-states-the-conclusion-rules R2.\n//\n// The messages the preflight can refuse a conclusion with are read from the source of the\n// functions that raise them. Each fragment either names the sentence of the brief that states\n// its rule, or is exempt with the reason a reviewer cannot break it. A fragment that is in\n// neither fails the build: a blocker added to the preflight cannot ship without the brief\n// saying so, or without someone writing down why it need not.\n\nvar preflightFunctions = map[string][]string{\n\t\"review_bundle.go\":   {\"validateBundleAttestationWith\", \"reviewCriterionEvidenceBlockers\"},\n\t\"review_closeout.go\": {\"evaluateReviewToolCoverageIn\", \"reviewToolEvidenceBlocker\"},\n}\n\n// stated maps a fragment to the words of the current brief that state its rule.\nvar stated = map[string]string{\n\t\"unknown criterion\":              \"every required criterion and every tool above is answered\",\n\t\"duplicate criterion\":            \"every required criterion and every tool above is answered\",\n\t\"missing criterion\":              \"every required criterion and every tool above is answered\",\n\t\"has invalid disposition\":        \"`passed`, `failed`, `not-used` or `deferred`\",\n\t\"lacks not-applicable rationale\": \"a `not-applicable` carries a `rationale`\",\n\t\"is not-applicable while the bundle seals evidence of class\":                                        \"refused when the bundle seals evidence of a class the criterion asks for\",\n\t\"; missing judgment is a pendency, not inapplicability\":                                             \"refused when the bundle seals evidence of a class the criterion asks for\",\n\t\"is disposed as a finding and names none\":                                                           \"disposed `finding` carries as its `evidence` the `id` of a finding\",\n\t\", which this attestation does not record\":                                                          \"the `id` of a finding listed in `findings`\",\n\t\"is a judgment criterion passed with no conclusion; record what was examined and what it concluded\": \"carries a `rationale` saying what you examined and what you concluded\",\n\t\"is passed with no evidence\":                                                                        \"exactly one of the refs listed under Sealed evidence\",\n\t\"cites evidence absent from the sealed bundle:\":                                                     \"exactly one of the refs listed under Sealed evidence\",\n\t\"requires evidence class\":                                                                           \"of a class the criterion asks for\",\n\t\"but cites evidence from\":                                                                           \"of that component\",\n\t\"unknown review tool disposition\":                                                                   \"every required criterion and every tool above is answered\",\n\t\"duplicate review tool disposition\":                                                                 \"every required criterion and every tool above is answered\",\n\t\"has no registered producer and still needs a not-used rationale\":                                   \"`not-used` is accepted for a required tool only when the plan says no producer exists\",\n\t\"lacks not-used rationale\":                                                                          \"a recommended tool you did not run is `not-used` with a `rationale`\",\n\t\"has invalid deferred disposition\":                                                                  \"answer it `deferred` with a `rationale`\",\n\t\"missing required review tool disposition\":                                                          \"every required criterion and every tool above is answered\",\n\t\"has no disposition\":                                                                                \"every required criterion and every tool above is answered\",\n\t\"has no evidence\":                                                                                   \"`command:` followed by the command you ran\",\n\t\"lacks a required evidence class\":                                                                   \"when the tool lists evidence classes, a ref of one of them that the bundle sealed\",\n\t\"cites evidence from\":                                                                               \"of that component\",\n\t\"every required criterion is not-applicable; a scope where the whole plan is inapplicable is not reviewed by it\": \"dispenses with every required criterion as `not-applicable` is refused\",\n}\n\n// exempt names fragments no reviewer's draft can break, and why.\nvar exempt = map[string]string{\n\t\"attestation does not retain the sealed review limitations\": \"engine-written for a run-backed attestation\",\n\t\"attestation does not reference the exact sealed bundle\":    \"engine-written\",\n\t\"attested_at must be RFC3339\":                               \"engine-written\",\n\t\"reviewer execution identity is malformed\":                  \"the identity of the run, not of the draft\",\n\t\"different-actor\": \"a policy value, not a message\",\n\t\"delegated-review requires a signed run reference; reviewer prefix does not prove independence\": \"the run's proof, written by the engine\",\n\t\"agent:independent-\": \"a prefix constant, not a message\",\n\t\"review policy requires a different-actor reviewer identity; under declared assurance that is read from the reviewer prefix, not authenticated\": \"the identity of the run\",\n\t\"mandatory-human\":                       \"a policy value, not a message\",\n\t\"review policy requires human approval\": \"a policy refusal of a delegated run altogether\",\n\t\"explicit-judgment\":                     \"a contract name, not a message\",\n\t\"structural-causality\":                  \"a contract name, not a message\",\n\t\"not-applicable\":                        \"a disposition name, not a message\",\n\t\"review-complete\":                       \"a precondition name, not a message\",\n\t\"delivery-target-declared\":              \"a precondition name, not a message\",\n\t\"required review tool\":                  \"the prefix of a message whose rule is stated by its other fragment\",\n\t\"recommended review tool\":               \"the prefix of a message whose rule is stated by its other fragment\",\n}\n\nfunc preflightFragments(t *testing.T) []string {\n\tt.Helper()\n\tseen := map[string]bool{}\n\tfor file, funcs := range preflightFunctions {\n\t\tparsed, err := parser.ParseFile(token.NewFileSet(), file, nil, 0)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tfor _, decl := range parsed.Decls {\n\t\t\tfn, ok := decl.(*ast.FuncDecl)\n\t\t\tif !ok {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tnamed := false\n\t\t\tfor _, name := range funcs {\n\t\t\t\tnamed = named || fn.Name.Name == name\n\t\t\t}\n\t\t\tif !named {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tast.Inspect(fn.Body, func(node ast.Node) bool {\n\t\t\t\tif lit, ok := node.(*ast.BasicLit); ok && lit.Kind == token.STRING {\n\t\t\t\t\tif value, err := strconv.Unquote(lit.Value); err == nil && len(strings.TrimSpace(value)) >= 14 {\n\t\t\t\t\t\tseen[strings.TrimSpace(value)] = true\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\treturn true\n\t\t\t})\n\t\t}\n\t}\n\tout := make([]string, 0, len(seen))\n\tfor fragment := range seen {\n\t\tout = append(out, fragment)\n\t}\n\tsort.Strings(out)\n\tif len(out) < 30 {\n\t\tt.Fatalf(\"read only %d message fragments from the preflight: the extraction lost them\", len(out))\n\t}\n\treturn out\n}\n\nfunc TestEveryMessageThePreflightCanRefuseWithIsStatedByTheBriefOrExempt(t *testing.T) {\n\tbrief := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n\tfor _, fragment := range preflightFragments(t) {\n\t\tif phrase, ok := stated[fragment]; ok {\n\t\t\tif !strings.Contains(brief, phrase) {\n\t\t\t\tt.Errorf(\"the brief does not state the rule behind %q (%q)\", fragment, phrase)\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif _, ok := exempt[fragment]; ok {\n\t\t\tcontinue\n\t\t}\n\t\tt.Errorf(\"the preflight can refuse a conclusion with %q and neither the brief states the rule nor is it exempt: add the sentence to the brief (a new template version) or record why a reviewer cannot break it\", fragment)\n\t}\n\tfor fragment := range stated {\n\t\tfound := false\n\t\tfor _, seen := range preflightFragments(t) {\n\t\t\tfound = found || seen == fragment\n\t\t}\n\t\tif !found {\n\t\t\tt.Errorf(\"the table names %q, which the preflight no longer raises: remove it\", fragment)\n\t\t}\n\t}\n}\n","numLines":141,"startLine":1,"totalLines":141}},"tool_result_meta":[{"id":"toolu_019CsqBVoRTwQLEkNekpVgda","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
