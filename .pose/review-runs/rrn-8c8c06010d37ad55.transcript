{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018aFvYw5EjC657T5mvCEhF4","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t\t\"testing\"\n9\t)\n10\t\n11\t// Spec pose-review-brief-states-the-conclusion-rules.\n12\t\n13\t// R1, R2: every rule the engine enforces on a typed conclusion is stated in the brief\n14\t// that asks for one. The table keys are the blockers the attestation preflight raises\n15\t// (by the words that identify them) and the values are the words the brief must carry,\n16\t// so a rule added to the preflight without a sentence in the brief fails here.\n17\tfunc TestTheBriefStatesEveryRuleThePreflightEnforces(t *testing.T) {\n18\t\tstore, bundle := briefFixture(t)\n19\t\tbrief, err := store.RenderReviewBrief(bundle.BundleID, \"\", \"\")\n20\t\tif err != nil {\n21\t\t\tt.Fatal(err)\n22\t\t}\n23\t\trules := map[string][]string{\n24\t\t\t\"is a judgment criterion passed with no conclusion\":          {\"`passed` criterion of kind judgment carries a `rationale`\"},\n25\t\t\t\"cites evidence absent from the sealed bundle\":               {\"exactly one of the refs listed under Sealed evidence\", \"never a file and line\"},\n26\t\t\t\"is passed with no evidence\":                                 {\"exactly one of the refs listed under Sealed evidence\"},\n27\t\t\t\"is disposed as a finding and names none\":                    {\"disposed `finding` carries as its `evidence` the `id` of a finding\"},\n28\t\t\t\"names finding X, which this attestation does not record\":    {\"the `id` of a finding listed in `findings`\"},\n29\t\t\t\"passes without answering for <structural fact>\":             {\"structural fact listed above is answered by the criterion that asks for structural mapping\", \"`mappings`\"},\n30\t\t\t\"is not-applicable while the bundle seals evidence of class\": {\"refused when the bundle seals evidence of a class the criterion asks for\"},\n31\t\t\t\"missing criterion\":                                          {\"every required criterion and every tool above is answered\"},\n32\t\t\t\"review tool has invalid disposition\":                        {\"`passed`, `failed`, `not-used` or `deferred`, never anything else\"},\n33\t\t\t\"required review tool did not pass\":                          {\"a tool listed as required must be run and `passed`\"},\n34\t\t\t\"required review tool was not used\":                          {\"`not-used` is accepted for a required tool only when the plan says no producer exists\"},\n35\t\t\t\"recommended review tool lacks not-used rationale\":           {\"a recommended tool you did not run is `not-used` with a `rationale`\"},\n36\t\t\t\"finding F is open\":                                          {\"a draft that approves leaves no finding open\", \"a finding without them is open and the approval is refused\"},\n37\t\t\t\"invalid review evidence ref\":                                {\"`command:` followed by the command you ran; a bare command line is refused\"},\n38\t\t\t\"review tool lacks a required evidence class\":                {\"when the tool lists evidence classes, a ref of one of them that the bundle sealed\"},\n39\t\t}\n40\t\tfor blocker, phrases := range rules {\n41\t\t\tfor _, phrase := range phrases {\n42\t\t\t\tif !strings.Contains(brief.Text, phrase) {\n43\t\t\t\t\tt.Errorf(\"the brief does not state the rule behind %q (%q)\", blocker, phrase)\n44\t\t\t\t}\n45\t\t\t}\n46\t\t}\n47\t}\n48\t\n49\t// R3: a run briefed with review-brief/3 still renders as it did, without the rules, so its\n50\t// digest still verifies; the current template is /6.\n51\tfunc TestAnEarlierConclusionBriefStillRendersWithoutTheRules(t *testing.T) {\n52\t\tstore, bundle := briefFixture(t)\n53\t\tcurrent, err := store.RenderReviewBrief(bundle.BundleID, \"\", \"\")\n54\t\tif err != nil {\n55\t\t\tt.Fatal(err)\n56\t\t}\n57\t\tearlier, err := store.renderReviewBriefAs(bundle.BundleID, ReviewBriefKindReview, \"\", reviewBriefTemplateTypedConclusion)\n58\t\tif err != nil {\n59\t\t\tt.Fatal(err)\n60\t\t}\n61\t\tif current.TemplateVersion != \"review-brief/7\" || earlier.TemplateVersion != \"review-brief/3\" {\n62\t\t\tt.Fatalf(\"templates: %s %s\", current.TemplateVersion, earlier.TemplateVersion)\n63\t\t}\n64\t\tif strings.Contains(earlier.Text, \"POSE checks the conclusion before it records it\") {\n65\t\t\tt.Fatal(\"review-brief/3 changed under the runs briefed with it\")\n66\t\t}\n67\t\tif !strings.Contains(earlier.Text, \"the conclusion POSE records as the attestation\") || earlier.Digest == current.Digest {\n68\t\t\tt.Fatal(\"review-brief/3 no longer asks for the conclusion, or has the digest of /4\")\n69\t\t}\n70\t\tif !reviewBriefAsksConclusion(\"review-brief/3\") || !reviewBriefAsksConclusion(\"review-brief/4\") || !reviewBriefAsksConclusion(\"review-brief/5\") || !reviewBriefAsksConclusion(\"review-brief/6\") || !reviewBriefAsksConclusion(\"review-brief/7\") || reviewBriefAsksConclusion(\"review-brief/2\") {\n71\t\t\tt.Fatal(\"the templates that ask for a conclusion are /3 to /7\")\n72\t\t}\n73\t}\n74\t\n75\t// R4: the Claude reviewer profile allows read-only commands in the three commands it is\n76\t// launched with, and nothing that writes.\n77\tfunc TestTheClaudeReviewerProfileAllowsOnlyReadOnlyCommands(t *testing.T) {\n78\t\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"..\", \".pose\", \"policy\", \"delegation.json\"))\n79\t\tif err != nil {\n80\t\t\tt.Skipf(\"no delegation policy at the repository root: %v\", err)\n81\t\t}\n82\t\tvar policy struct {\n83\t\t\tAgents map[string]struct {\n84\t\t\t\tCommands map[string][]string `json:\"commands\"`\n85\t\t\t\tResume   struct {\n86\t\t\t\t\tCommand  []string            `json:\"command\"`\n87\t\t\t\t\tCommands map[string][]string `json:\"commands\"`\n88\t\t\t\t} `json:\"resume\"`\n89\t\t\t} `json:\"agents\"`\n90\t\t}\n91\t\tif err := json.Unmarshal(raw, &policy); err != nil {\n92\t\t\tt.Fatal(err)\n93\t\t}\n94\t\tagent, ok := policy.Agents[\"claude-opus-5-5\"]\n95\t\tif !ok {\n96\t\t\tt.Skip(\"no Claude reviewer profile\")\n97\t\t}\n98\t\tcommands := [][]string{agent.Commands[\"read\"], agent.Resume.Command, agent.Resume.Commands[\"read\"]}\n99\t\t// An allow-list matches a prefix, so a verb that takes a flag that writes a file or runs a program\n100\t\t// (`git log --output`, `go test -exec -c -o`, `go vet -vettool`, `pose lint-spec --json-out`) cannot be\n101\t\t// allowed at all: only verbs without such a flag are.\n102\t\twriters := []string{\"assess\", \"validate\", \"--seal\", \"attest\", \"record\", \"apply\", \"close \", \"start\", \"index\", \"git commit\", \"git push\", \"git add\", \"git checkout\", \"git reset\", \"go build\", \"go install\", \"go test\", \"go vet\", \"git log\", \"git diff\", \"git show\", \"lint-spec\", \"rm \", \"touch\"}\n103\t\tfor i, command := range commands {\n104\t\t\tvar allowed string\n105\t\t\tfor j, arg := range command {\n106\t\t\t\tif arg == \"--allowedTools\" && j+1 < len(command) {\n107\t\t\t\t\tallowed = command[j+1]\n108\t\t\t\t}\n109\t\t\t}\n110\t\t\tif allowed == \"\" {\n111\t\t\t\tt.Fatalf(\"command %d of the Claude reviewer allows no command: it cannot reproduce what it judges\", i)\n112\t\t\t}\n113\t\t\tfor _, want := range []string{\"Bash(git status:*)\", \"Bash(pose artifact-check:*)\", \"Bash(pose surface-check:*)\", \"Bash(pose review-check:*)\", \"Bash(pose closeout-check:*)\"} {\n114\t\t\t\tif !strings.Contains(allowed, want) {\n115\t\t\t\t\tt.Errorf(\"command %d does not allow %s\", i, want)\n116\t\t\t\t}\n117\t\t\t}\n118\t\t\tfor _, verb := range writers {\n119\t\t\t\tif strings.Contains(allowed, verb) {\n120\t\t\t\t\tt.Errorf(\"command %d allows %q, a verb that writes\", i, verb)\n121\t\t\t\t}\n122\t\t\t}\n123\t\t}\n124\t}\n125\t\n126\t// A round after the first tells the reviewer how to name the findings it accounts for: the\n127\t// preflight refuses a draft whose prior_findings use a bare identifier (\"prior finding id F1\n128\t// is not a unique carried identifier\"), and only the brief of a later round can say so.\n129\tfunc TestTheBriefOfALaterRoundStatesTheIdentifiersOfPriorFindings(t *testing.T) {\n130\t\ttext := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 2}, true, nil)\n131\t\tfor _, phrase := range []string{\"the identifier listed under Findings to account for, which carries its round, for example R2-F1, never a bare F1\", \"a finding you report now takes an `id` that no earlier round used\"} {\n132\t\t\tif !strings.Contains(text, phrase) {\n133\t\t\t\tt.Errorf(\"the brief of round 2 does not state the rule behind \\\"prior finding id is not a unique carried identifier\\\": %q\", phrase)\n134\t\t\t}\n135\t\t}\n136\t\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateConclusions, \"\", nil, &ReviewRound{Number: 2}, true, nil)\n137\t\tif strings.Contains(earlier, \"never a bare F1\") {\n138\t\t\tt.Error(\"review-brief/4 changed under its version: the rule belongs to review-brief/5 and later\")\n139\t\t}\n140\t}\n141\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"cbb0261b-fd60-463d-93f0-5c01c1043f4f","timestamp":"2026-11-09T15:29:45.195Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-1739780139/worktree/pose-mcp/internal/pose/review_brief_conclusion_rules_test.go","content":"package pose\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// Spec pose-review-brief-states-the-conclusion-rules.\n\n// R1, R2: every rule the engine enforces on a typed conclusion is stated in the brief\n// that asks for one. The table keys are the blockers the attestation preflight raises\n// (by the words that identify them) and the values are the words the brief must carry,\n// so a rule added to the preflight without a sentence in the brief fails here.\nfunc TestTheBriefStatesEveryRuleThePreflightEnforces(t *testing.T) {\n\tstore, bundle := briefFixture(t)\n\tbrief, err := store.RenderReviewBrief(bundle.BundleID, \"\", \"\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\trules := map[string][]string{\n\t\t\"is a judgment criterion passed with no conclusion\":          {\"`passed` criterion of kind judgment carries a `rationale`\"},\n\t\t\"cites evidence absent from the sealed bundle\":               {\"exactly one of the refs listed under Sealed evidence\", \"never a file and line\"},\n\t\t\"is passed with no evidence\":                                 {\"exactly one of the refs listed under Sealed evidence\"},\n\t\t\"is disposed as a finding and names none\":                    {\"disposed `finding` carries as its `evidence` the `id` of a finding\"},\n\t\t\"names finding X, which this attestation does not record\":    {\"the `id` of a finding listed in `findings`\"},\n\t\t\"passes without answering for <structural fact>\":             {\"structural fact listed above is answered by the criterion that asks for structural mapping\", \"`mappings`\"},\n\t\t\"is not-applicable while the bundle seals evidence of class\": {\"refused when the bundle seals evidence of a class the criterion asks for\"},\n\t\t\"missing criterion\":                                          {\"every required criterion and every tool above is answered\"},\n\t\t\"review tool has invalid disposition\":                        {\"`passed`, `failed`, `not-used` or `deferred`, never anything else\"},\n\t\t\"required review tool did not pass\":                          {\"a tool listed as required must be run and `passed`\"},\n\t\t\"required review tool was not used\":                          {\"`not-used` is accepted for a required tool only when the plan says no producer exists\"},\n\t\t\"recommended review tool lacks not-used rationale\":           {\"a recommended tool you did not run is `not-used` with a `rationale`\"},\n\t\t\"finding F is open\":                                          {\"a draft that approves leaves no finding open\", \"a finding without them is open and the approval is refused\"},\n\t\t\"invalid review evidence ref\":                                {\"`command:` followed by the command you ran; a bare command line is refused\"},\n\t\t\"review tool lacks a required evidence class\":                {\"when the tool lists evidence classes, a ref of one of them that the bundle sealed\"},\n\t}\n\tfor blocker, phrases := range rules {\n\t\tfor _, phrase := range phrases {\n\t\t\tif !strings.Contains(brief.Text, phrase) {\n\t\t\t\tt.Errorf(\"the brief does not state the rule behind %q (%q)\", blocker, phrase)\n\t\t\t}\n\t\t}\n\t}\n}\n\n// R3: a run briefed with review-brief/3 still renders as it did, without the rules, so its\n// digest still verifies; the current template is /6.\nfunc TestAnEarlierConclusionBriefStillRendersWithoutTheRules(t *testing.T) {\n\tstore, bundle := briefFixture(t)\n\tcurrent, err := store.RenderReviewBrief(bundle.BundleID, \"\", \"\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tearlier, err := store.renderReviewBriefAs(bundle.BundleID, ReviewBriefKindReview, \"\", reviewBriefTemplateTypedConclusion)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif current.TemplateVersion != \"review-brief/7\" || earlier.TemplateVersion != \"review-brief/3\" {\n\t\tt.Fatalf(\"templates: %s %s\", current.TemplateVersion, earlier.TemplateVersion)\n\t}\n\tif strings.Contains(earlier.Text, \"POSE checks the conclusion before it records it\") {\n\t\tt.Fatal(\"review-brief/3 changed under the runs briefed with it\")\n\t}\n\tif !strings.Contains(earlier.Text, \"the conclusion POSE records as the attestation\") || earlier.Digest == current.Digest {\n\t\tt.Fatal(\"review-brief/3 no longer asks for the conclusion, or has the digest of /4\")\n\t}\n\tif !reviewBriefAsksConclusion(\"review-brief/3\") || !reviewBriefAsksConclusion(\"review-brief/4\") || !reviewBriefAsksConclusion(\"review-brief/5\") || !reviewBriefAsksConclusion(\"review-brief/6\") || !reviewBriefAsksConclusion(\"review-brief/7\") || reviewBriefAsksConclusion(\"review-brief/2\") {\n\t\tt.Fatal(\"the templates that ask for a conclusion are /3 to /7\")\n\t}\n}\n\n// R4: the Claude reviewer profile allows read-only commands in the three commands it is\n// launched with, and nothing that writes.\nfunc TestTheClaudeReviewerProfileAllowsOnlyReadOnlyCommands(t *testing.T) {\n\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"..\", \".pose\", \"policy\", \"delegation.json\"))\n\tif err != nil {\n\t\tt.Skipf(\"no delegation policy at the repository root: %v\", err)\n\t}\n\tvar policy struct {\n\t\tAgents map[string]struct {\n\t\t\tCommands map[string][]string `json:\"commands\"`\n\t\t\tResume   struct {\n\t\t\t\tCommand  []string            `json:\"command\"`\n\t\t\t\tCommands map[string][]string `json:\"commands\"`\n\t\t\t} `json:\"resume\"`\n\t\t} `json:\"agents\"`\n\t}\n\tif err := json.Unmarshal(raw, &policy); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tagent, ok := policy.Agents[\"claude-opus-5-5\"]\n\tif !ok {\n\t\tt.Skip(\"no Claude reviewer profile\")\n\t}\n\tcommands := [][]string{agent.Commands[\"read\"], agent.Resume.Command, agent.Resume.Commands[\"read\"]}\n\t// An allow-list matches a prefix, so a verb that takes a flag that writes a file or runs a program\n\t// (`git log --output`, `go test -exec -c -o`, `go vet -vettool`, `pose lint-spec --json-out`) cannot be\n\t// allowed at all: only verbs without such a flag are.\n\twriters := []string{\"assess\", \"validate\", \"--seal\", \"attest\", \"record\", \"apply\", \"close \", \"start\", \"index\", \"git commit\", \"git push\", \"git add\", \"git checkout\", \"git reset\", \"go build\", \"go install\", \"go test\", \"go vet\", \"git log\", \"git diff\", \"git show\", \"lint-spec\", \"rm \", \"touch\"}\n\tfor i, command := range commands {\n\t\tvar allowed string\n\t\tfor j, arg := range command {\n\t\t\tif arg == \"--allowedTools\" && j+1 < len(command) {\n\t\t\t\tallowed = command[j+1]\n\t\t\t}\n\t\t}\n\t\tif allowed == \"\" {\n\t\t\tt.Fatalf(\"command %d of the Claude reviewer allows no command: it cannot reproduce what it judges\", i)\n\t\t}\n\t\tfor _, want := range []string{\"Bash(git status:*)\", \"Bash(pose artifact-check:*)\", \"Bash(pose surface-check:*)\", \"Bash(pose review-check:*)\", \"Bash(pose closeout-check:*)\"} {\n\t\t\tif !strings.Contains(allowed, want) {\n\t\t\t\tt.Errorf(\"command %d does not allow %s\", i, want)\n\t\t\t}\n\t\t}\n\t\tfor _, verb := range writers {\n\t\t\tif strings.Contains(allowed, verb) {\n\t\t\t\tt.Errorf(\"command %d allows %q, a verb that writes\", i, verb)\n\t\t\t}\n\t\t}\n\t}\n}\n\n// A round after the first tells the reviewer how to name the findings it accounts for: the\n// preflight refuses a draft whose prior_findings use a bare identifier (\"prior finding id F1\n// is not a unique carried identifier\"), and only the brief of a later round can say so.\nfunc TestTheBriefOfALaterRoundStatesTheIdentifiersOfPriorFindings(t *testing.T) {\n\ttext := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 2}, true, nil)\n\tfor _, phrase := range []string{\"the identifier listed under Findings to account for, which carries its round, for example R2-F1, never a bare F1\", \"a finding you report now takes an `id` that no earlier round used\"} {\n\t\tif !strings.Contains(text, phrase) {\n\t\t\tt.Errorf(\"the brief of round 2 does not state the rule behind \\\"prior finding id is not a unique carried identifier\\\": %q\", phrase)\n\t\t}\n\t}\n\tearlier := renderReviewBriefBody(fixedBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateConclusions, \"\", nil, &ReviewRound{Number: 2}, true, nil)\n\tif strings.Contains(earlier, \"never a bare F1\") {\n\t\tt.Error(\"review-brief/4 changed under its version: the rule belongs to review-brief/5 and later\")\n\t}\n}\n","numLines":141,"startLine":1,"totalLines":141}},"tool_result_meta":[{"id":"toolu_018aFvYw5EjC657T5mvCEhF4","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
