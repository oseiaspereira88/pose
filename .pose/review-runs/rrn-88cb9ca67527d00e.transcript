{"type":"item.completed","item":{"id":"item_100","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux.go | sed -n '1,230p'\nnl -ba pose-mcp/internal/pose/review_reap_linux_test.go | sed -n '1,300p'\nnl -ba pose-mcp/internal/pose/review_shim_linux.go | sed -n '1,130p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Leftover reviewer processes, the fallback of an embedder that does not run\n     6\t// the adapter under the review run shim (review_shim.go), which is the Linux\n     7\t// path of the pose command (spec\n     8\t// pose-review-run-reaps-lingering-reviewer-processes R1, L6): an adapter such as\n     9\t// `codex exec` runs each command in a session of its own, so killing the\n    10\t// adapter's process group misses a command the reviewer left running, and\n    11\t// that command keeps writing into the run's runtime directory while the\n    12\t// cleanup inventory reads it. Every process of the run inherits\n    13\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n    14\t// that entry, ends them and waits for them before the inventory.\n    15\t//\n    16\t// Each process is pinned by a pidfd before it is signalled, and its\n    17\t// environment is read again through the pinned process, so a pid reused by\n    18\t// an unrelated process between the scan and the signal is never killed\n    19\t// (review round 1, N3). A scan that cannot list or read the state of the\n    20\t// processes fails. A process of this user whose environment cannot be read\n    21\t// (one that made itself non-inspectable) cannot be matched: one that already\n    22\t// existed before the adapter started is not the run's and is skipped; any\n    23\t// other may be the run's, so the scan fails and the run stays unconcludable\n    24\t// (review round 2, N2).\n    25\t\n    26\timport (\n    27\t\t\"bytes\"\n    28\t\t\"errors\"\n    29\t\t\"fmt\"\n    30\t\t\"io/fs\"\n    31\t\t\"os\"\n    32\t\t\"path/filepath\"\n    33\t\t\"strconv\"\n    34\t\t\"strings\"\n    35\t\t\"syscall\"\n    36\t\t\"time\"\n    37\t\n    38\t\t\"golang.org/x/sys/unix\"\n    39\t)\n    40\t\n    41\t// reapSealedCheckoutProcesses ends every process whose environment names\n    42\t// worktree as its sealed checkout and returns a description of each. An\n    43\t// error means the run's processes could not be proven ended within the bound.\n    44\tfunc reapSealedCheckoutProcesses(worktree string, baseline map[int]string) ([]string, int, error) {\n    45\t\tif worktree == \"\" {\n    46\t\t\treturn nil, 0, nil\n    47\t\t}\n    48\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n    49\t\tvar reaped []string\n    50\t\tseen := map[int]bool{}\n    51\t\tdeadline := time.Now().Add(reviewReapWait)\n    52\t\tunreadable := 0\n    53\t\tfor {\n    54\t\t\talive, opaque, err := reviewMarkedProcesses(entry)\n    55\t\t\tif err != nil {\n    56\t\t\t\treturn reaped, unreadable, err\n    57\t\t\t}\n    58\t\t\tunreadable = 0\n    59\t\t\tfor pid, start := range opaque {\n    60\t\t\t\tif prior, ok := baseline[pid]; !ok || prior != start {\n    61\t\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"process %d of this user started during the run and cannot be inspected; it may be the run's and was not ended\", pid)\n    62\t\t\t\t}\n    63\t\t\t\tunreadable++\n    64\t\t\t}\n    65\t\t\tfor _, pid := range alive {\n    66\t\t\t\tif !seen[pid] {\n    67\t\t\t\t\tseen[pid] = true\n    68\t\t\t\t\t// Only the pid: the name is the reviewer's to choose and is not\n    69\t\t\t\t\t// recorded (review round 7, N4).\n    70\t\t\t\t\treaped = append(reaped, strconv.Itoa(pid))\n    71\t\t\t\t}\n    72\t\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n    73\t\t\t\t\treturn reaped, unreadable, err\n    74\t\t\t\t}\n    75\t\t\t}\n    76\t\t\tif len(alive) == 0 {\n    77\t\t\t\treturn reaped, unreadable, nil\n    78\t\t\t}\n    79\t\t\tif time.Now().After(deadline) {\n    80\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n    81\t\t\t}\n    82\t\t\ttime.Sleep(50 * time.Millisecond)\n    83\t\t}\n    84\t}\n    85\t\n    86\t// reviewMarkedProcesses lists the live processes whose environment holds\n    87\t// entry, and counts this user's processes whose environment could not be\n    88\t// read. A process that is gone is skipped.\n    89\tfunc reviewMarkedProcesses(entry []byte) ([]int, map[int]string, error) {\n    90\t\tdirs, err := os.ReadDir(\"/proc\")\n    91\t\tif err != nil {\n    92\t\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    93\t\t}\n    94\t\tunreadable := map[int]string{}\n    95\t\tself, uid := os.Getpid(), os.Getuid()\n    96\t\tvar out []int\n    97\t\tfor _, d := range dirs {\n    98\t\t\tpid, err := strconv.Atoi(d.Name())\n    99\t\t\tif err != nil || pid == self {\n   100\t\t\t\tcontinue\n   101\t\t\t}\n   102\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n   103\t\t\tswitch {\n   104\t\t\tcase reviewProcessGoneErr(err):\n   105\t\t\t\tcontinue\n   106\t\t\tcase err != nil:\n   107\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n   108\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n   109\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   110\t\t\t\t\tcontinue\n   111\t\t\t\t}\n   112\t\t\t\tstart, serr := processStartTime(pid)\n   113\t\t\t\tif reviewProcessGoneErr(serr) {\n   114\t\t\t\t\tcontinue\n   115\t\t\t\t}\n   116\t\t\t\tif serr != nil || start == \"\" {\n   117\t\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d start could not be read: %v\", pid, serr)\n   118\t\t\t\t}\n   119\t\t\t\tunreadable[pid] = start\n   120\t\t\t\tcontinue\n   121\t\t\tcase !marked:\n   122\t\t\t\tcontinue\n   123\t\t\t}\n   124\t\t\tzombie, err := reviewProcessZombie(pid)\n   125\t\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n   126\t\t\t\tcontinue\n   127\t\t\t}\n   128\t\t\tif err != nil {\n   129\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n   130\t\t\t}\n   131\t\t\tout = append(out, pid)\n   132\t\t}\n   133\t\treturn out, unreadable, nil\n   134\t}\n   135\t\n   136\t// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n   137\t// after the environment read through that same pinned process still holds\n   138\t// entry.\n   139\tfunc killPinnedMarkedProcess(pid int, entry []byte) error {\n   140\t\tfd, err := unix.PidfdOpen(pid, 0)\n   141\t\tif errors.Is(err, unix.ESRCH) {\n   142\t\t\treturn nil\n   143\t\t}\n   144\t\tif err != nil {\n   145\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   146\t\t}\n   147\t\tdefer unix.Close(fd)\n   148\t\t// The pidfd names one process for its lifetime; if pid was reused before\n   149\t\t// it was opened, the new process does not carry this run's entry.\n   150\t\tmarked, err := reviewProcessMarked(pid, entry)\n   151\t\tif reviewProcessGoneErr(err) || err == nil && !marked {\n   152\t\t\treturn nil\n   153\t\t}\n   154\t\tif err != nil {\n   155\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   156\t\t}\n   157\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   158\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   159\t\t}\n   160\t\treturn nil\n   161\t}\n   162\t\n   163\tfunc reviewProcessMarked(pid int, entry []byte) (bool, error) {\n   164\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   165\t\tif err != nil {\n   166\t\t\treturn false, err\n   167\t\t}\n   168\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n   169\t\t\tif bytes.Equal(kv, entry) {\n   170\t\t\t\treturn true, nil\n   171\t\t\t}\n   172\t\t}\n   173\t\treturn false, nil\n   174\t}\n   175\t\n   176\tfunc reviewProcessOwner(pid int) (int, error) {\n   177\t\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n   178\t\tif err != nil {\n   179\t\t\treturn 0, err\n   180\t\t}\n   181\t\tst, ok := info.Sys().(*syscall.Stat_t)\n   182\t\tif !ok {\n   183\t\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n   184\t\t}\n   185\t\treturn int(st.Uid), nil\n   186\t}\n   187\t\n   188\tfunc reviewProcessGoneErr(err error) bool {\n   189\t\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n   190\t}\n   191\t\n   192\tfunc reviewProcessName(pid int) string {\n   193\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n   194\t\tif err != nil {\n   195\t\t\treturn \"?\"\n   196\t\t}\n   197\t\treturn strings.TrimSpace(string(raw))\n   198\t}\n   199\t\n   200\tfunc reviewProcessZombie(pid int) (bool, error) {\n   201\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n   202\t\tif err != nil {\n   203\t\t\treturn false, err\n   204\t\t}\n   205\t\t// The state follows the parenthesised command name.\n   206\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   207\t\t\treturn raw[i+2] == 'Z', nil\n   208\t\t}\n   209\t\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n   210\t}\n   211\t\n   212\t// reviewOpaqueProcessBaseline records, before the adapter starts, the\n   213\t// processes of this user whose environment cannot be read, by pid and start\n   214\t// time: they cannot be the run's.\n   215\tfunc reviewOpaqueProcessBaseline() map[int]string {\n   216\t\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv + \"=\\x00\"))\n   217\t\treturn opaque\n   218\t}\n     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os\"\n     7\t\t\"os/exec\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strconv\"\n    10\t\t\"strings\"\n    11\t\t\"syscall\"\n    12\t\t\"testing\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\t// Review round 1, N3: a pid that no longer names a process of the run, as\n    17\t// after reuse by an unrelated process, is never signalled.\n    18\tfunc TestAPidThatLostTheRunsEntryIsNotKilled(t *testing.T) {\n    19\t\tother := exec.Command(\"sleep\", \"30\")\n    20\t\tif err := other.Start(); err != nil {\n    21\t\t\tt.Fatal(err)\n    22\t\t}\n    23\t\tfor i := 0; i < 200 && reviewProcessName(other.Process.Pid) != \"sleep\"; i++ {\n    24\t\t\ttime.Sleep(10 * time.Millisecond)\n    25\t\t}\n    26\t\tt.Cleanup(func() { _ = other.Process.Kill(); _ = other.Wait() })\n    27\t\tentry := []byte(SealedCheckoutEnv + \"=/nonexistent/run-checkout\")\n    28\t\tif err := killPinnedMarkedProcess(other.Process.Pid, entry); err != nil {\n    29\t\t\tt.Fatal(err)\n    30\t\t}\n    31\t\ttime.Sleep(100 * time.Millisecond)\n    32\t\tif zombie, err := reviewProcessZombie(other.Process.Pid); err != nil || zombie {\n    33\t\t\tt.Fatalf(\"a process without the run's entry was killed: zombie=%t %v\", zombie, err)\n    34\t\t}\n    35\t\t// The same process carrying the entry is ended.\n    36\t\tmarked := exec.Command(\"sleep\", \"30\")\n    37\t\tmarked.Env = append(marked.Environ(), string(entry))\n    38\t\tif err := marked.Start(); err != nil {\n    39\t\t\tt.Fatal(err)\n    40\t\t}\n    41\t\t// Until exec, /proc shows the parent's environment.\n    42\t\tfor i := 0; i < 200; i++ {\n    43\t\t\tif ok, _ := reviewProcessMarked(marked.Process.Pid, entry); ok {\n    44\t\t\t\tbreak\n    45\t\t\t}\n    46\t\t\ttime.Sleep(10 * time.Millisecond)\n    47\t\t}\n    48\t\tif err := killPinnedMarkedProcess(marked.Process.Pid, entry); err != nil {\n    49\t\t\tt.Fatal(err)\n    50\t\t}\n    51\t\tif err := marked.Wait(); err == nil {\n    52\t\t\tt.Fatal(\"the marked process was not ended\")\n    53\t\t}\n    54\t}\n    55\t\n    56\t// opaqueProcess starts a process of this user whose environment cannot be\n    57\t// read (it makes itself non-dumpable), or skips without python3.\n    58\tfunc opaqueProcess(t *testing.T) *exec.Cmd {\n    59\t\tt.Helper()\n    60\t\tif _, err := exec.LookPath(\"python3\"); err != nil {\n    61\t\t\tt.Skip(\"python3 is not available\")\n    62\t\t}\n    63\t\tcmd := exec.Command(\"python3\", \"-c\", \"import ctypes,time; ctypes.CDLL(None).prctl(4,0,0,0,0); time.sleep(30)\")\n    64\t\tif err := cmd.Start(); err != nil {\n    65\t\t\tt.Fatal(err)\n    66\t\t}\n    67\t\tt.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })\n    68\t\tfor i := 0; i < 300; i++ {\n    69\t\t\tif _, err := reviewProcessMarked(cmd.Process.Pid, []byte(\"x\")); err != nil && !reviewProcessGoneErr(err) {\n    70\t\t\t\treturn cmd\n    71\t\t\t}\n    72\t\t\ttime.Sleep(10 * time.Millisecond)\n    73\t\t}\n    74\t\tt.Skip(\"the process never became non-inspectable\")\n    75\t\treturn nil\n    76\t}\n    77\t\n    78\t// Review round 2, N2: a non-inspectable process that existed before the run\n    79\t// is not the run's; one that started during it may be, and the scan fails\n    80\t// instead of reporting the run's processes ended.\n    81\tfunc TestANonInspectableProcessStartedDuringTheRunFailsTheScan(t *testing.T) {\n    82\t\tbefore := opaqueProcess(t)\n    83\t\tbaseline := reviewOpaqueProcessBaseline()\n    84\t\tif _, ok := baseline[before.Process.Pid]; !ok {\n    85\t\t\tt.Fatalf(\"the baseline misses process %d\", before.Process.Pid)\n    86\t\t}\n    87\t\tif _, opaque, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err != nil || opaque == 0 {\n    88\t\t\tt.Fatalf(\"a process that predates the run failed the scan or was not counted: %d %v\", opaque, err)\n    89\t\t}\n    90\t\tduring := opaqueProcess(t)\n    91\t\tif _, _, err := reapSealedCheckoutProcesses(\"/nonexistent/run-checkout\", baseline); err == nil || !strings.Contains(err.Error(), \"started during the run\") {\n    92\t\t\tt.Fatalf(\"process %d, started during the run, did not fail the scan: %v\", during.Process.Pid, err)\n    93\t\t}\n    94\t}\n    95\t\n    96\t// Review round 6, N2: a descendant that leaves the group, starts its own\n    97\t// session and clears its environment is still ended with the run.\n    98\tfunc TestAnOrphanThatClearedItsEnvironmentIsEnded(t *testing.T) {\n    99\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   100\t\t\tt.Skip(\"setsid is not available\")\n   101\t\t}\n   102\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   103\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   104\t\t\ta.Containment = containmentPolicy()\n   105\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & ` +\n   106\t\t\t\t`i=0; while [ ! -s \"$1\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; printf 'decision: approved\\n'`, \"sh\", pidFile}\n   107\t\t})\n   108\t\traw, err := os.ReadFile(pidFile)\n   109\t\tif err != nil {\n   110\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   111\t\t}\n   112\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   113\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   114\t\tif zombie, err := reviewProcessZombie(pid); err == nil && !zombie {\n   115\t\t\tt.Fatalf(\"the orphan that cleared its environment survived the run (status %s: %s)\", f.run.Status, f.run.Failure)\n   116\t\t}\n   117\t\tif f.run.Status != ReviewRunCompleted || !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), \"(orphaned)\") {\n   118\t\t\tt.Fatalf(\"the run did not complete naming the orphan: %s %s %v\", f.run.Status, f.run.Failure, f.run.Safety.Limitations)\n   119\t\t}\n   120\t\t// Review round 9, N1: the recorded limitation describes the shim, not an\n   121\t\t// environment match.\n   122\t\tif !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), \"the review run shim ends every process left in the run's subtree\") {\n   123\t\t\tt.Fatalf(\"the limitation does not describe the shim: %v\", f.run.Safety.Limitations)\n   124\t\t}\n   125\t\t// Review round 7, N4: the record names the pid, never the process name\n   126\t\t// the reviewer chose.\n   127\t\tfor _, limit := range f.run.Safety.Limitations {\n   128\t\t\tif strings.Contains(limit, \"(orphaned)\") && strings.Contains(limit, \" sh \") {\n   129\t\t\t\tt.Fatalf(\"the recorded limitation carries a process name: %q\", limit)\n   130\t\t\t}\n   131\t\t}\n   132\t\tif !strings.Contains(strings.Join(f.run.Safety.Limitations, \"\\n\"), strconv.Itoa(pid)+\" (orphaned)\") {\n   133\t\t\tt.Fatalf(\"the recorded limitation does not name the pid: %v\", f.run.Safety.Limitations)\n   134\t\t}\n   135\t}\n   136\t\n   137\t// waitGone waits for pid to end (or be a zombie) and reports whether it did.\n   138\tfunc waitGone(pid int, within time.Duration) bool {\n   139\t\tdeadline := time.Now().Add(within)\n   140\t\tfor time.Now().Before(deadline) {\n   141\t\t\tif zombie, err := reviewProcessZombie(pid); err != nil || zombie {\n   142\t\t\t\treturn true\n   143\t\t\t}\n   144\t\t\ttime.Sleep(50 * time.Millisecond)\n   145\t\t}\n   146\t\treturn false\n   147\t}\n   148\t\n   149\t// Review round 8, N2: the shim's report never goes through a path the\n   150\t// reviewer can write, and the reviewer does not inherit the report pipe.\n   151\tfunc TestTheAdapterDoesNotInheritTheShimReport(t *testing.T) {\n   152\t\tfds := filepath.Join(t.TempDir(), \"fds\")\n   153\t\tf := provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   154\t\t\ta.Containment = containmentPolicy()\n   155\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; ls /proc/$$/fd > \"$1\"; env | grep -c POSE_REVIEW_SHIM_REPORT >> \"$1\"; ls \"$TMPDIR\" >> \"$1\"; printf 'decision: approved\\n'`, \"sh\", fds}\n   156\t\t})\n   157\t\traw, err := os.ReadFile(fds)\n   158\t\tif err != nil || f.run.Status != ReviewRunCompleted {\n   159\t\t\tt.Fatalf(\"the probe did not run: %v %s %s\", err, f.run.Status, f.run.Failure)\n   160\t\t}\n   161\t\tlines := strings.Fields(string(raw))\n   162\t\tfor _, l := range lines {\n   163\t\t\tif l == \"3\" || strings.Contains(l, \"shim-report\") {\n   164\t\t\t\tt.Fatalf(\"the adapter sees the shim's report (%q): %s\", l, raw)\n   165\t\t\t}\n   166\t\t}\n   167\t}\n   168\t\n   169\t// Review round 8, N3: a timeout asks the shim to end the run's subtree, so an\n   170\t// orphan that cleared its environment does not outlive it.\n   171\tfunc TestATimeoutEndsTheRunsOrphans(t *testing.T) {\n   172\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   173\t\t\tt.Skip(\"setsid is not available\")\n   174\t\t}\n   175\t\tpidFile := filepath.Join(t.TempDir(), \"orphan.pid\")\n   176\t\t_ = provenanceRunFixture(t, \"fixture-vendor\", \"fixture-model\", func(a *ReviewerAdapter) {\n   177\t\t\ta.Containment = containmentPolicy()\n   178\t\t\ta.Timeout = \"2s\"\n   179\t\t\ta.Command = []string{\"sh\", \"-c\", `cat >/dev/null; setsid env -i /bin/sh -c 'echo $$ > \"$1\"; while :; do sleep 0.05; done' sh \"$1\" </dev/null >/dev/null 2>&1 & sleep 30`, \"sh\", pidFile}\n   180\t\t})\n   181\t\traw, err := os.ReadFile(pidFile)\n   182\t\tif err != nil {\n   183\t\t\tt.Fatalf(\"the orphan never started: %v\", err)\n   184\t\t}\n   185\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   186\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   187\t\tif !waitGone(pid, 2*time.Second) {\n   188\t\t\tt.Fatal(\"an orphan outlived the run's timeout\")\n   189\t\t}\n   190\t}\n   191\t\n   192\t// Review round 8, N4: when the dispatcher ends, the shim ends the run's\n   193\t// subtree instead of leaving the reviewer running behind a dead owner.\n   194\tfunc TestTheShimEndsTheRunWhenItsDispatcherEnds(t *testing.T) {\n   195\t\tif _, err := exec.LookPath(\"setsid\"); err != nil {\n   196\t\t\tt.Skip(\"setsid is not available\")\n   197\t\t}\n   198\t\tself, err := os.Executable()\n   199\t\tif err != nil {\n   200\t\t\tt.Fatal(err)\n   201\t\t}\n   202\t\tdir := t.TempDir()\n   203\t\torphanPid, shimPid := filepath.Join(dir, \"orphan.pid\"), filepath.Join(dir, \"shim.pid\")\n   204\t\tadapter := filepath.Join(dir, \"adapter.sh\")\n   205\t\tif err := os.WriteFile(adapter, []byte(\"#!/bin/sh\\nsetsid env -i /bin/sh -c 'echo $$ > \\\"$1\\\"; while :; do sleep 0.05; done' sh \\\"$1\\\" </dev/null >/dev/null 2>&1 &\\nsleep 30\\n\"), 0o755); err != nil {\n   206\t\t\tt.Fatal(err)\n   207\t\t}\n   208\t\t// A stand-in dispatcher starts the shim and ends once the run is going.\n   209\t\tscript := `export ` + ReviewShimReportEnv + `=$$; \"$1\" ` + ReviewShimArg + ` /bin/sh sh \"$4\" \"$2\" & echo $! > \"$3\"; ` +\n   210\t\t\t`i=0; while [ ! -s \"$2\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; exit 0`\n   211\t\t// No output pipe: waiting for one would wait for the shim that inherits it.\n   212\t\tdispatcher := exec.Command(\"sh\", \"-c\", script, \"sh\", self, orphanPid, shimPid, adapter)\n   213\t\tstarted := time.Now()\n   214\t\tif err := dispatcher.Run(); err != nil {\n   215\t\t\tt.Fatalf(\"the stand-in dispatcher failed: %v\", err)\n   216\t\t}\n   217\t\tif time.Since(started) > 10*time.Second {\n   218\t\t\tt.Fatal(\"the stand-in dispatcher waited for the run\")\n   219\t\t}\n   220\t\traw, err := os.ReadFile(orphanPid)\n   221\t\tif err != nil {\n   222\t\t\tt.Fatalf(\"the run never started: %v\", err)\n   223\t\t}\n   224\t\tpid, _ := strconv.Atoi(strings.TrimSpace(string(raw)))\n   225\t\tt.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })\n   226\t\tif !waitGone(pid, 5*time.Second) {\n   227\t\t\tt.Fatal(\"the run outlived its dispatcher\")\n   228\t\t}\n   229\t}\n   230\t\n   231\t// Review round 11, N2: a child that already ended was not ended by the shim,\n   232\t// and killPinnedChild says so.\n   233\tfunc TestAChildThatAlreadyEndedIsNotReportedEnded(t *testing.T) {\n   234\t\tchild := exec.Command(\"true\")\n   235\t\tif err := child.Start(); err != nil {\n   236\t\t\tt.Fatal(err)\n   237\t\t}\n   238\t\tpid := child.Process.Pid\n   239\t\tfor i := 0; i < 200; i++ {\n   240\t\t\tif zombie, _ := reviewProcessZombie(pid); zombie {\n   241\t\t\t\tbreak\n   242\t\t\t}\n   243\t\t\ttime.Sleep(10 * time.Millisecond)\n   244\t\t}\n   245\t\tdelivered, err := killPinnedChild(pid, os.Getpid())\n   246\t\t_ = child.Wait()\n   247\t\tif err != nil || delivered {\n   248\t\t\tt.Fatalf(\"an ended child was reported as ended by the shim: delivered=%t %v\", delivered, err)\n   249\t\t}\n   250\t\tlive := exec.Command(\"sleep\", \"30\")\n   251\t\tif err := live.Start(); err != nil {\n   252\t\t\tt.Fatal(err)\n   253\t\t}\n   254\t\tdefer func() { _ = live.Process.Kill(); _ = live.Wait() }()\n   255\t\tif delivered, err := killPinnedChild(live.Process.Pid, os.Getpid()); err != nil || !delivered {\n   256\t\t\tt.Fatalf(\"a live child was not ended: delivered=%t %v\", delivered, err)\n   257\t\t}\n   258\t}\n     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"os/signal\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"golang.org/x/sys/unix\"\n    18\t)\n    19\t\n    20\t// RunReviewShim runs args (the adapter's path, then its argv) as the shim's\n    21\t// only child, waits for it or for SIGTERM, ends every process left in the\n    22\t// shim's subtree and returns the adapter's exit status.\n    23\tfunc RunReviewShim(args []string) int {\n    24\t\treport := reviewShimReport{}\n    25\t\tvar reportFile *os.File\n    26\t\tparent := 0\n    27\t\tif value := os.Getenv(ReviewShimReportEnv); value != \"\" {\n    28\t\t\tparent, _ = strconv.Atoi(value)\n    29\t\t\t// The report pipe is the shim's alone: the adapter never inherits it.\n    30\t\t\tsyscall.CloseOnExec(3)\n    31\t\t\treportFile = os.NewFile(3, \"pose-review-shim-report\")\n    32\t\t}\n    33\t\t_ = os.Unsetenv(ReviewShimReportEnv)\n    34\t\twrite := func() {\n    35\t\t\tif reportFile == nil {\n    36\t\t\t\treturn\n    37\t\t\t}\n    38\t\t\traw := boundedReviewShimReport(report)\n    39\t\t\t_, _ = reportFile.Write(raw)\n    40\t\t\t_ = reportFile.Close()\n    41\t\t}\n    42\t\tif len(args) < 2 {\n    43\t\t\treport.Error = \"the review shim was given no adapter\"\n    44\t\t\twrite()\n    45\t\t\treturn 125\n    46\t\t}\n    47\t\tstop := make(chan os.Signal, 1)\n    48\t\tsignal.Notify(stop, syscall.SIGTERM)\n    49\t\t// The dispatcher's death stops the shim the same way as a timeout.\n    50\t\tif err := unix.Prctl(unix.PR_SET_PDEATHSIG, uintptr(syscall.SIGTERM), 0, 0, 0); err != nil {\n    51\t\t\treport.Error = \"the shim could not follow its dispatcher: \" + err.Error()\n    52\t\t\twrite()\n    53\t\t\treturn 125\n    54\t\t}\n    55\t\tif parent != 0 && os.Getppid() != parent {\n    56\t\t\treport.Error = \"the dispatcher ended before the shim started\"\n    57\t\t\twrite()\n    58\t\t\treturn 125\n    59\t\t}\n    60\t\tif err := unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0); err != nil {\n    61\t\t\treport.Error = \"the shim could not become the subreaper of the run: \" + err.Error()\n    62\t\t\twrite()\n    63\t\t\treturn 125\n    64\t\t}\n    65\t\tcmd := &exec.Cmd{Path: args[0], Args: args[1:], Stdin: os.Stdin, Stdout: os.Stdout, Stderr: os.Stderr, Env: os.Environ()}\n    66\t\tif err := cmd.Start(); err != nil {\n    67\t\t\treport.Error = \"the adapter could not run: \" + err.Error()\n    68\t\t\twrite()\n    69\t\t\treturn 127\n    70\t\t}\n    71\t\tdone := make(chan error, 1)\n    72\t\tgo func() { done <- cmd.Wait() }()\n    73\t\tcode, stopped := 0, false\n    74\t\tvar signaled syscall.Signal\n    75\t\tselect {\n    76\t\tcase err := <-done:\n    77\t\t\tvar exit *exec.ExitError\n    78\t\t\tif errors.As(err, &exit) {\n    79\t\t\t\tif status, ok := exit.Sys().(syscall.WaitStatus); ok && status.Signaled() {\n    80\t\t\t\t\tsignaled, code = status.Signal(), 128+int(status.Signal())\n    81\t\t\t\t} else {\n    82\t\t\t\t\tcode = exit.ExitCode()\n    83\t\t\t\t}\n    84\t\t\t} else if err != nil {\n    85\t\t\t\treport.Error = \"the adapter's end could not be read: \" + err.Error()\n    86\t\t\t}\n    87\t\tcase <-stop:\n    88\t\t\tstopped, code = true, 128+int(syscall.SIGTERM)\n    89\t\t}\n    90\t\tended, err := reapShimSubtree()\n    91\t\treport.Ended = ended\n    92\t\tif err != nil && report.Error == \"\" {\n    93\t\t\treport.Error = err.Error()\n    94\t\t}\n    95\t\twrite()\n    96\t\tif stopped {\n    97\t\t\treturn code\n    98\t\t}\n    99\t\t// An adapter ended by a signal is reported as ended by it: the shim ends\n   100\t\t// itself the same way, so the dispatcher reads what it would have read\n   101\t\t// without the shim.\n   102\t\tif signaled != 0 {\n   103\t\t\tsignal.Reset(signaled)\n   104\t\t\t_ = syscall.Kill(os.Getpid(), signaled)\n   105\t\t\ttime.Sleep(time.Second)\n   106\t\t}\n   107\t\treturn code\n   108\t}\n   109\t\n   110\t// stopReviewShim asks a running shim to end its subtree and exit.\n   111\tfunc stopReviewShim(cmd *exec.Cmd) func() error {\n   112\t\treturn func() error { return cmd.Process.Signal(syscall.SIGTERM) }\n   113\t}\n   114\t\n   115\t// reapShimSubtree ends and reaps every child of the shim, including the\n   116\t// orphans its subreaper status adopted, until none is left.\n   117\tfunc reapShimSubtree() ([]string, error) {\n   118\t\tself := os.Getpid()\n   119\t\tvar ended []string\n   120\t\tseen := map[int]bool{}\n   121\t\tdeadline := time.Now().Add(reviewReapWait)\n   122\t\t// A process that cannot be inspected or ended is not a reason to stop:\n   123\t\t// the others are still ended, and the problem is reported at the end\n   124\t\t// (review round 9, N3).\n   125\t\tvar problems []string\n   126\t\tnote := func(err error) {\n   127\t\t\tif len(problems) < 8 {\n   128\t\t\t\tproblems = append(problems, err.Error())\n   129\t\t\t}\n   130\t\t}\n","exit_code":0,"status":"completed"}}
