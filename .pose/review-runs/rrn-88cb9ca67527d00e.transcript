{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux.go | sed -n '85,115p'\nnl -ba pose-mcp/internal/pose/review_dispatch_unix.go | sed -n '45,80p'\nnl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '1125,1155p;1615,1660p'\nnl -ba pose-mcp/internal/pose/review_shim_linux.go | sed -n '125,205p;250,300p'\nnl -ba pose-mcp/internal/pose/review_tree_windows_test.go | sed -n '1,90p'\nnl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '1,260p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_92","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_reap_linux.go | sed -n '85,115p'\nnl -ba pose-mcp/internal/pose/review_dispatch_unix.go | sed -n '45,80p'\nnl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '1125,1155p;1615,1660p'\nnl -ba pose-mcp/internal/pose/review_shim_linux.go | sed -n '125,205p;250,300p'\nnl -ba pose-mcp/internal/pose/review_tree_windows_test.go | sed -n '1,90p'\nnl -ba pose-mcp/internal/pose/delegation_release.go | sed -n '1,260p'\"","aggregated_output":"    85\t\n    86\t// reviewMarkedProcesses lists the live processes whose environment holds\n    87\t// entry, and counts this user's processes whose environment could not be\n    88\t// read. A process that is gone is skipped.\n    89\tfunc reviewMarkedProcesses(entry []byte) ([]int, map[int]string, error) {\n    90\t\tdirs, err := os.ReadDir(\"/proc\")\n    91\t\tif err != nil {\n    92\t\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    93\t\t}\n    94\t\tunreadable := map[int]string{}\n    95\t\tself, uid := os.Getpid(), os.Getuid()\n    96\t\tvar out []int\n    97\t\tfor _, d := range dirs {\n    98\t\t\tpid, err := strconv.Atoi(d.Name())\n    99\t\t\tif err != nil || pid == self {\n   100\t\t\t\tcontinue\n   101\t\t\t}\n   102\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n   103\t\t\tswitch {\n   104\t\t\tcase reviewProcessGoneErr(err):\n   105\t\t\t\tcontinue\n   106\t\t\tcase err != nil:\n   107\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n   108\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n   109\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   110\t\t\t\t\tcontinue\n   111\t\t\t\t}\n   112\t\t\t\tstart, serr := processStartTime(pid)\n   113\t\t\t\tif reviewProcessGoneErr(serr) {\n   114\t\t\t\t\tcontinue\n   115\t\t\t\t}\n    45\t\t\treturn nil, err\n    46\t\t}\n    47\t\treturn os.NewFile(uintptr(fd), path), nil\n    48\t}\n    49\tfunc reviewSetupCommand(ctx context.Context, source *exec.Cmd) *exec.Cmd {\n    50\t\tcmd := exec.CommandContext(ctx, source.Path, source.Args[1:]...)\n    51\t\tcmd.Env = source.Env\n    52\t\tisolateProcessGroup(cmd)\n    53\t\tcmd.WaitDelay = time.Second\n    54\t\treturn cmd\n    55\t}\n    56\t\n    57\t// Verify the covered Linux group after SIGKILL. Zombies have terminated and\n    58\t// cannot hold pipes; reaping is their parent's duty. Other Unix ports currently\n    59\t// report signal delivery only and cannot require verified group termination.\n    60\tfunc verifyReviewProcessGroup(pid int) error {\n    61\t\tif runtime.GOOS != \"linux\" {\n    62\t\t\treturn nil\n    63\t\t}\n    64\t\tdeadline := time.Now().Add(time.Second)\n    65\t\tfor {\n    66\t\t\tentries, err := os.ReadDir(\"/proc\")\n    67\t\t\tif err != nil {\n    68\t\t\t\treturn fmt.Errorf(\"process-group termination could not be observed\")\n    69\t\t\t}\n    70\t\t\tif len(entries) > 100000 {\n    71\t\t\t\treturn fmt.Errorf(\"process inventory exceeds coverage\")\n    72\t\t\t}\n    73\t\t\talive := false\n    74\t\t\tfor _, entry := range entries {\n    75\t\t\t\tif _, err := strconv.Atoi(entry.Name()); err != nil {\n    76\t\t\t\t\tcontinue\n    77\t\t\t\t}\n    78\t\t\t\traw, err := os.ReadFile(\"/proc/\" + entry.Name() + \"/stat\")\n    79\t\t\t\tif processGone(err) {\n    80\t\t\t\t\tcontinue\n  1125\t\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n  1126\t\t\t\t\t// Counted from the total, not from the listed pids (review\n  1127\t\t\t\t\t// round 12, N3).\n  1128\t\t\t\t\tshimMore = more\n  1129\t\t\t\t}\n  1130\t\t\t\tif report.Error != \"\" {\n  1131\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1132\t\t\t\t\t// The shim's own words go into the record, not only the\n  1133\t\t\t\t\t// generic failure (review round 10, N3).\n  1134\t\t\t\t\tif safety != nil {\n  1135\t\t\t\t\t\tsafety.Limitations = append(safety.Limitations, \"the review run shim could not end the whole subtree: \"+report.Error)\n  1136\t\t\t\t\t}\n  1137\t\t\t\t}\n  1138\t\t\t}\n  1139\t\t}\n  1140\t\tif endedCount := len(reaped) + shimMore; endedCount > 0 && safety != nil {\n  1141\t\t\tlisted := strings.Join(reaped, \", \")\n  1142\t\t\tif shimMore > 0 {\n  1143\t\t\t\tlisted += fmt.Sprintf(\" and %d more (orphaned)\", shimMore)\n  1144\t\t\t}\n  1145\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(endedCount)+\" process(es) the run left running: \"+listed)\n  1146\t\t}\n  1147\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1148\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1149\t\t}\n  1150\t\tterminationFailed = terminationErr != nil\n  1151\t\t// The adapter exited and a child it left still held the output when\n  1152\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1153\t\t// the exit status decides (found in review).\n  1154\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1155\t\t\trunErr = nil\n  1615\t\tif err != nil {\n  1616\t\t\treturn ReviewRun{}, err\n  1617\t\t}\n  1618\t\trun.TranscriptPath = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\"))\n  1619\t\tpretty, err := json.MarshalIndent(run, \"\", \"  \")\n  1620\t\tif err != nil {\n  1621\t\t\treturn ReviewRun{}, err\n  1622\t\t}\n  1623\t\tpretty = append(pretty, '\\n')\n  1624\t\tif len(pretty) > reviewLedgerMaxBytes {\n  1625\t\t\treturn ReviewRun{}, fmt.Errorf(\"review run record exceeds %d-byte bound; nothing published\", reviewLedgerMaxBytes)\n  1626\t\t}\n  1627\t\tif len(transcript) > reviewTranscriptMaxBytes {\n  1628\t\t\treturn ReviewRun{}, fmt.Errorf(\"review transcript exceeds %d-byte bound; nothing published\", reviewTranscriptMaxBytes)\n  1629\t\t}\n  1630\t\n  1631\t\twitness := reviewRunWitness{SchemaVersion: 1, RunID: run.RunID, BundleID: run.BundleID, Scope: run.Scope, RecordDigest: digestBytes(pretty), TranscriptDigest: run.TranscriptDigest}\n  1632\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(filepath.Join(reviewRunLedgerDir, run.RunID+\".json\")), witness); err != nil {\n  1633\t\t\treturn ReviewRun{}, err\n  1634\t\t}\n  1635\t\tif run.Safety != nil && int64(len(pretty)+len(transcript)+len(events)) > run.Safety.RetainedBytes {\n  1636\t\t\treturn ReviewRun{}, fmt.Errorf(\"retained run exceeds containment byte budget; attempt remains incomplete\")\n  1637\t\t}\n  1638\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".transcript\"), transcript, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1639\t\t\treturn ReviewRun{}, err\n  1640\t\t}\n  1641\t\tif run.EventsDigest != \"\" {\n  1642\t\t\tif err := publishDelegationEvents(dir, run.RunID, events); err != nil {\n  1643\t\t\t\treturn ReviewRun{}, err\n  1644\t\t\t}\n  1645\t\t}\n  1646\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".json\"), pretty, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1647\t\t\treturn ReviewRun{}, err\n  1648\t\t}\n  1649\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".json\"))\n  1650\t\treturn run, nil\n  1651\t}\n  1652\t\n  1653\tfunc (s Store) dispatchNoLongerGoverns(plan DispatchPlan) string {\n  1654\t\tcurrent, err := s.LoadReviewBundle(plan.Bundle.BundleID)\n  1655\t\tif err != nil {\n  1656\t\t\treturn \"stale: the bundle the run reviewed can no longer be read: \" + err.Error()\n  1657\t\t}\n  1658\t\tif current.BundleDigest != plan.Bundle.BundleDigest {\n  1659\t\t\treturn \"stale: the bundle the run reviewed changed while it ran\"\n  1660\t\t}\n   125\t\tvar problems []string\n   126\t\tnote := func(err error) {\n   127\t\t\tif len(problems) < 8 {\n   128\t\t\t\tproblems = append(problems, err.Error())\n   129\t\t\t}\n   130\t\t}\n   131\t\tfor {\n   132\t\t\tchildren := 0\n   133\t\t\tproblems = problems[:0]\n   134\t\t\t// /proc is read in batches under the deadline, never materialized\n   135\t\t\t// whole (review round 13, N3).\n   136\t\t\tdirs, err := readProcBatched(deadline)\n   137\t\t\tif err != nil {\n   138\t\t\t\tnote(err)\n   139\t\t\t}\n   140\t\t\tfor _, d := range dirs {\n   141\t\t\t\tpid, err := strconv.Atoi(d.Name())\n   142\t\t\t\tif err != nil || pid == self {\n   143\t\t\t\t\tcontinue\n   144\t\t\t\t}\n   145\t\t\t\tst, err := readShimProcStat(pid)\n   146\t\t\t\tif reviewProcessGoneErr(err) {\n   147\t\t\t\t\tcontinue\n   148\t\t\t\t}\n   149\t\t\t\tif err != nil {\n   150\t\t\t\t\t// A process of another user is never the run's: with procfs\n   151\t\t\t\t\t// mounted hidepid it is visible and unreadable (review round 10,\n   152\t\t\t\t\t// N1). Only one of this user is an unknown that may be the run's.\n   153\t\t\t\t\tif owner, oerr := reviewProcessOwner(pid); reviewProcessGoneErr(oerr) || oerr == nil && owner != os.Getuid() {\n   154\t\t\t\t\t\tcontinue\n   155\t\t\t\t\t}\n   156\t\t\t\t\tchildren++\n   157\t\t\t\t\tnote(fmt.Errorf(\"process %d could not be inspected: %w\", pid, err))\n   158\t\t\t\t\tcontinue\n   159\t\t\t\t}\n   160\t\t\t\tif st.ppid != self {\n   161\t\t\t\t\tcontinue\n   162\t\t\t\t}\n   163\t\t\t\tchildren++\n   164\t\t\t\tif !st.zombie {\n   165\t\t\t\t\t// A pid is reported ended only once its signal was delivered\n   166\t\t\t\t\t// (review round 10, N3).\n   167\t\t\t\t\tif delivered, err := killPinnedChild(pid, self); err != nil {\n   168\t\t\t\t\t\tnote(err)\n   169\t\t\t\t\t} else if delivered {\n   170\t\t\t\t\t\tseen[pid] = true\n   171\t\t\t\t\t}\n   172\t\t\t\t}\n   173\t\t\t}\n   174\t\t\tfor {\n   175\t\t\t\tpid, err := unix.Wait4(-1, nil, unix.WNOHANG, nil)\n   176\t\t\t\tif pid <= 0 || err != nil {\n   177\t\t\t\t\tbreak\n   178\t\t\t\t}\n   179\t\t\t\t// A pid is reported ended once it was signalled and reaped\n   180\t\t\t\t// (review round 12, N2).\n   181\t\t\t\tif seen[pid] {\n   182\t\t\t\t\tdelete(seen, pid)\n   183\t\t\t\t\tended = append(ended, strconv.Itoa(pid))\n   184\t\t\t\t}\n   185\t\t\t}\n   186\t\t\tif children == 0 && len(problems) == 0 {\n   187\t\t\t\treturn ended, nil\n   188\t\t\t}\n   189\t\t\tif time.Now().After(deadline) {\n   190\t\t\t\treturn ended, fmt.Errorf(\"%d process(es) of the run could not be ended: %s\", children, strings.Join(problems, \"; \"))\n   191\t\t\t}\n   192\t\t\ttime.Sleep(20 * time.Millisecond)\n   193\t\t}\n   194\t}\n   195\t\n   196\ttype shimProcStat struct {\n   197\t\tppid   int\n   198\t\tzombie bool\n   199\t}\n   200\t\n   201\tfunc readShimProcStat(pid int) (shimProcStat, error) {\n   202\t\traw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n   203\t\tif err != nil {\n   204\t\t\treturn shimProcStat{}, err\n   205\t\t}\n   250\t\n   251\t// parseReviewShimReport reads the report the shim wrote to its pipe.\n   252\tfunc parseReviewShimReport(raw []byte) (reviewShimReport, error) {\n   253\t\tvar r reviewShimReport\n   254\t\tif len(raw) == 0 {\n   255\t\t\treturn r, fmt.Errorf(\"the review shim left no report\")\n   256\t\t}\n   257\t\tif err := json.Unmarshal(raw, &r); err != nil {\n   258\t\t\treturn r, fmt.Errorf(\"the review shim report is unreadable: %w\", err)\n   259\t\t}\n   260\t\treturn r, nil\n   261\t}\n   262\t\n   263\t// readProcBatched lists the numeric entries of /proc in batches, and stops\n   264\t// with an error once deadline passes.\n   265\tfunc readProcBatched(deadline time.Time) ([]os.DirEntry, error) {\n   266\t\tf, err := os.Open(\"/proc\")\n   267\t\tif err != nil {\n   268\t\t\treturn nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n   269\t\t}\n   270\t\tdefer f.Close()\n   271\t\tvar out []os.DirEntry\n   272\t\tfor {\n   273\t\t\tbatch, err := f.ReadDir(512)\n   274\t\t\tfor _, d := range batch {\n   275\t\t\t\tif d.Name()[0] >= '0' && d.Name()[0] <= '9' {\n   276\t\t\t\t\tout = append(out, d)\n   277\t\t\t\t}\n   278\t\t\t}\n   279\t\t\tif err != nil || len(batch) == 0 {\n   280\t\t\t\treturn out, nil\n   281\t\t\t}\n   282\t\t\tif time.Now().After(deadline) {\n   283\t\t\t\treturn out, fmt.Errorf(\"the run's processes could not be listed within the bound\")\n   284\t\t\t}\n   285\t\t}\n   286\t}\n     1\t//go:build windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"os/exec\"\n     7\t\t\"testing\"\n     8\t\t\"time\"\n     9\t)\n    10\t\n    11\t// Spec pose-review-run-reaps-lingering-reviewer-processes, review round 13,\n    12\t// N1: on Windows the reviewer's tree runs in a job object, and releasing it\n    13\t// ends the descendants the reviewer started.\n    14\tfunc TestTheReviewersJobEndsItsDescendants(t *testing.T) {\n    15\t\t// cmd starts ping as a child and waits for it: both must end with the job.\n    16\t\tcmd := exec.Command(\"cmd\", \"/c\", \"ping -n 60 127.0.0.1 >NUL\")\n    17\t\tprepareReviewProcessTree(cmd)\n    18\t\tif err := cmd.Start(); err != nil {\n    19\t\t\tt.Fatal(err)\n    20\t\t}\n    21\t\tif err := attachReviewProcessTree(cmd); err != nil {\n    22\t\t\tt.Fatal(err)\n    23\t\t}\n    24\t\ttime.Sleep(500 * time.Millisecond)\n    25\t\tstarted := time.Now()\n    26\t\tif err := releaseReviewProcessTree(cmd); err != nil {\n    27\t\t\tt.Fatalf(\"the job did not end its processes: %v\", err)\n    28\t\t}\n    29\t\tdone := make(chan error, 1)\n    30\t\tgo func() { done <- cmd.Wait() }()\n    31\t\tselect {\n    32\t\tcase <-done:\n    33\t\tcase <-time.After(10 * time.Second):\n    34\t\t\tt.Fatal(\"the reviewer outlived its job\")\n    35\t\t}\n    36\t\tif time.Since(started) > 10*time.Second {\n    37\t\t\tt.Fatal(\"ending the job took too long\")\n    38\t\t}\n    39\t}\n     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"io\"\n    28\t\t\"os\"\n    29\t\t\"path/filepath\"\n    30\t\t\"strings\"\n    31\t\t\"time\"\n    32\t)\n    33\t\n    34\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    35\t// proven abandoned.\n    36\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    37\t\n    38\t// reviewOrphanReservationAge is how old a reservation without any marker\n    39\t// must be to count as abandoned.\n    40\tconst reviewOrphanReservationAge = 10 * time.Minute\n    41\t\n    42\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    43\t// dispatch ended before recording it, and removes its stalled marker. A\n    44\t// stalled marker whose reservation was never published is only removed; the\n    45\t// returned run is then empty.\n    46\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    47\t\tif !validAttemptFileName(attemptID) {\n    48\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    49\t\t}\n    50\t\tmarkers, _, err := s.ListDelegationActive()\n    51\t\tif err != nil {\n    52\t\t\treturn ReviewRun{}, err\n    53\t\t}\n    54\t\tvar marker *DelegationActiveRun\n    55\t\tfor i := range markers {\n    56\t\t\tif markers[i].AttemptID == attemptID {\n    57\t\t\t\tmarker = &markers[i]\n    58\t\t\t}\n    59\t\t}\n    60\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    61\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    62\t\t}\n    63\t\tdir, err := s.delegationActiveDir(true)\n    64\t\tif err != nil {\n    65\t\t\treturn ReviewRun{}, err\n    66\t\t}\n    67\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    68\t\tif err != nil {\n    69\t\t\treturn ReviewRun{}, err\n    70\t\t}\n    71\t\tdefer lock.Close()\n    72\t\tunlock, err := lockSpecTransferFile(lock)\n    73\t\tif err != nil {\n    74\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    75\t\t}\n    76\t\tdefer unlock()\n    77\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    78\t}\n    79\t\n    80\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    81\t\tvar reserved *DelegatedReviewAttempt\n    82\t\tif marker != nil {\n    83\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    84\t\t\tif err != nil {\n    85\t\t\t\treturn ReviewRun{}, err\n    86\t\t\t}\n    87\t\t\tfor i := range attempts {\n    88\t\t\t\tif attempts[i].AttemptID == attemptID {\n    89\t\t\t\t\treserved = &attempts[i]\n    90\t\t\t\t}\n    91\t\t\t}\n    92\t\t\tif reserved == nil {\n    93\t\t\t\t// The dispatch ended between its marker and its reservation:\n    94\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    95\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    96\t\t\t}\n    97\t\t} else {\n    98\t\t\tif !operatorConfirmed {\n    99\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n   100\t\t\t}\n   101\t\t\torphans, _, err := s.orphanReservations(now)\n   102\t\t\tif err != nil {\n   103\t\t\t\treturn ReviewRun{}, err\n   104\t\t\t}\n   105\t\t\tfor i := range orphans {\n   106\t\t\t\tif orphans[i].AttemptID == attemptID {\n   107\t\t\t\t\treserved = &orphans[i]\n   108\t\t\t\t}\n   109\t\t\t}\n   110\t\t\tif reserved == nil {\n   111\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   112\t\t\t}\n   113\t\t}\n   114\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   115\t\t\t// A release that stopped after the receipt completes by removing\n   116\t\t\t// the stalled marker; with no marker there is nothing to release.\n   117\t\t\tif marker != nil {\n   118\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   119\t\t\t\tif err != nil {\n   120\t\t\t\t\treturn ReviewRun{}, err\n   121\t\t\t\t}\n   122\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   123\t\t\t\tif err != nil {\n   124\t\t\t\t\treturn ReviewRun{}, err\n   125\t\t\t\t}\n   126\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   127\t\t\t}\n   128\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   129\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   130\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   131\t\t}\n   132\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   133\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   134\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   135\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   136\t\tif marker != nil {\n   137\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   138\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   139\t\t} else {\n   140\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   141\t\t}\n   142\t\t// A run the attempt already recorded, by its dispatch or by a release\n   143\t\t// interrupted before the receipt, completes the attempt; no second run\n   144\t\t// is written for it.\n   145\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   146\t\tif err != nil {\n   147\t\t\treturn ReviewRun{}, err\n   148\t\t}\n   149\t\tif !found {\n   150\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   151\t\t\t\treturn ReviewRun{}, err\n   152\t\t\t}\n   153\t\t}\n   154\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   155\t\t\treturn recorded, err\n   156\t\t}\n   157\t\tif marker != nil {\n   158\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   159\t\t}\n   160\t\treturn recorded, nil\n   161\t}\n   162\t\n   163\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   164\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   165\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   166\t\tif err != nil {\n   167\t\t\treturn ReviewRun{}, false, err\n   168\t\t}\n   169\t\tif len(lost) > 0 {\n   170\t\t\t// An unreadable run may be this release's: the history is unknown,\n   171\t\t\t// and the release does not write another (review round 4, N3).\n   172\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   173\t\t}\n   174\t\tvar latest *ReviewRun\n   175\t\tfor i := range runs {\n   176\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   177\t\t\t\tlatest = &runs[i]\n   178\t\t\t}\n   179\t\t}\n   180\t\tif latest == nil {\n   181\t\t\treturn ReviewRun{}, false, nil\n   182\t\t}\n   183\t\treturn *latest, true, nil\n   184\t}\n   185\t\n   186\t// orphanReservations lists the reservations left without a receipt or a\n   187\t// marker, older than reviewOrphanReservationAge, and\n   188\t// says which reservations or receipts it could not read (review round 3, N3).\n   189\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   190\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   191\t\tdirs, dirsTruncated, err := readDirBounded(base, reviewOrphanScanMaxEntries)\n   192\t\tif errors.Is(err, os.ErrNotExist) {\n   193\t\t\treturn nil, nil, nil\n   194\t\t}\n   195\t\tif err != nil {\n   196\t\t\treturn nil, nil, err\n   197\t\t}\n   198\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   199\t\tif err != nil {\n   200\t\t\treturn nil, nil, err\n   201\t\t}\n   202\t\tif len(markerLost) > 0 {\n   203\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   204\t\t\t// have no marker (review round 6, N1).\n   205\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   206\t\t}\n   207\t\tmarked := map[string]bool{}\n   208\t\tfor _, m := range markers {\n   209\t\t\tmarked[m.AttemptID] = true\n   210\t\t}\n   211\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   212\t\tif err != nil {\n   213\t\t\treturn nil, nil, err\n   214\t\t}\n   215\t\tif len(runLost) > 0 {\n   216\t\t\t// Without the whole run history nothing is known to have no run.\n   217\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   218\t\t}\n   219\t\t// A recorded run does not finish an attempt, its receipt does: a\n   220\t\t// reservation whose run was recorded without a receipt still blocks and\n   221\t\t// is released with that run (review round 5, N3).\n   222\t\t_ = runs\n   223\t\tvar out []DelegatedReviewAttempt\n   224\t\tvar lost []string\n   225\t\tbudget := reviewReadBudget(nil)\n   226\t\tfor _, d := range dirs {\n   227\t\t\tif !d.IsDir() {\n   228\t\t\t\tcontinue\n   229\t\t\t}\n   230\t\t\tentries, truncated, err := readDirBounded(filepath.Join(base, d.Name()), reviewOrphanScanMaxEntries)\n   231\t\t\tif err != nil {\n   232\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   233\t\t\t\tcontinue\n   234\t\t\t}\n   235\t\t\tif truncated {\n   236\t\t\t\tlost = append(lost, fmt.Sprintf(\"the reservations in %s exceed %d entries; the rest were not read\", d.Name(), reviewOrphanScanMaxEntries))\n   237\t\t\t}\n   238\t\t\tfor _, e := range entries {\n   239\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   240\t\t\t\t\tcontinue\n   241\t\t\t\t}\n   242\t\t\t\tvar a DelegatedReviewAttempt\n   243\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   248\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   249\t\t\t\t\tcontinue\n   250\t\t\t\t}\n   251\t\t\t\tif marked[a.AttemptID] {\n   252\t\t\t\t\tcontinue\n   253\t\t\t\t}\n   254\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   255\t\t\t\t\tcontinue\n   256\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   257\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   258\t\t\t\t\tcontinue\n   259\t\t\t\t}\n   260\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n","exit_code":0,"status":"completed"}}
