AbandonedAttempt(a.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\npose-mcp/internal/pose/delegation_release_test.go:101:\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\npose-mcp/internal/pose/delegation_release_test.go:154:\t\tt.Fatalf(\"the abandoned attempt is not listed with its cause: %+v %v\", attempts, err)\npose-mcp/internal/pose/delegation_release_test.go:156:\trun, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false)\npose-mcp/internal/pose/delegation_release_test.go:217:\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil {\npose-mcp/internal/pose/delegation_release_test.go:245:\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\npose-mcp/internal/pose/delegation_release_test.go:258:\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err == nil || !strings.Contains(err.Error(), \"in progress\") {\npose-mcp/internal/pose/delegation_release_test.go:264:\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil && strings.Contains(err.Error(), \"in progress\") {\npose-mcp/internal/pose/delegation_release_test.go:290:\tfirst, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\npose-mcp/internal/pose/delegation_release_test.go:307:\tsecond, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\npose-mcp/internal/pose/delegation_release_test.go:337:\tif a, ok := listed[old.AttemptID]; !ok || a.State != DelegationStalled || !strings.Contains(a.Failure, \"pose delegate cancel \"+old.AttemptID+\" --confirm-abandoned\") {\npose-mcp/internal/pose/delegation_release_test.go:341:\t\tt.Fatal(\"a young reservation was listed as abandoned\")\npose-mcp/internal/pose/delegation_release_test.go:343:\tif _, err := s.ReleaseAbandonedAttempt(young.Att