{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_run_provenance.go | sed -n '820,930p'; nl -ba pose-mcp/internal/pose/review_dispatch_windows.go; nl -ba pose-mcp/internal/pose/review_dispatch_unix.go | sed -n '1,100p'\"","aggregated_output":"   820\t\t\tif e := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, continuationPath(parent.RunID, true)), &receipt, &budget); e != nil {\n   821\t\t\t\treturn e\n   822\t\t\t}\n   823\t\t\tif receipt.RunID != current.RunID || receipt.AttemptID != run.AttemptID || receipt.RunDigest != reviewRunCanonicalDigest(current) {\n   824\t\t\t\treturn fmt.Errorf(\"provenance continuation receipt does not bind its endpoint\")\n   825\t\t\t}\n   826\t\t\tcurrent = parent\n   827\t\t}\n   828\t\tif rootReceipt.RunID != current.RunID || rootReceipt.RunDigest != reviewRunCanonicalDigest(current) {\n   829\t\t\treturn fmt.Errorf(\"provenance attempt receipt does not bind the original endpoint\")\n   830\t\t}\n   831\t\treturn nil\n   832\t}\n   833\t\n   834\t// runProvenanceCommand hashes only bytes accepted by the child's stdin pipe.\n   835\t// The configured brief is a separate digest; partial writes never claim full\n   836\t// transmission, and no receipt claims that the vendor actually consumed it.\n   837\tfunc runProvenanceCommand(cmd *exec.Cmd, text string) (digest string, count int64, complete, started bool, runErr error) {\n   838\t\tcmd.Stdin = nil\n   839\t\tstdin, e := cmd.StdinPipe()\n   840\t\tif e != nil {\n   841\t\t\treturn \"\", 0, false, false, e\n   842\t\t}\n   843\t\tif e = cmd.Start(); e != nil {\n   844\t\t\tstdin.Close()\n   845\t\t\treturn \"\", 0, false, false, e\n   846\t\t}\n   847\t\tif e = attachReviewProcessTree(cmd); e != nil {\n   848\t\t\tstdin.Close()\n   849\t\t\t_ = cmd.Wait()\n   850\t\t\treturn \"\", 0, false, true, e\n   851\t\t}\n   852\t\ttype result struct {\n   853\t\t\tdigest string\n   854\t\t\tcount  int64\n   855\t\t\terr    error\n   856\t\t}\n   857\t\tdone := make(chan result, 1)\n   858\t\tgo func() {\n   859\t\t\thash := sha256.New()\n   860\t\t\ttotal := int64(0)\n   861\t\t\twriter := provenanceStdinWriter{write: stdin, record: func(p []byte) { hash.Write(p); total += int64(len(p)) }}\n   862\t\t\t_, copyErr := io.Copy(writer, strings.NewReader(text))\n   863\t\t\tdone <- result{\"sha256:\" + hex.EncodeToString(hash.Sum(nil)), total, briefDeliveryError(copyErr, stdin.Close())}\n   864\t\t}()\n   865\t\trunErr = cmd.Wait()\n   866\t\tinput := <-done\n   867\t\tif runErr == nil && input.err != nil {\n   868\t\t\trunErr = fmt.Errorf(\"review brief delivery incomplete: %w\", input.err)\n   869\t\t}\n   870\t\treturn input.digest, input.count, input.err == nil && input.count == int64(len(text)), true, runErr\n   871\t}\n   872\t\n   873\t// briefDeliveryError judges a delivery by its bytes. Wait closes the pipe once the child has\n   874\t// exited, so a child that finished first leaves Close nothing to do: every byte was accepted.\n   875\tfunc briefDeliveryError(copyErr, closeErr error) error {\n   876\t\tif copyErr != nil {\n   877\t\t\treturn copyErr\n   878\t\t}\n   879\t\tif errors.Is(closeErr, os.ErrClosed) {\n   880\t\t\treturn nil\n   881\t\t}\n   882\t\treturn closeErr\n   883\t}\n   884\t\n   885\ttype provenanceStdinWriter struct {\n   886\t\twrite  io.Writer\n   887\t\trecord func([]byte)\n   888\t}\n   889\t\n   890\tfunc (w provenanceStdinWriter) Write(p []byte) (int, error) {\n   891\t\tn, e := w.write.Write(p)\n   892\t\tif n > 0 {\n   893\t\t\tw.record(p[:n])\n   894\t\t}\n   895\t\treturn n, e\n   896\t}\n   897\t\n   898\tfunc (s Store) runProvenanceProjectBinding(project string) error {\n   899\t\tif _, err := s.fsys().Lstat(filepath.Join(s.Root, \".pose/project.json\")); !os.IsNotExist(err) {\n   900\t\t\tif _, err := dispatchRegularInputPath(s.Root, \".pose/project.json\"); err != nil {\n   901\t\t\t\treturn err\n   902\t\t\t}\n   903\t\t}\n   904\t\tdeclared, found, err := ReadProjectFileIn(s.fsys(), s.Root)\n   905\t\tif err != nil {\n   906\t\t\treturn err\n   907\t\t}\n   908\t\tif found && declared != project {\n   909\t\t\treturn fmt.Errorf(\"run provenance protected authority_project differs from declared project identity\")\n   910\t\t}\n   911\t\treturn nil\n   912\t}\n   913\t\n   914\tfunc resolveProvenanceExecutable(command, worktree string) (string, error) {\n   915\t\t_, hashed, e := provenanceExecutableSelection(command, worktree)\n   916\t\treturn hashed, e\n   917\t}\n   918\t\n   919\t// Keep the exec path's original relative/symlink spelling: kernels use that\n   920\t// spelling as a shebang script's $0. Resolve only the hash observation.\n   921\tfunc provenanceExecutableSelection(command, worktree string) (selected, hashed string, err error) {\n   922\t\tselected = command\n   923\t\tobserved := command\n   924\t\tif !filepath.IsAbs(command) {\n   925\t\t\tif strings.ContainsAny(command, \"/\\\\\") {\n   926\t\t\t\tobserved = filepath.Join(worktree, command)\n   927\t\t\t} else {\n   928\t\t\t\tselected, err = exec.LookPath(command)\n   929\t\t\t\tif err != nil {\n   930\t\t\t\t\treturn \"\", \"\", err\n     1\t//go:build windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"context\"\n     7\t\t\"fmt\"\n     8\t\t\"os\"\n     9\t\t\"os/exec\"\n    10\t)\n    11\t\n    12\t// On Windows the context kills the adapter's process; WaitDelay releases the\n    13\t// pipes its children may still hold.\n    14\tfunc isolateProcessGroup(cmd *exec.Cmd) {}\n    15\t\n    16\tfunc killProcessGroup(cmd *exec.Cmd) error                { return nil }\n    17\tfunc openReviewAdapterFile(path string) (*os.File, error) { return os.Open(path) }\n    18\tfunc reviewSetupCommand(ctx context.Context, source *exec.Cmd) *exec.Cmd {\n    19\t\tcmd := exec.CommandContext(ctx, source.Path, source.Args[1:]...)\n    20\t\tcmd.Env = source.Env\n    21\t\treturn cmd\n    22\t}\n    23\t\n    24\tfunc reviewProcessGroupAvailable() error                              { return fmt.Errorf(\"process-group termination unsupported\") }\n    25\tfunc openReviewRootFile(root *os.Root, path string) (*os.File, error) { return root.Open(path) }\n     1\t//go:build !windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"context\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"runtime\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"sync\"\n    15\t\t\"syscall\"\n    16\t\t\"time\"\n    17\t)\n    18\t\n    19\t// isolateProcessGroup starts the adapter in its own process group, and makes\n    20\t// the context's cancellation kill that whole group.\n    21\tfunc isolateProcessGroup(cmd *exec.Cmd) {\n    22\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n    23\t\tcmd.Cancel = func() error {\n    24\t\t\treturn syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\n    25\t\t}\n    26\t}\n    27\t\n    28\t// killProcessGroup ends whatever the adapter left running.\n    29\tfunc killProcessGroup(cmd *exec.Cmd) error {\n    30\t\tif cmd.Process == nil {\n    31\t\t\treturn nil\n    32\t\t}\n    33\t\terr := syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\n    34\t\tif errors.Is(err, syscall.ESRCH) {\n    35\t\t\treturn nil\n    36\t\t}\n    37\t\tif err != nil {\n    38\t\t\treturn err\n    39\t\t}\n    40\t\treturn verifyReviewProcessGroup(cmd.Process.Pid)\n    41\t}\n    42\tfunc openReviewAdapterFile(path string) (*os.File, error) {\n    43\t\tfd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)\n    44\t\tif err != nil {\n    45\t\t\treturn nil, err\n    46\t\t}\n    47\t\treturn os.NewFile(uintptr(fd), path), nil\n    48\t}\n    49\tfunc reviewSetupCommand(ctx context.Context, source *exec.Cmd) *exec.Cmd {\n    50\t\tcmd := exec.CommandContext(ctx, source.Path, source.Args[1:]...)\n    51\t\tcmd.Env = source.Env\n    52\t\tisolateProcessGroup(cmd)\n    53\t\tcmd.WaitDelay = time.Second\n    54\t\treturn cmd\n    55\t}\n    56\t\n    57\t// Verify the covered Linux group after SIGKILL. Zombies have terminated and\n    58\t// cannot hold pipes; reaping is their parent's duty. Other Unix ports currently\n    59\t// report signal delivery only and cannot require verified group termination.\n    60\tfunc verifyReviewProcessGroup(pid int) error {\n    61\t\tif runtime.GOOS != \"linux\" {\n    62\t\t\treturn nil\n    63\t\t}\n    64\t\tdeadline := time.Now().Add(time.Second)\n    65\t\tfor {\n    66\t\t\tentries, err := os.ReadDir(\"/proc\")\n    67\t\t\tif err != nil {\n    68\t\t\t\treturn fmt.Errorf(\"process-group termination could not be observed\")\n    69\t\t\t}\n    70\t\t\tif len(entries) > 100000 {\n    71\t\t\t\treturn fmt.Errorf(\"process inventory exceeds coverage\")\n    72\t\t\t}\n    73\t\t\talive := false\n    74\t\t\tfor _, entry := range entries {\n    75\t\t\t\tif _, err := strconv.Atoi(entry.Name()); err != nil {\n    76\t\t\t\t\tcontinue\n    77\t\t\t\t}\n    78\t\t\t\traw, err := os.ReadFile(\"/proc/\" + entry.Name() + \"/stat\")\n    79\t\t\t\tif processGone(err) {\n    80\t\t\t\t\tcontinue\n    81\t\t\t\t}\n    82\t\t\t\tif err != nil {\n    83\t\t\t\t\treturn fmt.Errorf(\"process inventory incomplete\")\n    84\t\t\t\t}\n    85\t\t\t\tend := strings.LastIndex(string(raw), \")\")\n    86\t\t\t\tif end < 0 {\n    87\t\t\t\t\treturn fmt.Errorf(\"process inventory malformed\")\n    88\t\t\t\t}\n    89\t\t\t\tfields := strings.Fields(string(raw[end+1:]))\n    90\t\t\t\tif len(fields) < 3 {\n    91\t\t\t\t\treturn fmt.Errorf(\"process inventory malformed\")\n    92\t\t\t\t}\n    93\t\t\t\tgroup, err := strconv.Atoi(fields[2])\n    94\t\t\t\tif err != nil {\n    95\t\t\t\t\treturn fmt.Errorf(\"process group malformed\")\n    96\t\t\t\t}\n    97\t\t\t\tif group == pid && fields[0] != \"Z\" && fields[0] != \"X\" {\n    98\t\t\t\t\talive = true\n    99\t\t\t\t\tbreak\n   100\t\t\t\t}\n","exit_code":0,"status":"completed"}}
