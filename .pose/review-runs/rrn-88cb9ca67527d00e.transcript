 {\n \t\t\tr.Capabilities[\"process-group-termination\"] = \"available\"\n+\t\t\t// A descendant that left the group is still ended while its\n+\t\t\t// environment keeps the run's sealed-checkout entry; one that\n+\t\t\t// clears it is not, so the guarantee is not \"available\" (spec\n+\t\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, L1).\n+\t\t\tr.Capabilities[\"escaped-descendant-termination\"] = \"environment-marked\"\n+\t\t\tfor i, limit := range r.Limitations {\n+\t\t\t\tif limit == \"no memory/CPU quota or control of descendants escaping the process group\" {\n+\t\t\t\t\tr.Limitations[i] = \"no memory/CPU quota; descendants escaping the process group are ended only while they keep the run's sealed-checkout environment entry\"\n+\t\t\t\t}\n+\t\t\t}\n \t\t} else {\n \t\t\tr.Capabilities[\"process-group-termination\"] = \"unavailable\"\n \t\t\tr.Limitations = append(r.Limitations, \"process inventory not observable on this host\")\n \t\t}\n \t} else {\n \t\tr.Limitations = append(r.Limitations, \"process-group termination not qualified on this platform\")\n+\t\tif runtime.GOOS == \"windows\" {\n+\t\t\t// On Windows the adapter runs in a kill-on-close job object that the\n+\t\t\t// dispatch terminates (review round 13, N1).\n+\t\t\tr.Limitations = append(r.Limitations, \"on Windows the adapter's descendants are ended through its job object\")\n+\t\t}\n \t}\n \tp := a.Containment\n \tif p == nil {\ndiff --git a/pose-mcp/internal/pose/review_attempt_ledger.go b/pose-mcp/internal/pose/review_attempt_ledger.go\nindex 31f33c6d..8cd9edb4 100644\n--- a/pose-mcp/internal/pose/review_attempt_ledger.go\n+++ b/pose-mcp/internal/pose/review_attempt_ledger.go\n@@ -354,7 +354,7 @@ func (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (\n \tbudget := reviewReadBudget(budgets)\n \tvar r reviewAttemptReceipt\n \tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n-\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly: %w\", a.AttemptID, err)\n+\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n \t}\n \tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n \t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n@@ -416,7 +416,10 @@ func (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttem\n \t}\n \treturn attempts, count, nil\n }\n-func (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n+\n+// prepareDelegatedReviewAttempt admits and builds the next reservation of\n+// the bundle without publishing it.\n+func (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n \tattempts, _, err := s.reviewAttemptAdmission(plan)\n \tif err != nil {\n \t\treturn DelegatedReviewAttempt{}, err\n@@ -427,11 +430,20 @@ func (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (D\n \t}\n \ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n \ta.AttemptID = attemptIdentity(a)\n+\treturn a, nil\n+}\n+\n+// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n+// marks the attempt active first, so a dispatch that ends after this point\n+// always leaves a marker that turns stalled and that `pose delegate cancel`\n+// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n+// review round 1, N1).\n+func (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n \trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n \tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n-\t\treturn DelegatedReviewAttempt{}, fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n+\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n \t}\n-\treturn a, nil\n+\treturn nil\n }\n func (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n \traw, _ := json.Marshal(run)\n@@ -862,3 +874,13 @@ func (s Store) delegatedReviewInsights(sinceDays int) *DelegatedReviewInsights {\n \tresult.ByAdapter = finish(adapters)\n \treturn result\n }\n+\n+// reserveDelegatedReviewAttempt prepares and publishes a reservation at once,\n+// for callers that hold no active marker.\n+func (s Store) reserveDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n+\ta, err := s.prepareDelegatedReviewAttempt(plan, at)\n+\tif err != nil {\n+\t\treturn DelegatedReviewAttempt{}, err\n+\t}\n+\treturn a, s.publishDelegatedReviewAttempt(a)\n+}\ndiff --git a/pose-mcp/internal/pose/review_brief.go b/pose-mcp/internal/pose/review_brief.go\nindex a4f69b9b..1a037471 100644\n--- a/pose-mcp/internal/pose/review_brief.go\n+++ b/pose-mcp/internal/pose/review_brief.go\n@@ -27,7 +27,7 @@ const (\n )\n \n var reviewBriefTemplates = map[string]string{\n-\tReviewBriefKindReview:       reviewBriefTemplateDraftCheck,\n+\tReviewBriefKindReview:       reviewBriefTemplateFinishCommands,\n \tReviewBriefKindAdjudication: adjudicationBriefTemplateTyped,\n \tReviewBriefKindSmoke:        smokeBriefTemplateTyped,\n }\n@@ -69,6 +69,16 @@ const (\n \t// that checks the draft with `pose review draft-check` before the run ends\n \t// (spec pose-review-readiness-before-seal R4).\n \treviewBriefTemplateDraftCheck = \"review-brief/8\"\n+\t// reviewBriefTemplateEngineTools was the current template: /8 plus the\n+\t// instruction to run the planned `pose` commands with the engine that\n+\t// dispatched the run, since the reviewer's shell may resolve an older\n+\t// installed `pose` that ignores flags such as --no-persist (spec\n+\t// pose-assess-leaves-sealed-checkouts-alone R5).\n+\treviewBriefTemplateEngineTools = \"review-brief/9\"\n+\t// reviewBriefTemplateFinishCommands is the current template: /9 plus the\n+\t// boundary that every command the reviewer starts ends before it does\n+\t// (spec pose-review-run-reaps-lingering-reviewer-processes R3).\n+\treviewBriefTemplateFinishCommands = \"review-brief/10\"\n \t// reviewBriefTemplateConclusions asked for the typed conclusion and stated its rules,\n \t// without the identifiers of the findings of earlier rounds.\n \t// reviewBriefTemplateConclusions (/4) asked for the typed conclusion and stated the rules\n@@ -84,7 +94,17 @@ const (\n // reviewBriefFromAllNotApplicable reports /7 and the templates that keep its\n // text and add to it.\n func reviewBriefFromAllNotApplicable(template string) bool {\n-\treturn template == reviewBriefTemplateAllNotApplicable || template == reviewBriefTemplateDraftCheck\n+\treturn template == reviewBriefTemplateAllNotApplicable || reviewBriefFromDraftCheck(template)\n+}\n+\n+// reviewBriefFromDraftCheck reports /8 and the templates that keep its text.\n+func reviewBriefFromDraftCheck(template string) bool {\n+\treturn template == reviewBriefTemplateDraftCheck || reviewBriefFromEngineTools(template)\n+}\n+\n+// reviewBriefFromEngineTools reports /9 and the templates that keep its text.\n+func reviewBriefFromEngineTools(template string) bool {\n+\treturn template == reviewBriefTemplateEngineTools || template == reviewBriefTemplateFinishCommands\n }\n \n // reviewBriefAsksConclusion reports a template that asks for the typed conclusion.\n@@ -127,7 +147,7 @@ func reviewBriefStatesRules(template string) bool {\n // briefed with before the current one, newest first; a run briefed with one\n // is re-rendered with it to verify and to continue (the brief a run was sent\n // never changes under it).\n-var reviewBriefEarlierTemplates = []string{reviewBriefTemplateAllNotApplicable, reviewBriefTemplateRiskRules, reviewBriefTemplateRoundIDs, reviewBriefTemplateConclusions, reviewBriefTemplateTypedConclusion, reviewBriefTemplateRounds, reviewBriefTemplateFirst}\n+var reviewBriefEarlierTemplates = []string{reviewBriefTemplateEngineTools, reviewBriefTemplateDraftCheck, reviewBriefTemplateAllNotApplicable, reviewBriefTemplateRiskRules, reviewBriefTemplateRoundIDs, reviewBriefTemplateConclusions, reviewBriefTemplateTypedConclusion, reviewBriefTemplateRounds, reviewBriefTemplateFirst}\n \n // briefEarlierTemplates are, per kind, the templates a run may have been\n // briefed with before the current one, newest first.\n@@ -319,6 +339,9 @@ func renderReviewBriefBody(bundle ReviewBundle, kind, template, notes string, sm\n \tline(\"- Do not record an attestation: POSE records the conclusion of a verified run.\")\n \tline(\"- Do not reveal secrets or key material you come across.\")\n \tline(\"- If something you need is missing, say what and stop, rather than assuming it.\")\n+\tif template == reviewBriefTemplateFinishCommands {\n+\t\tline(\"- Let every command you start finish before you end, and do not leave anything running in the background: POSE ends what is left and records it, and a long run left behind costs time you could have used.\")\n+\t}\n \tline(\"\")\n \n \tline(\"## Change\")\n@@ -375,6 +398,10 @@ func renderReviewBriefBody(bundle ReviewBundle, kind, template, notes string, sm\n \tif len(plan.Tools) > 0 {\n \t\tline(\"## Tools the plan requires\")\n \t\tline(\"\")\n+\t\tif reviewBriefFromEngineTools(template) {\n+\t\t\tline(\"Run each `pose` command below as `\\\"$POSE_REVIEW_CLI\\\"` followed by the same arguments: it is the engine that sealed and dispatched this run. The `pose` your shell resolves may be an older installed engine that ignores flags such as `--no-persist` and writes into this sealed checkout, which fails the run.\")\n+\t\t\tline(\"\")\n+\t\t}\n \t\ttools := append([]ReviewPlanTool(nil), plan.Tools...)\n \t\tsort.SliceStable(tools, func(i, j int) bool { return tools[i].ID+tools[i].Component < tools[j].ID+tools[j].Component })\n \t\tfor _, t := range tools {\n@@ -485,7 +512,7 @@ func renderReviewBriefBody(bundle ReviewBundle, kind, template, notes string, sm\n \t\t\tif reviewBriefStatesRules(template) {\n \t\t\t\tline(\"%d. %s\", next+2, briefRulesText(template, bundle))\n \t\t\t}\n-\t\t\tif template == reviewBriefTemplateDraftCheck {\n+\t\t\tif reviewBriefFromDraftCheck(template) {\n \t\t\t\tline(\"%d. Before you finish, check your final message: pipe it to `\\\"$POSE_REVIEW_CLI\\\" review draft-check --draft -`, the engine that dispatched this run (it reads this run's bundle and round, writes nothing and works in a read-only sandbox) and fix every reason it reports. A draft it refuses is refused at conclusion, and the round is spent.\", next+3)\n \t\t\t}\n \t\t}\ndiff --git a/pose-mcp/internal/pose/review_run_provenance.go b/pose-mcp/internal/pose/review_run_provenance.go\nindex 81281275..24fe125f 100644\n--- a/pose-mcp/internal/pose/review_run_provenance.go\n+++ b/pose-mcp/internal/pose/review_run_provenance.go\n@@ -844,6 +844,11 @@ func runProvenanceCommand(cmd *exec.Cmd, text string) (digest string, count int6\n \t\tstdin.Close()\n \t\treturn \"\", 0, false, false, e\n \t}\n+\tif e = attachReviewProcessTree(cmd); e != nil {\n+\t\tstdin.Close()\n+\t\t_ = cmd.Wait()\n+\t\treturn \"\", 0, false, true, e\n+\t}\n \ttype result struct {\n \t\tdigest string\n \t\tcount  int64\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n -C 1 '\"'^'\"\\\\*\\\\*Runs that leave work behind|\"'^'\"\\\\*\\\\*Runs that leave|review run shim|review-brief/10' POSE.md locales/pt-BR/POSE.md pose-mcp/internal/scaffold/dist/POSE.md pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n -C 1 '\"'^'\"\\\\*\\\\*Runs that leave work behind|\"'^'\"\\\\*\\\\*Runs that leave|review run shim|review-brief/10' POSE.md locales/pt-BR/POSE.md pose-mcp/internal/scaffold/dist/POSE.md pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\"","aggregated_output":"pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md-1070-\npose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md:1071:**Conclusões de reviews delegadas.** `pose review conclude <run> [--issuer <nome>] [--apply] [--json]` registra a conclusão de um run de review concluído: a mensagem final do run traz a conclusão tipada no bloco pose-draft — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` como `<classe>:<ref>`, `rationale` e, quando o plano pede mapeamentos estruturais, `mappings`) e `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), que o brief do template `review-brief/10` (o texto que uma versão de template renderiza é congelado por um digest de referência, então mudá-lo exige uma nova versão) pede e para o qual declara as regras que o motor confere antes de registrar (um critério de julgamento aprovado traz uma justificativa, sua evidência é uma ref que o bundle selou, um critério com finding nomeia um finding do draft, fatos estruturais são respondidos como `mappings`; um draft que quebra uma delas é recusado inteiro; uma rodada depois da primeira também nomeia os findings pelos quais responde com os identificadores que o brief lista, com a rodada, nunca um F1 solto) — e o motor assina a prova do run e a atestação com o issuer nativo, `--issuer` ou `conclusions.issuer` em `.pose/policy/delegation.json` (a chave fica fora do projeto), e a registra pelo mesmo writer de domínio e preflight de `pose review attest --run --run-proof --sign`. Um finding de follow-up com `action`, `owner` e `review_by` vira um risco aceito quando sua severidade é uma que a política de review selada aceita (low por padrão); qualquer outro finding fica aberto. Uma conclusão que rejeita também é registrada e bloqueia o escopo até o bundle mudar. Um run que não é uma review concluída, foi substituído, não capturou proveniência, tem limpeza ou registro incompletos, não traz draft válido para sua rodada, ou cujo bundle não governa mais, não registra atestação: seu registro de conclusão, no diretório `review-conclusions` de `.pose`, guarda os motivos. Um run conclui uma vez: um lock que o sistema libera quando o processo termina é mantido da primeira leitura à última escrita, concluí-lo de novo devolve seu registro, e uma reserva deixada por uma conclusão interrompida só é completada pela atestação que ela registrou se essa atestação verificar como a conclusão do run; caso contrário o run é concluído no lugar dela. Quem quer que a assine, uma atestação de um run com brief `review-brief/3` a `/10` declara a conclusão daquele run: critérios, ferramentas ou findings que o draft não declarou são recusados. Com `delegated_review: true` na policy de review e `conclusions.issuer` definido, `pose delegate review` registra a conclusão no momento em que o run termina; caso contrário nada é automático. Um run de adjudicação ou de smoke conclui do mesmo jeito, sob os mesmos checks, lock e recusas, e nunca como aprovação. O brief do template `adjudication-brief/2` lista as questões que a spec do escopo registra — cada decisão `D<n>` e requisito `R<n>` — e o bloco pose-draft responde cada uma em `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); o veredito é registrado como registro de adjudicação da spec no diretório `adjudications` de `.pose`, e o `lint-spec` reprova, e o `close` recusa, uma questão que a adjudicação do bundle atual diz não se sustentar e avisa sobre uma que ela não pôde determinar ou sobre um registro que não verifica. O brief do template `smoke-brief/2` pede `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), uma por delivery target; as observações são registradas como resultados de validação da classe de evidência `smoke`, um check obrigatório por alvo que passa quando foi observado e é evidência só daquele alvo daquela spec, com head, data e proveniência tirados do run e do índice atual, no diretório `results/smoke` de `.pose`, que o `surface-check` lê ao lado do results path, de modo que um delivery profile pode exigir `smoke`. Um veredito que não responde exatamente o que seu brief pediu não registra nada; todo registro é verificado na leitura — a prova do run verifica e ele é o que o draft do run conclui — e um que não verifica não produz nada. Runs com brief `adjudication-brief/1` e `smoke-brief/1` continuam verificando com o próprio template.\npose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md-1072-\n--\npose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md-1074-\npose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md:1075:**Runs que deixam trabalho para trás.** No Linux o envio roda o adaptador sob um shim de run de review, o mesmo executável reentrado, que é o subreaper da subárvore do run: depois que o adaptador termina, num timeout e quando o envio termina, ele encerra e recolhe todo processo que restou nessa subárvore, mesmo um que abriu sessão própria e limpou o ambiente, e relata os pids encerrados por um pipe que o revisor não herda; o envio os lista em `safety.limitations` do run antes do inventário de limpeza. Quem embute o motor sem ativar o shim recorre a encerrar os processos cujo ambiente nomeia o checkout selado do run (`POSE_SEALED_CHECKOUT`); nas outras plataformas Unix só o grupo de processos é encerrado, e no Windows o adaptador roda num job object com encerramento ao fechar, que o envio termina depois do run, num timeout e, pelo limite do job, quando o envio termina. O brief do template `review-brief/10` pede ao revisor que deixe seus comandos terminarem. O envio marca a tentativa como ativa antes de publicar a reserva, então um envio que termina antes de registrar o run sempre deixa uma tentativa parada, que `pose delegate ls` lista com a causa, e `pose delegate cancel <tentativa>` a libera quando o dono está comprovadamente encerrado, registrando um run com falha e o seu recibo; uma liberação roda por vez, sob um lock que o sistema libera junto com quem o detém, e uma liberação conclui com qualquer run que a tentativa já registrou em vez de gravar outro. Uma reserva que um motor anterior deixou sem marcador não registra dono: `pose delegate ls` a lista depois de dez minutos, e `pose delegate cancel <tentativa> --confirm-abandoned` a libera com a confirmação do operador de que nenhum envio dela está rodando.\npose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md-1076-\n--\nlocales/pt-BR/POSE.md-1070-\nlocales/pt-BR/POSE.md:1071:**Conclusões de reviews delegadas.** `pose review conclude <run> [--issuer <nome>] [--apply] [--json]` registra a conclusão de um run de review concluído: a mensagem final do run traz a conclusão tipada no bloco pose-draft — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` como `<classe>:<ref>`, `rationale` e, quando o plano pede mapeamentos estruturais, `mappings`) e `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), que o brief do template `review-brief/10` (o texto que uma versão de template renderiza é congelado por um digest de referência, então mudá-lo exige uma nova versão) pede e para o qual declara as regras que o motor confere antes de registrar (um critério de julgamento aprovado traz uma justificativa, sua evidência é uma ref que o bundle selou, um critério com finding nomeia um finding do draft, fatos estruturais são respondidos como `mappings`; um draft que quebra uma delas é recusado inteiro; uma rodada depois da primeira também nomeia os findings pelos quais responde com os identificadores que o brief lista, com a rodada, nunca um F1 solto) — e o motor assina a prova do run e a atestação com o issuer nativo, `--issuer` ou `conclusions.issuer` em `.pose/policy/delegation.json` (a chave fica fora do projeto), e a registra pelo mesmo writer de domínio e preflight de `pose review attest --run --run-proof --sign`. Um finding de follow-up com `action`, `owner` e `review_by` vira um risco aceito quando sua severidade é uma que a política de review selada aceita (low por padrão); qualquer outro finding fica aberto. Uma conclusão que rejeita também é registrada e bloqueia o escopo até o bundle mudar. Um run que não é uma review concluída, foi substituído, não capturou proveniência, tem limpeza ou registro incompletos, não traz draft válido para sua rodada, ou cujo bundle não governa mais, não registra atestação: seu registro de conclusão, no diretório `review-conclusions` de `.pose`, guarda os motivos. Um run conclui uma vez: um lock que o sistema libera quando o processo termina é mantido da primeira leitura à última escrita, concluí-lo de novo devolve seu registro, e uma reserva deixada por uma conclusão interrompida só é completada pela atestação que ela registrou se essa atestação verificar como a conclusão do run; caso contrário o run é concluído no lugar dela. Quem quer que a assine, uma atestação de um run com brief `review-brief/3` a `/10` declara a conclusão daquele run: critérios, ferramentas ou findings que o draft não declarou são recusados. Com `delegated_review: true` na policy de review e `conclusions.issuer` definido, `pose delegate review` registra a conclusão no momento em que o run termina; caso contrário nada é automático. Um run de adjudicação ou de smoke conclui do mesmo jeito, sob os mesmos checks, lock e recusas, e nunca como aprovação. O brief do template `adjudication-brief/2` lista as questões que a spec do escopo registra — cada decisão `D<n>` e requisito `R<n>` — e o bloco pose-draft responde cada uma em `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); o veredito é registrado como registro de adjudicação da spec no diretório `adjudications` de `.pose`, e o `lint-spec` reprova, e o `close` recusa, uma questão que a adjudicação do bundle atual diz não se sustentar e avisa sobre uma que ela não pôde determinar ou sobre um registro que não verifica. O brief do template `smoke-brief/2` pede `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), uma por delivery target; as observações são registradas como resultados de validação da classe de evidência `smoke`, um check obrigatório por alvo que passa quando foi observado e é evidência só daquele alvo daquela spec, com head, data e proveniência tirados do run e do índice atual, no diretório `results/smoke` de `.pose`, que o `surface-check` lê ao lado do results path, de modo que um delivery profile pode exigir `smoke`. Um veredito que não responde exatamente o que seu brief pediu não registra nada; todo registro é verificado na leitura — a prova do run verifica e ele é o que o draft do run conclui — e um que não verifica não produz nada. Runs com brief `adjudication-brief/1` e `smoke-brief/1` continuam verificando com o próprio template.\nlocales/pt-BR/POSE.md-1072-\n--\nlocales/pt-BR/POSE.md-1074-\nlocales/pt-BR/POSE.md:1075:**Runs que deixam trabalho para trás.** No Linux o envio roda o adaptador sob um shim de run de review, o mesmo executável reentrado, que é o subreaper da subárvore do run: depois que o adaptador termina, num timeout e quando o envio termina, ele encerra e recolhe todo processo que restou nessa subárvore, mesmo um que abriu sessão própria e limpou o ambiente, e relata os pids encerrados por um pipe que o revisor não herda; o envio os lista em `safety.limitations` do run antes do inventário de limpeza. Quem embute o motor sem ativar o shim recorre a encerrar os processos cujo ambiente nomeia o checkout selado do run (`POSE_SEALED_CHECKOUT`); nas outras plataformas Unix só o grupo de processos é encerrado, e no Windows o adaptador roda num job object com encerramento ao fechar, que o envio termina depois do run, num timeout e, pelo limite do job, quando o envio termina. O brief do template `review-brief/10` pede ao revisor que deixe seus comandos terminarem. O envio marca a tentativa como ativa antes de publicar a reserva, então um envio que termina antes de registrar o run sempre deixa uma tentativa parada, que `pose delegate ls` lista com a causa, e `pose delegate cancel <tentativa>` a libera quando o dono está comprovadamente encerrado, registrando um run com falha e o seu recibo; uma liberação roda por vez, sob um lock que o sistema libera junto com quem o detém, e uma liberação conclui com qualquer run que a tentativa já registrou em vez de gravar outro. Uma reserva que um motor anterior deixou sem marcador não registra dono: `pose delegate ls` a lista depois de dez minutos, e `pose delegate cancel <tentativa> --confirm-abandoned` a libera com a confirmação do operador de que nenhum envio dela está rodando.\nlocales/pt-BR/POSE.md-1076-\n--\npose-mcp/internal/scaffold/dist/POSE.md-1060-\npose-mcp/internal/scaffold/dist/POSE.md:1061:**Conclusions of delegated reviews.** `pose review conclude <run> [--issuer <name>] [--apply] [--json]` records the conclusion of a completed review run: the run's final message carries its typed conclusion in the pose-draft block — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>`, `rationale`, and `mappings` where the plan asks for structural mappings) and `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), the brief of template `review-brief/10` (the text a template version renders is frozen by a golden digest, so a change to it takes a new version) asks for them and states the rules the engine checks before it records one (a judgment criterion passed carries a rationale, its evidence is a ref the bundle sealed, a finding criterion names a finding of the draft, structural facts are answered as `mappings`; a draft that breaks one is refused whole; a round after the first also names the findings it accounts for by the identifiers the brief lists, with their round, never a bare F1) — and the engine signs the run's proof and the attestation with the native issuer, `--issuer` or `conclusions.issuer` in `.pose/policy/delegation.json` (the key stays outside the project), and records it through the same domain writer and preflight as `pose review attest --run --run-proof --sign`. A follow-up finding with `action`, `owner` and `review_by` becomes an accepted risk when its severity is one the sealed review policy accepts (low by default); any other finding stays open. A rejecting conclusion is recorded too and blocks the scope until the bundle changes. A run that is not a completed review, is superseded, captured no provenance, has an incomplete cleanup or record, carries no valid draft for its round, or whose bundle no longer governs, records no attestation: its conclusion record, in the `review-conclusions` directory of `.pose`, keeps the reasons. A run concludes once: a lock the system releases when the process ends is held from the first read to the last write, concluding it again returns its record, and a reservation an interrupted conclusion left is completed from the attestation it recorded only if that attestation verifies as the run's conclusion, otherwise the run is concluded in its place. Whoever signs it, an attestation of a run briefed with `review-brief/3` to `/10` states that run's conclusion: criteria, tools or findings its draft did not declare are refused. With review policy `delegated_review: true` and `conclusions.issuer` set, `pose delegate review` records the conclusion the moment the run completes; otherwise nothing is automatic. An adjudication or a smoke run concludes the same way, under the same checks, lock and refusals, and never as an approval. The brief of template `adjudication-brief/2` lists the questions the scope's spec records — each decision `D<n>` and requirement `R<n>` — and the pose-draft block answers each in `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); the verdict is recorded as an adjudication record of the spec in the `adjudications` directory of `.pose`, and `lint-spec` fails, and `close` refuses, on a question the current bundle's adjudication says does not hold and warns on one it cannot determine or on a record that does not verify. The brief of template `smoke-brief/2` asks for `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), one per delivery target; the observations are recorded as validation results of evidence class `smoke`, one required check per target that passes when it was observed and is evidence of that target of that spec only, its head, time and provenance taken from the run and the current index, in the `results/smoke` directory of `.pose`, which `surface-check` reads beside the results path, so a delivery profile may demand `smoke`. A verdict that does not answer exactly what its brief asked records nothing; every record is verified on read — its run's proof verifies and it is what the run's draft concludes — and one that does not yields nothing. Runs briefed with `adjudication-brief/1` and `smoke-brief/1` keep verifying with their template.\npose-mcp/internal/scaffold/dist/POSE.md-1062-\n--\npose-mcp/internal/scaffold/dist/POSE.md-1064-\npose-mcp/internal/scaffold/dist/POSE.md:1065:**Runs that leave work behind.** On Linux the dispatch runs the adapter under a review run shim, the same executable re-entered, which is the subreaper of the run's subtree: after the adapter exits, on a timeout, and when its dispatcher ends, it ends and reaps every process left in that subtree, even one that started its own session and cleared its environment, and reports the ended pids through a pipe the reviewer does not inherit; the dispatch lists them in the run's `safety.limitations` before the cleanup inventory. An embedder that does not enable the shim falls back to ending the processes whose environment names the run's sealed checkout (`POSE_SEALED_CHECKOUT`); on other Unix platforms only the process group is ended, and on Windows the adapter runs in a kill-on-close job object that the dispatch terminates after the run, on a timeout and, through the job's limit, when the dispatcher ends. The brief of template `review-brief/10` asks the reviewer to let its commands finish. The dispatch marks an attempt active before it publishes its reservation, so a dispatch that ends before recording its run always leaves a stalled attempt, which `pose delegate ls` lists with its cause, and `pose delegate cancel <attempt>` releases it once its owner is proven gone, recording a failed run and its receipt; one release runs at a time, under a lock the system releases with its holder, and a release completes with any run the attempt already recorded instead of writing another. A reservation an earlier engine left without a marker records no owner: `pose delegate ls` lists it once it is ten minutes old, and `pose delegate cancel <attempt> --confirm-abandoned` releases it on the operator's confirmation that no dispatch of it runs.\npose-mcp/internal/scaffold/dist/POSE.md-1066-\n--\nPOSE.md-1073-\nPOSE.md:1074:**Conclusions of delegated reviews.** `pose review conclude <run> [--issuer <name>] [--apply] [--json]` records the conclusion of a completed review run: the run's final message carries its typed conclusion in the pose-draft block — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>`, `rationale`, and `mappings` where the plan asks for structural mappings) and `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), the brief of template `review-brief/10` (the text a template version renders is frozen by a golden digest, so a change to it takes a new version) asks for them and states the rules the engine checks before it records one (a judgment criterion passed carries a rationale, its evidence is a ref the bundle sealed, a finding criterion names a finding of the draft, structural facts are answered as `mappings`; a draft that breaks one is refused whole; a round after the first also names the findings it accounts for by the identifiers the brief lists, with their round, never a bare F1) — and the engine signs the run's proof and the attestation with the native issuer, `--issuer` or `conclusions.issuer` in `.pose/policy/delegation.json` (the key stays outside the project), and records it through the same domain writer and preflight as `pose review attest --run --run-proof --sign`. A follow-up finding with `action`, `owner` and `review_by` becomes an accepted risk when its severity is one the sealed review policy accepts (low by default); any other finding stays open. A rejecting conclusion is recorded too and blocks the scope until the bundle changes. A run that is not a completed review, is superseded, captured no provenance, has an incomplete cleanup or record, carries no valid draft for its round, or whose bundle no longer governs, records no attestation: its conclusion record, in the `review-conclusions` directory of `.pose`, keeps the reasons. A run concludes once: a lock the system releases when the process ends is held from the first read to the last write, concluding it again returns its record, and a reservation an interrupted conclusion left is completed from the attestation it recorded only if that attestation verifies as the run's conclusion, otherwise the run is concluded in its place. Whoever signs it, an attestation of a run briefed with `review-brief/3` to `/10` states that run's conclusion: criteria, tools or findings its draft did not declare are refused. With review policy `delegated_review: true` and `conclusions.issuer` set, `pose delegate review` records the conclusion the moment the run completes; otherwise nothing is automatic. An adjudication or a smoke run concludes the same way, under the same checks, lock and refusals, and never as an approval. The brief of template `adjudication-brief/2` lists the questions the scope's spec records — each decision `D<n>` and requirement `R<n>` — and the pose-draft block answers each in `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); the verdict is recorded as an adjudication record of the spec in the `adjudications` directory of `.pose`, and `lint-spec` fails, and `close` refuses, on a question the current bundle's adjudication says does not hold and warns on one it cannot determine or on a record that does not verify. The brief of template `smoke-brief/2` asks for `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), one per delivery target; the observations are recorded as validation results of evidence class `smoke`, one required check per target that passes when it was observed and is evidence of that target of that spec only, its head, time and provenance taken from the run and the current index, in the `results/smoke` directory of `.pose`, which `surface-check` reads beside the results path, so a delivery profile may demand `smoke`. A verdict that does not answer exactly what its brief asked records nothing; every record is verified on read — its run's proof verifies and it is what the run's draft concludes — and one that does not yields nothing. Runs briefed with `adjudication-brief/1` and `smoke-brief/1` keep verifying with their template.\nPOSE.md-1075-\n--\nPOSE.md-1077-\nPOSE.md:1078:**Runs that leave work behind.** On Linux the dispatch runs the adapter under a review run shim, the same executable re-entered, which is the subreaper of the run's subtree: after the adapter exits, on a timeout, and when its dispatcher ends, it ends and reaps every process left in that subtree, even one that started its own session and cleared its environment, and reports the ended pids through a pipe the reviewer does not inherit; the dispatch lists them in the run's `safety.limitations` before the cleanup inventory. An embedder that does not enable the shim falls back to ending the processes whose environment names the run's sealed checkout (`POSE_SEALED_CHECKOUT`); on other Unix platforms only the process group is ended, and on Windows the adapter runs in a kill-on-close job object that the dispatch terminates after the run, on a timeout and, through the job's limit, when the dispatcher ends. The brief of template `review-brief/10` asks the reviewer to let its commands finish. The dispatch marks an attempt active before it publishes its reservation, so a dispatch that ends before recording its run always leaves a stalled attempt, which `pose delegate ls` lists with its cause, and `pose delegate cancel <attempt>` releases it once its owner is proven gone, recording a failed run and its receipt; one release runs at a time, under a lock the system releases with its holder, and a release completes with any run the attempt already recorded instead of writing another. A reservation an earlier engine left without a marker records no owner: `pose delegate ls` lists it once it is ten minutes old, and `pose delegate cancel <attempt> --confirm-abandoned` releases it on the operator's confirmation that no dispatch of it runs.\nPOSE.md-1079-\n","exit_code":0,"status":"completed"}}
