{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/spec_transfer_lock_other.go; cat pose-mcp/internal/pose/spec_transfer_lock_unix.go; cat pose-mcp/internal/pose/spec_transfer_lock_windows.go;'","aggregated_output":"//go:build !unix && !windows\n\npackage pose\n\nimport \"os\"\n\nfunc lockSpecTransferFile(_ *os.File) (func(), error) {\n\treturn nil, errFileLockUnsupported\n}\n//go:build unix\n\npackage pose\n\nimport (\n\t\"os\"\n\n\t\"golang.org/x/sys/unix\"\n)\n\nfunc lockSpecTransferFile(file *os.File) (func(), error) {\n\tif err := unix.Flock(int(file.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {\n\t\treturn nil, err\n\t}\n\treturn func() { _ = unix.Flock(int(file.Fd()), unix.LOCK_UN) }, nil\n}\n//go:build windows\n\npackage pose\n\nimport (\n\t\"os\"\n\n\t\"golang.org/x/sys/windows\"\n)\n\nfunc lockSpecTransferFile(file *os.File) (func(), error) {\n\tvar overlapped windows.Overlapped\n\tflags := uint32(windows.LOCKFILE_EXCLUSIVE_LOCK | windows.LOCKFILE_FAIL_IMMEDIATELY)\n\tif err := windows.LockFileEx(windows.Handle(file.Fd()), flags, 0, 1, 0, &overlapped); err != nil {\n\t\treturn nil, err\n\t}\n\treturn func() { _ = windows.UnlockFileEx(windows.Handle(file.Fd()), 0, 1, 0, &overlapped) }, nil\n}\n","exit_code":0,"status":"completed"}}
