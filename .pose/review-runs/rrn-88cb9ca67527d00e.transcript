{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_tree_windows.go'","aggregated_output":"     1\t//go:build windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Ending the reviewer's process tree on Windows (spec\n     6\t// pose-review-run-reaps-lingering-reviewer-processes R1, review round 13,\n     7\t// N1): the adapter starts suspended, is assigned to a job object that kills\n     8\t// every process in it when the job is terminated or its last handle closes,\n     9\t// and only then resumes, so no descendant can start outside the job. The\n    10\t// dispatch terminates the job after the run, on a timeout, and, through the\n    11\t// kill-on-close limit, when the dispatching process ends.\n    12\t\n    13\timport (\n    14\t\t\"fmt\"\n    15\t\t\"os/exec\"\n    16\t\t\"sync\"\n    17\t\t\"syscall\"\n    18\t\t\"time\"\n    19\t\t\"unsafe\"\n    20\t\n    21\t\t\"golang.org/x/sys/windows\"\n    22\t)\n    23\t\n    24\tvar reviewJobs sync.Map // *exec.Cmd -> windows.Handle\n    25\t\n    26\t// jobBasicAccounting is JOBOBJECT_BASIC_ACCOUNTING_INFORMATION.\n    27\ttype jobBasicAccounting struct {\n    28\t\tTotalUserTime             int64\n    29\t\tTotalKernelTime           int64\n    30\t\tThisPeriodTotalUserTime   int64\n    31\t\tThisPeriodTotalKernelTime int64\n    32\t\tTotalPageFaultCount       uint32\n    33\t\tTotalProcesses            uint32\n    34\t\tActiveProcesses           uint32\n    35\t\tTotalTerminatedProcesses  uint32\n    36\t}\n    37\t\n    38\t// prepareReviewProcessTree makes cmd start suspended, so it can be placed in\n    39\t// its job before it runs.\n    40\tfunc prepareReviewProcessTree(cmd *exec.Cmd) {\n    41\t\tif cmd.SysProcAttr == nil {\n    42\t\t\tcmd.SysProcAttr = &syscall.SysProcAttr{}\n    43\t\t}\n    44\t\tcmd.SysProcAttr.CreationFlags |= windows.CREATE_SUSPENDED\n    45\t\tcmd.Cancel = func() error { return terminateReviewJob(cmd) }\n    46\t}\n    47\t\n    48\t// attachReviewProcessTree places the started, suspended process in a new\n    49\t// kill-on-close job and resumes it. A process that cannot be placed is\n    50\t// terminated: it never runs outside the job.\n    51\tfunc attachReviewProcessTree(cmd *exec.Cmd) error {\n    52\t\tjob, err := windows.CreateJobObject(nil, nil)\n    53\t\tif err != nil {\n    54\t\t\t_ = cmd.Process.Kill()\n    55\t\t\treturn fmt.Errorf(\"the reviewer's job object could not be created: %w\", err)\n    56\t\t}\n    57\t\tinfo := windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION{}\n    58\t\tinfo.BasicLimitInformation.LimitFlags = windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE\n    59\t\tif _, err := windows.SetInformationJobObject(job, windows.JobObjectExtendedLimitInformation, uintptr(unsafe.Pointer(&info)), uint32(unsafe.Sizeof(info))); err != nil {\n    60\t\t\t_ = windows.CloseHandle(job)\n    61\t\t\t_ = cmd.Process.Kill()\n    62\t\t\treturn fmt.Errorf(\"the reviewer's job object could not be limited: %w\", err)\n    63\t\t}\n    64\t\tprocess, err := windows.OpenProcess(windows.PROCESS_SET_QUOTA|windows.PROCESS_TERMINATE, false, uint32(cmd.Process.Pid))\n    65\t\tif err != nil {\n    66\t\t\t_ = windows.CloseHandle(job)\n    67\t\t\t_ = cmd.Process.Kill()\n    68\t\t\treturn fmt.Errorf(\"the reviewer's process could not be opened: %w\", err)\n    69\t\t}\n    70\t\tdefer windows.CloseHandle(process)\n    71\t\tif err := windows.AssignProcessToJobObject(job, process); err != nil {\n    72\t\t\t_ = windows.CloseHandle(job)\n    73\t\t\t_ = cmd.Process.Kill()\n    74\t\t\treturn fmt.Errorf(\"the reviewer's process could not join its job: %w\", err)\n    75\t\t}\n    76\t\treviewJobs.Store(cmd, job)\n    77\t\tif err := resumeProcessThreads(uint32(cmd.Process.Pid)); err != nil {\n    78\t\t\t_ = terminateReviewJob(cmd)\n    79\t\t\treturn fmt.Errorf(\"the reviewer's process could not be resumed: %w\", err)\n    80\t\t}\n    81\t\treturn nil\n    82\t}\n    83\t\n    84\t// resumeProcessThreads resumes every thread of pid; a suspended process has\n    85\t// only its main thread.\n    86\tfunc resumeProcessThreads(pid uint32) error {\n    87\t\tsnapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPTHREAD, 0)\n    88\t\tif err != nil {\n    89\t\t\treturn err\n    90\t\t}\n    91\t\tdefer windows.CloseHandle(snapshot)\n    92\t\tentry := windows.ThreadEntry32{Size: uint32(unsafe.Sizeof(windows.ThreadEntry32{}))}\n    93\t\tresumed := 0\n    94\t\tfor err = windows.Thread32First(snapshot, &entry); err == nil; err = windows.Thread32Next(snapshot, &entry) {\n    95\t\t\tif entry.OwnerProcessID != pid {\n    96\t\t\t\tcontinue\n    97\t\t\t}\n    98\t\t\tthread, err := windows.OpenThread(windows.THREAD_SUSPEND_RESUME, false, entry.ThreadID)\n    99\t\t\tif err != nil {\n   100\t\t\t\treturn err\n   101\t\t\t}\n   102\t\t\t_, rerr := windows.ResumeThread(thread)\n   103\t\t\t_ = windows.CloseHandle(thread)\n   104\t\t\tif rerr != nil {\n   105\t\t\t\treturn rerr\n   106\t\t\t}\n   107\t\t\tresumed++\n   108\t\t}\n   109\t\tif resumed == 0 {\n   110\t\t\treturn fmt.Errorf(\"no thread of process %d was found\", pid)\n   111\t\t}\n   112\t\treturn nil\n   113\t}\n   114\t\n   115\t// terminateReviewJob ends every process of cmd's job and waits until the job\n   116\t// is empty.\n   117\tfunc terminateReviewJob(cmd *exec.Cmd) error {\n   118\t\tvalue, ok := reviewJobs.Load(cmd)\n   119\t\tif !ok {\n   120\t\t\tif cmd.Process != nil {\n   121\t\t\t\treturn cmd.Process.Kill()\n   122\t\t\t}\n   123\t\t\treturn nil\n   124\t\t}\n   125\t\tjob := value.(windows.Handle)\n   126\t\tif err := windows.TerminateJobObject(job, 1); err != nil {\n   127\t\t\treturn fmt.Errorf(\"the reviewer's job could not be terminated: %w\", err)\n   128\t\t}\n   129\t\tdeadline := time.Now().Add(reviewReapWait)\n   130\t\tfor {\n   131\t\t\tvar acct jobBasicAccounting\n   132\t\t\tif err := windows.QueryInformationJobObject(job, windows.JobObjectBasicAccountingInformation, uintptr(unsafe.Pointer(&acct)), uint32(unsafe.Sizeof(acct)), nil); err != nil {\n   133\t\t\t\treturn fmt.Errorf(\"the reviewer's job could not be inspected: %w\", err)\n   134\t\t\t}\n   135\t\t\tif acct.ActiveProcesses == 0 {\n   136\t\t\t\treturn nil\n   137\t\t\t}\n   138\t\t\tif time.Now().After(deadline) {\n   139\t\t\t\treturn fmt.Errorf(\"%d process(es) of the reviewer's job could not be ended\", acct.ActiveProcesses)\n   140\t\t\t}\n   141\t\t\ttime.Sleep(20 * time.Millisecond)\n   142\t\t}\n   143\t}\n   144\t\n   145\t// releaseReviewProcessTree terminates the job and closes its handle.\n   146\tfunc releaseReviewProcessTree(cmd *exec.Cmd) error {\n   147\t\terr := terminateReviewJob(cmd)\n   148\t\tif value, ok := reviewJobs.LoadAndDelete(cmd); ok {\n   149\t\t\t_ = windows.CloseHandle(value.(windows.Handle))\n   150\t\t}\n   151\t\treturn err\n   152\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_shim_linux.go | sed -n '196,310p'\"","aggregated_output":"   196\ttype shimProcStat struct {\n   197\t\tppid   int\n   198\t\tzombie bool\n   199\t}\n   200\t\n   201\tfunc readShimProcStat(pid int) (shimProcStat, error) {\n   202\t\traw, err := os.ReadFile(\"/proc/\" + strconv.Itoa(pid) + \"/stat\")\n   203\t\tif err != nil {\n   204\t\t\treturn shimProcStat{}, err\n   205\t\t}\n   206\t\ttext := string(raw)\n   207\t\tend := strings.LastIndexByte(text, ')')\n   208\t\tif end < 0 {\n   209\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   210\t\t}\n   211\t\tf := strings.Fields(text[end+1:])\n   212\t\tif len(f) < 2 {\n   213\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   214\t\t}\n   215\t\tppid, err := strconv.Atoi(f[1])\n   216\t\tif err != nil {\n   217\t\t\treturn shimProcStat{}, fmt.Errorf(\"process %d stat is unreadable\", pid)\n   218\t\t}\n   219\t\treturn shimProcStat{ppid: ppid, zombie: f[0] == \"Z\"}, nil\n   220\t}\n   221\t\n   222\t// killPinnedChild signals pid through a pidfd while it is still a child of\n   223\t// parent: a pid reused by an unrelated process is never signalled. It says\n   224\t// whether the signal reached the process; one that already ended was not\n   225\t// ended by the shim and is not reported (review round 11, N2).\n   226\tfunc killPinnedChild(pid, parent int) (bool, error) {\n   227\t\tfd, err := unix.PidfdOpen(pid, 0)\n   228\t\tif errors.Is(err, unix.ESRCH) {\n   229\t\t\treturn false, nil\n   230\t\t}\n   231\t\tif err != nil {\n   232\t\t\treturn false, fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   233\t\t}\n   234\t\tdefer unix.Close(fd)\n   235\t\tst, err := readShimProcStat(pid)\n   236\t\tif reviewProcessGoneErr(err) || err == nil && (st.ppid != parent || st.zombie) {\n   237\t\t\treturn false, nil\n   238\t\t}\n   239\t\tif err != nil {\n   240\t\t\treturn false, fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   241\t\t}\n   242\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil {\n   243\t\t\tif errors.Is(err, unix.ESRCH) {\n   244\t\t\t\treturn false, nil\n   245\t\t\t}\n   246\t\t\treturn false, fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   247\t\t}\n   248\t\treturn true, nil\n   249\t}\n   250\t\n   251\t// parseReviewShimReport reads the report the shim wrote to its pipe.\n   252\tfunc parseReviewShimReport(raw []byte) (reviewShimReport, error) {\n   253\t\tvar r reviewShimReport\n   254\t\tif len(raw) == 0 {\n   255\t\t\treturn r, fmt.Errorf(\"the review shim left no report\")\n   256\t\t}\n   257\t\tif err := json.Unmarshal(raw, &r); err != nil {\n   258\t\t\treturn r, fmt.Errorf(\"the review shim report is unreadable: %w\", err)\n   259\t\t}\n   260\t\treturn r, nil\n   261\t}\n   262\t\n   263\t// readProcBatched lists the numeric entries of /proc in batches, and stops\n   264\t// with an error once deadline passes.\n   265\tfunc readProcBatched(deadline time.Time) ([]os.DirEntry, error) {\n   266\t\tf, err := os.Open(\"/proc\")\n   267\t\tif err != nil {\n   268\t\t\treturn nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n   269\t\t}\n   270\t\tdefer f.Close()\n   271\t\tvar out []os.DirEntry\n   272\t\tfor {\n   273\t\t\tbatch, err := f.ReadDir(512)\n   274\t\t\tfor _, d := range batch {\n   275\t\t\t\tif d.Name()[0] >= '0' && d.Name()[0] <= '9' {\n   276\t\t\t\t\tout = append(out, d)\n   277\t\t\t\t}\n   278\t\t\t}\n   279\t\t\tif err != nil || len(batch) == 0 {\n   280\t\t\t\treturn out, nil\n   281\t\t\t}\n   282\t\t\tif time.Now().After(deadline) {\n   283\t\t\t\treturn out, fmt.Errorf(\"the run's processes could not be listed within the bound\")\n   284\t\t\t}\n   285\t\t}\n   286\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_shim_linux.go | sed -n '1,195p'\"","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport (\n     6\t\t\"encoding/json\"\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"os\"\n    10\t\t\"os/exec\"\n    11\t\t\"os/signal\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"syscall\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"golang.org/x/sys/unix\"\n    18\t)\n    19\t\n    20\t// RunReviewShim runs args (the adapter's path, then its argv) as the shim's\n    21\t// only child, waits for it or for SIGTERM, ends every process left in the\n    22\t// shim's subtree and returns the adapter's exit status.\n    23\tfunc RunReviewShim(args []string) int {\n    24\t\treport := reviewShimReport{}\n    25\t\tvar reportFile *os.File\n    26\t\tparent := 0\n    27\t\tif value := os.Getenv(ReviewShimReportEnv); value != \"\" {\n    28\t\t\tparent, _ = strconv.Atoi(value)\n    29\t\t\t// The report pipe is the shim's alone: the adapter never inherits it.\n    30\t\t\tsyscall.CloseOnExec(3)\n    31\t\t\treportFile = os.NewFile(3, \"pose-review-shim-report\")\n    32\t\t}\n    33\t\t_ = os.Unsetenv(ReviewShimReportEnv)\n    34\t\twrite := func() {\n    35\t\t\tif reportFile == nil {\n    36\t\t\t\treturn\n    37\t\t\t}\n    38\t\t\traw := boundedReviewShimReport(report)\n    39\t\t\t_, _ = reportFile.Write(raw)\n    40\t\t\t_ = reportFile.Close()\n    41\t\t}\n    42\t\tif len(args) < 2 {\n    43\t\t\treport.Error = \"the review shim was given no adapter\"\n    44\t\t\twrite()\n    45\t\t\treturn 125\n    46\t\t}\n    47\t\tstop := make(chan os.Signal, 1)\n    48\t\tsignal.Notify(stop, syscall.SIGTERM)\n    49\t\t// The dispatcher's death stops the shim the same way as a timeout.\n    50\t\tif err := unix.Prctl(unix.PR_SET_PDEATHSIG, uintptr(syscall.SIGTERM), 0, 0, 0); err != nil {\n    51\t\t\treport.Error = \"the shim could not follow its dispatcher: \" + err.Error()\n    52\t\t\twrite()\n    53\t\t\treturn 125\n    54\t\t}\n    55\t\tif parent != 0 && os.Getppid() != parent {\n    56\t\t\treport.Error = \"the dispatcher ended before the shim started\"\n    57\t\t\twrite()\n    58\t\t\treturn 125\n    59\t\t}\n    60\t\tif err := unix.Prctl(unix.PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0); err != nil {\n    61\t\t\treport.Error = \"the shim could not become the subreaper of the run: \" + err.Error()\n    62\t\t\twrite()\n    63\t\t\treturn 125\n    64\t\t}\n    65\t\tcmd := &exec.Cmd{Path: args[0], Args: args[1:], Stdin: os.Stdin, Stdout: os.Stdout, Stderr: os.Stderr, Env: os.Environ()}\n    66\t\tif err := cmd.Start(); err != nil {\n    67\t\t\treport.Error = \"the adapter could not run: \" + err.Error()\n    68\t\t\twrite()\n    69\t\t\treturn 127\n    70\t\t}\n    71\t\tdone := make(chan error, 1)\n    72\t\tgo func() { done <- cmd.Wait() }()\n    73\t\tcode, stopped := 0, false\n    74\t\tvar signaled syscall.Signal\n    75\t\tselect {\n    76\t\tcase err := <-done:\n    77\t\t\tvar exit *exec.ExitError\n    78\t\t\tif errors.As(err, &exit) {\n    79\t\t\t\tif status, ok := exit.Sys().(syscall.WaitStatus); ok && status.Signaled() {\n    80\t\t\t\t\tsignaled, code = status.Signal(), 128+int(status.Signal())\n    81\t\t\t\t} else {\n    82\t\t\t\t\tcode = exit.ExitCode()\n    83\t\t\t\t}\n    84\t\t\t} else if err != nil {\n    85\t\t\t\treport.Error = \"the adapter's end could not be read: \" + err.Error()\n    86\t\t\t}\n    87\t\tcase <-stop:\n    88\t\t\tstopped, code = true, 128+int(syscall.SIGTERM)\n    89\t\t}\n    90\t\tended, err := reapShimSubtree()\n    91\t\treport.Ended = ended\n    92\t\tif err != nil && report.Error == \"\" {\n    93\t\t\treport.Error = err.Error()\n    94\t\t}\n    95\t\twrite()\n    96\t\tif stopped {\n    97\t\t\treturn code\n    98\t\t}\n    99\t\t// An adapter ended by a signal is reported as ended by it: the shim ends\n   100\t\t// itself the same way, so the dispatcher reads what it would have read\n   101\t\t// without the shim.\n   102\t\tif signaled != 0 {\n   103\t\t\tsignal.Reset(signaled)\n   104\t\t\t_ = syscall.Kill(os.Getpid(), signaled)\n   105\t\t\ttime.Sleep(time.Second)\n   106\t\t}\n   107\t\treturn code\n   108\t}\n   109\t\n   110\t// stopReviewShim asks a running shim to end its subtree and exit.\n   111\tfunc stopReviewShim(cmd *exec.Cmd) func() error {\n   112\t\treturn func() error { return cmd.Process.Signal(syscall.SIGTERM) }\n   113\t}\n   114\t\n   115\t// reapShimSubtree ends and reaps every child of the shim, including the\n   116\t// orphans its subreaper status adopted, until none is left.\n   117\tfunc reapShimSubtree() ([]string, error) {\n   118\t\tself := os.Getpid()\n   119\t\tvar ended []string\n   120\t\tseen := map[int]bool{}\n   121\t\tdeadline := time.Now().Add(reviewReapWait)\n   122\t\t// A process that cannot be inspected or ended is not a reason to stop:\n   123\t\t// the others are still ended, and the problem is reported at the end\n   124\t\t// (review round 9, N3).\n   125\t\tvar problems []string\n   126\t\tnote := func(err error) {\n   127\t\t\tif len(problems) < 8 {\n   128\t\t\t\tproblems = append(problems, err.Error())\n   129\t\t\t}\n   130\t\t}\n   131\t\tfor {\n   132\t\t\tchildren := 0\n   133\t\t\tproblems = problems[:0]\n   134\t\t\t// /proc is read in batches under the deadline, never materialized\n   135\t\t\t// whole (review round 13, N3).\n   136\t\t\tdirs, err := readProcBatched(deadline)\n   137\t\t\tif err != nil {\n   138\t\t\t\tnote(err)\n   139\t\t\t}\n   140\t\t\tfor _, d := range dirs {\n   141\t\t\t\tpid, err := strconv.Atoi(d.Name())\n   142\t\t\t\tif err != nil || pid == self {\n   143\t\t\t\t\tcontinue\n   144\t\t\t\t}\n   145\t\t\t\tst, err := readShimProcStat(pid)\n   146\t\t\t\tif reviewProcessGoneErr(err) {\n   147\t\t\t\t\tcontinue\n   148\t\t\t\t}\n   149\t\t\t\tif err != nil {\n   150\t\t\t\t\t// A process of another user is never the run's: with procfs\n   151\t\t\t\t\t// mounted hidepid it is visible and unreadable (review round 10,\n   152\t\t\t\t\t// N1). Only one of this user is an unknown that may be the run's.\n   153\t\t\t\t\tif owner, oerr := reviewProcessOwner(pid); reviewProcessGoneErr(oerr) || oerr == nil && owner != os.Getuid() {\n   154\t\t\t\t\t\tcontinue\n   155\t\t\t\t\t}\n   156\t\t\t\t\tchildren++\n   157\t\t\t\t\tnote(fmt.Errorf(\"process %d could not be inspected: %w\", pid, err))\n   158\t\t\t\t\tcontinue\n   159\t\t\t\t}\n   160\t\t\t\tif st.ppid != self {\n   161\t\t\t\t\tcontinue\n   162\t\t\t\t}\n   163\t\t\t\tchildren++\n   164\t\t\t\tif !st.zombie {\n   165\t\t\t\t\t// A pid is reported ended only once its signal was delivered\n   166\t\t\t\t\t// (review round 10, N3).\n   167\t\t\t\t\tif delivered, err := killPinnedChild(pid, self); err != nil {\n   168\t\t\t\t\t\tnote(err)\n   169\t\t\t\t\t} else if delivered {\n   170\t\t\t\t\t\tseen[pid] = true\n   171\t\t\t\t\t}\n   172\t\t\t\t}\n   173\t\t\t}\n   174\t\t\tfor {\n   175\t\t\t\tpid, err := unix.Wait4(-1, nil, unix.WNOHANG, nil)\n   176\t\t\t\tif pid <= 0 || err != nil {\n   177\t\t\t\t\tbreak\n   178\t\t\t\t}\n   179\t\t\t\t// A pid is reported ended once it was signalled and reaped\n   180\t\t\t\t// (review round 12, N2).\n   181\t\t\t\tif seen[pid] {\n   182\t\t\t\t\tdelete(seen, pid)\n   183\t\t\t\t\tended = append(ended, strconv.Itoa(pid))\n   184\t\t\t\t}\n   185\t\t\t}\n   186\t\t\tif children == 0 && len(problems) == 0 {\n   187\t\t\t\treturn ended, nil\n   188\t\t\t}\n   189\t\t\tif time.Now().After(deadline) {\n   190\t\t\t\treturn ended, fmt.Errorf(\"%d process(es) of the run could not be ended: %s\", children, strings.Join(problems, \"; \"))\n   191\t\t\t}\n   192\t\t\ttime.Sleep(20 * time.Millisecond)\n   193\t\t}\n   194\t}\n   195\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '900,1325p'\"","aggregated_output":"   900\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n   901\t\t\treturn finish(ReviewRunFailed, err.Error())\n   902\t\t}\n   903\t\tif err := verifyBundleMaterialization(worktree, plan.Bundle); err != nil {\n   904\t\t\treturn finish(ReviewRunFailed, err.Error())\n   905\t\t}\n   906\t\tif plan.Purpose == DelegationPurposeReview && plan.Config.Events == DelegationEventsClaudeStreamJSON {\n   907\t\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n   908\t\t\tif err != nil {\n   909\t\t\t\treturn finish(ReviewRunFailed, \"review staging policy unavailable\")\n   910\t\t\t}\n   911\t\t\tif found && policy.Agents[plan.Adapter].ReviewProfile != nil {\n   912\t\t\t\tif err := prepareClaudeReviewStaging(runtimeRoot, plan.Bundle.Payload.Plan.Components); err != nil {\n   913\t\t\t\t\treturn finish(ReviewRunFailed, \"review staging directories unavailable\")\n   914\t\t\t\t}\n   915\t\t\t}\n   916\t\t}\n   917\t\tdiskBefore, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n   918\t\tif err != nil {\n   919\t\t\treturn finish(ReviewRunFailed, err.Error())\n   920\t\t}\n   921\t\n   922\t\trawTree, err := json.Marshal(diskBefore)\n   923\t\tif err != nil {\n   924\t\t\treturn finish(ReviewRunFailed, err.Error())\n   925\t\t}\n   926\t\tif plan.predecessor != nil && (!plan.handoff || plan.predecessor.TreeDigest != \"\") && digestBytes(rawTree) != plan.predecessor.TreeDigest {\n   927\t\t\treturn finish(ReviewRunFailed, \"recreated worktree tree digest differs\")\n   928\t\t}\n   929\t\trun.TreeDigest = digestBytes(rawTree)\n   930\t\toutputFile := filepath.Join(tmp, \"output.txt\")\n   931\t\tcommand := plan.Config.Command\n   932\t\tif plan.predecessor != nil && !plan.handoff || plan.thread.continued() {\n   933\t\t\tcommand = plan.Config.Resume.Command\n   934\t\t}\n   935\t\targv := ReviewerArgv(command, outputFile, plan.session, plan.Effort, plan.Config.Effort)\n   936\t\ttimeout := time.Duration(safety.TimeoutMS) * time.Millisecond\n   937\t\texecPath := argv[0]\n   938\t\tif run.Provenance != nil {\n   939\t\t\tcopy := *run.Provenance\n   940\t\t\trun.Provenance = &copy\n   941\t\t\tselected, resolved, err := provenanceExecutableSelection(argv[0], worktree)\n   942\t\t\tif err != nil {\n   943\t\t\t\treturn finish(ReviewRunFailed, \"provenance executable could not be resolved\")\n   944\t\t\t}\n   945\t\t\tdigest, err := reviewExecutableDigest(resolved)\n   946\t\t\tif err != nil {\n   947\t\t\t\treturn finish(ReviewRunFailed, err.Error())\n   948\t\t\t}\n   949\t\t\trun.Provenance.ExecutableDigest = digest\n   950\t\t\texecPath = selected\n   951\t\t\traw, _ := json.Marshal(argv)\n   952\t\t\trun.Provenance.ArgvDigest = digestBytes(raw)\n   953\t\t}\n   954\t\tif plan.processTimeout > 0 {\n   955\t\t\tstarted, err := time.Parse(time.RFC3339Nano, run.StartedAt)\n   956\t\t\tif err != nil {\n   957\t\t\t\treturn finish(ReviewRunFailed, \"invalid execution start\")\n   958\t\t\t}\n   959\t\t\tsetup := now().Sub(started)\n   960\t\t\tremaining := plan.processTimeout - setup\n   961\t\t\tif setup < 0 || remaining <= 0 {\n   962\t\t\t\treturn finish(ReviewRunFailed, \"accumulated wall-clock budget spent before adapter launch\")\n   963\t\t\t}\n   964\t\t\tif remaining < timeout {\n   965\t\t\t\ttimeout = remaining\n   966\t\t\t}\n   967\t\t}\n   968\t\tctx, cancel := context.WithTimeout(parent, timeout)\n   969\t\tdefer cancel()\n   970\t\tcmd := exec.CommandContext(ctx, execPath, argv[1:]...)\n   971\t\tcmd.Args[0] = argv[0]\n   972\t\t// The adapter runs under the review run shim, which ends what the run\n   973\t\t// leaves in its subtree (review_shim.go).\n   974\t\tuseShim := false\n   975\t\tvar shimRead, shimWrite *os.File\n   976\t\tif ReviewShimAvailable && runtime.GOOS == \"linux\" && cmd.Err == nil {\n   977\t\t\t// The adapter's path as resolved here, in the dispatcher's PATH. A\n   978\t\t\t// shim that cannot be set up fails the run: it never falls back to\n   979\t\t\t// the weaker environment search (review round 11, N1).\n   980\t\t\tself, err := os.Executable()\n   981\t\t\tif err != nil {\n   982\t\t\t\treturn finish(ReviewRunFailed, \"the review run shim could not be set up: \"+err.Error())\n   983\t\t\t}\n   984\t\t\tr, w, err := os.Pipe()\n   985\t\t\tif err != nil {\n   986\t\t\t\treturn finish(ReviewRunFailed, \"the review run shim could not be set up: \"+err.Error())\n   987\t\t\t}\n   988\t\t\tuseShim, shimRead, shimWrite = true, r, w\n   989\t\t\tcmd = exec.CommandContext(ctx, self, append([]string{ReviewShimArg, cmd.Path}, argv...)...)\n   990\t\t\tcmd.ExtraFiles = []*os.File{w}\n   991\t\t}\n   992\t\tcmd.Dir = worktree\n   993\t\tcmd.Stdin = strings.NewReader(plan.Brief.Text)\n   994\t\tenv, secrets, err := reviewAdapterEnvironment(plan.Config, tmp, plan.Brief.Text, plan.notes)\n   995\t\tif err != nil {\n   996\t\t\trun.BriefNotes = \"\"\n   997\t\t\treturn finish(ReviewRunFailed, err.Error())\n   998\t\t}\n   999\t\tunset := []string{}\n  1000\t\tif policy, _, found, perr := s.LoadDelegationPolicy(); perr == nil && found {\n  1001\t\t\tunset = policy.EnvUnset\n  1002\t\t}\n  1003\t\tenv, run.EnvRemoved = withoutParentSession(env, unset)\n  1004\t\t// The reviewer works in a sealed checkout: diagnostics it runs must not\n  1005\t\t// publish derived records into it (SealedCheckoutEnv).\n  1006\t\tenv = append(env, SealedCheckoutEnv+\"=\"+worktree)\n  1007\t\tif useShim {\n  1008\t\t\tenv = append(env, ReviewShimReportEnv+\"=\"+fmt.Sprint(os.Getpid()))\n  1009\t\t}\n  1010\t\t// The reviewer checks its draft against the sealed bundle and the round\n  1011\t\t// before it finishes (spec pose-review-readiness-before-seal R3). A\n  1012\t\t// context that cannot be built leaves the check unavailable, never the\n  1013\t\t// review.\n  1014\t\tif plan.Purpose == DelegationPurposeReview {\n  1015\t\t\tif draftCtx, err := s.ReviewDraftContextFor(plan.Bundle); err == nil {\n  1016\t\t\t\tif path, err := writeReviewDraftContext(tmp, draftCtx); err == nil {\n  1017\t\t\t\t\tenv = append(env, ReviewDraftContextEnv+\"=\"+path)\n  1018\t\t\t\t\t// The reviewer's shell may resolve another `pose` first; the\n  1019\t\t\t\t\t// engine that dispatched the run is the one that checks it.\n  1020\t\t\t\t\tif self, err := os.Executable(); err == nil {\n  1021\t\t\t\t\t\tenv = append(env, ReviewCLIEnv+\"=\"+self)\n  1022\t\t\t\t\t}\n  1023\t\t\t\t}\n  1024\t\t\t}\n  1025\t\t}\n  1026\t\tcmd.Env = env\n  1027\t\tcombined := &reviewBoundedCapture{limit: safety.StreamBytes, cancel: cancel}\n  1028\t\tcmd.Stdout, cmd.Stderr = combined, combined\n  1029\t\t// pose delegate watch follows the normalized, redacted events as they come\n  1030\t\t// (spec pose-delegated-review-completion-signal R9); the file goes when\n  1031\t\t// the record is published.\n  1032\t\tsessionPattern := \"\"\n  1033\t\tif plan.Config.Session != nil {\n  1034\t\t\tsessionPattern = plan.Config.Session.Pattern\n  1035\t\t}\n  1036\t\tif live := s.startDelegationLive(run.AttemptID, plan.Config.Events, secrets, sessionPattern, plan.session, safety.StreamBytes); live != nil {\n  1037\t\t\ttee := io.MultiWriter(combined, live)\n  1038\t\t\tcmd.Stdout, cmd.Stderr = tee, tee\n  1039\t\t\tdefer func() { _ = os.Remove(s.delegationLivePath(run.AttemptID)) }()\n  1040\t\t\tdefer live.Close()\n  1041\t\t}\n  1042\t\t// Adapters such as `codex exec` and `claude -p` start children; killing\n  1043\t\t// only the parent left a child holding stdout, so the timeout never fired\n  1044\t\t// (found in review). The run gets its own process group, the whole group\n  1045\t\t// is killed on timeout and after the run, and pipes are released at most\n  1046\t\t// a few seconds after the kill.\n  1047\t\topaqueBaseline := reviewOpaqueProcessBaseline()\n  1048\t\t// Orphans of the run are reparented to this process, so one that left\n  1049\t\t// the group and cleared its environment is still found (review round 6, N2).\n  1050\t\tisolateProcessGroup(cmd)\n  1051\t\tcmd.WaitDelay = AdapterPipeGrace\n  1052\t\tvar shimReport []byte\n  1053\t\tshimReportDone := make(chan struct{})\n  1054\t\tif useShim {\n  1055\t\t\t// A timeout asks the shim to end the run's subtree first; the group\n  1056\t\t\t// kill after Wait remains the backstop (review round 8, N3).\n  1057\t\t\tcmd.Cancel = stopReviewShim(cmd)\n  1058\t\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n  1059\t\t\tgo func() {\n  1060\t\t\t\tdefer close(shimReportDone)\n  1061\t\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n  1062\t\t\t\t// Whatever exceeds the bound is drained, so the shim never blocks.\n  1063\t\t\t\t_, _ = io.Copy(io.Discard, shimRead)\n  1064\t\t\t}()\n  1065\t\t} else {\n  1066\t\t\tclose(shimReportDone)\n  1067\t\t}\n  1068\t\tvar runErr error\n  1069\t\tprepareReviewProcessTree(cmd)\n  1070\t\tif run.Provenance == nil {\n  1071\t\t\tif runErr = cmd.Start(); runErr == nil {\n  1072\t\t\t\tif runErr = attachReviewProcessTree(cmd); runErr == nil {\n  1073\t\t\t\t\trunErr = cmd.Wait()\n  1074\t\t\t\t} else {\n  1075\t\t\t\t\t_ = cmd.Wait()\n  1076\t\t\t\t}\n  1077\t\t\t}\n  1078\t\t} else {\n  1079\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1080\t\t\trunErr = err\n  1081\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1082\t\t\tif started {\n  1083\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1084\t\t\t}\n  1085\t\t}\n  1086\t\tif useShim && safety != nil {\n  1087\t\t\t// With the shim the run's leftovers are its subtree, not an\n  1088\t\t\t// environment match (review round 9, N1).\n  1089\t\t\tfor i, limit := range safety.Limitations {\n  1090\t\t\t\tif strings.HasPrefix(limit, \"no memory/CPU quota;\") {\n  1091\t\t\t\t\tsafety.Limitations[i] = \"no memory/CPU quota; the review run shim ends every process left in the run's subtree, including one in its own session\"\n  1092\t\t\t\t}\n  1093\t\t\t}\n  1094\t\t}\n  1095\t\tif useShim {\n  1096\t\t\t_ = shimWrite.Close()\n  1097\t\t\t<-shimReportDone\n  1098\t\t\t_ = shimRead.Close()\n  1099\t\t}\n  1100\t\tterminationErr = errors.Join(killProcessGroup(cmd), releaseReviewProcessTree(cmd))\n  1101\t\t// A command the reviewer left running in a session of its own escapes the\n  1102\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1103\t\t// directories it may still write (spec\n  1104\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1105\t\t// The environment entry is the reviewer's to set, so it is searched only\n  1106\t\t// without the shim, whose subtree is the run's by construction (review\n  1107\t\t// round 8, N1).\n  1108\t\tvar reaped []string\n  1109\t\tshimMore := 0\n  1110\t\tvar opaque int\n  1111\t\tvar reapErr error\n  1112\t\tif !useShim {\n  1113\t\t\treaped, opaque, reapErr = reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n  1114\t\t\tif reapErr != nil {\n  1115\t\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1116\t\t\t}\n  1117\t\t}\n  1118\t\tif useShim && cmd.ProcessState != nil {\n  1119\t\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n  1120\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1121\t\t\t} else {\n  1122\t\t\t\tfor _, pid := range report.Ended {\n  1123\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1124\t\t\t\t}\n  1125\t\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n  1126\t\t\t\t\t// Counted from the total, not from the listed pids (review\n  1127\t\t\t\t\t// round 12, N3).\n  1128\t\t\t\t\tshimMore = more\n  1129\t\t\t\t}\n  1130\t\t\t\tif report.Error != \"\" {\n  1131\t\t\t\t\tterminationErr = errors.Join(terminationErr,