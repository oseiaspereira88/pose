{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'func runProvenanceCommand|runProvenanceCommand\\\\(' pose-mcp/internal/pose && nl -ba pose-mcp/internal/pose/review_run_provenance.go | sed -n '1,360p' && rg -n 'Provenance \"'!= nil|provenance'\"' pose-mcp/internal/pose/review_dispatch.go | head -80\"","aggregated_output":"pose-mcp/internal/pose/review_run_provenance.go:837:func runProvenanceCommand(cmd *exec.Cmd, text string) (digest string, count int64, complete, started bool, runErr error) {\npose-mcp/internal/pose/roadmap_reviews_findings_test.go:247:\t\t_, count, complete, _, err := runProvenanceCommand(exec.Command(\"true\"), \"brief\")\npose-mcp/internal/pose/review_run_provenance_test.go:382:\tdigest, n, complete, started, e := runProvenanceCommand(command, wire)\npose-mcp/internal/pose/review_run_provenance_test.go:506:\t_, _, complete, started, e := runProvenanceCommand(command, \"fixture brief\")\npose-mcp/internal/pose/review_dispatch.go:1079:\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"crypto/ed25519\"\n     5\t\t\"crypto/sha256\"\n     6\t\t\"encoding/base64\"\n     7\t\t\"encoding/hex\"\n     8\t\t\"encoding/json\"\n     9\t\t\"errors\"\n    10\t\t\"fmt\"\n    11\t\t\"io\"\n    12\t\t\"os\"\n    13\t\t\"os/exec\"\n    14\t\t\"path/filepath\"\n    15\t\t\"regexp\"\n    16\t\t\"strings\"\n    17\t\t\"time\"\n    18\t)\n    19\t\n    20\tconst reviewRunProofDir = \".pose/review-run-proofs\"\n    21\tconst ReviewRunMachineAttested = \"machine-attested\"\n    22\t\n    23\t// Native agent executables include their runtime (Claude Code 2.1.318 is\n    24\t// 337,814,032 bytes). Hash them as a bounded stream; their size is independent\n    25\t// of the transcript bytes retained as evidence.\n    26\tconst reviewExecutableMaxBytes int64 = 512 * 1024 * 1024\n    27\t\n    28\t// ModelIdentity is explicitly declared by the executor's protected policy.\n    29\t// Signing authenticates that declaration, never an independent vendor receipt.\n    30\ttype ModelIdentity struct {\n    31\t\tPrincipal string `json:\"principal\"`\n    32\t\tExecution string `json:\"execution,omitempty\"`\n    33\t\tVendor    string `json:\"vendor\"`\n    34\t\tModel     string `json:\"model\"`\n    35\t}\n    36\ttype ReviewRunProvenancePolicy struct {\n    37\t\tTrust          string        `json:\"trust\"`\n    38\t\tImplementation ModelIdentity `json:\"implementation\"`\n    39\t}\n    40\ttype ReviewRunProvenance struct {\n    41\t\tExecutionState        string        `json:\"execution_state\"`\n    42\t\tPlannedWireDigest     string        `json:\"planned_wire_digest\"`\n    43\t\tWireBytes             int64         `json:\"wire_bytes\"`\n    44\t\tWireComplete          bool          `json:\"wire_complete\"`\n    45\t\tSchemaVersion         int           `json:\"schema_version\"`\n    46\t\tProject               string        `json:\"project\"`\n    47\t\tAudience              string        `json:\"audience\"`\n    48\t\tWorktreeDigest        string        `json:\"worktree_digest\"`\n    49\t\tTrust                 string        `json:\"trust\"`\n    50\t\tImplementation        ModelIdentity `json:\"implementation\"`\n    51\t\tReviewer              ModelIdentity `json:\"reviewer\"`\n    52\t\tConfigDigest          string        `json:\"config_digest\"`\n    53\t\tCommandTemplateDigest string        `json:\"command_template_digest\"`\n    54\t\tArgvDigest            string        `json:\"argv_digest\"`\n    55\t\tExecutableDigest      string        `json:\"executable_digest\"`\n    56\t\tTemplateVersion       string        `json:\"template_version\"`\n    57\t\tWireDigest            string        `json:\"wire_digest\"`\n    58\t\tNotesDigest           string        `json:\"notes_digest\"`\n    59\t\tRawTranscriptDigest   string        `json:\"raw_transcript_digest\"`\n    60\t\tRawOutputDigest       string        `json:\"raw_output_digest\"`\n    61\t\tOutputSource          string        `json:\"output_source\"`\n    62\t\tOutputComplete        bool          `json:\"output_complete\"`\n    63\t}\n    64\ttype ReviewRunReference struct {\n    65\t\tRunID   string `json:\"run_id\"`\n    66\t\tProofID string `json:\"proof_id\"`\n    67\t}\n    68\ttype ReviewRunProofClaim struct {\n    69\t\tSchemaVersion    int    `json:\"schema_version\"`\n    70\t\tProject          string `json:\"project\"`\n    71\t\tAudience         string `json:\"audience\"`\n    72\t\tRunID            string `json:\"run_id\"`\n    73\t\tRecordDigest     string `json:\"record_digest\"`\n    74\t\tBundleDigest     string `json:\"bundle_digest\"`\n    75\t\tScope            string `json:\"scope\"`\n    76\t\tKind             string `json:\"kind\"`\n    77\t\tAttemptID        string `json:\"attempt_id\"`\n    78\t\tResumes          string `json:\"resumes,omitempty\"`\n    79\t\tTranscriptDigest string `json:\"transcript_digest\"`\n    80\t\tOutputDigest     string `json:\"output_digest\"`\n    81\t\tProvenanceDigest string `json:\"provenance_digest\"`\n    82\t\tIssuedAt         string `json:\"issued_at\"`\n    83\t\tExpiresAt        string `json:\"expires_at,omitempty\"`\n    84\t}\n    85\ttype ReviewRunProof struct {\n    86\t\tSchemaVersion int                 `json:\"schema_version\"`\n    87\t\tProofID       string              `json:\"proof_id,omitempty\"`\n    88\t\tIssuer        string              `json:\"issuer\"`\n    89\t\tAlgorithm     string              `json:\"algorithm\"`\n    90\t\tPublicKey     string              `json:\"public_key\"`\n    91\t\tSignature     string              `json:\"signature,omitempty\"`\n    92\t\tClaim         ReviewRunProofClaim `json:\"claim\"`\n    93\t}\n    94\ttype ReviewRunAssurance struct {\n    95\t\tDraftDecision    string        `json:\"draft_decision\"`\n    96\t\tProofIssuedAt    string        `json:\"proof_issued_at\"`\n    97\t\tProofExpiresAt   string        `json:\"proof_expires_at,omitempty\"`\n    98\t\tState            string        `json:\"state\"`\n    99\t\tCompleteReview   bool          `json:\"complete_review\"`\n   100\t\tAssurance        string        `json:\"assurance\"`\n   101\t\tRunID            string        `json:\"run_id\"`\n   102\t\tProofID          string        `json:\"proof_id\"`\n   103\t\tIssuer           string        `json:\"issuer\"`\n   104\t\tReviewer         ModelIdentity `json:\"reviewer\"`\n   105\t\tImplementation   ModelIdentity `json:\"implementation\"`\n   106\t\tIdentitySource   string        `json:\"identity_source\"`\n   107\t\tVendorDifference bool          `json:\"vendor_difference\"`\n   108\t\tModelDifference  bool          `json:\"model_difference\"`\n   109\t\tOutputComplete   bool          `json:\"output_complete\"`\n   110\t\tLimitations      []string      `json:\"limitations\"`\n   111\t\t// IndependenceAchieved and ImplementationSource disclose what the run\n   112\t\t// achieved against whom: the identity the bundle sealed (detected or\n   113\t\t// declared) or the policy's, for an earlier bundle (spec\n   114\t\t// pose-delegation-routing R8, R11).\n   115\t\tIndependenceAchieved string `json:\"independence_achieved,omitempty\"`\n   116\t\tImplementationSource string `json:\"implementation_source,omitempty\"`\n   117\t}\n   118\t\n   119\tvar runIdentityComponent = regexp.MustCompile(`^[a-z0-9][a-z0-9._:/@+\\-]{0,255}$`)\n   120\t\n   121\tfunc normalizeModelIdentity(id ModelIdentity) (ModelIdentity, error) {\n   122\t\tid.Vendor = strings.ToLower(strings.TrimSpace(id.Vendor))\n   123\t\tid.Model = strings.ToLower(strings.TrimSpace(id.Model))\n   124\t\tif !validReviewPrincipal(id.Principal) || strings.TrimSpace(id.Principal) != id.Principal {\n   125\t\t\treturn id, fmt.Errorf(\"provenance principal must be explicit\")\n   126\t\t}\n   127\t\tfor _, value := range []string{id.Vendor, id.Model} {\n   128\t\t\tif !runIdentityComponent.MatchString(value) || value == \"unknown\" || value == \"unspecified\" || value == \"default\" {\n   129\t\t\t\treturn id, fmt.Errorf(\"provenance vendor/model baseline is unknown or malformed\")\n   130\t\t\t}\n   131\t\t}\n   132\t\tif id.Execution != \"\" && (len(id.Execution) > 256 || strings.TrimSpace(id.Execution) != id.Execution || strings.ContainsAny(id.Execution, \"\\r\\n\\x00\")) {\n   133\t\t\treturn id, fmt.Errorf(\"invalid implementation execution\")\n   134\t\t}\n   135\t\treturn id, nil\n   136\t}\n   137\t\n   138\t// runImplementationIdentity is the implementation a run of bundle is compared\n   139\t// with: the identity the bundle sealed, or for a bundle sealed before it\n   140\t// recorded one, the policy's declaration (spec pose-delegation-routing R4).\n   141\t// An unknown vendor cannot be the implementation of an attested run; an\n   142\t// unknown model stays unknown and never establishes a model difference.\n   143\tfunc runImplementationIdentity(bundle ReviewBundle, policy *ReviewRunProvenancePolicy) (ModelIdentity, error) {\n   144\t\tif impl := bundle.Payload.Implementation; impl != nil {\n   145\t\t\tif !knownIdentityPart(impl.Vendor) || impl.Principal == \"\" {\n   146\t\t\t\treturn ModelIdentity{}, fmt.Errorf(\"the bundle records no known implementation vendor; seal it with --lead <vendor>[/<model>]\")\n   147\t\t\t}\n   148\t\t\treturn ModelIdentity{Principal: impl.Principal, Execution: impl.ExecutionDigest, Vendor: impl.Vendor, Model: impl.Model}, nil\n   149\t\t}\n   150\t\tif policy == nil {\n   151\t\t\treturn ModelIdentity{}, fmt.Errorf(\"provenance implementation is missing\")\n   152\t\t}\n   153\t\treturn normalizeModelIdentity(policy.Implementation)\n   154\t}\n   155\t\n   156\tfunc knownIdentityPart(v string) bool {\n   157\t\tv = strings.TrimSpace(v)\n   158\t\treturn v != \"\" && v != ImplementationUnknown\n   159\t}\n   160\t\n   161\tfunc validateRunProvenancePolicy(policy ReviewersPolicy) error {\n   162\t\tif policy.Provenance == nil {\n   163\t\t\treturn nil\n   164\t\t}\n   165\t\tif policy.Provenance.Trust != \"executor-attested\" {\n   166\t\t\treturn fmt.Errorf(\"provenance requires explicit executor-attested trust\")\n   167\t\t}\n   168\t\t// The implementation is read from here only for bundles sealed before\n   169\t\t// they recorded it (spec pose-delegation-routing R4); a policy for later\n   170\t\t// bundles may omit it, but one that declares it declares it whole.\n   171\t\tif policy.Provenance.Implementation != (ModelIdentity{}) {\n   172\t\t\tid, e := normalizeModelIdentity(policy.Provenance.Implementation)\n   173\t\t\tif e != nil {\n   174\t\t\t\treturn e\n   175\t\t\t}\n   176\t\t\tif id.Execution == \"\" {\n   177\t\t\t\treturn fmt.Errorf(\"provenance needs implementation execution\")\n   178\t\t\t}\n   179\t\t}\n   180\t\tfor name, adapter := range policy.Adapters {\n   181\t\t\treviewer, e := normalizeModelIdentity(ModelIdentity{Principal: adapter.Executor, Vendor: adapter.Vendor, Model: adapter.Model})\n   182\t\t\tif e != nil || !strings.HasPrefix(reviewer.Principal, \"agent:\") {\n   183\t\t\t\treturn fmt.Errorf(\"adapter %s needs an explicit agent executor and known vendor/model\", name)\n   184\t\t\t}\n   185\t\t}\n   186\t\treturn nil\n   187\t}\n   188\tfunc (s Store) prepareRunProvenance(plan DispatchPlan, policy ReviewersPolicy) (*ReviewRunProvenance, error) {\n   189\t\tif policy.Provenance == nil {\n   190\t\t\treturn nil, nil\n   191\t\t}\n   192\t\tif e := validateRunProvenancePolicy(policy); e != nil {\n   193\t\t\treturn nil, e\n   194\t\t}\n   195\t\treview, _, e := s.loadReviewPolicy()\n   196\t\tif e != nil {\n   197\t\t\treturn nil, e\n   198\t\t}\n   199\t\tif err := s.runProvenanceProjectBinding(review.AuthorityProject); err != nil {\n   200\t\t\treturn nil, err\n   201\t\t}\n   202\t\tif !validGovernanceProjectID(review.AuthorityProject) || strings.TrimSpace(review.AuthorityAudience) == \"\" {\n   203\t\t\treturn nil, fmt.Errorf(\"run provenance needs protected authority_project and authority_audience\")\n   204\t\t}\n   205\t\timplementation, e := runImplementationIdentity(plan.Bundle, policy.Provenance)\n   206\t\tif e != nil {\n   207\t\t\treturn nil, e\n   208\t\t}\n   209\t\treviewer, e := normalizeModelIdentity(ModelIdentity{Principal: plan.Config.Executor, Vendor: plan.Config.Vendor, Model: plan.Config.Model})\n   210\t\tif e != nil {\n   211\t\t\treturn nil, e\n   212\t\t}\n   213\t\traw, _ := json.Marshal(plan.Config)\n   214\t\tcommand := plan.Config.Command\n   215\t\tif plan.predecessor != nil && !plan.handoff || plan.thread.continued() {\n   216\t\t\tcommand = plan.Config.Resume.Command\n   217\t\t}\n   218\t\targv, _ := json.Marshal(command)\n   219\t\treturn &ReviewRunProvenance{ExecutionState: \"not-started\", SchemaVersion: 1, Project: review.AuthorityProject, Audience: review.AuthorityAudience, WorktreeDigest: digestBytes([]byte(plan.OriginWorktree)), Trust: policy.Provenance.Trust, Implementation: implementation, Reviewer: reviewer, ConfigDigest: digestBytes(raw), CommandTemplateDigest: digestBytes(argv), TemplateVersion: plan.Brief.TemplateVersion, PlannedWireDigest: digestBytes([]byte(plan.Brief.Text)), NotesDigest: digestBytes([]byte(plan.notes))}, nil\n   220\t}\n   221\tfunc reviewExecutableDigest(path string) (string, error) {\n   222\t\treturn reviewExecutableDigestWithin(path, reviewExecutableMaxBytes)\n   223\t}\n   224\t\n   225\tfunc reviewExecutableDigestWithin(path string, maxBytes int64) (string, error) {\n   226\t\tif maxBytes <= 0 || maxBytes > reviewExecutableMaxBytes {\n   227\t\t\treturn \"\", fmt.Errorf(\"invalid provenance executable byte bound\")\n   228\t\t}\n   229\t\t// Resolve the observed target for hashing; execution retains the selected\n   230\t\t// path spelling so relative and shebang argv0 semantics stay unchanged.\n   231\t\tresolved, e := filepath.EvalSymlinks(path)\n   232\t\tif e != nil {\n   233\t\t\treturn \"\", e\n   234\t\t}\n   235\t\tinfo, e := os.Lstat(resolved)\n   236\t\tif e != nil || !info.Mode().IsRegular() || info.Size() < 0 || info.Size() > maxBytes {\n   237\t\t\treturn \"\", fmt.Errorf(\"provenance executable is not a bounded regular file\")\n   238\t\t}\n   239\t\tf, e := os.Open(resolved)\n   240\t\tif e != nil {\n   241\t\t\treturn \"\", e\n   242\t\t}\n   243\t\topened, e := f.Stat()\n   244\t\tif e != nil || !os.SameFile(info, opened) {\n   245\t\t\tf.Close()\n   246\t\t\treturn \"\", fmt.Errorf(\"executable changed while opening\")\n   247\t\t}\n   248\t\thash := sha256.New()\n   249\t\tn, e := io.Copy(hash, io.LimitReader(f, maxBytes+1))\n   250\t\tcloseErr := f.Close()\n   251\t\tif e != nil || closeErr != nil || n > maxBytes {\n   252\t\t\treturn \"\", fmt.Errorf(\"executable digest could not be read within bound\")\n   253\t\t}\n   254\t\treturn \"sha256:\" + hex.EncodeToString(hash.Sum(nil)), nil\n   255\t}\n   256\tfunc reviewRunCanonicalDigest(run ReviewRun) string {\n   257\t\trun.Path, run.SupersededBy = \"\", \"\"\n   258\t\traw, _ := json.Marshal(run)\n   259\t\treturn digestBytes(raw)\n   260\t}\n   261\tfunc (s Store) LoadProvenanceReviewRun(id string) (ReviewRun, error) {\n   262\t\tif strings.HasPrefix(id, \"trn-\") {\n   263\t\t\tif _, carrier := governanceReadViewFromFiles(s.fsys()); carrier != nil {\n   264\t\t\t\tmarkGovernanceReadUnknownForProject(s.fsys(), s.Root, carrier.project, carrier.producer, \"task-run identity is checked against external task state\")\n   265\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"invalid provenance run id\")\n   266\t\t\t}\n   267\t\t\tif s.IsDelegationTaskRun(id) {\n   268\t\t\t\treturn ReviewRun{}, ErrDelegationTaskRun(id)\n   269\t\t\t}\n   270\t\t}\n   271\t\tif !regexp.MustCompile(`^rrn-[0-9a-f]{16}$`).MatchString(id) {\n   272\t\t\treturn ReviewRun{}, fmt.Errorf(\"invalid provenance run id\")\n   273\t\t}\n   274\t\truns, lost, e := s.ReadReviewRuns(\"\")\n   275\t\tif e != nil {\n   276\t\t\treturn ReviewRun{}, e\n   277\t\t}\n   278\t\tif len(lost) > 0 {\n   279\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %v\", errReviewRunHistoryIncomplete, lost)\n   280\t\t}\n   281\t\tfor _, run := range runs {\n   282\t\t\tif run.RunID == id {\n   283\t\t\t\tif err := s.provenanceAttemptLineage(run, runs); err != nil {\n   284\t\t\t\t\treturn ReviewRun{}, err\n   285\t\t\t\t}\n   286\t\t\t\treturn run, nil\n   287\t\t\t}\n   288\t\t}\n   289\t\treturn ReviewRun{}, fmt.Errorf(\"provenance run not found\")\n   290\t}\n   291\tfunc runProofSigningBytes(proof ReviewRunProof) []byte {\n   292\t\tproof.ProofID, proof.Signature = \"\", \"\"\n   293\t\traw, _ := json.Marshal(proof)\n   294\t\treturn raw\n   295\t}\n   296\tfunc runProofIdentity(proof ReviewRunProof) string {\n   297\t\tproof.ProofID = \"\"\n   298\t\traw, _ := json.Marshal(proof)\n   299\t\treturn \"rrp-\" + strings.TrimPrefix(digestBytes(raw), \"sha256:\")\n   300\t}\n   301\tfunc runProofPath(id, proof string) (string, error) {\n   302\t\tif !regexp.MustCompile(`^rrn-[0-9a-f]{16}$`).MatchString(id) || !regexp.MustCompile(`^rrp-[0-9a-f]{64}$`).MatchString(proof) {\n   303\t\t\treturn \"\", fmt.Errorf(\"invalid run proof reference\")\n   304\t\t}\n   305\t\treturn filepath.ToSlash(filepath.Join(reviewRunProofDir, id, proof+\".json\")), nil\n   306\t}\n   307\t\n   308\t// SignReviewRunProof reuses a loaded native issuer; no key or run is rewritten.\n   309\t// It signs a captured executor statement, never inventing evidence for legacy runs.\n   310\tfunc (s Store) SignReviewRunProof(id string, key IssuerKey, ttl time.Duration, now time.Time, apply bool) (ReviewRunProof, error) {\n   311\t\trun, e := s.LoadProvenanceReviewRun(id)\n   312\t\tif e != nil {\n   313\t\t\treturn ReviewRunProof{}, e\n   314\t\t}\n   315\t\tif run.Provenance == nil {\n   316\t\t\treturn ReviewRunProof{}, fmt.Errorf(\"legacy run has no captured provenance; it cannot be reconstructed\")\n   317\t\t}\n   318\t\tif key.private == nil {\n   319\t\t\treturn ReviewRunProof{}, fmt.Errorf(\"issuer has no loaded native key\")\n   320\t\t}\n   321\t\tpolicy, _, e := s.loadReviewPolicy()\n   322\t\tif e != nil {\n   323\t\t\treturn ReviewRunProof{}, e\n   324\t\t}\n   325\t\tif !reviewIssuerHoldsGrant(policy.TrustedAttestationIssuers, key.Name, key.PublicKey()) {\n   326\t\t\treturn ReviewRunProof{}, fmt.Errorf(\"run issuer is not pinned for attestations\")\n   327\t\t}\n   328\t\tif ttl < 0 || ttl > 365*24*time.Hour {\n   329\t\t\treturn ReviewRunProof{}, fmt.Errorf(\"run proof TTL must be nonnegative and at most 365 days\")\n   330\t\t}\n   331\t\tif why := s.runProofContextConflict(run); why != \"\" {\n   332\t\t\treturn ReviewRunProof{}, fmt.Errorf(\"run proof cannot govern: %s\", why)\n   333\t\t}\n   334\t\tsnapshot, _ := json.Marshal(run.Provenance)\n   335\t\tclaim := ReviewRunProofClaim{SchemaVersion: 1, Project: run.Provenance.Project, Audience: run.Provenance.Audience, RunID: run.RunID, RecordDigest: reviewRunCanonicalDigest(run), BundleDigest: run.BundleDigest, Scope: run.Scope, Kind: run.Kind, AttemptID: run.AttemptID, Resumes: run.Resumes, TranscriptDigest: run.TranscriptDigest, OutputDigest: digestBytes([]byte(run.Output)), ProvenanceDigest: digestBytes(snapshot), IssuedAt: now.UTC().Format(time.RFC3339Nano)}\n   336\t\tif ttl > 0 {\n   337\t\t\tclaim.ExpiresAt = now.Add(ttl).UTC().Format(time.RFC3339Nano)\n   338\t\t}\n   339\t\tproof := ReviewRunProof{SchemaVersion: 1, Issuer: key.Name, Algorithm: \"ed25519\", PublicKey: key.PublicKey(), Claim: claim}\n   340\t\tproof.Signature = base64.StdEncoding.EncodeToString(ed25519.Sign(key.private, runProofSigningBytes(proof)))\n   341\t\tproof.ProofID = runProofIdentity(proof)\n   342\t\tif _, e = s.verifyRunProof(proof, run, now); e != nil {\n   343\t\t\treturn ReviewRunProof{}, e\n   344\t\t}\n   345\t\tif apply {\n   346\t\t\trel, e := runProofPath(run.RunID, proof.ProofID)\n   347\t\t\tif e != nil {\n   348\t\t\t\treturn ReviewRunProof{}, e\n   349\t\t\t}\n   350\t\t\tif e = publishLedgerJSON(s.Root, rel, proof); e != nil {\n   351\t\t\t\treturn ReviewRunProof{}, e\n   352\t\t\t}\n   353\t\t}\n   354\t\treturn proof, nil\n   355\t}\n   356\t\n   357\tfunc (s Store) VerifyReviewRunProof(id, proofID string) (ReviewRunAssurance, error) {\n   358\t\ts = s.reviewOperation()\n   359\t\trun, e := s.LoadProvenanceReviewRun(id)\n   360\t\tif e != nil {\n71:\tProvenance    *ReviewRunProvenancePolicy `json:\"provenance,omitempty\"`\n150:\tProvenance          *ReviewRunProvenance   `json:\"provenance,omitempty\"`\n394:\tprovenance          *ReviewRunProvenance\n509:\t\tif plan.Bundle.Payload.Implementation != nil && policy.Provenance != nil && policy.Provenance.Implementation != (ModelIdentity{}) {\n510:\t\t\tplan.Warnings = append(plan.Warnings, \"provenance.implementation in the delegation policy is ignored: bundle \"+plan.Bundle.BundleID+\" records the implementation it was sealed by; remove the policy entry\")\n600:\tplan.provenance, err = s.prepareRunProvenance(plan, policy)\n647:\trun := ReviewRun{Provenance: plan.provenance, BriefNotes: plan.notes, LimitOf: plan.LimitOf, SchemaVersion: 1, Scope: plan.Brief.Scope, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest,\n734:\t\trun.Provenance = fresh.provenance\n938:\tif run.Provenance != nil {\n941:\t\tselected, resolved, err := provenanceExecutableSelection(argv[0], worktree)\n943:\t\t\treturn finish(ReviewRunFailed, \"provenance executable could not be resolved\")\n1168:\t\tif run.Provenance != nil {\n1175:\t\tif run.Provenance != nil {\n1184:\t\tif run.Provenance != nil {\n1189:\tif run.Provenance != nil {\n1195:\t\tif run.Provenance != nil {\n1200:\t// Raw provenance hashes above precede redaction; only complete, bounded\n1209:\t\tif run.Provenance != nil {\n1245:\t\tif run.Provenance != nil {\n","exit_code":0,"status":"completed"}}
