  687\t\t\tdoCleanup()\n   688\t\t\tif cleanupErr != nil {\n   689\t\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n   690\t\t\t}\n   691\t\t}()\n   692\t\ttranscript := []byte{}\n   693\t\tfinish := func(status, failure string) (ReviewRun, error) {\n   694\t\t\tdoCleanup()\n   695\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n   696\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n   697\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n   698\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n   699\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n   700\t\t\t}\n   701\t\t\trun.sessionForRedaction = \"\"\n   702\t\t\trun.Status, run.Failure = status, failure\n   703\t\t\tif status != ReviewRunInterrupted {\n   704\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n   705\t\t\t}\n   706\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n   707\t\t\treturn s.recordReviewRun(run, transcript)\n   708\t\t}\n   709\t\t// Recompute semantic freshness at execution time, not just preview time.\n   710\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n   711\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   712\t\t}\n   713\t\tvar attempt DelegatedReviewAttempt\n   714\t\tif plan.predecessor == nil {\n   715\t\t\tvar err error\n   716\t\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n   717\t\t\tif err != nil {\n   718\t\t\t\treturn ReviewRun{}, err\n   719\t\t\t}\n   720\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n   721\t\t} else {\n   722\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n   723\t\t\tfresh, err := s.replanContinuation(plan)\n   724\t\t\tif err != nil {\n   725\t\t\t\treturn ReviewRun{}, err\n   726\t\t\t}\n   727\t\t\tif fresh.PendingContinuation != nil {\n   728\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n   729\t\t\t}\n   730\t\t\tif fresh.Existing != nil {\n   731\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   732\t\t\t}\n   733\t\t\tplan = fresh\n   734\t\t\trun.Provenance = fresh.provenance\n   735\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n   736\t\t\tif fresh.handoff {\n   737\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n   738\t\t\t} else {\n   739\t\t\t\trun.Resumes = fresh.predecessor.RunID\n   740\t\t\t}\n   741\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n   742\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n   743\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n   744\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n   745\t\t\t\treturn ReviewRun{}, err\n   746\t\t\t}\n   747\t\t}\n   748\t\t// The attempt result is published once: before the active marker goes\n   749\t\t// when the run was marked, at return otherwise (spec\n   750\t\t// pose-delegation-result-before-marker R1–R2).\n   751\t\tresultPublished := false\n   752\t\treserved := plan.predecessor != nil\n   753\t\tpublishResult := func() {\n   754\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n   755\t\t\t\treturn\n   756\t\t\t}\n   757\t\t\tresultPublished = true\n   758\t\t\tbeforeRunResultPublished(result)\n   759\t\t\tvar err error\n   760\t\t\tif plan.predecessor == nil {\n   761\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   762\t\t\t} else {\n   763\t\t\t\terr = s.finishReviewContinuation(result)\n   764\t\t\t}\n   765\t\t\tif err != nil {\n   766\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n   767\t\t\t}\n   768\t\t}\n   769\t\tdefer publishResult()\n   770\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n   771\t\tif err != nil {\n   772\t\t\tif plan.predecessor == nil {\n   773\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n   774\t\t\t\t// receipt are recorded against it, as before the marker moved\n   775\t\t\t\t// ahead of the reservation (spec\n   776\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n   777\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n   778\t\t\t\t\treturn ReviewRun{}, perr\n   779\t\t\t\t}\n   780\t\t\t\treserved = true\n   781\t\t\t}\n   782\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   783\t\t}\n   784\t\tif plan.predecessor == nil {\n   785\t\t\tbeforeAttemptPublished(s, attempt)\n   786\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n   787\t\t\t\tstopActive()\n   788\t\t\t\treturn ReviewRun{}, err\n   789\t\t\t}\n   790\t\t\treserved = true\n   791\t\t}\n   792\t\t// The marker goes only once the record and the attempt result are\n   793\t\t// published: without them it is the one trace of the reserved attempt,\n   794\t\t// and a waiter that sees it gone must find the receipt.\n   795\t\tdefer func() {\n   796\t\t\tpublishResult()\n   797\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n   798\t\t}()\n   799\t\tcancelled = cancelFlag\n   800\t\t// A detached run that cannot hand its attempt back stops here: nobody\n   801\t\t// would know which attempt runs (R1).\n   802\t\tif plan.OnStart != nil {\n   803\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n   804\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n   805\t\t\t}\n   806\t\t}\n   807\t\ttmp, err := os.MkdirTemp(\"\", \"pose-review-run-*\")\n   808\t\tif err != nil {\n   809\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n   810\t\t}\n   811\t\tsafety.RuntimeID = filepath.Base(tmp)\n   812\t\towned, err := os.Lstat(tmp)\n   813\t\tif err != nil {\n   814\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n   815\t\t}\n   816\t\truntimeRoot, err := os.OpenRoot(tmp)\n   817\t\tif err != nil {\n   818\t\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n   819\t\t}\n   820\t\tdefer runtimeRoot.Close()\n   821\t\tvar worktreeOwned os.FileInfo\n   822\t\tvar gitMarker []byte\n   823\t\tvar ownership *reviewCleanupOwnership\n   824\t\tworktree := filepath.Join(tmp, \"worktree\")\n   825\t\tcleanup = func() error {\n   826\t\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n   827\t\t}\n   828\t\thooks := filepath.Join(tmp, \"empty-hooks\")\n   829\t\tif err := os.Mkdir(hooks, 0700); err != nil {\n   830\t\t\treturn finish(ReviewRunFailed, \"private hook directory setup failed\")\n   831\t\t}\n   832\t\tsetupCtx, stopSetup := context.WithTimeout(parent, 2*time.Minute)\n   833\t\tdefer stopSetup()\n   834\t\tsetup := reviewSetupCommand(setupCtx, gitCommand(\"-C\", s.Root, \"-c\", \"core.hooksPath=\"+hooks, \"worktree\", \"add\", \"--detach\", worktree, plan.SealedCommit))\n   835\t\tsetupOutput := &reviewBoundedCapture{limit: 64 << 10, cancel: stopSetup}\n   836\t\tsetup.Stdout, setup.Stderr = setupOutput, setupOutput\n   837\t\tsetupErr := setup.Run()\n   838\t\t_, setupOverflow := setupOutput.result()\n   839\t\tterminationErr := killProcessGroup(setup)\n   840\t\tif terminationErr != nil {\n   841\t\t\tterminationFailed = true\n   842\t\t}\n   843\t\tsetupCause := executionCause(setupCtx)\n   844\t\tif setupErr != nil || terminationErr != nil || setupOverflow {\n   845\t\t\tsafety.ExecutionCause = setupCause\n   846\t\t\tif setupOverflow {\n   847\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   848\t\t\t}\n   849\t\t\treturn finish(ReviewRunFailed, \"review worktree setup failed or termination incomplete\")\n   850\t\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '1050,1250p'\"","aggregated_output":"  1050\t\tisolateProcessGroup(cmd)\n  1051\t\tcmd.WaitDelay = AdapterPipeGrace\n  1052\t\tvar shimReport []byte\n  1053\t\tshimReportDone := make(chan struct{})\n  1054\t\tif useShim {\n  1055\t\t\t// A timeout asks the shim to end the run's subtree first; the group\n  1056\t\t\t// kill after Wait remains the backstop (review round 8, N3).\n  1057\t\t\tcmd.Cancel = stopReviewShim(cmd)\n  1058\t\t\tcmd.WaitDelay = AdapterPipeGrace + reviewReapWait\n  1059\t\t\tgo func() {\n  1060\t\t\t\tdefer close(shimReportDone)\n  1061\t\t\t\tshimReport, _ = io.ReadAll(io.LimitReader(shimRead, 64<<10))\n  1062\t\t\t\t// Whatever exceeds the bound is drained, so the shim never blocks.\n  1063\t\t\t\t_, _ = io.Copy(io.Discard, shimRead)\n  1064\t\t\t}()\n  1065\t\t} else {\n  1066\t\t\tclose(shimReportDone)\n  1067\t\t}\n  1068\t\tvar runErr error\n  1069\t\tprepareReviewProcessTree(cmd)\n  1070\t\tif run.Provenance == nil {\n  1071\t\t\tif runErr = cmd.Start(); runErr == nil {\n  1072\t\t\t\tif runErr = attachReviewProcessTree(cmd); runErr == nil {\n  1073\t\t\t\t\trunErr = cmd.Wait()\n  1074\t\t\t\t} else {\n  1075\t\t\t\t\t_ = cmd.Wait()\n  1076\t\t\t\t}\n  1077\t\t\t}\n  1078\t\t} else {\n  1079\t\t\tdigest, n, complete, started, err := runProvenanceCommand(cmd, plan.Brief.Text)\n  1080\t\t\trunErr = err\n  1081\t\t\trun.Provenance.WireDigest, run.Provenance.WireBytes, run.Provenance.WireComplete = digest, n, complete\n  1082\t\t\tif started {\n  1083\t\t\t\trun.Provenance.ExecutionState = \"started\"\n  1084\t\t\t}\n  1085\t\t}\n  1086\t\tif useShim && safety != nil {\n  1087\t\t\t// With the shim the run's leftovers are its subtree, not an\n  1088\t\t\t// environment match (review round 9, N1).\n  1089\t\t\tfor i, limit := range safety.Limitations {\n  1090\t\t\t\tif strings.HasPrefix(limit, \"no memory/CPU quota;\") {\n  1091\t\t\t\t\tsafety.Limitations[i] = \"no memory/CPU quota; the review run shim ends every process left in the run's subtree, including one in its own session\"\n  1092\t\t\t\t}\n  1093\t\t\t}\n  1094\t\t}\n  1095\t\tif useShim {\n  1096\t\t\t_ = shimWrite.Close()\n  1097\t\t\t<-shimReportDone\n  1098\t\t\t_ = shimRead.Close()\n  1099\t\t}\n  1100\t\tterminationErr = errors.Join(killProcessGroup(cmd), releaseReviewProcessTree(cmd))\n  1101\t\t// A command the reviewer left running in a session of its own escapes the\n  1102\t\t// group kill; it is ended here, before the cleanup inventory reads the\n  1103\t\t// directories it may still write (spec\n  1104\t\t// pose-review-run-reaps-lingering-reviewer-processes R1, R2).\n  1105\t\t// The environment entry is the reviewer's to set, so it is searched only\n  1106\t\t// without the shim, whose subtree is the run's by construction (review\n  1107\t\t// round 8, N1).\n  1108\t\tvar reaped []string\n  1109\t\tshimMore := 0\n  1110\t\tvar opaque int\n  1111\t\tvar reapErr error\n  1112\t\tif !useShim {\n  1113\t\t\treaped, opaque, reapErr = reapSealedCheckoutProcesses(worktree, opaqueBaseline)\n  1114\t\t\tif reapErr != nil {\n  1115\t\t\t\tterminationErr = errors.Join(terminationErr, reapErr)\n  1116\t\t\t}\n  1117\t\t}\n  1118\t\tif useShim && cmd.ProcessState != nil {\n  1119\t\t\tif report, err := parseReviewShimReport(shimReport); err != nil {\n  1120\t\t\t\tterminationErr = errors.Join(terminationErr, err)\n  1121\t\t\t} else {\n  1122\t\t\t\tfor _, pid := range report.Ended {\n  1123\t\t\t\t\treaped = append(reaped, pid+\" (orphaned)\")\n  1124\t\t\t\t}\n  1125\t\t\t\tif more := report.EndedTotal - len(report.Ended); more > 0 {\n  1126\t\t\t\t\t// Counted from the total, not from the listed pids (review\n  1127\t\t\t\t\t// round 12, N3).\n  1128\t\t\t\t\tshimMore = more\n  1129\t\t\t\t}\n  1130\t\t\t\tif report.Error != \"\" {\n  1131\t\t\t\t\tterminationErr = errors.Join(terminationErr, errors.New(report.Error))\n  1132\t\t\t\t\t// The shim's own words go into the record, not only the\n  1133\t\t\t\t\t// generic failure (review round 10, N3).\n  1134\t\t\t\t\tif safety != nil {\n  1135\t\t\t\t\t\tsafety.Limitations = append(safety.Limitations, \"the review run shim could not end the whole subtree: \"+report.Error)\n  1136\t\t\t\t\t}\n  1137\t\t\t\t}\n  1138\t\t\t}\n  1139\t\t}\n  1140\t\tif endedCount := len(reaped) + shimMore; endedCount > 0 && safety != nil {\n  1141\t\t\tlisted := strings.Join(reaped, \", \")\n  1142\t\t\tif shimMore > 0 {\n  1143\t\t\t\tlisted += fmt.Sprintf(\" and %d more (orphaned)\", shimMore)\n  1144\t\t\t}\n  1145\t\t\tsafety.Limitations = append(safety.Limitations, \"ended \"+fmt.Sprint(endedCount)+\" process(es) the run left running: \"+listed)\n  1146\t\t}\n  1147\t\tif opaque > 0 && reapErr == nil && safety != nil {\n  1148\t\t\tsafety.Limitations = append(safety.Limitations, fmt.Sprint(opaque)+\" process(es) of this user that existed before the run could not be inspected for its environment entry\")\n  1149\t\t}\n  1150\t\tterminationFailed = terminationErr != nil\n  1151\t\t// The adapter exited and a child it left still held the output when\n  1152\t\t// WaitDelay expired: the run finished, its leftover is killed above, and\n  1153\t\t// the exit status decides (found in review).\n  1154\t\tif errors.Is(runErr, exec.ErrWaitDelay) && cmd.ProcessState != nil && cmd.ProcessState.Success() {\n  1155\t\t\trunErr = nil\n  1156\t\t}\n  1157\t\ttranscript, overflow := combined.result()\n  1158\t\tsafety.CaptureComplete = !overflow\n  1159\t\tif cmd.ProcessState != nil {\n  1160\t\t\trun.ExitCode = cmd.ProcessState.ExitCode()\n  1161\t\t}\n  1162\t\traw, outputErr := readReviewAdapterOutput(runtimeRoot, safety.OutputBytes)\n  1163\t\tif outputErr != nil && !errors.Is(outputErr, os.ErrNotExist) {\n  1164\t\t\tsafety.CaptureComplete = false\n  1165\t\t}\n  1166\t\tif outputErr == nil && len(bytes.TrimSpace(raw)) > 0 {\n  1167\t\t\trun.Output = string(raw)\n  1168\t\t\tif run.Provenance != nil {\n  1169\t\t\t\trun.Provenance.OutputComplete = true\n  1170\t\t\t\trun.Provenance.OutputSource = \"file\"\n  1171\t\t\t}\n  1172\t\t} else if final := DelegationStreamFinal(plan.Config.Events, transcript); strings.TrimSpace(final) != \"\" && int64(len(final)) <= safety.OutputBytes {\n  1173\t\t\t// The agent writes no output file; its stream names its final message.\n  1174\t\t\trun.Output = final\n  1175\t\t\tif run.Provenance != nil {\n  1176\t\t\t\trun.Provenance.OutputComplete = true\n  1177\t\t\t\trun.Provenance.OutputSource = \"stream-final\"\n  1178\t\t\t}\n  1179\t\t} else {\n  1180\t\t\trun.Output = tail(string(transcript), 20000)\n  1181\t\t\tif len(transcript) > 20000 || int64(len(transcript)) > safety.OutputBytes {\n  1182\t\t\t\tsafety.CaptureComplete = false\n  1183\t\t\t}\n  1184\t\t\tif run.Provenance != nil {\n  1185\t\t\t\trun.Provenance.OutputComplete = len(transcript) > 0 && len(transcript) <= 20000\n  1186\t\t\t\trun.Provenance.OutputSource = \"transcript-tail\"\n  1187\t\t\t}\n  1188\t\t}\n  1189\t\tif run.Provenance != nil {\n  1190\t\t\trun.Provenance.RawTranscriptDigest = digestBytes(transcript)\n  1191\t\t\trun.Provenance.RawOutputDigest = digestBytes([]byte(run.Output))\n  1192\t\t}\n  1193\t\tif runErr != nil && cmd.ProcessState == nil {\n  1194\t\t\trun.Output, transcript = \"\", nil\n  1195\t\t\tif run.Provenance != nil {\n  1196\t\t\t\trun.Provenance.OutputComplete = false\n  1197\t\t\t}\n  1198\t\t\treturn finish(ReviewRunFailed, \"reviewer command could not start\")\n  1199\t\t}\n  1200\t\t// Raw provenance hashes above precede redaction; only complete, bounded\n  1201\t\t// redacted channels can be retained. Partial boundaries can expose a secret.\n  1202\t\tsafety.ExecutionCause = executionCause(ctx)\n  1203\t\tif !utf8.ValidString(run.Output) || terminationErr != nil {\n  1204\t\t\tsafety.CaptureComplete = false\n  1205\t\t}\n  1206\t\tif !safety.CaptureComplete {\n  1207\t\t\ttranscript = nil\n  1208\t\t\trun.Output = \"\"\n  1209\t\t\tif run.Provenance != nil {\n  1210\t\t\t\trun.Provenance.OutputComplete = false\n  1211\t\t\t}\n  1212\t\t\tif terminationErr != nil {\n  1213\t\t\t\treturn finish(ReviewRunFailed, \"process group termination failed; descendants may remain\")\n  1214\t\t\t}\n  1215\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1216\t\t\treturn finish(ReviewRunFailed, \"adapter capture incomplete: stream/output limit or unsafe output file\")\n  1217\t\t}\n  1218\t\tcaptureStage := \"session/interrupt recognition\"\n  1219\t\tstatus, failure, captureErr := s.classifyReviewInterruption(&run, plan, transcript, runErr, ctx.Err())\n  1220\t\tif captureErr == nil {\n  1221\t\t\tvar redactErr error\n  1222\t\t\traw := transcript\n  1223\t\t\tcaptureStage = \"stdout\"\n  1224\t\t\ttranscript, redactErr = redactReviewCapture(transcript, secrets, run.sessionForRedaction, safety.StreamBytes)\n  1225\t\t\tvar output []byte\n  1226\t\t\tif redactErr == nil {\n  1227\t\t\t\tcaptureStage = \"final output\"\n  1228\t\t\t\toutput, redactErr = redactReviewCapture([]byte(run.Output), secrets, run.sessionForRedaction, safety.OutputBytes)\n  1229\t\t\t}\n  1230\t\t\trun.Output = string(output)\n  1231\t\t\tif redactErr == nil && run.Events != \"\" {\n  1232\t\t\t\tcaptureStage = \"normalized events\"\n  1233\t\t\t\t// Events are parsed from the decoded stream, where a JSON escape no longer\n  1234\t\t\t\t// hides a value: each text is redacted again after decoding.\n  1235\t\t\t\trun.eventsBytes, redactErr = redactedDelegationEvents(run.Events, raw, run.Output, secrets, run.sessionForRedaction)\n  1236\t\t\t}\n  1237\t\t\tif redactErr != nil {\n  1238\t\t\t\tcaptureErr = redactErr\n  1239\t\t\t}\n  1240\t\t}\n  1241\t\tif captureErr != nil {\n  1242\t\t\trun.Output, transcript = \"\", nil\n  1243\t\t\tsafety.CaptureComplete = false\n  1244\t\t\tsafety.ExecutionCause = \"capture-incomplete\"\n  1245\t\t\tif run.Provenance != nil {\n  1246\t\t\t\trun.Provenance.OutputComplete = false\n  1247\t\t\t}\n  1248\t\t\treturn finish(ReviewRunFailed, \"adapter capture failed; unredacted output withheld; \"+delegationCaptureFailure(run.Adapter, run.Events, captureStage, captureErr))\n  1249\t\t}\n  1250\t\trun.sessionForRedaction = \"\"\n","exit_code":0,"status":"completed"}}
