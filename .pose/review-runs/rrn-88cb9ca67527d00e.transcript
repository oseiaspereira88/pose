ts owner is proven gone, cancel releases it\n    22\t// with a failed run and its receipt, and the ledger reads again.\n    23\tfunc TestAnAbandonedAttemptIsReleasedWithARecord(t *testing.T) {\n    24\t\troot := t.TempDir()\n    25\t\ts := Store{Root: root}\n    26\t\tbundle := \"rvb-00000000000000a1\"\n    27\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n    28\t\t\tReservedAt: time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(\"0\", 32)}\n    29\t\ta.AttemptID = attemptIdentity(a)\n    30\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    31\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    32\t\t\tt.Fatal(err)\n    33\t\t}\n    34\t\t// The ledger refuses the bundle while the reservation has no receipt.\n    35\t\tif _, err := s.readAttemptReceipt(a); err == nil || !strings.Contains(err.Error(), \"incomplete or unreadable\") {\n    36\t\t\tt.Fatalf(\"an unfinished reservation read as finished: %v\", err)\n    37\t\t}\n    38\t\n    39\t\t// The marker the interrupted dispatch left: its owner is a process that\n    40\t\t// has exited.\n    41\t\tdead := exec.Command(\"true\")\n    42\t\tif err := dead.Run(); err != nil {\n    43\t\t\tt.Fatal(err)\n    44\t\t}\n    45\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    46\t\towner.Host, _ = os.Hostname()\n    47\t\tidentifyStartLockProcess(&owner)\n    48\t\towner.PID = dead.Process.Pid\n    49\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"b\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: a.Scope, BundleID: bundle,\n    50\t\t\tStartedAt: a.ReservedAt, Owner: owner, HeartbeatAt: a.ReservedAt, HeartbeatEvery: 10}\n    51\t\tdir, err := s.delegationActiveDir(true)\n    52\t\tif err != nil {\n    53\t\t\tt.Fatal(err)\n    54\t\t}\n    55\t\traw, _ := json.Marshal(marker)\n    56\t\tif err := os.WriteFile(filepath.Join(dir, a.AttemptID+\".json\"), raw, 0o600); err != nil {\n    57\t\t\tt.Fatal(err)\n    58\t\t}\n    59\t\n    60\t\trun, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false)\n    61\t\tif err != nil {\n    62\t\t\tt.Fatal(err)\n    63\t\t}\n    64\t\tif run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"abandoned\") {\n    65\t\t\tt.Fatalf(\"the release recorded %s: %s\", run.Status, run.Failure)\n    66\t\t}\n    67\t\tif _, err := s.readAttemptReceipt(a); err != nil {\n    68\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n    69\t\t}\n    70\t\tif left, _ := filepath.Glob(filepath.Join(dir, a.AttemptID+\"*\")); len(left) != 1 || !strings.HasSuffix(left[0], \".release.lock\") {\n    71\t\t\tt.Fatalf(\"the marker or its stall claim stayed: %v\", left)\n    72\t\t}\n    73\t\t// Released once: a second release finds nothing abandoned.\n    74\t\tif _, err := s.ReleaseAbandonedAttempt(a.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n    75\t\t\tt.Fatalf(\"a released attempt was released again: %v\", err)\n    76\t\t}\n    77\t}\n    78\t\n    79\t// An attempt whose owner is alive is never released.\n    80\tfunc TestARunningAttemptIsNotReleased(t *testing.T) {\n    81\t\troot := t.TempDir()\n    82\t\ts := Store{Root: root}\n    83\t\tbundle := \"rvb-00000000000000a2\"\n    84\t\t// Silent for an hour, so only the owner's liveness keeps it running.\n    85\t\told := time.Now().Add(-time.Hour).UTC().Format(time.RFC3339Nano)\n    86\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: bundle, BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1, ReservedAt: old, Nonce: strings.Repeat(\"0\", 32)}\n    87\t\ta.AttemptID = attemptIdentity(a)\n    88\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n    89\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n    90\t\t\tt.Fatal(err)\n    91\t\t}\n    92\t\towner := StartLockOwner{SchemaVersion: StartLockOwnerSchemaVersion, Resource: \"delegate:\" + a.AttemptID, Worktree: root, Operation: \"pose delegate review\", PID: os.Getpid()}\n    93\t\towner.Host, _ = os.Hostname()\n    94\t\tidentifyStartLockProcess(&owner)\n    95\t\tmarker := DelegationActiveRun{SchemaVersion: 1, AttemptID: a.AttemptID, RunToken: strings.Repeat(\"d\", 32), Purpose: DelegationPurposeReview, Agent: \"fake\", Scope: \"spec:alpha\", BundleID: bundle, StartedAt: old, Owner: owner, HeartbeatAt: old, HeartbeatEvery: 10}\n    96\t\tdir, _ := s.delegationActiveDir(true)\n    97\t\traw, _ := json.Marshal(marker)\n    98\t\tif err := os.WriteFile(filepath.Join(dir, marker.AttemptID+\".json\"), raw, 0o600); err != nil {\n    99\t\t\tt.Fatal(err)\n   100\t\t}\n   101\t\tif _, err := s.ReleaseAbandonedAttempt(marker.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) {\n   102\t\t\tt.Fatalf(\"a running attempt was released: %v\", err)\n   103\t\t}\n   104\t}\n   105\t\n   106\t// Review round 1, N1: the dispatch marks the attempt active before it\n   107\t// publishes the reservation, so no instant leaves a reservation without a\n   108\t// marker that turns stalled.\n   109\tfunc TestTheAttemptIsMarkedActiveBeforeItIsReserved(t *testing.T) {\n   110\t\tvar checked bool\n   190\t\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n   191\t\t\tt.Fatal(err)\n   192\t\t}\n   193\t}\n   194\t\n   195\t// Review round 2, N4 (R6): a real dispatch interrupted after its reservation\n   196\t// and before its run record blocks the next dispatch; once released, the\n   197\t// next dispatch runs.\n   198\tfunc TestAnInterruptedDispatchIsReleasedAndTheNextOneRuns(t *testing.T) {\n   199\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   200\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   201\t\tif err != nil {\n   202\t\t\tt.Fatal(err)\n   203\t\t}\n   204\t\tattempt := \"\"\n   205\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   206\t\tfunc() {\n   207\t\t\tdefer func() { _ = recover() }()\n   208\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   209\t\t}()\n   210\t\tif attempt == \"\" {\n   211\t\t\tt.Fatal(\"the dispatch never reached its start\")\n   212\t\t}\n   213\t\twriteDeadMarker(t, f.store, attempt)\n   214\t\tif _, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after interruption\"); err == nil || !strings.Contains(err.Error(), \"pose delegate cancel \"+attempt) {\n   215\t\t\tt.Fatalf(\"the interrupted attempt did not block the bundle with its release command: %v\", err)\n   216\t\t}\n   217\t\tif _, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil {\n   218\t\t\tt.Fatal(err)\n   219\t\t}\n   220\t\tnext, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"after release\")\n   221\t\tif err != nil {\n   222\t\t\tt.Fatalf(\"the released attempt still blocks the bundle: %v\", err)\n   223\t\t}\n   224\t\tif run, err := f.store.RunReviewDispatchContext(context.Background(), next, time.Now); err != nil || run.Status != ReviewRunCompleted {\n   225\t\t\tt.Fatalf(\"the next dispatch did not run: %s %v\", run.Status, err)\n   226\t\t}\n   227\t}\n   228\t\n   229\t// Review rounds 2 and 5 (N3, N1): one release runs at a time, under a lock\n   230\t// the operating system releases when its holder ends.\n   231\tfunc TestOneReleaseRunsAtATime(t *testing.T) {\n   232\t\troot := t.TempDir()\n   233\t\ts := Store{Root: root}\n   234\t\tattempt := \"rat-\" + strings.Repeat(\"9\", 64)\n   235\t\tdir, _ := s.delegationActiveDir(true)\n   236\t\tlockPath := filepath.Join(dir, attempt+\".release.lock\")\n   237\t\theld, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0o600)\n   238\t\tif err != nil {\n   239\t\t\tt.Fatal(err)\n   240\t\t}\n   241\t\tunlock, err := lockSpecTransferFile(held)\n   242\t\tif err != nil {\n   243\t\t\tt.Fatal(err)\n   244\t\t}\n   245\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"in progress\") {\n   246\t\t\tt.Fatalf(\"a release ran while another held the lock: %v\", err)\n   247\t\t}\n   248\t\tunlock()\n   249\t\theld.Close()\n   250\t\t// A holder that ends releases the lock with it: nothing is left to take over.\n   251\t\tif _, err := exec.LookPath(\"flock\"); err == nil {\n   252\t\t\tholder := exec.Command(\"flock\", lockPath, \"sleep\", \"30\")\n   253\t\t\tholder.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n   254\t\t\tif err := holder.Start(); err != nil {\n   255\t\t\t\tt.Fatal(err)\n   256\t\t\t}\n   257\t\t\ttime.Sleep(200 * time.Millisecond)\n   258\t\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err == nil || !strings.Contains(err.Error(), \"in progress\") {\n   259\t\t\t\tt.Fatalf(\"the other process's lock was not seen: %v\", err)\n   260\t\t\t}\n   261\t\t\t_ = syscall.Kill(-holder.Process.Pid, syscall.SIGKILL)\n   262\t\t\t_ = holder.Wait()\n   263\t\t}\n   264\t\tif _, err := s.ReleaseAbandonedAttempt(attempt, time.Now(), false); err != nil && strings.Contains(err.Error(), \"in progress\") {\n   265\t\t\tt.Fatalf(\"an ended holder's lock still blocks the release: %v\", err)\n   266\t\t}\n   267\t}\n   268\t\n   269\t// Review round 3, N1: a release interrupted after it recorded the run, and\n   270\t// before the receipt, completes with that run instead of recording another.\n   310\t\t}\n   311\t}\n   312\t\n   313\t// Review round 2, N1: a reservation an earlier engine left with no marker is\n   314\t// listed and released once it is old enough, never while it is young.\n   315\tfunc TestAMarkerlessReservationOfAnEarlierEngineIsReleased(t *testing.T) {\n   316\t\troot := t.TempDir()\n   317\t\ts := Store{Root: root}\n   318\t\treserve := func(age time.Duration, nonce string) DelegatedReviewAttempt {\n   319\t\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: \"rvb-00000000000000b\" + nonce[:1], BundleDigest: \"sha256:\" + strings.Repeat(\"a\", 64), Scope: \"spec:alpha\", Adapter: \"fake\", Ordinal: 1,\n   320\t\t\t\tReservedAt: time.Now().Add(-age).UTC().Format(time.RFC3339Nano), Nonce: strings.Repeat(nonce[:1], 32)}\n   321\t\t\ta.AttemptID = attemptIdentity(a)\n   322\t\t\trel, _ := filepath.Rel(root, reviewAttemptPath(root, a))\n   323\t\t\tif err := publishLedgerJSON(root, filepath.ToSlash(rel), a); err != nil {\n   324\t\t\t\tt.Fatal(err)\n   325\t\t\t}\n   326\t\t\treturn a\n   327\t\t}\n   328\t\told, young := reserve(time.Hour, \"1\"), reserve(time.Minute, \"2\")\n   329\t\tattempts, _, err := s.ListDelegationAttempts()\n   330\t\tif err != nil {\n   331\t\t\tt.Fatal(err)\n   332\t\t}\n   333\t\tlisted := map[string]DelegationAttempt{}\n   334\t\tfor _, a := range attempts {\n   335\t\t\tlisted[a.AttemptID] = a\n   336\t\t}\n   337\t\tif a, ok := listed[old.AttemptID]; !ok || a.State != DelegationStalled || !strings.Contains(a.Failure, \"pose delegate cancel \"+old.AttemptID+\" --confirm-abandoned\") {\n   338\t\t\tt.Fatalf(\"the old markerless reservation is not listed with its release: %+v\", attempts)\n   339\t\t}\n   340\t\tif _, ok := listed[young.AttemptID]; ok {\n   341\t\t\tt.Fatal(\"a young reservation was listed as abandoned\")\n   342\t\t}\n   343\t\tif _, err := s.ReleaseAbandonedAttempt(young.AttemptID, time.Now(), true); !errors.Is(err, ErrAttemptNotAbandoned) {\n   344\t\t\tt.Fatalf(\"a young reservation was released: %v\", err)\n   345\t\t}\n   346\t\t// Review round 3, N2: nothing proves a markerless reservation abandoned,\n   347\t\t// so it is released only on the operator's confirmation.\n   348\t\tif _, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), false); !errors.Is(err, ErrAttemptNotAbandoned) || !strings.Contains(err.Error(), \"--confirm-abandoned\") {\n   349\t\t\tt.Fatalf(\"a markerless reservation was released without confirmation: %v\", err)\n   350\t\t}\n   351\t\trun, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n   352\t\tif err != nil || run.Status != ReviewRunFailed || !strings.Contains(run.Failure, \"operator's confirmation\") {\n   353\t\t\tt.Fatalf(\"release: %+v %v\", run, err)\n   354\t\t}\n   355\t\tif _, err := s.readAttemptReceipt(old); err != nil {\n   356\t\t\tt.Fatalf(\"the released reservation still blocks its bundle: %v\", err)\n   357\t\t}\n   358\t\t// Review round 4, N1: a release stopped between its run and its receipt\n   359\t\t// leaves the attempt with a run; it is still released, with that run.\n   360\t\tif err := os.Remove(attemptReceiptPath(root, old)); err != nil {\n   361\t\t\tt.Fatal(err)\n   362\t\t}\n   363\t\tagain, err := s.ReleaseAbandonedAttempt(old.AttemptID, time.Now(), true)\n   364\t\tif err != nil || again.RunID != run.RunID {\n   365\t\t\tt.Fatalf(\"the interrupted release did not complete with its run: %s then %s (%v)\", run.RunID, again.RunID, err)\n   366\t\t}\n   367\t}\n   368\t\n   369\t// Review round 3, N3: an unreadable reservation is reported, not skipped.\n   370\tfunc TestAnUnreadableReservationIsReportedAsALoss(t *testing.T) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '400,505p;690,825p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '340,375p;420,470p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '400,505p;690,825p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '340,375p;420,470p'\"","aggregated_output":"   400\t\n   401\t// ReviewRoundOf derives the round of bundle from the sealed bundles of its\n   402\t// scope and the run history (R1). A history or a bundle inventory with a loss\n   403\t// that may concern the scope, a previous round whose record is not intact,\n   404\t// or a run of the scope whose bundle is missing make it fail: a round is\n   405\t// never silently lowered (security; review round 1, B9).\n   406\tfunc (s Store) ReviewRoundOf(bundle ReviewBundle) (ReviewRound, error) {\n   407\t\truns, lost, err := s.ReadReviewRuns(\"\")\n   408\t\tif err != nil {\n   409\t\t\treturn ReviewRound{}, err\n   410\t\t}\n   411\t\tif len(lost) > 0 {\n   412\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: the review run history is incomplete, so the round of %s cannot be derived: %v\", bundle.BundleID, lost)\n   413\t\t}\n   414\t\tscope := bundle.Payload.Scope.Ref\n   415\t\tread, err := s.ReadReviewBundles(scope)\n   416\t\tif err != nil {\n   417\t\t\treturn ReviewRound{}, err\n   418\t\t}\n   419\t\tfor _, loss := range read.Coverage.Losses {\n   420\t\t\tif loss.Scope == \"\" || loss.Scope == scope || loss.Scope == bundle.Payload.Scope.Slug {\n   421\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: a sealed bundle that may belong to %s could not be read (%s), so its round cannot be derived\", scope, loss.Artifact)\n   422\t\t\t}\n   423\t\t}\n   424\t\tpresent := map[string]bool{}\n   425\t\tfor _, b := range read.Bundles {\n   426\t\t\tpresent[b.BundleID] = true\n   427\t\t}\n   428\t\tfor _, r := range runs {\n   429\t\t\tif r.Scope == scope && r.Kind == ReviewBriefKindReview && r.Status == ReviewRunCompleted && !present[r.BundleID] && r.BundleID != bundle.BundleID {\n   430\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s reviewed bundle %s of %s, which is missing, so the round cannot be derived\", r.RunID, r.BundleID, scope)\n   431\t\t\t}\n   432\t\t}\n   433\t\treturn reviewRoundFrom(bundle, read.Bundles, runs, s.reviewRunTranscriptIntact)\n   434\t}\n   435\t\n   436\t// reviewRoundFrom derives the round of bundle from bundles and runs; intact\n   437\t// says why a run's record is not intact, or \"\".\n   438\tfunc reviewRoundFrom(bundle ReviewBundle, bundles []ReviewBundle, runs []ReviewRun, intact func(ReviewRun) string) (ReviewRound, error) {\n   439\t\ttype concluded struct {\n   440\t\t\tbundle ReviewBundle\n   441\t\t\trun    *ReviewRun\n   442\t\t\tended  time.Time\n   443\t\t}\n   444\t\t// A round precedes bundle when its concluding run ended no later than the\n   445\t\t// second bundle was sealed in: a bundle is sealed after the rejection it\n   446\t\t// answers. Seals have second precision, runs nanoseconds, so the runs, as\n   447\t\t// instants, order the chain (D4; review round 1, B3).\n   448\t\tsealed, sealErr := time.Parse(time.RFC3339, bundle.SealedAt)\n   449\t\tvar chain []concluded\n   450\t\tfor _, b := range bundles {\n   451\t\t\tif b.BundleID == bundle.BundleID || b.BundleDigest == bundle.BundleDigest {\n   452\t\t\t\tcontinue\n   453\t\t\t}\n   454\t\t\trun := concludingReviewRun(runs, b.BundleID)\n   455\t\t\tif run == nil {\n   456\t\t\t\tcontinue\n   457\t\t\t}\n   458\t\t\tended, err := time.Parse(time.RFC3339Nano, run.EndedAt)\n   459\t\t\tif err != nil {\n   460\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: run %s records no valid end, so the order of the rounds cannot be derived\", run.RunID)\n   461\t\t\t}\n   462\t\t\tif bundle.SealedAt != \"\" && sealErr == nil && ended.Truncate(time.Second).After(sealed) {\n   463\t\t\t\tcontinue\n   464\t\t\t}\n   465\t\t\tchain = append(chain, concluded{b, run, ended})\n   466\t\t}\n   467\t\tsort.SliceStable(chain, func(i, j int) bool {\n   468\t\t\tif !chain[i].ended.Equal(chain[j].ended) {\n   469\t\t\t\treturn chain[i].ended.Before(chain[j].ended)\n   470\t\t\t}\n   471\t\t\treturn chain[i].run.RunID < chain[j].run.RunID\n   472\t\t})\n   473\t\tround := ReviewRound{Number: len(chain) + 1}\n   474\t\tvar open []ReviewOpenFinding\n   475\t\tvar broken []string\n   476\t\tfor i, c := range chain {\n   477\t\t\tnumber := i + 1\n   478\t\t\tif why := intact(*c.run); why != \"\" {\n   479\t\t\t\treturn ReviewRound{}, fmt.Errorf(\"pose: the run of round %d (%s) is not intact, so its findings cannot be carried: %s\", number, c.run.RunID, why)\n   480\t\t\t}\n   481\t\t\tdraft, err := ParseReviewDraft(c.run.Output)\n   482\t\t\tif draft == nil || err != nil {\n   483\t\t\t\twhy := \"it carries no pose-draft block\"\n   484\t\t\t\tif err != nil {\n   485\t\t\t\t\twhy = err.Error()\n   486\t\t\t\t}\n   487\t\t\t\t// What this round said cannot be read: nothing is added, and\n   488\t\t\t\t// nothing open is closed (review round 1, B1).\n   489\t\t\t\tbroken = append(broken, fmt.Sprintf(\"the draft of round %d (%s) cannot be read: %s\", number, c.run.RunID, why))\n   490\t\t\t\tcontinue\n   491\t\t\t}\n   492\t\t\taccounted := map[string]ReviewDraftPrior{}\n   493\t\t\tfor _, p := range draft.PriorFindings {\n   494\t\t\t\taccounted[p.ID] = p\n   495\t\t\t}\n   496\t\t\t// A finding leaves the open set only when this round reported it\n   497\t\t\t// fixed with evidence, or superseded; unaccounted or unevidenced, it\n   498\t\t\t// stays open, so an invalid account never closes it (B1).\n   499\t\t\tvar next []ReviewOpenFinding\n   500\t\t\tfor _, f := range open {\n   501\t\t\t\tp, ok := accounted[f.ID]\n   502\t\t\t\tswitch {\n   503\t\t\t\tcase !ok:\n   504\t\t\t\t\tf.Carried = \"unaccounted\"\n   505\t\t\t\tcase p.Status == PriorFindingFixed && strings.TrimSpace(p.Evidence) == \"\":\n   690\t\tdefault:\n   691\t\t\tvalue, rerr := s.readReviewSession(prior.SessionDigest)\n   692\t\t\tif rerr != nil {\n   693\t\t\t\tthread.Reason = \"the previous round's session cannot be resumed: \" + rerr.Error()\n   694\t\t\t\tbreak\n   695\t\t\t}\n   696\t\t\tthread.Mode, session = ReviewThreadContinued, value\n   697\t\t}\n   698\t\tplan.thread, plan.session = thread, session\n   699\t\treturn nil\n   700\t}\n   701\t\n   702\t// FailedContinuation is a run of the bundle that failed while continuing a\n   703\t// session: nothing says why in terms common to every vendor, and resuming what\n   704\t// just failed is not worth an attempt (spec\n   705\t// pose-delegated-review-expired-session R1, D1).\n   706\tfunc FailedContinuation(runs []ReviewRun, bundleID string) *ReviewRun {\n   707\t\tfor i := range runs {\n   708\t\t\tif runs[i].BundleID == bundleID && runs[i].Status == ReviewRunFailed && runs[i].Thread.continued() {\n   709\t\t\t\treturn &runs[i]\n   710\t\t\t}\n   711\t\t}\n   712\t\treturn nil\n   713\t}\n   714\t\n   715\tfunc FailedContinuationReason(run *ReviewRun) string {\n   716\t\treason := \"the session could not be continued: run \" + run.RunID + \" failed\"\n   717\t\tif failure := []rune(run.Failure); len(failure) > 200 {\n   718\t\t\treturn reason + \": \" + string(failure[:200]) + \"…\"\n   719\t\t} else if len(failure) > 0 {\n   720\t\t\treturn reason + \": \" + string(failure)\n   721\t\t}\n   722\t\treturn reason\n   723\t}\n   724\t\n   725\t// continuationRound carries the round of a run's predecessor to its\n   726\t// continuation: a resume keeps the predecessor's thread, a handoff records a\n   727\t// new session because another agent runs (review round 1, B11).\n   728\tfunc continuationRound(plan *DispatchPlan, prior ReviewRun, handoff bool) {\n   729\t\tplan.round, plan.thread = prior.Round, prior.Thread\n   730\t\tif handoff && prior.Round >= 2 {\n   731\t\t\tplan.thread = &ReviewThread{Round: prior.Round, Mode: ReviewThreadNew, From: prior.RunID, Reason: \"the run was handed off to agent \" + plan.Adapter}\n   732\t\t}\n   733\t}\n   734\t\n   735\t// ReviewRoundMetric is the convergence of one scope's rounds (R7, R10).\n   736\ttype ReviewRoundMetric struct {\n   737\t\tScope            string                 `json:\"scope\"`\n   738\t\tRounds           int                    `json:\"rounds\"`\n   739\t\tFindingsPerRound []int                  `json:\"findings_per_round\"`\n   740\t\tInvalidRounds    int                    `json:\"invalid_rounds\"`\n   741\t\tRoundsToApproval *int                   `json:\"rounds_to_approval\"`\n   742\t\tContinued        ReviewRoundConvergence `json:\"continued\"`\n   743\t\tCold             ReviewRoundConvergence `json:\"cold\"`\n   744\t}\n   745\t\n   746\t// ReviewRoundConvergence is the R7 figures of the rounds after the first of\n   747\t// one kind: those whose session continued the previous round's, or cold ones\n   748\t// (R10). Shares are of the prior findings accounted for in valid drafts.\n   749\ttype ReviewRoundConvergence struct {\n   750\t\t// Trajectory is the findings each round of this kind reported, and\n   751\t\t// RoundsToApproval the round of this kind whose valid draft first\n   752\t\t// approved, if one did (R7 per kind, R10; review round 2, R2-B4).\n   753\t\tTrajectory       []ReviewRoundPoint `json:\"trajectory\"`\n   754\t\tRoundsToApproval *int               `json:\"rounds_to_approval\"`\n   755\t\tRounds           int                `json:\"rounds\"`\n   756\t\tInvalidRounds    int                `json:\"invalid_rounds\"`\n   757\t\tFindings         int                `json:\"findings\"`\n   758\t\tApprovals        int                `json:\"approvals\"`\n   759\t\tAccounted        int                `json:\"accounted\"`\n   760\t\tFixed            int                `json:\"fixed\"`\n   761\t\tPartial          int                `json:\"partial\"`\n   762\t\tNotFixed         int                `json:\"not_fixed\"`\n   763\t\tSuperseded       int                `json:\"superseded\"`\n   764\t\tFixedShare       *float64           `json:\"fixed_share\"`\n   765\t\tPartialShare     *float64           `json:\"partial_share\"`\n   766\t\tNotFixedShare    *float64           `json:\"not_fixed_share\"`\n   767\t\tSupersededShare  *float64           `json:\"superseded_share\"`\n   768\t}\n   769\t\n   770\t// ReviewRoundPoint is one round of a kind: its number, the findings its\n   771\t// draft reported, and whether its valid draft approved.\n   772\ttype ReviewRoundPoint struct {\n   773\t\tRound    int  `json:\"round\"`\n   774\t\tFindings int  `json:\"findings\"`\n   775\t\tApproved bool `json:\"approved\"`\n   776\t\tInvalid  bool `json:\"invalid\"`\n   777\t}\n   778\t\n   779\t// reviewRoundMetrics measures each scope's rounds. The number of rounds is\n   780\t// the highest any run of the scope recorded, whatever became of that run, so\n   781\t// a metric never lowers the rounds recorded (R8; review round 1, B5); a\n   782\t// round's figures come from the run that concluded it, and an invalid draft\n   783\t// counts as invalid, never as an approval or a convergence (B7).\n   784\tfunc reviewRoundMetrics(runs []ReviewRun) []ReviewRoundMetric {\n   785\t\thighest := map[string]int{}\n   786\t\tconcluding := map[string]map[int]ReviewRun{}\n   787\t\tfor _, r := range runs {\n   788\t\t\tif r.Round == 0 || r.Kind != ReviewBriefKindReview {\n   789\t\t\t\tcontinue\n   790\t\t\t}\n   791\t\t\tif r.Round > highest[r.Scope] {\n   792\t\t\t\thighest[r.Scope] = r.Round\n   793\t\t\t}\n   794\t\t\tif r.Status != ReviewRunCompleted || r.SupersededBy != \"\" {\n   795\t\t\t\tcontinue\n   796\t\t\t}\n   797\t\t\tif concluding[r.Scope] == nil {\n   798\t\t\t\tconcluding[r.Scope] = map[int]ReviewRun{}\n   799\t\t\t}\n   800\t\t\t// The run that ended last concludes the round, as concludingReviewRun\n   801\t\t\t// decides (review round 3, R3-F1).\n   802\t\t\tif prev, ok := concluding[r.Scope][r.Round]; ok {\n   803\t\t\t\tended, _ := time.Parse(time.RFC3339Nano, r.EndedAt)\n   804\t\t\t\tbefore, _ := time.Parse(time.RFC3339Nano, prev.EndedAt)\n   805\t\t\t\tif ended.Before(before) || ended.Equal(before) && r.RunID < prev.RunID {\n   806\t\t\t\t\tcontinue\n   807\t\t\t\t}\n   808\t\t\t}\n   809\t\t\tconcluding[r.Scope][r.Round] = r\n   810\t\t}\n   811\t\tscopes := make([]string, 0, len(highest))\n   812\t\tfor scope := range highest {\n   813\t\t\tscopes = append(scopes, scope)\n   814\t\t}\n   815\t\tsort.Strings(scopes)\n   816\t\tshare := func(n, total int) *float64 {\n   817\t\t\tif total == 0 {\n   818\t\t\t\treturn nil\n   819\t\t\t}\n   820\t\t\tv := float64(n) / float64(total)\n   821\t\t\treturn &v\n   822\t\t}\n   823\t\tvar out []ReviewRoundMetric\n   824\t\tfor _, scope := range scopes {\n   825\t\t\tm := ReviewRoundMetric{Scope: scope, Rounds: highest[scope], Continued: ReviewRoundConvergence{Trajectory: []ReviewRoundPoint{}}, Cold: ReviewRoundConvergence{Trajectory: []ReviewRoundPoint{}}}\n   340\t\t\t\tfor _, a := range out {\n   341\t\t\t\t\tif filepath.Base(attemptReceiptPath(s.Root, a)) == e.Name() {\n   342\t\t\t\t\t\tfound = true\n   343\t\t\t\t\t\tbreak\n   344\t\t\t\t\t}\n   345\t\t\t\t}\n   346\t\t\t\tif !found {\n   347\t\t\t\t\treturn nil, fmt.Errorf(\"attempt receipt has no reservation: %s\", e.Name())\n   348\t\t\t\t}\n   349\t\t\t}\n   350\t\t}\n   351\t\treturn out, nil\n   352\t}\n   353\tfunc (s Store) readAttemptReceipt(a DelegatedReviewAttempt, budgets ...*int64) (reviewAttemptReceipt, error) {\n   354\t\tbudget := reviewReadBudget(budgets)\n   355\t\tvar r reviewAttemptReceipt\n   356\t\tif err := readLedgerJSONBudgetIn(s.fsys(), attemptReceiptPath(s.Root, a), &r, budget); err != nil {\n   357\t\t\treturn r, fmt.Errorf(\"attempt %s incomplete or unreadable; inspect explicitly (an attempt `pose delegate ls` shows stalled is released by `pose delegate cancel %s`): %w\", a.AttemptID, a.AttemptID, err)\n   358\t\t}\n   359\t\tif r.SchemaVersion != 1 || r.AttemptID != a.AttemptID || !strings.HasPrefix(r.RunID, \"rrn-\") || strings.ContainsAny(r.RunID, \"/\\\\\") {\n   360\t\t\treturn r, fmt.Errorf(\"invalid attempt receipt %s\", a.AttemptID)\n   361\t\t}\n   362\t\tvar run ReviewRun\n   363\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, r.RunID+\".json\"), &run, budget); err != nil {\n   364\t\t\treturn r, err\n   365\t\t}\n   366\t\traw, _ := json.Marshal(run)\n   367\t\tif run.AttemptID != a.AttemptID || run.BundleID != a.BundleID || run.BundleDigest != a.BundleDigest || run.Adapter != a.Adapter || digestBytes(raw) != r.RunDigest {\n   368\t\t\treturn r, fmt.Errorf(\"attempt receipt does not bind its final run\")\n   369\t\t}\n   370\t\treturn r, nil\n   371\t}\n   372\tfunc (s Store) reviewAttemptAdmission(plan DispatchPlan) ([]DelegatedReviewAttempt, int, error) {\n   373\t\tif len(plan.Reason) > 2048 || strings.ContainsAny(plan.Reason, \"\\x00\\r\\n\") {\n   374\t\t\treturn nil, 0, fmt.Errorf(\"rerun reason must be one line of at most 2048 bytes\")\n   375\t\t}\n   420\t// prepareDelegatedReviewAttempt admits and builds the next reservation of\n   421\t// the bundle without publishing it.\n   422\tfunc (s Store) prepareDelegatedReviewAttempt(plan DispatchPlan, at time.Time) (DelegatedReviewAttempt, error) {\n   423\t\tattempts, _, err := s.reviewAttemptAdmission(plan)\n   424\t\tif err != nil {\n   425\t\t\treturn DelegatedReviewAttempt{}, err\n   426\t\t}\n   427\t\tnonce := make([]byte, 16)\n   428\t\tif _, err := rand.Read(nonce); err != nil {\n   429\t\t\treturn DelegatedReviewAttempt{}, err\n   430\t\t}\n   431\t\ta := DelegatedReviewAttempt{SchemaVersion: 1, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest, Scope: plan.Brief.Scope, Adapter: plan.Adapter, Reason: strings.TrimSpace(plan.Reason), Ordinal: len(attempts) + 1, ReservedAt: at.UTC().Format(time.RFC3339Nano), Nonce: hex.EncodeToString(nonce)}\n   432\t\ta.AttemptID = attemptIdentity(a)\n   433\t\treturn a, nil\n   434\t}\n   435\t\n   436\t// publishDelegatedReviewAttempt publishes a prepared reservation. The dispatch\n   437\t// marks the attempt active first, so a dispatch that ends after this point\n   438\t// always leaves a marker that turns stalled and that `pose delegate cancel`\n   439\t// can release (spec pose-review-run-reaps-lingering-reviewer-processes,\n   440\t// review round 1, N1).\n   441\tfunc (s Store) publishDelegatedReviewAttempt(a DelegatedReviewAttempt) error {\n   442\t\trel, _ := filepath.Rel(s.Root, reviewAttemptPath(s.Root, a))\n   443\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(rel), a); err != nil {\n   444\t\t\treturn fmt.Errorf(\"attempt reservation refused; another dispatch may hold the slot: %w\", err)\n   445\t\t}\n   446\t\treturn nil\n   447\t}\n   448\tfunc (s Store) finishDelegatedReviewAttempt(a DelegatedReviewAttempt, run ReviewRun) error {\n   449\t\traw, _ := json.Marshal(run)\n   450\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n   451\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n   452\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n   453\t}\n   454\t\n   455\t// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n   456\t// exists for legacy records; their content identity remains independently checked.\n   457\tfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n   458\t\tbudget := int64(32 << 20)\n   459\t\treturn s.reviewRunLedgerFindings(bundle, &budget)\n   460\t}\n   461\tfunc (s Store) reviewRunLedgerFindings(bundle string, budget *int64) ([]string, error) {\n   462\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, reviewRunLedgerDir)\n   463\t\tif err != nil {\n   464\t\t\treturn nil, err\n   465\t\t}\n   466\t\tfindings := []string{}\n   467\t\tvar checkedBytes int64\n   468\t\tfor _, e := range entries {\n   469\t\t\tif IsPublisherStaging(e.Name()) {\n   470\t\t\t\tcontinue\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '273,392p'; nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '265,315p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '450,530p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '273,392p'; nl -ba pose-mcp/internal/pose/delegation_release_test.go | sed -n '265,315p'; nl -ba pose-mcp/internal/pose/review_attempt_ledger.go | sed -n '450,530p'\"","aggregated_output":"   273\t// readAllReviewRuns reads, checks and orders every review run of the store.\n   274\tfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n   275\t\tfiles := s.fsys()\n   276\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n   277\t\t// The storage is read where the writer writes it: a link in its place is another place.\n   278\t\tif info, lerr := files.Lstat(dir); lerr == nil {\n   279\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n   280\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n   281\t\t\t}\n   282\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   283\t\t\treturn nil, nil, lerr\n   284\t\t}\n   285\t\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n   286\t\tif errors.Is(err, os.ErrNotExist) {\n   287\t\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n   288\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n   289\t\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   290\t\t\t\treturn nil, nil, lerr\n   291\t\t\t}\n   292\t\t\treturn []ReviewRun{}, nil, nil\n   293\t\t}\n   294\t\tif err != nil {\n   295\t\t\treturn nil, nil, err\n   296\t\t}\n   297\t\tout := []ReviewRun{}\n   298\t\tvar lost []string\n   299\t\treadBudget := int64(32 << 20)\n   300\t\tfor _, e := range entries {\n   301\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n   302\t\t\t\tcontinue\n   303\t\t\t}\n   304\t\t\tfull := filepath.Join(dir, e.Name())\n   305\t\t\tinfo, infoErr := files.Lstat(full)\n   306\t\t\tif infoErr != nil || !info.Mode().IsRegular() {\n   307\t\t\t\tlost = append(lost, e.Name()+\" (not a regular file)\")\n   308\t\t\t\tcontinue\n   309\t\t\t}\n   310\t\t\tif info.Size() < 0 || info.Size() > reviewLedgerMaxBytes {\n   311\t\t\t\tlost = append(lost, e.Name()+\" (record exceeds bound or is unreadable)\")\n   312\t\t\t\tcontinue\n   313\t\t\t}\n   314\t\t\traw, err := readLedgerRawBudgetIn(files, full, &readBudget)\n   315\t\t\tif err != nil {\n   316\t\t\t\tlost = append(lost, e.Name()+\" (\"+err.Error()+\")\")\n   317\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   318\t\t\t\t\tbreak\n   319\t\t\t\t}\n   320\t\t\t\tcontinue\n   321\t\t\t}\n   322\t\t\tvar run ReviewRun\n   323\t\t\tif json.Unmarshal(raw, &run) != nil || run.RunID == \"\" {\n   324\t\t\t\tlost = append(lost, e.Name()+\" (not a review run)\")\n   325\t\t\t\tcontinue\n   326\t\t\t}\n   327\t\t\tif verr := validateReviewRunRecord(e.Name(), run); verr != nil {\n   328\t\t\t\tlost = append(lost, e.Name()+\" (\"+verr.Error()+\")\")\n   329\t\t\t\tcontinue\n   330\t\t\t}\n   331\t\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, e.Name()))\n   332\t\t\tout = append(out, run)\n   333\t\t}\n   334\t\tsort.Slice(out, func(i, j int) bool {\n   335\t\t\ta, _ := time.Parse(time.RFC3339Nano, out[i].StartedAt)\n   336\t\t\tb, _ := time.Parse(time.RFC3339Nano, out[j].StartedAt)\n   337\t\t\tif !a.Equal(b) {\n   338\t\t\t\treturn a.Before(b)\n   339\t\t\t}\n   340\t\t\treturn out[i].RunID < out[j].RunID\n   341\t\t})\n   342\t\tsuperseded := map[string]string{}\n   343\t\tfor _, run := range out {\n   344\t\t\tif run.Supersedes != \"\" {\n   345\t\t\t\tsuperseded[run.Supersedes] = run.RunID\n   346\t\t\t}\n   347\t\t}\n   348\t\tfor i := range out {\n   349\t\t\tout[i].SupersededBy = superseded[out[i].RunID]\n   350\t\t}\n   351\t\tchecked := map[string][]DelegatedReviewAttempt{}\n   352\t\tfor _, run := range out {\n   353\t\t\tif run.LedgerVersion == 1 {\n   354\t\t\t\tif _, err := files.Lstat(filepath.Join(s.Root, reviewRunLedgerDir, run.RunID+\".json\")); err != nil {\n   355\t\t\t\t\tlost = append(lost, \"missing run witness \"+run.RunID)\n   356\t\t\t\t}\n   357\t\t\t}\n   358\t\t\tif run.AttemptID != \"\" {\n   359\t\t\t\tattempts, ok := checked[run.BundleID]\n   360\t\t\t\tif !ok {\n   361\t\t\t\t\tvar aerr error\n   362\t\t\t\t\tattempts, aerr = s.readDelegatedReviewAttempts(run.BundleID, &readBudget)\n   363\t\t\t\t\tif aerr != nil {\n   364\t\t\t\t\t\tlost = append(lost, aerr.Error())\n   365\t\t\t\t\t}\n   366\t\t\t\t\tchecked[run.BundleID] = attempts\n   367\t\t\t\t}\n   368\t\t\t\t// The reservation names the attempt's first agent; a continuation's\n   369\t\t\t\t// agent is checked against its own predecessor by the continuation\n   370\t\t\t\t// chain (a resume keeps it, a handoff changes it).\n   371\t\t\t\tfound := false\n   372\t\t\t\tfor _, a := range attempts {\n   373\t\t\t\t\tif a.AttemptID == run.AttemptID && a.BundleDigest == run.BundleDigest && a.Scope == run.Scope && (a.Adapter == run.Adapter || run.continues() != \"\") && a.Reason == run.Reason {\n   374\t\t\t\t\t\tfound = true\n   375\t\t\t\t\t\tbreak\n   376\t\t\t\t\t}\n   377\t\t\t\t}\n   378\t\t\t\tif !found {\n   379\t\t\t\t\tlost = append(lost, \"missing or conflicting attempt reservation \"+run.AttemptID)\n   380\t\t\t\t}\n   381\t\t\t}\n   382\t\t}\n   383\t\tfindings, ledgerErr := s.reviewRunLedgerFindings(\"\", &readBudget)\n   384\t\tif ledgerErr != nil {\n   385\t\t\tlost = append(lost, ledgerErr.Error())\n   386\t\t}\n   387\t\tlost = append(lost, findings...)\n   388\t\tlost = append(lost, s.reviewContinuationFindings(out)...)\n   389\t\treturn out, uniqueSorted(lost), nil\n   390\t}\n   391\t\n   392\t// DispatchPlan is what a dispatch will do.\n   265\t\t\tt.Fatalf(\"an ended holder's lock still blocks the release: %v\", err)\n   266\t\t}\n   267\t}\n   268\t\n   269\t// Review round 3, N1: a release interrupted after it recorded the run, and\n   270\t// before the receipt, completes with that run instead of recording another.\n   271\tfunc TestAnInterruptedReleaseCompletesWithItsRun(t *testing.T) {\n   272\t\tf := provenanceRunFixture(t, \"openai\", \"probe-model\")\n   273\t\tplan, err := f.store.PlanReviewDispatch(f.bundle.BundleID, \"review\", \"fixture labelled notes\", \"fake\", \"interrupted\")\n   274\t\tif err != nil {\n   275\t\t\tt.Fatal(err)\n   276\t\t}\n   277\t\tattempt := \"\"\n   278\t\tplan.OnStart = func(a string) error { attempt = a; panic(\"the dispatching process ends here\") }\n   279\t\tfunc() {\n   280\t\t\tdefer func() { _ = recover() }()\n   281\t\t\t_, _ = f.store.RunReviewDispatchContext(context.Background(), plan, time.Now)\n   282\t\t}()\n   283\t\twriteDeadMarker(t, f.store, attempt)\n   284\t\tactiveDir, _ := f.store.delegationActiveDir(false)\n   285\t\tmarkerPath := filepath.Join(activeDir, attempt+\".json\")\n   286\t\tmarkerBytes, err := os.ReadFile(markerPath)\n   287\t\tif err != nil {\n   288\t\t\tt.Fatal(err)\n   289\t\t}\n   290\t\tfirst, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   291\t\tif err != nil {\n   292\t\t\tt.Fatal(err)\n   293\t\t}\n   294\t\t// Undo the receipt and keep the marker, as a release stopped between\n   295\t\t// the run and the receipt leaves them.\n   296\t\tattempts, _ := f.store.readDelegatedReviewAttempts(f.bundle.BundleID)\n   297\t\tfor _, a := range attempts {\n   298\t\t\tif a.AttemptID == attempt {\n   299\t\t\t\tif err := os.Remove(attemptReceiptPath(f.store.Root, a)); err != nil {\n   300\t\t\t\t\tt.Fatal(err)\n   301\t\t\t\t}\n   302\t\t\t}\n   303\t\t}\n   304\t\tif err := os.WriteFile(markerPath, markerBytes, 0o600); err != nil {\n   305\t\t\tt.Fatal(err)\n   306\t\t}\n   307\t\tsecond, err := f.store.ReleaseAbandonedAttempt(attempt, time.Now(), false)\n   308\t\tif err != nil || second.RunID != first.RunID {\n   309\t\t\tt.Fatalf(\"the interrupted release recorded another run: %s then %s (%v)\", first.RunID, second.RunID, err)\n   310\t\t}\n   311\t}\n   312\t\n   313\t// Review round 2, N1: a reservation an earlier engine left with no marker is\n   314\t// listed and released once it is old enough, never while it is young.\n   315\tfunc TestAMarkerlessReservationOfAnEarlierEngineIsReleased(t *testing.T) {\n   450\t\tr := reviewAttemptReceipt{SchemaVersion: 1, AttemptID: a.AttemptID, RunID: run.RunID, RunDigest: digestBytes(raw)}\n   451\t\trel, _ := filepath.Rel(s.Root, attemptReceiptPath(s.Root, a))\n   452\t\treturn publishLedgerJSON(s.Root, filepath.ToSlash(rel), r)\n   453\t}\n   454\t\n   455\t// ReviewRunLedgerFindings detects loss using immutable witnesses. No witness\n   456\t// exists for legacy records; their content identity remains independently checked.\n   457\tfunc (s Store) ReviewRunLedgerFindings(bundle string) ([]string, error) {\n   458\t\tbudget := int64(32 << 20)\n   459\t\treturn s.reviewRunLedgerFindings(bundle, &budget)\n   460\t}\n   461\tfunc (s Store) reviewRunLedgerFindings(bundle string, budget *int64) ([]string, error) {\n   462\t\tentries, err := ledgerEntriesIn(s.fsys(), s.Root, reviewRunLedgerDir)\n   463\t\tif err != nil {\n   464\t\t\treturn nil, err\n   465\t\t}\n   466\t\tfindings := []string{}\n   467\t\tvar checkedBytes int64\n   468\t\tfor _, e := range entries {\n   469\t\t\tif IsPublisherStaging(e.Name()) {\n   470\t\t\t\tcontinue\n   471\t\t\t}\n   472\t\t\tvar w reviewRunWitness\n   473\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunLedgerDir, e.Name()), &w, budget); err != nil {\n   474\t\t\t\tfindings = append(findings, err.Error())\n   475\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n   476\t\t\t\t\tbreak\n   477\t\t\t\t}\n   478\t\t\t\tcontinue\n   479\t\t\t}\n   480\t\t\tif w.SchemaVersion != 1 || e.Name() != w.RunID+\".json\" || strings.ContainsAny(w.RunID, \"/\\\\\") {\n   481\t\t\t\tfindings = append(findings, \"invalid run witness \"+e.Name())\n   482\t\t\t\tcontinue\n   483\t\t\t}\n   484\t\t\tvar run ReviewRun\n   485\t\t\traw, readErr := readLedgerRawBudgetIn(s.fsys(), filepath.Join(s.Root, reviewRunsDir, w.RunID+\".json\"), budget)\n   486\t\t\tif readErr != nil {\n   487\t\t\t\tfindings = append(findings, \"witnessed run \"+w.RunID+\": \"+readErr.Error())\n   488\t\t\t\tif errors.Is(readErr, errReviewLedgerBudget) {\n   489\t\t\t\t\tbreak\n   490\t\t\t\t}\n   491\t\t\t\tcontinue\n   492\t\t\t}\n   493\t\t\tif err := strictJSONBytes(raw, &run); err != nil {\n   494\t\t\t\tfindings = append(findings, \"unreadable witnessed run \"+w.RunID)\n   495\t\t\t\tcontinue\n   496\t\t\t}\n   497\t\t\tif validateReviewRunRecord(w.RunID+\".json\", run) != nil || digestBytes(raw) != w.RecordDigest || run.TranscriptDigest != w.TranscriptDigest || run.BundleID != w.BundleID || run.Scope != w.Scope {\n   498\t\t\t\tfindings = append(findings, \"rewritten witnessed run \"+w.RunID)\n   499\t\t\t\tcontinue\n   500\t\t\t}\n   501\t\t\tif bundle != \"\" && run.BundleID != bundle {\n   502\t\t\t\tcontinue\n   503\t\t\t}\n   504\t\t\tinfo, statErr := s.fsys().Lstat(filepath.Join(s.Root, run.TranscriptPath))\n   505\t\t\tif statErr == nil {\n   506\t\t\t\tcheckedBytes += info.Size()\n   507\t\t\t}\n   508\t\t\tif checkedBytes > 512<<20 {\n   509\t\t\t\tfindings = append(findings, \"run transcript verification exceeds 512 MiB operation budget\")\n   510\t\t\t\tbreak\n   511\t\t\t}\n   512\t\t\tif why := s.reviewRunTranscriptIntact(run); why != \"\" {\n   513\t\t\t\tfindings = append(findings, w.RunID+\": \"+why)\n   514\t\t\t}\n   515\t\t}\n   516\t\treturn findings, nil\n   517\t}\n   518\t\n   519\ttype reviewHistoryBuffer struct{ bytes.Buffer }\n   520\t\n   521\tfunc (b *reviewHistoryBuffer) Write(p []byte) (int, error) {\n   522\t\tif b.Len()+len(p) > 8<<20 {\n   523\t\t\treturn 0, fmt.Errorf(\"review history Git output exceeds 8 MiB\")\n   524\t\t}\n   525\t\treturn b.Buffer.Write(p)\n   526\t}\n   527\tfunc reviewHistoryGit(root string, args ...string) ([]byte, error) {\n   528\t\tctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)\n   529\t\tdefer cancel()\n   530\t\tbase := gitCommand(append([]string{\"-C\", root}, args...)...)\n","exit_code":0,"status":"completed"}}
