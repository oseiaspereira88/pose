{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_tree_windows.go && nl -ba pose-mcp/internal/pose/review_tree_other.go'","aggregated_output":"     1\t//go:build windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Ending the reviewer's process tree on Windows (spec\n     6\t// pose-review-run-reaps-lingering-reviewer-processes R1, review round 13,\n     7\t// N1): the adapter starts suspended, is assigned to a job object that kills\n     8\t// every process in it when the job is terminated or its last handle closes,\n     9\t// and only then resumes, so no descendant can start outside the job. The\n    10\t// dispatch terminates the job after the run, on a timeout, and, through the\n    11\t// kill-on-close limit, when the dispatching process ends.\n    12\t\n    13\timport (\n    14\t\t\"fmt\"\n    15\t\t\"os/exec\"\n    16\t\t\"sync\"\n    17\t\t\"syscall\"\n    18\t\t\"time\"\n    19\t\t\"unsafe\"\n    20\t\n    21\t\t\"golang.org/x/sys/windows\"\n    22\t)\n    23\t\n    24\tvar reviewJobs sync.Map // *exec.Cmd -> windows.Handle\n    25\t\n    26\t// jobBasicAccounting is JOBOBJECT_BASIC_ACCOUNTING_INFORMATION.\n    27\ttype jobBasicAccounting struct {\n    28\t\tTotalUserTime             int64\n    29\t\tTotalKernelTime           int64\n    30\t\tThisPeriodTotalUserTime   int64\n    31\t\tThisPeriodTotalKernelTime int64\n    32\t\tTotalPageFaultCount       uint32\n    33\t\tTotalProcesses            uint32\n    34\t\tActiveProcesses           uint32\n    35\t\tTotalTerminatedProcesses  uint32\n    36\t}\n    37\t\n    38\t// prepareReviewProcessTree makes cmd start suspended, so it can be placed in\n    39\t// its job before it runs.\n    40\tfunc prepareReviewProcessTree(cmd *exec.Cmd) {\n    41\t\tif cmd.SysProcAttr == nil {\n    42\t\t\tcmd.SysProcAttr = &syscall.SysProcAttr{}\n    43\t\t}\n    44\t\tcmd.SysProcAttr.CreationFlags |= windows.CREATE_SUSPENDED\n    45\t\tcmd.Cancel = func() error { return terminateReviewJob(cmd) }\n    46\t}\n    47\t\n    48\t// attachReviewProcessTree places the started, suspended process in a new\n    49\t// kill-on-close job and resumes it. A process that cannot be placed is\n    50\t// terminated: it never runs outside the job.\n    51\tfunc attachReviewProcessTree(cmd *exec.Cmd) error {\n    52\t\tjob, err := windows.CreateJobObject(nil, nil)\n    53\t\tif err != nil {\n    54\t\t\t_ = cmd.Process.Kill()\n    55\t\t\treturn fmt.Errorf(\"the reviewer's job object could not be created: %w\", err)\n    56\t\t}\n    57\t\tinfo := windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION{}\n    58\t\tinfo.BasicLimitInformation.LimitFlags = windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE\n    59\t\tif _, err := windows.SetInformationJobObject(job, windows.JobObjectExtendedLimitInformation, uintptr(unsafe.Pointer(&info)), uint32(unsafe.Sizeof(info))); err != nil {\n    60\t\t\t_ = windows.CloseHandle(job)\n    61\t\t\t_ = cmd.Process.Kill()\n    62\t\t\treturn fmt.Errorf(\"the reviewer's job object could not be limited: %w\", err)\n    63\t\t}\n    64\t\tprocess, err := windows.OpenProcess(windows.PROCESS_SET_QUOTA|windows.PROCESS_TERMINATE, false, uint32(cmd.Process.Pid))\n    65\t\tif err != nil {\n    66\t\t\t_ = windows.CloseHandle(job)\n    67\t\t\t_ = cmd.Process.Kill()\n    68\t\t\treturn fmt.Errorf(\"the reviewer's process could not be opened: %w\", err)\n    69\t\t}\n    70\t\tdefer windows.CloseHandle(process)\n    71\t\tif err := windows.AssignProcessToJobObject(job, process); err != nil {\n    72\t\t\t_ = windows.CloseHandle(job)\n    73\t\t\t_ = cmd.Process.Kill()\n    74\t\t\treturn fmt.Errorf(\"the reviewer's process could not join its job: %w\", err)\n    75\t\t}\n    76\t\treviewJobs.Store(cmd, job)\n    77\t\tif err := resumeProcessThreads(uint32(cmd.Process.Pid)); err != nil {\n    78\t\t\t_ = terminateReviewJob(cmd)\n    79\t\t\treturn fmt.Errorf(\"the reviewer's process could not be resumed: %w\", err)\n    80\t\t}\n    81\t\treturn nil\n    82\t}\n    83\t\n    84\t// resumeProcessThreads resumes every thread of pid; a suspended process has\n    85\t// only its main thread.\n    86\tfunc resumeProcessThreads(pid uint32) error {\n    87\t\tsnapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPTHREAD, 0)\n    88\t\tif err != nil {\n    89\t\t\treturn err\n    90\t\t}\n    91\t\tdefer windows.CloseHandle(snapshot)\n    92\t\tentry := windows.ThreadEntry32{Size: uint32(unsafe.Sizeof(windows.ThreadEntry32{}))}\n    93\t\tresumed := 0\n    94\t\tfor err = windows.Thread32First(snapshot, &entry); err == nil; err = windows.Thread32Next(snapshot, &entry) {\n    95\t\t\tif entry.OwnerProcessID != pid {\n    96\t\t\t\tcontinue\n    97\t\t\t}\n    98\t\t\tthread, err := windows.OpenThread(windows.THREAD_SUSPEND_RESUME, false, entry.ThreadID)\n    99\t\t\tif err != nil {\n   100\t\t\t\treturn err\n   101\t\t\t}\n   102\t\t\t_, rerr := windows.ResumeThread(thread)\n   103\t\t\t_ = windows.CloseHandle(thread)\n   104\t\t\tif rerr != nil {\n   105\t\t\t\treturn rerr\n   106\t\t\t}\n   107\t\t\tresumed++\n   108\t\t}\n   109\t\tif resumed == 0 {\n   110\t\t\treturn fmt.Errorf(\"no thread of process %d was found\", pid)\n   111\t\t}\n   112\t\treturn nil\n   113\t}\n   114\t\n   115\t// terminateReviewJob ends every process of cmd's job and waits until the job\n   116\t// is empty.\n   117\tfunc terminateReviewJob(cmd *exec.Cmd) error {\n   118\t\tvalue, ok := reviewJobs.Load(cmd)\n   119\t\tif !ok {\n   120\t\t\tif cmd.Process != nil {\n   121\t\t\t\treturn cmd.Process.Kill()\n   122\t\t\t}\n   123\t\t\treturn nil\n   124\t\t}\n   125\t\tjob := value.(windows.Handle)\n   126\t\tif err := windows.TerminateJobObject(job, 1); err != nil {\n   127\t\t\treturn fmt.Errorf(\"the reviewer's job could not be terminated: %w\", err)\n   128\t\t}\n   129\t\tdeadline := time.Now().Add(reviewReapWait)\n   130\t\tfor {\n   131\t\t\tvar acct jobBasicAccounting\n   132\t\t\tif err := windows.QueryInformationJobObject(job, windows.JobObjectBasicAccountingInformation, uintptr(unsafe.Pointer(&acct)), uint32(unsafe.Sizeof(acct)), nil); err != nil {\n   133\t\t\t\treturn fmt.Errorf(\"the reviewer's job could not be inspected: %w\", err)\n   134\t\t\t}\n   135\t\t\tif acct.ActiveProcesses == 0 {\n   136\t\t\t\treturn nil\n   137\t\t\t}\n   138\t\t\tif time.Now().After(deadline) {\n   139\t\t\t\treturn fmt.Errorf(\"%d process(es) of the reviewer's job could not be ended\", acct.ActiveProcesses)\n   140\t\t\t}\n   141\t\t\ttime.Sleep(20 * time.Millisecond)\n   142\t\t}\n   143\t}\n   144\t\n   145\t// releaseReviewProcessTree terminates the job and closes its handle.\n   146\tfunc releaseReviewProcessTree(cmd *exec.Cmd) error {\n   147\t\terr := terminateReviewJob(cmd)\n   148\t\tif value, ok := reviewJobs.LoadAndDelete(cmd); ok {\n   149\t\t\t_ = windows.CloseHandle(value.(windows.Handle))\n   150\t\t}\n   151\t\treturn err\n   152\t}\n     1\t//go:build !windows\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport \"os/exec\"\n     6\t\n     7\t// On Unix the process group, and on Linux the review run shim, end the\n     8\t// reviewer's tree; these are the Windows job object's hooks.\n     9\tfunc prepareReviewProcessTree(*exec.Cmd)       {}\n    10\tfunc attachReviewProcessTree(*exec.Cmd) error  { return nil }\n    11\tfunc releaseReviewProcessTree(*exec.Cmd) error { return nil }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '1,300p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Delegated review dispatch (spec pose-delegated-review-dispatch, roadmap\n     4\t// delegated-review).\n     5\t//\n     6\t// A run hands the brief of a sealed bundle to a configured reviewer command —\n     7\t// another vendor's agent, typically — on a disposable worktree at the sealed\n     8\t// commit, and records what happened. It never records an attestation: turning\n     9\t// a run's conclusion into one is the engine's verified step (spec\n    10\t// pose-delegated-review-capability). A run that changed files, exceeded its\n    11\t// time or budget, or failed is recorded as failed, never as a review.\n    12\t\n    13\timport (\n    14\t\t\"bytes\"\n    15\t\t\"context\"\n    16\t\t\"crypto/sha256\"\n    17\t\t\"encoding/hex\"\n    18\t\t\"encoding/json\"\n    19\t\t\"errors\"\n    20\t\t\"fmt\"\n    21\t\t\"io\"\n    22\t\t\"os\"\n    23\t\t\"os/exec\"\n    24\t\t\"path/filepath\"\n    25\t\t\"reflect\"\n    26\t\t\"runtime\"\n    27\t\t\"sort\"\n    28\t\t\"strings\"\n    29\t\t\"sync/atomic\"\n    30\t\t\"time\"\n    31\t\t\"unicode/utf8\"\n    32\t)\n    33\t\n    34\t// beforeRunResultPublished is a test seam called with a run just before its\n    35\t// attempt result is published (spec pose-delegation-result-before-marker).\n    36\tvar beforeRunResultPublished = func(ReviewRun) {}\n    37\t\n    38\t// AdapterPipeGrace is how long a finished or killed adapter's children may\n    39\t// hold its pipes before they are released. Tests that exercise a lingering\n    40\t// child shorten it (spec pose-cli-test-wall-time R1).\n    41\tvar AdapterPipeGrace = 5 * time.Second\n    42\t\n    43\t// ReviewersPolicySchemaVersion versions .pose/policy/reviewers.json.\n    44\tconst ReviewersPolicySchemaVersion = 1\n    45\t\n    46\tconst reviewRunsDir = \".pose/review-runs\"\n    47\t\n    48\t// ReviewerAdapter is one configured reviewer command.\n    49\ttype ReviewerAdapter struct {\n    50\t\tContainment *ReviewerContainment `json:\"containment,omitempty\"`\n    51\t\t// Command is the argv; \"{output}\" is replaced by a file the reviewer may\n    52\t\t// write its final message to. The brief arrives on stdin and the working\n    53\t\t// directory is the disposable worktree.\n    54\t\tExecutor         string           `json:\"executor,omitempty\"`\n    55\t\tCommand          []string         `json:\"command\"`\n    56\t\tVendor           string           `json:\"vendor\"`\n    57\t\tModel            string           `json:\"model\"`\n    58\t\tTimeout          string           `json:\"timeout,omitempty\"`\n    59\t\tMaxRunsPerBundle int              `json:\"max_runs_per_bundle,omitempty\"`\n    60\t\tLimit            *ReviewerLimit   `json:\"limit,omitempty\"`\n    61\t\tSession          *ReviewerSession `json:\"session,omitempty\"`\n    62\t\tResume           *ReviewerResume  `json:\"resume,omitempty\"`\n    63\t\t// Events and Effort come from a delegation.json agent (schema 2); a\n    64\t\t// schema 1 adapter has neither, so its projection is unchanged.\n    65\t\tEvents string          `json:\"events,omitempty\"`\n    66\t\tEffort *ReviewerEffort `json:\"effort,omitempty\"`\n    67\t}\n    68\t\n    69\t// ReviewersPolicy is .pose/policy/reviewers.json.\n    70\ttype ReviewersPolicy struct {\n    71\t\tProvenance    *ReviewRunProvenancePolicy `json:\"provenance,omitempty\"`\n    72\t\tSchemaVersion int                        `json:\"schema_version\"`\n    73\t\tAdapters      map[string]ReviewerAdapter `json:\"adapters\"`\n    74\t}\n    75\t\n    76\t// ExampleReviewersPolicy is what POSE suggests and never enables by itself.\n    77\tfunc ExampleReviewersPolicy() ReviewersPolicy {\n    78\t\treturn ReviewersPolicy{SchemaVersion: ReviewersPolicySchemaVersion, Adapters: map[string]ReviewerAdapter{\n    79\t\t\t\"codex\": {Command: []string{\"codex\", \"exec\", \"-m\", \"gpt-6.1-sol\", \"-c\", `model_reasoning_effort=\"medium\"`, \"-s\", \"read-only\", \"--skip-git-repo-check\", \"-o\", \"{output}\", \"-\"},\n    80\t\t\t\tVendor: \"openai\", Model: \"gpt-6.1-sol\", Timeout: \"60m\", MaxRunsPerBundle: 3},\n    81\t\t\t\"claude\": {Command: []string{\"claude\", \"-p\", \"--model\", \"claude-opus-5-5\", \"--permission-mode\", \"plan\"},\n    82\t\t\t\tVendor: \"anthropic\", Model: \"claude-opus-5-5\", Timeout: \"60m\", MaxRunsPerBundle: 3},\n    83\t\t}}\n    84\t}\n    85\t\n    86\t// LoadReviewersPolicy reads the adapters of the review purpose; an absent\n    87\t// policy means none.\n    88\tfunc (s Store) LoadReviewersPolicy() (ReviewersPolicy, bool, error) {\n    89\t\treturn s.LoadReviewersPolicyFor(\"review\")\n    90\t}\n    91\t\n    92\t// LoadReviewersPolicyFor reads the adapters for the purpose that runs a brief\n    93\t// of kind: delegation.json (schema 2) projected for that purpose, or\n    94\t// reviewers.json (schema 1) through the same conversion.\n    95\tfunc (s Store) LoadReviewersPolicyFor(kind string) (ReviewersPolicy, bool, error) {\n    96\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n    97\t\tif err != nil || !found {\n    98\t\t\treturn ReviewersPolicy{}, false, err\n    99\t\t}\n   100\t\treturn policy.reviewersView(DelegationPurposeForKind(kind)), true, nil\n   101\t}\n   102\t\n   103\t// activeDelegationPolicyPath is the policy file the engine reads now.\n   104\tfunc (s Store) activeDelegationPolicyPath() string {\n   105\t\tif _, err := os.Lstat(filepath.Join(s.Root, filepath.FromSlash(delegationPolicyPath))); err == nil {\n   106\t\t\treturn delegationPolicyPath\n   107\t\t}\n   108\t\treturn reviewersPolicyPath\n   109\t}\n   110\t\n   111\tfunc parseReviewersPolicy(raw []byte) (ReviewersPolicy, error) {\n   112\t\tvar policy ReviewersPolicy\n   113\t\tif err := json.Unmarshal(raw, &policy); err != nil {\n   114\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: invalid .pose/policy/reviewers.json: %w\", err)\n   115\t\t}\n   116\t\tif policy.SchemaVersion != ReviewersPolicySchemaVersion {\n   117\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: .pose/policy/reviewers.json schema_version %d is not supported\", policy.SchemaVersion)\n   118\t\t}\n   119\t\tif err := validateExplicitReviewBudget(raw); err != nil {\n   120\t\t\treturn ReviewersPolicy{}, err\n   121\t\t}\n   122\t\tif err := validateRunProvenancePolicy(policy); err != nil {\n   123\t\t\treturn ReviewersPolicy{}, err\n   124\t\t}\n   125\t\tfor name, adapter := range policy.Adapters {\n   126\t\t\tif adapter.Events != \"\" || adapter.Effort != nil {\n   127\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s: events and effort are delegation.json fields\", name)\n   128\t\t\t}\n   129\t\t\tif _, err := ResolveReviewerContainment(adapter); err != nil {\n   130\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"adapter %s: %w\", name, err)\n   131\t\t\t}\n   132\t\t\tif err := validateContinuityAdapter(adapter); err != nil {\n   133\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s: %w\", name, err)\n   134\t\t\t}\n   135\t\t\tif len(adapter.Command) == 0 || adapter.Vendor == \"\" || adapter.Model == \"\" {\n   136\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s needs command, vendor and model\", name)\n   137\t\t\t}\n   138\t\t\tif adapter.Timeout != \"\" {\n   139\t\t\t\tif _, err := time.ParseDuration(adapter.Timeout); err != nil {\n   140\t\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s timeout: %w\", name, err)\n   141\t\t\t\t}\n   142\t\t\t}\n   143\t\t}\n   144\t\treturn policy, nil\n   145\t}\n   146\t\n   147\t// ReviewRun is one recorded dispatch.\n   148\ttype ReviewRun struct {\n   149\t\tSafety              *ReviewExecutionSafety `json:\"safety,omitempty\"`\n   150\t\tProvenance          *ReviewRunProvenance   `json:\"provenance,omitempty\"`\n   151\t\tsessionForRedaction string\n   152\t\teventsBytes         []byte\n   153\t\tResumes             string `json:\"resumes,omitempty\"`\n   154\t\t// ResumesSession marks a task that continued a session POSE never\n   155\t\t// recorded, named by its caller (spec pose-delegation-parity-gate SA-07).\n   156\t\tResumesSession bool `json:\"resumes_session,omitempty\"`\n   157\t\t// HandsOffFrom names the run this one continues with another agent, and\n   158\t\t// HandoffDigest the section its brief added (spec\n   159\t\t// pose-delegation-handoff R4, R5).\n   160\t\tHandsOffFrom  string `json:\"hands_off_from,omitempty\"`\n   161\t\tHandoffDigest string `json:\"handoff_digest,omitempty\"`\n   162\t\t// HandoffRenderer is the version of the renderer that listed the\n   163\t\t// predecessor's commands in the section; absent on runs recorded before it.\n   164\t\tHandoffRenderer  int                 `json:\"handoff_renderer,omitempty\"`\n   165\t\tInterruption     *ReviewInterruption `json:\"interruption,omitempty\"`\n   166\t\tSessionDigest    string              `json:\"session_digest,omitempty\"`\n   167\t\tTreeDigest       string              `json:\"tree_digest,omitempty\"`\n   168\t\tBriefNotes       string              `json:\"brief_notes,omitempty\"`\n   169\t\tPartialDigest    string              `json:\"partial_digest,omitempty\"`\n   170\t\tLimitOf          string              `json:\"limit_of,omitempty\"`\n   171\t\tLedgerVersion    int                 `json:\"ledger_version,omitempty\"`\n   172\t\tAttemptID        string              `json:\"attempt_id,omitempty\"`\n   173\t\tReason           string              `json:\"reason,omitempty\"`\n   174\t\tSchemaVersion    int                 `json:\"schema_version\"`\n   175\t\tRunID            string              `json:\"run_id\"`\n   176\t\tScope            string              `json:\"scope\"`\n   177\t\tBundleID         string              `json:\"bundle_id\"`\n   178\t\tBundleDigest     string              `json:\"bundle_digest\"`\n   179\t\tSealedCommit     string              `json:\"sealed_commit\"`\n   180\t\tKind             string              `json:\"kind\"`\n   181\t\tBriefDigest      string              `json:\"brief_digest\"`\n   182\t\tAdapter          string              `json:\"adapter\"`\n   183\t\tVendor           string              `json:\"vendor\"`\n   184\t\tModel            string              `json:\"model\"`\n   185\t\tStartedAt        string              `json:\"started_at\"`\n   186\t\tEndedAt          string              `json:\"ended_at\"`\n   187\t\tExitCode         int                 `json:\"exit_code\"`\n   188\t\tStatus           string              `json:\"status\"`\n   189\t\tFailure          string              `json:\"failure,omitempty\"`\n   190\t\tTranscriptDigest string              `json:\"transcript_digest\"`\n   191\t\tTranscriptPath   string              `json:\"transcript_path\"`\n   192\t\tOutput           string              `json:\"output\"`\n   193\t\tPolicyDigest     string              `json:\"policy_digest,omitempty\"`\n   194\t\tSupersedes       string              `json:\"supersedes,omitempty\"`\n   195\t\t// Label, Purpose and Lead are given by pose delegate; EnvRemoved names the\n   196\t\t// parent session variables the child did not receive (never their values);\n   197\t\t// Events and EventsDigest bind the normalized event stream kept beside\n   198\t\t// the transcript (spec pose-delegation-surface R8, R9, R11).\n   199\t\tLabel        string   `json:\"label,omitempty\"`\n   200\t\tPurpose      string   `json:\"purpose,omitempty\"`\n   201\t\tLead         string   `json:\"lead,omitempty\"`\n   202\t\tEnvRemoved   []string `json:\"env_removed,omitempty\"`\n   203\t\tEvents       string   `json:\"events,omitempty\"`\n   204\t\tEventsDigest string   `json:\"events_digest,omitempty\"`\n   205\t\tSupersededBy string   `json:\"superseded_by,omitempty\"`\n   206\t\t// Routing is how the run's agent was chosen and IndependenceAchieved what\n   207\t\t// it achieved against the implementation (spec pose-delegation-routing R8).\n   208\t\tRouting              *DelegationRoutingRecord `json:\"routing,omitempty\"`\n   209\t\tIndependenceAchieved string                   `json:\"independence_achieved,omitempty\"`\n   210\t\t// A task run (spec pose-delegation-task) records the access it ran with,\n   211\t\t// its directory and flags, the argv it ran, and the digests of the prompt\n   212\t\t// and the error stream kept beside its record; Recorded is --record.\n   213\t\tAccess       string   `json:\"access,omitempty\"`\n   214\t\tDir          string   `json:\"dir,omitempty\"`\n   215\t\tAddDirs      []string `json:\"add_dirs,omitempty\"`\n   216\t\tNoNetwork    bool     `json:\"no_network,omitempty\"`\n   217\t\tRecorded     bool     `json:\"recorded,omitempty\"`\n   218\t\tArgv         []string `json:\"argv,omitempty\"`\n   219\t\tPromptDigest string   `json:\"prompt_digest,omitempty\"`\n   220\t\tEffort       string   `json:\"effort,omitempty\"`\n   221\t\tStderrDigest string   `json:\"stderr_digest,omitempty\"`\n   222\t\t// Round is the round of the scope the run reviewed, DraftProblems what\n   223\t\t// keeps its draft from counting for that round, and Thread how its session\n   224\t\t// relates to the previous round's (spec\n   225\t\t// pose-delegated-review-round-protocol R1, R4, R6).\n   226\t\tRound         int           `json:\"round,omitempty\"`\n   227\t\tDraftProblems []string      `json:\"draft_problems,omitempty\"`\n   228\t\tThread        *ReviewThread `json:\"thread,omitempty\"`\n   229\t\tPath          string        `json:\"-\"`\n   230\t\t// eventsDir is where a task run's files are; a review run's are in\n   231\t\t// reviewRunsDir.\n   232\t\teventsDir string\n   233\t}\n   234\t\n   235\t// Review run states.\n   236\tconst (\n   237\t\tReviewRunCompleted   = \"completed\"\n   238\t\tReviewRunFailed      = \"failed\"\n   239\t\tReviewRunInterrupted = \"interrupted\"\n   240\t\tReviewRunStale       = \"stale\"\n   241\t)\n   242\t\n   243\t// ListReviewRuns returns the recorded runs for bundleID (\"\" for all).\n   244\tfunc (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n   245\t\truns, _, err := s.ReadReviewRuns(bundleID)\n   246\t\treturn runs, err\n   247\t}\n   248\t\n   249\tfunc (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n   250\t\t// Within a read-view operation the ledger is read and checked once per\n   251\t\t// root; every request of the operation is answered from that read,\n   252\t\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n   253\t\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n   254\t\t\truns, lost, err := s.readAllReviewRuns()\n   255\t\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n   256\t\t})\n   257\t\tif err != nil {\n   258\t\t\treturn nil, nil, err\n   259\t\t}\n   260\t\tout := copyReviewRuns(all.runs)\n   261\t\tif bundleID != \"\" {\n   262\t\t\tfiltered := []ReviewRun{}\n   263\t\t\tfor _, run := range out {\n   264\t\t\t\tif run.BundleID == bundleID {\n   265\t\t\t\t\tfiltered = append(filtered, run)\n   266\t\t\t\t}\n   267\t\t\t}\n   268\t\t\tout = filtered\n   269\t\t}\n   270\t\treturn out, deepCopyValue(all.lost), nil\n   271\t}\n   272\t\n   273\t// readAllReviewRuns reads, checks and orders every review run of the store.\n   274\tfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n   275\t\tfiles := s.fsys()\n   276\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n   277\t\t// The storage is read where the writer writes it: a link in its place is another place.\n   278\t\tif info, lerr := files.Lstat(dir); lerr == nil {\n   279\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n   280\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n   281\t\t\t}\n   282\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   283\t\t\treturn nil, nil, lerr\n   284\t\t}\n   285\t\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n   286\t\tif errors.Is(err, os.ErrNotExist) {\n   287\t\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n   288\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n   289\t\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n   290\t\t\t\treturn nil, nil, lerr\n   291\t\t\t}\n   292\t\t\treturn []ReviewRun{}, nil, nil\n   293\t\t}\n   294\t\tif err != nil {\n   295\t\t\treturn nil, nil, err\n   296\t\t}\n   297\t\tout := []ReviewRun{}\n   298\t\tvar lost []string\n   299\t\treadBudget := int64(32 << 20)\n   300\t\tfor _, e := range entries {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/review_reap_linux.go && nl -ba pose-mcp/internal/pose/review_reap_other.go'","aggregated_output":"     1\t//go:build linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\t// Leftover reviewer processes, the fallback of an embedder that does not run\n     6\t// the adapter under the review run shim (review_shim.go), which is the Linux\n     7\t// path of the pose command (spec\n     8\t// pose-review-run-reaps-lingering-reviewer-processes R1, L6): an adapter such as\n     9\t// `codex exec` runs each command in a session of its own, so killing the\n    10\t// adapter's process group misses a command the reviewer left running, and\n    11\t// that command keeps writing into the run's runtime directory while the\n    12\t// cleanup inventory reads it. Every process of the run inherits\n    13\t// SealedCheckoutEnv naming the run's checkout, so the dispatch finds them by\n    14\t// that entry, ends them and waits for them before the inventory.\n    15\t//\n    16\t// Each process is pinned by a pidfd before it is signalled, and its\n    17\t// environment is read again through the pinned process, so a pid reused by\n    18\t// an unrelated process between the scan and the signal is never killed\n    19\t// (review round 1, N3). A scan that cannot list or read the state of the\n    20\t// processes fails. A process of this user whose environment cannot be read\n    21\t// (one that made itself non-inspectable) cannot be matched: one that already\n    22\t// existed before the adapter started is not the run's and is skipped; any\n    23\t// other may be the run's, so the scan fails and the run stays unconcludable\n    24\t// (review round 2, N2).\n    25\t\n    26\timport (\n    27\t\t\"bytes\"\n    28\t\t\"errors\"\n    29\t\t\"fmt\"\n    30\t\t\"io/fs\"\n    31\t\t\"os\"\n    32\t\t\"path/filepath\"\n    33\t\t\"strconv\"\n    34\t\t\"strings\"\n    35\t\t\"syscall\"\n    36\t\t\"time\"\n    37\t\n    38\t\t\"golang.org/x/sys/unix\"\n    39\t)\n    40\t\n    41\t// reapSealedCheckoutProcesses ends every process whose environment names\n    42\t// worktree as its sealed checkout and returns a description of each. An\n    43\t// error means the run's processes could not be proven ended within the bound.\n    44\tfunc reapSealedCheckoutProcesses(worktree string, baseline map[int]string) ([]string, int, error) {\n    45\t\tif worktree == \"\" {\n    46\t\t\treturn nil, 0, nil\n    47\t\t}\n    48\t\tentry := []byte(SealedCheckoutEnv + \"=\" + worktree)\n    49\t\tvar reaped []string\n    50\t\tseen := map[int]bool{}\n    51\t\tdeadline := time.Now().Add(reviewReapWait)\n    52\t\tunreadable := 0\n    53\t\tfor {\n    54\t\t\talive, opaque, err := reviewMarkedProcesses(entry)\n    55\t\t\tif err != nil {\n    56\t\t\t\treturn reaped, unreadable, err\n    57\t\t\t}\n    58\t\t\tunreadable = 0\n    59\t\t\tfor pid, start := range opaque {\n    60\t\t\t\tif prior, ok := baseline[pid]; !ok || prior != start {\n    61\t\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"process %d of this user started during the run and cannot be inspected; it may be the run's and was not ended\", pid)\n    62\t\t\t\t}\n    63\t\t\t\tunreadable++\n    64\t\t\t}\n    65\t\t\tfor _, pid := range alive {\n    66\t\t\t\tif !seen[pid] {\n    67\t\t\t\t\tseen[pid] = true\n    68\t\t\t\t\t// Only the pid: the name is the reviewer's to choose and is not\n    69\t\t\t\t\t// recorded (review round 7, N4).\n    70\t\t\t\t\treaped = append(reaped, strconv.Itoa(pid))\n    71\t\t\t\t}\n    72\t\t\t\tif err := killPinnedMarkedProcess(pid, entry); err != nil {\n    73\t\t\t\t\treturn reaped, unreadable, err\n    74\t\t\t\t}\n    75\t\t\t}\n    76\t\t\tif len(alive) == 0 {\n    77\t\t\t\treturn reaped, unreadable, nil\n    78\t\t\t}\n    79\t\t\tif time.Now().After(deadline) {\n    80\t\t\t\treturn reaped, unreadable, fmt.Errorf(\"%d process(es) of the run could not be ended\", len(alive))\n    81\t\t\t}\n    82\t\t\ttime.Sleep(50 * time.Millisecond)\n    83\t\t}\n    84\t}\n    85\t\n    86\t// reviewMarkedProcesses lists the live processes whose environment holds\n    87\t// entry, and counts this user's processes whose environment could not be\n    88\t// read. A process that is gone is skipped.\n    89\tfunc reviewMarkedProcesses(entry []byte) ([]int, map[int]string, error) {\n    90\t\tdirs, err := os.ReadDir(\"/proc\")\n    91\t\tif err != nil {\n    92\t\t\treturn nil, nil, fmt.Errorf(\"the run's processes could not be listed: %w\", err)\n    93\t\t}\n    94\t\tunreadable := map[int]string{}\n    95\t\tself, uid := os.Getpid(), os.Getuid()\n    96\t\tvar out []int\n    97\t\tfor _, d := range dirs {\n    98\t\t\tpid, err := strconv.Atoi(d.Name())\n    99\t\t\tif err != nil || pid == self {\n   100\t\t\t\tcontinue\n   101\t\t\t}\n   102\t\t\tmarked, err := reviewProcessMarked(pid, entry)\n   103\t\t\tswitch {\n   104\t\t\tcase reviewProcessGoneErr(err):\n   105\t\t\t\tcontinue\n   106\t\t\tcase err != nil:\n   107\t\t\t\tif owner, oerr := reviewProcessOwner(pid); oerr == nil && owner != uid {\n   108\t\t\t\t\tcontinue // another user's process never inherits this run's environment\n   109\t\t\t\t} else if reviewProcessGoneErr(oerr) {\n   110\t\t\t\t\tcontinue\n   111\t\t\t\t}\n   112\t\t\t\tstart, serr := processStartTime(pid)\n   113\t\t\t\tif reviewProcessGoneErr(serr) {\n   114\t\t\t\t\tcontinue\n   115\t\t\t\t}\n   116\t\t\t\tif serr != nil || start == \"\" {\n   117\t\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d start could not be read: %v\", pid, serr)\n   118\t\t\t\t}\n   119\t\t\t\tunreadable[pid] = start\n   120\t\t\t\tcontinue\n   121\t\t\tcase !marked:\n   122\t\t\t\tcontinue\n   123\t\t\t}\n   124\t\t\tzombie, err := reviewProcessZombie(pid)\n   125\t\t\tif reviewProcessGoneErr(err) || err == nil && zombie {\n   126\t\t\t\tcontinue\n   127\t\t\t}\n   128\t\t\tif err != nil {\n   129\t\t\t\treturn nil, unreadable, fmt.Errorf(\"process %d state could not be read: %w\", pid, err)\n   130\t\t\t}\n   131\t\t\tout = append(out, pid)\n   132\t\t}\n   133\t\treturn out, unreadable, nil\n   134\t}\n   135\t\n   136\t// killPinnedMarkedProcess signals pid only through a pidfd opened on it,\n   137\t// after the environment read through that same pinned process still holds\n   138\t// entry.\n   139\tfunc killPinnedMarkedProcess(pid int, entry []byte) error {\n   140\t\tfd, err := unix.PidfdOpen(pid, 0)\n   141\t\tif errors.Is(err, unix.ESRCH) {\n   142\t\t\treturn nil\n   143\t\t}\n   144\t\tif err != nil {\n   145\t\t\treturn fmt.Errorf(\"process %d could not be pinned: %w\", pid, err)\n   146\t\t}\n   147\t\tdefer unix.Close(fd)\n   148\t\t// The pidfd names one process for its lifetime; if pid was reused before\n   149\t\t// it was opened, the new process does not carry this run's entry.\n   150\t\tmarked, err := reviewProcessMarked(pid, entry)\n   151\t\tif reviewProcessGoneErr(err) || err == nil && !marked {\n   152\t\t\treturn nil\n   153\t\t}\n   154\t\tif err != nil {\n   155\t\t\treturn fmt.Errorf(\"process %d could not be inspected: %w\", pid, err)\n   156\t\t}\n   157\t\tif err := unix.PidfdSendSignal(fd, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {\n   158\t\t\treturn fmt.Errorf(\"process %d could not be ended: %w\", pid, err)\n   159\t\t}\n   160\t\treturn nil\n   161\t}\n   162\t\n   163\tfunc reviewProcessMarked(pid int, entry []byte) (bool, error) {\n   164\t\tenviron, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"environ\"))\n   165\t\tif err != nil {\n   166\t\t\treturn false, err\n   167\t\t}\n   168\t\tfor _, kv := range bytes.Split(environ, []byte{0}) {\n   169\t\t\tif bytes.Equal(kv, entry) {\n   170\t\t\t\treturn true, nil\n   171\t\t\t}\n   172\t\t}\n   173\t\treturn false, nil\n   174\t}\n   175\t\n   176\tfunc reviewProcessOwner(pid int) (int, error) {\n   177\t\tinfo, err := os.Stat(filepath.Join(\"/proc\", strconv.Itoa(pid)))\n   178\t\tif err != nil {\n   179\t\t\treturn 0, err\n   180\t\t}\n   181\t\tst, ok := info.Sys().(*syscall.Stat_t)\n   182\t\tif !ok {\n   183\t\t\treturn 0, fmt.Errorf(\"process %d owner unavailable\", pid)\n   184\t\t}\n   185\t\treturn int(st.Uid), nil\n   186\t}\n   187\t\n   188\tfunc reviewProcessGoneErr(err error) bool {\n   189\t\treturn errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ESRCH)\n   190\t}\n   191\t\n   192\tfunc reviewProcessName(pid int) string {\n   193\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"comm\"))\n   194\t\tif err != nil {\n   195\t\t\treturn \"?\"\n   196\t\t}\n   197\t\treturn strings.TrimSpace(string(raw))\n   198\t}\n   199\t\n   200\tfunc reviewProcessZombie(pid int) (bool, error) {\n   201\t\traw, err := os.ReadFile(filepath.Join(\"/proc\", strconv.Itoa(pid), \"stat\"))\n   202\t\tif err != nil {\n   203\t\t\treturn false, err\n   204\t\t}\n   205\t\t// The state follows the parenthesised command name.\n   206\t\tif i := bytes.LastIndexByte(raw, ')'); i >= 0 && i+2 < len(raw) {\n   207\t\t\treturn raw[i+2] == 'Z', nil\n   208\t\t}\n   209\t\treturn false, fmt.Errorf(\"process %d state is unreadable\", pid)\n   210\t}\n   211\t\n   212\t// reviewOpaqueProcessBaseline records, before the adapter starts, the\n   213\t// processes of this user whose environment cannot be read, by pid and start\n   214\t// time: they cannot be the run's.\n   215\tfunc reviewOpaqueProcessBaseline() map[int]string {\n   216\t\t_, opaque, _ := reviewMarkedProcesses([]byte(SealedCheckoutEnv + \"=\\x00\"))\n   217\t\treturn opaque\n   218\t}\n     1\t//go:build !linux\n     2\t\n     3\tpackage pose\n     4\t\n     5\timport \"os/exec\"\n     6\t\n     7\t// reapSealedCheckoutProcesses has no portable way to read another process's\n     8\t// environment; outside Linux the process-group kill is the only termination.\n     9\tfunc reapSealedCheckoutProcesses(string, map[int]string) ([]string, int, error) { return nil, 0, nil }\n    10\t\n    11\tfunc reviewOpaqueProcessBaseline() map[int]string { return nil }\n    12\t\n    13\t// RunReviewShim is the Linux review run shim; elsewhere it is not used.\n    14\tfunc RunReviewShim(args []string) int { return 125 }\n    15\t\n    16\tfunc parseReviewShimReport([]byte) (reviewShimReport, error) { return reviewShimReport{}, nil }\n    17\t\n    18\tfunc stopReviewShim(cmd *exec.Cmd) func() error { return cmd.Cancel }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/delegation_list.go | sed -n '1,300p'; nl -ba pose-mcp/internal/cli/delegate.go | sed -n '1,280p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Listing and naming delegated runs (spec pose-delegation-surface R11, and the\n     4\t// listing pose-delegated-review-completion-signal extends).\n     5\t//\n     6\t// A person and an agent follow a task, not a process: an attempt and its\n     7\t// continuations are one row, shown by their latest run. A reference names a\n     8\t// row by attempt, by any of its runs, by label or by a prefix of its session.\n     9\t\n    10\timport (\n    11\t\t\"fmt\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t)\n    16\t\n    17\t// DelegationAttempt is one attempt and its continuations.\n    18\ttype DelegationAttempt struct {\n    19\t\tAttemptID    string              `json:\"attempt_id\"`\n    20\t\tRuns         []string            `json:\"runs\"`\n    21\t\tLatestRun    string              `json:\"latest_run,omitempty\"`\n    22\t\tState        string              `json:\"state\"`\n    23\t\tPurpose      string              `json:\"purpose\"`\n    24\t\tAgent        string              `json:\"agent\"`\n    25\t\tVendor       string              `json:\"vendor,omitempty\"`\n    26\t\tModel        string              `json:\"model,omitempty\"`\n    27\t\tLabel        string              `json:\"label,omitempty\"`\n    28\t\tLead         string              `json:\"lead,omitempty\"`\n    29\t\tAccess       string              `json:\"access\"`\n    30\t\tScope        string              `json:\"scope\"`\n    31\t\tBundleID     string              `json:\"bundle_id\"`\n    32\t\tStartedAt    string              `json:\"started_at\"`\n    33\t\tEndedAt      string              `json:\"ended_at,omitempty\"`\n    34\t\tTurns        int                 `json:\"turns\"`\n    35\t\tLastStep     string              `json:\"last_step,omitempty\"`\n    36\t\tFailure      string              `json:\"failure,omitempty\"`\n    37\t\tInterruption *ReviewInterruption `json:\"interruption,omitempty\"`\n    38\t\t// Partial says an interrupted run kept a partial draft; TimeLeft is the\n    39\t\t// wait until its recorded reset, when there is one.\n    40\t\tPartial         bool   `json:\"partial,omitempty\"`\n    41\t\tTimeLeft        string `json:\"time_left,omitempty\"`\n    42\t\tActive          bool   `json:\"active\"`\n    43\t\tLiveness        string `json:\"liveness,omitempty\"`\n    44\t\tCancelRequested bool   `json:\"cancel_requested,omitempty\"`\n    45\t\t// HeartbeatAge is how long ago the running process last beat; a stalled\n    46\t\t// run is not active (spec pose-delegated-review-completion-signal R4, R6).\n    47\t\tHeartbeatAge string `json:\"heartbeat_age,omitempty\"`\n    48\t\tStalledAt    string `json:\"stalled_at,omitempty\"`\n    49\t\t// HookFailure is why the latest run's on_terminal hook failed (R7).\n    50\t\tHookFailure string `json:\"hook_failure,omitempty\"`\n    51\t\t// Round is the review round of the scope the latest run reviewed (spec\n    52\t\t// pose-delegated-review-round-protocol R1).\n    53\t\tRound    int `json:\"round,omitempty\"`\n    54\t\tsessions []string\n    55\t\tlatest   *ReviewRun\n    56\t}\n    57\t\n    58\t// Latest is the latest recorded run of the attempt, if any.\n    59\tfunc (a DelegationAttempt) Latest() *ReviewRun { return a.latest }\n    60\t\n    61\t// DelegationRunning is the state of an attempt whose process is still there;\n    62\t// DelegationStalled, of one whose process is gone without a record.\n    63\tconst (\n    64\t\tDelegationRunning = \"running\"\n    65\t\tDelegationStalled = \"stalled\"\n    66\t\t// DelegationAbandonedCause is the failure of a stalled attempt whose\n    67\t\t// dispatch ended before recording its run.\n    68\t\tDelegationAbandonedCause = \"abandoned: the dispatching process ended before the run was recorded\"\n    69\t)\n    70\t\n    71\t// ListDelegationAttempts groups every recorded run by attempt, adds the runs\n    72\t// in progress, and returns the losses the run history reports.\n    73\tfunc (s Store) ListDelegationAttempts() ([]DelegationAttempt, []string, error) {\n    74\t\t// The markers are read before the runs: a run publishes its record before\n    75\t\t// it removes its marker, so a reader that finds no marker for an attempt\n    76\t\t// it saw running finds its record (spec\n    77\t\t// pose-delegated-review-completion-signal R5).\n    78\t\tactive, activeLost, activeErr := s.ListDelegationActive()\n    79\t\truns, lost, err := s.ReadReviewRuns(\"\")\n    80\t\tif err != nil {\n    81\t\t\treturn nil, nil, err\n    82\t\t}\n    83\t\t// Task runs share the lifecycle, never the review history (spec\n    84\t\t// pose-delegation-task R7, R8).\n    85\t\ttasks, taskLost := s.ReadDelegationTaskRuns()\n    86\t\truns, lost = append(runs, tasks...), append(lost, taskLost...)\n    87\t\tbyAttempt := map[string]*DelegationAttempt{}\n    88\t\torder := []string{}\n    89\t\tfor i := range runs {\n    90\t\t\trun := runs[i]\n    91\t\t\tkey := run.AttemptID\n    92\t\t\tif key == \"\" {\n    93\t\t\t\tkey = run.RunID // a run recorded before attempts existed is its own attempt\n    94\t\t\t}\n    95\t\t\trow, ok := byAttempt[key]\n    96\t\t\tif !ok {\n    97\t\t\t\trow = &DelegationAttempt{AttemptID: key, StartedAt: run.StartedAt}\n    98\t\t\t\tbyAttempt[key] = row\n    99\t\t\t\torder = append(order, key)\n   100\t\t\t}\n   101\t\t\trow.Runs = append(row.Runs, run.RunID)\n   102\t\t\trow.latest = &runs[i]\n   103\t\t\tif run.SessionDigest != \"\" {\n   104\t\t\t\tif value, err := s.readReviewSession(run.SessionDigest); err == nil {\n   105\t\t\t\t\trow.sessions = append(row.sessions, value)\n   106\t\t\t\t}\n   107\t\t\t}\n   108\t\t\tevents, err := s.ReadDelegationEvents(run)\n   109\t\t\tif err != nil {\n   110\t\t\t\t// A turn count read from nothing would report a whole history.\n   111\t\t\t\tlost = append(lost, \"the events of run \"+run.RunID+\" could not be read: \"+err.Error())\n   112\t\t\t} else {\n   113\t\t\t\tfor _, e := range events {\n   114\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   115\t\t\t\t\t\trow.Turns++\n   116\t\t\t\t\t}\n   117\t\t\t\t}\n   118\t\t\t\tif len(events) > 0 {\n   119\t\t\t\t\trow.LastStep = delegationStepText(events[len(events)-1])\n   120\t\t\t\t}\n   121\t\t\t}\n   122\t\t}\n   123\t\tfor _, key := range order {\n   124\t\t\trow := byAttempt[key]\n   125\t\t\tlatest := row.latest\n   126\t\t\trow.LatestRun, row.State, row.Agent, row.Vendor, row.Model = latest.RunID, latest.Status, latest.Adapter, latest.Vendor, latest.Model\n   127\t\t\trow.Label, row.Scope, row.BundleID, row.EndedAt, row.Failure, row.Interruption = latest.Label, latest.Scope, latest.BundleID, latest.EndedAt, latest.Failure, latest.Interruption\n   128\t\t\trow.Purpose, row.Lead, row.Access = latest.Purpose, latest.Lead, DelegationAccessRead\n   129\t\t\tif latest.Access != \"\" {\n   130\t\t\t\trow.Access = latest.Access\n   131\t\t\t}\n   132\t\t\trow.Round = latest.Round\n   133\t\t\tif hook := s.ReadDelegationHook(latest.RunID); hook != nil {\n   134\t\t\t\trow.HookFailure = hook.Failure\n   135\t\t\t}\n   136\t\t\tif row.Purpose == \"\" {\n   137\t\t\t\trow.Purpose = DelegationPurposeForKind(latest.Kind)\n   138\t\t\t}\n   139\t\t\tif latest.Status == ReviewRunInterrupted {\n   140\t\t\t\trow.Partial = strings.TrimSpace(latest.Output) != \"\"\n   141\t\t\t\tif latest.Interruption != nil && latest.Interruption.ResetAt != \"\" {\n   142\t\t\t\t\tif at, err := time.Parse(time.RFC3339Nano, latest.Interruption.ResetAt); err == nil {\n   143\t\t\t\t\t\tleft := time.Until(at)\n   144\t\t\t\t\t\tif left < 0 {\n   145\t\t\t\t\t\t\tleft = 0\n   146\t\t\t\t\t\t}\n   147\t\t\t\t\t\trow.TimeLeft = left.Round(time.Second).String()\n   148\t\t\t\t\t}\n   149\t\t\t\t}\n   150\t\t\t}\n   151\t\t}\n   152\t\tif activeErr != nil {\n   153\t\t\tlost = append(lost, \"active runs could not be read: \"+activeErr.Error())\n   154\t\t}\n   155\t\tlost = append(lost, activeLost...)\n   156\t\tfor _, marker := range active {\n   157\t\t\trow, ok := byAttempt[marker.AttemptID]\n   158\t\t\tif !ok {\n   159\t\t\t\trow = &DelegationAttempt{AttemptID: marker.AttemptID, Runs: []string{}, StartedAt: marker.StartedAt, Purpose: marker.Purpose, Access: DelegationAccessRead, Agent: marker.Agent, Label: marker.Label, Scope: marker.Scope, BundleID: marker.BundleID}\n   160\t\t\t\tbyAttempt[marker.AttemptID] = row\n   161\t\t\t\torder = append(order, marker.AttemptID)\n   162\t\t\t}\n   163\t\t\trow.State, row.Active, row.Liveness, row.CancelRequested = DelegationRunning, true, marker.Liveness, marker.CancelRequested\n   164\t\t\tif marker.Round > 0 {\n   165\t\t\t\trow.Round = marker.Round\n   166\t\t\t}\n   167\t\t\trow.EndedAt, row.Failure, row.Interruption, row.Partial, row.TimeLeft = \"\", \"\", nil, false, \"\"\n   168\t\t\tif beat, err := time.Parse(time.RFC3339Nano, marker.HeartbeatAt); err == nil {\n   169\t\t\t\trow.HeartbeatAge = time.Since(beat).Round(time.Second).String()\n   170\t\t\t}\n   171\t\t\tif marker.StalledAt != \"\" {\n   172\t\t\t\trow.State, row.Active, row.StalledAt = DelegationStalled, false, marker.StalledAt\n   173\t\t\t\tif row.LatestRun == \"\" {\n   174\t\t\t\t\t// The dispatch ended before recording its run: the cause and\n   175\t\t\t\t\t// the release are said, not left to inspection (review round\n   176\t\t\t\t\t// 1, N2).\n   177\t\t\t\t\trow.Failure = DelegationAbandonedCause + \"; release it with `pose delegate cancel \" + marker.AttemptID + \"`\"\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\t// A running run's progress comes from its live events (R12).\n   181\t\t\tif live, _, err := s.ReadDelegationLiveEvents(marker.AttemptID, 0); err == nil && len(live) > 0 {\n   182\t\t\t\tfor _, e := range live {\n   183\t\t\t\t\tif e.Kind == DelegationEventTurn {\n   184\t\t\t\t\t\trow.Turns++\n   185\t\t\t\t\t}\n   186\t\t\t\t}\n   187\t\t\t\trow.LastStep = delegationStepText(live[len(live)-1])\n   188\t\t\t}\n   189\t\t}\n   190\t\t// A reservation an earlier engine left without a marker or a run is\n   191\t\t// listed too, so it can be named and released (review round 2, N1).\n   192\t\tif orphans, orphanLost, err := s.orphanReservations(time.Now()); err != nil {\n   193\t\t\tlost = append(lost, \"abandoned reservations could not be read: \"+err.Error())\n   194\t\t} else {\n   195\t\t\tlost = append(lost, orphanLost...)\n   196\t\t\tfor _, a := range orphans {\n   197\t\t\t\tif _, ok := byAttempt[a.AttemptID]; ok {\n   198\t\t\t\t\tcontinue\n   199\t\t\t\t}\n   200\t\t\t\tbyAttempt[a.AttemptID] = &DelegationAttempt{AttemptID: a.AttemptID, Runs: []string{}, StartedAt: a.ReservedAt, Purpose: DelegationPurposeReview, Access: DelegationAccessRead, Agent: a.Adapter, Scope: a.Scope, BundleID: a.BundleID,\n   201\t\t\t\t\tState: DelegationStalled, StalledAt: a.ReservedAt, Failure: \"no owner record: an earlier engine reserved it without a marker, so nothing proves its dispatch ended; if none is running, release it with `pose delegate cancel \" + a.AttemptID + \" --confirm-abandoned`\"}\n   202\t\t\t\torder = append(order, a.AttemptID)\n   203\t\t\t}\n   204\t\t}\n   205\t\tout := make([]DelegationAttempt, 0, len(order))\n   206\t\tfor _, key := range order {\n   207\t\t\tout = append(out, *byAttempt[key])\n   208\t\t}\n   209\t\tsort.SliceStable(out, func(i, j int) bool { return out[i].StartedAt < out[j].StartedAt })\n   210\t\treturn out, lost, nil\n   211\t}\n   212\t\n   213\tfunc delegationStepText(e DelegationEvent) string {\n   214\t\ttext := strings.Join(strings.Fields(e.Text), \" \")\n   215\t\tif len(text) > 80 {\n   216\t\t\tcut := 77\n   217\t\t\tfor cut > 0 && !utf8RuneStart(text[cut]) {\n   218\t\t\t\tcut--\n   219\t\t\t}\n   220\t\t\ttext = text[:cut] + \"...\"\n   221\t\t}\n   222\t\tswitch e.Kind {\n   223\t\tcase DelegationEventToolCall:\n   224\t\t\treturn \"▶ \" + text\n   225\t\tcase DelegationEventToolOutput:\n   226\t\t\tif e.ExitCode != nil && *e.ExitCode != 0 {\n   227\t\t\t\treturn fmt.Sprintf(\"✗ exit %d\", *e.ExitCode)\n   228\t\t\t}\n   229\t\t\treturn \"✓ exit 0\"\n   230\t\tcase DelegationEventTurn:\n   231\t\t\treturn \"turn\"\n   232\t\t}\n   233\t\tif text == \"\" {\n   234\t\t\treturn e.Kind\n   235\t\t}\n   236\t\treturn e.Kind + \": \" + text\n   237\t}\n   238\t\n   239\t// ErrDelegationRefAmbiguous carries the candidates of an ambiguous reference.\n   240\t// Neither reference error carries the reference: it may be a session, which\n   241\t// no output names.\n   242\ttype ErrDelegationRefAmbiguous struct {\n   243\t\tCandidates []string\n   244\t}\n   245\t\n   246\tfunc (e *ErrDelegationRefAmbiguous) Error() string {\n   247\t\treturn \"pose: the reference names more than one delegated run: \" + strings.Join(e.Candidates, \", \")\n   248\t}\n   249\t\n   250\t// ErrDelegationRefUnknown means no attempt matches.\n   251\ttype ErrDelegationRefUnknown struct{}\n   252\t\n   253\tfunc (e *ErrDelegationRefUnknown) Error() string {\n   254\t\treturn \"pose: no delegated run matches the reference (a run id, an attempt id, a label or a session prefix of six characters or more)\"\n   255\t}\n   256\t\n   257\t// ResolveDelegationRef finds the one attempt ref names (R11).\n   258\tfunc ResolveDelegationRef(attempts []DelegationAttempt, ref string) (DelegationAttempt, error) {\n   259\t\tref = strings.TrimSpace(ref)\n   260\t\tif ref == \"\" {\n   261\t\t\treturn DelegationAttempt{}, &ErrDelegationRefUnknown{}\n   262\t\t}\n   263\t\t// An identifier is exact and wins over a label or a session prefix.\n   264\t\tfor _, a := range attempts {\n   265\t\t\tif a.AttemptID == ref || containsString(a.Runs, ref) {\n   266\t\t\t\treturn a, nil\n   267\t\t\t}\n   268\t\t}\n   269\t\tvar matched []DelegationAttempt\n   270\t\tfor _, a := range attempts {\n   271\t\t\thit := a.Label == ref\n   272\t\t\tif !hit && len(ref) >= 6 {\n   273\t\t\t\tfor _, session := range a.sessions {\n   274\t\t\t\t\tif strings.HasPrefix(session, ref) {\n   275\t\t\t\t\t\thit = true\n   276\t\t\t\t\t}\n   277\t\t\t\t}\n   278\t\t\t}\n   279\t\t\tif hit {\n   280\t\t\t\tmatched = append(matched, a)\n   281\t\t\t}\n   282\t\t}\n   283\t\tswitch len(matched) {\n   284\t\tcase 0:\n   285\t\t\treturn DelegationAttempt{}, &ErrDelegationRefUnknown{}\n   286\t\tcase 1:\n   287\t\t\treturn matched[0], nil\n   288\t\t}\n   289\t\tcandidates := make([]string, 0, len(matched))\n   290\t\tfor _, a := range matched {\n   291\t\t\tname := a.AttemptID\n   292\t\t\tif a.Label != \"\" {\n   293\t\t\t\tname += \" (\" + a.Label + \", \" + a.State + \")\"\n   294\t\t\t}\n   295\t\t\tcandidates = append(candidates, name)\n   296\t\t}\n   297\t\treturn DelegationAttempt{}, &ErrDelegationRefAmbiguous{Candidates: candidates}\n   298\t}\n     1\tpackage cli\n     2\t\n     3\t// pose delegate: the one surface for delegated executions (spec\n     4\t// pose-delegation-surface; ADR 2026-10-26-delegation-is-a-first-class-execution-surface).\n     5\t//\n     6\t// pose review governs the subject (bundle, brief, attestation, verify);\n     7\t// pose delegate governs executions: who runs, with which access, and what\n     8\t// happened. review, adjudicate and smoke run through the delivered dispatch\n     9\t// path; the lifecycle commands read the same run records.\n    10\t//\n    11\t// Every subcommand takes the common flags with one meaning (R2): where a\n    12\t// command starts a run they set it (--agent, --access, --label, --lead);\n    13\t// where it names or lists runs they select them, and a run that does not\n    14\t// match is not the one named; --dry-run changes nothing anywhere.\n    15\t\n    16\timport (\n    17\t\t\"context\"\n    18\t\t\"crypto/rand\"\n    19\t\t\"encoding/json\"\n    20\t\t\"errors\"\n    21\t\t\"fmt\"\n    22\t\t\"io\"\n    23\t\t\"os\"\n    24\t\t\"os/signal\"\n    25\t\t\"path/filepath\"\n    26\t\t\"regexp\"\n    27\t\t\"sort\"\n    28\t\t\"strconv\"\n    29\t\t\"strings\"\n    30\t\t\"syscall\"\n    31\t\t\"time\"\n    32\t\n    33\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    34\t)\n    35\t\n    36\tconst delegateUsageText = \"pose delegate <review|adjudicate|smoke|task|ls|watch|wait|resume|handoff|cancel|agents> [args] [--agent auto|<name>] [--access read|sandboxed|write|full] [--label <name>] [--lead <vendor>] [--dry-run] [--json]\"\n    37\t\n    38\t// Versioned JSON documents of pose delegate (R10).\n    39\tconst (\n    40\t\tdelegateRunSchema    = \"pose.delegate.run/v1\"\n    41\t\tdelegatePlanSchema   = \"pose.delegate.plan/v1\"\n    42\t\tdelegateListSchema   = \"pose.delegate.ls/v1\"\n    43\t\tdelegateCancelSchema = \"pose.delegate.cancel/v1\"\n    44\t\tdelegateAgentsSchema = \"pose.delegate.agents/v1\"\n    45\t\tdelegateErrorSchema  = \"pose.delegate.error/v1\"\n    46\t)\n    47\t\n    48\t// Subcommands named by the ADR whose behaviour a later spec delivers.\n    49\tvar delegatePlanned = map[string]string{}\n    50\t\n    51\tvar (\n    52\t\tdelegateLabelRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n    53\t)\n    54\t\n    55\t// commonDelegateFlags are taken by every subcommand.\n    56\tvar commonDelegateFlags = []string{\"--agent\", \"--access\", \"--label\", \"--lead\", \"--dry-run\", \"--json\"}\n    57\t\n    58\t// tr picks the message for the session's locale.\n    59\tfunc tr(english, portuguese string) string { return cliText(cliLocaleValue(), english, portuguese) }\n    60\t\n    61\ttype delegateFlags struct {\n    62\t\tagent, access, label, lead, reason, noteFile string\n    63\t\trequest                                      string\n    64\t\tto, cd, effort, promptFile, session          string\n    65\t\taddDirs                                      []string\n    66\t\tnoNetwork, record, confirmAbandoned          bool\n    67\t\tdryRun, jsonOut, active, wait, detach        bool\n    68\t\tverbose, noFollow                            bool\n    69\t\tlines                                        int\n    70\t\twaitMax, timeout, refresh                    time.Duration\n    71\t\tpositional                                   []string\n    72\t}\n    73\t\n    74\t// parseDelegateFlags reads the common flags and the extra ones a subcommand\n    75\t// takes; problem is a message for the person, in their locale.\n    76\tfunc parseDelegateFlags(args []string, extra ...string) (delegateFlags, string) {\n    77\t\tf := delegateFlags{waitMax: 24 * time.Hour}\n    78\t\tpermit := map[string]bool{}\n    79\t\tfor _, name := range append(append([]string(nil), commonDelegateFlags...), extra...) {\n    80\t\t\tpermit[name] = true\n    81\t\t}\n    82\t\tfor i := 0; i < len(args); i++ {\n    83\t\t\targ := args[i]\n    84\t\t\tname, inline, hasInline := strings.Cut(arg, \"=\")\n    85\t\t\t// A lone - names stdin (spec pose-delegation-task R1).\n    86\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n    87\t\t\t\tf.positional = append(f.positional, arg)\n    88\t\t\t\tcontinue\n    89\t\t\t}\n    90\t\t\tif !permit[name] {\n    91\t\t\t\treturn f, tr(\"unknown or inapplicable flag \"+name, \"flag desconhecida ou inaplicável \"+name)\n    92\t\t\t}\n    93\t\t\tswitch name {\n    94\t\t\tcase \"--dry-run\", \"--json\", \"--active\", \"--detach\", \"-v\", \"--no-follow\", \"--no-network\", \"--record\", \"--confirm-abandoned\":\n    95\t\t\t\tif hasInline {\n    96\t\t\t\t\treturn f, tr(name+\" takes no value\", name+\" não recebe valor\")\n    97\t\t\t\t}\n    98\t\t\t\tswitch name {\n    99\t\t\t\tcase \"--dry-run\":\n   100\t\t\t\t\tf.dryRun = true\n   101\t\t\t\tcase \"--json\":\n   102\t\t\t\t\tf.jsonOut = true\n   103\t\t\t\tcase \"--detach\":\n   104\t\t\t\t\tf.detach = true\n   105\t\t\t\tcase \"-v\":\n   106\t\t\t\t\tf.verbose = true\n   107\t\t\t\tcase \"--no-network\":\n   108\t\t\t\t\tf.noNetwork = true\n   109\t\t\t\tcase \"--record\":\n   110\t\t\t\t\tf.record = true\n   111\t\t\t\tcase \"--confirm-abandoned\":\n   112\t\t\t\t\tf.confirmAbandoned = true\n   113\t\t\t\tcase \"--no-follow\":\n   114\t\t\t\t\tf.noFollow = true\n   115\t\t\t\tdefault:\n   116\t\t\t\t\tf.active = true\n   117\t\t\t\t}\n   118\t\t\tcase \"--wait-until-reset\":\n   119\t\t\t\tf.wait = true\n   120\t\t\t\tif hasInline {\n   121\t\t\t\t\td, err := time.ParseDuration(inline)\n   122\t\t\t\t\tif err != nil || d <= 0 || d > 24*time.Hour {\n   123\t\t\t\t\t\treturn f, tr(\"--wait-until-reset takes a duration up to 24h\", \"--wait-until-reset recebe uma duração de até 24h\")\n   124\t\t\t\t\t}\n   125\t\t\t\t\tf.waitMax = d\n   126\t\t\t\t}\n   127\t\t\tdefault:\n   128\t\t\t\tvalue := inline\n   129\t\t\t\tif !hasInline {\n   130\t\t\t\t\t// --prompt - reads stdin (spec pose-delegation-task R8).\n   131\t\t\t\t\tif i+1 >= len(args) || strings.HasPrefix(args[i+1], \"-\") && !(name == \"--prompt\" && args[i+1] == \"-\") {\n   132\t\t\t\t\t\treturn f, tr(name+\" needs a value\", name+\" precisa de um valor\")\n   133\t\t\t\t\t}\n   134\t\t\t\t\tvalue = args[i+1]\n   135\t\t\t\t\ti++\n   136\t\t\t\t}\n   137\t\t\t\tswitch name {\n   138\t\t\t\tcase \"--agent\":\n   139\t\t\t\t\tf.agent = value\n   140\t\t\t\tcase \"--access\":\n   141\t\t\t\t\tif !containsString([]string{posemodel.DelegationAccessRead, posemodel.DelegationAccessSandboxed, posemodel.DelegationAccessWrite, posemodel.DelegationAccessFull}, value) {\n   142\t\t\t\t\t\treturn f, tr(\"--access takes read, sandboxed, write or full\", \"--access recebe read, sandboxed, write ou full\")\n   143\t\t\t\t\t}\n   144\t\t\t\t\tf.access = value\n   145\t\t\t\tcase \"--label\":\n   146\t\t\t\t\tif !delegateLabelRE.MatchString(value) {\n   147\t\t\t\t\t\treturn f, tr(\"--label takes letters, digits, '.', '_' and '-' (64 at most)\", \"--label aceita letras, dígitos, '.', '_' e '-' (no máximo 64)\")\n   148\t\t\t\t\t}\n   149\t\t\t\t\tf.label = value\n   150\t\t\t\tcase \"--lead\":\n   151\t\t\t\t\tvendor, model, err := posemodel.ParseLead(value)\n   152\t\t\t\t\tif err != nil {\n   153\t\t\t\t\t\treturn f, tr(\"--lead takes <vendor>[/<model>], such as openai or anthropic/claude-opus-5-5\", \"--lead recebe <vendor>[/<modelo>], como openai ou anthropic/claude-opus-5-5\")\n   154\t\t\t\t\t}\n   155\t\t\t\t\tf.lead = vendor\n   156\t\t\t\t\tif model != \"\" {\n   157\t\t\t\t\t\tf.lead += \"/\" + model\n   158\t\t\t\t\t}\n   159\t\t\t\tcase \"--reason\":\n   160\t\t\t\t\tf.reason = value\n   161\t\t\t\tcase \"--session\":\n   162\t\t\t\t\tf.session = value\n   163\t\t\t\tcase \"--request\":\n   164\t\t\t\t\tf.request = value\n   165\t\t\t\tcase \"--lines\":\n   166\t\t\t\t\tn, err := strconv.Atoi(value)\n   167\t\t\t\t\tif err != nil || n < 1 || n > 1000 {\n   168\t\t\t\t\t\treturn f, tr(\"--lines takes a number from 1 to 1000\", \"--lines recebe um número de 1 a 1000\")\n   169\t\t\t\t\t}\n   170\t\t\t\t\tf.lines = n\n   171\t\t\t\tcase \"--refresh\":\n   172\t\t\t\t\td, err := time.ParseDuration(value)\n   173\t\t\t\t\tif err != nil || d < 0 || d > time.Hour {\n   174\t\t\t\t\t\treturn f, tr(\"--refresh takes a duration from 0 to 1h (0 turns the preview's refresh off)\", \"--refresh recebe uma duração de 0 a 1h (0 desliga a atualização do preview)\")\n   175\t\t\t\t\t}\n   176\t\t\t\t\tf.refresh = d\n   177\t\t\t\tcase \"--timeout\":\n   178\t\t\t\t\td, err := time.ParseDuration(value)\n   179\t\t\t\t\tif err != nil || d <= 0 {\n   180\t\t\t\t\t\treturn f, tr(\"--timeout takes a positive duration\", \"--timeout recebe uma duração positiva\")\n   181\t\t\t\t\t}\n   182\t\t\t\t\tf.timeout = d\n   183\t\t\t\tcase \"--to\":\n   184\t\t\t\t\tf.to = value\n   185\t\t\t\tcase \"--cd\":\n   186\t\t\t\t\tf.cd = value\n   187\t\t\t\tcase \"--add-dir\":\n   188\t\t\t\t\tf.addDirs = append(f.addDirs, value)\n   189\t\t\t\tcase \"--effort\":\n   190\t\t\t\t\tf.effort = value\n   191\t\t\t\tcase \"--prompt\":\n   192\t\t\t\t\tf.promptFile = value\n   193\t\t\t\tcase \"--note-file\":\n   194\t\t\t\t\tf.noteFile = value\n   195\t\t\t\t}\n   196\t\t\t}\n   197\t\t}\n   198\t\treturn f, \"\"\n   199\t}\n   200\t\n   201\tfunc cmdDelegate(root string, args []string, stdout, stderr io.Writer) int {\n   202\t\tif len(args) == 0 {\n   203\t\t\tdispatchCommandHelp(\"delegate\", nil, stdout, cliLocaleValue())\n   204\t\t\treturn 0\n   205\t\t}\n   206\t\tsub, rest := args[0], args[1:]\n   207\t\tif spec, planned := delegatePlanned[sub]; planned {\n   208\t\t\treturn delegateUsage(stdout, stderr, rest, sub, tr(\"not available yet; it is delivered by spec \"+spec, \"ainda não está disponível; é entregue pela spec \"+spec))\n   209\t\t}\n   210\t\tswitch sub {\n   211\t\tcase posemodel.DelegationPurposeReview, posemodel.DelegationPurposeAdjudicate, posemodel.DelegationPurposeSmoke:\n   212\t\t\treturn cmdDelegatePurpose(root, sub, rest, stdout, stderr)\n   213\t\tcase posemodel.DelegationPurposeTask:\n   214\t\t\treturn cmdDelegateTask(root, rest, stdout, stderr)\n   215\t\tcase \"ls\":\n   216\t\t\treturn cmdDelegateLs(root, rest, stdout, stderr)\n   217\t\tcase \"resume\":\n   218\t\t\treturn cmdDelegateResume(root, rest, stdout, stderr)\n   219\t\tcase \"cancel\":\n   220\t\t\treturn cmdDelegateCancel(root, rest, stdout, stderr)\n   221\t\tcase \"agents\":\n   222\t\t\treturn cmdDelegateAgents(root, rest, stdout, stderr)\n   223\t\tcase \"wait\":\n   224\t\t\treturn cmdDelegateWait(root, rest, stdout, stderr)\n   225\t\tcase \"watch\":\n   226\t\t\treturn cmdDelegateWatch(root, rest, stdout, stderr)\n   227\t\tcase \"handoff\":\n   228\t\t\treturn cmdDelegateHandoff(root, rest, stdout, stderr)\n   229\t\t}\n   230\t\treturn delegateUsage(stdout, stderr, rest, sub, tr(\"unknown subcommand\", \"subcomando desconhecido\")+\"\\n\"+tr(\"Usage: \", \"Uso: \")+delegateUsageText)\n   231\t}\n   232\t\n   233\t// delegateUsage reports a usage error: exit 2, as text, or as the error\n   234\t// document when the caller asked for --json (R10).\n   235\tfunc delegateUsage(stdout, stderr io.Writer, args []string, command, msg string) int {\n   236\t\tfor _, arg := range args {\n   237\t\t\tif arg == \"--json\" {\n   238\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg, \"usage\": true})\n   239\t\t\t\treturn 2\n   240\t\t\t}\n   241\t\t}\n   242\t\thandBackRefusal(map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg, \"usage\": true}, 2)\n   243\t\treturn usageError(stderr, \"pose delegate \"+command+\": \"+msg)\n   244\t}\n   245\t\n   246\tfunc writeDelegateJSON(stdout io.Writer, doc any) {\n   247\t\t// Every error document a detached run writes is handed back (B03); a\n   248\t\t// caller that knows its exit code hands it back first.\n   249\t\tif m, ok := doc.(map[string]any); ok && m[\"schema\"] == delegateErrorSchema {\n   250\t\t\tcode := 1\n   251\t\t\tif m[\"usage\"] == true {\n   252\t\t\t\tcode = 2\n   253\t\t\t}\n   254\t\t\thandBackRefusal(m, code)\n   255\t\t}\n   256\t\tenc := json.NewEncoder(stdout)\n   257\t\tenc.SetIndent(\"\", \"  \")\n   258\t\t_ = enc.Encode(doc)\n   259\t}\n   260\t\n   261\t// delegateFail reports a failure as text or as the error document.\n   262\tfunc delegateFail(stdout, stderr io.Writer, jsonOut bool, command string, code int, err error) int {\n   263\t\tmsg := strings.TrimPrefix(err.Error(), \"pose: \")\n   264\t\tdoc := map[string]any{\"schema\": delegateErrorSchema, \"command\": command, \"error\": msg}\n   265\t\t// The reason code of a refusal is the same over MCP (spec\n   266\t\t// pose-delegation-mcp R5).\n   267\t\tif code := posemodel.DelegationReasonCode(err); code != \"\" {\n   268\t\t\tdoc[\"reason_code\"] = code\n   269\t\t}\n   270\t\tvar ambiguous *posemodel.ErrDelegationRefAmbiguous\n   271\t\tif errors.As(err, &ambiguous) {\n   272\t\t\tdoc[\"candidates\"] = ambiguous.Candidates\n   273\t\t}\n   274\t\thandBackRefusal(doc, code)\n   275\t\tif jsonOut {\n   276\t\t\twriteDelegateJSON(stdout, doc)\n   277\t\t\treturn code\n   278\t\t}\n   279\t\tif code == 2 {\n   280\t\t\treturn usageError(stderr, \"pose delegate \"+command+\": \"+msg)\n","exit_code":0,"status":"completed"}}
