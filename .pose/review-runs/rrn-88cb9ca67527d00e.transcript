{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/delegation_release.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Releasing an abandoned attempt (spec\n     4\t// pose-review-run-reaps-lingering-reviewer-processes R5): a dispatch that\n     5\t// ends after reserving its attempt but before recording its run leaves a\n     6\t// reservation without a receipt. Every later dispatch of the bundle refuses\n     7\t// on it, and cancellation refused it because nothing runs. Once it is proven\n     8\t// abandoned, the attempt is closed by the same records a failed run writes:\n     9\t// a failed run naming the abandonment and its receipt. Nothing is deleted\n    10\t// from the ledger.\n    11\t//\n    12\t// Proof of abandonment: a marker that is stalled with its owner proven dead.\n    13\t// A reservation an earlier engine left without any marker (it reserved\n    14\t// before marking) records no owner, so nothing proves it abandoned: it is\n    15\t// listed once it is older than reviewOrphanReservationAge and has no\n    16\t// receipt or run, and released only on the operator's explicit confirmation,\n    17\t// which the recorded run states (review round 3, N2). One release runs at a\n    18\t// time per attempt under a lock the operating system releases when its\n    19\t// holder ends, so an interrupted release leaves nothing to take over (review\n    20\t// round 5, N1). A release is idempotent: it completes with a run the\n    21\t// attempt already recorded, whatever wrote it (N3), and with a receipt\n    22\t// already published it only removes the stalled marker (N2).\n    23\t\n    24\timport (\n    25\t\t\"errors\"\n    26\t\t\"fmt\"\n    27\t\t\"io\"\n    28\t\t\"os\"\n    29\t\t\"path/filepath\"\n    30\t\t\"strings\"\n    31\t\t\"time\"\n    32\t)\n    33\t\n    34\t// ErrAttemptNotAbandoned means the attempt is running, finished, or not\n    35\t// proven abandoned.\n    36\tvar ErrAttemptNotAbandoned = errors.New(\"pose: the attempt is not an abandoned reservation\")\n    37\t\n    38\t// reviewOrphanReservationAge is how old a reservation without any marker\n    39\t// must be to count as abandoned.\n    40\tconst reviewOrphanReservationAge = 10 * time.Minute\n    41\t\n    42\t// ReleaseAbandonedAttempt records the failed run of an attempt whose\n    43\t// dispatch ended before recording it, and removes its stalled marker. A\n    44\t// stalled marker whose reservation was never published is only removed; the\n    45\t// returned run is then empty.\n    46\tfunc (s Store) ReleaseAbandonedAttempt(attemptID string, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    47\t\tif !validAttemptFileName(attemptID) {\n    48\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: %q names no attempt\", ErrAttemptNotAbandoned, attemptID)\n    49\t\t}\n    50\t\tmarkers, _, err := s.ListDelegationActive()\n    51\t\tif err != nil {\n    52\t\t\treturn ReviewRun{}, err\n    53\t\t}\n    54\t\tvar marker *DelegationActiveRun\n    55\t\tfor i := range markers {\n    56\t\t\tif markers[i].AttemptID == attemptID {\n    57\t\t\t\tmarker = &markers[i]\n    58\t\t\t}\n    59\t\t}\n    60\t\tif marker != nil && (marker.StalledAt == \"\" || marker.Liveness != LockOwnerDead) {\n    61\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: its owner is not proven gone\", ErrAttemptNotAbandoned)\n    62\t\t}\n    63\t\tdir, err := s.delegationActiveDir(true)\n    64\t\tif err != nil {\n    65\t\t\treturn ReviewRun{}, err\n    66\t\t}\n    67\t\tlock, err := os.OpenFile(filepath.Join(dir, attemptID+\".release.lock\"), os.O_CREATE|os.O_RDWR, 0600)\n    68\t\tif err != nil {\n    69\t\t\treturn ReviewRun{}, err\n    70\t\t}\n    71\t\tdefer lock.Close()\n    72\t\tunlock, err := lockSpecTransferFile(lock)\n    73\t\tif err != nil {\n    74\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: another release of it is in progress\", ErrAttemptNotAbandoned)\n    75\t\t}\n    76\t\tdefer unlock()\n    77\t\treturn s.releaseAbandonedAttemptClaimed(attemptID, marker, now, operatorConfirmed)\n    78\t}\n    79\t\n    80\tfunc (s Store) releaseAbandonedAttemptClaimed(attemptID string, marker *DelegationActiveRun, now time.Time, operatorConfirmed bool) (ReviewRun, error) {\n    81\t\tvar reserved *DelegatedReviewAttempt\n    82\t\tif marker != nil {\n    83\t\t\tattempts, err := s.readDelegatedReviewAttempts(marker.BundleID)\n    84\t\t\tif err != nil {\n    85\t\t\t\treturn ReviewRun{}, err\n    86\t\t\t}\n    87\t\t\tfor i := range attempts {\n    88\t\t\t\tif attempts[i].AttemptID == attemptID {\n    89\t\t\t\t\treserved = &attempts[i]\n    90\t\t\t\t}\n    91\t\t\t}\n    92\t\t\tif reserved == nil {\n    93\t\t\t\t// The dispatch ended between its marker and its reservation:\n    94\t\t\t\t// nothing blocks the bundle, and the marker alone is removed.\n    95\t\t\t\treturn ReviewRun{}, s.removeDelegationMarker(*marker)\n    96\t\t\t}\n    97\t\t} else {\n    98\t\t\tif !operatorConfirmed {\n    99\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it has no marker, so nothing proves its dispatch ended; if no dispatch of it is running, confirm with --confirm-abandoned\", ErrAttemptNotAbandoned)\n   100\t\t\t}\n   101\t\t\torphans, _, err := s.orphanReservations(now)\n   102\t\t\tif err != nil {\n   103\t\t\t\treturn ReviewRun{}, err\n   104\t\t\t}\n   105\t\t\tfor i := range orphans {\n   106\t\t\t\tif orphans[i].AttemptID == attemptID {\n   107\t\t\t\t\treserved = &orphans[i]\n   108\t\t\t\t}\n   109\t\t\t}\n   110\t\t\tif reserved == nil {\n   111\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: no stalled marker and no reservation older than %s without a receipt\", ErrAttemptNotAbandoned, reviewOrphanReservationAge)\n   112\t\t\t}\n   113\t\t}\n   114\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, *reserved)); err == nil {\n   115\t\t\t// A release that stopped after the receipt completes by removing\n   116\t\t\t// the stalled marker; with no marker there is nothing to release.\n   117\t\t\tif marker != nil {\n   118\t\t\t\treceipt, err := s.readAttemptReceipt(*reserved)\n   119\t\t\t\tif err != nil {\n   120\t\t\t\t\treturn ReviewRun{}, err\n   121\t\t\t\t}\n   122\t\t\t\trun, err := s.LoadProvenanceReviewRun(receipt.RunID)\n   123\t\t\t\tif err != nil {\n   124\t\t\t\t\treturn ReviewRun{}, err\n   125\t\t\t\t}\n   126\t\t\t\treturn run, s.removeDelegationMarker(*marker)\n   127\t\t\t}\n   128\t\t\treturn ReviewRun{}, fmt.Errorf(\"%w: it already has a receipt\", ErrAttemptNotAbandoned)\n   129\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   130\t\t\treturn ReviewRun{}, fmt.Errorf(\"the receipt of %s cannot be inspected: %w\", attemptID, err)\n   131\t\t}\n   132\t\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n   133\t\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n   134\t\t\tStartedAt: reserved.ReservedAt, ExitCode: -1, Purpose: DelegationPurposeReview,\n   135\t\t\tStatus: ReviewRunFailed, EndedAt: now.UTC().Format(time.RFC3339Nano)}\n   136\t\tif marker != nil {\n   137\t\t\trun.Kind, run.Purpose, run.Label, run.Round, run.StartedAt = DelegationKindForPurpose(marker.Purpose), marker.Purpose, marker.Label, marker.Round, marker.StartedAt\n   138\t\t\trun.Failure = DelegationAbandonedCause + \" (stalled at \" + marker.StalledAt + \"); released by pose delegate cancel\"\n   139\t\t} else {\n   140\t\t\trun.Failure = DelegationAbandonedCause + \" (reservation of \" + reserved.ReservedAt + \" with no marker, left by an earlier engine); released by pose delegate cancel on the operator's confirmation\"\n   141\t\t}\n   142\t\t// A run the attempt already recorded, by its dispatch or by a release\n   143\t\t// interrupted before the receipt, completes the attempt; no second run\n   144\t\t// is written for it.\n   145\t\trecorded, found, err := s.recordedAttemptRun(*reserved)\n   146\t\tif err != nil {\n   147\t\t\treturn ReviewRun{}, err\n   148\t\t}\n   149\t\tif !found {\n   150\t\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n   151\t\t\t\treturn ReviewRun{}, err\n   152\t\t\t}\n   153\t\t}\n   154\t\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n   155\t\t\treturn recorded, err\n   156\t\t}\n   157\t\tif marker != nil {\n   158\t\t\treturn recorded, s.removeDelegationMarker(*marker)\n   159\t\t}\n   160\t\treturn recorded, nil\n   161\t}\n   162\t\n   163\t// recordedAttemptRun finds the latest run recorded for attempt a.\n   164\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt) (ReviewRun, bool, error) {\n   165\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n   166\t\tif err != nil {\n   167\t\t\treturn ReviewRun{}, false, err\n   168\t\t}\n   169\t\tif len(lost) > 0 {\n   170\t\t\t// An unreadable run may be this release's: the history is unknown,\n   171\t\t\t// and the release does not write another (review round 4, N3).\n   172\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n   173\t\t}\n   174\t\tvar latest *ReviewRun\n   175\t\tfor i := range runs {\n   176\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n   177\t\t\t\tlatest = &runs[i]\n   178\t\t\t}\n   179\t\t}\n   180\t\tif latest == nil {\n   181\t\t\treturn ReviewRun{}, false, nil\n   182\t\t}\n   183\t\treturn *latest, true, nil\n   184\t}\n   185\t\n   186\t// orphanReservations lists the reservations left without a receipt or a\n   187\t// marker, older than reviewOrphanReservationAge, and\n   188\t// says which reservations or receipts it could not read (review round 3, N3).\n   189\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n   190\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n   191\t\tdirs, dirsTruncated, err := readDirBounded(base, reviewOrphanScanMaxEntries)\n   192\t\tif errors.Is(err, os.ErrNotExist) {\n   193\t\t\treturn nil, nil, nil\n   194\t\t}\n   195\t\tif err != nil {\n   196\t\t\treturn nil, nil, err\n   197\t\t}\n   198\t\tmarkers, markerLost, err := s.ListDelegationActive()\n   199\t\tif err != nil {\n   200\t\t\treturn nil, nil, err\n   201\t\t}\n   202\t\tif len(markerLost) > 0 {\n   203\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n   204\t\t\t// have no marker (review round 6, N1).\n   205\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil\n   206\t\t}\n   207\t\tmarked := map[string]bool{}\n   208\t\tfor _, m := range markers {\n   209\t\t\tmarked[m.AttemptID] = true\n   210\t\t}\n   211\t\truns, runLost, err := s.ReadReviewRuns(\"\")\n   212\t\tif err != nil {\n   213\t\t\treturn nil, nil, err\n   214\t\t}\n   215\t\tif len(runLost) > 0 {\n   216\t\t\t// Without the whole run history nothing is known to have no run.\n   217\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while the run history is incomplete\"}, runLost...), nil\n   218\t\t}\n   219\t\t// A recorded run does not finish an attempt, its receipt does: a\n   220\t\t// reservation whose run was recorded without a receipt still blocks and\n   221\t\t// is released with that run (review round 5, N3).\n   222\t\t_ = runs\n   223\t\tvar out []DelegatedReviewAttempt\n   224\t\tvar lost []string\n   225\t\tbudget := reviewReadBudget(nil)\n   226\t\tfor _, d := range dirs {\n   227\t\t\tif !d.IsDir() {\n   228\t\t\t\tcontinue\n   229\t\t\t}\n   230\t\t\tentries, truncated, err := readDirBounded(filepath.Join(base, d.Name()), reviewOrphanScanMaxEntries)\n   231\t\t\tif err != nil {\n   232\t\t\t\tlost = append(lost, \"the reservations in \"+d.Name()+\" could not be listed: \"+err.Error())\n   233\t\t\t\tcontinue\n   234\t\t\t}\n   235\t\t\tif truncated {\n   236\t\t\t\tlost = append(lost, fmt.Sprintf(\"the reservations in %s exceed %d entries; the rest were not read\", d.Name(), reviewOrphanScanMaxEntries))\n   237\t\t\t}\n   238\t\t\tfor _, e := range entries {\n   239\t\t\t\tif IsPublisherStaging(e.Name()) || !strings.HasSuffix(e.Name(), \".json\") || strings.HasSuffix(e.Name(), \".result.json\") {\n   240\t\t\t\t\tcontinue\n   241\t\t\t\t}\n   242\t\t\t\tvar a DelegatedReviewAttempt\n   243\t\t\t\tif err := readLedgerJSONBudgetIn(s.fsys(), filepath.Join(base, d.Name(), e.Name()), &a, budget); err != nil {\n   244\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" could not be read: \"+err.Error())\n   245\t\t\t\t\tcontinue\n   246\t\t\t\t}\n   247\t\t\t\tif a.AttemptID != attemptIdentity(a) {\n   248\t\t\t\t\tlost = append(lost, \"the reservation \"+d.Name()+\"/\"+e.Name()+\" does not match its identity\")\n   249\t\t\t\t\tcontinue\n   250\t\t\t\t}\n   251\t\t\t\tif marked[a.AttemptID] {\n   252\t\t\t\t\tcontinue\n   253\t\t\t\t}\n   254\t\t\t\tif _, err := os.Lstat(attemptReceiptPath(s.Root, a)); err == nil {\n   255\t\t\t\t\tcontinue\n   256\t\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n   257\t\t\t\t\tlost = append(lost, \"the receipt of \"+a.AttemptID+\" could not be inspected: \"+err.Error())\n   258\t\t\t\t\tcontinue\n   259\t\t\t\t}\n   260\t\t\t\tat, err := time.Parse(time.RFC3339Nano, a.ReservedAt)\n   261\t\t\t\tif err != nil || now.Sub(at) < reviewOrphanReservationAge {\n   262\t\t\t\t\tcontinue\n   263\t\t\t\t}\n   264\t\t\t\tout = append(out, a)\n   265\t\t\t}\n   266\t\t}\n   267\t\tif dirsTruncated {\n   268\t\t\tlost = append(lost, fmt.Sprintf(\"the attempt directories exceed %d entries; the rest were not read\", reviewOrphanScanMaxEntries))\n   269\t\t}\n   270\t\treturn out, lost, nil\n   271\t}\n   272\t\n   273\t// reviewOrphanScanMaxEntries bounds each directory the orphan scan lists\n   274\t// (review round 10, N2).\n   275\tconst reviewOrphanScanMaxEntries = 10000\n   276\t\n   277\t// readDirBounded lists at most max entries of dir and says whether more exist.\n   278\tfunc readDirBounded(dir string, max int) ([]os.DirEntry, bool, error) {\n   279\t\tf, err := os.Open(dir)\n   280\t\tif err != nil {\n   281\t\t\treturn nil, false, err\n   282\t\t}\n   283\t\tdefer f.Close()\n   284\t\tentries, err := f.ReadDir(max + 1)\n   285\t\tif err != nil && !errors.Is(err, io.EOF) {\n   286\t\t\treturn nil, false, err\n   287\t\t}\n   288\t\tif len(entries) > max {\n   289\t\t\treturn entries[:max], true, nil\n   290\t\t}\n   291\t\treturn entries, false, nil\n   292\t}\n   293\t\n   294\tfunc (s Store) removeDelegationMarker(marker DelegationActiveRun) error {\n   295\t\tdir, err := s.delegationActiveDir(false)\n   296\t\tif err != nil {\n   297\t\t\treturn err\n   298\t\t}\n   299\t\tfor _, p := range []string{filepath.Join(dir, marker.AttemptID+\".json\"), stallClaimPath(dir, marker), cancelRequestPath(dir, marker)} {\n   300\t\t\tif err := os.Remove(p); err != nil && !errors.Is(err, os.ErrNotExist) {\n   301\t\t\t\treturn err\n   302\t\t\t}\n   303\t\t}\n   304\t\treturn nil\n   305\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '140,275p;1585,1655p;1780,1830p'\"","aggregated_output":"   140\t\t\t\t\treturn ReviewersPolicy{}, fmt.Errorf(\"pose: reviewer adapter %s timeout: %w\", name, err)\n   141\t\t\t\t}\n   142\t\t\t}\n   143\t\t}\n   144\t\treturn policy, nil\n   145\t}\n   146\t\n   147\t// ReviewRun is one recorded dispatch.\n   148\ttype ReviewRun struct {\n   149\t\tSafety              *ReviewExecutionSafety `json:\"safety,omitempty\"`\n   150\t\tProvenance          *ReviewRunProvenance   `json:\"provenance,omitempty\"`\n   151\t\tsessionForRedaction string\n   152\t\teventsBytes         []byte\n   153\t\tResumes             string `json:\"resumes,omitempty\"`\n   154\t\t// ResumesSession marks a task that continued a session POSE never\n   155\t\t// recorded, named by its caller (spec pose-delegation-parity-gate SA-07).\n   156\t\tResumesSession bool `json:\"resumes_session,omitempty\"`\n   157\t\t// HandsOffFrom names the run this one continues with another agent, and\n   158\t\t// HandoffDigest the section its brief added (spec\n   159\t\t// pose-delegation-handoff R4, R5).\n   160\t\tHandsOffFrom  string `json:\"hands_off_from,omitempty\"`\n   161\t\tHandoffDigest string `json:\"handoff_digest,omitempty\"`\n   162\t\t// HandoffRenderer is the version of the renderer that listed the\n   163\t\t// predecessor's commands in the section; absent on runs recorded before it.\n   164\t\tHandoffRenderer  int                 `json:\"handoff_renderer,omitempty\"`\n   165\t\tInterruption     *ReviewInterruption `json:\"interruption,omitempty\"`\n   166\t\tSessionDigest    string              `json:\"session_digest,omitempty\"`\n   167\t\tTreeDigest       string              `json:\"tree_digest,omitempty\"`\n   168\t\tBriefNotes       string              `json:\"brief_notes,omitempty\"`\n   169\t\tPartialDigest    string              `json:\"partial_digest,omitempty\"`\n   170\t\tLimitOf          string              `json:\"limit_of,omitempty\"`\n   171\t\tLedgerVersion    int                 `json:\"ledger_version,omitempty\"`\n   172\t\tAttemptID        string              `json:\"attempt_id,omitempty\"`\n   173\t\tReason           string              `json:\"reason,omitempty\"`\n   174\t\tSchemaVersion    int                 `json:\"schema_version\"`\n   175\t\tRunID            string              `json:\"run_id\"`\n   176\t\tScope            string              `json:\"scope\"`\n   177\t\tBundleID         string              `json:\"bundle_id\"`\n   178\t\tBundleDigest     string              `json:\"bundle_digest\"`\n   179\t\tSealedCommit     string              `json:\"sealed_commit\"`\n   180\t\tKind             string              `json:\"kind\"`\n   181\t\tBriefDigest      string              `json:\"brief_digest\"`\n   182\t\tAdapter          string              `json:\"adapter\"`\n   183\t\tVendor           string              `json:\"vendor\"`\n   184\t\tModel            string              `json:\"model\"`\n   185\t\tStartedAt        string              `json:\"started_at\"`\n   186\t\tEndedAt          string              `json:\"ended_at\"`\n   187\t\tExitCode         int                 `json:\"exit_code\"`\n   188\t\tStatus           string              `json:\"status\"`\n   189\t\tFailure          string              `json:\"failure,omitempty\"`\n   190\t\tTranscriptDigest string              `json:\"transcript_digest\"`\n   191\t\tTranscriptPath   string              `json:\"transcript_path\"`\n   192\t\tOutput           string              `json:\"output\"`\n   193\t\tPolicyDigest     string              `json:\"policy_digest,omitempty\"`\n   194\t\tSupersedes       string              `json:\"supersedes,omitempty\"`\n   195\t\t// Label, Purpose and Lead are given by pose delegate; EnvRemoved names the\n   196\t\t// parent session variables the child did not receive (never their values);\n   197\t\t// Events and EventsDigest bind the normalized event stream kept beside\n   198\t\t// the transcript (spec pose-delegation-surface R8, R9, R11).\n   199\t\tLabel        string   `json:\"label,omitempty\"`\n   200\t\tPurpose      string   `json:\"purpose,omitempty\"`\n   201\t\tLead         string   `json:\"lead,omitempty\"`\n   202\t\tEnvRemoved   []string `json:\"env_removed,omitempty\"`\n   203\t\tEvents       string   `json:\"events,omitempty\"`\n   204\t\tEventsDigest string   `json:\"events_digest,omitempty\"`\n   205\t\tSupersededBy string   `json:\"superseded_by,omitempty\"`\n   206\t\t// Routing is how the run's agent was chosen and IndependenceAchieved what\n   207\t\t// it achieved against the implementation (spec pose-delegation-routing R8).\n   208\t\tRouting              *DelegationRoutingRecord `json:\"routing,omitempty\"`\n   209\t\tIndependenceAchieved string                   `json:\"independence_achieved,omitempty\"`\n   210\t\t// A task run (spec pose-delegation-task) records the access it ran with,\n   211\t\t// its directory and flags, the argv it ran, and the digests of the prompt\n   212\t\t// and the error stream kept beside its record; Recorded is --record.\n   213\t\tAccess       string   `json:\"access,omitempty\"`\n   214\t\tDir          string   `json:\"dir,omitempty\"`\n   215\t\tAddDirs      []string `json:\"add_dirs,omitempty\"`\n   216\t\tNoNetwork    bool     `json:\"no_network,omitempty\"`\n   217\t\tRecorded     bool     `json:\"recorded,omitempty\"`\n   218\t\tArgv         []string `json:\"argv,omitempty\"`\n   219\t\tPromptDigest string   `json:\"prompt_digest,omitempty\"`\n   220\t\tEffort       string   `json:\"effort,omitempty\"`\n   221\t\tStderrDigest string   `json:\"stderr_digest,omitempty\"`\n   222\t\t// Round is the round of the scope the run reviewed, DraftProblems what\n   223\t\t// keeps its draft from counting for that round, and Thread how its session\n   224\t\t// relates to the previous round's (spec\n   225\t\t// pose-delegated-review-round-protocol R1, R4, R6).\n   226\t\tRound         int           `json:\"round,omitempty\"`\n   227\t\tDraftProblems []string      `json:\"draft_problems,omitempty\"`\n   228\t\tThread        *ReviewThread `json:\"thread,omitempty\"`\n   229\t\tPath          string        `json:\"-\"`\n   230\t\t// eventsDir is where a task run's files are; a review run's are in\n   231\t\t// reviewRunsDir.\n   232\t\teventsDir string\n   233\t}\n   234\t\n   235\t// Review run states.\n   236\tconst (\n   237\t\tReviewRunCompleted   = \"completed\"\n   238\t\tReviewRunFailed      = \"failed\"\n   239\t\tReviewRunInterrupted = \"interrupted\"\n   240\t\tReviewRunStale       = \"stale\"\n   241\t)\n   242\t\n   243\t// ListReviewRuns returns the recorded runs for bundleID (\"\" for all).\n   244\tfunc (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n   245\t\truns, _, err := s.ReadReviewRuns(bundleID)\n   246\t\treturn runs, err\n   247\t}\n   248\t\n   249\tfunc (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n   250\t\t// Within a read-view operation the ledger is read and checked once per\n   251\t\t// root; every request of the operation is answered from that read,\n   252\t\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n   253\t\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n   254\t\t\truns, lost, err := s.readAllReviewRuns()\n   255\t\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n   256\t\t})\n   257\t\tif err != nil {\n   258\t\t\treturn nil, nil, err\n   259\t\t}\n   260\t\tout := copyReviewRuns(all.runs)\n   261\t\tif bundleID != \"\" {\n   262\t\t\tfiltered := []ReviewRun{}\n   263\t\t\tfor _, run := range out {\n   264\t\t\t\tif run.BundleID == bundleID {\n   265\t\t\t\t\tfiltered = append(filtered, run)\n   266\t\t\t\t}\n   267\t\t\t}\n   268\t\t\tout = filtered\n   269\t\t}\n   270\t\treturn out, deepCopyValue(all.lost), nil\n   271\t}\n   272\t\n   273\t// readAllReviewRuns reads, checks and orders every review run of the store.\n   274\tfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n   275\t\tfiles := s.fsys()\n  1585\t\n  1586\tfunc tail(s string, n int) string {\n  1587\t\tif len(s) <= n {\n  1588\t\t\treturn s\n  1589\t\t}\n  1590\t\treturn s[len(s)-n:]\n  1591\t}\n  1592\t\n  1593\t// beforeAttemptPublished runs between the active marker and the reservation;\n  1594\t// tests use it to stop a dispatch there.\n  1595\tvar beforeAttemptPublished = func(Store, DelegatedReviewAttempt) {}\n  1596\t\n  1597\tfunc (s Store) recordReviewRun(run ReviewRun, transcript []byte) (ReviewRun, error) {\n  1598\t\t// Identity covers only persisted content, never fields derived by a reader\n  1599\t\t// or a previous write of a copied record.\n  1600\t\trun.RunID, run.Path, run.TranscriptPath, run.SupersededBy = \"\", \"\", \"\", \"\"\n  1601\t\trun.LedgerVersion = 1\n  1602\t\tsum := sha256.Sum256(transcript)\n  1603\t\trun.TranscriptDigest = \"sha256:\" + hex.EncodeToString(sum[:])\n  1604\t\tvar events []byte\n  1605\t\trun.EventsDigest = \"\"\n  1606\t\tif run.Events != \"\" {\n  1607\t\t\tevents = run.eventsBytes\n  1608\t\t\trun.EventsDigest = digestBytes(events)\n  1609\t\t}\n  1610\t\trun.eventsBytes = nil // never part of the record or of a copy compared with it\n  1611\t\tidentity, _ := json.Marshal(run)\n  1612\t\tidSum := sha256.Sum256(identity)\n  1613\t\trun.RunID = \"rrn-\" + hex.EncodeToString(idSum[:])[:16]\n  1614\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, reviewRunsDir, true)\n  1615\t\tif err != nil {\n  1616\t\t\treturn ReviewRun{}, err\n  1617\t\t}\n  1618\t\trun.TranscriptPath = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\"))\n  1619\t\tpretty, err := json.MarshalIndent(run, \"\", \"  \")\n  1620\t\tif err != nil {\n  1621\t\t\treturn ReviewRun{}, err\n  1622\t\t}\n  1623\t\tpretty = append(pretty, '\\n')\n  1624\t\tif len(pretty) > reviewLedgerMaxBytes {\n  1625\t\t\treturn ReviewRun{}, fmt.Errorf(\"review run record exceeds %d-byte bound; nothing published\", reviewLedgerMaxBytes)\n  1626\t\t}\n  1627\t\tif len(transcript) > reviewTranscriptMaxBytes {\n  1628\t\t\treturn ReviewRun{}, fmt.Errorf(\"review transcript exceeds %d-byte bound; nothing published\", reviewTranscriptMaxBytes)\n  1629\t\t}\n  1630\t\n  1631\t\twitness := reviewRunWitness{SchemaVersion: 1, RunID: run.RunID, BundleID: run.BundleID, Scope: run.Scope, RecordDigest: digestBytes(pretty), TranscriptDigest: run.TranscriptDigest}\n  1632\t\tif err := publishLedgerJSON(s.Root, filepath.ToSlash(filepath.Join(reviewRunLedgerDir, run.RunID+\".json\")), witness); err != nil {\n  1633\t\t\treturn ReviewRun{}, err\n  1634\t\t}\n  1635\t\tif run.Safety != nil && int64(len(pretty)+len(transcript)+len(events)) > run.Safety.RetainedBytes {\n  1636\t\t\treturn ReviewRun{}, fmt.Errorf(\"retained run exceeds containment byte budget; attempt remains incomplete\")\n  1637\t\t}\n  1638\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".transcript\"), transcript, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1639\t\t\treturn ReviewRun{}, err\n  1640\t\t}\n  1641\t\tif run.EventsDigest != \"\" {\n  1642\t\t\tif err := publishDelegationEvents(dir, run.RunID, events); err != nil {\n  1643\t\t\t\treturn ReviewRun{}, err\n  1644\t\t\t}\n  1645\t\t}\n  1646\t\tif err := PublishFile(filepath.Join(dir, run.RunID+\".json\"), pretty, 0600, PublishAuthoritative, PublishExpectation{Mode: ExpectAbsent}); err != nil {\n  1647\t\t\treturn ReviewRun{}, err\n  1648\t\t}\n  1649\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".json\"))\n  1650\t\treturn run, nil\n  1651\t}\n  1652\t\n  1653\tfunc (s Store) dispatchNoLongerGoverns(plan DispatchPlan) string {\n  1654\t\tcurrent, err := s.LoadReviewBundle(plan.Bundle.BundleID)\n  1655\t\tif err != nil {\n  1780\t\t\treturn \"the bundle of the run can no longer be read: \" + err.Error()\n  1781\t\t}\n  1782\t\tif err := verifyBundleMaterialization(s.Root, bundle); err != nil {\n  1783\t\t\treturn \"persisted review inputs no longer materialize: \" + err.Error()\n  1784\t\t}\n  1785\t\treturn s.dispatchNoLongerGoverns(DispatchPlan{Bundle: bundle, Brief: ReviewBrief{Scope: run.Scope}, SealedCommit: run.SealedCommit,\n  1786\t\t\tPolicyDigest: run.PolicyDigest})\n  1787\t}\n  1788\t\n  1789\tfunc validateReviewRunRecord(name string, run ReviewRun) error {\n  1790\t\tif name != run.RunID+\".json\" {\n  1791\t\t\treturn fmt.Errorf(\"the file is not named after the run it holds\")\n  1792\t\t}\n  1793\t\tif run.LedgerVersion != 0 && run.LedgerVersion != 1 {\n  1794\t\t\treturn fmt.Errorf(\"unknown ledger version %d\", run.LedgerVersion)\n  1795\t\t}\n  1796\t\tif run.SchemaVersion != 1 {\n  1797\t\t\treturn fmt.Errorf(\"schema_version %d is not read by this engine\", run.SchemaVersion)\n  1798\t\t}\n  1799\t\tswitch run.Status {\n  1800\t\tcase ReviewRunCompleted, ReviewRunFailed, ReviewRunStale, ReviewRunInterrupted:\n  1801\t\tdefault:\n  1802\t\t\treturn fmt.Errorf(\"status %q is not a state of a run\", run.Status)\n  1803\t\t}\n  1804\t\tif err := validateContinuityRun(run); err != nil {\n  1805\t\t\treturn err\n  1806\t\t}\n  1807\t\tif run.BundleID == \"\" || run.Scope == \"\" {\n  1808\t\t\treturn fmt.Errorf(\"the bundle or scope is missing\")\n  1809\t\t}\n  1810\t\tfor _, at := range []string{run.StartedAt, run.EndedAt} {\n  1811\t\t\tif _, err := time.Parse(time.RFC3339Nano, at); err != nil {\n  1812\t\t\t\treturn fmt.Errorf(\"an instant of the run is not RFC3339: %q\", at)\n  1813\t\t\t}\n  1814\t\t}\n  1815\t\tif run.TranscriptPath != filepath.ToSlash(filepath.Join(reviewRunsDir, run.RunID+\".transcript\")) {\n  1816\t\t\treturn fmt.Errorf(\"the transcript path is not the one the run is written with\")\n  1817\t\t}\n  1818\t\tunsealed := run\n  1819\t\tunsealed.RunID, unsealed.TranscriptPath, unsealed.SupersededBy, unsealed.Path = \"\", \"\", \"\", \"\"\n  1820\t\tidentity, _ := json.Marshal(unsealed)\n  1821\t\tsum := sha256.Sum256(identity)\n  1822\t\tif run.RunID != \"rrn-\"+hex.EncodeToString(sum[:])[:16] {\n  1823\t\t\treturn fmt.Errorf(\"the identity of the run is not derived from its content\")\n  1824\t\t}\n  1825\t\treturn nil\n  1826\t}\n  1827\t\n  1828\tconst reviewTranscriptMaxBytes = 256 << 20\n  1829\t\n  1830\tfunc (s Store) reviewRunTranscriptIntact(run ReviewRun) string {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '600,900p'\"","aggregated_output":"   600\t\tplan.provenance, err = s.prepareRunProvenance(plan, policy)\n   601\t\tif err != nil {\n   602\t\t\treturn DispatchPlan{}, err\n   603\t\t}\n   604\t\treturn plan, nil\n   605\t}\n   606\t\n   607\t// ErrNoReviewerAdapter means the project configured no reviewer.\n   608\tvar ErrNoReviewerAdapter = errors.New(\"pose: no agent is configured in .pose/policy/delegation.json\")\n   609\t\n   610\t// RunReviewDispatch executes plan and records the run, failed or completed.\n   611\tfunc (s Store) RunReviewDispatch(plan DispatchPlan, now func() time.Time) (ReviewRun, error) {\n   612\t\treturn s.RunReviewDispatchContext(context.Background(), plan, now)\n   613\t}\n   614\t\n   615\t// RunReviewDispatchContext also propagates caller cancellation to the covered\n   616\t// process set. Cleanup has its own bounded context and never respawns the adapter.\n   617\tfunc (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPlan, now func() time.Time) (result ReviewRun, resultErr error) {\n   618\t\tif err := parent.Err(); err != nil {\n   619\t\t\treturn ReviewRun{}, err\n   620\t\t}\n   621\t\tif why := routingAgainstAnotherBundle(plan); why != \"\" {\n   622\t\t\treturn ReviewRun{}, errors.New(\"pose: \" + why)\n   623\t\t}\n   624\t\t// pose delegate cancel stops the run through this context (R13).\n   625\t\tparent, cancelRun := context.WithCancel(parent)\n   626\t\tdefer cancelRun()\n   627\t\tvar cancelled *atomic.Bool\n   628\t\tif plan.PendingContinuation != nil {\n   629\t\t\treturn ReviewRun{}, plan.PendingContinuation\n   630\t\t}\n   631\t\tif plan.Existing != nil {\n   632\t\t\tif plan.predecessor == nil {\n   633\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation lacks predecessor\")\n   634\t\t\t}\n   635\t\t\tfresh, err := s.replanContinuation(plan)\n   636\t\t\tif err != nil {\n   637\t\t\t\treturn ReviewRun{}, err\n   638\t\t\t}\n   639\t\t\tif fresh.Existing == nil {\n   640\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation disappeared\")\n   641\t\t\t}\n   642\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   643\t\t}\n   644\t\tif _, _, err := reviewAdapterEnvironment(plan.Config, \"\", plan.Brief.Text, plan.notes); err != nil {\n   645\t\t\treturn ReviewRun{}, err\n   646\t\t}\n   647\t\trun := ReviewRun{Provenance: plan.provenance, BriefNotes: plan.notes, LimitOf: plan.LimitOf, SchemaVersion: 1, Scope: plan.Brief.Scope, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest,\n   648\t\t\tSealedCommit: plan.SealedCommit, Kind: plan.Brief.Kind, BriefDigest: plan.Brief.Digest, Adapter: plan.Adapter,\n   649\t\t\tVendor: plan.Config.Vendor, Model: plan.Config.Model, Reason: plan.Reason, PolicyDigest: plan.PolicyDigest, StartedAt: now().UTC().Format(time.RFC3339Nano), ExitCode: -1,\n   650\t\t\tLabel: plan.Label, Purpose: plan.Purpose, Lead: plan.Lead, Events: plan.Config.Events, Routing: plan.Routing, Round: plan.round, Thread: plan.thread}\n   651\t\timpl := plan.Implementation()\n   652\t\trun.IndependenceAchieved = AchievedIndependence(impl.Vendor, impl.Model, plan.Config.Vendor, plan.Config.Model)\n   653\t\tsafety, err := ResolveReviewerContainment(plan.Config)\n   654\t\tif err != nil {\n   655\t\t\treturn ReviewRun{}, err\n   656\t\t}\n   657\t\tif err := validateReviewNotes(plan.notes); err != nil {\n   658\t\t\treturn ReviewRun{}, err\n   659\t\t}\n   660\t\trun.Safety = safety\n   661\t\tvar cleanup func() error\n   662\t\tvar cleanupErr error\n   663\t\tvar terminationFailed bool\n   664\t\tcleaned := false\n   665\t\tdoCleanup := func() {\n   666\t\t\tif cleaned {\n   667\t\t\t\treturn\n   668\t\t\t}\n   669\t\t\tcleaned = true\n   670\t\t\toutcome := NewOperationResult(\"review.dispatch.cleanup\", run.Scope)\n   671\t\t\toutcome.StepsRun = append(outcome.StepsRun, OperationStep{ID: \"cleanup\", Result: \"done\"})\n   672\t\t\tif terminationFailed {\n   673\t\t\t\tcleanupErr = fmt.Errorf(\"process termination incomplete; runtime resources retained\")\n   674\t\t\t} else if cleanup != nil {\n   675\t\t\t\tcleanupErr = cleanup()\n   676\t\t\t}\n   677\t\t\tif cleanupErr != nil {\n   678\t\t\t\toutcome.StepsRun[0].Result = \"failed\"\n   679\t\t\t\toutcome.Fail(OutcomeFailed, \"cleanup\", \"cleanup-incomplete\", cleanupErr.Error())\n   680\t\t\t\toutcome.Unconfirmed = []OperationUncertain{{Step: \"cleanup\", Reason: \"owned resources may remain; no automatic respawn\"}}\n   681\t\t\t} else {\n   682\t\t\t\toutcome.Outcome = OutcomeCompleted\n   683\t\t\t}\n   684\t\t\trun.Safety.Operation = outcome\n   685\t\t}\n   686\t\tdefer func() {\n   687\t\t\tdoCleanup()\n   688\t\t\tif cleanupErr != nil {\n   689\t\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n   690\t\t\t}\n   691\t\t}()\n   692\t\ttranscript := []byte{}\n   693\t\tfinish := func(status, failure string) (ReviewRun, error) {\n   694\t\t\tdoCleanup()\n   695\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n   696\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n   697\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n   698\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n   699\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n   700\t\t\t}\n   701\t\t\trun.sessionForRedaction = \"\"\n   702\t\t\trun.Status, run.Failure = status, failure\n   703\t\t\tif status != ReviewRunInterrupted {\n   704\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n   705\t\t\t}\n   706\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n   707\t\t\treturn s.recordReviewRun(run, transcript)\n   708\t\t}\n   709\t\t// Recompute semantic freshness at execution time, not just preview time.\n   710\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n   711\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   712\t\t}\n   713\t\tvar attempt DelegatedReviewAttempt\n   714\t\tif plan.predecessor == nil {\n   715\t\t\tvar err error\n   716\t\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n   717\t\t\tif err != nil {\n   718\t\t\t\treturn ReviewRun{}, err\n   719\t\t\t}\n   720\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n   721\t\t} else {\n   722\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n   723\t\t\tfresh, err := s.replanContinuation(plan)\n   724\t\t\tif err != nil {\n   725\t\t\t\treturn ReviewRun{}, err\n   726\t\t\t}\n   727\t\t\tif fresh.PendingContinuation != nil {\n   728\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n   729\t\t\t}\n   730\t\t\tif fresh.Existing != nil {\n   731\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n   732\t\t\t}\n   733\t\t\tplan = fresh\n   734\t\t\trun.Provenance = fresh.provenance\n   735\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n   736\t\t\tif fresh.handoff {\n   737\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n   738\t\t\t} else {\n   739\t\t\t\trun.Resumes = fresh.predecessor.RunID\n   740\t\t\t}\n   741\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n   742\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n   743\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n   744\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n   745\t\t\t\treturn ReviewRun{}, err\n   746\t\t\t}\n   747\t\t}\n   748\t\t// The attempt result is published once: before the active marker goes\n   749\t\t// when the run was marked, at return otherwise (spec\n   750\t\t// pose-delegation-result-before-marker R1–R2).\n   751\t\tresultPublished := false\n   752\t\treserved := plan.predecessor != nil\n   753\t\tpublishResult := func() {\n   754\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n   755\t\t\t\treturn\n   756\t\t\t}\n   757\t\t\tresultPublished = true\n   758\t\t\tbeforeRunResultPublished(result)\n   759\t\t\tvar err error\n   760\t\t\tif plan.predecessor == nil {\n   761\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n   762\t\t\t} else {\n   763\t\t\t\terr = s.finishReviewContinuation(result)\n   764\t\t\t}\n   765\t\t\tif err != nil {\n   766\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n   767\t\t\t}\n   768\t\t}\n   769\t\tdefer publishResult()\n   770\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n   771\t\tif err != nil {\n   772\t\t\tif plan.predecessor == nil {\n   773\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n   774\t\t\t\t// receipt are recorded against it, as before the marker moved\n   775\t\t\t\t// ahead of the reservation (spec\n   776\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n   777\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n   778\t\t\t\t\treturn ReviewRun{}, perr\n   779\t\t\t\t}\n   780\t\t\t\treserved = true\n   781\t\t\t}\n   782\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n   783\t\t}\n   784\t\tif plan.predecessor == nil {\n   785\t\t\tbeforeAttemptPublished(s, attempt)\n   786\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n   787\t\t\t\tstopActive()\n   788\t\t\t\treturn ReviewRun{}, err\n   789\t\t\t}\n   790\t\t\treserved = true\n   791\t\t}\n   792\t\t// The marker goes only once the record and the attempt result are\n   793\t\t// published: without them it is the one trace of the reserved attempt,\n   794\t\t// and a waiter that sees it gone must find the receipt.\n   795\t\tdefer func() {\n   796\t\t\tpublishResult()\n   797\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n   798\t\t}()\n   799\t\tcancelled = cancelFlag\n   800\t\t// A detached run that cannot hand its attempt back stops here: nobody\n   801\t\t// would know which attempt runs (R1).\n   802\t\tif plan.OnStart != nil {\n   803\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n   804\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n   805\t\t\t}\n   806\t\t}\n   807\t\ttmp, err := os.MkdirTemp(\"\", \"pose-review-run-*\")\n   808\t\tif err != nil {\n   809\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed\")\n   810\t\t}\n   811\t\tsafety.RuntimeID = filepath.Base(tmp)\n   812\t\towned, err := os.Lstat(tmp)\n   813\t\tif err != nil {\n   814\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n   815\t\t}\n   816\t\truntimeRoot, err := os.OpenRoot(tmp)\n   817\t\tif err != nil {\n   818\t\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n   819\t\t}\n   820\t\tdefer runtimeRoot.Close()\n   821\t\tvar worktreeOwned os.FileInfo\n   822\t\tvar gitMarker []byte\n   823\t\tvar ownership *reviewCleanupOwnership\n   824\t\tworktree := filepath.Join(tmp, \"worktree\")\n   825\t\tcleanup = func() error {\n   826\t\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n   827\t\t}\n   828\t\thooks := filepath.Join(tmp, \"empty-hooks\")\n   829\t\tif err := os.Mkdir(hooks, 0700); err != nil {\n   830\t\t\treturn finish(ReviewRunFailed, \"private hook directory setup failed\")\n   831\t\t}\n   832\t\tsetupCtx, stopSetup := context.WithTimeout(parent, 2*time.Minute)\n   833\t\tdefer stopSetup()\n   834\t\tsetup := reviewSetupCommand(setupCtx, gitCommand(\"-C\", s.Root, \"-c\", \"core.hooksPath=\"+hooks, \"worktree\", \"add\", \"--detach\", worktree, plan.SealedCommit))\n   835\t\tsetupOutput := &reviewBoundedCapture{limit: 64 << 10, cancel: stopSetup}\n   836\t\tsetup.Stdout, setup.Stderr = setupOutput, setupOutput\n   837\t\tsetupErr := setup.Run()\n   838\t\t_, setupOverflow := setupOutput.result()\n   839\t\tterminationErr := killProcessGroup(setup)\n   840\t\tif terminationErr != nil {\n   841\t\t\tterminationFailed = true\n   842\t\t}\n   843\t\tsetupCause := executionCause(setupCtx)\n   844\t\tif setupErr != nil || terminationErr != nil || setupOverflow {\n   845\t\t\tsafety.ExecutionCause = setupCause\n   846\t\t\tif setupOverflow {\n   847\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   848\t\t\t}\n   849\t\t\treturn finish(ReviewRunFailed, \"review worktree setup failed or termination incomplete\")\n   850\t\t}\n   851\t\n   852\t\tworktreeOwned, err = os.Lstat(worktree)\n   853\t\tif err != nil {\n   854\t\t\treturn finish(ReviewRunFailed, \"worktree identity unavailable\")\n   855\t\t}\n   856\t\tgitMarker, err = ReadReviewAdapterFile(filepath.Join(worktree, \".git\"), 4096)\n   857\t\tif err != nil {\n   858\t\t\treturn finish(ReviewRunFailed, \"worktree marker unavailable\")\n   859\t\t}\n   860\t\townership, err = s.captureReviewCleanupOwnership(runtimeRoot, worktree, gitMarker)\n   861\t\tif err != nil {\n   862\t\t\treturn finish(ReviewRunFailed, \"worktree registration ownership unavailable\")\n   863\t\t}\n   864\t\tdefer ownership.registry.Close()\n   865\t\n   866\t\tsubmodules := map[string]bool{}\n   867\t\tfor _, entry := range plan.Bundle.Payload.Subject.Entries {\n   868\t\t\tif entry.Class == \"submodule\" {\n   869\t\t\t\tsubmodules[reviewBundleEntryPath(entry)] = true\n   870\t\t\t}\n   871\t\t}\n   872\t\tcommittedWorktreeBytes := ownership.inventoryBytes - gitSnapshotMarginBytes\n   873\t\tgitlinks := reviewGitlinkSetup{\n   874\t\t\tctx: setupCtx, cancel: stopSetup, hooks: hooks,\n   875\t\t\tmetadata:          filepath.Join(tmp, reviewGitlinkMetadataDir),\n   876\t\t\tmaxCommittedBytes: gitSnapshotCeilingBytes - committedWorktreeBytes,\n   877\t\t}\n   878\t\tgitlinkErr := gitlinks.materialize(s.Root, worktree, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries)\n   879\t\townership.inventoryBytes = gitSnapshotBudget(committedWorktreeBytes + gitlinks.committedBytes)\n   880\t\townership.gitlinkMetadata = gitlinks.metadataOwned\n   881\t\townership.gitlinkMetadataBytes = gitSnapshotBudget(gitlinks.committedBytes)\n   882\t\tif gitlinkErr != nil {\n   883\t\t\tterminationFailed = gitlinks.terminationFailure\n   884\t\t\tsafety.ExecutionCause = executionCause(setupCtx)\n   885\t\t\tif gitlinks.captureOverflow {\n   886\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n   887\t\t\t}\n   888\t\t\treturn finish(ReviewRunFailed, \"sealed gitlink setup failed: \"+gitlinkErr.Error())\n   889\t\t}\n   890\t\tstopSetup()\n   891\t\tcheckout := s\n   892\t\tcheckout.Root, checkout.indexPin = worktree, nil\n   893\t\tif prepared, err := checkout.PrepareReviewBundle(plan.Brief.Scope); err != nil {\n   894\t\t\treturn finish(ReviewRunFailed, \"sealed checkout inputs unavailable: \"+err.Error())\n   895\t\t} else if blockers := checkoutBlockers(prepared.Blockers); len(blockers) > 0 {\n   896\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout blocked: %v\", blockers))\n   897\t\t} else if differing := sealedInputsThatDiffer(plan.Bundle, prepared, worktree); len(differing) > 0 {\n   898\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout inputs differ: %v\", differing))\n   899\t\t}\n   900\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n","exit_code":0,"status":"completed"}}
