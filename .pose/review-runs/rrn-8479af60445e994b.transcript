    76\t\thash := sha256.New()\n    77\t\thash.Write([]byte(engineVersion + \"\\x00\" + store.FederatedProjectID + \"\\x00\"))\n    78\t\thashed := 0\n    79\t\tfor _, name := range names {\n    80\t\t\troot, err := filepath.Abs(roots[name])\n    81\t\t\tif err != nil {\n    82\t\t\t\treturn \"\", false\n    83\t\t\t}\n    84\t\t\tstate, count, ok := repositoryState(root)\n    85\t\t\tif !ok {\n    86\t\t\t\treturn \"\", false\n    87\t\t\t}\n    88\t\t\thashed += count\n    89\t\t\tif hashed > indexMaterialStateLimit {\n    90\t\t\t\treturn \"\", false\n    91\t\t\t}\n    92\t\t\thash.Write([]byte(name + \"\\x00\" + root + \"\\x00\" + state + \"\\x00\"))\n    93\t\t}\n    94\t\treturn \"sha256:\" + hex.EncodeToString(hash.Sum(nil)), true\n    95\t}\n    96\t\n    97\t// repositoryState digests a repository's HEAD, its status and the bytes of\n    98\t// the paths its status lists, and counts those paths.\n    99\tfunc repositoryState(root string) (string, int, bool) {\n   100\t\t// Without optional locks, so status does not refresh and rewrite the\n   101\t\t// index file the operation's read view observes.\n   102\t\tenv := []string{\"GIT_OPTIONAL_LOCKS=0\", \"LC_ALL=C\", \"LANGUAGE=C\"}\n   103\t\thead, err := gitOutputIn(root, env, \"rev-parse\", \"--verify\", \"HEAD\")\n   104\t\tif err != nil {\n   105\t\t\treturn \"\", 0, false\n   106\t\t}\n   107\t\tstatus, err := gitOutputIn(root, env, \"status\", \"--porcelain=v1\", \"-z\", \"--untracked-files=all\", \"--ignore-submodules=none\")\n   108\t\tif err != nil {\n   109\t\t\treturn \"\", 0, false\n   110\t\t}\n   111\t\thash := sha256.New()\n   112\t\thash.Write([]byte(strings.TrimSpace(head) + \"\\x00\" + status + \"\\x00\"))\n   113\t\tcount := 0\n   114\t\trecords := strings.Split(status, \"\\x00\")\n   115\t\tfor i := 0; i < len(records); i++ {\n   116\t\t\trecord := records[i]\n   117\t\t\tif len(record) < 4 {\n   118\t\t\t\tcontinue\n   119\t\t\t}\n   120\t\t\tpath := record[3:]\n   121\t\t\tif record[0] == 'R' || record[0] == 'C' {\n   122\t\t\t\ti++ // the source path of a rename or copy follows\n   123\t\t\t}\n   124\t\t\tcount++\n   125\t\t\tfull := filepath.Join(root, filepath.FromSlash(path))\n   126\t\t\tinfo, err := os.Lstat(full)\n   127\t\t\tswitch {\n   128\t\t\tcase err != nil:\n   129\t\t\t\thash.Write([]byte(path + \"\\x00missing\\x00\"))\n   130\t\t\tcase info.IsDir():\n   131\t\t\t\thash.Write([]byte(path + \"\\x00dir\\x00\"))\n   132\t\t\tcase info.Mode()&os.ModeSymlink != 0:\n   133\t\t\t\ttarget, _ := os.Readlink(full)\n   134\t\t\t\thash.Write([]byte(path + \"\\x00link\\x00\" + target + \"\\x00\"))\n   135\t\t\tdefault:\n   136\t\t\t\traw, err := os.ReadFile(full)\n   137\t\t\t\tif err != nil {\n   138\t\t\t\t\treturn \"\", 0, false\n   139\t\t\t\t}\n   140\t\t\t\tsum := sha256.Sum256(raw)\n   141\t\t\t\thash.Write([]byte(path + \"\\x00\" + hex.EncodeToString(sum[:]) + \"\\x00\"))\n   142\t\t\t}\n   143\t\t}\n   144\t\treturn hex.EncodeToString(hash.Sum(nil)), count, true\n   145\t}\n","exit_code":0,"status":"completed"}}
