{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/internal/pose/governance_read_view_index_test.go; sed -n '2640,2685p' pose-mcp/internal/pose/governance_read_view.go; sed -n '435,480p' pose-mcp/internal/pose/release_manifest_integrity.go; sed -n '1,120p' pose-mcp/internal/pose/index_federated_material_test.go; rg -n 'func .*ListSpecs|func .*LoadSpec' pose-mcp/internal/pose/spec*.go; rg -n 'limit|timeout|capture' pose-mcp/internal/pose/release_manifest_integrity.go\"","aggregated_output":"package pose\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc governanceReadViewIndexConsumer(t *testing.T, store Store, inputs map[string]string, publish bool, legacy bool) (Store, *governanceReadView, string) {\n\tt.Helper()\n\tproject := DefaultProjectID(store.Root)\n\troots := NewRootsIn(NativeFiles(), RootsConfig{DefaultRoot: store.Root, DefaultProjectID: project})\n\tresolver := ArtifactResolver{Roots: roots, FS: NativeFiles()}\n\tstore.FederatedProjectID = project\n\tstore.FederatedResolver = &resolver\n\tif publish {\n\t\tif _, err := store.PublishIndexGeneration(outputsFor(\"current\"), inputs); err != nil {\n\t\t\tt.Fatalf(\"publish fixture index generation: %v\", err)\n\t\t}\n\t}\n\tif legacy {\n\t\tpath := filepath.Join(indexDir(store.Root), \"repo-map.json\")\n\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(path, outputsFor(\"legacy\")[\"repo-map.json\"], 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tbase, view := store.beginGovernanceReadView()\n\treturn base.withGovernanceReadView(view, \"index-consumer\").PinIndexes(), view, project\n}\n\nfunc governanceReadViewIndexInputs(t *testing.T, store Store) map[string]string {\n\tt.Helper()\n\tinputs := IndexInputBindingsIn(NativeFiles(), store.Root)\n\tfor _, name := range IndexInputNames {\n\t\tif strings.TrimSpace(inputs[name]) == \"\" {\n\t\t\tt.Fatalf(\"fixture could not bind required index input %q\", name)\n\t\t}\n\t}\n\treturn inputs\n}\n\nfunc governanceReadViewIndexUnknown(t *testing.T, view *governanceReadView, producer string) []string {\n\tt.Helper()\n\tif view == nil || view.operation == nil {\n\t\tt.Fatal(\"read view has no operation\")\n\t}\n\treturn view.operation.audit().UnknownProducers[producer]\n}\n\nfunc TestGovernanceReadViewIndexConsumptionChecksBoundInputsOnlyWhenUsed(t *testing.T) {\n\tgovernanceReadViewProbeUseKnownEngineVersion(t)\n\n\tt.Run(\"current bindings remain current\", func(t *testing.T) {\n\t\tstore := obligationFixture(t)\n\t\tinputs := governanceReadViewIndexInputs(t, store)\n\t\treader, view, _ := governanceReadViewIndexConsumer(t, store, inputs, true, false)\n\t\traw, status, err := reader.ReadIndex(\"repo-map.json\")\n\t\tif err != nil || status != IndexGenerationCurrent || tagOf(t, raw) != \"current\" {\n\t\t\tt.Fatalf(\"ReadIndex = %q, %s, %v\", raw, status, err)\n\t\t}\n\t\tif reasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\"); len(reasons) != 0 {\n\t\t\tt.Fatalf(\"current bound index input set made the consumer unknown: %v\", reasons)\n\t\t}\n\t})\n\n\tt.Run(\"stale binding is localized to the consumer\", func(t *testing.T) {\n\t\tstore := obligationFixture(t)\n\t\tinputs := governanceReadViewIndexInputs(t, store)\n\t\tif _, err := store.PublishIndexGeneration(outputsFor(\"current\"), inputs); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\treader, view, _ := governanceReadViewIndexConsumer(t, store, nil, false, false)\n\t\tpath := filepath.Join(reader.Root, \".pose\", \"specs\", \"2026-10-02-consumer.md\")\n\t\tbody, err := os.ReadFile(path)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tbody = append(body, []byte(\"\\n<!-- changed after index publication -->\\n\")...)\n\t\tif err := os.WriteFile(path, body, 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\traw, status, err := reader.ReadIndex(\"repo-map.json\")\n\t\tif err != nil || status != IndexGenerationCurrent || tagOf(t, raw) != \"current\" {\n\t\t\tt.Fatalf(\"stale inputs made the pinned index unavailable: %q, %s, %v\", raw, status, err)\n\t\t}\n\t\treasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\")\n\t\tif len(reasons) == 0 {\n\t\t\tt.Fatal(\"a consumed index with stale source bindings left its consumer current\")\n\t\t}\n\t\tif !strings.Contains(strings.Join(reasons, \" \"), \"index input specs changed\") {\n\t\t\tt.Fatalf(\"stale specs input was not disclosed: %v\", reasons)\n\t\t}\n\t\tif len(governanceReadViewIndexUnknown(t, view, \"projection\")) != 0 {\n\t\t\tt.Fatalf(\"a stale consumed index blocked the whole projection: %v\", governanceReadViewIndexUnknown(t, view, \"projection\"))\n\t\t}\n\t})\n\n\tt.Run(\"missing required binding is unknown\", func(t *testing.T) {\n\t\tstore := obligationFixture(t)\n\t\tinputs := governanceReadViewIndexInputs(t, store)\n\t\tdelete(inputs, \"module-discovery\")\n\t\treader, view, _ := governanceReadViewIndexConsumer(t, store, inputs, true, false)\n\t\tif _, status, err := reader.ReadIndex(\"repo-map.json\"); err != nil || status != IndexGenerationCurrent {\n\t\t\tt.Fatalf(\"index bytes were not retained for diagnosis: status=%s err=%v\", status, err)\n\t\t}\n\t\treasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\")\n\t\tif !strings.Contains(strings.Join(reasons, \" \"), \"does not bind input module-discovery\") {\n\t\t\tt.Fatalf(\"missing module-discovery binding was not disclosed: %v\", reasons)\n\t\t}\n\t})\n\n\tt.Run(\"legacy index is unknown when consumed\", func(t *testing.T) {\n\t\treader, view, _ := governanceReadViewIndexConsumer(t, obligationFixture(t), nil, false, true)\n\t\tif _, status, err := reader.ReadIndex(\"repo-map.json\"); err != nil || status != IndexGenerationLegacy {\n\t\t\tt.Fatalf(\"legacy bytes were not retained for diagnosis: status=%s err=%v\", status, err)\n\t\t}\n\t\tif reasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\"); len(reasons) == 0 || !strings.Contains(strings.Join(reasons, \" \"), \"legacy index\") {\n\t\t\tt.Fatalf(\"legacy index use did not make its consumer unknown: %v\", reasons)\n\t\t}\n\t})\n\n\tt.Run(\"unused indexes do not poison coverage\", func(t *testing.T) {\n\t\tstore := obligationFixture(t)\n\t\tinputs := governanceReadViewIndexInputs(t, store)\n\t\tif _, err := store.PublishIndexGeneration(outputsFor(\"current\"), inputs); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\t_, view := store.beginGovernanceReadView()\n\t\tif reasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\"); len(reasons) != 0 {\n\t\t\tt.Fatalf(\"unused index inputs made the consumer unknown: %v\", reasons)\n\t\t}\n\t})\n\n\tt.Run(\"missing legacy output remains a not-exist result\", func(t *testing.T) {\n\t\treader, view, _ := governanceReadViewIndexConsumer(t, obligationFixture(t), nil, false, false)\n\t\t_, status, err := reader.ReadIndex(\"repo-map.json\")\n\t\tif status != IndexGenerationLegacy || !errors.Is(err, os.ErrNotExist) {\n\t\t\tt.Fatalf(\"missing legacy index = status %s, err %v\", status, err)\n\t\t}\n\t\tif reasons := governanceReadViewIndexUnknown(t, view, \"index-consumer\"); len(reasons) != 0 {\n\t\t\tt.Fatalf(\"proven missing legacy index made its consumer unknown: %v\", reasons)\n\t\t}\n\t})\n}\n\t}\n\tfor project, conflict := range roots.conflicts {\n\t\tclone.conflicts[project] = conflict\n\t}\n\tfor project, store := range roots.governanceStores {\n\t\tclone.governanceStores[project] = store\n\t}\n\troots.mu.RUnlock()\n\treturn clone\n}\n\nfunc (op *governanceReadViewOperation) rootsForProducer(roots *Roots, files Files, producer string) *Roots {\n\tif roots == nil || op == nil {\n\t\treturn nil\n\t}\n\troots.mu.RLock()\n\tcfg := roots.cfg\n\troots.mu.RUnlock()\n\top.mu.Lock()\n\trootMap, conflicts := op.initialRoots, op.initialConflicts\n\top.mu.Unlock()\n\treturn &Roots{\n\t\tcfg: cfg, byProject: rootMap, conflicts: conflicts, governanceStores: map[string]Store{},\n\t\tlastScan: time.Now(), rescanWindow: time.Duration(1 << 62), fs: files,\n\t}\n}\n\ntype readViewFile struct {\n\treader  *bytes.Reader\n\tinfo    fs.FileInfo\n\treadErr error\n}\n\nfunc newGovernanceReadFile(data []byte, info fs.FileInfo, readErrors ...error) *readViewFile {\n\tvar readErr error\n\tif len(readErrors) > 0 {\n\t\treadErr = readErrors[0]\n\t}\n\treturn &readViewFile{reader: bytes.NewReader(data), info: frozenInfo(info), readErr: readErr}\n}\nfunc (f *readViewFile) Stat() (fs.FileInfo, error) {\n\tif f.info == nil {\n\t\treturn nil, fs.ErrInvalid\n\t}\n\treturn f.info, nil\n}\n\tannotated bool\n\terr       error\n}\n\nfunc gitOutput(root string, args ...string) (string, error) {\n\treturn gitOutputIn(root, nil, args...)\n}\n\n// gitOutputUntranslated runs git in the C locale, for the callers that read what git says: a\n// translated git words the same answer differently.\nfunc gitOutputUntranslated(root string, args ...string) (string, error) {\n\treturn gitOutputIn(root, []string{\"LC_ALL=C\"}, args...)\n}\n\nfunc gitOutputIn(root string, env []string, args ...string) (string, error) {\n\tcmd := RawHistoryGit(root, args...)\n\tif env != nil {\n\t\tcmd.Env = append(cmd.Env, env...)\n\t}\n\tvar stderr bytes.Buffer\n\tcmd.Stderr = &stderr\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\treturn \"\", &gitCommandError{Op: args[0], Stderr: strings.TrimSpace(stderr.String()), Err: err}\n\t}\n\tif strings.TrimSpace(stderr.String()) != \"\" {\n\t\treturn \"\", &gitCommandError{Op: args[0], Stderr: strings.TrimSpace(stderr.String()), Err: errors.New(\"Git reported an incomplete or uncertain result\")}\n\t}\n\treturn string(out), nil\n}\n\n// ListReleaseTags preserves warnings about broken refs as incomplete inventory.\n// Git may omit a broken loose tag while returning success; absence cannot be inferred.\nfunc ListReleaseTags(root string) (string, error) {\n\treturn gitOutput(root, \"tag\", \"--list\", \"v*\")\n}\n\n// gitTreeEntry looks one path up in a commit's tree. found=false with a nil error is the tree\n// proving the path is not there; any failure to read the tree is an error, never absence.\nfunc gitTreeEntry(root, commit, rel string) (mode, kind, object string, found bool, err error) {\n\tout, err := gitOutput(root, \"ls-tree\", \"-z\", commit, \"--\", rel)\n\tif err != nil {\n\t\treturn \"\", \"\", \"\", false, err\n\t}\n\tmeta, name, ok := strings.Cut(strings.TrimSuffix(out, \"\\x00\"), \"\\t\")\n\tfields := strings.Fields(meta)\npackage pose\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"testing\"\n)\n\nfunc TestIndexFederatedMaterialBindsReferencedSemanticsOnly(t *testing.T) {\n\tlocal, foreign, unrelated := t.TempDir(), t.TempDir(), t.TempDir()\n\tfor root, project := range map[string]string{local: \"proj.local\", foreign: \"proj.foreign\", unrelated: \"proj.unrelated\"} {\n\t\tif err := os.MkdirAll(filepath.Join(root, \".pose\", \"specs\"), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.MkdirAll(filepath.Join(root, \".pose\", \"roadmaps\"), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tqualifiedFile(t, root, \"project.json\", `{\"schema_version\":1,\"project_id\":\"`+project+`\"}`)\n\t}\n\tqualifiedFile(t, local, \"specs/consumer.md\", \"---\\nslug: consumer\\nstatus: in-progress\\ndepends_on: xref:proj.foreign/spec:engine\\n---\\n# Consumer\\n\")\n\tqualifiedFile(t, local, \"roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\nconsumes: xref:proj.foreign/spec:engine\\n---\\n\")\n\tqualifiedFile(t, foreign, \"specs/engine.md\", \"---\\nslug: engine\\nstatus: done\\n---\\n# Engine v1\\n\")\n\tqualifiedFile(t, unrelated, \"specs/other.md\", \"---\\nslug: other\\nstatus: done\\n---\\n# Other v1\\n\")\n\n\tbindings, err := json.Marshal(map[string]string{\n\t\t\"proj.local\": local, \"proj.foreign\": foreign, \"proj.unrelated\": unrelated,\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"POSE_DEFAULT_PROJECT_ID\", \"\")\n\tt.Setenv(\"POSE_PROJECT_ROOTS\", string(bindings))\n\tresolver, project, err := EnvironmentArtifactResolverIn(NativeFiles(), local, \"\")\n\tif err != nil || project != \"proj.local\" {\n\t\tt.Fatalf(\"resolver = %q, %v\", project, err)\n\t}\n\tstore := Store{Root: local, FS: NativeFiles(), FederatedProjectID: project, FederatedResolver: &resolver}\n\tbefore, err := BuildIndexFederatedMaterialIn(store)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !reflect.DeepEqual(before.Projects, []string{\"proj.foreign\"}) {\n\t\tt.Fatalf(\"material roots = %v, want only the referenced foreign project\", before.Projects)\n\t}\n\tif len(before.Projection.Specs) != 1 || len(before.Projection.Roadmaps) != 1 {\n\t\tt.Fatalf(\"federated projection omitted an output input: specs=%d roadmaps=%d\", len(before.Projection.Specs), len(before.Projection.Roadmaps))\n\t}\n\tbeforeDigest, known := IndexFederatedMaterialDigest(before.Projection)\n\tif !known || beforeDigest == \"\" {\n\t\tt.Fatal(\"semantic material digest was unknown\")\n\t}\n\tbound, known := IndexInputBindingIn(NativeFiles(), local, \"federated-material\")\n\tif !known || bound != beforeDigest {\n\t\tt.Fatalf(\"input binding did not use the shared projection: binding=%q projection=%q known=%v\", bound, beforeDigest, known)\n\t}\n\n\tqualifiedFile(t, unrelated, \"specs/other.md\", \"---\\nslug: other\\nstatus: draft\\n---\\n# Other unrelated edit\\n\")\n\tafterUnrelated, err := BuildIndexFederatedMaterialIn(store)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tunrelatedDigest, known := IndexFederatedMaterialDigest(afterUnrelated.Projection)\n\tif !known || unrelatedDigest != beforeDigest {\n\t\tt.Fatalf(\"unrelated root edit changed federated material digest: %q -> %q\", beforeDigest, unrelatedDigest)\n\t}\n\n\tqualifiedFile(t, foreign, \"specs/engine.md\", \"---\\nslug: engine\\nstatus: done\\n---\\n# Engine v2\\n\")\n\tafterForeign, err := BuildIndexFederatedMaterialIn(store)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tforeignDigest, known := IndexFederatedMaterialDigest(afterForeign.Projection)\n\tif !known || foreignDigest == beforeDigest {\n\t\tt.Fatalf(\"referenced foreign edit did not stale federated material: %q -> %q\", beforeDigest, foreignDigest)\n\t}\n\tbound, known = IndexInputBindingIn(NativeFiles(), local, \"federated-material\")\n\tif !known || bound != foreignDigest {\n\t\tt.Fatalf(\"foreign edit binding disagrees with builder projection: binding=%q projection=%q known=%v\", bound, foreignDigest, known)\n\t}\n\tif before.SpecDependencyResolutions[\"consumer\"][0].Digest == afterForeign.SpecDependencyResolutions[\"consumer\"][0].Digest {\n\t\tt.Fatal(\"foreign spec dependency digest did not track the changed content\")\n\t}\n\tif before.RoadmapAcceptances[\"program\"].Manifest.Digest == afterForeign.RoadmapAcceptances[\"program\"].Manifest.Digest {\n\t\tt.Fatal(\"federated roadmap acceptance digest did not track the changed dependency\")\n\t}\n}\n\nfunc TestIndexFederatedMaterialIgnoresUnrelatedCoordinatorCommit(t *testing.T) {\n\troot := t.TempDir()\n\tfor _, relative := range []string{\".pose/specs\", \".pose/roadmaps\", \".pose/policy\"} {\n\t\tif err := os.MkdirAll(filepath.Join(root, relative), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tqualifiedFile(t, root, \"project.json\", `{\"schema_version\":1,\"project_id\":\"proj.coordinator\"}`)\n\tqualifiedFile(t, root, \"specs/consumer.md\", \"---\\nslug: consumer\\nstatus: in-progress\\ndepends_on: xref:proj.coordinator/spec:dependency\\n---\\n# Consumer\\n\")\n\tqualifiedFile(t, root, \"specs/dependency.md\", \"---\\nslug: dependency\\nstatus: done\\n---\\n# Dependency\\n\")\n\tqualifiedFile(t, root, \"roadmaps/program.md\", \"---\\nslug: program\\nstatus: active\\nconsumes: xref:proj.coordinator/spec:dependency\\n---\\n\")\n\tif out, err := exec.Command(\"git\", \"-C\", root, \"init\", \"-q\").CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git init: %s: %v\", out, err)\n\t}\n\tfor _, args := range [][]string{\n\t\t{\"config\", \"user.name\", \"POSE fixture\"},\n\t\t{\"config\", \"user.email\", \"pose@example.invalid\"},\n\t\t{\"add\", \"--all\"},\n\t\t{\"commit\", \"-q\", \"-m\", \"coordinator baseline\"},\n\t} {\n\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...).CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %s: %v\", args, out, err)\n\t\t}\n\t}\n\tresolver := ArtifactResolver{Roots: NewRoots(RootsConfig{DefaultRoot: root, DefaultProjectID: \"proj.coordinator\"}), FS: NativeFiles()}\n\tstore := Store{Root: root, FS: NativeFiles(), FederatedProjectID: \"proj.coordinator\", FederatedResolver: &resolver}\n\tbefore, err := BuildIndexFederatedMaterialIn(store)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\npose-mcp/internal/pose/spec_test.go:157:func TestListSpecs_SortedNoBody(t *testing.T) {\npose-mcp/internal/pose/spec_test.go:177:func TestListSpecs_StatusFilter(t *testing.T) {\npose-mcp/internal/pose/spec_test.go:199:func TestListSpecs_MultiStatusFilter(t *testing.T) {\npose-mcp/internal/pose/spec_test.go:237:func TestListSpecs_ComponentsFilter(t *testing.T) {\npose-mcp/internal/pose/spec.go:296:func (s Store) ListSpecs(status, components string) ([]Spec, error) {\n263:// captureReleaseTagBindings fixes release tag names and object identities from\n264:// one bounded Git listing. Annotated tags are peeled from their captured object\n266:func captureReleaseTagBindings(files Files, root, producer string) (map[string]releaseTagBinding, error) {\n269:\traw, err := captureGovernanceGit(files, root, producer, \"for-each-ref\", \"--format=%(refname:strip=2)%00%(objectname)%00%(objecttype)\", \"refs/tags\")\n301:\t\t\tcommit, peelErr := captureGovernanceGit(files, root, producer, \"rev-parse\", \"--verify\", \"--quiet\", fields[1]+\"^{commit}\")\n307:\t\t\t\t\tmarkGovernanceReadUnknown(files, root, producer, \"captured annotated tag did not yield a commit identity\")\n308: