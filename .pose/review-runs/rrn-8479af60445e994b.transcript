view.md\n.pose/knowledge/2026-10-14-decision-log-adr-shared-worktree-runtime-review.md\n.pose/knowledge/2026-08-13-decision-log-adr-component-aware-review-plans-review.md\n.pose/roadmaps/delegated-review.md\n.pose/workflows/review.md\n.pose/reports/2026-10-17-pose-b06-source-coverage-review.md\n.pose/reports/2026-08-03-delivery-integrity-roadmap-review.md\n.pose/reports/2026-10-18-pose-b28-independent-review.md\n.pose/reports/2026-08-03-release-evidence-trigger-fix-review.md\n.pose/reports/2026-08-15-standard-closeout-pose-v1-2-2-changelog-review.md\n.pose/reports/2026-10-18-pose-b28r3-independent-review.md\n.pose/reports/2026-10-17-pose-b15-index-generation-review.md\n.pose/reports/2026-10-19-b38r9-independent-review.md\n.pose/reports/2026-10-18-b07r4b-independent-review.md\n.pose/reports/2026-10-16-pose-b12-operation-results-review.md\n.pose/reports/2026-10-18-b38r6-independent-review.md\n.pose/reports/2026-10-17-pose-test-scripts-temp-cleanup-review.md\n.pose/reports/2026-10-18-pose-b30-independent-review.md\n.pose/reports/2026-08-02-governed-closeout-milestone-review.md\n.pose/reports/2026-10-19-b38r11-claude-independent-review.md\n.pose/reports/2026-10-18-pose-b30r3-independent-review.md\n.pose/reports/2026-10-15-pose-b01-disclosure-review.md\n.pose/reports/2026-10-18-b38r7-independent-review.md\n.pose/reports/2026-10-19-b38r8-independent-review.md\n.pose/reports/2026-10-24-b10-independent-review.md\n.pose/reports/2026-08-03-pose-artifact-provenance-ledger-review.md\n.pose/reports/2026-09-24-multirepo-autonomous-review.md\n.pose/reports/2026-10-18-b38-independent-review.md\n.pose/reports/2026-10-01-pr129-review.md\n.pose/reports/2026-08-03-release-closure-milestone-review.md\n.pose/reports/2026-10-18-pose-b28-d7ebc300-independent-review.md\n.pose/reports/2026-10-16-pose-b02-domain-preflight-review.md\n.pose/reports/2026-10-19-b38r12-claude-independent-review.md\n.pose/reports/2026-10-06-v7-validation-check-materiality-review.md\n.pose/reports/2026-09-21-qualified-artifact-resolution-review.md\n.pose/reports/2026-09-28-abm-dependency-review.md\n.pose/reports/2026-10-16-pose-b13-journal-checkpoint-lock-recovery-review.md\n.pose/reports/2026-10-18-pose-b28r4-independent-review.md\n.pose/reports/2026-08-03-provenance-foundation-milestone-review.md\n.pose/reports/2026-10-18-b38r4-independent-review.md\n.pose/reports/2026-10-18-b38r5-independent-review.md\n.pose/reports/2026-10-18-b07r2-independent-review.md\n.pose/reports/2026-08-03-pose-release-lifecycle-closure-review.md\n.pose/reports/2026-10-18-pose-b30r4-independent-review.md\n.pose/changelogs/v6.3.0/pose-extension-target-preview.md\n.pose/templates/review.md\n.pose/results/git-locale-independent-review/review.md\n.pose/starts/pose-index-material-is-kept-per-repository-state.json\n.pose/changelogs/v7.0.0/pose-update-configuration-review.md\n.pose/changelogs/v6.0.0/pose-abm-progressive-review.md\n.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n.pose/specs/2026-10-02-pose-extension-target-preview.md\n.pose/specs/2026-08-15-pose-v1-2-2-changelog-review.md\n.pose/specs/2026-10-05-pose-update-configuration-review.md\n.pose/specs/2026-11-16-pose-index-material-is-kept-per-repository-state.md\n.pose/specs/2026-09-19-pose-abm-progressive-review.md\npackage pose\n\nimport (\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\n// keptMaterialFixture is a consumer and a dependency repository, each with\n// one committed file, and a store whose resolver authorizes both. compute\n// counts the builds of the material.\nfunc keptMaterialFixture(t *testing.T) (Store, string, string, *int) {\n\tt.Helper()\n\trepo := func() string {\n\t\troot := t.TempDir()\n\t\tfor _, args := range [][]string{{\"init\", \"-q\"}} {\n\t\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...).CombinedOutput(); err != nil {\n\t\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t\t}\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(root, \"spec.md\"), []byte(\"one\\n\"), 0o600); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tcommitMaterialFixture(t, root)\n\t\treturn root\n\t}\n\tconsumer, dependency := repo(), repo()\n\tresolver := ArtifactResolver{Roots: NewRoots(RootsConfig{Explicit: map[string]string{\"proj.engine\": dependency}})}\n\tbuilds := 0\n\toriginal := indexMaterialCompute\n\tindexMaterialCompute = func(Store) (IndexFederatedMaterial, error) {\n\t\tbuilds++\n\t\treturn IndexFederatedMaterial{Projects: []string{\"proj.engine\"}}, nil\n\t}\n\tkeptIndexMaterial.clear()\n\tt.Cleanup(func() { indexMaterialCompute = original; keptIndexMaterial.clear() })\n\treturn Store{Root: consumer, FederatedProjectID: \"proj.local\", FederatedResolver: &resolver}, consumer, dependency, &builds\n}\n\nfunc commitMaterialFixture(t *testing.T, root string) {\n\tt.Helper()\n\tfor _, args := range [][]string{{\"add\", \"-A\"}, {\"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-qm\", \"c\"}} {\n\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...).CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t}\n}\n\n// Spec pose-index-material-is-kept-per-repository-state, R1: the material\n// of one state of every authorized repository is built once per process.\nfunc TestIndexMaterialIsBuiltOncePerRepositoryState(t *testing.T) {\n\tstore, _, _, builds := keptMaterialFixture(t)\n\tfirst, ok1 := IndexInputBindingForStoreIn(store, \"federated-material\")\n\tsecond, ok2 := IndexInputBindingForStoreIn(store, \"federated-material\")\n\tif !ok1 || !ok2 || first != second || *builds != 1 {\n\t\tt.Fatalf(\"builds=%d digests %q %q\", *builds, first, second)\n\t}\n}\n\n// R2: any change to an authorized repository's state builds it again: a\n// commit, a new untracked file, and a dirty file edited a second time, which\n// keeps the same status line.\nfunc TestIndexMaterialFollowsEveryRepositoryState(t *testing.T) {\n\tfor name, change := range map[string]func(t *testing.T, consumer, dependency string){\n\t\t\"dependency commit\": func(t *testing.T, _, dependency string) {\n\t\t\tif err := os.WriteFile(filepath.Join(dependency, \"spec.md\"), []byte(\"two\\n\"), 0o600); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tcommitMaterialFixture(t, dependency)\n\t\t},\n\t\t\"untracked file\": func(t *testing.T, consumer, _ string) {\n\t\t\tif err := os.WriteFile(filepath.Join(consumer, \"new.md\"), []byte(\"new\\n\"), 0o600); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t},\n\t\t\"dirty file edited again\": func(t *testing.T, _, dependency string) {\n\t\t\tif err := os.WriteFile(filepath.Join(dependency, \"spec.md\"), []byte(\"three\\n\"), 0o600); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t},\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\tstore, consumer, dependency, builds := keptMaterialFixture(t)\n\t\t\tif name == \"dirty file edited again\" {\n\t\t\t\tif err := os.WriteFile(filepath.Join(dependency, \"spec.md\"), []byte(\"dirty\\n\"), 0o600); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tIndexInputBindingForStoreIn(store, \"federated-material\")\n\t\t\tchange(t, consumer, dependency)\n\t\t\tIndexInputBindingForStoreIn(store, \"federated-material\")\n\t\t\tif *builds != 2 {\n\t\t\t\tt.Fatalf(\"a %s reused the kept material: %d builds\", name, *builds)\n\t\t\t}\n\t\t})\n\t}\n}\n\n// R3: a store without an explicit resolver, which names no complete set of\n// repositories, builds the material every time.\nfunc TestIndexMaterialWithoutAResolverIsNotKept(t *testing.T) {\n\tstore, _, _, builds := keptMaterialFixture(t)\n\tstore.FederatedResolver = nil\n\tIndexInputBindingForStoreIn(store, \"federated-material\")\n\tIndexInputBindingForStoreIn(store, \"federated-material\")\n\tif *builds != 2 {\n\t\tt.Fatalf(\"builds=%d, want 2\", *builds)\n\t}\n}\npackage pose\n\nimport \"sync\"\n\n// keptCache holds values computed from content-addressed inputs for the\n// process (spec pose-federated-proof-reads-each-input-once). A key is\n// computed once even when several callers miss it together: the first\n// computes, the others wait for it. A result the computation declines to\n// keep (a failed read) is not shared: the waiters acquire the key again.\n// Past its bound the kept values are dropped, for a long-running process;\n// a key being computed keeps its entry.\ntype keptCache[V any] struct {\n\tmu      sync.Mutex\n\tentries map[string]*keptEntry[V]\n\tbound   int\n\t// kept counts the completed, kept entries, which the bound limits.\n\tkept int\n}\n\ntype keptEntry[V any] struct {\n\tready chan struct{}\n\tvalue V\n\tkept  bool\n\tdone  bool\n}\n\nfunc newKeptCache[V any](bound int) *keptCache[V] {\n\treturn &keptCache[V]{entries: map[string]*keptEntry[V]{}, bound: bound}\n}\n\n// get returns the kept value of key, or computes it; compute reports whether\n// its result may be kept. A caller that waited for a result that was not\n// kept acquires the key again, so a recovered read is computed once and\n// shared (review round 2, N1).\nfunc (c *keptCache[V]) get(key string, compute func() (V, bool)) V {\n\tfor {\n\t\tc.mu.Lock()\n\t\tif entry, ok := c.entries[key]; ok {\n\t\t\tc.mu.Unlock()\n\t\t\t<-entry.ready\n\t\t\tif entry.kept {\n\t\t\t\treturn entry.value\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tentry := &keptEntry[V]{ready: make(chan struct{})}\n\t\tc.entries[key] = entry\n\t\tc.mu.Unlock()\n\t\tvalue, keep := compute()\n\t\tc.mu.Lock()\n\t\tentry.value, entry.kept, entry.done = value, keep, true\n\t\tif !keep && c.entries[key] == entry {\n\t\t\tdelete(c.entries, key)\n\t\t}\n\t\tif keep && c.entries[key] == entry {\n\t\t\tc.kept++\n\t\t\tc.evictLocked(key)\n\t\t}\n\t\tc.mu.Unlock()\n\t\tclose(entry.ready)\n\t\treturn value\n\t}\n}\n\n// evictLocked enforces the bound when a value is kept: past it, every other\n// completed value is dropped. A key still being computed keeps its entry,\n// so its waiters and a later caller never compute it twice (review rounds 2\n// and 3, N2 and N3).\nfunc (c *keptCache[V]) evictLocked(except string) {\n\tif c.kept <= c.bound {\n\t\treturn\n\t}\n\tfor key, entry := range c.entries {\n\t\tif entry.done && key != except {\n\t\t\tdelete(c.entries, key)\n\t\t\tc.kept--\n\t\t}\n\t}\n}\n\nfunc (c *keptCache[V]) clear() {\n\tc.mu.Lock()\n\tc.entries = map[string]*keptEntry[V]{}\n\tc.kept = 0\n\tc.mu.Unlock()\n}\n\nfunc (c *keptCache[V]) len() int {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\treturn len(c.entries)\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/specs/2026-11-16-pose-index-material-is-kept-per-repository-state.md; cat .pose/rules/backend-go.md .pose/rules/security.md .pose/rules/documentation-style.md .pose/rules/delivery-evidence.md .pose/workflows/review.md; cat pose-mcp/internal/pose/index_federated_material.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/specs/2026-11-16-pose-index-material-is-kept-per-repository-state.md; cat .pose/rules/backend-go.md .pose/rules/security.md .pose/rules/documentation-style.md .pose/rules/delivery-evidence.md .pose/workflows/review.md; cat pose-mcp/internal/pose/index_federated_material.go'","aggregated_output":"---\nslug: pose-index-material-is-kept-per-repository-state\nstatus: in-progress\ncreated_at: 2026-11-16\ncompleted_at:        # stamped on the transition to status: done\nsupersedes:          # slug of the superseded spec (when applicable)\ndepends_on:          # prerequisites, inline list: other-spec, milestone:<roadmap>/<id>, roadmap:<slug>\nremediates: spec:pose-check-shares-the-federated-material@defect-fix\npriority:            # integer >= 0 (lower = higher priority); ordering preference, not a blocker\ncomponents: pose-mcp\ntask_type: bugfix\nsurface:             # optional: minimal | standard | full (default) — minimal drops Tasks and derivable report sections; `pose specs facts <slug>` derives them\ndelivers: capability:index-material-is-kept-per-repository-state\n---\n\n# Spec: pose-index-material-is-kept-per-repository-state\n\n## 1. Intent\n\n### Goal\nFazer um processo do motor calcular o material federado de entrada do índice uma vez para cada estado dos repositórios autorizados, e não em cada operação de revisão.\n\n### Business value\nToda operação de revisão confere se o índice que lê está em dia, e o material federado é uma das entradas dessa conferência. No harne8, com o pose-dist como dependência e o pin em dia, esse cálculo levou cerca de 90 s de um `closeout-check` de 140 s (perfil de CPU: `BuildIndexFederatedMaterialIn`, por `checkIndexInputs`, 71% do tempo). Um servidor MCP de vida longa pagava isso em toda chamada. Os clientes do `conductor` esperam de 20 a 120 s, e o `TestReviewConfirmationRealEngine` passou de 31 minutos e reprovou numa chamada `pose_review_bundle`. A spec `pose-check-shares-the-federated-material` já compartilha o material dentro de um `check`; esta estende o compartilhamento entre operações do mesmo processo.\n\n### Constraints\n- O material guardado vale só enquanto os repositórios estão no mesmo estado; qualquer commit, arquivo novo ou edição recalcula.\n- Ler o estado não pode mudar nada que a read view observa.\n\n### Non-goals\n- Reduzir o custo da primeira construção do material, que fica para uma spec de paralelismo.\n\n---\n\n## 2. Requirements\n\n### Functional\n- R1: When an operation carries an explicit resolver, the engine shall keep, per process, the digest of the index's federated material for one state of the operation's root and of every root the resolver authorizes, and shall not build the material again for that state.\n- R2: The state shall cover the engine version, the project, and for each root its HEAD, its full status (tracked, untracked and submodule entries) and the bytes of every path that status lists; any commit, new or removed file, or edit of a listed file, including a second edit of a dirty file, shall build the material again.\n- R3: A store without an explicit resolver, or a state with more than 4,096 listed paths, shall build the material every time; a build that fails shall not be kept.\n- R4: Reading the state shall not write to the repository: Git runs without optional locks, so the read view observes no change.\n\n### Non-functional\n- No harne8, a segunda chamada `pose_closeout_state` de um mesmo servidor MCP cai de cerca de 136 s para menos de 30 s, com o mesmo veredito.\n\n### Security\n- Nenhuma mudança de autorização: a chave cobre exatamente as raízes que o resolvedor autoriza.\n\n### Compatibility\n- Um processo de uma operação só calcula o material uma vez, como antes.\n\n---\n\n## 3. Technical Plan\n\n### Affected areas\n- `pose/index_material_kept.go`: o cache e a chave de estado.\n- `pose/index_generation.go`: `IndexInputBindingForStoreIn` passa pelo cache para `federated-material`.\n\n### Artifacts\n- created: pose-mcp/internal/pose/index_material_kept.go\n- created: pose-mcp/internal/pose/index_material_kept_test.go\n- modified: pose-mcp/internal/pose/index_generation.go\n- modified: .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n- modified: .pose/indexes/validation-matrix.json\n\n### Delivery targets\n\n- capability:index-material-is-kept-per-repository-state module:pose-mcp profile:composed-capability entrypoint:pose-mcp/cmd/pose/main.go\n\nComposto em produção pelo servidor MCP e por toda operação de revisão que confere o índice. Check permanente `index-material-is-kept-per-repository-state-integration`, evidenceClass `integration`, required: `go test ./internal/pose -run 'TestIndexMaterialIsBuiltOncePerRepositoryState|TestIndexMaterialFollowsEveryRepositoryState|TestIndexMaterialWithoutAResolverIsNotKept' -count=1`.\n\n### API/contract changes\n- Nenhuma.\n\n### Data/storage changes\n- Nenhuma.\n\n### Technical risks\n- Um arquivo ignorado pelo Git que o material leia não entra na chave. O material lê specs, roadmaps, policies e registros de revisão, que são versionados.\n\n---\n\n## 4. Tasks\n\n### Implementation\n- [x] Cache por estado dos repositórios (R1, R2, R3).\n- [x] Leitura do estado sem locks opcionais (R4).\n- [x] Emenda D13 do ADR das leituras de governança.\n\n### Validation\n- [x] Testes do cache e de cada mudança de estado, com prova de reprovação; medição no harne8.\n\n---\n\n## 5. Decisions\n\n### Decision D1\n- Date: 2026-11-16\n- Context: o maintainer escolheu corrigir na origem o custo das chamadas MCP, em vez de subir os tetos dos clientes do conductor.\n- Options considered: (a) memo do material com chave nas leituras que ele faz; (b) chave no estado de cada repositório autorizado (HEAD, status, bytes dos caminhos listados).\n- Decision: (b), registrada como D13 do ADR.\n- Basis: R1, R2, R3, R4\n- Rationale: (a) precisaria saber de antemão tudo o que o material lê; (b) cobre qualquer leitura de um arquivo versionado ou não rastreado, e custa dois processos Git por raiz.\n- Consequences: o material só é recalculado quando um repositório muda.\n\n---\n\n## 6. Validation\n\n### Strategy\nTestes com dois repositórios git reais e um resolvedor que autoriza os dois; medição de duas chamadas MCP seguidas no harne8.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./internal/pose ./internal/cli ./internal/mcpserver ./internal/scaffold -count=1`\n- Scope: pose-mcp\n- Expected: verde\n\n### Execution log\n- Date: 2026-11-16\n- Environment: Linux, Go 1.26; clone limpo do harne8 em cc7780b1 com o pose-dist em 7e46b1e.\n- Notes: duas chamadas `pose_closeout_state` de `spec:harne8-abm-governed-execution` no mesmo servidor MCP: sem o cache, 138 s e 136 s; com ele, 138 s e 11 s, terminal nas quatro. A primeira versão lia o estado com `git status` comum, que regravava o índice do Git: a read view acusou \".git changed\" e o fechamento deixou de ser terminal; com `GIT_OPTIONAL_LOCKS=0`, o veredito voltou. Sem o hash dos bytes, um arquivo sujo editado de novo reaproveitava o material, e o teste reprova.\n\n### Results summary\n- Successes: a segunda chamada de um servidor MCP fica 12 vezes mais rápida, com o mesmo veredito.\n- Failures: nenhuma.\n- Warnings: a primeira chamada ainda leva cerca de 138 s.\n\n### Requirement trace\n- R1 [satisfied] test:TestIndexMaterialIsBuiltOncePerRepositoryState check:index-material-is-kept-per-repository-state-integration\n- R2 [satisfied] test:TestIndexMaterialFollowsEveryRepositoryState\n- R3 [satisfied] test:TestIndexMaterialWithoutAResolverIsNotKept\n- R4 [satisfied] O fechamento de harne8-abm-governed-execution continua terminal com o cache (log de execução).\n\n### Known gaps\n- R4 não tem teste automático próprio; foi provado pela medição no harne8.\n\n---\n\n## 7. Final Report\n\n### Delivered scope\n\nNão concluída.\n\n### Residual risks\n\n### Follow-ups\n\n- [open] F1: reduzir o custo da primeira construção do material federado (cerca de 90 s no harne8), por exemplo verificando em paralelo as dependências de outro projeto; com ela, a primeira chamada de um servidor MCP caberia nos tetos dos clientes do conductor. (owner:@pose-maintainers crit:high review:2026-11-23)\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Security\n\n## When to consult\n\nConsult this guide for authentication, authorization, sensitive data, external integrations, dependencies, and attack surfaces.\n\n## Required patterns\n\n- Apply least privilege to resource and credential access.\n- Store secrets only in appropriate secret-management mechanisms, never in code.\n- Validate and sanitize external input for its execution context.\n- Keep personal and confidential data out of plaintext logs and metrics.\n- Evaluate new dependencies for maintenance, licensing, and known vulnerabilities.\n- Test both positive and negative authentication and authorization cases.\n\n## Blocking anti-patterns\n\n- Committing credentials, tokens, keys, or secrets in any versioned artifact.\n- Disabling TLS or certificate verification without a formally documented mitigation.\n- Trusting client input for authorization decisions.\n- Executing dynamic commands without adequate validation and escaping.\n- Ignoring critical security alerts without an approved exception record.\n\n## Minimum checks\n\n- Run secret scanning on the changed diff or scope.\n- Run the module's applicable dependency vulnerability scanner.\n- Pass the relevant authentication and authorization tests.\n- Complete a review for sensitive-data exposure in logs and configuration.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Documentation Style\n\n## When to consult\n\nConsult this guide for process documentation, rules, specs, workflows, and operational instructions.\n\n## Required conventions\n\n- Write instructions in the imperative mood and begin them with action verbs.\n- Keep bullets short and limited to one idea.\n- Avoid duplicating sections with the same purpose across files.\n- Link to the single source of truth instead of copying its content.\n- Use `check`, `spec`, and `workflow` consistently.\n- State each instruction's scope explicitly to reduce ambiguity.\n\n## Examples: good and bad\n\n### Redundancy\n\n- **Good:** \"Update review criteria in `.pose/workflows/review.md` and reference that workflow from the root AGENTS file.\"\n- **Bad:** \"Repeat review criteria in AGENTS, the workflow, and every related spec.\"\n\n### Ambiguous reference\n\n- **Good:** \"Run the lint check described by the review workflow.\"\n- **Bad:** \"Run that standard validation before pushing.\"\n\n## Quick editorial checklist\n\n- Language is imperative and direct.\n- Bullets are short and non-overlapping.\n- Files do not duplicate sections.\n- `check`, `spec`, and `workflow` are used consistently.\n- References point to explicit files or paths.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Delivery Evidence\n\n## When to consult\n\nConsult this guide when writing or reviewing any document that **claims delivery,\ncompletion, or readiness**: status reports, handoffs, summaries, module READMEs,\ncurrent-state sections in specs or proposals, and messages that say something is complete.\n\n## Required conventions\n\n- Claim delivery only with attached, verifiable gate evidence: command and output\n  (`pose validate`, `go test`, `tsc`, `vitest`) or a link to the corresponding POSE report.\n- Use POSE lifecycle vocabulary: `draft`, `in-progress`, `done`, `blocked`,\n  `superseded`, or `abandoned`. Do not invent labels such as `completed` or `100% COMPLETE`.\n- Separate **implemented and verified** work from **planned or documented** work.\n  A plan describes intent; do not present that intent as current reality.\n- Reference the report or evidence that crossed the spec exit gate before using `done`.\n- Convert relative dates to absolute dates and stamp the verification date.\n- Declare exact source-tree artifact actions in the spec and reconcile them\n  against an immutable Git change set before claiming delivery.\n- Treat artifact declarations, Git observations and delivery verification as\n  separate evidence; none proves the others by itself.\n- For typed delivery targets, require a path from reconciled artifacts through\n  a production entrypoint to current structured validation results. A surface\n  requires reachability plus integration/e2e evidence; a composed capability\n  requires integration evidence.\n- Evidence answers for the component it ran in or for a component inside it: a\n  module-wide run covers its subtree, but a result from a directory inside a\n  component does not answer for the whole component. Coverage that rests only\n  on a containing module is reported as `inferred-coverage` — name it as such.\n\n## Blocking anti-patterns\n\n- Claiming `100% COMPLETE` or production readiness without a green\n  `pose validate --strict` for every affected module.\n- Publishing contradictory delivery documents for the same scope; reconcile them first.\n- Merging code with completion documentation before the applicable POSE checks pass.\n- Mixing aspiration and verified state in one paragraph without clear labels.\n\n## Minimum checks\n\n- Run `pose check --strict` for structure and spec status enums.\n- Run `pose validate --strict` for every module the document claims to deliver.\n- Run `pose lint-spec` when the document is a spec.\n- Run `pose artifact-check --strict` when the scope changes governed source-tree paths.\n- Run `pose surface-check --strict` for specs with `delivers` and `pose\n  roadmap-check --strict` before a roadmap claims completion.\n- `pose assess discover --if-stale --update-state` when closing specs to update completeness metrics, technical debt, and reports under `.pose/assessments/` and `.pose/state/`.\n\n## Precedence in multi-domain conflicts\n\n- Prefer verifiable check evidence over progress narratives when rules conflict.\n- When pressured to claim completion without a gate, record the real state\n  (`in-progress` or `blocked`) and the remaining exit conditions.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Workflow: Review\n\n## Objective\n\nVerify that a change is correct, production-safe, and aligned with its approved scope and specs.\n\n## Preconditions\n\n- Make the final diff readable through cohesive commits or batches.\n- Provide requirement and spec context.\n- Attach implementer validation evidence, including `pose validate` output.\n- Define acceptance criteria and expected risk.\n\n## Execution checklist\n\n1. Resolve `pose review bundle <scope> --explain` (or `pose_review_bundle`) when bundle policy is enabled; otherwise resolve `pose review-plan <scope> --explain`.\n2. Confirm the semantic scope, patch/tree identity, mapped components and bundle plan digest.\n3. Run required active tools first, evaluate recommended tools explicitly and leave completion-only tools deferred until an attestation exists.\n4. Select the plan's applicable rules explicitly and record them in the review.\n5. Resolve rule conflicts with the most restrictive option, prioritizing security for exposure, authorization, and integrity risks.\n6. Consult `.pose/knowledge/` for relevant handoffs, accepted risks, follow-ups, and decision logs.\n7. Check compliance with specs, contracts, and local instructions.\n8. Review functional correctness and edge cases.\n9. Evaluate security, observability, and performance risks.\n10. Require validation evidence from `.pose/indexes/validation-matrix.json` proportional to risk.\n11. Identify regression and rollout or rollback risks.\n12. Run plan-selected assessments, including tech-debt and integration when applicable.\n13. Classify findings by severity and propose objective actions.\n14. **Produce a handoff** in `.pose/knowledge/` when findings result in accepted risk, post-merge monitoring, or deferred work (`pose new-knowledge handoff <slug>`); link it from the review.\n15. Seal the validated subject with `pose review bundle <scope> --seal`; stop if any input is unclassified or changed since preparation.\n16. Issue a final decision: approved, approved with reservations, changes requested, or rejected.\n17. Record the decision with `pose review attest <bundle-id> ... --plan-digest <sha256> --apply`; signed external envelopes use `pose review attest --envelope <path> --apply`.\n18. Run `pose review verify <scope>` and `pose review-check <scope>`; reject stale, incomplete, conflicting or transitively invalid reused criteria.\n19. Apply closeout only after verification reports `ready-to-close`; lifecycle, state and report refreshes must not change the sealed bundle.\n20. When Contributor Mode is active and review identifies linter false-positives, diagnostic frictions, or POSE rule gaps, stage an improvement proposal via `pose contribute stage --type enhancement`.\n\n## Required rule selection\n\nAttach this section to the review:\n\n```md\n## Rules applied during review\n- Change type: <feature|bugfix|refactor|documentation-update|mixed>\n- Workflow consulted: `.pose/workflows/<file>.md`\n- Rules selected:\n  - [ ] `.pose/rules/security.md`\n  - [ ] `.pose/rules/backend-go.md` (extension `pose-rule-backend-go`, when installed)\n  - [ ] `.pose/rules/frontend-react.md` (extension `pose-rule-frontend-react`, when installed)\n  - [ ] `.pose/rules/kubernetes.md` (extension `pose-rule-kubernetes`, when installed)\n  - [ ] `.pose/rules/documentation-style.md`\n  - [ ] `.pose/rules/knowledge-governance.md` when knowledge or process changes\n- Rationale for each selected rule: <one line per item>\n- Rules not applicable: <list and explain>\n```\n\n## Recurrence escalation\n\n- Trigger `.pose/workflows/recurrence-escalation.md` when recurring rework is uncovered and the threshold is met.\n- Require `recurrence_rework_uncovered` evidence for the 30-day period.\n- Require explicit links from the specialized workflow to applicable domain rules.\n- Require a formal keep, adjust, or discard decision after the 45-day pilot.\n\n## Minimum domain coverage\n\n- React UI: apply `frontend-react`, `security`, and `documentation-style`.\n- Go services: apply `backend-go`, `security`, and `documentation-style`.\n- Cluster deployment or infrastructure: apply `kubernetes`, `security`, and `documentation-style`.\n- Process, spec, workflow, rule, or report: apply `documentation-style`, `knowledge-governance`, and security when sensitive data is involved.\n- Cross-stack changes: apply every touched domain rule cumulatively.\n\n## Domain review checklist\n\n### Security\n\n- Confirm authentication, authorization, and least privilege when applicable.\n- Verify that code, configuration, manifests, docs, and logs contain no secrets.\n- Require applicable vulnerability and secret-scanning evidence.\n\n### Contracts\n\n- Confirm compatibility of public HTTP, event, schema, CLI, and file contracts.\n- Validate forward and backward compatibility for rollout and rollback.\n- Require a spec update for contract changes.\n\n### Observability\n\n- Verify structured logs and metrics without sensitive data.\n- Confirm that probes, health checks, and alerts reflect real behavior.\n- Preserve enough traceability for post-deployment diagnosis.\n\n### Validation\n\n- Require lint, typecheck, test, and build coverage proportional to risk.\n- Require executed `pose validate` evidence and relevant results.\n- Record environment limitations and residual validation risks.\n\n## Editorial checklist\n\n- Use imperative, actionable instructions.\n- Keep bullets short and avoid duplicated sections.\n- Use `check`, `spec`, and `workflow` consistently.\n- Reference explicit files and paths.\n\n## Required outputs\n\n- A review decision with rationale.\n- The inspected effective plan, its component provenance and tool dispositions.\n- An immutable sealed review bundle and separate attestation bound to its exact digest.\n- A completed rule-selection section.\n- Findings with severity, evidence, and recommendation.\n- Recurrence classification by domain and cause with preventive actions.\n- An explicit statement about public contracts and compatibility.\n- Residual risks and safe-deployment conditions.\n- References to executed checks and collected evidence.\n\n## Complete multi-rule review example\n\n```md\n## Review Summary\n- Decision: approved with reservations\n- Change type: feature (Go API, React UI, and Helm)\n- Workflow: `.pose/workflows/feature.md`\n\n## Rules applied during review\n- `.pose/rules/backend-go.md` (extension `pose-rule-backend-go`): verified handlers, context, and error handling.\n- `.pose/rules/frontend-react.md` (extension `pose-rule-frontend-react`): verified accessibility and explicit loading and error states.\n- `.pose/rules/kubernetes.md` (extension `pose-rule-kubernetes`): verified resources, probes, and immutable images.\n- `.pose/rules/security.md`: verified authorization and absence of secrets.\n- `.pose/rules/documentation-style.md`: verified editorial consistency.\n\n## Checks and evidence\n- `pose validate`: passed\n- `go test ./...`: passed in the backend module\n- `pnpm lint && pnpm test`: passed in the frontend module\n- `helm template` and `kubectl apply --dry-run=client`: passed\n\n## Contracts and compatibility\n- Preserved `POST /v1/storage`.\n- Added optional `retentionDays`, preserving backward compatibility.\n\n## Findings\n- Medium: missing queue-saturation alert; add a metric and alert before production.\n- Low: frontend error lacks request-id context; improve observable UX.\n\n## Residual risks\n- Review did not simulate real cluster load.\n- Increase monitoring during the first 24 hours.\n```\n\n## CI failure interpretation\n\n- Treat `POSE check (strict)` as merge-blocking on protected branches.\n- Treat failed required checks in `POSE validate (strict)` as merge-blocking.\n- Attach pipeline artifacts: `pose-check.log`, `pose-validate.latest.log`, and the POSE report.\n- Classify optional-check failures as quality reservations with an owned remediation plan.\n- Reject changes that violate specs, public contracts, security, or safe rollout.\n\n## Phased rollout for unready modules\n\n- Enforce the current required checks immediately.\n- Use `moduleOverrides` to phase adoption without weakening global structural and required gates.\n- Promote optional checks to required by module with an owner and agreed window.\n\n### Optional-to-required promotion protocol\n\n- Select a pilot domain and map candidate checks with owners and explicit risks.\n- Measure success for four weeks and require a baseline of at least 95 percent.\n- Promote only eligible domains through `moduleOverrides`.\n- Update the validation matrix and quality policy in the same change set.\n- Monitor regressions and adjust rollout without removing established required gates.\n- Update specs and rules when rollout changes merge acceptance criteria.\n\n## Definition of done\n\n- Resolve or formally accept every critical and high finding.\n- Make the final decision clear and actionable.\n- Support quality and security conclusions with evidence.\n- Preserve approved scope without unjustified drift.\n\n## Reviewer mode\n\n**Objective:** evaluate technical quality and production readiness with emphasis on correctness, risk, and scope.\n\n- **Focus:** functional correctness, spec consistency, regression and security risk, operability, validation quality, and actionable feedback.\n- **Anti-patterns:** approve without sufficient evidence; review style while ignoring functional risk; request unrelated changes; block progress on subjective preference.\n- **Handoff:** state the decision, severity and evidence for each finding, safe merge or deployment conditions, accepted risks, and recommended monitoring.\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// IndexFederatedSpecMaterial is the dependency-resolution projection emitted\n// for one spec by `pose index`.\ntype IndexFederatedSpecMaterial struct {\n\tSlug                  string               `json:\"slug\"`\n\tDependencyResolutions []ArtifactResolution `json:\"dependency_resolutions\"`\n}\n\n// IndexFederatedRoadmapMaterial is the acceptance projection emitted for one\n// roadmap by `pose index`.\ntype IndexFederatedRoadmapMaterial struct {\n\tSlug       string                           `json:\"slug\"`\n\tAcceptance FederatedRoadmapAcceptanceReport `json:\"acceptance\"`\n}\n\n// IndexFederatedMaterialProjection contains only the federated semantic\n// inputs represented in the generated indexes. It deliberately excludes\n// unrelated foreign files and roots.\ntype IndexFederatedMaterialProjection struct {\n\tSchemaVersion int                             `json:\"schema_version\"`\n\tSpecs         []IndexFederatedSpecMaterial    `json:\"specs\"`\n\tRoadmaps      []IndexFederatedRoadmapMaterial `json:\"roadmaps\"`\n}\n\n// IndexFederatedMaterial carries both the semantic input projection and the\n// source records used to build index outputs. The projection is shared by the\n// builder and the generation binding so output bytes and their binding cannot\n// be computed from separate, interleaved reads.\ntype IndexFederatedMaterial struct {\n\tProjection                IndexFederatedMaterialProjection\n\tSpecs                     []Spec\n\tRoadmaps                  []Roadmap\n\tSpecDependencyResolutions map[string][]ArtifactResolution\n\tRoadmapAcceptances        map[string]FederatedRoadmapAcceptanceReport\n\tProjects                  []string\n\tReferencedProjects        []string\n\tRequiresPrimaryRevision   bool\n}\n\n// BuildIndexFederatedMaterialIn returns the specs, roadmaps, semantic\n// projections and exact foreign projects whose contents were resolved. The\n// Store must carry the operation's authorized resolver when one has already\n// been established; it is reused unchanged except for the captured Files the\n// operation view supplies.\nfunc BuildIndexFederatedMaterialIn(store Store) (IndexFederatedMaterial, error) {\n\tstore.indexMaterial = true\n\tresolver := ArtifactResolver{}\n\tproject := store.FederatedProjectID\n\tif store.FederatedResolver != nil {\n\t\tresolver = *store.FederatedResolver\n\t\tif resolver.Roots == nil {\n\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: authorized project roots are unavailable for index material\")\n\t\t}\n\t} else {\n\t\tvar err error\n\t\tresolver, project, err = EnvironmentArtifactResolverIn(store.fsys(), store.Root, \"\")\n\t\tif err != nil {\n\t\t\treturn IndexFederatedMaterial{}, fmt.Errorf(\"pose: index material resolver: %w\", err)\n\t\t}\n\t}\n\tif project == \"\" {\n\t\tvar found, ambiguous, overflow bool\n\t\tproject, found, ambiguous, overflow = uniqueProjectIDForRootIn(store.fsys(), resolver.Roots, store.Root, resolver.Authorize)\n\t\tif overflow {\n\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material root identity exceeds the authorized-root snapshot budget\")\n\t\t}\n\t\tif ambiguous {\n\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material root has multiple authorized project identities\")\n\t\t}\n\t\tif !found {\n\t\t\tproject = DefaultProjectIDIn(store.fsys(), store.Root)\n\t\t\tif ValidateSlug(project) != nil || resolver.Authorize != nil && !resolver.Authorize(project) {\n\t\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material project identity is not authorized\")\n\t\t\t}\n\t\t\tbound, err := resolver.Roots.StoreFor(project)\n\t\t\tif err != nil || !sameProjectRoot(store.fsys(), bound.Root, store.Root) {\n\t\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material root is outside the authorized project registry\")\n\t\t\t}\n\t\t}\n\t}\n\tif ValidateSlug(project) != nil {\n\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material project identity is unavailable\")\n\t}\n\n\t// Fresh for this build, never inherited from an earlier advisory operation.\n\tresolver = resolver.WithSpecSnapshots()\n\tspecs, err := store.ListSpecs(\"\", \"\")\n\tif err != nil && !errors.Is(err, fs.ErrNotExist) {\n\t\treturn IndexFederatedMaterial{}, fmt.Errorf(\"pose: listing specs for index material: %w\", err)\n\t}\n\troadmaps, err := store.ListRoadmaps()\n\tif err != nil {\n\t\treturn IndexFederatedMaterial{}, fmt.Errorf(\"pose: listing roadmaps for index material: %w\", err)\n\t}\n\tsort.Slice(specs, func(i, j int) bool { return specs[i].Slug < specs[j].Slug })\n\tsort.Slice(roadmaps, func(i, j int) bool { return roadmaps[i].Slug < roadmaps[j].Slug })\n\n\tmaterial := IndexFederatedMaterial{\n\t\tSpecs:                     specs,\n\t\tRoadmaps:                  roadmaps,\n\t\tSpecDependencyResolutions: make(map[string][]ArtifactResolution, len(specs)),\n\t\tRoadmapAcceptances:        make(map[string]FederatedRoadmapAcceptanceReport, len(roadmaps)),\n\t\tProjection: IndexFederatedMaterialProjection{\n\t\t\tSchemaVersion: 1,\n\t\t\tSpecs:         make([]IndexFederatedSpecMaterial, 0, len(specs)),\n\t\t\tRoadmaps:      make([]IndexFederatedRoadmapMaterial, 0, len(roadmaps)),\n\t\t},\n\t}\n\tprojects := map[string]bool{}\n\treferencedProjects := map[string]bool{}\n\taddProject := func(id string) {\n\t\tif id == \"\" || id == project {\n\t\t\treturn\n\t\t}\n\t\treferencedProjects[id] = true\n\t\tif resolver.Authorize != nil && !resolver.Authorize(id) {\n\t\t\treturn\n\t\t}\n\t\tif _, err := resolver.Roots.StoreFor(id); err == nil {\n\t\t\t// Include only foreign roots named by this semantic projection. A\n\t\t\t// project discovered for reading still has to pass the explicit-root\n\t\t\t// write guard before this generation can be published.\n\t\t\tprojects[id] = true\n\t\t}\n\t}\n\tfor _, spec := range specs {\n\t\tresolutions := make([]ArtifactResolution, 0, len(spec.DependsOn))\n\t\tsemanticResolutions := make([]ArtifactResolution, 0, len(spec.DependsOn))\n\t\tfor _, raw := range spec.DependsOn {\n\t\t\tresolution := resolver.Resolve(project, raw)\n\t\t\tresolutions = append(resolutions, resolution)\n\t\t\tsemanticResolution := resolution\n\t\t\t// Same-project resolution revisions describe repository HEAD, while\n\t\t\t// the identity, state, status, digest and dependency edges below carry\n\t\t\t// the semantic result. Keep local unrelated commits out of the index\n\t\t\t// binding; the generated output still preserves the observed revision.\n\t\t\tif semanticResolution.Identity.Project == project {\n\t\t\t\tsemanticResolution.Revision = \"\"\n\t\t\t}\n\t\t\tsemanticResolutions = append(semanticResolutions, semanticResolution)\n\t\t\taddProject(resolution.Identity.Project)\n\t\t}\n\t\tmaterial.SpecDependencyResolutions[spec.Slug] = resolutions\n\t\tmaterial.Projection.Specs = append(material.Projection.Specs, IndexFederatedSpecMaterial{\n\t\t\tSlug: spec.Slug, DependencyResolutions: semanticResolutions,\n\t\t})\n\t}\n\tfor _, roadmap := range roadmaps {\n\t\tacceptance, err := store.FederatedRoadmapAcceptance(project, roadmap.Slug, resolver)\n\t\tif err != nil {\n\t\t\treturn IndexFederatedMaterial{}, fmt.Errorf(\"pose: federated roadmap %s: %w\", roadmap.Slug, err)\n\t\t}\n\t\tmaterial.RoadmapAcceptances[roadmap.Slug] = acceptance\n\t\tmaterial.Projection.Roadmaps = append(material.Projection.Roadmaps, IndexFederatedRoadmapMaterial{\n\t\t\tSlug: roadmap.Slug, Acceptance: indexSemanticAcceptanceReport(project, acceptance),\n\t\t})\n\t\tfor _, dependency := range acceptance.Manifest.Dependencies {\n\t\t\taddProject(dependency.Identity.Project)\n\t\t}\n\t}\n\tmaterial.Projects = make([]string, 0, len(projects))\n\tfor id := range projects {\n\t\tmaterial.Projects = append(material.Projects, id)\n\t}\n\tsort.Strings(material.Projects)\n\tmaterial.ReferencedProjects = make([]string, 0, len(referencedProjects))\n\tfor id := range referencedProjects {\n\t\tmaterial.ReferencedProjects = append(material.ReferencedProjects, id)\n\t}\n\tsort.Strings(material.ReferencedProjects)\n\tmaterial.RequiresPrimaryRevision = indexMaterialRequiresPrimaryRevision(store, resolver, project, material)\n\treturn material, nil\n}\n\nfunc indexMaterialRequiresPrimaryRevision(store Store, resolver ArtifactResolver, localProject string, material IndexFederatedMaterial) bool {\n\tfiles := store.fsys()\n\tfor _, report := range material.RoadmapAcceptances {\n\t\tfor _, dependency := range report.Manifest.Dependencies {\n\t\t\tif dependency.Identity.Project == localProject && dependency.SourceDigest != \"\" {\n\t\t\t\t// Roadmap acceptance proves the local artifact against its\n\t\t\t\t// committed revision; a worktree-only answer is not enough.\n\t\t\t\treturn true\n\t\t\t}\n\t\t\tif dependency.Identity.Project == \"\" || dependency.Identity.Project == localProject || dependency.SourceDigest == \"\" || dependency.SourceRevision == \"\" || !hasGitMetadataIn(files, store.Root) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tforeign, err := resolver.Roots.StoreFor(dependency.Identity.Project)\n\t\t\tif err != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tlocalReal, localErr := files.EvalSymlinks(store.Root)\n\t\t\tforeignReal, foreignErr := files.EvalSymlinks(foreign.Root)\n\t\t\tif localErr != nil || foreignErr != nil {\n\t\t\t\treturn true\n\t\t\t}\n\t\t\trelative, err := filepath.Rel(localReal, foreignReal)\n\t\t\tif err != nil {\n\t\t\t\treturn true\n\t\t\t}\n\t\t\tinside := relative == \".\" || relative != \"..\" && !strings.HasPrefix(relative, \"..\"+string(filepath.Separator))\n\t\t\tif inside {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t}\n\treturn false\n}\n\n// indexSemanticAcceptanceReport drops only local repository revisions whose\n// changes do not alter the accepted artifact projection. This normalized copy\n// is used only for the input binding; generated output keeps the exact report\n// produced by the federated acceptance operation. The acceptance code already\n// uses artifact-level resolution and trust digests for meaningful local and\n// foreign changes, so recompute the binding copy's digest after normalization.\nfunc indexSemanticAcceptanceReport(localProject string, report FederatedRoadmapAcceptanceReport) FederatedRoadmapAcceptanceReport {\n\treport.Manifest.Dependencies = append([]FederatedDependency(nil), report.Manifest.Dependencies...)\n\treport.Manifest.CoordinatorRevision = \"\"\n\tfor i := range report.Manifest.Dependencies {\n\t\tif report.Manifest.Dependencies[i].Identity.Project == localProject {\n\t\t\treport.Manifest.Dependencies[i].SourceRevision = \"\"\n\t\t}\n\t}\n\treport.Manifest.Digest = \"\"\n\treport.Manifest.Digest = canonicalFederatedDigest(report.Manifest)\n\treturn report\n}\n\n// IndexFederatedMaterialDigest returns the stable semantic digest bound to an\n// index generation. The digest does not include root paths or unrelated files.\nfunc IndexFederatedMaterialDigest(material IndexFederatedMaterialProjection) (string, bool) {\n\traw, err := json.Marshal(material)\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\tsum := sha256.Sum256(raw)\n\treturn \"sha256:\" + hex.EncodeToString(sum[:]), true\n}\n","exit_code":0,"status":"completed"}}
