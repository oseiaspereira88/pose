{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X7VfofsYZA5BdPQqZmqRhZ","type":"tool_result","content":"80\t\t\t\tagent = r.Adapter\n81\t\t\t}\n82\t\t}\n83\t\tif agent == \"auto\" {\n84\t\t\tchosen, record, err := routeHandoff(store, *latest)\n85\t\t\tif err != nil {\n86\t\t\t\tif record != nil && f.jsonOut {\n87\t\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateErrorSchema, \"command\": \"handoff\", \"error\": strings.TrimPrefix(err.Error(), \"pose: \"), \"routing\": record, \"reason_code\": posemodel.DelegationReasonCode(err)})\n88\t\t\t\t\treturn 1\n89\t\t\t\t}\n90\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"handoff\", 1, err)\n91\t\t\t}\n92\t\t\tagent, route = chosen, record\n93\t\t}\n94\t\tplan, err := store.PlanReviewHandoff(target, agent)\n95\t\tif err != nil {\n96\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"handoff\", 1, err)\n97\t\t}\n98\t\tif plan.PendingContinuation != nil {\n99\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"handoff\", 1, errors.New(tr(\"a continuation of \"+target+\" is pending (\"+plan.PendingContinuation.ID+\")\",\n100\t\t\t\t\"uma continuação de \"+target+\" está pendente (\"+plan.PendingContinuation.ID+\")\")))\n101\t\t}\n102\t\tif route != nil {\n103\t\t\tplan.Routing = route\n104\t\t}\n105\t\tplan.Purpose = attempt.Purpose\n106\t\tfor _, warning := range plan.Warnings {\n107\t\t\trender(stdout, stderr).Hint(\"pose delegate handoff: \" + warning)\n108\t\t}\n109\t\tif f.dryRun {\n110\t\t\textra := map[string]any{\"hands_off_from\": target, \"attempt\": attempt.AttemptID, \"label\": attempt.Label, \"routing\": plan.Routing}\n111\t\t\tif plan.Existing != nil {\n112\t\t\t\textra[\"recorded_continuation\"] = plan.Existing.RunID\n113\t\t\t}\n114\t\t\targv := redactArgv(posemodel.ReviewerArgv(plan.Config.Command, \"{output}\", \"\", plan.Effort, plan.Config.Effort), plan.Config)\n115\t\t\treturn delegatePrintPlan(stdout, stderr, f.jsonOut, plan, argv, extra)\n116\t\t}\n117\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n118\t\tdefer stop()\n119\t\tif delegateSupervised() {\n120\t\t\tplan.OnStart = supervisorHandback()\n121\t\t}\n122\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n123\t\thandBackExisting(run, err)\n124\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n125\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"handoff\")\n126\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"handoff\", run, err, delegateRunNextActions(store, run, err)...)\n127\t\tif err == nil && !f.jsonOut {\n128\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n129\t\t\t\treturn next\n130\t\t\t}\n131\t\t}\n132\t\treturn code\n133\t}\n134\t\n135\t// routeHandoff routes a handoff among the agents of the stopped run's purpose,\n136\t// the stopped agent excluded (R7).\n137\tfunc routeHandoff(store posemodel.Store, prior posemodel.ReviewRun) (string, *posemodel.DelegationRoutingRecord, error) {\n138\t\treaders, found, err := store.LoadReviewersPolicyFor(prior.Kind)\n139\t\tif err != nil {\n140\t\t\treturn \"\", nil, err\n141\t\t}\n142\t\tif !found {\n143\t\t\treturn \"\", nil, posemodel.ErrNoReviewerAdapter\n144\t\t}\n145\t\tpolicy, _, _, err := store.LoadDelegationPolicy()\n146\t\tif err != nil {\n147\t\t\treturn \"\", nil, err\n148\t\t}\n149\t\tbundle, err := store.LoadReviewBundle(prior.BundleID)\n150\t\tif err != nil {\n151\t\t\treturn \"\", nil, err\n152\t\t}\n153\t\timpl, from, err := store.RoutingImplementation(bundle, policy, prior.Lead)\n154\t\tif err != nil {\n155\t\t\treturn \"\", nil, err\n156\t\t}\n157\t\teligible := []string{}\n158\t\tfor name := range readers.Adapters {\n159\t\t\tif name != prior.Adapter {\n160\t\t\t\teligible = append(eligible, name)\n161\t\t\t}\n162\t\t}\n163\t\tavail := store.DelegationAvailabilityOf(policy, time.Now(), true)\n164\t\tagent, record, err := posemodel.RouteDelegation(policy, eligible, impl, from, avail, time.Now())\n165\t\tif err != nil {\n166\t\t\treturn \"\", &record, err\n167\t\t}\n168\t\tif record.Step == posemodel.DelegationStepWait {\n169\t\t\treturn \"\", &record, errors.New(tr(\"every other agent is limited until \"+record.WaitUntil+\"; hand off after the reset, or wait for this run's reset and resume it\",\n170\t\t\t\t\"todos os outros agentes estão limitados até \"+record.WaitUntil+\"; faça o handoff depois do reset, ou espere o reset deste run e o retome\"))\n171\t\t}\n172\t\treturn agent, &record, nil\n173\t}\n174\t\n175\t// delegateNextAction is one way forward for a stopped run (R9).\n176\ttype delegateNextAction struct {\n177\t\tAction    string `json:\"action\"`\n178\t\tCommand   string `json:\"command,omitempty\"`\n179\t\tAvailable bool   `json:\"available\"`\n180\t\tWhy       string `json:\"why,omitempty\"`\n181\t}\n182\t\n183\t// delegateCancelAction leaves the attempt stopped: it has no command because\n184\t// nothing runs to stop, nothing is spent, and a later command can still\n185\t// continue the run (R8, R9).\n186\tfunc delegateCancelAction() delegateNextAction {\n187\t\treturn delegateNextAction{Action: \"cancel\", Available: true, Why: tr(\"leave the run stopped; nothing runs and the attempt's budget is kept\", \"deixar o run parado; nada roda e o orçamento da tentativa é mantido\")}\n188\t}\n189\t\n190\t// delegateNextActions lists what a stopped attempt can do next, each judged by\n191\t// the same read-only planning its command runs, so an action offered as\n192\t// available is one its command would start (R9); nil for an attempt that runs\n193\t// or concluded.\n194\tfunc delegateNextActions(store posemodel.Store, a posemodel.DelegationAttempt) []delegateNextAction {\n195\t\tlatest := a.Latest()\n196\t\tif a.Active || latest == nil || latest.Status == posemodel.ReviewRunCompleted || latest.Status == posemodel.ReviewRunStale {\n197\t\t\treturn nil\n198\t\t}\n199\t\tif latest.Purpose == posemodel.DelegationPurposeTask {\n200\t\t\treturn delegateTaskNextActions(store, a, *latest)\n201\t\t}\n202\t\treason := func(err error) string { return strings.TrimPrefix(err.Error(), \"pose: \") }\n203\t\tvar actions []delegateNextAction\n204\t\tif i := latest.Interruption; latest.Status == posemodel.ReviewRunInterrupted && i != nil {\n205\t\t\tresume := delegateNextAction{Action: \"resume\", Command: \"pose delegate resume \" + a.AttemptID}\n206\t\t\tplan, err := store.PlanReviewResume(latest.RunID)\n207\t\t\tswitch {\n208\t\t\tcase !i.Resumable:\n209\t\t\t\tresume.Why = tr(\"the stop is not resumable\", \"a parada não é retomável\")\n210\t\t\tcase err != nil:\n211\t\t\t\tresume.Why = reason(err)\n212\t\t\tcase plan.PendingContinuation != nil || plan.Existing != nil:\n213\t\t\t\tresume.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n214\t\t\t}\n215\t\t\tif resume.Why == \"\" {\n216\t\t\t\treset, resetErr := time.Parse(time.RFC3339Nano, i.ResetAt)\n217\t\t\t\tif i.ResetAt != \"\" && resetErr == nil && reset.After(time.Now()) {\n218\t\t\t\t\twait := delegateNextAction{Action: \"wait\", Command: \"pose delegate resume \" + a.AttemptID + \" --wait-until-reset\"}\n219\t\t\t\t\tif _, err := posemodel.ReviewResumeDelay(*latest, time.Now(), 24*time.Hour, 0); err != nil {\n220\t\t\t\t\t\twait.Why = reason(err)\n221\t\t\t\t\t} else {\n222\t\t\t\t\t\twait.Available = true\n223\t\t\t\t\t}\n224\t\t\t\t\tactions = append(actions, wait)\n225\t\t\t\t\tresume.Why = tr(\"the agent is limited until \", \"o agente está limitado até \") + i.ResetAt\n226\t\t\t\t} else {\n227\t\t\t\t\tresume.Available = true\n228\t\t\t\t}\n229\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"59c76c47-c1fa-4e99-a0bc-6525fc227214","timestamp":"2026-11-27T23:08:01.069Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-668ca2f6e0/worktree/pose-mcp/internal/cli/delegate_handoff.go","content":"\t\t\tagent = r.Adapter\n\t\t}\n\t}\n\tif agent ==