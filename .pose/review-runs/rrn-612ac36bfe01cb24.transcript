tempt.Purpose, \"attempt\": pending.AttemptID, \"resumes\": pending.Predecessor,\n1035\t\t\t\t\t\"continuation\": pending.ID, \"status\": \"pending\"})\n1036\t\t\t\treturn 0\n1037\t\t\t}\n1038\t\t\tout := render(stdout, stderr)\n1039\t\t\tout.Field(\"delegate.resumes\", pending.Predecessor)\n1040\t\t\tout.Field(\"delegate.continuation\", pending.ID)\n1041\t\t\tout.Field(\"delegate.attempt\", pending.AttemptID)\n1042\t\t\tout.Field(\"delegate.status\", \"pending\")\n1043\t\t\treturn 0\n1044\t\t}\n1045\t\tvar delay time.Duration\n1046\t\tif f.wait && plan.Existing == nil {\n1047\t\t\tvar seed [1]byte\n1048\t\t\tif _, err := rand.Read(seed[:]); err != nil {\n1049\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n1050\t\t\t}\n1051\t\t\tvar prior posemodel.ReviewRun\n1052\t\t\tif latest := attempt.Latest(); latest != nil && latest.RunID == target {\n1053\t\t\t\tprior = *latest\n1054\t\t\t} else if runs, rerr := store.ListReviewRuns(\"\"); rerr == nil {\n1055\t\t\t\tfor _, r := range runs {\n1056\t\t\t\t\tif r.RunID == target {\n1057\t\t\t\t\t\tprior = r\n1058\t\t\t\t\t}\n1059\t\t\t\t}\n1060\t\t\t}\n1061\t\t\tdelay, err = posemodel.ReviewResumeDelay(prior, time.Now(), f.waitMax, time.Duration(seed[0])*time.Second/255)\n1062\t\t\tif err != nil {\n1063\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n1064\t\t\t}\n1065\t\t}\n1066\t\tif f.dryRun {\n1067\t\t\textra := map[string]any{\"resumes\": target, \"attempt\": attempt.AttemptID, \"label\": attempt.Label}\n1068\t\t\tif plan.Existing != nil {\n1069\t\t\t\textra[\"recorded_continuation\"] = plan.Existing.RunID\n1070\t\t\t}\n1071\t\t\tif f.wait {\n1072\t\t\t\textra[\"wait\"] = delay.String()\n1073\t\t\t}\n1074\t\t\tplan.Purpose = attempt.Purpose\n1075\t\t\targv := redactArgv(posemodel.ReviewerArgv(plan.Config.Resume.Command, \"{output}\", \"{session}\", plan.Effort, plan.Config.Effort), plan.Config)\n1076\t\t\treturn delegatePrintPlan(stdout, stderr, f.jsonOut, plan, argv, extra)\n1077\t\t}\n1078\t\tif delay > 0 {\n1079\t\t\tif !f.jsonOut {\n1080\t\t\t\trender(stdout, stderr).Field(\"delegate.wait\", delay.String())\n1081\t\t\t}\n1082\t\t\ttime.Sleep(delay)\n1083\t\t\tif plan, err = store.PlanReviewResume(target); err != nil {\n1084\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n1085\t\t\t}\n1086\t\t}\n1087\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n1088\t\tdefer stop()\n1089\t\tif delegateSupervised() {\n1090\t\t\tplan.OnStart = supervisorHandback()\n1091\t\t}\n1092\t\t// The containment the run will run under is disclosed before it runs, as\n1093\t\t// pose review dispatch disclosed it (spec pose-delegation-parity-gate R6;\n1094\t\t// review round 1, PG-R1-08); the JSON document carries it with the run.\n1095\t\tif safety, _ := posemodel.ResolveReviewerContainment(plan.Config); safety != nil && !f.jsonOut {\n1096\t\t\traw, _ := json.Marshal(safety)\n1097\t\t\trender(stdout, stderr).Field(\"delegate.safety\", string(raw))\n1098\t\t}\n1099\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n1100\t\thandBackExisting(run, err)\n1101\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n1102\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"resume\")\n1103\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"resume\", run, err, delegateRunNextActions(store, run, err)...)\n1104\t\tif err == nil && !f.jsonOut {\n1105\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n1106\t\t\t\treturn next\n1107\t\t\t}\n1108\t\t}\n1109\t\treturn code\n1110\t}\n1111\t\n1112\tfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n1113\t\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n1114\t\tif problem != \"\" {\n1115\t\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-