{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016ZMYGR94fTo659PxSiETW5","type":"tool_result","content":"270\t\t\t\t}\n271\t\t\t}\n272\t\t}\n273\t\tif err != nil {\n274\t\t\tout.Failure(\"pose delegate \" + command + \": \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n275\t\t}\n276\t\treturn code\n277\t}\n278\t\n279\t// cmdDelegateTaskResume continues a stopped task with its own agent and\n280\t// session; without --prompt it sends the default continuation message (R8).\n281\tfunc cmdDelegateTaskResume(root string, store posemodel.Store, f delegateFlags, attempt posemodel.DelegationAttempt, target string, stdout, stderr io.Writer) int {\n282\t\tprompt := \"\"\n283\t\tif f.promptFile != \"\" {\n284\t\t\tvar err error\n285\t\t\tif prompt, err = readDelegatePrompt(f.promptFile); err != nil {\n286\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 2, err)\n287\t\t\t}\n288\t\t}\n289\t\tplan, err := store.PlanDelegationTaskResume(target, prompt)\n290\t\tif err != nil {\n291\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"resume\", err, nil)\n292\t\t}\n293\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n294\t\tdefer stop()\n295\t\tif f.wait && plan.Existing == nil && !f.dryRun {\n296\t\t\tlatest := attempt.Latest()\n297\t\t\tvar seed [1]byte\n298\t\t\t_, _ = rand.Read(seed[:])\n299\t\t\tdelay, err := posemodel.ReviewResumeDelay(*latest, time.Now(), f.waitMax, time.Duration(seed[0])*time.Second/255)\n300\t\t\tif err != nil {\n301\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n302\t\t\t}\n303\t\t\tif delay > 0 {\n304\t\t\t\trender(io.Discard, stderr).Hint(\"pose delegate resume: \" + tr(\"waiting \", \"esperando \") + delay.String())\n305\t\t\t\tselect {\n306\t\t\t\tcase <-ctx.Done():\n307\t\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, ctx.Err())\n308\t\t\t\tcase <-time.After(delay):\n309\t\t\t\t}\n310\t\t\t\tif plan, err = store.PlanDelegationTaskResume(target, prompt); err != nil {\n311\t\t\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"resume\", err, nil)\n312\t\t\t\t}\n313\t\t\t}\n314\t\t}\n315\t\tif plan.Existing != nil {\n316\t\t\thandBackAttempt(plan.Existing.AttemptID)\n317\t\t\treturn delegatePrintTask(stdout, stderr, f.jsonOut, \"resume\", *plan.Existing, nil)\n318\t\t}\n319\t\treturn runDelegateTask(root, store, ctx, plan, f, \"resume\", map[string]any{\"resumes\": target, \"attempt\": attempt.AttemptID}, stdout, stderr)\n320\t}\n321\t\n322\t// cmdDelegateTaskHandoff continues a stopped task with another agent, its\n323\t// prompt the stopped run's followed by the handoff section.\n324\tfunc cmdDelegateTaskHandoff(root string, store posemodel.Store, f delegateFlags, attempt posemodel.DelegationAttempt, latest posemodel.ReviewRun, target string, stdout, stderr io.Writer) int {\n325\t\tagent := f.to\n326\t\truns, _ := store.ReadDelegationTaskRuns()\n327\t\tfor _, r := range runs {\n328\t\t\tif r.HandsOffFrom != target {\n329\t\t\t\tcontinue\n330\t\t\t}\n331\t\t\tif agent != \"auto\" && agent != r.Adapter {\n332\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"handoff\", 1, fmt.Errorf(tr(\"run %s was already handed off to %s by run %s\", \"o run %s já foi repassado para %s pelo run %s\"), target, r.Adapter, r.RunID))\n333\t\t\t}\n334\t\t\tagent = r.Adapter\n335\t\t}\n336\t\tvar route *posemodel.DelegationRoutingRecord\n337\t\tif agent == \"auto\" {\n338\t\t\tchosen, record, err := routeTaskHandoff(store, latest)\n339\t\t\tif err != nil {\n340\t\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"handoff\", err, record)\n341\t\t\t}\n342\t\t\tagent, route = chosen, record\n343\t\t}\n344\t\tplan, err := store.PlanDelegationTaskHandoff(target, agent)\n345\t\tif err != nil {\n346\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"handoff\", err, nil)\n347\t\t}\n348\t\tif plan.Existing != nil {\n349\t\t\thandBackAttempt(plan.Existing.AttemptID)\n350\t\t\treturn delegatePrintTask(stdout, stderr, f.jsonOut, \"handoff\", *plan.Existing, nil)\n351\t\t}\n352\t\tplan.Routing = route\n353\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n354\t\tdefer stop()\n355\t\treturn runDelegateTask(root, store, ctx, plan, f, \"handoff\", map[string]any{\"hands_off_from\": target, \"attempt\": attempt.AttemptID}, stdout, stderr)\n356\t}\n357\t\n358\t// routeTaskHandoff routes the handoff of a task among the agents with a\n359\t// command for its access, the stopped agent excluded; it never waits.\n360\tfunc routeTaskHandoff(store posemodel.Store, prior posemodel.ReviewRun) (string, *posemodel.DelegationRoutingRecord, error) {\n361\t\tpolicy, _, found, err := store.LoadDelegationPolicy()\n362\t\tif err != nil {\n363\t\t\treturn \"\", nil, err\n364\t\t}\n365\t\tif !found {\n366\t\t\treturn \"\", nil, posemodel.ErrNoReviewerAdapter\n367\t\t}\n368\t\tagent, record, err := routeTask(store, policy, prior.Access, \"auto\", prior.Lead, prior.Adapter)\n369\t\tif err != nil {\n370\t\t\treturn \"\", record, err\n371\t\t}\n372\t\tif record.Step == posemodel.DelegationStepWait {\n373\t\t\treturn \"\", record, errors.New(tr(\"every other agent is limited until \"+record.WaitUntil+\"; hand off after the reset, or wait for this run's reset and resume it\",\n374\t\t\t\t\"todos os outros agentes estão limitados até \"+record.WaitUntil+\"; faça o handoff depois do reset, ou espere o reset deste run e o retome\"))\n375\t\t}\n376\t\treturn agent, record, nil\n377\t}\n378\t\n379\t// delegateTaskNextActions are the ways forward of a stopped task, judged by\n380\t// the planning their commands run (R9).\n381\tfunc delegateTaskNextActions(store posemodel.Store, a posemodel.DelegationAttempt, latest posemodel.ReviewRun) []delegateNextAction {\n382\t\treason := func(err error) string { return strings.TrimPrefix(err.Error(), \"pose: \") }\n383\t\tvar actions []delegateNextAction\n384\t\tif i := latest.Interruption; latest.Status == posemodel.ReviewRunInterrupted && i != nil {\n385\t\t\tresume := delegateNextAction{Action: \"resume\", Command: \"pose delegate resume \" + a.AttemptID}\n386\t\t\tplan, err := store.PlanDelegationTaskResume(latest.RunID, \"\")\n387\t\t\tswitch {\n388\t\t\tcase !i.Resumable:\n389\t\t\t\tresume.Why = tr(\"the stop is not resumable\", \"a parada não é retomável\")\n390\t\t\tcase err != nil:\n391\t\t\t\tresume.Why = reason(err)\n392\t\t\tcase plan.Existing != nil:\n393\t\t\t\tresume.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n394\t\t\t}\n395\t\t\tif resume.Why == \"\" {\n396\t\t\t\treset, resetErr := time.Parse(time.RFC3339Nano, i.ResetAt)\n397\t\t\t\tif i.ResetAt != \"\" && resetErr == nil && reset.After(time.Now()) {\n398\t\t\t\t\twait := delegateNextAction{Action: \"wait\", Command: \"pose delegate resume \" + a.AttemptID + \" --wait-until-reset\"}\n399\t\t\t\t\tif _, err := posemodel.ReviewResumeDelay(latest, time.Now(), 24*time.Hour, 0); err != nil {\n400\t\t\t\t\t\twait.Why = reason(err)\n401\t\t\t\t\t} else {\n402\t\t\t\t\t\twait.Available = true\n403\t\t\t\t\t}\n404\t\t\t\t\tactions = append(actions, wait)\n405\t\t\t\t\tresume.Why = tr(\"the agent is limited until \", \"o agente está limitado até \") + i.ResetAt\n406\t\t\t\t} else {\n407\t\t\t\t\tresume.Available = true\n408\t\t\t\t}\n409\t\t\t}\n410\t\t\tactions = append(actions, resume)\n411\t\t}\n412\t\thandoff := delegateNextAction{Action: \"handoff\", Command: \"pose delegate handoff \" + a.AttemptID + \" --to auto\"}\n413\t\tif agent, _, err := routeTaskHandoff(store, latest); err != nil {\n414\t\t\thandoff.Why = reason(err)\n415\t\t} else if plan, err := store.PlanDelegationTaskHandoff(latest.RunID, agent); err != nil {\n416\t\t\thandoff.Why = reason(err)\n417\t\t} else if plan.Existing != nil {\n418\t\t\thandoff.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n419\t\t} else {\n420\t\t\thandoff.Available = true\n421\t\t}\n422\t\treturn append(actions, handoff, delegateCancelAction())\n423\t}\n424\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"3b05ea44-9d4a-4f00-8816-112970e4fed0","timestamp":"2026-11-27T23:08:04.353Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-668ca2f6e0/worktree/pose-mcp/internal/cli/delegate_task.go","content":"\t\t\t}\n\t\t}\n\t}\n\tif err != nil {\n\t\tout.Failure(\"pose delegate \" + command + \": \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n\t}\n\treturn code\n}\n\n// cmdDelegateTaskResume continues a stopped task with its own agent and\n// session; without --prompt it sends the default continuation message (R8).\nfunc cmdDelegateTaskResume(root string, store posemodel.Store, f delegateFlags, attempt posemodel.DelegationAttempt, target string, stdout, stderr io.Writer) int {\n\tprompt := \"\"\n\tif f.promptFile != \"\" {\n\t\tvar err error\n\t\tif prompt, err = readDelegatePrompt(f.promptFile); err != nil {\n\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 2, err)\n\t\t}\n\t}\n\tplan, err := store.PlanDelegationTaskResume(target, prompt)\n\tif err != nil {\n\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"resume\", err, nil)\n\t}\n\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\tif f.wait && plan.Existing == nil && !f.dryRun {\n\t\tlatest := attempt.Latest()\n\t\tvar seed [1]byte\n\t\t_, _ = rand.Read(seed[:])\n\t\tdelay, err := posemodel.ReviewResumeDelay(*latest, time.Now(), f.waitMax, time.Duration(seed[0])*time.Second/255)\n\t\tif err != nil {\n\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n\t\t}\n\t\tif delay > 0 {\n\t\t\trender(io.Discard, stderr).Hint(\"pose delegate resume: \" + tr(\"waiting \", \"esperando \") + delay.String())\n\t\t\tselect {\n\t\t\tcase <-ctx.Done():\n\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, ctx.Err())\n\t\t\tcase <-time.After(delay):\n\t\t\t}\n\t\t\tif plan, err = store.PlanDelegationTaskResume(target, prompt); err != nil {\n\t\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"resume\", err, nil)\n\t\t\t}\n\t\t}\n\t}\n\tif plan.Existing != nil {\n\t\thandBackAttempt(plan.Existing.AttemptID)\n\t\treturn delegatePrintTask(stdout, stderr, f.jsonOut, \"resume\", *plan.Existing, nil)\n\t}\n\treturn runDelegateTask(root, store, ctx, plan, f, \"resume\", map[string]any{\"resumes\": target, \"attempt\": attempt.AttemptID}, stdout, stderr)\n}\n\n// cmdDelegateTaskHandoff continues a stopped task with another agent, its\n// prompt the stopped run's followed by the handoff section.\nfunc cmdDelegateTaskHandoff(root string, store posemodel.Store, f delegateFlags, attempt posemodel.DelegationAttempt, latest posemodel.ReviewRun, target string, stdout, stderr io.Writer) int {\n\tagent := f.to\n\truns, _ := store.ReadDelegationTaskRuns()\n\tfor _, r := range runs {\n\t\tif r.HandsOffFrom != target {\n\t\t\tcontinue\n\t\t}\n\t\tif agent != \"auto\" && agent != r.Adapter {\n\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"handoff\", 1, fmt.Errorf(tr(\"run %s was already handed off to %s by run %s\", \"o run %s já foi repassado para %s pelo run %s\"), target, r.Adapter, r.RunID))\n\t\t}\n\t\tagent = r.Adapter\n\t}\n\tvar route *posemodel.DelegationRoutingRecord\n\tif agent == \"auto\" {\n\t\tchosen, record, err := routeTaskHandoff(store, latest)\n\t\tif err != nil {\n\t\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"handoff\", err, record)\n\t\t}\n\t\tagent, route = chosen, record\n\t}\n\tplan, err := store.PlanDelegationTaskHandoff(target, agent)\n\tif err != nil {\n\t\treturn delegateTaskFail(stdout, stderr, f.jsonOut, \"handoff\", err, nil)\n\t}\n\tif plan.Existing != nil {\n\t\thandBackAttempt(plan.Existing.AttemptID)\n\t\treturn delegatePrintTask(stdout, stderr, f.jsonOut, \"handoff\", *plan.Existing, nil)\n\t}\n\tplan.Routing = route\n\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\treturn runDelegateTask(root, store, ctx, plan, f, \"handoff\", map[string]any{\"hands_off_from\": target, \"attempt\": attempt.AttemptID}, stdout, stderr)\n}\n\n// routeTaskHandoff routes the handoff of a task among the agents with a\n// command for its access, the stopped agent excluded; it never waits.\nfunc routeTaskHandoff(store posemodel.Store, prior posemodel.ReviewRun) (string, *posemodel.DelegationRoutingRecord, error) {\n\tpolicy, _, found, err := store.LoadDelegationPolicy()\n\tif err != nil {\n\t\treturn \"\", nil, err\n\t}\n\tif !found {\n\t\treturn \"\", nil, posemodel.ErrNoReviewerAdapter\n\t}\n\tagent, record, err := routeTask(store, policy, prior.Access, \"auto\", prior.Lead, prior.Adapter)\n\tif err != nil {\n\t\treturn \"\", record, err\n\t}\n\tif record.Step == posemodel.DelegationStepWait {\n\t\treturn \"\", record, errors.New(tr(\"every other agent is limited until \"+record.WaitUntil+\"; hand off after the reset, or wait for this run's reset and resume it\",\n\t\t\t\"todos os outros agentes estão limitados até \"+record.WaitUntil+\"; faça o handoff depois do reset, ou espere o reset deste run e o retome\"))\n\t}\n\treturn agent, record, nil\n}\n\n// delegateTaskNextActions are the ways forward of a stopped task, judged by\n// the planning their commands run (R9).\nfunc delegateTaskNextActions(store posemodel.Store, a posemodel.DelegationAttempt, latest posemodel.ReviewRun) []delegateNextAction {\n\treason := func(err error) string { return strings.TrimPrefix(err.Error(), \"pose: \") }\n\tvar actions []delegateNextAction\n\tif i := latest.Interruption; latest.Status == posemodel.ReviewRunInterrupted && i != nil {\n\t\tresume := delegateNextAction{Action: \"resume\", Command: \"pose delegate resume \" + a.AttemptID}\n\t\tplan, err := store.PlanDelegationTaskResume(latest.RunID, \"\")\n\t\tswitch {\n\t\tcase !i.Resumable:\n\t\t\tresume.Why = tr(\"the stop is not resumable\", \"a parada não é retomável\")\n\t\tcase err != nil:\n\t\t\tresume.Why = reason(err)\n\t\tcase plan.Existing != nil:\n\t\t\tresume.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n\t\t}\n\t\tif resume.Why == \"\" {\n\t\t\treset, resetErr := time.Parse(time.RFC3339Nano, i.ResetAt)\n\t\t\tif i.ResetAt != \"\" && resetErr == nil && reset.After(time.Now()) {\n\t\t\t\twait := delegateNextAction{Action: \"wait\", Command: \"pose delegate resume \" + a.AttemptID + \" --wait-until-reset\"}\n\t\t\t\tif _, err := posemodel.ReviewResumeDelay(latest, time.Now(), 24*time.Hour, 0); err != nil {\n\t\t\t\t\twait.Why = reason(err)\n\t\t\t\t} else {\n\t\t\t\t\twait.Available = true\n\t\t\t\t}\n\t\t\t\tactions = append(actions, wait)\n\t\t\t\tresume.Why = tr(\"the agent is limited until \", \"o agente está limitado até \") + i.ResetAt\n\t\t\t} else {\n\t\t\t\tresume.Available = true\n\t\t\t}\n\t\t}\n\t\tactions = append(actions, resume)\n\t}\n\thandoff := delegateNextAction{Action: \"handoff\", Command: \"pose delegate handoff \" + a.AttemptID + \" --to auto\"}\n\tif agent, _, err := routeTaskHandoff(store, latest); err != nil {\n\t\thandoff.Why = reason(err)\n\t} else if plan, err := store.PlanDelegationTaskHandoff(latest.RunID, agent); err != nil {\n\t\thandoff.Why = reason(err)\n\t} else if plan.Existing != nil {\n\t\thandoff.Why = tr(\"the run was already continued\", \"o run já foi continuado\")\n\t} else {\n\t\thandoff.Available = true\n\t}\n\treturn append(actions, handoff, delegateCancelAction())\n}\n","numLines":155,"startLine":270,"totalLines":424}},"tool_result_meta":[{"id":"toolu_016ZMYGR94fTo659PxSiETW5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
