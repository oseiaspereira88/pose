r\n pose-mcp/internal/scaffold/dist/POSE.md               | 2 +-\n pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md | 2 +-\n 2 files changed, 2 insertions(+), 2 deletions(-)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Vba9fDwkziW8ZRp1YG1yki","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
