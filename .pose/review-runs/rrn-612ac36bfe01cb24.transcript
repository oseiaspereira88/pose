{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017nWd2tWnS81Fq4mMBfHoXT","type":"tool_result","content":"225\t\t}\n226\t}\n227\tfunc TestRunContinuityDoctorStatusAndPending(t *testing.T) {\n228\t\troot, s, r := runContinuityFixture(t)\n229\t\twarns := 0\n230\t\tdiagnoseReviewContinuity(root, func(check, level, message, hint string) {\n231\t\t\tif check == \"review.interrupted\" && level == \"warn\" && strings.Contains(message, r.RunID) {\n232\t\t\t\twarns++\n233\t\t\t}\n234\t\t})\n235\t\tif warns != 1 {\n236\t\t\tt.Fatal(\"doctor missed interruption\")\n237\t\t}\n238\t\tif code, out := runPose(t, root, \"delegate\", \"ls\", \"--json\"); code != 0 || !strings.Contains(out, `\"time_left\"`) || !strings.Contains(out, `\"partial\": true`) {\n239\t\t\tt.Fatal(code, out)\n240\t\t}\n241\t\traw, _ := json.Marshal(r)\n242\t\tdigest := sha256.Sum256(raw)\n243\t\tclaim := map[string]any{\"schema_version\": 1, \"predecessor\": r.RunID, \"attempt_id\": r.AttemptID, \"predecessor_digest\": \"sha256:\" + hex.EncodeToString(digest[:]), \"claimed_at\": time.Now().UTC().Format(time.RFC3339Nano), \"nonce\": strings.Repeat(\"a\", 32)}\n244\t\tclaimRaw, _ := json.Marshal(claim)\n245\t\tdir := filepath.Join(root, \".pose/review-continuations\")\n246\t\tif e := os.MkdirAll(dir, 0755); e != nil {\n247\t\t\tt.Fatal(e)\n248\t\t}\n249\t\tif e := os.WriteFile(filepath.Join(dir, r.RunID+\".json\"), claimRaw, 0644); e != nil {\n250\t\t\tt.Fatal(e)\n251\t\t}\n252\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", r.RunID); code != 0 || !strings.Contains(out, \"delegate.status=pending\") || !strings.Contains(out, \"resume-of:\"+r.RunID) {\n253\t\t\tt.Fatal(\"pending not returned\", code, out)\n254\t\t}\n255\t\truns, _ := s.ListReviewRuns(\"\")\n256\t\tif len(runs) != 1 {\n257\t\t\tt.Fatal(\"pending claim launched another process\")\n258\t\t}\n259\t}\n260\t\n261\tfunc TestRunContinuityConcurrentResumeLaunchesOnce(t *testing.T) {\n262\t\tmarker := filepath.Join(t.TempDir(), \"launches\")\n263\t\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n264\t\t\ta.Resume.Command = []string{\"sh\", \"-c\", `printf 'start\\n' >> \"$2\"; sleep 0.05; printf 'decision: approved\\n'`, \"sh\", \"{session}\", marker}\n265\t\t})\n266\t\tplan, e := s.PlanReviewResume(r.RunID)\n267\t\tif e != nil {\n268\t\t\tt.Fatal(e)\n269\t\t}\n270\t\tvar wg sync.WaitGroup\n271\t\tfor i := 0; i < 8; i++ {\n272\t\t\twg.Add(1)\n273\t\t\tgo func() { defer wg.Done(); _, _ = s.RunReviewDispatch(plan, time.Now) }()\n274\t\t}\n275\t\twg.Wait()\n276\t\traw, e := os.ReadFile(marker)\n277\t\tif e != nil || string(raw) != \"start\\n\" {\n278\t\t\tt.Fatalf(\"duplicate launches %q %v\", raw, e)\n279\t\t}\n280\t\truns, lost, e := s.ReadReviewRuns(\"\")\n281\t\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n282\t\t\tt.Fatal(len(runs), lost, e)\n283\t\t}\n284\t}\n285\tfunc TestRunContinuityObservedProcessLoss(t *testing.T) {\n286\t\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n287\t\t\ta.Command = []string{\"sh\", \"-c\", `printf 'session: fixture-private-session\\n'; kill -KILL $$`}\n288\t\t})\n289\t\tif r.Interruption.Cause != \"process-lost\" || !r.Interruption.Resumable {\n290\t\t\tt.Fatal(r.Interruption)\n291\t\t}\n292\t\tif _, e := s.PlanReviewResume(r.RunID); e != nil {\n293\t\t\tt.Fatal(e)\n294\t\t}\n295\t}\n296\t\n297\t// Spec pose-review-resume-keeps-the-sealed-checkout R1, R2: a resumed session\n298\t// works in the sealed checkout it saw before the interruption, recreated at\n299\t// the same path after the interrupted run removed it.\n300\tfunc TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath(t *testing.T) {\n301\t\tmarks := t.TempDir()\n302\t\tfirst := filepath.Join(marks, \"first\")\n303\t\troot, _, prior := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n304\t\t\ta.Command = []string{\"sh\", \"-c\", `pwd > \"$1\"; printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\ndecision: rejected\\n'; exit 75`, \"sh\", first}\n305\t\t\ta.Resume.Command = []string{\"sh\", \"-c\", `test \"$(pwd)\" = \"$(cat \"$1\")\" || { echo \"moved from $(cat \"$1\") to $(pwd)\" >&2; exit 3; }; test -f .pose/specs/alpha/spec.md || exit 4; printf 'decision: approved\\n'`, \"sh\", first, \"{session}\"}\n306\t\t})\n307\t\traw, err := os.ReadFile(first)\n308\t\tif err != nil {\n309\t\t\tt.Fatal(err)\n310\t\t}\n311\t\tcheckout := strings.TrimSpace(string(raw))\n312\t\tif _, err := os.Stat(checkout); !os.IsNotExist(err) {\n313\t\t\tt.Fatalf(\"the interrupted run left its checkout %s behind: %v\", checkout, err)\n314\t\t}\n315\t\t// Review round 1, N1: a leftover runtime directory refuses the resume\n316\t\t// before it is claimed, so removing it restores the resume.\n317\t\truntimeDir := filepath.Dir(checkout)\n318\t\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n319\t\t\tt.Fatal(err)\n320\t\t}\n321\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID); code == 0 || !strings.Contains(out, \"then resume again\") {\n322\t\t\tt.Fatalf(\"a resume beside a leftover runtime directory: %d %s\", code, out)\n323\t\t}\n324\t\t// Review round 2, N6: a handoff is refused the same way, before it\n325\t\t// claims the interrupted run.\n326\t\tif _, err := (posemodel.Store{Root: root}).PlanReviewHandoff(prior.RunID, \"other\"); err == nil || !strings.Contains(err.Error(), \"still exists\") || !strings.Contains(err.Error(), \"then hand off again\") {\n327\t\t\tt.Fatalf(\"a handoff beside a leftover runtime directory: %v\", err)\n328\t\t}\n329\t\tif err := os.Remove(runtimeDir); err != nil {\n330\t\t\tt.Fatal(err)\n331\t\t}\n332\t\t// Spec pose-review-resume-runtime-dir-followups R1: a directory that\n333\t\t// appears between the plan and the dispatch is refused before the claim,\n334\t\t// so the interrupted run stays resumable.\n335\t\tstore := posemodel.Store{Root: root}\n336\t\tplan, err := store.PlanReviewResume(prior.RunID)\n337\t\tif err != nil {\n338\t\t\tt.Fatal(err)\n339\t\t}\n340\t\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n341\t\t\tt.Fatal(err)\n342\t\t}\n343\t\tif _, err := store.RunReviewDispatch(plan, time.Now); err == nil || !(strings.Contains(err.Error(), \"already exists\") || strings.Contains(err.Error(), \"still exists\")) {\n344\t\t\tt.Fatalf(\"a dispatch beside a directory that appeared: %v\", err)\n345\t\t}\n346\t\tif err := os.Remove(runtimeDir); err != nil {\n347\t\t\tt.Fatal(err)\n348\t\t}\n349\t\tcode, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID)\n350\t\tif code != 0 || !strings.Contains(out, \"status=completed\") {\n351\t\t\tt.Fatalf(\"the resumed session did not find its checkout at %s: %d %s\", checkout, code, out)\n352\t\t}\n353\t}\n354\t\n355\t// Review round 1 of spec pose-review-resume-runtime-dir-followups, N1: a\n356\t// continuation that fails before it owns its cleanup removes the runtime\n357\t// directory it took, so nothing is left for a later continuation to meet.\n358\tfunc TestRunContinuityAFailedContinuationLeavesNoRuntimeDirectory(t *testing.T) {\n359\t\tmarks := t.TempDir()\n360\t\tfirst := filepath.Join(marks, \"first\")\n361\t\troot, _, prior := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n362\t\t\ta.Command = []string{\"sh\", \"-c\", `pwd > \"$1\"; printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\ndecision: rejected\\n'; exit 75`, \"sh\", first}\n363\t\t})\n364\t\traw, err := os.ReadFile(first)\n365\t\tif err != nil {\n366\t\t\tt.Fatal(err)\n367\t\t}\n368\t\truntimeDir := filepath.Dir(strings.TrimSpace(string(raw)))\n369\t\tstore := posemodel.Store{Root: root}\n370\t\tplan, err := store.PlanReviewResume(prior.RunID)\n371\t\tif err != nil {\n372\t\t\tt.Fatal(err)\n373\t\t}\n374\t\tplan.OnStart = func(string) error { return errors.New(\"no hand-back here\") }\n375\t\trun, _ := store.RunReviewDispatch(plan, time.Now)\n376\t\tif run.Status != posemodel.ReviewRunFailed {\n377\t\t\tt.Fatalf(\"a failing hand-back did not fail the continuation: %+v\", run.Status)\n378\t\t}\n379\t\tif _, err := os.Lstat(runtimeDir); !os.IsNotExist(err) {\n380\t\t\tt.Fatalf(\"a failed continuation left its runtime directory %s: %v\", runtimeDir, err)\n381\t\t}\n382\t}\n383\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"301cc0ec-92d7-466a-8476-b07c76fe1016","timestamp":"2026-11-27T23:10:02.951Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-668ca2f6e0/worktree/pose-mcp/internal/cli/review_run_continuity_test.go","content":"\t}\n}\nfunc TestRunContinuityDoctorStatusAndPending(t *testing.T) {\n\troot, s, r := runContinuityFixture(t)\n\twarns := 0\n\tdiagnoseReviewContinuity(root, func(check, level, message, hint string) {\n\t\tif check == \"review.interrupted\" && level == \"warn\" && strings.Contains(message, r.RunID) {\n\t\t\twarns++\n\t\t}\n\t})\n\tif warns != 1 {\n\t\tt.Fatal(\"doctor missed interruption\")\n\t}\n\tif code, out := runPose(t, root, \"delegate\", \"ls\", \"--json\"); code != 0 || !strings.Contains(out, `\"time_left\"`) || !strings.Contains(out, `\"partial\": true`) {\n\t\tt.Fatal(code, out)\n\t}\n\traw, _ := json.Marshal(r)\n\tdigest := sha256.Sum256(raw)\n\tclaim := map[string]any{\"schema_version\": 1, \"predecessor\": r.RunID, \"attempt_id\": r.AttemptID, \"predecessor_digest\": \"sha256:\" + hex.EncodeToString(digest[:]), \"claimed_at\": time.Now().UTC().Format(time.RFC3339Nano), \"nonce\": strings.Repeat(\"a\", 32)}\n\tclaimRaw, _ := json.Marshal(claim)\n\tdir := filepath.Join(root, \".pose/review-continuations\")\n\tif e := os.MkdirAll(dir, 0755); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e := os.WriteFile(filepath.Join(dir, r.RunID+\".json\"), claimRaw, 0644); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif code, out := runPose(t, root, \"delegate\", \"resume\", r.RunID); code != 0 || !strings.Contains(out, \"delegate.status=pending\") || !strings.Contains(out, \"resume-of:\"+r.RunID) {\n\t\tt.Fatal(\"pending not returned\", code, out)\n\t}\n\truns, _ := s.ListReviewRuns(\"\")\n\tif len(runs) != 1 {\n\t\tt.Fatal(\"pending claim launched another process\")\n\t}\n}\n\nfunc TestRunContinuityConcurrentResumeLaunchesOnce(t *testing.T) {\n\tmarker := filepath.Join(t.TempDir(), \"launches\")\n\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n\t\ta.Resume.Command = []string{\"sh\", \"-c\", `printf 'start\\n' >> \"$2\"; sleep 0.05; printf 'decision: approved\\n'`, \"sh\", \"{session}\", marker}\n\t})\n\tplan, e := s.PlanReviewResume(r.RunID)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tvar wg sync.WaitGroup\n\tfor i := 0; i < 8; i++ {\n\t\twg.Add(1)\n\t\tgo func() { defer wg.Done(); _, _ = s.RunReviewDispatch(plan, time.Now) }()\n\t}\n\twg.Wait()\n\traw, e := os.ReadFile(marker)\n\tif e != nil || string(raw) != \"start\\n\" {\n\t\tt.Fatalf(\"duplicate launches %q %v\", raw, e)\n\t}\n\truns, lost, e := s.ReadReviewRuns(\"\")\n\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n\t\tt.Fatal(len(runs), lost, e)\n\t}\n}\nfunc TestRunContinuityObservedProcessLoss(t *testing.T) {\n\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n\t\ta.Command = []string{\"sh\", \"-c\", `printf 'session: fixture-private-session\\n'; kill -KILL $$`}\n\t})\n\tif r.Interruption.Cause != \"process-lost\" || !r.Interruption.Resumable {\n\t\tt.Fatal(r.Interruption)\n\t}\n\tif _, e := s.PlanReviewResume(r.RunID); e != nil {\n\t\tt.Fatal(e)\n\t}\n}\n\n// Spec pose-review-resume-keeps-the-sealed-checkout R1, R2: a resumed session\n// works in the sealed checkout it saw before the interruption, recreated at\n// the same path after the interrupted run removed it.\nfunc TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath(t *testing.T) {\n\tmarks := t.TempDir()\n\tfirst := filepath.Join(marks, \"first\")\n\troot, _, prior := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n\t\ta.Command = []string{\"sh\", \"-c\", `pwd > \"$1\"; printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\ndecision: rejected\\n'; exit 75`, \"sh\", first}\n\t\ta.Resume.Command = []string{\"sh\", \"-c\", `test \"$(pwd)\" = \"$(cat \"$1\")\" || { echo \"moved from $(cat \"$1\") to $(pwd)\" >&2; exit 3; }; test -f .pose/specs/alpha/spec.md || exit 4; printf 'decision: approved\\n'`, \"sh\", first, \"{session}\"}\n\t})\n\traw, err := os.ReadFile(first)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcheckout := strings.TrimSpace(string(raw))\n\tif _, err := os.Stat(checkout); !os.IsNotExist(err) {\n\t\tt.Fatalf(\"the interrupted run left its checkout %s behind: %v\", checkout, err)\n\t}\n\t// Review round 1, N1: a leftover runtime directory refuses the resume\n\t// before it is claimed, so removing it restores the resume.\n\truntimeDir := filepath.Dir(checkout)\n\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID); code == 0 || !strings.Contains(out, \"then resume again\") {\n\t\tt.Fatalf(\"a resume beside a leftover runtime directory: %d %s\", code, out)\n\t}\n\t// Review round 2, N6: a handoff is refused the same way, before it\n\t// claims the interrupted run.\n\tif _, err := (posemodel.Store{Root: root}).PlanReviewHandoff(prior.RunID, \"other\"); err == nil || !strings.Contains(err.Error(), \"still exists\") || !strings.Contains(err.Error(), \"then hand off again\") {\n\t\tt.Fatalf(\"a handoff beside a leftover runtime directory: %v\", err)\n\t}\n\tif err := os.Remove(runtimeDir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// Spec pose-review-resume-runtime-dir-followups R1: a directory that\n\t// appears between the plan and the dispatch is refused before the claim,\n\t// so the interrupted run stays resumable.\n\tstore := posemodel.Store{Root: root}\n\tplan, err := store.PlanReviewResume(prior.RunID)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := store.RunReviewDispatch(plan, time.Now); err == nil || !(strings.Contains(err.Error(), \"already exists\") || strings.Contains(err.Error(), \"still exists\")) {\n\t\tt.Fatalf(\"a dispatch beside a directory that appeared: %v\", err)\n\t}\n\tif err := os.Remove(runtimeDir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcode, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID)\n\tif code != 0 || !strings.Contains(out, \"status=completed\") {\n\t\tt.Fatalf(\"the resumed session did not find its checkout at %s: %d %s\", checkout, code, out)\n\t}\n}\n\n// Review round 1 of spec pose-review-resume-runtime-dir-followups, N1: a\n// continuation that fails before it owns its cleanup removes the runtime\n// directory it took, so nothing is left for a later continuation to meet.\nfunc TestRunContinuityAFailedContinuationLeavesNoRuntimeDirectory(t *testing.T) {\n\tmarks := t.TempDir()\n\tfirst := filepath.Join(marks, \"first\")\n\troot, _, prior := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n\t\ta.Command = []string{\"sh\", \"-c\", `pwd > \"$1\"; printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\ndecision: rejected\\n'; exit 75`, \"sh\", first}\n\t})\n\traw, err := os.ReadFile(first)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\truntimeDir := filepath.Dir(strings.TrimSpace(string(raw)))\n\tstore := posemodel.Store{Root: root}\n\tplan, err := store.PlanReviewResume(prior.RunID)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tplan.OnStart = func(string) error { return errors.New(\"no hand-back here\") }\n\trun, _ := store.RunReviewDispatch(plan, time.Now)\n\tif run.Status != posemodel.ReviewRunFailed {\n\t\tt.Fatalf(\"a failing hand-back did not fail the continuation: %+v\", run.Status)\n\t}\n\tif _, err := os.Lstat(runtimeDir); !os.IsNotExist(err) {\n\t\tt.Fatalf(\"a failed continuation left its runtime directory %s: %v\", runtimeDir, err)\n\t}\n}\n","numLines":159,"startLine":225,"totalLines":383}},"tool_result_meta":[{"id":"toolu_017nWd2tWnS81Fq4mMBfHoXT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
