{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tgmm7MCqAY2Pd7gh6UhbmP","type":"tool_result","content":"diff --git a/pose-mcp/internal/pose/delegation_handoff.go b/pose-mcp/internal/pose/delegation_handoff.go\nindex c157a8cb..96fda428 100644\n--- a/pose-mcp/internal/pose/delegation_handoff.go\n+++ b/pose-mcp/internal/pose/delegation_handoff.go\n@@ -11,6 +11,7 @@ package pose\n // as the handoff run's own decision; only the handoff run concludes.\n \n import (\n+\t\"context\"\n \t\"errors\"\n \t\"fmt\"\n \t\"path/filepath\"\n@@ -348,10 +349,16 @@ func (s Store) PlanReviewHandoff(id, agent string) (DispatchPlan, error) {\n \t\t// Another resume takes the directory just before its claim: a claim\n \t\t// that appears meanwhile makes this one pending (spec\n \t\t// pose-review-resume-runtime-dir-followups R1).\n-\t\tif pending := s.awaitContinuationClaim(*prior); pending != nil {\n+\t\texisting, pending := s.awaitContinuationClaim(context.Background(), *prior)\n+\t\tif pending != nil {\n \t\t\tplan.PendingContinuation = pending\n \t\t\treturn plan, nil\n \t\t}\n+\t\tif existing != nil {\n+\t\t\t// Another resume ended meanwhile: its record is the answer\n+\t\t\t// (spec pose-review-resume-residuals R1).\n+\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was already continued by run %s\", prior.RunID, existing.RunID)\n+\t\t}\n \t\treturn DispatchPlan{}, e\n \t}\n \tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\ndiff --git a/pose-mcp/internal/pose/review_dispatch.go b/pose-mcp/internal/pose/review_dispatch.go\nindex a4a4a19d..15c05e7f 100644\n--- a/pose-mcp/internal/pose/review_dispatch.go\n+++ b/pose-mcp/internal/pose/review_dispatch.go\n@@ -756,7 +756,11 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t\t// predecessor stays resumable, and one that lost the race to another\n \t\t// resume is told the continuation is pending (spec\n \t\t// pose-review-resume-runtime-dir-followups R1).\n-\t\tdir, err := s.takeContinuationRuntimeDir(plan)\n+\t\tdir, err := s.takeContinuationRuntimeDir(parent, plan)\n+\t\tvar recorded *continuationRecorded\n+\t\tif errors.As(err, &recorded) {\n+\t\t\treturn existingReviewDispatchResult(recorded.run)\n+\t\t}\n \t\tif err != nil {\n \t\t\treturn ReviewRun{}, err\n \t\t}\n@@ -765,6 +769,16 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t\t\tif dir != \"\" {\n \t\t\t\t_ = os.Remove(dir)\n \t\t\t}\n+\t\t\t// Another resume claimed and may already have ended: its record\n+\t\t\t// is the answer, not the publication conflict (R1).\n+\t\t\tif again, rerr := s.replanContinuation(plan); rerr == nil {\n+\t\t\t\tif again.Existing != nil {\n+\t\t\t\t\treturn existingReviewDispatchResult(*again.Existing)\n+\t\t\t\t}\n+\t\t\t\tif again.PendingContinuation != nil {\n+\t\t\t\t\treturn ReviewRun{}, again.PendingContinuation\n+\t\t\t\t}\n+\t\t\t}\n \t\t\treturn ReviewRun{}, err\n \t\t}\n \t}\n@@ -829,7 +843,20 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t}\n \ttmp, err := preparedRuntimeDir, error(nil)\n \tif tmp == \"\" {\n-\t\ttmp, err = reviewRunRuntimeDir(s.runtimeSourceFor(plan, run.AttemptID))\n+\t\tsource, why := s.runtimeSourceFor(plan, run.AttemptID)\n+\t\ttmp, err = reviewRunRuntimeDir(source)\n+\t\tif err != nil && errors.Is(err, fs.ErrExist) && source != run.AttemptID && plan.predecessor == nil {\n+\t\t\t// The previous round's path was taken after the plan: the round\n+\t\t\t// works in its own directory rather than fail with its attempt\n+\t\t\t// reserved (R3).\n+\t\t\twhy = \"the previous round's checkout path \" + filepath.Join(os.TempDir(), source) + \" was taken after the round was planned\"\n+\t\t\ttmp, err = reviewRunRuntimeDir(run.AttemptID)\n+\t\t}\n+\t\tif why != \"\" && err == nil {\n+\t\t\t// The continued session will not find its checkout where it saw\n+\t\t\t// it; the run says so (R2, R3).\n+\t\t\tsafety