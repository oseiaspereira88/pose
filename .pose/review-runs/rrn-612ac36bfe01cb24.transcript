pending := s.awaitContinuationClaim(ctx, *plan.predecessor)\n2248:// awaitContinuationClaim waits briefly for another resume's claim on prior's\n2253:func (s Store) awaitContinuationClaim(ctx context.Context, prior ReviewRun) (*ReviewRun, *PendingReviewContinuation) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01AnAdDpNHmLPS1JkKg6DC5h","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChUGpRVsDi4ywJnWyFk1c","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014YXXxtT3UonNzEfxKDzrtV","name":"Read","input":{"file_path":"/var/tmp/pose-work-go/pose-review-run-668ca2f6e0/worktree/pose-mcp/internal/pose/review_dispatch.go","offset":230,"limit":760},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5141,"cache_read_input_tokens":35474,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5141},"output_tokens":17,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"372d8e4f-6729-454c-87b3-03fb2b85acc5","timestamp":"2026-11-27T23:07:50.083Z","request_id":"req_011ChUGpRLhbV5UoV4oCcwHb","wire_tool_inputs":{"toolu_014YXXxtT3UonNzEfxKDzrtV":{"file_path":"/var/tmp/pose-work-go/pose-review-run-668ca2f6e0/worktree/pose-mcp/internal/pose/review_dispatch.go","offset":230,"limit":760}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014YXXxtT3UonNzEfxKDzrtV","type":"tool_result","content":"230\t\tThread        *ReviewThread `json:\"thread,omitempty\"`\n231\t\tPath          string        `json:\"-\"`\n232\t\t// eventsDir is where a task run's files are; a review run's are in\n233\t\t// reviewRunsDir.\n234\t\teventsDir string\n235\t}\n236\t\n237\t// Review run states.\n238\tconst (\n239\t\tReviewRunCompleted   = \"completed\"\n240\t\tReviewRunFailed      = \"failed\"\n241\t\tReviewRunInterrupted = \"interrupted\"\n242\t\tReviewRunStale       = \"stale\"\n243\t)\n244\t\n245\t// ListReviewRuns returns the recorded runs for bundleID (\"\" for all).\n246\tfunc (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n247\t\truns, _, err := s.ReadReviewRuns(bundleID)\n248\t\treturn runs, err\n249\t}\n250\t\n251\tfunc (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n252\t\t// Within a read-view operation the ledger is read and checked once per\n253\t\t// root; every request of the operation is answered from that read,\n254\t\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n255\t\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n256\t\t\truns, lost, err := s.readAllReviewRuns()\n257\t\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n258\t\t})\n259\t\tif err != nil {\n260\t\t\treturn nil, nil, err\n261\t\t}\n262\t\tout := copyReviewRuns(all.runs)\n263\t\tif bundleID != \"\" {\n264\t\t\tfiltered := []ReviewRun{}\n265\t\t\tfor _, run := range out {\n266\t\t\t\tif run.BundleID == bundleID {\n267\t\t\t\t\tfiltered = append(filtered, run)\n268\t\t\t\t}\n269\t\t\t}\n270\t\t\tout = filtered\n271\t\t}\n272\t\treturn out, deepCopyValue(all.lost), nil\n273\t}\n274\t\n275\t// readAllReviewRuns reads, checks and orders every review run of the store.\n276\tfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n277\t\tfiles := s.fsys()\n278\t\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n279\t\t// The storage is read where the writer writes it: a link in its place is another place.\n280\t\tif info, lerr := files.Lstat(dir); lerr == nil {\n281\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n282\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n283\t\t\t}\n284\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n285\t\t\treturn nil, nil, lerr\n286\t\t}\n287\t\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n288\t\tif errors.Is(err, os.ErrNotExist) {\n289\t\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n290\t\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n291\t\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n292\t\t\t\treturn nil, nil, lerr\n293\t\t\t}\n294\t\t\treturn []ReviewRun{}, nil, nil\n295\t\t}\n296\t\tif err != nil {\n297\t\t\treturn nil, nil, err\n298\t\t}\n299\t\tout := []ReviewRun{}\n300\t\tvar lost []string\n301\t\treadBudget := int64(32 << 20)\n302\t\tfor _, e := range entries {\n303\t\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n304\t\t\t\tcontinue\n305\t\t\t}\n306\t\t\tfull := filepath.Join(dir, e.Name())\n307\t\t\tinfo, infoErr := files.Lstat(full)\n308\t\t\tif infoErr != nil || !info.Mode().IsRegular() {\n309\t\t\t\tlost = append(lost, e.Name()+\" (not a regular file)\")\n310\t\t\t\tcontinue\n311\t\t\t}\n312\t\t\tif info.Size() < 0 || info.Size() > reviewLedgerMaxBytes {\n313\t\t\t\tlost = append(lost, e.Name()+\" (record exceeds bound or is unreadable)\")\n314\t\t\t\tcontinue\n315\t\t\t}\n316\t\t\traw, err := readLedgerRawBudgetIn(files, full, &readBudget)\n317\t\t\tif err != nil {\n318\t\t\t\tlost = append(lost, e.Name()+\" (\"+err.Error()+\")\")\n319\t\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n320\t\t\t\t\tbreak\n321\t\t\t\t}\n322\t\t\t\tcontinue\n323\t\t\t}\n324\t\t\tvar run ReviewRun\n325\t\t\tif json.Unmarshal(raw, &run) != nil || run.RunID == \"\" {\n326\t\t\t\tlost = append(lost, e.Name()+\" (not a review run)\")\n327\t\t\t\tcontinue\n328\t\t\t}\n329\t\t\tif verr := validateReviewRunRecord(e.Name(), run); verr != nil {\n330\t\t\t\tlost = append(lost, e.Name()+\" (\"+verr.Error()+\")\")\n331\t\t\t\tcontinue\n332\t\t\t}\n333\t\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, e.Name()))\n334\t\t\tout = append(out, run)\n335\t\t}\n336\t\tsort.Slice(out, func(i, j int) bool {\n337\t\t\ta, _ := time.Parse(time.RFC3339Nano, out[i].StartedAt)\n338\t\t\tb, _ := time.Parse(time.RFC3339Nano, out[j].StartedAt)\n339\t\t\tif !a.Equal(b) {\n340\t\t\t\treturn a.Before(b)\n341\t\t\t}\n342\t\t\treturn out[i].RunID < out[j].RunID\n343\t\t})\n344\t\tsuperseded := map[string]string{}\n345\t\tfor _, run := range out {\n346\t\t\tif run.Supersedes != \"\" {\n347\t\t\t\tsuperseded[run.Supersedes] = run.RunID\n348\t\t\t}\n349\t\t}\n350\t\tfor i := range out {\n351\t\t\tout[i].SupersededBy = superseded[out[i].RunID]\n352\t\t}\n353\t\tchecked := map[string][]DelegatedReviewAttempt{}\n354\t\tfor _, run := range out {\n355\t\t\tif run.LedgerVersion == 1 {\n356\t\t\t\tif _, err := files.Lstat(filepath.Join(s.Root, reviewRunLedgerDir, run.RunID+\".json\")); err != nil {\n357\t\t\t\t\tlost = append(lost, \"missing run witness \"+run.RunID)\n358\t\t\t\t}\n359\t\t\t}\n360\t\t\tif run.AttemptID != \"\" {\n361\t\t\t\tattempts, ok := checked[run.BundleID]\n362\t\t\t\tif !ok {\n363\t\t\t\t\tvar aerr error\n364\t\t\t\t\tattempts, aerr = s.readDelegatedReviewAttempts(run.BundleID, &readBudget)\n365\t\t\t\t\tif aerr != nil {\n366\t\t\t\t\t\tlost = append(lost, aerr.Error())\n367\t\t\t\t\t}\n368\t\t\t\t\tchecked[run.BundleID] = attempts\n369\t\t\t\t}\n370\t\t\t\t// The reservation names the attempt's first agent; a continuation's\n371\t\t\t\t// agent is checked against its own predecessor by the continuation\n372\t\t\t\t// chain (a resume keeps it, a handoff changes it).\n373\t\t\t\tfound := false\n374\t\t\t\tfor _, a := range attempts {\n375\t\t\t\t\tif a.AttemptID == run.AttemptID && a.BundleDigest == run.BundleDigest && a.Scope == run.Scope && (a.Adapter == run.Adapter || run.continues() != \"\") && a.Reason == run.Reason {\n376\t\t\t\t\t\tfound = true\n377\t\t\t\t\t\tbreak\n378\t\t\t\t\t}\n379\t\t\t\t}\n380\t\t\t\tif !found {\n381\t\t\t\t\tlost = append(lost, \"missing or conflicting attempt reservation \"+run.AttemptID)\n382\t\t\t\t}\n383\t\t\t}\n384\t\t}\n385\t\tfindings, ledgerErr := s.reviewRunLedgerFindings(\"\", &readBudget)\n386\t\tif ledgerErr != nil {\n387\t\t\tlost = append(lost, ledgerErr.Error())\n388\t\t}\n389\t\tlost = append(lost, findings...)\n390\t\tlost = append(lost, s.reviewContinuationFindings(out)...)\n391\t\treturn out, uniqueSorted(lost), nil\n392\t}\n393\t\n394\t// DispatchPlan is what a dispatch will do.\n395\ttype DispatchPlan struct {\n396\t\tprovenance          *ReviewRunProvenance\n397\t\tPendingContinuation *PendingReviewContinuation\n398\t\tprocessTimeout      time.Duration\n399\t\tpredecessor         *ReviewRun\n400\t\t// handoff makes the continuation another agent's, with handoffSection\n401\t\t// appended to the brief (spec pose-delegation-handoff).\n402\t\thandoff        bool\n403\t\thandoffSection string\n404\t\tsession        string\n405\t\t// round is the round of the scope the run reviews, and thread how a\n406\t\t// round after the first relates to the previous round's session.\n407\t\tround  int\n408\t\tthread *ReviewThread\n409\t\t// extraChannels are outputs the interruption classifier reads beside the\n410\t\t// transcript and the output, each on its own: a task's stderr.\n411\t\textraChannels  []string\n412\t\tnotes          string\n413\t\tExisting       *ReviewRun\n414\t\tLimitOf        string\n415\t\tReason         string\n416\t\tPolicyDigest   string\n417\t\tOriginWorktree string\n418\t\tAdapter        string\n419\t\tConfig         ReviewerAdapter\n420\t\tBrief          ReviewBrief\n421\t\tBundle         ReviewBundle\n422\t\tSealedCommit   string\n423\t\tPriorRuns      int\n424\t\t// Effort is the requested effort level; \"\" means the agent's default.\n425\t\tEffort string\n426\t\t// Label, Purpose and Lead are recorded on the run (pose delegate).\n427\t\tLabel   string\n428\t\tPurpose string\n429\t\tLead    string\n430\t\t// Routing is set by pose delegate; without it the run is compared with\n431\t\t// the implementation the plan read (spec pose-delegation-routing R8).\n432\t\tRouting        *DelegationRoutingRecord\n433\t\timplementation *ReviewBundleImplementation\n434\t\t// Warnings are printed before the run starts. SameVendorWarning is set\n435\t\t// when the plan's agent shares the implementation's vendor; a caller that\n436\t\t// named the agent prints it, routing does not (R9).\n437\t\tWarnings          []string\n438\t\tSameVendorWarning string\n439\t\t// OnStart is called once the attempt is reserved and its marker written,\n440\t\t// so a detached run can hand its reference back (spec\n441\t\t// pose-delegated-review-completion-signal R1).\n442\t\tOnStart func(attempt string) error\n443\t}\n444\t\n445\t// Implementation is the identity the plan compares its agent with.\n446\tfunc (p DispatchPlan) Implementation() ReviewBundleImplementation {\n447\t\tswitch {\n448\t\tcase p.Routing != nil:\n449\t\t\treturn p.Routing.Implementation\n450\t\tcase p.implementation != nil:\n451\t\t\treturn *p.implementation\n452\t\t}\n453\t\treturn ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n454\t}\n455\t\n456\t// replanContinuation plans a continuation again at execution, as a resume or\n457\t// as a handoff to the same agent.\n458\tfunc (s Store) replanContinuation(plan DispatchPlan) (DispatchPlan, error) {\n459\t\tvar fresh DispatchPlan\n460\t\tvar err error\n461\t\tif plan.handoff {\n462\t\t\tfresh, err = s.PlanReviewHandoff(plan.predecessor.RunID, plan.Adapter)\n463\t\t} else {\n464\t\t\tfresh, err = s.PlanReviewResume(plan.predecessor.RunID)\n465\t\t}\n466\t\tif err != nil {\n467\t\t\treturn fresh, err\n468\t\t}\n469\t\t// What the caller set on the plan is kept: the hand-back of a detached run\n470\t\t// and the routing that chose its agent (spec pose-delegation-mcp R4).\n471\t\tfresh.OnStart, fresh.Purpose = plan.OnStart, plan.Purpose\n472\t\tif fresh.Routing == nil {\n473\t\t\tfresh.Routing = plan.Routing\n474\t\t}\n475\t\treturn fresh, nil\n476\t}\n477\t\n478\t// PlanImplementationWithLead reads the plan's implementation again with the\n479\t// --lead the caller declared, for a bundle that records none (R4), and records\n480\t// the agent as named.\n481\tfunc (s Store) PlanImplementationWithLead(plan *DispatchPlan, lead string) {\n482\t\tplan.Routing, plan.Warnings, plan.SameVendorWarning = nil, nil, \"\"\n483\t\ts.planImplementation(plan, lead)\n484\t}\n485\t\n486\t// routingAgainstAnotherBundle refuses a routing decision made against an\n487\t// implementation the plan's bundle does not record: the run would record an\n488\t// identity and an independence it did not have (spec pose-delegation-routing\n489\t// R8).\n490\tfunc routingAgainstAnotherBundle(plan DispatchPlan) string {\n491\t\tif plan.Routing == nil || plan.Routing.ImplementationFrom != ImplementationFromBundle {\n492\t\t\treturn \"\"\n493\t\t}\n494\t\tsealed := plan.Bundle.Payload.Implementation\n495\t\tif sealed == nil || !sameImplementation(*sealed, plan.Routing.Implementation) {\n496\t\t\treturn \"the run was routed against another implementation than bundle \" + plan.Bundle.BundleID + \" records; route it again\"\n497\t\t}\n498\t\treturn \"\"\n499\t}\n500\t\n501\t// planImplementation reads the identity a run of bundle is compared with,\n502\t// records the agent as named unless routing chose it (R8, R9), and warns when\n503\t// the policy still declares an identity the bundle overrides (R4).\n504\tfunc (s Store) planImplementation(plan *DispatchPlan, lead string) {\n505\t\timpl := ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n506\t\tfrom := ImplementationFromNone\n507\t\tif policy, _, found, err := s.LoadDelegationPolicy(); err == nil && found {\n508\t\t\tif read, readFrom, err := s.RoutingImplementation(plan.Bundle, policy, lead); err == nil {\n509\t\t\t\timpl, from = read, readFrom\n510\t\t\t}\n511\t\t\tif plan.Bundle.Payload.Implementation != nil && policy.Provenance != nil && policy.Provenance.Implementation != (ModelIdentity{}) {\n512\t\t\t\tplan.Warnings = append(plan.Warnings, \"provenance.implementation in the delegation policy is ignored: bundle \"+plan.Bundle.BundleID+\" records the implementation it was sealed by; remove the policy entry\")\n513\t\t\t}\n514\t\t}\n515\t\tplan.implementation = &impl\n516\t\tif plan.Routing == nil {\n517\t\t\trecord := ExplicitDelegationRoute(plan.Adapter, impl, from)\n518\t\t\tplan.Routing = &record\n519\t\t}\n520\t\tif knownIdentityPart(impl.Vendor) && normalizeIdentityPart(plan.Config.Vendor) == impl.Vendor {\n521\t\t\tplan.SameVendorWarning = \"agent \" + plan.Adapter + \" shares the implementation's vendor (\" + impl.Vendor + \"); the run cannot achieve vendor independence\"\n522\t\t}\n523\t}\n524\t\n525\t// PlanReviewDispatch resolves the bundle, brief and adapter without running.\n526\tfunc (s Store) PlanReviewDispatch(target, kind, notes, adapter string, reason ...string) (DispatchPlan, error) {\n527\t\tif err := validateReviewNotes(notes); err != nil {\n528\t\t\treturn DispatchPlan{}, err\n529\t\t}\n530\t\tif len(reason) > 1 {\n531\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: one rerun reason is accepted\")\n532\t\t}\n533\t\twhy := \"\"\n534\t\tif len(reason) == 1 {\n535\t\t\twhy = strings.TrimSpace(reason[0])\n536\t\t}\n537\t\tbrief, err := s.RenderReviewBrief(target, kind, notes)\n538\t\tif err != nil {\n539\t\t\treturn DispatchPlan{}, err\n540\t\t}\n541\t\tbundle, err := s.LoadReviewBundle(brief.BundleID)\n542\t\tif err != nil {\n543\t\t\treturn DispatchPlan{}, err\n544\t\t}\n545\t\tpolicy, found, err := s.LoadReviewersPolicyFor(brief.Kind)\n546\t\tif err != nil {\n547\t\t\treturn DispatchPlan{}, err\n548\t\t}\n549\t\tif !found || len(policy.Adapters) == 0 {\n550\t\t\treturn DispatchPlan{Brief: brief, Bundle: bundle}, ErrNoReviewerAdapter\n551\t\t}\n552\t\tconfig, ok := policy.Adapters[adapter]\n553\t\tif !ok {\n554\t\t\tnames := make([]string, 0, len(policy.Adapters))\n555\t\t\tfor name := range policy.Adapters {\n556\t\t\t\tnames = append(names, name)\n557\t\t\t}\n558\t\t\tsort.Strings(names)\n559\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: no reviewer adapter %q; configured: %s\", adapter, strings.Join(names, \", \"))\n560\t\t}\n561\t\tcommit := bundle.Payload.Subject.Head\n562\t\tif commit == \"\" || RawHistoryGit(s.Root, \"cat-file\", \"-e\", commit+\"^{commit}\").Run() != nil {\n563\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: the bundle's sealed commit %q is not in this repository\", commit)\n564\t\t}\n565\t\torigin, err := dispatchWorktreeIdentity(s.Root)\n566\t\tif err != nil {\n567\t\t\treturn DispatchPlan{}, err\n568\t\t}\n569\t\tplan := DispatchPlan{notes: notes, Reason: why, PolicyDigest: directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")), OriginWorktree: origin, Adapter: adapter, Config: config, Brief: brief, Bundle: bundle, SealedCommit: commit, PriorRuns: 0}\n570\t\truns, losses, err := s.ReadReviewRuns(bundle.BundleID)\n571\t\tif err != nil {\n572\t\t\treturn DispatchPlan{}, err\n573\t\t}\n574\t\tif len(losses) > 0 {\n575\t\t\treturn DispatchPlan{}, fmt.Errorf(\"review history incomplete: %v\", losses)\n576\t\t}\n577\t\tcontinued := map[string]bool{}\n578\t\tfor _, r := range runs {\n579\t\t\tif r.continues() != \"\" {\n580\t\t\t\tcontinued[r.continues()] = true\n581\t\t\t}\n582\t\t}\n583\t\tfor _, prior := range runs {\n584\t\t\tif prior.Status == ReviewRunInterrupted && prior.SupersededBy == \"\" && !continued[prior.RunID] && prior.Interruption != nil && prior.Interruption.Cause == \"usage-limit\" && prior.Adapter != adapter {\n585\t\t\t\tplan.LimitOf, plan.Reason = prior.RunID, \"limit-of:\"+prior.RunID\n586\t\t\t}\n587\t\t}\n588\t\t_, currentCount, err := s.reviewAttemptAdmission(plan)\n589\t\tif err != nil {\n590\t\t\treturn DispatchPlan{}, err\n591\t\t}\n592\t\tif _, _, err := reviewAdapterEnvironment(config, \"\", brief.Text, notes); err != nil {\n593\t\t\treturn DispatchPlan{}, err\n594\t\t}\n595\t\tplan.PriorRuns = currentCount\n596\t\tif brief.Kind == ReviewBriefKindReview {\n597\t\t\tif err := s.planReviewThread(&plan); err != nil {\n598\t\t\t\treturn DispatchPlan{}, err\n599\t\t\t}\n600\t\t}\n601\t\ts.planImplementation(&plan, \"\")\n602\t\tplan.provenance, err = s.prepareRunProvenance(plan, policy)\n603\t\tif err != nil {\n604\t\t\treturn DispatchPlan{}, err\n605\t\t}\n606\t\treturn plan, nil\n607\t}\n608\t\n609\t// ErrNoReviewerAdapter means the project configured no reviewer.\n610\tvar ErrNoReviewerAdapter = errors.New(\"pose: no agent is configured in .pose/policy/delegation.json\")\n611\t\n612\t// RunReviewDispatch executes plan and records the run, failed or completed.\n613\tfunc (s Store) RunReviewDispatch(plan DispatchPlan, now func() time.Time) (ReviewRun, error) {\n614\t\treturn s.RunReviewDispatchContext(context.Background(), plan, now)\n615\t}\n616\t\n617\t// RunReviewDispatchContext also propagates caller cancellation to the covered\n618\t// process set. Cleanup has its own bounded context and never respawns the adapter.\n619\tfunc (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPlan, now func() time.Time) (result ReviewRun, resultErr error) {\n620\t\tif err := parent.Err(); err != nil {\n621\t\t\treturn ReviewRun{}, err\n622\t\t}\n623\t\tif why := routingAgainstAnotherBundle(plan); why != \"\" {\n624\t\t\treturn ReviewRun{}, errors.New(\"pose: \" + why)\n625\t\t}\n626\t\t// pose delegate cancel stops the run through this context (R13).\n627\t\tparent, cancelRun := context.WithCancel(parent)\n628\t\tdefer cancelRun()\n629\t\tvar cancelled *atomic.Bool\n630\t\tif plan.PendingContinuation != nil {\n631\t\t\treturn ReviewRun{}, plan.PendingContinuation\n632\t\t}\n633\t\tif plan.Existing != nil {\n634\t\t\tif plan.predecessor == nil {\n635\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation lacks predecessor\")\n636\t\t\t}\n637\t\t\tfresh, err := s.replanContinuation(plan)\n638\t\t\tif err != nil {\n639\t\t\t\treturn ReviewRun{}, err\n640\t\t\t}\n641\t\t\tif fresh.Existing == nil {\n642\t\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation disappeared\")\n643\t\t\t}\n644\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n645\t\t}\n646\t\tif _, _, err := reviewAdapterEnvironment(plan.Config, \"\", plan.Brief.Text, plan.notes); err != nil {\n647\t\t\treturn ReviewRun{}, err\n648\t\t}\n649\t\trun := ReviewRun{Provenance: plan.provenance, BriefNotes: plan.notes, LimitOf: plan.LimitOf, SchemaVersion: 1, Scope: plan.Brief.Scope, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest,\n650\t\t\tSealedCommit: plan.SealedCommit, Kind: plan.Brief.Kind, BriefDigest: plan.Brief.Digest, Adapter: plan.Adapter,\n651\t\t\tVendor: plan.Config.Vendor, Model: plan.Config.Model, Reason: plan.Reason, PolicyDigest: plan.PolicyDigest, StartedAt: now().UTC().Format(time.RFC3339Nano), ExitCode: -1,\n652\t\t\tLabel: plan.Label, Purpose: plan.Purpose, Lead: plan.Lead, Events: plan.Config.Events, Routing: plan.Routing, Round: plan.round, Thread: plan.thread}\n653\t\timpl := plan.Implementation()\n654\t\trun.IndependenceAchieved = AchievedIndependence(impl.Vendor, impl.Model, plan.Config.Vendor, plan.Config.Model)\n655\t\tsafety, err := ResolveReviewerContainment(plan.Config)\n656\t\tif err != nil {\n657\t\t\treturn ReviewRun{}, err\n658\t\t}\n659\t\tif err := validateReviewNotes(plan.notes); err != nil {\n660\t\t\treturn ReviewRun{}, err\n661\t\t}\n662\t\trun.Safety = safety\n663\t\tvar cleanup func() error\n664\t\t// The runtime directory a continuation took before its claim.\n665\t\tpreparedRuntimeDir := \"\"\n666\t\tvar cleanupErr error\n667\t\tvar terminationFailed bool\n668\t\tcleaned := false\n669\t\tdoCleanup := func() {\n670\t\t\tif cleaned {\n671\t\t\t\treturn\n672\t\t\t}\n673\t\t\tcleaned = true\n674\t\t\toutcome := NewOperationResult(\"review.dispatch.cleanup\", run.Scope)\n675\t\t\toutcome.StepsRun = append(outcome.StepsRun, OperationStep{ID: \"cleanup\", Result: \"done\"})\n676\t\t\tif terminationFailed {\n677\t\t\t\tcleanupErr = fmt.Errorf(\"process termination incomplete; runtime resources retained\")\n678\t\t\t} else if cleanup != nil {\n679\t\t\t\tcleanupErr = cleanup()\n680\t\t\t}\n681\t\t\tif cleanupErr != nil {\n682\t\t\t\toutcome.StepsRun[0].Result = \"failed\"\n683\t\t\t\toutcome.Fail(OutcomeFailed, \"cleanup\", \"cleanup-incomplete\", cleanupErr.Error())\n684\t\t\t\toutcome.Unconfirmed = []OperationUncertain{{Step: \"cleanup\", Reason: \"owned resources may remain; no automatic respawn\"}}\n685\t\t\t} else {\n686\t\t\t\toutcome.Outcome = OutcomeCompleted\n687\t\t\t}\n688\t\t\trun.Safety.Operation = outcome\n689\t\t}\n690\t\tdefer func() {\n691\t\t\tdoCleanup()\n692\t\t\tif cleanupErr != nil {\n693\t\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n694\t\t\t}\n695\t\t}()\n696\t\ttranscript := []byte{}\n697\t\tfinish := func(status, failure string) (ReviewRun, error) {\n698\t\t\tif cleanup == nil && preparedRuntimeDir != \"\" {\n699\t\t\t\t// The continuation took its directory before the claim and fails\n700\t\t\t\t// before it owns its cleanup: nothing is in it yet (review round\n701\t\t\t\t// 1, N1).\n702\t\t\t\t_ = os.Remove(preparedRuntimeDir)\n703\t\t\t}\n704\t\t\tdoCleanup()\n705\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n706\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n707\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n708\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n709\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n710\t\t\t}\n711\t\t\trun.sessionForRedaction = \"\"\n712\t\t\trun.Status, run.Failure = status, failure\n713\t\t\tif status != ReviewRunInterrupted {\n714\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n715\t\t\t}\n716\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n717\t\t\treturn s.recordReviewRun(run, transcript)\n718\t\t}\n719\t\t// Recompute semantic freshness at execution time, not just preview time.\n720\t\tif err := s.checkDispatchOrigin(plan); err != nil {\n721\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n722\t\t}\n723\t\tvar attempt DelegatedReviewAttempt\n724\t\tif plan.predecessor == nil {\n725\t\t\tvar err error\n726\t\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n727\t\t\tif err != nil {\n728\t\t\t\treturn ReviewRun{}, err\n729\t\t\t}\n730\t\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n731\t\t} else {\n732\t\t\t// Re-plan at execution, before the exclusive predecessor claim.\n733\t\t\tfresh, err := s.replanContinuation(plan)\n734\t\t\tif err != nil {\n735\t\t\t\treturn ReviewRun{}, err\n736\t\t\t}\n737\t\t\tif fresh.PendingContinuation != nil {\n738\t\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n739\t\t\t}\n740\t\t\tif fresh.Existing != nil {\n741\t\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n742\t\t\t}\n743\t\t\tplan = fresh\n744\t\t\trun.Provenance = fresh.provenance\n745\t\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n746\t\t\tif fresh.handoff {\n747\t\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n748\t\t\t} else {\n749\t\t\t\trun.Resumes = fresh.predecessor.RunID\n750\t\t\t}\n751\t\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n752\t\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n753\t\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n754\t\t\t// The attempt's runtime directory is taken before the claim, and is\n755\t\t\t// the lock: a resume that cannot take it claims nothing, so the\n756\t\t\t// predecessor stays resumable, and one that lost the race to another\n757\t\t\t// resume is told the continuation is pending (spec\n758\t\t\t// pose-review-resume-runtime-dir-followups R1).\n759\t\t\tdir, err := s.takeContinuationRuntimeDir(parent, plan)\n760\t\t\tvar recorded *continuationRecorded\n761\t\t\tif errors.As(err, &recorded) {\n762\t\t\t\treturn existingReviewDispatchResult(recorded.run)\n763\t\t\t}\n764\t\t\tif err != nil {\n765\t\t\t\treturn ReviewRun{}, err\n766\t\t\t}\n767\t\t\tpreparedRuntimeDir = dir\n768\t\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n769\t\t\t\tif dir != \"\" {\n770\t\t\t\t\t_ = os.Remove(dir)\n771\t\t\t\t}\n772\t\t\t\t// Another resume claimed and may already have ended: its record\n773\t\t\t\t// is the answer, not the publication conflict (R1).\n774\t\t\t\tif again, rerr := s.replanContinuation(plan); rerr == nil {\n775\t\t\t\t\tif again.Existing != nil {\n776\t\t\t\t\t\treturn existingReviewDispatchResult(*again.Existing)\n777\t\t\t\t\t}\n778\t\t\t\t\tif again.PendingContinuation != nil {\n779\t\t\t\t\t\treturn ReviewRun{}, again.PendingContinuation\n780\t\t\t\t\t}\n781\t\t\t\t}\n782\t\t\t\treturn ReviewRun{}, err\n783\t\t\t}\n784\t\t}\n785\t\t// The attempt result is published once: before the active marker goes\n786\t\t// when the run was marked, at return otherwise (spec\n787\t\t// pose-delegation-result-before-marker R1–R2).\n788\t\tresultPublished := false\n789\t\treserved := plan.predecessor != nil\n790\t\tpublishResult := func() {\n791\t\t\tif resultPublished || result.RunID == \"\" || !reserved {\n792\t\t\t\treturn\n793\t\t\t}\n794\t\t\tresultPublished = true\n795\t\t\tbeforeRunResultPublished(result)\n796\t\t\tvar err error\n797\t\t\tif plan.predecessor == nil {\n798\t\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n799\t\t\t} else {\n800\t\t\t\terr = s.finishReviewContinuation(result)\n801\t\t\t}\n802\t\t\tif err != nil {\n803\t\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n804\t\t\t}\n805\t\t}\n806\t\tdefer publishResult()\n807\t\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n808\t\tif err != nil {\n809\t\t\tif plan.predecessor == nil {\n810\t\t\t\t// The attempt is reserved anyway, so the failed run and its\n811\t\t\t\t// receipt are recorded against it, as before the marker moved\n812\t\t\t\t// ahead of the reservation (spec\n813\t\t\t\t// pose-delegation-result-before-marker R1–R2).\n814\t\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n815\t\t\t\t\treturn ReviewRun{}, perr\n816\t\t\t\t}\n817\t\t\t\treserved = true\n818\t\t\t}\n819\t\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n820\t\t}\n821\t\tif plan.predecessor == nil {\n822\t\t\tbeforeAttemptPublished(s, attempt)\n823\t\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n824\t\t\t\tstopActive()\n825\t\t\t\treturn ReviewRun{}, err\n826\t\t\t}\n827\t\t\treserved = true\n828\t\t}\n829\t\t// The marker goes only once the record and the attempt result are\n830\t\t// published: without them it is the one trace of the reserved attempt,\n831\t\t// and a waiter that sees it gone must find the receipt.\n832\t\tdefer func() {\n833\t\t\tpublishResult()\n834\t\t\tstopActive(resultErr != nil || result.Path == \"\")\n835\t\t}()\n836\t\tcancelled = cancelFlag\n837\t\t// A detached run that cannot hand its attempt back stops here: nobody\n838\t\t// would know which attempt runs (R1).\n839\t\tif plan.OnStart != nil {\n840\t\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n841\t\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n842\t\t\t}\n843\t\t}\n844\t\ttmp, err := preparedRuntimeDir, error(nil)\n845\t\tif tmp == \"\" {\n846\t\t\tsource, why := s.runtimeSourceFor(plan, run.AttemptID)\n847\t\t\ttmp, err = reviewRunRuntimeDir(source)\n848\t\t\tif err != nil && errors.Is(err, fs.ErrExist) && source != run.AttemptID && plan.predecessor == nil {\n849\t\t\t\t// The previous round's path was taken after the plan: the round\n850\t\t\t\t// works in its own directory rather than fail with its attempt\n851\t\t\t\t// reserved (R3).\n852\t\t\t\twhy = \"the previous round's checkout path \" + filepath.Join(os.TempDir(), source) + \" was taken after the round was planned\"\n853\t\t\t\ttmp, err = reviewRunRuntimeDir(run.AttemptID)\n854\t\t\t}\n855\t\t\tif why != \"\" && err == nil {\n856\t\t\t\t// The continued session will not find its checkout where it saw\n857\t\t\t\t// it; the run says so (R2, R3).\n858\t\t\t\tsafety.Limitations = append(safety.Limitations, \"the continued session's checkout moved to \"+filepath.Base(tmp)+\": \"+why)\n859\t\t\t}\n860\t\t}\n861\t\tif err != nil {\n862\t\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed: \"+err.Error())\n863\t\t}\n864\t\tsafety.RuntimeID = filepath.Base(tmp)\n865\t\towned, err := os.Lstat(tmp)\n866\t\tif err != nil {\n867\t\t\t// Nothing is in it yet: removing it keeps the attempt's path free\n868\t\t\t// for its next run (review round 1, N4).\n869\t\t\t_ = os.Remove(tmp)\n870\t\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n871\t\t}\n872\t\truntimeRoot, err := os.OpenRoot(tmp)\n873\t\tif err != nil {\n874\t\t\t_ = os.Remove(tmp)\n875\t\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n876\t\t}\n877\t\tdefer runtimeRoot.Close()\n878\t\tvar worktreeOwned os.FileInfo\n879\t\tvar gitMarker []byte\n880\t\tvar ownership *reviewCleanupOwnership\n881\t\tworktree := filepath.Join(tmp, \"worktree\")\n882\t\tcleanup = func() error {\n883\t\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n884\t\t}\n885\t\thooks := filepath.Join(tmp, \"empty-hooks\")\n886\t\tif err := os.Mkdir(hooks, 0700); err != nil {\n887\t\t\treturn finish(ReviewRunFailed, \"private hook directory setup failed\")\n888\t\t}\n889\t\tsetupCtx, stopSetup := context.WithTimeout(parent, 2*time.Minute)\n890\t\tdefer stopSetup()\n891\t\tsetup := reviewSetupCommand(setupCtx, gitCommand(\"-C\", s.Root, \"-c\", \"core.hooksPath=\"+hooks, \"worktree\", \"add\", \"--detach\", worktree, plan.SealedCommit))\n892\t\tsetupOutput := &reviewBoundedCapture{limit: 64 << 10, cancel: stopSetup}\n893\t\tsetup.Stdout, setup.Stderr = setupOutput, setupOutput\n894\t\tsetupErr := setup.Run()\n895\t\t_, setupOverflow := setupOutput.result()\n896\t\tterminationErr := killProcessGroup(setup)\n897\t\tif terminationErr != nil {\n898\t\t\tterminationFailed = true\n899\t\t}\n900\t\tsetupCause := executionCause(setupCtx)\n901\t\tif setupErr != nil || terminationErr != nil || setupOverflow {\n902\t\t\tsafety.ExecutionCause = setupCause\n903\t\t\tif setupOverflow {\n904\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n905\t\t\t}\n906\t\t\treturn finish(ReviewRunFailed, \"review worktree setup failed or termination incomplete\")\n907\t\t}\n908\t\n909\t\tworktreeOwned, err = os.Lstat(worktree)\n910\t\tif err != nil {\n911\t\t\treturn finish(ReviewRunFailed, \"worktree identity unavailable\")\n912\t\t}\n913\t\tgitMarker, err = ReadReviewAdapterFile(filepath.Join(worktree, \".git\"), 4096)\n914\t\tif err != nil {\n915\t\t\treturn finish(ReviewRunFailed, \"worktree marker unavailable\")\n916\t\t}\n917\t\townership, err = s.captureReviewCleanupOwnership(runtimeRoot, worktree, gitMarker)\n918\t\tif err != nil {\n919\t\t\treturn finish(ReviewRunFailed, \"worktree registration ownership unavailable\")\n920\t\t}\n921\t\tdefer ownership.registry.Close()\n922\t\n923\t\tsubmodules := map[string]bool{}\n924\t\tfor _, entry := range plan.Bundle.Payload.Subject.Entries {\n925\t\t\tif entry.Class == \"submodule\" {\n926\t\t\t\tsubmodules[reviewBundleEntryPath(entry)] = true\n927\t\t\t}\n928\t\t}\n929\t\tcommittedWorktreeBytes := ownership.inventoryBytes - gitSnapshotMarginBytes\n930\t\tgitlinks := reviewGitlinkSetup{\n931\t\t\tctx: setupCtx, cancel: stopSetup, hooks: hooks,\n932\t\t\tmetadata:          filepath.Join(tmp, reviewGitlinkMetadataDir),\n933\t\t\tmaxCommittedBytes: gitSnapshotCeilingBytes - committedWorktreeBytes,\n934\t\t}\n935\t\tgitlinkErr := gitlinks.materialize(s.Root, worktree, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries)\n936\t\townership.inventoryBytes = gitSnapshotBudget(committedWorktreeBytes + gitlinks.committedBytes)\n937\t\townership.gitlinkMetadata = gitlinks.metadataOwned\n938\t\townership.gitlinkMetadataBytes = gitSnapshotBudget(gitlinks.committedBytes)\n939\t\tif gitlinkErr != nil {\n940\t\t\tterminationFailed = gitlinks.terminationFailure\n941\t\t\tsafety.ExecutionCause = executionCause(setupCtx)\n942\t\t\tif gitlinks.captureOverflow {\n943\t\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n944\t\t\t}\n945\t\t\treturn finish(ReviewRunFailed, \"sealed gitlink setup failed: \"+gitlinkErr.Error())\n946\t\t}\n947\t\tstopSetup()\n948\t\tcheckout := s\n949\t\tcheckout.Root, checkout.indexPin = worktree, nil\n950\t\tif prepared, err := checkout.PrepareReviewBundle(plan.Brief.Scope); err != nil {\n951\t\t\treturn finish(ReviewRunFailed, \"sealed checkout inputs unavailable: \"+err.Error())\n952\t\t} else if blockers := checkoutBlockers(prepared.Blockers); len(blockers) > 0 {\n953\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout blocked: %v\", blockers))\n954\t\t} else if differing := sealedInputsThatDiffer(plan.Bundle, prepared, worktree); len(differing) > 0 {\n955\t\t\treturn finish(ReviewRunFailed, fmt.Sprintf(\"sealed checkout inputs differ: %v\", differing))\n956\t\t}\n957\t\tif err := verifyDispatchWorktreeFor(worktree, plan.SealedCommit, submodules); err != nil {\n958\t\t\treturn finish(ReviewRunFailed, err.Error())\n959\t\t}\n960\t\tif err := verifyBundleMaterialization(worktree, plan.Bundle); err != nil {\n961\t\t\treturn finish(ReviewRunFailed, err.Error())\n962\t\t}\n963\t\tif plan.Purpose == DelegationPurposeReview && plan.Config.Events == DelegationEventsClaudeStreamJSON {\n964\t\t\tpolicy, _, found, err := s.LoadDelegationPolicy()\n965\t\t\tif err != nil {\n966\t\t\t\treturn finish(ReviewRunFailed, \"review staging policy unavailable\")\n967\t\t\t}\n968\t\t\tif found && policy.Agents[plan.Adapter].ReviewProfile != nil {\n969\t\t\t\tif err := prepareClaudeReviewStaging(runtimeRoot, plan.Bundle.Payload.Plan.Components); err != nil {\n970\t\t\t\t\treturn finish(ReviewRunFailed, \"review staging directories unavailable\")\n971\t\t\t\t}\n972\t\t\t}\n973\t\t}\n974\t\tdiskBefore, err := dispatchDiskSnapshot(worktree, gitlinks.committedBytes)\n975\t\tif err != nil {\n976\t\t\treturn finish(ReviewRunFailed, err.Error())\n977\t\t}\n978\t\n979\t\trawTree, err := json.Marshal(diskBefore)\n980\t\tif err != nil {\n981\t\t\treturn finish(ReviewRunFailed, err.Error())\n982\t\t}\n983\t\tif plan.predecessor != nil && (!plan.handoff || plan.predecessor.TreeDigest != \"\") && digestBytes(rawTree) != plan.predecessor.TreeDigest {\n984\t\t\treturn finish(ReviewRunFailed, \"recreated worktree tree digest differs\")\n985\t\t}\n986\t\trun.TreeDigest = digestBytes(rawTree)\n987\t\toutputFile := filepath.Join(tmp, \"output.txt\")\n988\t\tcommand := plan.Config.Command\n989\t\tif plan.predecessor != nil && !plan.handoff || plan.thread.continued() {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"b924fdab-b99c-4f31-b6ce-4f8a9b75c0ac","timestamp":"2026-11-27T23:07:50.322Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-668ca2f6e0/worktree/pose-mcp/internal/pose/review_dispatch.go","content":"\tThread        *ReviewThread `json:\"thread,omitempty\"`\n\tPath          string        `json:\"-\"`\n\t// eventsDir is where a task run's files are; a review run's are in\n\t// reviewRunsDir.\n\teventsDir string\n}\n\n// Review run states.\nconst (\n\tReviewRunCompleted   = \"completed\"\n\tReviewRunFailed      = \"failed\"\n\tReviewRunInterrupted = \"interrupted\"\n\tReviewRunStale       = \"stale\"\n)\n\n// ListReviewRuns returns the recorded runs for bundleID (\"\" for all).\nfunc (s Store) ListReviewRuns(bundleID string) ([]ReviewRun, error) {\n\truns, _, err := s.ReadReviewRuns(bundleID)\n\treturn runs, err\n}\n\nfunc (s Store) ReadReviewRuns(bundleID string) ([]ReviewRun, []string, error) {\n\t// Within a read-view operation the ledger is read and checked once per\n\t// root; every request of the operation is answered from that read,\n\t// filtered by bundle as below (spec pose-review-ledger-is-read-once-per-operation).\n\tall, _, err := memoizedLedgerRead(s.fsys(), \"review-runs\\x00\"+filepath.Clean(s.Root), func() (reviewRunsRead, error) {\n\t\truns, lost, err := s.readAllReviewRuns()\n\t\treturn reviewRunsRead{runs: runs, lost: lost}, err\n\t})\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tout := copyReviewRuns(all.runs)\n\tif bundleID != \"\" {\n\t\tfiltered := []ReviewRun{}\n\t\tfor _, run := range out {\n\t\t\tif run.BundleID == bundleID {\n\t\t\t\tfiltered = append(filtered, run)\n\t\t\t}\n\t\t}\n\t\tout = filtered\n\t}\n\treturn out, deepCopyValue(all.lost), nil\n}\n\n// readAllReviewRuns reads, checks and orders every review run of the store.\nfunc (s Store) readAllReviewRuns() ([]ReviewRun, []string, error) {\n\tfiles := s.fsys()\n\tdir := filepath.Join(s.Root, filepath.FromSlash(reviewRunsDir))\n\t// The storage is read where the writer writes it: a link in its place is another place.\n\tif info, lerr := files.Lstat(dir); lerr == nil {\n\t\tif info.Mode()&os.ModeSymlink != 0 {\n\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link, not the directory the runs are written to\")\n\t\t}\n\t} else if !errors.Is(lerr, os.ErrNotExist) {\n\t\treturn nil, nil, lerr\n\t}\n\tentries, err := ledgerEntriesIn(files, s.Root, reviewRunsDir)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\tif _, lerr := files.Lstat(dir); lerr == nil {\n\t\t\treturn nil, nil, fmt.Errorf(\"pose: the review runs directory is a link whose target cannot be read\")\n\t\t} else if !errors.Is(lerr, os.ErrNotExist) {\n\t\t\treturn nil, nil, lerr\n\t\t}\n\t\treturn []ReviewRun{}, nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tout := []ReviewRun{}\n\tvar lost []string\n\treadBudget := int64(32 << 20)\n\tfor _, e := range entries {\n\t\tif !strings.HasSuffix(e.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(dir, e.Name())\n\t\tinfo, infoErr := files.Lstat(full)\n\t\tif infoErr != nil || !info.Mode().IsRegular() {\n\t\t\tlost = append(lost, e.Name()+\" (not a regular file)\")\n\t\t\tcontinue\n\t\t}\n\t\tif info.Size() < 0 || info.Size() > reviewLedgerMaxBytes {\n\t\t\tlost = append(lost, e.Name()+\" (record exceeds bound or is unreadable)\")\n\t\t\tcontinue\n\t\t}\n\t\traw, err := readLedgerRawBudgetIn(files, full, &readBudget)\n\t\tif err != nil {\n\t\t\tlost = append(lost, e.Name()+\" (\"+err.Error()+\")\")\n\t\t\tif errors.Is(err, errReviewLedgerBudget) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tvar run ReviewRun\n\t\tif json.Unmarshal(raw, &run) != nil || run.RunID == \"\" {\n\t\t\tlost = append(lost, e.Name()+\" (not a review run)\")\n\t\t\tcontinue\n\t\t}\n\t\tif verr := validateReviewRunRecord(e.Name(), run); verr != nil {\n\t\t\tlost = append(lost, e.Name()+\" (\"+verr.Error()+\")\")\n\t\t\tcontinue\n\t\t}\n\t\trun.Path = filepath.ToSlash(filepath.Join(reviewRunsDir, e.Name()))\n\t\tout = append(out, run)\n\t}\n\tsort.Slice(out, func(i, j int) bool {\n\t\ta, _ := time.Parse(time.RFC3339Nano, out[i].StartedAt)\n\t\tb, _ := time.Parse(time.RFC3339Nano, out[j].StartedAt)\n\t\tif !a.Equal(b) {\n\t\t\treturn a.Before(b)\n\t\t}\n\t\treturn out[i].RunID < out[j].RunID\n\t})\n\tsuperseded := map[string]string{}\n\tfor _, run := range out {\n\t\tif run.Supersedes != \"\" {\n\t\t\tsuperseded[run.Supersedes] = run.RunID\n\t\t}\n\t}\n\tfor i := range out {\n\t\tout[i].SupersededBy = superseded[out[i].RunID]\n\t}\n\tchecked := map[string][]DelegatedReviewAttempt{}\n\tfor _, run := range out {\n\t\tif run.LedgerVersion == 1 {\n\t\t\tif _, err := files.Lstat(filepath.Join(s.Root, reviewRunLedgerDir, run.RunID+\".json\")); err != nil {\n\t\t\t\tlost = append(lost, \"missing run witness \"+run.RunID)\n\t\t\t}\n\t\t}\n\t\tif run.AttemptID != \"\" {\n\t\t\tattempts, ok := checked[run.BundleID]\n\t\t\tif !ok {\n\t\t\t\tvar aerr error\n\t\t\t\tattempts, aerr = s.readDelegatedReviewAttempts(run.BundleID, &readBudget)\n\t\t\t\tif aerr != nil {\n\t\t\t\t\tlost = append(lost, aerr.Error())\n\t\t\t\t}\n\t\t\t\tchecked[run.BundleID] = attempts\n\t\t\t}\n\t\t\t// The reservation names the attempt's first agent; a continuation's\n\t\t\t// agent is checked against its own predecessor by the continuation\n\t\t\t// chain (a resume keeps it, a handoff changes it).\n\t\t\tfound := false\n\t\t\tfor _, a := range attempts {\n\t\t\t\tif a.AttemptID == run.AttemptID && a.BundleDigest == run.BundleDigest && a.Scope == run.Scope && (a.Adapter == run.Adapter || run.continues() != \"\") && a.Reason == run.Reason {\n\t\t\t\t\tfound = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !found {\n\t\t\t\tlost = append(lost, \"missing or conflicting attempt reservation \"+run.AttemptID)\n\t\t\t}\n\t\t}\n\t}\n\tfindings, ledgerErr := s.reviewRunLedgerFindings(\"\", &readBudget)\n\tif ledgerErr != nil {\n\t\tlost = append(lost, ledgerErr.Error())\n\t}\n\tlost = append(lost, findings...)\n\tlost = append(lost, s.reviewContinuationFindings(out)...)\n\treturn out, uniqueSorted(lost), nil\n}\n\n// DispatchPlan is what a dispatch will do.\ntype DispatchPlan struct {\n\tprovenance          *ReviewRunProvenance\n\tPendingContinuation *PendingReviewContinuation\n\tprocessTimeout      time.Duration\n\tpredecessor         *ReviewRun\n\t// handoff makes the continuation another agent's, with handoffSection\n\t// appended to the brief (spec pose-delegation-handoff).\n\thandoff        bool\n\thandoffSection string\n\tsession        string\n\t// round is the round of the scope the run reviews, and thread how a\n\t// round after the first relates to the previous round's session.\n\tround  int\n\tthread *ReviewThread\n\t// extraChannels are outputs the interruption classifier reads beside the\n\t// transcript and the output, each on its own: a task's stderr.\n\textraChannels  []string\n\tnotes          string\n\tExisting       *ReviewRun\n\tLimitOf        string\n\tReason         string\n\tPolicyDigest   string\n\tOriginWorktree string\n\tAdapter        string\n\tConfig         ReviewerAdapter\n\tBrief          ReviewBrief\n\tBundle         ReviewBundle\n\tSealedCommit   string\n\tPriorRuns      int\n\t// Effort is the requested effort level; \"\" means the agent's default.\n\tEffort string\n\t// Label, Purpose and Lead are recorded on the run (pose delegate).\n\tLabel   string\n\tPurpose string\n\tLead    string\n\t// Routing is set by pose delegate; without it the run is compared with\n\t// the implementation the plan read (spec pose-delegation-routing R8).\n\tRouting        *DelegationRoutingRecord\n\timplementation *ReviewBundleImplementation\n\t// Warnings are printed before the run starts. SameVendorWarning is set\n\t// when the plan's agent shares the implementation's vendor; a caller that\n\t// named the agent prints it, routing does not (R9).\n\tWarnings          []string\n\tSameVendorWarning string\n\t// OnStart is called once the attempt is reserved and its marker written,\n\t// so a detached run can hand its reference back (spec\n\t// pose-delegated-review-completion-signal R1).\n\tOnStart func(attempt string) error\n}\n\n// Implementation is the identity the plan compares its agent with.\nfunc (p DispatchPlan) Implementation() ReviewBundleImplementation {\n\tswitch {\n\tcase p.Routing != nil:\n\t\treturn p.Routing.Implementation\n\tcase p.implementation != nil:\n\t\treturn *p.implementation\n\t}\n\treturn ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n}\n\n// replanContinuation plans a continuation again at execution, as a resume or\n// as a handoff to the same agent.\nfunc (s Store) replanContinuation(plan DispatchPlan) (DispatchPlan, error) {\n\tvar fresh DispatchPlan\n\tvar err error\n\tif plan.handoff {\n\t\tfresh, err = s.PlanReviewHandoff(plan.predecessor.RunID, plan.Adapter)\n\t} else {\n\t\tfresh, err = s.PlanReviewResume(plan.predecessor.RunID)\n\t}\n\tif err != nil {\n\t\treturn fresh, err\n\t}\n\t// What the caller set on the plan is kept: the hand-back of a detached run\n\t// and the routing that chose its agent (spec pose-delegation-mcp R4).\n\tfresh.OnStart, fresh.Purpose = plan.OnStart, plan.Purpose\n\tif fresh.Routing == nil {\n\t\tfresh.Routing = plan.Routing\n\t}\n\treturn fresh, nil\n}\n\n// PlanImplementationWithLead reads the plan's implementation again with the\n// --lead the caller declared, for a bundle that records none (R4), and records\n// the agent as named.\nfunc (s Store) PlanImplementationWithLead(plan *DispatchPlan, lead string) {\n\tplan.Routing, plan.Warnings, plan.SameVendorWarning = nil, nil, \"\"\n\ts.planImplementation(plan, lead)\n}\n\n// routingAgainstAnotherBundle refuses a routing decision made against an\n// implementation the plan's bundle does not record: the run would record an\n// identity and an independence it did not have (spec pose-delegation-routing\n// R8).\nfunc routingAgainstAnotherBundle(plan DispatchPlan) string {\n\tif plan.Routing == nil || plan.Routing.ImplementationFrom != ImplementationFromBundle {\n\t\treturn \"\"\n\t}\n\tsealed := plan.Bundle.Payload.Implementation\n\tif sealed == nil || !sameImplementation(*sealed, plan.Routing.Implementation) {\n\t\treturn \"the run was routed against another implementation than bundle \" + plan.Bundle.BundleID + \" records; route it again\"\n\t}\n\treturn \"\"\n}\n\n// planImplementation reads the identity a run of bundle is compared with,\n// records the agent as named unless routing chose it (R8, R9), and warns when\n// the policy still declares an identity the bundle overrides (R4).\nfunc (s Store) planImplementation(plan *DispatchPlan, lead string) {\n\timpl := ReviewBundleImplementation{Vendor: ImplementationUnknown, Model: ImplementationUnknown, Source: ImplementationDetected}\n\tfrom := ImplementationFromNone\n\tif policy, _, found, err := s.LoadDelegationPolicy(); err == nil && found {\n\t\tif read, readFrom, err := s.RoutingImplementation(plan.Bundle, policy, lead); err == nil {\n\t\t\timpl, from = read, readFrom\n\t\t}\n\t\tif plan.Bundle.Payload.Implementation != nil && policy.Provenance != nil && policy.Provenance.Implementation != (ModelIdentity{}) {\n\t\t\tplan.Warnings = append(plan.Warnings, \"provenance.implementation in the delegation policy is ignored: bundle \"+plan.Bundle.BundleID+\" records the implementation it was sealed by; remove the policy entry\")\n\t\t}\n\t}\n\tplan.implementation = &impl\n\tif plan.Routing == nil {\n\t\trecord := ExplicitDelegationRoute(plan.Adapter, impl, from)\n\t\tplan.Routing = &record\n\t}\n\tif knownIdentityPart(impl.Vendor) && normalizeIdentityPart(plan.Config.Vendor) == impl.Vendor {\n\t\tplan.SameVendorWarning = \"agent \" + plan.Adapter + \" shares the implementation's vendor (\" + impl.Vendor + \"); the run cannot achieve vendor independence\"\n\t}\n}\n\n// PlanReviewDispatch resolves the bundle, brief and adapter without running.\nfunc (s Store) PlanReviewDispatch(target, kind, notes, adapter string, reason ...string) (DispatchPlan, error) {\n\tif err := validateReviewNotes(notes); err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tif len(reason) > 1 {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: one rerun reason is accepted\")\n\t}\n\twhy := \"\"\n\tif len(reason) == 1 {\n\t\twhy = strings.TrimSpace(reason[0])\n\t}\n\tbrief, err := s.RenderReviewBrief(target, kind, notes)\n\tif err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tbundle, err := s.LoadReviewBundle(brief.BundleID)\n\tif err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tpolicy, found, err := s.LoadReviewersPolicyFor(brief.Kind)\n\tif err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tif !found || len(policy.Adapters) == 0 {\n\t\treturn DispatchPlan{Brief: brief, Bundle: bundle}, ErrNoReviewerAdapter\n\t}\n\tconfig, ok := policy.Adapters[adapter]\n\tif !ok {\n\t\tnames := make([]string, 0, len(policy.Adapters))\n\t\tfor name := range policy.Adapters {\n\t\t\tnames = append(names, name)\n\t\t}\n\t\tsort.Strings(names)\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: no reviewer adapter %q; configured: %s\", adapter, strings.Join(names, \", \"))\n\t}\n\tcommit := bundle.Payload.Subject.Head\n\tif commit == \"\" || RawHistoryGit(s.Root, \"cat-file\", \"-e\", commit+\"^{commit}\").Run() != nil {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: the bundle's sealed commit %q is not in this repository\", commit)\n\t}\n\torigin, err := dispatchWorktreeIdentity(s.Root)\n\tif err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tplan := DispatchPlan{notes: notes, Reason: why, PolicyDigest: directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")), OriginWorktree: origin, Adapter: adapter, Config: config, Brief: brief, Bundle: bundle, SealedCommit: commit, PriorRuns: 0}\n\truns, losses, err := s.ReadReviewRuns(bundle.BundleID)\n\tif err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tif len(losses) > 0 {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"review history incomplete: %v\", losses)\n\t}\n\tcontinued := map[string]bool{}\n\tfor _, r := range runs {\n\t\tif r.continues() != \"\" {\n\t\t\tcontinued[r.continues()] = true\n\t\t}\n\t}\n\tfor _, prior := range runs {\n\t\tif prior.Status == ReviewRunInterrupted && prior.SupersededBy == \"\" && !continued[prior.RunID] && prior.Interruption != nil && prior.Interruption.Cause == \"usage-limit\" && prior.Adapter != adapter {\n\t\t\tplan.LimitOf, plan.Reason = prior.RunID, \"limit-of:\"+prior.RunID\n\t\t}\n\t}\n\t_, currentCount, err := s.reviewAttemptAdmission(plan)\n\tif err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tif _, _, err := reviewAdapterEnvironment(config, \"\", brief.Text, notes); err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\tplan.PriorRuns = currentCount\n\tif brief.Kind == ReviewBriefKindReview {\n\t\tif err := s.planReviewThread(&plan); err != nil {\n\t\t\treturn DispatchPlan{}, err\n\t\t}\n\t}\n\ts.planImplementation(&plan, \"\")\n\tplan.provenance, err = s.prepareRunProvenance(plan, policy)\n\tif err != nil {\n\t\treturn DispatchPlan{}, err\n\t}\n\treturn plan, nil\n}\n\n// ErrNoReviewerAdapter means the project configured no reviewer.\nvar ErrNoReviewerAdapter = errors.New(\"pose: no agent is configured in .pose/policy/delegation.json\")\n\n// RunReviewDispatch executes plan and records the run, failed or completed.\nfunc (s Store) RunReviewDispatch(plan DispatchPlan, now func() time.Time) (ReviewRun, error) {\n\treturn s.RunReviewDispatchContext(context.Background(), plan, now)\n}\n\n// RunReviewDispatchContext also propagates caller cancellation to the covered\n// process set. Cleanup has its own bounded context and never respawns the adapter.\nfunc (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPlan, now func() time.Time) (result ReviewRun, resultErr error) {\n\tif err := parent.Err(); err != nil {\n\t\treturn ReviewRun{}, err\n\t}\n\tif why := routingAgainstAnotherBundle(plan); why != \"\" {\n\t\treturn ReviewRun{}, errors.New(\"pose: \" + why)\n\t}\n\t// pose delegate cancel stops the run through this context (R13).\n\tparent, cancelRun := context.WithCancel(parent)\n\tdefer cancelRun()\n\tvar cancelled *atomic.Bool\n\tif plan.PendingContinuation != nil {\n\t\treturn ReviewRun{}, plan.PendingContinuation\n\t}\n\tif plan.Existing != nil {\n\t\tif plan.predecessor == nil {\n\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation lacks predecessor\")\n\t\t}\n\t\tfresh, err := s.replanContinuation(plan)\n\t\tif err != nil {\n\t\t\treturn ReviewRun{}, err\n\t\t}\n\t\tif fresh.Existing == nil {\n\t\t\treturn ReviewRun{}, fmt.Errorf(\"existing continuation disappeared\")\n\t\t}\n\t\treturn existingReviewDispatchResult(*fresh.Existing)\n\t}\n\tif _, _, err := reviewAdapterEnvironment(plan.Config, \"\", plan.Brief.Text, plan.notes); err != nil {\n\t\treturn ReviewRun{}, err\n\t}\n\trun := ReviewRun{Provenance: plan.provenance, BriefNotes: plan.notes, LimitOf: plan.LimitOf, SchemaVersion: 1, Scope: plan.Brief.Scope, BundleID: plan.Bundle.BundleID, BundleDigest: plan.Bundle.BundleDigest,\n\t\tSealedCommit: plan.SealedCommit, Kind: plan.Brief.Kind, BriefDigest: plan.Brief.Digest, Adapter: plan.Adapter,\n\t\tVendor: plan.Config.Vendor, Model: plan.Config.Model, Reason: plan.Reason, PolicyDigest: plan.PolicyDigest, StartedAt: now().UTC().Format(time.RFC3339Nano), ExitCode: -1,\n\t\tLabel: plan.Label, Purpose: plan.Purpose, Lead: plan.Lead, Events: plan.Config.Events, Routing: plan.Routing, Round: plan.round, Thread: plan.thread}\n\timpl := plan.Implementation()\n\trun.IndependenceAchieved = AchievedIndependence(impl.Vendor, impl.Model, plan.Config.Vendor, plan.Config.Model)\n\tsafety, err := ResolveReviewerContainment(plan.Config)\n\tif err != nil {\n\t\treturn ReviewRun{}, err\n\t}\n\tif err := validateReviewNotes(plan.notes); err != nil {\n\t\treturn ReviewRun{}, err\n\t}\n\trun.Safety = safety\n\tvar cleanup func() error\n\t// The runtime directory a continuation took before its claim.\n\tpreparedRuntimeDir := \"\"\n\tvar cleanupErr error\n\tvar terminationFailed bool\n\tcleaned := false\n\tdoCleanup := func() {\n\t\tif cleaned {\n\t\t\treturn\n\t\t}\n\t\tcleaned = true\n\t\toutcome := NewOperationResult(\"review.dispatch.cleanup\", run.Scope)\n\t\toutcome.StepsRun = append(outcome.StepsRun, OperationStep{ID: \"cleanup\", Result: \"done\"})\n\t\tif terminationFailed {\n\t\t\tcleanupErr = fmt.Errorf(\"process termination incomplete; runtime resources retained\")\n\t\t} else if cleanup != nil {\n\t\t\tcleanupErr = cleanup()\n\t\t}\n\t\tif cleanupErr != nil {\n\t\t\toutcome.StepsRun[0].Result = \"failed\"\n\t\t\toutcome.Fail(OutcomeFailed, \"cleanup\", \"cleanup-incomplete\", cleanupErr.Error())\n\t\t\toutcome.Unconfirmed = []OperationUncertain{{Step: \"cleanup\", Reason: \"owned resources may remain; no automatic respawn\"}}\n\t\t} else {\n\t\t\toutcome.Outcome = OutcomeCompleted\n\t\t}\n\t\trun.Safety.Operation = outcome\n\t}\n\tdefer func() {\n\t\tdoCleanup()\n\t\tif cleanupErr != nil {\n\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n\t\t}\n\t}()\n\ttranscript := []byte{}\n\tfinish := func(status, failure string) (ReviewRun, error) {\n\t\tif cleanup == nil && preparedRuntimeDir != \"\" {\n\t\t\t// The continuation took its directory before the claim and fails\n\t\t\t// before it owns its cleanup: nothing is in it yet (review round\n\t\t\t// 1, N1).\n\t\t\t_ = os.Remove(preparedRuntimeDir)\n\t\t}\n\t\tdoCleanup()\n\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n\t\t}\n\t\trun.sessionForRedaction = \"\"\n\t\trun.Status, run.Failure = status, failure\n\t\tif status != ReviewRunInterrupted {\n\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n\t\t}\n\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n\t\treturn s.recordReviewRun(run, transcript)\n\t}\n\t// Recompute semantic freshness at execution time, not just preview time.\n\tif err := s.checkDispatchOrigin(plan); err != nil {\n\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n\t}\n\tvar attempt DelegatedReviewAttempt\n\tif plan.predecessor == nil {\n\t\tvar err error\n\t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n\t\tif err != nil {\n\t\t\treturn ReviewRun{}, err\n\t\t}\n\t\trun.AttemptID, run.Reason = attempt.AttemptID, attempt.Reason\n\t} else {\n\t\t// Re-plan at execution, before the exclusive predecessor claim.\n\t\tfresh, err := s.replanContinuation(plan)\n\t\tif err != nil {\n\t\t\treturn ReviewRun{}, err\n\t\t}\n\t\tif fresh.PendingContinuation != nil {\n\t\t\treturn ReviewRun{}, fresh.PendingContinuation\n\t\t}\n\t\tif fresh.Existing != nil {\n\t\t\treturn existingReviewDispatchResult(*fresh.Existing)\n\t\t}\n\t\tplan = fresh\n\t\trun.Provenance = fresh.provenance\n\t\trun.AttemptID, run.Reason = fresh.predecessor.AttemptID, fresh.predecessor.Reason\n\t\tif fresh.handoff {\n\t\t\trun.HandsOffFrom, run.HandoffDigest, run.HandoffRenderer = fresh.predecessor.RunID, digestBytes([]byte(fresh.handoffSection)), handoffRenderer\n\t\t} else {\n\t\t\trun.Resumes = fresh.predecessor.RunID\n\t\t}\n\t\trun.TreeDigest = fresh.predecessor.TreeDigest\n\t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n\t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n\t\t// The attempt's runtime directory is taken before the claim, and is\n\t\t// the lock: a resume that cannot take it claims nothing, so the\n\t\t// predecessor stays resumable, and one that lost the race to another\n\t\t// resume is told the continuation is pending (spec\n\t\t// pose-review-resume-runtime-dir-followups R1).\n\t\tdir, err := s.takeContinuationRuntimeDir(parent, plan)\n\t\tvar recorded *continuationRecorded\n\t\tif errors.As(err, &recorded) {\n\t\t\treturn existingReviewDispatchResult(recorded.run)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn ReviewRun{}, err\n\t\t}\n\t\tpreparedRuntimeDir = dir\n\t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n\t\t\tif dir != \"\" {\n\t\t\t\t_ = os.Remove(dir)\n\t\t\t}\n\t\t\t// Another resume claimed and may already have ended: its record\n\t\t\t// is the answer, not the publication conflict (R1).\n\t\t\tif again, rerr := s.replanContinuation(plan); rerr == nil {\n\t\t\t\tif again.Existing != nil {\n\t\t\t\t\treturn existingReviewDispatchResult(*again.Existing)\n\t\t\t\t}\n\t\t\t\tif again.PendingContinuation != nil {\n\t\t\t\t\treturn ReviewRun{}, again.PendingContinuation\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn ReviewRun{}, err\n\t\t}\n\t}\n\t// The attempt result is published once: before the active marker goes\n\t// when the run was marked, at return otherwise (spec\n\t// pose-delegation-result-before-marker R1–R2).\n\tresultPublished := false\n\treserved := plan.predecessor != nil\n\tpublishResult := func() {\n\t\tif resultPublished || result.RunID == \"\" || !reserved {\n\t\t\treturn\n\t\t}\n\t\tresultPublished = true\n\t\tbeforeRunResultPublished(result)\n\t\tvar err error\n\t\tif plan.predecessor == nil {\n\t\t\terr = s.finishDelegatedReviewAttempt(attempt, result)\n\t\t} else {\n\t\t\terr = s.finishReviewContinuation(result)\n\t\t}\n\t\tif err != nil {\n\t\t\tresultErr = errors.Join(resultErr, fmt.Errorf(\"attempt result not confirmed: %w\", err))\n\t\t}\n\t}\n\tdefer publishResult()\n\tstopActive, cancelFlag, err := s.markDelegationActive(run, cancelRun)\n\tif err != nil {\n\t\tif plan.predecessor == nil {\n\t\t\t// The attempt is reserved anyway, so the failed run and its\n\t\t\t// receipt are recorded against it, as before the marker moved\n\t\t\t// ahead of the reservation (spec\n\t\t\t// pose-delegation-result-before-marker R1–R2).\n\t\t\tif perr := s.publishDelegatedReviewAttempt(attempt); perr != nil {\n\t\t\t\treturn ReviewRun{}, perr\n\t\t\t}\n\t\t\treserved = true\n\t\t}\n\t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n\t}\n\tif plan.predecessor == nil {\n\t\tbeforeAttemptPublished(s, attempt)\n\t\tif err := s.publishDelegatedReviewAttempt(attempt); err != nil {\n\t\t\tstopActive()\n\t\t\treturn ReviewRun{}, err\n\t\t}\n\t\treserved = true\n\t}\n\t// The marker goes only once the record and the attempt result are\n\t// published: without them it is the one trace of the reserved attempt,\n\t// and a waiter that sees it gone must find the receipt.\n\tdefer func() {\n\t\tpublishResult()\n\t\tstopActive(resultErr != nil || result.Path == \"\")\n\t}()\n\tcancelled = cancelFlag\n\t// A detached run that cannot hand its attempt back stops here: nobody\n\t// would know which attempt runs (R1).\n\tif plan.OnStart != nil {\n\t\tif err := plan.OnStart(run.AttemptID); err != nil {\n\t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n\t\t}\n\t}\n\ttmp, err := preparedRuntimeDir, error(nil)\n\tif tmp == \"\" {\n\t\tsource, why := s.runtimeSourceFor(plan, run.AttemptID)\n\t\ttmp, err = reviewRunRuntimeDir(source)\n\t\tif err != nil && errors.Is(err, fs.ErrExist) && source != run.AttemptID && plan.predecessor == nil {\n\t\t\t// The previous round's path was taken after the plan: the round\n\t\t\t// works in its own directory rather than fail with its attempt\n\t\t\t// reserved (R3).\n\t\t\twhy = \"the previous round's checkout path \" + filepath.Join(os.TempDir(), source) + \" was taken after the round was planned\"\n\t\t\ttmp, err = reviewRunRuntimeDir(run.AttemptID)\n\t\t}\n\t\tif why != \"\" && err == nil {\n\t\t\t// The continued session will not find its checkout where it saw\n\t\t\t// it; the run says so (R2, R3).\n\t\t\tsafety.Limitations = append(safety.Limitations, \"the continued session's checkout moved to \"+filepath.Base(tmp)+\": \"+why)\n\t\t}\n\t}\n\tif err != nil {\n\t\treturn finish(ReviewRunFailed, \"runtime directory setup failed: \"+err.Error())\n\t}\n\tsafety.RuntimeID = filepath.Base(tmp)\n\towned, err := os.Lstat(tmp)\n\tif err != nil {\n\t\t// Nothing is in it yet: removing it keeps the attempt's path free\n\t\t// for its next run (review round 1, N4).\n\t\t_ = os.Remove(tmp)\n\t\treturn finish(ReviewRunFailed, \"runtime directory identity unavailable\")\n\t}\n\truntimeRoot, err := os.OpenRoot(tmp)\n\tif err != nil {\n\t\t_ = os.Remove(tmp)\n\t\treturn finish(ReviewRunFailed, \"runtime root unavailable\")\n\t}\n\tdefer runtimeRoot.Close()\n\tvar worktreeOwned os.FileInfo\n\tvar gitMarker []byte\n\tvar ownership *reviewCleanupOwnership\n\tworktree := filepath.Join(tmp, \"worktree\")\n\tcleanup = func() error {\n\t\treturn s.cleanupReviewResources(tmp, owned, worktree, worktreeOwned, gitMarker, ownership)\n\t}\n\thooks := filepath.Join(tmp, \"empty-hooks\")\n\tif err := os.Mkdir(hooks, 0700); err != nil {\n\t\treturn finish(ReviewRunFailed, \"private hook directory setup failed\")\n\t}\n\tsetupCtx, stopSetup := context.WithTimeout(parent, 2*time.Minute)\n\tdefer stopSetup()\n\tsetup := reviewSetupCommand(setupCtx, gitCommand(\"-C\", s.Root, \"-c\", \"core.hooksPath=\"+hooks, \"worktree\", \"add\", \"--detach\", worktree, plan.SealedCommit))\n\tsetupOutput := &reviewBoundedCapture{limit: 64 << 10, cancel: stopSetup}\n\tsetup.Stdout, setup.Stderr = setupOutput, setupOutput\n\tsetupErr := setup.Run()\n\t_, setupOverflow := setupOutput.result()\n\tterminationErr := killProcessGroup(setup)\n\tif terminationErr != nil {\n\t\tterminationFailed = true\n\t}\n\tsetupCause := executionCause(setupCtx)\n\tif setupErr != nil || terminationErr != nil || setupOverflow {\n\t\tsafety.ExecutionCause = setupCause\n\t\tif setupOverflow {\n\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n\t\t}\n\t\treturn finish(ReviewRunFailed, \"review worktree setup failed or termination incomplete\")\n\t}\n\n\tworktreeOwned, err = os.Lstat(worktree)\n\tif err != nil {\n\t\treturn finish(ReviewRunFailed, \"worktree identity unavailable\")\n\t}\n\tgitMarker, err = ReadReviewAdapterFile(filepath.Join(worktree, \".git\"), 4096)\n\tif err != nil {\n\t\treturn finish(ReviewRunFailed, \"worktree marker unavailable\")\n\t}\n\townership, err = s.captureReviewCleanupOwnership(runtimeRoot, worktree, gitMarker)\n\tif err != nil {\n\t\treturn finish(ReviewRunFailed, \"worktree registration ownership unavailable\")\n\t}\n\tdefer ownership.registry.Close()\n\n\tsubmodules := map[string]bool{}\n\tfor _, entry := range plan.Bundle.Payload.Subject.Entries {\n\t\tif entry.Class == \"submodule\" {\n\t\t\tsubmodules[reviewBundleEntryPath(entry)] = true\n\t\t}\n\t}\n\tcommittedWorktreeBytes := ownership.inventoryBytes - gitSnapshotMarginBytes\n\tgitlinks := reviewGitlinkSetup{\n\t\tctx: setupCtx, cancel: stopSetup, hooks: hooks,\n\t\tmetadata:          filepath.Join(tmp, reviewGitlinkMetadataDir),\n\t\tmaxCommittedBytes: gitSnapshotCeilingBytes - committedWorktreeBytes,\n\t}\n\tgitlinkErr := gitlinks.materialize(s.Root, worktree, plan.SealedCommit, plan.Bundle.Payload.Subject.Entries)\n\townership.inventoryBytes = gitSnapshotBudget(committedWorktreeBytes + gitlinks.committedBytes)\n\townership.gitlinkMetadata = gitlinks.metadataOwned\n\townership.gitlinkMetadataBytes = gitSnapshotBudget(gitlinks.committedBytes)\n\tif gitlinkErr != nil {\n\t\tterminationFailed = gitlinks.terminationFailure\n\t\tsafety.ExecutionCause = executionCause(setupCtx)\n\t\tif gitlinks.captureOverflow {\n\t\t\tsafety.ExecutionCause = \"setup-capture-limit\"\n\t\t}\n\t\treturn finish(ReviewRunFailed, \"sealed gitlink setup failed: \"+gitlinkErr.Error())\n\t}\n\tstopSetup()\n\tcheckout := s\n\tcheckout.Root, checkout.indexPin = worktree, nil\n\tif prepared, err := checkout.PrepareReviewBundle(plan.Brief.Scope); err != nil {\n\t\treturn finish(ReviewRunFailed, \"sealed checkout inputs unavailable: \"+err.Error())\n\t} else if blockers := checkoutBlockers(prepared.Blockers); len(blockers) > 0 {\n\t\treturn fi