ntimeSourceOf(prior))\n \tif !ok {\n-\t\treturn false\n+\t\treturn \"\"\n \t}\n-\t_, err := os.Lstat(dir)\n-\treturn err == nil\n+\tif _, err := os.Lstat(dir); errors.Is(err, os.ErrNotExist) {\n+\t\treturn \"\"\n+\t}\n+\treturn dir\n }\ndiff --git a/pose-mcp/internal/pose/review_run_continuity.go b/pose-mcp/internal/pose/review_run_continuity.go\nindex 77ac8f69..7946ebdb 100644\n--- a/pose-mcp/internal/pose/review_run_continuity.go\n+++ b/pose-mcp/internal/pose/review_run_continuity.go\n@@ -432,10 +432,17 @@ func (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n \t\t// Another resume takes the directory just before its claim: a claim\n \t\t// that appears meanwhile makes this one pending (spec\n \t\t// pose-review-resume-runtime-dir-followups R1).\n-\t\tif pending := s.awaitContinuationClaim(*prior); pending != nil {\n+\t\texisting, pending := s.awaitContinuationClaim(context.Background(), *prior)\n+\t\tif pending != nil {\n \t\t\tplan.PendingContinuation = pending\n \t\t\treturn plan, nil\n \t\t}\n+\t\tif existing != nil {\n+\t\t\t// Another resume ended meanwhile: its record is the answer\n+\t\t\t// (spec pose-review-resume-residuals R1).\n+\t\t\tplan.Existing = existing\n+\t\t\treturn plan, nil\n+\t\t}\n \t\treturn DispatchPlan{}, e\n \t}\n \t// The attempt's budget, not this agent's: after a handoff the resumed","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Tgmm7MCqAY2Pd7gh6UhbmP","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
