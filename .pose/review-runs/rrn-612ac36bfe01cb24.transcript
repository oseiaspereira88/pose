nwhile makes this one pending (spec\n351\t\t\t// pose-review-resume-runtime-dir-followups R1).\n352\t\t\texisting, pending := s.awaitContinuationClaim(context.Background(), *prior)\n353\t\t\tif pending != nil {\n354\t\t\t\tplan.PendingContinuation = pending\n355\t\t\t\treturn plan, nil\n356\t\t\t}\n357\t\t\tif existing != nil {\n358\t\t\t\t// Another resume ended meanwhile: its record is the answer\n359\t\t\t\t// (spec pose-review-resume-residuals R1).\n360\t\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was already continued by run %s\", prior.RunID, existing.RunID)\n361\t\t\t}\n362\t\t\treturn DispatchPlan{}, e\n363\t\t}\n364\t\tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\n365\t\tif e != nil {\n366\t\t\treturn DispatchPlan{}, e\n367\t\t}\n368\t\tif count >= limit || spent >= total {\n369\t\t\treturn DispatchPlan{}, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"pose: the attempt's continuation budget is spent: %d continuations, %s wall-clock\", count, spent))\n370\t\t}\n371\t\ttimeout := 60 * time.Minute\n372\t\tif config.Timeout != \"\" {\n373\t\t\ttimeout, _ = time.ParseDuration(config.Timeout)\n374\t\t}\n375\t\tif total-spent < timeout {\n376\t\t\ttimeout = total - spent\n377\t\t}\n378\t\tplan.processTimeout = timeout\n379\t\ts.planImplementation(&plan, prior.Lead)\n380\t\tplan.provenance, e = s.prepareRunProvenance(plan, policy)\n381\t\tif e != nil {\n382\t\t\treturn DispatchPlan{}, e\n383\t\t}\n384\t\treturn plan, nil\n385\t}\n386\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"9c7df0ce-ce3b-45f1-a7a3-4008b7a95426","timestamp":"2026-11-27T23:07:55.208Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-668ca2f6e0/worktree/pose-mcp/internal/pose/delegation_handoff.go","content":"\tif len(lost) > 0 {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff history incomplete: %v\", lost)\n\t}\n\tvar prior *ReviewRun\n\tfor i := range runs {\n\t\tif runs[i].RunID == id {\n\t\t\tprior = &runs[i]\n\t\t}\n\t}\n\tif prior == nil {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff predecessor not found\")\n\t}\n\tif why := handoffable(*prior); why != \"\" {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s cannot be handed off: %s\", prior.RunID, why)\n\t}\n\tif prior.AttemptID == \"\" {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was recorded before attempts existed and cannot be continued\", prior.RunID)\n\t}\n\tif prior.Adapter == agent {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s already ran agent %s; resume it to continue the same agent\", prior.RunID, agent)\n\t}\n\tif why := s.reviewRunTranscriptIntact(*prior); why != \"\" {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff: %s\", why)\n\t}\n\tif prior.Safety != nil && prior.Safety.Operation.Outcome != OutcomeCompleted {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"predecessor cleanup incomplete; refusing continuation beside possible orphan\")\n\t}\n\tpolicy, _, e := s.LoadReviewersPolicyFor(prior.Kind)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tconfig, ok := policy.Adapters[agent]\n\tif !ok {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: no agent %q can run this purpose\", agent)\n\t}\n\tbrief, e := s.RenderReviewBriefMatching(prior.BundleID, prior.Kind, prior.BriefNotes, prior.BriefDigest)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tbundle, e := s.LoadReviewBundle(prior.BundleID)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif brief.Digest != prior.BriefDigest || bundle.BundleDigest != prior.BundleDigest || bundle.Payload.Subject.Head != prior.SealedCommit {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"handoff bundle or brief digest changed\")\n\t}\n\torigin, e := dispatchWorktreeIdentity(s.Root)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tsection := s.handoffSectionFor(*prior)\n\thandoffBrief := brief\n\thandoffBrief.Text = brief.Text + section\n\tplan := DispatchPlan{predecessor: prior, handoff: true, handoffSection: section, notes: prior.BriefNotes, Reason: prior.Reason,\n\t\tPolicyDigest: directoryDigestIn(s.fsys(), filepath.Join(s.Root, \".pose\", \"policy\")), OriginWorktree: origin, Adapter: agent, Config: config,\n\t\tBrief: handoffBrief, Bundle: bundle, SealedCommit: prior.SealedCommit}\n\tcontinuationRound(&plan, *prior, true)\n\tif e = s.checkDispatchOrigin(plan); e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\texisting, e := s.existingReviewContinuation(*prior, runs)\n\tif e != nil {\n\t\tvar pending *PendingReviewContinuation\n\t\tif errors.As(e, &pending) {\n\t\t\tplan.PendingContinuation = pending\n\t\t\treturn plan, nil\n\t\t}\n\t\treturn DispatchPlan{}, e\n\t}\n\tif existing != nil {\n\t\tif existing.HandsOffFrom != prior.RunID || existing.Adapter != agent {\n\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was already continued by run %s\", prior.RunID, existing.RunID)\n\t\t}\n\t\tplan.Existing = existing\n\t\treturn plan, nil\n\t}\n\t// A handoff runs in the attempt's runtime directory too (spec\n\t// pose-review-resume-keeps-the-sealed-checkout, review round 2, N6).\n\tif e = reviewRunRuntimeDirFree(runtimeSourceOf(*prior), \"hand off\"); e != nil {\n\t\t// Another resume takes the directory just before its claim: a claim\n\t\t// that appears meanwhile makes this one pending (spec\n\t\t// pose-review-resume-runtime-dir-followups R1).\n\t\texisting, pending := s.awaitContinuationClaim(context.Background(), *prior)\n\t\tif pending != nil {\n\t\t\tplan.PendingContinuation = pending\n\t\t\treturn plan, nil\n\t\t}\n\t\tif existing != nil {\n\t\t\t// Another resume ended meanwhile: its record is the answer\n\t\t\t// (spec pose-review-resume-residuals R1).\n\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was already continued by run %s\", prior.RunID, existing.RunID)\n\t\t}\n\t\treturn DispatchPlan{}, e\n\t}\n\tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif count >= limit || spent >= total {\n\t\treturn DispatchPlan{}, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"pose: the attempt's continuation budget is spent: %d continuations, %s wall-clock\", count, spent))\n\t}\n\ttimeout := 60 * time.Minute\n\tif config.Timeout != \"\" {\n\t\ttimeout, _ = time.ParseDuration(config.Timeout)\n\t}\n\tif total-spent < timeout {\n\t\ttimeout = total - spent\n\t}\n\tplan.processTimeout = timeout\n\ts.planImplementation(&plan, prior.Lead)\n\tplan.provenance, e = s.prepareRunProvenance(plan, policy)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\treturn plan, nil\n}\n","numLines":117,"startLine":270,"totalLines":386}},"tool_result_meta":[{"id":"toolu_01JRY6tgQtfAbNd1zqMMkJid","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
