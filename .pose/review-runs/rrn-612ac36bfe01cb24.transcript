{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YVak9RQHpnbjSQzZaJUi5D","type":"tool_result","content":"650\t\n651\tfunc (t *ReviewThread) continued() bool { return t != nil && t.Mode == ReviewThreadContinued }\n652\t\n653\t// planReviewThread decides the session of a review round after the first:\n654\t// with continue-thread it resumes the session the previous round ended with,\n655\t// unless the agent's vendor or the agent changed, a draft of the chain cannot\n656\t// be read, that session cannot be resumed, or the scope reached the round\n657\t// threshold; each opens a new session, recording why (R6, D1, D5).\n658\tfunc (s Store) planReviewThread(plan *DispatchPlan) error {\n659\t\tround, err := s.ReviewRoundOf(plan.Bundle)\n660\t\tif err != nil {\n661\t\t\treturn err\n662\t\t}\n663\t\tplan.round = round.Number\n664\t\tif round.Number < 2 || round.Prior == nil {\n665\t\t\treturn nil\n666\t\t}\n667\t\tpolicy, _, _, err := s.LoadDelegationPolicy()\n668\t\tif err != nil {\n669\t\t\treturn err\n670\t\t}\n671\t\truns, _, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n672\t\tif err != nil {\n673\t\t\treturn err\n674\t\t}\n675\t\tprior := round.Prior\n676\t\tthread := &ReviewThread{Round: round.Number, Mode: ReviewThreadNew, From: prior.RunID}\n677\t\tthreshold := policy.Routing.RoundThresholdOf()\n678\t\tfailed := FailedContinuation(runs, plan.Bundle.BundleID)\n679\t\tsession := \"\"\n680\t\tswitch {\n681\t\tcase policy.Routing.RoundsMode() == ReviewRoundsColdSession:\n682\t\t\tthread.Reason = \"routing.rounds is cold-session\"\n683\t\tcase round.Broken != \"\":\n684\t\t\tthread.Reason = \"the chain of rounds is broken: \" + round.Broken\n685\t\tcase !strings.EqualFold(prior.Vendor, plan.Config.Vendor):\n686\t\t\tthread.Reason = \"the agent's vendor changed from \" + prior.Vendor + \" to \" + plan.Config.Vendor\n687\t\tcase prior.Adapter != plan.Adapter:\n688\t\t\tthread.Reason = \"the agent changed from \" + prior.Adapter + \" to \" + plan.Adapter\n689\t\tcase round.Number >= threshold:\n690\t\t\tthread.Reason = fmt.Sprintf(\"round %d reached the round threshold %d\", round.Number, threshold)\n691\t\tcase prior.SessionDigest == \"\" || plan.Config.Resume == nil || len(plan.Config.Resume.Command) == 0:\n692\t\t\tthread.Reason = \"the previous round's session cannot be resumed: it recorded no session or the agent declares no resume\"\n693\t\tcase failed != nil:\n694\t\t\tthread.Reason = FailedContinuationReason(failed)\n695\t\tcase previousRoundCheckoutHeld(*prior) != \"\":\n696\t\t\t// The continued session would work where the previous round's run\n697\t\t\t// did; that path is held by a leftover or a live run, so the round\n698\t\t\t// opens a new session in its own directory instead of failing after\n699\t\t\t// its attempt is reserved (spec pose-review-resume-runtime-dir-followups,\n700\t\t\t// review round 1, N2).\n701\t\t\tthread.Reason = \"the previous round's checkout path \" + previousRoundCheckoutHeld(*prior) + \" is still in use\"\n702\t\tdefault:\n703\t\t\tvalue, rerr := s.readReviewSession(prior.SessionDigest)\n704\t\t\tif rerr != nil {\n705\t\t\t\tthread.Reason = \"the previous round's session cannot be resumed: \" + rerr.Error()\n706\t\t\t\tbreak\n707\t\t\t}\n708\t\t\tthread.Mode, session = ReviewThreadContinued, value\n709\t\t}\n710\t\tplan.thread, plan.session = thread, session\n711\t\treturn nil\n712\t}\n713\t\n714\t// FailedContinuation is a run of the bundle that failed while continuing a\n715\t// session: nothing says why in terms common to every vendor, and resuming what\n716\t// just failed is not worth an attempt (spec\n717\t// pose-delegated-review-expired-session R1, D1).\n718\tfunc FailedContinuation(runs []ReviewRun, bundleID string) *ReviewRun {\n719\t\tfor i := range runs {\n720\t\t\tif runs[i].BundleID == bundleID && runs[i].Status == ReviewRunFailed && runs[i].Thread.continued() {\n721\t\t\t\treturn &runs[i]\n722\t\t\t}\n723\t\t}\n724\t\treturn nil\n725\t}\n726\t\n727\tfunc FailedContinuationReason(run *ReviewRun) string {\n728\t\treason := \"the session could not be continued: run \" + run.RunID + \" failed\"\n729\t\tif failure := []rune(run.Failure); len(failure) > 200 {\n730\t\t\treturn reason + \": \" + string(failure[:200]) + \"…\"\n731\t\t} else if len(failure) > 0 {\n732\t\t\treturn reason + \": \" + string(failure)\n733\t\t}\n734\t\treturn reason\n735\t}\n736\t\n737\t// continuationRound carries the round of a run's predecessor to its\n738\t// continuation: a resume keeps the predecessor's thread, a handoff records a\n739\t// new session because another agent runs (review round 1, B11)."}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"ed74f618-0c82-4a22-9cc6-0ced40258c19","timestamp":"2026-11-27T23:07:56.647Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-668ca2f6e0/worktree/pose-mcp/internal/pose/review_rounds.go","content":"\nfunc (t *ReviewThread) continued() bool { return t != nil && t.Mode == ReviewThreadContinued }\n\n// planReviewThread decides the session of a review round after the first:\n// with continue-thread it resumes the session the previous round ended with,\n// unless the agent's vendor or the agent changed, a draft of the chain cannot\n// be read, that session cannot be resumed, or the scope reached the round\n// threshold; each opens a new session, recording why (R6, D1, D5).\nfunc (s Store) planReviewThread(plan *DispatchPlan) error {\n\tround, err := s.ReviewRoundOf(plan.Bundle)\n\tif err != nil {\n\t\treturn err\n\t}\n\tplan.round = round.Number\n\tif round.Number < 2 || round.Prior == nil {\n\t\treturn nil\n\t}\n\tpolicy, _, _, err := s.LoadDelegationPolicy()\n\tif err != nil {\n\t\treturn err\n\t}\n\truns, _, err := s.ReadReviewRuns(plan.Bundle.BundleID)\n\tif err != nil {\n\t\treturn err\n\t}\n\tprior := round.Prior\n\tthread := &ReviewThread{Round: round.Number, Mode: ReviewThreadNew, From: prior.RunID}\n\tthreshold := policy.Routing.RoundThresholdOf()\n\tfailed := FailedContinuation(runs, plan.Bundle.BundleID)\n\tsession := \"\"\n\tswitch {\n\tcase policy.Routing.RoundsMode() == ReviewRoundsColdSession:\n\t\tthread.Reason = \"routing.rounds is cold-session\"\n\tcase round.Broken != \"\":\n\t\tthread.Reason = \"the chain of rounds is broken: \" + round.Broken\n\tcase !strings.EqualFold(prior.Vendor, plan.Config.Vendor):\n\t\tthread.Reason = \"the agent's vendor changed from \" + prior.Vendor + \" to \" + plan.Config.Vendor\n\tcase prior.Adapter != plan.Adapter:\n\t\tthread.Reason = \"the agent changed from \" + prior.Adapter + \" to \" + plan.Adapter\n\tcase round.Number >= threshold:\n\t\tthread.Reason = fmt.Sprintf(\"round %d reached the round threshold %d\", round.Number, threshold)\n\tcase prior.SessionDigest == \"\" || plan.Config.Resume == nil || len(plan.Config.Resume.Command) == 0:\n\t\tthread.Reason = \"the previous round's session cannot be resumed: it recorded no session or the agent declares no resume\"\n\tcase failed != nil:\n\t\tthread.Reason = FailedContinuationReason(failed)\n\tcase previousRoundCheckoutHeld(*prior) != \"\":\n\t\t// The continued session would work where the previous round's run\n\t\t// did; that path is held by a leftover or a live run, so the round\n\t\t// opens a new session in its own directory instead of failing after\n\t\t// its attempt is reserved (spec pose-review-resume-runtime-dir-followups,\n\t\t// review round 1, N2).\n\t\tthread.Reason = \"the previous round's checkout path \" + previousRoundCheckoutHeld(*prior) + \" is still in use\"\n\tdefault:\n\t\tvalue, rerr := s.readReviewSession(prior.SessionDigest)\n\t\tif rerr != nil {\n\t\t\tthread.Reason = \"the previous round's session cannot be resumed: \" + rerr.Error()\n\t\t\tbreak\n\t\t}\n\t\tthread.Mode, session = ReviewThreadContinued, value\n\t}\n\tplan.thread, plan.session = thread, session\n\treturn nil\n}\n\n// FailedContinuation is a run of the bundle that failed while continuing a\n// session: nothing says why in terms common to every vendor, and resuming what\n// just failed is not worth an attempt (spec\n// pose-delegated-review-expired-session R1, D1).\nfunc FailedContinuation(runs []ReviewRun, bundleID string) *ReviewRun {\n\tfor i := range runs {\n\t\tif runs[i].BundleID == bundleID && runs[i].Status == ReviewRunFailed && runs[i].Thread.continued() {\n\t\t\treturn &runs[i]\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc FailedContinuationReason(run *ReviewRun) string {\n\treason := \"the session could not be continued: run \" + run.RunID + \" failed\"\n\tif failure := []rune(run.Failure); len(failure) > 200 {\n\t\treturn reason + \": \" + string(failure[:200]) + \"…\"\n\t} else if len(failure) > 0 {\n\t\treturn reason + \": \" + string(failure)\n\t}\n\treturn reason\n}\n\n// continuationRound carries the round of a run's predecessor to its\n// continuation: a resume keeps the predecessor's thread, a handoff records a\n// new session because another agent runs (review round 1, B11).","numLines":90,"startLine":650,"totalLines":919}},"tool_result_meta":[{"id":"toolu_01YVak9RQHpnbjSQzZaJUi5D","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
