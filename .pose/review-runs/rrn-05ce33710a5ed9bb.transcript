{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0124FsmQyRgtzazKYnyqjtuf","type":"tool_result","content":"100\t\t}\n101\t\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 1 {\n102\t\t\tt.Fatalf(\"hits %d misses %d, want 1 and 1\", hits, misses)\n103\t\t}\n104\t\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"one changed\\n\"), 0o644); err != nil {\n105\t\t\tt.Fatal(err)\n106\t\t}\n107\t\tsnapshotTestGit(t, root, \"add\", \"a.md\")\n108\t\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-m\", \"change a\")\n109\t\tthird := capture()\n110\t\tif third == without {\n111\t\t\tt.Fatalf(\"a new commit that changed the path returned the memoized commit %s\", third)\n112\t\t}\n113\t\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 2 {\n114\t\t\tt.Fatalf(\"after the new commit hits %d misses %d, want 1 and 2\", hits, misses)\n115\t\t}\n116\t}\n117\t\n118\t// A global Git configuration that changes what a read answers must change the key: the digest of\n119\t// the effective configuration follows a change of the user's own configuration file.\n120\tfunc TestTheEffectiveGitConfigurationFollowsTheUsersConfigurationFile(t *testing.T) {\n121\t\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\"})\n122\t\thome := t.TempDir()\n123\t\tt.Setenv(\"HOME\", home)\n124\t\tt.Setenv(\"XDG_CONFIG_HOME\", filepath.Join(home, \"xdg\"))\n125\t\tt.Setenv(\"GIT_CONFIG_NOSYSTEM\", \"1\")\n126\t\t_, view := (Store{Root: root}).beginGovernanceReadView()\n127\t\tstate := view.operation.git\n128\t\tctx := context.Background()\n129\t\tbefore := state.effectiveGitConfig(ctx, NativeFiles(), root)\n130\t\tif before == \"\" {\n131\t\t\tt.Skip(\"the effective Git configuration cannot be read here\")\n132\t\t}\n133\t\t// The test process points GIT_CONFIG_GLOBAL at a file of its own (testgit.Isolate): that is the\n134\t\t// user's configuration here.\n135\t\tuserConfig := os.Getenv(\"GIT_CONFIG_GLOBAL\")\n136\t\tif userConfig == \"\" {\n137\t\t\tuserConfig = filepath.Join(home, \".gitconfig\")\n138\t\t}\n139\t\toriginal, _ := os.ReadFile(userConfig)\n140\t\tt.Cleanup(func() { _ = os.WriteFile(userConfig, original, 0o644) })\n141\t\tif err := os.WriteFile(userConfig, append(append([]byte(nil), original...), []byte(\"\\n[log]\\n\\tfollow = true\\n\")...), 0o644); err != nil {\n142\t\t\tt.Fatal(err)\n143\t\t}\n144\t\t// A new operation reads it again; the same operation keeps the digest it took.\n145\t\tif same := state.effectiveGitConfig(ctx, NativeFiles(), root); same != before {\n146\t\t\tt.Fatal(\"the digest changed inside one operation\")\n147\t\t}\n148\t\t_, next := (Store{Root: root}).beginGovernanceReadView()\n149\t\tafter := next.operation.git.effectiveGitConfig(ctx, NativeFiles(), root)\n150\t\tif after == before {\n151\t\t\tt.Fatal(\"a change of the user's Git configuration did not change the key\")\n152\t\t}\n153\t}\n154\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"c9ea7bfa-d342-42b8-a153-99b829e5cf42","timestamp":"2026-11-10T21:59:56.180Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-964178616/worktree/pose-mcp/internal/pose/resident_git_memo_test.go","content":"\t}\n\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 1 {\n\t\tt.Fatalf(\"hits %d misses %d, want 1 and 1\", hits, misses)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \"a.md\"), []byte(\"one changed\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsnapshotTestGit(t, root, \"add\", \"a.md\")\n\tsnapshotTestGit(t, root, \"commit\", \"-q\", \"-m\", \"change a\")\n\tthird := capture()\n\tif third == without {\n\t\tt.Fatalf(\"a new commit that changed the path returned the memoized commit %s\", third)\n\t}\n\tif hits, misses, _, _ := ResidentGitMemoStats(); hits != 1 || misses != 2 {\n\t\tt.Fatalf(\"after the new commit hits %d misses %d, want 1 and 2\", hits, misses)\n\t}\n}\n\n// A global Git configuration that changes what a read answers must change the key: the digest of\n// the effective configuration follows a change of the user's own configuration file.\nfunc TestTheEffectiveGitConfigurationFollowsTheUsersConfigurationFile(t *testing.T) {\n\troot := snapshotRepo(t, map[string]string{\"a.md\": \"one\\n\"})\n\thome := t.TempDir()\n\tt.Setenv(\"HOME\", home)\n\tt.Setenv(\"XDG_CONFIG_HOME\", filepath.Join(home, \"xdg\"))\n\tt.Setenv(\"GIT_CONFIG_NOSYSTEM\", \"1\")\n\t_, view := (Store{Root: root}).beginGovernanceReadView()\n\tstate := view.operation.git\n\tctx := context.Background()\n\tbefore := state.effectiveGitConfig(ctx, NativeFiles(), root)\n\tif before == \"\" {\n\t\tt.Skip(\"the effective Git configuration cannot be read here\")\n\t}\n\t// The test process points GIT_CONFIG_GLOBAL at a file of its own (testgit.Isolate): that is the\n\t// user's configuration here.\n\tuserConfig := os.Getenv(\"GIT_CONFIG_GLOBAL\")\n\tif userConfig == \"\" {\n\t\tuserConfig = filepath.Join(home, \".gitconfig\")\n\t}\n\toriginal, _ := os.ReadFile(userConfig)\n\tt.Cleanup(func() { _ = os.WriteFile(userConfig, original, 0o644) })\n\tif err := os.WriteFile(userConfig, append(append([]byte(nil), original...), []byte(\"\\n[log]\\n\\tfollow = true\\n\")...), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// A new operation reads it again; the same operation keeps the digest it took.\n\tif same := state.effectiveGitConfig(ctx, NativeFiles(), root); same != before {\n\t\tt.Fatal(\"the digest changed inside one operation\")\n\t}\n\t_, next := (Store{Root: root}).beginGovernanceReadView()\n\tafter := next.operation.git.effectiveGitConfig(ctx, NativeFiles(), root)\n\tif after == before {\n\t\tt.Fatal(\"a change of the user's Git configuration did not change the key\")\n\t}\n}\n","numLines":55,"startLine":100,"totalLines":154}},"tool_result_meta":[{"id":"toolu_0124FsmQyRgtzazKYnyqjtuf","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
