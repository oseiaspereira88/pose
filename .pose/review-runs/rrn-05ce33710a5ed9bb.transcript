{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RYHNKj1Gmw2FBHREMcxA6d","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"crypto/sha256\"\n7\t\t\"encoding/hex\"\n8\t\t\"encoding/json\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"sort\"\n14\t\t\"strings\"\n15\t\t\"sync/atomic\"\n16\t\t\"time\"\n17\t\n18\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n19\t\t\"github.com/harne8/pose-mcp/internal/version\"\n20\t\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n21\t)\n22\t\n23\t// Spec pose-worktree-runtime-resident-cache.\n24\t\n25\tconst runtimeRunSchema = \"pose.runtime.run/1\"\n26\t\n27\t// maxHostedOutput bounds what a hosted command's reply carries; past it the reply says the\n28\t// command ran and its output is not sent.\n29\tconst maxHostedOutput = 2 << 20\n30\t\n31\t// hostedCommands are the commands the runtime runs for a caller: the checks that read the\n32\t// project and answer. They run as the user that started the runtime, in its worktree, with\n33\t// the environment digest the caller proved equal to the runtime's: a caller never gains,\n34\t// through the runtime, an authority it does not have standalone.\n35\tvar hostedCommands = map[string]bool{\n36\t\t\"review-check\": true, \"closeout-check\": true, \"artifact-check\": true, \"surface-check\": true, \"roadmap-check\": true,\n37\t}\n38\t\n39\t// runtimeEnvDigest is the digest of the environment that decides what a command answers: the\n40\t// POSE_, HARNE8_, GIT_, CLAUDE and CODEX variables (project roots, identities, session markers\n41\t// seals detect), the locale, the home and state directories and NO_COLOR.\n42\tfunc runtimeEnvDigest(environ []string) string {\n43\t\tkeep := func(k string) bool {\n44\t\t\tfor _, p := range []string{\"POSE_\", \"HARNE8_\", \"GIT_\", \"CLAUDE\", \"CODEX\", \"XDG_STATE_HOME\", \"XDG_CONFIG_HOME\", \"XDG_RUNTIME_DIR\"} {\n45\t\t\t\tif strings.HasPrefix(k, p) {\n46\t\t\t\t\treturn true\n47\t\t\t\t}\n48\t\t\t}\n49\t\t\tswitch k {\n50\t\t\tcase \"LC_ALL\", \"LANG\", \"LANGUAGE\", \"HOME\", \"NO_COLOR\", \"USER\", \"LOGNAME\":\n51\t\t\t\treturn true\n52\t\t\t}\n53\t\t\treturn false\n54\t\t}\n55\t\tvar pairs []string\n56\t\tfor _, kv := range environ {\n57\t\t\tif k, _, ok := strings.Cut(kv, \"=\"); ok && keep(k) {\n58\t\t\t\tpairs = append(pairs, kv)\n59\t\t\t}\n60\t\t}\n61\t\tsort.Strings(pairs)\n62\t\tsum := sha256.Sum256([]byte(strings.Join(pairs, \"\\x00\")))\n63\t\treturn hex.EncodeToString(sum[:])\n64\t}\n65\t\n66\t// runtimeHostedRun runs a hosted command; tests replace it.\n67\ttype hostedRunFunc func(args []string, out, errb io.Writer) int\n68\t\n69\tvar runtimeHostedRun atomic.Pointer[hostedRunFunc]\n70\t\n71\t// Set at init: mainCommand reaches this file through cmdRuntime, so a variable initialised with\n72\t// it would be an initialization cycle.\n73\tfunc init() {\n74\t\trun := hostedRunFunc(func(args []string, out, errb io.Writer) int { return mainCommand(args, out, errb) })\n75\t\truntimeHostedRun.Store(&run)\n76\t}\n77\t\n78\t// runtimeHostedHandler runs the commands the runtime hosts (the commands read\n79\t// and may refresh the project's derived files, which they publish atomically as separate\n80\t// processes do) in the lanes of the admission policy, and answers with a typed result. Anything it does not host or will not run is refused before it\n81\t// starts.\n82\tfunc runtimeHostedHandler(envDigest string, busy *atomic.Int64, lanes *hostedLanes) func(context.Context, worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n83\t\treturn func(ctx context.Context, req worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n84\t\t\tif req.Op != \"run\" {\n85\t\t\t\treturn worktreeruntime.Reply{}, false\n86\t\t\t}\n87\t\t\trefuse := func(why string) (worktreeruntime.Reply, bool) {\n88\t\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeRefused, Reason: why}, true\n89\t\t\t}\n90\t\t\tswitch {\n91\t\t\tcase len(req.Args) == 0 || !hostedCommands[req.Args[0]]:\n92\t\t\t\treturn refuse(\"the runtime does not host this command\")\n93\t\t\tcase req.Env != envDigest:\n94\t\t\t\treturn refuse(\"the caller's environment differs from the one the runtime started in\")\n95\t\t\t}\n96\t\t\tstarted := time.Now()\n97\t\t\t// One hosted command at a time. The deadline covers the wait for its turn: a command\n98\t\t\t// that has not started by then is withdrawn and refused, so its caller may run it\n99\t\t\t// standalone without the runtime running it later as well.\n100\t\t\tlimit := time.Duration(req.DeadlineMS) * time.Millisecond\n101\t\t\tif limit <= 0 || limit > worktreeruntime.MaxHostedDuration {\n102\t\t\t\tlimit = worktreeruntime.MaxHostedDuration\n103\t\t\t}\n104\t\t\ttimer := time.NewTimer(limit)\n105\t\t\tdefer timer.Stop()\n106\t\t\tlane := lanes.of(req.Args[0])\n107\t\t\tif !lane.enter() {\n108\t\t\t\treturn refuse(\"the \" + lane.name + \" lane of the runtime is full: this command did not start\")\n109\t\t\t}\n110\t\t\twaitStart := time.Now()\n111\t\t\tselect {\n112\t\t\tcase lane.slots <- struct{}{}:\n113\t\t\t\tlane.admit(time.Since(waitStart))\n114\t\t\tcase <-timer.C:\n115\t\t\t\tlane.withdrawn()\n116\t\t\t\treturn refuse(\"the runtime was busy with another command until the deadline: this one did not start\")\n117\t\t\tcase <-ctx.Done():\n118\t\t\t\tlane.withdrawn()\n119\t\t\t\treturn refuse(\"the runtime is stopping: this command did not start\")\n120\t\t\t}\n121\t\t\tdone := make(chan worktreeruntime.Reply, 1)\n122\t\t\t// While its caller waits, the command is the caller's open connection and counts as in\n123\t\t\t// flight through it. Only when the caller is answered at a deadline with the command still\n124\t\t\t// running does it become busy work: orphaned is 0 while the caller waits, 1 once the\n125\t\t\t// deadline left it running, 2 once it ended, so it is counted once, by one of the two.\n126\t\t\tvar orphaned atomic.Int32\n127\t\t\tgo func() {\n128\t\t\t\tdefer func() {\n129\t\t\t\t\tif !orphaned.CompareAndSwap(0, 2) {\n130\t\t\t\t\t\tbusy.Add(-1)\n131\t\t\t\t\t}\n132\t\t\t\t}()\n133\t\t\t\tdefer func() { <-lane.slots; lane.running.Add(-1) }()\n134\t\t\t\thitsBefore, _, _, _ := posemodel.ResidentGitMemoStats()\n135\t\t\t\tvar out, errb bytes.Buffer\n136\t\t\t\tcode := 1\n137\t\t\t\tfunc() {\n138\t\t\t\t\tdefer func() {\n139\t\t\t\t\t\tif r := recover(); r != nil {\n140\t\t\t\t\t\t\terrb.WriteString(\"pose: the command panicked: \" + fmt.Sprint(r) + \"\\n\")\n141\t\t\t\t\t\t}\n142\t\t\t\t\t}()\n143\t\t\t\t\tcode = (*runtimeHostedRun.Load())(req.Args, &out, &errb)\n144\t\t\t\t}()\n145\t\t\t\thitsAfter, _, _, _ := posemodel.ResidentGitMemoStats()\n146\t\t\t\tif out.Len()+errb.Len() > maxHostedOutput {\n147\t\t\t\t\t// The command ran; its output is too large to send whole.\n148\t\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeError, Reason: \"the command's output exceeds what the runtime sends back\", ExitCode: code, ElapsedMS: time.Since(started).Milliseconds()}\n149\t\t\t\t\treturn\n150\t\t\t\t}\n151\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(),\n152\t\t\t\t\tElapsedMS: time.Since(started).Milliseconds(), MemoHits: hitsAfter - hitsBefore}\n153\t\t\t}()\n154\t\t\tselect {\n155\t\t\tcase reply := <-done:\n156\t\t\t\treturn reply, true\n157\t\t\tcase <-timer.C:\n158\t\t\t\t// The command is read-only apart from refreshing derived files and cannot be\n159\t\t\t\t// cancelled; it ends on its own and the next one waits for it.\n160\t\t\t\tif orphaned.CompareAndSwap(0, 1) {\n161\t\t\t\t\tbusy.Add(1)\n162\t\t\t\t}\n163\t\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeDeadline, Reason: \"the deadline passed while the command ran; it was not stopped\", ElapsedMS: time.Since(started).Milliseconds()}, true\n164\t\t\t}\n165\t\t}\n166\t}\n167\t\n168\t// cmdRuntimeRun is `pose runtime run [--envelope] [--timeout <d>] <command> [args...]`: the\n169\t// command runs in the runtime when one is running, compatible and willing, and standalone in\n170\t// this process otherwise. The exit code and the output are the command's; --envelope prints"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"2fdd1b86-6a08-475b-83d2-8355518f65da","timestamp":"2026-11-10T22:00:06.882Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-964178616/worktree/pose-mcp/internal/cli/runtime_host.go","content":"package cli\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n)\n\n// Spec pose-worktree-runtime-resident-cache.\n\nconst runtimeRunSchema = \"pose.runtime.run/1\"\n\n// maxHostedOutput bounds what a hosted command's reply carries; past it the reply says the\n// command ran and its output is not sent.\nconst maxHostedOutput = 2 << 20\n\n// hostedCommands are the commands the runtime runs for a caller: the checks that read the\n// project and answer. They run as the user that started the runtime, in its worktree, with\n// the environment digest the caller proved equal to the runtime's: a caller never gains,\n// through the runtime, an authority it does not have standalone.\nvar hostedCommands = map[string]bool{\n\t\"review-check\": true, \"closeout-check\": true, \"artifact-check\": true, \"surface-check\": true, \"roadmap-check\": true,\n}\n\n// runtimeEnvDigest is the digest of the environment that decides what a command answers: the\n// POSE_, HARNE8_, GIT_, CLAUDE and CODEX variables (project roots, identities, session markers\n// seals detect), the locale, the home and state directories and NO_COLOR.\nfunc runtimeEnvDigest(environ []string) string {\n\tkeep := func(k string) bool {\n\t\tfor _, p := range []string{\"POSE_\", \"HARNE8_\", \"GIT_\", \"CLAUDE\", \"CODEX\", \"XDG_STATE_HOME\", \"XDG_CONFIG_HOME\", \"XDG_RUNTIME_DIR\"} {\n\t\t\tif strings.HasPrefix(k, p) {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t\tswitch k {\n\t\tcase \"LC_ALL\", \"LANG\", \"LANGUAGE\", \"HOME\", \"NO_COLOR\", \"USER\", \"LOGNAME\":\n\t\t\treturn true\n\t\t}\n\t\treturn false\n\t}\n\tvar pairs []string\n\tfor _, kv := range environ {\n\t\tif k, _, ok := strings.Cut(kv, \"=\"); ok && keep(k) {\n\t\t\tpairs = append(pairs, kv)\n\t\t}\n\t}\n\tsort.Strings(pairs)\n\tsum := sha256.Sum256([]byte(strings.Join(pairs, \"\\x00\")))\n\treturn hex.EncodeToString(sum[:])\n}\n\n// runtimeHostedRun runs a hosted command; tests replace it.\ntype hostedRunFunc func(args []string, out, errb io.Writer) int\n\nvar runtimeHostedRun atomic.Pointer[hostedRunFunc]\n\n// Set at init: mainCommand reaches this file through cmdRuntime, so a variable initialised with\n// it would be an initialization cycle.\nfunc init() {\n\trun := hostedRunFunc(func(args []string, out, errb io.Writer) int { return mainCommand(args, out, errb) })\n\truntimeHostedRun.Store(&run)\n}\n\n// runtimeHostedHandler runs the commands the runtime hosts (the commands read\n// and may refresh the project's derived files, which they publish atomically as separate\n// processes do) in the lanes of the admission policy, and answers with a typed result. Anything it does not host or will not run is refused before it\n// starts.\nfunc runtimeHostedHandler(envDigest string, busy *atomic.Int64, lanes *hostedLanes) func(context.Context, worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n\treturn func(ctx context.Context, req worktreeruntime.Request) (worktreeruntime.Reply, bool) {\n\t\tif req.Op != \"run\" {\n\t\t\treturn worktreeruntime.Reply{}, false\n\t\t}\n\t\trefuse := func(why string) (worktreeruntime.Reply, bool) {\n\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeRefused, Reason: why}, true\n\t\t}\n\t\tswitch {\n\t\tcase len(req.Args) == 0 || !hostedCommands[req.Args[0]]:\n\t\t\treturn refuse(\"the runtime does not host this command\")\n\t\tcase req.Env != envDigest:\n\t\t\treturn refuse(\"the caller's environment differs from the one the runtime started in\")\n\t\t}\n\t\tstarted := time.Now()\n\t\t// One hosted command at a time. The deadline covers the wait for its turn: a command\n\t\t// that has not started by then is withdrawn and refused, so its caller may run it\n\t\t// standalone without the runtime running it later as well.\n\t\tlimit := time.Duration(req.DeadlineMS) * time.Millisecond\n\t\tif limit <= 0 || limit > worktreeruntime.MaxHostedDuration {\n\t\t\tlimit = worktreeruntime.MaxHostedDuration\n\t\t}\n\t\ttimer := time.NewTimer(limit)\n\t\tdefer timer.Stop()\n\t\tlane := lanes.of(req.Args[0])\n\t\tif !lane.enter() {\n\t\t\treturn refuse(\"the \" + lane.name + \" lane of the runtime is full: this command did not start\")\n\t\t}\n\t\twaitStart := time.Now()\n\t\tselect {\n\t\tcase lane.slots <- struct{}{}:\n\t\t\tlane.admit(time.Since(waitStart))\n\t\tcase <-timer.C:\n\t\t\tlane.withdrawn()\n\t\t\treturn refuse(\"the runtime was busy with another command until the deadline: this one did not start\")\n\t\tcase <-ctx.Done():\n\t\t\tlane.withdrawn()\n\t\t\treturn refuse(\"the runtime is stopping: this command did not start\")\n\t\t}\n\t\tdone := make(chan worktreeruntime.Reply, 1)\n\t\t// While its caller waits, the command is the caller's open connection and counts as in\n\t\t// flight through it. Only when the caller is answered at a deadline with the command still\n\t\t// running does it become busy work: orphaned is 0 while the caller waits, 1 once the\n\t\t// deadline left it running, 2 once it ended, so it is counted once, by one of the two.\n\t\tvar orphaned atomic.Int32\n\t\tgo func() {\n\t\t\tdefer func() {\n\t\t\t\tif !orphaned.CompareAndSwap(0, 2) {\n\t\t\t\t\tbusy.Add(-1)\n\t\t\t\t}\n\t\t\t}()\n\t\t\tdefer func() { <-lane.slots; lane.running.Add(-1) }()\n\t\t\thitsBefore, _, _, _ := posemodel.ResidentGitMemoStats()\n\t\t\tvar out, errb bytes.Buffer\n\t\t\tcode := 1\n\t\t\tfunc() {\n\t\t\t\tdefer func() {\n\t\t\t\t\tif r := recover(); r != nil {\n\t\t\t\t\t\terrb.WriteString(\"pose: the command panicked: \" + fmt.Sprint(r) + \"\\n\")\n\t\t\t\t\t}\n\t\t\t\t}()\n\t\t\t\tcode = (*runtimeHostedRun.Load())(req.Args, &out, &errb)\n\t\t\t}()\n\t\t\thitsAfter, _, _, _ := posemodel.ResidentGitMemoStats()\n\t\t\tif out.Len()+errb.Len() > maxHostedOutput {\n\t\t\t\t// The command ran; its output is too large to send whole.\n\t\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeError, Reason: \"the command's output exceeds what the runtime sends back\", ExitCode: code, ElapsedMS: time.Since(started).Milliseconds()}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tdone <- worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeCompleted, ExitCode: code, Stdout: out.String(), Stderr: errb.String(),\n\t\t\t\tElapsedMS: time.Since(started).Milliseconds(), MemoHits: hitsAfter - hitsBefore}\n\t\t}()\n\t\tselect {\n\t\tcase reply := <-done:\n\t\t\treturn reply, true\n\t\tcase <-timer.C:\n\t\t\t// The command is read-only apart from refreshing derived files and cannot be\n\t\t\t// cancelled; it ends on its own and the next one waits for it.\n\t\t\tif orphaned.CompareAndSwap(0, 1) {\n\t\t\t\tbusy.Add(1)\n\t\t\t}\n\t\t\treturn worktreeruntime.Reply{Outcome: worktreeruntime.OutcomeDeadline, Reason: \"the deadline passed while the command ran; it was not stopped\", ElapsedMS: time.Since(started).Milliseconds()}, true\n\t\t}\n\t}\n}\n\n// cmdRuntimeRun is `pose runtime run [--envelope] [--timeout <d>] <command> [args...]`: the\n// command runs in the runtime when one is running, compatible and willing, and standalone in\n// this process otherwise. The exit code and the output are the command's; --envelope prints","numLines":170,"startLine":1,"totalLines":265}},"tool_result_meta":[{"id":"toolu_01RYHNKj1Gmw2FBHREMcxA6d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
