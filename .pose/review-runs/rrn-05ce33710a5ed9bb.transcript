{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014PduKnV2qQrSGVphDShgep","type":"tool_result","content":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"container/list\"\n     5\t\t\"crypto/sha256\"\n     6\t\t\"encoding/hex\"\n     7\t\t\"os\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strings\"\n    10\t\t\"sync\"\n    11\t\t\"sync/atomic\"\n    12\t)\n    13\t\n    14\t// ResidentGitMemo keeps, in a process that outlives one operation, the output of the Git reads\n    15\t// that are pure functions of object ids or of the commit HEAD named when they ran (see\n    16\t// governancePureGitRead). It is off unless a process turns it on, so nothing changes for a\n    17\t// command that runs once; the optional worktree runtime turns it on (spec\n    18\t// pose-worktree-runtime-resident-cache). A hit is the answer Git would give: the key\n    19\t// holds the commit and the shallow state, and the output of such a read cannot differ for them.\n    20\ttype ResidentGitMemo struct {\n    21\t\tmu      sync.Mutex\n    22\t\tmax     int64\n    23\t\tbytes   int64\n    24\t\tentries map[string]*list.Element\n    25\t\torder   *list.List // front is the most recently used\n    26\t\thits    atomic.Int64\n    27\t\tmisses  atomic.Int64\n    28\t}\n    29\t\n    30\ttype residentGitEntry struct {\n    31\t\tkey    string\n    32\t\tstdout []byte\n    33\t}\n    34\t\n    35\tvar residentGit atomic.Pointer[ResidentGitMemo]\n    36\t\n    37\t// EnableResidentGitMemo turns the memo on with a byte budget for what it retains.\n    38\tfunc EnableResidentGitMemo(maxBytes int64) *ResidentGitMemo {\n    39\t\tm := &ResidentGitMemo{max: maxBytes, entries: map[string]*list.Element{}, order: list.New()}\n    40\t\tresidentGit.Store(m)\n    41\t\treturn m\n    42\t}\n    43\t\n    44\t// DisableResidentGitMemo turns the memo off and drops what it held.\n    45\tfunc DisableResidentGitMemo() { residentGit.Store(nil) }\n    46\t\n    47\t// ResidentGitMemoStats are the hits, misses, entries and retained bytes since it was enabled.\n    48\tfunc ResidentGitMemoStats() (hits, misses int64, entries int, bytes int64) {\n    49\t\tm := residentGit.Load()\n    50\t\tif m == nil {\n    51\t\t\treturn 0, 0, 0, 0\n    52\t\t}\n    53\t\tm.mu.Lock()\n    54\t\tdefer m.mu.Unlock()\n    55\t\treturn m.hits.Load(), m.misses.Load(), len(m.entries), m.bytes\n    56\t}\n    57\t\n    58\t// residentGitKey names a read: the root, the commit it was made at (empty for a read by object\n    59\t// id), the shallow state of the repository and the exact command. A root whose Git directory\n    60\t// is not a plain .git directory is not memoized: its shallow state is not read here. The key\n    61\t// also holds the digest of the effective Git configuration of the root.\n    62\tfunc residentGitKey(root, head, config string, args []string) (string, bool) {\n    63\t\tif config == \"\" {\n    64\t\t\t// The effective Git configuration could not be read: nothing is memoized.\n    65\t\t\treturn \"\", false\n    66\t\t}\n    67\t\tgitDir := filepath.Join(root, \".git\")\n    68\t\tinfo, err := os.Lstat(gitDir)\n    69\t\tif err != nil || !info.IsDir() {\n    70\t\t\treturn \"\", false\n    71\t\t}\n    72\t\t// The shallow file and the repository config are small: their content, not a timestamp,\n    73\t\t// is part of the key.\n    74\t\tdigestOf := func(name string) string {\n    75\t\t\traw, err := os.ReadFile(filepath.Join(gitDir, name))\n    76\t\t\tif err != nil {\n    77\t\t\t\treturn \"-\"\n    78\t\t\t}\n    79\t\t\tsum := sha256.Sum256(raw)\n    80\t\t\treturn hex.EncodeToString(sum[:8])\n    81\t\t}\n    82\t\tshallow := digestOf(\"shallow\")\n    83\t\t// config is the digest of the effective Git configuration of the root (system, global, user,\n    84\t\t// repository, worktree and command-line scopes, includes followed): any of them can change\n    85\t\t// what a read answers (log.follow, for one), and the digest is taken once per operation.\n    86\t\treturn strings.Join([]string{filepath.Clean(root), head, shallow, config, strings.Join(args, \"\\x00\")}, \"\\x01\"), true\n    87\t}\n    88\t\n    89\tfunc (m *ResidentGitMemo) get(key string) ([]byte, bool) {\n    90\t\tm.mu.Lock()\n    91\t\tdefer m.mu.Unlock()\n    92\t\tel, ok := m.entries[key]\n    93\t\tif !ok {\n    94\t\t\tm.misses.Add(1)\n    95\t\t\treturn nil, false\n    96\t\t}\n    97\t\tm.order.MoveToFront(el)\n    98\t\tm.hits.Add(1)\n    99\t\treturn append([]byte(nil), el.Value.(*residentGitEntry).stdout...), true\n   100\t}\n   101\t\n   102\tfunc (m *ResidentGitMemo) put(key string, stdout []byte) {\n   103\t\tsize := int64(len(key) + len(stdout))\n   104\t\tm.mu.Lock()\n   105\t\tdefer m.mu.Unlock()\n   106\t\tif size > m.max {\n   107\t\t\treturn\n   108\t\t}\n   109\t\tif el, ok := m.entries[key]; ok {\n   110\t\t\tm.bytes -= int64(len(el.Value.(*residentGitEntry).key) + len(el.Value.(*residentGitEntry).stdout))\n   111\t\t\tm.order.Remove(el)\n   112\t\t\tdelete(m.entries, key)\n   113\t\t}\n   114\t\tfor m.bytes+size > m.max {\n   115\t\t\tlast := m.order.Back()\n   116\t\t\tif last == nil {\n   117\t\t\t\tbreak\n   118\t\t\t}\n   119\t\t\te := last.Value.(*residentGitEntry)\n   120\t\t\tm.bytes -= int64(len(e.key) + len(e.stdout))\n   121\t\t\tm.order.Remove(last)\n   122\t\t\tdelete(m.entries, e.key)\n   123\t\t}\n   124\t\tm.entries[key] = m.order.PushFront(&residentGitEntry{key: key, stdout: append([]byte(nil), stdout...)})\n   125\t\tm.bytes += size\n   126\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"a8fec288-2226-41bb-b571-500d423fb035","timestamp":"2026-11-10T21:59:24.869Z","tool_use_result":{"stdout":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"container/list\"\n     5\t\t\"crypto/sha256\"\n     6\t\t\"encoding/hex\"\n     7\t\t\"os\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strings\"\n    10\t\t\"sync\"\n    11\t\t\"sync/atomic\"\n    12\t)\n    13\t\n    14\t// ResidentGitMemo keeps, in a process that outlives one operation, the output of the Git reads\n    15\t// that are pure functions of object ids or of the commit HEAD named when they ran (see\n    16\t// governancePureGitRead). It is off unless a process turns it on, so nothing changes for a\n    17\t// command that runs once; the optional worktree runtime turns it on (spec\n    18\t// pose-worktree-runtime-resident-cache). A hit is the answer Git would give: the key\n    19\t// holds the commit and the shallow state, and the output of such a read cannot differ for them.\n    20\ttype ResidentGitMemo struct {\n    21\t\tmu      sync.Mutex\n    22\t\tmax     int64\n    23\t\tbytes   int64\n    24\t\tentries map[string]*list.Element\n    25\t\torder   *list.List // front is the most recently used\n    26\t\thits    atomic.Int64\n    27\t\tmisses  atomic.Int64\n    28\t}\n    29\t\n    30\ttype residentGitEntry struct {\n    31\t\tkey    string\n    32\t\tstdout []byte\n    33\t}\n    34\t\n    35\tvar residentGit atomic.Pointer[ResidentGitMemo]\n    36\t\n    37\t// EnableResidentGitMemo turns the memo on with a byte budget for what it retains.\n    38\tfunc EnableResidentGitMemo(maxBytes int64) *ResidentGitMemo {\n    39\t\tm := &ResidentGitMemo{max: maxBytes, entries: map[string]*list.Element{}, order: list.New()}\n    40\t\tresidentGit.Store(m)\n    41\t\treturn m\n    42\t}\n    43\t\n    44\t// DisableResidentGitMemo turns the memo off and drops what it held.\n    45\tfunc DisableResidentGitMemo() { residentGit.Store(nil) }\n    46\t\n    47\t// ResidentGitMemoStats are the hits, misses, entries and retained bytes since it was enabled.\n    48\tfunc ResidentGitMemoStats() (hits, misses int64, entries int, bytes int64) {\n    49\t\tm := residentGit.Load()\n    50\t\tif m == nil {\n    51\t\t\treturn 0, 0, 0, 0\n    52\t\t}\n    53\t\tm.mu.Lock()\n    54\t\tdefer m.mu.Unlock()\n    55\t\treturn m.hits.Load(), m.misses.Load(), len(m.entries), m.bytes\n    56\t}\n    57\t\n    58\t// residentGitKey names a read: the root, the commit it was made at (empty for a read by object\n    59\t// id), the shallow state of the repository and the exact command. A root whose Git directory\n    60\t// is not a plain .git directory is not memoized: its shallow state is not read here. The key\n    61\t// also holds the digest of the effective Git configuration of the root.\n    62\tfunc residentGitKey(root, head, config string, args []string) (string, bool) {\n    63\t\tif config == \"\" {\n    64\t\t\t// The effective Git configuration could not be read: nothing is memoized.\n    65\t\t\treturn \"\", false\n    66\t\t}\n    67\t\tgitDir := filepath.Join(root, \".git\")\n    68\t\tinfo, err := os.Lstat(gitDir)\n    69\t\tif err != nil || !info.IsDir() {\n    70\t\t\treturn \"\", false\n    71\t\t}\n    72\t\t// The shallow file and the repository config are small: their content, not a timestamp,\n    73\t\t// is part of the key.\n    74\t\tdigestOf := func(name string) string {\n    75\t\t\traw, err := os.ReadFile(filepath.Join(gitDir, name))\n    76\t\t\tif err != nil {\n    77\t\t\t\treturn \"-\"\n    78\t\t\t}\n    79\t\t\tsum := sha256.Sum256(raw)\n    80\t\t\treturn hex.EncodeToString(sum[:8])\n    81\t\t}\n    82\t\tshallow := digestOf(\"shallow\")\n    83\t\t// config is the digest of the effective Git configuration of the root (system, global, user,\n    84\t\t// repository, worktree and command-line scopes, includes followed): any of them can change\n    85\t\t// what a read answers (log.follow, for one), and the digest is taken once per operation.\n    86\t\treturn strings.Join([]string{filepath.Clean(root), head, shallow, config, strings.Join(args, \"\\x00\")}, \"\\x01\"), true\n    87\t}\n    88\t\n    89\tfunc (m *ResidentGitMemo) get(key string) ([]byte, bool) {\n    90\t\tm.mu.Lock()\n    91\t\tdefer m.mu.Unlock()\n    92\t\tel, ok := m.entries[key]\n    93\t\tif !ok {\n    94\t\t\tm.misses.Add(1)\n    95\t\t\treturn nil, false\n    96\t\t}\n    97\t\tm.order.MoveToFront(el)\n    98\t\tm.hits.Add(1)\n    99\t\treturn append([]byte(nil), el.Value.(*residentGitEntry).stdout...), true\n   100\t}\n   101\t\n   102\tfunc (m *ResidentGitMemo) put(key string, stdout []byte) {\n   103\t\tsize := int64(len(key) + len(stdout))\n   104\t\tm.mu.Lock()\n   105\t\tdefer m.mu.Unlock()\n   106\t\tif size > m.max {\n   107\t\t\treturn\n   108\t\t}\n   109\t\tif el, ok := m.entries[key]; ok {\n   110\t\t\tm.bytes -= int64(len(el.Value.(*residentGitEntry).key) + len(el.Value.(*residentGitEntry).stdout))\n   111\t\t\tm.order.Remove(el)\n   112\t\t\tdelete(m.entries, key)\n   113\t\t}\n   114\t\tfor m.bytes+size > m.max {\n   115\t\t\tlast := m.order.Back()\n   116\t\t\tif last == nil {\n   117\t\t\t\tbreak\n   118\t\t\t}\n   119\t\t\te := last.Value.(*residentGitEntry)\n   120\t\t\tm.bytes -= int64(len(e.key) + len(e.stdout))\n   121\t\t\tm.order.Remove(last)\n   122\t\t\tdelete(m.entries, e.key)\n   123\t\t}\n   124\t\tm.entries[key] = m.order.PushFront(&residentGitEntry{key: key, stdout: append([]byte(nil), stdout...)})\n   125\t\tm.bytes += size\n   126\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014PduKnV2qQrSGVphDShgep","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
