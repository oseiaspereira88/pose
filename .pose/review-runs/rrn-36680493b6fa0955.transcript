{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/doctor_commit_graph.go | sed -n '156,183p'; nl -ba pose-mcp/internal/cli/doctor_commit_graph_test.go | sed -n '400,432p'; git status --short; sed -n '1,45p' POSE.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/doctor_commit_graph.go | sed -n '156,183p'; nl -ba pose-mcp/internal/cli/doctor_commit_graph_test.go | sed -n '400,432p'; git status --short; sed -n '1,45p' POSE.md\"","aggregated_output":"   156\t// Git: commitGraph.changedPathsVersion, when set, overrides the deprecated\n   157\t// commitGraph.readChangedPaths.\n   158\tfunc commitGraphReadsDisabledBy(root string) string {\n   159\t\tget := func(kind, key string) (string, bool) {\n   160\t\t\tout, _, err := commitGraphGit(root, nil, \"config\", \"--type=\"+kind, \"--get\", key)\n   161\t\t\tvalue := strings.TrimSpace(out)\n   162\t\t\treturn value, err == nil && value != \"\"\n   163\t\t}\n   164\t\tif value, ok := get(\"bool\", \"core.commitGraph\"); ok && value == \"false\" {\n   165\t\t\treturn \"core.commitGraph=false\"\n   166\t\t}\n   167\t\tif value, ok := get(\"int\", \"commitGraph.changedPathsVersion\"); ok {\n   168\t\t\tswitch value {\n   169\t\t\tcase \"-1\", \"1\", \"2\":\n   170\t\t\t\treturn \"\"\n   171\t\t\tcase \"0\":\n   172\t\t\t\treturn \"commitGraph.changedPathsVersion=0\"\n   173\t\t\t}\n   174\t\t\t// Git reads no filters under a version it does not support, and a\n   175\t\t\t// rewrite keeps the setting (review F24).\n   176\t\t\treturn \"commitGraph.changedPathsVersion=\" + value + \" (unsupported)\"\n   177\t\t}\n   178\t\tif value, ok := get(\"bool\", \"commitGraph.readChangedPaths\"); ok && value == \"false\" {\n   179\t\t\treturn \"commitGraph.readChangedPaths=false\"\n   180\t\t}\n   181\t\treturn \"\"\n   182\t}\n   183\t\n   400\t\t\tt.Fatalf(\"following the shown command under maxNewFilters=0: %+v %v\", state, err)\n   401\t\t}\n   402\t}\n   403\t\n   404\t// Review F24: an unsupported commitGraph.changedPathsVersion keeps Git from\n   405\t// reading the filters; doctor names it instead of recommending a rewrite.\n   406\tfunc TestDoctorCommitGraphNamesAnUnsupportedVersion(t *testing.T) {\n   407\t\trepo := longHistoryRepo(t, nil)\n   408\t\tgitInRepo(t, repo, \"config\", \"commitGraph.changedPathsVersion\", \"3\")\n   409\t\tvar reads doctorFinding\n   410\t\tinDir(t, repo, func() {\n   411\t\t\tvar out, errB bytes.Buffer\n   412\t\t\tMain([]string{\"doctor\", \"--json\"}, &out, &errB)\n   413\t\t\tvar report doctorJSON\n   414\t\t\tif err := json.Unmarshal(out.Bytes(), &report); err != nil {\n   415\t\t\t\tt.Fatalf(\"invalid JSON: %v\", err)\n   416\t\t\t}\n   417\t\t\tfor _, f := range report.Findings {\n   418\t\t\t\tif f.Check == \"git.commit-graph\" {\n   419\t\t\t\t\tt.Errorf(\"a rewrite is recommended under an unsupported version: %+v\", f)\n   420\t\t\t\t}\n   421\t\t\t\tif f.Check == \"git.commit-graph-reads\" {\n   422\t\t\t\t\treads = f\n   423\t\t\t\t}\n   424\t\t\t}\n   425\t\t})\n   426\t\tif reads.Level != \"warn\" || !strings.Contains(reads.Message, \"commitGraph.changedPathsVersion=3\") {\n   427\t\t\tt.Fatalf(\"an unsupported changedPathsVersion: %+v\", reads)\n   428\t\t}\n   429\t}\n# POSE — Project Operating Standard for Engineering\n\n## 1) What it is\n\nPOSE is the operating standard for agent work in **{{PROJECT_NAME}}**.\n\nPrimary goals:\n\n- reduce ambiguity in tasks\n- improve execution predictability\n- make validation and reporting consistent\n- scale collaboration in a heterogeneous repository\n\nPOSE does **not** replace product architecture or existing security policies;\nit organizes how agents execute technical work.\n\nThe short agent contract lives in [`AGENTS.md`](AGENTS.md); this document is\nthe operating manual (structure, CLI, per-type flows, CI, governance).\n\n---\n\n## 2) Principles\n\n1. **Scope first**: read only the instructions and artifacts needed for the affected directories.\n2. **Plan before implementing**: non-trivial changes go through a spec/plan.\n3. **Incrementalism**: small, cohesive, auditable deliveries.\n4. **Deterministic validation**: prefer reproducible commands (`test`, `lint`, `typecheck`, `build`, contract/security checks).\n5. **Risk transparency**: always surface gaps and human-review points.\n\n---\n\n## 3) Structure\n\n```text\n.pose/\n  workflows/     # procedure per work type\n  templates/     # spec.md, roadmap.md, knowledge.md, changelog-fragment.md, doc-audit-report.md\n  rules/         # domain rules (cumulative)\n  knowledge/     # handoffs and notes with active governance\n  adr/           # architectural decisions\n  roadmaps/      # governed roadmaps (milestone DAGs)\n  changelogs/    # pending fragments plus immutable version archives/notes\n  releases/      # version manifests and append-only lifecycle evidence\n  indexes/       # repo-map, services, packages, validation-matrix, module-metadata, task-map, spec-graph, roadmaps\n  reports/       # versionable reports + history JSONL + archive/\n","exit_code":0,"status":"completed"}}
