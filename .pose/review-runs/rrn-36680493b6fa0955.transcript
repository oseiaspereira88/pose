ose/design_basis_test.go:32:func TestABMDesignBasisValidAndDigestStable(t *testing.T) {\npose-mcp/internal/pose/design_basis_test.go:62:func TestABMDesignBasisPortugueseAndFenceAreParsedSafely(t *testing.T) {\npose-mcp/internal/pose/design_basis_test.go:91:func TestABMDesignBasisNegativeReferencesAndStatuses(t *testing.T) {\npose-mcp/internal/pose/design_basis_test.go:122:func TestABMDesignBasisLocalEvidenceResolutionAndTraversal(t *testing.T) {\npose-mcp/internal/pose/design_basis_test.go:158:func TestABMDesignBasisLegacySpecIsNoop(t *testing.T) {\npose-mcp/internal/pose/design_basis_test.go:165:func hasDesignDiagnostic(report DesignBasisReport, code string) bool {\npose-mcp/internal/pose/design_delta.go:45:func (o DesignDeltaOptions) normalized() DesignDeltaOptions {\npose-mcp/internal/pose/design_delta.go:153:func defaultDesignDeltaDetectors() []string {\npose-mcp/internal/pose/design_delta.go:169:func AssessDesignDeltaIn(files Files, root string, subject ReviewBundleSubject, scope string, options DesignDeltaOptions) (DesignDeltaReport, error) {\npose-mcp/internal/pose/design_delta.go:210:\tassess := func() (DesignDeltaReport, int64, error) {\npose-mcp/internal/pose/design_delta.go:308:func AssessDesignDelta(root string, subject ReviewBundleSubject, scope string, options DesignDeltaOptions) (DesignDeltaReport, error) {\npose-mcp/internal/pose/design_delta.go:325:func copyDesignDeltaReport(in DesignDeltaReport) DesignDeltaReport { return deepCopyValue(in) }\npose-mcp/internal/pose/design_delta.go:327:func canonicalDesignDeltaSubject(subject ReviewBundleSubject) ReviewBundleSubject {\npose-mcp/internal/pose/design_delta.go:827:func (c *designDeltaCollector) detectorReports() []DesignDeltaDetector {\npose-mcp/internal/pose/design_delta.go:885:func normalizeDesignAction(action string) string {\npose-mcp/internal/pose/design_delta.go:898:func normalizeDesignPath(value string) string {\npose-mcp/internal/pose/design_delta.go:1016:func decodeDesignJSON(raw []byte, out *any) error {\ndiff --git a/pose-mcp/internal/cli/doctor_commit_graph.go b/pose-mcp/internal/cli/doctor_commit_graph.go\nindex 43f4591e..610f985a 100644\n--- a/pose-mcp/internal/cli/doctor_commit_graph.go\n+++ b/pose-mcp/internal/cli/doctor_commit_graph.go\n@@ -165,10 +165,15 @@ func commitGraphReadsDisabledBy(root string) string {\n \t\treturn \"core.commitGraph=false\"\n \t}\n \tif value, ok := get(\"int\", \"commitGraph.changedPathsVersion\"); ok {\n-\t\tif value == \"0\" {\n+\t\tswitch value {\n+\t\tcase \"-1\", \"1\", \"2\":\n+\t\t\treturn \"\"\n+\t\tcase \"0\":\n \t\t\treturn \"commitGraph.changedPathsVersion=0\"\n \t\t}\n-\t\treturn \"\"\n+\t\t// Git reads no filters under a version it does not support, and a\n+\t\t// rewrite keeps the setting (review F24).\n+\t\treturn \"commitGraph.changedPathsVersion=\" + value + \" (unsupported)\"\n \t}\n \tif value, ok := get(\"bool\", \"commitGraph.readChangedPaths\"); ok && value == \"false\" {\n \t\treturn \"commitGraph.readChangedPaths=false\"\ndiff --git a/pose-mcp/internal/cli/doctor_commit_graph_test.go b/pose-mcp/internal/cli/doctor_commit_graph_test.go\nindex 736dd64d..6d1dd10b 100644\n--- a/pose-mcp/internal/cli/doctor_commit_graph_test.go\n+++ b/pose-mcp/internal/cli/doctor_commit_graph_test.go\n@@ -400,3 +400,30 @@ func TestDoctorCommitGraphShowsTheEffectiveCommand(t *testing.T) {\n \t\tt.Fatalf(\"following the shown command under maxNewFilters=0: %+v %v\", state, err)\n \t}\n }\n+\n+// Review F24: an unsupported commitGraph.changedPathsVersion keeps Git from\n+// reading the filters; doctor names it instead of recommending a rewrite.\n+func TestDoctorCommitGraphNamesAnUnsupportedVersion(t *testing.T) {\n+\trepo := longHistoryRepo(t, nil)\n+\tgitInRepo(t, repo, \"config\", \"commitGraph.changedPathsVersion\", \"3\")\n+\tvar reads doctorFinding\n+\tinDir(t, repo, func() {\n+\t\tvar out, errB bytes.Buffer\n+\t\tMain([]string{\"doctor\", \"--json\"}, &out, &errB)\n+\t\tvar report doctorJSON\n+\t\tif err := json.Unmarshal(out.Bytes(), &report); err != nil {\n+\t\t\tt.Fatalf(\"invalid JSON: %v\", err)\n+\t\t}\n+\t\tfor _, f := range report.Findings {\n+\t\t\tif f.Check == \"git.commit-graph\" {\n+\t\t\t\tt.Errorf(\"a rewrite is recommended under an unsupported version: %+v\", f)\n+\t\t\t}\n+\t\t\tif f.Check == \"git.commit-graph-reads\" {\n+\t\t\t\treads = f\n+\t\t\t}\n+\t\t}\n+\t})\n+\tif reads.Level != \"warn\" || !strings.Contains(reads.Message, \"commitGraph.changedPathsVersion=3\") {\n+\t\tt.Fatalf(\"an unsupported changedPathsVersion: %+v\", reads)\n+\t}\n+}\n","exit_code":0,"status":"completed"}}
