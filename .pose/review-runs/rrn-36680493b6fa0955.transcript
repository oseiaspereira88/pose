{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\nimport json,subprocess,hashlib\np='.pose/indexes/validation-matrix.json'\ncommits=subprocess.check_output(['git','rev-list','--reverse','2bf2adf..50d984e','--',p],text=True).split()\nfor c in commits:\n before=subprocess.check_output(['git','show',c+'\"'^:'\"'+p]);after=subprocess.check_output(['git','show',c+':'+p])\n d=dict(zip(['Kind','Action','State','Subject','Path','OldPath','NewPath','Runtime','BeforeDigest','AfterDigest'],['delivery-metadata','changed','observed',p,p,'','','','sha256:'+hashlib.sha256(before).hexdigest(),'sha256:'+hashlib.sha256(after).hexdigest()]))\n h=hashlib.sha256(json.dumps(d,separators=(',',':')).encode()).hexdigest()[:8]\n print('SD-'+h,subprocess.check_output(['git','log','-1','--format=%h %s',c],text=True).strip())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
