54accec97babf7572a6d97343bff77586\\\\nprovenance_digest sha256:c0a7583ac24a30d1f59a6c20dbb39a3df02d27ab1a107fe583d3ca47caa9cf26\\\\nmaterial_provenance {'artifact-claims-stop-at-the-section-end': 'sha256:79e81bb7386693686262b2eb8e1555c7be0b0f559920654ec1ef6e298afaf24e', 'calendar-dates-tolerate-utc-stamping': 'sha256:c539629bcc88b7220229f362cf3200b28e92e4eaff87338aea4235682085c08d', 'check-builds-the-delivery-graph-once': 'sha256:55732ad83f0dc23d2d\\\\njobs 4\\\\nwall_seconds 448.398856596\\\\noutcome pass\\\\ncounts {'executed': 232, 'passed': 232, 'failed': 0, 'optional_failed': 0, 'errored': 0, 'skipped': 0}\\\\nchecks [{'id': 'mcp-enforce/go/build', 'module': 'mcp-enforce', 'stack': 'go', 'name': 'build', 'program': 'go', 'args': ['build', './...'], 'severity': 'required', 'evidence_class': 'build', 'outcome': 'pass', 'duration_seconds': 0.37627543}, {'id': 'mcp-enforce/go/test', 'module': 'mcp-enforce', 'stack':\\\\n// (--no-replace-objects) and grafts (GIT_GRAFT_FILE at the always-empty null\\\\n// device, which overrides both the repository's graft file and one the\\\\n// environment names) never change which commits carry a trailer, what a change\\\\n// set holds, or what a later removal is judged on (spec\\\\n// pose-delivery-later-removal R3, review round 4 LR-R4-01).\\\\nfunc RawHistoryGit(root string, args ...string) *exec.Cmd {\\\\n\\\\treturn gitCommand(append([]string{\\\\\\\"--no-replace-objects\\\\\\\", \\\\\\\"-C\\\\\\\", root}, args...)...)\\\\n}\\\\n\\\\n// RawHistoryGitContext is RawHistoryGit under ctx.\\\\nfunc RawHistoryGitContext(ctx context.Context, root string, args ...string) *exec.Cmd {\\\\n\\\\treturn gitCommandContext(ctx, append([]string{\\\\\\\"--no-replace-objects\\\\\\\", \\\\\\\"-C\\\\\\\", root}, args...)...)\\\\n}\\\\n\\\\n// GitHooksDir is the directory git runs the hooks of root from: a linked worktree shares the\\\\n// one of its common directory, and core.hooksPath moves it. Where git cannot answer it is\\\\n// `.git/hooks`, which is where a repository would keep them.\\\\nfunc GitHooksDir(root string) string {\\\\n\\\\tout, err := RawHistoryGit(root, \\\\\\\"rev-parse\\\\\\\", \\\\\\\"--git-path\\\\\\\", \\\\\\\"hooks\\\\\\\").Output()\\\\npose-mcp/internal/cli/doctor_commit_graph_test.go:25:\\\\t\\\\t\\\\tif f.Check == \\\\\\\"git.commit-graph\\\\\\\" {\\\\npose-mcp/internal/cli/doctor_commit_graph_test.go:31:\\\\t\\\\tt.Fatal(\\\\\\\"doctor reported no git.commit-graph check\\\\\\\")\\\\npose-mcp/internal/cli/doctor_commit_graph_test.go:46:\\\\tfor _, name := range []string{\\\\\\\"commit-graph\\\\\\\", \\\\\\\"commit-graphs\\\\\\\"} {\\\\npose-mcp/internal/cli/doctor_commit_graph_test.go:53:// Spec pose-doctor-recommends-the-commit-graph: R1 a long history Git walks\\\\npose-mcp/internal/cli/doctor_commit_graph_test.go:79:\\\\tif missing.Level != \\\\\\\"next\\\\\\\" || missing.FixCode != \\\\\\\"git.commit-graph\\\\\\\" || missing.RemediationClass != remediationFixable {\\\\npose-mcp/internal/cli/doctor_commit_graph_test.go:80:\\\\t\\\\tt.Fatalf(\\\\\\\"a long history without a commit-graph: %+v\\\\\\\", missing)\\\\npose-mcp/internal/cli/doctor_commit_graph_test.go:85:\\\\t\\\\tMain([]string{\\\\\\\"doctor\\\\\\\", \\\\\\\"--fix\\\\\\\", \\\\\\\"--yes\\\\\\\", \\\\\\\"--only\\\\\\\", \\\\\\\"git.commit-graph\\\\\\\"}, &out, &errB)\\\\npose-mcp/internal/cli/doctor_commit_graph_test.go:92:\\\\tgitInRepo(t, repo, \\\\\\\"commit-graph\\\\\\\", \\\\\\\"write\\\\\\\", \\\\\\\"--reachable\\\\\\\", \\\\\\\"--no-changed-paths\\\\\\\")\\\\npose-mcp/internal/cli/doctor_commit_graph_test.go:94:\\\\t\\\\tt.Fatalf(\\\\\\\"a commit-graph without changed-path filters is not recommended again: %+v\\\\\\\", plain)\\\\npose-mcp/internal/cli/doctor_commit_graph_test.go:98:\\\\tgitInRepo(t, repo, \\\\\\\"commit-graph\\\\\\\", \\\\\\\"write\\\\\\\", \\\\\\\"--reachable\\\\\\\", \\\\\\\"--changed-paths\\\\\\\", \\\\\\\"--split\\\\\\\")\\\\npose-mcp/internal/cli/doctor_commit_graph_test.go:100:\\\\t\\\\