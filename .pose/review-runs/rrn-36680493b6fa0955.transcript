   \\\"id\\\": \\\"R2\\\",\\n        \\\"kind\\\": \\\"requirement\\\",\\n        \\\"namespace\\\": \\\"spec:pose-doctor-recommends-the-commit-graph\\\",\\n        \\\"hash\\\": \\\"8debd2f8794b\\\",\\n        \\\"state\\\": \\\"active\\\"\\n      },\\n      {\\n        \\\"id\\\": \\\"R3\\\",\\n        \\\"kind\\\": \\\"requirement\\\",\\n        \\\"namespace\\\": \\\"spec:pose-doctor-recommends-the-commit-graph\\\",\\n        \\\"hash\\\": \\\"6cfd7456a968\\\",\\n        \\\"state\\\": \\\"active\\\"\\n      },\\n      {\\n        \\\"id\\\": \\\"R4\\\",\\n        \\\"kind\\\": \\\"requirement\\\",\\n        \\\"namespace\\\": \\\"spec:pose-doctor-recommends-the-commit-graph\\\",\\n        \\\"hash\\\": \\\"174fbee26629\\\",\\n        \\\"state\\\": \\\"active\\\"\\n      },\\n      {\\n        \\\"id\\\": \\\"D1\\\",\\n        \\\"kind\\\": \\\"decision\\\",\\n        \\\"namespace\\\": \\\"spec:pose-doctor-recommends-the-commit-graph\\\",\\n        \\\"hash\\\": \\\"adfabdf2a706\\\",\\n        \\\"state\\\": \\\"active\\\",\\n        \\\"relations\\\": [\\n          \\\"R1\\\",\\n          \\\"R2\\\",\\n          \\\"R3\\\"\\n        ]\\n      }\\n    ],\\n    \\\"digest\\\": \\\"sha256:b9eefa7635df57658731a6d38dab9430c1f96a5e54dda367c66005ade2a3f226\\\"\\n  },\\n  \\\"phase\\\": \\\"started\\\",\\n  \\\"recorded_at\\\": \\\"2026-11-16T15:10:36Z\\\"\\n}\\ntype dict\\n{'schema_version': 1, 'generated_at': '2026-11-16T22:17:24Z', 'mode': 'strict', 'git_head': '817421b18e46cc57922089c6212d148d21f404a4', 'matrix_sha256': 'sha256:27c8dfaabe823b4f552b6280a149d6154accec97babf7572a6d97343bff77586', 'provenance_digest': 'sha256:c0a7583ac24a30d1f59a6c20dbb39a3df02d27ab1a107fe583d3ca47caa9cf26', 'scope_provenance': {'artifact-claims-stop-at-the-section-end': 'sha256:c0083ea34012c3ec78814d53d3bdb83918132e90f23fee8ff51903aee8672622', 'calendar-dates-tolerate-utc-stamping': 'sha256:36f9125ec27177733affb1bfac1d5dddc2a61a6e2bddbabca5207aad9946e5d6', 'check-builds-the-delivery