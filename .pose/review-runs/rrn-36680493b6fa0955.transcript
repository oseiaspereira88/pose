{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '65,105p' pose-mcp/internal/pose/spec_trailers.go; rg -n 'error |undeclared|missing|artifact\\\\.(claims|observed|findings)|commit_graph|doctor.go|validation-matrix' /var/tmp/closeout/ac-dc.out; rg -n 'SD-28db7861|SD-9fc0fe4e|SD-d29398e6' .pose/assessments .pose/review-bundles; rg -n 'fetch-depth|gates|commit-graph' .github/workflows/ci.yml; sed -n '1,110p' pose-mcp/internal/cli/doctor.go; rg -n 'runDoctorDiagnostics|fix.apply|\\\\.apply\\\\(' pose-mcp/internal/cli/doctor.go\"","aggregated_output":"\t}\n\treturn specCommits\n}\n\n// RawHistoryGit is a git command on root's raw object history: replace refs\n// (--no-replace-objects) and grafts (GIT_GRAFT_FILE at the always-empty null\n// device, which overrides both the repository's graft file and one the\n// environment names) never change which commits carry a trailer, what a change\n// set holds, or what a later removal is judged on (spec\n// pose-delivery-later-removal R3, review round 4 LR-R4-01).\nfunc RawHistoryGit(root string, args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// RawHistoryGitContext is RawHistoryGit under ctx.\nfunc RawHistoryGitContext(ctx context.Context, root string, args ...string) *exec.Cmd {\n\treturn gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// GitHooksDir is the directory git runs the hooks of root from: a linked worktree shares the\n// one of its common directory, and core.hooksPath moves it. Where git cannot answer it is\n// `.git/hooks`, which is where a repository would keep them.\nfunc GitHooksDir(root string) string {\n\tout, err := RawHistoryGit(root, \"rev-parse\", \"--git-path\", \"hooks\").Output()\n\tif err != nil {\n\t\treturn filepath.Join(root, \".git\", \"hooks\")\n\t}\n\tdir := strings.TrimSuffix(string(out), \"\\n\")\n\tif filepath.IsAbs(dir) {\n\t\treturn dir\n\t}\n\treturn filepath.Join(root, dir)\n}\n\n// RawGit is RawHistoryGit for a caller whose arguments already say where to read.\nfunc RawGit(args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\"}, args...)...)\n}\n\n// SpecTrailerCommits reads the history of root and returns the commits that carry the trailer of\n// slug, the way the attribution of change sets does. An error is a history that could not be\n7:artifact.claims=5\n8:artifact.observed=76\n9:artifact.findings=975\n373:[!] warning orphan pose-mcp/internal/cli/doctor_governance_residuals_test.go\n1183:[!] warning orphan pose-mcp/internal/pose/missing_change_set_test.go\n2686:[!] warning orphan pose-mcp/internal/cli/closeout_names_missing_trailer_test.go\n.pose/review-bundles/rvb-b5149e7feaba9233.json:656:            \"id\": \"SD-9fc0fe4e\",\n.pose/review-bundles/rvb-47afa168dcbc1bec.json:662:            \"id\": \"SD-9fc0fe4e\",\n.pose/review-bundles/rvb-47afa168dcbc1bec.json:669:            \"id\": \"SD-d29398e6\",\n.pose/review-bundles/rvb-dab8d0ff3a0a8d27.json:662:            \"id\": \"SD-9fc0fe4e\",\n.pose/review-bundles/rvb-dab8d0ff3a0a8d27.json:669:            \"id\": \"SD-d29398e6\",\n.pose/review-bundles/rvb-82a87889d85ce8dd.json:662:            \"id\": \"SD-9fc0fe4e\",\n.pose/review-bundles/rvb-82a87889d85ce8dd.json:669:            \"id\": \"SD-d29398e6\",\n.pose/review-bundles/rvb-7ca908656df46d52.json:668:            \"id\": \"SD-28db7861\",\n.pose/review-bundles/rvb-7ca908656df46d52.json:675:            \"id\": \"SD-9fc0fe4e\",\n.pose/review-bundles/rvb-7ca908656df46d52.json:682:            \"id\": \"SD-d29398e6\",\n.pose/review-bundles/rvb-629ea8d310ca6c99.json:668:            \"id\": \"SD-28db7861\",\n.pose/review-bundles/rvb-629ea8d310ca6c99.json:675:            \"id\": \"SD-9fc0fe4e\",\n.pose/review-bundles/rvb-629ea8d310ca6c99.json:682:            \"id\": \"SD-d29398e6\",\n8:  # green (spec release-runs-the-ci-gates).\n15:      # fetch-depth: 0 is load-bearing here too. The cross-version test builds\n20:        with: { fetch-depth: 0 }\n22:      # artifact; on the full history each lookup walks it. The commit-graph\n24:      # lookup; spec pose-doctor-recommends-the-commit-graph).\n25:      - name: Write the Git commit-graph with changed-path filters\n26:        run: git commit-graph write --reachable --changed-paths\n31:        # cross-version test needs — the promise the fetch-depth above keeps.\n42:        # after the expensive gates have already run\n112:    # must pass its own structural/validation gates with an explicitly\n116:      # fetch-depth: 0 is load-bearing, not hygiene. The delivery contract\n125:        with: { fetch-depth: 0 }\n127:      # artifact; on the full history each lookup walks it. The commit-graph\n129:      # lookup; spec pose-doctor-recommends-the-commit-graph).\n130:      - name: Write the Git commit-graph with changed-path filters\n131:        run: git commit-graph write --reachable --changed-paths\npackage cli\n\n// pose doctor — installation and instance diagnostics (spec pose-doctor,\n// pose-doctor-guided-remediation). Diagnosis is always read-only; mutation\n// only happens under --fix, defaults to a dry-run preview, and requires\n// --yes to actually apply — never silently.\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"io/fs\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/scaffold\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n)\n\n// doctorSchemaVersion versions doctor's own JSON output shape (distinct\n// from the POSE instance schema-version). Existing fields are never\n// renamed or removed across versions — only added — so consumers pinned to\n// v1 keep working; bump this only for a genuinely breaking shape change.\n// Version 2 added the \"next\" level and the \"next_steps\" count (spec\n// pose-fresh-install-doctor-is-clean).\nconst doctorSchemaVersion = 2\n\n// remediationClass distinguishes what an operator (or an automated caller)\n// can do about a finding (spec pose-doctor-guided-remediation R2):\n//   - \"n/a\": informational, level is ok.\n//   - \"fixable\": pose itself can apply a confined, reversible fix via\n//     `pose doctor --fix`.\n//   - \"detectable\": diagnosed with a concrete hint, but the fix is outside\n//     doctor's confined-mutation scope (e.g. `pose upgrade`, a manual\n//     `pose install`) and must be run explicitly by the operator.\n//   - \"blocked\": outside POSE's control entirely (missing external tool).\nconst (\n\tremediationNA         = \"n/a\"\n\tremediationFixable    = \"fixable\"\n\tremediationDetectable = \"detectable\"\n\tremediationBlocked    = \"blocked\"\n)\n\ntype doctorFinding struct {\n\tCheck             string `json:\"check\"`\n\tLevel             string `json:\"level\"` // ok | next | warn | error\n\tMessage           string `json:\"message\"`\n\tHint              string `json:\"hint,omitempty\"`\n\tEvidence          string `json:\"evidence,omitempty\"`\n\tRemediationClass  string `json:\"remediation_class\"`\n\tFixCode           string `json:\"fix_code,omitempty\"`\n\tDiagnosticScope   string `json:\"diagnostic_scope,omitempty\"`\n\tConnectionChecked *bool  `json:\"connection_checked,omitempty\"`\n}\n\n// doctorFix is a confined, reversible, idempotent remediation action. Every\n// entry here is safe to apply blind (no destructive or irreversible\n// operation, never touches instance content) — that confinement is what\n// lets `pose doctor --fix --yes` apply it without per-action confirmation\n// once the operator has already opted into --yes.\ntype doctorFix struct {\n\tdescribe string\n\tapply    func(root string) error\n}\n\nvar doctorFixRegistry = map[string]doctorFix{\n\t\"hooks.pre-commit\": {\n\t\tdescribe: \"install the pre-commit hook (pose hooks install)\",\n\t\tapply: func(root string) error {\n\t\t\tvar out, errB bytes.Buffer\n\t\t\tif code := cmdHooks(root, []string{\"install\"}, &out, &errB); code != 0 {\n\t\t\t\treturn fmt.Errorf(\"%s\", strings.TrimSpace(errB.String()))\n\t\t\t}\n\t\t\treturn nil\n\t\t},\n\t},\n\t\"mcp.config\": {\n\t\tdescribe: \"regenerate .mcp.json to point at the native pose binary\",\n\t\tapply: func(root string) error {\n\t\t\tprojectID := posemodel.DefaultProjectID(root)\n\t\t\t_, err := configureMCP(filepath.Join(root, \".mcp.json\"), root, projectID)\n\t\t\treturn err\n\t\t},\n\t},\n\t\"git.commit-graph\": {\n\t\tdescribe: \"write the Git commit-graph with changed-path filters (git commit-graph write --reachable --changed-paths --max-new-filters=-1)\",\n\t\tapply:    writeCommitGraph,\n\t},\n\t\"skills.symlinks\": {\n\t\tdescribe: \"recreate .claude/skills symlinks\",\n\t\tapply: func(root string) error {\n\t\t\tlinked, err := recreateClaudeSkillSymlinks(root)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif !linked {\n\t\t\t\treturn fmt.Errorf(\"filesystem does not support symlinks\")\n\t\t\t}\n\t\t\treturn nil\n\t\t},\n\t},\n}\n189:\troot, findings := runDoctorDiagnostics(locale)\n219:// runDoctorDiagnostics is the read-only diagnostic pass, factored out so\n221:func runDoctorDiagnostics(locale cliLocale) (root string, findings []doctorFinding) {\n1524:\t\tif err := doctorFixRegistry[c].apply(root); err != nil {\n1531:\t_, after := runDoctorDiagnostics(locale)\n","exit_code":0,"status":"completed"}}
