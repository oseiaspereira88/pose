{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc \"cat pose-mcp/internal/cli/doctor_commit_graph.go; git diff 2bf2adf..50d984e -- pose-mcp/internal/cli/doctor.go .github/workflows/ci.yml .pose/indexes/validation-matrix.json; rg --files -g AGENTS.md -g '*commit-graph*' .pose/knowledge pose-mcp .github\"","aggregated_output":"package cli\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strconv\"\n\t\"strings\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\n// commitGraphHistoryThreshold is the history size from which a last-commit\n// lookup by path is worth accelerating: below it a history walk costs a few\n// milliseconds (spec pose-doctor-recommends-the-commit-graph).\nvar commitGraphHistoryThreshold = 500\n\n// errCommitGraphNotApplicable marks a root the check does not apply to: not\n// a Git repository, an unborn HEAD, a shallow history (Git neither reads nor\n// writes a commit-graph across a shallow boundary), or a HEAD with no file to\n// look up.\nvar errCommitGraphNotApplicable = errors.New(\"not a repository whose last-commit lookups a commit-graph can answer\")\n\n// commitGraphState is what doctor knows about a repository's commit-graph.\ntype commitGraphState struct {\n\tcommits int\n\t// filtersUsed is Git's own answer: a last-commit lookup by path read\n\t// changed-path Bloom filters from the commit-graph it loaded.\n\tfiltersUsed bool\n\t// readsDisabledBy names the configuration that keeps Git from reading\n\t// the filters, when the lookup used none.\n\treadsDisabledBy string\n}\n\n// readCommitGraphState counts HEAD's history and asks Git whether a\n// last-commit lookup by path uses changed-path Bloom filters. Git reports the\n// filters it consulted in its trace2 \"bloom\" statistics, so whichever graph it\n// loads (the object directory's or an alternate's, a single file or a chain,\n// of any version it accepts) is judged as Git itself uses it. It only reads,\n// and never fetches: lazy fetching is off, so a partial clone reports the\n// objects it lacks instead of contacting its remote.\nfunc readCommitGraphState(root string) (commitGraphState, error) {\n\tif _, _, err := commitGraphGit(root, nil, \"rev-parse\", \"--git-dir\"); err != nil {\n\t\tif strings.Contains(err.Error(), \"not a git repository\") {\n\t\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n\t\t}\n\t\treturn commitGraphState{}, fmt.Errorf(\"repository could not be opened: %w\", err)\n\t}\n\t// An unborn HEAD names a branch that does not resolve; a HEAD that\n\t// resolves to a commit Git cannot read is a failure.\n\tif _, _, err := commitGraphGit(root, nil, \"rev-parse\", \"--verify\", \"--quiet\", \"HEAD\"); err != nil {\n\t\tvar exit *exec.ExitError\n\t\tif errors.As(err, &exit) && exit.ExitCode() == 1 {\n\t\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n\t\t}\n\t\treturn commitGraphState{}, fmt.Errorf(\"HEAD could not be read: %w\", err)\n\t}\n\tif _, _, err := commitGraphGit(root, nil, \"rev-parse\", \"--verify\", \"HEAD^{commit}\"); err != nil {\n\t\treturn commitGraphState{}, fmt.Errorf(\"HEAD could not be read: %w\", err)\n\t}\n\tshallow, _, err := commitGraphGit(root, nil, \"rev-parse\", \"--is-shallow-repository\")\n\tif err != nil {\n\t\treturn commitGraphState{}, fmt.Errorf(\"repository depth could not be read: %w\", err)\n\t}\n\tif strings.TrimSpace(shallow) == \"true\" {\n\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n\t}\n\t// A HEAD without files has nothing to look up, whatever its history\n\t// (review F22).\n\tlisting, _, err := commitGraphGit(root, nil, \"ls-tree\", \"-r\", \"--name-only\", \"-z\", \"HEAD\")\n\tif err != nil {\n\t\treturn commitGraphState{}, fmt.Errorf(\"files of HEAD could not be listed: %w\", err)\n\t}\n\tpath, _, _ := strings.Cut(listing, \"\\x00\")\n\tif path == \"\" {\n\t\treturn commitGraphState{}, errCommitGraphNotApplicable\n\t}\n\tcount, countStderr, err := commitGraphGit(root, nil, \"rev-list\", \"--count\", \"HEAD\")\n\tif err != nil {\n\t\treturn commitGraphState{}, fmt.Errorf(\"history of HEAD could not be counted: %w\", err)\n\t}\n\t// Git falls back to a plain walk when its commit-graph cannot be read,\n\t// and says so on stderr while it succeeds, at any history size (review\n\t// F21).\n\tif countStderr != \"\" {\n\t\treturn commitGraphState{}, fmt.Errorf(\"Git reported a problem while reading history: %s\", countStderr)\n\t}\n\tcommits, err := strconv.Atoi(strings.TrimSpace(count))\n\tif err != nil {\n\t\treturn commitGraphState{}, fmt.Errorf(\"history of HEAD could not be counted: %w\", err)\n\t}\n\tstate := commitGraphState{commits: commits}\n\tif commits < commitGraphHistoryThreshold {\n\t\treturn state, nil\n\t}\n\ttrace, err := os.CreateTemp(\"\", \"pose-doctor-trace2-*.json\")\n\tif err != nil {\n\t\treturn state, fmt.Errorf(\"Git trace could not be created: %w\", err)\n\t}\n\ttracePath := trace.Name()\n\ttrace.Close()\n\tdefer os.Remove(tracePath)\n\t// The path is literal: a name with pathspec magic must not change what\n\t// Git looks up.\n\t_, stderr, err := commitGraphGit(root, []string{\"GIT_TRACE2_EVENT=\" + tracePath, \"GIT_LITERAL_PATHSPECS=1\"}, \"log\", \"-1\", \"--format=%H\", \"--\", path)\n\tif err != nil {\n\t\treturn state, fmt.Errorf(\"last commit of a file could not be read: %w\", err)\n\t}\n\t// Git falls back to a plain walk when its commit-graph cannot be read,\n\t// and says so on stderr while it succeeds.\n\tif stderr != \"\" {\n\t\treturn state, fmt.Errorf(\"Git reported a problem while reading history: %s\", stderr)\n\t}\n\traw, err := os.ReadFile(tracePath)\n\tif err != nil {\n\t\treturn state, fmt.Errorf(\"Git trace could not be read: %w\", err)\n\t}\n\tstate.filtersUsed = traceUsedBloomFilters(raw)\n\tif !state.filtersUsed {\n\t\tstate.readsDisabledBy = commitGraphReadsDisabledBy(root)\n\t}\n\treturn state, nil\n}\n\n// traceUsedBloomFilters reports whether a trace2 event stream carries a\n// \"bloom\" statistics event in which some filter answered a lookup.\nfunc traceUsedBloomFilters(raw []byte) bool {\n\tscanner := bufio.NewScanner(bytes.NewReader(raw))\n\tscanner.Buffer(make([]byte, 0, 64<<10), 1<<20)\n\tfor scanner.Scan() {\n\t\tvar event struct {\n\t\t\tCategory string `json:\"category\"`\n\t\t\tKey      string `json:\"key\"`\n\t\t\tValue    struct {\n\t\t\t\tMaybe         int `json:\"maybe\"`\n\t\t\t\tDefinitelyNot int `json:\"definitely_not\"`\n\t\t\t} `json:\"value\"`\n\t\t}\n\t\tif json.Unmarshal(scanner.Bytes(), &event) != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif event.Category == \"bloom\" && event.Key == \"statistics\" && event.Value.Maybe+event.Value.DefinitelyNot > 0 {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// commitGraphReadsDisabledBy names the configuration that keeps Git from\n// reading a commit-graph or its changed-path filters, or \"\" when none does:\n// with it set, writing the graph cannot change the answer. Precedence follows\n// Git: commitGraph.changedPathsVersion, when set, overrides the deprecated\n// commitGraph.readChangedPaths.\nfunc commitGraphReadsDisabledBy(root string) string {\n\tget := func(kind, key string) (string, bool) {\n\t\tout, _, err := commitGraphGit(root, nil, \"config\", \"--type=\"+kind, \"--get\", key)\n\t\tvalue := strings.TrimSpace(out)\n\t\treturn value, err == nil && value != \"\"\n\t}\n\tif value, ok := get(\"bool\", \"core.commitGraph\"); ok && value == \"false\" {\n\t\treturn \"core.commitGraph=false\"\n\t}\n\tif value, ok := get(\"int\", \"commitGraph.changedPathsVersion\"); ok {\n\t\tswitch value {\n\t\tcase \"-1\", \"1\", \"2\":\n\t\t\treturn \"\"\n\t\tcase \"0\":\n\t\t\treturn \"commitGraph.changedPathsVersion=0\"\n\t\t}\n\t\t// Git reads no filters under a version it does not support, and a\n\t\t// rewrite keeps the setting (review F24).\n\t\treturn \"commitGraph.changedPathsVersion=\" + value + \" (unsupported)\"\n\t}\n\tif value, ok := get(\"bool\", \"commitGraph.readChangedPaths\"); ok && value == \"false\" {\n\t\treturn \"commitGraph.readChangedPaths=false\"\n\t}\n\treturn \"\"\n}\n\n// commitGraphWriteCommand is the command doctor shows and runs: filters for\n// every commit, whatever commitGraph.maxNewFilters says.\nconst commitGraphWriteCommand = \"git commit-graph write --reachable --changed-paths --max-new-filters=-1\"\n\n// writeCommitGraph writes the repository's commit-graph with changed-path\n// Bloom filters for every commit, whatever commitGraph.maxNewFilters says;\n// it only writes under the Git object directory.\nfunc writeCommitGraph(root string) error {\n\t_, _, err := commitGraphGit(root, nil, strings.Fields(strings.TrimPrefix(commitGraphWriteCommand, \"git \"))...)\n\treturn err\n}\n\n// commitGraphGit runs Git in root, without lazy fetching and in the C\n// locale, with extra environment; it returns stdout and stderr, and a\n// failure carries the stderr, bounded.\nfunc commitGraphGit(root string, env []string, args ...string) (string, string, error) {\n\tcmd := posemodel.RawHistoryGit(root, args...)\n\t// Git's messages are read below; they are read in the C locale. A\n\t// diagnostic never contacts a remote.\n\tcmd.Env = append(append(cmd.Env, \"LC_ALL=C\", \"LANGUAGE=C\", \"GIT_NO_LAZY_FETCH=1\"), env...)\n\tvar stderr bytes.Buffer\n\tcmd.Stderr = &stderr\n\tout, err := cmd.Output()\n\tdetail := strings.TrimSpace(stderr.String())\n\tif len(detail) > 200 {\n\t\tdetail = detail[:200] + \"…\"\n\t}\n\tif err != nil {\n\t\treturn string(out), detail, &commitGraphGitError{args: args[0], err: err, detail: detail}\n\t}\n\treturn string(out), detail, nil\n}\n\n// commitGraphGitError is a failed Git command with its stderr, bounded; it\n// unwraps to the command's error, an *exec.ExitError when Git ran.\ntype commitGraphGitError struct {\n\targs   string\n\terr    error\n\tdetail string\n}\n\nfunc (e *commitGraphGitError) Error() string {\n\tif e.detail == \"\" {\n\t\treturn \"git \" + e.args + \" \" + e.err.Error()\n\t}\n\treturn \"git \" + e.args + \": \" + e.err.Error() + \" \" + e.detail\n}\n\nfunc (e *commitGraphGitError) Unwrap() error { return e.err }\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\nindex 8512af6c..cdebba85 100644\n--- a/.github/workflows/ci.yml\n+++ b/.github/workflows/ci.yml\n@@ -18,6 +18,12 @@ jobs:\n       # runner where it matters (spec pose-release-boundary-rehearsal).\n       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n         with: { fetch-depth: 0 }\n+      # Governance reads ask Git for the last commit that touched each\n+      # artifact; on the full history each lookup walks it. The commit-graph\n+      # with changed-path filters answers from the filters (47 ms -> 2 ms a\n+      # lookup; spec pose-doctor-recommends-the-commit-graph).\n+      - name: Write the Git commit-graph with changed-path filters\n+        run: git commit-graph write --reachable --changed-paths\n       - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n         with: { go-version: \"1.26.10\", cache: true, cache-dependency-path: pose-mcp/go.mod }\n       - name: Go tests (engine drift guard included)\n@@ -117,6 +123,12 @@ jobs:\n       # exactly this reason, reporting a governance defect that did not exist.\n       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n         with: { fetch-depth: 0 }\n+      # Governance reads ask Git for the last commit that touched each\n+      # artifact; on the full history each lookup walks it. The commit-graph\n+      # with changed-path filters answers from the filters (47 ms -> 2 ms a\n+      # lookup; spec pose-doctor-recommends-the-commit-graph).\n+      - name: Write the Git commit-graph with changed-path filters\n+        run: git commit-graph write --reachable --changed-paths\n       - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n         with: { go-version: \"1.26.10\", cache: true, cache-dependency-path: pose-mcp/go.mod }\n       - name: Build development pose binary\ndiff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex 966572c1..d6c44230 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2419,10 +2419,31 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"read-view-audit-repeats-a-read-under-its-own-time-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestReadViewAudit|TestAuditTimeoutIsTheTimeTheReadHad\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n+        {\n+          \"name\": \"git-snapshot-budget-scales-with-the-tree-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestGitSnapshotBudget|TestReviewWorktreeCleanup|TestGitTreeListingIsBounded|TestGovernedTreeListingIsBounded\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n+        {\n+          \"name\": \"doctor-recommends-the-commit-graph-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\"test\", \"./internal/cli\", \"-run\", \"TestDoctorRecommendsTheCommitGraph|TestDoctorCommitGraph\", \"-count=1\"],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"review-ledger-is-read-once-per-operation-integration\",\n           \"program\": \"go\",\n-          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestReviewLedgerIsReadOncePerOperation|TestReviewLedgerWithoutAnOperationIsReadEveryTime|TestReviewLedgerMemoAnswersAsAFreshRead|TestReviewLedgerMemoComputesOnceForConcurrentMisses|TestReviewLedgerMemoGivesIsolatedCopies|TestCopyReviewRunsCoversEveryUnexportedField\", \"-count=1\"],\n+          \"args\": [\"test\", \"./internal/pose\", \"-run\", \"TestReviewLedgerIsReadOncePerOperation|TestReviewLedgerWithoutAnOperationIsReadEveryTime|TestReviewLedgerMemoAnswersAsAFreshRead|TestReviewLedgerMemoComputesOnceForConcurrentMisses|TestReviewLedgerMemoGivesIsolatedCopies|TestCopyReviewRunsCoversEveryUnexportedField|TestReviewLedgerMemoIsNotServedAfterTheOperationEnds|TestReviewLedgerMemoRefusalsStayVisible|TestReviewLedgerMemoAttributesEveryConsumingProducer\", \"-count=1\"],\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\ndiff --git a/pose-mcp/internal/cli/doctor.go b/pose-mcp/internal/cli/doctor.go\nindex d091206a..0c5c485f 100644\n--- a/pose-mcp/internal/cli/doctor.go\n+++ b/pose-mcp/internal/cli/doctor.go\n@@ -9,6 +9,7 @@ import (\n \t\"bytes\"\n \t\"context\"\n \t\"encoding/json\"\n+\t\"errors\"\n \t\"fmt\"\n \t\"io\"\n \t\"io/fs\"\n@@ -89,6 +90,10 @@ var doctorFixRegistry = map[string]doctorFix{\n \t\t\treturn err\n \t\t},\n \t},\n+\t\"git.commit-graph\": {\n+\t\tdescribe: \"write the Git commit-graph with changed-path filters (git commit-graph write --reachable --changed-paths --max-new-filters=-1)\",\n+\t\tapply:    writeCommitGraph,\n+\t},\n \t\"skills.symlinks\": {\n \t\tdescribe: \"recreate .claude/skills symlinks\",\n \t\tapply: func(root string) error {\n@@ -355,6 +360,25 @@ func runDoctorDiagnostics(locale cliLocale) (root string, findings []doctorFindi\n \t\tadd(\"hooks.pre-commit\", \"ok\", text(\"pre-commit hook installed\", \"pre-commit instalado\"), \"\")\n \t}\n \n+\t// 7b. Git commit-graph. Governance reads ask Git for the last commit that\n+\t// touched each artifact; on a long history each lookup walks it, and a\n+\t// commit-graph with changed-path filters answers it from the filters\n+\t// (spec pose-doctor-recommends-the-commit-graph).\n+\tgraph, graphErr := readCommitGraphState(root)\n+\tswitch {\n+\tcase errors.Is(graphErr, errCommitGraphNotApplicable):\n+\tcase graphErr != nil:\n+\t\tadd(\"git.commit-graph\", \"warn\", text(\"Git commit-graph state could not be read: \"+graphErr.Error(), \"estado do commit-graph do Git não pôde ser lido: \"+graphErr.Error()), text(\"check that the repository and its object directory are readable\", \"confira se o repositório e o diretório de objetos podem ser lidos\"))\n+\tcase graph.commits < commitGraphHistoryThreshold:\n+\t\tadd(\"git.commit-graph\", \"ok\", text(fmt.Sprintf(\"history of %d commits does not need a commit-graph\", graph.commits), fmt.Sprintf(\"histórico de %d commits não precisa de commit-graph\", graph.commits)), \"\")\n+\tcase graph.readsDisabledBy != \"\":\n+\t\tadd(\"git.commit-graph-reads\", \"warn\", text(fmt.Sprintf(\"Git configuration %s keeps last-commit lookups over a history of %d commits from reading changed-path filters\", graph.readsDisabledBy, graph.commits), fmt.Sprintf(\"a configuração %s do Git impede que a busca do último commit, num histórico de %d commits, leia os filtros de caminhos alterados\", graph.readsDisabledBy, graph.commits)), text(\"unset that setting (git config --unset), then run 'git commit-graph write --reachable --changed-paths --max-new-filters=-1'\", \"remova essa configuração (git config --unset) e rode 'git commit-graph write --reachable --changed-paths --max-new-filters=-1'\"))\n+\tcase graph.filtersUsed:\n+\t\tadd(\"git.commit-graph\", \"ok\", text(\"Git answers last-commit lookups from changed-path filters\", \"o Git responde a busca do último commit pelos filtros de caminhos alterados\"), \"\")\n+\tdefault:\n+\t\tadd(\"git.commit-graph\", \"next\", text(fmt.Sprintf(\"history of %d commits is walked whole by each last-commit lookup: Git has no commit-graph with changed-path filters\", graph.commits), fmt.Sprintf(\"histórico de %d commits percorrido inteiro a cada busca do último commit: o Git não tem commit-graph com filtros de caminhos alterados\", graph.commits)), text(\"run 'git commit-graph write --reachable --changed-paths --max-new-filters=-1' (or 'pose doctor --fix --yes')\", \"rode 'git commit-graph write --reachable --changed-paths --max-new-filters=-1' (ou 'pose doctor --fix --yes')\"))\n+\t}\n+\n \t// 8. Delivery-integrity / artifact-contract policy roots (issue #17): a\n \t// v1.2.0 `pose install`/`pose update --force` could seed\n \t// .pose/policy/{delivery,artifacts}.json with roots copied verbatim from\npose-mcp/internal/scaffold/dist/AGENTS.md\npose-mcp/internal/scaffold/dist/locales/pt-BR/AGENTS.md\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '45,135p' .pose/specs/2026-11-16-pose-doctor-recommends-the-commit-graph.md; cat pose-mcp/internal/cli/doctor_commit_graph_test.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '45,135p' .pose/specs/2026-11-16-pose-doctor-recommends-the-commit-graph.md; cat pose-mcp/internal/cli/doctor_commit_graph_test.go\"","aggregated_output":"### Non-functional\n- A verificação roda três comandos Git de leitura e uma busca do último commit de um arquivo com o trace2 ligado.\n\n### Security\n- A correção roda o Git com argumentos fixos no root do projeto; nenhuma entrada do usuário entra no comando.\n\n### Compatibility\n- Saída do `doctor` ganha um check novo; o formato do relatório não muda.\n\n---\n\n## 3. Technical Plan\n\n### Affected areas\n- `cli/doctor.go`: o check `git.commit-graph` e a entrada no registro de correções.\n- `cli/doctor_commit_graph.go`: a contagem do histórico e a pergunta ao Git, pelo trace2, se ele usa os filtros.\n- `.github/workflows/ci.yml`: o passo que escreve o commit-graph.\n\n### Artifacts\n- created: pose-mcp/internal/cli/doctor_commit_graph.go\n- created: pose-mcp/internal/cli/doctor_commit_graph_test.go\n- modified: pose-mcp/internal/cli/doctor.go\n- modified: .github/workflows/ci.yml\n- modified: .pose/indexes/validation-matrix.json\n\n### Delivery targets\n\n- capability:doctor-recommends-the-commit-graph module:pose-mcp profile:composed-capability entrypoint:pose-mcp/cmd/pose/main.go\n\nComposto em produção pelo `pose doctor` e pelo `pose doctor --fix`. Check permanente `doctor-recommends-the-commit-graph-integration`, evidenceClass `integration`, required: `go test ./internal/cli -run 'TestDoctorRecommendsTheCommitGraph|TestDoctorCommitGraph' -count=1`.\n\n### API/contract changes\n- Nenhuma.\n\n### Data/storage changes\n- Nenhuma no `.pose/`; a correção escreve o commit-graph sob `.git/objects/info/`.\n\n### Technical risks\n- O evento `bloom` do trace2 é saída de diagnóstico do Git; uma versão que o renomeie faria o check recomendar a correção sempre. A correção é inofensiva, e o teste de integração com o Git real reprova se o evento sumir.\n\n---\n\n## 4. Tasks\n\n### Implementation\n- [x] Check e correção `git.commit-graph` no `doctor` (R1, R2, R3).\n- [x] Passo do CI (R4).\n\n### Validation\n- [x] Testes com repositórios reais acima e abaixo do limite, com e sem filtros, com prova de reprovação.\n\n---\n\n## 5. Decisions\n\n### Decision D1\n- Date: 2026-11-16\n- Context: o follow-up F1 da spec `pose-review-ledger-is-read-once-per-operation`; o maintainer pediu para escrever o commit-graph nos checkouts dele e seguir com o F1.\n- Options considered: (a) o motor escreve o commit-graph numa leitura de governança; (b) o `doctor` recomenda e o `doctor --fix` escreve; (c) só documentar.\n- Decision: (b), com o limite de 500 commits.\n- Basis: R1, R2, R3\n- Rationale: (a) faria uma leitura escrever no repositório, o que a read view trata como mudança de entrada; (c) não chega a quem não lê o manual; (b) usa o caminho de remediação segura que o POSE já tem. Abaixo de cerca de 500 commits a busca de histórico custa poucos milissegundos.\n- Consequences: um projeto grande vê um passo pendente até rodar a correção.\n\n---\n\n## 6. Validation\n\n### Strategy\nTestes do `doctor` com repositórios Git reais; medição já registrada na spec de origem.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./internal/cli -count=1`\n- Scope: pose-mcp\n- Expected: verde\n\n### Execution log\n- Date: 2026-11-16\n- Environment: Linux, Go 1.26, Git 2.56.\n- Notes: o teste monta uma instalação real, cria histórico acima de um limite reduzido e confere o check sem commit-graph (`next`, corrigível), depois da correção (`ok`), com um commit-graph sem filtros (`next`) e com um commit-graph dividido em camadas com filtros (`ok`); abaixo do limite, `ok`. Reprova quando a leitura ignora os chunks BIDX/BDAT, quando ignora a cadeia de camadas e quando a correção não está registrada. O guarda `TestEngineStartsGitOnlyThroughTheRawReader` reprovou a primeira versão, que chamava o Git direto; ela passou a usar `RawHistoryGit`. No checkout do pose-dist do maintainer, com o commit-graph escrito, o check dá `ok`. O `pose doctor` no harne8 passa de 900 s com o binário instalado antes desta spec, e por isso não foi medido lá.\n\n### Results summary\n- Successes: o `doctor` recomenda e escreve o commit-graph; o CI o escreve antes dos gates.\n- Failures: nenhuma.\n- Warnings: o `pose doctor` no harne8 leva mais de 900 s, já antes desta spec (follow-up F1).\n\n### Requirement trace\n- R1 [satisfied] test:TestDoctorRecommendsTheCommitGraph test:TestDoctorCommitGraphProbesALiteralPath check:doctor-recommends-the-commit-graph-integration\n- R2 [satisfied] test:TestDoctorRecommendsTheCommitGraph test:TestDoctorCommitGraphFixIgnoresMaxNewFilters test:TestDoctorCommitGraphShowsTheEffectiveCommand\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc doctorCommitGraphFinding(t *testing.T, repo string) doctorFinding {\n\tt.Helper()\n\tvar finding doctorFinding\n\tinDir(t, repo, func() {\n\t\tvar out, errB bytes.Buffer\n\t\tMain([]string{\"doctor\", \"--json\"}, &out, &errB)\n\t\tvar report doctorJSON\n\t\tif err := json.Unmarshal(out.Bytes(), &report); err != nil {\n\t\t\tt.Fatalf(\"invalid JSON: %v\\n%s\", err, out.String())\n\t\t}\n\t\tfor _, f := range report.Findings {\n\t\t\tif f.Check == \"git.commit-graph\" {\n\t\t\t\tfinding = f\n\t\t\t}\n\t\t}\n\t})\n\tif finding.Check == \"\" {\n\t\tt.Fatal(\"doctor reported no git.commit-graph check\")\n\t}\n\treturn finding\n}\n\nfunc gitInRepo(t *testing.T, repo string, args ...string) {\n\tt.Helper()\n\tif out, err := exec.Command(\"git\", append([]string{\"-C\", repo}, args...)...).CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t}\n}\n\nfunc removeCommitGraph(t *testing.T, repo string) {\n\tt.Helper()\n\tinfo := filepath.Join(repo, \".git\", \"objects\", \"info\")\n\tfor _, name := range []string{\"commit-graph\", \"commit-graphs\"} {\n\t\tif err := os.RemoveAll(filepath.Join(info, name)); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n}\n\n// Spec pose-doctor-recommends-the-commit-graph: R1 a long history Git walks\n// whole is a next step with a fix; R2 the fix writes the filters and the\n// check turns ok; R3 a short history needs none. The answer is Git's own, so\n// it follows whichever graph Git loads.\nfunc TestDoctorRecommendsTheCommitGraph(t *testing.T) {\n\trepo := doctorFixture(t)\n\toriginal := commitGraphHistoryThreshold\n\tt.Cleanup(func() { commitGraphHistoryThreshold = original })\n\tfor i := 0; i < 4; i++ {\n\t\t// Each commit changes a file of its own, so a lookup of another path\n\t\t// has commits the filters can rule out.\n\t\tif err := os.WriteFile(filepath.Join(repo, \"zz-history.txt\"), []byte(strings.Repeat(\"x\", i+1)), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tgitInRepo(t, repo, \"add\", \"zz-history.txt\")\n\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"history\")\n\t}\n\tremoveCommitGraph(t, repo)\n\n\tcommitGraphHistoryThreshold = 1 << 30\n\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"ok\" {\n\t\tt.Fatalf(\"a short history is not ok: %+v\", f)\n\t}\n\n\tcommitGraphHistoryThreshold = 3\n\tmissing := doctorCommitGraphFinding(t, repo)\n\tif missing.Level != \"next\" || missing.FixCode != \"git.commit-graph\" || missing.RemediationClass != remediationFixable {\n\t\tt.Fatalf(\"a long history without a commit-graph: %+v\", missing)\n\t}\n\n\tinDir(t, repo, func() {\n\t\tvar out, errB bytes.Buffer\n\t\tMain([]string{\"doctor\", \"--fix\", \"--yes\", \"--only\", \"git.commit-graph\"}, &out, &errB)\n\t})\n\tif fixed := doctorCommitGraphFinding(t, repo); fixed.Level != \"ok\" {\n\t\tt.Fatalf(\"the fix did not satisfy the check: %+v\", fixed)\n\t}\n\n\tremoveCommitGraph(t, repo)\n\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--no-changed-paths\")\n\tif plain := doctorCommitGraphFinding(t, repo); plain.Level != \"next\" {\n\t\tt.Fatalf(\"a commit-graph without changed-path filters is not recommended again: %+v\", plain)\n\t}\n\n\tremoveCommitGraph(t, repo)\n\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--changed-paths\", \"--split\")\n\tif split := doctorCommitGraphFinding(t, repo); split.Level != \"ok\" {\n\t\tt.Fatalf(\"a split commit-graph with changed paths is not recognized: %+v\", split)\n\t}\n\n\t// Review F3: with a single graph and a chain, Git loads the single graph.\n\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--no-changed-paths\")\n\tif both := doctorCommitGraphFinding(t, repo); both.Level != \"next\" {\n\t\tt.Fatalf(\"an unfiltered single graph beside a filtered chain is judged by the chain: %+v\", both)\n\t}\n\tremoveCommitGraph(t, repo)\n\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--changed-paths\")\n\n\t// Review F2: a repository whose graph lives only in an alternate.\n\tshared := filepath.Join(t.TempDir(), \"shared\")\n\tif out, err := exec.Command(\"git\", \"clone\", \"-q\", \"--shared\", repo, shared).CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"clone --shared: %v %s\", err, out)\n\t}\n\tremoveCommitGraph(t, shared)\n\tstate, err := readCommitGraphState(shared)\n\tif err != nil || !state.filtersUsed {\n\t\tt.Fatalf(\"a graph in an alternate is not seen: %+v %v\", state, err)\n\t}\n}\n\n// Review F5: a repository whose history cannot be read is a warning, not a\n// silent pass; a root that is not a repository gets no check.\nfunc TestDoctorCommitGraphReportsAnUnreadableHistory(t *testing.T) {\n\tif _, err := readCommitGraphState(t.TempDir()); !errors.Is(err, errCommitGraphNotApplicable) {\n\t\tt.Fatalf(\"a directory outside Git: %v, want not applicable\", err)\n\t}\n\trepo := doctorFixture(t)\n\toriginal := commitGraphHistoryThreshold\n\tt.Cleanup(func() { commitGraphHistoryThreshold = original })\n\tcommitGraphHistoryThreshold = 1\n\t// Each commit records a file, so HEAD has one to look up.\n\tfor i := 0; i < 2; i++ {\n\t\tif err := os.WriteFile(filepath.Join(repo, \"zz-history.txt\"), []byte(strings.Repeat(\"x\", i+1)), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tgitInRepo(t, repo, \"add\", \"zz-history.txt\")\n\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"history\")\n\t}\n\tout, err := exec.Command(\"git\", \"-C\", repo, \"rev-parse\", \"HEAD~1\").Output()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tparent := strings.TrimSpace(string(out))\n\tif err := os.Remove(filepath.Join(repo, \".git\", \"objects\", parent[:2], parent[2:])); err != nil {\n\t\tt.Fatalf(\"the parent commit is not a loose object: %v\", err)\n\t}\n\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"warn\" || !strings.Contains(f.Message, \"could not be read\") {\n\t\tt.Fatalf(\"an unreadable history: %+v\", f)\n\t}\n}\n\n// longHistoryRepo is an installed repository with commits that each change a\n// file of their own, the threshold lowered under them, and its commit-graph\n// written with changed-path filters.\nfunc longHistoryRepo(t *testing.T, extra func(repo string)) string {\n\tt.Helper()\n\trepo := doctorFixture(t)\n\toriginal := commitGraphHistoryThreshold\n\tt.Cleanup(func() { commitGraphHistoryThreshold = original })\n\tcommitGraphHistoryThreshold = 3\n\tif extra != nil {\n\t\textra(repo)\n\t}\n\tfor i := 0; i < 4; i++ {\n\t\tif err := os.WriteFile(filepath.Join(repo, \"zz-history.txt\"), []byte(strings.Repeat(\"x\", i+1)), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tgitInRepo(t, repo, \"add\", \"zz-history.txt\")\n\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"history\")\n\t}\n\tremoveCommitGraph(t, repo)\n\tgitInRepo(t, repo, \"commit-graph\", \"write\", \"--reachable\", \"--changed-paths\")\n\treturn repo\n}\n\n// Review F6: an unborn HEAD is not applicable, but a repository Git cannot\n// open is reported.\nfunc TestDoctorCommitGraphTellsUnbornFromBroken(t *testing.T) {\n\tunborn := t.TempDir()\n\tgitInRepo(t, unborn, \"init\", \"-q\")\n\tif _, err := readCommitGraphState(unborn); !errors.Is(err, errCommitGraphNotApplicable) {\n\t\tt.Fatalf(\"an unborn HEAD: %v, want not applicable\", err)\n\t}\n\tbroken := longHistoryRepo(t, nil)\n\tgitInRepo(t, broken, \"config\", \"core.bare\", \"invalid\")\n\tif _, err := readCommitGraphState(broken); err == nil || errors.Is(err, errCommitGraphNotApplicable) {\n\t\tt.Fatalf(\"a repository with an invalid configuration: %v, want a reported failure\", err)\n\t}\n\theadless := longHistoryRepo(t, nil)\n\tout, err := exec.Command(\"git\", \"-C\", headless, \"rev-parse\", \"HEAD\").Output()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\thead := strings.TrimSpace(string(out))\n\tif err := os.Remove(filepath.Join(headless, \".git\", \"objects\", head[:2], head[2:])); err != nil {\n\t\tt.Fatalf(\"the HEAD commit is not a loose object: %v\", err)\n\t}\n\tremoveCommitGraph(t, headless)\n\tif _, err := readCommitGraphState(headless); err == nil || errors.Is(err, errCommitGraphNotApplicable) {\n\t\tt.Fatalf(\"a HEAD whose commit is missing: %v, want a reported failure\", err)\n\t}\n}\n\n// Review F7: a first file whose name is pathspec syntax is looked up as the\n// literal name, so the filters still answer.\nfunc TestDoctorCommitGraphProbesALiteralPath(t *testing.T) {\n\trepo := longHistoryRepo(t, func(repo string) {\n\t\tif err := os.WriteFile(filepath.Join(repo, \"*\"), []byte(\"star\\n\"), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tgitInRepo(t, repo, \"add\", \"--\", \"*\")\n\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"star\")\n\t})\n\tout, err := exec.Command(\"git\", \"-C\", repo, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\").Output()\n\tif err != nil || !strings.HasPrefix(string(out), \"*\\n\") {\n\t\tt.Fatalf(\"the fixture's first path is not '*': %q %v\", out, err)\n\t}\n\tstate, err := readCommitGraphState(repo)\n\tif err != nil || !state.filtersUsed {\n\t\tt.Fatalf(\"a filtered graph probed through a pathspec-like name: %+v %v\", state, err)\n\t}\n}\n\n// Review F8: configuration that keeps Git from reading the filters is a\n// warning that names it, not a graph rewrite that cannot help.\nfunc TestDoctorCommitGraphNamesDisabledReads(t *testing.T) {\n\trepo := longHistoryRepo(t, nil)\n\tgitInRepo(t, repo, \"config\", \"commitGraph.changedPathsVersion\", \"0\")\n\tvar reads doctorFinding\n\tinDir(t, repo, func() {\n\t\tvar out, errB bytes.Buffer\n\t\tMain([]string{\"doctor\", \"--json\"}, &out, &errB)\n\t\tvar report doctorJSON\n\t\tif err := json.Unmarshal(out.Bytes(), &report); err != nil {\n\t\t\tt.Fatalf(\"invalid JSON: %v\", err)\n\t\t}\n\t\tfor _, f := range report.Findings {\n\t\t\tif f.Check == \"git.commit-graph\" {\n\t\t\t\tt.Errorf(\"the graph rewrite is recommended although configuration disables reading it: %+v\", f)\n\t\t\t}\n\t\t\tif f.Check == \"git.commit-graph-reads\" {\n\t\t\t\treads = f\n\t\t\t}\n\t\t}\n\t})\n\tif reads.Level != \"warn\" || !strings.Contains(reads.Message, \"commitGraph.changedPathsVersion=0\") || reads.FixCode != \"\" {\n\t\tt.Fatalf(\"disabled filter reads: %+v\", reads)\n\t}\n}\n\n// Review F15: a shallow clone, whose history Git cannot put in a\n// commit-graph, gets no recommendation it cannot satisfy.\nfunc TestDoctorCommitGraphSkipsAShallowClone(t *testing.T) {\n\trepo := longHistoryRepo(t, nil)\n\tshallow := filepath.Join(t.TempDir(), \"shallow\")\n\tif out, err := exec.Command(\"git\", \"clone\", \"-q\", \"--depth\", \"4\", \"file://\"+repo, shallow).CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"shallow clone: %v %s\", err, out)\n\t}\n\tif _, err := readCommitGraphState(shallow); !errors.Is(err, errCommitGraphNotApplicable) {\n\t\tt.Fatalf(\"a shallow clone: %v, want not applicable\", err)\n\t}\n}\n\n// Review F16: the fix writes filters for every commit even when\n// commitGraph.maxNewFilters would allow none.\nfunc TestDoctorCommitGraphFixIgnoresMaxNewFilters(t *testing.T) {\n\trepo := longHistoryRepo(t, nil)\n\tgitInRepo(t, repo, \"config\", \"commitGraph.maxNewFilters\", \"0\")\n\tremoveCommitGraph(t, repo)\n\tif err := writeCommitGraph(repo); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstate, err := readCommitGraphState(repo)\n\tif err != nil || !state.filtersUsed {\n\t\tt.Fatalf(\"the fix under maxNewFilters=0: %+v %v\", state, err)\n\t}\n}\n\n// Review F17: a HEAD with no file to look up is not applicable, not a\n// rewrite recommended forever.\nfunc TestDoctorCommitGraphSkipsAnEmptyTree(t *testing.T) {\n\trepo := longHistoryRepo(t, nil)\n\tgitInRepo(t, repo, \"rm\", \"-q\", \"-r\", \"--\", \".\")\n\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"empty\")\n\tif _, err := readCommitGraphState(repo); !errors.Is(err, errCommitGraphNotApplicable) {\n\t\tt.Fatalf(\"an empty HEAD tree: %v, want not applicable\", err)\n\t}\n}\n\n// Review F18: commitGraph.changedPathsVersion overrides the deprecated\n// readChangedPaths, so a missing graph is still a fixable recommendation.\nfunc TestDoctorCommitGraphFollowsConfigurationPrecedence(t *testing.T) {\n\trepo := longHistoryRepo(t, nil)\n\tgitInRepo(t, repo, \"config\", \"commitGraph.readChangedPaths\", \"false\")\n\tgitInRepo(t, repo, \"config\", \"commitGraph.changedPathsVersion\", \"1\")\n\tremoveCommitGraph(t, repo)\n\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"next\" || f.FixCode != \"git.commit-graph\" {\n\t\tt.Fatalf(\"a missing graph under changedPathsVersion=1 and readChangedPaths=false: %+v\", f)\n\t}\n}\n\n// Review F19: in a partial clone that lacks trees, the diagnosis fails\n// without fetching anything from the remote.\nfunc TestDoctorCommitGraphNeverFetches(t *testing.T) {\n\trepo := longHistoryRepo(t, nil)\n\tgitInRepo(t, repo, \"config\", \"uploadpack.allowFilter\", \"true\")\n\tpartial := filepath.Join(t.TempDir(), \"partial\")\n\tif out, err := exec.Command(\"git\", \"clone\", \"-q\", \"--no-checkout\", \"--filter=tree:0\", \"file://\"+repo, partial).CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"partial clone: %v %s\", err, out)\n\t}\n\tobjects := func() string {\n\t\tout, err := exec.Command(\"git\", \"-C\", partial, \"count-objects\", \"-v\").Output()\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\treturn string(out)\n\t}\n\tbefore := objects()\n\toriginal := commitGraphHistoryThreshold\n\tcommitGraphHistoryThreshold = 1\n\tt.Cleanup(func() { commitGraphHistoryThreshold = original })\n\tif _, err := readCommitGraphState(partial); err == nil || errors.Is(err, errCommitGraphNotApplicable) {\n\t\tt.Fatalf(\"a partial clone without its trees: %v, want a reported failure\", err)\n\t}\n\tif after := objects(); after != before {\n\t\tt.Fatalf(\"the diagnosis fetched objects:\\nbefore %s\\nafter %s\", before, after)\n\t}\n}\n\n// Review F20: a commit-graph Git cannot read, which it reports on stderr\n// while falling back to a plain walk, is a warning, not a rewrite.\nfunc TestDoctorCommitGraphReportsAnUnreadableGraph(t *testing.T) {\n\trepo := longHistoryRepo(t, nil)\n\tgraph := filepath.Join(repo, \".git\", \"objects\", \"info\", \"commit-graph\")\n\tremoveCommitGraph(t, repo)\n\tif err := os.WriteFile(graph, []byte(\"CGPH\\x01\\x01\\x05\\x00garbage\"), 0o444); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"warn\" {\n\t\tt.Fatalf(\"an unreadable commit-graph: %+v\", f)\n\t}\n}\n\n// shortHistoryRepo is an installed repository with a few commits that each\n// change a file, under the default threshold.\nfunc shortHistoryRepo(t *testing.T) string {\n\tt.Helper()\n\trepo := doctorFixture(t)\n\tfor i := 0; i < 3; i++ {\n\t\tif err := os.WriteFile(filepath.Join(repo, \"zz-history.txt\"), []byte(strings.Repeat(\"x\", i+1)), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tgitInRepo(t, repo, \"add\", \"zz-history.txt\")\n\t\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"history\")\n\t}\n\treturn repo\n}\n\n// Review F21: below the threshold too, a commit-graph Git cannot read is a\n// warning.\nfunc TestDoctorCommitGraphWarnsBelowTheThreshold(t *testing.T) {\n\trepo := shortHistoryRepo(t)\n\tremoveCommitGraph(t, repo)\n\tgraph := filepath.Join(repo, \".git\", \"objects\", \"info\", \"commit-graph\")\n\tif err := os.WriteFile(graph, []byte(\"CGPH\\x01\\x01\\x05\\x00garbage\"), 0o444); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f := doctorCommitGraphFinding(t, repo); f.Level != \"warn\" {\n\t\tt.Fatalf(\"an unreadable commit-graph under a short history: %+v\", f)\n\t}\n}\n\n// Review F22: a HEAD without files is not applicable under a short history\n// too.\nfunc TestDoctorCommitGraphSkipsAShortEmptyTree(t *testing.T) {\n\trepo := shortHistoryRepo(t)\n\tgitInRepo(t, repo, \"rm\", \"-q\", \"-r\", \"--\", \".\")\n\tgitInRepo(t, repo, \"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-q\", \"-m\", \"empty\")\n\tif _, err := readCommitGraphState(repo); !errors.Is(err, errCommitGraphNotApplicable) {\n\t\tt.Fatalf(\"a short history with an empty HEAD tree: %v, want not applicable\", err)\n\t}\n}\n\n// Review F23: the command doctor shows is the one its fix runs, and\n// following it by hand writes the filters under commitGraph.maxNewFilters=0.\nfunc TestDoctorCommitGraphShowsTheEffectiveCommand(t *testing.T) {\n\trepo := longHistoryRepo(t, nil)\n\tgitInRepo(t, repo, \"config\", \"commitGraph.maxNewFilters\", \"0\")\n\tremoveCommitGraph(t, repo)\n\tf := doctorCommitGraphFinding(t, repo)\n\tif f.Level != \"next\" || !strings.Contains(f.Hint, \"'\"+commitGraphWriteCommand+\"'\") {\n\t\tt.Fatalf(\"the shown command is not the fix's: %+v\", f)\n\t}\n\targs := strings.Fields(strings.TrimPrefix(commitGraphWriteCommand, \"git \"))\n\tgitInRepo(t, repo, args...)\n\tstate, err := readCommitGraphState(repo)\n\tif err != nil || !state.filtersUsed {\n\t\tt.Fatalf(\"following the shown command under maxNewFilters=0: %+v %v\", state, err)\n\t}\n}\n\n// Review F24: an unsupported commitGraph.changedPathsVersion keeps Git from\n// reading the filters; doctor names it instead of recommending a rewrite.\nfunc TestDoctorCommitGraphNamesAnUnsupportedVersion(t *testing.T) {\n\trepo := longHistoryRepo(t, nil)\n\tgitInRepo(t, repo, \"config\", \"commitGraph.changedPathsVersion\", \"3\")\n\tvar reads doctorFinding\n\tinDir(t, repo, func() {\n\t\tvar out, errB bytes.Buffer\n\t\tMain([]string{\"doctor\", \"--json\"}, &out, &errB)\n\t\tvar report doctorJSON\n\t\tif err := json.Unmarshal(out.Bytes(), &report); err != nil {\n\t\t\tt.Fatalf(\"invalid JSON: %v\", err)\n\t\t}\n\t\tfor _, f := range report.Findings {\n\t\t\tif f.Check == \"git.commit-graph\" {\n\t\t\t\tt.Errorf(\"a rewrite is recommended under an unsupported version: %+v\", f)\n\t\t\t}\n\t\t\tif f.Check == \"git.commit-graph-reads\" {\n\t\t\t\treads = f\n\t\t\t}\n\t\t}\n\t})\n\tif reads.Level != \"warn\" || !strings.Contains(reads.Message, \"commitGraph.changedPathsVersion=3\") {\n\t\tt.Fatalf(\"an unsupported changedPathsVersion: %+v\", reads)\n\t}\n}\n","exit_code":0,"status":"completed"}}
