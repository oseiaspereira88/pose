err != nil {\n+\t\t\tt.Fatal(args, err, string(out))\n+\t\t}\n+\t}\n+\tsel, err := computeChangedScopeWith(root, \"HEAD~1\", \"HEAD\", nil, scopeMetadata{})\n+\tif err != nil || len(sel.Changed) != 2 || sel.Changed[1] != \"x.txt\" || strings.HasPrefix(strings.Join(sel.Changed, \",\"), \"proj/\") {\n+\t\tt.Fatalf(\"scope selection below the repository top: %v %v\", sel.Changed, err)\n+\t}\n }\n \n-// R2, R5: the report removes whole absolute paths, with spaces, brackets or\n-// backticks, keeps relative names, and bounds its note.\n-func TestTheReportRemovesWholePaths(t *testing.T) {\n-\troot := filepath.Join(t.TempDir(), \"jane doe proj\")\n-\tnote := reportRedactPaths(root, \"open \"+root+\"/.git/index: denied; see [/srv/x y] and `/opt/z` for feature/index-rework\")\n-\tfor _, kept := range []string{\"doe\", \"/srv\", \"/opt\"} {\n-\t\tif strings.Contains(note, kept) {\n-\t\t\tt.Fatalf(\"the note kept %q: %s\", kept, note)\n-\t\t}\n+// R2: the versioned report carries no message of Git, so no path of the\n+// checkout, whatever its spelling; the warning on standard error carries it\n+// (review round 1, N2–N6).\n+func TestTheReportStatesNoPath(t *testing.T) {\n+\toutside := filepath.Join(t.TempDir(), \"jane doe proj\")\n+\tif err := os.MkdirAll(outside, 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tt.Setenv(\"GIT_CEILING_DIRECTORIES\", filepath.Dir(outside))\n+\tfiles, err := reportChangedFilesNoted(outside, \"HEAD\", localeEN)\n+\tif err == nil || len(files) != 1 || strings.Contains(files[0], \"doe\") || strings.Contains(files[0], string(filepath.Separator)+\"tmp\") || !strings.Contains(files[0], \"could not be listed\") {\n+\t\tt.Fatalf(\"the report note: %q %v\", files, err)\n \t}\n-\tif !strings.Contains(note, \"feature/index-rework\") {\n-\t\tt.Fatalf(\"a relative name was redacted: %s\", note)\n+\tif !strings.Contains(err.Error(), \"jane doe proj\") {\n+\t\tt.Fatalf(\"the warning lost Git's cause: %v\", err)\n \t}\n }\n \n@@ -90,9 +125,7 @@ func TestTheRemainingIndexReadGuards(t *testing.T) {\n \tif out := checker.stdout.(*strings.Builder).String(); !strings.Contains(out, \"locale=C\") {\n \t\tt.Fatalf(\"the check's listing did not run in English: %s\", out)\n \t}\n-\tif note := reportNote(root, errors.New(strings.Repeat(\"é\", 2000))); len(note) > 610 || !utf8.ValidString(note) {\n-\t\tt.Fatalf(\"the report note is not bounded: %d bytes\", len(note))\n-\t}\n+\n \tfiles, err := reportChangedFilesNoted(root, \"\", localeEN)\n \tif err == nil || len(files) != 1 || len(files[0]) > 700 {\n \t\tt.Fatalf(\"the report note is not bounded: %d bytes, %v\", len(strings.Join(files, \"\")), err)\ndiff --git a/pose-mcp/internal/cli/validate_reads_index_test.go b/pose-mcp/internal/cli/validate_reads_index_test.go\nindex bf2defaa..61205a88 100644\n--- a/pose-mcp/internal/cli/validate_reads_index_test.go\n+++ b/pose-mcp/internal/cli/validate_reads_index_test.go\n@@ -216,7 +216,7 @@ func TestIndexFailuresAreNamedInAnyLocale(t *testing.T) {\n \tif err == nil || !strings.Contains(err.Error(), \"index file\") {\n \t\tt.Fatalf(\"a corrupt index in another locale was not named in Git's English words: %v\", err)\n \t}\n-\tif len(files) != 1 || !strings.HasPrefix(files[0], \"_The changed files could not be listed: \") || strings.Contains(files[0], \"\\n\") || strings.Contains(files[0], root) {\n+\tif len(files) != 1 || !strings.HasPrefix(files[0], \"_The changed files could not be listed\") || strings.Contains(files[0], \"\\n\") || strings.Contains(files[0], root) {\n \t\tt.Fatalf(\"the report did not state the failure on one line: %q\", files)\n \t}\n \tclean, _ := staleIndexRepo(t)\n@@ -230,7 +230,7 @@ func TestIndexFailuresAreNamedInAnyLocale(t *testing.T) {\n \t}\n \t// A failure naming the checkout reaches the versioned report without its\n \t// absolute path (review round 3, N22).\n-\tif files, err := reportChangedFilesNoted(outside, \"HEAD\", localeEN); err == nil || len(files) != 1 || strings.Contains(files[0], outside) || !strings