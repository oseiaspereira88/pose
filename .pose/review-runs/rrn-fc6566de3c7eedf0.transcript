{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,230p' pose-mcp/internal/cli/validate.go; sed -n '1260,1345p' pose-mcp/internal/cli/validate.go; sed -n '1710,1785p' pose-mcp/internal/cli/validate.go; rg -n 'func .*RawGit|func RawHistoryGit|func GitIgnoredPaths' pose-mcp/internal/pose; rg -n 'Carried|carried' pose-mcp/internal/cli/validate_results.go pose-mcp/internal/cli/validate_concurrent* pose-mcp/internal/cli/validate_runtime*; rg -n -i 'carry|metadata' pose-mcp/internal/cli/testdata/adversarial/README.md\"","aggregated_output":"package cli\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"os/signal\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"syscall\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\ntype validationWhen struct {\n\tFileExists    string `json:\"fileExists\"`\n\tFileNotExists string `json:\"fileNotExists\"`\n\t// FileNotExistsAny (spec pose-stack-catalog-expansion): skip when ANY of\n\t// these files exist — expresses manager-priority exclusion (e.g. a pip\n\t// check yields to poetry/pipenv when their lockfiles are present)\n\t// without needing repeated single-field checks.\n\tFileNotExistsAny []string `json:\"fileNotExistsAny\"`\n}\n\ntype validationCheck struct {\n\tName          string            `json:\"name\"`\n\tCommand       string            `json:\"command\"`\n\tProgram       string            `json:\"program\"`\n\tArgs          []string          `json:\"args\"`\n\tEnv           map[string]string `json:\"env\"`\n\tSeverity      string            `json:\"severity\"`\n\tEvidenceClass string            `json:\"evidenceClass,omitempty\"`\n\tWhen          validationWhen    `json:\"when\"`\n\t// Runtime guardrails (spec pose-validation-runtime-guardrails).\n\tTimeoutSeconds int    `json:\"timeoutSeconds\"` // 0 = defaults.timeoutSeconds (600)\n\tIsolation      string `json:\"isolation\"`      // \"\" | \"required\" — required never runs locally\n\t// Exclusive runs the check with no other check running (spec\n\t// pose-validate-concurrent-steps R2).\n\tExclusive bool `json:\"exclusive,omitempty\"`\n}\n\n// validationEntry is one line of a validation run, in matrix order: a module\n// note, a skipped check or a check to execute.\ntype validationEntry struct {\n\tnote      string\n\tcheck     validationCheck\n\tmoduleDir string\n\tseverity  string\n\t// skip is why the check does not run. silent marks a changed-scope skip,\n\t// recorded in order without a step line.\n\tskip     string\n\tsilent   bool\n\tisolated bool\n\t// carried marks a check whose result comes from the canonical base (spec\n\t// pose-validate-carries-unchanged-checks R4); it is silent and never runs.\n\tcarried bool\n\tresult  checkResult\n\tdone     chan struct{}\n}\n\n// resolveWhen evaluates the check's condition at the moment it would start,\n// so an earlier check, finished by then, can decide it (review round 1, B1).\nfunc (e *validationEntry) resolveWhen() {\n\tif e.skip == \"\" {\n\t\te.skip = validationSkipReason(e.moduleDir, e.check.When)\n\t}\n}\n\n// execute runs the check and records its outcome in the entry's result. It\n// touches nothing else, so entries can run concurrently; the caller counts.\nfunc (e *validationEntry) execute(parent context.Context, matrix validationMatrix, verbose bool, stdout, stderr io.Writer, beforeStream func()) {\n\tcheck, result := e.check, &e.result\n\ttimeout := check.TimeoutSeconds\n\tif timeout <= 0 {\n\t\ttimeout = matrix.Defaults.TimeoutSeconds\n\t}\n\tif timeout <= 0 {\n\t\ttimeout = 600 // documented safe default\n\t}\n\tmaxOutput := matrix.Defaults.MaxOutputBytes\n\tif maxOutput <= 0 {\n\t\tmaxOutput = 1 << 20 // 1 MiB documented safe default\n\t}\n\tctx, cancel := context.WithTimeout(parent, time.Duration(timeout)*time.Second)\n\tcapture := &tailBuffer{capacity: 4096}\n\tlimiter := &outputLimiter{limit: maxOutput, cancel: cancel}\n\tpackages := &goTestPackages{}\n\texecArgs := sanitizeGoCheckArgs(ctx, e.moduleDir, check.Program, check.Args)\n\tif parent.Err() != nil {\n\t\tcancel()\n\t\te.markCancelled()\n\t\treturn\n\t}\n\tcmd := exec.CommandContext(ctx, check.Program, execArgs...)\n\tsetProcessGroup(cmd)\n\tcmd.Cancel = func() error { return killProcessGroup(cmd) }\n\tcmd.Dir = e.moduleDir\n\t// The renderer owns the terminal while a step is active: a child\n\t// writing to it would fight the status line, and streaming every\n\t// check's output is what buried the run's own verdict. The output is\n\t// captured and shown when the check fails; --verbose streams it\n\t// (spec pose-cli-output-rendering-system R7).\n\tif verbose {\n\t\tbeforeStream()\n\t\tcmd.Stdout = io.MultiWriter(stdout, capture, limiter, packages)\n\t\tcmd.Stderr = io.MultiWriter(stderr, capture, limiter)\n\t} else {\n\t\tcmd.Stdout = io.MultiWriter(capture, limiter, packages)\n\t\tcmd.Stderr = io.MultiWriter(capture, limiter)\n\t}\n\tcmd.Env = os.Environ()\n\tfor key, value := range check.Env {\n\t\tcmd.Env = append(cmd.Env, key+\"=\"+value)\n\t}\n\tstarted := time.Now()\n\terr := cmd.Run()\n\tdeadline := ctx.Err()\n\tcancel()\n\tresult.DurationSeconds = time.Since(started).Seconds()\n\tresult.Output = redactSecrets(capture.String(), check.Env)\n\tvar exitErr *exec.ExitError\n\tswitch {\n\tcase limiter.exceeded:\n\t\t// Explicit guardrail state: the check flooded output and was\n\t\t// cancelled (never conflated with a normal check failure).\n\t\tresult.Outcome, result.LimitState = \"error\", \"output-limit\"\n\t\tresult.Output = fmt.Sprintf(\"output limit exceeded (%d bytes) — process group terminated\", maxOutput)\n\tcase deadline == context.DeadlineExceeded:\n\t\tresult.Outcome, result.LimitState = \"error\", \"timeout\"\n\t\tresult.Output = fmt.Sprintf(\"timeout after %ds — process group terminated\", timeout)\n\tcase parent.Err() != nil:\n\t\te.markCancelled()\n\tcase err == nil:\n\t\tresult.Outcome = \"pass\"\n\t\t// go test exits 0 when a pattern selects nothing: a check that ran\n\t\t// no test has no evidence (spec pose-validate-refuses-empty-go-checks).\n\t\tif flag, pattern, judged := goTestSelection(check); judged && packages.ranNone() {\n\t\t\tresult.Outcome, result.LimitState = \"fail\", \"no-tests\"\n\t\t\tresult.Output = fmt.Sprintf(\"no test ran: %s %s selected nothing in the check's packages\\n%s\", flag, pattern, result.Output)\n\t\t}\n\tcase errors.As(err, &exitErr):\n\t\tcode := exitErr.ExitCode()\n\t\tresult.Outcome, result.ExitCode = \"fail\", &code\n\tdefault:\n\t\t// Infrastructure failure: the tool never ran (R3 keeps this\n\t\t// distinguishable from a real check failure).\n\t\tresult.Outcome = \"error\"\n\t\tresult.Output = redactSecrets(err.Error(), check.Env)\n\t}\n}\n\n// The flags of the plain go test grammar, by what they take and whether they\n// have a test. spelling: a short list of what checks use, each exactly as Go\n// registers it. Any other flag leaves a check unjudged.\nvar (\n\tgoTestFlagsWithValue    = map[string]bool{\"count\": true, \"timeout\": true, \"parallel\": true, \"cpu\": true, \"outputdir\": true}\n\tgoTestFlagsWithoutValue = map[string]bool{\"v\": true, \"short\": true, \"failfast\": true}\n\tgoBuildFlagsWithValue   = map[string]bool{\"tags\": true, \"p\": true, \"covermode\": true, \"coverpkg\": true}\n\tgoBuildFlagsWithout     = map[string]bool{\"race\": true, \"cover\": true}\n)\n\n// goFlagName splits a flag into its name and inline value: one or two dashes,\n// nothing else.\nfunc goFlagName(arg string) (name, value string, inline, ok bool) {\n\trest := strings.TrimPrefix(strings.TrimPrefix(arg, \"-\"), \"-\")\n\tif rest == \"\" || strings.HasPrefix(rest, \"-\") {\n\t\treturn \"\", \"\", false, false\n\t}\n\tname, value, inline = strings.Cut(rest, \"=\")\n\treturn name, value, inline, true\n}\n\n// goTestSelection says which flag and pattern select a go test check's tests\n// by name, within a plain grammar: packages, then the flags listed above and\n// -run and -skip, in GOFLAGS or the arguments, the last value counting. Any\n// other form — another flag, a missing value, -args, --, a positional argument\n// after the packages, quoted GOFLAGS — leaves the check unjudged: reading it\n// wrong would fail a good check (spec pose-validate-refuses-empty-go-checks\n// R1-R2).\nfunc goTestSelection(check validationCheck) (flag, pattern string, judged bool) {\n\tif check.Program != \"go\" || len(check.Args) == 0 || check.Args[0] != \"test\" {\n\t\treturn \"\", \"\", false\n\t}\n\tselected := false\n\tscan := func(args []string, packagesAllowed bool) bool {\n\t\tpackages, afterPackages := false, false\n\t\tfor i := 0; i < len(args); i++ {\n\t\t\targ := args[i]\n\t\t\tif !strings.HasPrefix(arg, \"-\") {\n\t\t\t\tif !packagesAllowed || afterPackages {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\t\tpackages = true\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tafterPackages = packages\n\t\t\tname, value, inline, ok := goFlagName(arg)\n\t\t\tif !ok {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\ttestName, testSpelling := strings.CutPrefix(name, \"test.\")\n\t\t\tswitch {\n\t\t\tcase testName == \"run\", testName == \"skip\":\n\t\t\t\tif !inline {\n\t\t\t\t\tif i+1 >= len(args) {\n\t\t\t\t\t\treturn false\n\t\t\t\t\t}\n\t\t\t\t\ti++\n\t\t\t\t\tvalue = args[i]\n\t\t\t\t}\n\t\t\t\tflag, pattern, selected = \"-\"+testName, value, true\n\t\t\tcase goTestFlagsWithValue[testName], !testSpelling && goBuildFlagsWithValue[name]:\n\t\t\t\tif !inline {\n\t\t\t\t\tif i+1 >= len(args) {\n\t\t\t\t\t\treturn false\n\t\t\t\t\t}\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tseverity := check.Severity\n\t\t\t\t\tif severity == \"\" {\n\t\t\t\t\t\tseverity = \"required\"\n\t\t\t\t\t}\n\t\t\t\t\tentries = append(entries, &validationEntry{check: check, severity: severity, skip: reason, silent: true, result: checkResult{\n\t\t\t\t\t\tID: module.Rel + \"/\" + stack + \"/\" + check.Name, Module: module.Rel,\n\t\t\t\t\t\tStack: stack, Name: check.Name, Program: check.Program,\n\t\t\t\t\t\tArgs: check.Args, Env: redactedEnv(check.Env), Severity: severity, EvidenceClass: check.EvidenceClass,\n\t\t\t\t\t}})\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif carryState.carried(module.Rel) {\n\t\t\tfor _, check := range checks {\n\t\t\t\tif check.Program == \"\" {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n\t\t\t\tentries = append(entries, &validationEntry{check: check, silent: true, carried: true, result: carryState.carriedResult(id)})\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tmoduleMode := mode\n\t\tif override.Mode != \"\" {\n\t\t\tmoduleMode = override.Mode\n\t\t}\n\t\tentries = append(entries, &validationEntry{note: fmt.Sprintf(\"[module] %s (%s, mode=%s)\", module.Rel, stack, moduleMode)})\n\t\tfor _, check := range checks {\n\t\t\tif check.Program == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseverity := check.Severity\n\t\t\tif severity == \"\" {\n\t\t\t\tseverity = \"required\"\n\t\t\t}\n\t\t\tentry := &validationEntry{check: check, moduleDir: module.Abs, severity: severity, done: make(chan struct{}), result: checkResult{\n\t\t\t\tID: module.Rel + \"/\" + stack + \"/\" + check.Name, Module: module.Rel,\n\t\t\t\tStack: stack, Name: check.Name, Program: check.Program,\n\t\t\t\tArgs: check.Args, Env: redactedEnv(check.Env), Severity: severity, EvidenceClass: check.EvidenceClass,\n\t\t\t}}\n\t\t\tif check.Isolation == \"required\" {\n\t\t\t\t// The local CLI never weakens its boundary: isolated\n\t\t\t\t// execution is delegated to the Harness via --emit-plan.\n\t\t\t\tentry.skip = \"requires isolated execution (harness) — include via --emit-plan\"\n\t\t\t\tentry.isolated = true\n\t\t\t}\n\t\t\tentries = append(entries, entry)\n\t\t}\n\t}\n\t// Checks run up to jobs at a time; results are shown and counted here,\n\t// in matrix order, whatever order they finish in (spec\n\t// pose-validate-concurrent-steps R1). --verbose streams a check's output,\n\t// so it runs them one at a time.\n\tif jobs == 0 {\n\t\tjobs = defaultValidationJobs(effectiveValidationResources(os.ReadFile, runtime.NumCPU()))\n\t}\n\tif verbose {\n\t\tjobs = 1\n\t}\n\trun.Jobs = jobs\n\trunCtx, stopSignals := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stopSignals()\n\t// The first signal cancels the run; a second one acts as it always did,\n\t// even while the run shuts down (review round 1, B4).\n\tgo func() {\n\t\t<-runCtx.Done()\n\t\tstopSignals()\n\t}()\n\twallStart := time.Now()\n\tif jobs > 1 {\n\t\tgo dispatchValidationEntries(runCtx, entries, jobs, matrix)\n\t}\n\tfor _, entry := range entries {\n\t\tif entry.note != \"\" {\n\t\t\tsteps.Note(entry.note)\n\t\t\tcontinue\n\t\t}\n\t\tif entry.carried {\n\t\t\t// A carried result counts toward the outcome exactly as it did in\n\t\t\t// its own run; a carried failure stays a failure (R4).\n\t\t\trun.Counts.Carried++\n\t\t\tswitch entry.result.Outcome {\n\t\t\tcase \"pass\":\n\t\t}\n\t}\n\treturn newArgs\n}\n\n// materialWorktreeClean reports whether the working copy equals HEAD in every\n// path outside the administrative classes, untracked files included. A status\n// that cannot be read is not clean.\nfunc materialWorktreeClean(root string) bool {\n\t// Mode changes count whatever core.fileMode says (review round 13, N36).\n\tout, err := gitOutputBounded(root, 16*1024*1024, \"-c\", \"core.fileMode=true\", \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n\tif err != nil {\n\t\treturn false\n\t}\n\trecords := strings.Split(string(out), \"\\x00\")\n\tvar administrative []string\n\tfor i := 0; i < len(records); i++ {\n\t\trecord := records[i]\n\t\tif len(record) < 4 {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{record[3:]}\n\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n\t\t\t// A rename or copy carries its source as the next record.\n\t\t\tif i+1 < len(records) {\n\t\t\t\ti++\n\t\t\t\tpaths = append(paths, records[i])\n\t\t\t}\n\t\t}\n\t\tfor _, p := range paths {\n\t\t\tif !posemodel.IsAdministrativePath(p) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tadministrative = append(administrative, p)\n\t\t}\n\t}\n\treturn administrativeRecordsAreRegular(root, administrative)\n}\n\n// materialTrackedUnchanged reports whether no tracked file differs from HEAD\n// outside the administrative records. Untracked files are not counted: checks\n// leave build products behind, and those are not the material they ran over.\nfunc materialTrackedUnchanged(root string) bool {\n\tout, err := gitOutputBounded(root, 16*1024*1024, \"-c\", \"core.fileMode=true\", \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=no\")\n\tif err != nil {\n\t\treturn false\n\t}\n\trecords := strings.Split(string(out), \"\\x00\")\n\tvar administrative []string\n\tfor i := 0; i < len(records); i++ {\n\t\trecord := records[i]\n\t\tif len(record) < 4 {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{record[3:]}\n\t\tif record[0] == 'R' || record[0] == 'C' || record[1] == 'R' || record[1] == 'C' {\n\t\t\tif i+1 < len(records) {\n\t\t\t\ti++\n\t\t\t\tpaths = append(paths, records[i])\n\t\t\t}\n\t\t}\n\t\tfor _, p := range paths {\n\t\t\tif !posemodel.IsAdministrativePath(p) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tadministrative = append(administrative, p)\n\t\t}\n\t}\n\treturn administrativeRecordsAreRegular(root, administrative)\n}\n\n// administrativeRecordsAreRegular reports whether every changed administrative\n// path is a regular file at HEAD (or new): editing a committed symlink or\n// submodule inside a class is a material change, as in MaterialSetDigest.\nfunc administrativeRecordsAreRegular(root string, paths []string) bool {\n\tif len(paths) == 0 {\npose-mcp/i