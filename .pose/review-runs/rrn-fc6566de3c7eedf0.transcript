{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'func dispatchValidationEntries' pose-mcp/internal/cli/validate.go; sed -n '390,485p' pose-mcp/internal/cli/validate.go; cat .pose/review-attestations/rva-f39a887e59b3aaaa.json\"","aggregated_output":"325:func dispatchValidationEntries(ctx context.Context, entries []*validationEntry, jobs int, matrix validationMatrix) {\n\tif quota > 0 && period > 0 && quota/period < r.cpus {\n\t\tr.cpus = quota / period\n\t}\n}\n\n// defaultValidationJobs is half the cores, bounded by the memory available at\n// roughly 1.5 GiB per check — a Go test link is what filled a small machine —\n// and by 8, never below 1; while the budget is not established it stays at 4\n// or below.\nfunc defaultValidationJobs(available validationResources) int {\n\tjobs := int(available.cpus / 2)\n\tif available.memoryKnown {\n\t\tif byMemory := int(available.memory / (3 << 29)); byMemory < jobs {\n\t\t\tjobs = byMemory\n\t\t}\n\t}\n\tif (!available.memoryKnown || available.unresolved) && jobs > 4 {\n\t\tjobs = 4\n\t}\n\tif jobs > 8 {\n\t\tjobs = 8\n\t}\n\tif jobs < 1 {\n\t\tjobs = 1\n\t}\n\treturn jobs\n}\n\n// cgroupMount is one mounted cgroup hierarchy: the subtree root it exposes,\n// where, and, for v1, its controllers.\ntype cgroupMount struct {\n\troot, point string\n\tcontrollers []string\n\tunified     bool\n}\n\n// decodeMountField undoes mountinfo's octal escapes of whitespace and\n// backslashes (review round 3, B6a).\nfunc decodeMountField(field string) string {\n\treturn strings.NewReplacer(`\\040`, \" \", `\\011`, \"\\t\", `\\012`, \"\\n\", `\\134`, `\\`).Replace(field)\n}\n\n// parseCgroupMounts reads the cgroup hierarchies of /proc/self/mountinfo.\nfunc parseCgroupMounts(raw string) []cgroupMount {\n\tvar mounts []cgroupMount\n\tfor _, line := range strings.Split(raw, \"\\n\") {\n\t\tbefore, after, ok := strings.Cut(line, \" - \")\n\t\tfields, tail := strings.Fields(before), strings.Fields(after)\n\t\tif !ok || len(fields) < 5 || len(tail) < 3 {\n\t\t\tcontinue\n\t\t}\n\t\tmount := cgroupMount{root: decodeMountField(fields[3]), point: decodeMountField(fields[4])}\n\t\tswitch tail[0] {\n\t\tcase \"cgroup2\":\n\t\t\tmount.unified = true\n\t\tcase \"cgroup\":\n\t\t\tmount.controllers = strings.Split(tail[2], \",\")\n\t\tdefault:\n\t\t\tcontinue\n\t\t}\n\t\tmounts = append(mounts, mount)\n\t}\n\treturn mounts\n}\n\n// visibleCgroupDirs translates a cgroup path into the directories of mount,\n// innermost first, up to the mount's own root; false when the path is not in\n// that subtree.\nfunc (m cgroupMount) visibleCgroupDirs(path string) ([]string, bool) {\n\troot := strings.TrimRight(m.root, \"/\")\n\tif path != root && !strings.HasPrefix(path, root+\"/\") {\n\t\treturn nil, false\n\t}\n\trelative := strings.TrimPrefix(path, root)\n\tvar dirs []string\n\tfor {\n\t\tdirs = append(dirs, strings.TrimRight(m.point, \"/\")+relative)\n\t\tif relative == \"\" {\n\t\t\treturn dirs, true\n\t\t}\n\t\trelative = relative[:strings.LastIndex(relative, \"/\")]\n\t}\n}\n\n// effectiveValidationResources reads the machine's cores and available memory\n// and narrows them to the limits of the process's cgroup and its visible\n// ancestors, v2 and v1, located through the process's own mounts, so a\n// container is judged by its budget (review rounds 1–2, B6). read is\n// os.ReadFile outside tests.\nfunc effectiveValidationResources(read func(string) ([]byte, error), cores int) validationResources {\n\tfound := validationResources{cpus: float64(cores)}\n\tif raw, err := read(\"/proc/meminfo\"); err == nil {\n\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n\t\t\tif rest, ok := strings.CutPrefix(line, \"MemAvailable:\"); ok {\n\t\t\t\tif fields := strings.Fields(rest); len(fields) > 0 {\n\t\t\t\t\tif kib, err := strconv.ParseUint(fields[0], 10, 64); err == nil {\n{\n  \"run\": {\n    \"run_id\": \"rrn-5ed84b0f66cce29b\",\n    \"proof_id\": \"rrp-5d77ecc2f7ffb67b591fd1160e8a4b02a4a6450b59afa99901912768e338c85e\"\n  },\n  \"schema_version\": 1,\n  \"attestation_id\": \"rva-f39a887e59b3aaaa\",\n  \"bundle_id\": \"rvb-85f7d3178908466e\",\n  \"bundle_digest\": \"sha256:85f7d3178908466e56ead09e1ad625b9c931e9d7bea6d509fe86347dd79a1c77\",\n  \"reviewer\": \"agent:openai/gpt-6.1-sol\",\n  \"decision\": \"changes-requested\",\n  \"criteria\": [\n    {\n      \"id\": \"assumption-integrity\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"structure:design-09ab654124b2b985\",\n      \"rationale\": \"Examined D1-D3, declarations, eligibility guards and material provenance. Verified that selection now uses one pinned metadata snapshot. The declaration that checks respect module/dependency boundaries remains an explicit instance assumption. N52 identifies unresolved read-failure uncertainty; N53 and N54 retain the documented low risks. Local tests passed, while full-matrix claims rely on sealed evidence.\"\n    },\n    {\n      \"id\": \"backend-concurrency\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/writer-coordination-and-atomic-publication-integration\",\n      \"rationale\": \"Reviewed cancellation finalization, dispatch and canonical publication. Publication retains the governance write guard, policy recheck and authoritative atomic publish. Focused concurrency and publication tests passed.\"\n    },\n    {\n      \"id\": \"backend-contracts\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/delivery-integration\",\n      \"rationale\": \"JSON fields and the CLI flag are additive. Legacy records retain their parsing behavior; missing engine identity prevents reuse. The delivery reader uses the carried head and time. Dedicated carried-record closeout coverage remains accepted follow-up N54.\"\n    },\n    {\n      \"id\": \"backend-input-errors\",\n      \"disposition\": \"finding\",\n      \"evidence\": \"N52\"\n    },\n    {\n      \"id\": \"backend-integration-impact\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/delivery-integration\",\n      \"rationale\": \"Traced the canonical result through ParseDeliveryValidationRun into delivery results. Direct carried-head/time reader tests passed. The complete carried-record sealing journey remains the explicit N54 coverage risk.\"\n    },\n    {\n      \"id\": \"backend-observability\",\n      \"disposition\": \"finding\",\n      \"evidence\": \"N52\"\n    },\n    {\n      \"id\": \"compatibility\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/cli-mcp-operation-results-integration\",\n      \"rationale\": \"Examined flag refusals, additive JSON fields, engine comparison and legacy parsing. Existing CLI/file consumers remain compatible; metadata that cannot decode now intentionally errors or falls back as specified.\"\n    },\n    {\n      \"id\": \"correctness\",\n      \"disposition\": \"finding\",\n      \"evidence\": \"N52\"\n    },\n    {\n      \"id\": \"design-causality\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"structure:design-09ab654124b2b985\",\n      \"rationale\": \"D1 directly addresses repeated whole-matrix execution by retaining original observations and using changed-scope selection to justify reuse. D2 rejects matrix/engine drift; D3 makes root-change exemptions explicit. The ADR records these authority and safety decisions. N52 is an implementation failure of the conservative fallback, rather than a need for a different architecture.\",\n      \"mappings\": [\n        {\n          \"delta\": \"SD-253b523c\",\n          \"basis\": \"D1\",\n          \"disposition\": \"mapped\",\n          \"rationale\": \"The added ADR records why carried observations keep their original head while the run computes current material bindings, with sound selection as the required premise.\"\n        }\n      ]\n    },\n    {\n      \"id\": \"documentation\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/distributed-instructions-parity-integration\",\n      \"rationale\": \"Compared runtime behavior with the ADR, CLI help, English and pt-BR manuals and embedded carry sections. They describe eligibility, conservative fallback, declarations and carried provenance consistently. Report rendering remains separately tracked by N53.\"\n    },\n    {\n      \"id\": \"operability\",\n      \"disposition\": \"finding\",\n      \"evidence\": \"N52\"\n    },\n    {\n      \"id\": \"requirements\",\n      \"disposition\": \"finding\",\n      \"evidence\": \"N52\"\n    },\n    {\n      \"id\": \"scope\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"structure:design-09ab654124b2b985\",\n      \"rationale\": \"The implementation stays within validation planning/results, changed-scope selection, delivery reading and their documentation. The ADR is required by D1's structural evidence contract. No unrelated runtime refactor or new dependency was introduced.\"\n    },\n    {\n      \"id\": \"security\",\n      \"disposition\": \"finding\",\n      \"evidence\": \"N52\"\n    },\n    {\n      \"id\": \"solution-proportionality\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"structure:design-09ab654124b2b985\",\n      \"rationale\": \"Module-level reuse with whole-matrix and engine comparison is the smallest sufficient extension of existing changed-scope selection. Per-check arbitrary-input hashing would require a larger input contract; manual merging would lose provenance. Conservative alias refusals avoid speculative alias tracking. The choice must be revisited if declarations cannot describe actual check inputs or if broader reuse precision becomes a requirement. N52 requires fail-closed error handling within this design.\"\n    }\n  ],\n  \"tools\": [\n    {\n      \"id\": \"artifact-check\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"command:pose artifact-check --spec pose-validate-carries-unchanged-checks --strict\",\n      \"rationale\": \"Ran the required command and a JSON diagnostic rerun. The diagnostic summary reported zero errors and 985 warnings. The resolved trailer range includes derived index/result paths, as disclosed in the brief. Final git status was clean.\"\n    },\n    {\n      \"id\": \"assess-design\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"structure:design-09ab654124b2b985\",\n      \"rationale\": \"Ran pose assess design --spec pose-validate-carries-unchanged-checks --json. It returned the sealed design digest and SD-253b523c.\"\n    },\n    {\n      \"id\": \"assess-discover\",\n      \"component\": \"pose-mcp\",\n      \"disposition\": \"not-used\",\n      \"evidence\": \"command:mktemp -d /tmp/pose-review-assess.XXXXXX\",\n      \"rationale\": \"Scratch creation failed with Read-only file system. The brief requires persisting assessments to run on a copy, so discovery was not run against the sealed checkout.\"\n    },\n    {\n      \"id\": \"assess-integrate\",\n      \"disposition\": \"not-used\",\n      \"evidence\": \"command:mktemp -d /tmp/pose-review-assess.XXXXXX\",\n      \"rationale\": \"Could not create the required scratch copy. Avoided persisting assessment/state outputs in the sealed checkout; integration judgment uses source tracing and sealed integration evidence.\"\n    },\n    {\n      \"id\": \"assess-tech-debt\",\n      \"disposition\": \"not-used\",\n      \"evidence\": \"command:mktemp -d /tmp/pose-review-assess.XXXXXX\",\n      \"rationale\": \"Could not create the required scratch copy. Avoided persisting assessment/state outputs in the sealed checkout; reviewed the changed code and existing owned follow-ups directly.\"\n    },\n    {\n      \"id\": \"closeout-check\",\n      \"disposition\": \"deferred\",\n      \"evidence\": \"command:pose closeout-check spec:pose-validate-carries-unchanged-checks\",\n      \"rationale\": \"Completion gate depends on POSE recording and verifying this review's conclusion. No attestation or closeout was recorded by this reviewer.\"\n    },\n    {\n      \"id\": \"review-check\",\n      \"disposition\": \"deferred\",\n      \"evidence\": \"command:pose review-check spec:pose-validate-carries-unchanged-checks\",\n      \"rationale\": \"Completion gate depends on the recorded attestation. Deferred to POSE after conclusion processing.\"\n    },\n    {\n      \"id\": \"suggest-review\",\n      \"component\": \"pose-mcp\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"command:pose suggest review --path pose-mcp\",\n      \"rationale\": \"Ran successfully; selected the review workflow and backend-go, security and documentation-style rules. Also consulted delivery-evidence and knowledge governance guidance.\"\n    },\n    {\n      \"id\": \"validate\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"build:pose-mcp/go/build\",\n      \"rationale\": \"Cites the sealed canonical strict validation result under the brief's explicit sandbox allowance. Did not rerun the full matrix locally. Local focused CLI tests, delivery-reader tests, concurrency/publication tests and go vet passed; this is not a claim of an independent full-matrix rerun.\"\n    },\n    {\n      \"id\": \"validate\",\n      \"component\": \"pose-mcp\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"unit:pose-mcp/go/test\",\n      \"rationale\": \"Cites the sealed canonical component validation result under the brief's sandbox allowance. Independently ran go test ./internal/cli -run 'Carry|ChangedScope|Validate|Material', go test ./internal/pose -run 'DeliveryValidation|Carried', focused engine/concurrency/publication tests, and go vet ./internal/cli ./internal/pose; all passed. The full component matrix was not rerun locally.\"\n    }\n  ],\n  \"evidence_refs\": [\n    \"N52\",\n    \"delegated-run:rrn-5ed84b0f66cce29b\",\n    \"integration:pose-mcp/go/cli-mcp-operation-results-integration\",\n    \"integration:pose-mcp/go/delivery-integration\",\n    \"integration:pose-mcp/go/distributed-instructions-parity-integration\",\n    \"integration:pose-mcp/go/writer-coordination-and-atomic-publication-integration\",\n    \"structure:design-09ab654124b2b985\"\n  ],\n  \"findings\": [\n    {\n      \"id\": \"N52\",\n      \"severity\": \"high\",\n      \"evidence\": \"file:pose-mcp/internal/cli/validate_carry.go:760\",\n      \"action\": \"Metadata read errors can become an empty selection policy. scopeMetadataAt returns empty metadata whenever both git show and cat-file -e fail, although a missing or unreadable blob is not proof that the path is absent from the tree. workingFileDiffersFromHead at lines 713-714 likewise treats any Git read failure as equality when the working file is absent. Consequently, with a valid base declaring b dependsOn a, an unavailable metadata blob and an absent working metadata file can pass both guards, discard the dependency, and carry b after a changes. Administrative metadata deletion is permitted by material cleanliness, and the name-only diff need not read the unavailable blob. This violates R2's full-run fallback on uncertainty and D1's selection premise. Determine absence from the pinned tree and return errors for failed object reads; add a regression for an unavailable committed metadata blob. Source-established; a new corruption fixture could not be created in the read-only sandbox.\",\n      \"disposition\": \"open\"\n    },\n    {\n      \"id\": \"N53\",\n      \"severity\": \"low\",\n      \"evidence\": \"file:pose-mcp/internal/cli/validate.go:1623\",\n      \"action\": \"Exclude carried checks from executed commands and label reused results with their original head and time, as tracked by spec follow-up F2.\",\n      \"disposition\": \"accepted-risk\",\n      \"owner\": \"@pose-maintainers\",\n      \"rationale\": \"validationSummaryOf includes carried checks in Commands and renders their prior outcome and duration without carried_from or carried_generated_at. A newly dated --carry --report therefore presents reused observations as commands executed by this run. This is existing spec follow-up F2.\",\n      \"review_by\": \"2026-12-15\"\n    },\n    {\n      \"id\": \"N54\",\n      \"severity\": \"low\",\n      \"evidence\": \"file:.pose/specs/2026-11-22-pose-validate-carries-unchanged-checks.md:254\",\n      \"action\": \"Implement the seal, verify and closeout-check fixture tracked by spec follow-up F1.\",\n      \"disposition\": \"accepted-risk\",\n      \"owner\": \"@pose-maintainers\",\n      \"rationale\": \"The delivery parser has direct coverage for the carried head and time, but no dedicated end-to-end fixture seals, verifies and checks closeout over a carried record. This remains the explicitly documented F1 coverage gap.\",\n      \"review_by\": \"2026-12-15\"\n    }\n  ],\n  \"authority\": {\n    \"schema_version\": 1,\n    \"project\": \"proj.pose-dist\",\n    \"bundle_digest\": \"sha256:85f7d3178908466e56ead09e1ad625b9c931e9d7bea6d509fe86347dd79a1c77\",\n    \"principal\": \"agent:openai/gpt-6.1-sol\",\n    \"role\": \"agent\",\n    \"review_execution\": \"rrn-5ed84b0f66cce29b\",\n    \"implementation_principal\": \"agent:anthropic/unknown\",\n    \"implementation_execution\": \"sha256:344ac5868944c155772d60a95ef6ff20644580a642e772ad5c92c29428464ff8\",\n    \"issuer\": \"b34-local-executor\",\n    \"issued_at\": \"2026-11-23T14:09:27Z\",\n    \"audience\": \"proj.pose-dist\"\n  },\n  \"envelope\": {\n    \"issuer\": \"b34-local-executor\",\n    \"subject\": \"rvb-85f7d3178908466e\",\n    \"algorithm\": \"ed25519\",\n    \"public_key\": \"ck4sApdfePV2GT+hJyAYfJd2qLzeG55P8pevGR0bvZE=\",\n    \"signature\": \"qcw0+GopH+9C9lnc9rSQ6wvS1mNCbyOnSPK0tCkfvo2tawMqQcVM2uvyPmVO7SU1VYHd0x6iNxHcba7e8wq0CA==\"\n  },\n  \"attested_at\": \"2026-11-23T14:09:27Z\",\n  \"path\": \".pose/review-attestations/rva-f39a887e59b3aaaa.json\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '315,365p' pose-mcp/internal/cli/validate.go; rg -n 'WithGovernanceWriteGuardForProjects|Writer.*Timeout|Lock.*Timeout|lock.*timeout|Err.*Busy' pose-mcp/internal/pose/writer* pose-mcp/internal/pose/*guard* pose-mcp/internal/pose/*lock*; sed -n '1,180p' pose-mcp/internal/cli/testdata/adversarial/README.md; rg -n 'Cancel|Concurrent|Publish|Writer' pose-mcp/internal/cli/validate*test.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '315,365p' pose-mcp/internal/cli/validate.go; rg -n 'WithGovernanceWriteGuardForProjects|Writer.*Timeout|Lock.*Timeout|lock.*timeout|Err.*Busy' pose-mcp/internal/pose/writer* pose-mcp/internal/pose/*guard* pose-mcp/internal/pose/*lock*; sed -n '1,180p' pose-mcp/internal/cli/testdata/adversarial/README.md; rg -n 'Cancel|Concurrent|Publish|Writer' pose-mcp/internal/cli/validate*test.go\"","aggregated_output":"// markCancelled records a check the run's cancellation stopped or kept from\n// starting.\nfunc (e *validationEntry) markCancelled() {\n\te.result.Outcome, e.result.LimitState = \"error\", \"cancelled\"\n\te.result.Output = \"validation cancelled — process group terminated\"\n}\n\n// dispatchValidationEntries starts the entries in matrix order, up to jobs at\n// a time; an exclusive check waits for the running ones and runs alone (spec\n// pose-validate-concurrent-steps R1–R2). A cancelled run starts nothing more.\nfunc dispatchValidationEntries(ctx context.Context, entries []*validationEntry, jobs int, matrix validationMatrix) {\n\tslots := make(chan struct{}, jobs)\n\tvar running sync.WaitGroup\n\tcancelled := func(entry *validationEntry) bool {\n\t\tif ctx.Err() == nil {\n\t\t\treturn false\n\t\t}\n\t\tentry.markCancelled()\n\t\tclose(entry.done)\n\t\treturn true\n\t}\n\tfor _, entry := range entries {\n\t\tif entry.note != \"\" || entry.silent || entry.isolated {\n\t\t\tcontinue\n\t\t}\n\t\tif entry.check.Exclusive {\n\t\t\trunning.Wait()\n\t\t\tif cancelled(entry) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif entry.resolveWhen(); entry.skip == \"\" {\n\t\t\t\tentry.execute(ctx, matrix, false, nil, nil, nil)\n\t\t\t}\n\t\t\tclose(entry.done)\n\t\t\tcontinue\n\t\t}\n\t\tselect {\n\t\tcase slots <- struct{}{}:\n\t\tcase <-ctx.Done():\n\t\t\tcancelled(entry)\n\t\t\tcontinue\n\t\t}\n\t\tif cancelled(entry) {\n\t\t\t<-slots\n\t\t\tcontinue\n\t\t}\n\t\trunning.Add(1)\n\t\tgo func(entry *validationEntry) {\n\t\t\tdefer running.Done()\n\t\t\tdefer func() { <-slots }()\n\t\t\tif entry.resolveWhen(); entry.skip == \"\" {\npose-mcp/internal/pose/governance_write_guard_test.go:222:\t\tif err := WithGovernanceWriteGuard(\"test.kernel-second-handle\", []Store{store}, func([]Store) error { return nil }); !errors.Is(err, ErrGovernanceWriteGuardBusy) {\npose-mcp/internal/pose/governance_write_guard_test.go:246:\tif !errors.Is(err, ErrGovernanceWriteGuardBusy) {\npose-mcp/internal/pose/governance_write_guard.go:23:\tErrGovernanceWriteGuardBusy         = errors.New(\"governance-write-guard-busy\")\npose-mcp/internal/pose/governance_write_guard.go:523:\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardBusy, operation, root.label, lockErr)\n# Adversarial corpus\n\nSpec: `pose-mechanization-adversarial-corpus`. Test: `adversarial_corpus_test.go`.\n\nEvery gate POSE adds against mechanical compliance can itself be satisfied\nmechanically. Each row is the cheapest formal satisfaction of one gate. An\n`enforced` case fails the build when the shortcut works again; a `known-gap`\ncase fails the build when the gap closes, so it cannot close or reopen\nsilently; a `planned` case belongs to a spec not yet delivered and gains code\nbefore that spec closes; a `delegated` case is enforced by a test in another\npackage, named in the row, whose existence the corpus checks.\n\nThis corpus belongs to developing POSE's governance. It adds no checklist to an\nadopting project's features.\n\n| Case | Status | Shortcut it refuses | Owner |\n|---|---|---|---|\n| `human-label-without-confirmation` | enforced | An agent writes and applies a review under `human:<name>`; the record reads as a human review | pose-review-attribution-roles |\n| `declared-independent-prefix` | enforced | `agent:independent-*` under declared assurance reads as authenticated separation | pose-review-assurance-disclosure |\n| `confirmation-reused-for-edited-content` | enforced | A confirmation recorded for one set of conclusions is kept after they change | pose-review-attribution-roles |\n| `unknown-recorded-as-satisfied` | enforced | An obligation the engine could not observe is reported as satisfied | pose-obligation-contract |\n| `legacy-blocker-gains-an-actor` | enforced | A blocker known only as text is given an invented recipient | pose-obligation-contract |\n| `blocked-counted-as-resolved` | enforced | Operational waiting counts as a resolved outcome in success metrics | pose-blocked-semantics-alignment |\n| `flat-specs-share-one-journal` | enforced | Two flat specs record amendments in one shared journal | pose-flat-spec-amendments |\n| `local-metadata-read-as-published` | enforced | A locally read version is presented as a proven publication | pose-public-claims-publication-provenance |\n| `invented-trace-test-ref` | known-gap | A requirement trace cites a test that does not exist and `lint-spec --strict` passes (follow-up 097 of pose-abm-design-basis) | pose-mechanization-adversarial-corpus |\n| `unavailable-producer-reads-as-empty` | enforced | A producer fails and Attention reports zero obligations as a complete answer | pose-obligation-projection |\n| `trivial-change-raises-a-request` | enforced | A trivial change or an already-authorized instruction produces an ActionRequest | pose-action-requests |\n| `declined-approval-satisfies` | enforced | A declined approval, or a cancellation without authority, releases a gate | pose-action-request-resolution |\n| `closeout-plan-fills-judgment` | enforced | The recoverable closeout plan answers a judgment criterion to finish | pose-recoverable-closeout-plan |\n| `ready-from-absent-blockers` | enforced | Absence of a known blocker is presented as proven independence | pose-phase-scoped-readiness |\n| `stale-preview-authorizes-apply` | enforced | A start previewed before a restricting request is applied after it | pose-governed-effect-enforcement |\n| `code-change-keeps-judgment` | enforced | The reviewed code changes and every criterion still reads as equivalent, so the old judgment is reused | pose-material-equivalence-reuse |\n| `minimal-surface-skips-trace` | enforced | A done spec declares the minimal surface to drop its requirement trace | pose-progressive-spec-surface |\n| `stale-assessment-reused` | enforced | The assessed component changes and the old assessment still reads as fresh | pose-adaptive-assessment-freshness |\n| `unpinned-premise-trigger-reads-current` | enforced | A premise trigger without a pin can never go stale and nothing says so | pose-assumption-validity-scope |\n| `calendar-ttl-as-premise-trigger` | enforced | An arbitrary expiry date is accepted as the material trigger of a premise | pose-assumption-validity-scope |\n| `unobserved-falsifier-reads-uncontradicted` | enforced | An unbound legacy index cannot prove that a falsifier check was never observed | pose-falsifier-reconsideration |\n| `parity-row-cites-an-unrelated-test` | known-gap | A launcher parity row names a real but unrelated `pose delegate` command and an existing test that does not exercise the capability, and the parity check passes; the check proves existence, review of the cited tests proves coverage | pose-delegation-parity-gate |\n| `imported-fragment-completes-a-replaced-command` | known-gap | A usage or error string assembles a removed command from a constant of another package of the module, which the active-document check reads as a gap; review of assembled messages is the defence | pose-delegation-parity-gate |\n| `cgo-preamble-text-reaches-usage` | known-gap | Operator text written as a C string in a cgo preamble reaches a usage surface; the Go reader sees a comment, not a string | pose-delegation-parity-gate |\n| `later-removal-hides-a-later-touch` | delegated | A later removal satisfies an earlier spec's claim because the history it is judged on omits that spec's change after the removal — change sets in ID order, a merge, root or type-change touch, a failed or shallow read, a recorded report too wide to read whole or a history directory that cannot be listed, a replace ref or graft (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_gaps_test.go:TestLaterRemovalReviewRoundTwo`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundFive`) | pose-delivery-later-removal |\n| `rename-read-as-removal` | delegated | A rename, or a path spelled as a pathspec, is taken for the declared deletion (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`) | pose-delivery-later-removal |\n| `recorded-commit-is-an-option` | delegated | A change set read from a recorded report names a Git option or a tag where a commit belongs (`cli/delivery_later_removal_history_test.go:TestLaterRemovalHistoryShapes`, `cli/delivery_later_removal_raw_test.go:TestLaterRemovalReviewRoundThree`) | pose-delivery-later-removal |\n| `peer-removal-stands-for-a-member` | delegated | A review subject digests a removed path from a peer's accepted removal while another observing member — sorted later, sharing a commit, or reduced into the peer's set — has none, whatever action or rename it observed the path with (`pose/review_subject_later_removal_test.go:TestReviewSubjectReadsALaterRemovalFromItsWitness`, `pose/review_subject_later_removal_test.go:TestMilestoneSubjectRemovalHoldsForEveryMember`) | pose-review-subject-later-removal |\n| `retained-child-skips-its-verification` | delegated | A milestone seals over a done member whose own review verification no longer retains its approval — revoked federated trust, lost history, a later negative review (`pose/review_subject_later_removal_test.go:TestRetainedChildFollowsItsVerification`, `pose/review_subject_later_removal_test.go:TestMilestoneSealRetainsADoneChildsApprovedReview`) | pose-review-subject-later-removal |\n| `run-pattern-names-no-test` | delegated | A validation check's `-run` alternative names a test that no longer exists, or never did, and the check passes on Go's exit 0 — through `-run=`, a build-excluded or ignored file, a vendored or nested-module declaration, a benchmark or a name Go does not run (`cli/validation_matrix_patterns_test.go:TestDeadRunPatternGuardFollowsGoSelection`, `cli/validation_matrix_patterns_test.go:TestValidationMatrixRunPatternsNameExistingTests`); a non-plain pattern passes only when listed with its reason | pose-validation-matrix-dead-test-patterns |\n| `removal-witness-outlives-its-history` | delegated | A stale index keeps counting a removal after a later touch, through a merge, a rewritten history or a shallow clone that lost the touch (`pose/removal_witness_freshness_test.go:TestLaterTouchRefusesTheWitness`, `pose/removal_witness_freshness_test.go:TestShallowHistoryRefusesTheWitness`) | pose-removal-witness-freshness |\n| `parent-outlives-a-rejected-child` | delegated | A milestone or roadmap stays approved over a child's later rejection, through retention, a sealed cycle, a replaced approval or a forged `replaces` (`pose/review_approval_follows_children_test.go:TestParentApprovalFollowsAChildsRejection`, `pose/review_approval_follows_children_test.go:TestChildCycleEndsInARefusal`, `pose/review_approval_follows_children_test.go:TestForgedReplacementRetiresNothing`, `pose/review_approval_follows_children_test.go:TestLegacyCoordinatedMatchingFollowsLineage`) | pose-review-approval-follows-children |\n| `go-check-ran-no-test` | delegated | A `go test` check selects nothing and passes on Go's exit 0, through a flag spelling, a flag's value read as a flag, or a package without test files (`cli/validate_empty_go_checks_test.go:TestValidateRefusesAGoCheckThatRanNoTest`, `cli/validate_empty_go_checks_test.go:TestGoTestSelection`); a check outside the plain grammar passes unjudged, and a test printing a result line can still mislead it | pose-validate-refuses-empty-go-checks |\n| `request-opened-after-preview-transfers` | delegated | A request opened after a transfer preview is moved with the spec (`pose/spec_transfer_actions_test.go:TestTransferRefusesARequestOpenedAfterThePreview`) | pose-transfer-preserves-obligations |\n\n| `deleted-reservation-resets-quota` | delegated | Deleting a reservation and receipt makes a surviving run stop consuming quota | pose-delegated-review-attempt-ledger |\n| `witness-bundle-filter-hides-loss` | delegated | Editing a witness bundle makes scoped readers skip its corruption | pose-delegated-review-attempt-ledger |\n| `window-erases-rerun` | delegated | Moving a prior run outside the time window turns a rerun into a first attempt | pose-delegated-review-attempt-ledger |\n| `canned-executor-approval-proves-cognition` | delegated | A complete canned approval from a trusted local command is presented as proof of review cognition or a vendor receipt (`cli/delegated_review_capability_test.go:TestDelegatedReviewCapabilityCannedApprovalDisclosesItsLimits` guards disclosure; the engine cannot detect canned judgments) | pose-delegated-review-capability |\n| `oversized-writer-publishes-unreadable-run` | delegated | A writer reports completion for a run its bounded reader immediately refuses | pose-delegated-review-attempt-ledger |\npose-mcp/internal/cli/validate_concurrent_test.go:3:// Concurrent checks (spec pose-validate-concurrent-steps): checks run up to\npose-mcp/internal/cli/validate_concurrent_test.go:41:func TestValidateRunsChecksConcurrentlyWithinJobs(t *testing.T) {\npose-mcp/internal/cli/validate_concurrent_test.go:110:func TestValidateCancelStopsRunningChecks(t *testing.T) {\npose-mcp/internal/cli/validate_concurrent_test.go:292:func TestValidateCancelStopsThePreparatoryGoList(t *testing.T) {\npose-mcp/internal/cli/validate_concurrent_test.go:342:func TestACancelledRunIsNeverASuccess(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:1166:func TestCarryRefusesABaseCancelledAtRunLevel(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:1197:func TestCancellationMakesBindingsUnavailable(t *testing.T) {\npose-mcp/internal/cli/validate_carry_test.go:1199:\tif !finalizeCancellation(&run) || run.MaterialClean || run.MaterialProvenance[\"s\"] != posemodel.MaterialBindingUnavailable {\npose-mcp/internal/cli/validate_results_test.go:252:func TestGovernanceWriteGuardValidateCanonicalResultRefusesBeforePublish(t *testing.T) {\npose-mcp/internal/cli/validate_results_test.go:283:func TestValidateCanonicalResultReportsPublishedWhenDurabilityIsUnconfirmed(t *testing.T) {\npose-mcp/internal/cli/validate_results_test.go:288:\tposemodel.PublishSyncHook = func(kind, path string) error {\npose-mcp/internal/cli/validate_results_test.go:294:\tt.Cleanup(func() { posemodel.PublishSyncHook = nil })\n","exit_code":0,"status":"completed"}}
