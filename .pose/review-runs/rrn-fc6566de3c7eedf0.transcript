{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/usr/bin/bash -lc \"git ls-tree HEAD -- '.pose/indexes/spec-graph.jso[n]'; git ls-tree HEAD -- '.pose/indexes/*.json'; git ls-tree HEAD -- '.pose/indexes/spec-graph.json'; nl -ba pose-mcp/internal/cli/validate_carry.go | sed -n '257,285p'; nl -ba pose-mcp/internal/cli/validate.go | sed -n '1440,1538p'; sed -n '480,535p' pose-mcp/internal/pose/governance_write_guard.go\"","aggregated_output":"100644 blob 1adcad30dd34da5a9daae1c00b81363b273086c2\t.pose/indexes/spec-graph.json\n   257\t\tfor _, file := range strings.Split(string(out), \"\\x00\") {\n   258\t\t\tfile = filepath.ToSlash(file)\n   259\t\t\tif file == \"\" || !posemodel.IsAdministrativePath(file) {\n   260\t\t\t\tcontinue\n   261\t\t\t}\n   262\t\t\tentry, err := posemodel.RawGit(\"-C\", root, \"ls-tree\", \"-z\", head, \"--\", file).Output()\n   263\t\t\tif err != nil {\n   264\t\t\t\tcontinue\n   265\t\t\t}\n   266\t\t\tfields := strings.Fields(string(entry))\n   267\t\t\tif len(fields) == 0 || fields[0] == \"100644\" || fields[0] == \"100755\" {\n   268\t\t\t\texclude = append(exclude, file)\n   269\t\t\t}\n   270\t\t}\n   271\t\treturn exclude\n   272\t}\n   273\t\n   274\t// validationEngineIdentity names the engine that ran a validation: its version\n   275\t// plus, when the binary records it, the VCS revision it was built from, marked\n   276\t// when the build tree was modified. Development builds share a version string,\n   277\t// so the revision is what tells two of them apart (R2).\n   278\tfunc validationEngineIdentity() string {\n   279\t\tidentity, _ := engineIdentityFrom(debug.ReadBuildInfo())\n   280\t\treturn identity\n   281\t}\n   282\t\n   283\t// engineIdentityFrom builds the identity from build information. A build of a\n   284\t// modified tree is not verifiable: two such builds at one revision share an\n   285\t// identity while their code differs (review round 2, N4).\n  1440\t\t\tendHead = strings.TrimSpace(string(head))\n  1441\t\t}\n  1442\t\t// Untracked material created while checks ran counts too (review round 8,\n  1443\t\t// N21): only ignored files may differ from the recorded head.\n  1444\t\n  1445\t\t// Equal endpoints do not show HEAD never moved: H -> H' -> H leaves them\n  1446\t\t// equal. The reflog must not have grown (review round 12, N34).\n  1447\t\t// The witness covers HEAD and every submodule's HEAD: a submodule moved\n  1448\t\t// away and back while checks ran is movement too (review round 15, N43).\n  1449\t\tendReflog := movementWitness(root, run.GitHead)\n  1450\t\trun.MaterialClean = startedClean && endedClean && run.GitHead != \"\" && endHead == run.GitHead && validationMaterialClean(root, run.GitHead) && startReflog != \"\" && endReflog == startReflog\n  1451\t\t// A run that did not validate its recorded head binds no material: its\n  1452\t\t// bindings would let a later tree make a misattributed pass current again\n  1453\t\t// (review round 5, N12).\n  1454\t\tif len(run.MaterialProvenance) > 0 && !run.MaterialClean {\n  1455\t\t\tfor spec := range run.MaterialProvenance {\n  1456\t\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n  1457\t\t\t}\n  1458\t\t}\n  1459\t\t// A cancelled run never reads as a success, whatever the severity of the\n  1460\t\t// checks it stopped (review round 1, B5).\n  1461\t\t// A signal cancels the run even when no executed check saw it, as in an\n  1462\t\t// all-carried run (review round 15, N45).\n  1463\t\tcancelled := runCtx.Err() != nil\n  1464\t\tfor _, check := range run.Checks {\n  1465\t\t\tcancelled = cancelled || check.LimitState == \"cancelled\"\n  1466\t\t}\n  1467\t\tif cancelled {\n  1468\t\t\trun.Cancelled = finalizeCancellation(&run)\n  1469\t\t}\n  1470\t\tfor _, line := range validationTimingNotes(run) {\n  1471\t\t\tsteps.Note(line)\n  1472\t\t}\n  1473\t\tsteps.Summary()\n  1474\t\tif executed == 0 && run.Counts.Carried == 0 {\n  1475\t\t\tfmt.Fprintln(stdout, \"No modules/checks matched the matrix and filters.\")\n  1476\t\t}\n  1477\t\tresult := \"pass\"\n  1478\t\tif cancelled {\n  1479\t\t\tfailures++\n  1480\t\t\tresult = \"fail\"\n  1481\t\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"validation cancelled\", \"validação cancelada\")})\n  1482\t\t} else if failures > 0 {\n  1483\t\t\tresult = \"fail\"\n  1484\t\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"required check failed\", \"check obrigatório falhou\")})\n  1485\t\t} else {\n  1486\t\t\tif optionalFailures > 0 {\n  1487\t\t\t\tresult = \"partial\"\n  1488\t\t\t\tr.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"optional-check\",\n  1489\t\t\t\t\tMessage: fmt.Sprintf(cliText(locale, \"%d optional check(s) failed\", \"%d check(s) opcional(is) falharam\"), optionalFailures)})\n  1490\t\t\t}\n  1491\t\t\tr.Verdict(cliout.Verdict{State: cliout.StatePass})\n  1492\t\t}\n  1493\t\trun.Outcome = result\n  1494\t\tusageFindings := make([]usageFinding, 0, run.Counts.Failed+run.Counts.OptionalFailed+run.Counts.Errored)\n  1495\t\tfor _, check := range run.Checks {\n  1496\t\t\tif check.Outcome != \"fail\" && check.Outcome != \"error\" {\n  1497\t\t\t\tcontinue\n  1498\t\t\t}\n  1499\t\t\tseverity := check.Severity\n  1500\t\t\tif check.Outcome == \"error\" {\n  1501\t\t\t\tseverity = \"error\"\n  1502\t\t\t}\n  1503\t\t\tusageFindings = append(usageFindings, usageFinding{ID: check.ID, Severity: severity})\n  1504\t\t}\n  1505\t\tnoteUsageFindings(stdout, result, usageFindings, true)\n  1506\t\tfor name, writer := range map[string]struct {\n  1507\t\t\tpath  string\n  1508\t\t\twrite func(string, validationRunResult) error\n  1509\t\t}{\n  1510\t\t\t\"json\":  {jsonOut, writeValidationJSON},\n  1511\t\t\t\"junit\": {junitOut, writeValidationJUnit},\n  1512\t\t\t\"sarif\": {sarifOut, writeValidationSARIF},\n  1513\t\t} {\n  1514\t\t\tif writer.path == \"\" {\n  1515\t\t\t\tcontinue\n  1516\t\t\t}\n  1517\t\t\ttarget := filepath.Join(root, filepath.FromSlash(writer.path))\n  1518\t\t\tif name == \"json\" && canonicalResultsPath != \"\" && normalizeValidationOutputPath(writer.path) == canonicalResultsPath {\n  1519\t\t\t\terr := publishCanonicalValidationJSONIn(store, writer.path, canonicalResultsPath, run)\n  1520\t\t\t\tif err != nil {\n  1521\t\t\t\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n  1522\t\t\t\t\t\tout := render(stdout, stderr)\n  1523\t\t\t\t\t\tout.ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n  1524\t\t\t\t\t\tout.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"validation-result-durability\",\n  1525\t\t\t\t\t\t\tMessage: fmt.Sprintf(\"%s result was published but durability is unconfirmed: %v\", name, err)})\n  1526\t\t\t\t\t\treturn 1\n  1527\t\t\t\t\t}\n  1528\t\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(cliText(locale, \"writing %s result: %v\", \"escrevendo resultado %s: %v\"), name, err))\n  1529\t\t\t\t\treturn 1\n  1530\t\t\t\t}\n  1531\t\t\t\trender(stdout, stderr).ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n  1532\t\t\t\tcontinue\n  1533\t\t\t}\n  1534\t\t\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n  1535\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: creating %s result directory: %v\\n\", \"Erro: criando diretório do resultado %s: %v\\n\"), name, err)\n  1536\t\t\t\treturn 1\n  1537\t\t\t}\n  1538\t\t\tif err := writer.write(target, run); err != nil {\n\t\t\t_ = files[i].Close()\n\t\t}\n\t}\n\tfor _, root := range roots {\n\t\tposeDir := filepath.Join(root.path, \".pose\")\n\t\tif err := ensureGovernanceLockDirectory(root, poseDir); err != nil {\n\t\t\tcleanup()\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, root.label, err)\n\t\t}\n\t\ttransfersDir := filepath.Join(root.path, \".pose\", \"transfers\")\n\t\tif err := ensureGovernanceLockDirectory(root, transfersDir); err != nil {\n\t\t\tcleanup()\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, root.label, err)\n\t\t}\n\t\tif err := validateGovernanceLockPaths(root); err != nil {\n\t\t\tcleanup()\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, root.label, err)\n\t\t}\n\t\tpath := filepath.Join(transfersDir, \".authority-transfer.lock\")\n\t\tfile, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o644)\n\t\tif err != nil {\n\t\t\tcleanup()\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, root.label, err)\n\t\t}\n\t\tfiles = append(files, file)\n\t\topened, statErr := file.Stat()\n\t\tcurrent, lstatErr := os.Lstat(path)\n\t\tif statErr != nil || lstatErr != nil || current.Mode()&os.ModeSymlink != 0 || !current.Mode().IsRegular() || !os.SameFile(opened, current) || !artifactPathWithin(NativeFiles(), root.path, path) {\n\t\t\tcleanup()\n\t\t\tcause := errors.New(\"authority transfer lock changed or escaped during open\")\n\t\t\tif statErr != nil {\n\t\t\t\tcause = statErr\n\t\t\t} else if lstatErr != nil {\n\t\t\t\tcause = lstatErr\n\t\t\t}\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, root.label, cause)\n\t\t}\n\t\tunlock, lockErr := lockSpecTransferFile(file)\n\t\tif lockErr != nil {\n\t\t\tcleanup()\n\t\t\tif errors.Is(lockErr, errFileLockUnsupported) {\n\t\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardUnsupported, operation, root.label, lockErr)\n\t\t\t}\n\t\t\treturn nil, governanceGuardError(ErrGovernanceWriteGuardBusy, operation, root.label, lockErr)\n\t\t}\n\t\tunlockers = append(unlockers, unlock)\n\t}\n\treturn cleanup, nil\n}\n\nfunc ensureGovernanceLockDirectory(root governanceGuardRoot, path string) error {\n\tif info, err := os.Lstat(path); errors.Is(err, os.ErrNotExist) {\n\t\tif err := os.Mkdir(path, 0o755); err != nil && !errors.Is(err, os.ErrExist) {\n\t\t\treturn err\n\t\t}\n\t} else if err != nil {\n","exit_code":0,"status":"completed