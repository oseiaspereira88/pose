{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"rg '\"'^func Test'\"' pose-mcp/internal/cli/validate_carry_test.go; cat pose-mcp/internal/pose/delivery_validation_run_test.go; cat .pose/rules/knowledge-governance.md; rg --files .pose/knowledge | rg 'carry|validat'\"","aggregated_output":"func TestCarryRunsOnlyTheChangedModule(t *testing.T) {\nfunc TestCarryKeepsTheOriginalHeadAcrossChainedCarries(t *testing.T) {\nfunc TestCarryKeepsACarriedFailureAFailure(t *testing.T) {\nfunc TestCarryFallsBackToAFullRun(t *testing.T) {\nfunc TestCarryRootChangeRunsEverythingUnlessSelfContained(t *testing.T) {\nfunc TestChangedScopeHonoursSelfContainedModules(t *testing.T) {\nfunc TestCarryRecordFileIsNotAChange(t *testing.T) {\nfunc TestCarrySelectsAModuleWithoutAPriorResult(t *testing.T) {\nfunc TestCarryRefusesAFilteredBase(t *testing.T) {\nfunc TestCarryRefusesIncompatibleFlags(t *testing.T) {\nfunc TestCarryIgnoresDerivedAdministrativeRecords(t *testing.T) {\nfunc TestCarryRefusesABaseThatValidatedADirtyWorkingCopy(t *testing.T) {\nfunc TestCarrySelectsBothSidesOfARename(t *testing.T) {\nfunc TestCarryKeepsTheOwnerOfAQuotedName(t *testing.T) {\nfunc TestCarryRootModuleOwnsRootFiles(t *testing.T) {\nfunc TestCarryDeletedDependencySelectsItsDependents(t *testing.T) {\nfunc TestCarryRejectsUndecodableMetadata(t *testing.T) {\nfunc TestChangedScopeGitlinkAboveADependencySelectsItsDependents(t *testing.T) {\nfunc TestCarryDeletedNestedDependencySelectsItsDependents(t *testing.T) {\nfunc TestCarryRootDependencyIsChangedByRootFiles(t *testing.T) {\nfunc TestCarryRefusesModulesReachedThroughASymlink(t *testing.T) {\nfunc TestValidateHeadMovingDuringTheRunIsNotClean(t *testing.T) {\nfunc TestChangedScopeEvaluatesEveryDeclaredDependency(t *testing.T) {\nfunc TestValidateHeadMovingDuringTheRunBindsNoMaterial(t *testing.T) {\nfunc TestCarryRefusesModulesSharingADirectory(t *testing.T) {\nfunc TestCarryPlansAgainstThePinnedHead(t *testing.T) {\nfunc TestChangedScopeDiscoveredAncestorDependencySelectsItsDependents(t *testing.T) {\nfunc TestCarryRefusesDependenciesReachedThroughASymlink(t *testing.T) {\nfunc TestCarryRefusesASymlinkInsideAModule(t *testing.T) {\nfunc TestCarryAllowsSymlinksBetweenUnownedPaths(t *testing.T) {\nfunc TestCarryDetectsACaseInsensitiveFilesystem(t *testing.T) {\nfunc TestCarryRefusesDuplicateCheckIDs(t *testing.T) {\nfunc TestCarryRefusesASymlinkFromAModuleToAnUnownedPath(t *testing.T) {\nfunc TestChangedScopeIgnoresSubmoduleHidingConfiguration(t *testing.T) {\nfunc TestValidateUntrackedMaterialCreatedDuringTheRunIsNotClean(t *testing.T) {\nfunc TestCarryRefusesAnAliasingSymlinkInsideASubmodule(t *testing.T) {\nfunc TestCarryDetectsACaseFoldedDirectory(t *testing.T) {\nfunc TestChangedScopeSelectsTheEnclosingModule(t *testing.T) {\nfunc TestCarryScansAGitlinkInsideAModule(t *testing.T) {\nfunc TestCarryRelevantDirsIncludeEveryAncestor(t *testing.T) {\nfunc TestChangedScopeRootModuleEnclosesEveryModule(t *testing.T) {\nfunc TestCarryCaseProbeSkipsUnusableEntries(t *testing.T) {\nfunc TestCarryRefusesDependenciesOutsideTheRepository(t *testing.T) {\nfunc TestCarryRefusesUncleanDependencies(t *testing.T) {\nfunc TestCarryRefusesNonASCIIPaths(t *testing.T) {\nfunc TestCarryRefusesHiddenIndexEntries(t *testing.T) {\nfunc TestCarryRefusesDependenciesThroughAnIgnoredSymlink(t *testing.T) {\nfunc TestValidateHeadMovingAndReturningIsNotClean(t *testing.T) {\nfunc TestCarryCaseProbeUsesOnlyASCIILetters(t *testing.T) {\nfunc TestValidateModeChangeHiddenByConfigurationIsNotClean(t *testing.T) {\nfunc TestValidateUninitializedSubmoduleIsNotClean(t *testing.T) {\nfunc TestValidateConditionClearedDuringTheRunIsNotClean(t *testing.T) {\nfunc TestValidateSubmoduleMovingAndReturningIsNotClean(t *testing.T) {\nfunc TestCarryRefusesABaseCancelledAtRunLevel(t *testing.T) {\nfunc TestCarryRefusesWorkingMetadataThatDiffersFromHead(t *testing.T) {\nfunc TestCancellationMakesBindingsUnavailable(t *testing.T) {\nfunc TestValidateNestedSubmodulesAreNotClean(t *testing.T) {\nfunc TestCarrySelectsWithThePinnedMetadataSnapshot(t *testing.T) {\nfunc TestCarryRefusesAnUnreadableMetadataBlob(t *testing.T) {\npackage pose\n\nimport \"testing\"\n\n// A carried check is read as an observation of the head it ran at (spec\n// pose-validate-carries-unchanged-checks R7); an executed one keeps the run's.\nfunc TestDeliveryValidationRunReadsTheCarriedHead(t *testing.T) {\n\traw := []byte(`{\"schema_version\":1,\"generated_at\":\"2026-11-22T10:00:00Z\",\"git_head\":\"bbbb\",\"checks\":[` +\n\t\t`{\"id\":\"a/go/ok\",\"module\":\"a\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\"},` +\n\t\t`{\"id\":\"b/go/ok\",\"module\":\"b\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\",\"carried_from\":\"aaaa\",\"carried_generated_at\":\"2026-11-21T09:00:00Z\"}]}`)\n\tresults, err := ParseDeliveryValidationRun(raw, \".pose/results/delivery-validation.json\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(results) != 2 {\n\t\tt.Fatalf(\"results = %+v\", results)\n\t}\n\tfor _, r := range results {\n\t\tswitch r.ID {\n\t\tcase \"a/go/ok\":\n\t\t\tif r.GitHead != \"bbbb\" || r.GeneratedAt != \"2026-11-22T10:00:00Z\" {\n\t\t\t\tt.Fatalf(\"executed check read as %s at %s\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\tcase \"b/go/ok\":\n\t\t\tif r.GitHead != \"aaaa\" || r.GeneratedAt != \"2026-11-21T09:00:00Z\" {\n\t\t\t\tt.Fatalf(\"carried check read as %s at %s, want the head it ran at\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\t}\n\t}\n}\n# Rule: Knowledge Governance\n\n## When to consult\n\nConsult this guide when creating, updating, reviewing, or removing artifacts under `.pose/knowledge/`.\n\n## TTL and retention\n\n- Set `expires_at` on every artifact when it is created.\n- Use a default TTL of 30 days for notes, decision logs, and handoffs.\n- Use a TTL of up to 90 days only with a justification recorded in the artifact body.\n- Treat an artifact without `expires_at` as non-compliant and block its creation or merge.\n\n## When this is not the right home\n\n- Use `.pose/knowledge/` only for time-bound operational memory: content\n  tied to a decision moment, a handoff between executions, or something\n  meant to be reviewed and eventually expire.\n- A durable fact or convention that will not become false and carries no\n  review trigger — a third-party tool's parsing quirk, a naming\n  convention, a recurring gotcha — is not a `decision-log` just because no\n  better type exists. Route it to `.pose/rules/` instead: add it to an\n  existing rule file or create one, then wire it into the relevant task\n  type's base `rules` array in `.pose/indexes/task-map.json` so\n  `pose suggest <task>` surfaces it automatically. No path scoping is\n  required — a task type's base `rules` list is returned regardless of\n  `--path`; only language/component-specific rules need the\n  `rules_by_domain` layer.\n- Rule of thumb: if nothing was decided or traded off, and nothing about\n  the fact will change on a predictable timeline, it is not a\n  `decision-log` and not an ADR — it is a rule. See ADR\n  `2026-08-15-durable-non-architectural-knowledge-belongs-in-rules-not-a-new-type`.\n\n## Reusable cross-execution format\n\n- Structure reusable context as a handoff with fixed sections: Context, Current state, Next checks, Risks, and Next owner.\n- Keep `source_refs` linked to the relevant spec, workflow, and executed check commands.\n- Record `last_reviewed_at` in the body to make effective cross-execution updates traceable.\n\n## Archiving and purging\n\n- Run biweekly triage to list expired artifacts.\n- Move expired artifacts to `.pose/knowledge/archive/` when they retain audit value.\n- Purge archived artifacts 180 days after expiration unless documented legal or compliance requirements apply.\n- Record every archive and purge action in the housekeeping log.\n\n## Sensitive content\n\n- Prohibit secrets, tokens, credentials, private keys, and equivalent material.\n- Prohibit personal data and non-anonymized customer data.\n- Do not copy restricted incidents or reports in full; keep only a controlled reference.\n- Classify frontmatter `sensitivity` as `public-internal` or `restricted`.\n- Remove identified sensitive content immediately and open a security follow-up.\n\n## Ownership and review\n\n- Keep `@pose-maintainers` as the primary governance owner.\n- Require an owner in every artifact frontmatter.\n- Review expiration biweekly and quality monthly.\n- Escalate a backlog overdue by more than two cycles to the primary owner.\n- Block backlog growth when `list-expired` exceeds the operational limit: zero in strict mode, two in tolerant mode.\n\n## Minimum operational checks\n\n- Run `pose knowledge-check --strict` biweekly to validate the expired backlog.\n- Run `pose knowledge-housekeeping list-expired` for detailed triage.\n- Run `pose knowledge-housekeeping archive-expired --dry-run` before applying changes.\n- Execute destructive actions only with an explicit `--apply` flag.\n.pose/knowledge/2026-08-14-decision-log-escalation-validate-native.md\n.pose/knowledge/2026-08-16-decision-log-module-metadata-discovery-invalidates-review-provenance.md\n","exit_code":0,"status":"completed"}}
