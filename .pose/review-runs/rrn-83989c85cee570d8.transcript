{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_run_provenance.go | sed -n '450,575p;650,745p' && nl -ba pose-mcp/internal/pose/review_conclusions.go | sed -n '590,660p'\"","aggregated_output":"   450\t\treturn policy, nil\n   451\t}\n   452\t\n   453\tfunc (s Store) verifyRunProof(proof ReviewRunProof, run ReviewRun, now time.Time) (ReviewRunAssurance, error) {\n   454\t\tfail := func(message string) (ReviewRunAssurance, error) {\n   455\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run provenance: %s\", message)\n   456\t\t}\n   457\t\t_, e := s.verifyRunProofCore(proof, run)\n   458\t\tif e != nil {\n   459\t\t\treturn ReviewRunAssurance{}, e\n   460\t\t}\n   461\t\tc, p := proof.Claim, run.Provenance\n   462\t\ttimes := &ReviewAuthorityClaim{IssuedAt: c.IssuedAt, ExpiresAt: c.ExpiresAt}\n   463\t\tif blocked := reviewClaimTimeBlockers(times, now, 0); len(blocked) > 0 {\n   464\t\t\treturn fail(strings.Join(blocked, \"; \"))\n   465\t\t}\n   466\t\tend, e := time.Parse(time.RFC3339Nano, run.EndedAt)\n   467\t\tissued, e2 := time.Parse(time.RFC3339Nano, c.IssuedAt)\n   468\t\tif e != nil || e2 != nil || issued.Before(end) {\n   469\t\t\treturn fail(\"proof predates the ended run\")\n   470\t\t}\n   471\t\tif why := s.runProofContextConflict(run); why != \"\" {\n   472\t\t\treturn fail(why)\n   473\t\t}\n   474\t\tconfig, found, e := s.LoadReviewersPolicyFor(run.Kind)\n   475\t\tif e != nil || !found || config.Provenance == nil {\n   476\t\t\treturn fail(\"current execution policy is missing\")\n   477\t\t}\n   478\t\tadapter, ok := config.Adapters[run.Adapter]\n   479\t\tif !ok {\n   480\t\t\treturn fail(\"current adapter is missing\")\n   481\t\t}\n   482\t\traw, _ := json.Marshal(adapter)\n   483\t\tif p.ConfigDigest != digestBytes(raw) {\n   484\t\t\treturn fail(\"adapter configuration differs\")\n   485\t\t}\n   486\t\tbundle, e := s.LoadReviewBundle(run.BundleID)\n   487\t\tif e != nil {\n   488\t\t\treturn fail(\"the reviewed bundle cannot be read\")\n   489\t\t}\n   490\t\timplementation, e := runImplementationIdentity(bundle, config.Provenance)\n   491\t\tif e != nil || implementation != p.Implementation || config.Provenance.Trust != p.Trust {\n   492\t\t\treturn fail(\"implementation baseline differs or is unknown\")\n   493\t\t}\n   494\t\treviewer, e := normalizeModelIdentity(ModelIdentity{Principal: adapter.Executor, Vendor: adapter.Vendor, Model: adapter.Model})\n   495\t\trecorded, recordErr := normalizeModelIdentity(ModelIdentity{Principal: p.Reviewer.Principal, Vendor: run.Vendor, Model: run.Model})\n   496\t\tif e != nil || recordErr != nil || recorded != reviewer || reviewer != p.Reviewer {\n   497\t\t\treturn fail(\"reviewer identity differs or is unknown\")\n   498\t\t}\n   499\t\t// The worktree a run was dispatched from is recorded, not required of\n   500\t\t// the reader: a run a CI job or Harne8's Conductor performed in its own\n   501\t\t// checkout of the project verifies in any other, since the project, the\n   502\t\t// audience, the sealed bundle and the brief it binds are the same there\n   503\t\t// (spec pose-delegated-review-action-fulfillment R3, R9; the amendment\n   504\t\t// of 2026-10-28 to the delegation ADR).\n   505\t\tif !validProofDigest(p.WorktreeDigest) {\n   506\t\t\treturn fail(\"the origin worktree of the run is not recorded\")\n   507\t\t}\n   508\t\tbrief, e := s.renderRunBriefMatching(run.BundleID, run.Kind, run.BriefNotes, run.BriefDigest)\n   509\t\t// A handoff run was sent the brief and the section its predecessor's\n   510\t\t// record yields; the verifier derives the same bytes (spec\n   511\t\t// pose-delegation-handoff R4).\n   512\t\tif e == nil && run.HandsOffFrom != \"\" {\n   513\t\t\tprior, priorErr := s.LoadProvenanceReviewRun(run.HandsOffFrom)\n   514\t\t\tif priorErr != nil {\n   515\t\t\t\treturn fail(\"the handoff predecessor cannot be read\")\n   516\t\t\t}\n   517\t\t\tsection := s.recordedHandoffSection(run, prior)\n   518\t\t\tif section == \"\" {\n   519\t\t\t\treturn fail(\"handoff section differs from the predecessor's record\")\n   520\t\t\t}\n   521\t\t\tbrief.Text += section\n   522\t\t}\n   523\t\tif e != nil || brief.Digest != run.BriefDigest || p.PlannedWireDigest != digestBytes([]byte(brief.Text)) || p.TemplateVersion != brief.TemplateVersion || p.NotesDigest != digestBytes([]byte(run.BriefNotes)) {\n   524\t\t\treturn fail(\"brief/template/notes/transmitted bytes differ\")\n   525\t\t}\n   526\t\tcommand := adapter.Command\n   527\t\tif run.Resumes != \"\" || run.Thread.continued() {\n   528\t\t\tif adapter.Resume == nil {\n   529\t\t\t\treturn fail(\"resume configuration missing\")\n   530\t\t\t}\n   531\t\t\tcommand = adapter.Resume.Command\n   532\t\t}\n   533\t\traw, _ = json.Marshal(command)\n   534\t\tif p.CommandTemplateDigest != digestBytes(raw) {\n   535\t\t\treturn fail(\"command template differs\")\n   536\t\t}\n   537\t\tif p.WireBytes < 0 || p.WireBytes > int64(len(brief.Text)) {\n   538\t\t\treturn fail(\"stdin byte count is outside the configured brief\")\n   539\t\t}\n   540\t\tswitch p.ExecutionState {\n   541\t\tcase \"started\":\n   542\t\t\tif !validProofDigest(p.ArgvDigest) || !validProofDigest(p.ExecutableDigest) || !validProofDigest(p.RawTranscriptDigest) || !validProofDigest(p.RawOutputDigest) {\n   543\t\t\t\treturn fail(\"execution or original-byte digests missing\")\n   544\t\t\t}\n   545\t\t\tif p.WireDigest != digestBytes([]byte(brief.Text)[:int(p.WireBytes)]) {\n   546\t\t\t\treturn fail(\"actual stdin digest differs from transmitted brief prefix\")\n   547\t\t\t}\n   548\t\t\tif p.WireComplete && (p.WireBytes != int64(len(brief.Text)) || p.WireDigest != p.PlannedWireDigest) {\n   549\t\t\t\treturn fail(\"complete stdin claim is inconsistent\")\n   550\t\t\t}\n   551\t\tcase \"not-started\":\n   552\t\t\tif p.WireBytes != 0 || p.WireComplete || p.WireDigest != \"\" || run.Status == ReviewRunCompleted || run.Status == ReviewRunInterrupted {\n   553\t\t\t\treturn fail(\"unstarted audit claims an executed or transmitted review\")\n   554\t\t\t}\n   555\t\tdefault:\n   556\t\t\treturn fail(\"unknown execution observation\")\n   557\t\t}\n   558\t\tif run.Status == ReviewRunCompleted && (!p.WireComplete || !p.OutputComplete || strings.TrimSpace(run.Output) == \"\") {\n   559\t\t\treturn fail(\"truncated or incomplete draft cannot establish completed review\")\n   560\t\t}\n   561\t\treturn runAssuranceFrom(run, proof, bundle, implementation, reviewer), nil\n   562\t}\n   563\t\n   564\t// runAssuranceFrom is what a verified run says about who reviewed and how independently.\n   565\tfunc runAssuranceFrom(run ReviewRun, proof ReviewRunProof, bundle ReviewBundle, implementation, reviewer ModelIdentity) ReviewRunAssurance {\n   566\t\tc, p := proof.Claim, run.Provenance\n   567\t\tdecision := draftReviewDecision(run.Output)\n   568\t\tsource := \"policy\"\n   569\t\tif impl := bundle.Payload.Implementation; impl != nil {\n   570\t\t\tsource = impl.Source\n   571\t\t}\n   572\t\treturn ReviewRunAssurance{IndependenceAchieved: AchievedIndependence(implementation.Vendor, implementation.Model, reviewer.Vendor, reviewer.Model), ImplementationSource: source, DraftDecision: decision, ProofIssuedAt: c.IssuedAt, ProofExpiresAt: c.ExpiresAt, State: run.Status, CompleteReview: run.Status == ReviewRunCompleted && p.WireComplete && p.OutputComplete && decision != \"unknown\" && len(run.DraftProblems) == 0, Assurance: ReviewRunMachineAttested, RunID: run.RunID, ProofID: proof.ProofID, Issuer: proof.Issuer, Reviewer: reviewer, Implementation: implementation, IdentitySource: \"native-issuer-signed-executor-declaration\", VendorDifference: AchievedIndependence(implementation.Vendor, implementation.Model, reviewer.Vendor, reviewer.Model) == IndependenceDifferentVendor, ModelDifference: knownIdentityPart(implementation.Model) && knownIdentityPart(reviewer.Model) && reviewer.Model != implementation.Model, OutputComplete: p.OutputComplete, Limitations: []string{\"executor-declaration-not-independent-vendor-receipt\", \"raw-bytes-hashed-by-executor-redacted-artifacts-retained\", ReviewLimitationIssuerTruthfulness, ReviewLimitationCognitive}}\n   573\t}\n   574\t\n   575\t// VerifyReviewRunProofAsSealed verifies a signed run proof as the approval it backed was\n   650\t\t}\n   651\t\treturn runAssuranceFrom(run, proof, bundle, p.Implementation, p.Reviewer), nil\n   652\t}\n   653\t\n   654\t// runApprovalAsSealed reports whether a run-backed approval of this bundle is verified as it\n   655\t// was given: the scope it approved is done.\n   656\tfunc (s Store) runApprovalAsSealed(bundle ReviewBundle) bool {\n   657\t\tref, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n   658\t\tif err != nil {\n   659\t\t\treturn false\n   660\t\t}\n   661\t\tdone, err := s.scopeLifecycleDone(ref)\n   662\t\treturn err == nil && done\n   663\t}\n   664\t\n   665\t// VerifyReviewRunProofForReading verifies a signed run proof for a reader that reports on a\n   666\t// run: as it was given when the scope the run reviewed is done, as it is now otherwise. It is\n   667\t// the question the closeout asks (verifyRunReviewReference), so a reader and the closeout\n   668\t// cannot disagree about one run (spec pose-verdict-readers-ask-the-sealed-question). On the\n   669\t// sealed path the expiry of the proof is not asked: it bounds the window in which a proof may\n   670\t// back a new attestation, and an attestation already given to a done scope stands.\n   671\tfunc (s Store) VerifyReviewRunProofForReading(id, proofID string) (ReviewRunAssurance, error) {\n   672\t\ts = s.reviewOperation()\n   673\t\trun, e := s.LoadProvenanceReviewRun(id)\n   674\t\tif e != nil {\n   675\t\t\treturn ReviewRunAssurance{}, e\n   676\t\t}\n   677\t\tif bundle, e := s.LoadReviewBundle(run.BundleID); e == nil && s.runApprovalAsSealed(bundle) {\n   678\t\t\treturn s.VerifyReviewRunProofAsSealed(id, proofID)\n   679\t\t}\n   680\t\treturn s.VerifyReviewRunProof(id, proofID)\n   681\t}\n   682\t\n   683\tfunc validProofDigest(value string) bool {\n   684\t\treturn regexp.MustCompile(`^sha256:[0-9a-f]{64}$`).MatchString(value)\n   685\t}\n   686\t\n   687\t// errReviewRunHistoryIncomplete is a run history that could not be read whole.\n   688\tvar errReviewRunHistoryIncomplete = errors.New(\"run provenance history is incomplete\")\n   689\t\n   690\tfunc (s Store) verifyRunReviewReference(bundle ReviewBundle, att ReviewAttestation) (ReviewRunAssurance, error) {\n   691\t\tif att.Run == nil {\n   692\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"signed run reference is missing\")\n   693\t\t}\n   694\t\tvar assurance ReviewRunAssurance\n   695\t\tvar e error\n   696\t\tif s.runApprovalAsSealed(bundle) {\n   697\t\t\tassurance, e = s.VerifyReviewRunProofAsSealed(att.Run.RunID, att.Run.ProofID)\n   698\t\t} else {\n   699\t\t\tassurance, e = s.VerifyReviewRunProof(att.Run.RunID, att.Run.ProofID)\n   700\t\t}\n   701\t\tif e != nil {\n   702\t\t\treturn assurance, e\n   703\t\t}\n   704\t\trun, e := s.LoadProvenanceReviewRun(att.Run.RunID)\n   705\t\tif e != nil {\n   706\t\t\treturn assurance, e\n   707\t\t}\n   708\t\tif run.BundleID != bundle.BundleID || run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.Kind != ReviewBriefKindReview || run.Status != ReviewRunCompleted || !assurance.CompleteReview || att.Reviewer != assurance.Reviewer.Principal {\n   709\t\t\treturn assurance, fmt.Errorf(\"attestation and referenced run context differ\")\n   710\t\t}\n   711\t\tattested, e1 := time.Parse(time.RFC3339Nano, att.AttestedAt)\n   712\t\tended, e2 := time.Parse(time.RFC3339Nano, run.EndedAt)\n   713\t\tissued, e3 := time.Parse(time.RFC3339Nano, assurance.ProofIssuedAt)\n   714\t\tif e1 != nil || e2 != nil || e3 != nil || ended.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) || issued.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) {\n   715\t\t\treturn assurance, fmt.Errorf(\"run-backed attestation predates its completed run or authenticated run proof\")\n   716\t\t}\n   717\t\tdraft := draftReviewDecision(run.Output)\n   718\t\tapproval := att.Decision == \"approved\" || att.Decision == \"approved-with-reservations\"\n   719\t\tif approval && draft != \"approved\" {\n   720\t\t\treturn assurance, fmt.Errorf(\"run draft does not support an approval: decision is %s\", draft)\n   721\t\t}\n   722\t\tif approval {\n   723\t\t\t// A draft that does not account for the previous round is never an\n   724\t\t\t// approval, whatever its decision line says (spec\n   725\t\t\t// pose-delegated-review-round-protocol R4, R9, D2).\n   726\t\t\tround, err := s.ReviewRoundOf(bundle)\n   727\t\t\tif err != nil {\n   728\t\t\t\treturn assurance, err\n   729\t\t\t}\n   730\t\t\tif problems := ValidateRoundDraft(round, run.Output); len(problems) > 0 {\n   731\t\t\t\treturn assurance, fmt.Errorf(\"the run's draft is invalid for round %d: %s\", round.Number, strings.Join(problems, \"; \"))\n   732\t\t\t}\n   733\t\t}\n   734\t\tif !approval && (draft != \"rejected\" && draft != \"changes-requested\") {\n   735\t\t\treturn assurance, fmt.Errorf(\"run draft does not support a rejecting attestation: decision is %s\", draft)\n   736\t\t}\n   737\t\tif why := runConclusionDiffers(run, bundle, att); why != \"\" {\n   738\t\t\treturn assurance, fmt.Errorf(\"the attestation does not state the run's conclusion: %s\", why)\n   739\t\t}\n   740\t\tif att.Authority == nil || att.Authority.Role != \"agent\" || att.Authority.ReviewExecution != run.RunID || att.Authority.ImplementationPrincipal != assurance.Implementation.Principal || att.Authority.ImplementationExecution != assurance.Implementation.Execution {\n   741\t\t\treturn assurance, fmt.Errorf(\"attestation authority differs from run provenance\")\n   742\t\t}\n   743\t\tif assurance.Implementation.Execution == run.RunID {\n   744\t\t\treturn assurance, fmt.Errorf(\"implementation and review executions are the same\")\n   745\t\t}\n   590\t\t}\n   591\t\tproof, err := s.SignReviewRunProof(run.RunID, key, 0, now, true)\n   592\t\tif err != nil {\n   593\t\t\tresult.Reasons = []string{\"the run's proof cannot be signed: \" + strings.TrimPrefix(err.Error(), \"pose: \")}\n   594\t\t\treturn finish(result)\n   595\t\t}\n   596\t\tassurance, err := s.VerifyReviewRunProof(run.RunID, proof.ProofID)\n   597\t\tif err != nil || !assurance.CompleteReview {\n   598\t\t\twhy := \"the signed proof does not establish a complete review\"\n   599\t\t\tif err != nil {\n   600\t\t\t\twhy = \"the signed proof does not verify: \" + strings.TrimPrefix(err.Error(), \"pose: \")\n   601\t\t\t}\n   602\t\t\tresult.ProofID, result.Reasons = proof.ProofID, []string{why}\n   603\t\t\treturn finish(result)\n   604\t\t}\n   605\t\tif run.Kind != ReviewBriefKindReview {\n   606\t\t\t// An adjudication or a smoke verdict is recorded where its origin\n   607\t\t\t// reads it, never as an approval, and only from a run that meets the\n   608\t\t\t// independence its plan requires (spec\n   609\t\t\t// pose-delegated-verdict-destinations; review round 1, B01).\n   610\t\t\tif why := verdictIndependenceReason(*bundle, assurance, run.RunID); why != \"\" {\n   611\t\t\t\tresult.ProofID, result.Reasons = proof.ProofID, []string{why}\n   612\t\t\t\treturn finish(result)\n   613\t\t\t}\n   614\t\t\tdestination, named, err := s.recordDelegatedVerdict(run, *bundle, *draft, proof.ProofID, issuer, now)\n   615\t\t\tif errors.Is(err, errVerdictDestinationBusy) {\n   616\t\t\t\t// The reservation stays: the verdict is published by a later\n   617\t\t\t\t// conclusion once the lock is free, never refused for it.\n   618\t\t\t\tpending.Reasons = []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n   619\t\t\t\treturn pending, err\n   620\t\t\t}\n   621\t\t\tif err != nil {\n   622\t\t\t\tresult.ProofID, result.Reasons = proof.ProofID, []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n   623\t\t\t\treturn finish(result)\n   624\t\t\t}\n   625\t\t\tresult.State, result.ProofID, result.Destination = ReviewConclusionRecorded, named, destination\n   626\t\t\treturn finish(result)\n   627\t\t}\n   628\t\tatt := reviewAttestationFromDraft(run, *bundle, *draft, assurance.Reviewer.Principal)\n   629\t\tatt.Run.ProofID = proof.ProofID\n   630\t\tauthority := &NativeAuthority{ReviewExecution: run.RunID, ImplementationPrincipal: assurance.Implementation.Principal, ImplementationExecution: assurance.Implementation.Execution}\n   631\t\tenvelope, err := s.SignReviewAttestation(att, key, authority, now)\n   632\t\tif err == nil {\n   633\t\t\tvar verified ReviewAttestation\n   634\t\t\tif verified, err = s.RecordReviewAttestationEnvelope(envelope, false); err == nil {\n   635\t\t\t\tif blockers := s.PreflightReviewAttestation(verified, now); len(blockers) > 0 {\n   636\t\t\t\t\terr = fmt.Errorf(\"the attestation preflight refuses it: %s\", strings.Join(blockers, \"; \"))\n   637\t\t\t\t}\n   638\t\t\t}\n   639\t\t}\n   640\t\tvar recorded ReviewAttestation\n   641\t\tif err == nil {\n   642\t\t\trecorded, err = s.RecordReviewAttestationEnvelope(envelope, true)\n   643\t\t}\n   644\t\tif err != nil {\n   645\t\t\tvar refusal *ReviewApprovalRefusal\n   646\t\t\tif errors.As(err, &refusal) {\n   647\t\t\t\terr = fmt.Errorf(\"the attestation preflight refuses it: %s\", strings.Join(refusal.Blockers, \"; \"))\n   648\t\t\t}\n   649\t\t\tresult.ProofID, result.Reasons = proof.ProofID, []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n   650\t\t\treturn finish(result)\n   651\t\t}\n   652\t\tresult.State, result.ProofID, result.Attestation = ReviewConclusionRecorded, proof.ProofID, recorded.AttestationID\n   653\t\treturn finish(result)\n   654\t}\n   655\t\n   656\t// writeReviewConclusion writes result where nothing is, or in place of the\n   657\t// bytes over when over is set, and returns what it wrote.\n   658\tfunc (s Store) writeReviewConclusion(result ReviewConclusion, over []byte) ([]byte, error) {\n   659\t\tif _, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, ReviewConclusionsDir, true); err != nil {\n   660\t\t\treturn nil, err\n","exit_code":0,"status":"completed"}}
