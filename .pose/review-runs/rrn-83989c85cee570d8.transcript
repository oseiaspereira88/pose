{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_dispatch.go | sed -n '1728,1815p' && nl -ba pose-mcp/internal/pose/review_run_provenance.go | sed -n '375,435p;600,650p' && rg -n 'func \\\\(s Store\\\\) VerifyReview|func \\\\(s Store\\\\) ReviewCheck|CurrentReviewBundle\\\\(' pose-mcp/internal/pose/review*.go pose-mcp/internal/cli/review*.go\"","aggregated_output":"  1728\t\t\treturn \"stale: the source file \" + mismatch + \" differs from what the sealed commit records\"\n  1729\t\t}\n  1730\t\treturn \"\"\n  1731\t}\n  1732\t\n  1733\t// ReviewRunRecordStands says why the record of a completed run no longer stands, or \"\": the\n  1734\t// run completed with a safe record, no other run superseded it, the persisted record is the\n  1735\t// copy in hand, its transcript is intact and the bundle it names reads with the digest, scope\n  1736\t// and sealed commit it recorded. It asks nothing of the repository as it is now.\n  1737\tfunc (s Store) ReviewRunRecordStands(run ReviewRun) string {\n  1738\t\tif why := reviewSafetyConflict(run); why != \"\" {\n  1739\t\t\treturn why\n  1740\t\t}\n  1741\t\tif run.Status != ReviewRunCompleted {\n  1742\t\t\treturn \"the run is \" + run.Status + \", not completed\"\n  1743\t\t}\n  1744\t\truns, lost, err := s.ReadReviewRuns(\"\")\n  1745\t\tif err != nil {\n  1746\t\t\treturn \"the runs of the bundle could not be read: \" + err.Error()\n  1747\t\t}\n  1748\t\tif len(lost) > 0 {\n  1749\t\t\treturn \"a run record could not be read and may supersede this run: \" + strings.Join(lost, \", \")\n  1750\t\t}\n  1751\t\tvar persisted *ReviewRun\n  1752\t\tfor i, other := range runs {\n  1753\t\t\tif other.Supersedes == run.RunID {\n  1754\t\t\t\treturn \"the run was superseded by \" + other.RunID\n  1755\t\t\t}\n  1756\t\t\tif other.RunID == run.RunID {\n  1757\t\t\t\tpersisted = &runs[i]\n  1758\t\t\t}\n  1759\t\t}\n  1760\t\t// The copy in hand is not the run: the record is, and it must be there and say the same.\n  1761\t\tif persisted == nil {\n  1762\t\t\treturn \"the record of the run is not in the review runs\"\n  1763\t\t}\n  1764\t\ta, b := *persisted, run\n  1765\t\ta.Path, a.SupersededBy, b.Path, b.SupersededBy = \"\", \"\", \"\", \"\"\n  1766\t\tif !reflect.DeepEqual(a, b) {\n  1767\t\t\treturn \"the record of the run differs from the copy that is being consulted\"\n  1768\t\t}\n  1769\t\tif why := s.reviewRunTranscriptIntact(*persisted); why != \"\" {\n  1770\t\t\treturn why\n  1771\t\t}\n  1772\t\tbundle, err := s.LoadReviewBundle(run.BundleID)\n  1773\t\tif err != nil {\n  1774\t\t\treturn \"the bundle of the run can no longer be read: \" + err.Error()\n  1775\t\t}\n  1776\t\t// The record says what it reviewed; what it says must be what the bundle is.\n  1777\t\tif run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.SealedCommit != bundle.Payload.Subject.Head {\n  1778\t\t\treturn \"the run record does not describe the bundle it names (bundle digest, scope or sealed commit differ)\"\n  1779\t\t}\n  1780\t\treturn \"\"\n  1781\t}\n  1782\t\n  1783\t// ReviewRunStillGoverns says why a run no longer governs its scope as the repository is now,\n  1784\t// or \"\": its record stands, Git answers, the persisted review inputs still materialize and the\n  1785\t// bundle it reviewed is still what the scope prepares.\n  1786\tfunc (s Store) ReviewRunStillGoverns(run ReviewRun) string {\n  1787\t\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n  1788\t\t\treturn why\n  1789\t\t}\n  1790\t\tif _, err := dispatchWorktreeIdentity(s.Root); err != nil {\n  1791\t\t\treturn \"origin Git identity unknown: \" + err.Error()\n  1792\t\t}\n  1793\t\tif _, err := ReadGitHead(s.Root); err != nil {\n  1794\t\t\treturn \"origin HEAD unknown: \" + err.Error()\n  1795\t\t}\n  1796\t\tbundle, err := s.LoadReviewBundle(run.BundleID)\n  1797\t\tif err != nil {\n  1798\t\t\treturn \"the bundle of the run can no longer be read: \" + err.Error()\n  1799\t\t}\n  1800\t\tif err := verifyBundleMaterialization(s.Root, bundle); err != nil {\n  1801\t\t\treturn \"persisted review inputs no longer materialize: \" + err.Error()\n  1802\t\t}\n  1803\t\treturn s.dispatchNoLongerGoverns(DispatchPlan{Bundle: bundle, Brief: ReviewBrief{Scope: run.Scope}, SealedCommit: run.SealedCommit,\n  1804\t\t\tPolicyDigest: run.PolicyDigest})\n  1805\t}\n  1806\t\n  1807\tfunc validateReviewRunRecord(name string, run ReviewRun) error {\n  1808\t\tif name != run.RunID+\".json\" {\n  1809\t\t\treturn fmt.Errorf(\"the file is not named after the run it holds\")\n  1810\t\t}\n  1811\t\tif run.LedgerVersion != 0 && run.LedgerVersion != 1 {\n  1812\t\t\treturn fmt.Errorf(\"unknown ledger version %d\", run.LedgerVersion)\n  1813\t\t}\n  1814\t\tif run.SchemaVersion != 1 {\n  1815\t\t\treturn fmt.Errorf(\"schema_version %d is not read by this engine\", run.SchemaVersion)\n   375\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run proof filename identity differs\")\n   376\t\t}\n   377\t\treturn s.verifyRunProof(proof, run, s.reviewClock())\n   378\t}\n   379\t\n   380\t// VerifyReviewRunProofRecord verifies what a proof of run says about it —\n   381\t// its signature under a pinned issuer, the project and audience, and the\n   382\t// exact run record, output, transcript and provenance it binds — without\n   383\t// asking whether the run still governs its scope or whether its adapter and\n   384\t// brief are the current ones: a reader of a record kept after its scope\n   385\t// moved on (spec pose-delegated-review-action-fulfillment, review round 1).\n   386\tfunc (s Store) VerifyReviewRunProofRecord(id, proofID string) (string, error) {\n   387\t\ts = s.reviewOperation()\n   388\t\trun, e := s.LoadProvenanceReviewRun(id)\n   389\t\tif e != nil {\n   390\t\t\treturn \"\", e\n   391\t\t}\n   392\t\trel, e := runProofPath(id, proofID)\n   393\t\tif e != nil {\n   394\t