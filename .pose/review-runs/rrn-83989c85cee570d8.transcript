{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_closeout.go | sed -n '1440,1555p' && nl -ba pose-mcp/internal/pose/review_bundle.go | sed -n '3150,3185p;3435,3495p;2668,2715p'\"","aggregated_output":"  1440\t\t\treturn \"\"\n  1441\t\t}\n  1442\t\trest := body[idx:]\n  1443\t\tif next := strings.Index(rest[len(start):], \"\\n## Milestone: \"); next >= 0 {\n  1444\t\t\treturn strings.TrimSpace(rest[:len(start)+next])\n  1445\t\t}\n  1446\t\treturn strings.TrimSpace(rest)\n  1447\t}\n  1448\t\n  1449\tfunc (s Store) ReviewCheck(ref string) (ReviewEvaluation, error) {\n  1450\t\treturn withGovernanceReviewReadView(s, \"review\", func(store Store) (ReviewEvaluation, error) {\n  1451\t\t\treturn store.reviewCheckWithAssurance(ref)\n  1452\t\t}, func(eval *ReviewEvaluation, metadata *ReadViewMetadata, audit governanceReadViewAudit) {\n  1453\t\t\tapplyReviewReadView(eval, metadata, audit)\n  1454\t\t})\n  1455\t}\n  1456\t\n  1457\tfunc (s Store) reviewCheckWithAssurance(ref string) (ReviewEvaluation, error) {\n  1458\t\teval, err := s.reviewCheck(ref)\n  1459\t\tif err == nil {\n  1460\t\t\ts.attachEvaluationAssurance(&eval)\n  1461\t\t}\n  1462\t\treturn eval, err\n  1463\t}\n  1464\t\n  1465\t// attachEvaluationAssurance discloses the record the evaluation settled on:\n  1466\t// the sealed bundle and attestation when there is one, the legacy attempt\n  1467\t// otherwise.\n  1468\tfunc (s Store) attachEvaluationAssurance(eval *ReviewEvaluation) {\n  1469\t\tif eval.settledBundle != nil {\n  1470\t\t\tassurance := s.DescribeReviewAssurance(*eval.settledBundle, eval.settledAttestation)\n  1471\t\t\teval.Assurance = &assurance\n  1472\t\t\treturn\n  1473\t\t}\n  1474\t\tif eval.BundleID != \"\" {\n  1475\t\t\tif bundle, err := s.LoadReviewBundle(eval.BundleID); err == nil {\n  1476\t\t\t\tvar att *ReviewAttestation\n  1477\t\t\t\tif eval.AttestationID != \"\" {\n  1478\t\t\t\t\tif attestations, listErr := s.ListReviewAttestations(eval.BundleID); listErr == nil {\n  1479\t\t\t\t\t\tfor i := range attestations {\n  1480\t\t\t\t\t\t\tif attestations[i].AttestationID == eval.AttestationID {\n  1481\t\t\t\t\t\t\t\tatt = &attestations[i]\n  1482\t\t\t\t\t\t\t}\n  1483\t\t\t\t\t\t}\n  1484\t\t\t\t\t}\n  1485\t\t\t\t}\n  1486\t\t\t\tassurance := s.DescribeReviewAssurance(bundle, att)\n  1487\t\t\t\teval.Assurance = &assurance\n  1488\t\t\t\treturn\n  1489\t\t\t}\n  1490\t\t}\n  1491\t\tif !eval.Required && eval.Current == nil {\n  1492\t\t\treturn\n  1493\t\t}\n  1494\t\tindependence, required := \"\", \"\"\n  1495\t\tif scope, err := ParseScopeRef(eval.Scope); err == nil {\n  1496\t\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil {\n  1497\t\t\t\tindependence = policy.ReviewerIndependence[scope.Kind]\n  1498\t\t\t\trequired = policy.ReviewIdentityAssurance(scope.Kind)\n  1499\t\t\t}\n  1500\t\t}\n  1501\t\tassurance := describeAttemptAssurance(required, independence, eval.Current)\n  1502\t\teval.Assurance = &assurance\n  1503\t}\n  1504\t\n  1505\tfunc (s Store) reviewCheck(ref string) (ReviewEvaluation, error) {\n  1506\t\tif s.indexPin == nil {\n  1507\t\t\ts = s.PinIndexes()\n  1508\t\t}\n  1509\t\ts = s.reviewOperation()\n  1510\t\tscope, err := ParseScopeRef(ref)\n  1511\t\tif err != nil {\n  1512\t\t\treturn ReviewEvaluation{}, err\n  1513\t\t}\n  1514\t\tdigest, err := s.ScopeDigest(ref)\n  1515\t\tif err != nil {\n  1516\t\t\treturn ReviewEvaluation{}, err\n  1517\t\t}\n  1518\t\tpolicy, _, err := s.loadReviewPolicy()\n  1519\t\tif err != nil {\n  1520\t\t\treturn ReviewEvaluation{}, err\n  1521\t\t}\n  1522\t\teval := ReviewEvaluation{Scope: ref, ScopeDigest: digest, PolicyEnabled: policy.Enabled, Required: policy.Enabled, Fresh: false, Approved: false, Blockers: []string{}}\n  1523\t\t// An adopted closeout review policy decides an aggregate scope before the\n  1524\t\t// legacy shortcuts: neither enabled=false nor an adoption cutoff weakens\n  1525\t\t// what it requires (spec pose-closeout-review-policy-by-cost-benefit).\n  1526\t\tdecision, exempt, err := s.closeoutReviewGate(ref, policy)\n  1527\t\tif err != nil {\n  1528\t\t\treturn eval, err\n  1529\t\t}\n  1530\t\teval.CloseoutReview = decision\n  1531\t\tif decision != nil {\n  1532\t\t\tif exempt {\n  1533\t\t\t\teval.Required = false\n  1534\t\t\t\teval.Fresh = true\n  1535\t\t\t\teval.ApprovalOrigin = closeoutApprovalOrigin(*decision)\n  1536\t\t\t\teval.Warnings = append(eval.Warnings, closeoutExemptionWarning(ref, *decision))\n  1537\t\t\t\treturn eval, nil\n  1538\t\t\t}\n  1539\t\t\teval.Required = true\n  1540\t\t\tif !decision.Known {\n  1541\t\t\t\teval.Blockers = append(eval.Blockers, decision.Diagnostics...)\n  1542\t\t\t\treturn eval, nil\n  1543\t\t\t}\n  1544\t\t}\n  1545\t\tif !policy.Enabled && decision == nil {\n  1546\t\t\teval.Warnings = append(eval.Warnings, \"review policy is absent or disabled; closeout review is not enforced\")\n  1547\t\t\treturn eval, nil\n  1548\t\t}\n  1549\t\tprofileRef := policy.Profiles[scope.Kind]\n  1550\t\teval.Profile = profileRef\n  1551\t\trequired := true\n  1552\t\tif decision == nil {\n  1553\t\t\trequired, err = s.reviewRequiredForScope(scope, policy)\n  1554\t\t\tif err != nil {\n  1555\t\t\t\treturn eval, err\n  2668\t\t\t\t}\n  2669\t\t\t\tgroup := bundles[start:end]\n  2670\t\t\t\tsort.SliceStable(group, func(i, j int) bool { return !negative[group[i].BundleID] && negative[group[j].BundleID] })\n  2671\t\t\t}\n  2672\t\t\tstart = end\n  2673\t\t}\n  2674\t}\n  2675\t\n  2676\tfunc (s Store) CurrentReviewBundle(scope string) (*ReviewBundle, error) {\n  2677\t\tprepared, err := s.PrepareReviewBundle(scope)\n  2678\t\tif err != nil {\n  2679\t\t\treturn nil, err\n  2680\t\t}\n  2681\t\tbundles, err := s.ListReviewBundles(scope)\n  2682\t\tif err != nil {\n  2683\t\t\treturn nil, err\n  2684\t\t}\n  2685\t\treturn s.matchSealedReviewBundle(scope, prepared, bundles)\n  2686\t}\n  2687\t\n  2688\t// matchSealedReviewBundle returns the newest sealed bundle whose digest equals\n  2689\t// the prepared one. A milestone bundle sealed with its roadmap as federated\n  2690\t// coordinator is matched against the legacy preparation instead, so it stays\n  2691\t// fresh exactly while that sealed roadmap-wide snapshot is unchanged. That\n  2692\t// snapshot contains every edge of the milestone's own manifest, so revocation\n  2693\t// or a source change still stales it.\n  2694\tfunc (s Store) matchSealedReviewBundle(scope string, prepared ReviewBundle, bundles []ReviewBundle) (*ReviewBundle, error) {\n  2695\t\tif governing := governingSealedBundle(bundles, prepared); governing != nil {\n  2696\t\t\treturn governing, nil\n  2697\t\t}\n  2698\t\tif prepared.Payload.Scope.Kind != \"milestone\" || s.FederatedResolver == nil {\n  2699\t\t\treturn nil, nil\n  2700\t\t}\n  2701\t\tcoordinated := []ReviewBundle{}\n  2702\t\tfor i := range bundles {\n  2703\t\t\tif manifest := bundles[i].Payload.FederatedManifest; manifest != nil && manifest.Coordinator.Kind == \"roadmap\" {\n  2704\t\t\t\tcoordinated = append(coordinated, bundles[i])\n  2705\t\t\t}\n  2706\t\t}\n  2707\t\tif len(coordinated) == 0 {\n  2708\t\t\treturn nil, nil\n  2709\t\t}\n  2710\t\tlegacy, err := s.prepareReviewBundle(scope, true)\n  2711\t\tif err != nil {\n  2712\t\t\treturn nil, err\n  2713\t\t}\n  2714\t\treturn governingSealedBundle(coordinated, legacy), nil\n  2715\t}\n  3150\t// over the bundle's sealed gates and the deliberately live signing and trust\n  3151\t// requirements, adds the time admissibility of a new operation, and requires\n  3152\t// the bundle to still be the current sealed subject of its scope, so the\n  3153\t// approval of a stale preview or of a superseded bundle is not written.\n  3154\t//\n  3155\t// A non-approving decision is an audit record the verifier rejects for\n  3156\t// closeout by definition, so its criteria are not held to the approval bar;\n  3157\t// its channel's authentication still applies in the writer.\n  3158\tfunc (s Store) reviewApprovalAdmissionBlockers(bundle ReviewBundle, att ReviewAttestation, now time.Time) []string {\n  3159\t\tif !reviewDecisionApproves(att.Decision) {\n  3160\t\t\treturn nil\n  3161\t\t}\n  3162\t\tblockers := s.atReviewTime(now).validateBundleAttestation(bundle, att)\n  3163\t\tblockers = append(blockers, reviewNewOperationTimeBlockers(att, now)...)\n  3164\t\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n  3165\t\tswitch {\n  3166\t\tcase err != nil:\n  3167\t\t\tblockers = append(blockers, \"the current review subject of \"+bundle.Payload.Scope.Ref+\" cannot be established: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n  3168\t\tcase current == nil:\n  3169\t\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" no longer represents the current semantic inputs of \"+bundle.Payload.Scope.Ref+\"; seal the current bundle and review it\")\n  3170\t\tcase current.BundleID != bundle.BundleID:\n  3171\t\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" is superseded by \"+current.BundleID+\"; review the current bundle\")\n  3172\t\t}\n  3173\t\treturn uniqueSorted(blockers)\n  3174\t}\n  3175\t\n  3176\t// PreflightReviewAttestation returns the reasons the domain writer would\n  3177\t// refuse an approving attestation, without writing anything. It completes the\n  3178\t// attestation exactly as recording would and runs the same admission, so a\n  3179\t// preview and the write cannot disagree (specs\n  3180\t// pose-attest-refuses-what-verify-rejects, pose-review-approval-domain-preflight).\n  3181\tfunc (s Store) PreflightReviewAttestation(att ReviewAttestation, now time.Time) []string {\n  3182\t\tif !reviewDecisionApproves(att.Decision) {\n  3183\t\t\treturn nil\n  3184\t\t}\n  3185\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n  3435\tfunc futureSchema(raw []byte) bool {\n  3436\t\tvar header struct {\n  3437\t\t\tSchemaVersion int `json:\"schema_version\"`\n  3438\t\t}\n  3439\t\tif json.Unmarshal(raw, &header) != nil {\n  3440\t\t\treturn false\n  3441\t\t}\n  3442\t\treturn header.SchemaVersion > ReviewBundleSchemaVersion\n  3443\t}\n  3444\t\n  3445\tfunc (s Store) VerifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n  3446\t\ts = s.reviewOperation()\n  3447\t\tverification, err := s.verifyReviewBundle(scope)\n  3448\t\tif err == nil && verification.Bundle != nil {\n  3449\t\t\tassurance := s.DescribeReviewAssurance(*verification.Bundle, verification.Attestation)\n  3450\t\t\tverification.Assurance = &assurance\n  3451\t\t}\n  3452\t\tif err == nil {\n  3453\t\t\tverification.DelegatedRuns, verification.DelegatedHistoryLosses = s.reviewRunSummaries(scope)\n  3454\t\t}\n  3455\t\tif err == nil && verification.Bundle != nil {\n  3456\t\t\tif round, rerr := s.ReviewRoundOf(*verification.Bundle); rerr != nil {\n  3457\t\t\t\tverification.DelegatedHistoryLosses = append(verification.DelegatedHistoryLosses, \"the round cannot be derived: \"+rerr.Error())\n  3458\t\t\t} else {\n  3459\t\t\t\tverification.Round = round.Number\n  3460\t\t\t\tpolicy, _, _, _ := s.LoadDelegationPolicy()\n  3461\t\t\t\tif threshold := policy.Routing.RoundThresholdOf(); round.Number >= threshold {\n  3462\t\t\t\t\tverification.Warnings = append(verification.Warnings, fmt.Sprintf(\"%s is in review round %d, at or past the round threshold %d: the rounds are not converging; consider a different agent or a human adjudication\", scope, round.Number, threshold))\n  3463\t\t\t\t}\n  3464\t\t\t}\n  3465\t\t}\n  3466\t\treturn verification, err\n  3467\t}\n  3468\t\n  3469\t// verifyReviewBundle verifies scope once per operation of the same project and\n  3470\t// resolver, and refuses a scope already being verified: sealed children are\n  3471\t// data, and a cycle among them must end in a named refusal (spec\n  3472\t// pose-review-approval-follows-children R6).\n  3473\tfunc (s Store) verifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n  3474\t\ts = s.reviewOperation()\n  3475\t\tstate := s.reviewReuse\n  3476\t\tkey := fmt.Sprintf(\"%s\\x00%t\\x00%s\", s.Root, s.FederatedResolver != nil, scope)\n  3477\t\tif result, ok := state.children[key]; ok {\n  3478\t\t\treturn result.verification, result.err\n  3479\t\t}\n  3480\t\tif state.verifying[key] {\n  3481\t\t\treturn ReviewBundleVerification{}, fmt.Errorf(\"pose: the sealed children of %s form a cycle\", scope)\n  3482\t\t}\n  3483\t\tstate.verifying[key] = true\n  3484\t\tdefer delete(state.verifying, key)\n  3485\t\tif s.onReviewVerify != nil {\n  3486\t\t\ts.onReviewVerify(scope)\n  3487\t\t}\n  3488\t\tverification, err := s.proportionalReviewVerification(scope)\n  3489\t\tstate.children[key] = childVerificationResult{verification, err}\n  3490\t\treturn verification, err\n  3491\t}\n  3492\t\n  3493\t// proportionalReviewVerification is the verification of a scope, and of a milestone that\n  3494\t// owes no review of its own: one made of a single closed, approved spec, or one a roadmap\n  3495\t// declares. Every reader of an approval comes through here, so they give one answer (ADR\n","exit_code":0,"status":"completed"}}
