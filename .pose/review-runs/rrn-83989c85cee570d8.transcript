{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_conclusions.go | sed -n '75,165p;530,585p' && nl -ba pose-mcp/internal/pose/review_run_provenance.go | sed -n '490,520p;700,800p'\"","aggregated_output":"    75\t\traw, err := readBoundedRegular(reviewConclusionPath(s.Root, runID), 1<<20)\n    76\t\tif errors.Is(err, os.ErrNotExist) {\n    77\t\t\treturn nil, nil, nil\n    78\t\t}\n    79\t\tif err != nil {\n    80\t\t\treturn nil, nil, err\n    81\t\t}\n    82\t\tvar c ReviewConclusion\n    83\t\tif err := json.Unmarshal(raw, &c); err != nil || c.RunID != runID {\n    84\t\t\treturn nil, nil, fmt.Errorf(\"pose: the conclusion record of %s cannot be read\", runID)\n    85\t\t}\n    86\t\treturn &c, raw, nil\n    87\t}\n    88\t\n    89\t// reviewConclusionChecks are the conditions a run must meet before its\n    90\t// conclusion is recorded, each a reason when it does not (R1, R3, R4).\n    91\tfunc (s Store) reviewConclusionChecks(run ReviewRun) ([]string, *ReviewBundle, *ReviewDraft) {\n    92\t\tvar reasons []string\n    93\t\tif run.Kind != ReviewBriefKindReview && run.Kind != ReviewBriefKindAdjudication && run.Kind != ReviewBriefKindSmoke || run.Purpose != \"\" && run.Purpose != DelegationPurposeForKind(run.Kind) {\n    94\t\t\treasons = append(reasons, \"the run is not a review, an adjudication or a smoke run\")\n    95\t\t}\n    96\t\tif run.Status != ReviewRunCompleted {\n    97\t\t\treasons = append(reasons, \"the run did not complete: it is \"+run.Status)\n    98\t\t}\n    99\t\tif run.SupersededBy != \"\" {\n   100\t\t\treasons = append(reasons, \"the run is superseded by \"+run.SupersededBy)\n   101\t\t}\n   102\t\tif run.Provenance == nil {\n   103\t\t\treasons = append(reasons, \"the run captured no provenance, so it cannot be signed\")\n   104\t\t}\n   105\t\tif run.Safety == nil || run.Safety.Operation.Outcome != OutcomeCompleted {\n   106\t\t\treasons = append(reasons, \"the run's cleanup is not confirmed complete\")\n   107\t\t}\n   108\t\tif why := s.reviewRunTranscriptIntact(run); why != \"\" {\n   109\t\t\treasons = append(reasons, \"the run's record is not intact: \"+why)\n   110\t\t}\n   111\t\tdraft, err := ParseReviewDraft(run.Output)\n   112\t\tswitch {\n   113\t\tcase err != nil:\n   114\t\t\treasons = append(reasons, \"the conclusion cannot be read: \"+err.Error())\n   115\t\tcase draft == nil:\n   116\t\t\treasons = append(reasons, \"the run's final message carries no pose-draft block\")\n   117\t\t}\n   118\t\tif len(run.DraftProblems) > 0 {\n   119\t\t\treasons = append(reasons, \"the draft does not account for its round: \"+strings.Join(run.DraftProblems, \"; \"))\n   120\t\t}\n   121\t\tbundle, err := s.LoadReviewBundle(run.BundleID)\n   122\t\tif err != nil {\n   123\t\t\treturn append(reasons, \"the run's bundle cannot be read: \"+err.Error()), nil, draft\n   124\t\t}\n   125\t\t// The run's own record must stand whatever it concludes. Whether its\n   126\t\t// bundle is still the current subject matters only to an approval: a\n   127\t\t// verdict that requests changes or rejects is a fact about the bundle it\n   128\t\t// reviewed, and the working tree the implementer is already fixing does\n   129\t\t// not change it (spec pose-review-conclude-ignores-unrelated-local-edits R1).\n   130\t\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n   131\t\t\treasons = append(reasons, \"the run no longer governs: \"+why)\n   132\t\t}\n   133\t\treasons = append(reasons, s.verdictCoverageReasons(run, bundle, draft)...)\n   134\t\treturn reasons, &bundle, draft\n   135\t}\n   136\t\n   137\t// reviewConclusionCurrency is why an approval of run's bundle would no longer\n   138\t// approve the current subject.\n   139\tfunc (s Store) reviewConclusionCurrency(run ReviewRun, bundle ReviewBundle) []string {\n   140\t\tvar reasons []string\n   141\t\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n   142\t\tif err != nil || current == nil || current.BundleID != bundle.BundleID {\n   143\t\t\treasons = append(reasons, \"the run's bundle no longer governs \"+bundle.Payload.Scope.Ref+\": the subject, the plan or the policy changed since it was sealed\")\n   144\t\t}\n   145\t\tif why := s.ReviewRunStillGoverns(run); why != \"\" {\n   146\t\t\treasons = append(reasons, \"the run no longer governs: \"+why)\n   147\t\t}\n   148\t\treturn reasons\n   149\t}\n   150\t\n   151\t// reviewAttestationFromDraft builds the attestation a draft concludes, for\n   152\t// the run that wrote it. Evidence is the run itself and each evidence the\n   153\t// draft names; a criterion or a tool the draft does not answer is left for\n   154\t// the preflight to refuse, never answered for it.\n   155\tfunc reviewAttestationFromDraft(run ReviewRun, bundle ReviewBundle, draft ReviewDraft, reviewer string) ReviewAttestation {\n   156\t\tatt := ReviewAttestation{BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest, Reviewer: reviewer, Decision: draft.Decision}\n   157\t\tevidence := map[string]bool{\"delegated-run:\" + run.RunID: true}\n   158\t\tfor _, c := range draft.Criteria {\n   159\t\t\tatt.Criteria = append(att.Criteria, ReviewCriterion{ID: c.ID, Disposition: c.Disposition, Evidence: c.Evidence, Rationale: c.Rationale, Mappings: c.Mappings})\n   160\t\t\tif c.Evidence != \"\" {\n   161\t\t\t\tevidence[c.Evidence] = true\n   162\t\t\t}\n   163\t\t}\n   164\t\tvar tools []ReviewToolDisposition\n   165\t\tfor _, t := range draft.Tools {\n   530\t\t}\n   531\t\treturn nil, nil\n   532\t}\n   533\t\n   534\tfunc (s Store) concludeReviewRun(id, issuer string, apply bool, now time.Time, takeOver []byte) (ReviewConclusion, error) {\n   535\t\tresult := ReviewConclusion{SchemaVersion: 1, RunID: id, State: ReviewConclusionRefused, Issuer: issuer, ConcludedAt: now.UTC().Format(time.RFC3339Nano)}\n   536\t\trun, err := s.LoadProvenanceReviewRun(id)\n   537\t\tif errors.Is(err, errReviewRunHistoryIncomplete) {\n   538\t\t\t// A record that cannot be read is a reason too, kept under the id\n   539\t\t\t// asked for (review round 1, B5).\n   540\t\t\tresult.Reasons = []string{\"the run's record cannot be read: \" + err.Error()}\n   541\t\t\treturn s.publishReviewConclusion(result, apply, takeOver)\n   542\t\t}\n   543\t\tif err != nil {\n   544\t\t\treturn ReviewConclusion{}, err\n   545\t\t}\n   546\t\tresult.BundleID, result.Scope, result.Kind = run.BundleID, run.Scope, run.Kind\n   547\t\treasons, bundle, draft := s.reviewConclusionChecks(run)\n   548\t\tif draft != nil {\n   549\t\t\tresult.Decision = draft.Decision\n   550\t\t}\n   551\t\tif bundle != nil && draft != nil && reviewDecisionApproves(draft.Decision) {\n   552\t\t\tif current := s.reviewConclusionCurrency(run, *bundle); len(current) > 0 {\n   553\t\t\t\tif len(reasons) == 0 {\n   554\t\t\t\t\t// Refused only because the subject the working tree holds is\n   555\t\t\t\t\t// not the bundle's: nothing about the run is wrong, so the\n   556\t\t\t\t\t// refusal is not recorded and the run concludes once the tree\n   557\t\t\t\t\t// matches its bundle again (R2).\n   558\t\t\t\t\tresult.Reasons = append(current, \"not recorded: conclude this run again once the working tree holds its bundle's subject (commit or set aside the local edits)\")\n   559\t\t\t\t\treturn result, nil\n   560\t\t\t\t}\n   561\t\t\t\treasons = append(reasons, current...)\n   562\t\t\t}\n   563\t\t}\n   564\t\tvar key IssuerKey\n   565\t\tif len(reasons) == 0 {\n   566\t\t\tkey, err = LoadIssuerKey(s.Root, issuer)\n   567\t\t\tif err != nil {\n   568\t\t\t\treasons = append(reasons, \"the conclusions issuer cannot sign: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n   569\t\t\t}\n   570\t\t}\n   571\t\tif len(reasons) > 0 {\n   572\t\t\tresult.Reasons = reasons\n   573\t\t\treturn s.publishReviewConclusion(result, apply, takeOver)\n   574\t\t}\n   575\t\tif !apply {\n   576\t\t\tresult.State = ReviewConclusionRecorded\n   577\t\t\tresult.Reasons = []string{\"preview: the run passes the conclusion checks; on apply its proof and its attestation are signed by \" + issuer + \" and recorded if the attestation preflight admits them, which a preview does not run\"}\n   578\t\t\treturn result, nil\n   579\t\t}\n   580\t\t// The reservation records that a conclusion started, for a later one to\n   581\t\t// recover if this one is interrupted.\n   582\t\tpending := result\n   583\t\tpending.State, pending.Reasons = ReviewConclusionPending, nil\n   584\t\treservation, err := s.writeReviewConclusion(pending, takeOver)\n   585\t\tif err != nil {\n   490\t\timplementation, e := runImplementationIdentity(bundle, config.Provenance)\n   491\t\tif e != nil || implementation != p.Implementation || config.Provenance.Trust != p.Trust {\n   492\t\t\treturn fail(\"implementation baseline differs or is unknown\")\n   493\t\t}\n   494\t\treviewer, e := normalizeModelIdentity(ModelIdentity{Principal: adapter.Executor, Vendor: adapter.Vendor, Model: adapter.Model})\n   495\t\trecorded, recordErr := normalizeModelIdentity(ModelIdentity{Principal: p.Reviewer.Principal, Vendor: run.Vendor, Model: run.Model})\n   496\t\tif e != nil || recordErr != nil || recorded != reviewer || reviewer != p.Reviewer {\n   497\t\t\treturn fail(\"reviewer identity differs or is unknown\")\n   498\t\t}\n   499\t\t// The worktree a run was dispatched from is recorded, not required of\n   500\t\t// the reader: a run a CI job or Harne8's Conductor performed in its own\n   501\t\t// checkout of the project verifies in any other, since the project, the\n   502\t\t// audience, the sealed bundle and the brief it binds are the same there\n   503\t\t// (spec pose-delegated-review-action-fulfillment R3, R9; the amendment\n   504\t\t// of 2026-10-28 to the delegation ADR).\n   505\t\tif !validProofDigest(p.WorktreeDigest) {\n   506\t\t\treturn fail(\"the origin worktree of the run is not recorded\")\n   507\t\t}\n   508\t\tbrief, e := s.renderRunBriefMatching(run.BundleID, run.Kind, run.BriefNotes, run.BriefDigest)\n   509\t\t// A handoff run was sent the brief and the section its predecessor's\n   510\t\t// record yields; the verifier derives the same bytes (spec\n   511\t\t// pose-delegation-handoff R4).\n   512\t\tif e == nil && run.HandsOffFrom != \"\" {\n   513\t\t\tprior, priorErr := s.LoadProvenanceReviewRun(run.HandsOffFrom)\n   514\t\t\tif priorErr != nil {\n   515\t\t\t\treturn fail(\"the handoff predecessor cannot be read\")\n   516\t\t\t}\n   517\t\t\tsection := s.recordedHandoffSection(run, prior)\n   518\t\t\tif section == \"\" {\n   519\t\t\t\treturn fail(\"handoff section differs from the predecessor's record\")\n   520\t\t\t}\n   700\t\t}\n   701\t\tif e != nil {\n   702\t\t\treturn assurance, e\n   703\t\t}\n   704\t\trun, e := s.LoadProvenanceReviewRun(att.Run.RunID)\n   705\t\tif e != nil {\n   706\t\t\treturn assurance, e\n   707\t\t}\n   708\t\tif run.BundleID != bundle.BundleID || run.BundleDigest != bundle.BundleDigest || run.Scope != bundle.Payload.Scope.Ref || run.Kind != ReviewBriefKindReview || run.Status != ReviewRunCompleted || !assurance.CompleteReview || att.Reviewer != assurance.Reviewer.Principal {\n   709\t\t\treturn assurance, fmt.Errorf(\"attestation and referenced run context differ\")\n   710\t\t}\n   711\t\tattested, e1 := time.Parse(time.RFC3339Nano, att.AttestedAt)\n   712\t\tended, e2 := time.Parse(time.RFC3339Nano, run.EndedAt)\n   713\t\tissued, e3 := time.Parse(time.RFC3339Nano, assurance.ProofIssuedAt)\n   714\t\tif e1 != nil || e2 != nil || e3 != nil || ended.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) || issued.After(attested.Add(reviewTimestampPrecision(att.AttestedAt))) {\n   715\t\t\treturn assurance, fmt.Errorf(\"run-backed attestation predates its completed run or authenticated run proof\")\n   716\t\t}\n   717\t\tdraft := draftReviewDecision(run.Output)\n   718\t\tapproval := att.Decision == \"approved\" || att.Decision == \"approved-with-reservations\"\n   719\t\tif approval && draft != \"approved\" {\n   720\t\t\treturn assurance, fmt.Errorf(\"run draft does not support an approval: decision is %s\", draft)\n   721\t\t}\n   722\t\tif approval {\n   723\t\t\t// A draft that does not account for the previous round is never an\n   724\t\t\t// approval, whatever its decision line says (spec\n   725\t\t\t// pose-delegated-review-round-protocol R4, R9, D2).\n   726\t\t\tround, err := s.ReviewRoundOf(bundle)\n   727\t\t\tif err != nil {\n   728\t\t\t\treturn assurance, err\n   729\t\t\t}\n   730\t\t\tif problems := ValidateRoundDraft(round, run.Output); len(problems) > 0 {\n   731\t\t\t\treturn assurance, fmt.Errorf(\"the run's draft is invalid for round %d: %s\", round.Number, strings.Join(problems, \"; \"))\n   732\t\t\t}\n   733\t\t}\n   734\t\tif !approval && (draft != \"rejected\" && draft != \"changes-requested\") {\n   735\t\t\treturn assurance, fmt.Errorf(\"run draft does not support a rejecting attestation: decision is %s\", draft)\n   736\t\t}\n   737\t\tif why := runConclusionDiffers(run, bundle, att); why != \"\" {\n   738\t\t\treturn assurance, fmt.Errorf(\"the attestation does not state the run's conclusion: %s\", why)\n   739\t\t}\n   740\t\tif att.Authority == nil || att.Authority.Role != \"agent\" || att.Authority.ReviewExecution != run.RunID || att.Authority.ImplementationPrincipal != assurance.Implementation.Principal || att.Authority.ImplementationExecution != assurance.Implementation.Execution {\n   741\t\t\treturn assurance, fmt.Errorf(\"attestation authority differs from run provenance\")\n   742\t\t}\n   743\t\tif assurance.Implementation.Execution == run.RunID {\n   744\t\t\treturn assurance, fmt.Errorf(\"implementation and review executions are the same\")\n   745\t\t}\n   746\t\tif bundle.Payload.Plan.Independence == \"different-actor\" && !assurance.VendorDifference && !assurance.ModelDifference {\n   747\t\t\treturn assurance, fmt.Errorf(\"reviewer vendor and model both match the implementation\")\n   748\t\t}\n   749\t\tif bundle.Payload.Plan.Independence == \"mandatory-human\" {\n   750\t\t\treturn assurance, fmt.Errorf(\"machine-attested run cannot satisfy mandatory-human\")\n   751\t\t}\n   752\t\treturn assurance, nil\n   753\t}\n   754\tfunc (s Store) runBackedReviewBlockers(bundle ReviewBundle, att ReviewAttestation) []string {\n   755\t\tblockers := s.verifiedAuthorityBlockers(bundle, att)\n   756\t\tif _, e := s.verifyRunReviewReference(bundle, att); e != nil {\n   757\t\t\tblockers = append(blockers, e.Error())\n   758\t\t}\n   759\t\treturn uniqueSorted(blockers)\n   760\t}\n   761\t\n   762\tfunc (s Store) runProofContextConflict(run ReviewRun) string {\n   763\t\tif why := reviewSafetyConflict(run); why != \"\" {\n   764\t\t\treturn why\n   765\t\t}\n   766\t\tif run.Status == ReviewRunCompleted {\n   767\t\t\t// A completed run that does not approve is a fact about the bundle it\n   768\t\t\t// reviewed: its proof needs its own record to stand, not its bundle\n   769\t\t\t// to be the current subject. An approving one still does (spec\n   770\t\t\t// pose-review-conclude-ignores-unrelated-local-edits R1).\n   771\t\t\tif draft, err := ParseReviewDraft(run.Output); err == nil && draft != nil && !reviewDecisionApproves(draft.Decision) {\n   772\t\t\t\treturn s.ReviewRunRecordStands(run)\n   773\t\t\t}\n   774\t\t\treturn s.ReviewRunStillGoverns(run)\n   775\t\t}\n   776\t\tif why := s.reviewRunTranscriptIntact(run); why != \"\" {\n   777\t\t\treturn why\n   778\t\t}\n   779\t\tbundle, e := s.LoadReviewBundle(run.BundleID)\n   780\t\tif e != nil {\n   781\t\t\treturn e.Error()\n   782\t\t}\n   783\t\tif bundle.BundleDigest != run.BundleDigest || bundle.Payload.Scope.Ref != run.Scope || bundle.Payload.Subject.Head != run.SealedCommit {\n   784\t\t\treturn \"run names conflicting sealed inputs\"\n   785\t\t}\n   786\t\treturn s.dispatchNoLongerGoverns(DispatchPlan{Bundle: bundle, Brief: ReviewBrief{Scope: run.Scope}, SealedCommit: run.SealedCommit, PolicyDigest: run.PolicyDigest})\n   787\t}\n   788\t\n   789\tfunc (s Store) provenanceAttemptLineage(run ReviewRun, runs []ReviewRun) error {\n   790\t\tif run.AttemptID == \"\" {\n   791\t\t\treturn fmt.Errorf(\"run provenance has no reserved attempt\")\n   792\t\t}\n   793\t\tattempts, e := s.readDelegatedReviewAttempts(run.BundleID)\n   794\t\tif e != nil {\n   795\t\t\treturn e\n   796\t\t}\n   797\t\tvar rootReceipt *reviewAttemptReceipt\n   798\t\tbudget := int64(32 << 20)\n   799\t\tfor _, attempt := range attempts {\n   800\t\t\treceipt, e := s.readAttemptReceipt(attempt, &budget)\n","exit_code":0,"status":"completed"}}
