 integration:pose-mcp/go/governance-git-reads-untranslated-integration, integration:pose-mcp/go/governance-operation-performance-integration, integration:pose-mcp/go/governance-outcomes-v2-contract, integration:pose-mcp/go/governance-read-view-integration, integration:pose-mcp/go/governance-waits-integration, integration:pose-mcp/go/governed-capabilities-integration, integration:pose-mcp/go/governed-effects-integration, integration:pose-mcp/go/help-lists-every-command-integration, integration:pose-mcp/go/historical-trust-reuse-integration, integration:pose-mcp/go/history-readers-read-raw-integration, integration:pose-mcp/go/hooks-delegate-to-the-instance-runner-integration, integration:pose-mcp/go/index-generation-integrity-integration, integration:pose-mcp/go/index-input-binding-integration, integration:pose-mcp/go/index-material-does-not-ask-closeout-integration, integration:pose-mcp/go/index-material-is-kept-per-repository-state-integration, integration:pose-mcp/go/index-recovery-integration, integration:pose-mcp/go/index-streams-each-commit-once-integration, integration:pose-mcp/go/init-is-install-integration, integration:pose-mcp/go/install-and-upgrade-journeys-integration, integration:pose-mcp/go/journal-checkpoint-and-lock-recovery-integration, integration:pose-mcp/go/launcher-parity, integration:pose-mcp/go/legacy-contract-cutoffs-integration, integration:pose-mcp/go/lint-spec-all-gate-contract, integration:pose-mcp/go/locale-obligation-flags-integration, integration:pose-mcp/go/machine-channel-integration, integration:pose-mcp/go/material-reuse-integration, integration:pose-mcp/go/mcp-action-resolve-integration, integration:pose-mcp/go/mcp-review-attest-integration, integration:pose-mcp/go/migrate-dryrun-integration, integration:pose-mcp/go/milestone-closes-when-reached-integration, integration:pose-mcp/go/milestone-review-proportional-integration, integration:pose-mcp/go/multi-repo-agent-context-integration, integration:pose-mcp/go/multi-repo-agent-negativ