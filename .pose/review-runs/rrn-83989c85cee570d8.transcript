st != \"executor-attested\" {\n   435\t\t\treturn fail(\"captured executor provenance is absent\")\n   600\t\tif proof.ProofID != proofID {\n   601\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run proof filename identity differs\")\n   602\t\t}\n   603\t\treturn s.verifyRunProofAsSealed(proof, run)\n   604\t}\n   605\t\n   606\tfunc (s Store) verifyRunProofAsSealed(proof ReviewRunProof, run ReviewRun) (ReviewRunAssurance, error) {\n   607\t\tfail := func(message string) (ReviewRunAssurance, error) {\n   608\t\t\treturn ReviewRunAssurance{}, fmt.Errorf(\"run provenance: %s\", message)\n   609\t\t}\n   610\t\tif _, e := s.verifyRunProofCore(proof, run); e != nil {\n   611\t\t\treturn ReviewRunAssurance{}, e\n   612\t\t}\n   613\t\tc, p := proof.Claim, run.Provenance\n   614\t\tend, e := time.Parse(time.RFC3339Nano, run.EndedAt)\n   615\t\tissued, e2 := time.Parse(time.RFC3339Nano, c.IssuedAt)\n   616\t\tif e != nil || e2 != nil || issued.Before(end) {\n   617\t\t\treturn fail(\"proof predates the ended run\")\n   618\t\t}\n   619\t\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n   620\t\t\treturn fail(why)\n   621\t\t}\n   622\t\tbundle, e := s.LoadReviewBundle(run.BundleID)\n   623\t\tif e != nil {\n   624\t\t\treturn fail(\"the reviewed bundle cannot be read\")\n   625\t\t}\n   626\t\trecorded, recordErr := normalizeModelIdentity(ModelIdentity{Principal: p.Reviewer.Principal, Vendor: run.Vendor, Model: run.Model})\n   627\t\tif recordErr != nil || recorded != p.Reviewer {\n   628\t\t\treturn fail(\"reviewer identity differs or is unknown\")\n   629\t\t}\n   630\t\tif !validProofDigest(p.WorktreeDigest) {\n   631\t\t\treturn fail(\"the origin worktree of the run is not recorded\")\n   632\t\t}\n   633\t\tswitch p.ExecutionState {\n   634\t\tcase \"started\":\n   635\t\t\tif !validProofDigest(p.ArgvDigest) || !validProofDigest(p.ExecutableDigest) || !validProofDigest(p.RawTranscriptDigest) || !validProofDigest(p.RawOutputDigest) {\n   636\t\t\t\treturn fail