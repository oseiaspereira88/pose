{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc \"git diff --unified=4 ddb770352f35f2f55c740e9a8479686de3a251e5..b79f1c8a60e3af431daa185a35ef2b100f02806b -- pose-mcp/internal/pose/review_conclusions.go pose-mcp/internal/pose/review_run_provenance.go | sed -n '1,340p'\"","aggregated_output":"diff --git a/pose-mcp/internal/pose/review_conclusions.go b/pose-mcp/internal/pose/review_conclusions.go\nindex b660055d..322506fb 100644\n--- a/pose-mcp/internal/pose/review_conclusions.go\n+++ b/pose-mcp/internal/pose/review_conclusions.go\n@@ -121,17 +121,32 @@ func (s Store) reviewConclusionChecks(run ReviewRun) ([]string, *ReviewBundle, *\n \tbundle, err := s.LoadReviewBundle(run.BundleID)\n \tif err != nil {\n \t\treturn append(reasons, \"the run's bundle cannot be read: \"+err.Error()), nil, draft\n \t}\n+\t// The run's own record must stand whatever it concludes. Whether its\n+\t// bundle is still the current subject matters only to an approval: a\n+\t// verdict that requests changes or rejects is a fact about the bundle it\n+\t// reviewed, and the working tree the implementer is already fixing does\n+\t// not change it (spec pose-review-conclude-ignores-unrelated-local-edits R1).\n+\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n+\t\treasons = append(reasons, \"the run no longer governs: \"+why)\n+\t}\n+\treasons = append(reasons, s.verdictCoverageReasons(run, bundle, draft)...)\n+\treturn reasons, &bundle, draft\n+}\n+\n+// reviewConclusionCurrency is why an approval of run's bundle would no longer\n+// approve the current subject.\n+func (s Store) reviewConclusionCurrency(run ReviewRun, bundle ReviewBundle) []string {\n+\tvar reasons []string\n \tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n \tif err != nil || current == nil || current.BundleID != bundle.BundleID {\n \t\treasons = append(reasons, \"the run's bundle no longer governs \"+bundle.Payload.Scope.Ref+\": the subject, the plan or the policy changed since it was sealed\")\n \t}\n \tif why := s.ReviewRunStillGoverns(run); why != \"\" {\n \t\treasons = append(reasons, \"the run no longer governs: \"+why)\n \t}\n-\treasons = append(reasons, s.verdictCoverageReasons(run, bundle, draft)...)\n-\treturn reasons, &bundle, draft\n+\treturn reasons\n }\n \n // reviewAttestationFromDraft builds the attestation a draft concludes, for\n // the run that wrote it. Evidence is the run itself and each evidence the\n@@ -532,8 +547,21 @@ func (s Store) concludeReviewRun(id, issuer string, apply bool, now time.Time, t\n \treasons, bundle, draft := s.reviewConclusionChecks(run)\n \tif draft != nil {\n \t\tresult.Decision = draft.Decision\n \t}\n+\tif bundle != nil && draft != nil && reviewDecisionApproves(draft.Decision) {\n+\t\tif current := s.reviewConclusionCurrency(run, *bundle); len(current) > 0 {\n+\t\t\tif len(reasons) == 0 {\n+\t\t\t\t// Refused only because the subject the working tree holds is\n+\t\t\t\t// not the bundle's: nothing about the run is wrong, so the\n+\t\t\t\t// refusal is not recorded and the run concludes once the tree\n+\t\t\t\t// matches its bundle again (R2).\n+\t\t\t\tresult.Reasons = append(current, \"not recorded: conclude this run again once the working tree holds its bundle's subject (commit or set aside the local edits)\")\n+\t\t\t\treturn result, nil\n+\t\t\t}\n+\t\t\treasons = append(reasons, current...)\n+\t\t}\n+\t}\n \tvar key IssuerKey\n \tif len(reasons) == 0 {\n \t\tkey, err = LoadIssuerKey(s.Root, issuer)\n \t\tif err != nil {\ndiff --git a/pose-mcp/internal/pose/review_run_provenance.go b/pose-mcp/internal/pose/review_run_provenance.go\nindex 81281275..119f691e 100644\n--- a/pose-mcp/internal/pose/review_run_provenance.go\n+++ b/pose-mcp/internal/pose/review_run_provenance.go\n@@ -504,9 +504,9 @@ func (s Store) verifyRunProof(proof ReviewRunProof, run ReviewRun, now time.Time\n \t// of 2026-10-28 to the delegation ADR).\n \tif !validProofDigest(p.WorktreeDigest) {\n \t\treturn fail(\"the origin worktree of the run is not recorded\")\n \t}\n-\tbrief, e := s.RenderReviewBriefMatching(run.BundleID, run.Kind, run.BriefNotes, run.BriefDigest)\n+\tbrief, e := s.renderRunBriefMatching(run.BundleID, run.Kind, run.BriefNotes, run.BriefDigest)\n \t// A handoff run was sent the brief and the section its predecessor's\n \t// record yields; the verifier derives the same bytes (spec\n \t// pose-delegation-handoff R4).\n \tif e == nil && run.HandsOffFrom != \"\" {\n@@ -763,8 +763,15 @@ func (s Store) runProofContextConflict(run ReviewRun) string {\n \tif why := reviewSafetyConflict(run); why != \"\" {\n \t\treturn why\n \t}\n \tif run.Status == ReviewRunCompleted {\n+\t\t// A completed run that does not approve is a fact about the bundle it\n+\t\t// reviewed: its proof needs its own record to stand, not its bundle\n+\t\t// to be the current subject. An approving one still does (spec\n+\t\t// pose-review-conclude-ignores-unrelated-local-edits R1).\n+\t\tif draft, err := ParseReviewDraft(run.Output); err == nil && draft != nil && !reviewDecisionApproves(draft.Decision) {\n+\t\t\treturn s.ReviewRunRecordStands(run)\n+\t\t}\n \t\treturn s.ReviewRunStillGoverns(run)\n \t}\n \tif why := s.reviewRunTranscriptIntact(run); why != \"\" {\n \t\treturn why\n@@ -843,8 +850,13 @@ func runProvenanceCommand(cmd *exec.Cmd, text string) (digest string, count int6\n \tif e = cmd.Start(); e != nil {\n \t\tstdin.Close()\n \t\treturn \"\", 0, false, false, e\n \t}\n+\tif e = attachReviewProcessTree(cmd); e != nil {\n+\t\tstdin.Close()\n+\t\t_ = cmd.Wait()\n+\t\treturn \"\", 0, false, true, e\n+\t}\n \ttype result struct {\n \t\tdigest string\n \t\tcount  int64\n \t\terr    error\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_brief.go | sed -n '105,285p' && nl -ba pose-mcp/internal/pose/review_conclusion_local_edits_test.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_brief.go | sed -n '105,285p' && nl -ba pose-mcp/internal/pose/review_conclusion_local_edits_test.go\"","aggregated_output":"   105\t// reviewBriefFromEngineTools reports /9 and the templates that keep its text.\n   106\tfunc reviewBriefFromEngineTools(template string) bool {\n   107\t\treturn template == reviewBriefTemplateEngineTools || template == reviewBriefTemplateFinishCommands\n   108\t}\n   109\t\n   110\t// reviewBriefAsksConclusion reports a template that asks for the typed conclusion.\n   111\tfunc reviewBriefAsksConclusion(template string) bool {\n   112\t\treturn reviewBriefFromAllNotApplicable(template) || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions || template == reviewBriefTemplateTypedConclusion\n   113\t}\n   114\t\n   115\t// briefRulesTextV5 is the statement of the rules the conclusion is checked against that\n   116\t// review-brief/4 and /5 carry, byte for byte; a version never changes its text.\n   117\tconst briefRulesTextV5 = \"POSE checks the conclusion before it records it, and refuses the whole draft when one rule breaks: (a) a `passed` criterion of kind judgment carries a `rationale` saying what you examined and what you concluded; (b) the `evidence` of a `passed` criterion is exactly one of the refs listed under Sealed evidence (`<class>:<id>`, of a class the criterion asks for when it names one), never a file and line, a command or a structural fact id: those go in a finding or in the `rationale`; (c) a criterion disposed `finding` carries as its `evidence` the `id` of a finding listed in `findings`, and that finding is open until you give it `action`, `owner` and `review_by`; (d) each structural fact listed above is answered by the criterion that asks for structural mapping, as its `mappings`: `[{\\\"delta\\\": <fact id>, \\\"basis\\\": <requirement or decision ref>, \\\"disposition\\\": \\\"mapped\\\", \\\"rationale\\\": <why>}]`, or `not-applicable` with the reason; (e) a `not-applicable` carries a `rationale` and is refused when the bundle seals evidence of a class the criterion asks for; (f) every required criterion and every tool above is answered; (g) the `disposition` of a tool is `passed`, `failed`, `not-used` or `deferred`, never anything else (`not-run` is refused); a tool listed as required must be run and `passed`, with the ref of the sealed evidence it produced as `evidence` when it names classes, and `not-used` is accepted for a required tool only when the plan says no producer exists; a recommended tool you did not run is `not-used` with a `rationale`; (h) the `evidence` of a tool is `<class>:<ref>`: when the tool lists evidence classes, a ref of one of them that the bundle sealed (listed under Sealed evidence), otherwise `command:` followed by the command you ran; a bare command line is refused; (i) a draft that approves leaves no finding open: each finding is either a follow-up with `action`, `owner` and `review_by`, which is recorded as an accepted risk, or the draft requests changes; a finding without them is open and the approval is refused.\"\n   118\t\n   119\t// briefRulesText is the statement of those rules in the brief of template. review-brief/6 also\n   120\t// says which severities the sealed policy lets a follow-up be accepted at, that a tool whose\n   121\t// precondition is the completion of the review is answered deferred, the component scoping of\n   122\t// evidence, and what a mapping's basis is.\n   123\tfunc briefRulesText(template string, bundle ReviewBundle) string {\n   124\t\tif template != reviewBriefTemplateRiskRules && !reviewBriefFromAllNotApplicable(template) {\n   125\t\t\treturn briefRulesTextV5\n   126\t\t}\n   127\t\ttext := briefRulesTextV5\n   128\t\tseverities := strings.Join(bundle.Payload.SealedGates().AcceptedRiskSeverities, \", \")\n   129\t\tif severities == \"\" {\n   130\t\t\tseverities = \"none\"\n   131\t\t}\n   132\t\ttext = strings.Replace(text, \"a recommended tool you did not run is `not-used` with a `rationale`;\", \"a recommended tool you did not run is `not-used` with a `rationale`; a required tool whose precondition is the completion of the review (`review-check`, `closeout-check`) cannot pass before your attestation: answer it `deferred` with a `rationale`;\", 1)\n   133\t\ttext = strings.Replace(text, \"which is recorded as an accepted risk, or the draft requests changes;\", \"which is recorded as an accepted risk only when its severity is one the sealed review policy accepts (\"+severities+\"), or the draft requests changes and any finding of another severity is fixed first;\", 1)\n   134\t\tif reviewBriefFromAllNotApplicable(template) {\n   135\t\t\ttext += \" (l) a draft that dispenses with every required criterion as `not-applicable` is refused: a scope whose whole plan is inapplicable is not reviewed by it;\"\n   136\t\t}\n   137\t\treturn text + \" (j) the `evidence` of a `passed` criterion is of a class the criterion asks for and, when the criterion or tool belongs to a component, of that component (the Sealed evidence list names the module of each ref); (k) the `basis` of a mapping is a requirement or decision id of the scope's spec, such as R1 or D1.\"\n   138\t}\n   139\t\n   140\t// reviewBriefStatesRules reports a template that states the rules the conclusion is\n   141\t// checked against.\n   142\tfunc reviewBriefStatesRules(template string) bool {\n   143\t\treturn reviewBriefFromAllNotApplicable(template) || template == reviewBriefTemplateRiskRules || template == reviewBriefTemplateRoundIDs || template == reviewBriefTemplateConclusions\n   144\t}\n   145\t\n   146\t// reviewBriefEarlierTemplates are the review templates a run may have been\n   147\t// briefed with before the current one, newest first; a run briefed with one\n   148\t// is re-rendered with it to verify and to continue (the brief a run was sent\n   149\t// never changes under it).\n   150\tvar reviewBriefEarlierTemplates = []string{reviewBriefTemplateEngineTools, reviewBriefTemplateDraftCheck, reviewBriefTemplateAllNotApplicable, reviewBriefTemplateRiskRules, reviewBriefTemplateRoundIDs, reviewBriefTemplateConclusions, reviewBriefTemplateTypedConclusion, reviewBriefTemplateRounds, reviewBriefTemplateFirst}\n   151\t\n   152\t// briefEarlierTemplates are, per kind, the templates a run may have been\n   153\t// briefed with before the current one, newest first.\n   154\tvar briefEarlierTemplates = map[string][]string{\n   155\t\tReviewBriefKindReview:       reviewBriefEarlierTemplates,\n   156\t\tReviewBriefKindAdjudication: {adjudicationBriefTemplateFirst},\n   157\t\tReviewBriefKindSmoke:        {smokeBriefTemplateFirst},\n   158\t}\n   159\t\n   160\t// ReviewBriefKinds lists the accepted kinds.\n   161\tfunc ReviewBriefKinds() []string {\n   162\t\treturn []string{ReviewBriefKindReview, ReviewBriefKindAdjudication, ReviewBriefKindSmoke}\n   163\t}\n   164\t\n   165\t// RenderReviewBrief renders the brief of kind for target, a bundle id or a\n   166\t// scope ref, from its current sealed bundle. A superseded bundle is refused:\n   167\t// a brief for it would ask a reviewer to judge content that has moved.\n   168\tfunc (s Store) RenderReviewBrief(target, kind string, notes string) (ReviewBrief, error) {\n   169\t\treturn s.renderReviewBriefAs(target, kind, notes, \"\")\n   170\t}\n   171\t\n   172\t// RenderReviewBriefMatching renders the brief a run was sent: the current\n   173\t// template, or the one before it when that is the one whose digest the run\n   174\t// recorded, so a run briefed before the round protocol still verifies and\n   175\t// continues.\n   176\tfunc (s Store) RenderReviewBriefMatching(target, kind, notes, digest string) (ReviewBrief, error) {\n   177\t\treturn s.renderReviewBriefMatching(target, kind, notes, digest, true)\n   178\t}\n   179\t\n   180\t// renderRunBriefMatching re-renders the brief a run of bundle target was\n   181\t// sent, whether or not the bundle is still the current subject: a run is\n   182\t// verified against what it reviewed. Whether an approval still approves the\n   183\t// current subject is decided apart (spec\n   184\t// pose-review-conclude-ignores-unrelated-local-edits R1).\n   185\tfunc (s Store) renderRunBriefMatching(target, kind, notes, digest string) (ReviewBrief, error) {\n   186\t\treturn s.renderReviewBriefMatching(target, kind, notes, digest, false)\n   187\t}\n   188\t\n   189\tfunc (s Store) renderReviewBriefMatching(target, kind, notes, digest string, requireCurrent bool) (ReviewBrief, error) {\n   190\t\tbrief, err := s.renderReviewBriefAsCurrent(target, kind, notes, \"\", requireCurrent)\n   191\t\tif err != nil || brief.Digest == digest {\n   192\t\t\treturn brief, err\n   193\t\t}\n   194\t\tif kind == \"\" {\n   195\t\t\tkind = ReviewBriefKindReview\n   196\t\t}\n   197\t\tfor _, version := range briefEarlierTemplates[kind] {\n   198\t\t\tif earlier, eerr := s.renderReviewBriefAsCurrent(target, kind, notes, version, requireCurrent); eerr == nil && earlier.Digest == digest {\n   199\t\t\t\treturn earlier, nil\n   200\t\t\t}\n   201\t\t}\n   202\t\treturn brief, nil\n   203\t}\n   204\t\n   205\tfunc (s Store) renderReviewBriefAs(target, kind, notes, version string) (ReviewBrief, error) {\n   206\t\treturn s.renderReviewBriefAsCurrent(target, kind, notes, version, true)\n   207\t}\n   208\t\n   209\tfunc (s Store) renderReviewBriefAsCurrent(target, kind, notes, version string, requireCurrent bool) (ReviewBrief, error) {\n   210\t\tif kind == \"\" {\n   211\t\t\tkind = ReviewBriefKindReview\n   212\t\t}\n   213\t\ttemplate, ok := reviewBriefTemplates[kind]\n   214\t\tif !ok {\n   215\t\t\treturn ReviewBrief{}, fmt.Errorf(\"pose: unknown brief kind %q; kinds: %s\", kind, strings.Join(ReviewBriefKinds(), \", \"))\n   216\t\t}\n   217\t\tif version != \"\" {\n   218\t\t\ttemplate = version\n   219\t\t}\n   220\t\tvar bundle ReviewBundle\n   221\t\tif strings.HasPrefix(target, \"rvb-\") {\n   222\t\t\tloaded, err := s.LoadReviewBundle(target)\n   223\t\t\tif err != nil {\n   224\t\t\t\treturn ReviewBrief{}, err\n   225\t\t\t}\n   226\t\t\tif requireCurrent {\n   227\t\t\t\tcurrent, err := s.CurrentReviewBundle(loaded.Payload.Scope.Ref)\n   228\t\t\t\tif err != nil {\n   229\t\t\t\t\treturn ReviewBrief{}, err\n   230\t\t\t\t}\n   231\t\t\t\tif current == nil || current.BundleID != loaded.BundleID {\n   232\t\t\t\t\treturn ReviewBrief{}, fmt.Errorf(\"pose: bundle %s is superseded by current semantic inputs; seal the scope again and brief the new bundle\", target)\n   233\t\t\t\t}\n   234\t\t\t}\n   235\t\t\tbundle = loaded\n   236\t\t} else {\n   237\t\t\tcurrent, err := s.CurrentReviewBundle(target)\n   238\t\t\tif err != nil {\n   239\t\t\t\treturn ReviewBrief{}, err\n   240\t\t\t}\n   241\t\t\tif current == nil {\n   242\t\t\t\treturn ReviewBrief{}, fmt.Errorf(\"pose: %s has no current sealed bundle; seal it with pose review bundle %s --seal\", target, target)\n   243\t\t\t}\n   244\t\t\tbundle = *current\n   245\t\t}\n   246\t\tvar smoke *smokeScript\n   247\t\tif kind == ReviewBriefKindSmoke {\n   248\t\t\tscript, err := s.smokeScriptFor(bundle.Payload.Scope)\n   249\t\t\tif err != nil {\n   250\t\t\t\treturn ReviewBrief{}, err\n   251\t\t\t}\n   252\t\t\tsmoke = &script\n   253\t\t}\n   254\t\tvar round *ReviewRound\n   255\t\tif template == reviewBriefTemplateRounds || reviewBriefAsksConclusion(template) {\n   256\t\t\tderived, err := s.ReviewRoundOf(bundle)\n   257\t\t\tif err != nil {\n   258\t\t\t\treturn ReviewBrief{}, err\n   259\t\t\t}\n   260\t\t\tround = &derived\n   261\t\t}\n   262\t\tvar questions []AdjudicationQuestion\n   263\t\tif template == adjudicationBriefTemplateTyped {\n   264\t\t\tasked, err := s.AdjudicationQuestions(bundle.Payload.Scope)\n   265\t\t\tif err != nil {\n   266\t\t\t\treturn ReviewBrief{}, err\n   267\t\t\t}\n   268\t\t\tquestions = asked\n   269\t\t}\n   270\t\tbody := renderReviewBriefBody(bundle, kind, template, notes, smoke, round, reviewBriefAsksConclusion(template), questions)\n   271\t\tsum := sha256.Sum256([]byte(body))\n   272\t\tdigest := \"sha256:\" + hex.EncodeToString(sum[:])\n   273\t\treturn ReviewBrief{Kind: kind, TemplateVersion: template, Scope: bundle.Payload.Scope.Ref, BundleID: bundle.BundleID,\n   274\t\t\tBundleDigest: bundle.BundleDigest, Digest: digest, Text: body + \"\\n<!-- brief-digest: \" + digest + \" -->\\n\"}, nil\n   275\t}\n   276\t\n   277\t// smokeScript is what a smoke run exercises: each delivered surface with its\n   278\t// entrypoint, and the requirements it is observed against. Without it a\n   279\t// smoke brief only repeated the review criteria (found in review).\n   280\ttype smokeScript struct {\n   281\t\tSurfaces     []DeliveryTarget\n   282\t\tRequirements []string\n   283\t}\n   284\t\n   285\tfunc (s Store) smokeScriptFor(scope ReviewBundleScope) (smokeScript, error) {\n     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"os\"\n     5\t\t\"path/filepath\"\n     6\t\t\"strings\"\n     7\t\t\"testing\"\n     8\t\t\"time\"\n     9\t)\n    10\t\n    11\t// editSealedSubject changes a file the bundle sealed, in the working tree\n    12\t// only, and returns how to restore it.\n    13\tfunc editSealedSubject(t *testing.T, f runProvenanceFixture) func() {\n    14\t\tt.Helper()\n    15\t\tfor _, entry := range f.bundle.Payload.Subject.Entries {\n    16\t\t\tif entry.Class == \"submodule\" || entry.Action == \"removed\" {\n    17\t\t\t\tcontinue\n    18\t\t\t}\n    19\t\t\tpath := entry.Path\n    20\t\t\tif entry.NewPath != \"\" {\n    21\t\t\t\tpath = entry.NewPath\n    22\t\t\t}\n    23\t\t\tfull := filepath.Join(f.store.Root, filepath.FromSlash(path))\n    24\t\t\tbefore, err := os.ReadFile(full)\n    25\t\t\tif err != nil {\n    26\t\t\t\tcontinue\n    27\t\t\t}\n    28\t\t\tif err := os.WriteFile(full, append(append([]byte{}, before...), []byte(\"\\n// a fix for the next round\\n\")...), 0o644); err != nil {\n    29\t\t\t\tt.Fatal(err)\n    30\t\t\t}\n    31\t\t\treturn func() {\n    32\t\t\t\tif err := os.WriteFile(full, before, 0o644); err != nil {\n    33\t\t\t\t\tt.Fatal(err)\n    34\t\t\t\t}\n    35\t\t\t}\n    36\t\t}\n    37\t\tt.Fatal(\"the bundle seals no editable file\")\n    38\t\treturn nil\n    39\t}\n    40\t\n    41\t// Spec pose-review-conclude-ignores-unrelated-local-edits R1, R3: a run that\n    42\t// requests changes is concluded while the implementer already edits the\n    43\t// sealed subject in the working tree.\n    44\tfunc TestARequestForChangesConcludesOverLocalEdits(t *testing.T) {\n    45\t\tf, draftPath := conclusionFixture(t)\n    46\t\tatt := approvedBundleAttestation(f.bundle, \"agent:reviewer\")\n    47\t\tatt.Decision = \"changes-requested\"\n    48\t\tfindings := []ReviewDraftFinding{{ID: \"B1\", Severity: \"high\", Disposition: \"blocker\", File: \"x.go\", Line: 3, Summary: \"a defect\"}}\n    49\t\tif err := os.WriteFile(draftPath, []byte(draftFrom(t, att, findings)), 0o600); err != nil {\n    50\t\t\tt.Fatal(err)\n    51\t\t}\n    52\t\trun := dispatchConclusion(t, f, \"changes requested over local edits\")\n    53\t\tdefer editSealedSubject(t, f)()\n    54\t\tconclusion, err := f.store.ConcludeReviewRun(run.RunID, f.key.Name, true, time.Now())\n    55\t\tif err != nil || conclusion.State != ReviewConclusionRecorded || conclusion.Decision != \"changes-requested\" {\n    56\t\t\tt.Fatalf(\"a request for changes was refused over local edits: %+v %v\", conclusion, err)\n    57\t\t}\n    58\t}\n    59\t\n    60\t// R2, R3: an approval refused only because the working tree no longer holds\n    61\t// its bundle's subject leaves no record, and the same run concludes once the\n    62\t// tree matches again.\n    63\tfunc TestAnApprovalOverLocalEditsIsNotRecordedAndConcludesLater(t *testing.T) {\n    64\t\tf, draftPath := conclusionFixture(t)\n    65\t\tatt := approvedBundleAttestation(f.bundle, \"agent:reviewer\")\n    66\t\tif err := os.WriteFile(draftPath, []byte(draftFrom(t, att, nil)), 0o600); err != nil {\n    67\t\t\tt.Fatal(err)\n    68\t\t}\n    69\t\trun := dispatchConclusion(t, f, \"approval over local edits\")\n    70\t\trestore := editSealedSubject(t, f)\n    71\t\trefused, err := f.store.ConcludeReviewRun(run.RunID, f.key.Name, true, time.Now())\n    72\t\tif err != nil || refused.State != ReviewConclusionRefused || !strings.Contains(strings.Join(refused.Reasons, \";\"), \"not recorded\") {\n    73\t\t\tt.Fatalf(\"an approval over local edits: %+v %v\", refused, err)\n    74\t\t}\n    75\t\tif existing, _ := f.store.ReadReviewConclusion(run.RunID); existing != nil {\n    76\t\t\tt.Fatalf(\"the refusal over local edits was recorded: %+v\", existing)\n    77\t\t}\n    78\t\trestore()\n    79\t\tconclusion, err := f.store.ConcludeReviewRun(run.RunID, f.key.Name, true, time.Now())\n    80\t\tif err != nil || conclusion.State != ReviewConclusionRecorded || conclusion.Attestation == \"\" {\n    81\t\t\tt.Fatalf(\"the approval did not conclude once the tree matched: %+v %v\", conclusion, err)\n    82\t\t}\n    83\t}\n","exit_code":0,"status":"completed"}}
