integration:pose-mcp/go/review-assurance-disclosure-integration, integration:pose-mcp/go/review-attribution-roles-integration, integration:pose-mcp/go/review-brief-conclusion-rules-integration, integration:pose-mcp/go/review-brief-templates-are-immutable-integration, integration:pose-mcp/go/review-bundle-convergence, integration:pose-mcp/go/review-cleanup-removes-go-build-leftovers-integration, integration:pose-mcp/go/review-evidence-fixture-integration, integration:pose-mcp/go/review-guard-reads-the-integrity-graph-in-place-integration, integration:pose-mcp/go/review-ledger-is-read-once-per-operation-integration, integration:pose-mcp/go/review-policy-adoption-integration, integration:pose-mcp/go/review-soundness-residuals-integration, integration:pose-mcp/go/review-subject-capabilities-integration, integration:pose-mcp/go/review-subject-head-integration, integration:pose-mcp/go/review-subject-later-removal-integration, integration:pose-mcp/go/roadmap-close-keeps-approvals-integration, integration:pose-mcp/go/roadmap-reviews-findings-integration, integration:pose-mcp/go/runtime-qos-integration, integration:pose-mcp/go/sealed-checkout-child-evidence-integration, integration:pose-mcp/go/setup-command-integration, integration:pose-mcp/go/signed-action-answers-integration, integration:pose-mcp/go/source-coverage-integrity-integration, integration:pose-mcp/go/spec-authority-transfer-integration, integration:pose-mcp/go/spec-authority-transfer-mcp-status, integration:pose-mcp/go/spec-authority-transfer-negative-gates, integration:pose-mcp/go/spec-facts-evidence-binding-integration, integration:pose-mcp/go/spec-surface-integration, integration:pose-mcp/go/state-attention-integration, integration:pose-mcp/go/strict-json-readers-require-the-end-integration, integration:pose-mcp/go/test-git-isolation-integration, integration:pose-mcp/go/test-scripts-remove-their-temp-files-integration, integration:pose-mcp/go/trace-test-refs-integration, integration:pose-mcp/go/transfer-actio