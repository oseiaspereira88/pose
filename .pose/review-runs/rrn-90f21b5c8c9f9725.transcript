{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,180p' pose-mcp/internal/cli/cli.go\"","aggregated_output":"// Package cli implements the native-only unified `pose` binary.\npackage cli\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n)\n\n// Version mirrors the authoritative release version. The release pipeline\n// stamps internal/version via -ldflags (spec pose-version-contract).\nvar Version = version.Version\n\n// The engine package records the version in assessment bindings without\n// importing internal/version (spec pose-engine-package-stays-mirrorable).\nfunc init() {\n\tposemodel.EngineVersion = version.Version\n\tposemodel.EngineReleaseBase = version.ReleaseBase()\n}\n\n// Main is the entrypoint used by cmd/pose. It returns the process exit code.\nfunc Main(args []string, stdout, stderr io.Writer) int {\n\treturn mainWithUsage(args, stdout, stderr)\n}\n\nfunc mainCommand(args []string, stdout, stderr io.Writer) int {\n\tlocale := cliLocaleFor(stderr)\n\tcmd := \"help\"\n\tif len(args) > 0 {\n\t\tcmd = args[0]\n\t\targs = args[1:]\n\t}\n\n\tif cmd == \"help\" {\n\t\treturn cmdHelp(stdout, args)\n\t}\n\n\tif hasHelpFlag(args) || cmd == \"-h\" || cmd == \"--help\" {\n\t\tif cmd == \"-h\" || cmd == \"--help\" {\n\t\t\treturn cmdHelp(stdout, nil)\n\t\t}\n\t\tif dispatchCommandHelp(cmd, args, stdout, locale) {\n\t\t\treturn 0\n\t\t}\n\t\treturn cmdHelp(stdout, []string{cmd})\n\t}\n\n\tswitch cmd {\n\tcase \"version\", \"--version\", \"-v\":\n\t\ttarget := \"\"\n\t\tif len(args) > 0 {\n\t\t\ttarget = args[0]\n\t\t}\n\t\treturn cmdVersion(stdout, target)\n\tcase \"init\":\n\t\troot, err := projectRoot()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose init: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\treturn cmdInitCommand(root, args, stdout, stderr)\n\tc