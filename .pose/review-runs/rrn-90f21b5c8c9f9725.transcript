abilityStatesIn(files Files, root string) ([]CapabilityState, error) {\n func CapabilityStates(root string) ([]CapabilityState, error) {\n \treturn CapabilityStatesIn(NativeFiles(), root)\n }\n+\n+// closeoutPairPresent reports a policy that carries the closeout review pair,\n+// whose schema (5) no other capability may lower.\n+func closeoutPairPresent(docs PolicyDocs) bool {\n+\t_, milestone := docs.Review[MilestoneReviewRequiredKey]\n+\t_, roadmap := docs.Review[RoadmapReviewRequiredKey]\n+\treturn milestone || roadmap\n+}\n+\n+// SetCloseoutReviewPolicy writes both closeout review keys and schema 5\n+// together (spec pose-closeout-review-policy-by-cost-benefit R2, R6). It is the\n+// one producer for adoption, install defaults and later changes, so the pair\n+// is never written half.\n+func SetCloseoutReviewPolicy(docs PolicyDocs, milestone, roadmap string) ([]string, error) {\n+\tif !validCloseoutReviewValue(milestone) || !validCloseoutReviewValue(roadmap) {\n+\t\treturn nil, fmt.Errorf(\"pose: %s and %s take never, when-justified or always (got %q, %q)\", MilestoneReviewRequiredKey, RoadmapReviewRequiredKey, milestone, roadmap)\n+\t}\n+\tchanges := []string{}\n+\tif schemaVersionOf(docs) != CloseoutReviewPolicySchemaVersion {\n+\t\tdocs.Review[\"schema_version\"] = CloseoutReviewPolicySchemaVersion\n+\t\tchanges = append(changes, fmt.Sprintf(\"set schema_version=%d\", CloseoutReviewPolicySchemaVersion))\n+\t}\n+\tfor _, pair := range [][2]string{{MilestoneReviewRequiredKey, milestone}, {RoadmapReviewRequiredKey, roadmap}} {\n+\t\tif current, _ := docs.Review[pair[0]].(string); current != pair[1] {\n+\t\t\tdocs.Review[pair[0]] = pair[1]\n+\t\t\tchanges = append(changes, \"set \"+pair[0]+\"=\"+pair[1])\n+\t\t}\n+\t}\n+\treturn changes, nil\n+}\n+\n+// CloseoutReviewPolicyEffective describes the rule a policy applies today: the\n+// adopted pair, or the legacy rule it keeps until adoption.\n+func CloseoutReviewPolicyEffective(docs PolicyDocs) (adopted bool, milestone, roadmap string) {\n+\tif !closeoutPairPresent(docs) {\n+\t\treturn false, \"legacy (a one-member milestone inherits its spec; others and roadmaps owe their own review)\", \"legacy (owes its own review)\"\n+\t}\n+\tmilestone, _ = docs.Review[MilestoneReviewRequiredKey].(string)\n+\troadmap, _ = docs.Review[RoadmapReviewRequiredKey].(string)\n+\treturn true, milestone, roadmap\n+}\n+\n+func closeoutReviewPolicyCatalogEntry() CatalogEntry {\n+\treturn CatalogEntry{\n+\t\tID: \"closeout-review-policy\", Summary: \"milestone and roadmap reviews by cost and benefit\", IntroducedIn: \"7.4.1\", DefaultForNew: true,\n+\t\tEffect: \"the close of a milestone or a roadmap owes its own review only as milestone_review_required and roadmap_review_required say (never, when-justified, always); `pose close` stays explicit and records why\",\n+\t\tAdopt: func(docs PolicyDocs, _ string) []string {\n+\t\t\tif closeoutPairPresent(docs) {\n+\t\t\t\treturn nil\n+\t\t\t}\n+\t\t\tchanges, _ := SetCloseoutReviewPolicy(docs, CloseoutReviewNever, CloseoutReviewNever)\n+\t\t\treturn changes\n+\t\t},\n+\t\tRetire:        func(PolicyDocs) []string { return nil },\n+\t\tRetireRefusal: \"closeout-review-policy cannot be turned off: removing the pair would reinterpret closes already recorded under it; change the values with `pose adopt closeout-review-policy --milestone-review-required <v> --roadmap-review-required <v> --apply`\",\n+\t\tAdopted:       func(docs PolicyDocs) bool { return closeoutPairPresent(docs) },\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex 0782e239..5d03f40d 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -131,6 +131,10 @@ type ReviewPlan struct {\n \tWarnings                  []string `json:\"warnings,omitempty\"`\n \tBlockers                  []string `json:\"blockers,omitempty\"`\n \tExplain                   []string `json:\"explain\"`\n+\t// CloseoutReview is the closeout-review@1 decision for a milestone or a\n+\t// roadmap under an adopted policy. Like Band it is a projection: it stays\n+\t// out of the plan digest (spec pose-closeout-review-policy-by-cost-benefit).\n+\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n }\n \n type reviewRepoEntry struct {\n@@ -397,6 +401,16 @@ func (s Store) ReviewPlan(ref string) (ReviewPlan, error) {\n \tif err != nil {\n \t\treturn ReviewPlan{}, err\n \t}\n+\t// Warnings and Explain enter the digest; the decision does not, so it is\n+\t// attached only as its own field. A gate that cannot answer (a corrupt or\n+\t// drifted receipt) fails the plan as it fails closeout-check.\n+\tif !s.planWithoutCloseoutGate {\n+\t\tdecision, _, gateErr := s.closeoutReviewGate(ref, policy)\n+\t\tif gateErr != nil {\n+\t\t\treturn ReviewPlan{}, gateErr\n+\t\t}\n+\t\tplan.CloseoutReview = decision\n+\t}\n \treturn plan, nil\n }\n \n@@ -1085,6 +1099,7 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \tif err != nil {\n \t\treturn criteria, blockers\n \t}\n+\tadopted, _ := s.closeoutReviewPolicyAdopted()\n \tfor _, rm := range roadmaps {\n \t\tif terminalStatuses[rm.Status] {\n \t\t\tcontinue\n@@ -1094,10 +1109,19 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\tref := ScopeRef{Kind: \"milestone\", Roadmap: rm.Slug, Milestone: milestone.ID}\n-\t\t\tif member, ok := s.soleMemberOf(ref); !ok || member != scope.Slug {\n+\t\t\tmember, ok := s.soleMemberOf(ref)\n+\t\t\tcarries := ok && member == scope.Slug\n+\t\t\t// Under an adopted closeout review policy a milestone of more\n+\t\t\t// members may close without its own review; its gate is then\n+\t\t\t// judged in the review of its last member (spec\n+\t\t\t// pose-closeout-review-policy-by-cost-benefit, review round 5 N19).\n+\t\t\tif !carries && adopted {\n+\t\t\t\tcarries = s.lastOpenMemberOf(rm.Slug, milestone, scope.Slug)\n+\t\t\t}\n+\t\t\tif !carries {\n \t\t\t\tcontinue\n \t\t\t}\n-\t\t\tif done && !sealedCarries(\"milestone-exit-gate-\"+rm.Slug+\"-\"+milestone.ID) {\n+\t\t\tif done && !sealedCarries(milestoneExitGateCriterionID(rm.Slug, milestone.ID)) {\n \t\t\t\tif historyUnknown != \"\" {\n \t\t\t\t\t// Absent history is not unreadable history: the plan says it cannot\n \t\t\t\t\t// tell whether the gate was sealed, instead of silently dropping it.\n@@ -1106,8 +1130,8 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\tcriteria, blockers = addReviewCriterion(criteria, ReviewPlanCriterion{\n-\t\t\t\tID:          \"milestone-exit-gate-\" + rm.Slug + \"-\" + milestone.ID,\n-\t\t\t\tDescription: \"The exit gate of milestone:\" + rm.Slug + \"/\" + milestone.ID + \" holds: \" + milestone.ExitGate,\n+\t\t\t\tID:          milestoneExitGateCriterionID(rm.Slug, milestone.ID),\n+\t\t\t\tDescription: milestoneExitGateCriterionDescription(rm.Slug, milestone.ID, milestone.ExitGate),\n \t\t\t\tRequired:    true,\n \t\t\t\tKind:        ReviewCriterionKindJudgment,\n \t\t\t\tProfiles:    []string{\"milestone-exit-gate\"},\ndiff --git a/pose-mcp/internal/pose/spec_transfer.go b/pose-mcp/internal/pose/spec_transfer.go\nindex 09ae1fe4..1fd62349 100644\n--- a/pose-mcp/internal/pose/spec_transfer.go\n+++ b/pose-mcp/internal/pose/spec_transfer.go\n@@ -528,7 +528,7 @@ func requireSpecTransferCapability(files Files, store Store) error {\n \tif err != nil {\n \t\treturn specTransferError(\"unsupported-policy\")\n \t}\n-\tif policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion || policy.QualifiedArtifactRefsVersion != 1 || policy.SpecAuthorityTransferVersion != 1 {\n+\tif (policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && policy.SchemaVersion != CloseoutReviewPolicySchemaVersion) || policy.QualifiedArtifactRefsVersion != 1 || policy.SpecAuthorityTransferVersion != 1 {\n \t\treturn specTransferError(\"spec-authority-transfer-capability-not-adopted\")\n \t}\n \treturn nil\n","exit_code":0,"status":"completed"}}
