mcp/internal/pose/review_closeout.go:2580 \tdefault:\npose-mcp/internal/pose/review_closeout.go:2720 \t\t\tif milestone.ID != scope.Milestone {\npose-mcp/internal/pose/review_closeout.go:2721 \t\t\t\tcontinue\npose-mcp/internal/pose/review_closeout.go:2722 \t\t\t}\npose-mcp/internal/pose/review_closeout.go:2723 \t\t\tfound = true\npose-mcp/internal/pose/review_closeout.go:2724 \t\t\tfor _, raw := range milestone.Specs {\npose-mcp/internal/pose/review_closeout.go:2725 \t\t\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\npose-mcp/internal/pose/review_closeout.go:2726 \t\t\t\tif unresolved != \"\" {\npose-mcp/internal/pose/review_closeout.go:2727 \t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", unresolved, raw))\npose-mcp/internal/pose/review_closeout.go:2728 \t\t\t\t\tcontinue\npose-mcp/internal/pose/review_closeout.go:2729 \t\t\t\t}\npose-mcp/internal/pose/review_closeout.go:2730 \t\t\t\tif external {\npose-mcp/internal/pose/review_closeout.go:2731 \t\t\t\t\tif s.FederatedResolver == nil {\npose-mcp/internal/pose/review_closeout.go:2732 \t\t\t\t\t\tblock(NewDiagnostic(\"external-member-unaccepted\", \"external member \"+raw+\" needs federated acceptance\", raw))\npose-mcp/internal/pose/review_closeout.go:2733 \t\t\t\t\t}\npose-mcp/internal/pose/review_closeout.go:2734 \t\t\t\t\tcontinue\npose-mcp/internal/pose/review_closeout.go:2735 \t\t\t\t}\npose-mcp/internal/pose/review_closeout.go:2736 \t\t\t\tchild, err := childStore.getCloseoutState(\"spec:\"+slug, false)\npose-mcp/internal/pose/review_closeout.go:2737 \t\t\t\tif err != nil {\npose-mcp/internal/pose/review_closeout.go:2738 \t\t\t\t\treturn state, err\npose-mcp/internal/pose/review_closeout.go:2739 \t\t\t\t}\npose-mcp/internal/pose/review_closeout.go:2740 \t\t\t\tstate.Children = append(state.Children, child)\npose-mcp/internal/pose/review_closeout.go:2741 \t\t\t\t// A roadmap may declare why a terminal member owes this milestone nothing.\npose-mcp/internal/pose/review_closeout.go:2742 \t\t\t\tif !child.Terminal && !(review.Approved && s.declaredUnreviewed(scope) != \"\") {\npose-mcp/internal/pose/review_closeout.go:2743 \t\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\npose-mcp/internal/pose/review_closeout.go:2744 \t\t\t\t}\npose-mcp/internal/pose/review_closeout.go:2745 \t\t\t}\npose-mcp/internal/pose/review_closeout.go:2746 \t\t\t// An exempt milestone has no review of its own to judge its exit\npose-mcp/internal/pose/review_plan.go:577 \tspecs := []Spec{}\npose-mcp/internal/pose/review_plan.go:578 \tfor _, raw := range uniqueSorted(slugs) {\npose-mcp/internal/pose/review_plan.go:579 \t\t// Another project's member contributes no local components; its\npose-mcp/internal/pose/review_plan.go:580 \t\t// review lives in its own project and reaches this scope through the\npose-mcp/internal/pose/review_plan.go:581 \t\t// federated manifest.\npose-mcp/internal/pose/review_plan.go:582 \t\tslug, external := s.milestoneMember(raw)\npose-mcp/internal/pose/review_plan.go:583 \t\tif external {\npose-mcp/internal/pose/review_plan.go:584 \t\t\tcontinue\npose-mcp/internal/pose/review_plan.go:585 \t\t}\npose-mcp/internal/pose/review_plan.go:586 \t\tsp, err := s.GetSpec(slug)\npose-mcp/internal/pose/review_plan.go:587 \t\tif err != nil {\npose-mcp/internal/pose/review_plan.go:588 \t\t\treturn nil, err\npose-mcp/internal/pose/review_plan.go:589 \t\t}\npose-mcp/internal/pose/review_plan.go:590 \t\tspecs = append(specs, *sp)\npose-mcp/internal/pose/review_plan.go:591 \t}\npose-mcp/internal/pose/review_plan.go:592 \treturn specs, nil\npose-mcp/internal/pose/review_plan.go:593 }\npose-mcp/internal/pose/review_plan.go:594 \npose-mcp/internal/pose/review_plan.go:595 func (s Store) loadReviewRepoEntries() ([]reviewRepoEntry, error) {\npose-mcp/internal/pose/closeout_review_policy.go:753 \tif err != nil {\npose-mcp/internal/pose/closeout_review_policy.go:754 \t\treturn false, err\npose-mcp/internal/pose/closeout_review_policy.go:755 \t}\npose-mcp/internal/pose/closeout_review_policy.go:756 \tif receipt != nil {\npose-mcp/internal/pose/closeout_review_policy.go:757 \t\tpolicy, _, err := s.loadReviewPolicy()\npose-mcp/internal/pose/closeout_review_policy.go:758 \t\tif err != nil {\npose-mcp/internal/pose/closeout_review_policy.go:759 \t\t\treturn false, err\npose-mcp/internal/pose/closeout_review_policy.go:760 \t\t}\npose-mcp/internal/pose/closeout_review_policy.go:761 \t\tif s.closeoutReceiptStands(*receipt, policy) != nil {\npose-mcp/internal/pose/closeout_review_policy.go:762 \t\t\treturn false, nil\npose-mcp/internal/pose/closeout_review_policy.go:763 \t\t}\npose-mcp/internal/pose/closeout_review_policy.go:764 \t} else {\npose-mcp/internal/pose/closeout_review_policy.go:765 \t\tscope, err := ParseScopeRef(ref)\npose-mcp/internal/pose/closeout_review_policy.go:766 \t\tif err != nil {\npose-mcp/internal/pose/closeout_review_policy.go:767 \t\t\treturn false, err\npose-mcp/internal/pose/closeout_review_policy.go:768 \t\t}\npose-mcp/internal/pose/closeout_review_policy.go:769 \t\tif !s.closeoutScopeHistorical(scope) && !s.milestoneClosedBeforeAdoption(scope) {\npose-mcp/internal/pose/closeout_review_policy.go:770 \t\t\treturn false, nil\n","exit_code":0,"status":"completed"}}
