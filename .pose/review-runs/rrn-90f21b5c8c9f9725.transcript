{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '3300,3585p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"\t}\n\tatt.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", id+\".json\"))\n\treturn att, nil\n}\n\nfunc (s Store) ListReviewAttestations(bundleID string) ([]ReviewAttestation, error) {\n\tread, err := s.ReadReviewAttestations(bundleID)\n\treturn read.Attestations, err\n}\n\n// ReviewAttestationsRead is the attestations a read found and the records it could not\n// read. An attestation that is lost may be the later one, a rejection among them: the\n// last attestation read is the current one only if nothing that concerns the bundle\n// was lost.\ntype ReviewAttestationsRead struct {\n\tAttestations []ReviewAttestation\n\tCoverage     SourceCoverage\n}\n\n// ReadReviewAttestations lists attestations and reports the records it could not read,\n// attributed to the bundle their readable prefix names. With a bundle, a record that\n// names another bundle is not a loss for this one; one that names none is, because it may\n// be a rejection of this bundle.\nfunc (s Store) ReadReviewAttestations(bundleID string) (ReviewAttestationsRead, error) {\n\tcoverage := SourceCoverage{Losses: []SourceLoss{}}\n\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), false)\n\tif os.IsNotExist(err) {\n\t\treturn ReviewAttestationsRead{Attestations: []ReviewAttestation{}, Coverage: coverage}, nil\n\t}\n\tif err != nil {\n\t\treturn ReviewAttestationsRead{}, err\n\t}\n\tentries, err := s.fsys().ReadDir(dir)\n\tif os.IsNotExist(err) {\n\t\treturn ReviewAttestationsRead{Attestations: []ReviewAttestation{}, Coverage: coverage}, nil\n\t}\n\tif err != nil {\n\t\treturn ReviewAttestationsRead{}, err\n\t}\n\tresult := []ReviewAttestation{}\n\tfor _, entry := range entries {\n\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tcontinue\n\t\t}\n\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n\t\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", entry.Name()))\n\t\tif bundleID != \"\" {\n\t\t\traw, err := s.fsys().ReadFile(filepath.Join(dir, entry.Name()))\n\t\t\tif err != nil {\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossReadError, Detail: err.Error()})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tvar header struct {\n\t\t\t\tBundleID string `json:\"bundle_id\"`\n\t\t\t}\n\t\t\tif err := json.Unmarshal(raw, &header); err != nil {\n\t\t\t\tcoverage.Add(attributeLoss(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: \"the record is not valid JSON\"}, raw, \"bundle_id\"))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, _, ambiguous := sniffJSONString(raw, \"bundle_id\"); ambiguous {\n\t\t\t\t// A repeated name is valid JSON whose decoder keeps the last one: which\n\t\t\t\t// bundle the record belongs to is not settled, so it is not another's.\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossInvalid, Detail: \"the record names its bundle more than once\"})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif header.BundleID == \"\" {\n\t\t\t\t// Valid JSON that names no bundle is not another bundle's attestation.\n\t\t\t\tcoverage.Add(SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: \"the record names no bundle\"})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif header.BundleID != bundleID {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tatt, loadErr := s.LoadReviewAttestation(id)\n\t\tif loadErr != nil {\n\t\t\tif bundleID != \"\" {\n\t\t\t\treturn ReviewAttestationsRead{}, loadErr\n\t\t\t}\n\t\t\tloss := SourceLoss{Producer: \"review-attestations\", Artifact: rel, Kind: LossParseError, Detail: loadErr.Error()}\n\t\t\tif raw, readErr := s.fsys().ReadFile(filepath.Join(dir, entry.Name())); readErr == nil {\n\t\t\t\tif futureSchema(raw) {\n\t\t\t\t\tloss.Kind, loss.Detail = LossUnsupported, \"the record has a schema_version this engine does not read\"\n\t\t\t\t}\n\t\t\t\tloss = attributeLoss(loss, raw, \"bundle_id\")\n\t\t\t} else {\n\t\t\t\tloss.Kind, loss.Detail = LossReadError, readErr.Error()\n\t\t\t}\n\t\t\tcoverage.Add(loss)\n\t\t\tcontinue\n\t\t}\n\t\tif bundleID == \"\" || att.BundleID == bundleID {\n\t\t\tresult = append(result, att)\n\t\t}\n\t}\n\tsort.Slice(result, func(i, j int) bool {\n\t\t// By instant: \"04:02-08:00\" is later than \"12:01Z\", whatever the text says.\n\t\treturn attestationLess(result[i], result[j])\n\t})\n\tcoverage.Normalize()\n\treturn ReviewAttestationsRead{Attestations: result, Coverage: coverage}, nil\n}\n\n// futureSchema reports well-formed JSON whose schema_version is one this engine does not read.\nfunc futureSchema(raw []byte) bool {\n\tvar header struct {\n\t\tSchemaVersion int `json:\"schema_version\"`\n\t}\n\tif json.Unmarshal(raw, &header) != nil {\n\t\treturn false\n\t}\n\treturn header.SchemaVersion > ReviewBundleSchemaVersion\n}\n\nfunc (s Store) VerifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tverification, err := s.verifyReviewBundle(scope)\n\tif err == nil && verification.Bundle != nil {\n\t\tassurance := s.DescribeReviewAssurance(*verification.Bundle, verification.Attestation)\n\t\tverification.Assurance = &assurance\n\t}\n\tif err == nil {\n\t\tverification.DelegatedRuns, verification.DelegatedHistoryLosses = s.reviewRunSummaries(scope)\n\t}\n\tif err == nil && verification.Bundle != nil {\n\t\tif round, rerr := s.ReviewRoundOf(*verification.Bundle); rerr != nil {\n\t\t\tverification.DelegatedHistoryLosses = append(verification.DelegatedHistoryLosses, \"the round cannot be derived: \"+rerr.Error())\n\t\t} else {\n\t\t\tverification.Round = round.Number\n\t\t\tpolicy, _, _, _ := s.LoadDelegationPolicy()\n\t\t\tif threshold := policy.Routing.RoundThresholdOf(); round.Number >= threshold {\n\t\t\t\tverification.Warnings = append(verification.Warnings, fmt.Sprintf(\"%s is in review round %d, at or past the round threshold %d: the rounds are not converging; consider a different agent or a human adjudication\", scope, round.Number, threshold))\n\t\t\t}\n\t\t}\n\t}\n\treturn verification, err\n}\n\n// verifyReviewBundle verifies scope once per operation of the same project and\n// resolver, and refuses a scope already being verified: sealed children are\n// data, and a cycle among them must end in a named refusal (spec\n// pose-review-approval-follows-children R6).\nfunc (s Store) verifyReviewBundle(scope string) (ReviewBundleVerification, error) {\n\ts = s.reviewOperation()\n\tstate := s.reviewReuse\n\tkey := fmt.Sprintf(\"%s\\x00%t\\x00%s\", s.Root, s.FederatedResolver != nil, scope)\n\tif result, ok := state.children[key]; ok {\n\t\treturn result.verification, result.err\n\t}\n\tif state.verifying[key] {\n\t\treturn ReviewBundleVerification{}, fmt.Errorf(\"pose: the sealed children of %s form a cycle\", scope)\n\t}\n\tstate.verifying[key] = true\n\tdefer delete(state.verifying, key)\n\tif s.onReviewVerify != nil {\n\t\ts.onReviewVerify(scope)\n\t}\n\tverification, err := s.proportionalReviewVerification(scope)\n\tstate.children[key] = childVerificationResult{verification, err}\n\treturn verification, err\n}\n\n// proportionalReviewVerification is the verification of a scope, and of a milestone that\n// owes no review of its own: one made of a single closed, approved spec, or one a roadmap\n// declares. Every reader of an approval comes through here, so they give one answer (ADR\n// a-milestone-of-one-member-is-that-member). A negative review recorded on it stands.\nfunc (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerification, error) {\n\town, err := s.computeReviewVerification(scope)\n\tif err != nil || own.Approved {\n\t\treturn own, err\n\t}\n\tref, parseErr := ParseScopeRef(scope)\n\tif parseErr != nil || (ref.Kind != \"milestone\" && ref.Kind != \"roadmap\") {\n\t\treturn own, nil\n\t}\n\t// A policy without bundles answers through its review attempts alone, and has no\n\t// bundle of the spec to stand on.\n\tpolicy, err := s.GetReviewPolicy()\n\tif err != nil || !policy.ReviewBundles {\n\t\treturn own, nil\n\t}\n\tif s.milestoneReviewRefused(scope) {\n\t\treturn own, nil\n\t}\n\t// An adopted closeout review policy is the only rule for an open scope:\n\t// legacy inheritance and declared exemptions cannot weaken `always`, and\n\t// the policy's own exemption reads the same gate as reviewCheck. A roadmap\n\t// closed before adoption keeps the legacy reading below.\n\tadopted := policy.CloseoutReviewAdopted() && !s.closeoutScopeHistorical(ref)\n\tif adopted {\n\t\tdecision, exempt, gateErr := s.closeoutReviewGate(scope, policy)\n\t\tif gateErr != nil || decision == nil || !exempt || !decision.Known {\n\t\t\treturn own, nil\n\t\t}\n\t\tif s.FederatedResolver != nil {\n\t\t\tvar acceptance FederatedRoadmapAcceptanceReport\n\t\t\tvar err error\n\t\t\tif ref.Kind == \"milestone\" {\n\t\t\t\tacceptance, err = s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n\t\t\t} else {\n\t\t\t\tacceptance, err = s.FederatedRoadmapAcceptance(s.FederatedProjectID, ref.Slug, *s.FederatedResolver)\n\t\t\t}\n\t\t\tif err != nil || !acceptance.Ready {\n\t\t\t\treturn own, nil\n\t\t\t}\n\t\t}\n\t\t// The exemption satisfies the review, not the close: the scope is\n\t\t// closed only by its explicit close, whose receipt must stand, and a\n\t\t// roadmap only over closed milestones. The full terminal verifier\n\t\t// is closeout's (review round 8, N30).\n\t\tverification := ReviewBundleVerification{\n\t\t\tScope: scope, State: \"ready-to-close\", Fresh: true, Approved: true,\n\t\t\tNextAction:     \"apply the guarded lifecycle transition for \" + scope + \" (`pose close \" + scope + \"` publishes its closeout receipt)\",\n\t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n\t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n\t\t}\n\t\tif ref.Kind == \"roadmap\" {\n\t\t\tif rm, err := s.GetRoadmap(ref.Slug); err == nil {\n\t\t\t\tfor _, milestone := range rm.Milestones {\n\t\t\t\t\tchild := ScopeRef{Kind: \"milestone\", Roadmap: rm.Slug, Milestone: milestone.ID}\n\t\t\t\t\tif !s.receiptStandsFor(child.String()) && !s.milestoneClosedBeforeAdoption(child) {\n\t\t\t\t\t\tverification.Blockers = append(verification.Blockers, \"child \"+child.String()+\" is not closed\")\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif len(verification.Blockers) > 0 {\n\t\t\t\tverification.NextAction = \"close the milestones of \" + scope + \" first: \" + strings.Join(verification.Blockers, \"; \")\n\t\t\t}\n\t\t}\n\t\tif len(verification.Blockers) == 0 && s.receiptStandsFor(scope) {\n\t\t\tverification.State, verification.NextAction = \"closed\", \"scope is closed by its closeout receipt\"\n\t\t}\n\t\treturn verification, nil\n\t}\n\tif ref.Kind != \"milestone\" {\n\t\treturn own, nil\n\t}\n\t// Edges still bind: a milestone inherits a review, not the acceptance of what it\n\t// depends on, and revoked trust or an open predecessor leaves it where it was.\n\tif s.FederatedResolver != nil {\n\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n\t\tif err != nil || !acceptance.Ready {\n\t\t\treturn own, nil\n\t\t}\n\t}\n\tif member, ok := s.soleMemberOf(ref); ok {\n\t\tchild, err := s.verifyReviewBundle(\"spec:\" + member)\n\t\tif err == nil && child.State == \"closed\" && child.Fresh && child.Approved {\n\t\t\treturn ReviewBundleVerification{\n\t\t\t\tScope: scope, State: \"closed\", Bundle: child.Bundle, Attestation: child.Attestation, Fresh: true, Approved: true,\n\t\t\t\tNextAction: \"none\", Warnings: []string{\"the approval of \" + scope + \" is inherited from spec:\" + member + \", its only member\"},\n\t\t\t\tApprovalOrigin: \"inherited:spec:\" + member, inherited: true,\n\t\t\t}, nil\n\t\t}\n\t}\n\tif reason := s.declaredUnreviewed(ref); reason != \"\" {\n\t\treturn ReviewBundleVerification{\n\t\t\tScope: scope, State: \"closed\", Fresh: true, Approved: true, NextAction: \"none\",\n\t\t\tWarnings:       []string{scope + \" stands without a review, as its roadmap declares: \" + reason},\n\t\t\tApprovalOrigin: \"declared:roadmap:\" + ref.Roadmap, inherited: true,\n\t\t}, nil\n\t}\n\treturn own, nil\n}\n\n// milestoneReviewRefused reports a refusal recorded on the milestone itself, in a bundle\n// or in a legacy attempt.\nfunc (s Store) milestoneReviewRefused(scope string) bool {\n\tif bundle, _ := s.latestNegativeReview(scope); bundle != nil {\n\t\treturn true\n\t}\n\tattempts, err := s.ReadReviewAttempts(scope)\n\tif err != nil || !attempts.Coverage.CompleteFor(scope) {\n\t\treturn true\n\t}\n\tif len(attempts.Attempts) == 0 {\n\t\treturn false\n\t}\n\tlatest := attempts.Attempts[len(attempts.Attempts)-1]\n\treturn latest.Decision == \"rejected\" || latest.Decision == \"changes-requested\"\n}\n\nfunc (s Store) computeReviewVerification(scope string) (ReviewBundleVerification, error) {\n\tpolicy, err := s.GetReviewPolicy()\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/adr/2026-11-12-closeout-review-policy-by-cost-and-benefit.md .pose/rules/backend-go.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/adr/2026-11-12-closeout-review-policy-by-cost-and-benefit.md .pose/rules/backend-go.md'","aggregated_output":"# ADR: Closeout review policy by cost and benefit\n\n## Status\nAccepted — the maintainer approved this base explicitly on 2026-11-12, including\nlegacy compatibility and `always` requiring a one-member milestone's own review.\nThis records the architectural decision, not policy adoption or a delivery attestation.\n\n## Context\n\nSpec [pose-closeout-review-policy-by-cost-benefit](../specs/2026-11-11-pose-closeout-review-policy-by-cost-benefit.md)\nseparates the mandatory close of an aggregate scope from its independent review.\nThe current [one-member milestone rule](2026-11-02-a-milestone-of-one-member-is-that-member.md)\ninherits the member's approval, while multi-member milestones and roadmaps normally\nrequire their own reviews. Review value depends on composition; the maintainer\nchose explicit deterministic thresholds instead of a judgment made by an agent.\n\nSealed bundles include policy and review plans. A new setting must not reinterpret\nthe historical contract, erase a rejection, skip member reviews, or infer adoption\nfrom an unrecognized optional field.\n\n## Decision\n\nStore `milestone_review_required` and `roadmap_review_required` in the versioned\ninstance review policy `.pose/policy/review.json`. Accept exactly `never`,\n`when-justified`, and `always`; reject unknown values before preparing a current\nplan or writing a closeout. Use one domain evaluator across CLI, MCP, planning,\nverification, state, closeout and federation; expose its reason in their projections.\n\n- `never`: require no independent review of that aggregate scope.\n- `always`: require the scope's own independent review, including a one-member\n  milestone. An inherited member approval does not satisfy this explicit choice.\n- `when-justified`, milestone: require review exactly when it has more than two\n  distinct canonical spec members. Duplicate aliases do not increase the count.\n- `when-justified`, roadmap: require review exactly when its union of milestones\n  contains more than one distinct canonical spec and at least one resolved ADR\n  association. Count the spec once even if it appears in multiple milestones.\n\nRecognize an ADR association declared by the roadmap or a canonical association\nback from an ADR. Resolve explicit references, not incidental words in prose.\nUnknown, unreadable or ambiguous member/association inputs cannot yield an\nexemption: report the missing knowledge and refuse the close until resolved.\nAcceptance tests must fix the reference syntax in the implementation spec before\nchanging its parser.\n\nThe defaults for newly installed/adopting instances are `never` for both keys.\nIntroduce a review-policy schema version that older engines reject. A legacy\npolicy with neither key retains its legacy semantics until explicit adoption;\nsetup/settings show the effective legacy rule and the proposed new values before\nwriting both keys. Do not silently inject `always` (which differs for one-member\nmilestones), and do not silently disable review on an existing instance by parsing\nan absent field as `never`. A partially configured adopting policy is invalid.\n\nAfter adoption, `pose close` remains an explicit operation for every milestone\nand roadmap in all three modes, including scopes whose review is inherited or\ndispensed with. Persist a closeout receipt containing `review: not-required`,\nthe exact policy key/value, evaluator version and reason/counts when exempt.\nSatisfying member reviews or reaching the last member does not itself perform\nthis close. Member reviews and edge/exit-gate validation remain required.\n\nOptional reviews use the same verification as required reviews. An authentic\nnegative review retains its veto until remediated under the existing rules;\nchanging a setting cannot erase it. No exemption may weaken a stronger protected\nbaseline or mandatory-human requirement. `doctor` reports open scopes newly owing\nreview after policy or composition changes; the close gate enforces the result.\n\nVerify scopes already sealed as done against their sealed policy and plan,\nincluding legacy inherited milestones. Never backfill a fictitious exemption,\nreinterpret an existing receipt, or invalidate historical approval merely because\nthe current setting differs. Apply the new close and exemption rules prospectively.\n\n## Consequences\n\nNew instances skip aggregate reviews by default while still closing each scope\nand recording why review was not required. `when-justified` preserves review for\nthe compositions the maintainer selected. Explicit `always` adds cost even for\na one-member milestone; that is deliberate and visible.\n\nImplementation touches review-policy loading, common scope evaluation, persisted\ncloseout evidence, setup/settings, doctor, CLI/MCP projections and their tests.\nThe existing one-member ADR is superseded only for newly adopting open scopes;\nits sealed historical outcomes remain valid. No automatic instance adoption,\nhuman approval or delivery attestation is implied by this proposed ADR.\n\nRejected alternatives:\n\n- Boolean switches: cannot express the requested middle mode.\n- An agent estimates the benefit: yields irreproducible gates.\n- Require review with two milestone members: contradicts the chosen threshold.\n- Default existing missing fields directly to `never`: silently changes authority.\n- Treat `always` as legacy behavior: hides the one-member exception.\n- Ignore a recorded rejection after switching to `never`: launders negative evidence.\n- Recompute done scopes using current policy: breaks historical sealed approvals.\n- Remove close when review is exempt: conflates lifecycle and review requirements.\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n","exit_code":0,"status":"completed"}}
