ycleDone(scopeRef)\npose-mcp/internal/pose/review_bundle.go:3737 \t\t}\npose-mcp/internal/pose/review_bundle.go:3738 \t\tif doneErr == nil && done {\npose-mcp/internal/pose/review_bundle.go:3739 \t\t\tverification.State = \"closed\"\npose-mcp/internal/pose/review_bundle.go:3740 \t\t\tverification.NextAction = \"scope is closed with a fresh bundle attestation\"\npose-mcp/internal/pose/review_bundle.go:3741 \t\t} else {\npose-mcp/internal/pose/review_bundle.go:3742 \t\t\tverification.State = \"ready-to-close\"\npose-mcp/internal/pose/review_bundle.go:3743 \t\t\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope\npose-mcp/internal/pose/review_bundle.go:3744 \t\t}\npose-mcp/internal/pose/review_bundle.go:3745 \t} else if att.Decision == \"changes-requested\" || att.Decision == \"rejected\" {\npose-mcp/internal/pose/review_bundle.go:3746 \t\tverification.State = \"changes-requested\"\npose-mcp/internal/pose/review_bundle.go:3747 \t\tverification.NextAction = \"remediate findings and seal a superseding bundle\"\npose-mcp/internal/pose/review_bundle.go:3748 \t} else if blockedByAChild(prepared.Blockers) {\npose-mcp/internal/pose/review_bundle.go:3749 \t\tverification.NextAction = \"restore the review of the children of \" + scope\npose-mcp/internal/pose/review_bundle.go:3750 \t} else {\npose-mcp/internal/pose/review_closeout.go:2545 \t\t}\npose-mcp/internal/pose/review_closeout.go:2546 \t\treturn sp.Status == \"done\", nil\npose-mcp/internal/pose/review_closeout.go:2547 \tcase \"milestone\":\npose-mcp/internal/pose/review_closeout.go:2548 \t\trm, err := s.GetRoadmap(scope.Roadmap)\npose-mcp/internal/pose/review_closeout.go:2549 \t\tif err != nil {\npose-mcp/internal/pose/review_closeout.go:2550 \t\t\treturn false, err\npose-mcp/internal/pose/review_closeout.go:2551 \t\t}\npose-mcp/internal/pose/review_closeout.go:2552 \t\tfor _, milestone := range rm.Milestones {\npose-mcp/internal/pose/review_closeout.go:2553 \t\t\tif milestone.ID == scope.M