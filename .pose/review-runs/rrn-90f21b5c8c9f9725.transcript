{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '3580,3750p' pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"}\n\nfunc (s Store) computeReviewVerification(scope string) (ReviewBundleVerification, error) {\n\tpolicy, err := s.GetReviewPolicy()\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n\tscopeRef, scopeErr := ParseScopeRef(scope)\n\tif scopeErr != nil {\n\t\treturn ReviewBundleVerification{}, scopeErr\n\t}\n\n\tbundlesRead, err := s.ReadReviewBundles(scope)\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n\tbundles := bundlesRead.Bundles\n\n\tif (policy.SchemaVersion < ReviewPolicySchemaVersion || !policy.ReviewBundles) && len(bundles) == 0 {\n\t\teval, evalErr := s.ReviewCheck(scope)\n\t\tif evalErr != nil {\n\t\t\treturn ReviewBundleVerification{}, evalErr\n\t\t}\n\t\tverification := ReviewBundleVerification{\n\t\t\tScope:    scope,\n\t\t\tState:    \"needs-review\",\n\t\t\tFresh:    eval.Fresh,\n\t\t\tApproved: eval.Approved,\n\t\t\tWarnings: append([]string{}, eval.Warnings...),\n\t\t\tBlockers: append([]string{}, eval.Blockers...),\n\t\t}\n\t\tif eval.Current != nil {\n\t\t\tverification.NextAction = \"record fresh review for \" + scope\n\t\t\tif eval.Current.Decision == \"changes-requested\" || eval.Current.Decision == \"rejected\" {\n\t\t\t\tverification.State = eval.Current.Decision\n\t\t\t} else if !eval.Fresh {\n\t\t\t\tverification.State = \"superseded\"\n\t\t\t}\n\t\t} else {\n\t\t\tverification.NextAction = \"record review for \" + scope\n\t\t}\n\t\tif eval.Approved && eval.Fresh {\n\t\t\tdone, doneErr := s.scopeLifecycleDone(scopeRef)\n\t\t\tif doneErr == nil && done {\n\t\t\t\tverification.State = \"closed\"\n\t\t\t\tverification.NextAction = \"scope is closed with an approved review\"\n\t\t\t} else {\n\t\t\t\tverification.State = \"ready-to-close\"\n\t\t\t\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope\n\t\t\t}\n\t\t}\n\t\tverification.Blockers = uniqueSorted(verification.Blockers)\n\t\tverification.Warnings = uniqueSorted(verification.Warnings)\n\t\treturn verification, nil\n\t}\n\n\tprepared, err := s.PrepareReviewBundle(scope)\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n\tverification := ReviewBundleVerification{Scope: scope, State: \"needs-validation\", Fresh: false, Approved: false, Warnings: append([]string{}, prepared.Warnings...), Blockers: append([]string{}, prepared.Blockers...), currentManifest: prepared.Payload.FederatedManifest}\n\tif bundleLosses := bundlesRead.Coverage.LossesFor(scope); len(bundleLosses) > 0 {\n\t\t// A sealed bundle that could not be read may belong to this scope: the history\n\t\t// below is the readable part of it.\n\t\tverification.Warnings = append(verification.Warnings, \"sealed bundle history is incomplete: \"+(SourceCoverage{Losses: bundleLosses}).Describe(\"\")+\"; a record that could not be read may belong to this scope\")\n\t}\n\tif len(prepared.Blockers) == 0 {\n\t\tverification.State = \"ready-to-seal\"\n\t}\n\tcurrent, err := s.matchSealedReviewBundle(scope, prepared, bundles)\n\tif err != nil {\n\t\treturn ReviewBundleVerification{}, err\n\t}\n\tif current == nil {\n\t\tif len(bundles) > 0 {\n\t\t\tprevious := reviewBundleLineage(bundles)[0]\n\t\t\tdelta := ReviewBundleDiff(previous, prepared)\n\t\t\t// The per-criterion explanation is computed only where a person\n\t\t\t// reads it; analytics over many bundles use the plain diff.\n\t\t\tdelta.CriterionReuse = ExplainCriterionReuse(previous, prepared)\n\t\t\tif attempts, listErr := s.ListReviewAttestations(previous.BundleID); listErr == nil && len(attempts) > 0 {\n\t\t\t\tfor _, finding := range attempts[len(attempts)-1].Findings {\n\t\t\t\t\tdelta.ChangedFindings = append(delta.ChangedFindings, finding.ID)\n\t\t\t\t}\n\t\t\t\tdelta.ChangedFindings = uniqueSorted(delta.ChangedFindings)\n\t\t\t}\n\t\t\tverification.Delta = &delta\n\t\t\tif done, doneErr := s.scopeLifecycleDone(scopeRef); doneErr == nil && done {\n\t\t\t\t// Only routine drift is retained. A changed federated manifest —\n\t\t\t\t// revoked trust, a moved or unauthorized source — bears on the\n\t\t\t\t// review's authority, so it stales a closed scope as it always did.\n\t\t\t\tbundle, att, retainLost, childBlockers := s.retainedCompletedReviewWithHistory(scopeRef, scope, policy)\n\t\t\t\tif len(retainLost) > 0 {\n\t\t\t\t\tverification.Blockers = append(verification.Blockers, \"the approval cannot be retained: the attestation history of its bundle is incomplete, so the latest readable attestation is not known to be the current one: \"+(SourceCoverage{Losses: retainLost}).Describe(\"\")+\"; restore or remove the unreadable record\")\n\t\t\t\t}\n\t\t\t\tif len(childBlockers) > 0 {\n\t\t\t\t\tverification.State = \"superseded\"\n\t\t\t\t\tverification.Blockers = uniqueSorted(append(verification.Blockers, childBlockers...))\n\t\t\t\t\tverification.NextAction = \"restore the review of the children of \" + scope\n\t\t\t\t\treturn verification, nil\n\t\t\t\t}\n\t\t\t\tif bundle != nil && !s.retainedApprovalStands(bundle, prepared.Payload.FederatedManifest) {\n\t\t\t\t\tverification.Blockers = append(verification.Blockers, retainedManifestChanged(bundle, scope))\n\t\t\t\t} else if bundle != nil {\n\t\t\t\t\tverification.Bundle, verification.Attestation = bundle, att\n\t\t\t\t\tverification.Warnings = append(verification.Warnings, staleEvidenceWarnings(bundle.Payload.Subject, bundle.Payload.Evidence)...)\n\t\t\t\t\tverification.Fresh, verification.Approved = true, true\n\t\t\t\t\tverification.State = \"closed\"\n\t\t\t\t\tverification.NextAction = \"scope is closed with its retained approved bundle attestation\"\n\t\t\t\t\tverification.Blockers = []string{}\n\t\t\t\t\tverification.Warnings = uniqueSorted(append(verification.Warnings, retainedCompletedReviewWarning))\n\t\t\t\t\treturn verification, nil\n\t\t\t\t}\n\t\t\t}\n\t\t\tverification.State = \"superseded\"\n\t\t\tverification.Blockers = append(verification.Blockers, \"current semantic inputs are not represented by a sealed bundle\")\n\t\t}\n\t\tverification.NextAction = \"seal the current review bundle for \" + scope\n\t\tverification.Blockers = uniqueSorted(verification.Blockers)\n\t\treturn verification, nil\n\t}\n\tverification.Bundle = current\n\tverification.Warnings = uniqueSorted(append(verification.Warnings, staleEvidenceWarnings(current.Payload.Subject, current.Payload.Evidence)...))\n\tverification.Fresh = true\n\tverification.State = \"ready-for-review\"\n\tattestationsRead, err := s.ReadReviewAttestations(current.BundleID)\n\tif err != nil {\n\t\treturn verification, err\n\t}\n\tattestations := attestationsRead.Attestations\n\t// A record that could not be read may be a later attestation, a rejection among\n\t// them: an earlier approval is not taken as the current one while that is open.\n\t// A record that names another bundle, or another scope, does not concern this one.\n\tattestationHistory := attestationsRead.Coverage.LossesFor(current.BundleID)\n\tif len(attestations) == 0 {\n\t\tif len(attestationHistory) > 0 {\n\t\t\tverification.Blockers = append(verification.Blockers, \"no readable attestation exists for bundle \"+current.BundleID+\", and the attestation history is incomplete: \"+(SourceCoverage{Losses: attestationHistory}).Describe(\"\"))\n\t\t} else {\n\t\t\tverification.Blockers = append(verification.Blockers, \"sealed review bundle has no attestation\")\n\t\t}\n\t\tverification.NextAction = \"review and attest bundle \" + current.BundleID\n\t\tverification.Blockers = uniqueSorted(verification.Blockers)\n\t\treturn verification, nil\n\t}\n\tatt := attestations[len(attestations)-1]\n\tverification.Attestation = &att\n\tverification.Blockers = append(verification.Blockers, s.validateBundleAttestation(*current, att)...)\n\tif len(attestationHistory) > 0 {\n\t\tverification.Blockers = append(verification.Blockers, \"attestation history for bundle \"+current.BundleID+\" is incomplete, so the latest readable attestation is not known to be the current one: \"+(SourceCoverage{Losses: attestationHistory}).Describe(\"\")+\"; restore or remove the unreadable record\")\n\t}\n\n\tif len(verification.Blockers) == 0 {\n\t\tverification.Approved = true\n\t\tscopeRef, scopeErr := ParseScopeRef(scope)\n\t\tdone, doneErr := false, scopeErr\n\t\tif scopeErr == nil {\n\t\t\tdone, doneErr = s.scopeLifecycleDone(scopeRef)\n\t\t}\n\t\tif doneErr == nil && done {\n\t\t\tverification.State = \"closed\"\n\t\t\tverification.NextAction = \"scope is closed with a fresh bundle attestation\"\n\t\t} else {\n\t\t\tverification.State = \"ready-to-close\"\n\t\t\tverification.NextAction = \"apply the guarded lifecycle transition for \" + scope\n\t\t}\n\t} else if att.Decision == \"changes-requested\" || att.Decision == \"rejected\" {\n\t\tverification.State = \"changes-requested\"\n\t\tverification.NextAction = \"remediate findings and seal a superseding bundle\"\n\t} else if blockedByAChild(prepared.Blockers) {\n\t\tverification.NextAction = \"restore the review of the children of \" + scope\n\t} else {\n","exit_code":0,"status":"completed"}}
