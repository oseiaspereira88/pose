e's policy decides, never the consumer's. Its members\n+\t// are federated with their own reviews (spec\n+\t// pose-closeout-review-policy-by-cost-benefit).\n+\tif receipt := state.CloseoutReceipt; receipt != nil && !receipt.Decision.Required && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n+\t\traw, err := json.Marshal(receipt)\n+\t\tif err != nil {\n+\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-receipt-unreadable\"}\n+\t\t}\n+\t\treturn \"closeout-receipt:\" + scope, \"sha256:\" + digestHex(raw), receipt.SubjectDigest, receipt.PolicyDigest, nil, nil, nil\n+\t}\n \tverification, err := source.VerifyReviewBundle(scope)\n \t// A milestone its roadmap declares has no review of its own: what a consumer can\n \t// hold is the review of that roadmap, which sealed the declaration.\ndiff --git a/pose-mcp/internal/pose/readiness.go b/pose-mcp/internal/pose/readiness.go\nindex 86378e9e..98072941 100644\n--- a/pose-mcp/internal/pose/readiness.go\n+++ b/pose-mcp/internal/pose/readiness.go\n@@ -187,6 +187,8 @@ func (s Store) SpecReadinessWithResolver(slug, project string, resolver Artifact\n \t\t\t\tif ref.Kind == \"milestone\" && ref.Project == \"\" {\n \t\t\t\t\treason = s.milestoneWaitingReason(ref.Slug + \"/\" + ref.Milestone)\n \t\t\t\t}\n+\t\t\t} else if closed, why := s.AggregateDependencyClosed(resolver, project, resolved); !closed {\n+\t\t\t\tnotDone, reason = true, why\n \t\t\t}\n \t\t}\n \t\tif reason != \"\" {\ndiff --git a/pose-mcp/internal/pose/roadmaps.go b/pose-mcp/internal/pose/roadmaps.go\nindex 54366f7e..791b9b87 100644\n--- a/pose-mcp/internal/pose/roadmaps.go\n+++ b/pose-mcp/internal/pose/roadmaps.go\n@@ -22,10 +22,14 @@ type Roadmap struct {\n \tConsumes  []string `json:\"consumes,omitempty\"`\n \t// UnreviewedMilestones is the reason a roadmap gives for its reached milestones\n \t// standing without a review (ADR a-milestone-of-one-member-is-that-member).\n-\tUnreviewedMilestones string      `json:\"-\"`\n-\tMilestones           []Milestone `json:\"milestones\"`\n-\tPath                 string      `json:\"path\"`\n-\tBody                 string      `json:\"body,omitempty\"`\n+\tUnreviewedMilestones string `json:\"-\"`\n+\t// ADRs is the raw `adrs:` declaration, `[adr:<file>.md, …]`, read by the\n+\t// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n+\t// Raw so that a malformed declaration is unknown, not absent.\n+\tADRs       string      `json:\"-\"`\n+\tMilestones []Milestone `json:\"milestones\"`\n+\tPath       string      `json:\"path\"`\n+\tBody       string      `json:\"body,omitempty\"`\n }\n \n type Milestone struct {\n@@ -52,6 +56,22 @@ func (s Store) ReachedMilestones(spec string) ([]string, error) {\n \t\treturn nil, err\n \t}\n \treached := []string{}\n+\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil {\n+\t\treturn reached, err\n+\t} else if adopted {\n+\t\t// Under an adopted closeout review policy, only the explicit close\n+\t\t// makes a milestone terminal: reached means no receipt yet.\n+\t\tfor _, ref := range candidates {\n+\t\t\tclosed, err := s.closedByReceipt(ref)\n+\t\t\tif err != nil {\n+\t\t\t\treturn reached, err\n+\t\t\t}\n+\t\t\tif !closed {\n+\t\t\t\treached = append(reached, ref)\n+\t\t\t}\n+\t\t}\n+\t\treturn reached, nil\n+\t}\n \tfor _, ref := range candidates {\n \t\t// Its only member has just closed, uncommitted, so its verification cannot\n \t\t// answer yet: only a refusal recorded on the milestone says it will not stand.\n@@ -87,9 +107,15 @@ func (s Store) milestonesWithTerminalMembers(spec, scope string) ([]string, erro\n \tfor _, sp := range specs {\n \t\tstatuses[sp.Slug] = sp.Status\n \t}\n+\tadopted, _ := s.closeoutReviewPolicyAdopted()\n \tfound := []string{}\n \tfor _, rm := range roadmaps {\n-\t\tif rm.Status == \"done\" {\n+\t\t// Under an adopted closeout review policy a done roadmap closed by\n+\t\t// its receipt keeps its milestones as candidates: they leave only\n+\t\t// when the terminal projection stands. A roadmap closed before\n+\t\t// adoption keeps the contract it was sealed under (review round 7,\n+\t\t// N28); doctor reports one whose closure no longer verifies.\n+\t\tif rm.Status == \"done\" && (!adopted || s.closeoutScopeHistorical(ScopeRef{Kind: \"roadmap\", Slug: rm.Slug})) {\n \t\t\tcontinue\n \t\t}\n \t\tfor _, milestone := range rm.Milestones {\n@@ -290,6 +316,10 @@ func (s Store) RoadmapsReachedBy(spec string) ([]string, error) {\n \t\treturn nil, err\n \t}\n \tfound := []string{}\n+\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || adopted {\n+\t\t// Adopted: a member's close leaves its milestone reached, never closed.\n+\t\treturn found, err\n+\t}\n \tfor _, rm := range roadmaps {\n \t\tfor _, milestone := range rm.Milestones {\n \t\t\tif member, ok := s.soleMemberOf(ScopeRef{Kind: \"milestone\", Roadmap: rm.Slug, Milestone: milestone.ID}); ok && member == spec {\n@@ -316,10 +346,20 @@ func (s Store) roadmapReachedApartFrom(slug, closing string) bool {\n \tif err != nil || rm.Status == \"done\" || len(rm.Milestones) == 0 {\n \t\treturn false\n \t}\n+\tadopted, err := s.closeoutReviewPolicyAdopted()\n+\tif err != nil {\n+\t\treturn false\n+\t}\n \tfor _, milestone := range rm.Milestones {\n \t\tif milestone.ID == closing {\n \t\t\tcontinue\n \t\t}\n+\t\tif adopted {\n+\t\t\tif closed, err := s.closedByReceipt(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !closed {\n+\t\t\t\treturn false\n+\t\t\t}\n+\t\t\tcontinue\n+\t\t}\n \t\tif approved, err := s.scopeApproved(\"milestone:\" + slug + \"/\" + milestone.ID); err != nil || !approved {\n \t\t\treturn false\n \t\t}\n@@ -434,6 +474,8 @@ func parseRoadmapFile(files Files, path, slug string, includeBody bool) (*Roadma\n \t\t\trm.Consumes = parseInlineList(value)\n \t\tcase \"unreviewed_milestones\":\n \t\t\trm.UnreviewedMilestones = cleanValue(value)\n+\t\tcase \"adrs\":\n+\t\t\trm.ADRs = strings.TrimSpace(value)\n \t\t}\n \t}\n \tvar current *Milestone\n@@ -487,3 +529,8 @@ func parseRoadmapFile(files Files, path, slug string, includeBody bool) (*Roadma\n \t}\n \treturn rm, nil\n }\n+\n+func (s Store) closeoutReviewPolicyAdopted() (bool, error) {\n+\tpolicy, _, err := s.loadReviewPolicy()\n+\treturn policy.CloseoutReviewAdopted(), err\n+}\n","exit_code":0,"status":"completed"}}
