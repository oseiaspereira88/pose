{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CzkyeyBLcJX2gaqhRc57UF","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"strings\"\n5\t\t\"testing\"\n6\t\t\"time\"\n7\t)\n8\t\n9\t// Spec pose-review-declared-limits-residuals R1–R4: a comment between the\n10\t// heading's words refuses the section; inline code spans are read as\n11\t// Markdown reads them; indented code opens no fence; the next section's\n12\t// heading closes the section whatever comment it holds; problems are bounded.\n13\tfunc TestAcceptedLimitsResiduals(t *testing.T) {\n14\t\tlimit := \"- L1: An escape is open. Accepted because it is rare.\\n\"\n15\t\tif limits, problems := ParseAcceptedLimits(\"### Accepted <!-- x --> limits\\n\" + limit); len(limits) != 0 || len(problems) == 0 {\n16\t\t\tt.Fatalf(\"R1: a comment in the heading words: %+v %v\", limits, problems)\n17\t\t}\n18\t\tif limits, problems := ParseAcceptedLimits(\"A span ``a ` <!-- b`` is code.\\n\\n### Accepted limits\\n\" + limit); len(problems) != 0 || len(limits) != 1 {\n19\t\t\tt.Fatalf(\"R2: a double-backtick span: %+v %v\", limits, problems)\n20\t\t}\n21\t\tif _, problems := ParseAcceptedLimits(\"A stray ` backtick, then <!-- an open comment\\n\\n### Accepted limits\\n\" + limit); !strings.Contains(strings.Join(problems, \";\"), \"unterminated\") {\n22\t\t\tt.Fatalf(\"R2: a stray backtick hid an open comment: %v\", problems)\n23\t\t}\n24\t\tif limits, problems := ParseAcceptedLimits(\"Example:\\n\\n    ```\\n    code\\n\\n### Accepted limits\\n\" + limit); len(problems) != 0 || len(limits) != 1 {\n25\t\t\tt.Fatalf(\"R3: indented code opened a fence: %+v %v\", limits, problems)\n26\t\t}\n27\t\tif limits, problems := ParseAcceptedLimits(\"### Accepted limits\\n\" + limit + \"### Next <!-- note -->\\nProse.\\n\"); len(problems) != 0 || len(limits) != 1 {\n28\t\t\tt.Fatalf(\"R4: a comment on the next heading: %+v %v\", limits, problems)\n29\t\t}\n30\t\tif _, problems := ParseAcceptedLimits(\"### Accepted limits\\n\" + strings.Repeat(\"prose line\\n\", 60)); len(problems) > acceptedLimitProblemLimit+1 || !strings.Contains(problems[len(problems)-1], \"more problems not shown\") {\n31\t\t\tt.Fatalf(\"R4: problems are not bounded: %d\", len(problems))\n32\t\t}\n33\t}\n34\t\n35\t// R6: an attestation of any decision naming a limit the bundle did not seal\n36\t// is refused.\n37\tfunc TestNoAttestationNamesAnUnsealedLimit(t *testing.T) {\n38\t\tbundle := ReviewBundle{BundleID: \"rvb-x\"}\n39\t\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x\"}}\n40\t\tatt := ReviewAttestation{Decision: \"changes-requested\", Findings: []ReviewFinding{{ID: \"n1\", Disposition: \"within-limit\", Limit: \"L9\"}, {ID: \"n2\", Disposition: \"within-limit\", Limit: \"L1\"}}}\n41\t\tgot := strings.Join(Store{Root: t.TempDir()}.reviewApprovalAdmissionBlockers(bundle, att, time.Now()), \";\")\n42\t\tif !strings.Contains(got, \"n1 is within-limit\") || strings.Contains(got, \"n2\") {\n43\t\t\tt.Fatalf(\"a non-approving attestation: %s\", got)\n44\t\t}\n45\t}\n46\t\n47\t// R8: a run-backed record an earlier engine derived within an unsealed limit\n48\t// still matches its draft.\n49\tfunc TestAnEarlierWithinLimitDerivationStillMatches(t *testing.T) {\n50\t\tbundle := ReviewBundle{BundleID: \"rvb-x\"}\n51\t\tdraft := ReviewDraft{Schema: ReviewDraftSchema, Decision: \"changes-requested\", Findings: []ReviewDraftFinding{{ID: \"N1\", Severity: \"low\", Disposition: \"follow-up\", Summary: \"inside\", Limit: \"L9\"}}}\n52\t\trun := ReviewRun{RunID: \"rrn-x\", Provenance: &ReviewRunProvenance{TemplateVersion: reviewBriefTemplateAcceptedLimits}, Output: \"```pose-draft\\n\" + string(mustJSON(t, draft)) + \"\\n```\\n\"}\n53\t\tlegacy := reviewAttestationFromDraftWith(run, bundle, draft, \"agent:t\", false)\n54\t\tif why := runConclusionDiffers(run, bundle, legacy); why != \"\" {\n55\t\t\tt.Fatalf(\"an earlier derivation differs: %s\", why)\n56\t\t}\n57\t\tcurrent := reviewAttestationFromDraft(run, bundle, draft, \"agent:t\")\n58\t\tif why := runConclusionDiffers(run, bundle, current); why != \"\" {\n59\t\t\tt.Fatalf(\"the current derivation differs: %s\", why)\n60\t\t}\n61\t}\n62\tdiff --git a/POSE.md b/POSE.md\n63\tindex 0635f3d5..d108b162 100644\n64\t--- a/POSE.md\n65\t+++ b/POSE.md\n66\t@@ -953,7 +953,7 @@ Reservations live in `.pose/review-attempts/`, final receipts link the run, and\n67\t \n68\t **Optional worktree runtime.** `pose runtime start` starts, detached, a runtime for this worktree; `attach` and `status` handshake with it, `stop` drains it (`--drain <d>`, default 5s) and says how many requests in flight finished and how many were abandoned, `restart` is stop then start, and `serve` runs it in the foreground (`--idle <d>`, default 30m, stops an idle runtime; 0 never does). It is opt-in: no other command starts it, and every command runs standalone whether it runs or not. The runtime is identified by the user, the canonical worktree (symlinks resolved) and the Git common directory, so two worktrees of one repository, or two users, never share one; the handshake compares the engine, build, protocol and schema as well and an attach from another engine is refused naming the field. Its endpoint is a Unix domain socket (Linux, macOS) of mode 0600 in a 0700 directory owned by the user (`$XDG_RUNTIME_DIR/pose`, else `pose-runtime-<uid>` under the temporary directory, or `POSE_RUNTIME_DIR`), whose peer the operating system identifies before a byte is read; a link, a loose mode, another owner or a file that is not a socket is refused, and a socket nobody answers on is replaced. There is no TCP and no token. Slice 1 hosts no domain operation: it answers handshake, status and stop, confers no authority, signature or presence, and every restart has a new epoch, inheriting nothing. On Windows, which has no named-pipe implementation here, `status` reports `unsupported` and every command runs standalone. `status` exits 0 for running, standalone and unsupported and 1 for an incompatible runtime; `attach` also exits 1 when there is nothing to attach to. `--json` prints the document `pose.runtime.status/1`.\n69\t \n70\t-**Hosted checks and the resident Git memo.** `pose runtime run [--envelope] [--timeout <d>] <command> [args...]` runs `review-check`, `closeout-check`, `artifact-check`, `surface-check` or `roadmap-check` in the runtime of the worktree when one is running, compatible and willing, and standalone in this process otherwise; the exit code and the output are the command's, and `--envelope` prints one document (`pose.runtime.run/1`) with them and with `via` (`runtime` or `standalone`), the `fallback_reason`, the typed `outcome` (`completed`; `error` when the command ran and ended but its output (over 2 MiB) is not sent back, with the command's exit code; or `unknown` for a deadline or a lost answer), the epoch and the memo hits. The runtime refuses, before the command starts, one it does not host and a caller whose environment digest (the `POSE_`, `HARNE8_`, `GIT_`, `CLAUDE` and `CODEX` variables, `XDG_STATE_HOME`, `XDG_CONFIG_HOME` and `XDG_RUNTIME_DIR`, the locale, `HOME`, `NO_COLOR` and the user) differs from its own, so the caller runs standalone; a command that reached the runtime and whose answer did not come back whole, or whose `--timeout` passed, may have run and is never repeated standalone unasked: it exits 1 and says so. The runtime runs hosted commands as the user that started it, in its worktree, with the output of a non-terminal, in the admission lanes described below; a command still waiting for its slot when its `--timeout` passes is refused, not started, so the caller runs it standalone. A runtime also keeps, between commands, the output of the Git reads that are pure functions of object ids or of the commit HEAD named when they ran, keyed by that commit and the shallow state (256 MiB, least recently used first; not for a linked worktree): the second `review-check` of this repository took about 10 s against about 25 s standalone, with the same output. The runtime admits hosted commands in two lanes, each with its own slots and a bounded queue: `short` (`surface-check`, about 10 ms on this repository) and `heavy` (the other hosted commands; `roadmap-check <slug>` takes minutes here), 2 and 1 slots by default and queues of 16 and 4; `pose runtime start|serve` take `--short-slots`, `--heavy-slots`, `--short-queue`, `--heavy-queue` and `--memo-mib` (default 256). A short query is not queued behind a heavy check, and a command that finds every slot of its lane busy and the queue full is refused before it waits and runs standalone. `status` and the handshake carry, per lane, `<lane>_slots`, `_queue_limit`, `_queued`, `_running`, `_admitted`, `_refused`, `_wait_ms_total` and `_wait_ms_max` in `metrics`. A measurement of the runtime on a real repository, with its thresholds fixed before the numbers, is `POSE_RUNTIME_MEASURE=<file> go test ./internal/cli -run TestMeasureTheRuntimeOnTheRealRepository`; its report is under `.pose/reports/`.\\n\\n**Review rounds.** The rounds of a scope are its sealed bundles that a completed delegated review concluded on, in the order those runs ended; `pose review verify`, `pose delegate ls` and `pose insights` show the round. From round 2, the generated brief (template `review-brief/2`; runs briefed with `review-brief/1` still verify) carries a `Previous round` section built from the ledger: every open finding with the identifier it keeps across rounds (`R<round>-<id>`), its severity, disposition and location, the previous run and its draft digest. The reviewer's draft is the fenced code block whose info string is `pose-draft`: JSON with `schema` `pose.review.draft/v1`, `decision` and `findings` (`id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line`, `summary`), and from round 2 `prior_findings` (`id`, `status` fixed|partial|not-fixed|superseded, `evidence`) and `sweep`. A finding reported `partial` or `not-fixed` keeps its identifier in the next brief. A round-2-or-later draft that leaves an open finding unaccounted, calls one `fixed` without evidence or states no sweep is recorded with `draft_problems`, `wait` reports it as `invalid`, and it is never accepted as an approval. With `routing.rounds` `continue-thread` (the default) a round resumes the session the previous round ended with, through the agent's resume command; it opens a new session, recording why, when the agent or its vendor changes, the chain of drafts is broken, that session cannot be resumed, or the round reaches `routing.round_threshold` (5 by default), where `verify` also warns that the rounds are not converging. `cold-session` opens a new session every round. Each run records its `round` and `thread`; `pose insights` reports, per scope, findings per round, rounds to approval, and how prior findings were accounted for in continued and in cold rounds. A previous round whose record is not intact makes the brief refuse.\n71\t+**Hosted checks and the resident Git memo.** `pose runtime run [--envelope] [--timeout <d>] <command> [args...]` runs `review-check`, `closeout-check`, `artifact-check`, `surface-check` or `roadmap-check` in the runtime of the worktree when one is running, compatible and willing, and standalone in this process otherwise; the exit code and the output are the command's, and `--envelope` prints one document (`pose.runtime.run/1`) with them and with `via` (`runtime` or `standalone`), the `fallback_reason`, the typed `outcome` (`completed`; `error` when the command ran and ended but its output (over 2 MiB) is not sent back, with the command's exit code; or `unknown` for a deadline or a lost answer), the epoch and the memo hits. The runtime refuses, before the command starts, one it does not host and a caller whose environment digest (the `POSE_`, `HARNE8_`, `GIT_`, `CLAUDE` and `CODEX` variables, `XDG_STATE_HOME`, `XDG_CONFIG_HOME` and `XDG_RUNTIME_DIR`, the locale, `HOME`, `NO_COLOR` and the user) differs from its own, so the caller runs standalone; a command that reached the runtime and whose answer did not come back whole, or whose `--timeout` passed, may have run and is never repeated standalone unasked: it exits 1 and says so. The runtime runs hosted commands as the user that started it, in its worktree, with the output of a non-terminal, in the admission lanes described below; a command still waiting for its slot when its `--timeout` passes is refused, not started, so the caller runs it standalone. A runtime also keeps, between commands, the output of the Git reads that are pure functions of object ids or of the commit HEAD named when they ran, keyed by that commit and the shallow state (256 MiB, least recently used first; not for a linked worktree): the second `review-check` of this repository took about 10 s against about 25 s standalone, with the same output. The runtime admits hosted commands in two lanes, each with its own slots and a bounded queue: `short` (`surface-check`, about 10 ms on this repository) and `heavy` (the other hosted commands; `roadmap-check <slug>` takes minutes here), 2 and 1 slots by default and queues of 16 and 4; `pose runtime start|serve` take `--short-slots`, `--heavy-slots`, `--short-queue`, `--heavy-queue` and `--memo-mib` (default 256). A short query is not queued behind a heavy check, and a command that finds every slot of its lane busy and the queue full is refused before it waits and runs standalone. `status` and the handshake carry, per lane, `<lane>_slots`, `_queue_limit`, `_queued`, `_running`, `_admitted`, `_refused`, `_wait_ms_total` and `_wait_ms_max` in `metrics`. A measurement of the runtime on a real repository, with its thresholds fixed before the numbers, is `POSE_RUNTIME_MEASURE=<file> go test ./internal/cli -run TestMeasureTheRuntimeOnTheRealRepository`; its report is under `.pose/reports/`.\\n\\n**Review rounds.** The rounds of a scope are its sealed bundles that a completed delegated review concluded on, in the order those runs ended; `pose review verify`, `pose delegate ls` and `pose insights` show the round. From round 2, the generated brief (template `review-brief/2`; runs briefed with `review-brief/1` still verify) carries a `Previous round` section built from the ledger: every open finding with the identifier it keeps across rounds (`R<round>-<id>`), its severity, disposition and location, the previous run and its draft digest. The reviewer's draft is the fenced code block whose info string is `pose-draft`: JSON with `schema` `pose.review.draft/v1`, `decision` and `findings` (`id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line`, `summary`), and from round 2 `prior_findings` (`id`, `status` fixed|partial|not-fixed|superseded, `evidence`) and `sweep`. A finding reported `partial` or `not-fixed` keeps its identifier in the next brief. A round-2-or-later draft that leaves an open finding unaccounted, calls one `fixed` without evidence or states no sweep is recorded with `draft_problems`, `wait` reports it as `invalid`, and it is never accepted as an approval. With `routing.rounds` `continue-thread` (the default) a round resumes the session the previous round ended with, through the agent's resume command; it opens a new session, recording why, when the agent or its vendor changes, the chain of drafts is broken, that session cannot be resumed, the previous round's checkout path is still there (a leftover or a live run), or the round reaches `routing.round_threshold` (5 by default), where `verify` also warns that the rounds are not converging. When that path is taken only after the round was planned, the round keeps the continued session but works in its own directory, and the run records the move among its `safety.limitations`. `cold-session` opens a new session every round. Each run records its `round` and `thread`; `pose insights` reports, per scope, findings per round, rounds to approval, and how prior findings were accounted for in continued and in cold rounds. A previous round whose record is not intact makes the brief refuse.\n72\t \n73\t **Delegated runs over MCP.** `pose_delegate_start` (review, adjudicate or smoke), `pose_delegate_status`, `pose_delegate_wait`, `pose_delegate_resume` and `pose_delegate_handoff` run `pose delegate … --json` in the project the server resolved for the call, so every plan, refusal and run is the CLI's: a start, resume or handoff is always detached and returns once the run has reserved its attempt (without `apply` it previews), a status never blocks, and a wait blocks at most its `timeout_seconds` (300 at most), returning `still-running` when the bound passes. Refusals carry the same `reason_code` as the CLI's error document (`rerun-without-reason`, `budget-exhausted`, `containment-incompatible`, `agent-unavailable`, `no-agent`), and results carry the normalized summary only: no transcript, prompt, session reference or environment value. `pose delegate resume` and `handoff` take `--detach` as the purposes do. A task is not started over MCP.\n74\t \n75\t@@ -1075,7 +1075,7 @@ Attach `--run <run-id> --run-proof <proof-id> --sign <issuer>` to a complete `po\n76\t \n77\t **Review readiness before the seal.** A new seal of a spec scope refuses what `pose close` and the conclusion preflight would otherwise refuse only after a full review round: a change to a delivery root with no delivery declaration (`undeclared-delivery`) or to a governed path the artifacts do not declare (`undeclared`), read from the same index `pose close` reads, and, when a required criterion asks for structural mappings, a decision or assumption that reaches no requirement or constraint (give it a `- Basis:` line). A bundle already sealed is returned as it was. `pose review draft-check [<bundle-id|run-id>] --draft <file|-> [--json]` reports every reason the conclusion step would refuse a draft (an unreadable block, a round it does not account for, a criterion, mapping, finding, evidence or tool the attestation preflight refuses) and writes nothing; inside a delegated review the run provides the bundle and the round through `POSE_REVIEW_DRAFT_CONTEXT` and names its own engine in `POSE_REVIEW_CLI`, and `-` reads the draft from standard input, so it works in a read-only sandbox. The brief of template `review-brief/8` asks the reviewer to run it before finishing; `review-brief/9` also has every planned `pose` command run as `\"$POSE_REVIEW_CLI\"`, because the `pose` the reviewer's shell resolves may be an older engine. `pose delegate` names an oversized note file with its size and the limit, and a completed run that nothing concluded automatically prints the `pose review conclude <run>` command that records it.\n78\t \n79\t-**Accepted limits.** A spec may declare the residual limits of its guarantees under `### Accepted limits`, one `- L<N>: <assumption>. Accepted because <reason>.` per limit, whose wrapped lines are indented under it; the section holds only limits, and any other line in it is reported and leaves the limit it belongs to unsealed (HTML comments are not read); `lint-spec --ready-check` refuses a limit that does not say why it is accepted, and, when an ADR cites the spec, one the ADR does not name. The review plan and the bundle seal the limits (`accepted_limits`, part of the plan digest; in a scope with several specs each id is qualified as `<spec>#L<N>`), and the brief of template `review-brief/11` lists them: a finding that falls inside one is a follow-up with `limit` set to its id, recorded in the attestation with disposition `within-limit`, which does not block an approval whatever its severity and is counted apart in the governance outcomes; a limit the bundle did not seal, or a `within-limit` finding without a reason, is refused. A reviewer who finds a limit unjustified reports a finding that disputes it, which blocks as any finding does. A review converges by classifying what was declared out of scope, not by a cap on rounds.\n80\t+**Accepted limits.** A spec may declare the residual limits of its guarantees under `### Accepted limits`, one `- L<N>: <assumption>. Accepted because <reason>.` per limit, whose wrapped lines are indented under it; the section holds only limits, and any other line in it is reported and leaves the limit it belongs to unsealed; an HTML comment marker inside the section or on its heading refuses the whole section, and an unterminated comment anywhere refuses every limit (comments outside the section are not read); `lint-spec --ready-check` refuses a limit that does not say why it is accepted, and, when an ADR cites the spec, one the ADR does not name. The review plan and the bundle seal the limits (`accepted_limits`, part of the plan digest; in a scope with several specs each id is qualified as `<spec>#L<N>`), and the brief of template `review-brief/11` lists them: a finding that falls inside one is a follow-up with `limit` set to its id, recorded in the attestation with disposition `within-limit`, which does not block an approval whatever its severity and is counted apart in the governance outcomes; a limit the bundle did not seal, or a `within-limit` finding without a reason, is refused. A reviewer who finds a limit unjustified reports a finding that disputes it, which blocks as any finding does. A review converges by classifying what was declared out of scope, not by a cap on rounds.\n81\t \n82\t **Runs that leave work behind.** On Linux the dispatch runs the adapter under a review run shim, the same executable re-entered, which is the subreaper of the run's subtree: after the adapter exits, on a timeout, and when its dispatcher ends, it ends and reaps every process left in that subtree, even one that started its own session and cleared its environment, and reports the ended pids through a pipe the reviewer does not inherit; the dispatch lists them in the run's `safety.limitations` before the cleanup inventory. An embedder that does not enable the shim falls back to ending the processes whose environment names the run's sealed checkout (`POSE_SEALED_CHECKOUT`); on other Unix platforms only the process group is ended, and on Windows the adapter runs in a kill-on-close job object that the dispatch terminates after the run, on a timeout and, through the job's limit, when the dispatcher ends. The brief of template `review-brief/10` asks the reviewer to let its commands finish. The dispatch marks an attempt active before it publishes its reservation, so a dispatch that ends before recording its run always leaves a stalled attempt, which `pose delegate ls` lists with its cause, and `pose delegate cancel <attempt>` releases it once its owner is proven gone, recording a failed run and its receipt; one release runs at a time, under a lock the system releases with its holder, and a release completes with any run the attempt already recorded instead of writing another. A reservation an earlier engine left without a marker records no owner: `pose delegate ls` lists it once it is ten minutes old, and `pose delegate cancel <attempt> --confirm-abandoned` releases it on the operator's confirmation that no dispatch of it runs.\n83\t \n84\tdiff --git a/locales/pt-BR/POSE.md b/locales/pt-BR/POSE.md\n85\tindex 2068a227..dd882078 100644\n86\t--- a/locales/pt-BR/POSE.md\n87\t+++ b/locales/pt-BR/POSE.md\n88\t@@ -948,7 +948,7 @@ Reservas ficam em `.pose/review-attempts/`, recibos finais ligam o run, e `.pose\n89\t \n90\t **Runtime opcional por worktree.** `pose runtime start` inicia, destacado, um runtime para este worktree; `attach` e `status` fazem o handshake com ele, `stop` o drena (`--drain <d>`, padrão 5s) e diz quantas requisições em voo terminaram e quantas foram abandonadas, `restart` é stop e depois start, e `serve` o roda em primeiro plano (`--idle <d>`, padrão 30m, para um runtime ocioso; 0 nunca para). É opt-in: nenhum outro comando o inicia, e todo comando roda standalone com ou sem ele. O runtime é identificado pelo usuário, pelo worktree canônico (links resolvidos) e pelo diretório comum do Git, de modo que dois worktrees de um repositório, ou dois usuários, nunca compartilham um; o handshake compara também engine, build, protocolo e schema, e um attach de outro engine é recusado nomeando o campo. O endpoint é um socket de domínio Unix (Linux, macOS) com modo 0600 num diretório 0700 do usuário (`$XDG_RUNTIME_DIR/pose`, senão `pose-runtime-<uid>` sob o diretório temporário, ou `POSE_RUNTIME_DIR`), cujo par o sistema operacional identifica antes de se ler um byte; um link, um modo frouxo, outro dono ou um arquivo que não é socket são recusados, e um socket em que ninguém responde é substituído. Não há TCP nem token. A fatia 1 não hospeda nenhuma operação do domínio: responde handshake, status e stop, não confere autoridade, assinatura nem presença, e cada restart tem uma época nova, sem herdar nada. No Windows, que não tem implementação de named pipe aqui, `status` informa `unsupported` e todo comando roda standalone. `status` sai com 0 para running, standalone e unsupported e com 1 para um runtime incompatível; `attach` também sai com 1 quando não há o que anexar. `--json` imprime o documento `pose.runtime.status/1`.\n91\t \n92\t-**Checks hospedados e o memo residente do Git.** `pose runtime run [--envelope] [--timeout <d>] <comando> [args...]` roda `review-check`, `closeout-check`, `artifact-check`, `surface-check` ou `roadmap-check` no runtime do worktree quando há um rodando, compatível e disposto, e standalone neste processo caso contrário; o código de saída e a saída são os do comando, e `--envelope` imprime um documento (`pose.runtime.run/1`) com eles e com `via` (`runtime` ou `standalone`), o `fallback_reason`, o `outcome` tipado (`completed`; `error` quando o comando rodou e terminou mas a saída (acima de 2 MiB) não volta, com o código de saída do comando; ou `unknown` para um prazo ou uma resposta perdida), a época e os acertos do memo. O runtime recusa, antes de o comando começar, o que ele não hospeda e um chamador cujo digest de ambiente (as variáveis `POSE_`, `HARNE8_`, `GIT_`, `CLAUDE` e `CODEX`, `XDG_STATE_HOME`, `XDG_CONFIG_HOME` e `XDG_RUNTIME_DIR`, o locale, `HOME`, `NO_COLOR` e o usuário) difere do dele, e o chamador roda standalone; um comando que chegou ao runtime e cuja resposta não voltou inteira, ou cujo `--timeout` passou, pode ter rodado e nunca é repetido standalone sem pedido: sai com 1 e diz isso. O runtime roda os comandos hospedados como o usuário que o iniciou, no seu worktree, com a saída de um não terminal, nas faixas de admissão descritas adiante; um comando que ainda espera o seu slot quando o `--timeout` passa é recusado, não iniciado, de modo que o chamador o roda standalone. Um runtime também guarda, entre comandos, a saída das leituras do Git que são funções puras de ids de objeto ou do commit que o HEAD nomeava quando rodaram, chaveada por esse commit e pelo estado raso (256 MiB, a menos recentemente usada primeiro; não para um worktree vinculado): o segundo `review-check` deste repositório levou cerca de 10 s contra cerca de 25 s standalone, com a mesma saída. O runtime admite os comandos hospedados em duas faixas, cada uma com seus slots e uma fila limitada: `short` (`surface-check`, cerca de 10 ms neste repositório) e `heavy` (os demais comandos hospedados; `roadmap-check <slug>` leva minutos aqui), 2 e 1 slots por padrão e filas de 16 e 4; `pose runtime start|serve` aceitam `--short-slots`, `--heavy-slots`, `--short-queue`, `--heavy-queue` e `--memo-mib` (padrão 256). Uma consulta curta não espera atrás de um check pesado, e um comando que encontra todos os slots da sua faixa ocupados e a fila cheia é recusado antes de esperar e roda standalone. `status` e o handshake trazem, por faixa, `<faixa>_slots`, `_queue_limit`, `_queued`, `_running`, `_admitted`, `_refused`, `_wait_ms_total` e `_wait_ms_max` em `metrics`. Uma medição do runtime num repositório real, com os limiares fixados antes dos números, é `POSE_RUNTIME_MEASURE=<arquivo> go test ./internal/cli -run TestMeasureTheRuntimeOnTheRealRepository`; o relatório fica em `.pose/reports/`.\\n\\n**Rodadas de review.** As rodadas de um escopo são os bundles selados em que uma review delegada concluída terminou, na ordem em que esses runs terminaram; `pose review verify`, `pose delegate ls` e `pose insights` mostram a rodada. A partir da rodada 2, o brief gerado (template `review-brief/2`; runs com `review-brief/1` continuam verificando) traz uma seção `Previous round` construída do ledger: cada finding aberto com o identificador que mantém entre rodadas (`R<rodada>-<id>`), sua severidade, disposição e local, o run anterior e o digest do seu draft. O draft do revisor é o bloco de código cercado cuja info string é `pose-draft`: JSON com `schema` `pose.review.draft/v1`, `decision` e `findings` (`id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line`, `summary`), e a partir da rodada 2 `prior_findings` (`id`, `status` fixed|partial|not-fixed|superseded, `evidence`) e `sweep`. Um finding reportado `partial` ou `not-fixed` mantém seu identificador no brief seguinte. Um draft da rodada 2 em diante que deixa um finding aberto sem conta, marca um como `fixed` sem evidência ou não declara a varredura é registrado com `draft_problems`, o `wait` o reporta como `invalid`, e ele nunca é aceito como aprovação. Com `routing.rounds` `continue-thread` (o padrão), uma rodada retoma a sessão com que a rodada anterior terminou, pelo comando de resume do agente; ela abre uma sessão nova, registrando o motivo, quando o agente ou seu vendor muda, a cadeia de drafts está quebrada, essa sessão não pode ser retomada, ou a rodada atinge `routing.round_threshold` (5 por padrão), onde o `verify` também avisa que as rodadas não estão convergindo. `cold-session` abre uma sessão nova a cada rodada. Cada run registra sua `round` e sua `thread`; `pose insights` reporta, por escopo, findings por rodada, rodadas até a aprovação, e como os findings anteriores foram contabilizados em rodadas continuadas e frias. Uma rodada anterior cujo registro não está íntegro faz o brief recusar.\n93\t+**Checks hospedados e o memo residente do Git.** `pose runtime run [--envelope] [--timeout <d>] <comando> [args...]` roda `review-check`, `closeout-check`, `artifact-check`, `surface-check` ou `roadmap-check` no runtime do worktree quando há um rodando, compatível e disposto, e standalone neste processo caso contrário; o código de saída e a saída são os do comando, e `--envelope` imprime um documento (`pose.runtime.run/1`) com eles e com `via` (`runtime` ou `standalone`), o `fallback_reason`, o `outcome` tipado (`completed`; `error` quando o comando rodou e terminou mas a saída (acima de 2 MiB) não volta, com o código de saída do comando; ou `unknown` para um prazo ou uma resposta perdida), a época e os acertos do memo. O runtime recusa, antes de o comando começar, o que ele não hospeda e um chamador cujo digest de ambiente (as variáveis `POSE_`, `HARNE8_`, `GIT_`, `CLAUDE` e `CODEX`, `XDG_STATE_HOME`, `XDG_CONFIG_HOME` e `XDG_RUNTIME_DIR`, o locale, `HOME`, `NO_COLOR` e o usuário) difere do dele, e o chamador roda standalone; um comando que chegou ao runtime e cuja resposta não voltou inteira, ou cujo `--timeout` passou, pode ter rodado e nunca é repetido standalone sem pedido: sai com 1 e diz isso. O runtime roda os comandos hospedados como o usuário que o iniciou, no seu worktree, com a saída de um não terminal, nas faixas de admissão descritas adiante; um comando que ainda espera o seu slot quando o `--timeout` passa é recusado, não iniciado, de modo que o chamador o roda standalone. Um runtime também guarda, entre comandos, a saída das leituras do Git que são funções puras de ids de objeto ou do commit que o HEAD nomeava quando rodaram, chaveada por esse commit e pelo estado raso (256 MiB, a menos recentemente usada primeiro; não para um worktree vinculado): o segundo `review-check` deste repositório levou cerca de 10 s contra cerca de 25 s standalone, com a mesma saída. O runtime admite os comandos hospedados em duas faixas, cada uma com seus slots e uma fila limitada: `short` (`surface-check`, cerca de 10 ms neste repositório) e `heavy` (os demais comandos hospedados; `roadmap-check <slug>` leva minutos aqui), 2 e 1 slots por padrão e filas de 16 e 4; `pose runtime start|serve` aceitam `--short-slots`, `--heavy-slots`, `--short-queue`, `--heavy-queue` e `--memo-mib` (padrão 256). Uma consulta curta não espera atrás de um check pesado, e um comando que encontra todos os slots da sua faixa ocupados e a fila cheia é recusado antes de esperar e roda standalone. `status` e o handshake trazem, por faixa, `<faixa>_slots`, `_queue_limit`, `_queued`, `_running`, `_admitted`, `_refused`, `_wait_ms_total` e `_wait_ms_max` em `metrics`. Uma medição do runtime num repositório real, com os limiares fixados antes dos números, é `POSE_RUNTIME_MEASURE=<arquivo> go test ./internal/cli -run TestMeasureTheRuntimeOnTheRealRepository`; o relatório fica em `.pose/reports/`.\\n\\n**Rodadas de review.** As rodadas de um escopo são os bundles selados em que uma review delegada concluída terminou, na ordem em que esses runs terminaram; `pose review verify`, `pose delegate ls` e `pose insights` mostram a rodada. A partir da rodada 2, o brief gerado (template `review-brief/2`; runs com `review-brief/1` continuam verificando) traz uma seção `Previous round` construída do ledger: cada finding aberto com o identificador que mantém entre rodadas (`R<rodada>-<id>`), sua severidade, disposição e local, o run anterior e o digest do seu draft. O draft do revisor é o bloco de código cercado cuja info string é `pose-draft`: JSON com `schema` `pose.review.draft/v1`, `decision` e `findings` (`id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line`, `summary`), e a partir da rodada 2 `prior_findings` (`id`, `status` fixed|partial|not-fixed|superseded, `evidence`) e `sweep`. Um finding reportado `partial` ou `not-fixed` mantém seu identificador no brief seguinte. Um draft da rodada 2 em diante que deixa um finding aberto sem conta, marca um como `fixed` sem evidência ou não declara a varredura é registrado com `draft_problems`, o `wait` o reporta como `invalid`, e ele nunca é aceito como aprovação. Com `routing.rounds` `continue-thread` (o padrão), uma rodada retoma a sessão com que a rodada anterior terminou, pelo comando de resume do agente; ela abre uma sessão nova, registrando o motivo, quando o agente ou seu vendor muda, a cadeia de drafts está quebrada, essa sessão não pode ser retomada, o caminho do checkout da rodada anterior ainda existe (uma sobra ou uma run viva), ou a rodada atinge `routing.round_threshold` (5 por padrão), onde o `verify` também avisa que as rodadas não estão convergindo. Quando esse caminho só é ocupado depois que a rodada foi planejada, a rodada mantém a sessão continuada mas trabalha no próprio diretório, e a run registra a mudança em `safety.limitations`. `cold-session` abre uma sessão nova a cada rodada. Cada run registra sua `round` e sua `thread`; `pose insights` reporta, por escopo, findings por rodada, rodadas até a aprovação, e como os findings anteriores foram contabilizados em rodadas continuadas e frias. Uma rodada anterior cujo registro não está íntegro faz o brief recusar.\n94\t \n95\t **Runs delegados pelo MCP.** `pose_delegate_start` (review, adjudicate ou smoke), `pose_delegate_status`, `pose_delegate_wait`, `pose_delegate_resume` e `pose_delegate_handoff` rodam `pose delegate … --json` no projeto que o servidor resolveu para a chamada, então todo plano, recusa e run é o da CLI: um start, resume ou handoff é sempre destacado e volta quando o run reservou sua tentativa (sem `apply` ele faz a prévia), um status nunca bloqueia, e um wait bloqueia no máximo seu `timeout_seconds` (300 no máximo), devolvendo `still-running` quando o limite passa. Recusas trazem o mesmo `reason_code` do documento de erro da CLI (`rerun-without-reason`, `budget-exhausted`, `containment-incompatible`, `agent-unavailable`, `no-agent`), e os resultados trazem só o resumo normalizado: nenhum transcript, prompt, referência de sessão ou valor de ambiente. `pose delegate resume` e `handoff` aceitam `--detach` como os propósitos. Uma task não é iniciada pelo MCP.\n96\t \n97\t@@ -1072,7 +1072,7 @@ Acrescente `--run <run-id> --run-proof <proof-id> --sign <issuer>` a uma solicit\n98\t \n99\t **Prontidão da review antes da selagem.** Uma nova selagem de escopo de spec recusa o que `pose close` e a preflight da conclusão só recusariam depois de uma rodada completa de review: uma mudança em raiz de entrega sem declaração de entrega (`undeclared-delivery`) ou em caminho governado que os artefatos não declaram (`undeclared`), lidas do mesmo índice que `pose close` lê, e, quando um critério obrigatório pede mapeamentos estruturais, uma decisão ou premissa que não alcança requisito nem restrição (dê a ela uma linha `- Basis:`). Um bundle já selado é devolvido como estava. `pose review draft-check [<bundle-id|run-id>] --draft <arquivo|-> [--json]` relata todo motivo pelo qual a conclusão recusaria um rascunho (bloco ilegível, rodada não contabilizada, critério, mapeamento, achado, evidência ou ferramenta que a preflight da atestação recusa) e não grava nada; dentro de uma review delegada o run fornece o bundle e a rodada por `POSE_REVIEW_DRAFT_CONTEXT` e nomeia o próprio motor em `POSE_REVIEW_CLI`, e `-` lê o rascunho da entrada padrão, então funciona num sandbox somente leitura. O brief do template `review-brief/8` pede ao revisor que o rode antes de terminar; o `review-brief/9` também manda rodar cada comando `pose` do plano como `\"$POSE_REVIEW_CLI\"`, porque o `pose` que o shell do revisor resolve pode ser um motor mais antigo. `pose delegate` nomeia um arquivo de nota grande demais com seu tamanho e o limite, e um run concluído que nada concluiu automaticamente imprime o comando `pose review conclude <run>` que o registra.\n100\t \n101\t-**Limites aceitos.** Uma spec pode declarar os limites residuais das suas garantias em `### Accepted limits`, um `- L<N>: <suposição>. Accepted because <motivo>.` por limite, cujas linhas de continuação ficam indentadas sob ele; a seção contém apenas limites, e qualquer outra linha nela é reportada e deixa sem selo o limite a que pertence (comentários HTML não são lidos); `lint-spec --ready-check` recusa um limite que não diz por que é aceito e, quando um ADR cita a spec, um que o ADR não nomeia. O plano de review e o bundle selam os limites (`accepted_limits`, parte do digest do plano; num escopo com várias specs cada id é qualificado como `<spec>#L<N>`), e o brief do template `review-brief/11` os lista: um achado que cai dentro de um deles é um follow-up com `limit` igual ao seu id, registrado na atestação com a disposição `within-limit`, que não bloqueia uma aprovação seja qual for a severidade e é contado à parte nos resultados de governança; um limite que o bundle não selou, ou um achado `within-limit` sem motivo, é recusado. Um revisor que ache um limite injustificado relata um achado que o contesta, que bloqueia como qualquer achado. Uma review converge classificando o que foi declarado fora do escopo, não por um teto de rodadas.\n102\t+**Limites aceitos.** Uma spec pode declarar os limites residuais das suas garantias em `### Accepted limits`, um `- L<N>: <suposição>. Accepted because <motivo>.` por limite, cujas linhas de continuação ficam indentadas sob ele; a seção contém apenas limites, e qualquer outra linha nela é reportada e deixa sem selo o limite a que pertence; um marcador de comentário HTML dentro da seção ou no título dela recusa a seção inteira, e um comentário sem fechamento em qualquer lugar recusa todos os limites (comentários fora da seção não são lidos); `lint-spec --ready-check` recusa um limite que não diz por que é aceito e, quando um ADR cita a spec, um que o ADR não nomeia. O plano de review e o bundle selam os limites (`accepted_limits`, parte do digest do plano; num escopo com várias specs cada id é qualificado como `<spec>#L<N>`), e o brief do template `review-brief/11` os lista: um achado que cai dentro de um deles é um follow-up com `limit` igual ao seu id, registrado na atestação com a disposição `within-limit`, que não bloqueia uma aprovação seja qual for a severidade e é contado à parte nos resultados de governança; um limite que o bundle não selou, ou um achado `within-limit` sem motivo, é recusado. Um revisor que ache um limite injustificado relata um achado que o contesta, que bloqueia como qualquer achado. Uma review converge classificando o que foi declarado fora do escopo, não por um teto de rodadas.\n103\t \n104\t **Runs que deixam trabalho para trás.** No Linux o envio roda o adaptador sob um shim de run de review, o mesmo executável reentrado, que é o subreaper da subárvore do run: depois que o adaptador termina, num timeout e quando o envio termina, ele encerra e recolhe todo processo que restou nessa subárvore, mesmo um que abriu sessão própria e limpou o ambiente, e relata os pids encerrados por um pipe que o revisor não herda; o envio os lista em `safety.limitations` do run antes do inventário de limpeza. Quem embute o motor sem ativar o shim recorre a encerrar os processos cujo ambiente nomeia o checkout selado do run (`POSE_SEALED_CHECKOUT`); nas outras plataformas Unix só o grupo de processos é encerrado, e no Windows o adaptador roda num job object com encerramento ao fechar, que o envio termina depois do run, num timeout e, pelo limite do job, quando o envio termina. O brief do template `review-brief/10` pede ao revisor que deixe seus comandos terminarem. O envio marca a tentativa como ativa antes de publicar a reserva, então um envio que termina antes de registrar o run sempre deixa uma tentativa parada, que `pose delegate ls` lista com a causa, e `pose delegate cancel <tentativa>` a libera quando o dono está comprovadamente encerrado, registrando um run com falha e o seu recibo; uma liberação roda por vez, sob um lock que o sistema libera junto com quem o detém, e uma liberação conclui com qualquer run que a tentativa já registrou em vez de gravar outro. Uma reserva que um motor anterior deixou sem marcador não registra dono: `pose delegate ls` a lista depois de dez minutos, e `pose delegate cancel <tentativa> --confirm-abandoned` a libera com a confirmação do operador de que nenhum envio dela está rodando.\n105\t \n106\tdiff --git a/pose-mcp/internal/cli/accepted_limits_lint_test.go b/pose-mcp/internal/cli/accepted_limits_lint_test.go\n107\tindex 353e276e..29258df0 100644\n108\t--- a/pose-mcp/internal/cli/accepted_limits_lint_test.go\n109\t+++ b/pose-mcp/internal/cli/accepted_limits_lint_test.go\n110\t@@ -2,8 +2,10 @@ package cli\n111\t \n112\t import (\n113\t \t\"bytes\"\n114\t+\t\"encoding/json\"\n115\t \tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n116\t \t\"os\"\n117\t+\t\"os/exec\"\n118\t \t\"path/filepath\"\n119\t \t\"strings\"\n120\t \t\"testing\"\n121\t@@ -114,3 +116,50 @@ func TestWithinLimitFindingsAreTypedAndShown(t *testing.T) {\n122\t \t\tt.Fatalf(\"the text output: %q\", out.String())\n123\t \t}\n124\t }\n125\t+\n126\t+// Spec pose-review-declared-limits-residuals R7: pose review-check and pose\n127\t+// closeout-check print a recorded within-limit finding.\n128\t+func TestTheChecksPrintWithinLimitFindings(t *testing.T) {\n129\t+\troot := reviewBundleCLIFixture(t)\n130\t+\tspec := filepath.Join(root, \".pose/specs/bundle/spec.md\")\n131\t+\traw, err := os.ReadFile(spec)\n132\t+\tif err != nil {\n133\t+\t\tt.Fatal(err)\n134\t+\t}\n135\t+\tif err := os.WriteFile(spec, []byte(strings.Replace(string(raw), \"### Risks\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\\n### Risks\", 1)), 0o644); err != nil {\n136\t+\t\tt.Fatal(err)\n137\t+\t}\n138\t+\tfor _, args := range [][]string{{\"add\", \"-A\"}, {\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-q\", \"-m\", \"limits\"}} {\n139\t+\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...).CombinedOutput(); err != nil {\n140\t+\t\t\tt.Fatal(args, err, string(out))\n141\t+\t\t}\n142\t+\t}\n143\t+\tvar out, errOut bytes.Buffer\n144\t+\tif code := cmdReview(root, []string{\"bundle\", \"spec:bundle\", \"--seal\", \"--json\"}, &out, &errOut); code != 0 {\n145\t+\t\tt.Fatalf(\"seal code=%d err=%s\", code, errOut.String())\n146\t+\t}\n147\t+\tvar sealed posemodel.ReviewBundle\n148\t+\tif err := json.Unmarshal(out.Bytes(), &sealed); err != nil {\n149\t+\t\tt.Fatal(err)\n150\t+\t}\n151\t+\tevidence := sealed.Payload.Evidence[0].EvidenceClass + \":\" + sealed.Payload.Evidence[0].ID\n152\t+\tout.Reset()\n153\t+\terrOut.Reset()\n154\t+\tattest := []string{\"attest\", sealed.BundleID, \"--reviewer\", \"agent:reviewer\", \"--decision\", \"approved\", \"--evidence\", evidence, \"--tool\", \"artifact-check|-|passed|check:artifact|\", \"--tool\", \"validate|pose-mcp|passed|validation:module|\", \"--finding\", \"n1|low|within-limit|note it|\" + evidence + \"||it is inside L1||L1\", \"--apply\"}\n155\t+\tif code := cmdReview(root, attest, &out, &errOut); code != 0 {\n156\t+\t\tt.Fatalf(\"attest code=%d out=%s err=%s\", code, out.String(), errOut.String())\n157\t+\t}\n158\t+\trun := func(args ...string) string {\n159\t+\t\tvar o, e bytes.Buffer\n160\t+\t\tinDir(t, root, func() { Main(args, &o, &e) })\n161\t+\t\treturn o.String() + e.String()\n162\t+\t}\n163\t+\tfor _, tc := range []struct{ out, field string }{\n164\t+\t\t{run(\"review-check\", \"spec:bundle\"), \"review.within_limit=\"},\n165\t+\t\t{run(\"closeout-check\", \"spec:bundle\"), \"closeout.within_limit=\"},\n166\t+\t} {\n167\t+\t\tif !strings.Contains(tc.out, tc.field) || !strings.Contains(tc.out, \"n1 limit:L1\") {\n168\t+\t\t\tt.Fatalf(\"%s missing:\\n%s\", tc.field, tc.out)\n169\t+\t\t}\n170\t+\t}\n171\t+}\n172\tdiff --git a/pose-mcp/internal/pose/accepted_limits_test.go b/pose-mcp/internal/pose/accepted_limits_test.go\n173\tindex 272a73f0..9ea98233 100644\n174\t--- a/pose-mcp/internal/pose/accepted_limits_test.go\n175\t+++ b/pose-mcp/internal/pose/accepted_limits_test.go\n176\t@@ -228,7 +228,7 @@ func TestAcceptedLimitsEndWhereTheirItemEnds(t *testing.T) {\n177\t // code included, is reported and nothing is sealed cut by it.\n178\t func TestAcceptedLimitsRefuseWhatWouldCutThem(t *testing.T) {\n179\t \tcases := []struct{ name, body, problem string }{\n180\t-\t\t{\"indented heading\", \"### Accepted limits\\n- L1: An escape is open. Accepted because a shim covers it\\n  # of cases on Linux and only for children.\\n\", \"heading inside a limit\"},\n181\t+\t\t{\"indented heading\", \"### Accepted limits\\n- L1: An escape is open. Accepted because a shim covers it\\n  # of cases on Linux and only for children.\\n\", \"indented heading-like line\"},\n182\t \t\t{\"second unterminated comment\", \"<!-- closed -->\\n### Accepted limits\\n- L1: An escape is open. Accepted because it is rare <!-- and so on\\n\", \"HTML comment\"},\n183\t \t\t{\"unterminated after a closed one\", \"<!-- closed -->\\n<!-- open\\n### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\", \"unterminated HTML comment\"},\n184\t \t\t{\"unterminated after a closed one, in code\", \"A spec may name `<!--` in its prose.\\n<!-- closed -->\\n### Accepted limits\\n- L1: An escape is open. Accepted because it is rare <!-- and so on\\n\", \"HTML comment\"},\n185\t@@ -303,7 +303,7 @@ func TestAcceptedLimitsReadCommentsWhereTheSectionIs(t *testing.T) {\n186\t \t\t}\n187\t \t}\n188\t \tindented := \"### Accepted limits\\n  - L1: An escape is open. Accepted because a shim covers it\\n  # of cases on Linux.\\n\"\n189\t-\tif limits, problems := ParseAcceptedLimits(indented); len(limits) != 0 || !strings.Contains(strings.Join(problems, \";\"), \"heading inside a limit\") {\n190\t+\tif limits, problems := ParseAcceptedLimits(indented); len(limits) != 0 || !strings.Contains(strings.Join(problems, \";\"), \"indented heading-like line\") {\n191\t \t\tt.Fatalf(\"an indented heading under an indented marker: %+v %v\", limits, problems)\n192\t \t}\n193\t }\n194\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"42579864-48df-4796-a53a-29855cc72988","timestamp":"2026-11-28T02:39:30.557Z","tool_use_result":{"type":"text","file":{"filePath":"/home/go/.claude/projects/-var-tmp-pose-work-go-pose-review-run-6ee95d62f8-worktree/[private-session]/tool-results/bipep916u.txt","content":"package pose\n\nimport (\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// Spec pose-review-declared-limits-residuals R1–R4: a comment between the\n// heading's words refuses the section; inline code spans are read as\n// Markdown reads them; indented code opens no fence; the next section's\n// heading closes the section whatever comment it holds; problems are bounded.\nfunc TestAcceptedLimitsResiduals(t *testing.T) {\n\tlimit := \"- L1: An escape is open. Accepted because it is rare.\\n\"\n\tif limits, problems := ParseAcceptedLimits(\"### Accepted <!-- x --> limits\\n\" + limit); len(limits) != 0 || len(problems) == 0 {\n\t\tt.Fatalf(\"R1: a comment in the heading words: %+v %v\", limits, problems)\n\t}\n\tif limits, problems := ParseAcceptedLimits(\"A span ``a ` <!-- b`` is code.\\n\\n### Accepted limits\\n\" + limit); len(problems) != 0 || len(limits) != 1 {\n\t\tt.Fatalf(\"R2: a double-backtick span: %+v %v\", limits, problems)\n\t}\n\tif _, problems := ParseAcceptedLimits(\"A stray ` backtick, then <!-- an open comment\\n\\n### Accepted limits\\n\" + limit); !strings.Contains(strings.Join(problems, \";\"), \"unterminated\") {\n\t\tt.Fatalf(\"R2: a stray backtick hid an open comment: %v\", problems)\n\t}\n\tif limits, problems := ParseAcceptedLimits(\"Example:\\n\\n    ```\\n    code\\n\\n### Accepted limits\\n\" + limit); len(problems) != 0 || len(limits) != 1 {\n\t\tt.Fatalf(\"R3: indented code opened a fence: %+v %v\", limits, problems)\n\t}\n\tif limits, problems := ParseAcceptedLimits(\"### Accepted limits\\n\" + limit + \"### Next <!-- note -->\\nProse.\\n\"); len(problems) != 0 || len(limits) != 1 {\n\t\tt.Fatalf(\"R4: a comment on the next heading: %+v %v\", limits, problems)\n\t}\n\tif _, problems := ParseAcceptedLimits(\"### Accepted limits\\n\" + strings.Repeat(\"prose line\\n\", 60)); len(problems) > acceptedLimitProblemLimit+1 || !strings.Contains(problems[len(problems)-1], \"more problems not shown\") {\n\t\tt.Fatalf(\"R4: problems are not bounded: %d\", len(problems))\n\t}\n}\n\n// R6: an attestation of any decision naming a limit the bundle did not seal\n// is refused.\nfunc TestNoAttestationNamesAnUnsealedLimit(t *testing.T) {\n\tbundle := ReviewBundle{BundleID: \"rvb-x\"}\n\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x\"}}\n\tatt := ReviewAttestation{Decision: \"changes-requested\", Findings: []ReviewFinding{{ID: \"n1\", Disposition: \"within-limit\", Limit: \"L9\"}, {ID: \"n2\", Disposition: \"within-limit\", Limit: \"L1\"}}}\n\tgot := strings.Join(Store{Root: t.TempDir()}.reviewApprovalAdmissionBlockers(bundle, att, time.Now()), \";\")\n\tif !strings.Contains(got, \"n1 is within-limit\") || strings.Contains(got, \"n2\") {\n\t\tt.Fatalf(\"a non-approving attestation: %s\", got)\n\t}\n}\n\n// R8: a run-backed record an earlier engine derived within an unsealed limit\n// still matches its draft.\nfunc TestAnEarlierWithinLimitDerivationStillMatches(t *testing.T) {\n\tbundle := ReviewBundle{BundleID: \"rvb-x\"}\n\tdraft := ReviewDraft{Schema: ReviewDraftSchema, Decision: \"changes-requested\", Findings: []ReviewDraftFinding{{ID: \"N1\", Severity: \"low\", Disposition: \"follow-up\", Summary: \"inside\", Limit: \"L9\"}}}\n\trun := ReviewRun{RunID: \"rrn-x\", Provenance: &ReviewRunProvenance{TemplateVersion: reviewBriefTemplateAcceptedLimits}, Output: \"```pose-draft\\n\" + string(mustJSON(t, draft)) + \"\\n```\\n\"}\n\tlegacy := reviewAttestationFromDraftWith(run, bundle, draft, \"agent:t\", false)\n\tif why := runConclusionDiffers(run, bundle, legacy); why != \"\" {\n\t\tt.Fatalf(\"an earlier derivation differs: %s\", why)\n\t}\n\tcurrent := reviewAttestationFromDraft(run, bundle, draft, \"agent:t\")\n\tif why := runConclusionDiffers(run, bundle, current); why != \"\" {\n\t\tt.Fatalf(\"the current derivation differs: %s\", why)\n\t}\n}\ndiff --git a/POSE.md b/POSE.md\nindex 0635f3d5..d108b162 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -953,7 +953,7 @@ Reservations live in `.pose/review-attempts/`, final receipts link the run, and\n \n **Optional worktree runtime.** `pose runtime start` starts, detached, a runtime for this worktree; `attach` and `status` handshake with it, `stop` drains it (`--drain <d>`, default 5s) and says how many requests in flight finished and how many were abandoned, `restart` is stop then start, and `serve` runs it in the foreground (`--idle <d>`, default 30m, stops an idle runtime; 0 never does). It is opt-in: no other command starts it, and every command runs standalone whether it runs or not. The runtime is identified by the user, the canonical worktree (symlinks resolved) and the Git common directory, so two worktrees of one repository, or two users, never share one; the handshake compares the engine, build, protocol and schema as well and an attach from another engine is refused naming the field. Its endpoint is a Unix domain socket (Linux, macOS) of mode 0600 in a 0700 directory owned by the user (`$XDG_RUNTIME_DIR/pose`, else `pose-runtime-<uid>` under the temporary directory, or `POSE_RUNTIME_DIR`), whose peer the operating system identifies before a byte is read; a link, a loose mode, another owner or a file that is not a socket is refused, and a socket nobody answers on is replaced. There is no TCP and no token. Slice 1 hosts no domain operation: it answers handshake, status and stop, confers no authority, signature or presence, and every restart has a new epoch, inheriting nothing. On Windows, which has no named-pipe implementation here, `status` reports `unsupported` and every command runs standalone. `status` exits 0 for running, standalone and unsupported and 1 for an incompatible runtime; `attach` also exits 1 when there is nothing to attach to. `--json` prints the document `pose.runtime.status/1`.\n \n-**Hosted checks and the resident Git memo.** `pose runtime run [--envelope] [--timeout <d>] <command> [args...]` runs `review-check`, `closeout-check`, `artifact-check`, `surface-check` or `roadmap-check` in the runtime of the worktree when one is running, compatible and willing, and standalone in this process otherwise; the exit code and the output are the command's, and `--envelope` prints one document (`pose.runtime.run/1`) with them and with `via` (`runtime` or `standalone`), the `fallback_reason`, the typed `outcome` (`completed`; `error` when the command ran and ended but its output (over 2 MiB) is not sent back, with the command's exit code; or `unknown` for a deadline or a lost answer), the epoch and the memo hits. The runtime refuses, before the command starts, one it does not host and a caller whose environment digest (the `POSE_`, `HARNE8_`, `GIT_`, `CLAUDE` and `CODEX` variables, `XDG_STATE_HOME`, `XDG_CONFIG_HOME` and `XDG_RUNTIME_DIR`, the locale, `HOME`, `NO_COLOR` and the user) differs from its own, so the caller runs standalone; a command that reached the runtime and whose answer did not come back whole, or whose `--timeout` passed, may have run and is never repeated standalone unasked: it exits 1 and says so. The runtime runs hosted commands as the user that started it, in its worktree, with the output of a non-terminal, in the admission lanes described below; a command still waiting for its slot when its `--timeout` passes is refused, not started, so the caller runs it standalone. A runtime also keeps, between commands, the output of the Git reads that are pure functions of object ids or of the commit HEAD named when they ran, keyed by that commit and the shallow state (256 MiB, least recently used first; not for a linked worktree): the second `review-check` of this repository took about 10 s against about 25 s standalone, with the same output. The runtime admits hosted commands in two lanes, each with its own slots and a bounded queue: `short` (`surface-check`, about 10 ms on this repository) and `heavy` (the other hosted commands; `roadmap-check <slug>` takes minutes here), 2 and 1 slots by default and queues of 16 and 4; `pose runtime start|serve` take `--short-slots`, `--heavy-slots`, `--short-queue`, `--heavy-queue` and `--memo-mib` (default 256). A short query is not queued behind a heavy check, and a command that finds every slot of its lane busy and the queue full is refused before it waits and runs standalone. `status` and the handshake carry, per lane, `<lane>_slots`, `_queue_limit`, `_queued`, `_running`, `_admitted`, `_refused`, `_wait_ms_total` and `_wait_ms_max` in `metrics`. A measurement of the runtime on a real repository, with its thresholds fixed before the numbers, is `POSE_RUNTIME_MEASURE=<file> go test ./internal/cli -run TestMeasureTheRuntimeOnTheRealRepository`; its report is under `.pose/reports/`.\\n\\n**Review rounds.** The rounds of a scope are its sealed bundles that a completed delegated review concluded on, in the order those runs ended; `pose review verify`, `pose delegate ls` and `pose insights` show the round. From round 2, the generated brief (template `review-brief/2`; runs briefed with `review-brief/1` still verify) carries a `Previous round` section built from the ledger: every open finding with the identifier it keeps across rounds (`R<round>-<id>`), its severity, disposition and location, the previous run and its draft digest. The reviewer's draft is the fenced code block whose info string is `pose-draft`: JSON with `schema` `pose.review.draft/v1`, `decision` and `findings` (`id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line`, `summary`), and from round 2 `prior_findings` (`id`, `status` fixed|partial|not-fixed|superseded, `evidence`) and `sweep`. A finding reported `partial` or `not-fixed` keeps its identifier in the next brief. A round-2-or-later draft that leaves an open finding unaccounted, calls one `fixed` without evidence or states no sweep is recorded with `draft_problems`, `wait` reports it as `invalid`, and it is never accepted as an approval. With `routing.rounds` `continue-thread` (the default) a round resumes the session the previous round ended with, through the agent's resume command; it opens a new session, recording why, when the agent or its vendor changes, the chain of drafts is broken, that session cannot be resumed, or the round reaches `routing.round_threshold` (5 by default), where `verify` also warns that the rounds are not converging. `cold-session` opens a new session every round. Each run records its `round` and `thread`; `pose insights` reports, per scope, findings per round, rounds to approval, and how prior findings were accounted for in continued and in cold rounds. A previous round whose record is not intact makes the brief refuse.\n+**Hosted checks and the resident Git memo.** `pose runtime run [--envelope] [--timeout <d>] <command> [args...]` runs `review-check`, `closeout-check`, `artifact-check`, `surface-check` or `roadmap-check` in the runtime of the worktree when one is running, compatible and willing, and standalone in this process otherwise; the exit code and the output are the command's, and `--envelope` prints one document (`pose.runtime.run/1`) with them and with `via` (`runtime` or `standalone`), the `fallback_reason`, the typed `outcome` (`completed`; `error` when the command ran and ended but its output (over 2 MiB) is not sent back, with the command's exit code; or `unknown` for a deadline or a lost answer), the epoch and the memo hits. The runtime refuses, before the command starts, one it does not host and a caller whose environment digest (the `POSE_`, `HARNE8_`, `GIT_`, `CLAUDE` and `CODEX` variables, `XDG_STATE_HOME`, `XDG_CONFIG_HOME` and `XDG_RUNTIME_DIR`, the locale, `HOME`, `NO_COLOR` and the user) differs from its own, so the caller runs standalone; a command that reached the runtime and whose answer did not come back whole, or whose `--timeout` passed, may have run and is never repeated standalone unasked: it exits 1 and says so. The runtime runs hosted commands as the user that started it, in its worktree, with the output of a non-terminal, in the admission lanes described below; a command still waiting for its slot when its `--timeout` passes is refused, not started, so the caller runs it standalone. A runtime also keeps, between commands, the output of the Git reads that are pure functions of object ids or of the commit HEAD named when they ran, keyed by that commit and the shallow state (256 MiB, least recently used first; not for a linked worktree): the second `review-check` of this repository took about 10 s against about 25 s standalone, with the same output. The runtime admits hosted commands in two lanes, each with its own slots and a bounded queue: `short` (`surface-check`, about 10 ms on this repository) and `heavy` (the other hosted commands; `roadmap-check <slug>` takes minutes here), 2 and 1 slots by default and queues of 16 and 4; `pose runtime start|serve` take `--short-slots`, `--heavy-slots`, `--short-queue`, `--heavy-queue` and `--memo-mib` (default 256). A short query is not queued behind a heavy check, and a command that finds every slot of its lane busy and the queue full is refused before it waits and runs standalone. `status` and the handshake carry, per lane, `<lane>_slots`, `_queue_limit`, `_queued`, `_running`, `_admitted`, `_refused`, `_wait_ms_total` and `_wait_ms_max` in `metrics`. A measurement of the runtime on a real repository, with its thresholds fixed before the numbers, is `POSE_RUNTIME_MEASURE=<file> go test ./internal/cli -run TestMeasureTheRuntimeOnTheRealRepository`; its report is under `.pose/reports/`.\\n\\n**Review rounds.** The rounds of a scope are its sealed bundles that a completed delegated review concluded on, in the order those runs ended; `pose review verify`, `pose delegate ls` and `pose insights` show the round. From round 2, the generated brief (template `review-brief/2`; runs briefed with `review-brief/1` still verify) carries a `Previous round` section built from the ledger: every open finding with the identifier it keeps across rounds (`R<round>-<id>`), its severity, disposition and location, the previous run and its draft digest. The reviewer's draft is the fenced code block whose info string is `pose-draft`: JSON with `schema` `pose.review.draft/v1`, `decision` and `findings` (`id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line`, `summary`), and from round 2 `prior_findings` (`id`, `status` fixed|partial|not-fixed|superseded, `evidence`) and `sweep`. A finding reported `partial` or `not-fixed` keeps its identifier in the next brief. A round-2-or-later draft that leaves an open finding unaccounted, calls one `fixed` without evidence or states no sweep is recorded with `draft_problems`, `wait` reports it as `invalid`, and it is never accepted as an approval. With `routing.rounds` `continue-thread` (the default) a round resumes the session the previous round ended with, through the agent's resume command; it opens a new session, recording why, when the agent or its vendor changes, the chain of drafts is broken, that session cannot be resumed, the previous round's checkout path is still there (a leftover or a live run), or the round reaches `routing.round_threshold` (5 by default), where `verify` also warns that the rounds are not converging. When that path is taken only after the round was planned, the round keeps the continued session but works in its own directory, and the run records the move among its `safety.limitations`. `cold-session` opens a new session every round. Each run records its `round` and `thread`; `pose insights` reports, per scope, findings per round, rounds to approval, and how prior findings were accounted for in continued and in cold rounds. A previous round whose record is not intact makes the brief refuse.\n \n **Delegated runs over MCP.** `pose_delegate_start` (review, adjudicate or smoke), `pose_delegate_status`, `pose_delegate_wait`, `pose_delegate_resume` and `pose_delegate_handoff` run `pose delegate … --json` in the project the server resolved for the call, so every plan, refusal and run is the CLI's: a start, resume or handoff is always detached and returns once the run has reserved its attempt (without `apply` it previews), a status never blocks, and a wait blocks at most its `timeout_seconds` (300 at most), returning `still-running` when the bound passes. Refusals carry the same `reason_code` as the CLI's error document (`rerun-without-reason`, `budget-exhausted`, `containment-incompatible`, `agent-unavailable`, `no-agent`), and results carry the normalized summary only: no transcript, prompt, session reference or environment value. `pose delegate resume` and `handoff` take `--detach` as the purposes do. A task is not started over MCP.\n \n@@ -1075,7 +1075,7 @@ Attach `--run <run-id> --run-proof <proof-id> --sign <issuer>` to a complete `po\n \n **Review readiness before the seal.** A new seal of a spec scope refuses what `pose close` and the conclusion preflight would otherwise refuse only after a full review round: a change to a delivery root with no delivery declaration (`undeclared-delivery`) or to a governed path the artifacts do not declare (`undeclared`), read from the same index `pose close` reads, and, when a required criterion asks for structural mappings, a decision or assumption that reaches no requirement or constraint (give it a `- Basis:` line). A bundle already sealed is returned as it was. `pose review draft-check [<bundle-id|run-id>] --draft <file|-> [--json]` reports every reason the conclusion step would refuse a draft (an unreadable block, a round it does not account for, a criterion, mapping, finding, evidence or tool the attestation preflight refuses) and writes nothing; inside a delegated review the run provides the bundle and the round through `POSE_REVIEW_DRAFT_CONTEXT` and names its own engine in `POSE_REVIEW_CLI`, and `-` reads the draft from standard input, so it works in a read-only sandbox. The brief of template `review-brief/8` asks the reviewer to run it before finishing; `review-brief/9` also has every planned `pose` command run as `\"$POSE_REVIEW_CLI\"`, because the `pose` the reviewer's shell resolves may be an older engine. `pose delegate` names an oversized note file with its size and the limit, and a completed run that nothing concluded automatically prints the `pose review conclude <run>` command that records it.\n \n-**Accepted limits.** A spec may declare the residual limits of its guarantees under `### Accepted limits`, one `- L<N>: <assumption>. Accepted because <reason>.` per limit, whose wrapped lines are indented under it; the section holds only limits, and any other line in it is reported and leaves the limit it belongs to unsealed (HTML comments are not read); `lint-spec --ready-check` refuses a limit that does not say why it is accepted, and, when an ADR cites the spec, one the ADR does not name. The review plan and the bundle seal the limits (`accepted_limits`, part of the plan digest; in a scope with several specs each id is qualified as `<spec>#L<N>`), and the brief of template `review-brief/11` lists them: a finding that falls inside one is a follow-up with `limit` set to its id, recorded in the attestation with disposition `within-limit`, which does not block an approval whatever its severity and is counted apart in the governance outcomes; a limit the bundle did not seal, or a `within-limit` finding without a reason, is refused. A reviewer who finds a limit unjustified reports a finding that disputes it, which blocks as any finding does. A review converges by classifying what was declared out of scope, not by a cap on rounds.\n+**Accepted limits.** A spec may declare the residual limits of its guarantees under `### Accepted limits`, one `- L<N>: <assumption>. Accepted because <reason>.` per limit, whose wrapped lines are indented under it; the section holds only limits, and any other line in it is reported and leaves the limit it belongs to unsealed; an HTML comment marker inside the section or on its heading refuses the whole section, and an unterminated comment anywhere refuses every limit (comments outside the section are not read); `lint-spec --ready-check` refuses a limit that does not say why it is accepted, and, when an ADR cites the spec, one the ADR does not name. The review plan and the bundle seal the limits (`accepted_limits`, part of the plan digest; in a scope with several specs each id is qualified as `<spec>#L<N>`), and the brief of template `review-brief/11` lists them: a finding that falls inside one is a follow-up with `limit` set to its id, recorded in the attestation with disposition `within-limit`, which does not block an approval whatever its severity and is counted apart in the governance outcomes; a limit the bundle did not seal, or a `within-limit` finding without a reason, is refused. A reviewer who finds a limit unjustified reports a finding that disputes it, which blocks as any finding does. A review converges by classifying what was declared out of scope, not by a cap on rounds.\n \n **Runs that leave work behind.** On Linux the dispatch runs the adapter under a review run shim, the same executable re-entered, which is the subreaper of the run's subtree: after the adapter exits, on a timeout, and when its dispatcher ends, it ends and reaps every process left in that subtree, even one that started its own session and cleared its environment, and reports the ended pids through a pipe the reviewer does not inherit; the dispatch lists them in the run's `safety.limitations` before the cleanup inventory. An embedder that does not enable the shim falls back to ending the processes whose environment names the run's sealed checkout (`POSE_SEALED_CHECKOUT`); on other Unix platforms only the process group is ended, and on Windows the adapter runs in a kill-on-close job object that the dispatch terminates after the run, on a timeout and, through the job's limit, when the dispatcher ends. The brief of template `review-brief/10` asks the reviewer to let its commands finish. The dispatch marks an attempt active before it publishes its reservation, so a dispatch that ends before recording its run always leaves a stalled attempt, which `pose delegate ls` lists with its cause, and `pose delegate cancel <attempt>` releases it once its owner is proven gone, recording a failed run and its receipt; one release runs at a time, under a lock the system releases with its holder, and a release completes with any run the attempt already recorded instead of writing another. A reservation an earlier engine left without a marker records no owner: `pose delegate ls` lists it once it is ten minutes old, and `pose delegate cancel <attempt> --confirm-abandoned` releases it on the operator's confirmation that no dispatch of it runs.\n \ndiff --git a/locales/pt-BR/POSE.md b/locales/pt-BR/POSE.md\nindex 2068a227..dd882078 100644\n--- a/locales/pt-BR/POSE.md\n+++ b/locales/pt-BR/POSE.md\n@@ -948,7 +948,7 @@ Reservas ficam em `.pose/review-attempts/`, recibos finais ligam o run, e `.pose\n \n **Runtime opcional por worktree.** `pose runtime start` inicia, destacado, um runtime para este worktree; `attach` e `status` fazem o handshake com ele, `stop` o drena (`--drain <d>`, padrão 5s) e diz quantas requisições em voo terminaram e quantas foram abandonadas, `restart` é stop e depois start, e `serve` o roda em primeiro plano (`--idle <d>`, padrão 30m, para um runtime ocioso; 0 nunca para). É opt-in: nenhum outro comando o inicia, e todo comando roda standalone com ou sem ele. O runtime é identificado pelo usuário, pelo worktree canônico (links resolvidos) e pelo diretório comum do Git, de modo que dois worktrees de um repositório, ou dois usuários, nunca compartilham um; o handshake compara também engine, build, protocolo e schema, e um attach de outro engine é recusado nomeando o campo. O endpoint é um socket de domínio Unix (Linux, macOS) com modo 0600 num diretório 0700 do usuário (`$XDG_RUNTIME_DIR/pose`, senão `pose-runtime-<uid>` sob o diretório temporário, ou `POSE_RUNTIME_DIR`), cujo par o sistema operacional identifica antes de se ler um byte; um link, um modo frouxo, outro dono ou um arquivo que não é socket são recusados, e um socket em que ninguém responde é substituído. Não há TCP nem token. A fatia 1 não hospeda nenhuma operação do domínio: responde handshake, status e stop, não confere autoridade, assinatura nem presença, e cada restart tem uma época nova, sem herdar nada. No Windows, que não tem implementação de named pipe aqui, `status` informa `unsupported` e todo comando roda standalone. `status` sai com 0 para running, standalone e unsupported e com 1 para um runtime incompatível; `attach` também sai com 1 quando não há o que anexar. `--json` imprime o documento `pose.runtime.status/1`.\n \n-**Checks hospedados e o memo residente do Git.** `pose runtime run [--envelope] [--timeout <d>] <comando> [args...]` roda `review-check`, `closeout-check`, `artifact-check`, `surface-check` ou `roadmap-check` no runtime do worktree quando há um rodando, compatível e disposto, e standalone neste processo caso contrário; o código de saída e a saída são os do comando, e `--envelope` imprime um documento (`pose.runtime.run/1`) com eles e com `via` (`runtime` ou `standalone`), o `fallback_reason`, o `outcome` tipado (`completed`; `error` quando o comando rodou e terminou mas a saída (acima de 2 MiB) não volta, com o código de saída do comando; ou `unknown` para um prazo ou uma resposta perdida), a época e os acertos do memo. O runtime recusa, antes de o comando começar, o que ele não hospeda e um chamador cujo digest de ambiente (as variáveis `POSE_`, `HARNE8_`, `GIT_`, `CLAUDE` e `CODEX`, `XDG_STATE_HOME`, `XDG_CONFIG_HOME` e `XDG_RUNTIME_DIR`, o locale, `HOME`, `NO_COLOR` e o usuário) difere do dele, e o chamador roda standalone; um comando que chegou ao runtime e cuja resposta não voltou inteira, ou cujo `--timeout` passou, pode ter rodado e nunca é repetido standalone sem pedido: sai com 1 e diz isso. O runtime roda os comandos hospedados como o usuário que o iniciou, no seu worktree, com a saída de um não terminal, nas faixas de admissão descritas adiante; um comando que ainda espera o seu slot quando o `--timeout` passa é recusado, não iniciado, de modo que o chamador o roda standalone. Um runtime também guarda, entre comandos, a saída das leituras do Git que são funções puras de ids de objeto ou do commit que o HEAD nomeava quando rodaram, chaveada por esse commit e pelo estado raso (256 MiB, a menos recentemente usada primeiro; não para um worktree vinculado): o segundo `review-check` deste repositório levou cerca de 10 s contra cerca de 25 s standalone, com a mesma saída. O runtime admite os comandos hospedados em duas faixas, cada uma com seus slots e uma fila limitada: `short` (`surface-check`, cerca de 10 ms neste repositório) e `heavy` (os demais comandos hospedados; `roadmap-check <slug>` leva minutos aqui), 2 e 1 slots por padrão e filas de 16 e 4; `pose runtime start|serve` aceitam `--short-slots`, `--heavy-slots`, `--short-queue`, `--heavy-queue` e `--memo-mib` (padrão 256). Uma consulta curta não espera atrás de um check pesado, e um comando que encontra todos os slots da sua faixa ocupados e a fila cheia é recusado antes de esperar e roda standalone. `status` e o handshake trazem, por faixa, `<faixa>_slots`, `_queue_limit`, `_queued`, `_running`, `_admitted`, `_refused`, `_wait_ms_total` e `_wait_ms_max` em `metrics`. Uma medição do runtime num repositório real, com os limiares fixados antes dos números, é `POSE_RUNTIME_MEASURE=<arquivo> go test ./internal/cli -run TestMeasureTheRuntimeOnTheRealRepository`; o relatório fica em `.pose/reports/`.\\n\\n**Rodadas de review.** As rodadas de um escopo são os bundles selados em que uma review delegada concluída terminou, na ordem em que esses runs terminaram; `pose review verify`, `pose delegate ls` e `pose insights` mostram a rodada. A partir da rodada 2, o brief gerado (template `review-brief/2`; runs com `review-brief/1` continuam verificando) traz uma seção `Previous round` construída do ledger: cada finding aberto com o identificador que mantém entre rodadas (`R<rodada>-<id>`), sua severidade, disposição e local, o run anterior e o digest do seu draft. O draft do revisor é o bloco de código cercado cuja info string é `pose-draft`: JSON com `schema` `pose.review.draft/v1`, `decision` e `findings` (`id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line`, `summary`), e a partir da rodada 2 `prior_findings` (`id`, `status` fixed|partial|not-fixed|superseded, `evidence`) e `sweep`. Um finding reportado `partial` ou `not-fixed` mantém seu identificador no brief seguinte. Um draft da rodada 2 em diante que deixa um finding aberto sem conta, marca um como `fixed` sem evidência ou não declara a varredura é registrado com `draft_problems`, o `wait` o reporta como `invalid`, e ele nunca é aceito como aprovação. Com `routing.rounds` `continue-thread` (o padrão), uma rodada retoma a sessão com que a rodada anterior terminou, pelo comando de resume do agente; ela abre uma sessão nova, registrando o motivo, quando o agente ou seu vendor muda, a cadeia de drafts está quebrada, essa sessão não pode ser retomada, ou a rodada atinge `routing.round_threshold` (5 por padrão), onde o `verify` também avisa que as rodadas não estão convergindo. `cold-session` abre uma sessão nova a cada rodada. Cada run registra sua `round` e sua `thread`; `pose insights` reporta, por escopo, findings por rodada, rodadas até a aprovação, e como os findings anteriores foram contabilizados em rodadas continuadas e frias. Uma rodada anterior cujo registro não está íntegro faz o brief recusar.\n+**Checks hospedados e o memo residente do Git.** `pose runtime run [--envelope] [--timeout <d>] <comando> [args...]` roda `review-check`, `closeout-check`, `artifact-check`, `surface-check` ou `roadmap-check` no runtime do worktree quando há um rodando, compatível e disposto, e standalone neste processo caso contrário; o código de saída e a saída são os do comando, e `--envelope` imprime um documento (`pose.runtime.run/1`) com eles e com `via` (`runtime` ou `standalone`), o `fallback_reason`, o `outcome` tipado (`completed`; `error` quando o comando rodou e terminou mas a saída (acima de 2 MiB) não volta, com o código de saída do comando; ou `unknown` para um prazo ou uma resposta perdida), a época e os acertos do memo. O runtime recusa, antes de o comando começar, o que ele não hospeda e um chamador cujo digest de ambiente (as variáveis `POSE_`, `HARNE8_`, `GIT_`, `CLAUDE` e `CODEX`, `XDG_STATE_HOME`, `XDG_CONFIG_HOME` e `XDG_RUNTIME_DIR`, o locale, `HOME`, `NO_COLOR` e o usuário) difere do dele, e o chamador roda standalone; um comando que chegou ao runtime e cuja resposta não voltou inteira, ou cujo `--timeout` passou, pode ter rodado e nunca é repetido standalone sem pedido: sai com 1 e diz isso. O runtime roda os comandos hospedados como o usuário que o iniciou, no seu worktree, com a saída de um não terminal, nas faixas de admissão descritas adiante; um comando que ainda espera o seu slot quando o `--timeout` passa é recusado, não iniciado, de modo que o chamador o roda standalone. Um runtime também guarda, entre comandos, a saída das leituras do Git que são funções puras de ids de objeto ou do commit que o HEAD nomeava quando rodaram, chaveada por esse commit e pelo estado raso (256 MiB, a menos recentemente usada primeiro; não para um worktree vinculado): o segundo `review-check` deste repositório levou cerca de 10 s contra cerca de 25 s standalone, com a mesma saída. O runtime admite os comandos hospedados em duas faixas, cada uma com seus slots e uma fila limitada: `short` (`surface-check`, cerca de 10 ms neste repositório) e `heavy` (os demais comandos hospedados; `roadmap-check <slug>` leva minutos aqui), 2 e 1 slots por padrão e filas de 16 e 4; `pose runtime start|serve` aceitam `--short-slots`, `--heavy-slots`, `--short-queue`, `--heavy-queue` e `--memo-mib` (padrão 256). Uma consulta curta não espera atrás de um check pesado, e um comando que encontra todos os slots da sua faixa ocupados e a fila cheia é recusado antes de esperar e roda standalone. `status` e o handshake trazem, por faixa, `<faixa>_slots`, `_queue_limit`, `_queued`, `_running`, `_admitted`, `_refused`, `_wait_ms_total` e `_wait_ms_max` em `metrics`. Uma medição do runtime num repositório real, com os limiares fixados antes dos números, é `POSE_RUNTIME_MEASURE=<arquivo> go test ./internal/cli -run TestMeasureTheRuntimeOnTheRealRepository`; o relatório fica em `.pose/reports/`.\\n\\n**Rodadas de review.** As rodadas de um escopo são os bundles selados em que uma review delegada concluída terminou, na ordem em que esses runs terminaram; `pose review verify`, `pose delegate ls` e `pose insights` mostram a rodada. A partir da rodada 2, o brief gerado (template `review-brief/2`; runs com `review-brief/1` continuam verificando) traz uma seção `Previous round` construída do ledger: cada finding aberto com o identificador que mantém entre rodadas (`R<rodada>-<id>`), sua severidade, disposição e local, o run anterior e o digest do seu draft. O draft do revisor é o bloco de código cercado cuja info string é `pose-draft`: JSON com `schema` `pose.review.draft/v1`, `decision` e `findings` (`id`, `severity` high|medium|low, `disposition` blocker|follow-up, `file`, `line`, `summary`), e a partir da rodada 2 `prior_findings` (`id`, `status` fixed|partial|not-fixed|superseded, `evidence`) e `sweep`. Um finding reportado `partial` ou `not-fixed` mantém seu identificador no brief seguinte. Um draft da rodada 2 em diante que deixa um finding aberto sem conta, marca um como `fixed` sem evidência ou não declara a varredura é registrado com `draft_problems`, o `wait` o reporta como `invalid`, e ele nunca é aceito como aprovação. Com `routing.rounds` `continue-thread` (o padrão), uma rodada retoma a sessão com que a rodada anterior terminou, pelo comando de resume do agente; ela abre uma sessão nova, registrando o motivo, quando o agente ou seu vendor muda, a cadeia de drafts está quebrada, essa sessão não pode ser retomada, o caminho do checkout da rodada anterior ainda existe (uma sobra ou uma run viva), ou a rodada atinge `routing.round_threshold` (5 por padrão), onde o `verify` também avisa que as rodadas não estão convergindo. Quando esse caminho só é ocupado depois que a rodada foi planejada, a rodada mantém a sessão continuada mas trabalha no próprio diretório, e a run registra a mudança em `safety.limitations`. `cold-session` abre uma sessão nova a cada rodada. Cada run registra sua `round` e sua `thread`; `pose insights` reporta, por escopo, findings por rodada, rodadas até a aprovação, e como os findings anteriores foram contabilizados em rodadas continuadas e frias. Uma rodada anterior cujo registro não está íntegro faz o brief recusar.\n \n **Runs delegados pelo MCP.** `pose_delegate_start` (review, adjudicate ou smoke), `pose_delegate_status`, `pose_delegate_wait`, `pose_delegate_resume` e `pose_delegate_handoff` rodam `pose delegate … --json` no projeto que o servidor resolveu para a chamada, então todo plano, recusa e run é o da CLI: um start, resume ou handoff é sempre destacado e volta quando o run reservou sua tentativa (sem `apply` ele faz a prévia), um status nunca bloqueia, e um wait bloqueia no máximo seu `timeout_seconds` (300 no máximo), devolvendo `still-running` quando o limite passa. Recusas trazem o mesmo `reason_code` do documento de erro da CLI (`rerun-without-reason`, `budget-exhausted`, `containment-incompatible`, `agent-unavailable`, `no-agent`), e os resultados trazem só o resumo normalizado: nenhum transcript, prompt, referência de sessão ou valor de ambiente. `pose delegate resume` e `handoff` aceitam `--detach` como os propósitos. Uma task não é iniciada pelo MCP.\n \n@@ -1072,7 +1072,7 @@ Acrescente `--run <run-id> --run-proof <proof-id> --sign <issuer>` a uma solicit\n \n **Prontidão da review antes da selagem.** Uma nova selagem de escopo de spec recusa o que `pose close` e a preflight da conclusão só recusariam depois de uma rodada completa de review: uma mudança em raiz de entrega sem declaração de entrega (`undeclared-delivery`) ou em caminho governado que os artefatos não declaram (`undeclared`), lidas do mesmo índice que `pose close` lê, e, quando um critério obrigatório pede mapeamentos estruturais, uma decisão ou premissa que não alcança requisito nem restrição (dê a ela uma linha `- Basis:`). Um bundle já selado é devolvido como estava. `pose review draft-check [<bundle-id|run-id>] --draft <arquivo|-> [--json]` relata todo motivo pelo qual a conclusão recusaria um rascunho (bloco ilegível, rodada não contabilizada, critério, mapeamento, achado, evidência ou ferramenta que a preflight da atestação recusa) e não grava nada; dentro de uma review delegada o run fornece o bundle e a rodada por `POSE_REVIEW_DRAFT_CONTEXT` e nomeia o próprio motor em `POSE_REVIEW_CLI`, e `-` lê o rascunho da entrada padrão, então funciona num sandbox somente leitura. O brief do template `review-brief/8` pede ao revisor que o rode antes de terminar; o `review-brief/9` também manda rodar cada comando `pose` do plano como `\"$POSE_REVIEW_CLI\"`, porque o `pose` que o shell do revisor resolve pode ser um motor mais antigo. `pose delegate` nomeia um arquivo de nota grande demais com seu tamanho e o limite, e um run concluído que nada concluiu automaticamente imprime o comando `pose review conclude <run>` que o registra.\n \n-**Limites aceitos.** Uma spec pode declarar os limites residuais das suas garantias em `### Accepted limits`, um `- L<N>: <suposição>. Accepted because <motivo>.` por limite, cujas linhas de continuação ficam indentadas sob ele; a seção contém apenas limites, e qualquer outra linha nela é reportada e deixa sem selo o limite a que pertence (comentários HTML não são lidos); `lint-spec --ready-check` recusa um limite que não diz por que é aceito e, quando um ADR cita a spec, um que o ADR não nomeia. O plano de review e o bundle selam os limites (`accepted_limits`, parte do digest do plano; num escopo com várias specs cada id é qualificado como `<spec>#L<N>`), e o brief do template `review-brief/11` os lista: um achado que cai dentro de um deles é um follow-up com `limit` igual ao seu id, registrado na atestação com a disposição `within-limit`, que não bloqueia uma aprovação seja qual for a severidade e é contado à parte nos resultados de governança; um limite que o bundle não selou, ou um achado `within-limit` sem motivo, é recusado. Um revisor que ache um limite injustificado relata um achado que o contesta, que bloqueia como qualquer achado. Uma review converge classificando o que foi declarado fora do escopo, não por um teto de rodadas.\n+**Limites aceitos.** Uma spec pode declarar os limites residuais das suas garantias em `### Accepted limits`, um `- L<N>: <suposição>. Accepted because <motivo>.` por limite, cujas linhas de continuação ficam indentadas sob ele; a seção contém apenas limites, e qualquer outra linha nela é reportada e deixa sem selo o limite a que pertence; um marcador de comentário HTML dentro da seção ou no título dela recusa a seção inteira, e um comentário sem fechamento em qualquer lugar recusa todos os limites (comentários fora da seção não são lidos); `lint-spec --ready-check` recusa um limite que não diz por que é aceito e, quando um ADR cita a spec, um que o ADR não nomeia. O plano de review e o bundle selam os limites (`accepted_limits`, parte do digest do plano; num escopo com várias specs cada id é qualificado como `<spec>#L<N>`), e o brief do template `review-brief/11` os lista: um achado que cai dentro de um deles é um follow-up com `limit` igual ao seu id, registrado na atestação com a disposição `within-limit`, que não bloqueia uma aprovação seja qual for a severidade e é contado à parte nos resultados de governança; um limite que o bundle não selou, ou um achado `within-limit` sem motivo, é recusado. Um revisor que ache um limite injustificado relata um achado que o contesta, que bloqueia como qualquer achado. Uma review converge classificando o que foi declarado fora do escopo, não por um teto de rodadas.\n \n **Runs que deixam trabalho para trás.** No Linux o envio roda o adaptador sob um shim de run de review, o mesmo executável reentrado, que é o subreaper da subárvore do run: depois que o adaptador termina, num timeout e quando o envio termina, ele encerra e recolhe todo processo que restou nessa subárvore, mesmo um que abriu sessão própria e limpou o ambiente, e relata os pids encerrados por um pipe que o revisor não herda; o envio os lista em `safety.limitations` do run antes do inventário de limpeza. Quem embute o motor sem ativar o shim recorre a encerrar os processos cujo ambiente nomeia o checkout selado do run (`POSE_SEALED_CHECKOUT`); nas outras plataformas Unix só o grupo de processos é encerrado, e no Windows o adaptador roda num job object com encerramento ao fechar, que o envio termina depois do run, num timeout e, pelo limite do job, quando o envio termina. O brief do template `review-brief/10` pede ao revisor que deixe seus comandos terminarem. O envio marca a tentativa como ativa antes de publicar a reserva, então um envio que termina antes de registrar o run sempre deixa uma tentativa parada, que `pose delegate ls` lista com a causa, e `pose delegate cancel <tentativa>` a libera quando o dono está comprovadamente encerrado, registrando um run com falha e o seu recibo; uma liberação roda por vez, sob um lock que o sistema libera junto com quem o detém, e uma liberação conclui com qualquer run que a tentativa já registrou em vez de gravar outro. Uma reserva que um motor anterior deixou sem marcador não registra dono: `pose delegate ls` a lista depois de dez minutos, e `pose delegate cancel <tentativa> --confirm-abandoned` a libera com a confirmação do operador de que nenhum envio dela está rodando.\n \ndiff --git a/pose-mcp/internal/cli/accepted_limits_lint_test.go b/pose-mcp/internal/cli/accepted_limits_lint_test.go\nindex 353e276e..29258df0 100644\n--- a/pose-mcp/internal/cli/accepted_limits_lint_test.go\n+++ b/pose-mcp/internal/cli/accepted_limits_lint_test.go\n@@ -2,8 +2,10 @@ package cli\n \n import (\n \t\"bytes\"\n+\t\"encoding/json\"\n \tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n \t\"os\"\n+\t\"os/exec\"\n \t\"path/filepath\"\n \t\"strings\"\n \t\"testing\"\n@@ -114,3 +116,50 @@ func TestWithinLimitFindingsAreTypedAndShown(t *testing.T) {\n \t\tt.Fatalf(\"the text output: %q\", out.String())\n \t}\n }\n+\n+// Spec pose-review-declared-limits-residuals R7: pose review-check and pose\n+// closeout-check print a recorded within-limit finding.\n+func TestTheChecksPrintWithinLimitFindings(t *testing.T) {\n+\troot := reviewBundleCLIFixture(t)\n+\tspec := filepath.Join(root, \".pose/specs/bundle/spec.md\")\n+\traw, err := os.ReadFile(spec)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.WriteFile(spec, []byte(strings.Replace(string(raw), \"### Risks\", \"### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\\n### Risks\", 1)), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor _, args := range [][]string{{\"add\", \"-A\"}, {\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-q\", \"-m\", \"limits\"}} {\n+\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...).CombinedOutput(); err != nil {\n+\t\t\tt.Fatal(args, err, string(out))\n+\t\t}\n+\t}\n+\tvar out, errOut bytes.Buffer\n+\tif code := cmdReview(root, []string{\"bundle\", \"spec:bundle\", \"--seal\", \"--json\"}, &out, &errOut); code != 0 {\n+\t\tt.Fatalf(\"seal code=%d err=%s\", code, errOut.String())\n+\t}\n+\tvar sealed posemodel.ReviewBundle\n+\tif err := json.Unmarshal(out.Bytes(), &sealed); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tevidence := sealed.Payload.Evidence[0].EvidenceClass + \":\" + sealed.Payload.Evidence[0].ID\n+\tout.Reset()\n+\terrOut.Reset()\n+\tattest := []string{\"attest\", sealed.BundleID, \"--reviewer\", \"agent:reviewer\", \"--decision\", \"approved\", \"--evidence\", evidence, \"--tool\", \"artifact-check|-|passed|check:artifact|\", \"--tool\", \"validate|pose-mcp|passed|validation:module|\", \"--finding\", \"n1|low|within-limit|note it|\" + evidence + \"||it is inside L1||L1\", \"--apply\"}\n+\tif code := cmdReview(root, attest, &out, &errOut); code != 0 {\n+\t\tt.Fatalf(\"attest code=%d out=%s err=%s\", code, out.String(), errOut.String())\n+\t}\n+\trun := func(args ...string) string {\n+\t\tvar o, e bytes.Buffer\n+\t\tinDir(t, root, func() { Main(args, &o, &e) })\n+\t\treturn o.String() + e.String()\n+\t}\n+\tfor _, tc := range []struct{ out, field string }{\n+\t\t{run(\"review-check\", \"spec:bundle\"), \"review.within_limit=\"},\n+\t\t{run(\"closeout-check\", \"spec:bundle\"), \"closeout.within_limit=\"},\n+\t} {\n+\t\tif !strings.Contains(tc.out, tc.field) || !strings.Contains(tc.out, \"n1 limit:L1\") {\n+\t\t\tt.Fatalf(\"%s missing:\\n%s\", tc.field, tc.out)\n+\t\t}\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/accepted_limits_test.go b/pose-mcp/internal/pose/accepted_limits_test.go\nindex 272a73f0..9ea98233 100644\n--- a/pose-mcp/internal/pose/accepted_limits_test.go\n+++ b/pose-mcp/internal/pose/accepted_limits_test.go\n@@ -228,7 +228,7 @@ func TestAcceptedLimitsEndWhereTheirItemEnds(t *testing.T) {\n // code included, is reported and nothing is sealed cut by it.\n func TestAcceptedLimitsRefuseWhatWouldCutThem(t *testing.T) {\n \tcases := []struct{ name, body, problem string }{\n-\t\t{\"indented heading\", \"### Accepted limits\\n- L1: An escape is open. Accepted because a shim covers it\\n  # of cases on Linux and only for children.\\n\", \"heading inside a limit\"},\n+\t\t{\"indented heading\", \"### Accepted limits\\n- L1: An escape is open. Accepted because a shim covers it\\n  # of cases on Linux and only for children.\\n\", \"indented heading-like line\"},\n \t\t{\"second unterminated comment\", \"<!-- closed -->\\n### Accepted limits\\n- L1: An escape is open. Accepted because it is rare <!-- and so on\\n\", \"HTML comment\"},\n \t\t{\"unterminated after a closed one\", \"<!-- closed -->\\n<!-- open\\n### Accepted limits\\n- L1: An escape is open. Accepted because it is rare.\\n\", \"unterminated HTML comment\"},\n \t\t{\"unterminated after a closed one, in code\", \"A spec may name `<!--` in its prose.\\n<!-- closed -->\\n### Accepted limits\\n- L1: An escape is open. Accepted because it is rare <!-- and so on\\n\", \"HTML comment\"},\n@@ -303,7 +303,7 @@ func TestAcceptedLimitsReadCommentsWhereTheSectionIs(t *testing.T) {\n \t\t}\n \t}\n \tindented := \"### Accepted limits\\n  - L1: An escape is open. Accepted because a shim covers it\\n  # of cases on Linux.\\n\"\n-\tif limits, problems := ParseAcceptedLimits(indented); len(limits) != 0 || !strings.Contains(strings.Join(problems, \";\"), \"heading inside a limit\") {\n+\tif limits, problems := ParseAcceptedLimits(indented); len(limits) != 0 || !strings.Contains(strings.Join(problems, \";\"), \"indented heading-like line\") {\n \t\tt.Fatalf(\"an indented heading under an indented marker: %+v %v\", limits, problems)\n \t}\n }\n","numLines":194,"startLine":1,"totalLines":194}},"tool_result_meta":[{"id":"toolu_01CzkyeyBLcJX2gaqhRc57UF","permission_decision":{"decision":"accept","source":"config","reason_type":"other"}}]}
