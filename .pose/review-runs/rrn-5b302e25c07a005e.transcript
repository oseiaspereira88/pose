ew round 1, B01).\n634\t\t\tif why := verdictIndependenceReason(*bundle, assurance, run.RunID); why != \"\" {\n635\t\t\t\tresult.ProofID, result.Reasons = proof.ProofID, []string{why}\n636\t\t\t\treturn finish(result)\n637\t\t\t}\n638\t\t\tdestination, named, err := s.recordDelegatedVerdict(run, *bundle, *draft, proof.ProofID, issuer, now)\n639\t\t\tif errors.Is(err, errVerdictDestinationBusy) {\n640\t\t\t\t// The reservation stays: the verdict is published by a later\n641\t\t\t\t// conclusion once the lock is free, never refused for it.\n642\t\t\t\tpending.Reasons = []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n643\t\t\t\treturn pending, err\n644\t\t\t}\n645\t\t\tif err != nil {\n646\t\t\t\tresult.ProofID, result.Reasons = proof.ProofID, []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n647\t\t\t\treturn finish(result)\n648\t\t\t}\n649\t\t\tresult.State, result.ProofID, result.Destination = ReviewConclusionRecorded, named, destination\n650\t\t\treturn finish(result)\n651\t\t}\n652\t\tatt := reviewAttestationFromDraft(run, *bundle, *draft, assurance.Reviewer.Principal)\n653\t\tatt.Run.ProofID = proof.ProofID\n654\t\tauthority := &NativeAuthority{ReviewExecution: run.RunID, ImplementationPrincipal: assurance.Implementation.Principal, ImplementationExecution: assurance.Implementation.Execution}\n655\t\tenvelope, err := s.SignReviewAttestation(att, key, authority, now)\n656\t\tif err == nil {\n657\t\t\tvar verified ReviewAttestation\n658\t\t\tif verified, err = s.RecordReviewAttestationEnvelope(envelope, false); err == nil {\n659\t\t\t\tif blockers := s.PreflightReviewAttestation(verified, now); len(blockers) > 0 {\n660\t\t\t\t\terr = fmt.Errorf(\"the attestation preflight refuses it: %s\", strings.Join(blockers, \"; \"))\n661\t\t\t\t}\n662\t\t\t}\n663\t\t}\n664\t\tvar recorded ReviewAttestation\n665\t\tif err == nil {\n666\t\t\trecorded, err = s.RecordReviewAttestationEnvelope(envelope, true)\n667\t\t}\n668\t\tif err != nil {\n669\t\t\tvar refusal *Revie