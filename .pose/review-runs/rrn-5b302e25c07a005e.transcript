{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GvdjU4iqwkx5xTbXX4i5r9","type":"tool_result","content":"2975\t\treturn att, pending, nil\n2976\t}\n2977\t\n2978\t// RecordReviewAttestation appends an immutable decision for one sealed bundle.\n2979\tfunc (s Store) RecordReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n2980\t\tvar result ReviewAttestation\n2981\t\terr := s.withReviewAttestationWriteGuard(\"review.attestation.record\", att, func(guarded Store) error {\n2982\t\t\tvar err error\n2983\t\t\tresult, err = guarded.recordReviewAttestation(att, now, false)\n2984\t\t\treturn err\n2985\t\t})\n2986\t\treturn result, err\n2987\t}\n2988\t\n2989\tfunc (s Store) recordReviewAttestation(att ReviewAttestation, now time.Time, signed bool) (ReviewAttestation, error) {\n2990\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n2991\t\tif err != nil {\n2992\t\t\treturn ReviewAttestation{}, err\n2993\t\t}\n2994\t\tpolicy, _, err := s.loadReviewPolicy()\n2995\t\tif err != nil {\n2996\t\t\treturn ReviewAttestation{}, err\n2997\t\t}\n2998\t\tif policy.RequireSignedAttestations && !signed {\n2999\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review policy requires a trusted signed attestation envelope\")\n3000\t\t}\n3001\t\tatt, err = completeReviewAttestation(bundle, att, now)\n3002\t\tif err != nil {\n3003\t\t\treturn ReviewAttestation{}, err\n3004\t\t}\n3005\t\t// The approval preflight runs here, in the one writer every channel shares,\n3006\t\t// before anything is written: an approval the verifier would reject is\n3007\t\t// refused, not recorded and rejected later (spec\n3008\t\t// pose-review-approval-domain-preflight).\n3009\t\tif blockers := s.reviewApprovalAdmissionBlockers(bundle, att, now); len(blockers) > 0 {\n3010\t\t\treturn ReviewAttestation{}, &ReviewApprovalRefusal{BundleID: bundle.BundleID, Blockers: blockers}\n3011\t\t}\n3012\t\tatt.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", att.AttestationID+\".json\"))\n3013\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), true)\n3014\t\tif err != nil {\n3015\t\t\treturn ReviewAttestation{}, err\n3016\t\t}\n3017\t\tpath := filepath.Join(dir, att.AttestationID+\".json\")\n3018\t\tif existing, loadErr := s.LoadReviewAttestation(att.AttestationID); loadErr == nil {\n3019\t\t\texistingRaw, _ := json.Marshal(existing)\n3020\t\t\tcandidateRaw, _ := json.Marshal(att)\n3021\t\t\tif bytes.Equal(existingRaw, candidateRaw) {\n3022\t\t\t\treturn existing, nil\n3023\t\t\t}\n3024\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation identity collision for %s\", att.AttestationID)\n3025\t\t}\n3026\t\traw, err := json.MarshalIndent(att, \"\", \"  \")\n3027\t\tif err != nil {\n3028\t\t\treturn ReviewAttestation{}, err\n3029\t\t}\n3030\t\tif err := writeImmutableJSONIn(s.fsys(), path, append(raw, '\\n')); err != nil {\n3031\t\t\tvar durability *PublishDurabilityError\n3032\t\t\tif errors.As(err, &durability) {\n3033\t\t\t\treturn att, err\n3034\t\t\t}\n3035\t\t\treturn ReviewAttestation{}, err\n3036\t\t}\n3037\t\treturn att, nil\n3038\t}\n3039\t\n3040\t// completeReviewAttestation fills and checks what recording sets: the bundle\n3041\t// binding, schema, attested time and content-derived id. Recording and the MCP\n3042\t// preview share it, so an issuer that signs a previewed attestation signs the\n3043\t// bytes that will be recorded (spec pose-mcp-review-attest-signed-only).\n3044\tfunc completeReviewAttestation(bundle ReviewBundle, att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n3045\t\tif att.Limitations == nil {\n3046\t\t\tatt.Limitations = append([]string(nil), bundle.Payload.Plan.Limitations...)\n3047\t\t}\n3048\t\tif strings.Join(att.Limitations, \"\\x00\") != strings.Join(bundle.Payload.Plan.Limitations, \"\\x00\") {\n3049\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation must retain the sealed review limitations\")\n3050\t\t}\n3051\t\tif att.BundleDigest == \"\" {\n3052\t\t\tatt.BundleDigest = bundle.BundleDigest\n3053\t\t}\n3054\t\tif att.BundleDigest != bundle.BundleDigest {\n3055\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation bundle digest mismatch\")\n3056\t\t}\n3057\t\tif att.Reviewer == \"\" || strings.ContainsAny(att.Reviewer, \"\\r\\n\") || (!strings.HasPrefix(att.Reviewer, \"agent:\") && !strings.HasPrefix(att.Reviewer, \"human:\")) {\n3058\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid reviewer execution identity\")\n3059\t\t}\n3060\t\tif att.Decision != \"approved\" && att.Decision != \"approved-with-reservations\" && att.Decision != \"changes-requested\" && att.Decision != \"rejected\" {\n3061\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid review decision %q\", att.Decision)\n3062\t\t}\n3063\t\tif err := ValidateReviewAttribution(att); err != nil {\n3064\t\t\treturn ReviewAttestation{}, err\n3065\t\t}\n3066\t\tatt.SchemaVersion = ReviewBundleSchemaVersion\n3067\t\tif att.AttestedAt == \"\" {\n3068\t\t\tatt.AttestedAt = now.UTC().Truncate(time.Second).Format(time.RFC3339)\n3069\t\t} else if _, err := time.Parse(time.RFC3339, att.AttestedAt); err != nil {\n3070\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attested_at must be RFC3339\")\n3071\t\t}\n3072\t\tatt.BundleID = bundle.BundleID\n3073\t\tatt.BundleDigest = bundle.BundleDigest\n3074\t\texpectedAttestationID := reviewAttestationID(att)\n3075\t\tif att.AttestationID == \"\" {\n3076\t\t\tatt.AttestationID = expectedAttestationID\n3077\t\t} else if att.AttestationID != expectedAttestationID {\n3078\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation id does not match its content digest\")\n3079\t\t}\n3080\t\tif !strings.HasPrefix(att.AttestationID, \"rva-\") || len(att.AttestationID) != 20 {\n3081\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid attestation id\")\n3082\t\t}\n3083\t\treturn att, nil\n3084\t}\n3085\t\n3086\t// SignableReviewAttestation completes a draft attestation for its sealed bundle\n3087\t// as recording would, including the confirmation digest when the draft names a\n3088\t// confirming principal, and returns it with the canonical bytes a trusted\n3089\t// issuer signs into a ReviewAttestationEnvelope. It records nothing.\n3090\tfunc (s Store) SignableReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, []byte, error) {\n3091\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n3092\t\tif err != nil {\n3093\t\t\treturn ReviewAttestation{}, nil, err\n3094\t\t}\n3095\t\tif att.BundleDigest == \"\" {\n3096\t\t\tatt.BundleDigest = bundle.BundleDigest\n3097\t\t}\n3098\t\tif a := att.Attribution; a != nil && a.ConfirmedBy != \"\" && a.ConfirmationDigest == \"\" {\n3099\t\t\tbound := *a\n3100\t\t\tbound.ConfirmationDigest = ReviewConfirmationDigest(att)\n3101\t\t\tatt.Attribution = &bound\n3102\t\t}\n3103\t\tatt.Path, att.Envelope = \"\", nil\n3104\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\n3105\t\tif err != nil {\n3106\t\t\treturn ReviewAttestation{}, nil, err\n3107\t\t}\n3108\t\tcanonical, err := json.Marshal(completed)\n3109\t\tif err != nil {\n3110\t\t\treturn ReviewAttestation{}, nil, err\n3111\t\t}\n3112\t\treturn completed, canonical, nil\n3113\t}\n3114\t\n3115\t// RecordReviewAttestationEnvelope verifies a trusted issuer's envelope and,\n3116\t// with apply, records the attestation it carries: the path both\n3117\t// `pose review attest --envelope` and the MCP tool take.\n3118\tfunc (s Store) RecordReviewAttestationEnvelope(envelope ReviewAttestationEnvelope, apply bool) (ReviewAttestation, error) {\n3119\t\tif !apply {\n3120\t\t\treturn s.VerifyReviewAttestationEnvelope(envelope)\n3121\t\t}\n3122\t\tvar result ReviewAttestation\n3123\t\terr := s.withReviewAttestationWriteGuard(\"review.attestation.envelope\", envelope.Attestation, func(guarded Store) error {\n3124\t\t\tattestation, err := guarded.VerifyReviewAttestationEnvelope(envelope)\n3125\t\t\tif err != nil {\n3126\t\t\t\treturn err\n3127\t\t\t}\n3128\t\t\tresult, err = guarded.recordReviewAttestation(attestation, guarded.reviewClock(), true)\n3129\t\t\treturn err\n3130\t\t})\n3131\t\treturn result, err\n3132\t}\n3133\t\n3134\t// ErrReviewApprovalRefused classifies a ReviewApprovalRefusal for errors.Is.\n3135\tvar ErrReviewApprovalRefused = errors.New(\"pose: review approval refused before persistence\")\n3136\t\n3137\t// ReviewApprovalRefusal is the typed result of the domain approval preflight:\n3138\t// every reason the verifier would reject the approval, returned before any\n3139\t// artifact of the attempt is written. Every channel — Store, CLI, signed\n3140\t// import and MCP — receives this same value.\n3141\ttype ReviewApprovalRefusal struct {\n3142\t\tBundleID string   `json:\"bundle_id\"`\n3143\t\tBlockers []string `json:\"blockers\"`\n3144\t}\n3145\t\n3146\tfunc (e *ReviewApprovalRefusal) Error() string {\n3147\t\treturn \"pose: verify would reject this approval for bundle \" + e.BundleID + \", so nothing was written: \" + strings.Join(e.Blockers, \"; \")\n3148\t}\n3149\t\n3150\tfunc (e *ReviewApprovalRefusal) Unwrap() error { return ErrReviewApprovalRefused }\n3151\t\n3152\tfunc reviewDecisionApproves(decision string) bool {\n3153\t\treturn decision == \"approved\" || decision == \"approved-with-reservations\"\n3154\t}\n3155\t\n3156\t// reviewApprovalAdmissionBlockers is the semantic admission of a new approving\n3157\t// attestation, completed as it will be recorded. It reuses the verifier itself\n3158\t// over the bundle's sealed gates and the deliberately live signing and trust\n3159\t// requirements, adds the time admissibility of a new operation, and requires\n3160\t// the bundle to still be the current sealed subject of its scope, so the\n3161\t// approval of a stale preview or of a superseded bundle is not written.\n3162\t//\n3163\t// A non-approving decision is an audit record the verifier rejects for\n3164\t// closeout by definition, so its criteria are not held to the approval bar;\n3165\t// its channel's authentication still applies in the writer.\n3166\tfunc (s Store) reviewApprovalAdmissionBlockers(bundle ReviewBundle, att ReviewAttestation, now time.Time) []string {\n3167\t\tif !reviewDecisionApproves(att.Decision) {\n3168\t\t\t// Whatever the decision, no attestation names a limit the bundle\n3169\t\t\t// did not seal (spec pose-review-declared-limits-residuals R6).\n3170\t\t\treturn unsealedLimitBlockers(bundle, att)\n3171\t\t}\n3172\t\tblockers := s.atReviewTime(now).validateBundleAttestation(bundle, att)\n3173\t\tblockers = append(blockers, reviewNewOperationTimeBlockers(att, now)...)\n3174\t\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n3175\t\tswitch {\n3176\t\tcase err != nil:\n3177\t\t\tblockers = append(blockers, \"the current review subject of \"+bundle.Payload.Scope.Ref+\" cannot be established: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n3178\t\tcase current == nil:\n3179\t\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" no longer represents the current semantic inputs of \"+bundle.Payload.Scope.Ref+\"; seal the current bundle and review it\")\n3180\t\tcase current.BundleID != bundle.BundleID:\n3181\t\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" is superseded by \"+current.BundleID+\"; review the current bundle\")\n3182\t\t}\n3183\t\treturn uniqueSorted(blockers)\n3184\t}\n3185\t\n3186\t// PreflightReviewAttestation returns the reasons the domain writer would\n3187\t// refuse an approving attestation, without writing anything. It completes the\n3188\t// attestation exactly as recording would and runs the same admission, so a\n3189\t// preview and the write cannot disagree (specs\n3190\t// pose-attest-refuses-what-verify-rejects, pose-review-approval-domain-preflight).\n3191\tfunc (s Store) PreflightReviewAttestation(att ReviewAttestation, now time.Time) []string {\n3192\t\tif !reviewDecisionApproves(att.Decision) {\n3193\t\t\treturn nil\n3194\t\t}\n3195\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n3196\t\tif err != nil {\n3197\t\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n3198\t\t}\n3199\t\tatt.Path = \"\"\n3200\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\n3201\t\tif err != nil {\n3202\t\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n3203\t\t}\n3204\t\treturn s.reviewApprovalAdmissionBlockers(bundle, completed, now)\n3205\t}\n3206\t\n3207\t// VerifyReviewAttestationEnvelope verifies an optional provider-neutral\n3208\t// Ed25519 envelope. Trust is pinned as <issuer>#sha256:<public-key-digest> in\n3209\t// review policy; a self-declared issuer or public key is never trusted alone.\n3210\tfunc (s Store) VerifyReviewAttestationEnvelope(envelope ReviewAttestationEnvelope) (ReviewAttestation, error) {\n3211\t\tif envelope.SchemaVersion != ReviewBundleSchemaVersion || envelope.Algorithm != \"ed25519\" {\n3212\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: unsupported review attestation envelope\")\n3213\t\t}\n3214\t\tif envelope.Subject != envelope.Attestation.BundleID || envelope.Issuer == \"\" || strings.ContainsAny(envelope.Issuer, \"\\r\\n\") {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"ed302eb4-7690-4460-8df9-80cbdb7e7a63","timestamp":"2026-11-28T02:44:37.388Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-6ee95d62f8/worktree/pose-mcp/internal/pose/review_bundle.go","content":"\treturn att, pending, nil\n}\n\n// RecordReviewAttestation appends an immutable decision for one sealed bundle.\nfunc (s Store) RecordReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n\tvar result ReviewAttestation\n\terr := s.withReviewAttestationWriteGuard(\"review.attestation.record\", att, func(guarded Store) error {\n\t\tvar err error\n\t\tresult, err = guarded.recordReviewAttestation(att, now, false)\n\t\treturn err\n\t})\n\treturn result, err\n}\n\nfunc (s Store) recordReviewAttestation(att ReviewAttestation, now time.Time, signed bool) (ReviewAttestation, error) {\n\tbundle, err := s.LoadReviewBundle(att.BundleID)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tpolicy, _, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tif policy.RequireSignedAttestations && !signed {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review policy requires a trusted signed attestation envelope\")\n\t}\n\tatt, err = completeReviewAttestation(bundle, att, now)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\t// The approval preflight runs here, in the one writer every channel shares,\n\t// before anything is written: an approval the verifier would reject is\n\t// refused, not recorded and rejected later (spec\n\t// pose-review-approval-domain-preflight).\n\tif blockers := s.reviewApprovalAdmissionBlockers(bundle, att, now); len(blockers) > 0 {\n\t\treturn ReviewAttestation{}, &ReviewApprovalRefusal{BundleID: bundle.BundleID, Blockers: blockers}\n\t}\n\tatt.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", att.AttestationID+\".json\"))\n\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), true)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tpath := filepath.Join(dir, att.AttestationID+\".json\")\n\tif existing, loadErr := s.LoadReviewAttestation(att.AttestationID); loadErr == nil {\n\t\texistingRaw, _ := json.Marshal(existing)\n\t\tcandidateRaw, _ := json.Marshal(att)\n\t\tif bytes.Equal(existingRaw, candidateRaw) {\n\t\t\treturn existing, nil\n\t\t}\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation identity collision for %s\", att.AttestationID)\n\t}\n\traw, err := json.MarshalIndent(att, \"\", \"  \")\n\tif err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tif err := writeImmutableJSONIn(s.fsys(), path, append(raw, '\\n')); err != nil {\n\t\tvar durability *PublishDurabilityError\n\t\tif errors.As(err, &durability) {\n\t\t\treturn att, err\n\t\t}\n\t\treturn ReviewAttestation{}, err\n\t}\n\treturn att, nil\n}\n\n// completeReviewAttestation fills and checks what recording sets: the bundle\n// binding, schema, attested time and content-derived id. Recording and the MCP\n// preview share it, so an issuer that signs a previewed attestation signs the\n// bytes that will be recorded (spec pose-mcp-review-attest-signed-only).\nfunc completeReviewAttestation(bundle ReviewBundle, att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n\tif att.Limitations == nil {\n\t\tatt.Limitations = append([]string(nil), bundle.Payload.Plan.Limitations...)\n\t}\n\tif strings.Join(att.Limitations, \"\\x00\") != strings.Join(bundle.Payload.Plan.Limitations, \"\\x00\") {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation must retain the sealed review limitations\")\n\t}\n\tif att.BundleDigest == \"\" {\n\t\tatt.BundleDigest = bundle.BundleDigest\n\t}\n\tif att.BundleDigest != bundle.BundleDigest {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation bundle digest mismatch\")\n\t}\n\tif att.Reviewer == \"\" || strings.ContainsAny(att.Reviewer, \"\\r\\n\") || (!strings.HasPrefix(att.Reviewer, \"agent:\") && !strings.HasPrefix(att.Reviewer, \"human:\")) {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid reviewer execution identity\")\n\t}\n\tif att.Decision != \"approved\" && att.Decision != \"approved-with-reservations\" && att.Decision != \"changes-requested\" && att.Decision != \"rejected\" {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid review decision %q\", att.Decision)\n\t}\n\tif err := ValidateReviewAttribution(att); err != nil {\n\t\treturn ReviewAttestation{}, err\n\t}\n\tatt.SchemaVersion = ReviewBundleSchemaVersion\n\tif att.AttestedAt == \"\" {\n\t\tatt.AttestedAt = now.UTC().Truncate(time.Second).Format(time.RFC3339)\n\t} else if _, err := time.Parse(time.RFC3339, att.AttestedAt); err != nil {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attested_at must be RFC3339\")\n\t}\n\tatt.BundleID = bundle.BundleID\n\tatt.BundleDigest = bundle.BundleDigest\n\texpectedAttestationID := reviewAttestationID(att)\n\tif att.AttestationID == \"\" {\n\t\tatt.AttestationID = expectedAttestationID\n\t} else if att.AttestationID != expectedAttestationID {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: attestation id does not match its content digest\")\n\t}\n\tif !strings.HasPrefix(att.AttestationID, \"rva-\") || len(att.AttestationID) != 20 {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid attestation id\")\n\t}\n\treturn att, nil\n}\n\n// SignableReviewAttestation completes a draft attestation for its sealed bundle\n// as recording would, including the confirmation digest when the draft names a\n// confirming principal, and returns it with the canonical bytes a trusted\n// issuer signs into a ReviewAttestationEnvelope. It records nothing.\nfunc (s Store) SignableReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, []byte, error) {\n\tbundle, err := s.LoadReviewBundle(att.BundleID)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\tif att.BundleDigest == \"\" {\n\t\tatt.BundleDigest = bundle.BundleDigest\n\t}\n\tif a := att.Attribution; a != nil && a.ConfirmedBy != \"\" && a.ConfirmationDigest == \"\" {\n\t\tbound := *a\n\t\tbound.ConfirmationDigest = ReviewConfirmationDigest(att)\n\t\tatt.Attribution = &bound\n\t}\n\tatt.Path, att.Envelope = \"\", nil\n\tcompleted, err := completeReviewAttestation(bundle, att, now)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\tcanonical, err := json.Marshal(completed)\n\tif err != nil {\n\t\treturn ReviewAttestation{}, nil, err\n\t}\n\treturn completed, canonical, nil\n}\n\n// RecordReviewAttestationEnvelope verifies a trusted issuer's envelope and,\n// with apply, records the attestation it carries: the path both\n// `pose review attest --envelope` and the MCP tool take.\nfunc (s Store) RecordReviewAttestationEnvelope(envelope ReviewAttestationEnvelope, apply bool) (ReviewAttestation, error) {\n\tif !apply {\n\t\treturn s.VerifyReviewAttestationEnvelope(envelope)\n\t}\n\tvar result ReviewAttestation\n\terr := s.withReviewAttestationWriteGuard(\"review.attestation.envelope\", envelope.Attestation, func(guarded Store) error {\n\t\tattestation, err := guarded.VerifyReviewAttestationEnvelope(envelope)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tresult, err = guarded.recordReviewAttestation(attestation, guarded.reviewClock(), true)\n\t\treturn err\n\t})\n\treturn result, err\n}\n\n// ErrReviewApprovalRefused classifies a ReviewApprovalRefusal for errors.Is.\nvar ErrReviewApprovalRefused = errors.New(\"pose: review approval refused before persistence\")\n\n// ReviewApprovalRefusal is the typed result of the domain approval preflight:\n// every reason the verifier would reject the approval, returned before any\n// artifact of the attempt is written. Every channel — Store, CLI, signed\n// import and MCP — receives this same value.\ntype ReviewApprovalRefusal struct {\n\tBundleID string   `json:\"bundle_id\"`\n\tBlockers []string `json:\"blockers\"`\n}\n\nfunc (e *ReviewApprovalRefusal) Error() string {\n\treturn \"pose: verify would reject this approval for bundle \" + e.BundleID + \", so nothing was written: \" + strings.Join(e.Blockers, \"; \")\n}\n\nfunc (e *ReviewApprovalRefusal) Unwrap() error { return ErrReviewApprovalRefused }\n\nfunc reviewDecisionApproves(decision string) bool {\n\treturn decision == \"approved\" || decision == \"approved-with-reservations\"\n}\n\n// reviewApprovalAdmissionBlockers is the semantic admission of a new approving\n// attestation, completed as it will be recorded. It reuses the verifier itself\n// over the bundle's sealed gates and the deliberately live signing and trust\n// requirements, adds the time admissibility of a new operation, and requires\n// the bundle to still be the current sealed subject of its scope, so the\n// approval of a stale preview or of a superseded bundle is not written.\n//\n// A non-approving decision is an audit record the verifier rejects for\n// closeout by definition, so its criteria are not held to the approval bar;\n// its channel's authentication still applies in the writer.\nfunc (s Store) reviewApprovalAdmissionBlockers(bundle ReviewBundle, att ReviewAttestation, now time.Time) []string {\n\tif !reviewDecisionApproves(att.Decision) {\n\t\t// Whatever the decision, no attestation names a limit the bundle\n\t\t// did not seal (spec pose-review-declared-limits-residuals R6).\n\t\treturn unsealedLimitBlockers(bundle, att)\n\t}\n\tblockers := s.atReviewTime(now).validateBundleAttestation(bundle, att)\n\tblockers = append(blockers, reviewNewOperationTimeBlockers(att, now)...)\n\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n\tswitch {\n\tcase err != nil:\n\t\tblockers = append(blockers, \"the current review subject of \"+bundle.Payload.Scope.Ref+\" cannot be established: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n\tcase current == nil:\n\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" no longer represents the current semantic inputs of \"+bundle.Payload.Scope.Ref+\"; seal the current bundle and review it\")\n\tcase current.BundleID != bundle.BundleID:\n\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" is superseded by \"+current.BundleID+\"; review the current bundle\")\n\t}\n\treturn uniqueSorted(blockers)\n}\n\n// PreflightReviewAttestation returns the reasons the domain writer would\n// refuse an approving attestation, without writing anything. It completes the\n// attestation exactly as recording would and runs the same admission, so a\n// preview and the write cannot disagree (specs\n// pose-attest-refuses-what-verify-rejects, pose-review-approval-domain-preflight).\nfunc (s Store) PreflightReviewAttestation(att ReviewAttestation, now time.Time) []string {\n\tif !reviewDecisionApproves(att.Decision) {\n\t\treturn nil\n\t}\n\tbundle, err := s.LoadReviewBundle(att.BundleID)\n\tif err != nil {\n\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n\t}\n\tatt.Path = \"\"\n\tcompleted, err := completeReviewAttestation(bundle, att, now)\n\tif err != nil {\n\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n\t}\n\treturn s.reviewApprovalAdmissionBlockers(bundle, completed, now)\n}\n\n// VerifyReviewAttestationEnvelope verifies an optional provider-neutral\n// Ed25519 envelope. Trust is pinned as <issuer>#sha256:<public-key-digest> in\n// review policy; a self-declared issuer or public key is never trusted alone.\nfunc (s Store) VerifyReviewAttestationEnvelope(envelope ReviewAttestationEnvelope) (ReviewAttestation, error) {\n\tif envelope.SchemaVersion != ReviewBundleSchemaVersion || envelope.Algorithm != \"ed25519\" {\n\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: unsupported review attestation envelope\")\n\t}\n\tif envelope.Subject != envelope.Attestation.BundleID || envelope.Issuer == \"\" || strings.ContainsAny(envelope.Issuer, \"\\r\\n\") {","numLines":240,"startLine":2975,"totalLines":4965}},"tool_result_meta":[{"id":"toolu_01GvdjU4iqwkx5xTbXX4i5r9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
