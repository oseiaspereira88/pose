{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CAcvGRm4HGYP77uVXGzhEW","type":"tool_result","content":"1425\t\t\t\treturn nil, fmt.Errorf(\"pose_review_attest: invalid arguments\")\n1426\t\t\t}\n1427\t\t\tif a.Apply {\n1428\t\t\t\tif a.Envelope == nil {\n1429\t\t\t\t\treturn nil, fmt.Errorf(\"pose_review_attest: a review attestation over MCP is recorded only inside a trusted issuer's envelope (the proof `pose review attest --envelope` verifies); a reviewer or confirming principal written by an agent is a declaration, not a proof\")\n1430\t\t\t\t}\n1431\t\t\t\t// Refuse an untrusted envelope before the write guard discovers and\n1432\t\t\t\t// leases the affected bundle roots. The guarded writer verifies it\n1433\t\t\t\t// again against the bytes held through publication.\n1434\t\t\t\tif _, err := store.VerifyReviewAttestationEnvelope(*a.Envelope); err != nil {\n1435\t\t\t\t\treturn nil, err\n1436\t\t\t\t}\n1437\t\t\t\trecorded, err := store.RecordReviewAttestationEnvelope(*a.Envelope, true)\n1438\t\t\t\tif err != nil {\n1439\t\t\t\t\tvar durability *pose.PublishDurabilityError\n1440\t\t\t\t\tif errors.As(err, &durability) && recorded.AttestationID != \"\" {\n1441\t\t\t\t\t\tpersisted, readErr := store.LoadReviewAttestation(recorded.AttestationID)\n1442\t\t\t\t\t\tif readErr == nil && persisted.BundleDigest == recorded.BundleDigest {\n1443\t\t\t\t\t\t\treturn map[string]any{\"recorded\": true, \"attestation\": persisted, \"durability_confirmed\": false, \"warning\": durability.Error()}, nil\n1444\t\t\t\t\t\t}\n1445\t\t\t\t\t}\n1446\t\t\t\t\treturn nil, err\n1447\t\t\t\t}\n1448\t\t\t\treturn map[string]any{\"recorded\": true, \"attestation\": recorded}, nil\n1449\t\t\t}\n1450\t\t\tif a.Envelope != nil {\n1451\t\t\t\tverified, err := store.RecordReviewAttestationEnvelope(*a.Envelope, false)\n1452\t\t\t\tif err != nil {\n1453\t\t\t\t\treturn nil, err\n1454\t\t\t\t}\n1455\t\t\t\t// A verified signature is identity, not admissibility: report what\n1456\t\t\t\t// the domain writer would refuse before apply is attempted.\n1457\t\t\t\tblockers := store.PreflightReviewAttestation(verified, time.Now())\n1458\t\t\t\tif blockers == nil {\n1459\t\t\t\t\tblockers = []string{}\n1460\t\t\t\t}\n1461\t\t\t\treturn map[string]any{\"preview\": true, \"verified\": true, \"attestation\": verified, \"verify_blockers\": blockers, \"apply\": \"false (call again with the same envelope and apply: true to record it)\"}, nil\n1462\t\t\t}\n1463\t\t\tif a.Attestation == nil {\n1464\t\t\t\treturn nil, fmt.Errorf(\"pose_review_attest: required argument %q missing\", \"attestation or envelope\")\n1465\t\t\t}\n1466\t\t\tcompleted, canonical, err := store.SignableReviewAttestation(*a.Attestation, time.Now())\n1467\t\t\tif err != nil {\n1468\t\t\t\treturn nil, err\n1469\t\t\t}\n1470\t\t\tblockers := store.PreflightReviewAttestation(completed, time.Now())\n1471\t\t\tif blockers == nil {\n1472\t\t\t\tblockers = []string{}\n1473\t\t\t}\n1474\t\t\treturn map[string]any{\n1475\t\t\t\t\"preview\":         true,\n1476\t\t\t\t\"attestation\":     completed,\n1477\t\t\t\t\"signing_bytes\":   string(canonical),\n1478\t\t\t\t\"verify_blockers\": blockers,\n1479\t\t\t\t\"sign\":            \"a trusted issuer signs signing_bytes with Ed25519 into a ReviewAttestationEnvelope (subject: the bundle id); call again with envelope and apply: true\",\n1480\t\t\t}, nil\n1481\t\tcase \"pose_action_requests\":\n1482\t\t\tvar a struct {\n1483\t\t\t\tID      string `json:\"id\"`\n1484\t\t\t\tState   string `json:\"state\"`\n1485\t\t\t\tPresent bool   `json:\"present\"`\n1486\t\t\t\tActor   string `json:\"actor\"`\n1487\t\t\t}\n1488\t\t\tif err := json.Unmarshal(args, &a); err != nil {\n1489\t\t\t\treturn nil, fmt.Errorf(\"pose_action_requests: invalid arguments\")\n1490\t\t\t}\n1491\t\t\tif a.ID != \"\" {\n1492\t\t\t\treturn store.LoadActionRequest(a.ID)\n1493\t\t\t}\n1494\t\t\tviews, err := store.ListActionRequests()\n1495\t\t\tif err != nil {\n1496\t\t\t\tretu